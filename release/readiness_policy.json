        {
          "id": "native_llvm.control_and_call_lowering",
          "label": "Control And Call Lowering",
          "summary": "Branch and call graph lowering must survive native LLVM release builds without caveats.",
          "current_surfaces": [
            "benchmark/cases/branch_dispatch/main.kn",
            "benchmark/cases/call_chain/main.kn"
          ],
          "owners": [
