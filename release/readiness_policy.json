{
  "schema_version": 1,
  "title": "Kain Release Readiness",
  "summary": "Data-driven release gate for honest benchmark rows, stdlib surface coverage, targeted Kain attrition lanes, and runtime conformance hooks.",
  "profiles": {
    "quick": {
      "run_hooks": [
        "benchmark.release_subset",
        "attrition.release_subset",
        "conformance.graphics_runtime",
        "conformance.ui_runtime",
        "conformance.input_runtime",
        "conformance.net_runtime",
        "conformance.process_runtime"
      ],
      "evaluate_checks": [
        "benchmark.release_subset",
        "attrition.release_subset",
        "imports.release_case_stdlib",
        "coverage.quick_release_features"
      ]
    },
    "full": {
      "run_hooks": [
        "benchmark.release_subset",
        "attrition.release_subset",
        "conformance.graphics_runtime",
        "conformance.ui_runtime",
        "conformance.input_runtime",
        "conformance.net_runtime",
        "conformance.process_runtime",
        "conformance.actor_runtime",
        "conformance.async_runtime",
        "conformance.diagnostics",
        "conformance.abi_parity",
        "conformance.reflection",
        "conformance.host_bridge",
        "conformance.hot_reload",
        "conformance.platform_parity"
      ],
      "evaluate_checks": [
        "benchmark.release_subset",
        "attrition.release_subset",
        "imports.release_case_stdlib",
        "coverage.quick_release_features",
        "coverage.full_runtime_features"
      ]
    }
  },
  "hooks": [
    {
      "id": "benchmark.release_subset",
      "cwd": ".",
      "command": [
        "{python}",
        "benchmark/run.py",
        "--case",
        "branch_dispatch,call_chain,ownership_memory,memory_stream,native_map_lookup,zero_copy_binary_wire,crypto_block_cipher,ray_sphere_intersection,filesystem_stream,json_manual_roundtrip,process_stdio_loop,async_ready_chain,actor_mailbox_erlang,gpu_graphics_submit",
        "--languages",
        "kain",
        "--runs",
        "1",
        "--warmups",
        "0",
        "--timeout",
        "900",
        "--latest-stem",
        "latest_release_readiness",
        "--minimal-name",
        "latest_release_readiness.md"
      ],
      "artifacts": [
        "benchmark/out/reports/latest_release_readiness.json",
        "benchmark/latest_release_readiness.md"
      ]
    },
    {
      "id": "attrition.release_subset",
      "cwd": ".",
      "command": [
        "{python}",
        "attrition/run.py",
        "--case",
        "saturated_rc_hot_object,process_slot_recycle,mixed_runtime_boss,kain_actor_ask_roundtrip,kain_stdlib_domains,kain_float_array_literal_indexing,kain_semantic_singularity_crucible_attrition",
        "--profile",
        "release-instrumented",
        "--scale",
        "small",
        "--timeout",
        "900"
      ],
      "artifacts": [
        "attrition/out/reports/latest.json",
        "attrition/latest.md"
      ]
    },
    {
      "id": "conformance.graphics_runtime",
      "cwd": ".",
      "command": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "runtime/conformance/run_all.ps1",
        "-Backend",
        "all",
        "-Mode",
        "full",
        "-Category",
        "graphics_runtime"
      ]
    },
    {
