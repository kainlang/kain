common --enable_bzlmod
common --announce_rc
common --color=yes
common --curses=yes
common --experimental_convenience_symlinks=ignore
# Hermetic build: Bazel cache/output lives in a sibling directory .bazel-cache/kain/
# outside the repo root (Bazel forbids caches inside the workspace).
common --repository_cache=../.bazel-cache/kain/repo
startup --output_user_root=../.bazel-cache/kain/output-user-root
common --repo_env=TMP=F:/.bazel-cache/kain/tmp
common --repo_env=TEMP=F:/.bazel-cache/kain/tmp
common --repo_env=TMPDIR=F:/.bazel-cache/kain/tmp
# clang-sys needs LIBCLANG_PATH for crate resolution and build scripts
common --repo_env=LIBCLANG_PATH
common --action_env=TMP=F:/.bazel-cache/kain/tmp
common --action_env=TEMP=F:/.bazel-cache/kain/tmp
common --action_env=TMPDIR=F:/.bazel-cache/kain/tmp
# rules_rust's Windows process wrapper reconstructs the rustc child environment
# from Bazel's action env, so we must explicitly preserve the normal loader and
# per-user process variables that MSVC-target proc-macro DLLs expect.
common --action_env=PATH
common --action_env=PATHEXT
common --action_env=SystemDrive
common --action_env=SystemRoot
common --action_env=ComSpec
common --action_env=windir
common --action_env=USERPROFILE
common --action_env=HOMEDRIVE
common --action_env=HOMEPATH
common --action_env=APPDATA
common --action_env=LOCALAPPDATA
common --action_env=ProgramData
common --action_env=ProgramFiles
common --action_env=ProgramFiles(x86)
common --action_env=CommonProgramFiles
common --action_env=CommonProgramFiles(x86)
common --action_env=NUMBER_OF_PROCESSORS
common --action_env=PROCESSOR_ARCHITECTURE
common --action_env=PROCESSOR_IDENTIFIER
# clang-sys needs LIBCLANG_PATH at build time to find libclang.dll
common --action_env=LIBCLANG_PATH

build --disk_cache=../.bazel-cache/kain/disk
build --jobs=HOST_CPUS*.625
build --loading_phase_threads=HOST_CPUS*.5
build --local_resources=cpu=HOST_CPUS*.625
build --local_resources=memory=HOST_RAM*.75
build --keep_going

build:maxperf --jobs=HOST_CPUS
build:maxperf --loading_phase_threads=HOST_CPUS
build:maxperf --local_resources=cpu=HOST_CPUS
build:maxperf --local_resources=memory=HOST_RAM

build:dev --compilation_mode=opt
build:debug --compilation_mode=dbg
build:release --compilation_mode=opt
build:speed --compilation_mode=opt
build:speed --@rules_rust//rust/settings:extra_rustc_flags=-Clto=thin,-Ccodegen-units=1,-Cembed-bitcode=yes
build:speed --jobs=HOST_CPUS
build:speed --loading_phase_threads=HOST_CPUS
build:speed --local_resources=cpu=HOST_CPUS
build:speed --local_resources=memory=HOST_RAM
build:warnings --@rules_rust//rust/settings:extra_rustc_flags=-Dwarnings

test --test_output=errors
test --test_summary=short
test --local_test_jobs=HOST_CPUS*.25
test --test_env=TMP=F:/.bazel-cache/kain/tmp
test --test_env=TEMP=F:/.bazel-cache/kain/tmp
test --test_env=TMPDIR=F:/.bazel-cache/kain/tmp
test --test_env=PATH
test --test_env=PATHEXT

test:maxperf --local_test_jobs=HOST_CPUS*.5

# Local workstation overrides belong in .bazelrc.local so Bazel can see
# machine-specific paths (for example a stable PyO3 Python interpreter)
# without hardcoding them into the shared repo config.
try-import %workspace%/.bazelrc.local
