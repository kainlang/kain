component App():
    render <slot layout="column" gap={18} padding={18} overflow_y="scroll">
        <theme name="universal_web">
            <scope name="web_pack" selector="web-pack" />
            <token name="theme.chrome.topbar.visible" category="chrome" value={false} />
            <token name="theme.background.top" category="color" value="#06111a" />
            <token name="theme.background.bottom" category="color" value="#0b1d2b" />
            <token name="theme.surface.base" category="color" value="#102133" />
            <token name="theme.surface.alt" category="color" value="#13283f" />
            <token name="theme.surface.raised" category="color" value="#18314d" />
            <token name="theme.surface.overlay" category="color" value="#08131fd8" />
            <token name="theme.accent.primary" category="color" value="#5ae4ff" />
            <token name="theme.accent.soft" category="color" value="#b8f5ff" />
            <token name="theme.highlight" category="color" value="#ffd166" />
            <token name="theme.text.default" category="color" value="#f4fbff" />
            <token name="theme.text.muted" category="color" value="#98b7cb" />
            <variant scope="web_pack" name="hero">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="accent.color" category="color" value="#5ae4ff" />
            </variant>
            <variant scope="web_pack" name="section">
                <token name="surface.mode" category="surface" value="layered" />
            </variant>
            <variant scope="web_pack" name="card">
                <token name="surface.mode" category="surface" value="flat" />
            </variant>
            <widget kind="panel" scope="web_pack" variant="hero">
                <token name="surface.padding" category="space" value={18} />
            </widget>
            <widget kind="panel" scope="web_pack" variant="section">
                <token name="surface.padding" category="space" value={16} />
            </widget>
            <widget kind="panel" scope="web_pack" variant="card">
                <token name="surface.padding" category="space" value={14} />
            </widget>
            <textvariant scope="web_pack" name="hero">
                <token name="body.size" category="type" value={30} />
            </textvariant>
        </theme>

        <panel title="Universal Web Template" scope="web_pack" variant="hero" layout="grid" columns={2} gap={18}>
            <slot layout="column" gap={12}>
                <text role="eyebrow">Kain UI preview for the web pack</text>
                <text role="hero" variant="hero">One manifest-driven starter for business sites, portfolio shells, docs/search hubs, 3D launches, chat experiences, operator dashboards, and actor servers.</text>
                <text role="muted">The browser lane still uses Node FFI today, while this preview keeps semantic Kain UI authoring in the loop and visible.</text>
                <slot layout="row" gap={12}>
                    <panel scope="web_pack" variant="card">
                        <text role="metric">11</text>
                        <text role="caption">experience archetypes</text>
                    </panel>
                    <panel scope="web_pack" variant="card">
                        <text role="metric">10+</text>
                        <text role="caption">artifacts per site (+blog pages)</text>
                    </panel>
                    <panel scope="web_pack" variant="card">
                        <text role="metric">0</text>
                        <text role="caption">Rust toolchain required</text>
                    </panel>
                </slot>
            </slot>
            <viewport3d title="Immersive Preview" scene="luminous_port" />
        </panel>

        <panel title="Archetypes" scope="web_pack" variant="section" layout="grid" columns={3} gap={14}>
            <panel scope="web_pack" variant="card">
                <text role="title">Business</text>
                <text role="caption">Launch pages, pricing stacks, proof rails, FAQ, docs links, and intake surfaces.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Portfolio</text>
                <text role="caption">Case-study grids, tag filtering, search, and project-brief capture.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Immersive 3D</text>
                <text role="caption">Scene panels, technical notes, release editions, and reservation intake.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Chat</text>
                <text role="caption">Seed transcripts, prompt rails, search, and escalation forms.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Actor Server</text>
                <text role="caption">Route manifests, actor meshes, control-room docs, and local runtime APIs.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Docs Hub</text>
                <text role="caption">Knowledge bases, search panels, capability matrices, and onboarding flows.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Operator Hub</text>
                <text role="caption">Prompt decks, route catalogs, actor meshes, capability matrices, and command-center flows.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Hybrid</text>
                <text role="caption">The full-spectrum proving ground that mixes launch, 3D, chat, docs, search, routes, and operator surfaces.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">App Shell</text>
                <text role="caption">Workspace modules, auth strategies, integrations, and typed data collections for SaaS-style products.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Commerce</text>
                <text role="caption">Offer stacks, membership/auth flows, fulfillment integrations, and intake to checkout handoff.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Realtime</text>
                <text role="caption">Signal channels, incident streams, operator prompts, and actor-backed live route surfaces.</text>
            </panel>
        </panel>

        <panel title="System Layout" scope="web_pack" variant="section" layout="column" gap={12}>
            <panel scope="web_pack" variant="card">
                <text role="title">Kain</text>
                <text role="caption">Owns orchestration, template entrypoints, and semantic preview.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Node FFI</text>
                <text role="caption">Owns HTML packaging, browser islands, local serving, search endpoints, auth/commerce metadata, realtime previews, and form capture.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Manifest Registries</text>
                <text role="caption">Themes, content, scenes, and experiences stay data-driven and expand without boilerplate cloning.</text>
            </panel>
        </panel>

        <panel title="Web Systems Expansion" scope="web_pack" variant="section" layout="grid" columns={3} gap={14}>
            <panel scope="web_pack" variant="card">
                <text role="title">Community</text>
                <text role="caption">Community hubs, events, newsletters, and support lanes are all registry-driven.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Governance</text>
                <text role="caption">Compliance, security, and legal metadata stay in the system contract.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Operations</text>
                <text role="caption">Observability, infrastructure, and performance budgets ship with the template.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Localization</text>
                <text role="caption">Language and region plans are modeled explicitly in the pack.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Accessibility</text>
                <text role="caption">Accessibility checks and posture are declared alongside content.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Performance</text>
                <text role="caption">Runtime targets and budgets are tracked with the system data.</text>
            </panel>
        </panel>

        <panel title="Growth + Ops Systems" scope="web_pack" variant="section" layout="grid" columns={3} gap={14}>
            <panel scope="web_pack" variant="card">
                <text role="title">Growth</text>
                <text role="caption">Campaigns and funnels stay in data so launches can iterate without new code.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Experiments</text>
                <text role="caption">A/B tests and feature flags live beside the content registry.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Service Catalog</text>
                <text role="caption">Describe offerings, SLAs, and ownership in the system contract.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Success</text>
                <text role="caption">Customer success playbooks and adoption flows stay manifest-driven.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Notifications</text>
                <text role="caption">Messaging and alert channels are tracked as runtime data.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Actor Topology</text>
                <text role="caption">Actor mesh nodes and edges are visible in the web control plane.</text>
            </panel>
        </panel>

        <panel title="Product + Agent Systems" scope="web_pack" variant="section" layout="grid" columns={3} gap={14}>
            <panel scope="web_pack" variant="card">
                <text role="title">Identity</text>
                <text role="caption">Providers, roles, and access policies live in the manifest layer.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Billing</text>
                <text role="caption">Plans, invoices, and tax posture remain data-driven.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Subscriptions</text>
                <text role="caption">Entitlements and tiers are modeled alongside the commerce stack.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">CMS</text>
                <text role="caption">Content types and editorial workflow live in system data.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Media</text>
                <text role="caption">Asset libraries and pipelines stay in one registry.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Automation</text>
                <text role="caption">Workflow automation for launch, chat, and ops surfaces.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Webhooks</text>
                <text role="caption">Event contracts and hook definitions stay explicit.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Developer Portal</text>
                <text role="caption">SDKs, sandboxes, and API playbooks are ready to wire.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Agents</text>
                <text role="caption">Agent rosters and routing workflows power chat-first experiences.</text>
            </panel>
        </panel>

        <panel title="UI Kit + Chat Systems" scope="web_pack" variant="section" layout="grid" columns={3} gap={14}>
            <panel scope="web_pack" variant="card">
                <text role="title">UI Components</text>
                <text role="caption">Manifest-driven component kit for React-style shells.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Layout Patterns</text>
                <text role="caption">Launch, chat-first, operator, and app-shell layouts stay data-driven.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Design Tokens</text>
                <text role="caption">Tokens capture typography, surface, and motion systems.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Chat Playbooks</text>
                <text role="caption">Conversation flows and escalation paths are explicit.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Chat Tools</text>
                <text role="caption">Tool routing, context assembly, and handoff triggers.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Actor Policies</text>
                <text role="caption">Rate limits and escalation rules live with the runtime contract.</text>
            </panel>
        </panel>

        <panel title="Release + Pipeline Systems" scope="web_pack" variant="section" layout="grid" columns={3} gap={14}>
            <panel scope="web_pack" variant="card">
                <text role="title">Release Notes</text>
                <text role="caption">Changelog and upgrade notes stay manifest-driven.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Feature Flags</text>
                <text role="caption">Flag rollout status captured for app + site surfaces.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Incident Playbooks</text>
                <text role="caption">Severity and response workflows stay data-driven.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">CRM Pipeline</text>
                <text role="caption">Lead stages and ownership tracked with the web system contract.</text>
            </panel>
        </panel>
    </slot>
