component App():
    render <slot layout="column" gap={18} padding={18} overflow_y="scroll">
        <theme name="universal_web">
            <scope name="web_pack" selector="web-pack" />
            <token name="theme.chrome.topbar.visible" category="chrome" value={false} />
            <token name="theme.background.top" category="color" value="#06111a" />
            <token name="theme.background.bottom" category="color" value="#0b1d2b" />
            <token name="theme.surface.base" category="color" value="#102133" />
            <token name="theme.surface.alt" category="color" value="#13283f" />
            <token name="theme.surface.raised" category="color" value="#18314d" />
            <token name="theme.surface.overlay" category="color" value="#08131fd8" />
            <token name="theme.accent.primary" category="color" value="#5ae4ff" />
            <token name="theme.accent.soft" category="color" value="#b8f5ff" />
            <token name="theme.highlight" category="color" value="#ffd166" />
            <token name="theme.text.default" category="color" value="#f4fbff" />
            <token name="theme.text.muted" category="color" value="#98b7cb" />
            <variant scope="web_pack" name="hero">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="accent.color" category="color" value="#5ae4ff" />
            </variant>
            <variant scope="web_pack" name="section">
                <token name="surface.mode" category="surface" value="layered" />
            </variant>
            <variant scope="web_pack" name="card">
                <token name="surface.mode" category="surface" value="flat" />
            </variant>
            <widget kind="panel" scope="web_pack" variant="hero">
                <token name="surface.padding" category="space" value={18} />
            </widget>
            <widget kind="panel" scope="web_pack" variant="section">
                <token name="surface.padding" category="space" value={16} />
            </widget>
            <widget kind="panel" scope="web_pack" variant="card">
                <token name="surface.padding" category="space" value={14} />
            </widget>
            <textvariant scope="web_pack" name="hero">
                <token name="body.size" category="type" value={30} />
            </textvariant>
        </theme>

        <panel title="Universal Web Template" scope="web_pack" variant="hero" layout="grid" columns={2} gap={18}>
            <slot layout="column" gap={12}>
                <text role="eyebrow">Kain UI preview for the web pack</text>
                <text role="hero" variant="hero">One manifest-driven starter for business sites, portfolio shells, 3D launches, chat experiences, and actor servers.</text>
                <text role="muted">The browser lane uses Node FFI today, while this preview keeps semantic Kain UI authoring in the loop.</text>
                <slot layout="row" gap={12}>
                    <panel scope="web_pack" variant="card">
                        <text role="metric">5</text>
                        <text role="caption">experience archetypes</text>
                    </panel>
                    <panel scope="web_pack" variant="card">
                        <text role="metric">4</text>
                        <text role="caption">manifest registries</text>
                    </panel>
                    <panel scope="web_pack" variant="card">
                        <text role="metric">0</text>
                        <text role="caption">Rust toolchain required</text>
                    </panel>
                </slot>
            </slot>
            <viewport3d title="Immersive Preview" scene="luminous_port" />
        </panel>

        <panel title="Archetypes" scope="web_pack" variant="section" layout="grid" columns={3} gap={14}>
            <panel scope="web_pack" variant="card">
                <text role="title">Business</text>
                <text role="caption">Launch pages, pricing stacks, proof rails, and CTA surfaces.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Portfolio</text>
                <text role="caption">Case-study grids, tag filtering, and narrative detail cards.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Immersive 3D</text>
                <text role="caption">Scene panels, layer maps, and product-story staging.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Chat</text>
                <text role="caption">Seed transcripts, composer islands, and assistant response rails.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Actor Server</text>
                <text role="caption">Route manifests, actor meshes, and local HTTP serving.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">No Boilerplate Drift</text>
                <text role="caption">Common runtime glue moved into stdlib wrappers and one helper runtime.</text>
            </panel>
        </panel>

        <panel title="System Layout" scope="web_pack" variant="section" layout="column" gap={12}>
            <panel scope="web_pack" variant="card">
                <text role="title">Kain</text>
                <text role="caption">Owns orchestration, template entrypoints, and semantic preview.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Node FFI</text>
                <text role="caption">Owns HTML packaging, browser islands, and local actor-aware serving.</text>
            </panel>
            <panel scope="web_pack" variant="card">
                <text role="title">Manifest Registries</text>
                <text role="caption">Themes, content, scenes, and experiences stay data-driven.</text>
            </panel>
        </panel>
    </slot>
