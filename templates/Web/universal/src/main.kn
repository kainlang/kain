use std::javascript::site_runtime

fn output_path(name: String) -> String:
    return "outputs/" + name

fn main() -> String:
    let summary = js_site_write_matrix("manifests/app.json")
    let catalog = js_site_catalog("manifests/app.json")

    let report = "Kain universal web template build\n"
    let report = report + "template: universal\n"
    let report = report + "default_experience: " + summary.default_experience + "\n"
    let report = report + "experience_count: " + str(summary.experience_count) + "\n"
    let report = report + "artifact_count: " + str(summary.artifact_count) + "\n"
    let report = report + "output_root: " + summary.output_root + "\n"
    let report = report + "server_port: " + str(summary.server_port) + "\n"
    let report = report + "modes: " + str(summary.modes) + "\n"
    let report = report + "catalog_default: " + catalog.default_experience + "\n"
    let report = report + "client_features: metrics, portfolio filters, prompt deck, faq toggles, chat, search, forms, catalog api, app shell, ui kit, auth panel, auth session, identity stack, billing stack, subscription tiers, cms pipeline, media library, automation board, webhook matrix, api reference, developer portal, seo stack, ai agents, chat playbooks, chat tools, chat memory, commerce stack, status watch, uploads lab, analytics lab, realtime channels, community hub, events, newsletter, compliance, observability, infrastructure, localization, accessibility, performance targets, growth stack, experiment board, service catalog, success playbooks, notification matrix, actor topology, actor policies, actor metrics\n"
    let report = report + "outputs: html, blog pages, manifest, actor-plan, site-data, system-contract, ui-schema, sitemap, robots, feed, social-card\n"
    let report = report + "archetypes: business, portfolio, immersive3d, chat, actor_server, docs_hub, operator_hub, hybrid, app_shell, commerce, realtime"

    write_file(output_path("web_template_build.txt"), report + "\n")
    println(report)
    return report
