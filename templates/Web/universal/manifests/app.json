{
  "schema_version": 4,
  "name": "kain_universal_web",
  "default_experience": "hybrid_command",
  "output_root": "outputs/sites",
  "registries": {
    "themes": "manifests/themes/registry.json",
    "content": "manifests/content/registry.json",
    "scenes": "manifests/scenes/registry.json",
    "experiences": "manifests/experiences/registry.json"
  },
  "site": {
    "base_url": "https://example.com",
    "default_description": "Universal Kain website template for launch pages, portfolios, immersive 3D experiences, chat-first products, and actor-backed web servers.",
    "default_social_image": "social-card.svg"
  },
  "site_runtime": {
    "host": "127.0.0.1",
    "default_port": 4318,
    "client_features": [
      "metric_card",
      "portfolio_filter",
      "chat_lab",
      "prompt_deck",
      "faq_toggle",
      "form_submit",
      "search_panel",
      "actor_watch",
      "catalog_api",
      "chat_stream",
      "capability_matrix",
      "app_shell",
      "auth_panel",
      "auth_session",
      "commerce_stack",
      "realtime_channels",
      "status_watch",
      "system_contract",
      "ui_schema",
      "uploads_lab",
      "analytics_lab",
      "preact_islands",
      "scene_webgl",
      "chat_sse_tokens",
      "realtime_sse_ticks",
      "realtime_ws"
    ]
  },
  "client_bundle": {
    "enabled": true,
    "entry": "helpers/client/main.tsx",
    "out_dir": "client",
    "out_file": "kain-client.bundle.js",
    "format": "esm",
    "target": "es2022"
  },
  "build": {
    "experiences": [
      "business_launch",
      "portfolio_signal",
      "immersive_luminous",
      "chat_orbit",
      "actor_mesh_foundry",
      "knowledge_atlas",
      "operator_foundry",
      "hybrid_command",
      "app_foundry",
      "commerce_signal",
      "realtime_constellation"
    ]
  }
}
