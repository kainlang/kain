{
  "schema_version": 4,
  "name": "kain_universal_web",
  "default_experience": "hybrid_command",
  "output_root": "outputs/sites",
  "registries": {
    "themes": "manifests/themes/registry.json",
    "content": "manifests/content/registry.json",
    "scenes": "manifests/scenes/registry.json",
    "experiences": "manifests/experiences/registry.json"
  },
  "site": {
    "base_url": "https://example.com",
    "default_description": "Universal Kain website template for launch pages, portfolios, immersive 3D experiences, chat-first products, and actor-backed web servers.",
    "default_social_image": "social-card.svg"
  },
  "pwa": {
    "enabled": true,
    "name": "Kain Universal Web",
    "short_name": "Kain Web",
    "description": "Installable Kain web template with offline-ready previews, chat labs, and actor-aware routes.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#05070f",
    "theme_color": "#5fe3ff",
    "icon": {
      "path": "icon.svg",
      "background": "#0a0f1c",
      "accent": "#5fe3ff"
    },
    "service_worker": {
      "enabled": true,
      "cache_name": "kain-web-cache-v1",
      "offline_fallback": "/offline/",
      "precache": [
        "/",
        "/index.html",
        "/site.data.json",
        "/system.contract.json",
        "/ui.schema.json",
        "/manifest.webmanifest",
        "/social-card.svg"
      ]
    }
  },
  "site_runtime": {
    "host": "127.0.0.1",
    "default_port": 4318,
    "storage": {
      "root": "runtime",
      "submissions": "submissions",
      "uploads": "uploads",
      "analytics": "analytics",
      "auth": "auth",
      "chat": "chat",
      "actors": "actors",
      "tools": "tools"
    },
    "routes": {
      "chat": "/api/chat",
      "chat_stream": "/api/chat/stream",
      "chat_ws": "/ws/chat",
      "chat_tools": "/api/chat/tools",
      "chat_tool_events": "/api/chat/tools/events",
      "realtime_stream": "/api/realtime/stream",
      "realtime_ws": "/ws/realtime",
      "uploads": "/api/uploads",
      "uploads_prefix": "/uploads/",
      "analytics_event": "/api/analytics/event",
      "analytics_events": "/api/analytics/events",
      "actors_dispatch": "/api/actors/dispatch",
      "actors_events": "/api/actors/events"
    },
    "client_features": [
      "metric_card",
      "portfolio_filter",
      "chat_lab",
      "prompt_deck",
      "faq_toggle",
      "form_submit",
      "search_panel",
      "actor_watch",
      "actor_ops",
      "catalog_api",
      "experience_catalog",
      "chat_stream",
      "capability_matrix",
      "app_shell",
      "auth_panel",
      "auth_session",
      "commerce_stack",
      "product_catalog",
      "inventory_stack",
      "fulfillment_stack",
