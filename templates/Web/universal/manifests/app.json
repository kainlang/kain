    "entry": "helpers/client/main.tsx",
    "out_dir": "client",
    "out_file": "kain-client.bundle.js",
    "format": "esm",
    "target": "es2022"
  },
  "build": {
    "experiences": [
      "business_launch",
      "portfolio_signal",
      "immersive_luminous",
