// Gameplay framework, runtime ruleset, and mission-state contracts for engine-facing Kain applications.

struct GameplayRulesetDescriptor:
    ruleset_id: String
    gameplay_scope: String
    authority_policy: String

struct GameplayStateDescriptor:
    state_id: String
    state_kind: String
    transition_policy: String

struct GameplayEventDescriptor:
    event_bus_id: String
    event_kind: String
    delivery_policy: String

struct GameplayRuntimeProfile:
    ruleset: GameplayRulesetDescriptor
    state_runtime: GameplayStateDescriptor
    event_runtime: GameplayEventDescriptor

fn default_gameplay_runtime_profile() -> GameplayRuntimeProfile with Pure:
    let profile = GameplayRuntimeProfile()

    profile.ruleset = GameplayRulesetDescriptor()
    profile.ruleset.ruleset_id = "universal_gameplay_framework"
    profile.ruleset.gameplay_scope = "editor_runtime_simulation_and_mission_logic"
    profile.ruleset.authority_policy = "manifest_owned_runtime_authority"

    profile.state_runtime = GameplayStateDescriptor()
    profile.state_runtime.state_id = "gameplay_state_runtime"
    profile.state_runtime.state_kind = "mode_task_mission_and_world_rule_state"
    profile.state_runtime.transition_policy = "event_driven_checkpoint_and_replay_safe"

    profile.event_runtime = GameplayEventDescriptor()
    profile.event_runtime.event_bus_id = "gameplay_event_bus"
    profile.event_runtime.event_kind = "trigger_task_feedback_and_runtime_rule_events"
    profile.event_runtime.delivery_policy = "latency_critical_and_network_ready"
    profile
