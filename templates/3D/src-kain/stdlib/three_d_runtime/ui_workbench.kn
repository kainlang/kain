    let workspace_presets = WorkbenchSurfaceDescriptor()
    workspace_presets.surface_id = "workspace_preset_surface"
    workspace_presets.widget_kind = "Graph"
    workspace_presets.title = "Workspace Preset Catalog"
    workspace_presets.dock_region = "bottom"
    push(surfaces, workspace_presets)

    let jobs_receipts = WorkbenchSurfaceDescriptor()
    jobs_receipts.surface_id = "jobs_receipt_surface"
    jobs_receipts.widget_kind = "Graph"
    jobs_receipts.title = "Jobs Receipt Ledger"
