// Kain UI shell defaults for a desktop-grade 3D authoring suite.

struct WorkbenchSurfaceDescriptor:
    surface_id: String
    widget_kind: String
    title: String
    dock_region: String

struct WorkbenchThemeDescriptor:
    theme_id: String
    palette_mode: String
    accent_color: String
    viewport_chrome: String

struct WorkbenchPresetCatalogDescriptor:
    registry_id: String
    manifest_source: String
    presentation_policy: String

struct WorkbenchPresetShortcutDescriptor:
    preset_id: String
    label: String
    focus_lane: String

fn default_primary_surfaces() -> Array<WorkbenchSurfaceDescriptor> with Pure:
    let surfaces = []

    let viewport = WorkbenchSurfaceDescriptor()
    viewport.surface_id = "viewport_stage"
    viewport.widget_kind = "Viewport3D"
    viewport.title = "Primary Viewport"
    viewport.dock_region = "center"
    push(surfaces, viewport)

    let outliner = WorkbenchSurfaceDescriptor()
    outliner.surface_id = "scene_outliner"
    outliner.widget_kind = "Tree"
    outliner.title = "Scene Graph"
    outliner.dock_region = "left"
    push(surfaces, outliner)

    let inspector = WorkbenchSurfaceDescriptor()
    inspector.surface_id = "selection_inspector"
    inspector.widget_kind = "Inspector"
    inspector.title = "Selection Inspector"
    inspector.dock_region = "right"
    push(surfaces, inspector)

    let procedural = WorkbenchSurfaceDescriptor()
    procedural.surface_id = "procedural_stack"
    procedural.widget_kind = "Graph"
    procedural.title = "Procedural Stack"
    procedural.dock_region = "bottom"
    push(surfaces, procedural)

    let material_graph = WorkbenchSurfaceDescriptor()
    material_graph.surface_id = "material_graph"
    material_graph.widget_kind = "Graph"
    material_graph.title = "Material Graph"
    material_graph.dock_region = "bottom"
    push(surfaces, material_graph)

    let timeline = WorkbenchSurfaceDescriptor()
    timeline.surface_id = "timeline_surface"
