    let collaboration = WorkbenchSurfaceDescriptor()
    collaboration.surface_id = "collaboration_review_surface"
    collaboration.widget_kind = "Inspector"
    collaboration.title = "Collaboration Review"
    collaboration.dock_region = "right"
    push(surfaces, collaboration)

    let compositor = WorkbenchSurfaceDescriptor()
    compositor.surface_id = "compositor_finishing_surface"
    compositor.widget_kind = "Graph"
    compositor.title = "Compositor Finishing"
    compositor.dock_region = "bottom"
    push(surfaces, compositor)

    let exchange = WorkbenchSurfaceDescriptor()
    exchange.surface_id = "scene_exchange_surface"
    exchange.widget_kind = "Inspector"
    exchange.title = "Scene Exchange"
    exchange.dock_region = "right"
    push(surfaces, exchange)

    let metrology = WorkbenchSurfaceDescriptor()
    metrology.surface_id = "metrology_inspection_surface"
    metrology.widget_kind = "Inspector"
    metrology.title = "Metrology Inspection"
    metrology.dock_region = "right"
