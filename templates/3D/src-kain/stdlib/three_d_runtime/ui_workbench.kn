    timeline.title = "Timeline"
    timeline.dock_region = "bottom"
    push(surfaces, timeline)

    let orchestration = WorkbenchSurfaceDescriptor()
    orchestration.surface_id = "artifact_orchestration"
    orchestration.widget_kind = "Graph"
    orchestration.title = "Artifact Orchestration"
    orchestration.dock_region = "bottom"
