    let fabrication = WorkbenchSurfaceDescriptor()
    fabrication.surface_id = "fabrication_schedule_surface"
    fabrication.widget_kind = "Inspector"
    fabrication.title = "Fabrication Scheduling"
    fabrication.dock_region = "right"
