    scene_semantics.surface_id = "scene_semantics_surface"
    scene_semantics.widget_kind = "Inspector"
    scene_semantics.title = "Scene Semantics"
    scene_semantics.dock_region = "right"
    push(surfaces, scene_semantics)

    let query_surface = WorkbenchSurfaceDescriptor()
