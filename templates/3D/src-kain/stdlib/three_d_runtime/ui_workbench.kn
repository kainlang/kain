    biome.widget_kind = "Graph"
    biome.title = "Biome Authoring"
    biome.dock_region = "bottom"
    push(surfaces, biome)

    let destruction = WorkbenchSurfaceDescriptor()
    destruction.surface_id = "destruction_lab"
    destruction.widget_kind = "Inspector"
    destruction.title = "Destruction Lab"
    destruction.dock_region = "right"
    push(surfaces, destruction)

    let annotations = WorkbenchSurfaceDescriptor()
    annotations.surface_id = "review_annotations"
    annotations.widget_kind = "Inspector"
    annotations.title = "Review Annotations"
    annotations.dock_region = "right"
    push(surfaces, annotations)

    let publishing = WorkbenchSurfaceDescriptor()
    publishing.surface_id = "distribution_publisher"
    publishing.widget_kind = "Inspector"
    publishing.title = "Distribution Publisher"
    publishing.dock_region = "right"
