    let navigation = WorkbenchSurfaceDescriptor()
    navigation.surface_id = "navigation_surface"
    navigation.widget_kind = "Graph"
    navigation.title = "Navigation Crowd Lab"
    navigation.dock_region = "bottom"
    push(surfaces, navigation)

    let vehicle = WorkbenchSurfaceDescriptor()
    vehicle.surface_id = "vehicle_surface"
    vehicle.widget_kind = "Inspector"
    vehicle.title = "Vehicle Dynamics Lab"
    vehicle.dock_region = "right"
    push(surfaces, vehicle)

    let lighting = WorkbenchSurfaceDescriptor()
    lighting.surface_id = "lighting_surface"
    lighting.widget_kind = "Inspector"
    lighting.title = "Lighting Pipeline Stage"
    lighting.dock_region = "right"
    push(surfaces, lighting)

    let broadcast = WorkbenchSurfaceDescriptor()
    broadcast.surface_id = "broadcast_surface"
    broadcast.widget_kind = "Inspector"
    broadcast.title = "Broadcast Control Room"
    broadcast.dock_region = "right"
    push(surfaces, broadcast)

    let color = WorkbenchSurfaceDescriptor()
    color.surface_id = "color_surface"
    color.widget_kind = "Graph"
    color.title = "Color Management Control Room"
    color.dock_region = "bottom"
    push(surfaces, color)

    let media = WorkbenchSurfaceDescriptor()
    media.surface_id = "media_surface"
    media.widget_kind = "Graph"
    media.title = "Media Pipeline Stage"
    media.dock_region = "bottom"
    push(surfaces, media)

    let narrative = WorkbenchSurfaceDescriptor()
    narrative.surface_id = "narrative_surface"
    narrative.widget_kind = "Graph"
    narrative.title = "Narrative State Studio"
    narrative.dock_region = "bottom"
    push(surfaces, narrative)

    let haptics = WorkbenchSurfaceDescriptor()
    haptics.surface_id = "haptics_surface"
    haptics.widget_kind = "Graph"
    haptics.title = "Haptics Routing Lab"
    haptics.dock_region = "bottom"
    push(surfaces, haptics)

    let updates = WorkbenchSurfaceDescriptor()
    updates.surface_id = "updates_surface"
    updates.widget_kind = "Graph"
    updates.title = "Update Channel Registry"
    updates.dock_region = "bottom"
    push(surfaces, updates)

    review_database.surface_id = "review_database_surface"
    review_database.widget_kind = "Graph"
    review_database.title = "Review Database"
    review_database.dock_region = "bottom"
    push(surfaces, review_database)

    surfaces

fn default_workspace_preset_catalog() -> WorkbenchPresetCatalogDescriptor with Pure:
    let catalog = WorkbenchPresetCatalogDescriptor()
    catalog.registry_id = "workspace_preset_registry"
    catalog.manifest_source = "manifests/workspace_presets.json"
    catalog.presentation_policy = "manifest_catalog_with_workbench_shortcuts"
    catalog

fn default_workspace_preset_shortcuts() -> Array<WorkbenchPresetShortcutDescriptor> with Pure:
    let shortcuts = []

    let sculpt = WorkbenchPresetShortcutDescriptor()
    sculpt.preset_id = "sculpt_studio"
    sculpt.label = "Sculpt Studio"
    sculpt.focus_lane = "sculpt"
    push(shortcuts, sculpt)

    let render = WorkbenchPresetShortcutDescriptor()
    render.preset_id = "render_lab"
    render.label = "Render Lab"
    render.focus_lane = "render"
    push(shortcuts, render)

    let review = WorkbenchPresetShortcutDescriptor()
    review.preset_id = "collaboration_review_stage"
    review.label = "Collaboration Review Stage"
    review.focus_lane = "review"
    push(shortcuts, review)

    let bundles = WorkbenchPresetShortcutDescriptor()
    bundles.preset_id = "runtime_bundle_manager"
    bundles.label = "Runtime Bundle Manager"
    bundles.focus_lane = "runtime_bundles"
    push(shortcuts, bundles)

    let color = WorkbenchPresetShortcutDescriptor()
    color.preset_id = "color_management_control_room"
    color.label = "Color Management Control Room"
    color.focus_lane = "color_management"
    push(shortcuts, color)

    shortcuts

fn default_workbench_theme() -> WorkbenchThemeDescriptor with Pure:
    let theme = WorkbenchThemeDescriptor()
    theme.theme_id = "industrial_sunrise"
    theme.palette_mode = "dark"
    theme.accent_color = "#f97316"
    theme.viewport_chrome = "high_contrast"
    theme
