// Editor shell, transactions, and workspace contracts for authoring-focused desktop tools.

struct EditorCommandDescriptor:
    command_id: String
    lane: String
    transaction_policy: String
    undo_scope: String

struct WorkspaceModeDescriptor:
    mode_id: String
    label: String
    default_preset: String
    active_lane: String
    preset_source: String

struct EditorRuntimeProfile:
    command_history: EditorCommandDescriptor
    graph_editing: EditorCommandDescriptor
    sculpt_session: WorkspaceModeDescriptor
    render_session: WorkspaceModeDescriptor
    scan_session: WorkspaceModeDescriptor
    review_session: WorkspaceModeDescriptor
    orchestration_session: WorkspaceModeDescriptor
    constraints_session: WorkspaceModeDescriptor
    biome_session: WorkspaceModeDescriptor
    destruction_session: WorkspaceModeDescriptor
    publishing_session: WorkspaceModeDescriptor
    semantics_session: WorkspaceModeDescriptor
    query_session: WorkspaceModeDescriptor
    bundle_session: WorkspaceModeDescriptor
    materialization_session: WorkspaceModeDescriptor
    asset_registry_session: WorkspaceModeDescriptor

fn default_editor_command(command_id: String, lane: String) -> EditorCommandDescriptor with Pure:
    let command = EditorCommandDescriptor()
    command.command_id = command_id
    command.lane = lane
    command.transaction_policy = "record"
    command.undo_scope = "workspace_session"
    command

fn default_workspace_mode(mode_id: String, label: String, default_preset: String, active_lane: String) -> WorkspaceModeDescriptor with Pure:
    let mode = WorkspaceModeDescriptor()
    mode.mode_id = mode_id
    mode.label = label
    mode.default_preset = default_preset
    mode.active_lane = active_lane
    mode.preset_source = "manifests/workspace_presets.json"
    mode

fn default_editor_runtime_profile() -> EditorRuntimeProfile with Pure:
    let profile = EditorRuntimeProfile()
    profile.command_history = default_editor_command("command_history", "editor")
    profile.graph_editing = default_editor_command("graph_editing", "materials")
    profile.sculpt_session = default_workspace_mode("sculpt_session", "Sculpt Session", "sculpt", "sculpt")
    profile.render_session = default_workspace_mode("render_session", "Render Session", "render", "render")
    profile.scan_session = default_workspace_mode("scan_session", "Scan Session", "scan", "photogrammetry")
    profile.review_session = default_workspace_mode("review_session", "Review Session", "review", "review")
    profile.orchestration_session = default_workspace_mode("orchestration_session", "Build Session", "orchestration", "orchestration")
    profile.constraints_session = default_workspace_mode("constraints_session", "Constraint Session", "constraints", "constraints")
    profile.biome_session = default_workspace_mode("biome_session", "Biome Session", "biome", "biome")
    profile.destruction_session = default_workspace_mode("destruction_session", "Destruction Session", "destruction", "destruction")
    profile.publishing_session = default_workspace_mode("publishing_session", "Publishing Session", "publishing", "publishing")
    profile.semantics_session = default_workspace_mode("semantics_session", "Scene Semantics Session", "scene_semantics", "scene_semantics")
    profile.query_session = default_workspace_mode("query_session", "Query Session", "query_selection", "query_selection")
    profile.bundle_session = default_workspace_mode("bundle_session", "Bundle Session", "runtime_bundles", "runtime_bundles")
    profile.materialization_session = default_workspace_mode("materialization_session", "Materialization Session", "materialization", "materialization")
    profile.asset_registry_session = default_workspace_mode("asset_registry_session", "Asset Registry Session", "asset_registry", "asset_registry")
    profile
