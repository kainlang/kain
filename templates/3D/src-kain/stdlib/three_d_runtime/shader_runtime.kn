// Shader authoring/runtime contracts for shader families, permutation catalogs, program layouts, and reflection-safe material binding.

struct ShaderFamilyDescriptor:
    family_id: String
    family_scope: String
    permutation_policy: String

struct ShaderProgramDescriptor:
    program_id: String
    program_kind: String
    layout_policy: String

struct ShaderReflectionDescriptor:
    reflection_id: String
    reflection_scope: String
    binding_policy: String

struct ShaderRuntimeProfile:
    shader_family: ShaderFamilyDescriptor
    shader_program: ShaderProgramDescriptor
    shader_reflection: ShaderReflectionDescriptor

fn default_shader_runtime_profile() -> ShaderRuntimeProfile with Pure:
    let profile = ShaderRuntimeProfile()

    profile.shader_family = ShaderFamilyDescriptor()
    profile.shader_family.family_id = "universal_shader_family"
    profile.shader_family.family_scope = "surface_volume_post_compute_ui_and_stage_shader_families"
    profile.shader_family.permutation_policy = "keyword_material_and_platform_variant_driven"

    profile.shader_program = ShaderProgramDescriptor()
    profile.shader_program.program_id = "universal_shader_program"
    profile.shader_program.program_kind = "render_compute_and_presentation_program_layouts"
    profile.shader_program.layout_policy = "resource_schema_and_reflection_bound"

    profile.shader_reflection = ShaderReflectionDescriptor()
    profile.shader_reflection.reflection_id = "shader_reflection_runtime"
    profile.shader_reflection.reflection_scope = "material_binding_pipeline_layout_and_delivery_compatibility"
    profile.shader_reflection.binding_policy = "runtime_contract_and_manifest_registered"
    profile
