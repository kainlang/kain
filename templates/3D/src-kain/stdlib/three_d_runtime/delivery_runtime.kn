// Delivery materializer contracts that consume manifest graphs and emit resumable output batches.

struct DeliveryGraphDescriptor:
    graph_id: String
    graph_scope: String
    tensor_pipeline_id: String
    resume_policy: String

struct DeliveryBatchDescriptor:
    batch_id: String
    batch_kind: String
    approval_policy: String
    output_root: String

struct DeliveryRuntimeProfile:
    runtime_delivery_graph: DeliveryGraphDescriptor
    review_delivery_graph: DeliveryGraphDescriptor
    workspace_preset_delivery_graph: DeliveryGraphDescriptor
    promoted_batch: DeliveryBatchDescriptor
    resumable_batch: DeliveryBatchDescriptor
    workspace_preset_batch: DeliveryBatchDescriptor

fn default_delivery_graph_descriptor(
    graph_id: String,
    graph_scope: String,
    resume_policy: String
) -> DeliveryGraphDescriptor with Pure:
    let descriptor = DeliveryGraphDescriptor()
    descriptor.graph_id = graph_id
    descriptor.graph_scope = graph_scope
    descriptor.tensor_pipeline_id = "delivery_materializer_tensor_pipeline"
    descriptor.resume_policy = resume_policy
    descriptor

fn default_delivery_runtime_profile() -> DeliveryRuntimeProfile with Pure:
    let profile = DeliveryRuntimeProfile()
    profile.runtime_delivery_graph = default_delivery_graph_descriptor("runtime_delivery_graph", "runtime_bundle_and_package_delivery", "resume_from_receipts")
    profile.review_delivery_graph = default_delivery_graph_descriptor("review_delivery_graph", "review_lookdev_and_stage_delivery", "resume_from_approvals")
    profile.workspace_preset_delivery_graph = default_delivery_graph_descriptor("workspace_preset_materialization_graph", "workspace_preset_export_and_launch_receipt_delivery", "resume_from_workspace_preset_receipts")

    profile.promoted_batch = DeliveryBatchDescriptor()
    profile.promoted_batch.batch_id = "promoted_delivery_batch"
    profile.promoted_batch.batch_kind = "approved_artifact_promotion"
    profile.promoted_batch.approval_policy = "channel_gated"
    profile.promoted_batch.output_root = "generated/delivery/promoted"

    profile.resumable_batch = DeliveryBatchDescriptor()
    profile.resumable_batch.batch_id = "resumable_delivery_batch"
    profile.resumable_batch.batch_kind = "resumable_manifest_materialization"
    profile.resumable_batch.approval_policy = "receipt_and_channel_aware"
    profile.resumable_batch.output_root = "generated/delivery/resumable"

    profile.workspace_preset_batch = DeliveryBatchDescriptor()
    profile.workspace_preset_batch.batch_id = "workspace_preset_delivery_batch"
    profile.workspace_preset_batch.batch_kind = "workspace_preset_manifest_export"
    profile.workspace_preset_batch.approval_policy = "workspace_owner_and_schema_compatible"
    profile.workspace_preset_batch.output_root = "generated/workspace-presets"
    profile
