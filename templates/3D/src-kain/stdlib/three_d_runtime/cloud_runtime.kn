// Cloud contracts for remote sessions, object storage, elastic compute, and hybrid workspace routing.

struct CloudSessionDescriptor:
    session_id: String
    session_scope: String
    tenancy_policy: String

struct ObjectStorageDescriptor:
    storage_id: String
    storage_scope: String
    retention_policy: String

struct BurstComputeDescriptor:
    compute_id: String
    compute_scope: String
    scheduling_policy: String

struct CloudRuntimeProfile:
    cloud_session: CloudSessionDescriptor
    object_storage: ObjectStorageDescriptor
    burst_compute: BurstComputeDescriptor

fn default_cloud_runtime_profile() -> CloudRuntimeProfile with Pure:
    let profile = CloudRuntimeProfile()

    profile.cloud_session = CloudSessionDescriptor()
    profile.cloud_session.session_id = "cloud_session_runtime"
    profile.cloud_session.session_scope = "remote_authoring_review_streaming_and_distributed_runtime_sessions"
    profile.cloud_session.tenancy_policy = "workspace_project_partner_and_operator_isolated"

    profile.object_storage = ObjectStorageDescriptor()
    profile.object_storage.storage_id = "cloud_object_storage_runtime"
    profile.object_storage.storage_scope = "assets_caches_bundles_review_captures_and_dataset_payloads"
    profile.object_storage.retention_policy = "tiered_versioned_and_lineage_visible"

    profile.burst_compute = BurstComputeDescriptor()
    profile.burst_compute.compute_id = "cloud_burst_compute_runtime"
    profile.burst_compute.compute_scope = "render_bake_sim_ai_and_materialization_job_bursting"
    profile.burst_compute.scheduling_policy = "cost_budget_deadline_and_capability_aware"
    profile
