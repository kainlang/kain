// Resource residency/runtime contracts for buffers, textures, virtual resources, streaming tiers, and delivery-aware memory governance.

struct ResourceResidencyDescriptor:
    residency_id: String
    residency_scope: String
    budget_policy: String

struct ResourceStreamingDescriptor:
    streaming_id: String
    streaming_kind: String
    eviction_policy: String

struct ResourceBudgetDescriptor:
    budget_id: String
    budget_scope: String
    audit_policy: String

struct ResourceRuntimeProfile:
    residency_runtime: ResourceResidencyDescriptor
    streaming_runtime: ResourceStreamingDescriptor
    budget_runtime: ResourceBudgetDescriptor

fn default_resource_runtime_profile() -> ResourceRuntimeProfile with Pure:
    let profile = ResourceRuntimeProfile()

    profile.residency_runtime = ResourceResidencyDescriptor()
    profile.residency_runtime.residency_id = "resource_residency_runtime"
    profile.residency_runtime.residency_scope = "gpu_cpu_virtual_texture_volume_geometry_and_cache_resources"
    profile.residency_runtime.budget_policy = "frame_job_and_delivery_budget_aware"

    profile.streaming_runtime = ResourceStreamingDescriptor()
    profile.streaming_runtime.streaming_id = "resource_streaming_runtime"
    profile.streaming_runtime.streaming_kind = "mip_tile_mesh_volume_and_checkpoint_streaming"
    profile.streaming_runtime.eviction_policy = "priority_residency_heat_and_session_authority_driven"

    profile.budget_runtime = ResourceBudgetDescriptor()
    profile.budget_runtime.budget_id = "resource_budget_runtime"
    profile.budget_runtime.budget_scope = "render_scene_simulation_streaming_and_delivery_resource_budgets"
    profile.budget_runtime.audit_policy = "telemetry_cache_and_materialization_receipt_visible"
    profile
