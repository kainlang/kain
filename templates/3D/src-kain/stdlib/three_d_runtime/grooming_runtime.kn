// Groom, strand, fur, and feather authoring contracts.

struct GroomLayerDescriptor:
    layer_id: String
    strand_kind: String
    tensor_pipeline_id: String
    simulation_policy: String

struct GroomBrushDescriptor:
    brush_id: String
    brush_family: String
    falloff_policy: String
    stroke_policy: String

struct GroomRuntimeProfile:
    head_groom: GroomLayerDescriptor
    body_fur: GroomLayerDescriptor
    guide_brush: GroomBrushDescriptor

fn default_groom_layer(layer_id: String, strand_kind: String) -> GroomLayerDescriptor with Pure:
    let layer = GroomLayerDescriptor()
    layer.layer_id = layer_id
    layer.strand_kind = strand_kind
    layer.tensor_pipeline_id = "groom_authoring_tensor_pipeline"
    layer.simulation_policy = "interactive_or_cached"
    layer

fn default_groom_runtime_profile() -> GroomRuntimeProfile with Pure:
    let profile = GroomRuntimeProfile()
    profile.head_groom = default_groom_layer("head_groom", "hair_strands")
    profile.body_fur = default_groom_layer("body_fur", "fur_shell_or_strands")

    profile.guide_brush = GroomBrushDescriptor()
    profile.guide_brush.brush_id = "guide_brush"
    profile.guide_brush.brush_family = "comb_clump_cut_noise"
    profile.guide_brush.falloff_policy = "strand_radius"
    profile.guide_brush.stroke_policy = "stroke_tensor_driven"
    profile
