// Plugin packaging, extension registration, and runtime capability contracts.

struct PluginPackageDescriptor:
    package_id: String
    package_kind: String
    contract_policy: String
    target_runtime: String

struct ExtensionPointDescriptor:
    extension_id: String
    lane: String
    loading_policy: String

struct PluginRuntimeProfile:
    native_plugin: PluginPackageDescriptor
    script_plugin: PluginPackageDescriptor
    shader_pack_extension: ExtensionPointDescriptor
    tool_extension: ExtensionPointDescriptor

fn default_plugin_package(package_id: String, package_kind: String, target_runtime: String) -> PluginPackageDescriptor with Pure:
    let descriptor = PluginPackageDescriptor()
    descriptor.package_id = package_id
    descriptor.package_kind = package_kind
    descriptor.contract_policy = "generated_contract_required"
    descriptor.target_runtime = target_runtime
    descriptor

fn default_plugin_runtime_profile() -> PluginRuntimeProfile with Pure:
    let profile = PluginRuntimeProfile()
    profile.native_plugin = default_plugin_package("native_plugin", "native_extension", "native_ui")
    profile.script_plugin = default_plugin_package("script_plugin", "script_extension", "ks_runtime")

    profile.shader_pack_extension = ExtensionPointDescriptor()
    profile.shader_pack_extension.extension_id = "shader_pack_extension"
    profile.shader_pack_extension.lane = "render"
    profile.shader_pack_extension.loading_policy = "startup_or_hot_reload"

    profile.tool_extension = ExtensionPointDescriptor()
    profile.tool_extension.extension_id = "tool_extension"
    profile.tool_extension.lane = "editor"
    profile.tool_extension.loading_policy = "workspace_scoped"
    profile
