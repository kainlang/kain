// SPIR-V seed for AI agent planning, utility scoring, and scene-aware decision packets.

kernel agent_behavior_planner_resolve:
    stage = "compute"
    domain = "ai"
    dispatch = [128, 1, 1]

    input agent_states: Tensor
    input planner_goals: Tensor
    input scene_semantics: Tensor
    input nav_context: Tensor

    output resolved_agent_plans: Tensor
    output ai_decision_packets: Tensor
