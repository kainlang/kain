// SPIR-V asset lineage resolution seed.

shader compute asset_lineage_resolve(id: UVec3) -> Vec4:
    uniform source_assets: StorageBuffer<Vec4> @0
    uniform derived_assets: StorageBuffer<Vec4> @1
    uniform dependency_graph: StorageBuffer<Vec4> @2
    uniform lineage_edges: StorageBuffer<Vec4> @3
    let asset_index = id.x
    let source = source_assets[asset_index]
    let derived = derived_assets[asset_index]
    let dependency = dependency_graph[asset_index]
    let output = vec4(
        source.x + derived.x,
        source.y + dependency.y,
        derived.z + dependency.z,
        1.0
    )
    lineage_edges[asset_index] = output
    return output
