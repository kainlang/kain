// SPIR-V runtime bundle assembly seed.

shader compute runtime_bundle_assemble(id: UVec3) -> Vec4:
    uniform runtime_targets: StorageBuffer<Vec4> @0
    uniform launch_profiles: StorageBuffer<Vec4> @1
    uniform bundle_policy: StorageBuffer<Vec4> @2
    uniform assembled_bundle_state: StorageBuffer<Vec4> @3
    let target_index = id.x
    let target = runtime_targets[target_index]
    let launch = launch_profiles[target_index]
    let policy = bundle_policy[0]
    let output = vec4(
        target.x + launch.x,
        target.y + policy.y,
        launch.z + policy.z,
        1.0
    )
    assembled_bundle_state[target_index] = output
    return output
