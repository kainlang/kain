// SPIR-V runtime reflection indexing seed.

shader compute runtime_schema_index_resolve(id: UVec3) -> Vec4:
    uniform schema_records: StorageBuffer<Vec4> @0
    uniform gpu_records: StorageBuffer<Vec4> @1
    uniform contract_records: StorageBuffer<Vec4> @2
    uniform indexed_reflection_records: StorageBuffer<Vec4> @3
    let record_index = id.x
    let schema_record = schema_records[record_index]
    let gpu_record = gpu_records[record_index]
    let contract_record = contract_records[record_index]
    let output = vec4(
        schema_record.x + gpu_record.x,
        schema_record.y + contract_record.y,
        gpu_record.z + contract_record.z,
        1.0
    )
    indexed_reflection_records[record_index] = output
    return output
