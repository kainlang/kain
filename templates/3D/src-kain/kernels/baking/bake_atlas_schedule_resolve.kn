// SPIR-V seed for bake target scheduling, atlas packing intent, and bake receipt generation.

kernel bake_atlas_schedule_resolve:
    stage = "compute"
    domain = "baking"
    dispatch = [64, 1, 1]

    input bake_targets: Tensor
    input uv_charts: Tensor
    input probe_sets: Tensor
    input bake_budget: Tensor

    output resolved_bake_schedule: Tensor
    output bake_receipt_packets: Tensor
