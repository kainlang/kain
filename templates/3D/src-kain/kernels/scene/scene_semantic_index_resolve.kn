// SPIR-V scene semantic indexing seed.

shader compute scene_semantic_index_resolve(id: UVec3) -> Vec4:
    uniform semantic_nodes: StorageBuffer<Vec4> @0
    uniform collection_state: StorageBuffer<Vec4> @1
    uniform variant_state: StorageBuffer<Vec4> @2
    uniform semantic_index: StorageBuffer<Vec4> @3
    let node_index = id.x
    let semantic = semantic_nodes[node_index]
    let collection = collection_state[node_index]
    let variant = variant_state[node_index]
    let output = vec4(
        semantic.x + collection.x,
        semantic.y + variant.y,
        collection.z + variant.z,
        1.0
    )
    semantic_index[node_index] = output
    return output
