// SPIR-V sequencing and editorial timeline resolve seed.

shader compute shot_sequence_timeline_resolve(id: UVec3) -> Vec4:
    uniform shot_clips: StorageBuffer<Vec4> @0
    uniform take_records: StorageBuffer<Vec4> @1
    uniform editorial_events: StorageBuffer<Vec4> @2
    uniform resolved_sequence_frames: StorageBuffer<Vec4> @3
    let clip_index = id.x
    let clip = shot_clips[clip_index]
    let take = take_records[clip_index]
    let event = editorial_events[clip_index]
    let output = vec4(
        clip.x + take.x,
        clip.y + event.y,
        take.z + event.z,
        1.0
    )
    resolved_sequence_frames[clip_index] = output
    return output
