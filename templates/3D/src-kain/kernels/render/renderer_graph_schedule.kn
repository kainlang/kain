// SPIR-V renderer graph scheduling seed.

shader compute renderer_graph_schedule(id: UVec3) -> Vec4:
    uniform render_pass_nodes: StorageBuffer<Vec4> @0
    uniform dependency_edges: StorageBuffer<Vec4> @1
    uniform frame_budget_state: StorageBuffer<Vec4> @2
    uniform scheduled_passes: StorageBuffer<Vec4> @3
    let node_index = id.x
    let pass_node = render_pass_nodes[node_index]
    let dependency = dependency_edges[node_index]
    let budget = frame_budget_state[0]
    let output = vec4(
        pass_node.x + dependency.x,
        pass_node.y + budget.y,
        dependency.z + budget.z,
        1.0
    )
    scheduled_passes[node_index] = output
    return output
