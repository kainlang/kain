// SPIR-V XR stereo frame resolve seed.

shader compute xr_stereo_frame_resolve(id: UVec3) -> Vec4:
    uniform stereo_views: StorageBuffer<Vec4> @0
    uniform head_pose_state: StorageBuffer<Vec4> @1
    uniform ui_composite_state: StorageBuffer<Vec4> @2
    uniform stereo_frame_payload: StorageBuffer<Vec4> @3
    let frame_index = id.x
    let view = stereo_views[frame_index]
    let pose = head_pose_state[frame_index]
    let ui = ui_composite_state[0]
    let output = vec4(
        view.x + pose.x,
        view.y + pose.y,
        view.z + ui.z,
        1.0
    )
    stereo_frame_payload[frame_index] = output
    return output
