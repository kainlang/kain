  "runtime_app_id": "{{runtime_app_id}}",
  "runtime_bundle_profile_id": "runtime_bundle_launch_profile",
  "workspace_layout_runtime_id": "workspace_layout_runtime",
  "tensor_pipeline_id": "workspace_preset_tensor_pipeline",
  "delivery_registry_id": "workspace_preset_delivery_registry",
  "artifacts": [
    {
      "kind": "launch_manifest_root",
      "root": "generated/workspace-presets/launch"
    },
    {
