{
  "enabled": true,
  "name": "Metadata Schema Validator",
  "description": "Validates JSON metadata files against their schemas whenever metadata is modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "unreal/metadata/*.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The metadata file was just modified. Validate it against its corresponding schema file (look for *_schema.json). Check: 1) JSON syntax is valid, 2) All required fields present, 3) Types match schema, 4) No duplicate keys. If invalid, fix immediately. If valid, confirm with a brief message."
  }
}