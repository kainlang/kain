{
  "enabled": true,
  "name": "UE5 Integration Tester",
  "description": "Builds test plugin in UE5 after codegen changes to verify generated C++ compiles",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run full UE5 integration test: 1) cd testing/Phase3/SlateTest4, 2) Run 'kain build --ue5', 3) Verify all generated C++ files are syntactically correct, 4) Check for common UE5 errors (missing includes, wrong macros, pointer issues), 5) Report any codegen bugs found with file:line references."
  }
}