{
  "enabled": true,
  "name": "Dependency Graph Validator",
  "description": "Validates module dependency graph and detects circular dependencies",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "unreal/metadata/module_graph*.json"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "python unreal/scripts/validate_module_graph.py",
    "timeout": 60
  }
}