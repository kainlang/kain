{
  "enabled": true,
  "name": "Naming Convention Enforcer",
  "description": "Ensures naming.rs functions are used consistently, no inline prefix logic",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "crates/ue5/src/codegen_ue5.rs",
      "crates/ue5-editor/src/editor/*.rs"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Codegen file modified. Scan for inline prefix logic like format!(\"A{}\", name) or format!(\"F{}\", name). All UE5 type prefixing MUST use naming.rs functions (to_actor_name, to_struct_name, to_enum_name, etc.). Report any violations and fix them immediately."
  }
}