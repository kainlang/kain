{
  "enabled": true,
  "name": "Test Fixture Regenerator",
  "description": "Regenerates test fixtures and snapshots when codegen files are modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "crates/ue5/src/codegen_ue5.rs",
      "crates/ue5-editor/src/editor/*.rs",
      "crates/ue5-shaders/src/*.rs"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Codegen file modified. Identify which test fixtures in crates/*/tests/ depend on this codegen. Regenerate affected fixtures by running the relevant tests with --update-snapshots or similar. List which fixtures were updated."
  }
}