{
  "enabled": true,
  "name": "Metadata Auto-Expander",
  "description": "Detects missing UE5 types in codegen and suggests metadata expansions",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Scan all codegen files for hardcoded UE5 type references (UStaticMeshComponent, FVector, etc.). Cross-reference with engine_knowledge.json, widget_registry.json, shader_knowledge.json. Identify missing types. For each missing type, run the appropriate expansion script (expand_engine_knowledge.py, expand_widget_registry.py, etc.) to add it. Report what was added."
  }
}