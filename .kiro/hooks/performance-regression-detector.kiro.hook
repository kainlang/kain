{
  "enabled": true,
  "name": "Performance Regression Detector",
  "description": "Runs performance benchmarks after codegen changes to detect regressions",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "cargo bench --package kain-core --package ue5 --package ue5-editor",
    "timeout": 300
  }
}