{
  "enabled": true,
  "name": "EngineKnowledge Propagator",
  "description": "Validates that EngineKnowledge changes propagate correctly to all codegen crates",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "unreal/metadata/engine_knowledge.json",
      "crates/ue5/src/ue5/engine_knowledge.rs"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "EngineKnowledge was modified. Verify: 1) JSON is valid and schema-compliant, 2) Rust loader in engine_knowledge.rs handles new fields, 3) All codegen crates (ue5, ue5-editor, ue5-shaders) can access new data via Ue5Context, 4) Run tests to ensure no regressions. Report findings."
  }
}