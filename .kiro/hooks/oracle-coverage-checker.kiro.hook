{
  "enabled": true,
  "name": "Oracle Coverage Checker",
  "description": "Verifies oracle.rs has validation rules for all codegen patterns",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "crates/ue5/src/ue5/oracle.rs",
      "crates/ue5-shaders/src/validation.rs"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Oracle/validation file modified. Verify coverage: 1) All UE5 naming collisions detected (check against EngineKnowledge), 2) All shader validation rules present (uniform bindings, permutations, etc.), 3) RPC naming conventions validated, 4) Component/Actor state validation, 5) No gaps in semantic checks. Add missing rules if found."
  }
}