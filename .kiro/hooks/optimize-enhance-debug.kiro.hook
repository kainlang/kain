{
  "enabled": true,
  "name": "Optimize, Enhance & Debug",
  "description": "Automatically reviews completed work to optimize code, suggest new features, and identify potential bugs",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the work just completed and:\n\n1. **Optimize**: Identify performance improvements, code simplifications, or better patterns\n2. **Enhance**: Suggest 2-3 new features or improvements that would add value\n3. **Debug**: Look for potential bugs, edge cases, or error handling gaps\n\nFocus on actionable improvements. If you find critical issues, fix them immediately. For enhancements, briefly describe them so the user can decide."
  },
  "workspaceFolderName": "kain",
  "shortName": "optimize-enhance-debug"
}