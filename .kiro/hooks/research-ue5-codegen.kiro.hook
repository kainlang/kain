{
  "enabled": true,
  "name": "Research UE5 Codegen Context",
  "description": "Automatically uses context-gatherer subagent to research relevant codegen files when user asks about UE5 implementation, pipeline improvements, or making the system smarter",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before responding to this request about UE5 codegen implementation or pipeline improvements, use the context-gatherer subagent to research relevant files in the codebase. Focus on:\n- crates/ue5/src/codegen_ue5.rs and related codegen files\n- crates/ue5-editor/src/editor/ directory for editor features\n- crates/cli/src/packager.rs for build orchestration\n- testing/Phase3/SlateTest4/ for current test patterns\n- Any files related to the specific feature being discussed\n\nAfter gathering context, provide a comprehensive response that considers the existing architecture and patterns."
  },
  "workspaceFolderName": "kain",
  "shortName": "research-ue5-codegen"
}