{
  "enabled": true,
  "name": "Research KAIN",
  "description": "Automatically uses context-gatherer subagent to research relevant codegen files when user asks about to review something related to Kain, as the codebase is massive and hard to digest everything.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Use this when the user ask about a question related to Kain and finding a specific feature that it has, and provide necessary cli commands along with code proof of how the feature works.\nrelevant folders - \nM:\\Code\\Kain\\crates\\cli\nM:\\Code\\Kain\\crates\\gpu\nM:\\Code\\Kain\\crates\\kain-asm\nM:\\Code\\Kain\\crates\\kain-core\nM:\\Code\\Kain\\crates\\kain-omni\nM:\\Code\\Kain\\crates\\kain-import\nM:\\Code\\Kain\\crates\\kain-sys-codegen\nM:\\Code\\Kain\\crates\\web\nAfter gathering context, provide a comprehensive response that considers the existing architecture and patterns."
  },
  "workspaceFolderName": "Kain",
  "shortName": "research-ue5-codegen"
}