// ============================================================================
//  tree_format.kn — Output formatting for tree-kn directory explorer
// ============================================================================
//
//  Converts TreeResult into JSON, tree-text, flat-text, or summary-text
//  formats. The JSON path is consumed by the TypeScript PI extension bridge.
//
//  Ladder: Layer 0 — all plain fn / struct / let work. No state, no actors,
//  no worlds — pure data transformation with IO for print(). Each function
//  is marked Pure because formatting is a deterministic transformation.
//
// ============================================================================

use std::json
use std::time
use std::text
use std::os_path

use tree_types
use tree_scan_types

// ============================================================================
//  JSON FORMAT  —  Machine-readable output for the PI bridge
// ============================================================================

pub fn format_json(result: TreeResult) -> String with Pure:
    let root = json_object()
    let _ = json_object_set_string(root, "root", result.root)
    let _ = json_object_set_string(root, "action", result.action)

    // Convert entries array recursively
    let entries = json_array()
    var i = 0
    while i < len(result.entries):
        let _ = json_array_push_object(entries, entry_to_json(result.entries[i]))
        i = i + 1
    let _ = json_object_set_array(root, "entries", entries)

    // Convert summary
    let summary = json_object()
    let _ = json_object_set_int(summary, "total_files", result.summary.total_files)
    let _ = json_object_set_int(summary, "total_dirs", result.summary.total_dirs)
    let _ = json_object_set_int(summary, "total_bytes", result.summary.total_bytes)
    let _ = json_object_set_object(summary, "by_extension", result.summary.by_extension)
    let _ = json_object_set_object(summary, "by_language", result.summary.by_language)
    let _ = json_object_set_object(root, "summary", summary)

    // Convert errors
    let errors = json_array()
    i = 0
    while i < len(result.errors):
        let _ = json_array_push_string(errors, result.errors[i])
        i = i + 1
    let _ = json_object_set_array(root, "errors", errors)

    return json_stringify(root)


pub fn entry_to_json(entry: TreeEntry) -> JsonObject with Pure:
    let obj = json_object()
    let _ = json_object_set_string(obj, "path", entry.path)
    let _ = json_object_set_string(obj, "name", entry.name)
    let _ = json_object_set_string(obj, "entry_type", entry.entry_type)
    let _ = json_object_set_int(obj, "size", entry.size)
    let _ = json_object_set_int(obj, "modified_ms", entry.modified_ms)
    let _ = json_object_set_string(obj, "extension", entry.extension)
    let _ = json_object_set_string(obj, "language", entry.language)
    let _ = json_object_set_int(obj, "depth", entry.depth)

    // Recursively convert children
    let children = json_array()
    var i = 0
    while i < len(entry.children):
        let _ = json_array_push_object(children, entry_to_json(entry.children[i]))
        i = i + 1
    let _ = json_object_set_array(obj, "children", children)

    return obj


// ============================================================================
//  TREE TEXT FORMAT  —  Unix `tree`-style with box-drawing characters
// ============================================================================

pub fn format_tree_text(result: TreeResult) -> String with Pure:
    let root_name = os_path_basename(result.root)
    var display_root = root_name
    if len(display_root) == 0:
        display_root = result.root

    var output = display_root + "/"

    var i = 0
    while i < len(result.entries):
        let is_last = i == len(result.entries) - 1
        output = output + "\n" + format_tree_entry(result.entries[i], "", is_last)
        i = i + 1

    return output


pub fn format_tree_entry(entry: TreeEntry, prefix: String, is_last: Bool) -> String with Pure:
    // Choose connector character
    var connector = "├── "
    if is_last:
        connector = "└── "

    // Build the name part — append "/" to directories
    var name_part = entry.name
    if entry.entry_type == "directory":
        name_part = name_part + "/"

    let size_str = " (" + format_size(entry.size) + ")"
    var line_text = prefix + connector + name_part + size_str

    // Recurse into children if this is a directory
    if entry.entry_type == "directory" and len(entry.children) > 0:
        var child_prefix = prefix + "│   "
        if is_last:
            child_prefix = prefix + "    "

        var child_index = 0
        while child_index < len(entry.children):
            let child_last = child_index == len(entry.children) - 1
            line_text = line_text + "\n" + format_tree_entry(entry.children[child_index], child_prefix, child_last)
            child_index = child_index + 1

    return line_text


// ============================================================================
//  FLAT TEXT FORMAT  —  One path per line, type-prefixed, sorted
// ============================================================================

pub fn format_flat_text(result: TreeResult) -> String with Pure:
    let flat = flatten_entries(result.entries, result.root)
    let sorted = sort_flat_entries(flat)

    var output = ""
    var i = 0
    while i < len(sorted):
        if i > 0:
            output = output + "\n"
        let entry = sorted[i]

        var type_tag = "[DIR]  "
        if entry.entry_type == "file":
            type_tag = "[FILE] "

        var size_str = ""
        if entry.entry_type == "file":
            size_str = " (" + format_size(entry.size) + ")"

        output = output + type_tag + entry.path + size_str
        i = i + 1

    return output


// ============================================================================
//  SUMMARY TEXT FORMAT  —  Human-readable counts and breakdowns
// ============================================================================

pub fn format_summary_text(result: TreeResult) -> String with Pure:
    let s = result.summary
    var output = str(s.total_files) + " files, " + str(s.total_dirs) + " dirs, "
    output = output + format_size(s.total_bytes) + " total"

    output = output + "\n"
    output = output + "\nBy extension:"
    output = output + "\n  " + json_stringify(s.by_extension)

    output = output + "\n"
    output = output + "\nBy language:"
    output = output + "\n  " + json_stringify(s.by_language)

    if len(result.errors) > 0:
        output = output + "\n"
        output = output + "\nErrors:"
        var i = 0
        while i < len(result.errors):
            output = output + "\n  " + result.errors[i]
            i = i + 1

    return output


// ============================================================================
//  SCAN RESULT FORMAT  —  Public API symbols + import graph rendering
// ============================================================================

pub fn format_scan_results(result: ScanResult, show_pub: Bool, show_imports: Bool) -> String with Pure:
    var output = ""

    // Build divider string
    var divider = ""
    var di = 0
    while di < 50:
        divider = divider + "─"
        di = di + 1

    // Check if we have any scan data
    let has_symbols = len(result.pub_symbols) > 0
    let has_imports = len(result.imports) > 0
    let files_checked = result.files_scanned

    // If no actual content was scanned (standalone mode), show a helpful message
    if has_symbols == false and has_imports == false:
        output = output + "\n" + divider + "\n"
        output = output + "  Public API Surface\n"
        output = output + divider + "\n"
        output = output + "  No public symbols found in " + str(files_checked) + " files.\n"
        if files_checked > 0:
            output = output + "\n"
            output = output + "  Tip: Run with `kain run` (full runtime) to scan file contents.\n"
            output = output + "  Standalone executables cannot read file contents for scanning.\n"
        return output

    // ── Public Symbols ──
    if show_pub and has_symbols:
        let count = len(result.pub_symbols)
        let distinct_files = count_distinct_files(result.pub_symbols)

        output = output + "\n" + divider + "\n"
        output = output + "  Public API Surface (" + str(count) + " symbols across " + str(distinct_files) + " files)\n"
        output = output + divider + "\n"
        output = output + "\n"

        let grouped = group_symbols_by_file(result.pub_symbols)
        var gi = 0
        while gi < len(grouped):
            let grp = grouped[gi]
            output = output + "  " + grp.file_path + " (" + grp.language + "):\n"

            var sj = 0
            while sj < len(grp.symbols):
                let sym = grp.symbols[sj]
                output = output + "    pub " + sym.symbol_kind + " " + sym.symbol_name + "\n"
                sj = sj + 1

            output = output + "\n"
            gi = gi + 1

    // ── Imports ──
    if show_imports and has_imports:
        if show_pub and has_symbols:
            output = output + "\n"

        let imp_count = len(result.imports)
        let distinct_imp_files = count_distinct_import_files(result.imports)

        output = output + "\n" + divider + "\n"
        output = output + "  Import Graph (" + str(imp_count) + " statements across " + str(distinct_imp_files) + " files)\n"
        output = output + divider + "\n"
        output = output + "\n"

        let igroups = group_imports_by_file(result.imports)
        var igi = 0
        while igi < len(igroups):
            let igrp = igroups[igi]
            output = output + "  " + igrp.file_path + " imports:\n"

            var ij = 0
            while ij < len(igrp.imports):
                let imp = igrp.imports[ij]
                output = output + "    " + imp.import_kind + " " + imp.imported_module + "\n"
                ij = ij + 1

            output = output + "\n"
            igi = igi + 1

    return output


// ============================================================================
//  SCAN RESULT HELPERS
// ============================================================================

struct SymbolGroup:
    file_path: String
    language: String
    symbols: Array<PubSymbol>

struct ImportGroup:
    file_path: String
    imports: Array<ImportRef>


fn group_symbols_by_file(symbols: Array<PubSymbol>) -> Array<SymbolGroup> with Pure:
    let groups: Array<SymbolGroup> = []
    var i = 0
    while i < len(symbols):
        let sym = symbols[i]
        // Find or create group for this file
        var found = false
        var j = 0
        while j < len(groups):
            if groups[j].file_path == sym.file_path:
                push(groups[j].symbols, sym)
                found = true
                break
            j = j + 1
        if found == false:
            let new_group = SymbolGroup {
                file_path: sym.file_path,
                language: sym.language,
                symbols: [sym]
            }
            push(groups, new_group)
        i = i + 1
    return groups


fn group_imports_by_file(imports: Array<ImportRef>) -> Array<ImportGroup> with Pure:
    let groups: Array<ImportGroup> = []
    var i = 0
    while i < len(imports):
        let imp = imports[i]
        var found = false
        var j = 0
        while j < len(groups):
            if groups[j].file_path == imp.file_path:
                push(groups[j].imports, imp)
                found = true
                break
            j = j + 1
        if found == false:
            let new_group = ImportGroup {
                file_path: imp.file_path,
                imports: [imp]
            }
            push(groups, new_group)
        i = i + 1
    return groups


fn count_distinct_files(symbols: Array<PubSymbol>) -> Int with Pure:
    let seen: Array<String> = []
    var count = 0
    var i = 0
    while i < len(symbols):
        var found = false
        var j = 0
        while j < len(seen):
            if seen[j] == symbols[i].file_path:
                found = true
                break
            j = j + 1
        if found == false:
            push(seen, symbols[i].file_path)
            count = count + 1
        i = i + 1
    return count


fn count_distinct_import_files(imports: Array<ImportRef>) -> Int with Pure:
    let seen: Array<String> = []
    var count = 0
    var i = 0
    while i < len(imports):
        var found = false
        var j = 0
        while j < len(seen):
            if seen[j] == imports[i].file_path:
                found = true
                break
            j = j + 1
        if found == false:
            push(seen, imports[i].file_path)
            count = count + 1
        i = i + 1
    return count


// ============================================================================
//  SIZE / TIME HELPERS
// ============================================================================

pub fn format_size(bytes: Int) -> String with Pure:
    if bytes < 1024:
        return str(bytes) + " B"

    if bytes < 1048576:
        // KB: 1024 to 1048575
        let kb = bytes / 1024
        let frac = (bytes % 1024) * 10 / 1024
        return str(kb) + "." + str(frac) + " KB"

    if bytes < 1073741824:
        // MB: 1048576 to 1073741823
        let mb = bytes / 1048576
        let frac = (bytes % 1048576) * 10 / 1048576
        return str(mb) + "." + str(frac) + " MB"

    // GB: 1073741824+
    let gb = bytes / 1073741824
    let frac = (bytes % 1073741824) * 10 / 1073741824
    return str(gb) + "." + str(frac) + " GB"


pub fn format_timestamp(millis: Int) -> String with Pure:
    if millis <= 0:
        return "unknown"

    let dt = datetime_from_epoch_millis(millis)
    var result = str(dt.year) + "-" + pad2(dt.month) + "-" + pad2(dt.day)
    result = result + " " + pad2(dt.hour) + ":" + pad2(dt.minute) + ":" + pad2(dt.second)
    return result


// ============================================================================
//  INTERNAL HELPERS
// ============================================================================

fn pad2(value: Int) -> String with Pure:
    if value < 10:
        return "0" + str(value)
    return str(value)


fn flatten_entries(entries: Array<TreeEntry>, root_prefix: String) -> Array<TreeEntry> with Pure:
    var result = []
    var i = 0
    while i < len(entries):
        push(result, entries[i])

        // Recurse into directory children
        if entries[i].entry_type == "directory" and len(entries[i].children) > 0:
            let children = flatten_entries(entries[i].children, root_prefix)
            var j = 0
            while j < len(children):
                push(result, children[j])
                j = j + 1

        i = i + 1
    return result


fn sort_flat_entries(entries: Array<TreeEntry>) -> Array<TreeEntry> with Pure:
    // Copy the array
    var sorted = []
    var i = 0
    while i < len(entries):
        push(sorted, entries[i])
        i = i + 1

    // Selection sort: dirs before files, then alphabetical by path
    i = 0
    while i < len(sorted):
        var best = i
        var j = i + 1
        while j < len(sorted):
            if flat_entry_order(sorted[j], sorted[best]) < 0:
                best = j
            j = j + 1
        if best != i:
            let temp = sorted[i]
            sorted[i] = sorted[best]
            sorted[best] = temp
        i = i + 1

    return sorted


fn flat_entry_order(a: TreeEntry, b: TreeEntry) -> Int with Pure:
    // Dirs before files
    if a.entry_type != b.entry_type:
        if a.entry_type == "directory":
            return -1
        return 1

    // Same type — compare path alphabetically
    return string_compare(a.path, b.path)


fn string_compare(a: String, b: String) -> Int with Pure:
    var i = 0
    while i < len(a) and i < len(b):
        let ca = text_ord(char_at(a, i))
        let cb = text_ord(char_at(b, i))
        if ca != cb:
            if ca < cb:
                return -1
            return 1
        i = i + 1

    if len(a) < len(b):
        return -1
    if len(a) > len(b):
        return 1
    return 0
