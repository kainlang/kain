use std::json
use std::text

// ============================================================================
//  LANGUAGE MAP — extension-to-language lookup
//  fs_path_extension() returns the extension WITHOUT leading dot (e.g. "kn")
//  so map keys are stored without dots. Lookup is case-insensitive.
// ============================================================================

pub struct LangMapEntry:
    ext: String
    lang: String

fn lang_entry(ext: String, lang: String) -> LangMapEntry:
    return LangMapEntry{ext: to_lower(ext), lang: lang}

pub fn build_language_map() -> Array<LangMapEntry>:
    let map = []
    // Source code languages
    push(map, lang_entry("kn",     "kain"))
    push(map, lang_entry("rs",     "rust"))
    push(map, lang_entry("py",     "python"))
    push(map, lang_entry("ts",     "typescript"))
    push(map, lang_entry("tsx",    "typescript"))
