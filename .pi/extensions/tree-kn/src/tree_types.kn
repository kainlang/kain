    push(map, lang_entry("cpp",    "cpp"))
    push(map, lang_entry("hpp",    "cpp"))
    push(map, lang_entry("cxx",    "cpp"))
    push(map, lang_entry("cc",     "cpp"))
    push(map, lang_entry("go",     "go"))
    push(map, lang_entry("java",   "java"))
    push(map, lang_entry("kt",     "kotlin"))
    push(map, lang_entry("kts",    "kotlin"))
    push(map, lang_entry("scala",  "scala"))
    push(map, lang_entry("swift",  "swift"))
