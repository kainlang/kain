    push(map, lang_entry("env",    "dotenv"))
    return map

// Normalize an extension: strip leading dot, lowercase, trim whitespace
pub fn normalize_ext(raw: String) -> String:
    let mut normalized = to_lower(raw)
    // Strip leading dot if present
    if len(normalized) > 0 and char_at(normalized, 0) == ".":
        normalized = substring(normalized, 1, len(normalized))
    return normalized

pub fn detect_language(ext: String) -> String:
    let normalized = normalize_ext(ext)
    if len(normalized) == 0:
        return "unknown"
    let map = build_language_map()
    var i = 0
    while i < len(map):
        if map[i].ext == normalized:
            return map[i].lang
        i = i + 1
    return "unknown"

// ============================================================================
//  IGNORE DIRS — always-skip directory names
// ============================================================================

pub fn is_ignored_dir(name: String) -> Bool:
    let folded = to_lower(name)
    if folded == ".git":           return true
    if folded == ".kain":          return true
    if folded == "node_modules":   return true
    if folded == "target":         return true
    if folded == "bazel-bin":      return true
    if folded == "bazel-out":      return true
    if folded == "bazel-testlogs": return true
    if folded == "__pycache__":    return true
    if folded == ".venv":          return true
    if folded == "venv":           return true
    if folded == ".idea":          return true
    if folded == ".vscode":        return true
    if folded == "dist":           return true
    if folded == "build":          return true
    if folded == ".cache":         return true
    if folded == ".next":          return true
    if folded == ".nuxt":          return true
    if folded == ".yarn":          return true
    if folded == ".pytest_cache":  return true
    if folded == ".mypy_cache":    return true
    if folded == "elm-stuff":      return true
    if folded == "_build":         return true
    if folded == "deps":           return true
    if folded == ".dart_tool":     return true
    return false

pub fn is_hidden(name: String) -> Bool:
    if name == "." or name == "..":
        return false
    if len(name) > 0 and char_at(name, 0) == ".":
        return true
    return false

// ============================================================================
//  CORE TYPES
// ============================================================================

pub struct TreeConfig:
    root: String
    max_depth: Int
    include_hidden: Bool
    pattern: String
    exclude_patterns: Array<String>
    max_entries: Int
    action: String
    format: String
    scan_pub: Bool
    scan_imports: Bool
    scan_workers: Int

pub struct TreeEntry:
    path: String
    name: String
    entry_type: String
    size: Int
    modified_ms: Int
    extension: String
    language: String
    depth: Int
    children: Array<TreeEntry>

pub struct TreeSummary:
    total_files: Int
    total_dirs: Int
    total_bytes: Int
    by_extension: JsonObject
    by_language: JsonObject

pub struct TreeResult:
    root: String
    action: String
    entries: Array<TreeEntry>
    summary: TreeSummary
    errors: Array<String>
