// ============================================================================
//  tree_scan_types.kn — Scan data structures for pub surface scanning
//
//  Language-agnostic types for tracking public symbols and import references
//  found when scanning source trees. Works with any programming language
//  via the PubPattern mapping.
//
//  Ladder decision: Layer 0 (struct, fn) — these are pure data types and
//  lookup functions. No state authority (world), no concurrency (actor),
//  no temporal semantics (pulse) needed.
//
//  PubSymbol is deliberately a plain struct (not shatter) because the
//  scanning hot path is I/O-bound, not compute-bound. If post-scan
//  aggregation becomes a bottleneck, convert to shatter struct for SoA
//  layout.
// ============================================================================

use std::json

// ============================================================================
//  PubSymbol — A single public symbol found in a file
//
//  Fields are ordered by scan-time fill order (file context first, then
//  symbol details) to minimize cache misses during aggregation.
// ============================================================================

pub struct PubSymbol:
    file_path: String          // path to the file
    symbol_name: String        // the symbol name (e.g., "walk_tree", "TreeConfig")
    symbol_kind: String        // "function", "struct", "actor", "world", "enum", "trait", "macro", "class", "method", "const", "type", "module"
    line_number: Int           // approximate line number where found
    visibility: String         // "pub", "export", "public", "default" (language-normalized)
    signature: String          // the raw line trimmed (e.g., "pub fn walk_tree(config: TreeConfig) -> TreeResult")
    language: String           // detected language of the file

// ============================================================================
//  ImportRef — An import/reference found in a file
// ============================================================================

pub struct ImportRef:
    file_path: String          // the file that has the import
    imported_module: String    // what's being imported (e.g., "std::json", "react", "./utils")
    import_kind: String        // "use", "import", "include", "require", "from_import", "extern"
    language: String           // detected language of the file

// ============================================================================
//  ScanResult — Aggregated scan results from a single scan pass
// ============================================================================

pub struct ScanResult:
    pub_symbols: Array<PubSymbol>
    imports: Array<ImportRef>
    files_scanned: Int
    files_skipped: Int
    errors: Array<String>

// ============================================================================
//  ScanConfig — Configuration for the scanner actors
// ============================================================================

pub struct ScanConfig:
    include_pub: Bool          // scan for public symbols
    include_imports: Bool      // scan for imports
    max_file_bytes: Int        // skip files larger than this
    actor_count: Int           // number of scanner actors

// ============================================================================
//  PubPattern — Language-agnostic pub symbol detection pattern
//
//  Maps a language name → array of (prefix_string, symbol_kind) pairs.
//  A line is considered a pub symbol declaration if it starts with one of
//  the prefixes after trimming.
// ============================================================================

pub struct PubPattern:
    prefix: String             // e.g., "pub fn "
    kind: String               // e.g., "function"

// ============================================================================
//  LANGUAGE-SPECIFIC PUB PATTERNS
//
//  Each language has a getter that returns its known pub patterns.
//  Languages not listed return an empty array (no pub symbol detection).
// ============================================================================

pub fn get_kain_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "pub fn ",     kind: "function" })
    push(patterns, PubPattern{ prefix: "pub struct ", kind: "struct" })
    push(patterns, PubPattern{ prefix: "pub actor ",  kind: "actor" })
    push(patterns, PubPattern{ prefix: "pub world ",  kind: "world" })
    push(patterns, PubPattern{ prefix: "pub enum ",   kind: "enum" })
    push(patterns, PubPattern{ prefix: "pub trait ",  kind: "trait" })
    push(patterns, PubPattern{ prefix: "pub macro ",  kind: "macro" })
    push(patterns, PubPattern{ prefix: "pub const ",  kind: "const" })
    push(patterns, PubPattern{ prefix: "pub type ",   kind: "type" })
    push(patterns, PubPattern{ prefix: "pub mod ",    kind: "module" })
    push(patterns, PubPattern{ prefix: "pub surface ",kind: "surface" })
    return patterns

pub fn get_rust_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "pub fn ",         kind: "function" })
    push(patterns, PubPattern{ prefix: "pub struct ",     kind: "struct" })
    push(patterns, PubPattern{ prefix: "pub enum ",       kind: "enum" })
    push(patterns, PubPattern{ prefix: "pub trait ",      kind: "trait" })
    push(patterns, PubPattern{ prefix: "pub mod ",        kind: "module" })
    push(patterns, PubPattern{ prefix: "pub type ",       kind: "type" })
    push(patterns, PubPattern{ prefix: "pub const ",      kind: "const" })
    push(patterns, PubPattern{ prefix: "pub static ",     kind: "const" })
    push(patterns, PubPattern{ prefix: "pub unsafe fn ",  kind: "function" })
    push(patterns, PubPattern{ prefix: "pub async fn ",   kind: "function" })
    push(patterns, PubPattern{ prefix: "pub(crate) fn ",  kind: "function" })
    push(patterns, PubPattern{ prefix: "pub(crate) struct ",  kind: "struct" })
    push(patterns, PubPattern{ prefix: "pub(crate) enum ",    kind: "enum" })
    push(patterns, PubPattern{ prefix: "pub(crate) trait ",   kind: "trait" })
    return patterns

pub fn get_typescript_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "export function ",       kind: "function" })
    push(patterns, PubPattern{ prefix: "export class ",          kind: "class" })
    push(patterns, PubPattern{ prefix: "export interface ",      kind: "interface" })
    push(patterns, PubPattern{ prefix: "export type ",           kind: "type" })
    push(patterns, PubPattern{ prefix: "export const ",          kind: "const" })
    push(patterns, PubPattern{ prefix: "export enum ",           kind: "enum" })
    push(patterns, PubPattern{ prefix: "export default ",        kind: "default" })
    push(patterns, PubPattern{ prefix: "export abstract class ", kind: "class" })
    push(patterns, PubPattern{ prefix: "export namespace ",      kind: "module" })
    push(patterns, PubPattern{ prefix: "export module ",         kind: "module" })
    push(patterns, PubPattern{ prefix: "export async function ", kind: "function" })
    push(patterns, PubPattern{ prefix: "export abstract ",       kind: "default" })
    return patterns

pub fn get_javascript_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "export function ", kind: "function" })
    push(patterns, PubPattern{ prefix: "export class ",    kind: "class" })
    push(patterns, PubPattern{ prefix: "export const ",    kind: "const" })
    push(patterns, PubPattern{ prefix: "export default ",  kind: "default" })
    push(patterns, PubPattern{ prefix: "module.exports ",  kind: "export" })
    push(patterns, PubPattern{ prefix: "exports.",         kind: "export" })
    push(patterns, PubPattern{ prefix: "async function ",  kind: "function" })
    push(patterns, PubPattern{ prefix: "function ",        kind: "function" })
    push(patterns, PubPattern{ prefix: "class ",           kind: "class" })
    return patterns

pub fn get_python_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "def ",        kind: "function" })
    push(patterns, PubPattern{ prefix: "class ",      kind: "class" })
    push(patterns, PubPattern{ prefix: "async def ",  kind: "function" })
    return patterns

pub fn get_c_patterns() -> Array<PubPattern>:
    // C headers use non-static functions — detection from source alone is
    // unreliable. Return empty; external API scanners should use .h analysis.
    let patterns: Array<PubPattern> = []
    return patterns

pub fn get_cpp_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "class ",        kind: "class" })
    push(patterns, PubPattern{ prefix: "struct ",       kind: "struct" })
    push(patterns, PubPattern{ prefix: "enum class ",   kind: "enum" })
    push(patterns, PubPattern{ prefix: "enum struct ",  kind: "enum" })
    push(patterns, PubPattern{ prefix: "template<",     kind: "template" })
    push(patterns, PubPattern{ prefix: "public:",       kind: "section" })
    push(patterns, PubPattern{ prefix: "virtual ",      kind: "method" })
    push(patterns, PubPattern{ prefix: "constexpr ",    kind: "const" })
    return patterns

pub fn get_go_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "func ",   kind: "function" })
    push(patterns, PubPattern{ prefix: "type ",   kind: "type" })
    push(patterns, PubPattern{ prefix: "const (", kind: "const" })
    push(patterns, PubPattern{ prefix: "var (",   kind: "const" })
    return patterns

pub fn get_java_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "public class ",      kind: "class" })
    push(patterns, PubPattern{ prefix: "public interface ",  kind: "interface" })
    push(patterns, PubPattern{ prefix: "public enum ",       kind: "enum" })
    push(patterns, PubPattern{ prefix: "public abstract class ", kind: "class" })
    push(patterns, PubPattern{ prefix: "public final class ",    kind: "class" })
    push(patterns, PubPattern{ prefix: "public static ",    kind: "method" })
    push(patterns, PubPattern{ prefix: "public void ",      kind: "method" })
    return patterns

pub fn get_kotlin_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "fun ",            kind: "function" })
    push(patterns, PubPattern{ prefix: "class ",          kind: "class" })
    push(patterns, PubPattern{ prefix: "interface ",      kind: "interface" })
    push(patterns, PubPattern{ prefix: "object ",         kind: "class" })
    push(patterns, PubPattern{ prefix: "data class ",     kind: "class" })
    push(patterns, PubPattern{ prefix: "enum class ",     kind: "enum" })
    push(patterns, PubPattern{ prefix: "sealed class ",   kind: "class" })
    push(patterns, PubPattern{ prefix: "val ",            kind: "const" })
    push(patterns, PubPattern{ prefix: "var ",            kind: "const" })
    return patterns

pub fn get_scala_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "def ",            kind: "function" })
    push(patterns, PubPattern{ prefix: "class ",          kind: "class" })
    push(patterns, PubPattern{ prefix: "object ",         kind: "class" })
    push(patterns, PubPattern{ prefix: "trait ",          kind: "trait" })
    push(patterns, PubPattern{ prefix: "case class ",     kind: "class" })
    push(patterns, PubPattern{ prefix: "enum ",           kind: "enum" })
    return patterns

pub fn get_swift_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "func ",           kind: "function" })
    push(patterns, PubPattern{ prefix: "class ",          kind: "class" })
    push(patterns, PubPattern{ prefix: "struct ",         kind: "struct" })
    push(patterns, PubPattern{ prefix: "enum ",           kind: "enum" })
    push(patterns, PubPattern{ prefix: "protocol ",       kind: "interface" })
    push(patterns, PubPattern{ prefix: "extension ",      kind: "extension" })
    return patterns

pub fn get_ruby_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "def ",            kind: "function" })
    push(patterns, PubPattern{ prefix: "class ",          kind: "class" })
    push(patterns, PubPattern{ prefix: "module ",         kind: "module" })
    push(patterns, PubPattern{ prefix: "attr_",           kind: "method" })
    return patterns

pub fn get_php_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "function ",       kind: "function" })
    push(patterns, PubPattern{ prefix: "class ",          kind: "class" })
    push(patterns, PubPattern{ prefix: "interface ",      kind: "interface" })
    push(patterns, PubPattern{ prefix: "trait ",          kind: "trait" })
    push(patterns, PubPattern{ prefix: "const ",          kind: "const" })
    return patterns

pub fn get_csharp_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "public class ",       kind: "class" })
    push(patterns, PubPattern{ prefix: "public interface ",   kind: "interface" })
    push(patterns, PubPattern{ prefix: "public enum ",        kind: "enum" })
    push(patterns, PubPattern{ prefix: "public struct ",      kind: "struct" })
    push(patterns, PubPattern{ prefix: "public record ",      kind: "class" })
    push(patterns, PubPattern{ prefix: "public delegate ",    kind: "type" })
    push(patterns, PubPattern{ prefix: "public static ",      kind: "method" })
    return patterns

pub fn get_dart_patterns() -> Array<PubPattern>:
    let patterns = []
    push(patterns, PubPattern{ prefix: "class ",         kind: "class" })
    push(patterns, PubPattern{ prefix: "enum ",          kind: "enum" })
    push(patterns, PubPattern{ prefix: "mixin ",         kind: "class" })
    push(patterns, PubPattern{ prefix: "typedef ",       kind: "type" })
    push(patterns, PubPattern{ prefix: "extension ",     kind: "extension" })
    return patterns

// ============================================================================
//  get_pub_patterns — Main dispatch: language → pub symbol patterns
//
//  Returns the pub detection patterns for a given language name (lowercase).
//  Returns empty array for languages without pattern support.
// ============================================================================

pub fn get_pub_patterns(language: String) -> Array<PubPattern>:
    let lang = to_lower(language)
    if lang == "kain":        return get_kain_patterns()
    if lang == "rust":        return get_rust_patterns()
    if lang == "typescript":  return get_typescript_patterns()
    if lang == "javascript":  return get_javascript_patterns()
    if lang == "python":      return get_python_patterns()
    if lang == "c":           return get_c_patterns()
    if lang == "cpp":         return get_cpp_patterns()
    if lang == "go":          return get_go_patterns()
    if lang == "java":        return get_java_patterns()
    if lang == "kotlin":      return get_kotlin_patterns()
    if lang == "scala":       return get_scala_patterns()
    if lang == "swift":       return get_swift_patterns()
    if lang == "ruby":        return get_ruby_patterns()
    if lang == "php":         return get_php_patterns()
    if lang == "csharp":      return get_csharp_patterns()
    if lang == "dart":        return get_dart_patterns()
    // Default: no known patterns
    let empty: Array<PubPattern> = []
    return empty

// ============================================================================
//  Import detection: language → known import keyword prefixes
// ============================================================================

pub fn get_import_patterns(language: String) -> Array<String>:
    let lang = to_lower(language)
    if lang == "kain":
        return ["use ", "include ", "import "]
    if lang == "rust":
        return ["use ", "extern crate "]
    if lang == "typescript" or lang == "javascript":
        return ["import ", "require(", "import type ", "import {"]
    if lang == "python":
        return ["import ", "from "]
    if lang == "c" or lang == "cpp":
        return ["#include ", "#import "]
    if lang == "go":
        return ["import ", "import ("]
    if lang == "java" or lang == "kotlin" or lang == "scala":
        return ["import "]
    if lang == "swift":
        return ["import "]
    if lang == "ruby":
        return ["require ", "require_relative ", "load "]
    if lang == "php":
        return ["use ", "require ", "include ", "require_once ", "include_once "]
    if lang == "csharp":
        return ["using ", "using static "]
    let empty: Array<String> = []
    return empty
