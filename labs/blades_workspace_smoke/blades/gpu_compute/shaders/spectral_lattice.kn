shader compute BladeSpectralLattice(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [32, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("blade_spectral_lattice", "lattice_interleave", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let sample = src[index]
    let lane = sample * sample * 0.0625 + 0.125
    let fold = sample * 0.4 + lane * (1.0 - sample * 0.1)
    let beam = fold + sample * 0.2
    dst[index] = beam
    return vec4(beam * 0.8, 0.25 + fold * 0.5, sample * 0.35 + 0.5, 1.0)
