shader compute BladeNebulaForge(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [16, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("blade_nebula_forge", "spectral_fold", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let sample = src[index]
    let phase = sample * 0.75 + sample * sample * 0.03125
    let dust = phase * (1.0 - sample * 0.2)
    let flare = sample * sample + 0.125
    let signal = dust * 0.55 + flare * 0.45
    dst[index] = signal
    return vec4(signal, flare * 0.7, 1.0 - dust * 0.25, 1.0)
