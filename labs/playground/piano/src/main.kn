use c::piano_audio

fn piano_cache_dir() -> String:
    return "native/piano_cache"

fn piano_sample_rate() -> Int:
    return 48000

fn bool_text(flag: Bool) -> String:
    if flag:
        return "yes"
    return "no"

fn piano_boot_status_text() -> String:
    return f"audio=offline|reason=boot-pending|error=none|sample_rate={piano_sample_rate()}|recording=no|loop_playing=no|notes=0|loop_ms=0|cache={piano_cache_dir()}"

fn boot_audio() -> Bool:
    return piano_audio_init(piano_cache_dir(), piano_sample_rate()) == 1

world PianoLab:
    state audio_ready: Bool = false
    state audio_status: String = piano_boot_status_text()
    state status_line: String = "Ready the keyboard. Audio boots on first touch."
    state detail_line: String = "Kain owns the surface; C owns the sound."
    state loop_line: String = "loop notes: 0 | loop ms: 0 | audio ready: no"
    state last_note: String = "none"
    state note_count: Int = 0
    state recording: Bool = false
    state loop_playing: Bool = false
    state loop_note_count: Int = 0
    state loop_duration_ms: Int = 0
    state action_total: Int = 0
    state action_log: Array<String> = []
    surface native_ui => App

patch sync_view(piano: PianoLab, reason: String) -> String:
    piano.audio_status = piano_audio_status(())
    piano.status_line = f"{reason} | {piano.audio_status}"
    piano.detail_line = f"last note: {piano.last_note} | taps: {piano.note_count} | actions: {piano.action_total} | recording: {bool_text(piano.recording)} | loop playing: {bool_text(piano.loop_playing)}"
    piano.loop_line = f"loop notes: {piano.loop_note_count} | loop ms: {piano.loop_duration_ms} | audio ready: {bool_text(piano.audio_ready)}"
    return piano.status_line

patch log_action(piano: PianoLab, message: String) -> Int:
    piano.action_total = piano.action_total + 1
    piano.action_log.push(f"{piano.action_total}. {message}")
    return piano.action_total

patch ensure_audio(piano: PianoLab) -> Bool:
    if !piano.audio_ready:
        piano.audio_ready = boot_audio()
    piano.audio_status = piano_audio_status(())
    if piano.audio_ready:
        return true
    sync_view(piano, "Audio engine unavailable")
    return false

patch play_key(piano: PianoLab, label: String, midi_note: Int) -> Int:
    if !ensure_audio(piano):
        log_action(piano, f"audio boot failed for {label}")
        sync_view(piano, "Audio engine unavailable")
        return piano.note_count

    if piano_audio_note_on(midi_note) == 1:
        piano.last_note = label
        piano.note_count = piano.note_count + 1
        log_action(piano, f"tap {label}")
        sync_view(piano, f"Played {label}")
    else:
        log_action(piano, f"failed {label}")
        sync_view(piano, f"Audio call failed for {label}")
    return piano.note_count

patch start_recording(piano: PianoLab) -> Bool:
    if !ensure_audio(piano):
        log_action(piano, "record boot failed")
        sync_view(piano, "Audio engine unavailable")
        return false

    if piano_audio_start_recording(()) == 1:
        piano.recording = true
        piano.loop_playing = false
        piano.loop_note_count = 0
        piano.loop_duration_ms = 0
        log_action(piano, "record armed")
        sync_view(piano, "Recording loop")
        return true

    log_action(piano, "record arm failed")
    sync_view(piano, "Unable to arm loop recording")
    return false

patch stop_recording(piano: PianoLab) -> Int:
    if !ensure_audio(piano):
        log_action(piano, "record stop failed")
        sync_view(piano, "Audio engine unavailable")
        return 0

    let captured: Int = piano_audio_stop_recording(())
    piano.recording = false
    piano.loop_playing = false
    piano.loop_note_count = captured
    piano.loop_duration_ms = piano_audio_loop_duration_ms(())
    log_action(piano, f"record stopped with {captured} notes")
    sync_view(piano, "Loop captured")
    return captured

patch start_loop(piano: PianoLab) -> Bool:
    if !ensure_audio(piano):
        log_action(piano, "loop boot failed")
        sync_view(piano, "Audio engine unavailable")
        return false

    if piano_audio_start_loop_playback(()) == 1:
        piano.loop_playing = true
        piano.recording = false
        log_action(piano, "loop playing")
        sync_view(piano, "Loop cycling")
        return true

    piano.loop_playing = false
    log_action(piano, "loop unavailable")
    sync_view(piano, "No captured loop yet")
    return false

patch stop_loop(piano: PianoLab) -> Bool:
    if !ensure_audio(piano):
        log_action(piano, "loop stop boot failed")
        sync_view(piano, "Audio engine unavailable")
        return false

    piano_audio_stop_loop_playback(())
    piano.loop_playing = false
    log_action(piano, "loop stopped")
    sync_view(piano, "Loop stopped")
    return true

patch clear_loop(piano: PianoLab) -> Bool:
    if !ensure_audio(piano):
        log_action(piano, "clear boot failed")
        sync_view(piano, "Audio engine unavailable")
        return false

    piano_audio_clear_loop(())
    piano.recording = false
    piano.loop_playing = false
    piano.loop_note_count = 0
    piano.loop_duration_ms = 0
    log_action(piano, "loop cleared")
    sync_view(piano, "Loop cleared")
    return true

fn handle_record_loop():
    start_recording(PianoLab)

fn handle_stop_recording():
    stop_recording(PianoLab)

fn handle_play_loop():
    start_loop(PianoLab)

fn handle_stop_loop():
    stop_loop(PianoLab)

fn handle_clear_loop():
    clear_loop(PianoLab)

fn handle_c4():
    play_key(PianoLab, "C4", 60)

fn handle_d4():
    play_key(PianoLab, "D4", 62)

fn handle_e4():
    play_key(PianoLab, "E4", 64)

fn handle_f4():
    play_key(PianoLab, "F4", 65)

fn handle_g4():
    play_key(PianoLab, "G4", 67)

fn handle_a4():
    play_key(PianoLab, "A4", 69)

fn handle_b4():
    play_key(PianoLab, "B4", 71)

fn handle_c5():
    play_key(PianoLab, "C5", 72)

fn handle_csharp4():
    play_key(PianoLab, "C#4", 61)

fn handle_dsharp4():
    play_key(PianoLab, "D#4", 63)

fn handle_fsharp4():
    play_key(PianoLab, "F#4", 66)

fn handle_gsharp4():
    play_key(PianoLab, "G#4", 68)

fn handle_asharp4():
    play_key(PianoLab, "A#4", 70)

component App():
    render <slot>
        <theme name="piano_lab">
            <scope name="piano_lab" selector="piano-lab" />
            <token name="theme.background.top" category="color" value="#120d0b" />
            <token name="theme.background.bottom" category="color" value="#261c16" />
            <token name="theme.surface.base" category="color" value="#191311" />
            <token name="theme.surface.alt" category="color" value="#281d18" />
            <token name="theme.surface.overlay" category="color" value="#241912d8" />
            <token name="theme.accent.primary" category="color" value="#cc9651" />
            <token name="theme.accent.soft" category="color" value="#f1d49a" />
            <token name="theme.highlight" category="color" value="#fff0c2" />
            <token name="theme.text.default" category="color" value="#fff8ed" />
            <token name="theme.text.muted" category="color" value="#d4c2ae" />
            <token name="theme.typography.scale" category="type" value={1.04} />
            <token name="theme.spacing.scale" category="space" value={1.0} />
            <token name="theme.radius.scale" category="radius" value={1.12} />
            <token name="widget.panel.surface.mode" category="surface" value="glass" />
            <token name="widget.inspector.surface.mode" category="surface" value="flat" />
            <token name="widget.tree.surface.mode" category="surface" value="ghost" />
            <token name="widget.timeline.surface.mode" category="surface" value="accent" />
            <token name="widget.element.surface.mode" category="surface" value="flat" />
            <variant scope="piano_lab" name="shell">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="piano_lab" name="hero">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={18} />
            </variant>
            <variant scope="piano_lab" name="stage">
                <token name="surface.mode" category="surface" value="layered" />
                <token name="surface.padding" category="space" value={14} />
            </variant>
            <variant scope="piano_lab" name="transport">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={12} />
            </variant>
            <variant scope="piano_lab" name="ledger">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={10} />
            </variant>
            <variant scope="piano_lab" name="meter">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={10} />
            </variant>
            <widget kind="element" scope="piano_lab" variant="transport_button">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.fill" category="color" value="#2a1f1a" />
                <token name="surface.stroke" category="color" value="#b78149" />
                <token name="surface.radius" category="surface" value={16} />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.color" category="color" value="#fff8ed" />
                <token name="text.color" category="color" value="#fff8ed" />
                <token name="accent.color" category="color" value="#f2c46b" />
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="element" scope="piano_lab" variant="white_key">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.fill" category="color" value="#f7efe3" />
                <token name="surface.stroke" category="color" value="#c4b097" />
                <token name="surface.radius" category="surface" value={14} />
                <token name="surface.padding" category="space" value={12} />
                <token name="title.color" category="color" value="#181411" />
                <token name="text.color" category="color" value="#181411" />
                <token name="accent.color" category="color" value="#aa7d43" />
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="element" scope="piano_lab" variant="black_key">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.fill" category="color" value="#1a1210" />
                <token name="surface.stroke" category="color" value="#4a372f" />
                <token name="surface.radius" category="surface" value={12} />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.color" category="color" value="#f7efdf" />
                <token name="text.color" category="color" value="#f7efdf" />
                <token name="accent.color" category="color" value="#d69b4e" />
                <token name="density" category="layout" value="compact" />
            </widget>
            <textvariant scope="piano_lab" name="hero">
                <token name="body.size" category="type" value={30} />
            </textvariant>
            <textvariant scope="piano_lab" name="metric">
                <token name="body.size" category="type" value={24} />
            </textvariant>
        </theme>
        <panel title="Kain Piano Lab" scope="piano_lab" variant="shell" class="dense accent" layout="dock" persistent_layout_id="piano_lab_shell" gap={16} padding={16}>
            <panel title="Control Rail" dock="left" scope="piano_lab" variant="transport" split_ratio={0.26} min_width={260} max_width={360} resizable={true} layout="column" gap={12}>
                <panel title="Now Playing" scope="piano_lab" variant="hero" layout="column" gap={8}>
                    <text role="eyebrow">KAIN PIANO / LLVM NATIVE</text>
                    <text role="hero" variant="hero">The UI is authored in Kain, the binary is linked through LLVM, and the audio bridge stays in C.</text>
                    <text role="body">This surface is a real instrument lane, not a smoke-test shell. Press the keys, capture a loop, and let the runtime replay it.</text>
                </panel>
                <panel title="Transport" scope="piano_lab" variant="transport" layout="column" gap={8}>
                    <panel title="Audio Ready" scope="piano_lab" variant="meter" layout="column" gap={2}>
                        <text role="metric">{bool_text(PianoLab.audio_ready)}</text>
                        <text role="caption">audio ready</text>
                    </panel>
                    <button variant="transport_button" onclick={handle_record_loop}>Record Loop</button>
                    <button variant="transport_button" onclick={handle_stop_recording}>Stop Recording</button>
                    <button variant="transport_button" onclick={handle_play_loop}>Play Loop</button>
                    <button variant="transport_button" onclick={handle_stop_loop}>Stop Loop</button>
                    <button variant="transport_button" onclick={handle_clear_loop}>Clear Loop</button>
                </panel>
                <panel title="Loop State" scope="piano_lab" variant="ledger" layout="column" gap={4}>
                    <text role="title">{PianoLab.status_line}</text>
                    <text role="caption">{PianoLab.audio_status}</text>
                    <text role="caption">{PianoLab.detail_line}</text>
                    <text role="caption">{PianoLab.loop_line}</text>
                </panel>
            </panel>
            <panel title="Keyboard Stage" dock="center" scope="piano_lab" variant="stage" layout="column" gap={14}>
                <panel title="Stage Header" scope="piano_lab" variant="hero" layout="row" gap={12}>
                    <panel title="Lead" scope="piano_lab" variant="hero" layout="column" gap={6}>
                        <text role="eyebrow">ONE OCTAVE, REAL AUDIO, KAIN SEMANTICS</text>
                        <text role="hero" variant="hero">A 2D instrument surface driven entirely by the language.</text>
                        <text role="body">White and black keys are separately themed semantic buttons. The loop recorder and replay logic live in the same Kain world model.</text>
                    </panel>
                    <panel title="Meters" scope="piano_lab" variant="meter" layout="row" gap={10}>
                        <panel title="Last Note" scope="piano_lab" variant="meter" layout="column" gap={2}>
                            <text role="metric">{PianoLab.last_note}</text>
                            <text role="caption">last note</text>
                        </panel>
                        <panel title="Tap Count" scope="piano_lab" variant="meter" layout="column" gap={2}>
                            <text role="metric">{PianoLab.note_count}</text>
                            <text role="caption">notes hit</text>
                        </panel>
                        <panel title="Loop Length" scope="piano_lab" variant="meter" layout="column" gap={2}>
                            <text role="metric">{PianoLab.loop_duration_ms}</text>
                            <text role="caption">loop ms</text>
                        </panel>
                    </panel>
                </panel>
                <panel title="Accidentals" scope="piano_lab" variant="stage" layout="grid" columns={5} gap={8}>
                    <button variant="black_key" onclick={handle_csharp4}>Csharp4</button>
                    <button variant="black_key" onclick={handle_dsharp4}>Dsharp4</button>
                    <button variant="black_key" onclick={handle_fsharp4}>Fsharp4</button>
                    <button variant="black_key" onclick={handle_gsharp4}>Gsharp4</button>
                    <button variant="black_key" onclick={handle_asharp4}>Asharp4</button>
                </panel>
                <panel title="Naturals" scope="piano_lab" variant="stage" layout="grid" columns={8} gap={8}>
                    <button variant="white_key" onclick={handle_c4}>C4</button>
                    <button variant="white_key" onclick={handle_d4}>D4</button>
                    <button variant="white_key" onclick={handle_e4}>E4</button>
                    <button variant="white_key" onclick={handle_f4}>F4</button>
                    <button variant="white_key" onclick={handle_g4}>G4</button>
                    <button variant="white_key" onclick={handle_a4}>A4</button>
                    <button variant="white_key" onclick={handle_b4}>B4</button>
                    <button variant="white_key" onclick={handle_c5}>C5</button>
                </panel>
                <panel title="Loop Cue" scope="piano_lab" variant="ledger" layout="column" gap={4}>
                    <text role="caption">Capture a phrase, stop recording, and use Play Loop to keep the phrase cycling.</text>
                    <text role="caption">The runtime keeps the loop buffer in C while Kain keeps the UI and transport flow coherent.</text>
                </panel>
            </panel>
            <panel title="Performance Tape" dock="right" scope="piano_lab" variant="ledger" split_ratio={0.25} min_width={280} max_width={380} resizable={true} layout="column" gap={12}>
                <inspector title="State" scope="piano_lab" variant="ledger">
                    <text role="caption">audio ready</text>
                    <text role="metric">{bool_text(PianoLab.audio_ready)}</text>
                    <text role="caption">recording</text>
                    <text role="metric">{bool_text(PianoLab.recording)}</text>
                    <text role="caption">loop playing</text>
                    <text role="metric">{bool_text(PianoLab.loop_playing)}</text>
                    <text role="caption">captured notes</text>
                    <text role="metric">{PianoLab.loop_note_count}</text>
                </inspector>
                <tree title="Action Log" scope="piano_lab" variant="ledger">
                    <text role="caption">Loop actions appear here in order.</text>
                    {for entry in PianoLab.action_log: <text role="caption">{entry}</text>}
                </tree>
            </panel>
            <panel title="Loop Timeline" dock="bottom" scope="piano_lab" variant="ledger" split_ratio={0.20} min_height={180} max_height={280} resizable={true} layout="row" gap={12}>
                <timeline title="Capture Timeline" scope="piano_lab">
                    <text role="caption">Record Loop, Stop Recording, and Play Loop are the transport phases. The C runtime handles the ring buffer. Kain owns the UI and transport flow.</text>
                </timeline>
                <inspector title="Playback Notes" scope="piano_lab" variant="ledger" layout="column" gap={4}>
                    <text role="caption">{PianoLab.status_line}</text>
                    <text role="caption">{PianoLab.detail_line}</text>
                    <text role="caption">{PianoLab.loop_line}</text>
                </inspector>
            </panel>
        </panel>
    </slot>
