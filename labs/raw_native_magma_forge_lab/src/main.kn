fn lab_path(name: String) -> String:
    return "M:/Code/Kain/labs/raw_native_magma_forge_lab/" + name

fn terraced_ring_count(seed: Int) -> Int:
    let rings = 5 + (seed % 3)
    if rings < 5:
        return 5
    elif rings > 8:
        return 8
    else:
        return rings

fn magma_particle_budget(rings: Int, vent_count: Int, shard_count: Int) -> Int:
    let total = 96 + (rings * 18) + (vent_count * 6) + (shard_count * 5)
    if total < 180:
        return 180
    elif total > 320:
        return 320
    else:
        return total

fn magma_motion_score(terrace_radius: Float, move_speed: Float, jump_velocity: Float) -> Int:
    let ring_steps = floor(terrace_radius / 3.5)
    let sprint_steps = ceil(move_speed * 1.7)
    let jump_steps = round(jump_velocity * 2.2)
    let arc_energy = round(sqrt(196.0) + pow(2.0, 4.0))
    let wave_bias = round((sin(0.65) + cos(1.10) + tan(0.20)) * 12.0)
    return ring_steps + sprint_steps + jump_steps + arc_energy + wave_bias

fn build_forge_report(profile: String, terrace_count: Int, particle_count: Int, motion_score: Int, vent_count: Int, shard_count: Int) -> String:
    let report = "KAIN RAW NATIVE GENERIC VIEWPORT LAB REPORT\n"
    report = report + "profile=" + profile + "\n"
    report = report + "terrace_count=" + to_string(terrace_count) + "\n"
    report = report + "particle_count=" + to_string(particle_count) + "\n"
    report = report + "motion_score=" + to_string(motion_score) + "\n"
    report = report + "vent_count=" + to_string(vent_count) + "\n"
    report = report + "shard_count=" + to_string(shard_count) + "\n"
    report = report + "features=math,float_math,arrays,maps,file_io,native_config,standalone_exe,raw_native_3d\n"
    return report

fn configure_magma_forge() -> Int:
    let profile = "default_viewport"
    let terrace_radius = 26.0
    let rings = terraced_ring_count(14)
    let vent_count = 12
    let shard_count = 7
    let move_speed = 10.2
    let sprint_multiplier = 2.35
    let jump_velocity = 7.1
    let fog_density = 0.030
    let particle_count = magma_particle_budget(rings, vent_count, shard_count)
    let motion_score = magma_motion_score(terrace_radius, move_speed, jump_velocity)
    let window_width = 1728
    let window_height = 972

    let scene_metrics = map_new()
    map_set(scene_metrics, "rings", rings)
    map_set(scene_metrics, "vents", vent_count)
    map_set(scene_metrics, "shards", shard_count)
    map_set(scene_metrics, "particles", particle_count)

    let terrace_sizes = [
        26,
        22,
        18,
        14,
        10
    ]
    push(terrace_sizes, 8)
    let last_ring = pop(terrace_sizes)
    push(terrace_sizes, last_ring)

    let terrace_score = 0
    for i in range(0, len(terrace_sizes)):
        terrace_score = terrace_score + terrace_sizes[i]

    let report = build_forge_report(
        profile,
        map_get(scene_metrics, "rings"),
        map_get(scene_metrics, "particles"),
        motion_score + terrace_score,
        map_get(scene_metrics, "vents"),
        map_get(scene_metrics, "shards")
    )
    write_file(lab_path("magma_forge_report.txt"), report)

    native_config_string("KAIN_NATIVE_SCENE_PROFILE", profile)
    native_config_string("KAIN_NATIVE_WORLD_ASSET", "")
    native_config_float("KAIN_NATIVE_MOVE_SPEED", move_speed)
    native_config_float("KAIN_NATIVE_SPRINT_MULTIPLIER", sprint_multiplier)
    native_config_float("KAIN_NATIVE_JUMP_VELOCITY", jump_velocity)
    native_config_float("KAIN_NATIVE_FOG_DENSITY", fog_density)
    native_config_int("KAIN_NATIVE_PARTICLE_COUNT", particle_count)
    native_config_int("KAIN_NATIVE_WINDOW_WIDTH", window_width)
    native_config_int("KAIN_NATIVE_WINDOW_HEIGHT", window_height)
    native_config_flag("KAIN_NATIVE_SHOW_HELP", 1)
    native_config_flag("KAIN_NATIVE_CAPTURE_MOUSE", 1)
    return motion_score + terrace_score + particle_count

fn main() -> Int:
    println("Kain is driving the raw native generic viewport lab.")
    let launch_score = configure_magma_forge()
    println(launch_score)
    spawn_native_viewport(0.0, 0.0)
    return launch_score
