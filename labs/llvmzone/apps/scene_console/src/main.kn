world SceneConsole:
    state sample_count: Int = 14
    state layer_count: Int = 5
    state focus_count: Int = 3
    state score: Int = 0
    surface native_ui => App
    surface viewport3d => "magma_terraces"

component App():
    render <panel title="Scene Console">
        <text>{"Scene Console"}</text>
        <viewport3d title="Magma Terrace" scene="magma_terraces" />
    </panel>

fn clamp_int(value: Int, floor: Int, ceiling: Int) -> Int:
    if value < floor:
        return floor
    else:
        if value > ceiling:
            return ceiling
    return value

fn scene_score(samples: Int, layers: Int, focus: Int) -> Int:
    return samples + layers + focus + (samples + layers) + (layers + focus)

patch refresh_console(console: SceneConsole) -> Int:
    console.score = scene_score(console.sample_count, console.layer_count, console.focus_count)
    return console.score

fn main() -> Int:
    let console = SceneConsole
    let score = refresh_console(console)
    return clamp_int(score, 0, 99)
