actor MailHub:
    state received: Int = 0
    state routed: Int = 0
    state sealed: Int = 0

    on Intake():
        self.received = self.received + 1

    on Route():
        self.routed = self.routed + 1

    on Seal():
        self.sealed = self.sealed + 1

fn mail_score(weight: Int, lane: Int, seal: Int) -> Int:
    return weight + lane + seal + (weight + lane) + (lane + seal)

fn main() -> Int:
    let hub = spawn MailHub()
    send hub.Intake()
    send hub.Route()
    send hub.Seal()

    let score = mail_score(7, 2, 3)
    return score
