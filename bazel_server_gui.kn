use std::process
use std::python
use std::runtime

import ctypes as py_ctypes
import os as py_os
import pathlib as py_pathlib
import subprocess as py_subprocess
import sys as py_sys
import tkinter as tk
import tkinter.ttk as ttk

// ============================================================================
//                         bazel server control panel
// ============================================================================
// Kain owns the executable and launch policy. Python owns the native Tk widgets
// and Windows process probes because that is the platform surface we need here.

fn bazel_gui_bootstrap_code() -> String:
    var code = ""
    code = code + "import ctypes\n"
    code = code + "import os\n"
    code = code + "import pathlib\n"
    code = code + "import subprocess\n"
    code = code + "import sys\n"
    code = code + "import threading\n"
    code = code + "import time\n"
    code = code + "import tkinter as tk\n"
    code = code + "from tkinter import ttk\n"
    code = code + "\n"
    code = code + "PROCESS_QUERY_LIMITED_INFORMATION = 0x1000\n"
    code = code + "STILL_ACTIVE = 259\n"
    code = code + "\n"
    code = code + "def __kain_bazel_gui_repo_root(exe_path, cwd):\n"
    code = code + "    candidates = []\n"
    code = code + "    env_root = os.environ.get('KAIN_REPO_ROOT')\n"
    code = code + "    if env_root:\n"
    code = code + "        candidates.append(pathlib.Path(env_root))\n"
    code = code + "    if exe_path:\n"
    code = code + "        candidates.append(pathlib.Path(exe_path).resolve().parent)\n"
    code = code + "    if cwd:\n"
    code = code + "        candidates.append(pathlib.Path(cwd))\n"
    code = code + "    for root in candidates:\n"
    code = code + "        try:\n"
    code = code + "            root = root.resolve()\n"
    code = code + "        except Exception:\n"
    code = code + "            continue\n"
    code = code + "        if (root / 'MODULE.bazel').exists() or (root / '.git').exists():\n"
    code = code + "            return root\n"
    code = code + "    return pathlib.Path('X:/').resolve()\n"
    code = code + "\n"
    code = code + "def __kain_bazel_gui_command():\n"
    code = code + "    override = os.environ.get('KAIN_BAZEL_COMMAND', '').strip()\n"
    code = code + "    if override:\n"
    code = code + "        return override\n"
    code = code + "    for name in ('bazel', 'bazelisk'):\n"
    code = code + "        resolved = shutil_which(name)\n"
    code = code + "        if resolved:\n"
    code = code + "            return resolved\n"
    code = code + "    return 'bazel'\n"
    code = code + "\n"
    code = code + "def shutil_which(name):\n"
    code = code + "    for entry in os.environ.get('PATH', '').split(os.pathsep):\n"
    code = code + "        if not entry:\n"
    code = code + "            continue\n"
    code = code + "        for suffix in ('', '.exe', '.cmd', '.bat'):\n"
    code = code + "            candidate = pathlib.Path(entry) / (name + suffix)\n"
    code = code + "            if candidate.exists():\n"
    code = code + "                return str(candidate)\n"
    code = code + "    return ''\n"
    code = code + "\n"
    code = code + "def __kain_bazel_output_user_root(repo_root):\n"
    code = code + "    rc = repo_root / '.bazelrc'\n"
    code = code + "    try:\n"
    code = code + "        for line in rc.read_text(encoding='utf-8').splitlines():\n"
    code = code + "            line = line.strip()\n"
    code = code + "            if line.startswith('startup --output_user_root='):\n"
    code = code + "                return pathlib.Path(line.split('=', 1)[1]).resolve()\n"
    code = code + "    except Exception:\n"
    code = code + "        pass\n"
    code = code + "    return pathlib.Path('F:/_b/output-user-root').resolve()\n"
    code = code + "\n"
    code = code + "def __kain_bazel_output_base(repo_root, bazel_cmd, start_server=False):\n"
    code = code + "    override = os.environ.get('KAIN_BAZEL_OUTPUT_BASE', '').strip()\n"
    code = code + "    if override:\n"
    code = code + "        return pathlib.Path(override).resolve()\n"
    code = code + "    if start_server:\n"
    code = code + "        completed = subprocess.run([bazel_cmd, 'info', 'output_base', '--config=dev'], cwd=str(repo_root), text=True, capture_output=True, check=False)\n"
    code = code + "        for line in completed.stdout.splitlines():\n"
    code = code + "            line = line.strip()\n"
    code = code + "            if line:\n"
    code = code + "                return pathlib.Path(line).resolve()\n"
    code = code + "    output_user_root = __kain_bazel_output_user_root(repo_root)\n"
    code = code + "    candidates = []\n"
    code = code + "    try:\n"
    code = code + "        for child in output_user_root.iterdir():\n"
    code = code + "            if (child / 'execroot' / '_main').exists() or (child / 'server' / 'server.pid.txt').exists():\n"
    code = code + "                try:\n"
    code = code + "                    candidates.append((child.stat().st_mtime, child))\n"
    code = code + "                except Exception:\n"
    code = code + "                    candidates.append((0, child))\n"
    code = code + "    except Exception:\n"
    code = code + "        pass\n"
    code = code + "    if candidates:\n"
    code = code + "        candidates.sort(key=lambda item: item[0], reverse=True)\n"
    code = code + "        return candidates[0][1].resolve()\n"
    code = code + "    return (output_user_root / 'n2kwlvv2').resolve()\n"
    code = code + "\n"
    code = code + "def __kain_pid_running(pid):\n"
    code = code + "    if os.name != 'nt':\n"
    code = code + "        return False\n"
    code = code + "    kernel32 = ctypes.windll.kernel32\n"
    code = code + "    handle = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, int(pid))\n"
    code = code + "    if not handle:\n"
    code = code + "        return False\n"
    code = code + "    try:\n"
    code = code + "        exit_code = ctypes.c_ulong()\n"
    code = code + "        if not kernel32.GetExitCodeProcess(handle, ctypes.byref(exit_code)):\n"
    code = code + "            return False\n"
    code = code + "        return exit_code.value == STILL_ACTIVE\n"
    code = code + "    finally:\n"
    code = code + "        kernel32.CloseHandle(handle)\n"
    code = code + "\n"
    code = code + "def __kain_read_status(output_base):\n"
    code = code + "    pid_file = output_base / 'server' / 'server.pid.txt'\n"
    code = code + "    if not pid_file.exists():\n"
    code = code + "        return {'state': 'stopped', 'pid': '', 'summary': 'Bazel server is stopped', 'pid_file': str(pid_file)}\n"
    code = code + "    try:\n"
    code = code + "        pid = int(pid_file.read_text(encoding='utf-8').strip())\n"
    code = code + "    except Exception:\n"
    code = code + "        return {'state': 'stale', 'pid': '', 'summary': 'Bazel pid file is unreadable', 'pid_file': str(pid_file)}\n"
    code = code + "    if __kain_pid_running(pid):\n"
    code = code + "        return {'state': 'running', 'pid': str(pid), 'summary': 'Bazel server is running', 'pid_file': str(pid_file)}\n"
    code = code + "    return {'state': 'stale', 'pid': str(pid), 'summary': 'Bazel pid file is stale', 'pid_file': str(pid_file)}\n"
    code = code + "\n"
    code = code + "def __kain_bazel_server_gui_main(exe_path, cwd):\n"
    code = code + "    repo_root = __kain_bazel_gui_repo_root(exe_path, cwd)\n"
    code = code + "    bazel_cmd = __kain_bazel_gui_command()\n"
    code = code + "    output_base = __kain_bazel_output_base(repo_root, bazel_cmd, False)\n"
    code = code + "    root = tk.Tk()\n"
    code = code + "    root.title('Kain Bazel Server')\n"
    code = code + "    root.geometry('520x270')\n"
    code = code + "    root.minsize(480, 250)\n"
    code = code + "    root.configure(bg='#101418')\n"
    code = code + "    style = ttk.Style(root)\n"
    code = code + "    try:\n"
    code = code + "        style.theme_use('clam')\n"
    code = code + "    except Exception:\n"
    code = code + "        pass\n"
    code = code + "    style.configure('TFrame', background='#101418')\n"
    code = code + "    style.configure('Title.TLabel', background='#101418', foreground='#f2f6f8', font=('Segoe UI', 17, 'bold'))\n"
    code = code + "    style.configure('Body.TLabel', background='#101418', foreground='#a9b7bf', font=('Segoe UI', 10))\n"
    code = code + "    style.configure('Status.TLabel', background='#101418', foreground='#f2f6f8', font=('Segoe UI', 13, 'bold'))\n"
    code = code + "    style.configure('TButton', font=('Segoe UI', 10), padding=(12, 7))\n"
    code = code + "    shell = ttk.Frame(root, padding=18)\n"
    code = code + "    shell.pack(fill='both', expand=True)\n"
    code = code + "    title = ttk.Label(shell, text='Kain Bazel Server', style='Title.TLabel')\n"
    code = code + "    title.pack(anchor='w')\n"
    code = code + "    status = ttk.Label(shell, text='Checking...', style='Status.TLabel')\n"
    code = code + "    status.pack(anchor='w', pady=(18, 4))\n"
    code = code + "    detail = ttk.Label(shell, text='', style='Body.TLabel', wraplength=470, justify='left')\n"
    code = code + "    detail.pack(anchor='w', fill='x')\n"
    code = code + "    buttons = ttk.Frame(shell)\n"
    code = code + "    buttons.pack(anchor='w', pady=(22, 0))\n"
    code = code + "    log = ttk.Label(shell, text='', style='Body.TLabel', wraplength=470, justify='left')\n"
    code = code + "    log.pack(anchor='w', fill='x', pady=(14, 0))\n"
    code = code + "    def paint():\n"
    code = code + "        state = __kain_read_status(output_base)\n"
    code = code + "        color = {'running': '#33d17a', 'stopped': '#ff6b6b', 'stale': '#f6c85f'}.get(state['state'], '#f2f6f8')\n"
    code = code + "        status.configure(text=state['summary'] + (('  pid ' + state['pid']) if state['pid'] else ''), foreground=color)\n"
    code = code + "        detail.configure(text='repo: ' + str(repo_root) + '\\noutput base: ' + str(output_base))\n"
    code = code + "        return state\n"
    code = code + "    def threaded(label, fn):\n"
    code = code + "        def run():\n"
    code = code + "            root.after(0, lambda: log.configure(text=label + '...'))\n"
    code = code + "            try:\n"
    code = code + "                message = fn()\n"
    code = code + "            except Exception as exc:\n"
    code = code + "                message = type(exc).__name__ + ': ' + str(exc)\n"
    code = code + "            root.after(0, lambda: (paint(), log.configure(text=message)))\n"
    code = code + "        threading.Thread(target=run, daemon=True).start()\n"
    code = code + "    def start_bazel():\n"
    code = code + "        nonlocal output_base\n"
    code = code + "        output_base = __kain_bazel_output_base(repo_root, bazel_cmd, True)\n"
    code = code + "        return 'Started or contacted Bazel server.'\n"
    code = code + "    def stop_bazel():\n"
    code = code + "        subprocess.run([bazel_cmd, 'shutdown'], cwd=str(repo_root), text=True, capture_output=True, check=False, timeout=35)\n"
    code = code + "        state = __kain_read_status(output_base)\n"
    code = code + "        if state['state'] == 'running' and state['pid']:\n"
    code = code + "            subprocess.run(['taskkill', '/PID', state['pid'], '/T', '/F'], text=True, capture_output=True, check=False)\n"
    code = code + "            return 'Stopped Bazel server with taskkill fallback.'\n"
    code = code + "        return 'Stopped Bazel server.'\n"
    code = code + "    ttk.Button(buttons, text='Start Bazel', command=lambda: threaded('Starting Bazel', start_bazel)).grid(row=0, column=0, padx=(0, 8))\n"
    code = code + "    ttk.Button(buttons, text='Stop Bazel', command=lambda: threaded('Stopping Bazel', stop_bazel)).grid(row=0, column=1, padx=(0, 8))\n"
    code = code + "    ttk.Button(buttons, text='Refresh', command=lambda: (paint(), log.configure(text='Refreshed.'))).grid(row=0, column=2, padx=(0, 8))\n"
    code = code + "    ttk.Button(buttons, text='Open F:/_b', command=lambda: os.startfile(str(output_base))).grid(row=0, column=3)\n"
    code = code + "    def tick():\n"
    code = code + "        paint()\n"
    code = code + "        root.after(1500, tick)\n"
    code = code + "    paint()\n"
    code = code + "    root.after(1500, tick)\n"
    code = code + "    root.mainloop()\n"
    code = code + "    return 0\n"
    return code

fn main() -> Int:
    let boot = runtime_init()
    if boot != 0:
        return 100 + boot

    python_exec(bazel_gui_bootstrap_code())
    let result = python_call_raw("__kain_bazel_server_gui_main", [process_current_executable_path(), process_current_working_directory()])
    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    return to_int(result)
