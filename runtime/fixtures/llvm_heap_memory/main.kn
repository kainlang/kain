// LLVM heap helper execution fixture
// Purpose: prove alloc/realloc/mem_store/mem_load run through the linked native runtime.

fn main() -> Int:
    let initial_cells: Int = 1
    let grown_cells: Int = 2
    let mut p: ptr<Int> = alloc_zeroed(initial_cells, "Int")
    mem_store(p, 7, "Int")

    let mut q: ptr<Int> = realloc_mem(p, grown_cells, "Int", true)
    let preserved: Int = mem_load(q, "Int")
    let grown: Int = mem_load(ptr_offset(q, 1, "Int"), "Int")

    if preserved == 7:
        if grown == 0:
            return 0
        return 12

    return 11
