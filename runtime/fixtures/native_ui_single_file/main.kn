use std::runtime
use std::time

import pyglet as pyglet

const PYGLET_WINDOW_WIDTH: Int = 960
const PYGLET_WINDOW_HEIGHT: Int = 540
const PYGLET_FRAME_BUDGET: Int = 18
const PYGLET_FRAME_SLEEP_MS: Int = 50

fn pump_visible_window(window: Any) -> Int:
    var frame: Int = 0
    while frame < PYGLET_FRAME_BUDGET:
        let _dispatch = py_call_raw(py_getattr_raw(window, "dispatch_events"), [])
        let _switch = py_call_raw(py_getattr_raw(window, "switch_to"), [])
        let _flip = py_call_raw(py_getattr_raw(window, "flip"), [])
        sleep_millis(PYGLET_FRAME_SLEEP_MS)
        frame = frame + 1
    return frame

fn main() -> Int:
    let boot = runtime_init()
    if boot != 0:
        return 100 + boot

    // First-class Python import syntax is intentionally present here because this
    // fixture is meant to pressure the authored import lane, but the live native
    // runner still resolves the module through the raw bridge for execution.
    let pyglet_runtime = py_import("pyglet")
    let window_module = py_getattr_raw(pyglet_runtime, "window")
    let window_ctor = py_getattr_raw(window_module, "Window")
    let window = py_call_raw(
        window_ctor,
        [PYGLET_WINDOW_WIDTH, PYGLET_WINDOW_HEIGHT, "Kain Native UI // pyglet startup proof"]
    )

    let _caption = py_call_raw(
        py_getattr_raw(window, "set_caption"),
        ["Kain Native UI // pyglet startup proof"]
    )
    let _visible = py_call_raw(py_getattr_raw(window, "set_visible"), [true])
    let pumped = pump_visible_window(window)
    let _close = py_call_raw(py_getattr_raw(window, "close"), [])

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    if pumped != PYGLET_FRAME_BUDGET:
        return 2
    return 0
