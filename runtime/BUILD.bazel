load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load(":runtime_manifest_data.bzl", "NATIVE_CORE_RUNTIME", "NATIVE_RUNTIME", "NATIVE_RUNTIME_ACTOR_TESTS")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

config_setting(
    name = "linux",
    constraint_values = ["@platforms//os:linux"],
)

config_setting(
    name = "macos",
    constraint_values = ["@platforms//os:macos"],
)

WINDOWS_RUNTIME_DEFINES = [
    "WIN32",
    "_WINDOWS",
]

WINDOWS_COPTS = [
    "/W3",
]

WINDOWS_CPP_COPTS = WINDOWS_COPTS + [
    "/std:c++20",
]

POSIX_C_COPTS = [
    "-Wall",
    "-Wextra",
    "-std=c11",
]

POSIX_CPP_COPTS = [
    "-Wall",
    "-Wextra",
    "-std=c++20",
]

RUNTIME_TEST_LINUX_DEFINES = [
    "_POSIX_C_SOURCE=200809L",
]

RUNTIME_PRIVATE_HEADERS = [
    "native/src/**/*.h",
    "third_party/**/*.h",
    "third_party/**/*.hpp",
]


def _platform_select(windows = [], linux = [], macos = [], default = []):
    return select({
        ":windows": windows,
        ":linux": linux,
        ":macos": macos,
        "//conditions:default": default,
    })


def _runtime_headers(manifest):
    return glob(
        manifest["header_globs"] + RUNTIME_PRIVATE_HEADERS,
        exclude = ["3rdparty/skia-core/**"],
        allow_empty = True,
    )


def _runtime_defines(manifest):
    return manifest["common_defines"] + _platform_select(
        windows = WINDOWS_RUNTIME_DEFINES + manifest["windows_defines"],
        linux = manifest["linux_defines"],
        macos = manifest["macos_defines"],
    )


def _runtime_linkopts(manifest):
    return _platform_select(
        windows = manifest["windows_linkopts"],
        linux = manifest["linux_linkopts"],
        macos = manifest["macos_linkopts"],
    )


def _runtime_c_srcs(manifest):
    return manifest["common_c_srcs"] + _platform_select(
        windows = manifest["windows_c_srcs"],
        linux = manifest["linux_c_srcs"],
        macos = manifest["macos_c_srcs"],
    )


def _runtime_cpp_srcs(manifest):
    return manifest["common_cpp_srcs"] + _platform_select(
        windows = manifest["windows_cpp_srcs"],
        linux = manifest["linux_cpp_srcs"],
        macos = manifest["macos_cpp_srcs"],
    )


def _declare_runtime_bundle(name, manifest):
    runtime_headers = _runtime_headers(manifest)

    cc_library(
        name = name + "_c",
        srcs = _runtime_c_srcs(manifest),
        hdrs = runtime_headers,
        copts = _platform_select(
            windows = WINDOWS_COPTS,
            linux = POSIX_C_COPTS,
            macos = POSIX_C_COPTS,
        ),
        defines = _runtime_defines(manifest),
        includes = manifest["includes"],
        alwayslink = True,
        visibility = ["//visibility:private"],
    )

    runtime_bundle_deps = [":" + name + "_c"]

    if manifest["has_cpp_sources"]:
        cc_library(
            name = name + "_cpp",
            srcs = _runtime_cpp_srcs(manifest),
            hdrs = runtime_headers,
            copts = _platform_select(
                windows = WINDOWS_CPP_COPTS,
                linux = POSIX_CPP_COPTS,
                macos = POSIX_CPP_COPTS,
            ),
            defines = _runtime_defines(manifest),
            includes = manifest["includes"],
            alwayslink = True,
            visibility = ["//visibility:private"],
        )
        runtime_bundle_deps.append(":" + name + "_cpp")

    cc_library(
        name = name,
        deps = runtime_bundle_deps,
        linkopts = _runtime_linkopts(manifest),
    )


_declare_runtime_bundle("native_core_runtime", NATIVE_CORE_RUNTIME)
_declare_runtime_bundle("native_runtime", NATIVE_RUNTIME)

cc_test(
    name = "native_test_actor_monitor_link",
    srcs = [NATIVE_RUNTIME_ACTOR_TESTS[0]],
    copts = _platform_select(
        windows = WINDOWS_COPTS,
        linux = POSIX_C_COPTS,
        macos = POSIX_C_COPTS,
    ),
    defines = _platform_select(
        linux = RUNTIME_TEST_LINUX_DEFINES,
        macos = RUNTIME_TEST_LINUX_DEFINES,
    ),
    deps = [":native_core_runtime"],
)

cc_test(
    name = "native_test_actor_supervision",
    srcs = [NATIVE_RUNTIME_ACTOR_TESTS[1]],
    copts = _platform_select(
        windows = WINDOWS_COPTS,
        linux = POSIX_C_COPTS,
        macos = POSIX_C_COPTS,
    ),
    defines = _platform_select(
        linux = RUNTIME_TEST_LINUX_DEFINES,
        macos = RUNTIME_TEST_LINUX_DEFINES,
    ),
    deps = [":native_core_runtime"],
)

test_suite(
    name = "native_runtime_tests",
    tests = [
        ":native_test_actor_monitor_link",
        ":native_test_actor_supervision",
    ],
)
