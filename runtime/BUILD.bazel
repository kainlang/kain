load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load(":native_runtime_rules.bzl", "POSIX_C_COPTS", "WINDOWS_COPTS", "declare_runtime_bundle", "platform_select")
load(":runtime_manifest_data.bzl", "NATIVE_CORE_RUNTIME", "NATIVE_RUNTIME", "NATIVE_RUNTIME_ACTOR_TESTS", "NATIVE_RUNTIME_OWNERSHIP_TESTS")
load(":BUILD.freestanding.bzl", "declare_freestanding_core_runtime")

package(default_visibility = ["//visibility:public"])

exports_files([
    "native_core_runtime.toml",
    "native_runtime.toml",
])

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

config_setting(
    name = "linux",
    constraint_values = ["@platforms//os:linux"],
)

config_setting(
    name = "macos",
    constraint_values = ["@platforms//os:macos"],
)

# Detect clang-cl on Windows (used for clang-cl compatible flags)
# Compound: matches Windows + clang-cl simultaneously
config_setting(
    name = "windows_and_clang_cl",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {
        "@bazel_tools//tools/cpp:compiler": "clang-cl",
    },
)

# ── Cross-compilation platform targets ──────────────────────────────
platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

RUNTIME_TEST_LINUX_DEFINES = [
    "_POSIX_C_SOURCE=200809L",
]

declare_runtime_bundle("native_core_runtime", NATIVE_CORE_RUNTIME)
# Keep the legacy-named target so older Bazel entrypoints still resolve, but
# point it at the same lean mirror data as the active runtime lane.
declare_runtime_bundle("native_full_runtime", NATIVE_RUNTIME)

alias(
    name = "native_runtime",
    actual = ":native_core_runtime",
)

# ── Freestanding core runtime (bare metal, no OS, no libc) ────────────
declare_freestanding_core_runtime()

# ── Header-only library for sub-packages that need runtime headers ───
#     without linking all runtime object files.
cc_library(
    name = "runtime_headers_only",
    hdrs = glob(
        ["native/include/**/*.h"],
        allow_empty = False,
    ),
    includes = ["native/include"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "native_test_actor_monitor_link",
    srcs = [NATIVE_RUNTIME_ACTOR_TESTS[0]],
    copts = platform_select(
        windows = WINDOWS_COPTS,
        linux = POSIX_C_COPTS,
        macos = POSIX_C_COPTS,
    ),
    defines = platform_select(
        linux = RUNTIME_TEST_LINUX_DEFINES,
        macos = RUNTIME_TEST_LINUX_DEFINES,
    ),
    deps = [":native_core_runtime"],
)

