//    Capability predicates: cuda.sm_90, cuda.tensorcore,
//      cuda.wgmma, gpu.async_compute
//  SEMANTIC CONSTRUCTS: world, entangle, patch, law, converge, orchestrate,
//    resonate, shatter, teleport, component, collapse, observe, decay,
//    subgroup(32), dispatch, dispatch_indirect, comptime
//  TELEMETRY PROBES: ALL 34 std::intent functions exercised
