// ============================================================================
//  RUNTIME SMOKE — Single-file regression test for the entire Kain native runtime
// ============================================================================
//
//  Lives alongside the C runtime source (runtime/native/src/).
//  Every abi_* function, every compiler-lowered semantic construct,
//  every std::intent telemetry probe gets exercised.
//
//  Usage:
//    kain check X:\runtime\native\src\runtime_smoke.kn --json
//    kain run   X:\runtime\native\src\runtime_smoke.kn --target llvm
//
//  Exit code = final checksum (0 = all phases passed structurally).
//  Negative exit = crash or invariant violation.
//
//  Based on patterns proven in: fusion_chain.kn, core_actor.kn,
//  rage_runtime.kn, CRUSHER.kn, core_os.kn
// ============================================================================

use std::runtime
use std::intent
use std::machine
use std::time
use std::fs
use std::crypto
use std::actor
use std::thread
use std::json
use std::net
use std::os
use std::process
use std::platform

// GPU/Vulkan imports (Phase 11-14)
use std::vulkan
use std::gpu
use std::cuda

// ============================================================================
//  CONSTANTS
// ============================================================================

const SMOKE_MODULUS:    Int = 1000000007
const SMOKE_CELL_COUNT: Int = 64
const SMOKE_ITERATIONS: Int = 200      // ~6s at 30ms/iter; capped by 60s budget
const SMOKE_TIMEOUT_MS: Int = 60000    // 60 second budget

// ============================================================================
//  HELPERS
// ============================================================================

fn smoke_mod(v: Int, m: Int) -> Int:
    let r = v % m
    if r < 0:
        return r + m
    return r

fn smoke_hash_phase(name: String, result: Int, phase_index: Int) -> Int:
    let h = phase_index * 1000003
    let h = h + len(name) * 7907
    let h = h + smoke_mod(result, SMOKE_MODULUS)
    return smoke_mod(h, SMOKE_MODULUS)

fn smoke_streq(a: String, b: String) -> Bool:
    if len(a) != len(b):
        return false
    var i = 0
    while i < len(a):
        if char_at(a, i) != char_at(b, i):
            return false
        i = i + 1
    return true

fn smoke_str_len(s: String) -> Int:
    let n = len(s)
    if n < 0:
        return 0
    return n

fn smoke_log(phase: String, msg: String, value: Int) -> Int:
    let log_line = phase + " | " + msg + " = " + to_string(value)
    fs_append_text("__smoke_report.log", log_line + "\n")
    return 0

// ============================================================================
//  PHASE 1: LIFECYCLE — init/shutdown, heap, version
//  C files: core.c, version.c
// ============================================================================

fn smoke_phase1_lifecycle(modulus: Int) -> Int:
    let init = runtime_init()
    if init != 0:
        smoke_log("LIFECYCLE", "runtime_init FAIL", init)
        return -11

    let heap_ok = runtime_heap_validate()
    smoke_log("LIFECYCLE", "heap_validate", heap_ok)

    // CPU feature fingerprint
    let feat_mask = runtime_cpu_feature_mask()
    let feat_fp   = runtime_cpu_feature_fingerprint()
    smoke_log("LIFECYCLE", "cpu_feature_mask", feat_mask)

    // Attrition ABI (no-op outside attrition builds)
    runtime_attrition_checkpoint("smoke_phase1", modulus)
    runtime_attrition_note_progress(1, modulus)
    runtime_attrition_result_set(modulus, 0, "")

    let shutdown = runtime_shutdown()
    smoke_log("LIFECYCLE", "runtime_shutdown", shutdown)

    return smoke_mod(init + heap_ok + feat_mask + feat_fp + shutdown, SMOKE_MODULUS)


// ============================================================================
//  PHASE 2: MEMORY & OWNERSHIP
//  C files: memory.c, ownership.c
// ============================================================================

fn smoke_phase2_memory(modulus: Int) -> Int with Unsafe:
    let n = SMOKE_CELL_COUNT

    // alloc → collapse → store → observe → load → decay
    let mut cells: ptr<Int> = alloc_zeroed(n, "Int")

    collapse cells:
        var i = 0
        while i < n:
            mem_store(ptr_offset(cells, i, "Int"), (i * 13 + 7) % modulus, "Int")
            i = i + 1
        0

    let sum: Int = observe cells:
        var s = 0
        var j = 0
        while j < n:
            s = smoke_mod(s + mem_load(ptr_offset(cells, j, "Int"), "Int"), SMOKE_MODULUS)
            j = j + 1
        s

    // ptr_offset + load
    let offset_ptr: ptr<Int> = ptr_offset(cells, 3, "Int")
    let recon_val: Int = mem_load(offset_ptr, "Int")

    decay cells
    smoke_log("MEMORY", "collapse_observe_decay_checksum", sum)

    return smoke_mod(sum + recon_val, SMOKE_MODULUS)


// ============================================================================
//  PHASE 3: TIME & MACHINE
//  C files: machine_stones.c, cpu.c, virtual_alloc.c
// ============================================================================

fn smoke_phase3_machine(modulus: Int) -> Int with Unsafe:
    // Time
    let t0 = now_millis()
    sleep_millis(1)
    let t1 = now_millis()
    smoke_log("MACHINE", "now_millis_delta", t1 - t0)

    // CPU
    let log_count = cpu_logical_count()
    let core_count = cpu_core_count()
    let pkg_count = cpu_package_count()
    let cache_line = cpu_cache_line_bytes()
    smoke_log("MACHINE", "cpu_logical_count", log_count)

    // CPUID
    let cpuid_e = cpuid_eax(1, 0)
    let cpuid_b = cpuid_ebx(1, 0)
    let cpuid_c = cpuid_ecx(1, 0)
    let cpuid_d = cpuid_edx(1, 0)
    smoke_log("MACHINE", "cpuid_eax_1_0", cpuid_e)

    // Thread identity
    let tid = current_thread_id()
    let affinity = current_thread_affinity_mask()

    // NUMA
    let numa_nodes = numa_node_count()
    let numa_cur = numa_current_node()
    smoke_log("MACHINE", "numa_nodes", numa_nodes)

    // VM probing
    let page_sz = vm_page_size()
    let vm_ptr: ptr<Int> = vm_reserve(page_sz * 4)
    vm_commit(vm_ptr, page_sz)
    vm_protect_read_write(vm_ptr, page_sz)
    vm_protect_read(vm_ptr, page_sz)
    vm_decommit(vm_ptr, page_sz)
    vm_release(vm_ptr, page_sz * 4)
    smoke_log("MACHINE", "vm_page_size", page_sz)

    // Converge raw ABI
    runtime_converge_select_lane(1, 1, 0xFF, 0)
    runtime_converge_commit_winner(1, 1, 0)
    runtime_converge_record_telemetry(1, 0, 100, 1, 0)
    let tel_count = runtime_converge_telemetry_count()
    smoke_log("MACHINE", "converge_telemetry_count", tel_count)

    return smoke_mod(t0 + t1 + log_count + core_count + pkg_count + cache_line
                     + cpuid_e + cpuid_b + cpuid_c + cpuid_d
                     + tid + affinity + numa_nodes + numa_cur + page_sz
                     + tel_count, SMOKE_MODULUS)


// ============================================================================
//  PHASE 4: FILESYSTEM
//  C files: stdlib_abi.c (fs section), core.c
// ============================================================================

fn smoke_phase4_filesystem(modulus: Int) -> Int:
    let test_content = "Kain runtime smoke test v1.0\n"

    // Write → read → verify → remove (temp file lifecycle)
    let tmp_file = fs_temp_file("smoke")
    if smoke_str_len(tmp_file) < 1:
        smoke_log("FS", "temp_file_FAIL", -41)
        return -41

    fs_write_text(tmp_file, test_content)
    let read_back = fs_read_text(tmp_file)
    smoke_log("FS", "write_read_bytes", smoke_str_len(read_back))

    // exists / is_file
    let ex = fs_exists(tmp_file)
    let isf = fs_is_file(tmp_file)
    if ex == false or isf == false:
        smoke_log("FS", "exists_check_FAIL", -42)
        return -42

    // append
    fs_append_text(tmp_file, "appended\n")
    let appended = fs_read_text(tmp_file)
    smoke_log("FS", "append_bytes", smoke_str_len(appended))

    // atomic write
    fs_atomic_write_text(tmp_file, "atomic_content")
    let atomic_read = fs_read_text(tmp_file)
    smoke_log("FS", "atomic_write_bytes", smoke_str_len(atomic_read))

    // hex bytes
    let hex_file = fs_temp_file("smoke_hex")
    fs_write_bytes_hex(hex_file, "DEADBEEF")
    let hex_read = fs_read_bytes_hex(hex_file)
    smoke_log("FS", "hex_write_read_bytes", smoke_str_len(hex_read))

    // streaming I/O
    let stream_file = fs_temp_file("smoke_stream")
    let f = fs_open(stream_file, "w")
    let mut buf: ptr<Int> = alloc_zeroed(4, "Int")
    collapse buf:
        mem_store(buf, 0x41424344, "Int")
        0
    let written = fs_write(f, buf, 4)
    fs_flush(f)
    fs_close(f)

    let f2 = fs_open(stream_file, "r")
    let tell_pos = fs_tell(f2)
    let mut read_buf: ptr<Int> = alloc_zeroed(4, "Int")
    let nread = fs_read(f2, read_buf, 4)
    fs_close(f2)
    smoke_log("FS", "streaming_write_read", written + nread)

    // metadata + hash
    let meta = fs_metadata_text(tmp_file)
    let hash = fs_hash_file(tmp_file)
    smoke_log("FS", "hash_len", smoke_str_len(hash))

    // path ops
    let joined  = fs_path_join("/foo", "bar.kn")
    let parent  = fs_path_parent("/a/b/c.txt")
    let fname   = fs_path_file_name("/a/b/c.txt")
    smoke_log("FS", "path_join_len", smoke_str_len(joined))

    // dir ops
    let tmp_dir = fs_temp_dir("smoke_dir")
    fs_create_dir_all(tmp_dir)
    let dir_list = fs_read_dir_paths_text(tmp_dir)
    fs_remove_dir_all(tmp_dir)
    smoke_log("FS", "dir_list_len", smoke_str_len(dir_list))

    // copy + move
    let copy_dest = fs_temp_file("smoke_copy")
    fs_copy_file(tmp_file, copy_dest)
    let copy_exists = fs_exists(copy_dest)

    let move_dest = fs_temp_file("smoke_move")
    fs_copy_file(copy_dest, move_dest)
    fs_move_path(move_dest, move_dest + ".moved")
    let moved_exists = fs_exists(move_dest + ".moved")

    // last error probes
    let _last_status = fs_last_status()
    let _last_kind   = fs_last_error_kind()
    let _last_msg    = fs_last_error_message()

    // Cleanup
    fs_remove_file(tmp_file)
    fs_remove_file(hex_file)
    fs_remove_file(stream_file)
    fs_remove_file(copy_dest)
    fs_remove_file(move_dest + ".moved")
    decay buf
    decay read_buf

    return smoke_mod(smoke_str_len(read_back) + smoke_str_len(appended)
                     + smoke_str_len(atomic_read) + smoke_str_len(hex_read)
                     + written + nread + tell_pos
                     + smoke_str_len(joined) + smoke_str_len(parent)
                     + smoke_str_len(fname) + smoke_str_len(meta)
                     + smoke_str_len(hash) + smoke_str_len(dir_list)
                     + (if copy_exists: 1 else: 0)
                     + (if moved_exists: 1 else: 0), SMOKE_MODULUS)


// ============================================================================
//  PHASE 5: CRYPTO & JSON
//  C files: stdlib_abi.c (crypto), json.c
// ============================================================================

fn smoke_phase5_crypto_json(modulus: Int) -> Int:
    // Crypto
    let sha = crypto_sha256("kain runtime smoke")
    let hmac = crypto_hmac_sha256("secret-key", "message")
    let b3 = crypto_blake3("smoke test data")
    let rand_hex = crypto_random_bytes_hex(16)
    smoke_log("CRYPTO", "sha256_len", smoke_str_len(sha))
    smoke_log("CRYPTO", "hmac_len", smoke_str_len(hmac))
    smoke_log("CRYPTO", "blake3_len", smoke_str_len(b3))
    smoke_log("CRYPTO", "random_hex_len", smoke_str_len(rand_hex))

    // JSON round-trip
    let json_str = "{\"name\":\"smoke\",\"count\":42,\"active\":true,\"tags\":[\"a\",\"b\"]}"
    let parsed = json_parse_text(json_str)
    let kind = json_value_kind(parsed)
    smoke_log("JSON", "parse_ok", smoke_str_len(kind))

    let name_val = json_string_field(parsed, "name")
    let count_val = json_int_field(parsed, "count")
    let tags_val = json_array_field(parsed, "tags")
    let arr_len = json_array_length(tags_val)
    smoke_log("JSON", "array_length", arr_len)

    // Build + stringify
    let obj = json_object()
    json_object_set_string(obj, "phase", "5")
    json_object_set_int(obj, "score", modulus)
    let arr = json_array()
    json_array_push_int(arr, 1)
    json_array_push_string(arr, "hello")
    json_object_set_array(obj, "items", arr)
    let rendered = json_stringify(obj)
    smoke_log("JSON", "stringify_len", smoke_str_len(rendered))

    return smoke_mod(smoke_str_len(sha) + smoke_str_len(hmac)
                     + smoke_str_len(b3) + smoke_str_len(rand_hex)
                     + smoke_str_len(kind) + smoke_str_len(rendered)
                     + arr_len, SMOKE_MODULUS)


// ============================================================================
//  PHASE 6: CONCURRENCY — actor ABI queries, thread, atomic notify
//  C files: actor.c, core.c
// ============================================================================

fn smoke_phase6_concurrency(modulus: Int) -> Int with Unsafe:
    // Actor ABI constants
    let abi_ver    = actor_abi_version()
    let invalid_id = actor_invalid_id()
    let def_cap    = actor_default_mailbox_capacity()
    let unbounded  = actor_unbounded_mailbox_capacity()
    let ask_timeout = actor_default_ask_timeout_ms()
    let sup_max    = actor_supervision_max_restarts()
    smoke_log("ACTOR", "abi_version", abi_ver)
    smoke_log("ACTOR", "invalid_id", invalid_id)
    smoke_log("ACTOR", "default_mailbox_cap", def_cap)

    // Actor registry
    let reg_lookup = actor_registry_lookup("nonexistent_smoke_actor")
    smoke_log("ACTOR", "registry_lookup_nonexistent", reg_lookup)

    // Scheduler telemetry
    let sched_depth      = actor_scheduler_queue_depth()
    let sched_max_depth  = actor_scheduler_max_queue_depth()
    let sched_enqueued   = actor_scheduler_total_enqueued()
    let sched_dequeued   = actor_scheduler_total_dequeued()
    let sched_workers    = actor_scheduler_worker_count()
    let sched_active     = actor_scheduler_active_workers()
    let sched_overflow   = actor_scheduler_overflow_thread_spawns()
    smoke_log("ACTOR", "scheduler_queue_depth", sched_depth)
    smoke_log("ACTOR", "scheduler_workers", sched_workers)

    // Thread ABI
    thread_yield()
    thread_set_name("smoke")
    let th_logical = thread_logical_count()
    let th_cores   = thread_core_count()
    let th_id      = thread_current_id()
    smoke_log("THREAD", "logical_count", th_logical)

    // Atomic wait/notify
    let mut atomic_cell: ptr<Int> = alloc_zeroed(1, "Int")
    collapse atomic_cell:
        mem_store(atomic_cell, 0, "Int")
        0
    let woken = atomic_notify_one(atomic_cell)
    let woken_all = atomic_notify_all(atomic_cell)
    decay atomic_cell
    smoke_log("ATOMIC", "notify_one", woken)
    smoke_log("ATOMIC", "notify_all", woken_all)

    return smoke_mod(abi_ver + invalid_id + def_cap + unbounded + ask_timeout
                     + sup_max + reg_lookup + sched_depth + sched_max_depth
                     + sched_enqueued + sched_dequeued + sched_workers
                     + sched_active + sched_overflow
                     + th_logical + th_cores + th_id
                     + woken + woken_all, SMOKE_MODULUS)


// ============================================================================
//  PHASE 7: NETWORKING
//  C files: net_system.c
// ============================================================================

fn smoke_phase7_networking(modulus: Int) -> Int:
    let plat_avail = net_platform_available()
    let plat_name  = net_platform_name()
    smoke_log("NET", "platform_available", plat_avail)
    smoke_log("NET", "platform_name_len", smoke_str_len(plat_name))

    // Capability queries
    let cap_tcp = net_capability_available("tcp")
    let cap_http = net_capability_available("http")
    smoke_log("NET", "cap_tcp", (if cap_tcp: 1 else: 0))
    smoke_log("NET", "cap_http", (if cap_http: 1 else: 0))

    // TCP listen on ephemeral port
    let listener = tcp_listen("127.0.0.1", 0)
    if listener >= 0:
        let local_port = tcp_listener_local_port(listener)
        smoke_log("NET", "tcp_listen_port", local_port)

        // connect + accept
        let conn = tcp_connect("127.0.0.1", local_port, 500)
        if conn >= 0:
            let acceptor = tcp_accept(listener, 500)
            if acceptor >= 0:
                tcp_write_text(conn, "ping\n")
                let reply = tcp_read_text(acceptor)
                smoke_log("NET", "tcp_reply_len", smoke_str_len(reply))
                tcp_close(acceptor)
            tcp_close(conn)
        tcp_listener_close(listener)

    // HTTP request construction
    let req = http_request_create("GET", "http://127.0.0.1:1/")
    if req >= 0:
        http_request_set_header(req, "User-Agent", "KainRuntimeSmoke/1.0")
        http_request_set_timeout(req, 100)
        http_request_destroy(req)

    let _status = net_last_status()
    let _kind   = net_last_error_kind()
    let _msg    = net_last_error_message()

    return smoke_mod(listener + smoke_str_len(plat_name) + plat_avail, SMOKE_MODULUS)


// ============================================================================
//  PHASE 8: SEMANTIC STACK
// ============================================================================

world SmokeAuthority:
    state signal:      Int = 1
    state epoch:       Int = 0
    state shadow:      Int = 0
    state ack_count:   Int = 0
    state last_old:    Int = 0
    state last_new:    Int = 0
    state pulse_ticks: Int = 0
    state teleport_landing: Int = 0

world SmokeMirror:
    state signal_copy:      Int = 1
    state epoch_copy:       Int = 0
    state ack_count_copy:   Int = 0
    state pulse_ticks_copy: Int = 0
    state teleport_landing: Int = 0

entangle SmokeAuthority.signal      <-> SmokeMirror.signal_copy      with single_writer
entangle SmokeAuthority.epoch       <-> SmokeMirror.epoch_copy       with single_writer
entangle SmokeAuthority.ack_count   <-> SmokeMirror.ack_count_copy   with single_writer
entangle SmokeAuthority.pulse_ticks <-> SmokeMirror.pulse_ticks_copy with single_writer

law smoke_signal_valid(value: Int) -> Bool:
    return value >= 0 and value < SMOKE_MODULUS

law smoke_epoch_valid(e: Int) -> Bool:
    return e >= 0

patch smoke_commit_signal(authority: SmokeAuthority, value: Int) -> Int:
    authority.signal = value
    authority.epoch = authority.epoch + 1
    return authority.epoch

patch smoke_reset_world(authority: SmokeAuthority) -> Int:
    authority.signal = 1
    authority.epoch = 0
    authority.shadow = 0
    authority.last_old = 0
    authority.last_new = 0
    authority.ack_count = 0
    authority.pulse_ticks = 0
    return 0

converge smoke_fast_mix(value: Int, seed: Int) -> Int:
    spec reference:
        return smoke_mod((value * 31 + seed) * 17 + 7, SMOKE_MODULUS)
    fast llvm_lane when target("llvm"):
        return smoke_mod(((value + seed) * 48 + 14) % SMOKE_MODULUS, SMOKE_MODULUS)
    verify random(4)

orchestrate smoke_pipeline(value: Int, tick: Int) -> Int:
    stage base: cpu smoke_mod(value + tick, SMOKE_MODULUS) when capability("cpu.scalar") residency host transfer none
    stage fast: converge smoke_fast_mix(base, tick) deps [base] residency host
    return fast

resonate SmokeAuthority.signal dampen 0 ms:
    SmokeAuthority.last_old = resonate_old_i64
    SmokeAuthority.last_new = resonate_new_i64
    SmokeAuthority.shadow = smoke_pipeline(
        resonate_new_i64 + SmokeAuthority.epoch,
        SmokeAuthority.epoch
    )

shatter struct SmokeShard:
    bias:     Int
    phase:    Int
    tick:     Int
    checksum: Int

fn smoke_phase8_semantic(modulus: Int) -> Int:
    // Reset
    smoke_reset_world(SmokeAuthority)

    // Patch → entangle propagation
    let epoch1 = smoke_commit_signal(SmokeAuthority, 42)
    smoke_log("SEMANTIC", "patch_epoch", epoch1)

    // Read mirror
    let mirror_sig = SmokeMirror.signal_copy
    smoke_log("SEMANTIC", "entangle_mirror_sig", mirror_sig)

    // Laws
    let law_ok = smoke_signal_valid(42)
    let epoch_ok = smoke_epoch_valid(1)
    smoke_log("SEMANTIC", "law_signal_valid", (if law_ok: 1 else: 0))

    // Converge
    let conv = smoke_fast_mix(7, 3)
    smoke_log("SEMANTIC", "converge_result", conv)

    // Orchestrate
    let orch = smoke_pipeline(epoch1, 1)
    smoke_log("SEMANTIC", "orchestrate_result", orch)

    // Shatter + teleport
    let shard = SmokeShard { bias: 1, phase: 2, tick: 3, checksum: 4 }
    let score_before = smoke_mod(
        (shard.bias * 31) + (shard.phase * 17) + (shard.tick * 7) + shard.checksum,
        SMOKE_MODULUS
    )
    let moved = teleport shard from SmokeAuthority to SmokeMirror via teleport_landing
    let score_after = smoke_mod(
        (moved.bias * 31) + (moved.phase * 17) + (moved.tick * 7) + moved.checksum,
        SMOKE_MODULUS
    )
    smoke_log("SEMANTIC", "teleport_score", score_after)

    // Touch teleport_landing for liveness
    let _tl = SmokeMirror.teleport_landing
    let _tla = SmokeAuthority.teleport_landing

    // Raw entangle register
    entangle_register("test_auth", "test_mirror", "single_writer", "Int")
    let ent_count = entangle_registered_count()
    entangle_reset()
    smoke_log("SEMANTIC", "entangle_registered", ent_count)

    return smoke_mod(epoch1 + mirror_sig + conv + orch
                     + score_before + score_after + ent_count
                     + (if law_ok: 1 else: 0) + (if epoch_ok: 1 else: 0), SMOKE_MODULUS)


// ============================================================================
//  PHASE 9: TELEMETRY FINALE — all std::intent probes
//  C files: stdlib_abi.c (intent section), converge.c, machine_stones.c
// ============================================================================

fn smoke_phase9_telemetry(modulus: Int) -> Int:
    // Entangle
    let ent_prop_count  = entangle_propagation_count()
    let ent_has_bind    = entangle_has_bindings()
    let ent_last_auth   = entangle_last_authority()
    let ent_last_mirror = entangle_last_mirror()
    smoke_log("TELEMETRY", "entangle_propagation_count", ent_prop_count)

    // Patch
    let patch_count = patch_journal_count()
    let patch_path  = patch_last_path()
    smoke_log("TELEMETRY", "patch_journal_count", patch_count)

    // Resonate
    let res_mut_count = resonate_mutation_count()
    let res_fire_count = resonate_fire_count()
    let res_abs_count = resonate_absorb_count()
    let res_last_target = resonate_last_target()
    let res_last_old = resonate_last_old_i64()
    let res_last_new = resonate_last_new_i64()
    smoke_log("TELEMETRY", "resonate_fire_count", res_fire_count)

    // Converge
    let conv_mismatch = converge_mismatch_count()
    smoke_log("TELEMETRY", "converge_mismatch_count", conv_mismatch)

    // Orchestrate
    let orch_stage_count   = orchestrate_stage_count()
    let orch_transfer_cnt  = orchestrate_transfer_count()
    let orch_fallback_cnt  = orchestrate_fallback_count()
    let orch_adaptive_cnt  = orchestrate_adaptive_stage_count()
    smoke_log("TELEMETRY", "orchestrate_stage_count", orch_stage_count)

    // Law
    let law_ok = law_status(true)
    let law_valid = law_is_valid_status(law_ok)

    // Patch status
    let patch_status_ok = patch_status(true)
    let patch_applied_val = patch_applied(patch_status_ok)

    // Converge choose
    let conv_choose_int = converge_choose_int(10, 20)
    let conv_choose_bool = converge_choose_bool(true, false)
    let conv_status_val = converge_status(10, 20)

    // Orchestrate stage status
    let orch_stage_status = orchestrate_stage_status(0)
    let orch_merge_val = orchestrate_merge_status(0, 1)

    // Machine teleport + pulse
    let teleport_count = runtime_machine_teleport_count()
    let teleport_token = runtime_machine_teleport_last_token()
    let pulse_count = runtime_machine_pulse_total_fire_count()
    smoke_log("TELEMETRY", "machine_teleport_count", teleport_count)
    smoke_log("TELEMETRY", "machine_pulse_count", pulse_count)

    // Read last orchestrate metadata (prove they compile)
    let _orch_deps  = orchestrate_last_dependencies()
    let _orch_res   = orchestrate_last_residency()
    let _orch_trans = orchestrate_last_transfer()
    let _orch_guard = orchestrate_last_guard()
    let _orch_fall  = orchestrate_last_fallback()
    let _orch_req   = orchestrate_last_requires()
    let _orch_pol   = orchestrate_last_policy()

    // Entangle reflection
    let _ent_auth0 = entangle_get_authority(0)
    let _ent_mirr0 = entangle_get_mirror(0)
    let _ent_pol0  = entangle_get_policy(0)
    let _ent_type0 = entangle_get_type_name(0)

    // Verify critical probes fired
    if patch_count < 1:
        smoke_log("TELEMETRY", "INVARIANT_FAIL_patch", patch_count)
        return -91
    if ent_prop_count < 1:
        smoke_log("TELEMETRY", "INVARIANT_FAIL_entangle", ent_prop_count)
        return -92
    if law_valid == false:
        smoke_log("TELEMETRY", "INVARIANT_FAIL_law", -93)
        return -93

    return smoke_mod(
        ent_prop_count + smoke_str_len(ent_last_auth) + smoke_str_len(ent_last_mirror)
        + patch_count + smoke_str_len(patch_path)
        + res_mut_count + res_fire_count + res_abs_count
        + smoke_str_len(res_last_target) + res_last_old + res_last_new
        + conv_mismatch + orch_stage_count
        + orch_transfer_cnt + orch_fallback_cnt + orch_adaptive_cnt
        + law_ok + patch_status_ok
        + conv_choose_int + (if conv_choose_bool: 1 else: 0) + conv_status_val
        + orch_stage_status + orch_merge_val
        + teleport_count + teleport_token + pulse_count
        + (if ent_has_bind: 1 else: 0) + (if patch_applied_val: 1 else: 0),
        SMOKE_MODULUS
    )


// ============================================================================
//  PHASE 10: OS & PROCESS
//  C files: os_system.c, process_system.c, platform.c, platform_library.c
// ============================================================================

fn smoke_phase10_os_process(modulus: Int) -> Int:
    // Platform
    let plat_kind = platform_current_kind()
    let plat_name = platform_current_name()
    smoke_log("OS", "platform_kind", plat_kind)
    smoke_log("OS", "platform_name_len", smoke_str_len(plat_name))

    // Env
    let _home = os_getenv("HOME")
    let _path = os_getenv("PATH")
    let _cwd  = os_getcwd()
    let _exec = process_current_executable_path()
    smoke_log("OS", "cwd_len", smoke_str_len(_cwd))
    smoke_log("OS", "exec_path_len", smoke_str_len(_exec))

    // Platform library
    let lib = platform_library_open("kernel32.dll")
    if lib != 0:
        platform_library_resolve(lib, "GetTickCount")
        platform_library_close(lib)
        smoke_log("OS", "platform_library_ok", 1)

    // Process
    let _pid = process_current_id()
    smoke_log("OS", "process_id", _pid)

    return smoke_mod(plat_kind + smoke_str_len(plat_name)
                     + smoke_str_len(_home) + smoke_str_len(_path)
                     + smoke_str_len(_cwd) + smoke_str_len(_exec)
                     + _pid, SMOKE_MODULUS)


// ============================================================================
//  PHASE 11: GPU CAPABILITY & PIPELINE TYPES
//  C files: vulkan_surface_shim.c, vulkan_abi.c, cuda_runtime.c
//  Keywords: dispatch, dispatch_indirect, comptime, subgroup, sample
// ============================================================================

fn smoke_phase11_gpu_capability(modulus: Int) -> Int with GPU, Unsafe:
    // CUDA capability probes (pure @extern — always link)
    let cuda_ready = cuda_runtime_ready()
    let cuda_drv = cuda_driver_available()
    let cuda_lib = cuda_runtime_library_available()
    smoke_log("GPU", "cuda_runtime_ready", (if cuda_ready: 1 else: 0))
    smoke_log("GPU", "cuda_driver_available", (if cuda_drv: 1 else: 0))
    smoke_log("GPU", "cuda_library_available", (if cuda_lib: 1 else: 0))

    // Pipeline library types (pure Kain + @extern — links fine)
    let lib = gpu_pipeline_library_create("smoke_gpu_lib")
    smoke_log("GPU", "pipeline_library_name", smoke_str_len(lib.name))
    let handle = gpu_pipeline_library_register(lib, "shader::SmokeKernel::compute", [256, 1, 1])
    smoke_log("GPU", "pipeline_handle_id", handle.id)
    let found = gpu_pipeline_library_find(lib, "shader::SmokeKernel::compute")
    let destroy_rc = gpu_pipeline_library_destroy(lib)
    smoke_log("GPU", "pipeline_library_destroy", destroy_rc)

    // Indirect dispatch buffer
    let indirect_buf: ptr<DispatchIndirectCommand> = gpu_indirect_buffer_zeroed()
    smoke_log("GPU", "indirect_buffer_zeroed_ok", 1)

    return smoke_mod(handle.id + destroy_rc, SMOKE_MODULUS)


// ============================================================================
//  PHASE 12: VULKAN ABI TELEMETRY
//  C files: vulkan_surface_shim.c, vulkan_stubs.c, vulkan_abi.c
// ============================================================================

fn smoke_phase12_vulkan_telemetry(modulus: Int) -> Int with Unsafe:
    // Vulkan status probes (public API)
    let vk_error = vulkan_last_error()
    let vk_present = vulkan_present_count()
    smoke_log("VULKAN", "present_count", vk_present)
    smoke_log("VULKAN", "error_len", smoke_str_len(vk_error))

    // Vulkan capability
    let vk_avail = vulkan_available()
    smoke_log("VULKAN", "available", vk_avail)

    // Shader load stub path (session_id = -1 exercises error handling)
    let load_err = vulkan_load_shader(-1, "DEADBEEF")
    smoke_log("VULKAN", "load_shader_stub_rc", load_err)

    // Uniform stubs
    let set_time_err = vulkan_set_uniform_time(-1, 0.0)
    let set_res_err = vulkan_set_uniform_resolution(-1, 1920.0, 1080.0)
    let set_mouse_err = vulkan_set_uniform_mouse(-1, 0.0, 0.0)
    smoke_log("VULKAN", "set_uniform_time_rc", set_time_err)
    smoke_log("VULKAN", "set_uniform_res_rc", set_res_err)

    // Update all uniforms stub
    let update_all_err = vulkan_update_shader_uniforms(-1, 0.0, 1920.0, 1080.0, 0.0, 0.0)
    smoke_log("VULKAN", "update_uniforms_stub_rc", update_all_err)

    return smoke_mod(vk_present + vk_avail + smoke_str_len(vk_error)
                     + load_err + set_time_err + set_res_err + set_mouse_err + update_all_err,
                     SMOKE_MODULUS)


// ============================================================================
//  PHASE 13: SHADER MATH AVAILABILITY (Compile-Time)
//  Verifies all 27 GLSL.std.450 functions compile in shader context
// ============================================================================

shader compute SmokeShaderMath(id: UVec3) -> Void workgroup(1, 1, 1):
    let x: Float = Float(id.x) * 0.1
    let y: Float = x * 0.5

    // Trigonometry
    let _s = sin(x)
    let _c = cos(x)
    let _t = tan(x)
    let _as = asin(y)
    let _ac = acos(y)
    let _at = atan(x)
    let _a2 = atan2(y, x)
    // Exponents
    let _ex = exp(x)
    let _ln = log(max(0.001, x))
    let _e2 = exp2(x)
    let _l2 = log2(max(0.001, x))
    // Rounding
    let _f = fract(x)
    let _tr = trunc(x)
    let _si = sign(x)
    // Interpolation
    let _st = step(0.5, x)
    // Angles
    let _rd = radians(x)
    let _dg = degrees(x)
    // Additional
    let _is = inversesqrt(x + 0.01)
    // Vectors
    let v = vec3(x, y, 1.0)
    let _n = normalize(v)
    let _cr = cross(v, vec3(0.0, 1.0, 0.0))
    let _re = reflect(v, vec3(0.0, 1.0, 0.0))
    let _rf = refract(vec3(x, 1.0, 0.0), vec3(1.0, 0.0, 0.0), 1.5)

    return

fn smoke_phase13_shader_math(modulus: Int) -> Int:
    smoke_log("SHADER", "math_functions_compiled", 27)
    return smoke_mod(27, SMOKE_MODULUS)


// ============================================================================
//  PHASE 14: GPU STDLIB TYPES & AXIOMS
// ============================================================================

axiom smoke_tensorcore_axiom:
    when capability("cuda.sm_90")
    when capability("cuda.tensorcore")
    when capability("cuda.wgmma")
    guarantee "sm_90 tensor core matmul available via WGMMA"
    fallback smoke_phase14_fallback

axiom smoke_async_compute_axiom:
    when capability("gpu.async_compute")
    guarantee "async compute queue available"
    fallback smoke_phase14_fallback

fn smoke_phase14_fallback() -> Int:
    return 0

fn smoke_phase14_gpu_stdlib(modulus: Int) -> Int:
    smoke_log("GPU", "tensorcore_axiom_compiled", 1)
    smoke_log("GPU", "async_compute_axiom_compiled", 1)
    let ph = PipelineHandle { id: 1, library_name: "test", compute_key: "key", dispatch_size: [256, 1, 1] }
    smoke_log("GPU", "pipeline_handle_dispatch_x", ph.dispatch_size[0])
    return smoke_mod(ph.id + 1, SMOKE_MODULUS)


// ============================================================================
//  MAIN — Execute all phases with iteration, timing, and report generation
// ============================================================================

fn main() -> Int with GPU, Unsafe:
    // Clear previous report
    fs_write_text("__smoke_report.log", "=== RUNTIME SMOKE REPORT ===\n")
    smoke_log("INIT", "smoke_start", 0)

    let t_start = now_millis()
    var iter = 0
    var total_score = 0

    while iter < SMOKE_ITERATIONS:
        smoke_log("ITER", "begin", iter)

        // Phase 1
        let p1 = smoke_phase1_lifecycle(SMOKE_MODULUS)
        if p1 < 0:
            smoke_log("FAIL", "phase1", p1)
            return p1
        total_score = smoke_mod(total_score + smoke_hash_phase("lifecycle", p1, 1), SMOKE_MODULUS)

        // Phase 2
        let p2 = smoke_phase2_memory(SMOKE_MODULUS)
        if p2 < 0:
            smoke_log("FAIL", "phase2", p2)
            return p2
        total_score = smoke_mod(total_score + smoke_hash_phase("memory", p2, 2), SMOKE_MODULUS)

        // Phase 3
        let p3 = smoke_phase3_machine(SMOKE_MODULUS)
        if p3 < 0:
            smoke_log("FAIL", "phase3", p3)
            return p3
        total_score = smoke_mod(total_score + smoke_hash_phase("machine", p3, 3), SMOKE_MODULUS)

        // Phase 4
        let p4 = smoke_phase4_filesystem(SMOKE_MODULUS)
        if p4 < 0:
            smoke_log("FAIL", "phase4", p4)
            return p4
        total_score = smoke_mod(total_score + smoke_hash_phase("fs", p4, 4), SMOKE_MODULUS)

        // Phase 5
        let p5 = smoke_phase5_crypto_json(SMOKE_MODULUS)
        if p5 < 0:
            smoke_log("FAIL", "phase5", p5)
            return p5
        total_score = smoke_mod(total_score + smoke_hash_phase("crypto", p5, 5), SMOKE_MODULUS)

        // Phase 6
        let p6 = smoke_phase6_concurrency(SMOKE_MODULUS)
        if p6 < 0:
            smoke_log("FAIL", "phase6", p6)
            return p6
        total_score = smoke_mod(total_score + smoke_hash_phase("concur", p6, 6), SMOKE_MODULUS)

        // Phase 7
        let p7 = smoke_phase7_networking(SMOKE_MODULUS)
        if p7 < 0:
            smoke_log("FAIL", "phase7", p7)
            return p7
        total_score = smoke_mod(total_score + smoke_hash_phase("network", p7, 7), SMOKE_MODULUS)

        // Phase 8
        let p8 = smoke_phase8_semantic(SMOKE_MODULUS)
        if p8 < 0:
            smoke_log("FAIL", "phase8", p8)
            return p8
        total_score = smoke_mod(total_score + smoke_hash_phase("semantic", p8, 8), SMOKE_MODULUS)

        // Phase 9
        let p9 = smoke_phase9_telemetry(SMOKE_MODULUS)
        if p9 < 0:
            smoke_log("FAIL", "phase9", p9)
            return p9
        total_score = smoke_mod(total_score + smoke_hash_phase("telemetry", p9, 9), SMOKE_MODULUS)

        // Phase 10
        let p10 = smoke_phase10_os_process(SMOKE_MODULUS)
        if p10 < 0:
            smoke_log("FAIL", "phase10", p10)
            return p10
        total_score = smoke_mod(total_score + smoke_hash_phase("osproc", p10, 10), SMOKE_MODULUS)

        // Phase 11 — GPU capability & pipeline types
        let p11 = smoke_phase11_gpu_capability(SMOKE_MODULUS)
        if p11 < 0:
            smoke_log("FAIL", "phase11", p11)
            return p11
        total_score = smoke_mod(total_score + smoke_hash_phase("gpu_cap", p11, 11), SMOKE_MODULUS)

        // Phase 12 — Vulkan ABI telemetry
        let p12 = smoke_phase12_vulkan_telemetry(SMOKE_MODULUS)
        if p12 < 0:
            smoke_log("FAIL", "phase12", p12)
            return p12
        total_score = smoke_mod(total_score + smoke_hash_phase("vulkan", p12, 12), SMOKE_MODULUS)

        // Phase 13 — Shader math compilation
        let p13 = smoke_phase13_shader_math(SMOKE_MODULUS)
        if p13 < 0:
            smoke_log("FAIL", "phase13", p13)
            return p13
        total_score = smoke_mod(total_score + smoke_hash_phase("shader", p13, 13), SMOKE_MODULUS)

        // Phase 14 — GPU stdlib types & axioms
        let p14 = smoke_phase14_gpu_stdlib(SMOKE_MODULUS)
        if p14 < 0:
            smoke_log("FAIL", "phase14", p14)
            return p14
        total_score = smoke_mod(total_score + smoke_hash_phase("gpu_types", p14, 14), SMOKE_MODULUS)

        let t_elapsed = now_millis() - t_start
        smoke_log("ITER", "end_checksum", total_score)
        smoke_log("ITER", "elapsed_ms", t_elapsed)

        iter = iter + 1

        // Time budget check
        if t_elapsed >= SMOKE_TIMEOUT_MS:
            smoke_log("BUDGET", "timeout_at_iter", iter)
            iter = SMOKE_ITERATIONS    // force exit

    let t_total = now_millis() - t_start
    smoke_log("FINAL", "total_checksum", total_score)
    smoke_log("FINAL", "total_iterations", iter)
    smoke_log("FINAL", "total_elapsed_ms", t_total)
    smoke_log("FINAL", "status", (if total_score >= 0: 0 else: total_score))

    // Read report size for verification
    let report_size = smoke_str_len(fs_read_text("__smoke_report.log"))
    smoke_log("FINAL", "report_log_bytes", report_size)

    return total_score


