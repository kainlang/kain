; Proof: the de Bruijn magic constant 0x03f79d71b4cb0a89 produces distinct
; 6-bit indices for every 64-bit one-hot value.
;
; This validates that kain_graphics_low_bit_index_u64 (modeled after
; abi_net_low_bit_index_u64) correctly maps any isolated low bit to
; its position 0-63 without collisions.
;
; Verification: z3 action="check" smt2="..." -> unsat
(set-logic QF_BV)
(define-fun magic () (_ BitVec 64) #x03f79d71b4cb0a89)

(define-fun debruijn ((x (_ BitVec 64))) (_ BitVec 6)
  ((_ extract 63 58) (bvmul x magic)))

; Enumerate all 64 one-hot bit positions
(define-fun h0  () (_ BitVec 6) (debruijn (bvshl (_ bv1 64) (_ bv0 64))))
(define-fun h1  () (_ BitVec 6) (debruijn (bvshl (_ bv1 64) (_ bv1 64))))
