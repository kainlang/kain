; Z3 proof: After release, a stale handle (with old magic) cannot validate
; Release: entry->magic = kain_handle_nonzero_magic(entry->magic + 1)
;          = ((magic + 1) & 0xffffff) == 0 ? 1 : (magic + 1) & 0xffffff
; Validate: checks table->slots[slot].magic == kain_handle_magic(handle)
; Since magic changes on release, old handles are always rejected
; Generated by runtime-z3-optimizer agent
(set-logic QF_BV)

(declare-const old_magic (_ BitVec 24))
(declare-const slot (_ BitVec 32))
(declare-const kind (_ BitVec 8))

; Build handle using old magic (as kain_handle_make would)
(define-fun slot_plus_1 () (_ BitVec 32) (bvadd slot (_ bv1 32)))
(define-fun handle () (_ BitVec 64)
  (concat kind (concat old_magic slot_plus_1)))

; Extract magic from handle (as kain_handle_magic does)
(define-fun handle_magic () (_ BitVec 24) ((_ extract 55 32) handle))

; New magic after release: kain_handle_nonzero_magic(old_magic + 1)
; The C function: magic &= 0xffffff; return magic == 0 ? 1 : magic
(define-fun bumped () (_ BitVec 24) (bvadd old_magic (_ bv1 24)))
(define-fun new_magic () (_ BitVec 24)
  (ite (= bumped (_ bv0 24)) (_ bv1 24) bumped))

; Claim: handle_magic (which came from old_magic) can NEVER equal new_magic
; If unsat, the assertion is impossible -> stale handles always rejected
(assert (= handle_magic new_magic))
(check-sat)
; Expected: unsat (no assignment makes old_magic == new_magic after bump)
