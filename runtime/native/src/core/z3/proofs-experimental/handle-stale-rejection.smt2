; Z3 proof: After release, a stale handle (with old magic) cannot validate
; Release: entry->magic = nonzero(entry->magic + 1)
; Validate: checks table->slots[slot].magic == kain_handle_magic(handle)
; Since magic changes on release, old handles are rejected
; Generated by runtime-z3-optimizer agent
(set-logic QF_BV)

(declare-const old_magic (_ BitVec 24))
(declare-const slot (_ BitVec 32))
(declare-const kind (_ BitVec 8))

; Build handle using old magic: same as kain_handle_make
(define-fun handle () (_ BitVec 64)
  (bvor
    (bvshl ((_ zero_extend 56) kind) (_ bv56 64))
    (bvshl ((_ zero_extend 40) old_magic) (_ bv32 64))
    (bvadd ((_ zero_extend 32) slot) (_ bv1 64))))

; Extract magic from handle: same as kain_handle_magic
(define-fun handle_magic () (_ BitVec 24)
  ((_ extract 55 32) handle))

; New magic after release: kain_handle_nonzero_magic(old_magic + 1)
; Note: magic is stored as 24-bit in slot, kain_handle_nonzero_magic maps 0->1
(define-fun bumped () (_ BitVec 24) (bvadd old_magic (_ bv1 24)))
(define-fun new_magic () (_ BitVec 24)
  (ite (= bumped (_ bv0 24)) (_ bv1 24) bumped))

; Assert: handle's old magic != new magic stored in slot after release
; If unsat, magic always differs -> stale handles always rejected
(assert (= handle_magic new_magic))
(check-sat)