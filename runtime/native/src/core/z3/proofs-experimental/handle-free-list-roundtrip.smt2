; Z3 proof: Handle table free-list acquire/release roundtrip
; Invariant: after acquire then release, the slot is:
;   1. no longer occupied (occupied = 0)
;   2. back on the free list (next_free -> old first_free, first_free -> this slot)
;   3. magic has bumped (old magic != new magic, so stale handles rejected)
; Generated by runtime-z3-optimizer agent

(set-logic QF_BV)

; Helper: kain_handle_nonzero_magic for 24-bit magic
(define-fun nonzero_24 ((m (_ BitVec 24))) (_ BitVec 24)
  (ite (= m (_ bv0 24)) (_ bv1 24) m))

; Simulate one acquire+release cycle on slot 0 of a 4-slot table
; Initial state: free list = [0 -> 1 -> 2 -> 3 -> END]

(declare-const initial_first_free (_ BitVec 2))
(declare-const slot0_next_free_init (_ BitVec 2))
(declare-const slot0_magic_init (_ BitVec 24))

; Initial setup: free list points to slot 0
(assert (= initial_first_free (_ bv0 2)))
(assert (= slot0_next_free_init (_ bv1 2)))

; === ACQUIRE slot 0 ===
; first_free = slot0.next_free = 1
; slot0.occupied = 1
; slot0.magic = nonzero(slot0_magic_init)
(define-fun after_acquire_first_free () (_ BitVec 2) slot0_next_free_init)
(define-fun after_acquire_occupied () (_ BitVec 1) (_ bv1 1))
(define-fun after_acquire_magic () (_ BitVec 24) (nonzero_24 slot0_magic_init))

; === RELEASE slot 0 ===
; slot0.occupied = 0
; slot0.magic = nonzero(slot0.magic + 1)
; slot0.next_free = first_free (= 1)
; first_free = 0 (the released slot)
(define-fun after_release_occupied () (_ BitVec 1) (_ bv0 1))
(define-fun after_release_magic () (_ BitVec 24) (nonzero_24 (bvadd after_acquire_magic (_ bv1 24))))
(define-fun after_release_next_free () (_ BitVec 2) after_acquire_first_free)
(define-fun after_release_first_free () (_ BitVec 2) (_ bv0 2))

; Verify: first_free is back to 0
(assert (not (= after_release_first_free (_ bv0 2))))
(check-sat)
; Expected: unsat

; Verify: slot 0 is not occupied
(push 1)
(assert (not (= after_release_occupied (_ bv0 1))))
(check-sat)
(pop 1)
; Expected: unsat

; Verify: slot 0's next_free points to old first_free (slot 1)
(push 1)
(assert (not (= after_release_next_free after_acquire_first_free)))
(check-sat)
(pop 1)
; Expected: unsat

; Verify: magic after release != magic after acquire (stale handle rejection)
(push 1)
(assert (= after_release_magic after_acquire_magic))
(check-sat)
(pop 1)
; Expected: unsat
