; Z3 proof: Handle packing/unpacking is lossless
; handle = kind[8] || magic[24] || slot_plus_1[32]
; Generated by runtime-z3-optimizer agent
(set-logic QF_BV)

(declare-const kind (_ BitVec 8))
(declare-const slot (_ BitVec 32))
(declare-const magic_raw (_ BitVec 24))

; Pack: exactly like kain_handle_make
(define-fun slot_plus_1 () (_ BitVec 32) (bvadd slot (_ bv1 32)))
(define-fun packed () (_ BitVec 64)
  (concat kind (concat magic_raw slot_plus_1)))

; Extract: exactly like the accessors
(define-fun kind_out () (_ BitVec 8) ((_ extract 63 56) packed))
(define-fun magic_out () (_ BitVec 24) ((_ extract 55 32) packed))

; kain_handle_slot: encoded = (uint32_t)(handle & 0xffffffff)
; if encoded == 0: return UINT32_MAX else return encoded - 1
(define-fun encoded () (_ BitVec 32) ((_ extract 31 0) packed))
(define-fun slot_out () (_ BitVec 32)
  (ite (= encoded (_ bv0 32))
       (_ bv4294967295 32)
       (bvsub encoded (_ bv1 32))))

; Case 1: Normal slot (not UINT32_MAX) must roundtrip perfectly
(assert (not (= slot (_ bv4294967295 32))))
(assert (not
  (and (= kind kind_out)
       (= magic_raw magic_out)
       (= slot slot_out))))
(check-sat)
; Expected: unsat (no counterexample -> roundtrip is lossless)

; Case 2: slot = UINT32_MAX makes slot_plus_1 = 0,
; which encodes as 0, and slot_out must be UINT32_MAX
(push 1)
(assert (= slot (_ bv4294967295 32)))
(assert (not (= slot_out (_ bv4294967295 32))))
(check-sat)
(pop 1)
; Expected: unsat (slot UINT32_MAX correctly roundtrips to UINT32_MAX)

; Case 3: Verify 24-bit magic is preserved (upper bits of magic_input are ignored)
(assert (= magic_raw ((_ extract 23 0) ((_ zero_extend 8) magic_raw))))
(check-sat)
; Expected: unsat (trivially true, but confirms our model)
