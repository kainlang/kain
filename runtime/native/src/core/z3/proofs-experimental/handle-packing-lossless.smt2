; Z3 proof: Handle packing/unpacking is lossless
; handle = (kind & 0xff) << 56 | (magic & 0xffffff) << 32 | (slot + 1)
; Generated by runtime-z3-optimizer agent
(set-logic QF_BV)

(declare-const kind (_ BitVec 8))
(declare-const slot (_ BitVec 32))
(declare-const magic_raw (_ BitVec 32))

; Constrain: magic must fit in lower 24 bits, kind any 8-bit, slot any 32-bit
(assert (bvult magic_raw (_ bv16777216 32)))

; Pack: built exactly like kain_handle_make
(define-fun packed () (_ BitVec 64)
  (bvor
    (bvshl ((_ zero_extend 56) kind) (_ bv56 64))
    (bvshl ((_ zero_extend 32) ((_ extract 23 0) magic_raw)) (_ bv32 64))
    (bvadd ((_ zero_extend 32) slot) (_ bv1 64))
  ))

; Extract: exactly like kain_handle_kind, kain_handle_slot, kain_handle_magic
(define-fun kind_out () (_ BitVec 8)
  ((_ extract 63 56) packed))

(define-fun magic_out () (_ BitVec 32)
  (bvshl ((_ zero_extend 8) ((_ extract 55 32) packed)) (_ bv0 32)))

; kain_handle_slot: encoded = (uint32_t)(handle & 0xffffffff); return encoded-1 or UINT32_MAX if 0
(define-fun encoded () (_ BitVec 32) ((_ extract 31 0) packed))
(define-fun slot_out () (_ BitVec 32)
  (ite (= encoded (_ bv0 32)) (_ bv4294967295 32) (bvsub encoded (_ bv1 32))))

; Assert roundtrip preserves all fields when slot != 0xFFFFFFFF
(assert (not (= slot (_ bv4294967295 32))))
(assert (not
  (and
    (= kind kind_out)
    (= magic_raw magic_out)
    (= slot slot_out)
  )))
(check-sat)

; Additional: slot=0xFFFFFFFF makes encoded=0, gets slot_out=0xFFFFFFFF
(assert (= slot (_ bv4294967295 32)))

(define-fun encoded_sentinel () (_ BitVec 32) ((_ extract 31 0) packed))
(define-fun slot_sentinel () (_ BitVec 32)
  (ite (= encoded_sentinel (_ bv0 32)) (_ bv4294967295 32) (bvsub encoded_sentinel (_ bv1 32))))
(assert (not (= slot_sentinel (_ bv4294967295 32))))
(check-sat)