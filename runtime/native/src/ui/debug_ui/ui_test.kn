use std::runtime
use std::ui

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    // Create session with REAL window backend
    let session = ui_host_session_create("ui_test", "Kain UI — Working", 1280, 720, "winit")
    if session <= 0:
        runtime_shutdown()
        return 1

    // Create root node
    let root = ui_reconcile_node(session, 0, "root", "test.root", 0.0, 0.0, 1280.0, 720.0)

    // Create a panel
    let panel = ui_reconcile_labeled_node(
        session, root, "panel", "test.panel", "main", "region",
        "Kain UI Panel", 40.0, 40.0, 600.0, 400.0
    )

    // Create text node
    let title = ui_reconcile_text_node(
        session, panel, "text", "test.title",
        "Hello from Kain!",
        60.0, 60.0, 560.0, 40.0
    )

    // Set styles — dark theme with green accent
    let _root_bg = ui_style_color_rgba(session, root, "ui.root", 0.05, 0.06, 0.10, 1.0)
    let _panel_bg = ui_style_color_rgba(session, panel, "ui.panel", 0.12, 0.18, 0.25, 1.0)
    let _title_fg = ui_style_color_rgba(session, title, "ui.title", 0.13, 0.83, 0.63, 1.0)
    let _padding = ui_style_padding(session, panel, "ui.panel", 16.0, 16.0, 16.0, 16.0)

    // Create a font resource
    let font = ui_font_create(session, "font.body", "Segoe UI", 18.0)
    let _ = font

    // Frame loop — run until window close
    while ui_host_should_close(session) == 0:
        let _begin = ui_frame_begin(session, 16.0)
        let _draw_root = ui_render_box(session, root, "ui.root")
        let _draw_panel = ui_render_box(session, panel, "ui.panel")
        let _draw_title = ui_render_text_in_box(session, title, font, 8.0, 8.0, "ui.title")
        let _submit = ui_frame_submit(session)
        let _present = ui_host_present(session)
        let _pump = ui_host_pump(session)

    let _destroy = ui_session_destroy(session)

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    return 0
