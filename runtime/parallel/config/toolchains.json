{
  "schema_version": 1,
  "tools": {
    "cargo": {
      "command": "cargo",
      "fallback": []
    },
    "zig": {
      "command": "zig",
      "fallback": []
    },
    "clang": {
      "env": "KAIN_CLANG_PATH"
    }
  },
  "outputs": {
    "report_dir": "runtime/parallel/reports",
    "rust_report": "rust_parallel_summary.json",
    "zig_report": "zig_parallel_summary.json",
    "combined_report": "parallel_pipeline_report.json"
  }
}
