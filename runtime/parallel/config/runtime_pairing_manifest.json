{
  "schema_version": 1,
  "native_runtime": {
    "root": "runtime",
    "manifest_path": "runtime/native_runtime.toml",
    "metadata_path": "runtime/native_runtime_metadata.json",
    "tracker_path": "runtime/NATIVE_RUNTIME_COMPLETION_TRACKER.md",
    "spec_tasks_path": ".kiro/specs/kain-native-runtime-completion/tasks.md"
  },
  "pairing_components": [
    {
      "id": "shared.runtime-abi-model",
      "lane": "shared",
      "status": "active",
      "summary": "Shared ABI and service-model pairing contract consumed by Rust and Zig runtime-side tools.",
      "phases": [1, 3, 10, 11, 13],
      "pairs_with_services": ["base.diagnostics", "contract", "compatibility", "host.bridge"],
      "depends_on_services": ["base.diagnostics", "contract"],
      "depends_on_components": [],
      "inputs": [
        "runtime/native_runtime.toml",
        "runtime/native_runtime_metadata.json",
        "runtime/NATIVE_RUNTIME_COMPLETION_TRACKER.md",
        ".kiro/specs/kain-native-runtime-completion/tasks.md"
      ],
      "outputs": [
        "runtime/parallel/config/runtime_pairing_manifest.json"
      ],
      "deliverables": [
        "shared service and phase mapping",
        "single source of truth for non-C runtime modules"
      ],
      "notes": [
        "This component is configuration-first by design.",
        "All parallel runtime tools should load these paths instead of hardcoding runtime state."
      ]
    },
    {
      "id": "rust.runtime-host-validator",
      "lane": "rust",
      "status": "active",
      "summary": "Rust-side validator and summary CLI for pairing modules against native runtime services and spec phases.",
      "phases": [1, 3, 10, 11, 13],
      "pairs_with_services": ["contract", "reflection", "compatibility", "host.bridge"],
      "depends_on_services": ["base.diagnostics", "contract"],
      "depends_on_components": ["shared.runtime-abi-model"],
      "inputs": [
        "runtime/native_runtime.toml",
        "runtime/native_runtime_metadata.json",
        "runtime/parallel/config/runtime_pairing_manifest.json"
      ],
      "outputs": [
        "runtime/parallel/rust/kain-runtime-parallel"
      ],
      "deliverables": [
        "service availability checks",
        "phase-to-component summary",
        "JSON summary export for future tooling"
      ],
      "notes": [
        "This is the first executable pairing system in the parallel lane.",
        "It is safe to evolve while the C runtime spec agent works independently."
      ]
    },
    {
      "id": "rust.runtime-reflection-bridge",
      "lane": "rust",
      "status": "planned",
      "summary": "Rust-side reflection artifact loader and adapter for future host/runtime tooling.",
      "phases": [3, 11, 13],
      "pairs_with_services": ["reflection", "host.bridge"],
      "depends_on_services": ["contract", "reflection"],
      "depends_on_components": ["shared.runtime-abi-model", "rust.runtime-host-validator"],
      "inputs": [
        "runtime/native_runtime_metadata.json"
      ],
      "outputs": [
        "runtime/parallel/reports/reflection-bridge-summary.json"
      ],
      "deliverables": [
        "reflection artifact layout checks",
        "host/runtime reflection bridge model"
      ],
      "notes": [
        "This should not be implemented in C first while the spec run is active.",
        "It is intended to pair with compiler-emitted reflection artifacts once Phase 3 settles."
      ]
    },
    {
      "id": "zig.runtime-abi-loader",
      "lane": "zig",
      "status": "active",
      "summary": "Zig-side manifest and metadata loader for future runtime modules and native host shims.",
      "phases": [1, 10, 11, 12],
      "pairs_with_services": ["contract", "compatibility", "host.bridge"],
      "depends_on_services": ["contract"],
      "depends_on_components": ["shared.runtime-abi-model"],
      "inputs": [
        "runtime/native_runtime_metadata.json",
        "runtime/parallel/config/runtime_pairing_manifest.json"
      ],
      "outputs": [
        "runtime/parallel/zig"
      ],
      "deliverables": [
        "manifest summary",
        "lane-filtered component listing"
      ],
      "notes": [
        "Zig is not installed in the current environment, so this lane is scaffolded but not executed here."
      ]
    },
    {
      "id": "zig.runtime-scheduler-kit",
      "lane": "zig",
      "status": "planned",
      "summary": "Zig-side scheduler and executor kit intended to pair with actor and async phases after the C spec run settles.",
      "phases": [5, 6, 7, 13],
      "pairs_with_services": ["actor.runtime", "actor.registry", "async.runtime", "async.timers"],
      "depends_on_services": ["actor.runtime", "async.runtime"],
      "depends_on_components": ["shared.runtime-abi-model", "zig.runtime-abi-loader"],
      "inputs": [
        "runtime/native_runtime_metadata.json"
      ],
      "outputs": [
        "runtime/parallel/reports/zig-scheduler-kit-summary.json"
      ],
      "deliverables": [
        "actor scheduler plan",
        "async executor plan",
        "backpressure/supervision pairing notes"
      ],
      "notes": [
        "This deliberately stays outside `runtime/native` while the long-haul agent is active."
      ]
    }
  ]
}
