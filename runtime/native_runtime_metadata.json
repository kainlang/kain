  "metadata": {
    "description": "KAIN native C runtime for compiled programs",
    "compatibility_class": "experimental",
    "target_platforms": [
      "windows",
      "linux",
      "macos"
    ],
    "active_platforms": [
      "windows",
      "linux"
    ],
    "build_requirements": {
      "c_standard": "C99",
      "cpp_standard": "C++20",
      "compiler": "MSVC, GCC, or Clang",
      "dependencies": [
        "Windows SDK and system libraries for Win32/libuv/bgfx builds",
        "POSIX threads plus dl/rt/m for Linux/libuv builds",
        "OpenGL/EGL/X11/Xext development libraries for Linux bgfx builds",
        "Curated bx/bgfx/bimg source bundle for the graphics vendor lane",
        "Curated imgui and yoga source bundles for the first UI vendor lane",
        "WAMR, Skia, RmlUi, Slint, Qt, CEF, Filament, Diligent, and The Forge activate through bridge-backed runtime probes when their vendor roots or binaries are present",
        "imgui and yoga are compiled directly into the native vendor lane, while Qt remains probe-backed through the external shell path"
      ]
    }
  },
