// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
PhysicalPropertiesComponent physics;

// Texture Inputs
Texture3D<float4> velocity_texture : register(t1);
SamplerState velocity_textureSampler : register(s1);
Texture3D<float4> pressure_texture : register(t2);
SamplerState pressure_textureSampler : register(s2);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void SubtractGradientCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float3 pos = float3(ThreadId.x, ThreadId.y, ThreadId.z);
    float3 vel_old = velocity_texture.Sample(velocity_textureSampler, pos).xyz;
    float pL = pressure_texture.Sample(pressure_textureSampler, (pos + float3((-1), 0, 0))).x;
    float pR = pressure_texture.Sample(pressure_textureSampler, (pos + float3(1, 0, 0))).x;
    float pD = pressure_texture.Sample(pressure_textureSampler, (pos + float3(0, (-1), 0))).x;
    float pU = pressure_texture.Sample(pressure_textureSampler, (pos + float3(0, 1, 0))).x;
    float pB = pressure_texture.Sample(pressure_textureSampler, (pos + float3(0, 0, (-1)))).x;
    float pF = pressure_texture.Sample(pressure_textureSampler, (pos + float3(0, 0, 1))).x;
    float3 gradP = (float3((pR - pL), (pU - pD), (pF - pB)) * 0.500000);
    float3 vel_new = (vel_old - gradP);
    OutputTexture[ThreadId.xy] = float4(vel_new, 1.000000);
    return;
}
