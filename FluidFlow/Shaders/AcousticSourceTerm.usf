};

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
FCouplingComponentData coupling;

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void AcousticSourceTermCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float source = (coupling.acoustic_impedance * 0.001000);
    OutputTexture[ThreadId.xy] = float4(source, source, source, 1.000000);
    return;
}
