// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
FHyperFluidParticleSystemComponentData particle_system;
FPhysicalPropertiesComponentData physics;

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void ParticleDragCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float drag = ((particle_system.drag_coefficient * physics.density) * 0.010000);
    OutputTexture[ThreadId.xy] = float4(drag, drag, drag, 1.000000);
    return;
}
