// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// POD mirror for ParticulateComponent
struct FParticulateComponentData {
    int particle_count;
    float particle_radius;
    float drag_coefficient;
    float cohesion;
    float restitution;
    float friction;
    float adhesion;
    float granular_compaction;
};

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
FParticulateComponentData particles;

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void GranularFlowFrictionCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float friction = (particles.friction * particles.adhesion);
    OutputTexture[ThreadId.xy] = float4(friction, friction, friction, 1.000000);
    return;
}
