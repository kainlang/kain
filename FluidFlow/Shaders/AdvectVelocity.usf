// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
PhysicalPropertiesComponent physics;
TimeIntegrationComponent time;

// Texture Inputs
Texture3D<float4> velocity_texture : register(t2);
SamplerState velocity_textureSampler : register(s2);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void AdvectVelocityCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float2 dt = time.dt;
    float3 pos = float3(ThreadId.x, ThreadId.y, ThreadId.z);
    float3 vel = velocity_texture.Sample(velocity_textureSampler, pos).xyz;
    float3 prev_pos = (pos - (vel * dt));
    float3 advected_vel = velocity_texture.Sample(velocity_textureSampler, prev_pos).xyz;
    float decay = (1.000000 - ((physics.viscosity * dt)));
    OutputTexture[ThreadId.xy] = float4((advected_vel * decay), 1.000000);
    return;
}
