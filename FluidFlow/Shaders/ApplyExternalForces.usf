    float dens = density_texture.Sample(density_textureSampler, float3(ThreadId.x, ThreadId.y, ThreadId.z)).x;
    float temp = temperature_texture.Sample(temperature_textureSampler, float3(ThreadId.x, ThreadId.y, ThreadId.z)).x;
