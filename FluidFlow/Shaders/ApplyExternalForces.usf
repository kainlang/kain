Texture3D<float4> density_texture : register(t4);
SamplerState density_textureSampler : register(s4);
Texture3D<float4> temperature_texture : register(t5);
SamplerState temperature_textureSampler : register(s5);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void ApplyExternalForcesCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float2 dt = time.dt;
