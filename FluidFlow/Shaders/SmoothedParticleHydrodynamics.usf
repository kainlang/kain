};

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
FPhysicalPropertiesComponentData physics;
FTurbulenceComponentData turbulence;

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void SmoothedParticleHydrodynamicsCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float k = (physics.density * turbulence.intensity);
    OutputTexture[ThreadId.xy] = float4(k, k, k, 1.000000);
    return;
}
