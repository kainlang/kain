component App():
    render <slot>
        <theme name="kade_desktop">
            <scope name="shell" selector="kade-shell" />
            <token name="theme.background.top" category="color" value="#090c12" />
            <token name="theme.background.bottom" category="color" value="#101620" />
            <token name="theme.surface.default" category="color" value="#131a25" />
            <token name="theme.surface.alt" category="color" value="#1a2230" />
            <token name="theme.surface.raised" category="color" value="#232c3b" />
            <token name="theme.outline.soft" category="color" value="#3f4a5d" />
            <token name="theme.outline.bright" category="color" value="#d7a56a" />
            <token name="theme.accent.primary" category="color" value="#c98847" />
            <token name="theme.accent.soft" category="color" value="#edc496" />
            <token name="text.default" category="color" value="#f5efe6" />
            <token name="theme.typography.scale" category="type" value={1.08} />
            <token name="theme.spacing.scale" category="space" value={1.02} />
            <token name="theme.radius.scale" category="radius" value={1.12} />
            <token name="theme.chrome.topbar.visible" category="state" value={true} />
            <token name="theme.chrome.inspector.visible" category="state" value={false} />
            <token name="widget.panel.surface.stroke" category="color" value="#00000000" />
            <token name="widget.inspector.surface.mode" category="surface" value="ghost" />
            <token name="widget.inspector.surface.stroke" category="color" value="#00000000" />
            <token name="widget.tree.surface.mode" category="surface" value="ghost" />
            <token name="widget.tree.surface.stroke" category="color" value="#00000000" />
            <variant scope="shell" name="shell_root">
                <token name="title.visible" category="state" value={false} />
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={6} />
            </variant>
            <variant scope="shell" name="sidebar">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={14} />
            </variant>
            <variant scope="shell" name="workspace">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={10} />
            </variant>
            <variant scope="shell" name="stage">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={20} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="shell" name="tray">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={14} />
            </variant>
            <textvariant scope="shell" name="hero">
                <token name="body.size" category="type" value={34} />
            </textvariant>
        </theme>
        <panel title="Kade Desktop" scope="shell" variant="shell_root" layout="dock" persistent_layout_id="kade_desktop_shell" gap={18} padding={18}>
            <panel title="Navigator" scope="shell" variant="sidebar" dock="left" split_ratio={0.22} min_width={240} max_width={360} resizable={true}>
                <inspector title="Projects">
                    <text role="title">{"M:\\Code\\Kain"}</text>
                    <text role="caption">{"1 sessions  |  recent Port Kade desktop shell"}</text>
                </inspector>
                <inspector title="Runtime">
                    <text role="caption">{"ui / runtime ready"}</text>
                    <text role="caption">{"actor / runtime ready"}</text>
                    <text role="caption">{"async / runtime ready"}</text>
                    <text role="caption">{"host / bridge ready"}</text>
                    <text role="caption">{"reflection ready"}</text>
                    <text role="caption">{"filesystem ready"}</text>
                    <text role="caption">{"process ready"}</text>
                    <text role="caption">{"network / http ready"}</text>
                </inspector>
            </panel>
            <panel title="Assistant" scope="shell" variant="stage" dock="center" gap={16}>
                <panel title="Session Overview" scope="shell" variant="workspace" layout="column" gap={10}>
                    <text role="caption">{"Native desktop assistant"}</text>
                    <text role="hero">{"Port Kade desktop shell"}</text>
                    <text role="body">{"Workspace-aware native desktop shell with provider routing, saved session context, and governed tool access."}</text>
                </panel>
                <panel title="Conversation" scope="shell" variant="workspace" layout="column" gap={12}>
                    <inspector title="Recent Sessions">
                    <text role="title">{"Port Kade desktop shell"}</text>
                    <text role="caption">{"openai_codex  |  1 message"}</text>
                    <text role="body">{"M:\\Code\\Kain"}</text>
                    <text role="caption">{"user: Build the manifest-driven native Kade desktop shell."}</text>
                    </inspector>
                </panel>
            </panel>
            <panel title="Workspace" scope="shell" variant="sidebar" dock="right" split_ratio={0.24} min_width={280} max_width={380} resizable={true}>
                <inspector title="Models">
                    <text role="title">{"OpenAI Codex"}</text>
                    <text role="caption">{"http  |  openai-compatible  |  tools on  |  streaming on"}</text>
                    <text role="caption">{"needs profile"}</text>
                    <text role="body">{"OpenRouter"}</text>
                    <text role="caption">{"http  |  router  |  tools on  |  streaming on"}</text>
                    <text role="caption">{"needs profile"}</text>
                    <text role="body">{"Local Ollama"}</text>
                    <text role="caption">{"http  |  local  |  tools off  |  streaming on"}</text>
                    <text role="caption">{"needs profile"}</text>
                </inspector>
                <inspector title="Quick Actions">
                    <text role="body">{"New Chat"}</text>
                    <text role="caption">{"session.create  |  titlebar"}</text>
                    <text role="body">{"Focus Input"}</text>
                    <text role="caption">{"composer.focus  |  titlebar"}</text>
                    <text role="body">{"History"}</text>
                    <text role="caption">{"session.history  |  titlebar"}</text>
                    <text role="body">{"Settings"}</text>
                    <text role="caption">{"app.settings  |  titlebar"}</text>
                    <text role="body">{"MCP"}</text>
                    <text role="caption">{"mcp.manage  |  titlebar"}</text>
                    <text role="body">{"Agents"}</text>
                    <text role="caption">{"agents.manage  |  titlebar"}</text>
                    <text role="body">{"Run Command"}</text>
                    <text role="caption">{"tool.terminal  |  composer"}</text>
                    <text role="body">{"Add Context"}</text>
                    <text role="caption">{"context.attach  |  composer"}</text>
                </inspector>
            </panel>
            <panel title="Access" scope="shell" variant="tray" dock="bottom" split_ratio={0.22} min_height={180} max_height={320} resizable={true}>
                <inspector title="Access Rules">
                    <text role="body">{"Read File"}</text>
                    <text role="caption">{"filesystem.read  |  approval workspace  |  effective ask"}</text>
                    <text role="muted">{"no scoped approvals saved"}</text>
                    <text role="body">{"Write File"}</text>
                    <text role="caption">{"filesystem.write  |  approval workspace  |  effective ask"}</text>
                    <text role="muted">{"no scoped approvals saved"}</text>
                    <text role="body">{"Search Workspace"}</text>
                    <text role="caption">{"workspace.search  |  approval workspace  |  effective ask"}</text>
                    <text role="muted">{"no scoped approvals saved"}</text>
                    <text role="body">{"Run Terminal"}</text>
                    <text role="caption">{"process.exec  |  approval explicit  |  effective ask"}</text>
                    <text role="muted">{"no scoped approvals saved"}</text>
                    <text role="body">{"Call HTTP API"}</text>
                    <text role="caption">{"network.http  |  approval profile  |  effective ask"}</text>
                    <text role="muted">{"no scoped approvals saved"}</text>
                    <text role="body">{"Manage MCP"}</text>
                    <text role="caption">{"mcp.control  |  approval workspace  |  effective ask"}</text>
                    <text role="muted">{"no scoped approvals saved"}</text>
                </inspector>
            </panel>
        </panel>
    </slot>
