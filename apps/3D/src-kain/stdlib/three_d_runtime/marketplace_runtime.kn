// Marketplace contracts for asset/plugin catalogs, entitlement-aware delivery, and channel promotions.

struct MarketplaceCatalogDescriptor:
    catalog_id: String
    catalog_scope: String
    publication_policy: String

struct MarketplaceEntitlementDescriptor:
    entitlement_id: String
    entitlement_scope: String
    license_policy: String

struct MarketplacePromotionDescriptor:
    promotion_id: String
    promotion_scope: String
    approval_policy: String

struct MarketplaceRuntimeProfile:
    catalog_runtime: MarketplaceCatalogDescriptor
    entitlement_runtime: MarketplaceEntitlementDescriptor
    promotion_runtime: MarketplacePromotionDescriptor

fn default_marketplace_runtime_profile() -> MarketplaceRuntimeProfile with Pure:
    let profile = MarketplaceRuntimeProfile()

    profile.catalog_runtime = MarketplaceCatalogDescriptor()
    profile.catalog_runtime.catalog_id = "marketplace_catalog_runtime"
    profile.catalog_runtime.catalog_scope = "assets_plugins_material_packs_tools_models_and_feature_bundles"
    profile.catalog_runtime.publication_policy = "schema_validated_curated_and_channel_registered"

    profile.entitlement_runtime = MarketplaceEntitlementDescriptor()
    profile.entitlement_runtime.entitlement_id = "marketplace_entitlement_runtime"
    profile.entitlement_runtime.entitlement_scope = "workspace_partner_public_and_license_bound_package_access"
    profile.entitlement_runtime.license_policy = "receipt_visible_approval_gated_and_runtime_enforced"

    profile.promotion_runtime = MarketplacePromotionDescriptor()
    profile.promotion_runtime.promotion_id = "marketplace_promotion_runtime"
    profile.promotion_runtime.promotion_scope = "draft_review_partner_and_public_release_channel_promotions"
    profile.promotion_runtime.approval_policy = "operator_signoff_audit_visible_and_rollout_safe"
    profile
