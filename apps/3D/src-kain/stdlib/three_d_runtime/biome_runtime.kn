// Terrain biome, ecosystem layering, and world synthesis contracts.

struct BiomeLayerDescriptor:
    biome_id: String
    climate_model: String
    scatter_policy: String
    residency_policy: String

struct BiomeGraphDescriptor:
    graph_id: String
    graph_kind: String
    tensor_pipeline_id: String
    output_domain: String

struct BiomeRuntimeProfile:
    biome_graph: BiomeGraphDescriptor
    ecosystem_graph: BiomeGraphDescriptor
    terrain_material_graph: BiomeGraphDescriptor
    primary_biome: BiomeLayerDescriptor

fn default_biome_graph(graph_id: String, graph_kind: String, output_domain: String) -> BiomeGraphDescriptor with Pure:
    let descriptor = BiomeGraphDescriptor()
    descriptor.graph_id = graph_id
    descriptor.graph_kind = graph_kind
    descriptor.tensor_pipeline_id = "biome_world_tensor_pipeline"
    descriptor.output_domain = output_domain
    descriptor

fn default_biome_runtime_profile() -> BiomeRuntimeProfile with Pure:
    let profile = BiomeRuntimeProfile()
    profile.biome_graph = default_biome_graph("biome_graph", "climate_distribution_graph", "terrain_tiles")
    profile.ecosystem_graph = default_biome_graph("ecosystem_graph", "ecosystem_distribution_graph", "instances")
    profile.terrain_material_graph = default_biome_graph("terrain_material_graph", "terrain_layer_graph", "materials")

    profile.primary_biome = BiomeLayerDescriptor()
    profile.primary_biome.biome_id = "temperate_forest"
    profile.primary_biome.climate_model = "height_moisture_temperature"
    profile.primary_biome.scatter_policy = "field_and_spline_driven"
    profile.primary_biome.residency_policy = "streaming_gpu_preferred"
    profile
