// Source-level scene declaration contracts for reusable authored 3D scenes, classes, mounts, and launch-ready scene documents.

struct SceneSourceDocumentDescriptor:
    document_id: String
    document_kind: String
    composition_policy: String

struct SceneClassDescriptor:
    class_id: String
    class_kind: String
    activation_policy: String

struct SceneMountDescriptor:
    mount_id: String
    mount_scope: String
    residency_policy: String

struct SceneSourceRuntimeProfile:
    source_document: SceneSourceDocumentDescriptor
    scene_class: SceneClassDescriptor
    scene_mount: SceneMountDescriptor

fn default_scene_source_runtime_profile() -> SceneSourceRuntimeProfile with Pure:
    let profile = SceneSourceRuntimeProfile()

    profile.source_document = SceneSourceDocumentDescriptor()
    profile.source_document.document_id = "universal_scene_source_document"
    profile.source_document.document_kind = "scene_classes_layers_variants_and_runtime_requirements"
    profile.source_document.composition_policy = "source_authored_manifest_registered_and_bundle_aware"

    profile.scene_class = SceneClassDescriptor()
    profile.scene_class.class_id = "universal_scene_class"
    profile.scene_class.class_kind = "editor_runtime_stage_and_delivery_shared_scene_class"
    profile.scene_class.activation_policy = "workspace_profile_launch_profile_and_delivery_graph_bound"

    profile.scene_mount = SceneMountDescriptor()
    profile.scene_mount.mount_id = "scene_source_mount"
    profile.scene_mount.mount_scope = "scene_asset_cache_widget_and_runtime_contract_mounts"
    profile.scene_mount.residency_policy = "streaming_cache_and_checkpoint_aware"
    profile
