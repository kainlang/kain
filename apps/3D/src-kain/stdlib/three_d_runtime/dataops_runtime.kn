// DataOps contracts for dataset registries, lineage, training corpora, and model-ops-ready 3D data workflows.

struct DatasetRegistryDescriptor:
    registry_id: String
    registry_scope: String
    classification_policy: String

struct DataLineageDescriptor:
    lineage_id: String
    lineage_scope: String
    provenance_policy: String

struct TrainingCorpusDescriptor:
    corpus_id: String
    corpus_scope: String
    governance_policy: String

struct DataOpsRuntimeProfile:
    dataset_registry: DatasetRegistryDescriptor
    data_lineage: DataLineageDescriptor
    training_corpus: TrainingCorpusDescriptor

fn default_dataops_runtime_profile() -> DataOpsRuntimeProfile with Pure:
    let profile = DataOpsRuntimeProfile()

    profile.dataset_registry = DatasetRegistryDescriptor()
    profile.dataset_registry.registry_id = "dataops_dataset_registry"
    profile.dataset_registry.registry_scope = "assets_scene_captures_annotations_telemetry_and_training_ready_collections"
    profile.dataset_registry.classification_policy = "semantic_tagged_residency_aware_and_governed"

    profile.data_lineage = DataLineageDescriptor()
    profile.data_lineage.lineage_id = "dataops_lineage_runtime"
    profile.data_lineage.lineage_scope = "source_transform_model_review_delivery_and_runtime_provenance_edges"
    profile.data_lineage.provenance_policy = "immutable_diffable_and_promotion_safe"

    profile.training_corpus = TrainingCorpusDescriptor()
    profile.training_corpus.corpus_id = "dataops_training_corpus_runtime"
    profile.training_corpus.corpus_scope = "synthetic_real_scan_semantic_and_operator_feedback_training_sets"
    profile.training_corpus.governance_policy = "privacy_bound_license_aware_and_evaluation_visible"
    profile
