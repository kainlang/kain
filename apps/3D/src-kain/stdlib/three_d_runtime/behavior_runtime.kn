// Behavior graph contracts for gameplay, tool logic, and authored runtime state machines.

struct BehaviorGraphDescriptor:
    graph_id: String
    graph_kind: String
    authority_lane: String
    tensor_pipeline_id: String

struct BehaviorStateRuntimeDescriptor:
    state_runtime_id: String
    event_policy: String
    sync_policy: String

struct BehaviorRuntimeProfile:
    tool_behavior_graph: BehaviorGraphDescriptor
    gameplay_behavior_graph: BehaviorGraphDescriptor
    automation_behavior_graph: BehaviorGraphDescriptor
    state_runtime: BehaviorStateRuntimeDescriptor

fn default_behavior_graph(graph_id: String, graph_kind: String, authority_lane: String) -> BehaviorGraphDescriptor with Pure:
    let descriptor = BehaviorGraphDescriptor()
    descriptor.graph_id = graph_id
    descriptor.graph_kind = graph_kind
    descriptor.authority_lane = authority_lane
    descriptor.tensor_pipeline_id = "behavior_runtime_tensor_pipeline"
    descriptor

fn default_behavior_runtime_profile() -> BehaviorRuntimeProfile with Pure:
    let profile = BehaviorRuntimeProfile()
    profile.tool_behavior_graph = default_behavior_graph("tool_behavior_graph", "editor_state_graph", "editor")
    profile.gameplay_behavior_graph = default_behavior_graph("gameplay_behavior_graph", "runtime_state_graph", "gameplay")
    profile.automation_behavior_graph = default_behavior_graph("automation_behavior_graph", "orchestration_graph", "orchestration")

    profile.state_runtime = BehaviorStateRuntimeDescriptor()
    profile.state_runtime.state_runtime_id = "behavior_state_runtime"
    profile.state_runtime.event_policy = "event_driven_and_tick"
    profile.state_runtime.sync_policy = "tensor_backed_and_replicable"
    profile
