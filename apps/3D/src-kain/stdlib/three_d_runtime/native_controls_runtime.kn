// Native control-family contracts for outliners, inspectors, timelines, trees, tables, and graph-adjacent editor widgets.

struct NativeControlDescriptor:
    control_id: String
    control_family: String
    focus_policy: String

struct NativeControlLayoutDescriptor:
    layout_id: String
    layout_kind: String
    routing_policy: String

struct NativeControlBindingDescriptor:
    binding_id: String
    binding_scope: String
    schema_policy: String

struct NativeControlsRuntimeProfile:
    control_family: NativeControlDescriptor
    layout_runtime: NativeControlLayoutDescriptor
    control_binding: NativeControlBindingDescriptor

fn default_native_controls_runtime_profile() -> NativeControlsRuntimeProfile with Pure:
    let profile = NativeControlsRuntimeProfile()

    profile.control_family = NativeControlDescriptor()
    profile.control_family.control_id = "native_editor_control_family"
    profile.control_family.control_family = "inspector_outliner_timeline_tree_table_graph_and_command_bar_controls"
    profile.control_family.focus_policy = "dock_modal_and_view_context_safe"

    profile.layout_runtime = NativeControlLayoutDescriptor()
    profile.layout_runtime.layout_id = "native_control_layout_runtime"
    profile.layout_runtime.layout_kind = "docked_overlay_and_multi_window_control_layouts"
    profile.layout_runtime.routing_policy = "workspace_layout_input_and_selection_aware"

    profile.control_binding = NativeControlBindingDescriptor()
    profile.control_binding.binding_id = "native_control_binding"
    profile.control_binding.binding_scope = "scene_object_schema_command_and_reflection_bound"
    profile.control_binding.schema_policy = "runtime_contract_and_widget_primitive_aligned"
    profile
