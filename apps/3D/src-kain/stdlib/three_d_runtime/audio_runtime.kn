// Audio graph, playback, spatialization, and analysis contracts.

struct AudioBusDescriptor:
    bus_id: String
    bus_kind: String
    routing_policy: String
    tensor_pipeline_id: String

struct SpatialAudioDescriptor:
    scene_binding: String
    occlusion_policy: String
    listener_policy: String

struct AudioRuntimeProfile:
    master_bus: AudioBusDescriptor
    diegetic_bus: AudioBusDescriptor
    analysis_bus: AudioBusDescriptor
    spatial_audio: SpatialAudioDescriptor

fn default_audio_bus(bus_id: String, bus_kind: String) -> AudioBusDescriptor with Pure:
    let descriptor = AudioBusDescriptor()
    descriptor.bus_id = bus_id
    descriptor.bus_kind = bus_kind
    descriptor.routing_policy = "graph_routed"
    descriptor.tensor_pipeline_id = "audio_analysis_tensor_pipeline"
    descriptor

fn default_audio_runtime_profile() -> AudioRuntimeProfile with Pure:
    let profile = AudioRuntimeProfile()
    profile.master_bus = default_audio_bus("master_bus", "mix_master")
    profile.diegetic_bus = default_audio_bus("diegetic_bus", "scene_audio")
    profile.analysis_bus = default_audio_bus("analysis_bus", "analysis_and_reactive")

    profile.spatial_audio = SpatialAudioDescriptor()
    profile.spatial_audio.scene_binding = "main_scene"
    profile.spatial_audio.occlusion_policy = "ray_or_field_query"
    profile.spatial_audio.listener_policy = "active_camera_or_runtime_listener"
    profile
