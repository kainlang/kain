// Capability policy, sandboxing, trust zones, and integration-governance contracts.

struct CapabilityDescriptor:
    capability_id: String
    capability_scope: String
    approval_policy: String

struct TrustZoneDescriptor:
    zone_id: String
    zone_kind: String
    ingress_policy: String

struct AuditDescriptor:
    audit_id: String
    audit_scope: String
    retention_policy: String

struct SecurityRuntimeProfile:
    capabilities: CapabilityDescriptor
    trust_zones: TrustZoneDescriptor
    audits: AuditDescriptor

fn default_security_runtime_profile() -> SecurityRuntimeProfile with Pure:
    let profile = SecurityRuntimeProfile()

    profile.capabilities = CapabilityDescriptor()
    profile.capabilities.capability_id = "runtime_capability_registry"
    profile.capabilities.capability_scope = "ffi_device_network_file_plugin_and_machine_operations"
    profile.capabilities.approval_policy = "workspace_stage_machine_and_release_gate_bound"

    profile.trust_zones = TrustZoneDescriptor()
    profile.trust_zones.zone_id = "runtime_trust_zones"
    profile.trust_zones.zone_kind = "local_session_remote_worker_and_external_bridge_zones"
    profile.trust_zones.ingress_policy = "schema_validated_signed_and_context_scoped"

    profile.audits = AuditDescriptor()
    profile.audits.audit_id = "security_audit_runtime"
    profile.audits.audit_scope = "capability_use_policy_violations_and_operator_actions"
    profile.audits.retention_policy = "review_database_delivery_and_compliance_export_bound"
    profile
