// SPIR-V review overlay and annotation raster seed.

shader compute review_annotation_raster(id: UVec3) -> Vec4:
    uniform frame_annotations: StorageBuffer<Vec4> @0
    uniform scene_annotations: StorageBuffer<Vec4> @1
    uniform review_capture_state: StorageBuffer<Vec4> @2
    uniform annotation_overlay: StorageBuffer<Vec4> @3
    let annotation_index = id.x
    let frame = frame_annotations[annotation_index]
    let scene = scene_annotations[annotation_index]
    let capture = review_capture_state[annotation_index]
    let output = vec4(
        frame.x + capture.x,
        scene.y + capture.y,
        frame.z + scene.z + capture.z,
        1.0
    )
    annotation_overlay[annotation_index] = output
    return output
