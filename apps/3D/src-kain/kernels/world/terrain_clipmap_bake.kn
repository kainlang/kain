// SPIR-V terrain clipmap bake seed.

shader compute terrain_clipmap_bake(id: UVec3) -> Vec4:
    uniform height_tiles: StorageBuffer<Vec4> @0
    uniform splat_tiles: StorageBuffer<Vec4> @1
    uniform clipmap_region: StorageBuffer<Vec4> @2
    uniform terrain_lod_tiles: StorageBuffer<Vec4> @3
    let tile_index = id.y * 2048 + id.x
    let height = height_tiles[tile_index]
    let splat = splat_tiles[tile_index]
    let region = clipmap_region[tile_index]
    let output = vec4(
        height.x + splat.x * 0.1,
        height.y + region.y * 0.05,
        height.z + splat.z * 0.1,
        1.0
    )
    terrain_lod_tiles[tile_index] = output
    return output
