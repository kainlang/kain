// SPIR-V sculpt deformation pass seed.

shader compute sculpt_brush_tensor(id: UVec3) -> Vec4:
    uniform vertex_positions: StorageBuffer<Vec4> @0
    uniform vertex_normals: StorageBuffer<Vec4> @1
    uniform brush_tensor: StorageBuffer<Vec4> @2
    uniform deformed_positions: StorageBuffer<Vec4> @3
    let vertex_index = id.x
    let position = vertex_positions[vertex_index]
    let normal = vertex_normals[vertex_index]
    let brush = brush_tensor[vertex_index]
    let output = vec4(
        position.x + normal.x * brush.x,
        position.y + normal.y * brush.x,
        position.z + normal.z * brush.x,
        1.0
    )
    deformed_positions[vertex_index] = output
    return output
