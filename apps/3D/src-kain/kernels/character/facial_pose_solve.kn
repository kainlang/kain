// SPIR-V character facial solve seed.

shader compute facial_pose_solve(id: UVec3) -> Vec4:
    uniform facial_control_tensor: StorageBuffer<Vec4> @0
    uniform corrective_weights: StorageBuffer<Vec4> @1
    uniform wrinkle_mask_tensor: StorageBuffer<Vec4> @2
    uniform facial_pose_tensor: StorageBuffer<Vec4> @3
    let vertex_index = id.x
    let controls = facial_control_tensor[vertex_index]
    let correctives = corrective_weights[vertex_index]
    let wrinkle = wrinkle_mask_tensor[vertex_index]
    let output = vec4(
        controls.x + correctives.x,
        controls.y + correctives.y,
        controls.z + wrinkle.z,
        1.0
    )
    facial_pose_tensor[vertex_index] = output
    return output
