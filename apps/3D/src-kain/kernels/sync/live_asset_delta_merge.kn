// SPIR-V live asset delta merge seed.

shader compute live_asset_delta_merge(id: UVec3) -> Vec4:
    uniform local_asset_state: StorageBuffer<Vec4> @0
    uniform remote_asset_state: StorageBuffer<Vec4> @1
    uniform sync_policy_state: StorageBuffer<Vec4> @2
    uniform merged_asset_state: StorageBuffer<Vec4> @3
    let asset_index = id.x
    let local_state = local_asset_state[asset_index]
    let remote_state = remote_asset_state[asset_index]
    let policy = sync_policy_state[0]
    let output = vec4(
        local_state.x + remote_state.x,
        local_state.y + policy.y,
        remote_state.z + policy.z,
        1.0
    )
    merged_asset_state[asset_index] = output
    return output
