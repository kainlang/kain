// SPIR-V robotics kinematics and toolpath seed.

shader compute toolpath_kinematics_resolve(id: UVec3) -> Vec4:
    uniform machine_joints: StorageBuffer<Vec4> @0
    uniform toolpath_segments: StorageBuffer<Vec4> @1
    uniform machine_limits: StorageBuffer<Vec4> @2
    uniform resolved_toolpath_motion: StorageBuffer<Vec4> @3
    let segment_index = id.x
    let joints = machine_joints[segment_index]
    let toolpath = toolpath_segments[segment_index]
    let limits = machine_limits[0]
    let output = vec4(
        joints.x + toolpath.x,
        joints.y + limits.y,
        toolpath.z + limits.z,
        1.0
    )
    resolved_toolpath_motion[segment_index] = output
    return output
