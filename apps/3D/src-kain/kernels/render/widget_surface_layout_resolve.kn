// SPIR-V native widget layout and overlay composition seed.

shader compute widget_surface_layout_resolve(id: UVec3) -> Vec4:
    uniform widget_layout_nodes: StorageBuffer<Vec4> @0
    uniform viewport_overlay_nodes: StorageBuffer<Vec4> @1
    uniform binding_nodes: StorageBuffer<Vec4> @2
    uniform composed_widget_layout: StorageBuffer<Vec4> @3
    let record_index = id.x
    let layout_node = widget_layout_nodes[record_index]
    let overlay_node = viewport_overlay_nodes[record_index]
    let binding_node = binding_nodes[record_index]
    let output = vec4(
        layout_node.x + overlay_node.x,
        layout_node.y + binding_node.y,
        overlay_node.z + binding_node.z,
        1.0
    )
    composed_widget_layout[record_index] = output
    return output
