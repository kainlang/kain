// SPIR-V seed for script host scheduling, script capability validation, and execution packet planning.

kernel script_host_schedule_resolve:
    stage = "compute"
    domain = "scripting"
    dispatch = [64, 1, 1]

    input script_jobs: Tensor
    input capability_policies: Tensor
    input script_bindings: Tensor
    input runtime_events: Tensor

    output resolved_script_schedule: Tensor
    output script_execution_packets: Tensor
