{
  "id": "kain_canvas_forge",
  "name": "Kain Canvas Forge",
  "tagline": "Paint, stage, ink, and compose with a Node-first studio shell.",
  "summary": "Desktop-ready illustration and 3D composition workstation scaffold inspired by paint-heavy and manga-heavy studio layouts.",
  "output_root": "outputs",
  "default_workspace_id": "paint_lab",
  "document": {
    "name": "chapter_ink_keyart",
    "width": 1600,
    "height": 900,
    "dpi": 300,
    "background": "#f4efe6"
  },
  "theme": {
    "shell": "#121318",
    "panel": "#1b1f27",
    "panel_alt": "#242a35",
    "outline": "#394152",
    "text": "#f5f2eb",
    "muted": "#a8b0bf",
    "accent": "#ff8f3f",
    "accent_soft": "#ffd18c",
    "canvas_backdrop": "#ddd1bb",
    "viewport_backdrop": "#0d1118"
  },
  "client_bundle": {
    "enabled": true,
    "entry": "helpers/client/main.tsx",
    "out_dir": "client",
    "out_file": "canvas-forge.bundle.js",
    "format": "esm",
    "target": "es2022",
    "minify": false
  },
  "desktop": {
    "title": "Kain Canvas Forge",
    "width": 1680,
    "height": 1020,
    "min_width": 1280,
    "min_height": 760,
    "background_color": "#121318"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 4178
  },
  "registries": {
    "workspaces": "manifests/workspaces.json",
    "tools": "manifests/tool_catalog.json",
    "brushes": "manifests/brushes.json",
    "panels": "manifests/panel_layout.json",
    "scenes": "manifests/scene_library.json"
  }
}

