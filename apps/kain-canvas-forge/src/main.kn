use std::javascript::bridge

fn studio_runtime() -> Any:
    return js_bridge_import("./helpers/studio_runtime.mjs")

fn output_path(name: String) -> String:
    return "outputs/" + name

fn main() -> String:
    let runtime = studio_runtime()
    let summary = js_bridge_call_method(runtime, "buildApp", ["."])

    let report = "Kain Canvas Forge build\n"
    let report = report + "app: " + summary.name + "\n"
    let report = report + "workspace_count: " + str(summary.workspace_count) + "\n"
    let report = report + "tool_count: " + str(summary.tool_count) + "\n"
    let report = report + "brush_count: " + str(summary.brush_count) + "\n"
    let report = report + "scene_count: " + str(summary.scene_count) + "\n"
    let report = report + "output_root: " + summary.output_root + "\n"
    let report = report + "client_bundle: " + summary.client_bundle + "\n"
    let report = report + "desktop_entry: " + summary.desktop_entry + "\n"

    write_file(output_path("kain_canvas_forge_build.txt"), report)
    println(report)
    return report

