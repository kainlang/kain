struct ResourceDescriptor:
    uri: String
    kind: String
    producer_intent: String
    version: Int
    status: String
    summary: String

fn default_resources() -> Array<ResourceDescriptor>:
    return [
        ResourceDescriptor {
            uri: "mesh://scene/main/entity/cube_01",
            kind: "shared_buffer",
            producer_intent: "project.bootstrap",
            version: 1,
            status: "ready",
            summary: "Primary scene mesh stream."
        },
        ResourceDescriptor {
            uri: "buffer://preview/source",
            kind: "shared_buffer",
            producer_intent: "project.bootstrap",
            version: 1,
            status: "ready",
            summary: "Source preview buffer."
        },
        ResourceDescriptor {
            uri: "buffer://preview/destination",
            kind: "shared_buffer",
            producer_intent: "preview.rebake",
            version: 1,
            status: "ready",
            summary: "Destination preview buffer."
        },
        ResourceDescriptor {
            uri: "image://preview/baked",
            kind: "shared_image",
            producer_intent: "preview.rebake",
            version: 1,
            status: "ready",
            summary: "Baked preview image."
        },
        ResourceDescriptor {
            uri: "buffer://brush/latest_stamp",
            kind: "shared_buffer",
            producer_intent: "mesh.brush_apply",
            version: 1,
            status: "ready",
            summary: "Latest brush snapshot."
        }
    ]
