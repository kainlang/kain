{
  "schema_version": 1,
  "intents": [
    {
      "id": "project.bootstrap",
      "label": "Project Bootstrap",
      "summary": "Runs the full seed pipeline to establish the first live project/session state.",
      "graph": "fabric/intents/project_bootstrap.fabric.toml",
      "entry_commands": [
        "project.bootstrap"
      ],
      "inputs_from": [
        "app_manifest",
        "session",
        "resources"
      ],
      "produces": [
        "mesh://scene/main/entity/cube_01",
        "buffer://preview/source",
        "buffer://preview/destination",
        "image://preview/baked"
      ],
      "reports": [
        "report://scene/current",
        "report://topology/current",
        "artifact://publish/summary"
      ],
      "invalidation": [
        "preview",
        "topology",
        "publish_summary"
      ],
      "debounce_ms": 0
    },
    {
      "id": "mesh.brush_apply",
      "label": "Brush Apply",
      "summary": "Runs the native brush lane and refreshes the brush snapshot resource.",
      "graph": "fabric/intents/brush_apply.fabric.toml",
      "entry_commands": [
        "mesh.apply_brush"
      ],
      "inputs_from": [
        "session",
        "resources"
      ],
      "produces": [
        "buffer://brush/latest_stamp"
      ],
      "reports": [],
      "invalidation": [
        "preview",
        "topology",
        "publish_summary"
      ],
      "debounce_ms": 0
    },
    {
      "id": "preview.rebake",
      "label": "Preview Rebake",
      "summary": "Recomputes the shared preview buffers and baked preview image.",
      "graph": "fabric/intents/preview_rebake.fabric.toml",
      "entry_commands": [
        "preview.rebake",
        "workspace.switch_mode"
      ],
      "inputs_from": [
        "session",
        "resources"
      ],
      "produces": [
        "buffer://preview/destination",
        "image://preview/baked"
      ],
      "reports": [],
      "invalidation": [
        "preview"
      ],
      "debounce_ms": 16
    },
    {
      "id": "analysis.topology_refresh",
      "label": "Topology Refresh",
      "summary": "Rebuilds the topology report after mesh or brush changes.",
      "graph": "fabric/intents/topology_refresh.fabric.toml",
      "entry_commands": [
        "analysis.refresh_topology",
        "mesh.apply_brush"
      ],
      "inputs_from": [
        "session",
        "resources",
        "reports"
      ],
      "produces": [],
      "reports": [
        "report://topology/current"
      ],
      "invalidation": [
        "topology"
      ],
      "debounce_ms": 120
    },
    {
      "id": "publish.summary_refresh",
      "label": "Publish Summary Refresh",
      "summary": "Updates the operator-facing publish summary from the latest resources and reports.",
      "graph": "fabric/intents/publish_summary.fabric.toml",
      "entry_commands": [
        "publish.refresh_summary"
      ],
      "inputs_from": [
        "session",
        "resources",
        "reports"
      ],
      "produces": [
        "artifact://publish/summary"
      ],
      "reports": [
        "artifact://publish/summary"
      ],
      "invalidation": [
        "publish_summary"
      ],
      "debounce_ms": 0
    }
  ]
}
