use rust::fabric_modeler_runtime
use std::interop::bridge

fn main() -> String:
    let mesh_stream = fabric_inputs.model_seed.mesh_stream
    let mesh_info = interop_shared_buffer_info(mesh_stream)
    let mesh_bytes = interop_shared_buffer_bytes(mesh_stream)
    let checksum = mesh_checksum(mesh_bytes)
    return topology_report(
        mesh_info.byte_length,
        checksum,
        fabric_inputs.model_seed.scene_report,
        fabric_inputs.native_brush.signature,
    )
