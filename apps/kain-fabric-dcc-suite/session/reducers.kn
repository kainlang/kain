struct ReducerOutcome:
    next_workspace_mode: String
    next_active_tool: String
    status_banner: String
    asset_dirty: Bool
    sculpt_dirty: Bool
    topology_dirty: Bool
    material_dirty: Bool
    rig_dirty: Bool
    animation_dirty: Bool
    simulation_dirty: Bool
    render_dirty: Bool
    compositor_dirty: Bool
    publish_dirty: Bool
    tensor_dirty: Bool
    queued_intents: Array<String>
    session_needs_save: Bool

fn reduce_command(command_kind: String, payload_summary: String, current_tool: String, current_mode: String) -> ReducerOutcome:
    if command_kind == "workspace.switch_mode":
        return ReducerOutcome {
            next_workspace_mode: payload_summary,
            next_active_tool: current_tool,
            status_banner: "workspace mode updated",
            asset_dirty: false,
            sculpt_dirty: false,
            topology_dirty: false,
            material_dirty: false,
            rig_dirty: false,
            animation_dirty: false,
            simulation_dirty: false,
            render_dirty: true,
            compositor_dirty: false,
            publish_dirty: false,
            tensor_dirty: false,
            queued_intents: ["render.preview"],
            session_needs_save: true
        }
