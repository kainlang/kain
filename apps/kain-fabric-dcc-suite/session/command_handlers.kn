fn lookup_handler(command_kind: String) -> CommandHandlerDescriptor:
    let handlers = command_handlers()
    let index = 0
    while index < len(handlers):
        let handler = handlers[index]
        if handler.command_kind == command_kind:
            return handler
        index = index + 1
    return CommandHandlerDescriptor {
        command_kind: command_kind,
        reducer_owner: "session.reducers",
        planner_owner: "session.intent_planner",
        immediate_effect: "no registered handler"
    }
