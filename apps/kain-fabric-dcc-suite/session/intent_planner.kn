struct PlannedIntent:
    intent_id: String
    reason: String
    priority: Int
    debounce_ms: Int

struct IntentPlan:
    command_kind: String
    intents: Array<PlannedIntent>

fn plan_for_command(
    command_kind: String,
    asset_dirty: Bool,
    topology_dirty: Bool,
    material_dirty: Bool,
    rig_dirty: Bool,
    simulation_dirty: Bool,
    render_dirty: Bool,
    compositor_dirty: Bool,
    publish_dirty: Bool,
    tensor_dirty: Bool
) -> IntentPlan:
    if command_kind == "project.bootstrap":
        return IntentPlan {
            command_kind: command_kind,
            intents: [
                PlannedIntent {
                    intent_id: "project.bootstrap",
                    reason: "bootstrap requested",
                    priority: 100,
                    debounce_ms: 0
                }
            ]
        }
    let intents = []
    if command_kind == "scene.open_document":
        intents.push(PlannedIntent {
            intent_id: "scene.open_document",
            reason: "scene document changed and the scene/query/evaluation lanes must refresh",
            priority: 95,
            debounce_ms: 0
        })
    if command_kind == "mesh.open_document":
        intents.push(PlannedIntent {
            intent_id: "mesh.open_document",
            reason: "mesh document selection changed and the active mesh contract must refresh",
            priority: 94,
            debounce_ms: 0
        })
    if command_kind == "mesh.set_edit_target":
        intents.push(PlannedIntent {
            intent_id: "mesh.set_edit_target",
            reason: "mesh edit target changed and the current authoring context must rebind",
            priority: 93,
            debounce_ms: 0
        })
    if command_kind == "mesh.set_authoring_policy":
        intents.push(PlannedIntent {
            intent_id: "mesh.set_authoring_policy",
            reason: "mesh authoring policy changed between imports, primitives, and topology outputs",
            priority: 92,
            debounce_ms: 0
        })
    if command_kind == "mesh.create_primitive":
        intents.push(PlannedIntent {
            intent_id: "mesh.create_primitive",
            reason: "primitive authoring requested a new app-owned mesh document",
            priority: 96,
            debounce_ms: 0
        })
    if command_kind == "mesh.import_asset":
        intents.push(PlannedIntent {
            intent_id: "mesh.import_asset",
            reason: "mesh import requested promotion of an external asset into the app-owned mesh contract",
            priority: 97,
            debounce_ms: 0
        })
    if command_kind == "mesh.edit_topology":
        intents.push(PlannedIntent {
            intent_id: "mesh.edit_topology",
            reason: "topology edit requested against the active mesh resource",
            priority: 95,
            debounce_ms: 0
        })
    if command_kind == "mesh.rebuild_topology":
        intents.push(PlannedIntent {
            intent_id: "mesh.rebuild_topology",
            reason: "mesh topology resources need a dedicated rebuild pass",
            priority: 91,
            debounce_ms: 0
        })
    if command_kind == "selection.set_scope":
        intents.push(PlannedIntent {
            intent_id: "selection.set_scope",
            reason: "selection scope changed and related scene query state must refresh",
            priority: 88,
            debounce_ms: 0
        })
    if command_kind == "persistence.snapshot":
        intents.push(PlannedIntent {
            intent_id: "persistence.snapshot",
            reason: "session state needs a durable snapshot",
            priority: 62,
            debounce_ms: 0
        })
    if command_kind == "replay.capture":
        intents.push(PlannedIntent {
            intent_id: "replay.capture",
            reason: "replay capture requested for branch review or repro",
            priority: 68,
            debounce_ms: 0
        })
    if command_kind == "evaluation.recompute_graph":
        intents.push(PlannedIntent {
            intent_id: "evaluation.recompute_graph",
            reason: "evaluation graph requested a recompute",
            priority: 66,
            debounce_ms: 0
        })
    if asset_dirty:
        intents.push(PlannedIntent {
            intent_id: "asset.ingest_package",
            reason: "asset ingest state is dirty",
            priority: 90,
            debounce_ms: 0
        })
    if command_kind == "sculpt.apply_stroke":
        intents.push(PlannedIntent {
            intent_id: "sculpt.apply_stroke",
            reason: "native sculpt seam requested",
            priority: 95,
            debounce_ms: 0
        })
    if topology_dirty:
        intents.push(PlannedIntent {
            intent_id: "topology.rebuild",
            reason: "topology state is dirty",
            priority: 80,
            debounce_ms: 32
        })
    if rig_dirty:
        intents.push(PlannedIntent {
            intent_id: "rig.sync_controls",
            reason: "rig state is dirty",
            priority: 72,
            debounce_ms: 24
        })
    if simulation_dirty:
        intents.push(PlannedIntent {
            intent_id: "sim.tick",
            reason: "simulation state is dirty",
            priority: 64,
            debounce_ms: 16
        })
    if material_dirty:
        let material_intent_id = "material.bake_preview"
        let material_reason = "material preview state is dirty"
        let material_priority = 70
        if command_kind == "material.author_texture_set":
            material_reason = "texture set membership or bake preset changed"
        if command_kind == "material.paint_layer":
            material_reason = "layer stack changed and preview textures must refresh"
        if command_kind == "material.edit_svg_mask":
            material_reason = "svg mask stack changed and preview textures must refresh"
        if command_kind == "material.export_textures":
            material_intent_id = "material.export_textures"
            material_reason = "texture export requested from current material contract"
            material_priority = 74
        intents.push(PlannedIntent {
            intent_id: material_intent_id,
            reason: material_reason,
            priority: material_priority,
            debounce_ms: 16
        })
    if render_dirty:
        intents.push(PlannedIntent {
            intent_id: "render.preview",
            reason: "render preview needs refresh",
            priority: 60,
            debounce_ms: 16
        })
    if compositor_dirty:
        intents.push(PlannedIntent {
            intent_id: "compositor.rebuild",
            reason: "compositor stack depends on stale products",
            priority: 48,
            debounce_ms: 48
        })
    if publish_dirty:
        intents.push(PlannedIntent {
            intent_id: "publish.package",
            reason: "publish surfaces depend on new results",
            priority: 40,
            debounce_ms: 0
        })
    if tensor_dirty:
        let tensor_intent = "tensor.infer_step"
        if command_kind == "tensor.train_step":
            tensor_intent = "tensor.train_step"
        intents.push(PlannedIntent {
            intent_id: tensor_intent,
            reason: "tensor lane requested a readiness or planning update",
            priority: 55,
            debounce_ms: 0
        })
    return IntentPlan {
        command_kind: command_kind,
        intents: intents
    }
