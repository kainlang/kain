fn lookup_ui_workbench(mode_id: String) -> UiWorkbenchDescriptor:
    let workbenches = default_ui_workbenches()
    let index = 0
    while index < len(workbenches):
        let workbench = workbenches[index]
        if workbench.mode_id == mode_id:
            return workbench
        index = index + 1
    return UiWorkbenchDescriptor {
        mode_id: mode_id,
        tab_label: "Workspace",
        title: "Fallback Workbench",
        hero_title: "Fallback workbench",
        hero_summary: "No authored workbench descriptor was found for this workspace.",
        focus_surface: "viewport_stage",
        featured_tools: [],
        quick_commands: [],
        center_surfaces: [],
        left_surfaces: [],
        right_surfaces: [],
        bottom_surfaces: [],
        intent_ids: []
    }
 }
t_ids: []
    }
 }
ds: []
    }
 }
