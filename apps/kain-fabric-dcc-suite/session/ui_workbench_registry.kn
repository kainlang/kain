struct UiWorkbenchDescriptor:
    mode_id: String
    tab_label: String
    title: String
    hero_title: String
    hero_summary: String
    focus_surface: String
    featured_tools: Array<String>
    quick_commands: Array<String>
    center_surfaces: Array<String>
    right_surfaces: Array<String>
    bottom_surfaces: Array<String>
    intent_ids: Array<String>

