        },
        animation: AnimationState {
            active_clip_id: "clip/blocking_pass_a",
            frame: 96,
            playback_mode: "paused"
        },
        simulation: SimulationState {
            cache_profile: "sim_preview_cache",
            last_tick_frame: 96,
            solver_profile: "cloth_preview"
        },
        render: RenderState {
            camera_id: "camera/shot_main",
