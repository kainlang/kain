            focus_surface: "rig_graph",
            summary: "Rig controls, clips, and deformation review"
        },
        WorkspaceDescriptor {
            id: "sim_fx",
            label: "Simulation And FX",
            focus_surface: "simulation_board",
            summary: "Caches, solvers, and replay diagnostics"
        },
        WorkspaceDescriptor {
