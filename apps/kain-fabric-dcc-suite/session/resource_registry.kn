struct ResourceDescriptor:
    id: String
    resource_uri: String
    kind: String
    producer_step: String
    summary: String

fn default_resources() -> Array<ResourceDescriptor>:
    return [
        ResourceDescriptor {
            id: "scene_graph_document",
            resource_uri: "scene://current/graph",
            kind: "value",
            producer_step: "dcc_suite_seed",
            summary: "Scene graph bootstrap document"
        },
        ResourceDescriptor {
            id: "scene_selection_context_document",
            resource_uri: "scene://current/selection",
            kind: "value",
            producer_step: "dcc_suite_seed",
            summary: "Live selection context for viewport and inspector routing"
        },
        ResourceDescriptor {
            id: "asset_catalog_document",
            resource_uri: "asset://catalog/current",
            kind: "value",
            producer_step: "dcc_suite_seed",
            summary: "Asset ingest and package catalog"
        },
        ResourceDescriptor {
            id: "asset_source_manifest_document",
            resource_uri: "asset://sources/current",
            kind: "value",
            producer_step: "asset.ingest_package",
            summary: "Source-id-first manifest for imported asset packages, source URIs, and transcode profile selection"
        },
        ResourceDescriptor {
            id: "mesh_resource_contract_document",
            resource_uri: "mesh://contract/current",
            kind: "value",
            producer_step: "dcc_suite_seed",
            summary: "Durable app-owned mesh resource contract describing imported payloads, authored primitives, active edit targets, and topology outputs; see config/mesh_resource_contract.json"
        },
        ResourceDescriptor {
            id: "imported_mesh_payload_document",
            resource_uri: "mesh://imports/current/payloads",
            kind: "value",
            producer_step: "mesh_import_projection",
            summary: "Imported mesh payload manifest for app-owned ingest targets and retained source payloads; see config/mesh_resource_contract.json for durable ids"
        },
        ResourceDescriptor {
            id: "authored_primitive_definition_document",
            resource_uri: "mesh://primitives/authored/definitions",
            kind: "value",
            producer_step: "primitive_mesh_authoring",
            summary: "App-authored primitive mesh definitions, including the startup cube and future procedural primitives; see config/mesh_resource_contract.json"
        },
        ResourceDescriptor {
            id: "active_editable_mesh_document",
            resource_uri: "mesh://editing/active",
            kind: "value",
            producer_step: "mesh_edit_session",
            summary: "Current editable mesh target that imported assets and primitive edits resolve into; this is the shared edit target seam"
        },
        ResourceDescriptor {
            id: "topology_output_mesh_document",
            resource_uri: "mesh://topology/output/current",
            kind: "value",
            producer_step: "topology_rebuild_projection",
            summary: "Topology rebuild output contract for mesh edit passes and downstream consumers; topology returns replacement mesh ids"
        },
        ResourceDescriptor {
            id: "topology_history_mesh_document",
            resource_uri: "mesh://topology/history/current",
            kind: "value",
            producer_step: "topology_history_projection",
            summary: "Durable topology history contract that retains authored topology decisions and replacement lineage"
        },
        ResourceDescriptor {
            id: "evaluation_graph_document",
            resource_uri: "graph://evaluation/current",
            kind: "value",
            producer_step: "dcc_suite_seed",
            summary: "Scene evaluation graph contract for dirty propagation and dependency scheduling"
        },
        ResourceDescriptor {
            id: "persistence_snapshot_document",
            resource_uri: "session://current/snapshot",
            kind: "value",
            producer_step: "dcc_suite_seed",
            summary: "Workspace persistence snapshot and recovery state"
        },
        ResourceDescriptor {
            id: "replay_capture_document",
            resource_uri: "replay://current/capture",
            kind: "value",
            producer_step: "dcc_suite_seed",
            summary: "Deterministic replay capture and scrub bundle"
        },
        ResourceDescriptor {
            id: "material_authoring_document",
            resource_uri: "material://current/authoring-contract",
            kind: "value",
            producer_step: "dcc_suite_seed",
            summary: "PBR texture-set, layer-stack, and export contract"
        },
        ResourceDescriptor {
            id: "svg_mask_document",
            resource_uri: "svg://material/current-mask-stack",
            kind: "value",
            producer_step: "dcc_suite_seed",
            summary: "SVG mask stack document for vector decals and trim motifs"
        },
        ResourceDescriptor {
            id: "preview_source_buffer",
            resource_uri: "buffer://preview/source",
            kind: "shared_buffer",
            producer_step: "dcc_suite_seed",
            summary: "Material preview source buffer"
        },
        ResourceDescriptor {
            id: "preview_destination_buffer",
            resource_uri: "buffer://preview/destination",
            kind: "shared_buffer",
            producer_step: "gpu_material_preview",
            summary: "Material preview destination buffer"
        },
        ResourceDescriptor {
            id: "preview_image",
            resource_uri: "image://preview/current",
            kind: "shared_image",
            producer_step: "dcc_suite_seed",
            summary: "Viewport preview image"
        },
        ResourceDescriptor {
            id: "tensor_features",
            resource_uri: "buffer://tensor/features",
            kind: "shared_buffer",
            producer_step: "dcc_suite_seed",
            summary: "Tensor planning feature buffer"
        },
        ResourceDescriptor {
            id: "tensor_training_corpus",
            resource_uri: "dataset://tensor/training-corpus",
            kind: "value",
            producer_step: "python_suite_bootstrap",
            summary: "Tensor training corpus contract seeded from the authored project settings"
        },
        ResourceDescriptor {
            id: "tensor_model_checkpoint",
            resource_uri: "artifact://tensor/model-checkpoint",
            kind: "value",
            producer_step: "tensor_train_stage",
            summary: "Tensor checkpoint contract for the current preview model"
        },
        ResourceDescriptor {
            id: "tensor_inference_output",
            resource_uri: "buffer://tensor/inference/output",
            kind: "shared_buffer",
            producer_step: "tensor_infer_stage",
            summary: "Tensor inference output buffer"
        },
        ResourceDescriptor {
            id: "sculpt_heightfield_source",
            resource_uri: "buffer://sculpt/heightfield-source",
            kind: "shared_buffer",
            producer_step: "dcc_suite_seed",
            summary: "Seeded GPU sculpt heightfield source buffer"
        },
        ResourceDescriptor {
            id: "sculpt_brush_params",
            resource_uri: "buffer://sculpt/brush-params",
            kind: "shared_buffer",
            producer_step: "dcc_suite_seed",
            summary: "GPU sculpt brush parameter buffer"
        },
        ResourceDescriptor {
            id: "sculpt_delta",
            resource_uri: "buffer://sculpt/delta",
            kind: "shared_buffer",
            producer_step: "gpu_sculpt_displacement",
            summary: "Latest GPU sculpt displacement payload"
        },
        ResourceDescriptor {
            id: "material_export_bundle",
            resource_uri: "artifact://material/export-bundle",
            kind: "value",
            producer_step: "material_texture_export_projection",
            summary: "Packed material export bundle descriptor"
        },
        ResourceDescriptor {
            id: "rig_control_state_document",
            resource_uri: "rig://control/current",
            kind: "value",
            producer_step: "rig_sync_projection",
            summary: "App-owned rig control state document that tracks control targets and pose readiness; see config/rig_resource_contract.json"
        },
        ResourceDescriptor {
            id: "rig_deformation_output_document",
            resource_uri: "rig://deformation/output/current",
            kind: "value",
            producer_step: "rig_sync_projection",
            summary: "App-owned rig deformation output document for solved transforms and downstream consumers; see config/rig_resource_contract.json"
        },
        ResourceDescriptor {
            id: "rig_solver_bridge_document",
            resource_uri: "rig://solver/bridge/current",
            kind: "value",
            producer_step: "rig_sync_projection",
            summary: "Extension seam document for the external solver adapter expected to own IK and bone evaluation; see config/rig_resource_contract.json"
        }
    ]
}
