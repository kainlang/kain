struct WorkspaceReadModel:
    active_mode: String
    focus_surface: String
    viewport_mode: String
    viewport_overlay_policy: String
    viewport_mode_count: Int
    viewport_mode_summary: String
    viewport_mode_registry_summary: String
    viewport_mode_registry_entries: Array<String>
    operator_summary: String
    dirty_lanes: Array<String>
    runtime_lane_count: Int
    runtime_lane_summary: String
    runtime_lane_registry_summary: String
    runtime_lane_registry_entries: Array<String>
    power_lane_count: Int
    power_lane_summary: String
    power_lane_registry_entries: Array<String>
    runtime_pack_count: Int
    runtime_pack_summary: String
    runtime_pack_registry_entries: Array<String>
    fabric_intent_count: Int
    fabric_intent_summary: String
    fabric_intent_registry_entries: Array<String>
    command_count: Int
    command_summary: String
    command_registry_entries: Array<String>
    asset_pipeline_summary: String
    asset_pipeline_source_id: String
    asset_pipeline_session_route_scope: String
    asset_pipeline_source_priority: String
    asset_pipeline_transcode_profiles: Array<String>
    asset_pipeline_routed_runtime_ids: Array<String>
    asset_pipeline_lineage_receipts: Array<String>
    asset_pipeline_registry_entries: Array<String>
    evaluation_summary: String
    cache_summary: String

struct PipelineHealthReadModel:
    severity: String
    summary: String

struct WorkbenchReadModel:
    active_workbench_id: String
    active_tab_group_id: String
    active_dock_id: String
    active_pane_id: String
    materialized_shell_path: String
    runtime_snapshot_path: String
    summary: String

struct AssistContextReadModel:
    profile: String
    summary: String
    tensor_signal: String
    layout_hint: String

fn derive_workspace_read_model(active_mode: String, active_tool: String, selection_count: Int, viewport_mode: String, viewport_overlay_policy: String, viewport_mode_count: Int, viewport_mode_summary: String, viewport_mode_registry_summary: String, viewport_mode_registry_entries: Array<String>, publish_dirty: Bool, tensor_dirty: Bool, runtime_lane_count: Int, runtime_lane_summary: String, runtime_lane_registry_summary: String, runtime_lane_registry_entries: Array<String>, power_lane_count: Int, power_lane_summary: String, power_lane_registry_entries: Array<String>, runtime_pack_count: Int, runtime_pack_summary: String, runtime_pack_registry_entries: Array<String>, fabric_intent_count: Int, fabric_intent_summary: String, fabric_intent_registry_entries: Array<String>, command_count: Int, command_summary: String, command_registry_entries: Array<String>, asset_pipeline_summary: String, asset_pipeline_source_id: String, asset_pipeline_session_route_scope: String, asset_pipeline_source_priority: String, asset_pipeline_transcode_profiles: Array<String>, asset_pipeline_routed_runtime_ids: Array<String>, asset_pipeline_lineage_receipts: Array<String>, asset_pipeline_registry_entries: Array<String>, evaluation_summary: String, cache_summary: String) -> WorkspaceReadModel:
    let dirty_lanes = []
    if publish_dirty:
        dirty_lanes.push("publish")
    if tensor_dirty:
        dirty_lanes.push("tensor")
    let focus_surface = "viewport_stage"
    let operator_summary = active_mode + ":tool=" + active_tool + ":selection=" + str(selection_count)
    return WorkspaceReadModel {
        active_mode: active_mode,
        focus_surface: focus_surface,
        viewport_mode: viewport_mode,
        viewport_overlay_policy: viewport_overlay_policy,
        viewport_mode_count: viewport_mode_count,
        viewport_mode_summary: viewport_mode_summary,
        viewport_mode_registry_summary: viewport_mode_registry_summary,
        viewport_mode_registry_entries: viewport_mode_registry_entries,
        operator_summary: operator_summary,
        dirty_lanes: dirty_lanes,
        runtime_lane_count: runtime_lane_count,
        runtime_lane_summary: runtime_lane_summary,
        runtime_lane_registry_summary: runtime_lane_registry_summary,
        runtime_lane_registry_entries: runtime_lane_registry_entries,
        power_lane_count: power_lane_count,
        power_lane_summary: power_lane_summary,
        power_lane_registry_entries: power_lane_registry_entries,
        runtime_pack_count: runtime_pack_count,
        runtime_pack_summary: runtime_pack_summary,
        runtime_pack_registry_entries: runtime_pack_registry_entries,
        fabric_intent_count: fabric_intent_count,
        fabric_intent_summary: fabric_intent_summary,
        fabric_intent_registry_entries: fabric_intent_registry_entries,
        asset_pipeline_summary: asset_pipeline_summary,
        asset_pipeline_source_id: asset_pipeline_source_id,
        asset_pipeline_session_route_scope: asset_pipeline_session_route_scope,
        asset_pipeline_source_priority: asset_pipeline_source_priority,
        asset_pipeline_transcode_profiles: asset_pipeline_transcode_profiles,
        asset_pipeline_routed_runtime_ids: asset_pipeline_routed_runtime_ids,
        asset_pipeline_lineage_receipts: asset_pipeline_lineage_receipts,
        asset_pipeline_registry_entries: asset_pipeline_registry_entries,
        evaluation_summary: evaluation_summary,
        cache_summary: cache_summary
    }

fn derive_editor_context_read_model(active_workspace_id: String, active_pane_id: String, active_tool_id: String, active_object_id: String, active_edit_target_id: String, active_material_id: String, active_texture_set_id: String, active_graph_node_id: String, active_frame: Int, active_viewport_mode: String) -> EditorContextReadModel:
    return EditorContextReadModel {
        active_workspace_id: active_workspace_id,
        active_pane_id: active_pane_id,
        active_tool_id: active_tool_id,
        active_object_id: active_object_id,
        active_edit_target_id: active_edit_target_id,
        active_material_id: active_material_id,
        active_texture_set_id: active_texture_set_id,
        active_graph_node_id: active_graph_node_id,
        active_frame: active_frame,
        active_viewport_mode: active_viewport_mode
    }

fn derive_pipeline_health(latest_status: String, render_dirty: Bool, compositor_dirty: Bool, publish_dirty: Bool) -> PipelineHealthReadModel:
    if latest_status == "failed":
        return PipelineHealthReadModel {
            severity: "critical",
            summary: "latest Fabric session failed"
        }
    if render_dirty or compositor_dirty or publish_dirty:
        return PipelineHealthReadModel {
            severity: "warning",
            summary: "downstream lane refresh required"
        }
    return PipelineHealthReadModel {
        severity: "healthy",
        summary: "session and lane projections are aligned"
    }

fn derive_workbench_read_model(active_workbench_id: String, active_tab_group_id: String, active_dock_id: String, active_pane_id: String, materialized_shell_path: String, runtime_snapshot_path: String) -> WorkbenchReadModel:
    return WorkbenchReadModel {
        active_workbench_id: active_workbench_id,
        active_tab_group_id: active_tab_group_id,
        active_dock_id: active_dock_id,
        active_pane_id: active_pane_id,
        materialized_shell_path: materialized_shell_path,
        runtime_snapshot_path: runtime_snapshot_path,
        summary: active_workbench_id + ":tabs=" + active_tab_group_id + ":dock=" + active_dock_id + ":pane=" + active_pane_id
    }
