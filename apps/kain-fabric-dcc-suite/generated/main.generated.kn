component App():
    render <slot layout="column" gap={10} padding={10} overflow_y="scroll">
        <theme name="kain_fabric_universal_studio">
            <scope name="dcc_shell" selector="kain-fabric-dcc-suite" />
            <token name="theme.chrome.topbar.visible" category="state" value={false} />
            <token name="theme.chrome.inspector.visible" category="state" value={false} />
            <token name="theme.spacing.scale" category="space" value={1.02} />
            <token name="theme.radius.scale" category="radius" value={1.1} />
            <token name="theme.typography.scale" category="type" value={1.05} />
            <token name="theme.background.top" category="color" value="#07111a" />
            <token name="theme.background.bottom" category="color" value="#0d1b25" />
            <token name="theme.surface.default" category="color" value="#11212d" />
            <token name="theme.surface.alt" category="color" value="#172a38" />
            <token name="theme.surface.raised" category="color" value="#22384a" />
            <token name="theme.surface.overlay" category="color" value="#0a1620e6" />
            <token name="theme.outline.soft" category="color" value="#335267" />
            <token name="theme.outline.bright" category="color" value="#6dd3c7" />
            <token name="theme.accent.primary" category="color" value="#ff8c42" />
            <token name="theme.accent.soft" category="color" value="#ffd29c" />
            <token name="theme.highlight" category="color" value="#52c7ea" />
            <token name="theme.text.default" category="color" value="#eef7fb" />
            <token name="theme.text.muted" category="color" value="#9fb5c4" />
            <token name="widget.panel.surface.stroke" category="color" value="#00000000" />
            <token name="widget.inspector.surface.mode" category="surface" value="ghost" />
            <token name="widget.tree.surface.mode" category="surface" value="ghost" />
            <token name="widget.graph.surface.mode" category="surface" value="canvas" />
            <token name="widget.timeline.surface.mode" category="surface" value="canvas" />
            <token name="widget.viewport3d.surface.mode" category="surface" value="canvas" />
            <variant scope="dcc_shell" name="shell_root">
                <token name="title.visible" category="state" value={false} />
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={6} />
            </variant>
            <variant scope="dcc_shell" name="topbar">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={12} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="topbar_brand">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={14} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="topbar_menu">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={8} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="topbar_status_strip">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={6} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="context_strip">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={4} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="context_block">
                <token name="surface.mode" category="surface" value="layered" />
                <token name="surface.padding" category="space" value={12} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="command_spotlight">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={12} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="workspace_chip">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="workspace_chip_active">
                <token name="surface.mode" category="surface" value="accent" />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="spotlight_card">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="page">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={6} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="hero_card">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={16} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="quiet_card">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="status_card">
                <token name="surface.mode" category="surface" value="accent" />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="dcc_shell" name="surface_card">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={12} />
            </variant>
            <textvariant scope="dcc_shell" name="hero">
                <token name="body.size" category="type" value={30} />
            </textvariant>
            <widget kind="panel" scope="dcc_shell" variant="topbar_menu">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="dcc_shell" variant="topbar_status_strip">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="dcc_shell" variant="context_block">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="dcc_shell" variant="workspace_chip">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="dcc_shell" variant="workspace_chip_active">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="dcc_shell" variant="spotlight_card">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="dcc_shell" variant="page">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="dcc_shell" variant="surface_card">
                <token name="density" category="layout" value="compact" />
            </widget>
        </theme>
        <panel title="Kain Fabric DCC Suite" scope="dcc_shell" variant="shell_root" layout="column" gap={10}>
            <panel title="Global Top Bar" scope="dcc_shell" variant="topbar" layout="grid" columns={3} gap={10}>
                <panel title="Brand" scope="dcc_shell" variant="topbar_brand" layout="column" gap={4}>
                    <text role="eyebrow">{"KAIN FABRIC SUITE"}</text>
                    <text role="title">{"Fabric-owned global studio shell"}</text>
                    <text role="caption">{"Global chrome, workspace navigation, command spotlight, and runtime status stay above the authored workbench pages."}</text>
                </panel>
                <panel title="Menus" scope="dcc_shell" variant="topbar_menu" layout="column" gap={6}>
                    <text role="eyebrow">{"SHELL MENUS"}</text>
                    <text role="caption">{"Global editor menus stay visible above every lane."}</text>
                    <slot layout="row" gap={6} overflow_x="scroll">
                        <panel title="File" scope="dcc_shell" variant="workspace_chip" layout="column" gap={2} min_width={92}>
                            <text role="title">{"File"}</text>
                        </panel>
                        <panel title="Edit" scope="dcc_shell" variant="workspace_chip" layout="column" gap={2} min_width={92}>
                            <text role="title">{"Edit"}</text>
                        </panel>
                        <panel title="View" scope="dcc_shell" variant="workspace_chip" layout="column" gap={2} min_width={92}>
                            <text role="title">{"View"}</text>
                        </panel>
                        <panel title="Jobs" scope="dcc_shell" variant="workspace_chip" layout="column" gap={2} min_width={92}>
                            <text role="title">{"Jobs"}</text>
                        </panel>
                        <panel title="Help" scope="dcc_shell" variant="workspace_chip" layout="column" gap={2} min_width={92}>
                            <text role="title">{"Help"}</text>
                        </panel>
                    </slot>
                </panel>
                <panel title="Status" scope="dcc_shell" variant="topbar_status_strip" layout="column" gap={6}>
                    <text role="eyebrow">{"RUNTIME STATUS"}</text>
                    <panel title="Status Metrics" scope="dcc_shell" variant="topbar_status_strip" layout="grid" columns={4} gap={8}>
                        <panel title="Fabric" scope="dcc_shell" variant="status_card" layout="column" gap={2} min_width={120}>
                            <text role="metric">{"SUCCEEDED"}</text>
                            <text role="caption">{"latest pipeline session"}</text>
                        </panel>
                        <panel title="Workspaces" scope="dcc_shell" variant="quiet_card" layout="column" gap={2} min_width={120}>
                            <text role="metric">{"7"}</text>
                            <text role="caption">{"authored page lanes"}</text>
                        </panel>
                        <panel title="Surfaces" scope="dcc_shell" variant="quiet_card" layout="column" gap={2} min_width={120}>
                            <text role="metric">{"18"}</text>
                            <text role="caption">{"registered shell surfaces"}</text>
                        </panel>
                        <panel title="Packs" scope="dcc_shell" variant="quiet_card" layout="column" gap={2} min_width={120}>
                            <text role="metric">{"15"}</text>
                            <text role="caption">{"runtime packs projected"}</text>
                        </panel>
                    </panel>
                </panel>
            </panel>
            <panel title="Shell Context Strip" scope="dcc_shell" variant="context_strip" layout="column" gap={10}>
                <panel title="Global lane navigation" scope="dcc_shell" variant="context_block" layout="column" gap={8}>
                    <text role="eyebrow">{"Workspace Switcher"}</text>
                    <text role="title">{"Global lane navigation"}</text>
                    <text role="caption">{"Each chip mirrors an authored workbench page. The host can style this later as real tab chrome without inventing a second workspace schema."}</text>
                    <slot layout="row" gap={8} overflow_x="scroll">
                        <panel title="Scene Assembly" scope="dcc_shell" variant="workspace_chip_active" layout="column" gap={3} min_width={170}>
                            <text role="eyebrow">{"SCENE"}</text>
                            <text role="title">{"Scene Assembly"}</text>
                            <text role="caption">{"Scene graph authoring, set dressing, layout, and asset placement."}</text>
                        </panel>
                        <panel title="Sculpt And Model" scope="dcc_shell" variant="workspace_chip" layout="column" gap={3} min_width={170}>
                            <text role="eyebrow">{"MODEL"}</text>
                            <text role="title">{"Sculpt And Model"}</text>
                            <text role="caption">{"Poly modeling, sculpt strokes, remesh, and topology shaping."}</text>
                        </panel>
                        <panel title="Material And Lookdev" scope="dcc_shell" variant="workspace_chip" layout="column" gap={3} min_width={170}>
                            <text role="eyebrow">{"LOOKDEV"}</text>
                            <text role="title">{"Material And Lookdev"}</text>
                            <text role="caption">{"PBR texture sets, paint layers, SVG masks, smart materials, and export presets."}</text>
                        </panel>
                        <panel title="Rig And Animation" scope="dcc_shell" variant="workspace_chip" layout="column" gap={3} min_width={170}>
                            <text role="eyebrow">{"RIG"}</text>
                            <text role="title">{"Rig And Animation"}</text>
                            <text role="caption">{"Rig graphs, deformation checks, clips, retargeting, and blocking."}</text>
                        </panel>
                        <panel title="Simulation And FX" scope="dcc_shell" variant="workspace_chip" layout="column" gap={3} min_width={170}>
                            <text role="eyebrow">{"SIM"}</text>
                            <text role="title">{"Simulation And FX"}</text>
                            <text role="caption">{"Caches, solvers, scene events, and reproducible simulation jobs."}</text>
                        </panel>
                        <panel title="Render And Composite" scope="dcc_shell" variant="workspace_chip" layout="column" gap={3} min_width={170}>
                            <text role="eyebrow">{"RENDER"}</text>
                            <text role="title">{"Render And Composite"}</text>
                            <text role="caption">{"Viewport renders, frame products, AOV assembly, and compositor rebuilds."}</text>
                        </panel>
                        <panel title="Publish And Automation" scope="dcc_shell" variant="workspace_chip" layout="column" gap={3} min_width={170}>
                            <text role="eyebrow">{"PUBLISH"}</text>
                            <text role="title">{"Publish And Automation"}</text>
                            <text role="caption">{"Package review, delivery reports, automation jobs, and runtime pack promotion."}</text>
                        </panel>
                    </slot>
                </panel>
                <panel title="Shell Context Blocks" scope="dcc_shell" variant="context_strip" layout="grid" columns={2} gap={10}>
                    <panel title="Global operator quick-actions" scope="dcc_shell" variant="command_spotlight" layout="column" gap={8}>
                        <text role="eyebrow">{"Command Spotlight"}</text>
                        <text role="title">{"Global operator quick-actions"}</text>
                        <text role="caption">{"These are the shell-level commands that should stay one gesture away no matter which workbench is active."}</text>
                        <slot layout="row" gap={8} overflow_x="scroll">
                            <panel title="Bootstrap Suite" scope="dcc_shell" variant="spotlight_card" layout="column" gap={4} min_width={220}>
                                <text role="eyebrow">{"SURFACE TITLEBAR"}</text>
                                <text role="title">{"Bootstrap Suite"}</text>
                                <text role="caption">{"intent project.bootstrap"}</text>
                                <text role="body">{"Seeds the canonical scene, asset, preview, tensor, and publish session state."}</text>
                            </panel>
                            <panel title="Switch Workspace" scope="dcc_shell" variant="spotlight_card" layout="column" gap={4} min_width={220}>
                                <text role="eyebrow">{"SURFACE WORKSPACE_MODE_RAIL"}</text>
                                <text role="title">{"Switch Workspace"}</text>
                                <text role="caption">{"intent workspace.switch_mode"}</text>
                                <text role="body">{"Moves the operator into a different DCC lane and marks downstream surfaces for refresh."}</text>
                            </panel>
                            <panel title="Render Preview" scope="dcc_shell" variant="spotlight_card" layout="column" gap={4} min_width={220}>
                                <text role="eyebrow">{"SURFACE RENDER_LOUNGE"}</text>
                                <text role="title">{"Render Preview"}</text>
                                <text role="caption">{"intent render.preview"}</text>
                                <text role="body">{"Stages a preview render refresh and updates render-facing reports."}</text>
                            </panel>
                            <panel title="Package Publish" scope="dcc_shell" variant="spotlight_card" layout="column" gap={4} min_width={220}>
                                <text role="eyebrow">{"SURFACE PUBLISH_CONSOLE"}</text>
                                <text role="title">{"Package Publish"}</text>
                                <text role="caption">{"intent publish.package"}</text>
                                <text role="body">{"Builds the publish summary and package receipts for operator review."}</text>
                            </panel>
                            <panel title="Tensor Infer Step" scope="dcc_shell" variant="spotlight_card" layout="column" gap={4} min_width={220}>
                                <text role="eyebrow">{"SURFACE JOBS_MONITOR"}</text>
                                <text role="title">{"Tensor Infer Step"}</text>
                                <text role="caption">{"intent tensor.infer_step"}</text>
                                <text role="body">{"Stages a tensor-oriented inference plan and readiness report."}</text>
                            </panel>
                        </slot>
                    </panel>
                    <panel title="Shell system guidance" scope="dcc_shell" variant="context_block" layout="column" gap={6}>
                        <text role="eyebrow">{"Operator Context"}</text>
                        <text role="title">{"Shell system guidance"}</text>
                        <text role="caption">{"The shell chrome should feel persistent and global. Workbench pages should feel like modules mounted inside the same editor, not separate generated demos."}</text>
                        <text role="caption">{"command spotlight remains shell-owned so operators can bootstrap, switch lanes, preview, and publish without hunting through page-local inspectors"}</text>
                        <text role="caption">{"workspace chips mirror authored page descriptors and should be the future landing zone for semantic top-tab rendering in the native host"}</text>
                        <text role="caption">{"runtime status, registry counts, and extension seam warnings belong in shell chrome so lane pages can stay focused on authored work"}</text>
                    </panel>
                </panel>
            </panel>
            <panel title="Workbench Pages" scope="dcc_shell" variant="page" layout="column" gap={12}>
            <panel title="Scene Assembly Workbench" scope="dcc_shell" variant="page" layout="dock" gap={14} persistent_layout_id="dcc_page_scene_assembly" tab_group_id="dcc-workspaces" tab_label="Scene" tab_order={0} tab_default_active={true}>
                <panel title="Navigator" dock="left" split_ratio={0.22} min_width={270} max_width={380} resizable={true} layout="column" gap={12}>
                    <panel title="Hero" scope="dcc_shell" variant="hero_card" layout="column" gap={6}>
                        <text role="eyebrow">{"SCENE ASSEMBLY"}</text>
                        <text role="hero">{"Scene-first assembly and ingest mission control"}</text>
                        <text role="body">{"Stage layout, intake, placement, and downstream review stay in one operator surface instead of scattering across separate host-owned tools."}</text>
                    </panel>
                    <inspector title="Featured Tools">
                        <text role="body">{"Select | Selection, hierarchy filtering, and transform handoff."}</text>
                        <text role="body">{"Kitbash Placement | Scene placement, snap rules, and collection instancing."}</text>
                    </inspector>
                    <inspector title="Quick Commands">
                        <text role="body">{"Bootstrap Suite | Seeds the canonical scene, asset, preview, tensor, and publish session state."}</text>
                        <text role="body">{"Switch Workspace | Moves the operator into a different DCC lane and marks downstream surfaces for refresh."}</text>
                        <text role="body">{"Ingest Package | Stages a new asset package into the suite ingest lane and updates runtime pack bookkeeping."}</text>
                        <text role="body">{"Render Preview | Stages a preview render refresh and updates render-facing reports."}</text>
                    </inspector>
                    <tree title="Focus Surface">
                        <text role="caption">{"Scene Graph"}</text>
                        <text role="caption">{"Hierarchy, collections, instancing groups, and publish roots."}</text>
                    </tree>
                </panel>
                <panel title="Workbench Stage" dock="center" layout="column" gap={12}>
                    <panel title="Status Deck" layout="grid" columns={3} gap={10}>
                        <panel title="Mode" scope="dcc_shell" variant="quiet_card" layout="column" gap={2}>
                            <text role="metric">{"Scene Assembly"}</text>
                            <text role="caption">{"focus Scene Graph"}</text>
                        </panel>
                        <panel title="Fabric" scope="dcc_shell" variant="status_card" layout="column" gap={2}>
                            <text role="metric">{"SUCCEEDED"}</text>
                            <text role="caption">{"intent routes 4"}</text>
                        </panel>
                        <panel title="Scale" scope="dcc_shell" variant="quiet_card" layout="column" gap={2}>
                            <text role="metric">{"1"}</text>
                            <text role="caption">{"runtime packs online"}</text>
                        </panel>
                    </panel>
                    <viewport3d title="Viewport Stage" scene="dcc_suite_scene" viewport_profile="dcc_authoring_balanced" gizmo_default_mode="translate" gizmo_default_space="world" gizmo_profile="dcc_transform_universal" gizmo_visible={true} gizmo_drag_trigger="ctrl_primary_drag" gizmo_selection_required={true} gizmo_hotkey_translate="T" gizmo_hotkey_rotate="R" gizmo_hotkey_scale="Y" gizmo_hotkey_cycle_space="U" gizmo_hotkey_toggle_snap="I" gizmo_snap_translate={0.5} gizmo_snap_rotate_degrees={15.0} gizmo_snap_scale_percent={10.0} gizmo_snap_default_enabled={false} />
                    <panel title="Surface Deck" layout="grid" columns={2} gap={12}>
                        <panel title="Scene Graph" scope="dcc_shell" variant="surface_card" layout="column" gap={8}>
                            <text role="eyebrow">{"TREE"}</text>
                            <text role="caption">{"Hierarchy, collections, instancing groups, and publish roots."}</text>
                            <tree title="Scene Graph">
                                <text role="caption">{"Hierarchy, collections, instancing groups, and publish roots."}</text>
                            </tree>
                        </panel>
                        <panel title="Asset Ingest" scope="dcc_shell" variant="surface_card" layout="column" gap={8}>
                            <text role="eyebrow">{"TREE"}</text>
                            <text role="caption">{"USD, GLTF, material, groom, cache, and runtime pack intake."}</text>
                            <tree title="Asset Ingest">
                                <text role="caption">{"USD, GLTF, material, groom, cache, and runtime pack intake."}</text>
                            </tree>
                        </panel>
                        <panel title="Render Lounge" scope="dcc_shell" variant="surface_card" layout="column" gap={8}>
                            <text role="eyebrow">{"GRAPH"}</text>
                            <text role="caption">{"Render products, preview budgets, frame queues, and AOV targets."}</text>
                            <graph title="Render Lounge" />
                        </panel>
                    </panel>
                </panel>
                <panel title="Inspector Rail" dock="right" split_ratio={0.25} min_width={320} max_width={460} resizable={true} layout="column" gap={12}>
                    <inspector title="Intent Routes">
                        <text role="body">{"Bootstrap Suite | fabric/intents/bootstrap.fabric.toml"}</text>
                        <text role="body">{"Asset Ingest | fabric/intents/asset_ingest.fabric.toml"}</text>
                        <text role="body">{"Render Preview | fabric/intents/render_preview.fabric.toml"}</text>
                        <text role="body">{"Publish Package | fabric/intents/publish_package.fabric.toml"}</text>
                    </inspector>
                    <panel title="Selection Inspector" scope="dcc_shell" variant="surface_card" layout="column" gap={8}>
                        <text role="eyebrow">{"INSPECTOR"}</text>
                        <text role="caption">{"Transforms, metadata, relationships, and lane-specific detail panels."}</text>
                        <inspector title="Selection Inspector">
                            <text role="caption">{"Transforms, metadata, relationships, and lane-specific detail panels."}</text>
                        </inspector>
                    </panel>
                    <panel title="Tool Shelf" scope="dcc_shell" variant="surface_card" layout="column" gap={8}>
                        <text role="eyebrow">{"INSPECTOR"}</text>
                        <text role="caption">{"Context-sensitive authoring tools across sculpt, material, rig, sim, and publish."}</text>
                        <inspector title="Tool Shelf">
                            <text role="caption">{"Context-sensitive authoring tools across sculpt, material, rig, sim, and publish."}</text>
                        </inspector>
                    </panel>
                    <panel title="Report Browser" scope="dcc_shell" variant="surface_card" layout="column" gap={8}>
                        <text role="eyebrow">{"INSPECTOR"}</text>
                        <text role="caption">{"Topology, tensor, render, automation, and publish reports."}</text>
                        <inspector title="Report Browser">
                            <text role="caption">{"Topology, tensor, render, automation, and publish reports."}</text>
                        </inspector>
                    </panel>
                </panel>
                <panel title="Telemetry Tray" dock="bottom" split_ratio={0.24} min_height={220} max_height={360} resizable={true} layout="column" gap={12}>
                    <panel title="Execution Surfaces" layout="grid" columns={2} gap={10}>
                        <panel title="Animation Timeline" scope="dcc_shell" variant="quiet_card" layout="column" gap={8}>
                            <text role="eyebrow">{"TIMELINE"}</text>
                            <text role="caption">{"Clips, simulation triggers, preview markers, and publish cut ranges."}</text>
                            <timeline title="Animation Timeline" />
                        </panel>
                        <panel title="Jobs Monitor" scope="dcc_shell" variant="quiet_card" layout="column" gap={8}>
                            <text role="eyebrow">{"TIMELINE"}</text>
                            <text role="caption">{"Background jobs, Fabric sessions, automation schedules, and retry state."}</text>
                            <timeline title="Jobs Monitor" />
                        </panel>
                    </panel>
                    <inspector title="Extension Seams">
                    </inspector>
                </panel>
            </panel>
            <panel title="Sculpt And Modeling Forge" scope="dcc_shell" variant="page" layout="dock" gap={14} persistent_layout_id="dcc_page_sculpt_model" tab_group_id="dcc-workspaces" tab_label="Model" tab_order={1}>
                <panel title="Navigator" dock="left" split_ratio={0.22} min_width={270} max_width={380} resizable={true} layout="column" gap={12}>
                    <panel title="Hero" scope="dcc_shell" variant="hero_card" layout="column" gap={6}>
                        <text role="eyebrow">{"SCULPT AND MODEL"}</text>
                        <text role="hero">{"Viewport-dominant modeling and sculpt layout"}</text>
                        <text role="body">{"Brush operations, topology refresh, and publish invalidation are grouped as one sculpt workbench instead of separate one-off inspectors."}</text>
                    </panel>
                    <inspector title="Featured Tools">
                        <text role="body">{"Poly Extrude | Poly modeling, shelling, and local face edits."}</text>
