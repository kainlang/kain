// src/sculpt_brush_step.kn
// Kain Fabric DCC Suite - Sculpt Brush Extension Seam

module KainFabric::DccSuite::Sculpt;

import Kain::Fabric::Intent;
import Kain::State;

/// Handles the `sculpt_brush_stroke` Fabric intent.
///
/// Runtime limitation:
/// Kain currently lacks a native high-performance spatial index and mesh edit
/// kernel for interactive displacement on large meshes.
///
/// Clean extension seam:
/// Package the brush intent (radius, strength, falloff, ray hit) against the
/// active mesh edit target and delegate the actual mutation to the next owned
/// runtime lane: a native C ABI surface, a GPU compute path, or a Rust worker
/// pool. The step should stay resource-id driven so the session contract keeps
/// ownership of the mesh while the runtime lane handles the heavy lift.

public fn execute_sculpt_brush_step(intent: Intent, state: State) -> State {
    let brush_data = intent.payload.get_as::<SculptBrushData>("brush_data");
    let active_mesh_resource_id = intent.payload.get_string("target_mesh_id");

    // The sculpt lane edits the active mesh resource id; it does not own the
    // mesh object itself inside this step.
    // 1. Resolve the active edit target from the session/resource contract.
    // 2. Marshal the brush stroke parameters to the chosen runtime boundary.

    log::info("Delegating sculpt_brush_stroke for active mesh resource id through the data-driven sculpt seam.");

    // Native/GPU/Rust execution belongs behind the runtime seam.
    // let result = SculptRuntime::apply_stroke(active_mesh_resource_id, brush_data);

    // 3. Mark the active mesh resource dirty so downstream viewport and edit
    //    consumers know the resource contents changed.
    state
}

struct SculptBrushData {
    pub origin: Vec3,
    pub direction: Vec3,
    pub radius: f32,
    pub strength: f32,
    pub falloff_curve: String,
}
