fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn render_frame_schedule_report_path() -> String:
    return app_state_root() + "/render_frame_schedule_report.json"

fn build_render_frame_schedule_report_json(settings: Any, preview_report: String, pathtrace_report: String, accumulation_report: String, denoise_report: String) -> String:
    let frame_budget = settings.runtime_pack_count + settings.preview_count + settings.tensor_feature_count + 3
    let capture_stride = settings.preview_count + 1
    let review_capture_count = settings.tensor_feature_count + 2
    let aov_slots = settings.runtime_pack_count + 4

    let json = "{\n"
    let json = json + "  \"kind\": \"render_frame_schedule_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"schedule_profile\": \"aaa_render_room_frame_queue\",\n"
    let json = json + "  \"frame_budget\": " + str(frame_budget) + ",\n"
    let json = json + "  \"capture_stride\": " + str(capture_stride) + ",\n"
    let json = json + "  \"review_capture_count\": " + str(review_capture_count) + ",\n"
    let json = json + "  \"aov_slots\": " + str(aov_slots) + ",\n"
    let json = json + "  \"upstream_render_preview_report\": \"" + preview_report + "\",\n"
    let json = json + "  \"upstream_pathtrace_report\": \"" + pathtrace_report + "\",\n"
    let json = json + "  \"upstream_render_accumulation_report\": \"" + accumulation_report + "\",\n"
    let json = json + "  \"upstream_render_denoise_report\": \"" + denoise_report + "\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let preview_report = fabric_inputs.render_preview_projection.render_preview_report
    let pathtrace_report = fabric_inputs.pathtrace_preview_projection.pathtrace_preview_report
    let accumulation_report = fabric_inputs.render_accumulation_projection.render_accumulation_report
    let denoise_report = fabric_inputs.render_denoise_projection.render_denoise_report
    let report_json = build_render_frame_schedule_report_json(settings, preview_report, pathtrace_report, accumulation_report, denoise_report)

    write_file(render_frame_schedule_report_path(), report_json)

    return "render-frame-schedule:" + settings.workspace_mode + ":budget=" + str(settings.runtime_pack_count + settings.preview_count + settings.tensor_feature_count + 3) + ":captures=" + str(settings.tensor_feature_count + 2)
