use std::interop::bridge

struct DccSuiteSeedOutputs:
    scene_graph_document: String
    asset_catalog_document: String
    material_authoring_document: String
    svg_mask_document: String
    preview_src: Any
    preview_dst: Any
    pathtrace_dst: Any
    preview_image: Any
    tensor_features: Any
    sculpt_heightfield_src: Any
    sculpt_brush_params: Any
    sculpt_delta: Any
    session_report: String

fn push_f32_demo(bytes: Array<Int>, value: Int) -> Void:
    if value == 1:
        bytes.push(0)
        bytes.push(0)
        bytes.push(128)
        bytes.push(63)
        return
    if value == 2:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        return
    if value == 3:
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        bytes.push(64)
        return
    bytes.push(0)
    bytes.push(0)
    bytes.push(128)
    bytes.push(64)

fn push_u32(bytes: Array<Int>, value: Int) -> Void:
    bytes.push(value % 256)
    bytes.push((value / 256) % 256)
    bytes.push((value / 65536) % 256)
    bytes.push((value / 16777216) % 256)

fn build_preview_stream(count: Int, accent: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        let value = ((index + accent) % 4) + 1
        push_f32_demo(bytes, value)
        index = index + 1
    return bytes

fn build_zero_stream(count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        index = index + 1
    return bytes

fn build_zero_u32_stream(count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        push_u32(bytes, 0)
        index = index + 1
    return bytes

fn build_preview_pixels(width: Int, height: Int, accent: Int) -> Array<Int>:
    let pixels = []
    let y = 0
    while y < height:
        let x = 0
        while x < width:
            let albedo = (x * 17 + y * 11 + accent * 9) % 255
            let roughness = (x * 5 + y * 13 + 96 + accent) % 255
            let metallic = (x * 19 + y * 7 + 32 + accent * 3) % 255
            pixels.push(albedo)
            pixels.push(roughness)
            pixels.push(metallic)
            pixels.push(255)
            x = x + 1
        y = y + 1
    return pixels

fn build_tensor_features(count: Int, accent: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        let value = ((index * 3) + accent) % 4
        push_f32_demo(bytes, value + 1)
        index = index + 1
    return bytes

fn build_sculpt_heightfield_stream(settings: Any) -> Array<Int>:
    let bytes = []
    let resolution = settings.sculpt_grid_resolution
    let sample_count = settings.sculpt_sample_count
    let height_min = settings.sculpt_height_min_milli
    let height_max = settings.sculpt_height_max_milli
    let raw_span = height_max - height_min
    let height_span = raw_span
    if height_span <= 0:
        height_span = 1
    let index = 0
    while index < sample_count:
        let x = index % resolution
        let y = index / resolution
        let ramp = ((x * 31) + (y * 17) + settings.brush_accent * 13) % 1000
        let height_value = height_min + ((height_span * ramp) / 999)
        push_u32(bytes, height_value)
        index = index + 1
    return bytes

fn build_sculpt_brush_params(settings: Any) -> Array<Int>:
    let bytes = []
    push_u32(bytes, settings.sculpt_grid_resolution)
    push_u32(bytes, settings.sculpt_sample_count)
    push_u32(bytes, settings.sculpt_center_x_milli)
    push_u32(bytes, settings.sculpt_center_y_milli)
    push_u32(bytes, settings.sculpt_radius_milli)
    push_u32(bytes, settings.sculpt_strength_milli)
    push_u32(bytes, settings.sculpt_falloff_milli)
    if settings.sculpt_invert:
        push_u32(bytes, 1)
    else:
        push_u32(bytes, 0)
    push_u32(bytes, settings.sculpt_height_min_milli)
    push_u32(bytes, settings.sculpt_height_max_milli)
    return bytes

fn build_mesh_resource_contract() -> String:
    let mesh_contract = fabric_inputs.python_suite_bootstrap.project_settings.mesh_contract_resource_uris
    return "ownership=app-owned:startup-cube=mesh://primitives/authored/startup-cube:imported-payloads=" + mesh_contract.imported_mesh_payload_document + ":authored-primitives=" + mesh_contract.authored_primitive_definition_document + ":active-editable=" + mesh_contract.active_editable_mesh_document + ":topology-output=" + mesh_contract.topology_output_mesh_document

fn build_scene_graph_document(settings: Any) -> String:
    return "scene-graph:" + settings.project_name + ":scene=dcc_suite_scene:start-mesh=mesh://primitives/authored/startup-cube:selection=entity/blender_startup_cube:collection=collection/startup_stage:camera=camera/startup_authoring:mesh-contract=" + build_mesh_resource_contract() + ":mesh-policy=procedural-primitives-first_then_asset-ingest:workspace=" + settings.workspace_mode + ":packs=" + str(settings.runtime_pack_count)

fn build_asset_catalog_document(settings: Any) -> String:
    return "asset-catalog:gltf+usd+materials+rigs:mesh-contract=" + build_mesh_resource_contract() + ":staged=" + str(settings.runtime_pack_count)

fn build_material_authoring_document(settings: Any) -> String:
    return "material-contract:" + settings.project_name + ":texture-set=textureset/hero_body_udim1001:layers=7:svg=3:channels=basecolor+normal+roughness+metallic+ao+height+emissive"

fn build_svg_mask_document(settings: Any) -> String:
    return "svg-mask:" + settings.project_name + ":documents=3:anchors=" + str(settings.runtime_pack_count + 2) + ":motifs=trim+decal+stencil"

fn build_session_report(settings: Any) -> String:
    return "session-report:" + settings.project_name + ":preview=" + str(settings.preview_count) + ":tensor=" + str(settings.tensor_feature_count) + ":sculpt-grid=" + str(settings.sculpt_grid_resolution) + ":pbr=7:svg=3"

fn main() -> DccSuiteSeedOutputs:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let preview_src_bytes = build_preview_stream(settings.preview_count, settings.brush_accent)
    let preview_dst_bytes = build_zero_stream(settings.preview_count)
    let pathtrace_dst_bytes = build_zero_stream(settings.preview_count)
    let preview_pixels = build_preview_pixels(8, 8, settings.brush_accent)
    let tensor_bytes = build_tensor_features(settings.tensor_feature_count, settings.brush_accent)
    let sculpt_heightfield_bytes = build_sculpt_heightfield_stream(settings)
    let sculpt_brush_param_bytes = build_sculpt_brush_params(settings)
    let sculpt_delta_bytes = build_zero_u32_stream(settings.sculpt_sample_count)
    let preview_src = interop_shared_buffer_from_bytes(
        preview_src_bytes,
        "f32",
        [settings.preview_count],
        "f32",
        "application/octet-stream"
    )
    let preview_dst = interop_shared_buffer_from_bytes(
        preview_dst_bytes,
        "f32",
        [settings.preview_count],
        "f32",
        "application/octet-stream"
    )
    let pathtrace_dst = interop_shared_buffer_from_bytes(
        pathtrace_dst_bytes,
        "f32",
        [settings.preview_count],
        "f32",
        "application/octet-stream"
    )
    let preview_image = interop_shared_image_from_bytes(
        preview_pixels,
        8,
        8,
        4,
        "HWC",
        "rgba8",
        "image/x-kain-raster"
    )
    let tensor_features = interop_shared_buffer_from_bytes(
        tensor_bytes,
        "f32",
        [settings.tensor_feature_count],
        "f32",
        "application/octet-stream"
    )
    let sculpt_heightfield_src = interop_shared_buffer_from_bytes(
        sculpt_heightfield_bytes,
        "u32",
        [settings.sculpt_sample_count],
        "u32",
        "application/octet-stream"
    )
    let sculpt_brush_params = interop_shared_buffer_from_bytes(
        sculpt_brush_param_bytes,
        "u32",
        [10],
        "u32",
        "application/octet-stream"
    )
    let sculpt_delta = interop_shared_buffer_from_bytes(
        sculpt_delta_bytes,
        "u32",
        [settings.sculpt_sample_count],
        "u32",
        "application/octet-stream"
    )
    return DccSuiteSeedOutputs {
        scene_graph_document: build_scene_graph_document(settings),
        asset_catalog_document: build_asset_catalog_document(settings),
        material_authoring_document: build_material_authoring_document(settings),
        svg_mask_document: build_svg_mask_document(settings),
        preview_src: preview_src,
        preview_dst: preview_dst,
        pathtrace_dst: pathtrace_dst,
        preview_image: preview_image,
        tensor_features: tensor_features,
        sculpt_heightfield_src: sculpt_heightfield_src,
        sculpt_brush_params: sculpt_brush_params,
        sculpt_delta: sculpt_delta,
        session_report: build_session_report(settings)
    }
