fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn render_delegation_report_path() -> String:
    return app_state_root() + "/render_delegation_report.json"

fn build_render_delegation_report_json(settings: Any, render_report: String, pathtrace_report: String) -> String:
    let delegation_layers = settings.runtime_pack_count + 4
    let review_targets = settings.preview_count + settings.tensor_feature_count
    let json = "{\n"
    let json = json + "  \"kind\": \"render_delegation_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"render_profile\": \"delegated_preview_room\",\n"
    let json = json + "  \"delegation_layers\": " + str(delegation_layers) + ",\n"
    let json = json + "  \"review_targets\": " + str(review_targets) + ",\n"
    let json = json + "  \"upstream_render_preview_report\": \"" + render_report + "\",\n"
    let json = json + "  \"upstream_pathtrace_report\": \"" + pathtrace_report + "\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let render_report = fabric_inputs.render_preview_projection.render_preview_report
    let pathtrace_report = fabric_inputs.pathtrace_preview_projection.pathtrace_preview_report
    let report_json = build_render_delegation_report_json(settings, render_report, pathtrace_report)

    write_file(render_delegation_report_path(), report_json)

    return "render-delegation:" + settings.workspace_mode + ":layers=" + str(settings.runtime_pack_count + 4) + ":targets=" + str(settings.preview_count + settings.tensor_feature_count)
