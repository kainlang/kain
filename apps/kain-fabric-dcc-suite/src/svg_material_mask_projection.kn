fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn svg_mask_report_path() -> String:
    return app_state_root() + "/svg_mask_report.json"

fn build_svg_mask_report_json(settings: Any, svg_document: String) -> String:
    let vector_shape_count = settings.preview_count + 5
    let anchor_count = settings.runtime_pack_count + 2
    let decal_count = settings.runtime_pack_count + 1
    let json = "{\\n"
    let json = json + "  \\\"kind\\\": \\\"svg_mask_report\\\",\\n"
    let json = json + "  \\\"project\\\": \\\"" + settings.project_name + "\\\",\\n"
    let json = json + "  \\\"document_id\\\": \\\"svg/masks/hero_surface_primary\\\",\\n"
    let json = json + "  \\\"vector_shape_count\\\": " + str(vector_shape_count) + ",\\n"
    let json = json + "  \\\"anchor_count\\\": " + str(anchor_count) + ",\\n"
    let json = json + "  \\\"decal_count\\\": " + str(decal_count) + ",\\n"
    let json = json + "  \\\"trim_sheet_mode\\\": \\\"hybrid_svg_and_bake\\\",\\n"
    let json = json + "  \\\"svg_document\\\": \\\"" + svg_document + "\\\"\\n"
    let json = json + "}\\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let svg_document = fabric_inputs.dcc_suite_seed.svg_mask_document
    let report_json = build_svg_mask_report_json(settings, svg_document)

    write_file(svg_mask_report_path(), report_json)

    return "svg-mask:" + settings.workspace_mode + ":shapes=" + str(settings.preview_count + 5) + ":anchors=" + str(settings.runtime_pack_count + 2)
