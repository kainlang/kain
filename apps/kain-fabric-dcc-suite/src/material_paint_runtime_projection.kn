fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn material_paint_runtime_report_path() -> String:
    return app_state_root() + "/material_paint_runtime_report.json"

fn build_material_paint_runtime_report_json(settings: Any, material_document: String, svg_document: String) -> String:
    let paint_layer_count = settings.runtime_pack_count + settings.preview_count + 4
    let brush_response_profile = "pressure_weighted_surface_tight"
    let layer_blend_profile = "fill_paint_generator_smart_stack"
    let texel_density_target = 256
    let texel_density_policy = "udim_hero_surface_even_density"
    let deformation_surface_id = "surface/hero_deformation_shell"
    let json = "{\\n"
    let json = json + "  \\\"kind\\\": \\\"material_paint_runtime_report\\\",\\n"
    let json = json + "  \\\"project\\\": \\\"" + settings.project_name + "\\\",\\n"
    let json = json + "  \\\"workspace_mode\\\": \\\"" + settings.workspace_mode + "\\\",\\n"
    let json = json + "  \\\"material_document\\\": \\\"" + material_document + "\\\",\\n"
    let json = json + "  \\\"svg_document\\\": \\\"" + svg_document + "\\\",\\n"
    let json = json + "  \\\"paint_layer_count\\\": " + str(paint_layer_count) + ",\\n"
    let json = json + "  \\\"layer_blend_profile\\\": \\\"" + layer_blend_profile + "\\\",\\n"
    let json = json + "  \\\"brush_response_profile\\\": \\\"" + brush_response_profile + "\\\",\\n"
    let json = json + "  \\\"brush_surface_policy\\\": \\\"deformation_aware\\\",\\n"
    let json = json + "  \\\"texel_density_target\\\": " + str(texel_density_target) + ",\\n"
    let json = json + "  \\\"texel_density_policy\\\": \\\"" + texel_density_policy + "\\\",\\n"
    let json = json + "  \\\"deformation_surface_id\\\": \\\"" + deformation_surface_id + "\\\",\\n"
    let json = json + "  \\\"paint_resolution\\\": 4096,\\n"
    let json = json + "  \\\"layer_blend_kernel\\\": \\\"dcc_suite_material_layer_blend_preview\\\",\\n"
    let json = json + "  \\\"brush_kernel\\\": \\\"dcc_suite_brush_response_preview\\\",\\n"
    let json = json + "  \\\"uv_kernel\\\": \\\"dcc_suite_uv_policy_preview\\\"\\n"
    let json = json + "}\\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let material_document = fabric_inputs.dcc_suite_seed.material_authoring_document
    let svg_document = fabric_inputs.dcc_suite_seed.svg_mask_document
    let report_json = build_material_paint_runtime_report_json(settings, material_document, svg_document)

    write_file(material_paint_runtime_report_path(), report_json)

    return "material-paint-runtime:" + settings.workspace_mode + ":layers=" + str(settings.runtime_pack_count + settings.preview_count + 4) + ":density=256"