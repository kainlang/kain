use std::interop::bridge

fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn render_denoise_report_path() -> String:
    return app_state_root() + "/render_denoise_report.json"

fn build_render_denoise_report_json(settings: Any, accumulation_buffer: Any, material_summary: String, svg_summary: String) -> String:
    let accumulation_info = interop_shared_buffer_info(accumulation_buffer)
    let accumulation_sample_count = accumulation_info.shape[0]
    let denoise_strength = settings.preview_count + 1

    let json = "{\n"
    let json = json + "  \"kind\": \"render_denoise_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"render_profile\": \"temporal_preview_denoise\",\n"
    let json = json + "  \"gpu_step\": \"gpu_pathtrace_preview\",\n"
    let json = json + "  \"accumulation_buffer_bytes\": " + str(accumulation_info.byte_length) + ",\n"
    let json = json + "  \"accumulation_sample_count\": " + str(accumulation_sample_count) + ",\n"
    let json = json + "  \"denoise_strength_hint\": " + str(denoise_strength) + ",\n"
    let json = json + "  \"upstream_material_summary\": \"" + material_summary + "\",\n"
    let json = json + "  \"upstream_svg_summary\": \"" + svg_summary + "\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let accumulation_buffer = fabric_inputs.gpu_pathtrace_preview.pathtrace_dst
    let material_summary = fabric_inputs.material_authoring_projection.material_authoring_report
    let svg_summary = fabric_inputs.svg_material_mask_projection.svg_mask_report
    let report_json = build_render_denoise_report_json(settings, accumulation_buffer, material_summary, svg_summary)

    write_file(render_denoise_report_path(), report_json)

    return "render-denoise:" + settings.workspace_mode + ":bytes=" + str(interop_shared_buffer_info(accumulation_buffer).byte_length) + ":strength=" + str(settings.preview_count + 1)
