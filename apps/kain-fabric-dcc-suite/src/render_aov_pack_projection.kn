use std::interop::bridge

fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn render_aov_pack_report_path() -> String:
    return app_state_root() + "/render_aov_pack_report.json"

fn build_render_aov_pack_report_json(settings: Any, aov_buffer: Any, render_report: String, pathtrace_report: String) -> String:
    let aov_info = interop_shared_buffer_info(aov_buffer)
    let aov_sample_count = aov_info.shape[0]
    let aov_count = settings.runtime_pack_count + 4
    let review_capture_count = settings.preview_count + settings.tensor_feature_count + 2
    let cull_budget = settings.runtime_pack_count + settings.preview_count + 1

    let json = "{\n"
    let json = json + "  \"kind\": \"render_aov_pack_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"render_profile\": \"aaa_render_room_aov_pack\",\n"
    let json = json + "  \"gpu_step\": \"gpu_render_aov_pack\",\n"
    let json = json + "  \"aov_buffer_bytes\": " + str(aov_info.byte_length) + ",\n"
    let json = json + "  \"aov_sample_count\": " + str(aov_sample_count) + ",\n"
    let json = json + "  \"aov_count\": " + str(aov_count) + ",\n"
    let json = json + "  \"review_capture_count\": " + str(review_capture_count) + ",\n"
    let json = json + "  \"cull_budget_hint\": " + str(cull_budget) + ",\n"
    let json = json + "  \"upstream_render_preview_report\": \"" + render_report + "\",\n"
    let json = json + "  \"upstream_pathtrace_report\": \"" + pathtrace_report + "\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let aov_buffer = fabric_inputs.gpu_render_aov_pack.preview_dst
    let render_report = fabric_inputs.render_preview_projection.render_preview_report
    let pathtrace_report = fabric_inputs.pathtrace_preview_projection.pathtrace_preview_report
    let report_json = build_render_aov_pack_report_json(settings, aov_buffer, render_report, pathtrace_report)

    write_file(render_aov_pack_report_path(), report_json)

    return "render-aov-pack:" + settings.workspace_mode + ":bytes=" + str(interop_shared_buffer_info(aov_buffer).byte_length) + ":aov=" + str(settings.runtime_pack_count + 4) + ":captures=" + str(settings.preview_count + settings.tensor_feature_count + 2)
