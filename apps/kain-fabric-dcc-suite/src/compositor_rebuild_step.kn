fn compositor_rebuild_report_path() -> String:
    return "state/compositor_rebuild_report.json"

fn build_compositor_report_json(settings: Any, plan_summary: String) -> String:
    let assembled_layers = settings.runtime_pack_count + 3
    let pass_count = settings.preview_count + 2
    let output_surfaces = settings.tensor_feature_count + 1

    let json = "{\n"
    let json = json + "  \"kind\": \"compositor_rebuild_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"active_stack\": \"comp/final_review\",\n"
    let json = json + "  \"assembled_layers\": " + str(assembled_layers) + ",\n"
    let json = json + "  \"pass_count\": " + str(pass_count) + ",\n"
    let json = json + "  \"output_surfaces\": " + str(output_surfaces) + ",\n"
    let json = json + "  \"plan_summary\": \"" + plan_summary + "\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let plan_summary = fabric_inputs.compositor_projection.compositor_rebuild_plan
    let report_json = build_compositor_report_json(settings, plan_summary)

    write_file(compositor_rebuild_report_path(), report_json)

    return "compositor-report:" + settings.workspace_mode + ":layers=" + str(settings.runtime_pack_count + 3) + ":passes=" + str(settings.preview_count + 2)
