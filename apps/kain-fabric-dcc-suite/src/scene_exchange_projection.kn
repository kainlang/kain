fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn scene_exchange_report_path() -> String:
    return app_state_root() + "/scene_exchange_report.json"

fn build_scene_exchange_report_json(settings: Any, source_id: String, source_uri: String, scene_exchange_id: String, layer_policy: String, asset_registry_uri: String) -> String:
    let json = "{\n"
    let json = json + "  \"kind\": \"scene_exchange_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"source_id\": \"" + source_id + "\",\n"
    let json = json + "  \"source_uri\": \"" + source_uri + "\",\n"
    let json = json + "  \"scene_exchange_id\": \"" + scene_exchange_id + "\",\n"
    let json = json + "  \"layer_policy\": \"" + layer_policy + "\",\n"
    let json = json + "  \"asset_registry_uri\": \"" + asset_registry_uri + "\",\n"
    let json = json + "  \"exchange_policy\": \"usd_style_layer_composition_and_variant_authority\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let source_id = fabric_inputs.asset_ingest_session.source_id
    let source_uri = fabric_inputs.asset_ingest_session.source_uri
    let scene_exchange_id = fabric_inputs.scene_exchange_projection.scene_exchange_id
    let layer_policy = fabric_inputs.scene_exchange_projection.layer_policy
    let asset_registry_uri = fabric_inputs.asset_registry_lineage_projection.asset_registry_uri
    let report_json = build_scene_exchange_report_json(settings, source_id, source_uri, scene_exchange_id, layer_policy, asset_registry_uri)

    write_file(scene_exchange_report_path(), report_json)

    return "scene-exchange:" + scene_exchange_id + ":" + layer_policy
