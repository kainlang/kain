use std::interop::bridge

fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn render_accumulation_report_path() -> String:
    return app_state_root() + "/render_accumulation_report.json"

fn build_render_accumulation_report_json(settings: Any, pathtrace_buffer: Any, material_summary: String, svg_summary: String) -> String:
    let pathtrace_info = interop_shared_buffer_info(pathtrace_buffer)
    let pathtrace_sample_count = pathtrace_info.shape[0]
    let accumulation_passes = settings.runtime_pack_count + settings.preview_count + 1
    let aov_count = settings.runtime_pack_count + 3

    let json = "{\n"
    let json = json + "  \"kind\": \"render_accumulation_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"render_profile\": \"temporal_preview_accumulation\",\n"
    let json = json + "  \"gpu_step\": \"gpu_pathtrace_preview\",\n"
    let json = json + "  \"pathtrace_buffer_bytes\": " + str(pathtrace_info.byte_length) + ",\n"
    let json = json + "  \"pathtrace_sample_count\": " + str(pathtrace_sample_count) + ",\n"
    let json = json + "  \"accumulation_pass_count\": " + str(accumulation_passes) + ",\n"
    let json = json + "  \"aov_count\": " + str(aov_count) + ",\n"
    let json = json + "  \"upstream_material_summary\": \"" + material_summary + "\",\n"
    let json = json + "  \"upstream_svg_summary\": \"" + svg_summary + "\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let pathtrace_buffer = fabric_inputs.gpu_pathtrace_preview.pathtrace_dst
    let material_summary = fabric_inputs.material_authoring_projection.material_authoring_report
    let svg_summary = fabric_inputs.svg_material_mask_projection.svg_mask_report
    let report_json = build_render_accumulation_report_json(settings, pathtrace_buffer, material_summary, svg_summary)

    write_file(render_accumulation_report_path(), report_json)

    return "render-accumulation:" + settings.workspace_mode + ":bytes=" + str(interop_shared_buffer_info(pathtrace_buffer).byte_length) + ":passes=" + str(settings.runtime_pack_count + settings.preview_count + 1) + ":aov=" + str(settings.runtime_pack_count + 3)
