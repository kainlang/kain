use rust::fabric_dcc_suite_runtime
use std::interop::bridge

fn main() -> String:
    let sculpt_delta = fabric_inputs.gpu_sculpt_displacement.sculpt_delta
    let feature_info = interop_shared_buffer_info(sculpt_delta)
    let feature_bytes = interop_shared_buffer_bytes(sculpt_delta)
    let checksum = graph_checksum(feature_bytes)
    return build_analysis_report(
        feature_info.byte_length,
        checksum,
        fabric_inputs.dcc_suite_seed.scene_graph_document,
        fabric_inputs.native_sculpt_kernel.sculpt_signature
    )
