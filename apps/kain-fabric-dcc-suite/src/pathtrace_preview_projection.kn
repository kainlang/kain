use std::interop::bridge

fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn pathtrace_preview_report_path() -> String:
    return app_state_root() + "/pathtrace_preview_report.json"

fn build_pathtrace_preview_report_json(settings: Any, preview_buffer: Any, material_summary: String, svg_summary: String) -> String:
    let preview_info = interop_shared_buffer_info(preview_buffer)
    let preview_sample_count = preview_info.shape[0]
    let bounce_budget = settings.runtime_pack_count + 4

    let json = "{\n"
    let json = json + "  \"kind\": \"pathtrace_preview_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"render_profile\": \"pathtrace_hyperreal_preview\",\n"
    let json = json + "  \"gpu_step\": \"gpu_pathtrace_preview\",\n"
    let json = json + "  \"preview_buffer_bytes\": " + str(preview_info.byte_length) + ",\n"
    let json = json + "  \"preview_sample_count\": " + str(preview_sample_count) + ",\n"
    let json = json + "  \"bounce_budget\": " + str(bounce_budget) + ",\n"
    let json = json + "  \"upstream_material_summary\": \"" + material_summary + "\",\n"
    let json = json + "  \"upstream_svg_summary\": \"" + svg_summary + "\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let preview_buffer = fabric_inputs.gpu_pathtrace_preview.pathtrace_dst
    let material_summary = fabric_inputs.material_authoring_projection.material_authoring_report
    let svg_summary = fabric_inputs.svg_material_mask_projection.svg_mask_report
    let report_json = build_pathtrace_preview_report_json(settings, preview_buffer, material_summary, svg_summary)

    write_file(pathtrace_preview_report_path(), report_json)

    return "pathtrace-preview:" + settings.workspace_mode + ":bytes=" + str(interop_shared_buffer_info(preview_buffer).byte_length) + ":bounces=" + str(settings.runtime_pack_count + 4)
