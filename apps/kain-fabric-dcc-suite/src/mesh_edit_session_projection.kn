use c::dcc_suite_ops
use std::interop::bridge

struct MeshEditSessionOutputs:
    mesh_contract_signature: String
    mesh_topology_signature: String
    mesh_runtime_signature: String

fn main() -> MeshEditSessionOutputs:
    let contract = fabric_inputs.dcc_suite_seed.mesh_resource_contract_document
    let active_edit_target = fabric_inputs.dcc_suite_seed.active_editable_mesh_document
    let topology_output = fabric_inputs.dcc_suite_seed.topology_output_mesh_document
    let subdivision_report = fabric_inputs.mesh_subdivision_projection.mesh_subdivision_report
    let uv_pack_report = fabric_inputs.mesh_uv_pack_projection.mesh_uv_pack_report
    let mesh_contract_signature = dcc_suite_mesh_edit_target_signature(contract, active_edit_target, topology_output)
    let mesh_topology_signature = dcc_suite_mesh_topology_signature("catmull_clark_style", 2, 8, len(subdivision_report) + len(uv_pack_report))
    let mesh_runtime_signature = dcc_suite_mesh_runtime_signature("catmull_clark_style", 2, 8, len(subdivision_report) + len(uv_pack_report))
    return MeshEditSessionOutputs {
        mesh_contract_signature: mesh_contract_signature,
        mesh_topology_signature: mesh_topology_signature,
        mesh_runtime_signature: mesh_runtime_signature
    }
