fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn asset_lineage_report_path() -> String:
    return app_state_root() + "/asset_lineage_report.json"

fn build_asset_lineage_report_json(settings: Any, source_id: String, source_uri: String, lineage_id: String, transcode_profile_id: String, scene_exchange_id: String) -> String:
    let json = "{\n"
    let json = json + "  \"kind\": \"asset_lineage_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"source_id\": \"" + source_id + "\",\n"
    let json = json + "  \"source_uri\": \"" + source_uri + "\",\n"
    let json = json + "  \"lineage_id\": \"" + lineage_id + "\",\n"
    let json = json + "  \"transcode_profile_id\": \"" + transcode_profile_id + "\",\n"
    let json = json + "  \"scene_exchange_id\": \"" + scene_exchange_id + "\",\n"
    let json = json + "  \"dependency_policy\": \"content_addressed_and_manifest_registered\",\n"
    let json = json + "  \"residency_policy\": \"registry_visible_and_session_routable\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let source_id = fabric_inputs.asset_ingest_session.source_id
    let source_uri = fabric_inputs.asset_ingest_session.source_uri
    let transcode_profile_id = fabric_inputs.asset_ingest_session.transcode_profile_id
    let lineage_id = fabric_inputs.asset_ingest_session.lineage_id
    let scene_exchange_id = fabric_inputs.scene_exchange_projection.scene_exchange_id
    let report_json = build_asset_lineage_report_json(settings, source_id, source_uri, lineage_id, transcode_profile_id, scene_exchange_id)

    write_file(asset_lineage_report_path(), report_json)

    return "asset-lineage:" + lineage_id + ":" + scene_exchange_id
