use c::dcc_suite_ops
use std::interop::bridge

struct NativeSculptOutputs:
    sculpt_signature: String
    sculpt_report: String

fn sculpt_checksum(bytes: Array<Int>) -> Int:
    let checksum = 0
    let index = 0
    while index < len(bytes):
        checksum = (checksum + bytes[index] * ((index % 17) + 3)) % 1000003
        index = index + 1
    return checksum

fn count_active_samples(bytes: Array<Int>) -> Int:
    let active = 0
    let index = 0
    while index + 3 < len(bytes):
        if bytes[index] > 0 || bytes[index + 1] > 0 || bytes[index + 2] > 0 || bytes[index + 3] > 0:
            active = active + 1
        index = index + 4
    return active

fn main() -> NativeSculptOutputs:
    let sculpt_delta = fabric_inputs.gpu_sculpt_displacement.sculpt_delta
    let sculpt_bytes = interop_shared_buffer_bytes(sculpt_delta)
    let checksum = sculpt_checksum(sculpt_bytes)
    let active_samples = count_active_samples(sculpt_bytes)
    let sculpt_signature = dcc_suite_sculpt_signature(32, checksum, 53)
    let sculpt_report = dcc_suite_sculpt_report(32, active_samples, checksum, 53)
    return NativeSculptOutputs {
        sculpt_signature: sculpt_signature,
        sculpt_report: sculpt_report
    }
