use c::dcc_suite_ops
use std::interop::bridge

struct NativeSculptOutputs:
    sculpt_delta: Any
    sculpt_signature: String

fn main() -> NativeSculptOutputs:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let preview = fabric_inputs.dcc_suite_seed.preview_image
    let preview_info = interop_shared_image_info(preview)
    dcc_suite_apply_sculpt_stamp(preview, preview_info.byte_length, settings.brush_accent)
    let bytes = interop_shared_image_bytes(preview)
    let sculpt_delta = interop_shared_buffer_from_bytes(
        bytes,
        "u8",
        [len(bytes)],
        "rgba8",
        "application/octet-stream"
    )
    let sculpt_signature = dcc_suite_signature(preview_info.width, preview_info.height, settings.brush_accent)
    return NativeSculptOutputs {
        sculpt_delta: sculpt_delta,
        sculpt_signature: sculpt_signature
    }
