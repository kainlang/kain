fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn rig_sync_report_path() -> String:
    return app_state_root() + "/rig_sync_report.json"

fn build_rig_sync_report_json(settings: Any, topology_report: String) -> String:
    let has_native_ik_solver = false
    let has_bone_runtime = false
    let control_state_uri = "rig://control/current"
    let deformation_output_uri = "rig://deformation/output/current"
    let solver_bridge_uri = "rig://solver/bridge/current"

    let json = "{\n"
    let json = json + "  \"kind\": \"rig_sync_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"rig_profile\": \"control_sync_and_deformation_readiness\",\n"
    let json = json + "  \"topology_report\": \"" + topology_report + "\",\n"
    let json = json + "  \"control_state_uri\": \"" + control_state_uri + "\",\n"
    let json = json + "  \"deformation_output_uri\": \"" + deformation_output_uri + "\",\n"
    let json = json + "  \"solver_bridge_uri\": \"" + solver_bridge_uri + "\",\n"
    let json = json + "  \"has_native_ik_solver\": " + str(has_native_ik_solver) + ",\n"
    let json = json + "  \"has_bone_runtime\": " + str(has_bone_runtime) + ",\n"
    let json = json + "  \"extension_seam\": \"external Rust/C++ animation runtime via FFI\",\n"
    let json = json + "  \"limitation\": \"Kain does not yet own a native high-performance IK solver or bone evaluation engine\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let topology_report = fabric_inputs.rig_graph_analysis.topology_report
    let report_json = build_rig_sync_report_json(settings, topology_report)

    write_file(rig_sync_report_path(), report_json)

    return "rig-sync-report:" + settings.workspace_mode + ":topology=" + topology_report
