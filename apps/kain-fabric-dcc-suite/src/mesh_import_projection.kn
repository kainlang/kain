fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn imported_mesh_payload_report_path() -> String:
    return app_state_root() + "/imported_mesh_payload_report.json"

fn build_imported_mesh_payload_report_json(settings: Any, mesh_document: String) -> String:
    let imported_asset_count = settings.runtime_pack_count + 1
    let retained_payload_count = settings.preview_count + 2
    let json = "{\n"
    let json = json + "  \"kind\": \"imported_mesh_payload_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"mesh_document_id\": \"mesh_document/imported_payloads\",\n"
    let json = json + "  \"resource_uri\": \"mesh://imports/current/payloads\",\n"
    let json = json + "  \"authoring_policy\": \"imports_first_then_primitives\",\n"
    let json = json + "  \"imported_asset_count\": " + str(imported_asset_count) + ",\n"
    let json = json + "  \"retained_payload_count\": " + str(retained_payload_count) + ",\n"
    let json = json + "  \"active_edit_target\": \"mesh://editing/active\",\n"
    let json = json + "  \"topology_output\": \"mesh://topology/output/current\",\n"
    let json = json + "  \"upstream_mesh_document\": \"" + mesh_document + "\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let mesh_document = fabric_inputs.dcc_suite_seed.scene_graph_document
    let report_json = build_imported_mesh_payload_report_json(settings, mesh_document)

    write_file(imported_mesh_payload_report_path(), report_json)

    return "mesh-import:" + settings.workspace_mode + ":imports=" + str(settings.runtime_pack_count + 1) + ":payloads=" + str(settings.preview_count + 2)
