fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn tensor_train_dispatch_path() -> String:
    return app_state_root() + "/tensor_train_dispatch.json"

fn tensor_train_checkpoint_path() -> String:
    return app_state_root() + "/tensor_train_checkpoint.json"

fn build_tensor_train_dispatch_json(settings: Any, report: Any, topology_report: String) -> String:
    let dispatch_status = "planned"
    if report.status == "ready":
        dispatch_status = "queued"

    let json = "{\n"
    let json = json + "  \"kind\": \"tensor_train_dispatch\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"dispatch_status\": \"" + dispatch_status + "\",\n"
    let json = json + "  \"dispatch_mode\": \"" + report.dispatch_mode + "\",\n"
    let json = json + "  \"model_architecture\": \"" + report.model_architecture + "\",\n"
    let json = json + "  \"dataset_uri\": \"" + report.dataset_uri + "\",\n"
    let json = json + "  \"epochs\": " + str(report.epochs) + ",\n"
    let json = json + "  \"batch_size\": " + str(report.batch_size) + ",\n"
    let json = json + "  \"feature_byte_length\": " + str(report.byte_length) + ",\n"
    let json = json + "  \"checkpoint_path\": \"" + report.checkpoint_path + "\",\n"
    let json = json + "  \"topology_report\": \"" + topology_report + "\"\n"
    let json = json + "}\n"
    return json

fn build_tensor_train_checkpoint_json(settings: Any, report: Any, topology_report: String) -> String:
    let embedding_width = report.byte_length + settings.tensor_feature_count
    let checkpoint = "{\n"
    let checkpoint = checkpoint + "  \"kind\": \"tensor_train_checkpoint\",\n"
    let checkpoint = checkpoint + "  \"project\": \"" + settings.project_name + "\",\n"
    let checkpoint = checkpoint + "  \"model_architecture\": \"" + report.model_architecture + "\",\n"
    let checkpoint = checkpoint + "  \"embedding_width\": " + str(embedding_width) + ",\n"
    let checkpoint = checkpoint + "  \"epochs_completed\": " + str(report.epochs) + ",\n"
    let checkpoint = checkpoint + "  \"checkpoint_tag\": \"" + report.checkpoint_tag + "\",\n"
    let checkpoint = checkpoint + "  \"topology_report\": \"" + topology_report + "\"\n"
    let checkpoint = checkpoint + "}\n"
    return checkpoint

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let report = fabric_inputs.tensor_train_stage.tensor_training_report
    let topology_report = fabric_inputs.rig_graph_analysis.topology_report
    let dispatch_json = build_tensor_train_dispatch_json(settings, report, topology_report)
    let checkpoint_json = build_tensor_train_checkpoint_json(settings, report, topology_report)

    write_file(tensor_train_dispatch_path(), dispatch_json)
    write_file(tensor_train_checkpoint_path(), checkpoint_json)

    return "tensor-train-dispatch:" + report.status + ":receipt=" + tensor_train_dispatch_path() + ":checkpoint=" + tensor_train_checkpoint_path()
