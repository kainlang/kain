fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn sim_tick_report_path() -> String:
    return app_state_root() + "/sim_tick_report.json"

fn build_sim_tick_report_json(settings: Any, plan_summary: String) -> String:
    let simulated_frames = settings.preview_count
    let cache_segments = settings.tensor_feature_count + 1
    let replay_checksum = (settings.preview_count * settings.brush_accent) + settings.tensor_feature_count

    let json = "{\n"
    let json = json + "  \"kind\": \"sim_tick_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"solver_profile\": \"cloth_preview_dispatch\",\n"
    let json = json + "  \"simulated_frames\": " + str(simulated_frames) + ",\n"
    let json = json + "  \"cache_segments\": " + str(cache_segments) + ",\n"
    let json = json + "  \"replay_checksum\": " + str(replay_checksum) + ",\n"
    let json = json + "  \"plan_summary\": \"" + plan_summary + "\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let plan_summary = fabric_inputs.sim_tick_projection.sim_tick_plan
    let report_json = build_sim_tick_report_json(settings, plan_summary)

    write_file(sim_tick_report_path(), report_json)

    return "sim-report:" + settings.workspace_mode + ":frames=" + str(settings.preview_count) + ":segments=" + str(settings.tensor_feature_count + 1)
