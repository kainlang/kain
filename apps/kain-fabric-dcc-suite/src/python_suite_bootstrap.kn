struct MeshContractResourceUris:
    importedMeshPayloadDocument: String
    authoredPrimitiveDefinitionDocument: String
    topologyHistoryMeshDocument: String
    activeEditableMeshDocument: String
    meshUvLayoutMeshDocument: String
    meshRuntimeSignatureDocument: String
    topologyOutputMeshDocument: String
    meshSubdivisionMeshDocument: String

struct ProjectSettings:
    projectName: String
    viewportWidth: Int
    viewportHeight: Int
    brushAccent: Int
    previewCount: Int
    tensorFeatureCount: Int
    runtimePackCount: Int
    workspaceMode: String
    sculptGridResolution: Int
    sculptSampleCount: Int
    sculptCenterXMilli: Int
    sculptCenterYMilli: Int
    sculptRadiusMilli: Int
    sculptStrengthMilli: Int
    sculptFalloffMilli: Int
    sculptInvert: Bool
    sculptHeightMinMilli: Int
    sculptHeightMaxMilli: Int
    meshContractResourceUris: MeshContractResourceUris

fn main() -> ProjectSettings:
    let meshContractResourceUris = MeshContractResourceUris {
        importedMeshPayloadDocument: "mesh://imports/current/payloads",
        authoredPrimitiveDefinitionDocument: "mesh://primitives/authored/definitions",
        topologyHistoryMeshDocument: "mesh://topology/history/current",
        activeEditableMeshDocument: "mesh://editing/active",
        meshUvLayoutMeshDocument: "mesh://uv/layout/current",
        meshRuntimeSignatureDocument: "mesh://runtime/native-helper/current",
        topologyOutputMeshDocument: "mesh://topology/output/current",
        meshSubdivisionMeshDocument: "mesh://topology/subdivision/current"
    }
    return ProjectSettings {
        projectName: "fabric-dcc-suite",
        viewportWidth: 1600,
        viewportHeight: 960,
        brushAccent: 53,
        previewCount: 16,
        tensorFeatureCount: 12,
        runtimePackCount: 12,
        workspaceMode: "scene_assembly",
        sculptGridResolution: 32,
        sculptSampleCount: 1024,
        sculptCenterXMilli: 500,
        sculptCenterYMilli: 500,
        sculptRadiusMilli: 260,
        sculptStrengthMilli: 180,
        sculptFalloffMilli: 620,
        sculptInvert: false,
        sculptHeightMinMilli: 120,
        sculptHeightMaxMilli: 1480,
        meshContractResourceUris: meshContractResourceUris
    }
