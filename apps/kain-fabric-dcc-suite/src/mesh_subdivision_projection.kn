fn mesh_subdivision_report_path() -> String:
    return app_state_root() + "/mesh_subdivision_report.json"

fn build_mesh_subdivision_report_json(settings: Any, mesh_document: String, edit_target: String, topology_document: String) -> String:
    let subdivision_levels = settings.preview_count + 2
    let face_rule = "quad-first"
    let edit_target_route = "mesh://editing/active -> mesh://topology/subdivision/current -> mesh://topology/output/current"
    let json = "{\n"
    let json = json + "  \"kind\": \"mesh_subdivision_report\",\n"
    let json = json + "  \"mesh_document_id\": \"mesh_document/subdivision\",\n"
    let json = json + "  \"resource_uri\": \"mesh://topology/subdivision/current\",\n"
    let json = json + "  \"subdivision_policy\": \"catmull_clark_style\",\n"
    let json = json + "  \"subdivision_levels\": " + str(subdivision_levels) + ",\n"
    let json = json + "  \"face_rule\": \"" + face_rule + "\",\n"
    let json = json + "  \"edit_target_mesh_document\": \"" + edit_target + "\",\n"
    let json = json + "  \"topology_output_mesh_document\": \"" + topology_document + "\",\n"
    let json = json + "  \"edit_target_route\": \"" + edit_target_route + "\",\n"
    let json = json + "  \"upstream_mesh_document\": \"" + mesh_document + "\",\n"
    let json = json + "  \"limitation\": \"Kain can stage Catmull-Clark-style subdivision as a durable contract, but the heavy remesh math still belongs behind a native runtime seam.\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let mesh_document = fabric_inputs.dcc_suite_seed.scene_graph_document
    let edit_target = fabric_inputs.dcc_suite_seed.mesh_resource_contract_document
    let topology_document = fabric_inputs.dcc_suite_seed.mesh_resource_contract_document
    let report_json = build_mesh_subdivision_report_json(settings, mesh_document, edit_target, topology_document)
    write_file(mesh_subdivision_report_path(), report_json)
    return "mesh-subdivision:" + settings.workspace_mode + ":policy=catmull_clark_style"
