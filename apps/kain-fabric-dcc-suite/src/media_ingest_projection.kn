fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn media_ingest_report_path() -> String:
    return app_state_root() + "/media_ingest_report.json"

fn build_media_ingest_report_json(settings: Any, source_id: String, source_uri: String, transcode_profile_id: String, media_route_id: String, review_proxy_kind: String) -> String:
    let json = "{\n"
    let json = json + "  \"kind\": \"media_ingest_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"source_id\": \"" + source_id + "\",\n"
    let json = json + "  \"source_uri\": \"" + source_uri + "\",\n"
    let json = json + "  \"transcode_profile_id\": \"" + transcode_profile_id + "\",\n"
    let json = json + "  \"media_route_id\": \"" + media_route_id + "\",\n"
    let json = json + "  \"review_proxy_kind\": \"" + review_proxy_kind + "\",\n"
    let json = json + "  \"delivery_policy\": \"clip_ingest_decode_cache_and_transcode_safe\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let source_id = fabric_inputs.asset_ingest_session.source_id
    let source_uri = fabric_inputs.asset_ingest_session.source_uri
    let transcode_profile_id = fabric_inputs.asset_ingest_session.transcode_profile_id
    let media_route_id = fabric_inputs.media_runtime_projection.media_route_id
    let review_proxy_kind = fabric_inputs.media_runtime_projection.review_proxy_kind
    let report_json = build_media_ingest_report_json(settings, source_id, source_uri, transcode_profile_id, media_route_id, review_proxy_kind)

    write_file(media_ingest_report_path(), report_json)

    return "media-ingest:" + media_route_id + ":" + review_proxy_kind
