fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn topology_history_report_path() -> String:
    return app_state_root() + "/topology_history_report.json"

fn build_topology_history_report_json(settings: Any, topology_report: String, mesh_resource_contract_document: String, active_edit_target_document: String, topology_output_document: String) -> String:
    let rebuild_count = settings.runtime_pack_count + settings.preview_count + 1
    let json = "{\n"
    let json = json + "  \"kind\": \"topology_history_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"mesh_document_id\": \"topology_history_mesh_document\",\n"
    let json = json + "  \"resource_uri\": \"mesh://topology/history/current\",\n"
    let json = json + "  \"history_policy\": \"topology_rebuild_lineage\",\n"
    let json = json + "  \"rebuild_count\": " + str(rebuild_count) + ",\n"
    let json = json + "  \"mesh_resource_contract_document\": \"" + mesh_resource_contract_document + "\",\n"
    let json = json + "  \"active_edit_target\": \"" + active_edit_target_document + "\",\n"
    let json = json + "  \"topology_output\": \"" + topology_output_document + "\",\n"
    let json = json + "  \"topology_report\": \"" + topology_report + "\",\n"
    let json = json + "  \"upstream_mesh_document\": \"" + active_edit_target_document + "\",\n"
    let json = json + "  \"limitation\": \"Kain can retain topology lineage as a durable report, but it still needs a native solver seam for true undoable retopology and replacement-graph persistence.\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let mesh_resource_contract_document = fabric_inputs.dcc_suite_seed.mesh_resource_contract_document
    let active_edit_target_document = fabric_inputs.dcc_suite_seed.active_editable_mesh_document
    let topology_output_document = fabric_inputs.dcc_suite_seed.topology_output_mesh_document
    let topology_report = fabric_inputs.rig_graph_analysis.topology_report
    let report_json = build_topology_history_report_json(settings, topology_report, mesh_resource_contract_document, active_edit_target_document, topology_output_document)

    write_file(topology_history_report_path(), report_json)

    return "topology-history:" + settings.workspace_mode + ":rebuilds=" + str(settings.runtime_pack_count + settings.preview_count + 1)
