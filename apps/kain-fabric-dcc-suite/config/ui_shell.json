    "dock_spine": {
    "title": "Workbench Dock Spine",
    "summary": "Persistent dock groups that keep tabs, panes, and persistent rails mounted like a workstation instead of a page.",
    "regions": {
      "left": {
        "role": "authoring_rail",
        "behavior": "pinned",
        "tab_policy": "stacked",
        "pane_policy": "persistent",
        "group_ids": ["workspace_navigator", "scene_graph", "asset_ingest", "tool_shelf"]
      },
      "right": {
        "role": "inspector_rail",
        "behavior": "pinned",
        "tab_policy": "stacked",
        "pane_policy": "persistent",
        "group_ids": ["selection_inspector", "runtime_lane_map", "property_grid", "report_browser", "asset_registry", "asset_pipeline_manifest", "publish_console"]
      },
      "bottom": {
        "role": "execution_rail",
        "behavior": "pinned",
        "tab_policy": "stacked",
        "pane_policy": "persistent",
        "group_ids": ["status_strip", "animation_timeline", "jobs_monitor", "compositor_stack", "rig_graph", "simulation_board"]
      },
      "top": {
        "role": "command_rail",
        "behavior": "anchored",
        "tab_policy": "single",
        "pane_policy": "launcher",
        "group_ids": ["command_palette"]
      },
      "center": {
        "role": "stage_surface",
        "behavior": "locked",
        "tab_policy": "single",
        "pane_policy": "primary",
        "group_ids": ["viewport_stage"]
      }
