    "operator_notes": {
      "eyebrow": "Operator Context",
      "title": "Workbench stance",
      "summary": "The shell should feel like a mounted DCC workstation: docked, dense, and unapologetically functional.",
      "notes": [
        "Keep the active lane obvious at all times.",
        "Favor docked panes over card stacks and feed-like layouts.",
        "Keep command dispatch, inspector routing, and layout return paths obvious.",
        "Keep the runtime lane map one click away so bridge seams stay inspectable.",
        "Favor Kain-authored orchestration over hidden host magic; keep the native C ABI, Rust crate, GPU, Python, and Node seams visible.",
        "Treat the render spine as pathtrace -> accumulation -> denoise, with report receipts visible even before the runtime seam exists.",
        "Use the shell as a real workstation frame, not a showcase scaffold.",
        "Prefer fixed dock regions over document-flow panes.",
        "Keep viewport, rails, and inspector stacks anchored instead of expanding like a web page.",
        "If a surface reads like a card or feed, restyle it as a docked workstation pane or remove it from the main frame.",
        "Treat scroll as an exception, not the default navigation model.",
        "Make the viewport, lane rail, inspectors, and status strip feel mechanically mounted to the shell."
      ]
    }
