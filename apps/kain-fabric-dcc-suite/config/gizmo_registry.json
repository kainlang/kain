{
  "schema_version": 1,
  "profiles": [
    {
      "id": "dcc_transform_universal",
      "label": "Universal Transform Gizmo",
      "summary": "Shared translate, rotate, and scale gizmo contract for layout, modeling, rigging, and clip blocking lanes.",
      "visible": true,
      "drag_trigger": "ctrl_primary_drag",
      "selection_required": true,
      "default_space": "world",
      "hotkeys": {
        "translate": "T",
        "rotate": "R",
        "scale": "Y",
        "cycle_space": "U",
        "toggle_snap": "I"
      },
      "snap": {
        "translate_world_units": 0.5,
        "rotate_degrees": 15.0,
        "scale_percent": 10.0,
        "default_enabled": false
      },
      "overlays": {
        "show_mode_badge": true,
        "show_space_badge": true,
        "show_snap_badge": true
      }
    }
  ],
  "viewport_bindings": [
    {
      "id": "primary_dcc_viewport",
      "surface_id": "viewport_stage",
      "scene": "dcc_suite_scene",
      "presentation_profile": "dcc_authoring_balanced",
      "gizmo_profile_id": "dcc_transform_universal",
      "default_mode": "translate",
      "default_space": "world"
    }
  ]
}
