shader compute DccSuiteSvgMaskRaster(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("dcc_suite_svg_mask_raster", "svg_mask_raster", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let source_value = src[index]
    let anchor_weight = (source_value * 0.22) + 0.10
    let boolean_weight = (source_value * 0.16) + 0.14
    let trim_weight = (source_value * 0.28) + 0.05
    let rasterized_value = anchor_weight + boolean_weight + trim_weight
    dst[index] = rasterized_value
    return vec4(rasterized_value, anchor_weight, boolean_weight, trim_weight)
