shader compute DccSuiteCompositorIdMatte(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("dcc_suite_compositor_id_matte", "compositor_id_matte", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let source_value = src[index]
    let hero_matte = (source_value * 0.33) + 0.17
    let utility_matte = (source_value * 0.21) + 0.09
    let isolation_matte = (source_value * 0.14) + 0.07
    let matte_value = hero_matte + utility_matte + isolation_matte
    dst[index] = matte_value
    return vec4(matte_value, hero_matte, utility_matte, isolation_matte)
