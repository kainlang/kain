shader compute DccSuiteMaterialLayerBlendPreview(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("dcc_suite_material_layer_blend_preview", "layer_blend_preview", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let source_value = src[index]
    let fill_weight = (source_value * 0.45) + 0.08
    let paint_weight = (source_value * 0.25) + 0.12
    let generator_weight = (source_value * 0.18) + 0.06
    let blended_value = fill_weight + paint_weight + generator_weight
    dst[index] = blended_value
    return vec4(blended_value, fill_weight, paint_weight, generator_weight)
