{
  "mcpServers": {
    "kain-mcp": {
      "command": "kain",
      "args": [
        "run",
        "blades/kain-mcp"
      ],
      "cwd": ".",
      "env": {
        "KAIN_REPO_ROOT": ".",
        "KAIN_BAZEL_CONFIG": "dev",
        "KAIN_BAZEL_LAUNCHER_DIR": "D:/Kain-Bazel/bin",
        "KAIN_NO_BANNER": "1"
      }
    }
  }
}
