#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer SrcBuffer {
    vec3 src[];
};

layout(set = 0, binding = 1, std430) writeonly buffer DstBuffer {
    vec3 dst[];
};

layout(set = 0, binding = 2, std140) uniform CountBlock {
    uint count;
};

layout(set = 0, binding = 3, std140) uniform WidthBlock {
    uint width;
};

void main() {
    uint idx = gl_GlobalInvocationID.x + (gl_GlobalInvocationID.y * width);
    if (idx >= count) {
        return;
    }
    dst[idx] = src[idx];
}

