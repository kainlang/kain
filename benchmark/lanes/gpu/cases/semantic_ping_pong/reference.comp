#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer CurrentPositions {
    vec4 values[];
} current_positions;

layout(set = 0, binding = 1, std430) readonly buffer HistoryPositions {
    vec4 values[];
} history_positions;

layout(set = 0, binding = 2, std430) writeonly buffer NextPositions {
    vec4 values[];
} next_positions;

layout(set = 0, binding = 3, std430) readonly buffer AlphaPerJoint {
    float values[];
} alpha_per_joint;

layout(set = 0, binding = 4, std430) readonly buffer ModePerJoint {
    int values[];
} mode_per_joint;

layout(set = 0, binding = 5, std430) readonly buffer ParentIndex {
    int values[];
} parent_index;

layout(set = 0, binding = 6) uniform CountBlock {
    uint value;
} count_block;

layout(set = 0, binding = 7) uniform TimeBaseBlock {
    float value;
} time_base_block;

layout(set = 0, binding = 8) uniform RoundPhaseBlock {
    float value;
} round_phase_block;

layout(set = 0, binding = 9) uniform GainBlock {
    float value;
} gain_block;

layout(set = 0, binding = 10) uniform EpsBlock {
    float value;
} eps_block;

layout(set = 0, binding = 11) uniform WidthBlock {
    uint value;
} width_block;

void main() {
    uint idx = gl_GlobalInvocationID.x + (gl_GlobalInvocationID.y * width_block.value);
    if (idx >= count_block.value) {
        return;
    }

    vec4 cur = current_positions.values[idx];
    vec4 hist = history_positions.values[idx];
    float alpha = alpha_per_joint.values[idx];
    int mode = mode_per_joint.values[idx];
    int parent = parent_index.values[idx];
    float parent_gate = parent < 0 ? 0.0 : 1.0;
    float t = time_base_block.value + round_phase_block.value + float(idx) * 0.000173;

    vec3 base = mix(cur.xyz, hist.xyz, 0.22 + alpha * 0.13);
    vec3 normal = normalize(base + vec3(eps_block.value + parent_gate * 0.001, 0.0, 0.0));
    vec3 tangent = cross(vec3(0.0, 1.0, 0.0), normal);
    int lane = mode % 6;

    vec3 accum = base;
    if (lane == 0) {
        accum = accum + normal * gain_block.value;
    } else if (lane == 1) {
        accum = accum + vec3(sin(t), cos(t * 1.3), sin(t * 0.7)) * (gain_block.value * (0.5 + alpha));
    } else if (lane == 2) {
        vec3 flipped = vec3(hist.z, hist.x, hist.y);
        accum = mix(accum, flipped, 0.35 + alpha * 0.15);
    } else if (lane == 3) {
        float lift = max(0.0, sin(t * 0.5)) * gain_block.value;
        accum = vec3(accum.x + tangent.x * lift, accum.y + lift, accum.z + tangent.z * lift);
    } else if (lane == 4) {
        float squash = 1.0 + cos(t * 0.9) * 0.25 * gain_block.value;
        accum = vec3(accum.x * squash, accum.y / max(squash, eps_block.value), accum.z * squash);
    } else {
        accum = accum + cross(normal, tangent + vec3(alpha, 0.0, parent_gate)) * (0.35 * gain_block.value);
    }

    int octave = 0;
    vec3 wobble = vec3(0.0, 0.0, 0.0);
    float freq = 1.0;
    float amp = 0.18 * gain_block.value;
    while (octave < 3) {
        float phase = t * freq + alpha * (float(octave) + 1.0);
        vec3 dir = vec3(cos(phase), sin(phase * 1.7), cos(phase * 0.5));
        wobble = wobble + normalize(dir + tangent + vec3(eps_block.value, 0.0, 0.0)) * amp;
        freq *= 2.03;
        amp *= 0.5;
        octave += 1;
    }

    accum = accum + wobble;

    float pulse = 0.0;
    for (int k = 1; k < 4; ++k) {
        pulse += sin(t * float(k)) * (0.03 * alpha);
    }

    accum = mix(accum, hist.xyz + normal * pulse, 0.2 + parent_gate * 0.05);
    vec4 out_v = vec4(accum.x, accum.y, accum.z, cur.w + 0.25 + alpha * 0.5 + round_phase_block.value * 0.01);
    next_positions.values[idx] = out_v;
}
