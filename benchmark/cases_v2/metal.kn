    if case_id == "asm_pause_storm":
        let c = "{"
        c = c + "\"metal_surface\":" + metal_json_string("inline-asm") + ","
        c = c + "\"instructions\":" + metal_json_string("pause,nop") + ","
        c = c + "\"asm_options\":" + metal_json_string("volatile") + ","
        c = c + "\"c_involved\":false,"
        c = c + "\"python_involved\":false,"
