pub fn core_os_case_expected_checksum(index: Int) -> Int:
    if index == 0:  return 0
    if index == 1:  return 0
    if index == 2:  return 0
    if index == 3:  return 0
    if index == 4:  return 0
    if index == 5:  return 0
    if index == 6:  return 0
    if index == 7:  return 0
    if index == 8:  return 0
    if index == 9:  return 0
