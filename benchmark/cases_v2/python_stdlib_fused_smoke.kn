use python_stdlib_fused::python_stdlib_fused_case_checksum
use python_stdlib_fused::python_stdlib_fused_case_count
use python_stdlib_fused::python_stdlib_fused_case_expected_checksum
use python_stdlib_fused::python_stdlib_fused_case_id
use python_stdlib_fused::python_stdlib_fused_case_iterations

// temporary smoke driver for direct execution proof
fn main() -> Int:
    let index = 0
    while index < python_stdlib_fused_case_count():
        let case_id = python_stdlib_fused_case_id(index)
        let iterations = python_stdlib_fused_case_iterations(index)
        let expected = python_stdlib_fused_case_expected_checksum(index)
        let actual = python_stdlib_fused_case_checksum(case_id, iterations, 1, 1000000007)
        println(case_id + " expected=" + str(expected) + " actual=" + str(actual))
        if actual != expected:
            return 1
        index = index + 1
    return 0
