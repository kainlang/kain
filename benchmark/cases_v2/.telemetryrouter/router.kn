    average_ms: Int
    total_work_units: Int
    ops_per_sec: Int
    best_ops_per_sec: Int
    worst_ops_per_sec: Int
    average_us_per_op: Int
    best_us_per_op: Int
    worst_us_per_op: Int
    jitter_ms: Int
    success: Bool
    failure_code: Int
    track_path: String
    case_telemetry_json: String

