        println("benchmark router v2 selected no cases")
        return 3

    let finished_ms = now_millis()
    let telemetry = capture_runtime_telemetry()
    let failures = write_summary_reports(config, telemetry, started_ms, finished_ms, case_count, success_count, failure_count, cases_json_items, table_rows)
