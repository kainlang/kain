// ============================================================================
// MATH PACK — Stdlib Math Expansion Benchmarks
// Tests complex numbers, dual quaternions, quaternion power-ups,
// matrix power-ups, easing, perlin/simplex noise, special functions,
// number theory, packing, spherical harmonics, and physics helpers.
// ============================================================================

use std::math

const MATH_CASE_COUNT: Int = 15
const MATH_MODULUS: Int = 1000000007

// ============================================================================
// CASE REGISTRY
// ============================================================================

pub fn math_pack_case_count() -> Int:
    return MATH_CASE_COUNT

