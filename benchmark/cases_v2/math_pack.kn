    if index == 8: return "perlin_simplex"
    if index == 9: return "number_theory"
    if index == 10: return "special_functions"
    if index == 11: return "physics_spring"
    if index == 12: return "packing"
    if index == 13: return "sh_eval"
    if index == 14: return "complex_special"
    return ""

