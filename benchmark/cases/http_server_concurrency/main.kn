use std::runtime
use std::actor
use std::net

fn main() -> Int:
    let _runtime = runtime_init()
    let _reset = net_reset()

    if net_platform_available() != 1:
        let _shutdown_unavailable = runtime_shutdown()
        return 0

    let rounds: Int = 240
    let modulus: Int = 1000000007
    let expected: Int = 5215
    let request_body = "hello-actor"
    let request_text = "POST /actor?proof=1 HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 11\r\n\r\nhello-actor"
    let server = http_server_create_localhost(0)
    if server <= 0:
        return 1
    if http_server_listen(server) != 0:
        return 2
    let port = http_server_local_port(server)
    if port <= 0:
        return 3
    let handler = actor_spawn("NetFixtureHandler", "requests=0")
    if handler <= 0:
        println("http_server_concurrency handler spawn failed")
        return 12
    let route_status = http_route_actor(server, "POST", "/actor", handler, "HttpRequest")
    if route_status != 0:
        println("http_server_concurrency route failed status=" + str(route_status))
        return 13

    var acc: Int = 0
    var index: Int = 0
    while index < rounds:
        let client = tcp_connect("127.0.0.1", port, 5000)
        if client <= 0:
            return 4
        let write_status = tcp_write_text(client, request_text)
        if write_status != 0:
            println("http_server_concurrency write failed status=" + str(write_status))
            return 14
        let incoming = http_server_pump(server, 5000)
        if incoming <= 0:
            println("http_server_concurrency pump status=" + str(net_last_status()))
            println("http_server_concurrency pump kind=" + net_last_error_kind())
            println("http_server_concurrency pump message=" + net_last_error_message())
            return 5
        let next = http_server_next_request(server)
        if next != incoming:
            return 6
        let method = http_request_method(incoming)
        let path = http_request_path(incoming)
        let body = http_request_body_text(incoming)
        if method != "POST":
            return 7
        if path != "/actor":
            return 8
        if body != request_body:
            return 9
        let _respond = http_respond_text(incoming, 200, "reply-ok-123")
        let response_text = tcp_read_text(client)
        if response_text == "":
            return 10
        acc = (acc + len(body) + (index % 23)) % modulus
        let _close = tcp_close(client)
        index = index + 1

    let _server_close = http_server_close(server)
    let _shutdown = runtime_shutdown()
    if acc != expected:
        return 11
    return 0
