fn dispatch_score(kind: Int, bias: Int, value: Int) -> Int:
    if kind == 0:
        return value + (bias * 3) + 7
    if kind == 1:
        return (value * (bias + 5)) + 11
    if kind == 2:
        return ((value + bias) % 257) + (bias * 13)
    if kind == 3:
        return (value * value) + (bias * 17) + 3
    if kind == 4:
        return (value * 9) + (bias * bias) + 19
    if kind == 5:
        return (((value + 31) * (bias + 7)) % 4099) + 23
    if kind == 6:
        return (value * 5) + ((bias + 1) * 29)
    return ((value * 7) ^ (bias * 41)) + 37

fn main() -> Int:
    let kernel_count: Int = 64
    let iterations: Int = 1800000
    let modulus: Int = 1000000007
    let expected: Int = 185456717
    var acc: Int = 0
    var index: Int = 0
    while index < iterations:
        let slot: Int = index % kernel_count
        let kind: Int = ((slot * 5) + 3) % 8
        let bias: Int = ((slot * 17) % 23) + 1
        let value: Int = ((index * 13) + 7) % 1009
        let score: Int = dispatch_score(kind, bias, value)
        acc = (acc + score + slot) % modulus
        index = index + 1

    if acc != expected:
        return 1
    return 0
