fn idx(x: Int, y: Int, z: Int, nx: Int, ny: Int) -> Int:
    return z * nx * ny + y * nx + x

fn idx_u(x: Int, y: Int, z: Int, nx: Int, ny: Int) -> Int:
    return z * (nx + 1) * ny + y * (nx + 1) + x

fn idx_v(x: Int, y: Int, z: Int, nx: Int, ny: Int) -> Int:
    return z * nx * (ny + 1) + y * nx + x

fn idx_w(x: Int, y: Int, z: Int, nx: Int, ny: Int) -> Int:
    return z * nx * ny + y * nx + x

fn main() -> Int:
    let nx: Int = 8
    let ny: Int = 6
    let nz: Int = 5
    let cell_count: Int = nx * ny * nz
    let vx_count: Int = (nx + 1) * ny * nz
    let vy_count: Int = nx * (ny + 1) * nz
    let vz_count: Int = nx * ny * (nz + 1)
    let steps: Int = 140
    let jacobi_iters: Int = 8
    let modulus: Int = 1000000007
    let expected: Int = 56427256
    let dt: Float = 0.035
    let cell_size: Float = 0.125
    let gravity_y: Float = -0.14
    let buoyancy: Float = 0.32

    let mut velocity_x: ptr<Float> = alloc_zeroed(vx_count, "Float")
    let mut velocity_y: ptr<Float> = alloc_zeroed(vy_count, "Float")
    let mut velocity_z: ptr<Float> = alloc_zeroed(vz_count, "Float")
    let mut pressure: ptr<Float> = alloc_zeroed(cell_count, "Float")
    let mut pressure_old: ptr<Float> = alloc_zeroed(cell_count, "Float")
    let mut divergence: ptr<Float> = alloc_zeroed(cell_count, "Float")
    let mut temperature: ptr<Float> = alloc_zeroed(cell_count, "Float")

    var z0: Int = 0
    while z0 < nz:
        var y0: Int = 0
        while y0 < ny:
            var x0: Int = 0
            while x0 < nx:
                let cell: Int = idx(x0, y0, z0, nx, ny)
                mem_store(ptr_offset(temperature, cell, "Float"), ((x0 * 3 + y0 * 5 + z0 * 7) % 11) as Float * 0.14, "Float")
                x0 = x0 + 1
            y0 = y0 + 1
        z0 = z0 + 1

    z0 = 0
    while z0 < nz:
        var y0: Int = 0
        while y0 < ny:
            var x0: Int = 0
            while x0 < nx + 1:
                let slot: Int = idx_u(x0, y0, z0, nx, ny)
                mem_store(ptr_offset(velocity_x, slot, "Float"), (((slot * 7) % 13) - 6) as Float * 0.03, "Float")
                x0 = x0 + 1
            y0 = y0 + 1
        z0 = z0 + 1

    z0 = 0
    while z0 < nz:
        var y0: Int = 0
        while y0 < ny + 1:
            var x0: Int = 0
            while x0 < nx:
                let slot: Int = idx_v(x0, y0, z0, nx, ny)
                mem_store(ptr_offset(velocity_y, slot, "Float"), (((slot * 5) % 17) - 8) as Float * 0.02, "Float")
                x0 = x0 + 1
            y0 = y0 + 1
        z0 = z0 + 1

    z0 = 0
    while z0 < nz + 1:
        var y0: Int = 0
        while y0 < ny:
            var x0: Int = 0
            while x0 < nx:
                let slot: Int = idx_w(x0, y0, z0, nx, ny)
                mem_store(ptr_offset(velocity_z, slot, "Float"), (((slot * 11) % 19) - 9) as Float * 0.025, "Float")
                x0 = x0 + 1
            y0 = y0 + 1
        z0 = z0 + 1

    var checksum: Int = 0
    var step: Int = 0
    while step < steps:
        z0 = 0
        while z0 < nz:
            var y_force: Int = 0
            while y_force < ny + 1:
                var x_force: Int = 0
                while x_force < nx:
                    let slot: Int = idx_v(x_force, y_force, z0, nx, ny)
                    var next_v: Float = mem_load(ptr_offset(velocity_y, slot, "Float"), "Float") + gravity_y * dt
                    if y_force < ny:
                        let cell: Int = idx(x_force, y_force, z0, nx, ny)
                        next_v = next_v + buoyancy * mem_load(ptr_offset(temperature, cell, "Float"), "Float") * dt
                    mem_store(ptr_offset(velocity_y, slot, "Float"), next_v, "Float")
                    x_force = x_force + 1
                y_force = y_force + 1
            z0 = z0 + 1

        z0 = 0
        while z0 < nz:
            var y_div: Int = 0
            while y_div < ny:
                var x_div: Int = 0
                while x_div < nx:
                    let cell: Int = idx(x_div, y_div, z0, nx, ny)
                    let u_right: Float = mem_load(ptr_offset(velocity_x, idx_u(x_div + 1, y_div, z0, nx, ny), "Float"), "Float")
                    let u_left: Float = mem_load(ptr_offset(velocity_x, idx_u(x_div, y_div, z0, nx, ny), "Float"), "Float")
                    let v_top: Float = mem_load(ptr_offset(velocity_y, idx_v(x_div, y_div + 1, z0, nx, ny), "Float"), "Float")
                    let v_bottom: Float = mem_load(ptr_offset(velocity_y, idx_v(x_div, y_div, z0, nx, ny), "Float"), "Float")
                    let w_front: Float = mem_load(ptr_offset(velocity_z, idx_w(x_div, y_div, z0 + 1, nx, ny), "Float"), "Float")
                    let w_back: Float = mem_load(ptr_offset(velocity_z, idx_w(x_div, y_div, z0, nx, ny), "Float"), "Float")
                    mem_store(ptr_offset(divergence, cell, "Float"), ((u_right - u_left) + (v_top - v_bottom) + (w_front - w_back)) / cell_size, "Float")
                    mem_store(ptr_offset(pressure, cell, "Float"), 0.0, "Float")
                    x_div = x_div + 1
                y_div = y_div + 1
            z0 = z0 + 1

        var iter: Int = 0
        while iter < jacobi_iters:
            var copy_index: Int = 0
            while copy_index < cell_count:
                mem_store(ptr_offset(pressure_old, copy_index, "Float"), mem_load(ptr_offset(pressure, copy_index, "Float"), "Float"), "Float")
                copy_index = copy_index + 1

            z0 = 1
            while z0 < nz - 1:
                var y_inner: Int = 1
                while y_inner < ny - 1:
                    var x_inner: Int = 1
                    while x_inner < nx - 1:
                        let cell: Int = idx(x_inner, y_inner, z0, nx, ny)
                        let p_sum: Float = mem_load(ptr_offset(pressure_old, idx(x_inner + 1, y_inner, z0, nx, ny), "Float"), "Float") + mem_load(ptr_offset(pressure_old, idx(x_inner - 1, y_inner, z0, nx, ny), "Float"), "Float") + mem_load(ptr_offset(pressure_old, idx(x_inner, y_inner + 1, z0, nx, ny), "Float"), "Float") + mem_load(ptr_offset(pressure_old, idx(x_inner, y_inner - 1, z0, nx, ny), "Float"), "Float") + mem_load(ptr_offset(pressure_old, idx(x_inner, y_inner, z0 + 1, nx, ny), "Float"), "Float") + mem_load(ptr_offset(pressure_old, idx(x_inner, y_inner, z0 - 1, nx, ny), "Float"), "Float")
                        let next_pressure: Float = (p_sum - cell_size * cell_size * mem_load(ptr_offset(divergence, cell, "Float"), "Float")) / 6.0
                        mem_store(ptr_offset(pressure, cell, "Float"), next_pressure, "Float")
                        x_inner = x_inner + 1
                    y_inner = y_inner + 1
                z0 = z0 + 1
            iter = iter + 1

        z0 = 1
        while z0 < nz - 1:
            var y_grad: Int = 1
            while y_grad < ny - 1:
                var x_grad: Int = 1
                while x_grad < nx:
                    let slot: Int = idx_u(x_grad, y_grad, z0, nx, ny)
                    let p_right: Float = mem_load(ptr_offset(pressure, idx(x_grad, y_grad, z0, nx, ny), "Float"), "Float")
                    let p_left: Float = mem_load(ptr_offset(pressure, idx(x_grad - 1, y_grad, z0, nx, ny), "Float"), "Float")
                    let next_vx: Float = mem_load(ptr_offset(velocity_x, slot, "Float"), "Float") - (p_right - p_left) / cell_size
                    mem_store(ptr_offset(velocity_x, slot, "Float"), next_vx, "Float")
                    x_grad = x_grad + 1
                y_grad = y_grad + 1
            z0 = z0 + 1

        z0 = 1
        while z0 < nz - 1:
            var y_grad: Int = 1
            while y_grad < ny:
                var x_grad: Int = 1
                while x_grad < nx - 1:
                    let slot: Int = idx_v(x_grad, y_grad, z0, nx, ny)
                    let p_top: Float = mem_load(ptr_offset(pressure, idx(x_grad, y_grad, z0, nx, ny), "Float"), "Float")
                    let p_bottom: Float = mem_load(ptr_offset(pressure, idx(x_grad, y_grad - 1, z0, nx, ny), "Float"), "Float")
                    let next_vy: Float = mem_load(ptr_offset(velocity_y, slot, "Float"), "Float") - (p_top - p_bottom) / cell_size
                    mem_store(ptr_offset(velocity_y, slot, "Float"), next_vy, "Float")
                    x_grad = x_grad + 1
                y_grad = y_grad + 1
            z0 = z0 + 1

        z0 = 1
        while z0 < nz:
            var y_grad: Int = 1
            while y_grad < ny - 1:
                var x_grad: Int = 1
                while x_grad < nx - 1:
                    let slot: Int = idx_w(x_grad, y_grad, z0, nx, ny)
                    let p_front: Float = mem_load(ptr_offset(pressure, idx(x_grad, y_grad, z0, nx, ny), "Float"), "Float")
                    let p_back: Float = mem_load(ptr_offset(pressure, idx(x_grad, y_grad, z0 - 1, nx, ny), "Float"), "Float")
                    let next_vz: Float = mem_load(ptr_offset(velocity_z, slot, "Float"), "Float") - (p_front - p_back) / cell_size
                    mem_store(ptr_offset(velocity_z, slot, "Float"), next_vz, "Float")
                    x_grad = x_grad + 1
                y_grad = y_grad + 1
            z0 = z0 + 1

        let sample: Int = (step * 7) % cell_count
        let pressure_bucket: Int = floor((mem_load(ptr_offset(pressure, sample, "Float"), "Float") + 64.0) * 4096.0) as Int
        let divergence_bucket: Int = floor((mem_load(ptr_offset(divergence, sample, "Float"), "Float") + 64.0) * 2048.0) as Int
        checksum = (checksum + pressure_bucket + divergence_bucket + step * 13) % modulus
        step = step + 1

    var sample_index: Int = 0
    while sample_index < cell_count:
        if (sample_index % 17) == 0:
            let pressure_bucket: Int = floor((mem_load(ptr_offset(pressure, sample_index, "Float"), "Float") + 64.0) * 1024.0) as Int
            let divergence_bucket: Int = floor((mem_load(ptr_offset(divergence, sample_index, "Float"), "Float") + 64.0) * 512.0) as Int
            checksum = (checksum + pressure_bucket + divergence_bucket + sample_index * 5) % modulus
        sample_index = sample_index + 1

    decay velocity_x
    decay velocity_y
    decay velocity_z
    decay pressure
    decay pressure_old
    decay divergence
    decay temperature

    if checksum != expected:
        return 1
    return 0
