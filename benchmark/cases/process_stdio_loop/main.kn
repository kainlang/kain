use std::process
use std::time

fn main() -> Int:
    let _reset = process_reset()
    if process_platform_available() != 1:
        return 0

    let benchmark_deadline: Int = deadline_millis(0)
    let rounds: Int = 300
    let expected: Int = 5988
    var acc: Int = 0
    var index: Int = 0
    while index < rounds:
        let stdout_text = process_output_text("cmd.exe", "/d", "/c", "echo process-bench", 5000)
        if stdout_text != "process-bench\r\n":
            return 4
        acc = acc + len(stdout_text) + (index % 11)
        index = index + 1

    if deadline_elapsed(benchmark_deadline) == false:
        return 2
    if acc != expected:
        return 5
    return 0
