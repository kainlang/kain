fn ready_value() -> impl Future<Int>:
    return async 2

fn main() -> Int:
    let iterations: Int = 200000
    let modulus: Int = 1000000007
    let expected: Int = 1399991
    var acc: Int = 0
    var i: Int = 0
    while i < iterations:
        let awaited: Int = await ready_value()
        acc = (acc + awaited + (i % 11)) % modulus
        i = i + 1

    if acc != expected:
        return 1
    return 0
