use std::python

import numpy as np

const MODULUS: Int = 1000000007
const ITERATIONS: Int = 20000
const BUFFER_CELLS: Int = 512
const EXPECTED: Int = 20899830

fn bool_score(value: Bool) -> Int:
    if value:
        return 1
    return 0

fn make_source_buffer() -> Any:
    let base = python_call_attr_raw(np, "arange", [BUFFER_CELLS])
    let bytes_view = python_call_attr_raw(base, "astype", ["uint8"])
    return python_call_attr_raw(np, "ascontiguousarray", [bytes_view])

fn main() -> Int:
    let source = make_source_buffer()
    var acc: Int = 0
    var index: Int = 0

    while index < ITERATIONS:
        let shared_buffer = python_shared_buffer(source)
        let lane = kain_shared_buffer_byte_length(shared_buffer) + kain_shared_buffer_element_count_value(shared_buffer) + kain_shared_buffer_element_size(shared_buffer) + kain_shared_buffer_zero_copy_flag(shared_buffer) + kain_shared_buffer_shared_ownership(shared_buffer) + (index % 37)
        kain_shared_buffer_release(shared_buffer)
        acc = (acc + lane) % MODULUS
        index = index + 1

    if acc != EXPECTED:
        return 1
    return 0
