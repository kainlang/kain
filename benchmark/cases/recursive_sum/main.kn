const ITERATIONS: Int = 5000
const DEPTH: Int = 128
const MODULUS: Int = 1000000007
const EXPECTED: Int = 41280000

fn recursive_sum(value: Int) -> Int:
    if value <= 0:
        return 0
    return value + recursive_sum(value - 1)

fn main() -> Int:
    var acc: Int = 0
    var i: Int = 0
    while i < ITERATIONS:
        acc = (acc + recursive_sum(DEPTH)) % MODULUS
        i = i + 1

    if acc != EXPECTED:
        return 1
    return 0
