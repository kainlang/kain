fn main() -> Int:
    let worker_count: Int = 100
    let iterations_per_worker: Int = 1000000
    let expected: Int = 100000000
    let stride: Int = sizeof_type("Int")
    let mut counter: ptr<Int> = alloc_zeroed(stride, "Int")

    var worker: Int = 0
    while worker < worker_count:
        collapse counter:
            var i: Int = 0
            while i < iterations_per_worker:
                let current: Int = mem_load(counter, "Int")
                mem_store(counter, current + 1, "Int")
                i = i + 1
            0
        worker = worker + 1

    let final_value: Int = observe counter:
        mem_load(counter, "Int")
    decay counter

    if final_value != expected:
        return 1
    return 0
