use catalog::benchmark_case_count
use catalog::benchmark_case_overview_a
use catalog::benchmark_case_overview_b
use catalog::benchmark_case_overview_c
use catalog::benchmark_case_overview_d
use catalog::benchmark_case_overview_e
use catalog::benchmark_language_cli
use catalog::benchmark_language_count
use layout::action_h
use layout::action_w
use layout::action_x
use layout::action_y
use layout::bench_window_height
use layout::bench_window_height_f
use layout::bench_window_width
use layout::bench_window_width_f
use layout::catalog_h
use layout::catalog_w
use layout::catalog_x
use layout::catalog_y
use layout::report_h
use layout::report_w
use layout::report_x
use layout::report_y
use layout::stat_h
use layout::stat_w
use layout::stat_x
use layout::stat_y
use layout::status_h
use layout::status_w
use layout::status_x
use layout::status_y
use layout::topbar_h
use layout::topbar_w
use layout::topbar_x
use layout::topbar_y
use runner::benchmark_root
use runner::latest_json_report_path
use runner::latest_llm_report_path
use runner::report_preview
use runner::run_full_benchmark
use runner::run_quick_benchmark
use theme::apply_button_theme
use theme::apply_dim_text
use theme::apply_metric_text
use theme::apply_report_text
use theme::apply_shell_theme
use theme::apply_title_text

component App():
    render <panel title="kain-benchmark" />

world BenchmarkAuthority:
    state run_count: Int = 0
    state selected_case: Int = 8
    surface native_ui => App

world BenchmarkMirror:
    state mirrored_run_count: Int = 0
    surface web => App

entangle BenchmarkAuthority.run_count <-> BenchmarkMirror.mirrored_run_count with single_writer

actor BenchmarkRunTracker:
    state total: Int = 0

    on MarkRun(value: Int):
        self.total = self.total + value

    on Stop():
        return

fn render_text_line(session: Int, node: Int, font: Int, baseline: Float) -> Int:
    return ui_render_text_in_box(session, node, font, 12.0, baseline, "ink")

fn render_box_label(session: Int, node: Int, font: Int, baseline: Float) -> Int:
    let _box = ui_render_box(session, node, "fill")
    return ui_render_text_in_box(session, node, font, 14.0, baseline, "ink")

fn handle_button_event(session: Int, node: Int) -> Int:
    if ui_event_targets(session, node) == 1:
        let _pressed = native_ui_node_set_flag(session, node, "pressed", 1)
        return 1
    return 0

fn text_equals(actual: String, expected: String) -> Int:
    if len(actual) != len(expected):
        return 0
    let mut index = 0
    while index < len(expected):
        if char_at(actual, index) != char_at(expected, index):
            return 0
        index = index + 1
    return 1

fn main() -> Int:
    let runtime_status = native_runtime_init()
    if runtime_status != 0:
        return 100 + runtime_status

    let _ui_reset = native_ui_reset()
    let _process_reset = process_reset()

    let authority = BenchmarkAuthority
    let mirror = BenchmarkMirror
    let tracker = spawn BenchmarkRunTracker(total = 0)
    let root_path = benchmark_root()
    let report_path = latest_llm_report_path()
    let json_path = latest_json_report_path()
    let auto_run = env("KAIN_BENCH_AUTORUN")
    var command_status = "idle"
    if text_equals(auto_run, "quick") == 1:
        command_status = run_quick_benchmark()
        authority.run_count = authority.run_count + 1

    var preview_a = report_preview(0, 150)
    var preview_b = report_preview(150, 150)
    var preview_c = report_preview(300, 150)
    var preview_d = report_preview(450, 150)

    let session = ui_host_session_create("kain-benchmark", "Kain Benchmark Console", bench_window_width(), bench_window_height(), "software")
    let generation = native_ui_hot_reload_begin(session, "benchmark.blade.rev-a")
    let body_font = native_ui_font_create(session, "font.bench.body", "JetBrains Mono", 13.0)
    let title_font = native_ui_font_create(session, "font.bench.title", "JetBrains Mono", 22.0)
    let small_font = native_ui_font_create(session, "font.bench.small", "JetBrains Mono", 11.0)

    let root = ui_reconcile_node(session, 0, "bench.root", "bench.root", 0.0, 0.0, bench_window_width_f(), bench_window_height_f())
    let topbar = ui_reconcile_text_node(session, root, "bench.topbar", "bench.topbar", "KAIN BENCHMARK / MULTI-LANGUAGE NATIVE LANE", topbar_x(), topbar_y(), topbar_w(), topbar_h())
    let quick_button = ui_reconcile_focusable_node(session, root, "bench.button", "bench.button.quick", "RUN QUICK", "button", "run quick benchmark", action_x(0), action_y(), action_w(), action_h())
    let full_button = ui_reconcile_focusable_node(session, root, "bench.button", "bench.button.full", "RUN ALL", "button", "run full benchmark", action_x(1), action_y(), action_w(), action_h())
    let refresh_button = ui_reconcile_focusable_node(session, root, "bench.button", "bench.button.refresh", "REFRESH", "button", "refresh latest report", action_x(2), action_y(), action_w(), action_h())
    let open_button = ui_reconcile_focusable_node(session, root, "bench.button", "bench.button.path", "REPORT PATHS", "button", "show report paths", action_x(3), action_y(), action_w(), action_h())

    let stat_cases = ui_reconcile_text_node(session, root, "bench.stat", "bench.stat.cases", "", stat_x(0), stat_y(), stat_w(), stat_h())
    let stat_langs = ui_reconcile_text_node(session, root, "bench.stat", "bench.stat.langs", "", stat_x(1), stat_y(), stat_w(), stat_h())
    let stat_runs = ui_reconcile_text_node(session, root, "bench.stat", "bench.stat.runs", "", stat_x(2), stat_y(), stat_w(), stat_h())
    let stat_root = ui_reconcile_text_node(session, root, "bench.stat", "bench.stat.root", "", stat_x(3), stat_y(), stat_w(), stat_h())

    let catalog = ui_reconcile_node(session, root, "bench.catalog", "bench.catalog", catalog_x(), catalog_y(), catalog_w(), catalog_h())
    let catalog_a = ui_reconcile_text_node(session, catalog, "bench.catalog.line", "bench.catalog.a", benchmark_case_overview_a(), catalog_x() + 16.0, catalog_y() + 22.0, 1128.0, 24.0)
    let catalog_b = ui_reconcile_text_node(session, catalog, "bench.catalog.line", "bench.catalog.b", benchmark_case_overview_b(), catalog_x() + 16.0, catalog_y() + 52.0, 1128.0, 24.0)
    let catalog_c = ui_reconcile_text_node(session, catalog, "bench.catalog.line", "bench.catalog.c", benchmark_case_overview_c(), catalog_x() + 16.0, catalog_y() + 82.0, 1128.0, 24.0)
    let catalog_d = ui_reconcile_text_node(session, catalog, "bench.catalog.line", "bench.catalog.d", benchmark_case_overview_d(), catalog_x() + 16.0, catalog_y() + 112.0, 1128.0, 24.0)
    let catalog_e = ui_reconcile_text_node(session, catalog, "bench.catalog.line", "bench.catalog.e", benchmark_case_overview_e(), catalog_x() + 16.0, catalog_y() + 142.0, 1128.0, 24.0)

    let report = ui_reconcile_node(session, root, "bench.report", "bench.report", report_x(), report_y(), report_w(), report_h())
    let report_title = ui_reconcile_text_node(session, report, "bench.report.title", "bench.report.title", "LATEST LLM REPORT", report_x() + 16.0, report_y() + 26.0, 1128.0, 24.0)
    let report_a = ui_reconcile_text_node(session, report, "bench.report.line", "bench.report.a", preview_a, report_x() + 16.0, report_y() + 62.0, 1128.0, 24.0)
    let report_b = ui_reconcile_text_node(session, report, "bench.report.line", "bench.report.b", preview_b, report_x() + 16.0, report_y() + 96.0, 1128.0, 24.0)
    let report_c = ui_reconcile_text_node(session, report, "bench.report.line", "bench.report.c", preview_c, report_x() + 16.0, report_y() + 130.0, 1128.0, 24.0)
    let report_d = ui_reconcile_text_node(session, report, "bench.report.line", "bench.report.d", preview_d, report_x() + 16.0, report_y() + 164.0, 1128.0, 24.0)
    let report_paths = ui_reconcile_text_node(session, report, "bench.report.paths", "bench.report.paths", report_path, report_x() + 16.0, report_y() + 222.0, 1128.0, 24.0)
    let status = ui_reconcile_text_node(session, root, "bench.status", "bench.status", "", status_x(), status_y(), status_w(), status_h())

    let _shell = apply_shell_theme(session, root, topbar, catalog, report, status)
    let _title = apply_title_text(session, topbar)
    let _quick_theme = apply_button_theme(session, quick_button, 0)
    let _full_theme = apply_button_theme(session, full_button, 0)
    let _refresh_theme = apply_button_theme(session, refresh_button, 0)
    let _open_theme = apply_button_theme(session, open_button, 0)
    let _stat_cases_theme = apply_metric_text(session, stat_cases)
    let _stat_langs_theme = apply_metric_text(session, stat_langs)
    let _stat_runs_theme = apply_metric_text(session, stat_runs)
    let _stat_root_theme = apply_metric_text(session, stat_root)
    let _catalog_a_theme = apply_dim_text(session, catalog_a)
    let _catalog_b_theme = apply_dim_text(session, catalog_b)
    let _catalog_c_theme = apply_dim_text(session, catalog_c)
    let _catalog_d_theme = apply_dim_text(session, catalog_d)
    let _catalog_e_theme = apply_dim_text(session, catalog_e)
    let _report_title_theme = apply_title_text(session, report_title)
    let _report_a_theme = apply_report_text(session, report_a)
    let _report_b_theme = apply_report_text(session, report_b)
    let _report_c_theme = apply_report_text(session, report_c)
    let _report_d_theme = apply_report_text(session, report_d)
    let _report_path_theme = apply_dim_text(session, report_paths)
    let _status_theme = apply_metric_text(session, status)

    var frame = 0
    while frame < 30000 and (native_ui_host_should_close(session) == 0 or frame < 96):
        let _pump = native_ui_host_pump(session)
        while native_ui_poll_event(session) == 1:
            if handle_button_event(session, quick_button) == 1:
                command_status = run_quick_benchmark()
                authority.run_count = authority.run_count + 1
                send tracker.MarkRun(value = 1)
            if handle_button_event(session, full_button) == 1:
                command_status = run_full_benchmark()
                authority.run_count = authority.run_count + 1
                send tracker.MarkRun(value = 1)
            if handle_button_event(session, refresh_button) == 1:
                command_status = "refreshed"
            if handle_button_event(session, open_button) == 1:
                command_status = "llm=" + report_path + " json=" + json_path

        preview_a = report_preview(0, 150)
        preview_b = report_preview(150, 150)
        preview_c = report_preview(300, 150)
        preview_d = report_preview(450, 150)

        let _frame = ui_frame_begin(session, 16.0)
        let _stat_cases = native_ui_node_set_text(session, stat_cases, "cases: " + str(benchmark_case_count()))
        let _stat_langs = native_ui_node_set_text(session, stat_langs, "languages: " + str(benchmark_language_count()) + " / " + benchmark_language_cli())
        let _stat_runs = native_ui_node_set_text(session, stat_runs, "runs: " + str(authority.run_count) + " mirror: " + str(mirror.mirrored_run_count))
        let _stat_root = native_ui_node_set_text(session, stat_root, root_path)
        let _preview_a = native_ui_node_set_text(session, report_a, preview_a)
        let _preview_b = native_ui_node_set_text(session, report_b, preview_b)
        let _preview_c = native_ui_node_set_text(session, report_c, preview_c)
        let _preview_d = native_ui_node_set_text(session, report_d, preview_d)
        let _status_text = native_ui_node_set_text(session, status, "status: " + command_status)

        let _draw_root = ui_render_box(session, root, "fill")
        let _draw_topbar = ui_render_box(session, topbar, "fill")
        let _draw_catalog = ui_render_box(session, catalog, "fill")
        let _draw_report = ui_render_box(session, report, "fill")
        let _draw_status = ui_render_box(session, status, "fill")
        let _draw_title = render_text_line(session, topbar, title_font, 34.0)
        let _draw_quick = render_box_label(session, quick_button, body_font, 26.0)
        let _draw_full = render_box_label(session, full_button, body_font, 26.0)
        let _draw_refresh = render_box_label(session, refresh_button, body_font, 26.0)
        let _draw_open = render_box_label(session, open_button, body_font, 26.0)
        let _draw_stat_cases = render_text_line(session, stat_cases, small_font, 24.0)
        let _draw_stat_langs = render_text_line(session, stat_langs, small_font, 24.0)
        let _draw_stat_runs = render_text_line(session, stat_runs, small_font, 24.0)
        let _draw_stat_root = render_text_line(session, stat_root, small_font, 24.0)
        let _draw_cat_a = render_text_line(session, catalog_a, small_font, 18.0)
        let _draw_cat_b = render_text_line(session, catalog_b, small_font, 18.0)
        let _draw_cat_c = render_text_line(session, catalog_c, small_font, 18.0)
        let _draw_cat_d = render_text_line(session, catalog_d, small_font, 18.0)
        let _draw_cat_e = render_text_line(session, catalog_e, small_font, 18.0)
        let _draw_report_title = render_text_line(session, report_title, body_font, 20.0)
        let _draw_report_a = render_text_line(session, report_a, small_font, 18.0)
        let _draw_report_b = render_text_line(session, report_b, small_font, 18.0)
        let _draw_report_c = render_text_line(session, report_c, small_font, 18.0)
        let _draw_report_d = render_text_line(session, report_d, small_font, 18.0)
        let _draw_report_paths = render_text_line(session, report_paths, small_font, 18.0)
        let _draw_status_line = render_text_line(session, status, small_font, 22.0)
        let _submit = ui_frame_submit(session)
        frame = frame + 1

    send tracker.Stop()
    let _commit = native_ui_hot_reload_commit(session)
    let _destroy = native_ui_session_destroy(session)
    return native_runtime_cleanup_status(0)
