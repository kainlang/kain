pub fn apply_shell_theme(session: Int, root: Int, topbar: Int, catalog: Int, report: Int, status: Int) -> Int:
    let _root = ui_style_color_rgba(session, root, "fill", 0.025, 0.030, 0.040, 1.0)
    let _topbar = ui_style_color_rgba(session, topbar, "fill", 0.070, 0.084, 0.110, 0.98)
    let _catalog = ui_style_color_rgba(session, catalog, "fill", 0.048, 0.055, 0.070, 0.98)
    let _report = ui_style_color_rgba(session, report, "fill", 0.030, 0.035, 0.047, 0.98)
    return ui_style_color_rgba(session, status, "fill", 0.075, 0.082, 0.095, 0.98)

pub fn apply_button_theme(session: Int, node: Int, active: Int) -> Int:
    if active != 0:
        let _fill = ui_style_color_rgba(session, node, "fill", 0.140, 0.740, 0.560, 0.92)
        return ui_style_color_rgba(session, node, "ink", 0.030, 0.036, 0.042, 1.0)
    let _fill = ui_style_color_rgba(session, node, "fill", 0.145, 0.170, 0.210, 0.96)
    return ui_style_color_rgba(session, node, "ink", 0.900, 0.930, 0.960, 1.0)

pub fn apply_title_text(session: Int, node: Int) -> Int:
    return ui_style_color_rgba(session, node, "ink", 0.975, 0.965, 0.920, 1.0)

pub fn apply_dim_text(session: Int, node: Int) -> Int:
    return ui_style_color_rgba(session, node, "ink", 0.650, 0.720, 0.800, 1.0)

pub fn apply_metric_text(session: Int, node: Int) -> Int:
    return ui_style_color_rgba(session, node, "ink", 0.860, 0.920, 0.960, 1.0)

pub fn apply_report_text(session: Int, node: Int) -> Int:
    return ui_style_color_rgba(session, node, "ink", 0.770, 0.850, 0.800, 1.0)
