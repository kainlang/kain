pub fn benchmark_language_count() -> Int:
    return 7

pub fn benchmark_language_label(index: Int) -> String:
    if index == 0:
        return "KAIN LLVM"
    if index == 1:
        return "RUST LLVM"
    if index == 2:
        return "C++ CLANG"
    if index == 3:
        return "ZIG RELEASEFAST"
    if index == 4:
        return "GO GC"
    if index == 5:
        return "NODE JS"
    return "CPYTHON"

pub fn benchmark_language_cli() -> String:
    return "kain,rust,cpp,zig,go,javascript,python"

pub fn benchmark_case_count() -> Int:
    return 47

pub fn benchmark_case_overview_a() -> String:
    return "semantic_singularity / kain-core-pressure  |  actor_mailbox_erlang / implemented  |  async_ready_chain / implemented"

pub fn benchmark_case_overview_b() -> String:
    return "native_map_lookup / implemented  |  http_server_frameworks / semantic-proxy  |  tcp_loopback_tokio / implemented"

pub fn benchmark_case_overview_c() -> String:
    return "ecs_archetype_query / implemented  |  zero_copy_binary_wire / implemented  |  dynamic_vtable_thrashing / dispatch-proxy"

pub fn benchmark_case_overview_d() -> String:
    return "crypto_block_cipher / implemented  |  ray_sphere_intersection / implemented  |  machine_stones_shatter_loop / implemented"

