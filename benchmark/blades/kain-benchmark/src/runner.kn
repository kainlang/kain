use catalog::benchmark_language_cli

pub fn benchmark_root() -> String:
    if fs_exists(fs_path_join(".", "benchmarks.json")):
        return "."

    let nested = "benchmark"
    if fs_exists(fs_path_join(nested, "benchmarks.json")):
        return nested

    let up_one = ".."
    if fs_exists(fs_path_join(up_one, "benchmarks.json")):
        return up_one

    let up_two = fs_path_join(up_one, "..")
    if fs_exists(fs_path_join(up_two, "benchmarks.json")):
        return up_two

    let up_three = fs_path_join(up_two, "..")
    if fs_exists(fs_path_join(up_three, "benchmarks.json")):
        return up_three

    return "."

pub fn latest_llm_report_path() -> String:
    return fs_path_join(fs_path_join(benchmark_root(), "out"), "reports/latest.llm.md")

pub fn latest_json_report_path() -> String:
    return fs_path_join(fs_path_join(benchmark_root(), "out"), "reports/latest.json")

pub fn report_preview(offset: Int, length: Int) -> String:
    let path = latest_llm_report_path()
    if fs_exists(path):
        return fs_read_text_range(path, offset, length)
    return "no latest.llm.md yet"

pub fn run_benchmark_suite(case_filter: String, runs: Int, warmups: Int, timeout_ms: Int) -> String:
    let root = benchmark_root()
    let spec = process_spec_create_piped("python")
    let _cwd = process_spec_set_cwd(spec, root)
    let _run_py = process_spec_add_arg(spec, "run.py")
    let _runs_key = process_spec_add_arg(spec, "--runs")
    let _runs_value = process_spec_add_arg(spec, str(runs))
    let _warmups_key = process_spec_add_arg(spec, "--warmups")
    let _warmups_value = process_spec_add_arg(spec, str(warmups))
    let _languages_key = process_spec_add_arg(spec, "--languages")
    let _languages_value = process_spec_add_arg(spec, benchmark_language_cli())
    if len(case_filter) > 0:
        let _case_key = process_spec_add_arg(spec, "--case")
        let _case_value = process_spec_add_arg(spec, case_filter)

    let child = process_spawn(spec)
    if child <= 0:
        return "spawn failed: " + process_last_error_kind() + " / " + process_last_error_message()

    let done = process_wait(child, timeout_ms)
    let code = process_exit_code(child)
    let stdout_text = process_stdout_capture_text(child)
    let stderr_text = process_stderr_capture_text(child)
    let _close = process_close(child)

    var summary = "done=" + str(done) + " exit=" + str(code)
    if len(stdout_text) > 0:
        summary = summary + " stdout=" + stdout_text
    if len(stderr_text) > 0:
        summary = summary + " stderr=" + stderr_text
    return summary

pub fn run_quick_benchmark() -> String:
    return run_benchmark_suite("scalar_mix", 1, 0, 240000)

pub fn run_full_benchmark() -> String:
    return run_benchmark_suite("", 3, 1, 1200000)
