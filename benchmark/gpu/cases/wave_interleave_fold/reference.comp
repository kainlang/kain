#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer SrcPackets {
    vec4 values[];
} src_packets;

layout(set = 0, binding = 1, std430) writeonly buffer DstPackets {
    vec4 values[];
} dst_packets;

layout(set = 0, binding = 2) uniform CountBlock {
    uint value;
} count_block;

layout(set = 0, binding = 3) uniform WidthBlock {
    uint value;
} width_block;

layout(set = 0, binding = 4) uniform BiasBlock {
    uint value;
} bias_block;

void main() {
    uint idx = gl_GlobalInvocationID.x + (gl_GlobalInvocationID.y * width_block.value);
    if (idx >= count_block.value) {
        return;
    }

    vec4 packet = src_packets.values[idx];
    int lane = int((idx + bias_block.value) % 5u);
    float bias_value = float(bias_block.value);
    float step = float((idx % 113u) + 1u);
    float base0 = packet.x + step + bias_value;
    float base1 = packet.y + step + 13.0;
    float base2 = packet.z + packet.x + 21.0;
    float base3 = packet.w + packet.y + 29.0;

    float out0 = base0;
    float out1 = base1;
    float out2 = base2;
    float out3 = base3;
    if (lane == 0) {
        out0 = base0 + base2;
        out1 = base1 + base0 + 7.0;
        out2 = base2 + base3;
        out3 = base3 + step;
    } else if (lane == 1) {
        out0 = base0 + packet.w + 11.0;
        out1 = base1 + base2 + 17.0;
        out2 = base2 + packet.y + 19.0;
        out3 = base3 + packet.x + 23.0;
    } else if (lane == 2) {
        out0 = base0 + base3 + 31.0;
        out1 = base1 + packet.z + 37.0;
        out2 = base2 + base0 + 41.0;
        out3 = base3 + packet.y + 43.0;
    } else if (lane == 3) {
        out0 = base0 + base1 + 47.0;
        out1 = base1 + packet.x + 53.0;
        out2 = base2 + packet.w + 59.0;
        out3 = base3 + base2 + 61.0;
    } else {
        out0 = base0 + packet.y + 67.0;
        out1 = base1 + base3 + 71.0;
        out2 = base2 + packet.x + 73.0;
        out3 = base3 + step + 79.0;
    }

    dst_packets.values[idx] = vec4(out0, out1, out2, out3);
}
