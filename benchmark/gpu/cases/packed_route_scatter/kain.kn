shader compute packed_route_scatter(id: UVec3) -> Void:
    uniform src_packets: StorageBuffer<Vec4> @0
    uniform dst_packets: StorageBuffer<Vec4> @1
    uniform count: UInt @2
    uniform width: UInt @3
    uniform bias: UInt @4
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    let idx = id.x + (id.y * width)
    if idx >= count:
        return

    let packet = src_packets[idx]
    let lane = ((idx + bias) % 6) as Int
    let bias_value = bias as Float
    let step = ((idx % 97) + 1) as Float
    let a = packet.x + step + bias_value
    let b = packet.y + step + 17.0
    let c = packet.z + packet.x + 23.0
    let d = packet.w + packet.y + 31.0

    let mut out0 = a
    let mut out1 = b
    let mut out2 = c
    let mut out3 = d
    if lane == 0:
        out0 = a + b
        out1 = b + d
        out2 = c + a
        out3 = d + step
    else:
        if lane == 1:
            out0 = a + c
            out1 = b + packet.x + 29.0
            out2 = c + d
            out3 = d + packet.z
        else:
            if lane == 2:
                out0 = a + d + 7.0
                out1 = b + a + 31.0
                out2 = c + packet.y + 3.0
                out3 = d + c + 5.0
            else:
                if lane == 3:
                    out0 = a + packet.w + step
                    out1 = b + c + 43.0
                    out2 = c + packet.x + 11.0
                    out3 = d + a + 13.0
                else:
                    if lane == 4:
                        out0 = a + packet.y + 59.0
                        out1 = b + d + 61.0
                        out2 = c + packet.w + 15.0
                        out3 = d + packet.x + 19.0
                    else:
                        out0 = a + b + 71.0
                        out1 = b + packet.z + 73.0
                        out2 = c + d + 79.0
                        out3 = d + packet.y + 83.0

    dst_packets[idx] = vec4(out0, out1, out2, out3)
    return

fn main() -> Int:
    return 0
