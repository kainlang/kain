fn compute_all() -> Int with Unsafe:
    println("=== CASES_V3 Kain Expected Values ===")
    println("  binary_trees          => " + str(bt_run()))
    println("  nbody                 => " + str(nb_run()))
    println("  spectral_norm         => " + str(sn_run()))
    println("  mandelbrot            => " + str(mb_run()))
    println("  fasta                 => " + str(fa_run()))
    println("  regex_redux           => " + str(rr_run()))
    println("  pidigits              => " + str(pd_run()))
    println("  hashmap_heavy         => " + str(hm_run()))
    println("  btree_scan            => " + str(bs_run()))
    println("  sort_gauntlet         => " + str(sg_run()))
    println("  vector_growth         => " + str(vg_run()))
    println("  graph_bfs             => " + str(gb_run()))
    println("  alloc_small_churn     => " + str(asc_run()))
    println("  alloc_large_objects   => " + str(alo_run()))
    println("  arena_vs_malloc       => " + str(avm_run()))
    println("  cache_march           => " + str(cm_run()))
    println("  rc_vs_gc_trace        => " + str(rg_run()))
    println("  parallel_reduce       => " + str(pr_run()))
    println("  mutex_contention      => " + str(mc_run()))
    println("  spsc_queue            => " + str(spsc_run()))
    println("  mpmc_queue            => " + str(mpmc_run()))
