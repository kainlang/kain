// ============================================================================
//  BENCH 18: parallel_reduce -- uses share/fanout
// ============================================================================

const PR_N: Int = 500000

fn pr_run() -> Int with Unsafe:
    rng_reset()
    let n: Int = PR_N
    let data: ptr<Int> = alloc_zeroed(n, "Int")
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(data, i, "Int"), rng_next() % MODULUS, "Int")
        i = i + 1
    let nw: Int = thread_logical_count()
    let parts: ptr<Int> = alloc_zeroed(nw, "Int")
    // NOTE: share/fanout cannot capture outer locals in LLVM codegen.
    // Use sequential reduction as fallback.
    var wi: Int = 0
    while wi < nw:
        let ch: Int = n / nw
        let st: Int = wi * ch
        let en: Int = if wi == nw - 1: n else: st + ch
        var loc: Int = 0
        var j: Int = st
        while j < en:
            loc = (loc + mem_load(ptr_offset(data, j, "Int"), "Int")) % MODULUS
            j = j + 1
        mem_store(ptr_offset(parts, wi, "Int"), loc, "Int")
        wi = wi + 1
    var tot: Int = 0
    var wj: Int = 0
    while wj < nw:
        tot = (tot + mem_load(ptr_offset(parts, wj, "Int"), "Int")) % MODULUS
        wj = wj + 1
    decay data
    decay parts
    return tot

fn bench_parallel_reduce() -> Int with Unsafe:
    let res = pr_run()
    if PARALLEL_REDUCE_EXPECTED != 0 and res != PARALLEL_REDUCE_EXPECTED:
        return 1
    return 0

