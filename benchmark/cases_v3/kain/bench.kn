// ============================================================================

const RG_N: Int = 100000
const RG_EP: Int = 100

fn rg_run() -> Int with Unsafe:
    rng_reset()
    let n: Int = RG_N
    let nd: ptr<Int> = alloc_zeroed(n * 3, "Int")
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(nd, i*3+0, "Int"), i, "Int")
        mem_store(ptr_offset(nd, i*3+1, "Int"), (i*17) % MODULUS, "Int")
        mem_store(ptr_offset(nd, i*3+2, "Int"), 0, "Int")
        i = i + 1
    var ei: Int = 0
    while ei < n:
        var ej: Int = ei + 1
        while ej < n:
            if rng_next() % 100 < RG_EP:
                mem_store(ptr_offset(nd, ei*3+2, "Int"), ptr_to_int(ptr_offset(nd, ej*3, "Int")), "Int")
            ej = ej + 1
        ei = ei + 1
    var cs: Int = 0
    var vi: Int = 0
    while vi < n:
        cs = (cs + mem_load(ptr_offset(nd, vi*3+1, "Int"), "Int")) % MODULUS
        let ri: Int = mem_load(ptr_offset(nd, vi*3+2, "Int"), "Int")
        if ri != 0:
            let rp: ptr<Int> = int_to_ptr(ri, "Int")
            cs = (cs + mem_load(ptr_offset(rp, 1, "Int"), "Int")) % MODULUS
        vi = vi + 1
    decay nd
    return cs

