//  BENCH 11: vector_growth
// ============================================================================

const VG_N: Int = 10000

fn vg_run() -> Int with Unsafe:
    let n: Int = VG_N
    let buf: ptr<Int> = alloc_zeroed(n, "Int")
    var cs: Int = 0
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(buf, i, "Int"), i % MODULUS, "Int")
        if i > 0 and i % 100 == 0:
            var cs2: Int = 0
            var j: Int = i - 100
            if j < 0: j = 0
            while j <= i:
                cs2 = (cs2 + mem_load(ptr_offset(buf, j, "Int"), "Int")) % MODULUS
                j = j + 1
            cs = (cs + cs2) % MODULUS
        i = i + 1
    decay buf
    return cs

