    return 0

// ============================================================================
//  BENCH 23: async_ready_pipeline (sequential fallback for LLVM codegen)
//  NOTE: async/await LLVM codegen is pending.
//  Uses sequential computation of the same checksum.
// ============================================================================

const AP_NF: Int = 1000
const AP_NR: Int = 10000

fn ap_run() -> Int:
    var cs: Int = 0
    var rd: Int = 0
    while rd < AP_NR:
        var fi: Int = 0
        while fi < AP_NF:
            cs = (cs + (fi * 7) % MODULUS) % MODULUS
            fi = fi + 1
        rd = rd + 1
    return cs

fn bench_async_ready_pipeline() -> Int:
    let res = ap_run()
    if ASYNC_READY_EXPECTED != 0 and res != ASYNC_READY_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 24: file_read_streaming
// ============================================================================

const FRS_SZ: Int = 262144
const FRS_CH: Int = 65536

fn frs_run() -> Int:
    rng_reset()
    let tmp: String = fs_temp_file("v3rd_")
    var cs: Int = 0
    var wn: Int = 0
    while wn < FRS_SZ:
        var builder = text_builder_new()
        var fi: Int = 0
        while fi < FRS_CH / 64:
            let val: Int = rng_next() % 256
            let hi: Int = val / 16
            let lo: Int = val % 16
            builder = text_builder_push_char_code(builder, if hi < 10: 48+hi else: 87+hi)
            builder = text_builder_push_char_code(builder, if lo < 10: 48+lo else: 87+lo)
            fi = fi + 1
        let hex: String = text_builder_build(builder)
        fs_append_text(tmp, hex)
        wn = wn + FRS_CH
    let txt: String = fs_read_text(tmp)
    var ci: Int = 0
    let tl: Int = len(txt)
    while ci < tl:
        cs = v3_mix(cs, ascii_byte_of(char_at(txt, ci)))
        ci = ci + 1
    fs_remove_file(tmp)
    return cs

fn bench_file_read_streaming() -> Int:
    let res = frs_run()
    if FILE_READ_EXPECTED != 0 and res != FILE_READ_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 25: file_write_streaming
// ============================================================================

const FWS_SZ: Int = 1073741824
const FWS_CH: Int = 65536

fn fws_run() -> Int:
    rng_reset()
    let tmp: String = fs_temp_file("v3wr_")
    var cs: Int = 0
    var wn: Int = 0
    while wn < FWS_SZ:
        var builder = text_builder_new()
        var fi: Int = 0
        while fi < FWS_CH / 64:
            let val: Int = rng_next() % 256
            cs = v3_mix(cs, val)
            let hi: Int = val / 16
            let lo: Int = val % 16
            builder = text_builder_push_char_code(builder, if hi < 10: 48+hi else: 87+hi)
            builder = text_builder_push_char_code(builder, if lo < 10: 48+lo else: 87+lo)
            fi = fi + 1
        let hex: String = text_builder_build(builder)
        fs_append_text(tmp, hex)
        wn = wn + FWS_CH
    fs_remove_file(tmp)
    return cs

fn bench_file_write_streaming() -> Int:
    let res = fws_run()
    if FILE_WRITE_EXPECTED != 0 and res != FILE_WRITE_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 26: tcp_echo_throughput
// ============================================================================
// Ported from cases/tcp_loopback_tokio/main.kn (verified working, 400 rounds)

const TE_N: Int = 400
const TE_PAYLOAD: String = "kain-net-benchmark"
const TE_RESPONSE: String = "kain-net-pong"

fn te_run() -> Int:
    let lst: Int = tcp_listen("127.0.0.1", 0)
    if lst <= 0:
        return 0
    let port: Int = tcp_listener_local_port(lst)
    if port <= 0:
        return 0
    var acc: Int = 0
    var rt: Int = 0
    while rt < TE_N:
        let cli: Int = tcp_connect("127.0.0.1", port, 5000)
        if cli <= 0:
            return 0
        let srv: Int = tcp_accept(lst, 5000)
        if srv <= 0:
            return 0
        let _ = tcp_write_text(cli, TE_PAYLOAD)
        let rx = tcp_read_text(srv)
        if rx != TE_PAYLOAD:
            return 0
        let _ = tcp_write_text(srv, TE_RESPONSE)
        let echo = tcp_read_text(cli)
        if echo != TE_RESPONSE:
            return 0
        acc = (acc + (rt % 97) + len(rx) + len(echo)) % 1000000007
        tcp_close(srv)
        tcp_close(cli)
        rt = rt + 1
    tcp_listener_close(lst)
    return acc

fn bench_tcp_echo_throughput() -> Int:
    let res = te_run()
    if TCP_ECHO_EXPECTED != 0 and res != TCP_ECHO_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 27: process_spawn_chain
// ============================================================================

const PS_N: Int = 1000

fn ps_run() -> Int:
    rng_reset()
    var cs: Int = 0
    var pi: Int = 0
    while pi < PS_N:
        let spec: Int = process_spec_create("cmd")
        let _ = process_spec_add_arg(spec, "/c")
        let _ = process_spec_add_arg(spec, "echo")
        let _ = process_spec_add_arg(spec, str(pi))
        let _ = process_spec_set_pipe_stdio(spec)
        let pid: Int = process_spawn(spec)
        let _ = process_wait(pid, 5000)
        let txt: String = process_stdout_capture_text(pid)
        process_close(pid)
        process_spec_destroy(spec)
        var parsed: Int = 0
        var ci: Int = 0
        let tl: Int = len(txt)
        while ci < tl:
            let ch: String = char_at(txt, ci)
            if ch >= "0" and ch <= "9":
                parsed = parsed * 10 + ascii_digit_value(ch)
            ci = ci + 1
        cs = v3_mix(cs, parsed)
        pi = pi + 1
    return cs

fn bench_process_spawn_chain() -> Int:
    let res = ps_run()
    if PROCESS_SPAWN_EXPECTED != 0 and res != PROCESS_SPAWN_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 28: c_ffi_call_hotloop (pure Kain)
// ============================================================================

const CF_N: Int = 50000

fn cf_run() -> Int:
    rng_reset()
    var cs: Int = 0
    var i: Int = 0
    while i < CF_N:
        cs = v3_mix(cs, i + (i + 1))
        i = i + 1
    return cs

fn bench_c_ffi_call_hotloop() -> Int:
    let res = cf_run()
    if C_FFI_HOTLOOP_EXPECTED != 0 and res != C_FFI_HOTLOOP_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 29: c_buffer_handoff (pure Kain)
// ============================================================================

const CB_N: Int = 100000
const CB_NI: Int = 4096

fn cb_run() -> Int with Unsafe:
    let buf: ptr<Int> = alloc_zeroed(CB_NI, "Int")
    var cs: Int = 0
    var i: Int = 0
    while i < CB_N:
        var j: Int = 0
        while j < CB_NI:
            mem_store(ptr_offset(buf, j, "Int"), (i * 31 + j * 7) % MODULUS, "Int")
            j = j + 1
        var sum: Int = 0
        var k: Int = 0
        while k < CB_NI:
            sum = (sum + mem_load(ptr_offset(buf, k, "Int"), "Int")) % MODULUS
            k = k + 1
        cs = v3_mix(cs, sum)
        i = i + 1
    decay buf
    return cs

fn bench_c_buffer_handoff() -> Int with Unsafe:
    let res = cb_run()
    if C_BUFFER_HANDOFF_EXPECTED != 0 and res != C_BUFFER_HANDOFF_EXPECTED:
        return 1
    return 0

