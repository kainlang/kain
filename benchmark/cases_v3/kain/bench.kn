const SPSC_N: Int = 500000

fn spsc_run() -> Int:
    var q: IntQueue = queue_create(1024)
    var cs: Int = 0
    var pi: Int = 0
    while pi < SPSC_N:
        if queue_is_full(q):
            cs = (cs + queue_peek(q)) % MODULUS
            q = queue_pop(q)
        q = queue_push(q, pi % MODULUS)
        pi = pi + 1
    while queue_is_empty(q) == false:
        cs = (cs + queue_peek(q)) % MODULUS
        q = queue_pop(q)
    let _ = queue_destroy(q)
    return cs

