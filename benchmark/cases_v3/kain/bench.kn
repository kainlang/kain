fn main() -> Int with Unsafe:
    let args: Array<String> = process_user_args()
    let argc: Int = len(args)
    if argc < 1:
        println("usage: bench <benchmark_name>")
        println("       bench --compute-all")
        return 1
    let name: String = args[0]
    if name == "--compute-all":
        return compute_all()
    elif name == "binary_trees":
        return bench_binary_trees()
    elif name == "nbody":
        return bench_nbody()
    elif name == "spectral_norm":
        return bench_spectral_norm()
    elif name == "mandelbrot":
        return bench_mandelbrot()
    elif name == "fasta":
        return bench_fasta()
    elif name == "regex_redux":
        return bench_regex_redux()
    elif name == "pidigits":
        return bench_pidigits()
    elif name == "hashmap_heavy":
        return bench_hashmap_heavy()
    elif name == "btree_scan":
        return bench_btree_scan()
    elif name == "sort_gauntlet":
        return bench_sort_gauntlet()
    elif name == "vector_growth":
        return bench_vector_growth()
    elif name == "graph_bfs":
        return bench_graph_bfs()
    elif name == "alloc_small_churn":
        return bench_alloc_small_churn()
    elif name == "alloc_large_objects":
        return bench_alloc_large_objects()
    elif name == "arena_vs_malloc":
        return bench_arena_vs_malloc()
    elif name == "cache_march":
        return bench_cache_march()
    elif name == "rc_vs_gc_trace":
        return bench_rc_vs_gc_trace()
    elif name == "parallel_reduce":
        return bench_parallel_reduce()
    elif name == "mutex_contention":
        return bench_mutex_contention()
    elif name == "spsc_queue":
        return bench_spsc_queue()
    elif name == "mpmc_queue":
        return bench_mpmc_queue()
    elif name == "actor_spam":
        return bench_actor_spam()
    elif name == "async_ready_pipeline":
        return bench_async_ready_pipeline()
    elif name == "file_read_streaming":
        return bench_file_read_streaming()
    elif name == "file_write_streaming":
        return bench_file_write_streaming()
    elif name == "tcp_echo_throughput":
        return bench_tcp_echo_throughput()
    elif name == "process_spawn_chain":
        return bench_process_spawn_chain()
    elif name == "c_ffi_call_hotloop":
        return bench_c_ffi_call_hotloop()
    elif name == "c_buffer_handoff":
        return bench_c_buffer_handoff()
    elif name == "build_self_stress":
        return bench_build_self_stress()
    else:
        println("unknown benchmark: " + name)
        return 1
