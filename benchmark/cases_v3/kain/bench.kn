// ============================================================================
//  BENCH 29: c_buffer_handoff (pure Kain)
// ============================================================================

const CB_N: Int = 500
const CB_NI: Int = 256

fn cb_run() -> Int with Unsafe:
    let buf: ptr<Int> = alloc_zeroed(CB_NI, "Int")
    var cs: Int = 0
    var i: Int = 0
    while i < CB_N:
        var j: Int = 0
        while j < CB_NI:
            mem_store(ptr_offset(buf, j, "Int"), (i * 31 + j * 7) % MODULUS, "Int")
            j = j + 1
        var sum: Int = 0
        var k: Int = 0
        while k < CB_NI:
            sum = (sum + mem_load(ptr_offset(buf, k, "Int"), "Int")) % MODULUS
            k = k + 1
        cs = v3_mix(cs, sum)
        i = i + 1
    decay buf
    return cs

fn bench_c_buffer_handoff() -> Int with Unsafe:
    let res = cb_run()
    if C_BUFFER_HANDOFF_EXPECTED != 0 and res != C_BUFFER_HANDOFF_EXPECTED:
        return 1
    return 0

