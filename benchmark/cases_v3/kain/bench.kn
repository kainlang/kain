//  BENCH 14: alloc_large_objects
// ============================================================================

const ALO_NL: Int = 50
const ALO_NS: Int = 5000

fn alo_run() -> Int with Unsafe:
    rng_reset()
    var cs: Int = 0
    var li: Int = 0
    while li < ALO_NL:
        let ls: Int = (1 * 1024 * 1024) + (rng_next() % (4 * 1024 * 1024))
        let li2: Int = (ls + 7) / 8
        let lb: ptr<Int> = alloc_zeroed(li2, "Int")
        var pg: Int = 0
        while pg * 512 < li2:
            mem_store(ptr_offset(lb, pg * 512, "Int"), li + pg, "Int")
            pg = pg + 1
        var sum: Int = 0
        var si: Int = 0
        while si < 256 and si < li2:
            sum = (sum + mem_load(ptr_offset(lb, si, "Int"), "Int")) % MODULUS
            si = si + 1
        cs = (cs + sum) % MODULUS
        let spl: Int = ALO_NS / ALO_NL
        var sj: Int = 0
        while sj < spl:
            let sb: ptr<Int> = alloc_zeroed(8, "Int")
            mem_store(sb, sj + li, "Int")
            cs = (cs + mem_load(sb, "Int")) % MODULUS
            decay sb
            sj = sj + 1
        decay lb
        li = li + 1
    return cs

fn bench_alloc_large_objects() -> Int with Unsafe:
    let res = alo_run()
    if ALLOC_LARGE_OBJECTS_EXPECTED != 0 and res != ALLOC_LARGE_OBJECTS_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 15: arena_vs_malloc
// ============================================================================

const AVM_NO: Int = 100000
const AVM_NR: Int = 10
const AVM_NF: Int = 10

fn avm_run() -> Int with Unsafe:
    rng_reset()
    var ac: Int = 0
    var mc: Int = 0
    var rd: Int = 0
    while rd < AVM_NR:
        let ar: ptr<Int> = alloc_zeroed(AVM_NO * AVM_NF, "Int")
        var ai: Int = 0
        while ai < AVM_NO:
            let b: Int = ai * 3
            mem_store(ptr_offset(ar, b+0, "Int"), ai, "Int")
            mem_store(ptr_offset(ar, b+1, "Int"), (ai * 7) % MODULUS, "Int")
            mem_store(ptr_offset(ar, b+2, "Int"), (ai * 31) % MODULUS, "Int")
            ac = (ac + mem_load(ptr_offset(ar, b+1, "Int"), "Int")) % MODULUS
            ai = ai + 1
        decay ar
        var mi: Int = 0
        while mi < AVM_NO:
            let ob: ptr<Int> = alloc_zeroed(3, "Int")
            mem_store(ptr_offset(ob, 0, "Int"), mi, "Int")
            mem_store(ptr_offset(ob, 1, "Int"), (mi * 7) % MODULUS, "Int")
            mem_store(ptr_offset(ob, 2, "Int"), (mi * 31) % MODULUS, "Int")
            mc = (mc + mem_load(ptr_offset(ob, 1, "Int"), "Int")) % MODULUS
            decay ob
            mi = mi + 1
        rd = rd + 1
    return safe_mod(ac + mc, MODULUS)

fn bench_arena_vs_malloc() -> Int with Unsafe:
    let res = avm_run()
    if ARENA_VS_MALLOC_EXPECTED != 0 and res != ARENA_VS_MALLOC_EXPECTED:
        return 1
    return 0

