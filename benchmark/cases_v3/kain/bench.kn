// ============================================================================
//  BENCH 12: graph_bfs
// ============================================================================

const GB_NN: Int = 5000
const GB_NE: Int = 20000

fn gb_run() -> Int with Unsafe:
    rng_reset()
    let n: Int = GB_NN
    let e: Int = GB_NE
    let off: ptr<Int> = alloc_zeroed(n + 1, "Int")
    let tgt: ptr<Int> = alloc_zeroed(e, "Int")
    var ei: Int = 0
    while ei < e:
        let src: Int = rng_next() % n
        let dst: Int = rng_next() % n
        mem_store(ptr_offset(off, src, "Int"), mem_load(ptr_offset(off, src, "Int"), "Int") + 1, "Int")
        mem_store(ptr_offset(tgt, ei, "Int"), dst, "Int")
        ei = ei + 1
    var o: Int = 0
    var pi: Int = 0
    while pi < n:
        let cnt: Int = mem_load(ptr_offset(off, pi, "Int"), "Int")
        mem_store(ptr_offset(off, pi, "Int"), o, "Int")
        o = o + cnt
        pi = pi + 1
    mem_store(ptr_offset(off, n, "Int"), o, "Int")
    let q: IntQueue = queue_create(n)
    let vis: ptr<Int> = alloc_zeroed(n, "Int")
    let dst: ptr<Int> = alloc_zeroed(n, "Int")
    mem_store(vis, 1, "Int")
    mem_store(dst, 0, "Int")
    let _ = queue_push(q, 0)
    while queue_is_empty(q) == false:
        let nd: Int = queue_peek(q)
        let _ = queue_pop(q)
        let d: Int = mem_load(ptr_offset(dst, nd, "Int"), "Int")
        let s: Int = mem_load(ptr_offset(off, nd, "Int"), "Int")
        let en: Int = mem_load(ptr_offset(off, nd + 1, "Int"), "Int")
        var ni: Int = s
        while ni < en:
            let nb: Int = mem_load(ptr_offset(tgt, ni, "Int"), "Int")
            if mem_load(ptr_offset(vis, nb, "Int"), "Int") == 0:
                mem_store(ptr_offset(vis, nb, "Int"), 1, "Int")
                mem_store(ptr_offset(dst, nb, "Int"), d + 1, "Int")
                let _ = queue_push(q, nb)
            ni = ni + 1
    var cs: Int = 0
    var vi: Int = 0
    while vi < n:
        if mem_load(ptr_offset(vis, vi, "Int"), "Int") != 0:
            let dd: Int = mem_load(ptr_offset(dst, vi, "Int"), "Int")
            cs = (cs + safe_mod(vi * dd, MODULUS)) % MODULUS
        vi = vi + 1
    queue_destroy(q)
    decay vis
    decay dst
    decay off
    decay tgt
    return cs

fn bench_graph_bfs() -> Int with Unsafe:
    let res = gb_run()
    if GRAPH_BFS_EXPECTED != 0 and res != GRAPH_BFS_EXPECTED:
        return 1
    return 0

