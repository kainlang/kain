fn asc_run() -> Int with Unsafe:
    rng_reset()
    var cs: Int = 0
    var i: Int = 0
    while i < ASC_N:
        let sz: Int = 16 + (rng_next() % 240)
        let ni: Int = (sz + 7) / 8
        let buf: ptr<Int> = alloc_zeroed(ni, "Int")
        mem_store(buf, i & 0xFF, "Int")
        if ni > 1:
            mem_store(ptr_offset(buf, 1, "Int"), (i & 0xFF) * 257, "Int")
        cs = (cs + mem_load(buf, "Int")) % MODULUS
        decay buf
        i = i + 1
    return cs

