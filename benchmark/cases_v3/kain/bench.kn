//  BENCH 25: file_write_streaming
// ============================================================================

const FWS_SZ: Int = 262144
const FWS_CH: Int = 65536

fn fws_run() -> Int:
    rng_reset()
    let tmp: String = fs_temp_file("v3wr_")
    var cs: Int = 0
    var wn: Int = 0
    while wn < FWS_SZ:
        var hex: String = ""
        var fi: Int = 0
        while fi < FWS_CH / 64:
            let val: Int = rng_next() % 256
            cs = v3_mix(cs, val)
            let hi: Int = val / 16
            let lo: Int = val % 16
            hex = hex + chr(if hi < 10: 48+hi else: 87+hi)
            hex = hex + chr(if lo < 10: 48+lo else: 87+lo)
            fi = fi + 1
        fs_append_text(tmp, hex)
        wn = wn + FWS_CH
    fs_remove_file(tmp)
    return cs

fn bench_file_write_streaming() -> Int:
