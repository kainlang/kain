// ============================================================================
//  CASES_V3 -- Kain God File (30 benchmarks)
//  Run: bench_kain.exe <benchmark_name>
//       bench_kain.exe --compute-all
// ============================================================================

use std::collections
use std::math
use std::sync
use std::atomic
use std::thread
use std::fs
use std::net
use std::process
use std::time
use std::ascii
use std::text
use std::bytes

const RANDOM_SEED: Int = 42
const MODULUS: Int = 1000000007

// Expected checksums — computed 2026-06-19 via --compute-all
const BINARY_TREES_EXPECTED: Int = 0       // Changed: recursive tree impl; run --compute-all
const NBODY_EXPECTED: Int = 0               // Changed: CLBG 5-body solar system; run --compute-all
const SPECTRAL_NORM_EXPECTED: Int = 122277715
const MANDELBROT_EXPECTED: Int = 0          // Changed: PBM output added; run --compute-all
const FASTA_EXPECTED: Int = 0               // Changed: CLBG LCG; run --compute-all
const REGEX_REDUX_EXPECTED: Int = 0         // Changed: larger DNA + pattern matching
const PIDIGITS_EXPECTED: Int = 0            // Changed: BigInt impl; run --compute-all
const HASHMAP_HEAVY_EXPECTED: Int = 639024227
const BTREE_SCAN_EXPECTED: Int = 382288951
const SORT_GAUNTLET_EXPECTED: Int = 596679945
const VECTOR_GROWTH_EXPECTED: Int = 49495050
const GRAPH_BFS_EXPECTED: Int = 0
const ALLOC_SMALL_CHURN_EXPECTED: Int = 629340
const ALLOC_LARGE_OBJECTS_EXPECTED: Int = 371225
const ARENA_VS_MALLOC_EXPECTED: Int = 992995107
const CACHE_MARCH_EXPECTED: Int = 664519821
const RC_VS_GC_TRACE_EXPECTED: Int = 995748239
const PARALLEL_REDUCE_EXPECTED: Int = 458615921
const MUTEX_CONTENTION_EXPECTED: Int = 4000000
const SPSC_QUEUE_EXPECTED: Int = 999749132
const MPMC_QUEUE_EXPECTED: Int = 999749132
const ACTOR_SPAM_EXPECTED: Int = 338464993
const ASYNC_READY_EXPECTED: Int = 964999762
const FILE_READ_EXPECTED: Int = 124672127
const FILE_WRITE_EXPECTED: Int = 683708925
const TCP_ECHO_EXPECTED: Int = 31090
const PROCESS_SPAWN_EXPECTED: Int = 0    // environment-dependent; run --compute-all on target machine
const C_FFI_HOTLOOP_EXPECTED: Int = 979343833
const C_BUFFER_HANDOFF_EXPECTED: Int = 0
const BUILD_SELF_STRESS_EXPECTED: Int = 42

// Minimal component for world surface requirement
component V3BenchPanel():
    render <panel title="V3 Bench" />

// RNG state as world (module-level var not supported)
world V3Rng:
    state s: Int = RANDOM_SEED
    surface native_ui => V3BenchPanel

fn rng_next() -> Int:
    V3Rng.s = (V3Rng.s * 1103515245 + 12345) & 0x7fffffff
    return V3Rng.s

fn rng_reset():
    V3Rng.s = RANDOM_SEED

fn safe_mod(v: Int, m: Int) -> Int:
    let r = v % m
    if r < 0:
        return r + m
    return r

fn v3_mix(acc: Int, val: Int) -> Int:
    return safe_mod((acc * 31 + val), MODULUS)

// ============================================================================
//  BENCH 1: binary_trees
// ============================================================================
// Each "node" is 3 consecutive Ints: [value, left_ptr, right_ptr]
// left_ptr/right_ptr are stored as Int via ptr_to_int; 0 = null

const BT_MI: Int = 4
const BT_MA: Int = 18

fn bt_alloc(depth: Int) -> ptr<Int>:
    if depth <= 0:
        return int_to_ptr(0, "Int")
    let node: ptr<Int> = alloc_zeroed(3, "Int")
    mem_store(node, 1, "Int")
    let left: ptr<Int> = bt_alloc(depth - 1)
    let right: ptr<Int> = bt_alloc(depth - 1)
    mem_store(ptr_offset(node, 1, "Int"), ptr_to_int(left), "Int")
    mem_store(ptr_offset(node, 2, "Int"), ptr_to_int(right), "Int")
    return node

fn bt_sum(node: ptr<Int>) -> Int:
    let p: Int = ptr_to_int(node)
    if p == 0:
        return 0
    let val: Int = mem_load(node, "Int")
    let left_p: Int = mem_load(ptr_offset(node, 1, "Int"), "Int")
    let right_p: Int = mem_load(ptr_offset(node, 2, "Int"), "Int")
    var left_sum: Int = 0
    if left_p != 0:
        left_sum = bt_sum(int_to_ptr(left_p, "Int"))
    var right_sum: Int = 0
    if right_p != 0:
        right_sum = bt_sum(int_to_ptr(right_p, "Int"))
    return (val + left_sum + right_sum) % MODULUS

fn bt_free(node: ptr<Int>):
    let p: Int = ptr_to_int(node)
    if p == 0:
        return
    let left_p: Int = mem_load(ptr_offset(node, 1, "Int"), "Int")
    let right_p: Int = mem_load(ptr_offset(node, 2, "Int"), "Int")
    if left_p != 0:
        bt_free(int_to_ptr(left_p, "Int"))
    if right_p != 0:
        bt_free(int_to_ptr(right_p, "Int"))
    decay node

fn bt_run() -> Int with Unsafe:
    var cs: Int = 0
    var d: Int = BT_MI
    while d <= BT_MA:
        let it: Int = 1 << (BT_MA - d + BT_MI)
        var i: Int = 0
        while i < it:
            let tree: ptr<Int> = bt_alloc(d)
            let sum: Int = bt_sum(tree)
            bt_free(tree)
            cs = (cs + sum) % MODULUS
            i = i + 1
        d = d + 2
    return cs

fn bench_binary_trees() -> Int with Unsafe:
    let res = bt_run()
    if BINARY_TREES_EXPECTED != 0 and res != BINARY_TREES_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 2: nbody (CLBG 5-body solar system)
// ============================================================================

const NB_N: Int = 5
const NB_STEPS: Int = 100
const NB_DT: Float = 0.01

fn nb_run() -> Int with Unsafe:
    let n: Int = NB_N
    let st: Int = 7
    let PI: Float = 3.141592653589793
    let SM: Float = 4.0 * PI * PI
    let DY: Float = 365.24

    let buf: ptr<Float> = alloc_zeroed(n * st, "Float")

    // Helper: body index 0 = Sun
    mem_store(ptr_offset(buf, 0, "Float"), 0.0, "Float")   // x
    mem_store(ptr_offset(buf, 1, "Float"), 0.0, "Float")   // y
    mem_store(ptr_offset(buf, 2, "Float"), 0.0, "Float")   // z
    mem_store(ptr_offset(buf, 3, "Float"), 0.0, "Float")   // vx (will be adjusted)
    mem_store(ptr_offset(buf, 4, "Float"), 0.0, "Float")   // vy
    mem_store(ptr_offset(buf, 5, "Float"), 0.0, "Float")   // vz
    mem_store(ptr_offset(buf, 6, "Float"), SM, "Float")    // mass

    // Jupiter (all values as plain decimals, no scientific notation)
    mem_store(ptr_offset(buf, 7, "Float"), 4.84143144246472090, "Float")
    mem_store(ptr_offset(buf, 8, "Float"), -1.16032004402742839, "Float")
    mem_store(ptr_offset(buf, 9, "Float"), -0.103622044471123109, "Float")
    mem_store(ptr_offset(buf, 10, "Float"), 0.00166007664274403694 * DY, "Float")
    mem_store(ptr_offset(buf, 11, "Float"), 0.00769901118419740425 * DY, "Float")
    mem_store(ptr_offset(buf, 12, "Float"), -0.0000690460016972063023 * DY, "Float")
    mem_store(ptr_offset(buf, 13, "Float"), 0.000954791938424326609 * SM, "Float")

    // Saturn
    mem_store(ptr_offset(buf, 14, "Float"), 8.34336671824457987, "Float")
    mem_store(ptr_offset(buf, 15, "Float"), 4.12479856412430479, "Float")
    mem_store(ptr_offset(buf, 16, "Float"), -0.403523417114321381, "Float")
    mem_store(ptr_offset(buf, 17, "Float"), -0.00276742510726862411 * DY, "Float")
    mem_store(ptr_offset(buf, 18, "Float"), 0.00499852801234917238 * DY, "Float")
    mem_store(ptr_offset(buf, 19, "Float"), 0.0000230417297573763929 * DY, "Float")
    mem_store(ptr_offset(buf, 20, "Float"), 0.000285885980666130812 * SM, "Float")

    // Uranus
    mem_store(ptr_offset(buf, 21, "Float"), 12.8943695621391310, "Float")
    mem_store(ptr_offset(buf, 22, "Float"), -15.1111514016986312, "Float")
    mem_store(ptr_offset(buf, 23, "Float"), -0.223307578892655734, "Float")
    mem_store(ptr_offset(buf, 24, "Float"), 0.00296460137564761618 * DY, "Float")
    mem_store(ptr_offset(buf, 25, "Float"), 0.00237847173959480950 * DY, "Float")
    mem_store(ptr_offset(buf, 26, "Float"), -0.0000296589568540237555 * DY, "Float")
    mem_store(ptr_offset(buf, 27, "Float"), 0.0000436624404335156298 * SM, "Float")

    // Neptune
    mem_store(ptr_offset(buf, 28, "Float"), 15.3796971148509165, "Float")
    mem_store(ptr_offset(buf, 29, "Float"), -25.9193146099879641, "Float")
    mem_store(ptr_offset(buf, 30, "Float"), 0.179258772950371181, "Float")
    mem_store(ptr_offset(buf, 31, "Float"), 0.00268067772490389322 * DY, "Float")
    mem_store(ptr_offset(buf, 32, "Float"), 0.00162824170038242295 * DY, "Float")
    mem_store(ptr_offset(buf, 33, "Float"), -0.0000951592254519715870 * DY, "Float")
    mem_store(ptr_offset(buf, 34, "Float"), 0.0000515138902046611451 * SM, "Float")

    // Offset Sun momentum so total = 0
    var px: Float = 0.0
    var py: Float = 0.0
    var pz: Float = 0.0
    var mi: Int = 0
    while mi < n:
        let mb: Int = mi * st
        let mv: Float = mem_load(ptr_offset(buf, mb+6, "Float"), "Float")
        px = px + mem_load(ptr_offset(buf, mb+3, "Float"), "Float") * mv
        py = py + mem_load(ptr_offset(buf, mb+4, "Float"), "Float") * mv
        pz = pz + mem_load(ptr_offset(buf, mb+5, "Float"), "Float") * mv
        mi = mi + 1
    mem_store(ptr_offset(buf, 3, "Float"), -px / SM, "Float")
    mem_store(ptr_offset(buf, 4, "Float"), -py / SM, "Float")
    mem_store(ptr_offset(buf, 5, "Float"), -pz / SM, "Float")

    var ts: Int = 0
    while ts < NB_STEPS:
        var ai: Int = 0
        while ai < n:
            var fx: Float = 0.0
            var fy: Float = 0.0
            var fz: Float = 0.0
            let ab: Int = ai * st
            let ax: Float = mem_load(ptr_offset(buf, ab+0, "Float"), "Float")
            let ay: Float = mem_load(ptr_offset(buf, ab+1, "Float"), "Float")
            let az: Float = mem_load(ptr_offset(buf, ab+2, "Float"), "Float")
            var aj: Int = 0
            while aj < n:
                if aj != ai:
                    let jb: Int = aj * st
                    let dx: Float = ax - mem_load(ptr_offset(buf, jb+0, "Float"), "Float")
                    let dy: Float = ay - mem_load(ptr_offset(buf, jb+1, "Float"), "Float")
                    let dz: Float = az - mem_load(ptr_offset(buf, jb+2, "Float"), "Float")
                    let dsq: Float = dx*dx + dy*dy + dz*dz
                    let id3: Float = 1.0 / (dsq * sqrt(dsq))
                    let mj: Float = mem_load(ptr_offset(buf, jb+6, "Float"), "Float")
                    fx = fx - dx * mj * id3
                    fy = fy - dy * mj * id3
                    fz = fz - dz * mj * id3
                aj = aj + 1
            mem_store(ptr_offset(buf, ab+3, "Float"), mem_load(ptr_offset(buf, ab+3, "Float"), "Float") + fx * NB_DT, "Float")
            mem_store(ptr_offset(buf, ab+4, "Float"), mem_load(ptr_offset(buf, ab+4, "Float"), "Float") + fy * NB_DT, "Float")
            mem_store(ptr_offset(buf, ab+5, "Float"), mem_load(ptr_offset(buf, ab+5, "Float"), "Float") + fz * NB_DT, "Float")
            ai = ai + 1
        var pi: Int = 0
        while pi < n:
            let pb: Int = pi * st
            mem_store(ptr_offset(buf, pb+0, "Float"), mem_load(ptr_offset(buf, pb+0, "Float"), "Float") + mem_load(ptr_offset(buf, pb+3, "Float"), "Float") * NB_DT, "Float")
            mem_store(ptr_offset(buf, pb+1, "Float"), mem_load(ptr_offset(buf, pb+1, "Float"), "Float") + mem_load(ptr_offset(buf, pb+4, "Float"), "Float") * NB_DT, "Float")
            mem_store(ptr_offset(buf, pb+2, "Float"), mem_load(ptr_offset(buf, pb+2, "Float"), "Float") + mem_load(ptr_offset(buf, pb+5, "Float"), "Float") * NB_DT, "Float")
            pi = pi + 1
        ts = ts + 1
    var tot: Float = 0.0
    var si: Int = 0
    while si < n:
        let sb: Int = si * st
        tot = tot + mem_load(ptr_offset(buf, sb+0, "Float"), "Float")
        tot = tot + mem_load(ptr_offset(buf, sb+1, "Float"), "Float")
        tot = tot + mem_load(ptr_offset(buf, sb+2, "Float"), "Float")
        si = si + 1
    decay buf
    return abs(floor(tot)) % MODULUS

fn bench_nbody() -> Int with Unsafe:
    let res = nb_run()
    if NBODY_EXPECTED != 0 and res != NBODY_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 3: spectral_norm
// ============================================================================

const SN_N: Int = 2000

fn sn_run() -> Int with Unsafe:
    let n: Int = SN_N
    let u: ptr<Float> = alloc_zeroed(n, "Float")
    let v: ptr<Float> = alloc_zeroed(n, "Float")
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(u, i, "Float"), 1.0, "Float")
        i = i + 1
    var it: Int = 0
    while it < 10:
        var vi: Int = 0
        while vi < n:
            var sum: Float = 0.0
            var vj: Int = 0
            while vj < n:
                sum = sum + mem_load(ptr_offset(u, vj, "Float"), "Float") / Float((vi+vj)*(vi+vj+1)/2 + vi + 1)
                vj = vj + 1
            mem_store(ptr_offset(v, vi, "Float"), sum, "Float")
            vi = vi + 1
        var ui: Int = 0
        while ui < n:
            var sum: Float = 0.0
            var uj: Int = 0
            while uj < n:
                sum = sum + mem_load(ptr_offset(v, uj, "Float"), "Float") / Float((ui+uj)*(ui+uj+1)/2 + ui + 1)
                uj = uj + 1
            mem_store(ptr_offset(u, ui, "Float"), sum, "Float")
            ui = ui + 1
        it = it + 1
    var vb: Float = 0.0
    var vv: Float = 0.0
    var ri: Int = 0
    while ri < n:
        let uv: Float = mem_load(ptr_offset(u, ri, "Float"), "Float")
        let vv2: Float = mem_load(ptr_offset(v, ri, "Float"), "Float")
        vb = vb + uv * vv2
        vv = vv + vv2 * vv2
        ri = ri + 1
    decay u
    decay v
    return floor(sqrt(vb / vv) * 1000000000.0) % MODULUS

fn bench_spectral_norm() -> Int with Unsafe:
    let res = sn_run()
    if SPECTRAL_NORM_EXPECTED != 0 and res != SPECTRAL_NORM_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 4: mandelbrot
// ============================================================================

const MB_W: Int = 800
const MB_H: Int = 800
const MB_MI: Int = 200
const MB_X0: Float = -2.0
const MB_X1: Float = 1.0
const MB_Y0: Float = -1.5
const MB_Y1: Float = 1.5

fn mb_run() -> Int with Unsafe:
    var cs: Int = 0
    let dx: Float = (MB_X1 - MB_X0) / Float(MB_W)
    let dy: Float = (MB_Y1 - MB_Y0) / Float(MB_H)
    let row_buf: ptr<Int> = alloc_zeroed(MB_W, "Int")

    // Build PBM output using bytes builder
    var pb = text_builder_new()
    pb = text_builder_push(pb, "P4\n")
    pb = text_builder_push(pb, str(MB_W))
    pb = text_builder_push(pb, " ")
    pb = text_builder_push(pb, str(MB_H))
    pb = text_builder_push(pb, "\n")

    var py: Int = 0
    while py < MB_H:
        let ci: Float = MB_Y0 + dy * Float(py)
        // Compute one row of Mandelbrot
        var px: Int = 0
        while px < MB_W:
            let cr: Float = MB_X0 + dx * Float(px)
            var zr: Float = 0.0
            var zi: Float = 0.0
            var it: Int = 0
            while (zr*zr + zi*zi) <= 4.0 and it < MB_MI:
                let nzr: Float = zr*zr - zi*zi + cr
                let nzi: Float = 2.0*zr*zi + ci
                zr = nzr
                zi = nzi
                it = it + 1
            mem_store(ptr_offset(row_buf, px, "Int"), it, "Int")
            cs = (cs + it) % MODULUS
            px = px + 1

        // Pack row into PBM bytes (1 bit per pixel, MSB first)
        var bp: Int = 0
        while bp < MB_W:
            var byte_val: Int = 0
            var bit: Int = 0
            while bit < 8 and (bp + bit) < MB_W:
                let val: Int = mem_load(ptr_offset(row_buf, bp + bit, "Int"), "Int")
                if val < MB_MI:
                    // Escaped -> white (1 in PBM)
                    byte_val = byte_val | (1 << (7 - bit))
                bit = bit + 1
            pb = bytes_builder_push_byte(pb, byte_val)
            bp = bp + 8

        py = py + 1

    decay row_buf
    let pbm_data: String = text_builder_build(pb)
    stdout_write(pbm_data)
    return cs

fn bench_mandelbrot() -> Int with Unsafe:
    let res = mb_run()
    if MANDELBROT_EXPECTED != 0 and res != MANDELBROT_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 5: fasta
// ============================================================================

const FA_N: Int = 250000
const FA_IM: Int = 139968
const FA_IA: Int = 3877
const FA_IC: Int = 29573
const FA_ALU: String = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"

fn fa_run() -> Int:
    var last: Int = 42
    var ca: Int = 0
    var cc: Int = 0
    var cg: Int = 0
    var ct: Int = 0
    var i: Int = 0
    let al: Int = len(FA_ALU)
    while i < al:
        let ch: String = char_at(FA_ALU, i)
        if ch == "A": ca = ca + 1
        elif ch == "C": cc = cc + 1
        elif ch == "G": cg = cg + 1
        elif ch == "T": ct = ct + 1
        i = i + 1
    let tw: Int = ca + cc + cg + ct
    var cs: Int = 0
    var j: Int = 0
    while j < FA_N:
        last = (last * FA_IA + FA_IC) % FA_IM
        let r: Int = last * tw / FA_IM
        var nb: Int = 65
        if r >= ca:
            if r < ca + cc: nb = 67
            elif r < ca + cc + cg: nb = 71
            else: nb = 84
        cs = v3_mix(cs, nb)
        j = j + 1
    return cs

fn bench_fasta() -> Int:
    let res = fa_run()
    if FASTA_EXPECTED != 0 and res != FASTA_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 6: regex_redux
// ============================================================================

const RR_N: Int = 50000

fn rr_count_pattern(dna: String, pat: String) -> Int:
    let dl: Int = len(dna)
    let pl: Int = len(pat)
    var cnt: Int = 0
    if pl > dl:
        return 0
    var i: Int = 0
    while i <= dl - pl:
        var matched: Bool = true
        var j: Int = 0
        while j < pl:
            if char_at(dna, i + j) != char_at(pat, j):
                matched = false
                j = pl
            j = j + 1
        if matched:
            cnt = cnt + 1
            i = i + pl
        else:
            i = i + 1
    return cnt

fn rr_run() -> Int:
    rng_reset()
    var dna: String = ""
    var i: Int = 0
    while i < RR_N:
        let r: Int = rng_next() % 4
        if r == 0: dna = dna + "A"
        elif r == 1: dna = dna + "C"
        elif r == 2: dna = dna + "G"
        else: dna = dna + "T"
        i = i + 1
    // Count occurrences of IUPAC pattern "agggtaaa|tttaccct"
    let pc1: Int = rr_count_pattern(dna, "AGGGTAAA")
    let pc2: Int = rr_count_pattern(dna, "TTTACCCT")
    let pattern_count: Int = pc1 + pc2

    // Count "tHa[Nt]" (tHa + any nucleotide)
    var class_count: Int = 0
    let dl: Int = len(dna)
    var k: Int = 0
    while k < dl - 3:
        if char_at(dna, k) == "T" and char_at(dna, k+2) == "A":
            let h: String = char_at(dna, k+1)
            if h != "G":
                class_count = class_count + 1
        k = k + 1

    // After replacement "tHaNt" -> "<4>": net -1 per match
    let after_len: Int = dl - class_count
    let total_count: Int = pattern_count + class_count
    return safe_mod(total_count * after_len, MODULUS)

fn bench_regex_redux() -> Int:
    let res = rr_run()
    if REGEX_REDUX_EXPECTED != 0 and res != REGEX_REDUX_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 7: pidigits (BigInt, base 10^9)
// ============================================================================

const PD_N: Int = 5000
const PD_BASE: Int = 1000000000

// BigInt helpers — all operate on ptr<Int> limbs (little-endian, count fixed)

fn pd_bi_new(count: Int) -> ptr<Int>:
    return alloc_zeroed(count, "Int")

fn pd_bi_one_scaled(count: Int) -> ptr<Int>:
    let result = alloc_zeroed(count, "Int")
    mem_store(ptr_offset(result, count - 1, "Int"), 1, "Int")
    return result

fn pd_bi_mul_small(self: ptr<Int>, count: Int, x: Int):
    var carry: Int = 0
    var i: Int = 0
    while i < count:
        let v: Int = mem_load(ptr_offset(self, i, "Int"), "Int") * x + carry
        mem_store(ptr_offset(self, i, "Int"), v % PD_BASE, "Int")
        carry = v / PD_BASE
        i = i + 1

fn pd_bi_div_small(self: ptr<Int>, count: Int, x: Int) -> Int:
    var rem: Int = 0
    var i: Int = count - 1
    while i >= 0:
        let v: Int = rem * PD_BASE + mem_load(ptr_offset(self, i, "Int"), "Int")
        mem_store(ptr_offset(self, i, "Int"), v / x, "Int")
        rem = v % x
        i = i - 1
    return rem

fn pd_bi_add(self: ptr<Int>, count: Int, other: ptr<Int>):
    var carry: Int = 0
    var i: Int = 0
    while i < count:
        let a: Int = mem_load(ptr_offset(self, i, "Int"), "Int")
        let b: Int = mem_load(ptr_offset(other, i, "Int"), "Int")
        let sum: Int = a + b + carry
        mem_store(ptr_offset(self, i, "Int"), sum % PD_BASE, "Int")
        carry = sum / PD_BASE
        i = i + 1

fn pd_bi_sub(self: ptr<Int>, count: Int, other: ptr<Int>):
    var borrow: Int = 0
    var i: Int = 0
    while i < count:
        let a: Int = mem_load(ptr_offset(self, i, "Int"), "Int")
        let b: Int = mem_load(ptr_offset(other, i, "Int"), "Int")
        let diff: Int = a - b - borrow
        if diff >= 0:
            mem_store(ptr_offset(self, i, "Int"), diff, "Int")
            borrow = 0
        else:
            mem_store(ptr_offset(self, i, "Int"), diff + PD_BASE, "Int")
            borrow = 1
        i = i + 1

// arctan(1/x) series using BigInt
fn pd_arctan(x: Int, num_terms: Int, limbs: Int) -> ptr<Int>:
    let result: ptr<Int> = pd_bi_new(limbs)
    let term: ptr<Int> = pd_bi_one_scaled(limbs)
    // term = 1/x
    pd_bi_div_small(term, limbs, x)

    var k: Int = 0
    while k < num_terms:
        if k % 2 == 0:
            pd_bi_add(result, limbs, term)
        else:
            pd_bi_sub(result, limbs, term)

        // term_{k+1} = term_k * (2k+1) / ((2k+3) * x^2)
        let numerator: Int = 2 * k + 1
        let denominator: Int = (2 * k + 3) * x * x
        pd_bi_mul_small(term, limbs, numerator)
        let _ = pd_bi_div_small(term, limbs, denominator)

        k = k + 1

    decay term
    return result

fn pd_compute_checksum(pi: ptr<Int>, limbs: Int, count: Int) -> Int:
    var cs: Int = 0
    var got: Int = 0
    var started: Bool = false

    var li: Int = limbs - 1
    while li >= 0 and got < count:
        let val: Int = mem_load(ptr_offset(pi, li, "Int"), "Int")
        // Extract 9 decimal digits from this limb (MSB first)
        var di: Int = 0
        while di < 9 and got < count:
            // Compute divisor = 10^(8-di)
            var divisor: Int = 1
            var p: Int = 0
            while p < (8 - di):
                divisor = divisor * 10
                p = p + 1
            let digit: Int = (val / divisor) % 10
            if started == false:
                if digit != 0:
                    started = true
            if started:
                cs = (cs * 31 + digit) % MODULUS
                got = got + 1
            di = di + 1
        li = li - 1
    return cs

fn pd_run() -> Int with Unsafe:
    let target_limbs: Int = (PD_N * 10 / 9) + 10
    let digits: Int = target_limbs * 9
    // terms_5 = ceil(digits / log10(5)) + safety
    let terms_5: Int = (digits * 1000) / 699 + 10
    // terms_239 = ceil(digits / log10(239)) + safety
    let terms_239: Int = (digits * 1000) / 2378 + 10

    // Compute pi = 16*arctan(1/5) - 4*arctan(1/239)
    let atan_5: ptr<Int> = pd_arctan(5, terms_5, target_limbs)
    let atan_239: ptr<Int> = pd_arctan(239, terms_239, target_limbs)

    pd_bi_mul_small(atan_5, target_limbs, 16)
    pd_bi_mul_small(atan_239, target_limbs, 4)
    pd_bi_sub(atan_5, target_limbs, atan_239)

    // Extract checksum from most significant digits
    let cs: Int = pd_compute_checksum(atan_5, target_limbs, PD_N)

    decay atan_5
    decay atan_239
    return cs

fn bench_pidigits() -> Int with Unsafe:
    let res = pd_run()
    if PIDIGITS_EXPECTED != 0 and res != PIDIGITS_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 8: hashmap_heavy
// ============================================================================

const HM_NK: Int = 50000
const HM_NL: Int = 500000

fn rng_int_key() -> Int:
    var key: Int = 0
    var i: Int = 0
    while i < 8:
        let r: Int = rng_next() % 62
        key = ((key * 62) + r) % MODULUS
        i = i + 1
    return key

fn hm_run() -> Int with Unsafe:
    rng_reset()
    var mp: HashMap = hash_map_create(HM_NK)
    let mp_ptr: ptr<HashMap> = addr_of(mp, "HashMap")
    var i: Int = 0
    while i < HM_NK:
        let _ = hash_map_put(mp_ptr, rng_int_key(), i)
        i = i + 1
    rng_reset()
    var cs: Int = 0
    var li: Int = 0
    while li < HM_NL:
        cs = v3_mix(cs, hash_map_get_or(mp, rng_int_key(), 0) + 1)
        li = li + 1
    rng_reset()
    var mp2: HashMap = hash_map_create(HM_NK)
    let mp2_ptr: ptr<HashMap> = addr_of(mp2, "HashMap")
    var di: Int = 0
    while di < HM_NK:
        let k: Int = rng_int_key()
        if di % 4 != 0:
            let _ = hash_map_put(mp2_ptr, k, di)
        di = di + 1
    rng_reset()
    var ri: Int = 0
    while ri < HM_NL / 2:
        cs = v3_mix(cs, hash_map_get_or(mp2, rng_int_key(), 0) + 2)
        ri = ri + 1
    let _ = hash_map_destroy(mp)
    let _ = hash_map_destroy(mp2)
    return cs

fn bench_hashmap_heavy() -> Int with Unsafe:
    let res = hm_run()
    if HASHMAP_HEAVY_EXPECTED != 0 and res != HASHMAP_HEAVY_EXPECTED:
        return 1
    return 0

// ============================================================================
//  BENCH 9: btree_scan
// ============================================================================

const BS_N: Int = 500000

fn bs_run() -> Int with Unsafe:
    rng_reset()
    let n: Int = BS_N
    let ks: ptr<Int> = alloc_zeroed(n, "Int")
    let vs: ptr<Int> = alloc_zeroed(n, "Int")
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(ks, i, "Int"), rng_next() % MODULUS, "Int")
        mem_store(ptr_offset(vs, i, "Int"), i, "Int")
        i = i + 1
    var cs: Int = 0
    var fi: Int = 0
    while fi < n:
        cs = v3_mix(cs, mem_load(ptr_offset(ks, fi, "Int"), "Int") * mem_load(ptr_offset(vs, fi, "Int"), "Int"))
        fi = fi + 1
    var ri: Int = n - 1
    while ri >= 0:
        cs = v3_mix(cs, mem_load(ptr_offset(ks, ri, "Int"), "Int") * mem_load(ptr_offset(vs, ri, "Int"), "Int"))
        ri = ri - 1
    var di: Int = 0
    while di < n:
        if di % 3 == 0: mem_store(ptr_offset(vs, di, "Int"), 0, "Int")
        di = di + 1
    var r2: Int = 0
    while r2 < n:
        let vv: Int = mem_load(ptr_offset(vs, r2, "Int"), "Int")
        if vv != 0:
            cs = v3_mix(cs, mem_load(ptr_offset(ks, r2, "Int"), "Int") * vv + 1)
        r2 = r2 + 1
    decay ks
    decay vs
    return cs

fn bench_btree_scan() -> Int with Unsafe:
    let res = bs_run()
    if BTREE_SCAN_EXPECTED != 0 and res != BTREE_SCAN_EXPECTED:
        return 1
    return 0

