use std::fs
use std::interop
use std::python
use std::time

use model::KainbletonProject

import numpy as np
import dawdreamer as dd
import soundfile as sf
import scipy.signal as scipy_signal
import sounddevice as sd
import librosa as librosa
import pretty_midi as pretty_midi
import mido as mido
import rtmidi as rtmidi
import pydub as pydub

pub struct KainbletonAudioReport:
    module_score: Int
    daw_shape_text: String
    output_path: String
    sample_rate: Int
    frames: Int
    rms: Float
    peak: Float
    preview_x: Array<Float>
    preview_y: Array<Float>
    wave_object: Any
    shared_preview: Any

pub fn kb_audio_module_score() -> Int:
    var score: Int = 0
    if python_module_available("dawdreamer"):
        score = score + 17
    if python_module_available("pyqtgraph"):
        score = score + 19
    if python_module_available("soundfile"):
        score = score + 23
    if python_module_available("scipy.signal"):
        score = score + 29
    if python_module_available("mido"):
        score = score + 31
    if python_module_available("rtmidi"):
        score = score + 37
    if python_module_available("librosa"):
        score = score + 41
    if python_module_available("pretty_midi"):
        score = score + 43
    if python_module_available("pydub"):
        score = score + 47

    let outputs = python_call_attr_raw(mido, "get_output_names", [])
    score = score + len(outputs)
    return score

pub fn kb_preview_axis(frames: Int) -> Array<Float>:
    let axis: Array<Float> = []
    var i: Int = 0
    while i < frames:
        push(axis, Float(i) / Float(frames))
        i = i + 1
    return axis

pub fn kb_preview_from_python(wave_object: Any, frames: Int) -> Array<Float>:
    let preview: Array<Float> = []
    let take = 256
    var i: Int = 0
    while i < take:
        let idx = i * frames / take
        let value = python_call_attr_raw(wave_object, "__getitem__", [idx])
        push(preview, to_float(value))
        i = i + 1
    return preview

pub fn kb_render_audio(project: KainbletonProject, output_path: String) -> KainbletonAudioReport:
    fs_create_dir_all(".kain/out")

    let engine = python_call_attr_raw(dd, "RenderEngine", [project.sample_rate, 128])
    let _bpm = python_call_attr_raw(engine, "set_bpm", [project.bpm])
    let osc = python_call_attr_raw(engine, "make_oscillator_processor", ["kainbleton.osc", 110.0])
    let graph = [[osc, []]]
    let _graph = python_call_attr_raw(engine, "load_graph", [graph])
    let duration = Float(project.render_frames) / Float(project.sample_rate)
    let _render = python_call_attr_raw(engine, "render", [duration])
    let daw_audio = python_call_attr_raw(engine, "get_audio", [])
    let daw_shape = python_call_attr_raw(python_getattr_raw(daw_audio, "shape"), "__str__", [])

    let t = python_call_attr_raw(np, "linspace", [0.0, duration, project.render_frames, false])
    let bass_phase = python_call_attr_raw(np, "multiply", [t, 6.283185307179586 * 55.0])
    let lead_phase = python_call_attr_raw(np, "multiply", [t, 6.283185307179586 * 220.0])
    let bass = python_call_attr_raw(np, "sin", [bass_phase])
    let lead = python_call_attr_raw(np, "sin", [lead_phase])
    let saw_phase = python_call_attr_raw(np, "multiply", [t, 6.283185307179586 * 110.0])
    let saw = python_call_attr_raw(scipy_signal, "sawtooth", [saw_phase])
    let mixed_a = python_call_attr_raw(np, "multiply", [bass, 0.32])
    let mixed_b = python_call_attr_raw(np, "multiply", [lead, 0.18])
    let mixed_c = python_call_attr_raw(np, "multiply", [saw, 0.12])
    let wave_ab = python_call_attr_raw(np, "add", [mixed_a, mixed_b])
    let wave = python_call_attr_raw(np, "add", [wave_ab, mixed_c])
    let smoothed = python_call_attr_raw(scipy_signal, "savgol_filter", [wave, 31, 3])

    let _write = python_call_attr_raw(sf, "write", [output_path, smoothed, project.sample_rate])
    let peak = to_float(python_call_attr_raw(np, "max", [python_call_attr_raw(np, "abs", [smoothed])]))
    let rms_array = python_call_attr_raw(python_getattr_raw(librosa, "feature"), "rms", [smoothed])
    let rms_value = to_float(python_call_attr_raw(np, "mean", [rms_array]))

    let preview_y = kb_preview_from_python(smoothed, project.render_frames)
    let preview_x = kb_preview_axis(len(preview_y))
    let shared_preview = python_shared_buffer(smoothed, "float32", [project.render_frames], "audio/waveform")
    let shared_info = interop_shared_buffer_info(shared_preview)
    let module_score = kb_audio_module_score() + shared_info.byte_length

    return KainbletonAudioReport {
        module_score: module_score,
        daw_shape_text: daw_shape,
        output_path: output_path,
        sample_rate: project.sample_rate,
        frames: project.render_frames,
        rms: rms_value,
        peak: peak,
        preview_x: preview_x,
        preview_y: preview_y,
        wave_object: smoothed,
        shared_preview: shared_preview,
    }
