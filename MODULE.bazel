module(
    name = "kain",
    version = "0.1.0",
)

# launcher freshness probe

bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")

local_path_override(
    module_name = "rules_rust",
    path = "toolchain/rules_rust",
)

single_version_override(
    module_name = "rules_swift",
    patch_strip = 1,
    patches = [
        "//:tools/bazel/patches/rules_swift_windows_sdkroot_guard.patch",
        "//:tools/bazel/patches/rules_swift_windows_toolchain_target_compat.patch",
    ],
    version = "3.1.2",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    build_script_rundir = "external/rules_rust++crate+crates__zstd-sys-2.0.16-zstd.1.5.7",
    crate = "zstd-sys",
)
crate.annotation(
    build_script_env = {
        # crate_universe expects a literal env value here. On this Windows
        # workstation the PyO3-compatible interpreter lives on the F: toolchain
        # drive and build-script PATH does not include Scoop shims.
        "PYO3_PYTHON": "F:/Scoop/apps/python312/current/python.exe",
    },
    crate = "pyo3-build-config",
)
crate.annotation(
    build_script_env = {
        "PYO3_PYTHON": "F:/Scoop/apps/python312/current/python.exe",
    },
    crate = "pyo3-ffi",
)

# Keep legacy `serde::__private` reachable for older SWC macro stacks until
# those crates stop depending on Serde's hidden compatibility seam.
crate.annotation(
    crate = "serde",
    patch_args = ["-p1"],
    patches = ["@@//tools/bazel/patches:serde_private_alias_compat.patch"],
    version = "1.0.228",
)
crate.from_cargo(
    name = "crates",
    cargo_config = "//:.cargo/config.toml",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
    ],
)
use_repo(crate, "crates")
