// === SlateTest Plugin: Types ===
// Enums, delegates, and data structures

enum ItemRarity:
    Common
    Uncommon
    Rare
    Epic
    Legendary

enum ItemCategory:
    Weapon
    Armor
    Consumable
    Material
    Quest

type OnItemSelected = delegate(Int)
type OnHealthChanged = delegate(Float, Float)
type OnFilterChanged = delegate(String)

@datatable
struct ItemDefinition:
    id: Int
    name: String
    description: String
    category: ItemCategory
    rarity: ItemRarity
    value: Int
    weight: Float
    max_stack: Int
    icon_path: String

struct ItemStack:
    item_id: Int
    quantity: Int
    durability: Float
