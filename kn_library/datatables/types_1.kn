// KClonerPro - Core Types and Enums
// This file defines all the fundamental types used throughout the plugin

// === DELEGATES ===
type OnClonerRebuilt = fn()
type OnClonerUpdated = fn(Float)
type OnCloneInteracted = fn(Int, Vec3)
type OnEffectorChanged = fn(Float)

// === ENUMS ===

enum ClonerMode:
    Linear
    Grid
    Radial
    Spline
    Custom

enum DistributionType:
    Uniform
    Random
    Curve
    Noise

enum EffectorType:
    Sphere
    Box
    Cylinder
    Spline
    Custom

enum ModifierBlendMode:
    Add
    Multiply
    Override
    Lerp

// === CORE STRUCTS ===

// Instance cache for performance
struct InstanceCache:
    r: Float
    g: Float
    b: Float
    time: Float
    visible: Bool

// Transform data
struct CloneTransform:
    location: Vec3
    rotation: Vec3
    scale: Vec3

// Distribution parameters
@datatable
struct DistributionParams:
    @category("Distribution|Mode")
    @display_name("Distribution Mode")
    mode: ClonerMode
    
    @category("Distribution|Count")
    @clamp_min(1)
    @clamp_max(10000)
    @ui_min(1)
    @ui_max(1000)
    count: Int
    
    @category("Distribution|Spacing")
    @units("cm")
    spacing: Vec3
    
    @category("Distribution|Grid")
    @edit_condition("mode == ClonerMode::Grid")
    @clamp_min(1)
    grid_x: Int
    
    @category("Distribution|Grid")
    @edit_condition("mode == ClonerMode::Grid")
    @clamp_min(1)
    grid_y: Int
    
    @category("Distribution|Grid")
    @edit_condition("mode == ClonerMode::Grid")
    @clamp_min(1)
    grid_z: Int
    
    @category("Distribution|Radial")
    @edit_condition("mode == ClonerMode::Radial")
    @units("degrees")
    @clamp_min(0)
    @clamp_max(360)
    radius: Float
    
    @category("Distribution|Random")
    @edit_condition("mode == ClonerMode::Random")
    random_seed: Int

// Effector settings
@datatable
struct EffectorSettings:
    @category("Effector|Type")
    effector_type: EffectorType
    
    @category("Effector|Influence")
    @clamp_min(0)
    @clamp_max(1)
    @ui_min(0)
    @ui_max(1)
    strength: Float
    
    @category("Effector|Influence")
    @units("cm")
    @clamp_min(0)
    radius: Float
    
    @category("Effector|Falloff")
    @clamp_min(0)
    @clamp_max(10)
    falloff: Float
    
    @category("Effector|Animation")
    @units("x")
    speed: Float

// Modifier settings
@datatable
struct ModifierSettings:
    @category("Modifier|Basic")
    @display_name("Modifier Name")
    name: String
    
    @category("Modifier|Basic")
    enabled: Bool
    
    @category("Modifier|Blend")
    blend_mode: ModifierBlendMode
    
    @category("Modifier|Blend")
    @clamp_min(0)
    @clamp_max(1)
    blend_weight: Float
    
    @category("Modifier|Transform")
    position_offset: Vec3
    
    @category("Modifier|Transform")
    rotation_offset: Vec3
    
    @category("Modifier|Transform")
    scale_multiplier: Vec3
    
    @category("Modifier|Color")
    color_tint: Vec3
    
    @category("Modifier|Animation")
    @units("x")
    animation_speed: Float

// Animation settings
@datatable
struct AnimationSettings:
    @category("Animation|Playback")
    @display_name("Animation Sequence")
    anim_sequence: AnimSequence
    
    @category("Animation|Playback")
    @units("x")
    @clamp_min(0)
    @clamp_max(10)
    play_rate: Float
    
    @category("Animation|Playback")
    should_loop: Bool
    
    @category("Animation|Timing")
    @units("seconds")
    start_time: Float
    
    @category("Animation|Timing")
    @units("seconds")
    blend_in_time: Float
    
    @category("Animation|Timing")
    @units("seconds")
    blend_out_time: Float
