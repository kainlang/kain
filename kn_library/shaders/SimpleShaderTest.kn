// Simple shader test to verify UE5 pipeline
// Single shader with minimal complexity

enum EffectQuality:
    Low
    Medium
    High
    Ultra

// Simple color grading shader
shader fragment ColorGrading(uv: Vec2, input_color: Vec3) -> Vec4:
    uniform contrast: Float @0
    uniform saturation: Float @1
    uniform gamma: Float @2
    uniform vignette_intensity: Float @3
    
    var color = input_color
    
    // Contrast
    color = (color - 0.5) * contrast + 0.5
    
    // Saturation
    let luminance = dot(color, vec3(0.299, 0.587, 0.114))
    color = color * saturation + vec3(luminance, luminance, luminance) * (1.0 - saturation)
    
    // Gamma
    color = pow(color, vec3(1.0 / gamma, 1.0 / gamma, 1.0 / gamma))
    
    // Vignette
    let center_dist = length(uv - vec2(0.5, 0.5))
    let vignette = 1.0 - center_dist * vignette_intensity
    color = color * vignette
    
    return vec4(color, 1.0)

// Actor to control the shader
actor ColorGradingActor:
    state contrast: Float = 1.0
    state saturation: Float = 1.0
    state gamma: Float = 1.0
    state vignette_intensity: Float = 0.3
    
    on BeginPlay():
        println("Color grading initialized")

@blueprint
fn get_quality_multiplier(quality: EffectQuality) -> Float:
    match quality:
        EffectQuality::Low => 0.5
        EffectQuality::Medium => 0.75
        EffectQuality::High => 1.0
        EffectQuality::Ultra => 1.5
        _ => 1.0
