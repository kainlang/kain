// shaders.kn - Compute shader with permutations

shader compute TestShader(thread_id: Vec3) -> Vec4:
    // Permutation parameters (compile-time branching)
    uniform ENABLE_HIGH_QUALITY: Float @0
    uniform USE_ADVANCED_MATH: Float @1
    
    // Regular parameters (runtime values)
    uniform color: Vec3 @2
    uniform intensity: Float @3
    uniform time: Float @4
    
    // Output UAV
    uniform output_texture: RWTexture2D @5
    
    let uv = vec2(thread_id.x / 1920.0, thread_id.y / 1080.0)
    
    var final_color = color * intensity
    
    if ENABLE_HIGH_QUALITY:
        // High quality path
        final_color = final_color * 1.2
    
    if USE_ADVANCED_MATH:
        // Advanced math path
        let wave = sin(time + uv.x * 10.0) * 0.5 + 0.5
        final_color = final_color * wave
    
    return vec4(final_color, 1.0)
