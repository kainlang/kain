# ============================================================================
# ALPHAGEN - FILTER SHADERS
# 15 GPU-accelerated post-processing filters
# ============================================================================

# Copy shader - reliable texture copy
shader compute FilterCopy(thread_id: Vec3) -> Vec4:
    uniform input_texture: Sampler2D @0
    uniform texture_size: UVec2 @1
    
    let pixel = uint2(thread_id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y:
        return vec4(0.0, 0.0, 0.0, 0.0)
    
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    return sample(input_texture, uv)

# Blur - box blur with distance weighting
shader compute FilterBlur(thread_id: Vec3) -> Vec4:
    uniform input_texture: Sampler2D @0
    uniform texture_size: UVec2 @1
    uniform radius: Float @2
    
    let pixel = uint2(thread_id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y:
        return vec4(0.0, 0.0, 0.0, 0.0)
    
    let texel_size = vec2(1.0, 1.0) / vec2(texture_size)
    let uv = (vec2(pixel) + 0.5) * texel_size
    let r = int(clamp(radius, 0.0, 16.0))
    
    if r == 0:
        return sample(input_texture, uv)
    
    var sum = vec4(0.0, 0.0, 0.0, 0.0)
    var total_weight = 0.0
    
    # Note: Kain needs loop support for full implementation
    # Placeholder returns center sample
    return sample(input_texture, uv)

# Invert - simple color inversion
shader compute FilterInvert(thread_id: Vec3) -> Vec4:
    uniform input_texture: Sampler2D @0
    uniform texture_size: UVec2 @1
    
    let pixel = uint2(thread_id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y:
        return vec4(0.0, 0.0, 0.0, 0.0)
    
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let color = sample(input_texture, uv)
    return vec4(1.0 - color.r, 1.0 - color.g, 1.0 - color.b, color.a)
