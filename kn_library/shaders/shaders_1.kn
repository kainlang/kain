// KClonerPro - Compute Shaders
// GPU-accelerated clone processing

// === INSTANCE TRANSFORM SHADER ===
shader compute InstanceTransformShader(thread_id: Vec3) -> Vec4:
    uniform instance_count: Int @0
    uniform time: Float @1
    uniform animation_speed: Float @2
    
    // Permutation flags for quality levels
    uniform CFG_HIGH_QUALITY: Float @3
    uniform ENABLE_PHYSICS: Float @4
    
    let index = thread_id.x
    
    if index >= instance_count:
        return vec4(0, 0, 0, 0)
    
    var result = vec4(0, 0, 0, 1)
    
    if CFG_HIGH_QUALITY:
        // High quality path - more expensive calculations
        result.x = sin(time * animation_speed + index)
        result.y = cos(time * animation_speed + index)
        result.z = sin(time * 0.5 + index * 0.1)
    else:
        // Low quality path - cheaper calculations
        result.x = sin(time + index)
        result.y = cos(time + index)
        result.z = 0.0
    
    if ENABLE_PHYSICS:
        // Apply physics simulation
        result.z = result.z + sin(time * 2.0)
    
    return result

// === COLOR GRADIENT SHADER ===
shader compute ColorGradientShader(thread_id: Vec3) -> Vec4:
    uniform instance_count: Int @0
    uniform gradient_start: Vec3 @1
    uniform gradient_end: Vec3 @2
    uniform time: Float @3
    
    let index = thread_id.x
    
    if index >= instance_count:
        return vec4(0, 0, 0, 0)
    
    let t = index / instance_count
    let color = gradient_start * (1.0 - t) + gradient_end * t
    
    // Add time-based variation
    let variation = sin(time + index * 0.1) * 0.1
    
    return vec4(color.x + variation, color.y + variation, color.z + variation, 1.0)

// === EFFECTOR INFLUENCE SHADER ===
shader compute EffectorInfluenceShader(thread_id: Vec3) -> Vec4:
    uniform instance_count: Int @0
    uniform effector_location: Vec3 @1
    uniform effector_radius: Float @2
    uniform effector_strength: Float @3
    uniform falloff: Float @4
    
    uniform ENABLE_MULTIPLE_EFFECTORS: Float @5
    
    let index = thread_id.x
    
    if index >= instance_count:
        return vec4(0, 0, 0, 0)
    
    // Calculate distance to effector
    let clone_pos = vec3(index * 100.0, 0.0, 0.0)
    let distance = length(clone_pos - effector_location)
    
    var influence = 0.0
    
    if distance < effector_radius:
        let normalized_dist = distance / effector_radius
        influence = (1.0 - normalized_dist) * effector_strength
        
        // Apply falloff
        influence = pow(influence, falloff)
    
    if ENABLE_MULTIPLE_EFFECTORS:
        // Combine multiple effector influences
        influence = influence * 0.5
    
    return vec4(influence, influence, influence, 1.0)

// === NOISE FIELD SHADER ===
shader compute NoiseFieldShader(thread_id: Vec3) -> Vec4:
    uniform grid_size: Int @0
    uniform noise_scale: Float @1
    uniform noise_seed: Float @2
    uniform time: Float @3
    
    uniform CFG_3D_NOISE: Float @4
    uniform ENABLE_TURBULENCE: Float @5
    
    let x = thread_id.x
    let y = thread_id.y
    let z = thread_id.z
    
    var noise_value = 0.0
    
    if CFG_3D_NOISE:
        // 3D noise - more expensive
        let pos = vec3(x, y, z) * noise_scale
        noise_value = sin(pos.x + noise_seed) * cos(pos.y + noise_seed) * sin(pos.z + noise_seed)
    else:
        // 2D noise - cheaper
        let pos = vec2(x, y) * noise_scale
        noise_value = sin(pos.x + noise_seed) * cos(pos.y + noise_seed)
    
    if ENABLE_TURBULENCE:
        // Add turbulence layers
        noise_value = noise_value + sin(time + x * 0.1) * 0.2
    
    return vec4(noise_value, noise_value, noise_value, 1.0)

// === VERTEX ANIMATION SHADER ===
shader compute VertexAnimationShader(thread_id: Vec3) -> Vec4:
    uniform vertex_count: Int @0
    uniform time: Float @1
    uniform wave_frequency: Float @2
    uniform wave_amplitude: Float @3
    
    uniform ENABLE_VERTEX_COLORS: Float @4
    
    let vertex_id = thread_id.x
    
    if vertex_id >= vertex_count:
        return vec4(0, 0, 0, 0)
    
    // Calculate wave displacement
    let wave = sin(time * wave_frequency + vertex_id * 0.1) * wave_amplitude
    
    var result = vec4(0, wave, 0, 1)
    
    if ENABLE_VERTEX_COLORS:
        // Add color variation based on displacement
        result.x = wave * 0.5 + 0.5
        result.z = 1.0 - (wave * 0.5 + 0.5)
    
    return result
