# Stdlib Type Definitions Only
# These are the types that user code references

# From components.kn
@component
struct HealthComponent:
    current_health: Float
    max_health: Float

struct InventorySlot:
    item_id: Int
    quantity: Int
    durability: Float

struct GameTimerHandle:
    handle_id: Int
    is_active: Bool

struct GameInputAction:
    action_name: String
    key_binding: String
    is_pressed: Bool

# From patterns.kn
enum GameDamageType:
    Physical
    Magical
    Fire
    Ice
    Lightning
    Poison
    TrueDamage

struct DamageInfo:
    amount: Float
    damage_type: GameDamageType
    instigator: Int
    is_critical: Bool

enum QuestStatus:
    NotStarted
    InProgress
    Completed
    Failed

struct QuestObjective:
    description: String
    current_progress: Int
    required_progress: Int
    is_complete: Bool

enum LootRarity:
    Common
    Uncommon
    Rare
    Epic
    Legendary
    Mythic

struct LootDrop:
    item_id: Int
    quantity: Int
    rarity: LootRarity
    drop_chance: Float

enum BuffType:
    Damage
    Defense
    Speed
    Health
    Mana

struct BuffEffect:
    buff_type: BuffType
    magnitude: Float
    duration: Float
    remaining_time: Float
    stacks: Int

struct DialogueChoice:
    text: String
    next_node_id: Int
    required_item: Int
    required_quest: Int

struct DialogueNode:
    speaker_name: String
    dialogue_text: String
    choices: Array<DialogueChoice>

struct CraftingIngredient:
    item_id: Int
    quantity: Int

struct CraftingRecipe:
    recipe_id: Int
    result_item_id: Int
    result_quantity: Int
    ingredients: Array<CraftingIngredient>
    crafting_time: Float

struct SaveData:
    player_name: String
    player_level: Int
    player_xp: Int
    player_gold: Int
    save_timestamp: Float
    save_location: Vec3

enum AchievementType:
    KillCount
    QuestComplete
    ItemCollect
    LevelReach
    TimePlay

struct Achievement:
    achievement_id: Int
    name: String
    description: String
    achievement_type: AchievementType
    target_value: Int
    current_value: Int
    is_unlocked: Bool
    reward_xp: Int
    reward_gold: Int
