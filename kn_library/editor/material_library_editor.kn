// KAIN UE5 Editor Tool: Material Library Browser
// A complete editor tool for managing material collections

// Custom Asset Type: Material Library Collection
@asset_type
struct MaterialLibraryAsset:
    LibraryName: String
    Description: String
    Category: String
    Tags: String
    MaterialCount: Int
    ThumbnailPath: String
    CreatedDate: String
    LastModified: String
    Author: String
    Version: String
    IsPublic: Bool
    Rating: Float

// Custom Asset Type: Material Preset
@asset_type
struct MaterialPreset:
    PresetName: String
    BaseColor: Color
    Roughness: Float
    Metallic: Float
    Specular: Float
    EmissiveColor: Color
    EmissiveStrength: Float
    NormalStrength: Float
    DisplacementScale: Float
    TilingU: Float
    TilingV: Float
    Category: String
    Tags: String

// Custom Asset Type: Shader Configuration
@asset_type
struct ShaderConfig:
    ConfigName: String
    ShaderModel: String
    QualityLevel: Int
    EnableSSR: Bool
    EnableGI: Bool
    EnableShadows: Bool
    ShadowQuality: Int
    MaxTextureSize: Int
    AnisotropicFiltering: Int
    LODBias: Float

// Slate Widget: Material Browser Main Window
@slate
struct MaterialBrowserWindow:
    WindowTitle: Text
    @argument
    InitialWidth: Float
    @argument
    InitialHeight: Float
    SearchQuery: String
    SelectedCategory: String
    SortMode: String
    FilterTags: String
    ShowFavorites: Bool
    ShowRecent: Bool
    ThumbnailSize: Float
    OnMaterialSelected: void
    OnMaterialDoubleClicked: void
    OnSearchChanged: void
    OnCategoryChanged: void
    OnFilterChanged: void
    OnRefreshClicked: void
    OnImportClicked: void
    OnExportClicked: void
    OnSettingsClicked: void

// Slate Widget: Material Details Panel
@slate
struct MaterialDetailsPanel:
    MaterialName: Text
    MaterialPath: Text
    @argument
    PanelWidth: Float
    ShowAdvanced: Bool
    OnPropertyChanged: void
    OnApplyClicked: void
    OnResetClicked: void
    OnSavePresetClicked: void

// Slate Widget: Material Preview Viewport
@slate
struct MaterialPreviewViewport:
    @argument
    ViewportWidth: Float
    @argument
    ViewportHeight: Float
    PreviewMesh: String
    LightingMode: String
    BackgroundColor: Color
    ShowGrid: Bool
    ShowStats: Bool
    RotationSpeed: Float
    ZoomLevel: Float
    OnMeshChanged: void
    OnLightingChanged: void
    OnResetCamera: void

// Slate Widget: Material Thumbnail Grid
@slate
struct MaterialThumbnailGrid:
    @argument
    GridWidth: Float
    @argument
    GridHeight: Float
    ThumbnailSize: Float
    ColumnsPerRow: Int
    ShowLabels: Bool
    ShowRatings: Bool
    EnableDragDrop: Bool
    OnThumbnailClicked: void
    OnThumbnailHovered: void
    OnThumbnailDragged: void

// Slate Widget: Category Tree View
@slate
struct CategoryTreeView:
    @argument
    TreeWidth: Float
    @argument
    TreeHeight: Float
    RootCategory: String
    ExpandedCategories: String
    ShowCounts: Bool
    AllowRename: Bool
    AllowDelete: Bool
    OnCategorySelected: void
    OnCategoryRenamed: void
    OnCategoryDeleted: void
    OnCategoryCreated: void

// Slate Widget: Search and Filter Bar
@slate
struct SearchFilterBar:
    @argument
    BarWidth: Float
    SearchPlaceholder: Text
    ShowAdvancedFilters: Bool
    EnableAutoComplete: Bool
    OnSearchTextChanged: void
    OnFilterApplied: void
    OnClearFilters: void

// Slate Widget: Material Import Dialog
@slate
struct MaterialImportDialog:
    DialogTitle: Text
    @argument
    DialogWidth: Float
    @argument
    DialogHeight: Float
    SourcePath: String
    TargetCategory: String
    ImportMode: String
    OverwriteExisting: Bool
    GenerateThumbnails: Bool
    OptimizeTextures: Bool
    OnImportConfirmed: void
    OnImportCancelled: void
    OnBrowseClicked: void

// Slate Widget: Batch Operations Panel
@slate
struct BatchOperationsPanel:
    @argument
    PanelWidth: Float
    @argument
    PanelHeight: Float
    SelectedCount: Int
    OperationType: String
    TargetCategory: String
    ApplyToAll: Bool
    OnBatchApply: void
    OnBatchCancel: void
    OnSelectAll: void
    OnDeselectAll: void

// Slate Widget: Material Statistics Widget
@slate
struct MaterialStatsWidget:
    @argument
    WidgetWidth: Float
    TotalMaterials: Int
    TotalCategories: Int
    TotalPresets: Int
    FavoritesCount: Int
    RecentCount: Int
    StorageUsed: Float
    LastSyncTime: String
    OnRefreshStats: void

// Slate Widget: Quick Actions Toolbar
@slate
struct QuickActionsToolbar:
    @argument
    ToolbarHeight: Float
    ShowLabels: Bool
    IconSize: Float
    OnNewMaterial: void
    OnDuplicateMaterial: void
    OnDeleteMaterial: void
    OnFavoriteToggle: void
    OnShareMaterial: void
    OnExportSelected: void

// Editor Module: Material Library Editor
@editor_module
struct MaterialLibraryEditor:
    EditorVersion: String
    EnableAutoSave: Bool
    AutoSaveInterval: Int
    MaxRecentItems: Int
    DefaultThumbnailSize: Float
    EnableCloudSync: Bool
    CachePath: String
