    OnPropertyChanged: void
    OnSaveClicked: void
    OnTestAbility: void
    OnDuplicateAbility: void
    OnDeleteAbility: void
    OnImportAbility: void
    OnExportAbility: void

@slate
struct DialogueGraphEditor:
