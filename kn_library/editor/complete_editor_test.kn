# KAIN UE5 Editor Tool: Complete Editor Suite Test
# Comprehensive test of @asset_type, @slate, and @editor_module

# ============================================================================
# CUSTOM ASSET TYPES - Data-driven editor content
# ============================================================================

@asset_type
struct GameplayAbility:
    AbilityName: String
    Description: String
    Icon: String
    CooldownDuration: Float
    ManaCost: Float
    HealthCost: Float
    Damage: Float
    Range: Float
    AreaOfEffect: Float
    CastTime: Float
    ChannelTime: Float
    MaxCharges: Int
    RequiredLevel: Int
    AbilityTags: String
    BlockedTags: String
    ActivationTags: String
    IsPassive: Bool
    IsToggleable: Bool
    CanCastWhileMoving: Bool
    InterruptsMovement: Bool
    RequiresTarget: Bool
    TargetType: String
    AnimationMontage: String
    ParticleEffect: String
    SoundEffect: String
    CameraShake: String

@asset_type
struct DialogueTree:
    TreeName: String
    Description: String
    Speaker: String
    Listener: String
    RootNodeID: Int
    NodeCount: Int
    BranchCount: Int
    ConditionCount: Int
    IsRepeatable: Bool
    RequiredQuestID: Int
    RequiredItemID: Int
    RequiredLevel: Int
    RewardExperience: Int
    RewardGold: Int
    RewardItemID: Int
    RewardItemCount: Int
    UnlocksQuestID: Int
    SetsFlagID: Int
    VoiceOverAsset: String
    SubtitleKey: String
    EmotionalTone: String
    CameraAngle: String

@asset_type
struct QuestDefinition:
    QuestID: Int
    QuestName: String
    QuestDescription: String
    QuestGiver: String
    QuestCategory: String
    RequiredLevel: Int
    RecommendedLevel: Int
    IsMainQuest: Bool
    IsSideQuest: Bool
    IsRepeatable: Bool
    MaxRepeatCount: Int
    CooldownHours: Float
    ObjectiveCount: Int
    ObjectiveDescription: String
    RequiredKillCount: Int
    RequiredCollectCount: Int
    RequiredLocationID: Int
    RequiredDialogueID: Int
    PrerequisiteQuestID: Int
    RewardExperience: Int
    RewardGold: Int
    RewardItemID: Int
    RewardItemCount: Int
    RewardAbilityID: Int
    FailureCondition: String
    TimeLimit: Float
    TrackedInJournal: Bool

@asset_type
struct WeaponDefinition:
    WeaponID: Int
    WeaponName: String
    WeaponType: String
    WeaponClass: String
    Rarity: String
    RequiredLevel: Int
    RequiredStrength: Int
    RequiredDexterity: Int
    RequiredIntelligence: Int
    BaseDamage: Float
    AttackSpeed: Float
    CriticalChance: Float
    CriticalDamage: Float
    Range: Float
    Durability: Float
    MaxDurability: Float
    Weight: Float
    Value: Int
    SocketCount: Int
    EnchantmentSlots: Int
    UpgradeLevel: Int
    MaxUpgradeLevel: Int
    MeshAsset: String
    IconAsset: String
    MaterialAsset: String
    ParticleEffect: String
    TrailEffect: String
    ImpactEffect: String
    SwingSound: String
    HitSound: String
    EquipSound: String

@asset_type
struct CharacterClass:
    ClassName: String
    Description: String
    IconPath: String
    StartingHealth: Float
    StartingMana: Float
    StartingStamina: Float
    HealthPerLevel: Float
    ManaPerLevel: Float
    StaminaPerLevel: Float
    StrengthPerLevel: Float
    DexterityPerLevel: Float
    IntelligencePerLevel: Float
    VitalityPerLevel: Float
    LuckPerLevel: Float
    BaseMovementSpeed: Float
    BaseDodgeChance: Float
    BaseBlockChance: Float
    BaseCritChance: Float
    StartingWeaponID: Int
    StartingArmorID: Int
    StartingAbilityID: Int
    AllowedWeaponTypes: String
    AllowedArmorTypes: String
    PrimaryAttribute: String
    SecondaryAttribute: String
    PlayableInMultiplayer: Bool

# ============================================================================
# SLATE WIDGETS - Editor UI Components
# ============================================================================

@slate
struct AbilityEditorWindow:
    WindowTitle: Text
    @argument
    WindowWidth: Float
    @argument
    WindowHeight: Float
    SelectedAbility: String
    ShowAdvancedProperties: Bool
    EnableRealTimePreview: Bool
    PreviewCharacter: String
    PreviewAnimation: String
