fn interpret(program: &crate::types::TypedProgram) -> Result<Value, Error>:
    let mut env = Env__new_()
    for item in &program.items:
        match item:
            Use(u) =>
                load_module(&mut env, &u.ast)?
            Function(f) =>
                env.functions.insert(f.ast.name.clone(), f.ast.clone())
                env.define(f.ast.name.clone(), Value__Function(f.ast.name.clone()))
            Actor(a) =>
                env.actor_defs.insert(a.ast.name.clone(), a.ast.clone())
            Component(c) =>
                env.components.insert(c.ast.name.clone(), c.ast.clone())
            Const(c) =>
                let val = eval_expr(&mut env, &c.ast.value)?
                env.define(c.ast.name.clone(), val)
            Impl(i) =>
                let type_name = match &i.ast.target_type:
                    _ =>
                        name.clone()
                    _ =>
                        continue
                let type_methods = env.methods.entry(type_name).or_insert_with(std__collections__HashMap__new_)
                for method in &i.ast.methods:
                    type_methods.insert(method.name.clone(), method.clone())
            Comptime(_) =>
                let __selfhost_empty = none
            _ =>
                let __selfhost_empty = none
    match env.functions.get("main").cloned():
        Some(main_fn) =>
            eval_block(&mut env, &main_fn.body)
        _ =>
            Ok(Value__Unit)

fn find_stdlib_roots() -> Array<std::path::PathBuf>:
    let mut roots = Vec__new_()
    match std__env__var_("KAIN_STDLIB_PATH"):
        Ok(env_path) =>
            let p = std__path__PathBuf__from(env_path)
            roots.push(p)
        _ =>
            none
    match std__env__current_exe():
        Ok(exe_path) =>
            match exe_path.parent().map(none):
                Some(mut dir) =>
                    loop:
                        roots.push(dir.join("stdlib"))
                        if (!dir.pop()):
                            break
                _ =>
                    none
        _ =>
            none
    match std__env__current_dir():
        Ok(mut dir) =>
            loop:
                roots.push(dir.join("stdlib"))
                if (!dir.pop()):
                    break
        _ =>
            none
    roots

fn load_module(env: &mut Env, u: &Use) -> Result<(), Error>:
    let path = u.path.join("/")
    if (path == "stdlib"):
        return Ok(none)
    let file_path = if (path.starts_with("std/") || path.starts_with("stdlib/")):
        let module_name = path.trim_start_matches("std/").trim_start_matches("stdlib/")
        let mut file_path = None
        for root in find_stdlib_roots():
            let candidate = root.join(f"{module_name}.kn")
            if candidate.exists():
                file_path = Some(candidate)
                break
        file_path.ok_or_else(none)?
    else:
        let base_path = std__path__Path__new_(&path)
        let possible_paths = [base_path.with_extension("kn"), std__path__PathBuf__from(f"src/{path}.kn"), std__path__PathBuf__from(f"{path}.kn"), base_path.with_extension("god")]
        possible_paths.iter().find(none).cloned().ok_or_else(none)?
    let source = std__fs__read_to_string(&file_path).map_err(none)?
    let lexer = crate__lexer__Lexer__new_(&source)
    let tokens = lexer.tokenize()?
    let span_mapper = crate__diagnostics__SpanMapper__new_(&source)
    let filename = file_path.to_string_lossy().to_string()
    let mut parser = crate__parser__Parser__new_(&tokens, &span_mapper, &filename)
    let program = parser.parse()?
    for item in program.items:
        match item:
            Function(f) =>
                env.functions.insert(f.name.clone(), f.clone())
                env.define(f.name.clone(), Value__Function(f.name.clone()))
            Component(c) =>
                env.components.insert(c.name.clone(), c)
            Struct(s) =>
                let field_names = s.fields.iter().map(none).collect()
                env.define(s.name.clone(), Value__StructConstructor(s.name.clone(), field_names))
            Enum(e) =>
                for variant in &e.variants:
                    let variant_name = f"{e.name}::{variant.name}"
                    env.define(variant_name, Value__Function(f"{e.name}::{variant.name}"))
            Actor(a) =>
                env.actor_defs.insert(a.name.clone(), a)
            Const(c) =>
                let val = eval_expr(env, &c.value)?
                env.define(c.name.clone(), val)
            Impl(i) =>
                match &i.target_type:
                    _ =>
                        let lowered_fns: Array<(String, Function)> = i.methods.iter().map(none).collect()
                        for _item in lowered_fns:
                            env.functions.insert(lowered_name.clone(), method)
                            env.define(lowered_name.clone(), Value__Function(lowered_name))
                        let type_methods = env.methods.entry(name.clone()).or_insert_with(std__collections__HashMap__new_)
                        for method in &i.methods:
                            type_methods.insert(method.name.clone(), method.clone())
                    _ =>
                        none
            Use(u) =>
                load_module(env, &u)?
            _ =>
                let __selfhost_empty = none
    Ok(none)

fn eval_block(env: &mut Env, block: &Block) -> Result<Value, Error>:
    for stmt in &block.stmts:
        let result = eval_stmt(env, stmt)?
        match &result:
            Return(_) =>
                return Ok(result)
            _ =>
                let __selfhost_empty = none
    Ok(Value__Unit)

fn eval_stmt(env: &mut Env, stmt: &Stmt) -> Result<Value, Error>:
    match stmt:
        Expr(expr) =>
            let val = eval_expr(env, expr)?
            match &val:
                Return(_) =>
                    return Ok(val)
                _ =>
                    let __selfhost_empty = none
            Ok(Value__Unit)
        _ =>
            let val = match value:
                Some(expr) =>
                    eval_expr(env, expr)?
                _ =>
                    Value__None
            match val:
                Return(_) =>
                    return Ok(val)
                _ =>
                    none
            match pattern:
                _ =>
                    env.define(name.clone(), val)
                _ =>
                    none
            Ok(Value__Unit)
        Return(expr, _) =>
            let val = match expr:
                Some(e) =>
                    eval_expr(env, e)?
                _ =>
                    Value__Unit
            match val:
                Return(_) =>
                    return Ok(val)
                _ =>
                    none
            Ok(Value__Return(Box__new_(val)))
        _ =>
            let iter_val = eval_expr(env, iter)?
            match iter_val:
                Return(_) =>
                    return Ok(iter_val)
                _ =>
                    none
            match iter_val:
                Array(arr) =>
                    let arr = arr.read().unwrap().clone()
                    for val in arr.iter():
                        env.push_scope()
                        match binding:
                            _ =>
                                env.define(name.clone(), val.clone())
                            _ =>
                                none
                        let res = eval_block(env, body)?
                        env.pop_scope()
                        match res:
                            Return(_) =>
                                return Ok(res)
                            Break(_) =>
                                break
                            Continue =>
                                continue
                            _ =>
                                let __selfhost_empty = none
                _ =>
                    match iter_val:
                        String(s) =>
                            for c in s.chars():
                                env.push_scope()
                                match binding:
                                    _ =>
                                        env.define(name.clone(), Value__String(c.to_string()))
                                    _ =>
                                        none
                                let res = eval_block(env, body)?
                                env.pop_scope()
                                match res:
                                    Return(_) =>
                                        return Ok(res)
                                    Break(_) =>
                                        break
                                    Continue =>
                                        continue
                                    _ =>
                                        let __selfhost_empty = none
                        _ =>
                            none
            Ok(Value__Unit)
        _ =>
            loop:
                let cond = eval_expr(env, condition)?
                match cond:
                    Return(_) =>
                        return Ok(cond)
                    _ =>
                        none
                match cond:
                    Bool(false) =>
                        break
                    _ =>
                        none
                let res = eval_block(env, body)?
                match res:
                    Return(_) =>
                        return Ok(res)
                    Break(_) =>
                        break
                    Continue =>
                        continue
                    _ =>
                        let __selfhost_empty = none
            Ok(Value__Unit)
        _ =>
            loop:
                let res = eval_block(env, body)?
                match res:
                    Return(_) =>
                        return Ok(res)
                    Break(val) =>
                        return Ok(val.map(none).unwrap_or(Value__Unit))
                    Continue =>
                        continue
                    _ =>
                        let __selfhost_empty = none
        Break(expr, _) =>
            let val = match expr:
                Some(e) =>
                    Some(Box__new_(eval_expr(env, e)?))
                _ =>
                    None
            Ok(Value__Break(val))
        Continue(_) =>
            Ok(Value__Continue)
        _ =>
            Ok(Value__Unit)

fn eval_assignment(env: &mut Env, target: &Expr, value: Value) -> Result<(), Error>:
    match target:
        Ident(name, _) =>
            env.assign(name, value)
        _ =>
            let obj_val = eval_expr(env, object)?
            match obj_val:
                Struct(_, fields) =>
                    fields.write().unwrap().insert(field.clone(), value)
                _ =>
                    match obj_val:
                        ActorRef(r) =>
                            match env.self_actor_id:
                                Some(self_id) =>
                                    if (self_id == r.id):
                                        return env.assign(field, value)
                                _ =>
                                    none
                            return Err(crate__error__KainError__runtime("Cannot assign to remote actor fields"))
                        _ =>
                            return Err(crate__error__KainError__runtime("Field assignment only supported on structs"))
            Ok(none)
        _ =>
            let obj_val = eval_expr(env, object)?
            let idx_val = eval_expr(env, index)?
            match (obj_val, idx_val):
                (Array(arr), Int(i)) =>
                    let i = i as usize
                    let mut arr = arr.write().unwrap()
                    if (i < arr.len()):
                        arr[i] = value
                    else:
                        return Err(crate__error__KainError__runtime("Index out of bounds"))
                _ =>
                    return Err(crate__error__KainError__runtime("Index assignment only supported on arrays with int index"))
            Ok(none)
        _ =>
            Err(crate__error__KainError__runtime("Invalid assignment target"))

fn eval_expr(env: &mut Env, expr: &Expr) -> Result<Value, Error>:
    match expr:
        _ =>
            let obj_val = eval_expr(env, receiver)?
            match obj_val:
                Return(_) =>
                    return Ok(obj_val)
                _ =>
                    none
            let mut arg_vals = Vec__new_()
            for arg in args:
                let v = eval_expr(env, &arg.value)?
                match v:
                    Return(_) =>
                        return Ok(v)
                    _ =>
                        none
                arg_vals.push(v)
            match obj_val:
                Struct(name, _) =>
                    let func_name = f"{name}_{method}"
                    match env.functions.get(&func_name).cloned():
                        Some(func) =>
                            env.push_scope()
                            env.define("self".to_string(), obj_val)
                            let param_iter = if func.params.first().map(none).unwrap_or(false):
                                func.params.iter().skip(1)
                            else:
                                func.params.iter().skip(0)
                            if (param_iter.len() != arg_vals.len()):
                                return Err(crate__error__KainError__runtime(f"Method {func_name} arg mismatch"))
                            for _item in param_iter.zip(arg_vals.into_iter()):
                                env.define(param.name.clone(), arg)
                            let result = eval_block(env, &func.body)?
                            env.pop_scope()
                            match result:
                                Return(v) =>
                                    Ok((*v))
                                v =>
                                    Ok(v)
                        _ =>
                            Err(crate__error__KainError__runtime(f"Method {method} not found for type {name}"))
                Array(_) =>
                    match method.as_str():
                        "push" =>
                            if (arg_vals.len() != 1):
                                return Err(crate__error__KainError__runtime("push expects 1 argument"))
                            match obj_val:
                                Array(arr) =>
                                    arr.write().unwrap().push(arg_vals[0].clone())
                                    Ok(Value__Unit)
                                _ =>
                                    panic("unreachable!")
                        "len" =>
                            match obj_val:
                                Array(arr) =>
                                    Ok(Value__Int(arr.read().unwrap().len() as i64))
                                _ =>
                                    panic("unreachable!")
                        _ =>
                            Err(crate__error__KainError__runtime(f"Method {method} not found on Array"))
                _ =>
                    Err(crate__error__KainError__runtime(f"Method calls not supported on this type: {obj_val}"))
        _ =>
            match callee.as_ref():
                _ =>
                    match object.as_ref():
                        Ident(type_name, _) =>
                            let method = env.methods.get(type_name).and_then(none).cloned()
                            match method:
                                Some(method) =>
                                    let mut arg_vals = Vec__new_()
                                    for arg in args:
                                        let v = eval_expr(env, &arg.value)?
                                        match v:
                                            Return(_) =>
                                                return Ok(v)
                                            _ =>
                                                none
                                        arg_vals.push(v)
                                    env.push_scope()
                                    for _item in method.params.iter().zip(arg_vals.into_iter()):
                                        env.define(param.name.clone(), arg)
                                    let result = eval_block(env, &method.body)
                                    env.pop_scope()
                                    return none
                                _ =>
                                    none
                        _ =>
                            none
                    let obj_val = eval_expr(env, object)?
                    match obj_val:
                        Return(_) =>
                            return Ok(obj_val)
                        _ =>
                            none
                    let type_name = match &obj_val:
                        Struct(name, _) =>
                            Some(name.clone())
                        _ =>
                            None
                    match type_name:
                        Some(type_name) =>
                            let method = env.methods.get(&type_name).and_then(none).cloned()
                            match method:
                                Some(method) =>
                                    let mut arg_vals = Vec__new_()
                                    for arg in args:
                                        let v = eval_expr(env, &arg.value)?
                                        match v:
                                            Return(_) =>
                                                return Ok(v)
                                            _ =>
                                                none
                                        arg_vals.push(v)
                                    env.push_scope()
                                    env.define("self".to_string(), obj_val)
                                    let params_iter = match method.params.first():
                                        Some(first) =>
                                            if (first.name == "self"):
                                                method.params.iter().skip(1)
                                            else:
                                                method.params.iter().skip(0)
                                        _ =>
                                            method.params.iter().skip(0)
                                    for _item in params_iter.zip(arg_vals.into_iter()):
                                        env.define(param.name.clone(), arg)
                                    let result = eval_block(env, &method.body)
                                    env.pop_scope()
                                    return none
                                _ =>
                                    none
                        _ =>
                            none
                _ =>
                    none
            let func_val = none
            let mut arg_vals = Vec__new_()
            for arg in args:
                let v = eval_expr(env, &arg.value)?
                match v:
                    Return(_) =>
                        return Ok(v)
                    _ =>
                        none
                arg_vals.push(v)
            call_function(env, func_val, arg_vals)
        Try(inner, _) =>
            let val = eval_expr(env, inner)?
            match val:
                Return(_) =>
                    return Ok(val)
                _ =>
                    none
            match val:
                Result(true, v) =>
                    Ok((*v))
                Result(false, e) =>
                    Ok(Value__Return(Box__new_(Value__Result(false, e))))
                _ =>
                    Err(crate__error__KainError__runtime("Type error: expected Result for ? operator"))
        _ =>
            let cond = eval_expr(env, condition)?
            match cond:
                Return(_) =>
                    return Ok(cond)
                _ =>
                    none
            match cond:
                Bool(true) =>
                    eval_block(env, then_branch)
                _ =>
                    match else_branch:
                        Some(eb) =>
                            match eb.as_ref():
                                Else(block) =>
                                    eval_block(env, block)
                                _ =>
                                    Ok(Value__Unit)
                        _ =>
                            Ok(Value__Unit)
        _ =>
            let val = eval_expr(env, scrutinee)?
            match val:
                Return(_) =>
                    return Ok(val)
                _ =>
                    none
            for arm in arms:
                if pattern_matches(&arm.pattern, &val):
                    env.push_scope()
                    bind_pattern(env, &arm.pattern, &val)
                    let res = eval_expr(env, &arm.body)?
                    env.pop_scope()
                    return Ok(res)
            Ok(Value__Unit)
        _ =>
            match name.as_str():
                "vec" =>
                    let mut vals = Vec__new_()
                    for arg in args:
                        let v = eval_expr(env, arg)?
                        match v:
                            Return(_) =>
                                return Ok(v)
                            _ =>
                                none
                        vals.push(v)
                    Ok(Value__Array(std__sync__Arc__new_(std__sync__RwLock__new_(vals))))
                "format" =>
                    let mut res = String__new_()
                    for arg in args:
                        let v = eval_expr(env, arg)?
                        res.push_str(&v)
                    Ok(Value__String(res))
                "__kain_write_fmt" =>
                    if (args.len() != 2):
                        return Err(crate__error__KainError__runtime(f"{name}: expected destination and message"))
                    let message = eval_expr(env, &args[1])?
                    let suffix = if (name == "__kain_writeln_fmt"):
                        "\n"
                    else:
                        ""
                    Ok(Value__String(f"{message}{suffix}"))
                "type_name" =>
                    match args.first():
                        Some(arg) =>
                            let v = eval_expr(env, arg)?
                            let type_name = match v:
                                Unit =>
                                    "unit"
                                Bool(_) =>
                                    "bool"
                                Int(_) =>
                                    "int"
                                Float(_) =>
                                    "float"
                                String(_) =>
                                    "string"
                                Array(_) =>
                                    "array"
                                Tuple(_) =>
                                    "tuple"
                                Struct(name, _) =>
                                    return Ok(Value__String(name.clone()))
                                Function(_) =>
                                    "function"
                                NativeFn(_, _) =>
                                    "native_fn"
                                StructConstructor(_, _) =>
                                    "struct_constructor"
                                ActorRef(_) =>
                                    "actor"
                                None =>
                                    "none"
                                Return(_) =>
                                    "return"
                                Result(_, _) =>
                                    "result"
                                Closure(_, _, _) =>
                                    "closure"
                                JSX(_) =>
                                    "jsx"
                                EnumVariant(enum_name, _, _) =>
                                    return Ok(Value__String(enum_name.clone()))
                                Poll(_, _) =>
                                    "poll"
                                Future(name, _) =>
                                    return Ok(Value__String(f"Future<{name}>"))
                                Break(_) =>
                                    "break"
                                Continue =>
                                    "continue"
                            Ok(Value__String(type_name.to_string()))
                        _ =>
                            Err(crate__error__KainError__runtime("type_name! requires an argument"))
                _ =>
                    Err(crate__error__KainError__runtime(f"Unknown macro: {name}!"))
        _ =>
            let v = eval_expr(env, value)?
            match v:
                Return(_) =>
                    return Ok(v)
                _ =>
                    none
            eval_assignment(env, target, v)?
            Ok(Value__Unit)
        Int(n, _) =>
            Ok(Value__Int((*n)))
        Float(n, _) =>
            Ok(Value__Float((*n)))
        String(s, _) =>
            Ok(Value__String(s.clone()))
        FString(parts, _) =>
            let mut result = String__new_()
            for part in parts:
                let val = eval_expr(env, part)?
                match val:
                    Return(_) =>
                        return Ok(val)
                    _ =>
                        none
                result.push_str(&val)
            Ok(Value__String(result))
        Bool(b, _) =>
            Ok(Value__Bool((*b)))
        None(_) =>
            Ok(Value__None)
        _ =>
            let param_names = params.iter().map(none).collect()
            Ok(Value__Closure(param_names, body.clone(), env.scopes.clone()))
        Ident(name, span) =>
            env.lookup(name).cloned().ok_or_else(none)
        _ =>
            let l = eval_expr(env, left)?
            match l:
                Return(_) =>
                    return Ok(l)
                _ =>
                    none
            let r = eval_expr(env, right)?
            match r:
                Return(_) =>
                    return Ok(r)
                _ =>
                    none
            eval_binop((*op), l, r)
        _ =>
            let v = eval_expr(env, operand)?
            match v:
                Return(_) =>
                    return Ok(v)
                _ =>
                    none
            match (op, v):
                (Neg, Int(n)) =>
                    Ok(Value__Int((-n)))
                (Neg, Float(n)) =>
                    Ok(Value__Float((-n)))
                (Not, Bool(b)) =>
                    Ok(Value__Bool((!b)))
                (BitNot, Int(n)) =>
                    Ok(Value__Int((!n)))
                _ =>
                    Err(crate__error__KainError__runtime("Invalid unary operation"))
        Array(elements, _) =>
            let mut vals = Vec__new_()
            for elem in elements:
                let v = eval_expr(env, elem)?
                match v:
                    Return(_) =>
                        return Ok(v)
                    _ =>
                        none
                vals.push(v)
            Ok(Value__Array(std__sync__Arc__new_(std__sync__RwLock__new_(vals))))
        _ =>
            let obj = eval_expr(env, object)?
            match obj:
                Return(_) =>
                    return Ok(obj)
                _ =>
                    none
            let idx = eval_expr(env, index)?
            match idx:
                Return(_) =>
                    return Ok(idx)
                _ =>
                    none
            match (obj, idx):
                (Array(arr), Int(i)) =>
                    let i = i as usize
                    let arr = arr.read().unwrap()
                    if (i < arr.len()):
                        Ok(arr[i].clone())
                    else:
                        Err(crate__error__KainError__runtime(f"Index out of bounds: {i}"))
                (String(s), Int(i)) =>
                    let i = i as usize
                    if (i < s.len()):
                        Ok(Value__String(s.chars().nth(i).unwrap().to_string()))
                    else:
                        Err(crate__error__KainError__runtime(f"Index out of bounds: {i}"))
                _ =>
                    Err(crate__error__KainError__runtime("Index operator requires array/string and int"))
        _ =>
            let mut field_vals = std__collections__HashMap__new_()
            for _item in fields:
                let v = eval_expr(env, expr)?
                match v:
                    Return(_) =>
                        return Ok(v)
                    _ =>
                        none
                field_vals.insert(k.clone(), v)
            Ok(Value__Struct(name.clone(), std__sync__Arc__new_(std__sync__RwLock__new_(field_vals))))
        _ =>
            let mut field_vals = std__collections__HashMap__new_()
            for _item in fields:
                let v = eval_expr(env, expr)?
                match v:
                    Return(_) =>
                        return Ok(v)
                    _ =>
                        none
                field_vals.insert(k.clone(), v)
            let name = match ty:
                _ =>
                    name.clone()
                _ =>
                    "<aggregate>".to_string()
            Ok(Value__Struct(name, std__sync__Arc__new_(std__sync__RwLock__new_(field_vals))))
        JSX(node, _) =>
            crate__ui__eval_jsx(env, node)
        _ =>
            let obj_val = eval_expr(env, object)?
            match obj_val:
                Return(_) =>
                    return Ok(obj_val)
                _ =>
                    none
            match obj_val:
                Struct(_, fields) =>
                    let fields = fields.read().unwrap()
                    fields.get(field).cloned().ok_or_else(none)
                ActorRef(r) =>
                    match env.self_actor_id:
                        Some(self_id) =>
                            if (self_id == r.id):
                                return env.lookup(field).cloned().ok_or_else(none)
                        _ =>
                            none
                    if (field == "id"):
                        return Ok(Value__Int(r.id as i64))
                    Err(crate__error__KainError__runtime("Actor fields not accessible"))
                _ =>
                    Err(crate__error__KainError__runtime(f"Field access on non-struct value: {obj_val}"))
        Tuple(elements, _) =>
            let mut vals = Vec__new_()
            for elem in elements:
                let v = eval_expr(env, elem)?
                match v:
                    Return(_) =>
                        return Ok(v)
                    _ =>
                        none
                vals.push(v)
            Ok(Value__Tuple(vals))
        _ =>
            let actor_def = env.actor_defs.get(actor_).cloned().ok_or_else(none)?
            let mut init_vals = std__collections__HashMap__new_()
            for _item in init:
                let v = eval_expr(env, expr)?
                match v:
                    Return(_) =>
                        return Ok(v)
                    _ =>
                        none
                init_vals.insert(field.clone(), v)
            let _ = flume__unbounded()
            let id = env.next_actor_id
            (env.next_actor_id + 1)
            let sender = tx.clone()
            env.actors.insert(id, sender.clone())
            let functions = env.functions.clone()
            let components = env.components.clone()
            let actor_defs = env.actor_defs.clone()
            let methods = env.methods.clone()
            let global_scope = env.scopes.first().cloned().unwrap_or_default()
            let actor_name = actor_.clone()
            let self_sender = tx.clone()
            std__thread__spawn_(none)
            Ok(Value__ActorRef(aggregate_init("ActorRef", id = id, sender = sender)))
        _ =>
            let actor_val = eval_expr(env, target)?
            match actor_val:
                Return(_) =>
                    return Ok(actor_val)
                _ =>
                    none
            match actor_val:
                ActorRef(r) =>
                    let mut msg_args = Vec__new_()
                    for _item in data:
                        let v = eval_expr(env, expr)?
                        msg_args.push(v)
                    let msg = aggregate_init("Message", name = message.clone(), args = msg_args)
                    let _ = r.sender.send_(msg)
                    Ok(Value__Unit)
                _ =>
                    Err(crate__error__KainError__runtime("send target must be an actor"))
        Block(block, _) =>
            eval_block(env, block)
        Return(expr, _) =>
            let val = match expr:
                Some(e) =>
                    eval_expr(env, e)?
                _ =>
                    Value__Unit
            Ok(Value__Return(Box__new_(val)))
        _ =>
            eval_expr(env, value)
        _ =>
            eval_expr(env, value)
        Deref(inner, _) =>
            eval_expr(env, inner)
        _ =>
            eval_expr(env, pointer)
        _ =>
            eval_expr(env, pointer)
        _ =>
            let evaluated = eval_expr(env, value)?
            match evaluated:
                Return(_) =>
                    return Ok(evaluated)
                _ =>
                    none
            Ok(Value__Unit)
        _ =>
            Ok(Value__Int(none))
        _ =>
            Ok(Value__Int(none))
        _ =>
            Ok(none)
        _ =>
            Ok(Value__None)
        _ =>
            Ok(if (*zeroed): Value__Int(0) else: Value__None)
        _ =>
            Ok(Value__Int(0))
        Paren(inner, _) =>
            eval_expr(env, inner)
        Await(future_expr, span) =>
            let future_val = eval_expr(env, future_expr)?
            match future_val:
                Return(_) =>
                    return Ok(future_val)
                _ =>
                    none
            poll_future_to_completion(env, future_val)
        _ =>
            match env.methods.get(enum_name).cloned():
                Some(type_methods) =>
                    match type_methods.get(variant).cloned():
                        Some(method) =>
                            let arg_vals: Array<Value> = match fields:
                                Unit =>
                                    Vec__new_()
                                Tuple(exprs) =>
                                    let mut vals = Vec__new_()
                                    for e in exprs:
                                        let v = eval_expr(env, e)?
                                        match v:
                                            Return(_) =>
                                                return Ok(v)
                                            _ =>
                                                none
                                        vals.push(v)
                                    vals
                                Struct(named_fields) =>
                                    let mut vals = Vec__new_()
                                    for _item in named_fields:
                                        let v = eval_expr(env, e)?
                                        match v:
                                            Return(_) =>
                                                return Ok(v)
                                            _ =>
                                                none
                                        vals.push(v)
                                    vals
                            env.push_scope()
                            for _item in method.params.iter().zip(arg_vals.into_iter()):
                                env.define(param.name.clone(), arg)
                            let result = eval_block(env, &method.body)?
                            env.pop_scope()
                            return none
                        _ =>
                            none
                _ =>
                    none
            let lowered_name = f"{enum_name}_{variant}"
            match env.functions.get(&lowered_name).cloned():
                Some(func) =>
                    let arg_vals: Array<Value> = match fields:
                        Unit =>
                            Vec__new_()
                        Tuple(exprs) =>
                            let mut vals = Vec__new_()
                            for e in exprs:
                                let v = eval_expr(env, e)?
                                match v:
                                    Return(_) =>
                                        return Ok(v)
                                    _ =>
                                        none
                                vals.push(v)
                            vals
                        Struct(named_fields) =>
                            let mut vals = Vec__new_()
                            for _item in named_fields:
                                let v = eval_expr(env, e)?
                                match v:
                                    Return(_) =>
                                        return Ok(v)
                                    _ =>
                                        none
                                vals.push(v)
                            vals
                    env.push_scope()
                    for _item in func.params.iter().zip(arg_vals.into_iter()):
                        env.define(param.name.clone(), arg)
                    let result = eval_block(env, &func.body)?
                    env.pop_scope()
                    return none
                _ =>
                    none
            let field_vals = match fields:
                Unit =>
                    Vec__new_()
                Tuple(exprs) =>
                    let mut vals = Vec__new_()
                    for e in exprs:
                        let v = eval_expr(env, e)?
                        match v:
                            Return(_) =>
                                return Ok(v)
                            _ =>
                                none
                        vals.push(v)
                    vals
                Struct(named_fields) =>
                    let mut vals = Vec__new_()
                    for _item in named_fields:
                        let v = eval_expr(env, e)?
                        match v:
                            Return(_) =>
                                return Ok(v)
                            _ =>
                                none
                        vals.push(v)
                    vals
            if (enum_name == "Poll"):
                match variant.as_str():
                    "Ready" =>
                        let inner = if field_vals.is_empty():
                            None
                        else:
                            Some(Box__new_(field_vals.into_iter().next().unwrap_or(Value__Unit)))
                        Ok(Value__Poll(true, inner))
                    "Pending" =>
                        Ok(Value__Poll(false, None))
                    _ =>
                        Ok(Value__EnumVariant(enum_name.clone(), variant.clone(), field_vals))
            else:
                Ok(Value__EnumVariant(enum_name.clone(), variant.clone(), field_vals))
        Break(expr, _) =>
            let val = match expr:
                Some(e) =>
                    Some(Box__new_(eval_expr(env, e)?))
                _ =>
                    None
            Ok(Value__Break(val))
        Continue(_) =>
            Ok(Value__Continue)
        _ =>
            Err(crate__error__KainError__runtime(f"Expression not supported in runtime: {expr}"))

fn call_function(env: &mut Env, func: Value, args: Array<Value>) -> Result<Value, Error>:
    match func:
        Function(name) =>
            let f = env.functions.get(&name).cloned().ok_or_else(none)?
            if (f.params.len() != args.len()):
                return Err(crate__error__KainError__runtime(f"Argument mismatch: expected {f.params.len()}, got {args.len()}"))
            env.push_scope()
            for _item in f.params.iter().zip(args.into_iter()):
                env.define(param.name.clone(), arg)
            let result = eval_block(env, &f.body)?
            env.pop_scope()
            match result:
                Return(v) =>
                    Ok((*v))
                v =>
                    Ok(v)
        NativeFn(_, f) =>
            f(env, args)
        Closure(params, body, captured) =>
            if (params.len() != args.len()):
                return Err(crate__error__KainError__runtime("Closure arg mismatch"))
            let old_scopes = env.scopes.clone()
            env.scopes = captured
            env.push_scope()
            for _item in params.iter().zip(args.into_iter()):
                env.define(name.clone(), arg)
            let result = eval_expr(env, &body)?
            env.pop_scope()
            env.scopes = old_scopes
            match result:
                Return(v) =>
                    Ok((*v))
                v =>
                    Ok(v)
        StructConstructor(name, fields) =>
            if (fields.len() != args.len()):
                return Err(crate__error__KainError__runtime(f"Struct constructor for {name} expected {fields.len()} arguments, got {args.len()}"))
            let mut field_vals = std__collections__HashMap__new_()
            for _item in args.into_iter().enumerate():
                field_vals.insert(fields[i].clone(), val)
            Ok(Value__Struct(name, std__sync__Arc__new_(std__sync__RwLock__new_(field_vals))))
        _ =>
            Err(crate__error__KainError__runtime("Not a function"))

fn eval_binop(op: BinaryOp, left: Value, right: Value) -> Result<Value, Error>:
    match (op, &left, &right):
        (Add, Int(a), Int(b)) =>
            Ok(Value__Int((a + b)))
        (Sub, Int(a), Int(b)) =>
            Ok(Value__Int((a - b)))
        (Mul, Int(a), Int(b)) =>
            Ok(Value__Int((a * b)))
        (Div, Int(a), Int(b)) =>
            Ok(Value__Int((a / b)))
        (Mod, Int(a), Int(b)) =>
            Ok(Value__Int((a % b)))
        (Add, Float(a), Float(b)) =>
            Ok(Value__Float((a + b)))
        (Sub, Float(a), Float(b)) =>
            Ok(Value__Float((a - b)))
        (Mul, Float(a), Float(b)) =>
            Ok(Value__Float((a * b)))
        (Div, Float(a), Float(b)) =>
            Ok(Value__Float((a / b)))
        (Add, String(a), String(b)) =>
            Ok(Value__String((a.to_owned() + b)))
        (Eq, Int(a), Int(b)) =>
            Ok(Value__Bool((a == b)))
        (Ne, Int(a), Int(b)) =>
            Ok(Value__Bool((a != b)))
        (Eq, String(a), String(b)) =>
            Ok(Value__Bool((a == b)))
        (Ne, String(a), String(b)) =>
            Ok(Value__Bool((a != b)))
        (Eq, Bool(a), Bool(b)) =>
            Ok(Value__Bool((a == b)))
        (Ne, Bool(a), Bool(b)) =>
            Ok(Value__Bool((a != b)))
        (Lt, Float(a), Float(b)) =>
            Ok(Value__Bool((a < b)))
        (Gt, Float(a), Float(b)) =>
            Ok(Value__Bool((a > b)))
        (Le, Float(a), Float(b)) =>
            Ok(Value__Bool((a <= b)))
        (Ge, Float(a), Float(b)) =>
            Ok(Value__Bool((a >= b)))
        (Eq, Float(a), Float(b)) =>
            Ok(Value__Bool((((a - b)).abs() < f64__EPSILON)))
        (Ne, Float(a), Float(b)) =>
            Ok(Value__Bool((((a - b)).abs() >= f64__EPSILON)))
        (Lt, Int(a), Int(b)) =>
            Ok(Value__Bool((a < b)))
        (Gt, Int(a), Int(b)) =>
            Ok(Value__Bool((a > b)))
        (Le, Int(a), Int(b)) =>
            Ok(Value__Bool((a <= b)))
        (Ge, Int(a), Int(b)) =>
            Ok(Value__Bool((a >= b)))
        (And, Bool(a), Bool(b)) =>
            Ok(Value__Bool(((*a) && (*b))))
        (Or, Bool(a), Bool(b)) =>
            Ok(Value__Bool(((*a) || (*b))))
        (BitAnd, Int(a), Int(b)) =>
            if crate__language_features__runtime_supports_binary_op(BinaryOp__BitAnd):
                Ok(Value__Int((a & b)))
            else:
                none
        (BitOr, Int(a), Int(b)) =>
            if crate__language_features__runtime_supports_binary_op(BinaryOp__BitOr):
                Ok(Value__Int((a | b)))
            else:
                none
        (BitXor, Int(a), Int(b)) =>
            if crate__language_features__runtime_supports_binary_op(BinaryOp__BitXor):
                Ok(Value__Int((a ^ b)))
            else:
                none
        (Shl, Int(a), Int(b)) =>
            if crate__language_features__runtime_supports_binary_op(BinaryOp__Shl):
                let shift = (((*b) as u32) & 63)
                Ok(Value__Int(a.wrapping_shl(shift)))
            else:
                none
        (Shr, Int(a), Int(b)) =>
            if crate__language_features__runtime_supports_binary_op(BinaryOp__Shr):
                let shift = (((*b) as u32) & 63)
                Ok(Value__Int(a.wrapping_shr(shift)))
            else:
                none
        (Eq, None, None) =>
            Ok(Value__Bool(true))
        (Ne, None, None) =>
            Ok(Value__Bool(false))
        (Eq, Unit, Unit) =>
            Ok(Value__Bool(true))
        (Ne, Unit, Unit) =>
            Ok(Value__Bool(false))
        (Eq, _, _) =>
            Ok(Value__Bool(false))
        (Ne, _, _) =>
            Ok(Value__Bool(true))
        _ =>
            Err(crate__error__KainError__runtime(f"Type mismatch in binary operation: {left} {op} {right}"))

fn pattern_matches(pattern: &Pattern, value: &Value) -> Bool:
    match pattern:
        Wildcard(_) =>
            true
        _ =>
            true
        Literal(Int(n, _)) =>
            match value:
                Int(v) =>
                    if ((*v) == (*n)):
                        true
                    else:
                        none
                _ =>
                    false
        Literal(String(s, _)) =>
            match value:
                String(v) =>
                    if (v == s):
                        true
                    else:
                        none
                _ =>
                    false
        Literal(Bool(b, _)) =>
            match value:
                Bool(v) =>
                    if ((*v) == (*b)):
                        true
                    else:
                        none
                _ =>
                    false
        Literal(None(_)) =>
            match value:
                None =>
                    true
                _ =>
                    false
        _ =>
            match value:
                Poll(ready, val) =>
                    if ((*variant) == "Ready"):
                        if (!ready):
                            return false
                        match fields:
                            Tuple(pats) =>
                                if (pats.len() == 1):
                                    return none
                            _ =>
                                none
                        return false
                    elif ((*variant) == "Pending"):
                        return (!ready)
                    return false
                _ =>
                    none
            match value:
                EnumVariant(_, v_name, v_fields) =>
                    if (variant != v_name):
                        return false
                    match fields:
                        Unit =>
                            v_fields.is_empty()
                        Tuple(pats) =>
                            if (pats.len() != v_fields.len()):
                                return false
                            pats.iter().zip(v_fields.iter()).all(none)
                        _ =>
                            false
                _ =>
                    false
        _ =>
            false

fn bind_pattern(env: &mut Env, pattern: &Pattern, value: &Value):
    match pattern:
        _ =>
            env.define(name.clone(), value.clone())
        _ =>
            match value:
                Poll(ready, val) =>
                    if (((*variant) == "Ready") && (*ready)):
                        match fields:
                            Tuple(pats) =>
                                if (pats.len() == 1):
                                    match val:
                                        Some(v) =>
                                            bind_pattern(env, &pats[0], v)
                                        _ =>
                                            none
                            _ =>
                                none
                _ =>
                    match value:
                        EnumVariant(_, _, v_fields) =>
                            match fields:
                                Tuple(pats) =>
                                    for _item in pats.iter().zip(v_fields.iter()):
                                        bind_pattern(env, p, v)
                                _ =>
                                    let __selfhost_empty = none
                        _ =>
                            none
        _ =>
            let __selfhost_empty = none

fn run_tests(program: &crate::types::TypedProgram) -> Result<(), Error>:
    println("\n Running Tests...\n")
    let mut passed = 0
    let mut failed = 0
    let mut env = Env__new_()
    for item in &program.items:
        match item:
            Function(f) =>
                env.functions.insert(f.ast.name.clone(), f.ast.clone())
                env.define(f.ast.name.clone(), Value__Function(f.ast.name.clone()))
            Actor(a) =>
                env.actor_defs.insert(a.ast.name.clone(), a.ast.clone())
            Component(c) =>
                env.components.insert(c.ast.name.clone(), c.ast.clone())
            Const(c) =>
                let val = eval_expr(&mut env, &c.ast.value)?
                env.define(c.ast.name.clone(), val)
            Impl(i) =>
                let type_name = match &i.ast.target_type:
                    _ =>
                        name.clone()
                    _ =>
                        continue
                let type_methods = env.methods.entry(type_name).or_insert_with(std__collections__HashMap__new_)
                for method in &i.ast.methods:
                    type_methods.insert(method.name.clone(), method.clone())
            Use(u) =>
                load_module(&mut env, &u.ast)?
            _ =>
                let __selfhost_empty = none
    for item in &program.items:
        match item:
            Test(test_) =>
                print(f"test {test_.ast.name} ... ")
                env.push_scope()
                match eval_block(&mut env, &test_.ast.body):
                    Ok(_) =>
                        println("ok")
                        (passed + 1)
                    Err(e) =>
                        println("FAILED")
                        println(f"  Error: {e}")
                        (failed + 1)
                env.pop_scope()
            _ =>
                none
    println("\nTest result: {if (failed == 0): \"ok\" else: \"FAILED\"}. {passed} passed; {failed} failed")
    if (failed > 0):
        Err(crate__error__KainError__runtime("Some tests failed"))
    else:
        Ok(none)

fn poll_future_to_completion(env: &mut Env, future_val: Value) -> Result<Value, Error>:
    let max_iterations = 100000
    let mut iterations = 0
    let current_future = future_val
    loop:
        (iterations + 1)
        if (iterations > max_iterations):
            return Err(crate__error__KainError__runtime("Async timeout: future did not complete"))
        let poll_result = poll_future_once(env, current_future.clone())?
        match extract_poll_result(&poll_result):
            Ready(val) =>
                return Ok(val)
            Pending =>
                std__thread__sleep(std__time__Duration__from_micros(10))
                continue
            NotAPoll =>
                return Ok(poll_result)

fn poll_future_once(env: &mut Env, future_val: Value) -> Result<Value, Error>:
    match &future_val:
        Future(struct_name, state_) =>
            let poll_fn_name = f"{struct_name}_poll"
            match env.functions.get(&poll_fn_name).cloned():
                Some(poll_fn) =>
                    let struct_val = Value__Struct(struct_name.clone(), state_.clone())
                    env.push_scope()
                    env.define("self".to_string(), struct_val.clone())
                    match poll_fn.params.first():
                        Some(first_param) =>
                            env.define(first_param.name.clone(), struct_val)
                        _ =>
                            none
                    let result = eval_block(env, &poll_fn.body)?
                    env.pop_scope()
                    let actual_result = match result:
                        Return(v) =>
                            (*v)
                        v =>
                            v
                    Ok(normalize_poll_result(actual_result))
                _ =>
                    Ok(Value__Poll(true, Some(Box__new_(Value__Unit))))
        Struct(struct_name, _) =>
            let poll_fn_name = f"{struct_name}_poll"
            match env.functions.get(&poll_fn_name).cloned():
                Some(poll_fn) =>
                    env.push_scope()
                    env.define("self".to_string(), future_val.clone())
                    match poll_fn.params.first():
                        Some(first_param) =>
                            env.define(first_param.name.clone(), future_val.clone())
                        _ =>
                            none
                    let result = eval_block(env, &poll_fn.body)?
                    env.pop_scope()
                    let actual_result = match result:
                        Return(v) =>
                            (*v)
                        v =>
                            v
                    Ok(normalize_poll_result(actual_result))
                _ =>
                    Ok(Value__Poll(true, Some(Box__new_(future_val))))
        Poll(_, _) =>
            Ok(future_val)
        EnumVariant(enum_name, _, _) =>
            if (enum_name == "Poll"):
                Ok(normalize_poll_result(future_val))
            else:
                none
        _ =>
            Ok(Value__Poll(true, Some(Box__new_(future_val))))

enum PollState:
    Ready(Value)
    Pending
    NotAPoll

fn extract_poll_result(val: &Value) -> PollState:
    match val:
        Poll(true, Some(inner)) =>
            PollState__Ready((*inner.clone()))
        Poll(true, None) =>
            PollState__Ready(Value__Unit)
        Poll(false, _) =>
            PollState__Pending
        EnumVariant(enum_name, variant, fields) =>
            if (enum_name == "Poll"):
                match variant.as_str():
                    "Ready" =>
                        if fields.is_empty():
                            PollState__Ready(Value__Unit)
                        else:
                            PollState__Ready(fields[0].clone())
                    "Pending" =>
                        PollState__Pending
                    _ =>
                        PollState__NotAPoll
            else:
                none
        Struct(name, fields) =>
            if name.contains("Ready"):
                let fields_guard = fields.read().unwrap()
                match fields_guard.get("0").or_(fields_guard.get("value")).or_(fields_guard.values().next()):
                    Some(val) =>
                        PollState__Ready(val.clone())
                    _ =>
                        PollState__Ready(Value__Unit)
            elif name.contains("Pending"):
                PollState__Pending
            else:
                PollState__NotAPoll
        Tuple(elems) =>
            if (elems.len() >= 1):
                match &elems[0]:
                    String(tag) =>
                        match tag.as_str():
                            "Ready" =>
                                if (elems.len() >= 2):
                                    PollState__Ready(elems[1].clone())
                                else:
                                    none
                            "Ready" =>
                                PollState__Ready(Value__Unit)
                            "Pending" =>
                                PollState__Pending
                            _ =>
                                PollState__NotAPoll
                    _ =>
                        PollState__NotAPoll
            else:
                none
        _ =>
            PollState__NotAPoll

fn normalize_poll_result(val: Value) -> Value:
    match extract_poll_result(&val):
        Ready(inner) =>
            Value__Poll(true, Some(Box__new_(inner)))
        Pending =>
            Value__Poll(false, None)
        NotAPoll =>
            val

struct ShaderComplexity:
    alu_ops: u32
    texture_samples: u32
    branches: u32

impl ShaderComplexity:
    fn generate_report(_self: &Self_, shader_name: &String) -> String:
        f"[{shader_name}] ALU: {_self.alu_ops}, Tex: {_self.texture_samples}, Branches: {_self.branches}\n"


fn analyze_shader(_program: &crate::types::TypedProgram) -> Array<(String, ShaderComplexity)>:
    Vec__new_()

struct Span:
    start: usize
    end: usize

impl Span:
    fn new_(start: usize, end: usize) -> Self_:
        aggregate_init("Self_", start = start, end = end)

    fn merge(_self: Self_, other: Span) -> Span:
        aggregate_init("Span", start = _self.start.min(other.start), end = _self.end.max(other.end))

    fn to_range(_self: Self_) -> std::ops::Range<usize>:
        range(_self.start, _self.end)


impl From for Span:
    fn from(range: std::ops::Range<usize>) -> Self_:
        Span__new_(range.start, range.end)


impl From for std::ops::Range<usize>:
    fn from(span: Span) -> Self_:
        span.to_range()


struct Spanned:
    value: T
    span: Span

impl Spanned<T>:
    fn new_(value: T, span: Span) -> Self_:
        aggregate_init("Self_", value = value, span = span)

    fn map(_self: Self_, f: F) -> Spanned<U>:
        aggregate_init("Spanned", value = f(_self.value), span = _self.span)


