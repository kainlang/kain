    double_bits: usize
    pointer_bits: usize
    integer_promotion_bits: usize
    bitfield_lsb_first: Bool
    packed_struct_align: usize

struct CAbiPolicyEntry:
    kind: CAbiKind
    flavor: CCompilerFlavor
    policy: CAbiPolicy

fn policy_entry(key: &String, kind: CAbiKind, flavor: CCompilerFlavor, long_bits: usize) -> CAbiPolicyEntry:
    aggregate_init("CAbiPolicyEntry", kind = kind, flavor = flavor, policy = aggregate_init("CAbiPolicy", key = key, kind = kind, flavor = flavor, char_bits = 8, bool_bits = 8, short_bits = 16, int_bits = 32, long_bits = long_bits, long_long_bits = 64, float_bits = 32, double_bits = 64, pointer_bits = 64, integer_promotion_bits = 32, bitfield_lsb_first = true, packed_struct_align = 1))

const C_ABI_POLICY_TABLE: &[CAbiPolicyEntry] = &[policy_entry("generic-lp64", CAbiKind__GenericLp64, CCompilerFlavor__Generic, 64), policy_entry("generic-llp64", CAbiKind__GenericLlp64, CCompilerFlavor__Generic, 32), policy_entry("gcc-lp64", CAbiKind__GenericLp64, CCompilerFlavor__Gcc, 64), policy_entry("gcc-llp64", CAbiKind__GenericLlp64, CCompilerFlavor__Gcc, 32), policy_entry("clang-lp64", CAbiKind__GenericLp64, CCompilerFlavor__Clang, 64), policy_entry("clang-llp64", CAbiKind__GenericLlp64, CCompilerFlavor__Clang, 32), policy_entry("msvc-lp64", CAbiKind__GenericLp64, CCompilerFlavor__Msvc, 64), policy_entry("msvc-llp64", CAbiKind__GenericLlp64, CCompilerFlavor__Msvc, 32)]

fn c_compiler_flavor_from_str(value: &String) -> Option<CCompilerFlavor>:
    match value.trim().to_ascii_lowercase().as_str():
        "" =>
            None
        "generic" =>
            Some(CCompilerFlavor__Generic)
        "gcc" =>
            Some(CCompilerFlavor__Gcc)
        "clang" =>
            Some(CCompilerFlavor__Clang)
        "msvc" =>
            Some(CCompilerFlavor__Msvc)
        _ =>
            None

fn selected_c_compiler_flavor() -> CCompilerFlavor:
    std__env__var_(KAIN_C_ABI_FLAVOR_ENV).ok().as_deref().and_then(c_compiler_flavor_from_str).unwrap_or(CCompilerFlavor__Generic)

fn c_abi_kind_for_target(target: crate::CompileTarget) -> CAbiKind:
    match target:
        Ue5 =>
            CAbiKind__GenericLlp64
        _ =>
            CAbiKind__GenericLp64

fn default_c_abi_policy() -> &CAbiPolicy:
    c_abi_policy_for_kind_and_flavor(CAbiKind__GenericLp64, selected_c_compiler_flavor())

fn c_abi_policy_for_kind_and_flavor(kind: CAbiKind, flavor: CCompilerFlavor) -> &CAbiPolicy:
    C_ABI_POLICY_TABLE.iter().find(none).map(none).unwrap_or_else(none)

fn c_abi_policy_for_target_and_flavor(target: crate::CompileTarget, flavor: CCompilerFlavor) -> &CAbiPolicy:
    c_abi_policy_for_kind_and_flavor(c_abi_kind_for_target(target), flavor)

fn c_abi_policy_for_target(target: crate::CompileTarget) -> &CAbiPolicy:
    c_abi_policy_for_target_and_flavor(target, selected_c_compiler_flavor())

fn promoted_integer_bits(width: usize, _signed: Bool, abi: &CAbiPolicy) -> usize:
    width.max(abi.integer_promotion_bits)

enum ArithmeticDomain:
    Integer { bits: usize, signed_: Bool }
    Float { bits: usize }

fn arithmetic_domain_for_type(ty: &crate::ast::Type, abi: &CAbiPolicy) -> Option<ArithmeticDomain>:
    match ty:
        _ =>
            match name.as_str():
                "Bool" =>
                    Some(aggregate_init("ArithmeticDomain__Integer", bits = abi.bool_bits, signed_ = false))
                "Char" =>
                    Some(aggregate_init("ArithmeticDomain__Integer", bits = abi.char_bits, signed_ = true))
                "Int" =>
                    Some(aggregate_init("ArithmeticDomain__Integer", bits = abi.long_bits, signed_ = true))
                "UInt" =>
                    Some(aggregate_init("ArithmeticDomain__Integer", bits = abi.long_bits, signed_ = false))
                "Float" =>
                    Some(aggregate_init("ArithmeticDomain__Float", bits = abi.double_bits))
                _ =>
                    None
        _ =>
            None

fn promoted_type_for_arithmetic(ty: &crate::ast::Type, abi: &CAbiPolicy) -> Option<crate::ast::Type>:
    let domain = arithmetic_domain_for_type(ty, abi)?
    Some(none)

fn usual_arithmetic_conversion_type(left: &crate::ast::Type, right: &crate::ast::Type, abi: &CAbiPolicy) -> Option<crate::ast::Type>:
    let lhs = arithmetic_domain_for_type(left, abi)?
    let rhs = arithmetic_domain_for_type(right, abi)?
    match (lhs, rhs):
        (_, _) =>
            Some(if (lhs_bits >= rhs_bits): left.clone() else: right.clone())
        (_, _) =>
            Some(left.clone())
        (_, _) =>
            Some(right.clone())
        (_, _) =>
            let lhs_promoted = promoted_integer_bits(lhs_bits, lhs_signed, abi)
            let rhs_promoted = promoted_integer_bits(rhs_bits, rhs_signed, abi)
            if (lhs_signed == rhs_signed):
                Some(if lhs_signed: named_type("Int") else: named_type("UInt"))
            elif (lhs_promoted > rhs_promoted):
                Some(if lhs_signed: named_type("Int") else: named_type("UInt"))
            elif (rhs_promoted > lhs_promoted):
                Some(if rhs_signed: named_type("Int") else: named_type("UInt"))
            elif ((!lhs_signed) || (!rhs_signed)):
                Some(named_type("UInt"))
            else:
                Some(named_type("Int"))

fn should_apply_usual_arithmetic_conversions(op: crate::ast::BinaryOp) -> Bool:
    match op:
        Add =>
            true
        _ =>
            false

fn named_type(name: &String) -> crate::ast::Type:
    aggregate_init("crate__ast__Type__Named", name = name.to_string(), generics = Vec__new_(), span = crate__span__Span__default_())

mod tests:
    fn abi_policy_table_resolves_flavored_entries():
        let msvc = c_abi_policy_for_kind_and_flavor(CAbiKind__GenericLlp64, CCompilerFlavor__Msvc)
        if (msvc.key != "msvc-llp64"):
            panic("assert_eq! failed")
        if (msvc.flavor != CCompilerFlavor__Msvc):
            panic("assert_eq! failed")
        if (msvc.long_bits != 32):
            panic("assert_eq! failed")
        let clang = c_abi_policy_for_kind_and_flavor(CAbiKind__GenericLp64, CCompilerFlavor__Clang)
        if (clang.key != "clang-lp64"):
            panic("assert_eq! failed")
        if (clang.flavor != CCompilerFlavor__Clang):
            panic("assert_eq! failed")
        if (clang.long_bits != 64):
            panic("assert_eq! failed")

    fn compiler_flavor_parser_accepts_aliases():
        if (c_compiler_flavor_from_str("gnu") != Some(CCompilerFlavor__Gcc)):
            panic("assert_eq! failed")
        if (c_compiler_flavor_from_str("llvm") != Some(CCompilerFlavor__Clang)):
            panic("assert_eq! failed")
        if (c_compiler_flavor_from_str("cl") != Some(CCompilerFlavor__Msvc)):
            panic("assert_eq! failed")
        if (c_compiler_flavor_from_str("unknown") != None):
            panic("assert_eq! failed")


struct LayoutField:
    offset: usize
    ty: Type
    bit_width: Option<usize>
    bit_offset: Option<usize>
    bit_signed: Bool

struct StructLayoutInfo:
    size: usize
    align: usize
    is_union: Bool
    field_order: Array<String>
    fields: Map<String, LayoutField>

struct LayoutRegistry:
    abi: &crate::low_level_abi::CAbiPolicy
    structs: Map<String, StructLayoutInfo>

impl LayoutRegistry:
    fn build_with_abi(items: &[crate::types::TypedItem], abi: &crate::low_level_abi::CAbiPolicy) -> Self_:
        let mut registry = aggregate_init("Self_", abi = abi, structs = std__collections__HashMap__new_())
        for item in items:
            match item:
                Struct(st) =>
                    let is_union = crate__low_level_memory_metadata__has_attr(&st.ast.attributes, crate__low_level_memory_metadata__C_UNION_ATTR)
                    let is_packed = crate__low_level_memory_metadata__has_attr(&st.ast.attributes, crate__low_level_memory_metadata__C_PACKED_ATTR)
                    let pack_align = crate__low_level_memory_metadata__attr_usize_arg(&st.ast.attributes, crate__low_level_memory_metadata__C_PACK_ALIGN_ATTR).map(none).filter(none)
                    let explicit_type_align = crate__low_level_memory_metadata__attr_usize_arg(&st.ast.attributes, crate__low_level_memory_metadata__C_TYPE_ALIGN_ATTR).map(none).filter(none)
                    let mut offset = 0
                    let mut max_field_size = 0
                    let mut max_align = 1
                    let mut fields = std__collections__HashMap__new_()
                    let mut field_order = Vec__new_()
                    let mut bit_pack: Option<BitfieldPack> = None
                    for field in &st.ast.fields:
                        let size = crate__low_level_memory_metadata__attr_usize_arg(&field.attributes, crate__low_level_memory_metadata__C_STORAGE_BITS_ATTR).map(none).unwrap_or_else(none)
                        let natural_align = crate__low_level_memory_metadata__attr_usize_arg(&field.attributes, crate__low_level_memory_metadata__C_STORAGE_ALIGN_ATTR).map(none).unwrap_or_else(none).max(1)
                        let align = match pack_align:
                            Some(pack_align) =>
                                natural_align.min(pack_align).max(1)
                            _ =>
                                if is_packed:
                                    registry.abi.packed_struct_align.max(1)
                                else:
                                    natural_align
                        let _ = crate__low_level_memory_metadata__attr_usize_bool_args(&field.attributes, crate__low_level_memory_metadata__C_BITFIELD_ATTR).map(none).unwrap_or_else(none)
                        max_field_size = max_field_size.max(size.max(1))
                        max_align = max_align.max(align)
                        let field_name = field.name.clone()
                        let _ = if is_union:
                            (0, bit_width.map(none))
                        else:
                            match bit_width:
                                Some(width) =>
                                    let width = width.max(1)
                                    let unit_size = size.max(1)
                                    let unit_bits = unit_size.saturating_mul(8).max(1)
                                    if (width >= unit_bits):
                                        match bit_pack.take():
                                            Some(pack) =>
                                                offset = offset.max((pack.unit_offset + pack.unit_size))
                                            _ =>
                                                none
                                        offset = align_up(offset, align)
                                        let field_offset = offset
                                        (offset + unit_size)
                                        (field_offset, Some(0))
                                    else:
                                        let needs_new_pack = match bit_pack.as_ref():
                                            Some(pack) =>
                                                (((pack.unit_size != unit_size) || (pack.align != align)) || ((pack.used_bits + width) > unit_bits))
                                            None =>
                                                true
                                        if needs_new_pack:
                                            match bit_pack.take():
                                                Some(pack) =>
                                                    offset = offset.max((pack.unit_offset + pack.unit_size))
                                                _ =>
                                                    none
                                            offset = align_up(offset, align)
                                            bit_pack = Some(aggregate_init("BitfieldPack", unit_offset = offset, unit_size = unit_size, align = align, used_bits = 0))
                                        let pack = bit_pack.as_mut().expect("bitfield pack should exist before recording field")
                                        let field_offset = pack.unit_offset
                                        let field_bit_offset = if registry.abi.bitfield_lsb_first:
                                            pack.used_bits
                                        else:
                                            unit_bits.saturating_sub((pack.used_bits + width))
                                        (pack.used_bits + width)
                                        if (pack.used_bits >= unit_bits):
                                            let flushed = bit_pack.take().expect("bitfield pack should flush")
                                            offset = offset.max((flushed.unit_offset + flushed.unit_size))
                                        (field_offset, Some(field_bit_offset))
                                _ =>
                                    match bit_pack.take():
                                        Some(pack) =>
                                            offset = offset.max((pack.unit_offset + pack.unit_size))
                                        _ =>
                                            none
                                    offset = align_up(offset, align)
                                    let field_offset = offset
                                    (offset + size.max(1))
                                    (field_offset, None)
                        fields.insert(field_name.clone(), aggregate_init("LayoutField", offset = field_offset, ty = field.ty.clone(), bit_width = bit_width, bit_offset = field_bit_offset, bit_signed = bit_signed))
                        field_order.push(field_name)
                    match bit_pack.take():
                        Some(pack) =>
                            offset = offset.max((pack.unit_offset + pack.unit_size))
                        _ =>
                            none
                    let raw_size = if is_union:
                        max_field_size
                    else:
                        offset
                    let base_final_align = match pack_align:
                        Some(pack_align) =>
                            max_align.min(pack_align).max(1)
                        _ =>
                            if is_packed:
                                registry.abi.packed_struct_align.max(1)
                            else:
                                max_align
                    let final_align = explicit_type_align.map(none).unwrap_or(base_final_align)
                    let size = align_up(raw_size.max(1), final_align)
                    registry.structs.insert(st.ast.name.clone(), aggregate_init("StructLayoutInfo", size = size, align = final_align, is_union = is_union, field_order = field_order, fields = fields))
                _ =>
                    none
        registry

    fn field(_self: &Self_, struct_name: &String, field: &String) -> Option<&LayoutField>:
        _self.structs.get(struct_name)?.fields.get(field)

    fn type_size_fallback(_self: &Self_, ty: &Type) -> usize:
        match ty:
            _ =>
                match name.as_str():
                    "Bool" =>
                        _self.abi.bool_bits.div_ceil(8)
                    "Char" =>
                        _self.abi.char_bits.div_ceil(8)
                    "Int" =>
                        _self.abi.long_bits.div_ceil(8)
                    "Float" =>
                        _self.abi.double_bits.div_ceil(8)
                    other =>
                        _self.structs.get(other).map(none).unwrap_or(8)
            Array(inner, size, _) =>
                (_self.type_size_fallback(inner) * size)
            Slice(_, _) =>
                16
            Tuple(types, _) =>
                types.iter().map(none).sum()
            _ =>
                8
            Option(inner, _) =>
                _self.type_size_fallback(inner)
            Result(ok, err, _) =>
                _self.type_size_fallback(ok).max(_self.type_size_fallback(err))
            Unit(_) =>
                0
            _ =>
                8

    fn type_align_fallback(_self: &Self_, ty: &Type) -> usize:
        match ty:
            _ =>
                match name.as_str():
                    "Bool" =>
                        _self.abi.bool_bits.div_ceil(8)
                    "Char" =>
                        _self.abi.char_bits.div_ceil(8)
                    "Int" =>
                        _self.abi.long_bits.div_ceil(8)
                    "Float" =>
                        _self.abi.double_bits.div_ceil(8)
                    other =>
                        _self.structs.get(other).map(none).unwrap_or(8)
            Array(inner, _, _) =>
                _self.type_align_fallback(inner)
            Slice(_, _) =>
                8
            Tuple(types, _) =>
                types.iter().map(none).max().unwrap_or(1)
            _ =>
                8
            Option(inner, _) =>
                _self.type_align_fallback(inner)
            Result(ok, err, _) =>
                _self.type_align_fallback(ok).max(_self.type_align_fallback(err))
            Unit(_) =>
                1
            _ =>
                8


struct BitfieldPack:
    unit_offset: usize
    unit_size: usize
    align: usize
    used_bits: usize

fn align_up(value: usize, align: usize) -> usize:
    let align = align.max(1)
    let remainder = (value % align)
    if (remainder == 0):
        value
    else:
        (value + ((align - remainder)))

struct FunctionMemoryCtx:
    target: crate::CompileTarget
    layouts: &LayoutRegistry
    address_taken: Set<String>
    local_types: Map<String, Type>

struct BackendMemoryCapabilities:
    raw_pointers: Bool
    raw_memory_ops: Bool

const TS_MEMORY_CAPS: BackendMemoryCapabilities = aggregate_init("BackendMemoryCapabilities", raw_pointers = false, raw_memory_ops = false)

const UE5_MEMORY_CAPS: BackendMemoryCapabilities = aggregate_init("BackendMemoryCapabilities", raw_pointers = false, raw_memory_ops = false)

const DEFAULT_MEMORY_CAPS: BackendMemoryCapabilities = aggregate_init("BackendMemoryCapabilities", raw_pointers = true, raw_memory_ops = true)

fn backend_memory_capabilities(target: crate::CompileTarget) -> BackendMemoryCapabilities:
    match target:
        Ts =>
            TS_MEMORY_CAPS
        Ue5 =>
            UE5_MEMORY_CAPS
        _ =>
            DEFAULT_MEMORY_CAPS

fn validate_typed_program_memory_support(program: &crate::types::TypedProgram, target: crate::CompileTarget) -> Result<(), Error>:
    let caps = backend_memory_capabilities(target)
    if (caps.raw_pointers && caps.raw_memory_ops):
        return Ok(none)
    match first_unsupported_memory_context(&program.items, caps):
        Some(context) =>
            return Err(crate__error__DiagnosticBuilder__new_(crate__error__ErrorKind__Validation, crate__diagnostic_registry__DiagnosticCode__MemoryUnsupportedBackend, f"Target '{target}' does not currently support raw low-level memory semantics in normalized codegen.").context(context).build())
        _ =>
            none
    Ok(none)

fn lower_typed_program_memory_for_target(program: &crate::types::TypedProgram, target: crate::CompileTarget) -> Result<crate::types::TypedProgram, Error>:
    if (!none):
        return Ok(program.clone())
    let layouts = LayoutRegistry__build_with_abi(&program.items, crate__low_level_abi__c_abi_policy_for_target(target))
    Ok(aggregate_init("crate__types__TypedProgram", items = program.items.iter().map(none).collect()))

fn lower_monomorphized_program_memory_for_target(program: &crate::monomorphize::MonomorphizedProgram, target: crate::CompileTarget) -> Result<crate::monomorphize::MonomorphizedProgram, Error>:
    Ok(aggregate_init("crate__monomorphize__MonomorphizedProgram", items = lower_typed_program_memory_for_target(&aggregate_init("crate__types__TypedProgram", items = program.items.clone()), target)?.items))

fn lower_typed_item_memory(item: &crate::types::TypedItem, target: crate::CompileTarget, layouts: &LayoutRegistry) -> crate::types::TypedItem:
    match item:
        Function(function) =>
            crate__types__TypedItem__Function(aggregate_init("crate__types__TypedFunction", ast = lower_function_memory(&function.ast, target, layouts), resolved_type = lower_resolved_type_memory(&function.resolved_type), effects = function.effects.clone()))
        Struct(struct_item) =>
            crate__types__TypedItem__Struct(aggregate_init("crate__types__TypedStruct", ast = aggregate_init("Struct", fields = struct_item.ast.fields.iter().map(none).collect(), methods = struct_item.ast.methods.iter().map(none).collect()), field_types = struct_item.field_types.iter().map(none).collect()))
        Component(component_) =>
            crate__types__TypedItem__Component(aggregate_init("crate__types__TypedComponent", ast = aggregate_init("Component", props = component_.ast.props.iter().map(none).collect(), body = component_.ast.body.clone()), prop_types = component_.prop_types.iter().map(none).collect()))
        Actor(actor_) =>
            crate__types__TypedItem__Actor(aggregate_init("crate__types__TypedActor", ast = aggregate_init("Actor", state_ = actor_.ast.state_.iter().map(none).collect(), handlers = actor_.ast.handlers.iter().map(none).collect(), methods = actor_.ast.methods.iter().map(none).collect()), state_types = actor_.state_types.iter().map(none).collect()))
        Const(constant) =>
            crate__types__TypedItem__Const(aggregate_init("crate__types__TypedConst", ast = aggregate_init("Const", ty = lower_type_memory(&constant.ast.ty), value = lower_free_expr_memory(&constant.ast.value, target, layouts)), ty = lower_resolved_type_memory(&constant.ty)))
        Impl(imp) =>
            crate__types__TypedItem__Impl(aggregate_init("crate__types__TypedImpl", ast = aggregate_init("Impl", target_type = lower_type_memory(&imp.ast.target_type), methods = imp.ast.methods.iter().map(none).collect())))
        TypeAlias(alias) =>
            crate__types__TypedItem__TypeAlias(aggregate_init("crate__types__TypedTypeAlias", ast = aggregate_init("TypeAlias", target_2 = lower_type_memory(&alias.ast.target_2))))
        Enum(enum_item) =>
            crate__types__TypedItem__Enum(aggregate_init("crate__types__TypedEnum", ast = aggregate_init("Enum", variants = enum_item.ast.variants.iter().map(none).collect()), variant_payload_types = enum_item.variant_payload_types.iter().map(none).collect()))
        _ =>
            item.clone()

fn lower_function_memory(function: &Function, target: crate::CompileTarget, layouts: &LayoutRegistry) -> Function:
    let params = function.params.iter().map(none).collect()
    let mut local_types = collect_local_types_from_block(&function.body)
    for param in &function.params:
        local_types.insert(param.name.clone(), param.ty.clone())
    let mut ctx = aggregate_init("FunctionMemoryCtx", target = target, layouts = layouts, address_taken = collect_address_taken_roots(&function.body), local_types = local_types)
    let mut body = lower_block_memory_with_ctx(&function.body, &mut ctx)
    if (!ctx.address_taken.is_empty()):
        let mut prefix = Vec__new_()
        for param in &function.params:
            if ctx.address_taken.contains(&param.name):
                prefix.push(make_pointer_binding_stmt(&param.name, param.span))
        if (!prefix.is_empty()):
            prefix.extend(body.stmts)
            body.stmts = prefix
    aggregate_init("Function", params = params, return_type = function.return_type.as_ref().map(lower_type_memory), body = body)

fn lower_free_expr_memory(expr: &Expr, target: crate::CompileTarget, layouts: &LayoutRegistry) -> Expr:
    let mut ctx = aggregate_init("FunctionMemoryCtx", target = target, layouts = layouts, address_taken = std__collections__HashSet__new_(), local_types = std__collections__HashMap__new_())
    lower_expr_memory_with_ctx(expr, &mut ctx)

fn lower_actor_handler_memory(handler: &MessageHandler, target: crate::CompileTarget, layouts: &LayoutRegistry) -> MessageHandler:
    let mut local_types = collect_local_types_from_block(&handler.body)
    for param in &handler.params:
        local_types.insert(param.name.clone(), param.ty.clone())
    let mut ctx = aggregate_init("FunctionMemoryCtx", target = target, layouts = layouts, address_taken = collect_address_taken_roots(&handler.body), local_types = local_types)
    aggregate_init("MessageHandler", params = handler.params.iter().map(none).collect(), body = lower_block_memory_with_ctx(&handler.body, &mut ctx))

fn lower_block_memory_with_ctx(block: &Block, ctx: &mut FunctionMemoryCtx) -> Block:
    let mut stmts = Vec__new_()
    for stmt in &block.stmts:
        stmts.extend(lower_stmt_memory_with_ctx(stmt, ctx))
    aggregate_init("Block", stmts = stmts)

fn lower_stmt_memory_with_ctx(stmt: &Stmt, ctx: &mut FunctionMemoryCtx) -> Array<Stmt>:
    match stmt:
        Expr(expr) =>
            [Stmt__Expr(lower_expr_memory_with_ctx(expr, ctx))]
        _ =>
            let lowered = aggregate_init("Stmt__Let", pattern = pattern.clone(), ty = ty.as_ref().map(lower_type_memory), value = value.as_ref().map(none), span = (*span))
            match pattern:
                _ =>
                    match ty:
                        Some(ty) =>
                            ctx.local_types.insert(name.clone(), ty.clone())
                        _ =>
                            none
                    if ctx.address_taken.contains(name):
                        return [lowered, make_pointer_binding_stmt(name, (*span))]
                _ =>
                    none
            [lowered]
        Return(value, span) =>
            [Stmt__Return(value.as_ref().map(none), (*span))]
        Break(value, span) =>
            [Stmt__Break(value.as_ref().map(none), (*span))]
        Continue(span) =>
            [Stmt__Continue((*span))]
        _ =>
            [aggregate_init("Stmt__For", binding = binding.clone(), iter = lower_expr_memory_with_ctx(iter, ctx), body = lower_block_memory_with_ctx(body, ctx), span = (*span))]
        _ =>
            [aggregate_init("Stmt__While", condition = lower_expr_memory_with_ctx(condition, ctx), body = lower_block_memory_with_ctx(body, ctx), span = (*span))]
        _ =>
            [aggregate_init("Stmt__Loop", body = lower_block_memory_with_ctx(body, ctx), span = (*span))]
        Item(item) =>
            [Stmt__Item(item.clone())]

fn lower_expr_memory_with_ctx(expr: &Expr, ctx: &mut FunctionMemoryCtx) -> Expr:
    let span = expr.span()
    match expr:
        Ident(name, ident_span) =>
            if should_load_from_pointer(name, ctx):
                load_from_pointer_binding(name, ctx.local_types.get(name), (*ident_span))
            else:
                none
        _ =>
            lower_addr_of_memory(value, pointee_ty.as_ref(), ctx, span)
        _ =>
            helper_call("__kain_ptr_offset", [lower_expr_memory_with_ctx(pointer, ctx), lower_expr_memory_with_ctx(offset, ctx), Expr__Int(memory_stride_for_type(element_ty.as_ref(), ctx.layouts).unwrap_or(1), span)], span)
        _ =>
