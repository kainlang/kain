struct Token:
    kind: TokenKind
    span: crate::span::Span

impl Token:
    fn new_(kind: TokenKind, span: crate::span::Span) -> Self_:
        aggregate_init("Self_", kind = kind, span = span)


struct Lexer:
    source: &String

impl Lexer:
    fn new_(source: &String) -> Self_:
        aggregate_init("Self_", source = source)

    fn tokenize(_self: &Self_) -> Result<Array<Token>, Error>:
        let mut lex = TokenKind__lexer(_self.source)
        let mut raw_tokens = Vec__new_()
        loop:
            match lex.next():
                Some(result) =>
                    let span = crate__span__Span__new_(lex.span().start, lex.span().end)
                    match result:
                        Ok(kind) =>
                            if (none):
                                continue
                            raw_tokens.push(Token__new_(kind, span))
                        Err(_) =>
                            return Err(crate__error__KainError__lexer(f"Unexpected character: '{&slice(_self.source, span.start, span.end)}'", span))
                _ =>
                    break
        let tokens = _self.process_indentation(raw_tokens)?
        Ok(tokens)

    fn process_indentation(_self: &Self_, raw: Array<Token>) -> Result<Array<Token>, Error>:
        let mut result = Vec__new_()
        let mut indent_stack: Array<usize> = [0]
        let mut iter = raw.into_iter().peekable()
        loop:
            match iter.next():
                Some(token) =>
                    match &token.kind:
                        Newline(ws) =>
                            match iter.peek():
                                Some(next) =>
                                    if (none):
                                        continue
                                _ =>
                                    none
                            let indent: usize = slice(ws, 1, none).chars().map(none).sum()
                            let current = (*indent_stack.last().unwrap())
                            if (indent > current):
                                indent_stack.push(indent)
                                result.push(Token__new_(TokenKind__Newline(ws.clone()), token.span))
                                result.push(Token__new_(TokenKind__Indent, token.span))
                            elif (indent < current):
                                result.push(Token__new_(TokenKind__Newline(ws.clone()), token.span))
                                while ((indent_stack.len() > 1) && ((*indent_stack.last().unwrap()) > indent)):
                                    indent_stack.pop()
                                    result.push(Token__new_(TokenKind__Dedent, token.span))
                            else:
                                result.push(Token__new_(TokenKind__Newline(ws.clone()), token.span))
                        _ =>
                            result.push(token)
                _ =>
                    break
        let final_span = result.last().map(none).unwrap_or(crate__span__Span__new_(0, 0))
        while (indent_stack.len() > 1):
            indent_stack.pop()
            result.push(Token__new_(TokenKind__Dedent, final_span))
        result.push(Token__new_(TokenKind__Eof, final_span))
        Ok(result)


fn unescape(s: &String) -> String:
    let mut result = String__with_capacity(s.len())
    let mut chars = s.chars()
    loop:
        match chars.next():
            Some(c) =>
                if (c == "\\"):
                    match chars.next():
                        Some("n") =>
                            result.push("\n")
                        Some("r") =>
                            result.push("\r")
                        Some("t") =>
                            result.push("\t")
                        Some("0") =>
                            result.push("\0")
                        Some("\\") =>
                            result.push("\\")
                        Some("\"") =>
                            result.push("\"")
                        Some("'") =>
                            result.push("'")
                        Some(other) =>
                            result.push("\\")
                            result.push(other)
                        None =>
                            result.push("\\")
                else:
                    result.push(c)
            _ =>
                break
    result

mod tests:
    fn test_basic_tokens():
        let source = "fn factorial(n: Int) -> Int"
        let tokens = Lexer__new_(source).tokenize().unwrap()
        if (!none):
            panic("assert! failed")
        if (!none):
            panic("assert! failed")

    fn test_indentation():
        let source = "fn foo():\n    let x = 1\n    let y = 2\n"
        let tokens = Lexer__new_(source).tokenize().unwrap()
        if (!tokens.iter().any(none)):
            panic("assert! failed")


enum CompileTarget:
    Wasm
    Js
    Ts
    Hybrid
    Llvm
    Rust
    Cpp
    Ue5
    Ue5Editor
    Usf
    Spirv
    Hlsl
    Interpret
    Test
    Ks

impl CompileTarget:
    fn from_str(s: &String) -> Option<Self_>:
        match s.to_lowercase().as_str():
            "wasm" =>
                Some(Self___Wasm)
            "js" =>
                Some(Self___Js)
            "ts" =>
                Some(Self___Ts)
            "hybrid" =>
                Some(Self___Hybrid)
            "llvm" =>
                Some(Self___Llvm)
            "rust" =>
                Some(Self___Rust)
            "cpp" =>
                Some(Self___Cpp)
            "ue5" =>
                Some(Self___Ue5)
            "ue5-editor" =>
                Some(Self___Ue5Editor)
            "usf" =>
                Some(Self___Usf)
            "spirv" =>
                Some(Self___Spirv)
            "hlsl" =>
                Some(Self___Hlsl)
            "interpret" =>
                Some(Self___Interpret)
            "test" =>
                Some(Self___Test)
            "ks" =>
                Some(Self___Ks)
            _ =>
                None


fn compile_(source: &String, target: CompileTarget) -> Result<String, KainError>:
    let stdlib = stdlib__load_stdlib_for_target(target)
    let full_source = f"{stdlib}\n{source}"
    let tokens = lexer__Lexer__new_(&full_source).tokenize()?
    let span_mapper = diagnostics__SpanMapper__new_(&full_source)
    let mut ast = parser__Parser__new_(&tokens, &span_mapper, "<input>").parse()?
    comptime___eval_program(&mut ast)?
    let typed_ast = types__check(&ast, &span_mapper, "<input>")?
    Ok(f"Compiled to {target}")

