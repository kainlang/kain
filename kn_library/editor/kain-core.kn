struct TypedProgram:
    items: Array<TypedItem>

struct TypedComptime:
    ast: Block

struct TypedConst:
    ast: Const
    ty: ResolvedType

struct TypedUse:
    ast: Use

enum TypedItem:
    Function(TypedFunction)
    Component(TypedComponent)
    Shader(TypedShader)
    Actor(TypedActor)
    Struct(TypedStruct)
    Enum(TypedEnum)
    Comptime(TypedComptime)
    Const(TypedConst)
    Macro(TypedMacro)
    Use(TypedUse)
    Impl(TypedImpl)
    Test(TypedTest)
    TypeAlias(TypedTypeAlias)
    MaterialGraph(crate::ast::MaterialGraphDef)
    MaterialFunction(crate::ast::MaterialFunctionDef)
    GraphEditor(crate::ast::GraphEditorDef)
    GraphRuntime(crate::ast::GraphRuntimeDef)
    StateMachine(crate::ast::StateMachineDef)
    AsyncTask(crate::ast::AsyncTaskDef)
    EditorModule(crate::ast::EditorModuleDef)
    GameplayTags(crate::ast::GameplayTagsNamespace)
    GameplayAbility(crate::ast::GameplayAbilityDef)
    GameplayEffect(crate::ast::GameplayEffectDef)
    GameplayCue(crate::ast::GameplayCueDef)

struct TypedTest:
    ast: TestDef

struct TypedTypeAlias:
    ast: TypeAlias

struct TypedImpl:
    ast: Impl

struct TypedMacro:
    ast: MacroDef

struct TypedActor:
    ast: Actor
    state_types: Map<String, ResolvedType>

struct TypedFunction:
    ast: Function
    resolved_type: ResolvedType
    effects: crate::effects::EffectSet

struct TypedComponent:
    ast: Component
    prop_types: Map<String, ResolvedType>

struct TypedShader:
    ast: Shader
    input_types: Array<ResolvedType>
    output_type: ResolvedType

struct TypedStruct:
    ast: Struct
    field_types: Map<String, ResolvedType>

struct TypedEnum:
    ast: Enum
    variant_payload_types: Map<String, Array<ResolvedType>>

struct TypedTrait:
    ast: Trait

enum ResolvedType:
    Unit
    Bool
    Int(IntSize)
    Float(FloatSize)
    String
    Char
    Array(ResolvedType, usize)
    Slice(ResolvedType)
    Tuple(Array<ResolvedType>)
    Option(ResolvedType)
    Result(ResolvedType, ResolvedType)
    Ref { mutable_: Bool, inner: ResolvedType }
    Ptr { mutable_: Bool, inner: ResolvedType }
    Function { params: Array<ResolvedType>, ret: ResolvedType, effects: crate::effects::EffectSet }
    Struct(String, Map<String, ResolvedType>)
    Enum(String, Array<(String, ResolvedType)>)
    Generic(String)
    Never
    Unknown

enum IntSize:
    I8
    I16
    I32
    I64
    I128
    Isize
    U8
    U16
    U32
    U64
    U128
    Usize

enum FloatSize:
    F32
    F64

struct TypeEnv:
    scopes: Array<Map<String, ResolvedType>>
    types: Map<String, ResolvedType>
    span_mapper: &crate::diagnostics::SpanMapper
    filename: &String

impl TypeEnv:
    fn new_(span_mapper: &crate::diagnostics::SpanMapper, filename: &String) -> Self_:
        let mut env = aggregate_init("Self_", scopes = [std__collections__HashMap__new_()], types = std__collections__HashMap__new_(), span_mapper = span_mapper, filename = filename)
        env.types.insert("Int".into(), ResolvedType__Int(IntSize__I64))
        env.types.insert("UInt".into(), ResolvedType__Int(IntSize__U64))
        env.types.insert("Float".into(), ResolvedType__Float(FloatSize__F64))
        env.types.insert("Bool".into(), ResolvedType__Bool)
        env.types.insert("Char".into(), ResolvedType__Char)
        env.types.insert("String".into(), ResolvedType__String)
        env.types.insert("Vec2".into(), ResolvedType__Tuple([ResolvedType__Float(FloatSize__F32), ResolvedType__Float(FloatSize__F32)]))
        env.types.insert("Vec3".into(), ResolvedType__Tuple([ResolvedType__Float(FloatSize__F32), ResolvedType__Float(FloatSize__F32), ResolvedType__Float(FloatSize__F32)]))
        env

    fn push_scope(_self: &mut Self_):
        _self.scopes.push(std__collections__HashMap__new_())

    fn pop_scope(_self: &mut Self_):
        _self.scopes.pop()

    fn define(_self: &mut Self_, name: String, ty: ResolvedType):
        match _self.scopes.last_mut():
            Some(scope) =>
                scope.insert(name, ty)
            _ =>
                none

    fn lookup(_self: &Self_, name: &String) -> Option<&ResolvedType>:
        for scope in _self.scopes.iter().rev():
            match scope.get(name):
                Some(ty) =>
                    return Some(ty)
                _ =>
                    none
        _self.types.get(name)

    fn type_error(_self: &Self_, message: impl Into<String>, span: crate::span::Span) -> crate::error::KainError:
        let loc = _self.span_mapper.span_to_location(span, _self.filename)
        let formatted_message = f"{loc.file}:{loc.line_}:{loc.col}: {message.into()}"
        crate__error__KainError__type_error(formatted_message, span)


fn check(program: &Program, span_mapper: &crate::diagnostics::SpanMapper, filename: &String) -> Result<TypedProgram, Error>:
    let mut env = TypeEnv__new_(span_mapper, filename)
    for item in &program.items:
        register_item_types(&mut env, item)?
    let mut typed_items = Vec__new_()
    for item in &program.items:
        check_item_into(&mut env, item, &mut typed_items)?
    Ok(aggregate_init("TypedProgram", items = typed_items))

fn register_item_types(env: &mut TypeEnv, item: &Item) -> Result<(), Error>:
    match item:
        Struct(s) =>
            let mut fields = std__collections__HashMap__new_()
            for f in &s.fields:
                fields.insert(f.name.clone(), resolve_type(&f.ty)?)
            env.types.insert(s.name.clone(), ResolvedType__Struct(s.name.clone(), fields))
        Enum(e) =>
            let variants: Array<(String, ResolvedType)> = e.variants.iter().map(none).collect()
            env.types.insert(e.name.clone(), ResolvedType__Enum(e.name.clone(), variants))
        Mod(module) =>
            match &module.inline_:
                Some(children) =>
                    for child in children:
                        register_item_types(env, child)?
                _ =>
                    none
        _ =>
            let __selfhost_empty = none
    Ok(none)

fn check_item_into(env: &mut TypeEnv, item: &Item, out_: &mut Array<TypedItem>) -> Result<(), Error>:
    match item:
        Trait(_) =>
            let __selfhost_empty = none
        Mod(module) =>
            match &module.inline_:
                Some(children) =>
                    for child in children:
                        check_item_into(env, child, out_)?
                _ =>
                    none
        _ =>
            out_.push(check_item(env, item)?)
    Ok(none)

fn check_item(env: &mut TypeEnv, item: &Item) -> Result<TypedItem, Error>:
    match item:
        Function(f) =>
            Ok(TypedItem__Function(check_function(env, f)?))
        Struct(s) =>
            Ok(TypedItem__Struct(check_struct(env, s)?))
        Enum(e) =>
            Ok(TypedItem__Enum(check_enum(env, e)?))
        Component(c) =>
            Ok(TypedItem__Component(check_component(env, c)?))
        Shader(s) =>
            Ok(TypedItem__Shader(check_shader(env, s)?))
        Actor(a) =>
            Ok(TypedItem__Actor(check_actor(env, a)?))
        Comptime(b) =>
            Ok(TypedItem__Comptime(aggregate_init("TypedComptime", ast = b.body.clone())))
        Const(c) =>
            Ok(TypedItem__Const(check_const(env, c)?))
        Macro(m) =>
            Ok(TypedItem__Macro(aggregate_init("TypedMacro", ast = m.clone())))
        Use(u) =>
            Ok(TypedItem__Use(aggregate_init("TypedUse", ast = u.clone())))
        Impl(i) =>
            Ok(TypedItem__Impl(aggregate_init("TypedImpl", ast = i.clone())))
        Test(t) =>
            Ok(TypedItem__Test(aggregate_init("TypedTest", ast = t.clone())))
        TypeAlias(ta) =>
            Ok(TypedItem__TypeAlias(aggregate_init("TypedTypeAlias", ast = ta.clone())))
        MaterialGraph(mg) =>
            Ok(TypedItem__MaterialGraph(mg.clone()))
        MaterialFunction(mf) =>
            Ok(TypedItem__MaterialFunction(mf.clone()))
        GraphEditor(ge) =>
            Ok(TypedItem__GraphEditor(ge.clone()))
        GraphRuntime(gr) =>
            Ok(TypedItem__GraphRuntime(gr.clone()))
        StateMachine(sm) =>
            Ok(TypedItem__StateMachine(sm.clone()))
        AsyncTask(at) =>
            Ok(TypedItem__AsyncTask(at.clone()))
        EditorModule(em) =>
            Ok(TypedItem__EditorModule(em.clone()))
        GameplayTags(gt) =>
            Ok(TypedItem__GameplayTags(gt.clone()))
        GameplayAbility(ga) =>
            Ok(TypedItem__GameplayAbility(ga.clone()))
        GameplayEffect(ge) =>
            Ok(TypedItem__GameplayEffect(ge.clone()))
        GameplayCue(gc) =>
            Ok(TypedItem__GameplayCue(gc.clone()))
        Trait(_) =>
            panic("Traits should be filtered before check_item")
        Mod(_) =>
            panic("Modules should be flattened before check_item")
        _ =>
            Err(env.type_error("Item type not yet supported in type checker", item_span(item)))

fn check_const(_env: &mut TypeEnv, c: &Const) -> Result<TypedConst, Error>:
    let ty = resolve_type(&c.ty)?
    Ok(aggregate_init("TypedConst", ast = c.clone(), ty = ty))

fn check_actor(env: &mut TypeEnv, a: &Actor) -> Result<TypedActor, Error>:
    let mut state_types = std__collections__HashMap__new_()
    for s in &a.state_:
        state_types.insert(s.name.clone(), resolve_type(&s.ty)?)
    for handler in &a.handlers:
        check_block_for_syntax_errors(env, &handler.body)?
    for method in &a.methods:
        check_block_for_syntax_errors(env, &method.body)?
    Ok(aggregate_init("TypedActor", ast = a.clone(), state_types = state_types))

fn check_function(env: &mut TypeEnv, f: &Function) -> Result<TypedFunction, Error>:
    env.push_scope()
    let mut param_types = Vec__new_()
    for p in &f.params:
        let ty = resolve_type(&p.ty)?
        env.define(p.name.clone(), ty.clone())
        param_types.push(ty)
    let ret = f.return_type.as_ref().map(none).transpose()?.unwrap_or(ResolvedType__Unit)
    let effects = crate__effects__EffectSet__from(f.effects.clone())
    check_block_for_syntax_errors(env, &f.body)?
    env.pop_scope()
    Ok(aggregate_init("TypedFunction", ast = f.clone(), resolved_type = aggregate_init("ResolvedType__Function", params = param_types, ret = Box__new_(ret), effects = effects.clone()), effects = effects))

fn check_struct(env: &mut TypeEnv, s: &Struct) -> Result<TypedStruct, Error>:
    let mut fields = std__collections__HashMap__new_()
    for f in &s.fields:
        fields.insert(f.name.clone(), resolve_type(&f.ty)?)
    for method in &s.methods:
        check_block_for_syntax_errors(env, &method.body)?
    Ok(aggregate_init("TypedStruct", ast = s.clone(), field_types = fields))

fn check_enum(_env: &mut TypeEnv, e: &Enum) -> Result<TypedEnum, Error>:
    let mut variant_payload_types: Map<String, Array<ResolvedType>> = std__collections__HashMap__new_()
    for v in &e.variants:
        let payload_types = match &v.fields:
            Unit =>
                Vec__new_()
            Tuple(items) =>
                items.iter().map(resolve_type).collect()?
            Struct(fields) =>
                fields.iter().map(none).collect()?
        variant_payload_types.insert(v.name.clone(), payload_types)
    Ok(aggregate_init("TypedEnum", ast = e.clone(), variant_payload_types = variant_payload_types))

fn check_component(_env: &mut TypeEnv, c: &Component) -> Result<TypedComponent, Error>:
    let mut props = std__collections__HashMap__new_()
    for p in &c.props:
        props.insert(p.name.clone(), resolve_type(&p.ty)?)
    Ok(aggregate_init("TypedComponent", ast = c.clone(), prop_types = props))

fn check_shader(_env: &mut TypeEnv, s: &Shader) -> Result<TypedShader, Error>:
    let inputs: Array<_> = s.inputs.iter().map(none).collect()?
    let output = resolve_type(&s.outputs)?
    Ok(aggregate_init("TypedShader", ast = s.clone(), input_types = inputs, output_type = output))

fn resolve_type(ty: &Type) -> Result<ResolvedType, Error>:
    match ty:
        _ =>
            match name.as_str():
                "Int" =>
                    Ok(ResolvedType__Int(IntSize__I64))
                "UInt" =>
                    Ok(ResolvedType__Int(IntSize__U64))
                "Float" =>
                    Ok(ResolvedType__Float(FloatSize__F64))
                "Bool" =>
                    Ok(ResolvedType__Bool)
                "Char" =>
                    Ok(ResolvedType__Char)
                "String" =>
                    Ok(ResolvedType__String)
                _ =>
                    if ((name.len() == 1) && name.chars().next().map(none).unwrap_or(false)):
                        Ok(ResolvedType__Generic(name.clone()))
                    elif (name.starts_with("_") && (name.len() > 1)):
                        Ok(ResolvedType__Generic(name.clone()))
                    else:
                        Ok(ResolvedType__Struct(name.clone(), std__collections__HashMap__new_()))
        Unit(_) =>
            Ok(ResolvedType__Unit)
        Never(_) =>
            Ok(ResolvedType__Never)
        Tuple(inner, _) =>
            Ok(ResolvedType__Tuple(inner.iter().map(resolve_type).collect()?))
        _ =>
            let resolved_params = params.iter().map(resolve_type).collect()?
            let resolved_ret = resolve_type(return_type)?
            Ok(aggregate_init("ResolvedType__Function", params = resolved_params, ret = Box__new_(resolved_ret), effects = crate__effects__EffectSet__from(effects.clone())))
        _ =>
            Ok(aggregate_init("ResolvedType__Ptr", mutable_ = (*mutable_), inner = Box__new_(resolve_type(inner)?)))
        _ =>
            Ok(ResolvedType__Unknown)

fn item_span(item: &Item) -> crate::span::Span:
    match item:
        Function(f) =>
            f.span
        Struct(s) =>
            s.span
        Enum(e) =>
            e.span
        Component(c) =>
            c.span
        Shader(s) =>
            s.span
        Actor(a) =>
            a.span
        Comptime(b) =>
            b.span
        Const(c) =>
            c.span
        Macro(m) =>
            m.span
        Use(u) =>
            u.span
        Mod(m) =>
            m.span
        Impl(i) =>
            i.span
        Test(t) =>
            t.span
        _ =>
            crate__span__Span__new_(0, 0)

impl From for crate::effects::EffectSet:
    fn from(v: Array<crate::effects::Effect>) -> Self_:
        let mut s = crate__effects__EffectSet__new_()
        for e in v:
            s.effects.insert(e)
        s


fn check_block_for_syntax_errors(env: &TypeEnv, block: &Block) -> Result<(), Error>:
    for stmt in &block.stmts:
        check_stmt_for_syntax_errors(env, stmt)?
    Ok(none)

fn check_stmt_for_syntax_errors(env: &TypeEnv, stmt: &Stmt) -> Result<(), Error>:
    match stmt:
        _ =>
            match value:
                Some(expr) =>
                    check_expr_for_syntax_errors(env, expr)?
                _ =>
                    none
        Expr(expr) =>
            check_expr_for_syntax_errors(env, expr)?
        Return(Some(expr), _) =>
            check_expr_for_syntax_errors(env, expr)?
        _ =>
            check_expr_for_syntax_errors(env, condition)?
            check_block_for_syntax_errors(env, body)?
        _ =>
            check_expr_for_syntax_errors(env, iter)?
            check_block_for_syntax_errors(env, body)?
        _ =>
            check_block_for_syntax_errors(env, body)?
        _ =>
            let __selfhost_empty = none
    Ok(none)

fn check_expr_for_syntax_errors(env: &TypeEnv, expr: &Expr) -> Result<(), Error>:
    match expr:
        _ =>
            match env.types.get(enum_name):
                Some(ty) =>
                    if (none):
                        return Err(env.type_error(f"Cannot use '::' on struct type '{enum_name}'. Use '.' for field access instead.\nExample: {enum_name.to_lowercase()}.{variant} (not {enum_name}::{variant})", (*span)))
                _ =>
                    none
        _ =>
            check_expr_for_syntax_errors(env, left)?
            check_expr_for_syntax_errors(env, right)?
        _ =>
            check_expr_for_syntax_errors(env, operand)?
        _ =>
            for arg in args:
                check_expr_for_syntax_errors(env, &arg.value)?
        _ =>
            check_expr_for_syntax_errors(env, receiver)?
            for arg in args:
                check_expr_for_syntax_errors(env, &arg.value)?
        _ =>
            check_expr_for_syntax_errors(env, object)?
        _ =>
            check_expr_for_syntax_errors(env, object)?
            check_expr_for_syntax_errors(env, index)?
        _ =>
            check_expr_for_syntax_errors(env, target)?
            check_expr_for_syntax_errors(env, value)?
        Array(exprs, _) =>
            for e in exprs:
                check_expr_for_syntax_errors(env, e)?
        Tuple(exprs, _) =>
            for e in exprs:
                check_expr_for_syntax_errors(env, e)?
        _ =>
            check_expr_for_syntax_errors(env, condition)?
            check_block_for_syntax_errors(env, then_branch)?
            match else_branch:
                Some(else_b) =>
                    match else_b.as_ref():
                        Else(block) =>
                            check_block_for_syntax_errors(env, block)?
                        ElseIf(cond, block, next_else) =>
                            check_expr_for_syntax_errors(env, cond)?
                            check_block_for_syntax_errors(env, block)?
                            match next_else:
                                Some(next) =>
                                    match next.as_ref():
                                        Else(b) =>
                                            check_block_for_syntax_errors(env, b)?
                                        ElseIf(c, b, _) =>
                                            check_expr_for_syntax_errors(env, c)?
                                            check_block_for_syntax_errors(env, b)?
                                _ =>
                                    none
                _ =>
                    none
        _ =>
            check_expr_for_syntax_errors(env, scrutinee)?
            for arm in arms:
                check_expr_for_syntax_errors(env, &arm.body)?
        Block(block, _) =>
            check_block_for_syntax_errors(env, block)?
        _ =>
            check_expr_for_syntax_errors(env, value)?
        _ =>
            match start:
                Some(s) =>
                    check_expr_for_syntax_errors(env, s)?
                _ =>
                    none
            match end:
                Some(e) =>
                    check_expr_for_syntax_errors(env, e)?
                _ =>
                    none
        _ =>
            for _item in fields:
                check_expr_for_syntax_errors(env, field_expr)?
        _ =>
            for _item in fields:
                check_expr_for_syntax_errors(env, field_expr)?
        _ =>
            check_expr_for_syntax_errors(env, body)?
        _ =>
            check_expr_for_syntax_errors(env, value)?
        _ =>
            check_expr_for_syntax_errors(env, value)?
        _ =>
            check_expr_for_syntax_errors(env, pointer)?
            check_expr_for_syntax_errors(env, offset)?
        _ =>
            check_expr_for_syntax_errors(env, pointer)?
        _ =>
            check_expr_for_syntax_errors(env, pointer)?
            check_expr_for_syntax_errors(env, value)?
        _ =>
            let __selfhost_empty = none
        _ =>
            check_expr_for_syntax_errors(env, size)?
        _ =>
            check_expr_for_syntax_errors(env, pointer)?
            check_expr_for_syntax_errors(env, size)?
        Deref(inner, _) =>
            check_expr_for_syntax_errors(env, inner)?
        Try(inner, _) =>
            check_expr_for_syntax_errors(env, inner)?
        Await(inner, _) =>
            check_expr_for_syntax_errors(env, inner)?
        _ =>
            for _item in init:
                check_expr_for_syntax_errors(env, init_expr)?
        _ =>
            check_expr_for_syntax_errors(env, target)?
            for _item in data:
                check_expr_for_syntax_errors(env, data_expr)?
        Comptime(inner, _) =>
            check_expr_for_syntax_errors(env, inner)?
        _ =>
            for arg in args:
                check_expr_for_syntax_errors(env, arg)?
        Return(Some(inner), _) =>
            check_expr_for_syntax_errors(env, inner)?
        Break(Some(inner), _) =>
            check_expr_for_syntax_errors(env, inner)?
        Paren(inner, _) =>
            check_expr_for_syntax_errors(env, inner)?
        _ =>
            let __selfhost_empty = none
    Ok(none)

enum UIBackendKind:
    Runtime
    ReactDom
    BrowserDom
    Slate

struct UIBackendProfile:
    kind: UIBackendKind
    event_prefix: &String
    supports_fragments: Bool
    supports_component_instances: Bool
    supports_keyed_children: Bool
    bool_attr_true_is_bare: Bool
    fragment_tag: &String

const UI_BACKEND_PROFILES: &[UIBackendProfile] = &[aggregate_init("UIBackendProfile", kind = UIBackendKind__Runtime, event_prefix = "on_", supports_fragments = true, supports_component_instances = true, supports_keyed_children = true, bool_attr_true_is_bare = true, fragment_tag = "Fragment"), aggregate_init("UIBackendProfile", kind = UIBackendKind__ReactDom, event_prefix = "on", supports_fragments = true, supports_component_instances = true, supports_keyed_children = true, bool_attr_true_is_bare = false, fragment_tag = "React.Fragment"), aggregate_init("UIBackendProfile", kind = UIBackendKind__BrowserDom, event_prefix = "on_", supports_fragments = true, supports_component_instances = false, supports_keyed_children = true, bool_attr_true_is_bare = true, fragment_tag = "DocumentFragment"), aggregate_init("UIBackendProfile", kind = UIBackendKind__Slate, event_prefix = "on_", supports_fragments = true, supports_component_instances = true, supports_keyed_children = false, bool_attr_true_is_bare = false, fragment_tag = "SFragment")]

fn ui_backend_profile(kind: UIBackendKind) -> &UIBackendProfile:
    UI_BACKEND_PROFILES.iter().find(none).unwrap_or(&UI_BACKEND_PROFILES[0])

enum UIAttr:
    Property { name: String, value: crate::runtime::Value }
    Bool { name: String, value: Bool }
    Event { name: String, event: UIEvent, handler: crate::runtime::Value }

enum UIEvent:
    Click
    Input
    Change
    Submit
    Focus
    Blur
    KeyDown
    KeyUp
    PointerDown
    PointerUp
    PointerMove
    Custom(String)

struct ComponentInstance:
    name: String
    props: Map<String, crate::runtime::Value>
    children: Array<VNode>
    state_: Map<String, crate::runtime::Value>

enum VNode:
    Element { tag: String, attrs: Array<UIAttr>, children: Array<VNode>, key: Option<String> }
    Text(String)
    Fragment(Array<VNode>)
    Component { instance: ComponentInstance, rendered: VNode }

impl Display for VNode:
    fn fmt(_self: &Self_, f: &mut std::fmt::Formatter) -> Result<(), Error>:
        __kain_write_fmt!(f, render_to_string(_self))


fn render_to_string(node: &VNode) -> String:
    match node:
        _ =>
            let attrs = attrs.iter().map(render_attr_to_string).filter(none).collect().join(" ")
            let attr_suffix = if attrs.is_empty():
                String__new_()
            else:
                f" {attrs}"
            if children.is_empty():
                f"<{tag}{attr_suffix}/>"
            else:
                let children = children.iter().map(render_to_string).collect().join("")
                f"<{tag}{attr_suffix}>{children}</{tag}>"
        Text(text) =>
            text.clone()
        Fragment(children) =>
            children.iter().map(render_to_string).collect().join("")
        _ =>
            render_to_string(rendered)

fn reconcile(current: Option<&VNode>, next: &VNode) -> VNode:
    match (current, next):
        (Some(_), _) =>
            if (old_tag == new_tag):
                aggregate_init("VNode__Element", tag = new_tag.clone(), attrs = attrs.clone(), children = children.clone(), key = key.clone())
            else:
                none
        (Some(Text(_)), Text(text)) =>
            VNode__Text(text.clone())
        (Some(Fragment(_)), Fragment(children)) =>
            VNode__Fragment(children.clone())
        (Some(_), _) =>
            if (old_instance.name == instance.name):
                aggregate_init("VNode__Component", instance = instance.clone(), rendered = Box__new_(reconcile(None, rendered)))
            else:
                none
        _ =>
            next.clone()

fn eval_jsx(env: &mut crate::runtime::Env, node: &crate::ast::JSXNode) -> Result<crate::runtime::Value, Error>:
    match node:
        _ =>
            let attrs = eval_attrs(env, attributes)?
            let children = eval_children(env, children)?
            let key = find_attr_key(&attrs, "key")
            Ok(crate__runtime__Value__JSX(aggregate_init("VNode__Element", tag = tag.clone(), attrs = attrs, children = children, key = key)))
        Text(s, _) =>
            Ok(crate__runtime__Value__String(s.clone()))
        Expression(expr) =>
            crate__runtime__eval_expr(env, expr)
        Fragment(children, _) =>
            Ok(crate__runtime__Value__JSX(VNode__Fragment(eval_children(env, children)?)))
        _ =>
            let cond = crate__runtime__eval_expr(env, condition)?
            if value_is_truthy(&cond):
                eval_jsx(env, then_branch)
            else:
                match else_branch:
                    Some(else_branch) =>
                        eval_jsx(env, else_branch)
                    _ =>
                        Ok(crate__runtime__Value__JSX(VNode__Fragment(Vec__new_())))
        _ =>
            let iter_value = crate__runtime__eval_expr(env, iter)?
            let items = match iter_value:
                Array(items) =>
                    items.read().unwrap().clone()
                Tuple(items) =>
                    items
                _ =>
                    Vec__new_()
            let mut children = Vec__new_()
            for item in items:
                env.push_scope()
                env.define(binding.clone(), item)
                let rendered = eval_jsx(env, body)?
                env.pop_scope()
                flatten_value_into_children(rendered, &mut children)
            Ok(crate__runtime__Value__JSX(VNode__Fragment(children)))
        _ =>
            let attrs = eval_attrs(env, props)?
            let rendered_children = eval_children(env, children)?
            let props = attrs_to_props_map(&attrs)
            let instance = aggregate_init("ComponentInstance", name = name.clone(), props = props, children = rendered_children.clone(), state_ = std__collections__HashMap__new_())
            Ok(crate__runtime__Value__JSX(aggregate_init("VNode__Component", instance = instance, rendered = Box__new_(VNode__Fragment(rendered_children)))))

fn eval_attrs(env: &mut crate::runtime::Env, attributes: &[crate::ast::JSXAttribute]) -> Result<Array<UIAttr>, Error>:
    let mut attrs = Vec__new_()
    for attr in attributes:
        let lowered = match &attr.value:
            String(s) =>
                aggregate_init("UIAttr__Property", name = attr.name.clone(), value = crate__runtime__Value__String(s.clone()))
            Bool(b) =>
                aggregate_init("UIAttr__Bool", name = attr.name.clone(), value = (*b))
            Expr(expr) =>
                let value = crate__runtime__eval_expr(env, expr)?
                match parse_event_name(&attr.name):
                    Some(event) =>
                        aggregate_init("UIAttr__Event", name = attr.name.clone(), event = event, handler = value)
                    _ =>
                        aggregate_init("UIAttr__Property", name = attr.name.clone(), value = value)
        attrs.push(lowered)
    Ok(attrs)

fn eval_children(env: &mut crate::runtime::Env, children: &[crate::ast::JSXNode]) -> Result<Array<VNode>, Error>:
    let mut out_ = Vec__new_()
    for child in children:
        let rendered = eval_jsx(env, child)?
        flatten_value_into_children(rendered, &mut out_)
    Ok(out_)

fn flatten_value_into_children(value: crate::runtime::Value, out_: &mut Array<VNode>):
    match value:
        JSX(node) =>
            out_.push(node)
        String(s) =>
            out_.push(VNode__Text(s))
        Int(n) =>
            out_.push(VNode__Text(n.to_string()))
        Float(n) =>
            out_.push(VNode__Text(n.to_string()))
        Bool(b) =>
            out_.push(VNode__Text(b.to_string()))
        Array(items) =>
            for item in items.read().unwrap().iter().cloned():
                flatten_value_into_children(item, out_)
        Tuple(items) =>
            for item in items:
                flatten_value_into_children(item, out_)
        _ =>
            let __selfhost_empty = none

fn attrs_to_props_map(attrs: &[UIAttr]) -> Map<String, crate::runtime::Value>:
    let mut props = std__collections__HashMap__new_()
    for attr in attrs:
        match attr:
            _ =>
                props.insert(name.clone(), value.clone())
            _ =>
                props.insert(name.clone(), crate__runtime__Value__Bool((*value)))
            _ =>
                props.insert(name.clone(), handler.clone())
    props

fn render_attr_to_string(attr: &UIAttr) -> String:
    match attr:
        _ =>
            f"{name}=\"{value}\""
        _ =>
            if (*value):
                name.clone()
            else:
                String__new_()
        _ =>
            f"{name}=\"[event:{event_name(event)}]\""

fn parse_event_name(name: &String) -> Option<UIEvent>:
    let normalized = name.strip_prefix("on_").or_else(none).unwrap_or(name).to_ascii_lowercase()
    Some(none)

fn event_name(event: &UIEvent) -> &String:
    match event:
        Click =>
            "click"
        Input =>
            "input"
        Change =>
            "change"
        Submit =>
            "submit"
        Focus =>
            "focus"
        Blur =>
            "blur"
        KeyDown =>
            "keydown"
        KeyUp =>
            "keyup"
        PointerDown =>
            "pointerdown"
        PointerUp =>
            "pointerup"
        PointerMove =>
            "pointermove"
        Custom(name) =>
            name.as_str()

fn value_is_truthy(value: &crate::runtime::Value) -> Bool:
    match value:
        Unit =>
            false
        Bool(v) =>
            (*v)
        Int(v) =>
            ((*v) != 0)
        Float(v) =>
            ((*v) != 0)
        String(v) =>
            (!v.is_empty())
        Array(items) =>
            (!items.read().unwrap().is_empty())
        Tuple(items) =>
            (!items.is_empty())
        JSX(_) =>
            true
        _ =>
            true

fn find_attr_key(attrs: &[UIAttr], name: &String) -> Option<String>:
    for attr in attrs:
        match attr:
            _ =>
                if (attr_name == name):
                    return Some(value_to_key_string(value))
                else:
                    none
            _ =>
                if (attr_name == name):
                    return Some(value.to_string())
                else:
                    none
            _ =>
                let __selfhost_empty = none
    None

fn value_to_key_string(value: &crate::runtime::Value) -> String:
    match value:
        String(v) =>
            v.clone()
        Int(v) =>
            v.to_string()
        Float(v) =>
            v.to_string()
        Bool(v) =>
            v.to_string()
        _ =>
            value

mod tests:
    fn test_render_to_string_element_with_attrs():
        let node = aggregate_init("VNode__Element", tag = "div".to_string(), attrs = [aggregate_init("UIAttr__Property", name = "class".to_string(), value = crate__runtime__Value__String("panel".to_string())), aggregate_init("UIAttr__Bool", name = "hidden".to_string(), value = true)], children = [VNode__Text("Hello".to_string())], key = Some("root".to_string()))
        if (render_to_string(&node) != "<div class=\"panel\" hidden>Hello</div>"):
            panic("assert_eq! failed")

    fn test_eval_jsx_if_uses_then_branch_when_true():
        let mut env = crate__runtime__Env__new_()
        let node = aggregate_init("crate__ast__JSXNode__If", condition = Box__new_(crate__ast__Expr__Bool(true, crate__span__Span__default_())), then_branch = Box__new_(crate__ast__JSXNode__Text("yes".to_string(), crate__span__Span__default_())), else_branch = Some(Box__new_(crate__ast__JSXNode__Text("no".to_string(), crate__span__Span__default_()))), span = crate__span__Span__default_())
        let rendered = eval_jsx(&mut env, &node).unwrap()
        match rendered:
            String(text) =>
                if (text != "yes"):
                    panic("assert_eq! failed")
            other =>
                panic(f"expected string branch, got {other}")

    fn test_eval_jsx_for_expands_array_children():
        let mut env = crate__runtime__Env__new_()
        env.define("items".to_string(), crate__runtime__Value__Array(std__sync__Arc__new_(std__sync__RwLock__new_([crate__runtime__Value__String("A".to_string()), crate__runtime__Value__String("B".to_string())]))))
        let node = aggregate_init("crate__ast__JSXNode__For", binding = "item".to_string(), iter = Box__new_(crate__ast__Expr__Ident("items".to_string(), crate__span__Span__default_())), body = Box__new_(aggregate_init("crate__ast__JSXNode__Element", tag = "span".to_string(), attributes = Vec__new_(), children = [crate__ast__JSXNode__Expression(Box__new_(crate__ast__Expr__Ident("item".to_string(), crate__span__Span__default_())))], span = crate__span__Span__default_())), span = crate__span__Span__default_())
        let rendered = eval_jsx(&mut env, &node).unwrap()
        match rendered:
            JSX(Fragment(children)) =>
                if (children.len() != 2):
                    panic("assert_eq! failed")
                if (render_to_string(&children[0]) != "<span>A</span>"):
                    panic("assert_eq! failed")
                if (render_to_string(&children[1]) != "<span>B</span>"):
                    panic("assert_eq! failed")
            other =>
                panic(f"expected fragment result, got {other}")

    fn test_eval_jsx_component_call_creates_instance():
        let mut env = crate__runtime__Env__new_()
        let node = aggregate_init("crate__ast__JSXNode__ComponentCall", name = "Panel".to_string(), props = [aggregate_init("crate__ast__JSXAttribute", name = "title".to_string(), value = crate__ast__JSXAttrValue__String("Inspector".to_string()), span = crate__span__Span__default_())], children = [crate__ast__JSXNode__Text("Body".to_string(), crate__span__Span__default_())], span = crate__span__Span__default_())
        let rendered = eval_jsx(&mut env, &node).unwrap()
        match rendered:
            JSX(_) =>
                if (instance.name != "Panel"):
                    panic("assert_eq! failed")
                if (instance.props.get("title").map(ToString__to_string) != Some("Inspector".to_string())):
                    panic("assert_eq! failed")
                if (render_to_string(&rendered) != "Body"):
                    panic("assert_eq! failed")
            other =>
                panic(f"expected component result, got {other}")

    fn test_ui_backend_profiles_are_data_driven():
        let react = ui_backend_profile(UIBackendKind__ReactDom)
        let slate = ui_backend_profile(UIBackendKind__Slate)
        if (react.event_prefix != "on"):
            panic("assert_eq! failed")
        if (!react.supports_keyed_children):
            panic("assert! failed")
        if (slate.fragment_tag != "SFragment"):
            panic("assert_eq! failed")
        if (!(!slate.supports_keyed_children)):
            panic("assert! failed")


