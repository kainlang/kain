    fn parse_actor(_self: &mut Self_) -> Result<Item, Error>:
        _self.parse_actor_with_attrs([])

    fn parse_actor_with_attrs(_self: &mut Self_, attributes: Array<Attribute>) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Actor)?
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut state_ = Vec__new_()
        let mut handlers = Vec__new_()
        let mut methods = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let method_attributes = _self.parse_attributes()?
            if _self.check(crate__lexer__TokenKind__State):
                _self.advance()
                let name = _self.parse_ident()?
                _self.expect(crate__lexer__TokenKind__Colon)?
                let ty = _self.parse_type()?
                _self.expect(crate__lexer__TokenKind__Eq)?
                let initial = _self.parse_expr()?
                state_.push(aggregate_init("StateDecl", name = name, ty = ty, initial = initial, weak_ = false, attributes = method_attributes, span = _self.current_span()))
            elif _self.check(crate__lexer__TokenKind__Var):
                _self.advance()
                let name = _self.parse_ident()?
                _self.expect(crate__lexer__TokenKind__Colon)?
                let ty = _self.parse_type()?
                _self.expect(crate__lexer__TokenKind__Eq)?
                let initial = _self.parse_expr()?
                state_.push(aggregate_init("StateDecl", name = name, ty = ty, initial = initial, weak_ = false, attributes = method_attributes, span = _self.current_span()))
            elif _self.check(crate__lexer__TokenKind__Fn):
                match (_self.parse_function_with_attrs(Visibility__Public, method_attributes)?):
                    Function(func) =>
                        methods.push(func)
                    _ =>
                        none
            else:
                match _self.peek_kind():
                    Ident(s) =>
                        if (s == "weak"):
                            _self.advance()
                            _self.expect(crate__lexer__TokenKind__State)?
                            let name = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            let ty = _self.parse_type()?
                            _self.expect(crate__lexer__TokenKind__Eq)?
                            let initial = _self.parse_expr()?
                            state_.push(aggregate_init("StateDecl", name = name, ty = ty, initial = initial, weak_ = true, attributes = method_attributes, span = _self.current_span()))
                        elif (s == "on"):
                            _self.advance()
                            let message_type = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__LParen)?
                            let params = _self.parse_params()?
                            _self.expect(crate__lexer__TokenKind__RParen)?
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            let body = _self.parse_block()?
                            handlers.push(aggregate_init("MessageHandler", message_type = message_type, params = params, body = body, span = _self.current_span()))
                        else:
                            return Err(_self.parser_error(f"Unexpected identifier '{s}' in actor. Valid keywords: 'state', 'var', 'fn', or 'on' for message handlers", _self.current_span()))
                    _ =>
                        return Err(_self.parser_error(f"Expected 'state', 'var', 'fn', or 'on' in actor definition, found {_self.token_to_user_string(&_self.peek_kind())}", _self.current_span()))
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        let span = start.merge(_self.current_span())
        Ok(Item__Actor(aggregate_init("Actor", name = name, state_ = state_, handlers = handlers, methods = methods, attributes = attributes, span = span)))

    fn parse_const(_self: &mut Self_, vis: Visibility) -> Result<Item, Error>:
