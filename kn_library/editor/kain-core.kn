        Ok(Item__GameplayTags(aggregate_init("GameplayTagsNamespace", name = name, children = children, span = start.merge(_self.current_span()))))

    fn parse_tag_hierarchy(_self: &mut Self_, parent_path: &String) -> Result<Array<GameplayTagNode>, Error>:
        let mut nodes = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let start = _self.current_span()
            let tag_name = _self.parse_tag_name()?
            let full_path = if parent_path.is_empty():
                tag_name.clone()
            else:
                f"{parent_path}.{tag_name}"
            let comment = None
            let children = if _self.check(crate__lexer__TokenKind__Colon):
                _self.advance()
                _self.skip_newlines()
                if _self.check(crate__lexer__TokenKind__Indent):
                    _self.advance()
                    let child_nodes = _self.parse_tag_hierarchy(&full_path)?
                    if _self.check(crate__lexer__TokenKind__Dedent):
                        _self.advance()
                    child_nodes
                else:
                    Vec__new_()
            else:
                Vec__new_()
            nodes.push(aggregate_init("GameplayTagNode", name = tag_name, full_path = full_path, comment = comment, children = children, span = start.merge(_self.current_span())))
            _self.skip_newlines()
        Ok(nodes)

    fn parse_tag_name(_self: &mut Self_) -> Result<String, Error>:
        let span = _self.current_span()
        match _self.peek_kind():
            Ident(s) =>
                _self.advance()
                Ok(s)
            Pure_ =>
                _self.advance()
                Ok("Pure".to_string())
            Io =>
                _self.advance()
                Ok("IO".to_string())
            Async_ =>
                _self.advance()
                Ok("Async".to_string())
            AsyncKw =>
                _self.advance()
                Ok("async".to_string())
            Reactive_ =>
                _self.advance()
                Ok("Reactive".to_string())
            Unsafe_ =>
                _self.advance()
                Ok("Unsafe".to_string())
            Gpu =>
                _self.advance()
                Ok("GPU".to_string())
            True =>
                _self.advance()
                Ok("true".to_string())
            False =>
                _self.advance()
                Ok("false".to_string())
            None =>
                _self.advance()
                Ok("none".to_string())
            k =>
                Err(_self.parser_error(f"Expected gameplay tag name, got {crate__error__token_kind_to_user_string(&k)}", span))

    fn parse_gameplay_ability(_self: &mut Self_, attributes: Array<Attribute>) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Struct)?
