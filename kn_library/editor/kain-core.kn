fn collect_referenced_type_names(item: &Item) -> Set<String>:
    let mut names = std__collections__HashSet__new_()
    collect_type_names_from_item(item, &mut names)
    names

fn collect_type_names_from_item(item: &Item, out_: &mut Set<String>):
    match item:
        Function(f) =>
            for p in &f.params:
                collect_type_names_from_type(&p.ty, out_)
                match &p.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                    _ =>
                        none
            match &f.return_type:
                Some(ret) =>
                    collect_type_names_from_type(ret, out_)
                _ =>
                    none
            collect_type_names_from_block(&f.body, out_)
            for attr in &f.attributes:
                for arg in &attr.args:
                    collect_type_names_from_expr(arg, out_)
        Struct(s) =>
            for f in &s.fields:
                collect_type_names_from_type(&f.ty, out_)
                match &f.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                    _ =>
                        none
            for method in &s.methods:
                collect_type_names_from_item(&Item__Function(method.clone()), out_)
        Enum(e) =>
            for v in &e.variants:
                match &v.fields:
                    Unit =>
                        let __selfhost_empty = none
                    Tuple(types) =>
                        for ty in types:
                            collect_type_names_from_type(ty, out_)
                    Struct(fields) =>
                        for f in fields:
                            collect_type_names_from_type(&f.ty, out_)
        Actor(a) =>
            for s in &a.state_:
                collect_type_names_from_type(&s.ty, out_)
                collect_type_names_from_expr(&s.initial, out_)
            for handler in &a.handlers:
                out_.insert(handler.message_type.clone())
                for p in &handler.params:
                    collect_type_names_from_type(&p.ty, out_)
                collect_type_names_from_block(&handler.body, out_)
            for method in &a.methods:
                collect_type_names_from_item(&Item__Function(method.clone()), out_)
        Component(c) =>
            for p in &c.props:
                collect_type_names_from_type(&p.ty, out_)
            for s in &c.state_:
                collect_type_names_from_type(&s.ty, out_)
                collect_type_names_from_expr(&s.initial, out_)
            for method in &c.methods:
                collect_type_names_from_item(&Item__Function(method.clone()), out_)
            collect_type_names_from_jsx(&c.body, out_)
        Shader(s) =>
            for p in &s.inputs:
                collect_type_names_from_type(&p.ty, out_)
            collect_type_names_from_type(&s.outputs, out_)
            for u in &s.uniforms:
                collect_type_names_from_type(&u.ty, out_)
            collect_type_names_from_block(&s.body, out_)
        TypeAlias(ta) =>
            collect_type_names_from_type(&ta.target, out_)
        Const(c) =>
            collect_type_names_from_type(&c.ty, out_)
            collect_type_names_from_expr(&c.value, out_)
        Trait(t) =>
            for method in &t.methods:
                for p in &method.params:
                    collect_type_names_from_type(&p.ty, out_)
                match &method.return_type:
                    Some(ret) =>
                        collect_type_names_from_type(ret, out_)
                    _ =>
                        none
                match &method.default_impl:
                    Some(body) =>
                        collect_type_names_from_block(body, out_)
                    _ =>
                        none
        Impl(i) =>
            match &i.trait_name:
                Some(trait_name) =>
                    out_.insert(trait_name.clone())
                _ =>
                    none
            collect_type_names_from_type(&i.target_type, out_)
            for method in &i.methods:
                collect_type_names_from_item(&Item__Function(method.clone()), out_)
        Comptime(b) =>
            collect_type_names_from_block(&b.body, out_)
        Macro(m) =>
            match &m.body:
                Block(block) =>
                    collect_type_names_from_block(block, out_)
                Tokens(_) =>
                    let __selfhost_empty = none
        Test(t) =>
            collect_type_names_from_block(&t.body, out_)
        MaterialGraph(mg) =>
            for input in &mg.inputs:
                collect_type_names_from_type(&input.ty, out_)
                match &input.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                    _ =>
                        none
            for stmt in &mg.body:
                match stmt:
                    _ =>
                        collect_type_names_from_expr(value, out_)
            for output in &mg.outputs:
                collect_type_names_from_expr(&output.value, out_)
        MaterialFunction(mf) =>
            for input in &mf.inputs:
                collect_type_names_from_type(&input.ty, out_)
                match &input.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                    _ =>
                        none
            for stmt in &mf.body:
                match stmt:
                    _ =>
                        collect_type_names_from_expr(value, out_)
            collect_type_names_from_expr(&mf.output, out_)
        GraphEditor(ge) =>
            for nt in &ge.node_types:
                for pin in &nt.inputs:
                    collect_type_names_from_type(&pin.ty, out_)
                    match &pin.default_:
                        Some(default_) =>
                            collect_type_names_from_expr(default_, out_)
                        _ =>
                            none
                for pin in &nt.outputs:
                    collect_type_names_from_type(&pin.ty, out_)
                    match &pin.default_:
                        Some(default_) =>
                            collect_type_names_from_expr(default_, out_)
                        _ =>
                            none
                for prop in &nt.properties:
                    collect_type_names_from_type(&prop.ty, out_)
                    match &prop.default_:
                        Some(default_) =>
                            collect_type_names_from_expr(default_, out_)
                        _ =>
                            none
            match &ge.schema:
                Some(schema) =>
                    for rule in &schema.rules:
                        collect_type_names_from_expr(&rule.condition, out_)
                _ =>
                    none
        GraphRuntime(gr) =>
            match &gr.graph_data:
                Some(gd) =>
                    for f in &gd.properties:
                        collect_type_names_from_type(&f.ty, out_)
                    for method in &gd.methods:
                        collect_type_names_from_item(&Item__Function(method.clone()), out_)
                _ =>
                    none
            for nd in &gr.node_types:
                match &nd.base_class:
                    Some(base) =>
                        out_.insert(base.clone())
                    _ =>
                        none
                for pin in &nd.input_pins:
                    collect_type_names_from_type(&pin.ty, out_)
                for pin in &nd.output_pins:
                    collect_type_names_from_type(&pin.ty, out_)
                for f in &nd.properties:
                    collect_type_names_from_type(&f.ty, out_)
                for method in &nd.methods:
                    collect_type_names_from_item(&Item__Function(method.clone()), out_)
                match &nd.execute_logic:
                    Some(logic) =>
                        collect_type_names_from_block(logic, out_)
                    _ =>
                        none
            match &gr.instance:
                Some(inst) =>
                    for f in &inst.state_:
                        collect_type_names_from_type(&f.ty, out_)
                    for method in &inst.methods:
                        collect_type_names_from_item(&Item__Function(method.clone()), out_)
                    for delegate in &inst.delegates:
                        for p in &delegate.params:
                            collect_type_names_from_type(&p.ty, out_)
                _ =>
                    none
            match &gr.pin_config:
                Some(pc) =>
                    for f in &pc.properties:
                        collect_type_names_from_type(&f.ty, out_)
                    for method in &pc.methods:
                        collect_type_names_from_item(&Item__Function(method.clone()), out_)
                _ =>
                    none
        StateMachine(sm) =>
            for state_ in &sm.states:
                for f in &state_.properties:
                    collect_type_names_from_type(&f.ty, out_)
                for transition in &state_.transitions:
                    match &transition.condition:
                        Some(cond) =>
                            collect_type_names_from_block(cond, out_)
                        _ =>
                            none
                match &state_.on_enter:
                    Some(on_enter) =>
                        collect_type_names_from_block(on_enter, out_)
                    _ =>
                        none
                match &state_.on_exit:
                    Some(on_exit) =>
                        collect_type_names_from_block(on_exit, out_)
                    _ =>
                        none
        AsyncTask(at) =>
            for f in &at.input_fields:
                collect_type_names_from_type(&f.ty, out_)
            for f in &at.output_fields:
                collect_type_names_from_type(&f.ty, out_)
            match &at.do_work:
                Some(do_work) =>
                    collect_type_names_from_block(do_work, out_)
                _ =>
                    none
            match &at.callback:
                Some(callback) =>
                    for p in &callback.params:
                        collect_type_names_from_type(&p.ty, out_)
                    collect_type_names_from_block(&callback.body, out_)
                _ =>
                    none
        EditorModule(em) =>
            for entry in &em.menu_entries:
                collect_type_names_from_item(&Item__Function(entry.method.clone()), out_)
            for btn in &em.toolbar_buttons:
                collect_type_names_from_item(&Item__Function(btn.method.clone()), out_)
        GameplayTags(_) =>
            let __selfhost_empty = none
        GameplayAbility(ability) =>
            for method in &ability.methods:
                collect_type_names_from_item(&Item__Function(method.clone()), out_)
        GameplayEffect(_) =>
            let __selfhost_empty = none
        GameplayCue(cue) =>
            for field in &cue.state_fields:
                collect_type_names_from_type(&field.ty, out_)
            match &cue.on_execute:
                Some(on_execute) =>
                    collect_type_names_from_item(&Item__Function(on_execute.clone()), out_)
                _ =>
                    none
            match &cue.on_add:
                Some(on_add) =>
                    collect_type_names_from_item(&Item__Function(on_add.clone()), out_)
                _ =>
                    none
            match &cue.on_remove:
                Some(on_remove) =>
                    collect_type_names_from_item(&Item__Function(on_remove.clone()), out_)
                _ =>
                    none
            match &cue.while_active:
                Some(while_active) =>
                    collect_type_names_from_item(&Item__Function(while_active.clone()), out_)
                _ =>
                    none
        AbilityTask(task) =>
            for field in &task.state_fields:
                collect_type_names_from_type(&field.ty, out_)
            match &task.activate_method:
                Some(activate) =>
                    collect_type_names_from_item(&Item__Function(activate.clone()), out_)
                _ =>
                    none
            match &task.on_destroy_method:
                Some(on_destroy) =>
                    collect_type_names_from_item(&Item__Function(on_destroy.clone()), out_)
                _ =>
                    none
            for method in &task.custom_methods:
                collect_type_names_from_item(&Item__Function(method.clone()), out_)
        TargetActor(target) =>
            match &target.filter:
                Some(filter) =>
                    match &filter.custom_filter_method:
                        Some(custom_filter) =>
                            collect_type_names_from_item(&Item__Function(custom_filter.clone()), out_)
                        _ =>
                            none
                _ =>
                    none
            for method in &target.custom_methods:
                collect_type_names_from_item(&Item__Function(method.clone()), out_)
        Use(_) =>
            let __selfhost_empty = none

fn collect_type_names_from_type(ty: &Type, out_: &mut Set<String>):
    match ty:
        _ =>
            out_.insert(name.clone())
            for g in generics:
                collect_type_names_from_type(g, out_)
        Tuple(types, _) =>
            for t in types:
                collect_type_names_from_type(t, out_)
        Array(inner, _, _) =>
            collect_type_names_from_type(inner, out_)
        Slice(inner, _) =>
            collect_type_names_from_type(inner, out_)
        _ =>
            collect_type_names_from_type(inner, out_)
        _ =>
            collect_type_names_from_type(inner, out_)
        _ =>
            for p in params:
                collect_type_names_from_type(p, out_)
            collect_type_names_from_type(return_type, out_)
        Option(inner, _) =>
            collect_type_names_from_type(inner, out_)
        Result(ok, err, _) =>
            collect_type_names_from_type(ok, out_)
            collect_type_names_from_type(err, out_)
        _ =>
            out_.insert(trait_name.clone())
            for g in generics:
                collect_type_names_from_type(g, out_)
        Infer(_) =>
            let __selfhost_empty = none

fn collect_type_names_from_expr(expr: &Expr, out_: &mut Set<String>):
    match expr:
        _ =>
            collect_type_names_from_expr(value, out_)
            collect_type_names_from_type(target, out_)
        _ =>
            out_.insert(name.clone())
            for _item in fields:
                collect_type_names_from_expr(field_expr, out_)
        _ =>
            collect_type_names_from_type(ty, out_)
            for _item in fields:
                collect_type_names_from_expr(field_expr, out_)
        _ =>
            out_.insert(enum_name.clone())
            match fields:
                Unit =>
                    let __selfhost_empty = none
                Tuple(exprs) =>
                    for e in exprs:
                        collect_type_names_from_expr(e, out_)
                Struct(field_pairs) =>
                    for _item in field_pairs:
                        collect_type_names_from_expr(e, out_)
        _ =>
            out_.insert(actor_.clone())
            for _item in init:
                collect_type_names_from_expr(init_expr, out_)
        _ =>
            collect_type_names_from_expr(callee, out_)
            for arg in args:
                collect_type_names_from_expr(&arg.value, out_)
        _ =>
            collect_type_names_from_expr(receiver, out_)
            for arg in args:
                collect_type_names_from_expr(&arg.value, out_)
        _ =>
            collect_type_names_from_expr(object, out_)
        _ =>
            collect_type_names_from_expr(object, out_)
            collect_type_names_from_expr(index, out_)
        _ =>
            collect_type_names_from_expr(left, out_)
            collect_type_names_from_expr(right, out_)
        _ =>
            collect_type_names_from_expr(operand, out_)
        _ =>
            collect_type_names_from_expr(target, out_)
            collect_type_names_from_expr(value, out_)
        _ =>
            collect_type_names_from_expr(condition, out_)
            collect_type_names_from_block(then_branch, out_)
            match else_branch:
                Some(else_b) =>
                    collect_type_names_from_else_branch(else_b, out_)
                _ =>
                    none
        _ =>
            collect_type_names_from_expr(scrutinee, out_)
            for arm in arms:
                collect_type_names_from_pattern(&arm.pattern, out_)
                match &arm.guard:
                    Some(guard) =>
                        collect_type_names_from_expr(guard, out_)
                    _ =>
                        none
                collect_type_names_from_expr(&arm.body, out_)
        _ =>
            for p in params:
                collect_type_names_from_type(&p.ty, out_)
            match return_type:
                Some(ret) =>
                    collect_type_names_from_type(ret, out_)
                _ =>
                    none
            collect_type_names_from_expr(body, out_)
        Array(exprs, _) =>
            for e in exprs:
                collect_type_names_from_expr(e, out_)
        _ =>
            for arg in args:
                collect_type_names_from_expr(arg, out_)
        _ =>
            collect_type_names_from_expr(target, out_)
            for _item in data:
                collect_type_names_from_expr(data_expr, out_)
        Block(block, _) =>
            collect_type_names_from_block(block, out_)
        _ =>
            match start:
                Some(s) =>
                    collect_type_names_from_expr(s, out_)
                _ =>
                    none
            match end:
                Some(e) =>
                    collect_type_names_from_expr(e, out_)
                _ =>
                    none
        _ =>
            collect_type_names_from_expr(value, out_)
        _ =>
            collect_type_names_from_expr(value, out_)
            match pointee_ty:
                Some(ty) =>
                    collect_type_names_from_type(ty, out_)
                _ =>
                    none
        Deref(inner, _) =>
            collect_type_names_from_expr(inner, out_)
        _ =>
            collect_type_names_from_expr(pointer, out_)
            collect_type_names_from_expr(offset, out_)
            match element_ty:
                Some(ty) =>
                    collect_type_names_from_type(ty, out_)
                _ =>
                    none
        _ =>
            collect_type_names_from_expr(pointer, out_)
            match load_ty:
                Some(ty) =>
                    collect_type_names_from_type(ty, out_)
                _ =>
                    none
        _ =>
            collect_type_names_from_expr(pointer, out_)
            collect_type_names_from_expr(value, out_)
            match store_ty:
                Some(ty) =>
                    collect_type_names_from_type(ty, out_)
                _ =>
                    none
        _ =>
            collect_type_names_from_type(target, out_)
        _ =>
            collect_type_names_from_type(target, out_)
        _ =>
            collect_type_names_from_type(ty, out_)
        _ =>
            collect_type_names_from_expr(size, out_)
            match ty:
                Some(ty) =>
                    collect_type_names_from_type(ty, out_)
                _ =>
                    none
        _ =>
            collect_type_names_from_expr(pointer, out_)
            collect_type_names_from_expr(size, out_)
            match ty:
                Some(ty) =>
                    collect_type_names_from_type(ty, out_)
                _ =>
                    none
        Return(Some(inner), _) =>
            collect_type_names_from_expr(inner, out_)
        JSX(node, _) =>
            collect_type_names_from_jsx(node, out_)
        Int(_, _) =>
            let __selfhost_empty = none

fn collect_type_names_from_block(block: &Block, out_: &mut Set<String>):
    for stmt in &block.stmts:
        collect_type_names_from_stmt(stmt, out_)

fn collect_type_names_from_stmt(stmt: &Stmt, out_: &mut Set<String>):
    match stmt:
        _ =>
            match ty:
                Some(ty) =>
                    collect_type_names_from_type(ty, out_)
                _ =>
                    none
            match value:
                Some(val) =>
                    collect_type_names_from_expr(val, out_)
                _ =>
                    none
            collect_type_names_from_pattern(pattern, out_)
        Expr(expr) =>
            collect_type_names_from_expr(expr, out_)
        Return(Some(expr), _) =>
            collect_type_names_from_expr(expr, out_)
        _ =>
            collect_type_names_from_pattern(binding, out_)
            collect_type_names_from_expr(iter, out_)
            collect_type_names_from_block(body, out_)
        _ =>
            collect_type_names_from_expr(condition, out_)
            collect_type_names_from_block(body, out_)
        _ =>
            collect_type_names_from_block(body, out_)
        Item(item) =>
            collect_type_names_from_item(item, out_)
        Return(None, _) =>
            let __selfhost_empty = none

fn collect_type_names_from_else_branch(branch: &ElseBranch, out_: &mut Set<String>):
    match branch:
        Else(block) =>
            collect_type_names_from_block(block, out_)
        ElseIf(cond, block, next) =>
            collect_type_names_from_expr(cond, out_)
            collect_type_names_from_block(block, out_)
            match next:
                Some(next_else) =>
                    collect_type_names_from_else_branch(next_else, out_)
                _ =>
                    none

fn collect_type_names_from_pattern(pattern: &Pattern, out_: &mut Set<String>):
    match pattern:
        _ =>
            match enum_name:
                Some(name) =>
                    out_.insert(name.clone())
                _ =>
                    none
            match fields:
                Unit =>
                    let __selfhost_empty = none
                Tuple(patterns) =>
                    for p in patterns:
                        collect_type_names_from_pattern(p, out_)
                Struct(field_pairs) =>
                    for _item in field_pairs:
                        collect_type_names_from_pattern(p, out_)
        _ =>
            out_.insert(name.clone())
            for _item in fields:
                collect_type_names_from_pattern(p, out_)
        Tuple(patterns, _) =>
            for p in patterns:
                collect_type_names_from_pattern(p, out_)
        Or(patterns, _) =>
            for p in patterns:
                collect_type_names_from_pattern(p, out_)
        _ =>
            for p in patterns:
                collect_type_names_from_pattern(p, out_)
        _ =>
            match start:
                Some(s) =>
                    collect_type_names_from_expr(s, out_)
                _ =>
                    none
            match end:
                Some(e) =>
                    collect_type_names_from_expr(e, out_)
                _ =>
                    none
        Literal(expr) =>
            collect_type_names_from_expr(expr, out_)
        Wildcard(_) =>
            let __selfhost_empty = none

fn collect_type_names_from_jsx(node: &JSXNode, out_: &mut Set<String>):
    match node:
        _ =>
            for attr in attributes:
                match &attr.value:
                    Expr(e) =>
                        collect_type_names_from_expr(e, out_)
                    _ =>
                        let __selfhost_empty = none
            for child in children:
                collect_type_names_from_jsx(child, out_)
        _ =>
            out_.insert(name.clone())
            for prop in props:
                match &prop.value:
                    Expr(e) =>
                        collect_type_names_from_expr(e, out_)
                    _ =>
                        let __selfhost_empty = none
            for child in children:
                collect_type_names_from_jsx(child, out_)
        Expression(expr) =>
            collect_type_names_from_expr(expr, out_)
        _ =>
            collect_type_names_from_expr(iter, out_)
            collect_type_names_from_jsx(body, out_)
        _ =>
            collect_type_names_from_expr(condition, out_)
            collect_type_names_from_jsx(then_branch, out_)
            match else_branch:
                Some(else_b) =>
                    collect_type_names_from_jsx(else_b, out_)
                _ =>
                    none
        Fragment(children, _) =>
            for child in children:
                collect_type_names_from_jsx(child, out_)
        Text(_, _) =>
            let __selfhost_empty = none

