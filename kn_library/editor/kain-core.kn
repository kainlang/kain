        let mut label = None
        let mut icon = None
        let mut tooltip = None
        for arg in &menu_attr.args:
            match arg:
                Tuple(parts, _) =>
                    if (parts.len() == 2):
                        match (&parts[0], &parts[1]):
                            (Ident(param_name, _), String(value, _)) =>
                                match param_name.as_str():
                                    "path" =>
                                        path = Some(value.clone())
                                    "label" =>
                                        label = Some(value.clone())
                                    "icon" =>
                                        icon = Some(value.clone())
                                    "tooltip" =>
                                        tooltip = Some(value.clone())
                                    _ =>
                                        let __selfhost_empty = none
                            _ =>
                                none
                _ =>
                    none
        let path = path.ok_or_else(none)?
        let label = label.ok_or_else(none)?
        match (_self.parse_function_with_attrs(Visibility__Public, [])?):
            Function(method) =>
                Ok(aggregate_init("MenuEntryDef", path = path, label = label, method = method, icon = icon, tooltip = tooltip, attributes = attributes, span = start.merge(_self.current_span())))
            _ =>
                Err(_self.parser_error("Expected function after @menu_entry", _self.current_span()))

