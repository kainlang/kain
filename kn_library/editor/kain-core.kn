                _self.advance()
            _ =>
                return Err(_self.parser_error(f"Expected 'material' keyword after @material_graph attribute, found {_self.token_to_user_string(&_self.peek_kind())}", _self.current_span()))
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut inputs = Vec__new_()
        let mut body = Vec__new_()
        let mut outputs = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            match _self.peek_kind():
                Ident(s) =>
                    match s.as_str():
                        "input" =>
                            _self.advance()
                            let input_name = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            let ty = _self.parse_type()?
                            let default_ = if _self.check(crate__lexer__TokenKind__Eq):
                                _self.advance()
                                Some(_self.parse_expr()?)
                            else:
                                None
                            inputs.push(aggregate_init("MaterialInput", name = input_name, ty = ty, default_ = default_, span = _self.current_span()))
                        "output" =>
                            _self.advance()
                            let output_name = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__Eq)?
                            let value = _self.parse_expr()?
                            outputs.push(aggregate_init("MaterialOutput", name = output_name, value = value, span = _self.current_span()))
                        _ =>
                            return Err(_self.parser_error(f"Unexpected identifier '{s}' in material graph body. Valid keywords: 'input' (for parameters), 'let' (for intermediate values), or 'output' (for material properties like base_color, roughness)", _self.current_span()))
                _ =>
                    if _self.check(crate__lexer__TokenKind__Let):
                        _self.advance()
                        let var_name = _self.parse_ident()?
                        _self.expect(crate__lexer__TokenKind__Eq)?
                        let value = _self.parse_expr()?
                        body.push(aggregate_init("MaterialStatement__Let", name = var_name, value = value, span = _self.current_span()))
                    else:
