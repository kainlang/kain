enum Type:
    Named { name: String, generics: Array<Type>, span: crate::span::Span }
    Tuple(Array<Type>, crate::span::Span)
    Array(Type, usize, crate::span::Span)
    Slice(Type, crate::span::Span)
    Ref { mutable_: Bool, inner: Type, lifetime: Option<String>, span: crate::span::Span }
    Ptr { mutable_: Bool, inner: Type, provenance: PointerProvenance, span: crate::span::Span }
    Function { params: Array<Type>, return_type: Type, effects: Array<crate::effects::Effect>, span: crate::span::Span }
    Option(Type, crate::span::Span)
    Result(Type, Type, crate::span::Span)
    Infer(crate::span::Span)
    Never(crate::span::Span)
    Unit(crate::span::Span)
    Impl { trait_name: String, generics: Array<Type>, span: crate::span::Span }

impl Type:
    fn span(_self: &Self_) -> crate::span::Span:
        match _self:
            _ =>
                (*span)

    fn contains_raw_ptr(_self: &Self_) -> Bool:
        match _self:
            _ =>
                true
            _ =>
                generics.iter().any(Self___contains_raw_ptr)
            Tuple(types, _) =>
                types.iter().any(Self___contains_raw_ptr)
            Array(inner, _, _) =>
                inner.contains_raw_ptr()
            _ =>
                (params.iter().any(Self___contains_raw_ptr) || return_type.contains_raw_ptr())
            Result(ok, err, _) =>
                (ok.contains_raw_ptr() || err.contains_raw_ptr())
            _ =>
                generics.iter().any(Self___contains_raw_ptr)
            Infer(_) =>
                false


