    fn parse_graph_editor(_self: &mut Self_, attributes: Array<Attribute>) -> Result<Item, Error>:
        let start = _self.current_span()
        match _self.peek_kind():
            Ident(s) =>
                if (s != "graph"):
                    return Err(_self.parser_error(f"Expected 'graph' keyword after @graph_editor attribute, found identifier '{s}'. Usage: @graph_editor\ngraph MyGraph:", _self.current_span()))
                _self.advance()
            _ =>
                return Err(_self.parser_error(f"Expected 'graph' keyword after @graph_editor attribute, found {_self.token_to_user_string(&_self.peek_kind())}", _self.current_span()))
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut node_types = Vec__new_()
        let mut schema = None
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let node_attrs = _self.parse_attributes()?
            if node_attrs.iter().any(none):
                node_types.push(_self.parse_node_type(node_attrs)?)
            elif node_attrs.iter().any(none):
