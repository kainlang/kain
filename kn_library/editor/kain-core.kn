struct Block:
    stmts: Array<Stmt>
    span: crate::span::Span

enum Stmt:
    Let { pattern: Pattern, ty: Option<Type>, value: Option<Expr>, span: crate::span::Span }
    Expr(Expr)
    Return(Option<Expr>, crate::span::Span)
    Break(Option<Expr>, crate::span::Span)
    Continue(crate::span::Span)
    For { binding: Pattern, iter: Expr, body: Block, span: crate::span::Span }
    While { condition: Expr, body: Block, span: crate::span::Span }
    Loop { body: Block, span: crate::span::Span }
    Item(Item)

enum Expr:
    Int(i64, crate::span::Span)
    Float(f64, crate::span::Span)
    String(String, crate::span::Span)
    FString(Array<Expr>, crate::span::Span)
    Bool(Bool, crate::span::Span)
    None(crate::span::Span)
    Ident(String, crate::span::Span)
    MacroCall { name: String, args: Array<Expr>, span: crate::span::Span }
    Binary { left: Expr, op: BinaryOp, right: Expr, span: crate::span::Span }
    Unary { op: UnaryOp, operand: Expr, span: crate::span::Span }
    Call { callee: Expr, args: Array<CallArg>, span: crate::span::Span }
    MethodCall { receiver: Expr, method: String, args: Array<CallArg>, span: crate::span::Span }
    Field { object: Expr, field: String, span: crate::span::Span }
    Index { object: Expr, index: Expr, span: crate::span::Span }
    Assign { target: Expr, value: Expr, span: crate::span::Span }
    Struct { name: String, fields: Array<(String, Expr)>, span: crate::span::Span }
    AggregateInit { ty: Type, fields: Array<(String, Expr)>, zero_fill_rest: Bool, span: crate::span::Span }
    EnumVariant { enum_name: String, variant: String, fields: EnumVariantFields, span: crate::span::Span }
    Array(Array<Expr>, crate::span::Span)
    Tuple(Array<Expr>, crate::span::Span)
    Range { start: Option<Expr>, end: Option<Expr>, inclusive: Bool, span: crate::span::Span }
    If { condition: Expr, then_branch: Block, else_branch: Option<ElseBranch>, span: crate::span::Span }
    Match { scrutinee: Expr, arms: Array<MatchArm>, span: crate::span::Span }
    Lambda { params: Array<Param>, return_type: Option<Type>, body: Expr, span: crate::span::Span }
    Ref { mutable_: Bool, value: Expr, span: crate::span::Span }
    AddrOf { value: Expr, pointee_ty: Option<Type>, span: crate::span::Span }
    Deref(Expr, crate::span::Span)
    PtrOffset { pointer: Expr, offset: Expr, element_ty: Option<Type>, span: crate::span::Span }
    MemLoad { pointer: Expr, load_ty: Option<Type>, span: crate::span::Span }
    MemStore { pointer: Expr, value: Expr, store_ty: Option<Type>, span: crate::span::Span }
    SizeOfType { target: Type, span: crate::span::Span }
    AlignOfType { target: Type, span: crate::span::Span }
    Alloca { ty: Type, span: crate::span::Span }
    Uninit { ty: Type, span: crate::span::Span }
    Alloc { size: Expr, ty: Option<Type>, zeroed: Bool, span: crate::span::Span }
    Realloc { pointer: Expr, size: Expr, ty: Option<Type>, zeroed_new: Bool, span: crate::span::Span }
    Cast { value: Expr, target: Type, span: crate::span::Span }
    Try(Expr, crate::span::Span)
    Await(Expr, crate::span::Span)
    Spawn { actor_: String, init: Array<(String, Expr)>, span: crate::span::Span }
    SendMsg { target: Expr, message: String, data: Array<(String, Expr)>, span: crate::span::Span }
    Comptime(Expr, crate::span::Span)
    Block(Block, crate::span::Span)
    JSX(JSXNode, crate::span::Span)
    Paren(Expr, crate::span::Span)
    Return(Option<Expr>, crate::span::Span)
    Break(Option<Expr>, crate::span::Span)
    Continue(crate::span::Span)

impl Expr:
    fn span(_self: &Self_) -> crate::span::Span:
        match _self:
            Int(_, s) =>
                (*s)


