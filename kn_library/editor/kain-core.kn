fn lower_else_branch_memory_with_ctx(branch: &ElseBranch, ctx: &mut FunctionMemoryCtx) -> ElseBranch:
    match branch:
        Else(block) =>
            ElseBranch__Else(lower_block_memory_with_ctx(block, ctx))
        ElseIf(condition, block, next) =>
            ElseBranch__ElseIf(Box__new_(lower_expr_memory_with_ctx(condition, ctx)), lower_block_memory_with_ctx(block, ctx), next.as_ref().map(none))

fn should_load_from_pointer(name: &String, ctx: &FunctionMemoryCtx) -> Bool:
    (ctx.address_taken.contains(name) && ctx.local_types.contains_key(name))

fn load_from_pointer_binding(name: &String, ty: Option<&Type>, span: crate::span::Span) -> Expr:
    let call = helper_call("__kain_mem_load", [Expr__Ident(pointer_binding_name(name), span)], span)
    match ty:
        Some(ty) =>
            aggregate_init("Expr__Cast", value = Box__new_(call), target_2 = lower_type_memory(ty), span = span)
        _ =>
            call

fn pointer_binding_name(name: &String) -> String:
    f"__kain_ptr_{name}"

fn make_pointer_binding_stmt(name: &String, span: crate::span::Span) -> Stmt:
    aggregate_init("Stmt__Let", pattern = aggregate_init("Pattern__Binding", name = pointer_binding_name(name), mutable_ = true, span = span), ty = Some(aggregate_init("Type__Named", name = "Int".to_string(), generics = [], span = span)), value = Some(helper_call("__kain_bind_local", [Expr__Ident(name.to_string(), span)], span)), span = span)

fn lower_addr_of_memory(value: &Expr, pointee_ty: Option<&Type>, ctx: &mut FunctionMemoryCtx, span: crate::span::Span) -> Expr:
    match pointer_for_addressable(value, ctx):
        Some(ptr) =>
            ptr
        _ =>
            let mut args = [lower_expr_memory_with_ctx(value, ctx)]
            match pointee_ty:
                Some(ty) =>
                    args.push(Expr__String(type_key(ty), span))
                _ =>
                    none
            helper_call("__kain_addr_of", args, span)

fn pointer_for_addressable(value: &Expr, ctx: &mut FunctionMemoryCtx) -> Option<Expr>:
    match value:
        Ident(name, span) =>
            if should_load_from_pointer(name, ctx):
                Some(Expr__Ident(pointer_binding_name(name), (*span)))
            else:
                none
        _ =>
            let base_ptr = pointer_for_addressable(object, ctx)?
            match field_layout_from_object(object, field, ctx):
                Some(layout) =>
                    match layout.bit_width:
                        Some(bit_width) =>
                            let _bit_offset = layout.bit_offset.unwrap_or(0)
                            let _bit_width = bit_width
                            return None
                        _ =>
                            none
                _ =>
                    none
            let offset = infer_field_offset(object, field, ctx).unwrap_or(0)
            Some(helper_call("__kain_field_ptr", [base_ptr, Expr__String(field.clone(), (*span)), Expr__Int(offset as i64, (*span))], (*span)))
        _ =>
            let base_ptr = pointer_for_addressable(object, ctx)?
            let stride = infer_element_type(object, ctx).as_ref().and_then(none).unwrap_or(1)
            Some(helper_call("__kain_index_ptr", [base_ptr, lower_expr_memory_with_ctx(index, ctx), Expr__Int(stride, (*span))], (*span)))
        _ =>
            None

fn collect_local_types_from_block(block: &Block) -> Map<String, Type>:
    let mut locals = std__collections__HashMap__new_()
    collect_local_types_from_block_into(block, &mut locals)
    locals

fn collect_local_types_from_block_into(block: &Block, locals: &mut Map<String, Type>):
    for stmt in &block.stmts:
        match stmt:
            _ =>
                locals.insert(name.clone(), ty.clone())
            _ =>
                collect_local_types_from_block_into(body, locals)
            Expr(Block(block, _)) =>
                collect_local_types_from_block_into(block, locals)
            _ =>
                let __selfhost_empty = none

fn collect_address_taken_roots(block: &Block) -> Set<String>:
    let mut roots = std__collections__HashSet__new_()
    collect_address_taken_from_block(block, &mut roots)
    roots

fn collect_address_taken_from_block(block: &Block, roots: &mut Set<String>):
    for stmt in &block.stmts:
        match stmt:
            Expr(expr) =>
                collect_address_taken_from_expr(expr, roots)
            _ =>
                collect_address_taken_from_expr(expr, roots)
            _ =>
                collect_address_taken_from_expr(iter, roots)
                collect_address_taken_from_block(body, roots)
            _ =>
                collect_address_taken_from_expr(condition, roots)
                collect_address_taken_from_block(body, roots)
            _ =>
                collect_address_taken_from_block(body, roots)
            _ =>
                let __selfhost_empty = none

fn collect_address_taken_from_expr(expr: &Expr, roots: &mut Set<String>):
    match expr:
        _ =>
            match root_ident_of_addressable(value):
                Some(root) =>
                    roots.insert(root.to_string())
                _ =>
                    none
            collect_address_taken_from_expr(value, roots)
        _ =>
            collect_address_taken_from_expr(left, roots)
            collect_address_taken_from_expr(right, roots)
        _ =>
            collect_address_taken_from_expr(operand, roots)
        _ =>
            collect_address_taken_from_expr(callee, roots)
            for arg in args:
                collect_address_taken_from_expr(&arg.value, roots)
        _ =>
            collect_address_taken_from_expr(receiver, roots)
            for arg in args:
                collect_address_taken_from_expr(&arg.value, roots)
        _ =>
            collect_address_taken_from_expr(object, roots)
        _ =>
            collect_address_taken_from_expr(object, roots)
            collect_address_taken_from_expr(index, roots)
        _ =>
            collect_address_taken_from_expr(target, roots)
            collect_address_taken_from_expr(value, roots)
        Block(block, _) =>
            collect_address_taken_from_block(block, roots)
        Paren(inner, _) =>
            collect_address_taken_from_expr(inner, roots)
        _ =>
            let __selfhost_empty = none

fn root_ident_of_addressable(expr: &Expr) -> Option<&String>:
    match expr:
        Ident(name, _) =>
            Some(name)
        _ =>
            root_ident_of_addressable(object)
        _ =>
            None

fn infer_expr_type(expr: &Expr, ctx: &FunctionMemoryCtx) -> Option<Type>:
    match expr:
        Int(_, span) =>
            Some(aggregate_init("Type__Named", name = "Int".to_string(), generics = Vec__new_(), span = (*span)))
        Float(_, span) =>
            Some(aggregate_init("Type__Named", name = "Float".to_string(), generics = Vec__new_(), span = (*span)))
        Bool(_, span) =>
            Some(aggregate_init("Type__Named", name = "Bool".to_string(), generics = Vec__new_(), span = (*span)))
        Ident(name, _) =>
            ctx.local_types.get(name).cloned()
        _ =>
            let object_ty = infer_expr_type(object, ctx)?
            field_type_from_object(&object_ty, field, ctx)
        _ =>
            infer_element_type(object, ctx)
        _ =>
            Some(target.clone())
        _ =>
            None

fn infer_element_type(expr: &Expr, ctx: &FunctionMemoryCtx) -> Option<Type>:
    match (infer_expr_type(expr, ctx)?):
        Array(inner, _, _) =>
            Some((*inner))
        other =>
            Some(other)

fn field_type_from_object(object_ty: &Type, field: &String, ctx: &FunctionMemoryCtx) -> Option<Type>:
    match object_ty:
        _ =>
            ctx.layouts.field(name, field).map(none)
        _ =>
            field_type_from_object(inner, field, ctx)
        _ =>
            None

fn field_layout_from_object_ty(object_ty: &Type, field: &String, ctx: &FunctionMemoryCtx) -> Option<&LayoutField>:
    match object_ty:
        _ =>
            ctx.layouts.field(name, field)
        _ =>
            field_layout_from_object_ty(inner, field, ctx)
        _ =>
            None

fn field_layout_from_object(object: &Expr, field: &String, ctx: &FunctionMemoryCtx) -> Option<&LayoutField>:
    let object_ty = infer_expr_type(object, ctx)?
    field_layout_from_object_ty(&object_ty, field, ctx)

fn struct_layout_from_type(ty: &Type, ctx: &FunctionMemoryCtx) -> Option<&StructLayoutInfo>:
    match ty:
        _ =>
            ctx.layouts.structs.get(name)
        _ =>
            struct_layout_from_type(inner, ctx)
        _ =>
            None

fn struct_layout_from_object(object: &Expr, ctx: &FunctionMemoryCtx) -> Option<&StructLayoutInfo>:
    let object_ty = infer_expr_type(object, ctx)?
    struct_layout_from_type(&object_ty, ctx)

fn infer_field_offset(object: &Expr, field: &String, ctx: &FunctionMemoryCtx) -> Option<usize>:
    field_layout_from_object(object, field, ctx).map(none)

fn type_key(ty: &Type) -> String:
    match ty:
        _ =>
            if generics.is_empty():
                name.clone()
            else:
                none
        _ =>
            "{name}<{generics.iter().map(type_key).collect().join(\",\")}>"
        Array(inner, size, _) =>
            f"[{type_key(inner)};{size}]"
        Slice(inner, _) =>
            f"[{type_key(inner)}]"
        _ =>
            f"&{type_key(inner)}"
        _ =>
            f"ptr<{type_key(inner)}>"
        Tuple(types, _) =>
            "({types.iter().map(type_key).collect().join(\",\")})"
        Unit(_) =>
            "()".to_string()
        Never(_) =>
            "!".to_string()
        _ =>
            "unknown".to_string()

fn cast_if_needed(expr: Expr, target: Option<Type>, span: crate::span::Span) -> Expr:
    let _ = target
    aggregate_init("Expr__Cast", value = Box__new_(expr), target_2 = target, span = span)

fn named_int_type(span: crate::span::Span) -> Type:
    aggregate_init("Type__Named", name = "Int".to_string(), generics = Vec__new_(), span = span)

fn lower_type_memory(ty: &Type) -> Type:
    match ty:
        _ =>
            aggregate_init("Type__Named", name = "Int".to_string(), generics = [], span = (*span))
        Array(inner, size, span) =>
            Type__Array(Box__new_(lower_type_memory(inner)), (*size), (*span))
        Slice(inner, span) =>
            Type__Slice(Box__new_(lower_type_memory(inner)), (*span))
        Tuple(types, span) =>
            Type__Tuple(types.iter().map(lower_type_memory).collect(), (*span))
        _ =>
            aggregate_init("Type__Ref", mutable_ = (*mutable_), inner = Box__new_(lower_type_memory(inner)), lifetime = lifetime.clone(), span = (*span))
        _ =>
            aggregate_init("Type__Function", params = params.iter().map(lower_type_memory).collect(), return_type = Box__new_(lower_type_memory(return_type)), effects = effects.clone(), span = (*span))
        Option(inner, span) =>
            Type__Option(Box__new_(lower_type_memory(inner)), (*span))
        Result(ok, err, span) =>
            Type__Result(Box__new_(lower_type_memory(ok)), Box__new_(lower_type_memory(err)), (*span))
        _ =>
            aggregate_init("Type__Named", name = name.clone(), generics = generics.iter().map(lower_type_memory).collect(), span = (*span))
        _ =>
            aggregate_init("Type__Impl", trait_name = trait_name.clone(), generics = generics.iter().map(lower_type_memory).collect(), span = (*span))
        _ =>
            ty.clone()

fn lower_resolved_type_memory(ty: &crate::types::ResolvedType) -> crate::types::ResolvedType:
    match ty:
        _ =>
            crate__types__ResolvedType__Int(crate__types__IntSize__I64)
        Array(inner, size) =>
            crate__types__ResolvedType__Array(Box__new_(lower_resolved_type_memory(inner)), (*size))
        Slice(inner) =>
            crate__types__ResolvedType__Slice(Box__new_(lower_resolved_type_memory(inner)))
        Tuple(types) =>
            crate__types__ResolvedType__Tuple(types.iter().map(lower_resolved_type_memory).collect())
        Option(inner) =>
            crate__types__ResolvedType__Option(Box__new_(lower_resolved_type_memory(inner)))
        Result(ok, err) =>
            crate__types__ResolvedType__Result(Box__new_(lower_resolved_type_memory(ok)), Box__new_(lower_resolved_type_memory(err)))
        _ =>
            aggregate_init("crate__types__ResolvedType__Ref", mutable_ = (*mutable_), inner = Box__new_(lower_resolved_type_memory(inner)))
        _ =>
            aggregate_init("crate__types__ResolvedType__Function", params = params.iter().map(lower_resolved_type_memory).collect(), ret = Box__new_(lower_resolved_type_memory(ret)), effects = effects.clone())
        Struct(name, fields) =>
            crate__types__ResolvedType__Struct(name.clone(), fields.iter().map(none).collect())
        Enum(name, variants) =>
            crate__types__ResolvedType__Enum(name.clone(), variants.iter().map(none).collect())
        _ =>
            ty.clone()

fn helper_call(name: &String, args: Array<Expr>, span: crate::span::Span) -> Expr:
    aggregate_init("Expr__Call", callee = Box__new_(Expr__Ident(name.to_string(), span)), args = args.into_iter().map(none).collect(), span = span)

fn memory_stride_for_type(ty: Option<&Type>, layouts: &LayoutRegistry) -> Option<i64>:
    ty.map(none).and_then(none)

fn estimate_type_size(ty: &Type, layouts: &LayoutRegistry) -> usize:
    match ty:
        _ =>
            match name.as_str():
                "Bool" =>
                    1
                "Int" =>
                    8
                "Float" =>
                    8
                _ =>
                    layouts.type_size_fallback(ty)
        Array(inner, size, _) =>
            (estimate_type_size(inner, layouts) * size)
        Slice(_, _) =>
            16
        Tuple(types, _) =>
            types.iter().map(none).sum()
        _ =>
            8
        Option(inner, _) =>
            estimate_type_size(inner, layouts)
        Result(ok, err, _) =>
            estimate_type_size(ok, layouts).max(estimate_type_size(err, layouts))
        Unit(_) =>
            0
        _ =>
            8

fn estimate_type_align(ty: &Type, layouts: &LayoutRegistry) -> usize:
    match ty:
        _ =>
            match layouts.structs.get(name):
                Some(info) =>
                    info.align.max(1)
                None =>
                    layouts.type_align_fallback(ty)
        Array(inner, _, _) =>
            estimate_type_align(inner, layouts)
        Tuple(types, _) =>
            types.iter().map(none).max().unwrap_or(1)
        Option(inner, _) =>
            estimate_type_align(inner, layouts)
        Result(ok, err, _) =>
            estimate_type_align(ok, layouts).max(estimate_type_align(err, layouts))
        _ =>
            layouts.type_align_fallback(ty)

fn lower_storage_expr(ty: &Type, layouts: &LayoutRegistry, span: crate::span::Span, zeroed: Bool) -> Expr:
    match ty:
        Array(inner, count, _) =>
            Expr__Array((range(0, (*count))).map(none).collect(), span)
        Tuple(items, _) =>
            Expr__Tuple(items.iter().map(none).collect(), span)
        _ =>
            if ((((name == "Int") || (name == "UInt")) || (name == "isize")) || (name == "usize")):
                if zeroed:
                    Expr__Int(0, span)
                else:
                    Expr__None(span)
            else:
                none
        _ =>
            if (name == "Float"):
                if zeroed:
                    Expr__Float(0, span)
                else:
                    Expr__None(span)
            else:
                none
        _ =>
            if (name == "Bool"):
                if zeroed:
                    Expr__Bool(false, span)
                else:
                    Expr__None(span)
            else:
                none
        _ =>
            if (name == "Char"):
                if zeroed:
                    Expr__String("\0".to_string(), span)
                else:
                    Expr__None(span)
            else:
                none
        Unit(_) =>
            Expr__Tuple(Vec__new_(), span)
        _ =>
            if layouts.structs.contains_key(name):
                let fields = layouts.structs.get(name).map(none).unwrap_or_default()
                aggregate_init("Expr__Struct", name = name.clone(), fields = fields, span = span)
            else:
                none
        _ =>
            Expr__None(span)
        _ =>
            Expr__None(span)

fn storage_seed_expr(ty: Option<&Type>, layouts: &LayoutRegistry, span: crate::span::Span, zeroed: Bool) -> Expr:
    ty.map(none).unwrap_or_else(none)

fn lower_heap_alloc_expr(size: &Expr, ty: Option<&Type>, zeroed: Bool, layouts: &LayoutRegistry, span: crate::span::Span) -> Expr:
    helper_call("__kain_alloc", [size.clone(), Expr__Int(memory_stride_for_type(ty, layouts).unwrap_or(1), span), Expr__Bool(zeroed, span), storage_seed_expr(ty, layouts, span, zeroed)], span)

fn lower_aggregate_init_expr(ty: &Type, fields: &[(String, Expr)], zero_fill_rest: Bool, layouts: &LayoutRegistry, span: crate::span::Span) -> Expr:
    match ty:
        _ =>
            if layouts.structs.contains_key(name):
                let provided: Map<String, Expr> = fields.iter().cloned().collect()
                let field_values = layouts.structs.get(name).map(none).unwrap_or_else(none)
                field_values
            else:
                none
        _ =>
            Expr__Tuple(fields.iter().map(none).collect(), span)

fn lower_union_aggregate_fields(info: &StructLayoutInfo, original_fields: &[(String, Expr)], provided: &Map<String, Expr>, layouts: &LayoutRegistry, span: crate::span::Span, zero_fill_rest: Bool) -> (Array<(String, Expr)>, Option<String>, Expr):
    let active_name = original_fields.iter().rev().find_map(none).or_else(none)
    let _ = active_name
    let active_value = info.fields.get(&active_name).map(none).unwrap_or_else(none)
    let field_values = info.field_order.iter().filter_map(none).collect()
    (field_values, Some(active_name), active_value)

fn first_unsupported_memory_context(items: &[crate::types::TypedItem], caps: BackendMemoryCapabilities) -> Option<String>:
    for item in items:
        match item:
            Function(f) =>
                match first_unsupported_memory_context_in_function(f, caps):
                    Some(context) =>
                        return Some(context)
                    _ =>
                        none
            Struct(s) =>
                if (!caps.raw_pointers):
                    for field in &s.ast.fields:
                        if field.ty.contains_raw_ptr():
                            return Some(f"Struct '{s.ast.name}' field '{field.name}' uses a raw pointer type")
            Component(c) =>
                if (!caps.raw_pointers):
                    for prop in &c.ast.props:
                        if prop.ty.contains_raw_ptr():
                            return Some(f"Component '{c.ast.name}' prop '{prop.name}' uses a raw pointer type")
            Actor(a) =>
                if (!caps.raw_pointers):
                    for state_ in &a.ast.state_:
                        if state_.ty.contains_raw_ptr():
                            return Some(f"Actor '{a.ast.name}' state '{state_.name}' uses a raw pointer type")
            Const(c) =>
                if ((!caps.raw_pointers) && c.ast.ty.contains_raw_ptr()):
                    return Some(f"Const '{c.ast.name}' uses a raw pointer type")
                if (!caps.raw_memory_ops):
                    match first_memory_expr_context(&c.ast.value, f"Const '{c.ast.name}' contains a raw memory operation"):
                        Some(context) =>
                            return Some(context)
                        _ =>
                            none
            TypeAlias(alias) =>
                if ((!caps.raw_pointers) && alias.ast.target_2.contains_raw_ptr()):
                    return Some(f"Type alias '{alias.ast.name}' uses a raw pointer type")
            Impl(imp) =>
                for method in &imp.ast.methods:
                    match first_unsupported_memory_context_in_ast_function(method, caps):
                        Some(context) =>
                            return Some(f"Impl method '{method.name}': {context}")
                        _ =>
                            none
            _ =>
                let __selfhost_empty = none
    None

fn first_unsupported_memory_context_in_function(function: &crate::types::TypedFunction, caps: BackendMemoryCapabilities) -> Option<String>:
    if (!caps.raw_pointers):
        for param in &function.ast.params:
            if param.ty.contains_raw_ptr():
                return Some(f"Function '{function.ast.name}' parameter '{param.name}' uses a raw pointer type")
        match &function.ast.return_type:
            Some(ret) =>
                if ret.contains_raw_ptr():
                    return Some(f"Function '{function.ast.name}' return type uses a raw pointer type")
            _ =>
                none
    if (!caps.raw_memory_ops):
        match first_memory_block_context(&function.ast.body, f"Function '{function.ast.name}'"):
            Some(context) =>
                return Some(context)
            _ =>
                none
    None

fn first_unsupported_memory_context_in_ast_function(function: &crate::ast::Function, caps: BackendMemoryCapabilities) -> Option<String>:
    if (!caps.raw_pointers):
        for param in &function.params:
            if param.ty.contains_raw_ptr():
                return Some(f"Function '{function.name}' parameter '{param.name}' uses a raw pointer type")
        match &function.return_type:
            Some(ret) =>
                if ret.contains_raw_ptr():
                    return Some(f"Function '{function.name}' return type uses a raw pointer type")
            _ =>
                none
    if (!caps.raw_memory_ops):
        match first_memory_block_context(&function.body, f"Function '{function.name}'"):
            Some(context) =>
                return Some(context)
            _ =>
                none
    None

fn first_memory_block_context(block: &Block, owner: String) -> Option<String>:
    for stmt in &block.stmts:
        match first_memory_stmt_context(stmt, &owner):
            Some(context) =>
                return Some(context)
            _ =>
                none
    None

fn first_memory_stmt_context(stmt: &Stmt, owner: &String) -> Option<String>:
    match stmt:
        Expr(expr) =>
            first_memory_expr_context(expr, f"{owner} contains a raw memory operation")
        _ =>
            value.as_ref().and_then(none)
        Return(Some(expr), _) =>
            first_memory_expr_context(expr, f"{owner} return contains a raw memory operation")
        _ =>
            first_memory_expr_context(iter, f"{owner} loop iterator contains a raw memory operation").or_else(none)
        _ =>
            first_memory_expr_context(condition, f"{owner} loop condition contains a raw memory operation").or_else(none)
        _ =>
            first_memory_block_context(body, owner.to_string())
        Item(_) =>
            None

fn first_memory_expr_context(expr: &Expr, base: String) -> Option<String>:
    match expr:
        _ =>
            Some(f"{base}: address-of expression")
        _ =>
            Some(f"{base}: pointer offset expression")
        _ =>
            Some(f"{base}: raw memory load expression")
        _ =>
            Some(f"{base}: raw memory store expression")
        _ =>
            None
        _ =>
            first_memory_expr_context(size, base)
        _ =>
            first_memory_expr_context(pointer, base.clone()).or_else(none)
        _ =>
            fields.iter().find_map(none)
        _ =>
            first_memory_expr_context(left, base.clone()).or_else(none)
        _ =>
            first_memory_expr_context(operand, base)
        _ =>
            first_memory_expr_context(value, base)
        _ =>
            first_memory_expr_context(callee, base.clone()).or_else(none)
        _ =>
            first_memory_expr_context(receiver, base.clone()).or_else(none)
        _ =>
            first_memory_expr_context(object, base)
        _ =>
            first_memory_expr_context(object, base.clone()).or_else(none)
        _ =>
            first_memory_expr_context(target, base.clone()).or_else(none)
        _ =>
            fields.iter().find_map(none)
        _ =>
            match fields:
                Unit =>
                    None
                Tuple(items) =>
                    items.iter().find_map(none)
                Struct(items) =>
                    items.iter().find_map(none)
        Array(items, _) =>
            items.iter().find_map(none)
        _ =>
            start.as_deref().and_then(none).or_else(none)
        _ =>
            first_memory_expr_context(condition, base.clone()).or_else(none).or_else(none)
        _ =>
            first_memory_expr_context(scrutinee, base.clone()).or_else(none)
        _ =>
            first_memory_expr_context(body, base)
        _ =>
            init.iter().find_map(none)
        Block(block, _) =>
            first_memory_block_context(block, base)
        _ =>
            args.iter().find_map(none)
        Return(Some(expr), _) =>
            first_memory_expr_context(expr, base)
        Int(_, _) =>
            None

fn format_ptr_type(ty: &Type, mutable_: Bool) -> String:
    let inner = match ty:
        _ =>
            inner.as_ref()
        _ =>
            ty
    if mutable_:
        f"ptr_mut<{format_type(inner)}>"
    else:
        f"ptr<{format_type(inner)}>"

fn format_type(ty: &Type) -> String:
    match ty:
        _ =>
            if generics.is_empty():
                name.clone()
            else:
                "{name}<{generics.iter().map(format_type).collect().join(\", \")}>"
        Tuple(items, _) =>
            "({items.iter().map(format_type).collect().join(\", \")})"
        Array(inner, size, _) =>
            f"[{format_type(inner)}; {size}]"
        Slice(inner, _) =>
            f"[{format_type(inner)}]"
        _ =>
            if (*mutable_):
                f"&mut {format_type(inner)}"
            else:
                f"&{format_type(inner)}"
        _ =>
            if (*mutable_):
                f"ptr_mut<{format_type(inner)}>"
            else:
                f"ptr<{format_type(inner)}>"
        _ =>
            "fn({params.iter().map(format_type).collect().join(\", \")}) -> {format_type(return_type)}"
        Option(inner, _) =>
            f"{format_type(inner)}?"
        Result(ok, err, _) =>
            f"{format_type(ok)}!{format_type(err)}"
        Infer(_) =>
            "_".to_string()
        Never(_) =>
            "!".to_string()
        Unit(_) =>
            "()".to_string()
        _ =>
            if generics.is_empty():
                f"impl {trait_name}"
            else:
                "impl {trait_name}<{generics.iter().map(format_type).collect().join(\", \")}>"

const C_UNION_ATTR: &String = "c_union"

const C_BITFIELD_ATTR: &String = "c_bitfield"

const C_STORAGE_BITS_ATTR: &String = "c_storage_bits"

const C_STORAGE_ALIGN_ATTR: &String = "c_storage_align"

const C_PACKED_ATTR: &String = "c_packed"

const C_PACK_ALIGN_ATTR: &String = "c_pack_align"

const C_TYPE_ALIGN_ATTR: &String = "c_type_align"

fn marker_attr(name: &String, span: crate::span::Span) -> crate::ast::Attribute:
    aggregate_init("crate__ast__Attribute", name = name.to_string(), args = Vec__new_(), span = span)

fn usize_attr(name: &String, value: usize, span: crate::span::Span) -> crate::ast::Attribute:
    aggregate_init("crate__ast__Attribute", name = name.to_string(), args = [crate__ast__Expr__Int(value as i64, span)], span = span)

fn usize_bool_attr(name: &String, value: usize, flag: Bool, span: crate::span::Span) -> crate::ast::Attribute:
    aggregate_init("crate__ast__Attribute", name = name.to_string(), args = [crate__ast__Expr__Int(value as i64, span), crate__ast__Expr__Bool(flag, span)], span = span)

fn has_attr(attrs: &[crate::ast::Attribute], name: &String) -> Bool:
    attrs.iter().any(none)

fn attr_usize_arg(attrs: &[crate::ast::Attribute], name: &String) -> Option<usize>:
    attrs.iter().find_map(none)

fn attr_usize_bool_args(attrs: &[crate::ast::Attribute], name: &String) -> Option<(usize, Bool)>:
    attrs.iter().find_map(none)

struct MonomorphizedProgram:
    items: Array<TypedItem>

fn monomorphize(program: &TypedProgram) -> Result<MonomorphizedProgram, Error>:
    let mut ctx = MonoContext__new_()
    for item in &program.items:
        match item:
            Function(func) =>
                if (!func.ast.generics.is_empty()):
                    ctx.generic_functions.insert(func.ast.name.clone(), func.clone())
                else:
                    ctx.concrete_items.push(item.clone())
            Struct(s) =>
                let mut fields = std__collections__HashMap__new_()
                for f in &s.ast.fields:
                    match resolve_ast_type(&f.ty):
                        Ok(ty) =>
                            fields.insert(f.name.clone(), ty)
                        _ =>
                            none
                if (!s.ast.generics.is_empty()):
                    ctx.generic_structs.insert(s.ast.name.clone(), s.clone())
                else:
                    ctx.structs.insert(s.ast.name.clone(), fields)
                    ctx.concrete_items.push(item.clone())
            Impl(imp) =>
                let type_name = match &imp.ast.target_type:
                    _ =>
                        name.clone()
                    _ =>
                        continue
                let target_ty = resolve_ast_type(&imp.ast.target_type).unwrap_or(ResolvedType__Unknown)
                match &imp.ast.trait_name:
                    Some(trait_name) =>
                        let type_name_str = type_to_string(&target_ty)
                        ctx.trait_impls.insert((trait_name.clone(), type_name_str))
                    _ =>
                        none
                if (!imp.ast.generics.is_empty()):
                    ctx.generic_impls.insert(type_name.clone(), imp.clone())
                else:
                    for method in &imp.ast.methods:
                        let mangled_name = f"{type_name}_{method.name}"
                        let mut standalone_fn = method.clone()
                        standalone_fn.name = mangled_name.clone()
                        let mut params = Vec__new_()
                        for p in &method.params:
                            if (p.name == "self"):
                                params.push(target_ty.clone())
                            else:
                                params.push(resolve_ast_type(&p.ty).unwrap_or(ResolvedType__Unknown))
                        let ret = method.return_type.as_ref().map(none).unwrap_or(ResolvedType__Unit)
                        let method_ty = aggregate_init("ResolvedType__Function", params = params, ret = Box__new_(ret), effects = crate__effects__EffectSet__new_())
                        let typed_method = aggregate_init("TypedFunction", ast = standalone_fn, resolved_type = method_ty, effects = crate__effects__EffectSet__new_())
                        ctx.methods.entry(type_name.clone()).or_default().insert(method.name.clone(), mangled_name.clone())
                        ctx.concrete_items.push(TypedItem__Function(typed_method))
            _ =>
                ctx.concrete_items.push(item.clone())
    let mut i = 0
    while (i < ctx.concrete_items.len()):
        let item = ctx.concrete_items[i].clone()
        match item:
            Function(func) =>
                if func.effects.effects.contains(&crate__effects__Effect__Async_):
                    let entry_fn = lower_async_fn(&mut ctx, &func)?
                    ctx.concrete_items[i] = TypedItem__Function(entry_fn)
                else:
                    let new_func = scan_function(&mut ctx, &func)?
                    ctx.concrete_items[i] = TypedItem__Function(new_func)
            _ =>
                let __selfhost_empty = none
        (i + 1)
    Ok(aggregate_init("MonomorphizedProgram", items = ctx.concrete_items))

struct MonoContext:
    generic_functions: Map<String, TypedFunction>
    generic_structs: Map<String, TypedStruct>
    generic_impls: Map<String, TypedImpl>
    concrete_items: Array<TypedItem>
    instantiated: Map<String, String>
    instantiated_structs: Map<String, String>
    methods: Map<String, Map<String, String>>
    structs: Map<String, Map<String, ResolvedType>>
    trait_impls: Set<(String, String)>

impl MonoContext:
    fn new_() -> Self_:
        aggregate_init("Self_", generic_functions = std__collections__HashMap__new_(), generic_structs = std__collections__HashMap__new_(), generic_impls = std__collections__HashMap__new_(), concrete_items = Vec__new_(), instantiated = std__collections__HashMap__new_(), instantiated_structs = std__collections__HashMap__new_(), methods = std__collections__HashMap__new_(), structs = std__collections__HashMap__new_(), trait_impls = std__collections__HashSet__new_())

    fn instantiate(_self: &mut Self_, name: &String, type_args: &[ResolvedType]) -> Result<String, Error>:
        let mangled_name = f"{name}_{mangle_types(type_args)}"
        if _self.instantiated.contains_key(&mangled_name):
            return Ok(mangled_name)
        let generic_func = _self.generic_functions.get(name).ok_or_else(none)?.clone()
        if (generic_func.ast.generics.len() != type_args.len()):
            return Err(crate__error__KainError__type_error(f"Generic arg count mismatch for {name}: expected {generic_func.ast.generics.len()}, got {type_args.len()}", generic_func.ast.span))
        let mut mapping = std__collections__HashMap__new_()
        for _item in generic_func.ast.generics.iter().enumerate():
            mapping.insert(param.name.clone(), type_args[i].clone())
        let mut new_func = generic_func.clone()
        new_func.ast.name = mangled_name.clone()
        new_func.ast.generics.clear()
        match &mut new_func.resolved_type:
            _ =>
                for p in params:
                    (*p) = substitute_type(p, &mapping)
                (*ret) = Box__new_(substitute_type(&ret, &mapping))
            _ =>
                none
        _self.instantiated.insert(mangled_name.clone(), mangled_name.clone())
        substitute_ast_types(&mut new_func.ast, &mapping)
        _self.concrete_items.push(TypedItem__Function(new_func))
        Ok(mangled_name)

    fn instantiate_struct(_self: &mut Self_, name: &String, type_args: &[ResolvedType]) -> Result<String, Error>:
        let mangled_name = f"{name}_{mangle_types(type_args)}"
        if _self.instantiated_structs.contains_key(&mangled_name):
            return Ok(mangled_name)
        let generic_struct = _self.generic_structs.get(name).ok_or_else(none)?.clone()
        if (generic_struct.ast.generics.len() != type_args.len()):
            return Err(crate__error__KainError__type_error(f"Generic arg count mismatch for {name}: expected {generic_struct.ast.generics.len()}, got {type_args.len()}", generic_struct.ast.span))
        let mut mapping = std__collections__HashMap__new_()
        for _item in generic_struct.ast.generics.iter().enumerate():
            mapping.insert(param.name.clone(), type_args[i].clone())
        let mut new_struct = generic_struct.clone()
        new_struct.ast.name = mangled_name.clone()
        new_struct.ast.generics.clear()
        for field in &mut new_struct.ast.fields:
            substitute_type_ast(&mut field.ty, &mapping)
        let mut new_field_types = std__collections__HashMap__new_()
        for _item in &new_struct.field_types:
            new_field_types.insert(field_name.clone(), substitute_type(field_ty, &mapping))
        new_struct.field_types = new_field_types.clone()
        _self.instantiated_structs.insert(mangled_name.clone(), mangled_name.clone())
        _self.structs.insert(mangled_name.clone(), new_field_types)
        _self.concrete_items.push(TypedItem__Struct(new_struct))
        match _self.generic_impls.get(name).cloned():
            Some(generic_impl) =>
                _self.instantiate_impl_methods(&mangled_name, &generic_impl, type_args)?
            _ =>
                none
        Ok(mangled_name)

    fn instantiate_impl_methods(_self: &mut Self_, instantiated_struct_name: &String, generic_impl: &TypedImpl, type_args: &[ResolvedType]) -> Result<(), Error>:
        let mut mapping = std__collections__HashMap__new_()
        for _item in generic_impl.ast.generics.iter().enumerate():
            if (i < type_args.len()):
                mapping.insert(param.name.clone(), type_args[i].clone())
        for method in &generic_impl.ast.methods:
            let mangled_name = f"{instantiated_struct_name}_{method.name}"
            let mut standalone_fn = method.clone()
            standalone_fn.name = mangled_name.clone()
            for param in &mut standalone_fn.params:
                substitute_type_ast(&mut param.ty, &mapping)
            match &mut standalone_fn.return_type:
                Some(ret) =>
                    substitute_type_ast(ret, &mapping)
                _ =>
                    none
            substitute_block(&mut standalone_fn.body, &mapping)
            let target_ty = ResolvedType__Struct(instantiated_struct_name.to_string(), std__collections__HashMap__new_())
            let mut params = Vec__new_()
            for p in &standalone_fn.params:
                if (p.name == "self"):
                    params.push(target_ty.clone())
                else:
                    params.push(resolve_ast_type(&p.ty).unwrap_or(ResolvedType__Unknown))
            let ret = standalone_fn.return_type.as_ref().map(none).unwrap_or(ResolvedType__Unit)
            let method_ty = aggregate_init("ResolvedType__Function", params = params, ret = Box__new_(ret), effects = crate__effects__EffectSet__new_())
            let typed_method = aggregate_init("TypedFunction", ast = standalone_fn, resolved_type = method_ty, effects = crate__effects__EffectSet__new_())
            _self.methods.entry(instantiated_struct_name.to_string()).or_default().insert(method.name.clone(), mangled_name.clone())
            _self.concrete_items.push(TypedItem__Function(typed_method))
        Ok(none)


fn type_to_string(ty: &ResolvedType) -> String:
    match ty:
        Int(_) =>
            "Int".to_string()
        Float(_) =>
            "Float".to_string()
        String =>
            "String".to_string()
        Bool =>
            "Bool".to_string()
        Unit =>
            "Unit".to_string()
        Struct(n, _) =>
            n.clone()
        Enum(n, _) =>
            n.clone()
        Tuple(ts) =>
            "({ts.iter().map(type_to_string).collect().join(\", \")})"
        _ =>
            "Any".to_string()

fn mangle_types(types: &[ResolvedType]) -> String:
    types.iter().map(type_to_string).collect().join("_")

fn resolve_ast_type(ty: &Type) -> Result<ResolvedType, Error>:
    crate__types__resolve_type(ty)

fn unify(param_type: &ResolvedType, arg_type: &ResolvedType, bindings: &mut Map<String, ResolvedType>):
    match (param_type, arg_type):
        (Generic(name), concrete) =>
            match bindings.get(name):
                Some(existing) =>
                    let _ = existing
                _ =>
                    bindings.insert(name.clone(), concrete.clone())
        (_, _) =>
            for _item in p_params.iter().zip(a_params.iter()):
                unify(pp, ap, bindings)
            unify(p_ret, a_ret, bindings)
        (Array(p_inner, _), Array(a_inner, _)) =>
            unify(p_inner, a_inner, bindings)
        (Tuple(p_elems), Tuple(a_elems)) =>
            for _item in p_elems.iter().zip(a_elems.iter()):
                unify(pe, ae, bindings)
        _ =>
            let __selfhost_empty = none

fn infer_type_args(ctx: &MonoContext, generic_func: &TypedFunction, arg_types: &[ResolvedType]) -> Result<Array<ResolvedType>, Error>:
    let mut bindings: Map<String, ResolvedType> = std__collections__HashMap__new_()
    let param_types: Array<ResolvedType> = match &generic_func.resolved_type:
        _ =>
            params.clone()
        _ =>
            generic_func.ast.params.iter().map(none).collect()
    for _item in param_types.iter().zip(arg_types.iter()):
        unify(param_ty, arg_ty, &mut bindings)
    let mut inferred = Vec__new_()
    for generic in &generic_func.ast.generics:
        match bindings.get(&generic.name):
            Some(ty) =>
                for bound in &generic.bounds:
                    let type_name = type_to_string(ty)
                    if (!ctx.trait_impls.contains(&(bound.trait_name.clone(), type_name.clone()))):
                        return Err(crate__error__KainError__type_error(f"Type '{type_name}' does not satisfy bound '{bound.trait_name}'", generic.span))
                inferred.push(ty.clone())
            _ =>
                inferred.push(ResolvedType__Unknown)
    Ok(inferred)

fn substitute_type(ty: &ResolvedType, mapping: &Map<String, ResolvedType>) -> ResolvedType:
    match ty:
        Generic(name) =>
            mapping.get(name).cloned().unwrap_or(ty.clone())
        _ =>
            aggregate_init("ResolvedType__Function", params = params.iter().map(none).collect(), ret = Box__new_(substitute_type(ret, mapping)), effects = effects.clone())
        Array(inner, n) =>
            ResolvedType__Array(Box__new_(substitute_type(inner, mapping)), (*n))
        Struct(name, fields) =>
            let new_fields: Map<String, ResolvedType> = fields.iter().map(none).collect()
            ResolvedType__Struct(name.clone(), new_fields)
        Tuple(elems) =>
            ResolvedType__Tuple(elems.iter().map(none).collect())
        Option(inner) =>
            ResolvedType__Option(Box__new_(substitute_type(inner, mapping)))
        Result(ok, err) =>
            ResolvedType__Result(Box__new_(substitute_type(ok, mapping)), Box__new_(substitute_type(err, mapping)))
        _ =>
            aggregate_init("ResolvedType__Ref", mutable_ = (*mutable_), inner = Box__new_(substitute_type(inner, mapping)))
        _ =>
            aggregate_init("ResolvedType__Ptr", mutable_ = (*mutable_), inner = Box__new_(substitute_type(inner, mapping)))
        Slice(inner) =>
            ResolvedType__Slice(Box__new_(substitute_type(inner, mapping)))
        _ =>
            ty.clone()

fn substitute_ast_types(func: &mut Function, mapping: &Map<String, ResolvedType>):
    for param in &mut func.params:
        substitute_type_ast(&mut param.ty, mapping)
    match &mut func.return_type:
        Some(ret) =>
            substitute_type_ast(ret, mapping)
        _ =>
            none
    substitute_block(&mut func.body, mapping)

fn substitute_block(block: &mut Block, mapping: &Map<String, ResolvedType>):
    for stmt in &mut block.stmts:
        substitute_stmt(stmt, mapping)

fn substitute_stmt(stmt: &mut Stmt, mapping: &Map<String, ResolvedType>):
    match stmt:
        _ =>
            match ty:
                Some(t) =>
                    substitute_type_ast(t, mapping)
                _ =>
                    none
            match value:
                Some(v) =>
                    substitute_expr(v, mapping)
                _ =>
                    none
        Expr(e) =>
            substitute_expr(e, mapping)
        Return(Some(e), _) =>
            substitute_expr(e, mapping)
        _ =>
            substitute_expr(iter, mapping)
            substitute_block(body, mapping)
        _ =>
            substitute_expr(condition, mapping)
            substitute_block(body, mapping)
        _ =>
            let __selfhost_empty = none

fn substitute_expr(expr: &mut Expr, mapping: &Map<String, ResolvedType>):
    match expr:
        _ =>
            substitute_expr(value, mapping)
            substitute_type_ast(target, mapping)
        _ =>
            substitute_expr(left, mapping)
            substitute_expr(right, mapping)
        _ =>
            substitute_expr(operand, mapping)
        _ =>
            substitute_expr(callee, mapping)
            for arg in args:
                substitute_expr(&mut arg.value, mapping)
        _ =>
            substitute_expr(receiver, mapping)
            for arg in args:
                substitute_expr(&mut arg.value, mapping)
        _ =>
            substitute_expr(object, mapping)
        _ =>
            substitute_expr(object, mapping)
            substitute_expr(index, mapping)
        _ =>
            for _item in fields:
                substitute_expr(v, mapping)
        Array(items, _) =>
            for item in items:
                substitute_expr(item, mapping)
        Tuple(items, _) =>
            for item in items:
                substitute_expr(item, mapping)
        Block(b, _) =>
            substitute_block(b, mapping)
        _ =>
            substitute_expr(condition, mapping)
            substitute_block(then_branch, mapping)
            match else_branch:
                Some(br) =>
                    match br.as_mut():
                        Else(b) =>
                            substitute_block(b, mapping)
                        ElseIf(c, t, _) =>
                            substitute_expr(c, mapping)
                            substitute_block(t, mapping)
                _ =>
                    none
        _ =>
            substitute_expr(scrutinee, mapping)
            for arm in arms:
                substitute_expr(&mut arm.body, mapping)
        _ =>
            for p in params:
                substitute_type_ast(&mut p.ty, mapping)
            match return_type:
                Some(ret) =>
                    substitute_type_ast(ret, mapping)
                _ =>
                    none
            substitute_expr(body, mapping)
        Await(inner, _) =>
            substitute_expr(inner, mapping)
        _ =>
            let __selfhost_empty = none

fn substitute_type_ast(ty: &mut Type, mapping: &Map<String, ResolvedType>):
    match ty:
        _ =>
            match mapping.get(name):
                Some(concrete) =>
                    (*ty) = resolved_to_ast_type(concrete, ty.span())
                _ =>
                    for g in generics:
                        substitute_type_ast(g, mapping)
        Tuple(types, _) =>
            for t in types:
                substitute_type_ast(t, mapping)
        _ =>
            for p in params:
                substitute_type_ast(p, mapping)
            substitute_type_ast(return_type, mapping)
        Array(inner, _, _) =>
            substitute_type_ast(inner, mapping)
        Slice(inner, _) =>
            substitute_type_ast(inner, mapping)
        _ =>
            substitute_type_ast(inner, mapping)
        _ =>
            let __selfhost_empty = none

fn resolved_to_ast_type(res: &ResolvedType, span: crate::span::Span) -> Type:
    match res:
        Int(_) =>
            aggregate_init("Type__Named", name = "Int".into(), generics = [], span = span)
        Float(_) =>
            aggregate_init("Type__Named", name = "Float".into(), generics = [], span = span)
        Bool =>
            aggregate_init("Type__Named", name = "Bool".into(), generics = [], span = span)
        String =>
            aggregate_init("Type__Named", name = "String".into(), generics = [], span = span)
        Unit =>
            Type__Unit(span)
        Struct(n, _) =>
            aggregate_init("Type__Named", name = n.clone(), generics = [], span = span)
        _ =>
            aggregate_init("Type__Ptr", mutable_ = (*mutable_), inner = Box__new_(resolved_to_ast_type(inner, span)), provenance = crate__ast__PointerProvenance__LoweredRef, span = span)
        _ =>
            aggregate_init("Type__Named", name = "Any".into(), generics = [], span = span)

struct MonoTypeEnv:
    scopes: Array<Map<String, ResolvedType>>

impl MonoTypeEnv:
    fn new_() -> Self_:
        aggregate_init("Self_", scopes = [std__collections__HashMap__new_()])

    fn push(_self: &mut Self_):
        _self.scopes.push(std__collections__HashMap__new_())

    fn pop(_self: &mut Self_):
        _self.scopes.pop()

    fn define(_self: &mut Self_, name: String, ty: ResolvedType):
        match _self.scopes.last_mut():
            Some(s) =>
                s.insert(name, ty)
            _ =>
                none

    fn get(_self: &Self_, name: &String) -> ResolvedType:
        for s in _self.scopes.iter().rev():
            match s.get(name):
                Some(t) =>
                    return t.clone()
                _ =>
                    none
        ResolvedType__Unknown


fn lower_async_fn(ctx: &mut MonoContext, func: &TypedFunction) -> Result<TypedFunction, Error>:
    let state_machine_name = f"{func.ast.name}_Future"
    let mut fields = std__collections__HashMap__new_()
    fields.insert("state".to_string(), ResolvedType__Int(IntSize__I64))
    for param in &func.ast.params:
        fields.insert(param.name.clone(), resolve_ast_type(&param.ty).unwrap_or(ResolvedType__Unknown))
    let locals = collect_locals(&func.ast.body)
    for _item in locals:
        fields.entry(name).or_insert(ty)
    let _struct_ty = ResolvedType__Struct(state_machine_name.clone(), fields.clone())
    ctx.structs.insert(state_machine_name.clone(), fields.clone())
    let struct_def = TypedItem__Struct(aggregate_init("TypedStruct", ast = aggregate_init("Struct", name = state_machine_name.clone(), generics = [], fields = fields.iter().map(none).collect(), visibility = Visibility__Public, attributes = [], methods = [], span = func.ast.span), field_types = fields.clone()))
    ctx.concrete_items.push(struct_def)
    let poll_name = f"{state_machine_name}_poll"
    let self_type = ResolvedType__Struct(state_machine_name.clone(), fields.clone())
    let self_param = aggregate_init("Param", name = "self".to_string(), ty = resolved_to_ast_type(&self_type, func.ast.span), mutable_ = true, default_ = None, span = func.ast.span)
    let await_points = collect_await_points(&func.ast.body)
    for _item in await_points.iter().enumerate():
        let field_name = f"_await_{i}"
        fields.insert(field_name, ResolvedType__Unknown)
        let res_name = f"_await_{i}_result"
        fields.insert(res_name, ResolvedType__Unknown)
    ctx.structs.insert(state_machine_name.clone(), fields.clone())
    let mut arms = Vec__new_()
    if await_points.is_empty():
        let mut rewritten_body = func.ast.body.clone()
        rewrite_access_to_self(&mut rewritten_body, &fields)
        let body_with_ready = wrap_return_in_poll_ready(rewritten_body, func.ast.span)
        let arm0 = aggregate_init("MatchArm", pattern = Pattern__Literal(Expr__Int(0, func.ast.span)), guard = None, body = body_with_ready, span = func.ast.span)
        arms.push(arm0)
    else:
        let segments = split_at_awaits(&func.ast.body, &await_points)
        for _item in segments.iter().enumerate():
            let arm = generate_state_arm(state_idx, segment, &await_points, &fields, &state_machine_name, func.ast.span)
            arms.push(arm)
    let arm_wild = aggregate_init("MatchArm", pattern = Pattern__Wildcard(func.ast.span), guard = None, body = aggregate_init("Expr__Call", callee = Box__new_(Expr__Ident("panic".to_string(), func.ast.span)), args = [aggregate_init("CallArg", name = None, value = Expr__String("polled after completion".to_string(), func.ast.span), span = func.ast.span)], span = func.ast.span), span = func.ast.span)
    arms.push(arm_wild)
    let mut poll_body = aggregate_init("Block", stmts = [], span = func.ast.span)
    let match_expr = aggregate_init("Expr__Match", scrutinee = Box__new_(aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), func.ast.span)), field = "state".to_string(), span = func.ast.span)), arms = arms, span = func.ast.span)
    poll_body.stmts.push(Stmt__Expr(match_expr))
    let poll_fn = TypedItem__Function(aggregate_init("TypedFunction", ast = aggregate_init("Function", name = poll_name.clone(), generics = [], params = [self_param], return_type = None, effects = [], body = poll_body, visibility = Visibility__Public, attributes = [], span = func.ast.span), resolved_type = aggregate_init("ResolvedType__Function", params = [self_type], ret = Box__new_(ResolvedType__Unit), effects = crate__effects__EffectSet__new_()), effects = crate__effects__EffectSet__new_()))
    ctx.concrete_items.push(poll_fn)
    let mut entry_fn = func.clone()
    let mut init_fields = Vec__new_()
    init_fields.push(("state".to_string(), Expr__Int(0, func.ast.span)))
    for param in &func.ast.params:
        init_fields.push((param.name.clone(), Expr__Ident(param.name.clone(), func.ast.span)))
    for _item in await_points.iter().enumerate():
        init_fields.push((f"_await_{i}", Expr__None(func.ast.span)))
        init_fields.push((f"_await_{i}_result", Expr__None(func.ast.span)))
    let captured_locals = collect_locals(&func.ast.body)
    for _item in captured_locals:
        if func.ast.params.iter().any(none):
            continue
        init_fields.push((name, Expr__None(func.ast.span)))
    let body_expr = aggregate_init("Expr__Struct", name = state_machine_name.clone(), fields = init_fields, span = func.ast.span)
    entry_fn.ast.body = aggregate_init("Block", stmts = [Stmt__Return(Some(body_expr), func.ast.span)], span = func.ast.span)
    entry_fn.resolved_type = aggregate_init("ResolvedType__Function", params = none, ret = Box__new_(ResolvedType__Struct(state_machine_name, fields)), effects = crate__effects__EffectSet__new_())
    entry_fn.effects.effects.remove(&crate__effects__Effect__Async_)
    entry_fn.ast.effects.retain(none)
    Ok(entry_fn)

fn rewrite_access_to_self(block: &mut Block, fields: &Map<String, ResolvedType>):
    for stmt in &mut block.stmts:
        rewrite_stmt(stmt, fields)

fn rewrite_stmt(stmt: &mut Stmt, fields: &Map<String, ResolvedType>):
    match stmt:
        Expr(e) =>
            rewrite_expr(e, fields)
        Return(Some(e), _) =>
            rewrite_expr(e, fields)
        _ =>
            rewrite_expr(e, fields)
        _ =>
            rewrite_expr(iter, fields)
            rewrite_access_to_self(body, fields)
        _ =>
            rewrite_expr(condition, fields)
            rewrite_access_to_self(body, fields)
        _ =>
            let __selfhost_empty = none
    let transform = match stmt:
        _ =>
            if fields.contains_key(name):
                Some((name.clone(), e.clone(), (*span)))
            else:
                None
        _ =>
            None
    match transform:
        Some((name, val, span)) =>
            (*stmt) = Stmt__Expr(aggregate_init("Expr__Assign", target = Box__new_(aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), span)), field = name, span = span)), value = Box__new_(val), span = span))
        _ =>
            none

fn rewrite_expr(expr: &mut Expr, fields: &Map<String, ResolvedType>):
    match expr:
        Ident(name, span) =>
            if fields.contains_key(name):
                (*expr) = aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), (*span))), field = name.clone(), span = (*span))
        _ =>
            rewrite_expr(left, fields)
            rewrite_expr(right, fields)
        _ =>
            rewrite_expr(callee, fields)
            for arg in args:
                rewrite_expr(&mut arg.value, fields)
        _ =>
            rewrite_expr(object, fields)
        Await(inner, _) =>
            rewrite_expr(inner, fields)
        Block(b, _) =>
            rewrite_access_to_self(b, fields)
        _ =>
            let __selfhost_empty = none

struct AwaitPoint:
    awaited_expr: Expr
    result_binding: Option<String>
    index: usize

fn collect_await_points(block: &Block) -> Array<AwaitPoint>:
    let mut points = Vec__new_()
    collect_awaits_from_block(block, &mut points)
    points

fn collect_awaits_from_block(block: &Block, points: &mut Array<AwaitPoint>):
    for stmt in &block.stmts:
        collect_awaits_from_stmt(stmt, points)

fn collect_awaits_from_stmt(stmt: &Stmt, points: &mut Array<AwaitPoint>):
    match stmt:
        _ =>
            let name = match pattern:
                _ =>
                    Some(n.clone())
                _ =>
                    None
            match value:
                Some(expr) =>
                    match expr:
                        Await(inner, _) =>
                            points.push(aggregate_init("AwaitPoint", awaited_expr = ((*(*inner))).clone(), result_binding = name, index = points.len()))
                        _ =>
                            collect_awaits_from_expr(expr, points)
                _ =>
                    none
        Expr(expr) =>
            match expr:
                Await(inner, _) =>
                    points.push(aggregate_init("AwaitPoint", awaited_expr = ((*(*inner))).clone(), result_binding = None, index = points.len()))
                _ =>
                    collect_awaits_from_expr(expr, points)
        Return(Some(expr), _) =>
            match expr:
                Await(inner, _) =>
                    points.push(aggregate_init("AwaitPoint", awaited_expr = ((*(*inner))).clone(), result_binding = None, index = points.len()))
                _ =>
                    collect_awaits_from_expr(expr, points)
        _ =>
            collect_awaits_from_block(body, points)
        _ =>
            collect_awaits_from_block(body, points)
        _ =>
            let __selfhost_empty = none

fn collect_awaits_from_expr(expr: &Expr, points: &mut Array<AwaitPoint>):
    match expr:
        Await(inner, _) =>
            points.push(aggregate_init("AwaitPoint", awaited_expr = ((*(*inner))).clone(), result_binding = None, index = points.len()))
        _ =>
            collect_awaits_from_expr(left, points)
            collect_awaits_from_expr(right, points)
        _ =>
            collect_awaits_from_expr(callee, points)
            for arg in args:
                collect_awaits_from_expr(&arg.value, points)
        Block(block, _) =>
            collect_awaits_from_block(block, points)
        _ =>
            collect_awaits_from_block(then_branch, points)
            match else_branch:
                Some(else_b) =>
                    match else_b.as_ref():
                        Else(b) =>
                            collect_awaits_from_block(b, points)
                        ElseIf(_, then_b, _) =>
                            collect_awaits_from_block(then_b, points)
                _ =>
                    none
        _ =>
            let __selfhost_empty = none

struct CodeSegment:
    stmts_before: Array<Stmt>
    await_point: Option<AwaitPoint>
    ends_with_return: Bool

fn split_at_awaits(block: &Block, await_points: &[AwaitPoint]) -> Array<CodeSegment>:
    let mut segments = Vec__new_()
    let mut current_stmts = Vec__new_()
    let mut await_idx = 0
    for stmt in &block.stmts:
        let contains_await = match stmt:
            _ =>
                true
            Expr(Await(_, _)) =>
                true
            Return(Some(Await(_, _)), _) =>
                true
            _ =>
                false
        if (contains_await && (await_idx < await_points.len())):
            segments.push(aggregate_init("CodeSegment", stmts_before = current_stmts.clone(), await_point = Some(await_points[await_idx].clone()), ends_with_return = none))
            current_stmts.clear()
            (await_idx + 1)
        else:
            current_stmts.push(stmt.clone())
    if ((!current_stmts.is_empty()) || segments.is_empty()):
        let ends_with_return = current_stmts.last().map(none).unwrap_or(false)
        segments.push(aggregate_init("CodeSegment", stmts_before = current_stmts, await_point = None, ends_with_return = ends_with_return))
    segments

fn generate_state_arm(state_idx: usize, segment: &CodeSegment, await_points: &[AwaitPoint], fields: &Map<String, ResolvedType>, _state_machine_name: &String, span: crate::span::Span) -> MatchArm:
    let mut body_stmts = Vec__new_()
    if ((state_idx > 0) && (state_idx <= await_points.len())):
        let prev_await = &await_points[(state_idx - 1)]
        let poll_field = f"_await_{prev_await.index}"
        let res_field = f"_await_{prev_await.index}_result"
        let poll_call = aggregate_init("Expr__MethodCall", receiver = Box__new_(aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), span)), field = poll_field, span = span)), method = "poll".to_string(), args = [], span = span)
        let pending_arm = aggregate_init("MatchArm", pattern = aggregate_init("Pattern__Variant", enum_name = Some("Poll".to_string()), variant = "Pending".to_string(), fields = VariantPatternFields__Unit, span = span), guard = None, body = Expr__Return(Some(Box__new_(aggregate_init("Expr__EnumVariant", enum_name = "Poll".to_string(), variant = "Pending".to_string(), fields = EnumVariantFields__Unit, span = span))), span), span = span)
        let val_name = "val".to_string()
        let ready_arm = aggregate_init("MatchArm", pattern = aggregate_init("Pattern__Variant", enum_name = Some("Poll".to_string()), variant = "Ready".to_string(), fields = VariantPatternFields__Tuple([aggregate_init("Pattern__Binding", name = val_name.clone(), mutable_ = false, span = span)]), span = span), guard = None, body = aggregate_init("Expr__Assign", target = Box__new_(aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), span)), field = res_field.clone(), span = span)), value = Box__new_(Expr__Ident(val_name, span)), span = span), span = span)
        let poll_match = aggregate_init("Expr__Match", scrutinee = Box__new_(poll_call), arms = [pending_arm, ready_arm], span = span)
        body_stmts.push(Stmt__Expr(poll_match))
        match &prev_await.result_binding:
            Some(binding) =>
                if fields.contains_key(binding):
                    body_stmts.push(Stmt__Expr(aggregate_init("Expr__Assign", target = Box__new_(aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), span)), field = binding.clone(), span = span)), value = Box__new_(aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), span)), field = res_field, span = span)), span = span)))
                else:
                    body_stmts.push(aggregate_init("Stmt__Let", pattern = aggregate_init("Pattern__Binding", name = binding.clone(), mutable_ = false, span = span), ty = None, value = Some(aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), span)), field = res_field, span = span)), span = span))
            _ =>
                none
    for stmt in &segment.stmts_before:
        let mut rewritten_stmt = stmt.clone()
        rewrite_stmt(&mut rewritten_stmt, fields)
        body_stmts.push(rewritten_stmt)
    match &segment.await_point:
        Some(await_point) =>
            let store_field = f"_await_{await_point.index}"
            let mut awaited_expr = await_point.awaited_expr.clone()
            rewrite_expr(&mut awaited_expr, fields)
            body_stmts.push(Stmt__Expr(aggregate_init("Expr__Assign", target = Box__new_(aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), span)), field = store_field, span = span)), value = Box__new_(awaited_expr), span = span)))
            body_stmts.push(Stmt__Expr(aggregate_init("Expr__Assign", target = Box__new_(aggregate_init("Expr__Field", object = Box__new_(Expr__Ident("self".to_string(), span)), field = "state".to_string(), span = span)), value = Box__new_(Expr__Int(((state_idx + 1)) as i64, span)), span = span)))
            body_stmts.push(Stmt__Return(Some(aggregate_init("Expr__EnumVariant", enum_name = "Poll".to_string(), variant = "Pending".to_string(), fields = EnumVariantFields__Unit, span = span)), span))
        _ =>
            if segment.ends_with_return:
                let __selfhost_empty = none
            elif (state_idx == await_points.len()):
                body_stmts.push(Stmt__Return(Some(aggregate_init("Expr__EnumVariant", enum_name = "Poll".to_string(), variant = "Ready".to_string(), fields = EnumVariantFields__Tuple([Expr__None(span)]), span = span)), span))
    aggregate_init("MatchArm", pattern = Pattern__Literal(Expr__Int(state_idx as i64, span)), guard = None, body = Expr__Block(aggregate_init("Block", stmts = body_stmts, span = span), span), span = span)

fn wrap_return_in_poll_ready(block: Block, span: crate::span::Span) -> Expr:
    for stmt in &mut block.stmts:
        wrap_stmt_returns(stmt, span)
    Expr__Block(block, span)

fn wrap_stmt_returns(stmt: &mut Stmt, span: crate::span::Span):
    match stmt:
        Return(Some(expr), _) =>
            let inner = std__mem__replace(expr, Expr__None(span))
            (*expr) = aggregate_init("Expr__EnumVariant", enum_name = "Poll".to_string(), variant = "Ready".to_string(), fields = EnumVariantFields__Tuple([inner]), span = span)
        Return(None, s) =>
            (*stmt) = Stmt__Return(Some(aggregate_init("Expr__EnumVariant", enum_name = "Poll".to_string(), variant = "Ready".to_string(), fields = EnumVariantFields__Tuple([Expr__None(span)]), span = span)), (*s))
        _ =>
            for s in &mut body.stmts:
                wrap_stmt_returns(s, span)
        _ =>
            for s in &mut body.stmts:
                wrap_stmt_returns(s, span)
        _ =>
            let __selfhost_empty = none

fn scan_function(ctx: &mut MonoContext, func: &TypedFunction) -> Result<TypedFunction, Error>:
    let mut new_func = func.clone()
    let mut env = MonoTypeEnv__new_()
    match &func.resolved_type:
        _ =>
            for _item in params.iter().enumerate():
                if (i < func.ast.params.len()):
                    env.define(func.ast.params[i].name.clone(), p.clone())
        _ =>
            none
    for param in &func.ast.params:
        match &param.ty:
            _ =>
                if ((!generics.is_empty()) && ctx.generic_structs.contains_key(name)):
                    let mut type_args = Vec__new_()
                    for gen_ty in generics:
                        match resolve_ast_type(gen_ty):
                            Ok(resolved) =>
                                type_args.push(resolved)
                            _ =>
                                none
                    if (!type_args.is_empty()):
                        let _ = ctx.instantiate_struct(name, &type_args)?
            _ =>
                none
    match &func.ast.return_type:
        Some(ret_ty) =>
            match ret_ty:
                _ =>
                    if ((!generics.is_empty()) && ctx.generic_structs.contains_key(name)):
                        let mut type_args = Vec__new_()
                        for gen_ty in generics:
                            match resolve_ast_type(gen_ty):
                                Ok(resolved) =>
                                    type_args.push(resolved)
                                _ =>
                                    none
                        if (!type_args.is_empty()):
                            let _ = ctx.instantiate_struct(name, &type_args)?
                _ =>
                    none
        _ =>
            none
    scan_block(ctx, &mut env, &mut new_func.ast.body)?
    Ok(new_func)

fn scan_block(ctx: &mut MonoContext, env: &mut MonoTypeEnv, block: &mut Block) -> Result<(), Error>:
    env.push()
    for stmt in &mut block.stmts:
        scan_stmt(ctx, env, stmt)?
    env.pop()
    Ok(none)

fn scan_stmt(ctx: &mut MonoContext, env: &mut MonoTypeEnv, stmt: &mut Stmt) -> Result<(), Error>:
    match stmt:
        Expr(e) =>
            scan_expr(ctx, env, e)?
        Return(Some(e), _) =>
            scan_expr(ctx, env, e)?
        _ =>
            match ty:
                Some(type_ann) =>
                    match type_ann:
                        _ =>
                            if ((!generics.is_empty()) && ctx.generic_structs.contains_key(name)):
                                let mut type_args = Vec__new_()
                                for gen_ty in generics:
                                    match resolve_ast_type(gen_ty):
                                        Ok(resolved) =>
                                            type_args.push(resolved)
                                        _ =>
                                            none
                                if (!type_args.is_empty()):
                                    let _ = ctx.instantiate_struct(name, &type_args)?
                        _ =>
                            none
                _ =>
                    none
            match value:
                Some(val_expr) =>
                    let ty = scan_expr(ctx, env, val_expr)?
                    match pattern:
                        _ =>
                            env.define(name.clone(), ty)
                        _ =>
                            none
                _ =>
                    none
        _ =>
            let iter_ty = scan_expr(ctx, env, iter)?
            let elem_ty = match iter_ty:
                Array(inner, _) =>
                    (*inner)
                _ =>
                    ResolvedType__Int(IntSize__I64)
            env.push()
            match binding:
                _ =>
                    env.define(name.clone(), elem_ty)
                _ =>
                    none
            scan_block(ctx, env, body)?
            env.pop()
        _ =>
            scan_expr(ctx, env, condition)?
            scan_block(ctx, env, body)?
        _ =>
            let __selfhost_empty = none
    Ok(none)

fn scan_expr(ctx: &mut MonoContext, env: &mut MonoTypeEnv, expr: &mut Expr) -> Result<ResolvedType, Error>:
    match expr:
        Int(_, _) =>
            Ok(ResolvedType__Int(IntSize__I64))
        Float(_, _) =>
            Ok(ResolvedType__Float(FloatSize__F64))
        String(_, _) =>
            Ok(ResolvedType__String)
        Bool(_, _) =>
            Ok(ResolvedType__Bool)
        Ident(name, _) =>
            Ok(env.get(name))
        _ =>
            let operand_ty = scan_expr(ctx, env, operand)?
            match op:
                Neg =>
                    Ok(operand_ty)
                Not =>
                    Ok(ResolvedType__Bool)
                Ref =>
                    Ok(aggregate_init("ResolvedType__Ref", mutable_ = none, inner = Box__new_(operand_ty)))
                Deref =>
                    match operand_ty:
                        _ =>
                            Ok((*inner))
                        _ =>
                            Ok(operand_ty)
        _ =>
            let mut field_types = std__collections__HashMap__new_()
            for _item in fields:
                let val_ty = scan_expr(ctx, env, val)?
                field_types.insert(field_name.clone(), val_ty)
            match ctx.generic_structs.get(name).cloned():
                Some(generic_struct) =>
                    let mut type_args = Vec__new_()
                    for generic_param in &generic_struct.ast.generics:
                        let mut inferred_type = None
                        for field in &generic_struct.ast.fields:
                            match &field.ty:
                                _ =>
                                    if (field_type_name == &generic_param.name):
                                        match field_types.get(&field.name):
                                            Some(val_ty) =>
                                                inferred_type = Some(val_ty.clone())
                                                break
                                            _ =>
                                                none
                                _ =>
                                    none
                        match inferred_type:
                            Some(ty) =>
                                type_args.push(ty)
                            _ =>
                                type_args.push(ResolvedType__Unknown)
                    if ((!type_args.is_empty()) && (!type_args.iter().any(none))):
                        let instantiated_name = ctx.instantiate_struct(name, &type_args)?
                        return Ok(ResolvedType__Struct(instantiated_name, std__collections__HashMap__new_()))
                _ =>
                    none
            Ok(ResolvedType__Struct(name.clone(), std__collections__HashMap__new_()))
        _ =>
            let obj_ty = scan_expr(ctx, env, object)?
            match obj_ty:
                Struct(name, _) =>
                    match ctx.structs.get(&name):
                        Some(fields) =>
                            match fields.get(field):
                                Some(ty) =>
                                    return Ok(ty.clone())
                                _ =>
                                    none
                        _ =>
                            none
                    Ok(ResolvedType__Unknown)
                _ =>
                    Ok(ResolvedType__Unknown)
        _ =>
            let receiver_ty = scan_expr(ctx, env, receiver)?
            let type_name = match &receiver_ty:
                Struct(name, _) =>
                    name.clone()
                Int(_) =>
                    "Int".to_string()
                Float(_) =>
                    "Float".to_string()
                String =>
                    "String".to_string()
                _ =>
                    match receiver_ty:
                        Unknown =>
                            return Ok(ResolvedType__Unknown)
                        _ =>
                            none
                    type_to_string(&receiver_ty)
            let mangled_target = none
            match mangled_target:
                Some(target_name) =>
                    let mut new_args = args.clone()
                    new_args.insert(0, aggregate_init("CallArg", name = None, value = (*receiver.clone()), span = receiver.span()))
                    for arg in &mut new_args:
                        scan_expr(ctx, env, &mut arg.value)?
                    (*expr) = aggregate_init("Expr__Call", callee = Box__new_(Expr__Ident(target_name, (*span))), args = new_args, span = (*span))
                    return Ok(ResolvedType__Unknown)
                _ =>
                    none
            Ok(ResolvedType__Unknown)
        _ =>
            match callee.as_ref():
                Ident(name, _) =>
                    match ctx.generic_functions.get(name).cloned():
                        Some(generic_func) =>
                            let mut arg_types = Vec__new_()
                            for arg in args:
                                arg_types.push(scan_expr(ctx, env, &mut arg.value)?)
                            let inferred_type_args = infer_type_args(ctx, &generic_func, &arg_types)?
                            let new_name = ctx.instantiate(name, &inferred_type_args)?
                            (*callee) = Box__new_(Expr__Ident(new_name, callee.span()))
                            return Ok(ResolvedType__Unknown)
                        _ =>
                            none
                _ =>
                    none
            for arg in args:
                scan_expr(ctx, env, &mut arg.value)?
            Ok(ResolvedType__Unknown)
        _ =>
            let t = scan_expr(ctx, env, left)?
            scan_expr(ctx, env, right)?
            Ok(t)
        _ =>
            scan_expr(ctx, env, value)
        Block(b, _) =>
            scan_block(ctx, env, b)?
            Ok(ResolvedType__Unknown)
        _ =>
            scan_expr(ctx, env, condition)?
            scan_block(ctx, env, then_branch)?
            match else_branch:
                Some(b) =>
                    match b.as_mut():
                        Else(blk) =>
                            scan_block(ctx, env, blk)?
                        ElseIf(_, _, _) =>
                            let __selfhost_empty = none
                _ =>
                    none
            Ok(ResolvedType__Unknown)
        Await(inner, _) =>
            scan_expr(ctx, env, inner)
        _ =>
            Ok(ResolvedType__Unknown)

fn collect_locals(block: &Block) -> Map<String, ResolvedType>:
    let mut locals = std__collections__HashMap__new_()
    collect_locals_recursive(block, &mut locals)
    locals

fn collect_locals_recursive(block: &Block, locals: &mut Map<String, ResolvedType>):
    for stmt in &block.stmts:
        match stmt:
            _ =>
                collect_from_pattern(pattern, locals)
            _ =>
                collect_locals_recursive(body, locals)
            _ =>
                collect_locals_recursive(body, locals)
            Expr(Block(b, _)) =>
                collect_locals_recursive(b, locals)
            Expr(_) =>
                collect_locals_recursive(then_branch, locals)
                match else_branch:
                    Some(b) =>
                        collect_from_else(b, locals)
                    _ =>
                        none
            _ =>
                let __selfhost_empty = none

fn collect_from_else(branch: &ElseBranch, locals: &mut Map<String, ResolvedType>):
    match branch:
        Else(block) =>
            collect_locals_recursive(block, locals)
        ElseIf(_, block, next) =>
            collect_locals_recursive(block, locals)
            match next:
                Some(n) =>
                    collect_from_else(n, locals)
                _ =>
                    none

fn collect_from_pattern(pattern: &Pattern, locals: &mut Map<String, ResolvedType>):
    match pattern:
        _ =>
            locals.insert(name.clone(), ResolvedType__Unknown)
        Tuple(pats, _) =>
            for p in pats:
                collect_from_pattern(p, locals)
        _ =>
            for p in patterns:
                collect_from_pattern(p, locals)
            match rest:
                Some(r) =>
                    locals.insert(r.clone(), ResolvedType__Unknown)
                _ =>
                    none
        _ =>
            for _item in fields:
                collect_from_pattern(p, locals)
        _ =>
            match fields:
                Tuple(pats) =>
                    for p in pats:
                        collect_from_pattern(p, locals)
                Struct(pats) =>
                    for _item in pats:
                        collect_from_pattern(p, locals)
                _ =>
                    let __selfhost_empty = none
        Or(pats, _) =>
            for p in pats:
                collect_from_pattern(p, locals)
        _ =>
            let __selfhost_empty = none

const MAX_ERRORS: usize = 50

const RESERVED_KEYWORDS: &[&String] = &["fn", "let", "mut", "var", "const", "if", "else", "elif", "match", "for", "while", "loop", "break", "continue", "return", "await", "in", "with", "as", "type", "struct", "enum", "trait", "impl", "pub", "mod", "use", "self", "Self", "true", "false", "none", "component", "actor", "spawn", "send", "receive", "emit", "comptime", "macro", "vertex", "fragment", "test", "Pure", "IO", "async", "Async", "GPU", "Reactive", "Unsafe", "line", "compile", "pass", "technique", "register", "packoffset", "typedef", "sampler", "row_major", "column_major", "out", "inout", "inline", "cbuffer", "tbuffer", "uniform", "precise", "volatile", "extern", "shared", "groupshared", "half", "min16float", "min10float", "min16int", "min12int", "min16uint", "interface", "namespace", "static", "void", "bool", "int", "uint", "float", "double", "float2", "float3", "float4", "int2", "int3", "int4", "uint2", "uint3", "uint4", "float2x2", "float3x3", "float4x4", "matrix", "numthreads", "SV_Position", "SV_Target", "SV_DispatchThreadID", "SV_GroupID", "SV_GroupThreadID", "class", "virtual", "override", "final", "explicit", "operator", "template", "typename", "private", "protected", "public", "friend", "this", "new", "delete", "nullptr", "try", "catch", "throw", "noexcept", "constexpr", "decltype", "auto", "signed", "unsigned", "short", "long", "char", "wchar_t", "char16_t", "char32_t", "sizeof", "alignof", "alignas", "typeid", "dynamic_cast", "static_cast", "reinterpret_cast", "const_cast", "goto", "switch", "case", "default", "do", "volatile", "mutable", "register", "union", "asm", "export", "thread_local", "static_assert", "UCLASS", "USTRUCT", "UENUM", "UFUNCTION", "UPROPERTY", "UPARAM", "UMETA", "GENERATED_BODY", "GENERATED_USTRUCT_BODY", "GENERATED_UCLASS_BODY", "UINTERFACE", "RIGVM_METHOD", "FORCEINLINE", "FORCENOINLINE", "TEXT", "LOCTEXT", "NSLOCTEXT", "TEXTVIEW"]

struct Parser:
    tokens: &[crate::lexer::Token]
    pos: usize
    injected_tokens: Array<crate::lexer::Token>
    span_mapper: &crate::diagnostics::SpanMapper
    filename: &String
    capabilities: crate::language_features::LanguageCapabilities
    errors: Array<crate::error::KainError>
    synthetic_counter: usize

impl Parser:
    fn new_(tokens: &[crate::lexer::Token], span_mapper: &crate::diagnostics::SpanMapper, filename: &String) -> Self_:
        Self___with_capabilities(tokens, span_mapper, filename, crate__language_features__default_language_capabilities())

    fn with_capabilities(tokens: &[crate::lexer::Token], span_mapper: &crate::diagnostics::SpanMapper, filename: &String, capabilities: crate::language_features::LanguageCapabilities) -> Self_:
        aggregate_init("Self_", tokens = tokens, pos = 0, injected_tokens = Vec__new_(), span_mapper = span_mapper, filename = filename, capabilities = capabilities, errors = Vec__new_(), synthetic_counter = 0)

    fn parser_error(_self: &Self_, message: impl Into<String>, span: crate::span::Span) -> crate::error::KainError:
        let loc = _self.span_mapper.span_to_location(span, _self.filename)
        let formatted_message = f"{loc.file}:{loc.line_}:{loc.col}: {message.into()}"
        crate__error__KainError__parser(formatted_message, span)

    fn token_to_user_string(_self: &Self_, kind: &crate::lexer::TokenKind) -> String:
        match kind:
            Ident(s) =>
                f"identifier '{s}'"
            Int(n) =>
                f"integer {n}"
            Float(f) =>
                f"float {f}"
            String(s) =>
                f"string \"{s}\""
            Fn =>
                "keyword 'fn'".to_string()
            Let =>
                "keyword 'let'".to_string()
            Struct =>
                "keyword 'struct'".to_string()
            Enum =>
                "keyword 'enum'".to_string()
            Actor =>
                "keyword 'actor'".to_string()
            Component =>
                "keyword 'component'".to_string()
            Shader =>
                "keyword 'shader'".to_string()
            If =>
                "keyword 'if'".to_string()
            Else =>
                "keyword 'else'".to_string()
            Match =>
                "keyword 'match'".to_string()
            Return =>
                "keyword 'return'".to_string()
            Colon =>
                "':'".to_string()
            Arrow =>
                "'->'".to_string()
            Eq =>
                "'='".to_string()
            LParen =>
                "'('".to_string()
            RParen =>
                "')'".to_string()
            LBrace =>
                "'{'".to_string()
            RBrace =>
                "'}'".to_string()
            LBracket =>
                "'['".to_string()
            RBracket =>
                "']'".to_string()
            Comma =>
                "','".to_string()
            Dot =>
                "'.'".to_string()
            At =>
                "'@'".to_string()
            Indent =>
                "indentation".to_string()
            Dedent =>
                "dedentation".to_string()
            Newline(_) =>
                "newline".to_string()
            Eof =>
                "end of file".to_string()
            _ =>
                kind

    fn expected_tokens_list(_self: &Self_, expected: &[&String]) -> String:
        match expected.len():
            0 =>
                "something else".to_string()
            1 =>
                expected[0].to_string()
            2 =>
                f"{expected[0]} or {expected[1]}"
            _ =>
                let last = expected.last().unwrap()
                let rest = &slice(expected, none, (expected.len() - 1))
                "{rest.join(\", \")}, or {last}"

    fn validate_identifier(_self: &Self_, name: &String, span: crate::span::Span) -> Result<(), Error>:
        if RESERVED_KEYWORDS.contains(&name):
            return Err(_self.parser_error(f"Identifier '{name}' conflicts with reserved keyword. Please choose a different name.\nReserved keywords include KAIN keywords (fn, let, struct, etc.), HLSL keywords (cbuffer, register, etc.), C++ keywords (class, virtual, etc.), and UE5 macros (UCLASS, UPROPERTY, etc.)", span))
        Ok(none)

    fn parse(_self: &mut Self_) -> Result<Program, Error>:
        let mut items = Vec__new_()
        let mut top_level_stmts = Vec__new_()
        let start = _self.current_span()
        while (!_self.at_end()):
            if (_self.errors.len() >= MAX_ERRORS):
                break
            _self.skip_newlines()
            if _self.at_end():
                break
            match _self.peek_kind():
                Pub =>
                    let before_pos = _self.pos
                    match _self.parse_item():
                        Ok(item) =>
                            items.push(item)
                        Err(e) =>
                            _self.errors.push(e)
                            _self.synchronize()
                            if ((_self.pos == before_pos) && (!_self.at_end())):
                                _self.advance()
                _ =>
                    let before_pos = _self.pos
                    match _self.parse_stmt():
                        Ok(stmt) =>
                            top_level_stmts.push(stmt)
                        Err(e) =>
                            _self.errors.push(e)
                            _self.synchronize()
                            if ((_self.pos == before_pos) && (!_self.at_end())):
                                _self.advance()
        if (!top_level_stmts.is_empty()):
            let main_fn = Item__Function(aggregate_init("Function", name = "main".to_string(), generics = [], params = [], return_type = None, effects = [], body = aggregate_init("Block", stmts = top_level_stmts, span = start.merge(_self.current_span())), visibility = Visibility__Public, attributes = [], span = start.merge(_self.current_span())))
            items.push(main_fn)
        if (!_self.errors.is_empty()):
            return Err(crate__error__KainError__multi(std__mem__take(&mut _self.errors)))
        let end = _self.current_span()
        Ok(aggregate_init("Program", items = items, span = start.merge(end)))

    fn synchronize(_self: &mut Self_):
        let mut depth: i32 = 0
        while (!_self.at_end()):
            match _self.peek_kind():
                Indent =>
                    (depth + 1)
                    _self.advance()
                Dedent =>
                    (depth + 1)
                    _self.advance()
                    if (depth <= 0):
                        _self.skip_newlines()
                        if (_self.is_item_start() || _self.at_end()):
                            return
                Newline(_) =>
                    _self.advance()
                    if (depth <= 0):
                        if (_self.is_item_start() || _self.at_end()):
                            return
                _ =>
                    if ((depth <= 0) && _self.is_item_start()):
                        return
                    _self.advance()

    fn is_item_start(_self: &Self_) -> Bool:
        match _self.peek_kind():
            At =>
                true
            _ =>
                false

    fn parse_item(_self: &mut Self_) -> Result<Item, Error>:
        let attributes = _self.parse_attributes()?
        if attributes.iter().any(none):
            return _self.parse_material_graph(attributes)
        if attributes.iter().any(none):
            return _self.parse_material_function(attributes)
        if attributes.iter().any(none):
            return _self.parse_graph_editor(attributes)
        if attributes.iter().any(none):
            return _self.parse_graph_runtime(attributes)
        if attributes.iter().any(none):
            return _self.parse_state_machine(attributes)
        if attributes.iter().any(none):
            return _self.parse_editor_module(attributes)
        if attributes.iter().any(none):
            return _self.parse_gameplay_tags(attributes)
        if attributes.iter().any(none):
            return _self.parse_gameplay_ability(attributes)
        if attributes.iter().any(none):
            return _self.parse_gameplay_effect(attributes)
        if attributes.iter().any(none):
            return _self.parse_gameplay_cue(attributes)
        if attributes.iter().any(none):
            return _self.parse_ability_task(attributes)
        if attributes.iter().any(none):
            return _self.parse_target_actor(attributes)
        let vis = _self.parse_visibility()
        match _self.peek_kind():
            Fn =>
                _self.parse_function_with_attrs(vis, attributes)
            AsyncKw =>
                _self.parse_async_function(vis)
            Component =>
                _self.parse_component_with_attrs(vis, attributes)
            Shader =>
                _self.parse_shader()
            Struct =>
                _self.parse_struct_with_attrs(vis, attributes)
            Enum =>
                _self.parse_enum(vis)
            Actor =>
                _self.parse_actor_with_attrs(attributes)
            Const =>
                _self.parse_const(vis)
            Comptime =>
                _self.parse_comptime_block()
            Macro =>
                _self.parse_macro()
            Test =>
                _self.parse_test()
            Mod =>
                _self.parse_mod(vis)
            Use =>
                _self.parse_use()
            Trait =>
                _self.parse_trait(vis)
            Impl =>
                _self.parse_impl()
            TypeKw =>
                _self.parse_type_alias(vis)
            _ =>
                Err(_self.parser_error(f"Expected item (fn, struct, enum, actor, component, shader, material, trait, impl, mod, use, const, test), found {_self.token_to_user_string(&_self.peek_kind())}", _self.current_span()))

    fn parse_mod(_self: &mut Self_, vis: Visibility) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Mod)?
        let name = _self.parse_ident()?
        let inline_ = if _self.check(crate__lexer__TokenKind__Colon):
            _self.advance()
            _self.skip_newlines()
            if (!_self.check(crate__lexer__TokenKind__Indent)):
                Some([])
            else:
                _self.expect(crate__lexer__TokenKind__Indent)?
                let mut items = Vec__new_()
                while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
                    _self.skip_newlines()
                    if _self.check(crate__lexer__TokenKind__Dedent):
                        break
                    items.push(_self.parse_item()?)
                    _self.skip_newlines()
                _self.expect(crate__lexer__TokenKind__Dedent)?
                Some(items)
        else:
            None
        Ok(Item__Mod(aggregate_init("Mod", name = name, inline_ = inline_, visibility = vis, span = start.merge(_self.current_span()))))

    fn parse_attributes(_self: &mut Self_) -> Result<Array<Attribute>, Error>:
        let mut attrs = Vec__new_()
        while _self.check(crate__lexer__TokenKind__At):
            let start = _self.current_span()
            _self.advance()
            let name = _self.parse_attribute_name()?
            let args = if _self.check(crate__lexer__TokenKind__LParen):
                _self.advance()
                let mut arg_list = Vec__new_()
                while ((!_self.check(crate__lexer__TokenKind__RParen)) && (!_self.at_end())):
                    match _self.peek_kind():
                        Ident(param_name) =>
                            let saved_pos = _self.pos
                            _self.advance()
                            if _self.check(crate__lexer__TokenKind__Colon):
                                _self.advance()
                                let value = _self.parse_expr()?
                                let name_expr = Expr__Ident(param_name.clone(), _self.current_span())
                                arg_list.push(Expr__Tuple([name_expr, value], _self.current_span()))
                            else:
                                _self.pos = saved_pos
                                arg_list.push(_self.parse_expr()?)
                        _ =>
                            arg_list.push(_self.parse_expr()?)
                    if (!_self.check(crate__lexer__TokenKind__RParen)):
                        _self.expect(crate__lexer__TokenKind__Comma)?
                _self.expect(crate__lexer__TokenKind__RParen)?
                arg_list
            else:
                []
            attrs.push(aggregate_init("Attribute", name = name, args = args, span = start.merge(_self.current_span())))
            _self.skip_newlines()
        Ok(attrs)

    fn parse_attribute_name(_self: &mut Self_) -> Result<String, Error>:
        match _self.peek_kind():
            Ident(s) =>
                _self.advance()
                Ok(s)
            Component =>
                _self.advance()
                Ok("component".to_string())
            Shader =>
                _self.advance()
                Ok("shader".to_string())
            Actor =>
                _self.advance()
                Ok("actor".to_string())
            State =>
                _self.advance()
                Ok("state".to_string())
            AsyncKw =>
                _self.advance()
                Ok("async".to_string())
            Async_ =>
                _self.advance()
                Ok("Async".to_string())
            Gpu =>
                _self.advance()
                Ok("GPU".to_string())
            Reactive_ =>
                _self.advance()
                Ok("Reactive".to_string())
            k =>
                Err(_self.parser_error(f"Expected attribute name, got {crate__error__token_kind_to_user_string(&k)}", _self.current_span()))

    fn parse_trait(_self: &mut Self_, vis: Visibility) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Trait)?
        let name = _self.parse_ident()?
        let generics = _self.parse_generics()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut methods = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            _self.expect(crate__lexer__TokenKind__Fn)?
            let method_name = _self.parse_ident()?
            _self.expect(crate__lexer__TokenKind__LParen)?
            let params = _self.parse_params()?
            _self.expect(crate__lexer__TokenKind__RParen)?
            let return_type = if _self.check(crate__lexer__TokenKind__Arrow):
                _self.advance()
                Some(_self.parse_type()?)
            else:
                None
            let effects = _self.parse_effects()?
            let default_impl = if _self.check(crate__lexer__TokenKind__Colon):
                _self.advance()
                Some(_self.parse_block()?)
            else:
                None
            methods.push(aggregate_init("TraitMethod", name = method_name, params = params, return_type = return_type, effects = effects, default_impl = default_impl, span = _self.current_span()))
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(Item__Trait(aggregate_init("Trait", name = name, generics = generics, methods = methods, visibility = vis, span = start.merge(_self.current_span()))))

    fn parse_impl(_self: &mut Self_) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Impl)?
        let generics = _self.parse_generics()?
        let trait_name = if (none):
            let saved_pos = _self.pos
            let potential_trait = _self.parse_ident()?
            if _self.check(crate__lexer__TokenKind__For):
                _self.advance()
                Some(potential_trait)
            else:
                _self.pos = saved_pos
                None
        else:
            None
        let target_type = _self.parse_type()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut methods = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let vis = _self.parse_visibility()
            if _self.check(crate__lexer__TokenKind__Fn):
                match (_self.parse_function(vis)?):
                    Function(f) =>
                        methods.push(f)
                    _ =>
                        none
            else:
                return Err(_self.parser_error(f"Expected 'fn' in impl block (impl blocks can only contain function definitions), found {_self.token_to_user_string(&_self.peek_kind())}", _self.current_span()))
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(Item__Impl(aggregate_init("Impl", generics = generics, trait_name = trait_name, target_type = target_type, methods = methods, span = start.merge(_self.current_span()))))

    fn parse_use(_self: &mut Self_) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Use)?
        let mut path = Vec__new_()
        path.push(_self.parse_ident()?)
        while (_self.check(crate__lexer__TokenKind__ColonColon) || _self.check(crate__lexer__TokenKind__Slash)):
            _self.advance()
            if _self.check(crate__lexer__TokenKind__Star):
                _self.advance()
                return Ok(Item__Use(aggregate_init("Use", path = path, alias = None, glob = true, span = start.merge(_self.current_span()))))
            path.push(_self.parse_ident()?)
        let alias = if _self.check(crate__lexer__TokenKind__As):
            _self.advance()
            Some(_self.parse_ident()?)
        else:
            None
        Ok(Item__Use(aggregate_init("Use", path = path, alias = alias, glob = false, span = start.merge(_self.current_span()))))

    fn parse_test(_self: &mut Self_) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Test)?
        let name = match _self.peek_kind():
            String(s) =>
                _self.advance()
                s
            _ =>
                _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        let body = _self.parse_block()?
        Ok(Item__Test(aggregate_init("TestDef", name = name, body = body, span = start.merge(_self.current_span()))))

    fn parse_macro(_self: &mut Self_) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Macro)?
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Not)?
        _self.expect(crate__lexer__TokenKind__LParen)?
        let mut params = Vec__new_()
        while (!_self.check(crate__lexer__TokenKind__RParen)):
            let p_name = _self.parse_ident()?
            _self.expect(crate__lexer__TokenKind__Colon)?
            let kind_name = _self.parse_ident()?
            let kind = match kind_name.as_str():
                "expr" =>
                    MacroParamKind__Expr
                "type" =>
                    MacroParamKind__Type
                "ident" =>
                    MacroParamKind__Ident
                "block" =>
                    MacroParamKind__Block
                "token" =>
                    MacroParamKind__Token
                _ =>
                    return Err(_self.parser_error("Unknown macro param kind", _self.current_span()))
            params.push(aggregate_init("MacroParam", name = p_name, kind = kind, span = _self.current_span()))
            if (!_self.check(crate__lexer__TokenKind__RParen)):
                _self.expect(crate__lexer__TokenKind__Comma)?
        _self.expect(crate__lexer__TokenKind__RParen)?
        _self.expect(crate__lexer__TokenKind__Colon)?
        let body = _self.parse_block()?
        Ok(Item__Macro(aggregate_init("MacroDef", name = name, params = params, body = MacroBody__Block(body), span = start.merge(_self.current_span()))))

    fn parse_function(_self: &mut Self_, vis: Visibility) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Fn)?
        let name = _self.parse_ident()?
        let generics = _self.parse_generics()?
        _self.expect(crate__lexer__TokenKind__LParen)?
        let params = _self.parse_params()?
        _self.expect(crate__lexer__TokenKind__RParen)?
        let return_type = if _self.check(crate__lexer__TokenKind__Arrow):
            _self.advance()
            Some(_self.parse_type()?)
        else:
            None
        let effects = _self.parse_effects()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        let body = _self.parse_block()?
        let body_span = body.span
        Ok(Item__Function(aggregate_init("Function", name = name, generics = generics, params = params, return_type = return_type, effects = effects, body = body, visibility = vis, attributes = [], span = start.merge(body_span))))

    fn parse_function_with_attrs(_self: &mut Self_, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Fn)?
        let name = _self.parse_ident()?
        let generics = _self.parse_generics()?
        _self.expect(crate__lexer__TokenKind__LParen)?
        let params = _self.parse_params()?
        _self.expect(crate__lexer__TokenKind__RParen)?
        let return_type = if _self.check(crate__lexer__TokenKind__Arrow):
            _self.advance()
            Some(_self.parse_type()?)
        else:
            None
        let effects = _self.parse_effects()?
        let is_extern = attrs.iter().any(none)
        let body = if (is_extern && (!_self.check(crate__lexer__TokenKind__Colon))):
            aggregate_init("Block", stmts = [], span = _self.current_span())
        else:
            _self.expect(crate__lexer__TokenKind__Colon)?
            _self.parse_block()?
        let body_span = body.span
        Ok(Item__Function(aggregate_init("Function", name = name, generics = generics, params = params, return_type = return_type, effects = effects, body = body, visibility = vis, attributes = attrs, span = start.merge(body_span))))

    fn parse_async_function(_self: &mut Self_, vis: Visibility) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__AsyncKw)?
        _self.expect(crate__lexer__TokenKind__Fn)?
        let name = _self.parse_ident()?
        let generics = _self.parse_generics()?
        _self.expect(crate__lexer__TokenKind__LParen)?
        let params = _self.parse_params()?
        _self.expect(crate__lexer__TokenKind__RParen)?
        let return_type = if _self.check(crate__lexer__TokenKind__Arrow):
            _self.advance()
            Some(_self.parse_type()?)
        else:
            None
        let mut effects = _self.parse_effects()?
        effects.push(crate__effects__Effect__Async_)
        _self.expect(crate__lexer__TokenKind__Colon)?
        let body = _self.parse_block()?
        let body_span = body.span
        Ok(Item__Function(aggregate_init("Function", name = name, generics = generics, params = params, return_type = return_type, effects = effects, body = body, visibility = vis, attributes = [], span = start.merge(body_span))))

    fn parse_component(_self: &mut Self_, vis: Visibility) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Component)?
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__LParen)?
        let props = _self.parse_params()?
        _self.expect(crate__lexer__TokenKind__RParen)?
        let effects = _self.parse_effects()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut state_ = Vec__new_()
        let mut methods = Vec__new_()
        let mut body = None
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            if _self.check(crate__lexer__TokenKind__Fn):
                match (_self.parse_function(Visibility__Private)?):
                    Function(f) =>
                        methods.push(f)
                    _ =>
                        none
            elif _self.check(crate__lexer__TokenKind__State):
                _self.advance()
                let name = _self.parse_ident()?
                _self.expect(crate__lexer__TokenKind__Colon)?
                let ty = _self.parse_type()?
                _self.expect(crate__lexer__TokenKind__Eq)?
                let initial = _self.parse_expr()?
                state_.push(aggregate_init("StateDecl", name = name, ty = ty, initial = initial, weak_ = false, attributes = [], span = _self.current_span()))
            else:
                match _self.peek_kind():
                    Ident(s) =>
                        if (s == "state"):
                            _self.advance()
                            let name = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            let ty = _self.parse_type()?
                            _self.expect(crate__lexer__TokenKind__Eq)?
                            let initial = _self.parse_expr()?
                            state_.push(aggregate_init("StateDecl", name = name, ty = ty, initial = initial, weak_ = false, attributes = [], span = _self.current_span()))
                        elif (s == "weak"):
                            _self.advance()
                            if (_self.check(crate__lexer__TokenKind__State) || _self.check(crate__lexer__TokenKind__Ident("state".to_string()))):
                                _self.advance()
                                let name = _self.parse_ident()?
                                _self.expect(crate__lexer__TokenKind__Colon)?
                                let ty = _self.parse_type()?
                                _self.expect(crate__lexer__TokenKind__Eq)?
                                let initial = _self.parse_expr()?
                                state_.push(aggregate_init("StateDecl", name = name, ty = ty, initial = initial, weak_ = true, attributes = [], span = _self.current_span()))
                            else:
                                return Err(_self.parser_error(f"Expected 'state' keyword after 'weak' in component (use 'weak state name: Type = value'), found {_self.token_to_user_string(&_self.peek_kind())}", _self.current_span()))
                        elif (s == "render"):
                            _self.advance()
                            if _self.check(crate__lexer__TokenKind__LBrace):
                                _self.advance()
                                _self.skip_newlines()
                                body = Some(_self.parse_jsx_element()?)
                                _self.skip_newlines()
                                _self.expect(crate__lexer__TokenKind__RBrace)?
                            elif _self.check(crate__lexer__TokenKind__Colon):
                                _self.advance()
                                _self.skip_newlines()
                                _self.expect(crate__lexer__TokenKind__Indent)?
                                _self.skip_newlines()
                                body = Some(_self.parse_jsx_element()?)
                                _self.skip_newlines()
                                _self.expect(crate__lexer__TokenKind__Dedent)?
                            else:
                                body = Some(_self.parse_jsx_element()?)
                        else:
                            return Err(_self.parser_error(f"Unexpected identifier '{s}' in component. Valid keywords: 'state', 'weak', 'render', or 'fn' for methods", _self.current_span()))
                    _ =>
                        if _self.check(crate__lexer__TokenKind__Lt):
                            body = Some(_self.parse_jsx_element()?)
                        else:
                            return Err(_self.parser_error(f"Unexpected token in component: {crate__error__token_kind_to_user_string(&_self.peek_kind())}. Expected 'state', 'weak', 'render', 'fn', or JSX element", _self.current_span()))
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        let body = body.ok_or_else(none)?
        Ok(Item__Component(aggregate_init("Component", name = name, props = props, state_ = state_, methods = methods, effects = effects, body = body, visibility = vis, attributes = [], span = start.merge(_self.current_span()))))

    fn parse_component_with_attrs(_self: &mut Self_, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Component)?
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__LParen)?
        let props = _self.parse_params()?
        _self.expect(crate__lexer__TokenKind__RParen)?
        let effects = _self.parse_effects()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut state_ = Vec__new_()
        let mut methods = Vec__new_()
        let mut body = None
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            if _self.check(crate__lexer__TokenKind__Fn):
                match (_self.parse_function(Visibility__Private)?):
                    Function(f) =>
                        methods.push(f)
                    _ =>
                        none
            else:
                match _self.peek_kind():
                    Ident(s) =>
                        if (s == "state"):
                            _self.advance()
                            let name = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            let ty = _self.parse_type()?
                            _self.expect(crate__lexer__TokenKind__Eq)?
                            let initial = _self.parse_expr()?
                            state_.push(aggregate_init("StateDecl", name = name, ty = ty, initial = initial, weak_ = false, attributes = [], span = _self.current_span()))
                        elif (s == "render"):
                            _self.advance()
                            if _self.check(crate__lexer__TokenKind__Colon):
                                _self.advance()
                                _self.skip_newlines()
                                _self.expect(crate__lexer__TokenKind__Indent)?
                                _self.skip_newlines()
                                body = Some(_self.parse_jsx_element()?)
                                _self.skip_newlines()
                                _self.expect(crate__lexer__TokenKind__Dedent)?
                            else:
                                body = Some(_self.parse_jsx_element()?)
                        else:
                            return Err(_self.parser_error(f"Unexpected identifier in component: {s}", _self.current_span()))
                    _ =>
                        if _self.check(crate__lexer__TokenKind__State):
                            _self.advance()
                            let name = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            let ty = _self.parse_type()?
                            _self.expect(crate__lexer__TokenKind__Eq)?
                            let initial = _self.parse_expr()?
                            state_.push(aggregate_init("StateDecl", name = name, ty = ty, initial = initial, weak_ = false, attributes = [], span = _self.current_span()))
                        elif _self.check(crate__lexer__TokenKind__Lt):
                            body = Some(_self.parse_jsx_element()?)
                        else:
                            return Err(_self.parser_error(f"Unexpected token in component: {crate__error__token_kind_to_user_string(&_self.peek_kind())}", _self.current_span()))
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        let body = body.ok_or_else(none)?
        Ok(Item__Component(aggregate_init("Component", name = name, props = props, state_ = state_, methods = methods, effects = effects, body = body, visibility = vis, attributes = attrs, span = start.merge(_self.current_span()))))

    fn parse_shader(_self: &mut Self_) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Shader)?
        let stage = if _self.check(crate__lexer__TokenKind__Vertex):
            _self.advance()
            ShaderStage__Vertex
        elif _self.check(crate__lexer__TokenKind__Fragment):
            _self.advance()
            ShaderStage__Fragment
        else:
            match _self.peek_kind():
                Ident(s) =>
                    if (s == "compute"):
                        _self.advance()
                        ShaderStage__Compute
                    else:
                        ShaderStage__Fragment
                _ =>
                    ShaderStage__Fragment
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__LParen)?
        let inputs = _self.parse_params()?
        _self.expect(crate__lexer__TokenKind__RParen)?
        _self.expect(crate__lexer__TokenKind__Arrow)?
        let outputs = _self.parse_type()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        let block_start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut uniforms = Vec__new_()
        let mut stmts = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let is_uniform = match _self.peek_kind():
                Ident(s) =>
                    (s == "uniform")
                _ =>
                    false
            if is_uniform:
                _self.advance()
                let u_name = _self.parse_ident()?
                _self.expect(crate__lexer__TokenKind__Colon)?
                let u_ty = _self.parse_type()?
                _self.expect(crate__lexer__TokenKind__At)?
                let binding = match _self.peek_kind():
                    Int(n) =>
                        _self.advance()
                        n as u32
                    _ =>
                        return Err(_self.parser_error(f"Expected integer binding after '@' (e.g., '@0', '@1', '@2'), found {_self.token_to_user_string(&_self.peek_kind())}", _self.current_span()))
                uniforms.push(aggregate_init("Uniform", name = u_name, ty = u_ty, binding = binding, span = _self.current_span()))
            else:
                stmts.push(_self.parse_stmt()?)
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        let body = aggregate_init("Block", stmts = stmts, span = block_start.merge(_self.current_span()))
        let body_span = body.span
        Ok(Item__Shader(aggregate_init("Shader", name = name, stage = stage, inputs = inputs, outputs = outputs, uniforms = uniforms, body = body, span = start.merge(body_span))))

    fn parse_struct_with_attrs(_self: &mut Self_, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Struct)?
        let name = _self.parse_ident()?
        let generics = _self.parse_generics()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        let mut fields = Vec__new_()
        let mut methods = Vec__new_()
        if (!_self.check(crate__lexer__TokenKind__Indent)):
            return Ok(Item__Struct(aggregate_init("Struct", name = name, generics = generics, fields = fields, methods = methods, attributes = attrs, visibility = vis, span = start.merge(_self.current_span()))))
        _self.expect(crate__lexer__TokenKind__Indent)?
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let f_attrs = _self.parse_attributes()?
            if _self.check(crate__lexer__TokenKind__Fn):
                match (_self.parse_function(Visibility__Public)?):
                    Function(f) =>
                        methods.push(f)
                    _ =>
                        none
                _self.skip_newlines()
                continue
            let weak_ = match _self.peek_kind():
                Ident(s) =>
                    if (s == "weak"):
                        _self.advance()
                        true
                    else:
                        false
                _ =>
                    false
            let fname = _self.parse_ident()?
            _self.expect(crate__lexer__TokenKind__Colon)?
            let ty = _self.parse_type()?
            let default_ = if _self.check(crate__lexer__TokenKind__Eq):
                _self.advance()
                Some(_self.parse_expr()?)
            else:
                None
            fields.push(aggregate_init("Field", name = fname, ty = ty, attributes = f_attrs, visibility = Visibility__Public, default_ = default_, weak_ = weak_, span = _self.current_span()))
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(Item__Struct(aggregate_init("Struct", name = name, generics = generics, fields = fields, methods = methods, attributes = attrs, visibility = vis, span = start.merge(_self.current_span()))))

    fn parse_enum(_self: &mut Self_, vis: Visibility) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Enum)?
        let name = _self.parse_ident()?
        let generics = _self.parse_generics()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut variants = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let start_span = _self.current_span()
            let vname = _self.parse_ident()?
            let fields = if _self.check(crate__lexer__TokenKind__LParen):
                _self.advance()
                let mut types = Vec__new_()
                while ((!_self.check(crate__lexer__TokenKind__RParen)) && (!_self.at_end())):
                    types.push(_self.parse_type()?)
                    if (!_self.check(crate__lexer__TokenKind__RParen)):
                        _self.expect(crate__lexer__TokenKind__Comma)?
                _self.expect(crate__lexer__TokenKind__RParen)?
                VariantFields__Tuple(types)
            elif _self.check(crate__lexer__TokenKind__LBrace):
                _self.advance()
                _self.skip_newlines()
                let indented = if _self.check(crate__lexer__TokenKind__Indent):
                    _self.advance()
                    true
                else:
                    false
                let mut fields = Vec__new_()
                while ((!_self.check(crate__lexer__TokenKind__RBrace)) && (!_self.at_end())):
                    if (indented && _self.check(crate__lexer__TokenKind__Dedent)):
                        break
                    if ((!indented) && _self.check(crate__lexer__TokenKind__RBrace)):
                        break
                    _self.skip_newlines()
                    if (_self.check(crate__lexer__TokenKind__RBrace) || ((indented && _self.check(crate__lexer__TokenKind__Dedent)))):
                        break
                    let f_attrs = _self.parse_attributes()?
                    let fname = _self.parse_ident()?
                    _self.expect(crate__lexer__TokenKind__Colon)?
                    let ty = _self.parse_type()?
                    fields.push(aggregate_init("Field", name = fname, ty = ty, attributes = f_attrs, visibility = Visibility__Public, default_ = None, weak_ = false, span = _self.current_span()))
                    if (!_self.check(crate__lexer__TokenKind__RBrace)):
                        if _self.check(crate__lexer__TokenKind__Comma):
                            _self.advance()
                    _self.skip_newlines()
                if indented:
                    _self.expect(crate__lexer__TokenKind__Dedent)?
                _self.expect(crate__lexer__TokenKind__RBrace)?
                VariantFields__Struct(fields)
            else:
                VariantFields__Unit
