    let roots = crate__stdlib__find_stdlib_search_roots()
    std__env__remove_var("KAIN_STDLIB_PATH")
    if (roots.len() != 1):
        panic("Should find exactly one root with env var")
    if (roots[0] != test_dir.path().join("stdlib")):
        panic("assert_eq! failed")

