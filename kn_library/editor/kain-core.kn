fn eval_program(program: &mut Program) -> Result<(), Error>:
    let mut env = crate__runtime__Env__new_()
    for item in &mut program.items:
        eval_item(&mut env, item)?
    Ok(none)

fn eval_program(_program: &mut Program) -> Result<(), Error>:
    Ok(none)

fn eval_item(env: &mut crate::runtime::Env, item: &mut Item) -> Result<(), Error>:
    match item:
        Function(f) =>
            eval_block(env, &mut f.body)?
        Comptime(block) =>
            crate__runtime__eval_block(env, &block.body)?
        Component(c) =>
            eval_jsx(env, &mut c.body)?
            for method in &mut c.methods:
                eval_block(env, &mut method.body)?
        Const(c) =>
            eval_expr_in_place(env, &mut c.value)?
        _ =>
            let __selfhost_empty = none
    Ok(none)

fn eval_block(env: &mut crate::runtime::Env, block: &mut Block) -> Result<(), Error>:
    for stmt in &mut block.stmts:
        eval_stmt(env, stmt)?
    Ok(none)

fn eval_stmt(env: &mut crate::runtime::Env, stmt: &mut Stmt) -> Result<(), Error>:
    match stmt:
        _ =>
            eval_expr_in_place(env, e)?
        Expr(e) =>
            eval_expr_in_place(env, e)?
        Return(Some(e), _) =>
            eval_expr_in_place(env, e)?
        _ =>
            eval_expr_in_place(env, iter)?
            eval_block(env, body)?
        _ =>
            let __selfhost_empty = none
    Ok(none)

fn eval_expr_in_place(env: &mut crate::runtime::Env, expr: &mut Expr) -> Result<(), Error>:
    match expr:
        Comptime(inner, span) =>
            let val = crate__runtime__eval_expr(env, inner)?
            (*expr) = value_to_expr(val, (*span))
            return Ok(none)
        _ =>
            none
    match expr:
        _ =>
            eval_expr_in_place(env, left)?
            eval_expr_in_place(env, right)?
        _ =>
            for arg in args:
                eval_expr_in_place(env, &mut arg.value)?
        _ =>
            eval_expr_in_place(env, value)?
        _ =>
            eval_expr_in_place(env, value)?
        _ =>
            eval_expr_in_place(env, pointer)?
        _ =>
            eval_expr_in_place(env, pointer)?
            eval_expr_in_place(env, value)?
        _ =>
            let __selfhost_empty = none
        _ =>
            for _item in fields:
                eval_expr_in_place(env, value)?
        _ =>
            eval_expr_in_place(env, size)?
        _ =>
            eval_expr_in_place(env, pointer)?
            eval_expr_in_place(env, size)?
        Paren(e, _) =>
            eval_expr_in_place(env, e)?
        Block(b, _) =>
            eval_block(env, b)?
        JSX(node, _) =>
            eval_jsx(env, node)?
        _ =>
            let __selfhost_empty = none
    Ok(none)

fn eval_jsx(env: &mut crate::runtime::Env, node: &mut JSXNode) -> Result<(), Error>:
    match node:
        _ =>
            for attr in attributes:
                match &mut attr.value:
                    Expr(e) =>
                        eval_expr_in_place(env, e)?
                    _ =>
                        none
            for child in children:
                eval_jsx(env, child)?
        Expression(e) =>
            eval_expr_in_place(env, e)?
        _ =>
            let __selfhost_empty = none
    Ok(none)

fn value_to_expr(val: crate::runtime::Value, span: crate::span::Span) -> Expr:
    match val:
        Int(n) =>
            Expr__Int(n, span)
        Float(n) =>
            Expr__Float(n, span)
        Bool(b) =>
            Expr__Bool(b, span)
        String(s) =>
            Expr__String(s, span)
        Unit =>
            Expr__Block(aggregate_init("Block", stmts = [], span = span), span)
        _ =>
            Expr__String(f"<unrepresentable comptime value: {val}>", span)

enum DiagnosticCode:
    ParseGeneric
    TypeGeneric
    ValidationGeneric
    CodegenGeneric
    IoGeneric
    ConfigGeneric
    EffectViolation
    BorrowGeneric
    RuntimeGeneric
    MemoryLoweringRequired
    MemoryUnsupportedBackend
    MemoryIllegalBitfieldAddress

struct DiagnosticSpec:
    code: DiagnosticCode
    code_str: &String
    title: &String
    docs_key: Option<&String>
    default_suggestion: Option<&String>

const DIAGNOSTIC_SPECS: &[DiagnosticSpec] = &[aggregate_init("DiagnosticSpec", code = DiagnosticCode__ParseGeneric, code_str = "KAIN-PARSE-0001", title = "Parse Error", docs_key = Some("parser/general"), default_suggestion = None), aggregate_init("DiagnosticSpec", code = DiagnosticCode__TypeGeneric, code_str = "KAIN-TYPE-0001", title = "Type Error", docs_key = Some("types/general"), default_suggestion = None), aggregate_init("DiagnosticSpec", code = DiagnosticCode__ValidationGeneric, code_str = "KAIN-VALIDATE-0001", title = "Validation Error", docs_key = Some("validation/general"), default_suggestion = None), aggregate_init("DiagnosticSpec", code = DiagnosticCode__CodegenGeneric, code_str = "KAIN-CODEGEN-0001", title = "Codegen Error", docs_key = Some("codegen/general"), default_suggestion = None), aggregate_init("DiagnosticSpec", code = DiagnosticCode__IoGeneric, code_str = "KAIN-IO-0001", title = "IO Error", docs_key = Some("io/general"), default_suggestion = None), aggregate_init("DiagnosticSpec", code = DiagnosticCode__ConfigGeneric, code_str = "KAIN-CONFIG-0001", title = "Config Error", docs_key = Some("config/general"), default_suggestion = None), aggregate_init("DiagnosticSpec", code = DiagnosticCode__EffectViolation, code_str = "KAIN-EFFECT-0001", title = "Effect Violation", docs_key = Some("effects/violation"), default_suggestion = Some("Align caller and callee effects, or move side effects behind a compatible boundary.")), aggregate_init("DiagnosticSpec", code = DiagnosticCode__BorrowGeneric, code_str = "KAIN-BORROW-0001", title = "Borrow Error", docs_key = Some("borrow/general"), default_suggestion = None), aggregate_init("DiagnosticSpec", code = DiagnosticCode__RuntimeGeneric, code_str = "KAIN-RUNTIME-0001", title = "Runtime Error", docs_key = Some("runtime/general"), default_suggestion = None), aggregate_init("DiagnosticSpec", code = DiagnosticCode__MemoryLoweringRequired, code_str = "KAIN-MEM-0001", title = "Memory Lowering Required", docs_key = Some("memory/lowering"), default_suggestion = Some("Add or select a lowering policy before targeting backends that do not support raw memory semantics directly.")), aggregate_init("DiagnosticSpec", code = DiagnosticCode__MemoryUnsupportedBackend, code_str = "KAIN-MEM-0002", title = "Memory Semantics Unsupported By Backend", docs_key = Some("memory/backend-capabilities"), default_suggestion = Some("Choose a backend with low-level memory support or lower pointers and raw storage into a backend-safe form first.")), aggregate_init("DiagnosticSpec", code = DiagnosticCode__MemoryIllegalBitfieldAddress, code_str = "KAIN-MEM-0003", title = "Illegal Bitfield Address", docs_key = Some("memory/bitfields"), default_suggestion = Some("Do not take the address of a C bitfield directly; lower it into a load/store/mask operation instead."))]

fn spec_for_code(code: DiagnosticCode) -> &DiagnosticSpec:
    DIAGNOSTIC_SPECS.iter().find(none).expect("diagnostic code must have a registry entry")

fn default_code_for_kind(kind: crate::error::ErrorKind) -> DiagnosticCode:
    match kind:
        Parse =>
            DiagnosticCode__ParseGeneric
        Type =>
            DiagnosticCode__TypeGeneric
        Validation =>
            DiagnosticCode__ValidationGeneric
        Codegen =>
            DiagnosticCode__CodegenGeneric
        Io =>
            DiagnosticCode__IoGeneric
        Config =>
            DiagnosticCode__ConfigGeneric

struct SourceLocation:
    file: &String
    line_: usize
    col: usize

impl SourceLocation:
    fn new_(file: &String, line_: usize, col: usize) -> Self_:
        aggregate_init("Self_", file = file, line_ = line_, col = col)


struct SpanMapper:
    source: String
    line_starts: Array<usize>

impl SpanMapper:
    fn new_(source: &String) -> Self_:
        let mut line_starts = [0]
        for _item in source.char_indices():
            if (ch == "\n"):
                line_starts.push((idx + 1))
        aggregate_init("SpanMapper", source = source.to_string(), line_starts = line_starts)

    fn span_to_location(_self: &Self_, span: crate::span::Span, file: &String) -> SourceLocation:
        if _self.line_starts.is_empty():
            return SourceLocation__new_(file, 1, 1)
        let start = span.start.min(_self.source.len())
        let line_idx = match _self.line_starts.binary_search(&start):
            Ok(idx) =>
                idx
            Err(idx) =>
                idx.saturating_sub(1)
        let line_start = _self.line_starts[line_idx]
        let col = start.saturating_sub(line_start)
        SourceLocation__new_(file, (line_idx + 1), (col + 1))

    fn source(_self: &Self_) -> &String:
        &_self.source


struct Diagnostics:
    source: &String
    filename: &String

impl Diagnostics:
    fn new_(source: &String, filename: &String) -> Self_:
        aggregate_init("Self_", source = source, filename = filename)

    fn format_error(_self: &Self_, error: &crate::error::KainError) -> String:
        match error:
            _ =>
                _self.format_with_context("Lexer Error", message, (*span))
            _ =>
                _self.format_with_context("Parse Error", message, (*span))
            _ =>
                _self.format_with_context("Type Error", message, (*span))
            _ =>
                _self.format_with_context("Effect Error", message, (*span))
            _ =>
                _self.format_with_context("Borrow Error", message, (*span))
            _ =>
                _self.format_with_context("Codegen Error", message, (*span))
            _ =>
                f"\n[1;31merror[Codegen][0m: {message}\n  [1;34m-->[0m {file}:{line_}:{col}\n"
            _ =>
                f"\n[1;31merror[0m: {message}\n"
            Io(e) =>
                f"\n[1;31merror[0m: IO error: {e}\n"
            _ =>
                f"\n{error}\n"
            Multi(errors) =>
                let mut output = f"\n[1;31merror[0m: {errors.len()} error(s) found:\n"
                for _item in errors.iter().enumerate():
                    output.push_str(&f"\n--- [{(i + 1)}/{errors.len()}] ---\n")
                    output.push_str(&_self.format_error(err))
                output

    fn format_with_context(_self: &Self_, error_type: &String, message: &String, span: crate::span::Span) -> String:
        let _ = _self.get_line_info(span)
        let mut output = String__new_()
        output.push_str(&f"\n[1;31merror[{error_type}][0m: {message}\n")
        output.push_str(&f"  [1;34m-->[0m {_self.filename}:{line_num}:{col}\n")
        output.push_str("   \u{1b}[1;34m|\u{1b}[0m\n")
        output.push_str(&f"[1;34m{line_num} |[0m {line_content}\n")
        let pointer_offset = col.saturating_sub(1)
        let content_len = line_content.len()
        let remaining_len = content_len.saturating_sub(pointer_offset)
        let span_len = span.end.saturating_sub(span.start)
        let pointer_len = span_len.min(remaining_len).max(1)
        output.push_str(&"   \u{1b}[1;34m|\u{1b}[0m {\" \".repeat(pointer_offset)}\u{1b}[1;31m{\"^\".repeat(pointer_len)}\u{1b}[0m\n")
        output.push_str("   \u{1b}[1;34m|\u{1b}[0m\n")
        output

    fn get_line_info(_self: &Self_, span: crate::span::Span) -> (usize, usize, &String):
        let mut line_num = 1
        let mut line_start = 0
        let start = span.start.min(_self.source.len())
        for _item in _self.source.char_indices():
            if (i >= start):
                break
            if (c == "\n"):
                (line_num + 1)
                line_start = (i + 1)
        let col = (start.saturating_sub(line_start) + 1)
        let line_end = if (start < _self.source.len()):
            slice(_self.source, start, none).find("\n").map(none).unwrap_or(_self.source.len())
        else:
            _self.source.len()
        let line_start = line_start.min(_self.source.len())
        let line_content = &slice(_self.source, line_start, line_end)
        (line_num, col, line_content)


fn format_simple_error(error: &crate::error::KainError) -> String:
    match error:
        _ =>
            f"Runtime Error: {message}"
        _ =>
            error

fn enhance_error_with_location(error: crate::error::KainError, span_mapper: &SpanMapper, file: &String) -> crate::error::KainError:
    match error:
        _ =>
            let loc = span_mapper.span_to_location(span, file)
            crate__error__KainError__codegen_with_location(message, loc.file, loc.line_, loc.col, span)
        other =>
            other

mod tests:
    fn test_line_info():
        let source = "let x = 5\nlet y = x + 1\nprint(y)"
        let diag = Diagnostics__new_(source, "test.kn")
        let _ = diag.get_line_info(crate__span__Span__new_(0, 3))
        if (line_ != 1):
            panic("assert_eq! failed")
        if (col != 1):
            panic("assert_eq! failed")
        if (content != "let x = 5"):
            panic("assert_eq! failed")
        let _ = diag.get_line_info(crate__span__Span__new_(14, 15))
        if (line_ != 2):
            panic("assert_eq! failed")
        if (content != "let y = x + 1"):
            panic("assert_eq! failed")

    fn test_span_mapper_basic():
        let source = "let x = 5\nlet y = x + 1\nprint(y)"
        let mapper = SpanMapper__new_(source)
        let loc = mapper.span_to_location(crate__span__Span__new_(0, 3), "test.kn")
        if (loc.file != "test.kn"):
            panic("assert_eq! failed")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        if (loc.col != 1):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(4, 5), "test.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        if (loc.col != 5):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(10, 13), "test.kn")
        if (loc.line_ != 2):
            panic("assert_eq! failed")
        if (loc.col != 1):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(14, 15), "test.kn")
        if (loc.line_ != 2):
            panic("assert_eq! failed")
        if (loc.col != 5):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(24, 29), "test.kn")
        if (loc.line_ != 3):
            panic("assert_eq! failed")
        if (loc.col != 1):
            panic("assert_eq! failed")

    fn test_span_mapper_empty_file():
        let source = ""
        let mapper = SpanMapper__new_(source)
        let loc = mapper.span_to_location(crate__span__Span__new_(0, 0), "empty.kn")
        if (loc.file != "empty.kn"):
            panic("assert_eq! failed")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        if (loc.col != 1):
            panic("assert_eq! failed")

    fn test_span_mapper_single_line():
        let source = "let x = 5"
        let mapper = SpanMapper__new_(source)
        let loc = mapper.span_to_location(crate__span__Span__new_(0, 3), "single.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        if (loc.col != 1):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(4, 5), "single.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        if (loc.col != 5):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(8, 9), "single.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        if (loc.col != 9):
            panic("assert_eq! failed")

    fn test_span_mapper_multi_byte_chars():
        let source = "let x = 🚀\nlet y = 5"
        let mapper = SpanMapper__new_(source)
        let loc = mapper.span_to_location(crate__span__Span__new_(0, 3), "unicode.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        if (loc.col != 1):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(12, 13), "unicode.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        if (loc.col != 13):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(13, 16), "unicode.kn")
        if (loc.line_ != 2):
            panic("assert_eq! failed")
        if (loc.col != 1):
            panic("assert_eq! failed")

    fn test_span_mapper_newline_variations():
        let source = "line1\nline2\nline3"
        let mapper = SpanMapper__new_(source)
        let loc = mapper.span_to_location(crate__span__Span__new_(0, 5), "test.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(6, 11), "test.kn")
        if (loc.line_ != 2):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(12, 17), "test.kn")
        if (loc.line_ != 3):
            panic("assert_eq! failed")

    fn test_span_mapper_empty_lines():
        let source = "line1\n\nline3\n\nline5"
        let mapper = SpanMapper__new_(source)
        let loc = mapper.span_to_location(crate__span__Span__new_(0, 5), "test.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(6, 6), "test.kn")
        if (loc.line_ != 2):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(7, 12), "test.kn")
        if (loc.line_ != 3):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(13, 13), "test.kn")
        if (loc.line_ != 4):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(14, 19), "test.kn")
        if (loc.line_ != 5):
            panic("assert_eq! failed")

    fn test_span_mapper_out_of_bounds():
        let source = "let x = 5"
        let mapper = SpanMapper__new_(source)
        let loc = mapper.span_to_location(crate__span__Span__new_(100, 200), "test.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        if (loc.col != 10):
            panic("assert_eq! failed")

    fn test_span_mapper_exact_line_start():
        let source = "line1\nline2\nline3"
        let mapper = SpanMapper__new_(source)
        let loc = mapper.span_to_location(crate__span__Span__new_(6, 11), "test.kn")
        if (loc.line_ != 2):
            panic("assert_eq! failed")
        if (loc.col != 1):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(12, 17), "test.kn")
        if (loc.line_ != 3):
            panic("assert_eq! failed")
        if (loc.col != 1):
            panic("assert_eq! failed")

    fn test_span_mapper_line_starts_vector():
        let source = "a\nb\nc"
        let mapper = SpanMapper__new_(source)
        if (mapper.line_starts != [0, 2, 4]):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(0, 1), "test.kn")
        if (loc.line_ != 1):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(2, 3), "test.kn")
        if (loc.line_ != 2):
            panic("assert_eq! failed")
        let loc = mapper.span_to_location(crate__span__Span__new_(4, 5), "test.kn")
        if (loc.line_ != 3):
            panic("assert_eq! failed")


enum Effect:
    Pure_
    IO_
    Async_
    GPU_
    Reactive_
    Unsafe_
    Alloc
    Panic

impl Effect:
    fn from_str(s: &String) -> Option<Self_>:
        match s:
            "Pure" =>
                Some(Effect__Pure_)
            "IO" =>
                Some(Effect__IO_)
            "Async" =>
                Some(Effect__Async_)
            "GPU" =>
                Some(Effect__GPU_)
            "Reactive" =>
                Some(Effect__Reactive_)
            "Unsafe" =>
                Some(Effect__Unsafe_)
            _ =>
                None


struct EffectSet:
    effects: Set<Effect>

impl EffectSet:
    fn new_() -> Self_:
        aggregate_init("Self_", effects = std__collections__HashSet__new_())

    fn pure() -> Self_:
        Self___new_().with_(Effect__Pure_)

    fn with_(_self: Self_, e: Effect) -> Self_:
        _self.effects.insert(e)
        _self

    fn is_pure(_self: &Self_) -> Bool:
        (_self.effects.is_empty() || _self.effects.iter().all(none))

    fn can_call(_self: &Self_, callee: &EffectSet) -> Bool:
        if callee.is_pure():
            return true
        if _self.is_pure():
            return false
        if _self.effects.contains(&Effect__Unsafe_):
            return true
        callee.effects.iter().all(none)


fn check_effect_call(caller: &EffectSet, callee: &EffectSet, caller_name: &String, callee_name: &String, _span: crate::span::Span) -> Result<(), Error>:
    if (!caller.can_call(callee)):
        let caller_effect_str = if caller.is_pure():
            "Pure".to_string()
        else:
            caller.effects.iter().map(none).collect().join(", ")
        let callee_effect_str = if callee.is_pure():
            "Pure".to_string()
        else:
            callee.effects.iter().map(none).collect().join(", ")
        return Err(crate__error__DiagnosticBuilder__new_(crate__error__ErrorKind__Validation, crate__diagnostic_registry__DiagnosticCode__EffectViolation, f"Effect violation: {caller_effect_str} function '{caller_name}' cannot call {callee_effect_str} function '{callee_name}'.\n\nEffect System Rules:\n  • Pure functions: No side effects, can only call Pure functions\n  • IO functions: Can perform I/O (file/network/console), can call Pure or IO functions\n  • Async functions: Can perform async operations, can call Pure, IO, or Async functions\n  • GPU functions: Run on graphics hardware, can call Pure or GPU functions\n  • Unsafe functions: Can break safety guarantees, can call any function\n\nCurrent situation:\n  • Caller '{caller_name}' is marked as {caller_effect_str}\n  • Callee '{callee_name}' is marked as {callee_effect_str}\n\nHow to fix:\n  1. Add effect annotation to caller: fn {caller_name}() -> RetType with {callee_effect_str}\n  2. OR mark callee as Pure if it has no side effects\n  3. OR change your call chain to avoid mixing incompatible effects\n\nExample (Pure calling IO - INVALID):\n  fn read_config() -> String with IO:\n      let data = load_from_disk()  # OK: IO can call IO\n      return data\n  \n  fn calculate_score() -> Int with Pure:\n      let config = read_config()   # ERROR: Pure cannot call IO\n      return 42\n\nExample (Fixed):\n  fn calculate_score() -> Int with IO:  # Changed to IO\n      let config = read_config()   # OK: IO can call IO\n      return 42\n").context(f"Caller '{caller_name}' ({caller_effect_str}) attempted to call '{callee_name}' ({callee_effect_str})").build())
    Ok(none)

enum KainError:
    Lexer { message: String, span: crate::span::Span }
    Parser { message: String, span: crate::span::Span }
    Type { message: String, span: crate::span::Span }
    Effect { message: String, span: crate::span::Span }
    Borrow { message: String, span: crate::span::Span }
    Codegen { message: String, span: crate::span::Span }
    CodegenWithLocation { message: String, file: String, line_: usize, col: usize, span: crate::span::Span }
    Runtime { message: String }
    Io(std::io::Error)
    Enhanced { kind: ErrorKind, code: crate::diagnostic_registry::DiagnosticCode, file: Option<std::path::PathBuf>, location: Option<(usize, usize)>, context: String, message: String, suggestion: Option<String> }
    Multi(Array<KainError>)

enum ErrorKind:
    Parse
    Type
    Validation
    Codegen
    Io
    Config

impl Display for ErrorKind:
    fn fmt(_self: &Self_, f: &mut std::fmt::Formatter) -> Result<(), Error>:
        match _self:
            Parse =>
                __kain_write_fmt!(f, "PARSE")
            Type =>
                __kain_write_fmt!(f, "TYPE")
            Validation =>
                __kain_write_fmt!(f, "VALIDATION")
            Codegen =>
                __kain_write_fmt!(f, "CODEGEN")
            Io =>
                __kain_write_fmt!(f, "IO")
            Config =>
                __kain_write_fmt!(f, "CONFIG")


fn format_enhanced_error(kind: &ErrorKind, code: &crate::diagnostic_registry::DiagnosticCode, file: &Option<std::path::PathBuf>, location: &Option<(usize, usize)>, context: &String, message: &String, suggestion: &Option<String>) -> String:
    let spec = crate__diagnostic_registry__spec_for_code((*code))
    let mut output = String__new_()
    output.push_str(&f"❌ [{kind}:{spec.code_str}] {spec.title}")
    match file:
        Some(path) =>
            output.push_str(&f" in {path.display()}")
            match location:
                Some((line_, col)) =>
                    output.push_str(&f":{line_}:{col}")
                _ =>
                    none
        _ =>
            none
    output.push_str("\n\n")
    if (!context.is_empty()):
        output.push_str(&f"   Context: {context}\n")
    output.push_str(&f"   {message}\n")
    match suggestion.as_deref().or_(spec.default_suggestion):
        Some(suggestion) =>
            output.push_str(&f"\n   Help: {suggestion}\n")
        _ =>
            none
    match spec.docs_key:
        Some(docs_key) =>
            output.push_str(&f"\n   Reference: {docs_key}\n")
        _ =>
            none
    output

fn format_multi_errors(errors: &[KainError]) -> String:
    let mut output = String__new_()
    output.push_str(&f"Found {errors.len()} error(s):\n")
    for _item in errors.iter().enumerate():
        output.push_str(&f"\n[{(i + 1)}/{errors.len()}] {err}\n")
    output

impl KainError:
    fn lexer(message: impl Into<String>, span: crate::span::Span) -> Self_:
        aggregate_init("KainError__Lexer", message = message.into(), span = span)

    fn parser(message: impl Into<String>, span: crate::span::Span) -> Self_:
        aggregate_init("KainError__Parser", message = message.into(), span = span)

    fn type_error(message: impl Into<String>, span: crate::span::Span) -> Self_:
        aggregate_init("KainError__Type", message = message.into(), span = span)

    fn effect_error(message: impl Into<String>, span: crate::span::Span) -> Self_:
        aggregate_init("KainError__Effect", message = message.into(), span = span)

    fn borrow_error(message: impl Into<String>, span: crate::span::Span) -> Self_:
        aggregate_init("KainError__Borrow", message = message.into(), span = span)

    fn codegen(message: impl Into<String>, span: crate::span::Span) -> Self_:
        aggregate_init("KainError__Codegen", message = message.into(), span = span)

    fn codegen_with_location(message: impl Into<String>, file: impl Into<String>, line_: usize, col: usize, span: crate::span::Span) -> Self_:
        aggregate_init("KainError__CodegenWithLocation", message = message.into(), file = file.into(), line_ = line_, col = col, span = span)

    fn runtime(message: impl Into<String>) -> Self_:
        aggregate_init("KainError__Runtime", message = message.into())

    fn multi(errors: Array<KainError>) -> Self_:
        if (!(!errors.is_empty())):
            panic("Multi error must contain at least one error")
        KainError__Multi(errors)

    fn parse_error(message: impl Into<String>) -> Self_:
        aggregate_init("KainError__Enhanced", kind = ErrorKind__Parse, code = crate__diagnostic_registry__default_code_for_kind(ErrorKind__Parse), file = None, location = None, context = String__new_(), message = message.into(), suggestion = None)

    fn type_err(message: impl Into<String>) -> Self_:
        aggregate_init("KainError__Enhanced", kind = ErrorKind__Type, code = crate__diagnostic_registry__default_code_for_kind(ErrorKind__Type), file = None, location = None, context = String__new_(), message = message.into(), suggestion = None)

    fn validation_error(message: impl Into<String>) -> Self_:
        aggregate_init("KainError__Enhanced", kind = ErrorKind__Validation, code = crate__diagnostic_registry__default_code_for_kind(ErrorKind__Validation), file = None, location = None, context = String__new_(), message = message.into(), suggestion = None)

    fn codegen_error(message: impl Into<String>) -> Self_:
        aggregate_init("KainError__Enhanced", kind = ErrorKind__Codegen, code = crate__diagnostic_registry__default_code_for_kind(ErrorKind__Codegen), file = None, location = None, context = String__new_(), message = message.into(), suggestion = None)

    fn io_error(message: impl Into<String>) -> Self_:
        aggregate_init("KainError__Enhanced", kind = ErrorKind__Io, code = crate__diagnostic_registry__default_code_for_kind(ErrorKind__Io), file = None, location = None, context = String__new_(), message = message.into(), suggestion = None)

    fn config_error(message: impl Into<String>) -> Self_:
        aggregate_init("KainError__Enhanced", kind = ErrorKind__Config, code = crate__diagnostic_registry__default_code_for_kind(ErrorKind__Config), file = None, location = None, context = String__new_(), message = message.into(), suggestion = None)

    fn diagnostic(kind: ErrorKind, code: crate::diagnostic_registry::DiagnosticCode, message: impl Into<String>) -> Self_:
        aggregate_init("KainError__Enhanced", kind = kind, code = code, file = None, location = None, context = String__new_(), message = message.into(), suggestion = None)


type KainResult = Result<T, KainError>

struct DiagnosticBuilder:
    kind: ErrorKind
    code: crate::diagnostic_registry::DiagnosticCode
    file: Option<std::path::PathBuf>
    location: Option<(usize, usize)>
    context: String
    message: String
    suggestion: Option<String>

impl DiagnosticBuilder:
    fn new_(kind: ErrorKind, code: crate::diagnostic_registry::DiagnosticCode, message: impl Into<String>) -> Self_:
        aggregate_init("Self_", kind = kind, code = code, file = None, location = None, context = String__new_(), message = message.into(), suggestion = None)

    fn context(_self: Self_, context: impl Into<String>) -> Self_:
        _self.context = context.into()
        _self

    fn file(_self: Self_, path: impl Into<std::path::PathBuf>) -> Self_:
        _self.file = Some(path.into())
        _self

    fn location(_self: Self_, line_: usize, col: usize) -> Self_:
        _self.location = Some((line_, col))
        _self

    fn suggestion(_self: Self_, suggestion: impl Into<String>) -> Self_:
        _self.suggestion = Some(suggestion.into())
        _self

    fn build(_self: Self_) -> KainError:
        aggregate_init("KainError__Enhanced", kind = _self.kind, code = _self.code, file = _self.file, location = _self.location, context = _self.context, message = _self.message, suggestion = _self.suggestion)


trait ErrorContext:
    fn with_file(_self: Self_, path: std::path::PathBuf) -> Result<T, KainError>:
        let __selfhost_empty = none
    fn with_location(_self: Self_, line_: usize, col: usize) -> Result<T, KainError>:
        let __selfhost_empty = none
    fn with_context(_self: Self_, ctx: impl Into<String>) -> Result<T, KainError>:
        let __selfhost_empty = none
    fn with_suggestion(_self: Self_, suggestion: impl Into<String>) -> Result<T, KainError>:
        let __selfhost_empty = none

impl ErrorContext for Result<T, KainError>:
    fn with_file(_self: Self_, path: std::path::PathBuf) -> Result<T, KainError>:
        _self.map_err(none)

    fn with_location(_self: Self_, line_: usize, col: usize) -> Result<T, KainError>:
        _self.map_err(none)

    fn with_context(_self: Self_, ctx: impl Into<String>) -> Result<T, KainError>:
        _self.map_err(none)

    fn with_suggestion(_self: Self_, suggestion: impl Into<String>) -> Result<T, KainError>:
        _self.map_err(none)


