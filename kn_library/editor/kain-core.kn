            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(aggregate_init("NodeTypeDef", name = name, category = category, inputs = inputs, outputs = outputs, properties = properties, attributes = attributes, span = start.merge(_self.current_span())))

    fn parse_pin_list(_self: &mut Self_) -> Result<Array<PinDef>, Error>:
        let mut pins = Vec__new_()
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
