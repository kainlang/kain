mod tests:
    fn enhanced_diagnostic_uses_registry_metadata():
        let err = DiagnosticBuilder__new_(ErrorKind__Validation, crate__diagnostic_registry__DiagnosticCode__MemoryLoweringRequired, "Lowering policy missing for pointer semantics").context("Lowering low-level memory IR").build()
        let rendered = err.to_string()
        if (!rendered.contains("KAIN-MEM-0001")):
            panic("assert! failed")
        if (!rendered.contains("Memory Lowering Required")):
            panic("assert! failed")
        if (!rendered.contains("Reference: memory/lowering")):
            panic("assert! failed")
        if (!rendered.contains("Help:")):
            panic("assert! failed")


enum LanguageCapability:
    ParserStructLiterals
    ParserBitwiseAnd
    ParserBitwiseOr
    ParserBitwiseXor
    ParserShiftLeft
    ParserShiftRight
    RuntimeBitwiseAnd
    RuntimeBitwiseOr
    RuntimeBitwiseXor
    RuntimeShiftLeft
    RuntimeShiftRight

struct CapabilitySpec:
    capability: LanguageCapability
    enabled_by_default: Bool
    description: &String

const LANGUAGE_CAPABILITY_SPECS: &[CapabilitySpec] = &[aggregate_init("CapabilitySpec", capability = LanguageCapability__ParserStructLiterals, enabled_by_default = false, description = "Parser support for struct literal syntax: Type { field: value }"), aggregate_init("CapabilitySpec", capability = LanguageCapability__ParserBitwiseAnd, enabled_by_default = true, description = "Parser support for bitwise '&' binary operator"), aggregate_init("CapabilitySpec", capability = LanguageCapability__ParserBitwiseOr, enabled_by_default = true, description = "Parser support for bitwise '|' binary operator"), aggregate_init("CapabilitySpec", capability = LanguageCapability__ParserBitwiseXor, enabled_by_default = true, description = "Parser support for bitwise '^' binary operator"), aggregate_init("CapabilitySpec", capability = LanguageCapability__ParserShiftLeft, enabled_by_default = true, description = "Parser support for shift-left '<<' binary operator"), aggregate_init("CapabilitySpec", capability = LanguageCapability__ParserShiftRight, enabled_by_default = true, description = "Parser support for shift-right '>>' binary operator"), aggregate_init("CapabilitySpec", capability = LanguageCapability__RuntimeBitwiseAnd, enabled_by_default = true, description = "Runtime support for bitwise '&' on integer values"), aggregate_init("CapabilitySpec", capability = LanguageCapability__RuntimeBitwiseOr, enabled_by_default = true, description = "Runtime support for bitwise '|' on integer values"), aggregate_init("CapabilitySpec", capability = LanguageCapability__RuntimeBitwiseXor, enabled_by_default = true, description = "Runtime support for bitwise '^' on integer values"), aggregate_init("CapabilitySpec", capability = LanguageCapability__RuntimeShiftLeft, enabled_by_default = true, description = "Runtime support for shift-left '<<' on integer values"), aggregate_init("CapabilitySpec", capability = LanguageCapability__RuntimeShiftRight, enabled_by_default = true, description = "Runtime support for shift-right '>>' on integer values")]

struct LanguageCapabilities:
    flags: Map<LanguageCapability, Bool>

impl Default for LanguageCapabilities:
    fn default_() -> Self_:
        let mut flags = std__collections__BTreeMap__new_()
        for spec in LANGUAGE_CAPABILITY_SPECS:
            flags.insert(spec.capability, spec.enabled_by_default)
        aggregate_init("Self_", flags = flags)


impl LanguageCapabilities:
    fn is_enabled(_self: &Self_, capability: LanguageCapability) -> Bool:
        _self.flags.get(&capability).copied().unwrap_or(false)

    fn with_override(_self: Self_, capability: LanguageCapability, enabled: Bool) -> Self_:
        _self.flags.insert(capability, enabled)
        _self

    fn supports_parser_struct_literals(_self: &Self_) -> Bool:
        _self.is_enabled(LanguageCapability__ParserStructLiterals)

    fn supports_parser_binary_op(_self: &Self_, op: crate::ast::BinaryOp) -> Bool:
        match parser_capability_for_binary_op(op):
            Some(capability) =>
                _self.is_enabled(capability)
            None =>
                true

    fn supports_runtime_binary_op(_self: &Self_, op: crate::ast::BinaryOp) -> Bool:
        match runtime_capability_for_binary_op(op):
            Some(capability) =>
                _self.is_enabled(capability)
            None =>
                true


const DEFAULT_LANGUAGE_CAPABILITIES: once_cell::sync::Lazy<LanguageCapabilities> = once_cell__sync__Lazy__new_(LanguageCapabilities__default_)

fn default_language_capabilities() -> LanguageCapabilities:
    DEFAULT_LANGUAGE_CAPABILITIES.clone()

fn parser_supports_binary_op(op: crate::ast::BinaryOp) -> Bool:
    DEFAULT_LANGUAGE_CAPABILITIES.supports_parser_binary_op(op)

fn runtime_supports_binary_op(op: crate::ast::BinaryOp) -> Bool:
    DEFAULT_LANGUAGE_CAPABILITIES.supports_runtime_binary_op(op)

fn parser_capability_for_binary_op(op: crate::ast::BinaryOp) -> Option<LanguageCapability>:
    match op:
        BitAnd =>
            Some(LanguageCapability__ParserBitwiseAnd)
        BitOr =>
            Some(LanguageCapability__ParserBitwiseOr)
        BitXor =>
            Some(LanguageCapability__ParserBitwiseXor)
        Shl =>
            Some(LanguageCapability__ParserShiftLeft)
        Shr =>
            Some(LanguageCapability__ParserShiftRight)
        _ =>
            None

fn runtime_capability_for_binary_op(op: crate::ast::BinaryOp) -> Option<LanguageCapability>:
    match op:
        BitAnd =>
            Some(LanguageCapability__RuntimeBitwiseAnd)
        BitOr =>
            Some(LanguageCapability__RuntimeBitwiseOr)
        BitXor =>
            Some(LanguageCapability__RuntimeBitwiseXor)
        Shl =>
            Some(LanguageCapability__RuntimeShiftLeft)
        Shr =>
            Some(LanguageCapability__RuntimeShiftRight)
        _ =>
            None

mod tests:
    fn default_profile_supports_bitwise_parser_and_runtime_ops():
        let caps = default_language_capabilities()
        if (!caps.supports_parser_binary_op(crate__ast__BinaryOp__BitAnd)):
            panic("assert! failed")
        if (!caps.supports_parser_binary_op(crate__ast__BinaryOp__BitOr)):
            panic("assert! failed")
        if (!caps.supports_parser_binary_op(crate__ast__BinaryOp__BitXor)):
            panic("assert! failed")
        if (!caps.supports_parser_binary_op(crate__ast__BinaryOp__Shl)):
            panic("assert! failed")
        if (!caps.supports_parser_binary_op(crate__ast__BinaryOp__Shr)):
            panic("assert! failed")
        if (!caps.supports_runtime_binary_op(crate__ast__BinaryOp__BitAnd)):
            panic("assert! failed")
        if (!caps.supports_runtime_binary_op(crate__ast__BinaryOp__BitOr)):
            panic("assert! failed")
        if (!caps.supports_runtime_binary_op(crate__ast__BinaryOp__BitXor)):
            panic("assert! failed")
        if (!caps.supports_runtime_binary_op(crate__ast__BinaryOp__Shl)):
            panic("assert! failed")
        if (!caps.supports_runtime_binary_op(crate__ast__BinaryOp__Shr)):
            panic("assert! failed")

    fn default_profile_keeps_struct_literals_disabled():
        let caps = default_language_capabilities()
        if (!(!caps.supports_parser_struct_literals())):
            panic("assert! failed")


