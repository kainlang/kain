                            on_execute = Some(func_def)
                        "on_add" =>
                            on_add = Some(func_def)
                        "on_remove" =>
                            on_remove = Some(func_def)
                        "while_active" =>
                            while_active = Some(func_def)
                        _ =>
                            let __selfhost_empty = none
                _ =>
                    return Err(_self.parser_error(f"Unknown gameplay cue field: {field_name}", _self.current_span()))
            _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Dedent)?
        let tag = tag.ok_or_else(none)?
        Ok(Item__GameplayCue(aggregate_init("GameplayCueDef", name = name, attributes = attributes, tag = tag, cue_type = cue_type, auto_destroy = auto_destroy, state_fields = state_fields, on_execute = on_execute, on_add = on_add, on_remove = on_remove, while_active = while_active, span = start.merge(_self.current_span()))))

    fn parse_ability_task(_self: &mut Self_, attributes: Array<Attribute>) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Struct)?
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut delegates: Array<TaskDelegateDef> = Vec__new_()
        let mut state_fields: Array<Field> = Vec__new_()
        let mut activate_method: Option<Function> = None
        let mut on_destroy_method: Option<Function> = None
        let mut custom_methods: Array<Function> = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            if _self.check(crate__lexer__TokenKind__At):
                let attr_start = _self.current_span()
                _self.advance()
                match _self.peek_kind():
                    Ident(attr_name) =>
                        if (attr_name == "delegate"):
                            _self.advance()
                            _self.skip_newlines()
                            let delegate_name = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            let delegate_type = _self.parse_ident()?
                            delegates.push(aggregate_init("TaskDelegateDef", name = delegate_name, delegate_type = delegate_type, span = attr_start.merge(_self.current_span())))
                            _self.skip_newlines()
                            continue
                    _ =>
                        none
            match _self.peek_kind():
                Ident(keyword) =>
                    if (keyword == "state"):
                        _self.advance()
                        let field_name = _self.parse_ident()?
                        _self.expect(crate__lexer__TokenKind__Colon)?
                        let field_type = _self.parse_type()?
                        let default_ = if _self.check(crate__lexer__TokenKind__Eq):
                            _self.advance()
                            Some(_self.parse_expr()?)
                        else:
                            None
                        state_fields.push(aggregate_init("Field", name = field_name, ty = field_type, attributes = [], visibility = Visibility__Private, default_ = default_, weak_ = false, span = _self.current_span()))
                        _self.skip_newlines()
                        continue
                _ =>
                    none
            if _self.check(crate__lexer__TokenKind__Fn):
                _self.advance()
                let method_name = _self.parse_ident()?
                let params = if _self.check(crate__lexer__TokenKind__LParen):
                    _self.advance()
                    let mut params = Vec__new_()
                    while ((!_self.check(crate__lexer__TokenKind__RParen)) && (!_self.at_end())):
                        let param_name = _self.parse_ident()?
                        _self.expect(crate__lexer__TokenKind__Colon)?
                        let param_type = _self.parse_type()?
                        params.push(aggregate_init("Param", name = param_name, ty = param_type, mutable_ = false, default_ = None, span = _self.current_span()))
                        if _self.check(crate__lexer__TokenKind__Comma):
                            _self.advance()
                    _self.expect(crate__lexer__TokenKind__RParen)?
                    params
                else:
                    []
                _self.expect(crate__lexer__TokenKind__Colon)?
                _self.skip_newlines()
                _self.expect(crate__lexer__TokenKind__Indent)?
                let mut body_stmts = Vec__new_()
                while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
                    _self.skip_newlines()
                    if _self.check(crate__lexer__TokenKind__Dedent):
                        break
                    body_stmts.push(_self.parse_stmt()?)
                _self.expect(crate__lexer__TokenKind__Dedent)?
                let func_def = aggregate_init("Function", name = method_name.clone(), generics = [], params = params, return_type = None, effects = [], body = aggregate_init("Block", stmts = body_stmts, span = _self.current_span()), visibility = Visibility__Private, attributes = [], span = _self.current_span())
                match method_name.as_str():
                    "activate" =>
                        activate_method = Some(func_def)
                    "on_destroy" =>
                        on_destroy_method = Some(func_def)
                    _ =>
                        custom_methods.push(func_def)
                _self.skip_newlines()
                continue
            return Err(_self.parser_error(f"Unexpected token in ability task: {crate__error__token_kind_to_user_string(&_self.peek_kind())}", _self.current_span()))
        _self.expect(crate__lexer__TokenKind__Dedent)?
        Ok(Item__AbilityTask(aggregate_init("AbilityTaskDef", name = name, attributes = attributes, delegates = delegates, state_fields = state_fields, activate_method = activate_method, on_destroy_method = on_destroy_method, custom_methods = custom_methods, span = start.merge(_self.current_span()))))

    fn parse_target_actor(_self: &mut Self_, attributes: Array<Attribute>) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Struct)?
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut trace_type = TraceType__default_()
        let mut max_range: Option<f64> = None
        let mut trace_channel: Option<String> = None
        let mut filter: Option<TargetFilter> = None
        let mut reticle_class: Option<String> = None
        let mut custom_methods: Array<Function> = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            match _self.peek_kind():
                Ident(field_name) =>
                    _self.advance()
                    _self.expect(crate__lexer__TokenKind__Colon)?
                    match field_name.as_str():
                        "trace_type" =>
                            match _self.peek_kind():
                                String(type_str) =>
                                    trace_type = none
                                    _self.advance()
                                _ =>
                                    return Err(_self.parser_error("Expected string for trace_type", _self.current_span()))
                        "max_range" =>
                            match _self.peek_kind():
                                Float(val) =>
                                    max_range = Some(val)
                                    _self.advance()
                                _ =>
                                    match _self.peek_kind():
                                        Int(val) =>
                                            max_range = Some(val as f64)
                                            _self.advance()
                                        _ =>
                                            return Err(_self.parser_error("Expected number for max_range", _self.current_span()))
                        "trace_channel" =>
                            match _self.peek_kind():
                                String(channel) =>
                                    trace_channel = Some(channel)
                                    _self.advance()
                                _ =>
                                    return Err(_self.parser_error("Expected string for trace_channel", _self.current_span()))
                        "reticle_class" =>
                            match _self.peek_kind():
                                String(class_) =>
                                    reticle_class = Some(class_)
                                    _self.advance()
                                _ =>
                                    return Err(_self.parser_error("Expected string for reticle_class", _self.current_span()))
                        "filter" =>
                            _self.skip_newlines()
                            _self.expect(crate__lexer__TokenKind__Indent)?
                            let mut self_filter: Option<String> = None
                            let mut required_actor_class: Option<String> = None
                            let mut require_tags: Array<String> = Vec__new_()
                            let mut ignore_tags: Array<String> = Vec__new_()
                            let mut custom_filter_method: Option<Function> = None
                            while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
                                _self.skip_newlines()
                                if _self.check(crate__lexer__TokenKind__Dedent):
                                    break
                                match _self.peek_kind():
                                    Ident(filter_field) =>
                                        _self.advance()
                                        _self.expect(crate__lexer__TokenKind__Colon)?
                                        match filter_field.as_str():
                                            "self_filter" =>
                                                match _self.peek_kind():
                                                    String(val) =>
                                                        self_filter = Some(val)
                                                        _self.advance()
                                                    _ =>
                                                        none
                                            "required_actor_class" =>
                                                match _self.peek_kind():
                                                    String(val) =>
                                                        required_actor_class = Some(val)
                                                        _self.advance()
                                                    _ =>
                                                        none
                                            "require_tags" =>
                                                require_tags = _self.parse_string_array()?
                                            "ignore_tags" =>
                                                ignore_tags = _self.parse_string_array()?
                                            _ =>
                                                return Err(_self.parser_error(f"Unknown filter field: {filter_field}", _self.current_span()))
                                    _ =>
                                        if _self.check(crate__lexer__TokenKind__Fn):
                                            _self.advance()
                                            let method_name = _self.parse_ident()?
                                            let params = if _self.check(crate__lexer__TokenKind__LParen):
                                                _self.advance()
                                                let mut params = Vec__new_()
                                                while ((!_self.check(crate__lexer__TokenKind__RParen)) && (!_self.at_end())):
                                                    let param_name = _self.parse_ident()?
                                                    _self.expect(crate__lexer__TokenKind__Colon)?
                                                    let param_type = _self.parse_type()?
                                                    params.push(aggregate_init("Param", name = param_name, ty = param_type, mutable_ = false, default_ = None, span = _self.current_span()))
                                                    if _self.check(crate__lexer__TokenKind__Comma):
                                                        _self.advance()
                                                _self.expect(crate__lexer__TokenKind__RParen)?
                                                params
                                            else:
                                                []
                                            _self.expect(crate__lexer__TokenKind__Colon)?
                                            _self.skip_newlines()
                                            _self.expect(crate__lexer__TokenKind__Indent)?
                                            let mut body_stmts = Vec__new_()
                                            while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
                                                _self.skip_newlines()
                                                if _self.check(crate__lexer__TokenKind__Dedent):
                                                    break
                                                body_stmts.push(_self.parse_stmt()?)
                                            _self.expect(crate__lexer__TokenKind__Dedent)?
                                            custom_filter_method = Some(aggregate_init("Function", name = method_name, generics = [], params = params, return_type = None, effects = [], body = aggregate_init("Block", stmts = body_stmts, span = _self.current_span()), visibility = Visibility__Private, attributes = [], span = _self.current_span()))
                                _self.skip_newlines()
                            _self.expect(crate__lexer__TokenKind__Dedent)?
                            filter = Some(aggregate_init("TargetFilter", self_filter = self_filter, required_actor_class = required_actor_class, require_tags = require_tags, ignore_tags = ignore_tags, custom_filter_method = custom_filter_method, span = _self.current_span()))
                        _ =>
                            return Err(_self.parser_error(f"Unknown target actor field: {field_name}", _self.current_span()))
                _ =>
                    if _self.check(crate__lexer__TokenKind__Fn):
                        _self.advance()
                        let method_name = _self.parse_ident()?
                        let params = if _self.check(crate__lexer__TokenKind__LParen):
                            _self.advance()
                            let mut params = Vec__new_()
                            while ((!_self.check(crate__lexer__TokenKind__RParen)) && (!_self.at_end())):
                                let param_name = _self.parse_ident()?
                                _self.expect(crate__lexer__TokenKind__Colon)?
                                let param_type = _self.parse_type()?
                                params.push(aggregate_init("Param", name = param_name, ty = param_type, mutable_ = false, default_ = None, span = _self.current_span()))
                                if _self.check(crate__lexer__TokenKind__Comma):
                                    _self.advance()
                            _self.expect(crate__lexer__TokenKind__RParen)?
                            params
                        else:
                            []
                        _self.expect(crate__lexer__TokenKind__Colon)?
                        _self.skip_newlines()
                        _self.expect(crate__lexer__TokenKind__Indent)?
                        let mut body_stmts = Vec__new_()
                        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
                            _self.skip_newlines()
                            if _self.check(crate__lexer__TokenKind__Dedent):
                                break
                            body_stmts.push(_self.parse_stmt()?)
                        _self.expect(crate__lexer__TokenKind__Dedent)?
                        custom_methods.push(aggregate_init("Function", name = method_name, generics = [], params = params, return_type = None, effects = [], body = aggregate_init("Block", stmts = body_stmts, span = _self.current_span()), visibility = Visibility__Private, attributes = [], span = _self.current_span()))
                    else:
                        return Err(_self.parser_error("Expected field name or fn", _self.current_span()))
            _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Dedent)?
        Ok(Item__TargetActor(aggregate_init("TargetActorDef", name = name, attributes = attributes, trace_type = trace_type, max_range = max_range, trace_channel = trace_channel, filter = filter, reticle_class = reticle_class, custom_methods = custom_methods, span = start.merge(_self.current_span()))))


mod tests:
    fn parse_program(source: &String) -> Result<Program, Error>:
        let tokens = crate__lexer__Lexer__new_(source).tokenize()?
        let span_mapper = crate__diagnostics__SpanMapper__new_(source)
        Parser__new_(&tokens, &span_mapper, "<test>").parse()

    fn parses_component_call_and_fragment_in_component_render():
        let program = parse_program("component App():\n    render <Fragment><Panel title={title} /></Fragment>\n").expect("program should parse")
        let _ = &program.items[0]
        match &component_.body:
            Fragment(children, _) =>
                if (children.len() != 1):
                    panic("assert_eq! failed")
                match &children[0]:
                    _ =>
                        if (name != "Panel"):
                            panic("assert_eq! failed")
                        if (props.len() != 1):
                            panic("assert_eq! failed")
                    other =>
                        panic(f"expected component call, got {other}")
            other =>
                panic(f"expected fragment body, got {other}")

    fn parses_jsx_if_and_for_children():
        let program = parse_program("component App(items: List<Int>, ready: Bool):\n    render <div>{if ready: <Spinner /> else: <Empty />}{for item in items: <Row value={item} />}</div>\n").expect("program should parse")
        let _ = &program.items[0]
        let _ = &component_.body
        if (children.len() != 2):
            panic("assert_eq! failed")
        match &children[0]:
            _ =>
                if (!none):
                    panic("assert! failed")
                if (!none):
                    panic("assert! failed")
            other =>
                panic(f"expected if child, got {other}")
        match &children[1]:
            _ =>
                if (binding != "item"):
                    panic("assert_eq! failed")
                if (!none):
                    panic("assert! failed")
            other =>
                panic(f"expected for child, got {other}")

    fn parses_jsx_attributes_named_like_keywords():
        let program = parse_program("component App():\n    render <button type=\"button\" className={none}>\"ok\"</button>\n").expect("program should parse")
        let _ = &program.items[0]
        let _ = &component_.body
        if (attributes.len() != 2):
            panic("assert_eq! failed")
        if (attributes[0].name != "type"):
            panic("assert_eq! failed")
        if (attributes[1].name != "className"):
            panic("assert_eq! failed")

    fn parses_component_valued_jsx_attributes():
        let program = parse_program("component App():\n    render <Shell topBar={<TopBar title={title} />} bottom={<Footer />} />\n").expect("program should parse")
        let _ = &program.items[0]
        let _ = &component_.body
        if (props.len() != 2):
            panic("assert_eq! failed")
        match &props[0].value:
            Expr(JSX(_, _)) =>
                if (name != "TopBar"):
                    panic("assert_eq! failed")
            other =>
                panic(f"expected nested JSX component prop, got {other}")
        match &props[1].value:
            Expr(JSX(_, _)) =>
                if (name != "Footer"):
                    panic("assert_eq! failed")
            other =>
                panic(f"expected nested JSX component prop, got {other}")


fn py_to_value(obj: &PyAny) -> PyResult<Value>:
    match obj.extract():
        Ok(s) =>
            return Ok(Value__String(s))
        _ =>
            none
    match obj.extract():
        Ok(b) =>
            return Ok(Value__Bool(b))
        _ =>
            none
    match obj.extract():
        Ok(i) =>
            return Ok(Value__Int(i))
        _ =>
            none
    match obj.extract():
        Ok(f) =>
            return Ok(Value__Float(f))
        _ =>
            none
    match obj.downcast():
        Ok(l) =>
            let mut vec = Vec__new_()
            for item in l:
                vec.push(py_to_value(item)?)
            return Ok(Value__Array(std__sync__Arc__new_(std__sync__RwLock__new_(vec))))
        _ =>
            none
    Ok(Value__String(obj))

enum Value:
    Unit
    Bool(Bool)
    Int(i64)
    Float(f64)
    String(String)
    Array(Array<Value>)
    Tuple(Array<Value>)
    Struct(String, Map<String, Value>)
    Function(String)
    NativeFn(String, fn(&mut Env, Array<Value>) -> Result<Value, Error>)
    ActorRef(ActorRef)
    None
    Return(Value)
    Break(Option<Value>)
    Continue
    Result(Bool, Value)
    Closure(Array<String>, Expr, Array<Map<String, Value>>)
    StructConstructor(String, Array<String>)
    JSX(crate::ui::VNode)
    EnumVariant(String, String, Array<Value>)
    Poll(Bool, Option<Value>)
    Future(String, Map<String, Value>)

impl Debug for Value:
    fn fmt(_self: &Self_, f: &mut std::fmt::Formatter) -> Result<(), Error>:
        match _self:
            Unit =>
                __kain_write_fmt!(f, "Unit")
            Bool(b) =>
                __kain_write_fmt!(f, f"Bool({b})")
            Int(i) =>
                __kain_write_fmt!(f, f"Int({i})")
            Float(fl) =>
                __kain_write_fmt!(f, f"Float({fl})")
            String(s) =>
                __kain_write_fmt!(f, f"String({s})")
            Array(arr) =>
                __kain_write_fmt!(f, f"Array({arr})")
            Tuple(t) =>
                __kain_write_fmt!(f, f"Tuple({t})")
            Struct(name, fields) =>
                __kain_write_fmt!(f, f"Struct({name}, {fields})")
            Function(name) =>
                __kain_write_fmt!(f, f"Function({name})")
            NativeFn(name, _) =>
                __kain_write_fmt!(f, f"NativeFn({name})")
            StructConstructor(name, _) =>
                __kain_write_fmt!(f, f"StructConstructor({name})")
            ActorRef(r) =>
                __kain_write_fmt!(f, f"ActorRef({r})")
            None =>
                __kain_write_fmt!(f, "None")
            Return(v) =>
                __kain_write_fmt!(f, f"Return({v})")
            Result(ok, v) =>
                if (*ok):
                    __kain_write_fmt!(f, f"Ok({v})")
                else:
                    __kain_write_fmt!(f, f"Err({v})")
            Closure(params, _, _) =>
                __kain_write_fmt!(f, f"Closure({params})")
            JSX(node) =>
                __kain_write_fmt!(f, f"JSX({node})")
            EnumVariant(e, v, _) =>
                __kain_write_fmt!(f, f"{e}::{v}")
            Poll(ready, val) =>
                if (*ready):
                    __kain_write_fmt!(f, f"Poll::Ready({val})")
                else:
                    __kain_write_fmt!(f, "Poll::Pending")
            Future(name, _) =>
                __kain_write_fmt!(f, f"Future<{name}>")
            Break(v) =>
                __kain_write_fmt!(f, f"Break({v})")
            Continue =>
                __kain_write_fmt!(f, "Continue")


impl Display for Value:
    fn fmt(_self: &Self_, f: &mut std::fmt::Formatter) -> Result<(), Error>:
        match _self:
            Unit =>
                __kain_write_fmt!(f, "()")
            Bool(b) =>
                __kain_write_fmt!(f, b)
            Int(i) =>
                __kain_write_fmt!(f, i)
            Float(fl) =>
                __kain_write_fmt!(f, fl)
            String(s) =>
                __kain_write_fmt!(f, s)
            Array(arr) =>
                __kain_write_fmt!(f, "[")?
                let arr = arr.read().unwrap()
                for _item in arr.iter().enumerate():
                    if (i > 0):
                        __kain_write_fmt!(f, ", ")?
                    __kain_write_fmt!(f, v)?
                __kain_write_fmt!(f, "]")
            Tuple(t) =>
                __kain_write_fmt!(f, "(")?
                for _item in t.iter().enumerate():
                    if (i > 0):
                        __kain_write_fmt!(f, ", ")?
                    __kain_write_fmt!(f, v)?
                __kain_write_fmt!(f, ")")
            Struct(name, fields) =>
                __kain_write_fmt!(f, "{name} {")?
                let fields = fields.read().unwrap()
                for _item in fields.iter().enumerate():
                    if (i > 0):
                        __kain_write_fmt!(f, ", ")?
                    __kain_write_fmt!(f, f"{k}: {v}")?
                __kain_write_fmt!(f, "}")
            Function(name) =>
                __kain_write_fmt!(f, f"<fn {name}>")
            NativeFn(name, _) =>
                __kain_write_fmt!(f, f"<native fn {name}>")
            StructConstructor(name, _) =>
                __kain_write_fmt!(f, f"<constructor {name}>")
            ActorRef(r) =>
                __kain_write_fmt!(f, f"<actor {r.id}>")
            None =>
                __kain_write_fmt!(f, "none")
            Return(v) =>
                __kain_write_fmt!(f, v)
            Result(ok, v) =>
                if (*ok):
                    __kain_write_fmt!(f, f"Ok({v})")
                else:
                    __kain_write_fmt!(f, f"Err({v})")
            Closure(_, _, _) =>
                __kain_write_fmt!(f, "<closure>")
            JSX(node) =>
                __kain_write_fmt!(f, node)
            EnumVariant(enum_name, variant, fields) =>
                if fields.is_empty():
                    __kain_write_fmt!(f, f"{enum_name}::{variant}")
                else:
                    __kain_write_fmt!(f, f"{enum_name}::{variant}(")?
                    for _item in fields.iter().enumerate():
                        if (i > 0):
                            __kain_write_fmt!(f, ", ")?
                        __kain_write_fmt!(f, v)?
                    __kain_write_fmt!(f, ")")
            Poll(ready, val) =>
                if (*ready):
                    match val:
                        Some(v) =>
                            __kain_write_fmt!(f, f"Poll::Ready({v})")
                        _ =>
                            __kain_write_fmt!(f, "Poll::Ready(())")
                else:
                    __kain_write_fmt!(f, "Poll::Pending")
            Future(name, _) =>
                __kain_write_fmt!(f, f"<future {name}>")
            Break(v) =>
                match v:
                    Some(val) =>
                        __kain_write_fmt!(f, f"<break {val}>")
                    _ =>
                        __kain_write_fmt!(f, "<break>")
            Continue =>
                __kain_write_fmt!(f, "<continue>")


struct ActorRef:
    id: u64
    sender: flume::Sender<Message>

struct Message:
    name: String
    args: Array<Value>

struct Env:
    scopes: Array<Map<String, Value>>
    functions: Map<String, Function>
    components: Map<String, Component>
    methods: Map<String, Map<String, Function>>
    actors: Map<u64, flume::Sender<Message>>
    next_actor_id: u64
    actor_defs: Map<String, Actor>
    self_actor_id: Option<u64>
    python_scope: Option<PyObject>

impl Env:
    fn new_() -> Self_:
