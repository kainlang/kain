        let mut cancel_abilities_with_tag: Array<String> = Vec__new_()
        let mut block_abilities_with_tag: Array<String> = Vec__new_()
        let mut cost_effect: Option<String> = None
        let mut cooldown_effect: Option<String> = None
        let mut methods: Array<Function> = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            if _self.check(crate__lexer__TokenKind__At):
                let attr_start = _self.current_span()
