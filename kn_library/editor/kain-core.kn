    fn peek_next_ident(_self: &Self_) -> Result<String, Error>:
        if ((_self.pos + 1) < _self.tokens.len()):
            match &_self.tokens[(_self.pos + 1)].kind:
                Ident(name) =>
                    Ok(name.clone())
                _ =>
                    Err(_self.parser_error("Expected identifier", _self.current_span()))
        else:
            Err(_self.parser_error("Unexpected end of input", _self.current_span()))

