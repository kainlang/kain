                if (s != "namespace"):
                    return Err(_self.parser_error("Expected 'namespace' keyword after @gameplay_tags", _self.current_span()))
                _self.advance()
            _ =>
                return Err(_self.parser_error("Expected 'namespace' keyword after @gameplay_tags", _self.current_span()))
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
