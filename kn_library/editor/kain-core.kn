            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(Item__GraphEditor(aggregate_init("GraphEditorDef", name = name, attributes = attributes, node_types = node_types, schema = schema, span = start.merge(_self.current_span()))))

    fn parse_node_type(_self: &mut Self_, attributes: Array<Attribute>) -> Result<NodeTypeDef, Error>:
        let start = _self.current_span()
        match _self.peek_kind():
            Ident(s) =>
