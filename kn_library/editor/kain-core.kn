            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(Item__MaterialGraph(aggregate_init("MaterialGraphDef", name = name, attributes = attributes, inputs = inputs, body = body, outputs = outputs, span = start.merge(_self.current_span()))))

    fn parse_material_function(_self: &mut Self_, attributes: Array<Attribute>) -> Result<Item, Error>:
