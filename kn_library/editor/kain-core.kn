    fn parse_generics(_self: &mut Self_) -> Result<Array<Generic>, Error>:
        let mut generics = Vec__new_()
        if (!_self.check(crate__lexer__TokenKind__Lt)):
            return Ok(generics)
        _self.advance()
        while ((!_self.check(crate__lexer__TokenKind__Gt)) && (!_self.at_end())):
            let start = _self.current_span()
            let name = _self.parse_ident()?
            let mut bounds = Vec__new_()
            if _self.check(crate__lexer__TokenKind__Colon):
                _self.advance()
                loop:
                    let bound_name = _self.parse_ident()?
                    bounds.push(aggregate_init("TypeBound", trait_name = bound_name, span = _self.current_span()))
                    if (!_self.check(crate__lexer__TokenKind__Plus)):
                        break
                    _self.advance()
            generics.push(aggregate_init("Generic", name = name, bounds = bounds, span = start.merge(_self.current_span())))
            if (!_self.check(crate__lexer__TokenKind__Gt)):
                _self.expect(crate__lexer__TokenKind__Comma)?
        _self.expect(crate__lexer__TokenKind__Gt)?
        Ok(generics)

    fn parse_effects(_self: &mut Self_) -> Result<Array<crate::effects::Effect>, Error>:
        let mut effects = Vec__new_()
        if _self.check(crate__lexer__TokenKind__With):
            _self.advance()
            loop:
                let effect = match _self.peek_kind():
                    Pure_ =>
                        _self.advance()
                        Some(crate__effects__Effect__Pure_)
                    Io =>
                        _self.advance()
                        Some(crate__effects__Effect__IO_)
                    Async_ =>
                        _self.advance()
                        Some(crate__effects__Effect__Async_)
                    Gpu =>
                        _self.advance()
                        Some(crate__effects__Effect__GPU_)
                    Reactive_ =>
                        _self.advance()
                        Some(crate__effects__Effect__Reactive_)
                    Unsafe_ =>
                        _self.advance()
                        Some(crate__effects__Effect__Unsafe_)
                    Ident(s) =>
                        let e = crate__effects__Effect__from_str(s)
                        _self.advance()
                        e
                    _ =>
                        None
                match effect:
                    Some(e) =>
                        effects.push(e)
                    _ =>
                        none
                if (!_self.check(crate__lexer__TokenKind__Comma)):
                    break
                _self.advance()
        Ok(effects)

    fn parse_type(_self: &mut Self_) -> Result<Type, Error>:
        let span = _self.current_span()
        if _self.check(crate__lexer__TokenKind__Amp):
            _self.advance()
            let mutable_ = if _self.check(crate__lexer__TokenKind__Mut):
                _self.advance()
                true
            else:
                false
            let inner = _self.parse_type()?
            return Ok(aggregate_init("Type__Ref", mutable_ = mutable_, inner = Box__new_(inner), lifetime = None, span = span.merge(_self.current_span())))
        if _self.check(crate__lexer__TokenKind__LBracket):
            _self.advance()
            let inner = _self.parse_type()?
            if _self.check(crate__lexer__TokenKind__Semi):
                _self.advance()
                let _ = _self.peek_kind()
                _self.advance()
                _self.expect(crate__lexer__TokenKind__RBracket)?
                return Ok(Type__Array(Box__new_(inner), size as usize, span.merge(_self.current_span())))
            _self.expect(crate__lexer__TokenKind__RBracket)?
            return Ok(Type__Slice(Box__new_(inner), span.merge(_self.current_span())))
        if _self.check(crate__lexer__TokenKind__LParen):
            _self.advance()
            if _self.check(crate__lexer__TokenKind__RParen):
                _self.advance()
                return Ok(Type__Unit(span.merge(_self.current_span())))
            let mut elements = Vec__new_()
            elements.push(_self.parse_type()?)
            while _self.check(crate__lexer__TokenKind__Comma):
                _self.advance()
                if _self.check(crate__lexer__TokenKind__RParen):
                    break
                elements.push(_self.parse_type()?)
            _self.expect(crate__lexer__TokenKind__RParen)?
            return Ok(Type__Tuple(elements, span.merge(_self.current_span())))
        if _self.check(crate__lexer__TokenKind__Impl):
            _self.advance()
            let trait_name = _self.parse_ident()?
            let mut generics = Vec__new_()
            if _self.check(crate__lexer__TokenKind__Lt):
                _self.advance()
                while (((!_self.check(crate__lexer__TokenKind__Gt)) && (!_self.check(crate__lexer__TokenKind__Shr))) && (!_self.at_end())):
                    generics.push(_self.parse_type()?)
                    if ((!_self.check(crate__lexer__TokenKind__Gt)) && (!_self.check(crate__lexer__TokenKind__Shr))):
                        _self.expect(crate__lexer__TokenKind__Comma)?
                if _self.check(crate__lexer__TokenKind__Shr):
                    _self.advance()
                else:
                    _self.expect(crate__lexer__TokenKind__Gt)?
            return Ok(aggregate_init("Type__Impl", trait_name = trait_name, generics = generics, span = span.merge(_self.current_span())))
        if _self.check(crate__lexer__TokenKind__Fn):
            _self.advance()
            _self.expect(crate__lexer__TokenKind__LParen)?
            let mut params = Vec__new_()
            while ((!_self.check(crate__lexer__TokenKind__RParen)) && (!_self.at_end())):
                params.push(_self.parse_type()?)
                if (!_self.check(crate__lexer__TokenKind__RParen)):
                    _self.expect(crate__lexer__TokenKind__Comma)?
            _self.expect(crate__lexer__TokenKind__RParen)?
            let return_type = if _self.check(crate__lexer__TokenKind__Arrow):
                _self.advance()
                Box__new_(_self.parse_type()?)
            else:
                Box__new_(Type__Unit(span))
            return Ok(aggregate_init("Type__Function", params = params, return_type = return_type, effects = [], span = span.merge(_self.current_span())))
        let mut name = _self.parse_ident()?
        if ((name == "delegate") && _self.check(crate__lexer__TokenKind__LParen)):
            _self.advance()
            let mut params = Vec__new_()
            while ((!_self.check(crate__lexer__TokenKind__RParen)) && (!_self.at_end())):
                params.push(_self.parse_type()?)
                if (!_self.check(crate__lexer__TokenKind__RParen)):
                    _self.expect(crate__lexer__TokenKind__Comma)?
            _self.expect(crate__lexer__TokenKind__RParen)?
            let return_type = Box__new_(Type__Unit(span))
            return Ok(aggregate_init("Type__Function", params = params, return_type = return_type, effects = [], span = span.merge(_self.current_span())))
        while _self.check(crate__lexer__TokenKind__ColonColon):
            _self.advance()
            let part = _self.parse_ident()?
            name.push_str("::")
            name.push_str(&part)
        let mut type_args = Vec__new_()
        if _self.check(crate__lexer__TokenKind__Lt):
            _self.advance()
            while (((!_self.check(crate__lexer__TokenKind__Gt)) && (!_self.check(crate__lexer__TokenKind__Shr))) && (!_self.at_end())):
                type_args.push(_self.parse_type()?)
                if ((!_self.check(crate__lexer__TokenKind__Gt)) && (!_self.check(crate__lexer__TokenKind__Shr))):
                    _self.expect(crate__lexer__TokenKind__Comma)?
            if _self.check(crate__lexer__TokenKind__Shr):
                let shr_span = _self.current_span()
                _self.advance()
                _self.inject_token(crate__lexer__Token__new_(crate__lexer__TokenKind__Gt, shr_span))
            else:
                _self.expect(crate__lexer__TokenKind__Gt)?
        if ((((name == "ptr") || (name == "ptr_mut"))) && (type_args.len() == 1)):
            return Ok(aggregate_init("Type__Ptr", mutable_ = (name == "ptr_mut"), inner = Box__new_(type_args.into_iter().next().unwrap()), provenance = crate__ast__PointerProvenance__Raw, span = span))
        Ok(aggregate_init("Type__Named", name = name, generics = type_args, span = span))

    fn parse_block(_self: &mut Self_) -> Result<Block, Error>:
        _self.skip_newlines()
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut stmts = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if ((_self.check(crate__lexer__TokenKind__Dedent) || _self.check(crate__lexer__TokenKind__Elif)) || _self.check(crate__lexer__TokenKind__Else)):
                break
            stmts.push(_self.parse_stmt()?)
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(aggregate_init("Block", stmts = stmts, span = start.merge(_self.current_span())))

    fn parse_stmt(_self: &mut Self_) -> Result<Stmt, Error>:
        match _self.peek_kind():
            Let =>
                _self.parse_let()
            Var =>
                _self.parse_var()
            Return =>
                _self.parse_return()
            For =>
                _self.parse_for()
            While =>
                _self.parse_while()
            Loop =>
                _self.parse_loop()
            Break =>
                _self.parse_break()
            Continue =>
                _self.parse_continue()
            _ =>
                Ok(Stmt__Expr(_self.parse_expr()?))

    fn parse_let(_self: &mut Self_) -> Result<Stmt, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Let)?
        let pattern = _self.parse_pattern()?
        let ty = if _self.check(crate__lexer__TokenKind__Colon):
            _self.advance()
            Some(_self.parse_type()?)
        else:
            None
        _self.expect(crate__lexer__TokenKind__Eq)?
        let value = Some(_self.parse_expr()?)
        Ok(aggregate_init("Stmt__Let", pattern = pattern, ty = ty, value = value, span = start.merge(_self.current_span())))

    fn parse_var(_self: &mut Self_) -> Result<Stmt, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Var)?
        let name = _self.parse_ident()?
        let ty = if _self.check(crate__lexer__TokenKind__Colon):
            _self.advance()
            Some(_self.parse_type()?)
        else:
            None
        _self.expect(crate__lexer__TokenKind__Eq)?
        let value = Some(_self.parse_expr()?)
        let pattern = aggregate_init("Pattern__Binding", name = name, mutable_ = true, span = start)
        Ok(aggregate_init("Stmt__Let", pattern = pattern, ty = ty, value = value, span = start.merge(_self.current_span())))

    fn parse_return(_self: &mut Self_) -> Result<Stmt, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Return)?
        let value = if (!_self.check_line_end()):
            Some(_self.parse_expr()?)
        else:
            None
        Ok(Stmt__Return(value, start.merge(_self.current_span())))

    fn parse_for(_self: &mut Self_) -> Result<Stmt, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__For)?
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__In)?
        let iter = _self.parse_expr()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        let body = _self.parse_block()?
        Ok(aggregate_init("Stmt__For", binding = aggregate_init("Pattern__Binding", name = name, mutable_ = false, span = start), iter = iter, body = body, span = start.merge(_self.current_span())))

    fn parse_while(_self: &mut Self_) -> Result<Stmt, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__While)?
        let condition = _self.parse_expr()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        let body = _self.parse_block()?
        Ok(aggregate_init("Stmt__While", condition = condition, body = body, span = start.merge(_self.current_span())))

    fn parse_loop(_self: &mut Self_) -> Result<Stmt, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Loop)?
        _self.expect(crate__lexer__TokenKind__Colon)?
        let body = _self.parse_block()?
        Ok(aggregate_init("Stmt__Loop", body = body, span = start.merge(_self.current_span())))

    fn parse_break(_self: &mut Self_) -> Result<Stmt, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Break)?
        let value = if ((!_self.check_line_end()) && (!_self.check(crate__lexer__TokenKind__Dedent))):
            Some(_self.parse_expr()?)
        else:
            None
        Ok(Stmt__Break(value, start.merge(_self.current_span())))

    fn parse_continue(_self: &mut Self_) -> Result<Stmt, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Continue)?
        Ok(Stmt__Continue(start.merge(_self.current_span())))

    fn parse_expr(_self: &mut Self_) -> Result<Expr, Error>:
        _self.parse_assignment()

    fn parse_assignment(_self: &mut Self_) -> Result<Expr, Error>:
        let target = _self.parse_conditional()?
        match _self.get_assignment_binop():
            Some(assign_binop) =>
                _self.advance()
                let rhs = _self.parse_assignment()?
                let span = target.span().merge(rhs.span())
                let value = match assign_binop:
                    Some(op) =>
                        aggregate_init("Expr__Binary", left = Box__new_(target.clone()), op = op, right = Box__new_(rhs), span = span)
                    _ =>
                        rhs
                Ok(aggregate_init("Expr__Assign", target = Box__new_(target), value = Box__new_(value), span = span))
            _ =>
                Ok(target)

    fn parse_conditional(_self: &mut Self_) -> Result<Expr, Error>:
        let condition = _self.parse_coalesce()?
        if (!_self.check(crate__lexer__TokenKind__Question)):
            return Ok(condition)
        _self.advance()
        let then_expr = _self.parse_assignment()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        let else_expr = _self.parse_assignment()?
        let then_span = then_expr.span()
        let else_span = else_expr.span()
        let span = condition.span().merge(else_span)
        Ok(aggregate_init("Expr__Match", scrutinee = Box__new_(condition), arms = [aggregate_init("MatchArm", pattern = Pattern__Literal(Expr__Bool(true, then_span)), guard = None, body = then_expr, span = then_span), aggregate_init("MatchArm", pattern = Pattern__Literal(Expr__Bool(false, else_span)), guard = None, body = else_expr, span = else_span)], span = span))

    fn parse_coalesce(_self: &mut Self_) -> Result<Expr, Error>:
        let left = _self.parse_binary(0)?
        if _self.check(crate__lexer__TokenKind__QuestionQuestion):
            _self.advance()
            let right = _self.parse_coalesce()?
            let span = left.span().merge(right.span())
            _self.make_null_coalesce_expr(left, right, span)
        else:
            Ok(left)

    fn parse_binary(_self: &mut Self_, min_prec: u8) -> Result<Expr, Error>:
        let mut left = _self.parse_unary()?
        loop:
            match _self.get_binary_op():
                Some((op, prec)) =>
                    if (prec < min_prec):
                        break
                    _self.advance()
                    let right = _self.parse_binary((prec + 1))?
                    let span = left.span().merge(right.span())
                    left = aggregate_init("Expr__Binary", left = Box__new_(left), op = op, right = Box__new_(right), span = span)
                _ =>
                    break
        Ok(left)

    fn parse_unary(_self: &mut Self_) -> Result<Expr, Error>:
        match _self.peek_kind():
            Amp =>
                let s = _self.current_span()
                _self.advance()
                let mutable_ = if _self.check(crate__lexer__TokenKind__Mut):
                    _self.advance()
                    true
                else:
                    false
                Ok(aggregate_init("Expr__Ref", mutable_ = mutable_, value = Box__new_(_self.parse_unary()?), span = s))
            PlusPlus =>
                let start = _self.current_span()
                _self.advance()
                let target = _self.parse_unary()?
                let span = start.merge(target.span())
                _self.make_incdec_expr(target, true, true, span)
            MinusMinus =>
                let start = _self.current_span()
                _self.advance()
                let target = _self.parse_unary()?
                let span = start.merge(target.span())
                _self.make_incdec_expr(target, false, true, span)
            Minus =>
                let s = _self.current_span()
                _self.advance()
                Ok(aggregate_init("Expr__Unary", op = UnaryOp__Neg, operand = Box__new_(_self.parse_unary()?), span = s))
            Not =>
                let s = _self.current_span()
                _self.advance()
                Ok(aggregate_init("Expr__Unary", op = UnaryOp__Not, operand = Box__new_(_self.parse_unary()?), span = s))
            Tilde =>
                let s = _self.current_span()
                _self.advance()
                Ok(aggregate_init("Expr__Unary", op = UnaryOp__BitNot, operand = Box__new_(_self.parse_unary()?), span = s))
            Star =>
                let s = _self.current_span()
                _self.advance()
                Ok(Expr__Deref(Box__new_(_self.parse_unary()?), s))
            Await =>
                let start = _self.current_span()
                _self.advance()
                let expr = _self.parse_unary()?
                Ok(Expr__Await(Box__new_(expr), start.merge(_self.current_span())))
            Send =>
                let start = _self.current_span()
                _self.advance()
                let expr = _self.parse_postfix()?
                match expr:
                    _ =>
                        match (*callee):
                            _ =>
                                let mut data = Vec__new_()
                                for arg in args:
                                    match arg.name:
                                        Some(name) =>
                                            data.push((name, arg.value))
                                        _ =>
                                            return Err(_self.parser_error("Send requires named arguments", arg.span))
                                Ok(aggregate_init("Expr__SendMsg", target = object, message = field, data = data, span = start.merge(span)))
                            _ =>
                                Err(_self.parser_error("Expected method call after send (e.g., actor.message())", span))
                    _ =>
                        Err(_self.parser_error("Expected message call after send", expr.span()))
            _ =>
                _self.parse_postfix()

    fn parse_postfix(_self: &mut Self_) -> Result<Expr, Error>:
        let mut expr = _self.parse_primary()?
        loop:
            match _self.peek_kind():
                LParen =>
                    _self.advance()
                    let args = _self.parse_call_args()?
                    _self.expect(crate__lexer__TokenKind__RParen)?
                    let s = expr.span().merge(_self.current_span())
                    match &expr:
                        Ident(name, ident_span) =>
                            let starts_with_uppercase = name.chars().next().map(none).unwrap_or(false)
                            let all_named = ((!args.is_empty()) && args.iter().all(none))
                            if (starts_with_uppercase && all_named):
                                return Err(_self.parser_error(f"Struct initialization with named arguments is not supported in KAIN. Found '{name}(...)'.\nUse field-by-field assignment instead:\n\nExample:\nlet obj = {name}()\nobj.field1 = value1\nobj.field2 = value2", s))
                        _ =>
                            none
                    match expr:
                        _ =>
                            expr = aggregate_init("Expr__MethodCall", receiver = object, method = field, args = args, span = s)
                        _ =>
                            expr = _self.normalize_special_call(expr, args, s)
                Dot =>
                    _self.advance()
                    let field = _self.parse_ident()?
                    let s = expr.span().merge(_self.current_span())
                    expr = aggregate_init("Expr__Field", object = Box__new_(expr), field = field, span = s)
                QuestionDot =>
                    _self.advance()
                    let field = _self.parse_ident()?
                    let s = expr.span().merge(_self.current_span())
                    expr = _self.make_safe_nav_field_expr(expr, field, s)?
                As =>
                    _self.advance()
                    let target = _self.parse_type()?
                    let s = expr.span().merge(_self.current_span())
                    expr = aggregate_init("Expr__Cast", value = Box__new_(expr), target = target, span = s)
                LBracket =>
                    _self.advance()
                    let idx = _self.parse_expr()?
                    _self.expect(crate__lexer__TokenKind__RBracket)?
                    let s = expr.span().merge(_self.current_span())
                    expr = aggregate_init("Expr__Index", object = Box__new_(expr), index = Box__new_(idx), span = s)
                PlusPlus =>
                    let start = expr.span()
                    _self.advance()
                    let span = start.merge(_self.current_span())
                    expr = _self.make_incdec_expr(expr, true, false, span)?
                MinusMinus =>
                    let start = expr.span()
                    _self.advance()
                    let span = start.merge(_self.current_span())
                    expr = _self.make_incdec_expr(expr, false, false, span)?
                Question =>
                    if _self.question_starts_ternary():
                        break
                    _self.advance()
                    let s = expr.span().merge(_self.current_span())
                    expr = Expr__Try(Box__new_(expr), s)
                Not =>
                    match &expr:
                        Ident(name, _) =>
                            _self.advance()
                            _self.expect(crate__lexer__TokenKind__LParen)?
                            let args = if (!_self.check(crate__lexer__TokenKind__RParen)):
                                let mut args = Vec__new_()
                                args.push(_self.parse_expr()?)
                                while _self.check(crate__lexer__TokenKind__Comma):
                                    _self.advance()
                                    if _self.check(crate__lexer__TokenKind__RParen):
                                        break
                                    args.push(_self.parse_expr()?)
                                args
                            else:
                                Vec__new_()
                            _self.expect(crate__lexer__TokenKind__RParen)?
                            let s = expr.span().merge(_self.current_span())
                            expr = aggregate_init("Expr__MacroCall", name = name.clone(), args = args, span = s)
                        _ =>
                            return Err(_self.parser_error("Macro invocation only allowed on identifiers", _self.current_span()))
                _ =>
                    break
        Ok(expr)

    fn parse_primary(_self: &mut Self_) -> Result<Expr, Error>:
        let span = _self.current_span()
        match _self.peek_kind():
            Int(n) =>
                _self.advance()
                Ok(Expr__Int(n, span))
            Float(n) =>
                _self.advance()
                Ok(Expr__Float(n, span))
            String(s) =>
                let s = s.clone()
                _self.advance()
                Ok(Expr__String(s, span))
            FString(s) =>
                let s = s.clone()
                _self.advance()
                let mut parts = Vec__new_()
                let mut last_idx = 0
                let mut chars = s.char_indices().peekable()
                loop:
                    match chars.next():
                        Some((idx, c)) =>
                            if (c == "{"):
                                if (idx > last_idx):
                                    parts.push(Expr__String(slice(s, last_idx, idx).to_string(), span))
                                let expr_start = (idx + 1)
                                let mut depth = 1
                                let mut expr_end = expr_start
                                loop:
                                    match chars.next():
                                        Some((i, c2)) =>
                                            if (c2 == "{"):
                                                (depth + 1)
                                            elif (c2 == "}"):
                                                (depth + 1)
                                                if (depth == 0):
                                                    expr_end = i
                                                    break
                                        _ =>
                                            break
                                if (depth == 0):
                                    let expr_str = &slice(s, expr_start, expr_end)
                                    let tokens = crate__lexer__Lexer__new_(expr_str).tokenize()?
                                    let expr_span_mapper = crate__diagnostics__SpanMapper__new_(expr_str)
                                    let mut parser = Parser__new_(&tokens, &expr_span_mapper, "<f-string>")
                                    let expr = parser.parse_expr()?
                                    parts.push(expr)
                                    last_idx = (expr_end + 1)
                                else:
                                    return Err(_self.parser_error("Unclosed '{' in f-string", span))
                        _ =>
                            break
                if (last_idx < s.len()):
                    parts.push(Expr__String(slice(s, last_idx, none).to_string(), span))
                Ok(Expr__FString(parts, span))
            True =>
                _self.advance()
                Ok(Expr__Bool(true, span))
            False =>
                _self.advance()
                Ok(Expr__Bool(false, span))
            None =>
                _self.advance()
                Ok(Expr__None(span))
            Ident(s) =>
                let name = s.clone()
                _self.advance()
                if _self.check(crate__lexer__TokenKind__ColonColon):
                    _self.advance()
                    let variant = _self.parse_ident()?
                    let fields = if _self.check(crate__lexer__TokenKind__LParen):
                        _self.advance()
                        _self.skip_newlines()
                        let mut items = Vec__new_()
                        if (!_self.check(crate__lexer__TokenKind__RParen)):
                            items.push(_self.parse_expr()?)
                            while _self.check(crate__lexer__TokenKind__Comma):
                                _self.advance()
                                if _self.check(crate__lexer__TokenKind__RParen):
                                    break
                                items.push(_self.parse_expr()?)
                        _self.expect(crate__lexer__TokenKind__RParen)?
                        if items.is_empty():
                            EnumVariantFields__Unit
                        else:
                            EnumVariantFields__Tuple(items)
                    elif _self.check(crate__lexer__TokenKind__LBrace):
                        _self.advance()
                        let mut fields = Vec__new_()
                        _self.skip_newlines()
                        let indented = if _self.check(crate__lexer__TokenKind__Indent):
                            _self.advance()
                            true
                        else:
                            false
                        while ((!_self.check(crate__lexer__TokenKind__RBrace)) && (!_self.at_end())):
                            if (indented && _self.check(crate__lexer__TokenKind__Dedent)):
                                break
                            let field_name = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            let field_value = _self.parse_expr()?
                            fields.push((field_name, field_value))
                            if ((!_self.check(crate__lexer__TokenKind__RBrace)) && (((!indented) || (!_self.check(crate__lexer__TokenKind__Dedent))))):
                                if _self.check(crate__lexer__TokenKind__Comma):
                                    _self.advance()
                            _self.skip_newlines()
                        if indented:
                            _self.expect(crate__lexer__TokenKind__Dedent)?
                        _self.expect(crate__lexer__TokenKind__RBrace)?
                        EnumVariantFields__Struct(fields)
                    else:
                        EnumVariantFields__Unit
                    return Ok(aggregate_init("Expr__EnumVariant", enum_name = name, variant = variant, fields = fields, span = span.merge(_self.current_span())))
                let saved_pos_for_check = _self.pos
                _self.skip_formatting()
                if (_self.check(crate__lexer__TokenKind__LBrace) && (!_self.capabilities.supports_parser_struct_literals())):
                    _self.pos = saved_pos_for_check
                    return Err(_self.parser_error("Struct literal syntax is not supported in KAIN. Found '{name} { ... }'.\nUse field-by-field assignment instead:\n\nExample:\nlet obj = {name}()\nobj.field1 = value1\nobj.field2 = value2", span))
                _self.pos = saved_pos_for_check
                Ok(Expr__Ident(name, span))
            SelfLower =>
                _self.advance()
                Ok(Expr__Ident("self".to_string(), span))
            SelfUpper =>
                _self.advance()
                Ok(Expr__Ident("Self".to_string(), span))
            LParen =>
                _self.advance()
                if _self.check(crate__lexer__TokenKind__RParen):
                    _self.advance()
                    Ok(Expr__Tuple([], span.merge(_self.current_span())))
                else:
                    let first = _self.parse_expr()?
                    if _self.check(crate__lexer__TokenKind__Comma):
                        _self.advance()
                        let mut items = [first]
                        while (!_self.check(crate__lexer__TokenKind__RParen)):
                            items.push(_self.parse_expr()?)
                            if (!_self.check(crate__lexer__TokenKind__RParen)):
                                _self.expect(crate__lexer__TokenKind__Comma)?
                        _self.expect(crate__lexer__TokenKind__RParen)?
                        Ok(Expr__Tuple(items, span.merge(_self.current_span())))
                    else:
                        _self.expect(crate__lexer__TokenKind__RParen)?
                        Ok(Expr__Paren(Box__new_(first), span.merge(_self.current_span())))
            LBracket =>
                _self.advance()
                _self.skip_newlines()
                let indented = if _self.check(crate__lexer__TokenKind__Indent):
                    _self.advance()
                    true
                else:
                    false
                let mut items = []
                while ((!_self.check(crate__lexer__TokenKind__RBracket)) && (!_self.at_end())):
                    if (indented && _self.check(crate__lexer__TokenKind__Dedent)):
                        break
                    _self.skip_newlines()
                    if _self.check(crate__lexer__TokenKind__RBracket):
                        break
                    items.push(_self.parse_expr()?)
                    _self.skip_newlines()
                    if ((!_self.check(crate__lexer__TokenKind__RBracket)) && (!_self.check(crate__lexer__TokenKind__Dedent))):
                        if _self.check(crate__lexer__TokenKind__Comma):
                            _self.advance()
                            _self.skip_newlines()
                if indented:
                    if _self.check(crate__lexer__TokenKind__Dedent):
                        _self.advance()
                _self.skip_newlines()
                _self.expect(crate__lexer__TokenKind__RBracket)?
                Ok(Expr__Array(items, span))
            Comptime =>
                _self.advance()
                _self.expect(crate__lexer__TokenKind__Colon)?
                let body = _self.parse_block()?
                Ok(Expr__Comptime(Box__new_(Expr__Block(body, span)), span))
            Pipe =>
                _self.advance()
                let mut params = Vec__new_()
                while (!_self.check(crate__lexer__TokenKind__Pipe)):
                    let name = _self.parse_ident()?
                    params.push(aggregate_init("Param", name = name, ty = Type__Infer(span), mutable_ = false, default_ = None, span = span))
                    if (!_self.check(crate__lexer__TokenKind__Pipe)):
                        _self.expect(crate__lexer__TokenKind__Comma)?
                _self.expect(crate__lexer__TokenKind__Pipe)?
                let body = _self.parse_expr()?
                Ok(aggregate_init("Expr__Lambda", params = params, return_type = None, body = Box__new_(body), span = span.merge(_self.current_span())))
            Match =>
                _self.parse_match()
            Spawn =>
                _self.advance()
                let actor_ = _self.parse_ident()?
                _self.expect(crate__lexer__TokenKind__LParen)?
                let args = _self.parse_call_args()?
                _self.expect(crate__lexer__TokenKind__RParen)?
                let mut init = Vec__new_()
                for arg in args:
                    match arg.name:
                        Some(name) =>
                            init.push((name, arg.value))
                        _ =>
                            return Err(_self.parser_error("Spawn requires named arguments", arg.span))
                Ok(aggregate_init("Expr__Spawn", actor_ = actor_, init = init, span = span.merge(_self.current_span())))
            Return =>
                let start = _self.current_span()
                _self.advance()
                let value = if (((((!_self.check_line_end()) && (!_self.check(crate__lexer__TokenKind__Comma))) && (!_self.check(crate__lexer__TokenKind__RParen))) && (!_self.check(crate__lexer__TokenKind__RBrace))) && (!_self.check(crate__lexer__TokenKind__RBracket))):
                    Some(Box__new_(_self.parse_expr()?))
                else:
                    None
                Ok(Expr__Return(value, start.merge(_self.current_span())))
            If =>
                _self.parse_if()
            Lt =>
                let jsx = _self.parse_jsx_element()?
                Ok(Expr__JSX(jsx, span.merge(_self.current_span())))
            Fn =>
                _self.advance()
                _self.expect(crate__lexer__TokenKind__LParen)?
                let mut params = Vec__new_()
                while ((!_self.check(crate__lexer__TokenKind__RParen)) && (!_self.at_end())):
                    let p_span = _self.current_span()
                    let name = _self.parse_ident()?
                    let ty = if _self.check(crate__lexer__TokenKind__Colon):
                        _self.advance()
                        _self.parse_type()?
                    else:
                        Type__Infer(p_span)
                    params.push(aggregate_init("Param", name = name, ty = ty, mutable_ = false, default_ = None, span = p_span))
                    if (!_self.check(crate__lexer__TokenKind__RParen)):
                        _self.expect(crate__lexer__TokenKind__Comma)?
                _self.expect(crate__lexer__TokenKind__RParen)?
                let return_type = if _self.check(crate__lexer__TokenKind__Arrow):
                    _self.advance()
                    Some(_self.parse_type()?)
                else:
                    None
                _self.expect(crate__lexer__TokenKind__Colon)?
                let body = if _self.check(crate__lexer__TokenKind__Return):
                    _self.advance()
                    _self.parse_expr()?
                elif (_self.check(crate__lexer__TokenKind__Indent) || _self.check_newline()):
                    _self.skip_newlines()
                    let block = _self.parse_block()?
                    Expr__Block(block, span)
                else:
                    _self.parse_expr()?
                Ok(aggregate_init("Expr__Lambda", params = params, return_type = return_type, body = Box__new_(body), span = span.merge(_self.current_span())))
            Continue =>
                _self.advance()
                Ok(Expr__Continue(span))
            Break =>
                _self.advance()
                let value = if ((((!_self.check_line_end()) && (!_self.check(crate__lexer__TokenKind__Dedent))) && (!_self.check(crate__lexer__TokenKind__Comma))) && (!_self.check(crate__lexer__TokenKind__RParen))):
                    Some(Box__new_(_self.parse_expr()?))
                else:
                    None
                Ok(Expr__Break(value, span))
            Component =>
                _self.advance()
                Ok(Expr__Ident("component".to_string(), span))
            Shader =>
                _self.advance()
                Ok(Expr__Ident("shader".to_string(), span))
            Actor =>
                _self.advance()
                Ok(Expr__Ident("actor".to_string(), span))
            State =>
                _self.advance()
                Ok(Expr__Ident("state".to_string(), span))
            _ =>
                Err(_self.parser_error(f"Unexpected token: {crate__error__token_kind_to_user_string(&_self.peek_kind())}", span))

    fn normalize_special_call(_self: &Self_, callee: Expr, args: Array<CallArg>, span: crate::span::Span) -> Expr:
        match &callee:
            Ident(name, _) =>
                if args.iter().all(none):
                    match (name.as_str(), args.len()):
                        ("addr_of", 1) =>
                            let mut values = args.into_iter()
                            let value = values.next().expect("addr_of must have first arg").value
                            let pointee_ty = values.next().and_then(none)
                            return aggregate_init("Expr__AddrOf", value = Box__new_(value), pointee_ty = pointee_ty, span = span)
                        ("ptr_offset", 2) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("ptr_offset must have first arg").value
                            let offset = values.next().expect("ptr_offset must have second arg").value
                            let element_ty = values.next().and_then(none)
                            return aggregate_init("Expr__PtrOffset", pointer = Box__new_(pointer), offset = Box__new_(offset), element_ty = element_ty, span = span)
                        ("mem_load", 1) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("mem_load must have arg").value
                            let load_ty = values.next().and_then(none)
                            return aggregate_init("Expr__MemLoad", pointer = Box__new_(pointer), load_ty = load_ty, span = span)
                        ("mem_store", 2) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("mem_store must have first arg").value
                            let value = values.next().expect("mem_store must have second arg").value
                            let store_ty = values.next().and_then(none)
                            return aggregate_init("Expr__MemStore", pointer = Box__new_(pointer), value = Box__new_(value), store_ty = store_ty, span = span)
                        ("sizeof_type", 1) =>
                            let mut values = args.into_iter()
                            let target = values.next().and_then(none).expect("sizeof_type must have parseable type arg")
                            return aggregate_init("Expr__SizeOfType", target = target, span = span)
                        ("alignof_type", 1) =>
                            let mut values = args.into_iter()
                            let target = values.next().and_then(none).expect("alignof_type must have parseable type arg")
                            return aggregate_init("Expr__AlignOfType", target = target, span = span)
                        ("alloca", 1) =>
                            let mut values = args.into_iter()
                            let ty = values.next().and_then(none).expect("alloca must have parseable type arg")
                            return aggregate_init("Expr__Alloca", ty = ty, span = span)
                        ("uninit", 1) =>
                            let mut values = args.into_iter()
                            let ty = values.next().and_then(none).expect("uninit must have parseable type arg")
                            return aggregate_init("Expr__Uninit", ty = ty, span = span)
                        ("alloc", 1) =>
                            let zeroed = (name == "alloc_zeroed")
                            let mut values = args.into_iter()
                            let size = values.next().expect("alloc must have size arg").value
                            let ty = values.next().and_then(none)
                            return aggregate_init("Expr__Alloc", size = Box__new_(size), ty = ty, zeroed = zeroed, span = span)
                        ("realloc_mem", 2) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("realloc_mem must have pointer arg").value
                            let size = values.next().expect("realloc_mem must have size arg").value
                            let ty = values.next().and_then(none)
                            return aggregate_init("Expr__Realloc", pointer = Box__new_(pointer), size = Box__new_(size), ty = ty, zeroed_new = false, span = span)
                        _ =>
                            let __selfhost_empty = none
            _ =>
                none
        match &callee:
            Ident(name, _) =>
                if ((name == "aggregate_init") && (!args.is_empty())):
                    let mut values = args.into_iter()
                    let ty = values.next().and_then(none).expect("aggregate_init must have parseable type arg")
                    let mut zero_fill_rest = true
                    let mut fields = Vec__new_()
                    for arg in values:
                        match (&arg.name, &arg.value):
                            (None, Bool(value, _)) =>
                                zero_fill_rest = (*value)
                            (Some(name), value) =>
                                fields.push((name.clone(), value.clone()))
                            _ =>
                                let __selfhost_empty = none
                    return aggregate_init("Expr__AggregateInit", ty = ty, fields = fields, zero_fill_rest = zero_fill_rest, span = span)
            _ =>
                none
        aggregate_init("Expr__Call", callee = Box__new_(callee), args = args, span = span)

    fn parse_type_hint_arg(_self: &Self_, expr: &Expr, span: crate::span::Span) -> Option<Type>:
        match expr:
            String(value, _) =>
                _self.parse_type_hint_string(value, span)
            Ident(value, _) =>
                _self.parse_type_hint_string(value, span)
            _ =>
                None

    fn parse_type_hint_string(_self: &Self_, value: &String, span: crate::span::Span) -> Option<Type>:
        let tokens = crate__lexer__Lexer__new_(value).tokenize().ok()?
        let span_mapper = crate__diagnostics__SpanMapper__new_(value)
        let mut parser = Parser__new_(&tokens, &span_mapper, "<memory-type-hint>")
        let ty = parser.parse_type().ok()?
        if (!parser.check(crate__lexer__TokenKind__Eof)):
            return None
        Some(Self___re_span_type(ty, span))

    fn re_span_type(ty: Type, span: crate::span::Span) -> Type:
        match ty:
            _ =>
                aggregate_init("Type__Named", name = name, generics = generics.into_iter().map(none).collect(), span = span)
            Array(inner, size, _) =>
                Type__Array(Box__new_(Self___re_span_type((*inner), span)), size, span)
            Slice(inner, _) =>
                Type__Slice(Box__new_(Self___re_span_type((*inner), span)), span)
            Tuple(types, _) =>
                Type__Tuple(types.into_iter().map(none).collect(), span)
            _ =>
                aggregate_init("Type__Ref", mutable_ = mutable_, inner = Box__new_(Self___re_span_type((*inner), span)), lifetime = lifetime, span = span)
            _ =>
                aggregate_init("Type__Ptr", mutable_ = mutable_, inner = Box__new_(Self___re_span_type((*inner), span)), provenance = provenance, span = span)
            _ =>
                aggregate_init("Type__Function", params = params.into_iter().map(none).collect(), return_type = Box__new_(Self___re_span_type((*return_type), span)), effects = effects, span = span)
            Option(inner, _) =>
                Type__Option(Box__new_(Self___re_span_type((*inner), span)), span)
            Result(ok, err, _) =>
                Type__Result(Box__new_(Self___re_span_type((*ok), span)), Box__new_(Self___re_span_type((*err), span)), span)
            Infer(_) =>
                Type__Infer(span)
            Never(_) =>
                Type__Never(span)
            Unit(_) =>
                Type__Unit(span)
            _ =>
                aggregate_init("Type__Impl", trait_name = trait_name, generics = generics.into_iter().map(none).collect(), span = span)

    fn parse_match(_self: &mut Self_) -> Result<Expr, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Match)?
        let scrutinee = Box__new_(_self.parse_expr()?)
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut arms = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let arm_start = _self.current_span()
            let pattern = _self.parse_pattern()?
            _self.expect(crate__lexer__TokenKind__FatArrow)?
            let body = if (none):
                _self.skip_newlines()
                if _self.check(crate__lexer__TokenKind__Indent):
                    _self.advance()
                    let mut stmts = Vec__new_()
                    while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
                        _self.skip_newlines()
                        if _self.check(crate__lexer__TokenKind__Dedent):
                            break
                        stmts.push(_self.parse_stmt()?)
                        _self.skip_newlines()
                    if _self.check(crate__lexer__TokenKind__Dedent):
                        _self.advance()
                    if (stmts.len() == 1):
                        match &stmts[0]:
                            Expr(e) =>
                                e.clone()
                            _ =>
                                match &stmts[0]:
                                    Return(Some(e), _) =>
                                        e.clone()
                                    _ =>
                                        let block = aggregate_init("Block", stmts = stmts, span = arm_start.merge(_self.current_span()))
                                        Expr__Block(block, arm_start.merge(_self.current_span()))
                    else:
                        let block = aggregate_init("Block", stmts = stmts, span = arm_start.merge(_self.current_span()))
                        Expr__Block(block, arm_start.merge(_self.current_span()))
                else:
                    _self.parse_expr()?
            else:
                _self.parse_expr()?
            arms.push(aggregate_init("MatchArm", pattern = pattern, guard = None, body = body, span = _self.current_span()))
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(aggregate_init("Expr__Match", scrutinee = scrutinee, arms = arms, span = start.merge(_self.current_span())))

    fn parse_if(_self: &mut Self_) -> Result<Expr, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__If)?
        let condition = Box__new_(_self.parse_expr()?)
        _self.expect(crate__lexer__TokenKind__Colon)?
        let is_block = match _self.peek_kind():
            Newline(_) =>
                true
            _ =>
                false
        let then_branch = if is_block:
            _self.parse_block()?
        else:
            let stmt = _self.parse_stmt()?
            aggregate_init("Block", stmts = [stmt], span = start.merge(_self.current_span()))
        let else_branch = _self.parse_if_tail(start)?
        Ok(aggregate_init("Expr__If", condition = condition, then_branch = then_branch, else_branch = else_branch, span = start.merge(_self.current_span())))

    fn parse_if_tail(_self: &mut Self_, start: crate::span::Span) -> Result<Option<ElseBranch>, Error>:
        _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Elif):
            _self.advance()
            let condition = Box__new_(_self.parse_expr()?)
            _self.expect(crate__lexer__TokenKind__Colon)?
            let is_block = match _self.peek_kind():
                Newline(_) =>
                    true
                _ =>
                    false
            let then_branch = if is_block:
                _self.parse_block()?
            else:
                let stmt = _self.parse_stmt()?
                aggregate_init("Block", stmts = [stmt], span = start.merge(_self.current_span()))
            let nested_else = _self.parse_if_tail(start)?
            return Ok(Some(Box__new_(ElseBranch__ElseIf(condition, then_branch, nested_else))))
        if _self.check(crate__lexer__TokenKind__Else):
            _self.advance()
            if _self.check(crate__lexer__TokenKind__If):
                let elif_expr = _self.parse_if()?
                match elif_expr:
                    _ =>
                        return Ok(Some(Box__new_(ElseBranch__ElseIf(condition, then_branch, nested_else))))
                    _ =>
                        none
                return Err(_self.parser_error("Expected if expression after else", _self.current_span()))
            _self.expect(crate__lexer__TokenKind__Colon)?
            let is_block = match _self.peek_kind():
                Newline(_) =>
                    true
                _ =>
                    false
            if is_block:
                return Ok(Some(Box__new_(ElseBranch__Else(_self.parse_block()?))))
            let stmt = _self.parse_stmt()?
            return Ok(Some(Box__new_(ElseBranch__Else(aggregate_init("Block", stmts = [stmt], span = start.merge(_self.current_span()))))))
        Ok(None)

    fn parse_pattern(_self: &mut Self_) -> Result<Pattern, Error>:
        let span = _self.current_span()
        match _self.peek_kind():
            Ident(s) =>
                if (s == "_"):
                    _self.advance()
                    Ok(Pattern__Wildcard(span))
                else:
                    none
            Ident(s) =>
                let name = s.clone()
                _self.advance()
                if _self.check(crate__lexer__TokenKind__ColonColon):
                    _self.advance()
                    let variant = _self.parse_ident()?
                    let fields = if _self.check(crate__lexer__TokenKind__LParen):
                        _self.advance()
                        let mut patterns = Vec__new_()
                        while (!_self.check(crate__lexer__TokenKind__RParen)):
                            patterns.push(_self.parse_pattern()?)
                            if (!_self.check(crate__lexer__TokenKind__RParen)):
                                _self.expect(crate__lexer__TokenKind__Comma)?
                        _self.expect(crate__lexer__TokenKind__RParen)?
                        VariantPatternFields__Tuple(patterns)
                    elif _self.check(crate__lexer__TokenKind__LBrace):
                        _self.advance()
                        let mut fields = Vec__new_()
                        while (!_self.check(crate__lexer__TokenKind__RBrace)):
                            let fname = _self.parse_ident()?
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            let pat = _self.parse_pattern()?
                            fields.push((fname, pat))
                            if (!_self.check(crate__lexer__TokenKind__RBrace)):
                                _self.expect(crate__lexer__TokenKind__Comma)?
                        _self.expect(crate__lexer__TokenKind__RBrace)?
                        VariantPatternFields__Struct(fields)
                    else:
                        VariantPatternFields__Unit
                    Ok(aggregate_init("Pattern__Variant", enum_name = Some(name), variant = variant, fields = fields, span = span.merge(_self.current_span())))
                elif _self.check(crate__lexer__TokenKind__LParen):
                    _self.advance()
                    let mut patterns = Vec__new_()
                    while (!_self.check(crate__lexer__TokenKind__RParen)):
                        patterns.push(_self.parse_pattern()?)
                        if (!_self.check(crate__lexer__TokenKind__RParen)):
                            _self.expect(crate__lexer__TokenKind__Comma)?
                    _self.expect(crate__lexer__TokenKind__RParen)?
                    Ok(aggregate_init("Pattern__Variant", enum_name = None, variant = name, fields = VariantPatternFields__Tuple(patterns), span = span.merge(_self.current_span())))
                else:
                    _self.validate_identifier(&name, span)?
                    Ok(aggregate_init("Pattern__Binding", name = name, mutable_ = false, span = span))
            Mut =>
                _self.advance()
                let name = _self.parse_ident()?
                Ok(aggregate_init("Pattern__Binding", name = name, mutable_ = true, span = span.merge(_self.current_span())))
            Int(n) =>
                _self.advance()
                Ok(Pattern__Literal(Expr__Int(n, span)))
            String(s) =>
                let string_val = s.clone()
                _self.advance()
                Ok(Pattern__Literal(Expr__String(string_val, span)))
            True =>
                _self.advance()
                Ok(Pattern__Literal(Expr__Bool(true, span)))
            False =>
                _self.advance()
                Ok(Pattern__Literal(Expr__Bool(false, span)))
            LParen =>
                _self.advance()
                let mut patterns = Vec__new_()
                while (!_self.check(crate__lexer__TokenKind__RParen)):
                    patterns.push(_self.parse_pattern()?)
                    if (!_self.check(crate__lexer__TokenKind__RParen)):
                        _self.expect(crate__lexer__TokenKind__Comma)?
                _self.expect(crate__lexer__TokenKind__RParen)?
                Ok(Pattern__Tuple(patterns, span.merge(_self.current_span())))
            LBracket =>
                _self.advance()
                let mut patterns = Vec__new_()
                while (!_self.check(crate__lexer__TokenKind__RBracket)):
                    patterns.push(_self.parse_pattern()?)
                    if (!_self.check(crate__lexer__TokenKind__RBracket)):
                        _self.expect(crate__lexer__TokenKind__Comma)?
                _self.expect(crate__lexer__TokenKind__RBracket)?
                Ok(aggregate_init("Pattern__Slice", patterns = patterns, rest = None, span = span.merge(_self.current_span())))
            _ =>
                Err(_self.parser_error(f"Expected pattern (identifier, integer, string, tuple, or array), found {_self.token_to_user_string(&_self.peek_kind())}", span))

    fn parse_jsx(_self: &mut Self_) -> Result<JSXNode, Error>:
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        _self.skip_newlines()
        let result = _self.parse_jsx_element()?
        _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(result)

    fn parse_jsx_element(_self: &mut Self_) -> Result<JSXNode, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Lt)?
        let tag = _self.parse_jsx_tag_name()?
        let mut attrs = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Gt)) && (!_self.check(crate__lexer__TokenKind__Slash))):
            let name = _self.parse_jsx_attribute_name()?
            _self.expect(crate__lexer__TokenKind__Eq)?
            let value = if _self.check(crate__lexer__TokenKind__LBrace):
                _self.advance()
                let e = if _self.check(crate__lexer__TokenKind__Lt):
                    let jsx = _self.parse_jsx_element()?
                    Expr__JSX(jsx, _self.current_span())
                else:
                    _self.parse_expr()?
                _self.expect(crate__lexer__TokenKind__RBrace)?
                JSXAttrValue__Expr(e)
            else:
                match _self.peek_kind():
                    String(s) =>
                        _self.advance()
                        JSXAttrValue__String(s)
                    _ =>
                        return Err(_self.parser_error("Expected attribute value", _self.current_span()))
            attrs.push(aggregate_init("JSXAttribute", name = name, value = value, span = _self.current_span()))
        if _self.check(crate__lexer__TokenKind__Slash):
            _self.advance()
            _self.expect(crate__lexer__TokenKind__Gt)?
            return Ok(_self.finish_jsx_node(tag, attrs, [], start.merge(_self.current_span())))
        _self.expect(crate__lexer__TokenKind__Gt)?
        let mut children = Vec__new_()
        let mut last_end = _self.tokens.get((_self.pos - 1)).map(none).unwrap_or(0)
        let mut text_buffer = String__new_()
        let mut text_start = _self.current_span()
        while ((!_self.check(crate__lexer__TokenKind__LtSlash)) && (!_self.at_end())):
            let current_span = _self.current_span()
            if (current_span.start > last_end):
                if (!text_buffer.is_empty()):
                    text_buffer.push(" ")
            if _self.check(crate__lexer__TokenKind__LBrace):
                if (!text_buffer.is_empty()):
                    children.push(JSXNode__Text(text_buffer.clone(), text_start.merge(crate__span__Span__new_(last_end, last_end))))
                    text_buffer.clear()
                children.push(_self.parse_jsx_braced_child()?)
                last_end = _self.tokens.get((_self.pos - 1)).map(none).unwrap_or(0)
                text_start = _self.current_span()
            elif _self.check(crate__lexer__TokenKind__Lt):
                if (!text_buffer.is_empty()):
                    children.push(JSXNode__Text(text_buffer.clone(), text_start.merge(crate__span__Span__new_(last_end, last_end))))
                    text_buffer.clear()
                children.push(_self.parse_jsx_element()?)
                last_end = _self.tokens.get((_self.pos - 1)).map(none).unwrap_or(0)
                text_start = _self.current_span()
            else:
                let mut consumed_text = None
                match _self.peek_kind():
                    String(s) =>
                        consumed_text = Some(s)
                    Ident(s) =>
                        consumed_text = Some(s)
                    Int(n) =>
                        consumed_text = Some(n.to_string())
                    Newline(_) =>
                        if ((!text_buffer.is_empty()) && (!text_buffer.ends_with(" "))):
                            text_buffer.push(" ")
                        _self.advance()
                    Colon =>
                        consumed_text = Some(":".to_string())
                    Comma =>
                        consumed_text = Some(",".to_string())
                    Dot =>
                        consumed_text = Some(".".to_string())
                    Question =>
                        consumed_text = Some("?".to_string())
                    QuestionQuestion =>
                        consumed_text = Some("??".to_string())
                    QuestionDot =>
                        consumed_text = Some("?.".to_string())
                    Not =>
                        consumed_text = Some("!".to_string())
                    Minus =>
                        consumed_text = Some("-".to_string())
                    PlusPlus =>
                        consumed_text = Some("++".to_string())
                    MinusMinus =>
                        consumed_text = Some("--".to_string())
                    Eq =>
                        consumed_text = Some("=".to_string())
                    Plus =>
                        consumed_text = Some("+".to_string())
                    Star =>
                        consumed_text = Some("*".to_string())
                    Slash =>
                        consumed_text = Some("/".to_string())
                    Percent =>
                        consumed_text = Some("%".to_string())
                    Amp =>
                        consumed_text = Some("&".to_string())
                    Pipe =>
                        consumed_text = Some("|".to_string())
                    At =>
                        consumed_text = Some("@".to_string())
                    Tilde =>
                        consumed_text = Some("~".to_string())
                    Caret =>
                        consumed_text = Some("^".to_string())
                    LParen =>
                        consumed_text = Some("(".to_string())
                    RParen =>
                        consumed_text = Some(")".to_string())
                    LBracket =>
                        consumed_text = Some("[".to_string())
                    RBracket =>
                        consumed_text = Some("]".to_string())
                    Arrow =>
                        consumed_text = Some("->".to_string())
                    FatArrow =>
                        consumed_text = Some("=>".to_string())
                    ColonColon =>
                        consumed_text = Some("::".to_string())
                    And =>
                        consumed_text = Some("and".to_string())
                    Or =>
                        consumed_text = Some("or".to_string())
                    Gpu =>
                        consumed_text = Some("GPU".to_string())
                    Io =>
                        consumed_text = Some("IO".to_string())
                    Fn =>
                        consumed_text = Some("fn".to_string())
                    Let =>
                        consumed_text = Some("let".to_string())
                    Mut =>
                        consumed_text = Some("mut".to_string())
                    Var =>
                        consumed_text = Some("var".to_string())
                    Const =>
                        consumed_text = Some("const".to_string())
                    If =>
                        consumed_text = Some("if".to_string())
                    Else =>
                        consumed_text = Some("else".to_string())
                    Match =>
                        consumed_text = Some("match".to_string())
                    For =>
                        consumed_text = Some("for".to_string())
                    While =>
                        consumed_text = Some("while".to_string())
                    Loop =>
                        consumed_text = Some("loop".to_string())
                    Break =>
                        consumed_text = Some("break".to_string())
                    Continue =>
                        consumed_text = Some("continue".to_string())
                    Return =>
                        consumed_text = Some("return".to_string())
                    Await =>
                        consumed_text = Some("await".to_string())
                    In =>
                        consumed_text = Some("in".to_string())
                    With =>
                        consumed_text = Some("with".to_string())
                    As =>
                        consumed_text = Some("as".to_string())
                    TypeKw =>
                        consumed_text = Some("type".to_string())
                    Struct =>
                        consumed_text = Some("struct".to_string())
                    Enum =>
                        consumed_text = Some("enum".to_string())
                    Trait =>
                        consumed_text = Some("trait".to_string())
                    Impl =>
                        consumed_text = Some("impl".to_string())
                    Pub =>
                        consumed_text = Some("pub".to_string())
                    Mod =>
                        consumed_text = Some("mod".to_string())
                    Use =>
                        consumed_text = Some("use".to_string())
                    True =>
                        consumed_text = Some("true".to_string())
                    False =>
                        consumed_text = Some("false".to_string())
                    Pure_ =>
                        consumed_text = Some("Pure".to_string())
                    Async_ =>
                        consumed_text = Some("Async".to_string())
                    Component =>
                        consumed_text = Some("component".to_string())
                    Shader =>
                        consumed_text = Some("shader".to_string())
                    Actor =>
                        consumed_text = Some("actor".to_string())
                    Spawn =>
                        consumed_text = Some("spawn".to_string())
                    Test =>
                        consumed_text = Some("test".to_string())
                    Reactive_ =>
                        consumed_text = Some("Reactive".to_string())
                    Unsafe_ =>
                        consumed_text = Some("Unsafe".to_string())
                    Vertex =>
                        consumed_text = Some("vertex".to_string())
                    Fragment =>
                        consumed_text = Some("fragment".to_string())
                    _ =>
                        return Err(_self.parser_error("Unexpected token in JSX child: {crate__error__token_kind_to_user_string(&_self.peek_kind())}. Use strings or {} for text.", _self.current_span()))
                match consumed_text:
                    Some(t) =>
                        if text_buffer.is_empty():
                            text_start = _self.current_span()
                        text_buffer.push_str(&t)
                        _self.advance()
                    _ =>
                        none
                last_end = _self.tokens.get((_self.pos - 1)).map(none).unwrap_or(0)
        if (!text_buffer.is_empty()):
            children.push(JSXNode__Text(text_buffer, text_start.merge(crate__span__Span__new_(last_end, last_end))))
        _self.expect(crate__lexer__TokenKind__LtSlash)?
        let closing_tag = _self.parse_jsx_tag_name()?
        if (closing_tag != tag):
            return Err(_self.parser_error(f"Expected closing tag </{tag}>, found </{closing_tag}>", _self.current_span()))
        _self.expect(crate__lexer__TokenKind__Gt)?
        Ok(_self.finish_jsx_node(tag, attrs, children, start.merge(_self.current_span())))

    fn parse_jsx_tag_name(_self: &mut Self_) -> Result<String, Error>:
        let span = _self.current_span()
        match _self.peek_kind():
            Ident(s) =>
                _self.advance()
                Ok(s)
            Fragment =>
                _self.advance()
                Ok("Fragment".to_string())
            Component =>
                _self.advance()
                Ok("component".to_string())
            other =>
                Err(_self.parser_error(f"Expected JSX tag name, found {crate__error__token_kind_to_user_string(&other)}", span))

    fn parse_jsx_attribute_name(_self: &mut Self_) -> Result<String, Error>:
        let span = _self.current_span()
        match _self.peek_kind():
            Ident(s) =>
                _self.advance()
                Ok(s)
            other =>
                let source = _self.span_mapper.source()
                let text = if ((span.end <= source.len()) && (span.start <= span.end)):
                    &slice(source, span.start, span.end)
                else:
                    ""
                if ((!text.is_empty()) && text.chars().enumerate().all(none)):
                    _self.advance()
                    Ok(text.to_string())
                else:
                    Err(_self.parser_error(f"Expected JSX attribute name, found {crate__error__token_kind_to_user_string(&other)}", span))

    fn finish_jsx_node(_self: &Self_, tag: String, attributes: Array<JSXAttribute>, children: Array<JSXNode>, span: crate::span::Span) -> JSXNode:
        if (tag == "Fragment"):
            return JSXNode__Fragment(children, span)
        if tag.chars().next().is_some_and(none):
            aggregate_init("JSXNode__ComponentCall", name = tag, props = attributes, children = children, span = span)
        else:
            aggregate_init("JSXNode__Element", tag = tag, attributes = attributes, children = children, span = span)

    fn parse_jsx_braced_child(_self: &mut Self_) -> Result<JSXNode, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__LBrace)?
        let node = if _self.check(crate__lexer__TokenKind__If):
            _self.advance()
            let condition = _self.parse_expr()?
            _self.expect(crate__lexer__TokenKind__Colon)?
            let then_branch = _self.parse_jsx_inline_node()?
            let else_branch = if _self.check(crate__lexer__TokenKind__Else):
                _self.advance()
                _self.expect(crate__lexer__TokenKind__Colon)?
                Some(Box__new_(_self.parse_jsx_inline_node()?))
            else:
                None
            aggregate_init("JSXNode__If", condition = Box__new_(condition), then_branch = Box__new_(then_branch), else_branch = else_branch, span = start.merge(_self.current_span()))
        elif _self.check(crate__lexer__TokenKind__For):
            _self.advance()
            let binding = _self.parse_ident()?
            _self.expect(crate__lexer__TokenKind__In)?
            let iter = _self.parse_expr()?
            _self.expect(crate__lexer__TokenKind__Colon)?
            let body = _self.parse_jsx_inline_node()?
            aggregate_init("JSXNode__For", binding = binding, iter = Box__new_(iter), body = Box__new_(body), span = start.merge(_self.current_span()))
        else:
            JSXNode__Expression(Box__new_(_self.parse_expr()?))
        _self.expect(crate__lexer__TokenKind__RBrace)?
        Ok(node)

    fn parse_jsx_inline_node(_self: &mut Self_) -> Result<JSXNode, Error>:
        if _self.check(crate__lexer__TokenKind__Lt):
            _self.parse_jsx_element()
        elif _self.check(crate__lexer__TokenKind__LBrace):
            _self.parse_jsx_braced_child()
        else:
            Ok(JSXNode__Expression(Box__new_(_self.parse_expr()?)))

    fn parse_call_args(_self: &mut Self_) -> Result<Array<CallArg>, Error>:
        let mut args = Vec__new_()
        _self.skip_formatting()
        while ((!_self.check(crate__lexer__TokenKind__RParen)) && (!_self.at_end())):
            let mut name = None
            match _self.peek_kind():
                Ident(s) =>
                    if _self.tokens.get((_self.pos + 1)).map(none).unwrap_or(false):
                        name = Some(s)
                        _self.advance()
                        _self.advance()
                _ =>
                    none
            let value = _self.parse_expr()?
            args.push(aggregate_init("CallArg", name = name, value = value, span = _self.current_span()))
            _self.skip_formatting()
            if (!_self.check(crate__lexer__TokenKind__RParen)):
                _self.expect(crate__lexer__TokenKind__Comma)?
                _self.skip_formatting()
        Ok(args)

    fn parse_visibility(_self: &mut Self_) -> Visibility:
        if _self.check(crate__lexer__TokenKind__Pub):
            _self.advance()
            Visibility__Public
        else:
            Visibility__Private

    fn parse_ident(_self: &mut Self_) -> Result<String, Error>:
        let span = _self.current_span()
        match _self.peek_kind():
            Ident(s) =>
                _self.advance()
                _self.validate_identifier(&s, span)?
                Ok(s)
            SelfLower =>
                _self.advance()
                Ok("self".to_string())
            SelfUpper =>
                _self.advance()
                Ok("Self".to_string())
            Component =>
                _self.advance()
                Ok("component".to_string())
            Shader =>
                _self.advance()
                Ok("shader".to_string())
            Actor =>
                _self.advance()
                Ok("actor".to_string())
            State =>
                _self.advance()
                Ok("state".to_string())
            k =>
                Err(_self.parser_error(f"{crate__error__token_kind_to_user_string(&k)} is a reserved keyword and cannot be used as an identifier. Please choose a different name.", span))
            k =>
                Err(_self.parser_error(f"Expected identifier, got {crate__error__token_kind_to_user_string(&k)}", span))

    fn get_binary_op(_self: &Self_) -> Option<(BinaryOp, u8)>:
        let candidate = match _self.peek_kind():
            Or =>
                Some((BinaryOp__Or, 1))
            And =>
                Some((BinaryOp__And, 2))
            Pipe =>
                Some((BinaryOp__BitOr, 3))
            Caret =>
                Some((BinaryOp__BitXor, 4))
            Amp =>
                Some((BinaryOp__BitAnd, 5))
            EqEq =>
                Some((BinaryOp__Eq, 6))
            NotEq =>
                Some((BinaryOp__Ne, 6))
            Lt =>
                Some((BinaryOp__Lt, 7))
            Gt =>
                Some((BinaryOp__Gt, 7))
            LtEq =>
                Some((BinaryOp__Le, 7))
            GtEq =>
                Some((BinaryOp__Ge, 7))
            Shl =>
                Some((BinaryOp__Shl, 8))
            Shr =>
                Some((BinaryOp__Shr, 8))
            Plus =>
                Some((BinaryOp__Add, 9))
            Minus =>
                Some((BinaryOp__Sub, 9))
            Star =>
                Some((BinaryOp__Mul, 10))
            Slash =>
                Some((BinaryOp__Div, 10))
            Percent =>
                Some((BinaryOp__Mod, 10))
            Power =>
                Some((BinaryOp__Pow, 11))
            _ =>
                None
        candidate.filter(none)

    fn get_assignment_binop(_self: &Self_) -> Option<Option<BinaryOp>>:
        match _self.peek_kind():
            Eq =>
                Some(None)
            PlusEq =>
                Some(Some(BinaryOp__Add))
            MinusEq =>
                Some(Some(BinaryOp__Sub))
            StarEq =>
                Some(Some(BinaryOp__Mul))
            SlashEq =>
                Some(Some(BinaryOp__Div))
            PercentEq =>
                Some(Some(BinaryOp__Mod))
            AmpEq =>
                Some(Some(BinaryOp__BitAnd))
            PipeEq =>
                Some(Some(BinaryOp__BitOr))
            CaretEq =>
                Some(Some(BinaryOp__BitXor))
            ShlEq =>
                Some(Some(BinaryOp__Shl))
            ShrEq =>
                Some(Some(BinaryOp__Shr))
            _ =>
                None

    fn make_incdec_expr(_self: &mut Self_, target: Expr, increment: Bool, prefix: Bool, span: crate::span::Span) -> Result<Expr, Error>:
        if (!none):
            return Err(_self.parser_error("Increment/decrement target must be assignable (identifier, field, index, or dereference)", span))
        let binding = _self.fresh_temp("__kain_incdec")
        let bound_ident = Expr__Ident(binding.clone(), span)
        let op = if increment:
            BinaryOp__Add
        else:
            BinaryOp__Sub
        let updated = aggregate_init("Expr__Binary", left = Box__new_(bound_ident.clone()), op = op, right = Box__new_(Expr__Int(1, span)), span = span)
        let assign_expr = aggregate_init("Expr__Assign", target = Box__new_(target.clone()), value = Box__new_(updated.clone()), span = span)
        let result_expr = if prefix:
            updated
        else:
            bound_ident
        let sequenced = aggregate_init("Expr__Index", object = Box__new_(Expr__Array([assign_expr, result_expr], span)), index = Box__new_(Expr__Int(1, span)), span = span)
        Ok(aggregate_init("Expr__Match", scrutinee = Box__new_(target), arms = [aggregate_init("MatchArm", pattern = aggregate_init("Pattern__Binding", name = binding, mutable_ = false, span = span), guard = None, body = sequenced, span = span)], span = span))

    fn make_null_coalesce_expr(_self: &mut Self_, left: Expr, right: Expr, span: crate::span::Span) -> Result<Expr, Error>:
        let binding = _self.fresh_temp("__kain_coalesce")
        Ok(aggregate_init("Expr__Match", scrutinee = Box__new_(left), arms = [aggregate_init("MatchArm", pattern = Pattern__Literal(Expr__None(span)), guard = None, body = right, span = span), aggregate_init("MatchArm", pattern = aggregate_init("Pattern__Binding", name = binding.clone(), mutable_ = false, span = span), guard = None, body = Expr__Ident(binding, span), span = span)], span = span))

    fn make_safe_nav_field_expr(_self: &mut Self_, object: Expr, field: String, span: crate::span::Span) -> Result<Expr, Error>:
        let binding = _self.fresh_temp("__kain_safe")
        Ok(aggregate_init("Expr__Match", scrutinee = Box__new_(object), arms = [aggregate_init("MatchArm", pattern = Pattern__Literal(Expr__None(span)), guard = None, body = Expr__None(span), span = span), aggregate_init("MatchArm", pattern = aggregate_init("Pattern__Binding", name = binding.clone(), mutable_ = false, span = span), guard = None, body = aggregate_init("Expr__Field", object = Box__new_(Expr__Ident(binding, span)), field = field, span = span), span = span)], span = span))

    fn question_starts_ternary(_self: &Self_) -> Bool:
        let mut offset = 1
        let mut paren_depth = 0
        let mut bracket_depth = 0
        let mut brace_depth = 0
        loop:
            match _self.peek_kind_at(offset):
                Some(kind) =>
                    let at_top_level = (((paren_depth == 0) && (bracket_depth == 0)) && (brace_depth == 0))
                    match kind:
                        LParen =>
                            (paren_depth + 1)
                        RParen =>
                            if (paren_depth == 0):
                                return false
                            (paren_depth + 1)
                        LBracket =>
                            (bracket_depth + 1)
                        RBracket =>
                            if (bracket_depth == 0):
                                return false
                            (bracket_depth + 1)
                        LBrace =>
                            (brace_depth + 1)
                        RBrace =>
                            if (brace_depth == 0):
                                return false
                            (brace_depth + 1)
                        Colon =>
                            if at_top_level:
                                return true
                            else:
                                none
                        Comma =>
                            if at_top_level:
                                return false
                            else:
                                none
                        _ =>
                            let __selfhost_empty = none
                    (offset + 1)
                _ =>
                    break
        false

    fn fresh_temp(_self: &mut Self_, prefix: &String) -> String:
        let name = f"{prefix}{_self.synthetic_counter}"
        (_self.synthetic_counter + 1)
        name

    fn peek_kind_at(_self: &Self_, offset: usize) -> Option<crate::lexer::TokenKind>:
        if (offset < _self.injected_tokens.len()):
            return Some(_self.injected_tokens[offset].kind.clone())
        let base_offset = offset.saturating_sub(_self.injected_tokens.len())
        _self.tokens.get((_self.pos + base_offset)).map(none)

    fn peek_kind(_self: &Self_) -> crate::lexer::TokenKind:
        if (!_self.injected_tokens.is_empty()):
            return _self.injected_tokens[0].kind.clone()
        _self.tokens.get(_self.pos).map(none).unwrap_or(crate__lexer__TokenKind__Eof)

    fn current_span(_self: &Self_) -> crate::span::Span:
        if (!_self.injected_tokens.is_empty()):
            return _self.injected_tokens[0].span
        _self.tokens.get(_self.pos).map(none).unwrap_or(crate__span__Span__new_(0, 0))

    fn at_end(_self: &Self_) -> Bool:
        match _self.peek_kind():
            Eof =>
                true
            _ =>
                false

    fn check(_self: &Self_, k: crate::lexer::TokenKind) -> Bool:
        (std__mem__discriminant(&_self.peek_kind()) == std__mem__discriminant(&k))

    fn check_line_end(_self: &Self_) -> Bool:
        match _self.peek_kind():
            Newline(_) =>
                true
            _ =>
                false

    fn advance(_self: &mut Self_):
        if (!_self.injected_tokens.is_empty()):
            _self.injected_tokens.remove(0)
            return
        if (!_self.at_end()):
            (_self.pos + 1)

    fn skip_newlines(_self: &mut Self_):
        loop:
            match _self.peek_kind():
                Newline(_) =>
                    _self.advance()
                _ =>
                    break

    fn check_newline(_self: &Self_) -> Bool:
        match _self.peek_kind():
            Newline(_) =>
                true
            _ =>
                false

    fn skip_formatting(_self: &mut Self_):
        while none:
            _self.advance()

    fn inject_token(_self: &mut Self_, token: crate::lexer::Token):
        _self.injected_tokens.push(token)

    fn expect(_self: &mut Self_, k: crate::lexer::TokenKind) -> Result<(), Error>:
        if _self.check(k.clone()):
            _self.advance()
            Ok(none)
        else:
            Err(_self.parser_error(f"Expected {crate__error__token_kind_to_user_string(&k)}, got {crate__error__token_kind_to_user_string(&_self.peek_kind())}", _self.current_span()))

    fn parse_graph_runtime(_self: &mut Self_, attributes: Array<Attribute>) -> Result<Item, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Struct)?
        let name = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut graph_data = None
        let mut node_types = Vec__new_()
        let mut instance = None
        let mut pin_config = None
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let nested_attrs = _self.parse_attributes()?
            if nested_attrs.iter().any(none):
                graph_data = Some(_self.parse_graph_data(nested_attrs)?)
            elif nested_attrs.iter().any(none):
                node_types.push(_self.parse_node_data(nested_attrs)?)
            elif nested_attrs.iter().any(none):
                instance = Some(_self.parse_graph_instance(nested_attrs)?)
            elif nested_attrs.iter().any(none):
                pin_config = Some(_self.parse_pin_config(nested_attrs)?)
            else:
                return Err(_self.parser_error(f"Expected @graph_data, @node_data, @instance, or @pin_config attribute in graph runtime body, found {_self.token_to_user_string(&_self.peek_kind())}. Graph runtimes define the execution model for custom graph editors", _self.current_span()))
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(Item__GraphRuntime(aggregate_init("GraphRuntimeDef", name = name, attributes = attributes, graph_data = graph_data, node_types = node_types, instance = instance, pin_config = pin_config, span = start.merge(_self.current_span()))))

    fn parse_graph_data(_self: &mut Self_, attributes: Array<Attribute>) -> Result<GraphDataDef, Error>:
        let start = _self.current_span()
        _self.expect(crate__lexer__TokenKind__Struct)?
        let _ = _self.parse_ident()?
        _self.expect(crate__lexer__TokenKind__Colon)?
        _self.skip_newlines()
        _self.expect(crate__lexer__TokenKind__Indent)?
        let mut properties = Vec__new_()
        let mut methods = Vec__new_()
        while ((!_self.check(crate__lexer__TokenKind__Dedent)) && (!_self.at_end())):
            _self.skip_newlines()
            if _self.check(crate__lexer__TokenKind__Dedent):
                break
            let field_attrs = _self.parse_attributes()?
            if _self.check(crate__lexer__TokenKind__Fn):
                match (_self.parse_function(Visibility__Public)?):
                    Function(f) =>
                        methods.push(f)
                    _ =>
                        none
            else:
                let prop_name = _self.parse_ident()?
                _self.expect(crate__lexer__TokenKind__Colon)?
                let prop_ty = _self.parse_type()?
                let default_ = if _self.check(crate__lexer__TokenKind__Eq):
                    _self.advance()
                    Some(_self.parse_expr()?)
                else:
                    None
                properties.push(aggregate_init("Field", name = prop_name, ty = prop_ty, attributes = field_attrs, visibility = Visibility__Public, default_ = default_, weak_ = false, span = _self.current_span()))
            _self.skip_newlines()
        if _self.check(crate__lexer__TokenKind__Dedent):
            _self.advance()
        Ok(aggregate_init("GraphDataDef", properties = properties, methods = methods, attributes = attributes, span = start.merge(_self.current_span())))

    fn parse_node_data(_self: &mut Self_, attributes: Array<Attribute>) -> Result<NodeDataDef, Error>:
        let start = _self.current_span()
