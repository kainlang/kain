                        "inputs" =>
                            _self.advance()
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            inputs = _self.parse_pin_list()?
                        "outputs" =>
                            _self.advance()
                            _self.expect(crate__lexer__TokenKind__Colon)?
                            outputs = _self.parse_pin_list()?
                        "properties" =>
