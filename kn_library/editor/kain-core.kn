impl Default for StdLib:
    fn default_() -> Self_:
        Self___new_()


fn find_stdlib_search_roots() -> Array<std::path::PathBuf>:
    let __selfhost_nested_use_ = none
    let __selfhost_nested_use_ = none
    let mut roots = Vec__new_()
    match std__env__var_("KAIN_STDLIB_PATH"):
        Ok(env_path) =>
            let path = std__path__PathBuf__from(env_path)
            if path.exists():
                roots.push(path)
                return roots
        _ =>
            none
    match std__env__current_exe():
        Ok(exe_path) =>
            match exe_path.parent():
                Some(mut current) =>
                    loop:
                        let stdlib_dir = current.join("stdlib")
                        if (stdlib_dir.exists() && stdlib_dir.is_dir()):
                            roots.push(stdlib_dir)
                            break
                        match current.parent():
                            Some(parent) =>
                                current = parent
                            _ =>
                                break
                _ =>
                    none
        _ =>
            none
    match std__env__current_dir():
        Ok(mut current) =>
            loop:
                let stdlib_dir = current.join("stdlib")
                if (stdlib_dir.exists() && stdlib_dir.is_dir()):
                    if (!roots.iter().any(none)):
                        roots.push(stdlib_dir)
                    break
                match current.parent():
                    Some(parent) =>
                        current = parent.to_path_buf()
                    _ =>
                        break
        _ =>
            none
    roots

fn load_kn_files_from_dir(path: &std::path::Path) -> Option<String>:
    let __selfhost_nested_use_ = none
    let entries = match std__fs__read_dir(path):
        Ok(entries) =>
            entries
        Err(_) =>
            return None
    let mut kn_files: Array<(String, String)> = Vec__new_()
    for entry in entries:
        let entry = match entry:
            Ok(e) =>
                e
            Err(_) =>
                continue
        let path = entry.path()
        if path.is_file():
            match path.file_name():
                Some(filename) =>
                    let filename_str = filename.to_string_lossy()
                    if filename_str.ends_with(".kn"):
                        if filename_str.to_lowercase().contains("readme"):
                            continue
                        match std__fs__read_to_string(&path):
                            Ok(content) =>
                                kn_files.push((filename_str.to_string(), content))
                            Err(_) =>
                                eprintln(f"Warning: Could not read stdlib file: {path.display()}")
                                continue
                _ =>
                    none
    if kn_files.is_empty():
        return None
    kn_files.sort_by(none)
    let concatenated = kn_files.into_iter().map(none).collect().join("\n")
    Some(concatenated)

const DEFAULT_PROFILE_ORDER: &[&String] = &["ue5", ""]

const TARGET_PROFILE_ORDER: &[(crate::CompileTarget, &[&String])] = &[(crate__CompileTarget__Ue5, &["ue5", ""]), (crate__CompileTarget__Ue5Editor, &["ue5", ""]), (crate__CompileTarget__Usf, &["ue5", ""]), (crate__CompileTarget__Hlsl, &["ue5", ""]), (crate__CompileTarget__Spirv, &["ue5", ""]), (crate__CompileTarget__Wasm, &[""]), (crate__CompileTarget__Js, &[""]), (crate__CompileTarget__Ts, &[""]), (crate__CompileTarget__Hybrid, &[""]), (crate__CompileTarget__Llvm, &[""]), (crate__CompileTarget__Rust, &[""]), (crate__CompileTarget__Cpp, &[""]), (crate__CompileTarget__Interpret, &[""]), (crate__CompileTarget__Test, &[""]), (crate__CompileTarget__Ks, &[""])]

fn resolve_profile_path(root: &std::path::Path, profile: &String) -> std::path::PathBuf:
    if (profile.trim().is_empty() || profile.eq_ignore_ascii_case("root")):
        return root.to_path_buf()
    root.join(profile)

fn parse_profile_env_override() -> Option<Array<String>>:
    let raw = std__env__var_("KAIN_STDLIB_PROFILE").ok()?
    let profiles = raw.split(",").map(str__trim).filter(none).map(str__to_string).collect()
    if profiles.is_empty():
        None
    else:
        Some(profiles)

fn load_stdlib_from_profiles(search_roots: &[std::path::PathBuf], profiles: &[String]) -> String:
    for root in search_roots:
        for profile in profiles:
            let candidate_dir = resolve_profile_path(root, profile)
            if (candidate_dir.exists() && candidate_dir.is_dir()):
                match load_kn_files_from_dir(&candidate_dir):
                    Some(stdlib_source) =>
                        eprintln(f"Loaded stdlib from: {candidate_dir.display()}")
                        return stdlib_source
                    _ =>
                        none
    String__new_()

fn target_profiles(target: crate::CompileTarget) -> &[&String]:
    TARGET_PROFILE_ORDER.iter().find(none).map(none).unwrap_or(DEFAULT_PROFILE_ORDER)

fn load_stdlib() -> String:
    let search_roots = find_stdlib_search_roots()
    if search_roots.is_empty():
        return String__new_()
    let profiles = parse_profile_env_override().unwrap_or_else(none)
    load_stdlib_from_profiles(&search_roots, &profiles)

fn load_stdlib_for_target(target: crate::CompileTarget) -> String:
    let search_roots = find_stdlib_search_roots()
    if search_roots.is_empty():
        return String__new_()
    let profiles = parse_profile_env_override().unwrap_or_else(none)
    load_stdlib_from_profiles(&search_roots, &profiles)

mod tests:
    fn create_test_stdlib_dir(temp_dir: &tempfile::TempDir) -> std::path::PathBuf:
        let stdlib_dir = temp_dir.path().join("stdlib")
        std__fs__create_dir(&stdlib_dir).unwrap()
        stdlib_dir

    fn create_kn_file(dir: &std::path::Path, name: &String, content: &String):
        let file_path = dir.join(name)
        std__fs__write(file_path, content).unwrap()

    fn test_find_stdlib_from_env_var():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        std__env__set_var("KAIN_STDLIB_PATH", stdlib_dir.to_str().unwrap())
        let roots = find_stdlib_search_roots()
        if (roots.len() != 1):
            panic("assert_eq! failed")
        if (roots[0] != stdlib_dir):
            panic("assert_eq! failed")
        std__env__remove_var("KAIN_STDLIB_PATH")

    fn test_find_stdlib_env_var_takes_priority():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        std__env__set_var("KAIN_STDLIB_PATH", stdlib_dir.to_str().unwrap())
        let roots = find_stdlib_search_roots()
        if (roots.len() != 1):
            panic("assert_eq! failed")
        if (roots[0] != stdlib_dir):
            panic("assert_eq! failed")
        std__env__remove_var("KAIN_STDLIB_PATH")

    fn test_find_stdlib_invalid_env_var_falls_back():
        std__env__set_var("KAIN_STDLIB_PATH", "/nonexistent/path/to/stdlib")
        let roots = find_stdlib_search_roots()
        if (!(roots.is_empty() || (!roots.is_empty()))):
            panic("assert! failed")
        std__env__remove_var("KAIN_STDLIB_PATH")

    fn test_load_kn_files_alphabetical_order():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        create_kn_file(&stdlib_dir, "zebra.kn", "// zebra content")
        create_kn_file(&stdlib_dir, "alpha.kn", "// alpha content")
        create_kn_file(&stdlib_dir, "middle.kn", "// middle content")
        let result = load_kn_files_from_dir(&stdlib_dir).unwrap()
        if (!result.contains("// alpha content")):
            panic("assert! failed")
        if (!result.contains("// middle content")):
            panic("assert! failed")
        if (!result.contains("// zebra content")):
            panic("assert! failed")
        let alpha_pos = result.find("// alpha content").unwrap()
        let middle_pos = result.find("// middle content").unwrap()
        let zebra_pos = result.find("// zebra content").unwrap()
        if (!(alpha_pos < middle_pos)):
            panic("assert! failed")
        if (!(middle_pos < zebra_pos)):
            panic("assert! failed")

    fn test_load_kn_files_excludes_readme():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        create_kn_file(&stdlib_dir, "README.kn", "// readme content")
        create_kn_file(&stdlib_dir, "readme.kn", "// lowercase readme")
        create_kn_file(&stdlib_dir, "ReadMe.kn", "// mixed case readme")
        create_kn_file(&stdlib_dir, "valid.kn", "// valid content")
        let result = load_kn_files_from_dir(&stdlib_dir).unwrap()
        if (!result.contains("// valid content")):
            panic("assert! failed")
        if (!(!result.contains("// readme content"))):
            panic("assert! failed")
        if (!(!result.contains("// lowercase readme"))):
            panic("assert! failed")
        if (!(!result.contains("// mixed case readme"))):
            panic("assert! failed")

    fn test_load_kn_files_multiple_files():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        create_kn_file(&stdlib_dir, "file1.kn", "content1")
        create_kn_file(&stdlib_dir, "file2.kn", "content2")
        create_kn_file(&stdlib_dir, "file3.kn", "content3")
        let result = load_kn_files_from_dir(&stdlib_dir).unwrap()
        if (!result.contains("content1")):
            panic("assert! failed")
        if (!result.contains("content2")):
            panic("assert! failed")
        if (!result.contains("content3")):
            panic("assert! failed")
        let lines: Array<&String> = result.split("\n").collect()
        if (!(lines.len() >= 3)):
            panic("assert! failed")

    fn test_load_kn_files_empty_directory():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        let result = load_kn_files_from_dir(&stdlib_dir)
        if (!result.is_none()):
            panic("assert! failed")

    fn test_load_kn_files_no_kn_files():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        std__fs__write(stdlib_dir.join("file.txt"), "text content").unwrap()
        std__fs__write(stdlib_dir.join("file.rs"), "rust content").unwrap()
        let result = load_kn_files_from_dir(&stdlib_dir)
        if (!result.is_none()):
            panic("assert! failed")

    fn test_load_kn_files_nonexistent_directory():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let nonexistent = temp_dir.path().join("nonexistent")
        let result = load_kn_files_from_dir(&nonexistent)
        if (!result.is_none()):
            panic("assert! failed")

    fn test_load_stdlib_graceful_degradation_no_panic():
        std__env__set_var("KAIN_STDLIB_PATH", "Z:\\absolutely\\nonexistent\\path\\that\\does\\not\\exist\\anywhere")
        let result = load_stdlib()
        if (!(result.is_empty() || (!result.is_empty()))):
            panic("assert! failed")
        std__env__remove_var("KAIN_STDLIB_PATH")

    fn test_load_stdlib_truly_empty_when_not_found():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let isolated_path = temp_dir.path().join("isolated")
        std__fs__create_dir(&isolated_path).unwrap()
        std__env__set_var("KAIN_STDLIB_PATH", isolated_path.to_str().unwrap())
        let result = load_stdlib()
        if (result != ""):
            panic("assert_eq! failed")
        std__env__remove_var("KAIN_STDLIB_PATH")

    fn test_load_stdlib_prefers_ue5_subdirectory():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        create_kn_file(&stdlib_dir, "root.kn", "// root content")
        let ue5_dir = stdlib_dir.join("ue5")
        std__fs__create_dir(&ue5_dir).unwrap()
        create_kn_file(&ue5_dir, "ue5.kn", "// ue5 content")
        std__env__set_var("KAIN_STDLIB_PATH", stdlib_dir.to_str().unwrap())
        let result = load_stdlib()
        if (!result.contains("// ue5 content")):
            panic("assert! failed")
        if (!(!result.contains("// root content"))):
            panic("assert! failed")
        std__env__remove_var("KAIN_STDLIB_PATH")

    fn test_load_stdlib_falls_back_to_root():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        create_kn_file(&stdlib_dir, "root.kn", "// root content")
        std__env__set_var("KAIN_STDLIB_PATH", stdlib_dir.to_str().unwrap())
        let result = load_stdlib()
        if (!result.contains("// root content")):
            panic("assert! failed")
        std__env__remove_var("KAIN_STDLIB_PATH")

    fn test_load_stdlib_empty_ue5_falls_back_to_root():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        let ue5_dir = stdlib_dir.join("ue5")
        std__fs__create_dir(&ue5_dir).unwrap()
        create_kn_file(&stdlib_dir, "root.kn", "// root content")
        std__env__set_var("KAIN_STDLIB_PATH", stdlib_dir.to_str().unwrap())
        let result = load_stdlib()
        if (!result.contains("// root content")):
            panic("assert! failed")
        std__env__remove_var("KAIN_STDLIB_PATH")

    fn test_load_stdlib_for_target_uses_target_profile_order():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        create_kn_file(&stdlib_dir, "root.kn", "// root stdlib")
        let ue5_dir = stdlib_dir.join("ue5")
        std__fs__create_dir(&ue5_dir).unwrap()
        create_kn_file(&ue5_dir, "ue5.kn", "// ue5 stdlib")
        let roots = [stdlib_dir.clone()]
        let ts_profiles = target_profiles(crate__CompileTarget__Ts).iter().map(none).collect()
        let ue5_profiles = target_profiles(crate__CompileTarget__Ue5).iter().map(none).collect()
        let ts_stdlib = load_stdlib_from_profiles(&roots, &ts_profiles)
        if (!ts_stdlib.contains("// root stdlib")):
            panic("assert! failed")
        if (!(!ts_stdlib.contains("// ue5 stdlib"))):
            panic("assert! failed")
        let ue5_stdlib = load_stdlib_from_profiles(&roots, &ue5_profiles)
        if (!ue5_stdlib.contains("// ue5 stdlib")):
            panic("assert! failed")

    fn test_stdlib_builtin_functions_exist():
        let stdlib = StdLib__new_()
        if (!stdlib.functions.contains_key("print")):
            panic("assert! failed")
        if (!stdlib.functions.contains_key("println")):
            panic("assert! failed")
        if (!stdlib.functions.contains_key("sqrt")):
            panic("assert! failed")
        if (!stdlib.functions.contains_key("vec3")):
            panic("assert! failed")
        if (!stdlib.functions.contains_key("push")):
            panic("assert! failed")
        if (!stdlib.functions.contains_key("py_eval")):
            panic("assert! failed")

    fn test_stdlib_function_metadata():
        let stdlib = StdLib__new_()
        let sqrt_fn = stdlib.functions.get("sqrt").unwrap()
        if (sqrt_fn.name != "sqrt"):
            panic("assert_eq! failed")
        if (sqrt_fn.params.len() != 1):
            panic("assert_eq! failed")
        if (sqrt_fn.params[0].field_0 != "x"):
            panic("assert_eq! failed")
        if (sqrt_fn.params[0].field_1 != "Float"):
            panic("assert_eq! failed")
        if (sqrt_fn.return_type != "Float"):
            panic("assert_eq! failed")
        if (!(!sqrt_fn.doc.is_empty())):
            panic("assert! failed")

    fn test_load_kn_files_filters_only_kn_extension():
        let temp_dir = tempfile__TempDir__new_().unwrap()
        let stdlib_dir = create_test_stdlib_dir(&temp_dir)
        create_kn_file(&stdlib_dir, "valid.kn", "// valid")
        std__fs__write(stdlib_dir.join("invalid.knx"), "// wrong extension").unwrap()
        std__fs__write(stdlib_dir.join("invalid.txt"), "// text file").unwrap()
        std__fs__write(stdlib_dir.join("kn"), "// no extension").unwrap()
        let result = load_kn_files_from_dir(&stdlib_dir).unwrap()
        if (!result.contains("// valid")):
            panic("assert! failed")
        if (!(!result.contains("// wrong extension"))):
            panic("assert! failed")
        if (!(!result.contains("// text file"))):
            panic("assert! failed")
        if (!(!result.contains("// no extension"))):
            panic("assert! failed")


struct TempTestDir:
    path: std::path::PathBuf

impl TempTestDir:
    fn new_(name: &String) -> Self_:
        let temp_dir = std__env__temp_dir().join(f"kain_test_{name}")
        if temp_dir.exists():
            let _ = std__fs__remove_dir_all(&temp_dir)
        std__fs__create_dir_all(&temp_dir).expect("Failed to create temp dir")
        aggregate_init("Self_", path = temp_dir)

    fn create_file(_self: &Self_, relative_path: &String, content: &String):
        let file_path = _self.path.join(relative_path)
        match file_path.parent():
            Some(parent) =>
                std__fs__create_dir_all(parent).expect("Failed to create parent dirs")
            _ =>
                none
        std__fs__write(&file_path, content).expect("Failed to write file")

    fn create_dir(_self: &Self_, relative_path: &String):
        let dir_path = _self.path.join(relative_path)
        std__fs__create_dir_all(&dir_path).expect("Failed to create directory")

    fn path(_self: &Self_) -> &std::path::PathBuf:
        &_self.path


impl Drop for TempTestDir:
    fn drop(_self: &mut Self_):
        let _ = std__fs__remove_dir_all(&_self.path)


