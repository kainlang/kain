# Test 8: Cooldown system using stdlib
actor CooldownTestActor:
    state last_ability_time: Float = 0.0
    state ability_cooldown: Float = 5.0
    
    on Server_UseAbility(current_time: Float):
        if is_cooldown_ready(last_ability_time, ability_cooldown, current_time):
            println("Ability used!")
            last_ability_time = current_time
        else:
            let remaining = get_cooldown_remaining(last_ability_time, ability_cooldown, current_time)
            println("Cooldown: {remaining}s remaining")

