# ULTIMATE TEST - Per-Item Compilation + Stdlib
# Tests both Phase 2 modular output AND the new stdlib

# Test 1: Health system using stdlib
actor HealthTestActor:
    state health: HealthComponent = HealthComponent()
    state max_health: Float = 100.0
    
    on BeginPlay():
        health.current_health = 100.0
        health.max_health = max_health
        println("Health system initialized")
    
    on Server_TakeDamage(damage: Float, armor: Float):
        let new_health = apply_damage(health.current_health, health.max_health, damage, armor)
        health.current_health = new_health
        
        if is_low_health(health.current_health, health.max_health, 25.0):
            println("Low health warning!")
        
        if health.current_health <= 0.0:
            println("Actor died!")

# Test 2: Combat system using stdlib
actor CombatTestActor:
    state base_damage: Float = 50.0
    state crit_chance: Float = 25.0
    state armor: Float = 10.0
    
    on Server_Attack(target: Int):
        let should_crit_hit = should_crit(crit_chance)
        var damage = base_damage
        
        if should_crit_hit:
            damage = calculate_crit_damage(damage, 2.0)
            println("Critical hit!")
        
        let final_damage = calculate_armor_mitigation(damage, armor)
        println("Dealt {final_damage} damage")

# Test 3: XP system using stdlib
actor XPTestActor:
    state player_level: Int = 1
    state player_xp: Int = 0
    
    on Server_GainXP(xp_amount: Int):
        player_xp = add_experience(player_xp, xp_amount, player_level)
        let progress = get_xp_progress(player_xp, player_level)
        println("XP Progress: {progress}%")
        
        let xp_needed = calculate_experience_for_level(player_level + 1)
        if player_xp >= xp_needed:
            player_level = player_level + 1
            println("Level up! Now level {player_level}")

# Test 4: Loot system using stdlib
actor LootTestActor:
    state luck_stat: Float = 10.0
    
    on Server_RollLoot():
        let should_drop = roll_loot_drop(75.0)
        
        if should_drop:
            let rarity = determine_loot_rarity(luck_stat)
            println("Loot dropped!")
        else:
            println("No loot this time")

# Test 5: Material effects using stdlib
actor MaterialTestActor:
    state material: MaterialInstance = MaterialInstance()
    state dissolve_progress: Float = 0.0
    
    on BeginPlay():
        setup_dissolve_material(material, "/Game/Textures/Dissolve")
        set_emissive_glow(material, vec4(1, 0, 0, 1), 2.0)
    
    on Tick(delta_time: Float):
        if dissolve_progress < 1.0:
            dissolve_progress = dissolve_progress + delta_time * 0.5
            update_dissolve(material, dissolve_progress)

