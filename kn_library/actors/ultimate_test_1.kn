# Test 10: Buff system using stdlib patterns
actor BuffTestActor:
    state active_buffs: Array<BuffEffect> = []
    state base_damage: Float = 50.0
    
    on Tick(delta_time: Float):
        # Update all buff durations
        var i = 0
        while i < active_buffs.len():
            let buff = active_buffs[i]
            buff.remaining_time = update_buff_duration(buff.remaining_time, delta_time)
            
            if is_buff_active(buff.remaining_time):
                # Apply buff to damage
                let buffed_damage = apply_buff(base_damage, buff.magnitude, buff.buff_type)
            
            i = i + 1

# Test 11: Blueprint utilities
@blueprint
fn test_all_utilities() -> Bool:
    # Test color utilities
    let color1 = vec4(1, 0, 0, 1)
    let color2 = vec4(0, 1, 0, 1)
    let blended = lerp_color(color1, color2, 0.5)
    
    # Test math utilities
    let clamped = clamp(150.0, 0.0, 100.0)
    let remapped = remap(50.0, 0.0, 100.0, 0.0, 1.0)
    let smoothed = smooth_step(0.0, 1.0, 0.5)
    
    # Test vector utilities
    let random_point = random_point_in_sphere(10.0)
    let in_box = is_within_box(random_point, vec3(-5, -5, -5), vec3(5, 5, 5))
    let dist = distance_2d(vec3(0, 0, 0), vec3(10, 10, 0))
    
    # Test random utilities
    let rand_val = random_range(0.0, 100.0)
    let rand_int = random_int_range(1, 10)
    let rand_bool = random_bool()
    
    return true

# ============================================================================
# SHADER TESTS - USF Generation + Material Bindings
# ============================================================================

# Test 12: Advanced PBR shader with permutations
shader fragment AdvancedPBRShader(uv: Vec2) -> Vec4:
    # Permutation flags for quality levels
    uniform CFG_HIGH_QUALITY: Float @0
    uniform CFG_MOBILE: Float @1
    uniform ENABLE_PARALLAX: Float @2
    uniform ENABLE_SUBSURFACE: Float @3
    
    # Material parameters
    uniform base_color: Vec3 @4
    uniform roughness: Float @5
    uniform metallic: Float @6
    uniform emissive_strength: Float @7
    uniform normal_strength: Float @8
    
    # Texture samplers
    uniform albedo_map: Sampler2D @9
    uniform normal_map: Sampler2D @10
    uniform roughness_map: Sampler2D @11
    uniform height_map: Sampler2D @12
    
    # Sample base textures
    var final_uv = uv
    
    # Parallax mapping (high quality only)
    if ENABLE_PARALLAX:
        if CFG_HIGH_QUALITY:
            let height = sample(height_map, uv).r
            let parallax_offset = height * 0.05
            final_uv = uv + vec2(parallax_offset, parallax_offset)
    
    # Sample textures with final UV
    let albedo = sample(albedo_map, final_uv).rgb * base_color
    let normal = sample(normal_map, final_uv).rgb
    let rough = sample(roughness_map, final_uv).r * roughness
    
    # Calculate lighting (simplified)
    var final_color = albedo
    
    if CFG_HIGH_QUALITY:
        # High quality: Full PBR with subsurface
        let fresnel = fresnel_schlick(0.04, 1.0, 0.5)
        final_color = final_color * (1.0 + fresnel * 0.5)
        
        if ENABLE_SUBSURFACE:
            # Subsurface scattering approximation
            let sss = vec3(1.0, 0.5, 0.3) * 0.2
            final_color = final_color + sss
    else:
        if CFG_MOBILE:
            # Mobile: Simplified lighting
            final_color = final_color * 0.8
    
    # Add emissive
    let emissive = albedo * emissive_strength
    final_color = final_color + emissive
    
    return vec4(final_color, 1.0)

# Test 13: Post-processing shader with stdlib functions
shader fragment PostProcessEffect(uv: Vec2) -> Vec4:
    uniform time: Float @0
    uniform intensity: Float @1
    uniform scene_texture: Sampler2D @2
    
    # Use stdlib shader functions
    let noise_val = fbm(uv * 10.0, 4)
    let pulse_val = pulse(time, 2.0)
    
    # Sample scene
    var scene_color = sample(scene_texture, uv).rgb
    
    # Apply vignette
    scene_color = vignette(scene_color, uv, 0.5, 0.3)
    
    # Apply chromatic aberration
    scene_color = chromatic_aberration(scene_texture, uv, 0.002 * intensity)
    
    # Apply color grading
    scene_color = apply_contrast(scene_color, 1.2)
    scene_color = apply_saturation(scene_color, 1.3)
    scene_color = tonemap_aces(scene_color)
    
    # Add animated noise
    scene_color = scene_color + vec3(noise_val * pulse_val * 0.1)
    
    return vec4(scene_color, 1.0)

# Test 14: Compute shader for particle simulation
shader compute ParticleSimulation(thread_id: Vec3) -> Vec4:
    uniform delta_time: Float @0
    uniform gravity: Vec3 @1
    uniform particle_count: Int @2
    uniform particle_buffer: RWBuffer @3
    
    let particle_id = int(thread_id.x)
    
    if particle_id < particle_count:
        # Read particle data (position, velocity)
        # This is simplified - real implementation would use structured buffers
        var velocity = vec3(0, 0, 0)
        var position = vec3(0, 0, 0)
        
        # Apply gravity
        velocity = velocity + gravity * delta_time
        
        # Update position
        position = position + velocity * delta_time
        
        # Bounce off ground
        if position.z < 0.0:
            position.z = 0.0
            velocity.z = velocity.z * -0.8
    
    return vec4(position, 1.0)

# Test 15: Animated dissolve shader
shader fragment DissolveShader(uv: Vec2) -> Vec4:
    uniform dissolve_progress: Float @0
    uniform edge_color: Vec3 @1
    uniform edge_width: Float @2
    uniform noise_scale: Float @3
    uniform albedo_map: Sampler2D @4
    uniform dissolve_noise: Sampler2D @5
    
    # Sample textures
    let base_color = sample(albedo_map, uv).rgb
    let noise = sample(dissolve_noise, uv * noise_scale).r
    
    # Calculate dissolve
    let dissolve_threshold = dissolve_progress
    let edge_threshold = dissolve_threshold + edge_width
    
    # Discard pixels below threshold
    if noise < dissolve_threshold:
        # In HLSL this would be: clip(-1)
        return vec4(0, 0, 0, 0)
    
    # Edge glow
    var final_color = base_color
    if noise < edge_threshold:
        let edge_factor = (edge_threshold - noise) / edge_width
        final_color = lerp_color(vec4(base_color, 1), vec4(edge_color, 1), edge_factor).rgb
        final_color = final_color + edge_color * edge_factor * 2.0
    
    return vec4(final_color, 1.0)

