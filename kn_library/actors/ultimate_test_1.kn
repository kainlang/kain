# ACTORS THAT USE SHADERS
# ============================================================================

# Test 16: Actor that controls shader parameters
actor ShaderControllerActor:
    state material: MaterialInstance = MaterialInstance()
    state time_elapsed: Float = 0.0
    state dissolve_active: Bool = false
    state dissolve_progress: Float = 0.0
    
    on BeginPlay():
        # Setup material with our custom shader
        println("Shader controller initialized")
        
        # Set initial shader parameters
        set_scalar_parameter(material, "roughness", 0.5)
        set_scalar_parameter(material, "metallic", 0.0)
        set_scalar_parameter(material, "emissive_strength", 0.0)
        set_vector_parameter(material, "base_color", vec4(1, 1, 1, 1))
    
    on Tick(delta_time: Float):
        time_elapsed = time_elapsed + delta_time
        
        # Animate emissive with pulse
        let pulse_val = pulse(time_elapsed, 2.0)
        set_scalar_parameter(material, "emissive_strength", pulse_val * 2.0)
        
        # Update dissolve if active
        if dissolve_active:
            dissolve_progress = dissolve_progress + delta_time * 0.5
            set_scalar_parameter(material, "dissolve_progress", dissolve_progress)
            
            if dissolve_progress >= 1.0:
                println("Dissolve complete!")
                dissolve_active = false
    
    on Server_StartDissolve():
        dissolve_active = true
        dissolve_progress = 0.0
        println("Starting dissolve effect")
    
    on Server_SetQuality(high_quality: Bool):
        # Toggle shader permutation at runtime
        if high_quality:
            set_scalar_parameter(material, "CFG_HIGH_QUALITY", 1.0)
            set_scalar_parameter(material, "ENABLE_PARALLAX", 1.0)
            set_scalar_parameter(material, "ENABLE_SUBSURFACE", 1.0)
            println("High quality mode enabled")
        else:
            set_scalar_parameter(material, "CFG_HIGH_QUALITY", 0.0)
            set_scalar_parameter(material, "CFG_MOBILE", 1.0)
            println("Mobile quality mode enabled")

# Test 17: Complex actor combining shaders + gameplay + stdlib
actor UltimateTestActor:
    state health: HealthComponent = HealthComponent()
    state material: MaterialInstance = MaterialInstance()
    state character_mesh: SkeletalMeshComponent = SkeletalMeshComponent()
    state level: Int = 1
    state xp: Int = 0
    state is_damaged: Bool = false
    state damage_flash_time: Float = 0.0
    
    on BeginPlay():
        # Setup health
        health.current_health = 100.0
        health.max_health = 100.0
        
        # Setup character mesh
        setup_character_mesh(character_mesh, "/Game/Characters/Hero", "/Game/Animations/HeroAnimBP")
        play_animation(character_mesh, "Idle", true)
        
        # Setup material with shader
        setup_dissolve_material(material, "/Game/Textures/DissolveNoise")
        set_emissive_glow(material, vec4(0, 1, 1, 1), 1.0)
        set_pbr_properties(material, 0.5, 0.0, 1.0)
        
        println("Ultimate test actor initialized!")
    
    on Tick(delta_time: Float):
        # Update damage flash
        if is_damaged:
            damage_flash_time = damage_flash_time + delta_time
            
            if damage_flash_time < 0.2:
                # Flash red
                flash_damage_color(material, vec4(1, 0, 0, 1), damage_flash_time / 0.2)
            else:
                is_damaged = false
                damage_flash_time = 0.0
    
    on Server_TakeDamage(damage: Float, attacker_location: Vec3):
        # Calculate damage with armor
        let armor = 10.0
        let new_health = apply_damage(health.current_health, health.max_health, damage, armor)
        health.current_health = new_health
        
        # Trigger damage flash
        is_damaged = true
        damage_flash_time = 0.0
        
        # Spawn hit effect
        let hit_location = GetActorLocation()
        let hit_direction = vec3(0, 0, 1)
        spawn_hit_impact(hit_location, hit_direction, "Flesh")
        
        # Play hit animation
        play_animation(character_mesh, "HitReact", false)
        
        # Check for death
        if health.current_health <= 0.0:
            Server_Die()
        else:
            if is_low_health(health.current_health, health.max_health, 25.0):
                println("Low health warning!")
                pulse_emissive(material, vec4(1, 0, 0, 1), 2.0, 0.5)
    
    on Server_Die():
        println("Actor died!")
        
        # Trigger death effects
        trigger_death_ragdoll(character_mesh, vec3(0, 0, 1000))
        spawn_explosion(GetActorLocation(), 5.0, 1.0)
        
        # Start dissolve shader effect
        update_dissolve(material, 0.0)
        
        # Award XP to killer (if applicable)
        let xp_reward = 100
        println("Awarded {xp_reward} XP")
    
    on Server_LevelUp():
        level = level + 1
        
        # Heal to full
        health.current_health = health.max_health
        
        # Spawn level up effect
        spawn_level_up_effect(GetActorLocation())
        
        # Flash material gold
        set_color_tint(material, vec4(1, 0.84, 0, 1))
        pulse_emissive(material, vec4(1, 1, 0, 1), 3.0, 1.0)
        
        println("Level up! Now level {level}")
    
    on Server_Heal(heal_amount: Float):
        health.current_health = apply_healing(health.current_health, health.max_health, heal_amount)
        
        # Spawn heal effect
        spawn_heal_effect(GetActorLocation())
        
        # Flash material green
        flash_damage_color(material, vec4(0, 1, 0, 1), 0.5)
        
        println("Healed for {heal_amount}")

