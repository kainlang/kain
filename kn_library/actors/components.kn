// components.kn - Reusable components

@component
struct HealthComponent:
    @replicated
    current: Float
    
    @replicated
    max: Float
    
    @transient
    regen_rate: Float

@component
struct InventoryComponent:
    @replicated
    items: Array<ItemData>
    
    @replicated
    capacity: Int
    
    @savegame
    gold: Int
