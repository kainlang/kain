// === SlateTest Plugin: Actors ===

actor InventoryManager:
    state inventory: InventoryComponent = InventoryComponent()
    state selected_item: Int = -1
    
    on Server_AddItem(item_id: Int, quantity: Int):
        println("Adding item {item_id} x{quantity}")
    
    on Server_RemoveItem(item_id: Int, quantity: Int):
        println("Removing item {item_id} x{quantity}")
    
    on Client_UpdateInventory(items: Array<ItemStack>):
        println("Inventory updated")
    
    on Multicast_ItemPickedUp(item_id: Int):
        println("Item {item_id} picked up!")

actor CombatManager:
    state health: HealthComponent = HealthComponent()
    state is_in_combat: Bool = false
    state combo_count: Int = 0
    
    on Server_TakeDamage(amount: Float, source: Actor):
        println("Taking {amount} damage")
    
    on Server_Heal(amount: Float):
        println("Healing {amount}")
    
    on Multicast_OnDeath():
        println("Actor died!")
