// actors.kn - Game actors with shader integration

actor TestActor:
    // State that matches shader uniforms (testing auto-wiring)
    state color: Vec3 = vec3(1.0, 0.5, 0.0)
    state intensity: Float = 1.0
    state time: Float = 0.0
    
    on begin_play():
        println("TestActor initialized")
        color = vec3(1.0, 0.0, 0.0)
    
    on tick(delta_time: Float):
        time = time + delta_time
        intensity = 0.5 + 0.5 * sin(time)
    
    on Server_TakeDamage(amount: Float):
        println("Taking damage: {amount}")
    
    on Client_UpdateHealth(new_health: Float):
        println("Health updated: {new_health}")
