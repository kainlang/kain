# ============================================================================
# ALPHAGEN - TYPES AND ENUMS
# Complete type system for procedural alpha generation
# ============================================================================

# Generator types - 21 procedural patterns
enum AlphaGenType:
    Radial
    Circle
    Square
    Diamond
    Perlin
    Voronoi
    Bricks
    Dots
    SeamlessNoise
    Crosshatch
    Waves
    Checkerboard
    Hexagon
    Tears
    Scratches
    Splatter
    Cracks
    Cells
    Grunge
    Fibers
    Caustics

# Filter types - 15 post-processing filters
enum AlphaGenFilterType:
    Blur
    Sharpen
    Invert
    Dilate
    Erode
    Threshold
    Posterize
    Pixelate
    DomainWarp
    Spherize
    EdgeDetect
    Levels
    Contrast
    Spiral

# Alpha source type
enum AlphaSource:
    File
    Embedded
    Procedural

# Delegates for editor callbacks
type OnTextureGenerated = delegate(Texture2D)
type OnFilterApplied = delegate(Texture2D)
type OnExportComplete = delegate(String)
