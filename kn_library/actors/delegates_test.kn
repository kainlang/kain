// Test file for Phase 1 Core Infrastructure features
// Demonstrates: multicast delegates, meta specifiers, conditional replication

// === MULTICAST DELEGATES ===
// Naming convention: types starting with "On" or ending with "Delegate" become multicast delegates

type OnClonerRebuilt = fn()
type OnEffectorChanged = fn(Float)
type OnModifierApplied = fn(String, Int)

// Regular delegate (doesn't start with "On" or end with "Delegate")
type CustomCallback = fn(Bool)

// === ENUMS ===
enum ClonerMode:
    Linear
    Grid
    Radial
    Spline

// === STRUCTS WITH META SPECIFIERS ===
@datatable
struct ClonerSettings:
    @category("Cloner|Basic")
    @tooltip("Number of clones to generate")
    @clamp_min(1)
    @clamp_max(10000)
    @ui_min(1)
    @ui_max(1000)
    clone_count: Int
    
    @category("Cloner|Animation")
    @tooltip("Animation speed multiplier")
    @clamp_min(0.0)
    @clamp_max(10.0)
    @units("x")
    speed: Float
    
    @category("Cloner|Mode")
    @display_name("Cloner Mode")
    mode: ClonerMode
    
    @category("Cloner|Advanced")
    @edit_condition("mode == ClonerMode::Grid")
    @tooltip("Grid dimensions (only visible when Grid mode is selected)")
    grid_size: Int

// === COMPONENT WITH DELEGATES AND META SPECIFIERS ===
@component
struct ClonerComponent:
    // Replicated properties with conditional replication
    @replicated("condition=OwnerOnly")
    @category("Cloner|State")
    @tooltip("Current number of active clones")
    active_count: Int
    
    @replicated("condition=SimulatedOnly")
    @category("Cloner|State")
    current_mode: ClonerMode
    
    // Multicast delegate properties
    @blueprint_assignable
    @category("Cloner|Events")
    @tooltip("Called when the cloner finishes rebuilding")
    on_rebuilt: OnClonerRebuilt
    
    @blueprint_assignable
    @category("Cloner|Events")
    on_effector_changed: OnEffectorChanged
    
    @blueprint_assignable
    @category("Cloner|Events")
    on_modifier_applied: OnModifierApplied
    
    // Regular callback
    @category("Cloner|Callbacks")
    custom_callback: CustomCallback
    
    // Transient data (not replicated or saved)
    @transient
    @category("Cloner|Runtime")
    is_rebuilding: Bool
    
    // SaveGame data
    @savegame
    @category("Cloner|Persistence")
    saved_settings: ClonerSettings

// === ACTOR USING THE COMPONENT ===
actor ClonerActor:
    state cloner_component: ClonerComponent = ClonerComponent {}
    state settings: ClonerSettings = ClonerSettings {}
    
    on Server_RebuildClones():
        println("Rebuilding clones on server")
        // Broadcast to all clients
        Multicast_NotifyRebuilt()
    
    on Multicast_NotifyRebuilt():
        println("Cloner rebuilt - broadcasting event")
        // This would trigger the delegate in actual UE5 code
    
    on Client_UpdateEffector(strength: Float):
        println("Effector strength updated: {strength}")
