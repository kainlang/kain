// Complete Inventory System Plugin for UE5

// Item rarity enum
enum ItemRarity:
    Common
    Uncommon
    Rare
    Epic
    Legendary
    Mythic

// Item type enum
enum ItemType:
    Weapon
    Armor
    Consumable
    Material
    Quest
    Currency

// Equipment slot enum
enum EquipSlot:
    None
    Head
    Chest
    Legs
    Feet
    Hands
    MainHand
    OffHand
    Ring1
    Ring2
    Amulet

// Item definition datatable
@datatable
struct ItemDefinition:
    item_id: Int
    name: String
    description: String
    icon_path: String
    item_type: ItemType
    rarity: ItemRarity
    max_stack: Int
    value: Int
    weight: Float
    is_tradeable: Bool
    is_droppable: Bool
    equip_slot: EquipSlot

// Item stack struct
struct ItemStack:
    item_id: Int
    quantity: Int
    durability: Float

// Inventory component
@component
struct InventoryComponent:
    @replicated
    items: Array<ItemStack>
    
    @replicated
    capacity: Int
    
    @replicated
    weight_limit: Float
    
    @savegame
    gold: Int

// Equipment component
@component
struct EquipmentComponent:
    @replicated
    equipped_items: Array<ItemStack>
    
    @replicated
    armor_rating: Float
    
    @replicated
    damage_bonus: Float

// Inventory actor
actor InventoryManager:
    state max_capacity: Int = 50
    
    on Server_AddItem(player: Actor, item_id: Int, quantity: Int):
        println("Adding item {item_id} x{quantity}")
        Client_UpdateInventory(player)
    
    on Server_RemoveItem(player: Actor, item_id: Int, quantity: Int):
        println("Removing item {item_id} x{quantity}")
        Client_UpdateInventory(player)
    
    on Client_UpdateInventory(player: Actor):
        println("Inventory updated")
    
    on Multicast_ItemPickup(item_id: Int):
        println("Item picked up: {item_id}")

// Blueprint utility functions
@blueprint
fn can_add_item(current_count: Int, capacity: Int, stack_size: Int) -> Bool:
    return current_count + stack_size <= capacity

@blueprint
fn calculate_item_value(base_value: Int, rarity: ItemRarity) -> Int:
    var multiplier = 1.0
    if rarity == ItemRarity::Uncommon:
        multiplier = 1.5
    elif rarity == ItemRarity::Rare:
        multiplier = 2.5
    elif rarity == ItemRarity::Epic:
        multiplier = 5.0
    elif rarity == ItemRarity::Legendary:
        multiplier = 10.0
    elif rarity == ItemRarity::Mythic:
        multiplier = 25.0
    return Int(Float(base_value) * multiplier)

@blueprint
fn get_rarity_color(rarity: ItemRarity) -> Vec3:
    if rarity == ItemRarity::Common:
        return vec3(1.0, 1.0, 1.0)
    elif rarity == ItemRarity::Uncommon:
        return vec3(0.0, 1.0, 0.0)
    elif rarity == ItemRarity::Rare:
        return vec3(0.0, 0.5, 1.0)
    elif rarity == ItemRarity::Epic:
        return vec3(0.6, 0.0, 1.0)
    elif rarity == ItemRarity::Legendary:
        return vec3(1.0, 0.5, 0.0)
    elif rarity == ItemRarity::Mythic:
        return vec3(1.0, 0.0, 0.5)
    return vec3(0.5, 0.5, 0.5)

@blueprint
fn calculate_total_weight(items: Array<ItemStack>) -> Float:
    return 0.0
