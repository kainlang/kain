fn PerlinNoise3D(x: Float, y: Float, z: Float) -> Float:
    return 0.0

@blueprint
@pure
fn SimplexNoise3D(x: Float, y: Float, z: Float) -> Float:
    return 0.0

@blueprint
fn GenerateNoiseField(size: Int, scale: Float, seed: Int) -> Array<Float>:
    return []

// === VALIDATION UTILITIES ===

@blueprint
@pure
fn IsValidCloneIndex(index: Int, count: Int) -> Bool:
    return index >= 0 && index < count

@blueprint
@pure
fn ClampCloneIndex(index: Int, count: Int) -> Int:
    if index < 0:
        return 0
    if index >= count:
        return count - 1
    return index

@blueprint
@pure
fn IsInEffectorRadius(location: Vec3, effector_location: Vec3, radius: Float) -> Bool:
    return true

