// === PERFORMANCE UTILITIES ===

@blueprint
@pure
fn CalculateLODLevel(distance: Float, lod_distances: Array<Float>) -> Int:
    return 0

@blueprint
@pure
fn ShouldUpdateClone(index: Int, frame_count: Int, update_frequency: Int) -> Bool:
    return (index + frame_count) % update_frequency == 0

@blueprint
fn BatchUpdateClones(start_index: Int, end_index: Int, delta_time: Float):
    println("Batch updating clones {start_index} to {end_index}")

// === DEBUG UTILITIES ===

@blueprint
fn DebugDrawCloneTransforms(transforms: Array<Transform>, duration: Float = 1.0):
    println("Drawing {transforms.len()} clone transforms")

@blueprint
fn DebugDrawEffectorRadius(location: Vec3, radius: Float, color: Vec3 = Vec3()):
