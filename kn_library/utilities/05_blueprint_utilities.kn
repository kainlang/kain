# ============================================================================
# FILE 5: BLUEPRINT UTILITIES
# Demonstrates: @blueprint functions, static utility libraries
# These become UBlueprintFunctionLibrary static methods
# ============================================================================

# ----------------------------------------------------------------------------
# BLUEPRINT UTILITY FUNCTIONS
# @blueprint generates static Blueprint-callable functions
# Perfect for math, conversions, helpers, etc.
# ----------------------------------------------------------------------------

# Math utilities
@blueprint
fn CalculateDamage(base_damage: Float, armor: Float, is_critical: Bool) -> Float:
    # Armor reduces damage (diminishing returns)
    let armor_reduction = armor / (armor + 100.0)
    var final_damage = base_damage * (1.0 - armor_reduction)
    
    # Critical hit doubles damage
    if is_critical:
        final_damage = final_damage * 2.0
    
    return final_damage

@blueprint
fn CalculateCriticalChance(base_chance: Float, luck: Int) -> Float:
    # Each point of luck adds 0.1% crit chance
    let luck_bonus = luck * 0.001
    return base_chance + luck_bonus

@blueprint
fn CalculateExperienceForLevel(level: Int) -> Int:
    # Exponential XP curve
    return 100 * level * level

@blueprint
fn CalculateDistance2D(point_a: Vec2, point_b: Vec2) -> Float:
    let dx = point_b.x - point_a.x
    let dy = point_b.y - point_a.y
    return sqrt(dx * dx + dy * dy)

@blueprint
fn CalculateDistance3D(point_a: Vec3, point_b: Vec3) -> Float:
    let dx = point_b.x - point_a.x
    let dy = point_b.y - point_a.y
    let dz = point_b.z - point_a.z
    return sqrt(dx * dx + dy * dy + dz * dz)

@blueprint
fn LerpFloat(a: Float, b: Float, alpha: Float) -> Float:
    return a + (b - a) * alpha

@blueprint
fn ClampFloat(value: Float, min_val: Float, max_val: Float) -> Float:
    if value < min_val:
        return min_val
    else:
        if value > max_val:
            return max_val
        else:
            return value

# Color utilities
@blueprint
fn GetRarityColor(rarity: ItemRarity) -> Vec3:
    # Return RGB color based on rarity
    if rarity == ItemRarity::Common:
        return vec3(1.0, 1.0, 1.0)  # White
    else:
        if rarity == ItemRarity::Uncommon:
            return vec3(0.0, 1.0, 0.0)  # Green
        else:
            if rarity == ItemRarity::Rare:
                return vec3(0.0, 0.5, 1.0)  # Blue
            else:
                if rarity == ItemRarity::Epic:
                    return vec3(0.6, 0.0, 1.0)  # Purple
                else:
                    if rarity == ItemRarity::Legendary:
                        return vec3(1.0, 0.5, 0.0)  # Orange
                    else:
                        return vec3(1.0, 0.0, 1.0)  # Magenta (Mythic)

@blueprint
fn ColorToHex(color: Vec3) -> String:
    # Convert RGB to hex string
    return "#{color.x}{color.y}{color.z}"

@blueprint
fn LerpColor(color_a: Vec3, color_b: Vec3, alpha: Float) -> Vec3:
    return vec3(
        LerpFloat(color_a.x, color_b.x, alpha),
        LerpFloat(color_a.y, color_b.y, alpha),
        LerpFloat(color_a.z, color_b.z, alpha)
    )

# Item utilities
@blueprint
fn GetItemValue(item_id: Int, rarity: ItemRarity, level: Int) -> Int:
    # Base value from item ID (would lookup from datatable in real game)
    var base_value = item_id * 10
    
    # Rarity multiplier
    var rarity_mult = 1.0
    if rarity == ItemRarity::Uncommon:
        rarity_mult = 2.0
    else:
        if rarity == ItemRarity::Rare:
            rarity_mult = 5.0
        else:
            if rarity == ItemRarity::Epic:
                rarity_mult = 10.0
            else:
                if rarity == ItemRarity::Legendary:
                    rarity_mult = 25.0
                else:
                    if rarity == ItemRarity::Mythic:
                        rarity_mult = 100.0
    
    # Level scaling
    let level_mult = 1.0 + (level * 0.1)
    
    return base_value * rarity_mult * level_mult

@blueprint
fn CanStackItems(item_a_id: Int, item_b_id: Int) -> Bool:
    # Items can stack if they have the same ID
    return item_a_id == item_b_id

@blueprint
fn GetMaxStackSize(item_type: ItemType) -> Int:
    # Different item types have different stack sizes
    if item_type == ItemType::Consumable:
        return 99
    else:
        if item_type == ItemType::Material:
            return 999
        else:
            if item_type == ItemType::Currency:
                return 9999
            else:
                return 1  # Weapons, armor don't stack

# Combat utilities
@blueprint
fn CalculateAttackSpeed(base_speed: Float, dexterity: Int, weapon_speed: Float) -> Float:
    # Dexterity increases attack speed
    let dex_bonus = 1.0 + (dexterity * 0.01)
    return base_speed * weapon_speed * dex_bonus

@blueprint
fn CalculateMovementSpeed(base_speed: Float, armor_weight: Float, buffs: Float) -> Float:
    # Heavy armor slows you down
    let armor_penalty = 1.0 - (armor_weight * 0.001)
    return base_speed * armor_penalty * buffs

@blueprint
fn GetDamageTypeMultiplier(damage_type: DamageType, target_type: String) -> Float:
    # Type effectiveness (like Pokemon)
    # Fire is strong against ice, weak against water, etc.
    if damage_type == DamageType::Fire:
        if target_type == "Ice":
            return 2.0
        else:
            if target_type == "Water":
                return 0.5
            else:
                return 1.0
    else:
        if damage_type == DamageType::Ice:
            if target_type == "Fire":
                return 0.5
            else:
                if target_type == "Water":
                    return 2.0
                else:
                    return 1.0
        else:
            return 1.0

# Quest utilities
@blueprint
fn IsQuestAvailable(player_level: Int, required_level: Int, prerequisite_completed: Bool) -> Bool:
    if player_level < required_level:
        return false
    
    if prerequisite_completed == false:
        return false
    
    return true

@blueprint
fn CalculateQuestReward(base_reward: Int, player_level: Int, quest_level: Int) -> Int:
    # Reduce reward if player is overleveled
    let level_diff = player_level - quest_level
    var multiplier = 1.0
    
    if level_diff > 5:
        multiplier = 0.5
    else:
        if level_diff > 10:
            multiplier = 0.25
    
    return base_reward * multiplier

# AI utilities
@blueprint
fn ShouldAggro(distance: Float, aggro_range: Float, player_level: Int, enemy_level: Int) -> Bool:
    if distance > aggro_range:
        return false
    
    # Lower level enemies won't aggro high level players
    if player_level > enemy_level + 10:
        return false
    
    return true

@blueprint
fn CalculateAIReactionTime(difficulty: String) -> Float:
    # AI reaction time based on difficulty
    if difficulty == "Easy":
        return 1.0
    else:
        if difficulty == "Normal":
            return 0.5
        else:
            if difficulty == "Hard":
                return 0.25
            else:
                return 0.1  # Nightmare

# String utilities
@blueprint
fn FormatNumber(number: Int) -> String:
    # Format large numbers with commas
    # 1000 -> "1,000"
    # 1000000 -> "1,000,000"
    return "{number}"  # Simplified

@blueprint
fn FormatTime(seconds: Float) -> String:
    # Format seconds as MM:SS
    let minutes = seconds / 60.0
    let remaining_seconds = seconds - (minutes * 60.0)
    return "{minutes}:{remaining_seconds}"

@blueprint
fn GetItemRarityName(rarity: ItemRarity) -> String:
    if rarity == ItemRarity::Common:
        return "Common"
    else:
        if rarity == ItemRarity::Uncommon:
            return "Uncommon"
        else:
            if rarity == ItemRarity::Rare:
                return "Rare"
            else:
                if rarity == ItemRarity::Epic:
                    return "Epic"
                else:
                    if rarity == ItemRarity::Legendary:
                        return "Legendary"
                    else:
                        return "Mythic"

# Random utilities
@blueprint
fn RandomFloat(min_val: Float, max_val: Float) -> Float:
    # Would use UE5's random functions in real implementation
    return min_val + (max_val - min_val) * 0.5

@blueprint
fn RandomInt(min_val: Int, max_val: Int) -> Int:
    # Would use UE5's random functions in real implementation
    return min_val + (max_val - min_val) / 2

@blueprint
fn RandomBool() -> Bool:
    return true  # 50/50 chance

@blueprint
fn RollDice(sides: Int) -> Int:
    # Roll a dice with N sides
    return RandomInt(1, sides)

@blueprint
fn RollPercentage() -> Float:
    # Roll 0.0 to 1.0
    return RandomFloat(0.0, 1.0)
