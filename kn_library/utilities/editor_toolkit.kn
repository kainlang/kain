# Editor Toolkit - Slate UI for Actor Spawning & Management
# Tests editor integration with game logic using @slate attribute

# ============================================================================
# ENUMS - Actor Types & Spawn Modes
# ============================================================================

enum ActorSpawnType:
    Cube
    Sphere
    Cylinder
    Cone
    Light
    Camera
    ParticleSystem
    StaticMesh

enum SpawnPattern:
    Single
    Grid
    Circle
    Random
    Line

# ============================================================================
# STRUCTS - Configuration
# ============================================================================

struct SpawnConfig:
    actor_type: ActorSpawnType
    pattern: SpawnPattern
    count: Int
    spacing: Float
    location: Vec3
    rotation: Vec3
    scale: Vec3

struct ActorInfo:
    name: String
    location: Vec3
    actor_type: ActorSpawnType
    is_selected: Bool

# ============================================================================
# DELEGATES - Events
# ============================================================================

type OnSpawnClicked = delegate()
type OnClearClicked = delegate()
type OnActorTypeChanged = delegate(Int)
type OnPatternChanged = delegate(Int)

# ============================================================================
# ACTOR - Spawner Manager (Game Logic)
# ============================================================================

actor ActorSpawnerManager:
    state spawned_actors: Array<Int> = []
    state total_spawned: Int = 0
    state last_spawn_location: Vec3 = vec3(0, 0, 0)
    
    on BeginPlay():
        println("Actor Spawner Manager initialized")
    
    @blueprint_callable
    @category("Editor Toolkit|Spawning")
    fn SpawnActorAtLocation(actor_type: ActorSpawnType, location: Vec3, rotation: Vec3, scale: Vec3) -> Bool:
        println("Spawning actor at location")
        total_spawned = total_spawned + 1
        last_spawn_location = location
        return true
    
    @blueprint_callable
    @category("Editor Toolkit|Spawning")
    fn SpawnActorGrid(actor_type: ActorSpawnType, rows: Int, cols: Int, spacing: Float, center: Vec3) -> Int:
        var spawned = 0
        var row = 0
        
        while row < rows:
            var col = 0
            while col < cols:
                let x = center.x + (float(col) - float(cols) / 2.0) * spacing
                let y = center.y + (float(row) - float(rows) / 2.0) * spacing
                let z = center.z
                
                let spawn_loc = vec3(x, y, z)
                if SpawnActorAtLocation(actor_type, spawn_loc, vec3(0, 0, 0), vec3(1, 1, 1)):
                    spawned = spawned + 1
                
                col = col + 1
            row = row + 1
        
        println("Spawned {spawned} actors in grid pattern")
        return spawned
    
    @blueprint_callable
    @category("Editor Toolkit|Spawning")
    fn SpawnActorCircle(actor_type: ActorSpawnType, count: Int, radius: Float, center: Vec3) -> Int:
        var spawned = 0
        var i = 0
        
        while i < count:
            let angle = (float(i) / float(count)) * 6.28318
            let x = center.x + cos(angle) * radius
            let y = center.y + sin(angle) * radius
            let z = center.z
            
            let spawn_loc = vec3(x, y, z)
            if SpawnActorAtLocation(actor_type, spawn_loc, vec3(0, 0, 0), vec3(1, 1, 1)):
                spawned = spawned + 1
            
            i = i + 1
        
        println("Spawned {spawned} actors in circle pattern")
        return spawned
    
    @blueprint_callable
    @category("Editor Toolkit|Management")
    fn ClearAllSpawnedActors():
        println("Clearing all spawned actors")
        spawned_actors = []
        total_spawned = 0
    
    @blueprint_callable
    @category("Editor Toolkit|Management")
    fn GetTotalSpawned() -> Int:
        return total_spawned
    
    @blueprint_callable
    @category("Editor Toolkit|Management")
    fn GetLastSpawnLocation() -> Vec3:
        return last_spawn_location

# ============================================================================
# ACTOR - Selection Manager (Game Logic)
# ============================================================================

actor SelectionManager:
    state selected_actors: Array<Int> = []
    state selection_count: Int = 0
    
    @blueprint_callable
    @category("Editor Toolkit|Selection")
    fn SelectActor(actor_id: Int):
        selection_count = selection_count + 1
        println("Selected actor {actor_id}")
    
    @blueprint_callable
    @category("Editor Toolkit|Selection")
    fn DeselectAll():
        selected_actors = []
        selection_count = 0
        println("Deselected all actors")
    
    @blueprint_callable
    @category("Editor Toolkit|Selection")
    fn GetSelectionCount() -> Int:
        return selection_count
    
    @blueprint_callable
    @category("Editor Toolkit|Selection")
    fn DeleteSelected():
        println("Deleting {selection_count} selected actors")
        selected_actors = []
        selection_count = 0

# ============================================================================
# BLUEPRINT UTILITIES - Helper Functions
# ============================================================================

@blueprint
fn create_spawn_config(actor_type: ActorSpawnType, pattern: SpawnPattern, count: Int) -> SpawnConfig:
    return SpawnConfig()

@blueprint
fn get_actor_type_name(actor_type: ActorSpawnType) -> String:
    match actor_type:
        ActorSpawnType::Cube => "Cube"
        ActorSpawnType::Sphere => "Sphere"
        ActorSpawnType::Cylinder => "Cylinder"
        ActorSpawnType::Cone => "Cone"
        ActorSpawnType::Light => "Light"
        ActorSpawnType::Camera => "Camera"
        ActorSpawnType::ParticleSystem => "Particle System"
        ActorSpawnType::StaticMesh => "Static Mesh"
        _ => "Unknown"

@blueprint
fn get_pattern_name(pattern: SpawnPattern) -> String:
    match pattern:
        SpawnPattern::Single => "Single"
        SpawnPattern::Grid => "Grid"
        SpawnPattern::Circle => "Circle"
        SpawnPattern::Random => "Random"
        SpawnPattern::Line => "Line"
        _ => "Unknown"

# ============================================================================
# SLATE WIDGETS - Editor UI
# ============================================================================

# Main Actor Spawner Tool Window
@slate
struct ActorSpawnerTool:
    @argument
    window_title: Text
    
    @event
    on_spawn_clicked: OnSpawnClicked
    
    @event
    on_clear_clicked: OnClearClicked
    
    fn Compose() -> Widget:
        return VerticalBox()

# Property Details Panel
@slate
struct ActorDetailsPanel:
    @argument
    actor_name: Text
    
    @argument
    location: Vec3
    
    @argument
    is_visible: Bool
    
    fn Compose() -> Widget:
        return VerticalBox()

# Quick Actions Toolbar
@slate
struct QuickActionsToolbar:
    @event
    on_spawn_cube: OnSpawnClicked
    
    @event
    on_spawn_sphere: OnSpawnClicked
    
    @event
    on_delete: OnClearClicked
    
    fn Compose() -> Widget:
        return HorizontalBox()

# Statistics Display
@slate
struct StatsDisplay:
    @argument
    total_actors: Int
    
    @argument
    selected_count: Int
    
    fn Compose() -> Widget:
        return VerticalBox()

# ============================================================================
# EDITOR MODULE - Registers the editor tools
# ============================================================================

@editor_module
struct EditorToolkitModule:
    module_name: String
    version: String
