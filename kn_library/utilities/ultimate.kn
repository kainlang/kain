# ============================================================================
# ULTA - KAIN SYSTEM HEALTH DASHBOARD
# ============================================================================
# A self-validating UE5 editor plugin. Open it from Tools menu, click buttons,
# and instantly see if the codegen pipeline is working:
#   - Green = system generated correct C++
#   - Sliders move = Slate bindings work
#   - Viewport renders = actor/shader pipeline works
#   - Details panel edits = property customization works
#
# This is the FIRST test of the new grand architecture.
# ============================================================================

# ----------------------------------------------------------------------------
# I. ENUMS
# ----------------------------------------------------------------------------

enum EHealthStatus:
    Passing
    Warning
    Failing
    Unknown

enum ETestCategory:
    Runtime
    Slate
    Shader
    Details
    Viewport

enum EPreviewShape:
    Sphere
    Cube
    Cylinder

# ----------------------------------------------------------------------------
# II. DELEGATES
# ----------------------------------------------------------------------------

type OnStatusChanged = delegate(EHealthStatus)
type OnTestRun = delegate()
type OnValueChanged = delegate(Float)
type OnColorChanged = delegate(Vec3)
type OnCheckChanged = delegate(Bool)

# ----------------------------------------------------------------------------
# III. DATA STRUCTURES
# ----------------------------------------------------------------------------

struct TestResult:
    name: String
    category: ETestCategory
    status: EHealthStatus
    message: String

@datatable
struct TestSuiteEntry:
    id: Int
    name: String
    category: String
    expected_value: Float
    tolerance: Float

# ----------------------------------------------------------------------------
# IV. ACTOR - Diagnostic preview actor (no shaders for now)
# ----------------------------------------------------------------------------

actor DiagnosticPreviewActor:
    state current_status: EHealthStatus = EHealthStatus::Unknown

    @replicated
    state status_color: Vec3 = vec3(0.5, 0.5, 0.5)

    @replicated
    state roughness: Float = 0.3

    @replicated
    state metallic: Float = 0.6

    on BeginPlay():
        SetStatus(EHealthStatus::Unknown)

    @blueprint_callable
    @category("Diagnostics")
    fn SetStatus(new_status: EHealthStatus):
        current_status = new_status
        if new_status == EHealthStatus::Passing:
            status_color = vec3(0.1, 0.9, 0.2)
        if new_status == EHealthStatus::Warning:
            status_color = vec3(0.9, 0.8, 0.1)
        if new_status == EHealthStatus::Failing:
            status_color = vec3(0.9, 0.1, 0.1)
        if new_status == EHealthStatus::Unknown:
            status_color = vec3(0.5, 0.5, 0.5)

    @blueprint_callable
    @category("Diagnostics")
    fn SetRoughness(value: Float):
        roughness = value

    @blueprint_callable
    @category("Diagnostics")
    fn SetMetallic(value: Float):
        metallic = value

# ----------------------------------------------------------------------------
# VI. SLATE WIDGETS
# ----------------------------------------------------------------------------

# --- Status Indicator Row ---
# Shows a single test result: [ColorBlock] [Name] [Status Text]
@slate
struct SStatusRow:
    @argument
    test_name: Text

    @attribute
    status: EHealthStatus

    @attribute
    status_message: String

    fn Compose() -> Widget:
        let row = HorizontalBox()

        let indicator = ColorBlock()
        indicator.Color(vec3(0.5, 0.5, 0.5))
        row.Add(indicator)

        let label = TextBlock()
        label.Text(test_name)
        row.Add(label)

        let msg = TextBlock()
        msg.Text("Pending...")
        row.Add(msg)

        return row

# --- Control Panel ---
# Sliders + buttons to poke the system and verify reactivity
@slate
struct SDiagnosticControls:
    @argument
    title: Text

    @attribute
    roughness_value: Float

    @attribute
    metallic_value: Float

    @attribute
    pulse_speed: Float

    @event
    on_roughness_changed: OnValueChanged

    @event
    on_metallic_changed: OnValueChanged

    @event
    on_run_all: OnTestRun

    @event
    on_reset: OnTestRun

    fn Compose() -> Widget:
        let vbox = VerticalBox()

        # Title
        let header = TextBlock()
        header.Text(title)
        vbox.Add(header)

        # Roughness slider
        let row1 = HorizontalBox()
        let lbl1 = TextBlock()
        lbl1.Text("Roughness:")
        row1.Add(lbl1)
        let slider1 = Slider()
        slider1.MinValue(0.0)
        slider1.MaxValue(1.0)
        slider1.Value(roughness_value)
        slider1.OnValueChanged(on_roughness_changed)
        row1.Add(slider1)
        vbox.Add(row1)

        # Metallic slider
        let row2 = HorizontalBox()
        let lbl2 = TextBlock()
        lbl2.Text("Metallic:")
        row2.Add(lbl2)
        let slider2 = Slider()
        slider2.MinValue(0.0)
        slider2.MaxValue(1.0)
        slider2.Value(metallic_value)
        slider2.OnValueChanged(on_metallic_changed)
        row2.Add(slider2)
        vbox.Add(row2)

        # Pulse speed slider (read-only indicator that shader is ticking)
        let row3 = HorizontalBox()
        let lbl3 = TextBlock()
        lbl3.Text("Pulse Speed:")
        row3.Add(lbl3)
        let slider3 = Slider()
        slider3.MinValue(0.5)
        slider3.MaxValue(10.0)
        slider3.Value(pulse_speed)
        row3.Add(slider3)
        vbox.Add(row3)

        # Action buttons
        let btn_row = HorizontalBox()
        let btn_run = Button()
        btn_run.Text("Run All Tests")
        btn_run.OnClicked(on_run_all)
        btn_row.Add(btn_run)

        let btn_reset = Button()
        btn_reset.Text("Reset")
        btn_reset.OnClicked(on_reset)
        btn_row.Add(btn_reset)
        vbox.Add(btn_row)

        return vbox

# --- Test Results Panel ---
# Scrollable list of test results
@slate
struct STestResultsPanel:
    @argument
    panel_title: Text

    @attribute
    all_passing: Bool

    fn Compose() -> Widget:
        let vbox = VerticalBox()

        let header = TextBlock()
        header.Text(panel_title)
        vbox.Add(header)

        # Summary bar
        let summary_row = HorizontalBox()
        let summary_indicator = ColorBlock()
        summary_indicator.Color(vec3(0.5, 0.5, 0.5))
        summary_row.Add(summary_indicator)
        let summary_text = TextBlock()
        summary_text.Text("Waiting for test run...")
        summary_row.Add(summary_text)
        vbox.Add(summary_row)

        # Individual test rows
        let scroll = ScrollBox()

        let row1 = SStatusRow()
        row1.test_name("Enum Generation")
        scroll.Add(row1)

        let row2 = SStatusRow()
        row2.test_name("Struct Generation")
        scroll.Add(row2)

        let row3 = SStatusRow()
        row3.test_name("Actor Compilation")
        scroll.Add(row3)

        let row4 = SStatusRow()
        row4.test_name("Shader Binding")
        scroll.Add(row4)

        let row5 = SStatusRow()
        row5.test_name("Slate Widget Tree")
        scroll.Add(row5)

        let row6 = SStatusRow()
        row6.test_name("Details Panel")
        scroll.Add(row6)

        let row7 = SStatusRow()
        row7.test_name("Viewport Render")
        scroll.Add(row7)

        let row8 = SStatusRow()
        row8.test_name("Toolbar Actions")
        scroll.Add(row8)

        vbox.Add(scroll)
        return vbox

# --- Main Dashboard Widget ---
# Combines everything: left = results, right = controls + viewport
@slate
struct SUltaDashboard:
    @argument
    plugin_version: Text

    fn Compose() -> Widget:
        let root = Splitter()

        # Left panel: test results
        let left = Border()
        let results = STestResultsPanel()
        results.panel_title("KAIN System Health")
        left.Content(results)
        root.Add(left)

        # Right panel: controls
        let right = Border()
        let controls = SDiagnosticControls()
        controls.title("Diagnostic Controls")
        right.Content(controls)
        root.Add(right)

        return root

# ----------------------------------------------------------------------------
# VII. DETAILS CUSTOMIZATION
# ----------------------------------------------------------------------------

@details
struct DiagnosticActorDetails:
    @category("Status")
    @color_picker
    status_color: Vec3

    @category("Material")
    @slider(0.0, 1.0)
    roughness: Float

    @category("Material")
    @slider(0.0, 1.0)
    metallic: Float

    @category("Preview")
    preview_shape: EPreviewShape

    @category("Actions")
    @button("Set Passing")
    fn SetPassing():
        status_color = vec3(0.1, 0.9, 0.2)

    @category("Actions")
    @button("Set Warning")
    fn SetWarning():
        status_color = vec3(0.9, 0.8, 0.1)

    @category("Actions")
    @button("Set Failing")
    fn SetFailing():
        status_color = vec3(0.9, 0.1, 0.1)

    @category("Actions")
    @button("Reset All")
    fn ResetAll():
        status_color = vec3(0.5, 0.5, 0.5)
        roughness = 0.3
        metallic = 0.6

# ----------------------------------------------------------------------------
# VIII. VIEWPORT
# ----------------------------------------------------------------------------

@viewport
struct DiagnosticViewport:
    @scene_actor
    preview_actor: DiagnosticPreviewActor

    @camera
    camera: EditorCamera

    fn SetPreviewStatus(status: EHealthStatus):
        preview_actor.SetStatus(status)

    fn SetRoughness(value: Float):
        preview_actor.SetRoughness(value)

    fn SetMetallic(value: Float):
        preview_actor.SetMetallic(value)

# ----------------------------------------------------------------------------
# IX. TOOLBAR
# ----------------------------------------------------------------------------

@toolbar
struct UltaToolbar:
    @button("Run Tests", icon="Play", shortcut="F5")
    fn OnRunTests():
        println("Running all diagnostic tests...")

    @button("Stop", icon="Stop")
    fn OnStop():
        println("Tests stopped")

    @separator

    @toggle("Auto-Refresh", icon="Refresh")
    auto_refresh: Bool

    @toggle("Verbose Log", icon="Log")
    verbose_mode: Bool

    @separator

    @button("Reset View", icon="Camera")
    fn OnResetView():
        println("Viewport reset")

    @button("Export Report", icon="Save", shortcut="Ctrl+E")
    fn OnExportReport():
        println("Exporting diagnostic report...")

# ----------------------------------------------------------------------------
# X. ASSET EDITOR
# ----------------------------------------------------------------------------

@asset_editor
struct UltaDashboardEditor:
    @asset
    test_suite: TestSuiteEntry

    @viewport
    viewport: DiagnosticViewport

    @details
    properties: DiagnosticActorDetails

    @toolbar
    toolbar: UltaToolbar

    @slate
    dashboard: SUltaDashboard

    fn OnAssetOpened():
        properties.roughness = 0.3
        properties.metallic = 0.6
        properties.status_color = vec3(0.5, 0.5, 0.5)
        viewport.SetPreviewStatus(EHealthStatus::Unknown)

    fn OnPropertyChanged():
        viewport.SetRoughness(properties.roughness)
        viewport.SetMetallic(properties.metallic)

    fn OnRunAllTests():
        viewport.SetPreviewStatus(EHealthStatus::Passing)
        properties.status_color = vec3(0.1, 0.9, 0.2)

# ----------------------------------------------------------------------------
# XI. EDITOR MODULE - Toolbar integration + menu entries
# ----------------------------------------------------------------------------

@editor_module
struct UltaModule:
    module_name: String
    version: String

    @menu_entry("Tools/KAIN System Dashboard")
    fn OpenDashboard():
        SpawnTab("UltaDashboard")

    @menu_entry("Tools/KAIN Quick Diagnostic")
    fn RunQuickDiagnostic():
        println("Quick diagnostic: All systems nominal")

    @toolbar_button("KAIN Dashboard", icon="Diagnostics")
    fn ToolbarOpenDashboard():
        OpenDashboard()

# ============================================================================
# VALIDATION COVERAGE:
# ✅ Enums (EHealthStatus, ETestCategory, EPreviewShape)
# ✅ Delegates (OnStatusChanged, OnTestRun, OnValueChanged, OnColorChanged, OnCheckChanged)
# ✅ Structs (TestResult, TestSuiteEntry with @datatable)
# ⏸️ Shader (DISABLED - focusing on UI first)
# ✅ Actor (DiagnosticPreviewActor - state, blueprint_callable, replication)
# ✅ Slate widgets (SStatusRow, SDiagnosticControls, STestResultsPanel, SUltaDashboard)
# ✅ Widget composition (VerticalBox, HorizontalBox, Splitter, Border, ScrollBox)
# ✅ Widget properties (Text, Value, MinValue, MaxValue, Color, OnClicked, OnValueChanged)
# ✅ Details customization (@details, @category, @slider, @color_picker, @button)
# ✅ Viewport (@viewport, @scene_actor, @camera)
# ✅ Toolbar (@toolbar, @button, @toggle, @separator, shortcuts, icons)
# ✅ Asset editor (@asset_editor, @asset, @viewport, @details, @toolbar, @slate)
# ✅ Editor module (@editor_module, @menu_entry, @toolbar_button)
# ============================================================================
