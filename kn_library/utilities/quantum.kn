# QuantumParticles - GPU-Accelerated Particle Simulator
# Ported from KQuantumEngine.tsx - 100k+ particles with compute shaders
# NO COMPROMISES. Full AAA implementation.

# ============================================================================
# ENUMS - Simulation Modes & Configuration
# ============================================================================

enum SimulationMode:
    ZeroPoint           # 0 - Stable energy grid (reset)
    GalacticSpiral      # 3 - Density wave orbital dynamics
    PhotoKinesis        # 5 - Image-based reconstruction
    QuantumPilot        # 6 - Bohmian mechanics
    SchrodingerWave     # 8 - Probability density
    Tesseract           # 10 - 4D hypercube projection
    NeuralLattice       # 12 - Synaptic firing
    Ferrofluid          # 13 - Magnetic liquid
    Datamosh            # 14 - Compression artifacts
    NavierStokes        # 17 - Fluid dynamics
    Hellfire            # 20 - Volumetric buoyancy
    PlasmaArc           # 21 - Magnetic flux tubes
    SuperVortex         # 22 - Cyclonic flow
    KerrBlackHole       # 101 - Relativistic singularity
    IonStorm            # 102 - Charged particle chaos
    LorenzAttractor     # 104 - Strange attractor
    VanAllenBelt        # 105 - Flux line visualization
    AizawaAttractor     # 106 - Complex polynomial flow
    BinarySystem        # 107 - Roche lobe transfer
    QuasarJet           # 108 - Relativistic polar ejection
    SupernovaRemnant    # 109 - Blast wave turbulence
    AlcubierreWarp      # 110 - Metric tensor distortion
    SolarProminence     # 111 - Magnetic reconnection
    QuantumFoam         # 112 - Sub-Planck fluctuations
    CyberpunkCity       # 113 - Procedural traffic flow
    DNAHelix            # 114 - Double helix replication

enum ColorMode:
    Solid               # 0 - Single color
    Velocity            # 1 - Speed-based palette
    Image               # 2 - Image texture sampling
    Gradient            # 3 - Angle/position gradient

enum ModifierType:
    Heartbeat           # Rhythmic pulse
    Seismic             # Ground shake
    Pulse               # Radial wave
    Breathe             # Expansion/contraction
    Helix               # Spiral twist
    Gravity             # Gravity well
    Repulsor            # Push away
    Orbit               # Circular motion
    Vortex              # Tornado spin
    Magnet              # Magnetic poles
    Explosion           # Outward burst
    Swarm               # Flocking behavior

enum BoundsMode:
    Bounce              # Reflect at bounds
    Wrap                # Teleport to opposite side
    Respawn             # Reset to spawn point

# ============================================================================
# STRUCTS - Configuration & State
# ============================================================================

struct ParticleConfig:
    simulation_resolution: Int      # Texture size (512 = 262k particles, 1024 = 1M particles)
    particle_count: Int             # Total particles
    point_size: Float               # Render size
    opacity: Float                  # Alpha multiplier
    
struct SimulationParams:
    mode: SimulationMode
    speed: Float                    # Time scale multiplier
    chaos: Float                    # Turbulence intensity
    damping: Float                  # Friction coefficient
    force_multiplier: Float         # Global force scale
    curl_strength: Float            # Curl noise intensity
    center_pull: Float              # Attraction to origin
    max_velocity: Float             # Velocity clamp
    
struct ParticleLifeParams:
    enabled: Bool                   # Enable particle death/respawn
    decay_rate: Float               # Life drain per second
    respawn_bounds: Float           # Max distance before respawn
    
struct ColorParams:
    mode: ColorMode
    primary_color: Vec3             # RGB 0-1
    secondary_color: Vec3           # RGB 0-1
    gradient_strength: Float        # Mix amount
    
struct PostProcessParams:
    decay: Float                    # Motion blur trail
    aberration: Float               # Chromatic aberration
    distortion: Float               # Barrel distortion
    bloom_intensity: Float          # Glow strength
    
struct ModifierParams:
    # Heartbeat
    heartbeat_bpm: Float
    heartbeat_intensity: Float
    # Seismic
    seismic_scale: Float
    seismic_freq: Float
    # Pulse
    pulse_freq: Float
    pulse_amplitude: Float
    # Breathe
    breathe_rate: Float
    breathe_depth: Float
    # Helix
    helix_speed: Float
    helix_tightness: Float
    # Gravity
    gravity_force: Float
    gravity_radius: Float
    # Repulsor
    repulsor_force: Float
    repulsor_falloff: Float
    # Orbit
    orbit_speed: Float
    orbit_radius: Float
    # Vortex
    vortex_strength: Float
    vortex_lift: Float
    # Magnet
    magnet_dipole: Float
    magnet_separation: Float
    # Explosion
    explosion_force: Float
    explosion_decay: Float
    # Swarm
    swarm_cohesion: Float
    swarm_separation: Float

struct AudioReactivity:
    enabled: Bool
    bass_level: Float               # 0-1
    high_level: Float               # 0-1
    overall_level: Float            # 0-1

# ============================================================================
# ACTOR - Main Quantum Particle System
# ============================================================================

actor QuantumParticleSystem:
    # Core Configuration
    state sim_resolution: Int = 512
    state particle_count: Int = 262144
    state simulation_mode: SimulationMode = SimulationMode::ZeroPoint
    
    # Simulation Parameters
    state speed: Float = 1.0
    state chaos: Float = 0.5
    state damping: Float = 0.98
    state force_multiplier: Float = 1.0
    state curl_strength: Float = 1.0
    state center_pull: Float = 0.1
    state max_velocity: Float = 10.0
    
    # Visual Parameters
    state point_size: Float = 1.0
    state opacity: Float = 0.8
    state color_mode: ColorMode = ColorMode::Velocity
    state primary_color: Vec3 = vec3(0.0, 0.5, 1.0)
    state secondary_color: Vec3 = vec3(1.0, 0.0, 1.0)
    state gradient_strength: Float = 1.0
    
    # Particle Life System
    state particle_life_enabled: Bool = false
    state life_decay_rate: Float = 0.01
    state respawn_bounds: Float = 100.0
    
    # Post-Processing
    state decay: Float = 0.95
    state aberration: Float = 0.0
    state distortion: Float = 0.0
    state bloom_intensity: Float = 1.0
    
    # Camera & Interaction
    state auto_orbit: Bool = true
    state orbit_speed: Float = 0.5
    state mouse_interaction_enabled: Bool = true
    
    # Modifiers (Active Flags)
    state heartbeat_active: Bool = false
    state seismic_active: Bool = false
    state pulse_active: Bool = false
    state breathe_active: Bool = false
    state helix_active: Bool = false
    state gravity_active: Bool = false
    state repulsor_active: Bool = false
    state orbit_active: Bool = false
    state vortex_active: Bool = false
    state magnet_active: Bool = false
    state explosion_active: Bool = false
    state swarm_active: Bool = false
    
    # Modifier Parameters
    state heartbeat_bpm: Float = 60.0
    state heartbeat_intensity: Float = 2.0
    state seismic_scale: Float = 1.0
    state seismic_freq: Float = 2.0
    state pulse_freq: Float = 1.0
    state pulse_amplitude: Float = 5.0
    state breathe_rate: Float = 0.5
    state breathe_depth: Float = 10.0
    state helix_speed: Float = 1.0
    state helix_tightness: Float = 0.1
    state gravity_force: Float = 5.0
    state gravity_radius: Float = 10.0
    state repulsor_force: Float = 10.0
    state repulsor_falloff: Float = 2.0
    state orbit_speed_mod: Float = 2.0
    state orbit_radius: Float = 20.0
    state vortex_strength: Float = 5.0
    state vortex_lift: Float = 1.0
    state magnet_dipole: Float = 50.0
    state magnet_separation: Float = 20.0
    state explosion_force: Float = 30.0
    state explosion_decay: Float = 0.95
    state swarm_cohesion: Float = 1.0
    state swarm_separation: Float = 2.0
    
    # Audio Reactivity
    state audio_enabled: Bool = false
    state audio_bass: Float = 0.0
    state audio_high: Float = 0.0
    state audio_level: Float = 0.0
    
    # Fluid Simulation (Navier-Stokes)
    state fluid_sim_enabled: Bool = false
    
    # Runtime State
    state is_initialized: Bool = false
    state elapsed_time: Float = 0.0
    
    on BeginPlay():
        particle_count = sim_resolution * sim_resolution
        is_initialized = true
    
    on Tick(delta_time: Float):
        if is_initialized:
            elapsed_time = elapsed_time + delta_time
    
    # ========================================================================
    # BLUEPRINT CALLABLE METHODS - Simulation Control
    # ========================================================================
    
    @blueprint_callable
    @category("Quantum Particles|Simulation")
    fn SetSimulationMode(new_mode: SimulationMode):
        simulation_mode = new_mode
    
    @blueprint_callable
    @category("Quantum Particles|Simulation")
    fn SetSpeed(new_speed: Float):
        speed = new_speed
    
    @blueprint_callable
    @category("Quantum Particles|Simulation")
    fn SetChaos(new_chaos: Float):
        chaos = new_chaos
    
    @blueprint_callable
    @category("Quantum Particles|Simulation")
    fn SetDamping(new_damping: Float):
        damping = new_damping
    
    @blueprint_callable
    @category("Quantum Particles|Simulation")
    fn ResetSimulation():
        simulation_mode = SimulationMode::ZeroPoint
        elapsed_time = 0.0
    
    # ========================================================================
    # BLUEPRINT CALLABLE METHODS - Visual Control
    # ========================================================================
    
    @blueprint_callable
    @category("Quantum Particles|Visual")
    fn SetColorMode(new_mode: ColorMode):
        color_mode = new_mode
    
    @blueprint_callable
    @category("Quantum Particles|Visual")
    fn SetPrimaryColor(r: Float, g: Float, b: Float):
        primary_color = vec3(r, g, b)
    
    @blueprint_callable
    @category("Quantum Particles|Visual")
    fn SetSecondaryColor(r: Float, g: Float, b: Float):
        secondary_color = vec3(r, g, b)
    
    @blueprint_callable
    @category("Quantum Particles|Visual")
    fn SetPointSize(size: Float):
        point_size = size
    
    @blueprint_callable
    @category("Quantum Particles|Visual")
    fn SetOpacity(new_opacity: Float):
        opacity = new_opacity
    
    # ========================================================================
    # BLUEPRINT CALLABLE METHODS - Modifiers
    # ========================================================================
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn EnableHeartbeat(bpm: Float, intensity: Float):
        heartbeat_active = true
        heartbeat_bpm = bpm
        heartbeat_intensity = intensity
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn DisableHeartbeat():
        heartbeat_active = false
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn EnableVortex(strength: Float, lift: Float):
        vortex_active = true
        vortex_strength = strength
        vortex_lift = lift
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn DisableVortex():
        vortex_active = false
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn EnableGravity(force: Float, radius: Float):
        gravity_active = true
        gravity_force = force
        gravity_radius = radius
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn DisableGravity():
        gravity_active = false
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn EnableExplosion(force: Float):
        explosion_active = true
        explosion_force = force
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn DisableExplosion():
        explosion_active = false
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn EnableSwarm(cohesion: Float, separation: Float):
        swarm_active = true
        swarm_cohesion = cohesion
        swarm_separation = separation
    
    @blueprint_callable
    @category("Quantum Particles|Modifiers")
    fn DisableSwarm():
        swarm_active = false
    
    # ========================================================================
    # BLUEPRINT CALLABLE METHODS - Audio Reactivity
    # ========================================================================
    
    @blueprint_callable
    @category("Quantum Particles|Audio")
    fn SetAudioLevels(bass: Float, high: Float, overall: Float):
        audio_bass = bass
        audio_high = high
        audio_level = overall
    
    @blueprint_callable
    @category("Quantum Particles|Audio")
    fn EnableAudioReactivity():
        audio_enabled = true
    
    @blueprint_callable
    @category("Quantum Particles|Audio")
    fn DisableAudioReactivity():
        audio_enabled = false

# ============================================================================
# BLUEPRINT UTILITIES - Helper Functions
# ============================================================================

@blueprint
fn create_particle_config(resolution: Int, size: Float, opacity: Float) -> ParticleConfig:
    let count = resolution * resolution
    return ParticleConfig()

@blueprint
fn create_simulation_params(mode: SimulationMode, speed: Float, chaos: Float) -> SimulationParams:
    return SimulationParams()

@blueprint
fn lerp_color(a: Vec3, b: Vec3, t: Float) -> Vec3:
    let clamped_t = clamp(t, 0.0, 1.0)
    let r = a.x + (b.x - a.x) * clamped_t
    let g = a.y + (b.y - a.y) * clamped_t
    let b_val = a.z + (b.z - a.z) * clamped_t
    return vec3(r, g, b_val)

@blueprint
fn calculate_particle_count(resolution: Int) -> Int:
    return resolution * resolution

@blueprint
fn get_mode_name(mode: SimulationMode) -> String:
    match mode:
        SimulationMode::ZeroPoint => "Zero-Point Field"
        SimulationMode::GalacticSpiral => "Galactic Spiral"
        SimulationMode::KerrBlackHole => "Kerr Black Hole"
        SimulationMode::LorenzAttractor => "Lorenz Attractor"
        SimulationMode::SuperVortex => "Super Vortex"
        _ => "Unknown Mode"


# ============================================================================
# COMPUTE SHADERS - GPU Particle Simulation
# ============================================================================

# Velocity Shader - Calculates forces and updates particle velocities
shader compute ParticleVelocity(thread_id: Vec3) -> Vec4:
    # Uniforms - Textures
    uniform position_texture: Sampler2D @0
    uniform velocity_texture: Sampler2D @1
    uniform origin_texture: Sampler2D @2
    
    # Uniforms - Simulation Parameters
    uniform time: Float @3
    uniform speed: Float @4
    uniform chaos: Float @5
    uniform damping: Float @6
    uniform mode: Int @7
    
    # Uniforms - Force Controls
    uniform force_multiplier: Float @8
    uniform curl_strength: Float @9
    uniform center_pull: Float @10
    uniform max_velocity: Float @11
    
    # Uniforms - Modifiers (Active Flags)
    uniform heartbeat_active: Float @12
    uniform vortex_active: Float @13
    uniform gravity_active: Float @14
    uniform explosion_active: Float @15
    
    # Uniforms - Modifier Parameters
    uniform heartbeat_bpm: Float @16
    uniform heartbeat_intensity: Float @17
    uniform vortex_strength: Float @18
    uniform vortex_lift: Float @19
    uniform gravity_force: Float @20
    uniform gravity_radius: Float @21
    uniform explosion_force: Float @22
    
    # Uniforms - Audio Reactivity
    uniform audio_bass: Float @23
    uniform audio_high: Float @24
    uniform audio_level: Float @25
    
    # Calculate UV from thread ID
    let uv = vec2(thread_id.x, thread_id.y)
    
    # Sample current state
    let pos = sample(position_texture, uv).xyz
    let vel = sample(velocity_texture, uv).xyz
    let origin = sample(origin_texture, uv).xyz
    
    # Initialize force accumulator
    var force = vec3(0.0, 0.0, 0.0)
    
    # Mode 0: Zero-Point (Reset/Stable)
    if mode == 0:
        let diff = origin - pos
        force = force + diff * 0.1 * speed
    
    # Mode 3: Galactic Spiral
    if mode == 3:
        let r = length(pos)
        let orbital_speed = 10.0 * speed / sqrt(r + 0.1)
        force = force + vec3(-pos.z, 0.0, pos.x) * orbital_speed * 0.05
        force = force - normalize(pos) * (5.0 / (r * r + 1.0))
    
    # Heartbeat Modifier
    if heartbeat_active > 0.5:
        let beat_time = time * (heartbeat_bpm / 60.0)
        let pulse = sin(beat_time * 6.28)
        force = force + normalize(pos) * pulse * heartbeat_intensity * 0.2
    
    # Vortex Modifier
    if vortex_active > 0.5:
        let r = length(vec2(pos.x, pos.z))
        let spin = vec3(-pos.z, 0.0, pos.x)
        force = force + spin * vortex_strength / (r + 1.0)
        force = force + vec3(0.0, vortex_lift, 0.0)
        force = force - normalize(vec3(pos.x, 0.0, pos.z)) * 0.5
    
    # Gravity Modifier
    if gravity_active > 0.5:
        let dist = length(pos)
        if dist < gravity_radius:
            force = force - normalize(pos) * (gravity_force / (dist * dist + 0.1)) * 0.5
    
    # Explosion Modifier
    if explosion_active > 0.5:
        let dist = length(pos)
        let intensity = explosion_force / (dist + 1.0)
        force = force + normalize(pos) * intensity * 0.1
    
    # Audio Reactivity
    if audio_bass > 0.05:
        let center_dir = normalize(pos)
        force = force + center_dir * audio_bass * 0.8 * chaos
    
    # Apply forces to velocity
    var new_vel = vel + force * force_multiplier
    
    # Apply damping (friction)
    new_vel = new_vel * damping
    
    # Clamp velocity
    let vel_mag = length(new_vel)
    if vel_mag > max_velocity:
        new_vel = normalize(new_vel) * max_velocity
    
    return vec4(new_vel, 1.0)

# Position Shader - Integrates velocity to update particle positions
shader compute ParticlePosition(thread_id: Vec3) -> Vec4:
    # Uniforms - Textures
    uniform position_texture: Sampler2D @0
    uniform velocity_texture: Sampler2D @1
    uniform origin_texture: Sampler2D @2
    
    # Uniforms - Simulation Parameters
    uniform time: Float @3
    uniform delta_time: Float @4
    uniform mode: Int @5
    
    # Uniforms - Particle Life System
    uniform life_enabled: Float @6
    uniform life_decay_rate: Float @7
    uniform respawn_bounds: Float @8
    
    # Calculate UV from thread ID
    let uv = vec2(thread_id.x, thread_id.y)
    
    # Sample current state
    let pos_data = sample(position_texture, uv)
    var pos = pos_data.xyz
    var life = pos_data.w
    
    let vel = sample(velocity_texture, uv).xyz
    let origin = sample(origin_texture, uv).xyz
    
    # Integrate velocity
    pos = pos + vel * delta_time
    
    # Particle life system
    var respawn = false
    
    if life_enabled > 0.5:
        life = life - life_decay_rate
        if life <= 0.0:
            respawn = true
    
    # Bounds check
    if length(pos) > respawn_bounds:
        respawn = true
    
    # Respawn logic
    if respawn:
        life = 1.0
        if mode == 0:
            pos = origin
        else:
            # Sphere distribution
            let theta = time * 0.1
            let phi = time * 0.2
            let r = 30.0
            pos = vec3(r * sin(phi) * cos(theta), r * sin(phi) * sin(theta), r * cos(phi))
    
    return vec4(pos, life)

# Render Shader - Vertex shader for particle rendering
shader compute ParticleRender(thread_id: Vec3) -> Vec4:
    # Uniforms - Textures
    uniform position_texture: Sampler2D @0
    uniform velocity_texture: Sampler2D @1
    
    # Uniforms - Visual Parameters
    uniform primary_color: Vec3 @2
    uniform secondary_color: Vec3 @3
    uniform color_mode: Int @4
    uniform opacity: Float @5
    uniform point_size: Float @6
    
    # Calculate UV from thread ID
    let uv = vec2(thread_id.x, thread_id.y)
    
    # Sample particle state
    let pos_data = sample(position_texture, uv)
    let pos = pos_data.xyz
    let life = pos_data.w
    
    let vel = sample(velocity_texture, uv).xyz
    let speed = length(vel)
    
    # Color calculation based on mode
    var color = primary_color
    
    # Mode 1: Velocity-based color
    if color_mode == 1:
        let t = clamp(speed * 0.05, 0.0, 1.0)
        color = primary_color * (1.0 - t) + secondary_color * t
    
    # Mode 3: Gradient based on position
    if color_mode == 3:
        let t = normalize(pos).y * 0.5 + 0.5
        color = primary_color * (1.0 - t) + secondary_color * t
    
    # Apply life-based opacity
    let alpha = life * opacity
    
    return vec4(color, alpha)
