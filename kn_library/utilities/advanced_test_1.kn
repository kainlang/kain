// Advanced UE5 features test - Phase 2

// === ENUMS ===
enum ClonerMode:
    Grid
    Radial
    Linear
    Spline

// === STRUCTS WITH ADVANCED META ===
@datatable
struct DistributionLayer:
    @category("Layer")
    enabled: Bool
    
    @category("Layer")
    mode: ClonerMode
    
    // Grid params with complex EditCondition
    @category("Layer")
    @edit_condition("mode == ClonerMode::Grid")
    @clamp_min(1)
    grid_count: Int
    
    @category("Layer")
    @edit_condition("mode == ClonerMode::Grid")
    grid_spacing: Vec3

// === BLUEPRINT FUNCTIONS (Pure and Callable) ===
@blueprint
@pure
fn get_distance(a: Vec3, b: Vec3) -> Float:
    let dx = b.x - a.x
    let dy = b.y - a.y
    let dz = b.z - a.z
    return sqrt(dx * dx + dy * dy + dz * dz)

@blueprint
fn apply_force(location: Vec3, strength: Float):
    println("Applying force at {location} with strength {strength}")

// === ACTOR WITH ADVANCED FEATURES ===
actor ClonerActor:
    state instance_count: Int = 0
    state is_animating: Bool = false
    
    @blueprint_pure
    fn GetInstanceCount() -> Int:
        return instance_count
    
    @blueprint_pure
    fn IsAnimating() -> Bool:
        return is_animating
    
    @blueprint_callable
    fn ForceRebuild():
        println("Rebuilding cloner")
        instance_count = 100
