# ============================================================================
# KAIN TOOLKIT - All-in-One UE5 Utility Plugin
# ============================================================================
# A production-grade utility tool that appears in:
#   - Viewport icon (top-right toolbar)
#   - Content browser right-click menu
#   - Tools menu → "KAIN Toolkit"
#
# Features instant visual feedback for:
#   - Mesh spawning and manipulation
#   - Material parameter tweaking
#   - Light configuration
#   - Camera utilities
#   - Scene analysis
#   - Performance profiling
#
# Tests corpus-driven codegen:
#   - 2,346 Slate widgets
#   - 21,134 UE5 types
#   - 7,271 shader intrinsics
# ============================================================================

# ----------------------------------------------------------------------------
# I. ENUMS - Type-safe categories
# ----------------------------------------------------------------------------

enum EToolCategory:
    Mesh
    Material
    Lighting
    Camera
    Scene
    Performance
    Utilities

enum ESpawnShape:
    Sphere
    Cube
    Cylinder
    Cone
    Plane
    Torus

@wasm
enum ELightType:
    Directional
    Point
    Spot
    Rect
    Sky
@wasm
enum EMaterialPreset:
    Metal
    Plastic
    Glass
    Wood
    Stone
    Fabric

enum EAnalysisMode:
    Triangles
    Materials
    Textures
    Lights
    Actors
    Components

# ----------------------------------------------------------------------------
# II. DELEGATES - Event system
# ----------------------------------------------------------------------------

type OnToolExecuted = delegate(EToolCategory)
type OnValueChanged = delegate(Float)
type OnColorChanged = delegate(Vec3)
type OnShapeSpawned = delegate(ESpawnShape)
type OnAnalysisComplete = delegate(String)
type OnMeshSelected = delegate(String)

# ----------------------------------------------------------------------------
# III. DATA STRUCTURES
# ----------------------------------------------------------------------------

struct ToolResult:
    category: EToolCategory
    success: Bool
    message: String
    execution_time: Float

@datatable
struct MeshPreset:
    id: Int
    name: String
    mesh_path: String
    scale: Vec3
    material_slots: Int

@datatable
struct MaterialPreset:
    id: Int
    name: String
    preset_type: EMaterialPreset
    base_color: Vec3
    roughness: Float
    metallic: Float
    specular: Float

struct SceneStats:
    total_actors: Int
    total_triangles: Int
    total_materials: Int
    total_lights: Int
    draw_calls: Int
    memory_mb: Float

# ----------------------------------------------------------------------------
# IV. SLATE WIDGETS - UI Components
# ----------------------------------------------------------------------------

# --- Tool Category Selector ---
@slate
struct SToolCategoryPanel:
    @argument
    title: Text

    @attribute
    selected_category: EToolCategory

    @event
    on_category_changed: OnToolExecuted

    fn Compose() -> Widget:
        let vbox = VerticalBox()

        let header = TextBlock()
        header.Text(title)
        vbox.Add(header)

        # Category buttons
        let btn_mesh = Button()
        btn_mesh.Text("Mesh Tools")
        btn_mesh.OnClicked(on_category_changed)
        vbox.Add(btn_mesh)

        let btn_material = Button()
        btn_material.Text("Material Tools")
        btn_material.OnClicked(on_category_changed)
        vbox.Add(btn_material)

        let btn_lighting = Button()
        btn_lighting.Text("Lighting Tools")
        btn_lighting.OnClicked(on_category_changed)
        vbox.Add(btn_lighting)

        let btn_camera = Button()
        btn_camera.Text("Camera Tools")
        btn_camera.OnClicked(on_category_changed)
        vbox.Add(btn_camera)

        let btn_scene = Button()
        btn_scene.Text("Scene Analysis")
        btn_scene.OnClicked(on_category_changed)
        vbox.Add(btn_scene)

        let btn_perf = Button()
        btn_perf.Text("Performance")
        btn_perf.OnClicked(on_category_changed)
        vbox.Add(btn_perf)

        return vbox

# --- Mesh Spawner Panel ---
@slate
struct SMeshSpawnerPanel:
    @argument
    panel_title: Text

    @attribute
    spawn_count: Int

    @attribute
    spawn_radius: Float

    @attribute
    selected_shape: ESpawnShape

    @event
    on_spawn: OnShapeSpawned

    @event
    on_count_changed: OnValueChanged

    @event
    on_radius_changed: OnValueChanged

    fn Compose() -> Widget:
        let vbox = VerticalBox()

        let title = TextBlock()
        title.Text(panel_title)
        vbox.Add(title)

        # Shape selector
        let shape_row = HorizontalBox()
        let shape_label = TextBlock()
        shape_label.Text("Shape:")
        shape_row.Add(shape_label)
        
        let shape_combo = ComboBox()
        shape_row.Add(shape_combo)
        vbox.Add(shape_row)

        # Count slider
        let count_row = HorizontalBox()
        let count_label = TextBlock()
        count_label.Text("Count:")
        count_row.Add(count_label)
        
        let count_slider = Slider()
        count_slider.MinValue(1.0)
        count_slider.MaxValue(100.0)
        count_slider.Value(10.0)
        count_slider.OnValueChanged(on_count_changed)
        count_row.Add(count_slider)
        vbox.Add(count_row)

        # Radius slider
        let radius_row = HorizontalBox()
        let radius_label = TextBlock()
        radius_label.Text("Radius:")
        radius_row.Add(radius_label)
        
        let radius_slider = Slider()
        radius_slider.MinValue(100.0)
        radius_slider.MaxValue(5000.0)
        radius_slider.Value(1000.0)
        radius_slider.OnValueChanged(on_radius_changed)
        radius_row.Add(radius_slider)
        vbox.Add(radius_row)

        # Spawn button
        let spawn_btn = Button()
        spawn_btn.Text("Spawn Meshes")
        spawn_btn.OnClicked(on_spawn)
        vbox.Add(spawn_btn)

        return vbox

# --- Material Editor Panel ---
@slate
struct SMaterialEditorPanel:
    @argument
    title: Text

    @attribute
    base_color: Vec3

    @attribute
    roughness: Float

    @attribute
    metallic: Float

    @attribute
    specular: Float

    @event
    on_color_changed: OnColorChanged

    @event
    on_roughness_changed: OnValueChanged

    @event
    on_metallic_changed: OnValueChanged

    @event
    on_specular_changed: OnValueChanged

    fn Compose() -> Widget:
        let vbox = VerticalBox()

        let header = TextBlock()
        header.Text(title)
        vbox.Add(header)

        # Base color picker
        let color_row = HorizontalBox()
        let color_label = TextBlock()
        color_label.Text("Base Color:")
        color_row.Add(color_label)
        
        let color_block = ColorBlock()
        color_block.Color(base_color)
        color_row.Add(color_block)
        vbox.Add(color_row)

        # Roughness slider
        let rough_row = HorizontalBox()
        let rough_label = TextBlock()
        rough_label.Text("Roughness:")
        rough_row.Add(rough_label)
        
        let rough_slider = Slider()
        rough_slider.MinValue(0.0)
        rough_slider.MaxValue(1.0)
        rough_slider.Value(roughness)
        rough_slider.OnValueChanged(on_roughness_changed)
        rough_row.Add(rough_slider)
        vbox.Add(rough_row)

        # Metallic slider
        let metal_row = HorizontalBox()
        let metal_label = TextBlock()
        metal_label.Text("Metallic:")
        metal_row.Add(metal_label)
        
        let metal_slider = Slider()
        metal_slider.MinValue(0.0)
        metal_slider.MaxValue(1.0)
        metal_slider.Value(metallic)
        metal_slider.OnValueChanged(on_metallic_changed)
        metal_row.Add(metal_slider)
        vbox.Add(metal_row)

        # Specular slider
        let spec_row = HorizontalBox()
        let spec_label = TextBlock()
        spec_label.Text("Specular:")
        spec_row.Add(spec_label)
        
        let spec_slider = Slider()
        spec_slider.MinValue(0.0)
        spec_slider.MaxValue(1.0)
        spec_slider.Value(specular)
        spec_slider.OnValueChanged(on_specular_changed)
        spec_row.Add(spec_slider)
        vbox.Add(spec_row)

        return vbox

# --- Scene Analysis Panel ---
@slate
struct SSceneAnalysisPanel:
    @argument
    title: Text

    @attribute
    stats: SceneStats

    @attribute
    analysis_mode: EAnalysisMode

    @event
    on_analyze: OnAnalysisComplete

    fn Compose() -> Widget:
        let vbox = VerticalBox()

        let header = TextBlock()
        header.Text(title)
        vbox.Add(header)

        # Stats display
        let scroll = ScrollBox()
        let stats_vbox = VerticalBox()

        let actors_text = TextBlock()
        actors_text.Text("Total Actors: 0")
        stats_vbox.Add(actors_text)

        let tris_text = TextBlock()
        tris_text.Text("Total Triangles: 0")
        stats_vbox.Add(tris_text)

        let mats_text = TextBlock()
        mats_text.Text("Total Materials: 0")
        stats_vbox.Add(mats_text)

        let lights_text = TextBlock()
        lights_text.Text("Total Lights: 0")
        stats_vbox.Add(lights_text)

        let draws_text = TextBlock()
        draws_text.Text("Draw Calls: 0")
        stats_vbox.Add(draws_text)

        let mem_text = TextBlock()
        mem_text.Text("Memory: 0 MB")
        stats_vbox.Add(mem_text)

        scroll.Add(stats_vbox)
        vbox.Add(scroll)

        # Analyze button
        let analyze_btn = Button()
        analyze_btn.Text("Analyze Scene")
        analyze_btn.OnClicked(on_analyze)
        vbox.Add(analyze_btn)

        return vbox

# --- Main Dashboard ---
@slate
struct SToolkitDashboard:
    @argument
    window_title: Text

    @attribute
    current_category: EToolCategory

    @event
    on_tool_executed: OnToolExecuted

    fn Compose() -> Widget:
        let splitter = Splitter()

        # Left panel - category selector
        let left_panel = SToolCategoryPanel()
        left_panel.title("Tool Categories")
        left_panel.selected_category(EToolCategory::Mesh)
        left_panel.on_category_changed(on_tool_executed)
        splitter.Add(left_panel)

        # Right panel - tool content (tabs)
        let right_panel = VerticalBox()

        let mesh_panel = SMeshSpawnerPanel()
        mesh_panel.panel_title("Mesh Spawner")
        mesh_panel.spawn_count(10)
        mesh_panel.spawn_radius(1000.0)
        right_panel.Add(mesh_panel)

        let material_panel = SMaterialEditorPanel()
        material_panel.title("Material Editor")
        material_panel.base_color(vec3(0.8, 0.8, 0.8))
        material_panel.roughness(0.5)
        material_panel.metallic(0.0)
        material_panel.specular(0.5)
        right_panel.Add(material_panel)

        let analysis_panel = SSceneAnalysisPanel()
        analysis_panel.title("Scene Analysis")
        right_panel.Add(analysis_panel)

        splitter.Add(right_panel)

        return splitter

# ----------------------------------------------------------------------------
# V. DETAILS PANEL - Property customization
# ----------------------------------------------------------------------------

@details
struct ToolkitActorDetails:
    @category("Mesh Spawning")
    @slider(1.0, 100.0)
    spawn_count: Float

    @category("Mesh Spawning")
    @slider(100.0, 10000.0)
    spawn_radius: Float

    @category("Material")
    @color_picker
    base_color: Vec3

    @category("Material")
    @slider(0.0, 1.0)
    roughness: Float

    @category("Material")
    @slider(0.0, 1.0)
    metallic: Float

    @category("Material")
    @slider(0.0, 1.0)
    specular: Float

    @category("Actions")
    @button("Spawn Meshes")
    fn SpawnMeshes():
        println("Spawning meshes...")

    @category("Actions")
    @button("Analyze Scene")
    fn AnalyzeScene():
        println("Analyzing scene...")

    @category("Actions")
    @button("Clear All")
    fn ClearAll():
        println("Clearing all...")

# ----------------------------------------------------------------------------
# VI. VIEWPORT - Custom preview rendering
# ----------------------------------------------------------------------------

@viewport
struct ToolkitViewport:
    @scene_actor
    preview_mesh: String

    @camera
    camera_position: Vec3

    @camera
    camera_rotation: Vec3

    fn SetPreviewMesh(mesh_path: String):
        preview_mesh = mesh_path

    fn SetCameraPosition(pos: Vec3):
        camera_position = pos

    fn SetCameraRotation(rot: Vec3):
        camera_rotation = rot

    fn ResetCamera():
        camera_position = vec3(0.0, -500.0, 200.0)
        camera_rotation = vec3(0.0, 0.0, 0.0)

# ----------------------------------------------------------------------------
# VII. TOOLBAR - Quick actions
# ----------------------------------------------------------------------------

@toolbar
struct ToolkitToolbar:
    @button("Spawn", icon="Plus")
    fn QuickSpawn():
        println("Quick spawn")

    @button("Clear", icon="Delete")
    fn QuickClear():
        println("Quick clear")

    @separator

    @toggle("Grid", icon="Grid")
    fn ToggleGrid(enabled: Bool):
        println("Grid toggled")

    @toggle("Wireframe", icon="Wireframe")
    fn ToggleWireframe(enabled: Bool):
        println("Wireframe toggled")

    @separator

    @button("Analyze", icon="Search", shortcut="Ctrl+A")
    fn QuickAnalyze():
        println("Quick analyze")

    @button("Reset", icon="Refresh", shortcut="Ctrl+R")
    fn QuickReset():
        println("Quick reset")

# ----------------------------------------------------------------------------
# VIII. ASSET EDITOR - Main editor window
# ----------------------------------------------------------------------------

@asset_editor
struct ToolkitEditor:
    @asset
    toolkit_asset: MeshPreset

    @viewport
    viewport: ToolkitViewport

    @details
    properties: ToolkitActorDetails

    @toolbar
    toolbar: ToolkitToolbar

    @slate
    dashboard: SToolkitDashboard

    fn OnOpen():
        println("Toolkit editor opened")

    fn OnClose():
        println("Toolkit editor closed")

    fn OnAssetChanged():
        println("Asset changed")

# ----------------------------------------------------------------------------
# IX. EDITOR MODULE - Integration with UE5
# ----------------------------------------------------------------------------

@editor_module
struct ToolkitModule:
    @menu_entry("Tools/KAIN Toolkit")
    fn OpenToolkit():
        println("Opening KAIN Toolkit...")

    @menu_entry("Tools/KAIN Toolkit/Mesh Spawner")
    fn OpenMeshSpawner():
        println("Opening Mesh Spawner...")

    @menu_entry("Tools/KAIN Toolkit/Material Editor")
    fn OpenMaterialEditor():
        println("Opening Material Editor...")

    @menu_entry("Tools/KAIN Toolkit/Scene Analyzer")
    fn OpenSceneAnalyzer():
        println("Opening Scene Analyzer...")

    @toolbar_button("KAIN Toolkit", icon="Tools")
    fn ToolbarOpenToolkit():
        println("Toolbar: Opening KAIN Toolkit...")

    @content_browser_action("KAIN Toolkit", context="Actor")
    fn ContentBrowserToolkit():
        println("Content browser: KAIN Toolkit...")
