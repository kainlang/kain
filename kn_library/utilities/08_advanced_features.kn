    return -1

# ----------------------------------------------------------------------------
# COMPLETE EXAMPLE: FULL-FEATURED ACTOR
# Demonstrates everything together
# ----------------------------------------------------------------------------

@uclass("Blueprintable", "BlueprintType", "Placeable")
actor UltimateExampleActor:
    # Components
    state health: HealthComponent = HealthComponent()
    state inventory: InventoryComponent = InventoryComponent()
    state combat: CombatComponent = CombatComponent()
    state ai: AIComponent = AIComponent()
    
    # Replicated state
    @replicated
    @savegame
    state actor_name: String = "Ultimate Actor"
    
    @replicated
    state team_id: Int = 0
    
    # Editable properties
    @editdefaults
    @meta("ClampMin", "0.0")
    @meta("ClampMax", "1000.0")
    @meta("Tooltip", "Maximum health for this actor")
    state max_health: Float = 100.0
    
    @editdefaults
    @meta("Category", "Combat")
    state base_damage: Float = 10.0
    
    # Transient state
    @transient
    state last_update_time: Float = 0.0
    
    # Lifecycle
    on BeginPlay():
        health.max_health = max_health
        health.current_health = max_health
        println("Ultimate actor initialized")
    
    on Tick(delta_time: Float):
        last_update_time = last_update_time + delta_time
    
    # Server RPCs
    on Server_TakeDamage(damage: Float, attacker: Actor):
        health.current_health = health.current_health - damage
        if health.current_health <= 0.0:
            Server_Die(attacker)
        Multicast_DamageEffect(damage)
    
    on Server_Die(killer: Actor):
        health.is_dead = true
        Multicast_DeathEffect()
    
    # Client RPCs
    on Client_ShowMessage(message: String):
        println("Message: {message}")
    
    # Multicast RPCs
    on Multicast_DamageEffect(damage: Float):
        println("Damage effect: {damage}")
    
    on Multicast_DeathEffect():
        println("Death effect")
    
    # Blueprint-callable methods
    @blueprint_callable
    @category("Ultimate|Combat")
    fn Attack(target: Actor):
        Server_TakeDamage(base_damage, target)
    
    @blueprint_callable
    @category("Ultimate|Inventory")
    fn AddItem(item_id: Int, quantity: Int) -> Bool:
        return true
    
    @blueprint_callable
    @category("Ultimate|Info")
    fn GetActorInfo() -> String:
        return "Name: {actor_name}, Health: {health.current_health}/{health.max_health}"
