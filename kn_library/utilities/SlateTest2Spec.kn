# ============================================================================
# SLATE TEST 2: COMPREHENSIVE PHASE 4 VALIDATION
# Tests ALL Slate features: Widgets, Details, Viewports, Toolbars, Asset Editors
# ============================================================================

# ----------------------------------------------------------------------------
# I. ENUMS & DELEGATES - Type-safe UI state
# ----------------------------------------------------------------------------

enum EShaderQuality:
    Low
    Medium
    High
    Ultra

enum EViewportMode:
    Lit
    Unlit
    Wireframe
    DetailLighting

enum EToolMode:
    Select
    Move
    Rotate
    Scale

type OnButtonClicked = delegate()
type OnValueChanged = delegate(Float)
type OnColorChanged = delegate(Vec3)
type OnTextChanged = delegate(String)
type OnSelectionChanged = delegate(Int)
type OnCheckStateChanged = delegate(Bool)

# ----------------------------------------------------------------------------
# II. DATA STRUCTURES
# ----------------------------------------------------------------------------

struct MaterialPreset:
    name: String
    base_color: Vec3
    roughness: Float
    metallic: Float
    emissive: Float

@datatable
struct AssetData:
    id: Int
    name: String
    category: String
    thumbnail_path: String
    rating: Float

# ----------------------------------------------------------------------------
# III. SHADERS - For preview rendering
# ----------------------------------------------------------------------------

shader fragment PreviewShader(uv: Vec2) -> Vec4:
    uniform CFG_HIGH_QUALITY: Float @0
    uniform ENABLE_SHADOWS: Float @1
    uniform base_color: Vec3 @2
    uniform roughness: Float @3
    uniform metallic: Float @4
    uniform emissive: Float @5
    uniform time: Float @6
    
    let light_dir = normalize(vec3(0.5, 0.5, 1.0))
    let normal = vec3(0.0, 0.0, 1.0)
    let NdotL = max(dot(normal, light_dir), 0.0)
    
    var diffuse = base_color * NdotL
    var specular = vec3(0, 0, 0)
    
    if CFG_HIGH_QUALITY:
        let view_dir = vec3(0, 0, 1)
        let half_vec = normalize(light_dir + view_dir)
        let NdotH = max(dot(normal, half_vec), 0.0)
        specular = vec3(1, 1, 1) * pow(NdotH, 32.0 * (1.0 - roughness)) * metallic
    
    if ENABLE_SHADOWS:
        diffuse = diffuse * 0.8
    
    let emissive_contrib = base_color * emissive
    let final_color = diffuse + specular + emissive_contrib
    
    return vec4(final_color, 1.0)

shader compute NoiseGenerator(thread_id: Vec3) -> Vec4:
    uniform seed: Float @0
    uniform scale: Float @1
    uniform octaves: Float @2
    
    let uv = vec2(thread_id.x * scale, thread_id.y * scale)
    let noise = fract(sin(dot(uv, vec2(12.9898, 78.233)) + seed) * 43758.5453)
    
    return vec4(noise, noise, noise, 1.0)

# ----------------------------------------------------------------------------
# IV. ACTORS - Preview scene actors
# ----------------------------------------------------------------------------

actor PreviewMeshActor:
    state mesh_component: StaticMeshComponent = StaticMeshComponent()
    state material_instance: MaterialInstanceDynamic = null
    
    @replicated
    state base_color: Vec3 = vec3(0.8, 0.8, 0.8)
    @replicated
    state roughness: Float = 0.5
    @replicated
    state metallic: Float = 0.0
    @replicated
    state emissive: Float = 0.0
    
    on BeginPlay():
        material_instance = CreateDynamicMaterialInstance(PreviewShader)
        mesh_component.SetMaterial(0, material_instance)
        UpdateMaterialParameters()
    
    on UpdateMaterialParameters():
        if material_instance != null:
            material_instance.SetVectorParameterValue("base_color", base_color)
            material_instance.SetScalarParameterValue("roughness", roughness)
            material_instance.SetScalarParameterValue("metallic", metallic)
            material_instance.SetScalarParameterValue("emissive", emissive)
    
    @blueprint_callable
    fn SetMaterialProperties(color: Vec3, r: Float, m: Float, e: Float):
        base_color = color
        roughness = r
        metallic = m
        emissive = e
        UpdateMaterialParameters()

# ----------------------------------------------------------------------------
# V. SLATE WIDGETS - Basic to Advanced
# ----------------------------------------------------------------------------

# Simple widget - Basic controls
@slate
struct SSimpleControls:
    @argument
    title: Text
    
    @attribute
    slider_value: Float
    
    @attribute
    checkbox_state: Bool
    
    @event
    on_slider_changed: OnValueChanged
    
    @event
    on_checkbox_changed: OnCheckStateChanged
    
    @event
    on_button_clicked: OnButtonClicked
    
    fn Compose() -> Widget:
        return VerticalBox()

# Advanced widget - Color picker with presets
@slate
struct SColorPickerAdvanced:
    @argument
    initial_color: Vec3
    
    @attribute
    current_color: Vec3
    
    @event
    on_color_changed: OnColorChanged
    
    presets: Array<Vec3>
    
    fn Construct():
        # Initialize color presets
        push(presets, vec3(1.0, 0.0, 0.0))  # Red
        push(presets, vec3(0.0, 1.0, 0.0))  # Green
        push(presets, vec3(0.0, 0.0, 1.0))  # Blue
        push(presets, vec3(1.0, 1.0, 0.0))  # Yellow
        push(presets, vec3(1.0, 0.0, 1.0))  # Magenta
        push(presets, vec3(0.0, 1.0, 1.0))  # Cyan
        push(presets, vec3(1.0, 1.0, 1.0))  # White
        push(presets, vec3(0.0, 0.0, 0.0))  # Black
    
    fn Compose() -> Widget:
        return VerticalBox()

# Complex widget - Material editor with live preview
@slate
struct SMaterialEditor:
    @argument
    material_name: Text
    
    @attribute
    base_color: Vec3
    
    @attribute
    roughness: Float
    
    @attribute
    metallic: Float
    
    @attribute
    emissive: Float
    
    @event
    on_save: OnButtonClicked
    
    @event
    on_reset: OnButtonClicked
    
    preview_material: MaterialInstanceDynamic
    
    fn Construct():
        preview_material = CreateDynamicMaterialInstance(PreviewShader)
        UpdatePreview()
    
    fn UpdatePreview():
        if preview_material != null:
            preview_material.SetVectorParameterValue("base_color", base_color)
            preview_material.SetScalarParameterValue("roughness", roughness)
            preview_material.SetScalarParameterValue("metallic", metallic)
            preview_material.SetScalarParameterValue("emissive", emissive)
    
    fn Compose() -> Widget:
        return Splitter()

# List view widget - Asset browser
@slate
struct SAssetBrowser:
    @argument
    category_filter: String
    
    assets: Array<AssetData>
    
    selected_asset: Option<AssetData>
    
    @event
    on_asset_selected: OnSelectionChanged
    
    fn Compose() -> Widget:
        return VerticalBox()

# ----------------------------------------------------------------------------
# VI. DETAILS CUSTOMIZATION - Property panels
# ----------------------------------------------------------------------------

@details
struct MaterialDetails:
    @category("Base Properties")
    @color_picker
    base_color: Vec3
    
    @category("Base Properties")
    @slider(0.0, 1.0)
    roughness: Float
    
    @category("Base Properties")
    @slider(0.0, 1.0)
    metallic: Float
    
    @category("Advanced")
    @slider(0.0, 10.0)
    emissive_strength: Float
    
    @category("Advanced")
    @visible_if("emissive_strength > 0.0")
    @color_picker
    emissive_color: Vec3
    
    @category("Textures")
    @asset_picker(allowed_classes=["Texture2D"])
    albedo_texture: Texture2D
    
    @category("Textures")
    @asset_picker(allowed_classes=["Texture2D"])
    normal_texture: Texture2D
    
    @category("Textures")
    @asset_picker(allowed_classes=["Texture2D"])
    roughness_texture: Texture2D
    
    @category("Actions")
    @button("Reset to Default")
    fn ResetToDefault():
        base_color = vec3(0.8, 0.8, 0.8)
        roughness = 0.5
        metallic = 0.0
        emissive_strength = 0.0
    
    @category("Actions")
    @button("Apply Preset")
    fn ApplyPreset():
        # Apply a preset configuration
        base_color = vec3(1.0, 0.0, 0.0)
        roughness = 0.3
        metallic = 0.8

@details
struct MeshDetails:
    @category("Transform")
    location: Vec3
    
    @category("Transform")
    rotation: Vec3
    
    @category("Transform")
    scale: Vec3
    
    @category("Mesh")
    @asset_picker(allowed_classes=["StaticMesh"])
    static_mesh: StaticMesh
    
    @category("Mesh")
    @slider(0, 10)
    lod_level: Int
    
    @category("Rendering")
    cast_shadows: Bool
    
    @category("Rendering")
    receive_decals: Bool
    
    @category("Collision")
    collision_enabled: Bool
    
    @category("Collision")
    collision_profile: String

# ----------------------------------------------------------------------------
# VII. VIEWPORT - 3D preview
# ----------------------------------------------------------------------------

@viewport
struct MaterialPreviewViewport:
    @scene_actor
    preview_mesh: PreviewMeshActor
    
    @camera
    camera: EditorCamera
    
    viewport_mode: EViewportMode
    
    fn SetMaterial(color: Vec3, roughness: Float, metallic: Float, emissive: Float):
        preview_mesh.SetMaterialProperties(color, roughness, metallic, emissive)
    
    fn SetViewportMode(mode: EViewportMode):
        viewport_mode = mode
        # Update viewport rendering mode

@viewport
struct MeshEditorViewport:
    @scene_actor
    editable_mesh: PreviewMeshActor
    
    @camera
    camera: EditorCamera
    
    @gizmo
    transform_gizmo: TransformGizmo
    
    tool_mode: EToolMode
    
    fn SetToolMode(mode: EToolMode):
        tool_mode = mode
        transform_gizmo.SetMode(mode)

# ----------------------------------------------------------------------------
# VIII. TOOLBAR - Editor commands
# ----------------------------------------------------------------------------

@toolbar
struct MaterialEditorToolbar:
    @button("Save", icon="Save", shortcut="Ctrl+S")
    fn OnSave():
        # Save material
        println("Material saved")
    
    @button("Compile", icon="Compile", shortcut="F7")
    fn OnCompile():
        # Compile material
        println("Material compiled")
    
    @separator
    
    @toggle("Show Grid", icon="Grid")
    show_grid: Bool
    
    @toggle("Show Stats", icon="Stats")
    show_stats: Bool
    
    @separator
    
    @dropdown("Quality", icon="Quality")
    quality_options: Array<String>
    
    @button("Reset Camera", icon="Camera")
    fn OnResetCamera():
        # Reset viewport camera
        println("Camera reset")

@toolbar
struct MeshEditorToolbar:
    @button("Import", icon="Import")
    fn OnImport():
        println("Import mesh")
    
    @button("Export", icon="Export")
    fn OnExport():
        println("Export mesh")
    
    @separator
    
    @button("Select", icon="Select", shortcut="Q")
    fn OnSelectMode():
        println("Select mode")
    
    @button("Move", icon="Move", shortcut="W")
    fn OnMoveMode():
        println("Move mode")
    
    @button("Rotate", icon="Rotate", shortcut="E")
    fn OnRotateMode():
        println("Rotate mode")
    
    @button("Scale", icon="Scale", shortcut="R")
    fn OnScaleMode():
        println("Scale mode")

# ----------------------------------------------------------------------------
# IX. ASSET EDITOR - Complete editor framework
# ----------------------------------------------------------------------------

@asset_editor
struct MaterialAssetEditor:
    @asset
    material: MaterialAsset
    
    @viewport
    preview: MaterialPreviewViewport
    
    @details
    properties: MaterialDetails
    
    @toolbar
    toolbar: MaterialEditorToolbar
    
    @slate
    main_ui: SMaterialEditor
    
    fn OnAssetOpened():
        # Initialize editor when asset is opened
        preview.SetMaterial(
            material.base_color,
            material.roughness,
            material.metallic,
            material.emissive
        )
        properties.base_color = material.base_color
        properties.roughness = material.roughness
        properties.metallic = material.metallic
    
    fn OnPropertyChanged():
        # Update preview when properties change
        preview.SetMaterial(
            properties.base_color,
            properties.roughness,
            properties.metallic,
            properties.emissive_strength
        )
    
    fn OnSave():
        # Save material asset
        material.base_color = properties.base_color
        material.roughness = properties.roughness
        material.metallic = properties.metallic
        material.emissive = properties.emissive_strength

@asset_editor
struct MeshAssetEditor:
    @asset
    mesh: MeshAsset
    
    @viewport
    viewport: MeshEditorViewport
    
    @details
    properties: MeshDetails
    
    @toolbar
    toolbar: MeshEditorToolbar
    
    @slate
    asset_browser: SAssetBrowser
    
    fn OnAssetOpened():
        properties.location = mesh.location
        properties.rotation = mesh.rotation
        properties.scale = mesh.scale

# ----------------------------------------------------------------------------
# X. PROPERTY EDITOR - Custom property type editors
# ----------------------------------------------------------------------------

@property_editor(for_type="Vec3")
struct Vec3PropertyEditor:
    fn CreatePropertyWidget(property: Property) -> Widget:
        return HorizontalBox()

@property_editor(for_type="MaterialPreset")
struct MaterialPresetPropertyEditor:
    fn CreatePropertyWidget(property: Property) -> Widget:
        return VerticalBox()

# ----------------------------------------------------------------------------
# XI. EDITOR MODULE - Main editor integration
# ----------------------------------------------------------------------------

@editor_module
struct SlateTest2Module:
    module_name: String
    version: String
    
    @menu_entry("Tools/Material Editor")
    fn OpenMaterialEditor():
        SpawnTab("MaterialEditor")
    
    @menu_entry("Tools/Mesh Editor")
    fn OpenMeshEditor():
        SpawnTab("MeshEditor")
    
    @menu_entry("Tools/Asset Browser")
    fn OpenAssetBrowser():
        SpawnTab("AssetBrowser")
    
    @toolbar_button("Material Editor", icon="Material")
    fn ToolbarMaterialEditor():
        OpenMaterialEditor()

