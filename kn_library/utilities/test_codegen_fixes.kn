// Test file for UE5 codegen fixes

enum TestEnum:
    ValueA
    ValueB
    ValueC

@component
struct TestComponent:
    value: Float
    name: String
    
actor TestActor:
    state test_value: Float = 1.0
    
    on tick(delta_time: Float):
        test_value = test_value + delta_time
        
    @inline
    fn GetEnum() -> TestEnum:
        return TestEnum::ValueA
        
    @inline
    fn GetVector() -> Vec3:
        return Vec3()
        
    @inline
    fn GetNull() -> Int:
        return null
