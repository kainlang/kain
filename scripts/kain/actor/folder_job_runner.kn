fn resolve_root_path() -> String:
    let root = env("KAIN_JOB_ROOT").trim()
    if len(root) == 0:
        return "."
    return root

fn is_text_job(file_name: String) -> Bool:
    let extension = path_extension(file_name).trim().to_ascii_lowercase()

    if extension == "kn":
        return true
    if extension == "md":
        return true
    if extension == "txt":
        return true
    if extension == "toml":
        return true
    if extension == "json":
        return true
    if extension == "rs":
        return true
    if extension == "sh":
        return true
    if extension == "ps1":
        return true
    if extension == "bat":
        return true
    if extension == "py":
        return true
    if extension == "yaml":
        return true
    if extension == "yml":
        return true
    if extension == "lock":
        return true
    return false

fn wait_for_actor_flush() -> Int:
    # Give the spawned actor threads time to flush stdout before main exits.
    var spin = 0
    while spin < 1000000:
        spin = spin + 1
    return 0

actor JobSupervisor:
    state active_jobs: Int = 0
    state completed_jobs: Int = 0
    state failed_jobs: Int = 0
    state retried_jobs: Int = 0
    state total_bytes: Int = 0

    on Begin(root_path: String, retry_token: String):
        println(f"Starting folder job run in {root_path}")
        let entries = read_dir(root_path)

        for entry in entries:
            if path_is_dir(entry):
                continue
            if (!path_is_file(entry)):
                continue

            let file_name = path_file_name(entry)
            if len(file_name) == 0:
                continue
            if (!is_text_job(file_name)):
                println(f"Skipping non-text job {file_name}")
                continue

            let worker = spawn JobWorker()
            self.active_jobs = self.active_jobs + 1
            send worker.Process(path = entry, retry_token = retry_token, attempt = 0, reporter = self)

        if self.active_jobs == 0:
            println("No runnable text jobs found.")
            println("Summary: 0 completed, 0 failed, 0 retried, 0 bytes")
        else:
            println(f"Queued {self.active_jobs} job(s).")

    on JobRetryRequested(path: String, retry_token: String, attempt: Int, reason: String):
        self.retried_jobs = self.retried_jobs + 1
        println(f"[supervisor] retrying {path_file_name(path)} ({reason})")
        let worker = spawn JobWorker()
        send worker.Process(path = path, retry_token = retry_token, attempt = attempt, reporter = self)

    on JobSucceeded(path: String, bytes: Int):
        self.completed_jobs = self.completed_jobs + 1
        self.total_bytes = self.total_bytes + bytes
        self.active_jobs = self.active_jobs - 1
        println(f"[supervisor] completed {path_file_name(path)} ({bytes} bytes)")

        if self.active_jobs == 0:
            println(f"Summary: {self.completed_jobs} completed, {self.failed_jobs} failed, {self.retried_jobs} retried, {self.total_bytes} bytes")

    on JobFailed(path: String, reason: String):
        self.failed_jobs = self.failed_jobs + 1
        self.active_jobs = self.active_jobs - 1
        eprintln(f"[supervisor] failed {path_file_name(path)} ({reason})")

        if self.active_jobs == 0:
            println(f"Summary: {self.completed_jobs} completed, {self.failed_jobs} failed, {self.retried_jobs} retried, {self.total_bytes} bytes")

actor JobWorker:
    on Process(path: String, retry_token: String, attempt: Int, reporter: JobSupervisor):
        let file_name = path_file_name(path)

        if attempt == 0 && len(retry_token) > 0 && file_name == retry_token:
            println(f"[worker] transient retry for {file_name}")
            send reporter.JobRetryRequested(path = path, retry_token = retry_token, attempt = attempt + 1, reason = "retry token matched")
            return

        let contents = read_file(path)
        if len(contents) == 0:
            send reporter.JobFailed(path = path, reason = "empty file")
            return

        println(f"[worker] {file_name}: {len(contents)} bytes")
        send reporter.JobSucceeded(path = path, bytes = len(contents))

fn main() -> Int:
    let root_path = resolve_root_path()
    let retry_token = env("KAIN_JOB_RETRY_TOKEN").trim()
    let supervisor = spawn JobSupervisor()

    send supervisor.Begin(root_path = root_path, retry_token = retry_token)
    wait_for_actor_flush()
    return 0
