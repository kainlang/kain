fn resolve_target_path() -> String:
    let target = env("KAIN_APPEND_TARGET").trim()
    if len(target) == 0:
        return "notes.txt"
    return target

fn ensure_parent_directory(target_path: String):
    let parent_path = path_parent(target_path)
    if len(parent_path) > 0:
        create_dir_all(parent_path)

fn main() -> Int:
    let target_path = resolve_target_path()
    let text = env("KAIN_APPEND_TEXT").trim()

    if len(text) == 0:
        eprintln("Set KAIN_APPEND_TEXT before running this script.")
        eprintln("Example: KAIN_APPEND_TARGET=notes.txt KAIN_APPEND_TEXT='hello' kain run scripts/kain/append_text_to_file.kn")
        return 1

    let target_exists = file_exists(target_path)
    if target_exists && (!path_is_file(target_path)):
        eprintln(f"Target exists but is not a file: {target_path}")
        return 1

    ensure_parent_directory(target_path)

    if target_exists:
        let existing = read_file(target_path)
        let needs_newline = (len(existing) > 0) && (char_at(existing, len(existing) - 1) != "\n")
        if needs_newline:
            write_file(target_path, f"{existing}\n{text}")
        else:
            write_file(target_path, f"{existing}{text}")
    else:
        write_file(target_path, text)

    println(f"Appended text to {target_path}")
    return 0
