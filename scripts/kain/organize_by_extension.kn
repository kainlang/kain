fn resolve_root_path() -> String:
    let root = env("KAIN_ORGANIZE_ROOT").trim()
    if len(root) == 0:
        return "."
    return root

fn parse_truthy_env(name: String) -> Bool:
    let value = env(name).trim().to_ascii_lowercase()
    if value == "1":
        return true
    if value == "true":
        return true
    if value == "yes":
        return true
    if value == "on":
        return true
    return false

fn extension_group(path: String) -> String:
    let extension = path_extension(path).trim()
    if len(extension) == 0:
        return "no_extension"
    return extension.to_ascii_lowercase()

fn main() -> Int:
    let root_path = resolve_root_path()
    let apply = parse_truthy_env("KAIN_ORGANIZE_APPLY")
    if apply:
        println(f"Scanning {root_path} (apply)")
    else:
        println(f"Scanning {root_path} (dry-run)")

    let entries = read_dir(root_path)
    let mut moved_count = 0
    let mut skipped_count = 0

    for entry in entries:
        if path_is_dir(entry):
            continue
        if (!path_is_file(entry)):
            continue

        let file_name = path_file_name(entry)
        if len(file_name) == 0:
            continue

        let group = extension_group(entry)
        let target_dir = path_join(root_path, group)
        let target_path = path_join(target_dir, file_name)

        if file_exists(target_path):
            eprintln(f"Skipping {file_name}; destination already exists in {group}")
            skipped_count = skipped_count + 1
            continue

        if apply:
            create_dir_all(target_dir)
            copy_file(entry, target_path)
            remove_file(entry)
            println(f"Moved {file_name} -> {group}/")
            moved_count = moved_count + 1
        else:
            println(f"Would move {file_name} -> {group}/")

    println(f"Done. Moved {moved_count} file(s); skipped {skipped_count}.")
    return 0
