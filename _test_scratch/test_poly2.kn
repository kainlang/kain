use std::test
use std::runtime
use std::math

fn nearly_eq(a: Float, b: Float, tol: Float) -> Bool:
    var diff: Float = a - b
    if diff < 0.0:
        diff = 0.0 - diff
    return diff < tol

fn test_polynomial_clip(x: Float) -> Float with Pure:
    let x2: Float = x * x
    let x3: Float = x2 * x
    let y: Float = x - (x3 * 0.3333333)
    if y > 1.0:
        return 1.0
    if y < -1.0:
        return -1.0
    return y

fn main() -> Int with Unsafe:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    var failures: Int = 0

    // Just one test
    let r1 = test_bool("poly_clip(0) == 0", nearly_eq(test_polynomial_clip(0.0), 0.0, 0.0001))
    failures = test_count_failure(r1, failures)

    runtime_shutdown()
    return failures
