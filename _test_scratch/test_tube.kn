use std::test
use std::runtime
use std::math

fn nearly_eq(a: Float, b: Float, tol: Float) -> Bool:
    var diff: Float = a - b
    if diff < 0.0:
        diff = 0.0 - diff
    return diff < tol

fn test_polynomial_clip(x: Float) -> Float with Pure:
    let x2: Float = x * x
    let x3: Float = x2 * x
    let y: Float = x - (x3 * 0.3333333)
    if y > 1.0:
        return 1.0
    if y < -1.0:
        return -1.0
    return y

fn test_tube_saturate(x: Float, drive: Float) -> Float with Pure:
    let y: Float = x * drive
    if y > 0.0:
        return tanh_scalar(y) * 0.8 + test_polynomial_clip(y * 0.7) * 0.2
    return tanh_scalar(y) * 0.8 - test_polynomial_clip(-y * 0.7) * 0.2

fn main() -> Int with Unsafe:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    var failures: Int = 0

    // Test tube(0)
    let tube0 = test_tube_saturate(0.0, 1.0)
    let r1 = test_bool("tube(0) == 0", nearly_eq(tube0, 0.0, 0.0001))
    failures = test_count_failure(r1, failures)

    runtime_shutdown()
    return failures
