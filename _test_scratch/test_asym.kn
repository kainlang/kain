use std::test
use std::runtime
use std::math

fn nearly_eq(a: Float, b: Float, tol: Float) -> Bool:
    var diff: Float = a - b
    if diff < 0.0:
        diff = 0.0 - diff
    return diff < tol

fn test_asymmetric_clip(x: Float, drive: Float, bias: Float) -> Float with Pure:
    let y: Float = x * drive + bias
    if y > 1.0:
        return 1.0
    if y < -1.0:
        return -1.0
    if y < 0.0:
        return 0.0 - tanh_scalar(-y * 1.5) * 0.85
    return tanh_scalar(y) * 0.9

fn main() -> Int with Unsafe:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    var failures: Int = 0

    // Test asymmetric(0)
    let a0 = test_asymmetric_clip(0.0, 1.0, 0.0)
    let r1 = test_bool("asymmetric(0,0,0) near 0", nearly_eq(a0, 0.0, 0.01))
    failures = test_count_failure(r1, failures)

    runtime_shutdown()
    return failures
