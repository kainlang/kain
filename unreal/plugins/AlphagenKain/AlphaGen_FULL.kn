# ============================================================================
# FILTER SHADERS (15 total)
# ============================================================================

shader compute FilterCopy(id: Vec3) -> Vec4:
    uniform input_texture: Sampler2D @0
    uniform texture_size: UVec2 @1
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    return sample(input_texture, uv)

shader compute FilterInvert(id: Vec3) -> Vec4:
    uniform input_texture: Sampler2D @0
    uniform texture_size: UVec2 @1
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let color = sample(input_texture, uv)
    return vec4(1.0 - color.r, 1.0 - color.g, 1.0 - color.b, color.a)

shader compute FilterInvert(id: Vec3) -> Vec4:
    uniform input_texture: Sampler2D @0
    uniform texture_size: UVec2 @1
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let color = sample(input_texture, uv)
    return vec4(1.0 - color.r, 1.0 - color.g, 1.0 - color.b, color.a)

