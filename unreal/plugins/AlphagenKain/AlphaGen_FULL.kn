struct AlphaInfo:
    handle: Int64
    name: String
    width: Int
    height: Int
    source: AlphaSource

# Note: Texture pool would be implemented as manual C++ or wait for @subsystem support

# ============================================================================
# PROCEDURAL GENERATOR SHADERS (21 total)
# All shaders include AlphaGenCommon.ush for helper functions
# ============================================================================

shader compute GenerateRadial(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform falloff: Float @1
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let centered = (uv - 0.5) * 2.0
    let dist = length(centered)
    let alpha = pow(1.0 - saturate(dist), falloff)
    return vec4(alpha, alpha, alpha, 1.0)

shader compute GenerateCircle(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform scale: Float @1
    uniform softness: Float @2
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let centered = (uv - 0.5) * 2.0 / scale
    let dist = length(centered)
    let alpha = 1.0 - smoothstep(1.0 - softness, 1.0, dist)
    return vec4(alpha, alpha, alpha, 1.0)

shader compute GenerateSquare(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform scale: Float @1
    uniform softness: Float @2
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let centered = (uv - 0.5) * 2.0 / scale
    let max_dist = max(abs(centered.x), abs(centered.y))
    let alpha = 1.0 - smoothstep(1.0 - softness, 1.0, max_dist)
    return vec4(alpha, alpha, alpha, 1.0)

shader compute GenerateDiamond(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform scale: Float @1
    uniform softness: Float @2
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let centered = (uv - 0.5) * 2.0 / scale
    let dist = abs(centered.x) + abs(centered.y)
    let alpha = 1.0 - smoothstep(1.0 - softness, 1.0, dist)
    return vec4(alpha, alpha, alpha, 1.0)

shader compute GeneratePerlin(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform scale: Float @1
    uniform octaves: Float @2
    uniform seed: Float @3
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let noise_uv = uv * scale + seed
    let value = fract(sin(dot(noise_uv, vec2(12.9898, 78.233))) * 43758.5453)
    return vec4(value, value, value, 1.0)

shader compute GenerateVoronoi(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform scale: Float @1
    uniform edge_width: Float @2
    uniform seed: Float @3
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size) * scale
    let value = fract(sin(dot(uv + seed, vec2(12.9898, 78.233))) * 43758.5453)
    return vec4(value, value, value, 1.0)

shader compute GenerateBricks(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform brick_width: Float @1
    uniform brick_height: Float @2
    uniform mortar: Float @3
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let brick_uv = vec2(uv.x / brick_width, uv.y / brick_height)
    let brick_id = floor(brick_uv)
    let brick_local = fract(brick_uv)
    let is_mortar = step(brick_local.x, mortar) + step(brick_local.y, mortar)
    let value = 1.0 - saturate(is_mortar)
    return vec4(value, value, value, 1.0)

shader compute GenerateDots(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform dot_radius: Float @1
    uniform spacing: Float @2
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let grid_uv = uv / spacing
    let cell = floor(grid_uv)
    let local_uv = fract(grid_uv) - 0.5
    let dist = length(local_uv)
    let value = 1.0 - smoothstep(dot_radius - 0.01, dot_radius, dist)
    return vec4(value, value, value, 1.0)

shader compute GenerateSeamlessNoise(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform scale: Float @1
    uniform octaves: Float @2
    uniform seed: Float @3
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let noise_uv = uv * scale + seed
    let value = fract(sin(dot(noise_uv, vec2(12.9898, 78.233))) * 43758.5453)
    return vec4(value, value, value, 1.0)

shader compute GenerateCrosshatch(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform scale: Float @1
    uniform thickness: Float @2
    uniform angle: Float @3
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let line1 = abs(fract(uv.x * scale) - 0.5)
    let line2 = abs(fract(uv.y * scale) - 0.5)
    let value = 1.0 - saturate(step(line1, thickness) + step(line2, thickness))
    return vec4(value, value, value, 1.0)

shader compute GenerateWaves(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform frequency: Float @1
    uniform amplitude: Float @2
    uniform wave_type: Float @3
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let value = sin(uv.x * frequency) * amplitude * 0.5 + 0.5
    return vec4(value, value, value, 1.0)

shader compute GenerateCheckerboard(id: Vec3) -> Vec4:
    uniform texture_size: UVec2 @0
    uniform scale: Float @1
    let pixel = uint2(id.xy)
    if pixel.x >= texture_size.x || pixel.y >= texture_size.y: return vec4(0.0, 0.0, 0.0, 0.0)
    let uv = (vec2(pixel) + 0.5) / vec2(texture_size)
    let checker = floor(uv.x * scale) + floor(uv.y * scale)
    let value = fract(checker * 0.5) * 2.0
    return vec4(value, value, value, 1.0)

shader compute GenerateHexagon(id: Vec3) -> Vec4:
