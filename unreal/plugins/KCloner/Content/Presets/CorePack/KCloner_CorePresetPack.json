{
    "PackName": "K-Cloner Core Pack",
    "PackVersion": "1.0.0",
    "Author": "K-Studio",
    "Description": "Essential motion presets for K-Cloner. Includes classic effects, sci-fi animations, and organic movements.",
    "Presets": [
        {
            "AssetName": "MP_DNAHelix",
            "DisplayName": "DNA Helix",
            "Category": "Scientific",
            "Description": "Double helix spiral motion - great for DNA visualizations, abstract art, and scientific animations.",
            "PositionExpression": "x := x + sin(t * 2 + i * 0.3) * v0;\nz := z + cos(t * 2 + i * 0.3) * v0;\ny := y + i * v1;",
            "RotationExpression": "ry := t * 45 + i * 15;",
            "ScaleExpression": "",
            "Step": 0.0,
            "SpeedMultiplier": 1.0,
            "Variables": [
                {
                    "Name": "Radius",
                    "DefaultValue": 50.0,
                    "MinValue": 10.0,
                    "MaxValue": 200.0,
                    "Tooltip": "Radius of the helix spiral"
                },
                {
                    "Name": "HeightStep",
                    "DefaultValue": 10.0,
                    "MinValue": 1.0,
                    "MaxValue": 50.0,
                    "Tooltip": "Vertical spacing between instances"
                }
            ]
        },
        {
            "AssetName": "MP_PulseWave",
            "DisplayName": "Pulse Wave",
            "Category": "Motion",
            "Description": "Rippling scale pulse that propagates through instances - perfect for UI elements and attention-grabbing effects.",
            "PositionExpression": "",
            "RotationExpression": "",
            "ScaleExpression": "var pulse := 1 + sin(t * v0 * 6.28 + i * v1) * v2;\nsx := sx * pulse;\nsy := sy * pulse;\nsz := sz * pulse;",
            "Step": 0.1,
            "SpeedMultiplier": 1.0,
            "Variables": [
                {
                    "Name": "Frequency",
                    "DefaultValue": 2.0,
                    "MinValue": 0.1,
                    "MaxValue": 10.0,
                    "Tooltip": "Pulses per second"
                },
                {
                    "Name": "Spread",
                    "DefaultValue": 0.3,
                    "MinValue": 0.0,
                    "MaxValue": 2.0,
                    "Tooltip": "Phase offset between instances"
                },
                {
                    "Name": "Intensity",
                    "DefaultValue": 0.3,
                    "MinValue": 0.0,
                    "MaxValue": 1.0,
                    "Tooltip": "Scale variation amount"
                }
            ]
        },
        {
            "AssetName": "MP_FloatingIslands",
            "DisplayName": "Floating Islands",
            "Category": "Nature",
            "Description": "Gentle floating motion with subtle rotation - perfect for clouds, islands, and dreamy environments.",
            "PositionExpression": "y := y + sin(t * v0 + i * 1.7) * v1 + cos(t * v0 * 0.7 + i * 2.3) * v1 * 0.5;",
            "RotationExpression": "rx := sin(t * 0.3 + i) * v2;\nrz := cos(t * 0.2 + i * 1.5) * v2;",
            "ScaleExpression": "",
            "Step": 0.0,
            "SpeedMultiplier": 1.0,
            "Variables": [
                {
                    "Name": "Speed",
                    "DefaultValue": 0.5,
                    "MinValue": 0.1,
                    "MaxValue": 3.0,
                    "Tooltip": "Overall animation speed"
                },
                {
                    "Name": "Amplitude",
                    "DefaultValue": 15.0,
                    "MinValue": 1.0,
                    "MaxValue": 100.0,
                    "Tooltip": "Vertical movement range"
                },
                {
                    "Name": "Tilt",
                    "DefaultValue": 3.0,
                    "MinValue": 0.0,
                    "MaxValue": 15.0,
                    "Tooltip": "Rotation wobble in degrees"
                }
            ]
        },
        {
            "AssetName": "MP_MatrixFall",
            "DisplayName": "Matrix Fall",
            "Category": "Sci-Fi",
            "Description": "Continuous falling motion that loops - inspired by the famous digital rain effect.",
            "PositionExpression": "y := y - mod(t * v0 + i * v1, v2);",
            "RotationExpression": "",
            "ScaleExpression": "",
            "Step": 0.0,
            "SpeedMultiplier": 1.0,
            "Variables": [
                {
                    "Name": "FallSpeed",
                    "DefaultValue": 100.0,
                    "MinValue": 10.0,
                    "MaxValue": 500.0,
                    "Tooltip": "Speed of the fall"
                },
                {
                    "Name": "Offset",
                    "DefaultValue": 50.0,
                    "MinValue": 0.0,
                    "MaxValue": 200.0,
                    "Tooltip": "Stagger between instances"
                },
                {
                    "Name": "ResetHeight",
                    "DefaultValue": 500.0,
                    "MinValue": 100.0,
                    "MaxValue": 2000.0,
                    "Tooltip": "Distance before looping"
                }
            ]
        },
        {
            "AssetName": "MP_Orbit",
            "DisplayName": "Smooth Orbit",
            "Category": "Motion",
            "Description": "Circular orbital motion with customizable radius and speed.",
            "PositionExpression": "x := x + cos(t * v0 + i * v2) * v1;\nz := z + sin(t * v0 + i * v2) * v1;",
            "RotationExpression": "ry := t * v0 * 57.3 + i * v2 * 57.3;",
            "ScaleExpression": "",
            "Step": 0.0,
            "SpeedMultiplier": 1.0,
            "Variables": [
                {
                    "Name": "Speed",
                    "DefaultValue": 1.0,
                    "MinValue": 0.1,
                    "MaxValue": 5.0,
                    "Tooltip": "Rotation speed (radians/sec)"
                },
                {
                    "Name": "Radius",
                    "DefaultValue": 100.0,
                    "MinValue": 10.0,
                    "MaxValue": 500.0,
                    "Tooltip": "Orbit radius"
                },
                {
                    "Name": "PhaseOffset",
                    "DefaultValue": 0.5,
                    "MinValue": 0.0,
                    "MaxValue": 6.28,
                    "Tooltip": "Angular offset between instances"
                }
            ]
        },
        {
            "AssetName": "MP_Breathe",
            "DisplayName": "Breathe",
            "Category": "Organic",
            "Description": "Slow, organic breathing motion - scale pulsing like a living creature.",
            "PositionExpression": "",
            "RotationExpression": "",
            "ScaleExpression": "var breath := 1 + sin(t * v0 * 3.14159) * v1 * (1 + sin(i * 0.5) * 0.2);\nsx := sx * breath;\nsy := sy * breath;\nsz := sz * breath;",
            "Step": 0.05,
            "SpeedMultiplier": 1.0,
            "Variables": [
                {
                    "Name": "BreathRate",
                    "DefaultValue": 0.5,
                    "MinValue": 0.1,
                    "MaxValue": 2.0,
                    "Tooltip": "Breaths per second"
                },
                {
                    "Name": "Depth",
                    "DefaultValue": 0.15,
                    "MinValue": 0.0,
                    "MaxValue": 0.5,
                    "Tooltip": "How deep each breath is"
                }
            ]
        },
        {
            "AssetName": "MP_Cascade",
            "DisplayName": "Cascade Reveal",
            "Category": "UI",
            "Description": "Staggered appearance animation - instances scale up in sequence like a wave.",
            "PositionExpression": "y := y + max(0, 1 - clamp((t - i * v1) * v0, 0, 1)) * v2;",
            "RotationExpression": "",
            "ScaleExpression": "var appear := clamp((t - i * v1) * v0, 0, 1);\nsx := sx * appear;\nsy := sy * appear;\nsz := sz * appear;",
            "Step": 0.0,
            "SpeedMultiplier": 1.0,
            "Variables": [
                {
                    "Name": "Speed",
                    "DefaultValue": 3.0,
                    "MinValue": 0.5,
                    "MaxValue": 10.0,
                    "Tooltip": "Animation speed"
                },
                {
                    "Name": "Delay",
                    "DefaultValue": 0.1,
                    "MinValue": 0.0,
                    "MaxValue": 1.0,
                    "Tooltip": "Delay between each instance"
                },
                {
                    "Name": "DropHeight",
                    "DefaultValue": 50.0,
                    "MinValue": 0.0,
                    "MaxValue": 200.0,
                    "Tooltip": "Height to drop from"
                }
            ]
        },
        {
            "AssetName": "MP_Jitter",
            "DisplayName": "Jitter",
            "Category": "Motion",
            "Description": "Random high-frequency vibration - great for machine parts, electricity, and nervous energy.",
            "PositionExpression": "x := x + (frac(sin(t * 127.1 + i * 311.7) * 43758.5453) - 0.5) * v0;\ny := y + (frac(sin(t * 269.5 + i * 183.3) * 43758.5453) - 0.5) * v0;\nz := z + (frac(sin(t * 419.2 + i * 577.9) * 43758.5453) - 0.5) * v0;",
            "RotationExpression": "rx := (frac(sin(t * 97.1 + i * 211.7) * 43758.5453) - 0.5) * v1;\nry := (frac(sin(t * 169.5 + i * 83.3) * 43758.5453) - 0.5) * v1;\nrz := (frac(sin(t * 319.2 + i * 477.9) * 43758.5453) - 0.5) * v1;",
            "ScaleExpression": "",
            "Step": 0.0,
            "SpeedMultiplier": 1.0,
            "Variables": [
                {
                    "Name": "PositionJitter",
                    "DefaultValue": 5.0,
                    "MinValue": 0.0,
                    "MaxValue": 50.0,
                    "Tooltip": "Position shake intensity"
                },
                {
                    "Name": "RotationJitter",
                    "DefaultValue": 5.0,
                    "MinValue": 0.0,
                    "MaxValue": 45.0,
                    "Tooltip": "Rotation shake in degrees"
                }
            ]
        }
    ]
}