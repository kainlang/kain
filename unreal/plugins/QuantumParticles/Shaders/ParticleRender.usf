// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
float3 primary_color;
float3 secondary_color;
int color_mode;
float opacity;
float point_size;

// Texture Inputs
Texture2D<float4> position_texture : register(t0);
SamplerState position_textureSampler : register(s0);
Texture2D<float4> velocity_texture : register(t1);
SamplerState velocity_textureSampler : register(s1);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void ParticleRenderCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float2 uv = float2(ThreadId.x, ThreadId.y);
    float4 pos_data = position_texture.Load(TexCoord);
    float3 pos = pos_data.xyz;
    float life = pos_data.w;
    float3 vel = velocity_texture.Load(TexCoord).xyz;
    float speed = length(vel);
    float3 color = primary_color;
    if ((color_mode == 1))
    {
        float t = clamp((speed * 0.050000), 0.000000, 1.000000);
        color = ((primary_color * ((1.000000 - t))) + (secondary_color * t));
    }
    if ((color_mode == 3))
    {
        float t = ((normalize(pos).y * 0.500000) + 0.500000);
        color = ((primary_color * ((1.000000 - t))) + (secondary_color * t));
    }
    float alpha = (life * opacity);
    OutputTexture[ThreadId.xy] = float4(color, alpha);
    return;
}
