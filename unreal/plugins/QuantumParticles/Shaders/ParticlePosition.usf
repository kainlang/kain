// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
float time;
float delta_time;
int mode;
float life_enabled;
float life_decay_rate;
float respawn_bounds;

// Texture Inputs
Texture2D<float4> position_texture : register(t0);
SamplerState position_textureSampler : register(s0);
Texture2D<float4> velocity_texture : register(t1);
SamplerState velocity_textureSampler : register(s1);
Texture2D<float4> origin_texture : register(t2);
SamplerState origin_textureSampler : register(s2);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void ParticlePositionCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float2 uv = float2(ThreadId.x, ThreadId.y);
    float4 pos_data = position_texture.Load(TexCoord);
    float3 pos = pos_data.xyz;
    float life = pos_data.w;
    float3 vel = velocity_texture.Load(TexCoord).xyz;
    float3 origin = origin_texture.Load(TexCoord).xyz;
    pos = (pos + (vel * delta_time));
    bool respawn = false;
    if ((life_enabled > 0.500000))
    {
        life = (life - life_decay_rate);
        if ((life <= 0.000000))
        {
            respawn = true;
        }
    }
    if ((length(pos) > respawn_bounds))
    {
        respawn = true;
    }
    if (respawn)
    {
        life = 1.000000;
        if ((mode == 0))
        {
            pos = origin;
        }
        else
        {
            float4 theta = (time * 0.100000);
            float4 phi = (time * 0.200000);
            float r = 30.000000;
            pos = float3(((r * sin(phi)) * cos(theta)), ((r * sin(phi)) * sin(theta)), (r * cos(phi)));
        }
    }
    OutputTexture[ThreadId.xy] = float4(pos, life);
    return;
}
