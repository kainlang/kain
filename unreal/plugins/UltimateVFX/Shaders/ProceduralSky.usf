// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
float3 sky_color_zenith;
float3 sky_color_horizon;
float3 ground_color;
float sun_disk_size;
float sun_disk_intensity;
float stars_intensity;
float milky_way_intensity;

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
    float4 TexCoord1 : TEXCOORD1;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput ProceduralSkyPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;
    float3 view_dir = Input.TexCoord1.xyz;

    float up_dot = dot(view_dir, float3(0.000000, 1.000000, 0.000000));
    float4 sky_gradient = ((sky_color_zenith * max(0.000000, up_dot)) + (sky_color_horizon * ((1.000000 - max(0.000000, up_dot)))));
    FPSOutput _Result;
    _Result.Color = float4(sky_gradient, 1.000000);
    return _Result;
}
