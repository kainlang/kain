FPSOutput MotionBlurPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;
    float2 velocity = Input.TexCoord0.zw;

    float2 blur_vec = ((velocity * velocity_scale) * blur_intensity);
    float blur_length = min(length(blur_vec), max_blur_radius);
    float2 blur_dir = normalize(blur_vec);
    float3 color_sum = float3(0.000000, 0.000000, 0.000000);
    float i = 0.000000;
    while ((i < blur_samples))
    {
        float2 offset = ((blur_dir * ((i / blur_samples))) * blur_length);
        color_sum = (color_sum + float3(1.000000, 1.000000, 1.000000));
        i = (i + 1.000000);
    }
    float3 final_color = (color_sum / blur_samples);
    FPSOutput _Result;
    _Result.Color = float4(final_color, 1.000000);
    return _Result;
}
