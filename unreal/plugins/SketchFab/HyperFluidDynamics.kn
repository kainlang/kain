    grid_dim: Vec3
    @replicated
    cell_size: Vec3
    @replicated
    adaptive: AdaptiveStrategy
    @replicated
    refine_threshold: Float
    @replicated
    coarsen_threshold: Float
    @replicated
    max_refine_level: Int
    @replicated
    min_cell_size: Float

