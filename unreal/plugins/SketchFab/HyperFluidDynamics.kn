    @replicated
    coupling_fields: Array<CouplingField>
    @replicated
    quality: QualityTier
    @replicated
    backend: GPUBackend
    @replicated
    viscosity: Float
    @replicated
    density: Float
    @replicated
    surface_tension: Float
    @replicated
    compressibility: Float
    @replicated
    conductivity: Float
    @replicated
    permittivity: Float
    @replicated
    permeability: Float
    @replicated
    reactivity: Float
    @replicated
    radiation_absorption: Float
    @replicated
    gravity_scale: Float
    @replicated
    anisotropy: Float
    @replicated
    cavitation_threshold: Float
    @replicated
    yield_stress: Float
    @replicated
    foam_threshold: Float
    @replicated
    spray_threshold: Float
    @replicated
