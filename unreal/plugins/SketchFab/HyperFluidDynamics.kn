############################################################
# DATATABLES - Presets, materials, coupling coefficients
############################################################

@datatable
struct FluidPreset:
    id: Int
    name: String
    class: FluidClass
    solver: SolverFamily
    turbulence: TurbulenceModel
    boundary: BoundaryType
    coupling: Array<CouplingField>
    quality: QualityTier
    backend: GPUBackend
    adaptive: AdaptiveStrategy
    time_integrator: TimeIntegrator
    viscosity: Float
    density: Float
    surface_tension: Float
    compressibility: Float
    conductivity: Float
    permittivity: Float
    permeability: Float
    chemical_reactivity: Float
    radiation_absorption: Float
    gravity_scale: Float
    anisotropy: Float
    cavitation_threshold: Float
    yield_stress: Float
    foam_threshold: Float
    spray_threshold: Float
    bubble_coalescence: Float
    turbulence_intensity: Float
    vorticity_confinement: Float
    adaptive_refine_threshold: Float
    adaptive_coarsen_threshold: Float

@datatable
struct MaterialLookup:
    id: Int
    name: String
    absorption: Vec3
    scattering: Vec3
    emission: Vec3
    ior: Float
    roughness: Float
    metallic: Float
    subsurface: Float
    foam_color: Vec3
    bubble_color: Vec3
    dispersion: Float

@datatable
struct BoundaryProfile:
    id: Int
    name: String
    boundary_type: BoundaryType
    friction: Float
    slip_factor: Float
    inflow_velocity: Vec3
    inflow_temperature: Float
    inflow_density: Float
    sponge_strength: Float
    moving_velocity: Vec3

@datatable
struct TurbulenceProfile:
    id: Int
    name: String
    model: TurbulenceModel
    c_mu: Float
    c1: Float
    c2: Float
    k_min: Float
    omega_min: Float
    length_scale: Float
    filter_width: Float
    wall_damping: Float

@datatable
struct CouplingProfile:
    id: Int
    name: String
    field: CouplingField
    strength: Float
    diffusion: Float
    reaction_rate: Float
    source_term: Float
    sink_term: Float
    boundary_exchange: Float
    cross_field_coeff: Float

@datatable
struct VisualizationPreset:
    id: Int
    name: String
    mode: VisualizationMode
    exposure: Float
    contrast: Float
    saturation: Float
    line_thickness: Float
    sample_count: Int
    step_size: Float
    color_a: Vec3
    color_b: Vec3
    color_c: Vec3
    foam_emissive: Float
    bubble_emissive: Float
    shock_gain: Float
    holography_phase_gain: Float

