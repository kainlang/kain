// SketchFab Importer Plugin for UE5
// Provides Blueprint-callable functions to search and download models from SketchFab

// Search result data structure
@datatable
struct SketchfabModel:
    uid: String
    name: String
    description: String
    thumbnail_url: String
    author_name: String
    author_username: String
    viewer_url: String
    like_count: Int
    view_count: Int

// Search options
struct SketchfabSearchOptions:
    query: String
    count: Int
    downloadable_only: Bool
    sort_by: SketchfabSortMode
    api_token: String

// Sort modes
enum SketchfabSortMode:
    Relevance
    LikeCount
    ViewCount
    PublishedDate
    CreatedDate

// Download result
struct SketchfabDownloadResult:
    success: Bool
    download_url: String
    format: String
    error_message: String

// Main importer component
@component
struct SketchfabImporterComponent:
    api_token: String
    last_search_query: String
    @transient
    search_results: Array<SketchfabModel>
    @transient
    is_searching: Bool

// Blueprint utility functions
@blueprint
fn search_sketchfab(query: String, count: Int, api_token: String) -> Array<SketchfabModel>:
    // This will be implemented in C++ to call HTTP API
    // For now, return empty array
    let results: Array<SketchfabModel> = []
    return results

@blueprint
fn get_download_url(model_uid: String, api_token: String) -> SketchfabDownloadResult:
    let result = SketchfabDownloadResult {
        success: false,
        download_url: "",
        format: "glb",
        error_message: ""
    }
    return result

@blueprint
fn download_and_import_model(model_uid: String, api_token: String, import_path: String) -> Bool:
    // Download model and import into UE5
    return false

@blueprint
fn get_sort_mode_string(mode: SketchfabSortMode) -> String:
    match mode:
        SketchfabSortMode::Relevance => "-relevance"
        SketchfabSortMode::LikeCount => "-likeCount"
        SketchfabSortMode::ViewCount => "-viewCount"
        SketchfabSortMode::PublishedDate => "-publishedAt"
        SketchfabSortMode::CreatedDate => "-createdAt"
        _ => "-relevance"

@blueprint
fn validate_api_token(token: String) -> Bool:
    // Validate token format
    return token.length > 0

@blueprint
fn build_search_url(query: String, count: Int, sort_mode: String) -> String:
    let base_url = "https://api.sketchfab.com/v3/search"
    let encoded_query = query  // URL encoding will be done in C++
    let url = "{base_url}?type=models&q={encoded_query}&downloadable=true&sort_by={sort_mode}&count={count}"
    return url

@blueprint
fn parse_thumbnail_url(model: SketchfabModel) -> String:
    // Extract best quality thumbnail
    return model.thumbnail_url

@blueprint
fn format_model_info(model: SketchfabModel) -> String:
    return "{model.name} by {model.author_name} ({model.like_count} likes, {model.view_count} views)"

// Actor for managing import operations
actor SketchfabImportManager:
    state current_downloads: Array<String> = []
    state import_queue: Array<String> = []
    state max_concurrent_downloads: Int = 3
    
    on Server_StartDownload(model_uid: String, api_token: String):
        // Add to download queue
        println("Starting download: {model_uid}")
        Multicast_NotifyDownloadStarted(model_uid)
    
    on Server_CancelDownload(model_uid: String):
        println("Cancelling download: {model_uid}")
        Multicast_NotifyDownloadCancelled(model_uid)
    
    on Client_UpdateProgress(model_uid: String, progress: Float):
        println("Download progress: {model_uid} - {progress}%")
    
    on Multicast_NotifyDownloadStarted(model_uid: String):
        println("Download started: {model_uid}")
    
    on Multicast_NotifyDownloadComplete(model_uid: String, success: Bool):
        println("Download complete: {model_uid} - Success: {success}")
    
    on Multicast_NotifyDownloadCancelled(model_uid: String):
        println("Download cancelled: {model_uid}")

// Helper functions for HTTP requests
@blueprint
fn create_auth_header(api_token: String) -> String:
    return "Token {api_token}"

@blueprint
fn is_valid_model_uid(uid: String) -> Bool:
    // SketchFab UIDs are 32 character hex strings
    return uid.length == 32

@blueprint
fn get_model_viewer_url(model_uid: String) -> String:
    return "https://sketchfab.com/3d-models/{model_uid}"

@blueprint
fn get_api_base_url() -> String:
    return "https://api.sketchfab.com/v3"

// Cache management
struct SketchfabCache:
    cached_searches: Array<String>
    cached_models: Array<SketchfabModel>
    cache_timestamp: Float
    max_cache_age: Float

@blueprint
fn is_cache_valid(cache: SketchfabCache, current_time: Float) -> Bool:
    let age = current_time - cache.cache_timestamp
    return age < cache.max_cache_age

@blueprint
fn clear_cache(cache: SketchfabCache) -> SketchfabCache:
    let new_cache = SketchfabCache {
        cached_searches: [],
        cached_models: [],
        cache_timestamp: 0.0,
        max_cache_age: 300.0
    }
    return new_cache
