// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Texture Inputs
Texture2D h_map : register(t0);  // @0 -> t0 register
SamplerState h_mapSampler : register(s0);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);  // @0 -> u0 register

[numthreads(8, 8, 1)]
void K6_NormalsCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float2 uv = float2(ThreadId.x, ThreadId.y);
    float hL = h_map.Sample(h_mapSampler, float2((uv.x - 0.010000), uv.y)).x;
    float hR = h_map.Sample(h_mapSampler, float2((uv.x + 0.010000), uv.y)).x;
    OutputTexture[ThreadId.xy] = float4(normalize(float3((hL - hR), 1.000000, 0.000000)), 1.000000);
    return;
}
