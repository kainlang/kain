#include "/Engine/Public/Platform.ush"

// Texture Inputs
Texture2D height_map : register(t0);  // @0 -> t0 register
SamplerState height_mapSampler : register(s0);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);  // @0 -> u0 register

[numthreads(8, 8, 1)]
void K3_ThermalCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float h = height_map.Sample(height_mapSampler, float2(ThreadId.x, ThreadId.y)).x;
    float temp = (1.000000 - h);
    OutputTexture[ThreadId.xy] = float4(temp, 0.000000, 0.000000, 1.000000);
    return;
}
