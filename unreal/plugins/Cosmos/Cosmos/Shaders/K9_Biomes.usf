// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Texture Inputs
Texture2D thermal : register(t0);  // @0 -> t0 register
SamplerState thermalSampler : register(s0);
Texture2D moisture : register(t1);  // @1 -> t1 register
SamplerState moistureSampler : register(s1);

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput K9_BiomesPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float t = thermal.Sample(thermalSampler, uv).x;
    float m = moisture.Sample(moistureSampler, uv).x;
    FPSOutput _Result;
    _Result.Color = float4(t, m, 0.000000, 1.000000);
    return _Result;
}
