#include "/Engine/Public/Platform.ush"

// Texture Inputs
Texture2D thermal : register(t0);  // @0 -> t0 register
SamplerState thermalSampler : register(s0);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);  // @0 -> u0 register

[numthreads(8, 8, 1)]
void K4_MoistureCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float m = (thermal.Sample(thermalSampler, float2(ThreadId.x, ThreadId.y)).x * 0.800000);
    OutputTexture[ThreadId.xy] = float4(0.000000, 0.000000, m, 1.000000);
    return;
}
