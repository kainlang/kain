// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
int quest_count;  // @1
float delta_time;  // @2

// UAV Outputs
RWBuffer quest_data : register(u0);  // @0 -> u0 register

[numthreads(8, 8, 1)]
void QuestDataProcessorCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= quest_count))
    {
        return;
    }
    RWBuffer current_time = quest_data[((idx * 4) + 0)];
    RWBuffer time_limit = quest_data[((idx * 4) + 1)];
    RWBuffer new_time = (current_time + delta_time);
    quest_data[((idx * 4) + 0)] = new_time;
    if (((new_time >= time_limit) && (time_limit > 0.000000)))
    {
        quest_data[((idx * 4) + 2)] = 1.000000;
    }
}
