@viewport
struct QuestGraphPreviewViewport:
    @scene_actor
    preview_actor: StaticMeshComponent
    
    @scene_actor
    quest_giver_preview: StaticMeshComponent
    
    @camera
    preview_camera: CameraComponent
    
    current_quest_id: Int
    
    camera_distance: Float
    
    fn on_viewport_tick(delta: Float):
        # Update preview visualization
        preview_camera.SetRelativeLocation(vec3(0, -camera_distance, camera_distance * 0.5))
        
        # Rotate quest giver for preview
        quest_giver_preview.AddLocalRotation(vec3(0, delta * 20.0, 0))
    
    fn on_quest_selected(quest_id: Int):
        current_quest_id = quest_id
        println("Previewing quest {quest_id}")

