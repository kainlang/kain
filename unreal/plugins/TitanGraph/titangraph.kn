# ============================================================================
# TITANGRAPH - Procedural Quest & Narrative Node Editor
# ============================================================================
# A production-ready UE5 plugin for visual quest and dialogue design:
# - Custom node-graph editor with UEdGraph integration
# - 8+ node types (Quest Start, Objective, Dialogue, Condition, etc.)
# - Visual dialogue tree editor with branching
# - Compiles to optimized C++ state machine (not Blueprint)
# - Quest objective tracking with replication
# - Condition evaluation (inventory, stats, flags)
# - Data-driven runtime (zero Blueprint overhead)
# - Export to JSON for localization
# - Save/load system with replication
# - NPC quest giver integration
# - Comprehensive editor UI with graph canvas, inspector, and toolbar
#
# Price Point: $399-599 (Professional Quality)
# Target: RPG developers, narrative designers, quest designers
# Build: kain build --ue5
# ============================================================================

# ============================================================================
# ENUMS - Quest states, node types, and dialogue options
# ============================================================================

enum QuestState:
    NotStarted      # Quest hasn't been given to player
    Active          # Quest is in progress
    Completed       # Quest objectives complete, awaiting turn-in
    TurnedIn        # Quest rewards claimed
    Failed          # Quest failed (optional objectives or time limit)
    Abandoned       # Player abandoned quest
    _MAX

enum ObjectiveType:
    KillTarget      # Kill X enemies of type Y
    CollectItem     # Collect X items
    TalkToNPC       # Talk to specific NPC
    ReachLocation   # Reach waypoint
    UseItem         # Use item at location
    Escort          # Escort NPC to location
    Defend          # Defend location for X seconds
    Custom          # Custom objective with Blueprint validation
    _MAX

enum QuestNodeType:
    QuestStart      # Entry point for quest graph
    QuestComplete   # Quest completion node
    Objective       # Single objective with progress tracking
    Dialogue        # Dialogue with NPC (speaker, text, choices)
    Condition       # Branching logic (inventory, stats, flags)
    Action          # Execute action (give item, set flag, spawn actor)
    Branch          # If/else branching
    Delay           # Time-based delay before next node
    Parallel        # Execute multiple branches simultaneously
    Sequence        # Execute nodes in sequence
    Random          # Random branch selection
    SubQuest        # Nested sub-quest
    _MAX

enum DialogueChoiceType:
    Continue        # Simple continue button
    Branch          # Branch to different dialogue node
    AcceptQuest     # Accept quest and start objectives
    DeclineQuest    # Decline quest
    CompleteQuest   # Turn in quest for rewards
    Custom          # Custom choice with Blueprint logic
    _MAX

enum ConditionOperator:
    Equal           # ==
    NotEqual        # !=
    GreaterThan     # >
    LessThan        # <
    GreaterOrEqual  # >=
    LessOrEqual     # <=
    HasItem         # Player has item in inventory
    HasFlag         # Player has flag set
    LevelGreaterThan # Player level > X
    _MAX

enum RewardType:
    Experience      # XP reward
    Gold            # Currency reward
    Item            # Item reward
    Reputation      # Faction reputation
    Unlock          # Unlock feature/area
    Custom          # Custom reward with Blueprint logic
    _MAX

enum QuestPriority:
    Low             # Side quest
    Normal          # Standard quest
    High            # Main story quest
    Critical        # Urgent quest
    _MAX

# ============================================================================
# DATATABLES - Quest definitions and dialogue data
# ============================================================================

@datatable
struct QuestDefinition:
    id: Int
    quest_name: String
    quest_description: String
    quest_giver_id: Int
    quest_priority: QuestPriority
    required_level: Int
    time_limit_seconds: Float
    is_repeatable: Bool
    cooldown_hours: Float
    graph_asset_path: String

@datatable
struct ObjectiveDefinition:
    id: Int
    objective_text: String
    objective_type: ObjectiveType
    target_count: Int
    target_id: Int
    is_optional: Bool
    hidden_until_active: Bool

@datatable
struct DialogueLineData:
    id: Int
    speaker_name: String
    dialogue_text: String
    audio_path: String
    animation_id: Int
    camera_angle: Int

@datatable
struct QuestRewardData:
    id: Int
    reward_type: RewardType
    reward_value: Int
    item_id: Int
    item_quantity: Int

@datatable
struct ConditionData:
    id: Int
    condition_type: ConditionOperator
    target_value: Int
    item_id: Int
    flag_name: String
    stat_name: String

# ============================================================================
# STRUCTS - Runtime quest data structures
# ============================================================================

struct ActiveQuest:
    quest_id: Int
    quest_state: QuestState
    start_time: Float
    objectives: Array<ObjectiveProgress>
    current_node_id: Int
    visited_nodes: Array<Int>

struct ObjectiveProgress:
    objective_id: Int
    current_count: Int
    target_count: Int
    is_complete: Bool
    is_optional: Bool

struct DialogueChoice:
    choice_id: Int
    choice_text: String
    choice_type: DialogueChoiceType
    next_node_id: Int
    required_item_id: Int
    required_flag: String

struct QuestReward:
    reward_type: RewardType
    reward_value: Int
    item_id: Int
    item_quantity: Int

struct QuestGraphNode:
    node_id: Int
    node_type: QuestNodeType
    node_data: String
    output_pins: Array<Int>
    input_pins: Array<Int>

# ============================================================================
# COMPONENTS - Quest tracking and dialogue system
# ============================================================================

@component
struct QuestTrackerComponent:
    # Component structs can't replicate - use actor state instead
    active_quests: Array<ActiveQuest>
    
    @savegame
    completed_quest_ids: Array<Int>
    
    @savegame
    failed_quest_ids: Array<Int>
    
    @savegame
    quest_flags: Array<String>
    
    @transient
    current_dialogue_node: Int
    
    @transient
    is_in_dialogue: Bool

@component
struct QuestGiverComponent:
    available_quest_ids: Array<Int>
    
    # Component structs can't replicate - use actor state instead
    active_quest_id: Int
    
    @transient
    is_quest_available: Bool
    
    greeting_dialogue_id: Int
    
    quest_complete_dialogue_id: Int

@component
struct ObjectiveTrackerComponent:
    # Component structs can't replicate - use actor state instead
    tracked_objectives: Array<ObjectiveProgress>
    
    @transient
    objective_update_pending: Bool

# ============================================================================
# ACTORS - Quest system actors
# ============================================================================

actor QuestManager:
    # Quest state
    @replicated
    state total_quests_completed: Int = 0
    
    @replicated
    state total_experience_earned: Int = 0
    
    # Components
    @component
    state quest_tracker: QuestTrackerComponent = QuestTrackerComponent{}
    
    @component
    state objective_tracker: ObjectiveTrackerComponent = ObjectiveTrackerComponent{}
    
    # Runtime state
    @transient
    state loaded_quest_graphs: Array<String> = []
    
    @transient
    state active_dialogue_id: Int = 0
    
    on BeginPlay():
        println("QuestManager initialized")
        quest_tracker.is_in_dialogue = false
        quest_tracker.current_dialogue_node = 0
        total_quests_completed = 0
        total_experience_earned = 0
    
    on Tick(delta_time: Float):
        # Update quest timers
        UpdateQuestTimers(delta_time)
        
        # Check objective completion
        CheckObjectiveCompletion()
    
    # Quest lifecycle RPCs
    on Server_StartQuest(quest_id: Int):
        # Validate quest can be started
        if CanStartQuest(quest_id):
            let new_quest = ActiveQuest{
                quest_id: quest_id,
                quest_state: QuestState::Active,
                start_time: 0.0,
                objectives: [],
                current_node_id: 0,
                visited_nodes: []
            }
            
            quest_tracker.active_quests.push(new_quest)
            
            # Load quest graph and initialize objectives
            LoadQuestGraph(quest_id)
            
            Multicast_AnnounceQuestStart(quest_id)
            Client_ShowQuestNotification(quest_id, "Quest Started")
    
    on Server_CompleteQuest(quest_id: Int):
        # Find quest in active quests
        let quest_index = FindActiveQuestIndex(quest_id)
        
        if quest_index >= 0:
            # Mark quest as completed
            quest_tracker.active_quests[quest_index].quest_state = QuestState::Completed
            
            Multicast_AnnounceQuestComplete(quest_id)
            Client_ShowQuestNotification(quest_id, "Quest Complete! Return to quest giver.")
    
    on Server_TurnInQuest(quest_id: Int):
        let quest_index = FindActiveQuestIndex(quest_id)
        
        if quest_index >= 0:
            # Grant rewards
            GrantQuestRewards(quest_id)
            
            # Move to completed list
            quest_tracker.completed_quest_ids.push(quest_id)
            quest_tracker.active_quests.remove(quest_index)
            
            total_quests_completed = total_quests_completed + 1
            
            Multicast_AnnounceQuestTurnedIn(quest_id)
            Client_ShowQuestNotification(quest_id, "Quest Turned In! Rewards Claimed.")
    
    on Server_AbandonQuest(quest_id: Int):
        let quest_index = FindActiveQuestIndex(quest_id)
        
        if quest_index >= 0:
            quest_tracker.active_quests[quest_index].quest_state = QuestState::Abandoned
            quest_tracker.active_quests.remove(quest_index)
            
            Multicast_AnnounceQuestAbandoned(quest_id)
    
    on Server_FailQuest(quest_id: Int):
        let quest_index = FindActiveQuestIndex(quest_id)
        
        if quest_index >= 0:
            quest_tracker.active_quests[quest_index].quest_state = QuestState::Failed
            quest_tracker.failed_quest_ids.push(quest_id)
            quest_tracker.active_quests.remove(quest_index)
            
            Multicast_AnnounceQuestFailed(quest_id)
    
    # Objective tracking RPCs
    on Server_UpdateObjectiveProgress(quest_id: Int, objective_id: Int, progress: Int):
        let quest_index = FindActiveQuestIndex(quest_id)
        
        if quest_index >= 0:
            let objective_index = FindObjectiveIndex(quest_index, objective_id)
            
            if objective_index >= 0:
                quest_tracker.active_quests[quest_index].objectives[objective_index].current_count = progress
                
                # Check if objective is complete
                let target = quest_tracker.active_quests[quest_index].objectives[objective_index].target_count
                if progress >= target:
                    quest_tracker.active_quests[quest_index].objectives[objective_index].is_complete = true
                    Multicast_AnnounceObjectiveComplete(quest_id, objective_id)
                
                Client_UpdateObjectiveUI(quest_id, objective_id, progress)
    
    on Server_CompleteObjective(quest_id: Int, objective_id: Int):
        let quest_index = FindActiveQuestIndex(quest_id)
        
        if quest_index >= 0:
            let objective_index = FindObjectiveIndex(quest_index, objective_id)
            
            if objective_index >= 0:
                quest_tracker.active_quests[quest_index].objectives[objective_index].is_complete = true
                
                # Check if all objectives complete
                if AreAllObjectivesComplete(quest_index):
                    Server_CompleteQuest(quest_id)
                
                Multicast_AnnounceObjectiveComplete(quest_id, objective_id)
    
    # Dialogue system RPCs
    on Server_StartDialogue(npc_id: Int, dialogue_id: Int):
        quest_tracker.is_in_dialogue = true
        quest_tracker.current_dialogue_node = dialogue_id
        active_dialogue_id = dialogue_id
        
        Client_ShowDialogueUI(npc_id, dialogue_id)
    
    on Server_SelectDialogueChoice(choice_id: Int, next_node_id: Int):
        quest_tracker.current_dialogue_node = next_node_id
        
        # Process choice (might start quest, complete quest, etc.)
        ProcessDialogueChoice(choice_id)
        
        if next_node_id > 0:
            Client_ShowDialogueUI(0, next_node_id)
        else:
            Server_EndDialogue()
    
    on Server_EndDialogue():
        quest_tracker.is_in_dialogue = false
        quest_tracker.current_dialogue_node = 0
        active_dialogue_id = 0
        
        Client_HideDialogueUI()
    
    # Condition evaluation RPCs (RPCs can't return values - use Client RPC callback instead)
    on Server_EvaluateCondition(condition_id: Int):
        # This would evaluate condition from ConditionData table
        # Send result back via Client RPC
        let result = true  # Placeholder logic
        Client_ConditionResult(condition_id, result)
    
    on Server_SetQuestFlag(flag_name: String):
        quest_tracker.quest_flags.push(flag_name)
        Multicast_AnnounceFlagSet(flag_name)
    
    # Client RPCs
    on Client_ShowQuestNotification(quest_id: Int, message: String):
        println("Quest {quest_id}: {message}")
    
    on Client_UpdateObjectiveUI(quest_id: Int, objective_id: Int, progress: Int):
        println("Objective {objective_id} progress: {progress}")
    
    on Client_ShowDialogueUI(npc_id: Int, dialogue_id: Int):
        println("Showing dialogue {dialogue_id} from NPC {npc_id}")
    
    on Client_HideDialogueUI():
        println("Hiding dialogue UI")
    
    on Client_ConditionResult(condition_id: Int, result: Bool):
        println("Condition {condition_id} evaluated to: {result}")
    
    # Multicast RPCs
    on Multicast_AnnounceQuestStart(quest_id: Int):
        println("Quest {quest_id} started!")
    
    on Multicast_AnnounceQuestComplete(quest_id: Int):
        println("Quest {quest_id} completed!")
    
    on Multicast_AnnounceQuestTurnedIn(quest_id: Int):
        println("Quest {quest_id} turned in!")
    
    on Multicast_AnnounceQuestAbandoned(quest_id: Int):
        println("Quest {quest_id} abandoned")
    
    on Multicast_AnnounceQuestFailed(quest_id: Int):
        println("Quest {quest_id} failed!")
    
    on Multicast_AnnounceObjectiveComplete(quest_id: Int, objective_id: Int):
        println("Objective {objective_id} complete in quest {quest_id}")
    
    on Multicast_AnnounceFlagSet(flag_name: String):
        println("Quest flag set: {flag_name}")
    
    # Blueprint-callable methods
    @blueprint_callable
    fn IsQuestActive(quest_id: Int) -> Bool:
        return FindActiveQuestIndex(quest_id) >= 0
    
    @blueprint_callable
    fn IsQuestCompleted(quest_id: Int) -> Bool:
        return quest_tracker.completed_quest_ids.contains(quest_id)
    
    @blueprint_callable
    fn GetObjectiveProgress(quest_id: Int, objective_id: Int) -> Int:
        let quest_index = FindActiveQuestIndex(quest_id)
        if quest_index >= 0:
            let objective_index = FindObjectiveIndex(quest_index, objective_id)
            if objective_index >= 0:
                return quest_tracker.active_quests[quest_index].objectives[objective_index].current_count
        return 0

    
    @blueprint_callable
    fn GetActiveQuestCount() -> Int:
        return quest_tracker.active_quests.length()
    
    @blueprint_callable
    fn GetCompletedQuestCount() -> Int:
        return quest_tracker.completed_quest_ids.length()
    
    @blueprint_pure
    fn IsInDialogue() -> Bool:
        return quest_tracker.is_in_dialogue
    
    @blueprint_callable
    fn HasQuestFlag(flag_name: String) -> Bool:
        return quest_tracker.quest_flags.contains(flag_name)
    
    # Helper methods (internal)
    fn CanStartQuest(quest_id: Int) -> Bool:
        # Check if already active
        if FindActiveQuestIndex(quest_id) >= 0:
            return false
        
        # Check if already completed (and == false repeatable)
        if quest_tracker.completed_quest_ids.contains(quest_id):
            return false
        
        return true
    
    fn FindActiveQuestIndex(quest_id: Int) -> Int:
        let i = 0
        while i < quest_tracker.active_quests.length():
            if quest_tracker.active_quests[i].quest_id == quest_id:
                return i
            i = i + 1
        return -1
    
    fn FindObjectiveIndex(quest_index: Int, objective_id: Int) -> Int:
        let i = 0
        while i < quest_tracker.active_quests[quest_index].objectives.length():
            if quest_tracker.active_quests[quest_index].objectives[i].objective_id == objective_id:
                return i
            i = i + 1
        return -1
    
    fn AreAllObjectivesComplete(quest_index: Int) -> Bool:
        let i = 0
        while i < quest_tracker.active_quests[quest_index].objectives.length():
            let obj = quest_tracker.active_quests[quest_index].objectives[i]
            if !obj.is_complete and !obj.is_optional:
                return false
            i = i + 1
        return true

    
    fn LoadQuestGraph(quest_id: Int):
        # This would load the quest graph asset and parse nodes
        println("Loading quest graph for quest {quest_id}")
    
    fn GrantQuestRewards(quest_id: Int):
        # This would grant rewards from QuestRewardData table
        println("Granting rewards for quest {quest_id}")
        total_experience_earned = total_experience_earned + 100
    
    fn UpdateQuestTimers(delta_time: Float):
        # Update time-based quests
        let i = 0
        while i < quest_tracker.active_quests.length():
            quest_tracker.active_quests[i].start_time = quest_tracker.active_quests[i].start_time + delta_time
            i = i + 1
    
    fn CheckObjectiveCompletion():
        # Check for auto-completing objectives
        objective_tracker.objective_update_pending = false
    
    fn ProcessDialogueChoice(choice_id: Int):
        # Process dialogue choice logic
        println("Processing dialogue choice {choice_id}")

actor QuestGiver:
    # Quest giver state
    @replicated
    state npc_name: String = "Quest Giver"
    
    @replicated
    state available_quests: Array<Int> = []
    
    @replicated
    state is_interactable: Bool = true
    
    # Components
    @component
    state quest_giver: QuestGiverComponent = QuestGiverComponent{}
    
    # Dialogue state
    @transient
    state current_player: Actor = null
    
    @transient
    state is_in_conversation: Bool = false
    
    on BeginPlay():
        println("QuestGiver '{npc_name}' initialized")
        quest_giver.is_quest_available = true
        quest_giver.greeting_dialogue_id = 1
        quest_giver.quest_complete_dialogue_id = 2
    
    on Server_Interact(player: Actor):
        if is_interactable and !is_in_conversation:
            current_player = player
            is_in_conversation = true
            
            # Check if player has active quest from this NPC
            if HasActiveQuestForPlayer(player):
                Server_ShowQuestCompleteDialogue(player)
            else:
                Server_ShowGreetingDialogue(player)
    
    on Server_ShowGreetingDialogue(player: Actor):
        # Show greeting and available quests
        Client_ShowQuestList(player, available_quests)
    
    on Server_ShowQuestCompleteDialogue(player: Actor):
        # Show quest turn-in dialogue
        Client_ShowQuestTurnIn(player)

    
    on Server_GiveQuest(player: Actor, quest_id: Int):
        # Delegate to QuestManager
        println("Giving quest {quest_id} to player")
        is_in_conversation = false
        current_player = null
    
    on Server_EndConversation():
        is_in_conversation = false
        current_player = null
    
    on Client_ShowQuestList(player: Actor, quests: Array<Int>):
        println("Showing {quests.length()} available quests")
    
    on Client_ShowQuestTurnIn(player: Actor):
        println("Showing quest turn-in UI")
    
    @blueprint_callable
    fn AddAvailableQuest(quest_id: Int):
        available_quests.push(quest_id)
        quest_giver.available_quest_ids.push(quest_id)
    
    @blueprint_callable
    fn RemoveAvailableQuest(quest_id: Int):
        available_quests.remove_value(quest_id)
    
    @blueprint_pure
    fn HasAvailableQuests() -> Bool:
        return available_quests.length() > 0
    
    fn HasActiveQuestForPlayer(player: Actor) -> Bool:
        # This would check QuestManager for active quests from this NPC
        return false

# ============================================================================
# BLUEPRINT FUNCTIONS - Quest utility functions
# ============================================================================

@blueprint
fn CalculateQuestRewardXP(base_xp: Int, player_level: Int, quest_level: Int) -> Int:
    # Scale XP based on level difference
    let level_diff = quest_level - player_level
    let multiplier = 1.0
    
    if level_diff > 5:
        multiplier = 1.5
    else:
        if level_diff < -5:
            multiplier = 0.5
    
    return int(float(base_xp) * multiplier)

@blueprint
fn GetQuestDifficultyColor(quest_level: Int, player_level: Int) -> Vec3:
    let level_diff = quest_level - player_level
    
    if level_diff >= 5:
        return vec3(1.0, 0.0, 0.0)  # Red - too hard
    else:
        if level_diff >= 3:
            return vec3(1.0, 0.5, 0.0)  # Orange - hard
        else:
            if level_diff >= -2:
                return vec3(1.0, 1.0, 0.0)  # Yellow - appropriate
            else:
                if level_diff >= -5:
                    return vec3(0.5, 1.0, 0.5)  # Green - easy
                else:
                    return vec3(0.5, 0.5, 0.5)  # Gray - trivial

@blueprint
fn FormatObjectiveText(objective_type: ObjectiveType, target_name: String, current: Int, target: Int) -> String:
    match objective_type:
        ObjectiveType::KillTarget => "Kill {target_name}: {current}/{target}"
        ObjectiveType::CollectItem => "Collect {target_name}: {current}/{target}"
        ObjectiveType::TalkToNPC => "Talk to {target_name}"
        ObjectiveType::ReachLocation => "Reach {target_name}"
        ObjectiveType::UseItem => "Use {target_name} at location"
        ObjectiveType::Escort => "Escort {target_name} to destination"
        ObjectiveType::Defend => "Defend {target_name}: {current}/{target} seconds"
        _ => "{target_name}: {current}/{target}"


@blueprint
fn GetQuestStateDisplayName(quest_state: QuestState) -> String:
    match quest_state:
        QuestState::NotStarted => "Not Started"
        QuestState::Active => "In Progress"
        QuestState::Completed => "Complete - Turn In"
        QuestState::TurnedIn => "Turned In"
        QuestState::Failed => "Failed"
        QuestState::Abandoned => "Abandoned"
        _ => "Unknown"

@blueprint
fn GetRewardTypeIcon(reward_type: RewardType) -> String:
    match reward_type:
        RewardType::Experience => "Icons.XP"
        RewardType::Gold => "Icons.Gold"
        RewardType::Item => "Icons.Item"
        RewardType::Reputation => "Icons.Reputation"
        RewardType::Unlock => "Icons.Unlock"
        _ => "Icons.Custom"

@blueprint_pure
fn IsObjectiveComplete(current: Int, target: Int) -> Bool:
    return current >= target

@blueprint
fn ValidateQuestGraph(graph_nodes: Array<QuestGraphNode>) -> Bool:
    # Validate quest graph has at least one start node and one complete node
    let has_start = false
    let has_complete = false
    
    let i = 0
    while i < graph_nodes.length():
        if graph_nodes[i].node_type == QuestNodeType::QuestStart:
            has_start = true
        if graph_nodes[i].node_type == QuestNodeType::QuestComplete:
            has_complete = true
        i = i + 1
    
    return has_start and has_complete

@blueprint
fn ExportQuestToJSON(quest_id: Int) -> String:
    # Export quest data to JSON for localization
    return "{\"quest_id\": {quest_id}, \"exported\": true}"

@blueprint
fn ImportQuestFromJSON(json_data: String) -> Bool:
    # Import quest data from JSON
    println("Importing quest from JSON: {json_data}")
    return true

# ============================================================================
# SLATE UI - Quest graph editor and inspector
# ============================================================================

@slate
struct QuestGraphCanvas:
    @property
    graph_nodes: Array<QuestGraphNode>
    
    @property
    selected_node_id: Int
    
    @property
    zoom_level: Float
    
    @property
    pan_offset: Vec2
    
    @event
    on_node_selected: OnNodeSelected
    
    @event
    on_node_moved: OnNodeMoved
    
    @event
    on_connection_created: OnConnectionCreated
    
    fn on_node_clicked(node_id: Int):
        selected_node_id = node_id
        println("Node {node_id} selected")
    
    fn on_canvas_zoom(delta: Float):
        zoom_level = zoom_level + delta * 0.1
        zoom_level = clamp(zoom_level, 0.5, 2.0)
    
    fn on_canvas_pan(offset: Vec2):
        pan_offset = pan_offset + offset
    
    fn Compose() -> Widget:
        return VerticalBox()


@slate
struct QuestNodeInspector:
    @property
    node_id: Int
    
    @property
    node_type: QuestNodeType
    
    @property
    node_title: String
    
    @property
    node_description: String
    
    @property
    node_properties: Array<String>
    
    fn on_property_changed(property_name: String, new_value: String):
        println("Property '{property_name}' changed to '{new_value}'")
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct QuestListWidget:
    @property
    active_quests: Array<ActiveQuest>
    
    @property
    completed_quests: Array<Int>
    
    @property
    selected_quest_id: Int
    
    @property
    filter_text: String
    
    fn on_quest_selected(quest_id: Int):
        selected_quest_id = quest_id
        println("Quest {quest_id} selected")
    
    fn on_filter_changed(text: String):
        filter_text = text
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct ObjectiveListWidget:
    @property
    objectives: Array<ObjectiveProgress>
    
    @property
    show_optional: Bool
    
    @property
    show_hidden: Bool
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct DialogueTreeWidget:
    @property
    dialogue_nodes: Array<DialogueLineData>
    
    @property
    current_node_id: Int
    
    @property
    available_choices: Array<DialogueChoice>
    
    fn on_choice_selected(choice_id: Int):
        println("Dialogue choice {choice_id} selected")
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct QuestRewardPreview:
    @property
    rewards: Array<QuestReward>
    
    @property
