@asset_editor
struct QuestGraphAssetEditor:
    @viewport
    preview: QuestGraphPreviewViewport
    
    @details
    node_properties: QuestNodeDetails
    
    @details
    graph_properties: QuestGraphDetails
    
    @toolbar
    toolbar: QuestGraphToolbar
    
    @slate
    graph_canvas: QuestGraphCanvas
    
    @slate
    node_inspector: QuestNodeInspector
    
    @slate
    quest_list: QuestListWidget
    
    @slate
    objective_list: ObjectiveListWidget
    
    @slate
    dialogue_tree: DialogueTreeWidget
    
    @slate
    reward_preview: QuestRewardPreview
    
    @slate
    minimap: QuestGraphMinimap
    
    @slate
    statistics: QuestStatisticsPanel

    
    fn on_asset_opened(asset: QuestGraphAsset):
        # Initialize graph canvas
        graph_canvas.zoom_level = 1.0
        graph_canvas.pan_offset = vec2(0, 0)
        graph_canvas.selected_node_id = -1
        
        # Initialize node inspector
        node_inspector.node_id = -1
        node_inspector.node_type = QuestNodeType::QuestStart
        node_inspector.node_title = "No Node Selected"
        
        # Initialize quest list
        quest_list.selected_quest_id = -1
        quest_list.filter_text = ""
        
        # Initialize objective list
        objective_list.show_optional = true
        objective_list.show_hidden = false
        
        # Initialize dialogue tree
        dialogue_tree.current_node_id = 0
        
        # Initialize reward preview
        reward_preview.total_xp = 0
        reward_preview.total_gold = 0
        
        # Initialize minimap
        minimap.graph_bounds = vec4(0, 0, 1000, 1000)
        minimap.viewport_bounds = vec4(0, 0, 200, 200)
        
        # Initialize statistics
        statistics.total_quests_completed = 0
        statistics.total_quests_failed = 0
        statistics.total_quests_abandoned = 0
        statistics.total_experience_earned = 0
        statistics.total_gold_earned = 0
        statistics.completion_rate = 0.0
        
        # Initialize node properties
        node_properties.node_id = -1
        node_properties.node_type = QuestNodeType::QuestStart
        node_properties.node_title = "New Node"
        node_properties.node_description = ""
        node_properties.target_count = 1
        node_properties.condition_value = 0
        node_properties.delay_seconds = 1.0
        node_properties.node_color = vec3(0.2, 0.4, 0.8)
        node_properties.node_scale = 1.0
        
        # Initialize graph properties
        graph_properties.graph_name = asset.graph_name
        graph_properties.graph_description = asset.graph_description
        graph_properties.total_nodes = 0
        graph_properties.total_connections = 0
        graph_properties.has_start_node = false
        graph_properties.has_complete_node = false
        graph_properties.has_orphaned_nodes = false
        graph_properties.export_path = "/Game/Quests/Exported/"
        graph_properties.include_localization = true
        
        # Initialize preview viewport
        preview.current_quest_id = 0
        preview.camera_distance = 500.0
        
        println("TitanGraph quest editor opened: {asset.graph_name}")
    
    fn on_asset_saved():
        println("Quest graph saved")
    
    fn on_node_selected(node_id: Int):
        # Update node inspector and properties panel
        node_inspector.node_id = node_id
        node_properties.node_id = node_id
        println("Node {node_id} selected in editor")
    
    fn on_graph_compiled():
        println("Quest graph compiled to C++ current_state machine")
    
    fn on_graph_validated():
        println("Quest graph validation complete")

