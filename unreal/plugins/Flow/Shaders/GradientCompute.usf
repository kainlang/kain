// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
float res;

// Texture Inputs
Texture3D<float4> velocity_tex : register(t0);
SamplerState velocity_texSampler : register(s0);
Texture3D<float4> pressure_tex : register(t1);
SamplerState pressure_texSampler : register(s1);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void GradientComputeCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float step = (1.000000 / res);
    float3 uvw = float3((id.x / res), (id.y / res), (id.z / res));
    float pL = pressure_tex.Sample(pressure_texSampler, (uvw - float3(step, 0, 0))).x;
    float pR = pressure_tex.Sample(pressure_texSampler, (uvw + float3(step, 0, 0))).x;
    float pB = pressure_tex.Sample(pressure_texSampler, (uvw - float3(0, step, 0))).x;
    float pT = pressure_tex.Sample(pressure_texSampler, (uvw + float3(0, step, 0))).x;
    float pD = pressure_tex.Sample(pressure_texSampler, (uvw - float3(0, 0, step))).x;
    float pU = pressure_tex.Sample(pressure_texSampler, (uvw + float3(0, 0, step))).x;
    float3 grad = (float3((pR - pL), (pT - pB), (pU - pD)) * 0.500000);
    float3 old_vel = velocity_tex.Sample(velocity_texSampler, uvw).xyz;
    OutputTexture[ThreadId.xy] = float4((old_vel - grad), 1.000000);
    return;
}
