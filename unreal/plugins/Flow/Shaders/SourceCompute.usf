// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
float3 source_pos;
float3 source_val;
float radius;
float res;
float is_velocity;

// Texture Inputs
Texture3D<float4> target_tex : register(t0);
SamplerState target_texSampler : register(s0);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void SourceComputeCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float3 uvw = float3((ThreadId.x / res), (ThreadId.y / res), (ThreadId.z / res));
    float dist = length((uvw - source_pos));
    float4 current = target_tex.Sample(target_texSampler, uvw);
    if ((dist < radius))
    {
        float influence = smoothstep(radius, 0.000000, dist);
        if ((is_velocity > 0.500000))
        {
            current = (current + float4((source_val * influence), 0.000000));
        }
        else
        {
            current = (current + float4((source_val * influence), influence));
        }
    }
    OutputTexture[ThreadId.xy] = current;
    return;
}
