// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
float dt;
float res;
float decay;

// Texture Inputs
Texture3D<float4> velocity_tex : register(t0);
SamplerState velocity_texSampler : register(s0);
Texture3D<float4> target_tex : register(t1);
SamplerState target_texSampler : register(s1);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void AdvectionComputeCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float3 uvw = float3((ThreadId.x / res), (ThreadId.y / res), (ThreadId.z / res));
    float3 velocity = velocity_tex.Sample(velocity_texSampler, uvw).xyz;
    float3 back_uvw = (uvw - (((velocity * dt) / res)));
    float4 advected = target_tex.Sample(target_texSampler, back_uvw);
    OutputTexture[ThreadId.xy] = (advected * decay);
    return;
}
