// ============================================================================
// UPAINT ULTIMATE: The God-Tier Digital Creation Suite
// ============================================================================
// "If you can node it, you can paint with it."
// 
// ARCHITECTURE OVERVIEW:
// 1. Brush Graph System: Users script brush behavior (Dynamics) using KAIN Graphs.
// 2. Quantum Canvas: A GPU-backed Actor allowing up to 16k resolution.
// 3. Shader Library: Procedural HLSL generation for "God Brushes".
// 4. Editor Suite: Full Slate integration.
// ============================================================================

import "Unreal.Core"
import "Unreal.Slate"
import "Unreal.Materials"
import "Unreal.Input"

###############################################################################
# [SECTION 1] THE BRUSH GRAPH SYSTEM (Node-Based Brush Logic)
###############################################################################
// Instead of hardcoded settings, we allow artists to script brush behavior
// using a node graph. This utilizes the 'Example_Graph.kn' patterns.

@graph_editor
@allow_cycles(false)
@category("UPaint/Logic")
graph BrushBehaviorGraph:

    // ------------------------------------------------------------------------
    // Node Types
    // ------------------------------------------------------------------------

    @node_type
    @category("Input")
    @color(0.2, 0.6, 1.0, 1.0)
    @tooltip("Raw Tablet Pressure (0-1)")
    node Input_Pressure:
        outputs:
            Pressure: Float

    @node_type
    @category("Input")
    @color(0.2, 0.6, 1.0, 1.0)
    @tooltip("Stylus Tilt Vector")
    node Input_Tilt:
        outputs:
            Tilt: Vec2
            TiltStrength: Float

    @node_type
    @category("Input")
    @color(0.2, 0.6, 1.0, 1.0)
    @tooltip("Time since stroke started")
    node Input_StrokeTime:
        outputs:
            Time: Float

    @node_type
    @category("Math")
    @icon("Math.Add")
    node Math_Add:
        inputs:
            A: Float = 0.0
            B: Float = 0.0
        outputs:
            Result: Float = A + B

    @node_type
    @category("Math")
    @icon("Math.Multiply")
    node Math_Multiply:
        inputs:
            A: Float = 1.0
            B: Float = 1.0
        outputs:
            Result: Float = A * B

    @node_type
    @category("Math")
    @icon("Math.Curve")
    node Math_CurveMap:
        inputs:
            Alpha: Float
            Curve: CurveFloat
        outputs:
            Result: Float

    @node_type
    @category("Physics")
    @tooltip("Adds procedural noise to the value")
    node Physics_Jitter:
        inputs:
            Value: Float
            Intensity: Float = 0.1
        outputs:
            Jittered: Float

    // The Final Output Node for the Graph
    @node_type
    @category("Output")
    @color(0.8, 0.2, 0.2, 1.0)
    @entry_point // Marks this as a required node
    node Brush_FinalOutput:
        inputs:
            Size: Float = 50.0
            Opacity: Float = 1.0
            Flow: Float = 1.0
            Rotation: Float = 0.0
            Hardness: Float = 0.5
            EmissionMultiplier: Float = 1.0

// ----------------------------------------------------------------------------
// Runtime Execution for the Brush Graph
// ----------------------------------------------------------------------------
// This compiles the graph into optimized C++ for per-pixel/per-tick evaluation.

@graph_runtime(graph: BrushBehaviorGraph)
class UBrushBehaviorExecutor:
    
    // Context variables fed into the graph before execution
    @input_pin
    current_pressure: f32 = 0.0

    @input_pin
    current_tilt: vector2 = vector2(0,0)

    @input_pin
    stroke_duration: f32 = 0.0

    // Result variables extracted after execution
    @output_pin
    out_size: f32

    @output_pin
    out_opacity: f32
    
    @output_pin
    out_rotation: f32

    @output_pin
    out_emission: f32

    // The 'Process' function is auto-generated by KAIN
    // fn Execute(ctx: GraphContext) -> void


###############################################################################
# [SECTION 2] PROCEDURAL SHADER LIBRARY (Material Graph Generation)
###############################################################################
// Leveraging 'material_graph_showcase.kn' to build brushes that are
// literally tiny universes, rendering directly on the GPU.

enum ShaderBrushType:
    Standard
    Fluid
    Cosmic
    Glitch
    Volumetric

// 1. The "Event Horizon" Brush - Distorts space and sucks in color
@material_graph(
    domain: UserInterface,
    blend_mode: Translucent,
    shading_model: Unlit
)
material M_Brush_EventHorizon:
    input intensity: Float = 1.0
    input time_dilation: Float = 1.0
    
    let uv = TextureCoordinate(0)
    let center = vec2(0.5, 0.5)
    let dist = Distance(uv, center)
    
    // Gravitational Lensing (UV Distortion)
    let strength = Parameter.Scalar("DistortionStrength", 2.0)
    let lens_curve = Power(dist, 0.5) * strength
    let distorted_uv = uv + (Normalize(center - uv) * lens_curve * 0.1)

    // Accretion Disk (Noise)
    let time = Time() * time_dilation
    let angle = Atan2(uv.y - 0.5, uv.x - 0.5)
    let spiral = angle + (1.0 / (dist + 0.05))
    
    let noise_uv = vec2(spiral, dist - time)
    let plasma = TextureSample(Parameter.Texture("NoiseTex"), noise_uv)
    
    // Schwarzschild Radius
    let radius = 0.15 * intensity
    let blackhole_mask = Step(dist, radius)
    let accretion_mask = SmoothStep(radius, radius + 0.3, dist)
    
    // Color Ramp
    let hot_color = vec3(1.0, 0.8, 0.2) // Gold
    let cold_color = vec3(0.5, 0.0, 1.0) // Violet
    let final_color = Lerp(cold_color, hot_color, plasma.r) * 10.0 // Emissive boost

    output emissive_color = Lerp(final_color, vec3(0,0,0), blackhole_mask)
    output opacity = (1.0 - blackhole_mask) * accretion_mask * (1.0 - SmoothStep(0.4, 0.5, dist))

// 2. The "Quantum Foam" Brush - 4D Noise Visualization
@material_graph(
    domain: UserInterface,
    blend_mode: Additive
)
material M_Brush_QuantumFoam:
    input probability_density: Float = 1.0
    
    let uv = TextureCoordinate(0)
    let time = Time()
    
    // Domain Warping via chained noise
    let warp_1 = TextureSample(Parameter.Texture("Perlin"), uv + vec2(time * 0.1, 0.0)).rg
    let warp_2 = TextureSample(Parameter.Texture("Perlin"), uv - warp_1 * 0.2 + vec2(0.0, time * 0.15)).rg
    
    let final_noise = TextureSample(Parameter.Texture("Voronoi"), uv + warp_2 * 0.5).r
    
    // Interference Pattern
    let interference = Sin(uv.x * 50.0 + time) * Cos(uv.y * 50.0 - time) * 0.5 + 0.5
    
    let edge_fade = 1.0 - Distance(uv, vec2(0.5, 0.5)) * 2.0
    let mask = Clamp(edge_fade, 0.0, 1.0)
    
    output emissive_color = vec3(0.2, 0.8, 1.0) * final_noise * interference * probability_density * 5.0
    output opacity = mask * final_noise

// 3. The "Liquid Metal" Brush - Screen Space Reflections in 2D
@material_graph(
    domain: UserInterface,
    blend_mode: AlphaComposite
)
material M_Brush_LiquidMetal:
    let uv = TextureCoordinate(0)
    let normal_raw = TextureSample(Parameter.Texture("NormalMap"), uv).rgb
    
    // Unpack Normal
    let normal = Normalize(normal_raw * 2.0 - 1.0)
    let light_dir = Normalize(vec3(-1.0, -1.0, 1.0))
    
    // Specular Highlight
    let view_dir = vec3(0.0, 0.0, 1.0)
    let half_vec = Normalize(light_dir + view_dir)
    let NdotH = Saturate(Dot(normal, half_vec))
    let specular = Power(NdotH, 32.0)
    
    // Fake Chromatic Aberration
    let offset = 0.01 * normal.xy
    let r = TextureSample(Parameter.Texture("EnvMap"), uv + offset).r
    let g = TextureSample(Parameter.Texture("EnvMap"), uv).g
    let b = TextureSample(Parameter.Texture("EnvMap"), uv - offset).b
    
    let alpha_mask = TextureSample(Parameter.Texture("AlphaMask"), uv).a
    
    output emissive_color = vec3(r, g, b) + specular
    output opacity = alpha_mask


###############################################################################
# [SECTION 3] THE CANVAS ACTOR (Core Logic)
###############################################################################

struct StrokeStamp:
    location: vector2
    size: f32
    rotation: f32
    color: LinearColor
    material: MaterialInstanceDynamic

@uclass
@blueprint_type
class UPaintCanvas : Actor:

    // ------------------------------------------------------------------------
    // Components
    // ------------------------------------------------------------------------
    @uproperty(VisibleAnywhere, BlueprintReadOnly)
    mesh_comp: StaticMeshComponent

    // ------------------------------------------------------------------------
    // Painting State
    // ------------------------------------------------------------------------
    @uproperty(EditAnywhere, BlueprintReadWrite)
    canvas_resolution: int32 = 4096

    @uproperty(Transient)
    render_target: TextureRenderTarget2D

    @uproperty(Transient)
    active_material_dyn: MaterialInstanceDynamic

    // The runtime executor for our brush graph
    @uproperty(Transient)
    brush_executor: UBrushBehaviorExecutor

    // ------------------------------------------------------------------------
    // Initialization
    // ------------------------------------------------------------------------
    fn BeginPlay():
        super.BeginPlay()
        
        // Init RT
        self.render_target = CreateRenderTarget(self.canvas_resolution, self.canvas_resolution, RTF_RGBA16f)
        ClearRenderTarget(self.render_target, LinearColor.Black)
        
        // Init Material on Mesh
        if self.mesh_comp:
            self.active_material_dyn = self.mesh_comp.CreateDynamicMaterialInstance(0)
            self.active_material_dyn.SetTextureParameterValue("Canvas", self.render_target)

        // Init Brush Logic
        self.brush_executor = NewObject(UBrushBehaviorExecutor)

    // ------------------------------------------------------------------------
    // The "God" Paint Function
    // ------------------------------------------------------------------------
    @blueprint_callable
    fn PaintStroke(hit_uv: vector2, pressure: f32, tilt: vector2, brush_mat: MaterialInterface):
        
        if not self.render_target: return

        // 1. EXECUTE GRAPH LOGIC
        // Pass input data to the compiled graph runtime
        self.brush_executor.current_pressure = pressure
        self.brush_executor.current_tilt = tilt
        self.brush_executor.stroke_duration = GetGameTimeSeconds() // Simplified
        
        // Run the graph!
        self.brush_executor.Execute()
        
        // Retrieve calculated values
        let final_size = self.brush_executor.out_size
        let final_opacity = self.brush_executor.out_opacity
        let final_rot = self.brush_executor.out_rotation

        // 2. SETUP GPU BRUSH
        let brush_mid = CreateDynamicMaterialInstance(brush_mat)
        brush_mid.SetScalarParameterValue("Opacity", final_opacity)
        brush_mid.SetScalarParameterValue("Rotation", final_rot)
        brush_mid.SetVectorParameterValue("BrushColor", vector(1, 0, 0.5, 1)) // Hot pink default

        // 3. DRAW TO RENDER TARGET
        // We use the canvas item utility for efficiency
        let canvas_item = BeginDrawCanvasToRenderTarget(self.render_target)
        
        // Convert UV to Pixel Coords
        let center_x = hit_uv.x * float(self.canvas_resolution)
        let center_y = hit_uv.y * float(self.canvas_resolution)
        
        canvas_item.DrawMaterial(
            brush_mid, 
            vector2(center_x - final_size/2, center_y - final_size/2), 
            vector2(final_size, final_size), 
            vector2(0,0), 
            vector2(1,1), 
            0.0
        )
        
        EndDrawCanvasToRenderTarget(canvas_item)


###############################################################################
# [SECTION 4] EDITOR UI - SLATE SUITE (Example_Slate.kn style)
###############################################################################

// 1. The Asset Picker for Brushes
@slate
struct BrushAssetBrowser:
    @argument
    OnBrushSelected: delegate(MaterialInterface)

    fn Construct():
        VBox:
            SectionLabel(Text: "Quantum Brush Library")
            
            // Search Bar
            EditableTextBox(
                HintText: "Search effects...",
                OnTextChanged: (text) => self.FilterBrushes(text)
            )

            // Grid of Shaders
            ScrollBox:
                WrapBox:
                    self.MakeBrushCard("Event Horizon", "/UPaint/M_Brush_EventHorizon")
                    self.MakeBrushCard("Quantum Foam", "/UPaint/M_Brush_QuantumFoam")
                    self.MakeBrushCard("Liquid Metal", "/UPaint/M_Brush_LiquidMetal")

    fn MakeBrushCard(name: string, path: string) -> Widget:
        let mat = LoadAsset(path)
        return Button(
            ToolTipText: name,
            Content: VBox:
                Image(Brush: mat, Size: vec2(64, 64))
                Label(Text: name, Justification: Center)
            OnClick: () => self.OnBrushSelected.Execute(mat)
        )
    
    fn FilterBrushes(query: string):
        // Implementation logic for filtering
        pass

// 2. The Brush Graph Editor Viewport embedded in the tool
@slate
struct BrushGraphEditorPanel:
    @argument
    GraphObject: Object // The BrushBehaviorGraph asset

    fn Construct():
        VBox:
            // Toolbar
            HBox:
                Button(Label: "Save", Icon: "Icons.Save")
                Button(Label: "Compile", Icon: "Icons.Compile")
                Spacer(Fill: true)
                CheckBox(Label: "Live Preview")

            // The actual Node Graph Editor Widget
            GraphEditorWidget(
                GraphObj: self.GraphObject,
                AppearanceInfo: GraphAppearance(
                    CornerText: "Brush Logic",
                    InstructionText: "Right-click to add nodes"
                )
            )

// 3. The Main Studio Window
@slate
struct UPaintStudioWindow:
    @argument
    CanvasActor: UPaintCanvas

    fn Construct():
        DockTabStack:
            // Left: Library & Layers
            Splitter(Orientation: Horizontal):
                Slot(SizeCoefficient: 0.25):
                    VBox:
                        BrushAssetBrowser(
                            OnBrushSelected: (m) => self.CanvasActor.PaintStroke(vec2(0,0), 0, vec2(0,0), m) // Test binding
                        )
                        Spacer(Height: 10.0)
                        SectionLabel(Text: "Layers")
                        ListView(
                            Items: [1, 2, 3], // Placeholder for Layer Structs
                            OnGenerateRow: (item) => Label(Text: "Layer " + string(item))
                        )
                
                // Center: 3D Viewport (Canvas)
                Slot(SizeCoefficient: 0.5):
                    ViewportWidget(
                        TargetActor: self.CanvasActor,
                        ShowToolbar: true,
                        Realtime: true
                    )

                // Right: Brush Logic Graph
                Slot(SizeCoefficient: 0.25):
                    BrushGraphEditorPanel(
                        GraphObject: LoadAsset("/UPaint/Graphs/DefaultBrushGraph")
                    )

###############################################################################
# [SECTION 5] EDITOR MODULE REGISTRATION
###############################################################################

@editor_module(name: "UPaintUltimate", phase: Default)
struct UPaintEditorModule:

    @tab_spawner(
        id: "UPaintStudio",
        display_name: "UPaint Ultimate Studio",
        icon: "Icons.Brush",
        group: "Content"
    )
    fn SpawnStudio(args: TabSpawnArgs) -> Widget:
        // Auto-detect or spawn canvas
        let world = GetEditorWorld()
        let actor = world.FindActorOfClass(UPaintCanvas)
        
        if not actor:
            actor = world.SpawnActor(UPaintCanvas, vec3(0,0,0))
            Log("UPaint: Spawned new Quantum Canvas")
            
        return UPaintStudioWindow(CanvasActor: actor)

    @menu_entry(
        path: "LevelEditor/Tools",
        label: "Open UPaint Ultimate",
        tooltip: "Launch the node-based GPU painting suite")