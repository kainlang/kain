// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
StructuredBuffer<float4> in_velocity;  // @1
int agent_count;  // @3
float dt;  // @4
int frame_count;  // @5
float playback_speed;  // @6

// UAV Outputs
RWBuffer io_positions : register(u0);  // @0 -> u0 register
RWBuffer io_playback : register(u2);  // @2 -> u2 register

[numthreads(8, 8, 1)]
void IntegrateCrowdAgentsCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= agent_count))
    {
        return;
    }
    float3 p = io_positions[idx].xyz;
    float3 v = in_velocity[idx].xyz;
    p = (p + (v * dt));
    float frame = io_playback[idx].x;
    frame = (frame + ((playback_speed * dt) * 30.000000));
    if ((frame >= float(frame_count)))
    {
        frame = (frame - float(frame_count));
    }
    io_positions[idx] = float4(p, 1.000000);
    io_playback[idx] = float4(frame, length(v), 0.000000, 1.000000);
}
