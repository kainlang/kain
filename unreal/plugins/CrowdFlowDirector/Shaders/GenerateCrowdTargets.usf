int agent_count;  // @5
int layout_mode;  // @6
float3 spacing;  // @7
float3 counts;  // @8
float3 center;  // @9
float radius;  // @10
float arc_angle;  // @11

// UAV Outputs
RWBuffer out_positions : register(u2);  // @2 -> u2 register
RWBuffer out_targets : register(u3);  // @3 -> u3 register
RWBuffer out_random : register(u4);  // @4 -> u4 register

[numthreads(8, 8, 1)]
void GenerateCrowdTargetsCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= agent_count))
    {
        return;
    }
    float fx = float((idx % int(counts.x)));
    float fy = float((((idx / int(counts.x))) % int(counts.y)));
    float fz = float((idx / int((counts.x * counts.y))));
    float3 p = center;
    if ((layout_mode == 0))
    {
        p = (center + float3((((fx - (counts.x * 0.500000))) * spacing.x), (((fy - (counts.y * 0.500000))) * spacing.y), (fz * spacing.z)));
    }
    else     if ((layout_mode == 1))
    {
        float a = (((float(idx) / float(max(agent_count, 1)))) * 6.283180);
        p = (center + float3((cos(a) * radius), (sin(a) * radius), 0.000000));
    }
    else     if ((layout_mode == 2))
    {
        float t = (float(idx) / float(max((agent_count - 1), 1)));
        float a = ((((-0.500000) + t)) * arc_angle);
        p = (center + float3((cos(a) * radius), (sin(a) * radius), 0.000000));
    }
    else
    {
        float h = frac((sin((float(idx) * 12.989800)) * 43758.545300));
        float k = frac((sin((float(idx) * 78.233000)) * 12345.678900));
        p = (center + float3(((((h - 0.500000)) * radius) * 2.000000), ((((k - 0.500000)) * radius) * 2.000000), 0.000000));
    }
    #ifdef CFG_USE_JITTER
    float jx = (frac((sin((float(idx) * 19.130000)) * 21413.700000)) - 0.500000);
    float jy = (frac((sin((float(idx) * 27.510000)) * 91873.100000)) - 0.500000);
    p = (p + ((float3(jx, jy, 0.000000) * spacing) * 0.200000));
    #endif
    out_positions[idx] = float4(p, 1.000000);
    out_targets[idx] = float4(p, 1.000000);
    out_random[idx] = float4(frac((float(idx) * 0.123000)), frac((float(idx) * 0.456000)), frac((float(idx) * 0.789000)), 1.000000);
