# ============================================================================
# KAIN GAS SHOWCASE — Complete Gameplay Ability System Demonstration
# ============================================================================
# This file demonstrates EVERY feature of KAIN's GAS codegen:
# - GameplayTags (80+ tags, hierarchical)
# - Attribute Sets (5 sets with replication)
# - Gameplay Abilities (20+ abilities)
# - Gameplay Effects (30+ effects)
# - Tag Queries & Events
# - Ability Tasks
# - Gameplay Cues
# - Full Multiplayer Replication
# - Ability System Component
# - Cost & Cooldown Systems
# - Damage Calculations
# - Buff/Debuff Systems
# - DOT/HOT Effects
# - Immunity & Resistance
# - Combo Systems
# - Passive Abilities
# - Channeled Abilities
# - Instant Abilities
# - State Tracking
# ============================================================================
# ============================================================================
# SECTION 1: GAMEPLAY TAGS (80+ tags, hierarchical)
# ============================================================================
# Tags are the FOUNDATION of GAS. Without proper tag support, nothing works.
# Tags control ability activation, effect application, state tracking, and more.
# ============================================================================
@gameplay_tags
namespace Ability:
    # Attack Abilities
    Attack:
        Melee:
            Sword:
                Light
                Heavy
                Combo
            Axe:
                Chop
                Cleave
                Whirlwind
            Spear:
                Thrust
                Sweep
                Charge
        Ranged:
            Bow:
                QuickShot
                ChargedShot
                MultiShot
                PiercingShot
            Gun:
                SingleShot
                Burst
                FullAuto
                Reload
            Magic:
                Fireball
                IceShard
                Lightning
                Meteor
    # Defensive Abilities
    Defend:
        Block:
            Shield
            Parry
            Counter
        Dodge:
            Roll
            Dash
            Teleport
            Blink
        Absorb:
            MagicShield
            PhysicalShield
            ElementalShield
    # Utility Abilities
    Utility:
        Movement:
            Jump
            Sprint
            Climb
            Glide
            WallRun
        Interaction:
            Use
            Pickup
            Drop
            Examine
        Magic:
            Heal
            Buff
            Summon
            Dispel
            Cleanse
    # Passive Abilities
    Passive:
        Regeneration:
            HealthRegen
            ManaRegen
            StaminaRegen
        Resistance:
            FireResist
            IceResist
            LightningResist
            PoisonResist
        Mastery:
            SwordMastery
            BowMastery
            MagicMastery
    # Channeled Abilities
    Channeled:
        Beam:
            FireBeam
            IceBeam
            HealBeam
        Channel:
            Meditation
            Ritual
            Summon
    # Activation Failures
    ActivateFail:
        IsDead
        Cooldown
        Cost
        TagsBlocked
        TagsMissing
        Networking
        NoTarget
        OutOfRange
    # Behavior Tags
    Behavior:
        SurvivesDeath
        CannotBeCanceled
        IgnoreGlobalCooldown
        RequiresTarget
