# ============================================================================
# SECTION 4: GAMEPLAY EFFECTS (30+ effects)
# ============================================================================
# Effects modify attributes with instant, duration, or infinite policies.
# Supports stacking, tag requirements, immunity, and conditional effects.
# ============================================================================
# ───────────────────────────────────────────────────────────────────────────
# INSTANT EFFECTS - Apply once and done
# ───────────────────────────────────────────────────────────────────────────
@gameplay_effect
struct InstantDamageEffect:
    @duration(type: "Instant")
    @modifier(attribute: "Health", operation: "Add", magnitude_type: "SetByCaller")
    damage:
        set_by_caller: "SetByCaller.Damage.Amount"
    @owned_tags
    tags: ["Effect.Damage.Instant"]
    @application_tag_requirements
    require: ["Status.Alive"]
    ignore: ["Status.Immune.Damage", "Status.Immune.AllDamage"]
    @gameplay_cues
    cues: ["GameplayCue.Impact.Physical"]
@gameplay_effect
struct InstantHealEffect:
    @duration(type: "Instant")
    @modifier(attribute: "Health", operation: "Add", magnitude_type: "SetByCaller")
    healing:
        set_by_caller: "SetByCaller.Heal.Amount"
    @owned_tags
    tags: ["Effect.Heal.Instant"]
    @application_tag_requirements
    require: ["Status.Alive"]
    ignore: ["Status.Condition.FullHealth"]
    @gameplay_cues
    cues: ["GameplayCue.Effect.Heal.Burst"]
@gameplay_effect
struct CriticalDamageEffect:
    @duration(type: "Instant")
    @modifier(attribute: "Health", operation: "Add", magnitude_type: "AttributeBased")
    damage:
        coefficient: -2.0
        backing_attribute: "AttackPower"
        calculation_type: "AttributeMagnitude"
    @owned_tags
    tags: ["Effect.Damage.Instant", "Effect.Damage.Critical"]
    @application_tag_requirements
    require: ["Status.Alive"]
    ignore: ["Status.Immune.Physical"]
    @gameplay_cues
    cues: ["GameplayCue.Ability.Impact.Critical"]
