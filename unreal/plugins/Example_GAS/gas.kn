# ───────────────────────────────────────────────────────────────────────────
# COMBO ABILITIES - State-based combo chains
# ───────────────────────────────────────────────────────────────────────────
@ability
struct ComboAttackAbility:
    @instancing(policy: "InstancedPerActor")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")
    @ability_tags
    tags: ["Ability.Attack.Melee.Sword.Combo"]
    @activation_required_tags
    required: ["Status.Alive"]
    @activation_blocked_tags
    blocked: ["Status.CC.Stunned", "Status.CC.Disarmed", "Status.Dead"]
    @activation_owned_tags
    owned: ["Status.Attacking"]
    @cost
    effect: StaminaCostEffect
    state combo_count: Int = 0
    state combo_window: Float = 1.5
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        let asc = get_ability_system_component()
        if asc.has_matching_gameplay_tag("Combo.State.First"):
            execute_combo_two()
            asc.remove_loose_gameplay_tag("Combo.State.First")
            asc.add_loose_gameplay_tag("Combo.State.Second")
        elif asc.has_matching_gameplay_tag("Combo.State.Second"):
            execute_combo_three()
            asc.remove_loose_gameplay_tag("Combo.State.Second")
            asc.add_loose_gameplay_tag("Combo.State.Third")
        elif asc.has_matching_gameplay_tag("Combo.State.Third"):
            execute_combo_finisher()
            asc.remove_loose_gameplay_tag("Combo.State.Third")
        else:
            execute_combo_one()
            asc.add_loose_gameplay_tag("Combo.State.First")
        start_combo_reset_timer(combo_window)
        end_ability(handle, actor_info, activation_info, true, false)
# ───────────────────────────────────────────────────────────────────────────
# TARGETED ABILITIES - Require target selection
# ───────────────────────────────────────────────────────────────────────────
@ability
struct TargetedHealAbility:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")
    @ability_tags
    tags: ["Ability.Utility.Magic.Heal"]
    @activation_required_tags
    required: ["Status.Alive", "Status.Condition.CanCast"]
    @activation_blocked_tags
    blocked: ["Status.CC.Silenced", "Status.Dead"]
    @activation_owned_tags
    owned: ["Status.Casting"]
    @cost
    effect: ManaCostEffect
    @cooldown
    effect: HealCooldownEffect
    state heal_amount: Float = 50.0
    state heal_range: Float = 1000.0
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        let target = get_target_actor()
        if !target:
            end_ability(handle, actor_info, activation_info, true, true)
            return
        if distance_to_target(target) > heal_range:
            end_ability(handle, actor_info, activation_info, true, true)
            return
        apply_heal_effect(target, heal_amount)
        apply_gameplay_cue_to_target(target, "GameplayCue.Effect.Heal.Burst")
        end_ability(handle, actor_info, activation_info, true, false)
@ability
struct AOEDamageAbility:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "ServerInitiated")
    @ability_tags
    tags: ["Ability.Attack.Ranged.Magic.Meteor"]
    @activation_required_tags
    required: ["Status.Alive", "Status.Condition.CanCast"]
    @activation_blocked_tags
    blocked: ["Status.CC.Stunned", "Status.CC.Silenced", "Status.Dead"]
    @activation_owned_tags
    owned: ["Status.Casting"]
    @cost
    effect: ManaCostEffect
    @cooldown
    effect: MeteorCooldownEffect
    state aoe_radius: Float = 500.0
    state damage_amount: Float = 100.0
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        let target_location = get_target_location()
        let actors_in_radius = get_actors_in_radius(target_location, aoe_radius)
        for actor in actors_in_radius:
            apply_damage_effect(actor, damage_amount, "Damage.Magical.Fire")
        apply_gameplay_cue_at_location(target_location, "GameplayCue.Impact.Fire")
        end_ability(handle, actor_info, activation_info, true, false)
