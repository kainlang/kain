    @duration(type: "HasDuration")
    duration: 8.0
    @owned_tags
    tags: ["Cooldown.Ability.Skill4"]
    @granted_tags
    tags: ["Cooldown.Ability.Skill4"]
@gameplay_effect
struct MeteorCooldownEffect:
    @duration(type: "HasDuration")
    duration: 15.0
    @owned_tags
    tags: ["Cooldown.Ability.Ultimate"]
    @granted_tags
    tags: ["Cooldown.Ability.Ultimate"]
@gameplay_effect
struct BuffCooldownEffect:
    @duration(type: "HasDuration")
    duration: 10.0
    @owned_tags
    tags: ["Cooldown.Ability.Buff"]
    @granted_tags
    tags: ["Cooldown.Ability.Buff"]
@gameplay_effect
struct InvulnerabilityCooldownEffect:
    @duration(type: "HasDuration")
    duration: 30.0
    @owned_tags
    tags: ["Cooldown.Ability.Ultimate"]
    @granted_tags
    tags: ["Cooldown.Ability.Ultimate"]
@gameplay_effect
struct MeditationCooldownEffect:
    @duration(type: "HasDuration")
    duration: 20.0
    @owned_tags
    tags: ["Cooldown.Ability.Meditation"]
    @granted_tags
    tags: ["Cooldown.Ability.Meditation"]
@gameplay_effect
struct ParryCooldownEffect:
    @duration(type: "HasDuration")
    duration: 4.0
    @owned_tags
    tags: ["Cooldown.Ability.Parry"]
    @granted_tags
    tags: ["Cooldown.Ability.Parry"]
@gameplay_effect
struct GlobalCooldownEffect:
    @duration(type: "HasDuration")
    duration: 1.5
    @owned_tags
    tags: ["Cooldown.Global.GCD"]
    @granted_tags
    tags: ["Cooldown.Global.GCD"]
# ───────────────────────────────────────────────────────────────────────────
# COMPLEX EFFECTS - Conditional, overflow, immunity
# ───────────────────────────────────────────────────────────────────────────
@gameplay_effect
struct LifestealEffect:
    @duration(type: "Instant")
    @modifier(attribute: "Health", operation: "Add", magnitude_type: "AttributeBased")
    healing:
        coefficient: 0.2
        backing_attribute: "Damage"
        calculation_type: "AttributeMagnitude"
    @owned_tags
    tags: ["Effect.Heal.Instant", "Effect.Lifesteal"]
    @application_tag_requirements
    require: ["Status.Alive"]
@gameplay_effect
struct VampirismEffect:
    @duration(type: "Infinite")
    @modifier(attribute: "Lifesteal", operation: "Add")
    lifesteal_bonus: 0.15
    @owned_tags
    tags: ["Effect.Buff.Combat"]
    @granted_tags
    tags: ["Status.Buff.Empowered"]
    @conditional_effects
    on_damage_dealt: ["LifestealEffect"]
@gameplay_effect
struct ThornsDamageEffect:
    @duration(type: "Infinite")
    @owned_tags
    tags: ["Effect.Buff.Defensive"]
    @granted_tags
    tags: ["Status.Buff.Thorns"]
    @conditional_effects
    on_damage_received: ["ReflectDamageEffect"]
@gameplay_effect
struct ReflectDamageEffect:
    @duration(type: "Instant")
    @modifier(attribute: "Health", operation: "Add", magnitude_type: "AttributeBased")
    reflected_damage:
        coefficient: -0.3
        backing_attribute: "Damage"
        calculation_type: "AttributeMagnitude"
    @owned_tags
    tags: ["Effect.Damage.Instant", "Effect.Reflected"]
@gameplay_effect
struct OverhealShieldEffect:
    @duration(type: "HasDuration")
    duration: 10.0
    @modifier(attribute: "MaxHealth", operation: "Add")
    shield_amount: 50.0
    @owned_tags
    tags: ["Effect.Buff.Shield"]
    @granted_tags
    tags: ["Status.Buff.Shield"]
    @overflow_effects
    overflow: ["OverhealShieldEffect"]
@gameplay_effect
struct InvulnerabilityEffect:
    @duration(type: "HasDuration")
    duration: 5.0
    @owned_tags
    tags: ["Effect.Buff.Immunity"]
    @granted_tags
    tags: ["Status.Immune.AllDamage", "Status.Immune.CC", "Status.Buff.Invulnerability"]
    @immunity
    immune_to: ["Effect.Damage", "Effect.CC"]
    @remove_effects_with_tags
    remove: ["Effect.Damage", "Effect.CC", "Status.Debuff"]
    @gameplay_cues
    cues: ["GameplayCue.Effect.Invulnerability.Start", "GameplayCue.Effect.Invulnerability.End"]
@gameplay_effect
struct BlockDefenseBuffEffect:
    @duration(type: "Infinite")
    @modifier(attribute: "Defense", operation: "Multiply")
    defense_multiplier: 2.0
    @modifier(attribute: "Armor", operation: "Multiply")
    armor_multiplier: 1.5
    @owned_tags
    tags: ["Effect.Buff.Defensive", "Effect.Buff.Block"]
    @granted_tags
    tags: ["Status.Buff.Armor"]
@gameplay_effect
struct ParryWindowEffect:
    @duration(type: "HasDuration")
    duration: 0.3
    @owned_tags
    tags: ["Effect.Buff.Parry"]
    @granted_tags
    tags: ["Status.Defending"]
    @conditional_effects
    on_damage_received: ["ParryCounterEffect"]
@gameplay_effect
struct ParryCounterEffect:
    @duration(type: "Instant")
    @modifier(attribute: "Health", operation: "Add", magnitude_type: "AttributeBased")
    counter_damage:
        coefficient: -1.5
        backing_attribute: "Damage"
        calculation_type: "AttributeMagnitude"
    @owned_tags
    tags: ["Effect.Damage.Instant", "Effect.Counter"]
@gameplay_effect
struct DashInvulnerabilityEffect:
    @duration(type: "HasDuration")
    duration: 0.3
    @owned_tags
    tags: ["Effect.Buff.Immunity"]
    @granted_tags
    tags: ["Status.Immune.CC"]
    @immunity
    immune_to: ["Effect.CC"]
# ============================================================================
# SECTION 5: TAG QUERIES & EVENTS
# ============================================================================
# Tag queries enable complex conditional logic with any/all/not combinations.
# Tag events provide reactive programming for state changes.
# ============================================================================
@ability
struct ConditionalAbility:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")
    @ability_tags
    tags: ["Ability.Attack.Conditional"]
    # Complex tag query: (Buffed OR Empowered) AND Alive AND NOT (Stunned OR Silenced)
    @tag_query
    can_activate: any(["Status.Buff.Strength", "Status.Buff.Empowered"]) 
                  and all(["Status.Alive", "Status.Condition.Conscious"])
                  and not(any(["Status.CC.Stunned", "Status.CC.Silenced"]))
    fn can_activate_ability(handle, actor_info, source_tags, target_tags) -> Bool:
        let asc = get_ability_system_component()
        let owner_tags = asc.get_owned_gameplay_tags()
        return evaluate_query(can_activate, owner_tags)
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        apply_damage_to_target(100.0, "Damage.Physical")
        end_ability(handle, actor_info, activation_info, true, false)
@ability
struct VulnerabilityExploitAbility:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "ServerInitiated")
    @ability_tags
    tags: ["Ability.Attack.Exploit"]
    # Target must have vulnerability AND NOT have immunity
    @target_tag_query
    target_valid: any(["Weakness.Fire", "Weakness.Ice", "Weakness.Lightning"])
                  and not(any(["Status.Immune.Fire", "Status.Immune.Ice", "Status.Immune.Lightning"]))
    fn can_activate_ability(handle, actor_info, source_tags, target_tags) -> Bool:
        let target = get_target_actor()
        if !target:
            return false
        let target_asc = get_ability_system_component_from_actor(target)
        let target_tags = target_asc.get_owned_gameplay_tags()
        return evaluate_query(target_valid, target_tags)
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        let target = get_target_actor()
        let target_asc = get_ability_system_component_from_actor(target)
        var damage_multiplier: Float = 1.0
        if target_asc.has_matching_gameplay_tag("Weakness.Fire"):
            damage_multiplier = 2.0
        elif target_asc.has_matching_gameplay_tag("Weakness.Ice"):
            damage_multiplier = 1.8
        elif target_asc.has_matching_gameplay_tag("Weakness.Lightning"):
            damage_multiplier = 1.5
        apply_damage_effect(target, 50.0 * damage_multiplier, "Damage.TrueDamage.PureDamage")
        end_ability(handle, actor_info, activation_info, true, false)
# ───────────────────────────────────────────────────────────────────────────
# TAG EVENT HANDLERS - Reactive state management
# ───────────────────────────────────────────────────────────────────────────
actor GASCharacter:
    @replicated
    state health: Float = 100.0
    @replicated
    state is_stunned: Bool = false
    @replicated
    state buff_count: Int = 0
    @replicated
    state is_in_combat: Bool = false
    # Tag added event
    @on_tag_added("Status.CC.Stunned")
    fn on_stunned():
        is_stunned = true
        cancel_all_abilities()
        play_animation("Stunned")
        disable_input()
        apply_gameplay_cue("GameplayCue.Effect.Stun.Start")
    # Tag removed event
    @on_tag_removed("Status.CC.Stunned")
    fn on_unstunned():
        is_stunned = false
        play_animation("Idle")
        enable_input()
        apply_gameplay_cue("GameplayCue.Effect.Stun.End")
    # Tag count changed event
    @on_tag_count_changed("Status.Buff")
    fn on_buff_count_changed(tag: Tag, count: Int):
        buff_count = count
        update_buff_ui(count)
        if count > 0:
            show_buff_particles()
        else:
            hide_buff_particles()
    # Multiple tag events
    @on_tag_added("Status.Debuff.Burning")
    fn on_burning_started():
        play_particle_effect("FX_Burning")
        apply_gameplay_cue("GameplayCue.Effect.Burn.Start")
    @on_tag_removed("Status.Debuff.Burning")
    fn on_burning_ended():
        stop_particle_effect("FX_Burning")
        apply_gameplay_cue("GameplayCue.Effect.Burn.End")
    @on_tag_added("Status.Debuff.Poisoned")
    fn on_poisoned():
        play_particle_effect("FX_Poison")
        tint_character_green()
    @on_tag_removed("Status.Debuff.Poisoned")
    fn on_poison_cured():
        stop_particle_effect("FX_Poison")
        restore_character_color()
    @on_tag_added("Status.InCombat")
    fn on_combat_started():
        is_in_combat = true
        play_combat_music()
        show_combat_ui()
    @on_tag_removed("Status.InCombat")
    fn on_combat_ended():
        is_in_combat = false
        play_ambient_music()
        hide_combat_ui()
    @on_tag_added("Status.Dead.Dying")
    fn on_dying():
        play_death_animation()
        disable_input()
        cancel_all_abilities()
    @on_tag_added("Status.Dead.Dead")
    fn on_dead():
        set_actor_enable_collision(false)
        set_life_span(5.0)
    # Tag query in method
    @blueprint_callable
    fn can_use_abilities() -> Bool:
        let asc = get_ability_system_component()
        let owner_tags = asc.get_owned_gameplay_tags()
        # Must be alive AND NOT have any CC
        let query = all(["Status.Alive"]) and not(any(["Status.CC"]))
        return evaluate_query(query, owner_tags)
    @blueprint_callable
    fn is_vulnerable_to_fire() -> Bool:
        let asc = get_ability_system_component()
        # Has fire weakness AND NOT fire immunity
        return asc.has_matching_gameplay_tag("Weakness.Fire") and 
               not asc.has_matching_gameplay_tag("Status.Immune.Fire")
    @blueprint_callable
    fn get_active_debuff_count() -> Int:
        let asc = get_ability_system_component()
        let debuff_tag = request_gameplay_tag("Status.Debuff")
        return asc.get_tag_count(debuff_tag)
    on BeginPlay():
        println("GASCharacter initialized with GAS support")
        initialize_ability_system()
        grant_default_abilities()
        apply_default_effects()
    on Tick(delta_time: Float):
        update_combat_state(delta_time)
# ============================================================================
# SECTION 6: ABILITY SYSTEM COMPONENT INTEGRATION
# ============================================================================
# Demonstrates how actors integrate with the Ability System Component,
# including ability granting, effect application, and tag management.
# ============================================================================
actor GASPlayer:
    @replicated
    state health: Float = 100.0
    @replicated
    state max_health: Float = 100.0
    @replicated
    state mana: Float = 100.0
    @replicated
    state stamina: Float = 100.0
    state ability_system_component: AbilitySystemComponent
    state health_set: HealthSet
    state combat_set: CombatSet
    state movement_set: MovementSet
    state magic_set: MagicSet
    state stamina_set: StaminaSet
    on BeginPlay():
        initialize_ability_system()
        grant_attribute_sets()
        grant_default_abilities()
        apply_passive_effects()
        bind_input_to_abilities()
    fn initialize_ability_system():
        ability_system_component = create_ability_system_component()
        ability_system_component.init_ability_actor_info(self, self)
    fn grant_attribute_sets():
        health_set = ability_system_component.add_set(HealthSet)
        combat_set = ability_system_component.add_set(CombatSet)
        movement_set = ability_system_component.add_set(MovementSet)
        magic_set = ability_system_component.add_set(MagicSet)
        stamina_set = ability_system_component.add_set(StaminaSet)
    fn grant_default_abilities():
        # Grant instant abilities
        ability_system_component.give_ability(JumpAbility, 1)
        ability_system_component.give_ability(MeleeAttackAbility, 1)
        ability_system_component.give_ability(FireballAbility, 1)
        ability_system_component.give_ability(HealAbility, 1)
        ability_system_component.give_ability(DashAbility, 1)
        # Grant channeled abilities
        ability_system_component.give_ability(FireBeamAbility, 1)
        ability_system_component.give_ability(MeditationAbility, 1)
        # Grant defensive abilities
        ability_system_component.give_ability(BlockAbility, 1)
        ability_system_component.give_ability(ParryAbility, 1)
        # Grant buff abilities
        ability_system_component.give_ability(StrengthBuffAbility, 1)
        ability_system_component.give_ability(InvulnerabilityAbility, 1)
        # Grant passive abilities (auto-activate)
        ability_system_component.give_ability_and_activate_once(PassiveHealthRegenAbility, 1)
        ability_system_component.give_ability_and_activate_once(PassiveManaRegenAbility, 1)
        ability_system_component.give_ability_and_activate_once(SwordMasteryAbility, 1)
    fn apply_passive_effects():
        # Apply infinite passive effects
        ability_system_component.apply_gameplay_effect_to_self(PassiveHealthRegenEffect, 1)
        ability_system_component.apply_gameplay_effect_to_self(PassiveManaRegenEffect, 1)
    fn bind_input_to_abilities():
        bind_ability_to_input("Jump", "Input.Jump")
        bind_ability_to_input("Attack", "Input.Attack")
        bind_ability_to_input("Skill1", "Input.Skill1")
        bind_ability_to_input("Skill2", "Input.Skill2")
        bind_ability_to_input("Skill3", "Input.Skill3")
        bind_ability_to_input("Skill4", "Input.Skill4")
    @blueprint_callable
    fn try_activate_ability_by_tag(tag: String) -> Bool:
        let tag_container = make_tag_container(tag)
        return ability_system_component.try_activate_abilities_by_tag(tag_container)
    @blueprint_callable
    fn cancel_abilities_by_tag(tag: String):
        let tag_container = make_tag_container(tag)
        ability_system_component.cancel_abilities(tag_container)
    @blueprint_callable
    fn apply_damage_to_self(damage: Float, damage_type: String):
        let effect_context = ability_system_component.make_effect_context()
        let effect_spec = ability_system_component.make_outgoing_spec(InstantDamageEffect, 1, effect_context)
        effect_spec.set_set_by_caller_magnitude("SetByCaller.Damage.Amount", damage)
        ability_system_component.apply_gameplay_effect_spec_to_self(effect_spec)
    @blueprint_callable
    fn heal_self(amount: Float):
        let effect_context = ability_system_component.make_effect_context()
        let effect_spec = ability_system_component.make_outgoing_spec(InstantHealEffect, 1, effect_context)
        effect_spec.set_set_by_caller_magnitude("SetByCaller.Heal.Amount", amount)
        ability_system_component.apply_gameplay_effect_spec_to_self(effect_spec)
    @blueprint_callable
    fn apply_buff(buff_effect_class: String, duration: Float):
        ability_system_component.apply_gameplay_effect_to_self(buff_effect_class, 1)
    @blueprint_callable
    fn remove_effects_by_tag(tag: String):
        let tag_container = make_tag_container(tag)
        ability_system_component.remove_active_effects_with_granted_tags(tag_container)
    @blueprint_callable
    fn has_tag(tag: String) -> Bool:
        let gameplay_tag = request_gameplay_tag(tag)
        return ability_system_component.has_matching_gameplay_tag(gameplay_tag)
    @blueprint_callable
    fn has_any_tags(tags: Array<String>) -> Bool:
        let tag_container = make_tag_container_from_array(tags)
        return ability_system_component.has_any_matching_gameplay_tags(tag_container)
    @blueprint_callable
    fn has_all_tags(tags: Array<String>) -> Bool:
        let tag_container = make_tag_container_from_array(tags)
        return ability_system_component.has_all_matching_gameplay_tags(tag_container)
    @blueprint_callable
    fn add_loose_tag(tag: String):
        let gameplay_tag = request_gameplay_tag(tag)
        ability_system_component.add_loose_gameplay_tag(gameplay_tag)
    @blueprint_callable
    fn remove_loose_tag(tag: String):
        let gameplay_tag = request_gameplay_tag(tag)
        ability_system_component.remove_loose_gameplay_tag(gameplay_tag)
    @blueprint_callable
    fn get_attribute_value(attribute_name: String) -> Float:
        let attribute = get_gameplay_attribute(attribute_name)
        return ability_system_component.get_numeric_attribute(attribute)
    @blueprint_callable
    fn set_attribute_base_value(attribute_name: String, value: Float):
        let attribute = get_gameplay_attribute(attribute_name)
        ability_system_component.set_numeric_attribute_base(attribute, value)
    @blueprint_callable
    fn get_cooldown_remaining(ability_tag: String) -> Float:
        let tag = request_gameplay_tag(ability_tag)
        return ability_system_component.get_cooldown_time_remaining(tag)
    @blueprint_callable
    fn is_ability_on_cooldown(ability_tag: String) -> Bool:
        let tag = request_gameplay_tag(ability_tag)
        return ability_system_component.has_matching_gameplay_tag(tag)
# ============================================================================
# SECTION 7: ADVANCED PATTERNS
# ============================================================================
# Demonstrates advanced GAS patterns including death systems, initialization
# state machines, movement mode tracking, and effect queries.
# ============================================================================
actor AdvancedGASCharacter:
    @replicated
    state is_alive: Bool = true
    @replicated
    state is_dying: Bool = false
    @replicated
    state initialization_state: Int = 0
    state ability_system_component: AbilitySystemComponent
    # ───────────────────────────────────────────────────────────────────────
    # Death System (Lyra Pattern)
    # ───────────────────────────────────────────────────────────────────────
    @on_tag_added("Status.Dead.Dying")
    fn on_dying_started():
        is_dying = true
        play_death_animation()
        disable_input()
        # Cancel all abilities except those that survive death
        let asc = get_ability_system_component()
        let survives_death_tag = make_tag_container("Ability.Behavior.SurvivesDeath")
        asc.cancel_abilities(null, survives_death_tag)
        # Transition to dead after animation
        start_timer(3.0, "transition_to_dead")
    @on_tag_added("Status.Dead.Dead")
    fn on_dead():
        is_alive = false
        is_dying = false
        set_actor_enable_collision(false)
        set_life_span(5.0)
        # Remove dying tag
        let asc = get_ability_system_component()
        asc.remove_loose_gameplay_tag("Status.Dead.Dying")
    fn transition_to_dead():
        let asc = get_ability_system_component()
        asc.add_loose_gameplay_tag("Status.Dead.Dead")
    # ───────────────────────────────────────────────────────────────────────
    # Initialization State Machine (Lyra Pattern)
    # ───────────────────────────────────────────────────────────────────────
    on BeginPlay():
        initialize_gas_system()
    fn initialize_gas_system():
        let asc = get_ability_system_component()
        # State 1: Spawned
        asc.add_loose_gameplay_tag("InitState.Spawned")
        initialization_state = 1
        # State 2: Data Available
        load_character_data()
        asc.add_loose_gameplay_tag("InitState.DataAvailable")
        initialization_state = 2
        # State 3: Data Initialized
        initialize_attributes()
        grant_abilities()
        asc.add_loose_gameplay_tag("InitState.DataInitialized")
        initialization_state = 3
        # State 4: Gameplay Ready
        asc.add_loose_gameplay_tag("InitState.GameplayReady")
        initialization_state = 4
    # ───────────────────────────────────────────────────────────────────────
    # Movement Mode Tracking (Lyra Pattern)
    # ───────────────────────────────────────────────────────────────────────
    fn on_movement_mode_changed(prev_mode: MovementMode, new_mode: MovementMode):
        let asc = get_ability_system_component()
        # Remove previous movement mode tag
        match prev_mode:
            MovementMode::Walking => asc.remove_loose_gameplay_tag("Status.Movement.Grounded")
            MovementMode::Jumping => asc.remove_loose_gameplay_tag("Status.Movement.Jumping")
            MovementMode::Falling => asc.remove_loose_gameplay_tag("Status.Movement.Falling")
            MovementMode::Swimming => asc.remove_loose_gameplay_tag("Status.Movement.Swimming")
            MovementMode::Flying => asc.remove_loose_gameplay_tag("Status.Movement.Flying")
            MovementMode::Climbing => asc.remove_loose_gameplay_tag("Status.Movement.Climbing")
            _ => {}
        # Add new movement mode tag
        match new_mode:
            MovementMode::Walking => asc.add_loose_gameplay_tag("Status.Movement.Grounded")
            MovementMode::Jumping => asc.add_loose_gameplay_tag("Status.Movement.Jumping")
            MovementMode::Falling => asc.add_loose_gameplay_tag("Status.Movement.Falling")
            MovementMode::Swimming => asc.add_loose_gameplay_tag("Status.Movement.Swimming")
            MovementMode::Flying => asc.add_loose_gameplay_tag("Status.Movement.Flying")
            MovementMode::Climbing => asc.add_loose_gameplay_tag("Status.Movement.Climbing")
            _ => {}
    # ───────────────────────────────────────────────────────────────────────
    # Effect Queries and Removal
    # ───────────────────────────────────────────────────────────────────────
    @blueprint_callable
    fn remove_all_debuffs():
        let asc = get_ability_system_component()
        let debuff_tags = make_tag_container("Status.Debuff")
        let removed_count = asc.remove_active_effects_with_granted_tags(debuff_tags)
        println("Removed {removed_count} debuff effects")
    @blueprint_callable
    fn remove_fire_effects():
        let asc = get_ability_system_component()
        let fire_tags = make_tag_container_from_array(["Effect.Damage.Fire", "Effect.CC.Burn"])
        let removed_count = asc.remove_active_effects_with_tags(fire_tags)
        println("Removed {removed_count} fire effects")
    @blueprint_callable
    fn get_active_effect_count_by_tag(tag: String) -> Int:
        let asc = get_ability_system_component()
        let tag_container = make_tag_container(tag)
        let effects = asc.get_active_effects_with_all_tags(tag_container)
        return effects.length()
    @blueprint_callable
    fn get_effect_duration_remaining(effect_tag: String) -> Float:
        let asc = get_ability_system_component()
        let tag_container = make_tag_container(effect_tag)
        let effects = asc.get_active_effects_with_all_tags(tag_container)
        if effects.length() > 0:
            return asc.get_gameplay_effect_duration(effects[0])
        return 0.0
    @blueprint_callable
    fn has_active_effect_with_tag(tag: String) -> Bool:
        return get_active_effect_count_by_tag(tag) > 0
    # ───────────────────────────────────────────────────────────────────────
    # Attribute Delegates
    # ───────────────────────────────────────────────────────────────────────
    fn bind_attribute_delegates():
        # Bind to health changes
        health_set.on_health_changed.add_dynamic(self, "on_health_changed_delegate")
        health_set.on_out_of_health.add_dynamic(self, "on_out_of_health_delegate")
        # Bind to mana changes
        magic_set.on_mana_changed.add_dynamic(self, "on_mana_changed_delegate")
        magic_set.on_out_of_mana.add_dynamic(self, "on_out_of_mana_delegate")
        # Bind to stamina changes
        stamina_set.on_stamina_changed.add_dynamic(self, "on_stamina_changed_delegate")
        stamina_set.on_out_of_stamina.add_dynamic(self, "on_out_of_stamina_delegate")
    fn on_health_changed_delegate(instigator: Actor, causer: Actor, spec: GameplayEffectSpec, 
                                   magnitude: Float, old_value: Float, new_value: Float):
        println("Health changed: {old_value} -> {new_value}")
        update_health_ui(new_value, max_health)
    fn on_out_of_health_delegate(instigator: Actor, causer: Actor, spec: GameplayEffectSpec,
                                  magnitude: Float, old_value: Float, new_value: Float):
        println("Out of health! Starting death sequence")
        start_death_sequence()
    fn on_mana_changed_delegate(instigator: Actor, causer: Actor, spec: GameplayEffectSpec,
                                magnitude: Float, old_value: Float, new_value: Float):
        update_mana_ui(new_value, magic_set.get_max_mana())
    fn on_out_of_mana_delegate(instigator: Actor, causer: Actor, spec: GameplayEffectSpec,
                               magnitude: Float, old_value: Float, new_value: Float):
        println("Out of mana!")
        show_out_of_mana_warning()
    fn on_stamina_changed_delegate(instigator: Actor, causer: Actor, spec: GameplayEffectSpec,
                                   magnitude: Float, old_value: Float, new_value: Float):
        update_stamina_ui(new_value, stamina_set.get_max_stamina())
    fn on_out_of_stamina_delegate(instigator: Actor, causer: Actor, spec: GameplayEffectSpec,
                                  magnitude: Float, old_value: Float, new_value: Float):
        println("Out of stamina!")
        show_exhausted_effect()
    # ───────────────────────────────────────────────────────────────────────
    # Input Handling
    # ───────────────────────────────────────────────────────────────────────
    fn on_input_pressed(input_tag: String):
        let asc = get_ability_system_component()
        asc.ability_input_tag_pressed(input_tag)
    fn on_input_released(input_tag: String):
        let asc = get_ability_system_component()
        asc.ability_input_tag_released(input_tag)
    on Tick(delta_time: Float):
        let asc = get_ability_system_component()
        asc.process_ability_input(delta_time, false)
# ============================================================================
# SECTION 8: MULTIPLAYER REPLICATION PATTERNS
# ============================================================================
# Demonstrates network prediction, server authority, and replication modes.
# ============================================================================
actor MultiplayerGASCharacter:
    @replicated
    state health: Float = 100.0
    @replicated
    state team_id: Int = 0
    state ability_system_component: AbilitySystemComponent
    on BeginPlay():
        setup_replication()
        initialize_ability_system()
    fn setup_replication():
        # Set replication mode based on role
        if is_locally_controlled():
            ability_system_component.set_replication_mode("Mixed")
        elif is_simulated_proxy():
            ability_system_component.set_replication_mode("Minimal")
        else:
            ability_system_component.set_replication_mode("Full")
    # ───────────────────────────────────────────────────────────────────────
    # Server-Authoritative Abilities
    # ───────────────────────────────────────────────────────────────────────
    on Server_ActivateAbility(ability_tag: String):
        let asc = get_ability_system_component()
        let tag_container = make_tag_container(ability_tag)
        if asc.try_activate_abilities_by_tag(tag_container):
            Multicast_NotifyAbilityActivated(ability_tag)
    on Multicast_NotifyAbilityActivated(ability_tag: String):
        println("Ability activated: {ability_tag}")
        play_ability_visual_effect(ability_tag)
    # ───────────────────────────────────────────────────────────────────────
    # Server-Authoritative Damage
    # ───────────────────────────────────────────────────────────────────────
    on Server_ApplyDamage(target: Actor, damage: Float, damage_type: String):
        if !target:
            return
        let target_asc = get_ability_system_component_from_actor(target)
        if !target_asc:
            return
        # Check if target is alive
        if !target_asc.has_matching_gameplay_tag("Status.Alive"):
            return
        # Check immunity
        let immunity_tag = "Status.Immune." + damage_type
        if target_asc.has_matching_gameplay_tag(immunity_tag):
            Multicast_ShowImmunityEffect(target)
            return
        # Apply damage effect
        let effect_context = ability_system_component.make_effect_context()
        effect_context.add_source_object(self)
        let effect_spec = ability_system_component.make_outgoing_spec(InstantDamageEffect, 1, effect_context)
        effect_spec.set_set_by_caller_magnitude("SetByCaller.Damage.Amount", -damage)
        target_asc.apply_gameplay_effect_spec_to_self(effect_spec)
        Multicast_ShowDamageEffect(target, damage, damage_type)
    on Multicast_ShowDamageEffect(target: Actor, damage: Float, damage_type: String):
        play_damage_visual(target, damage_type)
        spawn_damage_number(target, damage)
    on Multicast_ShowImmunityEffect(target: Actor):
        play_immunity_visual(target)
        show_immune_text(target)
    # ───────────────────────────────────────────────────────────────────────
    # Predicted Abilities (Client Prediction)
    # ───────────────────────────────────────────────────────────────────────
    @blueprint_callable
    fn activate_predicted_ability(ability_tag: String):
        let asc = get_ability_system_component()
        let tag_container = make_tag_container(ability_tag)
        # Client predicts, server confirms
        if asc.try_activate_abilities_by_tag(tag_container):
            if has_authority():
                Multicast_NotifyAbilityActivated(ability_tag)
            else:
                Server_ActivateAbility(ability_tag)
    # ───────────────────────────────────────────────────────────────────────
    # Tag Replication
    # ───────────────────────────────────────────────────────────────────────
    @blueprint_callable
    fn add_replicated_tag(tag: String):
        let asc = get_ability_system_component()
        let gameplay_tag = request_gameplay_tag(tag)
        # Full replication to all clients
        asc.add_loose_gameplay_tag(gameplay_tag, 1, "Full")
    @blueprint_callable
    fn add_owner_only_tag(tag: String):
        let asc = get_ability_system_component()
        let gameplay_tag = request_gameplay_tag(tag)
        # Only replicate to owning client
        asc.add_loose_gameplay_tag(gameplay_tag, 1, "OwnerOnly")
    @blueprint_callable
    fn add_minimal_tag(tag: String):
        let asc = get_ability_system_component()
        let gameplay_tag = request_gameplay_tag(tag)
        # Minimal replication (tag only, no metadata)
        asc.add_loose_gameplay_tag(gameplay_tag, 1, "Minimal")
# ============================================================================
# SECTION 9: GAMEPLAY CUES
# ============================================================================
# Gameplay cues trigger visual and audio effects in response to gameplay events.
# ============================================================================
actor GameplayCueActor:
    state ability_system_component: AbilitySystemComponent
    @blueprint_callable
    fn trigger_impact_cue(impact_type: String, location: Vec3):
        let cue_tag = "GameplayCue.Impact." + impact_type
        execute_gameplay_cue_at_location(cue_tag, location)
    @blueprint_callable
    fn trigger_effect_cue(effect_type: String, target: Actor):
        let cue_tag = "GameplayCue.Effect." + effect_type
        execute_gameplay_cue_on_actor(cue_tag, target)
    @blueprint_callable
    fn trigger_ability_cue(ability_name: String):
        let cue_tag = "GameplayCue.Ability." + ability_name
        execute_gameplay_cue(cue_tag)
    @on_tag_added("Status.Debuff.Burning")
    fn on_burn_applied():
        execute_gameplay_cue("GameplayCue.Effect.Burn.Start")
        start_looping_cue("GameplayCue.Effect.Burn.Loop")
    @on_tag_removed("Status.Debuff.Burning")
    fn on_burn_removed():
        stop_looping_cue("GameplayCue.Effect.Burn.Loop")
        execute_gameplay_cue("GameplayCue.Effect.Burn.End")
# ============================================================================
# SECTION 10: SUPPORTING TYPES
# ============================================================================
enum MovementMode:
    Walking
    Running
    Sprinting
    Crouching
    Jumping
    Falling
    Swimming
    Flying
    Climbing
struct GameplayAttribute:
    attribute_name: String
    owner_set: String
struct GameplayEffectSpec:
    effect_class: String
    level: Float
    duration: Float
struct GameplayEffectModCallbackData:
    evaluated_data: EvaluatedData
    effect_spec: GameplayEffectSpec
    target: Actor
struct EvaluatedData:
    attribute: GameplayAttribute
    magnitude: Float
    modifiers: Array<Float>
struct AttributeEvent:
    instigator: Actor
    causer: Actor
    effect_spec: GameplayEffectSpec
    magnitude: Float
    old_value: Float
    new_value: Float
