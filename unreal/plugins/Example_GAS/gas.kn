@ability
struct DashAbility:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")
    @ability_tags
    tags: ["Ability.Defend.Dodge.Dash"]
    @activation_required_tags
    required: ["Status.Alive", "Status.Movement.Grounded"]
    @activation_blocked_tags
    blocked: ["Status.CC.Stunned", "Status.CC.Rooted", "Status.Dead"]
    @activation_owned_tags
    owned: ["Status.Movement.Dashing", "Status.Immune.CC"]
    @cost
    effect: StaminaCostEffect
    @cooldown
    effect: DashCooldownEffect
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        let character = get_avatar_actor_from_actor_info()
        let dash_direction = get_input_direction()
        character.launch_character(dash_direction * 1000.0)
        apply_gameplay_effect_to_self("DashInvulnerabilityEffect")
        wait_delay(0.3)
        end_ability(handle, actor_info, activation_info, true, false)
# ───────────────────────────────────────────────────────────────────────────
# CHANNELED ABILITIES - Continuous execution until canceled
# ───────────────────────────────────────────────────────────────────────────
@ability
struct FireBeamAbility:
    @instancing(policy: "InstancedPerActor")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")
    @ability_tags
    tags: ["Ability.Channeled.Beam.FireBeam"]
    @activation_required_tags
    required: ["Status.Alive", "Status.Condition.CanCast"]
    @activation_blocked_tags
    blocked: ["Status.CC.Stunned", "Status.CC.Silenced", "Status.Dead"]
    @activation_owned_tags
    owned: ["Status.Channeling", "Status.Casting", "Status.Busy"]
    @block_abilities_with_tag
    block: ["Ability.Attack", "Ability.Defend", "Ability.Utility"]
    @cost
    effect: ManaChannelCostEffect
    @cooldown
    effect: FireBeamCooldownEffect
    state beam_damage_per_second: Float = 50.0
    state beam_range: Float = 1000.0
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        play_montage("Channel_FireBeam")
        apply_gameplay_cue("GameplayCue.Ability.Cast.Channel")
        start_channeling()
    fn on_channel_tick(delta_time: Float):
        let target = get_target_actor()
        if target:
            apply_damage_to_target(target, beam_damage_per_second * delta_time, "Damage.Magical.Fire")
    fn end_ability(handle, actor_info, activation_info, replicate_end, was_cancelled):
        stop_channeling()
        apply_gameplay_cue("GameplayCue.Ability.Cast.End")
@ability
struct MeditationAbility:
    @instancing(policy: "InstancedPerActor")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")
    @ability_tags
    tags: ["Ability.Channeled.Channel.Meditation"]
    @activation_required_tags
    required: ["Status.Alive", "Status.OutOfCombat"]
    @activation_blocked_tags
    blocked: ["Status.CC", "Status.Dead", "Status.InCombat"]
    @activation_owned_tags
    owned: ["Status.Channeling"]
    @cooldown
    effect: MeditationCooldownEffect
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        play_animation("Meditation_Loop")
        apply_gameplay_effect_to_self("MeditationRegenEffect")
    fn end_ability(handle, actor_info, activation_info, replicate_end, was_cancelled):
        stop_animation()
        remove_gameplay_effect_by_tag("Effect.Buff.Meditation")
# ───────────────────────────────────────────────────────────────────────────
# PASSIVE ABILITIES - Auto-activate on avatar set, always active
# ───────────────────────────────────────────────────────────────────────────
@ability
struct PassiveHealthRegenAbility:
    @instancing(policy: "InstancedPerActor")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "ServerOnly")
    @ability_tags
    tags: ["Ability.Passive", "Ability.Passive.Regeneration.HealthRegen"]
    @activation_required_tags
    required: ["Status.Alive"]
    @activation_blocked_tags
    blocked: ["Status.InCombat", "Status.Dead"]
    @activation_owned_tags
    owned: ["Status.Buff.Regeneration"]
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
