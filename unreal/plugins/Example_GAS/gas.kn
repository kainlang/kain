# ============================================================================
# SECTION 2: ATTRIBUTE SETS (5 comprehensive sets)
# ============================================================================
# Attribute sets hold replicated attributes (health, mana, etc.) with automatic
# clamping, replication, and lifecycle hooks for gameplay effect execution.
# ============================================================================
@attribute_set
struct HealthSet:
    @attribute(replicated: true, rep_notify: true, hide_from_modifiers: true)
    health: Float = 100.0
    @attribute(replicated: true, rep_notify: true)
    max_health: Float = 100.0
    @attribute(meta: true)
    healing: Float = 0.0
    @attribute(meta: true, hide_from_modifiers: true)
    damage: Float = 0.0
    @delegate
    on_health_changed: AttributeEvent
    @delegate
    on_max_health_changed: AttributeEvent
    @delegate
    on_out_of_health: AttributeEvent
    fn pre_attribute_change(attribute: GameplayAttribute, new_value: Float):
        if attribute == get_health_attribute():
            new_value = clamp(new_value, 0.0, get_max_health())
        elif attribute == get_max_health_attribute():
            new_value = max(new_value, 1.0)
    fn post_gameplay_effect_execute(data: GameplayEffectModCallbackData):
        let health_before = get_health()
        if data.evaluated_data.attribute == get_damage_attribute():
            let damage_done = get_damage()
            set_health(clamp(get_health() - damage_done, 0.0, get_max_health()))
            set_damage(0.0)
            if damage_done > 0.0:
                on_health_changed.broadcast(data.effect_spec.get_context().get_instigator(), data.effect_spec.get_context().get_effect_causer(), data.effect_spec, damage_done, health_before, get_health())
        elif data.evaluated_data.attribute == get_healing_attribute():
            let healing_done = get_healing()
            set_health(clamp(get_health() + healing_done, 0.0, get_max_health()))
            set_healing(0.0)
            if healing_done > 0.0:
                on_health_changed.broadcast(data.effect_spec.get_context().get_instigator(), data.effect_spec.get_context().get_effect_causer(), data.effect_spec, healing_done, health_before, get_health())
        if get_health() <= 0.0 and health_before > 0.0:
            on_out_of_health.broadcast(data.effect_spec.get_context().get_instigator(), data.effect_spec.get_context().get_effect_causer(), data.effect_spec, 0.0, health_before, 0.0)
@attribute_set
struct CombatSet:
    @attribute(replicated: true, rep_notify: true)
    attack_power: Float = 10.0
    @attribute(replicated: true, rep_notify: true)
    defense: Float = 5.0
    @attribute(replicated: true, rep_notify: true)
    critical_chance: Float = 0.1
    @attribute(replicated: true, rep_notify: true)
    critical_damage: Float = 2.0
    @attribute(replicated: true, rep_notify: true)
    armor: Float = 0.0
    @attribute(replicated: true, rep_notify: true)
    armor_penetration: Float = 0.0
    @attribute(replicated: true, rep_notify: true)
    attack_speed: Float = 1.0
    @attribute(replicated: true, rep_notify: true)
    lifesteal: Float = 0.0
    fn pre_attribute_change(attribute: GameplayAttribute, new_value: Float):
        if attribute == get_critical_chance_attribute():
            new_value = clamp(new_value, 0.0, 1.0)
        elif attribute == get_critical_damage_attribute():
            new_value = max(new_value, 1.0)
        elif attribute == get_armor_attribute():
            new_value = max(new_value, 0.0)
        elif attribute == get_attack_speed_attribute():
            new_value = clamp(new_value, 0.1, 5.0)
        elif attribute == get_lifesteal_attribute():
            new_value = clamp(new_value, 0.0, 1.0)
@attribute_set
struct MovementSet:
    @attribute(replicated: true, rep_notify: true)
    movement_speed: Float = 600.0
    @attribute(replicated: true, rep_notify: true)
    max_movement_speed: Float = 1000.0
    @attribute(replicated: true, rep_notify: true)
    jump_height: Float = 500.0
    @attribute(replicated: true, rep_notify: true)
    acceleration: Float = 2048.0
    @attribute(replicated: true, rep_notify: true)
    friction: Float = 8.0
    @attribute(replicated: true, rep_notify: true)
    gravity_scale: Float = 1.0
    fn pre_attribute_change(attribute: GameplayAttribute, new_value: Float):
        if attribute == get_movement_speed_attribute():
            new_value = clamp(new_value, 0.0, get_max_movement_speed())
        elif attribute == get_max_movement_speed_attribute():
            new_value = max(new_value, 100.0)
        elif attribute == get_jump_height_attribute():
            new_value = max(new_value, 0.0)
        elif attribute == get_gravity_scale_attribute():
            new_value = clamp(new_value, 0.0, 10.0)
@attribute_set
struct MagicSet:
    @attribute(replicated: true, rep_notify: true, hide_from_modifiers: true)
    mana: Float = 100.0
    @attribute(replicated: true, rep_notify: true)
    max_mana: Float = 100.0
    @attribute(replicated: true, rep_notify: true)
    mana_regen: Float = 5.0
    @attribute(replicated: true, rep_notify: true)
    spell_power: Float = 10.0
    @attribute(replicated: true, rep_notify: true)
    cooldown_reduction: Float = 0.0
    @attribute(replicated: true, rep_notify: true)
    cast_speed: Float = 1.0
    @attribute(meta: true)
    mana_cost: Float = 0.0
    @delegate
    on_mana_changed: AttributeEvent
    @delegate
    on_out_of_mana: AttributeEvent
    fn pre_attribute_change(attribute: GameplayAttribute, new_value: Float):
        if attribute == get_mana_attribute():
            new_value = clamp(new_value, 0.0, get_max_mana())
        elif attribute == get_max_mana_attribute():
            new_value = max(new_value, 1.0)
        elif attribute == get_cooldown_reduction_attribute():
            new_value = clamp(new_value, 0.0, 0.8)
        elif attribute == get_cast_speed_attribute():
            new_value = clamp(new_value, 0.1, 5.0)
    fn post_gameplay_effect_execute(data: GameplayEffectModCallbackData):
        let mana_before = get_mana()
        if data.evaluated_data.attribute == get_mana_cost_attribute():
            let cost = get_mana_cost()
            set_mana(clamp(get_mana() - cost, 0.0, get_max_mana()))
            set_mana_cost(0.0)
            if cost > 0.0:
                on_mana_changed.broadcast(data.effect_spec.get_context().get_instigator(), data.effect_spec.get_context().get_effect_causer(), data.effect_spec, cost, mana_before, get_mana())
        if get_mana() <= 0.0 and mana_before > 0.0:
            on_out_of_mana.broadcast(data.effect_spec.get_context().get_instigator(), data.effect_spec.get_context().get_effect_causer(), data.effect_spec, 0.0, mana_before, 0.0)
@attribute_set
struct StaminaSet:
    @attribute(replicated: true, rep_notify: true, hide_from_modifiers: true)
    stamina: Float = 100.0
    @attribute(replicated: true, rep_notify: true)
    max_stamina: Float = 100.0
    @attribute(replicated: true, rep_notify: true)
    stamina_regen: Float = 10.0
    @attribute(meta: true)
    stamina_cost: Float = 0.0
    @delegate
    on_stamina_changed: AttributeEvent
    @delegate
    on_out_of_stamina: AttributeEvent
    fn pre_attribute_change(attribute: GameplayAttribute, new_value: Float):
        if attribute == get_stamina_attribute():
            new_value = clamp(new_value, 0.0, get_max_stamina())
        elif attribute == get_max_stamina_attribute():
            new_value = max(new_value, 1.0)
    fn post_gameplay_effect_execute(data: GameplayEffectModCallbackData):
        let stamina_before = get_stamina()
        if data.evaluated_data.attribute == get_stamina_cost_attribute():
            let cost = get_stamina_cost()
            set_stamina(clamp(get_stamina() - cost, 0.0, get_max_stamina()))
            set_stamina_cost(0.0)
            if cost > 0.0: on_stamina_changed.broadcast(data.effect_spec.get_context().get_instigator(), data.effect_spec.get_context().get_effect_causer(), data.effect_spec, cost, stamina_before, get_stamina())
        if get_stamina() <= 0.0 and stamina_before > 0.0: on_out_of_stamina.broadcast(data.effect_spec.get_context().get_instigator(), data.effect_spec.get_context().get_effect_causer(), data.effect_spec, 0.0, stamina_before, 0.0)
# ============================================================================
# SECTION 3: GAMEPLAY ABILITIES (20+ abilities)
# ============================================================================
# Abilities define player actions with activation requirements, costs, cooldowns,
# and tag-based logic. Supports instant, channeled, and passive abilities.
# ============================================================================
# ───────────────────────────────────────────────────────────────────────────
# INSTANT ABILITIES - Execute immediately and end
# ───────────────────────────────────────────────────────────────────────────
@ability
struct JumpAbility:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")
    @net_security(policy: "ClientOrServer")
    @ability_tags
    tags: ["Ability.Utility.Movement.Jump"]
    @activation_required_tags
    required: ["Status.Alive", "Status.Movement.Grounded"]
    @activation_blocked_tags
    blocked: ["Status.CC.Stunned", "Status.CC.Rooted", "Status.Dead"]
    @activation_owned_tags
    owned: ["Status.Movement.Jumping"]
    @block_abilities_with_tag
    block: ["Ability.Utility.Movement.Sprint"]
    @cost
    effect: StaminaCostEffect
    @cooldown
    effect: JumpCooldownEffect
    fn can_activate_ability(handle, actor_info, source_tags, target_tags) -> Bool:
        if !has_stamina(actor_info, 10.0):
            return false
        return true
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        let character = get_avatar_actor_from_actor_info()
        character.jump()
        end_ability(handle, actor_info, activation_info, true, false)
@ability
struct MeleeAttackAbility:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")
    @ability_tags
    tags: ["Ability.Attack.Melee.Sword.Light"]
    @activation_required_tags
    required: ["Status.Alive"]
    @activation_blocked_tags
    blocked: ["Status.CC.Stunned", "Status.CC.Disarmed", "Status.Dead"]
    @activation_owned_tags
    owned: ["Status.Attacking", "Status.Busy"]
    @block_abilities_with_tag
    block: ["Ability.Attack", "Ability.Defend"]
    @cancel_abilities_with_tag
    cancel: ["Ability.Channeled"]
    @cost
    effect: StaminaCostEffect
    @cooldown
    effect: MeleeAttackCooldownEffect
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        play_montage("Attack_Melee_Light")
        apply_damage_to_target(25.0, "Damage.Physical.Slash")
        end_ability(handle, actor_info, activation_info, true, false)
@ability
struct FireballAbility:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")
    @ability_tags
    tags: ["Ability.Attack.Ranged.Magic.Fireball"]
    @activation_required_tags
    required: ["Status.Alive", "Status.Condition.CanCast"]
    @activation_blocked_tags
    blocked: ["Status.CC.Stunned", "Status.CC.Silenced", "Status.Dead", "Status.Condition.OutOfMana"]
    @activation_owned_tags
    owned: ["Status.Casting", "Status.Busy"]
    @cost
    effect: ManaCostEffect
    @cooldown
    effect: FireballCooldownEffect
    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        if !commit_ability(handle, actor_info, activation_info):
            end_ability(handle, actor_info, activation_info, true, true)
            return
        play_montage("Cast_Fireball")
        spawn_projectile("BP_Fireball", get_forward_vector())
        apply_gameplay_cue("GameplayCue.Ability.Cast.Start")
        end_ability(handle, actor_info, activation_info, true, false)
@ability
