    limit: 10
    duration_policy: "NeverRefresh"
    @owned_tags
    tags: ["Effect.Damage.DOT", "Effect.Type.Periodic"]
    @granted_tags
    tags: ["Status.Debuff.Poisoned", "Status.Debuff"]
    @application_tag_requirements
    require: ["Status.Alive"]
    ignore: ["Status.Immune.Poison"]
    @gameplay_cues
    cues: ["GameplayCue.Effect.Poison.Start", "GameplayCue.Effect.Poison.Loop", "GameplayCue.Effect.Poison.End"]
