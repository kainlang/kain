# ============================================================================
# SECTION 8: NIAGARA INTEGRATION UTILITIES
# ============================================================================

# GetCloneCountForNiagara - Returns the total number of clones in the actor
# Used by Niagara Data Interface for CPU execution (VectorVM)
@blueprint
fn GetCloneCountForNiagara() -> Int:
    # Return the cached instance count from the actor
    # This is called per-particle in Niagara, so must be fast
    # In UE5, this would access actor->GetInstanceCount()
    return 0

# GetCloneTransformForNiagara - Returns position, rotation, scale for a clone
# Used by Niagara Data Interface for CPU execution (VectorVM)
# Returns position as Vec3 (will be converted to FVector in codegen)
@blueprint
fn GetCloneTransformForNiagara(index: Int) -> Vec3:
    # Validate index bounds
    # In UE5, this would access actor->GetCachedTransforms()[index]
    # For now, return zero vector
    return vec3(0.0, 0.0, 0.0)

# GetCloneRotationForNiagara - Returns rotation quaternion for a clone
# Used by Niagara Data Interface for CPU execution (VectorVM)
# Returns Vec4 representing quaternion (x, y, z, w)
@blueprint
fn GetCloneRotationForNiagara(index: Int) -> Vec4:
    # Validate index bounds
    # In UE5, this would access actor->GetCachedTransforms()[index].GetRotation()
    # For now, return identity quaternion
    return vec4(0.0, 0.0, 0.0, 1.0)

# GetCloneScaleForNiagara - Returns scale for a clone
# Used by Niagara Data Interface for CPU execution (VectorVM)
@blueprint
fn GetCloneScaleForNiagara(index: Int) -> Vec3:
    # Validate index bounds
    # In UE5, this would access actor->GetCachedTransforms()[index].GetScale3D()
    # For now, return unit scale
    return vec3(1.0, 1.0, 1.0)

# GetCloneColorForNiagara - Returns color for a clone
# Used by Niagara Data Interface for CPU execution (VectorVM)
# Returns Vec3 representing RGB color (alpha is always 1.0)
@blueprint
fn GetCloneColorForNiagara(index: Int) -> Vec3:
    # Validate index bounds
    # In UE5, this would access actor->GetCachedInstanceData()[index]
    # For now, return white
    return vec3(1.0, 1.0, 1.0)

# ============================================================================
# GPU EXECUTION NOTES (for KAIN codegen)
# ============================================================================
# The Niagara Data Interface also supports GPU execution via compute shaders.
# KAIN will generate the following HLSL shader code automatically:
#
# SHADER PARAMETERS:
#   - int InstanceCount
#   - Buffer<float3> PositionBuffer
#   - Buffer<float4> RotationBuffer
#   - Buffer<float3> ScaleBuffer
#   - Buffer<float4> ColorBuffer
#
# HLSL FUNCTIONS:
#   - void GetCloneCount(out int OutCount)
#   - void GetCloneTransform(int Index, out float3 OutPos, out float4 OutRot, out float3 OutScale)
#   - void GetCloneColor(int Index, out float4 OutColor)
#
# GPU BUFFER MANAGEMENT:
#   - Buffers are populated on the render thread via ProvidePerInstanceDataForRenderThread()
#   - Data is copied from game thread (GetCachedTransforms/GetCachedInstanceData)
#   - Buffers use FReadBuffer with appropriate pixel formats (PF_R32G32B32F, PF_A32B32G32R32F)
#   - Shader Resource Views (SRVs) are bound via SetShaderParameters()
#
# RENDER THREAD SYNCHRONIZATION:
#   - FKClonerDataInterfaceProxy manages render thread state
#   - ConsumePerInstanceDataFromGameThread() updates GPU buffers
#   - BuildShaderParameters() defines shader parameter structure
#   - SetShaderParameters() binds buffers to shader
#
# NIAGARA INTEGRATION:
#   - GetFunctions() registers available functions with Niagara
#   - GetVMExternalFunction() binds CPU implementations
#   - GetParameterDefinitionHLSL() defines GPU shader parameters
#   - GetFunctionHLSL() generates GPU shader function implementations
#   - CanExecuteOnTarget() returns true for both CPU and GPU
#
# USAGE IN NIAGARA:
#   1. Add "K-Cloner Data Interface" to Niagara system
#   2. Set ClonerActor reference in the data interface
#   3. Call GetCloneCount() to get total instance count
#   4. Call GetCloneTransform(Index) to get position/rotation/scale
#   5. Call GetCloneColor(Index) to get color
#   6. Use in particle spawn/update modules for procedural effects
#
# PERFORMANCE CONSIDERATIONS:
#   - CPU execution: Fast lookup from cached arrays
#   - GPU execution: Parallel access to GPU buffers (millions of particles)
#   - Buffers are updated only when instance data changes
#   - Bounds checking prevents out-of-range access
# ============================================================================
