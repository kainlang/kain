# ============================================================================
# CINEMA4D MOGRAPH - Blueprint Utilities
# ============================================================================
# Blueprint-callable utility functions for the mograph system
# ============================================================================

# ============================================================================
# SECTION 1: DISTRIBUTION UTILITIES
# ============================================================================

@blueprint
fn CalculateGridPosition(index: Int, grid_count: Vec3, grid_spacing: Vec3) -> Vec3:
    let grid_x = int(grid_count.x)
    let grid_y = int(grid_count.y)
    let grid_xy = grid_x * grid_y
    
    let x = index % grid_x
    let y = (index / grid_x) % grid_y
    let z = index / grid_xy
    
    return vec3(
        float(x) * grid_spacing.x,
        float(y) * grid_spacing.y,
        float(z) * grid_spacing.z
    )

@blueprint
fn CalculateRadialPosition(index: Int, count: Int, radius: Float) -> Vec3:
    let angle = (float(index) / float(count)) * 6.28318  # 2 * PI
    let x = cos(angle) * radius
    let y = sin(angle) * radius
    return vec3(x, y, 0.0)

@blueprint
fn CalculateHoneycombPosition(index: Int, count_x: Int, count_y: Int, size: Float) -> Vec3:
    let x = index % count_x
    let y = index / count_x
    
    var offset_x = float(x) * size * 1.5
    let offset_y = float(y) * size * 0.866  # sqrt(3)/2
    
    # Offset every other row
    if y % 2 == 1:
        offset_x = offset_x + size * 0.75
    
    return vec3(offset_x, offset_y, 0.0)

# ============================================================================
# SECTION 2: EFFECTOR UTILITIES
# ============================================================================

@blueprint
fn CalculateEffectorInfluence(distance: Float, radius: Float, falloff: Float, invert: Bool) -> Float:
    if distance > radius:
        if invert:
            return 1.0
        else:
            return 0.0
    
    # Calculate normalized distance
    let normalized = distance / radius
    
    # Apply falloff curve
    var influence = 1.0 - normalized
    
    # Apply falloff power
    if falloff > 0.0:
        influence = pow(influence, 1.0 / falloff)
    
    # Invert if needed
    if invert:
        influence = 1.0 - influence
    
    return clamp(influence, 0.0, 1.0)

@blueprint
fn CalculateSphereEffectorInfluence(position: Vec3, effector_pos: Vec3, radius: Float, falloff: Float, invert: Bool) -> Float:
    let distance = length(position - effector_pos)
    return CalculateEffectorInfluence(distance, radius, falloff, invert)

@blueprint
fn CalculateBoxEffectorInfluence(position: Vec3, effector_pos: Vec3, extent: Vec3, falloff: Float, invert: Bool) -> Float:
    let local_pos = position - effector_pos
    let abs_pos = vec3(abs(local_pos.x), abs(local_pos.y), abs(local_pos.z))
    
    # Distance from box surface
    let distance = max(
        max(abs_pos.x - extent.x, abs_pos.y - extent.y),
        abs_pos.z - extent.z
    )
    
    if distance > 0.0:
        if invert:
            return 1.0
        else:
            return 0.0
    
    # Inside box - calculate distance to nearest face
    let dist_to_face = min(
        min(extent.x - abs_pos.x, extent.y - abs_pos.y),
        extent.z - abs_pos.z
    )
    
    let max_dist = min(min(extent.x, extent.y), extent.z)
    let normalized = dist_to_face / max_dist
    
    var influence = normalized
    if falloff > 0.0:
        influence = pow(influence, 1.0 / falloff)
    
    if invert:
        influence = 1.0 - influence
    
    return clamp(influence, 0.0, 1.0)

@blueprint
fn CalculateTorusEffectorInfluence(position: Vec3, effector_pos: Vec3, major_radius: Float, minor_radius: Float, falloff: Float, invert: Bool) -> Float:
    let local_pos = position - effector_pos
    let xy_dist = sqrt(local_pos.x * local_pos.x + local_pos.y * local_pos.y)
    let torus_dist = sqrt((xy_dist - major_radius) * (xy_dist - major_radius) + local_pos.z * local_pos.z)
    
    return CalculateEffectorInfluence(torus_dist, minor_radius, falloff, invert)

# ============================================================================
# SECTION 3: EASING UTILITIES
# ============================================================================

@blueprint
fn ApplyEasing(t: Float, easing: Int) -> Float:
    let clamped = clamp(t, 0.0, 1.0)
    
    # Linear
    if easing == 0:
        return clamped
    
    # EaseIn
    if easing == 1:
        return clamped * clamped
    
    # EaseOut
    if easing == 2:
        return 1.0 - (1.0 - clamped) * (1.0 - clamped)
    
    # EaseInOut
    if easing == 3:
        if clamped < 0.5:
            return 2.0 * clamped * clamped
        else:
            return 1.0 - 2.0 * (1.0 - clamped) * (1.0 - clamped)
    
    # Bounce
    if easing == 4:
        let n1 = 7.5625
        let d1 = 2.75
        
        if clamped < 1.0 / d1:
            return n1 * clamped * clamped
        else if clamped < 2.0 / d1:
            let t2 = clamped - 1.5 / d1
            return n1 * t2 * t2 + 0.75
        else if clamped < 2.5 / d1:
            let t2 = clamped - 2.25 / d1
            return n1 * t2 * t2 + 0.9375
        else:
            let t2 = clamped - 2.625 / d1
            return n1 * t2 * t2 + 0.984375
    
    # Elastic
    if easing == 5:
        let c4 = 6.28318 / 3.0  # 2 * PI / 3
        if clamped == 0.0:
            return 0.0
        if clamped == 1.0:
            return 1.0
        return pow(2.0, -10.0 * clamped) * sin((clamped * 10.0 - 0.75) * c4) + 1.0
    
    # Back
    if easing == 6:
        let c1 = 1.70158
        let c3 = c1 + 1.0
        return c3 * clamped * clamped * clamped - c1 * clamped * clamped
    
    return clamped

# ============================================================================
# SECTION 4: TRANSFORM UTILITIES
# ============================================================================

@blueprint
fn BlendTransforms(a: Vec3, b: Vec3, alpha: Float) -> Vec3:
    return vec3(
        a.x + (b.x - a.x) * alpha,
        a.y + (b.y - a.y) * alpha,
        a.z + (b.z - a.z) * alpha
    )

@blueprint
fn RotateVectorAroundAxis(vector: Vec3, axis: Vec3, angle_rad: Float) -> Vec3:
    let cos_angle = cos(angle_rad)
    let sin_angle = sin(angle_rad)
    let one_minus_cos = 1.0 - cos_angle
    
    let normalized_axis = normalize(axis)
    let x = normalized_axis.x
    let y = normalized_axis.y
    let z = normalized_axis.z
    
    # Rodrigues' rotation formula
    let rotated_x = (cos_angle + x * x * one_minus_cos) * vector.x + (x * y * one_minus_cos - z * sin_angle) * vector.y + (x * z * one_minus_cos + y * sin_angle) * vector.z
    
    let rotated_y = (y * x * one_minus_cos + z * sin_angle) * vector.x + (cos_angle + y * y * one_minus_cos) * vector.y + (y * z * one_minus_cos - x * sin_angle) * vector.z
    
    let rotated_z = (z * x * one_minus_cos - y * sin_angle) * vector.x + (z * y * one_minus_cos + x * sin_angle) * vector.y + (cos_angle + z * z * one_minus_cos) * vector.z
    
    return vec3(rotated_x, rotated_y, rotated_z)

# ============================================================================
# SECTION 5: NOISE UTILITIES
# ============================================================================

@blueprint
fn SimplexNoise3D(x: Float, y: Float, z: Float) -> Float:
    # Simplified 3D noise (not true simplex, but fast approximation)
    let sin_x = sin(x * 12.9898 + y * 78.233 + z * 37.719)
    let sin_y = sin(y * 12.9898 + z * 78.233 + x * 37.719)
    let sin_z = sin(z * 12.9898 + x * 78.233 + y * 37.719)
    
    let noise = fract(sin_x * 43758.5453 + sin_y * 22578.1459 + sin_z * 19134.1032)
    return noise * 2.0 - 1.0

@blueprint
fn PerlinNoise3D(x: Float, y: Float, z: Float, frequency: Float) -> Float:
    let fx = x * frequency
    let fy = y * frequency
    let fz = z * frequency
    
    # Sample at multiple octaves
    var result = 0.0
    var amplitude = 1.0
    var total_amplitude = 0.0
    
    # Manual loop unrolling (KAIN doesn't support range() yet)
    var octave = 0
    let scale0 = pow(2.0, float(octave))
    result = result + SimplexNoise3D(fx * scale0, fy * scale0, fz * scale0) * amplitude
    total_amplitude = total_amplitude + amplitude
    amplitude = amplitude * 0.5
    
    octave = 1
    let scale1 = pow(2.0, float(octave))
    result = result + SimplexNoise3D(fx * scale1, fy * scale1, fz * scale1) * amplitude
    total_amplitude = total_amplitude + amplitude
    amplitude = amplitude * 0.5
    
    octave = 2
    let scale2 = pow(2.0, float(octave))
    result = result + SimplexNoise3D(fx * scale2, fy * scale2, fz * scale2) * amplitude
    total_amplitude = total_amplitude + amplitude
    amplitude = amplitude * 0.5
    
    return result / total_amplitude

@blueprint
fn CurlNoise3D(x: Float, y: Float, z: Float, frequency: Float) -> Vec3:
    # Curl noise for fluid-like motion
    let eps = 0.01
    
    # Sample noise at offset positions
    let n1 = PerlinNoise3D(x, y + eps, z, frequency)
    let n2 = PerlinNoise3D(x, y - eps, z, frequency)
    let n3 = PerlinNoise3D(x, y, z + eps, frequency)
    let n4 = PerlinNoise3D(x, y, z - eps, frequency)
    let n5 = PerlinNoise3D(x + eps, y, z, frequency)
    let n6 = PerlinNoise3D(x - eps, y, z, frequency)
    
    # Calculate curl
    let curl_x = (n3 - n4) - (n1 - n2)
    let curl_y = (n5 - n6) - (n3 - n4)
    let curl_z = (n1 - n2) - (n5 - n6)
    
    return vec3(curl_x, curl_y, curl_z) / (2.0 * eps)

# ============================================================================
# SECTION 6: COLOR UTILITIES
# ============================================================================

@blueprint
fn HSVtoRGB(h: Float, s: Float, v: Float) -> Vec3:
    let c = v * s
    let x = c * (1.0 - abs(fract(h / 60.0) * 2.0 - 1.0))
    let m = v - c
    
    var r = 0.0
    var g = 0.0
    var b = 0.0
    
    if h < 60.0:
        r = c
        g = x
        b = 0.0
    else if h < 120.0:
        r = x
        g = c
        b = 0.0
    else if h < 180.0:
        r = 0.0
        g = c
        b = x
    else if h < 240.0:
        r = 0.0
        g = x
        b = c
    else if h < 300.0:
        r = x
        g = 0.0
        b = c
    else:
        r = c
        g = 0.0
        b = x
    
    return vec3(r + m, g + m, b + m)

@blueprint
fn GetRainbowColor(t: Float) -> Vec3:
    let hue = fract(t) * 360.0
    return HSVtoRGB(hue, 1.0, 1.0)

@blueprint
fn GetHeatmapColor(t: Float) -> Vec3:
    let clamped = clamp(t, 0.0, 1.0)
    
    # Black -> Blue -> Cyan -> Green -> Yellow -> Red -> White
    if clamped < 0.25:
        let alpha = clamped / 0.25
        return vec3(0.0, 0.0, alpha)
    else if clamped < 0.5:
        let alpha = (clamped - 0.25) / 0.25
        return vec3(0.0, alpha, 1.0)
    else if clamped < 0.75:
        let alpha = (clamped - 0.5) / 0.25
        return vec3(alpha, 1.0, 1.0 - alpha)
    else:
        let alpha = (clamped - 0.75) / 0.25
        return vec3(1.0, 1.0 - alpha, 0.0)

# ============================================================================
# SECTION 7: MATH UTILITIES
# ============================================================================

@blueprint
fn Remap(value: Float, in_min: Float, in_max: Float, out_min: Float, out_max: Float) -> Float:
    let normalized = (value - in_min) / (in_max - in_min)
    return out_min + normalized * (out_max - out_min)

@blueprint
fn SmoothStep(edge0: Float, edge1: Float, x: Float) -> Float:
    let t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)

@blueprint
fn InverseLerp(a: Float, b: Float, value: Float) -> Float:
    return (value - a) / (b - a)

@blueprint
fn PingPong(t: Float, length: Float) -> Float:
    let cycle = fract(t / (length * 2.0))
    if cycle < 0.5:
        return cycle * 2.0 * length
    else:
        return (1.0 - cycle) * 2.0 * length

