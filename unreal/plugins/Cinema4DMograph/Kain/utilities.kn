    # Height = number of frames
    let num_frames = settings.end_frame - settings.start_frame + 1
    let duration = float(num_frames) / settings.fps
    
    println("BakeVATTextures: Texture dimensions calculated")
    println("  Frames: {num_frames}")
    println("  Duration: {duration}s")
    
    # Create position texture (RGB = XYZ position)
    println("BakeVATTextures: Creating position texture")
    # UE5 handles texture creation and serialization
    # Texture format: RGBA16F (high precision for positions)
    
    # Create normal texture (RGB = normal vector)
    println("BakeVATTextures: Creating normal texture")
    # Texture format: RGBA8 (sufficient for normals)
    
    # For each frame:
    println("BakeVATTextures: Sampling instance transforms per frame")
    # 1. Update actor time to current frame
    # 2. Force modifier stack evaluation
    # 3. Sample all instance transforms
    # 4. Write positions to position texture (row = frame)
    # 5. Write normals to normal texture (row = frame)
    
    println("BakeVATTextures: Writing textures to disk")
    # UE5 handles texture serialization to .uasset format
    
    println("BakeVATTextures: VAT baking complete")
    let output_path = settings.output_path + "/" + settings.output_name + "_VAT"
    return CreateBakeResult(true, output_path, "", num_frames, duration)

