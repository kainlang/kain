@blueprint
fn SaveModifierPreset(preset_name: String) -> Bool:
    # Saves the current modifier stack configuration to a preset
    # This captures all modifier types, parameters, and ordering
    # In UE5, this would get the selected actor from the editor context
    
    println("Saving modifier preset: {preset_name}")
    
    # Validation
    if preset_name == "":
        println("Error: Preset name cannot be empty")
        return false
    
    # In UE5, this would:
    # 1. Create a new UDataAsset of type ModifierPresetData
    # 2. Serialize all modifier properties
    # 3. Save to Content/Presets/ folder
    # 4. Register with AssetRegistry
    
    # For now, log the operation
    println("Preset saved successfully: {preset_name}")
    return true

@blueprint
fn LoadModifierPreset(preset: ModifierPresetData) -> Bool:
    # Loads a modifier preset and applies it to the actor
    # This replaces the current modifier stack
    
    println("Loading modifier preset: {preset.modifier_name}")
    
    # Validation
    if preset.modifier_type == "":
        println("Error: Invalid preset data")
        return false
    
    # In UE5, this would:
    # 1. Clear existing modifiers (optional)
    # 2. Deserialize preset data
    # 3. Create modifier instances
    # 4. Apply parameters
    # 5. Rebuild instance transforms
    
    println("Preset loaded successfully")
    return true

@blueprint
fn ApplyPresetToActor(preset: ModifierPresetData) -> Bool:
    # Applies a preset to an actor without clearing existing modifiers
    # This adds the preset modifiers to the stack
    
    println("Applying preset to actor: {preset.modifier_name}")
    
    # Validation
    if preset.modifier_type == "":
        println("Error: Invalid preset data")
        return false
    
    # In UE5, this would:
    # 1. Deserialize preset data
    # 2. Create new modifier instance
    # 3. Add to modifier stack
    # 4. Apply parameters
    # 5. Rebuild instance transforms
    
    println("Preset applied successfully")
    return true

@blueprint
fn ValidateExpressionPreset(preset: ExpressionModifierPreset) -> Bool:
    # Validates that all expressions in a preset are syntactically correct
    # This prevents runtime errors from malformed expressions
    
    println("Validating expression preset: {preset.display_name}")
    
    # Check for empty expressions
    let has_position = preset.position_expression != ""
    let has_rotation = preset.rotation_expression != ""
    let has_scale = preset.scale_expression != ""
    
    if not(has_position) and not(has_rotation) and not(has_scale):
        println("Error: Preset must have at least one expression")
        return false
    
    # In UE5, this would:
    # 1. Parse each expression with FKClonerExpressionEvaluator
    # 2. Check for syntax errors
    # 3. Validate variable references (v0, v1, etc.)
    # 4. Check for undefined functions
    # 5. Return detailed error messages
    
    # For now, basic validation
    println("Expression preset validated successfully")
    return true

@blueprint
fn GetPresetVariableValue(preset: ExpressionModifierPreset, variable_index: Int) -> Float:
    # Gets the default value for a preset variable by index
    # Used when applying presets to initialize sliders
    
    if variable_index == 0:
        return preset.variable_0_default
    else if variable_index == 1:
        return preset.variable_1_default
    else if variable_index == 2:
        return preset.variable_2_default
    
    return 0.0

@blueprint
fn GetPresetVariableName(preset: ExpressionModifierPreset, variable_index: Int) -> String:
    # Gets the name for a preset variable by index
    # Used when building UI sliders
    
    if variable_index == 0:
        return preset.variable_0_name
    else if variable_index == 1:
        return preset.variable_1_name
    else if variable_index == 2:
        return preset.variable_2_name
    
    return "Parameter"

# ============================================================================
# SECTION 9: SEQUENCER INTEGRATION UTILITIES
# ============================================================================

@blueprint
fn KeyModifierProperty(property_name: String, time: Float) -> Bool:
    # Keys a single modifier property at the specified time in Sequencer
    # This creates a keyframe on the active Sequencer track
    
    println("Keying property '{property_name}' at time {time}")
    
    # Validation
    if property_name == "":
        println("Error: Property name cannot be empty")
        return false
    
    # In UE5, this would:
    # 1. Get the active LevelSequence from the Sequencer
    # 2. Find or create a UMovieSceneKClonerModifierTrack for this actor
    # 3. Find or create a UMovieSceneKClonerModifierSection
    # 4. Find the property channel (Float, Bool, or Vector)
    # 5. Add a keyframe at the specified time with the current value
    # 6. Mark the sequence as modified
    
    # Note: UE5 handles all the track binding and channel management
    # We just need to call the Sequencer API
    
    println("Property keyed successfully")
    return true

@blueprint
fn KeyAllModifierProperties(time: Float) -> Bool:
    # Keys all interpolatable properties of all modifiers at the specified time
    # This is the "Quick Key All" functionality
    
    println("Keying all modifier properties at time {time}")
    
    # In UE5, this would:
    # 1. Iterate through all modifiers in the actor's stack
    # 2. For each modifier, find all UPROPERTY marked as Interp
    # 3. Key each property using KeyModifierProperty()
    # 4. Properties typically include:
    #    - Influence (Float)
    #    - Speed (Float)
    #    - Enabled (Bool)
    #    - Position/Rotation/Scale offsets (Vector)
    #    - Modifier-specific parameters (Float)
    
    # Example properties that would be keyed:
    # - OrbitModifier: Influence, Speed, Radius, Axis
    # - FloatModifier: Influence, Speed, Amplitude, Frequency
    # - PulseModifier: Influence, Speed, Scale, Frequency
    # - WaveModifier: Influence, Speed, Amplitude, Wavelength, Direction
    
    println("All properties keyed successfully")
    return true

@blueprint
fn GetSequencerTime() -> Float:
    # Gets the current playhead time from the active Sequencer
    # Returns 0.0 if no Sequencer is open
    
    # In UE5, this would:
    # 1. Get the active LevelSequence from ISequencer
    # 2. Get the current playback position (FFrameTime)
    # 3. Convert to seconds using the sequence's TickResolution
    # 4. Return the time value
    
    # For now, return a placeholder
    return 0.0

@blueprint
fn IsSequencerOpen() -> Bool:
    # Checks if a Sequencer window is currently open
    # Used to enable/disable keyframing UI
    
    # In UE5, this would:
    # 1. Query ISequencer module
    # 2. Check if any Sequencer instances are active
    # 3. Return true if at least one is open
    
    # For now, return false
    return false

@blueprint
fn KeyModifierPropertyAtCurrentTime(property_name: String) -> Bool:
    # Convenience function that keys a property at the current Sequencer playhead
    # This is what the "Quick Key" buttons call
    
    if not(IsSequencerOpen()):
        println("Error: No Sequencer is open")
        return false
    
    let current_time = GetSequencerTime()
    return KeyModifierProperty(property_name, current_time)

@blueprint
fn KeyAllModifierPropertiesAtCurrentTime() -> Bool:
    # Convenience function that keys all properties at the current Sequencer playhead
    # This is what the "Key All" buttons call
    
    if not(IsSequencerOpen()):
        println("Error: No Sequencer is open")
        return false
    
    let current_time = GetSequencerTime()
    return KeyAllModifierProperties(current_time)

@blueprint
fn GetModifierPropertyValue(modifier_index: Int, property_name: String) -> Float:
    # Gets the current value of a modifier property
    # Used when creating keyframes to capture the current state
    
    println("Getting property value: modifier {modifier_index}, property '{property_name}'")
    
    # In UE5, this would:
    # 1. Get the modifier at the specified index
    # 2. Use reflection (FProperty) to find the property by name
    # 3. Read the property value
    # 4. Convert to Float (or handle Bool/Vector separately)
    
    # For now, return a placeholder
    return 1.0

@blueprint
fn SetModifierPropertyValue(modifier_index: Int, property_name: String, value: Float) -> Bool:
    # Sets the value of a modifier property
    # Used by Sequencer evaluation to apply keyframe values
    
    println("Setting property value: modifier {modifier_index}, property '{property_name}' = {value}")
    
    # In UE5, this would:
    # 1. Get the modifier at the specified index
    # 2. Use reflection (FProperty) to find the property by name
    # 3. Write the property value
    # 4. Mark the actor as dirty to trigger rebuild
    
    # Note: This is called by the Sequencer evaluation template
    # (FKClonerModifierSectionTemplate::Evaluate) during playback
    
    println("Property value set successfully")
    return true

# ============================================================================
# SECTION 10: ANIMATION BAKING UTILITIES
# ============================================================================
# Animation baking system for converting modifier motion into AnimSequences
# Supports VAT (Vertex Animation Texture) baking and skeletal mesh baking
# ============================================================================

# Bake Settings - Configuration for animation baking
struct BakeSettings:
    start_frame: Int
    end_frame: Int
    fps: Float
    output_path: String
    output_name: String
    bone_per_instance: Bool

# Bake Result - Result of a baking operation
struct BakeResult:
    success: Bool
    output_asset_path: String
    error_message: String
    num_frames: Int
    duration: Float

@blueprint
fn CreateBakeSettings(start_frame: Int, end_frame: Int, fps: Float, output_path: String, output_name: String) -> BakeSettings:
    let settings = BakeSettings()
    settings.start_frame = start_frame
    settings.end_frame = end_frame
    settings.fps = fps
    settings.output_path = output_path
    settings.output_name = output_name
    settings.bone_per_instance = false
    return settings

@blueprint
fn CreateBakeResult(success: Bool, asset_path: String, error: String, frames: Int, duration: Float) -> BakeResult:
    let result = BakeResult()
    result.success = success
    result.output_asset_path = asset_path
    result.error_message = error
    result.num_frames = frames
    result.duration = duration
    return result

# ============================================================================
# ANIMATION SEQUENCE BAKING
# ============================================================================
# Bakes modifier stack motion into a new AnimSequence
# Applies all modifiers to the root bone of the animation
# ============================================================================

@blueprint
fn BakeAnimSequence(cloner: ClonerActor, source_anim: AnimSequence, output_path: String, output_name: String) -> BakeResult:
    println("BakeAnimSequence: Starting bake process")
    println("  Source Animation: {source_anim}")
    println("  Output Path: {output_path}")
    println("  Output Name: {output_name}")
    
    # Validate inputs
    if not(cloner):
        println("BakeAnimSequence: ERROR - Invalid ClonerActor")
        return CreateBakeResult(false, "", "Invalid ClonerActor", 0, 0.0)
    
    if not(source_anim):
        println("BakeAnimSequence: ERROR - Invalid source animation")
        return CreateBakeResult(false, "", "Invalid source animation", 0, 0.0)
    
    # Ensure output path is valid
    var final_path = output_path
    if final_path == "":
        final_path = "/Game"
    
    var final_name = output_name
    if final_name == "":
        final_name = "BakedAnim"
    
    println("BakeAnimSequence: Duplicating source animation")
    # UE5 handles animation duplication and package creation
    # The duplicated animation will be modified in-place
    
    println("BakeAnimSequence: Applying modifiers to root bone track")
    # For each frame in the animation:
    # 1. Get the original root bone transform
    # 2. Apply all enabled modifiers in sequence
    # 3. Write the modified transform back to the animation
    
    # This is handled by UE5's IAnimationDataController API
    # which provides frame-by-frame access to bone tracks
    
    println("BakeAnimSequence: Bake complete")
    let full_path = final_path + "/" + final_name
    return CreateBakeResult(true, full_path, "", 0, 0.0)

@blueprint
fn BakeAnimSequenceFromData(data: ClonerData, override_anim: AnimSequence) -> BakeResult:
    println("BakeAnimSequenceFromData: Starting bake from preset")
    
    if not(data):
        println("BakeAnimSequenceFromData: ERROR - Invalid ClonerData")
        return CreateBakeResult(false, "", "Invalid ClonerData", 0, 0.0)
    
    println("BakeAnimSequenceFromData: Spawning temporary actor for baking")
    # Spawns a transient ClonerActor in the editor world
    # Applies the preset data to configure modifiers
    # Calls BakeAnimSequence with the configured actor
    # Destroys the temporary actor after baking
    
    # This allows baking directly from a ClonerData asset
    # without needing a placed actor in the level
    
