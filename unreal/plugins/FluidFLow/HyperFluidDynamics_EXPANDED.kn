############################################################
# ACTORS - Simulation world, emitters, probes, controllers
############################################################

@component
@uclass("Blueprintable", "BlueprintType")
struct HyperFluidSimulationCore:
    grid: GridResolutionComponent
    time: TimeIntegrationComponent
    physics: PhysicalPropertiesComponent
    turbulence: TurbulenceComponent
    turbulence_advanced: TurbulenceAdvancedComponent
    multiphase: MultiphaseComponent
    thermal: ThermalComponent
    em: ElectroMagneticComponent
    quantum: QuantumComponent
    particles: ParticulateComponent
    particle_system: HyperFluidParticleSystemComponent
    adaptive: AdaptiveMeshComponent
    boundary: BoundaryConditionComponent
    collision: CollisionComponent
    coupling: CouplingComponent
    performance: PerformanceComponent
    diagnostics: DiagnosticsComponent
    viz: VisualizationComponent

    active_presets: Array<Int>
    simulation_time: Float
    frame_count: Int

    fn Initialize(preset_ids: Array<Int>):
        active_presets = preset_ids
        self.ApplyPresets(preset_ids)

    fn DispatchSimulation(steps: Int):
        let solver = physics.solver_family
        if solver == SolverFamily.LatticeBoltzmann:
            self.DispatchLBM(steps)
        else if solver == SolverFamily.SmoothedParticleHydro:
            self.DispatchSPH(steps)
        else if solver == SolverFamily.FiniteVolume:
            self.DispatchFVM(steps)
        else if solver == SolverFamily.FiniteElement:
            self.DispatchFEM(steps)
        else if solver == SolverFamily.Spectral:
            self.DispatchSpectral(steps)
        else if solver == SolverFamily.VortexMethod:
            self.DispatchVortex(steps)
        else if solver == SolverFamily.NavierStokesCompressible:
            self.DispatchCompressible(steps)
        else if solver == SolverFamily.MultiphaseLBM:
            self.DispatchMultiphaseLBM(steps)
        else:
            self.DispatchLBM(steps)

    fn DispatchLBM(steps: Int):
        for i in range(0, steps):
            LatticeBoltzmannCollision.Dispatch(grid.grid_dim, physics, turbulence)
            LatticeBoltzmannStreaming.Dispatch(grid.grid_dim, physics, turbulence)
            if physics.coupling_fields.contains(CouplingField.Magnetic):
                MagnetohydrodynamicsInduction.Dispatch(grid.grid_dim, em)
                MagnetohydrodynamicsLorentz.Dispatch(grid.grid_dim, em)
            if physics.coupling_fields.contains(CouplingField.Quantum):
                QuantumFluidGrossPitaevskii.Dispatch(grid.grid_dim, quantum)
                QuantumFluidVortices.Dispatch(grid.grid_dim, quantum)
            if physics.coupling_fields.contains(CouplingField.Thermal):
                ThermalFluidConduction.Dispatch(grid.grid_dim, thermal)
                ThermalFluidConvection.Dispatch(grid.grid_dim, thermal)

    fn DispatchSPH(steps: Int):
        for i in range(0, steps):
            SmoothedParticleHydrodynamics.Dispatch(particles.particle_count, physics, turbulence)
            if physics.coupling_fields.contains(CouplingField.Magnetic):
                MagnetohydrodynamicsLorentz.Dispatch(grid.grid_dim, em)
            if physics.coupling_fields.contains(CouplingField.Thermal):
                ThermalFluidConvection.Dispatch(grid.grid_dim, thermal)
            if particle_system.two_way_coupling:
                ParticleDrag.Dispatch(particle_system.particle_count, particle_system, physics)
            if particle_system.collision_model != CollisionModel.None:
                ParticleCollision.Dispatch(particle_system.particle_count, particle_system)

    fn DispatchFVM(steps: Int):
        for i in range(0, steps):
            FiniteVolumeFlux.Dispatch(grid.grid_dim, physics)
            FiniteVolumeGradient.Dispatch(grid.grid_dim, physics)
            if physics.boundary_type == BoundaryType.NoSlip:
                ImmersedBoundaryForce.Dispatch(grid.grid_dim, physics)
                ImmersedBoundaryVelocity.Dispatch(grid.grid_dim, physics)
            if physics.advection_scheme == AdvectionScheme.WENO5:
                AdvectionWENO5.Dispatch(grid.grid_dim, physics)

    fn DispatchFEM(steps: Int):
        for i in range(0, steps):
            FiniteElementStiffness.Dispatch(grid.grid_dim, physics)
            FiniteElementMass.Dispatch(grid.grid_dim, physics)
            if physics.coupling_fields.contains(CouplingField.Structural):
                ViscoelasticStress.Dispatch(grid.grid_dim, physics)
                ViscoelasticRelaxation.Dispatch(grid.grid_dim, physics)
            if physics.coupling_fields.contains(CouplingField.Porous):
                DarcyFlow.Dispatch(grid.grid_dim, physics, boundary)
                Forchheimer.Dispatch(grid.grid_dim, physics, boundary)

    fn DispatchSpectral(steps: Int):
        for i in range(0, steps):
            SpectralFourierTransform.Dispatch(grid.grid_dim, physics)
            SpectralTurbulence.Dispatch(grid.grid_dim, physics, turbulence)
            if turbulence_advanced.les_model == LESModel.Dynamic_Smagorinsky:
                LES_DynamicSmagorinsky.Dispatch(grid.grid_dim, turbulence_advanced)

    fn DispatchVortex(steps: Int):
        for i in range(0, steps):
            VortexMethodCore.Dispatch(grid.grid_dim, physics)
            VortexMethodAdvection.Dispatch(grid.grid_dim, physics)

    fn DispatchCompressible(steps: Int):
        for i in range(0, steps):
            # 1. Advection (Velocity, Density, Temperature)
            AdvectVelocity.Dispatch(grid.grid_dim, physics, time)
            AdvectDensity.Dispatch(grid.grid_dim, physics, time)
            if physics.coupling_fields.contains(CouplingField.Thermal):
                AdvectTemperature.Dispatch(grid.grid_dim, physics, time)

            # 2. External Forces (Gravity, Buoyancy)
            ApplyExternalForces.Dispatch(grid.grid_dim, physics, thermal, time)

            # 3. Divergence
            ComputeDivergence.Dispatch(grid.grid_dim, physics)

            # 4. Pressure Solve (Jacobi Iteration)
            # Pressure requires 20-50 iterations for convergence
            for j in range(0, 40):
                JacobiPressure.Dispatch(grid.grid_dim, physics)

            # 5. Gradient Subtraction (Project Velocity)
            SubtractGradient.Dispatch(grid.grid_dim, physics)

            # 6. SDF Collision
            if collision.enabled:
                SDFCollisionPass.Dispatch(grid.grid_dim, physics, collision)

            if turbulence_advanced.rans_model == RANSModel.k_Omega_SST:
                TurbulenceKOmegaSST.Dispatch(grid.grid_dim, turbulence_advanced)

    fn DispatchMultiphaseLBM(steps: Int):
        for i in range(0, steps):
            LatticeBoltzmannCollision.Dispatch(grid.grid_dim, physics, turbulence)
            LatticeBoltzmannStreaming.Dispatch(grid.grid_dim, physics, turbulence)
            MultiphasePhaseField.Dispatch(grid.grid_dim, multiphase)
            MultiphaseSurfaceTension.Dispatch(grid.grid_dim, multiphase)
            VOF_AdvectionPLIC.Dispatch(grid.grid_dim, multiphase)
            if multiphase.phases > 2:
                PhaseChange_Evaporation.Dispatch(grid.grid_dim, multiphase, thermal)

    fn UpdateVisualization():
        let mode = viz.visualization
        if mode == VisualizationMode.VolumeRaymarch:
            FluidRaymarching.Dispatch(grid.grid_dim, viz)
        else if mode == VisualizationMode.Schlieren:
            FluidSchlieren.Dispatch(grid.grid_dim, viz)
        else if mode == VisualizationMode.Interferometry:
            FluidInterferometry.Dispatch(grid.grid_dim, viz)
        else if mode == VisualizationMode.Holography:
            FluidHolography.Dispatch(grid.grid_dim, viz)
        else if mode == VisualizationMode.QuantumPhase:
            FluidQuantumVisualization.Dispatch(grid.grid_dim, viz)
        else:
            FluidRaymarching.Dispatch(grid.grid_dim, viz)

    fn UpdateQualitySettings(quality: QualityTier):
        if quality == QualityTier.Preview:
            grid.grid_dim = vec3(64, 64, 64)
            time.substeps = 1
            performance.precision_mode = PrecisionMode.Float16
        else if quality == QualityTier.High:
            grid.grid_dim = vec3(256, 256, 256)
            time.substeps = 2
            performance.precision_mode = PrecisionMode.Float32
        else if quality == QualityTier.Ultra:
            grid.grid_dim = vec3(512, 512, 512)
            time.substeps = 4
            performance.precision_mode = PrecisionMode.Float32
        else if quality == QualityTier.Research:
            grid.grid_dim = vec3(1024, 1024, 1024)
            time.substeps = 8
            performance.precision_mode = PrecisionMode.Float64

    fn ClearSimulationState():
        ClearTexture.Dispatch(grid.grid_dim, vec4(0,0,0,0))

@uclass("Blueprintable", "BlueprintType")
actor HyperFluidWorld:
    state simulation: HyperFluidSimulationCore = HyperFluidSimulationCore()

@uclass("Blueprintable", "BlueprintType")
actor HyperFluidEmitter:
    state world: HyperFluidSimulationCore = null
    state emission_rate: Float = 1.0
    state initial_velocity: Vec3 = vec3(0, 1, 0)
    state temperature: Float = 293.0
    state density: Float = 1.0
    state color: Vec3 = vec3(0.2, 0.6, 1.0)
    state particle_type: ParticleType = ParticleType.Droplet
    state emission_shape: EmissionShape = EmissionShape.Sphere
    state emission_radius: Float = 1.0

    on Server_Emit(count: Int):
        let c = max(count, 1)
        SmoothedParticleHydrodynamics.Emit(self.world.particles, c, initial_velocity, temperature, density)

    on Server_EmitBurst(count: Int, velocity: Vec3):
        let c = max(count, 1)
        SmoothedParticleHydrodynamics.EmitBurst(self.world.particles, c, velocity, temperature, density)

enum EmissionShape:
    Point
    Sphere
    Box
    Cone
    Cylinder
    EmissionShape_MAX

@uclass("Blueprintable", "BlueprintType")
actor HyperFluidProbe:
    state world: HyperFluidSimulationCore = null
    state sample_position: Vec3 = vec3(0, 0, 0)
    state radius: Float = 1.0
    state buffer: Array<Float> = []
    state sample_rate: Int = 60

    on Server_Sample():
        buffer = hyperfluid_sample_field(self.world, sample_position, radius)
        self.Client_ReceiveSample(buffer)

    on Client_ReceiveSample(data: Array<Float>):
        println("Probe Data Received: " + string(data.length) + " components")

    on Server_SampleVelocity():
        let vel = hyperfluid_sample_velocity(self.world, sample_position)
        self.Client_ReceiveSample([vel.x, vel.y, vel.z])

    on Server_SamplePressure():
        let p = hyperfluid_sample_pressure(self.world, sample_position)
        self.Client_ReceiveSample([p])

    on Server_SampleTemperature():
        let t = hyperfluid_sample_temperature(self.world, sample_position)
        self.Client_ReceiveSample([t])

@uclass("Blueprintable", "BlueprintType")
actor HyperFluidController:
    state world: HyperFluidSimulationCore = null
    state is_running: Bool = false
    state auto_step: Bool = true

    on Server_StartSimulation():
        world.Server_Initialize([0])
        is_running = true

    on Server_StopSimulation():
        is_running = false

    on Server_Tick():
        if is_running and auto_step:
            world.Server_StepSimulation(1)

    on Server_SetViz(mode: VisualizationMode):
        world.Server_SetVisualization(mode)

    on Server_SetQuality(quality: QualityTier):
        world.Server_SetQuality(quality)

    on Server_Reset():
        world.Server_ResetSimulation()
        is_running = false

############################################################
# BLUEPRINT UTILS - Analytics and presets application
############################################################

@blueprint
fn apply_fluid_preset(world: HyperFluidSimulationCore, preset_id: Int):
    world.ApplyPresets([preset_id])

@blueprint
fn set_visualization(world: HyperFluidSimulationCore, mode: VisualizationMode):
    world.Server_SetVisualization(mode)

@blueprint
fn sample_field(world: HyperFluidSimulationCore, position: Vec3, radius: Float) -> Array<Float>:
    return hyperfluid_sample_field(world, position, radius)

@blueprint
fn hyperfluid_sample_field(world: HyperFluidSimulationCore, position: Vec3, radius: Float) -> Array<Float>:
    let base = position.x + position.y + position.z + radius
    return [base, base * 0.5, base * 0.25]

@blueprint
fn hyperfluid_sample_velocity(world: HyperFluidSimulationCore, position: Vec3) -> Vec3:
    return vec3(position.x * 0.1, position.y * 0.1, position.z * 0.1)

@blueprint
fn hyperfluid_sample_pressure(world: HyperFluidSimulationCore, position: Vec3) -> Float:
    return position.z * world.physics.density * 9.81

@blueprint
fn hyperfluid_sample_temperature(world: HyperFluidSimulationCore, position: Vec3) -> Float:
    return world.thermal.temperature + (position.z * 0.01)

@blueprint
fn hyperfluid_compute_reynolds_number(world: HyperFluidSimulationCore, velocity: Float, length: Float) -> Float:
    return (world.physics.density * velocity * length) / world.physics.viscosity

@blueprint
fn hyperfluid_compute_mach_number(world: HyperFluidSimulationCore, velocity: Float) -> Float:
    let speed_of_sound = sqrt(world.physics.compressibility * world.physics.density)
    return velocity / speed_of_sound

@blueprint
fn hyperfluid_compute_weber_number(world: HyperFluidSimulationCore, velocity: Float, length: Float) -> Float:
    return (world.physics.density * velocity * velocity * length) / world.physics.surface_tension

@blueprint
fn hyperfluid_compute_froude_number(velocity: Float, length: Float, gravity: Float) -> Float:
    return velocity / sqrt(gravity * length)

############################################################
# SHADERS - Stage definitions
############################################################

shader compute LatticeBoltzmannCollision(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform turbulence: TurbulenceComponent @1
    let x = id.x
    let y = id.y
    let z = id.z
    let energy = float(x + y + z) * turbulence.intensity
    return vec4(energy, energy, energy, 1.0)

shader compute LatticeBoltzmannStreaming(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform turbulence: TurbulenceComponent @1
    let advect = float(id.x + id.y) * physics.viscosity
    return vec4(advect, advect, advect, 1.0)

shader compute SmoothedParticleHydrodynamics(id: Int) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform turbulence: TurbulenceComponent @1
    let k = physics.density * turbulence.intensity
    return vec4(k, k, k, 1.0)

shader compute MagnetohydrodynamicsInduction(id: Vec3) -> Vec4:
    uniform em: ElectroMagneticComponent @0
    let field = em.magnetic_field.x + em.magnetic_field.y + em.magnetic_field.z
    return vec4(field, field, field, 1.0)

shader compute MagnetohydrodynamicsLorentz(id: Vec3) -> Vec4:
    uniform em: ElectroMagneticComponent @0
    let force = em.lorentz_force_gain * (em.electric_field.x + em.magnetic_field.y)
    return vec4(force, force, force, 1.0)

shader compute QuantumFluidGrossPitaevskii(id: Vec3) -> Vec4:
    uniform quantum: QuantumComponent @0
    let psi = quantum.superfluid_fraction * quantum.dispersion_gain
    return vec4(psi, psi, psi, 1.0)

shader compute QuantumFluidVortices(id: Vec3) -> Vec4:
    uniform quantum: QuantumComponent @0
    let vort = quantum.vortex_core_size * quantum.phase_wrapping
    return vec4(vort, vort, vort, 1.0)

shader compute MultiphasePhaseField(id: Vec3) -> Vec4:
    uniform multiphase: MultiphaseComponent @0
    let field = multiphase.phase_field_mobility * multiphase.interface_thickness
    return vec4(field, field, field, 1.0)

shader compute MultiphaseSurfaceTension(id: Vec3) -> Vec4:
    uniform multiphase: MultiphaseComponent @0
    let tension = multiphase.surface_tension_coupling * multiphase.contact_angle
    return vec4(tension, tension, tension, 1.0)

shader compute ThermalFluidConduction(id: Vec3) -> Vec4:
    uniform thermal: ThermalComponent @0
    let q = thermal.thermal_diffusivity * (thermal.temperature * 0.01)
    return vec4(q, q, q, 1.0)

shader compute ThermalFluidConvection(id: Vec3) -> Vec4:
    uniform thermal: ThermalComponent @0
    let buoy = thermal.buoyancy_alpha * thermal.temperature
    return vec4(buoy, buoy, buoy, 1.0)

shader compute ReactiveFluidChemistry(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let react = physics.reactivity * 0.5
    return vec4(react, react, react, 1.0)

shader compute ReactiveFluidCombustion(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let heat = physics.reactivity * physics.density
    return vec4(heat, heat, heat, 1.0)

shader compute GranularFlowCollision(id: Vec3) -> Vec4:
    uniform particles: ParticulateComponent @0
    let impulse = particles.cohesion * particles.restitution
    return vec4(impulse, impulse, impulse, 1.0)

shader compute GranularFlowFriction(id: Vec3) -> Vec4:
    uniform particles: ParticulateComponent @0
    let friction = particles.friction * particles.adhesion
    return vec4(friction, friction, friction, 1.0)

shader compute CosmicDustAccretion(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let accr = physics.density * 0.0001
    return vec4(accr, accr, accr, 1.0)

shader compute CosmicDustRadiation(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let rad = physics.radiation_absorption * 0.1
    return vec4(rad, rad, rad, 1.0)

shader compute SuperfluidHelium4(id: Vec3) -> Vec4:
    uniform quantum: QuantumComponent @0
    let sf = quantum.superfluid_fraction * 4.0
    return vec4(sf, sf, sf, 1.0)

shader compute SuperfluidVortexLattice(id: Vec3) -> Vec4:
    uniform quantum: QuantumComponent @0
    let lattice = quantum.vortex_core_size * 10.0
    return vec4(lattice, lattice, lattice, 1.0)

shader compute PlasmaTokamak(id: Vec3) -> Vec4:
    uniform em: ElectroMagneticComponent @0
    let confinement = em.hall_parameter * 2.0
    return vec4(confinement, confinement, confinement, 1.0)

shader compute PlasmaFusion(id: Vec3) -> Vec4:
    uniform em: ElectroMagneticComponent @0
    let fusion = em.ambipolar_diffusion * 5.0
    return vec4(fusion, fusion, fusion, 1.0)

shader compute ViscoelasticStress(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let stress = physics.yield_stress + physics.viscosity
    return vec4(stress, stress, stress, 1.0)

shader compute ViscoelasticRelaxation(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let relax = physics.viscosity * 0.1
    return vec4(relax, relax, relax, 1.0)

shader compute ImmersedBoundaryForce(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let force = physics.density * 0.01
    return vec4(force, force, force, 1.0)

shader compute ImmersedBoundaryVelocity(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let vel = physics.viscosity * 0.02
    return vec4(vel, vel, vel, 1.0)

shader compute SpectralFourierTransform(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let freq = physics.density * 0.001
    return vec4(freq, freq, freq, 1.0)

shader compute SpectralTurbulence(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform turbulence: TurbulenceComponent @1
    let e = turbulence.intensity * 0.5
    return vec4(e, e, e, 1.0)

shader compute VortexMethodCore(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let vort = physics.viscosity * 0.01
    return vec4(vort, vort, vort, 1.0)

shader compute VortexMethodAdvection(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let adv = physics.density * 0.01
    return vec4(adv, adv, adv, 1.0)

shader compute FiniteVolumeFlux(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let flux = physics.density * physics.viscosity
    return vec4(flux, flux, flux, 1.0)

shader compute FiniteVolumeGradient(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let grad = physics.viscosity * 0.5
    return vec4(grad, grad, grad, 1.0)

shader compute FiniteElementStiffness(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let stiff = physics.permeability * 0.2
    return vec4(stiff, stiff, stiff, 1.0)

shader compute FiniteElementMass(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let mass = physics.density * 0.3
    return vec4(mass, mass, mass, 1.0)

shader compute FluidRaymarching(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    let color = viz.color_a * viz.exposure
    return vec4(color.x, color.y, color.z, 1.0)

shader compute FluidSchlieren(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    let s = viz.contrast * 0.5
    return vec4(s, s, s, 1.0)

shader compute FluidInterferometry(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    let i = viz.saturation * 0.4
    return vec4(i, i, i, 1.0)

shader compute FluidHolography(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    let h = viz.sample_count * 0.01
    return vec4(h, h, h, 1.0)

shader compute FluidQuantumVisualization(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    let q = viz.step_size * 0.1
    return vec4(q, q, q, 1.0)

############################################################
# ADVANCED SHADERS - Compressible, Multiphase, Turbulence
############################################################

shader compute AdvectVelocity(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform time: TimeIntegrationComponent @1
    # Semi-Lagrangian Advection
    # x_new = x_old - u(x_old) * dt
    # u_new = interpolate(u_old, x_new)
    let dt = time.dt
    let pos = vec3(id.x, id.y, id.z)
    
    # Sample velocity at current position
    # The grid coordinates are mapped to normalized [0,1] for sampling.
    uniform velocity_texture: Sampler3D @2 # Renamed for clarity, assuming 3D fluid
    
    let vel = sample(velocity_texture, pos).xyz
    let prev_pos = pos - vel * dt
    let advected_vel = sample(velocity_texture, prev_pos).xyz
    
    # Dissipation
    let decay = 1.0 - (physics.viscosity * dt)
    return vec4(advected_vel * decay, 1.0)

shader compute AdvectDensity(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform time: TimeIntegrationComponent @1
    uniform velocity_texture: Sampler3D @2
    uniform density_texture: Sampler3D @3
    
    let dt = time.dt
    let pos = vec3(id.x, id.y, id.z)
    let vel = sample(velocity_texture, pos).xyz
    let prev_pos = pos - vel * dt
    let new_density = sample(density_texture, prev_pos).x
    
    return vec4(new_density, 0.0, 0.0, 1.0)

shader compute AdvectTemperature(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform time: TimeIntegrationComponent @1
    uniform velocity_texture: Sampler3D @2
    uniform temperature_texture: Sampler3D @3
    
    let dt = time.dt
    let pos = vec3(id.x, id.y, id.z)
    let vel = sample(velocity_texture, pos).xyz
    let prev_pos = pos - vel * dt
    let new_temp = sample(temperature_texture, prev_pos).x
    
    # Thermal diffusion/decay
    let decay = 1.0 - (physics.conductivity * dt)
    return vec4(new_temp * decay, 0.0, 0.0, 1.0)

shader compute ApplyExternalForces(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform thermal: ThermalComponent @1
    uniform time: TimeIntegrationComponent @2
    uniform velocity_texture: Sampler3D @3
    uniform density_texture: Sampler3D @4 # Needed for buoyancy
    uniform temperature_texture: Sampler3D @5 # Needed for buoyancy
    
    let dt = time.dt
    let vel = sample(velocity_texture, vec3(id.x, id.y, id.z)).xyz
    let dens = sample(density_texture, vec3(id.x, id.y, id.z)).x
    let temp = sample(temperature_texture, vec3(id.x, id.y, id.z)).x
    
    # Gravity
    let gravity = vec3(0.0, -9.81, 0.0) * physics.gravity_scale
    
    # Buoyancy: F_b = alpha * density - beta * temperature (Simplified Boussinesq)
    # Typically: Force direction is Up (Y+)
    # Alpha (Density weight) - heavier sinks (negative force) -> (D - D0)
    # Beta (Temp weight) - hotter rises (positive force) -> (T - T0)
    let ambient_temp = 293.0 # Standard room temp
    let buoyancy_force = (thermal.buoyancy_alpha * dens - thermal.buoyancy_beta * (temp - ambient_temp)) * vec3(0.0, 1.0, 0.0)
    
    let new_vel = vel + (gravity + buoyancy_force) * dt
    return vec4(new_vel, 1.0)

shader compute ComputeDivergence(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform velocity_texture: Sampler3D @1
    
    let pos = vec3(id.x, id.y, id.z)
    
    # Finite Difference: (Logically)
    # Div = (v.x(i+1) - v.x(i-1) + v.y(j+1) - v.y(j-1) + v.z(k+1) - v.z(k-1)) / 2*dx
    
    # Using Sampler offsets (assuming normalized coords or integer indexing support in 'sample')
    # Assuming sample takes float coords or we use load with int coords. 
    # For simplicity/syntax matching reference, using offset logic.
    let L = sample(velocity_texture, pos + vec3(-1, 0, 0)).x
    let R = sample(velocity_texture, pos + vec3(1, 0, 0)).x
    let D = sample(velocity_texture, pos + vec3(0, -1, 0)).y
    let U = sample(velocity_texture, pos + vec3(0, 1, 0)).y
    let B = sample(velocity_texture, pos + vec3(0, 0, -1)).z
    let F = sample(velocity_texture, pos + vec3(0, 0, 1)).z
    
    let div = 0.5 * ((R - L) + (U - D) + (F - B))
    return vec4(div, 0.0, 0.0, 1.0)

shader compute JacobiPressure(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform pressure_texture: Sampler3D @1
    uniform divergence_texture: Sampler3D @2
    
    let pos = vec3(id.x, id.y, id.z)
    
    # Laplacian(P) = Div(V)
    # P(i,j,k) = (P(i-1) + P(i+1) + P(j-1) + P(j+1) + P(k-1) + P(k+1) - Div(i,j,k)) / 6
    
    let pL = sample(pressure_texture, pos + vec3(-1, 0, 0)).x
    let pR = sample(pressure_texture, pos + vec3(1, 0, 0)).x
    let pD = sample(pressure_texture, pos + vec3(0, -1, 0)).x
    let pU = sample(pressure_texture, pos + vec3(0, 1, 0)).x
    let pB = sample(pressure_texture, pos + vec3(0, 0, -1)).x
    let pF = sample(pressure_texture, pos + vec3(0, 0, 1)).x
    
    let div = sample(divergence_texture, pos).x
    
    let pNew = (pL + pR + pD + pU + pB + pF - div) / 6.0
    return vec4(pNew, 0.0, 0.0, 1.0)

shader compute SubtractGradient(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform velocity_texture: Sampler3D @1
    uniform pressure_texture: Sampler3D @2
    
    let pos = vec3(id.x, id.y, id.z)
    let vel_old = sample(velocity_texture, pos).xyz
    
    # Grad(P) = (P(i+1) - P(i-1), P(j+1) - P(j-1), P(k+1) - P(k-1)) / 2*dx
    
    let pL = sample(pressure_texture, pos + vec3(-1, 0, 0)).x
    let pR = sample(pressure_texture, pos + vec3(1, 0, 0)).x
    let pD = sample(pressure_texture, pos + vec3(0, -1, 0)).x
    let pU = sample(pressure_texture, pos + vec3(0, 1, 0)).x
    let pB = sample(pressure_texture, pos + vec3(0, 0, -1)).x
    let pF = sample(pressure_texture, pos + vec3(0, 0, 1)).x
    
    let gradP = vec3(pR - pL, pU - pD, pF - pB) * 0.5
    
    let vel_new = vel_old - gradP
    return vec4(vel_new, 1.0)

shader compute VOF_AdvectionPLIC(id: Vec3) -> Vec4:
    uniform multiphase: MultiphaseComponent @0
    let vof = multiphase.phase_field_mobility * 0.5
    return vec4(vof, vof, vof, 1.0)

shader compute LevelSet_Reinitialization(id: Vec3) -> Vec4:
    uniform multiphase: MultiphaseComponent @0
    let ls = multiphase.interface_thickness * 2.0
    return vec4(ls, ls, ls, 1.0)

shader compute PhaseChange_Evaporation(id: Vec3) -> Vec4:
    uniform multiphase: MultiphaseComponent @0
    uniform thermal: ThermalComponent @1
    let evap = thermal.temperature * multiphase.phase_field_mobility * 0.001
    return vec4(evap, evap, evap, 1.0)

shader compute PhaseChange_Condensation(id: Vec3) -> Vec4:
    uniform multiphase: MultiphaseComponent @0
    uniform thermal: ThermalComponent @1
    let cond = (300.0 - thermal.temperature) * multiphase.phase_field_mobility * 0.001
    return vec4(cond, cond, cond, 1.0)

shader compute TurbulenceKEpsilon(id: Vec3) -> Vec4:
    uniform turbulence_advanced: TurbulenceAdvancedComponent @0
    let k = turbulence_advanced.k_epsilon_c_mu * 0.5
    return vec4(k, k, k, 1.0)

shader compute TurbulenceKOmegaSST(id: Vec3) -> Vec4:
    uniform turbulence_advanced: TurbulenceAdvancedComponent @0
    let omega = turbulence_advanced.k_omega_beta_star * 0.5
    return vec4(omega, omega, omega, 1.0)

shader compute TurbulenceSpalartAllmaras(id: Vec3) -> Vec4:
    uniform turbulence_advanced: TurbulenceAdvancedComponent @0
    let nu_tilde = turbulence_advanced.y_plus_target * 0.01
    return vec4(nu_tilde, nu_tilde, nu_tilde, 1.0)

shader compute LES_DynamicSmagorinsky(id: Vec3) -> Vec4:
    uniform turbulence_advanced: TurbulenceAdvancedComponent @0
    let cs = turbulence_advanced.smagorinsky_constant * 0.5
    return vec4(cs, cs, cs, 1.0)

shader compute ParticleDrag(id: Int) -> Vec4:
    uniform particle_system: HyperFluidParticleSystemComponent @0
    uniform physics: PhysicalPropertiesComponent @1
    let drag = particle_system.drag_coefficient * physics.density * 0.01
    return vec4(drag, drag, drag, 1.0)

shader compute ParticleCollision(id: Int) -> Vec4:
    uniform particle_system: HyperFluidParticleSystemComponent @0
    let col = particle_system.restitution_coefficient * particle_system.friction_coefficient
    return vec4(col, col, col, 1.0)

shader compute ParticleBreakup(id: Int) -> Vec4:
    uniform particle_system: HyperFluidParticleSystemComponent @0
    let breakup = particle_system.weber_number_critical * 0.1
    return vec4(breakup, breakup, breakup, 1.0)

shader compute ParticleEvaporation(id: Int) -> Vec4:
    uniform particle_system: HyperFluidParticleSystemComponent @0
    let evap = particle_system.latent_heat * 0.0001
    return vec4(evap, evap, evap, 1.0)

shader compute AcousticWaveEquation(id: Vec3) -> Vec4:
    uniform coupling: CouplingComponent @0
    let wave = coupling.speed_of_sound * 0.01
    return vec4(wave, wave, wave, 1.0)

shader compute AcousticSourceTerm(id: Vec3) -> Vec4:
    uniform coupling: CouplingComponent @0
    let source = coupling.acoustic_impedance * 0.001
    return vec4(source, source, source, 1.0)

shader compute DarcyFlow(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform boundary: BoundaryConditionComponent @1
    let darcy = boundary.porous_permeability * physics.viscosity
    return vec4(darcy, darcy, darcy, 1.0)

shader compute Forchheimer(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform boundary: BoundaryConditionComponent @1
    let forch = boundary.porous_porosity * physics.density * 0.01
    return vec4(forch, forch, forch, 1.0)

shader compute PoroElastic(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform boundary: BoundaryConditionComponent @1
    let poro = boundary.porous_permeability * physics.permeability
    return vec4(poro, poro, poro, 1.0)

shader compute FreeSurface_VOF(id: Vec3) -> Vec4:
    uniform multiphase: MultiphaseComponent @0
    let vof = multiphase.phase_field_mobility * 0.8
    return vec4(vof, vof, vof, 1.0)

shader compute FreeSurface_LevelSet(id: Vec3) -> Vec4:
    uniform multiphase: MultiphaseComponent @0
    let ls = multiphase.interface_thickness * 1.5
    return vec4(ls, ls, ls, 1.0)

shader compute SurfaceTension_CSF(id: Vec3) -> Vec4:
    uniform multiphase: MultiphaseComponent @0
    let csf = multiphase.surface_tension_coupling * 0.5
    return vec4(csf, csf, csf, 1.0)

shader compute AdvectionWENO5(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    let weno = physics.density * 0.05
    return vec4(weno, weno, weno, 1.0)

############################################################
# EDITOR MODULE - Slate tools for presets and tuning
############################################################

@editor_module
struct HyperFluidEditorModule:
    fn StartupModule():
        HyperFluidDetails.Register()
        HyperFluidViewport.Register()
    fn ShutdownModule():
        HyperFluidDetails.Unregister()
        HyperFluidViewport.Unregister()

@details(HyperFluidWorld)
struct HyperFluidDetails:
    fn Customize():
        println("Customizing HyperFluid Editor UI...")

@viewport(HyperFluidWorld)
struct HyperFluidViewport:
    fn Draw(world: HyperFluidWorld):
        let data = hyperfluid_sample_field(world, vec3(0,0,0), 1.0)
        self.DrawHUDText("Sample: " + string(data.length), vec2(10,10))

