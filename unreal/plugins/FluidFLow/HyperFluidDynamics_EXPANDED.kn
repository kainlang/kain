# Main dashboard widget
@slate
struct SFluidSimulationDashboard:
    @argument
    title: Text
    
    @attribute
    simulation_running: Bool
    
    @attribute
    current_fps: Float
    
    @attribute
    particle_count: Int
    
    @attribute
    grid_resolution: Vec3
    
    @event
    on_start_simulation: OnButtonClicked
    
    @event
    on_stop_simulation: OnButtonClicked
    
    @event
    on_reset_simulation: OnButtonClicked
    
    @event
    on_quality_changed: OnSelectionChanged
    
    fn Compose() -> Widget:
        let root = VerticalBox()
        
        # Header
        let header = TextBlock()
        header.Text(title)
        header.FontSize(24)
        root.Add(header)
        
        # Status row
        let status_row = HorizontalBox()
        let status_label = TextBlock()
        status_label.Text("Status:")
        status_row.Add(status_label)
        
        let status_value = TextBlock()
        if simulation_running:
            status_value.Text("Running")
            status_value.Color(vec3(0.1, 0.9, 0.2))
        else:
            status_value.Text("Stopped")
            status_value.Color(vec3(0.9, 0.1, 0.1))
        status_row.Add(status_value)
        root.Add(status_row)
        
        # FPS row
        let fps_row = HorizontalBox()
        let fps_label = TextBlock()
        fps_label.Text("FPS:")
        fps_row.Add(fps_label)
        
        let fps_value = TextBlock()
        fps_value.Text("{current_fps}")
        fps_row.Add(fps_value)
        root.Add(fps_row)
        
        # Control buttons
        let button_row = HorizontalBox()
        
        let start_btn = Button()
        start_btn.Text("Start")
        start_btn.OnClicked(on_start_simulation)
        button_row.Add(start_btn)
        
        let stop_btn = Button()
        stop_btn.Text("Stop")
        stop_btn.OnClicked(on_stop_simulation)
        button_row.Add(stop_btn)
        
        let reset_btn = Button()
        reset_btn.Text("Reset")
        reset_btn.OnClicked(on_reset_simulation)
        button_row.Add(reset_btn)
        
        root.Add(button_row)
        
        return root

# Simulation controls widget
@slate
struct SSimulationControls:
    @argument
    world: HyperFluidWorld
    
    @attribute
    time_step: Float
    
    @attribute
    viscosity: Float
    
    @attribute
    gravity_scale: Float
    
    @attribute
    turbulence_intensity: Float
    
    @event
    on_timestep_changed: OnValueChanged
    
    @event
    on_viscosity_changed: OnValueChanged
    
    @event
    on_gravity_changed: OnValueChanged
    
    @event
    on_turbulence_changed: OnValueChanged
    
    fn Compose() -> Widget:
        let vbox = VerticalBox()
        
        # Time step slider
        let ts_row = HorizontalBox()
        let ts_label = TextBlock()
        ts_label.Text("Time Step:")
        ts_row.Add(ts_label)
        
        let ts_slider = Slider()
        ts_slider.MinValue(0.001)
        ts_slider.MaxValue(0.1)
        ts_slider.Value(time_step)
        ts_slider.OnValueChanged(on_timestep_changed)
        ts_row.Add(ts_slider)
        vbox.Add(ts_row)
        
        # Viscosity slider
        let visc_row = HorizontalBox()
        let visc_label = TextBlock()
        visc_label.Text("Viscosity:")
        visc_row.Add(visc_label)
        
        let visc_slider = Slider()
        visc_slider.MinValue(0.0001)
        visc_slider.MaxValue(0.1)
        visc_slider.Value(viscosity)
        visc_slider.OnValueChanged(on_viscosity_changed)
        visc_row.Add(visc_slider)
        vbox.Add(visc_row)
        
        # Gravity slider
        let grav_row = HorizontalBox()
        let grav_label = TextBlock()
        grav_label.Text("Gravity:")
        grav_row.Add(grav_label)
        
        let grav_slider = Slider()
        grav_slider.MinValue(0.0)
        grav_slider.MaxValue(2.0)
        grav_slider.Value(gravity_scale)
        grav_slider.OnValueChanged(on_gravity_changed)
        grav_row.Add(grav_slider)
        vbox.Add(grav_row)
        
        # Turbulence slider
        let turb_row = HorizontalBox()
        let turb_label = TextBlock()
        turb_label.Text("Turbulence:")
        turb_row.Add(turb_label)
        
        let turb_slider = Slider()
        turb_slider.MinValue(0.0)
        turb_slider.MaxValue(1.0)
        turb_slider.Value(turbulence_intensity)
        turb_slider.OnValueChanged(on_turbulence_changed)
        turb_row.Add(turb_slider)
        vbox.Add(turb_row)
        
        return vbox

# Visualization controls
@slate
struct SVisualizationControls:
    @attribute
    viz_mode: EVisualizationMode
    
    @attribute
    exposure: Float
    
    @attribute
    contrast: Float
    
    @attribute
    color_a: Vec3
    
    @attribute
    color_b: Vec3
    
    @event
    on_mode_changed: OnSelectionChanged
    
    @event
    on_exposure_changed: OnValueChanged
    
    @event
    on_contrast_changed: OnValueChanged
    
    @event
    on_color_a_changed: OnColorChanged
    
    @event
    on_color_b_changed: OnColorChanged
    
    fn Compose() -> Widget:
        let vbox = VerticalBox()
        
        # Mode selector
        let mode_row = HorizontalBox()
        let mode_label = TextBlock()
        mode_label.Text("Visualization Mode:")
        mode_row.Add(mode_label)
        
        let mode_combo = ComboBox()
        mode_combo.AddOption("Volume Raymarch")
        mode_combo.AddOption("Schlieren")
        mode_combo.AddOption("Streamlines")
        mode_combo.AddOption("Vorticity")
        mode_combo.AddOption("Pressure")
        mode_combo.OnSelectionChanged(on_mode_changed)
        mode_row.Add(mode_combo)
        vbox.Add(mode_row)
        
        # Exposure slider
        let exp_row = HorizontalBox()
        let exp_label = TextBlock()
        exp_label.Text("Exposure:")
        exp_row.Add(exp_label)
        
        let exp_slider = Slider()
        exp_slider.MinValue(0.1)
        exp_slider.MaxValue(5.0)
        exp_slider.Value(exposure)
        exp_slider.OnValueChanged(on_exposure_changed)
        exp_row.Add(exp_slider)
        vbox.Add(exp_row)
        
        # Contrast slider
        let con_row = HorizontalBox()
        let con_label = TextBlock()
        con_label.Text("Contrast:")
        con_row.Add(con_label)
        
        let con_slider = Slider()
        con_slider.MinValue(0.1)
        con_slider.MaxValue(3.0)
        con_slider.Value(contrast)
        con_slider.OnValueChanged(on_contrast_changed)
        con_row.Add(con_slider)
        vbox.Add(con_row)
        
        # Color pickers
        let color_a_row = HorizontalBox()
        let color_a_label = TextBlock()
        color_a_label.Text("Color A:")
        color_a_row.Add(color_a_label)
        
        let color_a_picker = ColorPicker()
        color_a_picker.Color(color_a)
        color_a_picker.OnColorChanged(on_color_a_changed)
        color_a_row.Add(color_a_picker)
        vbox.Add(color_a_row)
        
        let color_b_row = HorizontalBox()
        let color_b_label = TextBlock()
        color_b_label.Text("Color B:")
        color_b_row.Add(color_b_label)
        
        let color_b_picker = ColorPicker()
        color_b_picker.Color(color_b)
        color_b_picker.OnColorChanged(on_color_b_changed)
        color_b_row.Add(color_b_picker)
        vbox.Add(color_b_row)
        
        return vbox

