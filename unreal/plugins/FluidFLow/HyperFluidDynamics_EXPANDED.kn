    physical_time: 0.2
}

preset ValidationCase {
    id: 5
    name: "DamBreak_3D"
    case_type: ValidationCaseType.DamBreak
    reference_solution: "Experimental_Martin1952"
    tolerance: 0.05
    expected_convergence_rate: 1.0
    grid_resolution: vec3(128, 128, 128)
    time_steps: 2000
    physical_time: 2.0
}


############################################################
# PHYSICS UTILS - Collision and Boundary Handling
############################################################

shader compute SDFCollisionPass(id: Vec3) -> Vec4:
    uniform physics: PhysicalPropertiesComponent @0
    uniform collision: CollisionComponent @1
    uniform velocity_texture: Sampler3D @2
    uniform sdf_texture: Sampler3D @3
    
    let pos = vec3(id.x, id.y, id.z) / 256.0
    var vel_raw = sample(velocity_texture, pos)
    var vel = vel_raw.xyz
    let dist = sample(sdf_texture, pos).x
    
    if (dist < collision.sdf_threshold):
        # Calculate normal from SDF gradient
        let eps = 0.01
        let nx = sample(sdf_texture, pos + vec3(eps, 0.0, 0.0)).x - sample(sdf_texture, pos - vec3(eps, 0.0, 0.0)).x
        let ny = sample(sdf_texture, pos + vec3(0.0, eps, 0.0)).x - sample(sdf_texture, pos - vec3(0.0, eps, 0.0)).x
        let nz = sample(sdf_texture, pos + vec3(0.0, 0.0, eps)).x - sample(sdf_texture, pos - vec3(0.0, 0.0, eps)).x
        let normal = normalize(vec3(nx, ny, nz))
        
        # Velocity reflection/adjustment
        let v_dot_n = dot(vel, normal)
        if (v_dot_n < 0.0):
            # Reflect with restitution
            let v_normal = normal * v_dot_n
            let v_tangent = vel - v_normal
            vel = v_tangent * (1.0 - collision.friction) - v_normal * collision.restitution

    return vec4(vel, vel_raw.w)

shader compute ClearTexture(id: Vec3) -> Vec4:
    uniform color: Vec4 @0
    return color

############################################################
# VISUALIZATION SHADERS - Volumetric Rendering & Analysis
############################################################

shader compute FluidRaymarching(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    uniform density_texture: Sampler3D @1
    
    # Guard against 3D dispatch for 2D render target
    if (id.z > 0):
        return vec4(0.0, 0.0, 0.0, 0.0)

    let uv = vec2(id.x, id.y) / 256.0
    let ray_pos = vec3(uv.x, uv.y, 0.0)
    let ray_dir = vec3(0.0, 0.0, 1.0)
    let step_dist = viz.step_size * 0.01

    var accum_color = vec3(0.0)
    var accum_alpha = 0.0

    for i in range(0, 128):
        if (accum_alpha >= 1.0):
            break
            
        let pos = ray_pos + ray_dir * (float(i) * step_dist)
        if (pos.z > 1.0):
            break

        let density = sample(density_texture, pos).x
        
        if (density > 0.001):
            let src_alpha = density * viz.exposure * step_dist * 10.0
            let src_color = mix(viz.color_a, viz.color_b, density)
            
            accum_color = accum_color + src_color * src_alpha * (1.0 - accum_alpha)
            accum_alpha = accum_alpha + src_alpha * (1.0 - accum_alpha)

    # Background composite
    let final_color = mix(vec3(0.0), accum_color, accum_alpha)
    return vec4(final_color, accum_alpha)

shader compute FluidSchlieren(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    uniform density_texture: Sampler3D @1
    
    if (id.z > 0):
        return vec4(0.0)

    let pos = vec3(id.x, id.y, 0.5) / 256.0 // Slice at Z=0.5
    
    # Calculate density gradient (Refractive Index gradient)
    let L = sample(density_texture, pos + vec3(-0.01, 0.0, 0.0)).x
    let R = sample(density_texture, pos + vec3(0.01, 0.0, 0.0)).x
    let D = sample(density_texture, pos + vec3(0.0, -0.01, 0.0)).x
    let U = sample(density_texture, pos + vec3(0.0, 0.01, 0.0)).x
    
    let grad_x = (R - L) * viz.contrast * 10.0
    let grad_y = (U - D) * viz.contrast * 10.0
    
    let schlieren = sqrt(grad_x * grad_x + grad_y * grad_y)
    let color = mix(viz.color_a, viz.color_b, schlieren)
    
    return vec4(color, 1.0)

shader compute FluidInterferometry(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    uniform density_texture: Sampler3D @1
    
    if (id.z > 0):
        return vec4(0.0)

    let pos = vec3(id.x, id.y, 0.5) / 256.0
    let density = sample(density_texture, pos).x
    
    # Simulate thin-film interference based on density path length
    let phase = density * viz.exposure * 20.0
    let r = 0.5 + 0.5 * sin(phase)
    let g = 0.5 + 0.5 * sin(phase + 2.09)
    let b = 0.5 + 0.5 * sin(phase + 4.18)
    
    return vec4(r, g, b, 1.0)

shader compute FluidHolography(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    uniform density_texture: Sampler3D @1
    
    if (id.z > 0):
        return vec4(0.0)
        
    let pos = vec3(id.x, id.y, 0.5) / 256.0
    let density = sample(density_texture, pos).x
    
    let pattern = sin(pos.x * 100.0 + density * 50.0) * sin(pos.y * 100.0 + density * 50.0)
    let hologram = mix(viz.color_c, vec3(1.0), pattern * viz.holography_phase_gain)
    
    return vec4(hologram * density, 1.0)

shader compute FluidQuantumVisualization(id: Vec3) -> Vec4:
    uniform viz: VisualizationComponent @0
    uniform density_texture: Sampler3D @1
    
    if (id.z > 0):
        return vec4(0.0)
        
    let pos = vec3(id.x, id.y, 0.5) / 256.0
    let density = sample(density_texture, pos).x
    let probability = density * density
    
    let color = mix(vec3(0.0), viz.color_a, probability)
    return vec4(color, 1.0)

############################################################
# END OF FILE - HyperFluidDynamics EXPANDED EDITION
############################################################


############################################################
# PHASE 1: RENDER TARGET AUTO-CREATION & EDITOR UI
############################################################

# Render target configuration
struct RenderTargetConfig:
    width: Int
    height: Int
    depth: Int
    format: String
    enable_uav: Bool
    enable_srv: Bool
    clear_color: Vec4

# Auto-create render targets in BeginPlay
fn CreateSimulationRenderTargets(world: HyperFluidWorld):
    let width = int(world.grid.grid_dim.x)
    let height = int(world.grid.grid_dim.y)
    let depth = int(world.grid.grid_dim.z)
    
    # Position buffers (ping-pong)
    world.PositionRT_A = CreateRenderTarget2D(width, height, "RTF_RGBA32f")
    world.PositionRT_B = CreateRenderTarget2D(width, height, "RTF_RGBA32f")
    
    # Velocity buffers (ping-pong)
    world.VelocityRT_A = CreateRenderTarget2D(width, height, "RTF_RGBA32f")
    world.VelocityRT_B = CreateRenderTarget2D(width, height, "RTF_RGBA32f")
    
    # Pressure buffer
    world.PressureRT = CreateRenderTarget2D(width, height, "RTF_R32f")
    
    # Temperature buffer
    world.ThermalRT = CreateRenderTarget2D(width, height, "RTF_R32f")
    
    # Density buffer
    world.DensityRT = CreateRenderTarget2D(width, height, "RTF_R32f")
    
    # Vorticity buffer
    world.VorticityRT = CreateRenderTarget2D(width, height, "RTF_RGBA32f")
    
    # Visualization output
    world.VisualizationRT = CreateRenderTarget2D(width, height, "RTF_RGBA8")
    
    println("Render targets created: {width}x{height}")

