############################################################
# PHASE 6: ASSET EDITOR - COMPLETE FLUID EDITOR
############################################################

@asset_editor
struct FluidSimulationEditor:
    @asset
    fluid_world: HyperFluidWorld
    
    @viewport
    preview_viewport: FluidSimulationViewport
    
    @details
    properties: FluidWorldDetails
    
    @toolbar
    toolbar: FluidSimulationToolbar
    
    @slate
    dashboard: SFluidSimulationDashboard
    
    @slate
    sim_controls: SSimulationControls
    
    @slate
    viz_controls: SVisualizationControls
    
    fn OnAssetOpened():
        # Initialize editor when fluid world is opened
        preview_viewport.fluid_world = fluid_world
        preview_viewport.ResetCamera()
        
        # Sync properties
        properties.viscosity = fluid_world.physics.viscosity
        properties.density = fluid_world.physics.density
        properties.gravity_scale = fluid_world.physics.gravity_scale
        
        # Initialize dashboard
        dashboard.simulation_running = false
        dashboard.current_fps = 0.0
        dashboard.particle_count = fluid_world.particles.particle_count
        dashboard.grid_resolution = fluid_world.grid.grid_dim
    
    fn OnPropertyChanged():
        # Update simulation when properties change
        fluid_world.physics.viscosity = properties.viscosity
        fluid_world.physics.density = properties.density
        fluid_world.physics.gravity_scale = properties.gravity_scale
        fluid_world.turbulence.intensity = properties.turbulence_intensity
        fluid_world.viz.visualization = properties.visualization_mode
    
    fn OnSimulationStart():
        dashboard.simulation_running = true
        fluid_world.Server_Initialize([0])
    
    fn OnSimulationStop():
        dashboard.simulation_running = false
    
    fn OnSimulationReset():
        fluid_world.Server_ResetSimulation()
        dashboard.current_fps = 0.0

