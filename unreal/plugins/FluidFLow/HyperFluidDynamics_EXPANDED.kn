# PHASE 3: VIEWPORT - 3D FLUID PREVIEW
############################################################

@viewport
struct FluidSimulationViewport:
    @scene_actor
    fluid_world: HyperFluidWorld
    
    @camera
    camera: EditorCamera
    
    viewport_mode: EVisualizationMode
    
    show_grid: Bool
    show_bounds: Bool
    show_particles: Bool
    
    fn SetVisualizationMode(mode: EVisualizationMode):
        viewport_mode = mode
        fluid_world.Server_SetVisualization(mode)
    
    fn ToggleGrid():
        show_grid = not show_grid
    
    fn ToggleBounds():
        show_bounds = not show_bounds
    
    fn ToggleParticles():
        show_particles = not show_particles
    
    fn ResetCamera():
        camera.SetPosition(vec3(0, -500, 200))
        camera.LookAt(vec3(0, 0, 0))

