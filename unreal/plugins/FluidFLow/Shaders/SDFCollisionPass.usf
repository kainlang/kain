[numthreads(32, 32, 1)]
void SDFCollisionPassCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float3 pos = (float3(ThreadId.x, ThreadId.y, ThreadId.z) / 256.000000);
    float4 vel_raw = velocity_texture.Sample(velocity_textureSampler, pos);
    float3 vel = vel_raw.xyz;
    float dist = sdf_texture.Sample(sdf_textureSampler, pos).x;
    if (((dist < collision.sdf_threshold)))
    {
        float eps = 0.010000;
        float nx = (sdf_texture.Sample(sdf_textureSampler, (pos + float3(eps, 0.000000, 0.000000))).x - sdf_texture.Sample(sdf_textureSampler, (pos - float3(eps, 0.000000, 0.000000))).x);
        float ny = (sdf_texture.Sample(sdf_textureSampler, (pos + float3(0.000000, eps, 0.000000))).x - sdf_texture.Sample(sdf_textureSampler, (pos - float3(0.000000, eps, 0.000000))).x);
        float nz = (sdf_texture.Sample(sdf_textureSampler, (pos + float3(0.000000, 0.000000, eps))).x - sdf_texture.Sample(sdf_textureSampler, (pos - float3(0.000000, 0.000000, eps))).x);
        float3 normal = normalize(float3(nx, ny, nz));
        float v_dot_n = dot(vel, normal);
        if (((v_dot_n < 0.000000)))
        {
            float3 v_normal = (normal * v_dot_n);
            float3 v_tangent = (vel - v_normal);
            vel = ((v_tangent * ((1.000000 - collision.friction))) - (v_normal * collision.restitution));
        }
    }
    OutputTexture[ThreadId.xy] = float4(vel, vel_raw.w);
    return;
}
