// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// POD mirror for PhysicalPropertiesComponent
struct FPhysicalPropertiesComponentData {
    int fluid_class;
    int solver_family;
    int hybrid_solver;
    int pressure_solver;
    int advection_scheme;
    int turbulence_model;
    int boundary_type;
    int quality;
    int backend;
    float viscosity;
    float density;
    float surface_tension;
    float compressibility;
    float conductivity;
    float permittivity;
    float permeability;
    float reactivity;
    float radiation_absorption;
    float gravity_scale;
    float anisotropy;
    float cavitation_threshold;
    float yield_stress;
    float foam_threshold;
    float spray_threshold;
    float bubble_coalescence;
};

// POD mirror for TimeIntegrationComponent
struct FTimeIntegrationComponentData {
    float dt;
    int time_integrator;
    float cfl;
    int substeps;
    bool real_time_sync;
    bool clamp_dt;
    float max_dt;
    float min_dt;
};

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
FPhysicalPropertiesComponentData physics;
FTimeIntegrationComponentData time;

// Texture Inputs
Texture3D<float4> velocity_texture : register(t2);
SamplerState velocity_textureSampler : register(s2);
Texture3D<float4> temperature_texture : register(t3);
SamplerState temperature_textureSampler : register(s3);

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void AdvectTemperatureCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float2 dt = time.dt;
    float3 pos = float3(ThreadId.x, ThreadId.y, ThreadId.z);
    float3 vel = velocity_texture.Sample(velocity_textureSampler, pos).xyz;
    float3 prev_pos = (pos - (vel * dt));
    float new_temp = temperature_texture.Sample(temperature_textureSampler, prev_pos).x;
    float decay = (1.000000 - ((physics.conductivity * dt)));
    OutputTexture[ThreadId.xy] = float4((new_temp * decay), 0.000000, 0.000000, 1.000000);
    return;
}
