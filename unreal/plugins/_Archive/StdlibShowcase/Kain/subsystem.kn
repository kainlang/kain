# ============================================================================
# STDLIB SHOWCASE — World Subsystem
# ============================================================================
# StdlibShowcaseSubsystem — UWorldSubsystem that coordinates all diagnostic
# actors, acts as the central registry, and provides blueprint-callable
# aggregate queries. Exercises: world.kn, actor.kn, gameplay.kn, math.kn
# ============================================================================

@subsystem
struct StdlibShowcaseSubsystem:

    # ======= REGISTRY =======

    registered_manager_count: Int
    registered_proxy_count: Int
    registered_animator_count: Int

    # ======= AGGREGATE STATS =======

    total_diagnostic_runs: Int
    total_tests_passed: Int
    total_tests_failed: Int
    total_categories_exercised: Int

    # ======= TIMING =======

    subsystem_start_time: Float
    last_aggregate_update_time: Float
    update_interval: Float

    # ======= BEST/WORST TRACKING =======

    best_pass_rate: Float
    worst_pass_rate: Float
    average_run_duration: Float
    run_duration_sum: Float

    # ======= SETTINGS =======

    verbose_logging: Bool
    draw_aggregate_debug: Bool
    aggregate_debug_origin: Vec3

    @tick
    fn Tick(delta_time: Float):
        let now = GetWorldTimeSeconds()

        # Aggregate debug update every 2 seconds
        if now - last_aggregate_update_time < update_interval:
            return

        last_aggregate_update_time = now

        # Query all manager actors currently in world and gather stats
        let managers = GetAllActorsWithTag("StdlibManager")
        registered_manager_count = 0

        # Count registered entities
        let proxies = GetAllActorsWithTag("StdlibProxy")
        registered_proxy_count = GetActorCount()   # Approximation using world.kn

        total_categories_exercised = 7     # All non-shader categories

        if draw_aggregate_debug:
            DrawAggregateDebugOverlay(now)

        if verbose_logging:
            PrintToLog("StdlibShowcase [SUBSYSTEM] Tick aggregate — managers: " + int_to_string(registered_manager_count))
            PrintToLog("StdlibShowcase [SUBSYSTEM] Total runs: " + int_to_string(total_diagnostic_runs))
            PrintToLog("StdlibShowcase [SUBSYSTEM] Pass/Fail: " + int_to_string(total_tests_passed) + " / " + int_to_string(total_tests_failed))

    fn Initialize():
        registered_manager_count = 0
        registered_proxy_count = 0
        registered_animator_count = 0
        total_diagnostic_runs = 0
        total_tests_passed = 0
        total_tests_failed = 0
        total_categories_exercised = 0
        subsystem_start_time = GetWorldTimeSeconds()
        last_aggregate_update_time = 0.0
        update_interval = 2.0
        best_pass_rate = 0.0
        worst_pass_rate = 1.0
        average_run_duration = 0.0
        run_duration_sum = 0.0
        verbose_logging = false
        draw_aggregate_debug = true
        aggregate_debug_origin = vec3(0.0, 0.0, 0.0)

    fn Deinitialize():
        PrintToLog("StdlibShowcase [SUBSYSTEM] Shutting down. Total runs: " + int_to_string(total_diagnostic_runs))
        PrintToLog("StdlibShowcase [SUBSYSTEM] Final pass rate: " + float_to_string(GetAggregatePassRate()))

    # Register a completed diagnostic run from a manager actor
    @blueprint_callable
    fn RecordDiagnosticRun(passed: Int, failed: Int, duration: Float):
        total_diagnostic_runs = total_diagnostic_runs + 1
        total_tests_passed = total_tests_passed + passed
        total_tests_failed = total_tests_failed + failed
        run_duration_sum = run_duration_sum + duration
        average_run_duration = run_duration_sum / total_diagnostic_runs as Float

        let pass_rate = GetAggregatePassRate()
        if pass_rate > best_pass_rate:
            best_pass_rate = pass_rate
        if pass_rate < worst_pass_rate:
            worst_pass_rate = pass_rate

        PrintToScreen("StdlibShowcase [SUBSYSTEM] Run recorded — pass rate: " + float_to_string(pass_rate * 100.0) + "%")

    # Get current aggregate pass rate 0..1
    @blueprint_pure
    fn GetAggregatePassRate() -> Float:
        let total = total_tests_passed + total_tests_failed
        if total <= 0:
            return 0.0
        return total_tests_passed as Float / total as Float

    # Get uptime of this subsystem
    @blueprint_pure
    fn GetUptimeSeconds() -> Float:
        return GetWorldTimeSeconds() - subsystem_start_time

    # How many proxies are currently live in the world
    @blueprint_callable
    fn QueryLiveProxyCount() -> Int:
        let proxies = GetAllActorsWithTag("StdlibProxy")
        return registered_proxy_count

    # Run a math stress-test directly from the subsystem (no actor needed)
    @blueprint_callable
    fn RunMathStressTest(iterations: Int) -> Float:
        let sum = 0.0
        let count = 0

        # Run 'iterations' worth of vector math operations
        let v = vec3(1.0, 2.0, 3.0)
        let result = 0.0

        # Iteration 1
        let n1 = Vector_Normalize(v)
        result = result + Vector_Length(n1)
        let dist1 = Vector_Distance(v, vec3(4.0, 5.0, 6.0))
        result = result + dist1

        # Iteration 2
        let lerp_result = Lerp(0.0, 100.0, 0.33)
        result = result + lerp_result

        # Iteration 3
        let sin_val = sin(1.0) + cos(1.0)
        result = result + sin_val

        # Iteration 4
        let pow_val = pow(2.0, 10.0)
        result = result + pow_val

        # Iteration 5
        let sqrt_val = sqrt(result)
        result = sqrt_val

        PrintToScreen("StdlibShowcase [SUBSYSTEM] Math stress-test result: " + float_to_string(result))
        return result

    # Run a gameplay simulation stress-test from the subsystem
    @blueprint_callable
    fn RunGameplayStressTest() -> DiagnosticSummary:
        let summary = DiagnosticSummary()
        summary.total_tests = 0
        summary.passed = 0
        summary.failed = 0
        summary.skipped = 0
        summary.duration_seconds = 0.0
        summary.stdlib_loaded = true

        let start_t = GetWorldTimeSeconds()

        # === Test Block: apply_damage chain ===
        let hp = 100.0
        let max_hp = 100.0
        let armor = 30.0

        let after_1 = apply_damage(hp, max_hp, 20.0, armor)
        let after_2 = apply_damage(after_1, max_hp, 20.0, armor)
        let after_3 = apply_damage(after_2, max_hp, 20.0, armor)
        let after_4 = apply_damage(after_3, max_hp, 20.0, armor)

        summary.total_tests = summary.total_tests + 4
        # Each apply_damage with 30 armor on 20 dmg → should reduce, HP should still be > 0
        if after_4 > 0.0:
            summary.passed = summary.passed + 4
        else:
            summary.failed = summary.failed + 4

        # === Test Block: XP progression ===
        let xp = 0.0
        xp = xp + 100.0
        let level_1 = calculate_level_from_xp(xp)
        xp = xp + 400.0
        let level_2 = calculate_level_from_xp(xp)
        xp = xp + 500.0
        let level_3 = calculate_level_from_xp(xp)
        summary.total_tests = summary.total_tests + 3
        if level_3 > level_1:
            summary.passed = summary.passed + 3
        else:
            summary.failed = summary.failed + 3

        # === Test Block: buff stacking ===
        let b0 = calculate_buff_value(10.0, 0, 0.1)
        let b1 = calculate_buff_value(10.0, 1, 0.1)
        let b2 = calculate_buff_value(10.0, 2, 0.1)
        summary.total_tests = summary.total_tests + 3
        if b2 > b1 && b1 > b0:
            summary.passed = summary.passed + 3
        else:
            summary.failed = summary.failed + 3

        # === Test Block: cooldown system ===
        let cd_off = is_on_cooldown(0.0)
        let cd_on = is_on_cooldown(1.0)
        summary.total_tests = summary.total_tests + 2
        if !cd_off && cd_on:
            summary.passed = summary.passed + 2
        else:
            summary.failed = summary.failed + 2

        summary.duration_seconds = GetWorldTimeSeconds() - start_t

        PrintToScreen("StdlibShowcase [SUBSYSTEM] Gameplay stress: " + int_to_string(summary.passed) + "/" + int_to_string(summary.total_tests) + " passed in " + float_to_string(summary.duration_seconds) + "s")
        RecordDiagnosticRun(summary.passed, summary.failed, summary.duration_seconds)

        return summary

    # Draw world-space aggregate status overlay using debug draw stdlib functions
    fn DrawAggregateDebugOverlay(now: Float):
        let uptime = now - subsystem_start_time
        let pass_rate = GetAggregatePassRate()

        # Color the sphere green if pass_rate > 0.8, yellow > 0.5, red otherwise
        let sphere_color = vec3(1.0, 0.0, 0.0)
        if pass_rate > 0.8:
            sphere_color = vec3(0.0, 1.0, 0.2)
        if pass_rate > 0.5 && pass_rate <= 0.8:
            sphere_color = vec3(1.0, 0.8, 0.0)

        let overlay_pos = aggregate_debug_origin + vec3(0.0, 0.0, 300.0)
        DrawDebugSphere(overlay_pos, 60.0, sphere_color, 2.5)
        DrawDebugString(overlay_pos + vec3(0.0, 0.0, 80.0), "Stdlib Diagnostic", vec3(1.0, 1.0, 1.0), 2.5)
        DrawDebugString(overlay_pos + vec3(0.0, 0.0, 50.0), "Runs: " + int_to_string(total_diagnostic_runs), vec3(0.8, 0.8, 1.0), 2.5)
        DrawDebugString(overlay_pos + vec3(0.0, 0.0, 20.0), "Pass: " + float_to_string(pass_rate * 100.0) + "%", sphere_color, 2.5)
        DrawDebugString(overlay_pos + vec3(0.0, 0.0, -10.0), "Uptime: " + float_to_string(uptime) + "s", vec3(0.6, 0.6, 0.6), 2.5)

        # Draw a line from origin to overlay position
        DrawDebugLine(aggregate_debug_origin, overlay_pos, sphere_color, 2.5, 1.0)

    # Enable/disable verbose log output
    @blueprint_callable
    fn SetVerboseLogging(enabled: Bool):
        verbose_logging = enabled

    # Enable/disable world-space debug overlay
    @blueprint_callable
    fn SetDebugOverlay(enabled: Bool, origin: Vec3):
        draw_aggregate_debug = enabled
        aggregate_debug_origin = origin
