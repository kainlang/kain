# ============================================================================
# STDLIB SHOWCASE — Diagnostics
# ============================================================================
# Blueprint function library containing standalone diagnostic helpers.
# These are @blueprint functions that exercise stdlib without needing actors.
# Used by the editor UI and by automated test runs (kain run / kain test).
#
# Exercises ALL callable stdlib categories systematically:
# - actor.kn, world.kn, gameplay.kn, math.kn, utilities.kn (full coverage)
# - materials.kn, particles.kn (declaration-level — no live mesh needed)
# ============================================================================

# ============================================================================
# SECTION 1: MATH DIAGNOSTICS (math.kn full coverage)
# ============================================================================

@blueprint
fn diag_math_scalar() -> Bool:
    let sq = sqrt(9.0)
    let pw = pow(2.0, 3.0)
    let ab = abs(-5.0)
    let mn = min(3.0, 7.0)
    let mx = max(3.0, 7.0)
    let fl = floor(2.9)
    let ce = ceil(2.1)
    let rn = round(2.5)
    let cl = clamp(15.0, 0.0, 10.0)
    let rng = random()

    let ok = is_nearly_equal(sq, 3.0, 0.001)
    ok = ok && is_nearly_equal(pw, 8.0, 0.001)
    ok = ok && is_nearly_equal(ab, 5.0, 0.001)
    ok = ok && is_nearly_equal(mn, 3.0, 0.001)
    ok = ok && is_nearly_equal(mx, 7.0, 0.001)
    ok = ok && is_nearly_equal(fl, 2.0, 0.001)
    ok = ok && is_nearly_equal(ce, 3.0, 0.001)
    ok = ok && is_nearly_equal(rn, 3.0, 0.001)
    ok = ok && is_nearly_equal(cl, 10.0, 0.001)
    ok = ok && rng >= 0.0 && rng <= 1.0
    return ok

@blueprint
fn diag_math_trig() -> Bool:
    let s = sin(0.0)        # → 0.0
    let c = cos(0.0)        # → 1.0
    let t = tan(0.0)        # → 0.0
    let as_val = asin(1.0)  # → PI/2 ≈ 1.5708
    let ac_val = acos(1.0)  # → 0.0
    let at_val = atan(1.0)  # → PI/4 ≈ 0.7854
    let at2 = atan2(1.0, 1.0) # → PI/4 ≈ 0.7854

    let ok = is_nearly_equal(s, 0.0, 0.001)
    ok = ok && is_nearly_equal(c, 1.0, 0.001)
    ok = ok && is_nearly_equal(t, 0.0, 0.001)
    ok = ok && is_nearly_equal(as_val, 1.5708, 0.001)
    ok = ok && is_nearly_equal(ac_val, 0.0, 0.001)
    ok = ok && is_nearly_equal(at_val, 0.7854, 0.001)
    ok = ok && is_nearly_equal(at2, 0.7854, 0.001)
    return ok

@blueprint
fn diag_math_vector() -> Bool:
    let v1 = vec3(1.0, 0.0, 0.0)
    let v2 = vec3(0.0, 1.0, 0.0)

    let len_v1 = Vector_Length(v1)
    let norm_v1 = Vector_Normalize(v1)
    let dot = Vector_Dot(v1, v2)          # → 0 (perpendicular)
    let cross = Vector_Cross(v1, v2)       # → (0,0,1)
    let cross_len = Vector_Length(cross)   # → 1.0
    let dist = Vector_Distance(v1, v2)    # → sqrt(2) ≈ 1.414

    let ok = is_nearly_equal(len_v1, 1.0, 0.001)
    ok = ok && is_nearly_equal(dot, 0.0, 0.001)
    ok = ok && is_nearly_equal(cross_len, 1.0, 0.001)
    ok = ok && is_nearly_equal(dist, 1.4142, 0.001)
    return ok

@blueprint
fn diag_math_interpolation() -> Bool:
    let lerp_0 = Lerp(0.0, 100.0, 0.0)   # → 0
    let lerp_m = Lerp(0.0, 100.0, 0.5)   # → 50
    let lerp_1 = Lerp(0.0, 100.0, 1.0)   # → 100

    let vlerp_0 = VLerp(vec3(0.0,0.0,0.0), vec3(10.0,10.0,10.0), 0.5)

    let interp_step = FInterpTo(0.0, 100.0, 0.016, 5.0)

    let ok = is_nearly_equal(lerp_0, 0.0, 0.001)
    ok = ok && is_nearly_equal(lerp_m, 50.0, 0.001)
    ok = ok && is_nearly_equal(lerp_1, 100.0, 0.001)
    ok = ok && is_nearly_equal(vlerp_0.x, 5.0, 0.001)
    ok = ok && interp_step > 0.0
    return ok

# ============================================================================
# SECTION 2: UTILITY DIAGNOSTICS (utilities.kn full coverage)
# ============================================================================

@blueprint
fn diag_util_remap() -> Bool:
    let r1 = remap(0.0, 0.0, 100.0, 0.0, 1.0)    # → 0.0
    let r2 = remap(50.0, 0.0, 100.0, 0.0, 1.0)   # → 0.5
    let r3 = remap(100.0, 0.0, 100.0, 0.0, 1.0)  # → 1.0
    let r4 = remap(25.0, 0.0, 100.0, -1.0, 1.0)  # → -0.5
    let ok = is_nearly_equal(r1, 0.0, 0.001)
    ok = ok && is_nearly_equal(r2, 0.5, 0.001)
    ok = ok && is_nearly_equal(r3, 1.0, 0.001)
    ok = ok && is_nearly_equal(r4, -0.5, 0.001)
    return ok

@blueprint
fn diag_util_smooth_step() -> Bool:
    let s0 = smooth_step(0.0, 1.0, 0.0)    # → 0.0
    let s1 = smooth_step(0.0, 1.0, 1.0)    # → 1.0
    let s_m = smooth_step(0.0, 1.0, 0.5)   # → 0.5
    # smooth_step is monotone increasing in [0,1]
    let s_low = smooth_step(0.0, 1.0, 0.25)
    let s_high = smooth_step(0.0, 1.0, 0.75)
    let ok = is_nearly_equal(s0, 0.0, 0.001)
    ok = ok && is_nearly_equal(s1, 1.0, 0.001)
    ok = ok && is_nearly_equal(s_m, 0.5, 0.001)
    ok = ok && s_low < s_m
    ok = ok && s_high > s_m
    return ok

@blueprint
fn diag_util_ease() -> Bool:
    let e0 = ease_in_out(0.0)   # → 0.0
    let e1 = ease_in_out(1.0)   # → 1.0
    let e_m = ease_in_out(0.5)  # → 0.5 (symmetric)
    let ok = is_nearly_equal(e0, 0.0, 0.001)
    ok = ok && is_nearly_equal(e1, 1.0, 0.001)
    ok = ok && is_nearly_equal(e_m, 0.5, 0.001)
    return ok

@blueprint
fn diag_util_ping_pong() -> Bool:
    let pp0 = ping_pong(0.0, 1.0)    # → 0.0
    let pp_q = ping_pong(0.25, 1.0)  # → 0.25
    let pp_h = ping_pong(0.5, 1.0)   # → 0.5
    let pp_tq = ping_pong(0.75, 1.0) # → 0.75
    let pp1 = ping_pong(1.0, 1.0)    # → 1.0
    let pp_wr = ping_pong(1.5, 1.0)  # → 0.5 (wraps back)
    let pp2 = ping_pong(2.0, 1.0)    # → 0.0
    let ok = is_nearly_equal(pp0, 0.0, 0.001)
    ok = ok && is_nearly_equal(pp_h, 0.5, 0.001)
    ok = ok && is_nearly_equal(pp1, 1.0, 0.001)
    ok = ok && is_nearly_equal(pp_wr, 0.5, 0.001)
    ok = ok && is_nearly_equal(pp2, 0.0, 0.001)
    return ok

@blueprint
fn diag_util_clamp_and_random() -> Bool:
    let c_low = clamp_float(-10.0, 0.0, 100.0)    # → 0
    let c_high = clamp_float(200.0, 0.0, 100.0)   # → 100
    let c_mid = clamp_float(50.0, 0.0, 100.0)     # → 50
    let r = random_float_range(5.0, 10.0)
    let ok = is_nearly_equal(c_low, 0.0, 0.001)
    ok = ok && is_nearly_equal(c_high, 100.0, 0.001)
    ok = ok && is_nearly_equal(c_mid, 50.0, 0.001)
    ok = ok && r >= 5.0 && r <= 10.0
    return ok

@blueprint
fn diag_util_color_conversion() -> Bool:
    # Red (hue=0, sat=1, val=1) → RGB(1,0,0)
    let red = hsv_to_rgb(vec3(0.0, 1.0, 1.0))
    # Green (hue=120) → RGB(0,1,0)
    let green = hsv_to_rgb(vec3(120.0, 1.0, 1.0))
    # Blue (hue=240) → RGB(0,0,1)
    let blue = hsv_to_rgb(vec3(240.0, 1.0, 1.0))
    let ok = is_nearly_equal(red.x, 1.0, 0.01)
    ok = ok && is_nearly_equal(red.y, 0.0, 0.01)
    ok = ok && is_nearly_equal(green.y, 1.0, 0.01)
    ok = ok && is_nearly_equal(blue.z, 1.0, 0.01)
    return ok

@blueprint
fn diag_util_string_conversions() -> Bool:
    let si = int_to_string(999)
    let sf = float_to_string(3.14)
    let sb_t = bool_to_string(true)
    let sb_f = bool_to_string(false)
    # These just need to not crash — we can't easily compare strings without stdlib fn
    let ne = is_nearly_equal(0.0, 0.0, 0.001)   # Always true
    return ne

@blueprint
fn diag_util_is_nearly_equal() -> Bool:
    let close = is_nearly_equal(1.0001, 1.0, 0.001)    # true
    let far = is_nearly_equal(1.1, 1.0, 0.001)          # false
    let exact = is_nearly_equal(42.0, 42.0, 0.0)        # true
    let negative = is_nearly_equal(-5.0, -5.0, 0.001)   # true
    let ok = close && !far && exact && negative
    return ok

# ============================================================================
# SECTION 3: GAMEPLAY DIAGNOSTICS (gameplay.kn full coverage)
# ============================================================================

@blueprint
fn diag_gameplay_damage() -> Bool:
    # apply_damage should reduce health and respect bounds
    let hp = apply_damage(100.0, 100.0, 30.0, 0.0)     # 100-30 = 70
    let hp2 = apply_damage(hp, 100.0, 80.0, 0.0)        # 70-80 = 0 (clamped)
    let hp_armor = apply_damage(100.0, 100.0, 30.0, 25.0) # armor reduces it

    let ok = is_nearly_equal(hp, 70.0, 0.1)
    ok = ok && is_nearly_equal(hp2, 0.0, 0.1)
    ok = ok && hp_armor > 70.0  # Armor should mean less damage taken
    return ok

@blueprint
fn diag_gameplay_armor_mitigation() -> Bool:
    # No armor → full damage passes through
    let mit_0 = calculate_armor_mitigation(100.0, 0.0)    # ≈ 100
    # Heavy armor → significant reduction
    let mit_100 = calculate_armor_mitigation(100.0, 100.0) # ~50 (50% reduction at 100 armor)
    # Moderate armor
    let mit_25 = calculate_armor_mitigation(100.0, 25.0)   # between 50 and 100
    let ok = is_nearly_equal(mit_0, 100.0, 0.1)
    ok = ok && mit_100 < 100.0
    ok = ok && mit_25 > mit_100
    ok = ok && mit_25 < mit_0
    return ok

@blueprint
fn diag_gameplay_crit() -> Bool:
    # calculate_crit_damage: base * multiplier
    let crit_2x = calculate_crit_damage(50.0, 2.0)    # → 100
    let crit_15x = calculate_crit_damage(50.0, 1.5)   # → 75
    # should_crit with 100% chance should always crit
    # should_crit with 0% chance should never crit
    let ok = is_nearly_equal(crit_2x, 100.0, 0.1)
    ok = ok && is_nearly_equal(crit_15x, 75.0, 0.1)
    return ok

@blueprint
fn diag_gameplay_xp() -> Bool:
    # Level 1 at 0 XP, higher levels at higher XP
    let lvl_0 = calculate_level_from_xp(0.0)
    let lvl_100 = calculate_level_from_xp(100.0)
    let lvl_1000 = calculate_level_from_xp(1000.0)
    let xp_for_2 = get_xp_for_level(2)
    let xp_for_5 = get_xp_for_level(5)
    let ok = lvl_0 >= 1
    ok = ok && lvl_1000 > lvl_100
    ok = ok && xp_for_5 > xp_for_2
    return ok

@blueprint
fn diag_gameplay_cooldown() -> Bool:
    # 0.0 timer → not on cooldown
    let off = is_on_cooldown(0.0)
    # positive timer → on cooldown
    let on = is_on_cooldown(1.0)
    let on_big = is_on_cooldown(99.0)
    return !off && on && on_big

@blueprint
fn diag_gameplay_buffs() -> Bool:
    # With 0 stacks → base value
    let b0 = calculate_buff_value(10.0, 0, 0.1)
    # With 1 stack → extra magnitude
    let b1 = calculate_buff_value(10.0, 1, 0.1)
    # With 5 stacks → more extra magnitude
    let b5 = calculate_buff_value(10.0, 5, 0.1)
    # Stacking must be monotone increasing
    let ok = b0 >= 10.0
    ok = ok && b1 > b0
    ok = ok && b5 > b1
    return ok

# ============================================================================
# SECTION 4: MASTER DIAGNOSTIC RUNNER
# Aggregates all diag_ functions into one pass/fail report.
# Called by StdlibManagerActor and by StdlibShowcaseSubsystem.
# ============================================================================

@blueprint
fn RunFullStdlibDiagnostics() -> DiagnosticSummary:
    let summary = DiagnosticSummary()
    summary.total_tests = 0
    summary.passed = 0
    summary.failed = 0
    summary.skipped = 0
    summary.duration_seconds = 0.0
    summary.stdlib_loaded = true

    let start_t = GetWorldTimeSeconds()

    # --- MATH ---
    let m1 = diag_math_scalar()
    let m2 = diag_math_trig()
    let m3 = diag_math_vector()
    let m4 = diag_math_interpolation()
    summary.total_tests = summary.total_tests + 4
    if m1: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if m2: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if m3: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if m4: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1

    # --- UTILITIES ---
    let u1 = diag_util_remap()
    let u2 = diag_util_smooth_step()
    let u3 = diag_util_ease()
    let u4 = diag_util_ping_pong()
    let u5 = diag_util_clamp_and_random()
    let u6 = diag_util_color_conversion()
    let u7 = diag_util_string_conversions()
    let u8 = diag_util_is_nearly_equal()
    summary.total_tests = summary.total_tests + 8
    if u1: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if u2: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if u3: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if u4: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if u5: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if u6: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if u7: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if u8: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1

    # --- GAMEPLAY ---
    let g1 = diag_gameplay_damage()
    let g2 = diag_gameplay_armor_mitigation()
    let g3 = diag_gameplay_crit()
    let g4 = diag_gameplay_xp()
    let g5 = diag_gameplay_cooldown()
    let g6 = diag_gameplay_buffs()
    summary.total_tests = summary.total_tests + 6
    if g1: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if g2: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if g3: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if g4: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if g5: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1
    if g6: summary.passed = summary.passed + 1 else: summary.failed = summary.failed + 1

    summary.duration_seconds = GetWorldTimeSeconds() - start_t

    # Print summary to screen
    PrintToScreen("=== STDLIB DIAGNOSTICS COMPLETE ===")
    PrintToScreen("Tests: " + int_to_string(summary.total_tests))
    PrintToScreen("Passed: " + int_to_string(summary.passed))
    PrintToScreen("Failed: " + int_to_string(summary.failed))
    PrintToScreen("Time: " + float_to_string(summary.duration_seconds) + "s")

    if summary.failed == 0:
        PrintToScreen("*** ALL STDLIB TESTS PASSED ***")
    else:
        PrintToScreen("*** " + int_to_string(summary.failed) + " TESTS FAILED — check output log ***")

    return summary
