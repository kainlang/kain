        println("Starting level optimization from menu...")
    
    @menu_entry(path: "Tools/AutoInstancer", label: "Open Dashboard")
    fn on_open_dashboard():
        println("Opening AutoInstancer dashboard...")
    
    @menu_entry(path: "Tools/AutoInstancer", label: "Preview Optimization")
    fn on_preview_optimization():
        println("Previewing optimization...")
    
    @menu_entry(path: "Tools/AutoInstancer", label: "Revert Last Optimization")
    fn on_revert_optimization():
        println("Reverting last optimization...")
    
    @menu_entry(path: "Tools/AutoInstancer", label: "Settings")
    fn on_settings():
        println("Opening AutoInstancer settings...")
    
    @toolbar_button(section: "Content", icon: "Icons.Optimize", tooltip: "Optimize Level (AutoInstancer)")
    fn on_toolbar_optimize():
        println("Quick optimize from toolbar...")
    
    @toolbar_button(section: "Content", icon: "Icons.Dashboard", tooltip: "AutoInstancer Dashboard")
    fn on_toolbar_dashboard():
        println("Opening dashboard from toolbar...")

