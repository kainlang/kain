# ============================================================================
# AEROTUNNEL - Blade-Element Flight Physics & Wind Tunnel Editor
# ============================================================================
# A professional-grade UE5 plugin for realistic aerodynamic simulation:
# - True 6-DOF physics using Blade Element Theory
# - Wind tunnel editor with real-time force visualization
# - Dynamic debug lines (blue=lift, red=drag)
# - Live telemetry dashboard (G-Force, Mach, Stall warnings)
# - Works with any Skeletal or Static Mesh
# - 120hz physics sub-stepping independent of framerate
# - Real-world airfoil database (NACA 0012, Clark Y, etc.)
# - GPU-accelerated force calculations across mesh surface
# - Center of pressure and moment calculations
# - Stall detection with audio/visual warnings
# - Export flight data to CSV for analysis
#
# Price Point: $499-699 (Professional/Aerospace)
# Target: Flight sim developers, aerospace engineers, vehicle game devs
# Build: kain build --ue5
# ============================================================================

# ============================================================================
# SECTION 1: ENUMS - Flight regimes and aerodynamic states
# ============================================================================

enum FlightRegime:
    Subsonic         # Mach < 0.8
    Transonic        # Mach 0.8 - 1.2
    Supersonic       # Mach 1.2 - 5.0
    Hypersonic       # Mach > 5.0
    _MAX

enum AirfoilProfile:
    NACA0012         # Symmetric, general purpose
    NACA2412         # Cambered, high lift
    NACA4412         # High camber, max lift
    ClarkY           # Classic, stable
    NACA6409         # Laminar flow
    Flat             # Flat plate (simple)
    Custom           # User-defined
    _MAX

enum StallState:
    Normal           # Attached flow
    PreStall         # Approaching stall
    Stalled          # Flow separation
    DeepStall        # Unrecoverable stall
    _MAX

enum ControlSurface:
    Elevator         # Pitch control
    Aileron          # Roll control
    Rudder           # Yaw control
    Flap             # High-lift device
    Spoiler          # Drag/lift dump
    _MAX

enum DebugVisualizationMode:
    None
    ForceVectors     # Show lift/drag vectors
    PressureMap      # Color-coded pressure
    VelocityField    # Airflow visualization
    StallRegions     # Highlight stalled areas
    All              # Everything
    _MAX

enum WindTunnelMode:
    Static           # Fixed wind speed
    Dynamic          # Variable wind
    Gust             # Turbulence simulation
    Vortex           # Vortex wake
    _MAX

# ============================================================================
# SECTION 2: DATATABLES - Airfoil profiles and configuration
# ============================================================================

@datatable
struct AirfoilData:
    id: Int
    profile_name: String
    profile_type: Int          # AirfoilProfile enum (stored as int for datatable compatibility)
    max_cl: Float              # Maximum lift coefficient
    cl_alpha: Float            # Lift curve slope (per radian)
    cd_min: Float              # Minimum drag coefficient
    cd_k: Float                # Induced drag factor
    stall_angle_deg: Float     # Stall angle of attack
    zero_lift_angle_deg: Float # Zero-lift angle
    moment_coefficient: Float  # Pitching moment coefficient
    reynolds_number: Float     # Design Reynolds number
    description: String

@datatable
struct FlightTestData:
    test_id: Int
    aircraft_name: String
    timestamp: Float
    altitude_m: Float
    airspeed_ms: Float
    mach_number: Float
    angle_of_attack_deg: Float
    sideslip_deg: Float
    lift_force_n: Float
    drag_force_n: Float
    g_force: Float
    stall_state: Int           # StallState enum (stored as int for datatable compatibility)
    notes: String

@datatable
struct ControlSurfaceConfig:
    id: Int
    surface_name: String
    surface_type: Int          # ControlSurface enum (stored as int for datatable compatibility)
    area_m2: Float
    chord_m: Float
    span_m: Float
    max_deflection_deg: Float
    effectiveness: Float       # 0.0 - 1.0
    hinge_moment_coeff: Float

# ============================================================================
# SECTION 3: STRUCTS - Aerodynamic data structures
# ============================================================================

struct BladeElement:
    position: Vec3             # Element center position
    normal: Vec3               # Surface normal
    area: Float                # Element area (m²)
    chord: Float               # Local chord length (m)
    span: Float                # Spanwise width (m)
    angle_of_attack: Float     # Local AoA (radians)
    relative_velocity: Vec3    # Local airflow velocity
    lift_force: Vec3           # Computed lift force
    drag_force: Vec3           # Computed drag force
    pressure_coefficient: Float # Cp value

struct AerodynamicForces:
    total_lift: Vec3           # Total lift vector (N)
    total_drag: Vec3           # Total drag vector (N)
    total_moment: Vec3         # Total moment (N·m)
    center_of_pressure: Vec3   # CoP location
    lift_coefficient: Float    # CL
    drag_coefficient: Float    # CD
    moment_coefficient: Float  # CM
    dynamic_pressure: Float    # q = 0.5 * ρ * V²

struct FlightState:
    position: Vec3
    velocity: Vec3
    acceleration: Vec3
    angular_velocity: Vec3
    angular_acceleration: Vec3
    orientation: Vec3          # Euler angles (pitch, yaw, roll)
    airspeed: Float            # m/s
    mach_number: Float
    altitude: Float            # meters
    g_force: Float
    regime: FlightRegime
    stall_state: StallState

struct AtmosphericConditions:
    air_density: Float         # kg/m³ (1.225 at sea level)
    temperature: Float         # Kelvin
    pressure: Float            # Pascals
    speed_of_sound: Float      # m/s (343 at sea level)
    wind_velocity: Vec3        # Wind vector
    turbulence_intensity: Float

# ============================================================================
# SECTION 4: COMPONENTS - Aerodynamic system components
# ============================================================================

@component
struct AerodynamicComponent:
    # Mesh analysis
    blade_element_count: Int
    total_wing_area: Float     # m²
    wing_span: Float           # m
    mean_chord: Float          # m
    aspect_ratio: Float        # span² / area
    
    # Airfoil configuration
    airfoil_profile: AirfoilProfile
    
    # Current aerodynamic state (components can't replicate - use actor state instead)
    current_lift: Vec3
    current_drag: Vec3
    current_moment: Vec3
    
    @transient
    needs_recalculation: Bool
    
    # Performance tracking
    @savegame
    max_g_force_recorded: Float
    
    @savegame
    max_speed_recorded: Float

@component
struct WindTunnelComponent:
    wind_speed: Float          # m/s
    wind_direction: Vec3
    tunnel_mode: WindTunnelMode
    
    @transient
    is_simulating: Bool
    
    @transient
    simulation_time: Float
    
    turbulence_scale: Float
    gust_frequency: Float

@component
struct TelemetryComponent:
    @transient
    current_g_force: Float
    
    @transient
    current_mach: Float
    
    @transient
    current_aoa: Float         # Angle of attack (degrees)
    
    @transient
    stall_warning_active: Bool
    
    # History buffers for graphs (last 300 samples = 5 seconds at 60hz)
    @transient
    g_force_history: Array<Float>
    
    @transient
    mach_history: Array<Float>
    
    @transient
    aoa_history: Array<Float>
    
    recording_enabled: Bool
    sample_rate_hz: Float


# ============================================================================
# SECTION 5: COMPUTE SHADERS - GPU-accelerated force calculations
# ============================================================================

# Main blade element force calculation shader
# Computes lift and drag for each mesh element using blade element theory
shader compute BladeElementForces(thread_id: Vec3) -> Unit:
    # Quality permutations
    uniform CFG_HIGH_PRECISION: Float @0
    uniform CFG_COMPRESSIBILITY: Float @1  # Enable compressibility corrections
    uniform ENABLE_VISCOUS_EFFECTS: Float @2
    
    # Mesh data
    uniform vertex_positions: RWBuffer<Vec4> @3
    uniform vertex_normals: RWBuffer<Vec4> @4
    uniform element_count: Int @5
    
    # Aerodynamic parameters
    uniform freestream_velocity: Vec3 @6
    uniform air_density: Float @7
    uniform speed_of_sound: Float @8
    uniform airfoil_cl_alpha: Float @9    # Lift curve slope
    uniform airfoil_cd_min: Float @10     # Minimum drag coefficient
    uniform airfoil_stall_angle: Float @11 # Stall angle (radians)
    
    # Output buffers
    uniform lift_forces: RWBuffer<Vec4> @12
    uniform drag_forces: RWBuffer<Vec4> @13
    uniform pressure_coefficients: RWBuffer<Float> @14
    
    let idx = thread_id.x
    
    if idx >= element_count:
        return
    
    # Load element data
    let pos = vertex_positions[idx].xyz
    let normal = normalize(vertex_normals[idx].xyz)
    
    # Calculate relative velocity (freestream - element velocity)
    let rel_velocity = freestream_velocity
    let v_magnitude = length(rel_velocity)
    
    if v_magnitude < 0.01:
        # No flow, no forces
        lift_forces[idx] = vec4(0, 0, 0, 0)
        drag_forces[idx] = vec4(0, 0, 0, 0)
        pressure_coefficients[idx] = 0.0
        return
    
    let v_direction = normalize(rel_velocity)
    
    # Calculate angle of attack (angle between velocity and chord line)
    # Assuming chord line is perpendicular to normal
    let chord_direction = cross(normal, vec3(0, 0, 1))
    let aoa = asin(dot(v_direction, normal))
    
    # Dynamic pressure: q = 0.5 * ρ * V²
    let dynamic_pressure = 0.5 * air_density * v_magnitude * v_magnitude
    
    # Mach number for compressibility corrections
    var mach = v_magnitude / speed_of_sound
    
    # Prandtl-Glauert compressibility correction (subsonic)
    var beta = 1.0
    if CFG_COMPRESSIBILITY:
        if mach < 0.8:
            beta = sqrt(1.0 - mach * mach)
        else:
            # Transonic/supersonic - use simplified model
            beta = 0.5
    
    # Lift coefficient calculation
    var cl = 0.0
    if abs(aoa) < airfoil_stall_angle:
        # Linear region: CL = CL_alpha * α
        cl = airfoil_cl_alpha * aoa / beta
    else:
        # Post-stall: reduced lift
        cl = airfoil_cl_alpha * airfoil_stall_angle * 0.5 / beta
    
    # Drag coefficient calculation
    # CD = CD_min + K * CL²  (induced drag)
    let k_induced = 0.05  # Induced drag factor
    var cd = airfoil_cd_min + k_induced * cl * cl
    
    # Add viscous drag if enabled
    if ENABLE_VISCOUS_EFFECTS:
        # Reynolds number effects (simplified)
        let re = v_magnitude * 1.0 / 0.000015  # Simplified Re
        let cf = 0.074 / pow(re, 0.2)  # Skin friction coefficient
        cd = cd + cf
    
    # High precision mode - more accurate force calculation
    if CFG_HIGH_PRECISION:
        # Use more accurate trigonometric functions
        let sin_aoa = sin(aoa)
        let cos_aoa = cos(aoa)
        
        # Lift perpendicular to velocity
        let lift_direction = cross(v_direction, cross(v_direction, normal))
        let lift_magnitude = cl * dynamic_pressure * 1.0  # Area = 1.0 per element
        let lift = normalize(lift_direction) * lift_magnitude
        
        # Drag parallel to velocity
        let drag_magnitude = cd * dynamic_pressure * 1.0
        let drag = v_direction * drag_magnitude
        
        lift_forces[idx] = vec4(lift, 0)
        drag_forces[idx] = vec4(drag, 0)
    else:
        # Fast mode - simplified calculation
        let lift_magnitude = cl * dynamic_pressure
        let drag_magnitude = cd * dynamic_pressure
        
        lift_forces[idx] = vec4(normal * lift_magnitude, 0)
        drag_forces[idx] = vec4(v_direction * drag_magnitude, 0)
    
    # Pressure coefficient: Cp = (p - p∞) / q
    let cp = 1.0 - (v_magnitude / length(freestream_velocity)) * (v_magnitude / length(freestream_velocity))
    pressure_coefficients[idx] = cp

# Vortex wake simulation shader
# Simulates trailing vortices for induced drag calculation
shader compute VortexWake(thread_id: Vec3) -> Unit:
    uniform CFG_HIGH_FIDELITY: Float @0
    
    uniform vortex_positions: RWBuffer<Vec4> @1
    uniform vortex_strengths: RWBuffer<Float> @2
    uniform vortex_count: Int @3
    uniform delta_time: Float @4
    uniform freestream_velocity: Vec3 @5
    
    let idx = thread_id.x
    
    if idx >= vortex_count:
        return
    
    var pos = vortex_positions[idx].xyz
    let strength = vortex_strengths[idx]
    
    # Convect vortex with freestream
    pos = pos + freestream_velocity * delta_time
    
    # Vortex decay (viscous dissipation)
    let decay_rate = 0.01
    vortex_strengths[idx] = strength * (1.0 - decay_rate * delta_time)
    
    if CFG_HIGH_FIDELITY:
        # Vortex-vortex interaction (simplified)
        for i in range(vortex_count):
            if i != idx:
                let other_pos = vortex_positions[i].xyz
                let r = pos - other_pos
                let dist = length(r)
                
                if dist > 0.1:
                    # Biot-Savart law (simplified)
                    let induced_velocity = cross(r, vec3(0, 0, 1)) / (dist * dist)
                    pos = pos + induced_velocity * delta_time * 0.1
    
    vortex_positions[idx] = vec4(pos, 1.0)

# Atmospheric turbulence shader
# Generates realistic turbulence for wind tunnel simulation
shader compute AtmosphericTurbulence(thread_id: Vec3) -> Unit:
    uniform turbulence_field: RWBuffer<Vec4> @0
    uniform field_size: Int @1
    uniform time: Float @2
    uniform intensity: Float @3
    uniform frequency: Float @4
    
    let idx = thread_id.x
    
    if idx >= field_size:
        return
    
    # 3D Perlin-like noise (simplified)
    let x = float(idx % 64) / 64.0
    let y = float((idx / 64) % 64) / 64.0
    let z = float(idx / 4096) / 64.0
    
    let noise_x = sin(x * frequency + time) * cos(y * frequency)
    let noise_y = sin(y * frequency + time) * cos(z * frequency)
    let noise_z = sin(z * frequency + time) * cos(x * frequency)
    
    let turbulence = vec3(noise_x, noise_y, noise_z) * intensity
    
    turbulence_field[idx] = vec4(turbulence, 0)

# Stall detection shader
# Analyzes flow separation across mesh surface
shader compute StallDetection(thread_id: Vec3) -> Unit:
    uniform vertex_normals: RWBuffer<Vec4> @0
    uniform pressure_coefficients: RWBuffer<Float> @1
    uniform element_count: Int @2
    uniform stall_threshold: Float @3
    uniform stall_flags: RWBuffer<Int> @4
    
    let idx = thread_id.x
    
    if idx >= element_count:
        return
    
    let cp = pressure_coefficients[idx]
    
    # Stall detection based on pressure coefficient
    # Negative Cp indicates suction (attached flow)
    # Positive Cp near stall threshold indicates separation
    if cp > stall_threshold:
        stall_flags[idx] = 1  # Stalled
    else:
        stall_flags[idx] = 0  # Attached flow


# ============================================================================
# SECTION 6: MATERIAL GRAPHS - Visualization materials
# ============================================================================

@material_graph(blend_mode = Opaque, shading_model = DefaultLit)
material PressureVisualization:
    input pressure_coefficient: Float = 0.0
    input min_pressure: Float = -2.0
    input max_pressure: Float = 2.0
    
    # Map pressure to color gradient
    # Blue (high suction) -> Green (neutral) -> Red (high pressure)
    let normalized = (pressure_coefficient - min_pressure) / (max_pressure - min_pressure)
    let clamped = clamp(normalized, constant_float(0.0), constant_float(1.0))
    
    # Color gradient using mix
    let blue_green = mix(vec3(0, 0, 1), vec3(0, 1, 0), multiply(clamped, constant_float(2.0)))
    let green_red = mix(vec3(0, 1, 0), vec3(1, 0, 0), multiply(subtract(clamped, constant_float(0.5)), constant_float(2.0)))
    let color = mix(blue_green, green_red, step(constant_float(0.5), clamped))
    
    output base_color = color
    output metallic = constant_float(0.0)
    output roughness = constant_float(0.3)
    output emissive = multiply(color, constant_float(0.5))

@material_graph(blend_mode = Translucent, shading_model = Unlit)
material ForceVectorVisualization:
    input force_magnitude: Float = 0.0
    input force_type: Float = 0.0  # 0=lift (blue), 1=drag (red)
    input max_force: Float = 1000.0
    
    # Normalize force magnitude
    let normalized = force_magnitude / max_force
    let intensity = clamp(normalized, constant_float(0.0), constant_float(1.0))
    
    # Color based on force type using mix
    let lift_color = vec3(0.2, 0.5, 1.0)
    let drag_color = vec3(1.0, 0.3, 0.2)
    let color = mix(lift_color, drag_color, step(constant_float(0.5), force_type))
    
    let final_color = multiply(color, intensity)
    
    output base_color = final_color
    output emissive = multiply(final_color, constant_float(2.0))
    output opacity = multiply(intensity, constant_float(0.8))

@material_graph(blend_mode = Opaque, shading_model = DefaultLit)
material WindTunnelGrid:
    input grid_scale: Float = 10.0
    input grid_color: Vec3 = vec3(0.3, 0.3, 0.3)
    input background_color: Vec3 = vec3(0.1, 0.1, 0.1)
    input line_thickness: Float = 0.05
    
    # Grid pattern using world position
    let world_pos = world_position()
    let grid_x = fract(world_pos.x / grid_scale)
    let grid_y = fract(world_pos.y / grid_scale)
    
    # Determine if we're on a grid line using step
    let x_line = add(step(grid_x, line_thickness), step(subtract(constant_float(1.0), line_thickness), grid_x))
    let y_line = add(step(grid_y, line_thickness), step(subtract(constant_float(1.0), line_thickness), grid_y))
    let on_line = clamp(add(x_line, y_line), constant_float(0.0), constant_float(1.0))
    
    let final_color = mix(background_color, grid_color, on_line)
    
    output base_color = final_color
    output metallic = constant_float(0.0)
    output roughness = constant_float(0.9)

@material_graph(blend_mode = Translucent, shading_model = Unlit)
material StallWarningOverlay:
    input stall_intensity: Float = 0.0
    input pulse_frequency: Float = 2.0
    input time: Float = 0.0
    
    # Pulsing red warning
    let pulse = sin(time * pulse_frequency) * 0.5 + 0.5
    let warning_color = vec3(1.0, 0.0, 0.0)
    let intensity = multiply(stall_intensity, pulse)
    
    output base_color = warning_color
    output emissive = multiply(warning_color, multiply(intensity, constant_float(5.0)))
    output opacity = multiply(intensity, constant_float(0.6))

# ============================================================================
# SECTION 7: ACTORS - Aerodynamic simulation system
# ============================================================================

# Main aerodynamic actor with GPU force calculation
@dispatch("BladeElementForces", "VortexWake", "AtmosphericTurbulence", "StallDetection")
actor AerodynamicAircraft:
    # Replicated flight state
    @replicated
    state current_velocity: Vec3 = vec3(0, 0, 0)
    
    @replicated
    state current_position: Vec3 = vec3(0, 0, 0)
    
    @replicated
    state current_orientation: Vec3 = vec3(0, 0, 0)
    
    @replicated
    state airspeed: Float = 0.0
    
    @replicated
    state altitude: Float = 0.0
    
    @replicated
    state angle_of_attack: Float = 0.0
    
    # Components
    @component
    state aero: AerodynamicComponent = AerodynamicComponent{}
    
    @component
    state telemetry: TelemetryComponent = TelemetryComponent{}
    
    # Physics state
    state angular_velocity: Vec3 = vec3(0, 0, 0)
    state mass_kg: Float = 1000.0
    state moment_of_inertia: Vec3 = vec3(1000, 1000, 1000)
    
    # Atmospheric conditions
    state air_density: Float = 1.225  # kg/m³ at sea level
    state temperature: Float = 288.15  # Kelvin (15°C)
    state speed_of_sound: Float = 343.0  # m/s
    
    # Physics sub-stepping
    state physics_substep_hz: Float = 120.0
    state accumulated_time: Float = 0.0
    
    # Debug visualization
    @transient
    state show_force_vectors: Bool = true
    
    @transient
    state show_pressure_map: Bool = false
    
    @transient
    state visualization_mode: DebugVisualizationMode = DebugVisualizationMode::ForceVectors
    
    on BeginPlay():
        println("AerodynamicAircraft initialized")
        
        # Initialize aerodynamic component
        aero.blade_element_count = 0
        aero.total_wing_area = 20.0  # m²
        aero.wing_span = 10.0  # m
        aero.mean_chord = 2.0  # m
        aero.aspect_ratio = aero.wing_span * aero.wing_span / aero.total_wing_area
        aero.airfoil_profile = AirfoilProfile::NACA2412
        
        # Initialize telemetry
        telemetry.recording_enabled = true
        telemetry.sample_rate_hz = 60.0
        telemetry.stall_warning_active = false
        
        # Analyze mesh and create blade elements
        Server_AnalyzeMesh()
    
    on Tick(delta_time: Float):
        # Physics sub-stepping for stability
        accumulated_time = accumulated_time + delta_time
        let substep_dt = 1.0 / physics_substep_hz
        
        while accumulated_time >= substep_dt:
            Server_PhysicsSubstep(substep_dt)
            accumulated_time = accumulated_time - substep_dt
        
        # Update telemetry
        Server_UpdateTelemetry(delta_time)
        
        # GPU shaders dispatch automatically via @dispatch
        # BladeElementForces, VortexWake, AtmosphericTurbulence, StallDetection
        # all run on GPU every frame
    
    on Server_AnalyzeMesh():
        # This would analyze the attached mesh and create blade elements
        # For now, simulate mesh analysis
        aero.blade_element_count = 500
        println("Mesh analyzed: {aero.blade_element_count} blade elements created")
        Multicast_AnnounceAnalysisComplete(aero.blade_element_count)
    
    on Server_PhysicsSubstep(dt: Float):
        # Calculate aerodynamic forces (GPU shaders do the heavy lifting)
        # Here we just integrate the results
        
        # Update velocity from acceleration
        let acceleration = aero.current_lift + aero.current_drag
        current_velocity = current_velocity + acceleration * dt / mass_kg
        
        # Update position
        current_position = current_position + current_velocity * dt
        
        # Update angular velocity from moments
        let angular_accel = aero.current_moment / moment_of_inertia
        angular_velocity = angular_velocity + angular_accel * dt
        
        # Update orientation
        current_orientation = current_orientation + angular_velocity * dt
        
        # Calculate derived quantities
        airspeed = length(current_velocity)
        altitude = current_position.z
        
        # Calculate angle of attack (simplified)
        if airspeed > 0.1:
            let velocity_direction = normalize(current_velocity)
            let aircraft_forward = vec3(1, 0, 0)  # Simplified
            angle_of_attack = asin(dot(velocity_direction, aircraft_forward))
    
    on Server_UpdateTelemetry(dt: Float):
        # Update telemetry data
        let mach = airspeed / speed_of_sound
        telemetry.current_mach = mach
        
        # Calculate G-force
        let accel_magnitude = length(aero.current_lift + aero.current_drag) / mass_kg
        telemetry.current_g_force = accel_magnitude / 9.81
        
        telemetry.current_aoa = angle_of_attack * 57.2958  # Convert to degrees
        
        # Stall detection
        if abs(telemetry.current_aoa) > 15.0:
            telemetry.stall_warning_active = true
            Client_TriggerStallWarning()
        else:
            telemetry.stall_warning_active = false
        
        # Record to history buffers
        if telemetry.recording_enabled:
            # This would append to history arrays
            # Simplified for now
            pass
    
    on Server_SetAirfoilProfile(profile: AirfoilProfile):
        aero.airfoil_profile = profile
        aero.needs_recalculation = true
        Multicast_UpdateAirfoilProfile(profile)
    
    on Server_SetVisualizationMode(mode: DebugVisualizationMode):
        visualization_mode = mode
        Multicast_UpdateVisualization(mode)
    
    on Client_TriggerStallWarning():
        println("⚠️ STALL WARNING! Angle of attack: {telemetry.current_aoa}°")
    
    on Multicast_AnnounceAnalysisComplete(element_count: Int):
        println("Mesh analysis complete: {element_count} elements")
    
    on Multicast_UpdateAirfoilProfile(profile: AirfoilProfile):
        println("Airfoil profile changed to: {profile}")
    
    on Multicast_UpdateVisualization(mode: DebugVisualizationMode):
        println("Visualization mode: {mode}")
    
    # Blueprint-callable methods
    @blueprint_callable
    fn GetAirspeed() -> Float:
        return airspeed
    
    @blueprint_callable
    fn GetMachNumber() -> Float:
        return airspeed / speed_of_sound
    
    @blueprint_callable
    fn GetAngleOfAttack() -> Float:
        return angle_of_attack * 57.2958  # Degrees
    
    @blueprint_callable
    fn GetGForce() -> Float:
        return telemetry.current_g_force
    
    @blueprint_callable
    fn GetLiftForce() -> Vec3:
        return aero.current_lift
    
    @blueprint_callable
    fn GetDragForce() -> Vec3:
        return aero.current_drag
    
    @blueprint_callable
    fn GetCenterOfPressure() -> Vec3:
        # This would be calculated from blade element forces
        return vec3(0, 0, 0)
    
    @blueprint_pure
    fn IsStalled() -> Bool:
        return telemetry.stall_warning_active
    
    @blueprint_callable
    fn SetAirfoilProfile(profile: AirfoilProfile):
        Server_SetAirfoilProfile(profile)
    
    @blueprint_callable
    fn SetVisualizationMode(mode: DebugVisualizationMode):
        Server_SetVisualizationMode(mode)
    
    @blueprint_callable
    fn ExportFlightData() -> String:
        return "flight_data_export.csv"


# Wind tunnel simulation actor
actor WindTunnel:
    @replicated
    state wind_speed: Float = 50.0  # m/s
    
    @replicated
    state wind_direction: Vec3 = vec3(1, 0, 0)
    
    @replicated
    state is_active: Bool = false
    
    @component
    state tunnel: WindTunnelComponent = WindTunnelComponent{}
    
    state tunnel_dimensions: Vec3 = vec3(100, 50, 50)  # Length, width, height (m)
    state test_section_start: Vec3 = vec3(0, 0, 0)
    
    on BeginPlay():
        println("WindTunnel initialized")
        tunnel.wind_speed = wind_speed
        tunnel.wind_direction = wind_direction
        tunnel.tunnel_mode = WindTunnelMode::Static
        tunnel.turbulence_scale = 0.1
        tunnel.gust_frequency = 0.5
    
    on Tick(delta_time: Float):
        if is_active:
            tunnel.simulation_time = tunnel.simulation_time + delta_time
            
            # Update wind based on mode
            match tunnel.tunnel_mode:
                WindTunnelMode::Dynamic =>
                    # Vary wind speed sinusoidally
                    wind_speed = 50.0 + 20.0 * sin(tunnel.simulation_time * 0.5)
                WindTunnelMode::Gust =>
                    # Add turbulent gusts
                    let gust = sin(tunnel.simulation_time * tunnel.gust_frequency) * 10.0
                    wind_speed = 50.0 + gust
                _ =>
                    # Static mode - constant wind
                    wind_speed = 50.0
    
    on Server_StartSimulation():
        is_active = true
        tunnel.is_simulating = true
        tunnel.simulation_time = 0.0
        Multicast_AnnounceSimulationStart()
    
    on Server_StopSimulation():
        is_active = false
        tunnel.is_simulating = false
        Multicast_AnnounceSimulationStop()
    
    on Server_SetWindSpeed(speed: Float):
        wind_speed = speed
        tunnel.wind_speed = speed
        Multicast_UpdateWindSpeed(speed)
    
    on Server_SetTunnelMode(mode: WindTunnelMode):
        tunnel.tunnel_mode = mode
        Multicast_UpdateTunnelMode(mode)
    
    on Multicast_AnnounceSimulationStart():
        println("Wind tunnel simulation started")
    
    on Multicast_AnnounceSimulationStop():
        println("Wind tunnel simulation stopped")
    
    on Multicast_UpdateWindSpeed(speed: Float):
        println("Wind speed: {speed} m/s")
    
    on Multicast_UpdateTunnelMode(mode: WindTunnelMode):
        println("Tunnel mode: {mode}")
    
    @blueprint_callable
    fn StartSimulation():
        Server_StartSimulation()
    
    @blueprint_callable
    fn StopSimulation():
        Server_StopSimulation()
    
    @blueprint_callable
    fn SetWindSpeed(speed: Float):
        Server_SetWindSpeed(speed)
    
    @blueprint_callable
    fn SetTunnelMode(mode: WindTunnelMode):
        Server_SetTunnelMode(mode)
    
    @blueprint_pure
    fn IsSimulating() -> Bool:
        return is_active
    
    @blueprint_callable
    fn GetWindSpeed() -> Float:
        return wind_speed

# ============================================================================
# SECTION 8: BLUEPRINT FUNCTIONS - Aerodynamic calculations
# ============================================================================

@blueprint
fn CalculateLiftCoefficient(angle_of_attack_deg: Float, cl_alpha: Float, stall_angle_deg: Float) -> Float:
    # Convert to radians
    let aoa_rad = angle_of_attack_deg * 0.0174533
    let stall_rad = stall_angle_deg * 0.0174533
    
    if abs(aoa_rad) < stall_rad:
        # Linear region
        return cl_alpha * aoa_rad
    else:
        # Post-stall
        return cl_alpha * stall_rad * 0.5

@blueprint
fn CalculateDragCoefficient(cl: Float, cd_min: Float, aspect_ratio: Float) -> Float:
    # CD = CD_min + CL² / (π * AR * e)
    # Oswald efficiency factor e ≈ 0.8 for typical aircraft
    let e = 0.8
    let k = 1.0 / (3.14159 * aspect_ratio * e)
    return cd_min + k * cl * cl

@blueprint
fn CalculateDynamicPressure(air_density: Float, velocity: Float) -> Float:
    # q = 0.5 * ρ * V²
    return 0.5 * air_density * velocity * velocity

@blueprint
fn CalculateReynoldsNumber(velocity: Float, chord: Float, kinematic_viscosity: Float) -> Float:
    # Re = V * c / ν
    return velocity * chord / kinematic_viscosity

@blueprint
fn CalculateMachNumber(velocity: Float, speed_of_sound: Float) -> Float:
    return velocity / speed_of_sound

@blueprint
fn GetFlightRegime(mach: Float) -> FlightRegime:
    if mach < 0.8:
        return FlightRegime::Subsonic
    else:
        if mach < 1.2:
            return FlightRegime::Transonic
        else:
            if mach < 5.0:
                return FlightRegime::Supersonic
            else:
                return FlightRegime::Hypersonic

@blueprint
fn CalculateStallSpeed(mass_kg: Float, wing_area_m2: Float, air_density: Float, max_cl: Float) -> Float:
    # V_stall = sqrt((2 * W) / (ρ * S * CL_max))
    let weight_n = mass_kg * 9.81
    let v_stall_squared = (2.0 * weight_n) / (air_density * wing_area_m2 * max_cl)
    return sqrt(v_stall_squared)

@blueprint
fn CalculateGForce(lift_force_n: Float, mass_kg: Float) -> Float:
    # G = L / W
    let weight_n = mass_kg * 9.81
    return lift_force_n / weight_n

@blueprint
fn CalculateTurnRadius(velocity: Float, bank_angle_deg: Float) -> Float:
    # R = V² / (g * tan(φ))
    let bank_rad = bank_angle_deg * 0.0174533
    let g = 9.81
    return velocity * velocity / (g * tan(bank_rad))

@blueprint
fn GetAirfoilName(profile: AirfoilProfile) -> String:
    match profile:
        AirfoilProfile::NACA0012 => "NACA 0012 (Symmetric)"
        AirfoilProfile::NACA2412 => "NACA 2412 (Cambered)"
        AirfoilProfile::NACA4412 => "NACA 4412 (High Lift)"
        AirfoilProfile::ClarkY => "Clark Y (Classic)"
        AirfoilProfile::NACA6409 => "NACA 6409 (Laminar)"
        AirfoilProfile::Flat => "Flat Plate"
        _ => "Custom Airfoil"

@blueprint
fn FormatAirspeed(speed_ms: Float) -> String:
    let speed_kmh = speed_ms * 3.6
    let speed_knots = speed_ms * 1.94384
    return "{speed_ms} m/s ({speed_kmh} km/h, {speed_knots} knots)"

@blueprint
fn FormatAltitude(altitude_m: Float) -> String:
    let altitude_ft = altitude_m * 3.28084
    return "{altitude_m} m ({altitude_ft} ft)"

@blueprint
fn GetStallStateColor(stall_state: StallState) -> Vec3:
    match stall_state:
        StallState::Normal => vec3(0.0, 1.0, 0.0)      # Green
        StallState::PreStall => vec3(1.0, 1.0, 0.0)    # Yellow
        StallState::Stalled => vec3(1.0, 0.5, 0.0)     # Orange
        StallState::DeepStall => vec3(1.0, 0.0, 0.0)   # Red
        _ => vec3(0.5, 0.5, 0.5)

@blueprint_pure
fn IsSupersonic(mach: Float) -> Bool:
    return mach >= 1.2

@blueprint
fn CalculatePrandtlGlauertCorrection(mach: Float) -> Float:
    # β = sqrt(1 - M²) for subsonic
    if mach < 0.8:
        return sqrt(1.0 - mach * mach)
    else:
        # Simplified for transonic/supersonic
        return 0.5

