# SECTION 11: VIEWPORT - Wind tunnel 3D visualization
# ============================================================================

@viewport
struct WindTunnelViewport:
    @scene_actor
    aircraft_mesh: StaticMeshComponent
    
    @scene_actor
    tunnel_grid: StaticMeshComponent
    
    @scene_actor
    force_vector_visualizer: StaticMeshComponent
    
    @camera
    tunnel_camera: CameraComponent
    
    camera_distance: Float
    camera_angle: Vec2
    show_grid: Bool
    show_force_vectors: Bool
    
    fn on_viewport_tick(delta: Float):
        # Update camera orbit around aircraft
        tunnel_camera.SetRelativeLocation(vec3(
            camera_distance * cos(camera_angle.x) * cos(camera_angle.y),
            camera_distance * sin(camera_angle.x) * cos(camera_angle.y),
            camera_distance * sin(camera_angle.y)
        ))
        
        # Update force vector visualization
        if show_force_vectors:
            force_vector_visualizer.SetVisibility(true)
        else:
            force_vector_visualizer.SetVisibility(false)
        
        # Update grid visibility
        tunnel_grid.SetVisibility(show_grid)

