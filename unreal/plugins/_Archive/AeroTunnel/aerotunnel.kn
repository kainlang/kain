@asset_editor
struct AeroTunnelAssetEditor:
    @viewport
    wind_tunnel_view: WindTunnelViewport
    
    @viewport
    telemetry_graphs: TelemetryGraphViewport
    
    @details
    aircraft_properties: AerodynamicAircraftDetails
    
    @details
    tunnel_properties: WindTunnelDetails
    
    @toolbar
    toolbar: AeroTunnelToolbar
    
    @slate
    telemetry_dashboard: TelemetryDashboard
    
    @slate
    force_visualization: ForceVisualizationPanel
    
    @slate
    telemetry_graphs_widget: TelemetryGraphWidget
    
    @slate
    airfoil_selector: AirfoilSelectorWidget
    
    @slate
    wind_tunnel_controls: WindTunnelControlPanel
    
    fn on_asset_opened(asset: AeroTunnelAsset):
        # Initialize wind tunnel viewport
        wind_tunnel_view.aircraft_mesh.SetStaticMesh(asset.aircraft_mesh)
        wind_tunnel_view.camera_distance = 500.0
        wind_tunnel_view.camera_angle = vec2(0.0, 0.3)
        wind_tunnel_view.show_grid = true
        wind_tunnel_view.show_force_vectors = true
        
        # Initialize telemetry graphs viewport
        telemetry_graphs.time_window = 10.0
        
        # Initialize aircraft properties
        aircraft_properties.wing_area_m2 = 20.0
        aircraft_properties.wing_span_m = 10.0
        aircraft_properties.mean_chord_m = 2.0
        aircraft_properties.aspect_ratio = 5.0
        aircraft_properties.airfoil_profile = AirfoilProfile::NACA2412
        aircraft_properties.lift_curve_slope = 6.28
        aircraft_properties.min_drag_coefficient = 0.02
        aircraft_properties.stall_angle_deg = 15.0
        aircraft_properties.mass_kg = 1000.0
        aircraft_properties.physics_substep_hz = 120.0
        aircraft_properties.air_density_kg_m3 = 1.225
        aircraft_properties.speed_of_sound_ms = 343.0
        aircraft_properties.visualization_mode = DebugVisualizationMode::ForceVectors
        aircraft_properties.lift_vector_color = vec3(0.2, 0.5, 1.0)
        aircraft_properties.drag_vector_color = vec3(1.0, 0.3, 0.2)
        aircraft_properties.vector_scale = 1.0
        aircraft_properties.recording_enabled = true
        aircraft_properties.sample_rate_hz = 60.0
        
        # Initialize tunnel properties
        tunnel_properties.wind_speed_ms = 50.0
        tunnel_properties.wind_direction = vec3(1, 0, 0)
        tunnel_properties.tunnel_mode = WindTunnelMode::Static
        tunnel_properties.tunnel_length_m = 100.0
        tunnel_properties.tunnel_width_m = 50.0
        tunnel_properties.tunnel_height_m = 50.0
        tunnel_properties.turbulence_intensity = 0.1
        tunnel_properties.gust_frequency_hz = 0.5
        tunnel_properties.gust_amplitude_ms = 10.0
        tunnel_properties.is_simulating = false
        tunnel_properties.grid_color = vec3(0.3, 0.3, 0.3)
        tunnel_properties.grid_scale = 10.0
        tunnel_properties.show_velocity_field = false
        
        # Initialize telemetry dashboard
        telemetry_dashboard.airspeed = 0.0
        telemetry_dashboard.altitude = 0.0
        telemetry_dashboard.mach_number = 0.0
        telemetry_dashboard.angle_of_attack = 0.0
        telemetry_dashboard.g_force = 1.0
        telemetry_dashboard.stall_warning = false
        telemetry_dashboard.flight_regime = FlightRegime::Subsonic
        
        # Initialize force visualization
        force_visualization.lift_force = vec3(0, 0, 0)
        force_visualization.drag_force = vec3(0, 0, 0)
        force_visualization.moment = vec3(0, 0, 0)
        force_visualization.center_of_pressure = vec3(0, 0, 0)
        force_visualization.show_vectors = true
        force_visualization.show_pressure_map = false
        
        # Initialize telemetry graphs
        telemetry_graphs_widget.time_window_seconds = 10.0
        
        # Initialize airfoil selector
        airfoil_selector.current_airfoil = AirfoilProfile::NACA2412
        
        # Initialize wind tunnel controls
        wind_tunnel_controls.wind_speed = 50.0
        wind_tunnel_controls.tunnel_mode = WindTunnelMode::Static
        wind_tunnel_controls.is_simulating = false
        wind_tunnel_controls.turbulence_intensity = 0.1
        
        println("AeroTunnel asset editor opened")
    
    fn on_asset_saved():
        println("AeroTunnel configuration saved")

