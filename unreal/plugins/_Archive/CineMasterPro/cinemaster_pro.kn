# ============================================================================
# ASSET EDITOR - Complete CineMaster Pro editor
# ============================================================================

@asset_editor
struct CineMasterProEditor:
    @viewport
    main_viewport: DirectorMainViewport
    
    @viewport
    camera_preview_1: CameraPreviewViewport
    
    @viewport
    camera_preview_2: CameraPreviewViewport
    
    @viewport
    multi_camera: MultiCameraViewport
    
    @details
    camera_properties: VirtualCameraDetails
    
    @details
    director_properties: DirectorControllerDetails
    
    @toolbar
    director_toolbar: DirectorToolbar
    
    @toolbar
    lens_toolbar: LensToolbar
    
    @slate
    control_board: DirectorControlBoard
    
    @slate
    camera_grid: CameraGridWidget
    
    @slate
    lens_control: LensControlPanel
    
    @slate
    timeline: TimelineWidget
    
    @slate
    recording_status: RecordingStatusWidget
    
    @slate
    camera_overlay: CameraInfoOverlay
    
    @slate
    exposure_control: ExposureControlWidget
    
    fn on_asset_opened(asset: CineMasterProAsset):
        println("CineMaster Pro Editor opened")
        
        # Initialize main viewport
        main_viewport.camera_distance = 1000.0
        main_viewport.camera_rotation = vec2(0.0, 0.3)
        
        # Initialize camera previews
        camera_preview_1.camera_id = 1
        camera_preview_1.is_live = false
        camera_preview_1.rotation_speed = 15.0
        camera_preview_1.zoom_level = 500.0
        
        camera_preview_2.camera_id = 2
        camera_preview_2.is_live = false
        camera_preview_2.rotation_speed = 15.0
        camera_preview_2.zoom_level = 500.0
        
        # Initialize multi-camera viewport
        multi_camera.active_camera_index = 0
        multi_camera.grid_size = 4
        
        # Initialize camera properties
        camera_properties.camera_id = 1
        camera_properties.camera_name = "Camera 1"
        camera_properties.camera_type = CameraType::Medium
        camera_properties.is_active = true
        camera_properties.is_live = false
        camera_properties.lens_manufacturer = LensManufacturer::Panavision
        camera_properties.lens_type = LensType::Prime
        camera_properties.focal_length_mm = 50.0
        camera_properties.t_stop = 2.8
        camera_properties.focus_distance_cm = 300.0
        camera_properties.bokeh_blade_count = 9
        camera_properties.chromatic_aberration = 0.1
        camera_properties.vignette_intensity = 0.3
        camera_properties.distortion_amount = 0.0
        camera_properties.anamorphic_squeeze = 1.0
        camera_properties.exposure_compensation = 0.0
        camera_properties.color_temperature = 6500.0
        camera_properties.tint = 0.0
        camera_properties.iso = 800.0
        camera_properties.shutter_speed = 0.02083  # 1/48 for 24fps
        camera_properties.contrast = 1.0
        camera_properties.saturation = 1.0
        camera_properties.film_grain_intensity = 0.05
        camera_properties.vignette_color = vec3(0.0, 0.0, 0.0)
        
        # Initialize director properties
        director_properties.recording_state = RecordingState::Idle
        director_properties.sequence_name = "VirtualProduction_Take_001"
        director_properties.sequence_fps = 24.0
        director_properties.current_timecode = 0.0
        director_properties.cut_count = 0
        director_properties.total_cameras = 16
        director_properties.active_camera_id = 1
        director_properties.live_camera_count = 0
        director_properties.viewport_quality = ViewportQuality::Standard
        director_properties.grid_layout = "4x4"
        director_properties.update_frequency_hz = 30.0
        director_properties.export_path = "/Game/Sequences/Export/"
        director_properties.export_format = "FBX"
        
        # Initialize control board
        control_board.active_camera_id = 1
        control_board.recording_state = RecordingState::Idle
        control_board.current_timecode = 0.0
        control_board.sequence_fps = 24.0
        control_board.cut_count = 0
        control_board.total_cameras = 16
        control_board.selected_camera = 1
        control_board.transition_type = CameraSwitchMode::Cut
        
        # Initialize camera grid
        camera_grid.active_camera_id = 1
        camera_grid.grid_layout = "4x4"
        camera_grid.viewport_quality = ViewportQuality::Standard
        camera_grid.selected_camera = 1
        
        # Initialize lens control
        lens_control.current_focal_length = 50.0
        lens_control.current_t_stop = 2.8
        lens_control.focus_distance_cm = 300.0
        lens_control.lens_manufacturer = LensManufacturer::Panavision
        lens_control.lens_type = LensType::Prime
        lens_control.focal_length_input = 50.0
        lens_control.t_stop_input = 2.8
        lens_control.focus_input = 300.0
        
        # Initialize timeline
        timeline.current_timecode = 0.0
        timeline.sequence_duration = 0.0
        timeline.sequence_fps = 24.0
        timeline.playhead_position = 0.0
        timeline.zoom_level = 1.0
        
        # Initialize recording status
        recording_status.recording_state = RecordingState::Idle
        recording_status.timecode = 0.0
        recording_status.sequence_name = "VirtualProduction_Take_001"
        recording_status.cut_count = 0
        recording_status.disk_space_gb = 500.0
        
        # Initialize camera overlay
        camera_overlay.camera_id = 1
        camera_overlay.camera_name = "Camera 1"
        camera_overlay.camera_type = CameraType::Medium
        camera_overlay.focal_length = 50.0
        camera_overlay.t_stop = 2.8
        camera_overlay.is_live = false
        camera_overlay.is_recording = false
        camera_overlay.frame_rate = 24.0
        
        # Initialize exposure control
        exposure_control.exposure_compensation = 0.0
        exposure_control.color_temperature = 6500.0
        exposure_control.tint = 0.0
        exposure_control.iso = 800.0
        exposure_control.shutter_speed = 0.02083
        exposure_control.exposure_input = 0.0
        exposure_control.temperature_input = 6500.0
        exposure_control.tint_input = 0.0
        
        println("CineMaster Pro initialized with 16 cameras, 4x4 grid layout")
    
    fn on_asset_saved():
        println("CineMaster Pro session saved")
    
    fn on_asset_closed():
        println("CineMaster Pro Editor closed")

