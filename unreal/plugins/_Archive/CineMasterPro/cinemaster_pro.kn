# ============================================================================
# VIEWPORT - Camera preview viewports
# ============================================================================

@viewport
struct CameraPreviewViewport:
    @scene_actor
    preview_camera: CameraComponent
    
    @scene_actor
    preview_mesh: StaticMeshComponent
    
    @scene_actor
    preview_light: DirectionalLightComponent
    
    camera_id: Int
    is_live: Bool
    rotation_speed: Float
    zoom_level: Float
    
    fn on_viewport_tick(delta: Float):
        # Update preview camera
        if is_live:
            # Live camera updates from actual camera transform
            preview_camera.SetRelativeLocation(vec3(0, 0, zoom_level))
        else:
            # Preview mode - gentle rotation
            preview_mesh.AddLocalRotation(vec3(0, delta * rotation_speed, 0))

@viewport
struct MultiCameraViewport:
    @scene_actor
    camera_1: CameraComponent
    
    @scene_actor
    camera_2: CameraComponent
    
    @scene_actor
    camera_3: CameraComponent
    
    @scene_actor
    camera_4: CameraComponent
    
    @scene_actor
    scene_root: SceneComponent
    
    active_camera_index: Int
    grid_size: Int
    
    fn on_viewport_tick(delta: Float):
        # Update all camera viewports
        # Each camera renders to its own section of the viewport grid
        scene_root.AddLocalRotation(vec3(0, delta * 10.0, 0))

@viewport
struct DirectorMainViewport:
    @scene_actor
    main_camera: CameraComponent
    
    @scene_actor
    scene_preview: StaticMeshComponent
    
    @camera
    director_camera: CameraComponent
    
    camera_distance: Float
    camera_rotation: Vec2
    
    fn on_viewport_tick(delta: Float):
        # Update director's view
        director_camera.SetRelativeLocation(vec3(
            camera_distance * cos(camera_rotation.x) * cos(camera_rotation.y),
            camera_distance * sin(camera_rotation.x) * cos(camera_rotation.y),
            camera_distance * sin(camera_rotation.y)
        ))

