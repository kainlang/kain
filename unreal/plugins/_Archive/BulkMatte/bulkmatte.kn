# ============================================================================
# BULKMATTE - Material Instance Parameter Bulk Editor
# ============================================================================
# Spreadsheet-style bulk editing for Material Instances:
# - View all Material Instance parameters in one grid
# - Bulk edit 200+ materials simultaneously
# - Filter by parameter name, parent, folder
# - Apply master values to all selected materials
# - Undo/redo support for bulk operations
# - Context menu integration in Content Browser
# - Export/import parameters to CSV
# - Real-time material preview
#
# Price Point: $19.99 (Technical Artist Tool)
# Target: Material artists, asset pack creators, technical artists
# Build: kain build --ue5
# ============================================================================

# ============================================================================
# SECTION 1: ENUMS - Parameter types and operations
# ============================================================================

enum ParameterType:
    Scalar           # Float parameter
    Vector           # Color/Vector parameter
    Texture          # Texture parameter
    StaticSwitch     # Static switch parameter
    _MAX

enum FilterMode:
    All              # Show all materials
    Modified         # Show only modified materials
    Unmodified       # Show only unmodified materials
    Overridden       # Show only materials with overridden parameters
    _MAX

enum SortMode:
    Name             # Sort by material name
    Type             # Sort by parameter type
    Value            # Sort by parameter value
    Parent           # Sort by parent material
    _MAX

enum BulkOperation:
    Set              # Set absolute value
    Add              # Add to current value
    Multiply         # Multiply current value
    Clamp            # Clamp to range
    Reset            # Reset to default
    _MAX

# ============================================================================
# SECTION 2: STRUCTS - Material and parameter info
# ============================================================================

struct MaterialInstanceInfo:
    asset_path: String
    parent_material: String
    parameter_count: Int
    is_modified: Bool

struct ParameterInfo:
    name: String
    param_type: ParameterType
    current_value: Float
    default_value: Float
    is_overridden: Bool

struct BulkEditOperation:
    operation_type: BulkOperation
    parameter_name: String
    new_value: Float
    affected_materials: Array<String>

# ============================================================================
# SECTION 3: DATATABLES - Common parameters and presets
# ============================================================================

@datatable
struct CommonParameterData:
    id: Int
    parameter_name: String
    typical_range_min: Float
    typical_range_max: Float
    description: String

@datatable
struct MaterialPresetData:
    id: Int
    preset_name: String
    roughness: Float
    metallic: Float
    base_color_r: Float
    base_color_g: Float
    base_color_b: Float
    normal_intensity: Float

# ============================================================================
# SECTION 4: COMPONENTS - Material scanning and editing
# ============================================================================

@component
struct MaterialScannerComponent:
    @transient
    scanned_materials: Array<MaterialInstanceInfo>
    
    @transient
    scan_progress: Float
    
    @transient
    is_scanning: Bool

@component
struct ParameterEditorComponent:
    @transient
    selected_materials: Array<String>
    
    @transient
    pending_operations: Array<BulkEditOperation>
    
    @transient
    undo_stack_size: Int

@component
struct FilterManagerComponent:
    @transient
    current_filter_mode: FilterMode
    
    @transient
    search_text: String
    
    @transient
    current_sort_mode: SortMode

# ============================================================================
# SECTION 5: SLATE WIDGETS - UI Components
# ============================================================================

@slate
struct MaterialListWidget:
    @property
    materials: Array<MaterialInstanceInfo>
    
    @property
    selected_count: Int
    
    fn construct() -> Widget:
        return VBox(
            Text("Materials"),
            ScrollBox(
                ListView()
            )
        )

@slate
struct ParameterGridWidget:
    @property
    parameters: Array<ParameterInfo>
    
    @property
    show_only_overridden: Bool
    
    fn construct() -> Widget:
        return VBox(
            Text("Parameters"),
            ScrollBox(
                DataGrid()
            )
        )

@slate
struct BulkEditControlsWidget:
    @property
    master_roughness: Float
    
    @property
    master_metallic: Float
    
    @property
    master_base_color: Vec3
    
    fn construct() -> Widget:
        return HBox(
            VBox(
                Text("Master Controls"),
                Text("Roughness"),
                Slider(),
                Text("Metallic"),
                Slider(),
                Button("Apply to All")
            ),
            Spacer(),
            VBox(
                Button("Reset Selected"),
                Button("Export CSV"),
                Button("Import CSV")
            )
        )

@slate
struct FilterBarWidget:
    @property
    search_text: String
    
    @property
    filter_mode: FilterMode
    
    fn construct() -> Widget:
        return HBox(
            Text("Filter:"),
            TextBox("Search parameters..."),
            ComboBox(),
            Button("Clear")
        )

@slate
struct PreviewWidget:
    @property
    preview_material: String
    
    @property
    sphere_rotation: Float
    
    fn construct() -> Widget:
        return VBox(
            Text("Preview"),
            ViewportWidget(),
            HBox(
                Button("Rotate Left"),
                Button("Rotate Right"),
                Button("Reset")
            )
        )

# ============================================================================
# SECTION 6: DETAILS PANEL - Settings customization
# ============================================================================

@details
struct BulkMatteSettings:
    @category("Scan Settings")
    @editdefaults
    scan_content_folders: Array<String>
    
    @editdefaults
    include_engine_content: Bool
    
    @category("Display")
    @slider(10.0, 500.0)
    rows_per_page: Float
    
    @editdefaults
    show_only_overridden: Bool
    
    @editdefaults
    show_parameter_descriptions: Bool
    
    @category("Bulk Operations")
    @slider(0.0, 1.0)
    master_roughness: Float
    
    @slider(0.0, 1.0)
    master_metallic: Float
    
    @color_picker
    master_base_color: Vec3
    
    @slider(0.0, 2.0)
    master_normal_intensity: Float
    
    @category("Actions")
    @button("Scan Materials")
    fn on_scan_materials():
        println("Scanning materials...")
    
    @button("Apply Master Values")
    fn on_apply_master_values():
        println("Applying master values...")
    
    @button("Reset Selected")
    fn on_reset_selected():
        println("Resetting selected materials...")
    
    @button("Export to CSV")
    fn on_export_csv():
        println("Exporting to CSV...")

# ============================================================================
# SECTION 7: VIEWPORT - Material preview
# ============================================================================

@viewport
struct MaterialPreviewViewport:
    @scene_actor
    preview_sphere: StaticMeshComponent
    
    @camera
    preview_camera: CameraComponent
    
    fn on_viewport_tick(delta: Float):
        # Rotate preview sphere for better viewing
        let rotation_speed = 15.0
        preview_sphere.AddLocalRotation(vec3(0.0, delta * rotation_speed, 0.0))

# ============================================================================
# SECTION 8: TOOLBAR - Quick actions
# ============================================================================

@toolbar
struct BulkMatteToolbar:
    @button("Icons.Search", "Scan Materials")
    fn on_scan():
        println("Scanning materials...")
    
    @button("Icons.Apply", "Apply Changes")
    fn on_apply():
        println("Applying changes...")
    
    @button("Icons.Reset", "Reset Selected")
    fn on_reset():
        println("Resetting selected...")
    
    @separator
    
    @button("Icons.Export", "Export to CSV")
    fn on_export():
        println("Exporting to CSV...")
    
    @button("Icons.Import", "Import from CSV")
    fn on_import():
        println("Importing from CSV...")
    
    @separator
    
    @toggle("Show Modified Only")
    fn on_toggle_modified(enabled: Bool):
        println("Show modified only: {enabled}")
    
    @toggle("Show Textures")
    fn on_toggle_textures(enabled: Bool):
        println("Show textures: {enabled}")
    
    @toggle("Auto-Preview")
    fn on_toggle_preview(enabled: Bool):
        println("Auto-preview: {enabled}")
    
    @separator
    
    @dropdown("Filter")
    fn on_filter_changed(value: String):
        println("Filter changed: {value}")
    
    @dropdown("Sort")
    fn on_sort_changed(value: String):
        println("Sort changed: {value}")

# ============================================================================
# SECTION 9: ASSET EDITOR - Main editor window
# ============================================================================

@asset_editor
struct BulkMatteAssetEditor:
    @viewport
    preview: MaterialPreviewViewport
    
    @details
    properties: BulkMatteSettings
    
    @toolbar
    tools: BulkMatteToolbar
    
    @slate
    material_list: MaterialListWidget
    
    @slate
    parameter_grid: ParameterGridWidget
    
    @slate
    bulk_controls: BulkEditControlsWidget
    
    @slate
    filter_bar: FilterBarWidget
    
    fn on_asset_opened(asset_path: String):
        println("Opening BulkMatte editor for: {asset_path}")
        # Initialize material list
        # Load parameters
        # Setup preview

# ============================================================================
# SECTION 10: EDITOR MODULE - Menu and toolbar integration
# ============================================================================

@editor_module
struct BulkMatteEditorModule:
    @menu_entry(path: "Tools/BulkMatte/Open Material Editor", label: "Open Material Editor")
    fn on_open_editor():
        println("Opening BulkMatte Material Editor...")
    
    @menu_entry(path: "Tools/BulkMatte/Scan Project Materials", label: "Scan Project Materials")
    fn on_scan_project():
        println("Scanning project materials...")
    
    @menu_entry(path: "Tools/BulkMatte/Quick Roughness Adjust", label: "Quick Roughness Adjust")
    fn on_quick_roughness():
        println("Quick roughness adjustment...")
    
    @toolbar_button(section: "Content", icon: "Icons.BulkMatte", label: "Open BulkMatte")
    fn on_toolbar_button():
        println("Opening BulkMatte from toolbar...")

# ============================================================================
# SECTION 11: BLUEPRINT FUNCTIONS - Material scanning and editing
# ============================================================================

@blueprint
fn scan_material_instances(folder_path: String) -> Array<MaterialInstanceInfo>:
    # Scan all Material Instances in the specified folder
    # Use UAssetRegistryModule to find assets
    var results: Array<MaterialInstanceInfo> = []
    println("Scanning folder: {folder_path}")
    return results

@blueprint
fn get_material_parameters(material_path: String) -> Array<ParameterInfo>:
    # Get all parameters from a Material Instance
    # Use UMaterialInstanceConstant::GetScalarParameterValue()
    var params: Array<ParameterInfo> = []
    println("Getting parameters for: {material_path}")
    return params

@blueprint
fn bulk_set_scalar_parameter(material_paths: Array<String>, param_name: String, value: Float) -> Bool:
    # Set scalar parameter on multiple materials
    # Use SetScalarParameterValueEditorOnly() + PostEditChange()
    println("Setting {param_name} to {value} on {material_paths.length} materials")
    return true

@blueprint
fn bulk_set_vector_parameter(material_paths: Array<String>, param_name: String, value: Vec3) -> Bool:
    # Set vector parameter on multiple materials
    println("Setting {param_name} to ({value.x}, {value.y}, {value.z}) on {material_paths.length} materials")
    return true

@blueprint
fn bulk_reset_parameter(material_paths: Array<String>, param_name: String) -> Bool:
    # Reset parameter to default value on multiple materials
    println("Resetting {param_name} on {material_paths.length} materials")
    return true

@blueprint
fn export_parameters_to_csv(material_paths: Array<String>, file_path: String) -> Bool:
    # Export all parameters to CSV file
    println("Exporting {material_paths.length} materials to {file_path}")
    return true

@blueprint
fn import_parameters_from_csv(file_path: String) -> Bool:
    # Import parameters from CSV file
    println("Importing parameters from {file_path}")
    return true

@blueprint
fn get_parameter_default_value(material_path: String, param_name: String) -> Float:
    # Get default value for a parameter
    println("Getting default value for {param_name} in {material_path}")
    return 0.0

@blueprint
fn calculate_parameter_statistics(material_paths: Array<String>, param_name: String) -> Vec3:
    # Calculate min, max, average for a parameter across materials
    # Returns vec3(min, max, average)
    println("Calculating statistics for {param_name} across {material_paths.length} materials")
    return vec3(0.0, 1.0, 0.5)

@blueprint
fn find_materials_by_parent(parent_material: String) -> Array<String>:
    # Find all Material Instances that use a specific parent material
    println("Finding materials with parent: {parent_material}")
    var results: Array<String> = []
    return results

@blueprint
fn find_materials_with_parameter(param_name: String) -> Array<String>:
    # Find all Material Instances that have a specific parameter
    println("Finding materials with parameter: {param_name}")
    var results: Array<String> = []
    return results
