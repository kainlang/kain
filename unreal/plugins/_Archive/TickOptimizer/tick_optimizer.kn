# ============================================================================
# TICK OPTIMIZER - Smart Actor Tick Management for UE5
# ============================================================================
# A production-ready tick optimization system that:
# - Automatically throttles actor ticks based on distance from camera
# - Provides per-actor-class override rules
# - Tracks performance metrics (CPU time saved, actors throttled)
# - Includes real-time visualization dashboard
# - Supports whitelist for critical actors
# - Profile mode for debugging tick performance
# ============================================================================

# ============================================================================
# ENUMS - Optimization modes and distance bands
# ============================================================================

enum TickDistanceBand:
    Near          # 0-2000 units
    Medium        # 2000-5000 units
    Far           # 5000-10000 units
    VeryFar       # 10000+ units
    Disabled      # Never tick
    MAX           # Enum boundary

enum TickOptimizationMode:
    Disabled      # No optimization
    Conservative  # Light throttling
    Balanced      # Moderate throttling
    Aggressive    # Heavy throttling
    Custom        # User-defined rules
    MAX           # Enum boundary

enum TickProfileCategory:
    Gameplay      # Gameplay-critical actors
    Visual        # Visual-only actors
    Audio         # Audio actors
    Physics       # Physics actors
    AI            # AI actors
    Decoration    # Decorative actors
    MAX           # Enum boundary

# ============================================================================
# DATATABLES - Optimization rules and actor class overrides
# ============================================================================

@datatable
struct TickOptimizationRule:
    id: Int
    distance_band: TickDistanceBand
    tick_interval: Float          # 0.0 = every frame, 0.1 = 10 FPS, 0.5 = 2 FPS
    check_screen_visibility: Bool # Use ProjectWorldToScreen check
    enabled: Bool

@datatable
struct ActorClassOverride:
    id: Int
    actor_class_name: String      # e.g., "AEnemy", "ADecoration"
    force_always_tick: Bool        # Never throttle this class
    force_never_tick: Bool         # Always disable tick
    custom_tick_interval: Float    # Override interval (-1 = use distance rules)
    profile_category: TickProfileCategory
    description: String

@datatable
struct PerformancePreset:
    id: Int
    preset_name: String            # "Conservative", "Balanced", "Aggressive"
    near_interval: Float
    medium_interval: Float
    far_interval: Float
    very_far_interval: Float
    use_screen_visibility: Bool
    description: String

# ============================================================================
# COMPONENTS - Tick optimization tracking
# ============================================================================

@component
struct TickOptimizationComponent:
    current_distance_band: TickDistanceBand
    
    current_tick_interval: Float
    
    @transient
    is_whitelisted: Bool
    
    @transient
    is_on_screen: Bool
    
    @transient
    last_optimization_time: Float
    
    profile_category: TickProfileCategory

# ============================================================================
# SUBSYSTEM - World subsystem for global tick management
# ============================================================================

actor TickOptimizerSubsystem:
    # Configuration
    @replicated
    state optimization_mode: TickOptimizationMode = TickOptimizationMode::Balanced
    
    @replicated
    state is_enabled: Bool = true
    
    state near_distance: Float = 2000.0
    state medium_distance: Float = 5000.0
    state far_distance: Float = 10000.0
    
    # Tick intervals per distance band
    state near_interval: Float = 0.0      # Every frame
    state medium_interval: Float = 0.1    # 10 FPS
    state far_interval: Float = 0.5       # 2 FPS
    state very_far_interval: Float = -1.0 # Disabled
    
    # Performance tracking
    @transient
    state actors_optimized: Int = 0
    
    @transient
    state actors_whitelisted: Int = 0
    
    @transient
    state cpu_time_saved_ms: Float = 0.0
    
    @transient
    state total_actors_tracked: Int = 0
    
    # Screen visibility check
    state use_screen_visibility: Bool = false
    
    # Profile mode
    @transient
    state profile_mode_enabled: Bool = false
    
    @transient
    state last_profile_log_time: Float = 0.0
    
    # Optimization frequency (don't check every frame)
    state optimization_frequency: Float = 0.5  # Check every 0.5 seconds
    state last_optimization_time: Float = 0.0
    
    on BeginPlay():
        println("TickOptimizerSubsystem initialized")
        Server_LoadPreset(TickOptimizationMode::Balanced)
    
    on Tick(delta_time: Float):
        if !is_enabled:
            return
        
        # Only optimize at specified frequency
        last_optimization_time = last_optimization_time + delta_time
        if last_optimization_time < optimization_frequency:
            return
        
        last_optimization_time = 0.0
        
        # Perform optimization pass
        Server_OptimizeActorTicks()
        
        # Profile logging
        if profile_mode_enabled:
            last_profile_log_time = last_profile_log_time + delta_time
            if last_profile_log_time >= 5.0:
                Server_LogProfileData()
                last_profile_log_time = 0.0
    
    on Server_OptimizeActorTicks():
        # Get player camera location
        # In real implementation, this would use UGameplayStatics::GetPlayerCameraManager
        let camera_location = vec3(0, 0, 0)
        
        # Reset counters
        actors_optimized = 0
        actors_whitelisted = 0
        total_actors_tracked = 0
        
        # Iterate all actors with bCanEverTick=true
        # In real implementation, this would use UWorld::GetAllActorsOfClass
        # For each actor:
        #   - Calculate distance to camera
        #   - Check if whitelisted
        #   - Apply appropriate tick interval
        #   - Optionally check screen visibility
        
        Multicast_UpdateOptimizationStats(actors_optimized, actors_whitelisted, total_actors_tracked)
    
    on Server_LoadPreset(mode: TickOptimizationMode):
        optimization_mode = mode
        
        match mode:
            TickOptimizationMode::Conservative =>
                near_interval = 0.0
                medium_interval = 0.05
                far_interval = 0.2
                very_far_interval = 0.5
                use_screen_visibility = false
            TickOptimizationMode::Balanced =>
                near_interval = 0.0
                medium_interval = 0.1
                far_interval = 0.5
                very_far_interval = -1.0
                use_screen_visibility = true
            TickOptimizationMode::Aggressive =>
                near_interval = 0.05
                medium_interval = 0.2
                far_interval = 1.0
                very_far_interval = -1.0
                use_screen_visibility = true
            _ =>
                println("Custom mode - using current settings")
        
        Multicast_AnnouncePresetLoaded(mode)
    
    on Server_SetEnabled(enabled: Bool):
        is_enabled = enabled
        
        if !enabled:
            # Reset all actor tick intervals to default
            Server_ResetAllActorTicks()
        
        Multicast_AnnounceEnabledChanged(enabled)
    
    on Server_ResetAllActorTicks():
        println("Resetting all actor tick intervals to default")
        actors_optimized = 0
        actors_whitelisted = 0
        total_actors_tracked = 0
    
    on Server_AddToWhitelist(actor_class: String):
        println("Added {actor_class} to whitelist")
        Multicast_AnnounceWhitelistChanged(actor_class, true)
    
    on Server_RemoveFromWhitelist(actor_class: String):
        println("Removed {actor_class} from whitelist")
        Multicast_AnnounceWhitelistChanged(actor_class, false)
    
    on Server_SetProfileMode(enabled: Bool):
        profile_mode_enabled = enabled
        last_profile_log_time = 0.0
        Multicast_AnnounceProfileModeChanged(enabled)
    
    on Server_LogProfileData():
        println("=== TICK OPTIMIZER PROFILE ===")
        println("Total Actors: {total_actors_tracked}")
        println("Optimized: {actors_optimized}")
        println("Whitelisted: {actors_whitelisted}")
        println("CPU Time Saved: {cpu_time_saved_ms}ms")
        println("==============================")
    
    on Multicast_UpdateOptimizationStats(optimized: Int, whitelisted: Int, total: Int):
        actors_optimized = optimized
        actors_whitelisted = whitelisted
        total_actors_tracked = total
    
    on Multicast_AnnouncePresetLoaded(mode: TickOptimizationMode):
        println("Loaded optimization preset: {mode}")
    
    on Multicast_AnnounceEnabledChanged(enabled: Bool):
        println("Tick optimization enabled: {enabled}")
    
    on Multicast_AnnounceWhitelistChanged(actor_class: String, added: Bool):
        if added:
            println("Whitelisted: {actor_class}")
        else:
            println("Removed from whitelist: {actor_class}")
    
    on Multicast_AnnounceProfileModeChanged(enabled: Bool):
        println("Profile mode: {enabled}")
    
    @blueprint_callable
    fn GetActorsOptimized() -> Int:
        return actors_optimized
    
    @blueprint_callable
    fn GetActorsWhitelisted() -> Int:
        return actors_whitelisted
    
    @blueprint_callable
    fn GetTotalActorsTracked() -> Int:
        return total_actors_tracked
    
    @blueprint_callable
    fn GetCPUTimeSaved() -> Float:
        return cpu_time_saved_ms
    
    @blueprint_pure
    fn IsEnabled() -> Bool:
        return is_enabled
    
    @blueprint_pure
    fn IsProfileModeEnabled() -> Bool:
        return profile_mode_enabled

# ============================================================================
# BLUEPRINT FUNCTIONS - Utility functions
# ============================================================================

@blueprint
fn GetDistanceBandForDistance(distance: Float) -> TickDistanceBand:
    if distance < 2000.0:
        return TickDistanceBand::Near
    else:
        if distance < 5000.0:
            return TickDistanceBand::Medium
        else:
            if distance < 10000.0:
                return TickDistanceBand::Far
            else:
                return TickDistanceBand::VeryFar

@blueprint
fn GetTickIntervalForBand(band: TickDistanceBand, mode: TickOptimizationMode) -> Float:
    match mode:
        TickOptimizationMode::Conservative =>
            match band:
                TickDistanceBand::Near => 0.0
                TickDistanceBand::Medium => 0.05
                TickDistanceBand::Far => 0.2
                TickDistanceBand::VeryFar => 0.5
                _ => 0.0
        TickOptimizationMode::Balanced =>
            match band:
                TickDistanceBand::Near => 0.0
                TickDistanceBand::Medium => 0.1
                TickDistanceBand::Far => 0.5
                TickDistanceBand::VeryFar => -1.0
                _ => 0.0
        TickOptimizationMode::Aggressive =>
            match band:
                TickDistanceBand::Near => 0.05
                TickDistanceBand::Medium => 0.2
                TickDistanceBand::Far => 1.0
                TickDistanceBand::VeryFar => -1.0
                _ => 0.0
        _ => 0.0

@blueprint
fn GetDistanceBandColor(band: TickDistanceBand) -> Vec3:
    match band:
        TickDistanceBand::Near => vec3(0.0, 1.0, 0.0)      # Green
        TickDistanceBand::Medium => vec3(1.0, 1.0, 0.0)    # Yellow
        TickDistanceBand::Far => vec3(1.0, 0.5, 0.0)       # Orange
        TickDistanceBand::VeryFar => vec3(1.0, 0.0, 0.0)   # Red
        TickDistanceBand::Disabled => vec3(0.5, 0.5, 0.5)  # Gray
        _ => vec3(1.0, 1.0, 1.0)

@blueprint_pure
fn CalculateCPUTimeSaved(actors_optimized: Int, avg_tick_time_ms: Float) -> Float:
    return float(actors_optimized) * avg_tick_time_ms

@blueprint
fn FormatTickInterval(interval: Float) -> String:
    if interval < 0.0:
        return "Disabled"
    else:
        if interval == 0.0:
            return "Every Frame"
        else:
            let fps = 1.0 / interval
            return "{fps} FPS"

@blueprint
fn GetOptimizationModeDescription(mode: TickOptimizationMode) -> String:
    match mode:
        TickOptimizationMode::Disabled => "No optimization applied"
        TickOptimizationMode::Conservative => "Light throttling, minimal impact"
        TickOptimizationMode::Balanced => "Moderate throttling, good performance"
        TickOptimizationMode::Aggressive => "Heavy throttling, maximum performance"
        TickOptimizationMode::Custom => "User-defined rules"
        _ => "Unknown"

# ============================================================================
# SLATE UI - Real-time optimization dashboard
# ============================================================================

@slate
struct TickOptimizerDashboard:
    @property
    is_enabled: Bool
    
    @property
    optimization_mode: TickOptimizationMode
    
    @property
    actors_optimized: Int
    
    @property
    actors_whitelisted: Int
    
    @property
    total_actors: Int
    
    @property
    cpu_time_saved: Float
    
    @property
    profile_mode: Bool
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct TickVisualizationWidget:
    @property
    near_count: Int
    
    @property
    medium_count: Int
    
    @property
    far_count: Int
    
    @property
    very_far_count: Int
    
    @property
    disabled_count: Int
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct PerformanceGraphWidget:
    @property
    cpu_before: Float
    
    @property
    cpu_after: Float
    
    @property
    fps_before: Float
    
    @property
    fps_after: Float
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct ActorClassStatsWidget:
    @property
    class_name: String
    
    @property
    instance_count: Int
    
    @property
    avg_tick_time: Float
    
    @property
    is_whitelisted: Bool
    
    fn Compose() -> Widget:
        return HorizontalBox()

@slate
struct WhitelistEditorWidget:
    @property
    whitelisted_classes: Array<String>
    
    selected_class: String
    
    fn on_add_class(class_name: String):
        println("Adding class to whitelist: {class_name}")
    
    fn on_remove_class(class_name: String):
        println("Removing class from whitelist: {class_name}")
    
    fn Compose() -> Widget:
        return VerticalBox()

# ============================================================================
# DETAILS PANEL - Subsystem settings
# ============================================================================

@details
struct TickOptimizerSettings:
    @category("General")
    is_enabled: Bool
    
    @category("General")
    optimization_mode: TickOptimizationMode
    
    @category("Distance Thresholds")
    @slider(min: 500.0, max: 5000.0)
    near_distance: Float
    
    @category("Distance Thresholds")
    @slider(min: 2000.0, max: 10000.0)
    medium_distance: Float
    
    @category("Distance Thresholds")
    @slider(min: 5000.0, max: 20000.0)
    far_distance: Float
    
    @category("Tick Intervals")
    @slider(min: 0.0, max: 1.0)
    near_interval: Float
    
    @category("Tick Intervals")
    @slider(min: 0.0, max: 1.0)
    medium_interval: Float
    
    @category("Tick Intervals")
    @slider(min: 0.0, max: 2.0)
    far_interval: Float
    
    @category("Tick Intervals")
    @slider(min: -1.0, max: 5.0)
    very_far_interval: Float
    
    @category("Advanced")
    use_screen_visibility: Bool
    
    @category("Advanced")
    @slider(min: 0.1, max: 2.0)
    optimization_frequency: Float
    
    @category("Debug")
    profile_mode_enabled: Bool
    
    @category("Actions")
    @button(label: "Load Conservative Preset")
    fn on_load_conservative():
        println("Loading conservative preset...")
    
    @category("Actions")
    @button(label: "Load Balanced Preset")
    fn on_load_balanced():
        println("Loading balanced preset...")
    
    @category("Actions")
    @button(label: "Load Aggressive Preset")
    fn on_load_aggressive():
        println("Loading aggressive preset...")
    
    @category("Actions")
    @button(label: "Reset All Actor Ticks")
    fn on_reset_all():
        println("Resetting all actor ticks...")
    
    @category("Debug")
    @button(label: "Log Profile Data")
    fn on_log_profile():
        println("Logging profile data...")

# ============================================================================
# VIEWPORT - 3D visualization of optimized actors
# ============================================================================

@viewport
struct TickOptimizerViewport:
    @scene_actor
    debug_sphere_near: StaticMeshComponent
    
    @scene_actor
    debug_sphere_medium: StaticMeshComponent
    
    @scene_actor
    debug_sphere_far: StaticMeshComponent
    
    @camera
    preview_camera: CameraComponent
    
    fn on_viewport_tick(delta: Float):
        # Visualize distance bands with colored spheres
        # Near = Green, Medium = Yellow, Far = Orange
        println("Viewport tick")

# ============================================================================
# TOOLBAR - Quick actions
# ============================================================================

@toolbar
struct TickOptimizerToolbar:
    @button(icon: "Icons.Power", tooltip: "Toggle Optimization", shortcut: "Ctrl+T")
    fn on_toggle_optimization():
        println("Toggling tick optimization...")
    
    @button(icon: "Icons.Refresh", tooltip: "Reset All Ticks")
    fn on_reset_all():
        println("Resetting all ticks...")
    
    @separator
    
    @toggle(label: "Profile Mode", default: false)
    fn on_toggle_profile(enabled: Bool):
        println("Profile mode: {enabled}")
    
    @toggle(label: "Screen Visibility", default: true)
    fn on_toggle_screen_visibility(enabled: Bool):
        println("Screen visibility check: {enabled}")
    
    @separator
    
    @dropdown(label: "Preset", options: ["Conservative", "Balanced", "Aggressive", "Custom"])
    fn on_preset_changed(value: String):
        println("Preset changed to: {value}")
    
    @button(icon: "Icons.Stats", tooltip: "Show Stats")
    fn on_show_stats():
        println("Showing statistics...")

# ============================================================================
# ASSET EDITOR - Complete tick optimizer editor
# ============================================================================

@asset_editor
struct TickOptimizerEditor:
    @viewport
    viewport: TickOptimizerViewport
    
    @details
    settings: TickOptimizerSettings
    
    @toolbar
    toolbar: TickOptimizerToolbar
    
    @slate
    dashboard: TickOptimizerDashboard
    
    @slate
    visualization: TickVisualizationWidget
    
    @slate
    performance_graph: PerformanceGraphWidget
    
    @slate
    whitelist_editor: WhitelistEditorWidget
    
    fn on_asset_opened(asset: TickOptimizerAsset):
        # Initialize settings
        settings.is_enabled = true
        settings.optimization_mode = TickOptimizationMode::Balanced
        settings.near_distance = 2000.0
        settings.medium_distance = 5000.0
        settings.far_distance = 10000.0
        settings.near_interval = 0.0
        settings.medium_interval = 0.1
        settings.far_interval = 0.5
        settings.very_far_interval = -1.0
        settings.use_screen_visibility = true
        settings.optimization_frequency = 0.5
        settings.profile_mode_enabled = false
        
        # Initialize dashboard
        dashboard.is_enabled = true
        dashboard.optimization_mode = TickOptimizationMode::Balanced
        dashboard.actors_optimized = 0
        dashboard.actors_whitelisted = 0
        dashboard.total_actors = 0
        dashboard.cpu_time_saved = 0.0
        dashboard.profile_mode = false
        
        # Initialize visualization
        visualization.near_count = 0
        visualization.medium_count = 0
        visualization.far_count = 0
        visualization.very_far_count = 0
        visualization.disabled_count = 0
        
        # Initialize performance graph
        performance_graph.cpu_before = 16.67
        performance_graph.cpu_after = 8.33
        performance_graph.fps_before = 60.0
        performance_graph.fps_after = 120.0
        
        # Initialize viewport
        viewport.debug_sphere_near.SetRelativeScale3D(vec3(20.0, 20.0, 20.0))
        viewport.debug_sphere_medium.SetRelativeScale3D(vec3(50.0, 50.0, 50.0))
        viewport.debug_sphere_far.SetRelativeScale3D(vec3(100.0, 100.0, 100.0))
        
        println("Tick Optimizer editor opened")
    
    fn on_asset_saved():
        println("Tick Optimizer settings saved")

