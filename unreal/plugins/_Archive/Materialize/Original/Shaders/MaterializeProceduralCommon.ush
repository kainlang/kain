// Materialize Procedural Generators - Common Functions
// Ported from K-Engine WGSL/Rust to HLSL for UE5 compute shaders
// Copyright K-Studio, All Rights Reserved

#pragma once

// ============================================================================
// COMMON MATH FUNCTIONS
// ============================================================================

// Standard hash function for noise generation
float hash11(float p)
{
    p = frac(p * 0.1031);
    p *= p + 33.33;
    return frac((p + p) * p);
}

float hash21(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float2 hash22(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.xx + p3.yz) * p3.zy);
}

float3 hash33(float3 p3)
{
    p3 = frac(p3 * float3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yxz + 33.33);
    return frac((p3.xxy + p3.yxx) * p3.zyx);
}

// ============================================================================
// PERLIN NOISE
// ============================================================================

// 2D gradient noise
float grad2(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    
    // Quintic interpolation curve
    float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    
    // Four corner gradients
    float a = hash21(i + float2(0.0, 0.0));
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    
    // Bilinear interpolation
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

// Fractal Brownian Motion (multi-octave Perlin)
float fbm(float2 p, int octaves, float lacunarity, float persistence)
{
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;
    float maxValue = 0.0; // For normalization
    
    for (int i = 0; i < octaves; i++)
    {
        value += amplitude * (grad2(p * frequency) * 2.0 - 1.0);
        maxValue += amplitude;
        amplitude *= persistence;
        frequency *= lacunarity;
    }
    
    return (value / maxValue) * 0.5 + 0.5; // Normalize to 0-1
}

// Standard Perlin with octaves
float perlin_noise(float2 uv, float scale, int octaves, float seed)
{
    float2 p = uv * scale + seed;
    return fbm(p, octaves, 2.0, 0.5);
}

// ============================================================================
// VORONOI / WORLEY NOISE
// ============================================================================

// Voronoi cell distance
float2 voronoi(float2 uv, float scale, float randomness, float seed)
{
    float2 n = floor(uv * scale);
    float2 f = frac(uv * scale);
    
    float F1 = 8.0; // Distance to closest cell
    float F2 = 8.0; // Distance to second closest
    
    // Search 3x3 neighborhood
    for (int j = -1; j <= 1; j++)
    {
        for (int i = -1; i <= 1; i++)
        {
            float2 g = float2(i, j);
            float2 o = hash22(n + g + seed) * randomness;
            float2 r = g + o - f;
            float d = dot(r, r);
            
            if (d < F1)
            {
                F2 = F1;
                F1 = d;
            }
            else if (d < F2)
            {
                F2 = d;
            }
        }
    }
    
    return float2(sqrt(F1), sqrt(F2));
}

// Worley noise (F1 - closest point distance)
float worley_noise(float2 uv, float scale, float randomness, float seed)
{
    return voronoi(uv, scale, randomness, seed).x;
}

// Voronoi edges (F2 - F1)
float voronoi_edges(float2 uv, float scale, float edge_width, float seed)
{
    float2 v = voronoi(uv, scale, 1.0, seed);
    float edge = (v.y - v.x);
    return saturate(edge / edge_width);
}

// ============================================================================
// GEOMETRIC PATTERNS
// ============================================================================

// Radial falloff (soft brush)
float radial_falloff(float2 uv, float falloff_power)
{
    float2 centered = uv - 0.5;
    float dist = length(centered) * 2.0; // 0 at center, 1 at edge
    return saturate(1.0 - pow(dist, falloff_power));
}

// Hard circle
float circle(float2 uv, float radius, float edge_softness)
{
    float2 centered = uv - 0.5;
    float dist = length(centered) * 2.0;
    float edge = (radius - dist) / max(edge_softness, 0.001);
    return saturate(edge);
}

// Square
float square(float2 uv, float size, float edge_softness)
{
    float2 centered = abs(uv - 0.5) * 2.0;
    float2 edge = (size - centered) / max(edge_softness, 0.001);
    return saturate(min(edge.x, edge.y));
}

// Diamond (rotated square)
float diamond(float2 uv, float size, float edge_softness)
{
    float2 centered = abs(uv - 0.5) * 2.0;
    float manhattan = centered.x + centered.y;
    float edge = (size * 1.414 - manhattan) / max(edge_softness, 0.001);
    return saturate(edge);
}

// ============================================================================
// TILING PATTERNS
// ============================================================================

// Brick pattern
float bricks(float2 uv, float brick_width, float brick_height, float mortar_width)
{
    // Offset every other row
    float row = floor(uv.y / brick_height);
    float offset = fmod(row, 2.0) * 0.5 * brick_width;
    
    float2 brick_uv = float2(fmod(uv.x + offset, brick_width), fmod(uv.y, brick_height));
    
    // Check if in mortar
    float in_mortar_x = brick_uv.x < mortar_width || brick_uv.x > brick_width - mortar_width;
    float in_mortar_y = brick_uv.y < mortar_width || brick_uv.y > brick_height - mortar_width;
    
    if (in_mortar_x || in_mortar_y)
        return 0.0;
    
    // Soft edge within brick
    float edge_x = min(brick_uv.x - mortar_width, brick_width - mortar_width - brick_uv.x);
    float edge_y = min(brick_uv.y - mortar_width, brick_height - mortar_width - brick_uv.y);
    float edge = min(edge_x, edge_y) / mortar_width;
    
    return saturate(edge);
}

// Dot pattern (polka dots)
float dots(float2 uv, float dot_radius, float spacing)
{
    float2 cell = floor(uv / spacing) + 0.5;
    float2 cell_center = cell * spacing;
    float dist = length(uv - cell_center);
    return saturate(1.0 - dist / dot_radius);
}

// Hexagonal pattern
float hexagon(float2 uv, float scale)
{
    const float3 k = float3(-0.866025404, 0.5, 0.577350269);
    float2 p = abs(uv * scale);
    p -= 2.0 * min(dot(k.xy, p), 0.0) * k.xy;
    p -= float2(clamp(p.x, -k.z, k.z), 1.0);
    return length(p);
}

// ============================================================================
// SPECIAL EFFECTS
// ============================================================================

// Turbulence (absolute value of noise)
float turbulence(float2 uv, float scale, int octaves, float seed)
{
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = scale;
    
    for (int i = 0; i < octaves; i++)
    {
        float n = grad2(uv * frequency + seed);
        value += amplitude * abs(n * 2.0 - 1.0);
        amplitude *= 0.5;
        frequency *= 2.0;
    }
    
    return value;
}

// Ridged noise (inverted turbulence)
float ridged_noise(float2 uv, float scale, int octaves, float seed)
{
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = scale;
    float weight = 1.0;
    
    for (int i = 0; i < octaves; i++)
    {
        float n = grad2(uv * frequency + seed);
        n = 1.0 - abs(n * 2.0 - 1.0);
        n = n * n; // Square for sharper ridges
        n *= weight;
        weight = saturate(n * 2.0);
        value += amplitude * n;
        amplitude *= 0.5;
        frequency *= 2.0;
    }
    
    return value;
}

// ============================================================================
// UV TRANSFORMATIONS (matching K-Engine alpha_common.wgsl)
// ============================================================================

// Apply rotation/scale/offset to UVs
float2 transform_uv(float2 uv, float rotation, float scale, float2 offset)
{
    // Center for rotation
    float2 centered = uv - 0.5;
    
    // Rotate
    float cos_r = cos(rotation);
    float sin_r = sin(rotation);
    float2 rotated = float2(
        centered.x * cos_r - centered.y * sin_r,
        centered.x * sin_r + centered.y * cos_r
    );
    
    // Scale and offset
    return rotated / scale + 0.5 + offset;
}

// Apply tiling mode
float2 apply_tiling(float2 uv, int mode)
{
    switch (mode)
    {
        case 1: // Repeat
            return frac(uv);
        case 2: // Mirror
            return abs(frac(uv * 0.5) * 2.0 - 1.0);
        default: // Clamp (0)
            return saturate(uv);
    }
}
