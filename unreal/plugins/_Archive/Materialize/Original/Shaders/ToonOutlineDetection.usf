// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
float3 outline_color;
float outline_thickness;
float depth_threshold;
float normal_threshold;
float depth_weight;
float normal_weight;

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
    float4 TexCoord1 : TEXCOORD1;
    float4 TexCoord2 : TEXCOORD2;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput ToonOutlineDetectionPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;
    float depth = Input.TexCoord0.z;
    float3 normal = Input.TexCoord1.xyz;
    float2 screen_size = Input.TexCoord2.xy;

    float2 pixel_size = (1.000000 / screen_size);
    float offset = (pixel_size.x * outline_thickness);
    float depth_diff = (abs((depth - depth)) * depth_weight);
    float3 n = normalize(normal);
    float facing = (1.000000 - abs(n.z));
    float normal_edge = (facing * normal_weight);
    float edge = max(depth_diff, normal_edge);
    float outline = smoothstep(depth_threshold, (depth_threshold + 0.050000), edge);
    FPSOutput _Result;
    _Result.Color = float4(outline_color, outline);
    return _Result;
}
