FPSOutput ToonSpecularPS(FPSInput Input)
{
    // Unpack interpolators
    float3 normal = Input.TexCoord0.xyz;
    float3 view_dir = Input.TexCoord1.xyz;
    float3 light_dir = Input.TexCoord2.xyz;
    float roughness = Input.TexCoord0.w;

    float3 n = normalize(normal);
    float3 v = normalize(view_dir);
    float3 l = normalize(light_dir);
    float3 h = normalize((l + v));
    float ndh = max(0.000000, dot(n, h));
    float spec_power = max(1.000000, ((128.000000 * ((1.000000 - specular_size))) * ((1.000000 - roughness))));
