@blueprint
fn generate_pbr_from_texture(source_texture: Texture):
    let asset = create_materialize_asset()
    asset.source_texture = source_texture
    
    let default_params = MaterializeParams()
    default_params.normal_strength = 1.0
    default_params.roughness_base = 0.7
    default_params.roughness_contrast = 1.0
    default_params.roughness_brightness = 0.0
    default_params.roughness_invert = true
    default_params.variance_weight = 0.5
    default_params.metallic_base = 0.0
    default_params.metallic_contrast = 1.0
    default_params.metallic_bias = 0.0
    default_params.metallic_sensitivity = 2.0
    default_params.ao_intensity = 1.0
    default_params.height_contrast = 1.0
    default_params.edge_wear = 0.0
    default_params.cavity_dirt = 0.0
    default_params.dust = 0.0
    default_params.grunge = 0.0
    default_params.scratches = 0.0
    default_params.noise = 0.0
    default_params.bio_detail = 0.0
    default_params.bio_frequency = 1.0
    default_params.cyber_detail = 0.0
    default_params.cyber_scale = 1.0
    default_params.emissive_threshold = 0.0
    default_params.emissive_color_boost = 1.0
    default_params.make_seamless = false
    default_params.seamless_mode = SeamlessMode::CrossBlend
    default_params.seamless_blend_width = 0.25
    default_params.gamma = 1.0
    default_params.vignette = 0.0
    default_params.pack_orm = true
    default_params.output_resolution = 0
    default_params.height_iterations = 24
    default_params.use_multi_pass_height = true
    default_params.normal_octaves = 3
    default_params.normal_sigma_base = 1.0
    default_params.normal_anisotropy = 1.0
    default_params.ao_radius = 4.0
    default_params.ao_bias = 0.0
    default_params.ao_contrast = 1.0
    default_params.advanced_normal = false
    default_params.advanced_ao = false
    
    let compute_engine = get_subsystem_MaterializeComputeEngine()
    let result = compute_engine.generate_pbr_maps_gpu(source_texture, default_params)
    
    if result.success:
        asset.base_color = result.base_color
        asset.normal = result.normal
        asset.roughness = result.roughness
        asset.metallic = result.metallic
        asset.ao = result.ao
        asset.height = result.height
        asset.emissive = result.emissive
        asset.orm = result.orm
        
        save_asset(asset)
        show_success_notification("PBR material generated successfully")
    else:
        show_error_notification("PBR generation failed", result.error_message)

