FPSOutput PBRStandardPSPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float3 n = normalize(normal);
    float3 v = normalize(view_dir);
    float3 l = normalize(light_dir);
    float3 h = normalize((l + v));
    float ndl = max(0.000000, dot(n, l));
    float ndv = max(0.000000, dot(n, v));
    float ndh = max(0.000000, dot(n, h));
