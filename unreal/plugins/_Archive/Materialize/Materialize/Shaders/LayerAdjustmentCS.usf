// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
uint2 TextureSize;  // @1
float Brightness;  // @2
float Contrast;  // @3
float Saturation;  // @4
float Hue;  // @5
float Gamma;  // @6
float Exposure;  // @7

// Texture Inputs
Texture2D<float4> InputTexture : register(t0);  // @0 -> t0 register
SamplerState InputTextureSampler : register(s0);

// UAV Outputs
RWTexture2D OutputTexture : register(u8);  // @8 -> u8 register

[numthreads(8, 8, 1)]
void LayerAdjustmentCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureSize.x) || (ThreadId.y >= TextureSize.y)))
    {
        return;
    }
    float4 pos = uvec2(ThreadId.x, ThreadId.y);
    float4 color = InputTexture.Sample(InputTextureSampler, pos);
    float3 exposed = (color.rgb * pow(2.000000, Exposure));
    float3 contrasted = ((((exposed - float3(0.500000, 0.500000, 0.500000))) * Contrast) + float3(0.500000, 0.500000, 0.500000));
    float3 brightened = (contrasted + float3(Brightness, Brightness, Brightness));
    float4 hsl = RGBtoHSL(brightened);
    float3 hsl_adjusted = float3(frac((hsl.x + Hue)), saturate((hsl.y * Saturation)), hsl.z);
    float4 rgb_adjusted = HSLtoRGB(hsl_adjusted);
    float4 gamma_corrected = pow(saturate(rgb_adjusted), float3((1.000000 / Gamma), (1.000000 / Gamma), (1.000000 / Gamma)));
    write(OutputTexture, pos, float4(gamma_corrected, color.a));
}
