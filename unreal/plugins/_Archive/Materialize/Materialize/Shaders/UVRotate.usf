// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float time;  // @0
float rotation_speed;  // @1
float pivot_x;  // @2
float pivot_y;  // @3

// Texture Inputs
Texture2D base_texture : register(t4);  // @4 -> t4 register
SamplerState base_textureSampler : register(s4);

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput UVRotatePS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float2 pivot = float2(pivot_x, pivot_y);
    float2 centered_uv = (uv - pivot);
    float angle = (time * rotation_speed);
    float cos_angle = cos(angle);
    float sin_angle = sin(angle);
    float2 rotated_uv = float2(((centered_uv.x * cos_angle) - (centered_uv.y * sin_angle)), ((centered_uv.x * sin_angle) + (centered_uv.y * cos_angle)));
    float2 final_uv = (rotated_uv + pivot);
    float4 color = base_texture.Sample(base_textureSampler, final_uv);
    FPSOutput _Result;
    _Result.Color = color;
    return _Result;
}
