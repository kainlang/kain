// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
uint2 TextureSize;  // @4
uint UseR;  // @5
uint UseG;  // @6
uint UseB;  // @7
uint UseA;  // @8

// Texture Inputs
Texture2D<float4> TextureR : register(t0);  // @0 -> t0 register
SamplerState TextureRSampler : register(s0);
Texture2D<float4> TextureG : register(t1);  // @1 -> t1 register
SamplerState TextureGSampler : register(s1);
Texture2D<float4> TextureB : register(t2);  // @2 -> t2 register
SamplerState TextureBSampler : register(s2);
Texture2D<float4> TextureA : register(t3);  // @3 -> t3 register
SamplerState TextureASampler : register(s3);

// UAV Outputs
RWTexture2D OutputTexture : register(u9);  // @9 -> u9 register

[numthreads(8, 8, 1)]
void TextureCombineCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureSize.x) || (ThreadId.y >= TextureSize.y)))
    {
        return;
    }
    float4 pos = uvec2(ThreadId.x, ThreadId.y);
    float r = ((UseR > 0) ? TextureR.Sample(TextureRSampler, pos).r : 0.000000);
    float g = ((UseG > 0) ? TextureG.Sample(TextureGSampler, pos).r : 0.000000);
    float b = ((UseB > 0) ? TextureB.Sample(TextureBSampler, pos).r : 0.000000);
    float a = ((UseA > 0) ? TextureA.Sample(TextureASampler, pos).r : 1.000000);
    write(OutputTexture, pos, float4(r, g, b, a));
}
