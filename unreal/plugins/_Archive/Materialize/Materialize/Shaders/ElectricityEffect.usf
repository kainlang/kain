    float center_x = 0.500000;
    float dist_to_center = abs((uv.x - center_x));
    float2 noise_uv = float2(((uv.y * 10.000000) + (time * flicker_speed)), (uv.x * 5.000000));
    float4 noise = perlin_noise(noise_uv);
