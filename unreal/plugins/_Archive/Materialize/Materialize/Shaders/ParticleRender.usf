// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
int particle_count;  // @0
float4x4 view_matrix;  // @1
float4x4 projection_matrix;  // @2
float3 camera_right;  // @3
float3 camera_up;  // @4
int color_over_lifetime;  // @5
int size_over_lifetime;  // @6
StructuredBuffer<Particle> particle_buffer;  // @7
StructuredBuffer<float4> color_curve;  // @9
StructuredBuffer<float> size_curve;  // @10

// UAV Outputs
RWBuffer vertex_buffer : register(u8);  // @8 -> u8 register

[numthreads(8, 8, 1)]
void ParticleRenderCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float particle_id = ThreadId.x;
    if ((particle_id >= particle_count))
    {
        return;
    }
    StructuredBuffer<Particle> p = particle_buffer[particle_id];
    if ((p.age >= p.lifetime))
    {
        return;
    }
    float life_ratio = (p.age / p.lifetime);
    float color = p.color;
    if ((color_over_lifetime > 0))
    {
        int curve_idx = min(int((life_ratio * 10.000000)), 9);
        color = color_curve[curve_idx];
    }
    float size = p.size;
    if ((size_over_lifetime > 0))
    {
        int curve_idx = min(int((life_ratio * 10.000000)), 9);
        StructuredBuffer<float> size_mult = size_curve[curve_idx];
        size = (size * size_mult);
    }
    float cos_rot = cos(p.rotation);
    float sin_rot = sin(p.rotation);
    float3 right = (camera_right * size.x);
    float3 up = (camera_up * size.y);
    float v0 = ((p.position - (right * cos_rot)) - (up * sin_rot));
    float v1 = ((p.position + (right * sin_rot)) - (up * cos_rot));
    float v2 = ((p.position + (right * cos_rot)) + (up * sin_rot));
    float v3 = ((p.position - (right * sin_rot)) + (up * cos_rot));
    float base_idx = (particle_id * 24);
    vertex_buffer[(base_idx + 0)] = v0.x;
    vertex_buffer[(base_idx + 1)] = v0.y;
    vertex_buffer[(base_idx + 2)] = v0.z;
    vertex_buffer[(base_idx + 3)] = color.r;
    vertex_buffer[(base_idx + 4)] = color.g;
    vertex_buffer[(base_idx + 5)] = color.b;
    vertex_buffer[(base_idx + 6)] = v1.x;
    vertex_buffer[(base_idx + 7)] = v1.y;
    vertex_buffer[(base_idx + 8)] = v1.z;
    vertex_buffer[(base_idx + 9)] = color.r;
    vertex_buffer[(base_idx + 10)] = color.g;
    vertex_buffer[(base_idx + 11)] = color.b;
    vertex_buffer[(base_idx + 12)] = v2.x;
    vertex_buffer[(base_idx + 13)] = v2.y;
    vertex_buffer[(base_idx + 14)] = v2.z;
    vertex_buffer[(base_idx + 15)] = color.r;
    vertex_buffer[(base_idx + 16)] = color.g;
    vertex_buffer[(base_idx + 17)] = color.b;
    vertex_buffer[(base_idx + 18)] = v3.x;
    vertex_buffer[(base_idx + 19)] = v3.y;
    vertex_buffer[(base_idx + 20)] = v3.z;
    vertex_buffer[(base_idx + 21)] = color.r;
    vertex_buffer[(base_idx + 22)] = color.g;
    vertex_buffer[(base_idx + 23)] = color.b;
}
