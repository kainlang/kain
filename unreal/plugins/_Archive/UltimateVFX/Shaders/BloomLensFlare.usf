// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float bloom_threshold;  // @0
float bloom_intensity;  // @1
float bloom_radius;  // @2
float bloom_softness;  // @3
float lens_flare_intensity;  // @4
float lens_flare_ghosts;  // @5
float lens_flare_halo_radius;  // @6
float lens_flare_halo_thickness;  // @7
float chromatic_aberration;  // @8
float lens_dirt_intensity;  // @9

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
    float4 TexCoord1 : TEXCOORD1;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput BloomLensFlarePS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;
    float3 screen_color = Input.TexCoord1.xyz;

    float brightness = max(max(screen_color.x, screen_color.y), screen_color.z);
    float bloom_mask = max(0.000000, (brightness - bloom_threshold));
    float3 bloom = ((screen_color * bloom_mask) * bloom_intensity);
    float2 center = float2(0.500000, 0.500000);
    float dist = length((center - uv));
    float flare = (exp(((-dist) * 10.000000)) * lens_flare_intensity);
    float3 final_color = ((screen_color + bloom) + float3(flare, flare, flare));
    FPSOutput _Result;
    _Result.Color = float4(final_color, 1.000000);
    return _Result;
}
