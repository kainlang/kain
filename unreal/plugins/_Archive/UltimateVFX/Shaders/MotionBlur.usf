// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float blur_intensity;  // @0
float blur_samples;  // @1
float velocity_scale;  // @2
float max_blur_radius;  // @3
float center_fade;  // @4

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput MotionBlurPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;
    float2 velocity = Input.TexCoord0.zw;

    float2 blur_vec = ((velocity * velocity_scale) * blur_intensity);
    float blur_length = min(length(blur_vec), max_blur_radius);
    float safe_len = max(length(blur_vec), 0.000100);
    float2 blur_dir = (blur_vec / safe_len);
    float3 color_sum = float3(0.000000, 0.000000, 0.000000);
    float i = 0.000000;
    float safe_samples = max(blur_samples, 1.000000);
    while ((i < safe_samples))
    {
        float2 offset = ((blur_dir * ((i / safe_samples))) * blur_length);
        color_sum = (color_sum + float3(1.000000, 1.000000, 1.000000));
        i = (i + 1.000000);
    }
    float3 final_color = (color_sum / safe_samples);
    FPSOutput _Result;
    _Result.Color = float4(final_color, 1.000000);
    return _Result;
}
