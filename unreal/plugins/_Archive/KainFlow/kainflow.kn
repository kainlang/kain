    @category("Actions")
    @button("Bake to Static Mesh")
    fn on_bake_mesh():
        println("Baking deformation to static mesh...")
    
    @category("Debug")
    @button("Spawn Test Character")
    fn on_spawn_test():
        println("Spawning test character for footprints...")
    
    @category("Debug")
    @button("Spawn Test Vehicle")
    fn on_spawn_vehicle():
        println("Spawning test vehicle for tracks...")

# ============================================================================
# VIEWPORT - 3D terrain preview
# ============================================================================

@viewport
struct TerrainPreviewViewport:
    @scene_actor
    terrain_mesh: StaticMeshComponent
    
    @scene_actor
    test_character: SkeletalMeshComponent
    
    @camera
    preview_camera: CameraComponent
    
    camera_distance: Float
    camera_rotation: Vec2
    is_playing: Bool
    
    fn on_viewport_tick(delta: Float):
        # Update camera orbit
        preview_camera.SetRelativeLocation(vec3(
            camera_distance * cos(camera_rotation.x) * cos(camera_rotation.y),
            camera_distance * sin(camera_rotation.x) * cos(camera_rotation.y),
            camera_distance * sin(camera_rotation.y)
        ))
        
        # Animate test character if playing
        if is_playing:
            # Walk forward and leave footprints
            let char_pos = test_character.GetRelativeLocation()
            test_character.SetRelativeLocation(char_pos + vec3(delta * 100.0, 0, 0))

# ============================================================================
# TOOLBAR - Terrain editing toolbar
# ============================================================================

@toolbar
struct TerrainToolbar:
    @button("New Terrain", icon: "Icons.Terrain", shortcut: "Ctrl+N")
    fn on_new_terrain():
        println("Creating new terrain...")
    
    @button("Import Heightmap", icon: "Icons.Import")
    fn on_import_heightmap():
        println("Importing heightmap...")
    
    @button("Export Heightmap", icon: "Icons.Export")
    fn on_export_heightmap():
        println("Exporting heightmap...")
    
    @separator
    
    @button("Play Simulation", icon: "Icons.Play")
    fn on_play():
        println("Starting simulation...")
    
    @button("Pause", icon: "Icons.Pause")
    fn on_pause():
        println("Pausing simulation...")
    
    @button("Reset", icon: "Icons.Reset")
    fn on_reset():
        println("Resetting terrain...")
    
    @separator
    
    @toggle("Show Particles", default: true)
    fn on_toggle_particles(enabled: Bool):
        println("Particles: {enabled}")
    
    @toggle("Show Wireframe", default: false)
    fn on_toggle_wireframe(enabled: Bool):
        println("Wireframe: {enabled}")
    
    @separator
    
    @dropdown("Material", options: ["Mud", "Snow", "Sand", "Clay"])
    fn on_material_changed(value: String):
        println("Material: {value}")
    
    @button("Bake to Static Mesh", icon: "Icons.Mesh")
    fn on_bake():
        println("Baking to static mesh...")
