    @category("Material")
    @slider(100.0, 20000.0)
    yield_stress: Float
    
    @category("Visual")
    @color_picker
    terrain_color: Vec3
    
    @category("Visual")
    @slider(0.0, 1.0)
    roughness: Float
    
    @category("Visual")
    @slider(0.0, 10.0)
