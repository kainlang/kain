# ============================================================================
# TEMPORAL BLUEPRINT — Details Panel Customizations
# ============================================================================
# Custom Details panels for TemporalActorProxy, TemporalZoneActor,
# TemporalAnchorActor, TemporalPortalActor, and TemporalManagerActor.
# ============================================================================

# ============================================================================
# SECTION 1: TEMPORAL ACTOR PROXY DETAILS
# ============================================================================

@details(target="TemporalActorProxy")
struct FTemporalActorProxyDetails:
    @category("Temporal|Identity")
    actor_guid: String

    @category("Temporal|Identity")
    display_name: String

    @category("Temporal|Behavior")
    behavior: TemporalActorBehavior

    @category("Temporal|Behavior")
    native_era: TemporalEra

    @category("Temporal|Visibility")
    visible_in_ancient: Bool

    @category("Temporal|Visibility")
    visible_in_past: Bool

    @category("Temporal|Visibility")
    visible_in_present: Bool

    @category("Temporal|Visibility")
    visible_in_future: Bool

    @category("Temporal|Visibility")
    visible_in_apocalyptic: Bool

    @category("Temporal|Visibility")
    visible_in_alternate: Bool

    @category("Temporal|Visibility")
    visible_in_void: Bool

    @category("Temporal|Ghost")
    show_ghost_in_non_native: Bool

    @category("Temporal|Ghost")
    ghost_opacity: Float

    @category("Temporal|Ghost")
    ghost_color: Vec3

    @category("Temporal|Ghost")
    ghost_emissive_strength: Float

    @category("Temporal|CustomData")
    custom_data_0: Float

    @category("Temporal|CustomData")
    custom_data_1: Float

    @category("Temporal|CustomData")
    custom_data_2: Float

    @category("Temporal|CustomData")
    custom_data_3: Float

    @category("Temporal|Causality")
    participates_in_causality: Bool

    @category("Temporal|Causality")
    causality_group_tag: String

# ============================================================================
# SECTION 2: TEMPORAL ZONE ACTOR DETAILS
# ============================================================================

@details(target="TemporalZoneActor")
struct FTemporalZoneDetails:
    @category("Temporal|Zone")
    zone_id: Int

    @category("Temporal|Zone")
    zone_name: String

    @category("Temporal|Zone")
    forced_era: TemporalEra

    @category("Temporal|Zone")
    has_forced_era: Bool

    @category("Temporal|Zone")
    blend_radius: Float

    @category("Temporal|Zone")
    priority: Int

    @category("Temporal|Zone")
    enabled: Bool

    @category("Temporal|Zone")
    zone_extent: Vec3

    @category("Temporal|Zone")
    zone_shape_is_sphere: Bool

    @category("Temporal|Transition")
    override_transition_type: Bool

    @category("Temporal|Transition")
    transition_type: TemporalTransitionType

    @category("Temporal|Transition")
    transition_duration: Float

    @category("Temporal|Debug")
    debug_color: Vec3

    @category("Temporal|Debug")
    show_debug_bounds: Bool

