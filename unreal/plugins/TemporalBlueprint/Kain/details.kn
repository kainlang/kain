    @category("Temporal|Transition")
    default_transition_duration: Float

    @category("Temporal|Transition")
    allow_player_initiated_transitions: Bool

    @category("Temporal|Snapshots")
    autosave_snapshots: Bool

    @category("Temporal|Snapshots")
    max_snapshots: Int

    @category("Temporal|Debug")
    debug_mode: TemporalDebugMode

    @category("Temporal|Debug")
    show_era_overlay: Bool

    @category("Temporal|Debug")
    log_transitions: Bool

    @category("Temporal|Stats")
