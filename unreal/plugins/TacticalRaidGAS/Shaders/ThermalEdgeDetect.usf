// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float2 texel_size;  // @1
float edge_threshold;  // @2
float3 edge_color;  // @3

// Texture Inputs
Texture2D source_tex : register(t0);  // @0 -> t0 register
SamplerState source_texSampler : register(s0);

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput ThermalEdgeDetectPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float4 c = source_tex.Sample(source_texSampler, uv);
    float4 right = source_tex.Sample(source_texSampler, (uv + float2(texel_size.x, 0.000000)));
    float4 up = source_tex.Sample(source_texSampler, (uv + float2(0.000000, texel_size.y)));
    float grad = (abs((c.r - right.r)) + abs((c.r - up.r)));
    float edge = smoothstep(edge_threshold, (edge_threshold + 0.050000), grad);
    FPSOutput _Result;
    _Result.Color = float4((edge_color * edge), edge);
    return _Result;
}
