// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float3 pulse_origin;  // @0
float pulse_radius;  // @1
float pulse_softness;  // @2
float3 field_color;  // @3

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
    float4 TexCoord1 : TEXCOORD1;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput SuppressionFieldPSPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;
    float3 world_pos = Input.TexCoord1.xyz;

    float dist = length((world_pos - pulse_origin));
    float edge = abs((dist - pulse_radius));
    float mask = (1.000000 - smoothstep(0.000000, pulse_softness, edge));
    FPSOutput _Result;
    _Result.Color = float4((field_color * mask), mask);
    return _Result;
}
