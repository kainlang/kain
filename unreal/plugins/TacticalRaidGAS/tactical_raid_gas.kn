# ---------------------------------------------------------------------------
# ADDITIONAL SHADERS (stress path)
# ---------------------------------------------------------------------------

shader compute InfluencePropagationCS(id: Vec3) -> Vec4:
    uniform seed: Float @0
    uniform decay: Float @1
    uniform spread: Float @2
    uniform pulse_speed: Float @3

    let uv = vec2(id.x / 2048.0, id.y / 2048.0)
    let base = fract(sin(dot(uv, vec2(91.7, 43.3)) + seed) * 15731.31)
    let wave = sin((uv.x - uv.y) * spread + pulse_speed) * 0.5 + 0.5
    let influence = max(base * decay, wave)
    return vec4(influence, influence * 0.6, wave, 1.0)

shader fragment ReconVisionComposite(uv: Vec2, world_pos: Vec3) -> Vec4:
    uniform threat_map: Sampler2D @0
    uniform suppression_map: Sampler2D @1
    uniform overlay_intensity: Float @2
    uniform edge_gain: Float @3
    uniform recon_tint: Vec3 @4

    let threat = sample(threat_map, uv)
    let suppress = sample(suppression_map, uv)
    let edge = abs(threat.r - suppress.r) * edge_gain
    let blend = max(threat.r, suppress.r) * overlay_intensity
    let color = recon_tint * (blend + edge)
    return vec4(color, blend)

shader fragment ThermalEdgeDetect(uv: Vec2) -> Vec4:
    uniform source_tex: Sampler2D @0
    uniform texel_size: Vec2 @1
    uniform edge_threshold: Float @2
    uniform edge_color: Vec3 @3

    let c = sample(source_tex, uv)
    let right = sample(source_tex, uv + vec2(texel_size.x, 0.0))
    let up = sample(source_tex, uv + vec2(0.0, texel_size.y))
    let grad = abs(c.r - right.r) + abs(c.r - up.r)
    let edge = smoothstep(edge_threshold, edge_threshold + 0.05, grad)
    return vec4(edge_color * edge, edge)

shader fragment JammerDistortionPS(uv: Vec2, world_pos: Vec3) -> Vec4:
    uniform source_tex: Sampler2D @0
    uniform jam_origin: Vec3 @1
    uniform jam_radius: Float @2
    uniform jam_strength: Float @3
    uniform noise_phase: Float @4

    let dist = length(world_pos - jam_origin)
    let falloff = 1.0 - smoothstep(jam_radius * 0.7, jam_radius, dist)
    let n = sin((uv.x + uv.y) * 64.0 + noise_phase) * jam_strength * falloff * 0.01
    let warped_uv = uv + vec2(n, -n)
    let src = sample(source_tex, warped_uv)
    return vec4(src.rgb * (1.0 - falloff * 0.2), src.a)

shader fragment ExtractionBeaconPS(uv: Vec2, world_pos: Vec3) -> Vec4:
    uniform beacon_pos: Vec3 @0
    uniform beacon_radius: Float @1
    uniform beacon_softness: Float @2
    uniform beacon_color: Vec3 @3
    uniform pulse_time: Float @4

    let d = length(world_pos - beacon_pos)
    let ring = abs(d - beacon_radius)
    let pulse = sin(pulse_time + d * 0.15) * 0.5 + 0.5
    let mask = 1.0 - smoothstep(0.0, beacon_softness, ring)
    let emissive = beacon_color * mask * (0.5 + pulse)
    return vec4(emissive, mask)

# ---------------------------------------------------------------------------
# MORE MATERIALS FOR RENDER STACK
# ---------------------------------------------------------------------------

@material_function
fn MF_OverlayWeighter(threat: Float, suppression: Float, weight: Float):
    let blended = threat * (1.0 - weight) + suppression * weight
    return blended * 1.2

@material_graph(blend_mode: Translucent)
material M_ReconVision:
    input threat_map: Texture2D
    input suppression_map: Texture2D
    input recon_tint: Vec3 = vec3(0.1, 0.9, 0.7)
    input overlay_intensity: Float = 1.25

    let threat_sample = threat_map
    let suppression_sample = suppression_map
    let emissive_color = recon_tint * overlay_intensity

    output base_color = threat_sample
    output emissive = emissive_color
    output opacity = 0.7

@material_graph(blend_mode: Additive)
material M_ExtractionBeacon:
    input beacon_mask: Texture2D
    input beacon_color: Vec3 = vec3(0.2, 0.8, 1.0)
    input glow_intensity: Float = 5.0

    let mask_sample = beacon_mask
    let emissive_color = beacon_color * glow_intensity

    output base_color = mask_sample
    output emissive = emissive_color
    output opacity = 0.9

