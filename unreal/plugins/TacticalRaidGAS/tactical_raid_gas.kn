# ============================================================================
# TacticalRaidGAS
# Real-world use case: multiplayer tactical raid shooter where role tags,
# team tags, stance tags, and state tags drive ability gating + replication.
# ============================================================================

# ============================================================================
# DATA-DRIVEN GAMEPLAY TAG TAXONOMY
# ============================================================================

@gameplay_tags
namespace Entity:
    RoleTag:
        Assault
        Medic
        Recon
        Engineer
    TeamTag:
        Friendly
        Enemy
        Neutral
    Posture:
        Standing
        Crouched
        Prone
    LifeState:
        Alive
        Downed
        Dead
        Suppressed
        Cloaked

@gameplay_tags
namespace Ability:
    Weapon:
        BurstFire
        GrenadeThrow
    Movement:
        CombatRoll
        TacticalSprint
    Support:
        MedicRevive
        ArmorPack
    Utility:
        PingTarget
        JamComms

@gameplay_tags
namespace Cooldown:
    Weapon:
        BurstFire
        GrenadeThrow
    Movement:
        CombatRoll
    Support:
        MedicRevive

@gameplay_tags
namespace Event:
    Combat:
        TookDamage
        ScoredHit
        EliminatedTarget
    Squad:
        ReviveStarted
        ReviveCompleted

@gameplay_tags
namespace GameplayCue:
    Combat:
        MuzzleFlash
        SuppressionPulse
    Support:
        ReviveBeam

# ============================================================================
# GAMEPLAY EFFECTS
# ============================================================================

@gameplay_effect
struct GE_StaminaCost_BurstFire:
    @duration(type: "Instant")
    duration: 0.0

    @modifier(attribute: "Stamina", operation: "Add")
    stamina_spend: -12.0

    @owned_tags
    tags: ["Effect.Cost.Weapon.BurstFire"]

    @application_tag_requirements
    require: ["Entity.LifeState.Alive"]
    ignore: ["Entity.LifeState.Dead"]

@gameplay_effect
struct GE_Cooldown_BurstFire:
    @duration(type: "HasDuration")
    duration: 1.25

    @granted_tags
    tags: ["Cooldown.Weapon.BurstFire"]

    @ongoing_tag_requirements
    require: ["Entity.LifeState.Alive"]
    ignore: ["Entity.LifeState.Dead"]

@gameplay_effect
struct GE_SuppressedDebuff:
    @duration(type: "HasDuration")
    duration: 4.0

    @period
    period: 1.0
    execute_on_application: true

    @modifier(attribute: "MoveSpeed", operation: "Multiply")
    suppression_slow: 0.82

    @granted_tags
    tags: ["Entity.LifeState.Suppressed"]

    @stacking
    type: "AggregateByTarget"
    limit: 3

@gameplay_effect
struct GE_Cooldown_MedicRevive:
    @duration(type: "HasDuration")
    duration: 10.0

    @granted_tags
    tags: ["Cooldown.Support.MedicRevive"]

