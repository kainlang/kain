# ============================================================================
# ABILITY TASK
# ============================================================================

@ability_task
struct WaitForSquadConfirmTask:
    @delegate
    on_confirmed: GameplayEventDelegate

    @delegate
    on_cancelled: TaskCancelledDelegate

    fn activate():
        println("WaitForSquadConfirmTask activated")

    fn on_destroy():
        println("WaitForSquadConfirmTask destroyed")

# ============================================================================
# TARGET ACTOR
# ============================================================================

@target_actor
struct TacticalLineTraceTarget:
    trace_type: "Line"
    max_range: 3500.0
    trace_channel: "Visibility"

    filter:
        self_filter: "Exclude"
        required_actor_class: "ACharacter"
        require_tags: ["Entity.LifeState.Alive"]
        ignore_tags: ["Entity.LifeState.Dead", "Entity.TeamTag.Friendly"]

    reticle_class: "BP_TacticalReticle"

# ============================================================================
# GAMEPLAY ABILITIES
# ============================================================================

@ability
struct GA_BurstFire:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")

    @ability_tags
    tags: ["Ability.Weapon.BurstFire", "Entity.RoleTag.Assault"]

    @activation_required_tags
    required: ["Entity.LifeState.Alive", "Entity.Posture.Standing"]

    @activation_blocked_tags
    blocked: ["Entity.LifeState.Dead", "Entity.LifeState.Downed", "Cooldown.Weapon.BurstFire"]

    @activation_owned_tags
    owned: ["Event.Combat.ScoredHit"]

    @cancel_abilities_with_tag
    cancel: ["Ability.Weapon.GrenadeThrow"]

    @block_abilities_with_tag
    block: ["Ability.Support.MedicRevive"]

    @cost
    effect: GE_StaminaCost_BurstFire

    @cooldown
    effect: GE_Cooldown_BurstFire

    fn can_activate_ability(handle, actor_info, source_tags, target_tags, optional_relevant_tags):
        return true

    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        send_gameplay_event("Event.Combat.ScoredHit")
        end_ability(handle, actor_info, activation_info, true, false)

@ability
struct GA_CombatRoll:
    @instancing(policy: "InstancedPerActor")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")

    @ability_tags
    tags: ["Ability.Movement.CombatRoll"]

    @activation_required_tags
    required: ["Entity.LifeState.Alive"]

    @activation_blocked_tags
    blocked: ["Entity.LifeState.Suppressed", "Cooldown.Movement.CombatRoll"]

    @activation_owned_tags
    owned: ["Entity.Posture.Crouched"]

    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        send_gameplay_event("Event.Combat.TookDamage")
        end_ability(handle, actor_info, activation_info, true, false)

@ability
struct GA_MedicRevive:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "ServerInitiated")

    @ability_tags
    tags: ["Ability.Support.MedicRevive", "Entity.RoleTag.Medic"]

    @activation_required_tags
    required: ["Entity.LifeState.Alive", "Entity.RoleTag.Medic"]

    @activation_blocked_tags
    blocked: ["Entity.LifeState.Dead", "Cooldown.Support.MedicRevive"]

    @activation_owned_tags
    owned: ["Event.Squad.ReviveStarted"]

    @cancel_abilities_with_tag
    cancel: ["Ability.Weapon.BurstFire", "Ability.Weapon.GrenadeThrow"]

    @cost
    effect: GE_StaminaCost_BurstFire

    @cooldown
    effect: GE_Cooldown_MedicRevive

    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        send_gameplay_event("Event.Squad.ReviveStarted")
        send_gameplay_event("Event.Squad.ReviveCompleted")
        end_ability(handle, actor_info, activation_info, true, false)

# ============================================================================
# RENDER + ACTOR MELTING POT (single-file integrated systems test)
# ============================================================================

enum ThreatBand:
    None
    Low
    Medium
    High
    Critical

enum RaidPhase:
    Insertion
    Contact
    Containment
    Extraction

@component
struct TacticalVisionComponent:
    heatmap_scale: Float
    suppression_decay: Float
    pulse_speed: Float
    distortion_strength: Float

@component
struct SquadStateComponent:
    alive_count: Int
    downed_count: Int
    average_suppression: Float
    current_phase: RaidPhase

@uclass("Blueprintable", "BlueprintType")
actor TacticalRaidDirector:
    state vision: TacticalVisionComponent = TacticalVisionComponent()
    state squad: SquadStateComponent = SquadStateComponent()

    @replicated
    state active_heat_seed: Int = 1337

    @replicated
    state global_alert_level: Float = 0.2

    state raid_timer_seconds: Float = 0.0
    state extraction_enabled: Bool = false

    on BeginPlay():
        Server_BeginRaid(active_heat_seed)

    on Tick():
        raid_timer_seconds = raid_timer_seconds + 0.016
        if raid_timer_seconds > 420.0:
            extraction_enabled = true

    on Server_BeginRaid(seed: Int):
        active_heat_seed = seed
        squad.current_phase = RaidPhase::Insertion
        Multicast_OnRaidPhaseChanged(0)

    on Server_OnObjectiveCompromised(severity: Float):
        global_alert_level = global_alert_level + severity
        if global_alert_level > 0.55:
            squad.current_phase = RaidPhase::Contact
            send_gameplay_event("Event.Combat.TookDamage")
        if global_alert_level > 0.8:
            squad.current_phase = RaidPhase::Containment
            send_gameplay_event("Event.Combat.EliminatedTarget")
        Multicast_OnRaidPhaseChanged(1)

    on Multicast_OnRaidPhaseChanged(phase_index: Int):
        println("Raid phase changed")

@uclass("Blueprintable")
actor TacticalReconDrone:
    state energy: Float = 100.0
    state altitude_meters: Float = 45.0
    state scan_radius: Float = 2500.0
    state threat_bias: Float = 0.65
    state distortion_strength: Float = 0.12
    state pulse_speed: Float = 3.5

    @replicated
    state squad_link_quality: Float = 1.0

    on Tick():
        energy = max(0.0, energy - 0.02)
        if energy < 20.0:
            send_gameplay_event("Event.Combat.TookDamage")

    on Server_SetThreatBias(new_bias: Float):
        threat_bias = new_bias

    on Multicast_EmitSuppressionPulse():
        send_gameplay_event("Event.Combat.ScoredHit")

# ---------------------------------------------------------------------------
# SHADERS (.usf generation + shader binding stress)
# ---------------------------------------------------------------------------

shader compute ThreatHeatmapCS(id: Vec3) -> Vec4:
    uniform heat_seed: Float @0
    uniform alert_level: Float @1
    uniform threat_bias: Float @2
    uniform pulse_speed: Float @3

    let uv = vec2(id.x / 1024.0, id.y / 1024.0)
    let base_noise = fract(sin(dot(uv, vec2(12.9898, 78.233)) + heat_seed) * 43758.5453)
    let pulse = sin((uv.x + uv.y) * 20.0 + pulse_speed) * 0.5 + 0.5
    let danger = base_noise * (0.35 + alert_level * 0.65)
    let weighted = max(danger, pulse * threat_bias)
    return vec4(weighted, weighted * alert_level, pulse, 1.0)

shader fragment TacticalThreatOverlay(uv: Vec2) -> Vec4:
    uniform threat_map: Sampler2D @0
    uniform alert_level: Float @1
    uniform distortion_strength: Float @2
    uniform thermal_tint: Vec3 @3

    let jitter = vec2(sin(uv.y * 120.0), cos(uv.x * 90.0)) * distortion_strength * 0.01
    let warped_uv = uv + jitter
    let heat = sample(threat_map, warped_uv)
    let tinted = heat.rgb * thermal_tint
    let alpha = max(heat.r, alert_level * 0.2)
    return vec4(tinted, alpha)

shader fragment SuppressionFieldPS(uv: Vec2, world_pos: Vec3) -> Vec4:
    uniform pulse_origin: Vec3 @0
    uniform pulse_radius: Float @1
    uniform pulse_softness: Float @2
    uniform field_color: Vec3 @3

    let dist = length(world_pos - pulse_origin)
    let edge = abs(dist - pulse_radius)
    let mask = 1.0 - smoothstep(0.0, pulse_softness, edge)
    return vec4(field_color * mask, mask)

# ---------------------------------------------------------------------------
# MATERIAL FUNCTIONS + GRAPHS (binary material assets + graph serialization)
# ---------------------------------------------------------------------------

@material_function
fn MF_ThreatBanding(heat_value: Float, low_cutoff: Float, high_cutoff: Float):
    let low_band = (heat_value - low_cutoff) * 8.0
    let high_band = (heat_value - high_cutoff) * 8.0
    return low_band + high_band * 0.5

@material_function
fn MF_SuppressionFalloff(distance_norm: Float, softness: Float):
    let inv = 1.0 - distance_norm
    let shaped = inv * inv
    return shaped * softness

@material_graph(blend_mode: Translucent)
material M_TacticalThreatOverlay:
    input threat_tex: Texture2D
    input thermal_tint: Vec3 = vec3(1.0, 0.35, 0.15)
    input emissive_boost: Float = 2.0
    input opacity_scale: Float = 0.8

    let threat_sample = threat_tex
    let emissive_color = thermal_tint * emissive_boost
    let opacity_value = opacity_scale

    output base_color = threat_sample
    output emissive = emissive_color
    output opacity = opacity_value

@material_graph(blend_mode: Additive)
material M_SuppressionPulse:
    input pulse_mask: Texture2D
    input pulse_color: Vec3 = vec3(0.1, 0.8, 1.0)
    input pulse_intensity: Float = 4.0
    input edge_softness: Float = 0.35

    let mask_sample = pulse_mask
    let glow = pulse_color * pulse_intensity
    let opacity_value = edge_softness

    output base_color = mask_sample
    output emissive = glow
    output opacity = opacity_value

