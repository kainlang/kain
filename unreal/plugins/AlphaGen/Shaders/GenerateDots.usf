// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
uint2 texture_size;
float dot_radius;
float spacing;

// UAV Outputs
RWTexture2D<float4> OutputTexture : register(u0);

[numthreads(32, 32, 1)]
void GenerateDotsCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    uint2 pixel = uint2(ThreadId.xy);
    if (((pixel.x >= texture_size.x) || (pixel.y >= texture_size.y)))
    {
        OutputTexture[ThreadId.xy] = float4(0.000000, 0.000000, 0.000000, 0.000000);
        return;
    }
    float2 uv = (((float2(pixel) + 0.500000)) / float2(texture_size));
    float2 grid_uv = (uv / spacing);
    float2 cell = floor(grid_uv);
    float2 local_uv = (frac(grid_uv) - 0.500000);
    float dist = length(local_uv);
    float value = (1.000000 - smoothstep((dot_radius - 0.010000), dot_radius, dist));
    OutputTexture[ThreadId.xy] = float4(value, value, value, 1.000000);
    return;
}
