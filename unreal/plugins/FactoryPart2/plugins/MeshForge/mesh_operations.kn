# MeshForge - Mesh Operations
# Blueprint-callable mesh manipulation functions

@blueprint
fn create_cube_mesh(size: Float) -> MeshData:
    let half_size = size * 0.5
    let mesh = MeshData {
        vertices: [],
        triangles: [],
        bounds_min: vec3(-half_size, -half_size, -half_size),
        bounds_max: vec3(half_size, half_size, half_size),
        vertex_count: 0,
        triangle_count: 0
    }
    return mesh

@blueprint
fn create_sphere_mesh(radius: Float, segments: Int) -> MeshData:
    let mesh = MeshData {
        vertices: [],
        triangles: [],
        bounds_min: vec3(-radius, -radius, -radius),
        bounds_max: vec3(radius, radius, radius),
        vertex_count: 0,
        triangle_count: 0
    }
    return mesh

@blueprint
fn create_cylinder_mesh(radius: Float, height: Float, segments: Int) -> MeshData:
    let half_height = height * 0.5
    let mesh = MeshData {
        vertices: [],
        triangles: [],
        bounds_min: vec3(-radius, -radius, -half_height),
        bounds_max: vec3(radius, radius, half_height),
        vertex_count: 0,
        triangle_count: 0
    }
    return mesh

@blueprint
fn create_plane_mesh(width: Float, height: Float, subdivisions: Int) -> MeshData:
    let half_width = width * 0.5
    let half_height = height * 0.5
    let mesh = MeshData {
        vertices: [],
        triangles: [],
        bounds_min: vec3(-half_width, -half_height, 0.0),
        bounds_max: vec3(half_width, half_height, 0.0),
        vertex_count: 0,
        triangle_count: 0
    }
    return mesh

