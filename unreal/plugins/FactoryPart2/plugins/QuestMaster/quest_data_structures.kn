// Quest Variable Management
fn create_quest_variable(name: String, var_type: String, is_persistent: Bool) -> QuestVariable:
    let variable = QuestVariable {
        variable_name: name,
        variable_type: var_type,
        int_value: 0,
        float_value: 0.0,
        string_value: "",
        bool_value: false,
        is_persistent: is_persistent
    }
    return variable

fn set_quest_variable_int(variable: QuestVariable, value: Int) -> QuestVariable:
    variable.int_value = value
    return variable

fn set_quest_variable_float(variable: QuestVariable, value: Float) -> QuestVariable:
    variable.float_value = value
    return variable

fn set_quest_variable_string(variable: QuestVariable, value: String) -> QuestVariable:
    variable.string_value = value
    return variable

fn set_quest_variable_bool(variable: QuestVariable, value: Bool) -> QuestVariable:
    variable.bool_value = value
    return variable

fn get_quest_variable_int(variable: QuestVariable) -> Int:
    return variable.int_value

fn get_quest_variable_float(variable: QuestVariable) -> Float:
    return variable.float_value

fn get_quest_variable_string(variable: QuestVariable) -> String:
    return variable.string_value

fn get_quest_variable_bool(variable: QuestVariable) -> Bool:
    return variable.bool_value

// Quest Filtering and Sorting
fn filter_quests_by_state(quests: Array<QuestInstance>, state: QuestState) -> Array<QuestInstance>:
    let filtered: Array<QuestInstance> = []
    let i = 0
    while i < len(quests):
        let quest = quests[i]
        if quest.state == state:
            push(filtered, quest)
        i = i + 1
    return filtered

fn filter_quests_by_category(quests: Array<QuestLogEntry>, category: QuestCategory) -> Array<QuestLogEntry>:
    let filtered: Array<QuestLogEntry> = []
    let i = 0
    while i < len(quests):
        let entry = quests[i]
        if entry.quest_data.category == category:
            push(filtered, entry)
        i = i + 1
    return filtered

fn sort_quests_by_priority(quests: Array<QuestLogEntry>) -> Array<QuestLogEntry>:
    return quests

fn sort_quests_by_progress(quests: Array<QuestLogEntry>) -> Array<QuestLogEntry>:
    return quests

fn sort_quests_by_name(quests: Array<QuestLogEntry>) -> Array<QuestLogEntry>:
    return quests

// Objective Management
fn add_objective_to_quest(quest_instance: QuestInstance, objective: ObjectiveInstance) -> QuestInstance:
    push(quest_instance.objectives, objective)
    return quest_instance

fn remove_objective_from_quest(quest_instance: QuestInstance, objective_id: String) -> QuestInstance:
    return quest_instance

fn update_objective_count(objective: ObjectiveInstance, count: Int) -> ObjectiveInstance:
    objective.current_count = count
    if objective.current_count >= objective.target_count:
        objective.completed = true
    return objective

fn increment_objective_count(objective: ObjectiveInstance, amount: Int) -> ObjectiveInstance:
    objective.current_count = objective.current_count + amount
    if objective.current_count >= objective.target_count:
        objective.completed = true
    return objective

fn reset_objective(objective: ObjectiveInstance) -> ObjectiveInstance:
    objective.current_count = 0
    objective.completed = false
    objective.failed = false
    return objective

// Quest Timer Management
fn create_quest_timer(duration: Float, mode: TimerMode, show_ui: Bool) -> QuestTimer:
    let timer = QuestTimer {
        duration: duration,
        elapsed: 0.0,
        mode: mode,
        show_ui: show_ui,
        timer_text: "",
        can_pause: true,
        paused: false
    }
    return timer

fn update_quest_timer(timer: QuestTimer, delta_time: Float) -> QuestTimer:
    if !timer.paused:
        match timer.mode:
            TimerMode::Countdown => timer.elapsed = timer.elapsed + delta_time
            TimerMode::Countup => timer.elapsed = timer.elapsed + delta_time
            _ => timer.elapsed = timer.elapsed
    return timer

fn is_timer_expired(timer: QuestTimer) -> Bool:
    if timer.mode == TimerMode::Countdown:
        return timer.elapsed >= timer.duration
    return false

fn get_timer_remaining(timer: QuestTimer) -> Float:
    if timer.mode == TimerMode::Countdown:
        return max(timer.duration - timer.elapsed, 0.0)
    return timer.elapsed

// Quest Marker Management
fn create_quest_marker(location: Vec3, marker_type: QuestMarkerType, icon: String, color: Vec3) -> QuestMarker:
    let marker = QuestMarker {
        location: location,
        type: marker_type,
        icon: icon,
        color: color,
        radius: 100.0,
        show_distance: true
    }
    return marker

fn update_quest_marker_location(marker: QuestMarker, location: Vec3) -> QuestMarker:
    marker.location = location
    return marker

// Quest Progress Display
fn create_quest_progress(quest_instance: QuestInstance, quest_data: QuestData, current_time: Float) -> QuestProgress:
    let total_objectives = len(quest_instance.objectives)
    let completed_objectives = 0
    let i = 0
    while i < len(quest_instance.objectives):
        if quest_instance.objectives[i].completed:
            completed_objectives = completed_objectives + 1
        i = i + 1
    
    let progress_percentage = calculate_quest_progress(quest_instance)
    let time_elapsed = current_time - quest_instance.start_time
    let time_remaining = calculate_time_remaining(quest_instance, quest_data, current_time)
    
    let progress = QuestProgress {
        quest_id: quest_instance.quest_id,
        total_objectives: total_objectives,
        completed_objectives: completed_objectives,
        progress_percentage: progress_percentage,
        time_elapsed: time_elapsed,
        time_remaining: time_remaining
    }
    return progress

fn create_objective_progress(objective: ObjectiveInstance, objective_data: ObjectiveData) -> ObjectiveProgress:
    let progress = ObjectiveProgress {
        objective_id: objective.objective_id,
        description: objective_data.description,
        current_count: objective.current_count,
        target_count: objective.target_count,
        progress_percentage: calculate_objective_progress(objective),
        completed: objective.completed,
        optional: objective.optional,
        hidden: objective.hidden
    }
    return progress

// Quest Notification Creation
fn create_quest_notification(notification_type: QuestNotificationType, quest_id: String, quest_name: String, objective_description: String) -> QuestNotification:
    let notification = QuestNotification {
        notification_type: notification_type,
        quest_id: quest_id,
        quest_name: quest_name,
        objective_description: objective_description,
        display_duration: 5.0,
        fade_in_duration: 0.5,
        fade_out_duration: 0.5
    }
    return notification

// Quest Save Data Management
fn create_quest_save_data(active_quests: Array<QuestInstance>, completed_quests: Array<QuestInstance>, failed_quests: Array<QuestInstance>, global_variables: Array<QuestVariable>, persistent_flags: Array<String>, tracked_quest_id: String, current_time: Float) -> QuestSaveData:
    let save_data = QuestSaveData {
        active_quests: active_quests,
        completed_quests: completed_quests,
        failed_quests: failed_quests,
        global_variables: global_variables,
        persistent_flags: persistent_flags,
        tracked_quest_id: tracked_quest_id,
        save_timestamp: current_time
    }
    return save_data

// Quest Debug Info
fn create_quest_debug_info(active_count: Int, completed_count: Int, failed_count: Int, tracked_id: String, tick_rate: Float, graph_count: Int, variable_count: Int, flag_count: Int) -> QuestDebugInfo:
    let debug_info = QuestDebugInfo {
        active_quest_count: active_count,
        completed_quest_count: completed_count,
        failed_quest_count: failed_count,
        tracked_quest_id: tracked_id,
        subsystem_tick_rate: tick_rate,
        loaded_graph_count: graph_count,
        global_variable_count: variable_count,
        persistent_flag_count: flag_count
    }
    return debug_info

// ============================================================================
// ADVANCED QUEST VALIDATION
// ============================================================================

fn validate_quest_data(quest_data: QuestData) -> Bool:
    if quest_data.quest_id == "":
        println("Error: Quest ID cannot be empty")
        return false
    
    if quest_data.name == "":
        println("Error: Quest name cannot be empty")
        return false
    
    if quest_data.level_requirement < 0:
        println("Error: Level requirement cannot be negative")
        return false
    
    if quest_data.time_limit < 0.0:
        println("Error: Time limit cannot be negative")
        return false
    
    return true

fn validate_objective_data(objective_data: ObjectiveData) -> Bool:
    if objective_data.objective_id == "":
        println("Error: Objective ID cannot be empty")
        return false
    
    if objective_data.description == "":
        println("Error: Objective description cannot be empty")
        return false
    
    if objective_data.target_count <= 0:
        println("Error: Target count must be positive")
        return false
    
    if objective_data.completion_radius < 0.0:
        println("Error: Completion radius cannot be negative")
        return false
    
    return true

fn validate_quest_instance(quest_instance: QuestInstance) -> Bool:
    if quest_instance.instance_id < 0:
        println("Error: Instance ID cannot be negative")
        return false
    
    if quest_instance.quest_id == "":
        println("Error: Quest ID cannot be empty")
        return false
    
    if quest_instance.player_id == "":
        println("Error: Player ID cannot be empty")
        return false
    
    if quest_instance.start_time < 0.0:
        println("Error: Start time cannot be negative")
        return false
    
    return true

fn validate_quest_reward(reward: QuestReward) -> Bool:
    if reward.xp < 0:
        println("Error: XP reward cannot be negative")
        return false
    
    if reward.gold < 0:
        println("Error: Gold reward cannot be negative")
        return false
    
    let i = 0
    while i < len(reward.items):
        let item = reward.items[i]
        if item.quantity <= 0:
            println("Error: Item quantity must be positive")
            return false
        i = i + 1
    
    return true

// ============================================================================
// QUEST PREREQUISITE CHECKING
// ============================================================================

fn check_prerequisites(quest_data: QuestData, completed_quests: Array<String>) -> Bool:
    let i = 0
    while i < len(quest_data.prerequisites):
        let prereq_id = quest_data.prerequisites[i]
        let found = false
        let j = 0
        while j < len(completed_quests):
            if completed_quests[j] == prereq_id:
                found = true
            j = j + 1
        if !found:
            println("Prerequisite not met: {prereq_id}")
            return false
        i = i + 1
    return true

fn get_missing_prerequisites(quest_data: QuestData, completed_quests: Array<String>) -> Array<String>:
    let missing: Array<String> = []
    let i = 0
    while i < len(quest_data.prerequisites):
        let prereq_id = quest_data.prerequisites[i]
        let found = false
        let j = 0
        while j < len(completed_quests):
            if completed_quests[j] == prereq_id:
                found = true
            j = j + 1
        if !found:
            push(missing, prereq_id)
        i = i + 1
    return missing

fn has_prerequisites(quest_data: QuestData) -> Bool:
    return len(quest_data.prerequisites) > 0

fn count_prerequisites(quest_data: QuestData) -> Int:
    return len(quest_data.prerequisites)

// ============================================================================
// QUEST DIFFICULTY CALCULATION
// ============================================================================

fn calculate_quest_difficulty(quest_data: QuestData, objective_count: Int) -> Float:
    let difficulty = 0.0
    
    match quest_data.priority:
        QuestPriority::Low => difficulty = difficulty + 1.0
        QuestPriority::Normal => difficulty = difficulty + 2.0
        QuestPriority::High => difficulty = difficulty + 3.0
        QuestPriority::Critical => difficulty = difficulty + 4.0
        _ => difficulty = difficulty + 2.0
    
    difficulty = difficulty + (objective_count as Float) * 0.5
    
    if quest_data.time_limit > 0.0:
        difficulty = difficulty + 1.0
    
    difficulty = difficulty + (len(quest_data.prerequisites) as Float) * 0.3
    
    return difficulty

fn get_quest_difficulty_tier(difficulty: Float) -> String:
    if difficulty < 2.0:
        return "Easy"
    else:
        if difficulty < 4.0:
            return "Medium"
        else:
            if difficulty < 6.0:
                return "Hard"
            else:
                return "Very Hard"

// ============================================================================
// QUEST REWARD SCALING
// ============================================================================

fn scale_quest_rewards(base_reward: QuestReward, scale_factor: Float) -> QuestReward:
    let scaled = QuestReward {
        xp: (base_reward.xp as Float * scale_factor) as Int,
        gold: (base_reward.gold as Float * scale_factor) as Int,
        items: base_reward.items,
        reputation: base_reward.reputation,
        custom_rewards: base_reward.custom_rewards,
        unlock_quest_ids: base_reward.unlock_quest_ids
    }
    return scaled

fn calculate_reward_value(reward: QuestReward) -> Float:
    let value = 0.0
    value = value + (reward.xp as Float) * 0.1
    value = value + (reward.gold as Float) * 1.0
    value = value + (len(reward.items) as Float) * 10.0
    value = value + (len(reward.reputation) as Float) * 5.0
    return value

fn compare_rewards(reward1: QuestReward, reward2: QuestReward) -> Int:
    let value1 = calculate_reward_value(reward1)
    let value2 = calculate_reward_value(reward2)
    
    if value1 > value2:
        return 1
    else:
        if value1 < value2:
            return -1
        else:
            return 0

// ============================================================================
// QUEST TIME MANAGEMENT
// ============================================================================

fn calculate_time_elapsed(quest_instance: QuestInstance, current_time: Float) -> Float:
    return current_time - quest_instance.start_time

fn calculate_time_percentage(quest_instance: QuestInstance, quest_data: QuestData, current_time: Float) -> Float:
    if quest_data.time_limit <= 0.0:
        return 0.0
    
    let elapsed = calculate_time_elapsed(quest_instance, current_time)
    return (elapsed / quest_data.time_limit) * 100.0

fn is_quest_expired(quest_instance: QuestInstance, quest_data: QuestData, current_time: Float) -> Bool:
    if quest_data.time_limit <= 0.0:
        return false
    
    let elapsed = calculate_time_elapsed(quest_instance, current_time)
    return elapsed >= quest_data.time_limit

fn get_time_remaining_formatted(quest_instance: QuestInstance, quest_data: QuestData, current_time: Float) -> String:
    let remaining = calculate_time_remaining(quest_instance, quest_data, current_time)
    return format_time_remaining(remaining)

// ============================================================================
// OBJECTIVE VALIDATION AND HELPERS
// ============================================================================

fn validate_objective_instance(objective: ObjectiveInstance) -> Bool:
    if objective.objective_id == "":
        println("Error: Objective ID cannot be empty")
        return false
    
    if objective.target_count <= 0:
        println("Error: Target count must be positive")
        return false
    
    if objective.current_count < 0:
        println("Error: Current count cannot be negative")
        return false
    
    if objective.current_count > objective.target_count:
        println("Warning: Current count exceeds target count")
    
    return true

fn get_objective_status_text(objective: ObjectiveInstance) -> String:
    if objective.completed:
        return "Completed"
    else:
        if objective.failed:
            return "Failed"
        else:
            return "In Progress"

fn get_objectives_by_type(objectives: Array<ObjectiveInstance>, obj_type: ObjectiveType) -> Array<ObjectiveInstance>:
    let filtered: Array<ObjectiveInstance> = []
    return filtered

fn count_completed_objectives(objectives: Array<ObjectiveInstance>) -> Int:
    let count = 0
    let i = 0
    while i < len(objectives):
        if objectives[i].completed:
            count = count + 1
        i = i + 1
    return count

fn count_failed_objectives(objectives: Array<ObjectiveInstance>) -> Int:
    let count = 0
    let i = 0
    while i < len(objectives):
        if objectives[i].failed:
            count = count + 1
        i = i + 1
    return count

fn count_optional_objectives(objectives: Array<ObjectiveInstance>) -> Int:
    let count = 0
    let i = 0
    while i < len(objectives):
        if objectives[i].optional:
            count = count + 1
        i = i + 1
    return count

fn count_required_objectives(objectives: Array<ObjectiveInstance>) -> Int:
    let count = 0
    let i = 0
    while i < len(objectives):
        if !objectives[i].optional:
            count = count + 1
        i = i + 1
    return count

fn get_next_incomplete_objective(objectives: Array<ObjectiveInstance>) -> ObjectiveInstance:
    let i = 0
    while i < len(objectives):
        let objective = objectives[i]
        if !objective.completed && !objective.failed:
            return objective
        i = i + 1
    
    let empty = create_objective_instance("", 0, false, false)
    return empty

// ============================================================================
// QUEST SEARCH AND FILTERING
// ============================================================================

fn find_quest_by_id(quests: Array<QuestInstance>, quest_id: String) -> QuestInstance:
    let i = 0
    while i < len(quests):
        if quests[i].quest_id == quest_id:
            return quests[i]
        i = i + 1
    
    let empty = create_quest_instance("", "", 0)
    return empty

fn find_objective_by_id(objectives: Array<ObjectiveInstance>, objective_id: String) -> ObjectiveInstance:
    let i = 0
    while i < len(objectives):
        if objectives[i].objective_id == objective_id:
            return objectives[i]
        i = i + 1
    
    let empty = create_objective_instance("", 0, false, false)
    return empty

fn filter_quests_by_priority(quests: Array<QuestLogEntry>, priority: QuestPriority) -> Array<QuestLogEntry>:
    let filtered: Array<QuestLogEntry> = []
    let i = 0
    while i < len(quests):
        let entry = quests[i]
        if entry.quest_data.priority == priority:
            push(filtered, entry)
        i = i + 1
    return filtered

fn filter_quests_by_level(quests: Array<QuestLogEntry>, min_level: Int, max_level: Int) -> Array<QuestLogEntry>:
    let filtered: Array<QuestLogEntry> = []
    let i = 0
    while i < len(quests):
        let entry = quests[i]
        if entry.quest_data.level_requirement >= min_level && entry.quest_data.level_requirement <= max_level:
            push(filtered, entry)
        i = i + 1
    return filtered

fn filter_tracked_quests(quests: Array<QuestLogEntry>) -> Array<QuestLogEntry>:
    let filtered: Array<QuestLogEntry> = []
    let i = 0
    while i < len(quests):
        let entry = quests[i]
        if entry.is_tracked:
            push(filtered, entry)
        i = i + 1
    return filtered

fn filter_new_quests(quests: Array<QuestLogEntry>) -> Array<QuestLogEntry>:
    let filtered: Array<QuestLogEntry> = []
    let i = 0
    while i < len(quests):
        let entry = quests[i]
        if entry.is_new:
            push(filtered, entry)
        i = i + 1
    return filtered

// ============================================================================
// QUEST STATISTICS
// ============================================================================

fn calculate_quest_completion_rate(completed_count: Int, total_count: Int) -> Float:
    if total_count == 0:
        return 0.0
    return (completed_count as Float) / (total_count as Float) * 100.0

fn calculate_quest_failure_rate(failed_count: Int, total_count: Int) -> Float:
    if total_count == 0:
        return 0.0
    return (failed_count as Float) / (total_count as Float) * 100.0

fn calculate_average_quest_time(quests: Array<QuestInstance>) -> Float:
    if len(quests) == 0:
        return 0.0
    
    let total_time = 0.0
    let i = 0
    while i < len(quests):
        let quest = quests[i]
        if quest.completion_time > 0.0:
            total_time = total_time + (quest.completion_time - quest.start_time)
        i = i + 1
    
    return total_time / (len(quests) as Float)

fn get_longest_quest(quests: Array<QuestInstance>) -> QuestInstance:
    if len(quests) == 0:
        return create_quest_instance("", "", 0)
    
    let longest = quests[0]
    let longest_time = 0.0
    
    let i = 0
    while i < len(quests):
        let quest = quests[i]
        if quest.completion_time > 0.0:
            let duration = quest.completion_time - quest.start_time
            if duration > longest_time:
                longest_time = duration
                longest = quest
        i = i + 1
    
    return longest

fn get_shortest_quest(quests: Array<QuestInstance>) -> QuestInstance:
    if len(quests) == 0:
        return create_quest_instance("", "", 0)
    
    let shortest = quests[0]
    let shortest_time = 999999.0
    
    let i = 0
    while i < len(quests):
        let quest = quests[i]
        if quest.completion_time > 0.0:
            let duration = quest.completion_time - quest.start_time
            if duration < shortest_time:
                shortest_time = duration
                shortest = quest
        i = i + 1
    
    return shortest

