fn find_variable_by_name(variables: Array<QuestVariable>, name: String) -> QuestVariable:
    let i = 0
    while i < len(variables):
        if variables[i].variable_name == name:
            return variables[i]
        i = i + 1
    
    return create_quest_variable("", "Unknown", false)

fn filter_persistent_variables(variables: Array<QuestVariable>) -> Array<QuestVariable>:
    let filtered: Array<QuestVariable> = []
    let i = 0
    while i < len(variables):
        if variables[i].is_persistent:
            push(filtered, variables[i])
        i = i + 1
    return filtered

fn count_variables_by_type(variables: Array<QuestVariable>, var_type: String) -> Int:
    let count = 0
    let i = 0
    while i < len(variables):
        if variables[i].variable_type == var_type:
            count = count + 1
        i = i + 1
    return count

