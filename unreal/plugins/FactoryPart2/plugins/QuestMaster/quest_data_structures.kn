// QuestMaster — Data Structures and Enums
// Phase 1: Core data types, enums, structs, DataTables, and helper functions

// ============================================================================
// ENUMS (12+)
// ============================================================================

enum QuestState:
    Inactive
    Active
    Completed
    Failed
    Abandoned

enum QuestPriority:
    Low
    Normal
    High
    Critical

enum QuestCategory:
    Main
    Side
    Daily
    Repeatable
    Hidden
    Tutorial
    World
    Faction

enum ObjectiveType:
    Kill
    Collect
    Interact
    Reach
    Escort
    Defend
    Discover
    Craft
    Use
    Talk
    Custom

enum ConditionType:
    QuestComplete
    QuestActive
    QuestFailed
    ItemInInventory
    StatValue
    FlagSet
    TimeOfDay
    Location
    Level
    Reputation
    Custom
    HasItem
    KillCount
    Distance
    Timer

enum RewardType:
    XP
    Gold
    Item
    Reputation
    Unlock
    Custom
    Skill
    Achievement

enum QuestNotificationType:
    Started
    Completed
    Failed
    ObjectiveCompleted
    ObjectiveFailed
    Updated
    Abandoned

enum QuestFilterMode:
    All
    Active
    Completed
    Failed
    Available
    Tracked

enum QuestSortMode:
    Name
    Priority
    Progress
    Level
    Category
    TimeStarted
    TimeRemaining

enum QuestMarkerType:
    Objective
    QuestGiver
    TurnIn
    Area
    Waypoint
    Optional

enum TimerMode:
    Countdown
    Countup
    None

enum ParallelMode:
    WaitForAll
    WaitForAny
    WaitForCount

enum ComparisonOperator:
    Equal
    NotEqual
    GreaterThan
    LessThan
    GreaterOrEqual
    LessOrEqual

// ============================================================================
// CORE STRUCTS (35+)
// ============================================================================

struct QuestData:
    quest_id: String
    name: String
    description: String
    category: QuestCategory
    priority: QuestPriority
    level_requirement: Int
    prerequisites: Array<String>
    auto_start: Bool
    repeatable: Bool
    time_limit: Float
    lore_text: String
    icon_path: String

struct ObjectiveData:
    objective_id: String
    description: String
    type: ObjectiveType
    target_count: Int
    optional: Bool
    hidden: Bool
    target_actor_class: String
    target_item_id: String
    target_location: Vec3
    completion_radius: Float

struct QuestReward:
    xp: Int
    gold: Int
    items: Array<ItemReward>
    reputation: Array<ReputationReward>
    custom_rewards: Array<CustomReward>
    unlock_quest_ids: Array<String>

struct ItemReward:
    item_id: String
    quantity: Int
    quality: Int
    level: Int

struct ReputationReward:
    faction_id: String
    amount: Int

struct CustomReward:
    reward_id: String
    reward_data: String
    reward_value: Float

struct QuestCondition:
    condition_type: ConditionType
    target: String
    comparison_operator: ComparisonOperator
    comparison_value: Float
    invert: Bool
    custom_data: String

struct QuestInstance:
    instance_id: Int
    quest_id: String
    state: QuestState
    objectives: Array<ObjectiveInstance>
    variables: Array<QuestVariable>
    start_time: Float
    completion_time: Float
    tracked: Bool
    player_id: String
    current_node_id: String
    visited_nodes: Array<String>

struct ObjectiveInstance:
    objective_id: String
    current_count: Int
    target_count: Int
    completed: Bool
    failed: Bool
    start_time: Float
    completion_time: Float
    hidden: Bool
    optional: Bool

struct QuestVariable:
    variable_name: String
    variable_type: String
    int_value: Int
    float_value: Float
    string_value: String
    bool_value: Bool
    is_persistent: Bool

struct QuestPrerequisite:
