@blueprint
fn refresh_available_quests():
    println("Refreshing available quests")

@blueprint
fn has_quests_available() -> Bool:
    return len(available_quests) > 0

@blueprint
fn can_turn_in_quest(quest_id: String) -> Bool:
    let i = 0
    while i < len(completed_quests):
        if completed_quests[i] == quest_id:
            return true
        i = i + 1
    return false

