// QuestMaster — Quest Actors
// Phase 5: Actors with networking and replication

// ============================================================================
// QUEST MANAGER ACTOR
// ============================================================================

actor QuestManagerActor:
    @replicated
    state active_quest_count: Int = 0
    
    @replicated
    state tracked_quest_id: String = ""
    
    state quest_subsystem_ref: String = ""
    
    // ========================================================================
    // RPC: START QUEST
    // ========================================================================
    
    on Server_StartQuest(quest_id: String, player_id: String):
        println("Server: Starting quest {quest_id} for player {player_id}")
        active_quest_count = active_quest_count + 1
        Multicast_QuestStateChanged(quest_id, "Active")
    
    on Server_CompleteQuest(quest_id: String):
        println("Server: Completing quest {quest_id}")
        active_quest_count = active_quest_count - 1
        Multicast_QuestStateChanged(quest_id, "Completed")
    
    on Server_FailQuest(quest_id: String, reason: String):
        println("Server: Failing quest {quest_id} - {reason}")
        active_quest_count = active_quest_count - 1
        Multicast_QuestStateChanged(quest_id, "Failed")
    
    on Server_AbandonQuest(quest_id: String):
        println("Server: Abandoning quest {quest_id}")
        active_quest_count = active_quest_count - 1
        Multicast_QuestStateChanged(quest_id, "Abandoned")
    
    on Server_UpdateObjective(quest_id: String, objective_id: String, count: Int):
        println("Server: Updating objective {objective_id} to {count}")
        Multicast_ObjectiveUpdated(quest_id, objective_id, count)
    
    // ========================================================================
    // MULTICAST RPCS
    // ========================================================================
    
    on Multicast_QuestStateChanged(quest_id: String, new_state: String):
        println("Multicast: Quest {quest_id} state changed to {new_state}")
    
    on Multicast_ObjectiveUpdated(quest_id: String, objective_id: String, count: Int):
        println("Multicast: Objective {objective_id} updated to {count}")
    
    // ========================================================================
    // BLUEPRINT FUNCTIONS
    // ========================================================================
    
    @blueprint
    fn get_active_quest_count() -> Int:
        return active_quest_count
    
    @blueprint
    fn get_tracked_quest_id() -> String:
        return tracked_quest_id
    
    @blueprint
    fn set_tracked_quest(quest_id: String):
        tracked_quest_id = quest_id
        println("Tracking quest: {quest_id}")
    
    @blueprint
    fn start_quest_on_server(quest_id: String, player_id: String):
        Server_StartQuest(quest_id, player_id)
    
    @blueprint
    fn complete_quest_on_server(quest_id: String):
        Server_CompleteQuest(quest_id)
    
    @blueprint
    fn fail_quest_on_server(quest_id: String, reason: String):
        Server_FailQuest(quest_id, reason)
    
    @blueprint
    fn abandon_quest_on_server(quest_id: String):
        Server_AbandonQuest(quest_id)
    
    @blueprint
    fn update_objective_on_server(quest_id: String, objective_id: String, count: Int):
        Server_UpdateObjective(quest_id, objective_id, count)

// ============================================================================
// QUEST GIVER ACTOR
// ============================================================================

actor QuestGiverActor:
    state available_quests: Array<String> = []
    state completed_quests: Array<String> = []
    state repeatable: Bool = false
    state interaction_text: String = "Talk"
    state quest_giver_name: String = "Quest Giver"
    state greeting_text: String = "Hello, traveler!"
    state farewell_text: String = "Good luck!"
    
    // ========================================================================
    // RPC: ACCEPT QUEST
    // ========================================================================
    
    on Server_AcceptQuest(quest_id: String, player_id: String):
        println("Server: Player {player_id} accepted quest {quest_id}")
        
        let found = false
        let i = 0
        while i < len(available_quests):
            if available_quests[i] == quest_id:
                found = true
            i = i + 1
        
        if found:
            println("Quest {quest_id} is available, starting...")
        else:
            println("Quest {quest_id} is not available")
    
    on Server_TurnInQuest(quest_id: String, player_id: String):
        println("Server: Player {player_id} turned in quest {quest_id}")
        push(completed_quests, quest_id)
    
    // ========================================================================
    // INTERACTION LOGIC
    // ========================================================================
    
    @blueprint
    fn interact_with_player(player_id: String):
        println("{quest_giver_name}: {greeting_text}")
        show_available_quests()
    
    @blueprint
    fn show_available_quests():
        println("Available quests:")
        let i = 0
        while i < len(available_quests):
            println("  - {available_quests[i]}")
            i = i + 1
    
    @blueprint
    fn add_available_quest(quest_id: String):
        push(available_quests, quest_id)
        println("Added available quest: {quest_id}")
    
    @blueprint
    fn remove_available_quest(quest_id: String):
        println("Removed available quest: {quest_id}")
    
    @blueprint
    fn is_quest_available(quest_id: String) -> Bool:
        let i = 0
        while i < len(available_quests):
            if available_quests[i] == quest_id:
                return true
            i = i + 1
        return false
    
    @blueprint
    fn is_quest_completed(quest_id: String) -> Bool:
        let i = 0
        while i < len(completed_quests):
            if completed_quests[i] == quest_id:
                return true
            i = i + 1
        return false
    
    @blueprint
    fn accept_quest_from_player(quest_id: String, player_id: String):
        Server_AcceptQuest(quest_id, player_id)
    
    @blueprint
    fn turn_in_quest_from_player(quest_id: String, player_id: String):
        Server_TurnInQuest(quest_id, player_id)
    
    @blueprint
    fn get_available_quest_count() -> Int:
        return len(available_quests)
    
    @blueprint
    fn get_completed_quest_count() -> Int:
        return len(completed_quests)

// ============================================================================
// QUEST OBJECTIVE ACTOR
// ============================================================================

actor QuestObjectiveActor:
    @replicated
    state quest_id: String = ""
    
    @replicated
    state objective_id: String = ""
    
    @replicated
    state target_count: Int = 1
    
    @replicated
    state current_count: Int = 0
    
    state auto_complete: Bool = true
    state objective_type: ObjectiveType = ObjectiveType::Interact
    state completion_radius: Float = 100.0
    state show_marker: Bool = true
    state marker_icon: String = "Objective"
    
    // ========================================================================
    // RPC: UPDATE OBJECTIVE
    // ========================================================================
    
    on Server_UpdateObjective(player_id: String, count: Int):
        println("Server: Updating objective {objective_id} for player {player_id}")
        current_count = count
        
        if current_count >= target_count && auto_complete:
            println("Objective {objective_id} completed!")
            Multicast_ObjectiveCompleted(objective_id)
    
    on Multicast_ObjectiveCompleted(obj_id: String):
        println("Multicast: Objective {obj_id} completed")
    
    // ========================================================================
    // OVERLAP/INTERACTION TRIGGERS
    // ========================================================================
    
    @blueprint
    fn on_player_overlap(player_id: String):
        println("Player {player_id} overlapped objective {objective_id}")
        
        match objective_type:
            ObjectiveType::Reach => increment_objective_count(player_id)
            ObjectiveType::Discover => increment_objective_count(player_id)
            _ => println("Overlap not handled for this objective type")
    
    @blueprint
    fn on_player_interact(player_id: String):
        println("Player {player_id} interacted with objective {objective_id}")
        
        match objective_type:
            ObjectiveType::Interact => increment_objective_count(player_id)
            ObjectiveType::Collect => increment_objective_count(player_id)
            _ => println("Interaction not handled for this objective type")
    
    @blueprint
    fn increment_objective_count(player_id: String):
        let new_count = current_count + 1
        Server_UpdateObjective(player_id, new_count)
    
    @blueprint
    fn set_objective_count(player_id: String, count: Int):
        Server_UpdateObjective(player_id, count)
    
    @blueprint
    fn reset_objective():
        current_count = 0
        println("Reset objective {objective_id}")
    
    @blueprint
    fn get_objective_progress() -> Float:
        if target_count == 0:
            return 0.0
        return (current_count as Float) / (target_count as Float) * 100.0
    
    @blueprint
    fn is_objective_complete() -> Bool:
        return current_count >= target_count
    
    @blueprint
    fn get_current_count() -> Int:
        return current_count
    
    @blueprint
    fn get_target_count() -> Int:
        return target_count
    
    @blueprint
    fn set_target_count(count: Int):
        target_count = count
        println("Set target count to {count}")

// ============================================================================
// QUEST TRIGGER ACTOR
// ============================================================================

actor QuestTriggerActor:
    state trigger_type: String = "Overlap"
    state quest_id: String = ""
    state event_name: String = ""
    state one_time: Bool = true
    state triggered: Bool = false
    state trigger_delay: Float = 0.0
    state require_quest_active: Bool = false
    state trigger_radius: Float = 200.0
    
    // ========================================================================
    // RPC: TRIGGER EVENT
    // ========================================================================
    
    on Server_TriggerEvent(player_id: String, event_data: String):
        if one_time && triggered:
            println("Trigger already activated")
            return
        
        println("Server: Triggering event {event_name} for player {player_id}")
        triggered = true
        Multicast_EventTriggered(event_name, event_data)
    
    on Multicast_EventTriggered(event: String, data: String):
        println("Multicast: Event {event} triggered with data: {data}")
    
    // ========================================================================
    // OVERLAP/INTERACTION/TIMER LOGIC
    // ========================================================================
    
    @blueprint
    fn on_player_overlap(player_id: String):
        if trigger_type == "Overlap":
            trigger_event_for_player(player_id)
    
    @blueprint
    fn on_player_interact(player_id: String):
        if trigger_type == "Interact":
            trigger_event_for_player(player_id)
    
    @blueprint
    fn on_timer_expired():
        if trigger_type == "Timer":
            trigger_event_for_player("system")
    
    @blueprint
    fn trigger_event_for_player(player_id: String):
        if one_time && triggered:
            return
        
        if require_quest_active:
            println("Checking if quest {quest_id} is active...")
        
        Server_TriggerEvent(player_id, "")
    
    @blueprint
    fn reset_trigger():
        triggered = false
        println("Reset trigger")
    
    @blueprint
    fn is_triggered() -> Bool:
        return triggered
    
    @blueprint
    fn set_trigger_type(trig_type: String):
        trigger_type = trig_type
        println("Set trigger type to {trig_type}")
    
    @blueprint
    fn set_event_name(event: String):
        event_name = event
        println("Set event name to {event}")
    
    @blueprint
    fn set_quest_id(q_id: String):
        quest_id = q_id
        println("Set quest ID to {q_id}")
    
    @blueprint
    fn enable_one_time(enabled: Bool):
        one_time = enabled
        println("One-time trigger: {enabled}")
    
    @blueprint
    fn get_trigger_type() -> String:
        return trigger_type
    
    @blueprint
    fn get_event_name() -> String:
        return event_name
    
    @blueprint
    fn get_quest_id() -> String:
        return quest_id
    
    // ========================================================================
    // ADDITIONAL QUEST MANAGER FUNCTIONS
    // ========================================================================
    
    @blueprint
    fn initialize_quest_manager():
        println("Initializing Quest Manager Actor")
        active_quest_count = 0
        tracked_quest_id = ""
    
    @blueprint
    fn shutdown_quest_manager():
        println("Shutting down Quest Manager Actor")
    
    @blueprint
    fn sync_with_subsystem():
        println("Syncing Quest Manager with Subsystem")
    
    @blueprint
    fn broadcast_quest_update(quest_id: String):
        Multicast_QuestStateChanged(quest_id, "Updated")
    
    @blueprint
    fn get_quest_manager_status() -> String:
        return "Active: {active_quest_count} quests"
    
    @blueprint
    fn is_quest_manager_ready() -> Bool:
        return true
    
    @blueprint
    fn reset_quest_manager():
        active_quest_count = 0
        tracked_quest_id = ""
        println("Reset Quest Manager")

