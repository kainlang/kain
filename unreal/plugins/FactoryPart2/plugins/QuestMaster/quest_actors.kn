// ============================================================================
// QUEST BOARD ACTOR
// ============================================================================

actor QuestBoardActor:
    state available_quests: Array<String> = []
    state featured_quests: Array<String> = []
    state daily_quests: Array<String> = []
    state weekly_quests: Array<String> = []
    state board_name: String = "Quest Board"
    state board_level_requirement: Int = 1
    state refresh_interval: Float = 86400.0
    state last_refresh_time: Float = 0.0
    
    @blueprint
    fn interact_with_board(player_id: String):
        println("Player {player_id} interacting with quest board")
        show_available_quests_ui()
    
    @blueprint
    fn show_available_quests_ui():
        println("Showing quest board UI")
        println("Available quests: {len(available_quests)}")
        println("Featured quests: {len(featured_quests)}")
        println("Daily quests: {len(daily_quests)}")
        println("Weekly quests: {len(weekly_quests)}")
    
    @blueprint
    fn add_quest_to_board(quest_id: String):
        push(available_quests, quest_id)
        println("Added quest to board: {quest_id}")
    
    @blueprint
    fn remove_quest_from_board(quest_id: String):
        println("Removed quest from board: {quest_id}")
    
    @blueprint
    fn set_featured_quest(quest_id: String):
        push(featured_quests, quest_id)
        println("Set featured quest: {quest_id}")
    
    @blueprint
    fn refresh_daily_quests():
        daily_quests = []
        println("Refreshed daily quests")
    
    @blueprint
    fn refresh_weekly_quests():
        weekly_quests = []
        println("Refreshed weekly quests")
    
    @blueprint
    fn auto_refresh_check(current_time: Float):
        if current_time - last_refresh_time >= refresh_interval:
            refresh_daily_quests()
            last_refresh_time = current_time
    
    @blueprint
    fn get_quest_count() -> Int:
        return len(available_quests)
    
    @blueprint
    fn get_featured_quest_count() -> Int:
        return len(featured_quests)
    
    @blueprint
    fn get_daily_quest_count() -> Int:
        return len(daily_quests)
    
    @blueprint
    fn get_weekly_quest_count() -> Int:
        return len(weekly_quests)
    
    @blueprint
    fn is_quest_on_board(quest_id: String) -> Bool:
        let i = 0
        while i < len(available_quests):
            if available_quests[i] == quest_id:
                return true
            i = i + 1
        return false
    
    @blueprint
    fn clear_all_quests():
        available_quests = []
        featured_quests = []
        daily_quests = []
        weekly_quests = []
        println("Cleared all quests from board")
    
    @blueprint
    fn set_board_level_requirement(level: Int):
        board_level_requirement = level
        println("Set board level requirement: {level}")
    
    @blueprint
    fn can_player_access_board(player_level: Int) -> Bool:
        return player_level >= board_level_requirement

// ============================================================================
// QUEST VENDOR ACTOR
// ============================================================================

actor QuestVendorActor:
    state vendor_name: String = "Quest Vendor"
    state quest_items: Array<String> = []
    state quest_rewards: Array<String> = []
    state vendor_reputation_required: Int = 0
    state vendor_faction: String = ""
    
    @blueprint
    fn interact_with_vendor(player_id: String):
        println("Player {player_id} interacting with quest vendor")
        show_vendor_ui()
    
    @blueprint
    fn show_vendor_ui():
        println("Showing vendor UI")
        println("Quest items: {len(quest_items)}")
        println("Quest rewards: {len(quest_rewards)}")
    
    @blueprint
    fn purchase_quest_item(player_id: String, item_id: String) -> Bool:
        println("Player {player_id} purchasing quest item: {item_id}")
        return true
    
    @blueprint
    fn sell_quest_item(player_id: String, item_id: String) -> Bool:
        println("Player {player_id} selling quest item: {item_id}")
        return true
    
    @blueprint
    fn exchange_quest_reward(player_id: String, reward_id: String) -> Bool:
        println("Player {player_id} exchanging quest reward: {reward_id}")
        return true
    
    @blueprint
    fn add_quest_item(item_id: String):
        push(quest_items, item_id)
        println("Added quest item: {item_id}")
    
    @blueprint
    fn add_quest_reward(reward_id: String):
        push(quest_rewards, reward_id)
        println("Added quest reward: {reward_id}")
    
    @blueprint
    fn has_quest_item(item_id: String) -> Bool:
        let i = 0
        while i < len(quest_items):
            if quest_items[i] == item_id:
                return true
            i = i + 1
        return false
    
    @blueprint
    fn has_quest_reward(reward_id: String) -> Bool:
        let i = 0
        while i < len(quest_rewards):
            if quest_rewards[i] == reward_id:
                return true
            i = i + 1
        return false
    
    @blueprint
    fn set_reputation_requirement(amount: Int):
        vendor_reputation_required = amount
        println("Set reputation requirement: {amount}")
    
    @blueprint
    fn can_player_access_vendor(player_reputation: Int) -> Bool:
        return player_reputation >= vendor_reputation_required

// ============================================================================
// QUEST COMPANION ACTOR
// ============================================================================

actor QuestCompanionActor:
    state companion_name: String = "Quest Companion"
    state companion_type: String = "Helper"
    state assigned_quest_id: String = ""
    state follow_player: Bool = true
    state provide_hints: Bool = true
    state companion_dialogue: Array<String> = []
    
    @blueprint
    fn assign_to_quest(quest_id: String):
        assigned_quest_id = quest_id
        println("Companion assigned to quest: {quest_id}")
    
    @blueprint
    fn unassign_from_quest():
        assigned_quest_id = ""
        println("Companion unassigned from quest")
    
    @blueprint
    fn provide_quest_hint(objective_id: String):
        if provide_hints:
            println("Companion hint: Check the objective marker")
    
    @blueprint
    fn speak_dialogue(dialogue_index: Int):
        if dialogue_index >= 0 && dialogue_index < len(companion_dialogue):
            println("Companion: {companion_dialogue[dialogue_index]}")
    
    @blueprint
    fn add_dialogue_line(dialogue: String):
        push(companion_dialogue, dialogue)
    
    @blueprint
    fn enable_following(enabled: Bool):
        follow_player = enabled
        println("Companion following: {enabled}")
    
    @blueprint
    fn enable_hints(enabled: Bool):
        provide_hints = enabled
        println("Companion hints: {enabled}")
    
    @blueprint
    fn get_assigned_quest() -> String:
        return assigned_quest_id
    
    @blueprint
    fn is_assigned_to_quest() -> Bool:
        return assigned_quest_id != ""
    
    @blueprint
    fn dismiss_companion():
        println("Companion dismissed")

// ============================================================================
// QUEST PORTAL ACTOR
// ============================================================================

actor QuestPortalActor:
    state portal_name: String = "Quest Portal"
    state destination_quest_id: String = ""
    state destination_location: Vec3 = vec3(0.0, 0.0, 0.0)
    state portal_active: Bool = true
    state requires_quest_complete: Bool = false
    state required_quest_id: String = ""
    
    on Server_ActivatePortal(player_id: String):
        if portal_active:
            println("Server: Activating portal for player {player_id}")
            Multicast_PortalActivated(player_id)
    
    on Multicast_PortalActivated(player_id: String):
        println("Multicast: Portal activated for {player_id}")
    
    @blueprint
    fn interact_with_portal(player_id: String):
        if can_use_portal(player_id):
            Server_ActivatePortal(player_id)
        else:
            println("Cannot use portal: requirements not met")
    
    @blueprint
    fn can_use_portal(player_id: String) -> Bool:
        if !portal_active:
            return false
        
        if requires_quest_complete:
            return false
        
        return true
    
    @blueprint
    fn set_destination_quest(quest_id: String):
        destination_quest_id = quest_id
        println("Set destination quest: {quest_id}")
    
    @blueprint
    fn set_destination_location(location: Vec3):
        destination_location = location
        println("Set destination location: {location}")
    
    @blueprint
    fn activate_portal():
        portal_active = true
        println("Portal activated")
    
    @blueprint
    fn deactivate_portal():
        portal_active = false
        println("Portal deactivated")
    
    @blueprint
    fn set_quest_requirement(quest_id: String):
        required_quest_id = quest_id
        requires_quest_complete = true
        println("Set quest requirement: {quest_id}")
    
    @blueprint
    fn clear_quest_requirement():
        required_quest_id = ""
        requires_quest_complete = false
        println("Cleared quest requirement")
    
    @blueprint
    fn is_portal_active() -> Bool:
        return portal_active
    
    @blueprint
    fn get_destination_quest() -> String:
        return destination_quest_id

// ============================================================================
// QUEST CHECKPOINT ACTOR
// ============================================================================

actor QuestCheckpointActor:
    state checkpoint_name: String = "Checkpoint"
    state checkpoint_quest_id: String = ""
    state checkpoint_objective_id: String = ""
    state auto_save_on_reach: Bool = true
    state respawn_point: Bool = false
    state checkpoint_reached: Bool = false
    
    on Server_ReachCheckpoint(player_id: String):
        println("Server: Player {player_id} reached checkpoint")
        checkpoint_reached = true
        Multicast_CheckpointReached(player_id)
    
    on Multicast_CheckpointReached(player_id: String):
        println("Multicast: Checkpoint reached by {player_id}")
    
    @blueprint
    fn on_player_reach_checkpoint(player_id: String):
        if !checkpoint_reached:
            Server_ReachCheckpoint(player_id)
            
            if auto_save_on_reach:
                save_player_progress(player_id)
    
    @blueprint
    fn save_player_progress(player_id: String):
        println("Saving player progress at checkpoint")
    
    @blueprint
    fn set_as_respawn_point():
        respawn_point = true
        println("Set as respawn point")
    
    @blueprint
    fn reset_checkpoint():
        checkpoint_reached = false
        println("Reset checkpoint")
    
    @blueprint
    fn is_checkpoint_reached() -> Bool:
        return checkpoint_reached
    
    @blueprint
    fn is_respawn_point() -> Bool:
        return respawn_point
    
    @blueprint
    fn get_checkpoint_quest() -> String:
        return checkpoint_quest_id
    
    @blueprint
    fn get_checkpoint_objective() -> String:
        return checkpoint_objective_id
