material ProceduralNoise:
    input noise_scale: Float = 1.0
    input octaves: Int = 4
    input persistence: Float = 0.5
    input lacunarity: Float = 2.0
    input seed: Int = 0
    input color_a: Vec3 = vec3(0.0, 0.0, 0.0)
    input color_b: Vec3 = vec3(1.0, 1.0, 1.0)
    
    let uv_scaled = uv * noise_scale
    let noise_value = perlin_noise(vec3(uv_scaled.x + seed, uv_scaled.y + seed, seed))
    
    let final_noise = noise_value
    let amplitude = 1.0
    let frequency = 1.0
    let i = 1
    while i < octaves:
        frequency = frequency * lacunarity
        amplitude = amplitude * persistence
        let octave_noise = perlin_noise(vec3(uv_scaled.x * frequency + seed, uv_scaled.y * frequency + seed, seed + i))
        final_noise = final_noise + octave_noise * amplitude
        i = i + 1
    
    final_noise = (final_noise + 1.0) * 0.5
    final_noise = clamp(final_noise, 0.0, 1.0)
    
    base_color = lerp(color_a, color_b, final_noise)

material ProceduralGradient:
    input gradient_type: Int = 0
    input angle: Float = 0.0
    input color_a: Vec3 = vec3(0.0, 0.0, 0.0)
    input color_b: Vec3 = vec3(1.0, 1.0, 1.0)
    input repeat_count: Float = 1.0
    
    let angle_rad = angle * 3.14159 / 180.0
    let cos_angle = cos(angle_rad)
    let sin_angle = sin(angle_rad)
    
    let rotated_uv = vec2(
        uv.x * cos_angle - uv.y * sin_angle,
        uv.x * sin_angle + uv.y * cos_angle
    )
    
    let gradient_value = 0.0
    if gradient_type == 0:
        gradient_value = rotated_uv.x
    
    if gradient_type == 1:
        let center = vec2(0.5, 0.5)
        let dist = distance(uv, center)
        gradient_value = dist * 2.0
    
    if gradient_type == 2:
        let center = vec2(0.5, 0.5)
        let angle_to_center = atan2(uv.y - center.y, uv.x - center.x)
        gradient_value = (angle_to_center + 3.14159) / (2.0 * 3.14159)
    
    gradient_value = frac(gradient_value * repeat_count)
    gradient_value = clamp(gradient_value, 0.0, 1.0)
    
    base_color = lerp(color_a, color_b, gradient_value)

material ProceduralCheckerboard:
    input tile_count: Float = 8.0
    input color_a: Vec3 = vec3(0.0, 0.0, 0.0)
    input color_b: Vec3 = vec3(1.0, 1.0, 1.0)
    input mortar_width: Float = 0.05
    input mortar_color: Vec3 = vec3(0.5, 0.5, 0.5)
    
    let scaled_uv = uv * tile_count
    let tile_x = floor(scaled_uv.x)
    let tile_y = floor(scaled_uv.y)
    
    let frac_x = frac(scaled_uv.x)
    let frac_y = frac(scaled_uv.y)
    
    let is_mortar = frac_x < mortar_width or frac_x > 1.0 - mortar_width or frac_y < mortar_width or frac_y > 1.0 - mortar_width
    
    let checker = (tile_x + tile_y) % 2.0
    let tile_color = lerp(color_a, color_b, checker)
    
    base_color = is_mortar * mortar_color + (1.0 - is_mortar) * tile_color

material ProceduralBrick:
    input brick_width: Float = 0.3
    input brick_height: Float = 0.15
    input mortar_width: Float = 0.02
    input brick_color: Vec3 = vec3(0.7, 0.3, 0.2)
    input mortar_color: Vec3 = vec3(0.5, 0.5, 0.5)
    input brick_variation: Float = 0.1
    
    let row = floor(uv.y / brick_height)
    let offset = (row % 2.0) * 0.5
    let col = floor((uv.x + offset) / brick_width)
    
    let brick_uv_x = frac((uv.x + offset) / brick_width)
    let brick_uv_y = frac(uv.y / brick_height)
    
    let is_mortar = brick_uv_x < mortar_width / brick_width or brick_uv_x > 1.0 - mortar_width / brick_width or brick_uv_y < mortar_width / brick_height or brick_uv_y > 1.0 - mortar_width / brick_height
    
    let brick_id = row * 1000.0 + col
    let brick_noise = frac(sin(brick_id * 12.9898) * 43758.5453)
    let varied_brick_color = brick_color + vec3(brick_noise, brick_noise, brick_noise) * brick_variation - vec3(brick_variation * 0.5, brick_variation * 0.5, brick_variation * 0.5)
    
    base_color = is_mortar * mortar_color + (1.0 - is_mortar) * varied_brick_color

material LayerBlender:
    input base_texture: Texture2D
    input layer_texture: Texture2D
    input blend_mode: Int = 0
    input opacity: Float = 1.0
    input mask_texture: Texture2D
    
    let base = texture_sample(base_texture).rgb
    let layer = texture_sample(layer_texture).rgb
    let mask = texture_sample(mask_texture).r
    
    let blended = base
    
    if blend_mode == 0:
        blended = layer
    
    if blend_mode == 1:
        blended = base * layer
    
    if blend_mode == 2:
        let overlay_component = 0.0
        if base.r < 0.5:
            overlay_component = 2.0 * base.r * layer.r
        if base.r >= 0.5:
            overlay_component = 1.0 - 2.0 * (1.0 - base.r) * (1.0 - layer.r)
        blended = vec3(overlay_component, overlay_component, overlay_component)
    
    if blend_mode == 3:
        blended = base + layer - base * layer
    
    if blend_mode == 4:
        blended = base + layer
    
    if blend_mode == 5:
        blended = base - layer
    
    if blend_mode == 6:
        blended = base / (layer + 0.001)
    
    if blend_mode == 7:
        blended = min(base, layer)
    
    if blend_mode == 8:
        blended = max(base, layer)
    
    let final_blend = lerp(base, blended, opacity * mask)
    base_color = clamp(final_blend, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))

material NormalMapGenerator:
    input height_map: Texture2D
    input strength: Float = 1.0
    input resolution: Float = 1024.0
    
    let texel_size = 1.0 / resolution
    
    let height_center = texture_sample(height_map).r
    let height_right = texture_sample(height_map, uv + vec2(texel_size, 0.0)).r
    let height_up = texture_sample(height_map, uv + vec2(0.0, texel_size)).r
    
    let dx = (height_right - height_center) * strength
    let dy = (height_up - height_center) * strength
    
    let normal = normalize(vec3(-dx, -dy, 1.0))
    let packed_normal = normal * 0.5 + vec3(0.5, 0.5, 0.5)
    
    base_color = packed_normal

material AmbientOcclusionGenerator:
    input height_map: Texture2D
    input sample_radius: Float = 0.05
    input sample_count: Int = 16
    input strength: Float = 1.0
    
    let height_center = texture_sample(height_map).r
    
    let occlusion = 0.0
    let i = 0
    while i < sample_count:
        let angle = (i / sample_count) * 2.0 * 3.14159
        let offset = vec2(cos(angle), sin(angle)) * sample_radius
        let sample_height = texture_sample(height_map, uv + offset).r
        
        if sample_height > height_center:
            occlusion = occlusion + 1.0
        
        i = i + 1
    
    occlusion = occlusion / sample_count
    let ao_value = 1.0 - (occlusion * strength)
    ao_value = clamp(ao_value, 0.0, 1.0)
    
    base_color = vec3(ao_value, ao_value, ao_value)
