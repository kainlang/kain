fn create_default_generation_params() -> DungeonGenerationParams:
    let params = DungeonGenerationParams {
        seed: 12345,
        algorithm: GenerationAlgorithm::BSPTree,
        target_room_count: 20,
        min_room_size: 5,
        max_room_size: 15,
        corridor_width: 3,
        max_corridor_length: 20,
        treasure_room_count: 3,
        secret_room_count: 2,
        boss_room_count: 1,
        puzzle_room_count: 2,
        enable_dead_ends: true,
        dead_end_probability: 0.2,
        enable_loops: true,
        loop_probability: 0.15,
        cellular_automata_iterations: 5,
        cellular_automata_birth_limit: 4,
        cellular_automata_death_limit: 3,
        bsp_min_room_size: 5,
        bsp_max_depth: 6
    }
    return params

fn vec2i_add(a: Vec2i, b: Vec2i) -> Vec2i:
    return Vec2i { x: a.x + b.x, y: a.y + b.y }

fn vec2i_sub(a: Vec2i, b: Vec2i) -> Vec2i:
    return Vec2i { x: a.x - b.x, y: a.y - b.y }

fn vec2i_distance(a: Vec2i, b: Vec2i) -> Float:
    let dx = (a.x - b.x) as Float
    let dy = (a.y - b.y) as Float
    return sqrt(dx * dx + dy * dy)

fn vec2i_manhattan_distance(a: Vec2i, b: Vec2i) -> Int:
    return abs(a.x - b.x) + abs(a.y - b.y)

fn vec2i_equals(a: Vec2i, b: Vec2i) -> Bool:
    return a.x == b.x && a.y == b.y

fn bounds_contains_point(bounds: RoomBounds, point: Vec2i) -> Bool:
    return point.x >= bounds.min_x && point.x <= bounds.max_x &&
           point.y >= bounds.min_y && point.y <= bounds.max_y

fn bounds_intersects(a: RoomBounds, b: RoomBounds) -> Bool:
    return a.min_x <= b.max_x && a.max_x >= b.min_x &&
           a.min_y <= b.max_y && a.max_y >= b.min_y

fn bounds_get_center(bounds: RoomBounds) -> Vec2i:
    return Vec2i {
        x: (bounds.min_x + bounds.max_x) / 2,
        y: (bounds.min_y + bounds.max_y) / 2
    }

fn bounds_get_area(bounds: RoomBounds) -> Int:
    return bounds.width * bounds.height

fn direction_to_vec2i(dir: ConnectionDirection) -> Vec2i:
    match dir:
        ConnectionDirection::North => Vec2i { x: 0, y: 1 }
        ConnectionDirection::South => Vec2i { x: 0, y: -1 }
        ConnectionDirection::East => Vec2i { x: 1, y: 0 }
        ConnectionDirection::West => Vec2i { x: -1, y: 0 }
        ConnectionDirection::NorthEast => Vec2i { x: 1, y: 1 }
        ConnectionDirection::NorthWest => Vec2i { x: -1, y: 1 }
        ConnectionDirection::SouthEast => Vec2i { x: 1, y: -1 }
        ConnectionDirection::SouthWest => Vec2i { x: -1, y: -1 }

fn opposite_direction(dir: ConnectionDirection) -> ConnectionDirection:
    match dir:
        ConnectionDirection::North => ConnectionDirection::South
        ConnectionDirection::South => ConnectionDirection::North
        ConnectionDirection::East => ConnectionDirection::West
        ConnectionDirection::West => ConnectionDirection::East
        ConnectionDirection::NorthEast => ConnectionDirection::SouthWest
        ConnectionDirection::NorthWest => ConnectionDirection::SouthEast
        ConnectionDirection::SouthEast => ConnectionDirection::NorthWest
        ConnectionDirection::SouthWest => ConnectionDirection::NorthEast

fn validate_room_constraints(room: GeneratedRoom, constraints: RoomConstraints) -> Bool:
    if room.bounds.width < constraints.min_width || room.bounds.width > constraints.max_width:
        return false
    if room.bounds.height < constraints.min_height || room.bounds.height > constraints.max_height:
        return false
    if len(room.connections) < constraints.required_connections:
        return false
    if len(room.connections) > constraints.max_connections:
        return false
    if room.distance_from_entrance < constraints.min_distance_from_entrance:
        return false
    if room.distance_from_entrance > constraints.max_distance_from_entrance:
        return false
    return true

fn can_connect_room_types(type_a: RoomType, type_b: RoomType, constraints: RoomConstraints) -> Bool:
    let mut i = 0
    while i < len(constraints.forbidden_neighbors):
        if constraints.forbidden_neighbors[i] == type_b:
            return false
        i = i + 1
    
    if len(constraints.allowed_neighbors) > 0:
        let mut found = false
        let mut j = 0
        while j < len(constraints.allowed_neighbors):
            if constraints.allowed_neighbors[j] == type_b:
                found = true
            j = j + 1
        return found
    
    return true
