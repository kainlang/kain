// DungeonArchitect — Data Structures
// Room types, connection rules, generation parameters, constraint system

enum RoomType:
    Entrance
    Corridor
    Treasure
    Boss
    Puzzle
    Secret
    DeadEnd
    Hub

enum ConnectionDirection:
    North
    South
    East
    West
    NorthEast
    NorthWest
    SouthEast
    SouthWest

enum GenerationAlgorithm:
    BSPTree
    CellularAutomata
    GraphBased
    Hybrid

enum RoomPriority:
    Critical
    High
    Medium
    Low

enum DoorType:
    Open
    Locked
    Hidden
    Breakable
    OneWay

struct Vec2i:
    x: Int
    y: Int

struct RoomBounds:
    min_x: Int
    min_y: Int
    max_x: Int
    max_y: Int
    width: Int
    height: Int

struct ConnectionPoint:
    position: Vec2i
    direction: ConnectionDirection
    door_type: DoorType
    is_locked: Bool
    required_key_id: Int

struct RoomConstraints:
    min_width: Int
    max_width: Int
    min_height: Int
    max_height: Int
    required_connections: Int
    max_connections: Int
    allowed_neighbors: Array<RoomType>
    forbidden_neighbors: Array<RoomType>
    must_be_leaf: Bool
    must_be_hub: Bool
    min_distance_from_entrance: Int
    max_distance_from_entrance: Int

struct RoomTemplate:
    room_type: RoomType
    priority: RoomPriority
    constraints: RoomConstraints
    connection_points: Array<ConnectionPoint>
    prop_spawn_density: Float
    enemy_spawn_density: Float
    loot_spawn_density: Float
    required_props: Array<String>
    optional_props: Array<String>
    ambient_sound: String
    lighting_preset: String

struct GeneratedRoom:
    id: Int
    room_type: RoomType
    bounds: RoomBounds
    world_position: Vec3
    connections: Array<Int>
    connection_points: Array<ConnectionPoint>
    is_generated: Bool
    is_populated: Bool
    actor_reference: Actor
    distance_from_entrance: Int
    visited: Bool

struct CorridorSegment:
    start_pos: Vec2i
    end_pos: Vec2i
    width: Int
    connects_rooms: Array<Int>

struct DungeonGenerationParams:
    seed: Int
    algorithm: GenerationAlgorithm
    target_room_count: Int
    min_room_size: Int
    max_room_size: Int
    corridor_width: Int
    max_corridor_length: Int
    treasure_room_count: Int
    secret_room_count: Int
    boss_room_count: Int
    puzzle_room_count: Int
    enable_dead_ends: Bool
    dead_end_probability: Float
    enable_loops: Bool
    loop_probability: Float
    cellular_automata_iterations: Int
    cellular_automata_birth_limit: Int
    cellular_automata_death_limit: Int
    bsp_min_room_size: Int
    bsp_max_depth: Int

struct BSPNode:
    bounds: RoomBounds
    left_child: Int
    right_child: Int
    room_id: Int
    is_leaf: Bool
    split_horizontal: Bool
    split_position: Int

struct CellularGrid:
    width: Int
    height: Int
    cells: Array<Bool>
    room_ids: Array<Int>

struct GraphNode:
    id: Int
    position: Vec2i
    room_type: RoomType
    connections: Array<Int>
    weight: Float
    visited: Bool

struct PathfindingNode:
    position: Vec2i
    g_cost: Float
    h_cost: Float
    f_cost: Float
    parent: Int
    is_open: Bool
    is_closed: Bool

struct DungeonLayout:
    rooms: Array<GeneratedRoom>
    corridors: Array<CorridorSegment>
    entrance_room_id: Int
    boss_room_ids: Array<Int>
    treasure_room_ids: Array<Int>
    secret_room_ids: Array<Int>
    total_area: Int
    generation_time: Float

struct PropPlacementRule:
    prop_class_name: String
    min_count: Int
    max_count: Int
    placement_radius: Float
    avoid_walls: Bool
    avoid_doors: Bool
    avoid_other_props: Bool
    min_distance_from_walls: Float
    min_distance_from_doors: Float
    min_distance_from_props: Float
    snap_to_floor: Bool
    random_rotation: Bool
    random_scale_min: Float
    random_scale_max: Float

struct EnemySpawnRule:
    enemy_class_name: String
    min_count: Int
    max_count: Int
    spawn_radius: Float
    patrol_radius: Float
    aggro_radius: Float
    difficulty_multiplier: Float

struct LootSpawnRule:
    loot_class_name: String
    spawn_probability: Float
    min_value: Int
    max_value: Int
    rarity_weight: Float

struct RoomPopulationData:
    room_id: Int
    prop_rules: Array<PropPlacementRule>
    enemy_rules: Array<EnemySpawnRule>
    loot_rules: Array<LootSpawnRule>
    spawned_actors: Array<Actor>

struct NavigationMeshBakeRequest:
    room_ids: Array<Int>
    priority: RoomPriority
    is_complete: Bool
    bake_time: Float

struct DungeonGenerationStats:
    total_rooms: Int
    total_corridors: Int
    total_area: Int
    generation_time: Float
    algorithm_used: GenerationAlgorithm
    seed_used: Int
    failed_room_placements: Int
    constraint_violations: Int
    pathfinding_iterations: Int

@datatable
struct RoomTypeData:
    room_type: RoomType
    display_name: String
    description: String
    default_constraints: RoomConstraints
    default_prop_density: Float
    default_enemy_density: Float
    default_loot_density: Float
    icon_path: String
    color: Vec3

@datatable
struct DoorTypeData:
    door_type: DoorType
    display_name: String
    mesh_path: String
    material_path: String
    open_sound: String
    close_sound: String
    locked_sound: String
    unlock_sound: String
    break_sound: String
    health: Float
    requires_key: Bool

@datatable
struct GenerationPresetData:
    preset_name: String
    description: String
    algorithm: GenerationAlgorithm
    params: DungeonGenerationParams
    recommended_for: String

fn create_default_room_constraints() -> RoomConstraints:
    let constraints = RoomConstraints {
        min_width: 5,
        max_width: 15,
        min_height: 5,
        max_height: 15,
        required_connections: 1,
        max_connections: 4,
        allowed_neighbors: [],
        forbidden_neighbors: [],
        must_be_leaf: false,
        must_be_hub: false,
        min_distance_from_entrance: 0,
        max_distance_from_entrance: 100
    }
    return constraints

fn create_entrance_room_template() -> RoomTemplate:
    let constraints = RoomConstraints {
        min_width: 8,
        max_width: 12,
        min_height: 8,
        max_height: 12,
        required_connections: 1,
        max_connections: 3,
        allowed_neighbors: [],
        forbidden_neighbors: [],
        must_be_leaf: false,
        must_be_hub: true,
        min_distance_from_entrance: 0,
        max_distance_from_entrance: 0
    }
    
    let template = RoomTemplate {
        room_type: RoomType::Entrance,
        priority: RoomPriority::Critical,
        constraints: constraints,
        connection_points: [],
        prop_spawn_density: 0.1,
        enemy_spawn_density: 0.0,
        loot_spawn_density: 0.0,
        required_props: ["PlayerStart", "EntranceDoor"],
        optional_props: ["Torch", "Banner"],
        ambient_sound: "Amb_Entrance",
        lighting_preset: "Bright"
    }
    return template

