// DungeonArchitect — Graph Editor
// UEdGraph nodes for dungeon authoring with visual editor

@graph_editor
graph DungeonGraph:
    @node_type
    node EntranceRoomNode:
        properties:
            RoomWidth: Int = 10
            RoomHeight: Int = 10
            SpawnPointCount: Int = 1
            AllowMultipleExits: Bool = true
            LightingPreset: String = "Bright"
            AmbientSound: String = "Amb_Entrance"
        inputs:
            InExec: Exec
        outputs:
            OnGenerated: Exec
            NorthExit: Exec
            SouthExit: Exec
            EastExit: Exec
            WestExit: Exec
        
        display_name: "Entrance Room"
        category: "Dungeon/Rooms"
        color: Vec3 { x: 0.2, y: 0.8, z: 0.2 }
        tooltip: "Starting room for the dungeon with player spawn point"
    
    @node_type
    node CorridorNode:
        properties:
            CorridorWidth: Int = 3
            MinLength: Int = 5
            MaxLength: Int = 15
            AllowBends: Bool = true
            MaxBends: Int = 2
            PlaceTorches: Bool = true
            TorchSpacing: Float = 5.0
        inputs:
            InExec: Exec
            StartPoint: Exec
        outputs:
            OnGenerated: Exec
            EndPoint: Exec
        
        display_name: "Corridor"
        category: "Dungeon/Connectors"
        color: Vec3 { x: 0.6, y: 0.6, z: 0.6 }
        tooltip: "Connects two rooms with a corridor"
    
    @node_type
    node TreasureRoomNode:
        properties:
            RoomWidth: Int = 8
            RoomHeight: Int = 8
            ChestCount: Int = 1
            LootQuality: Float = 0.8
            GuardianCount: Int = 2
            RequiresKey: Bool = false
            KeyID: Int = 0
        inputs:
            InExec: Exec
        outputs:
            OnGenerated: Exec
            OnLooted: Exec
            Exit: Exec
        
        display_name: "Treasure Room"
        category: "Dungeon/Rooms"
        color: Vec3 { x: 1.0, y: 0.8, z: 0.0 }
        tooltip: "Room containing treasure chests and loot"
    
    @node_type
    node BossRoomNode:
        properties:
            RoomWidth: Int = 20
            RoomHeight: Int = 20
            BossType: String = "DefaultBoss"
            ArenaStyle: String = "Circular"
            PillarCount: Int = 4
            HasBarrier: Bool = true
            LootMultiplier: Float = 2.0
        inputs:
            InExec: Exec
        outputs:
            OnGenerated: Exec
            OnBossDefeated: Exec
            Exit: Exec
        
        display_name: "Boss Room"
        category: "Dungeon/Rooms"
        color: Vec3 { x: 1.0, y: 0.0, z: 0.0 }
        tooltip: "Large arena room for boss encounters"
    
    @node_type
    node PuzzleRoomNode:
        properties:
            RoomWidth: Int = 12
            RoomHeight: Int = 12
            PuzzleType: String = "Lever"
            Difficulty: Float = 0.5
            RewardQuality: Float = 0.6
            TimeLimit: Float = 0.0
            HintCount: Int = 2
        inputs:
            InExec: Exec
        outputs:
            OnGenerated: Exec
            OnSolved: Exec
            OnFailed: Exec
            Exit: Exec
        
        display_name: "Puzzle Room"
        category: "Dungeon/Rooms"
        color: Vec3 { x: 0.5, y: 0.5, z: 1.0 }
        tooltip: "Room with puzzle mechanics that must be solved"
    
    @node_type
    node SecretRoomNode:
        properties:
            RoomWidth: Int = 6
            RoomHeight: Int = 6
            HiddenDoorType: String = "Breakable"
            DiscoveryDifficulty: Float = 0.7
            LootQuality: Float = 0.9
            IsOptional: Bool = true
        inputs:
            InExec: Exec
        outputs:
            OnGenerated: Exec
            OnDiscovered: Exec
            Exit: Exec
        
        display_name: "Secret Room"
        category: "Dungeon/Rooms"
        color: Vec3 { x: 0.8, y: 0.0, z: 0.8 }
        tooltip: "Hidden room with high-quality loot"
    
    @node_type
    node HubRoomNode:
        properties:
            RoomWidth: Int = 15
            RoomHeight: Int = 15
            ExitCount: Int = 4
            CentralFeature: String = "Fountain"
            AllowFastTravel: Bool = true
            IsCheckpoint: Bool = true
        inputs:
            InExec: Exec
        outputs:
            OnGenerated: Exec
            NorthExit: Exec
            SouthExit: Exec
            EastExit: Exec
            WestExit: Exec
            NorthEastExit: Exec
            NorthWestExit: Exec
        
        display_name: "Hub Room"
        category: "Dungeon/Rooms"
        color: Vec3 { x: 0.0, y: 0.8, z: 0.8 }
        tooltip: "Central room connecting multiple paths"
    
    @node_type
    node DeadEndRoomNode:
        properties:
            RoomWidth: Int = 6
            RoomHeight: Int = 6
            EnemyCount: Int = 3
            HasLoot: Bool = true
            LootQuality: Float = 0.3
            Atmosphere: String = "Creepy"
        inputs:
            InExec: Exec
        outputs:
            OnGenerated: Exec
        
