        category: "Dungeon/Rules"
        color: Vec3 { x: 1.0, y: 0.5, z: 0.0 }
        tooltip: "Defines constraints for room placement"
    
    @node_type
    node GenerationSettingsNode:
        properties:
            Algorithm: String = "BSPTree"
            Seed: Int = 12345
            TargetRoomCount: Int = 20
            MinRoomSize: Int = 5
            MaxRoomSize: Int = 15
            EnableLoops: Bool = true
            LoopProbability: Float = 0.15
        inputs:
            InExec: Exec
        outputs:
