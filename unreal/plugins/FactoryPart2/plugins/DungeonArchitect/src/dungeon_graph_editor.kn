        display_name: "Generation Settings"
        category: "Dungeon/Config"
        color: Vec3 { x: 0.2, y: 0.2, z: 0.8 }
        tooltip: "Global settings for dungeon generation"
    
    @node_type
    node PropSpawnerNode:
        properties:
            PropClassName: String = "BP_Torch"
            SpawnDensity: Float = 0.3
            MinDistanceFromWalls: Float = 1.0
            MinDistanceFromDoors: Float = 2.0
            RandomRotation: Bool = true
