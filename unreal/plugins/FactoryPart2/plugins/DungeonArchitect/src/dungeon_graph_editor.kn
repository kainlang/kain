        category: "Dungeon/Rooms"
        color: Vec3 { x: 0.3, y: 0.3, z: 0.3 }
        tooltip: "Room with no exits, creates dead ends"
    
    @node_type
    node ConnectionRuleNode:
        properties:
            MinDistance: Int = 1
            MaxDistance: Int = 10
            RequireLineOfSight: Bool = false
            AllowDiagonal: Bool = true
            PreferShortest: Bool = true
            AvoidCrossing: Bool = true
        inputs:
            InExec: Exec
            RoomA: Exec
            RoomB: Exec
        outputs:
            OnConnected: Exec
            OnFailed: Exec
        
        display_name: "Connection Rule"
        category: "Dungeon/Rules"
        color: Vec3 { x: 0.8, y: 0.8, z: 0.0 }
        tooltip: "Defines rules for connecting two rooms"
    
    @node_type
    node ConstraintNode:
        properties:
            ConstraintType: String = "MinDistance"
            TargetRoomType: String = "Treasure"
            MinValue: Float = 3.0
            MaxValue: Float = 100.0
            IsHardConstraint: Bool = true
            Priority: Int = 5
        inputs:
