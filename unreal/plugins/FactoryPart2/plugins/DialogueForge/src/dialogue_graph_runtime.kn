        next: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            println("Quest action: {quest_action} for quest {quest_id}")
            return 0
    
    @node_data
    node RandomNodeData:
        branch1_weight: Float = 1.0
        branch2_weight: Float = 1.0
        branch3_weight: Float = 0.0
        branch4_weight: Float = 0.0
        use_branch3: Bool = false
        use_branch4: Bool = false
        seed: Int = 0
        use_random_seed: Bool = true
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        branch1: Exec
        
        @output_pin
        branch2: Exec
        
        @output_pin
        branch3: Exec
        
        @output_pin
        branch4: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            let mut weights = []
            push(weights, branch1_weight)
            push(weights, branch2_weight)
            if use_branch3:
                push(weights, branch3_weight)
            if use_branch4:
                push(weights, branch4_weight)
            
            let total = branch1_weight + branch2_weight
            let rand_val = random_float() * total
            
            if rand_val < branch1_weight:
                return 0
            else:
                return 1
    
