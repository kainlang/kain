    @node_data
    node SkillCheckNodeData:
        skill_name: String = "Persuasion"
        difficulty_class: Int = 15
        stat_name: String = "Charisma"
        allow_retry: Bool = false
        show_difficulty: Bool = true
        critical_success_threshold: Int = 20
        critical_failure_threshold: Int = 1
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        success: Exec
        
        @output_pin
        failure: Exec
        
        @output_pin
        critical_success: Exec
        
        @output_pin
        critical_failure: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            let roll = random_int_range(1, 20)
            println("Skill check: {skill_name} DC {difficulty_class}, rolled {roll}")
            
            if roll >= critical_success_threshold:
                return 2
            else if roll <= critical_failure_threshold:
                return 3
            else if roll >= difficulty_class:
                return 0
            else:
                return 1
    
