// DialogueForge — Graph Runtime
// NodeData execution and GraphInstance state management

@graph_runtime
graph DialogueSystem:
    @node_data
    node SpeakerNodeData:
        speaker_id: String = "npc"
        dialogue_text: String = "Hello"
        voice_line_path: String = ""
        subtitle_text: String = ""
        emotion: SpeakerEmotion = SpeakerEmotion::Neutral
        camera_angle: CameraAngle = CameraAngle::MediumShot
        animation_name: String = ""
        duration: Float = 3.0
        is_skippable: Bool = true
        auto_advance: Bool = false
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        next: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            println("Speaker: {speaker_id} says: {dialogue_text}")
            return 0
    
    @node_data
    node ChoiceNodeData:
        speaker_id: String = "player"
        prompt_text: String = "What do you say?"
        choice1_text: String = "Option 1"
        choice1_next_id: Int = -1
        choice2_text: String = "Option 2"
        choice2_next_id: Int = -1
        choice3_text: String = "Option 3"
        choice3_next_id: Int = -1
        choice4_text: String = "Option 4"
        choice4_next_id: Int = -1
        show_choice1: Bool = true
        show_choice2: Bool = true
        show_choice3: Bool = false
        show_choice4: Bool = false
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        choice1: Exec
        
        @output_pin
        choice2: Exec
        
        @output_pin
        choice3: Exec
        
        @output_pin
        choice4: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            println("Choice: {prompt_text}")
            if show_choice1:
                println("  1. {choice1_text}")
            if show_choice2:
                println("  2. {choice2_text}")
            if show_choice3:
                println("  3. {choice3_text}")
            if show_choice4:
                println("  4. {choice4_text}")
            return 0
    
    @node_data
    node ConditionNodeData:
        condition_type: ConditionType = ConditionType::VariableEquals
        target_id: String = "quest_complete"
        comparison_value: Float = 1.0
        string_value: String = ""
        invert: Bool = false
        required: Bool = true
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        success: Exec
        
        @output_pin
        failure: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            let result = evaluate_condition_runtime(condition_type, target_id, comparison_value, instance)
            if invert:
                return if result { 1 } else { 0 }
            return if result { 0 } else { 1 }
    
    @node_data
    node BranchNodeData:
        condition1_type: ConditionType = ConditionType::VariableEquals
        condition1_target: String = ""
        condition1_value: Float = 0.0
        condition2_type: ConditionType = ConditionType::VariableEquals
        condition2_target: String = ""
        condition2_value: Float = 0.0
        use_condition2: Bool = false
        require_all: Bool = true
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        true_branch: Exec
        
        @output_pin
        false_branch: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            let result1 = evaluate_condition_runtime(condition1_type, condition1_target, condition1_value, instance)
            
            if !use_condition2:
                return if result1 { 0 } else { 1 }
            
            let result2 = evaluate_condition_runtime(condition2_type, condition2_target, condition2_value, instance)
            
            if require_all:
                return if result1 && result2 { 0 } else { 1 }
            else:
                return if result1 || result2 { 0 } else { 1 }
    
    @node_data
    node EventNodeData:
        event_name: String = "OnDialogueEvent"
        event_param1: String = ""
        event_param2: String = ""
        event_param3: String = ""
        target_actor_tag: String = ""
        delay: Float = 0.0
        broadcast_to_all: Bool = false
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        next: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            println("Event triggered: {event_name}")
            return 0
    
