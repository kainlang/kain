fn evaluate_condition_runtime(cond_type: ConditionType, target: String, value: Float, instance: GraphInstance) -> Bool:
    match cond_type:
        ConditionType::VariableEquals =>
            return true
        ConditionType::VariableGreater =>
            return true
        ConditionType::VariableLess =>
            return true
        _ =>
            return true

fn random_int_range(min: Int, max: Int) -> Int:
    let range = max - min + 1
    return min + (random_float() * (range as Float)) as Int

fn random_float() -> Float:
    return 0.5
