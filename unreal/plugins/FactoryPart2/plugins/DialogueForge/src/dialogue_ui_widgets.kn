    return QuestNotificationWidget {
        quest_name: "",
        notification_text: "",
        notification_type: "Started",
        is_visible: false,
        display_duration: 5.0,
        current_display_time: 0.0,
        fade_in_duration: 0.5,
        fade_out_duration: 0.5,
        background_color: Vec3 { x: 0.1, y: 0.1, z: 0.1 },
        text_color: Vec3 { x: 1.0, y: 1.0, z: 1.0 },
