    return DialogueDebugWidget {
        current_instance_id: -1,
        current_node_id: -1,
        current_graph_id: "",
        active_dialogue_count: 0,
        registered_speaker_count: 0,
        loaded_graph_count: 0,
        is_visible: false,
        show_variables: true,
        show_flags: true,
        show_history: false,
        variables: [],
        flags: []
    }
