// ============================================================================
// KAIN EDITOR FEATURE SHOWCASE
// ============================================================================
// This file demonstrates EVERY editor feature supported by the ue5-editor crate.
// It's a comprehensive reference for building production UE5 editor plugins.
//
// Source References:
// - slate.rs (1851 lines) - All Slate widget types, delegates, slot patterns
// - details.rs (784 lines) - Property customization patterns
// - asset_editor_ir.rs (676 lines) - Asset editor toolkit features
// - viewport.rs (303 lines) - Custom viewport patterns
// - editor_module_codegen.rs (498 lines) - Module registration
// - style.rs (384 lines) - Style system
// - assets.rs (342 lines) - Asset type patterns
// - reactive.rs (305 lines) - Layout optimizer
//
// Total: 4,500+ lines of production-tested codegen
// ============================================================================

// ============================================================================
// PART 1: COMPREHENSIVE SLATE WIDGET SHOWCASE
// ============================================================================
// Demonstrates ALL 25+ Slate widget types with every supported property

@slate
struct EditorDashboard:
    // === Text Properties ===
    title: String = "Ultimate Editor Dashboard"
    subtitle: String = "Showcasing all KAIN editor features"
    hint_text: String = "Enter search query..."
    tooltip_text: String = "This is a comprehensive tooltip"
    
    // === Numeric Properties (with @slider for details panel) ===
    @slider(0.0, 100.0)
    progress_value: Float = 50.0
    
    @slider(0, 10)
    item_count: Int = 5
    
    @slider(0.0, 1.0)
    opacity: Float = 1.0
    
    // === Color Properties ===
    @color_picker
    primary_color: Color = color("blue")
    
    @color_picker
    accent_color: Color = color("orange")
    
    // === Boolean Properties ===
    is_enabled: Bool = true
    is_visible: Bool = true
    auto_refresh: Bool = false
    
    // === Delegate Properties (Event Handlers) ===
    // FOnClicked - button clicks
    on_start_clicked: void
    on_stop_clicked: void
    on_pause_clicked: void
    on_refresh_clicked: void
    
    // FOnTextChanged - text input
    on_search_changed: void
    on_filter_changed: void
    
    // FOnFloatValueChanged - slider/spinbox
    on_value_changed: void
    on_opacity_changed: void
    
    // FOnCheckStateChanged - checkbox
    on_auto_refresh_changed: void
    
    // === List Data (for SListView) ===
    log_entries: Array<String> = []
    asset_items: Array<String> = []
    
    // === Style Properties ===
    icon_brush: Brush
    background_brush: Brush
    
    fn Compose() -> Widget:
        // Root layout - vertical box with all widget types
        return VerticalBox()
            // === SECTION 1: Text Widgets ===
            .Add(
                Border()
                    .Padding(margin(10.0))
                    .BorderImage(background_brush)
                    .Content(
                        VerticalBox()
                            // STextBlock - static text
                            .Add(
                                TextBlock()
                                    .Text(title)
                                    .Font(font("Bold", 24))
                                    .ColorAndOpacity(primary_color)
                                    .AutoWrapText(true)
                            )
                            // STextBlock - subtitle
                            .Add(
                                TextBlock()
                                    .Text(subtitle)
                                    .Font(font("Regular", 14))
                                    .ColorAndOpacity(color("gray"))
                            )
                    )
            )
            
            // === SECTION 2: Input Widgets ===
            .Add(
                Border()
                    .Padding(margin(10.0))
                    .Content(
                        VerticalBox()
                            // SEditableTextBox - text input
                            .Add(
                                HorizontalBox()
                                    .Add(
                                        TextBlock()
                                            .Text("Search:")
                                            .MinDesiredWidth(80.0)
                                    )
                                    .Add(
                                        EditableTextBox()
                                            .HintText(hint_text)
                                            .OnTextChanged(on_search_changed)
                                            .MinDesiredWidth(200.0)
                                    )
                            )
                            
                            // SSlider - horizontal slider
                            .Add(
                                HorizontalBox()
                                    .Add(
                                        TextBlock()
                                            .Text("Progress:")
                                            .MinDesiredWidth(80.0)
                                    )
                                    .Add(
                                        Slider()
                                            .Value(progress_value)
                                            .MinValue(0.0)
                                            .MaxValue(100.0)
                                            .OnValueChanged(on_value_changed)
                                    )
                                    .Add(
                                        TextBlock()
                                            .Text(format("{:.1}%", progress_value))
                                            .MinDesiredWidth(50.0)
                                    )
                            )
                            
                            // SSpinBox - numeric input with arrows
                            .Add(
                                HorizontalBox()
                                    .Add(
                                        TextBlock()
                                            .Text("Item Count:")
                                            .MinDesiredWidth(80.0)
                                    )
                                    .Add(
                                        SpinBox()
                                            .Value(item_count as Float)
                                            .MinValue(0.0)
                                            .MaxValue(10.0)
                                            .MinDesiredWidth(100.0)
                                    )
                            )
                            
                            // SCheckBox - checkbox with label
                            .Add(
                                CheckBox()
                                    .IsChecked(auto_refresh)
                                    .OnCheckStateChanged(on_auto_refresh_changed)
                                    .Content(
                                        TextBlock()
                                            .Text("Auto Refresh")
                                    )
                            )
                    )
            )
            
            // === SECTION 3: Button Widgets ===
            .Add(
                Border()
                    .Padding(margin(10.0))
                    .Content(
                        HorizontalBox()
                            // SButton - standard button
                            .Add(
                                Button()
                                    .OnClicked(on_start_clicked)
                                    .Content(
                                        HorizontalBox()
                                            .Add(
                                                Image()
                                                    .Image(icon_brush)
                                            )
                                            .Add(
                                                TextBlock()
                                                    .Text("Start")
                                                    .Padding(margin(5.0, 0.0))
                                            )
                                    )
                            )
                            .Add(
                                Button()
                                    .OnClicked(on_pause_clicked)
                                    .Content(
                                        TextBlock()
                                            .Text("Pause")
                                    )
                            )
                            .Add(
                                Button()
                                    .OnClicked(on_stop_clicked)
                                    .Content(
                                        TextBlock()
                                            .Text("Stop")
                                    )
                            )
                            .Add(
                                Button()
                                    .OnClicked(on_refresh_clicked)
                                    .IsEnabled(is_enabled)
                                    .Content(
                                        TextBlock()
                                            .Text("Refresh")
                                    )
                            )
                    )
            )
            
            // === SECTION 4: Progress & Visual Widgets ===
            .Add(
                Border()
                    .Padding(margin(10.0))
                    .Content(
                        VerticalBox()
                            // SProgressBar - progress indicator
                            .Add(
                                ProgressBar()
                                    .Percent(progress_value / 100.0)
                                    .FillColorAndOpacity(primary_color)
                            )
                            
                            // SColorBlock - color display
                            .Add(
                                HorizontalBox()
                                    .Add(
                                        TextBlock()
                                            .Text("Primary Color:")
                                            .MinDesiredWidth(100.0)
                                    )
                                    .Add(
                                        ColorBlock()
                                            .Color(primary_color)
                                            .Size(vec2(50.0, 20.0))
                                    )
                                    .Add(
                                        TextBlock()
                                            .Text("Accent Color:")
                                            .MinDesiredWidth(100.0)
                                    )
                                    .Add(
                                        ColorBlock()
                                            .Color(accent_color)
                                            .Size(vec2(50.0, 20.0))
                                    )
                            )
                            
                            // SSeparator - visual divider
                            .Add(
                                Separator()
                                    .Orientation(Orient_Horizontal)
                            )
                    )
            )
            
            // === SECTION 5: List Widgets ===
            .Add(
                Border()
                    .Padding(margin(10.0))
                    .Content(
                        HorizontalBox()
                            // SListView - scrollable list
                            .Add(
                                VerticalBox()
                                    .Add(
                                        TextBlock()
                                            .Text("Log Entries:")
                                    )
                                    .Add(
                                        ListView()
                                            .ListItemsSource(log_entries)
                                            .OnGenerateRow(on_generate_log_row)
                                            .ItemHeight(24.0)
                                            .SelectionMode(SelectionMode_Single)
                                    )
                            )
                            
                            // STileView - grid layout
                            .Add(
                                VerticalBox()
                                    .Add(
                                        TextBlock()
                                            .Text("Asset Items:")
                                    )
                                    .Add(
                                        TileView()
                                            .ListItemsSource(asset_items)
                                            .OnGenerateRow(on_generate_asset_tile)
                                            .ItemHeight(64.0)
                                            .ItemWidth(64.0)
                                    )
                            )
                    )
            )
            
            // === SECTION 6: Layout Widgets ===
            .Add(
                Border()
                    .Padding(margin(10.0))
                    .Content(
                        VerticalBox()
                            // SOverlay - layered widgets
                            .Add(
                                Overlay()
                                    .Add(
                                        Image()
                                            .Image(background_brush)
                                    )
                                    .Add(
                                        TextBlock()
                                            .Text("Overlaid Text")
                                            .ColorAndOpacity(color("white"))
                                    )
                            )
                            
                            // SGridPanel - grid layout
                            .Add(
                                GridPanel()
                                    .Add(
                                        TextBlock()
                                            .Text("Row 0, Col 0")
                                            .Column(0)
                                            .Row(0)
                                    )
                                    .Add(
                                        TextBlock()
                                            .Text("Row 0, Col 1")
                                            .Column(1)
                                            .Row(0)
                                    )
                                    .Add(
                                        TextBlock()
                                            .Text("Row 1, Col 0")
                                            .Column(0)
                                            .Row(1)
                                    )
                                    .Add(
                                        TextBlock()
                                            .Text("Row 1, Col 1")
                                            .Column(1)
                                            .Row(1)
                                    )
                            )
                            
                            // SSplitter - resizable split
                            .Add(
                                Splitter()
                                    .Orientation(Orient_Horizontal)
                                    .Add(
                                        TextBlock()
                                            .Text("Left Panel")
                                    )
                                    .Add(
                                        TextBlock()
                                            .Text("Right Panel")
                                    )
                            )
                            
                            // SWrapBox - auto-wrapping layout
                            .Add(
                                WrapBox()
                                    .Add(Button().Content(TextBlock().Text("Tag 1")))
                                    .Add(Button().Content(TextBlock().Text("Tag 2")))
                                    .Add(Button().Content(TextBlock().Text("Tag 3")))
                                    .Add(Button().Content(TextBlock().Text("Tag 4")))
                            )
                    )
            )
            
            // === SECTION 7: Advanced Widgets ===
            .Add(
                Border()
                    .Padding(margin(10.0))
                    .Content(
                        VerticalBox()
                            // SScrollBox - scrollable content
                            .Add(
                                ScrollBox()
                                    .Orientation(Orient_Vertical)
                                    .Content(
                                        VerticalBox()
                                            .Add(TextBlock().Text("Scrollable Line 1"))
                                            .Add(TextBlock().Text("Scrollable Line 2"))
                                            .Add(TextBlock().Text("Scrollable Line 3"))
                                            .Add(TextBlock().Text("Scrollable Line 4"))
                                            .Add(TextBlock().Text("Scrollable Line 5"))
                                    )
                            )
                            
                            // SMenuAnchor - dropdown menu
                            .Add(
                                MenuAnchor()
                                    .Content(
                                        Button()
                                            .Content(
                                                TextBlock()
                                                    .Text("Open Menu")
                                            )
                                    )
                            )
                    )
            )

// ============================================================================
// PART 2: DETAILS PANEL CUSTOMIZATION SHOWCASE
// ============================================================================
// Demonstrates ALL property customization patterns from details.rs

@details
struct WeaponDetails:
    // === Category Organization ===
    @category("Weapon Stats")
    damage: Float = 50.0
    
    @category("Weapon Stats")
    fire_rate: Float = 10.0
    
    @category("Weapon Stats")
    magazine_size: Int = 30
    
    // === Slider Customization ===
    @category("Visual")
    @slider(0.0, 100.0)
    glow_intensity: Float = 50.0
    
    @category("Visual")
    @slider(0.0, 1.0)
    transparency: Float = 1.0
    
    @category("Visual")
    @slider(-180.0, 180.0)
    rotation_offset: Float = 0.0
    
    // === Color Picker ===
    @category("Visual")
    @color_picker
    primary_color: Color = color("red")
    
    @category("Visual")
    @color_picker
    secondary_color: Color = color("blue")
    
    // === Asset Picker ===
    @category("Assets")
    @asset_picker(allowed_classes=["StaticMesh"])
    weapon_mesh: StaticMesh
    
    @category("Assets")
    @asset_picker(allowed_classes=["Material", "MaterialInstance"])
    weapon_material: Material
    
    @category("Assets")
    @asset_picker(allowed_classes=["Texture2D"])
    icon_texture: Texture2D
    
    // === Button Actions ===
    @category("Actions")
    @button("Generate LODs")
    generate_lods_action: void
    
    @category("Actions")
    @button("Validate Setup")
    validate_action: void
    
    @category("Actions")
    @button("Export Data")
    export_action: void
    
    // === Conditional Visibility ===
    @category("Advanced")
    @visible_if("is_advanced_mode")
    debug_mode: Bool = false
    
    @category("Advanced")
    @visible_if("debug_mode")
    verbose_logging: Bool = false

// ============================================================================
// PART 3: CUSTOM VIEWPORT SHOWCASE
// ============================================================================
// Demonstrates viewport patterns from viewport.rs

@viewport
struct WeaponPreviewViewport:
    // === Preview Mesh Setup ===
    @preview_mesh
    preview_mesh: StaticMesh
    
    // === Camera Configuration ===
    @camera
    camera_distance: Float = 200.0
    
    @camera
    camera_angle: Float = -15.0
    
    // === Viewport State ===
    show_grid: Bool = true
    show_bounds: Bool = false
    wireframe_mode: Bool = false
    
    // === Custom Viewport Methods ===
    fn SetPreviewMesh(mesh: StaticMesh):
        preview_mesh = mesh
    
    fn UpdateCameraDistance(distance: Float):
        camera_distance = distance
    
    fn ToggleWireframe():
        wireframe_mode = !wireframe_mode
    
    fn ResetCamera():
        camera_distance = 200.0
        camera_angle = -15.0

// ============================================================================
// PART 4: ASSET EDITOR TOOLKIT SHOWCASE
// ============================================================================
// Demonstrates asset editor patterns from asset_editor_ir.rs + assets.rs

@asset_editor
@asset_type("WeaponData")
struct WeaponEditor:
    // === Viewport Panel ===
    @viewport
    @tab_name("3D Preview")
    @size(0.7)
    preview: WeaponPreviewViewport
    
    // === Details Panel ===
    @details_panel
    @tab_name("Properties")
    @size(0.3)
    @show_name_area
    @lockable
    properties: DetailsView
    
    // === Toolbar ===
    @toolbar
    tools: WeaponToolbar
    
    // === Custom Slate Widget ===
    @slate
    @tab_name("Statistics")
    @size(0.3)
    stats_panel: WeaponStatsPanel
    
    // === Custom Methods ===
    fn SaveAsset():
        println("Saving weapon asset...")
    
    fn ValidateAsset() -> Bool:
        return true
    
    fn ExportToJSON():
        println("Exporting to JSON...")

// Custom stats panel widget
@slate
struct WeaponStatsPanel:
    total_damage: Float = 0.0
    dps: Float = 0.0
    accuracy: Float = 0.0
    
    fn Compose() -> Widget:
        return VerticalBox()
            .Add(
                TextBlock()
                    .Text("Weapon Statistics")
                    .Font(font("Bold", 18))
            )
            .Add(
                HorizontalBox()
                    .Add(TextBlock().Text("Total Damage:"))
                    .Add(TextBlock().Text(format("{:.1}", total_damage)))
            )
            .Add(
                HorizontalBox()
                    .Add(TextBlock().Text("DPS:"))
                    .Add(TextBlock().Text(format("{:.1}", dps)))
            )
            .Add(
                HorizontalBox()
                    .Add(TextBlock().Text("Accuracy:"))
                    .Add(TextBlock().Text(format("{:.1}%", accuracy)))
            )

