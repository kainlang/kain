// ============================================================================
// PART 7: REACTIVE PROPERTY OPTIMIZATION SHOWCASE
// ============================================================================
// Demonstrates layout optimizer patterns from reactive.rs

@slate
struct OptimizedDashboard:
    // === Static Properties (SLATE_ARGUMENT) ===
    // Set once at construction, no Tick overhead
    @argument
    title: String = "Optimized Dashboard"
    
    @argument
    icon: Brush
    
    @argument
    tooltip_text: String = "This is static"
    
    // === Reactive Properties (SLATE_ATTRIBUTE) ===
    // Can change during widget lifetime, requires Tick
    @reactive
    current_value: Float = 0.0
    
    @reactive
    status_text: String = "Ready"
    
    @reactive
    is_processing: Bool = false
    
    // === Event Handlers (SLATE_EVENT) ===
    on_start: void
    on_stop: void
    on_refresh: void
    
    fn Compose() -> Widget:
        return VerticalBox()
            .Add(
                TextBlock()
                    .Text(title)  // Static - no Tick
            )
            .Add(
                TextBlock()
                    .Text(status_text)  // Reactive - updates via Tick
            )
            .Add(
                ProgressBar()
                    .Percent(current_value)  // Reactive - updates via Tick
            )
            .Add(
                Button()
                    .OnClicked(on_start)  // Event - delegate binding
                    .IsEnabled(!is_processing)  // Reactive - updates via Tick
                    .Content(
                        TextBlock()
                            .Text("Start")
                    )
            )

// ============================================================================
// PART 8: ADVANCED PATTERNS SHOWCASE
// ============================================================================

// === Shader Integration (shader_image from slate.rs) ===
@slate
struct ShaderPreviewWidget:
    material: Material
    preview_size: Vec2 = vec2(256.0, 256.0)
    
    fn Compose() -> Widget:
        return Border()
            .Content(
                shader_image(material, preview_size)
            )

// === Complex List View with Custom Row Generation ===
@slate
struct AssetBrowser:
    assets: Array<AssetItem> = []
    selected_asset: AssetItem
    
    on_asset_selected: void
    on_asset_double_clicked: void
    
    fn Compose() -> Widget:
        return VerticalBox()
            .Add(
                TextBlock()
                    .Text("Asset Browser")
                    .Font(font("Bold", 18))
            )
            .Add(
                ListView()
                    .ListItemsSource(assets)
                    .OnGenerateRow(on_generate_asset_row)
                    .OnSelectionChanged(on_asset_selected)
                    .ItemHeight(48.0)
                    .SelectionMode(SelectionMode_Single)
                    .HeaderRow(
                        HorizontalBox()
                            .Add(TextBlock().Text("Name"))
                            .Add(TextBlock().Text("Type"))
                            .Add(TextBlock().Text("Size"))
                    )
            )

// === Nested Widget Composition ===
@slate
struct ToolPanel:
    tool_name: String = "Tool"
    tool_icon: Brush
    is_active: Bool = false
    
    on_activate: void
    on_deactivate: void
    
    fn Compose() -> Widget:
        return Border()
            .Padding(margin(5.0))
            .BorderImage(if is_active then active_brush else inactive_brush)
            .Content(
                HorizontalBox()
                    .Add(
                        Image()
                            .Image(tool_icon)
                            .Size(vec2(32.0, 32.0))
                    )
                    .Add(
                        VerticalBox()
                            .Add(
                                TextBlock()
                                    .Text(tool_name)
                                    .Font(font("Bold", 14))
                            )
                            .Add(
                                Button()
                                    .OnClicked(if is_active then on_deactivate else on_activate)
                                    .Content(
                                        TextBlock()
                                            .Text(if is_active then "Deactivate" else "Activate")
                                    )
                            )
                    )
            )

// === ComboBox with Custom Options ===
@slate
struct FilterPanel:
    filter_options: Array<String> = ["All", "Meshes", "Materials", "Textures"]
    selected_filter: String = "All"
    
    on_filter_changed: void
    
    fn Compose() -> Widget:
        return HorizontalBox()
            .Add(
                TextBlock()
                    .Text("Filter:")
                    .MinDesiredWidth(60.0)
            )
            .Add(
                ComboBox()
                    .OptionsSource(filter_options)
                    .OnSelectionChanged(on_filter_changed)
                    .OnGenerateWidget(on_generate_filter_option)
            )

// === TreeView for Hierarchical Data ===
@slate
struct HierarchyPanel:
    root_items: Array<TreeItem> = []
    
    on_item_selected: void
    on_item_expanded: void
    
    fn Compose() -> Widget:
        return TreeView()
            .ListItemsSource(root_items)
            .OnGenerateRow(on_generate_tree_row)
            .OnGetChildren(on_get_tree_children)
            .OnSelectionChanged(on_item_selected)
            .ItemHeight(24.0)

// ============================================================================
// SUMMARY OF FEATURES DEMONSTRATED
// ============================================================================
//
// SLATE WIDGETS (25+ types):
// - Layout: VerticalBox, HorizontalBox, GridPanel, UniformGridPanel, ScrollBox,
//           Border, Overlay, Splitter, WrapBox, Canvas
// - Input: Button, CheckBox, ComboBox, EditableTextBox, Slider, SpinBox
// - Display: TextBlock, Image, ProgressBar, Separator, ColorBlock, ToolTip
// - Lists: ListView, TreeView, TileView, TableRow
// - Advanced: MenuAnchor
//
// SLATE PROPERTIES (50+ properties):
// - Text: Text, HintText, ToolTipText, Font, AutoWrapText, WrapTextAt
// - Delegates: OnClicked, OnPressed, OnReleased, OnHovered, OnUnhovered,
//              OnValueChanged, OnTextCommitted, OnTextChanged,
//              OnCheckStateChanged, OnSelectionChanged, OnColorChanged
// - Visual: ColorAndOpacity, Color, BackgroundColor, ForegroundColor,
//           Image, Brush, BorderImage, Style
// - State: IsEnabled, Visibility, IsChecked, Value, Percent
// - Numeric: MinValue, MaxValue, MinDesiredWidth, MaxDesiredWidth,
//            MinDesiredHeight, MaxDesiredHeight
// - Layout: Orientation, Justification, Padding, Margin, RenderTransform,
//           RenderTransformPivot
// - List: ListItemsSource, OnGenerateRow, OnGetChildren, SelectionMode,
//         ItemHeight, HeaderRow
// - Grid: Column, Row, ColumnSpan, RowSpan
// - ComboBox: OptionsSource, OnGenerateWidget
// - Splitter: ResizeMode, PhysicalSplitterHandleSize
//
// DETAILS PANEL CUSTOMIZATION:
// - @category - Property grouping
// - @slider(min, max) - SpinBox ranges with property binding
// - @color_picker - Color pickers with property binding
// - @asset_picker(allowed_classes) - Asset pickers with property binding
// - @button(label) - Action buttons with FReply handlers
// - @visible_if(condition) - Conditional visibility
//
// VIEWPORT FEATURES:
// - @viewport - SEditorViewport + FEditorViewportClient generation
// - @preview_mesh - Preview mesh setup
// - @camera - Camera configuration
// - Custom viewport methods (SetPreviewMesh, UpdateCamera, etc.)
//
// ASSET EDITOR TOOLKIT:
// - @asset_editor - FAssetEditorToolkit generation
// - @asset_type - Asset type registration
// - Viewport panel integration
// - Details panel integration
// - Toolbar integration
// - Custom Slate widget panels
// - Tab layout configuration (horizontal/vertical splits)
// - Size coefficients for panel sizing
//
// EDITOR MODULE:
// - @editor_module - IModuleInterface generation
// - @menu_entry - Menu entry registration with FUICommandList
// - @toolbar_button - Toolbar button extensions
// - @icon, @tooltip, @label - Metadata attributes
// - IMPLEMENT_MODULE macro generation
//
// STYLE SYSTEM:
// - Icon(), Brush(), Font(), Color() definitions
// - FSlateStyleSet registration
// - Type-safe resource accessors
//
