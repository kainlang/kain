// PART 5: EDITOR MODULE SHOWCASE
// ============================================================================
// Demonstrates editor module patterns from editor_module_codegen.rs

@editor_module
struct WeaponEditorModule:
    // === Menu Entries ===
    @menu_entry(path: "Tools/Weapons", label: "Open Weapon Editor")
    @icon("Icons.Weapon")
    @tooltip("Open the weapon editor toolkit")
    fn on_open_weapon_editor():
        println("Opening weapon editor...")
    
    @menu_entry(path: "Tools/Weapons", label: "Import Weapon Data")
    @icon("Icons.Import")
    @tooltip("Import weapon data from JSON")
    fn on_import_weapon_data():
        println("Importing weapon data...")
    
    @menu_entry(path: "Tools/Weapons", label: "Export All Weapons")
    @icon("Icons.Export")
    @tooltip("Export all weapons to JSON")
    fn on_export_all_weapons():
        println("Exporting all weapons...")
    
    // === Toolbar Buttons ===
    @toolbar_button(section: "Content", icon: "Icons.Weapon")
    @label("Quick Create Weapon")
    @tooltip("Quickly create a new weapon asset")
    fn on_quick_create_weapon():
        println("Quick creating weapon...")
    
    @toolbar_button(section: "Content", icon: "Icons.Validate")
    @label("Validate Weapons")
    @tooltip("Validate all weapon assets")
    fn on_validate_weapons():
        println("Validating weapons...")
    
    @toolbar_button(section: "Settings", icon: "Icons.Settings")
    @label("Weapon Settings")
    @tooltip("Open weapon editor settings")
    fn on_open_settings():
        println("Opening settings...")

