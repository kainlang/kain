// ============================================================================
// KAIN Material Graph Showcase - EVERY Feature Demonstrated
// ============================================================================
// This file demonstrates EVERY feature supported by the ue5-materials crate
// Based on comprehensive analysis of material_graph.rs and ast_converter.rs
// ============================================================================

// ============================================================================
// FEATURE 1: Basic PBR Material with Parameters
// ============================================================================
// Demonstrates: ScalarParameter, VectorParameter, ColorParameter
// File: material_graph.rs:90-92
@material_graph(
    blend_mode: Opaque,
    shading_model: DefaultLit,
    two_sided: false
)
material BasicPBR:
    input roughness: Float = 0.5
    input metallic: Float = 0.0
    input base_tint: Vec3 = vec3(0.8, 0.8, 0.8)
    input emissive_color: Vec4 = vec4(0.0, 0.0, 0.0, 1.0)
    
    output base_color = base_tint
    output roughness = roughness
    output metallic = metallic
    output emissive = emissive_color

// ============================================================================
// FEATURE 2: Math Operations - ALL Binary Ops
// ============================================================================
// Demonstrates: Add, Subtract, Multiply, Divide
// File: material_graph.rs:93-96, ast_converter.rs:150-168
@material_graph
material MathOperations:
    input a: Float = 2.0
    input b: Float = 3.0
    input c: Float = 4.0
    input d: Float = 5.0
    
    let sum = a + b              // Add node
    let difference = c - d       // Subtract node
    let product = a * b          // Multiply node
    let quotient = c / d         // Divide node
    
    let complex = (a + b) * (c - d)  // Nested operations
    
    output base_color = vec3(sum, product, quotient)
    output roughness = difference

// ============================================================================
// FEATURE 3: Advanced Math Functions
// ============================================================================
// Demonstrates: Lerp, Power, Clamp, Dot, Cross, Normalize, Length, Distance
// File: material_graph.rs:97-103, ast_converter.rs:228-371
@material_graph
material AdvancedMath:
    input color_a: Vec3 = vec3(1.0, 0.0, 0.0)
    input color_b: Vec3 = vec3(0.0, 0.0, 1.0)
    input blend_factor: Float = 0.5
    input power_base: Float = 2.0
    input power_exp: Float = 3.0
    input vec_a: Vec3 = vec3(1.0, 0.0, 0.0)
    input vec_b: Vec3 = vec3(0.0, 1.0, 0.0)
    
    // Lerp - linear interpolation
    let blended = lerp(color_a, color_b, blend_factor)
    
    // Power operation
    let powered = pow(power_base, power_exp)
    
    // Clamp to range
    let clamped = clamp(blend_factor, 0.2, 0.8)
    
    // Vector operations
    let dot_result = dot(vec_a, vec_b)
    let cross_result = cross(vec_a, vec_b)
    let normalized = normalize(vec_a)
    let vec_length = length(vec_a)
    let vec_distance = distance(vec_a, vec_b)
    
    output base_color = blended
    output roughness = powered
    output metallic = dot_result

// ============================================================================
// FEATURE 4: Scalar Math Functions
// ============================================================================
// Demonstrates: Abs, Min, Max, Saturate, Frac, Floor, Ceil, Round, Sqrt, Exp, Log
// File: material_graph.rs:106-116, ast_converter.rs:372-560
@material_graph
material ScalarMath:
    input value: Float = -2.5
    input value_a: Float = 3.0
    input value_b: Float = 7.0
    
    let absolute = abs(value)           // Absolute value
    let minimum = min(value_a, value_b) // Minimum of two values
    let maximum = max(value_a, value_b) // Maximum of two values
    let saturated = saturate(value)     // Clamp to [0,1]
    let fractional = frac(value)        // Fractional part
    let floored = floor(value)          // Floor function
    let ceiled = ceil(value)            // Ceiling function
    let rounded = round(value)          // Round to nearest
    let square_root = sqrt(value_a)     // Square root
    let exponential = exp(value_a)      // e^x
    let logarithm = log(value_a)        // Natural log
    
    output base_color = vec3(absolute, minimum, maximum)
    output roughness = saturated
    output metallic = fractional

// ============================================================================
// FEATURE 5: Trigonometric Functions
// ============================================================================
// Demonstrates: Sine, Cosine
// File: material_graph.rs:117-118, ast_converter.rs:194-227
@material_graph
material TrigFunctions:
    input angle: Float = 3.14159
    input frequency: Float = 2.0
    
    let sine_wave = sin(angle * frequency)
    let cosine_wave = cos(angle * frequency)
    let combined = sine_wave * cosine_wave
    
    output base_color = vec3(sine_wave, cosine_wave, combined)
    output emissive = vec3(sine_wave, 0.0, cosine_wave)

// ============================================================================
// FEATURE 6: Fresnel Effect
// ============================================================================
// Demonstrates: Fresnel node for rim lighting
// File: material_graph.rs:119
@material_graph
material FresnelRimLight:
    input base_color: Vec3 = vec3(0.1, 0.1, 0.1)
    input rim_color: Vec3 = vec3(0.0, 0.5, 1.0)
    input rim_power: Float = 3.0
    input rim_intensity: Float = 2.0
    input base_reflect: Float = 0.0
    
    let fresnel_value = fresnel(rim_power, base_reflect)
    let rim_effect = rim_color * fresnel_value * rim_intensity
    
    output base_color = base_color
    output emissive = rim_effect
    output roughness = 0.5

// ============================================================================
// FEATURE 7: Component Masking (Channel Extraction)
// ============================================================================
// Demonstrates: ComponentMask via field access (.r, .g, .b, .rgb, etc.)
// File: material_graph.rs:120, ast_converter.rs:1058-1087
@material_graph
material ComponentMasking:
    input color: Vec4 = vec4(1.0, 0.5, 0.25, 1.0)
    
    // Extract individual channels using field access
    let red_channel = color.r
    let green_channel = color.g
    let blue_channel = color.b
    let alpha_channel = color.a
    
    // Extract multiple channels
    let rg_channels = color.rg
    let rgb_channels = color.rgb
    
    output base_color = rgb_channels
    output opacity = alpha_channel
    output roughness = red_channel

// ============================================================================
// FEATURE 8: Vector Construction and Constants
// ============================================================================
// Demonstrates: ConstantFloat, ConstantVec3, ConstantVec4, vec3(), vec4()
// File: material_graph.rs:123-127, ast_converter.rs:614-658
@material_graph
material VectorConstruction:
    input scale: Float = 1.0
    
    // Constant values
    let one = 1.0
    let half = 0.5
    
    // Vector constructors
    let red = vec3(1.0, 0.0, 0.0)
    let green = vec3(0.0, 1.0, 0.0)
    let blue = vec3(0.0, 0.0, 1.0)
    let white_opaque = vec4(1.0, 1.0, 1.0, 1.0)
    
    // Use constructed vectors
    let mixed = red * scale + green * half
    
    output base_color = mixed
    output roughness = one
    output metallic = half

// ============================================================================
// FEATURE 9: Texture Sampling with UV Coordinates
// ============================================================================
// Demonstrates: TextureSampleParameter2D, TextureCoordinate, sample()
// File: material_graph.rs:88-89, 128, ast_converter.rs:561-613, 1246-1272
@material_graph
material TextureSampling:
    input albedo_map: Sampler2D
    input normal_map: Sampler2D
    input roughness_map: Sampler2D
    input tiling: Float = 1.0
    
    // Default UV coordinates (auto-created, deduplicated)
    let albedo = sample(albedo_map)
    let normal = sample(normal_map)
    let roughness_tex = sample(roughness_map)
    
    // Extract roughness from red channel
    let roughness_value = roughness_tex.r
    
    output base_color = albedo.rgb
    output normal = normal.rgb
    output roughness = roughness_value

// ============================================================================
// FEATURE 10: Custom HLSL Nodes
// ============================================================================
// Demonstrates: CustomHLSL with arbitrary HLSL code, inputs, output types
// File: material_graph.rs:61-77, 130-137, ast_converter.rs:702-801
@material_graph
material CustomHLSLEffects:
    input color_a: Vec3 = vec3(1.0, 0.0, 0.0)
    input color_b: Vec3 = vec3(0.0, 1.0, 0.0)
    input blend: Float = 0.5
    
    // Custom HLSL for advanced blending
    let custom_blend = custom_hlsl(
        """
        float3 result = Input0 * Input1 * Input2;
        result = saturate(result);
        return result;
        """,
        output_type: "float3",
        inputs: [(Input0, "float3"), (Input1, "float3"), (Input2, "float")]
    )
    
    // Custom HLSL for procedural noise
    let noise = custom_hlsl(
        """
        float2 uv = Input0;
        float n = frac(sin(dot(uv, float2(12.9898, 78.233))) * 43758.5453);
        return n;
        """,
        output_type: "float",
        inputs: [(Input0, "float2")]
    )
    
    output base_color = custom_blend
    output roughness = noise

// ============================================================================
// FEATURE 11: Time-Based Effects (Animations)
// ============================================================================
// Demonstrates: Time node for animated materials
// File: material_graph.rs:10, 142, ast_converter.rs:183-193, 1197-1224
@material_graph
material AnimatedPulse:
    input pulse_color: Vec3 = vec3(1.0, 0.0, 1.0)
    input pulse_speed: Float = 1.0
    input pulse_min: Float = 0.2
    input pulse_max: Float = 1.0
    
    // Get engine time (deduplicated - only one Time node per material)
    let time_value = time()
    
    // Create sine wave animation
    let sine_wave = sin(time_value * pulse_speed)
    
    // Remap from [-1,1] to [0,1]
    let normalized = sine_wave * 0.5 + 0.5
    
    // Clamp to desired range
    let pulse_strength = clamp(normalized, pulse_min, pulse_max)
    
    // Apply to color
    let pulsing_color = pulse_color * pulse_strength
    
    output base_color = vec3(0.1, 0.1, 0.1)
    output emissive = pulsing_color

// ============================================================================
// FEATURE 12: UV Manipulation - Scrolling
// ============================================================================
// Demonstrates: UVScroll for animated texture scrolling
// File: material_graph.rs:147-151, ast_converter.rs:802-827
@material_graph
material ScrollingTexture:
    input texture_map: Sampler2D
    input scroll_speed_x: Float = 0.1
    input scroll_speed_y: Float = 0.0
    
    let time_value = time()
    let offset_x = time_value * scroll_speed_x
    let offset_y = time_value * scroll_speed_y
    
    // Get default UVs
    let base_uv = sample(texture_map)  // This creates UV internally
    
    // Scroll UVs (requires explicit UV node - simplified for showcase)
    let scrolled = uv_scroll(base_uv, offset_x, offset_y)
    
    output base_color = scrolled.rgb
    output emissive = scrolled.rgb * 0.5

// ============================================================================
// FEATURE 13: UV Manipulation - Scaling
// ============================================================================
// Demonstrates: UVScale for texture tiling
// File: material_graph.rs:152-156, ast_converter.rs:828-853
@material_graph
material ScaledTexture:
    input texture_map: Sampler2D
    input scale_x: Float = 2.0
    input scale_y: Float = 2.0
    
    let base_uv = sample(texture_map)
    let scaled_uv = uv_scale(base_uv, scale_x, scale_y)
    
    output base_color = scaled_uv.rgb

// ============================================================================
// FEATURE 14: UV Manipulation - Rotation
// ============================================================================
// Demonstrates: UVRotate for rotating textures
// File: material_graph.rs:157-161, ast_converter.rs:854-886
@material_graph
material RotatingTexture:
    input texture_map: Sampler2D
    input rotation_speed: Float = 1.0
    input center_x: Float = 0.5
    input center_y: Float = 0.5
    
    let time_value = time()
    let angle = time_value * rotation_speed
    
    let base_uv = sample(texture_map)
    
    // Rotate around custom center point
    let rotated_uv = uv_rotate(base_uv, angle, center_x, center_y)
    
    // Or rotate around default center (0.5, 0.5)
    let rotated_default = uv_rotate(base_uv, angle)
    
    output base_color = rotated_uv.rgb

// ============================================================================
// FEATURE 15: World-Space Operations - Position
// ============================================================================
// Demonstrates: WorldPosition, AbsoluteWorldPosition, ObjectPosition
// File: material_graph.rs:189-195, ast_converter.rs:887-981
@material_graph
material WorldSpacePosition:
    input scale: Float = 0.01
    
    // Get world position (with camera offset)
    let world_pos = world_position()
    
    // Get absolute world position (no camera offset)
    let abs_world_pos = absolute_world_position()
    
    // Get object pivot position
    let object_pos = object_position()
    
    // Use world position for procedural effects
    let procedural_color = world_pos * scale
    let clamped_color = saturate(procedural_color)
    
    output base_color = clamped_color

// ============================================================================
// FEATURE 16: World-Space Operations - Normals and Camera
// ============================================================================
// Demonstrates: WorldNormal, CameraPosition, ObjectOrientation
// File: material_graph.rs:189-195, ast_converter.rs:906-999
@material_graph
material WorldSpaceNormals:
    input rim_power: Float = 2.0
    
    // Get world-space normal
    let world_normal = world_normal()
    
    // Get camera position
    let camera_pos = camera_position()
    
    // Get object orientation
    let object_orient = object_orientation()
    
    // Use normal for coloring
    let normal_color = world_normal * 0.5 + 0.5
    
    output base_color = normal_color
    output roughness = 0.5

// ============================================================================
// FEATURE 17: Triplanar Texture Sampling
// ============================================================================
// Demonstrates: TriplanarSample for world-space texture projection
// File: material_graph.rs:197-203, ast_converter.rs:1001-1050
@material_graph
material TriplanarMapping:
    input texture_map: Sampler2D
    input blend_sharpness: Float = 4.0
    
    // Triplanar sampling with default world position
    let triplanar_default = triplanar_sample(texture_map)
    
    // Triplanar sampling with custom world position and blend sharpness
    let custom_world_pos = world_position()
    let triplanar_custom = triplanar_sample(texture_map, custom_world_pos, blend_sharpness)
    
    output base_color = triplanar_custom.rgb

// ============================================================================
// FEATURE 18: Material Function Calls (Shader Integration)
// ============================================================================
// Demonstrates: MaterialFunctionCall for calling existing KAIN shaders
// File: material_graph.rs:163-169, ast_converter.rs:660-701, 1274-1316
@material_graph
material ShaderIntegration:
    input color_a: Vec3 = vec3(1.0, 0.0, 0.0)
    input color_b: Vec3 = vec3(0.0, 1.0, 0.0)
    input blend: Float = 0.5
    
    // Call existing KAIN shader as material function
    let shader_result = call_shader("CustomBlendShader", color_a, color_b, blend)
    
    output base_color = shader_result

// ============================================================================
// FEATURE 19: Dynamic Materials (Runtime Parameter Modification)
// ============================================================================
// Demonstrates: @dynamic attribute, expose_parameters, mark_parameter_dynamic
// File: material_graph.rs:10-11, 19-41, 48, 225, 287-321, ast_converter.rs:1134-1138
@material_graph
@dynamic
material DynamicMaterial:
    input glow_intensity: Float = 1.0
    input glow_color: Vec3 = vec3(0.0, 1.0, 1.0)
    input pulse_speed: Float = 2.0
    
    let time_value = time()
    let pulse = sin(time_value * pulse_speed) * 0.5 + 0.5
    let dynamic_glow = glow_color * glow_intensity * pulse
    
    output base_color = vec3(0.1, 0.1, 0.1)
    output emissive = dynamic_glow

// ============================================================================
// FEATURE 20: Vertex Shader - World Position Offset
// ============================================================================
// Demonstrates: world_position_offset output, uses_vertex_shader flag
// File: material_graph.rs:14-16, 216, ast_converter.rs:1236-1240
@material_graph
material VertexDisplacement:
    input wave_amplitude: Float = 10.0
    input wave_frequency: Float = 1.0
    
    let time_value = time()
    let world_pos = world_position()
    
    // Create wave displacement
    let wave = sin(world_pos.x * wave_frequency + time_value)
    let displacement = vec3(0.0, 0.0, wave * wave_amplitude)
    
    output base_color = vec3(0.5, 0.5, 1.0)
    output world_position_offset = displacement

// ============================================================================
// FEATURE 21: Blend Modes - Translucent
// ============================================================================
// Demonstrates: BlendMode::Translucent with opacity
// File: material_graph.rs:238-244
@material_graph(blend_mode: Translucent)
material TranslucentGlass:
    input glass_color: Vec3 = vec3(0.8, 0.9, 1.0)
    input opacity: Float = 0.3
    input roughness: Float = 0.1
    
    output base_color = glass_color
    output opacity = opacity
    output roughness = roughness
    output metallic = 0.0

// ============================================================================
// FEATURE 22: Blend Modes - Additive
// ============================================================================
// Demonstrates: BlendMode::Additive for glowing effects
// File: material_graph.rs:238-244
@material_graph(blend_mode: Additive)
material AdditiveGlow:
    input glow_color: Vec3 = vec3(0.0, 1.0, 1.0)
    input glow_intensity: Float = 2.0
    
    let glow = glow_color * glow_intensity
    
    output emissive = glow

// ============================================================================
// FEATURE 23: Blend Modes - Masked
// ============================================================================
// Demonstrates: BlendMode::Masked for binary transparency
// File: material_graph.rs:238-244
@material_graph(blend_mode: Masked)
material MaskedFoliage:
    input albedo_map: Sampler2D
    input mask_map: Sampler2D
    input cutoff: Float = 0.5
    
    let albedo = sample(albedo_map)
    let mask = sample(mask_map)
    
    output base_color = albedo.rgb
    output opacity = mask.r

// ============================================================================
// FEATURE 24: Shading Models - Unlit
// ============================================================================
// Demonstrates: ShadingModel::Unlit for UI and effects
// File: material_graph.rs:246-258
@material_graph(shading_model: Unlit)
material UnlitEffect:
    input color: Vec3 = vec3(1.0, 1.0, 1.0)
    input brightness: Float = 1.0
    
    let final_color = color * brightness
    
    output emissive = final_color

// ============================================================================
// FEATURE 25: Shading Models - Subsurface
// ============================================================================
// Demonstrates: ShadingModel::Subsurface for skin, wax, etc.
// File: material_graph.rs:246-258
@material_graph(shading_model: Subsurface)
material SubsurfaceSkin:
    input skin_color: Vec3 = vec3(0.9, 0.7, 0.6)
    input subsurface_color: Vec3 = vec3(1.0, 0.3, 0.3)
    input roughness: Float = 0.4
    
    output base_color = skin_color
    output roughness = roughness

// ============================================================================
// FEATURE 26: Shading Models - ClearCoat
// ============================================================================
// Demonstrates: ShadingModel::ClearCoat for car paint
// File: material_graph.rs:246-258
@material_graph(shading_model: ClearCoat)
material CarPaint:
    input paint_color: Vec3 = vec3(0.8, 0.1, 0.1)
    input metallic_flakes: Float = 0.3
    input clear_coat_roughness: Float = 0.1
    input base_roughness: Float = 0.6
    
    let mixed_roughness = lerp(base_roughness, clear_coat_roughness, metallic_flakes)
    
    output base_color = paint_color
    output metallic = metallic_flakes
    output roughness = mixed_roughness

// ============================================================================
// FEATURE 27: Shading Models - TwoSidedFoliage
// ============================================================================
// Demonstrates: ShadingModel::TwoSidedFoliage with two_sided flag
// File: material_graph.rs:246-258
@material_graph(
    shading_model: TwoSidedFoliage,
    two_sided: true
)
material Foliage:
    input leaf_color: Vec3 = vec3(0.2, 0.6, 0.1)
    input translucency: Float = 0.3
    input roughness: Float = 0.8
    
    output base_color = leaf_color
    output roughness = roughness
    output opacity = translucency

// ============================================================================
// FEATURE 28: Material Domains - PostProcess
// ============================================================================
// Demonstrates: MaterialDomain::PostProcess for screen effects
// File: material_graph.rs:228-235
@material_graph(domain: PostProcess)
material PostProcessEffect:
    input intensity: Float = 1.0
    input color_tint: Vec3 = vec3(1.0, 0.9, 0.8)
    
    // Post-process materials work on screen UVs
    let effect = color_tint * intensity
    
    output emissive = effect

// ============================================================================
// FEATURE 29: Material Domains - UI
// ============================================================================
// Demonstrates: MaterialDomain::UI for user interface
// File: material_graph.rs:228-235
@material_graph(domain: UI)
material UIMaterial:
    input ui_color: Vec3 = vec3(0.2, 0.6, 1.0)
    input ui_opacity: Float = 0.9
    
    output base_color = ui_color
    output opacity = ui_opacity

// ============================================================================
// FEATURE 30: Complex Material - Everything Combined
// ============================================================================
// Demonstrates: Multiple features working together in production material
@material_graph(
    blend_mode: Opaque,
    shading_model: DefaultLit,
    two_sided: false
)
@dynamic
material ComplexProduction:
    // Texture inputs
    input albedo_map: Sampler2D
    input normal_map: Sampler2D
    input roughness_map: Sampler2D
    input metallic_map: Sampler2D
    input emissive_map: Sampler2D
    
    // Parameter inputs
    input base_tint: Vec3 = vec3(1.0, 1.0, 1.0)
    input roughness_multiplier: Float = 1.0
    input metallic_multiplier: Float = 1.0
    input emissive_intensity: Float = 1.0
    input uv_scale: Float = 1.0
    
    // World-space effects
    input world_blend_height: Float = 100.0
    input world_blend_sharpness: Float = 4.0
    
    // Animation
    input pulse_speed: Float = 1.0
    input pulse_intensity: Float = 0.5
    
    // Sample textures
    let albedo = sample(albedo_map)
    let normal = sample(normal_map)
    let roughness_tex = sample(roughness_map)
    let metallic_tex = sample(metallic_map)
    let emissive_tex = sample(emissive_map)
    
    // Apply tint
    let tinted_albedo = albedo.rgb * base_tint
    
    // Extract and modify PBR values
    let roughness_value = roughness_tex.r * roughness_multiplier
    let metallic_value = metallic_tex.r * metallic_multiplier
    
    // World-space height-based blending
    let world_pos = world_position()
    let height_factor = world_pos.z / world_blend_height
    let height_blend = saturate(height_factor)
    
    // Time-based pulsing emissive
    let time_value = time()
    let pulse = sin(time_value * pulse_speed) * 0.5 + 0.5
    let pulsing_emissive = emissive_tex.rgb * emissive_intensity * (1.0 + pulse * pulse_intensity)
    
    // Fresnel rim light
    let fresnel_value = fresnel(3.0, 0.0)
    let rim_light = vec3(0.2, 0.4, 1.0) * fresnel_value * 0.5
    
    // Combine emissive effects
    let final_emissive = pulsing_emissive + rim_light
    
    // Custom HLSL for advanced effect
    let custom_effect = custom_hlsl(
        """
        float3 color = Input0;
        float blend = Input1;
        color = lerp(color, float3(1, 1, 1), blend * 0.1);
        return color;
        """,
        output_type: "float3",
        inputs: [(Input0, "float3"), (Input1, "float")]
    )
    
    output base_color = custom_effect
    output normal = normal.rgb
    output roughness = clamp(roughness_value, 0.1, 1.0)
    output metallic = clamp(metallic_value, 0.0, 1.0)
    output emissive = final_emissive
    output ambient_occlusion = albedo.a

// ============================================================================
// END OF SHOWCASE
// ============================================================================
// This file demonstrates ALL 50+ features of the ue5-materials crate:
// 
// Node Types (30+):
// - ScalarParameter, VectorParameter, ColorParameter
// - TextureSampleParameter2D, TextureSample, TextureCoordinate
// - Add, Subtract, Multiply, Divide
// - Lerp, Dot, Cross, Normalize, Length, Distance, Power, Clamp
// - Abs, Min, Max, Saturate, Frac, Floor, Ceil, Round, Sqrt, Exp, Log
// - Sine, Cosine, Fresnel
// - ComponentMask, Append
// - ConstantFloat, ConstantVec3, ConstantVec4
// - CustomHLSL, Time
// - UVScroll, UVScale, UVRotate
// - MaterialFunctionCall
// - WorldPosition, WorldNormal, AbsoluteWorldPosition
// - CameraPosition, ObjectPosition, ObjectOrientation
// - TriplanarSample
//
// Material Properties:
// - Blend Modes: Opaque, Masked, Translucent, Additive, Modulate
// - Shading Models: DefaultLit, Unlit, Subsurface, ClearCoat, TwoSidedFoliage
// - Material Domains: Surface, PostProcess, UI
// - Two-sided rendering
// - Dynamic materials (@dynamic attribute)
// - Vertex shaders (world_position_offset)
//
// Advanced Features:
// - Time-based animations
// - UV manipulation (scroll, scale, rotate)
// - World-space operations
// - Custom HLSL injection
// - Triplanar mapping
// - Material function calls
// - Component masking
// - Dynamic parameter exposure
// - Vertex displacement
// ============================================================================
