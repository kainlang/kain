// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
int triangle_count;  // @3
int vertex_count;  // @4

// UAV Outputs
RWBuffer vertex_positions : register(u0);  // @0 -> u0 register
RWBuffer vertex_normals : register(u1);  // @1 -> u1 register
RWBuffer triangle_indices : register(u2);  // @2 -> u2 register

[numthreads(8, 8, 1)]
void SculptRecalculateNormalsCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= vertex_count))
    {
        return;
    }
    float3 normal = float3(0, 0, 0);
    int face_count = 0;
    for (int tri_idx = 0; tri_idx < triangle_count; tri_idx++)
    {
        RWBuffer i0 = triangle_indices[((tri_idx * 3) + 0)];
        RWBuffer i1 = triangle_indices[((tri_idx * 3) + 1)];
        RWBuffer i2 = triangle_indices[((tri_idx * 3) + 2)];
        if ((((i0 == idx) || (i1 == idx)) || (i2 == idx)))
        {
            float3 v0 = vertex_positions[i0].xyz;
            float3 v1 = vertex_positions[i1].xyz;
            float3 v2 = vertex_positions[i2].xyz;
            float3 edge1 = (v1 - v0);
            float3 edge2 = (v2 - v0);
            float3 face_normal = cross(edge1, edge2);
            normal = (normal + face_normal);
            face_count = (face_count + 1);
        }
    }
    if ((face_count > 0))
    {
        normal = normalize((normal / float(face_count)));
    }
    vertex_normals[idx] = float4(normal, 0.000000);
}
