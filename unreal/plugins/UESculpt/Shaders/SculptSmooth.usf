// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
int vertex_count;  // @3
float smooth_strength;  // @4

// UAV Outputs
RWBuffer vertex_positions : register(u0);  // @0 -> u0 register
RWBuffer vertex_neighbors : register(u1);  // @1 -> u1 register
RWBuffer neighbor_counts : register(u2);  // @2 -> u2 register

[numthreads(8, 8, 1)]
void SculptSmoothCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= vertex_count))
    {
        return;
    }
    float3 pos = vertex_positions[idx].xyz;
    RWBuffer neighbor_count = neighbor_counts[idx];
    float3 avg_pos = float3(0, 0, 0);
    for (int i = 0; i < neighbor_count; i++)
    {
        RWBuffer neighbor_idx = vertex_neighbors[((idx * 8) + i)];
        avg_pos = (avg_pos + vertex_positions[neighbor_idx].xyz);
    }
    avg_pos = (avg_pos / float(neighbor_count));
    float3 smoothed = (pos + (((avg_pos - pos)) * smooth_strength));
    vertex_positions[idx] = float4(smoothed, 1.000000);
}
