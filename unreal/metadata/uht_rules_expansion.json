  "replication_rules": {
    "property_replication": {
      "allowed_types": [
        "bool",
        "uint8",
        "int32",
        "int64",
        "float",
        "double",
        "FString",
        "FName",
        "FText",
        "FVector",
        "FRotator",
        "FTransform",
        "FLinearColor",
        "FColor",
        "TArray",
        "TObjectPtr",
        "UObject*",
        "AActor*",
        "UActorComponent*",
        "enum",
        "struct"
      ],
      "disallowed_types": [
        "TMap",
        "TSet",
        "TWeakObjectPtr",
        "TSoftObjectPtr",
        "TLazyObjectPtr",
        "TFunction",
        "TDelegate",
        "TMulticastDelegate"
      ],
      "constraints": [
        "Replicated properties must be marked with UPROPERTY(Replicated)",
        "Actor must implement GetLifetimeReplicatedProps",
        "Replicated arrays must use const reference in RPC parameters",
        "Replicated structs must be serializable",
        "Replicated pointers must be UObject-derived types"
      ]
    },
    "rpc_validation": {
      "naming_conventions": {
        "Server": "Server_FunctionName",
        "Client": "Client_FunctionName",
        "Multicast": "Multicast_FunctionName"
      },
      "required_specifiers": [
        "Reliable or Unreliable"
      ],
      "constraints": [
        "RPCs cannot have return values",
        "RPCs cannot be BlueprintImplementableEvent",
        "RPCs cannot be BlueprintNativeEvent",
        "RPCs cannot be Exec functions",
        "RPCs cannot be static",
        "RPCs cannot contain delegate parameters",
        "RPCs cannot contain out parameters",
        "RPC parameters must be passed by value or const reference"
      ]
    },
    "lifetime_replication": {
      "required_includes": [
        "Net/UnrealNetwork.h"
      ],
      "required_macros": [
        "DOREPLIFETIME",
        "DOREPLIFETIME_CONDITION"
      ],
      "function_signature": "void GetLifetimeReplicatedProps(TArray<FLifetimeProperty>& OutLifetimeProps) const override"
    }
  },
