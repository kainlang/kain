use std::machine

fn metal_phase1_intrinsics() -> Int with Unsafe:
    let mut cells: ptr<Int> = alloc_zeroed(4, "Int")

    volatile_store(cells, 7, "Int")
    let volatile_seen: Int = volatile_load(cells, "Int")
    let raw_address: Int = ptr_to_int(cells)
    let roundtrip: ptr<Int> = int_to_ptr(raw_address, "Int")
    let casted: I64 = bitcast(volatile_seen, "I64")

    atomic_store(roundtrip, casted, "Int", "release")
    let loaded: Int = atomic_load(roundtrip, "Int", "acquire")
    let old_add: Int = atomic_add(roundtrip, 3, "Int", "acq_rel")
    let old_and: Int = atomic_and(roundtrip, 15, "Int", "acq_rel")
    let old_or: Int = atomic_or(roundtrip, 32, "Int", "acq_rel")
    let old_xor: Int = atomic_xor(roundtrip, 7, "Int", "acq_rel")
    let swapped: Int = atomic_exchange(roundtrip, loaded + 1, "Int", "seq_cst")
    let changed: Bool = atomic_compare_exchange(roundtrip, loaded + 1, loaded + 2, "Int", "seq_cst", "acquire")
    atomic_fence("seq_cst")

    let page_bytes: Int = vm_page_size()
    let logical_cpus: Int = cpu_logical_count()
    let mapped: ptr<Int> = vm_map(page_bytes)
    var vm_score: Int = page_bytes + logical_cpus
    if ptr_to_int(mapped) != 0:
        volatile_store(mapped, 11, "Int")
        let _protect = vm_protect_read_write(mapped, page_bytes)
        vm_score = vm_score + volatile_load(mapped, "Int")
        let _unmap = vm_unmap(mapped, page_bytes)

    if changed:
        return old_add + old_and + old_or + old_xor + swapped + vm_score
    return old_add + old_and + old_or + old_xor + vm_score

fn main() -> Int with Unsafe:
    let score: Int = metal_phase1_intrinsics()
    if score >= 0:
        return 0
    return 1
