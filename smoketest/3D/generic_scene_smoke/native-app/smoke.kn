fn backend_mood(backend: String) -> String:
    if backend == "bgfx":
        return "bgfx feels immediate: cross-platform, direct, and stable enough to anchor the smoke."
    elif backend == "filament":
        return "filament feels premium: materials, lighting, and presentation should read expensive."
    elif backend == "diligent":
        return "diligent feels surgical: explicit passes, graph control, and compute depth."
    elif backend == "the-forge":
        return "the-forge feels raw: low-level substrate, bridge-first, and deliberately close to the metal."
    else:
        return "Kain feels owned: the runtime contract is authored here, not borrowed from a host example."

fn backend_focus(backend: String) -> String:
    if backend == "bgfx":
        return "baseline lane for the first real runtime-backed viewport."
    elif backend == "filament":
        return "premium lane for a polished material and lighting feel."
    elif backend == "diligent":
        return "graph lane for explicit renderer control and GPU visibility."
    elif backend == "the-forge":
        return "substrate lane for bridge-first device work and future low-level render depth."
    else:
        return "Kain-owned lane with Qt as the present fallback shell."

fn backend_state_label(active_backend: String, candidate_backend: String) -> String:
    if active_backend == candidate_backend:
        return "active lane"
    return "ready lane"

world GenericSceneSmoke:
    state active_backend: String = "bgfx"
    state active_mood: String = backend_mood("bgfx")
    state active_focus: String = backend_focus("bgfx")
    state status_line: String = "Kain owns the runtime contract. Qt is the presentation fallback."
    surface native_ui => App

patch choose_backend(showcase: GenericSceneSmoke, backend: String) -> String:
    showcase.active_backend = backend
    showcase.active_mood = backend_mood(backend)
    showcase.active_focus = backend_focus(backend)
    showcase.status_line = f"Kain runtime owner | active backend: {backend}"
    return showcase.active_backend

fn handle_bgfx():
    choose_backend(GenericSceneSmoke, "bgfx")

fn handle_filament():
    choose_backend(GenericSceneSmoke, "filament")

fn handle_diligent():
    choose_backend(GenericSceneSmoke, "diligent")

fn handle_forge():
    choose_backend(GenericSceneSmoke, "the-forge")

component App():
    render <slot layout="column" gap={18} padding={18}>
        <theme name="geometry_fixture">
            <scope name="atrium" selector="geometry-fixture" />
            <token name="theme.chrome.topbar.visible" category="chrome" value={false} />
            <token name="theme.spacing.scale" category="space" value={1.08} />
            <token name="theme.radius.scale" category="surface" value={1.18} />
            <token name="theme.typography.scale" category="type" value={1.06} />
            <token name="theme.background.top" category="color" value="#07111c" />
            <token name="theme.background.bottom" category="color" value="#130f17" />
            <token name="theme.surface.base" category="color" value="#101827" />
            <token name="theme.surface.alt" category="color" value="#192230" />
            <token name="theme.surface.raised" category="color" value="#21293a" />
            <token name="theme.surface.overlay" category="color" value="#0c1421dd" />
            <token name="theme.accent.primary" category="color" value="#70ddff" />
            <token name="theme.accent.soft" category="color" value="#b9f2ff" />
            <token name="theme.highlight" category="color" value="#ffbf74" />
            <token name="theme.text.default" category="color" value="#f7fbff" />
            <token name="theme.text.muted" category="color" value="#96a4b5" />
            <token name="widget.panel.surface.mode" category="surface" value="glass" />
            <token name="widget.viewport3d.surface.mode" category="surface" value="canvas" />

            <variant scope="atrium" name="nav">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={10} />
            </variant>

            <variant scope="atrium" name="hero">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={18} />
            </variant>

            <variant scope="atrium" name="section">
                <token name="surface.mode" category="surface" value="layered" />
                <token name="surface.padding" category="space" value={16} />
            </variant>

            <variant scope="atrium" name="card">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={14} />
            </variant>
        </theme>

        <panel scope="atrium" variant="nav" layout="row" gap={16}>
            <slot layout="column" gap={4}>
                <text role="eyebrow">KAIN GENERIC SCENE SMOKE</text>
                <text role="caption">Source-first smoke. Native-owner metadata. Kain primitives. Qt is the current presentation fallback.</text>
            </slot>
            <slot layout="row" gap={10}>
                <button onclick={"geometry_fixture.backend.bgfx"}>bgfx</button>
                <button onclick={"geometry_fixture.backend.filament"}>filament</button>
                <button onclick={"geometry_fixture.backend.diligent"}>diligent</button>
                <button onclick={"geometry_fixture.backend.the-forge"}>the-forge</button>
            </slot>
        </panel>

        <panel title="Scene Hero" scope="atrium" variant="hero" layout="grid" columns={2} gap={18}>
            <slot layout="column" gap={14}>
                <text role="eyebrow">NATIVE OWNER PATH</text>
                <text role="hero">Kain owns the runtime contract here. The smoke is source-first, the buttons change the shell mood, and the scene stays Kain-authored instead of living off a bundle example.</text>
                <text role="muted">{GenericSceneSmoke.active_mood}</text>
                <slot layout="row" gap={12}>
                    <panel scope="atrium" variant="card">
                        <text role="metric">{GenericSceneSmoke.active_backend}</text>
                        <text role="caption">active backend</text>
                    </panel>
                    <panel scope="atrium" variant="card">
                        <text role="metric">1</text>
                        <text role="caption">Kain-owned scene</text>
                    </panel>
                    <panel scope="atrium" variant="card">
                        <text role="metric">4</text>
                        <text role="caption">backend moods</text>
                    </panel>
                    <panel scope="atrium" variant="card">
                        <text role="metric">qt</text>
                        <text role="caption">compatibility host</text>
                    </panel>
                </slot>
                <panel scope="atrium" variant="card" title="Runtime Owner Note">
                    <text role="title">{GenericSceneSmoke.status_line}</text>
                    <text role="caption">{GenericSceneSmoke.active_focus}</text>
                    <text role="caption">The new 3D runtime should feel like authored product software, not a thin renderer demo.</text>
                </panel>
            </slot>
            <viewport3d title="Generic Scene" scene="geometry_fixture" />
        </panel>

        <panel title="Backend Switchboard" scope="atrium" variant="section" layout="grid" columns={4} gap={14}>
            <panel scope="atrium" variant="card">
                <text role="eyebrow">BGFX</text>
                <text role="title">Baseline lane</text>
                <text role="caption">{backend_state_label(GenericSceneSmoke.active_backend, "bgfx")}</text>
                <text role="caption">{backend_mood("bgfx")}</text>
            </panel>
            <panel scope="atrium" variant="card">
                <text role="eyebrow">FILAMENT</text>
                <text role="title">Premium lighting</text>
                <text role="caption">{backend_state_label(GenericSceneSmoke.active_backend, "filament")}</text>
                <text role="caption">{backend_mood("filament")}</text>
            </panel>
            <panel scope="atrium" variant="card">
                <text role="eyebrow">DILIGENT</text>
                <text role="title">Graph and compute</text>
                <text role="caption">{backend_state_label(GenericSceneSmoke.active_backend, "diligent")}</text>
                <text role="caption">{backend_mood("diligent")}</text>
            </panel>
            <panel scope="atrium" variant="card">
                <text role="eyebrow">THE FORGE</text>
                <text role="title">Low-level substrate</text>
                <text role="caption">{backend_state_label(GenericSceneSmoke.active_backend, "the-forge")}</text>
                <text role="caption">{backend_mood("the-forge")}</text>
            </panel>
        </panel>

        <panel title="Scene Geometry" scope="atrium" variant="section" layout="grid" columns={4} gap={14}>
            <panel scope="atrium" variant="card">
                <text role="eyebrow">STARTUP CUBE</text>
                <text role="title">Structural anchor</text>
                <text role="caption">The clean block primitive used for the central plinth and stable massing.</text>
            </panel>
            <panel scope="atrium" variant="card">
                <text role="eyebrow">STUDIO COLUMNS</text>
                <text role="title">Perimeter ring</text>
                <text role="caption">A repeating vertical system that gives the scene depth and rhythm.</text>
            </panel>
            <panel scope="atrium" variant="card">
                <text role="eyebrow">HERO HALO</text>
                <text role="title">Ambient accent</text>
                <text role="caption">A luminous ring around the center mass that keeps the scene feeling premium.</text>
            </panel>
            <panel scope="atrium" variant="card">
                <text role="eyebrow">CROWN SPAN</text>
                <text role="title">Roofline grid</text>
                <text role="caption">A lifted frame that keeps the scene readable as a scene instead of a cube room.</text>
            </panel>
        </panel>

        <panel title="Runtime Notes" scope="atrium" variant="section" layout="grid" columns={2} gap={16}>
            <panel scope="atrium" variant="card">
                <text role="title">Source-first smoke</text>
                <text role="caption">The launcher now includes smoke.kn directly, so the authored surface is the thing being booted rather than a generated runtime bundle example.</text>
            </panel>
            <panel scope="atrium" variant="card">
                <text role="title">Native owner profile</text>
                <text role="caption">geometry_fixture is authored scene data; the Windows native viewport owns only the neutral default_viewport fallback profile.</text>
            </panel>
        </panel>

        <panel title="Footer" scope="atrium" variant="nav" layout="row" gap={16}>
            <text role="caption">Kain native runtime smoke</text>
            <text role="caption">geometry_fixture</text>
            <text role="caption">native-owner metadata</text>
            <text role="caption">Qt compatibility host</text>
        </panel>
    </slot>

fn main() -> Int:
    return 0
