use rust::sculpt_foundry_backend

fn smoke_output(name: String) -> String:
    return "outputs/" + name

fn max_value(values: Any) -> Int:
    let best = values[0]
    let i = 1
    while i < len(values):
        if values[i] > best:
            best = values[i]
        i = i + 1
    return best

fn polyline_points(values: Any, width: Int, height: Int) -> String:
    let points = []
    let peak = max_value(values)
    let safe_peak = peak
    if safe_peak <= 0:
        safe_peak = 1
    let last = len(values) - 1
    let i = 0
    while i < len(values):
        let x = 0
        if last != 0:
            x = (i * width) / last
        let y = height - ((values[i] * height) / safe_peak)
        push(points, str(x) + "," + str(y))
        i = i + 1
    return join(points, " ")

fn graph_svg(values: Any) -> String:
    let points = polyline_points(values, 420, 110)
    let svg = "<svg viewBox='0 0 420 110' class='falloff-graph' role='img' aria-label='Brush falloff graph'>"
    let svg = svg + "<defs><linearGradient id='curveGradient' x1='0%' y1='0%' x2='100%' y2='0%'><stop offset='0%' stop-color='#f97316'/><stop offset='100%' stop-color='#22d3ee'/></linearGradient></defs>"
    let svg = svg + "<rect x='0' y='0' width='420' height='110' rx='16' fill='rgba(255,255,255,0.02)'/>"
    let svg = svg + "<path d='M0 92 H420' stroke='rgba(255,255,255,0.08)' stroke-width='1'/>"
    let svg = svg + "<polyline fill='none' stroke='url(#curveGradient)' stroke-width='4' stroke-linecap='round' stroke-linejoin='round' points='" + points + "'/>"
    let svg = svg + "</svg>"
    return svg

fn tool_chip(label: String, hotkey: String, active: Bool) -> String:
    let class_name = "tool-chip"
    if active:
        class_name = "tool-chip active"
    let html = "<button class='" + class_name + "'><span>" + label + "</span><span class='hotkey'>" + hotkey + "</span></button>"
    return html

fn layer_row(name: String, detail: String, active: Bool) -> String:
    let class_name = "layer-row"
    if active:
        class_name = "layer-row active"
    let html = "<div class='" + class_name + "'><div><p class='layer-name'>" + name + "</p><p class='layer-detail'>" + detail + "</p></div><div class='layer-flag'>LIVE</div></div>"
    return html

fn metric_card(title: String, value: String, detail: String, accent: String) -> String:
    let html = "<div class='metric-card'><p class='metric-title'>" + title + "</p><p class='metric-value' style='color:" + accent + "'>" + value + "</p><p class='metric-detail'>" + detail + "</p></div>"
    return html

fn history_row(label: String, detail: String) -> String:
    return "<div class='history-row'><span>" + label + "</span><span>" + detail + "</span></div>"

fn viewport_svg(signature: String) -> String:
    let svg = "<svg viewBox='0 0 860 520' class='viewport-svg' role='img' aria-label='Sculpt viewport prototype'>"
    let svg = svg + "<defs><radialGradient id='fog' cx='50%' cy='45%' r='70%'><stop offset='0%' stop-color='#2b4f7f'/><stop offset='65%' stop-color='#0f172a'/><stop offset='100%' stop-color='#070b14'/></radialGradient></defs>"
    let svg = svg + "<rect width='860' height='520' rx='26' fill='url(#fog)'/>"
    let svg = svg + "<g stroke='rgba(255,255,255,0.06)' stroke-width='1'>"
    let x = 80
    while x < 820:
        let svg = svg + "<path d='M" + str(x) + " 40 V480'/>"
        x = x + 70
    let y = 60
    while y < 480:
        let svg = svg + "<path d='M50 " + str(y) + " H810'/>"
        y = y + 60
    let svg = svg + "</g>"
    let svg = svg + "<g fill='none' stroke='rgba(120,201,255,0.24)' stroke-width='2'>"
    let svg = svg + "<ellipse cx='420' cy='250' rx='168' ry='188'/>"
    let svg = svg + "<ellipse cx='420' cy='250' rx='108' ry='150'/>"
    let svg = svg + "<path d='M318 108 C356 74, 484 76, 524 116 C560 152, 568 232, 550 322 C538 384, 492 430, 420 444 C348 430, 302 384, 290 322 C272 232, 280 150, 318 108Z'/>"
    let svg = svg + "<path d='M350 210 C378 184, 462 184, 490 210'/>"
    let svg = svg + "<path d='M365 276 C390 302, 450 302, 476 276'/>"
    let svg = svg + "<path d='M402 218 C398 254, 398 280, 414 300'/>"
    let svg = svg + "</g>"
    let svg = svg + "<g fill='rgba(255,255,255,0.16)'>"
    let svg = svg + "<circle cx='374' cy='224' r='8'/>"
    let svg = svg + "<circle cx='466' cy='224' r='8'/>"
    let svg = svg + "</g>"
    let svg = svg + "<circle id='cursor-glow' cx='562' cy='188' r='44' fill='rgba(56,189,248,0.10)' stroke='rgba(56,189,248,0.18)' stroke-width='1'/>"
    let svg = svg + "<circle id='brush-ring' cx='562' cy='188' r='112' fill='none' stroke='#f97316' stroke-width='3' stroke-dasharray='8 10'/>"
    let svg = svg + "<text x='56' y='74' fill='#d3ebff' font-size='12' letter-spacing='2'>SCULPT FOUNDRY // " + signature + "</text>"
    let svg = svg + "<text x='56' y='454' fill='#8aa9c7' font-size='13'>Viewport host target is still a future runtime lane. This prototype proves the authored frontend contract today.</text>"
    let svg = svg + "</svg>"
    return svg

fn build_html(curve: Any, forecast: Any, energy: Int, signature: String) -> String:
    let graph = graph_svg(curve)
    let viewport = viewport_svg(signature)
    let tools = []
    push(tools, tool_chip("Voxel Clay", "1", true))
    push(tools, tool_chip("Move", "2", false))
    push(tools, tool_chip("Smooth", "3", false))
    push(tools, tool_chip("Inflate", "4", false))
    push(tools, tool_chip("Trim", "5", false))
    push(tools, tool_chip("Mask", "M", false))
    push(tools, tool_chip("Transform", "T", false))

    let layers = []
    push(layers, layer_row("Primary Bust", str(forecast[0]) + " polys / live clay", true))
    push(layers, layer_row("Forms Blockout", "mirrored X / low frequency", false))
    push(layers, layer_row("Micro Damage", "alpha-driven / cavity polish", false))
    push(layers, layer_row("Hard Surface Plates", "trim + flatten stack", false))

    let metrics = []
    push(metrics, metric_card("Stroke Energy", str(energy), "Rust backend forecast for the current brush stack", "#f97316"))
    push(metrics, metric_card("Target Polycount", str(forecast[1]), "Adaptive topology target if refinement stays enabled", "#38bdf8"))
    push(metrics, metric_card("Memory Budget", str(forecast[2]) + " MB", "Estimated active sculpt layer footprint", "#a78bfa"))

    let history = []
    push(history, history_row("Clay buildup", "radius 68 / intensity 72"))
    push(history, history_row("Move silhouette", "normal space / x symmetry"))
    push(history, history_row("Trim cheek plane", "hardness 54 / alpha cone"))
    push(history, history_row("Pinch eyelid ridge", "detail 61 / dyn topo on"))

    let html = "<!doctype html>\n"
    let html = html + "<html lang='en'>\n<head>\n<meta charset='utf-8' />\n<meta name='viewport' content='width=device-width, initial-scale=1' />\n<title>Sculpt Foundry Prototype</title>\n"
    let html = html + "<style>\n"
    let html = html + ":root { color-scheme: dark; --bg-top: #101827; --bg-bottom: #060913; --panel: rgba(10, 16, 28, 0.88); --panel-soft: rgba(255,255,255,0.04); --line: rgba(148,163,184,0.18); --accent: #f97316; --accent-cool: #38bdf8; --text: #edf5ff; --muted: #8aa9c7; }\n"
    let html = html + "* { box-sizing: border-box; }\n"
    let html = html + "body { margin: 0; min-height: 100vh; background: radial-gradient(circle at top, var(--bg-top) 0%, var(--bg-bottom) 72%); color: var(--text); font-family: 'Space Grotesk', 'Segoe UI Variable', sans-serif; }\n"
    let html = html + ".app-shell { width: min(96vw, 1580px); margin: 22px auto; padding: 18px; border-radius: 30px; border: 1px solid rgba(255,255,255,0.10); background: rgba(5, 8, 16, 0.86); box-shadow: 0 40px 140px rgba(0,0,0,0.5); }\n"
    let html = html + ".topbar { display: flex; justify-content: space-between; align-items: center; gap: 18px; padding: 10px 14px 18px; }\n"
    let html = html + ".branding { display: flex; flex-direction: column; gap: 4px; }\n"
    let html = html + ".eyebrow { margin: 0; font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--accent-cool); }\n"
    let html = html + "h1 { margin: 0; font-size: 28px; letter-spacing: -0.03em; }\n"
    let html = html + ".sub { margin: 0; color: var(--muted); }\n"
    let html = html + ".actions { display: flex; gap: 10px; flex-wrap: wrap; }\n"
    let html = html + ".action { padding: 10px 14px; border-radius: 16px; border: 1px solid var(--line); background: rgba(255,255,255,0.03); color: var(--text); font: inherit; }\n"
    let html = html + ".workspace { display: grid; grid-template-columns: 280px minmax(0, 1fr) 330px; gap: 16px; }\n"
    let html = html + ".panel { border-radius: 24px; border: 1px solid var(--line); background: var(--panel); padding: 16px; }\n"
    let html = html + ".panel-title { margin: 0 0 14px; font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }\n"
    let html = html + ".tool-grid { display: grid; gap: 10px; }\n"
    let html = html + ".tool-chip { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; border-radius: 16px; border: 1px solid var(--line); background: rgba(255,255,255,0.02); color: var(--text); font: inherit; }\n"
    let html = html + ".tool-chip.active { border-color: rgba(249,115,22,0.55); background: rgba(249,115,22,0.10); box-shadow: inset 0 0 0 1px rgba(249,115,22,0.18); }\n"
    let html = html + ".hotkey { color: var(--muted); font-family: 'IBM Plex Mono', 'Consolas', monospace; }\n"
    let html = html + ".controls { display: grid; gap: 12px; margin-top: 14px; }\n"
    let html = html + ".control label { display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); margin-bottom: 6px; }\n"
    let html = html + ".control input { width: 100%; }\n"
    let html = html + ".viewport-shell { display: grid; gap: 14px; }\n"
    let html = html + ".viewport-svg { width: 100%; height: auto; display: block; border-radius: 24px; }\n"
    let html = html + ".metric-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n"
    let html = html + ".metric-card { padding: 14px; border-radius: 18px; background: var(--panel-soft); }\n"
    let html = html + ".metric-title { margin: 0 0 6px; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }\n"
    let html = html + ".metric-value { margin: 0 0 6px; font-size: 24px; font-weight: 700; }\n"
    let html = html + ".metric-detail { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.4; }\n"
    let html = html + ".falloff-graph { width: 100%; height: auto; display: block; }\n"
    let html = html + ".layer-stack, .history-stack { display: grid; gap: 10px; }\n"
    let html = html + ".layer-row, .history-row { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 16px; border: 1px solid var(--line); background: rgba(255,255,255,0.02); }\n"
    let html = html + ".layer-row.active { border-color: rgba(56,189,248,0.48); background: rgba(56,189,248,0.10); }\n"
    let html = html + ".layer-name { margin: 0 0 4px; font-weight: 600; }\n"
    let html = html + ".layer-detail, .history-row span:last-child { margin: 0; color: var(--muted); font-size: 12px; }\n"
    let html = html + ".layer-flag { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); }\n"
    let html = html + ".footer-strip { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; color: var(--muted); font-size: 13px; }\n"
    let html = html + "@media (max-width: 1200px) { .workspace { grid-template-columns: 1fr; } .metric-grid { grid-template-columns: 1fr; } }\n"
    let html = html + "</style>\n</head>\n<body>\n"
    let html = html + "<main class='app-shell'>\n"
    let html = html + "<header class='topbar'><div class='branding'><p class='eyebrow'>Kain Frontend / Rust Backend</p><h1>Sculpt Foundry Prototype</h1><p class='sub'>Kain owns the sculpt shell, tools, and workspace composition while a Rust crate feeds brush curves, stroke energy, and mesh forecasts.</p></div><div class='actions'><button class='action'>Import Mesh</button><button class='action'>Save Session</button><button class='action'>Export GLB</button><button class='action'>DynTopo Live</button></div></header>\n"
    let html = html + "<section class='workspace'>\n"
    let html = html + "<aside class='panel'><p class='panel-title'>Brush Rack</p><div class='tool-grid'>" + join(tools, "") + "</div><div class='controls'>"
    let html = html + "<div class='control'><label>Radius <span id='radius-value'>68</span></label><input id='radius' type='range' min='8' max='120' value='68' /></div>"
    let html = html + "<div class='control'><label>Intensity <span id='intensity-value'>72</span></label><input id='intensity' type='range' min='1' max='100' value='72' /></div>"
    let html = html + "<div class='control'><label>Hardness <span id='hardness-value'>54</span></label><input id='hardness' type='range' min='1' max='100' value='54' /></div>"
    let html = html + "</div><p class='panel-title' style='margin-top:18px'>Backend Curve</p>" + graph + "</aside>\n"
    let html = html + "<section class='panel viewport-shell'><p class='panel-title'>Viewport</p>" + viewport + "<div class='metric-grid'>" + join(metrics, "") + "</div><div class='footer-strip'><span>Active Tool: Voxel Clay</span><span>Symmetry: X</span><span>MatCap: Ice Clay</span><span>Signature: " + signature + "</span></div></section>\n"
    let html = html + "<aside class='panel'><p class='panel-title'>Scene Layers</p><div class='layer-stack'>" + join(layers, "") + "</div><p class='panel-title' style='margin-top:18px'>History</p><div class='history-stack'>" + join(history, "") + "</div><p class='panel-title' style='margin-top:18px'>Kernel Contract</p><div class='metric-card'><p class='metric-title'>Revision</p><p class='metric-value' style='color:#22d3ee'>" + str(SCULPT_FOUNDRY_REVISION) + "</p><p class='metric-detail'>Host-backed today. Strong frontend/backend split already, but direct native-ui crate calls still need a future runtime lane.</p></div></aside>\n"
    let html = html + "</section>\n"
    let html = html + "</main>\n"
    let html = html + "<script>\n"
    let html = html + "const radius = document.getElementById('radius'); const intensity = document.getElementById('intensity'); const hardness = document.getElementById('hardness');\n"
    let html = html + "const radiusValue = document.getElementById('radius-value'); const intensityValue = document.getElementById('intensity-value'); const hardnessValue = document.getElementById('hardness-value');\n"
    let html = html + "const brushRing = document.getElementById('brush-ring'); const cursorGlow = document.getElementById('cursor-glow');\n"
    let html = html + "function updatePreview() {\n"
    let html = html + "  const r = Number(radius.value); const i = Number(intensity.value); const h = Number(hardness.value);\n"
    let html = html + "  radiusValue.textContent = String(r); intensityValue.textContent = String(i); hardnessValue.textContent = String(h);\n"
    let html = html + "  brushRing.setAttribute('r', String(44 + r * 1.1)); brushRing.setAttribute('stroke-width', String(2 + h * 0.03));\n"
    let html = html + "  cursorGlow.setAttribute('r', String(20 + i * 0.48));\n"
    let html = html + "}\n"
    let html = html + "[radius, intensity, hardness].forEach((input) => input.addEventListener('input', updatePreview)); updatePreview();\n"
    let html = html + "</script>\n"
    let html = html + "</body>\n</html>\n"
    return html

fn int_array_json(values: Any) -> String:
    let parts = []
    let i = 0
    while i < len(values):
        push(parts, str(values[i]))
        i = i + 1
    return "[" + join(parts, ", ") + "]"

fn build_contract_json(curve: Any, forecast: Any, energy: Int, signature: String) -> String:
    let json = "{\n"
    let json = json + "  \"contract\": \"kain.sculpt.prototype\",\n"
    let json = json + "  \"revision\": " + str(SCULPT_FOUNDRY_REVISION) + ",\n"
    let json = json + "  \"tool\": \"Voxel Clay\",\n"
    let json = json + "  \"layer\": \"Primary Bust\",\n"
    let json = json + "  \"curve\": " + int_array_json(curve) + ",\n"
    let json = json + "  \"forecast\": " + int_array_json(forecast) + ",\n"
    let json = json + "  \"stroke_energy\": " + str(energy) + ",\n"
    let json = json + "  \"signature\": \"" + signature + "\"\n"
    let json = json + "}\n"
    return json

test sculpt_foundry_backend_contract:
    assert(SCULPT_FOUNDRY_REVISION == 1, "expected sculpt foundry revision")
    let curve = sculpt_brush_curve(68, 72, 54, 24)
    let forecast = sculpt_mesh_forecast(158000, 1, 61, 5)
    let energy = sculpt_stroke_energy(68, 72, 19, 1)
    let signature = sculpt_status_signature("VoxelClay", "PrimaryBust", energy, forecast[1])
    let html = build_html(curve, forecast, energy, signature)
    assert(len(curve) == 24, "expected brush curve sample count")
    assert(curve[0] > curve[len(curve) - 1], "expected brush curve falloff")
    assert(forecast[1] > forecast[0], "expected forecasted sculpt mesh to grow")
    assert(energy > 0, "expected positive stroke energy")
    assert(contains(html, "Sculpt Foundry Prototype"), "expected frontend title")
    assert(contains(html, "Viewport"), "expected viewport section")

fn main() -> String:
    let curve = sculpt_brush_curve(68, 72, 54, 24)
    let forecast = sculpt_mesh_forecast(158000, 1, 61, 5)
    let energy = sculpt_stroke_energy(68, 72, 19, 1)
    let signature = sculpt_status_signature("VoxelClay", "PrimaryBust", energy, forecast[1])
    let html = build_html(curve, forecast, energy, signature)
    let contract = build_contract_json(curve, forecast, energy, signature)

    let html_path = smoke_output("sculpt_foundry_prototype.html")
    let contract_path = smoke_output("sculpt_foundry_contract.json")
    let report_path = smoke_output("sculpt_foundry_report.txt")

    let report = "Sculpt Foundry Prototype\n"
    let report = report + "revision: " + str(SCULPT_FOUNDRY_REVISION) + "\n"
    let report = report + "stroke_energy: " + str(energy) + "\n"
    let report = report + "curve_peak: " + str(curve[0]) + "\n"
    let report = report + "forecast_current_polys: " + str(forecast[0]) + "\n"
    let report = report + "forecast_target_polys: " + str(forecast[1]) + "\n"
    let report = report + "forecast_memory_mb: " + str(forecast[2]) + "\n"
    let report = report + "signature: " + signature + "\n"
    let report = report + "frontend_role: Kain authored the sculpt suite chrome, viewport shell, layer rails, and tool semantics\n"
    let report = report + "backend_role: Rust crate produced brush falloff, stroke energy, mesh growth forecast, and backend signature\n"
    let report = report + "status: host-backed prototype ready; native viewport/runtime integration is the next lane, not the blocker for frontend authoring\n"

    write_file(html_path, html)
    write_file(contract_path, contract)
    write_file(report_path, report + "\n")
    println(report)
    return report
