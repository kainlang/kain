{
  "app_id": "sm64.fast3d.native.host.snapshot",
  "name": "SM64 Fast3D Native Host (snapshot)",
  "version": "0.1.0",
  "window_title": "SM64 Fast3D Native Host (snapshot)",
  "root_component": "App",
  "layout_id": "sm64_fast3d_native_host_snapshot_shell",
  "required_runtime_capabilities": [
    "compiler.typed-program",
    "driver.native-app-bundle",
    "memory.raw-ops",
    "memory.raw-pointers",
    "runtime.contract.bundle",
    "ui.components",
    "ui.runtime-bundle"
  ],
  "target_outputs": [
    "native-ui-bundle",
    "native-exe"
  ],
  "manifests": {
    "host_bridges": ""
  },
  "runtime_sidecars": {
    "runtime_bundle": "native_app_bundle.json",
    "runtime_contract": "kain_runtime_contract.json",
    "runtime_compatibility": "kain_runtime_compatibility.json",
    "realtime_bundle": "kain_realtime_app_bundle.json",
    "shader_bundle": null
  },
  "host_bridges": [],
  "host_sidecars": [
    {
      "packaged_file_name": "title_face_native_host_snapshot.json",
      "env_var": "KAIN_FAST3D_CONFIG"
    },
    {
      "packaged_file_name": "scene_manifest_title_face.json",
      "env_var": null
    }
  ]
}