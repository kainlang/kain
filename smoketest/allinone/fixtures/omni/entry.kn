struct OmniProbeSettings:
    amplitude: Float
    bias: Float

fn create_probe_settings() -> OmniProbeSettings:
    let settings = OmniProbeSettings()
    settings.amplitude = 0.65
    settings.bias = 0.2
    return settings

@blueprint
fn allinone_omni_probe(amplitude: Float, bias: Float) -> Float:
    let combined = amplitude + bias
    return clamp_float(combined, 0.0, 1.0)

shader compute AllInOneOmniShader(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer")
            ],
            [
                ("allinone_omni_shader", "copy_stream", ["src"], ["dst"], false)
            ]
        )

    let index = id.x
    let input_value = src[index]
    let output_value = input_value * 0.75
    dst[index] = output_value
    return vec4(output_value, input_value, 1.0 - output_value, 1.0)
