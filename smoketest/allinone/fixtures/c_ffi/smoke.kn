use c::allinone_beacon_math

fn smoke_output(name: String) -> String:
    return "../../outputs/c_ffi/" + name

fn signature_row(a: Int, b: Int, scale_factor: Float) -> String:
    let sum = beacon_add(a, b)
    let scaled = beacon_scale(sum, scale_factor)
    let even = beacon_is_even(sum)
    let label = beacon_label(sum)
    return label + " | sum=" + str(sum) + " | scaled=" + str(scaled) + " | even=" + str(even)

test c_ffi_runtime_bridge:
    assert(beacon_add(12, 30) == 42, "expected add bridge")
    assert(beacon_is_even(42), "expected even bridge")
    assert(beacon_scale(2, 4.0) == 8.0, "expected scale bridge")
    assert(beacon_label(9) == "beacon-9", "expected string bridge")

fn main() -> String:
    let signature_path = smoke_output("beacon_signature.txt")
    let report_path = smoke_output("beacon_report.txt")

    let signature = ""
    let signature = signature + signature_row(12, 30, 1.5) + "\n"
    let signature = signature + signature_row(6, 7, 2.0) + "\n"
    let signature = signature + signature_row(3, 5, 3.0) + "\n"

    write_file(signature_path, signature)

    let checksum = beacon_add(beacon_add(12, 30), beacon_add(6, 7))
    let report = "C ABI FFI smoke\n"
    let report = report + "signature_path: " + signature_path + "\n"
    let report = report + "checksum: " + str(checksum) + "\n"
    let report = report + "beacon_42: " + beacon_label(42) + "\n"
    let report = report + "scaled_7: " + str(beacon_scale(7, 1.25)) + "\n"
    let report = report + "cache_hint: .kain/cache/c_ffi\n"
    let report = report + "unsupported_hint: native/beacon_math.h contains pointer-heavy declarations by design\n"

    write_file(report_path, report + "\n")
    println(report)
    return report
