component App():
    render <panel title="Workbench" layout="dock" persistent_layout_id="ui_shell">
        <panel title="Hierarchy" dock="left" split_ratio={0.24} width="24%" min_width={220} max_width={320} resizable={true}>
            <tree title="Scene Tree">
                <text role="caption">Docked left rail with width constraints.</text>
            </tree>
        </panel>
        <panel title="Viewport" dock="center" flex_grow={1} overflow="hidden">
            <viewport3d title="Main View" scene="luminous_port" />
        </panel>
        <panel title="Timeline" dock="bottom" split_ratio={0.28} min_height={180} max_height={320} resizable={true}>
            <timeline title="Sequencer">
                <text role="caption">Bottom rail tests dock placement and vertical constraints.</text>
            </timeline>
        </panel>
    </panel>
