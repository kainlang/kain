component App():
    render <slot>
        <theme name="forge">
            <scope name="app_shell" selector="app-shell" />
            <token name="surface.background" category="color" value="#101418" />
            <token name="text.default" category="color" value="#f3f5f7" />
            <variant scope="app_shell" name="hero">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="accent.color" category="color" value="#4dd0e1" />
            </variant>
            <widget kind="panel" scope="app_shell" variant="hero">
                <token name="density" category="layout" value="compact" />
                <token name="surface.padding" category="space" value={14} />
            </widget>
            <textvariant scope="app_shell" name="hero">
                <token name="body.size" category="type" value={30} />
            </textvariant>
        </theme>
        <panel title="Theme Authoring Shell" scope="app_shell" variant="hero" class="dense accent">
            <text role="hero">Compiler-owned theme registry</text>
            <text role="caption">Smoke proves theme blocks, widget maps, and text roles lower canonically.</text>
            <inspector title="Selection" variant="hero">
                <text role="metric">3 authored scopes</text>
                <text role="muted">Theme directives are stripped from the visible tree.</text>
            </inspector>
        </panel>
    </slot>
