use std::runtime
use std::crypto

pub fn smoke_crypto_lane() -> Int:
    let sha = sha256("kain-smoke")
    if len(sha) != 64:
        return 1
    let hmac = hmac_sha256("smoke-key", "smoke-payload")
    if len(hmac) != 64:
        return 2
    let b3 = blake3("kain-smoke")
    if len(b3) != 64:
        return 3
    let rand_hex = random_bytes_hex(16)
    if len(rand_hex) != 32:
        return 4
    return 0
