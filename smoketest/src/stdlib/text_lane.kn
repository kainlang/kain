use std::runtime
use std::text

pub fn smoke_text_lane() -> Int:
    let trimmed = text_trim("  smoke-text  ")
    let view = text_slice("hello-kain-smoke", 6, 10)
    let found = text_find(trimmed, "smoke")
    let materialized = text_materialize(view)
    if text_len(trimmed) != 10:
        return 1
    if found < 0:
        return 2
    if len(materialized) != 4:
        return 3
    return 0
