use std::z3
use std::proof
use std::test

pub fn smoke_z3_lane() -> Int:
    if z3_available() == false:
        return 0

    if z3_version() == "":
        return 1

    let ints = z3_solver()
    let x = z3_int("x")
    let y = z3_int("y")

    z3_solver_add(ints, [
        z3_expr_ge(x, z3_int_val(0)),
        z3_expr_ge(y, z3_int_val(0)),
        z3_expr_eq(z3_sum([x, y]), z3_int_val(7)),
        z3_distinct([x, y])
    ])

    let sat_test = test_assert_sat("smoke.z3.integer_route", ints)
    if test_outcome_ok(sat_test) == false:
        return 2

    let model = z3_solver_model(ints)
    let x_value = z3_as_long(z3_model_eval(model, x))
    let y_value = z3_as_long(z3_model_eval(model, y))
    if x_value < 0 or y_value < 0:
        return 3
    if x_value + y_value != 7:
        return 4
    if x_value == y_value:
        return 5

    z3_solver_push(ints)
    z3_solver_add(ints, [
        z3_expr_eq(x, z3_int_val(1)),
        z3_expr_eq(y, z3_int_val(1))
    ])
    let unsat_test = test_assert_unsat("smoke.z3.integer_conflict", ints)
    if test_outcome_ok(unsat_test) == false:
        return 6
    z3_solver_pop(ints, 1)

    let stable = proof_check("smoke.z3.integer_resume", ints)
    if proof_outcome_is_witness(stable) == false:
        return 7

    let bits = z3_solver()
    let lane = z3_bitvec("lane", 8)
    z3_solver_add(bits, [
        z3_expr_eq(z3_expr_add(lane, z3_bitvec_val(1, 8)), z3_bitvec_val(5, 8))
    ])
    let bit_test = test_assert_sat("smoke.z3.bitvec_lane", bits)
    if test_outcome_ok(bit_test) == false:
        return 8

    let bit_model = z3_solver_model(bits)
    let lane_value = z3_as_long(z3_model_eval(bit_model, lane))
    if lane_value != 4:
        return 9

    return 0
