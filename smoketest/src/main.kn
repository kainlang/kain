    let ended_collections = now_millis()
    composition_checksum = smoke_record_track(mode, "stdlib", "stdlib.collections_lane", "collections", 23, 2300, lane_collections, started_collections, ended_collections, composition_checksum)
    let e_collections = smoke_first_error(2300, lane_collections)
    if e_collections != 0:
