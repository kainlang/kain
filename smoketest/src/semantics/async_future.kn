use std::runtime

fn smoke_ready_value() -> impl Future<Int>:
    return async 42

fn smoke_ready_string() -> impl Future<String>:
    return async "smoke-async"

pub fn smoke_async_lane() -> Int:
    let int_value: Int = await smoke_ready_value()
    let str_value: String = await smoke_ready_string()
    if int_value != 42:
        return 1
    if str_value != "smoke-async":
        return 2
    return 0
