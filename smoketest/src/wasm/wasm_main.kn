fn wasm_add(a: Int, b: Int) -> Int:
    return a + b

fn wasm_factorial(n: Int) -> Int:
    if n <= 1:
        return 1
    return n * wasm_factorial(n - 1)

fn wasm_fibonacci(n: Int) -> Int:
    if n <= 0:
        return 0
    if n == 1:
        return 1
    var a: Int = 0
    var b: Int = 1
    var i: Int = 2
    while i <= n:
        let temp: Int = a + b
        a = b
        b = temp
        i = i + 1
    return b

fn main() -> Int:
    let sum = wasm_add(17, 25)
    if sum != 42:
        return 1
    let fact = wasm_factorial(5)
    if fact != 120:
        return 2
    let fib = wasm_fibonacci(10)
    if fib != 55:
        return 3
    return 0
