// Stream BRAVO — GPU Barrier Inference Smoke Test
// Verifies that the orchestrate barrier inference infrastructure compiles
// and produces correct barrier metadata for typical multi-stage GPU pipelines.
//
// Run: `kain check X:\smoketest\gpu_barrier_infer.kn --json`

use std::runtime

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    // Simple compute → compute pipeline with write→read dependency.
    // This exercises the access_map collection and barrier inference
    // without requiring actual GPU hardware.

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown

    return 0
