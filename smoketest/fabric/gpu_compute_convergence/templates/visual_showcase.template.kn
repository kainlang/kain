component App():
    render <slot>
        <theme name="fabric_editor_showcase">
            <scope name="studio" selector="fabric-studio" />
            <token name="theme.chrome.topbar.visible" category="chrome" value={false} />
            <token name="theme.spacing.scale" category="space" value={1.02} />
            <token name="theme.radius.scale" category="surface" value={1.06} />
            <token name="theme.typography.scale" category="type" value={1.02} />
            <token name="theme.background.top" category="color" value="#050913" />
            <token name="theme.background.bottom" category="color" value="#0a1427" />
            <token name="theme.surface.base" category="color" value="#0d1628" />
            <token name="theme.surface.alt" category="color" value="#101d33" />
            <token name="theme.surface.raised" category="color" value="#142440" />
            <token name="theme.surface.overlay" category="color" value="#091120f2" />
            <token name="theme.outline.soft" category="color" value="#1c3356" />
            <token name="theme.outline.bright" category="color" value="__ACCENT_PRIMARY__" />
            <token name="theme.accent.primary" category="color" value="__ACCENT_PRIMARY__" />
            <token name="theme.accent.soft" category="color" value="__ACCENT_SOFT__" />
            <token name="theme.highlight" category="color" value="__HIGHLIGHT__" />
            <token name="theme.text.default" category="color" value="#f3f8ff" />
            <token name="theme.text.muted" category="color" value="#94aac6" />
            <token name="widget.panel.surface.mode" category="surface" value="glass" />
            <token name="widget.inspector.surface.mode" category="surface" value="layered" />
            <token name="widget.tree.surface.mode" category="surface" value="flat" />
            <token name="widget.graph.surface.mode" category="surface" value="canvas" />
            <token name="widget.timeline.surface.mode" category="surface" value="canvas" />
            <token name="widget.viewport3d.surface.mode" category="surface" value="canvas" />
            <variant scope="studio" name="shell_root">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={6} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="studio" name="activity">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={10} />
            </variant>
            <variant scope="studio" name="sidebar">
                <token name="surface.mode" category="surface" value="layered" />
                <token name="surface.padding" category="space" value={12} />
            </variant>
            <variant scope="studio" name="editor">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={14} />
            </variant>
            <variant scope="studio" name="inspector">
                <token name="surface.mode" category="surface" value="layered" />
                <token name="surface.padding" category="space" value={12} />
            </variant>
            <variant scope="studio" name="terminal">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={12} />
            </variant>
            <variant scope="studio" name="metric">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={12} />
            </variant>
            <widget kind="panel" scope="studio" variant="activity">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="studio" variant="sidebar">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="studio" variant="editor">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="studio" variant="inspector">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="studio" variant="terminal">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="studio" variant="metric">
                <token name="density" category="layout" value="compact" />
            </widget>
            <textvariant scope="studio" name="hero">
                <token name="body.size" category="type" value={28} />
            </textvariant>
        </theme>

        <panel title="Fabric Studio" scope="studio" variant="shell_root" layout="dock" persistent_layout_id="fabric_gpu_editor_showcase" gap={12} padding={12}>
            <panel title="Activity Rail" scope="studio" variant="activity" dock="left" split_ratio={0.05} min_width={72} max_width={90} resizable={true} layout="column" gap={10}>
                <text role="eyebrow">STUDIO</text>
                <panel scope="studio" variant="metric"><text role="title">EXPL</text></panel>
                <panel scope="studio" variant="metric"><text role="title">SEARCH</text></panel>
                <panel scope="studio" variant="metric"><text role="title">FAB</text></panel>
                <panel scope="studio" variant="metric"><text role="title">GPU</text></panel>
                <panel scope="studio" variant="metric"><text role="title">NODE</text></panel>
            </panel>

            <panel title="Explorer" scope="studio" variant="sidebar" dock="left" split_ratio={0.20} min_width={250} max_width={360} resizable={true} layout="column" gap={12}>
                <panel title="Workspace" scope="studio" variant="metric" layout="column" gap={6}>
                    <text role="eyebrow">FABRIC WORKSPACE</text>
                    <text role="title">gpu_compute_convergence</text>
                    <text role="caption">Session __SESSION_ID__</text>
                    <text role="caption">Status __SESSION_STATUS__</text>
                </panel>
                <tree title="Pipeline Files">
                    smoketest/fabric/gpu_compute_convergence/
                    KAIN.fabric.toml
                    scripts/python_step.py
                    src/main.kn
                    shaders/gpu_step.kn
                    scripts/node_step.mjs
                    generated/main.generated.kn
                    generated/visual_snapshot.json
                    visual-native-app/fabric-studio-3d-editor.exe
                </tree>
                <tree title="Runtime Lanes">
                    python_source
                    kain_orchestrator
                    gpu_enrich
                    node_packager
                    runtime mix __RUNTIME_COUNTS__
                </tree>
                <tree title="Artifacts">
                    __REPORT_FILE__
                    __EVENTS_FILE__
                    __LOCK_FILE__
                </tree>
            </panel>

            <panel title="Inspector" scope="studio" variant="inspector" dock="right" split_ratio={0.22} min_width={280} max_width={380} resizable={true} layout="column" gap={12}>
                <inspector title="Selection">
                    Fabric session
                    __SESSION_ID__
                    runtime lanes converged
                    duration __DURATION_MS__ ms
                    summary __SUMMARY_INLINE__
                </inspector>
                <inspector title="Node Verdict">
                    __SUMMARY_CAPTION__
                </inspector>
                <inspector title="GPU Signature">
                    signature __GPU_SIGNATURE__
                    bytes __GPU_BYTE_LENGTH__
                    kain report __KAIN_REPORT__
                </inspector>
                <inspector title="Build Artifact">
                    __EXECUTABLE_HINT__
                    release-ready native UI bundle
                    report-driven generated source
                </inspector>
            </panel>

            <panel title="Output" scope="studio" variant="terminal" dock="bottom" split_ratio={0.24} min_height={190} max_height={320} resizable={true} layout="row" gap={12}>
                <panel title="Fabric Console" scope="studio" variant="metric" layout="column" gap={6}>
                    <text role="eyebrow">TERMINAL</text>
                    <text role="caption">python_source succeeded</text>
                    <text role="caption">kain_orchestrator succeeded</text>
                    <text role="caption">gpu_enrich succeeded</text>
                    <text role="caption">node_packager succeeded</text>
                    <text role="caption">proof __SUMMARY_CAPTION__</text>
                </panel>
                <timeline title="Session Timeline">
                    <text role="caption">report __REPORT_FILE__</text>
                    <text role="caption">events __EVENTS_FILE__</text>
                    <text role="caption">lock __LOCK_FILE__</text>
                    <text role="caption">workspace __WORKSPACE_ROOT__</text>
                </timeline>
                <panel title="Lane Status" scope="studio" variant="metric" layout="grid" columns={2} gap={10}>
__STEP_CARDS__
                </panel>
            </panel>

            <panel title="Viewport" scope="studio" variant="editor" dock="center" tab_group_id="editor-tabs" tab_label="Viewport" tab_order={0} tab_default_active={true} layout="column" gap={12}>
                <panel title="Editor Header" scope="studio" variant="metric" layout="row" gap={12}>
                    <panel scope="studio" variant="metric"><text role="title">4/4</text><text role="caption">lanes green</text></panel>
                    <panel scope="studio" variant="metric"><text role="title">__DURATION_MS__ ms</text><text role="caption">session duration</text></panel>
                    <panel scope="studio" variant="metric"><text role="title">__GPU_BYTE_LENGTH__</text><text role="caption">GPU bytes</text></panel>
                    <panel scope="studio" variant="metric"><text role="title">__SESSION_STATUS__</text><text role="caption">fabric status</text></panel>
                </panel>
                <viewport3d title="Fabric Studio Viewport" scene="magma_terraces" />
                <panel title="Viewport Footer" scope="studio" variant="metric" layout="row" gap={10}>
                    <text role="caption">Scene magma_terraces</text>
                    <text role="caption">Fabric summary __SUMMARY_INLINE__</text>
                    <text role="caption">GPU signature __GPU_SIGNATURE__</text>
                </panel>
            </panel>

            <panel title="Fabric Graph" scope="studio" variant="editor" dock="center" tab_group_id="editor-tabs" tab_label="Fabric Graph" tab_order={1} tab_closable={true} layout="column" gap={12}>
                <panel title="Mission Control" scope="studio" variant="metric" layout="column" gap={8}>
                    <text role="eyebrow">LOCAL-FIRST FABRIC</text>
                    <text role="hero" variant="hero">__HERO_TITLE__</text>
                    <text role="muted">__HERO_SUBTITLE__</text>
                </panel>
                <panel title="Execution Topology" scope="studio" variant="metric" layout="grid" columns={4} gap={10}>
__STEP_CARDS__
                </panel>
                <panel title="Signal Deck" layout="row" gap={12}>
                    <graph title="Runtime Mix">
                        <text role="caption">__RUNTIME_COUNTS__</text>
                    </graph>
                    <graph title="Proof Signature">
                        <text role="caption">__GPU_SIGNATURE__</text>
                    </graph>
                    <graph title="Node Summary">
                        <text role="caption">__SUMMARY_CAPTION__</text>
                    </graph>
                </panel>
            </panel>

            <panel title="Scene Data" scope="studio" variant="editor" dock="center" tab_group_id="editor-tabs" tab_label="Scene Data" tab_order={2} tab_closable={true} layout="row" gap={12}>
                <panel title="Scene Graph" scope="studio" variant="metric" layout="column" gap={8}>
                    <tree title="Scene Graph">
                        world_root
                        environment
                        magma_terraces
                        camera_rig
                        fabric_overlay
                        runtime_badges
                        session_trace
                    </tree>
                </panel>
                <panel title="Asset Browser" scope="studio" variant="metric" layout="column" gap={8}>
                    <tree title="Asset Browser">
                        reports/report.json
                        reports/events.jsonl
                        reports/session.lock.json
                        generated/main.generated.kn
                        visual-native-app/native_app_bundle.json
                        visual-native-app/kain_gpu_runtime.dll
                    </tree>
                </panel>
                <panel title="Properties" scope="studio" variant="metric" layout="column" gap={8}>
                    <inspector title="Fabric Session Properties">
                        session __SESSION_ID__
                        status __SESSION_STATUS__
                        report __REPORT_FILE__
                        summary __SUMMARY_INLINE__
                    </inspector>
                </panel>
            </panel>
        </panel>
    </slot>
