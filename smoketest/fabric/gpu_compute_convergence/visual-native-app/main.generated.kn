component App():
    render <slot>
        <theme name="fabric_viewport_showcase">
            <scope name="studio" selector="fabric-studio" />
            <token name="theme.chrome.topbar.visible" category="chrome" value={false} />
            <token name="theme.spacing.scale" category="space" value={0.92} />
            <token name="theme.radius.scale" category="surface" value={1.12} />
            <token name="theme.background.top" category="color" value="#040913" />
            <token name="theme.background.bottom" category="color" value="#091321" />
            <token name="theme.surface.base" category="color" value="#07111d" />
            <token name="theme.surface.alt" category="color" value="#0b1828" />
            <token name="theme.surface.overlay" category="color" value="#08121ee6" />
            <token name="theme.accent.primary" category="color" value="#469cd8" />
            <token name="theme.accent.soft" category="color" value="#a2e0f4" />
            <token name="theme.highlight" category="color" value="#ffc860" />
            <token name="theme.text.default" category="color" value="#eef6ff" />
            <token name="theme.text.muted" category="color" value="#8fa7c5" />
            <token name="widget.panel.surface.mode" category="surface" value="glass" />
            <token name="widget.viewport3d.surface.mode" category="surface" value="canvas" />

            <variant scope="studio" name="shell_root">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={6} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="studio" name="hud">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={6} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="studio" name="status">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={8} />
                <token name="title.visible" category="state" value={false} />
            </variant>

            <widget kind="panel" scope="studio" variant="hud">
                <token name="density" category="layout" value="compact" />
            </widget>
            <widget kind="panel" scope="studio" variant="status">
                <token name="density" category="layout" value="compact" />
            </widget>
        </theme>

        <panel title="Fabric Viewport" scope="studio" variant="shell_root" layout="column" gap={8} padding={8}>
            <panel scope="studio" variant="hud" layout="row" gap={18}>
                <panel scope="studio" variant="hud" layout="column" gap={2}>
                    <text role="eyebrow">FABRIC GPU PROOF</text>
                    <text role="title">magma_terraces</text>
                    <text role="caption">Final node proof: gpu-fabric-convergence:1:1:7|gpu=1,2,3,4,0,0,0,0|bytes=32</text>
                </panel>
                <panel scope="studio" variant="hud" layout="column" gap={2}>
                    <text role="eyebrow">SESSION</text>
                    <text role="caption">session-1774571647172-94732</text>
                    <text role="caption">SUCCEEDED in 727 ms</text>
                </panel>
                <panel scope="studio" variant="hud" layout="column" gap={2}>
                    <text role="eyebrow">RUNTIME MIX</text>
                    <text role="caption">python=1 | kain=1 | gpu_compute=1 | node=1</text>
                    <text role="caption">gpu bytes 32</text>
                </panel>
            </panel>

            <viewport3d title="Fabric Studio Viewport" scene="magma_terraces" />

            <panel scope="studio" variant="status" layout="row" gap={16}>
                <text role="caption">scene magma_terraces</text>
                <text role="caption">summary gpu-fabric-convergence:1:1:7 | gpu=1,2,3,4,0,0,0,0 | bytes=32</text>
                <text role="caption">gpu signature 1,2,3,4,0,0,0,0</text>
                <text role="caption">artifact smoketest/fabric/gpu_compute_convergence/visual-native-app</text>
            </panel>
        </panel>
    </slot>
