shader fragment EditorHeroSurface(uv: Vec2) -> Vec4:
    let centered_x = uv.x - 0.5
    let centered_y = uv.y - 0.5
    let radius = sqrt(centered_x * centered_x + centered_y * centered_y)
    let horizon = clamp(1.0 - abs(uv.y - 0.42) * 4.8, 0.0, 1.0)
    let sweep = sin(uv.x * 14.0 + uv.y * 5.0) * 0.5 + 0.5
    let aurora = sin(uv.y * 28.0 - uv.x * 7.0) * 0.5 + 0.5
    let orb_a = clamp(1.0 - sqrt((uv.x - 0.24) * (uv.x - 0.24) + (uv.y - 0.30) * (uv.y - 0.30)) * 5.0, 0.0, 1.0)
    let orb_b = clamp(1.0 - sqrt((uv.x - 0.78) * (uv.x - 0.78) + (uv.y - 0.62) * (uv.y - 0.62)) * 4.8, 0.0, 1.0)
    let scan = clamp(1.0 - abs(fract(uv.y * 24.0) - 0.5) * 11.0, 0.0, 1.0) * 0.05
    let grid_x = clamp(1.0 - abs(fract(uv.x * 15.0) - 0.5) * 20.0, 0.0, 1.0) * 0.04
    let grid_y = clamp(1.0 - abs(fract(uv.y * 10.0) - 0.5) * 20.0, 0.0, 1.0) * 0.03
    let edge_glow = clamp(1.0 - radius * 1.35, 0.0, 1.0)

    let base_r = 0.04 + horizon * 0.08 + sweep * 0.03
    let base_g = 0.07 + horizon * 0.14 + aurora * 0.05
    let base_b = 0.11 + horizon * 0.26 + sweep * 0.10

    let light_r = orb_a * 0.16 + orb_b * 0.07 + edge_glow * 0.05
    let light_g = orb_a * 0.10 + orb_b * 0.22 + edge_glow * 0.07
    let light_b = orb_a * 0.18 + orb_b * 0.30 + edge_glow * 0.10

    let final_r = base_r + light_r + scan + grid_x
    let final_g = base_g + light_g + scan + grid_x + grid_y
    let final_b = base_b + light_b + scan * 1.5 + grid_y

    return vec4(final_r, final_g, final_b, 1.0)

component App():
