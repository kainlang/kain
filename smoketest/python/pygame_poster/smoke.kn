use std::python::bridge
use std::python::pygame
use std::dcc::image

fn smoke_root() -> String:
    return "M:/Code/Kain/smoketest/python/pygame_poster"

fn smoke_output(name: String) -> String:
    return smoke_root() + "/outputs/" + name

fn install_pygame_kernel():
    py_pygame_set_dummy_video_driver()
    py_bridge_exec("import math\nimport os\nimport numpy as np\nimport pygame\n\ndef kain_pygame_rgba(width, height):\n    pygame.init()\n    surface = pygame.Surface((width, height), pygame.SRCALPHA, 32)\n    for y in range(height):\n        t = y / max(height - 1, 1)\n        color = (\n            int(20 + 80 * t),\n            int(30 + 120 * (1.0 - t)),\n            int(90 + 120 * math.sin(t * math.pi * 0.5)),\n            255,\n        )\n        pygame.draw.line(surface, color, (0, y), (width, y))\n    center = (width // 2, height // 2)\n    for i in range(28):\n        angle = i * (math.pi / 14.0)\n        radius = min(width, height) * (0.18 + 0.015 * i)\n        x = int(center[0] + math.cos(angle) * radius)\n        y = int(center[1] + math.sin(angle) * radius)\n        pygame.draw.line(surface, (255, 220 - i * 4, 120 + i * 3, 180), center, (x, y), 3)\n    pygame.draw.circle(surface, (255, 120, 70, 235), center, int(min(width, height) * 0.16))\n    pygame.draw.circle(surface, (255, 250, 240, 255), center, int(min(width, height) * 0.06))\n    points = []\n    for i in range(7):\n        angle = -math.pi * 0.5 + i * (2.0 * math.pi / 7.0)\n        radius = min(width, height) * (0.32 if i % 2 == 0 else 0.12)\n        points.append((int(center[0] + math.cos(angle) * radius), int(center[1] + math.sin(angle) * radius)))\n    pygame.draw.polygon(surface, (50, 10, 20, 70), points)\n    font = pygame.font.SysFont('consolas', 28, bold=True)\n    text = font.render('KAIN x PYGAME', True, (245, 245, 255))\n    surface.blit(text, (18, 18))\n    rgb = pygame.surfarray.array3d(surface).swapaxes(0, 1).copy()\n    alpha = pygame.surfarray.array_alpha(surface).T.copy()\n    return np.dstack([rgb, alpha]).astype(np.uint8)\n\ndef kain_pygame_save_rgba(rgba, path):\n    pygame.init()\n    rgba = np.ascontiguousarray(rgba, dtype=np.uint8)\n    surface = pygame.image.frombuffer(rgba.tobytes(), (rgba.shape[1], rgba.shape[0]), 'RGBA')\n    pygame.image.save(surface, path)\n    return {'path': path, 'bytes': os.path.getsize(path), 'width': int(rgba.shape[1]), 'height': int(rgba.shape[0])}\n")

fn rgba_to_ppm(native_image, width: Int, height: Int) -> String:
    let ppm = "P3\n" + str(width) + " " + str(height) + "\n255\n"
    let y = 0
    while y < height:
        let x = 0
        while x < width:
            let px = dcc_image_pixel_at(native_image, x, y)
            ppm = ppm + str(px[0]) + " " + str(px[1]) + " " + str(px[2]) + " "
            x = x + 1
        ppm = ppm + "\n"
        y = y + 1
    return ppm

test pygame_pipeline:
    install_pygame_kernel()
    assert(py_pygame_available(), "pygame must be installed for this smoke test")
    let rgba = py_bridge_call_raw("kain_pygame_rgba", [384, 216])
    let native_image = dcc_image_from_python_owned(rgba)
    let info = dcc_image_info(native_image)
    assert(info.width == 384, "expected poster width")
    assert(info.height == 216, "expected poster height")
    assert(info.ownership == "owned", "expected owned image backing")
    dcc_image_set_pixel(native_image, 192, 108, [255, 255, 255, 255])
    dcc_image_set_pixel(native_image, 193, 108, [255, 90, 40, 255])
    let save_info = py_bridge_call("kain_pygame_save_rgba", [py_pygame_from_image(native_image), smoke_output("pygame_poster_mutated.png")])
    assert(file_exists(smoke_output("pygame_poster_mutated.png")), "expected pygame output image")
    assert(save_info.bytes > 2000, "expected non-trivial png output")

fn main() -> String:
    install_pygame_kernel()
    assert(py_pygame_available(), "pygame must be installed for this smoke test")

    let width = 384
    let height = 216
    let base_rgba = py_bridge_call_raw("kain_pygame_rgba", [width, height])
    let base_path = smoke_output("pygame_poster.png")
    let mutated_path = smoke_output("pygame_poster_mutated.png")
    let ppm_path = smoke_output("pygame_poster_preview.ppm")
    let report_path = smoke_output("pygame_report.txt")

    let base_info = py_bridge_call("kain_pygame_save_rgba", [base_rgba, base_path])
    let native_image = dcc_image_from_python_owned(base_rgba)
    let image_info = dcc_image_info(native_image)
    let center_before = dcc_image_pixel_at(native_image, width / 2, height / 2)

    let i = 0
    while i < width:
        let y = (i * height) / width
        dcc_image_set_pixel(native_image, i, y, [255, 255, 255, 255])
        i = i + 1

    let j = 0
    while j < height:
        dcc_image_set_pixel(native_image, width / 2, j, [255, 120, 40, 255])
        j = j + 1

    let mutated_info = py_bridge_call("kain_pygame_save_rgba", [py_pygame_from_image(native_image), mutated_path])
    write_file(ppm_path, rgba_to_ppm(native_image, width, height))

    let center_after = dcc_image_pixel_at(native_image, width / 2, height / 2)
    let report = "Pygame poster smoke\n"
    let report = report + "width: " + str(image_info.width) + "\n"
    let report = report + "height: " + str(image_info.height) + "\n"
    let report = report + "ownership: " + str(image_info.ownership) + "\n"
    let report = report + "base_bytes: " + str(base_info.bytes) + "\n"
    let report = report + "mutated_bytes: " + str(mutated_info.bytes) + "\n"
    let report = report + "center_before: " + str(center_before) + "\n"
    let report = report + "center_after: " + str(center_after) + "\n"
    let report = report + "base_path: " + base_path + "\n"
    let report = report + "mutated_path: " + mutated_path + "\n"
    let report = report + "preview_path: " + ppm_path
    write_file(report_path, report + "\n")
    println(report)
    return report
