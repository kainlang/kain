use std::javascript::bridge
use std::javascript::web
use rust::cargo_node_weave

fn smoke_output(name: String) -> String:
    return "outputs/" + name

fn build_svg(width: Int, height: Int, phase: Int) -> String:
    let bands = signal_bands(4, phase)
    let beacons = beacon_pairs(width, height, phase)
    let svg = "<svg viewBox='0 0 " + str(width) + " " + str(height) + "' xmlns='http://www.w3.org/2000/svg'>"
    let svg = svg + "<rect width='" + str(width) + "' height='" + str(height) + "' rx='28' fill='black' />"
    let svg = svg + "<rect x='80' y='" + str(height - 80 - bands[0] * 4) + "' width='28' height='" + str(bands[0] * 4) + "' rx='14' fill='cyan' opacity='0.78' />"
    let svg = svg + "<rect x='136' y='" + str(height - 80 - bands[1] * 4) + "' width='28' height='" + str(bands[1] * 4) + "' rx='14' fill='gold' opacity='0.78' />"
    let svg = svg + "<rect x='192' y='" + str(height - 80 - bands[2] * 4) + "' width='28' height='" + str(bands[2] * 4) + "' rx='14' fill='cyan' opacity='0.78' />"
    let svg = svg + "<rect x='248' y='" + str(height - 80 - bands[3] * 4) + "' width='28' height='" + str(bands[3] * 4) + "' rx='14' fill='gold' opacity='0.78' />"
    let svg = svg + "<circle cx='" + str(beacons[0]) + "' cy='" + str(beacons[1]) + "' r='6' fill='white' opacity='0.95' />"
    let svg = svg + "<circle cx='" + str(beacons[2]) + "' cy='" + str(beacons[3]) + "' r='6' fill='white' opacity='0.95' />"
    let svg = svg + "<circle cx='" + str(beacons[4]) + "' cy='" + str(beacons[5]) + "' r='6' fill='white' opacity='0.95' />"
    let svg = svg + "<text x='64' y='64' fill='gold' font-size='24' font-family='Consolas, monospace'>signal workbench</text>"
    let svg = svg + "<text x='64' y='92' fill='silver' font-size='14' font-family='Consolas, monospace'>phase " + str(phase) + "</text>"
    let svg = svg + "</svg>"
    return svg

test cargo_node_signal_workbench:
    let helper = js_bridge_import("./helpers/payload_studio.mjs")
    let phase = workbench_stamp_orbit(4, 8)
    assert(CARGO_NODE_REVISION == 5, "expected cargo node revision")
    assert(phase == 43, "expected cargo stamp orbit result")
    let bars = signal_bands(12, phase)
    assert(len(bars) == 12, "expected signal band count")
    assert(workbench_signature("signal", phase) == "signal:43:cargo-node", "expected cargo signature")
    let svg = build_svg(420, 240, phase)
    let document = js_bridge_call_method_raw(helper, "makeDocumentPayload", ["Signal Workbench", svg, "linear-gradient(180deg, #12182a 0%, #05070f 100%)", "#8ef6ff"])
    let image = js_bridge_call_method_raw(helper, "makeSvgImagePayload", ["signal_workbench", svg, 420, 240, "#8ef6ff"])
    let document_info = js_web_document_info(document)
    let image_info = js_web_image_info(image)
    assert(document_info.mime_type == "text/html", "expected document payload")
    assert(image_info.width == 420, "expected image width")
    assert(len(js_web_image_bytes(image)) == image_info.byte_length, "expected byte length snapshot")

fn main() -> String:
    let helper = js_bridge_import("./helpers/payload_studio.mjs")
    let phase = workbench_stamp_orbit(7, 9)
    let width = 1320
    let height = 780
    let svg = build_svg(width, height, phase)
    let document = js_bridge_call_method_raw(helper, "makeDocumentPayload", ["Signal Workbench", svg, "linear-gradient(180deg, #12182a 0%, #05070f 100%)", "#8ef6ff"])
    let image = js_bridge_call_method_raw(helper, "makeSvgImagePayload", ["signal_workbench", svg, width, height, "#8ef6ff"])
    let html_path = smoke_output("signal_workbench.html")
    let svg_path = smoke_output("signal_workbench.svg")
    let report_path = smoke_output("signal_workbench_report.txt")
    let info = js_web_image_info(image)
    let bars = signal_bands(24, phase)
    let report = "Cargo + Node signal workbench smoke\n"
    let report = report + "revision: " + str(CARGO_NODE_REVISION) + "\n"
    let report = report + "phase: " + str(phase) + "\n"
    let report = report + "signature: " + workbench_signature("signal-workbench", phase) + "\n"
    let report = report + "bar_count: " + str(len(bars)) + "\n"
    let report = report + "bar_energy: " + str(bar_energy(bars)) + "\n"
    let report = report + "beacon_count: " + str(len(beacon_pairs(width, height, phase)) / 2) + "\n"
    let report = report + "image_kind: " + info.kind + "\n"
    let report = report + "image_dims: " + str(info.width) + "x" + str(info.height) + "\n"
    let report = report + "cargo_role: generated signal bands + beacons + signature\n"
    let report = report + "node_role: packaged html and canvas payloads + wrote artifacts\n"
    let report = report + "kain_role: composed svg scene + runtime report\n"
    let report = report + "html_path: " + html_path + "\n"
    let report = report + "svg_path: " + svg_path + "\n"
    let report = report + "generated_binding: outputs/generated/cargo_node_weave.kn"

    js_web_document_write(html_path, document)
    js_web_image_write(svg_path, image)
    write_file(report_path, report + "\n")
    println(report)
    return report
