// === Minimal Interpreter Test ===

// --- Basic struct + enum + match ---
struct Point:
    x: Int
    y: Int

enum Color:
    Red
    Green
    Blue

fn make_red() -> Color:
    return Color::Red

// --- Inner function (Stmt::Item test) ---
fn outer(a: Int) -> Int:
    fn inner(b: Int) -> Int:
        return b + 100
    return inner(a)

// --- World without surfaces (Tier 1a test) ---
world TestWorld:
    state count: Int = 0

// --- Ownership observe ---
fn ownership_test() -> Int:
    let x: Int = 42
    observe x:
        let result: Int = x
        return result
    return 0

// --- Main ---
fn main() -> Int:
    let r: Color = make_red()
    match r:
        Color::Red => return 1
        _ => return 0
