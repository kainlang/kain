use c::image_fx
use rust::quad_prism_lab
use std::python::bridge
use std::javascript::bridge
use std::javascript::web
use std::interop::bridge
use std::c::bridge

fn smoke_output(name: String) -> String:
    return "outputs/" + name

fn install_python_kernel():
    py_bridge_exec("import sys\nif 'helpers' not in sys.path:\n    sys.path.insert(0, 'helpers')\nfrom prism_kernel import make_quad_prism\n")

fn sample_rgba(bytes: Any, width: Int, x: Int, y: Int) -> String:
    let index = ((y * width) + x) * 4
    return "[" + str(bytes[index + 0]) + ", " + str(bytes[index + 1]) + ", " + str(bytes[index + 2]) + ", " + str(bytes[index + 3]) + "]"

fn paint_kain_overlay(bytes: Any, width: Int, height: Int, bands, phase: Int) -> Any:
    let center_x = width / 2
    let center_y = height / 2
    let y = 0
    while y < height:
        let x = 0
        while x < width:
            let border_hit = x < 2 or y < 2 or x >= width - 2 or y >= height - 2
            let band_hit = x == bands[0] or x == bands[1] or x == bands[2]
            let cross_hit = x == center_x or y == center_y
            let spark_hit = ((x + y + phase) % 29 == 0) and ((x * 3 + y * 5 + phase) % 7 == 0)
            if border_hit or band_hit or cross_hit or spark_hit:
                let index = ((y * width) + x) * 4
                bytes[index + 0] = 255
                bytes[index + 1] = 214
                bytes[index + 2] = 92
                bytes[index + 3] = 255
            x = x + 1
        y = y + 1
    return bytes

fn build_legend(info, rust_before: Int, rust_after: Int, c_after: Int, workspace_area: Int, signature: String) -> String:
    let legend = "<p>Source runtime: " + info.source_runtime + " / backend " + str(info.source_backend) + "</p>"
    let legend = legend + "<p>Ownership: " + info.ownership + " / representation " + info.representation + "</p>"
    let legend = legend + "<p>Kain overlay checksum: " + str(rust_before) + "</p>"
    let legend = legend + "<p>C post-mutation checksum: " + str(c_after) + "</p>"
    let legend = legend + "<p>Rust final checksum: " + str(rust_after) + " / signature " + signature + "</p>"
    let legend = legend + "<p>Workspace area: " + str(workspace_area) + "</p>"
    return legend

test quad_prism_halo_roundtrip:
    install_python_kernel()
    assert(py_bridge_module_available("numpy"), "numpy must be installed for the quad prism halo smoke")
    assert(QUAD_PRISM_REVISION == 1, "expected quad prism revision")

    let raw = py_bridge_call_raw("make_quad_prism", [64, 40, 11])
    let shared_image = py_bridge_shared_image(raw)
    let info = interop_shared_image_info(shared_image)
    let base_bytes = interop_shared_image_bytes(shared_image)
    let base_checksum = quad_prism_checksum(base_bytes)
    let bands = quad_prism_bands(info.width, 3)
    let overlay_bytes = interop_shared_image_bytes(shared_image)
    let overlay_bytes = paint_kain_overlay(overlay_bytes, info.width, info.height, bands, 11)
    c_bridge_shared_image_replace_bytes(shared_image, overlay_bytes)
    let rust_kain_checksum = quad_prism_checksum(interop_shared_image_bytes(shared_image))
    let c_checksum_before = imagefx_checksum(shared_image, info.byte_length)
    imagefx_halo_rgba(shared_image, info.byte_length, 41)
    let c_checksum_after = imagefx_checksum(shared_image, info.byte_length)
    let final_bytes = interop_shared_image_bytes(shared_image)
    let rust_final_checksum = quad_prism_checksum(final_bytes)
    let workspace = imagefx_workspace_create(info.width, info.height)
    let workspace_area = imagefx_workspace_area(workspace)
    imagefx_workspace_destroy(workspace)
    let helper = js_bridge_import("./helpers/payload_studio.mjs")
    let ppm = js_bridge_call_method_raw(helper, "makePpmPayload", ["quad_prism_halo_test", info.width, info.height, final_bytes, quad_prism_signature("quad", info.width, info.height, rust_final_checksum, c_checksum_after)])
    let node_image = js_web_shared_image(ppm)
    let node_info = interop_shared_image_info(node_image)

    assert(info.contract == "kain.shared.image", "expected neutral shared image contract")
    assert(info.source_runtime == "python", "expected python source runtime")
    assert(base_checksum != rust_kain_checksum, "expected Kain overlay to change the image bytes")
    assert(c_checksum_before != c_checksum_after, "expected C mutation to change checksum")
    assert(rust_kain_checksum != rust_final_checksum, "expected final bytes to differ after C mutation")
    assert(workspace_area == info.width * info.height, "expected opaque C handle to roundtrip")
    assert(node_info.source_runtime == "javascript", "expected node roundtrip image")
    assert(node_info.representation == "encoded", "expected encoded node image")

fn main() -> String:
    install_python_kernel()
    assert(py_bridge_module_available("numpy"), "numpy must be installed for the quad prism halo smoke")

    let width = 192
    let height = 120
    let phase = 17
    let raw = py_bridge_call_raw("make_quad_prism", [width, height, phase])
    let shared_image = py_bridge_shared_image(raw)
    let info = interop_shared_image_info(shared_image)
    let base_bytes = interop_shared_image_bytes(shared_image)
    let rust_base_checksum = quad_prism_checksum(base_bytes)
    let bands = quad_prism_bands(info.width, 3)

    let overlay_bytes = interop_shared_image_bytes(shared_image)
    let overlay_bytes = paint_kain_overlay(overlay_bytes, info.width, info.height, bands, phase)
    c_bridge_shared_image_replace_bytes(shared_image, overlay_bytes)

    let kain_bytes = interop_shared_image_bytes(shared_image)
    let rust_kain_checksum = quad_prism_checksum(kain_bytes)
    let c_checksum_before = imagefx_checksum(shared_image, info.byte_length)
    imagefx_halo_rgba(shared_image, info.byte_length, 57)
    let c_checksum_after = imagefx_checksum(shared_image, info.byte_length)
    let c_signature = imagefx_signature(info.width, info.height, c_checksum_after, 57)
    let final_bytes = interop_shared_image_bytes(shared_image)
    let rust_final_checksum = quad_prism_checksum(final_bytes)
    let signature = quad_prism_signature("quad", info.width, info.height, rust_final_checksum, c_checksum_after)
    let workspace = imagefx_workspace_create(info.width, info.height)
    let workspace_area = imagefx_workspace_area(workspace)
    imagefx_workspace_destroy(workspace)

    let snapshot = interop_shared_buffer_from_bytes(final_bytes, "u8", [len(final_bytes)], "rgba8", "application/octet-stream")
    let snapshot_info = interop_shared_buffer_info(snapshot)
    let legend = build_legend(info, rust_kain_checksum, rust_final_checksum, c_checksum_after, workspace_area, signature)
    let helper = js_bridge_import("./helpers/payload_studio.mjs")
    let base_ppm = js_bridge_call_method_raw(helper, "makePpmPayload", ["quad_prism_halo_base", info.width, info.height, base_bytes, quad_prism_phase_stamp(info.width, info.height, phase)])
    let final_ppm = js_bridge_call_method_raw(helper, "makePpmPayload", ["quad_prism_halo_final", info.width, info.height, final_bytes, signature])
    let html = js_bridge_call_method_raw(helper, "makeCompareDocument", ["Quad Prism Halo", info.width, info.height, base_bytes, final_bytes, signature, rust_base_checksum, rust_kain_checksum, rust_final_checksum, c_checksum_after, c_signature, legend])
    let node_shared = js_web_shared_image(final_ppm)
    let node_info = interop_shared_image_info(node_shared)

    let html_path = smoke_output("quad_prism_halo.html")
    let base_path = smoke_output("quad_prism_halo_base.ppm")
    let final_path = smoke_output("quad_prism_halo_final.ppm")
    let report_path = smoke_output("quad_prism_halo_report.txt")

    let report = "Python + Cargo + Node + C quad prism halo smoke\n"
    let report = report + "revision: " + str(QUAD_PRISM_REVISION) + "\n"
    let report = report + "dims: " + str(info.width) + "x" + str(info.height) + "\n"
    let report = report + "channels: " + str(info.channels) + "\n"
    let report = report + "contract: " + info.contract + "\n"
    let report = report + "source_runtime: " + info.source_runtime + "\n"
    let report = report + "source_backend: " + str(info.source_backend) + "\n"
    let report = report + "representation: " + info.representation + "\n"
    let report = report + "rust_base_checksum: " + str(rust_base_checksum) + "\n"
    let report = report + "rust_kain_checksum: " + str(rust_kain_checksum) + "\n"
    let report = report + "rust_final_checksum: " + str(rust_final_checksum) + "\n"
    let report = report + "c_checksum_before: " + str(c_checksum_before) + "\n"
    let report = report + "c_checksum_after: " + str(c_checksum_after) + "\n"
    let report = report + "signature: " + signature + "\n"
    let report = report + "c_signature: " + c_signature + "\n"
    let report = report + "workspace_area: " + str(workspace_area) + "\n"
    let report = report + "snapshot_bytes: " + str(snapshot_info.byte_length) + "\n"
    let report = report + "bands: [" + str(bands[0]) + ", " + str(bands[1]) + ", " + str(bands[2]) + "]\n"
    let report = report + "center_pixel_base: " + sample_rgba(base_bytes, info.width, info.width / 2, info.height / 2) + "\n"
    let report = report + "center_pixel_final: " + sample_rgba(final_bytes, info.width, info.width / 2, info.height / 2) + "\n"
    let report = report + "node_roundtrip_runtime: " + node_info.source_runtime + "\n"
    let report = report + "node_roundtrip_representation: " + node_info.representation + "\n"
    let report = report + "python_role: generated the initial shared RGBA prism raster\n"
    let report = report + "kain_role: painted overlay geometry directly into the shared bytes and authored the report\n"
    let report = report + "cargo_role: computed revision, checksums, bands, phase stamp, and final signature\n"
    let report = report + "c_role: mutated the same image in place and round-tripped an opaque workspace handle\n"
    let report = report + "node_role: emitted compare-view html plus base and final ppm artifacts\n"
    let report = report + "html_path: " + html_path + "\n"
    let report = report + "base_path: " + base_path + "\n"
    let report = report + "final_path: " + final_path + "\n"

    js_web_document_write(html_path, html)
    js_web_image_write(base_path, base_ppm)
    js_web_image_write(final_path, final_ppm)
    write_file(report_path, report + "\n")
    println(report)
    return report
