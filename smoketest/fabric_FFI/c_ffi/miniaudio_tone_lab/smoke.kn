use c::audio_tone_lab

fn smoke_output(name: String) -> String:
    return "outputs/" + name

test miniaudio_tone_lab_runtime:
    let wav_path = smoke_output("test_tone.wav")
    let frames = audiofx_write_sine_wave(wav_path, 48000, 1, 500, 220.0, 0.65)
    assert(frames > 0, "expected generated frames")
    assert(audiofx_wav_channels(wav_path) == 1, "expected mono wav")
    assert(audiofx_wav_frame_count(wav_path) == frames, "expected frame count match")
    assert(audiofx_wav_peak(wav_path) > 0.5, "expected audible peak")

fn main() -> String:
    let wav_path = smoke_output("tone_220hz.wav")
    let signature_path = smoke_output("tone_signature.txt")
    let report_path = smoke_output("tone_report.txt")

    let frames = audiofx_write_sine_wave(wav_path, 48000, 1, 750, 220.0, 0.65)
    let peak = audiofx_wav_peak(wav_path)
    let channels = audiofx_wav_channels(wav_path)
    let frame_count = audiofx_wav_frame_count(wav_path)
    let signature = audiofx_wav_signature(wav_path)

    write_file(signature_path, signature + "\n")

    let report = "miniaudio tone lab smoke\n"
    let report = report + "wav_path: " + wav_path + "\n"
    let report = report + "signature_path: " + signature_path + "\n"
    let report = report + "frames_written: " + str(frames) + "\n"
    let report = report + "frame_count: " + str(frame_count) + "\n"
    let report = report + "channels: " + str(channels) + "\n"
    let report = report + "peak: " + str(peak) + "\n"
    let report = report + "signature: " + signature + "\n"
    let report = report + "role: kain orchestrated native audio generation and decode analysis through miniaudio\n"

    write_file(report_path, report + "\n")
    println(report)
    return report
