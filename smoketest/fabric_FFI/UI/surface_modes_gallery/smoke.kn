component App():
    render <slot layout="grid" gap={12} padding={12}>
        <theme name="surface_gallery">
            <scope name="gallery" selector="surface-gallery" />
            <widget kind="panel" scope="gallery">
                <token name="surface.mode" value="layered" />
            </widget>
            <widget kind="inspector" scope="gallery">
                <token name="surface.mode" value="glass" />
            </widget>
            <widget kind="tree" scope="gallery">
                <token name="surface.mode" value="flat" />
            </widget>
            <widget kind="graph" scope="gallery">
                <token name="surface.mode" value="canvas" />
            </widget>
            <widget kind="timeline" scope="gallery">
                <token name="surface.mode" value="accent" />
            </widget>
            <widget kind="viewport3d" scope="gallery">
                <token name="surface.mode" value="ghost" />
            </widget>
        </theme>
        <panel title="Panels" scope="gallery">
            <text role="title">Layered shell</text>
        </panel>
        <inspector title="Inspector" scope="gallery">
            <text role="caption">Glass chrome</text>
        </inspector>
        <tree title="Tree" scope="gallery">
            <text role="caption">Flat structure</text>
        </tree>
        <graph title="Graph" scope="gallery">
            <text role="caption">Canvas treatment</text>
        </graph>
        <timeline title="Timeline" scope="gallery">
            <text role="caption">Accent strip</text>
        </timeline>
        <viewport3d title="Viewport" scope="gallery" scene="geometry_fixture" />
    </slot>
