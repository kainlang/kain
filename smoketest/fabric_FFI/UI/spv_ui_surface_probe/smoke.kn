shader fragment UiSurfaceProbe(uv: Vec2) -> Vec4:
    uniform font_atlas: Sampler2D @0

    let bg_mix = clamp(uv.y * 1.1, 0.0, 1.0)
    let bg_r = 0.03 + bg_mix * 0.06
    let bg_g = 0.06 + bg_mix * 0.10
    let bg_b = 0.10 + bg_mix * 0.18

    let panel_center = vec2(0.5, 0.58)
    let panel_half_size = vec2(0.39, 0.26)
    let panel_radius = 0.07
    let panel_dx = abs(uv.x - panel_center.x) - (panel_half_size.x - panel_radius)
    let panel_dy = abs(uv.y - panel_center.y) - (panel_half_size.y - panel_radius)
    let panel_outer_x = max(panel_dx, 0.0)
    let panel_outer_y = max(panel_dy, 0.0)
    let panel_corner = sqrt(panel_outer_x * panel_outer_x + panel_outer_y * panel_outer_y) - panel_radius
    let panel_inside = min(max(panel_dx, panel_dy), 0.0)
    let panel_sdf = panel_inside + panel_corner
    let panel_fill = clamp(1.0 - panel_sdf * 18.0, 0.0, 1.0)
    let panel_edge = clamp(1.0 - abs(panel_sdf) * 72.0, 0.0, 1.0)

    let header_band = clamp(1.0 - abs(uv.y - 0.40) * 18.0, 0.0, 1.0) * panel_fill
    let accent_orb = clamp(1.0 - sqrt((uv.x - 0.79) * (uv.x - 0.79) + (uv.y - 0.53) * (uv.y - 0.53)) * 9.0, 0.0, 1.0)
    let pulse_orb = clamp(1.0 - sqrt((uv.x - 0.20) * (uv.x - 0.20) + (uv.y - 0.67) * (uv.y - 0.67)) * 11.0, 0.0, 1.0)

    let atlas_preview_u = clamp((uv.x - 0.16) / 0.68, 0.0, 1.0)
    let atlas_preview_v = clamp((uv.y - 0.49) / 0.12, 0.0, 1.0)
    let atlas_sample = sample(font_atlas, vec2(atlas_preview_u, atlas_preview_v))
    let atlas_region = clamp(1.0 - abs(uv.y - 0.55) * 24.0, 0.0, 1.0) * panel_fill
    let atlas_mix = atlas_region * 0.82

    let glyph_signal = (atlas_sample.r + atlas_sample.g + atlas_sample.b) / 3.0
    let atlas_r = atlas_sample.r * 0.95 + glyph_signal * 0.10
    let atlas_g = atlas_sample.g * 0.70 + glyph_signal * 0.28
    let atlas_b = atlas_sample.b * 0.55 + glyph_signal * 0.40

    let stripe = clamp(1.0 - abs(fract(uv.y * 22.0) - 0.5) * 7.0, 0.0, 1.0) * 0.03
    let edge_glow = panel_edge * 0.22

    let panel_r = 0.08 + header_band * 0.08 + edge_glow * 0.26 + accent_orb * 0.10
    let panel_g = 0.12 + header_band * 0.16 + edge_glow * 0.18 + accent_orb * 0.16 + pulse_orb * 0.04
    let panel_b = 0.16 + header_band * 0.28 + edge_glow * 0.12 + accent_orb * 0.09 + pulse_orb * 0.07

    let base_r = bg_r * (1.0 - panel_fill) + panel_r * panel_fill
    let base_g = bg_g * (1.0 - panel_fill) + panel_g * panel_fill
    let base_b = bg_b * (1.0 - panel_fill) + panel_b * panel_fill

    let final_r = base_r * (1.0 - atlas_mix) + atlas_r * atlas_mix + stripe
    let final_g = base_g * (1.0 - atlas_mix) + atlas_g * atlas_mix + stripe
    let final_b = base_b * (1.0 - atlas_mix) + atlas_b * atlas_mix + stripe * 1.6
    let final_a = 1.0

    return vec4(final_r, final_g, final_b, final_a)

component App():
    render <slot layout="column" gap={14} padding={14}>
        <theme name="spv_ui_surface">
            <token name="widget.panel.surface.mode" category="surface" value="glass" />
            <token name="widget.canvas.surface.mode" category="surface" value="canvas" />
            <token name="theme.background.top" category="color" value="#07111b" />
            <token name="theme.background.bottom" category="color" value="#132236" />
            <token name="theme.accent.primary" category="color" value="#4fd2ff" />
            <token name="theme.highlight" category="color" value="#ffd16a" />
            <token name="theme.text.default" category="color" value="#eef8ff" />
            <token name="theme.text.muted" category="color" value="#91aac1" />
        </theme>

        <panel title="SPV UI Surface Probe" layout="column" gap={8}>
            <text role="title">Shader canvas is now a first-class native UI lane.</text>
            <text role="caption">This smoke packages a real font asset, emits SPIR-V, builds a native executable, and samples the packed MSDF atlas inside the fragment shader.</text>
        </panel>

        <graph title="Host / Client Contract">
            <text role="caption">Host: native window, shader bundle, realtime bundle, packed font asset sidecar, canvas surface presentation.</text>
            <text role="caption">Client: Kain fragment shader, atlas texture sampling, procedural panel composition, SPIR-V-canonical shader artifact output.</text>
        </graph>

        <canvas title="Fastest UI Lane" text="MSDF atlas sampled live from packaged font assets" shader_ref="UiSurfaceProbe" shader_stage="fragment" shader_format="spirv" font_asset="assets/ui_smoke_default.ttf" font_family="kain.default-ui-sans" font_encoding="msdf-rgba" font_msdf_range_px={6} font_cell_width_px={32} font_cell_height_px={32} />

        <panel title="What This Smoke Proves" layout="column" gap={6}>
            <text role="caption">A canvas node now survives all the way into the native runtime as a shader-canvas surface, not a viewport placeholder.</text>
            <text role="caption">Relative font assets resolve from the source root, get packaged beside the executable, and feed the native MSDF atlas cache.</text>
            <text role="caption">The shader preview is not faking the lane with CPU text drawing: it samples the runtime-provided atlas texture inside the fragment shader.</text>
        </panel>
    </slot>
