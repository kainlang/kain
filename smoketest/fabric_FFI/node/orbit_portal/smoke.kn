use std::javascript::bridge

fn smoke_output(name: String) -> String:
    return "outputs/" + name

fn build_svg(payload) -> String:
    let width = payload.width
    let height = payload.height
    let points = payload.points
    let svg = "<svg viewBox='0 0 " + str(width) + " " + str(height) + "' xmlns='http://www.w3.org/2000/svg'>"
    let svg = svg + "<defs><radialGradient id='core' cx='50%' cy='50%' r='50%'><stop offset='0%' stop-color='#fff5ff' /><stop offset='45%' stop-color='" + payload.halo + "' /><stop offset='100%' stop-color='transparent' /></radialGradient></defs>"
    let svg = svg + "<rect width='" + str(width) + "' height='" + str(height) + "' rx='28' fill='#05060d' />"
    let svg = svg + "<circle cx='" + str(width / 2) + "' cy='" + str(height / 2) + "' r='140' fill='url(#core)' opacity='0.62' />"
    let i = 0
    while i < len(points):
        let point = points[i]
        let svg = svg + "<circle cx='" + str(point[0]) + "' cy='" + str(point[1]) + "' r='" + str(point[2]) + "' fill='" + payload.accent + "' opacity='" + str(point[3]) + "' />"
        i = i + 1
    let svg = svg + "<circle cx='" + str(width / 2) + "' cy='" + str(height / 2) + "' r='24' fill='#fff8ff' />"
    let svg = svg + "<circle cx='" + str(width / 2) + "' cy='" + str(height / 2) + "' r='68' fill='none' stroke='" + payload.accent + "' stroke-opacity='0.6' stroke-width='2' />"
    let svg = svg + "</svg>"
    return svg

test node_orbit_portal:
    let helper = js_bridge_import("./helpers/orbit_math.mjs")
    let path_mod = js_bridge_import("node:path")
    assert(js_bridge_hasattr(helper, "buildOrbitField"), "expected local js helper export")
    assert(js_bridge_hasattr(path_mod, "basename"), "expected node:path basename")
    let payload = js_bridge_call_method(helper, "buildOrbitField", [320, 200, 19, 24])
    assert(payload.width == 320, "expected js payload width")
    assert(len(payload.points) == 24, "expected orbit point count")
    let basename = js_bridge_call_method(path_mod, "basename", ["outputs/orbit_portal.html"])
    assert(basename == "orbit_portal.html", "expected node:path basename result")

fn main() -> String:
    let helper = js_bridge_import("./helpers/orbit_math.mjs")
    let fs_mod = js_bridge_import("node:fs")
    let path_mod = js_bridge_import("node:path")
    let html_path = smoke_output("orbit_portal.html")
    let svg_path = smoke_output("orbit_portal.svg")
    let report_path = smoke_output("orbit_portal_report.txt")

    let payload = js_bridge_call_method(helper, "buildOrbitField", [1280, 720, 37, 96])
    let svg = build_svg(payload)
    let html = js_bridge_call_method(
        helper,
        "htmlShell",
        ["Kain Orbit Portal", svg, payload.background, payload.accent],
    )
    js_bridge_call_method(fs_mod, "writeFileSync", [html_path, html])
    write_file(svg_path, svg)

    let basename = js_bridge_call_method(path_mod, "basename", [html_path])
    let report = "Kain + Node orbit portal smoke\n"
    let report = report + "html_file: " + basename + "\n"
    let report = report + "width: " + str(payload.width) + "\n"
    let report = report + "height: " + str(payload.height) + "\n"
    let report = report + "point_count: " + str(len(payload.points)) + "\n"
    let report = report + "accent: " + payload.accent + "\n"
    let report = report + "html_path: " + html_path + "\n"
    let report = report + "svg_path: " + svg_path + "\n"
    let report = report + "js_role: computed orbit field + wrapped html shell\n"
    let report = report + "node_role: imported modules + wrote html artifact\n"
    let report = report + "kain_role: composed svg + runtime report"

    write_file(report_path, report + "\n")
    println(report)
    return report
