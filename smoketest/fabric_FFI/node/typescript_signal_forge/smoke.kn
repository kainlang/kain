use std::javascript::bridge
use std::javascript::web

fn smoke_output(name: String) -> String:
    return "outputs/" + name

fn build_svg(payload) -> String:
    let width = payload.width
    let height = payload.height
    let points = payload.points
    let svg = "<svg viewBox='0 0 " + str(width) + " " + str(height) + "' xmlns='http://www.w3.org/2000/svg'>"
    let svg = svg + "<defs><linearGradient id='beam' x1='0%' y1='0%' x2='100%' y2='0%'><stop offset='0%' stop-color='" + payload.secondary + "' /><stop offset='100%' stop-color='" + payload.accent + "' /></linearGradient></defs>"
    let svg = svg + "<rect width='" + str(width) + "' height='" + str(height) + "' rx='32' fill='#05060c' />"
    let i = 0
    while i + 1 < len(points):
        let a = points[i]
        let b = points[i + 1]
        let svg = svg + "<line x1='" + str(a[0]) + "' y1='" + str(a[1]) + "' x2='" + str(b[0]) + "' y2='" + str(b[1]) + "' stroke='url(#beam)' stroke-opacity='0.32' stroke-width='2' />"
        i = i + 1
    let i = 0
    while i < len(points):
        let point = points[i]
        let color = payload.accent
        if i % 2 == 0:
            color = payload.secondary
        let svg = svg + "<circle cx='" + str(point[0]) + "' cy='" + str(point[1]) + "' r='" + str(point[2]) + "' fill='" + color + "' opacity='" + str(point[3]) + "' />"
        i = i + 1
    let svg = svg + "</svg>"
    return svg

test typescript_signal_forge:
    let helper = js_bridge_import("./helpers/signal_prism.ts")
    let payload = js_bridge_call_method(helper, "buildSignalPrism", [360, 220, 23, 28])
    assert(payload.width == 360, "expected ts payload width")
    assert(len(payload.points) == 28, "expected ts signal point count")
    let bytes = js_bridge_call_method_raw(helper, "encodeUtf8", ["Kain TS bridge"])
    let info = js_web_buffer_info(bytes)
    let snapshot = js_web_buffer_bytes(bytes)
    assert(info.byte_length == len(snapshot), "expected typed array byte length")
    assert(snapshot[0] == 75, "expected K byte")

fn main() -> String:
    let helper = js_bridge_import("./helpers/signal_prism.ts")
    let html_path = smoke_output("typescript_signal_forge.html")
    let svg_path = smoke_output("typescript_signal_forge.svg")
    let report_path = smoke_output("typescript_signal_report.txt")

    let payload = js_bridge_call_method(helper, "buildSignalPrism", [1400, 760, 41, 120])
    let svg = build_svg(payload)
    let html = js_bridge_call_method(
        helper,
        "htmlDocument",
        ["TypeScript Signal Forge", svg, payload.background, payload.accent],
    )
    let html_bytes = js_bridge_call_method_raw(helper, "encodeUtf8", [html])
    let byte_info = js_web_buffer_info(html_bytes)
    let snapshot = js_web_buffer_bytes(html_bytes)

    js_web_write_text(html_path, html)
    write_file(svg_path, svg)

    let report = "Kain + TypeScript signal forge smoke\n"
    let report = report + "width: " + str(payload.width) + "\n"
    let report = report + "height: " + str(payload.height) + "\n"
    let report = report + "point_count: " + str(len(payload.points)) + "\n"
    let report = report + "accent: " + payload.accent + "\n"
    let report = report + "byte_length: " + str(byte_info.byte_length) + "\n"
    let report = report + "snapshot_count: " + str(len(snapshot)) + "\n"
    let report = report + "first_byte: " + str(snapshot[0]) + "\n"
    let report = report + "html_path: " + html_path + "\n"
    let report = report + "svg_path: " + svg_path + "\n"
    let report = report + "ts_role: computed signal data + html document + utf8 buffer\n"
    let report = report + "kain_role: composed svg + inspected typed array + wrote report"

    write_file(report_path, report + "\n")
    println(report)
    return report
