use rust::allinone_fabric_rust
use std::interop::bridge

fn main() -> String:
    let snapshot = fabric_inputs.native_filter.snapshot
    let gpu_dst = fabric_inputs.gpu_enrich.dst
    let snapshot_bytes = interop_shared_buffer_bytes(snapshot)
    let gpu_bytes = interop_shared_buffer_bytes(gpu_dst)
    let snapshot_checksum = buffer_checksum(snapshot_bytes)
    let gpu_checksum = buffer_checksum(gpu_bytes)
    return analysis_label(
        len(snapshot_bytes),
        snapshot_checksum,
        gpu_checksum,
        fabric_inputs.kain_orchestrator.report,
    )
