use std::interop::bridge

struct AllInOneFabricOutputs:
    image: Any
    src: Any
    dst: Any
    report: String

fn push_f32_demo(bytes: Array<Int>, value: Int) -> Void:
    if value == 1:
        bytes.push(0)
        bytes.push(0)
        bytes.push(128)
        bytes.push(63)
        return
    if value == 2:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        return
    if value == 3:
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        bytes.push(64)
        return
    if value == 4:
        bytes.push(0)
        bytes.push(0)
        bytes.push(128)
        bytes.push(64)
        return
    bytes.push(0)
    bytes.push(0)
    bytes.push(160)
    bytes.push(64)

fn build_pixels(width: Int, height: Int, accent: Int) -> Array<Int>:
    let bytes = []
    let y = 0
    while y < height:
        let x = 0
        while x < width:
            let base = (x * 13 + y * 19 + accent) % 255
            bytes.push(base)
            bytes.push((base + accent) % 255)
            bytes.push((255 - base) % 255)
            bytes.push(255)
            x = x + 1
        y = y + 1
    return bytes

fn build_src_bytes(start: Int, step: Int, count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        let value = start + index * step
        push_f32_demo(bytes, value)
        index = index + 1
    return bytes

fn build_zero_bytes(count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        index = index + 1
    return bytes

fn main() -> AllInOneFabricOutputs:
    let settings = fabric_inputs.python_source.settings
    let pixels = build_pixels(settings.width, settings.height, settings.accent)
    let image = interop_shared_image_from_bytes(
        pixels,
        settings.width,
        settings.height,
        4,
        "HWC",
        "rgba8",
        "image/x-kain-raster",
    )
    let src_bytes = build_src_bytes(settings.start, settings.step, settings.count)
    let dst_bytes = build_zero_bytes(settings.count)
    let src = interop_shared_buffer_from_bytes(
        src_bytes,
        "f32",
        [settings.count],
        "f32",
        "application/octet-stream",
    )
    let dst = interop_shared_buffer_from_bytes(
        dst_bytes,
        "f32",
        [settings.count],
        "f32",
        "application/octet-stream",
    )
    let report = settings.title + ":" + str(settings.width) + "x" + str(settings.height) + ":" + str(settings.count)
    return AllInOneFabricOutputs { image: image, src: src, dst: dst, report: report }
