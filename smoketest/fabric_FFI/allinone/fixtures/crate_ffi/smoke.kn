use rust::allinone_crate_lab

fn smoke_output(name: String) -> String:
    return "../../outputs/crate_ffi/" + name

fn build_wave_art(width: Int, rows: Int, phase_stride: Int) -> String:
    let art = ""
    let row = 0
    while row < rows:
        art = art + wave_row(width, row * phase_stride + pulse_profile_stamp(3, 2)) + "\n"
        row = row + 1
    return art

test cargo_runtime_bridge:
    assert(ALLINONE_CRATE_VERSION == 7, "expected crate constant to load")
    assert(add(20, 22) == 42, "expected local crate add bridge")

    let shaped = amplify_series([3, 1, 4, 1, 5, 9], 2)
    assert(shaped[0] == 6, "expected first amplified value")
    assert(shaped[5] == 18, "expected last amplified value")
    assert(sum_series(shaped) == 46, "expected sum bridge to work")
    assert(every_above(shaped, 1), "expected threshold bridge to work")
    assert(compose_badge("cargo", 7) == "cargo-7:crate-ffi", "expected string bridge to work")
    assert(pulse_profile_stamp(6, 7) == 42, "expected inherent static method lowering")

fn main() -> String:
    let shaped = amplify_series([8, 5, 3, 5, 8, 9, 7, 9], 3)
    let total = sum_series(shaped)
    let badge = compose_badge("cargo-smoke", pulse_profile_stamp(4, 6))
    let wave_path = smoke_output("cargo_wave.txt")
    let report_path = smoke_output("cargo_bridge_report.txt")
    let wave = build_wave_art(56, 16, 3)

    write_file(wave_path, wave)

    let report = "Cargo crate FFI smoke\n"
    let report = report + "version: " + str(ALLINONE_CRATE_VERSION) + "\n"
    let report = report + "badge: " + badge + "\n"
    let report = report + "sum: " + str(total) + "\n"
    let report = report + "every_above_8: " + str(every_above(shaped, 8)) + "\n"
    let report = report + "stride: " + str(pulse_profile_stamp(5, 8)) + "\n"
    let report = report + "first: " + str(shaped[0]) + "\n"
    let report = report + "last: " + str(shaped[7]) + "\n"
    let report = report + "wave_path: " + wave_path + "\n"
    let report = report + "generated_hint: ../../outputs/crate_ffi/generated/allinone_crate_lab.kn"

    write_file(report_path, report + "\n")
    println(report)
    return report
