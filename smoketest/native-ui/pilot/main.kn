fn render_pilot_frame(session: Int, root: Int, title: Int, command: Int, viewport: Int, status: Int, body_font: Int, title_font: Int, icon_texture: Int, viewport_canvas: Int, command_y: Float, command_width: Float) -> Int:
    let _frame = ui_frame_begin(session, 16.0)
    let _root_draw = ui_render_box(session, root, "pilot.bg")
    let _viewport_draw = ui_render_resource_in_node(session, viewport, viewport_canvas, "pilot.viewport")
    let _title_draw = ui_render_text(session, title, title_font, native_ui_node_x(session, title), native_ui_node_y(session, title) + 26.0, "pilot.title")
    let _command_draw = ui_render_box(session, command, "pilot.command")
    let _icon_draw = ui_render_resource(session, command, icon_texture, command_width + 8.0, command_y + 4.0, 32.0, 32.0, "pilot.icon")
    let _label_draw = ui_render_text_in_box(session, command, body_font, 12.0, 26.0, "pilot.label")
    let _status_draw = ui_render_text(session, status, body_font, native_ui_node_x(session, status), native_ui_node_y(session, status) + 20.0, "pilot.status")
    return ui_frame_submit(session)

fn main() -> Int:
    let _reset = native_ui_reset()
    let session = ui_host_session_create("native-ui-pilot", "Kain Native UI Pilot", 960, 540, "win32-gl")
    let generation = native_ui_hot_reload_begin(session, "pilot-episode-one")

    let body_font = native_ui_font_create(session, "font.body", "Inter", 14.0)
    let title_font = native_ui_font_create(session, "font.title", "Inter", 22.0)
    let icon_texture = ui_texture_rgba8_from_hex(session, "texture.pilot.glyph", 2, 2, "FF8F3FFF7DC9FFFF1F242EFFEEF2F8FF")
    let viewport_canvas = native_ui_canvas_create(session, "canvas.pilot.viewport", 960, 540)
    let fill_shader = native_ui_shader_create(session, "shader.pilot.fill", "fragment", 192)

    let title_width = ui_text_width(session, title_font, "PILOT")
    let command_width = ui_text_width(session, body_font, "Engage UI") + 64.0
    let root = ui_reconcile_node(session, 0, "pilot.root", "pilot.root", 0.0, 0.0, 960.0, 540.0)
    let title = ui_reconcile_labeled_node(session, root, "pilot.title", "pilot.title", "PILOT", "heading", "Pilot", 24.0, 22.0, title_width + 12.0, 32.0)
    let command_y = ui_layout_column_y(1.0, 72.0, 40.0, 10.0)
    let command = ui_reconcile_focusable_node(session, root, "pilot.command.primary", "pilot.command.engage", "Engage UI", "action", "Engage the authored UI pilot", 24.0, command_y, command_width, 40.0)
    let viewport = ui_reconcile_text_node(session, root, "pilot.viewport.raw", "pilot.viewport", "viewport", 24.0, 142.0, ui_layout_split_left_width(920.0, 0.80, 16.0), 320.0)
    let status = ui_reconcile_text_node(session, root, "pilot.status", "pilot.status", "ABI live", 24.0, 480.0, 180.0, 28.0)

    let _root_bg = ui_style_color_rgba(session, root, "pilot.bg", 0.08, 0.09, 0.11, 1.0)
    let _root_text = ui_style_color_rgba(session, root, "pilot.text", 0.97, 0.98, 1.0, 1.0)
    let _viewport_bg = ui_style_color_rgba(session, viewport, "pilot.viewport", 0.15, 0.19, 0.24, 1.0)
    let _command_fill = ui_style_color_rgba(session, command, "pilot.command", 0.21, 0.55, 0.46, 1.0)
    let _icon_fill = ui_style_color_rgba(session, command, "pilot.icon", 1.0, 1.0, 1.0, 1.0)
    let _title_fill = ui_style_inherit_color_rgba(session, root, title, "pilot.text", "pilot.title", 0.97, 0.98, 1.0, 1.0)
    let _label_fill = ui_style_inherit_color_rgba(session, root, command, "pilot.text", "pilot.label", 0.97, 0.98, 1.0, 1.0)
    let _status_fill = ui_style_color_rgba(session, status, "pilot.status", 0.70, 0.78, 0.88, 1.0)
    let _command_spacing = ui_style_spacing(session, command, "pilot.layout", 10.0)
    let _command_padding = ui_style_padding(session, command, "pilot.layout", 12.0, 8.0, 12.0, 8.0)
    let hovered = ui_apply_hover_flag(session, command, 32.0, command_y + 8.0)

    let _clip = native_ui_clipboard_set_text(session, "pilot-ready")
    let _ime_begin = native_ui_ime_begin(session, command)
    let _ime_text = native_ui_ime_commit_text(session, "typed-from-pilot")
    let _drag = native_ui_drag_begin(session, command, "pilot.drag.payload", 32.0, command_y + 4.0)
    let _drag_update = native_ui_drag_update(session, 120.0, 220.0, viewport)

    let frame_counter = 0
    let draw_count = 0
    while frame_counter < 8 and native_ui_host_should_close(session) == 0:
        draw_count = render_pilot_frame(
            session,
            root,
            title,
            command,
            viewport,
            status,
            body_font,
            title_font,
            icon_texture,
            viewport_canvas,
            command_y,
            command_width
        )
        let _pump = native_ui_host_pump(session)
        frame_counter = frame_counter + 1

    let stable_command = native_ui_node_find_by_stable_key(session, "pilot.command.engage")
    let presented_count = native_ui_host_presented_draw_count(session)
    let frame_hash = native_ui_host_frame_hash(session)
    let committed_generation = native_ui_hot_reload_commit(session)

    if stable_command == command and presented_count == draw_count and draw_count >= 6 and frame_hash > 0 and native_ui_resource_count(session) == 5 and native_ui_drag_drop_target(session) == viewport and native_ui_host_should_close(session) == 1 and fill_shader > 0 and generation == committed_generation and hovered == 1 and native_ui_node_has_flag(session, command, "focusable") == 1:
        return 0

    return 1
