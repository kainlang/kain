@extern
fn puts(text: String) -> Int

use episode_network::run_episode_network_probe

fn main() -> Int:
    let _runtime = native_runtime_init()
    let _ui_reset = native_ui_reset()

    let session = native_ui_session_create("episode-two.repro.network", 640, 360)
    let generation = native_ui_hot_reload_begin(session, "episode-two.repro.network.rev-a")
    let root = ui_reconcile_node(session, 0, "repro.root", "repro.root", 0.0, 0.0, 640.0, 360.0)
    let surface = ui_reconcile_node(session, root, "repro.surface", "repro.surface", 0.0, 0.0, 640.0, 360.0)

    let _before = puts("repro-network:before-probe")
    let result = run_episode_network_probe(session, surface, 1)
    let _after = puts("repro-network:after-probe")
    let committed = native_ui_hot_reload_commit(session)
    let available = ui_state_string(session, surface, "network.available", "missing")
    let ok_value = ui_state_i64(session, surface, "network.ok", -1)
    let response_text = ui_state_string(session, surface, "network.response", "missing")
    let method_text = ui_state_string(session, surface, "network.method", "missing")
    let path_text = ui_state_string(session, surface, "network.path", "missing")
    if generation == committed:
        let _commit_ok = puts("repro-network:commit-ok")
    if available == "no":
        let _available_no = puts("repro-network:available-no")
    if available == "yes":
        let _available_ok = puts("repro-network:available-yes")
    if ok_value == 1:
        let _ok_value_ok = puts("repro-network:ok-value-1")
    if result == 1:
        let _result_ok = puts("repro-network:result-1")
    if method_text == "POST":
        let _method_ok = puts("repro-network:method-post")
    if path_text == "/episode-two/probe":
        let _path_ok = puts("repro-network:path-probe")
    if response_text != "":
        let _response_ok = puts("repro-network:response-present")
    if response_text == "listen failed":
        let _listen_failed = puts("repro-network:listen-failed")
    if response_text == "tcp connect failed":
        let _connect_failed = puts("repro-network:connect-failed")
    if response_text == "pump failed":
        let _pump_failed = puts("repro-network:pump-failed")
    if response_text == "network unavailable on this host":
        let _platform_unavailable = puts("repro-network:platform-unavailable")

    let _destroy_ui = native_ui_session_destroy(session)
    let _shutdown = native_runtime_shutdown()

    if generation != committed:
        return 2
    if available == "no":
        return 3
    if ok_value != 1:
        return 4
    if result != 1:
        return 5
    return 0
