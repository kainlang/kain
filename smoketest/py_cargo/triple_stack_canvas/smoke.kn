use std::python::bridge
use std::python::numpy
use std::dcc::image
use rust::py_cargo_canvas

fn smoke_output(name: String) -> String:
    return "outputs/" + name

fn install_hybrid_python_kernel():
    py_bridge_exec("import os\nimport struct\nimport numpy as np\n\ndef kain_py_cargo_rgba(width, height, phase):\n    x = np.linspace(-1.6, 1.6, width, dtype=np.float32)\n    y = np.linspace(-1.1, 1.1, height, dtype=np.float32)\n    xx, yy = np.meshgrid(x, y)\n    rr = np.sqrt(xx * xx + yy * yy) + 1e-5\n    theta = np.arctan2(yy, xx)\n    spiral = np.sin(12.0 * theta + phase / (rr + 0.18))\n    bloom = np.cos(9.0 * rr - 2.4 * theta)\n    haze = np.exp(-1.6 * rr * rr)\n    red = np.clip(255.0 * (0.14 + 0.46 * haze + 0.32 * (spiral + 1.0) * 0.5), 0, 255).astype(np.uint8)\n    green = np.clip(255.0 * (0.09 + 0.34 * haze + 0.44 * (bloom + 1.0) * 0.5), 0, 255).astype(np.uint8)\n    blue = np.clip(255.0 * (0.20 + 0.24 * haze + 0.56 * (np.sin(phase * 0.05 + 6.0 * xx - 4.0 * yy) + 1.0) * 0.5), 0, 255).astype(np.uint8)\n    alpha = np.full_like(red, 255, dtype=np.uint8)\n    rgba = np.dstack([red, green, blue, alpha]).astype(np.uint8, copy=False)\n    return np.require(rgba, dtype=np.uint8, requirements=['C', 'W', 'A'])\n\ndef kain_py_cargo_save_bmp(rgba, path):\n    rgba = np.require(rgba, dtype=np.uint8, requirements=['C'])\n    rgb = rgba[:, :, :3]\n    bgr = rgb[:, :, ::-1]\n    height, width, _ = bgr.shape\n    row_bytes = width * 3\n    row_stride = ((row_bytes + 3) // 4) * 4\n    pixel_bytes = row_stride * height\n    file_size = 14 + 40 + pixel_bytes\n    with open(path, 'wb') as handle:\n        handle.write(b'BM')\n        handle.write(struct.pack('<IHHI', file_size, 0, 0, 54))\n        handle.write(struct.pack('<IIIHHIIIIII', 40, width, height, 1, 24, 0, pixel_bytes, 2835, 2835, 0, 0))\n        padding = b'\\x00' * (row_stride - row_bytes)\n        for row in range(height - 1, -1, -1):\n            handle.write(bgr[row].tobytes())\n            if padding:\n                handle.write(padding)\n    return {'path': path, 'bytes': os.path.getsize(path), 'width': int(width), 'height': int(height)}\n")

fn clamp_byte(value: Int) -> Int:
    if value < 0:
        return 0
    if value > 255:
        return 255
    return value

fn composite_triple_stack(image, width: Int, height: Int, phase: Int) -> Int:
    let total_energy = 0
    let y = 0
    while y < height:
        let row_mask = cargo_mask_row(width, y, phase)
        total_energy = total_energy + cargo_energy(row_mask)
        let x = 0
        while x < width:
            let pixel = dcc_image_pixel_at(image, x, y)
            let rust_lift = row_mask[x]
            let kain_lift = 0
            if x == width / 2:
                kain_lift = kain_lift + 36
            if y == height / 2:
                kain_lift = kain_lift + 36
            let dx = x - (width / 2)
            let dy = y - (height / 2)
            let radius2 = dx * dx + dy * dy
            if radius2 < 500:
                kain_lift = kain_lift + 28
            if radius2 > 1800 and radius2 < 2400:
                kain_lift = kain_lift + 22
            let red = clamp_byte(pixel[0] + (rust_lift / 4) + kain_lift)
            let green = clamp_byte(pixel[1] + (rust_lift / 7) + (kain_lift / 2))
            let blue = clamp_byte(pixel[2] + (rust_lift / 3))
            dcc_image_set_pixel(image, x, y, [red, green, blue, 255])
            x = x + 1
        y = y + 1

    let beacons = cargo_beacon_points(width, height, phase)
    let beacon_index = 0
    while beacon_index < len(beacons):
        let bx = beacons[beacon_index]
        let by = beacons[beacon_index + 1]
        dcc_image_set_pixel(image, bx, by, [255, 255, 255, 255])
        if bx + 1 < width:
            dcc_image_set_pixel(image, bx + 1, by, [255, 214, 120, 255])
        if bx > 0:
            dcc_image_set_pixel(image, bx - 1, by, [255, 214, 120, 255])
        if by + 1 < height:
            dcc_image_set_pixel(image, bx, by + 1, [255, 214, 120, 255])
        if by > 0:
            dcc_image_set_pixel(image, bx, by - 1, [255, 214, 120, 255])
        beacon_index = beacon_index + 2
    return total_energy

test py_cargo_triple_stack:
    install_hybrid_python_kernel()
    assert(py_numpy_available(), "numpy must be installed for the hybrid smoke")
    assert(HYBRID_REVISION == 11, "expected cargo ffi constant")
    assert(hybrid_stamp_orbit(5, 5) == 42, "expected cargo ffi method lowering")

    let width = 96
    let height = 64
    let phase = hybrid_stamp_orbit(3, 7)
    let rgba = py_bridge_call_raw("kain_py_cargo_rgba", [width, height, phase])
    let image = dcc_image_from_python_owned(rgba)
    let info = dcc_image_info(image)
    assert(info.width == width, "expected hybrid image width")
    assert(info.height == height, "expected hybrid image height")
    let row = cargo_mask_row(width, 4, phase)
    assert(len(row) == width, "expected cargo row width match")
    assert(cargo_signature("hybrid", phase) == "hybrid:" + str(phase) + ":rust-native", "expected cargo signature")
    let center_before = dcc_image_pixel_at(image, width / 2, height / 2)
    let total_energy = composite_triple_stack(image, width, height, phase)
    let center_after = dcc_image_pixel_at(image, width / 2, height / 2)
    assert(total_energy > 0, "expected cargo energy accumulation")
    assert(center_after[0] >= center_before[0], "expected Kain composition to modify center")

fn main() -> String:
    install_hybrid_python_kernel()
    assert(py_numpy_available(), "numpy must be installed for the hybrid smoke")

    let width = 216
    let height = 144
    let phase = hybrid_stamp_orbit(4, 7)
    let signature = cargo_signature("triple-stack", phase)
    let base_path = smoke_output("triple_stack_base.bmp")
    let final_path = smoke_output("triple_stack_final.bmp")
    let report_path = smoke_output("triple_stack_report.txt")

    let rgba = py_bridge_call_raw("kain_py_cargo_rgba", [width, height, phase])
    let base_image = dcc_image_from_python_owned(rgba)
    let base_info = dcc_image_info(base_image)
    let base_center = dcc_image_pixel_at(base_image, width / 2, height / 2)
    let base_save = py_bridge_call("kain_py_cargo_save_bmp", [dcc_image_to_numpy(base_image), base_path])

    let image = dcc_image_from_python_owned(rgba)
    let first_row = cargo_mask_row(width, 0, phase)
    let first_row_energy = cargo_energy(first_row)
    let beacon_points = cargo_beacon_points(width, height, phase)
    let total_energy = composite_triple_stack(image, width, height, phase)
    let final_center = dcc_image_pixel_at(image, width / 2, height / 2)
    let final_save = py_bridge_call("kain_py_cargo_save_bmp", [dcc_image_to_numpy(image), final_path])

    let report = "Python + Cargo + Kain hybrid smoke\n"
    let report = report + "revision: " + str(HYBRID_REVISION) + "\n"
    let report = report + "signature: " + signature + "\n"
    let report = report + "width: " + str(base_info.width) + "\n"
    let report = report + "height: " + str(base_info.height) + "\n"
    let report = report + "base_center: " + str(base_center) + "\n"
    let report = report + "final_center: " + str(final_center) + "\n"
    let report = report + "first_row_energy: " + str(first_row_energy) + "\n"
    let report = report + "total_energy: " + str(total_energy) + "\n"
    let report = report + "beacon_pairs: " + str(len(beacon_points) / 2) + "\n"
    let report = report + "base_bytes: " + str(base_save.bytes) + "\n"
    let report = report + "final_bytes: " + str(final_save.bytes) + "\n"
    let report = report + "python_role: generated base raster + bmp export\n"
    let report = report + "cargo_role: generated native mask rows + beacons + signature\n"
    let report = report + "kain_role: composited image + runtime report\n"
    let report = report + "base_path: " + base_path + "\n"
    let report = report + "final_path: " + final_path + "\n"
    let report = report + "generated_binding: outputs/generated/py_cargo_canvas.kn"

    write_file(report_path, report + "\n")
    println(report)
    return report
