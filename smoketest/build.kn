use std::build
use std::test
use std::proof
use std::certify

fn build(ctx: BuildContext) -> BuildGraph:
    let pkg = package("smoketest").version("0.1.0").description("THE smoketest: album-edition workspace covering every Kain feature in one proof surface.")

    let blade_spec = blade("smoketest").kind("kain_executable").entry("src/main.kn").source_root("src").source_root("src/semantics").source_root("src/systems").source_root("src/gpu").source_root("src/stdlib").source_root("src/interop").source_root("src/wasm").module_root("src").module_root("src/semantics").module_root("src/systems").module_root("src/gpu").module_root("src/stdlib").module_root("src/interop").module_root("src/wasm").build_target("llvm")

    let defaults = build_defaults().entry("src/main.kn").artifact_root(".kain/out/llvm").cache_root(".kain/cache/build").profile("debug").target("llvm")

    let run = run_defaults().entry("src/main.kn").target("llvm")

    let check_llvm = build_check("check-llvm").entry("src/main.kn").target("llvm").axis("target", "llvm").telemetry("llm.evidence").input("src/main.kn").input("src/semantics/types.kn").input("src/semantics/control.kn").input("src/semantics/effects.kn").input("src/semantics/option_result.kn").input("src/semantics/async_future.kn").input("src/semantics/world.kn").input("src/semantics/entangle.kn").input("src/semantics/law.kn").input("src/semantics/patch.kn").input("src/semantics/actor.kn").input("src/semantics/converge.kn").input("src/semantics/orchestrate.kn").input("src/semantics/axiom.kn").input("src/semantics/shatter.kn").input("src/semantics/pulse.kn").input("src/semantics/teleport.kn").input("src/semantics/comptime.kn").input("src/systems/memory.kn").input("src/systems/ownership.kn").input("src/gpu/fragment.kn").input("src/gpu/compute.kn").input("src/stdlib/collections_lane.kn").input("src/stdlib/crypto_lane.kn").input("src/stdlib/text_lane.kn").input("src/stdlib/fs_lane.kn").input("src/stdlib/alloc_lane.kn").input("src/stdlib/math_lane.kn").input("src/stdlib/time_lane.kn").input("src/stdlib/diagnostics_lane.kn").input("src/stdlib/platform_lane.kn").input("src/interop/c_bridge.kn").input("build.kn")

    let check_spirv = build_check("check-spirv").entry("src/gpu/fragment.kn").target("spirv").axis("target", "spirv").telemetry("llm.gpu").input("src/gpu/fragment.kn").input("src/gpu/compute.kn").input("build.kn")

    let check_wasm = build_check("check-wasm").entry("src/wasm/wasm_main.kn").target("wasm").axis("target", "wasm").telemetry("llm.wasm").input("src/wasm/wasm_main.kn").input("build.kn")

    let gpu_spirv = build_task("gpu-spirv").entry("src/gpu/fragment.kn").target("spirv").artifact_root(".kain/out/spirv").requires("check-spirv").input("src/gpu/fragment.kn").input("src/gpu/compute.kn")

    let gpu_cuda = build_task("gpu-cuda").entry("src/gpu/compute.kn").target("cuda").artifact_root(".kain/out/cuda").requires("check-spirv").input("src/gpu/compute.kn")

    let gpu_hlsl = build_task("gpu-hlsl").entry("src/gpu/fragment.kn").target("hlsl").artifact_root(".kain/out/hlsl").requires("check-spirv").input("src/gpu/fragment.kn").input("src/gpu/compute.kn")

    let source_tests = test_suite("source-tests").entry("src/main.kn").target("llvm").requires("check-llvm").input("src/main.kn").input("build.kn")

    let root_exe = native_executable("root-executable").entry("src/main.kn").root_output("$blade/smoketest.exe").requires("check-llvm").requires("check-spirv").requires("check-wasm").requires("source-tests").input("src/main.kn").input("build.kn")

    let certify = certify_gate("certify").requires("check-llvm").requires("check-spirv").requires("check-wasm").requires("source-tests").requires("root-executable").certifies("smoketest.local")

    return build_graph().package(pkg).blade(blade_spec).defaults(defaults).run(run).task(check_llvm).task(check_spirv).task(check_wasm).task(gpu_spirv).task(gpu_cuda).task(gpu_hlsl).task(source_tests).task(root_exe).task(certify)
