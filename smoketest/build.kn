use std::build
use std::test
use std::proof
use std::bench
use std::attrition
use std::certify

fn build(ctx: BuildContext) -> BuildGraph:
    let ws = workspace_defaults().search_root(".").generated_root("telemetry")

    let pkg = package("smoketest").version("0.1.0").description("THE smoketest: album-edition workspace covering every Kain feature in one proof surface.")

    let blade_spec = blade("smoketest").kind("kain_executable").entry("src/main.kn").source_root("src").source_root("src/semantics").source_root("src/systems").source_root("src/gpu").source_root("src/stdlib").source_root("src/interop").source_root("src/wasm").source_root("src/telemetry").source_root("src/ui").source_root("telemetry").module_root("src").module_root("src/semantics").module_root("src/systems").module_root("src/gpu").module_root("src/stdlib").module_root("src/interop").module_root("src/wasm").module_root("src/telemetry").module_root("src/ui").module_root("telemetry").build_target("llvm")

    let defaults = build_defaults().entry("src/main.kn").artifact_root(".kain/out/llvm").cache_root(".kain/cache/build").profile("debug").target("llvm")

    let run = run_defaults().entry("src/main.kn").target("llvm").watch("src/telemetry").watch("src/ui").watch("telemetry").watch("native").watch("build-smoketest-visualizer-bridge.ps1").watch("run-visual-smoketest.ps1").watch("telemetry/python_bridge.kn").watch("telemetry/run_smoketest_mode.kn")

    let check_llvm = build_check("check-llvm").entry("src/main.kn").target("llvm").axis("target", "llvm").telemetry("llm.evidence").telemetry("smoketest.album").input("src/main.kn").input("src/semantics/types.kn").input("src/semantics/control.kn").input("src/semantics/effects.kn").input("src/semantics/option_result.kn").input("src/semantics/async_future.kn").input("src/semantics/world.kn").input("src/semantics/entangle.kn").input("src/semantics/law.kn").input("src/semantics/patch.kn").input("src/semantics/actor.kn").input("src/semantics/converge.kn").input("src/semantics/orchestrate.kn").input("src/semantics/axiom.kn").input("src/semantics/shatter.kn").input("src/semantics/pulse.kn").input("src/semantics/teleport.kn").input("src/semantics/comptime.kn").input("src/semantics/keyword_mesh.kn").input("src/systems/memory.kn").input("src/systems/ownership.kn").input("src/systems/share_fanout.kn").input("src/systems/abi_control.kn").input("src/systems/vm_topology.kn").input("src/systems/mmio_interrupt.kn").input("src/systems/native_cli.kn").input("src/gpu/fragment.kn").input("src/gpu/compute.kn").input("src/stdlib/ascii_lane.kn").input("src/stdlib/base64_lane.kn").input("src/stdlib/bytes_lane.kn").input("src/stdlib/collections_lane.kn").input("src/stdlib/crypto_lane.kn").input("src/stdlib/text_lane.kn").input("src/stdlib/fs_lane.kn").input("src/stdlib/alloc_lane.kn").input("src/stdlib/json_lane.kn").input("src/stdlib/math_lane.kn").input("src/stdlib/time_lane.kn").input("src/stdlib/unicode_lane.kn").input("src/stdlib/random_lane.kn").input("src/stdlib/uri_lane.kn").input("src/stdlib/semver_lane.kn").input("src/stdlib/sync_lane.kn").input("src/stdlib/io_lane.kn").input("src/stdlib/meta_lane.kn").input("src/stdlib/thread_lane.kn").input("src/stdlib/mcp_lane.kn").input("src/stdlib/process_lane.kn").input("src/stdlib/diagnostics_lane.kn").input("src/stdlib/platform_lane.kn").input("src/stdlib/os_lane.kn").input("src/stdlib/cuda_lane.kn").input("src/stdlib/interop_lane.kn").input("src/stdlib/python_bridge_arrays_lane.kn").input("src/stdlib/python_async_lane.kn").input("src/stdlib/z3_lane.kn").input("src/interop/sqlite_rally.kn").input("src/interop/c_bridge.kn").input("src/interop/c_abi_album.kn").input("src/telemetry/report.kn").input("src/telemetry/headless_host.kn").input("src/telemetry/flow.kn").input("src/ui/dashboard.kn").input("src/ui/presenter.kn").input("native/sqlite3.h").input("native/sqlite3.c").input("native/sqlite3ext.h").input("native/smoketest_sqlite_pingpong.h").input("native/smoketest_sqlite_pingpong.c").input("native/smoketest_visualizer_bridge.h").input("native/smoketest_visualizer_bridge.c").input("build-smoketest-visualizer-bridge.ps1").input("run-visual-smoketest.ps1").input("vendor/sqlite-src/manifest.uuid").input("KAIN.toml").input("build.kn")

    let check_runner = exec_task("check-telemetry-runner").command("powershell").cwd("..").telemetry("smoketest.python-ffi").input("telemetry/invoke_kain.ps1").input("telemetry/python_bridge.kn").input("telemetry/run_smoketest_mode.kn").input("src/telemetry/report.kn").input("build.kn").arg("-NoProfile").arg("-ExecutionPolicy").arg("Bypass").arg("-File").arg("$root/telemetry/invoke_kain.ps1").arg("check").arg("smoketest/telemetry/run_smoketest_mode.kn").arg("--target").arg("interpret")

    let check_spirv = build_check("check-spirv").entry("src/gpu/fragment.kn").target("spirv").axis("target", "spirv").telemetry("llm.gpu").input("src/gpu/fragment.kn").input("src/gpu/compute.kn").input("build.kn")

    let check_wasm = build_check("check-wasm").entry("src/wasm/wasm_main.kn").target("wasm").axis("target", "wasm").telemetry("llm.wasm").input("src/wasm/wasm_main.kn").input("build.kn")

    let gpu_spirv = build_task("gpu-spirv").kind("gpu").entry("src/gpu/fragment.kn").target("spirv").artifact_root(".kain/out/spirv").requires("check-spirv").input("src/gpu/fragment.kn").input("src/gpu/compute.kn")

    let gpu_cuda = build_task("gpu-cuda").kind("gpu").entry("src/gpu/compute.kn").target("cuda").artifact_root(".kain/out/cuda").requires("check-spirv").input("src/gpu/compute.kn")

    let gpu_hlsl = build_task("gpu-hlsl").kind("gpu").entry("src/gpu/fragment.kn").target("hlsl").artifact_root(".kain/out/hlsl").requires("check-spirv").input("src/gpu/fragment.kn").input("src/gpu/compute.kn")

    let source_tests = test_suite("source-tests").entry("src/main.kn").target("llvm").requires("check-llvm").input("src/main.kn").input("src/systems/abi_control.kn").input("src/systems/vm_topology.kn").input("src/systems/mmio_interrupt.kn").input("src/systems/native_cli.kn").input("src/telemetry/report.kn").input("src/telemetry/headless_host.kn").input("src/telemetry/flow.kn").input("src/ui/dashboard.kn").input("src/ui/presenter.kn").input("src/interop/sqlite_rally.kn").input("src/interop/c_bridge.kn").input("src/interop/c_abi_album.kn").input("src/stdlib/mcp_lane.kn").input("native/sqlite3.h").input("native/sqlite3.c").input("native/sqlite3ext.h").input("native/smoketest_sqlite_pingpong.h").input("native/smoketest_sqlite_pingpong.c").input("native/smoketest_visualizer_bridge.h").input("native/smoketest_visualizer_bridge.c").input("build-smoketest-visualizer-bridge.ps1").input("run-visual-smoketest.ps1").input("vendor/sqlite-src/manifest.uuid").input("KAIN.toml").input("build.kn")

    let root_exe = native_executable("root-executable").entry("src/main.kn").root_output("$blade/smoketest.exe").requires("check-llvm").requires("check-spirv").requires("check-wasm").requires("source-tests").input("src/main.kn").input("src/systems/abi_control.kn").input("src/systems/vm_topology.kn").input("src/systems/mmio_interrupt.kn").input("src/systems/native_cli.kn").input("src/telemetry/report.kn").input("src/telemetry/headless_host.kn").input("src/telemetry/flow.kn").input("src/ui/dashboard.kn").input("src/ui/presenter.kn").input("src/interop/sqlite_rally.kn").input("src/interop/c_bridge.kn").input("src/interop/c_abi_album.kn").input("src/stdlib/mcp_lane.kn").input("native/sqlite3.h").input("native/sqlite3.c").input("native/sqlite3ext.h").input("native/smoketest_sqlite_pingpong.h").input("native/smoketest_sqlite_pingpong.c").input("native/smoketest_visualizer_bridge.h").input("native/smoketest_visualizer_bridge.c").input("build-smoketest-visualizer-bridge.ps1").input("run-visual-smoketest.ps1").input("vendor/sqlite-src/manifest.uuid").input("KAIN.toml").input("build.kn")

    let telemetry_full = exec_task("telemetry-full").command("powershell").cwd("..").requires("root-executable").requires("check-telemetry-runner").telemetry("smoketest.full").input("src/main.kn").input("src/systems/abi_control.kn").input("src/systems/vm_topology.kn").input("src/systems/mmio_interrupt.kn").input("src/systems/native_cli.kn").input("src/telemetry/report.kn").input("src/telemetry/headless_host.kn").input("src/telemetry/flow.kn").input("telemetry/invoke_kain.ps1").input("telemetry/python_bridge.kn").input("telemetry/run_smoketest_mode.kn").input("src/interop/sqlite_rally.kn").input("src/interop/c_bridge.kn").input("src/interop/c_abi_album.kn").input("native/sqlite3.h").input("native/sqlite3.c").input("native/sqlite3ext.h").input("native/smoketest_sqlite_pingpong.h").input("native/smoketest_sqlite_pingpong.c").input("vendor/sqlite-src/manifest.uuid").input("KAIN.toml").arg("-NoProfile").arg("-ExecutionPolicy").arg("Bypass").arg("-File").arg("$root/telemetry/invoke_kain.ps1").arg("run").arg("smoketest/telemetry/run_smoketest_mode.kn").arg("--target").arg("interpret").arg("--").arg("--mode").arg("full").arg("--executable").arg("$root/smoketest.exe").arg("--output-dir").arg("$root/telemetry/full").output("$root/telemetry/full")

    let bench_album = exec_task("album-benchmark").command("powershell").cwd("..").requires("root-executable").requires("check-telemetry-runner").telemetry("smoketest.benchmark").input("src/main.kn").input("src/systems/abi_control.kn").input("src/systems/vm_topology.kn").input("src/systems/mmio_interrupt.kn").input("src/systems/native_cli.kn").input("src/telemetry/flow.kn").input("telemetry/invoke_kain.ps1").input("telemetry/python_bridge.kn").input("telemetry/run_smoketest_mode.kn").input("src/interop/sqlite_rally.kn").input("src/interop/c_bridge.kn").input("src/interop/c_abi_album.kn").input("native/sqlite3.h").input("native/sqlite3.c").input("native/sqlite3ext.h").input("native/smoketest_sqlite_pingpong.h").input("native/smoketest_sqlite_pingpong.c").input("vendor/sqlite-src/manifest.uuid").input("KAIN.toml").arg("-NoProfile").arg("-ExecutionPolicy").arg("Bypass").arg("-File").arg("$root/telemetry/invoke_kain.ps1").arg("run").arg("smoketest/telemetry/run_smoketest_mode.kn").arg("--target").arg("interpret").arg("--").arg("--mode").arg("benchmark").arg("--executable").arg("$root/smoketest.exe").arg("--output-dir").arg("$root/telemetry/benchmark").arg("--bench-rounds").arg("256").arg("--bench-passes").arg("6").output("$root/telemetry/benchmark")

    let attrition_album = exec_task("album-attrition").command("powershell").cwd("..").requires("root-executable").requires("check-telemetry-runner").telemetry("smoketest.attrition").input("src/main.kn").input("src/systems/abi_control.kn").input("src/systems/vm_topology.kn").input("src/systems/mmio_interrupt.kn").input("src/systems/native_cli.kn").input("src/telemetry/flow.kn").input("telemetry/invoke_kain.ps1").input("telemetry/python_bridge.kn").input("telemetry/run_smoketest_mode.kn").input("src/interop/sqlite_rally.kn").input("src/interop/c_bridge.kn").input("src/interop/c_abi_album.kn").input("native/sqlite3.h").input("native/sqlite3.c").input("native/sqlite3ext.h").input("native/smoketest_sqlite_pingpong.h").input("native/smoketest_sqlite_pingpong.c").input("vendor/sqlite-src/manifest.uuid").input("KAIN.toml").arg("-NoProfile").arg("-ExecutionPolicy").arg("Bypass").arg("-File").arg("$root/telemetry/invoke_kain.ps1").arg("run").arg("smoketest/telemetry/run_smoketest_mode.kn").arg("--target").arg("interpret").arg("--").arg("--mode").arg("attrition").arg("--executable").arg("$root/smoketest.exe").arg("--output-dir").arg("$root/telemetry/attrition").arg("--attrition-ops").arg("20").arg("--attrition-rounds").arg("96").output("$root/telemetry/attrition")

    let certify = certify_gate("certify").requires("check-llvm").requires("check-telemetry-runner").requires("check-spirv").requires("check-wasm").requires("source-tests").requires("root-executable").requires("telemetry-full").requires("album-benchmark").requires("album-attrition").certifies("smoketest.local")

    let capsule = amalgamate_capsule("smoketest-capsule").path(".").output("$root/smoketest.kn").name("smoketest").version("0.1.0").tag("portable").tag("smoketest").note("Editable smoketest source capsule emitted in the blade root after certify.").meta("album", "smoketest").meta("flow", "full-certify").storage("editable").contents("source").capsule_set("smoketest").header("rich").preview_symbols(96).depends_on("certify").telemetry("smoketest.capsule")

    let capsule_artifacts = amalgamate_capsule("smoketest-capsule-artifacts").path(".").output("$root/smoketest.artifacts.kn").name("smoketest-artifacts").version("0.1.0").tag("portable").tag("smoketest").tag("artifacts").note("Generated smoketest artifact companion capsule emitted after certify.").meta("album", "smoketest").meta("flow", "full-certify").storage("editable").contents("artifacts").capsule_set("smoketest").header("minimal").preview_symbols(0).depends_on("certify").telemetry("smoketest.capsule")

    let capsule_evidence = amalgamate_capsule("smoketest-capsule-evidence").path(".").output("$root/smoketest.evidence.kn").name("smoketest-evidence").version("0.1.0").tag("portable").tag("smoketest").tag("evidence").note("Telemetry and evidence companion capsule emitted after certify.").meta("album", "smoketest").meta("flow", "full-certify").storage("editable").contents("evidence").capsule_set("smoketest").header("minimal").preview_symbols(0).depends_on("certify").telemetry("smoketest.capsule")

    return build_graph().workspace(ws).package(pkg).blade(blade_spec).defaults(defaults).run(run).task(check_llvm).task(check_runner).task(check_spirv).task(check_wasm).task(gpu_spirv).task(gpu_cuda).task(gpu_hlsl).task(source_tests).task(root_exe).task(telemetry_full).task(bench_album).task(attrition_album).task(certify).task(capsule).task(capsule_artifacts).task(capsule_evidence)
