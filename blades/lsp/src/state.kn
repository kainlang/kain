// LSP Shared State Types — constants, structs, and constructors for LSP protocol
// surfaces. Extracted from lsp.kn so both LSP and MCP protocol modules can share
// the same type definitions without circular imports.
//
// This module owns NO protocol dispatch logic — only types + constants.

use std::json
use std::kain

