// fluid.comp.kn — 2D GPU fluid simulation via SPIR-V compute
// Semi-Lagrangian advection with velocity diffusion on a 256x256 grid.
// Each cell stores [vx, vy, density] as contiguous Float values.

shader compute FluidStep(id: UVec3) -> Void workgroup(8, 8, 1):
    uniform prev: StorageBuffer<Float> @0
    uniform next_: StorageBuffer<Float> @1

    comptime:
        let compute = (
            [32, 32, 1],
            [
                ("prev", "f32", ["196608"], "input", "kain.shared.buffer"),
                ("next_", "f32", ["196608"], "output", "kain.shared.buffer"),
            ],
            [],
        )

    let x = id.x
    let y = id.y

    if x > UInt(254) or y > UInt(254):
        return

    let gs = UInt(256)
    let idx = (y * gs + x) * UInt(3)

    let vx = prev[idx]
    let vy = prev[idx + UInt(1)]
    let den = prev[idx + UInt(2)]

    // Trace backward along velocity for semi-Lagrangian advection
    let px = Float(x) - vx * 0.5
    let py = Float(y) - vy * 0.5

    // Clamp to grid bounds
    let sx = max(0.0, min(255.0, px))
    let sy = max(0.0, min(255.0, py))

    let ix = UInt(sx)
    let iy = UInt(sy)
    let fx = sx - Float(ix)
    let fy = sy - Float(iy)

    let nx = if ix + UInt(1) < gs: ix + UInt(1) else: ix
    let ny = if iy + UInt(1) < gs: iy + UInt(1) else: iy

    let s00 = (iy * gs + ix) * UInt(3)
    let s10 = (iy * gs + nx) * UInt(3)
    let s01 = (ny * gs + ix) * UInt(3)
    let s11 = (ny * gs + nx) * UInt(3)

    // Bilinear interpolation weights
    let w00 = (1.0 - fx) * (1.0 - fy)
    let w10 = fx * (1.0 - fy)
    let w01 = (1.0 - fx) * fy
    let w11 = fx * fy

    // Bilinear sample of velocity and density
    let nvx = prev[s00] * w00 + prev[s10] * w10 + prev[s01] * w01 + prev[s11] * w11
    let nvy = prev[s00 + UInt(1)] * w00 + prev[s10 + UInt(1)] * w10 + prev[s01 + UInt(1)] * w01 + prev[s11 + UInt(1)] * w11
    let nden = prev[s00 + UInt(2)] * w00 + prev[s10 + UInt(2)] * w10 + prev[s01 + UInt(2)] * w01 + prev[s11 + UInt(2)] * w11

    // Velocity diffusion + damping
    let dvx = nvx * 0.995
    let dvy = nvy * 0.995

    // Density advection with slight fade
    let dden = nden * 0.9995

    // Rotating force source at center — drives the fluid motion
    let cx = Float(x) - 128.0
    let cy = Float(y) - 128.0
    let dist_sq = cx * cx + cy * cy
    let source = 1.0 / (1.0 + dist_sq * 0.008)

    let force_vx = -cy * source * 0.025
    let force_vy = cx * source * 0.025

    next_[idx] = dvx + force_vx
    next_[idx + UInt(1)] = dvy + force_vy
    next_[idx + UInt(2)] = max(0.0, dden + source * 0.5)

    return
