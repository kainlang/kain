fn clamp_float(val: Float, min_val: Float, max_val: Float) -> Float:
    if val < min_val:
        return min_val
    elif val > max_val:
        return max_val
    return val

fn store_i32(buf: ptr<Int>, idx: Int, value: Int) -> Void with Unsafe:
    mem_store(ptr_offset(buf, idx, "I32"), value, "I32")

fn load_i32(buf: ptr<Int>, idx: Int) -> Int with Unsafe:
    return mem_load(ptr_offset(buf, idx, "I32"), "I32")

fn double_to_f32_bits(val: Float) -> Int with Unsafe:
    if val == 0.0:
        return 0
    let bits: Int = bitcast(val, "I64")
    let sign: Int = (bits >> 63) & 1
    let exp: Int = ((bits >> 52) & 2047) - 1023 + 127
    let mant: Int = (bits >> 29) & 8388607
    
    var final_exp: Int = exp
    if exp < 0:
        final_exp = 0
    elif exp > 255:
        final_exp = 255
        
    return (sign << 31) | (final_exp << 23) | mant

fn f32_bits_to_double(bits: Int, pow_lut: ptr<Float>) -> Float with Unsafe:
    if bits == 0:
        return 0.0
    let sign: Float = if (bits & 2147483648) != 0: -1.0 else: 1.0
    let exp: Int = (bits >> 23) & 255
    let mant: Int = bits & 8388607
    
    if exp == 0 and mant == 0:
        return 0.0
        
    let frac: Float = (mant as Float) / 8388608.0
    let mantissa: Float = 1.0 + frac
    let power: Float = mem_load(ptr_offset(pow_lut, exp, "Float"), "Float")
    
    return sign * mantissa * power

fn print_c_str(p: ptr<Void>) -> Void with Unsafe:
    if ptr_to_int(p) == 0:
        return
    var idx = 0
    var c = mem_load(ptr_offset(p, idx, "I8"), "I8")
    while c != 0:
        let _ = my_putchar(c)
        idx = idx + 1
        c = mem_load(ptr_offset(p, idx, "I8"), "I8")
    let _ = my_putchar(10) // newline

fn set_crt_env(name: String, value: String) -> Void with Unsafe:
    let env_str = name + "=" + value
    let len_val = len(env_str)
    let buf = alloc_zeroed(len_val + 1, "Int")
    var i = 0
    while i < len_val:
        let c = byte_at(env_str, i)
        mem_store(ptr_offset(buf, i, "I8"), c, "I8")
        i = i + 1
    mem_store(ptr_offset(buf, len_val, "I8"), 0, "I8")
    let _ = my_putenv(int_to_ptr(ptr_to_int(buf), "ptr<Void>"))

fn main() -> Int with Unsafe, GPU:
    let boot = runtime_init()
    if boot != 0:
        return boot

    println("==================================================")
    println("      KAIN PURE WIN32 SHADER FLUID SIMULATOR      ")
    println("==================================================")
    println("Initializing Win32 window...")

    // Set environment variables for shader residency, bundle and runtime library
    let res_json = ".kain/out/gpu/spirv/kain_compute_residency.json"
    let bundle_json = ".kain/out/gpu/spirv/gpu-artifacts-spirv.shader_bundle.json"
    let dll_path = "X:\\.kain\\cache\\run\\llvm\\kain_gpu_runtime.dll"
    set_crt_env("KAIN_COMPUTE_RESIDENCY", res_json)
    set_crt_env("KAIN_CUDA_SHADER_BUNDLE", bundle_json)
    set_crt_env("KAIN_GPU_RUNTIME_LIBRARY", dll_path)
    println("Set environment variables for CRT residency, bundle, and library.")

    // WS_OVERLAPPEDWINDOW = 0x00CF0000 | WS_VISIBLE = 0x10000000
    let style = 0x00CF0000 | 0x10000000
    let hwnd = my_CreateWindowExA(
        0,
        "STATIC",
        "Kain Fluid Simulation Visualizer",
        style,
        100,
        100,
        528, // width
        551, // height
        int_to_ptr(0, "Void"),
        int_to_ptr(0, "Void"),
        int_to_ptr(0, "Void"),
        int_to_ptr(0, "Void")
    )
    println("hwnd=" + str(ptr_to_int(hwnd)))
    if ptr_to_int(hwnd) == 0:
        println("Failed to create window. LastError=" + str(my_GetLastError()))
        let _ = runtime_shutdown()
        return 1

    // Subclass the static window class to DefWindowProcA
    let user32 = my_GetModuleHandleA("user32.dll")
    let def_wnd_proc = my_GetProcAddress(user32, "DefWindowProcA")
    let old_proc = my_SetWindowLongPtrA(hwnd, -4, def_wnd_proc) // GWLP_WNDPROC = -4
    println("Subclassed window. Old proc=" + str(ptr_to_int(old_proc)))

    let hdc = my_GetDC(hwnd)
    println("hdc=" + str(ptr_to_int(hdc)))

    // Precalculate exponents LUT
    println("Precalculating exponent LUT...")
    let pow_lut = alloc_zeroed(256, "Float")
    var e: Int = 0
    while e < 256:
        let power_exp = e - 127
        var power: Float = 1.0
        if power_exp > 0:
            var i: Int = 0
            while i < power_exp:
                power = power * 2.0
                i = i + 1
        elif power_exp < 0:
            var i: Int = 0
            let limit = 0 - power_exp
            while i < limit:
                power = power / 2.0
                i = i + 1
        mem_store(ptr_offset(pow_lut, e, "Float"), power, "Float")
        e = e + 1

    let prev_buf = alloc_zeroed(98304, "Int")
    let next_buf = alloc_zeroed(98304, "Int")
    let fb = alloc_zeroed(32768, "Int")

    let bmi = alloc_zeroed(5, "Int")
    mem_store(ptr_offset(bmi, 0, "Int"), (256 << 32) | 40, "Int")
    mem_store(ptr_offset(bmi, 1, "Int"), (2097153 << 32) | 4294967040, "Int")
    mem_store(ptr_offset(bmi, 2, "Int"), 0, "Int")
    mem_store(ptr_offset(bmi, 3, "Int"), 0, "Int")
    mem_store(ptr_offset(bmi, 4, "Int"), 0, "Int")

    let msg_buf = alloc_zeroed(6, "Int")
    let msg_ptr = int_to_ptr(ptr_to_int(msg_buf), "ptr<Void>")

    // Initialize center cell with density and velocity
    var init_y: Int = 120
    while init_y < 136:
        var init_x: Int = 120
        while init_x < 136:
            let cell_idx = (init_y * 256 + init_x) * 3
            store_i32(prev_buf, cell_idx + 2, double_to_f32_bits(10.0)) // density
            store_i32(prev_buf, cell_idx, double_to_f32_bits(1.5))       // vx
            store_i32(prev_buf, cell_idx + 1, double_to_f32_bits(1.5))   // vy
            init_x = init_x + 1
        init_y = init_y + 1

    let prev_path = ".kain/out/gpu/spirv/kain_compute_residency_shader_fluidstep_compute_prev.bin"
    let next_path = ".kain/out/gpu/spirv/kain_compute_residency_shader_fluidstep_compute_next.bin"

    println("Entering simulation loop...")

    var frame: Int = 0
    while my_IsWindow(hwnd) != 0:
        if frame == 0:
            println("Loop iteration 0: Peeking messages...")
            
        // 1. Process Win32 messages
        let has_msg = my_PeekMessageA(msg_ptr, int_to_ptr(0, "Void"), 0, 0, 1)
        if frame == 0:
            println("PeekMessageA returned: " + str(has_msg))
            
        var msg_count = 0
        var loop_msg = has_msg
        while loop_msg != 0:
            msg_count = msg_count + 1
            let msg_type = mem_load(ptr_offset(msg_buf, 1, "Int"), "Int") & 4294967295
            if frame == 0:
                println("Msg " + str(msg_count) + " type: " + str(msg_type))
            if msg_type == 16: // WM_CLOSE
                println("WM_CLOSE received. Destroying window...")
                let _ = my_DestroyWindow(hwnd)
            elif msg_type == 15: // WM_PAINT
                let _ = my_ValidateRect(hwnd, int_to_ptr(0, "Void"))
            elif msg_type == 20: // WM_ERASEBKGND
                let _ = 0 // Skip dispatching to prevent white background erase
            else:
                if msg_type == 512: // WM_MOUSEMOVE
                    let wParam_val = mem_load(ptr_offset(msg_buf, 2, "Int"), "Int")
                    if (wParam_val & 1) != 0: // MK_LBUTTON is down
                        let lParam_val = mem_load(ptr_offset(msg_buf, 3, "Int"), "Int")
                        let mx = lParam_val & 65535
                        let my = (lParam_val >> 16) & 65535
                        let gx = mx / 2
                        let gy = my / 2
                        if gx >= 2 and gx < 254 and gy >= 2 and gy < 254:
                            var dy: Int = -2
                            while dy <= 2:
                                var dx: Int = -2
                                while dx <= 2:
                                    let nx = gx + dx
                                    let ny = gy + dy
                                    if nx >= 0 and nx < 256 and ny >= 0 and ny < 256:
                                        let cell_idx = (ny * 256 + nx) * 3
                                        store_i32(prev_buf, cell_idx + 2, double_to_f32_bits(10.0))
                                        store_i32(prev_buf, cell_idx, double_to_f32_bits(Float(dx) * 2.5))
                                        store_i32(prev_buf, cell_idx + 1, double_to_f32_bits(Float(dy) * 2.5))
                                    dx = dx + 1
                                dy = dy + 1
                let _ = my_TranslateMessage(msg_ptr)
                let _ = my_DispatchMessageA(msg_ptr)
            loop_msg = my_PeekMessageA(msg_ptr, int_to_ptr(0, "Void"), 0, 0, 1)

        if frame == 0:
            println("Processed " + str(msg_count) + " messages. Writing prev.bin...")

        // 2. Write prev_buf to prev.bin
        let f_prev = fs_open(prev_path, "wb")
        if frame == 0:
            println("fs_open prev_path handle: " + str(ptr_to_int(f_prev.handle)))
        if ptr_to_int(f_prev.handle) == 0:
            println("Error: failed to open prev.bin for writing!")
            let _ = runtime_shutdown()
            return 1
        if frame == 0:
            var check_idx: Int = 0
            var non_zero_count: Int = 0
            while check_idx < 196608:
                if load_i32(prev_buf, check_idx) != 0:
                    non_zero_count = non_zero_count + 1
                check_idx = check_idx + 1
            println("Frame 0 prev_buf non-zero elements: " + str(non_zero_count))
        let bytes_written = fs_write(f_prev, prev_buf, 786432)
        if frame == 0:
            println("fs_write prev.bin bytes: " + str(bytes_written))
        let _ = fs_close(f_prev)

        // Query starting handle to detect leaks during dispatch
        let h_start = my_CreateEventA(int_to_ptr(0, "Void"), 0, 0, int_to_ptr(0, "Void"))
        let _ = my_CloseHandle(h_start)

        if frame == 0:
            println("Dispatching shader...")

        // 3. Dispatch compute shader
        dispatch "shader::FluidStep::compute" [32, 32, 1]
        if frame == 0:
            let last_status = my_abi_cuda_last_status()
            println("Last CUDA status: " + str(last_status))
            if last_status != 0:
                print("Error Kind: ")
                let _ = print_c_str(my_abi_cuda_last_error_kind())
                print("Error Message: ")
                let _ = print_c_str(my_abi_cuda_last_error_message())

        if frame == 0:
            println("Shader dispatched. Reading next.bin...")

        // 4. Read next.bin to next_buf
        let f_next = fs_open(next_path, "rb")
        if frame == 0:
            println("fs_open next_path handle: " + str(ptr_to_int(f_next.handle)))
        if ptr_to_int(f_next.handle) == 0:
            println("Error: failed to open next.bin for reading!")
            let _ = runtime_shutdown()
            return 1
        let bytes_read = fs_read(f_next, next_buf, 786432)
        if frame == 0:
            println("fs_read next.bin bytes: " + str(bytes_read))
            var check_idx: Int = 0
            var non_zero_count: Int = 0
            while check_idx < 196608:
                if load_i32(next_buf, check_idx) != 0:
                    non_zero_count = non_zero_count + 1
                check_idx = check_idx + 1
            println("Frame 0 next_buf non-zero elements: " + str(non_zero_count))
        let _ = fs_close(f_next)

        if frame == 0:
            println("Packing pixels...")

        // 5. Pack next_buf floats to BGRA pixels in fb (2 pixels at a time)
        var y: Int = 0
        while y < 256:
            var x: Int = 0
            while x < 256:
                // Pixel 0
                let idx0 = (y * 256 + x) * 3
                let vx0 = f32_bits_to_double(load_i32(next_buf, idx0), pow_lut)
                let vy0 = f32_bits_to_double(load_i32(next_buf, idx0 + 1), pow_lut)
                let den0 = f32_bits_to_double(load_i32(next_buf, idx0 + 2), pow_lut)
                let c_den0 = clamp_float(den0, 0.0, 1.0)
                let speed_sq0 = vx0 * vx0 + vy0 * vy0
                let r0 = (c_den0 * 255.0) as Int
                let g0 = (clamp_float((c_den0 * c_den0) * 150.0 + speed_sq0 * 100.0, 0.0, 255.0)) as Int
                let b0 = (clamp_float((c_den0 * c_den0 * c_den0) * 80.0 + speed_sq0 * 200.0, 0.0, 255.0)) as Int
                let pixel0 = (255 << 24) | (r0 << 16) | (g0 << 8) | b0

                // Pixel 1
                let idx1 = (y * 256 + x + 1) * 3
                let vx1 = f32_bits_to_double(load_i32(next_buf, idx1), pow_lut)
                let vy1 = f32_bits_to_double(load_i32(next_buf, idx1 + 1), pow_lut)
                let den1 = f32_bits_to_double(load_i32(next_buf, idx1 + 2), pow_lut)
                let c_den1 = clamp_float(den1, 0.0, 1.0)
                let speed_sq1 = vx1 * vx1 + vy1 * vy1
                let r1 = (c_den1 * 255.0) as Int
                let g1 = (clamp_float((c_den1 * c_den1) * 150.0 + speed_sq1 * 100.0, 0.0, 255.0)) as Int
                let b1 = (clamp_float((c_den1 * c_den1 * c_den1) * 80.0 + speed_sq1 * 200.0, 0.0, 255.0)) as Int
                let pixel1 = (255 << 24) | (r1 << 16) | (g1 << 8) | b1

                // Pack both into a 64-bit integer
                let packed = (pixel1 << 32) | pixel0
                let int_idx = (y * 256 + x) / 2
                mem_store(ptr_offset(fb, int_idx, "Int"), packed, "Int")
                
                x = x + 2
            y = y + 1

        if frame == 0:
            println("Drawing DIB...")

        // 6. Draw to the window client area (Stretch to fit)
        let draw_status = my_StretchDIBits(
            hdc,
            0,
            0,
            512,
            512,
            0,
            0,
            256,
            256,
            int_to_ptr(ptr_to_int(fb), "ptr<Void>"),
            int_to_ptr(ptr_to_int(bmi), "ptr<Void>"),
            0,
            0x00CC0020 // SRCCOPY
        )
        if frame == 0:
            println("StretchDIBits returned: " + str(draw_status))

        // Validate client area after drawing to prevent WM_PAINT flood
        let _ = my_ValidateRect(hwnd, int_to_ptr(0, "Void"))

        // 7. Copy next_buf to prev_buf for the next frame
        var c: Int = 0
        while c < 98304:
            mem_store(ptr_offset(prev_buf, c, "Int"), mem_load(ptr_offset(next_buf, c, "Int"), "Int"), "Int")
            c = c + 1

        // 8. Reclaim leaked file handles from GPU runtime dispatch
        let h_end = my_CreateEventA(int_to_ptr(0, "Void"), 0, 0, int_to_ptr(0, "Void"))
        let _ = my_CloseHandle(h_end)
        var h = ptr_to_int(h_start)
        let end_h = ptr_to_int(h_end)
        if frame == 0:
            println("Closing leaked residency handles...")
        while h < end_h:
            let h_ptr = int_to_ptr(h, "Void")
            if my_GetFileType(h_ptr) == 1: // FILE_TYPE_DISK = 1
                if frame == 0:
                    println("Reclaiming leaked disk file handle: " + str(h))
                let _ = my_CloseHandle(h_ptr)
            h = h + 4

        my_Sleep(16)

        if frame % 60 == 0:
            println("Rendered frame: " + str(frame))
        frame = frame + 1

    println("Window closed. Cleaning up...")
    let _ = my_ReleaseDC(hwnd, hdc)
    decay pow_lut
    decay bmi
    decay msg_buf
    decay fb
    decay next_buf
    decay prev_buf

    let _ = runtime_shutdown()
    return 0
