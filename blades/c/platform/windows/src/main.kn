// ============================================================================
//           RAW WINDOWS.H — Zero Shim, Zero Bridge, Zero Apology
// ============================================================================
// Proves: libclang parses the REAL Windows SDK header.
//         6,294 function declarations extracted from <windows.h> itself.
//         No hand-written shim, no C bridge code, no macro workarounds.
//
// ============================================================================
include <windows.h> as win

fn main() -> Int with Unsafe:
    // MessageBoxA(HWND, LPCSTR, LPCSTR, UINT) -> int
    // HWND=0 (NULL parent), MB_OK=0
    let result = win_MessageBoxA(0, "libclang parsed 6294 functions from windows.h!", "Kain Win32", 0)

    // IDOK = 1.  Exit 0 on success, 99 on failure.
    return if result == 1: 0 else: 99
