use std::io
use cause
use diagnostics

fn main() -> Int:
    println("=== TESTING IMPORT FROM AMALGAMATED CAPSULE ===")
    println("")
    
    // Run cause tests directly (imported from cause.kn inside the capsule)
    println("═══ Cause: cause_sanity ═══")
    let r1 = run_cause_test_by_tag("cause_sanity")
    if r1 == 0:
        println("  [PASS] cause_sanity")
    else:
        println("  [FAIL] cause_sanity (code: " + str(r1) + ")")
    
    println("")
    println("═══ Running diagnostics (imported from capsule) ═══")
    // Run the full diagnostics suite from the amalgamated capsule
    let dr = run_diagnostics("all", true)
    
    println("")
    println("Import from amalgamation: SUCCESS")
    return dr
