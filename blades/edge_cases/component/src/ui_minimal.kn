use std::runtime
use std::ui

fn main() -> Int:
    let init = runtime_init()
    println("init: " + str(init))

    let sid = ui_session_create("test", 400, 300)
    println("session: " + str(sid))

    if sid <= 0:
        runtime_shutdown()
        return 1

    ui_session_destroy(sid)
    runtime_shutdown()
    println("done")
    return 0
