// Triggers: Effect polymorphic function instantiated with conflicting effects
fn run<E>(f: fn() with E) with E:
    f()

fn pure_work() with Pure:
    return

fn io_work() with IO:
    println("io")

fn main():
    run(pure_work)
    run(io_work)
