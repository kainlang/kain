// resources/shaders/spectrogram_render.glsl
// Compute shader: GPU FFT-based spectrogram rendering
// Processes audio buffer → FFT → spectrogram heatmap in one pass
// Layer: L6 Machine — GPU compute
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer SrcBuf {
    float src[];
};

layout(binding = 1, std430) writeonly buffer DstBuf {
    uint8_t dst[];
};

layout(push_constant) uniform PushConstants {
    uint numSamples;
    uint fftSize;
    uint viewportWidth;
    uint viewportHeight;
    float freqMin;
    float freqMax;
    float dynamicRange; // dB range for colormap
    uint colormap; // 0=inferno, 1=viridis, 2=plasma, 3=greyscale
} pc;

// Colormap functions for spectrogram display
vec3 inferno(float t) {
    // Simplified inferno colormap
    return vec3(
        clamp(t * 2.5, 0.0, 1.0),
        clamp(t * 1.8 - 0.3, 0.0, 1.0),
        clamp(t * 3.0 - 1.0, 0.0, 1.0)
    );
}

vec3 viridis(float t) {
    // Simplified viridis colormap
    return vec3(
        clamp(t * 1.5, 0.0, 1.0),
        clamp(t * 2.0 - 0.2, 0.0, 1.0),
        clamp(1.0 - t * 1.8, 0.0, 1.0)
    );
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x >= pc.viewportWidth || y >= pc.viewportHeight) return;

    // Map pixel coordinates to frequency and time
    // Each column = one FFT window, each row = frequency bin
    uint timeCol = x; // FFT window index
    uint freqRow = pc.viewportHeight - 1 - y; // Invert Y

    // Simple placeholder: magnitude from FFT bin
    // Full implementation uses FFT kernel + magnitude computation
    uint sampleIdx = timeCol * pc.fftSize + freqRow;
    float mag = 0.0;
    if (sampleIdx < pc.numSamples) {
        mag = abs(src[sampleIdx]);
    }

    // Normalize to dB scale
    float db = 20.0 * log2(mag + 1e-10);
    float t = clamp((db + pc.dynamicRange) / pc.dynamicRange, 0.0, 1.0);

    // Apply colormap
    vec3 col = viridis(t);

    uint pixelIdx = (y * pc.viewportWidth + x) * 4;
    dst[pixelIdx + 0] = uint8_t(clamp(col.r * 255.0, 0.0, 255.0));
    dst[pixelIdx + 1] = uint8_t(clamp(col.g * 255.0, 0.0, 255.0));
    dst[pixelIdx + 2] = uint8_t(clamp(col.b * 255.0, 0.0, 255.0));
    dst[pixelIdx + 3] = 255;
}
