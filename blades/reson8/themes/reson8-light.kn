// themes/reson8-light.kn -- Light theme for reson8 with blue accents
// Clean, bright, professional -- blue (#2563eb) accents

use std::math
use worlds::theme_world

patch apply_light_identity(tw: ThemeWorld):
    tw.active_theme_name = "reson8-light"
    tw.theme_version = 1
    tw.theme_author = "reson8"
    tw.theme_description = "Light theme with blue accents"

// ── Surface Colors ──
patch apply_light_surfaces(tw: ThemeWorld):
    tw.color_bg_primary       = color_rgba(0.97, 0.98, 0.99, 1.0)  // #f8fafc
    tw.color_bg_secondary     = color_rgba(0.95, 0.96, 0.98, 1.0)  // #f1f5f9
    tw.color_bg_tertiary      = color_rgba(0.89, 0.91, 0.94, 1.0)  // #e2e8f0
    tw.color_surface          = color_rgba(1.00, 1.00, 1.00, 1.0)  // #ffffff
    tw.color_surface_raised   = color_rgba(0.97, 0.98, 0.99, 1.0)  // #f8fafc
    tw.color_surface_overlay  = color_rgba(0.95, 0.96, 0.98, 1.0)  // #f1f5f9
    tw.color_surface_dialog   = color_rgba(1.00, 1.00, 1.00, 1.0)  // #ffffff

patch apply_light_text(tw: ThemeWorld):
    tw.color_text_primary     = color_rgba(0.06, 0.09, 0.16, 1.0)  // #0f172a
    tw.color_text_secondary   = color_rgba(0.28, 0.33, 0.41, 1.0)  // #475569
    tw.color_text_muted       = color_rgba(0.58, 0.64, 0.72, 1.0)  // #94a3b8
    tw.color_text_inverse     = color_rgba(1.00, 1.00, 1.00, 1.0)  // #ffffff
    tw.color_text_link        = color_rgba(0.15, 0.39, 0.93, 1.0)  // #2563eb
    tw.color_text_error       = color_rgba(0.86, 0.15, 0.15, 1.0)  // #dc2626
    tw.color_text_success     = color_rgba(0.09, 0.63, 0.42, 1.0)  // #16a34a

patch apply_light_accent(tw: ThemeWorld):
    tw.color_accent           = color_rgba(0.15, 0.39, 0.93, 1.0)  // #2563eb
    tw.color_accent_hover     = color_rgba(0.23, 0.51, 0.99, 1.0)  // #3b82f6
    tw.color_accent_pressed   = color_rgba(0.11, 0.30, 0.85, 1.0)  // #1d4ed8
    tw.color_accent_alt       = color_rgba(0.49, 0.23, 0.93, 1.0)  // #7c3aed
    tw.color_accent_alt_hover = color_rgba(0.59, 0.33, 0.95, 1.0)  // #9650f8

patch apply_light_semantic(tw: ThemeWorld):
    tw.color_success          = color_rgba(0.09, 0.63, 0.42, 1.0)  // #16a34a
    tw.color_warning          = color_rgba(0.91, 0.55, 0.05, 1.0)  // #e88c0a
    tw.color_error            = color_rgba(0.86, 0.15, 0.15, 1.0)  // #dc2626
    tw.color_info             = color_rgba(0.15, 0.39, 0.93, 1.0)  // #2563eb

patch apply_light_borders(tw: ThemeWorld):
    tw.color_border_default   = color_rgba(0.89, 0.91, 0.94, 1.0)  // #e2e8f0
    tw.color_border_focus     = color_rgba(0.15, 0.39, 0.93, 1.0)  // #2563eb
    tw.color_border_error     = color_rgba(0.86, 0.15, 0.15, 1.0)  // #dc2626
    tw.color_border_subtle    = color_rgba(0.95, 0.96, 0.98, 1.0)  // #f1f5f9

