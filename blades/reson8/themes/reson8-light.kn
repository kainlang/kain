    tw.color_meter_mid        = color_rgba(0.91, 0.55, 0.05, 1.0)  // #e88c0a
    tw.color_meter_high       = color_rgba(0.86, 0.15, 0.15, 1.0)  // #dc2626
    tw.color_meter_over       = color_rgba(1.00, 0.00, 0.00, 1.0)  // #ff0000
    tw.color_meter_background = color_rgba(0.95, 0.96, 0.98, 1.0)  // #f1f5f9
    tw.color_meter_peak_hold  = color_rgba(0.06, 0.09, 0.16, 1.0)  // #0f172a

patch apply_light_waveform(tw: ThemeWorld):
    tw.color_waveform         = color_rgba(0.23, 0.51, 0.99, 1.0)  // #3b82f6
