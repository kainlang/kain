    tw.color_grid_bar         = color_rgba(0.58, 0.64, 0.72, 1.0)  // #94a3b8
    tw.color_ruler_bg         = color_rgba(0.95, 0.96, 0.98, 1.0)  // #f1f5f9
    tw.color_ruler_text       = color_rgba(0.42, 0.47, 0.55, 1.0)  // #6b7280

