    tw.color_midi_grid            = color_rgba(0.89, 0.91, 0.94, 1.0)  // #e2e8f0
    tw.color_midi_cc_bg           = color_rgba(0.97, 0.98, 0.99, 1.0)  // #f8fafc
    tw.color_midi_cc_line         = color_rgba(0.91, 0.55, 0.05, 1.0)  // #e88c0a

patch apply_light_clips(tw: ThemeWorld):
    tw.color_clip_default     = color_rgba(0.23, 0.51, 0.99, 1.0)  // #3b82f6
    tw.color_clip_selected    = color_rgba(0.15, 0.39, 0.93, 1.0)  // #2563eb
    tw.color_clip_muted       = color_rgba(0.58, 0.64, 0.72, 1.0)  // #94a3b8
    tw.color_clip_locked      = color_rgba(0.91, 0.55, 0.05, 1.0)  // #e88c0a
    tw.color_clip_recording   = color_rgba(0.86, 0.15, 0.15, 1.0)  // #dc2626
    tw.color_clip_header      = color_rgba(0.88, 0.93, 1.00, 1.0)  // #e0edff
    tw.color_clip_waveform    = color_rgba(0.15, 0.39, 0.93, 1.0)  // #2563eb
    tw.color_clip_fade_in     = color_rgba(0.09, 0.63, 0.42, 0.4)  // #16a34a66
    tw.color_clip_fade_out    = color_rgba(0.86, 0.15, 0.15, 0.4)  // #dc262666

patch apply_light_automation(tw: ThemeWorld):
    tw.color_automation_line         = color_rgba(0.91, 0.55, 0.05, 1.0) // #e88c0a
    tw.color_automation_point        = color_rgba(0.06, 0.09, 0.16, 1.0) // #0f172a
    tw.color_automation_point_selected = color_rgba(0.15, 0.39, 0.93, 1.0) // #2563eb
    tw.color_automation_lane_bg      = color_rgba(0.97, 0.98, 0.99, 1.0) // #f8fafc

patch apply_light_knobs_buttons_sliders(tw: ThemeWorld):
    tw.color_knob_track        = color_rgba(0.80, 0.84, 0.88, 1.0)  // #cbd5e1
    tw.color_knob_fill         = color_rgba(0.15, 0.39, 0.93, 1.0)  // #2563eb
    tw.color_knob_center       = color_rgba(1.00, 1.00, 1.00, 1.0)  // #ffffff
    tw.color_knob_indicator    = color_rgba(0.06, 0.09, 0.16, 1.0)  // #0f172a

    tw.color_button_default    = color_rgba(0.89, 0.91, 0.94, 1.0)   // #e2e8f0
    tw.color_button_hover      = color_rgba(0.80, 0.84, 0.88, 1.0)   // #cbd5e1
    tw.color_button_active     = color_rgba(0.15, 0.39, 0.93, 1.0)   // #2563eb
    tw.color_button_text       = color_rgba(0.06, 0.09, 0.16, 1.0)   // #0f172a
    tw.color_button_text_active = color_rgba(1.00, 1.00, 1.00, 1.0)  // #ffffff
    tw.color_button_disabled   = color_rgba(0.95, 0.96, 0.98, 1.0)   // #f1f5f9
    tw.color_button_text_disabled = color_rgba(0.58, 0.64, 0.72, 1.0) // #94a3b8

    tw.color_slider_track      = color_rgba(0.89, 0.91, 0.94, 1.0)   // #e2e8f0
    tw.color_slider_fill       = color_rgba(0.15, 0.39, 0.93, 1.0)   // #2563eb
    tw.color_slider_thumb      = color_rgba(0.06, 0.09, 0.16, 1.0)   // #0f172a
    tw.color_slider_thumb_hover = color_rgba(0.15, 0.39, 0.93, 1.0)  // #2563eb
    tw.color_fader_cap         = color_rgba(0.95, 0.96, 0.98, 1.0)   // #f1f5f9
    tw.color_fader_cap_line    = color_rgba(0.15, 0.39, 0.93, 1.0)   // #2563eb

patch apply_light_scrollbar_selection(tw: ThemeWorld):
    tw.color_scrollbar_track       = color_rgba(0.0, 0.0, 0.0, 0.0)
    tw.color_scrollbar_thumb       = color_rgba(0.58, 0.64, 0.72, 0.5)
    tw.color_scrollbar_thumb_hover = color_rgba(0.42, 0.47, 0.55, 0.7)
    tw.color_selection             = color_rgba(0.15, 0.39, 0.93, 0.2)
    tw.color_selection_border      = color_rgba(0.15, 0.39, 0.93, 1.0)

patch apply_light_shadows(tw: ThemeWorld):
    tw.shadow_elevation_1  = 2.0
    tw.shadow_elevation_2  = 4.0
    tw.shadow_elevation_3  = 8.0
    tw.shadow_color        = color_rgba(0.0, 0.0, 0.0, 0.1)
    tw.glow_accent         = color_rgba(0.15, 0.39, 0.93, 0.2)
    tw.glow_meter_peak     = color_rgba(1.00, 0.00, 0.00, 0.2)

patch apply_light_typography(tw: ThemeWorld):
    tw.font_family_ui = "Inter"
    tw.font_family_mono = "JetBrains Mono"
    tw.font_family_display = "Inter Display"
    tw.font_size_xs = 10.0
    tw.font_size_sm = 11.0
    tw.font_size_base = 12.0
    tw.font_size_md = 13.0
    tw.font_size_lg = 15.0
    tw.font_size_xl = 18.0
    tw.font_size_2xl = 24.0
    tw.font_size_3xl = 32.0
    tw.font_weight_normal = 400
    tw.font_weight_medium = 500
    tw.font_weight_semibold = 600
    tw.font_weight_bold = 700
    tw.font_weight_black = 900
    tw.font_letter_spacing_tight = -0.5
    tw.font_letter_spacing_normal = 0.0
    tw.font_letter_spacing_wide = 1.0
    tw.font_line_height_tight = 1.0
    tw.font_line_height_normal = 1.4
    tw.font_line_height_relaxed = 1.6

