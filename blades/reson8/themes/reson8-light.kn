    tw.color_playhead         = color_rgba(0.06, 0.09, 0.16, 1.0)  // #0f172a
    tw.color_playhead_line    = color_rgba(0.06, 0.09, 0.16, 1.0)  // #0f172a
    tw.color_loop_region      = color_rgba(0.23, 0.51, 0.99, 0.15) // #3b82f626
    tw.color_loop_region_border = color_rgba(0.23, 0.51, 0.99, 1.0) // #3b82f6

patch apply_light_midi(tw: ThemeWorld):
    tw.color_midi_bg              = color_rgba(0.97, 0.98, 0.99, 1.0)  // #f8fafc
    tw.color_midi_note_default    = color_rgba(0.23, 0.51, 0.99, 1.0)  // #3b82f6
    tw.color_midi_note_selected   = color_rgba(0.15, 0.39, 0.93, 1.0)  // #2563eb
