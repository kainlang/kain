// themes/reaper-classic.kn -- REAPER v6 default green/grey style
// The classic REAPER look: green accents on neutral greys

use std::math
use worlds::theme_world

patch apply_reaper_identity(tw: ThemeWorld):
    tw.active_theme_name = "reaper-classic"
    tw.theme_version = 1
    tw.theme_author = "reson8"
    tw.theme_description = "REAPER v6 default: green accents, neutral greys"

patch apply_reaper_surfaces(tw: ThemeWorld):
    tw.color_bg_primary       = color_rgba(0.22, 0.23, 0.22, 1.0)  // #383a38 neutral grey
    tw.color_bg_secondary     = color_rgba(0.20, 0.21, 0.20, 1.0)  // #333533 darker grey
    tw.color_bg_tertiary      = color_rgba(0.25, 0.26, 0.25, 1.0)  // #404140 lighter grey
    tw.color_surface          = color_rgba(0.24, 0.25, 0.24, 1.0)  // #3d3f3d
    tw.color_surface_raised   = color_rgba(0.28, 0.29, 0.28, 1.0)  // #474947
    tw.color_surface_overlay  = color_rgba(0.31, 0.32, 0.31, 1.0)  // #4f514f
    tw.color_surface_dialog   = color_rgba(0.22, 0.23, 0.22, 1.0)

patch apply_reaper_text(tw: ThemeWorld):
    tw.color_text_primary     = color_rgba(0.88, 0.88, 0.87, 1.0)  // light grey
    tw.color_text_secondary   = color_rgba(0.69, 0.69, 0.68, 1.0)  // mid grey
    tw.color_text_muted       = color_rgba(0.50, 0.50, 0.49, 1.0)  // muted grey
    tw.color_text_inverse     = color_rgba(0.22, 0.23, 0.22, 1.0)
    tw.color_text_link        = color_rgba(0.40, 0.75, 0.30, 1.0)  // #66bf4d green
    tw.color_text_error       = color_rgba(0.88, 0.30, 0.30, 1.0)  // #e04d4d
    tw.color_text_success     = color_rgba(0.40, 0.75, 0.30, 1.0)  // #66bf4d

patch apply_reaper_accent(tw: ThemeWorld):
    tw.color_accent           = color_rgba(0.36, 0.73, 0.25, 1.0)  // #5cba40 green
    tw.color_accent_hover     = color_rgba(0.44, 0.80, 0.33, 1.0)  // #70cc54 lighter green
    tw.color_accent_pressed   = color_rgba(0.28, 0.60, 0.18, 1.0)  // #47992e darker green
    tw.color_accent_alt       = color_rgba(0.40, 0.50, 0.65, 1.0)  // blue-grey
    tw.color_accent_alt_hover = color_rgba(0.48, 0.58, 0.72, 1.0)

patch apply_reaper_semantic_borders(tw: ThemeWorld):
    tw.color_success          = color_rgba(0.40, 0.75, 0.30, 1.0)  // #66bf4d
    tw.color_warning          = color_rgba(0.85, 0.75, 0.20, 1.0)  // #d9bf33
    tw.color_error            = color_rgba(0.88, 0.30, 0.30, 1.0)  // #e04d4d
    tw.color_info             = color_rgba(0.40, 0.60, 0.85, 1.0)  // blue
    tw.color_border_default   = color_rgba(0.32, 0.33, 0.32, 1.0)  // #515351
    tw.color_border_focus     = color_rgba(0.36, 0.73, 0.25, 1.0)  // green
    tw.color_border_error     = color_rgba(0.88, 0.30, 0.30, 1.0)
    tw.color_border_subtle    = color_rgba(0.26, 0.27, 0.26, 1.0)

patch apply_reaper_meters(tw: ThemeWorld):
    tw.color_meter_low        = color_rgba(0.40, 0.75, 0.30, 1.0)  // green -60 to -18
    tw.color_meter_mid        = color_rgba(0.85, 0.75, 0.20, 1.0)  // yellow -18 to -6
    tw.color_meter_high       = color_rgba(0.88, 0.30, 0.30, 1.0)  // red -6 to 0
    tw.color_meter_over       = color_rgba(1.00, 0.10, 0.10, 1.0)  // bright red clip
    tw.color_meter_background = color_rgba(0.15, 0.16, 0.15, 1.0)
    tw.color_meter_peak_hold  = color_rgba(0.95, 0.95, 0.94, 1.0)  // white hold

patch apply_reaper_waveform_grid(tw: ThemeWorld):
    tw.color_waveform         = color_rgba(0.55, 0.78, 0.45, 1.0)  // green waveform
    tw.color_waveform_selected = color_rgba(0.72, 0.85, 0.55, 1.0) // lighter green
    tw.color_waveform_center_line = color_rgba(0.32, 0.33, 0.32, 1.0)
    tw.color_waveform_rms     = color_rgba(0.36, 0.73, 0.25, 0.35)
    tw.color_grid_line        = color_rgba(0.25, 0.26, 0.25, 1.0)
    tw.color_grid_beat        = color_rgba(0.30, 0.31, 0.30, 1.0)
    tw.color_grid_bar         = color_rgba(0.38, 0.39, 0.38, 1.0)
    tw.color_ruler_bg         = color_rgba(0.18, 0.19, 0.18, 1.0)
    tw.color_ruler_text       = color_rgba(0.60, 0.60, 0.59, 1.0)

patch apply_reaper_playhead_midi(tw: ThemeWorld):
    tw.color_playhead         = color_rgba(1.00, 1.00, 1.00, 1.0)  // white playhead
    tw.color_playhead_line    = color_rgba(1.00, 1.00, 1.00, 1.0)
    tw.color_loop_region      = color_rgba(0.36, 0.73, 0.25, 0.15) // green loop
    tw.color_loop_region_border = color_rgba(0.36, 0.73, 0.25, 1.0)
    tw.color_midi_bg          = color_rgba(0.20, 0.21, 0.20, 1.0)
    tw.color_midi_note_default = color_rgba(0.40, 0.75, 0.30, 1.0) // green notes
    tw.color_midi_note_selected = color_rgba(0.50, 0.85, 0.40, 1.0)
    tw.color_midi_note_muted  = color_rgba(0.45, 0.46, 0.45, 1.0)
    tw.color_midi_note_velocity_low = color_rgba(0.15, 0.45, 0.08, 1.0)
    tw.color_midi_note_velocity_high = color_rgba(0.50, 0.85, 0.40, 1.0)
    tw.color_midi_white_key   = color_rgba(0.78, 0.78, 0.77, 1.0)  // light keys
    tw.color_midi_black_key   = color_rgba(0.28, 0.29, 0.28, 1.0)
    tw.color_midi_grid        = color_rgba(0.25, 0.26, 0.25, 1.0)
    tw.color_midi_cc_bg       = color_rgba(0.15, 0.16, 0.15, 1.0)
    tw.color_midi_cc_line     = color_rgba(0.85, 0.75, 0.20, 1.0)  // yellow CC

patch apply_reaper_clips_automation(tw: ThemeWorld):
    tw.color_clip_default     = color_rgba(0.45, 0.65, 0.55, 1.0)  // muted green-grey
    tw.color_clip_selected    = color_rgba(0.55, 0.80, 0.45, 1.0)  // brighter green
    tw.color_clip_muted       = color_rgba(0.38, 0.39, 0.38, 1.0)  // dim grey
    tw.color_clip_locked      = color_rgba(0.75, 0.60, 0.25, 1.0)  // amber lock
    tw.color_clip_recording   = color_rgba(0.88, 0.30, 0.30, 1.0)  // red recording
    tw.color_clip_header      = color_rgba(0.25, 0.32, 0.24, 1.0)
    tw.color_clip_waveform    = color_rgba(0.55, 0.78, 0.45, 1.0)
    tw.color_clip_fade_in     = color_rgba(0.40, 0.75, 0.30, 0.4)
    tw.color_clip_fade_out    = color_rgba(0.88, 0.30, 0.30, 0.4)
    tw.color_automation_line  = color_rgba(0.85, 0.75, 0.20, 1.0)  // yellow automation
    tw.color_automation_point = color_rgba(0.95, 0.95, 0.94, 1.0)
    tw.color_automation_point_selected = color_rgba(0.36, 0.73, 0.25, 1.0)
    tw.color_automation_lane_bg = color_rgba(0.15, 0.16, 0.15, 1.0)

patch apply_reaper_controls(tw: ThemeWorld):
    tw.color_knob_track       = color_rgba(0.30, 0.31, 0.30, 1.0)
    tw.color_knob_fill        = color_rgba(0.36, 0.73, 0.25, 1.0)
    tw.color_knob_center      = color_rgba(0.22, 0.23, 0.22, 1.0)
    tw.color_knob_indicator   = color_rgba(0.95, 0.95, 0.94, 1.0)
    tw.color_button_default   = color_rgba(0.30, 0.31, 0.30, 1.0)
    tw.color_button_hover     = color_rgba(0.38, 0.39, 0.38, 1.0)
    tw.color_button_active    = color_rgba(0.36, 0.73, 0.25, 1.0)
    tw.color_button_text      = color_rgba(0.88, 0.88, 0.87, 1.0)
    tw.color_button_text_active = color_rgba(0.22, 0.23, 0.22, 1.0)
    tw.color_button_disabled  = color_rgba(0.20, 0.21, 0.20, 1.0)
    tw.color_button_text_disabled = color_rgba(0.45, 0.46, 0.45, 1.0)
    tw.color_slider_track     = color_rgba(0.30, 0.31, 0.30, 1.0)
    tw.color_slider_fill      = color_rgba(0.36, 0.73, 0.25, 1.0)
    tw.color_slider_thumb     = color_rgba(0.88, 0.88, 0.87, 1.0)
    tw.color_slider_thumb_hover = color_rgba(0.44, 0.80, 0.33, 1.0)
    tw.color_fader_cap        = color_rgba(0.22, 0.23, 0.22, 1.0)
    tw.color_fader_cap_line   = color_rgba(0.36, 0.73, 0.25, 1.0)
    tw.color_scrollbar_thumb  = color_rgba(0.38, 0.39, 0.38, 1.0)
    tw.color_scrollbar_thumb_hover = color_rgba(0.50, 0.51, 0.50, 1.0)
    tw.color_selection        = color_rgba(0.40, 0.75, 0.30, 0.2)
    tw.color_selection_border = color_rgba(0.40, 0.75, 0.30, 1.0)
    tw.shadow_color           = color_rgba(0.0, 0.0, 0.0, 0.6)
    tw.glow_accent            = color_rgba(0.36, 0.73, 0.25, 0.2)
    tw.glow_meter_peak        = color_rgba(1.00, 0.10, 0.10, 0.2)

patch apply_reaper_layout(tw: ThemeWorld):
    tw.font_family_ui = "Inter"
    tw.font_family_mono = "JetBrains Mono"
    tw.font_size_base = 12.0
    tw.font_size_sm = 11.0
    tw.font_size_lg = 15.0
    tw.font_weight_normal = 400
    tw.font_weight_semibold = 600
    tw.font_weight_bold = 700
    tw.mixer_strip_width = 80.0
    tw.transport_height = 48.0
    tw.track_header_width = 200.0
    tw.piano_roll_note_height = 12.0
    tw.piano_roll_key_width = 60.0
    tw.timeline_ruler_height = 24.0
    tw.meter_width = 10.0
    tw.meter_height = 200.0
    tw.fader_throw = 200.0
    tw.fader_width = 24.0
    tw.knob_size_md = 32.0
    tw.button_size_md = 28.0
    tw.scrollbar_width = 8.0
    tw.animation_enabled = true
    tw.animation_reduced = false
    tw.animation_duration_normal = 200
    tw.meter_decay_rate = 26.0
    tw.meter_peak_hold_ms = 2000
    tw.threshold_cpu_yellow = 50.0
    tw.threshold_cpu_red = 80.0
