    tw.color_midi_black_key   = color_rgba(0.12, 0.09, 0.06, 1.0)
    tw.color_midi_grid        = color_rgba(0.15, 0.12, 0.08, 1.0)
    tw.color_midi_cc_bg       = color_rgba(0.04, 0.03, 0.02, 1.0)
    tw.color_midi_cc_line     = color_rgba(0.83, 0.60, 0.15, 1.0)
    tw.color_clip_default     = color_rgba(0.83, 0.60, 0.15, 1.0)
    tw.color_clip_selected    = color_rgba(0.89, 0.69, 0.25, 1.0)
    tw.color_clip_muted       = color_rgba(0.35, 0.28, 0.20, 1.0)
    tw.color_clip_locked      = color_rgba(0.70, 0.55, 0.25, 1.0)
