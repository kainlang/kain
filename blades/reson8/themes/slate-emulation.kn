    tw.color_loop_region_border = color_rgba(0.83, 0.60, 0.15, 1.0)
    tw.color_midi_bg          = color_rgba(0.08, 0.06, 0.04, 1.0)
    tw.color_midi_note_default = color_rgba(0.83, 0.60, 0.15, 1.0)  // gold notes
    tw.color_midi_note_selected = color_rgba(0.89, 0.69, 0.25, 1.0)
