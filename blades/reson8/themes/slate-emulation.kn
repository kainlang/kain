    tw.glow_meter_peak        = color_rgba(0.90, 0.28, 0.24, 0.3)

patch apply_slate_layout(tw: ThemeWorld):
    tw.font_family_ui = "Inter"
    tw.font_family_mono = "JetBrains Mono"
    tw.font_size_base = 12.0
    tw.font_size_sm = 11.0
    tw.font_size_lg = 15.0
    tw.font_weight_normal = 400
    tw.font_weight_semibold = 600
    tw.font_weight_bold = 700
    tw.mixer_strip_width = 80.0
    tw.transport_height = 48.0
    tw.track_header_width = 200.0
    tw.piano_roll_note_height = 12.0
    tw.piano_roll_key_width = 60.0
    tw.timeline_ruler_height = 24.0
    tw.meter_width = 10.0
    tw.meter_height = 200.0
    tw.fader_throw = 200.0
    tw.fader_width = 24.0
    tw.knob_size_md = 32.0
    tw.button_size_md = 28.0
    tw.scrollbar_width = 8.0
    tw.animation_enabled = true
    tw.animation_reduced = false
    tw.animation_duration_normal = 250
    tw.meter_decay_rate = 24.0
    tw.meter_peak_hold_ms = 3000
    tw.threshold_cpu_yellow = 50.0
    tw.threshold_cpu_red = 80.0
