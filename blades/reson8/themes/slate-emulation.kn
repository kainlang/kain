// themes/slate-emulation.kn -- Slate Digital skeuomorphic style
// Dark, rich, analog-inspired: deep browns, gold accents, texture feel

use std::math
use worlds::theme_world

patch apply_slate_identity(tw: ThemeWorld):
    tw.active_theme_name = "slate-emulation"
    tw.theme_version = 1
    tw.theme_author = "reson8"
    tw.theme_description = "Slate Digital skeuomorphic style: deep browns, gold accents"

patch apply_slate_surfaces(tw: ThemeWorld):
    tw.color_bg_primary       = color_rgba(0.08, 0.06, 0.04, 1.0)  // deep brown-black
    tw.color_bg_secondary     = color_rgba(0.12, 0.09, 0.06, 1.0)  // rich brown
    tw.color_bg_tertiary      = color_rgba(0.16, 0.12, 0.08, 1.0)  // lighter brown
    tw.color_surface          = color_rgba(0.14, 0.10, 0.07, 1.0)  // surface brown
    tw.color_surface_raised   = color_rgba(0.18, 0.14, 0.10, 1.0)  // raised brown
    tw.color_surface_overlay  = color_rgba(0.22, 0.16, 0.12, 1.0)  // overlay brown
    tw.color_surface_dialog   = color_rgba(0.12, 0.09, 0.06, 1.0)  // dialog brown

patch apply_slate_text(tw: ThemeWorld):
    tw.color_text_primary     = color_rgba(0.91, 0.85, 0.78, 1.0)  // warm cream
    tw.color_text_secondary   = color_rgba(0.69, 0.62, 0.55, 1.0)  // muted cream
    tw.color_text_muted       = color_rgba(0.45, 0.40, 0.35, 1.0)  // dark cream
    tw.color_text_inverse     = color_rgba(0.08, 0.06, 0.04, 1.0)  // deep brown
    tw.color_text_link        = color_rgba(0.89, 0.69, 0.25, 1.0)  // gold
    tw.color_text_error       = color_rgba(0.90, 0.28, 0.24, 1.0)  // warm red
    tw.color_text_success     = color_rgba(0.35, 0.78, 0.51, 1.0)  // muted green

patch apply_slate_accent(tw: ThemeWorld):
    tw.color_accent           = color_rgba(0.83, 0.60, 0.15, 1.0)  // #d4a53d gold/brass
    tw.color_accent_hover     = color_rgba(0.89, 0.69, 0.25, 1.0)  // #e4b044 brighter gold
    tw.color_accent_pressed   = color_rgba(0.69, 0.47, 0.08, 1.0)  // #b07814 darker gold
    tw.color_accent_alt       = color_rgba(0.55, 0.45, 0.35, 1.0)  // warm grey
    tw.color_accent_alt_hover = color_rgba(0.65, 0.55, 0.45, 1.0)  // lighter warm grey

patch apply_slate_full_palette(tw: ThemeWorld):
    tw.color_success          = color_rgba(0.35, 0.78, 0.51, 1.0)  // #58c982
    tw.color_warning          = color_rgba(0.90, 0.60, 0.10, 1.0)  // amber
    tw.color_error            = color_rgba(0.90, 0.28, 0.24, 1.0)  // #e6473d
    tw.color_info             = color_rgba(0.45, 0.65, 0.85, 1.0)  // slate blue
    tw.color_border_default   = color_rgba(0.22, 0.18, 0.14, 1.0)  // #383024
    tw.color_border_focus     = color_rgba(0.83, 0.60, 0.15, 1.0)  // gold
    tw.color_border_error     = color_rgba(0.90, 0.28, 0.24, 1.0)
    tw.color_border_subtle    = color_rgba(0.15, 0.12, 0.08, 1.0)
    tw.color_meter_low        = color_rgba(0.35, 0.78, 0.51, 1.0)  // green
    tw.color_meter_mid        = color_rgba(0.90, 0.60, 0.10, 1.0)  // amber
    tw.color_meter_high       = color_rgba(0.90, 0.28, 0.24, 1.0)  // red
    tw.color_meter_over       = color_rgba(0.95, 0.15, 0.15, 1.0)  // bright red
    tw.color_meter_background = color_rgba(0.04, 0.03, 0.02, 1.0)  // very dark
    tw.color_meter_peak_hold  = color_rgba(0.91, 0.85, 0.78, 1.0)  // cream
    tw.color_waveform         = color_rgba(0.83, 0.60, 0.15, 1.0)  // gold waveform
    tw.color_waveform_selected = color_rgba(0.89, 0.69, 0.25, 1.0) // brighter gold
    tw.color_waveform_center_line = color_rgba(0.22, 0.18, 0.14, 1.0)
    tw.color_waveform_rms     = color_rgba(0.83, 0.60, 0.15, 0.4)
    tw.color_grid_line        = color_rgba(0.15, 0.12, 0.08, 1.0)
    tw.color_grid_beat        = color_rgba(0.20, 0.16, 0.12, 1.0)
