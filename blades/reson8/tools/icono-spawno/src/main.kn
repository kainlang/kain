// icono-spawno -- reson8 procedural icon creator. 50 icons, 1 file.
// Usage: kain build src/main.kn --target llvm && main.exe --all --size 512 --output icons/

use std::process
use std::fs
use std::os_path

const VERSION: String = "0.1.0"
const DEFAULT_SIZE: Int = 256
const DEFAULT_COLOR: String = "#e94560"
const DEFAULT_STROKE: String = "#ffffff"
const DEFAULT_STROKE_WIDTH: Float = 0.4
const EXIT_OK: Int = 0
const EXIT_HELP: Int = 1
const EXIT_ERROR: Int = 2

// ---- float/int helpers ----
fn _itoa(v: Int) -> String: return str(v)
fn _itof(v: Int) -> Float: return v * 1.0
fn _ftoi(v: Float) -> Int: if v >= 0.0: return (v + 0.5) as Int else: return (v - 0.5) as Int

fn _ff(v: Float) -> String:
    let s = v * 100.0
    let ip = _ftoi(s + 0.5)
    let w = ip / 100
    let fr = ip % 100
    if fr == 0: return _itoa(w)
    let pf = if fr < 0: (0 - fr) else: fr
    let t = pf / 10
    let o = pf % 10
    if fr < 0: if w == 0: return "-0." + _itoa(t) + _itoa(o) else: return _itoa(w) + "." + _itoa(t) + _itoa(o)
    return _itoa(w) + "." + _itoa(t) + _itoa(o)

fn _px(v: Float, size: Int) -> Float: return v * (_itof(size) / 24.0)

// ---- SVG primitives (single-quoted attrs) ----
fn _svg_rect(x: Float, y: Float, w: Float, h: Float, fill: String, stroke: String, sw: Float, rx: Float) -> String:
    var el = "<rect x='" + _ff(x) + "' y='" + _ff(y) + "' width='" + _ff(w) + "' height='" + _ff(h) + "'"
    if rx > 0.0: el = el + " rx='" + _ff(rx) + "'"
    el = el + " fill='" + (if fill == "" or fill == "none": "none" else: fill) + "'"
    if stroke != "" and stroke != "none": el = el + " stroke='" + stroke + "' stroke-width='" + _ff(sw) + "' stroke-linecap='round' stroke-linejoin='round'"
    el = el + " />"
    return el

fn _svg_circle(cx: Float, cy: Float, r: Float, fill: String, stroke: String, sw: Float) -> String:
    var el = "<circle cx='" + _ff(cx) + "' cy='" + _ff(cy) + "' r='" + _ff(r) + "'"
    el = el + " fill='" + (if fill == "" or fill == "none": "none" else: fill) + "'"
    if stroke != "" and stroke != "none": el = el + " stroke='" + stroke + "' stroke-width='" + _ff(sw) + "'"
    el = el + " />"
    return el

fn _svg_poly(pts: String, fill: String, stroke: String, sw: Float) -> String:
    var el = "<polygon points='" + pts + "'"
    el = el + " fill='" + (if fill == "" or fill == "none": "none" else: fill) + "'"
    if stroke != "" and stroke != "none": el = el + " stroke='" + stroke + "' stroke-width='" + _ff(sw) + "' stroke-linejoin='round'"
    el = el + " />"
    return el

fn _svg_path(d: String, fill: String, stroke: String, sw: Float) -> String:
    var el = "<path d='" + d + "'"
    el = el + " fill='" + (if fill == "" or fill == "none": "none" else: fill) + "'"
    if stroke != "" and stroke != "none": el = el + " stroke='" + stroke + "' stroke-width='" + _ff(sw) + "' stroke-linecap='round' stroke-linejoin='round'"
    el = el + " />"
    return el

fn _svg_text(x: Float, y: Float, content: String, fs: Float, fill: String) -> String:
    return "<text x='" + _ff(x) + "' y='" + _ff(y) + "' font-size='" + _ff(fs) + "' font-family='system-ui, sans-serif' text-anchor='middle' dominant-baseline='central' fill='" + fill + "'>" + content + "</text>"

fn _svg_doc(w: Int, h: Int, body: String, bg: String) -> String:
    var d = "<?xml version='1.0' encoding='UTF-8'?>\n"
    d = d + "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " + _itoa(w) + " " + _itoa(h) + "' width='" + _itoa(w) + "' height='" + _itoa(h) + "'>\n"
    if bg != "" and bg != "none": d = d + "  <rect width='100%' height='100%' fill='" + bg + "' />\n"
    d = d + body + "\n</svg>\n"
    return d

// ---- polygon point builder ----
fn _pts(size: Int, coords: Array<Float>) -> String:
    var s = ""
    var i = 0
    while i < len(coords):
        if i > 0 and i % 2 == 0: s = s + " "
        if i > 0 and i % 2 == 1: s = s + ","
        s = s + _ff(coords[i])
        i = i + 1
    return s

// ===== ICONS =====
// Each returns SVG body (elements inside <svg>). Parameters: size(Int) f(String) s(String) sw(Float)

// ---- TRANSPORT (7) ----
fn i_play(sz: Int, f: String, st: String, sw: Float) -> String:
    let p = 5.0
    return _svg_poly(_pts(sz, [_px(p,sz), _px(p,sz), _px(24.0-p,sz), _px(12.0,sz), _px(p,sz), _px(24.0-p,sz)]), f, st, sw)

fn i_stop(sz: Int, f: String, st: String, sw: Float) -> String:
    let p = 6.0
    let w = 24.0 - p * 2.0
    return _svg_rect(_px(p,sz), _px(p,sz), _px(w,sz), _px(w,sz), f, st, sw, 0.0)

fn i_pause(sz: Int, f: String, st: String, sw: Float) -> String:
    let bw = 3.0
    let p = 7.0
    let bh = 24.0 - p * 2.0
    let g = 2.0
    var b = _svg_rect(_px(12.0-g/2.0-bw,sz), _px(p,sz), _px(bw,sz), _px(bh,sz), f, st, sw, 0.0)
    b = b + "\n  " + _svg_rect(_px(12.0+g/2.0,sz), _px(p,sz), _px(bw,sz), _px(bh,sz), f, st, sw, 0.0)
    return b

fn i_record(sz: Int, f: String, st: String, sw: Float) -> String:
    return _svg_circle(_px(12.0,sz), _px(12.0,sz), _px(5.0,sz), f, st, sw)

fn i_loop(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(10.0,sz)) + " " + _ff(_px(9.0,sz))
    d = d + " A " + _ff(_px(6.0,sz)) + " " + _ff(_px(6.0,sz)) + " 0 1 1 " + _ff(_px(10.0,sz)) + " " + _ff(_px(15.0,sz))
    d = d + " M " + _ff(_px(14.0,sz)) + " " + _ff(_px(15.0,sz))
    d = d + " A " + _ff(_px(6.0,sz)) + " " + _ff(_px(6.0,sz)) + " 0 1 1 " + _ff(_px(14.0,sz)) + " " + _ff(_px(9.0,sz))
    d = d + " M " + _ff(_px(10.0,sz)) + " " + _ff(_px(9.0,sz)) + " L " + _ff(_px(7.0,sz)) + " " + _ff(_px(10.5,sz))
    d = d + " M " + _ff(_px(10.0,sz)) + " " + _ff(_px(9.0,sz)) + " L " + _ff(_px(13.0,sz)) + " " + _ff(_px(6.5,sz))
    return _svg_path(d, "none", st, sw)

fn i_skip_fwd(sz: Int, f: String, st: String, sw: Float) -> String:
    let py = 5.0
    var b = _svg_poly(_pts(sz, [_px(5.0,sz), _px(py,sz), _px(14.0,sz), _px(12.0,sz), _px(5.0,sz), _px(24.0-py,sz)]), f, st, sw)
    b = b + "\n  " + _svg_rect(_px(16.0,sz), _px(py,sz), _px(1.5,sz), _px(24.0-py*2.0,sz), f, st, sw, 0.0)
    return b

fn i_skip_back(sz: Int, f: String, st: String, sw: Float) -> String:
    let py = 5.0
    var b = _svg_poly(_pts(sz, [_px(19.0,sz), _px(py,sz), _px(10.0,sz), _px(12.0,sz), _px(19.0,sz), _px(24.0-py,sz)]), f, st, sw)
    b = b + "\n  " + _svg_rect(_px(6.5,sz), _px(py,sz), _px(1.5,sz), _px(24.0-py*2.0,sz), f, st, sw, 0.0)
    return b

// ---- MIXER (8) ----
fn i_vol_hi(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_poly(_pts(sz, [_px(4.0,sz),_px(9.0,sz),_px(8.0,sz),_px(9.0,sz),_px(8.0,sz),_px(15.0,sz),_px(4.0,sz),_px(15.0,sz)]), f, st, sw)
    var d1 = "M " + _ff(_px(11.0,sz)) + " " + _ff(_px(8.0,sz)) + " Q " + _ff(_px(15.0,sz)) + " " + _ff(_px(7.0,sz)) + " " + _ff(_px(15.0,sz)) + " " + _ff(_px(12.0,sz))
    b = b + "\n  " + _svg_path(d1, "none", st, sw)
    var d2 = "M " + _ff(_px(11.0,sz)) + " " + _ff(_px(16.0,sz)) + " Q " + _ff(_px(15.0,sz)) + " " + _ff(_px(17.0,sz)) + " " + _ff(_px(15.0,sz)) + " " + _ff(_px(12.0,sz))
    b = b + "\n  " + _svg_path(d2, "none", st, sw)
    var d3 = "M " + _ff(_px(13.5,sz)) + " " + _ff(_px(5.0,sz)) + " Q " + _ff(_px(19.0,sz)) + " " + _ff(_px(4.0,sz)) + " " + _ff(_px(19.0,sz)) + " " + _ff(_px(12.0,sz))
    b = b + "\n  " + _svg_path(d3, "none", st, sw)
    var d4 = "M " + _ff(_px(13.5,sz)) + " " + _ff(_px(19.0,sz)) + " Q " + _ff(_px(19.0,sz)) + " " + _ff(_px(20.0,sz)) + " " + _ff(_px(19.0,sz)) + " " + _ff(_px(12.0,sz))
    b = b + "\n  " + _svg_path(d4, "none", st, sw)
    return b

fn i_vol_lo(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_poly(_pts(sz, [_px(4.0,sz),_px(9.0,sz),_px(8.0,sz),_px(9.0,sz),_px(8.0,sz),_px(15.0,sz),_px(4.0,sz),_px(15.0,sz)]), f, st, sw)
    var d1 = "M " + _ff(_px(11.0,sz)) + " " + _ff(_px(8.0,sz)) + " Q " + _ff(_px(15.0,sz)) + " " + _ff(_px(7.0,sz)) + " " + _ff(_px(15.0,sz)) + " " + _ff(_px(12.0,sz))
    b = b + "\n  " + _svg_path(d1, "none", st, sw)
    var d2 = "M " + _ff(_px(11.0,sz)) + " " + _ff(_px(16.0,sz)) + " Q " + _ff(_px(15.0,sz)) + " " + _ff(_px(17.0,sz)) + " " + _ff(_px(15.0,sz)) + " " + _ff(_px(12.0,sz))
    b = b + "\n  " + _svg_path(d2, "none", st, sw)
    return b

fn i_vol_mute(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_poly(_pts(sz, [_px(4.0,sz),_px(9.0,sz),_px(8.0,sz),_px(9.0,sz),_px(8.0,sz),_px(15.0,sz),_px(4.0,sz),_px(15.0,sz)]), f, st, sw)
    var dx = "M " + _ff(_px(11.0,sz)) + " " + _ff(_px(8.0,sz)) + " L " + _ff(_px(18.0,sz)) + " " + _ff(_px(16.0,sz))
    dx = dx + " M " + _ff(_px(18.0,sz)) + " " + _ff(_px(8.0,sz)) + " L " + _ff(_px(11.0,sz)) + " " + _ff(_px(16.0,sz))
    b = b + "\n  " + _svg_path(dx, "none", st, sw)
    return b

fn i_pan(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(12.0,sz), _px(12.0,sz), _px(8.0,sz), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(4.0,sz)) + " " + _ff(_px(12.0,sz)) + " L " + _ff(_px(20.0,sz)) + " " + _ff(_px(12.0,sz)), "none", st, sw*0.75)
    b = b + "\n  " + _svg_text(_px(6.0,sz), _px(12.0,sz), "L", _px(4.0,sz), f)
    b = b + "\n  " + _svg_text(_px(18.0,sz), _px(12.0,sz), "R", _px(4.0,sz), f)
    return b

fn i_fx(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_poly(_pts(sz, [_px(12.0,sz),_px(2.0,sz),_px(21.0,sz),_px(12.0,sz),_px(12.0,sz),_px(22.0,sz),_px(3.0,sz),_px(12.0,sz)]), "none", st, sw)
    b = b + "\n  " + _svg_text(_px(12.0,sz), _px(12.5,sz), "FX", _px(5.0,sz), f)
    return b

fn i_eq(sz: Int, f: String, st: String, sw: Float) -> String:
    let bw = 2.5
    let g = 3.0
    var b = _svg_rect(_px(4.0,sz), _px(8.0,sz), _px(bw,sz), _px(12.0,sz), f, st, sw, _px(0.5,sz))
    b = b + "\n  " + _svg_rect(_px(4.0+g+bw,sz), _px(4.0,sz), _px(bw,sz), _px(16.0,sz), f, st, sw, _px(0.5,sz))
    b = b + "\n  " + _svg_rect(_px(4.0+(g+bw)*2.0,sz), _px(12.0,sz), _px(bw,sz), _px(8.0,sz), f, st, sw, _px(0.5,sz))
    b = b + "\n  " + _svg_circle(_px(4.0+bw/2.0,sz), _px(8.0,sz), _px(1.0,sz), st, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(4.0+g+bw+bw/2.0,sz), _px(4.0,sz), _px(1.0,sz), st, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(4.0+(g+bw)*2.0+bw/2.0,sz), _px(12.0,sz), _px(1.0,sz), st, "none", 0.0)
    return b

fn i_comp(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_rect(_px(9.0,sz), _px(4.0,sz), _px(6.0,sz), _px(16.0,sz), "none", st, sw, _px(1.0,sz))
    b = b + "\n  " + _svg_path("M " + _ff(_px(5.0,sz)) + " " + _ff(_px(13.0,sz)) + " L " + _ff(_px(19.0,sz)) + " " + _ff(_px(13.0,sz)), "none", st, sw*0.75)
    var da = "M " + _ff(_px(12.0,sz)) + " " + _ff(_px(14.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(19.0,sz))
    da = da + " M " + _ff(_px(9.0,sz)) + " " + _ff(_px(17.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(20.0,sz)) + " L " + _ff(_px(15.0,sz)) + " " + _ff(_px(17.0,sz))
    b = b + "\n  " + _svg_path(da, "none", f, sw)
    return b

fn i_reverb(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_path("M " + _ff(_px(10.0,sz)) + " " + _ff(_px(14.0,sz)) + " A " + _ff(_px(3.0,sz)) + " " + _ff(_px(3.0,sz)) + " 0 0 1 " + _ff(_px(16.0,sz)) + " " + _ff(_px(11.0,sz)), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(10.0,sz)) + " " + _ff(_px(16.0,sz)) + " A " + _ff(_px(6.0,sz)) + " " + _ff(_px(6.0,sz)) + " 0 0 1 " + _ff(_px(19.0,sz)) + " " + _ff(_px(9.5,sz)), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(10.0,sz)) + " " + _ff(_px(18.0,sz)) + " A " + _ff(_px(9.0,sz)) + " " + _ff(_px(9.0,sz)) + " 0 0 1 " + _ff(_px(22.0,sz)) + " " + _ff(_px(8.0,sz)), "none", st, sw*0.6)
    return b

// ---- EDIT (8) ----
fn i_cut(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(6.0,sz), _px(6.0,sz), _px(2.5,sz), "none", st, sw)
    b = b + "\n  " + _svg_circle(_px(6.0,sz), _px(18.0,sz), _px(2.5,sz), "none", st, sw)
    var d = "M " + _ff(_px(8.0,sz)) + " " + _ff(_px(6.5,sz)) + " L " + _ff(_px(18.0,sz)) + " " + _ff(_px(18.0,sz))
    d = d + " M " + _ff(_px(18.0,sz)) + " " + _ff(_px(6.0,sz)) + " L " + _ff(_px(8.0,sz)) + " " + _ff(_px(17.5,sz))
    b = b + "\n  " + _svg_path(d, "none", st, sw)
    return b

fn i_copy(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_rect(_px(7.0,sz), _px(5.0,sz), _px(12.0,sz), _px(14.0,sz), "none", st, sw, _px(1.0,sz))
    b = b + "\n  " + _svg_rect(_px(5.0,sz), _px(7.0,sz), _px(12.0,sz), _px(14.0,sz), f, st, sw, _px(1.0,sz))
    return b

fn i_paste(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_rect(_px(6.0,sz), _px(6.0,sz), _px(12.0,sz), _px(14.0,sz), "none", st, sw, _px(1.0,sz))
    b = b + "\n  " + _svg_rect(_px(9.0,sz), _px(3.0,sz), _px(6.0,sz), _px(3.0,sz), f, st, sw, _px(0.5,sz))
    b = b + "\n  " + _svg_path("M " + _ff(_px(9.0,sz)) + " " + _ff(_px(12.0,sz)) + " L " + _ff(_px(15.0,sz)) + " " + _ff(_px(12.0,sz)), "none", st, sw*0.5)
    return b

fn i_undo(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(7.0,sz)) + " " + _ff(_px(9.0,sz))
    d = d + " Q " + _ff(_px(7.0,sz)) + " " + _ff(_px(4.0,sz)) + " " + _ff(_px(12.0,sz)) + " " + _ff(_px(4.0,sz))
    d = d + " Q " + _ff(_px(17.0,sz)) + " " + _ff(_px(4.0,sz)) + " " + _ff(_px(17.0,sz)) + " " + _ff(_px(10.0,sz))
    d = d + " L " + _ff(_px(17.0,sz)) + " " + _ff(_px(16.0,sz))
    var b = _svg_path(d, "none", st, sw)
    var d2 = "M " + _ff(_px(7.0,sz)) + " " + _ff(_px(9.0,sz)) + " L " + _ff(_px(3.0,sz)) + " " + _ff(_px(7.0,sz))
    d2 = d2 + " M " + _ff(_px(7.0,sz)) + " " + _ff(_px(9.0,sz)) + " L " + _ff(_px(10.0,sz)) + " " + _ff(_px(4.0,sz))
    b = b + "\n  " + _svg_path(d2, "none", st, sw)
    return b

fn i_redo(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(17.0,sz)) + " " + _ff(_px(9.0,sz))
    d = d + " Q " + _ff(_px(17.0,sz)) + " " + _ff(_px(4.0,sz)) + " " + _ff(_px(12.0,sz)) + " " + _ff(_px(4.0,sz))
    d = d + " Q " + _ff(_px(7.0,sz)) + " " + _ff(_px(4.0,sz)) + " " + _ff(_px(7.0,sz)) + " " + _ff(_px(10.0,sz))
    d = d + " L " + _ff(_px(7.0,sz)) + " " + _ff(_px(16.0,sz))
    var b = _svg_path(d, "none", st, sw)
    var d2 = "M " + _ff(_px(17.0,sz)) + " " + _ff(_px(9.0,sz)) + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(7.0,sz))
    d2 = d2 + " M " + _ff(_px(17.0,sz)) + " " + _ff(_px(9.0,sz)) + " L " + _ff(_px(14.0,sz)) + " " + _ff(_px(4.0,sz))
    b = b + "\n  " + _svg_path(d2, "none", st, sw)
    return b

fn i_delete(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_rect(_px(6.0,sz), _px(7.0,sz), _px(12.0,sz), _px(14.0,sz), "none", st, sw, _px(1.0,sz))
    b = b + "\n  " + _svg_rect(_px(4.0,sz), _px(5.0,sz), _px(16.0,sz), _px(2.0,sz), "none", st, sw, _px(0.5,sz))
    b = b + "\n  " + _svg_rect(_px(9.0,sz), _px(3.0,sz), _px(6.0,sz), _px(2.0,sz), "none", st, sw, _px(0.5,sz))
    var dl = "M " + _ff(_px(9.0,sz)) + " " + _ff(_px(10.0,sz)) + " L " + _ff(_px(9.0,sz)) + " " + _ff(_px(18.0,sz))
    dl = dl + " M " + _ff(_px(12.0,sz)) + " " + _ff(_px(10.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(18.0,sz))
    dl = dl + " M " + _ff(_px(15.0,sz)) + " " + _ff(_px(10.0,sz)) + " L " + _ff(_px(15.0,sz)) + " " + _ff(_px(18.0,sz))
    b = b + "\n  " + _svg_path(dl, "none", st, sw*0.5)
    return b

fn i_trim(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_path("M " + _ff(_px(5.0,sz)) + " " + _ff(_px(4.0,sz)) + " L " + _ff(_px(3.0,sz)) + " " + _ff(_px(4.0,sz)) + " L " + _ff(_px(3.0,sz)) + " " + _ff(_px(20.0,sz)) + " L " + _ff(_px(5.0,sz)) + " " + _ff(_px(20.0,sz)), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(19.0,sz)) + " " + _ff(_px(4.0,sz)) + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(4.0,sz)) + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(20.0,sz)) + " L " + _ff(_px(19.0,sz)) + " " + _ff(_px(20.0,sz)), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(4.0,sz)) + " " + _ff(_px(18.0,sz)) + " L " + _ff(_px(20.0,sz)) + " " + _ff(_px(6.0,sz)), "none", f, sw)
    return b

fn i_split(sz: Int, f: String, st: String, sw: Float) -> String:
    var dw = "M " + _ff(_px(2.0,sz)) + " " + _ff(_px(12.0,sz))
    dw = dw + " Q " + _ff(_px(5.0,sz)) + " " + _ff(_px(3.0,sz)) + " " + _ff(_px(8.0,sz)) + " " + _ff(_px(12.0,sz))
    dw = dw + " T " + _ff(_px(14.0,sz)) + " " + _ff(_px(12.0,sz)) + " T " + _ff(_px(22.0,sz)) + " " + _ff(_px(12.0,sz))
    var b = _svg_path(dw, "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(10.0,sz)) + " " + _ff(_px(8.0,sz)) + " L " + _ff(_px(14.0,sz)) + " " + _ff(_px(16.0,sz)) + " M " + _ff(_px(14.0,sz)) + " " + _ff(_px(8.0,sz)) + " L " + _ff(_px(10.0,sz)) + " " + _ff(_px(16.0,sz)), "none", f, sw)
    return b

// ---- NAVIGATION (6) ----
fn i_folder(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(3.0,sz)) + " " + _ff(_px(6.0,sz))
    d = d + " L " + _ff(_px(9.0,sz)) + " " + _ff(_px(6.0,sz)) + " L " + _ff(_px(11.0,sz)) + " " + _ff(_px(4.0,sz))
    d = d + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(4.0,sz)) + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(20.0,sz))
    d = d + " L " + _ff(_px(3.0,sz)) + " " + _ff(_px(20.0,sz)) + " Z"
    return _svg_path(d, f, st, sw)

fn i_file(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(5.0,sz)) + " " + _ff(_px(3.0,sz)) + " L " + _ff(_px(15.0,sz)) + " " + _ff(_px(3.0,sz))
    d = d + " L " + _ff(_px(19.0,sz)) + " " + _ff(_px(7.0,sz)) + " L " + _ff(_px(19.0,sz)) + " " + _ff(_px(21.0,sz))
    d = d + " L " + _ff(_px(5.0,sz)) + " " + _ff(_px(21.0,sz)) + " Z"
    var b = _svg_path(d, f, st, sw)
    var df = "M " + _ff(_px(15.0,sz)) + " " + _ff(_px(3.0,sz)) + " L " + _ff(_px(15.0,sz)) + " " + _ff(_px(7.0,sz)) + " L " + _ff(_px(19.0,sz)) + " " + _ff(_px(7.0,sz))
    b = b + "\n  " + _svg_path(df, "none", st, sw)
    return b

fn i_save(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_rect(_px(4.0,sz), _px(3.0,sz), _px(16.0,sz), _px(18.0,sz), "none", st, sw, _px(1.0,sz))
    b = b + "\n  " + _svg_rect(_px(7.0,sz), _px(6.0,sz), _px(10.0,sz), _px(8.0,sz), f, "none", 0.0, _px(0.5,sz))
    var da = "M " + _ff(_px(12.0,sz)) + " " + _ff(_px(16.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(20.0,sz))
    da = da + " M " + _ff(_px(9.0,sz)) + " " + _ff(_px(18.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(21.0,sz)) + " L " + _ff(_px(15.0,sz)) + " " + _ff(_px(18.0,sz))
    b = b + "\n  " + _svg_path(da, "none", st, sw)
    return b

fn i_open(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(3.0,sz)) + " " + _ff(_px(6.0,sz)) + " L " + _ff(_px(9.0,sz)) + " " + _ff(_px(6.0,sz))
    d = d + " L " + _ff(_px(11.0,sz)) + " " + _ff(_px(4.0,sz)) + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(4.0,sz))
    d = d + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(20.0,sz)) + " L " + _ff(_px(3.0,sz)) + " " + _ff(_px(20.0,sz)) + " Z"
    var b = _svg_path(d, "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(7.0,sz)) + " " + _ff(_px(15.0,sz)) + " L " + _ff(_px(7.0,sz)) + " " + _ff(_px(10.0,sz)) + " L " + _ff(_px(14.0,sz)) + " " + _ff(_px(10.0,sz)), "none", f, sw)
    return b

fn i_new(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_rect(_px(5.0,sz), _px(4.0,sz), _px(14.0,sz), _px(17.0,sz), "none", st, sw, _px(1.0,sz))
    b = b + "\n  " + _svg_path("M " + _ff(_px(12.0,sz)) + " " + _ff(_px(8.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(17.0,sz)) + " M " + _ff(_px(7.5,sz)) + " " + _ff(_px(12.5,sz)) + " L " + _ff(_px(16.5,sz)) + " " + _ff(_px(12.5,sz)), "none", f, sw)
    return b

fn i_export(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_rect(_px(4.0,sz), _px(12.0,sz), _px(16.0,sz), _px(10.0,sz), "none", st, sw, _px(1.0,sz))
    var da = "M " + _ff(_px(12.0,sz)) + " " + _ff(_px(12.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(4.0,sz))
    da = da + " M " + _ff(_px(8.0,sz)) + " " + _ff(_px(7.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(3.0,sz)) + " L " + _ff(_px(16.0,sz)) + " " + _ff(_px(7.0,sz))
    b = b + "\n  " + _svg_path(da, "none", f, sw)
    return b

// ---- TOOL (6) ----
fn i_zoom_in(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(10.0,sz), _px(10.0,sz), _px(6.0,sz), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(14.5,sz)) + " " + _ff(_px(14.5,sz)) + " L " + _ff(_px(20.0,sz)) + " " + _ff(_px(20.0,sz)), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(10.0,sz)) + " " + _ff(_px(7.0,sz)) + " L " + _ff(_px(10.0,sz)) + " " + _ff(_px(13.0,sz)) + " M " + _ff(_px(7.0,sz)) + " " + _ff(_px(10.0,sz)) + " L " + _ff(_px(13.0,sz)) + " " + _ff(_px(10.0,sz)), "none", f, sw*0.7)
    return b

fn i_zoom_out(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(10.0,sz), _px(10.0,sz), _px(6.0,sz), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(14.5,sz)) + " " + _ff(_px(14.5,sz)) + " L " + _ff(_px(20.0,sz)) + " " + _ff(_px(20.0,sz)), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(7.0,sz)) + " " + _ff(_px(10.0,sz)) + " L " + _ff(_px(13.0,sz)) + " " + _ff(_px(10.0,sz)), "none", f, sw*0.7)
    return b

fn i_selection(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(4.0,sz)) + " " + _ff(_px(4.0,sz)) + " L " + _ff(_px(20.0,sz)) + " " + _ff(_px(4.0,sz))
    d = d + " L " + _ff(_px(20.0,sz)) + " " + _ff(_px(20.0,sz)) + " L " + _ff(_px(4.0,sz)) + " " + _ff(_px(20.0,sz)) + " Z"
    return "<path d='" + d + "' fill='none' stroke='" + st + "' stroke-width='" + _ff(sw) + "' stroke-dasharray='" + _ff(_px(2.0,sz)) + " " + _ff(_px(1.5,sz)) + "' />"

fn i_pencil(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(17.0,sz)) + " " + _ff(_px(3.0,sz)) + " L " + _ff(_px(7.0,sz)) + " " + _ff(_px(13.0,sz))
    d = d + " L " + _ff(_px(6.0,sz)) + " " + _ff(_px(18.0,sz)) + " L " + _ff(_px(11.0,sz)) + " " + _ff(_px(17.0,sz))
    d = d + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(7.0,sz)) + " Z"
    return _svg_path(d, f, st, sw)

fn i_crosshair(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(12.0,sz), _px(12.0,sz), _px(8.0,sz), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(12.0,sz)) + " " + _ff(_px(2.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(22.0,sz)) + " M " + _ff(_px(2.0,sz)) + " " + _ff(_px(12.0,sz)) + " L " + _ff(_px(22.0,sz)) + " " + _ff(_px(12.0,sz)), "none", st, sw*0.5)
    b = b + "\n  " + _svg_circle(_px(12.0,sz), _px(12.0,sz), _px(0.8,sz), f, "none", 0.0)
    return b

fn i_grid(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(7.0,sz), _px(7.0,sz), _px(1.5,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(17.0,sz), _px(7.0,sz), _px(1.5,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(7.0,sz), _px(17.0,sz), _px(1.5,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(17.0,sz), _px(17.0,sz), _px(1.5,sz), f, "none", 0.0)
    return b

// ---- STATUS (4) ----
fn i_check(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(12.0,sz), _px(12.0,sz), _px(9.0,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_path("M " + _ff(_px(7.0,sz)) + " " + _ff(_px(12.0,sz)) + " L " + _ff(_px(10.5,sz)) + " " + _ff(_px(15.5,sz)) + " L " + _ff(_px(17.0,sz)) + " " + _ff(_px(8.0,sz)), "none", "#ffffff", sw*3.0)
    return b

fn i_warning(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_poly(_pts(sz, [_px(12.0,sz),_px(2.0,sz),_px(22.0,sz),_px(20.0,sz),_px(2.0,sz),_px(20.0,sz)]), f, "none", 0.0)
