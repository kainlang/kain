fn icon_cats() -> Array<String>:
    var c: Array<String> = []
    push(c, "transport"); push(c, "mixer"); push(c, "edit"); push(c, "navigation")
    push(c, "tool"); push(c, "status"); push(c, "settings"); push(c, "midi"); push(c, "general")
    return c

// ===== CLI =====
struct CliCfg:
    name: String
    category: String
    all: Bool
    sz: Int
    fcol: String
    scol: String
    sw: Float
    bg: String
    out: String
    help: Bool
    quiet: Bool

fn _dcfg() -> CliCfg:
    return CliCfg{name:"",category:"",all:false,sz:DEFAULT_SIZE,fcol:DEFAULT_COLOR,scol:DEFAULT_STROKE,sw:DEFAULT_STROKE_WIDTH,bg:"",out:"icons",help:false,quiet:false}

fn _atoi(s: String) -> Int:
    var r=0; var i=0; var si=1
    if len(s)>0 and char_at(s,0)=="-": si=-1; i=1
    while i<len(s):
        let c=char_at(s,i)
        if c=="0": r=r*10+0
        if c=="1": r=r*10+1
        if c=="2": r=r*10+2
        if c=="3": r=r*10+3
        if c=="4": r=r*10+4
        if c=="5": r=r*10+5
        if c=="6": r=r*10+6
        if c=="7": r=r*10+7
        if c=="8": r=r*10+8
        if c=="9": r=r*10+9
        i=i+1
    return r*si

fn _atof(s: String) -> Float:
    var ip=0; var fp=0; var fd=1; var si=1.0; var i=0; var inf=false
    if len(s)>0 and char_at(s,0)=="-": si=-1.0; i=1
    while i<len(s):
        let c=char_at(s,i)
        if c==".": inf=true; i=i+1; continue
        var d=0
        if c=="0": d=0
        if c=="1": d=1
        if c=="2": d=2
        if c=="3": d=3
        if c=="4": d=4
        if c=="5": d=5
        if c=="6": d=6
        if c=="7": d=7
        if c=="8": d=8
        if c=="9": d=9
        if inf: fp=fp*10+d; fd=fd*10 else: ip=ip*10+d
        i=i+1
    let r = _itof(ip)
    if fd>1: let f = _itof(fp)/_itof(fd); if si<0.0: return si*(r+f) else: return r+f
    return si*r

fn _usage() -> String:
    var t = "icono-spawno " + VERSION + " -- reson8 procedural icon creator\n\n"
    t = t + "USAGE: kain run icono-spawno -- [OPTIONS]\n\n"
    t = t + "  --name <name>       Single icon\n"
    t = t + "  --category <cat>    Icons by category\n"
    t = t + "  --all               Full suite (50 icons)\n"
    t = t + "  --size <N>          Pixel size (default: 256)\n"
    t = t + "  --color <hex>       Fill color (default: #e94560)\n"
    t = t + "  --output <dir>      Output directory (default: icons/)\n"
    t = t + "  --help              This help\n"
    t = t + "\nCategories: transport mixer edit navigation tool status settings midi general\n"
    return t

fn _join_cats() -> String:
    let cats=icon_cats()
    var s=""; var i=0
    while i<len(cats): if i>0: s=s+", "; s=s+cats[i]; i=i+1
    return s

fn _parse(argv: Array<String>) -> CliCfg:
    var cfg=_dcfg()
    var i=0
    while i<len(argv):
        let a=argv[i]
        if a=="--help" or a=="-h": cfg.help=true
        if a=="--all": cfg.all=true
        if a=="--quiet" or a=="-q": cfg.quiet=true
        if a=="--name": if i+1<len(argv): cfg.name=argv[i+1]; i=i+1
        if a=="--category": if i+1<len(argv): cfg.category=argv[i+1]; i=i+1
        if a=="--size": if i+1<len(argv): cfg.sz=_atoi(argv[i+1]); i=i+1
        if a=="--color": if i+1<len(argv): cfg.fcol=argv[i+1]; i=i+1
        if a=="--stroke": if i+1<len(argv): cfg.scol=argv[i+1]; i=i+1
        if a=="--stroke-width": if i+1<len(argv): cfg.sw=_atof(argv[i+1]); i=i+1
        if a=="--bg": if i+1<len(argv): cfg.bg=argv[i+1]; i=i+1
        if a=="--output": if i+1<len(argv): cfg.out=argv[i+1]; i=i+1
        i=i+1
    return cfg

fn _collect(cfg: CliCfg) -> Array<String>:
    var n: Array<String> = []
    if cfg.name!="": push(n,cfg.name); return n
    if cfg.all: let a=icon_all(); var j=0; while j<len(a): push(n,a[j].name); j=j+1; return n
    if cfg.category!="": let a=icon_all(); var j=0; while j<len(a): if a[j].category==cfg.category: push(n,a[j].name); j=j+1; return n
    return n

fn _iscat(cat: String) -> Bool:
    let cats=icon_cats(); var i=0
    while i<len(cats): if cats[i]==cat: return true; i=i+1
    return false

// ===== MAIN =====
fn main() -> Int:
    let argv = process_user_args()
    if len(argv) == 0: print(_usage()); return EXIT_HELP
    let cfg = _parse(argv)
    if cfg.help: print(_usage()); return EXIT_HELP
    if cfg.name=="" and cfg.category=="" and cfg.all==false: println("Error: Use --name, --category, or --all."); print(_usage()); return EXIT_ERROR
    if cfg.category!="" and _iscat(cfg.category)==false: println("Error: Unknown category '"+cfg.category+"'."); println("Valid: "+_join_cats()); return EXIT_ERROR
    if cfg.sz<16 or cfg.sz>4096: println("Error: Size must be 16-4096."); return EXIT_ERROR
    let names = _collect(cfg)
    if len(names)==0: println("Error: No icons matched."); return EXIT_ERROR
    fs_create_dir_all(cfg.out)
    if cfg.quiet==false: println("\n  icono-spawno "+VERSION+"\n  "+str(len(names))+" icons, "+str(cfg.sz)+"px -> "+cfg.out+"\n")
    var ok=0; var i=0
    while i<len(names):
        let nm=names[i]
        let svg=icon_svg(nm,cfg.sz,cfg.fcol,cfg.scol,cfg.sw,cfg.bg)
        if svg=="":
            if cfg.quiet==false: println("  SKIP  "+nm)
        else:
            let fp=os_path_join(cfg.out,nm+".svg")
            fs_write_text(fp,svg)
            ok=ok+1
            if cfg.quiet==false: println("  OK    "+nm+".svg")
        i=i+1
    if cfg.quiet==false: println("\n  Generated: "+str(ok)+" icons\n")
    if ok==0: return EXIT_ERROR
    return EXIT_OK
