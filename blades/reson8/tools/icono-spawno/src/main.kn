    return b

fn i_info(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(12.0,sz), _px(12.0,sz), _px(9.0,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(12.0,sz), _px(7.5,sz), _px(1.0,sz), "#ffffff", "none", 0.0)
    b = b + "\n  " + _svg_path("M " + _ff(_px(12.0,sz)) + " " + _ff(_px(10.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(16.5,sz)), "none", "#ffffff", sw*3.0)
    return b

// ---- SETTINGS (4) ----
fn i_settings(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(12.0,sz), _px(12.0,sz), _px(6.0,sz), "none", st, sw)
    b = b + "\n  " + _svg_circle(_px(12.0,sz), _px(12.0,sz), _px(2.5,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_path("M " + _ff(_px(12.0,sz)) + " " + _ff(_px(3.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(5.0,sz)) + " M " + _ff(_px(12.0,sz)) + " " + _ff(_px(19.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(21.0,sz)) + " M " + _ff(_px(3.0,sz)) + " " + _ff(_px(12.0,sz)) + " L " + _ff(_px(5.0,sz)) + " " + _ff(_px(12.0,sz)) + " M " + _ff(_px(19.0,sz)) + " " + _ff(_px(12.0,sz)) + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(12.0,sz)), "none", st, sw)
    return b

fn i_search(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(10.0,sz), _px(10.0,sz), _px(6.0,sz), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(14.5,sz)) + " " + _ff(_px(14.5,sz)) + " L " + _ff(_px(20.0,sz)) + " " + _ff(_px(20.0,sz)), "none", st, sw)
    return b

fn i_menu(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(3.0,sz)) + " " + _ff(_px(5.0,sz)) + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(5.0,sz))
    d = d + " M " + _ff(_px(3.0,sz)) + " " + _ff(_px(12.0,sz)) + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(12.0,sz))
    d = d + " M " + _ff(_px(3.0,sz)) + " " + _ff(_px(19.0,sz)) + " L " + _ff(_px(21.0,sz)) + " " + _ff(_px(19.0,sz))
    return _svg_path(d, "none", st, sw)

fn i_close(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(5.0,sz)) + " " + _ff(_px(5.0,sz)) + " L " + _ff(_px(19.0,sz)) + " " + _ff(_px(19.0,sz))
    d = d + " M " + _ff(_px(19.0,sz)) + " " + _ff(_px(5.0,sz)) + " L " + _ff(_px(5.0,sz)) + " " + _ff(_px(19.0,sz))
    return _svg_path(d, "none", st, sw)

// ---- MIDI (3) ----
fn i_midi(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(12.0,sz), _px(12.0,sz), _px(9.0,sz), "none", st, sw)
    b = b + "\n  " + _svg_circle(_px(8.0,sz), _px(9.0,sz), _px(1.2,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(12.0,sz), _px(7.0,sz), _px(1.2,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(16.0,sz), _px(9.0,sz), _px(1.2,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(8.5,sz), _px(15.0,sz), _px(1.2,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(15.5,sz), _px(15.0,sz), _px(1.2,sz), f, "none", 0.0)
    return b

fn i_piano(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_rect(_px(3.0,sz), _px(5.0,sz), _px(18.0,sz), _px(15.0,sz), "none", st, sw, 0.0)
    b = b + "\n  " + _svg_path("M " + _ff(_px(7.5,sz)) + " " + _ff(_px(5.0,sz)) + " L " + _ff(_px(7.5,sz)) + " " + _ff(_px(20.0,sz)) + " M " + _ff(_px(12.0,sz)) + " " + _ff(_px(5.0,sz)) + " L " + _ff(_px(12.0,sz)) + " " + _ff(_px(20.0,sz)) + " M " + _ff(_px(16.5,sz)) + " " + _ff(_px(5.0,sz)) + " L " + _ff(_px(16.5,sz)) + " " + _ff(_px(20.0,sz)), "none", st, sw*0.5)
    b = b + "\n  " + _svg_rect(_px(5.5,sz), _px(5.0,sz), _px(3.0,sz), _px(8.0,sz), f, "none", 0.0, 0.0)
    b = b + "\n  " + _svg_rect(_px(10.5,sz), _px(5.0,sz), _px(3.0,sz), _px(8.0,sz), f, "none", 0.0, 0.0)
    b = b + "\n  " + _svg_rect(_px(14.5,sz), _px(5.0,sz), _px(3.0,sz), _px(8.0,sz), f, "none", 0.0, 0.0)
    return b

fn i_note(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(8.0,sz), _px(17.0,sz), _px(2.5,sz), f, st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(10.5,sz)) + " " + _ff(_px(17.0,sz)) + " L " + _ff(_px(10.5,sz)) + " " + _ff(_px(5.0,sz)), "none", st, sw)
    b = b + "\n  " + _svg_path("M " + _ff(_px(10.5,sz)) + " " + _ff(_px(5.0,sz)) + " Q " + _ff(_px(16.0,sz)) + " " + _ff(_px(7.0,sz)) + " " + _ff(_px(14.0,sz)) + " " + _ff(_px(11.0,sz)), "none", st, sw)
    return b

// ---- GENERAL (4) ----
fn i_r8logo(sz: Int, f: String, st: String, sw: Float) -> String:
    var d = "M " + _ff(_px(6.0,sz)) + " " + _ff(_px(4.0,sz)) + " L " + _ff(_px(6.0,sz)) + " " + _ff(_px(20.0,sz))
    d = d + " L " + _ff(_px(13.0,sz)) + " " + _ff(_px(20.0,sz))
    d = d + " Q " + _ff(_px(18.0,sz)) + " " + _ff(_px(20.0,sz)) + " " + _ff(_px(18.0,sz)) + " " + _ff(_px(15.0,sz))
    d = d + " Q " + _ff(_px(18.0,sz)) + " " + _ff(_px(10.0,sz)) + " " + _ff(_px(14.0,sz)) + " " + _ff(_px(9.0,sz))
    d = d + " L " + _ff(_px(17.0,sz)) + " " + _ff(_px(4.0,sz))
    d = d + " M " + _ff(_px(6.0,sz)) + " " + _ff(_px(12.0,sz)) + " L " + _ff(_px(13.0,sz)) + " " + _ff(_px(12.0,sz))
    var b = _svg_path(d, "none", st, sw)
    var dw = "M " + _ff(_px(4.0,sz)) + " " + _ff(_px(23.0,sz)) + " Q " + _ff(_px(8.0,sz)) + " " + _ff(_px(20.0,sz)) + " " + _ff(_px(12.0,sz)) + " " + _ff(_px(23.0,sz))
    dw = dw + " T " + _ff(_px(20.0,sz)) + " " + _ff(_px(23.0,sz))
    b = b + "\n  " + _svg_path(dw, "none", f, sw*0.6)
    return b

fn i_plugin(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_rect(_px(6.0,sz), _px(10.0,sz), _px(12.0,sz), _px(8.0,sz), f, st, sw, _px(1.0,sz))
    b = b + "\n  " + _svg_rect(_px(8.0,sz), _px(4.0,sz), _px(2.0,sz), _px(6.0,sz), f, st, sw, _px(0.5,sz))
    b = b + "\n  " + _svg_rect(_px(14.0,sz), _px(4.0,sz), _px(2.0,sz), _px(6.0,sz), f, st, sw, _px(0.5,sz))
    var dc = "M " + _ff(_px(9.0,sz)) + " " + _ff(_px(4.0,sz)) + " Q " + _ff(_px(9.0,sz)) + " " + _ff(_px(2.0,sz)) + " " + _ff(_px(12.0,sz)) + " " + _ff(_px(2.0,sz)) + " T " + _ff(_px(15.0,sz)) + " " + _ff(_px(4.0,sz))
    b = b + "\n  " + _svg_path(dc, "none", st, sw)
    return b

fn i_theme(sz: Int, f: String, st: String, sw: Float) -> String:
    var dp = "M " + _ff(_px(12.0,sz)) + " " + _ff(_px(2.0,sz))
    dp = dp + " A " + _ff(_px(10.0,sz)) + " " + _ff(_px(10.0,sz)) + " 0 1 1 " + _ff(_px(7.0,sz)) + " " + _ff(_px(20.0,sz))
    dp = dp + " A " + _ff(_px(3.0,sz)) + " " + _ff(_px(2.5,sz)) + " 0 1 0 " + _ff(_px(17.0,sz)) + " " + _ff(_px(19.0,sz))
    dp = dp + " A " + _ff(_px(10.0,sz)) + " " + _ff(_px(10.0,sz)) + " 0 1 1 " + _ff(_px(12.0,sz)) + " " + _ff(_px(2.0,sz))
    var b = _svg_path(dp, "none", st, sw)
    b = b + "\n  " + _svg_circle(_px(8.0,sz), _px(9.0,sz), _px(2.0,sz), f, "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(16.0,sz), _px(7.0,sz), _px(2.0,sz), "#60a5fa", "none", 0.0)
    b = b + "\n  " + _svg_circle(_px(14.0,sz), _px(16.0,sz), _px(2.0,sz), "#f59e0b", "none", 0.0)
    return b

fn i_python(sz: Int, f: String, st: String, sw: Float) -> String:
    var b = _svg_circle(_px(8.5,sz), _px(8.5,sz), _px(5.0,sz), "none", st, sw)
    b = b + "\n  " + _svg_circle(_px(15.5,sz), _px(15.5,sz), _px(5.0,sz), f, st, sw)
    var dc = "M " + _ff(_px(13.0,sz)) + " " + _ff(_px(6.5,sz)) + " Q " + _ff(_px(20.0,sz)) + " " + _ff(_px(8.0,sz)) + " " + _ff(_px(17.0,sz)) + " " + _ff(_px(12.0,sz))
    dc = dc + " Q " + _ff(_px(14.0,sz)) + " " + _ff(_px(16.0,sz)) + " " + _ff(_px(11.0,sz)) + " " + _ff(_px(17.0,sz))
    b = b + "\n  " + _svg_path(dc, "none", st, sw)
    b = b + "\n  " + _svg_circle(_px(14.5,sz), _px(14.0,sz), _px(0.8,sz), "#ffffff", "none", 0.0)
    return b

// ===== ICON DISPATCH =====
fn icon_body(name: String, sz: Int, f: String, st: String, sw: Float) -> String:
    if name == "play": return i_play(sz, f, st, sw)
    if name == "stop": return i_stop(sz, f, st, sw)
    if name == "pause": return i_pause(sz, f, st, sw)
    if name == "record": return i_record(sz, f, st, sw)
    if name == "loop": return i_loop(sz, f, st, sw)
    if name == "skip_forward": return i_skip_fwd(sz, f, st, sw)
    if name == "skip_back": return i_skip_back(sz, f, st, sw)
    if name == "volume_high": return i_vol_hi(sz, f, st, sw)
    if name == "volume_low": return i_vol_lo(sz, f, st, sw)
    if name == "volume_mute": return i_vol_mute(sz, f, st, sw)
    if name == "pan": return i_pan(sz, f, st, sw)
    if name == "fx": return i_fx(sz, f, st, sw)
    if name == "eq": return i_eq(sz, f, st, sw)
    if name == "compressor": return i_comp(sz, f, st, sw)
    if name == "reverb": return i_reverb(sz, f, st, sw)
    if name == "cut": return i_cut(sz, f, st, sw)
    if name == "copy": return i_copy(sz, f, st, sw)
    if name == "paste": return i_paste(sz, f, st, sw)
    if name == "undo": return i_undo(sz, f, st, sw)
    if name == "redo": return i_redo(sz, f, st, sw)
    if name == "delete": return i_delete(sz, f, st, sw)
    if name == "trim": return i_trim(sz, f, st, sw)
    if name == "split": return i_split(sz, f, st, sw)
    if name == "folder": return i_folder(sz, f, st, sw)
    if name == "file": return i_file(sz, f, st, sw)
    if name == "save": return i_save(sz, f, st, sw)
    if name == "open": return i_open(sz, f, st, sw)
    if name == "new": return i_new(sz, f, st, sw)
    if name == "export": return i_export(sz, f, st, sw)
    if name == "zoom_in": return i_zoom_in(sz, f, st, sw)
    if name == "zoom_out": return i_zoom_out(sz, f, st, sw)
    if name == "selection": return i_selection(sz, f, st, sw)
    if name == "pencil": return i_pencil(sz, f, st, sw)
    if name == "crosshair": return i_crosshair(sz, f, st, sw)
    if name == "grid": return i_grid(sz, f, st, sw)
    if name == "check": return i_check(sz, f, st, sw)
    if name == "warning": return i_warning(sz, f, st, sw)
    if name == "error": return i_error(sz, f, st, sw)
    if name == "info": return i_info(sz, f, st, sw)
    if name == "settings": return i_settings(sz, f, st, sw)
    if name == "search": return i_search(sz, f, st, sw)
    if name == "menu": return i_menu(sz, f, st, sw)
    if name == "close": return i_close(sz, f, st, sw)
    if name == "midi": return i_midi(sz, f, st, sw)
    if name == "piano": return i_piano(sz, f, st, sw)
    if name == "note": return i_note(sz, f, st, sw)
    if name == "reson8_logo": return i_r8logo(sz, f, st, sw)
    if name == "plugin": return i_plugin(sz, f, st, sw)
    if name == "theme": return i_theme(sz, f, st, sw)
    if name == "python": return i_python(sz, f, st, sw)
    return ""

fn icon_svg(name: String, sz: Int, f: String, st: String, sw: Float, bg: String) -> String:
    let body = icon_body(name, sz, f, st, sw)
    if body == "": return ""
    return _svg_doc(sz, sz, "  " + body + "\n", bg)

