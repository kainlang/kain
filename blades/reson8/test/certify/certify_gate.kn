// ============================================================================
//  CERTIFY GATE -- reson8 Release-Readiness Aggregator
//
//  Aggregates every test category into one release gate.
//  FAILS if ANY category has failures. Uses std::test for outcome
//  aggregation and std::certify for build-system task registration.
//
//  Categories:
//    LAWS     -- All 31+ law predicates (mixer + plugin)
//    ATTRITION -- Boundary condition stress tests
//    RUNTIME  -- Telemetry counter availability
// ============================================================================

use std::test
use std::certify
use std::intent
use std::runtime
use law::mixer_laws
use law::plugin_laws

// ============================================================================
//  HELPERS -- Single-line test_combine chains
// ============================================================================

fn combine4(a: TestOutcome, b: TestOutcome, c: TestOutcome, d: TestOutcome) -> TestOutcome:
    return test_combine(test_combine(a, b), test_combine(c, d))

fn combine6(a: TestOutcome, b: TestOutcome, c: TestOutcome, d: TestOutcome, e: TestOutcome, f: TestOutcome) -> TestOutcome:
    return test_combine(combine4(a, b, c, d), test_combine(e, f))

fn combine8(a: TestOutcome, b: TestOutcome, c: TestOutcome, d: TestOutcome, e: TestOutcome, f: TestOutcome, g: TestOutcome, h: TestOutcome) -> TestOutcome:
    return test_combine(combine4(a, b, c, d), combine4(e, f, g, h))

// ============================================================================
//  CATEGORY 1 -- LAW PREDICATES
// ============================================================================

fn test_law_volume() -> TestOutcome:
    let a = test_bool("volume 0.5 valid",
        law_is_valid_status(law_status(master_volume_in_bounds(0.5))))
    let b = test_bool("volume -0.1 invalid",
        law_is_valid_status(law_status(master_volume_in_bounds(-0.1))) == false)
    let c = test_bool("volume 1.5 invalid",
        law_is_valid_status(law_status(master_volume_in_bounds(1.5))) == false)
    let d = test_bool("volume 0.0 boundary",
        law_is_valid_status(law_status(master_volume_in_bounds(0.0))))
    let e = test_bool("volume 1.0 boundary",
        law_is_valid_status(law_status(master_volume_in_bounds(1.0))))
    return combine4(a, b, c, test_combine(d, e))

fn test_law_transport() -> TestOutcome:
    let a = test_bool("transport 0 valid",
        law_is_valid_status(law_status(transport_state_valid(0))))
    let b = test_bool("transport 3 valid",
        law_is_valid_status(law_status(transport_state_valid(3))))
    let c = test_bool("transport -1 invalid",
        law_is_valid_status(law_status(transport_state_valid(-1))) == false)
    let d = test_bool("transport 4 invalid",
        law_is_valid_status(law_status(transport_state_valid(4))) == false)
    return combine4(a, b, c, d)

fn test_law_tempo() -> TestOutcome:
    let a = test_bool("tempo 120 valid",
        law_is_valid_status(law_status(tempo_valid(120.0))))
    let b = test_bool("tempo 20 boundary",
        law_is_valid_status(law_status(tempo_valid(20.0))))
    let c = test_bool("tempo 400 boundary",
        law_is_valid_status(law_status(tempo_valid(400.0))))
    let d = test_bool("tempo 0 invalid",
        law_is_valid_status(law_status(tempo_valid(0.0))) == false)
    let e = test_bool("tempo 500 invalid",
        law_is_valid_status(law_status(tempo_valid(500.0))) == false)
    let f = test_bool("tempo 19.999 invalid",
        law_is_valid_status(law_status(tempo_valid(19.999))) == false)
    let g = test_bool("tempo 400.001 invalid",
        law_is_valid_status(law_status(tempo_valid(400.001))) == false)
    return test_combine(combine4(a, b, c, d), combine4(e, f, test_bool("tempo_done", true), test_bool("tempo_done2", true)))

fn test_law_samplerate() -> TestOutcome:
    let a = test_bool("sr 44100 valid",
        law_is_valid_status(law_status(sample_rate_valid(44100))))
    let b = test_bool("sr 48000 valid",
        law_is_valid_status(law_status(sample_rate_valid(48000))))
    let c = test_bool("sr 88200 valid",
        law_is_valid_status(law_status(sample_rate_valid(88200))))
    let d = test_bool("sr 96000 valid",
        law_is_valid_status(law_status(sample_rate_valid(96000))))
    let e = test_bool("sr 176400 valid",
        law_is_valid_status(law_status(sample_rate_valid(176400))))
    let f = test_bool("sr 192000 valid",
        law_is_valid_status(law_status(sample_rate_valid(192000))))
    let g = test_bool("sr 22050 invalid",
        law_is_valid_status(law_status(sample_rate_valid(22050))) == false)
    let h = test_bool("sr 0 invalid",
        law_is_valid_status(law_status(sample_rate_valid(0))) == false)
    return combine8(a, b, c, d, e, f, g, h)

fn test_law_buffer() -> TestOutcome:
    let a = test_bool("buf 256 valid",
        law_is_valid_status(law_status(buffer_size_valid(256))))
    let b = test_bool("buf 16 boundary",
        law_is_valid_status(law_status(buffer_size_valid(16))))
    let c = test_bool("buf 4096 boundary",
        law_is_valid_status(law_status(buffer_size_valid(4096))))
    let d = test_bool("buf 0 invalid",
        law_is_valid_status(law_status(buffer_size_valid(0))) == false)
    let e = test_bool("buf 15 invalid",
        law_is_valid_status(law_status(buffer_size_valid(15))) == false)
    let f = test_bool("buf 4097 invalid",
        law_is_valid_status(law_status(buffer_size_valid(4097))) == false)
    let g = test_bool("buf 100 (non-16) invalid",
        law_is_valid_status(law_status(buffer_size_valid(100))) == false)
    let h = test_bool("buf 17 (odd) invalid",
        law_is_valid_status(law_status(buffer_size_valid(17))) == false)
    return combine8(a, b, c, d, e, f, g, h)

fn test_law_time_sig() -> TestOutcome:
    let a = test_bool("time 4/4 valid",
        law_is_valid_status(law_status(time_signature_valid(4, 4))))
    let b = test_bool("time 3/8 valid",
        law_is_valid_status(law_status(time_signature_valid(3, 8))))
    let c = test_bool("time 0/4 invalid",
        law_is_valid_status(law_status(time_signature_valid(0, 4))) == false)
    let d = test_bool("time 4/3 invalid",
        law_is_valid_status(law_status(time_signature_valid(4, 3))) == false)
    let e = test_bool("time 1/1 valid",
        law_is_valid_status(law_status(time_signature_valid(1, 1))))
    let f = test_bool("time 32/16 valid",
        law_is_valid_status(law_status(time_signature_valid(32, 16))))
    return combine4(a, b, c, test_combine(d, test_combine(e, f)))

