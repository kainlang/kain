fn test_law_loop() -> TestOutcome:
    let a = test_bool("loop 0,100,1000 valid",
        law_is_valid_status(law_status(loop_region_valid(0, 100, 1000))))
    let b = test_bool("loop equal start,end invalid",
        law_is_valid_status(law_status(loop_region_valid(100, 100, 1000))) == false)
    let c = test_bool("loop end>max invalid",
        law_is_valid_status(law_status(loop_region_valid(0, 100, 50))) == false)
    let d = test_bool("loop negative start invalid",
        law_is_valid_status(law_status(loop_region_valid(-1, 100, 1000))) == false)
    return combine4(a, b, c, d)

