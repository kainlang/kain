// pub fn calc_highpass_coeffs(freq: Float, q: Float, sr: Int) -> BiquadCoeffs with Pure:
//     return biquad_highpass(freq, q, sr)
//
// pub fn calc_lowshelf_coeffs(freq: Float, q: Float, gain_db: Float, sr: Int) -> BiquadCoeffs with Pure:
