// // settings.kn — reson8 Settings/Preferences UI Component
// //
// // A comprehensive settings panel covering audio, appearance, plugins,
// // MIDI, keybindings, and project defaults. Every setting maps to a
// // world state field — mutations are journaled patches, undoable.
// //
// // Owned by: T3-SETTINGS (add to STREAM3 tasks)
//
// use std::math
//
// // ============================================================================
// //  SettingsPanel — Top-level settings window with category tabs
// // ============================================================================
//
// component SettingsPanel():
//     state active_category: String = "audio"
//     state search_query: String = ""
