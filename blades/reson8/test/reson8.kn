// // plugin_host_bridge.kn — Wires PluginHost actor to VST3 + CLAP C facades
// //
// // STREAM4: T4-9 — This is the actor→C bridge wiring layer for foreign plugins.
// // Imports vst3_host and clap_host facades, exposes a unified plugin API
// // that PluginHost actors use for three-lane dispatch.
// //
// // C bridges at:  src/bridge/native/vst3_host_bridge.cpp / clap_host_bridge.c
// // Kain facades:  src/bridge/vst3_host.kn / src/bridge/clap_host.kn
//
// // ── VST3 Host Bridge ──
