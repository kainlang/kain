//!kain-file-content
// // ============================================================================
// //  THEMEWORLD + THEMEMIRROR — Compiler-owned theme state authority
// //  Owned by STREAM1. Read by STREAM3 (all UI components) and main_test.
// //  Mirror enables resonate-driven hot-reload: when ThemeWorld changes,
// //  ThemeMirror propagates for UI component observation.
// //  NOTE: Full 80+ property theme spec exists at theme_world_full.kn.
// //        Only currently-referenced fields are here to avoid dead-state
// //        build failures. Re-expand when STREAM3 UI wiring begins.
// // ============================================================================
//
// use std::math
//
// pub fn hex_color(hex: String) -> ColorRgba:
//     return color_rgba(0.0, 0.0, 0.0, 1.0)
//
// pub fn color_transparent() -> ColorRgba:
//     return color_rgba(0.0, 0.0, 0.0, 0.0)
//
// pub fn color_white() -> ColorRgba:
//     return color_rgba(1.0, 1.0, 1.0, 1.0)
//
// // ============================================================================
// //  THEMEWORLD
// // ============================================================================
//
// world ThemeWorld:
//     # ── Theme identity ──
//     state active_theme_name: String = "reson8-dark"
//     state theme_version:     Int    = 1
//     state theme_author:      String = "reson8 Studio"
//     state theme_description: String = "Default reson8 dark theme"
//
//     # ── Core colors (referenced by main_test check) ──
//     state color_accent:      ColorRgba = color_rgba(0.914, 0.271, 0.376, 1.0)
//     state color_accent_hover: ColorRgba = color_rgba(0.95, 0.4, 0.5, 1.0)
//     state color_accent_pressed: ColorRgba = color_rgba(0.7, 0.15, 0.25, 1.0)
//     state color_bg_primary:  ColorRgba = color_rgba(0.12, 0.12, 0.14, 1.0)
//     state color_text_primary: ColorRgba = color_rgba(0.92, 0.92, 0.93, 1.0)
//     state color_text_secondary: ColorRgba = color_rgba(0.6, 0.6, 0.62, 1.0)
//     state color_error:       ColorRgba = color_rgba(0.9, 0.2, 0.2, 1.0)
//     state color_button_default: ColorRgba = color_rgba(0.25, 0.25, 0.28, 1.0)
//     state color_slider_track: ColorRgba = color_rgba(0.18, 0.18, 0.2, 1.0)
//     state color_slider_fill: ColorRgba = color_rgba(0.914, 0.271, 0.376, 0.6)
//     state color_slider_thumb: ColorRgba = color_rgba(0.914, 0.271, 0.376, 1.0)
//     state color_fader_cap:   ColorRgba = color_rgba(0.914, 0.271, 0.376, 1.0)
//     state color_fader_cap_line: ColorRgba = color_rgba(0.95, 0.5, 0.6, 1.0)
//     state fader_width:       Float = 24.0
//     state fader_throw:       Float = 180.0
//     state fader_cap_w:       Float = 16.0
//     state mixer_strip_width: Float = 60.0
//     state spacing_xs:        Float = 4.0
//     state spacing_sm:        Float = 8.0
//     state font_size_xs:      Float = 10.0
//     state font_size_sm:      Float = 12.0
//     state font_weight_medium: Int  = 500
//     state radius_full:       Float = 4.0
//     state radius_sm:         Float = 3.0
//     state transport_height:  Float = 48.0
//     state spacing_md:        Float = 16.0
//     state spacing_lg:        Float = 24.0
//     state color_bg_secondary: ColorRgba = color_rgba(0.08, 0.08, 0.1, 1.0)
//     state color_border_subtle: ColorRgba = color_rgba(0.2, 0.2, 0.22, 1.0)
//     state color_text_muted:   ColorRgba = color_rgba(0.4, 0.4, 0.42, 1.0)
//
//     # ── Surfaces ──
//     surface native_ui => ThemeEditor
//     surface web      => ThemeEditor
//
// // ============================================================================
// //  THEMEMIRROR — Mirror for UI hot-reload observation
// // ============================================================================
//
// world ThemeMirror:
//     state active_theme_name_copy: String = "reson8-dark"
//     state color_accent_copy:      ColorRgba = color_rgba(0.914, 0.271, 0.376, 1.0)
//     surface native_ui => ThemeEditor
//     surface web      => ThemeEditor
//
// // ── Entangle: mirror theme identity for hot-reload ──
// entangle ThemeWorld.active_theme_name <-> ThemeMirror.active_theme_name_copy with single_writer
// entangle ThemeWorld.color_accent      <-> ThemeMirror.color_accent_copy      with single_writer
//!end-kain-file
