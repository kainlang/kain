// fn apply_phase_invert(input: ptr<Float>, output: ptr<Float>, frames: Int,
//                        invert: Bool) -> Int with Unsafe:
//     if invert == false:
//         var i: Int = 0
//         while i < frames * 2:
//             let val: Float = mem_load(ptr_offset(input, i, "Float"), "Float")
//             mem_store(ptr_offset(output, i, "Float"), val, "Float")
//             i = i + 1
