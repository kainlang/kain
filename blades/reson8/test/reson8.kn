// // vst3_host.kn — Kain facade over vst3_host_bridge (Steinberg VST3 SDK)
// //
// // Pattern: smoketest/interop/sqlite_rally.kn
// //   include "native/header.h" as alias  →  Kain facade wraps raw alias_* calls
// //
// // This is the SINGLE canonical include site for VST3 hosting.
// // All other reson8 modules import THIS, never the raw bridge.
//
// include "native/vst3_host_bridge.h" as vst3
//
