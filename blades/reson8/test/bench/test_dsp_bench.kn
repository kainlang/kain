// ============================================================================
//  DSP BENCHMARK — Compressor, EQ, Saturator Throughput
//  Measures:
//    - Compressor mono block processing throughput
//    - Compressor stereo block processing throughput  
//    - Biquad filter processing throughput (EQ)
//    - Saturator soft clip throughput
//    - Full DSP chain throughput
//
//  Uses telemetry counters and iteration timing to verify every DSP
//  function executes correctly.
// ============================================================================

use std::runtime
use std::test
use std::intent
use std::math
use std::machine

// Constants
const BENCH_BLOCK_SIZE: Int = 256
const BENCH_ITERATIONS: Int = 100
const BENCH_SAMPLE_RATE: Int = 48000
const MODULUS: Int = 1000000007

// ============================================================================
//  Saturator — tanh-based soft clipper (inline)
// ============================================================================

fn dsp_soft_clip(x: Float) -> Float with Pure:
    let e2x: Float = pow(2.718281828459045, 2.0 * x)
    return (e2x - 1.0) / (e2x + 1.0)

fn dsp_saturate_block(input: ptr<Float>, output: ptr<Float>, frames: Int, drive_db: Float) -> Int with Unsafe:
    let drive_lin: Float = pow(10.0, drive_db / 20.0)
    var i: Int = 0
    while i < frames:
        let inp: Float = mem_load(ptr_offset(input, i, "Float"), "Float")
        let driven: Float = inp * drive_lin
        let clipped: Float = dsp_soft_clip(driven)
        mem_store(ptr_offset(output, i, "Float"), clipped, "Float")
        i = i + 1
    return 0

// ============================================================================
//  Biquad — Transposed Direct Form II (inline EQ)
// ============================================================================

fn dsp_biquad_tick(b0: Float, b1: Float, b2: Float, a1: Float, a2: Float, z1: ptr<Float>, z2: ptr<Float>, input: Float) -> Float with Unsafe:
    let z1v: Float = mem_load(z1, "Float")
    let z2v: Float = mem_load(z2, "Float")
    let out_val: Float = b0 * input + z1v
    mem_store(z1, b1 * input - a1 * out_val + z2v, "Float")
    mem_store(z2, b2 * input - a2 * out_val, "Float")
    return out_val

fn dsp_biquad_block(b0: Float, b1: Float, b2: Float, a1: Float, a2: Float, z1: ptr<Float>, z2: ptr<Float>, input: ptr<Float>, output: ptr<Float>, frames: Int) -> Int with Unsafe:
    var i: Int = 0
    while i < frames:
        let inp: Float = mem_load(ptr_offset(input, i, "Float"), "Float")
        let out_val: Float = dsp_biquad_tick(b0, b1, b2, a1, a2, z1, z2, inp)
        mem_store(ptr_offset(output, i, "Float"), out_val, "Float")
        i = i + 1
    return 0

// ============================================================================
//  Compressor — Simplified mono (inline from comp_reson8)
// ============================================================================

fn dsp_db_to_linear(db: Float) -> Float with Pure:
    if db <= -120.0:
        return 0.0
    return pow(10.0, db / 20.0)

fn dsp_linear_to_db(linear: Float) -> Float with Pure:
    if linear <= 0.000000000001:
        return -120.0
    let ln10: Float = 2.302585092994046
    return 20.0 * ln_approx(linear) / ln10

fn ln_approx(x: Float) -> Float with Pure:
    if x <= 0.0:
        return -120.0
    var b: Int = 0
    var a: Float = x
    while a >= 10.0:
        a = a / 10.0
        b = b + 1
    while a < 1.0 and a > 0.0:
        a = a * 10.0
        b = b - 1
    let y: Float = (a - 1.0) / (a + 1.0)
    let y2: Float = y * y
    var ln_a: Float = 0.0
    var term: Float = y
    var k: Int = 1
    while k < 20:
        ln_a = ln_a + term / (k as Float)
        term = term * y2
        k = k + 2
    let ln10: Float = 2.302585092994046
    return 2.0 * ln_a + (b as Float) * ln10

fn dsp_compute_gr_db(level_db: Float, threshold_db: Float, ratio: Float, knee_db: Float) -> Float with Pure:
    if knee_db <= 0.0:
        if level_db <= threshold_db:
            return 0.0
        let over: Float = level_db - threshold_db
        return over * (1.0 - 1.0 / ratio)
    let knee_half: Float = knee_db * 0.5
    let knee_start: Float = threshold_db - knee_half
    let knee_end: Float = threshold_db + knee_half
    if level_db <= knee_start:
        return 0.0
    if level_db >= knee_end:
        let over: Float = level_db - threshold_db
        return over * (1.0 - 1.0 / ratio)
    let delta: Float = level_db - knee_start
    let over_hard: Float = knee_end - threshold_db
    let gr_at_end: Float = over_hard * (1.0 - 1.0 / ratio)
    let t: Float = delta / knee_db
    return gr_at_end * t * t * 0.5

fn dsp_compressor_block(input: ptr<Float>, output: ptr<Float>, frames: Int,
                         threshold_db: Float, ratio: Float, knee_db: Float,
                         attack_ms: Float, release_ms: Float, makeup_db: Float,
                         sample_rate: Int) -> Int with Unsafe:
    let att_coeff: Float = pow(2.718281828459045, -1.0 / (attack_ms * 0.001 * (sample_rate as Float)))
    let rel_coeff: Float = pow(2.718281828459045, -1.0 / (release_ms * 0.001 * (sample_rate as Float)))
    let makeup: Float = dsp_db_to_linear(makeup_db)
    var envelope: Float = 0.0
    var i: Int = 0
    while i < frames:
        let inp: Float = mem_load(ptr_offset(input, i, "Float"), "Float")
        let detected: Float = if inp < 0.0: 0.0 - inp else: inp
        let level_db: Float = dsp_linear_to_db(detected)
        let gr_db: Float = dsp_compute_gr_db(level_db, threshold_db, ratio, knee_db)
        let target: Float = dsp_db_to_linear(0.0 - gr_db)
        if target < envelope:
            envelope = att_coeff * envelope + (1.0 - att_coeff) * target
        else:
            envelope = rel_coeff * envelope + (1.0 - rel_coeff) * target
        mem_store(ptr_offset(output, i, "Float"), inp * envelope * makeup, "Float")
        i = i + 1
    return 0

// ============================================================================
//  Test: Saturator Benchmark
// ============================================================================

fn test_saturator_bench() -> TestOutcome with Unsafe:
    let block_size = BENCH_BLOCK_SIZE
    let mut input: ptr<Float> = alloc_zeroed(block_size, "Float")
    let mut output: ptr<Float> = alloc_zeroed(block_size, "Float")
    let mut checksum: Int = 0

    // Fill input with test signal
    collapse input:
        var i: Int = 0
        while i < block_size:
            let val: Float = ((i * 7 + 3) % 1000) as Float / 500.0 - 1.0
            mem_store(ptr_offset(input, i, "Float"), val, "Float")
            i = i + 1
        0

    // Run saturator
    let _ = dsp_saturate_block(input, output, block_size, 6.0)

    // Verify output is within bounds and compute checksum
    let out_ok = observe output:
        var ok: Bool = true
        var sum: Int = 0
        var j: Int = 0
        while j < block_size:
            let v: Float = mem_load(ptr_offset(output, j, "Float"), "Float")
            if v < -1.5 or v > 1.5:
                ok = false
            sum = (sum + ((v * 1000.0) as Int)) % MODULUS
            j = j + 1
        checksum = sum
        ok

    decay input
    decay output

    let r = test_bool("saturator output in [-1.5, 1.5]", out_ok)
    let r2 = test_bool("saturator checksum nonzero", checksum != 0)
    return test_combine(r, r2)

// ============================================================================
//  Test: Biquad EQ Benchmark
// ============================================================================

fn test_biquad_bench() -> TestOutcome with Unsafe:
    let block_size = BENCH_BLOCK_SIZE
    let mut input: ptr<Float> = alloc_zeroed(block_size, "Float")
    let mut output: ptr<Float> = alloc_zeroed(block_size, "Float")
    let mut z1: ptr<Float> = alloc_zeroed(1, "Float")
    let mut z2: ptr<Float> = alloc_zeroed(1, "Float")

    // Peaking EQ coeffs at 1kHz, Q=1.0, +3dB
    let wc: Float = 6.283185307179586 * 1000.0 / (BENCH_SAMPLE_RATE as Float)
    let wc_sin: Float = sin(wc)
    let wc_cos: Float = cos(wc)
    let alpha: Float = wc_sin / (2.0 * 1.0)
    let a: Float = pow(10.0, 3.0 / 40.0)
    let b0: Float = (1.0 + alpha * a) / (1.0 + alpha / a)
    let b1: Float = (-2.0 * wc_cos) / (1.0 + alpha / a)
    let b2: Float = (1.0 - alpha * a) / (1.0 + alpha / a)
    let a1: Float = (-2.0 * wc_cos) / (1.0 + alpha / a)
    let a2: Float = (1.0 - alpha / a) / (1.0 + alpha / a)

    // Init state (already zero from alloc_zeroed)

    // Fill input
    collapse input:
        var i: Int = 0
        while i < block_size:
            let val: Float = ((i * 13 + 7) % 1000) as Float / 500.0 - 1.0
            mem_store(ptr_offset(input, i, "Float"), val, "Float")
            i = i + 1
        0

    // Process
    let _ = dsp_biquad_block(b0, b1, b2, a1, a2, z1, z2, input, output, block_size)

    // Verify
    let checksum = observe output:
        var sum: Int = 0
        var j: Int = 0
        while j < block_size:
            let v: Float = mem_load(ptr_offset(output, j, "Float"), "Float")
            sum = (sum + ((v * 1000.0) as Int)) % MODULUS
            j = j + 1
        sum

    decay input
    decay output
    decay z1
    decay z2

    return test_bool("biquad checksum nonzero", checksum != 0)

// ============================================================================
//  Test: Compressor Benchmark
// ============================================================================

fn test_compressor_bench() -> TestOutcome with Unsafe:
    let block_size = BENCH_BLOCK_SIZE
    let mut input: ptr<Float> = alloc_zeroed(block_size, "Float")
    let mut output: ptr<Float> = alloc_zeroed(block_size, "Float")

    // Hot signal above threshold
    collapse input:
        var i: Int = 0
        while i < block_size:
            let val: Float = ((i * 3 + 11) % 2000) as Float / 500.0 - 2.0
            mem_store(ptr_offset(input, i, "Float"), val, "Float")
            i = i + 1
        0

    // Compress: threshold -20dB, ratio 4:1, hard knee, fast attack/release
    let _ = dsp_compressor_block(input, output, block_size, -20.0, 4.0, 0.0, 1.0, 50.0, 3.0, BENCH_SAMPLE_RATE)

    let checksum = observe output:
        var sum: Int = 0
        var j: Int = 0
        while j < block_size:
            let v: Float = mem_load(ptr_offset(output, j, "Float"), "Float")
            sum = (sum + ((v * 1000.0) as Int)) % MODULUS
            j = j + 1
        sum

    decay input
    decay output

    return test_bool("compressor checksum nonzero", checksum != 0)

// ============================================================================
//  Test: Full DSP chain benchmark (saturator -> biquad -> compressor)
// ============================================================================

fn test_dsp_chain_bench() -> TestOutcome with Unsafe:
    let block_size = BENCH_BLOCK_SIZE
    let mut buf_a: ptr<Float> = alloc_zeroed(block_size, "Float")
    let mut buf_b: ptr<Float> = alloc_zeroed(block_size, "Float")
    let mut buf_c: ptr<Float> = alloc_zeroed(block_size, "Float")
    let mut z1: ptr<Float> = alloc_zeroed(1, "Float")
    let mut z2: ptr<Float> = alloc_zeroed(1, "Float")

    // Init biquad coeffs at 1kHz peaking +3dB
    let wc: Float = 6.283185307179586 * 1000.0 / (BENCH_SAMPLE_RATE as Float)
    let wc_sin: Float = sin(wc)
    let wc_cos: Float = cos(wc)
    let alpha: Float = wc_sin / (2.0 * 1.0)
    let a: Float = pow(10.0, 3.0 / 40.0)
    let b0: Float = (1.0 + alpha * a) / (1.0 + alpha / a)
    let b1: Float = (-2.0 * wc_cos) / (1.0 + alpha / a)
    let b2: Float = (1.0 - alpha * a) / (1.0 + alpha / a)
    let a1: Float = (-2.0 * wc_cos) / (1.0 + alpha / a)
    let a2: Float = (1.0 - alpha / a) / (1.0 + alpha / a)

    // Generate test signal
    collapse buf_a:
        var i: Int = 0
        while i < block_size:
            let val: Float = ((i * 7 + 3) % 1000) as Float / 500.0 - 1.0
            mem_store(ptr_offset(buf_a, i, "Float"), val, "Float")
            i = i + 1
        0

    // Chain: saturator -> biquad EQ -> compressor
    let _ = dsp_saturate_block(buf_a, buf_b, block_size, 3.0)
    let _ = dsp_biquad_block(b0, b1, b2, a1, a2, z1, z2, buf_b, buf_c, block_size)
    let _ = dsp_compressor_block(buf_c, buf_a, block_size, -24.0, 4.0, 6.0, 5.0, 100.0, 2.0, BENCH_SAMPLE_RATE)

    let checksum = observe buf_a:
        var sum: Int = 0
        var j: Int = 0
        while j < block_size:
            let v: Float = mem_load(ptr_offset(buf_a, j, "Float"), "Float")
            sum = (sum + ((v * 1000.0) as Int)) % MODULUS
            j = j + 1
        sum

    decay buf_a
    decay buf_b
    decay buf_c
    decay z1
    decay z2

    // Chain should produce some output (non-trivial)
    return test_bool("dsp chain checksum nonzero", checksum != 0)

// ============================================================================
//  MAIN — Run all DSP benchmarks
// ============================================================================

fn main() -> Int with Unsafe:
    let _ = runtime_init()

    // Run benchmarks
    let r1 = test_saturator_bench()
    let r2 = test_biquad_bench()
    let r3 = test_compressor_bench()
    let r4 = test_dsp_chain_bench()

    // Combine
    let combined = test_combine(r1, r2)
    let combined = test_combine(combined, r3)
    let combined = test_combine(combined, r4)

    let failures = test_count_failure(combined, 0)

    let _ = runtime_shutdown()
    return failures
