// ============================================================================
//  test_smoke.kn — Smoke test: verify kain run works for this project
// ============================================================================

use std::test
use std::runtime

fn main() -> Int:
    let _ = runtime_init()

    let r1 = test_bool("true is true", true)
    let r2 = test_bool("one equals one", 1 == 1)
    let combined = test_combine(r1, r2)
    let failures = test_count_failure(combined, 0)

    runtime_shutdown()
    return failures
