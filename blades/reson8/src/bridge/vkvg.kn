// ============================================================================

pub fn vg_context_new(surf: Int) -> Int:
    return vkvg_bridge_context_create(surf)

pub fn vg_context_delete(ctx: Int):
    vkvg_bridge_context_destroy(ctx)

pub fn vg_status(ctx: Int) -> Int:
    return vkvg_bridge_context_status(ctx)

pub fn vg_flush(ctx: Int):
    vkvg_bridge_flush(ctx)

