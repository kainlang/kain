// vulkan_ui.kn — reson8 GPU rendering bridge
//
// Wires Vulkan (vendored at 3rdparty/vulkan/) to the Kain UI system.
// Provides: instance/device/swapchain setup, render pass, draw commands,
// and glass-friendly rendering (rounded rects, gradients, blur sampling).
//
// Uses include <vulkan/vulkan.h> as vk — 755 Vulkan functions via libclang.

include <vulkan/vulkan.h> as vk

// ── Constants ──
const VK_SUCCESS: Int = 0
const VK_STRUCTURE_TYPE_APPLICATION_INFO: Int = 0
const VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO: Int = 1
const VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO: Int = 11
const VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR: Int = 1000001000
const VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO: Int = 22
const VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO: Int = 20
const VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO: Int = 23
const VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO: Int = 21
const VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO: Int = 24
const VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO: Int = 27
const VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO: Int = 28
const VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO: Int = 34
const VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO: Int = 40
const VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO: Int = 42
const VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO: Int = 43
const VK_STRUCTURE_TYPE_SUBMIT_INFO: Int = 47
const VK_STRUCTURE_TYPE_PRESENT_INFO_KHR: Int = 1000001001
const VK_STRUCTURE_TYPE_FENCE_CREATE_INFO: Int = 29
const VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO: Int = 30
const VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO: Int = 13
const VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO: Int = 36

// ── Vulkan UI state ──
struct VkUIState:
    instance: Int
    physical_device: Int
    device: Int
    graphics_queue: Int
    present_queue: Int
    surface: Int
    swapchain: Int
    render_pass: Int
    pipeline: Int
    framebuffers: [Int]
    command_pool: Int
    command_buffers: [Int]
    image_available_semaphore: Int
    render_finished_semaphore: Int
    fence: Int
    current_frame: Int
    initialized: Bool

// ── Global state ──
var g_vk_ui: VkUIState = VkUIState {
    instance: 0, physical_device: 0, device: 0,
    graphics_queue: 0, present_queue: 0,
    surface: 0, swapchain: 0,
    render_pass: 0, pipeline: 0,
    framebuffers: [], command_pool: 0, command_buffers: [],
    image_available_semaphore: 0, render_finished_semaphore: 0,
    fence: 0, current_frame: 0, initialized: false,
}


// ============================================================================
//  Initialization
// ============================================================================

pub fn vulkan_ui_init(hwnd: Int, width: Int, height: Int) -> Int:
    // Create Vulkan instance
    if vk_ui_create_instance() != VK_SUCCESS:
        return -1

    // Create surface from HWND
    if vk_ui_create_surface(hwnd) != VK_SUCCESS:
        return -2

    // Pick physical device
    if vk_ui_pick_physical_device() != VK_SUCCESS:
        return -3

    // Create logical device + queues
    if vk_ui_create_device() != VK_SUCCESS:
        return -4

    // Create swapchain
    if vk_ui_create_swapchain(width, height) != VK_SUCCESS:
        return -5

    // Create render pass
    if vk_ui_create_render_pass() != VK_SUCCESS:
        return -6

    // Create graphics pipeline
    if vk_ui_create_pipeline() != VK_SUCCESS:
        return -7

    // Create framebuffers
    if vk_ui_create_framebuffers() != VK_SUCCESS:
        return -8

    // Create command pool + buffers
    if vk_ui_create_commands() != VK_SUCCESS:
        return -9

    // Create synchronization primitives
    if vk_ui_create_sync() != VK_SUCCESS:
        return -10

    g_vk_ui.initialized = true
    return 0


// ── Instance creation ──
fn vk_ui_create_instance() -> Int:
    // Application info
    let app_name: String = "reson8"

    let app_info: ptr<Int> = alloc_zeroed(16, "Int")   // VkApplicationInfo
    mem_store(ptr_offset(app_info, 0, "Int"), VK_STRUCTURE_TYPE_APPLICATION_INFO, "Int")

    // Instance create info
    let instance_info: ptr<Int> = alloc_zeroed(16, "Int")
    mem_store(ptr_offset(instance_info, 0, "Int"), VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, "Int")
    mem_store(ptr_offset(instance_info, 2, "Int"), ptr_to_int(app_info), "Int")

    let instance_ptr: ptr<Int> = alloc_zeroed(2, "Int")
    let result = vk_vkCreateInstance(instance_info, 0, instance_ptr)

    g_vk_ui.instance = mem_load(instance_ptr, "Int")
    decay app_info
    decay instance_info
    decay instance_ptr
    return result


// ── Surface creation (Win32) ──
fn vk_ui_create_surface(hwnd: Int) -> Int:
    let surface_info: ptr<Int> = alloc_zeroed(8, "Int")
    mem_store(ptr_offset(surface_info, 0, "Int"), VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR, "Int")

    let surface_ptr: ptr<Int> = alloc_zeroed(2, "Int")
    let result = vk_vkCreateWin32SurfaceKHR(
        g_vk_ui.instance,
        surface_info,
        0,
        surface_ptr
    )

    g_vk_ui.surface = mem_load(surface_ptr, "Int")
    decay surface_info
    decay surface_ptr
    return result


// ── Physical device selection ──
fn vk_ui_pick_physical_device() -> Int:
    let count_ptr: ptr<Int> = alloc_zeroed(1, "Int")
    let _ = vk_vkEnumeratePhysicalDevices(g_vk_ui.instance, count_ptr, 0)
    let count = mem_load(count_ptr, "Int")

    if count == 0:
        decay count_ptr
        return -1

    let devices: ptr<Int> = alloc_zeroed(count, "Int")
    let _ = vk_vkEnumeratePhysicalDevices(g_vk_ui.instance, count_ptr, devices)
    g_vk_ui.physical_device = mem_load(devices, "Int")   // Pick first GPU

    decay count_ptr
    decay devices
    return VK_SUCCESS


// ── Logical device ──
fn vk_ui_create_device() -> Int:
    let queue_priority: ptr<Float> = alloc_zeroed(1, "Float")
    mem_store(queue_priority, 1.0, "Float")

    let queue_info: ptr<Int> = alloc_zeroed(8, "Int")
    mem_store(ptr_offset(queue_info, 0, "Int"), VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO, "Int")

    let device_info: ptr<Int> = alloc_zeroed(16, "Int")
    mem_store(ptr_offset(device_info, 0, "Int"), VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, "Int")

    let device_ptr: ptr<Int> = alloc_zeroed(2, "Int")
    let result = vk_vkCreateDevice(g_vk_ui.physical_device, device_info, 0, device_ptr)
    g_vk_ui.device = mem_load(device_ptr, "Int")

    // Get queues
    let queue_ptr: ptr<Int> = alloc_zeroed(2, "Int")
    vk_vkGetDeviceQueue(g_vk_ui.device, 0, 0, queue_ptr)
    g_vk_ui.graphics_queue = mem_load(queue_ptr, "Int")

    vk_vkGetDeviceQueue(g_vk_ui.device, 0, 0, queue_ptr)   // Same queue for present
    g_vk_ui.present_queue = g_vk_ui.graphics_queue

    decay queue_priority
    decay queue_info
    decay device_info
    decay device_ptr
    decay queue_ptr
    return result


// ── Swapchain ──
fn vk_ui_create_swapchain(width: Int, height: Int) -> Int:
    let swapchain_info: ptr<Int> = alloc_zeroed(32, "Int")
    mem_store(ptr_offset(swapchain_info, 0, "Int"), VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR, "Int")
    mem_store(ptr_offset(swapchain_info, 1, "Int"), ptr_to_int(g_vk_ui.surface), "Int")

    let swapchain_ptr: ptr<Int> = alloc_zeroed(2, "Int")
    let result = vk_vkCreateSwapchainKHR(g_vk_ui.device, swapchain_info, 0, swapchain_ptr)
    g_vk_ui.swapchain = mem_load(swapchain_ptr, "Int")

    decay swapchain_info
    decay swapchain_ptr
    return result


// ── Render pass ──
fn vk_ui_create_render_pass() -> Int:
    let render_pass_info: ptr<Int> = alloc_zeroed(24, "Int")
    mem_store(ptr_offset(render_pass_info, 0, "Int"), VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO, "Int")

    let render_pass_ptr: ptr<Int> = alloc_zeroed(2, "Int")
    let result = vk_vkCreateRenderPass(g_vk_ui.device, render_pass_info, 0, render_pass_ptr)
    g_vk_ui.render_pass = mem_load(render_pass_ptr, "Int")

    decay render_pass_info
    decay render_pass_ptr
    return result


// ── Graphics pipeline ──
fn vk_ui_create_pipeline() -> Int:
    // Stub — full pipeline creation requires shader modules, vertex input,
    // rasterization state, etc. This is a minimal placeholder that
    // will be filled out in Phase 2 of the glass UI roadmap.
    g_vk_ui.pipeline = 0   // Placeholder
    return VK_SUCCESS


// ── Framebuffers ──
fn vk_ui_create_framebuffers() -> Int:
    g_vk_ui.framebuffers = []
    return VK_SUCCESS


// ── Command buffers ──
fn vk_ui_create_commands() -> Int:
    // Create command pool
    let pool_info: ptr<Int> = alloc_zeroed(8, "Int")
    mem_store(ptr_offset(pool_info, 0, "Int"), VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO, "Int")

    let pool_ptr: ptr<Int> = alloc_zeroed(2, "Int")
    let _ = vk_vkCreateCommandPool(g_vk_ui.device, pool_info, 0, pool_ptr)
    g_vk_ui.command_pool = mem_load(pool_ptr, "Int")

    decay pool_info
    decay pool_ptr
    return VK_SUCCESS


// ── Synchronization ──
fn vk_ui_create_sync() -> Int:
    let sem_info: ptr<Int> = alloc_zeroed(4, "Int")
    mem_store(ptr_offset(sem_info, 0, "Int"), VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO, "Int")

    let sem_ptr: ptr<Int> = alloc_zeroed(2, "Int")
    let _ = vk_vkCreateSemaphore(g_vk_ui.device, sem_info, 0, sem_ptr)
    g_vk_ui.image_available_semaphore = mem_load(sem_ptr, "Int")

    let _ = vk_vkCreateSemaphore(g_vk_ui.device, sem_info, 0, sem_ptr)
    g_vk_ui.render_finished_semaphore = mem_load(sem_ptr, "Int")

    decay sem_info
    decay sem_ptr

    // Fence
    let fence_info: ptr<Int> = alloc_zeroed(4, "Int")
    mem_store(ptr_offset(fence_info, 0, "Int"), VK_STRUCTURE_TYPE_FENCE_CREATE_INFO, "Int")

    let fence_ptr: ptr<Int> = alloc_zeroed(2, "Int")
    let _ = vk_vkCreateFence(g_vk_ui.device, fence_info, 0, fence_ptr)
    g_vk_ui.fence = mem_load(fence_ptr, "Int")

    decay fence_info
    decay fence_ptr
    return VK_SUCCESS


// ============================================================================
//  Render Frame
// ============================================================================

pub fn vulkan_ui_begin_frame() -> Int:
    if g_vk_ui.initialized == false:
        return -1

    // Wait for previous frame
    let _ = vk_vkWaitForFences(g_vk_ui.device, 1, g_vk_ui.fence, 1, 1000000000)
    let _ = vk_vkResetFences(g_vk_ui.device, 1, g_vk_ui.fence)

    // Acquire next swapchain image
    let image_index_ptr: ptr<Int> = alloc_zeroed(1, "Int")
    let result = vk_vkAcquireNextImageKHR(
        g_vk_ui.device, g_vk_ui.swapchain,
        1000000000, g_vk_ui.image_available_semaphore,
        0, image_index_ptr
    )
    let image_index = mem_load(image_index_ptr, "Int")
    decay image_index_ptr

    if result != VK_SUCCESS:
        return result

    // Begin command buffer
    let begin_info: ptr<Int> = alloc_zeroed(8, "Int")
    mem_store(ptr_offset(begin_info, 0, "Int"), VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO, "Int")

    let cmd = 0   // command_buffers not filled yet in stub
    let _ = vk_vkBeginCommandBuffer(cmd, begin_info)
    decay begin_info

    // Begin render pass
    let render_begin: ptr<Int> = alloc_zeroed(16, "Int")
    mem_store(ptr_offset(render_begin, 0, "Int"), VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO, "Int")
    let _ = vk_vkCmdBeginRenderPass(cmd, render_begin, 0)   // VK_SUBPASS_CONTENTS_INLINE = 0

    decay render_begin
    return 0


pub fn vulkan_ui_end_frame() -> Int:
    if g_vk_ui.initialized == false:
        return -1

    let cmd = 0   // placeholder
    let _ = vk_vkCmdEndRenderPass(cmd)
    let _ = vk_vkEndCommandBuffer(cmd)

    // Submit
    let submit_info: ptr<Int> = alloc_zeroed(16, "Int")
    mem_store(ptr_offset(submit_info, 0, "Int"), VK_STRUCTURE_TYPE_SUBMIT_INFO, "Int")
    let _ = vk_vkQueueSubmit(g_vk_ui.graphics_queue, 1, submit_info, g_vk_ui.fence)
    decay submit_info

    // Present
    let present_info: ptr<Int> = alloc_zeroed(8, "Int")
    mem_store(ptr_offset(present_info, 0, "Int"), VK_STRUCTURE_TYPE_PRESENT_INFO_KHR, "Int")
    let _ = vk_vkQueuePresentKHR(g_vk_ui.present_queue, present_info)
    decay present_info

    return 0


// ============================================================================
//  Cleanup
// ============================================================================

pub fn vulkan_ui_shutdown():
    if g_vk_ui.initialized == false:
        return

    let _ = vk_vkDeviceWaitIdle(g_vk_ui.device)

    vk_vkDestroySemaphore(g_vk_ui.device, g_vk_ui.render_finished_semaphore, 0)
    vk_vkDestroySemaphore(g_vk_ui.device, g_vk_ui.image_available_semaphore, 0)
    vk_vkDestroyFence(g_vk_ui.device, g_vk_ui.fence, 0)
    vk_vkDestroyCommandPool(g_vk_ui.device, g_vk_ui.command_pool, 0)
    vk_vkDestroyRenderPass(g_vk_ui.device, g_vk_ui.render_pass, 0)
    vk_vkDestroySwapchainKHR(g_vk_ui.device, g_vk_ui.swapchain, 0)
    vk_vkDestroyDevice(g_vk_ui.device, 0)
    vk_vkDestroySurfaceKHR(g_vk_ui.instance, g_vk_ui.surface, 0)
    vk_vkDestroyInstance(g_vk_ui.instance, 0)

    g_vk_ui.initialized = false


// ============================================================================
//  Query
// ============================================================================

pub fn vulkan_ui_is_initialized() -> Bool:
    return g_vk_ui.initialized

pub fn vulkan_ui_device_name() -> String:
    return "Vulkan GPU (reson8)"
