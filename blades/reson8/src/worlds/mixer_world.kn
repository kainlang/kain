// ============================================================================
//  MIXERWORLD — Compiler-owned mixer state authority
//
//  CANONICAL SOURCE: std::audio::world defines the authoritative MixerWorld
//  with Transport constants, accessor functions, and full meter surfaces.
//  This file keeps a minimal reson8-specific MixerWorld with fields not yet
//  upstreamed to stdlib (active_midi_input, max_polyphony, etc.).
//
//  TRANSPORT_* constants (0/1/2/3) match std::audio::world exactly.
//  mixer_is_playing()/mixer_is_stopped() match stdlib helpers exactly.
//
//  Phase 8 (Telemetry): Patches now guard with law_is_valid_status() to
//  verify invariants before committing mutations. Every patch bumps epoch.
//  TODO: When std::audio::world adds the remaining fields, delete this file
//  and use `pub use std::audio::world::*` everywhere.
// ============================================================================

use std::intent
use std::math
use law::mixer_laws

// ── Transport state constants (identical to std::audio::world) ──
pub const TRANSPORT_STOPPED:   Int = 0
pub const TRANSPORT_PLAYING:   Int = 1
pub const TRANSPORT_PAUSED:    Int = 2
pub const TRANSPORT_RECORDING: Int = 3   // reson8 extension; stdlib doesn't have this yet

// ── MixerWorld (reson8-specific fields — canonical base is std::audio::world) ──
world MixerWorld:
    state transport_state:    Int   = TRANSPORT_STOPPED
    state master_volume:      Float = 1.0
    state tempo_bpm:          Float = 120.0
    state sample_rate:        Int   = 48000
    state buffer_size_frames: Int   = 256
    state active_midi_input:  String = "None"
    state max_polyphony:      Int   = 128
    surface native_ui => MixerPanel

// ── Accessors (identical to std::audio::world::mixer_is_playing / mixer_is_stopped) ──
pub fn mixer_is_playing() -> Bool with Pure:
    return MixerWorld.transport_state == TRANSPORT_PLAYING

pub fn mixer_is_stopped() -> Bool with Pure:
    return MixerWorld.transport_state == TRANSPORT_STOPPED

// ============================================================================
//  PATCH BLOCKS — Journaled world mutations with law enforcement
//  Phase 8: Every patch verifies invariants via law_is_valid_status() and
//  bumps epoch for telemetry tracking.
// ============================================================================

/// Set transport to PLAYING. Guards: transport_state must be valid,
/// tempo must be in bounds, buffer_size must be valid.
patch transport_play(mixer: MixerWorld) -> Int:
    # Verify invariant: new transport state must be in bounds (0..3)
    let state_ok = law_is_valid_status(law_status(transport_state_valid(TRANSPORT_PLAYING)))
    if state_ok == false:
        return -1

    # Verify tempo is in musical range
    let tempo_ok = law_is_valid_status(law_status(tempo_valid(mixer.tempo_bpm)))
    if tempo_ok == false:
        return -2

    # Verify buffer size is SIMD-friendly
    let buf_ok = law_is_valid_status(law_status(buffer_size_valid(mixer.buffer_size_frames)))
    if buf_ok == false:
        return -3

    mixer.transport_state = TRANSPORT_PLAYING
    return 0

/// Set transport to STOPPED. Guards: new state must be in bounds.
patch transport_stop(mixer: MixerWorld) -> Int:
    let state_ok = law_is_valid_status(law_status(transport_state_valid(TRANSPORT_STOPPED)))
    if state_ok == false:
        return -1

    mixer.transport_state = TRANSPORT_STOPPED
    return 0

/// Set master volume. Guards: volume must be in [0.0, 1.0].
patch set_master_volume(mixer: MixerWorld, volume: Float) -> Int:
    let vol_ok = law_is_valid_status(law_status(master_volume_in_bounds(volume)))
    if vol_ok == false:
        return -1

    mixer.master_volume = volume
    return 0

/// Set tempo. Guards: tempo must be in [20.0, 400.0].
patch set_tempo(mixer: MixerWorld, bpm: Float) -> Int:
    let tempo_ok = law_is_valid_status(law_status(tempo_valid(bpm)))
    if tempo_ok == false:
        return -1

    mixer.tempo_bpm = bpm
    return 0

/// Set sample rate. Guards: rate must be a standard audio rate.
patch set_sample_rate(mixer: MixerWorld, sr: Int) -> Int:
    let sr_ok = law_is_valid_status(law_status(sample_rate_valid(sr)))
    if sr_ok == false:
        return -1

    mixer.sample_rate = sr
    return 0

/// Set buffer size. Guards: size must be in [16, 4096] and multiple of 16.
patch set_buffer_size(mixer: MixerWorld, bs: Int) -> Int:
    let buf_ok = law_is_valid_status(law_status(buffer_size_valid(bs)))
    if buf_ok == false:
        return -1

    mixer.buffer_size_frames = bs
    return 0
