// ============================================================================
//  PROJECTWORLD + PROJECTMIRROR — Compiler-owned project metadata
//  NOTE: Full project spec (~25 fields) at project_world_full.kn.
//        Only currently-referenced fields are here. Re-expand for STREAM3/4.
// ============================================================================

world ProjectWorld:
    state is_new:                Bool  = true
    state default_tempo_bpm:     Float = 120.0
    state project_path:          String = ""
    state dirty:                 Bool  = false
    surface native_ui => StatusBar
    surface web      => AppStatusBar

// ── ProjectMirror — mirror for UI observation ──
world ProjectMirror:
    state dirty_copy:            Bool  = false
    state project_path_copy:     String = ""
    surface native_ui => StatusBar
    surface web      => AppStatusBar

// ── Entangle: mirror project dirty/name state for UI ──
entangle ProjectWorld.dirty        <-> ProjectMirror.dirty_copy        with single_writer
entangle ProjectWorld.project_path <-> ProjectMirror.project_path_copy with single_writer

pub fn project_is_new() -> Bool with Pure:
    return ProjectWorld.is_new
