// ============================================================================
//  PLUGINWORLD + PLUGINREGISTRY + PLUGINMIRROR — Compiler-owned plugin state
//  NOTE: Full plugin spec (~10 structs + 20 fields) at plugin_world_full.kn.
//        Only currently-referenced fields are here. Re-expand for STREAM4.
// ============================================================================

// ============================================================================
//  PLUGINWORLD — Active plugin state
// ============================================================================

world PluginWorld:
    state max_crash_recovery: Int = 3
    state active_plugin_count: Int = 0
    state crash_count: Int = 0
    state last_crash_timestamp_ms: Int = 0
    surface native_ui => PluginManagerPanel
    surface web      => PluginManagerPanel

// ============================================================================
//  PLUGINMIRROR — Read-only mirror for UI observation
// ============================================================================

world PluginMirror:
    state crash_count_copy: Int = 0
    state active_plugin_count_copy: Int = 0
    surface native_ui => PluginBrowser
    surface web      => PluginBrowser

// ── Entangle: mirror crash/plugin state for UI consumption ──
entangle PluginWorld.crash_count       <-> PluginMirror.crash_count_copy       with single_writer
entangle PluginWorld.active_plugin_count <-> PluginMirror.active_plugin_count_copy with single_writer

// ============================================================================
//  PLUGINREGISTRY — Separate world for scan database
// ============================================================================

world PluginRegistry:
    state scan_complete: Bool = false
    state scan_paths:    [String] = []
    surface native_ui => PluginBrowser
    surface web      => PluginBrowser

// ============================================================================
//  PATCH BLOCKS
// ============================================================================

patch mark_scan_complete(registry: PluginRegistry) -> Int:
    registry.scan_complete = true
    return 0

patch record_crash(world: PluginWorld) -> Int:
    world.crash_count = world.crash_count + 1
    world.last_crash_timestamp_ms = 0
    if world.crash_count > world.max_crash_recovery:
        world.crash_count = 0
    return world.crash_count
