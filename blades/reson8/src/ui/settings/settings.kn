        <LabeledSetting label="Render Mode">
            <Dropdown value={MixerWorld.render_mode}
                      options={["Standard", "Offline (High Quality)", "Low Latency"]}
                      on_change={set_render_mode} />
        </LabeledSetting>

        <LabeledSetting label="Max Polyphony">
            <Slider value={MixerWorld.max_polyphony}
                    min={1} max={512} step={1}
                    on_change={set_max_polyphony} />
        </LabeledSetting>

        <Separator />

        <LabeledSetting label="Logging Level">
            <Dropdown value={ProjectWorld.log_level}
                      options={["Error", "Warning", "Info", "Debug", "Trace"]}
                      on_change={set_log_level} />
        </LabeledSetting>

        <LabeledSetting label="Crash Reports">
            <Checkbox checked={ProjectWorld.crash_reports_enabled}
                      on_change={set_crash_reports} />
        </LabeledSetting>

        <LabeledSetting label="Telemetry">
            <Checkbox checked={ProjectWorld.telemetry_enabled}
                      on_change={set_telemetry} />
            <text value="Send anonymous usage data to help improve reson8"
                  font_size={ThemeWorld.font_size_sm}
                  color={ThemeWorld.color_text_muted} />
        </LabeledSetting>

        <Separator />

        <LabeledSetting label="Experimental Features">
            <Checkbox checked={ProjectWorld.experimental_enabled}
                      on_change={set_experimental} />
        </LabeledSetting>

        <LabeledSetting label="Python Interop">
            <Checkbox checked={ProjectWorld.python_interop_enabled}
                      on_change={set_python_interop} />
            <text value="Enable Python-backed plugins (requires Python 3.10+)"
                  font_size={ThemeWorld.font_size_sm}
                  color={ThemeWorld.color_text_muted} />
        </LabeledSetting>

        <Separator />

        <LabeledSetting label="Reset All Settings">
            <Button label="Reset to Factory Defaults" kind="danger"
                    on_click={reset_all_settings} />
        </LabeledSetting>
    </stack>


// ============================================================================
//  Shared primitives used by settings panels
// ============================================================================

component SectionHeader(title: String, description: String):
    render <stack direction="vertical" spacing={ThemeWorld.spacing_xs}>
        <text value={title}
              font_size={ThemeWorld.font_size_xl}
              font_weight={ThemeWorld.font_weight_bold}
              color={ThemeWorld.color_text_primary} />
        if description != "":
            <text value={description}
                  font_size={ThemeWorld.font_size_sm}
                  color={ThemeWorld.color_text_secondary} />
    </stack>

component LabeledSetting(label: String, children: component):
    render <stack direction="horizontal" spacing={ThemeWorld.spacing_md} align="center">
        <text value={label}
              font_size={ThemeWorld.font_size_base}
              color={ThemeWorld.color_text_primary}
              width={200.0} />
        <box fill={true}>
            {children}
        </box>
    </stack>

component Separator():
    render <box height={1.0} color={ThemeWorld.color_border_subtle}
               margin={ThemeWorld.spacing_sm} />

component CategoryTab(label: String, category: String, active: String):
    state is_hovered: Bool = false

    fn bg(_self: Self_) -> Color with Pure:
        if active == category:
            return ThemeWorld.color_accent
        if _self.is_hovered:
            return ThemeWorld.color_surface_raised
        return ThemeWorld.color_bg_secondary

    fn text_c(_self: Self_) -> Color with Pure:
        if active == category:
            return ThemeWorld.color_text_inverse
        return ThemeWorld.color_text_primary

    render <box color={bg()} padding={ThemeWorld.spacing_md}
               radius={ThemeWorld.radius_md}
               accessible_role="tab"
               accessible_label={label}
               on_click={set_category(category)}
               on_mouse_enter={set_hovered(true)}
               on_mouse_leave={set_hovered(false)}>
        <text value={label}
              font_size={ThemeWorld.font_size_base}
              color={text_c()} />
    </box>

component KeybindingRow(action: ActionDef, selected: Bool,
                         on_select: fn(Int), on_record: fn(Int),
                         on_clear: fn(Int)):
    render <box direction="horizontal" padding={ThemeWorld.spacing_sm}
               color={if selected: ThemeWorld.color_selection else: ThemeWorld.color_bg_primary}
               radius={ThemeWorld.radius_sm}
               on_click={on_select(action.id)}>
        <text value={action.name} width={200.0} font_size={ThemeWorld.font_size_sm} />
        <text value={action.category} width={120.0} font_size={ThemeWorld.font_size_sm}
              color={ThemeWorld.color_text_muted} />
        <text value={format_keybinding(action.id)} font_size={ThemeWorld.font_size_sm}
              font_family={ThemeWorld.font_family_mono} />
        <spacer fill={true} />
        <Button label="Record" kind="ghost" size="sm" on_click={on_record(action.id)} />
        <Button label="Clear" kind="ghost" size="sm" on_click={on_clear(action.id)} />
    </box>

component PathListEditor(paths: [String], on_add: fn(String), on_remove: fn(String)):
    render <stack direction="vertical" spacing={ThemeWorld.spacing_xs}>
        for path in paths:
            <box direction="horizontal" padding={ThemeWorld.spacing_xs}>
                <text value={path} font_size={ThemeWorld.font_size_sm}
                      font_family={ThemeWorld.font_family_mono} />
                <spacer fill={true} />
                <Button label="✕" kind="ghost" size="sm" on_click={on_remove(path)} />
            </box>
    </stack>
