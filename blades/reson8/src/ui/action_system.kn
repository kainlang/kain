// action_system.kn -- REAPER-inspired action registry and keybinding system
// Every reson8 operation is a named action with keybinding and MIDI mapping support

use std::math
use types::ActionDef
use worlds::mixer_world
use types::KeyBinding
use types::MIDIMapping
use types::Color

