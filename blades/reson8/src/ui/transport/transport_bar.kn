// transport/transport_bar.kn — Full transport bar assembly
// Contains: TransportControls, TimeDisplay, BPMDisplay, TimeSigDisplay, CPUUsage, AudioDeviceInfo
// Wired to MixerWorld/MixerMirror for reactive transport state.

use std::math
use types::Color

component TransportBar():
 state is_playing: Bool = false
 state is_recording: Bool = false
 state is_looping: Bool = false

 fn bg(_self: Self_) -> Color:
 return ThemeWorld.color_bg_secondary

 fn height_px(_self: Self_) -> Float:
 return ThemeWorld.transport_height

 // Transport control patches — delegate to world patches via action system
 fn transport_play() -> Int:
 transport_play(MixerWorld)
 return 0

 fn transport_stop() -> Int:
 transport_stop(MixerWorld)
 return 0

 fn transport_pause() -> Int:
 MixerWorld.transport_state = TRANSPORT_PAUSED
 return 0

 fn transport_record() -> Int:
 MixerWorld.transport_state = TRANSPORT_RECORDING
 return 0

 fn transport_loop_toggle() -> Int:
 // Toggle loop state
 if MixerWorld.loop_end > MixerWorld.loop_start:
 MixerWorld.loop_start = 0
 MixerWorld.loop_end = 0
 else:
 MixerWorld.loop_start = 0
 MixerWorld.loop_end = MixerWorld.buffer_size_frames * 32
 return 0

 render <box
 height={height_px}
 background={bg}
 padding_horizontal={ThemeWorld.spacing_md}
 padding_vertical={ThemeWorld.spacing_sm}
 direction="horizontal"
 align="center"
 gap={ThemeWorld.spacing_md}
 accessible_role="toolbar"
 accessible_label="Transport"
 >
 {/* Transport controls: Stop, Play, Pause, Record, Loop */}
 <TransportControls is_playing={is_playing} is_recording={is_recording} is_looping={is_looping} on_play={transport_play} on_stop={transport_stop} on_pause={transport_pause} on_record={transport_record} on_loop_toggle={transport_loop_toggle} />

 {/* Separator */}
 <box width={1.0} height={24.0} background={ThemeWorld.color_border_subtle} />

 {/* Time display */}
 <TimeDisplay position_frames={MixerWorld.transport_position} display_mode={"bars"} />

 {/* Separator */}
 <box width={1.0} height={24.0} background={ThemeWorld.color_border_subtle} />

 {/* BPM display */}
 <BPMDisplay tempo={MixerWorld.tempo_bpm} />

 {/* Separator */}
 <box width={1.0} height={24.0} background={ThemeWorld.color_border_subtle} />

 {/* Time signature — stub: 4/4 always */}
 <TimeSigDisplay num={4} den={4} />

 {/* Separator */}
 <box width={1.0} height={24.0} background={ThemeWorld.color_border_subtle} />

 {/* CPU usage meter */}
 <CPUUsage value={MixerWorld.cpu_load} />

 {/* Spacer pushes right-aligned content to end */}
 <box flex_grow={1.0} />

 {/* Audio device info — right aligned */}
 <box direction="horizontal" align="center" gap={ThemeWorld.spacing_sm}>
 <text value={str(MixerWorld.sample_rate) + " Hz"} font_size={ThemeWorld.font_size_xs} color={ThemeWorld.color_text_muted} />
 <text value={str(MixerWorld.buffer_size_frames) + " smp"} font_size={ThemeWorld.font_size_xs} color={ThemeWorld.color_text_muted} />
 </box>
 </box>
