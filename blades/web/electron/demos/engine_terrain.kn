// ============================================================================
//  engine_terrain.kn — Procedural Terrain w/ Visual Extras + Interaction
// ============================================================================
//
//  WHAT:        50×50 vertex grid (~2,500 verts, ~4,800 triangles) with
//               multi-octave sin/cos height generation. Enhanced with:
//               — Orbiting point lights for dynamic shadows
//               — Atmospheric fog with toggle (F key)
//               — Sky background color
//               — Ambient light control
//               — Auto-rotate camera for cinematic orbit
//               — Keyboard 1/2/3 to change terrain frequency/amplitude
//               — Click to warp terrain (deform the height map)
//
//  COMPILE:     cd X:/blades/web/electron
//               kain build demos/engine_terrain.kn --target llvm
//               → produces engine_terrain.exe in .kain/out/
//
//  RUN:         engine_terrain.exe
//               → Live 3D terrain rendered via Electron child_process pipe.
//                 Pulse fires every 60ms (~17fps for 2500 verts).
//
//  CONTROLS:    1 = normal terrain     2 = high frequency
//               3 = low frequency      F = toggle fog
//               Click = warp terrain at click position
//
//  SEMANTIC LAYER USAGE:
//    L5 — pulse (every 60ms)
//    L1 — world (state authority + params)
//    L0 — fn, let, var, while, use (plain code)
//
//  EXTRAS USED:
//    — create_light / update_light_position: orbiting point lights
//    — set_background: sky color backdrop
//    — set_fog: atmospheric depth (toggleable)
//    — set_ambient: overall scene brightness
//
//  INTERACTION:
//    — Press 1/2/3: terrain frequency mode
//    — Press F: toggle fog on/off
//    — Click: warp terrain (gaussian bump at click position)
//
//  BASED ON:    blackhole.kn (inline JSON pattern, pulse timing)
//               engine_terrain.kn (original — custom mesh grid)
//               electron_bridge.kn (render protocol)
//               electron_extras.kn (visual effects)
//               electron_interact.kn (keyboard + click input)
// ============================================================================

use std::runtime
use std::math
use std::time
use electron_bridge
use electron_extras
use electron_interact

// ============================================================================
//  CONSTANTS
// ============================================================================

const GRID:   Int   = 50
const COLS:   Int   = GRID
const ROWS:   Int   = GRID
const SIZE:   Float = 10.0
const SPACING: Float = SIZE / GRID             // 0.2 units between verts

// ============================================================================
//  LAYER 1: STATE AUTHORITY — world (terrain params + warp state)
// ============================================================================

world TerrainState:
    state ready:        Int   = 0
    state freq_mode:    Int   = 0              // 0=normal, 1=high, 2=low
    state fog_on:       Bool  = true
    state prev_fog:     Bool  = true           // track fog toggles
    state warp_x:       Float = 0.0            // click-warp center X
    state warp_z:       Float = 0.0            // click-warp center Z
    state warp_strength: Float = 0.0           // decays over time

// ============================================================================
//  LAYER 5: TEMPORAL — pulse (60ms, updates all 2,500 terrain verts)
// ============================================================================
// WHY: pulse = compiler-owned timed recurrence. At 60ms, we update ~2,500
//      vertex positions per frame. The inline JSON string building avoids
//      allocator overhead on the hot path.

pulse terrain_clock every 60 ms:
    if TerrainState.ready == 0:
        return

    // ── INTERACTION: poll stdin for keyboard + click events ────────────
    interact_poll()

    // ── FREQUENCY MODE: number keys change frequency/amplitude ──────────
    if key_just_pressed("1"):
        TerrainState.freq_mode = 0
    elif key_just_pressed("2"):
        TerrainState.freq_mode = 1
    elif key_just_pressed("3"):
        TerrainState.freq_mode = 2

    // ── FOG TOGGLE: F key ──────────────────────────────────────────────
    if key_just_pressed("f"):
        TerrainState.fog_on = TerrainState.fog_on == false

    // ── CLICK WARP: deform terrain at click position ────────────────────
    var ci: Int = 0
    while ci < click_count():
        let cx: Float = click_x(ci)
        let cy: Float = click_y(ci)
        // Map screen coords (~0-800, 0-600) to world coords (-6 to +6)
        TerrainState.warp_x = (cx - 400.0) * 0.015
        TerrainState.warp_z = (cy - 300.0) * 0.015
        TerrainState.warp_strength = 3.0           // strong initial bump
        ci = ci + 1

    // Decay warp strength each frame
    if TerrainState.warp_strength > 0.01:
        TerrainState.warp_strength = TerrainState.warp_strength * 0.85

    let t: Float = (pulse_tick * 0.15)             // continuous time

    // ── FREQUENCY MULTIPLIERS ──────────────────────────────────────────
    let fm: Float = 1.0
    let fa: Float = 1.0
    if TerrainState.freq_mode == 1:
        fm = 2.2                                  // high frequency
        fa = 0.45                                  // reduced amplitude
    elif TerrainState.freq_mode == 2:
        fm = 0.45                                  // low frequency
        fa = 1.8                                   // increased amplitude

    // ── WARP PARAMS ─────────────────────────────────────────────────────
    let wx: Float = TerrainState.warp_x
    let wz: Float = TerrainState.warp_z
    let ws: Float = TerrainState.warp_strength

    // ── BUILD FLAT VERTEX ARRAY ────────────────────────────────────────
    // Inline string building: no json_object overhead for 2,500 verts
    var json: String = "{\"cmd\":\"update\",\"id\":\"terrain\",\"type\":\"custom_mesh\",\"verts\":["
    var row: Int = 0
    var first: Int = 1
    while row < ROWS:
        var col: Int = 0
        while col < COLS:
            let fx: Float = (col - COLS / 2) * SPACING
            let fz: Float = (row - ROWS / 2) * SPACING
            let dist: Float = sqrt(fx * fx + fz * fz)

            // Multi-octave terrain — frequency/amplitude modulated by mode
            let oct1: Float = sin(fx * 0.6 * fm + t) * cos(fz * 0.5 * fm + t * 0.7) * 2.0 * fa
            let oct2: Float = sin(fx * 1.3 * fm - t * 0.5) * sin(fz * 1.1 * fm + t * 0.4) * 1.0 * fa
            let oct3: Float = cos(dist * 0.5 * fm + t * 0.3) * 0.5 * fa
            var y: Float = oct1 + oct2 + oct3

            // Click-warp deformation: rational bump (approximates gaussian)
            // Uses 1/(1 + r²) falloff — cheap, no exp() needed
            if ws > 0.01:
                let dx: Float = fx - wx
                let dz: Float = fz - wz
                let bump: Float = ws / (1.0 + (dx * dx + dz * dz) * 1.5)
                y = y + bump

            if first == 0:
                json = json + ","
            first = 0
            json = json + str(fx)
            json = json + ","
            json = json + str(y)
            json = json + ","
            json = json + str(fz)
            col = col + 1
        row = row + 1
    json = json + "]}"
    println(json)

    // ── FOG UPDATE: apply or clear based on toggle state ───────────────
    if TerrainState.fog_on != TerrainState.prev_fog:
        TerrainState.prev_fog = TerrainState.fog_on
        if TerrainState.fog_on:
            set_fog("#8899aa", 4.0, 30.0)         // visible fog
        else:
            set_fog("#8899aa", 999.0, 1000.0)     // effectively off

    // ── ORBITING LIGHTS: two point lights circling the terrain ─────────
    let l1_angle: Float = t * 0.60
    let l2_angle: Float = t * -0.45 + 1.2
    let l3_angle: Float = t * 0.35 + 2.5
    update_light_position("light_sun", cos(l1_angle) * 7.0, 4.0 + sin(l1_angle * 1.3) * 2.0, sin(l1_angle) * 7.0)
    update_light_position("light_fill", cos(l2_angle) * 5.0, 1.5 + sin(l2_angle * 0.8) * 1.5, sin(l2_angle) * 5.0)
    update_light_position("light_rim", cos(l3_angle) * 3.5, 2.5, sin(l3_angle) * 3.5)

    // ── TELEMETRY ──────────────────────────────────────────────────────
    telemetry("tick", pulse_tick)
    let mode_label: String = if TerrainState.freq_mode == 1:
        "high-freq"
    elif TerrainState.freq_mode == 2:
        "low-freq"
    else:
        "normal"
    telemetry_string("freq_mode", mode_label)
    let fog_label: String = if TerrainState.fog_on: "ON" else: "OFF"
    telemetry_string("fog", fog_label)
    telemetry_float("warp", TerrainState.warp_strength)

    // ── Clear per-frame interaction state ──────────────────────────────
    interact_clear()

// ============================================================================
//  MAIN — one-time mesh creation, then pulse animates
// ============================================================================

fn main() -> Int with IO:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    // ── ATMOSPHERE ─────────────────────────────────────────────────────
    set_background("#334466")                     // sky blue backdrop
    set_fog("#8899aa", 4.0, 30.0)                // atmospheric depth
    set_ambient("#405060", 0.5)                   // overall fill light

    // ── CAMERA ─────────────────────────────────────────────────────────
    camera_look_at(8.0, 5.0, 10.0, 0.0, 0.0, 0.0)

    // ── BUILD INITIAL VERTEX ARRAY ──────────────────────────────────────
    var vert_json: String = "["
    var row: Int = 0
    var first_vert: Int = 1
    while row < ROWS:
        var col: Int = 0
        while col < COLS:
            let fx: Float = (col - COLS / 2) * SPACING
            let fz: Float = (row - ROWS / 2) * SPACING
            let dist: Float = sqrt(fx * fx + fz * fz)
            let oct1: Float = sin(fx * 0.6) * cos(fz * 0.5) * 2.0
            let oct2: Float = sin(fx * 1.3) * sin(fz * 1.1) * 1.0
            let oct3: Float = cos(dist * 0.5) * 0.5
            let y: Float = oct1 + oct2 + oct3

            if first_vert == 0:
                vert_json = vert_json + ","
            first_vert = 0
            vert_json = vert_json + str(fx)
            vert_json = vert_json + ","
            vert_json = vert_json + str(y)
            vert_json = vert_json + ","
            vert_json = vert_json + str(fz)
            col = col + 1
        row = row + 1
    vert_json = vert_json + "]"

    // ── BUILD INDEX ARRAY ───────────────────────────────────────────────
    // Two triangles per grid cell: (tl,bl,tr) and (tr,bl,br)
    var idx_json: String = "["
    var first_idx: Int = 1
    row = 0
    while row < ROWS - 1:
        var col: Int = 0
        while col < COLS - 1:
            let tl: Int = row * COLS + col
            let tr: Int = tl + 1
            let bl: Int = (row + 1) * COLS + col
            let br: Int = bl + 1

            if first_idx == 0:
                idx_json = idx_json + ","
            first_idx = 0
            idx_json = idx_json + str(tl) + "," + str(bl) + "," + str(tr)
            idx_json = idx_json + ","
            idx_json = idx_json + str(tr) + "," + str(bl) + "," + str(br)
            col = col + 1
        row = row + 1
    idx_json = idx_json + "]"

    // ── CREATE CUSTOM MESH — inline JSON, one-shot create command ──────
    println("{\"cmd\":\"create\",\"id\":\"terrain\",\"type\":\"custom_mesh\",\"verts\":" + vert_json + ",\"indices\":" + idx_json + ",\"color\":\"#448866\"}")

    // ── ORBITING POINT LIGHTS — dynamic moving shadows ─────────────────
    create_light("light_sun",  "point", "#ffcc88", 4.0, 7.0, 4.0, 0.0)
    create_light("light_fill", "point", "#4488cc", 2.0, 0.0, 1.5, 5.0)
    create_light("light_rim",  "point", "#cc8844", 2.5, -3.5, 2.5, 0.0)

    // ── HUD TELEMETRY — initial values ──────────────────────────────────
    telemetry_string("status", "PROCEDURAL TERRAIN + EXTRAS")
    telemetry("verts", ROWS * COLS)
    telemetry_string("controls", "1=norm 2=high 3=low F=fog CLICK=warp")

    // ── READY — pulse is now allowed to fire ────────────────────────────
    TerrainState.ready = 1

    // ── KEEP-ALIVE — indefinite loop, pulse drives all animation ────────
    var tick: Int = 0
    while tick < 999999:
        let _ = sleep_millis(1000)
        tick = tick + 1

    let sd = runtime_shutdown()
    if sd != 0:
        return 200 + sd
    return 0

// ============================================================================
//  END engine_terrain.kn
// ============================================================================
