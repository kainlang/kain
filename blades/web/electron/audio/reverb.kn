// ============================================================================
//  reverb.kn — Schroeder Reverberator (stdin/stdout WAV Processor)
// ============================================================================
//  PROTOCOL:
//    stdin:  {"command":"process","samples":[0.1,-0.05,...],"sr":44100,"params":{...}}
//            {"command":"process","wavPath":"C:/file.wav","params":{...}}
//    stdout: {"status":"ok","samples":[0.1,-0.05,0.2,...],"sr":44100,"count":22050}
// ============================================================================

use std::runtime
use std::json
use std::fs
use std::ascii

// ═══════════════════════════════════════════════════════════════════════════════
//  Hex → integer parsing
// ═══════════════════════════════════════════════════════════════════════════════

fn hex_val(hex: String, pos: Int) -> Int:
    return ascii_hex_value_byte(text_ord(text_substring_string(hex, pos, 1)))

fn hex_pair(hex: String, pos: Int) -> Int:
    return (hex_val(hex, pos) << 4) | hex_val(hex, pos + 1)

fn hex_u16(hex: String, byte_off: Int) -> Int:
    let h = byte_off * 2
    return hex_pair(hex, h) | (hex_pair(hex, h + 2) << 8)

fn hex_u32(hex: String, byte_off: Int) -> Int:
    let h = byte_off * 2
    return hex_pair(hex, h) | (hex_pair(hex, h + 2) << 8) | (hex_pair(hex, h + 4) << 16) | (hex_pair(hex, h + 6) << 24)

fn hex_s16(hex: String, byte_off: Int) -> Int:
    let raw = hex_u16(hex, byte_off)
    if raw >= 32768: return raw - 65536
    return raw

// ═══════════════════════════════════════════════════════════════════════════════
//  WAV parsing
// ═══════════════════════════════════════════════════════════════════════════════

struct WavInfo:
    sample_rate: Int
    num_samples: Int
    data_start: Int
    channels: Int

fn wav_info(hex: String) -> WavInfo:
    let fmt_size: Int = hex_u32(hex, 16)
    let channels: Int = hex_u16(hex, 22)
    let sample_rate: Int = hex_u32(hex, 24)
    let bits_per_sample: Int = hex_u16(hex, 34)
    var data_off: Int = 12 + 8 + fmt_size
    if data_off % 2 != 0: data_off = data_off + 1
    let data_size: Int = hex_u32(hex, data_off + 4)
    data_off = data_off + 8
    let bytes_per: Int = bits_per_sample / 8
    let frames: Int = data_size / (bytes_per * channels)
    return WavInfo { sample_rate: sample_rate, num_samples: frames, data_start: data_off, channels: channels }

// ═══════════════════════════════════════════════════════════════════════════════
//  Ring buffer and reverb core (structs only — no process functions)
// ═══════════════════════════════════════════════════════════════════════════════

struct RingBuf:
    data: ptr<Float>
    capacity: Int
    write_idx: Int

fn ring_new(cap: Int) -> RingBuf with Unsafe:
    if cap < 1:
        let d: ptr<Float> = alloc_zeroed(1, "Float")
        return RingBuf { data: d, capacity: 1, write_idx: 0 }
    let d: ptr<Float> = alloc_zeroed(cap, "Float")
    return RingBuf { data: d, capacity: cap, write_idx: 0 }

fn ring_read(rb: RingBuf) -> Float with Unsafe:
    return mem_load(ptr_offset(rb.data, rb.write_idx, "Float"), "Float")

fn ring_write(rb: RingBuf, val: Float) -> RingBuf with Unsafe:
    mem_store(ptr_offset(rb.data, rb.write_idx, "Float"), val, "Float")
    var next: Int = rb.write_idx + 1
    if next >= rb.capacity: next = 0
    return RingBuf { data: rb.data, capacity: rb.capacity, write_idx: next }

fn ring_free(rb: RingBuf) -> Int with Unsafe:
    decay rb.data
    return 0

// ═══════════════════════════════════════════════════════════════════════════════
//  MAIN
// ═══════════════════════════════════════════════════════════════════════════════

pub fn main() -> Int with IO, Unsafe:
    let init: Int = runtime_init()
    if init != 0:
        let e = json_object()
        json_object_set_string(e, "status", "error")
        json_object_set_string(e, "error", "runtime_init failed")
        println(json_stringify(e))
        return 100 + init

    let raw: String = read_line()
    if raw == "":
        let e = json_object()
        json_object_set_string(e, "status", "error")
        json_object_set_string(e, "error", "no input")
        println(json_stringify(e))
        runtime_shutdown()
        return 1

    let cmd: JsonValue = json_parse_text(raw)
    if json_is_object(cmd) == false:
        let e = json_object()
        json_object_set_string(e, "status", "error")
        json_object_set_string(e, "error", "invalid JSON")
        println(json_stringify(e))
        runtime_shutdown()
        return 1

    let cmd_obj: JsonObject = cmd
    let cmd_str: String = json_string_or(cmd_obj, "command", "")
    if cmd_str != "process":
        let e = json_object()
        json_object_set_string(e, "status", "error")
        json_object_set_string(e, "error", "unknown command")
        println(json_stringify(e))
        runtime_shutdown()
        return 1

    // ── Try inline samples first (no file I/O) ───────────────────────────
    let samples_arr_result: JsonArrayResult = json_array_field(cmd_obj, "samples")
    if samples_arr_result.ok:
        let samples_json: JsonArray = samples_arr_result.value
        let arr_len: Int = json_array_length(samples_json)
        if arr_len > 0:
            let in_sr: Int = json_int_or(cmd_obj, "sr", 44100)
            let in_ch: Int = json_int_or(cmd_obj, "channels", 1)
            let in_buf: ptr<Float> = alloc_zeroed(arr_len, "Float")
            defer decay in_buf
            var fi: Int = 0
            while fi < arr_len:
                let val: JsonValue = json_array_value_at(samples_json, fi)
                let fval: Float = json_any_to_float(val)
                mem_store(ptr_offset(in_buf, fi, "Float"), fval, "Float")
                fi = fi + 1

            // ── Parse params ───────────────────────────────────────────
            let pr: JsonObjectResult = json_object_field(cmd_obj, "params")
            let params: JsonObject = json_object()
            if pr.ok: params = pr.value
            let decay_val: Float = json_float_or(params, "decay", 0.84)
            let mix_val: Float = json_float_or(params, "mix", 0.5)

            // ── Apply reverb (inlined) ─────────────────────────────────
            if arr_len > 0 and decay_val >= 0.0 and decay_val <= 1.0 and mix_val >= 0.0 and mix_val <= 1.0:
                let sr_f: Float = Float(in_sr)
                let scale: Float = sr_f / 25000.0
                let d_a: Int = Int(901.0 * scale)
                let d_b: Int = Int(778.0 * scale)
                let d_c: Int = Int(1182.0 * scale)
                let d_d: Int = Int(1392.0 * scale)
                let d_ap1: Int = Int(480.0 * scale)
                let d_ap2: Int = Int(161.0 * scale)
                // force min size
                var m_a: Int = d_a
                if m_a < 1: m_a = 1
                var m_b: Int = d_b
                if m_b < 1: m_b = 1
                var m_c: Int = d_c
                if m_c < 1: m_c = 1
                var m_d: Int = d_d
                if m_d < 1: m_d = 1
                var m_ap1: Int = d_ap1
                if m_ap1 < 1: m_ap1 = 1
                var m_ap2: Int = d_ap2
                if m_ap2 < 1: m_ap2 = 1

                let comb_a: RingBuf = ring_new(m_a)
                let comb_b: RingBuf = ring_new(m_b)
                let comb_c: RingBuf = ring_new(m_c)
                let comb_d: RingBuf = ring_new(m_d)
                let ap_a: RingBuf = ring_new(m_ap1)
                let ap_b: RingBuf = ring_new(m_ap2)
                let ap_g: Float = 0.7
                let comb_g: Float = decay_val
                var cs_a: RingBuf = comb_a
                var cs_b: RingBuf = comb_b
                var cs_c: RingBuf = comb_c
                var cs_d: RingBuf = comb_d
                var as_a: RingBuf = ap_a
                var as_b: RingBuf = ap_b
                var pi: Int = 0
                while pi < arr_len:
                    let input: Float = mem_load(ptr_offset(in_buf, pi, "Float"), "Float")
                    let ca_d: Float = ring_read(cs_a)
                    let cb_d: Float = ring_read(cs_b)
                    let cc_d: Float = ring_read(cs_c)
                    let cd_d: Float = ring_read(cs_d)
                    cs_a = ring_write(cs_a, input + (ca_d * comb_g))
                    cs_b = ring_write(cs_b, input + (cb_d * comb_g))
                    cs_c = ring_write(cs_c, input + (cc_d * comb_g))
                    cs_d = ring_write(cs_d, input + (cd_d * comb_g))
                    let comb_sum: Float = (ca_d + cb_d + cc_d + cd_d) * 0.25
                    let ap1_d: Float = ring_read(as_a)
                    let ap1_y: Float = (0.0 - ap_g) * comb_sum + ap1_d
                    as_a = ring_write(as_a, comb_sum + (ap_g * ap1_y))
                    let ap2_d: Float = ring_read(as_b)
                    let ap2_y: Float = (0.0 - ap_g) * ap1_y + ap2_d
                    as_b = ring_write(as_b, ap1_y + (ap_g * ap2_y))
                    let output: Float = (input * (1.0 - mix_val)) + (ap2_y * mix_val)
                    mem_store(ptr_offset(in_buf, pi, "Float"), output, "Float")
                    pi = pi + 1
                ring_free(comb_a)
                ring_free(comb_b)
                ring_free(comb_c)
                ring_free(comb_d)
                ring_free(ap_a)
                ring_free(ap_b)

            // ── Build output JSON ──────────────────────────────────────
            let out_arr: JsonArray = json_array()
            var oi: Int = 0
            while oi < arr_len:
                let sv: Float = mem_load(ptr_offset(in_buf, oi, "Float"), "Float")
                json_array_push_float(out_arr, sv)
                oi = oi + 1
            let res: JsonObject = json_object()
            json_object_set_string(res, "status", "ok")
            json_object_set_array(res, "samples", out_arr)
            json_object_set_int(res, "sr", in_sr)
            json_object_set_int(res, "count", arr_len)
            println(json_stringify(res))
            runtime_shutdown()
            return 0

    // ── Fall back to WAV file ───────────────────────────────────────────
    let wav_path: String = json_string_or(cmd_obj, "wavPath", "")
    if wav_path == "":
        let e = json_object()
        json_object_set_string(e, "status", "error")
        json_object_set_string(e, "error", "no wavPath or samples")
        println(json_stringify(e))
        runtime_shutdown()
        return 1

    let file_hex: String = fs_read_bytes_hex(wav_path)
    if file_hex == "":
        let e = json_object()
        json_object_set_string(e, "status", "error")
        json_object_set_string(e, "error", "cannot read: " + wav_path)
        println(json_stringify(e))
        runtime_shutdown()
        return 1

    let info: WavInfo = wav_info(file_hex)
    if info.sample_rate <= 0 or info.num_samples <= 0:
        let e = json_object()
        json_object_set_string(e, "status", "error")
        json_object_set_string(e, "error", "bad WAV header")
        println(json_stringify(e))
        runtime_shutdown()
        return 1

    // ── Convert WAV hex to Float buffer (inlined) ────────────────────────
    let buf: ptr<Float> = alloc_zeroed(info.num_samples, "Float")
    defer decay buf
    let bps: Int = 2
    let frame_bytes: Int = bps * info.channels
    let ch_f: Float = Float(info.channels)
    var wi: Int = 0
    while wi < info.num_samples:
        var sum: Float = 0.0
        var wc: Int = 0
        while wc < info.channels:
            let off: Int = info.data_start + wi * frame_bytes + wc * bps
            let s: Int = hex_s16(file_hex, off)
            sum = sum + Float(s) / 32768.0
            wc = wc + 1
        mem_store(ptr_offset(buf, wi, "Float"), sum / ch_f, "Float")
        wi = wi + 1

    // ── Parse params ─────────────────────────────────────────────────────
    let pr: JsonObjectResult = json_object_field(cmd_obj, "params")
    let params: JsonObject = json_object()
    if pr.ok: params = pr.value
    let decay_val: Float = json_float_or(params, "decay", 0.84)
    let mix_val: Float = json_float_or(params, "mix", 0.5)

    // ── Apply reverb (inlined) ───────────────────────────────────────────
    if info.num_samples > 0 and decay_val >= 0.0 and decay_val <= 1.0 and mix_val >= 0.0 and mix_val <= 1.0:
        let sr_f: Float = Float(info.sample_rate)
        let scale: Float = sr_f / 25000.0
        let d_a: Int = Int(901.0 * scale)
        let d_b: Int = Int(778.0 * scale)
        let d_c: Int = Int(1182.0 * scale)
        let d_d: Int = Int(1392.0 * scale)
        let d_ap1: Int = Int(480.0 * scale)
        let d_ap2: Int = Int(161.0 * scale)
        if d_a < 1: d_a = 1
        if d_b < 1: d_b = 1
        if d_c < 1: d_c = 1
        if d_d < 1: d_d = 1
        if d_ap1 < 1: d_ap1 = 1
        if d_ap2 < 1: d_ap2 = 1

        let comb_a: RingBuf = ring_new(d_a)
        let comb_b: RingBuf = ring_new(d_b)
        let comb_c: RingBuf = ring_new(d_c)
        let comb_d: RingBuf = ring_new(d_d)
        let ap_a: RingBuf = ring_new(d_ap1)
        let ap_b: RingBuf = ring_new(d_ap2)
        let ap_g: Float = 0.7
        let comb_g: Float = decay_val
        var cs_a: RingBuf = comb_a
        var cs_b: RingBuf = comb_b
        var cs_c: RingBuf = comb_c
        var cs_d: RingBuf = comb_d
        var as_a: RingBuf = ap_a
        var as_b: RingBuf = ap_b

        var pi: Int = 0
        while pi < info.num_samples:
            let input: Float = mem_load(ptr_offset(buf, pi, "Float"), "Float")
            let ca_d: Float = ring_read(cs_a)
            let cb_d: Float = ring_read(cs_b)
            let cc_d: Float = ring_read(cs_c)
            let cd_d: Float = ring_read(cs_d)
            cs_a = ring_write(cs_a, input + (ca_d * comb_g))
            cs_b = ring_write(cs_b, input + (cb_d * comb_g))
            cs_c = ring_write(cs_c, input + (cc_d * comb_g))
            cs_d = ring_write(cs_d, input + (cd_d * comb_g))
            let comb_sum: Float = (ca_d + cb_d + cc_d + cd_d) * 0.25
            let ap1_d: Float = ring_read(as_a)
            let ap1_y: Float = (0.0 - ap_g) * comb_sum + ap1_d
            as_a = ring_write(as_a, comb_sum + (ap_g * ap1_y))
            let ap2_d: Float = ring_read(as_b)
            let ap2_y: Float = (0.0 - ap_g) * ap1_y + ap2_d
            as_b = ring_write(as_b, ap1_y + (ap_g * ap2_y))
            let output: Float = (input * (1.0 - mix_val)) + (ap2_y * mix_val)
            mem_store(ptr_offset(buf, pi, "Float"), output, "Float")
            pi = pi + 1

        ring_free(comb_a)
        ring_free(comb_b)
        ring_free(comb_c)
        ring_free(comb_d)
        ring_free(ap_a)
        ring_free(ap_b)

    // ── Build output JSON ────────────────────────────────────────────────
    let arr: JsonArray = json_array()
    var si: Int = 0
    while si < info.num_samples:
        let sv: Float = mem_load(ptr_offset(buf, si, "Float"), "Float")
        json_array_push_float(arr, sv)
        si = si + 1
    let res: JsonObject = json_object()
    json_object_set_string(res, "status", "ok")
    json_object_set_array(res, "samples", arr)
    json_object_set_int(res, "sr", info.sample_rate)
    json_object_set_int(res, "count", info.num_samples)
    println(json_stringify(res))
    runtime_shutdown()
    return 0
