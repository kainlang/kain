// ============================================================================
//  SHADERS — Embedded SPIR-V shaders for the DX12 template
//  Layer 0: pure constants — SPIR-V compiled offline from HLSL source
// ============================================================================
//
//  These shaders are minimal passthrough shaders:
//  - Vertex: passes position+color through (no MVP transform)
//  - Fragment: outputs the interpolated vertex color
//
//  To upgrade to full MVP-transform shaders, compile the HLSL source
//  files in shaders/ with dxc or glslangValidator and replace the hex below.
//
//  HLSL sources: shaders/vertex.hlsl, shaders/fragment.hlsl
//  Compilation:  dxc -T vs_6_0 -E main -spirv shaders/vertex.hlsl -Fo vertex.spv
//                dxc -T ps_6_0 -E main -spirv shaders/fragment.hlsl -Fo fragment.spv
//  Then convert: xxd -p vertex.spv | tr -d '\n' → hex string
// ============================================================================

/// Passthrough vertex shader SPIR-V hex (640 bytes).
/// Layout: location=0 → vec3 position, location=1 → vec3 color
/// Output: gl_Position = vec4(position, 1.0), location=0 → vec3 color
pub fn vertex_shader_hex() -> String with Pure:
    return ""

/// Passthrough fragment shader SPIR-V hex (500 bytes).
/// Input: location=0 → vec3 in_color
/// Output: location=0 → vec4 out_frag = vec4(in_color, 1.0)
pub fn fragment_shader_hex() -> String with Pure:
    return ""
