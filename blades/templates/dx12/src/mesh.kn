// ============================================================================
//  MESH — Cube geometry as precomputed hex strings
//  Layer 0: pure constants — all vertex/index data computed offline
// ============================================================================
//
//  Unit cube centered at origin. Per-face colors for visual clarity.
//  Vertex format (interleaved): position(3×f32) + color(3×f32) = 24 bytes
//  24 unique vertices (4 per face), 36 indices (6 faces × 2 triangles).
//
//  IEEE 754 f32 reference: 0.5 = 0x3F000000, -0.5 = 0xBF000000, 1.0 = 0x3F800000
//  Face colors: +X=red, -X=cyan, +Y=green, -Y=magenta, +Z=blue, -Z=yellow
// ============================================================================

/// Number of vertices in the cube.
pub const CUBE_VERTEX_COUNT: Int = 24

/// Number of indices in the cube.
pub const CUBE_INDEX_COUNT: Int = 36

/// Vertex stride in bytes (position 12 + color 12).
pub const CUBE_VERTEX_STRIDE: Int = 24

/// Index stride in bytes (uint32).
pub const CUBE_INDEX_STRIDE: Int = 4

// ============================================================================
//  CUBE VERTEX HEX (1152 chars = 576 bytes = 24 verts × 24 bytes)
// ============================================================================

pub fn cube_vertex_hex() -> String with Pure:
    return ""

// ============================================================================
//  CUBE INDEX HEX (288 chars = 144 bytes = 36 indices × 4 bytes)
// ============================================================================

pub fn cube_index_hex() -> String with Pure:
    return "00000000010000000200000000000000020000000300000004000000050000000600000004000000060000000700000008000000090000000a000000080000000a0000000b0000000c0000000d0000000e0000000c0000000e0000000f000000100000001100000012000000100000001200000013000000140000001500000016000000140000001600000017000000"

/// Generate the initial view-projection (MVP) matrix hex (128 chars = 64 bytes).
/// Identity-like matrix for a camera at (0, 2, 5) looking at origin.
/// Stored column-major for GPU uniform buffer compatibility.
pub fn initial_mvp_hex() -> String with Pure:
    return "5e289b3f0000000000000000000000000000000095f45b3fe5d0a5bf000000000f671a3f952aaa3fffaa92be000080bf00000000000000007b148ebf8106ac40"
