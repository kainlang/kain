// ============================================================================
//  EXAMPLE 8  —  ADVANCED TASK KINDS: CARGO, C SHARED LIB, NODE, BUN, FABRIC
// ============================================================================
//  These task kinds use build_task_of_kind() since std::build doesn't have
//  dedicated factory functions for them.  They exercise the extended kind
//  strings parsed by crates/build/src/workspace.rs
//
// fn build(ctx: BuildContext) -> BuildGraph:
//     let app = project("advanced-tasks")
//         .kind("kain_executable")
