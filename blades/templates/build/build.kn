// ============================================================================
//  END  —  THE ULTIMATE BUILD.KN
// ============================================================================
//  Remember: uncomment only what you need.  Every line is a working pattern
//  drawn from real build.kn files across the Kain repo.
//
//  Quick reference:
//    Project types:    project()    → package() + blade() shorthand
//    Check:            check_task() / build_check()
//    Executable:       native_executable() / root_executable()
//    Tests:            source_tests()
//    GPU:              gpu_suite()
//    External command: exec_task() / command_task()
//    Proof:            proof_task()        [from std::proof]
//    Bench:            bench_task()        [from std::bench]
//    Attrition:        attrition_task()    [from std::attrition]
//    Certify:          certify()           [from std::build]
//    Capsule:          capsule_set() / amalgamate_capsule()
//    Platform dep:     platform_requirement()
//    Cargo/Rust:       build_task_of_kind(id, "cargo")
//    C shared lib:     build_task_of_kind(id, "c")
//    Node.js:          build_task_of_kind(id, "node")
//    Bun:              build_task_of_kind(id, "bun")
//    Fabric:           build_task_of_kind(id, "fabric")
//    Cross-blade dep:  .requires("blade-name:task-id")
//
//  Path interpolation:
//    $root   → workspace root
//    $blade  → blade output root
//    $task   → task cache root
// ============================================================================
