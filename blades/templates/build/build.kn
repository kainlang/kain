//         .source_root("src")
//         .module_root("src")
//         .target("llvm")
//         .artifact_root(".kain/out")
//         .cache_root(".kain/cache/build")
//         .profile("debug")
//
//     let check = check_task("check-llvm")
//         .project(app)
//         .target("llvm")
//
//     let exe = native_executable("root-executable")
//         .project(app)
//         .output("$blade/advanced-tasks.exe")
//         .requires(check)
//
//     // ── Cargo / Rust build ──
//     //     Kind "cargo" / "rust" / "rust-crate" builds a Rust crate
