// ============================================================================
//  URSINA TEMPLATE — Entry Point
// ============================================================================
//  Wires the semantic stack: probe -> seed -> bridge -> run -> validate.
//
//  PHASES:
//    1. Probe      - check Ursina modules are available
//    2. Pre-Sim    - warm up actors, exercise converge/orchestrate/pulse
//    3. Bridge     - register python_actor_callback, bind to __main__
//    4. Launch     - python_exec the Ursina bootstrap (BLOCKS)
//    5. Validate   - check world state, mirror propagation, telemetry deltas
//
//  ADDING STUFF:
//    - New actors?  Drop them in actors.kn and spawn in Phase 2.
//    - New scene?   Edit entity_data in bridge.kn's inline Python.
//    - New state?   Add to world.kn: fields, entangles, laws, patches.
//    - New UI?      Drop a component in world.kn or ui.kn, compose in GameHUD.
//    - New pipeline? Add converge/orchestrate/pulse to pipeline.kn.
// ============================================================================

use std::runtime
use std::actor
use std::python
use std::intent

use world::GameWorld
use world::GameMirror
use world::commit_frame
use actors::UrsinaBridge
use bridge::build_ursina_bootstrap
use pipeline::entity_update
use pipeline::ursina_game_loop
use pipeline::pipeline_health_check
use helpers::ursina_mix
use scene::DEFAULT_ENTITY_COUNT

// ── Phase 1: Probe ──

fn probe_ursina_available() -> Int:
    if python_module_available("ursina") == false:
        return 10
    if python_module_available("panda3d.core") == false:
        return 11
    return 0

// ── Phase 2: Pre-Simulation ──
//  Exercises the semantic stack without Ursina.

fn run_pre_simulation(rounds: Int) -> Int:
    var checksum: Int = 137
    var round: Int = 0
    while round < rounds:
        let update_val = entity_update(round % 7, round)
        let _ = commit_frame(GameWorld, round)
        checksum = ursina_mix(checksum, round, update_val)
        round = round + 1

    // Exercise orchestrate pipeline
    let _pipeline_result = ursina_game_loop(
        checksum % 1000,
        checksum % 32,
        DEFAULT_ENTITY_COUNT
    )

    // Verify converge lanes
    let health = pipeline_health_check()
    if health != 0:
        return -10

    return checksum

// ── Phase 3: Register Callback Bridge ──
//  Creates Python callable objects that Ursina can invoke.

fn register_ursina_bridge(gate: UrsinaBridge) -> (Any, Any):
    // Create actor callback dispatchers
    let frame_cb = python_actor_callback(gate as Int, "FrameTick")
    let frame_fn = python_actor_callback_callable(frame_cb)

    let key_cb = python_actor_callback(gate as Int, "KeyEvent")
    let key_fn = python_actor_callback_callable(key_cb)

    // Bind to Python __main__ globals so Ursina bootstrap can reference them
    let main_mod = python_import("__main__")
    python_setattr(main_mod, "kain_frame_cb", frame_fn)
    python_setattr(main_mod, "kain_key_cb", key_fn)

    return (frame_fn, key_fn)

// ── Phase 4: Launch Ursina ──
//  Injects the inline Python. BLOCKS until window closes.

fn launch_ursina() -> Int:
    let _bootstrap = build_ursina_bootstrap()
    let _result = python_exec(_bootstrap)
    return 0

// ── Phase 5: Validate ──
//  After Ursina closes, verify worlds and telemetry.

fn validate_after_shutdown() -> Int:
    // World should have advanced at least a few frames
    if GameWorld.frame <= 0:
        return 50

    // Mirror should have received entangle propagation
    if GameMirror.frame_copy <= 0:
        return 60

    // Telemetry should show pipeline activity
    if orchestrate_stage_count() <= 0:
        return 70

    // Status must be clean (0 = running, 2 = shutdown)
    let status = GameWorld.status
    if status != 0 and status != 2:
        return 80 + status

    return 0

// ── MAIN ──

fn main() -> Int:
    // ── Init runtime ──
    let boot = runtime_init()
    if boot != 0:
        return 100 + boot

    // ── Phase 1: Probe ──
    let probe_status = probe_ursina_available()
    if probe_status != 0:
        // Ursina not available — run headless simulation
        let _gate = spawn UrsinaBridge()

        let sim_result = run_pre_simulation(12)
        if sim_result < 0:
            let shutdown = runtime_shutdown()
            return 90

        let shutdown = runtime_shutdown()
        if shutdown != 0:
            return 500 + shutdown

        if probe_status == 10:
            return 0    // ursina module not installed — OK on CI
        return probe_status

    // ── Phase 2: Spawn bridge actor ──
    let gate = spawn UrsinaBridge()

    // ── Phase 3: Register callbacks ──
    let (_frame_fn, _key_fn) = register_ursina_bridge(gate)

    // ── Phase 4: Launch Ursina (BLOCKS) ──
    let launch_result = launch_ursina()
    if launch_result != 0:
        let shutdown = runtime_shutdown()
        return 200 + launch_result

    // ── Phase 5: Validate ──
    let validate_result = validate_after_shutdown()
    if validate_result != 0:
        let shutdown = runtime_shutdown()
        return 300 + validate_result

    // ── Clean shutdown ──
    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 500 + shutdown

    return 0
