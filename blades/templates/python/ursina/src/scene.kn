    return entities

// ── Default camera orbit preset ──

pub struct CameraPreset:
    orbit_angle: Float
    radius: Float
    height: Float

pub fn default_camera() -> CameraPreset:
    return CameraPreset {
        orbit_angle: 0.0,
        radius: CAMERA_START_DISTANCE,
        height: CAMERA_START_HEIGHT,
    }
