// ============================================================================
//  SCENE — Sprite Templates & Scene Configuration
// ============================================================================
//  Define sprite layouts with shatter structs for cache-friendly SoA access.
//  Add new sprite presets, spawn configurations, or level blueprints here.
// ============================================================================

// ── Sprite template — SoA layout for hot update loops ──

shatter struct SpriteTemplate:
    pos_x: Int
    pos_y: Int
    vel_x: Int
    vel_y: Int
    size_w: Int
    size_h: Int
    color_r: Int
    color_g: Int
    color_b: Int
    speed: Int
    orbit_radius: Int
    orbit_angle: Int

// ── Scene dimensions ──

pub const CENTER_X: Int = 400
pub const CENTER_Y: Int = 300
pub const PLAYER_START_X: Int = 400
pub const PLAYER_START_Y: Int = 500
pub const PLAYER_SIZE: Int = 32
pub const COLLECTIBLE_SIZE: Int = 16
pub const COLLECTIBLE_COUNT: Int = 8

// ── Default sprite count ──

pub const DEFAULT_SPRITE_COUNT: Int = COLLECTIBLE_COUNT

// ── Build the default orbiting collectible set ──

