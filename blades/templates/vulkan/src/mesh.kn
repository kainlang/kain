// ============================================================================
//  VULKAN TEMPLATE — Mesh Data
//  Pre-computed colored cube vertex/index buffers as single-line hex strings.
// ============================================================================
//
//  Cube: 6 faces × 4 vertices = 24 vertices. Each vertex: pos(3f) + color(3f).
//  Stride: 24 bytes. Vertex count: 24, bytes: 576.
//  Index count: 36, stride: 4 (UInt32), bytes: 144.
//  Colors: front=blue, back=red, top=green, bottom=yellow, left=magenta, right=cyan

use std::graphics

/// 24 vertices, each 6 floats (pos.xyz + col.rgb), little-endian IEEE 754.
const CUBE_VERTEX_HEX: String = ""

/// 36 UInt32 indices, little-endian.
const CUBE_INDEX_HEX: String = "00000000010000000200000000000000020000000300000004000000050000000600000004000000060000000700000008000000090000000a000000080000000a0000000b0000000c0000000d0000000e0000000c0000000e0000000f000000100000001100000012000000100000001200000013000000140000001500000016000000140000001600000017000000"

/// Identity mat4 (64 bytes, column-major, IEEE 754 little-endian).
const IDENTITY_MAT4_HEX: String = "0000803f000000000000000000000000000000000000803f000000000000000000000000000000000000803f000000000000000000000000000000000000803f"

/// Create cube vertex buffer. Returns buffer ID, or 0 on failure.
pub fn create_cube_vertex_buffer(session: Int) -> Int with IO:
    return graphics_buffer_create_from_hex(session, "vertex", "cube-vertices", CUBE_VERTEX_HEX, 24)

/// Create cube index buffer. Returns buffer ID, or 0 on failure.
pub fn create_cube_index_buffer(session: Int) -> Int with IO:
    return graphics_buffer_create_from_hex(session, "index", "cube-indices", CUBE_INDEX_HEX, 4)

/// Create cube mesh from vertex + index buffers.
pub fn create_cube_mesh(session: Int, vbo: Int, ibo: Int) -> Int with IO:
    return graphics_mesh_create(session, "colored-cube", vbo, ibo, 24, 36)

/// Create uniform buffer with identity MVP (static — extend with per-frame updates).
pub fn create_uniform_buffer(session: Int) -> Int with IO:
    return graphics_buffer_create_from_hex(session, "uniform", "mvp-ubo", IDENTITY_MAT4_HEX, 64)
