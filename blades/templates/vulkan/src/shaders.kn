// ============================================================================
//  VULKAN TEMPLATE — Shader Loading
//  Loads SPIR-V from file, with embedded hex fallback.
// ============================================================================
//
//  GLSL source: shaders/vert.glsl
//    layout(location = 0) in vec3 a_position;
//    layout(location = 1) in vec3 a_color;
//    layout(binding = 0, std140) uniform UBO { mat4 mvp; } ubo;
//    layout(location = 0) out vec3 v_color;
//    void main() { gl_Position = ubo.mvp * vec4(a_position, 1.0); v_color = a_color; }
//
//  GLSL source: shaders/frag.glsl
//    layout(location = 0) in vec3 v_color;
//    layout(location = 0) out vec4 out_color;
//    void main() { out_color = vec4(v_color, 1.0); }

use std::graphics
use std::io

/// Vertex shader SPIR-V (1320 bytes), compiled from shaders/vert.glsl with glslc.
const VERT_SPV_HEX: String = ""

/// Fragment shader SPIR-V (568 bytes), compiled from shaders/frag.glsl with glslc.
const FRAG_SPV_HEX: String = ""

/// Load vertex shader: file first, hex fallback.
pub fn load_vertex_shader(session: Int) -> Int with IO:
    let file_id = graphics_shader_spirv_from_file(session, "main-vert", "vertex", "main", "shaders/vert.spv")
    if file_id > 0: return file_id
    return graphics_shader_spirv_from_hex(session, "main-vert", "vertex", "main", VERT_SPV_HEX)

/// Load fragment shader: file first, hex fallback.
pub fn load_fragment_shader(session: Int) -> Int with IO:
    let file_id = graphics_shader_spirv_from_file(session, "main-frag", "fragment", "main", "shaders/frag.spv")
    if file_id > 0: return file_id
    return graphics_shader_spirv_from_hex(session, "main-frag", "fragment", "main", FRAG_SPV_HEX)
