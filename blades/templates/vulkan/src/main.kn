// ============================================================================
//  VULKAN TEMPLATE — Entry Point
//  Cross-platform: Win32 window + std::graphics Vulkan backend.
//  Ladder rung: Layer 0 (fn) — imperative render loop.
//
//  Architecture:
//    Window:  include <windows.h> as win  → Win32 native window
//    Render:  std::graphics                → Vulkan GPU pipeline
//    Input:   GetAsyncKeyState + GetCursorPos → keyboard + mouse
//    Camera:  pure math in camera.kn       → view + projection matrices
//    Mesh:    pre-computed hex in mesh.kn  → colored cube geometry
//    Shaders: SPIR-V embedded in shaders.kn → vertex + fragment
//
//  Controls:
//    WASD — move camera   |  Q/E — up/down
//    Mouse — look around  |  Esc — exit
// ============================================================================

use std::graphics
use std::runtime
use std::alloc
use std::io
use std::math
use std::time

include <vulkan.h> as vk

// ============================================================================
//  MANUAL WINDOWS API DECLARATIONS (pointer-taking functions)
// ============================================================================

@extern @link_name("PeekMessageA")
fn peek_message(lpMsg: ptr<Int>, hWnd: Int, wMsgFilterMin: Int, wMsgFilterMax: Int, wRemoveMsg: Int) -> Int

@extern @link_name("TranslateMessage")
fn translate_message(lpMsg: ptr<Int>) -> Int

@extern @link_name("DispatchMessageA")
fn dispatch_message(lpMsg: ptr<Int>) -> Int

@extern @link_name("IsWindow")
fn is_window(hWnd: Int) -> Int

@extern @link_name("GetAsyncKeyState")
fn get_async_key_state(vKey: Int) -> Int

@extern @link_name("GetCursorPos")
fn get_cursor_pos(lpPoint: ptr<Int>) -> Int

@extern @link_name("SetCursorPos")
fn set_cursor_pos(X: Int, Y: Int) -> Int

@extern @link_name("ShowCursor")
fn show_cursor(bShow: Int) -> Int

@extern @link_name("ScreenToClient")
fn screen_to_client(hWnd: Int, lpPoint: ptr<Int>) -> Int

@extern @link_name("GetClientRect")
fn get_client_rect(hWnd: Int, lpRect: ptr<Int>) -> Int

@extern @link_name("Sleep")
fn win_sleep(dwMilliseconds: Int) -> Void

// ============================================================================
//  IMPORTS — Template Modules
// ============================================================================

use camera
use mesh
use shaders

// ============================================================================
//  CONSTANTS
// ============================================================================

const APP_NAME: String = "Vulkan Template"
const WINDOW_TITLE: String = "Kain Vulkan Template — Colored Cube + Flyby Camera"
const WIN_WIDTH: Int = 1280
const WIN_HEIGHT: Int = 720
const TARGET_FPS: Int = 60
const FRAME_MS: Int = 1000 / TARGET_FPS

// Virtual key codes
const VK_W: Int = 0x57
const VK_A: Int = 0x41
const VK_S: Int = 0x53
const VK_D: Int = 0x44
const VK_Q: Int = 0x51
const VK_E: Int = 0x45
const VK_ESCAPE: Int = 0x1B

// ============================================================================
//  WINDOW CREATION
// ============================================================================

fn create_window() -> Int with Unsafe:
    let hinst = win_GetModuleHandleA("user32.dll")
    // WS_OVERLAPPEDWINDOW | WS_VISIBLE
    let style = 0x00CF0000 | 0x10000000
    let hwnd = win_CreateWindowExA(
        0, "STATIC", WINDOW_TITLE, style,
        100, 80, WIN_WIDTH, WIN_HEIGHT,
        0, 0, hinst, 0,
    )
    if hwnd == 0:
        return 0
    // Subclass to DefWindowProcA
    let user32 = win_GetModuleHandleA("user32.dll")
    let def_wnd_proc = win_GetProcAddress(user32, "DefWindowProcA")
    let _ = win_SetWindowLongPtrA(hwnd, -4, def_wnd_proc)  // GWLP_WNDPROC
    let _ = win_ShowWindow(hwnd, 5)  // SW_SHOW
    let _ = win_UpdateWindow(hwnd)
    return hwnd

// ============================================================================
//  KEYBOARD POLLING
// ============================================================================

fn key_held(vk_code: Int) -> Float with Unsafe:
    let state = get_async_key_state(vk_code)
    if (state & 0x8000) != 0:
        return 1.0
    return 0.0

// ============================================================================
//  MOUSE DELTA — capture cursor, return (dx, dy) since last call
// ============================================================================

fn mouse_delta(hwnd: Int, capture: Int) -> (Float, Float) with Unsafe:
    // Get client area center
    let rect = alloc_zeroed(4, "Int")
    let _ = get_client_rect(hwnd, rect)
    let right = mem_load(ptr_offset(rect, 2, "Int"), "Int")
    let bottom = mem_load(ptr_offset(rect, 3, "Int"), "Int")
    let cx = right / 2
    let cy = bottom / 2
    decay rect

    // Get current cursor position (screen coords)
    let point = alloc_zeroed(2, "Int")
    let _ = get_cursor_pos(point)
    let sx = mem_load(ptr_offset(point, 0, "Int"), "Int")
    let sy = mem_load(ptr_offset(point, 1, "Int"), "Int")
    decay point

    // Convert to client coords
    let client_pt = alloc_zeroed(2, "Int")
    mem_store(ptr_offset(client_pt, 0, "Int"), sx, "Int")
    mem_store(ptr_offset(client_pt, 1, "Int"), sy, "Int")
    let _ = screen_to_client(hwnd, client_pt)
    let client_x = mem_load(ptr_offset(client_pt, 0, "Int"), "Int")
    let client_y = mem_load(ptr_offset(client_pt, 1, "Int"), "Int")
    decay client_pt

    let dx = client_x - cx
    let dy = client_y - cy

    // Re-center cursor if capturing
    if capture != 0:
        let _ = set_cursor_pos(sx - dx, sy - dy)

    return (Float(dx), Float(dy))

// ============================================================================
//  GPU INITIALIZATION
// ============================================================================

fn init_graphics() -> Int with IO:
    let session = graphics_session_create(APP_NAME, WIN_WIDTH, WIN_HEIGHT)
    if session <= 0:
        println("ERROR: Failed to create graphics session")
        return 0

    let backend_ok = graphics_backend_select(session, "vulkan")
    if backend_ok <= 0:
        println("WARNING: Vulkan backend unavailable, trying auto")
        let auto_ok = graphics_backend_select(session, "auto")
        if auto_ok <= 0:
            println("ERROR: No graphics backend available")
            let _ = graphics_session_destroy(session)
            return 0
    let backend = graphics_active_backend(session)
    println("Graphics backend: " + backend)
    return session

/// Initialize pipeline + mesh + uniform buffer. Returns pipeline ID.
/// The caller receives pre-created GPU objects; no per-frame recreation needed.
fn init_pipeline(session: Int) -> (Int, Int) with IO:
    // Load shaders
    let vs = shaders::load_vertex_shader(session)
    if vs <= 0:
        println("ERROR: Failed to load vertex shader. " +
                "Run: glslc shaders/vert.glsl -o shaders/vert.spv")
        return (0, 0)
    println("Vertex shader loaded (id=" + str(vs) + ")")

    let fs = shaders::load_fragment_shader(session)
    if fs <= 0:
        println("ERROR: Failed to load fragment shader")
        return (0, 0)
    println("Fragment shader loaded (id=" + str(fs) + ")")

    // Create geometry
    let vbo = mesh::create_cube_vertex_buffer(session)
    if vbo <= 0:
        println("ERROR: Failed to create vertex buffer")
        return (0, 0)
    let ibo = mesh::create_cube_index_buffer(session)
    if ibo <= 0:
        println("ERROR: Failed to create index buffer")
        return (0, 0)
    let cube_mesh = mesh::create_cube_mesh(session, vbo, ibo)
    if cube_mesh <= 0:
        println("ERROR: Failed to create mesh")
        return (0, 0)
    println("Cube mesh created (id=" + str(cube_mesh) + ", 24 verts, 36 indices)")

    // Uniform buffer (static identity MVP for template)
    let ubo = mesh::create_uniform_buffer(session)
    if ubo <= 0:
        println("ERROR: Failed to create uniform buffer")
        return (0, 0)
    println("Uniform buffer created (id=" + str(ubo) + ", 64 bytes)")

    // Pipeline
    let backend = graphics_active_backend(session)
    let pipeline = graphics_pipeline_create(
        session, "cube-pipeline", vs, fs, backend,
    )
    if pipeline <= 0:
        println("ERROR: Failed to create pipeline: " +
                graphics_last_error_kind() + " — " + graphics_last_error_message())
        return (0, 0)
    println("Pipeline created (id=" + str(pipeline) + ")")

    return (pipeline, cube_mesh)

// ============================================================================
//  ENTRY POINT
// ============================================================================

fn main() -> Int with Unsafe, IO:
    // --- Runtime init ---
    let boot = runtime_init()
    if boot != 0:
        println("ERROR: runtime_init failed (code " + str(boot) + ")")
        return boot

    // --- Create window ---
    let hwnd = create_window()
    if hwnd == 0:
        println("ERROR: Failed to create Win32 window")
        let _ = runtime_shutdown()
        return 1
    println("Window created (hwnd=" + str(hwnd) + ")")

    // --- Init graphics ---
    let gfx_session = init_graphics()
    if gfx_session == 0:
        let _ = win_DestroyWindow(hwnd)
        let _ = runtime_shutdown()
        return 2

    let (pipeline, cube_mesh) = init_pipeline(gfx_session)
    if pipeline == 0:
        let _ = graphics_session_destroy(gfx_session)
        let _ = win_DestroyWindow(hwnd)
        let _ = runtime_shutdown()
        return 3

    // --- Init camera ---
    let aspect = (WIN_WIDTH as Float) / (WIN_HEIGHT as Float)
    var cam = camera::fly_camera_new(aspect)
    println("Camera ready at (" +
            str(Int(cam.position.x)) + ", " +
            str(Int(cam.position.y)) + ", " +
            str(Int(cam.position.z)) + ")")

    // --- Message buffer ---
    let msg_buf = alloc_zeroed(6, "Int")

    // --- Timing ---
    var prev_time = now_millis()
    var frame_count: Int = 0

    println("")
    println("===========================================")
    println("  VULKAN TEMPLATE — Running")
    println("  WASD/QE: move  |  Mouse: look  |  Esc: exit")
    println("  Camera tracks but cube MVP is static —")
    println("  extend with per-frame uniform updates.")
    println("===========================================")
    println("")

    // =========================================================================
    //  MAIN LOOP
    // =========================================================================
    while is_window(hwnd) != 0:
        // --- Windows message pump ---
        var has_msg = peek_message(msg_buf, 0, 0, 0, 1)
        while has_msg != 0:
            let msg_type = mem_load(ptr_offset(msg_buf, 1, "Int"), "Int") & 0xFFFFFFFF
            if msg_type == 16:  // WM_CLOSE
                let _ = win_DestroyWindow(hwnd)
            if msg_type == 15:  // WM_PAINT
                let _ = win_ValidateRect(hwnd, 0)
            let _ = translate_message(msg_buf)
            let _ = dispatch_message(msg_buf)
            has_msg = peek_message(msg_buf, 0, 0, 0, 1)

        // --- Input: keyboard ---
        let fwd  = key_held(VK_W) - key_held(VK_S)
        let right = key_held(VK_D) - key_held(VK_A)
        let up    = key_held(VK_E) - key_held(VK_Q)

        if key_held(VK_ESCAPE) > 0.0:
            let _ = win_DestroyWindow(hwnd)

        // --- Input: mouse ---
        let (mx, my) = mouse_delta(hwnd, 0)

        // --- Timing ---
        let now = now_millis()
        let dt_ms = now - prev_time
        prev_time = now
        var dt = (dt_ms as Float) / 1000.0
        if dt <= 0.0:
            dt = 0.001
        if dt > 0.1:
            dt = 0.016

        // --- Update camera ---
        cam = camera::fly_camera_update(cam, fwd, right, up, mx, my, dt)

        if frame_count % 120 == 0:
            let p = cam.position
            let f = cam.forward
            println("frame=" + str(frame_count) +
                    "  pos(" + str(Int(p.x)) + "," + str(Int(p.y)) + "," + str(Int(p.z)) + ")" +
                    "  fwd(" + str(Int(f.x * 10.0) / 10.0) + "," +
                              str(Int(f.y * 10.0) / 10.0) + "," +
                              str(Int(f.z * 10.0) / 10.0) + ")")

        // --- Render frame ---
        let _ = graphics_begin_frame(gfx_session, dt_ms as Float)
        let _ = graphics_draw_mesh(gfx_session, pipeline, cube_mesh, 1)
        let _ = graphics_end_frame(gfx_session)
        let _ = graphics_present(gfx_session)

        // --- Frame pacing ---
        let elapsed = now_millis() - now
        if elapsed < FRAME_MS as Int:
            win_sleep((FRAME_MS as Int - elapsed) as Int)

        frame_count = frame_count + 1

    // =========================================================================
    //  CLEANUP
    // =========================================================================
    println("Shutting down...")
    let _ = graphics_session_destroy(gfx_session)
    decay msg_buf
    let _ = runtime_shutdown()
    println("Done. " + str(frame_count) + " frames rendered.")
    return 0
