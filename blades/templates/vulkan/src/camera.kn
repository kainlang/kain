// ============================================================================
//  VULKAN TEMPLATE — Flyby Camera (Pure Math)
//  Ladder rung: Layer 0 (fn, struct) — pure math, no input dependencies.
//
//  The caller (main.kn) polls keyboard/mouse via Win32, computes movement
//  and look deltas, then passes them to the camera as pure parameters.
//
//  Camera orientation is stored as yaw+pitch angles (FPS-style).
//  Movement:
//    Input:  move_forward_dt (positive=forward, negative=back)
//            move_right_dt   (positive=right, negative=left)
//            move_up_dt      (positive=up, negative=down)
//            look_dx         (mouse horizontal delta, radians)
//            look_dy         (mouse vertical delta, radians)
//  Matrices:
//    view        = mat4_look_at(position, position + forward, world_up)
//    projection  = mat4_perspective(fov, aspect, near, far)
//    mvp         = projection * view
// ============================================================================

use std::math

// ============================================================================
//  CONSTANTS
// ============================================================================

/// Default camera position (looking at origin)
const DEFAULT_POSITION: Vec3 = vec3(0.0, 3.0, 8.0)
const WORLD_UP: Vec3 = vec3(0.0, 1.0, 0.0)

/// Movement speed (units per second)
const MOVE_SPEED: Float = 8.0

/// Mouse look sensitivity (radians per pixel)
const LOOK_SENSITIVITY: Float = 0.002

/// Field of view (degrees, vertical)
const DEFAULT_FOV: Float = 60.0

/// Near / far clip planes
const NEAR_PLANE: Float = 0.1
const FAR_PLANE: Float = 1000.0

/// Pitch clamp (radians) — prevent camera flipping
const PITCH_MIN: Float = -1.5    // ~ -85 degrees
const PITCH_MAX: Float = 1.5     // ~ +85 degrees

// ============================================================================
//  CAMERA STATE STRUCT
// ============================================================================

/// Flyby camera state — used by main.kn each frame for matrix generation.
pub struct FlyCamera:
    position: Vec3            // world-space eye position
    forward: Vec3             // normalized forward direction
    right: Vec3               // normalized right direction
    up: Vec3                  // normalized local up direction
    yaw: Float                // rotation around world Y axis (radians)
    pitch: Float              // rotation around local X axis (radians)
    fov: Float                // vertical field of view (degrees)
    aspect: Float             // width / height
    near: Float               // near clip plane
    far: Float                // far clip plane

// ============================================================================
//  CONSTRUCTOR
// ============================================================================

/// Create a new flyby camera at the default position, facing -Z.
pub fn fly_camera_new(aspect: Float) -> FlyCamera with Pure:
    let forward = vec3_normalize_or_zero(vec3(0.0, -0.35, -0.94))
    let right = vec3_normalize_or_zero(vec3_cross(forward, WORLD_UP))
    let up = vec3_normalize_or_zero(vec3_cross(right, forward))
    return FlyCamera {
        position: DEFAULT_POSITION,
        forward: forward,
        right: right,
        up: up,
        yaw: -1.57079632679,   // -PI/2, facing roughly -Z
        pitch: -0.35,
        fov: DEFAULT_FOV,
        aspect: aspect,
        near: NEAR_PLANE,
        far: FAR_PLANE,
    }

// ============================================================================
//  UPDATE — Apply movement + look deltas, return new camera state
// ============================================================================

/// Apply frame deltas to the camera. All parameters are pure — no IO.
///
/// Parameters:
///   cam           — current camera state
///   forward_input — +1.0 = move forward, -1.0 = move back,  0.0 = no movement
///   right_input   — +1.0 = strafe right,  -1.0 = strafe left, 0.0 = none
///   up_input      — +1.0 = move up,       -1.0 = move down,    0.0 = none
///   look_dx       — mouse horizontal delta (pixels, scaled by sensitivity)
///   look_dy       — mouse vertical delta   (pixels, scaled by sensitivity)
///   dt            — delta time in seconds (for frame-rate-independent movement)
pub fn fly_camera_update(
    cam: FlyCamera,
    forward_input: Float,
    right_input: Float,
    up_input: Float,
    look_dx: Float,
    look_dy: Float,
    dt: Float,
) -> FlyCamera with Pure:
    // --- Yaw + Pitch from mouse ---
    let new_yaw = cam.yaw + look_dx * LOOK_SENSITIVITY
    let mut new_pitch = cam.pitch - look_dy * LOOK_SENSITIVITY
    if new_pitch < PITCH_MIN:
        new_pitch = PITCH_MIN
    if new_pitch > PITCH_MAX:
        new_pitch = PITCH_MAX

    // --- Recompute orientation from yaw/pitch ---
    let cos_yaw = fast_cos(new_yaw)
    let sin_yaw = fast_sin(new_yaw)
    let cos_pitch = fast_cos(new_pitch)
    let sin_pitch = fast_sin(new_pitch)

    let new_forward = vec3(
        cos_pitch * sin_yaw,
        sin_pitch,
        -cos_pitch * cos_yaw,
    )
    let new_forward_n = vec3_normalize_or_zero(new_forward)
    let new_right = vec3_normalize_or_zero(vec3_cross(new_forward_n, WORLD_UP))
    let new_up = vec3_normalize_or_zero(vec3_cross(new_right, new_forward_n))

    // --- Movement ---
    let speed = MOVE_SPEED * dt
    let mut new_position = cam.position
    if forward_input != 0.0:
        new_position = vec3_add(new_position, vec3_mul_scalar(new_forward_n, forward_input * speed))
    if right_input != 0.0:
        new_position = vec3_add(new_position, vec3_mul_scalar(new_right, right_input * speed))
    if up_input != 0.0:
        new_position = vec3_add(new_position, vec3_mul_scalar(WORLD_UP, up_input * speed))

    return FlyCamera {
        position: new_position,
        forward: new_forward_n,
        right: new_right,
        up: new_up,
        yaw: new_yaw,
        pitch: new_pitch,
        fov: cam.fov,
        aspect: cam.aspect,
        near: cam.near,
        far: cam.far,
    }

// ============================================================================
//  MATRIX GENERATION
// ============================================================================

/// Build the view matrix from current camera state.
pub fn fly_camera_view_matrix(cam: FlyCamera) -> Mat4 with Pure:
    let target = vec3_add(cam.position, cam.forward)
    return mat4_look_at(cam.position, target, cam.up)

/// Build the projection matrix.
pub fn fly_camera_projection_matrix(cam: FlyCamera) -> Mat4 with Pure:
    let fov_rad = degrees_to_radians(cam.fov)
    return mat4_perspective(fov_rad, cam.aspect, cam.near, cam.far)

/// Build mvp = projection × view.
pub fn fly_camera_mvp_matrix(cam: FlyCamera) -> Mat4 with Pure:
    let view = fly_camera_view_matrix(cam)
    let proj = fly_camera_projection_matrix(cam)
    return mat4_mul(proj, view)

/// Update aspect ratio (e.g., after window resize).
pub fn fly_camera_set_aspect(cam: FlyCamera, aspect: Float) -> FlyCamera with Pure:
    return FlyCamera {
        position: cam.position,
        forward: cam.forward,
        right: cam.right,
        up: cam.up,
        yaw: cam.yaw,
        pitch: cam.pitch,
        fov: cam.fov,
        aspect: aspect,
        near: cam.near,
        far: cam.far,
    }
