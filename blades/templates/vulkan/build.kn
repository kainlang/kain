// ============================================================================
//  VULKAN TEMPLATE BUILD AUTHORITY
//  Win32 window + std::graphics Vulkan backend
// ============================================================================

use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let app = project("vulkan-template")
        .kind("kain_executable")
        .version("0.1.0")
        .description("Vulkan 3D starter — cube + flyby camera")
        .entry("src/main.kn")
        .source_root("src")
        .module_root("src")
        .targets("llvm")
        .artifact_root(".kain/out")
        .cache_root(".kain/cache/build")

    let check = check_task("check-llvm")
        .project(app)
        .target("llvm")

    let exe = native_executable("root-executable")
        .project(app)
        .output("$blade/vulkan-template.exe")
        .requires(check)

    return build_graph()
        .project(app)
        .task(check)
        .task(exe)
