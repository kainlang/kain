// ============================================================================
// K_OS Sculpt Hybrid Coral - KAIN Edition
// ============================================================================
// Generates branching coral-like structures with fractal-ish growth patterns.
// Uses multiple noise octaves and radial displacement to create organic
// branching structures that grow outward from the brush center.
//
// Parameters:
//   extras0.x = branch_density (1.0-8.0) - Number of major branches
//   extras1.x = branch_length (0.5-3.0) - How far branches extend
//   extras2.x = noise_scale (0.5-10.0) - Detail frequency of surface
//   extras3.x = growth_bias (0.0-1.0) - Upward vs radial growth (0=radial, 1=up)
//   extras0.y = branch_thickness (0.1-1.0) - Base thickness of branches
//   extras1.y = recursion_depth (1.0-4.0) - Sub-branch generations
//   extras2.y = twist_amount (0.0-2.0) - Spiral twist of branches
//   extras3.y = porosity (0.0-1.0) - Amount of holes/gaps in structure
//
// Compiled to SPIR-V via: kain sculpt_hybrid_coral.kn -t spirv -o sculpt_hybrid_coral.spv
// ============================================================================

shader compute hybrid_coral(id: UVec3) -> Vec4:
    // Storage buffers
    uniform positions: StorageBuffer<Vec4> @0
    uniform normals: StorageBuffer<Vec4> @1
    uniform candidates: StorageBuffer<UInt> @3
    uniform counter: StorageBuffer<UInt> @4
    
    // Brush params (matching BrushParamsV2.1 layout)
    uniform center: Vec4 @5
    uniform normal: Vec4 @6
    uniform velocity: Vec4 @7
    uniform prev_center: Vec3 @8
    uniform stroke_distance: Float @9
    uniform radius: Float @10
    uniform strength: Float @11
    uniform hardness: Float @12
    uniform spacing: Float @13
    uniform flags: UInt @14
    uniform vertex_count: UInt @15
    uniform candidate_count: UInt @16
    uniform alpha_mode: UInt @17
    uniform alpha_scale: Float @18
    uniform alpha_rotation: Float @19
    uniform alpha_offset: Vec2 @20
    uniform alpha_blend_weight: Float @21
    uniform alpha_mirror: UInt @22
    uniform jitter_position: Float @23
    uniform jitter_rotation: Float @24
    uniform jitter_strength: Float @25
    uniform random_seed: Float @26
    uniform extras0: Vec4 @27
    uniform extras1: Vec4 @28
    uniform extras2: Vec4 @29
    uniform extras3: Vec4 @30
    uniform extras4: Vec4 @31
    uniform extras5: Vec4 @32
    
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102
    
    let FLAG_SUBTRACT = 1 as UInt
    let FLAG_FRONT_FACES_ONLY = 2 as UInt
    let ALPHA_DISABLED = 0 as UInt
    let PI = 3.14159265359
    
    // Get vertex index (handles candidate list or full dispatch)
    let vertex_idx_raw = id.x
    let count = counter[0]
    let mut vertex_idx = 0 as UInt
    
    if count > 0 as UInt:
        if vertex_idx_raw >= count:
            return vec4(0.0, 0.0, 0.0, 0.0)
        vertex_idx = candidates[vertex_idx_raw]
    else:
        if vertex_idx_raw >= vertex_count:
            return vec4(0.0, 0.0, 0.0, 0.0)
        vertex_idx = vertex_idx_raw
    
    let pos = positions[vertex_idx].xyz
    let nor = normals[vertex_idx].xyz
    let center_pos = center.xyz
    let brush_normal = normal.xyz
    
    let to_center = pos - center_pos
    let dist = length(to_center)
    if dist > radius:
        return vec4(0.0, 0.0, 0.0, 0.0)
    
    // Front face check
    if (flags & FLAG_FRONT_FACES_ONLY) != 0 as UInt:
        if dot(nor, -brush_normal) < 0.0:
            return vec4(0.0, 0.0, 0.0, 0.0)
    
    // Calculate weight (simple falloff)
    let t = clamp(dist / radius, 0.0, 1.0)
    let soft = 1.0 - t * t
    let hard = 1.0 - t
    let mut weight = mix(soft, hard, hardness)
    
    // Sample alpha (inlined)
    let surface_local = to_center - dot(to_center, brush_normal) * brush_normal
    if alpha_mode != ALPHA_DISABLED:
        let mut uv = (vec2(surface_local.x, surface_local.z) / radius + 1.0) * 0.5
        let centered = uv - vec2(0.5, 0.5)
        let cos_r = cos(alpha_rotation)
        let sin_r = sin(alpha_rotation)
        let rotated = vec2(
            centered.x * cos_r - centered.y * sin_r,
            centered.x * sin_r + centered.y * cos_r
        )
        let scaled = rotated / alpha_scale
        uv = scaled + vec2(0.5, 0.5) + alpha_offset
        if (alpha_mirror & 1 as UInt) != 0 as UInt:
            uv = vec2(1.0 - uv.x, uv.y)
        if (alpha_mirror & 2 as UInt) != 0 as UInt:
            uv = vec2(uv.x, 1.0 - uv.y)
        weight = weight * alpha_blend_weight
    
    // Apply pressure
    weight = weight * center.w
    
    // ========================================================================
    // CORAL GROWTH ALGORITHM
    // ========================================================================
    
    // Extract parameters
    let branch_density = clamp(extras0.x, 1.0, 8.0)
    let branch_length = clamp(extras1.x, 0.5, 3.0)
    let noise_scale = clamp(extras2.x, 0.5, 10.0)
    let growth_bias = clamp(extras3.x, 0.0, 1.0)
    let branch_thickness = clamp(extras0.y, 0.1, 1.0)
    let recursion_depth = clamp(extras1.y, 1.0, 4.0)
    let twist_amount = clamp(extras2.y, 0.0, 2.0)
    let porosity = clamp(extras3.y, 0.0, 1.0)
    
    // ========================================================================
    // MULTI-OCTAVE NOISE FOR ORGANIC DETAIL
    // ========================================================================
    
    // Hash function for pseudo-random values
    let hash_p1 = pos * noise_scale + vec3(random_seed, random_seed * 1.3, random_seed * 1.7)
    let hash_q1 = vec3(
        dot(hash_p1, vec3(127.1, 311.7, 74.7)),
        dot(hash_p1, vec3(269.5, 183.3, 246.1)),
        dot(hash_p1, vec3(113.5, 271.9, 124.6))
    )
    let noise1 = fract(sin(hash_q1) * 43758.5453) * 2.0 - 1.0
    
    // Second octave (higher frequency)
    let hash_p2 = pos * noise_scale * 2.0 + vec3(random_seed * 2.1, random_seed * 2.3, random_seed * 2.7)
    let hash_q2 = vec3(
        dot(hash_p2, vec3(127.1, 311.7, 74.7)),
        dot(hash_p2, vec3(269.5, 183.3, 246.1)),
        dot(hash_p2, vec3(113.5, 271.9, 124.6))
    )
    let noise2 = fract(sin(hash_q2) * 43758.5453) * 2.0 - 1.0
    
    // Third octave (even higher frequency)
    let hash_p3 = pos * noise_scale * 4.0 + vec3(random_seed * 3.1, random_seed * 3.3, random_seed * 3.7)
    let hash_q3 = vec3(
        dot(hash_p3, vec3(127.1, 311.7, 74.7)),
        dot(hash_p3, vec3(269.5, 183.3, 246.1)),
        dot(hash_p3, vec3(113.5, 271.9, 124.6))
    )
    let noise3 = fract(sin(hash_q3) * 43758.5453) * 2.0 - 1.0
    
    // Combine octaves with decreasing amplitude
    let combined_noise = noise1 * 0.5 + noise2 * 0.25 + noise3 * 0.125
    
    // ========================================================================
    // RADIAL BRANCHING PATTERN
    // ========================================================================
    
    // Calculate spherical coordinates from brush center
    let radial_dir = normalize(to_center + vec3(0.0001, 0.0, 0.0))
    
    // Proper spherical coordinates using trig functions
    let theta = atan2(radial_dir.z, radial_dir.x)
    let phi = asin(clamp(radial_dir.y, -1.0, 1.0))
    
    // Create branch pattern using angular quantization
    let branch_angle_step = 2.0 * PI / branch_density
    let branch_index = floor((theta + PI) / branch_angle_step)
    let branch_theta = branch_index * branch_angle_step - PI
    
    // Calculate distance to nearest branch axis
    let branch_dir_x = cos(branch_theta)
    let branch_dir_z = sin(branch_theta)
    let branch_dir = vec3(branch_dir_x, 0.0, branch_dir_z)
    
    // Add vertical component based on growth bias
    let up_component = vec3(0.0, 1.0, 0.0) * growth_bias
    let growth_dir = normalize(branch_dir * (1.0 - growth_bias) + up_component)
    
    // ========================================================================
    // BRANCH THICKNESS AND TAPERING
    // ========================================================================
    
    // Distance along branch
    let branch_progress = clamp(dist / (radius * branch_length), 0.0, 1.0)
    
    // Branch tapers toward tip
    let taper = 1.0 - branch_progress * 0.7
    let branch_radius = radius * branch_thickness * taper
    
    // Distance from branch axis
    let to_branch_axis = radial_dir - dot(radial_dir, growth_dir) * growth_dir
    let axis_dist = length(to_branch_axis) * dist
    
    // Check if vertex is within branch volume
    let branch_mask = 1.0 - clamp(axis_dist / branch_radius, 0.0, 1.0)
    
    // ========================================================================
    // SUB-BRANCHING (RECURSIVE DETAIL)
    // ========================================================================
    
    let mut sub_branch_factor = 1.0
    let mut depth = 1.0
    while depth < recursion_depth:
        // Create sub-branches at higher frequencies
        let sub_scale = depth * 2.0
        let sub_theta = theta * sub_scale + random_seed * depth
        let sub_branch_pattern = sin(sub_theta * branch_density * sub_scale) * 0.5 + 0.5
        
        // Sub-branches are thinner and shorter
        let sub_thickness = 1.0 / (depth + 1.0)
        sub_branch_factor = sub_branch_factor * (1.0 - sub_branch_pattern * sub_thickness * 0.3)
        
        depth = depth + 1.0
    
    // ========================================================================
    // SPIRAL TWIST
    // ========================================================================
    
    let twist_angle = branch_progress * twist_amount * 2.0 * PI
    let cos_twist = cos(twist_angle)
    let sin_twist = sin(twist_angle)
    
    // Rotate around growth direction
    let twist_offset = vec3(
        to_branch_axis.x * cos_twist - to_branch_axis.z * sin_twist,
        to_branch_axis.y,
        to_branch_axis.x * sin_twist + to_branch_axis.z * cos_twist
    )
    
    // ========================================================================
    // POROSITY (HOLES IN STRUCTURE)
    // ========================================================================
    
    let pore_pattern = sin(theta * 8.0 + random_seed) * sin(phi * 8.0 + random_seed * 1.5)
    let pore_mask = 1.0 - clamp((pore_pattern + 1.0) * 0.5 * porosity, 0.0, 1.0)
    
    // ========================================================================
    // COMBINE ALL FACTORS
    // ========================================================================
    
    // Base displacement along growth direction
    let base_displacement = growth_dir * branch_progress * branch_length * radius
    
    // Add noise-based surface detail
    let surface_detail = combined_noise * radius * 0.1
    
    // Radial expansion with twist
    let radial_expansion = twist_offset * 0.1
    
    // Combine all displacements
    let total_displacement = base_displacement + surface_detail + radial_expansion
    
    // Apply all masks
    let final_weight = weight * branch_mask * sub_branch_factor * pore_mask
    
    let mut displacement = total_displacement * final_weight * strength
    
    // Subtract mode
    if (flags & FLAG_SUBTRACT) != 0 as UInt:
        displacement = -displacement
    
    let new_pos = pos + displacement
    positions[vertex_idx] = vec4(new_pos.x, new_pos.y, new_pos.z, 1.0)
    return vec4(new_pos.x, new_pos.y, new_pos.z, 1.0)
