// ============================================================================
// K_OS Sculpt Hybrid Erosion - KAIN Edition
// ============================================================================
// Simulates geological erosion with flow lines and sediment deposition.
// Vertices move based on "height" (distance from brush center) and "flow
// direction" (downhill gradient). Combines hydraulic erosion, thermal
// weathering, and sediment transport for realistic geological effects.
//
// Parameters:
//   extras0.x = erosion_rate (0.0-2.0) - How fast material erodes
//   extras1.x = deposition_rate (0.0-2.0) - How fast sediment deposits
//   extras2.x = flow_strength (0.0-2.0) - Water flow force
//   extras3.x = thermal_weathering (0.0-1.0) - Slope-based crumbling
//   extras0.y = sediment_capacity (0.1-2.0) - How much sediment flow carries
//   extras1.y = evaporation_rate (0.0-1.0) - Water loss rate
//   extras2.y = slope_threshold (0.0-1.0) - Angle where weathering starts
//   extras3.y = hardness_variation (0.0-1.0) - Material resistance variation
//   extras0.z = flow_inertia (0.0-1.0) - Flow direction persistence
//   extras1.z = turbulence (0.0-1.0) - Flow randomness
//
// Compiled to SPIR-V via: kain sculpt_hybrid_erosion.kn -t spirv -o sculpt_hybrid_erosion.spv
// ============================================================================

shader compute hybrid_erosion(id: UVec3) -> Vec4:
    // Storage buffers
    uniform positions: StorageBuffer<Vec4> @0
    uniform normals: StorageBuffer<Vec4> @1
    uniform candidates: StorageBuffer<UInt> @3
    uniform counter: StorageBuffer<UInt> @4
    
    // Brush params (matching BrushParamsV2.1 layout)
    uniform center: Vec4 @5
    uniform normal: Vec4 @6
    uniform velocity: Vec4 @7
    uniform prev_center: Vec3 @8
    uniform stroke_distance: Float @9
    uniform radius: Float @10
    uniform strength: Float @11
    uniform hardness: Float @12
    uniform spacing: Float @13
    uniform flags: UInt @14
    uniform vertex_count: UInt @15
    uniform candidate_count: UInt @16
    uniform alpha_mode: UInt @17
    uniform alpha_scale: Float @18
    uniform alpha_rotation: Float @19
    uniform alpha_offset: Vec2 @20
    uniform alpha_blend_weight: Float @21
    uniform alpha_mirror: UInt @22
    uniform jitter_position: Float @23
    uniform jitter_rotation: Float @24
    uniform jitter_strength: Float @25
    uniform random_seed: Float @26
    uniform extras0: Vec4 @27
    uniform extras1: Vec4 @28
    uniform extras2: Vec4 @29
    uniform extras3: Vec4 @30
    uniform extras4: Vec4 @31
    uniform extras5: Vec4 @32
    
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102
    
    let FLAG_SUBTRACT = 1 as UInt
    let FLAG_FRONT_FACES_ONLY = 2 as UInt
    let ALPHA_DISABLED = 0 as UInt
    let PI = 3.14159265359
    
    // Get vertex index (handles candidate list or full dispatch)
    let vertex_idx_raw = id.x
    let count = counter[0]
    let mut vertex_idx = 0 as UInt
    
    if count > 0 as UInt:
        if vertex_idx_raw >= count:
            return vec4(0.0, 0.0, 0.0, 0.0)
        vertex_idx = candidates[vertex_idx_raw]
    else:
        if vertex_idx_raw >= vertex_count:
            return vec4(0.0, 0.0, 0.0, 0.0)
        vertex_idx = vertex_idx_raw
    
    let pos = positions[vertex_idx].xyz
    let nor = normals[vertex_idx].xyz
    let center_pos = center.xyz
    let brush_normal = normal.xyz
    
    let to_center = pos - center_pos
    let dist = length(to_center)
    if dist > radius:
        return vec4(0.0, 0.0, 0.0, 0.0)
    
    // Front face check
    if (flags & FLAG_FRONT_FACES_ONLY) != 0 as UInt:
        if dot(nor, -brush_normal) < 0.0:
            return vec4(0.0, 0.0, 0.0, 0.0)
    
    // Calculate weight (simple falloff)
    let t = clamp(dist / radius, 0.0, 1.0)
    let soft = 1.0 - t * t
    let hard = 1.0 - t
    let mut weight = mix(soft, hard, hardness)
    
    // Sample alpha (inlined)
    let surface_local = to_center - dot(to_center, brush_normal) * brush_normal
    if alpha_mode != ALPHA_DISABLED:
        let mut uv = (vec2(surface_local.x, surface_local.z) / radius + 1.0) * 0.5
        let centered = uv - vec2(0.5, 0.5)
        let cos_r = cos(alpha_rotation)
        let sin_r = sin(alpha_rotation)
        let rotated = vec2(
            centered.x * cos_r - centered.y * sin_r,
            centered.x * sin_r + centered.y * cos_r
        )
        let scaled = rotated / alpha_scale
        uv = scaled + vec2(0.5, 0.5) + alpha_offset
        if (alpha_mirror & 1 as UInt) != 0 as UInt:
            uv = vec2(1.0 - uv.x, uv.y)
        if (alpha_mirror & 2 as UInt) != 0 as UInt:
            uv = vec2(uv.x, 1.0 - uv.y)
        weight = weight * alpha_blend_weight
    
    // Apply pressure
    weight = weight * center.w
    
    // ========================================================================
    // EROSION SIMULATION ALGORITHM
    // ========================================================================
    
    // Extract parameters
    let erosion_rate = clamp(extras0.x, 0.0, 2.0)
    let deposition_rate = clamp(extras1.x, 0.0, 2.0)
    let flow_strength = clamp(extras2.x, 0.0, 2.0)
    let thermal_weathering = clamp(extras3.x, 0.0, 1.0)
    let sediment_capacity = clamp(extras0.y, 0.1, 2.0)
    let evaporation_rate = clamp(extras1.y, 0.0, 1.0)
    let slope_threshold = clamp(extras2.y, 0.0, 1.0)
    let hardness_variation = clamp(extras3.y, 0.0, 1.0)
    let flow_inertia = clamp(extras0.z, 0.0, 1.0)
    let turbulence = clamp(extras1.z, 0.0, 1.0)
    
    // ========================================================================
    // HEIGHT FIELD CALCULATION
    // ========================================================================
    
    // Use distance from brush center as "height"
    // Closer to center = higher elevation
    let height = radius - dist
    let normalized_height = height / radius
    
    // ========================================================================
    // GRADIENT CALCULATION (FLOW DIRECTION)
    // ========================================================================
    
    // Sample neighboring heights to calculate gradient
    let sample_dist = radius * 0.1
    
    // Sample in 4 cardinal directions
    let right_dir = normalize(cross(brush_normal, vec3(0.0, 1.0, 0.0)) + vec3(0.0001, 0.0, 0.0))
    let forward_dir = cross(right_dir, brush_normal)
    
    // Calculate gradient (downhill direction)
    let right_sample = pos + right_dir * sample_dist
    let left_sample = pos - right_dir * sample_dist
    let forward_sample = pos + forward_dir * sample_dist
    let back_sample = pos - forward_dir * sample_dist
    
    let right_height = radius - length(right_sample - center_pos)
    let left_height = radius - length(left_sample - center_pos)
    let forward_height = radius - length(forward_sample - center_pos)
    let back_height = radius - length(back_sample - center_pos)
    
    let gradient_x = (right_height - left_height) / (sample_dist * 2.0)
    let gradient_z = (forward_height - back_height) / (sample_dist * 2.0)
    
    // Flow direction (downhill)
    let flow_dir_2d = vec2(-gradient_x, -gradient_z)
    let flow_magnitude = length(flow_dir_2d)
    let flow_dir_normalized = normalize(flow_dir_2d + vec2(0.0001, 0.0))
    
    // Convert to 3D flow direction
    let flow_dir_3d = right_dir * flow_dir_normalized.x + forward_dir * flow_dir_normalized.y
    
    // ========================================================================
    // MATERIAL HARDNESS VARIATION
    // ========================================================================
    
    // Generate pseudo-random hardness based on position
    let hardness_seed = pos * 5.0 + vec3(random_seed, random_seed * 1.3, random_seed * 1.7)
    let hardness_hash = vec3(
        dot(hardness_seed, vec3(127.1, 311.7, 74.7)),
        dot(hardness_seed, vec3(269.5, 183.3, 246.1)),
        dot(hardness_seed, vec3(113.5, 271.9, 124.6))
    )
    let hardness_noise = fract(sin(hardness_hash) * 43758.5453)
    let material_hardness = mix(1.0, hardness_noise.x, hardness_variation)
    
    // ========================================================================
    // HYDRAULIC EROSION
    // ========================================================================
    
    // Water flow capacity (more flow on steeper slopes)
    let slope = clamp(flow_magnitude, 0.0, 1.0)
    let water_amount = slope * flow_strength * (1.0 - evaporation_rate * normalized_height)
    
    // Sediment carrying capacity
    let max_sediment = water_amount * sediment_capacity * slope
    
    // Current sediment (based on local curvature)
    let curvature = abs(gradient_x) + abs(gradient_z)
    let current_sediment = curvature * 0.5
    
    // Erosion occurs when flow can carry more sediment
    let mut erosion_amount = 0.0
    let mut deposition_amount = 0.0
    
    if current_sediment < max_sediment:
        // Erode material
        erosion_amount = (max_sediment - current_sediment) * erosion_rate * water_amount / material_hardness
    else:
        // Deposit sediment
        deposition_amount = (current_sediment - max_sediment) * deposition_rate
    
    // ========================================================================
    // THERMAL WEATHERING (SLOPE-BASED CRUMBLING)
    // ========================================================================
    
    // Calculate slope angle from normal
    let slope_angle = 1.0 - abs(dot(nor, vec3(0.0, 1.0, 0.0)))
    
    // Weathering occurs on steep slopes
    let mut weathering_amount = 0.0
    if slope_angle > slope_threshold:
        let excess_slope = slope_angle - slope_threshold
        weathering_amount = excess_slope * thermal_weathering * (1.0 / material_hardness)
    
    // ========================================================================
    // FLOW TURBULENCE
    // ========================================================================
    
    // Add random perturbation to flow direction
    let turb_seed = pos * 10.0 + vec3(random_seed * 2.1, random_seed * 2.3, random_seed * 2.7)
    let turb_hash = vec3(
        dot(turb_seed, vec3(127.1, 311.7, 74.7)),
        dot(turb_seed, vec3(269.5, 183.3, 246.1)),
        dot(turb_seed, vec3(113.5, 271.9, 124.6))
    )
    let turb_noise = fract(sin(turb_hash) * 43758.5453) * 2.0 - 1.0
    let turbulent_offset = turb_noise * turbulence * 0.1
    
    // ========================================================================
    // FLOW INERTIA (DIRECTION PERSISTENCE)
    // ========================================================================
    
    // Blend flow direction with stroke velocity for persistence
    let stroke_dir = normalize(velocity.xyz + vec3(0.0001, 0.0, 0.0))
    let inertial_flow = mix(flow_dir_3d, stroke_dir, flow_inertia)
    
    // ========================================================================
    // COMBINE ALL EROSION EFFECTS
    // ========================================================================
    
    // Total height change
    let height_change = -erosion_amount + deposition_amount - weathering_amount
    
    // Displacement along surface normal (height change)
    let vertical_displacement = nor * height_change * radius * 0.1
    
    // Lateral displacement (sediment transport)
    let lateral_displacement = inertial_flow * erosion_amount * flow_strength * radius * 0.05
    
    // Add turbulence
    let turbulence_displacement = turbulent_offset * radius * 0.02
    
    // Weathering causes downslope movement
    let weathering_displacement = flow_dir_3d * weathering_amount * radius * 0.05
    
    // Total displacement
    let total_displacement = vertical_displacement + lateral_displacement + turbulence_displacement + weathering_displacement
    
    let mut displacement = total_displacement * weight * strength
    
    // Subtract mode
    if (flags & FLAG_SUBTRACT) != 0 as UInt:
        displacement = -displacement
    
    let new_pos = pos + displacement
    positions[vertex_idx] = vec4(new_pos.x, new_pos.y, new_pos.z, 1.0)
    return vec4(new_pos.x, new_pos.y, new_pos.z, 1.0)
