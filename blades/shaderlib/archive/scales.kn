// ============================================================================
// K_OS Sculpt Artistic Scales - KAIN Edition
// ============================================================================
// Creates overlapping scale pattern like dragon/fish scales
// Uses circular displacement with offset grid
// Compiled to SPIR-V via: kain sculpt_artistic_scales.kn -t spirv -o sculpt_artistic_scales.spv
// ============================================================================

shader compute artistic_scales(id: UVec3) -> Vec4:
    // Storage buffers
    uniform positions: StorageBuffer<Vec4> @0
    uniform normals: StorageBuffer<Vec4> @1
    uniform candidates: StorageBuffer<UInt> @3
    uniform counter: StorageBuffer<UInt> @4
    
    // Brush params (matching BrushParamsV2.1 layout)
    uniform center: Vec4 @5
    uniform normal: Vec4 @6
    uniform velocity: Vec4 @7
    uniform prev_center: Vec3 @8
    uniform stroke_distance: Float @9
    uniform radius: Float @10
    uniform strength: Float @11
    uniform hardness: Float @12
    uniform spacing: Float @13
    uniform flags: UInt @14
    uniform vertex_count: UInt @15
    uniform candidate_count: UInt @16
    uniform alpha_mode: UInt @17
    uniform alpha_scale: Float @18
    uniform alpha_rotation: Float @19
    uniform alpha_offset: Vec2 @20
    uniform alpha_blend_weight: Float @21
    uniform alpha_mirror: UInt @22
    uniform jitter_position: Float @23
    uniform jitter_rotation: Float @24
    uniform jitter_strength: Float @25
    uniform random_seed: Float @26
    uniform extras0: Vec4 @27  // x = scale_size
    uniform extras1: Vec4 @28  // x = scale_overlap
    uniform extras2: Vec4 @29  // x = scale_height
    uniform extras3: Vec4 @30  // x = pattern_rotation
    uniform extras4: Vec4 @31
    uniform extras5: Vec4 @32
    
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102
    
    let FLAG_SUBTRACT = 1 as UInt
    let FLAG_FRONT_FACES_ONLY = 2 as UInt
    let ALPHA_DISABLED = 0 as UInt
    let PI = 3.14159265359
    
    // Get vertex index (handles candidate list or full dispatch)
    let vertex_idx_raw = id.x
    let count = counter[0]
    let mut vertex_idx = 0 as UInt
    
    if count > 0 as UInt:
        if vertex_idx_raw >= count:
            return vec4(0.0, 0.0, 0.0, 0.0)
        vertex_idx = candidates[vertex_idx_raw]
    else:
        if vertex_idx_raw >= vertex_count:
            return vec4(0.0, 0.0, 0.0, 0.0)
        vertex_idx = vertex_idx_raw
    
    let pos = positions[vertex_idx].xyz
    let nor = normals[vertex_idx].xyz
    let center_pos = center.xyz
    let brush_normal = normal.xyz
    
    let to_center = pos - center_pos
    let dist = length(to_center)
    if dist > radius:
        return vec4(0.0, 0.0, 0.0, 0.0)
    
    // Front face check
    if (flags & FLAG_FRONT_FACES_ONLY) != 0 as UInt:
        if dot(nor, -brush_normal) < 0.0:
            return vec4(0.0, 0.0, 0.0, 0.0)
    
    // Calculate weight (simple falloff)
    let t = clamp(dist / radius, 0.0, 1.0)
    let soft = 1.0 - t * t
    let hard = 1.0 - t
    let mut weight = mix(soft, hard, hardness)
    
    // Sample alpha (inlined)
    let surface_local = to_center - dot(to_center, brush_normal) * brush_normal
    if alpha_mode != ALPHA_DISABLED:
        let mut uv = (vec2(surface_local.x, surface_local.z) / radius + 1.0) * 0.5
        let centered = uv - vec2(0.5, 0.5)
        let cos_r = cos(alpha_rotation)
        let sin_r = sin(alpha_rotation)
        let rotated = vec2(
            centered.x * cos_r - centered.y * sin_r,
            centered.x * sin_r + centered.y * cos_r
        )
        let scaled = rotated / alpha_scale
        uv = scaled + vec2(0.5, 0.5) + alpha_offset
        if (alpha_mirror & 1 as UInt) != 0 as UInt:
            uv = vec2(1.0 - uv.x, uv.y)
        if (alpha_mirror & 2 as UInt) != 0 as UInt:
            uv = vec2(uv.x, 1.0 - uv.y)
        weight = weight * alpha_blend_weight
    
    // Apply pressure
    weight = weight * center.w
    
    // Scale pattern parameters
    let scale_size = max(extras0.x, 0.01)
    let scale_overlap = clamp(extras1.x, 0.0, 0.9)
    let scale_height = extras2.x
    let pattern_rotation = extras3.x
    
    // Project position onto surface plane
    let cos_rot = cos(pattern_rotation)
    let sin_rot = sin(pattern_rotation)
    let rotated_local = vec2(
        surface_local.x * cos_rot - surface_local.z * sin_rot,
        surface_local.x * sin_rot + surface_local.z * cos_rot
    )
    
    // Create hexagonal grid for scale placement
    let grid_scale = 1.0 / scale_size
    let grid_pos = rotated_local * grid_scale
    
    // Hexagonal grid coordinates
    let hex_x = grid_pos.x
    let hex_y = grid_pos.y * 1.1547  // sqrt(4/3) for hex spacing
    
    let row = floor(hex_y)
    let col = floor(hex_x + (row * 0.5))
    
    // Find nearest scale centers in hexagonal pattern
    let mut min_dist = 999.0
    let mut scale_value = 0.0
    
    // Check 7 neighboring cells
    let mut dy = -1.0
    while dy <= 1.0:
        let mut dx = -1.0
        while dx <= 1.0:
            let test_row = row + dy
            let test_col = col + dx
            
            // Hexagonal offset
            let offset_x = test_col - test_row * 0.5
            let offset_y = test_row / 1.1547
            
            let center_2d = vec2(offset_x, offset_y)
            let to_scale_center = grid_pos - center_2d
            let scale_dist = length(to_scale_center)
            
            // Create scale shape (circular with overlap)
            let scale_radius = 0.5 + scale_overlap
            if scale_dist < scale_radius:
                // Smooth falloff from center
                let scale_t = clamp(scale_dist / scale_radius, 0.0, 1.0)
                let scale_profile = 1.0 - scale_t * scale_t
                
                // Add variation based on position
                let hash_val = fract(sin(test_col * 12.9898 + test_row * 78.233 + random_seed) * 43758.5453)
                let height_variation = 0.8 + hash_val * 0.4
                
                let current_value = scale_profile * height_variation
                if current_value > scale_value:
                    scale_value = current_value
            
            dx = dx + 1.0
        dy = dy + 1.0
    
    // Apply scale displacement
    let displacement_amount = scale_value * scale_height * weight * strength
    let mut displacement = nor * displacement_amount
    
    // Subtract mode
    if (flags & FLAG_SUBTRACT) != 0 as UInt:
        displacement = -displacement
    
    let new_pos = pos + displacement
    positions[vertex_idx] = vec4(new_pos.x, new_pos.y, new_pos.z, 1.0)
    return vec4(new_pos.x, new_pos.y, new_pos.z, 1.0)
