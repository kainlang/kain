use std::actor
use kain_log::log_level_info
use kain_log::log_render_message

pub fn actor_server_ready_message(name: String) -> String:
    return log_render_message(log_level_info(), "actor-kit", "server " + name + " ready")

pub fn actor_start_counter(initial: Int) -> Any:
    return gen_server_start_link(
        initial,
        |request, state| gen_server_call_result(state + request, state + request),
        |request, state| state + request,
        |message, state| state + message
    )

pub fn actor_counter_call(server: Any, request: Int) -> Int:
    return gen_server_call(server, request)

pub fn actor_registry_lookup(name: String) -> Int:
    return native_actor_registry_lookup(name)

pub fn actor_registry_register(name: String, actor_id: Int) -> Int:
    return native_actor_registry_register(name, actor_id)

pub fn actor_registry_has(name: String) -> Bool:
    return native_actor_registry_has(name)

pub fn actor_scheduler_snapshot() -> Any:
    let snapshot = json_object_new()
    json_object_set(snapshot, "queueDepth", native_actor_scheduler_queue_depth())
    json_object_set(snapshot, "maxQueueDepth", native_actor_scheduler_max_queue_depth())
    json_object_set(snapshot, "workerCount", native_actor_scheduler_worker_count())
    json_object_set(snapshot, "activeWorkers", native_actor_scheduler_active_workers())
    json_object_set(snapshot, "busyWorkers", native_actor_scheduler_busy_workers())
    return snapshot
