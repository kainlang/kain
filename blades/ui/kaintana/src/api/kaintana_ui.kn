pub struct KaintanaUi:
    default_font_resource_id: Int

pub struct KaintanaPanelBuilder:
    label: StringView
    stable_key: StringView
    rect: KaintanaRect
    font_resource_id: Int
    baseline_y: Float

pub struct KaintanaLabelBuilder:
    text: StringView
    stable_key: StringView
    rect: KaintanaRect
    font_resource_id: Int
    baseline_y: Float
    muted: Bool

pub struct KaintanaButtonBuilder:
