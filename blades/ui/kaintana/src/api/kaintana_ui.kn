    let result = kaintana_widget_metric(ctx, builder.stable_key(), builder.label(), builder.value(), builder.rect(), builder.font_resource_id(), builder.baseline_y())
    defer kaintana_context_mark_command(result.ctx, result.native_node_id, KAINTANA_COMMAND_TEXT)
