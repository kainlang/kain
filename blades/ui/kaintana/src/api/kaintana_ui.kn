    font_resource_id: Int
    baseline_y: Float
    value: Float
    min_value: Float
    max_value: Float

pub trait KaintanaRenderable:
    fn bounds(_self: Self_) -> KaintanaRect

pub trait KaintanaUiCompatible:
    fn stable_key(_self: Self_) -> StringView
    fn label(_self: Self_) -> StringView
    fn rect(_self: Self_) -> KaintanaRect
    fn font_resource_id(_self: Self_) -> Int
    fn baseline_y(_self: Self_) -> Float
    fn value(_self: Self_) -> StringView:
        return _self.label()
    fn muted(_self: Self_) -> Bool:
        return false
    fn slider_value(_self: Self_) -> Float:
        return 0.0
    fn min_value(_self: Self_) -> Float:
        return 0.0
    fn max_value(_self: Self_) -> Float:
        return 1.0

impl KaintanaRenderable for KaintanaPanelBuilder:
    fn bounds(_self: Self_) -> KaintanaRect:
        return _self.rect

impl KaintanaUiCompatible for KaintanaPanelBuilder:
    fn stable_key(_self: Self_) -> StringView:
        return _self.stable_key
    fn label(_self: Self_) -> StringView:
