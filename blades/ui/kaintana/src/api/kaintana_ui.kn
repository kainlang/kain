    return KaintanaSliderBuilder { label: builder.label, stable_key: builder.stable_key, rect: rect, font_resource_id: builder.font_resource_id, baseline_y: builder.baseline_y, value: builder.value, min_value: builder.min_value, max_value: builder.max_value }

