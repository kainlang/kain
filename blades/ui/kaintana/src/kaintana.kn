pub fn kaintana_menu_open_below_node(session_id: Int, menu_id: Int, node_id: Int, offset_y: Float) -> Int:
    let open_x = ui_node_x(session_id, node_id)
    let open_y = ui_node_y(session_id, node_id) + ui_node_height(session_id, node_id) + offset_y
    return ui_menu_open(session_id, menu_id, open_x, open_y)

