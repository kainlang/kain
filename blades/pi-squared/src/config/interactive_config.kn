// ============================================================================
//  SGR HELPERS
// ============================================================================

pub fn sgr(code: String) -> String:
    return text_chr(27) + "[" + code + "m"

pub fn sgr_reset() -> String:
    return sgr("0")

pub fn wrap_sgr(text: String, color: String) -> String:
    return sgr(color) + text + sgr_reset()

