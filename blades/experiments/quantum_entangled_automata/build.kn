use std::build
use std::test
use std::proof
use std::bench
use std::attrition
use std::certify

fn build(ctx: BuildContext) -> BuildGraph:
    let pkg = package("quantum-entangled-automata")
        .version("0.1.0")
        .description("An insanely experimental quantum entangled cellular automata simulation.")

    let app = blade("quantum-entangled-automata")
        .entry("src/main.kn")
        .source_root("src")
        .module_root("src")
        .build_target("llvm")

    let defaults = build_defaults()
        .entry("src/main.kn")
        .artifact_root(".kain/out")
        .cache_root(".kain/cache/build")
        .profile("debug")
        .target("llvm")

    let run = run_defaults()
        .entry("src/main.kn")
        .target("llvm")

    let check = build_check("check-llvm")
        .entry("src/main.kn")
        .target("llvm")
        .input("src/main.kn")
        .input("build.kn")

    return build_graph()
        .package(pkg)
        .blade(app)
        .defaults(defaults)
        .run(run)
        .task(check)
