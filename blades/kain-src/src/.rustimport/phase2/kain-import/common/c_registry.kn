use kain_core::ast::BinaryOp

use kain_core::ast::Type

use kain_core::span::Span

use lang_c::ast as c_ast

pub enum KainTypeDescriptor:
    Unit
    Named(String)

const C_TYPE_NAME_ALIASES: Array<(String, KainTypeDescriptor)> = [("int", KainTypeDescriptor::Named("Int")), ("long", KainTypeDescriptor::Named("Int")), ("short", KainTypeDescriptor::Named("Int")), ("signed", KainTypeDescriptor::Named("Int")), ("unsigned", KainTypeDescriptor::Named("Int")), ("int8_t", KainTypeDescriptor::Named("Int")), ("int16_t", KainTypeDescriptor::Named("Int")), ("int32_t", KainTypeDescriptor::Named("Int")), ("int64_t", KainTypeDescriptor::Named("Int")), ("uint8_t", KainTypeDescriptor::Named("Int")), ("uint16_t", KainTypeDescriptor::Named("Int")), ("uint32_t", KainTypeDescriptor::Named("Int")), ("uint64_t", KainTypeDescriptor::Named("Int")), ("size_t", KainTypeDescriptor::Named("Int")), ("ptrdiff_t", KainTypeDescriptor::Named("Int")), ("float", KainTypeDescriptor::Named("Float")), ("double", KainTypeDescriptor::Named("Float")), ("char", KainTypeDescriptor::Named("Char")), ("bool", KainTypeDescriptor::Named("Bool")), ("_Bool", KainTypeDescriptor::Named("Bool")), ("void", KainTypeDescriptor__Unit)]

enum CBuiltinTypeSpecifier:
    Void
    Char
    Short
    Int
    Long
    Signed
    Unsigned
    Float
    Double
    Bool

const C_BUILTIN_TYPE_SPECIFIERS: Array<(CBuiltinTypeSpecifier, KainTypeDescriptor)> = [(CBuiltinTypeSpecifier__Void, KainTypeDescriptor__Unit), (CBuiltinTypeSpecifier__Char, KainTypeDescriptor::Named("Char")), (CBuiltinTypeSpecifier__Short, KainTypeDescriptor::Named("Int")), (CBuiltinTypeSpecifier__Int, KainTypeDescriptor::Named("Int")), (CBuiltinTypeSpecifier__Long, KainTypeDescriptor::Named("Int")), (CBuiltinTypeSpecifier__Signed, KainTypeDescriptor::Named("Int")), (CBuiltinTypeSpecifier__Unsigned, KainTypeDescriptor::Named("Int")), (CBuiltinTypeSpecifier__Float, KainTypeDescriptor::Named("Float")), (CBuiltinTypeSpecifier__Double, KainTypeDescriptor::Named("Float")), (CBuiltinTypeSpecifier__Bool, KainTypeDescriptor::Named("Bool"))]

pub enum CBinaryOperatorResolution:
    Supported(kain_core::ast::BinaryOp)
    UnsupportedAssignment
    Unsupported

enum CBinaryOperatorKey:
    Plus
    Minus
    Multiply
    Divide
    Modulo
    Equals
    NotEquals
    Less
    Greater
    LessOrEqual
    GreaterOrEqual
    LogicalAnd
    LogicalOr
    BitwiseAnd
    BitwiseOr
    BitwiseXor
    ShiftLeft
    ShiftRight
    Assign
    AssignPlus
    AssignMinus
    AssignMultiply
    AssignDivide
    AssignModulo
    AssignShiftLeft
    AssignShiftRight
    AssignBitwiseAnd
    AssignBitwiseOr
    AssignBitwiseXor

const C_BINARY_OPERATOR_MAPPINGS: Array<(CBinaryOperatorKey, kain_core::ast::BinaryOp)> = [(CBinaryOperatorKey__Plus, kain_core__ast__BinaryOp__Add), (CBinaryOperatorKey__Minus, kain_core__ast__BinaryOp__Sub), (CBinaryOperatorKey__Multiply, kain_core__ast__BinaryOp__Mul), (CBinaryOperatorKey__Divide, kain_core__ast__BinaryOp__Div), (CBinaryOperatorKey__Modulo, kain_core__ast__BinaryOp__Mod), (CBinaryOperatorKey__Equals, kain_core__ast__BinaryOp__Eq), (CBinaryOperatorKey__NotEquals, kain_core__ast__BinaryOp__Ne), (CBinaryOperatorKey__Less, kain_core__ast__BinaryOp__Lt), (CBinaryOperatorKey__Greater, kain_core__ast__BinaryOp__Gt), (CBinaryOperatorKey__LessOrEqual, kain_core__ast__BinaryOp__Le), (CBinaryOperatorKey__GreaterOrEqual, kain_core__ast__BinaryOp__Ge), (CBinaryOperatorKey__LogicalAnd, kain_core__ast__BinaryOp__And), (CBinaryOperatorKey__LogicalOr, kain_core__ast__BinaryOp__Or), (CBinaryOperatorKey__BitwiseAnd, kain_core__ast__BinaryOp__BitAnd), (CBinaryOperatorKey__BitwiseOr, kain_core__ast__BinaryOp__BitOr), (CBinaryOperatorKey__BitwiseXor, kain_core__ast__BinaryOp__BitXor), (CBinaryOperatorKey__ShiftLeft, kain_core__ast__BinaryOp__Shl), (CBinaryOperatorKey__ShiftRight, kain_core__ast__BinaryOp__Shr), (CBinaryOperatorKey__Assign, kain_core__ast__BinaryOp__Assign), (CBinaryOperatorKey__AssignPlus, kain_core__ast__BinaryOp__AddAssign), (CBinaryOperatorKey__AssignMinus, kain_core__ast__BinaryOp__SubAssign), (CBinaryOperatorKey__AssignMultiply, kain_core__ast__BinaryOp__MulAssign), (CBinaryOperatorKey__AssignDivide, kain_core__ast__BinaryOp__DivAssign)]

const C_UNSUPPORTED_ASSIGNMENT_OPERATORS: Array<CBinaryOperatorKey> = [CBinaryOperatorKey__AssignModulo, CBinaryOperatorKey__AssignShiftLeft, CBinaryOperatorKey__AssignShiftRight, CBinaryOperatorKey__AssignBitwiseAnd, CBinaryOperatorKey__AssignBitwiseOr, CBinaryOperatorKey__AssignBitwiseXor]

const C_COMPOUND_ASSIGNMENT_BINARY_MAPPINGS: Array<(CBinaryOperatorKey, kain_core::ast::BinaryOp)> = [(CBinaryOperatorKey__AssignPlus, kain_core__ast__BinaryOp__Add), (CBinaryOperatorKey__AssignMinus, kain_core__ast__BinaryOp__Sub), (CBinaryOperatorKey__AssignMultiply, kain_core__ast__BinaryOp__Mul), (CBinaryOperatorKey__AssignDivide, kain_core__ast__BinaryOp__Div), (CBinaryOperatorKey__AssignModulo, kain_core__ast__BinaryOp__Mod), (CBinaryOperatorKey__AssignShiftLeft, kain_core__ast__BinaryOp__Shl), (CBinaryOperatorKey__AssignShiftRight, kain_core__ast__BinaryOp__Shr), (CBinaryOperatorKey__AssignBitwiseAnd, kain_core__ast__BinaryOp__BitAnd), (CBinaryOperatorKey__AssignBitwiseOr, kain_core__ast__BinaryOp__BitOr), (CBinaryOperatorKey__AssignBitwiseXor, kain_core__ast__BinaryOp__BitXor)]

pub fn c_type_name_aliases() -> &static [(String, KainTypeDescriptor)]:
    C_TYPE_NAME_ALIASES

pub fn materialize_type_descriptor(descriptor: KainTypeDescriptor) -> kain_core::ast::Type:
    match descriptor:
        KainTypeDescriptor::Unit => kain_core__ast__Type::Unit(Span__default_())
        KainTypeDescriptor::Named(name) => named_type(name)

pub fn named_type(name: String) -> kain_core::ast::Type:
    kain_core__ast__Type::Named { name: name.to_string(), generics: Vec__new_(), span: Span__default_() }

pub fn map_c_builtin_type_specifier(spec: &lang_c::ast::TypeSpecifier) -> Option<kain_core::ast::Type>:
    let key = match spec:
        lang_c__ast__TypeSpecifier::Void => CBuiltinTypeSpecifier__Void
        lang_c__ast__TypeSpecifier::Char => CBuiltinTypeSpecifier__Char
        lang_c__ast__TypeSpecifier::Short => CBuiltinTypeSpecifier__Short
        lang_c__ast__TypeSpecifier::Int => CBuiltinTypeSpecifier__Int
        lang_c__ast__TypeSpecifier::Long => CBuiltinTypeSpecifier__Long
        lang_c__ast__TypeSpecifier::Signed => CBuiltinTypeSpecifier__Signed
        lang_c__ast__TypeSpecifier::Unsigned => CBuiltinTypeSpecifier__Unsigned
        lang_c__ast__TypeSpecifier::Float => CBuiltinTypeSpecifier__Float
        lang_c__ast__TypeSpecifier::Double => CBuiltinTypeSpecifier__Double
        lang_c__ast__TypeSpecifier::Bool => CBuiltinTypeSpecifier__Bool
        _ => return none
    C_BUILTIN_TYPE_SPECIFIERS.iter().find_map(fn(__kain_closure_arg0): if ((*__kain_closure_arg0.__kain_tuple_0) == key): Option::Some(materialize_type_descriptor((*__kain_closure_arg0.__kain_tuple_1))) else: none)

pub fn resolve_c_binary_operator(op: &lang_c::ast::BinaryOperator) -> CBinaryOperatorResolution:
    let Some(key) = c_binary_operator_key(op)
    if C_UNSUPPORTED_ASSIGNMENT_OPERATORS.contains(&key):
        return CBinaryOperatorResolution__UnsupportedAssignment
    match C_BINARY_OPERATOR_MAPPINGS.iter().find_map(fn(__kain_closure_arg1): if ((*__kain_closure_arg1.__kain_tuple_0) == key): Option::Some((*__kain_closure_arg1.__kain_tuple_1)) else: none):
        Some(mapped) => CBinaryOperatorResolution::Supported(mapped)
        None => CBinaryOperatorResolution__Unsupported

pub fn resolve_c_compound_assignment_binary_operator(op: &lang_c::ast::BinaryOperator) -> Option<kain_core::ast::BinaryOp>:
    let key = c_binary_operator_key(op)?
    C_COMPOUND_ASSIGNMENT_BINARY_MAPPINGS.iter().find_map(fn(__kain_closure_arg2): if ((*__kain_closure_arg2.__kain_tuple_0) == key): Option::Some((*__kain_closure_arg2.__kain_tuple_1)) else: none)

fn c_binary_operator_key(op: &lang_c::ast::BinaryOperator) -> Option<CBinaryOperatorKey>:
    let key = match op:
        lang_c__ast__BinaryOperator::Plus => CBinaryOperatorKey__Plus
        lang_c__ast__BinaryOperator::Minus => CBinaryOperatorKey__Minus
        lang_c__ast__BinaryOperator::Multiply => CBinaryOperatorKey__Multiply
        lang_c__ast__BinaryOperator::Divide => CBinaryOperatorKey__Divide
        lang_c__ast__BinaryOperator::Modulo => CBinaryOperatorKey__Modulo
        lang_c__ast__BinaryOperator::Equals => CBinaryOperatorKey__Equals
        lang_c__ast__BinaryOperator::NotEquals => CBinaryOperatorKey__NotEquals
        lang_c__ast__BinaryOperator::Less => CBinaryOperatorKey__Less
        lang_c__ast__BinaryOperator::Greater => CBinaryOperatorKey__Greater
        lang_c__ast__BinaryOperator::LessOrEqual => CBinaryOperatorKey__LessOrEqual
        lang_c__ast__BinaryOperator::GreaterOrEqual => CBinaryOperatorKey__GreaterOrEqual
        lang_c__ast__BinaryOperator::LogicalAnd => CBinaryOperatorKey__LogicalAnd
        lang_c__ast__BinaryOperator::LogicalOr => CBinaryOperatorKey__LogicalOr
        lang_c__ast__BinaryOperator::BitwiseAnd => CBinaryOperatorKey__BitwiseAnd
        lang_c__ast__BinaryOperator::BitwiseOr => CBinaryOperatorKey__BitwiseOr
        lang_c__ast__BinaryOperator::BitwiseXor => CBinaryOperatorKey__BitwiseXor
        lang_c__ast__BinaryOperator::ShiftLeft => CBinaryOperatorKey__ShiftLeft
        lang_c__ast__BinaryOperator::ShiftRight => CBinaryOperatorKey__ShiftRight
        lang_c__ast__BinaryOperator::Assign => CBinaryOperatorKey__Assign
        lang_c__ast__BinaryOperator::AssignPlus => CBinaryOperatorKey__AssignPlus
        lang_c__ast__BinaryOperator::AssignMinus => CBinaryOperatorKey__AssignMinus
        lang_c__ast__BinaryOperator::AssignMultiply => CBinaryOperatorKey__AssignMultiply
        lang_c__ast__BinaryOperator::AssignDivide => CBinaryOperatorKey__AssignDivide
        lang_c__ast__BinaryOperator::AssignModulo => CBinaryOperatorKey__AssignModulo
        lang_c__ast__BinaryOperator::AssignShiftLeft => CBinaryOperatorKey__AssignShiftLeft
        lang_c__ast__BinaryOperator::AssignShiftRight => CBinaryOperatorKey__AssignShiftRight
        lang_c__ast__BinaryOperator::AssignBitwiseAnd => CBinaryOperatorKey__AssignBitwiseAnd
        lang_c__ast__BinaryOperator::AssignBitwiseOr => CBinaryOperatorKey__AssignBitwiseOr
        lang_c__ast__BinaryOperator::AssignBitwiseXor => CBinaryOperatorKey__AssignBitwiseXor
        lang_c__ast__BinaryOperator::Index => return none
    Option::Some(key)

