use crate::error::KainResult

use std::fs

use std::path::Path

use ue5_materials::MaterialFactoryGenerator

use ue5_materials::MaterialGraph

@doc(doc = " Generate material factory files for runtime material creation.")
@doc(doc = " Creates MaterialFactories.h/cpp in `private_dir/Generated/`.")
@doc(doc = "")
@doc(doc = " `private_dir` is the plugin's Source/<Module>/Private directory as")
@doc(doc = " computed by PluginLayout — callers should pass `layout.private_dir`.")
@cfg(feature = "ue5")
pub fn generate_material_factories(plugin_name: String, graphs: &[ue5_materials::MaterialGraph], private_dir: &std::path::Path) -> Result<(), KainError>:
    if graphs.is_empty():
        return Result::Ok(())
    let generator = MaterialFactoryGenerator__new_(plugin_name.to_string())
    let generated_dir = private_dir.join("Generated")
    std__fs__create_dir_all(&generated_dir)?
    ()
    let header = generator.generate_factory_header(graphs)
    std__fs__write(generated_dir.join("MaterialFactories.h"), header)?
    ()
    let cpp = generator.generate_factory_cpp(graphs)
    std__fs__write(generated_dir.join("MaterialFactories.cpp"), cpp)?
    ()
    println(f"✓ Generated material factories for {graphs.len()} materials")
    Result::Ok(())

@doc(doc = " Stub implementation when ue5 feature is disabled")
@cfg(not(feature = "ue5"))
pub fn generate_material_factories(_plugin_name: String, _graphs: &[()], _private_dir: &std::path::Path) -> Result<(), KainError>:
    Result::Ok(())

