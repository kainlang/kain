                            on_execute = Option::Some(func_def)
                            ()
                        "on_add" =>
                            on_add = Option::Some(func_def)
                            ()
                        "on_remove" =>
                            on_remove = Option::Some(func_def)
                            ()
                        "while_active" =>
                            while_active = Option::Some(func_def)
                            ()
                        _ => ()
                    ()
                "on_add" =>
