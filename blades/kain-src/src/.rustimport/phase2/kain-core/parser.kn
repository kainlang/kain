                    let func_def = Function { name: field_name.clone(), generics: [], params: params, return_type: none, effects: [], body: Block { stmts: body_stmts, span: (*_self).current_span() }, visibility: Visibility__Private, attributes: [], span: (*_self).current_span() }
                    match field_name.as_str():
