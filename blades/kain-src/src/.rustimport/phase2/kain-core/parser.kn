    fn parse_ability_task(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut delegates: Array<TaskDelegateDef> = Vec__new_()
        let mut state_fields: Array<Field> = Vec__new_()
        let mut activate_method: Option<Function> = none
        let mut on_destroy_method: Option<Function> = none
        let mut custom_methods: Array<Function> = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            if (*_self).check(TokenKind__At):
                let attr_start = (*_self).current_span()
                (*_self).advance()
                ()
                match (*_self).peek_kind():
                    TokenKind::Ident(attr_name) =>
                        if (attr_name == "delegate"):
                            (*_self).advance()
                            ()
                            (*_self).skip_newlines()
                            ()
                            let delegate_name = (*_self).parse_ident()?
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            let delegate_type = (*_self).parse_ident()?
                            delegates.push(TaskDelegateDef { name: delegate_name, delegate_type: delegate_type, span: attr_start.merge((*_self).current_span()) })
                            ()
                            (*_self).skip_newlines()
                            ()
                            continue
                        ()
                    _ =>
                        ()
                        ()
                ()
            match (*_self).peek_kind():
                TokenKind::Ident(keyword) =>
                    if (keyword == "state"):
                        (*_self).advance()
                        ()
                        let field_name = (*_self).parse_ident()?
                        (*_self).expect(TokenKind__Colon)?
                        ()
                        let field_type = (*_self).parse_type()?
                        let default_ = if (*_self).check(TokenKind__Eq):
                            (*_self).advance()
                            ()
                            Option::Some((*_self).parse_expr()?)
                        else:
                            none
                        state_fields.push(Field { name: field_name, ty: field_type, attributes: [], visibility: Visibility__Private, default_: default_, weak_: false, span: (*_self).current_span() })
                        ()
                        (*_self).skip_newlines()
                        ()
                        continue
                    ()
                _ =>
                    ()
                    ()
            if (*_self).check(TokenKind__Fn):
                (*_self).advance()
                ()
                let method_name = (*_self).parse_ident()?
                let params = if (*_self).check(TokenKind__LParen):
                    (*_self).advance()
                    ()
                    let mut params = Vec__new_()
                    while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
                        let param_name = (*_self).parse_ident()?
                        (*_self).expect(TokenKind__Colon)?
                        ()
                        let param_type = (*_self).parse_type()?
                        params.push(Param { name: param_name, ty: param_type, mutable_: false, default_: none, span: (*_self).current_span() })
                        ()
                        if (*_self).check(TokenKind__Comma):
                            (*_self).advance()
                            ()
                    ()
                    (*_self).expect(TokenKind__RParen)?
                    ()
                    params
                else:
                    []
                (*_self).expect(TokenKind__Colon)?
                ()
                (*_self).skip_newlines()
                ()
                (*_self).expect(TokenKind__Indent)?
                ()
                let mut body_stmts = Vec__new_()
                while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
                    (*_self).skip_newlines()
                    ()
                    if (*_self).check(TokenKind__Dedent):
                        break
                    body_stmts.push((*_self).parse_stmt()?)
                    ()
                ()
                (*_self).expect(TokenKind__Dedent)?
                ()
                let func_def = Function { name: method_name.clone(), generics: [], params: params, return_type: none, effects: [], body: Block { stmts: body_stmts, span: (*_self).current_span() }, visibility: Visibility__Private, attributes: [], span: (*_self).current_span() }
                match method_name.as_str():
                    "activate" =>
                        activate_method = Option::Some(func_def)
                        ()
                    "on_destroy" =>
                        on_destroy_method = Option::Some(func_def)
                        ()
                    _ =>
                        custom_methods.push(func_def)
                        ()
                (*_self).skip_newlines()
                ()
                continue
            return Result::Err((*_self).parser_error(f"Unexpected token in ability task: {error__token_kind_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))
        ()
        (*_self).expect(TokenKind__Dedent)?
        ()
        Result::Ok(Item::AbilityTask(AbilityTaskDef { name: name, attributes: attributes, delegates: delegates, state_fields: state_fields, activate_method: activate_method, on_destroy_method: on_destroy_method, custom_methods: custom_methods, span: start.merge((*_self).current_span()) }))

    fn parse_target_actor(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut trace_type = TraceType__default_()
        let mut max_range: Option<f64> = none
        let mut trace_channel: Option<String> = none
        let mut filter: Option<TargetFilter> = none
        let mut reticle_class: Option<String> = none
        let mut custom_methods: Array<Function> = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            match (*_self).peek_kind():
                TokenKind::Ident(field_name) =>
                    (*_self).advance()
                    ()
                    (*_self).expect(TokenKind__Colon)?
                    ()
                    match field_name.as_str():
                        "trace_type" =>
                            match (*_self).peek_kind():
                                TokenKind::String(type_str) =>
                                    trace_type = none
                                    ()
                                    (*_self).advance()
                                    ()
                                    ()
                                    ()
                                    ()
                                _ => return Result::Err((*_self).parser_error("Expected string for trace_type", (*_self).current_span()))
                            ()
                        "max_range" =>
                            match (*_self).peek_kind():
                                TokenKind::Float(val) =>
                                    max_range = Option::Some(val)
                                    ()
                                    (*_self).advance()
                                    ()
                                    ()
                                    ()
                                    ()
                                _ =>
                                    match (*_self).peek_kind():
                                        TokenKind::Int(val) =>
                                            max_range = Option::Some(val as f64)
                                            ()
                                            (*_self).advance()
                                            ()
                                            ()
                                            ()
                                            ()
                                        _ => return Result::Err((*_self).parser_error("Expected number for max_range", (*_self).current_span()))
                            ()
                        "trace_channel" =>
                            match (*_self).peek_kind():
                                TokenKind::String(channel) =>
                                    trace_channel = Option::Some(channel)
                                    ()
                                    (*_self).advance()
                                    ()
                                    ()
                                    ()
                                    ()
                                _ => return Result::Err((*_self).parser_error("Expected string for trace_channel", (*_self).current_span()))
                            ()
                        "reticle_class" =>
                            match (*_self).peek_kind():
                                TokenKind::String(class_) =>
                                    reticle_class = Option::Some(class_)
                                    ()
                                    (*_self).advance()
                                    ()
                                    ()
                                    ()
                                    ()
                                _ => return Result::Err((*_self).parser_error("Expected string for reticle_class", (*_self).current_span()))
                            ()
                        "filter" =>
                            (*_self).skip_newlines()
                            ()
                            (*_self).expect(TokenKind__Indent)?
                            ()
                            let mut self_filter: Option<String> = none
                            let mut required_actor_class: Option<String> = none
                            let mut require_tags: Array<String> = Vec__new_()
                            let mut ignore_tags: Array<String> = Vec__new_()
                            let mut custom_filter_method: Option<Function> = none
                            while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
                                (*_self).skip_newlines()
                                ()
                                if (*_self).check(TokenKind__Dedent):
                                    break
                                match (*_self).peek_kind():
                                    TokenKind::Ident(filter_field) =>
                                        (*_self).advance()
                                        ()
                                        (*_self).expect(TokenKind__Colon)?
                                        ()
                                        match filter_field.as_str():
                                            "self_filter" =>
                                                match (*_self).peek_kind():
                                                    TokenKind::String(val) =>
                                                        self_filter = Option::Some(val)
                                                        ()
                                                        (*_self).advance()
                                                        ()
                                                        ()
                                                        ()
                                                        ()
                                                    _ =>
                                                        ()
                                                        ()
                                                ()
                                            "required_actor_class" =>
                                                match (*_self).peek_kind():
                                                    TokenKind::String(val) =>
                                                        required_actor_class = Option::Some(val)
                                                        ()
                                                        (*_self).advance()
                                                        ()
                                                        ()
                                                        ()
                                                        ()
                                                    _ =>
                                                        ()
                                                        ()
                                                ()
                                            "require_tags" =>
                                                require_tags = (*_self).parse_string_array()?
                                                ()
                                                ()
                                                ()
                                                ()
                                            "ignore_tags" =>
                                                ignore_tags = (*_self).parse_string_array()?
                                                ()
                                                ()
                                                ()
                                                ()
                                            _ => return Result::Err((*_self).parser_error(f"Unknown filter field: {filter_field}", (*_self).current_span()))
                                        ()
                                    _ =>
                                        if (*_self).check(TokenKind__Fn):
                                            (*_self).advance()
                                            ()
                                            let method_name = (*_self).parse_ident()?
                                            let params = if (*_self).check(TokenKind__LParen):
                                                (*_self).advance()
                                                ()
                                                let mut params = Vec__new_()
                                                while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
                                                    let param_name = (*_self).parse_ident()?
                                                    (*_self).expect(TokenKind__Colon)?
                                                    ()
                                                    let param_type = (*_self).parse_type()?
                                                    params.push(Param { name: param_name, ty: param_type, mutable_: false, default_: none, span: (*_self).current_span() })
                                                    ()
                                                    if (*_self).check(TokenKind__Comma):
                                                        (*_self).advance()
                                                        ()
                                                ()
                                                (*_self).expect(TokenKind__RParen)?
                                                ()
                                                params
                                            else:
                                                []
                                            (*_self).expect(TokenKind__Colon)?
                                            ()
                                            (*_self).skip_newlines()
                                            ()
                                            (*_self).expect(TokenKind__Indent)?
                                            ()
                                            let mut body_stmts = Vec__new_()
                                            while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
                                                (*_self).skip_newlines()
                                                ()
                                                if (*_self).check(TokenKind__Dedent):
                                                    break
                                                body_stmts.push((*_self).parse_stmt()?)
                                                ()
                                            ()
                                            (*_self).expect(TokenKind__Dedent)?
                                            ()
                                            custom_filter_method = Option::Some(Function { name: method_name, generics: [], params: params, return_type: none, effects: [], body: Block { stmts: body_stmts, span: (*_self).current_span() }, visibility: Visibility__Private, attributes: [], span: (*_self).current_span() })
                                            ()
                                            ()
                                            ()
                                            ()
                                (*_self).skip_newlines()
                                ()
                            ()
                            (*_self).expect(TokenKind__Dedent)?
                            ()
                            filter = Option::Some(TargetFilter { self_filter: self_filter, required_actor_class: required_actor_class, require_tags: require_tags, ignore_tags: ignore_tags, custom_filter_method: custom_filter_method, span: (*_self).current_span() })
                            ()
                            ()
                            ()
                            ()
                        _ => return Result::Err((*_self).parser_error(f"Unknown target actor field: {field_name}", (*_self).current_span()))
                    ()
                _ =>
                    if (*_self).check(TokenKind__Fn):
                        (*_self).advance()
                        ()
                        let method_name = (*_self).parse_ident()?
                        let params = if (*_self).check(TokenKind__LParen):
                            (*_self).advance()
                            ()
                            let mut params = Vec__new_()
                            while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
                                let param_name = (*_self).parse_ident()?
                                (*_self).expect(TokenKind__Colon)?
                                ()
                                let param_type = (*_self).parse_type()?
                                params.push(Param { name: param_name, ty: param_type, mutable_: false, default_: none, span: (*_self).current_span() })
                                ()
                                if (*_self).check(TokenKind__Comma):
                                    (*_self).advance()
                                    ()
                            ()
                            (*_self).expect(TokenKind__RParen)?
                            ()
                            params
                        else:
                            []
                        (*_self).expect(TokenKind__Colon)?
                        ()
                        (*_self).skip_newlines()
                        ()
                        (*_self).expect(TokenKind__Indent)?
                        ()
                        let mut body_stmts = Vec__new_()
                        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
                            (*_self).skip_newlines()
                            ()
                            if (*_self).check(TokenKind__Dedent):
                                break
                            body_stmts.push((*_self).parse_stmt()?)
                            ()
                        ()
                        (*_self).expect(TokenKind__Dedent)?
                        ()
                        custom_methods.push(Function { name: method_name, generics: [], params: params, return_type: none, effects: [], body: Block { stmts: body_stmts, span: (*_self).current_span() }, visibility: Visibility__Private, attributes: [], span: (*_self).current_span() })
                        ()
                        ()
                        ()
                        ()
                    else:
                        return Result::Err((*_self).parser_error("Expected field name or fn", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        (*_self).expect(TokenKind__Dedent)?
        ()
        Result::Ok(Item::TargetActor(TargetActorDef { name: name, attributes: attributes, trace_type: trace_type, max_range: max_range, trace_channel: trace_channel, filter: filter, reticle_class: reticle_class, custom_methods: custom_methods, span: start.merge((*_self).current_span()) }))


