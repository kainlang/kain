                    (*_self).expect(TokenKind__Colon)?
                    ()
                    let field_type = (*_self).parse_type()?
                    state_fields.push(Field { name: state_field_name, ty: field_type, attributes: [], visibility: Visibility__Private, default_: none, weak_: false, span: (*_self).current_span() })
                    ()
                    ()
                    ()
                    ()
