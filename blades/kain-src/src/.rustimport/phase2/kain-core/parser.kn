use crate::ast::*

use crate::diagnostics::SpanMapper

use crate::effects::Effect

use crate::error::KainError

use crate::error::KainResult

use crate::language_features::default_language_capabilities

use crate::language_features::LanguageCapabilities

use crate::lexer::Lexer

use crate::lexer::Token

use crate::lexer::TokenKind

use crate::span::Span

const MAX_ERRORS: usize = 50

pub const RESERVED_KEYWORDS: Array<String> = ["fn", "let", "mut", "var", "const", "if", "else", "elif", "match", "for", "while", "loop", "break", "continue", "return", "await", "in", "with", "as", "type", "struct", "enum", "trait", "impl", "pub", "mod", "use", "self", "Self", "true", "false", "none", "component", "actor", "spawn", "send", "receive", "emit", "comptime", "macro", "vertex", "fragment", "test", "Pure", "IO", "async", "Async", "GPU", "Reactive", "Unsafe", "line", "compile", "pass", "technique", "register", "packoffset", "typedef", "sampler", "row_major", "column_major", "out", "inout", "inline", "cbuffer", "tbuffer", "uniform", "precise", "volatile", "extern", "shared", "groupshared", "half", "min16float", "min10float", "min16int", "min12int", "min16uint", "interface", "namespace", "static", "void", "bool", "int", "uint", "float", "double", "float2", "float3", "float4", "int2", "int3", "int4", "uint2", "uint3", "uint4", "float2x2", "float3x3", "float4x4", "matrix", "numthreads", "SV_Position", "SV_Target", "SV_DispatchThreadID", "SV_GroupID", "SV_GroupThreadID", "class", "virtual", "override", "final", "explicit", "operator", "template", "typename", "private", "protected", "public", "friend", "this", "new", "delete", "nullptr", "try", "catch", "throw", "noexcept", "constexpr", "decltype", "auto", "signed", "unsigned", "short", "long", "char", "wchar_t", "char16_t", "char32_t", "sizeof", "alignof", "alignas", "typeid", "dynamic_cast", "static_cast", "reinterpret_cast", "const_cast", "goto", "switch", "case", "default", "do", "volatile", "mutable", "register", "union", "asm", "export", "thread_local", "static_assert", "UCLASS", "USTRUCT", "UENUM", "UFUNCTION", "UPROPERTY", "UPARAM", "UMETA", "GENERATED_BODY", "GENERATED_USTRUCT_BODY", "GENERATED_UCLASS_BODY", "UINTERFACE", "RIGVM_METHOD", "FORCEINLINE", "FORCENOINLINE", "TEXT", "LOCTEXT", "NSLOCTEXT", "TEXTVIEW"]

fn parse_orchestrate_stage_runtime(name: String) -> Option<OrchestrateStageRuntime>:
    match name:
        "kain" => Option::Some(OrchestrateStageRuntime__Kain)
        "rust" => Option::Some(OrchestrateStageRuntime__Rust)
        "python" => Option::Some(OrchestrateStageRuntime__Python)
        "node" => Option::Some(OrchestrateStageRuntime__Node)
        _ => none

pub struct Parser<a>:
    tokens: &a [Token]
    pos: usize
    injected_tokens: Array<Token>
    span_mapper: &a SpanMapper
    filename: String
    capabilities: LanguageCapabilities
    errors: Array<KainError>
    synthetic_counter: usize

impl<a> Parser<a>:
    pub fn new_(tokens: &a [Token], span_mapper: &a SpanMapper, filename: String) -> Parser<a>:
        Parser__with_capabilities(tokens, span_mapper, filename, language_features__default_language_capabilities())

    pub fn with_capabilities(tokens: &a [Token], span_mapper: &a SpanMapper, filename: String, capabilities: LanguageCapabilities) -> Parser<a>:
        Parser { tokens: tokens, pos: 0, injected_tokens: Vec__new_(), span_mapper: span_mapper, filename: filename, capabilities: capabilities, errors: Vec__new_(), synthetic_counter: 0 }

    fn parser_error(_self: &Parser<a>, message: impl Into<String>, span: Span) -> KainError:
        let loc = (*_self).span_mapper.span_to_location(span, (*_self).filename)
        let formatted_message = f"{loc.file}:{loc.line_}:{loc.col}: {message.into()}"
        KainError__parser(formatted_message, span)

    fn token_to_user_string(_self: &Parser<a>, kind: &TokenKind) -> String:
        match kind:
            TokenKind::Ident(s) => f"identifier '{s}'"
            TokenKind::Int(n) => f"integer {n}"
            TokenKind::Float(f) => f"float {f}"
            TokenKind::String(s) => f"string \"{s}\""
            TokenKind::Fn => ("keyword 'fn'").to_string()
            TokenKind::Let => ("keyword 'let'").to_string()
            TokenKind::Struct => ("keyword 'struct'").to_string()
            TokenKind::Enum => ("keyword 'enum'").to_string()
            TokenKind::Actor => ("keyword 'actor'").to_string()
            TokenKind::Component => ("keyword 'component'").to_string()
            TokenKind::Shader => ("keyword 'shader'").to_string()
            TokenKind::If => ("keyword 'if'").to_string()
            TokenKind::Else => ("keyword 'else'").to_string()
            TokenKind::Match => ("keyword 'match'").to_string()
            TokenKind::Return => ("keyword 'return'").to_string()
            TokenKind::Colon => ("':'").to_string()
            TokenKind::Arrow => ("'->'").to_string()
            TokenKind::Eq => ("'='").to_string()
            TokenKind::LParen => ("'('").to_string()
            TokenKind::RParen => ("')'").to_string()
            TokenKind::LBrace => ("'{'").to_string()
            TokenKind::RBrace => ("'}'").to_string()
            TokenKind::LBracket => ("'['").to_string()
            TokenKind::RBracket => ("']'").to_string()
            TokenKind::Comma => ("','").to_string()
            TokenKind::Dot => ("'.'").to_string()
            TokenKind::At => ("'@'").to_string()
            TokenKind::Indent => ("indentation").to_string()
            TokenKind::Dedent => ("dedentation").to_string()
            TokenKind::Newline(_) => ("newline").to_string()
            TokenKind::Eof => ("end of file").to_string()
            _ => kind

    fn expected_tokens_list(_self: &Parser<a>, expected: &[String]) -> String:
        match expected.len():
            0 => ("something else").to_string()
            1 => expected[0].to_string()
            2 => f"{expected[0]} or {expected[1]}"
            _ =>
                let last = expected.last().unwrap()
                let rest = &expected[..(expected.len() - 1)]
                "{rest.join(\", \")}, or {last}"

    fn validate_identifier(_self: &Parser<a>, name: String, span: Span) -> Result<(), KainError>:
        if RESERVED_KEYWORDS.contains(&name):
            return Result::Err((*_self).parser_error(f"Identifier '{name}' conflicts with reserved keyword. Please choose a different name.\nReserved keywords include KAIN keywords (fn, let, struct, etc.), HLSL keywords (cbuffer, register, etc.), C++ keywords (class, virtual, etc.), and UE5 macros (UCLASS, UPROPERTY, etc.)", span))
        Result::Ok(())

    pub fn parse(_self: &mut Parser<a>) -> Result<Program, KainError>:
        let mut items = Vec__new_()
        let mut top_level_stmts = Vec__new_()
        let start = (*_self).current_span()
        while (!(*_self).at_end()):
            if ((*_self).errors.len() >= MAX_ERRORS):
                break
            (*_self).skip_newlines()
            ()
            if (*_self).at_end():
                break
            match (*_self).peek_kind():
                TokenKind::Pub =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::At =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Fn =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::AsyncKw =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Component =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Shader =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Actor =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Struct =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Enum =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::TypeKw =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Trait =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Impl =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Use =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Mod =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Const =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Comptime =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Macro =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Test =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                TokenKind::Ident(name) if Parser__is_contextual_item_start_name(name.as_str()) =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_item():
                        Ok(item) => items.push(item)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
                _ =>
                    let before_pos = (*_self).pos
                    match (*_self).parse_stmt():
                        Ok(stmt) => top_level_stmts.push(stmt)
                        Err(e) =>
                            (*_self).errors.push(e)
                            ()
                            (*_self).synchronize()
                            ()
                            if (((*_self).pos == before_pos) && (!(*_self).at_end())):
                                (*_self).advance()
                                ()
        ()
        if (!top_level_stmts.is_empty()):
            let main_fn = Item::Function(Function { name: ("main").to_string(), generics: [], params: [], return_type: none, effects: [], body: Block { stmts: top_level_stmts, span: start.merge((*_self).current_span()) }, visibility: Visibility__Public, attributes: [], span: start.merge((*_self).current_span()) })
            items.push(main_fn)
            ()
            ()
            ()
            ()
        if (!(*_self).errors.is_empty()):
            return Result::Err(KainError__multi(std__mem__take(&mut (*_self).errors)))
        let end = (*_self).current_span()
        Result::Ok(Program { items: items, span: start.merge(end) })

    fn synchronize(_self: &mut Parser<a>):
        let mut depth: i32 = 0
        while (!(*_self).at_end()):
            match (*_self).peek_kind():
                TokenKind::Indent =>
                    depth = (depth + 1)
                    ()
                    (*_self).advance()
                    ()
                TokenKind::Dedent =>
                    depth = (depth - 1)
                    ()
                    (*_self).advance()
                    ()
                    if (depth <= 0):
                        (*_self).skip_newlines()
                        ()
                        if ((*_self).is_item_start() || (*_self).at_end()):
                            return
                TokenKind::Newline(_) =>
                    (*_self).advance()
                    ()
                    if (depth <= 0):
                        if ((*_self).is_item_start() || (*_self).at_end()):
                            return
                _ =>
                    if ((depth <= 0) && (*_self).is_item_start()):
                        return
                    (*_self).advance()
                    ()

    fn is_item_start(_self: &Parser<a>) -> Bool:
        match (*_self).peek_kind():
            TokenKind::At => true
            TokenKind::Fn => true
            TokenKind::Struct => true
            TokenKind::Enum => true
            TokenKind::Actor => true
            TokenKind::Component => true
            TokenKind::Shader => true
            TokenKind::Pub => true
            TokenKind::Const => true
            TokenKind::Mod => true
            TokenKind::Use => true
            TokenKind::Impl => true
            TokenKind::Macro => true
            TokenKind::Test => true
            TokenKind::AsyncKw => true
            TokenKind::TypeKw => true
            TokenKind::Trait => true
            TokenKind::Comptime => true
            TokenKind::Ident(name) => Parser__is_contextual_item_start_name(name.as_str())
            _ => false

    fn is_contextual_item_start_name(name: String) -> Bool:
        match name:
            "patch" => true
            "law" => true
            "converge" => true
            "world" => true
            "orchestrate" => true
            _ => false

    fn parse_path_name(_self: &mut Parser<a>) -> Result<String, KainError>:
        let mut name = (*_self).parse_ident()?
        while (*_self).check(TokenKind__ColonColon):
            (*_self).advance()
            ()
            let part = (*_self).parse_ident()?
            name.push_str("::")
            ()
            name.push_str(&part)
            ()
        ()
        Result::Ok(name)

    fn parse_path_segments_after(_self: &mut Parser<a>, first: String) -> Result<Array<String>, KainError>:
        let mut segments = [first]
        while (*_self).check(TokenKind__ColonColon):
            (*_self).advance()
            ()
            segments.push((*_self).parse_ident()?)
            ()
        ()
        Result::Ok(segments)

    fn join_path_segments(segments: &[String]) -> String:
        segments.join("::")

    fn path_segment_looks_like_type_name(segment: String) -> Bool:
        (segment.contains("__") || segment.chars().next().is_some_and(fn(ch): ch.is_ascii_uppercase()))

    fn path_looks_like_enum_variant(segments: &[String]) -> Bool:
        if (segments.len() < 2):
            return false
        let variant = &segments[(segments.len() - 1)]
        let enum_head = &segments[(segments.len() - 2)]
        (Parser__path_segment_looks_like_type_name(variant) && Parser__path_segment_looks_like_type_name(enum_head))

    fn parse_variant_pattern_fields(_self: &mut Parser<a>) -> Result<VariantPatternFields, KainError>:
        if (*_self).check(TokenKind__LParen):
            (*_self).advance()
            ()
            let mut patterns = Vec__new_()
            while (!(*_self).check(TokenKind__RParen)):
                patterns.push((*_self).parse_pattern()?)
                ()
                if (!(*_self).check(TokenKind__RParen)):
                    (*_self).expect(TokenKind__Comma)?
                    ()
            ()
            (*_self).expect(TokenKind__RParen)?
            ()
            Result::Ok(VariantPatternFields::Tuple(patterns))
        elif (*_self).check(TokenKind__LBrace):
            (*_self).advance()
            ()
            let mut fields = Vec__new_()
            while (!(*_self).check(TokenKind__RBrace)):
                let fname = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                let pat = (*_self).parse_pattern()?
                fields.push((fname, pat))
                ()
                if (!(*_self).check(TokenKind__RBrace)):
                    (*_self).expect(TokenKind__Comma)?
                    ()
            ()
            (*_self).expect(TokenKind__RBrace)?
            ()
            Result::Ok(VariantPatternFields::Struct(fields))
        else:
            Result::Ok(VariantPatternFields__Unit)

    fn parse_enum_variant_fields(_self: &mut Parser<a>) -> Result<EnumVariantFields, KainError>:
        if (*_self).check(TokenKind__LParen):
            (*_self).advance()
            ()
            (*_self).skip_newlines()
            ()
            let mut items = Vec__new_()
            if (!(*_self).check(TokenKind__RParen)):
                items.push((*_self).parse_expr()?)
                ()
                while (*_self).check(TokenKind__Comma):
                    (*_self).advance()
                    ()
                    if (*_self).check(TokenKind__RParen):
                        break
                    items.push((*_self).parse_expr()?)
                    ()
                ()
                ()
            (*_self).expect(TokenKind__RParen)?
            ()
            if items.is_empty():
                Result::Ok(EnumVariantFields__Unit)
            else:
                Result::Ok(EnumVariantFields::Tuple(items))
        elif (*_self).check(TokenKind__LBrace):
            (*_self).advance()
            ()
            let mut fields = Vec__new_()
            (*_self).skip_newlines()
            ()
            let indented = if (*_self).check(TokenKind__Indent):
                (*_self).advance()
                ()
                true
            else:
                false
            while ((!(*_self).check(TokenKind__RBrace)) && (!(*_self).at_end())):
                if (indented && (*_self).check(TokenKind__Dedent)):
                    break
                let field_name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                let field_value = (*_self).parse_expr()?
                fields.push((field_name, field_value))
                ()
                if ((!(*_self).check(TokenKind__RBrace)) && (((!indented) || (!(*_self).check(TokenKind__Dedent))))):
                    if (*_self).check(TokenKind__Comma):
                        (*_self).advance()
                        ()
                        ()
                        ()
                        ()
                    ()
                (*_self).skip_newlines()
                ()
            ()
            if indented:
                (*_self).expect(TokenKind__Dedent)?
                ()
                ()
                ()
                ()
            (*_self).expect(TokenKind__RBrace)?
            ()
            Result::Ok(EnumVariantFields::Struct(fields))
        else:
            Result::Ok(EnumVariantFields__Unit)

    fn parse_item(_self: &mut Parser<a>) -> Result<Item, KainError>:
        let attributes = (*_self).parse_attributes()?
        if attributes.iter().any(fn(a): (a.name == "material_graph")):
            return (*_self).parse_material_graph(attributes)
        if attributes.iter().any(fn(a): (a.name == "material_function")):
            return (*_self).parse_material_function(attributes)
        if attributes.iter().any(fn(a): (a.name == "graph_editor")):
            return (*_self).parse_graph_editor(attributes)
        if attributes.iter().any(fn(a): (a.name == "graph_runtime")):
            return (*_self).parse_graph_runtime(attributes)
        if attributes.iter().any(fn(a): (a.name == "state_machine")):
            return (*_self).parse_state_machine(attributes)
        if attributes.iter().any(fn(a): (a.name == "editor_module")):
            return (*_self).parse_editor_module(attributes)
        if attributes.iter().any(fn(a): (a.name == "gameplay_tags")):
            return (*_self).parse_gameplay_tags(attributes)
        if attributes.iter().any(fn(a): (a.name == "ability")):
            return (*_self).parse_gameplay_ability(attributes)
        if attributes.iter().any(fn(a): (a.name == "gameplay_effect")):
            return (*_self).parse_gameplay_effect(attributes)
        if attributes.iter().any(fn(a): (a.name == "gameplay_cue")):
            return (*_self).parse_gameplay_cue(attributes)
        if attributes.iter().any(fn(a): (a.name == "ability_task")):
            return (*_self).parse_ability_task(attributes)
        if attributes.iter().any(fn(a): (a.name == "target_actor")):
            return (*_self).parse_target_actor(attributes)
        let vis = (*_self).parse_visibility()
        match (*_self).peek_kind():
            TokenKind::Fn => (*_self).parse_function_with_attrs(vis, attributes)
            TokenKind::AsyncKw => (*_self).parse_async_function(vis)
            TokenKind::Component => (*_self).parse_component_with_attrs(vis, attributes)
            TokenKind::Shader => (*_self).parse_shader()
            TokenKind::Struct => (*_self).parse_struct_with_attrs(vis, attributes)
            TokenKind::Enum => (*_self).parse_enum(vis)
            TokenKind::Actor => (*_self).parse_actor_with_attrs(attributes)
            TokenKind::Const => (*_self).parse_const(vis)
            TokenKind::Comptime => (*_self).parse_comptime_block()
            TokenKind::Macro => (*_self).parse_macro()
            TokenKind::Test => (*_self).parse_test()
            TokenKind::Mod => (*_self).parse_mod(vis)
            TokenKind::Use => (*_self).parse_use()
            TokenKind::Trait => (*_self).parse_trait(vis)
            TokenKind::Impl => (*_self).parse_impl()
            TokenKind::TypeKw => (*_self).parse_type_alias(vis)
            TokenKind::Ident(name) if (name == "patch") => (*_self).parse_patch(vis, attributes)
            TokenKind::Ident(name) if (name == "law") => (*_self).parse_law(vis, attributes)
            TokenKind::Ident(name) if (name == "converge") => (*_self).parse_converge(vis, attributes)
            TokenKind::Ident(name) if (name == "world") => (*_self).parse_world(vis, attributes)
            TokenKind::Ident(name) if (name == "orchestrate") => (*_self).parse_orchestrate(vis, attributes)
            _ => Result::Err((*_self).parser_error(f"Expected item (fn, patch, law, converge, world, orchestrate, struct, enum, actor, component, shader, material, trait, impl, mod, use, const, test), found {(*_self).token_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))

    fn parse_mod(_self: &mut Parser<a>, vis: Visibility) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Mod)?
        ()
        let name = (*_self).parse_ident()?
        let inline_ = if (*_self).check(TokenKind__Colon):
            (*_self).advance()
            ()
            (*_self).skip_newlines()
            ()
            if (!(*_self).check(TokenKind__Indent)):
                Option::Some([])
            else:
                (*_self).expect(TokenKind__Indent)?
                ()
                let mut items = Vec__new_()
                while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
                    (*_self).skip_newlines()
                    ()
                    if (*_self).check(TokenKind__Dedent):
                        break
                    items.push((*_self).parse_item()?)
                    ()
                    (*_self).skip_newlines()
                    ()
                ()
                (*_self).expect(TokenKind__Dedent)?
                ()
                Option::Some(items)
        else:
            none
        Result::Ok(Item::Mod(Mod { name: name, inline_: inline_, visibility: vis, span: start.merge((*_self).current_span()) }))

    fn parse_attributes(_self: &mut Parser<a>) -> Result<Array<Attribute>, KainError>:
        let mut attrs = Vec__new_()
        while (*_self).check(TokenKind__At):
            let start = (*_self).current_span()
            (*_self).advance()
            ()
            let name = (*_self).parse_attribute_name()?
            let args = if (*_self).check(TokenKind__LParen):
                (*_self).advance()
                ()
                let mut arg_list = Vec__new_()
                while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
                    match (*_self).peek_kind():
                        TokenKind::Ident(param_name) =>
                            let saved_pos = (*_self).pos
                            (*_self).advance()
                            ()
                            if (*_self).check(TokenKind__Colon):
                                (*_self).advance()
                                ()
                                let value = (*_self).parse_expr()?
                                let name_expr = Expr::Ident(param_name.clone(), (*_self).current_span())
                                arg_list.push(Expr::Tuple([name_expr, value], (*_self).current_span()))
                                ()
                                ()
                                ()
                                ()
                            else:
                                (*_self).pos = saved_pos
                                ()
                                arg_list.push((*_self).parse_expr()?)
                                ()
                                ()
                                ()
                                ()
                            ()
                        _ =>
                            arg_list.push((*_self).parse_expr()?)
                            ()
                            ()
                            ()
                            ()
                    if (!(*_self).check(TokenKind__RParen)):
                        (*_self).expect(TokenKind__Comma)?
                        ()
                ()
                (*_self).expect(TokenKind__RParen)?
                ()
                arg_list
            else:
                []
            attrs.push(Attribute { name: name, args: args, span: start.merge((*_self).current_span()) })
            ()
            (*_self).skip_newlines()
            ()
        ()
        Result::Ok(attrs)

    fn parse_attribute_name(_self: &mut Parser<a>) -> Result<String, KainError>:
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                (*_self).advance()
                ()
                Result::Ok(s)
            TokenKind::Component =>
                (*_self).advance()
                ()
                Result::Ok(("component").to_string())
            TokenKind::Shader =>
                (*_self).advance()
                ()
                Result::Ok(("shader").to_string())
            TokenKind::Actor =>
                (*_self).advance()
                ()
                Result::Ok(("actor").to_string())
            TokenKind::State =>
                (*_self).advance()
                ()
                Result::Ok(("state").to_string())
            TokenKind::AsyncKw =>
                (*_self).advance()
                ()
                Result::Ok(("async").to_string())
            TokenKind::Async_ =>
                (*_self).advance()
                ()
                Result::Ok(("Async").to_string())
            TokenKind::Gpu =>
                (*_self).advance()
                ()
                Result::Ok(("GPU").to_string())
            TokenKind::Reactive_ =>
                (*_self).advance()
                ()
                Result::Ok(("Reactive").to_string())
            k => Result::Err((*_self).parser_error(f"Expected attribute name, got {error__token_kind_to_user_string(&k)}", (*_self).current_span()))

    fn parse_trait(_self: &mut Parser<a>, vis: Visibility) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Trait)?
        ()
        let name = (*_self).parse_ident()?
        let generics = (*_self).parse_generics()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut methods = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            (*_self).expect(TokenKind__Fn)?
            ()
            let method_name = (*_self).parse_ident()?
            (*_self).expect(TokenKind__LParen)?
            ()
            let params = (*_self).parse_params()?
            (*_self).expect(TokenKind__RParen)?
            ()
            let return_type = if (*_self).check(TokenKind__Arrow):
                (*_self).advance()
                ()
                Option::Some((*_self).parse_type()?)
            else:
                none
            let effects = (*_self).parse_effects()?
            let default_impl = if (*_self).check(TokenKind__Colon):
                (*_self).advance()
                ()
                Option::Some((*_self).parse_block()?)
            else:
                none
            methods.push(TraitMethod { name: method_name, params: params, return_type: return_type, effects: effects, default_impl: default_impl, span: (*_self).current_span() })
            ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::Trait(Trait { name: name, generics: generics, supertraits: Vec__new_(), methods: methods, visibility: vis, span: start.merge((*_self).current_span()) }))

    fn parse_impl(_self: &mut Parser<a>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Impl)?
        ()
        let generics = (*_self).parse_generics()?
        let first_type = (*_self).parse_type()?
        let (trait_name, trait_generics, target_type) = if (*_self).check(TokenKind__For):
            (*_self).advance()
            ()
            let (trait_name, trait_generics) = match first_type:
                Type::Named { name: name, generics: generics } => (name, generics)
                other => return Result::Err((*_self).parser_error(f"Expected trait path before 'for' in impl block, found {other}", other.span()))
            let target_type = (*_self).parse_type()?
            (Option::Some(trait_name), trait_generics, target_type)
        else:
            (none, Vec__new_(), first_type)
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut methods = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let vis = (*_self).parse_visibility()
            if (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function(vis)?):
                    Item::Function(f) =>
                        methods.push(f)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                return Result::Err((*_self).parser_error(f"Expected 'fn' in impl block (impl blocks can only contain function definitions), found {(*_self).token_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::Impl(Impl { generics: generics, trait_name: trait_name, trait_generics: trait_generics, target_type: target_type, methods: methods, span: start.merge((*_self).current_span()) }))

    fn parse_use(_self: &mut Parser<a>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Use)?
        ()
        let mut path = Vec__new_()
        path.push((*_self).parse_ident()?)
        ()
        while ((*_self).check(TokenKind__ColonColon) || (*_self).check(TokenKind__Slash)):
            (*_self).advance()
            ()
            if (*_self).check(TokenKind__Star):
                (*_self).advance()
                ()
                return Result::Ok(Item::Use(Use { path: path, alias: none, glob: true, span: start.merge((*_self).current_span()) }))
            path.push((*_self).parse_ident()?)
            ()
        ()
        let alias = if (*_self).check(TokenKind__As):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_ident()?)
        else:
            none
        Result::Ok(Item::Use(Use { path: path, alias: alias, glob: false, span: start.merge((*_self).current_span()) }))

    fn parse_test(_self: &mut Parser<a>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Test)?
        ()
        let name = match (*_self).peek_kind():
            TokenKind::String(s) =>
                (*_self).advance()
                ()
                s
            _ => (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        Result::Ok(Item::Test(TestDef { name: name, body: body, span: start.merge((*_self).current_span()) }))

    fn parse_macro(_self: &mut Parser<a>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Macro)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Not)?
        ()
        (*_self).expect(TokenKind__LParen)?
        ()
        let mut params = Vec__new_()
        while (!(*_self).check(TokenKind__RParen)):
            let p_name = (*_self).parse_ident()?
            (*_self).expect(TokenKind__Colon)?
            ()
            let kind_name = (*_self).parse_ident()?
            let kind = match kind_name.as_str():
                "expr" => MacroParamKind__Expr
                "type" => MacroParamKind__Type
                "ident" => MacroParamKind__Ident
                "block" => MacroParamKind__Block
                "token" => MacroParamKind__Token
                _ => return Result::Err((*_self).parser_error("Unknown macro param kind", (*_self).current_span()))
            params.push(MacroParam { name: p_name, kind: kind, span: (*_self).current_span() })
            ()
            if (!(*_self).check(TokenKind__RParen)):
                (*_self).expect(TokenKind__Comma)?
                ()
        ()
        (*_self).expect(TokenKind__RParen)?
        ()
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        Result::Ok(Item::Macro(MacroDef { name: name, params: params, body: MacroBody::Block(body), span: start.merge((*_self).current_span()) }))

    fn parse_function(_self: &mut Parser<a>, vis: Visibility) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Fn)?
        ()
        let name = (*_self).parse_ident()?
        let generics = (*_self).parse_generics()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let params = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        let return_type = if (*_self).check(TokenKind__Arrow):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_type()?)
        else:
            none
        let effects = (*_self).parse_effects()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        let body_span = body.span
        Result::Ok(Item::Function(Function { name: name, generics: generics, params: params, return_type: return_type, effects: effects, body: body, visibility: vis, attributes: [], span: start.merge(body_span) }))

    fn parse_function_with_attrs(_self: &mut Parser<a>, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Fn)?
        ()
        let name = (*_self).parse_ident()?
        let generics = (*_self).parse_generics()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let params = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        let return_type = if (*_self).check(TokenKind__Arrow):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_type()?)
        else:
            none
        let effects = (*_self).parse_effects()?
        let is_extern = attrs.iter().any(fn(a): (a.name == "extern"))
        let body = if (is_extern && (!(*_self).check(TokenKind__Colon))):
            Block { stmts: [], span: (*_self).current_span() }
        else:
            (*_self).expect(TokenKind__Colon)?
            ()
            (*_self).parse_block()?
        let body_span = body.span
        Result::Ok(Item::Function(Function { name: name, generics: generics, params: params, return_type: return_type, effects: effects, body: body, visibility: vis, attributes: attrs, span: start.merge(body_span) }))

    fn parse_async_function(_self: &mut Parser<a>, vis: Visibility) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__AsyncKw)?
        ()
        (*_self).expect(TokenKind__Fn)?
        ()
        let name = (*_self).parse_ident()?
        let generics = (*_self).parse_generics()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let params = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        let return_type = if (*_self).check(TokenKind__Arrow):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_type()?)
        else:
            none
        let mut effects = (*_self).parse_effects()?
        effects.push(effects__Effect__Async_)
        ()
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        let body_span = body.span
        Result::Ok(Item::Function(Function { name: name, generics: generics, params: params, return_type: return_type, effects: effects, body: body, visibility: vis, attributes: [], span: start.merge(body_span) }))

    fn parse_patch(_self: &mut Parser<a>, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect_contextual_ident("patch")?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let params = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        let return_type = if (*_self).check(TokenKind__Arrow):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_type()?)
        else:
            none
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        let body_span = body.span
        Result::Ok(Item::Patch(PatchDef { name: name, params: params, return_type: return_type, body: body, visibility: vis, attributes: attrs, span: start.merge(body_span) }))

    fn parse_law(_self: &mut Parser<a>, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect_contextual_ident("law")?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let params = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        (*_self).expect(TokenKind__Arrow)?
        ()
        let return_type = (*_self).parse_type()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        Result::Ok(Item::Law(LawDef { name: name, params: params, return_type: return_type, body: body, visibility: vis, attributes: attrs, span: start.merge((*_self).current_span()) }))

    fn parse_orchestrate(_self: &mut Parser<a>, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect_contextual_ident("orchestrate")?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let params = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        let return_type = if (*_self).check(TokenKind__Arrow):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_type()?)
        else:
            none
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        let body_span = body.span
        Result::Ok(Item::Orchestrate(OrchestrateDef { name: name, params: params, return_type: return_type, body: body, visibility: vis, attributes: attrs, span: start.merge(body_span) }))

    fn parse_converge(_self: &mut Parser<a>, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect_contextual_ident("converge")?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let params = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        let return_type = if (*_self).check(TokenKind__Arrow):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_type()?)
        else:
            none
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut spec_lane = none
        let mut fast_lanes = Vec__new_()
        let mut verify_random_count = none
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            match (*_self).peek_kind():
                TokenKind::Ident(name) if (name == "spec") =>
                    if spec_lane.is_some():
                        return Result::Err((*_self).parser_error("converge blocks may only declare one spec lane", (*_self).current_span()))
                    spec_lane = Option::Some((*_self).parse_converge_lane(ConvergeLaneKind__Spec)?)
                    ()
                    ()
                    ()
                    ()
                TokenKind::Ident(name) if (name == "fast") =>
                    fast_lanes.push((*_self).parse_converge_lane(ConvergeLaneKind__Fast)?)
                    ()
                    ()
                    ()
                    ()
                TokenKind::Ident(name) if (name == "verify") =>
                    verify_random_count = Option::Some((*_self).parse_converge_verify_random_count()?)
                    ()
                    ()
                    ()
                    ()
                _ => return Result::Err((*_self).parser_error("Expected 'spec', 'fast', or 'verify' inside converge block", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        (*_self).expect(TokenKind__Dedent)?
        ()
        let spec_lane = spec_lane.ok_or_else(fn(): (*_self).parser_error("converge blocks require exactly one spec lane", start.merge((*_self).current_span())))?
        if fast_lanes.is_empty():
            return Result::Err((*_self).parser_error("converge blocks require at least one fast lane", start.merge((*_self).current_span())))
        Result::Ok(Item::Converge(ConvergeDef { name: name, params: params, return_type: return_type, spec_lane: spec_lane, fast_lanes: fast_lanes, verify_random_count: verify_random_count, visibility: vis, attributes: attrs, span: start.merge((*_self).current_span()) }))

    fn parse_world(_self: &mut Parser<a>, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect_contextual_ident("world")?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut states = Vec__new_()
        let mut surfaces = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            match (*_self).peek_kind():
                TokenKind::State =>
                    states.push((*_self).parse_world_state_slot()?)
                    ()
                    ()
                    ()
                    ()
                TokenKind::Ident(entry) if (entry == "surface") =>
                    surfaces.push((*_self).parse_world_surface_projection()?)
                    ()
                    ()
                    ()
                    ()
                _ => return Result::Err((*_self).parser_error("Expected 'state' or 'surface' inside world block", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        (*_self).expect(TokenKind__Dedent)?
        ()
        Result::Ok(Item::World(WorldDef { name: name, states: states, surfaces: surfaces, visibility: vis, attributes: attrs, span: start.merge((*_self).current_span()) }))

    fn parse_converge_lane(_self: &mut Parser<a>, kind: ConvergeLaneKind) -> Result<ConvergeLane, KainError>:
        let start = (*_self).current_span()
        match kind:
            ConvergeLaneKind::Spec =>
                (*_self).expect_contextual_ident("spec")?
                ()
            ConvergeLaneKind::Fast =>
                (*_self).expect_contextual_ident("fast")?
                ()
        let lane_name = (*_self).parse_ident()?
        let selector = if (*_self).peek_contextual_ident("when"):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_converge_selector()?)
        else:
            none
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        Result::Ok(ConvergeLane { kind: kind, lane_name: lane_name, selector: selector, span: start.merge(body.span), body: body })

    fn parse_converge_selector(_self: &mut Parser<a>) -> Result<ConvergeSelector, KainError>:
        if (*_self).peek_contextual_ident("target"):
            (*_self).advance()
            ()
            (*_self).expect(TokenKind__LParen)?
            ()
            let value = (*_self).parse_string_like_argument("target selector")?
            (*_self).expect(TokenKind__RParen)?
            ()
            Result::Ok(ConvergeSelector::Target(value))
        elif (*_self).peek_contextual_ident("capability"):
            (*_self).advance()
            ()
            (*_self).expect(TokenKind__LParen)?
            ()
            let value = (*_self).parse_string_like_argument("capability selector")?
            (*_self).expect(TokenKind__RParen)?
            ()
            Result::Ok(ConvergeSelector::Capability(value))
        else:
            Result::Err((*_self).parser_error("Expected converge selector 'target(\"...\")' or 'capability(\"...\")'", (*_self).current_span()))

    fn parse_converge_verify_random_count(_self: &mut Parser<a>) -> Result<u32, KainError>:
        (*_self).expect_contextual_ident("verify")?
        ()
        (*_self).expect_contextual_ident("random")?
        ()
        (*_self).expect(TokenKind__LParen)?
        ()
        let count = match (*_self).peek_kind():
            TokenKind::Int(value) if (value >= 0) =>
                (*_self).advance()
                ()
                value as u32
            _ => return Result::Err((*_self).parser_error("verify random(...) expects a non-negative integer sample count", (*_self).current_span()))
        (*_self).expect(TokenKind__RParen)?
        ()
        Result::Ok(count)

    fn parse_world_state_slot(_self: &mut Parser<a>) -> Result<WorldStateSlot, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__State)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let ty = (*_self).parse_type()?
        (*_self).expect(TokenKind__Eq)?
        ()
        let initial = (*_self).parse_expr()?
        Result::Ok(WorldStateSlot { name: name, ty: ty, initial: initial, span: start.merge((*_self).current_span()) })

    fn parse_world_surface_projection(_self: &mut Parser<a>) -> Result<WorldSurfaceProjection, KainError>:
        let start = (*_self).current_span()
        (*_self).expect_contextual_ident("surface")?
        ()
        let kind = match (*_self).peek_kind():
            TokenKind::Ident(value) if (value == "native_ui") =>
                (*_self).advance()
                ()
                WorldSurfaceKind__NativeUi
            TokenKind::Ident(value) if (value == "viewport3d") =>
                (*_self).advance()
                ()
                WorldSurfaceKind__Viewport3d
            TokenKind::Ident(value) if (value == "web") =>
                (*_self).advance()
                ()
                WorldSurfaceKind__Web
            TokenKind::Ident(value) if (value == "ue5") =>
                (*_self).advance()
                ()
                WorldSurfaceKind__Ue5
            _ => return Result::Err((*_self).parser_error("Expected world surface kind native_ui, viewport3d, web, or ue5", (*_self).current_span()))
        (*_self).expect(TokenKind__FatArrow)?
        ()
        let expr = (*_self).parse_expr()?
        Result::Ok(WorldSurfaceProjection { kind: kind, expr: expr, span: start.merge((*_self).current_span()) })

    fn parse_string_like_argument(_self: &mut Parser<a>, label: String) -> Result<String, KainError>:
        match (*_self).peek_kind():
            TokenKind::String(value) =>
                let value = value.clone()
                (*_self).advance()
                ()
                Result::Ok(value)
            TokenKind::Ident(value) =>
                let value = value.clone()
                (*_self).advance()
                ()
                Result::Ok(value)
            _ => Result::Err((*_self).parser_error(f"{label} expects a string or identifier", (*_self).current_span()))

    fn parse_component(_self: &mut Parser<a>, vis: Visibility) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Component)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let props = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        let effects = (*_self).parse_effects()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut state_ = Vec__new_()
        let mut methods = Vec__new_()
        let mut body = none
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            if (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function(Visibility__Private)?):
                    Item::Function(f) =>
                        methods.push(f)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            elif (*_self).check(TokenKind__State):
                (*_self).advance()
                ()
                let name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                let ty = (*_self).parse_type()?
                (*_self).expect(TokenKind__Eq)?
                ()
                let initial = (*_self).parse_expr()?
                state_.push(StateDecl { name: name, ty: ty, initial: initial, weak_: false, attributes: [], span: (*_self).current_span() })
                ()
                ()
                ()
                ()
            else:
                match (*_self).peek_kind():
                    TokenKind::Ident(s) =>
                        if (s == "state"):
                            (*_self).advance()
                            ()
                            let name = (*_self).parse_ident()?
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            let ty = (*_self).parse_type()?
                            (*_self).expect(TokenKind__Eq)?
                            ()
                            let initial = (*_self).parse_expr()?
                            state_.push(StateDecl { name: name, ty: ty, initial: initial, weak_: false, attributes: [], span: (*_self).current_span() })
                            ()
                            ()
                            ()
                            ()
                        elif (s == "weak"):
                            (*_self).advance()
                            ()
                            if ((*_self).check(TokenKind__State) || (*_self).check(TokenKind::Ident(("state").to_string()))):
                                (*_self).advance()
                                ()
                                let name = (*_self).parse_ident()?
                                (*_self).expect(TokenKind__Colon)?
                                ()
                                let ty = (*_self).parse_type()?
                                (*_self).expect(TokenKind__Eq)?
                                ()
                                let initial = (*_self).parse_expr()?
                                state_.push(StateDecl { name: name, ty: ty, initial: initial, weak_: true, attributes: [], span: (*_self).current_span() })
                                ()
                                ()
                                ()
                                ()
                            else:
                                return Result::Err((*_self).parser_error(f"Expected 'state' keyword after 'weak' in component (use 'weak state name: Type = value'), found {(*_self).token_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))
                            ()
                        elif (s == "render"):
                            (*_self).advance()
                            ()
                            if (*_self).check(TokenKind__LBrace):
                                (*_self).advance()
                                ()
                                (*_self).skip_newlines()
                                ()
                                body = Option::Some((*_self).parse_jsx_element()?)
                                ()
                                (*_self).skip_newlines()
                                ()
                                (*_self).expect(TokenKind__RBrace)?
                                ()
                                ()
                                ()
                                ()
                            elif (*_self).check(TokenKind__Colon):
                                (*_self).advance()
                                ()
                                (*_self).skip_newlines()
                                ()
                                (*_self).expect(TokenKind__Indent)?
                                ()
                                (*_self).skip_newlines()
                                ()
                                body = Option::Some((*_self).parse_jsx_element()?)
                                ()
                                (*_self).skip_newlines()
                                ()
                                (*_self).expect(TokenKind__Dedent)?
                                ()
                                ()
                                ()
                                ()
                            else:
                                body = Option::Some((*_self).parse_jsx_element()?)
                                ()
                                ()
                                ()
                                ()
                            ()
                        else:
                            return Result::Err((*_self).parser_error(f"Unexpected identifier '{s}' in component. Valid keywords: 'state', 'weak', 'render', or 'fn' for methods", (*_self).current_span()))
                        ()
                    _ =>
                        if (*_self).check(TokenKind__Lt):
                            body = Option::Some((*_self).parse_jsx_element()?)
                            ()
                            ()
                            ()
                            ()
                        else:
                            return Result::Err((*_self).parser_error(f"Unexpected token in component: {error__token_kind_to_user_string(&(*_self).peek_kind())}. Expected 'state', 'weak', 'render', 'fn', or JSX element", (*_self).current_span()))
                ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        let body = body.ok_or_else(fn(): (*_self).parser_error("Component must have a render body (JSX element)", (*_self).current_span()))?
        Result::Ok(Item::Component(Component { name: name, props: props, state_: state_, methods: methods, effects: effects, body: body, visibility: vis, attributes: [], span: start.merge((*_self).current_span()) }))

    fn parse_component_with_attrs(_self: &mut Parser<a>, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Component)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let props = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        let effects = (*_self).parse_effects()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut state_ = Vec__new_()
        let mut methods = Vec__new_()
        let mut body = none
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            if (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function(Visibility__Private)?):
                    Item::Function(f) =>
                        methods.push(f)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                match (*_self).peek_kind():
                    TokenKind::Ident(s) =>
                        if (s == "state"):
                            (*_self).advance()
                            ()
                            let name = (*_self).parse_ident()?
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            let ty = (*_self).parse_type()?
                            (*_self).expect(TokenKind__Eq)?
                            ()
                            let initial = (*_self).parse_expr()?
                            state_.push(StateDecl { name: name, ty: ty, initial: initial, weak_: false, attributes: [], span: (*_self).current_span() })
                            ()
                            ()
                            ()
                            ()
                        elif (s == "render"):
                            (*_self).advance()
                            ()
                            if (*_self).check(TokenKind__Colon):
                                (*_self).advance()
                                ()
                                (*_self).skip_newlines()
                                ()
                                (*_self).expect(TokenKind__Indent)?
                                ()
                                (*_self).skip_newlines()
                                ()
                                body = Option::Some((*_self).parse_jsx_element()?)
                                ()
                                (*_self).skip_newlines()
                                ()
                                (*_self).expect(TokenKind__Dedent)?
                                ()
                                ()
                                ()
                                ()
                            else:
                                body = Option::Some((*_self).parse_jsx_element()?)
                                ()
                                ()
                                ()
                                ()
                            ()
                        else:
                            return Result::Err((*_self).parser_error(f"Unexpected identifier in component: {s}", (*_self).current_span()))
                        ()
                    _ =>
                        if (*_self).check(TokenKind__State):
                            (*_self).advance()
                            ()
                            let name = (*_self).parse_ident()?
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            let ty = (*_self).parse_type()?
                            (*_self).expect(TokenKind__Eq)?
                            ()
                            let initial = (*_self).parse_expr()?
                            state_.push(StateDecl { name: name, ty: ty, initial: initial, weak_: false, attributes: [], span: (*_self).current_span() })
                            ()
                            ()
                            ()
                            ()
                        elif (*_self).check(TokenKind__Lt):
                            body = Option::Some((*_self).parse_jsx_element()?)
                            ()
                            ()
                            ()
                            ()
                        else:
                            return Result::Err((*_self).parser_error(f"Unexpected token in component: {error__token_kind_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))
                ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        let body = body.ok_or_else(fn(): (*_self).parser_error("Component must have a render body", (*_self).current_span()))?
        Result::Ok(Item::Component(Component { name: name, props: props, state_: state_, methods: methods, effects: effects, body: body, visibility: vis, attributes: attrs, span: start.merge((*_self).current_span()) }))

    fn parse_shader(_self: &mut Parser<a>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Shader)?
        ()
        let stage = if (*_self).check(TokenKind__Vertex):
            (*_self).advance()
            ()
            ShaderStage__Vertex
        elif (*_self).check(TokenKind__Fragment):
            (*_self).advance()
            ()
            ShaderStage__Fragment
        else:
            match (*_self).peek_kind():
                TokenKind::Ident(s) =>
                    if (s == "compute"):
                        (*_self).advance()
                        ()
                        ShaderStage__Compute
                    else:
                        ShaderStage__Fragment
                _ => ShaderStage__Fragment
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let inputs = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        (*_self).expect(TokenKind__Arrow)?
        ()
        let outputs = (*_self).parse_type()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        let block_start = (*_self).current_span()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut uniforms = Vec__new_()
        let mut stmts = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let is_uniform = match (*_self).peek_kind():
                TokenKind::Ident(s) => (s == "uniform")
                _ => false
            if is_uniform:
                (*_self).advance()
                ()
                let u_name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                let u_ty = (*_self).parse_type()?
                (*_self).expect(TokenKind__At)?
                ()
                let binding = match (*_self).peek_kind():
                    TokenKind::Int(n) =>
                        (*_self).advance()
                        ()
                        n as u32
                    _ => return Result::Err((*_self).parser_error(f"Expected integer binding after '@' (e.g., '@0', '@1', '@2'), found {(*_self).token_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))
                uniforms.push(Uniform { name: u_name, ty: u_ty, binding: binding, span: (*_self).current_span() })
                ()
                ()
                ()
                ()
            else:
                stmts.push((*_self).parse_stmt()?)
                ()
                ()
                ()
                ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        let body = Block { stmts: stmts, span: block_start.merge((*_self).current_span()) }
        let body_span = body.span
        let shader_ = Shader { name: name, stage: stage, inputs: inputs, outputs: outputs, uniforms: uniforms, body: body, span: start.merge(body_span) }
        if (none):
            match shader_.explicit_compute_metadata():
                Err(err) => return Result::Err((*_self).parser_error(f"Invalid explicit compute metadata in shader '{shader_.name}': {err}", shader_.span))
                _ =>
                    ()
                    ()
            ()
        Result::Ok(Item::Shader(shader_))

    fn parse_struct_with_attrs(_self: &mut Parser<a>, vis: Visibility, attrs: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let name = (*_self).parse_ident()?
        let generics = (*_self).parse_generics()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        let mut fields = Vec__new_()
        let mut methods = Vec__new_()
        if (!(*_self).check(TokenKind__Indent)):
            return Result::Ok(Item::Struct(Struct { name: name, generics: generics, fields: fields, methods: methods, attributes: attrs, visibility: vis, span: start.merge((*_self).current_span()) }))
        (*_self).expect(TokenKind__Indent)?
        ()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let f_attrs = (*_self).parse_attributes()?
            if (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function(Visibility__Public)?):
                    Item::Function(f) =>
                        methods.push(f)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).skip_newlines()
                ()
                continue
            let weak_ = match (*_self).peek_kind():
                TokenKind::Ident(s) =>
                    if (s == "weak"):
                        (*_self).advance()
                        ()
                        true
                    else:
                        false
                _ => false
            let fname = (*_self).parse_ident()?
            (*_self).expect(TokenKind__Colon)?
            ()
            let ty = (*_self).parse_type()?
            let default_ = if (*_self).check(TokenKind__Eq):
                (*_self).advance()
                ()
                Option::Some((*_self).parse_expr()?)
            else:
                none
            fields.push(Field { name: fname, ty: ty, attributes: f_attrs, visibility: Visibility__Public, default_: default_, weak_: weak_, span: (*_self).current_span() })
            ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::Struct(Struct { name: name, generics: generics, fields: fields, methods: methods, attributes: attrs, visibility: vis, span: start.merge((*_self).current_span()) }))

    fn parse_enum(_self: &mut Parser<a>, vis: Visibility) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Enum)?
        ()
        let name = (*_self).parse_ident()?
        let generics = (*_self).parse_generics()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut variants = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let start_span = (*_self).current_span()
            let vname = (*_self).parse_ident()?
            let fields = if (*_self).check(TokenKind__LParen):
                (*_self).advance()
                ()
                let mut types = Vec__new_()
                while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
                    types.push((*_self).parse_type()?)
                    ()
                    if (!(*_self).check(TokenKind__RParen)):
                        (*_self).expect(TokenKind__Comma)?
                        ()
                ()
                (*_self).expect(TokenKind__RParen)?
                ()
                VariantFields::Tuple(types)
            elif (*_self).check(TokenKind__LBrace):
                (*_self).advance()
                ()
                (*_self).skip_newlines()
                ()
                let indented = if (*_self).check(TokenKind__Indent):
                    (*_self).advance()
                    ()
                    true
                else:
                    false
                let mut fields = Vec__new_()
                while ((!(*_self).check(TokenKind__RBrace)) && (!(*_self).at_end())):
                    if (indented && (*_self).check(TokenKind__Dedent)):
                        break
                    if ((!indented) && (*_self).check(TokenKind__RBrace)):
                        break
                    (*_self).skip_newlines()
                    ()
                    if ((*_self).check(TokenKind__RBrace) || ((indented && (*_self).check(TokenKind__Dedent)))):
                        break
                    let f_attrs = (*_self).parse_attributes()?
                    let fname = (*_self).parse_ident()?
                    (*_self).expect(TokenKind__Colon)?
                    ()
                    let ty = (*_self).parse_type()?
                    fields.push(Field { name: fname, ty: ty, attributes: f_attrs, visibility: Visibility__Public, default_: none, weak_: false, span: (*_self).current_span() })
                    ()
                    if (!(*_self).check(TokenKind__RBrace)):
                        if (*_self).check(TokenKind__Comma):
                            (*_self).advance()
                            ()
                            ()
                            ()
                            ()
                        ()
                    (*_self).skip_newlines()
                    ()
                ()
                if indented:
                    (*_self).expect(TokenKind__Dedent)?
                    ()
                    ()
                    ()
                    ()
                (*_self).expect(TokenKind__RBrace)?
                ()
                VariantFields::Struct(fields)
            else:
                VariantFields__Unit
            let span = if (none):
                start_span
            else:
                start_span.merge((*_self).current_span())
            variants.push(Variant { name: vname, fields: fields, span: span })
            ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::Enum(Enum { name: name, generics: generics, variants: variants, visibility: vis, span: start.merge((*_self).current_span()) }))

    fn parse_actor(_self: &mut Parser<a>) -> Result<Item, KainError>:
        (*_self).parse_actor_with_attrs([])

    fn parse_actor_with_attrs(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Actor)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut state_ = Vec__new_()
        let mut handlers = Vec__new_()
        let mut methods = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let method_attributes = (*_self).parse_attributes()?
            if (*_self).check(TokenKind__State):
                (*_self).advance()
                ()
                let name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                let ty = (*_self).parse_type()?
                (*_self).expect(TokenKind__Eq)?
                ()
                let initial = (*_self).parse_expr()?
                state_.push(StateDecl { name: name, ty: ty, initial: initial, weak_: false, attributes: method_attributes, span: (*_self).current_span() })
                ()
                ()
                ()
                ()
            elif (*_self).check(TokenKind__Var):
                (*_self).advance()
                ()
                let name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                let ty = (*_self).parse_type()?
                (*_self).expect(TokenKind__Eq)?
                ()
                let initial = (*_self).parse_expr()?
                state_.push(StateDecl { name: name, ty: ty, initial: initial, weak_: false, attributes: method_attributes, span: (*_self).current_span() })
                ()
                ()
                ()
                ()
            elif (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function_with_attrs(Visibility__Public, method_attributes)?):
                    Item::Function(func) =>
                        methods.push(func)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                match (*_self).peek_kind():
                    TokenKind::Ident(s) =>
                        if (s == "weak"):
                            (*_self).advance()
                            ()
                            (*_self).expect(TokenKind__State)?
                            ()
                            let name = (*_self).parse_ident()?
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            let ty = (*_self).parse_type()?
                            (*_self).expect(TokenKind__Eq)?
                            ()
                            let initial = (*_self).parse_expr()?
                            state_.push(StateDecl { name: name, ty: ty, initial: initial, weak_: true, attributes: method_attributes, span: (*_self).current_span() })
                            ()
                            ()
                            ()
                            ()
                        elif (s == "on"):
                            (*_self).advance()
                            ()
                            let message_type = (*_self).parse_ident()?
                            (*_self).expect(TokenKind__LParen)?
                            ()
                            let params = (*_self).parse_params()?
                            (*_self).expect(TokenKind__RParen)?
                            ()
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            let body = (*_self).parse_block()?
                            handlers.push(MessageHandler { message_type: message_type, params: params, body: body, span: (*_self).current_span() })
                            ()
                            ()
                            ()
                            ()
                        else:
                            return Result::Err((*_self).parser_error(f"Unexpected identifier '{s}' in actor. Valid keywords: 'state', 'var', 'fn', or 'on' for message handlers", (*_self).current_span()))
                        ()
                    _ => return Result::Err((*_self).parser_error(f"Expected 'state', 'var', 'fn', or 'on' in actor definition, found {(*_self).token_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))
                ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        let span = start.merge((*_self).current_span())
        Result::Ok(Item::Actor(Actor { name: name, state_: state_, handlers: handlers, methods: methods, attributes: attributes, span: span }))

    fn parse_const(_self: &mut Parser<a>, vis: Visibility) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Const)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let ty = (*_self).parse_type()?
        (*_self).expect(TokenKind__Eq)?
        ()
        let value = (*_self).parse_expr()?
        Result::Ok(Item::Const(Const { name: name, ty: ty, value: value, visibility: vis, span: start.merge((*_self).current_span()) }))

    fn parse_type_alias(_self: &mut Parser<a>, vis: Visibility) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__TypeKw)?
        ()
        let name = (*_self).parse_ident()?
        let generics = (*_self).parse_generics()?
        (*_self).expect(TokenKind__Eq)?
        ()
        let target = (*_self).parse_type()?
        Result::Ok(Item::TypeAlias(TypeAlias { name: name, generics: generics, target: target, visibility: vis, span: start.merge((*_self).current_span()) }))

    fn parse_comptime_block(_self: &mut Parser<a>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Comptime)?
        ()
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        Result::Ok(Item::Comptime(ComptimeBlock { body: body, span: start.merge((*_self).current_span()) }))

    fn parse_material_graph(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                if (s != "material"):
                    return Result::Err((*_self).parser_error(f"Expected 'material' keyword after @material_graph attribute, found identifier '{s}'", (*_self).current_span()))
                (*_self).advance()
                ()
                ()
                ()
                ()
            _ => return Result::Err((*_self).parser_error(f"Expected 'material' keyword after @material_graph attribute, found {(*_self).token_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut inputs = Vec__new_()
        let mut body = Vec__new_()
        let mut outputs = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            match (*_self).peek_kind():
                TokenKind::Ident(s) =>
                    match s.as_str():
                        "input" =>
                            (*_self).advance()
                            ()
                            let input_name = (*_self).parse_ident()?
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            let ty = (*_self).parse_type()?
                            let default_ = if (*_self).check(TokenKind__Eq):
                                (*_self).advance()
                                ()
                                Option::Some((*_self).parse_expr()?)
                            else:
                                none
                            inputs.push(MaterialInput { name: input_name, ty: ty, default_: default_, span: (*_self).current_span() })
                            ()
                            ()
                            ()
                            ()
                        "output" =>
                            (*_self).advance()
                            ()
                            let output_name = (*_self).parse_ident()?
                            (*_self).expect(TokenKind__Eq)?
                            ()
                            let value = (*_self).parse_expr()?
                            outputs.push(MaterialOutput { name: output_name, value: value, span: (*_self).current_span() })
                            ()
                            ()
                            ()
                            ()
                        _ => return Result::Err((*_self).parser_error(f"Unexpected identifier '{s}' in material graph body. Valid keywords: 'input' (for parameters), 'let' (for intermediate values), or 'output' (for material properties like base_color, roughness)", (*_self).current_span()))
                    ()
                _ =>
                    if (*_self).check(TokenKind__Let):
                        (*_self).advance()
                        ()
                        let var_name = (*_self).parse_ident()?
                        (*_self).expect(TokenKind__Eq)?
                        ()
                        let value = (*_self).parse_expr()?
                        body.push(MaterialStatement::Let { name: var_name, value: value, span: (*_self).current_span() })
                        ()
                        ()
                        ()
                        ()
                    else:
                        return Result::Err((*_self).parser_error(f"Expected 'input', 'let', or 'output' in material graph body, found {(*_self).token_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::MaterialGraph(MaterialGraphDef { name: name, attributes: attributes, inputs: inputs, body: body, outputs: outputs, span: start.merge((*_self).current_span()) }))

    fn parse_material_function(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        if (*_self).check(TokenKind__Fn):
            (*_self).advance()
            ()
            ()
            ()
            ()
        else:
            return Result::Err((*_self).parser_error("Expected 'fn' keyword after @material_function", (*_self).current_span()))
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let mut inputs = Vec__new_()
        while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
            let input_name = (*_self).parse_ident()?
            (*_self).expect(TokenKind__Colon)?
            ()
            let ty = (*_self).parse_type()?
            let default_ = if (*_self).check(TokenKind__Eq):
                (*_self).advance()
                ()
                Option::Some((*_self).parse_expr()?)
            else:
                none
            inputs.push(MaterialInput { name: input_name, ty: ty, default_: default_, span: (*_self).current_span() })
            ()
            if (!(*_self).check(TokenKind__RParen)):
                (*_self).expect(TokenKind__Comma)?
                ()
        ()
        (*_self).expect(TokenKind__RParen)?
        ()
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut body = Vec__new_()
        let mut output: Option<Expr> = none
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            if (*_self).check(TokenKind__Let):
                (*_self).advance()
                ()
                let var_name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Eq)?
                ()
                let value = (*_self).parse_expr()?
                body.push(MaterialStatement::Let { name: var_name, value: value, span: (*_self).current_span() })
                ()
                ()
                ()
                ()
            elif (*_self).check(TokenKind__Return):
                (*_self).advance()
                ()
                output = Option::Some((*_self).parse_expr()?)
                ()
                break
            else:
                return Result::Err((*_self).parser_error("Expected 'let' or 'return' in material function body", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        (*_self).skip_newlines()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        let output = output.ok_or_else(fn(): (*_self).parser_error("Material function must have a 'return' statement", (*_self).current_span()))?
        Result::Ok(Item::MaterialFunction(MaterialFunctionDef { name: name, attributes: attributes, inputs: inputs, body: body, output: output, span: start.merge((*_self).current_span()) }))

    fn parse_graph_editor(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                if (s != "graph"):
                    return Result::Err((*_self).parser_error(f"Expected 'graph' keyword after @graph_editor attribute, found identifier '{s}'. Usage: @graph_editor\ngraph MyGraph:", (*_self).current_span()))
                (*_self).advance()
                ()
                ()
                ()
                ()
            _ => return Result::Err((*_self).parser_error(f"Expected 'graph' keyword after @graph_editor attribute, found {(*_self).token_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut node_types = Vec__new_()
        let mut schema = none
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let node_attrs = (*_self).parse_attributes()?
            if node_attrs.iter().any(fn(a): (a.name == "node_type")):
                node_types.push((*_self).parse_node_type(node_attrs)?)
                ()
                ()
                ()
                ()
            elif node_attrs.iter().any(fn(a): (a.name == "schema")):
                schema = Option::Some((*_self).parse_graph_schema(node_attrs)?)
                ()
                ()
                ()
                ()
            else:
                return Result::Err((*_self).parser_error(f"Expected @node_type or @schema attribute in graph editor body, found {(*_self).token_to_user_string(&(*_self).peek_kind())}. Graph editors must define node types with @node_type and optionally a @schema", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::GraphEditor(GraphEditorDef { name: name, attributes: attributes, node_types: node_types, schema: schema, span: start.merge((*_self).current_span()) }))

    fn parse_node_type(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<NodeTypeDef, KainError>:
        let start = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                if (s != "node"):
                    return Result::Err((*_self).parser_error("Expected 'node' keyword after @node_type", (*_self).current_span()))
                (*_self).advance()
                ()
                ()
                ()
                ()
            _ => return Result::Err((*_self).parser_error("Expected 'node' keyword after @node_type", (*_self).current_span()))
        let name = (*_self).parse_ident()?
        let category = attributes.iter().find(fn(a): (a.name == "category")).and_then(fn(a): a.args.first()).and_then(fn(arg): none)
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut inputs = Vec__new_()
        let mut outputs = Vec__new_()
        let mut properties = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            match (*_self).peek_kind():
                TokenKind::Ident(s) =>
                    match s.as_str():
                        "inputs" =>
                            (*_self).advance()
                            ()
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            inputs = (*_self).parse_pin_list()?
                            ()
                            ()
                            ()
                            ()
                        "outputs" =>
                            (*_self).advance()
                            ()
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            outputs = (*_self).parse_pin_list()?
                            ()
                            ()
                            ()
                            ()
                        "properties" =>
                            (*_self).advance()
                            ()
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            properties = (*_self).parse_property_list()?
                            ()
                            ()
                            ()
                            ()
                        _ => return Result::Err((*_self).parser_error("Expected 'inputs', 'outputs', or 'properties'", (*_self).current_span()))
                    ()
                _ =>
                    ()
                    ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(NodeTypeDef { name: name, category: category, inputs: inputs, outputs: outputs, properties: properties, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn parse_pin_list(_self: &mut Parser<a>) -> Result<Array<PinDef>, KainError>:
        let mut pins = Vec__new_()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let pin_attrs = (*_self).parse_attributes()?
            let pin_start = (*_self).current_span()
            let name = (*_self).parse_ident()?
            (*_self).expect(TokenKind__Colon)?
            ()
            let ty = (*_self).parse_type()?
            let is_array = match &ty:
                Type::Named { name: name } if (name == "Array") => true
                _ => false
            let default_ = if (*_self).check(TokenKind__Eq):
                (*_self).advance()
                ()
                Option::Some((*_self).parse_expr()?)
            else:
                none
            pins.push(PinDef { name: name, ty: ty, is_array: is_array, default_: default_, attributes: pin_attrs, span: pin_start.merge((*_self).current_span()) })
            ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(pins)

    fn parse_property_list(_self: &mut Parser<a>) -> Result<Array<PropertyDef>, KainError>:
        let mut properties = Vec__new_()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let prop_attrs = (*_self).parse_attributes()?
            let prop_start = (*_self).current_span()
            let name = (*_self).parse_ident()?
            (*_self).expect(TokenKind__Colon)?
            ()
            let ty = (*_self).parse_type()?
            let default_ = if (*_self).check(TokenKind__Eq):
                (*_self).advance()
                ()
                Option::Some((*_self).parse_expr()?)
            else:
                none
            properties.push(PropertyDef { name: name, ty: ty, default_: default_, attributes: prop_attrs, span: prop_start.merge((*_self).current_span()) })
            ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(properties)

    fn parse_graph_schema(_self: &mut Parser<a>, _attributes: Array<Attribute>) -> Result<GraphSchemaDef, KainError>:
        let start = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                if (s != "schema"):
                    return Result::Err((*_self).parser_error("Expected 'schema' keyword after @schema", (*_self).current_span()))
                (*_self).advance()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut rules = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let rule_name = (*_self).parse_ident()?
            (*_self).expect(TokenKind__Colon)?
            ()
            let condition = (*_self).parse_expr()?
            rules.push(SchemaRule { name: rule_name, condition: condition, span: start.merge((*_self).current_span()) })
            ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(GraphSchemaDef { rules: rules, span: start.merge((*_self).current_span()) })

    fn parse_params(_self: &mut Parser<a>) -> Result<Array<Param>, KainError>:
        let mut params = Vec__new_()
        (*_self).skip_newlines()
        ()
        while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
            let mutable_ = if (*_self).check(TokenKind__Mut):
                (*_self).advance()
                ()
                true
            else:
                false
            let name = (*_self).parse_ident()?
            let ty = if (*_self).check(TokenKind__Colon):
                (*_self).advance()
                ()
                (*_self).parse_type()?
            else:
                Type::Infer((*_self).current_span())
            let default_ = if (*_self).check(TokenKind__Eq):
                (*_self).advance()
                ()
                Option::Some((*_self).parse_expr()?)
            else:
                none
            params.push(Param { name: name, ty: ty, mutable_: mutable_, default_: default_, span: (*_self).current_span() })
            ()
            (*_self).skip_newlines()
            ()
            if (!(*_self).check(TokenKind__RParen)):
                (*_self).expect(TokenKind__Comma)?
                ()
                (*_self).skip_newlines()
                ()
        ()
        Result::Ok(params)

    fn parse_generics(_self: &mut Parser<a>) -> Result<Array<Generic>, KainError>:
        let mut generics = Vec__new_()
        if (!(*_self).check(TokenKind__Lt)):
            return Result::Ok(generics)
        (*_self).advance()
        ()
        while ((!(*_self).check(TokenKind__Gt)) && (!(*_self).at_end())):
            let start = (*_self).current_span()
            let name = (*_self).parse_ident()?
            let mut bounds = Vec__new_()
            if (*_self).check(TokenKind__Colon):
                (*_self).advance()
                ()
                loop:
                    let bound_name = (*_self).parse_ident()?
                    bounds.push(TypeBound { trait_name: bound_name, span: (*_self).current_span() })
                    ()
                    if (!(*_self).check(TokenKind__Plus)):
                        break
                    (*_self).advance()
                    ()
                ()
                ()
            generics.push(Generic { name: name, bounds: bounds, span: start.merge((*_self).current_span()) })
            ()
            if (!(*_self).check(TokenKind__Gt)):
                (*_self).expect(TokenKind__Comma)?
                ()
        ()
        (*_self).expect(TokenKind__Gt)?
        ()
        Result::Ok(generics)

    fn parse_generics_as_types(_self: &mut Parser<a>) -> Result<Array<Type>, KainError>:
        let mut generics = Vec__new_()
        if (!(*_self).check(TokenKind__Lt)):
            return Result::Ok(generics)
        (*_self).advance()
        ()
        while (((!(*_self).check(TokenKind__Gt)) && (!(*_self).check(TokenKind__Shr))) && (!(*_self).at_end())):
            generics.push((*_self).parse_type()?)
            ()
            if ((!(*_self).check(TokenKind__Gt)) && (!(*_self).check(TokenKind__Shr))):
                (*_self).expect(TokenKind__Comma)?
                ()
        ()
        if (*_self).check(TokenKind__Shr):
            let shr_span = (*_self).current_span()
            (*_self).advance()
            ()
            (*_self).inject_token(Token__new_(TokenKind__Gt, shr_span))
            ()
            ()
            ()
            ()
        else:
            (*_self).expect(TokenKind__Gt)?
            ()
            ()
            ()
            ()
        Result::Ok(generics)

    fn parse_effects(_self: &mut Parser<a>) -> Result<Array<Effect>, KainError>:
        let mut effects = Vec__new_()
        if (*_self).check(TokenKind__With):
            (*_self).advance()
            ()
            loop:
                let effect = match (*_self).peek_kind():
                    TokenKind::Pure_ =>
                        (*_self).advance()
                        ()
                        Option::Some(Effect__Pure_)
                    TokenKind::Io =>
                        (*_self).advance()
                        ()
                        Option::Some(Effect__IO_)
                    TokenKind::Async_ =>
                        (*_self).advance()
                        ()
                        Option::Some(Effect__Async_)
                    TokenKind::Gpu =>
                        (*_self).advance()
                        ()
                        Option::Some(Effect__GPU_)
                    TokenKind::Reactive_ =>
                        (*_self).advance()
                        ()
                        Option::Some(Effect__Reactive_)
                    TokenKind::Unsafe_ =>
                        (*_self).advance()
                        ()
                        Option::Some(Effect__Unsafe_)
                    TokenKind::Ident(s) =>
                        let e = Effect__from_str(s)
                        (*_self).advance()
                        ()
                        e
                    _ => none
                match effect:
                    Some(e) =>
                        effects.push(e)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                if (!(*_self).check(TokenKind__Comma)):
                    break
                (*_self).advance()
                ()
            ()
            ()
        Result::Ok(effects)

    fn parse_type(_self: &mut Parser<a>) -> Result<Type, KainError>:
        let span = (*_self).current_span()
        if (*_self).check(TokenKind__Amp):
            (*_self).advance()
            ()
            let mutable_ = if (*_self).check(TokenKind__Mut):
                (*_self).advance()
                ()
                true
            else:
                false
            let lifetime = (*_self).parse_optional_ref_lifetime()
            let inner = (*_self).parse_type()?
            return Result::Ok(Type::Ref { mutable_: mutable_, inner: Box__new_(inner), lifetime: lifetime, span: span.merge((*_self).current_span()) })
        if (*_self).check(TokenKind__LBracket):
            (*_self).advance()
            ()
            let inner = (*_self).parse_type()?
            if (*_self).check(TokenKind__Semi):
                (*_self).advance()
                ()
                let TokenKind::Int(size) = (*_self).peek_kind()
                (*_self).advance()
                ()
                (*_self).expect(TokenKind__RBracket)?
                ()
                return Result::Ok(Type::Array(Box__new_(inner), size as usize, span.merge((*_self).current_span())))
            (*_self).expect(TokenKind__RBracket)?
            ()
            return Result::Ok(Type::Slice(Box__new_(inner), span.merge((*_self).current_span())))
        if (*_self).check(TokenKind__LParen):
            (*_self).advance()
            ()
            if (*_self).check(TokenKind__RParen):
                (*_self).advance()
                ()
                return Result::Ok(Type::Unit(span.merge((*_self).current_span())))
            let mut elements = Vec__new_()
            elements.push((*_self).parse_type()?)
            ()
            while (*_self).check(TokenKind__Comma):
                (*_self).advance()
                ()
                if (*_self).check(TokenKind__RParen):
                    break
                elements.push((*_self).parse_type()?)
                ()
            ()
            (*_self).expect(TokenKind__RParen)?
            ()
            return Result::Ok(Type::Tuple(elements, span.merge((*_self).current_span())))
        if (*_self).check(TokenKind__Impl):
            (*_self).advance()
            ()
            let trait_name = (*_self).parse_ident()?
            let mut generics = Vec__new_()
            if (*_self).check(TokenKind__Lt):
                (*_self).advance()
                ()
                while (((!(*_self).check(TokenKind__Gt)) && (!(*_self).check(TokenKind__Shr))) && (!(*_self).at_end())):
                    generics.push((*_self).parse_type()?)
                    ()
                    if ((!(*_self).check(TokenKind__Gt)) && (!(*_self).check(TokenKind__Shr))):
                        (*_self).expect(TokenKind__Comma)?
                        ()
                ()
                if (*_self).check(TokenKind__Shr):
                    (*_self).advance()
                    ()
                    ()
                    ()
                    ()
                else:
                    (*_self).expect(TokenKind__Gt)?
                    ()
                    ()
                    ()
                    ()
                ()
            return Result::Ok(Type::Impl { trait_name: trait_name, generics: generics, span: span.merge((*_self).current_span()) })
        if (*_self).check(TokenKind__Fn):
            (*_self).advance()
            ()
            (*_self).expect(TokenKind__LParen)?
            ()
            let mut params = Vec__new_()
            while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
                params.push((*_self).parse_type()?)
                ()
                if (!(*_self).check(TokenKind__RParen)):
                    (*_self).expect(TokenKind__Comma)?
                    ()
            ()
            (*_self).expect(TokenKind__RParen)?
            ()
            let return_type = if (*_self).check(TokenKind__Arrow):
                (*_self).advance()
                ()
                Box__new_((*_self).parse_type()?)
            else:
                Box__new_(Type::Unit(span))
            return Result::Ok(Type::Function { params: params, return_type: return_type, effects: [], span: span.merge((*_self).current_span()) })
        let name = (*_self).parse_path_name()?
        if ((name == "delegate") && (*_self).check(TokenKind__LParen)):
            (*_self).advance()
            ()
            let mut params = Vec__new_()
            while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
                params.push((*_self).parse_type()?)
                ()
                if (!(*_self).check(TokenKind__RParen)):
                    (*_self).expect(TokenKind__Comma)?
                    ()
            ()
            (*_self).expect(TokenKind__RParen)?
            ()
            let return_type = Box__new_(Type::Unit(span))
            return Result::Ok(Type::Function { params: params, return_type: return_type, effects: [], span: span.merge((*_self).current_span()) })
        let mut type_args = Vec__new_()
        if (*_self).check(TokenKind__Lt):
            (*_self).advance()
            ()
            while (((!(*_self).check(TokenKind__Gt)) && (!(*_self).check(TokenKind__Shr))) && (!(*_self).at_end())):
                type_args.push((*_self).parse_type()?)
                ()
                if ((!(*_self).check(TokenKind__Gt)) && (!(*_self).check(TokenKind__Shr))):
                    (*_self).expect(TokenKind__Comma)?
                    ()
            ()
            if (*_self).check(TokenKind__Shr):
                let shr_span = (*_self).current_span()
                (*_self).advance()
                ()
                (*_self).inject_token(Token__new_(TokenKind__Gt, shr_span))
                ()
                ()
                ()
                ()
            else:
                (*_self).expect(TokenKind__Gt)?
                ()
                ()
                ()
                ()
            ()
        if ((((name == "ptr") || (name == "ptr_mut"))) && (type_args.len() == 1)):
            return Result::Ok(Type::Ptr { mutable_: (name == "ptr_mut"), inner: Box__new_(type_args.into_iter().next().unwrap()), provenance: ast__PointerProvenance__Raw, span: span })
        Result::Ok(Type::Named { name: name, generics: type_args, span: span })

    fn parse_block(_self: &mut Parser<a>) -> Result<Block, KainError>:
        (*_self).skip_newlines()
        ()
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut stmts = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (((*_self).check(TokenKind__Dedent) || (*_self).check(TokenKind__Elif)) || (*_self).check(TokenKind__Else)):
                break
            stmts.push((*_self).parse_stmt()?)
            ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Block { stmts: stmts, span: start.merge((*_self).current_span()) })

    fn parse_stmt(_self: &mut Parser<a>) -> Result<Stmt, KainError>:
        if (*_self).is_item_start():
            return Result::Ok(Stmt::Item(Box__new_((*_self).parse_item()?)))
        match (*_self).peek_kind():
            TokenKind::Let => (*_self).parse_let()
            TokenKind::Var => (*_self).parse_var()
            TokenKind::Return => (*_self).parse_return()
            TokenKind::For => (*_self).parse_for()
            TokenKind::While => (*_self).parse_while()
            TokenKind::Loop => (*_self).parse_loop()
            TokenKind::Break => (*_self).parse_break()
            TokenKind::Continue => (*_self).parse_continue()
            _ => Result::Ok(Stmt::Expr((*_self).parse_expr()?))

    fn parse_let(_self: &mut Parser<a>) -> Result<Stmt, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Let)?
        ()
        let pattern = (*_self).parse_pattern()?
        let ty = if (*_self).check(TokenKind__Colon):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_type()?)
        else:
            none
        (*_self).expect(TokenKind__Eq)?
        ()
        let value = Option::Some((*_self).parse_expr()?)
        Result::Ok(Stmt::Let { pattern: pattern, ty: ty, value: value, span: start.merge((*_self).current_span()) })

    fn parse_var(_self: &mut Parser<a>) -> Result<Stmt, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Var)?
        ()
        let name = (*_self).parse_ident()?
        let ty = if (*_self).check(TokenKind__Colon):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_type()?)
        else:
            none
        (*_self).expect(TokenKind__Eq)?
        ()
        let value = Option::Some((*_self).parse_expr()?)
        let pattern = Pattern::Binding { name: name, mutable_: true, span: start }
        Result::Ok(Stmt::Let { pattern: pattern, ty: ty, value: value, span: start.merge((*_self).current_span()) })

    fn parse_return(_self: &mut Parser<a>) -> Result<Stmt, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Return)?
        ()
        let value = if (!(*_self).check_line_end()):
            Option::Some((*_self).parse_expr()?)
        else:
            none
        Result::Ok(Stmt::Return(value, start.merge((*_self).current_span())))

    fn parse_for(_self: &mut Parser<a>) -> Result<Stmt, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__For)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__In)?
        ()
        let iter = (*_self).parse_expr()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        Result::Ok(Stmt::For { binding: Pattern::Binding { name: name, mutable_: false, span: start }, iter: iter, body: body, span: start.merge((*_self).current_span()) })

    fn parse_while(_self: &mut Parser<a>) -> Result<Stmt, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__While)?
        ()
        let condition = (*_self).parse_expr()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        Result::Ok(Stmt::While { condition: condition, body: body, span: start.merge((*_self).current_span()) })

    fn parse_loop(_self: &mut Parser<a>) -> Result<Stmt, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Loop)?
        ()
        (*_self).expect(TokenKind__Colon)?
        ()
        let body = (*_self).parse_block()?
        Result::Ok(Stmt::Loop { body: body, span: start.merge((*_self).current_span()) })

    fn parse_break(_self: &mut Parser<a>) -> Result<Stmt, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Break)?
        ()
        let value = if ((!(*_self).check_line_end()) && (!(*_self).check(TokenKind__Dedent))):
            Option::Some((*_self).parse_expr()?)
        else:
            none
        Result::Ok(Stmt::Break(value, start.merge((*_self).current_span())))

    fn parse_continue(_self: &mut Parser<a>) -> Result<Stmt, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Continue)?
        ()
        Result::Ok(Stmt::Continue(start.merge((*_self).current_span())))

    fn parse_expr(_self: &mut Parser<a>) -> Result<Expr, KainError>:
        (*_self).parse_assignment()

    fn parse_assignment(_self: &mut Parser<a>) -> Result<Expr, KainError>:
        let target = (*_self).parse_conditional()?
        match (*_self).get_assignment_binop():
            Some(assign_binop) =>
                (*_self).advance()
                ()
                let rhs = (*_self).parse_assignment()?
                let span = target.span().merge(rhs.span())
                let value = match assign_binop:
                    Some(op) => Expr::Binary { left: Box__new_(target.clone()), op: op, right: Box__new_(rhs), span: span }
                    _ => rhs
                Result::Ok(Expr::Assign { target: Box__new_(target), value: Box__new_(value), span: span })
            _ => Result::Ok(target)

    fn parse_conditional(_self: &mut Parser<a>) -> Result<Expr, KainError>:
        let condition = (*_self).parse_coalesce()?
        if (!(*_self).check(TokenKind__Question)):
            return Result::Ok(condition)
        (*_self).advance()
        ()
        let then_expr = (*_self).parse_assignment()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let else_expr = (*_self).parse_assignment()?
        let then_span = then_expr.span()
        let else_span = else_expr.span()
        let span = condition.span().merge(else_span)
        Result::Ok(Expr::Match { scrutinee: Box__new_(condition), arms: [MatchArm { pattern: Pattern::Literal(Expr::Bool(true, then_span)), guard: none, body: then_expr, span: then_span }, MatchArm { pattern: Pattern::Literal(Expr::Bool(false, else_span)), guard: none, body: else_expr, span: else_span }], span: span })

    fn parse_coalesce(_self: &mut Parser<a>) -> Result<Expr, KainError>:
        let left = (*_self).parse_binary(0)?
        if (*_self).check(TokenKind__QuestionQuestion):
            (*_self).advance()
            ()
            let right = (*_self).parse_coalesce()?
            let span = left.span().merge(right.span())
            (*_self).make_null_coalesce_expr(left, right, span)
        else:
            Result::Ok(left)

    fn parse_binary(_self: &mut Parser<a>, min_prec: u8) -> Result<Expr, KainError>:
        let mut left = (*_self).parse_unary()?
        loop:
            match (*_self).get_binary_op():
                Some((op, prec)) =>
                    if (prec < min_prec):
                        break
                    (*_self).advance()
                    ()
                    let right = (*_self).parse_binary((prec + 1))?
                    let span = left.span().merge(right.span())
                    left = Expr::Binary { left: Box__new_(left), op: op, right: Box__new_(right), span: span }
                    ()
                _ => break
        ()
        Result::Ok(left)

    fn parse_unary(_self: &mut Parser<a>) -> Result<Expr, KainError>:
        match (*_self).peek_kind():
            TokenKind::Amp =>
                let s = (*_self).current_span()
                (*_self).advance()
                ()
                let mutable_ = if (*_self).check(TokenKind__Mut):
                    (*_self).advance()
                    ()
                    true
                else:
                    false
                Result::Ok(Expr::Ref { mutable_: mutable_, value: Box__new_((*_self).parse_unary()?), span: s })
            TokenKind::PlusPlus =>
                let start = (*_self).current_span()
                (*_self).advance()
                ()
                let target = (*_self).parse_unary()?
                let span = start.merge(target.span())
                (*_self).make_incdec_expr(target, true, true, span)
            TokenKind::MinusMinus =>
                let start = (*_self).current_span()
                (*_self).advance()
                ()
                let target = (*_self).parse_unary()?
                let span = start.merge(target.span())
                (*_self).make_incdec_expr(target, false, true, span)
            TokenKind::Minus =>
                let s = (*_self).current_span()
                (*_self).advance()
                ()
                Result::Ok(Expr::Unary { op: UnaryOp__Neg, operand: Box__new_((*_self).parse_unary()?), span: s })
            TokenKind::Not =>
                let s = (*_self).current_span()
                (*_self).advance()
                ()
                Result::Ok(Expr::Unary { op: UnaryOp__Not, operand: Box__new_((*_self).parse_unary()?), span: s })
            TokenKind::Tilde =>
                let s = (*_self).current_span()
                (*_self).advance()
                ()
                Result::Ok(Expr::Unary { op: UnaryOp__BitNot, operand: Box__new_((*_self).parse_unary()?), span: s })
            TokenKind::Star =>
                let s = (*_self).current_span()
                (*_self).advance()
                ()
                Result::Ok(Expr::Deref(Box__new_((*_self).parse_unary()?), s))
            TokenKind::Await =>
                let start = (*_self).current_span()
                (*_self).advance()
                ()
                let expr = (*_self).parse_unary()?
                Result::Ok(Expr::Await(Box__new_(expr), start.merge((*_self).current_span())))
            TokenKind::AsyncKw =>
                let start = (*_self).current_span()
                (*_self).advance()
                ()
                let body = if (*_self).check(TokenKind__Colon):
                    (*_self).advance()
                    ()
                    Expr::Block((*_self).parse_block()?, start)
                else:
                    (*_self).parse_unary()?
                Result::Ok(Expr::AsyncBlock(Box__new_(body), start.merge((*_self).current_span())))
            TokenKind::Send =>
                let start = (*_self).current_span()
                (*_self).advance()
                ()
                let expr = (*_self).parse_postfix()?
                match expr:
                    Expr::MethodCall { receiver: receiver, method: method, args: args, span: span } =>
                        let mut data = Vec__new_()
                        for arg in args:
                            match arg.name:
                                Some(name) =>
                                    data.push((name, arg.value))
                                    ()
                                _ => return Result::Err((*_self).parser_error("Send requires named arguments", arg.span))
                        ()
                        Result::Ok(Expr::SendMsg { target: receiver, message: method, data: data, span: start.merge(span) })
                    Expr::Call { callee: callee, args: args, span: span } =>
                        match (*callee):
                            Expr::Field { object: object, field: field, span: _ } =>
                                let mut data = Vec__new_()
                                for arg in args:
                                    match arg.name:
                                        Some(name) =>
                                            data.push((name, arg.value))
                                            ()
                                        _ => return Result::Err((*_self).parser_error("Send requires named arguments", arg.span))
                                ()
                                Result::Ok(Expr::SendMsg { target: object, message: field, data: data, span: start.merge(span) })
                            _ => Result::Err((*_self).parser_error("Expected method call after send (e.g., actor.message())", span))
                    _ => Result::Err((*_self).parser_error("Expected message call after send", expr.span()))
            _ => (*_self).parse_postfix()

    fn parse_postfix(_self: &mut Parser<a>) -> Result<Expr, KainError>:
        let mut expr = (*_self).parse_primary()?
        loop:
            match (*_self).peek_kind():
                TokenKind::LParen if (*_self).previous_token_allows_postfix_call() =>
                    (*_self).advance()
                    ()
                    let args = (*_self).parse_call_args()?
                    (*_self).expect(TokenKind__RParen)?
                    ()
                    let s = expr.span().merge((*_self).current_span())
                    match &expr:
                        Expr::Ident(name, ident_span) =>
                            let starts_with_uppercase = name.chars().next().map(fn(c): c.is_uppercase()).unwrap_or(false)
                            let all_named = ((!args.is_empty()) && args.iter().all(fn(arg): arg.name.is_some()))
                            if (starts_with_uppercase && all_named):
                                return Result::Err((*_self).parser_error(f"Struct initialization with named arguments is not supported in KAIN. Found '{name}(...)'.\nUse field-by-field assignment instead:\n\nExample:\nlet obj = {name}()\nobj.field1 = value1\nobj.field2 = value2", s))
                            ()
                        _ =>
                            ()
                            ()
                    match expr:
                        Expr::Field { object: object, field: field, span: _ } =>
                            expr = Expr::MethodCall { receiver: object, method: field, args: args, span: s }
                            ()
                        _ =>
                            expr = (*_self).normalize_special_call(expr, args, s)
                            ()
                TokenKind::Dot =>
                    (*_self).advance()
                    ()
                    let field = (*_self).parse_ident()?
                    let s = expr.span().merge((*_self).current_span())
                    expr = Expr::Field { object: Box__new_(expr), field: field, span: s }
                    ()
                TokenKind::QuestionDot =>
                    (*_self).advance()
                    ()
                    let field = (*_self).parse_ident()?
                    let s = expr.span().merge((*_self).current_span())
                    expr = (*_self).make_safe_nav_field_expr(expr, field, s)?
                    ()
                TokenKind::As =>
                    (*_self).advance()
                    ()
                    let target = (*_self).parse_type()?
                    let s = expr.span().merge((*_self).current_span())
                    expr = Expr::Cast { value: Box__new_(expr), target: target, span: s }
                    ()
                TokenKind::LBracket =>
                    (*_self).advance()
                    ()
                    let idx = if (*_self).check(TokenKind__DotDot):
                        (*_self).advance()
                        ()
                        let inclusive = if (*_self).check(TokenKind__Eq):
                            (*_self).advance()
                            ()
                            true
                        else:
                            false
                        let end = if (*_self).check(TokenKind__RBracket):
                            none
                        else:
                            Option::Some(Box__new_((*_self).parse_expr()?))
                        Expr::Range { start: none, end: end, inclusive: inclusive, span: (*_self).current_span() }
                    else:
                        let first = (*_self).parse_expr()?
                        if (*_self).check(TokenKind__DotDot):
                            let start_span = first.span()
                            (*_self).advance()
                            ()
                            let inclusive = if (*_self).check(TokenKind__Eq):
                                (*_self).advance()
                                ()
                                true
                            else:
                                false
                            let end = if (*_self).check(TokenKind__RBracket):
                                none
                            else:
                                Option::Some(Box__new_((*_self).parse_expr()?))
                            Expr::Range { start: Option::Some(Box__new_(first)), end: end, inclusive: inclusive, span: start_span.merge((*_self).current_span()) }
                        else:
                            first
                    (*_self).expect(TokenKind__RBracket)?
                    ()
                    let s = expr.span().merge((*_self).current_span())
                    expr = Expr::Index { object: Box__new_(expr), index: Box__new_(idx), span: s }
                    ()
                TokenKind::PlusPlus =>
                    let start = expr.span()
                    (*_self).advance()
                    ()
                    let span = start.merge((*_self).current_span())
                    expr = (*_self).make_incdec_expr(expr, true, false, span)?
                    ()
                TokenKind::MinusMinus =>
                    let start = expr.span()
                    (*_self).advance()
                    ()
                    let span = start.merge((*_self).current_span())
                    expr = (*_self).make_incdec_expr(expr, false, false, span)?
                    ()
                TokenKind::Question =>
                    if (*_self).question_starts_ternary():
                        break
                    (*_self).advance()
                    ()
                    let s = expr.span().merge((*_self).current_span())
                    expr = Expr::Try(Box__new_(expr), s)
                    ()
                TokenKind::Not =>
                    match &expr:
                        Expr::Ident(name, _) =>
                            (*_self).advance()
                            ()
                            (*_self).expect(TokenKind__LParen)?
                            ()
                            let args = if (!(*_self).check(TokenKind__RParen)):
                                let mut args = Vec__new_()
                                args.push((*_self).parse_expr()?)
                                ()
                                while (*_self).check(TokenKind__Comma):
                                    (*_self).advance()
                                    ()
                                    if (*_self).check(TokenKind__RParen):
                                        break
                                    args.push((*_self).parse_expr()?)
                                    ()
                                ()
                                args
                            else:
                                Vec__new_()
                            (*_self).expect(TokenKind__RParen)?
                            ()
                            let s = expr.span().merge((*_self).current_span())
                            expr = Expr::MacroCall { name: name.clone(), args: args, span: s }
                            ()
                        _ => return Result::Err((*_self).parser_error("Macro invocation only allowed on identifiers", (*_self).current_span()))
                _ => break
        ()
        Result::Ok(expr)

    fn previous_token_allows_postfix_call(_self: &Parser<a>) -> Bool:
        if ((*_self).pos == 0):
            return true
        (!none)

    fn parse_primary(_self: &mut Parser<a>) -> Result<Expr, KainError>:
        let span = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Int(n) =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Int(n, span))
            TokenKind::Float(n) =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Float(n, span))
            TokenKind::String(s) =>
                let s = s.clone()
                (*_self).advance()
                ()
                Result::Ok(Expr::String(s, span))
            TokenKind::FString(s) =>
                let s = s.clone()
                (*_self).advance()
                ()
                let mut parts = Vec__new_()
                let mut last_idx = 0
                let mut chars = s.char_indices().peekable()
                loop:
                    match chars.next():
                        Some((idx, c)) =>
                            if (c == "{"):
                                if (idx > last_idx):
                                    parts.push(Expr::String(s[last_idx..idx].to_string(), span))
                                    ()
                                    ()
                                    ()
                                    ()
                                let expr_start = (idx + 1)
                                let mut depth = 1
                                let mut expr_end = expr_start
                                loop:
                                    match chars.next():
                                        Some((i, c2)) =>
                                            if (c2 == "{"):
                                                depth = (depth + 1)
                                                ()
                                            elif (c2 == "}"):
                                                depth = (depth - 1)
                                                ()
                                                if (depth == 0):
                                                    expr_end = i
                                                    ()
                                                    break
                                        _ => break
                                ()
                                if (depth == 0):
                                    let expr_str = &s[expr_start..expr_end]
                                    let tokens = Lexer__new_(expr_str).tokenize()?
                                    let expr_span_mapper = SpanMapper__new_(expr_str)
                                    let mut parser = Parser__new_(&tokens, &expr_span_mapper, "<f-string>")
                                    let expr = parser.parse_expr()?
                                    parts.push(expr)
                                    ()
                                    last_idx = (expr_end + 1)
                                    ()
                                else:
                                    return Result::Err((*_self).parser_error("Unclosed '{' in f-string", span))
                        _ => break
                ()
                if (last_idx < s.len()):
                    parts.push(Expr::String(s[last_idx..].to_string(), span))
                    ()
                    ()
                    ()
                    ()
                Result::Ok(Expr::FString(parts, span))
            TokenKind::True =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Bool(true, span))
            TokenKind::False =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Bool(false, span))
            TokenKind::None =>
                (*_self).advance()
                ()
                Result::Ok(Expr::None(span))
            TokenKind::Ident(s) =>
                let name = s.clone()
                (*_self).advance()
                ()
                match parse_orchestrate_stage_runtime(name.as_str()):
                    Some(runtime) =>
                        let saved_pos = (*_self).pos
                        if (none):
                            let function = (*_self).parse_path_name()?
                            if (*_self).check(TokenKind__LParen):
                                (*_self).advance()
                                ()
                                let args = (*_self).parse_call_args()?
                                (*_self).expect(TokenKind__RParen)?
                                ()
                                return Result::Ok(Expr::StageCall { runtime: runtime, function: function, args: args, span: span.merge((*_self).current_span()) })
                            ()
                        (*_self).pos = saved_pos
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                let path_segments = (*_self).parse_path_segments_after(name.clone())?
                let path_name = Parser__join_path_segments(&path_segments)
                let is_variant_path = Parser__path_looks_like_enum_variant(&path_segments)
                let saved_pos_for_check = (*_self).pos
                (*_self).skip_formatting()
                ()
                let has_brace = (*_self).check(TokenKind__LBrace)
                if (is_variant_path && (((*_self).check(TokenKind__LParen) || has_brace))):
                    let variant = path_segments.last().cloned().unwrap_or_default()
                    let enum_name = Parser__join_path_segments(&path_segments[..(path_segments.len() - 1)])
                    let fields = (*_self).parse_enum_variant_fields()?
                    return Result::Ok(Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: fields, span: span.merge((*_self).current_span()) })
                if has_brace:
                    if (!(*_self).capabilities.supports_parser_struct_literals()):
                        (*_self).pos = saved_pos_for_check
                        ()
                        return Result::Err((*_self).parser_error("Struct literal syntax is not supported in KAIN. Found '{path_name} { ... }'.\nUse field-by-field assignment instead:\n\nExample:\nlet obj = {path_name}()\nobj.field1 = value1\nobj.field2 = value2", span))
                    return (*_self).parse_struct_literal_expr(path_name, span)
                if is_variant_path:
                    let variant = path_segments.last().cloned().unwrap_or_default()
                    let enum_name = Parser__join_path_segments(&path_segments[..(path_segments.len() - 1)])
                    return Result::Ok(Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: EnumVariantFields__Unit, span: span.merge((*_self).current_span()) })
                (*_self).pos = saved_pos_for_check
                ()
                Result::Ok(Expr::Ident(path_name, span))
            TokenKind::SelfLower =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Ident(("self").to_string(), span))
            TokenKind::SelfUpper =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Ident(("Self").to_string(), span))
            TokenKind::LParen =>
                (*_self).advance()
                ()
                (*_self).skip_newlines()
                ()
                let indented = if (*_self).check(TokenKind__Indent):
                    (*_self).advance()
                    ()
                    true
                else:
                    false
                if (*_self).check(TokenKind__RParen):
                    (*_self).advance()
                    ()
                    Result::Ok(Expr::Tuple([], span.merge((*_self).current_span())))
                else:
                    let first = (*_self).parse_expr()?
                    if (*_self).check(TokenKind__Comma):
                        (*_self).advance()
                        ()
                        (*_self).skip_newlines()
                        ()
                        let mut items = [first]
                        while ((!(*_self).check(TokenKind__RParen)) && (!((indented && (*_self).check(TokenKind__Dedent))))):
                            items.push((*_self).parse_expr()?)
                            ()
                            if ((!(*_self).check(TokenKind__RParen)) && (!((indented && (*_self).check(TokenKind__Dedent))))):
                                (*_self).expect(TokenKind__Comma)?
                                ()
                                (*_self).skip_newlines()
                                ()
                        ()
                        if (indented && (*_self).check(TokenKind__Dedent)):
                            (*_self).advance()
                            ()
                            ()
                            ()
                            ()
                        (*_self).expect(TokenKind__RParen)?
                        ()
                        Result::Ok(Expr::Tuple(items, span.merge((*_self).current_span())))
                    else:
                        if (indented && (*_self).check(TokenKind__Dedent)):
                            (*_self).advance()
                            ()
                            ()
                            ()
                            ()
                        (*_self).expect(TokenKind__RParen)?
                        ()
                        Result::Ok(Expr::Paren(Box__new_(first), span.merge((*_self).current_span())))
            TokenKind::LBracket =>
                (*_self).advance()
                ()
                (*_self).skip_newlines()
                ()
                let indented = if (*_self).check(TokenKind__Indent):
                    (*_self).advance()
                    ()
                    true
                else:
                    false
                let mut items = []
                while ((!(*_self).check(TokenKind__RBracket)) && (!(*_self).at_end())):
                    if (indented && (*_self).check(TokenKind__Dedent)):
                        break
                    (*_self).skip_newlines()
                    ()
                    if (*_self).check(TokenKind__RBracket):
                        break
                    items.push((*_self).parse_expr()?)
                    ()
                    (*_self).skip_newlines()
                    ()
                    if ((!(*_self).check(TokenKind__RBracket)) && (!(*_self).check(TokenKind__Dedent))):
                        if (*_self).check(TokenKind__Comma):
                            (*_self).advance()
                            ()
                            (*_self).skip_newlines()
                            ()
                ()
                if indented:
                    if (*_self).check(TokenKind__Dedent):
                        (*_self).advance()
                        ()
                        ()
                        ()
                        ()
                    ()
                (*_self).skip_newlines()
                ()
                (*_self).expect(TokenKind__RBracket)?
                ()
                Result::Ok(Expr::Array(items, span))
            TokenKind::Comptime =>
                (*_self).advance()
                ()
                (*_self).expect(TokenKind__Colon)?
                ()
                let body = (*_self).parse_block()?
                Result::Ok(Expr::Comptime(Box__new_(Expr::Block(body, span)), span))
            TokenKind::Pipe =>
                (*_self).advance()
                ()
                let mut params = Vec__new_()
                while (!(*_self).check(TokenKind__Pipe)):
                    let name = (*_self).parse_ident()?
                    params.push(Param { name: name, ty: Type::Infer(span), mutable_: false, default_: none, span: span })
                    ()
                    if (!(*_self).check(TokenKind__Pipe)):
                        (*_self).expect(TokenKind__Comma)?
                        ()
                ()
                (*_self).expect(TokenKind__Pipe)?
                ()
                let body = (*_self).parse_expr()?
                Result::Ok(Expr::Lambda { params: params, return_type: none, body: Box__new_(body), span: span.merge((*_self).current_span()) })
            TokenKind::Match => (*_self).parse_match()
            TokenKind::Spawn =>
                (*_self).advance()
                ()
                let actor_ = (*_self).parse_ident()?
                (*_self).expect(TokenKind__LParen)?
                ()
                let args = (*_self).parse_call_args()?
                (*_self).expect(TokenKind__RParen)?
                ()
                let mut init = Vec__new_()
                for arg in args:
                    match arg.name:
                        Some(name) =>
                            init.push((name, arg.value))
                            ()
                        _ => return Result::Err((*_self).parser_error("Spawn requires named arguments", arg.span))
                ()
                Result::Ok(Expr::Spawn { actor_: actor_, init: init, span: span.merge((*_self).current_span()) })
            TokenKind::Return =>
                let start = (*_self).current_span()
                (*_self).advance()
                ()
                let value = if (((((!(*_self).check_line_end()) && (!(*_self).check(TokenKind__Comma))) && (!(*_self).check(TokenKind__RParen))) && (!(*_self).check(TokenKind__RBrace))) && (!(*_self).check(TokenKind__RBracket))):
                    Option::Some(Box__new_((*_self).parse_expr()?))
                else:
                    none
                Result::Ok(Expr::Return(value, start.merge((*_self).current_span())))
            TokenKind::If => (*_self).parse_if()
            TokenKind::Lt =>
                let jsx = (*_self).parse_jsx_element()?
                Result::Ok(Expr::JSX(jsx, span.merge((*_self).current_span())))
            TokenKind::Fn =>
                (*_self).advance()
                ()
                (*_self).expect(TokenKind__LParen)?
                ()
                let mut params = Vec__new_()
                while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
                    let p_span = (*_self).current_span()
                    let name = (*_self).parse_ident()?
                    let ty = if (*_self).check(TokenKind__Colon):
                        (*_self).advance()
                        ()
                        (*_self).parse_type()?
                    else:
                        Type::Infer(p_span)
                    params.push(Param { name: name, ty: ty, mutable_: false, default_: none, span: p_span })
                    ()
                    if (!(*_self).check(TokenKind__RParen)):
                        (*_self).expect(TokenKind__Comma)?
                        ()
                ()
                (*_self).expect(TokenKind__RParen)?
                ()
                let return_type = if (*_self).check(TokenKind__Arrow):
                    (*_self).advance()
                    ()
                    Option::Some((*_self).parse_type()?)
                else:
                    none
                (*_self).expect(TokenKind__Colon)?
                ()
                let body = if (*_self).check(TokenKind__Return):
                    (*_self).advance()
                    ()
                    (*_self).parse_expr()?
                elif ((*_self).check(TokenKind__Indent) || (*_self).check_newline()):
                    (*_self).skip_newlines()
                    ()
                    let block = (*_self).parse_block()?
                    Expr::Block(block, span)
                else:
                    (*_self).parse_expr()?
                Result::Ok(Expr::Lambda { params: params, return_type: return_type, body: Box__new_(body), span: span.merge((*_self).current_span()) })
            TokenKind::Continue =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Continue(span))
            TokenKind::Break =>
                (*_self).advance()
                ()
                let value = if ((((!(*_self).check_line_end()) && (!(*_self).check(TokenKind__Dedent))) && (!(*_self).check(TokenKind__Comma))) && (!(*_self).check(TokenKind__RParen))):
                    Option::Some(Box__new_((*_self).parse_expr()?))
                else:
                    none
                Result::Ok(Expr::Break(value, span))
            TokenKind::Component =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Ident(("component").to_string(), span))
            TokenKind::Shader =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Ident(("shader").to_string(), span))
            TokenKind::Actor =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Ident(("actor").to_string(), span))
            TokenKind::State =>
                (*_self).advance()
                ()
                Result::Ok(Expr::Ident(("state").to_string(), span))
            _ => Result::Err((*_self).parser_error(f"Unexpected token: {error__token_kind_to_user_string(&(*_self).peek_kind())}", span))

    fn parse_struct_literal_expr(_self: &mut Parser<a>, name: String, start_span: Span) -> Result<Expr, KainError>:
        (*_self).expect(TokenKind__LBrace)?
        ()
        (*_self).skip_newlines()
        ()
        let indented = if (*_self).check(TokenKind__Indent):
            (*_self).advance()
            ()
            true
        else:
            false
        let mut fields = Vec__new_()
        let mut rest = none
        while ((!(*_self).check(TokenKind__RBrace)) && (!(*_self).at_end())):
            if (indented && (*_self).check(TokenKind__Dedent)):
                break
            (*_self).skip_newlines()
            ()
            if ((*_self).check(TokenKind__RBrace) || ((indented && (*_self).check(TokenKind__Dedent)))):
                break
            if (*_self).check(TokenKind__DotDot):
                (*_self).advance()
                ()
                if rest.is_some():
                    return Result::Err((*_self).parser_error("Struct update syntax only supports one '..base' expression", (*_self).current_span()))
                if (((*_self).check(TokenKind__Comma) || (*_self).check(TokenKind__RBrace)) || ((indented && (*_self).check(TokenKind__Dedent)))):
                    return Result::Err((*_self).parser_error("Struct update syntax requires an expression after '..'", (*_self).current_span()))
                rest = Option::Some(Box__new_((*_self).parse_expr()?))
                ()
                (*_self).skip_newlines()
                ()
                if (*_self).check(TokenKind__Comma):
                    (*_self).advance()
                    ()
                    (*_self).skip_newlines()
                    ()
                    ()
                    ()
                    ()
                break
            let field_name = (*_self).parse_ident()?
            (*_self).expect(TokenKind__Colon)?
            ()
            let field_value = (*_self).parse_expr()?
            fields.push((field_name, field_value))
            ()
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Comma):
                (*_self).advance()
                ()
                (*_self).skip_newlines()
                ()
        ()
        if indented:
            (*_self).expect(TokenKind__Dedent)?
            ()
            ()
            ()
            ()
        (*_self).expect(TokenKind__RBrace)?
        ()
        Result::Ok(Expr::Struct { name: name, fields: fields, rest: rest, span: start_span.merge((*_self).current_span()) })

    fn parse_optional_ref_lifetime(_self: &mut Parser<a>) -> Option<String>:
        match (*_self).peek_kind():
            TokenKind::Ident(name) if (*_self).peek_kind_at(1).is_some_and(Parser__token_can_start_type) =>
                (*_self).advance()
                ()
                Option::Some(name)
            _ => none

    fn token_can_start_type(kind: &TokenKind) -> Bool:
        match kind:
            TokenKind::Ident(_) => true
            TokenKind::SelfLower => true
            TokenKind::SelfUpper => true
            TokenKind::Component => true
            TokenKind::Shader => true
            TokenKind::Actor => true
            TokenKind::State => true
            TokenKind::LBracket => true
            TokenKind::LParen => true
            TokenKind::Amp => true
            TokenKind::Fn => true
            TokenKind::Impl => true
            _ => false

    fn normalize_special_call(_self: &Parser<a>, callee: Expr, args: Array<CallArg>, span: Span) -> Expr:
        match &callee:
            Expr::Ident(name, _) =>
                if args.iter().all(fn(arg): arg.name.is_none()):
                    match (name.as_str(), args.len()):
                        ("addr_of", 1) =>
                            let mut values = args.into_iter()
                            let value = values.next().expect("addr_of must have first arg").value
                            let pointee_ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::AddrOf { value: Box__new_(value), pointee_ty: pointee_ty, span: span }
                        ("addr_of", 2) =>
                            let mut values = args.into_iter()
                            let value = values.next().expect("addr_of must have first arg").value
                            let pointee_ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::AddrOf { value: Box__new_(value), pointee_ty: pointee_ty, span: span }
                        ("ptr_offset", 2) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("ptr_offset must have first arg").value
                            let offset = values.next().expect("ptr_offset must have second arg").value
                            let element_ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::PtrOffset { pointer: Box__new_(pointer), offset: Box__new_(offset), element_ty: element_ty, span: span }
                        ("ptr_offset", 3) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("ptr_offset must have first arg").value
                            let offset = values.next().expect("ptr_offset must have second arg").value
                            let element_ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::PtrOffset { pointer: Box__new_(pointer), offset: Box__new_(offset), element_ty: element_ty, span: span }
                        ("mem_load", 1) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("mem_load must have arg").value
                            let load_ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::MemLoad { pointer: Box__new_(pointer), load_ty: load_ty, span: span }
                        ("mem_load", 2) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("mem_load must have arg").value
                            let load_ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::MemLoad { pointer: Box__new_(pointer), load_ty: load_ty, span: span }
                        ("mem_store", 2) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("mem_store must have first arg").value
                            let value = values.next().expect("mem_store must have second arg").value
                            let store_ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::MemStore { pointer: Box__new_(pointer), value: Box__new_(value), store_ty: store_ty, span: span }
                        ("mem_store", 3) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("mem_store must have first arg").value
                            let value = values.next().expect("mem_store must have second arg").value
                            let store_ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::MemStore { pointer: Box__new_(pointer), value: Box__new_(value), store_ty: store_ty, span: span }
                        ("sizeof_type", 1) =>
                            let mut values = args.into_iter()
                            let target = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span)).expect("sizeof_type must have parseable type arg")
                            return Expr::SizeOfType { target: target, span: span }
                        ("alignof_type", 1) =>
                            let mut values = args.into_iter()
                            let target = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span)).expect("alignof_type must have parseable type arg")
                            return Expr::AlignOfType { target: target, span: span }
                        ("alloca", 1) =>
                            let mut values = args.into_iter()
                            let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span)).expect("alloca must have parseable type arg")
                            return Expr::Alloca { ty: ty, span: span }
                        ("uninit", 1) =>
                            let mut values = args.into_iter()
                            let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span)).expect("uninit must have parseable type arg")
                            return Expr::Uninit { ty: ty, span: span }
                        ("alloc", 1) =>
                            let zeroed = (name == "alloc_zeroed")
                            let mut values = args.into_iter()
                            let size = values.next().expect("alloc must have size arg").value
                            let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::Alloc { size: Box__new_(size), ty: ty, zeroed: zeroed, span: span }
                        ("alloc", 2) =>
                            let zeroed = (name == "alloc_zeroed")
                            let mut values = args.into_iter()
                            let size = values.next().expect("alloc must have size arg").value
                            let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::Alloc { size: Box__new_(size), ty: ty, zeroed: zeroed, span: span }
                        ("alloc_zeroed", 1) =>
                            let zeroed = (name == "alloc_zeroed")
                            let mut values = args.into_iter()
                            let size = values.next().expect("alloc must have size arg").value
                            let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::Alloc { size: Box__new_(size), ty: ty, zeroed: zeroed, span: span }
                        ("alloc_zeroed", 2) =>
                            let zeroed = (name == "alloc_zeroed")
                            let mut values = args.into_iter()
                            let size = values.next().expect("alloc must have size arg").value
                            let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            return Expr::Alloc { size: Box__new_(size), ty: ty, zeroed: zeroed, span: span }
                        ("realloc_mem", 2) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("realloc_mem must have pointer arg").value
                            let size = values.next().expect("realloc_mem must have size arg").value
                            let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            let zeroed_new = values.next().map(fn(arg): none).unwrap_or(false)
                            return Expr::Realloc { pointer: Box__new_(pointer), size: Box__new_(size), ty: ty, zeroed_new: zeroed_new, span: span }
                        ("realloc_mem", 3) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("realloc_mem must have pointer arg").value
                            let size = values.next().expect("realloc_mem must have size arg").value
                            let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            let zeroed_new = values.next().map(fn(arg): none).unwrap_or(false)
                            return Expr::Realloc { pointer: Box__new_(pointer), size: Box__new_(size), ty: ty, zeroed_new: zeroed_new, span: span }
                        ("realloc_mem", 4) =>
                            let mut values = args.into_iter()
                            let pointer = values.next().expect("realloc_mem must have pointer arg").value
                            let size = values.next().expect("realloc_mem must have size arg").value
                            let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span))
                            let zeroed_new = values.next().map(fn(arg): none).unwrap_or(false)
                            return Expr::Realloc { pointer: Box__new_(pointer), size: Box__new_(size), ty: ty, zeroed_new: zeroed_new, span: span }
                        _ => ()
                    ()
                ()
            _ =>
                ()
                ()
        match &callee:
            Expr::Ident(name, _) =>
                if ((name == "aggregate_init") && (!args.is_empty())):
                    let mut values = args.into_iter()
                    let ty = values.next().and_then(fn(arg): (*_self).parse_type_hint_arg(&arg.value, span)).expect("aggregate_init must have parseable type arg")
                    let mut zero_fill_rest = true
                    let mut fields = Vec__new_()
                    for arg in values:
                        match (&arg.name, &arg.value):
                            (None, Expr::Bool(value, _)) => zero_fill_rest = (*value)
                            (Some(name), value) => fields.push((name.clone(), value.clone()))
                            _ => ()
                    ()
                    return Expr::AggregateInit { ty: ty, fields: fields, zero_fill_rest: zero_fill_rest, span: span }
                ()
            _ =>
                ()
                ()
        Expr::Call { callee: Box__new_(callee), args: args, span: span }

    fn parse_type_hint_arg(_self: &Parser<a>, expr: &Expr, span: Span) -> Option<Type>:
        match expr:
            Expr::String(value, _) => (*_self).parse_type_hint_string(value, span)
            Expr::Ident(value, _) => (*_self).parse_type_hint_string(value, span)
            _ => none

    fn parse_type_hint_string(_self: &Parser<a>, value: String, span: Span) -> Option<Type>:
        let tokens = Lexer__new_(value).tokenize().ok()?
        let span_mapper = SpanMapper__new_(value)
        let mut parser = Parser__new_(&tokens, &span_mapper, "<memory-type-hint>")
        let ty = parser.parse_type().ok()?
        if (!parser.check(TokenKind__Eof)):
            return none
        Option::Some(Parser__re_span_type(ty, span))

    fn re_span_type(ty: Type, span: Span) -> Type:
        match ty:
            Type::Named { name: name, generics: generics } => Type::Named { name: name, generics: generics.into_iter().map(fn(g): Parser__re_span_type(g, span)).collect(), span: span }
            Type::Array(inner, size, _) => Type::Array(Box__new_(Parser__re_span_type((*inner), span)), size, span)
            Type::Slice(inner, _) => Type::Slice(Box__new_(Parser__re_span_type((*inner), span)), span)
            Type::Tuple(types, _) => Type::Tuple(types.into_iter().map(fn(t): Parser__re_span_type(t, span)).collect(), span)
            Type::Ref { mutable_: mutable_, inner: inner, lifetime: lifetime } => Type::Ref { mutable_: mutable_, inner: Box__new_(Parser__re_span_type((*inner), span)), lifetime: lifetime, span: span }
            Type::Ptr { mutable_: mutable_, inner: inner, provenance: provenance } => Type::Ptr { mutable_: mutable_, inner: Box__new_(Parser__re_span_type((*inner), span)), provenance: provenance, span: span }
            Type::Function { params: params, return_type: return_type, effects: effects } => Type::Function { params: params.into_iter().map(fn(p): Parser__re_span_type(p, span)).collect(), return_type: Box__new_(Parser__re_span_type((*return_type), span)), effects: effects, span: span }
            Type::Option(inner, _) => Type::Option(Box__new_(Parser__re_span_type((*inner), span)), span)
            Type::Result(ok, err, _) => Type::Result(Box__new_(Parser__re_span_type((*ok), span)), Box__new_(Parser__re_span_type((*err), span)), span)
            Type::Infer(_) => Type::Infer(span)
            Type::Never(_) => Type::Never(span)
            Type::Unit(_) => Type::Unit(span)
            Type::Impl { trait_name: trait_name, generics: generics } => Type::Impl { trait_name: trait_name, generics: generics.into_iter().map(fn(g): Parser__re_span_type(g, span)).collect(), span: span }

    fn parse_match(_self: &mut Parser<a>) -> Result<Expr, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Match)?
        ()
        let scrutinee = Box__new_((*_self).parse_expr()?)
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut arms = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let arm_start = (*_self).current_span()
            let pattern = (*_self).parse_pattern()?
            let guard = if (*_self).check(TokenKind__If):
                (*_self).advance()
                ()
                Option::Some((*_self).parse_expr()?)
            else:
                none
            (*_self).expect(TokenKind__FatArrow)?
            ()
            let body = if (none):
                (*_self).skip_newlines()
                ()
                if (*_self).check(TokenKind__Indent):
                    (*_self).advance()
                    ()
                    let mut stmts = Vec__new_()
                    while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
                        (*_self).skip_newlines()
                        ()
                        if (*_self).check(TokenKind__Dedent):
                            break
                        stmts.push((*_self).parse_stmt()?)
                        ()
                        (*_self).skip_newlines()
                        ()
                    ()
                    if (*_self).check(TokenKind__Dedent):
                        (*_self).advance()
                        ()
                        ()
                        ()
                        ()
                    if (stmts.len() == 1):
                        match &stmts[0]:
                            Stmt::Expr(e) => e.clone()
                            _ =>
                                match &stmts[0]:
                                    Stmt::Return(Some(e), _) => e.clone()
                                    _ =>
                                        let block = Block { stmts: stmts, span: arm_start.merge((*_self).current_span()) }
                                        Expr::Block(block, arm_start.merge((*_self).current_span()))
                    else:
                        let block = Block { stmts: stmts, span: arm_start.merge((*_self).current_span()) }
                        Expr::Block(block, arm_start.merge((*_self).current_span()))
                else:
                    (*_self).parse_expr()?
            else:
                (*_self).parse_expr()?
            arms.push(MatchArm { pattern: pattern, guard: guard, body: body, span: (*_self).current_span() })
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Expr::Match { scrutinee: scrutinee, arms: arms, span: start.merge((*_self).current_span()) })

    fn parse_if(_self: &mut Parser<a>) -> Result<Expr, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__If)?
        ()
        let condition = Box__new_((*_self).parse_expr()?)
        (*_self).expect(TokenKind__Colon)?
        ()
        let is_block = match (*_self).peek_kind():
            TokenKind::Newline(_) => true
            TokenKind::Indent => true
            _ => false
        let then_branch = if is_block:
            (*_self).parse_block()?
        else:
            let stmt = (*_self).parse_stmt()?
            Block { stmts: [stmt], span: start.merge((*_self).current_span()) }
        let else_branch = (*_self).parse_if_tail(start)?
        Result::Ok(Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch, span: start.merge((*_self).current_span()) })

    fn parse_if_tail(_self: &mut Parser<a>, start: Span) -> Result<Option<Box<ElseBranch>>, KainError>:
        (*_self).skip_newlines()
        ()
        if (*_self).check(TokenKind__Elif):
            (*_self).advance()
            ()
            let condition = Box__new_((*_self).parse_expr()?)
            (*_self).expect(TokenKind__Colon)?
            ()
            let is_block = match (*_self).peek_kind():
                TokenKind::Newline(_) => true
                TokenKind::Indent => true
                _ => false
            let then_branch = if is_block:
                (*_self).parse_block()?
            else:
                let stmt = (*_self).parse_stmt()?
                Block { stmts: [stmt], span: start.merge((*_self).current_span()) }
            let nested_else = (*_self).parse_if_tail(start)?
            return Result::Ok(Option::Some(Box__new_(ElseBranch::ElseIf(condition, then_branch, nested_else))))
        if (*_self).check(TokenKind__Else):
            (*_self).advance()
            ()
            if (*_self).check(TokenKind__If):
                let elif_expr = (*_self).parse_if()?
                match elif_expr:
                    Expr::If { condition: condition, then_branch: then_branch, else_branch: nested_else } => return Result::Ok(Option::Some(Box__new_(ElseBranch::ElseIf(condition, then_branch, nested_else))))
                    _ =>
                        ()
                        ()
                return Result::Err((*_self).parser_error("Expected if expression after else", (*_self).current_span()))
            (*_self).expect(TokenKind__Colon)?
            ()
            let is_block = match (*_self).peek_kind():
                TokenKind::Newline(_) => true
                TokenKind::Indent => true
                _ => false
            if is_block:
                return Result::Ok(Option::Some(Box__new_(ElseBranch::Else((*_self).parse_block()?))))
            let stmt = (*_self).parse_stmt()?
            return Result::Ok(Option::Some(Box__new_(ElseBranch::Else(Block { stmts: [stmt], span: start.merge((*_self).current_span()) }))))
        Result::Ok(none)

    fn parse_pattern(_self: &mut Parser<a>) -> Result<Pattern, KainError>:
        let span = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) if (s == "_") =>
                (*_self).advance()
                ()
                Result::Ok(Pattern::Wildcard(span))
            TokenKind::Ident(s) =>
                let name = s.clone()
                (*_self).advance()
                ()
                let path_segments = (*_self).parse_path_segments_after(name.clone())?
                if (path_segments.len() > 1):
                    let variant = path_segments.last().cloned().unwrap_or_default()
                    let enum_name = Parser__join_path_segments(&path_segments[..(path_segments.len() - 1)])
                    let fields = (*_self).parse_variant_pattern_fields()?
                    Result::Ok(Pattern::Variant { enum_name: Option::Some(enum_name), variant: variant, fields: fields, span: span.merge((*_self).current_span()) })
                elif (*_self).check(TokenKind__LParen):
                    (*_self).advance()
                    ()
                    let mut patterns = Vec__new_()
                    while (!(*_self).check(TokenKind__RParen)):
                        patterns.push((*_self).parse_pattern()?)
                        ()
                        if (!(*_self).check(TokenKind__RParen)):
                            (*_self).expect(TokenKind__Comma)?
                            ()
                    ()
                    (*_self).expect(TokenKind__RParen)?
                    ()
                    Result::Ok(Pattern::Variant { enum_name: none, variant: name, fields: VariantPatternFields::Tuple(patterns), span: span.merge((*_self).current_span()) })
                else:
                    (*_self).validate_identifier(&name, span)?
                    ()
                    Result::Ok(Pattern::Binding { name: name, mutable_: false, span: span })
            TokenKind::Mut =>
                (*_self).advance()
                ()
                let name = (*_self).parse_ident()?
                Result::Ok(Pattern::Binding { name: name, mutable_: true, span: span.merge((*_self).current_span()) })
            TokenKind::Int(n) =>
                (*_self).advance()
                ()
                Result::Ok(Pattern::Literal(Expr::Int(n, span)))
            TokenKind::String(s) =>
                let string_val = s.clone()
                (*_self).advance()
                ()
                Result::Ok(Pattern::Literal(Expr::String(string_val, span)))
            TokenKind::True =>
                (*_self).advance()
                ()
                Result::Ok(Pattern::Literal(Expr::Bool(true, span)))
            TokenKind::False =>
                (*_self).advance()
                ()
                Result::Ok(Pattern::Literal(Expr::Bool(false, span)))
            TokenKind::LParen =>
                (*_self).advance()
                ()
                let mut patterns = Vec__new_()
                while (!(*_self).check(TokenKind__RParen)):
                    patterns.push((*_self).parse_pattern()?)
                    ()
                    if (!(*_self).check(TokenKind__RParen)):
                        (*_self).expect(TokenKind__Comma)?
                        ()
                ()
                (*_self).expect(TokenKind__RParen)?
                ()
                Result::Ok(Pattern::Tuple(patterns, span.merge((*_self).current_span())))
            TokenKind::LBracket =>
                (*_self).advance()
                ()
                let mut patterns = Vec__new_()
                while (!(*_self).check(TokenKind__RBracket)):
                    patterns.push((*_self).parse_pattern()?)
                    ()
                    if (!(*_self).check(TokenKind__RBracket)):
                        (*_self).expect(TokenKind__Comma)?
                        ()
                ()
                (*_self).expect(TokenKind__RBracket)?
                ()
                Result::Ok(Pattern::Slice { patterns: patterns, rest: none, span: span.merge((*_self).current_span()) })
            _ => Result::Err((*_self).parser_error(f"Expected pattern (identifier, integer, string, tuple, or array), found {(*_self).token_to_user_string(&(*_self).peek_kind())}", span))

    fn parse_jsx(_self: &mut Parser<a>) -> Result<JSXNode, KainError>:
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        (*_self).skip_newlines()
        ()
        let result = (*_self).parse_jsx_element()?
        (*_self).skip_newlines()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(result)

    fn parse_jsx_element(_self: &mut Parser<a>) -> Result<JSXNode, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Lt)?
        ()
        let tag = (*_self).parse_jsx_tag_name()?
        let mut attrs = Vec__new_()
        while ((!(*_self).check(TokenKind__Gt)) && (!(*_self).check(TokenKind__Slash))):
            let name = (*_self).parse_jsx_attribute_name()?
            (*_self).expect(TokenKind__Eq)?
            ()
            let value = if (*_self).check(TokenKind__LBrace):
                (*_self).advance()
                ()
                let e = if (*_self).check(TokenKind__Lt):
                    let jsx = (*_self).parse_jsx_element()?
                    Expr::JSX(jsx, (*_self).current_span())
                else:
                    (*_self).parse_expr()?
                (*_self).expect(TokenKind__RBrace)?
                ()
                JSXAttrValue::Expr(e)
            else:
                match (*_self).peek_kind():
                    TokenKind::String(s) =>
                        (*_self).advance()
                        ()
                        JSXAttrValue::String(s)
                    _ => return Result::Err((*_self).parser_error("Expected attribute value", (*_self).current_span()))
            attrs.push(JSXAttribute { name: name, value: value, span: (*_self).current_span() })
            ()
        ()
        if (*_self).check(TokenKind__Slash):
            (*_self).advance()
            ()
            (*_self).expect(TokenKind__Gt)?
            ()
            return Result::Ok((*_self).finish_jsx_node(tag, attrs, [], start.merge((*_self).current_span())))
        (*_self).expect(TokenKind__Gt)?
        ()
        let mut children = Vec__new_()
        let mut last_end = (*_self).tokens.get(((*_self).pos - 1)).map(fn(t): t.span.end).unwrap_or(0)
        let mut text_buffer = String__new_()
        let mut text_start = (*_self).current_span()
        while ((!(*_self).check(TokenKind__LtSlash)) && (!(*_self).at_end())):
            let current_span = (*_self).current_span()
            if (current_span.start > last_end):
                if (!text_buffer.is_empty()):
                    text_buffer.push(" ")
                    ()
                    ()
                    ()
                    ()
                ()
            if (*_self).check(TokenKind__LBrace):
                if (!text_buffer.is_empty()):
                    children.push(JSXNode::Text(text_buffer.clone(), text_start.merge(Span__new_(last_end, last_end))))
                    ()
                    text_buffer.clear()
                    ()
                    ()
                    ()
                    ()
                children.push((*_self).parse_jsx_braced_child()?)
                ()
                last_end = (*_self).tokens.get(((*_self).pos - 1)).map(fn(t): t.span.end).unwrap_or(0)
                ()
                text_start = (*_self).current_span()
                ()
            elif (*_self).check(TokenKind__Lt):
                if (!text_buffer.is_empty()):
                    children.push(JSXNode::Text(text_buffer.clone(), text_start.merge(Span__new_(last_end, last_end))))
                    ()
                    text_buffer.clear()
                    ()
                    ()
                    ()
                    ()
                children.push((*_self).parse_jsx_element()?)
                ()
                last_end = (*_self).tokens.get(((*_self).pos - 1)).map(fn(t): t.span.end).unwrap_or(0)
                ()
                text_start = (*_self).current_span()
                ()
            else:
                let mut consumed_text = none
                match (*_self).peek_kind():
                    TokenKind::String(s) =>
                        consumed_text = Option::Some(s)
                        ()
                    TokenKind::Ident(s) =>
                        consumed_text = Option::Some(s)
                        ()
                    TokenKind::Int(n) =>
                        consumed_text = Option::Some(n.to_string())
                        ()
                    TokenKind::Newline(_) =>
                        if ((!text_buffer.is_empty()) && (!text_buffer.ends_with(" "))):
                            text_buffer.push(" ")
                            ()
                            ()
                            ()
                            ()
                        (*_self).advance()
                        ()
                        ()
                        ()
                        ()
                    TokenKind::Indent =>
                        if ((!text_buffer.is_empty()) && (!text_buffer.ends_with(" "))):
                            text_buffer.push(" ")
                            ()
                            ()
                            ()
                            ()
                        (*_self).advance()
                        ()
                        ()
                        ()
                        ()
                    TokenKind::Dedent =>
                        if ((!text_buffer.is_empty()) && (!text_buffer.ends_with(" "))):
                            text_buffer.push(" ")
                            ()
                            ()
                            ()
                            ()
                        (*_self).advance()
                        ()
                        ()
                        ()
                        ()
                    TokenKind::Colon =>
                        consumed_text = Option::Some((":").to_string())
                        ()
                    TokenKind::Comma =>
                        consumed_text = Option::Some((",").to_string())
                        ()
                    TokenKind::Dot =>
                        consumed_text = Option::Some((".").to_string())
                        ()
                    TokenKind::Question =>
                        consumed_text = Option::Some(("?").to_string())
                        ()
                    TokenKind::QuestionQuestion =>
                        consumed_text = Option::Some(("??").to_string())
                        ()
                    TokenKind::QuestionDot =>
                        consumed_text = Option::Some(("?.").to_string())
                        ()
                    TokenKind::Not =>
                        consumed_text = Option::Some(("!").to_string())
                        ()
                    TokenKind::Minus =>
                        consumed_text = Option::Some(("-").to_string())
                        ()
                    TokenKind::PlusPlus =>
                        consumed_text = Option::Some(("++").to_string())
                        ()
                    TokenKind::MinusMinus =>
                        consumed_text = Option::Some(("--").to_string())
                        ()
                    TokenKind::Eq =>
                        consumed_text = Option::Some(("=").to_string())
                        ()
                    TokenKind::Plus =>
                        consumed_text = Option::Some(("+").to_string())
                        ()
                    TokenKind::Star =>
                        consumed_text = Option::Some(("*").to_string())
                        ()
                    TokenKind::Slash =>
                        consumed_text = Option::Some(("/").to_string())
                        ()
                    TokenKind::Percent =>
                        consumed_text = Option::Some(("%").to_string())
                        ()
                    TokenKind::Amp =>
                        consumed_text = Option::Some(("&").to_string())
                        ()
                    TokenKind::Pipe =>
                        consumed_text = Option::Some(("|").to_string())
                        ()
                    TokenKind::At =>
                        consumed_text = Option::Some(("@").to_string())
                        ()
                    TokenKind::Tilde =>
                        consumed_text = Option::Some(("~").to_string())
                        ()
                    TokenKind::Caret =>
                        consumed_text = Option::Some(("^").to_string())
                        ()
                    TokenKind::LParen =>
                        consumed_text = Option::Some(("(").to_string())
                        ()
                    TokenKind::RParen =>
                        consumed_text = Option::Some((")").to_string())
                        ()
                    TokenKind::LBracket =>
                        consumed_text = Option::Some(("[").to_string())
                        ()
                    TokenKind::RBracket =>
                        consumed_text = Option::Some(("]").to_string())
                        ()
                    TokenKind::Arrow =>
                        consumed_text = Option::Some(("->").to_string())
                        ()
                    TokenKind::FatArrow =>
                        consumed_text = Option::Some(("=>").to_string())
                        ()
                    TokenKind::ColonColon =>
                        consumed_text = Option::Some(("::").to_string())
                        ()
                    TokenKind::And =>
                        consumed_text = Option::Some(("and").to_string())
                        ()
                    TokenKind::Or =>
                        consumed_text = Option::Some(("or").to_string())
                        ()
                    TokenKind::Gpu =>
                        consumed_text = Option::Some(("GPU").to_string())
                        ()
                    TokenKind::Io =>
                        consumed_text = Option::Some(("IO").to_string())
                        ()
                    TokenKind::Fn =>
                        consumed_text = Option::Some(("fn").to_string())
                        ()
                    TokenKind::Let =>
                        consumed_text = Option::Some(("let").to_string())
                        ()
                    TokenKind::Mut =>
                        consumed_text = Option::Some(("mut").to_string())
                        ()
                    TokenKind::Var =>
                        consumed_text = Option::Some(("var").to_string())
                        ()
                    TokenKind::Const =>
                        consumed_text = Option::Some(("const").to_string())
                        ()
                    TokenKind::If =>
                        consumed_text = Option::Some(("if").to_string())
                        ()
                    TokenKind::Else =>
                        consumed_text = Option::Some(("else").to_string())
                        ()
                    TokenKind::Match =>
                        consumed_text = Option::Some(("match").to_string())
                        ()
                    TokenKind::For =>
                        consumed_text = Option::Some(("for").to_string())
                        ()
                    TokenKind::While =>
                        consumed_text = Option::Some(("while").to_string())
                        ()
                    TokenKind::Loop =>
                        consumed_text = Option::Some(("loop").to_string())
                        ()
                    TokenKind::Break =>
                        consumed_text = Option::Some(("break").to_string())
                        ()
                    TokenKind::Continue =>
                        consumed_text = Option::Some(("continue").to_string())
                        ()
                    TokenKind::Return =>
                        consumed_text = Option::Some(("return").to_string())
                        ()
                    TokenKind::Await =>
                        consumed_text = Option::Some(("await").to_string())
                        ()
                    TokenKind::In =>
                        consumed_text = Option::Some(("in").to_string())
                        ()
                    TokenKind::With =>
                        consumed_text = Option::Some(("with").to_string())
                        ()
                    TokenKind::As =>
                        consumed_text = Option::Some(("as").to_string())
                        ()
                    TokenKind::TypeKw =>
                        consumed_text = Option::Some(("type").to_string())
                        ()
                    TokenKind::Struct =>
                        consumed_text = Option::Some(("struct").to_string())
                        ()
                    TokenKind::Enum =>
                        consumed_text = Option::Some(("enum").to_string())
                        ()
                    TokenKind::Trait =>
                        consumed_text = Option::Some(("trait").to_string())
                        ()
                    TokenKind::Impl =>
                        consumed_text = Option::Some(("impl").to_string())
                        ()
                    TokenKind::Pub =>
                        consumed_text = Option::Some(("pub").to_string())
                        ()
                    TokenKind::Mod =>
                        consumed_text = Option::Some(("mod").to_string())
                        ()
                    TokenKind::Use =>
                        consumed_text = Option::Some(("use").to_string())
                        ()
                    TokenKind::True =>
                        consumed_text = Option::Some(("true").to_string())
                        ()
                    TokenKind::False =>
                        consumed_text = Option::Some(("false").to_string())
                        ()
                    TokenKind::Pure_ =>
                        consumed_text = Option::Some(("Pure").to_string())
                        ()
                    TokenKind::Async_ =>
                        consumed_text = Option::Some(("Async").to_string())
                        ()
                    TokenKind::Component =>
                        consumed_text = Option::Some(("component").to_string())
                        ()
                    TokenKind::Shader =>
                        consumed_text = Option::Some(("shader").to_string())
                        ()
                    TokenKind::Actor =>
                        consumed_text = Option::Some(("actor").to_string())
                        ()
                    TokenKind::Spawn =>
                        consumed_text = Option::Some(("spawn").to_string())
                        ()
                    TokenKind::Test =>
                        consumed_text = Option::Some(("test").to_string())
                        ()
                    TokenKind::Reactive_ =>
                        consumed_text = Option::Some(("Reactive").to_string())
                        ()
                    TokenKind::Unsafe_ =>
                        consumed_text = Option::Some(("Unsafe").to_string())
                        ()
                    TokenKind::Vertex =>
                        consumed_text = Option::Some(("vertex").to_string())
                        ()
                    TokenKind::Fragment =>
                        consumed_text = Option::Some(("fragment").to_string())
                        ()
                    _ => return Result::Err((*_self).parser_error("Unexpected token in JSX child: {error__token_kind_to_user_string(&(*_self).peek_kind())}. Use strings or {} for text.", (*_self).current_span()))
                match consumed_text:
                    Some(t) =>
                        if text_buffer.is_empty():
                            text_start = (*_self).current_span()
                            ()
                            ()
                            ()
                            ()
                        text_buffer.push_str(&t)
                        ()
                        (*_self).advance()
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                last_end = (*_self).tokens.get(((*_self).pos - 1)).map(fn(t): t.span.end).unwrap_or(0)
                ()
        ()
        if (!text_buffer.is_empty()):
            children.push(JSXNode::Text(text_buffer, text_start.merge(Span__new_(last_end, last_end))))
            ()
            ()
            ()
            ()
        (*_self).expect(TokenKind__LtSlash)?
        ()
        let closing_tag = (*_self).parse_jsx_tag_name()?
        if (closing_tag != tag):
            return Result::Err((*_self).parser_error(f"Expected closing tag </{tag}>, found </{closing_tag}>", (*_self).current_span()))
        (*_self).expect(TokenKind__Gt)?
        ()
        Result::Ok((*_self).finish_jsx_node(tag, attrs, children, start.merge((*_self).current_span())))

    fn parse_jsx_tag_name(_self: &mut Parser<a>) -> Result<String, KainError>:
        let span = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                (*_self).advance()
                ()
                Result::Ok(s)
            TokenKind::Fragment =>
                (*_self).advance()
                ()
                Result::Ok(("Fragment").to_string())
            TokenKind::Component =>
                (*_self).advance()
                ()
                Result::Ok(("component").to_string())
            other => Result::Err((*_self).parser_error(f"Expected JSX tag name, found {error__token_kind_to_user_string(&other)}", span))

    fn parse_jsx_attribute_name(_self: &mut Parser<a>) -> Result<String, KainError>:
        let span = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                (*_self).advance()
                ()
                Result::Ok(s)
            other =>
                let source = (*_self).span_mapper.source()
                let text = if ((span.end <= source.len()) && (span.start <= span.end)):
                    &source[span.start..span.end]
                else:
                    ""
                if ((!text.is_empty()) && text.chars().enumerate().all(fn(__kain_closure_arg0): if (__kain_closure_arg0.__kain_tuple_0 == 0): (__kain_closure_arg0.__kain_tuple_1.is_ascii_alphabetic() || (__kain_closure_arg0.__kain_tuple_1 == "_")) else: (__kain_closure_arg0.__kain_tuple_1.is_ascii_alphanumeric() || (__kain_closure_arg0.__kain_tuple_1 == "_")))):
                    (*_self).advance()
                    ()
                    Result::Ok(text.to_string())
                else:
                    Result::Err((*_self).parser_error(f"Expected JSX attribute name, found {error__token_kind_to_user_string(&other)}", span))

    fn finish_jsx_node(_self: &Parser<a>, tag: String, attributes: Array<JSXAttribute>, children: Array<JSXNode>, span: Span) -> JSXNode:
        if (tag == "Fragment"):
            return JSXNode::Fragment(children, span)
        if tag.chars().next().is_some_and(fn(c): c.is_ascii_uppercase()):
            JSXNode::ComponentCall { name: tag, props: attributes, children: children, span: span }
        else:
            JSXNode::Element { tag: tag, attributes: attributes, children: children, span: span }

    fn parse_jsx_braced_child(_self: &mut Parser<a>) -> Result<JSXNode, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__LBrace)?
        ()
        let node = if (*_self).check(TokenKind__If):
            (*_self).advance()
            ()
            let condition = (*_self).parse_expr()?
            (*_self).expect(TokenKind__Colon)?
            ()
            let then_branch = (*_self).parse_jsx_inline_node()?
            let else_branch = if (*_self).check(TokenKind__Else):
                (*_self).advance()
                ()
                (*_self).expect(TokenKind__Colon)?
                ()
                Option::Some(Box__new_((*_self).parse_jsx_inline_node()?))
            else:
                none
            JSXNode::If { condition: Box__new_(condition), then_branch: Box__new_(then_branch), else_branch: else_branch, span: start.merge((*_self).current_span()) }
        elif (*_self).check(TokenKind__For):
            (*_self).advance()
            ()
            let binding = (*_self).parse_ident()?
            (*_self).expect(TokenKind__In)?
            ()
            let iter = (*_self).parse_expr()?
            (*_self).expect(TokenKind__Colon)?
            ()
            let body = (*_self).parse_jsx_inline_node()?
            JSXNode::For { binding: binding, iter: Box__new_(iter), body: Box__new_(body), span: start.merge((*_self).current_span()) }
        else:
            JSXNode::Expression(Box__new_((*_self).parse_expr()?))
        (*_self).expect(TokenKind__RBrace)?
        ()
        Result::Ok(node)

    fn parse_jsx_inline_node(_self: &mut Parser<a>) -> Result<JSXNode, KainError>:
        if (*_self).check(TokenKind__Lt):
            (*_self).parse_jsx_element()
        elif (*_self).check(TokenKind__LBrace):
            (*_self).parse_jsx_braced_child()
        else:
            Result::Ok(JSXNode::Expression(Box__new_((*_self).parse_expr()?)))

    fn parse_call_args(_self: &mut Parser<a>) -> Result<Array<CallArg>, KainError>:
        let mut args = Vec__new_()
        (*_self).skip_formatting()
        ()
        while ((!(*_self).check(TokenKind__RParen)) && (!(*_self).at_end())):
            let mut name = none
            match (*_self).peek_kind():
                TokenKind::Ident(s) =>
                    if (*_self).tokens.get(((*_self).pos + 1)).map(fn(t): (t.kind == TokenKind__Eq)).unwrap_or(false):
                        name = Option::Some(s)
                        ()
                        (*_self).advance()
                        ()
                        (*_self).advance()
                        ()
                        ()
                        ()
                        ()
                    ()
                _ =>
                    ()
                    ()
            let value = (*_self).parse_expr()?
            args.push(CallArg { name: name, value: value, span: (*_self).current_span() })
            ()
            (*_self).skip_formatting()
            ()
            if (!(*_self).check(TokenKind__RParen)):
                (*_self).expect(TokenKind__Comma)?
                ()
                (*_self).skip_formatting()
                ()
        ()
        Result::Ok(args)

    fn parse_visibility(_self: &mut Parser<a>) -> Visibility:
        if (*_self).check(TokenKind__Pub):
            (*_self).advance()
            ()
            Visibility__Public
        else:
            Visibility__Private

    fn parse_ident(_self: &mut Parser<a>) -> Result<String, KainError>:
        let span = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                (*_self).advance()
                ()
                (*_self).validate_identifier(&s, span)?
                ()
                Result::Ok(s)
            TokenKind::SelfLower =>
                (*_self).advance()
                ()
                Result::Ok(("self").to_string())
            TokenKind::SelfUpper =>
                (*_self).advance()
                ()
                Result::Ok(("Self").to_string())
            TokenKind::Component =>
                (*_self).advance()
                ()
                Result::Ok(("component").to_string())
            TokenKind::Shader =>
                (*_self).advance()
                ()
                Result::Ok(("shader").to_string())
            TokenKind::Actor =>
                (*_self).advance()
                ()
                Result::Ok(("actor").to_string())
            TokenKind::State =>
                (*_self).advance()
                ()
                Result::Ok(("state").to_string())
            k => Result::Err((*_self).parser_error(f"{error__token_kind_to_user_string(&k)} is a reserved keyword and cannot be used as an identifier. Please choose a different name.", span))
            k => Result::Err((*_self).parser_error(f"Expected identifier, got {error__token_kind_to_user_string(&k)}", span))

    fn get_binary_op(_self: &Parser<a>) -> Option<(BinaryOp, u8)>:
        let candidate = match (*_self).peek_kind():
            TokenKind::Or => Option::Some((BinaryOp__Or, 1))
            TokenKind::And => Option::Some((BinaryOp__And, 2))
            TokenKind::Pipe => Option::Some((BinaryOp__BitOr, 3))
            TokenKind::Caret => Option::Some((BinaryOp__BitXor, 4))
            TokenKind::Amp => Option::Some((BinaryOp__BitAnd, 5))
            TokenKind::EqEq => Option::Some((BinaryOp__Eq, 6))
            TokenKind::NotEq => Option::Some((BinaryOp__Ne, 6))
            TokenKind::Lt => Option::Some((BinaryOp__Lt, 7))
            TokenKind::Gt => Option::Some((BinaryOp__Gt, 7))
            TokenKind::LtEq => Option::Some((BinaryOp__Le, 7))
            TokenKind::GtEq => Option::Some((BinaryOp__Ge, 7))
            TokenKind::Shl => Option::Some((BinaryOp__Shl, 8))
            TokenKind::Shr => Option::Some((BinaryOp__Shr, 8))
            TokenKind::Plus => Option::Some((BinaryOp__Add, 9))
            TokenKind::Minus => Option::Some((BinaryOp__Sub, 9))
            TokenKind::Star => Option::Some((BinaryOp__Mul, 10))
            TokenKind::Slash => Option::Some((BinaryOp__Div, 10))
            TokenKind::Percent => Option::Some((BinaryOp__Mod, 10))
            TokenKind::Power => Option::Some((BinaryOp__Pow, 11))
            _ => none
        candidate.filter(fn(__kain_closure_arg1): (*_self).capabilities.supports_parser_binary_op((*__kain_closure_arg1.__kain_tuple_0)))

    fn get_assignment_binop(_self: &Parser<a>) -> Option<Option<BinaryOp>>:
        match (*_self).peek_kind():
            TokenKind::Eq => Option::Some(none)
            TokenKind::PlusEq => Option::Some(Option::Some(BinaryOp__Add))
            TokenKind::MinusEq => Option::Some(Option::Some(BinaryOp__Sub))
            TokenKind::StarEq => Option::Some(Option::Some(BinaryOp__Mul))
            TokenKind::SlashEq => Option::Some(Option::Some(BinaryOp__Div))
            TokenKind::PercentEq => Option::Some(Option::Some(BinaryOp__Mod))
            TokenKind::AmpEq => Option::Some(Option::Some(BinaryOp__BitAnd))
            TokenKind::PipeEq => Option::Some(Option::Some(BinaryOp__BitOr))
            TokenKind::CaretEq => Option::Some(Option::Some(BinaryOp__BitXor))
            TokenKind::ShlEq => Option::Some(Option::Some(BinaryOp__Shl))
            TokenKind::ShrEq => Option::Some(Option::Some(BinaryOp__Shr))
            _ => none

    fn make_incdec_expr(_self: &mut Parser<a>, target: Expr, increment: Bool, prefix: Bool, span: Span) -> Result<Expr, KainError>:
        if (!none):
            return Result::Err((*_self).parser_error("Increment/decrement target must be assignable (identifier, field, index, or dereference)", span))
        let binding = (*_self).fresh_temp("__kain_incdec")
        let bound_ident = Expr::Ident(binding.clone(), span)
        let op = if increment:
            BinaryOp__Add
        else:
            BinaryOp__Sub
        let updated = Expr::Binary { left: Box__new_(bound_ident.clone()), op: op, right: Box__new_(Expr::Int(1, span)), span: span }
        let assign_expr = Expr::Assign { target: Box__new_(target.clone()), value: Box__new_(updated.clone()), span: span }
        let result_expr = if prefix:
            updated
        else:
            bound_ident
        let sequenced = Expr::Index { object: Box__new_(Expr::Array([assign_expr, result_expr], span)), index: Box__new_(Expr::Int(1, span)), span: span }
        Result::Ok(Expr::Match { scrutinee: Box__new_(target), arms: [MatchArm { pattern: Pattern::Binding { name: binding, mutable_: false, span: span }, guard: none, body: sequenced, span: span }], span: span })

    fn make_null_coalesce_expr(_self: &mut Parser<a>, left: Expr, right: Expr, span: Span) -> Result<Expr, KainError>:
        let binding = (*_self).fresh_temp("__kain_coalesce")
        Result::Ok(Expr::Match { scrutinee: Box__new_(left), arms: [MatchArm { pattern: Pattern::Literal(Expr::None(span)), guard: none, body: right, span: span }, MatchArm { pattern: Pattern::Binding { name: binding.clone(), mutable_: false, span: span }, guard: none, body: Expr::Ident(binding, span), span: span }], span: span })

    fn make_safe_nav_field_expr(_self: &mut Parser<a>, object: Expr, field: String, span: Span) -> Result<Expr, KainError>:
        let binding = (*_self).fresh_temp("__kain_safe")
        Result::Ok(Expr::Match { scrutinee: Box__new_(object), arms: [MatchArm { pattern: Pattern::Literal(Expr::None(span)), guard: none, body: Expr::None(span), span: span }, MatchArm { pattern: Pattern::Binding { name: binding.clone(), mutable_: false, span: span }, guard: none, body: Expr::Field { object: Box__new_(Expr::Ident(binding, span)), field: field, span: span }, span: span }], span: span })

    fn question_starts_ternary(_self: &Parser<a>) -> Bool:
        let mut offset = 1
        let mut paren_depth = 0
        let mut bracket_depth = 0
        let mut brace_depth = 0
        loop:
            match (*_self).peek_kind_at(offset):
                Some(kind) =>
                    let at_top_level = (((paren_depth == 0) && (bracket_depth == 0)) && (brace_depth == 0))
                    match kind:
                        TokenKind::LParen =>
                            paren_depth = (paren_depth + 1)
                            ()
                        TokenKind::RParen =>
                            if (paren_depth == 0):
                                return false
                            paren_depth = (paren_depth - 1)
                            ()
                            ()
                            ()
                            ()
                        TokenKind::LBracket =>
                            bracket_depth = (bracket_depth + 1)
                            ()
                        TokenKind::RBracket =>
                            if (bracket_depth == 0):
                                return false
                            bracket_depth = (bracket_depth - 1)
                            ()
                            ()
                            ()
                            ()
                        TokenKind::LBrace =>
                            brace_depth = (brace_depth + 1)
                            ()
                        TokenKind::RBrace =>
                            if (brace_depth == 0):
                                return false
                            brace_depth = (brace_depth - 1)
                            ()
                            ()
                            ()
                            ()
                        TokenKind::Colon if at_top_level => return true
                        TokenKind::Comma if at_top_level => return false
                        TokenKind::Semi if at_top_level => return false
                        TokenKind::Eof if at_top_level => return false
                        TokenKind::Dedent if at_top_level => return false
                        TokenKind::Newline(_) if at_top_level => return false
                        _ => ()
                    offset = (offset + 1)
                    ()
                _ => break
        ()
        false

    fn fresh_temp(_self: &mut Parser<a>, prefix: String) -> String:
        let name = f"{prefix}{(*_self).synthetic_counter}"
        (*_self).synthetic_counter = ((*_self).synthetic_counter + 1)
        ()
        name

    fn peek_kind_at(_self: &Parser<a>, offset: usize) -> Option<TokenKind>:
        if (offset < (*_self).injected_tokens.len()):
            return Option::Some((*_self).injected_tokens[offset].kind.clone())
        let base_offset = offset.saturating_sub((*_self).injected_tokens.len())
        (*_self).tokens.get(((*_self).pos + base_offset)).map(fn(t): t.kind.clone())

    fn peek_kind(_self: &Parser<a>) -> TokenKind:
        if (!(*_self).injected_tokens.is_empty()):
            return (*_self).injected_tokens[0].kind.clone()
        (*_self).tokens.get((*_self).pos).map(fn(t): t.kind.clone()).unwrap_or(TokenKind__Eof)

    fn current_span(_self: &Parser<a>) -> Span:
        if (!(*_self).injected_tokens.is_empty()):
            return (*_self).injected_tokens[0].span
        (*_self).tokens.get((*_self).pos).map(fn(t): t.span).unwrap_or(Span__new_(0, 0))

    fn at_end(_self: &Parser<a>) -> Bool:
        match (*_self).peek_kind():
            TokenKind::Eof => true
            _ => false

    fn check(_self: &Parser<a>, k: TokenKind) -> Bool:
        (std__mem__discriminant(&(*_self).peek_kind()) == std__mem__discriminant(&k))

    fn check_line_end(_self: &Parser<a>) -> Bool:
        match (*_self).peek_kind():
            TokenKind::Newline(_) => true
            TokenKind::Dedent => true
            TokenKind::Eof => true
            _ => false

    fn advance(_self: &mut Parser<a>):
        if (!(*_self).injected_tokens.is_empty()):
            (*_self).injected_tokens.remove(0)
            ()
            return
        if (!(*_self).at_end()):
            (*_self).pos = ((*_self).pos + 1)
            ()

    fn skip_newlines(_self: &mut Parser<a>):
        loop:
            match (*_self).peek_kind():
                TokenKind::Newline(_) =>
                    (*_self).advance()
                    ()
                _ => break

    fn check_newline(_self: &Parser<a>) -> Bool:
        match (*_self).peek_kind():
            TokenKind::Newline(_) => true
            _ => false

    fn peek_contextual_ident(_self: &Parser<a>, expected: String) -> Bool:
        match (*_self).peek_kind():
            TokenKind::Ident(value) if (value == expected) => true
            _ => false

    fn skip_formatting(_self: &mut Parser<a>):
        while none:
            (*_self).advance()
            ()

    fn inject_token(_self: &mut Parser<a>, token: Token):
        (*_self).injected_tokens.push(token)
        ()

    fn expect(_self: &mut Parser<a>, k: TokenKind) -> Result<(), KainError>:
        if (*_self).check(k.clone()):
            (*_self).advance()
            ()
            Result::Ok(())
        else:
            Result::Err((*_self).parser_error(f"Expected {error__token_kind_to_user_string(&k)}, got {error__token_kind_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))

    fn expect_contextual_ident(_self: &mut Parser<a>, expected: String) -> Result<(), KainError>:
        if (*_self).peek_contextual_ident(expected):
            (*_self).advance()
            ()
            Result::Ok(())
        else:
            Result::Err((*_self).parser_error(f"Expected contextual keyword '{expected}', got {error__token_kind_to_user_string(&(*_self).peek_kind())}", (*_self).current_span()))

    fn parse_graph_runtime(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut graph_data = none
        let mut node_types = Vec__new_()
        let mut instance = none
        let mut pin_config = none
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let nested_attrs = (*_self).parse_attributes()?
            if nested_attrs.iter().any(fn(a): (a.name == "graph_data")):
                graph_data = Option::Some((*_self).parse_graph_data(nested_attrs)?)
                ()
                ()
                ()
                ()
            elif nested_attrs.iter().any(fn(a): (a.name == "node_data")):
                node_types.push((*_self).parse_node_data(nested_attrs)?)
                ()
                ()
                ()
                ()
            elif nested_attrs.iter().any(fn(a): (a.name == "instance")):
                instance = Option::Some((*_self).parse_graph_instance(nested_attrs)?)
                ()
                ()
                ()
                ()
            elif nested_attrs.iter().any(fn(a): (a.name == "pin_config")):
                pin_config = Option::Some((*_self).parse_pin_config(nested_attrs)?)
                ()
                ()
                ()
                ()
            else:
                return Result::Err((*_self).parser_error(f"Expected @graph_data, @node_data, @instance, or @pin_config attribute in graph runtime body, found {(*_self).token_to_user_string(&(*_self).peek_kind())}. Graph runtimes define the execution model for custom graph editors", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::GraphRuntime(GraphRuntimeDef { name: name, attributes: attributes, graph_data: graph_data, node_types: node_types, instance: instance, pin_config: pin_config, span: start.merge((*_self).current_span()) }))

    fn parse_graph_data(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<GraphDataDef, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let _ = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut properties = Vec__new_()
        let mut methods = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let field_attrs = (*_self).parse_attributes()?
            if (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function(Visibility__Public)?):
                    Item::Function(f) =>
                        methods.push(f)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                let prop_name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                let prop_ty = (*_self).parse_type()?
                let default_ = if (*_self).check(TokenKind__Eq):
                    (*_self).advance()
                    ()
                    Option::Some((*_self).parse_expr()?)
                else:
                    none
                properties.push(Field { name: prop_name, ty: prop_ty, attributes: field_attrs, visibility: Visibility__Public, default_: default_, weak_: false, span: (*_self).current_span() })
                ()
                ()
                ()
                ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(GraphDataDef { properties: properties, methods: methods, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn parse_node_data(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<NodeDataDef, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let name = (*_self).parse_ident()?
        let base_class = if (*_self).check(TokenKind__LParen):
            (*_self).advance()
            ()
            let base = (*_self).parse_ident()?
            (*_self).expect(TokenKind__RParen)?
            ()
            Option::Some(base)
        else:
            none
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut input_pins = Vec__new_()
        let mut output_pins = Vec__new_()
        let mut properties = Vec__new_()
        let mut methods = Vec__new_()
        let mut execute_logic = none
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let field_attrs = (*_self).parse_attributes()?
            if field_attrs.iter().any(fn(a): (a.name == "input_pin")):
                input_pins.push((*_self).parse_pin_def(field_attrs)?)
                ()
                ()
                ()
                ()
            elif field_attrs.iter().any(fn(a): (a.name == "output_pin")):
                output_pins.push((*_self).parse_pin_def(field_attrs)?)
                ()
                ()
                ()
                ()
            elif field_attrs.iter().any(fn(a): (a.name == "property")):
                let prop_name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                let prop_ty = (*_self).parse_type()?
                let default_ = if (*_self).check(TokenKind__Eq):
                    (*_self).advance()
                    ()
                    Option::Some((*_self).parse_expr()?)
                else:
                    none
                properties.push(Field { name: prop_name, ty: prop_ty, attributes: field_attrs, visibility: Visibility__Public, default_: default_, weak_: false, span: (*_self).current_span() })
                ()
                ()
                ()
                ()
            elif (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function(Visibility__Public)?):
                    Item::Function(f) =>
                        if (f.name == "execute"):
                            execute_logic = Option::Some(f.body)
                            ()
                            ()
                            ()
                            ()
                        else:
                            methods.push(f)
                            ()
                            ()
                            ()
                            ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                return Result::Err((*_self).parser_error(f"Expected @input_pin, @output_pin, @property, or 'fn' in node data body, found {(*_self).token_to_user_string(&(*_self).peek_kind())}. Node data defines the structure and behavior of graph nodes", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(NodeDataDef { name: name, base_class: base_class, input_pins: input_pins, output_pins: output_pins, properties: properties, methods: methods, execute_logic: execute_logic, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn parse_pin_def(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<PinDef, KainError>:
        let start = (*_self).current_span()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let ty = (*_self).parse_type()?
        let is_array = match &ty:
            Type::Named { name: name } if (name == "Array") => true
            _ => false
        let default_ = if (*_self).check(TokenKind__Eq):
            (*_self).advance()
            ()
            Option::Some((*_self).parse_expr()?)
        else:
            none
        Result::Ok(PinDef { name: name, ty: ty, is_array: is_array, default_: default_, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn parse_graph_instance(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<GraphInstanceDef, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let _ = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut state_ = Vec__new_()
        let mut methods = Vec__new_()
        let mut delegates = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let field_attrs = (*_self).parse_attributes()?
            if (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function(Visibility__Public)?):
                    Item::Function(f) =>
                        methods.push(f)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                match (*_self).peek_kind():
                    TokenKind::Ident(s) =>
                        if (s == "delegate"):
                            delegates.push((*_self).parse_delegate_def(field_attrs)?)
                            ()
                            ()
                            ()
                            ()
                        else:
                            let field_name = (*_self).parse_ident()?
                            (*_self).expect(TokenKind__Colon)?
                            ()
                            let field_ty = (*_self).parse_type()?
                            let default_ = if (*_self).check(TokenKind__Eq):
                                (*_self).advance()
                                ()
                                Option::Some((*_self).parse_expr()?)
                            else:
                                none
                            state_.push(Field { name: field_name, ty: field_ty, attributes: field_attrs, visibility: Visibility__Public, default_: default_, weak_: false, span: (*_self).current_span() })
                            ()
                            ()
                            ()
                            ()
                        ()
                    _ => return Result::Err((*_self).parser_error("Expected fn, delegate, or field in instance", (*_self).current_span()))
                ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(GraphInstanceDef { state_: state_, methods: methods, delegates: delegates, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn parse_delegate_def(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<DelegateDef, KainError>:
        let start = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                if (s != "delegate"):
                    return Result::Err((*_self).parser_error("Expected 'delegate' keyword", (*_self).current_span()))
                (*_self).advance()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        let params = (*_self).parse_params()?
        (*_self).expect(TokenKind__RParen)?
        ()
        Result::Ok(DelegateDef { name: name, params: params, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn parse_pin_config(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<PinConfigDef, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let _ = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut properties = Vec__new_()
        let mut methods = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let field_attrs = (*_self).parse_attributes()?
            if (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function(Visibility__Public)?):
                    Item::Function(f) =>
                        methods.push(f)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                let prop_name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                let prop_ty = (*_self).parse_type()?
                let default_ = if (*_self).check(TokenKind__Eq):
                    (*_self).advance()
                    ()
                    Option::Some((*_self).parse_expr()?)
                else:
                    none
                properties.push(Field { name: prop_name, ty: prop_ty, attributes: field_attrs, visibility: Visibility__Public, default_: default_, weak_: false, span: (*_self).current_span() })
                ()
                ()
                ()
                ()
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(PinConfigDef { properties: properties, methods: methods, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn parse_state_machine(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut states = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            let loop_pos = (*_self).pos
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let state_attrs = (*_self).parse_attributes()?
            if state_attrs.iter().any(fn(a): (a.name == "state")):
                states.push((*_self).parse_state(state_attrs)?)
                ()
                ()
                ()
                ()
            else:
                return Result::Err((*_self).parser_error("Expected @state in state machine definition", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
            if (((*_self).pos == loop_pos) && (!(*_self).at_end())):
                (*_self).advance()
                ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::StateMachine(StateMachineDef { name: name, states: states, attributes: attributes, span: start.merge((*_self).current_span()) }))

    fn parse_state(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<StateDef, KainError>:
        let start = (*_self).current_span()
        let is_entry = attributes.iter().any(fn(attr): if (attr.name == "state"): attr.args.iter().any(fn(arg): none) else: false)
        if (*_self).check(TokenKind__Struct):
            (*_self).advance()
            ()
            ()
            ()
            ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut animation = none
        let mut properties = Vec__new_()
        let mut transitions = Vec__new_()
        let mut on_enter = none
        let mut on_exit = none
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            let loop_pos = (*_self).pos
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let field_attrs = (*_self).parse_attributes()?
            if field_attrs.iter().any(fn(a): (a.name == "transition")):
                transitions.push((*_self).parse_transition(field_attrs)?)
                ()
                ()
                ()
                ()
            elif (*_self).check(TokenKind__Fn):
                let method_name = (*_self).peek_next_ident()?
                if (method_name == "on_enter"):
                    (*_self).advance()
                    ()
                    (*_self).advance()
                    ()
                    (*_self).expect(TokenKind__LParen)?
                    ()
                    (*_self).expect(TokenKind__RParen)?
                    ()
                    (*_self).expect(TokenKind__Colon)?
                    ()
                    on_enter = Option::Some((*_self).parse_block()?)
                    ()
                    ()
                    ()
                    ()
                elif (method_name == "on_exit"):
                    (*_self).advance()
                    ()
                    (*_self).advance()
                    ()
                    (*_self).expect(TokenKind__LParen)?
                    ()
                    (*_self).expect(TokenKind__RParen)?
                    ()
                    (*_self).expect(TokenKind__Colon)?
                    ()
                    on_exit = Option::Some((*_self).parse_block()?)
                    ()
                    ()
                    ()
                    ()
                else:
                    return Result::Err((*_self).parser_error("Unexpected method in state definition. Use @transition for transitions.", (*_self).current_span()))
                ()
            else:
                let prop_name = (*_self).parse_ident()?
                (*_self).expect(TokenKind__Colon)?
                ()
                if (prop_name == "animation"):
                    match ((*_self).parse_expr()?):
                        Expr::String(anim_name, _) =>
                            animation = Option::Some(anim_name)
                            ()
                            ()
                            ()
                            ()
                        _ => return Result::Err((*_self).parser_error("Expected string literal for animation property", (*_self).current_span()))
                    ()
                else:
                    let prop_ty = (*_self).parse_type()?
                    let default_ = if (*_self).check(TokenKind__Eq):
                        (*_self).advance()
                        ()
                        Option::Some((*_self).parse_expr()?)
                    else:
                        none
                    properties.push(Field { name: prop_name, ty: prop_ty, attributes: field_attrs, visibility: Visibility__Public, default_: default_, weak_: false, span: (*_self).current_span() })
                    ()
                    ()
                    ()
                    ()
                ()
            (*_self).skip_newlines()
            ()
            if (((*_self).pos == loop_pos) && (!(*_self).at_end())):
                (*_self).advance()
                ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(StateDef { name: name, is_entry: is_entry, animation: animation, properties: properties, transitions: transitions, on_enter: on_enter, on_exit: on_exit, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn parse_transition(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<TransitionDef, KainError>:
        let start = (*_self).current_span()
        let to_state = attributes.iter().find(fn(a): (a.name == "transition")).and_then(fn(attr): attr.args.iter().find_map(fn(arg): none)).ok_or_else(fn(): (*_self).parser_error("Expected 'to' parameter in @transition attribute", (*_self).current_span()))?
        (*_self).expect(TokenKind__Fn)?
        ()
        let condition_name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__LParen)?
        ()
        (*_self).expect(TokenKind__RParen)?
        ()
        (*_self).expect(TokenKind__Arrow)?
        ()
        let return_type_2 = (*_self).parse_type()?
        (*_self).expect(TokenKind__Colon)?
        ()
        let condition = Option::Some((*_self).parse_block()?)
        Result::Ok(TransitionDef { to_state: to_state, condition: condition, priority: 0, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn peek_next_ident(_self: &Parser<a>) -> Result<String, KainError>:
        if (((*_self).pos + 1) < (*_self).tokens.len()):
            match &(*_self).tokens[((*_self).pos + 1)].kind:
                TokenKind::Ident(name) => Result::Ok(name.clone())
                _ => Result::Err((*_self).parser_error("Expected identifier", (*_self).current_span()))
        else:
            Result::Err((*_self).parser_error("Unexpected end of input", (*_self).current_span()))

    fn parse_editor_module(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut menu_entries = Vec__new_()
        let mut toolbar_buttons = Vec__new_()
        let mut toolbar_widgets = Vec__new_()
        let mut methods = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let method_attrs = (*_self).parse_attributes()?
            let is_menu_entry = method_attrs.iter().any(fn(a): (a.name == "menu_entry"))
            let is_toolbar_button = method_attrs.iter().any(fn(a): (a.name == "toolbar_button"))
            let is_toolbar_widget = method_attrs.iter().any(fn(a): (a.name == "toolbar_widget"))
            if is_menu_entry:
                let menu_entry = (*_self).parse_menu_entry(method_attrs)?
                menu_entries.push(menu_entry)
                ()
                ()
                ()
                ()
            elif is_toolbar_button:
                let toolbar_button = (*_self).parse_toolbar_button(method_attrs)?
                toolbar_buttons.push(toolbar_button)
                ()
                ()
                ()
                ()
            elif is_toolbar_widget:
                let toolbar_widget = (*_self).parse_toolbar_widget(method_attrs)?
                toolbar_widgets.push(toolbar_widget)
                ()
                ()
                ()
                ()
            elif (*_self).check(TokenKind__Fn):
                match ((*_self).parse_function_with_attrs(Visibility__Public, method_attrs)?):
                    Item::Function(func) =>
                        methods.push(func)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                return Result::Err((*_self).parser_error("Expected @menu_entry, @toolbar_button, @toolbar_widget, or fn in editor module", (*_self).current_span()))
            (*_self).skip_newlines()
            ()
        ()
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::EditorModule(EditorModuleDef { name: name, menu_entries: menu_entries, toolbar_buttons: toolbar_buttons, toolbar_widgets: toolbar_widgets, methods: methods, attributes: attributes, span: start.merge((*_self).current_span()) }))

    fn parse_menu_entry(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<MenuEntryDef, KainError>:
        let start = (*_self).current_span()
        let menu_attr = attributes.iter().find(fn(a): (a.name == "menu_entry")).ok_or_else(fn(): (*_self).parser_error("Expected @menu_entry attribute", (*_self).current_span()))?
        let mut path = none
        let mut label = none
        let mut icon = none
        let mut tooltip = none
        for arg in &menu_attr.args:
            match arg:
                Expr::Tuple(parts, _) =>
                    if (parts.len() == 2):
                        match (&parts[0], &parts[1]):
                            (Expr::Ident(param_name, _), Expr::String(value, _)) =>
                                match param_name.as_str():
                                    "path" => path = Option::Some(value.clone())
                                    "label" => label = Option::Some(value.clone())
                                    "icon" => icon = Option::Some(value.clone())
                                    "tooltip" => tooltip = Option::Some(value.clone())
                                    _ => ()
                            _ => ()
                _ => ()
        ()
        let path = path.ok_or_else(fn(): (*_self).parser_error("@menu_entry requires 'path' parameter", (*_self).current_span()))?
        let label = label.ok_or_else(fn(): (*_self).parser_error("@menu_entry requires 'label' parameter", (*_self).current_span()))?
        match ((*_self).parse_function_with_attrs(Visibility__Public, [])?):
            Item::Function(method) => Result::Ok(MenuEntryDef { path: path, label: label, method: method, icon: icon, tooltip: tooltip, attributes: attributes, span: start.merge((*_self).current_span()) })
            _ => Result::Err((*_self).parser_error("Expected function after @menu_entry", (*_self).current_span()))

    fn parse_toolbar_button(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<ToolbarButtonDef, KainError>:
        let start = (*_self).current_span()
        let toolbar_attr = attributes.iter().find(fn(a): (a.name == "toolbar_button")).ok_or_else(fn(): (*_self).parser_error("Expected @toolbar_button attribute", (*_self).current_span()))?
        let mut section = none
        let mut label = none
        let mut icon = none
        let mut tooltip = none
        for arg in &toolbar_attr.args:
            match arg:
                Expr::Tuple(parts, _) =>
                    if (parts.len() == 2):
                        match (&parts[0], &parts[1]):
                            (Expr::Ident(param_name, _), Expr::String(value, _)) =>
                                match param_name.as_str():
                                    "section" => section = Option::Some(value.clone())
                                    "label" => label = Option::Some(value.clone())
                                    "icon" => icon = Option::Some(value.clone())
                                    "tooltip" => tooltip = Option::Some(value.clone())
                                    _ => ()
                            _ => ()
                _ => ()
        ()
        let section = section.ok_or_else(fn(): (*_self).parser_error("@toolbar_button requires 'section' parameter", (*_self).current_span()))?
        let icon = icon.ok_or_else(fn(): (*_self).parser_error("@toolbar_button requires 'icon' parameter", (*_self).current_span()))?
        match ((*_self).parse_function_with_attrs(Visibility__Public, [])?):
            Item::Function(method) => Result::Ok(ToolbarButtonDef { section: section, label: label, icon: icon, method: method, tooltip: tooltip, attributes: attributes, span: start.merge((*_self).current_span()) })
            _ => Result::Err((*_self).parser_error("Expected function after @toolbar_button", (*_self).current_span()))

    fn parse_toolbar_widget(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<ToolbarWidgetDef, KainError>:
        let start = (*_self).current_span()
        let widget_attr = attributes.iter().find(fn(a): (a.name == "toolbar_widget")).ok_or_else(fn(): (*_self).parser_error("Expected @toolbar_widget attribute", (*_self).current_span()))?
        let mut section = none
        let mut position = none
        let mut widget_type = none
        for arg in &widget_attr.args:
            match arg:
                Expr::Tuple(parts, _) =>
                    if (parts.len() == 2):
                        match &parts[0]:
                            Expr::Ident(param_name, _) =>
                                match param_name.as_str():
                                    "section" =>
                                        match &parts[1]:
                                            Expr::String(value, _) =>
                                                section = Option::Some(value.clone())
                                                ()
                                            _ => ()
                                    "position" =>
                                        match &parts[1]:
                                            Expr::Ident(pos, _) =>
                                                position = Option::Some(none)
                                                ()
                                            _ => ()
                                    "widget_type" =>
                                        match &parts[1]:
                                            Expr::String(value, _) =>
                                                widget_type = Option::Some(value.clone())
                                                ()
                                            _ => ()
                                    _ => ()
                            _ => ()
                _ => ()
        ()
        let section = section.ok_or_else(fn(): (*_self).parser_error("@toolbar_widget requires 'section' parameter", (*_self).current_span()))?
        let position = position.unwrap_or(ToolbarPosition__After)
        let widget_type = widget_type.ok_or_else(fn(): (*_self).parser_error("@toolbar_widget requires 'widget_type' parameter", (*_self).current_span()))?
        Result::Ok(ToolbarWidgetDef { section: section, position: position, widget_type: widget_type, attributes: attributes, span: start.merge((*_self).current_span()) })

    fn parse_gameplay_tags(_self: &mut Parser<a>, _attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).skip_formatting()
        ()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                if (s != "namespace"):
                    return Result::Err((*_self).parser_error("Expected 'namespace' keyword after @gameplay_tags", (*_self).current_span()))
                (*_self).advance()
                ()
                ()
                ()
                ()
            _ => return Result::Err((*_self).parser_error("Expected 'namespace' keyword after @gameplay_tags", (*_self).current_span()))
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let children = (*_self).parse_tag_hierarchy(&name)?
        if (*_self).check(TokenKind__Dedent):
            (*_self).advance()
            ()
            ()
            ()
            ()
        Result::Ok(Item::GameplayTags(GameplayTagsNamespace { name: name, children: children, span: start.merge((*_self).current_span()) }))

    fn parse_tag_hierarchy(_self: &mut Parser<a>, parent_path: String) -> Result<Array<GameplayTagNode>, KainError>:
        let mut nodes = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            let start = (*_self).current_span()
            let tag_name = (*_self).parse_tag_name()?
            let full_path = if parent_path.is_empty():
                tag_name.clone()
            else:
                f"{parent_path}.{tag_name}"
            let comment = none
            let children = if (*_self).check(TokenKind__Colon):
                (*_self).advance()
                ()
                (*_self).skip_newlines()
                ()
                if (*_self).check(TokenKind__Indent):
                    (*_self).advance()
                    ()
                    let child_nodes = (*_self).parse_tag_hierarchy(&full_path)?
                    if (*_self).check(TokenKind__Dedent):
                        (*_self).advance()
                        ()
                        ()
                        ()
                        ()
                    child_nodes
                else:
                    Vec__new_()
            else:
                Vec__new_()
            nodes.push(GameplayTagNode { name: tag_name, full_path: full_path, comment: comment, children: children, span: start.merge((*_self).current_span()) })
            ()
            (*_self).skip_newlines()
            ()
        ()
        Result::Ok(nodes)

    fn parse_tag_name(_self: &mut Parser<a>) -> Result<String, KainError>:
        let span = (*_self).current_span()
        match (*_self).peek_kind():
            TokenKind::Ident(s) =>
                (*_self).advance()
                ()
                Result::Ok(s)
            TokenKind::Pure_ =>
                (*_self).advance()
                ()
                Result::Ok(("Pure").to_string())
            TokenKind::Io =>
                (*_self).advance()
                ()
                Result::Ok(("IO").to_string())
            TokenKind::Async_ =>
                (*_self).advance()
                ()
                Result::Ok(("Async").to_string())
            TokenKind::AsyncKw =>
                (*_self).advance()
                ()
                Result::Ok(("async").to_string())
            TokenKind::Reactive_ =>
                (*_self).advance()
                ()
                Result::Ok(("Reactive").to_string())
            TokenKind::Unsafe_ =>
                (*_self).advance()
                ()
                Result::Ok(("Unsafe").to_string())
            TokenKind::Gpu =>
                (*_self).advance()
                ()
                Result::Ok(("GPU").to_string())
            TokenKind::True =>
                (*_self).advance()
                ()
                Result::Ok(("true").to_string())
            TokenKind::False =>
                (*_self).advance()
                ()
                Result::Ok(("false").to_string())
            TokenKind::None =>
                (*_self).advance()
                ()
                Result::Ok(("none").to_string())
            k => Result::Err((*_self).parser_error(f"Expected gameplay tag name, got {error__token_kind_to_user_string(&k)}", span))

    fn parse_gameplay_ability(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
        (*_self).expect(TokenKind__Struct)?
        ()
        let name = (*_self).parse_ident()?
        (*_self).expect(TokenKind__Colon)?
        ()
        (*_self).skip_newlines()
        ()
        (*_self).expect(TokenKind__Indent)?
        ()
        let mut instancing_policy: Option<String> = none
        let mut replication_policy: Option<String> = none
        let mut net_execution_policy: Option<String> = none
        let mut ability_tags: Array<String> = Vec__new_()
        let mut activation_required_tags: Array<String> = Vec__new_()
        let mut activation_blocked_tags: Array<String> = Vec__new_()
        let mut activation_owned_tags: Array<String> = Vec__new_()
        let mut cancel_abilities_with_tag: Array<String> = Vec__new_()
        let mut block_abilities_with_tag: Array<String> = Vec__new_()
        let mut cost_effect: Option<String> = none
        let mut cooldown_effect: Option<String> = none
        let mut methods: Array<Function> = Vec__new_()
        while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
            (*_self).skip_newlines()
            ()
            if (*_self).check(TokenKind__Dedent):
                break
            if (*_self).check(TokenKind__At):
                let attr_start = (*_self).current_span()
                (*_self).advance()
                ()
                let attr_name = (*_self).parse_attribute_name()?
                match attr_name.as_str():
                    "instancing" =>
                        (*_self).expect(TokenKind__LParen)?
                        ()
                        match (*_self).peek_kind():
                            TokenKind::Ident(s) =>
                                if (s == "policy"):
                                    (*_self).advance()
                                    ()
                                    (*_self).expect(TokenKind__Colon)?
                                    ()
                                    match (*_self).peek_kind():
                                        TokenKind::String(policy_str) =>
                                            instancing_policy = Option::Some(policy_str)
                                            ()
                                            (*_self).advance()
                                            ()
                                            ()
                                            ()
                                            ()
                                        _ => return Result::Err((*_self).parser_error("Expected string value for instancing policy", (*_self).current_span()))
                                    ()
                                else:
                                    return Result::Err((*_self).parser_error("Expected 'policy' parameter in @instancing", (*_self).current_span()))
                                ()
                            _ => return Result::Err((*_self).parser_error("Expected 'policy' parameter in @instancing", (*_self).current_span()))
                        (*_self).expect(TokenKind__RParen)?
                        ()
                        ()
                        ()
                        ()
                    "replication" =>
                        (*_self).expect(TokenKind__LParen)?
                        ()
                        match (*_self).peek_kind():
                            TokenKind::Ident(s) =>
                                if (s == "policy"):
                                    (*_self).advance()
                                    ()
                                    (*_self).expect(TokenKind__Colon)?
                                    ()
                                    match (*_self).peek_kind():
                                        TokenKind::String(policy_str) =>
                                            replication_policy = Option::Some(policy_str)
                                            ()
                                            (*_self).advance()
                                            ()
                                            ()
                                            ()
                                            ()
                                        _ => return Result::Err((*_self).parser_error("Expected string value for replication policy", (*_self).current_span()))
                                    ()
                                else:
