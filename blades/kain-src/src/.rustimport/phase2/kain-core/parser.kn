                        [Param { name: ("delta_time").to_string(), ty: Type::Named { name: ("Float").to_string(), generics: [], span: (*_self).current_span() }, mutable_: false, default_: none, span: (*_self).current_span() }]
                    else:
                        []
                    let func_def = Function { name: field_name.clone(), generics: [], params: params, return_type: none, effects: [], body: Block { stmts: body_stmts, span: (*_self).current_span() }, visibility: Visibility__Private, attributes: [], span: (*_self).current_span() }
                    match field_name.as_str():
                        "on_execute" =>
                            on_execute = Option::Some(func_def)
                            ()
                        "on_add" =>
                            on_add = Option::Some(func_def)
                            ()
                        "on_remove" =>
                            on_remove = Option::Some(func_def)
                            ()
                        "while_active" =>
                            while_active = Option::Some(func_def)
                            ()
                        _ => ()
                    ()
                "on_remove" =>
                    (*_self).skip_newlines()
                    ()
                    (*_self).expect(TokenKind__Indent)?
                    ()
                    let mut body_stmts = Vec__new_()
                    while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
                        (*_self).skip_newlines()
                        ()
                        if (*_self).check(TokenKind__Dedent):
                            break
                        body_stmts.push((*_self).parse_stmt()?)
                        ()
                    ()
                    (*_self).expect(TokenKind__Dedent)?
                    ()
                    let params = if (field_name == "while_active"):
                        [Param { name: ("delta_time").to_string(), ty: Type::Named { name: ("Float").to_string(), generics: [], span: (*_self).current_span() }, mutable_: false, default_: none, span: (*_self).current_span() }]
                    else:
                        []
                    let func_def = Function { name: field_name.clone(), generics: [], params: params, return_type: none, effects: [], body: Block { stmts: body_stmts, span: (*_self).current_span() }, visibility: Visibility__Private, attributes: [], span: (*_self).current_span() }
                    match field_name.as_str():
                        "on_execute" =>
                            on_execute = Option::Some(func_def)
                            ()
                        "on_add" =>
                            on_add = Option::Some(func_def)
                            ()
                        "on_remove" =>
                            on_remove = Option::Some(func_def)
                            ()
                        "while_active" =>
                            while_active = Option::Some(func_def)
                            ()
                        _ => ()
                    ()
                "while_active" =>
                    (*_self).skip_newlines()
                    ()
                    (*_self).expect(TokenKind__Indent)?
                    ()
                    let mut body_stmts = Vec__new_()
                    while ((!(*_self).check(TokenKind__Dedent)) && (!(*_self).at_end())):
                        (*_self).skip_newlines()
                        ()
                        if (*_self).check(TokenKind__Dedent):
                            break
                        body_stmts.push((*_self).parse_stmt()?)
                        ()
                    ()
                    (*_self).expect(TokenKind__Dedent)?
                    ()
                    let params = if (field_name == "while_active"):
                        [Param { name: ("delta_time").to_string(), ty: Type::Named { name: ("Float").to_string(), generics: [], span: (*_self).current_span() }, mutable_: false, default_: none, span: (*_self).current_span() }]
                    else:
