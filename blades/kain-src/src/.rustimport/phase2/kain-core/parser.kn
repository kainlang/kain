        Result::Ok(Item::GameplayEffect(GameplayEffectDef { name: name, duration_policy: duration_policy, duration_magnitude: duration_magnitude, period: period, execute_on_application: execute_on_application, modifiers: modifiers, stacking_type: stacking_type, stacking_limit: stacking_limit, owned_tags: owned_tags, granted_tags: granted_tags, application_required_tags: application_required_tags, application_ignored_tags: application_ignored_tags, ongoing_required_tags: ongoing_required_tags, ongoing_ignored_tags: ongoing_ignored_tags, removal_required_tags: removal_required_tags, removal_ignored_tags: removal_ignored_tags, attributes: attributes, span: start.merge((*_self).current_span()) }))

    fn parse_gameplay_cue(_self: &mut Parser<a>, attributes: Array<Attribute>) -> Result<Item, KainError>:
        let start = (*_self).current_span()
