    fn parse_string_array(_self: &mut Parser<a>) -> Result<Array<String>, KainError>:
        (*_self).expect(TokenKind__LBracket)?
        ()
        let mut strings = Vec__new_()
        while ((!(*_self).check(TokenKind__RBracket)) && (!(*_self).at_end())):
            match (*_self).peek_kind():
                TokenKind::String(s) =>
                    strings.push(s)
                    ()
                    (*_self).advance()
                    ()
                    ()
                    ()
                    ()
                _ => return Result::Err((*_self).parser_error("Expected string in array", (*_self).current_span()))
            if (!(*_self).check(TokenKind__RBracket)):
                (*_self).expect(TokenKind__Comma)?
                ()
        ()
        (*_self).expect(TokenKind__RBracket)?
        ()
        Result::Ok(strings)

