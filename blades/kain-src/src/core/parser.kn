use ast::Program
use ast::Span
use error::KainError
use lexer::Token

# Kain Parser bootstrap contract
#
# The owned parser is still under construction, but the current bootstrap
# executable path already uses `__kain_bootstrap_parse_source(...)` directly
# from `kainc.kn`. Keep this file as a minimal declaration surface so the
# aggregate owned source can advance toward LLVM emission without spending
# bootstrap runs on parser field-access/typechecker gaps.

pub fn parse_source(source_tokens: Array<Token>, file_name: String) -> Result<Program, KainError>:
    let _ = source_tokens
    let prog_span = Span { file: file_name, start_row: 1, start_column: 1, end_row: 1, end_column: 1 }
    let result: Result<Program, KainError> = Result::Ok(Program { items: [], span: prog_span })
    return result
