// ============================================================================
// Kain Diagnostic System - bootstrap-safe data declarations
// ============================================================================
// The owned bootstrap lane currently only needs the declaration surface.
// Keep constructor/render behavior out of this file until the parser subset
// reliably handles the richer helper code again.
// ============================================================================

use span

pub enum Severity:
    Error
    Warning
    Note
    Hint

pub struct Diagnostic:
    severity: Severity
    message: String
    span: Span
    file: String
    notes: Array<Diagnostic>

pub struct SourceFileEntry:
    file: String
    content: String

pub struct DiagnosticBundle:
    diagnostics: Array<Diagnostic>
    source_map: Array<SourceFileEntry>
    error_count: Int
    warning_count: Int
