// ============================================================================
// Kain Error System - bootstrap-safe data declarations
// ============================================================================
// The owned bootstrap lane currently consumes the error data shapes directly.
// Keep constructor/helper behavior out of this file until the parser subset
// can reliably handle the richer method surface again.
// ============================================================================

use span::SourceSpan

pub enum ErrorKind:
    Lexer
    Parser
    Type
    Effect
    Borrow
    Codegen
    Runtime
    Io

pub struct KainError:
    kind: ErrorKind
    message: String
    span: SourceSpan
    filename: String
    hint: Option<String>

pub type KainResult<T> = Result<T, KainError>

pub struct ErrorCollector:
    errors: Array<KainError>
