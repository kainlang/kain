{
  "version": 1,
  "name": "canonical_source_mirror",
  "description": "Executable-first file-preserving selfhost source mirror profile. Rust remains the bootstrap donor while phase2 emits canonical Kain files under `src/.rustimport/phase2/<crate>/...` and keeps the `kain` executable parity lane ahead of backend expansion.",
  "roots": {
    "canonical_source_root": "src/.rustimport/phase2",
    "output_mirror_root": "mirror/src",
    "roundtrip_rust_root": "roundtrip_rust",
    "stage2_workspace_dir": "stage2_workspace"
  },
  "artifacts": {
    "aggregate_bundle_extension": ".kn",
    "aggregate_roundtrip_extension": ".roundtrip.rs",
    "source_correspondence_manifest_file": "source_correspondence_manifest.json"
  },
  "phases": {
    "phase1": [
      "kain-core",
      "kain-import"
    ],
    "phase2": [
      "kain-core",
      "kain-import",
      "cli",
      "kain-sys-codegen"
    ]
  },
  "ownership": {
    "bootstrap_source": "rust",
    "default_file_ownership_state": "bootstrap_from_rust",
    "fallback_mode": "rust_semantic_fallback",
    "roundtrip_strategy": "aggregate_bundle_then_split",
    "synthesized_main_root_strategy": "compat_include_lib"
  }
}
