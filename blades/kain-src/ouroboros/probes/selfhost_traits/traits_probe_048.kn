enum TraitProbeValue048:
    Unit
    Text(String)

impl Display for TraitProbeValue048:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue048::Unit => write(f, "unit-48")
            TraitProbeValue048::Text(value) => write(f, value)

impl Default for TraitProbeValue048:
