enum TraitProbeValue039:
    Unit
    Text(String)

impl Display for TraitProbeValue039:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue039::Unit => write(f, "unit-39")
            TraitProbeValue039::Text(value) => write(f, value)

impl Default for TraitProbeValue039:
    fn default_() -> Self_:
        TraitProbeValue039__Unit

fn trait_helper_probe_039(value: TraitProbeValue039) -> String:
