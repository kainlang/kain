enum TraitProbeValue005:
    Unit
    Text(String)

impl Display for TraitProbeValue005:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue005::Unit => write(f, "unit-5")
            TraitProbeValue005::Text(value) => write(f, value)

impl Default for TraitProbeValue005:
    fn default_() -> Self_:
        TraitProbeValue005__Unit

fn trait_helper_probe_005(value: TraitProbeValue005) -> String:
    format("{}", value)
