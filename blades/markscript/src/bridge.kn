//  BETA STDLIB STUBS — bridging functions until bridge_stdlib is integrated
// ===========================================================================

fn register_stdlib_intents(vm: MarkScriptVM) -> MarkScriptVM:
    // TODO: call bridge_stdlib.register_stdlib_intents when module is importable
    return vm

fn dispatch_stdlib(vm: MarkScriptVM, fn_id: Int, args: Array<MarkValue>) -> HandlerResult:
    // TODO: call bridge_stdlib.dispatch_stdlib when module is importable
    return HandlerResult { vm: vm, value: mark_int(0), err: "BETA handler " + str(fn_id) + " not connected" }

// ===========================================================================
//  GENERIC DISPATCH — route function ID to the correct handler
// ===========================================================================

pub fn dispatch_fn(vm: MarkScriptVM, fn_id: Int, args: Array<MarkValue>) -> HandlerResult:
    if fn_id == FN_FS_READ_TEXT:
        return handler_fs_read_text(vm, args)
    elif fn_id == FN_FS_WRITE_TEXT:
        return handler_fs_write_text(vm, args)
    elif fn_id == FN_FS_EXISTS:
        return handler_fs_exists(vm, args)
    elif fn_id == FN_PROCESS_OUTPUT:
        return handler_process_output(vm, args)
    elif fn_id == FN_PROCESS_SPAWN:
        return handler_process_spawn(vm, args)
    elif fn_id == FN_IMPORT_KAIN:
        return handler_import_kain(vm, args)
    elif fn_id == FN_ASSERT:
        return handler_assert(vm, args)
    elif fn_id == FN_PRINTLN:
        return handler_println(vm, args)
    elif fn_id == FN_STR:
        return handler_str(vm, args)
    elif fn_id == FN_LEN:
        return handler_len(vm, args)
    elif fn_id == FN_PUSH:
        return handler_push(vm, args)
    elif fn_id == FN_POP:
        return handler_pop(vm, args)
    // GAMMA: process lifecycle handlers (51-59)
    elif fn_id == FN_PROCESS_SPAWN_TRACKED:
        return handler_process_spawn_tracked(vm, args)
    elif fn_id == FN_PROCESS_AWAIT:
        return handler_process_await(vm, args)
    elif fn_id == FN_PROCESS_KILL_PID:
        return handler_process_kill(vm, args)
    elif fn_id == FN_PROCESS_EXIT_CODE_PID:
        return handler_process_exit_code(vm, args)
    elif fn_id == FN_PROCESS_STDOUT_PID:
        return handler_process_stdout_pid(vm, args)
    elif fn_id == FN_PROCESS_STDERR_PID:
        return handler_process_stderr_pid(vm, args)
    elif fn_id == FN_PROCESS_PIPE:
        return handler_process_pipe(vm, args)
    elif fn_id == FN_PROCESS_ENV:
        return handler_process_env(vm, args)
    elif fn_id == FN_PROCESS_CWD:
        return handler_process_cwd(vm, args)
    // BETA: stdlib handlers (13-50) — disabled pending cross-lane merge
    // elif fn_id >= FN_STRING_CONCAT and fn_id <= FN_RANDOM_FLOAT_RANGE:
    //     return bridge_stdlib.dispatch_stdlib(vm, fn_id, args)
    // All stdlib handlers produce an unknown error until bridge_stdlib is re-integrated
    elif fn_id >= 13 and fn_id <= 50:
        return HandlerResult {
            vm: vm,
            value: mark_int(0),
            err: "stdlib handler " + str(fn_id) + " not yet integrated"
        }
    // DELTA: UI scripting and config handlers (71-78)
    elif fn_id == FN_UI_ON_CLICK:
        return handler_ui_on_click(vm, args)
    elif fn_id == FN_UI_ON_KEY:
        return handler_ui_on_key(vm, args)
    elif fn_id == FN_UI_ON_FOCUS:
        return handler_ui_on_focus(vm, args)
    elif fn_id == FN_UI_ON_CLOSE:
        return handler_ui_on_close(vm, args)
    elif fn_id == FN_UI_GET_WIDGET:
        return handler_ui_get_widget(vm, args)
    elif fn_id == FN_UI_SET_PROPERTY:
        return handler_ui_set_property(vm, args)
    elif fn_id == FN_UI_GET_PROPERTY:
        return handler_ui_get_property(vm, args)
    elif fn_id == FN_UI_CREATE_WIDGET:
        return handler_ui_create_widget(vm, args)
    else:
        return HandlerResult {
            vm: vm,
            value: mark_int(0),
            err: "unknown function id: " + str(fn_id)
        }

// ===========================================================================
//  BACKWARD-COMPATIBLE WRAPPERS
// ===========================================================================

// Old dispatch_handler — delegates to the new dispatch_fn
pub fn dispatch_handler(vm: MarkScriptVM, handler_id: Int, args: Array<MarkValue>) -> HandlerResult:
    return dispatch_fn(vm, handler_id, args)

// Old init_vm_with_builtins — uses the new registry + IVT registration
pub fn init_vm_with_builtins() -> MarkScriptVM:
    init_builtins()
    var v = init_vm()
    v = register_stdlib_handlers(v)
    return v
