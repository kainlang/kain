// ============================================================================
//  MARKSCRIPT BRIDGE — IVT handler registry, intent → Kain stdlib binding
//
//  Registers built-in intent handlers and dispatches to them when the VM
//  encounters OP_EXECUTE_CALL or OP_CALL with a matching phrase hash.
//
//  Six built-in handlers (matching the spec):
//    HANDLER_FS_READ=1    — read file "path"
//    HANDLER_FS_WRITE=2   — write file "path" "content"
//    HANDLER_PROCESS_RUN=3 — run "command"
//    HANDLER_IMPORT_KAIN=4 — import kain "module"
//    HANDLER_ASSERT=5     — assert value expected
//    HANDLER_PRINT=6       — print value
//
//  Value semantics throughout. No ptr<T> parameters.
// ============================================================================

use std::fs
use std::process
use std::diagnostics
use std::text
use types       // MarkValue, mark_int, mark_string, mark_value_to_string,
                // MARK_INT, MARK_FLOAT, MARK_STRING
use vm          // MarkScriptVM, HandlerResult, register_handler, init_vm
use parser      // hash_name

// --- Handler ID constants -------------------------------------------------

pub const HANDLER_FS_READ:     Int = 1
pub const HANDLER_FS_WRITE:    Int = 2
pub const HANDLER_PROCESS_RUN: Int = 3
pub const HANDLER_IMPORT_KAIN: Int = 4
pub const HANDLER_ASSERT:      Int = 5
pub const HANDLER_PRINT:       Int = 6

// ===========================================================================
//  HANDLER REGISTRATION
// ===========================================================================

// Register a built-in handler by phrase text (hashes it internally)
pub fn register_builtin(vm: MarkScriptVM, phrase: String, handler_id: Int) -> MarkScriptVM:
    let phrase_hash = hash_name(phrase)
    return register_handler(vm, phrase_hash, handler_id)

// ===========================================================================
//  INDIVIDUAL HANDLER IMPLEMENTATIONS
// ===========================================================================

// --- handler_fs_read — "read file" intent --------------------------------
// args[0] = file path (string)
fn handler_fs_read(vm: MarkScriptVM, args: Array<MarkValue>) -> HandlerResult:
    var path: String = ""
    if len(args) > 0:
        if args[0].kind == MARK_STRING:
            path = args[0].str_val
        elif args[0].kind == MARK_INT:
            path = str(args[0].int_val)

    if path == "":
        return HandlerResult {
            vm: vm,
            value: mark_string(""),
            err: "read file: no path provided"
        }

    let content = fs_read_text(path)
    return HandlerResult {
        vm: vm,
        value: mark_string(content),
        err: ""
    }

// --- handler_fs_write — "write file" intent ------------------------------
// args[0] = path, args[1] = content
fn handler_fs_write(vm: MarkScriptVM, args: Array<MarkValue>) -> HandlerResult:
    var path: String = ""
    var content: String = ""

    if len(args) > 0:
        if args[0].kind == MARK_STRING:
            path = args[0].str_val
        elif args[0].kind == MARK_INT:
            path = str(args[0].int_val)

    if len(args) > 1:
        if args[1].kind == MARK_STRING:
            content = args[1].str_val
        elif args[1].kind == MARK_INT:
            content = str(args[1].int_val)

    if path == "":
        return HandlerResult {
            vm: vm,
            value: mark_int(0),
            err: "write file: no path provided"
        }

    fs_write_text(path, content)
    return HandlerResult {
        vm: vm,
        value: mark_int(1),
        err: ""
    }

// --- handler_process_run — "run" intent ----------------------------------
// args[0] = command string
fn handler_process_run(vm: MarkScriptVM, args: Array<MarkValue>) -> HandlerResult:
    var cmd: String = ""
    if len(args) > 0:
        if args[0].kind == MARK_STRING:
            cmd = args[0].str_val
        elif args[0].kind == MARK_INT:
            cmd = str(args[0].int_val)

    if cmd == "":
        return HandlerResult {
            vm: vm,
            value: mark_int(0),
            err: "run: no command provided"
        }

    // Use process_output_text for synchronous capture
    // Signature: process_output_text(executable, arg0, arg1, arg2, timeout_ms)
    let output = process_output_text(cmd, "", "", "", 5000)
    return HandlerResult {
        vm: vm,
        value: mark_string(output),
        err: ""
    }

// --- handler_import_kain — "import kain" intent --------------------------
// args[0] = module path string
fn handler_import_kain(vm: MarkScriptVM, args: Array<MarkValue>) -> HandlerResult:
    var mod_path: String = ""
    if len(args) > 0:
        if args[0].kind == MARK_STRING:
            mod_path = args[0].str_val
        elif args[0].kind == MARK_INT:
            mod_path = str(args[0].int_val)

    if mod_path == "":
        return HandlerResult {
            vm: vm,
            value: mark_int(0),
            err: "import kain: no module path provided"
        }

    // For now, just acknowledge the import — actual module loading
    // through the Kain compiler linking is a future feature.
    println("[BRIDGE] import kain: " + mod_path + " (acknowledged)")
    return HandlerResult {
        vm: vm,
        value: mark_string("imported " + mod_path),
        err: ""
    }

// --- handler_assert — "assert" intent ------------------------------------
// args[0] = actual, args[1] = expected
fn handler_assert(vm: MarkScriptVM, args: Array<MarkValue>) -> HandlerResult:
    if len(args) < 2:
        return HandlerResult {
            vm: vm,
            value: mark_int(0),
            err: "assert: need actual and expected values"
        }

    let actual = args[0]
    let expected = args[1]

    var equal: Bool = false
    if actual.kind == expected.kind:
        if actual.kind == MARK_INT:
            equal = actual.int_val == expected.int_val
        elif actual.kind == MARK_FLOAT:
            equal = actual.float_val == expected.float_val
        elif actual.kind == MARK_STRING:
            equal = actual.str_val == expected.str_val

    if equal:
        return HandlerResult {
            vm: vm,
            value: mark_int(1),
            err: ""
        }
    else:
        let actual_str = mark_value_to_string(actual)
        let expected_str = mark_value_to_string(expected)
        return HandlerResult {
            vm: vm,
            value: mark_int(0),
            err: "assertion failed: " + actual_str + " != " + expected_str
        }

// --- handler_print — "print" intent --------------------------------------
// args[0] = value to print
fn handler_print(vm: MarkScriptVM, args: Array<MarkValue>) -> HandlerResult:
    if len(args) > 0:
        let val_str = mark_value_to_string(args[0])
        println("[PRINT] " + val_str)
    return HandlerResult {
        vm: vm,
        value: mark_int(0),
        err: ""
    }

// ===========================================================================
//  DISPATCH — route handler_id to the correct implementation
// ===========================================================================

pub fn dispatch_handler(vm: MarkScriptVM, handler_id: Int, args: Array<MarkValue>) -> HandlerResult:
    if handler_id == HANDLER_FS_READ:
        return handler_fs_read(vm, args)
    elif handler_id == HANDLER_FS_WRITE:
        return handler_fs_write(vm, args)
    elif handler_id == HANDLER_PROCESS_RUN:
        return handler_process_run(vm, args)
    elif handler_id == HANDLER_IMPORT_KAIN:
        return handler_import_kain(vm, args)
    elif handler_id == HANDLER_ASSERT:
        return handler_assert(vm, args)
    elif handler_id == HANDLER_PRINT:
        return handler_print(vm, args)
    else:
        return HandlerResult {
            vm: vm,
            value: mark_int(0),
            err: "unknown handler_id: " + str(handler_id)
        }

// ===========================================================================
//  INITIALIZE VM WITH ALL BUILT-IN HANDLERS
// ===========================================================================

pub fn init_vm_with_builtins() -> MarkScriptVM:
    var v = init_vm()

    // Register all 6 built-in intents with their canonical phrases
    v = register_builtin(v, "read file", HANDLER_FS_READ)
    v = register_builtin(v, "write file", HANDLER_FS_WRITE)
    v = register_builtin(v, "run", HANDLER_PROCESS_RUN)
    v = register_builtin(v, "import kain", HANDLER_IMPORT_KAIN)
    v = register_builtin(v, "assert", HANDLER_ASSERT)
    v = register_builtin(v, "print", HANDLER_PRINT)

    return v
