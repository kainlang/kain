    if idx < 0 or idx >= len(vm.processes):
        return HandlerResult {
            vm: vm,
            value: mark_int(-1),
            err: "exitcode: invalid process index " + str(idx)
        }

    let rec = vm.processes[idx]
    return HandlerResult {
        vm: vm,
        value: mark_int(rec.exit_code),
        err: ""
    }

