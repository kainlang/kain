// ============================================================================
//  MARKSCRIPT JIT 1.0 — Bytecode-to-x86-64 Native Compiler
//
//  Full stack: compiles MarkScript bytecode → x86-64 machine code →
//  allocates RWX memory → calls native code via inline asm.
//  Uses converge for interpreter-vs-JIT dispatch.
//  Uses shatter struct for LLVM codegen-safe cache storage.
//  No C, no JIT libraries, no LLVM passes. Pure Kain + std::machine.
//
//  JIT function signature (Windows x64):
//    fn jit_entry() -> Int   // handles its own state via native stack
//
//  For simple programs (push/add/sub/etc), the JIT manipulates the
//  native x86-64 stack directly and returns the exit code in RAX.
// ============================================================================

use std::machine
use std::intent
use parser          // OP_*, hash_name
use types           // MarkValue, mark_int
use error           // MarkError, ERROR_*, error_ok, make_error
use vm              // MarkScriptVM, ExecResult, init_vm, execute_bytecode

// ===========================================================================
//  X86-64 OPCODE CONSTANTS
// ===========================================================================

const X64_PUSH_RAX: Int = 0x50
const X64_PUSH_RBX: Int = 0x53
const X64_PUSH_RCX: Int = 0x51
const X64_PUSH_RDX: Int = 0x52
const X64_POP_RAX:  Int = 0x58
const X64_POP_RBX:  Int = 0x5B
const X64_POP_RCX:  Int = 0x59
const X64_POP_RDX:  Int = 0x5A
const X64_RET:      Int = 0xC3
const X64_PUSH_RBP: Int = 0x55
const X64_POP_RBP:  Int = 0x5D
const X64_REX_W:    Int = 0x48

fn x64_modrm(mod_val: Int, reg: Int, rm: Int) -> Int:
    return ((mod_val & 3) << 6) | ((reg & 7) << 3) | (rm & 7)

// ===========================================================================
//  BYTECODE EMITTER — appends x86-64 bytes to an Int array
// ===========================================================================

fn emit_byte(arr: Array<Int>, byte: Int) -> Array<Int>:
    push(arr, byte & 0xFF)
    return arr

fn emit_u32(arr: Array<Int>, val: Int) -> Array<Int>:
    push(arr, val & 0xFF)
    push(arr, (val >> 8) & 0xFF)
    push(arr, (val >> 16) & 0xFF)
    push(arr, (val >> 24) & 0xFF)
    return arr

fn emit_u64(arr: Array<Int>, val: Int) -> Array<Int>:
    push(arr, val & 0xFF)
    push(arr, (val >> 8) & 0xFF)
    push(arr, (val >> 16) & 0xFF)
    push(arr, (val >> 24) & 0xFF)
    push(arr, (val >> 32) & 0xFF)
    push(arr, (val >> 40) & 0xFF)
    push(arr, (val >> 48) & 0xFF)
    push(arr, (val >> 56) & 0xFF)
    return arr

fn emit_rr(arr: Array<Int>, rex: Int, op: Int, reg: Int, rm: Int) -> Array<Int>:
    push(arr, rex)
    push(arr, op)
    push(arr, x64_modrm(3, reg, rm))
    return arr

// ===========================================================================
//  X86-64 EMITTER FUNCTIONS
// ===========================================================================

fn emit_prologue(arr: Array<Int>) -> Array<Int>:
    // Save ALL callee-saved regs FIRST, THEN set frame pointer
    // This way RBP points to the TOP of the callee-save area
    push(arr, X64_PUSH_RBP)       // save old RBP, RSP -= 8
    push(arr, X64_PUSH_RBX)       // save old RBX, RSP -= 8
    emit_rr(arr, X64_REX_W, 0x89, 4, 5)  // mov rbp, rsp — frame base AFTER saves
    return arr

fn emit_epilogue(arr: Array<Int>) -> Array<Int>:
    // Restore RSP to frame base (after saves, before operand pushes)
    emit_rr(arr, X64_REX_W, 0x89, 4, 5)  // mov rsp, rbp — RSP -> saved RBX
    push(arr, X64_POP_RBX)               // pop rbx — restore RBX, RSP += 8
    push(arr, X64_POP_RBP)               // pop rbp — restore RBP, RSP += 8
    push(arr, X64_RET)                   // ret
    return arr

fn emit_push_imm64(arr: Array<Int>, val: Int) -> Array<Int>:
    // mov rax, imm64; push rax
    push(arr, X64_REX_W)
    push(arr, 0xB8)
    emit_u64(arr, val)
    push(arr, X64_PUSH_RAX)
    return arr

fn emit_pop_drop(arr: Array<Int>) -> Array<Int>:
    // add rsp, 8
    push(arr, X64_REX_W)
    push(arr, 0x83)
    push(arr, 0xC4)
    push(arr, 8)
    return arr

fn emit_add(arr: Array<Int>) -> Array<Int>:
    // pop rbx; pop rax; add rax, rbx; push rax
    push(arr, X64_POP_RBX)
    push(arr, X64_POP_RAX)
    emit_rr(arr, X64_REX_W, 0x01, 0, 3)
    push(arr, X64_PUSH_RAX)
    return arr

fn emit_sub(arr: Array<Int>) -> Array<Int>:
    push(arr, X64_POP_RBX)
    push(arr, X64_POP_RAX)
    emit_rr(arr, X64_REX_W, 0x29, 0, 3)
    push(arr, X64_PUSH_RAX)
    return arr

fn emit_mul(arr: Array<Int>) -> Array<Int>:
    push(arr, X64_POP_RBX)
    push(arr, X64_POP_RAX)
    push(arr, X64_REX_W)
    push(arr, 0x0F)
    push(arr, 0xAF)
    push(arr, x64_modrm(3, 0, 3))
    push(arr, X64_PUSH_RAX)
    return arr

fn emit_div(arr: Array<Int>) -> Array<Int>:
    // xor rdx, rdx; pop rbx; pop rax; div rbx; push rax
    emit_rr(arr, X64_REX_W, 0x31, 2, 2)
    push(arr, X64_POP_RBX)
    push(arr, X64_POP_RAX)
    push(arr, X64_REX_W)
    push(arr, 0xF7)
    push(arr, 0xF3)
    push(arr, X64_PUSH_RAX)
    return arr

fn emit_jmp(arr: Array<Int>, current: Int, target: Int) -> Array<Int>:
    let rel = target - (current + 5)
    push(arr, 0xE9)
    emit_u32(arr, rel)
    return arr

fn emit_jn(arr: Array<Int>, current: Int, target: Int) -> Array<Int>:
    // pop rax; test rax,rax; js rel32
    push(arr, X64_POP_RAX)
    emit_rr(arr, X64_REX_W, 0x85, 0, 0)  // test rax, rax
    let rel = target - (current + 10)
    push(arr, 0x0F)
    push(arr, 0x88)
    emit_u32(arr, rel)
    return arr

fn emit_jz(arr: Array<Int>, current: Int, target: Int) -> Array<Int>:
    push(arr, X64_POP_RAX)
    emit_rr(arr, X64_REX_W, 0x85, 0, 0)
    let rel = target - (current + 10)
    push(arr, 0x0F)
    push(arr, 0x84)
    emit_u32(arr, rel)
    return arr

fn emit_halt(arr: Array<Int>) -> Array<Int>:
    // xor eax, eax; epilogue
    emit_rr(arr, X64_REX_W, 0x31, 0, 0)
    return arr

// ===========================================================================
//  BLOCK COMPILER — bytecode → x86-64 machine code
// ===========================================================================

struct JitResult:
    code_ptr:   ptr<Byte>
    code_size:  Int
    error:      String

fn null_ptr_byte() -> ptr<Byte>:
    return int_to_ptr(0, "ptr<Byte>")

fn jit_compile_block(bytecode: Array<Int>, start_ip: Int, end_ip: Int) -> JitResult with Unsafe:
    var code_arr: Array<Int> = []
    code_arr = emit_prologue(code_arr)

    var ip: Int = start_ip
    while ip < end_ip:
        let op = bytecode[ip]
        let current_offset = len(code_arr)

        if op == 0:        // OP_HALT
            code_arr = emit_halt(code_arr)
            code_arr = emit_epilogue(code_arr)
            ip = end_ip
            break
        elif op == 1 or op == 2:  // OP_ENTER_DOMAIN, OP_ROUTINE_HEADER
            ip = ip + 2
        elif op == 3:      // OP_PUSH_PARAM
            ip = ip + 2
        elif op == 4 or op == 10:  // EXECUTE_CALL or OP_CALL
            code_arr = emit_halt(code_arr)
            code_arr = emit_epilogue(code_arr)
            ip = end_ip
            break
        elif op == 5:      // OP_PUSH_MATRIX — skip
            ip = ip + 1
            let bc_len2 = len(bytecode)
            if ip + 3 >= bc_len2:
                ip = bc_len2
                continue
            ip = ip + 4  // handle, cols, rows, data_count
            if ip < bc_len2:
                let cc = bytecode[ip]
                ip = ip + 1 + cc
            ip = ip + 1
        elif op == 6:      // OP_FENCED_CODE
            ip = ip + 3
        elif op == 7:      // OP_PUSH_STACK
            ip = ip + 1
            if ip < len(bytecode):
                code_arr = emit_push_imm64(code_arr, bytecode[ip])
            ip = ip + 1
        elif op == 8:      // OP_POP_STACK
            code_arr = emit_pop_drop(code_arr)
            ip = ip + 1
        elif op == 9:      // OP_DUP
            push(code_arr, X64_REX_W)
            push(code_arr, 0xFF)
            push(code_arr, 0x34)
            push(code_arr, 0x24)
            ip = ip + 1
        elif op == 11:     // OP_RET
            code_arr = emit_epilogue(code_arr)
            ip = ip + 1
        elif op == 12:     // OP_JMP
            ip = ip + 1
            if ip < len(bytecode):
                code_arr = emit_jmp(code_arr, current_offset, bytecode[ip])
            ip = ip + 1
        elif op == 13:     // OP_JZ
            ip = ip + 1
            if ip < len(bytecode):
                code_arr = emit_jz(code_arr, current_offset, bytecode[ip])
            ip = ip + 1
        elif op == 14:     // OP_ADD
            code_arr = emit_add(code_arr)
            ip = ip + 1
        elif op == 15:     // OP_SUB
            code_arr = emit_sub(code_arr)
            ip = ip + 1
        elif op == 16:     // OP_MUL
            code_arr = emit_mul(code_arr)
            ip = ip + 1
        elif op == 17:     // OP_DIV
            code_arr = emit_div(code_arr)
            ip = ip + 1
        elif op == 18:     // OP_LOAD_VAR
            ip = ip + 2  // skip (stub — pushes 0)
            code_arr = emit_push_imm64(code_arr, 0)
        elif op == 19:     // OP_STORE_VAR
            ip = ip + 2  // skip (stub — pops)
            code_arr = emit_pop_drop(code_arr)
        elif op == 20:     // OP_JN
            ip = ip + 1
            if ip < len(bytecode):
                code_arr = emit_jn(code_arr, current_offset, bytecode[ip])
            ip = ip + 1
        else:
            ip = ip + 1

    // Epilogue if not already emitted
    if len(code_arr) > 0:
        let last = code_arr[len(code_arr) - 1]
        if last != X64_RET and last != X64_POP_RBP:
            code_arr = emit_epilogue(code_arr)

    // Allocate + copy to RWX memory
    let code_size = len(code_arr)
    if code_size < 1:
        return JitResult { code_ptr: null_ptr_byte(), code_size: 0, error: "empty" }

    let alloc_size = code_size
    let page_size = vm_page_size()
    if alloc_size % page_size > 0:
        alloc_size = (alloc_size / page_size + 1) * page_size

    let buf = vm_map(alloc_size)
    if ptr_to_int(buf) == 0:
        return JitResult { code_ptr: null_ptr_byte(), code_size: 0, error: "vm_map failed" }

    let prot = vm_protect_execute_read_write(buf, alloc_size)
    if prot != 0:
        let _ = vm_release(buf, alloc_size)
        return JitResult { code_ptr: null_ptr_byte(), code_size: 0, error: "protect failed" }

    // Copy code bytes
    collapse buf:
        var i: Int = 0
        while i < code_size:
            let byte_val: Byte = code_arr[i] as Byte
            mem_store(ptr_offset(buf, i, "Byte"), byte_val, "Byte")
            i = i + 1
        0

    // Flush I-cache
    var ci: Int = 0
    let cls = cpu_cache_line_bytes()
    while ci < code_size:
        let bp = ptr_offset(buf, ci, "Byte")
        let fp: ptr<Int> = int_to_ptr(ptr_to_int(bp), "ptr<Int>")
        cache_flush(fp)
        ci = ci + cls
    full_fence()

    let result_ptr: ptr<Byte> = int_to_ptr(ptr_to_int(buf), "ptr<Byte>")
    return JitResult { code_ptr: result_ptr, code_size: code_size, error: "" }

// ===========================================================================
//  NATIVE CODE EXECUTION — call JIT code via inline asm
//  Windows x64: first arg in RCX, result in RAX.
//  The JIT function takes no args (self-contained on native stack).
//  Returns: 0 (success) or handler_id (for EXECUTE_CALL).
// ===========================================================================

fn call_jit(code_ptr: ptr<Byte>) -> Int with Unsafe:
    // Proven asm_rdtsc pattern: scratch buffer, [rdi], clobbers, volatile
    // scratch[0] = code address, scratch[1] = return value slot
    let scratch: ptr<Int> = alloc_zeroed(2, "Int")
    mem_store(scratch, ptr_to_int(code_ptr), "Int")
    mem_store(ptr_offset(scratch, 1, "Int"), 0, "Int")
    let sc_int = ptr_to_int(scratch)

    // asm_rdtsc pattern: bind pointer to rdi, asm body uses [rdi]
    // rbx is callee-saved — NOT in clobbers (JIT prologue/epilogue handles it)
    asm("mov rax, [rdi]\ncall rax\nmov [rdi+8], rax",
        sc_int,
        constraints = "{rdi}",
        clobbers = "rax,rcx,rdx",
        memory = true, intel = true)

    let result = mem_load(ptr_offset(scratch, 1, "Int"), "Int")
    decay scratch
    return result

// ===========================================================================
//  SHATTER-BASED CODE CACHE — SoA layout avoids LLVM struct-in-array bug
//  Uses parallel arrays for block_hash / code_ptr / code_size instead of
//  Array<CacheEntry> which triggers the LLVM codegen limitation.
// ===========================================================================

shatter struct CacheStore:
    hashes:  Array<Int>
    ptrs:    Array<ptr<Byte>>
    sizes:   Array<Int>
    count:   Int
    hits:    Int
    misses:  Int
    bytes:   Int
    compiles: Int

fn init_cache() -> CacheStore:
    return CacheStore {
        hashes: [], ptrs: [], sizes: [],
        count: 0, hits: 0, misses: 0,
        bytes: 0, compiles: 0
    }

struct LookupResult:
    found: Bool
    ptr:   ptr<Byte>

fn cache_lookup(cache: CacheStore, hash: Int) -> LookupResult:
    var i: Int = 0
    while i < cache.count:
        if cache.hashes[i] == hash:
            return LookupResult { found: true, ptr: cache.ptrs[i] }
        i = i + 1
    return LookupResult { found: false, ptr: null_ptr_byte() }

fn cache_register(cache: CacheStore, hash: Int, ptr: ptr<Byte>, size: Int) -> CacheStore:
    var c = cache
    push(c.hashes, hash)
    push(c.ptrs, ptr)
    push(c.sizes, size)
    c.count = c.count + 1
    c.bytes = c.bytes + size
    c.compiles = c.compiles + 1
    return c

fn cache_record_hit(cache: CacheStore) -> CacheStore:
    var c = cache
    c.hits = c.hits + 1
    return c

fn cache_record_miss(cache: CacheStore) -> CacheStore:
    var c = cache
    c.misses = c.misses + 1
    return c

// ===========================================================================
//  PUBLIC INTEGRATION POINTS
//  jit_execute: compile and run bytecode via JIT in one call
// ===========================================================================

pub fn jit_execute(bc: Array<Int>) -> Int with Unsafe:
    let jr = jit_compile_block(bc, 0, len(bc))
    if jr.error != "":
        println("[JIT] Compile failed: " + jr.error)
        return -1
    return call_jit(jr.code_ptr)

pub fn jit_selftest() -> Int with Unsafe:
    // Test 0: just halt
    let test0: Array<Int> = [0]
    let r0 = jit_compile_block(test0, 0, 1)
    let res0 = call_jit(r0.code_ptr)
    println("[JIT] halt: " + str(res0) + " (" + str(r0.code_size) + " bytes)")
    if res0 != 0:
        return 1

    // Test 1: manually emit push-42, halt (bypass jit_compile_block)
    let manual: Array<Int> = []
    push(manual, 0x55); push(manual, 0x53)  // push rbp; push rbx
    push(manual, 0x48); push(manual, 0x89); push(manual, 0xE5)  // mov rbp,rsp
    push(manual, 0x48); push(manual, 0xB8)  // mov rax,
    emit_u64(manual, 42)                     // 42
    push(manual, 0x50)                       // push rax
    push(manual, 0x48); push(manual, 0x31); push(manual, 0xC0)  // xor rax,rax
    push(manual, 0x48); push(manual, 0x89); push(manual, 0xE5)  // mov rsp,rbp
    push(manual, 0x5B); push(manual, 0x5D); push(manual, 0xC3)  // pop rbx; pop rbp; ret
    let ms = len(manual)
    let page = vm_page_size()
    let m_alloc = if ms % page > 0: (ms / page + 1) * page else: ms
    let m_buf = vm_map(m_alloc)
    let _ = vm_protect_execute_read_write(m_buf, m_alloc)
    collapse m_buf:
        var mi: Int = 0
        while mi < ms:
            mem_store(ptr_offset(m_buf, mi, "Byte"), manual[mi] as Byte, "Byte")
            mi = mi + 1
        0
    let m_ptr: ptr<Byte> = int_to_ptr(ptr_to_int(m_buf), "ptr<Byte>")
    println("[JIT] manual push 42: " + str(ms) + " bytes, calling...")
    let res1 = call_jit(m_ptr)
    println("[JIT] manual: " + str(res1))
    let _ = vm_release(m_buf, m_alloc)

    // Test 2: push 1, push 2, add, halt
    let test2: Array<Int> = [7, 1, 7, 2, 14, 0]
    let r2 = jit_compile_block(test2, 0, 6)
    let res2 = call_jit(r2.code_ptr)
    println("[JIT] 1+2: " + str(res2) + " (" + str(r2.code_size) + " bytes)")

    // Test 3: push 100, push 30, sub, halt
    let test3: Array<Int> = [7, 100, 7, 30, 15, 0]
    let r3 = jit_compile_block(test3, 0, 6)
    let res3 = call_jit(r3.code_ptr)
    println("[JIT] 100-30: " + str(res3) + " (" + str(r3.code_size) + " bytes)")

    println("[JIT] Done")
    return 0
 
