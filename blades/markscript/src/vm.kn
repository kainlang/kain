// ============================================================================
//  MARKSCRIPT VIRTUAL MACHINE — Value-semantics bytecode executor
//  No function pointers. Simple opcode dispatch.
// ============================================================================

pub struct MarkScriptVM:
    ip:          Int
    accumulator: Int

// --- Execution result -----------------------------------------------------

pub struct ExecResult:
    accumulator: Int

// --- Constructor ----------------------------------------------------------

pub fn init_vm() -> MarkScriptVM:
    return MarkScriptVM { ip: 0, accumulator: 0 }

// --- Execute bytecode -----------------------------------------------------
// Bytecode: flat Array<Int> of [opcode, operand?, opcode, operand?, ...]

pub fn execute_bytecode(vm: MarkScriptVM, bc: Array<Int>) -> ExecResult:
    let bc_len = len(bc)
    var ip = vm.ip
    var acc = vm.accumulator
    var result: Int = 0

    while ip < bc_len:
        let opcode = bc[ip]

        if opcode == 0: // OP_HALT
            return ExecResult { accumulator: result }

        elif opcode == 1: // OP_ENTER_DOMAIN
            ip = ip + 1
            if ip < bc_len:
                acc = bc[ip]
            ip = ip + 1

        elif opcode == 2: // OP_ROUTINE_HEADER
            ip = ip + 1
            if ip < bc_len:
                acc = bc[ip]
            ip = ip + 1

        elif opcode == 3: // OP_PUSH_PARAM
            ip = ip + 1
            if ip < bc_len:
                acc = acc + bc[ip]
            ip = ip + 1

        elif opcode == 4: // OP_EXECUTE_CALL
            result = acc
            ip = ip + 1

        else:
            ip = ip + 1

    return ExecResult { accumulator: result }
