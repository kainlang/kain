// ============================================================================
//  MARKSCRIPT VIRTUAL MACHINE — Stack-based bytecode executor
//  Supports matrix data tables, fenced code blocks, IVT dispatch,
//  control flow, arithmetic ops, and subroutine calls.
//
//  No raw pointers through bytecode. The VM owns all data in its
//  data_table and IVT. Handles are Int values — safe from GC, tagged
//  ints, and pointer invalidation.
// ============================================================================

// --- Opcodes (shared with ast.kn) -----------------------------------------
// Parser-owned:  0=HALT, 1=ENTER_DOMAIN, 2=ROUTINE_HEADER,
//                3=PUSH_PARAM, 4=EXECUTE_CALL
// Parser+VM:     5=PUSH_MATRIX, 6=FENCED_CODE
// VM-only:       7=PUSH_STACK, 8=POP_STACK, 9=DUP, 10=CALL,
//               11=RET, 12=JMP, 13=JZ, 14=ADD, 15=SUB, 16=PRINT

// --- IVT entry ------------------------------------------------------------

pub struct IVTEntry:
    phrase_hash: Int
    handler_id:  Int

// --- Matrix record --------------------------------------------------------

pub struct MatrixRecord:
    handle_id: Int
    cols:      Int
    rows:      Int
    data:      Array<Int>

// --- Fenced code record ---------------------------------------------------

pub struct CodeBlockRecord:
    lang_hash:    Int
    content_hash: Int

// --- VM state -------------------------------------------------------------

pub struct MarkScriptVM:
    ip:             Int              // instruction pointer
    accumulator:    Int              // primary return register
    stack:          Array<Int>       // operand stack
    data_table:     Array<MatrixRecord>  // handle → matrix data
    data_table_cnt: Int              // next free handle id
    code_blocks:    Array<CodeBlockRecord>  // fenced code blocks
    call_stack:     Array<Int>       // return addresses
    ivt:            Array<IVTEntry>  // intent vector table
    ivt_count:      Int              // number of registered handlers

// --- Execution result -----------------------------------------------------

pub struct ExecResult:
    accumulator: Int
    data_table:  Array<MatrixRecord>
    code_blocks: Array<CodeBlockRecord>

// --- Constructor ----------------------------------------------------------

pub fn init_vm() -> MarkScriptVM:
    return MarkScriptVM {
        ip: 0,
        accumulator: 0,
        stack: [],
        data_table: [],
        data_table_cnt: 0,
        code_blocks: [],
        call_stack: [],
        ivt: [],
        ivt_count: 0
    }

// --- Data registration (value semantics) ---------------------------------
// Returns a RegisterDataResult containing the updated VM + handle.

pub struct RegisterDataResult:
    vm:     MarkScriptVM
    handle: Int

pub fn register_data(vm: MarkScriptVM, data: Array<Int>) -> RegisterDataResult:
    var v = vm
    let handle = v.data_table_cnt
    let rec = MatrixRecord {
        handle_id: handle,
        cols: 0,
        rows: 0,
        data: data
    }
    push(v.data_table, rec)
    v.data_table_cnt = v.data_table_cnt + 1
    return RegisterDataResult { vm: v, handle: handle }

// --- IVT registration (value semantics) -----------------------------------

pub fn register_handler(vm: MarkScriptVM, phrase_hash: Int, handler_id: Int) -> MarkScriptVM:
    var v = vm
    let entry = IVTEntry {
        phrase_hash: phrase_hash,
        handler_id: handler_id
    }
    push(v.ivt, entry)
    v.ivt_count = v.ivt_count + 1
    return v

// --- IVT lookup -----------------------------------------------------------

pub fn lookup_handler(vm: MarkScriptVM, hash: Int) -> Int:
    var i: Int = 0
    while i < vm.ivt_count:
        if vm.ivt[i].phrase_hash == hash:
            return vm.ivt[i].handler_id
        i = i + 1
    return 0


// --- Execute bytecode -----------------------------------------------------
// Bytecode: flat Array<Int> of [opcode, operand?, opcode, operand?, ...]
// Matrix data is embedded inline:  OP_PUSH_MATRIX, handle, cols, rows,
//   data_count, d0, d1, ..., dN
// Fenced code:  OP_FENCED_CODE, lang_hash, content_hash

pub fn execute_bytecode(vm: MarkScriptVM, bc: Array<Int>) -> ExecResult:
    let bc_len = len(bc)
    var ip = vm.ip
    var acc = vm.accumulator
    var stk = vm.stack
    var dt = vm.data_table
    var dtc = vm.data_table_cnt
    var cb = vm.code_blocks
    var callstk = vm.call_stack
    var ivt = vm.ivt
    var ivtc = vm.ivt_count
    var result: Int = 0

    while ip < bc_len:
        let opcode = bc[ip]

        // --- OP_HALT (0) --------------------------------------------------
        if opcode == 0:
            return ExecResult {
                accumulator: result,
                data_table: dt,
                code_blocks: cb
            }

        // --- OP_ENTER_DOMAIN (1) ------------------------------------------
        elif opcode == 1:
            ip = ip + 1
            if ip < bc_len:
                acc = bc[ip]
            ip = ip + 1

        // --- OP_ROUTINE_HEADER (2) ----------------------------------------
        elif opcode == 2:
            ip = ip + 1
            if ip < bc_len:
                acc = bc[ip]
            ip = ip + 1

        // --- OP_PUSH_PARAM (3) --------------------------------------------
        elif opcode == 3:
            ip = ip + 1
            if ip < bc_len:
                acc = acc + bc[ip]
            ip = ip + 1

        // --- OP_EXECUTE_CALL (4) ------------------------------------------
        elif opcode == 4:
            result = acc
            ip = ip + 1

        // --- OP_PUSH_MATRIX (5) -------------------------------------------
        elif opcode == 5:
            ip = ip + 1
            if ip + 3 >= bc_len:
                ip = bc_len
                continue
            let handle = bc[ip]
            ip = ip + 1
            let cols = bc[ip]
            ip = ip + 1
            let rows = bc[ip]
            ip = ip + 1
            let data_count = bc[ip]
            ip = ip + 1

            // Ensure data table is large enough
            while len(dt) <= handle:
                let empty_rec = MatrixRecord {
                    handle_id: len(dt),
                    cols: 0, rows: 0, data: []
                }
                push(dt, empty_rec)

            // Read data values from inline bytecode
            var matrix_data: Array<Int> = []
            var di: Int = 0
            while di < data_count:
                if ip < bc_len:
                    push(matrix_data, bc[ip])
                    ip = ip + 1
                di = di + 1

            dt[handle] = MatrixRecord {
                handle_id: handle,
                cols: cols,
                rows: rows,
                data: matrix_data
            }

            acc = handle

        // --- OP_FENCED_CODE (6) -------------------------------------------
        elif opcode == 6:
            ip = ip + 1
            if ip + 1 >= bc_len:
                ip = bc_len
                continue
            let lang_hash = bc[ip]
            ip = ip + 1
            let content_hash = bc[ip]
            ip = ip + 1

            push(cb, CodeBlockRecord {
                lang_hash: lang_hash,
                content_hash: content_hash
            })

            acc = lang_hash

        // --- OP_PUSH_STACK (7) — push next operand to stack ---------------
        elif opcode == 7:
            ip = ip + 1
            if ip < bc_len:
                let val = bc[ip]
                push(stk, val)
            ip = ip + 1

        // --- OP_POP_STACK (8) — pop stack into accumulator ----------------
        elif opcode == 8:
            let stk_len = len(stk)
            if stk_len > 0:
                acc = stk[stk_len - 1]
                pop(stk)
            ip = ip + 1

        // --- OP_DUP (9) — duplicate top of stack --------------------------
        elif opcode == 9:
            let stk_len = len(stk)
            if stk_len > 0:
                push(stk, stk[stk_len - 1])
            ip = ip + 1

        // --- OP_CALL (10) — IVT lookup, push return address ---------------
        elif opcode == 10:
            let stk_len = len(stk)
            if stk_len > 0:
                let target_hash = stk[stk_len - 1]
                pop(stk)

                // Lookup IVT
                var found: Bool = false
                var handler_id: Int = 0
                var ii: Int = 0
                while ii < ivtc:
                    if ivt[ii].phrase_hash == target_hash:
                        handler_id = ivt[ii].handler_id
                        found = true
                        break
                    ii = ii + 1

                if found:
                    // Push return address
                    push(callstk, ip + 1)
                    // Jump to handler (by setting ip to 0 and using
                    // the handler_id as the result — real dispatch
                    // logic would branch here)
                    result = handler_id
                    ip = ip + 1
                else:
                    ip = ip + 1
            else:
                ip = ip + 1

        // --- OP_RET (11) — pop return address, continue -------------------
        elif opcode == 11:
            let cstk_len = len(callstk)
            if cstk_len > 0:
                ip = callstk[cstk_len - 1]
                pop(callstk)
            else:
                ip = ip + 1

        // --- OP_JMP (12) — unconditional jump to target IP ----------------
        elif opcode == 12:
            ip = ip + 1
            if ip < bc_len:
                ip = bc[ip]
            else:
                ip = bc_len

        // --- OP_JZ (13) — jump if zero ------------------------------------
        elif opcode == 13:
            ip = ip + 1
            let target = bc[ip]
            ip = ip + 1
            let stk_len = len(stk)
            if stk_len > 0:
                let val = stk[stk_len - 1]
                pop(stk)
                if val == 0:
                    ip = target

        // --- OP_ADD (14) — stack[top-1] + stack[top] ----------------------
        elif opcode == 14:
            let stk_len = len(stk)
            if stk_len >= 2:
                let b = stk[stk_len - 1]
                pop(stk)
                let a = stk[stk_len - 2]
                pop(stk)
                push(stk, a + b)
            ip = ip + 1

        // --- OP_SUB (15) — stack[top-1] - stack[top] ----------------------
        elif opcode == 15:
            let stk_len = len(stk)
            if stk_len >= 2:
                let b = stk[stk_len - 1]
                pop(stk)
                let a = stk[stk_len - 2]
                pop(stk)
                push(stk, a - b)
            ip = ip + 1

        // --- OP_PRINT (16) — pop and print ---------------------------------
        elif opcode == 16:
            let stk_len = len(stk)
            if stk_len > 0:
                let val = stk[stk_len - 1]
                pop(stk)
                println("  [VM PRINT] " + str(val))
            ip = ip + 1

        else:
            ip = ip + 1

    return ExecResult {
        accumulator: result,
        data_table: dt,
        code_blocks: cb
    }
