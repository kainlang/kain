// ============================================================================
//  MARKSCRIPT RUNTIME ENGINE DRIVER
//  Command-line entry point. Reads a .kn.md file, lexes it, compiles it
//  to bytecode, and executes it through the VM.
//  Usage: mks.exe <file.kn.md>
//  Uses value semantics throughout (no ptr<T>) for codegen compatibility.
// ============================================================================

use std::text
use std::fs
use std::diagnostics
use std::runtime
use lexer
use ast
use vm

// --- Demo handler stub ----------------------------------------------------

fn runtime_stub(hash_id: Int) -> Int:
    println("[INTENT] Fired intent hash: " + str(hash_id))
    return 200

// --- File reading ---------------------------------------------------------

fn read_source(path: String) -> String:
    let content = fs_read_text(path)
    return content

// --- Main entry point -----------------------------------------------------

fn main(args: Array<String>) -> Int:
    println("=== MARKSCRIPT RUNTIME ENGINE v1.0 ===")
    println("")

    // Determine source — using workaround for compiler tag-check bug
    // in process_arg(1). See tree-kn's get_user_args() for details.
    let arg_count = process_arg_count()
    var source: String = ""
    
    if arg_count > 1:
        let index_zero = process_arg(0)
        let index_one = process_arg(1)
        let need_workaround = index_zero == index_one
        
        var filepath: String = ""
        if need_workaround:
            // Compiler bug: raw index 9 decodes to 1 via tag-check
            filepath = process_arg(9)
        else:
            filepath = process_arg(1)
        
        source = read_source(filepath)
        println("[INPUT] Loaded: " + filepath)
    else:
        // Fallback demo source — exercises all features: domains, routines,
        // intents (blockquote), tables, and fenced code blocks.
        source = "# PipelineWorkspace\n## ProcessHotPath\n> apply vignette filter\n| Density | Viscosity | Friction |\n| 1.05    | 0.88      | 0.45     |\n\n\n> apply grain overlay\n\n\n```python\nprint(\"hello world\")\n```\n"
        println("[INPUT] Using demo source (no file arg)")

    // 1. Create lexer state
    let lex = create_lexer(source)

    // 2. Tokenize + Parse + Compile in one pass
    let bc = compile_source(lex)

    let op_count = len(bc)
    println("[COMPILE] Produced " + str(op_count) + " bytecode ops")

    // Print bytecode disassembly
    var di = 0
    while di < op_count:
        let op = bc[di]
        if op == 0:
            println("        " + str(di) + ": OP_HALT")
        elif op == 1:
            di = di + 1
            if di < op_count:
                println("        " + str(di - 1) + ": OP_ENTER_DOMAIN  hash=" + str(bc[di]))
        elif op == 2:
            di = di + 1
            if di < op_count:
                println("        " + str(di - 1) + ": OP_ROUTINE_HEADER hash=" + str(bc[di]))
        elif op == 3:
            di = di + 1
            if di < op_count:
                println("        " + str(di - 1) + ": OP_PUSH_PARAM    hash=" + str(bc[di]))
        elif op == 4:
            println("        " + str(di) + ": OP_EXECUTE_CALL")
        elif op == 5:
            di = di + 1
            if di + 3 < op_count:
                let handle = bc[di]
                di = di + 1
                let cols = bc[di]
                di = di + 1
                let rows = bc[di]
                di = di + 1
                let cnt = bc[di]
                di = di + 1
                println("        " + str(di - 5) + ": OP_PUSH_MATRIX  handle=" + str(handle) + " cols=" + str(cols) + " rows=" + str(rows) + " data_count=" + str(cnt))
                // Advance past data values, accounting for outer loop's di = di + 1
                if cnt == 0:
                    di = di - 1
                elif cnt > 1:
                    var sdi: Int = 1
                    while sdi < cnt and di < op_count:
                        di = di + 1
                        sdi = sdi + 1
                // cnt == 1: di stays at first (and only) data value
        elif op == 6:
            di = di + 1
            if di + 1 < op_count:
                let lang = bc[di]
                di = di + 1
                let content = bc[di]
                println("        " + str(di - 2) + ": OP_FENCED_CODE lang_hash=" + str(lang) + " content_hash=" + str(content))
        else:
            println("        " + str(di) + ": UNKNOWN_OP " + str(op))
        di = di + 1

    println("")

    // 3. Execute in VM
    let vm = init_vm()
    let er = execute_bytecode(vm, bc)

    println("[EXEC] VM finished with accumulator: " + str(er.accumulator))
    println("[EXEC] Data tables: " + str(len(er.data_table)))
    var tdi: Int = 0
    while tdi < len(er.data_table):
        let rec = er.data_table[tdi]
        if len(rec.data) > 0:
            println("[EXEC]   table[" + str(rec.handle_id) + "]: " + str(rec.cols) + "x" + str(rec.rows) + " = " + str(len(rec.data)) + " ints")
        tdi = tdi + 1
    println("[EXEC] Code blocks stored: " + str(len(er.code_blocks)))

    // 4. Call runtime stub for demo
    let stub_result = runtime_stub(er.accumulator)
    println("[STUB] Handler returned: " + str(stub_result))

    println("")
    println("=== ENGINE EXECUTION TERMINATED SAFELY ===")
    return 0
