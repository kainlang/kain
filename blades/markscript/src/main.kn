// ============================================================================
//  MARKSCRIPT RUNTIME ENGINE DRIVER
//  Command-line entry point. Reads a .kn.md file, lexes it, compiles it
//  to bytecode, and executes it through the VM.
//  Usage: mks.exe <file.kn.md>
//  Uses value semantics throughout (no ptr<T>) for codegen compatibility.
// ============================================================================

use std::text
use std::fs
use std::diagnostics
use lexer
use ast
use compiler
use vm

// --- Demo handler stub ----------------------------------------------------

fn runtime_stub(hash_id: Int) -> Int:
    println("[INTENT] Fired intent hash: " + str(hash_id))
    return 200

// --- File reading ---------------------------------------------------------

fn read_source(path: String) -> String:
    let content = fs_read_text(path)
    return content

// --- Main entry point -----------------------------------------------------

fn main(args: Array<String>) -> Int:
    println("=== MARKSCRIPT RUNTIME ENGINE v1.0 ===")
    println("")

    // Determine source
    let arg_count = len(args)
    var source: String = ""
    
    // Debug: print all args
    var ai = 0
    while ai < arg_count:
        println("[ARGS] " + str(ai) + ": " + args[ai])
        ai = ai + 1
    
    if arg_count >= 1:
        let filepath = args[0]
        source = read_source(filepath)
        println("[INPUT] Loaded: " + filepath)
    else:
        // Fallback demo source
        source = "# PipelineWorkspace\n## ProcessHotPath\n> apply vignette filter\n"
        println("[INPUT] Using demo source (no file arg)")

    // 1. Create lexer state
    let lex = create_lexer(source)

    // 2. Tokenize + Parse + Compile in one pass
    let bc = compile_source(lex)

    let op_count = len(bc)
    println("[COMPILE] Produced " + str(op_count) + " bytecode ops")

    // Print bytecode disassembly
    var di = 0
    while di < op_count:
        let op = bc[di]
        if op == 0:
            println("        " + str(di) + ": OP_HALT")
        elif op == 1:
            di = di + 1
            if di < op_count:
                println("        " + str(di - 1) + ": OP_ENTER_DOMAIN  hash=" + str(bc[di]))
        elif op == 2:
            di = di + 1
            if di < op_count:
                println("        " + str(di - 1) + ": OP_ROUTINE_HEADER hash=" + str(bc[di]))
        elif op == 3:
            di = di + 1
            if di < op_count:
                println("        " + str(di - 1) + ": OP_PUSH_PARAM    hash=" + str(bc[di]))
        elif op == 4:
            println("        " + str(di) + ": OP_EXECUTE_CALL")
        else:
            println("        " + str(di) + ": UNKNOWN_OP " + str(op))
        di = di + 1

    println("")

    // 3. Execute in VM
    let vm = init_vm()
    let er = execute_bytecode(vm, bc)

    println("[EXEC] VM finished with accumulator: " + str(er.accumulator))

    // 4. Call runtime stub for demo
    let stub_result = runtime_stub(er.accumulator)
    println("[STUB] Handler returned: " + str(stub_result))

    println("")
    println("=== ENGINE EXECUTION TERMINATED SAFELY ===")
    return 0
