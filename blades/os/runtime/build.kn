use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let proj = project("kainos_runtime")
        .kind("static_library")
        .version("0.1.0")
        .description("KAINOS native C runtime — freestanding bare-metal variant")
        .source_root(".")
        .module_root(".")
        .target("llvm")
        .triple("x86_64-unknown-none")
        .freestanding(true)
        .profile("debug")

    let check = check_task("check-runtime")
        .project(proj)
        .target("llvm")

    let lib = native_library("runtime-native")
        .project(proj)
        .requires(check)

    return build_graph()
        .project(proj)
        .task(check)
        .task(lib)
