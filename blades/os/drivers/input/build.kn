use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let proj = project("input_subsystem")
        .kind("static_library")
        .version("0.1.0")
        .description("KAINOS HID input driver — keyboard/mouse boot protocol, report descriptor parsing, unified InputEvent")
        .source_root(".")
        .module_root(".")
        .target("llvm")
        .triple("x86_64-unknown-none")
        .freestanding(true)
        .profile("debug")

    let check = check_task("check-input")
        .project(proj)
        .target("llvm")

    let lib = native_library("input-lib")
        .project(proj)
        .requires(check)

    return build_graph()
        .project(proj)
        .task(check)
        .task(lib)
