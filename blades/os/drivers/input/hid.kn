// ============================================================================
//  KAINOS HID INPUT DRIVER — drivers/input/hid.kn
//  Stream F: Device Drivers — State passed explicitly
// ============================================================================

enum InputEventKind:
    KeyDown
    KeyUp
    KeyRepeat
    ButtonDown
    ButtonUp
    Motion
    Absolute
    Wheel

struct InputEvent:
    kind:      InputEventKind
    code:      Int
    value:     Int
    timestamp: Int

struct InputState:
    events:    [InputEvent]
    device_count: Int

// USB HID keycodes
const KEY_A: Int = 4
const KEY_B: Int = 5
const KEY_C: Int = 6
const KEY_D: Int = 7
const KEY_E: Int = 8
const KEY_F: Int = 9
const KEY_G: Int = 10
