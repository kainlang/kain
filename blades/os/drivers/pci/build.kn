use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let proj = project("pci_subsystem")
        .kind("static_library")
        .version("0.1.0")
        .description("KAINOS PCI bus enumeration — config space, BAR discovery, MSI/MSI-X, capability walking")
        .source_root(".")
        .module_root(".")
        .target("llvm")
        .triple("x86_64-unknown-none")
        .freestanding(true)
        .profile("debug")

    let check = check_task("check-pci")
        .project(proj)
        .target("llvm")

    let lib = native_library("pci-lib")
        .project(proj)
        .requires(check)

    return build_graph()
        .project(proj)
        .task(check)
        .task(lib)
