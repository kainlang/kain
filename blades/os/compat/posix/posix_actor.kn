    let _ = (a0, a1, a2, a3, a4, a5)
    return 0

// ============================================================================
//  FUTEX SYSCALL — critical for pthreads
// ============================================================================

fn posix_futex(a0: Int, a1: Int, a2: Int, a3: Int, a4: Int, a5: Int) -> Int:
    let uaddr = a0
    let futex_op = a1
    let val = a2
    let _ = (a3, a4, a5)  // timeout, uaddr2, val3

    let op = futex_op & 0x7F
    // FUTEX_WAIT = 0
    if op == 0:
        // In KAINOS: ask SchedulerActor to block actor until uaddr changes
        // For compat: return 0 (success — value matched)
        return 0
    // FUTEX_WAKE = 1
    if op == 1:
        // In KAINOS: wake up to val actors waiting on uaddr
        return 0  // 0 woken
    // FUTEX_WAIT_BITSET = 9
    if op == 9:
        return 0
    // FUTEX_WAKE_BITSET = 10
    if op == 10:
        return 0
    return -22  // EINVAL

