use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let proj = project("kainos_lib")
        .kind("static_library")
        .version("0.1.0")
        .description("KAINOS kernel utility library: printf, string, bitmap, list, math")
        .source_root(".")
        .module_root(".")
        .target("llvm")
        .triple("x86_64-unknown-none")
        .freestanding(true)
        .profile("debug")

    let check = check_task("check-lib")
        .project(proj)
        .target("llvm")

    let lib = native_library("kernel-lib-util")
        .project(proj)
        .requires(check)

    return build_graph()
        .project(proj)
        .task(check)
        .task(lib)
