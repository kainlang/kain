use std::text
use std::process
use std::os

struct TestEntry:
    name: String
    file: String
    category: String
    description: String
    requires_network: Bool
    requires_faux: Bool
    slow: Bool
    target: String

struct RunnerArgs:
    filter: String
    list_only: Bool
    category: String
    include_slow: Bool
    offline: Bool

