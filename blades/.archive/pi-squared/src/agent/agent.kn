    return queue_json        // stub: no-op for v0.1

pub fn pi_queue_drain(queue_json: String, mode: String) -> (String, String):
    return ("[]", queue_json)  // stub

pub fn pi_queue_clear(queue_json: String) -> String:
    return "[]"
