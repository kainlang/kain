// build.kn — std::ui widget tests project
use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let project = project("std-ui-widget-tests")
        .kind("kain_executable")
        .version("0.1.0")
        .description("std::ui widget tests — buttons, sliders, checkboxes, text inputs, progress bars, toggles, spinners, labels, layout")
        .entry("amalgamation_showcase.kn")
        .source_roots(["."])
        .module_roots(["."])
        .generated_root("telemetry")
        .targets("llvm")
        .artifact_root(".kain/out")
        .cache_root(".kain/cache/build")

    let sources = source_set("wut-sources")
        .root(".")
        .glob("*.kn")

    let check = check_task("check-llvm")
        .project(project)
        .target("llvm")
        .inputs(sources)
        .telemetry("wut.evidence")

    let exe = native_executable("root-executable")
        .project(project)
        .output("$blade/amalgamation_showcase.exe")
        .requires(check)

    return build_graph(project)
        .sources(sources)
        .tasks(check, exe)
