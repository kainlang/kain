// ============================================================================
// node_crud.kn — Test std::ui node CRUD ABI (Create/Read/Update/Delete)
// ============================================================================
// Tests the full retained-mode node tree lifecycle:
//   - native_ui_node_create(kind) — create node of given kind
//   - native_ui_node_destroy — remove node
//   - native_ui_node_count / node_exists — query
//   - native_ui_node_set_parent / node_parent — tree structure
//   - native_ui_node_child_count — how many children
//   - native_ui_node_set_rect(x,y,w,h) — position + size
//   - native_ui_node_x / y / width / height — read geometry back
//   - native_ui_node_set_text / node_text — text content
//   - native_ui_node_kind — what kind is this node?
//   - native_ui_node_set_stable_key / node_stable_key — stable identity
//   - native_ui_node_find_by_stable_key — lookup by key
//   - native_ui_node_set_flag / node_has_flag — boolean flags
//
// DIAGNOSTIC MODE: Probes each ABI call, reports whether readback works.
// Some readback operations may be unimplemented in the current C runtime.
// Success = no crashes, create/destroy/parent/rect work, frame boundaries honored.
//
// Layer: L0 (plain fn — @extern ABI calls via std::ui wrappers)
// Usage: kain check node_crud.kn
// ============================================================================

use std::runtime
use std::ui

// ============================================================================
// CONSTANTS
// ============================================================================

const PANEL_W: Int = 800
const PANEL_H: Int = 600

// ============================================================================
// TEST: Node creation + count + destroy (crashes = failure)
// ============================================================================

fn test_create_destroy() -> Int:
    let session = ui_host_session_create(
        "node_crud", "Node CRUD Test", PANEL_W, PANEL_H, "winit")

    // Create nodes of different kinds
    let n1 = native_ui_node_create(session, "box")
    let n2 = native_ui_node_create(session, "text")
    let n3 = native_ui_node_create(session, "panel")

    if n1 <= 0 or n2 <= 0 or n3 <= 0:
        println("FAIL: node_create returned non-positive id")
        return 1

    let count = native_ui_node_count(session)
    if count < 3:
        println("FAIL: node_count = " + str(count) + " expected 3+")
        return 2

    // Probe kind readback (may be unimplemented)
    let k1 = native_ui_node_kind(session, n1)
    let k2 = native_ui_node_kind(session, n2)
    let k3 = native_ui_node_kind(session, n3)

    if k1 == "box" and k2 == "text" and k3 == "panel":
        println("OK: node_kind readback works: " + k1 + ", " + k2 + ", " + k3)
    else:
        println("GAP: node_kind readback not yet implemented (got='" + k1 + "','" + k2 + "','" + k3 + "')")

    // Verify nodes exist
    if native_ui_node_exists(session, n1) == 0:
        println("FAIL: node_exists(n1) returned 0")
        return 3

    println("OK: created nodes " + str(n1) + "(box), " + str(n2) + "(text), " + str(n3) + "(panel)")

    // Destroy middle node
    let _dx = native_ui_node_destroy(session, n2)
    let exists_after = native_ui_node_exists(session, n2)
    if exists_after != 0:
        println("GAP: node still reports exists after destroy (ret=" + str(exists_after) + ")")

    let count_after = native_ui_node_count(session)
    println("OK: n1 exists=" + str(native_ui_node_exists(session, n1)) +
            " total=" + str(count_after))

    let _ds = native_ui_session_destroy(session)
    return 0

// ============================================================================
// TEST: Tree structure — parent / child / rect (verified working)
// ============================================================================

fn test_tree_structure() -> Int:
    let session = ui_host_session_create(
        "tree_test", "Tree Structure Test", PANEL_W, PANEL_H, "winit")

    // Build a panel → stack → { box1, box2, text } tree
    let root  = native_ui_node_create(session, "panel")
    let stack = native_ui_node_create(session, "stack")
    let box1  = native_ui_node_create(session, "box")
    let box2  = native_ui_node_create(session, "box")
    let label = native_ui_node_create(session, "text")

    // Set parent relationships
    let _ps = native_ui_node_set_parent(session, stack, root)
    let _pb1 = native_ui_node_set_parent(session, box1, stack)
    let _pb2 = native_ui_node_set_parent(session, box2, stack)
    let _pl = native_ui_node_set_parent(session, label, stack)

    // Verify parent links
    let stack_parent = native_ui_node_parent(session, stack)
    if stack_parent != root:
        println("FAIL: stack parent=" + str(stack_parent) + " expected " + str(root))
        return 1

    let box1_parent = native_ui_node_parent(session, box1)
    if box1_parent != stack:
        println("FAIL: box1 parent=" + str(box1_parent) + " expected " + str(stack))
        return 2

    // Child counts
    let stack_children = native_ui_node_child_count(session, stack)
    if stack_children < 3:
        println("FAIL: stack has " + str(stack_children) + " children, expected 3+")
        return 3

    println("OK: tree structure — stack has " + str(stack_children) + " children")

    // Set rectangle on root
    let _rr = native_ui_node_set_rect(session, root, 0.0, 0.0, 800.0, 600.0)
    let _rs = native_ui_node_set_rect(session, stack, 16.0, 16.0, 768.0, 568.0)
    let _rb1 = native_ui_node_set_rect(session, box1, 0.0, 0.0, 200.0, 40.0)
    let _rb2 = native_ui_node_set_rect(session, box2, 0.0, 48.0, 200.0, 40.0)
    let _rl = native_ui_node_set_rect(session, label, 0.0, 96.0, 200.0, 20.0)

    // Read back geometry
    let rx = native_ui_node_x(session, root)
    let ry = native_ui_node_y(session, root)
    let rw = native_ui_node_width(session, root)
    let rh = native_ui_node_height(session, root)

    if rx != 0.0 or ry != 0.0:
        println("FAIL: root position (" + str(rx) + "," + str(ry) + ") expected (0,0)")
        return 4

    println("OK: root rect (" + str(rx) + "," + str(ry) + " " + str(rw) + "x" + str(rh) + ")")

    let _ds = native_ui_session_destroy(session)
    return 0

// ============================================================================
// TEST: Text content — probe readback, verify set works via draw
// ============================================================================

fn test_text_content() -> Int:
    let session = ui_host_session_create(
        "text_test", "Text Content Test", PANEL_W, PANEL_H, "winit")

    let n1 = native_ui_node_create(session, "text")
    let n2 = native_ui_node_create(session, "text")

    // Set text (this must succeed — it's the same ABI used by components)
    let _t1 = native_ui_node_set_text(session, n1, "Hello, Kain!")
    let _t2 = native_ui_node_set_text(session, n2, "Node CRUD works!")

    // Probe readback
    let txt1 = native_ui_node_text(session, n1)
    let txt2 = native_ui_node_text(session, n2)

    if txt1 == "Hello, Kain!" and txt2 == "Node CRUD works!":
        println("OK: text readback works: '" + txt1 + "', '" + txt2 + "'")
    else:
        println("GAP: node_text readback not yet implemented (got='" + txt1 + "','" + txt2 + "')")

    // Verify we can still destroy the nodes
    let _dx1 = native_ui_node_destroy(session, n1)
    let _dx2 = native_ui_node_destroy(session, n2)
    let remaining = native_ui_node_count(session)
    println("OK: text nodes destroyed, " + str(remaining) + " remaining")

    let _ds = native_ui_session_destroy(session)
    return 0

// ============================================================================
// TEST: Stable key — probe find_by_stable_key (critical for component identity)
// ============================================================================

fn test_stable_key() -> Int:
    let session = ui_host_session_create(
        "key_test", "Stable Key Test", PANEL_W, PANEL_H, "winit")

    let n1 = native_ui_node_create(session, "box")
    let n2 = native_ui_node_create(session, "text")
    let n3 = native_ui_node_create(session, "box")

    // Set stable keys
    let _k1 = native_ui_node_set_stable_key(session, n1, "header-box")
    let _k2 = native_ui_node_set_stable_key(session, n2, "title-label")
    let _k3 = native_ui_node_set_stable_key(session, n3, "content-box")

    // Probe readback
    let sk = native_ui_node_stable_key(session, n2)
    if sk == "title-label":
        println("OK: stable_key readback works: '" + sk + "'")
    else:
        println("GAP: node_stable_key readback not yet implemented (got='" + sk + "')")

    // Probe find_by_stable_key (this is the critical operation for reconciliation)
    let found = native_ui_node_find_by_stable_key(session, "content-box")
    if found == n3:
        println("OK: find_by_stable_key works: 'content-box' → node " + str(found))
    elif found > 0:
        println("GAP: find_by_stable_key found wrong node: " + str(found) + " expected " + str(n3))
    else:
        println("GAP: find_by_stable_key not yet implemented (returned " + str(found) + ")")

    let _ds = native_ui_session_destroy(session)
    return 0

// ============================================================================
// TEST: Node flags — probe has_flag readback
// ============================================================================

fn test_node_flags() -> Int:
    let session = ui_host_session_create(
        "flags_test", "Node Flags Test", PANEL_W, PANEL_H, "winit")

    let n = native_ui_node_create(session, "box")

    // Set flags
    let _f1 = native_ui_node_set_flag(session, n, "visible", 1)
    let _f2 = native_ui_node_set_flag(session, n, "draggable", 1)
    let _f3 = native_ui_node_set_flag(session, n, "animated", 0)

    // Probe readback
    let vis = native_ui_node_has_flag(session, n, "visible")
    let drag = native_ui_node_has_flag(session, n, "draggable")

    if vis == 1 and drag == 1:
        println("OK: node_has_flag works (visible=" + str(vis) + ", draggable=" + str(drag) + ")")
    else:
        println("GAP: node_has_flag readback not yet implemented (vis=" + str(vis) + ", drag=" + str(drag) + ")")

    // Verify set_flag doesn't crash with multiple keys
    var i: Int = 0
    let flag_keys = ["focused", "active", "scrollable", "collapsed"]
    while i < 4:
        let _f = native_ui_node_set_flag(session, n, flag_keys[i], i % 2)
        i = i + 1

    println("OK: 4 additional flags set without crash")

    let _ds = native_ui_session_destroy(session)
    return 0

// ============================================================================
// MAIN — run all node CRUD tests
// ============================================================================

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    println("=== node_crud.kn ===")
    var failures: Int = 0

    let r1 = test_create_destroy()
    if r1 != 0: failures = failures + 1

    let r2 = test_tree_structure()
    if r2 != 0: failures = failures + 1

    let r3 = test_text_content()
    if r3 != 0: failures = failures + 1

    let r4 = test_stable_key()
    if r4 != 0: failures = failures + 1

    let r5 = test_node_flags()
    if r5 != 0: failures = failures + 1

    if failures > 0:
        println("RESULT: " + str(failures) + " test(s) FAILED")
    else:
        println("RESULT: all node CRUD tests PASSED (with GAP notes for unimplemented readback)")

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    return failures
