// state_persistence.kn — State survives across frames
// Proves: state type persistence across frame loop via vtable slots
// NOTE: pulse/resonate not yet codegen-wired for components
use std::runtime

component StateDemo():
    // i64 persistence — vtable slots 8/9
    state counter: Int = 0
    // f64 persistence — vtable slots 19/20
    state progress: Float = 0.0
    // String persistence — vtable slots 21/22
    state status_text: String = "initialized"

    render <panel title="State Persistence — Int + Float + String" fill_color="#1a1a2e">
        <stack direction="vertical" spacing={8.0} padding={16.0}>
            <text value="State Persistence Proof" font_size={18.0} fill_color="#E8E8F0" />
            <text value="Int, Float, and String state survive across frames via vtable slots." font_size={12.0} fill_color="#8888A0" />
            <text value="State types: Int (slot 8-9), Float (slot 19-20), String (slot 21-22)" font_size={12.0} fill_color="#4A90D9" />
            <text value="Pulse clock NOT yet codegen-wired in component bodies." font_size={12.0} fill_color="#8888A0" />
        </stack>
    </panel>

world SPWorld:
    surface native_ui => StateDemo

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init
    return 0
