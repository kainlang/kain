use std::runtime
fn main() -> Int:
    let init = runtime_init()
    if init != 0: return 100 + init
    let count = process_arg_count()
    println("arg count: " + str(count))
    var i = 0
    while i < count:
        println("arg " + str(i) + ": " + process_arg(i))
        i = i + 1
    return 0
