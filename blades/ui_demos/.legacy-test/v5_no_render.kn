// v5_no_render.kn — component with state but NO render block at all

use std::runtime

world StateOnlyWorld:
    state count: Int = 0
    surface native_ui => StateOnlyRoot

component StateOnlyRoot():
    state x: Int = 5

fn main() -> Int:
    let init = runtime_init()
    if init != 0: return 100 + init
    let _ = StateOnlyWorld.count
    let shutdown = runtime_shutdown()
    if shutdown != 0: return 200 + shutdown
    return 0
