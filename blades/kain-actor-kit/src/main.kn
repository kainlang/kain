use kain_actor_kit::actor_counter_call
use kain_actor_kit::actor_server_ready_message
use kain_actor_kit::actor_start_counter

fn main() -> Int:
    let counter = actor_start_counter(0)
    let first = actor_counter_call(counter, 4)
    println(actor_server_ready_message("counter"))
    if first == 4:
        return 0
    return 1
