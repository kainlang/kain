    return (acc + attr_hits + (attr_misses * 37) + call_count + (generic_calls * 41) + fast_calls + auto_released) % PYTHON_INTEROP_MODULUS

fn python_region_bound_sqrt_fast_checksum(iterations: Int) -> Int:
    let region = python_region_begin()
    let math_region = python_region_import(region, "math")
