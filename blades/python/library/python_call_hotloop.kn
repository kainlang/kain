use std::python

import math as py_math

const MODULUS: Int = 1000000007
const ITERATIONS: Int = 150000
const EXPECTED: Int = 9325307

fn main() -> Int:
    let sqrt_fn = python_getattr_raw(py_math, "sqrt")
    let tau_bias = to_int(python_getattr_raw(py_math, "tau"))
    var acc: Int = 0
    var index: Int = 0

    while index < ITERATIONS:
        let lane_value = ((index * 17) % 4096) + 1
        let sqrt_value = py_call_raw_f64_trunc_i64(sqrt_fn, lane_value as Float)
        acc = (acc + tau_bias + sqrt_value + (index % 29)) % MODULUS
        index = index + 1

    if acc != EXPECTED:
        return 1
    return 0
