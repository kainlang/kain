QPushButton#record_btn { background: #3d1212; color: #da3633; border: 2px solid #da3633; border-radius: 18px; min-width: 36px; min-height: 36px; max-width: 36px; max-height: 36px; font-size: 16px; padding: 0px; }
QPushButton#record_btn:hover { background: #5a1a1a; }
