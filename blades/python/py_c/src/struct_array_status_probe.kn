use std::fs

struct ProbeStatus:
    message: String

struct ProbeWrap:
    ok: Bool
    value: Array<Int>
    status: ProbeStatus

fn build_wrap() -> ProbeWrap:
    let items: Array<Int> = [10, 13, 17, 20]
    return ProbeWrap {
        ok: true,
        value: items,
        status: ProbeStatus {
            message: ""
        }
    }

fn main() -> Int:
    let wrap = build_wrap()
    fs_write_text("struct_array_status_probe_status.txt", to_string(len(wrap.value)) + "|" + to_string(wrap.value[0]))
    return len(wrap.value)
