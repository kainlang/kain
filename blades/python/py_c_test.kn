// ============================================================================
pub struct CrossModuleWrap:
    ok: Bool
    value: Array<Int>
    note: String

pub fn build_cross_module_wrap() -> CrossModuleWrap:
    let items: Array<Int> = [10, 13, 17, 20]
    return CrossModuleWrap {
        ok: true,
        value: items,
        note: ""
    }

