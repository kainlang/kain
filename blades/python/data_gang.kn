use helpers::MODULUS

// ── Phase 1: Metal Probe ──
//  Proves we're on real hardware with Kain's metal layer.

fn probe_metal_layer() -> (Int, Int, Int, Int) with Unsafe:
    let rdtsc_val = rdtsc()
    let cpuid_sig = cpuid_eax(0, 0)
    let page_size = vm_page_size()
    let cores = cpu_core_count()
    return (cpuid_sig, rdtsc_val, page_size, cores)

// ── Phase 1b: Raw memory ownership exercise ──

fn exercise_raw_memory() -> Int with Unsafe:
    let n = 64
    let mut cells: ptr<Int> = alloc_zeroed(n, "Int")

    collapse cells:
        var i: Int = 0
        while i < n:
            mem_store(ptr_offset(cells, i, "Int"), (i * 17) + 3, "Int")
            i = i + 1
        0

    let checksum: Int = observe cells:
        var sum: Int = 0
        var j: Int = 0
        while j < n:
            sum = (sum + mem_load(ptr_offset(cells, j, "Int"), "Int")) % MODULUS
            j = j + 1
        sum

    decay cells
    return checksum

// ── Phase 1c: OS probe ──

fn probe_os_layer() -> Int:
    let pid = os_getpid()
    let cwd = os_getcwd()
    let os_name_val = os_name()
    let cpu_count = os_cpu_count()
    let page_size = os_getpagesize()
    return pid + cpu_count + page_size

// ── Phase 2: Probe all 21 packages ──

fn probe_packages() -> Int:
    let mask = probe_all_packages()
    let _ = commit_packages(GpuAuthority, mask)
    return mask

// ── Phase 2b: Exercise packages for checksums ──

fn exercise_packages() -> Int:
    return exercise_all_packages()

// ── Phase 3: Pre-Simulation ──
//  Exercises the semantic stack without pygame.

fn run_pre_simulation(gate: GpuBridge, rounds: Int) -> Int:
    var checksum: Int = 137
    var round: Int = 0
    while round < rounds:
        // Exercise converge lane
        let mix_val = gpu_checksum_fast(round, round * 3, round * 7, round, round)
        // Exercise actor relay
        let reply = ask(gate, "Fold", checksum + round)
        // Mix all results
        checksum = (checksum + mix_val + reply) % MODULUS
        // Commit frame to world
        let _ = commit_frame(GpuAuthority, round)
        round = round + 1

    // Verify converge lanes
    let health = pipeline_health_check()
    if health != 0:
        return -10

    return checksum

// ── Phase 4: Register Callback Bridge ──
//  Creates Python callable objects that the GPU compute loop can invoke.

fn register_gpu_bridge(gate: GpuBridge) -> (Any, Any, Any, Any):
    // Frame tick callback
    let frame_cb = python_actor_callback(gate as Int, "FrameTick")
    let frame_fn = python_actor_callback_callable(frame_cb)

    // Metrics update callback
    let metrics_cb = python_actor_callback(gate as Int, "MetricsUpdate")
    let metrics_fn = python_actor_callback_callable(metrics_cb)

    // GPU checksum callback
    let gpu_cs_cb = python_actor_callback(gate as Int, "GpuChecksum")
    let gpu_cs_fn = python_actor_callback_callable(gpu_cs_cb)

    // Input event callback
    let event_cb = python_actor_callback(gate as Int, "InputEvent")
    let event_fn = python_actor_callback_callable(event_cb)

    // Bind to Python __main__ globals
    let main_mod = python_import("__main__")
    python_setattr(main_mod, "kain_frame_cb", frame_fn)
    python_setattr(main_mod, "kain_metrics_cb", metrics_fn)
    python_setattr(main_mod, "kain_gpu_cs_cb", gpu_cs_fn)
    python_setattr(main_mod, "kain_event_cb", event_fn)

    return (frame_fn, metrics_fn, gpu_cs_fn, event_fn)

// ── Phase 5: Launch GPU Compute ──
//  Injects inline Python. BLOCKS until window closes.

fn launch_gpu_compute() -> Int:
    let _bootstrap = build_gpu_bootstrap()
    let _result = python_exec(_bootstrap)
    return 0

// ── Phase 6: Validate ──
//  After window closes, verify worlds, packages, and telemetry.

fn validate_after_shutdown() -> Int:
    // World should have advanced at least a few frames
    let f = GpuAuthority.frame
    println("validate: frame=" + str(f))
    if f <= 0:
        return 50

    // Mirror should have received entangle propagation
    let mf = GpuMirror.frame_copy
    println("validate: mirror_frame=" + str(mf))
    if mf <= 0:
        return 60

    // At least some packages should be loaded
    let pk = GpuAuthority.packages_loaded
    println("validate: packages=" + str(pk))
    if pk <= 0:
        return 70

    // Status must be clean
    let status = GpuAuthority.status
    println("validate: status=" + str(status))
    if status != 0 and status != 2:
        return 90 + status

    println("validate: ALL OK")
    return 0

// ── Print package versions ──

pub fn print_package_versions():
    let np_ver = get_numpy_version()
    let pg_ver = get_pygame_version()
    let ps_ver = get_psutil_version()
    let mg_ver = get_moderngl_version()
    let rc_ver = get_rich_version()
    println("numpy: " + np_ver)
    println("pygame: " + pg_ver)
    println("psutil: " + ps_ver)
    println("moderngl: " + mg_ver)
    println("rich: " + rc_ver)

// ── MAIN ──

fn main() -> Int with Unsafe:
    // ── Init runtime ──
    let boot = runtime_init()
    if boot != 0:
        return 100 + boot

    // ── Phase 1: Metal Probe ──
    let (cpuid_sig, rdtsc_val, page_size, cpu_cores) = probe_metal_layer()
    println("cpuid=" + str(cpuid_sig) + " rdtsc=" + str(rdtsc_val) +
            " page=" + str(page_size) + " cores=" + str(cpu_cores))

    // ── Phase 1b: Raw memory exercise ──
    let mem_checksum = exercise_raw_memory()
    println("mem_checksum=" + str(mem_checksum))

    // ── Phase 1c: OS probe ──
    let os_sum = probe_os_layer()
    println("os_sum=" + str(os_sum))

    // ── Phase 2: Package Probe ──
    let pkg_mask = probe_packages()
    let pkg_exercise_cs = exercise_packages()
    print_package_versions()
    println("pkg_mask=" + str(pkg_mask))
    println("pkg_exercise_cs=" + str(pkg_exercise_cs))

    // Count loaded packages
    var pkg_count: Int = 0
    var bit: Int = 0
    while bit < 21:
        if ((pkg_mask >> bit) & 1) != 0:
            pkg_count = pkg_count + 1
        bit = bit + 1
    println("packages loaded: " + str(pkg_count) + "/21")

    // Check if pygame is available
    let pygame_available = python_module_available("pygame")
    println("pygame available: " + (if pygame_available: "yes" else: "no"))

    if pygame_available == false:
        // No pygame — run headless pre-simulation only
        println("headless mode — pygame not available")
        let gate = spawn GpuBridge()
        let _warm = ask(gate, "Fold", 1)
        let sim_result = run_pre_simulation(gate, 12)
        let final_shutdown = runtime_shutdown()
        if sim_result < 0:
            return 90
        println("pre-sim OK, exiting")
        return 0

    // ── Phase 3: Spawn bridge actor ──
    println("spawning bridge actor...")
    let gate = spawn GpuBridge()
    let _warm = ask(gate, "Fold", 1)
    println("bridge actor ready")

    // ── Phase 4: Register callbacks ──
    println("registering callbacks...")
    let (_frame_fn, _metrics_fn, _gpu_cs_fn, _event_fn) = register_gpu_bridge(gate)
    println("callbacks registered")

    // ── Phase 5: Launch GPU Compute ──
    println("launching GPU compute window...")
    let launch_result = launch_gpu_compute()
    println("GPU compute done, frames=" + str(GpuAuthority.frame))

    if launch_result != 0:
        let shutdown = runtime_shutdown()
        return 200 + launch_result

    // ── Phase 6: Validate ──
    println("validating...")
    let validate_result = validate_after_shutdown()
    println("validate result=" + str(validate_result))
    if validate_result != 0:
        println("validate FAILED=" + str(validate_result))
        let shutdown = runtime_shutdown()
        return 300 + validate_result

    // ── Clean shutdown ──
    println("--- GPU TOOLS SHUTDOWN ---")
    println("frame=" + str(GpuAuthority.frame) +
            " cpu=" + str(GpuAuthority.cpu_percent) +
            " ram=" + str(GpuAuthority.ram_percent) +
            " gpu_cs=" + str(GpuAuthority.gpu_checksum) +
            " pkg_mask=" + str(GpuAuthority.packages_loaded) +
            " cpuid=" + str(cpuid_sig))

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 500 + shutdown

    println("--- GPU TOOLS DONE ---")
    return 0

// ============================================================================
// pipeline.kn
// ============================================================================
// ============================================================================
//  PIPELINE — Converge + Orchestrate + Pulse for GPU TOOLS
// ============================================================================
//  GPU dispatch strategies, multi-stage rendering pipelines, timing.
//  All semantic machinery — no components, no surfaces.
// ============================================================================

use std::intent

use world::GpuAuthority
use world::commit_frame
use world::commit_metrics
use world::commit_gpu_checksum
use world::frame_valid
use world::percent_valid
use helpers::gpu_mix
use helpers::gpu_mod
use helpers::gpu_clamp
use helpers::MODULUS

// ── CONVERGE: GPU Checksum Strategy (fast path vs reference) ──

converge gpu_checksum_fast(r: Int, g: Int, b: Int, x: Int, y: Int) -> Int:
    spec reference:
        return ((r * 73) + (g * 97) + (b * 113) + (x * 17) + (y * 31)) % MODULUS
    fast llvm_lane when target("llvm"):
        return ((r * 73) + (g * 97) + (b * 113) + (x * 17) + (y * 31)) % MODULUS
    verify random(4)

// ── CONVERGE: Zoom parameter normalization ──

converge normalize_zoom(raw: Int) -> Int:
    spec reference:
        if raw < 50: return 50
        if raw > 5000: return 5000
        return raw
    fast clamp_lane when target("llvm"):
        let v = raw & 8191
        if v < 50: return 50
        if v > 5000: return 5000
        return v
    verify random(4)

// ── ORCHESTRATE: GPU frame pipeline ──

orchestrate gpu_frame_pipeline(frame: Int, cpu: Int, ram: Int, checksum: Int) -> Int:
    stage validate_frame: law frame_valid(frame) residency host policy static
    stage validate_cpu: law percent_valid(cpu) residency host policy static
    stage validate_ram: law percent_valid(ram) residency host policy static
    stage normalize_gpu: converge gpu_checksum_fast(checksum % 256, (checksum / 256) % 256, (checksum / 65536) % 256, frame % 1024, frame / 1024) when capability("cpu.scalar") residency host transfer none policy telemetry_prefer_cpu
    stage mix_all: cpu gpu_mix(normalize_gpu, cpu + ram, frame) deps [normalize_gpu] residency host transfer none policy telemetry_prefer_cpu
    stage commit_result: patch commit_gpu_checksum(GpuAuthority, normalize_gpu) deps [mix_all] requires validate_frame residency host policy telemetry_balance_latency
    return mix_all

// ── PULSE: Frame heartbeat ──

pulse gpu_heartbeat every 16 ms jitter 2 ms:
    let _ = commit_frame(GpuAuthority, GpuAuthority.frame + 1)

// ── Pipeline health check ──

pub fn pipeline_health_check() -> Int:
    let converge_before = converge_mismatch_count()
    let _sample = gpu_checksum_fast(42, 73, 101, 7, 3)
    let converge_delta = converge_mismatch_count() - converge_before
    if converge_delta > 0:
        return -1
    return 0

// ============================================================================
// scene.kn
// ============================================================================
// ============================================================================
//  SCENE — GPU Data Layout (Shatter Structs)
// ============================================================================
//  No components, no UI. Just data schemas for GPU compute workloads.
// ============================================================================

use helpers::COMPUTE_W
use helpers::COMPUTE_H

// ── Julia pixel sample — SoA layout for GPU output ──

shatter struct JuliaPixel:
    r: Int
    g: Int
    b: Int
    iteration: Int
    escaped: Bool

// ── GPU particle — for compute shader particle system ──

shatter struct GpuParticle:
    pos_x: Float
    pos_y: Float
    vel_x: Float
    vel_y: Float
    life: Float
    max_life: Float
    alive: Bool

// ── System metrics snapshot — SoA for psutil data ──

shatter struct MetricsSnapshot:
    cpu_percent: Float
    ram_percent: Float
    ram_used_gb: Float
    ram_total_gb: Float
    proc_count: Int

// ── Package version info ──

shatter struct PackageVersion:
    name_hash: Int
    version_major: Int
    version_minor: Int
    version_patch: Int
    loaded: Bool

pub const PIXEL_COUNT: Int = COMPUTE_W * COMPUTE_H
pub const MAX_PACKAGES: Int = 24

pub fn make_empty_pixels() -> [JuliaPixel]:
    return []

pub fn make_empty_metrics() -> MetricsSnapshot:
    return MetricsSnapshot {
        cpu_percent: 0.0, ram_percent: 0.0,
        ram_used_gb: 0.0, ram_total_gb: 0.0,
        proc_count: 0
    }

// ============================================================================
// world.kn
// ============================================================================
// ============================================================================
//  WORLD — GPU TOOLS State Authority + Mirror + Laws + Patches
// ============================================================================
//  NO component. NO surface native_ui. Pure state authority for GPU compute.
//  Pygame + moderngl is the ONLY window — worlds just hold data.
// ============================================================================

use helpers::WIN_W
use helpers::WIN_H
use helpers::gpu_clamp

// ── Authority — mutable GPU tools state ──

world GpuAuthority:
    state frame: Int = 0
    state fps: Int = 60
    state cpu_percent: Int = 0
    state ram_percent: Int = 0
    state ram_used_mb: Int = 0
    state ram_total_mb: Int = 0
    state gpu_checksum: Int = 0      // cryptographic checksum of GPU output
    state julia_zoom: Int = 300       // zoom level * 100
    state julia_center_x: Int = 0     // center x * 1000
    state julia_center_y: Int = 0     // center y * 1000
    state particle_count: Int = 4096  // GPU particle count
    state packages_loaded: Int = 0    // bitmask of loaded packages
    state status: Int = 0             // 0 = running, 1 = paused, 2 = shutdown

// ── Mirror — read-only view for entangle propagation ──

world GpuMirror:
    state frame_copy: Int = 0
    state fps_copy: Int = 60
    state cpu_percent_copy: Int = 0
    state ram_percent_copy: Int = 0
    state gpu_checksum_copy: Int = 0
    state packages_loaded_copy: Int = 0
    state status_copy: Int = 0

// ── Entangle — compiler-owned reactive sync ──

entangle GpuAuthority.frame <-> GpuMirror.frame_copy with single_writer
entangle GpuAuthority.fps <-> GpuMirror.fps_copy with single_writer
entangle GpuAuthority.cpu_percent <-> GpuMirror.cpu_percent_copy with single_writer
entangle GpuAuthority.ram_percent <-> GpuMirror.ram_percent_copy with single_writer
entangle GpuAuthority.gpu_checksum <-> GpuMirror.gpu_checksum_copy with single_writer
entangle GpuAuthority.packages_loaded <-> GpuMirror.packages_loaded_copy with single_writer
entangle GpuAuthority.status <-> GpuMirror.status_copy with single_writer

// ── Laws — invariant predicates ──

law frame_valid(value: Int) -> Bool:
    return value >= 0

law fps_valid(value: Int) -> Bool:
    return value >= 0 and value < 1000

law percent_valid(value: Int) -> Bool:
    return value >= 0 and value <= 100

law status_valid(value: Int) -> Bool:
    return value >= 0 and value <= 2

// ── Patches — journaled world mutations ──

patch commit_frame(authority: GpuAuthority, frame: Int) -> Int:
    authority.frame = frame
    return authority.frame

patch commit_fps(authority: GpuAuthority, fps: Int) -> Int:
    authority.fps = fps
    return authority.fps

patch commit_metrics(authority: GpuAuthority, cpu: Int, ram_pct: Int, ram_used: Int, ram_total: Int) -> Int:
    authority.cpu_percent = cpu
    authority.ram_percent = ram_pct
    authority.ram_used_mb = ram_used
    authority.ram_total_mb = ram_total
    return cpu + ram_pct

patch commit_gpu_checksum(authority: GpuAuthority, checksum: Int) -> Int:
    authority.gpu_checksum = checksum
    return authority.gpu_checksum

patch commit_julia_params(authority: GpuAuthority, zoom: Int, cx: Int, cy: Int) -> Int:
    authority.julia_zoom = zoom
    authority.julia_center_x = cx
    authority.julia_center_y = cy
    return zoom + cx + cy

patch commit_packages(authority: GpuAuthority, mask: Int) -> Int:
    authority.packages_loaded = mask
    return authority.packages_loaded

patch commit_status(authority: GpuAuthority, status: Int) -> Int:
    authority.status = status
    return authority.status

patch reset_world(authority: GpuAuthority) -> Int:
    authority.frame = 0
    authority.fps = 60
    authority.cpu_percent = 0
    authority.ram_percent = 0
    authority.ram_used_mb = 0
    authority.ram_total_mb = 0
    authority.gpu_checksum = 0
    authority.julia_zoom = 300
    authority.julia_center_x = 0
    authority.julia_center_y = 0
    authority.particle_count = 4096
    authority.packages_loaded = 0
    authority.status = 0
    return 0

