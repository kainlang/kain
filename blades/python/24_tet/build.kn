use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let pkg = package("24-tet")
        .version("0.1.0")
        .description("24 TET Python-driven piano and resonance surface.")

    let app = blade("24-tet")
        .entry("src/resonate_py.kn")
        .source_root("src")
        .module_root("src")
        .build_target("llvm")

    let defaults = build_defaults()
        .entry("src/resonate_py.kn")
        .artifact_root(".kain/out")
        .cache_root(".kain/cache/build")
        .profile("debug")
        .target("llvm")

    let run = run_defaults()
        .entry("src/resonate_py.kn")
        .target("llvm")
        .watch("src")
        .watch("build.kn")

    let check = build_check("check-llvm")
        .entry("src/resonate_py.kn")
        .target("llvm")
        .input("src/resonate_py.kn")
    .input("src/resonate_py_surface.py")
    .input("build.kn")

    let root_exe = native_executable("root-executable")
        .entry("src/resonate_py.kn")
        .root_output("$blade/24_tet.exe")
        .requires("check-llvm")
        .input("src/resonate_py.kn")
        .input("src/resonate_py_surface.py")
        .input("build.kn")

    let cert = certify("24-tet.local")
        .requires("check-llvm")
        .requires("root-executable")

    return build_graph()
        .package(pkg)
        .blade(app)
        .defaults(defaults)
        .run(run)
        .task(check)
        .task(root_exe)
        .task(cert)
