    return "kaintana.popover.open." + spec.stable_key

pub fn kaintana_popover_open(session_id: Int, anchor_node_id: Int, spec: KaintanaPopoverSpec) -> Int:
    return ui_state_set_bool(session_id, anchor_node_id, kaintana_popover_state_key(spec), 1)

