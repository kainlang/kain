    return input_action_released(action_session_id, action)

pub fn kaintana_action_axis_value(action_session_id: Int, axis: String) -> Float:
    return input_axis_value(action_session_id, axis)

pub fn kaintana_action_frame_index(action_session_id: Int) -> Int:
    return input_frame_index(action_session_id)

pub fn kaintana_action_event_count(action_session_id: Int) -> Int:
    return input_event_count(action_session_id)

pub fn kaintana_action_text_commit_count(action_session_id: Int) -> Int:
    return input_text_commit_count(action_session_id)

pub fn kaintana_action_text_commit(action_session_id: Int, index: Int) -> String:
    return input_text_commit(action_session_id, index)

pub fn kaintana_action_trace_text(action_session_id: Int) -> String:
    return input_trace_json(action_session_id)

pub fn kaintana_action_write_trace(action_session_id: Int, path: String) -> String:
    write_file(path, kaintana_action_trace_text(action_session_id))
    return path

pub fn kaintana_desktop_probe() -> Int:
    return kaintana_native_desktop_probe()

pub fn kaintana_desktop_scene_begin(spec: KaintanaWindowSpec) -> Int:
    return kaintana_native_desktop_begin_scene(spec.title, spec.width, spec.height, spec.clear_red, spec.clear_green, spec.clear_blue)

pub fn kaintana_desktop_scene_active() -> Int:
    return kaintana_native_desktop_scene_active()

pub fn kaintana_desktop_scene_write_report(path: String) -> Int:
    return kaintana_native_desktop_write_report(path)

pub fn kaintana_desktop_scene_write_bmp(path: String) -> Int:
    return kaintana_native_desktop_write_bmp(path)

pub fn kaintana_apply_shell_theme(session_id: Int, node_id: Int, theme: KaintanaTheme) -> Int:
    let _fill = kaintana_apply_fill_color(session_id, node_id, theme.shell_red, theme.shell_green, theme.shell_blue)
    return kaintana_apply_ink_color(session_id, node_id, theme.ink_red, theme.ink_green, theme.ink_blue)

pub fn kaintana_apply_panel_theme(session_id: Int, node_id: Int, theme: KaintanaTheme) -> Int:
    let _fill = kaintana_apply_fill_color(session_id, node_id, theme.panel_red, theme.panel_green, theme.panel_blue)
    return kaintana_apply_ink_color(session_id, node_id, theme.ink_red, theme.ink_green, theme.ink_blue)

pub fn kaintana_apply_accent_theme(session_id: Int, node_id: Int, theme: KaintanaTheme) -> Int:
    let _fill = kaintana_apply_fill_color(session_id, node_id, theme.accent_red, theme.accent_green, theme.accent_blue)
    return kaintana_apply_ink_color(session_id, node_id, theme.shell_red, theme.shell_green, theme.shell_blue)

pub fn kaintana_apply_signal_theme(session_id: Int, node_id: Int, theme: KaintanaTheme) -> Int:
    let _fill = kaintana_apply_fill_color(session_id, node_id, theme.signal_red, theme.signal_green, theme.signal_blue)
    return kaintana_apply_ink_color(session_id, node_id, theme.shell_red, theme.shell_green, theme.shell_blue)

pub fn kaintana_apply_text_theme(session_id: Int, node_id: Int, theme: KaintanaTheme) -> Int:
    return kaintana_apply_ink_color(session_id, node_id, theme.ink_red, theme.ink_green, theme.ink_blue)

pub fn kaintana_apply_muted_text_theme(session_id: Int, node_id: Int, theme: KaintanaTheme) -> Int:
    return kaintana_apply_ink_color(session_id, node_id, theme.muted_red, theme.muted_green, theme.muted_blue)

pub fn kaintana_retained_region(session_id: Int, parent_id: Int, stable_key: String, role_label: String, rect: KaintanaRect, theme: KaintanaTheme) -> Int:
    let node = kaintana_panel_node(session_id, parent_id, "kaintana.retained.region", stable_key, role_label, rect)
    let _theme = kaintana_apply_panel_theme(session_id, node, theme)
    let _box = ui_render_box(session_id, node, "fill")
    let _desktop = kaintana_desktop_fill(rect, theme.panel_red, theme.panel_green, theme.panel_blue, 255)
    return node

pub fn kaintana_retained_surface(session_id: Int, parent_id: Int, stable_key: String, surface_kind: String, caption: String, rect: KaintanaRect, theme: KaintanaTheme, font_resource_id: Int, baseline_y: Float) -> Int:
    let node = ui_reconcile_stateful_node(session_id, parent_id, "kaintana.retained.surface", stable_key, surface_kind, caption, rect.x, rect.y, rect.width, rect.height)
    let _theme = kaintana_apply_panel_theme(session_id, node, theme)
    let _box = ui_render_box(session_id, node, "fill")
    let _text = ui_render_text_value(session_id, node, font_resource_id, caption, rect.x + 16.0, rect.y + baseline_y, "ink")
    let _desktop_fill = kaintana_desktop_fill(rect, theme.panel_red, theme.panel_green, theme.panel_blue, 255)
    let _desktop_text = kaintana_desktop_text(caption, rect.x + 16.0, rect.y + baseline_y, theme.ink_red, theme.ink_green, theme.ink_blue, 255)
    return node

pub fn kaintana_retained_label(session_id: Int, parent_id: Int, stable_key: String, text: String, rect: KaintanaRect, theme: KaintanaTheme, font_resource_id: Int, baseline_y: Float) -> Int:
    let node = kaintana_text_node(session_id, parent_id, "kaintana.retained.label", stable_key, text, text, rect)
    let _theme = kaintana_apply_text_theme(session_id, node, theme)
    let _text = ui_render_text_value(session_id, node, font_resource_id, text, rect.x, rect.y + baseline_y, "ink")
    let _desktop = kaintana_desktop_text(text, rect.x, rect.y + baseline_y, theme.ink_red, theme.ink_green, theme.ink_blue, 255)
    return node

pub fn kaintana_retained_muted_label(session_id: Int, parent_id: Int, stable_key: String, text: String, rect: KaintanaRect, theme: KaintanaTheme, font_resource_id: Int, baseline_y: Float) -> Int:
    let node = kaintana_text_node(session_id, parent_id, "kaintana.retained.muted", stable_key, text, text, rect)
    let _theme = kaintana_apply_muted_text_theme(session_id, node, theme)
    let _text = ui_render_text_value(session_id, node, font_resource_id, text, rect.x, rect.y + baseline_y, "ink")
    let _desktop = kaintana_desktop_text(text, rect.x, rect.y + baseline_y, theme.muted_red, theme.muted_green, theme.muted_blue, 255)
    return node

pub fn kaintana_retained_action(session_id: Int, parent_id: Int, stable_key: String, label: String, rect: KaintanaRect, theme: KaintanaTheme, font_resource_id: Int, baseline_y: Float) -> Int:
    let node = kaintana_focusable_node(session_id, parent_id, "kaintana.retained.action", stable_key, label, label, rect)
    let _theme = kaintana_apply_accent_theme(session_id, node, theme)
    let _box = ui_render_box(session_id, node, "fill")
    let _text = ui_render_text_value(session_id, node, font_resource_id, label, rect.x + 16.0, rect.y + baseline_y, "ink")
    let _desktop_fill = kaintana_desktop_fill(rect, theme.accent_red, theme.accent_green, theme.accent_blue, 255)
    let _desktop_text = kaintana_desktop_text(label, rect.x + 16.0, rect.y + baseline_y, theme.shell_red, theme.shell_green, theme.shell_blue, 255)
    return node

pub fn kaintana_immediate_panel(session_id: Int, parent_id: Int, stable_key: String, caption: String, rect: KaintanaRect, theme: KaintanaTheme, font_resource_id: Int, baseline_y: Float) -> Int:
    let node = kaintana_panel_node(session_id, parent_id, "kaintana.immediate.panel", stable_key, caption, rect)
    let _theme = kaintana_apply_shell_theme(session_id, node, theme)
    let _box = ui_render_box(session_id, node, "fill")
    let _text = ui_render_text_value(session_id, node, font_resource_id, caption, rect.x + 16.0, rect.y + baseline_y, "ink")
    let _desktop_fill = kaintana_desktop_fill(rect, theme.shell_red, theme.shell_green, theme.shell_blue, 255)
    let _desktop_text = kaintana_desktop_text(caption, rect.x + 16.0, rect.y + baseline_y, theme.ink_red, theme.ink_green, theme.ink_blue, 255)
    return node

pub fn kaintana_immediate_badge(session_id: Int, parent_id: Int, stable_key: String, caption: String, rect: KaintanaRect, theme: KaintanaTheme, font_resource_id: Int, baseline_y: Float) -> Int:
    let node = kaintana_panel_node(session_id, parent_id, "kaintana.immediate.badge", stable_key, caption, rect)
    let _theme = kaintana_apply_signal_theme(session_id, node, theme)
    let _box = ui_render_box(session_id, node, "fill")
    let _text = ui_render_text_value(session_id, node, font_resource_id, caption, rect.x + 12.0, rect.y + baseline_y, "ink")
    let _desktop_fill = kaintana_desktop_fill(rect, theme.signal_red, theme.signal_green, theme.signal_blue, 255)
    let _desktop_text = kaintana_desktop_text(caption, rect.x + 12.0, rect.y + baseline_y, theme.shell_red, theme.shell_green, theme.shell_blue, 255)
    return node

pub fn kaintana_immediate_button(session_id: Int, parent_id: Int, stable_key: String, label: String, rect: KaintanaRect, theme: KaintanaTheme, font_resource_id: Int, baseline_y: Float) -> Int:
    let node = kaintana_focusable_node(session_id, parent_id, "kaintana.immediate.button", stable_key, label, label, rect)
    let _theme = kaintana_apply_accent_theme(session_id, node, theme)
    let _box = ui_render_box(session_id, node, "fill")
    let _text = ui_render_text_value(session_id, node, font_resource_id, label, rect.x + 16.0, rect.y + baseline_y, "ink")
    let _desktop_fill = kaintana_desktop_fill(rect, theme.accent_red, theme.accent_green, theme.accent_blue, 255)
    let _desktop_text = kaintana_desktop_text(label, rect.x + 16.0, rect.y + baseline_y, theme.shell_red, theme.shell_green, theme.shell_blue, 255)
    return node

pub fn kaintana_immediate_metric(session_id: Int, parent_id: Int, stable_key: String, label: String, value: String, rect: KaintanaRect, theme: KaintanaTheme, font_resource_id: Int, baseline_y: Float) -> Int:
    let metric_text = label + " // " + value
    let node = kaintana_text_node(session_id, parent_id, "kaintana.immediate.metric", stable_key, metric_text, metric_text, rect)
    let _theme = kaintana_apply_text_theme(session_id, node, theme)
    let _text = ui_render_text_value(session_id, node, font_resource_id, metric_text, rect.x, rect.y + baseline_y, "ink")
    let _desktop = kaintana_desktop_text(metric_text, rect.x, rect.y + baseline_y, theme.ink_red, theme.ink_green, theme.ink_blue, 255)
    return node

pub fn kaintana_poll_event(session_id: Int) -> Int:
    return native_ui_poll_event(session_id)

pub fn kaintana_event_kind(session_id: Int) -> String:
    return native_ui_event_kind(session_id)

pub fn kaintana_event_target(session_id: Int) -> Int:
    return native_ui_event_target(session_id)

pub fn kaintana_event_text(session_id: Int) -> String:
    return native_ui_event_text(session_id)

pub fn kaintana_click_node(session_id: Int, node_id: Int) -> Int:
    let center_x = native_ui_node_x(session_id, node_id) + (native_ui_node_width(session_id, node_id) * 0.5)
    let center_y = native_ui_node_y(session_id, node_id) + (native_ui_node_height(session_id, node_id) * 0.5)
    let _down = native_ui_push_event(session_id, "pointer.down", node_id, center_x, center_y, 0, "primary")
    return native_ui_push_event(session_id, "pointer.up", node_id, center_x, center_y, 0, "primary")

pub fn kaintana_button_activated(session_id: Int, node_id: Int) -> Int:
    if ui_event_targets(session_id, node_id) == 1:
        let _hover = ui_apply_hover_flag(session_id, node_id, native_ui_event_x(session_id), native_ui_event_y(session_id))
        let _pressed = ui_apply_pressed_flag_from_event(session_id, node_id)
        if ui_event_kind_is(session_id, "pointer.up") == 1:
            return 1
    return 0

pub fn kaintana_focus_node(session_id: Int, node_id: Int) -> Int:
    return native_ui_focus(session_id, node_id)

pub fn kaintana_focused_node(session_id: Int) -> Int:
    return native_ui_focused_node(session_id)

pub fn kaintana_focus_is(session_id: Int, node_id: Int) -> Int:
    if kaintana_focused_node(session_id) == node_id:
        return 1
    return 0

pub fn kaintana_action_activated(session_id: Int, action_session_id: Int, node_id: Int, action: String) -> Int:
    let pointer_activation = kaintana_button_activated(session_id, node_id)
    if kaintana_focus_is(session_id, node_id) == 1 and kaintana_action_down(action_session_id, action) == 1:
        let _pressed = native_ui_node_set_flag(session_id, node_id, "pressed", 1)
    if kaintana_focus_is(session_id, node_id) == 1 and kaintana_action_released(action_session_id, action) == 1:
        let _released = native_ui_node_set_flag(session_id, node_id, "pressed", 0)
    if pointer_activation == 1:
        return 1
    if kaintana_focus_is(session_id, node_id) == 1 and kaintana_action_pressed(action_session_id, action) == 1:
        let _focus = native_ui_focus(session_id, node_id)
        return 1
    return 0

pub fn kaintana_activate_focused_action(session_id: Int) -> Int:
    let focused = kaintana_focused_node(session_id)
    if focused <= 0:
        return 0
    return kaintana_click_node(session_id, focused)

pub fn kaintana_render_focus_ring(session_id: Int, node_id: Int, theme: KaintanaTheme, spread: Float) -> Int:
    if kaintana_focus_is(session_id, node_id) != 1:
        return 0
    let x = native_ui_node_x(session_id, node_id) - spread
    let y = native_ui_node_y(session_id, node_id) - spread
    let width = native_ui_node_width(session_id, node_id) + (spread * 2.0)
    let height = native_ui_node_height(session_id, node_id) + (spread * 2.0)
    let _ring = ui_style_color_rgba(session_id, node_id, "kaintana.focus.ring", kaintana_channel_float(theme.signal_red), kaintana_channel_float(theme.signal_green), kaintana_channel_float(theme.signal_blue), 0.86)
    let _draw = ui_render_box_at(session_id, node_id, x, y, width, height, "kaintana.focus.ring")
    let _desktop = kaintana_desktop_fill(kaintana_rect(x, y, width, height), theme.signal_red, theme.signal_green, theme.signal_blue, 132)
    return 1

