    return ui_state_bool(session_id, anchor_node_id, kaintana_popover_state_key(spec), 0)

pub fn kaintana_popover_rect(session_id: Int, anchor_node_id: Int, bounds: KaintanaRect, spec: KaintanaPopoverSpec) -> KaintanaRect:
    let preferred_x = native_ui_node_x(session_id, anchor_node_id) + spec.offset_x
    let preferred_y = native_ui_node_y(session_id, anchor_node_id) + native_ui_node_height(session_id, anchor_node_id) + spec.offset_y
    let right_edge = ui_rect_right(bounds.x, bounds.width)
    let bottom_edge = ui_rect_bottom(bounds.y, bounds.height)
    let max_x = ui_float_max(bounds.x, right_edge - spec.width)
    let max_y = ui_float_max(bounds.y, bottom_edge - spec.height)
    return kaintana_rect(
        ui_float_clamp(preferred_x, bounds.x, max_x),
        ui_float_clamp(preferred_y, bounds.y, max_y),
        spec.width,
        spec.height
    )

pub fn kaintana_popover_region(session_id: Int, parent_id: Int, anchor_node_id: Int, caption: String, bounds: KaintanaRect, spec: KaintanaPopoverSpec, theme: KaintanaTheme, font_resource_id: Int, baseline_y: Float) -> Int:
    if kaintana_popover_is_open(session_id, anchor_node_id, spec) != 1:
        return 0
    let rect = kaintana_popover_rect(session_id, anchor_node_id, bounds, spec)
    return kaintana_retained_surface(session_id, parent_id, "popover." + spec.stable_key, "surface.popover", caption, rect, theme, font_resource_id, baseline_y)

pub fn kaintana_frame_report_text(session_id: Int, spec: KaintanaWindowSpec, theme: KaintanaTheme, headline: String) -> String:
    var output = "framework=kaintana\n"
    output = output + "headline=" + headline + "\n"
    output = output + "theme=" + theme.name + "\n"
    output = output + "backend=" + spec.backend_id + "\n"
    output = output + "passive_backend=" + native_ui_host_backend(session_id) + "\n"
    output = output + "frame_index=" + str(native_ui_frame_index(session_id)) + "\n"
    output = output + "host_hash=" + str(native_ui_host_frame_hash(session_id)) + "\n"
    output = output + "node_count=" + str(native_ui_node_count(session_id)) + "\n"
    output = output + "draw_count=" + str(native_ui_draw_command_count(session_id)) + "\n"
    output = output + "dirty_count=" + str(native_ui_dirty_count(session_id)) + "\n"
    output = output + "hot_reload_generation=" + str(kaintana_hot_reload_generation(session_id)) + "\n"
    output = output + "hot_reload_key=" + kaintana_hot_reload_key(session_id) + "\n"
    output = output + "entangle_registered=" + str(native_entangle_registered_count()) + "\n"
    output = output + "entangle_propagations=" + str(native_entangle_propagation_count()) + "\n"
    return output

pub fn kaintana_write_frame_report(session_id: Int, spec: KaintanaWindowSpec, theme: KaintanaTheme, headline: String) -> String:
    write_file(spec.frame_report_path, kaintana_frame_report_text(session_id, spec, theme, headline))
    return spec.frame_report_path

pub fn kaintana_snapshot_text(session_id: Int, action_session_id: Int, spec: KaintanaWindowSpec, theme: KaintanaTheme, headline: String) -> String:
    var output = kaintana_frame_report_text(session_id, spec, theme, headline)
    output = output + "focused_node=" + str(kaintana_focused_node(session_id)) + "\n"
    output = output + "clipboard_text=" + kaintana_clipboard_text(session_id) + "\n"
    output = output + "ime_active_node=" + str(kaintana_ime_active_node(session_id)) + "\n"
    output = output + "ime_text=" + kaintana_ime_text(session_id) + "\n"
    let active_menu = kaintana_active_menu(session_id)
    output = output + "menu_active=" + str(active_menu) + "\n"
    if active_menu > 0:
        let menu_count = kaintana_menu_item_count(session_id, active_menu)
        output = output + "menu_item_count=" + str(menu_count) + "\n"
        if menu_count > 0:
            output = output + "menu_item_0_label=" + kaintana_menu_item_label(session_id, active_menu, 0) + "\n"
            output = output + "menu_item_0_command=" + str(kaintana_menu_item_command(session_id, active_menu, 0)) + "\n"
    let active_dialog = kaintana_active_dialog(session_id)
    output = output + "dialog_active=" + str(active_dialog) + "\n"
    if active_dialog > 0:
        output = output + "dialog_kind=" + kaintana_dialog_kind(session_id) + "\n"
        output = output + "dialog_title=" + kaintana_dialog_title(session_id) + "\n"
        output = output + "dialog_message=" + kaintana_dialog_message(session_id) + "\n"
        output = output + "dialog_response_text=" + kaintana_dialog_response_text(session_id) + "\n"
    if action_session_id > 0:
        output = output + "action_frame_index=" + str(kaintana_action_frame_index(action_session_id)) + "\n"
        output = output + "action_event_count=" + str(kaintana_action_event_count(action_session_id)) + "\n"
        output = output + "action_text_commit_count=" + str(kaintana_action_text_commit_count(action_session_id)) + "\n"
        if kaintana_action_text_commit_count(action_session_id) > 0:
            output = output + "action_text_commit_0=" + kaintana_action_text_commit(action_session_id, 0) + "\n"
        output = output + "action_trace=" + kaintana_action_trace_text(action_session_id) + "\n"
    return output

pub fn kaintana_write_harness_artifacts(session_id: Int, action_session_id: Int, spec: KaintanaWindowSpec, theme: KaintanaTheme, headline: String, harness: KaintanaHarnessSpec) -> String:
    write_file(harness.snapshot_path, kaintana_snapshot_text(session_id, action_session_id, spec, theme, headline))
    if len(harness.input_trace_path) > 0 and action_session_id > 0:
        let _trace = kaintana_action_write_trace(action_session_id, harness.input_trace_path)
    return harness.snapshot_path

