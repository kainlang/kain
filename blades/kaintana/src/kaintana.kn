pub fn kaintana_theme_named(theme_name: String) -> KaintanaTheme:
    if theme_name == "marine-terminal":
        return kaintana_theme_marine_terminal()
    if theme_name == "kawaii-voltage":
        return kaintana_theme_kawaii_voltage()
    return kaintana_theme_solar_broadcast()

pub fn kaintana_session_create(app_name: String, spec: KaintanaWindowSpec) -> Int:
    return ui_host_session_create(app_name, spec.title, spec.width, spec.height, spec.passive_backend_id)

pub fn kaintana_begin_frame(session_id: Int, revision_key: String, delta_ms: Float) -> Int:
    if len(revision_key) > 0:
        let _reload = native_ui_hot_reload_begin(session_id, revision_key)
    return ui_frame_begin(session_id, delta_ms)

pub fn kaintana_commit_frame(session_id: Int) -> Int:
    let _reload = native_ui_hot_reload_commit(session_id)
    return ui_frame_submit(session_id)

pub fn kaintana_hot_reload_generation(session_id: Int) -> Int:
    return native_ui_hot_reload_generation(session_id)

pub fn kaintana_hot_reload_key(session_id: Int) -> String:
    return native_ui_hot_reload_key(session_id)

pub fn kaintana_action_reset() -> Int:
    return input_reset()

pub fn kaintana_action_session_create(app_name: String) -> Int:
    return input_session_create(app_name)

pub fn kaintana_action_session_destroy(action_session_id: Int) -> Int:
    return input_session_destroy(action_session_id)

pub fn kaintana_action_bind(action_session_id: Int, binding: KaintanaActionBinding) -> Int:
    return input_bind_action(action_session_id, binding.source_kind, binding.event_kind, binding.code, binding.action)

pub fn kaintana_axis_bind(action_session_id: Int, binding: KaintanaAxisBinding) -> Int:
