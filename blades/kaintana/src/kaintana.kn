use vulkain::vulkain_frames_presented
use vulkain::vulkain_probe
use vulkain::vulkain_run_window
use vulkain::vulkain_vertices_drawn
use vulkain::vulkain_write_report

pub struct KaintanaRect:
    x: Float
    y: Float
    width: Float
    height: Float

pub struct KaintanaTheme:
    name: String
    shell_red: Int
    shell_green: Int
    shell_blue: Int
    panel_red: Int
    panel_green: Int
    panel_blue: Int
    accent_red: Int
    accent_green: Int
    accent_blue: Int
    ink_red: Int
    ink_green: Int
    ink_blue: Int
    muted_red: Int
    muted_green: Int
    muted_blue: Int
    signal_red: Int
    signal_green: Int
    signal_blue: Int

pub struct KaintanaWindowSpec:
    title: String
    width: Int
    height: Int
    frame_budget: Int
    backend_id: String
    passive_backend_id: String
    clear_red: Int
    clear_green: Int
    clear_blue: Int
    accent_red: Int
    accent_green: Int
    accent_blue: Int
    vertex_shader_path: String
    fragment_shader_path: String
    frame_report_path: String
    host_report_path: String
    screenshot_path: String

fn kaintana_channel_float(value: Int) -> Float:
    var clamped = value
    if clamped < 0:
        clamped = 0
    if clamped > 255:
        clamped = 255
    return Float(clamped) / 255.0

fn kaintana_apply_fill_color(session_id: Int, node_id: Int, red: Int, green: Int, blue: Int) -> Int:
    return ui_style_color_rgba(session_id, node_id, "fill", kaintana_channel_float(red), kaintana_channel_float(green), kaintana_channel_float(blue), 1.0)

fn kaintana_apply_ink_color(session_id: Int, node_id: Int, red: Int, green: Int, blue: Int) -> Int:
    return ui_style_color_rgba(session_id, node_id, "ink", kaintana_channel_float(red), kaintana_channel_float(green), kaintana_channel_float(blue), 1.0)

fn kaintana_desktop_fill(rect: KaintanaRect, red: Int, green: Int, blue: Int, alpha: Int) -> Int:
    return kaintana_native_desktop_push_rect(Int(rect.x), Int(rect.y), Int(rect.width), Int(rect.height), red, green, blue, alpha)

fn kaintana_desktop_text(text: String, x: Float, y: Float, red: Int, green: Int, blue: Int, alpha: Int) -> Int:
    return kaintana_native_desktop_push_text(text, Int(x), Int(y), red, green, blue, alpha)

fn kaintana_panel_node(session_id: Int, parent_id: Int, kind: String, stable_key: String, label: String, rect: KaintanaRect) -> Int:
    return ui_reconcile_labeled_node(session_id, parent_id, kind, stable_key, "", "region", label, rect.x, rect.y, rect.width, rect.height)

fn kaintana_text_node(session_id: Int, parent_id: Int, kind: String, stable_key: String, text: String, label: String, rect: KaintanaRect) -> Int:
    return ui_reconcile_labeled_node(session_id, parent_id, kind, stable_key, text, "label", label, rect.x, rect.y, rect.width, rect.height)

fn kaintana_focusable_node(session_id: Int, parent_id: Int, kind: String, stable_key: String, text: String, label: String, rect: KaintanaRect) -> Int:
    return ui_reconcile_focusable_node(session_id, parent_id, kind, stable_key, text, "button", label, rect.x, rect.y, rect.width, rect.height)

pub fn kaintana_backend_desktop() -> String:
    return "desktop"

pub fn kaintana_backend_vulkan() -> String:
    return "vulkan"

pub fn kaintana_rect(x: Float, y: Float, width: Float, height: Float) -> KaintanaRect:
    return KaintanaRect { x: x, y: y, width: width, height: height }

pub fn kaintana_inset(rect: KaintanaRect, left: Float, top: Float, right: Float, bottom: Float) -> KaintanaRect:
    return KaintanaRect {
        x: ui_layout_inset_x(rect.x, left),
        y: ui_layout_inset_y(rect.y, top),
        width: ui_layout_inset_width(rect.width, left, right),
        height: ui_layout_inset_height(rect.height, top, bottom),
    }

pub fn kaintana_split_left(rect: KaintanaRect, fraction: Float, gap: Float) -> KaintanaRect:
    return KaintanaRect {
        x: rect.x,
        y: rect.y,
        width: ui_layout_split_left_width(rect.width, fraction, gap),
        height: rect.height,
    }

pub fn kaintana_split_right(rect: KaintanaRect, fraction: Float, gap: Float) -> KaintanaRect:
    return KaintanaRect {
        x: ui_layout_split_right_x(rect.x, rect.width, fraction, gap),
        y: rect.y,
        width: ui_layout_split_right_width(rect.width, fraction, gap),
        height: rect.height,
    }

pub fn kaintana_column_slot(rect: KaintanaRect, index_offset: Float, item_height: Float, gap: Float) -> KaintanaRect:
    return KaintanaRect {
        x: rect.x,
        y: ui_layout_column_y(index_offset, rect.y, item_height, gap),
        width: rect.width,
        height: item_height,
    }

pub fn kaintana_row_slot(rect: KaintanaRect, index_offset: Float, item_width: Float, gap: Float) -> KaintanaRect:
    return KaintanaRect {
        x: ui_layout_row_x(index_offset, rect.x, item_width, gap),
        y: rect.y,
        width: item_width,
        height: rect.height,
    }

pub fn kaintana_window_rect(spec: KaintanaWindowSpec) -> KaintanaRect:
    return KaintanaRect { x: 0.0, y: 0.0, width: Float(spec.width), height: Float(spec.height) }

pub fn kaintana_window_spec(title: String, width: Int, height: Int, frame_budget: Int, backend_id: String, passive_backend_id: String, clear_red: Int, clear_green: Int, clear_blue: Int, accent_red: Int, accent_green: Int, accent_blue: Int, vertex_shader_path: String, fragment_shader_path: String, frame_report_path: String, host_report_path: String, screenshot_path: String) -> KaintanaWindowSpec:
    return KaintanaWindowSpec {
        title: title,
        width: width,
        height: height,
        frame_budget: frame_budget,
        backend_id: backend_id,
        passive_backend_id: passive_backend_id,
        clear_red: clear_red,
        clear_green: clear_green,
        clear_blue: clear_blue,
        accent_red: accent_red,
        accent_green: accent_green,
        accent_blue: accent_blue,
        vertex_shader_path: vertex_shader_path,
        fragment_shader_path: fragment_shader_path,
        frame_report_path: frame_report_path,
        host_report_path: host_report_path,
        screenshot_path: screenshot_path,
    }

pub fn kaintana_default_window_spec(title: String, width: Int, height: Int, backend_id: String) -> KaintanaWindowSpec:
    return kaintana_window_spec(
        title,
        width,
        height,
        180,
        backend_id,
        "software",
        8,
        14,
        26,
        255,
        112,
        68,
        "../vulkain/.kain/gpu/basic_window/vulkain_basic.vert.spv",
        "../vulkain/.kain/gpu/basic_window/vulkain_basic.frag.spv",
        ".kain/run/kaintana_frame_report.txt",
        ".kain/run/kaintana_host_report.txt",
        ".kain/run/kaintana_host.bmp"
    )

