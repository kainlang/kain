fn kaintana_is_digit_char(ch: String) -> Bool:
    return ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"

fn kaintana_digit_value(ch: String) -> Int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    return 9

fn kaintana_parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    let sign = 1
    let index = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    let value = 0
    while index < len(text):
        if !kaintana_is_digit_char(char_at(text, index)):
            return value * sign
        value = value * 10 + kaintana_digit_value(char_at(text, index))
        index = index + 1
    return value * sign

fn kaintana_examples_frame_budget_or_default(default_value: Int) -> Int:
    let override_text = env("KAINTANA_EXAMPLES_FRAME_BUDGET")
    if len(override_text) == 0:
        return default_value
    let override_value = kaintana_parse_int_text(override_text)
    if override_value <= 0:
        return default_value
    return override_value

fn kaintana_examples_window_spec() -> KaintanaWindowSpec:
    return kaintana_window_spec(
        "Kaintana // Examples Tour",
        1280,
        1120,
        kaintana_examples_frame_budget_or_default(6000),
        kaintana_backend_desktop(),
        "software",
        8,
        14,
        26,
        255,
        112,
        68,
        "",
        "",
        ".kain/run/kaintana_frame_report.txt",
        ".kain/run/kaintana_host_report.txt",
        ".kain/run/kaintana_host.bmp"
    )

fn kaintana_widget_interaction_probe() -> Int:
    let spec = kaintana_window_spec(
        "Kaintana // Widget Probe",
        640,
        360,
        2,
        kaintana_backend_headless(),
        "headless",
        6,
        10,
        18,
        255,
        112,
        68,
        "",
        "",
        ".kain/run/kaintana_widget_probe_frame.txt",
        ".kain/run/kaintana_widget_probe_host.txt",
        ".kain/run/kaintana_widget_probe.bmp"
    )
    let theme = kaintana_theme_named("oxide-dcc")
    var ctx = kaintana_context("kaintana-widget-probe", spec, theme, false)
    let font = native_ui_font_create(ctx.session_id, "font.kaintana.probe", "Consolas", 14.0)
    let button_rect = kaintana_rect(24.0, 28.0, 200.0, 48.0)
    let slider_rect = kaintana_rect(24.0, 96.0, 320.0, 62.0)

    ctx = kaintana_begin(ctx, "kaintana-widget-probe.f0", 16.0)
    var button_builder = kaintana_button(ui(ctx), "Probe Button")
    button_builder = kaintana_button_key(button_builder, "probe.button")
    button_builder = kaintana_button_rect(button_builder, button_rect)
    button_builder = kaintana_button_font(button_builder, font, 18.0)
    let button_frame0 = kaintana_button_render(ctx, button_builder)
    ctx = button_frame0.ctx

    var slider_builder = kaintana_slider(ui(ctx), "Probe Slider", 10.0, 0.0, 100.0)
    slider_builder = kaintana_slider_key(slider_builder, "probe.slider")
    slider_builder = kaintana_slider_rect(slider_builder, slider_rect)
    slider_builder = kaintana_slider_font(slider_builder, font, 18.0)
    let slider_frame0 = kaintana_slider_render(ctx, slider_builder)
    ctx = kaintana_commit(slider_frame0.ctx)

    let button_center_x = button_rect.x + (button_rect.width * 0.5)
    let button_center_y = button_rect.y + (button_rect.height * 0.5)
    let slider_track_x = slider_rect.x + 16.0
    let slider_track_width = math_max(8.0, slider_rect.width - 32.0)
    let slider_pointer_y = slider_rect.y + slider_rect.height - 15.0
    let slider_start_x = slider_track_x + (slider_track_width * 0.25)
    let slider_end_x = slider_track_x + (slider_track_width * 0.75)
    let _button_down = ui_push_event(ctx.session_id, "pointer.down", button_frame0.native_node_id, button_center_x, button_center_y, 0, "primary")
    let _button_up = ui_push_event(ctx.session_id, "pointer.up", button_frame0.native_node_id, button_center_x, button_center_y, 0, "primary")
    let _slider_down = ui_push_event(ctx.session_id, "pointer.down", slider_frame0.native_node_id, slider_start_x, slider_pointer_y, 0, "primary")
    let _slider_move = ui_push_event(ctx.session_id, "pointer.move", slider_frame0.native_node_id, slider_end_x, slider_pointer_y, 0, "primary")
    let _slider_up = ui_push_event(ctx.session_id, "pointer.up", slider_frame0.native_node_id, slider_end_x, slider_pointer_y, 0, "primary")

    ctx = kaintana_begin(ctx, "kaintana-widget-probe.f1", 16.0)
    button_builder = kaintana_button(ui(ctx), "Probe Button")
    button_builder = kaintana_button_key(button_builder, "probe.button")
    button_builder = kaintana_button_rect(button_builder, button_rect)
    button_builder = kaintana_button_font(button_builder, font, 18.0)
    let button_frame1 = kaintana_button_render(ctx, button_builder)
    ctx = button_frame1.ctx

    slider_builder = kaintana_slider(ui(ctx), "Probe Slider", 10.0, 0.0, 100.0)
    slider_builder = kaintana_slider_key(slider_builder, "probe.slider")
    slider_builder = kaintana_slider_rect(slider_builder, slider_rect)
    slider_builder = kaintana_slider_font(slider_builder, font, 18.0)
    let slider_frame1 = kaintana_slider_render(ctx, slider_builder)
    let activated = button_frame1.activated
    let slider_value = slider_frame1.value
    ctx = kaintana_commit(slider_frame1.ctx)
    let _destroy = kaintana_context_destroy(ctx)
    if activated != 1:
        return 0
    if slider_value < 70.0 or slider_value > 80.0:
        return 0
    return 1

fn main() -> Int:
    let boot = native_runtime_init()
    if boot != 0:
        return 100 + boot

    if kaintana_widget_interaction_probe() != 1:
        return 21

    if kaintana_desktop_probe() != 1:
        return 20

    let spec = kaintana_examples_window_spec()
    let theme = kaintana_theme_named("oxide-dcc")
    var ctx = kaintana_context("kaintana-examples-tour", spec, theme, true)
    let body_font = native_ui_font_create(ctx.session_id, "font.kaintana.body", "Consolas", 16.0)
    let title_font = native_ui_font_create(ctx.session_id, "font.kaintana.title", "Segoe UI", 28.0)
    ctx = kaintana_begin(ctx, "kaintana-examples-tour", 16.0)

    let bounds = kaintana_inset(kaintana_window_rect(spec), 24.0, 24.0, 24.0, 24.0)
    let hero = kaintana_rect(bounds.x, bounds.y, bounds.width, 56.0)
    let gallery = kaintana_rect(bounds.x, bounds.y + 74.0, bounds.width, bounds.height - 74.0)

    let panel0 = kaintana_panel(ui(ctx), "KAINTANA EXAMPLES TOUR")
    let panel1 = kaintana_panel_key(panel0, "examples.hero.panel")
    let panel2 = kaintana_panel_rect(panel1, hero)
    let panel3 = kaintana_panel_font(panel2, title_font, 36.0)
    let panel = kaintana_panel_render(ctx, panel3)
    ctx = panel.ctx

    let label0 = kaintana_label(ui(ctx), "todo, tabs, modal, data grid, keypad, resizable panels, file explorer, mega buttons")
    let label1 = kaintana_label_key(label0, "examples.hero.summary")
    let label2 = kaintana_label_rect(label1, kaintana_rect(hero.x + 560.0, hero.y + 18.0, hero.width - 580.0, 28.0))
    let label3 = kaintana_label_font(label2, body_font, 22.0)
    let label4 = kaintana_label_muted(label3)
    let label = kaintana_label_render(ctx, label4)
    ctx = label.ctx
    ctx = kaintana_examples_render_tour(ctx, gallery, body_font, title_font)

    ctx = kaintana_commit(ctx)
    let winit0 = kaintana_winit_adapter_from_context(ctx)
    let winit1 = kaintana_winit_adapter_pump(winit0)
    let winit2 = kaintana_winit_adapter_present(winit1)
    let winit_score = kaintana_winit_adapter_score(winit2)
    let vulkan_score = kaintana_vulkan_adapter_probe("kaintana-examples-vulkan", spec)
    let draw_count = ctx.draw_count
    let checksum = ctx.command_checksum
    let status = ctx.status
    fs_create_dir_all(".kain/run")
    let host_status = kaintana_desktop_host_run_window(spec)
    let _report = kaintana_desktop_host_write_report_path(".kain/run/kaintana_host_report.txt")
    let _bmp = kaintana_desktop_host_write_screenshot_path(".kain/run/kaintana_host.bmp")
    let _destroy = kaintana_context_destroy(ctx)
    let shutdown = native_runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    if status != 0:
        return 30
    if draw_count < 120:
        return 31
    if checksum <= 0:
        return 32
    if kaintana_desktop_host_geometry_count(spec) < draw_count:
        return 33
    if winit_score <= 0:
        return 34
    if vulkan_score <= 0:
        return 35
    if host_status != 0:
        return 36
    return 0
