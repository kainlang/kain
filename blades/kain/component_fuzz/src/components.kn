// ============================================================================
//  COMPONENT FUZZ — A Plethora of Components Pushed to Breaking Point
// ============================================================================
//
//  This file is a deliberate stress test of Kain's `component` keyword.
//  Every component here does something components were "never meant to do."
//
//  CATEGORIES:
//    §1 — Naked components (no props, no state, just JSX chaos)
//    §2 — Stateful components (state machines, accumulators, counters)
//    §3 — Computational components (math, data transforms AS components)
//    §4 — Recursive + self-referential components
//    §5 — Fragment factories (components that emit fragments of components)
//    §6 — Pointer-laden components (raw memory in UI — WHY NOT)
//    §7 — Actor-aware components (spawning actors from inside component methods)
//    §8 — Deeply nested composition (10+ levels)
//    §9 — World-surface abuse (one world, 5 surfaces, all different components)
//    §10 — The Component Singularity (component that contains everything)
//
//  Authoring principle: if the compiler accepts it, we win.
//  If the compiler rejects it, we learned something about the boundary.
// ============================================================================

use std::alloc
use std::actor
use std::runtime
use std::intent

const FUZZ_MODULUS: Int = 1000000007
const FUZZ_HOT_SLOTS: Int = 32
const FUZZ_NEST_DEPTH: Int = 10

// ═══════════════════════════════════════════════════════════════════════════════
//  §1 — NAKED COMPONENTS (no props, no state, pure JSX expression)
// ═══════════════════════════════════════════════════════════════════════════════

// Minimal — can a component be literally one element?
component Atom():
    render <text value="." />

// Empty — what does a component with an empty panel look like?
component Void():
    render <panel title="" />

// Fragment root — multiple top-level nodes via Fragment
component Fragments():
    render <Fragment>
        <text value="A" />
        <text value="B" />
        <text value="C" />
        <text value="D" />
        <text value="E" />
    </Fragment>

// Pure expression — no elements, just {expr} interpolation. Is this legal?
component ExprOnly(value: Int):
    render <text value={value} />

// String soup — component that renders a massive text block
component LongText():
    render <text value="Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua Ut enim ad minim veniam quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur Excepteur sint occaecat cupidatat non proident sunt in culpa qui officia deserunt mollit anim id est laborum" />

// ═══════════════════════════════════════════════════════════════════════════════
//  §2 — STATEFUL COMPONENTS (state machines, accumulators, life)
// ═══════════════════════════════════════════════════════════════════════════════

// Binary state toggle — a component that flips between two render states
component Toggle():
    state on: Bool = false

    fn flip(_self: Self_):
        _self.on = _self.on == false

    fn label(_self: Self_) -> String:
        if _self.on:
            return "ON"
        return "OFF"

    render <box>
        <text value={label()} />
    </box>

// Counter with bounds — state that accumulates and clamps
component BoundedCounter(limit: Int):
    state count: Int = 0

    fn bump(_self: Self_) -> Int:
        if _self.count < _self.limit:
            _self.count = _self.count + 1
        return _self.count

    render <stack direction="horizontal">
        <text value={_self.count} />
        <text value="/" />
        <text value={_self.limit} />
    </stack>

// State machine component — three states with different render shapes
component TrafficLight():
    state phase: Int = 0   // 0=red, 1=yellow, 2=green

    fn advance(_self: Self_):
        _self.phase = (_self.phase + 1) % 3

    fn color(_self: Self_) -> String:
        if _self.phase == 0:
            return "RED"
        elif _self.phase == 1:
            return "YELLOW"
        return "GREEN"

    render <box>
        <text value={color()} />
        <text value={"phase " + str(_self.phase)} />
    </box>

// Multi-state with complex initializer — state derived from props
component Thermometer(temp: Int, unit: String):
    state is_celsius: Bool = unit == "C"
    state display_temp: Int = temp
    state warning: Bool = temp > 100

    fn convert(_self: Self_):
        if _self.is_celsius:
            _self.display_temp = (_self.display_temp * 9 / 5) + 32
        else:
            _self.display_temp = (_self.display_temp - 32) * 5 / 9
        _self.is_celsius = _self.is_celsius == false

    fn status(_self: Self_) -> String:
        if _self.warning:
            return "HOT"
        return "normal"

    render <stack direction="vertical">
        <text value={_self.display_temp} />
        <text value={status()} />
    </stack>

// Weak state — borrowed reference from outside. Does component accept weak state?
component ShadowDisplay():
    weak state mirror_value: Int = 0

    render <text value={_self.mirror_value} />

// ═══════════════════════════════════════════════════════════════════════════════
//  §3 — COMPUTATIONAL COMPONENTS (math + data transforms AS components)
// ═══════════════════════════════════════════════════════════════════════════════

// A component that computes factorial — why should UI be the only thing?
component Factorial(n: Int):
    state result: Int = 1
    state computed: Bool = false

    fn compute(_self: Self_):
        if _self.computed:
            return
        var i: Int = 1
        var acc: Int = 1
        while i <= _self.n:
            acc = acc * i
            i = i + 1
        _self.result = acc
        _self.computed = true

    render <box>
        <text value={str(_self.n) + "! = " + str(_self.result)} />
    </box>

// Prime sieve component — stores prime list in state, renders count
component PrimeSieve(limit: Int):
    state primes: Int = 0
    state last_prime: Int = 0

    fn sieve(_self: Self_):
        var n: Int = 2
        var found: Int = 0
        while n <= _self.limit and found < 10:
            var is_prime: Bool = true
            var d: Int = 2
            while d * d <= n:
                if n % d == 0:
                    is_prime = false
                    break
                d = d + 1
            if is_prime:
                _self.primes = _self.primes + 1
                _self.last_prime = n
                found = found + 1
            n = n + 1

    render <stack direction="vertical">
        <text value={"primes ≤ " + str(_self.limit) + ": " + str(_self.primes)} />
        <text value={"last: " + str(_self.last_prime)} />
    </stack>

// Fibonacci as a component — stores sequence in state as a [Int]
component FibonacciSeq(count: Int):
    state values: [Int] = []
    state generated: Bool = false

    fn generate(_self: Self_):
        if _self.generated:
            return
        var i: Int = 0
        var a: Int = 0
        var b: Int = 1
        while i < _self.count:
            push(_self.values, a)
            let next = a + b
            a = b
            b = next
            i = i + 1
        _self.generated = true

    fn format_sequence(_self: Self_) -> String:
        var text = ""
        var i: Int = 0
        while i < len(_self.values):
            if i > 0:
                text = text + ", "
            text = text + str(_self.values[i])
            i = i + 1
        return text

    render <box>
        <text value={format_sequence()} />
    </box>

// Data transformer — takes an array, transforms it, renders the result
component DataPipe(input: [Int], multiplier: Int):
    state transformed: [Int] = []
    state checksum: Int = 0

    fn transform(_self: Self_):
        var i: Int = 0
        var acc: Int = 0
        while i < len(_self.input):
            let val = _self.input[i] * _self.multiplier
            push(_self.transformed, val)
            acc = (acc + val) % FUZZ_MODULUS
            i = i + 1
        _self.checksum = acc

    fn count(_self: Self_) -> Int:
        return len(_self.transformed)

    render <stack direction="vertical">
        <text value={"piped " + str(count()) + " items"} />
        <text value={"checksum: " + str(_self.checksum)} />
    </stack>

// ═══════════════════════════════════════════════════════════════════════════════
//  §4 — RECURSIVE + SELF-REFERENTIAL COMPONENTS
// ═══════════════════════════════════════════════════════════════════════════════

// A component that renders itself — tree recursion
// Each level nests deeper. Base case: depth 0 renders a leaf.
component RecursiveTree(depth: Int, label: String):
    state expanded: Bool = false

    fn children(_self: Self_) -> [String]:
        var kids: [String] = []
        push(kids, _self.label + ".L")
        push(kids, _self.label + ".R")
        return kids

    render <stack direction="vertical">
        <text value={_self.label + " (depth " + str(_self.depth) + ")"} />
        if _self.depth > 0:
            <RecursiveTree depth={_self.depth - 1} label={_self.label + ".L"} />
            <RecursiveTree depth={_self.depth - 1} label={_self.label + ".R"} />
        else:
            <text value="LEAF" />
    </stack>

// List renderer — takes [String] and renders each as a component
component StringList(items: [String]):
    render <stack direction="vertical">
        for item in items:
            <text value={"  • " + item} />
        if len(items) == 0:
            <text value="(empty)" />
    </stack>

// ═══════════════════════════════════════════════════════════════════════════════
//  §5 — FRAGMENT FACTORIES (components that emit fragments of other components)
// ═══════════════════════════════════════════════════════════════════════════════

// A component whose render is entirely composed of OTHER components — no native elements
component PureComposition():
    render <Fragment>
        <Atom />
        <Void />
        <ExprOnly value={42} />
        <Toggle />
        <BoundedCounter limit={5} />
    </Fragment>

// Card layout factory — generates a card with title + body components
component Card(title: String, body: String):
    render <box>
        <text value={title} />
        <text value={body} />
    </box>

// Grid of cards — for-loop over card components
component CardGrid(cards: [String], cols: Int):
    render <stack direction="vertical">
        for card_label in cards:
            <Card title={card_label} body={"body of " + card_label} />
    </stack>

// Nested layout — stack of stacks of boxes of text
component LayoutInception(depth: Int):
    render <stack direction="vertical">
        <text value={"level " + str(depth)} />
        if depth > 0:
            <LayoutInception depth={depth - 1} />
        else:
            <Atom />
    </stack>

// ═══════════════════════════════════════════════════════════════════════════════
//  §6 — POINTER-LADEN COMPONENTS (raw memory in UI — chaos)
// ═══════════════════════════════════════════════════════════════════════════════

// A component that owns raw memory — ptr<Int> as state
// Renders the checksum of the buffer. THIS IS WRONG AND WE'RE DOING IT.
component MemoryWidget(cell_count: Int) with Unsafe:
    state buffer: ptr<Int> = int_to_ptr(0, "Int")
    state initialized: Bool = false
    state checksum: Int = 0

    fn alloc_buffer(_self: Self_) -> Int:
        if _self.initialized:
            return _self.checksum
        _self.buffer = alloc_zeroed(_self.cell_count, "Int")
        collapse _self.buffer:
            var i: Int = 0
            while i < _self.cell_count:
                mem_store(ptr_offset(_self.buffer, i, "Int"), (i * 31 + 7) % FUZZ_MODULUS, "Int")
                i = i + 1
            0
        let obs = observe _self.buffer:
            var acc: Int = 0
            var j: Int = 0
            while j < _self.cell_count:
                acc = (acc + mem_load(ptr_offset(_self.buffer, j, "Int"), "Int")) % FUZZ_MODULUS
                j = j + 1
            acc
        _self.checksum = obs
        _self.initialized = true
        return obs

    fn teardown(_self: Self_):
        if _self.initialized:
            decay _self.buffer
            _self.initialized = false

    render <box>
        <text value={"mem[" + str(_self.cell_count) + "] checksum: " + str(_self.checksum)} />
    </box>

// Hot slot indicator — renders FUZZ_HOT_SLOTS indicators based on a ratio
component HotSlots(ratio: Int, max_ratio: Int):
    render <stack direction="horizontal">
        for i in [0]:
            <text value={"hot: " + str(ratio) + "/" + str(max_ratio)} />
    </stack>

// ═══════════════════════════════════════════════════════════════════════════════
//  §7 — ACTOR-AWARE COMPONENTS (spawning actors from components)
// ═══════════════════════════════════════════════════════════════════════════════

// A miniature actor just for the component to talk to
actor ComponentActor:
    state echo_count: Int = 0

    on Echo(reply_to: P, message: Int):
        self.echo_count = self.echo_count + 1
        send reply_to.Reply(value = message + self.echo_count)

// A component that spawns and communicates with an actor
component ActorWidget(signal: Int):
    state worker: Int = 0       // actor handle stored as Int... does this work?
    state last_reply: Int = 0
    state spawned: Bool = false

    fn ensure_spawned(_self: Self_):
        if _self.spawned == false:
            // _self.worker = spawn ComponentActor(echo_count = 0)
            _self.spawned = true

    fn ping(_self: Self_) -> Int:
        // let reply = ask(_self.worker, "Echo", _self.signal)
        // _self.last_reply = reply
        return _self.last_reply

    render <box>
        <text value={"actor echo: " + str(_self.last_reply)} />
    </box>

// ═══════════════════════════════════════════════════════════════════════════════
//  §8 — DEEPLY NESTED COMPOSITION (10+ levels)
// ═══════════════════════════════════════════════════════════════════════════════

component Nest_L0():
    render <box><text value="L0" /></box>

component Nest_L1():
    render <box><Nest_L0 /><text value="L1" /></box>

component Nest_L2():
    render <box><Nest_L1 /><text value="L2" /></box>

component Nest_L3():
    render <stack direction="vertical"><Nest_L2 /><text value="L3" /></stack>

component Nest_L4():
    render <stack direction="vertical"><Nest_L3 /><text value="L4" /></stack>

component Nest_L5():
    render <panel title="L5"><Nest_L4 /><text value="L5" /></panel>

component Nest_L6():
    render <panel title="L6"><Nest_L5 /><Toggle /></panel>

component Nest_L7():
    render <panel title="L7"><Nest_L6 /><BoundedCounter limit={7} /></panel>

component Nest_L8():
    render <panel title="L8"><Nest_L7 /><TrafficLight /></panel>

component Nest_L9():
    render <panel title="L9"><Nest_L8 /><Fragments /></panel>

component Nest_L10():
    render <panel title="L10 — DEEPEST NEST">
        <Nest_L9 />
        <Atom />
        <Void />
        <text value="bottom of the rabbit hole" />
    </panel>

// ═══════════════════════════════════════════════════════════════════════════════
//  §9 — WORLD-SURFACE ABUSE
// ═══════════════════════════════════════════════════════════════════════════════

// One component that serves as the surface for multiple worlds
component FuzzPanel():
    render <panel title="Component Fuzz Dashboard" />

world FuzzAuthority:
    state signal: Int = 42
    state epoch: Int = 0
    state fuzz_score: Int = 0
    surface native_ui => FuzzPanel

world FuzzMirror:
    state signal_copy: Int = 42
    state epoch_copy: Int = 0
    state fuzz_score_copy: Int = 0
    surface web => FuzzPanel

world FuzzRogue:
    state rogue_val: Int = 999
    state drift: Int = 0
    surface web => FuzzPanel

// Entangle the authority and mirror for good measure
entangle FuzzAuthority.signal <-> FuzzMirror.signal_copy with single_writer
entangle FuzzAuthority.epoch <-> FuzzMirror.epoch_copy with single_writer
entangle FuzzAuthority.fuzz_score <-> FuzzMirror.fuzz_score_copy with single_writer

// Law on the fuzz score
law fuzz_score_valid(v: Int) -> Bool:
    return v >= 0 and v < FUZZ_MODULUS

// Patch to journal fuzz mutations
patch fuzz_commit(authority: FuzzAuthority, value: Int) -> Int:
    authority.fuzz_score = value
    authority.epoch = authority.epoch + 1
    return authority.fuzz_score

// Pulse that drives fuzz state
pulse fuzz_beat every 100ms jitter 10ms:
    FuzzAuthority.signal = (FuzzAuthority.signal + pulse_tick * 7) % FUZZ_MODULUS
    FuzzAuthority.fuzz_score = (FuzzAuthority.fuzz_score + pulse_tick) % FUZZ_MODULUS

// ═══════════════════════════════════════════════════════════════════════════════
//  §10 — THE COMPONENT SINGULARITY
// ═══════════════════════════════════════════════════════════════════════════════

// Everysinglething. Every category smashed into one component.
// Props, state, methods, JSX composition, for loops, if/else, Fragment,
// nested components, computation, raw pointers, everything.
component Singularity(name: String, phase: Int, data: [Int]):
    state counter: Int = 0
    state hot: Bool = false
    state buffer: ptr<Int> = int_to_ptr(0, "Int")
    state buffer_checksum: Int = 0
    state memo: [String] = []
    state ready: Bool = false

    fn initialize(_self: Self_):
        if _self.ready:
            return
        // Allocate and compute a small buffer
        let cell_count = 4
        _self.buffer = alloc_zeroed(cell_count, "Int")
        collapse _self.buffer:
            var i: Int = 0
            while i < cell_count:
                mem_store(ptr_offset(_self.buffer, i, "Int"), (_self.phase + i * 13) % FUZZ_MODULUS, "Int")
                i = i + 1
            0
        let obs = observe _self.buffer:
            var acc: Int = 0
            var j: Int = 0
            while j < cell_count:
                acc = (acc + mem_load(ptr_offset(_self.buffer, j, "Int"), "Int")) % FUZZ_MODULUS
                j = j + 1
            acc
        _self.buffer_checksum = obs
        decay _self.buffer
        push(_self.memo, "init done")
        push(_self.memo, "checksum=" + str(_self.buffer_checksum))
        _self.ready = true

    fn tick(_self: Self_):
        _self.counter = _self.counter + 1
        if _self.counter % 7 == 0:
            _self.hot = _self.hot == false

    fn status_text(_self: Self_) -> String:
        if _self.hot:
            return "SINGULARITY ACTIVE"
        return "singularity dormant"

    fn data_summary(_self: Self_) -> String:
        var acc: Int = 0
        var i: Int = 0
        while i < len(_self.data):
            acc = acc + _self.data[i]
            i = i + 1
        return "sum=" + str(acc) + " n=" + str(len(_self.data))

    fn memo_text(_self: Self_) -> String:
        var text = ""
        var i: Int = 0
        while i < len(_self.memo):
            if i > 0:
                text = text + " | "
            text = text + _self.memo[i]
            i = i + 1
        return text

    render <panel title={_self.name}>
        <stack direction="vertical">
            {/* Header section */}
            <box>
                <text value={status_text()} />
                <text value={"counter=" + str(_self.counter)} />
                <text value={"phase=" + str(_self.phase)} />
            </box>

            {/* Data section — nested component composition */}
            <DataPipe input={_self.data} multiplier={3} />

            {/* Memo log */}
            <box>
                <text value={"memo: " + memo_text()} />
            </box>

            {/* Conditional rendering based on hot state */}
            if _self.hot:
                <Fragment>
                    <Thermometer temp={_self.counter} unit="C" />
                    <TrafficLight />
                    <BoundedCounter limit={_self.phase + 1} />
                </Fragment>
            else:
                <box>
                    <text value="cooling..." />
                </box>

            {/* Recursive nesting with depth = phase % 3 */}
            <RecursiveTree depth={_self.phase % 3} label={_self.name} />

            {/* For loop over data */}
            <stack direction="horizontal">
                for val in _self.data:
                    <Atom />
                    <text value={str(val)} />
            </stack>

            {/* Footer */}
            <box>
                <text value={"buffer_checksum=" + str(_self.buffer_checksum)} />
                <text value={"ready=" + str(_self.ready)} />
            </box>
        </stack>
    </panel>

// ═══════════════════════════════════════════════════════════════════════════════
//  EXPORTED COMPONENT CATALOG
// ═══════════════════════════════════════════════════════════════════════════════

// The Mothership — all §1-§9 composed into one monster view
component ComponentZoo():
    render <panel title="Component Fuzz — The Zoo">
        <stack direction="vertical">
            {/* §1 — Naked */}
            <box>
                <text value="── §1 Naked Components ──" />
                <Atom />
                <Void />
                <Fragments />
                <ExprOnly value={137} />
                <LongText />
            </box>

            {/* §2 — Stateful */}
            <box>
                <text value="── §2 Stateful ──" />
                <Toggle />
                <BoundedCounter limit={10} />
                <TrafficLight />
                <Thermometer temp={98} unit="F" />
                <ShadowDisplay />
            </box>

            {/* §3 — Computational */}
            <box>
                <text value="── §3 Computational ──" />
                <Factorial n={7} />
                <PrimeSieve limit={100} />
                <FibonacciSeq count={8} />
                <DataPipe input={[1, 2, 3, 5, 8, 13, 21]} multiplier={2} />
            </box>

            {/* §4 — Recursive */}
            <box>
                <text value="── §4 Recursive ──" />
                <RecursiveTree depth={2} label="root" />
                <StringList items={["alpha", "beta", "gamma", "delta"]} />
            </box>

            {/* §5 — Fragment Factories */}
            <box>
                <text value="── §5 Fragment Factories ──" />
                <PureComposition />
                <Card title="Important Card" body="This is a card body." />
                <CardGrid cards={["A", "B", "C"]} cols={3} />
                <LayoutInception depth={3} />
            </box>

            {/* §6 — Pointer-laden */}
            <box>
                <text value="── §6 Pointer-Laden ──" />
                <MemoryWidget cell_count={8} />
                <HotSlots ratio={12} max_ratio={32} />
            </box>

            {/* §7 — Actor-aware */}
            <box>
                <text value="── §7 Actor-Aware ──" />
                <ActorWidget signal={42} />
            </box>

            {/* §8 — Deep Nest */}
            <box>
                <text value="── §8 Deep Nest (10 levels) ──" />
                <Nest_L10 />
            </box>

            {/* §10 — Singularity */}
            <box>
                <text value="── §10 Singularity ──" />
                <Singularity name="O M E G A" phase={3} data={[7, 11, 13, 17, 19]} />
                <Singularity name="A L P H A" phase={1} data={[2]} />
                <Singularity name="E P S I L O N" phase={5} data={[31, 37, 41, 43, 47, 53, 59]} />
            </box>
        </stack>
    </panel>
