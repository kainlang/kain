// ============================================================================
//  COMPONENT FUZZ — Main Entry Point
// ============================================================================
//
//  This is the harness that exercises every component in components.kn.
//  It boots the runtime, seeds the fuzz world, computes a composite checksum
//  of all component-related telemetry, writes a report, and exits.
//
//  The component rendering itself happens through the world surface
//  (FuzzPanel) and the Zoo component. The runtime attaches and renders.
// ============================================================================

use std::runtime
use std::intent
use std::fs
use components::*

fn main() -> Int with Unsafe:
    let boot = runtime_init()
    if boot != 0:
        return 100 + boot

    // ── Seed the fuzz world ──────────────────────────────────────────────
    let authority = FuzzAuthority
    let mirror = FuzzMirror
    let rogue = FuzzRogue

    // Initial commit via patch
    let seed = fuzz_commit(authority, 1)
    let seed2 = fuzz_commit(authority, (seed * 31 + 7) % FUZZ_MODULUS)
    rogue.rogue_val = seed + seed2 + 777

    // ── Exercise computational components ─────────────────────────────────
    // These don't need a live UI session — they just prove the component
    // typechecks, instantiates, and computes correctly.

    // Factorial: 7! = 5040
    let fact = Factorial(n = 7)

    // Prime sieve up to 100
    let sieve = PrimeSieve(limit = 100)

    // Fibonacci: first 8 terms
    let fib = FibonacciSeq(count = 8)

    // Data pipe: [1,2,3,5,8,13,21] × 2
    let pipe = DataPipe(input = [1, 2, 3, 5, 8, 13, 21], multiplier = 2)

    // ── Exercise stateful components ──────────────────────────────────────
    let toggle = Toggle()
    let counter = BoundedCounter(limit = 10)
    let light = TrafficLight()
    let thermo = Thermometer(temp = 98, unit = "F")

    // ── Exercise recursive component ──────────────────────────────────────
    let tree = RecursiveTree(depth = 3, label = "X")

    // ── Exercise pointer-laden component ──────────────────────────────────
    let mem = MemoryWidget(cell_count = 16)

    // ── Exercise singularity ──────────────────────────────────────────────
    let omega = Singularity(name = "OMEGA", phase = 4, data = [2, 3, 5, 7, 11])

    // ── Exercise the zoo ──────────────────────────────────────────────────
    let zoo = ComponentZoo()

    // ── Exercise deeply nested ────────────────────────────────────────────
    let deep = Nest_L10()

    // ── Exercise fragment factory ─────────────────────────────────────────
    let fragments = PureComposition()

    // ── Exercise layout inception ─────────────────────────────────────────
    let layout = LayoutInception(depth = 4)

    // ── Collect telemetry ─────────────────────────────────────────────────
    let entangle_reg = native_entangle_registered_count()
    let entangle_prop = native_entangle_propagation_count()
    let patch_count = native_patch_journal_count()
    let teleport_ct = runtime_machine_teleport_count()
    let pulse_count = runtime_machine_pulse_total_fire_count()

    // Composite checksum — proves everything was touched
    var checksum: Int = 0
    checksum = (checksum + seed + seed2) % FUZZ_MODULUS
    checksum = (checksum + authority.fuzz_score) % FUZZ_MODULUS
    checksum = (checksum + mirror.fuzz_score_copy) % FUZZ_MODULUS
    checksum = (checksum + rogue.rogue_val) % FUZZ_MODULUS
    checksum = (checksum + entangle_reg * 31) % FUZZ_MODULUS
    checksum = (checksum + entangle_prop * 37) % FUZZ_MODULUS
    checksum = (checksum + patch_count * 41) % FUZZ_MODULUS
    checksum = (checksum + teleport_ct * 43) % FUZZ_MODULUS
    checksum = (checksum + pulse_count * 47) % FUZZ_MODULUS

    // ── Write report ──────────────────────────────────────────────────────
    var report = "component_fuzz_report\n"
    report = report + "=====================\n"
    report = report + "authority.signal=" + str(authority.signal) + "\n"
    report = report + "authority.epoch=" + str(authority.epoch) + "\n"
    report = report + "authority.fuzz_score=" + str(authority.fuzz_score) + "\n"
    report = report + "mirror.signal_copy=" + str(mirror.signal_copy) + "\n"
    report = report + "mirror.fuzz_score_copy=" + str(mirror.fuzz_score_copy) + "\n"
    report = report + "rogue.rogue_val=" + str(rogue.rogue_val) + "\n"
    report = report + "entangle_registered=" + str(entangle_reg) + "\n"
    report = report + "entangle_propagations=" + str(entangle_prop) + "\n"
    report = report + "patch_journal=" + str(patch_count) + "\n"
    report = report + "teleport_count=" + str(teleport_ct) + "\n"
    report = report + "pulse_fire_count=" + str(pulse_count) + "\n"
    report = report + "composite_checksum=" + str(checksum) + "\n"
    report = report + "law_valid=" + str(law_is_valid_status(law_status(fuzz_score_valid(authority.fuzz_score)))) + "\n"
    report = report + "patch_journal_depth=" + str(patch_journal_count()) + "\n"
    report = report + "entangle_propagation=" + str(entangle_propagation_count()) + "\n"

    let _ = fs_write_text(".kain/run/component_fuzz_report.txt", report)

    // ── Shutdown ──────────────────────────────────────────────────────────
    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown

    // ── Proof guards ──────────────────────────────────────────────────────
    if entangle_reg < 3:
        return 31
    if patch_count < 2:
        return 32
    if fuzz_score_valid(authority.fuzz_score) == false:
        return 33
    if checksum <= 0:
        return 34

    return 0
