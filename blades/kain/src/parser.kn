pub fn parse_test(state: ParserState) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip test
    // test fn or test Name:
    var body_idx: Int = -1
    // Consume fn if present
    if parser_check(cur, TOKEN_FN):
        cur = parser_advance(cur)
    let name_tok: Token = parser_current(cur)
    if name_tok.kind == TOKEN_IDENT:
        cur = parser_advance(cur)
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let body_res: ParseResult = parse_block_or_expr(cur)
        cur = body_res.state
        body_idx = body_res.node
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_TEST, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

// ═══════════════════════════════════════════════════════════════════════════
// ITEM PARSERS — Contextual Keyword Items (patch, law, converge, world, etc.)
// ═══════════════════════════════════════════════════════════════════════════

pub fn parse_patch_item(state: ParserState, vis: Int, attrs: Array<Int>) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip patch
    // patch name(params) -> Ret: body
    let name_tok: Token = parser_current(cur)
    if name_tok.kind != TOKEN_IDENT:
        cur = parser_synchronize(cur)
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let name_result: (ParserState, Int) = parser_intern(cur, name_tok.text)
    cur = name_result.0
    let name_idx: Int = name_result.1

    // Parse like a function
    var param_names: Array<Int> = []
    var param_types: Array<Int> = []
    if parser_check(cur, TOKEN_LPAREN):
        cur = parser_advance(cur)
        while not parser_check(cur, TOKEN_RPAREN) and not parser_is_at_end(cur):
            let pn: Token = parser_current(cur)
            if pn.kind == TOKEN_IDENT:
                cur = parser_advance(cur)
                let pr: (ParserState, Int) = parser_intern(cur, pn.text)
                cur = pr.0
                push(param_names, pr.1)
                if parser_check(cur, TOKEN_COLON):
                    cur = parser_advance(cur)
                let pt: ParseResult = parse_type(cur)
                cur = pt.state
                push(param_types, pt.node)
                if parser_check(cur, TOKEN_COMMA):
                    cur = parser_advance(cur)
            else:
                break
        if parser_check(cur, TOKEN_RPAREN):
            cur = parser_advance(cur)

    var ret_idx: Int = -1
    if parser_check(cur, TOKEN_ARROW):
        cur = parser_advance(cur)
        let rr: ParseResult = parse_type(cur)
        cur = rr.state
        ret_idx = rr.node

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, name_idx)
    push(data, len(param_names))
    var pi: Int = 0
    while pi < len(param_names):
        push(data, param_names[pi])
        push(data, param_types[pi])
        pi = pi + 1
    push(data, ret_idx)
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_PATCH, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

pub fn parse_law_item(state: ParserState, vis: Int, attrs: Array<Int>) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip law
    // law name(params) -> Bool: body
    let name_tok: Token = parser_current(cur)
    if name_tok.kind != TOKEN_IDENT:
        cur = parser_synchronize(cur)
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let name_result: (ParserState, Int) = parser_intern(cur, name_tok.text)
    cur = name_result.0
    let name_idx: Int = name_result.1

    var param_names: Array<Int> = []
    var param_types: Array<Int> = []
    if parser_check(cur, TOKEN_LPAREN):
        cur = parser_advance(cur)
        while not parser_check(cur, TOKEN_RPAREN) and not parser_is_at_end(cur):
            let pn: Token = parser_current(cur)
            if pn.kind == TOKEN_IDENT:
                cur = parser_advance(cur)
                let pr: (ParserState, Int) = parser_intern(cur, pn.text)
                cur = pr.0
                push(param_names, pr.1)
                if parser_check(cur, TOKEN_COLON):
                    cur = parser_advance(cur)
                let pt: ParseResult = parse_type(cur)
                cur = pt.state
                push(param_types, pt.node)
                if parser_check(cur, TOKEN_COMMA):
                    cur = parser_advance(cur)
            else:
                break
        if parser_check(cur, TOKEN_RPAREN):
            cur = parser_advance(cur)

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, name_idx)
    push(data, len(param_names))
    var pi: Int = 0
    while pi < len(param_names):
        push(data, param_names[pi])
        push(data, param_types[pi])
        pi = pi + 1
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_LAW, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

