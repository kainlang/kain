pub fn parse_use(state: ParserState) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip use
    // Parse path segments
    var segments: Array<Int> = []
    loop:
        let seg_tok: Token = parser_current(cur)
        if seg_tok.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            let sr: (ParserState, Int) = parser_intern(cur, seg_tok.text)
            cur = sr.0
            push(segments, sr.1)
        elif seg_tok.kind == TOKEN_SELF_LOWER:
            cur = parser_advance(cur)
            let sr: (ParserState, Int) = parser_intern(cur, "self")
            cur = sr.0
            push(segments, sr.1)
        else:
            break
        if parser_check(cur, TOKEN_COLON_COLON):
            cur = parser_advance(cur)
        else:
            break

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, len(segments))
    var si: Int = 0
    while si < len(segments):
        push(data, segments[si])
        si = si + 1
    let node: AstNode = ast_new_node(AST_ITEM_USE, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

