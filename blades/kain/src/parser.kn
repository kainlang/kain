pub fn parse_impl(state: ParserState, vis: Int, attrs: Array<Int>) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip impl

    // Optional TraitName for
    var trait_idx: Int = -1
    let first_tok: Token = parser_current(cur)
    if first_tok.kind == TOKEN_IDENT:
        let pk: Token = parser_peek(cur, 1)
        if pk.kind == TOKEN_IDENT and pk.text == "for":
            cur = parser_advance(cur)
            let tr: (ParserState, Int) = parser_intern(cur, first_tok.text)
            cur = tr.0
            trait_idx = tr.1

    // for (if trait impl)
    if parser_check(cur, TOKEN_IDENT) and parser_current(cur).text == "for":
        cur = parser_advance(cur)

    // Type name
    let type_tok: Token = parser_current(cur)
    if type_tok.kind != TOKEN_IDENT:
        cur = parser_error(cur, "expected type name after 'impl'", ERR_PARSE_EXPECTED_TOKEN,
            type_tok.byte_offset, type_tok.byte_offset + len(type_tok.text))
        cur = parser_synchronize(cur)
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let type_result: (ParserState, Int) = parser_intern(cur, type_tok.text)
    cur = type_result.0
    let type_idx: Int = type_result.1

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let body_res: ParseResult = parse_block_or_expr(cur)
        cur = body_res.state
        body_idx = body_res.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, trait_idx)
    push(data, type_idx)
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_IMPL, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

pub fn parse_type_alias(state: ParserState, vis: Int) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip type

    let name_tok: Token = parser_current(cur)
