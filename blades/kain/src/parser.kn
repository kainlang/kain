pub fn parse_shatter_struct(state: ParserState, vis: Int, attrs: Array<Int>) -> ParseResult:
    let mut cur: ParserState = parser_advance(state)  // skip shatter
    // Expect struct keyword
    if parser_check(cur, TOKEN_STRUCT):
        cur = parser_advance(cur)
    // Parse as struct but mark with shatter flag
    let result: ParseResult = parse_struct(cur, vis, attrs)
    // Tag the result as shatter by setting a flag?
    // For now, just reuse struct item kind with the node as-is
    // The typechecker will handle the shatter semantic
    return result

pub fn parse_include(state: ParserState) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip include
    // include <path> as alias or include "path" as alias
    var path_idx: Int = -1
    let tok: Token = parser_current(cur)
    if tok.kind == TOKEN_STRING:
        cur = parser_advance(cur)
        let pr: (ParserState, Int) = parser_intern(cur, tok.literal_string)
        cur = pr.0
        path_idx = pr.1
    elif tok.kind == TOKEN_LT:
        // System header <path>
        cur = parser_advance(cur)
        var header: String = ""
        while not parser_check(cur, TOKEN_GT) and not parser_is_at_end(cur):
            let ht: Token = parser_current(cur)
            header = header + ht.text
            cur = parser_advance(cur)
        if parser_check(cur, TOKEN_GT):
            cur = parser_advance(cur)
        let pr: (ParserState, Int) = parser_intern(cur, header)
        cur = pr.0
        path_idx = pr.1
    var alias_idx: Int = -1
    if parser_check(cur, TOKEN_AS):
        cur = parser_advance(cur)
        let at: Token = parser_current(cur)
        if at.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            let ar: (ParserState, Int) = parser_intern(cur, at.text)
            cur = ar.0
            alias_idx = ar.1
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, path_idx)
    push(data, alias_idx)
    let node: AstNode = ast_new_node(AST_ITEM_IMPORT, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

pub fn parse_import(state: ParserState) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip import
    var path_parts: Array<Int> = []
    let tok: Token = parser_current(cur)
    if tok.kind == TOKEN_IDENT:
        cur = parser_advance(cur)
        let ir: (ParserState, Int) = parser_intern(cur, tok.text)
        cur = ir.0
        push(path_parts, ir.1)
    var alias_idx: Int = -1
    if parser_check(cur, TOKEN_AS):
        cur = parser_advance(cur)
        let at: Token = parser_current(cur)
        if at.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            let ar: (ParserState, Int) = parser_intern(cur, at.text)
            cur = ar.0
            alias_idx = ar.1
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, len(path_parts))
    var pi: Int = 0
    while pi < len(path_parts):
        push(data, path_parts[pi])
        pi = pi + 1
    push(data, alias_idx)
    let node: AstNode = ast_new_node(AST_ITEM_IMPORT, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

pub fn parse_from_import(state: ParserState) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip from
    var module_idx: Int = -1
    let mt: Token = parser_current(cur)
    if mt.kind == TOKEN_IDENT:
        cur = parser_advance(cur)
        let mr: (ParserState, Int) = parser_intern(cur, mt.text)
        cur = mr.0
        module_idx = mr.1
    // import name
    var import_idx: Int = -1
    if parser_check(cur, TOKEN_IDENT) and parser_current(cur).text == "import":
        cur = parser_advance(cur)
        let it: Token = parser_current(cur)
        if it.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            let irr: (ParserState, Int) = parser_intern(cur, it.text)
            cur = irr.0
            import_idx = irr.1
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, module_idx)
    push(data, import_idx)
    let node: AstNode = ast_new_node(AST_ITEM_IMPORT, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

// ── Component ──

pub fn parse_component(state: ParserState, vis: Int, attrs: Array<Int>) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip component

    let name_tok: Token = parser_current(cur)
    if name_tok.kind != TOKEN_IDENT:
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let name_result: (ParserState, Int) = parser_intern(cur, name_tok.text)
    cur = name_result.0
    let name_idx: Int = name_result.1

    // Optional props: (prop: Type, ...)
    var prop_names: Array<Int> = []
    var prop_types: Array<Int> = []
    if parser_check(cur, TOKEN_LPAREN):
        cur = parser_advance(cur)
        while not parser_check(cur, TOKEN_RPAREN) and not parser_is_at_end(cur):
            let pn: Token = parser_current(cur)
            if pn.kind == TOKEN_IDENT:
                cur = parser_advance(cur)
                let pr: (ParserState, Int) = parser_intern(cur, pn.text)
                cur = pr.0
                push(prop_names, pr.1)
                if parser_check(cur, TOKEN_COLON):
                    cur = parser_advance(cur)
                let pt: ParseResult = parse_type(cur)
                cur = pt.state
                push(prop_types, pt.node)
                if parser_check(cur, TOKEN_COMMA):
                    cur = parser_advance(cur)
            else:
                break
        if parser_check(cur, TOKEN_RPAREN):
            cur = parser_advance(cur)

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, name_idx)
    push(data, len(prop_names))
    var pi: Int = 0
    while pi < len(prop_names):
        push(data, prop_names[pi])
        push(data, prop_types[pi])
        pi = pi + 1
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_COMPONENT, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

// ── Shader ──

pub fn parse_shader(state: ParserState) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip shader
    var body_idx: Int = -1
    // shader vertex/compute Name(params):
    let kind_tok: Token = parser_current(cur)
    if kind_tok.kind == TOKEN_VERTEX or kind_tok.kind == TOKEN_FRAGMENT or kind_tok.kind == TOKEN_COMPTIME or
       (kind_tok.kind == TOKEN_IDENT and kind_tok.text == "compute"):
        cur = parser_advance(cur)
    let name_tok: Token = parser_current(cur)
    if name_tok.kind == TOKEN_IDENT:
        cur = parser_advance(cur)
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_SHADER, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

// ── Actor ──

pub fn parse_actor(state: ParserState, vis: Int, attrs: Array<Int>) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip actor

    let name_tok: Token = parser_current(cur)
    if name_tok.kind != TOKEN_IDENT:
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let name_result: (ParserState, Int) = parser_intern(cur, name_tok.text)
    cur = name_result.0
    let name_idx: Int = name_result.1

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, name_idx)
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_ACTOR, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

// ═══════════════════════════════════════════════════════════════════════════
// JSX PARSER
// ═══════════════════════════════════════════════════════════════════════════

pub fn parse_jsx_element(state: ParserState) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip <

    // Tag name
    let tag_tok: Token = parser_current(cur)
    if tag_tok.kind != TOKEN_IDENT:
        cur = parser_error(cur, "expected JSX tag name", ERR_PARSE_EXPECTED_TOKEN,
            tag_tok.byte_offset, tag_tok.byte_offset + len(tag_tok.text))
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let tag_result: (ParserState, Int) = parser_intern(cur, tag_tok.text)
    cur = tag_result.0
    let tag_idx: Int = tag_result.1

    // Attributes
    var attr_names: Array<Int> = []
    var attr_values: Array<Int> = []
    loop:
        let tkind: Int = parser_current(cur).kind
        if tkind == TOKEN_GT or tkind == TOKEN_SLASH:
            break
        if tkind == TOKEN_IDENT:
            let aname_tok: Token = parser_current(cur)
            cur = parser_advance(cur)
            let anr: (ParserState, Int) = parser_intern(cur, aname_tok.text)
            cur = anr.0
            push(attr_names, anr.1)
            if parser_check(cur, TOKEN_EQ):
                cur = parser_advance(cur)
                let aval_tok: Token = parser_current(cur)
                if aval_tok.kind == TOKEN_STRING:
                    cur = parser_advance(cur)
                    let avr: (ParserState, Int) = parser_intern(cur, aval_tok.literal_string)
                    cur = avr.0
                    push(attr_values, avr.1)
                elif aval_tok.kind == TOKEN_LBRACE:
                    cur = parser_advance(cur)
                    let expr_res: ParseResult = parse_expr(cur)
                    cur = expr_res.state
                    push(attr_values, expr_res.node)
                    if parser_check(cur, TOKEN_RBRACE):
                        cur = parser_advance(cur)
                else:
                    push(attr_values, -1)
            else:
                push(attr_values, -1)
        else:
            cur = parser_advance(cur)

    // Self-closing tag: <tag />
    var children_idxs: Array<Int> = []
    if parser_check(cur, TOKEN_SLASH):
        cur = parser_advance(cur)
        if parser_check(cur, TOKEN_GT):
            cur = parser_advance(cur)
        let end_off: Int = parser_current(cur).byte_offset
        let mut data: Array<Int> = []
        push(data, tag_idx)
        push(data, len(attr_names))
        var ai: Int = 0
        while ai < len(attr_names):
            push(data, attr_names[ai])
            push(data, attr_values[ai])
            ai = ai + 1
        push(data, 0)  // no children
        let node: AstNode = ast_new_node(AST_EXPR_JSX, start, end_off, data)
        let idx: Int = len(cur.program)
        push(cur.program, node)
        return ParseResult { state: cur, node: idx }

    // Opening >
    if parser_check(cur, TOKEN_GT):
        cur = parser_advance(cur)

    // Children
    while not parser_is_at_end(cur):
        // Check for closing tag
        if parser_check(cur, TOKEN_LT_SLASH):
            break
        let ckind: Int = parser_current(cur).kind
        if ckind == TOKEN_LT:
            // Nested JSX element
            let child_res: ParseResult = parse_jsx_element(cur)
            cur = child_res.state
            if child_res.node >= 0:
                push(children_idxs, child_res.node)
        elif ckind == TOKEN_LBRACE:
            // Expression interpolation {expr}
            cur = parser_advance(cur)
            let expr_res: ParseResult = parse_expr(cur)
            cur = expr_res.state
            if expr_res.node >= 0:
                push(children_idxs, expr_res.node)
            if parser_check(cur, TOKEN_RBRACE):
                cur = parser_advance(cur)
        elif ckind == TOKEN_NEWLINE or ckind == TOKEN_INDENT or ckind == TOKEN_DEDENT:
            cur = parser_advance(cur)
        elif ckind == TOKEN_IDENT or ckind == TOKEN_STRING or ckind == TOKEN_INT:
            // Text content
            let text_tok: Token = parser_current(cur)
            cur = parser_advance(cur)
            let txt: String = text_tok.text
            let tr: (ParserState, Int) = parser_intern(cur, txt)
            cur = tr.0
            let text_node: AstNode = ast_new_leaf(AST_EXPR_STRING, text_tok.byte_offset,
                text_tok.byte_offset + len(txt), tr.1)
            let tidx: Int = len(cur.program)
            push(cur.program, text_node)
            push(children_idxs, tidx)
        else:
            cur = parser_advance(cur)

    // Closing tag: </tag>
    if parser_check(cur, TOKEN_LT_SLASH):
        cur = parser_advance(cur)
        let close_tok: Token = parser_current(cur)
        if close_tok.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            if parser_check(cur, TOKEN_GT):
                cur = parser_advance(cur)

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, tag_idx)
    push(data, len(attr_names))
    var aai: Int = 0
    while aai < len(attr_names):
        push(data, attr_names[aai])
        push(data, attr_values[aai])
        aai = aai + 1
    push(data, len(children_idxs))
    var ci: Int = 0
    while ci < len(children_idxs):
        push(data, children_idxs[ci])
        ci = ci + 1
    let node: AstNode = ast_new_node(AST_EXPR_JSX, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

// ═══════════════════════════════════════════════════════════════════════════
// HELPER: bitcast float to int (stub — relies on compiler intrinsic)
// ═══════════════════════════════════════════════════════════════════════════

pub fn bitcast_float_to_int(f: Float) -> Int:
    // Stub: use as cast for now
    return f as Int

// Missing constants referenced in code (defined elsewhere but aliased here)
pub const UNOP_ADD: Int = 6
pub const UNOP_SUB: Int = 7

// Helper to extract span end from a node (needed by assignment desugaring)
pub fn node_data_end(cur: ParserState, node_idx: Int) -> Int:
    if node_idx < 0 or node_idx >= len(cur.program):
        return 0
    return cur.program[node_idx].span_end

// Missing method on ParseResult (used in parse_item for span computation)
pub fn node_data_start(result: ParseResult) -> Int:
    let p: ParserState = result.state
    let n: Int = result.node
    if n < 0 or n >= len(p.program):
        return 0
    return p.program[n].span_start

pub fn node_data_end_res(result: ParseResult) -> Int:
    let p: ParserState = result.state
    let n: Int = result.node
    if n < 0 or n >= len(p.program):
        return 0
    return p.program[n].span_end

