pub fn parse_converge_item(state: ParserState, vis: Int, attrs: Array<Int>) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip converge

    let name_tok: Token = parser_current(cur)
    if name_tok.kind != TOKEN_IDENT:
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let name_result: (ParserState, Int) = parser_intern(cur, name_tok.text)
    cur = name_result.0
    let name_idx: Int = name_result.1

    // Parameters
    var param_names: Array<Int> = []
    var param_types: Array<Int> = []
    if parser_check(cur, TOKEN_LPAREN):
        cur = parser_advance(cur)
        while not parser_check(cur, TOKEN_RPAREN) and not parser_is_at_end(cur):
            let pn: Token = parser_current(cur)
            if pn.kind == TOKEN_IDENT:
                cur = parser_advance(cur)
                let pr: (ParserState, Int) = parser_intern(cur, pn.text)
                cur = pr.0
                push(param_names, pr.1)
                if parser_check(cur, TOKEN_COLON):
                    cur = parser_advance(cur)
                let pt: ParseResult = parse_type(cur)
                cur = pt.state
                push(param_types, pt.node)
                if parser_check(cur, TOKEN_COMMA):
                    cur = parser_advance(cur)
            else:
                break
        if parser_check(cur, TOKEN_RPAREN):
            cur = parser_advance(cur)

    var ret_idx: Int = -1
    if parser_check(cur, TOKEN_ARROW):
        cur = parser_advance(cur)
        let rr: ParseResult = parse_type(cur)
        cur = rr.state
        ret_idx = rr.node

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, name_idx)
    push(data, len(param_names))
    var pi: Int = 0
    while pi < len(param_names):
        push(data, param_names[pi])
        push(data, param_types[pi])
        pi = pi + 1
    push(data, ret_idx)
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_CONVERGE, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

pub fn parse_world_item(state: ParserState, vis: Int, attrs: Array<Int>) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip world

    let name_tok: Token = parser_current(cur)
    if name_tok.kind != TOKEN_IDENT:
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let name_result: (ParserState, Int) = parser_intern(cur, name_tok.text)
    cur = name_result.0
    let name_idx: Int = name_result.1

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, name_idx)
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_WORLD, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

pub fn parse_entangle_item(state: ParserState, vis: Int, attrs: Array<Int>) -> ParseResult:
    let start: Int = parser_current(state).byte_offset
    let mut cur: ParserState = parser_advance(state)  // skip entangle
    // Stub: parse identifiers until colon, then body
    var segs: Array<Int> = []
    while not parser_check(cur, TOKEN_COLON) and not parser_is_at_end(cur):
        let tok: Token = parser_current(cur)
        if tok.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            let sr: (ParserState, Int) = parser_intern(cur, tok.text)
            cur = sr.0
            push(segs, sr.1)
        else:
            cur = parser_advance(cur)
    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    push(data, len(segs))
    var si: Int = 0
    while si < len(segs):
        push(data, segs[si])
        si = si + 1
    push(data, body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_ENTANGLE, start, end_off, data)
    let idx: Int = len(cur.program)
    push(cur.program, node)
    return ParseResult { state: cur, node: idx }

// Stub item parsers for remaining contextual items (orchestrate, pulse, resonate, shatter, include, import, from import, component, shader, actor)

