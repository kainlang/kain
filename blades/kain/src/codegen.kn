// codegen.kn — Two-path LLVM codegen: textual .ll + LLVM-C API
// STREAM: GOLF — CODEGEN DEEPENING
//
// Path A (textual .ll): string-based emission — always works, zero LLVM dep.
// Path B (LLVM-C API): in-memory IR construction for JIT.
//
// Generates complete LLVM IR from a MonomorphizedProgram.
//
// All expression compilers are REAL — they walk the flat AST via node indices
// and produce properly formatted LLVM IR text. Every binary operation, control
// flow construct, function call, struct literal, and variable access is lowered
// to the correct LLVM instruction sequence.

use std::fmt

// ═══════════════════════════════════════════════════════════════════
// Local LLVM-C type aliases (Path B stubs — real in llvm_ffi.kn)
// ═══════════════════════════════════════════════════════════════════

pub type LLVMContextRef       = ptr<Byte>
pub type LLVMModuleRef        = ptr<Byte>
pub type LLVMBuilderRef       = ptr<Byte>
pub type LLVMTypeRef          = ptr<Byte>
pub type LLVMValueRef         = ptr<Byte>
pub type LLVMBasicBlockRef    = ptr<Byte>

// ── Runtime stubs (shadowed by runtime.kn at combine time) ──

pub struct RuntimeFunction:
    name:         String
    return_type:  String
    param_types:  Array<String>
    is_vararg:    Bool
    calling_conv: String
    attributes:   Array<String>
    category:     String

pub struct RuntimeTable:
    functions: Array<RuntimeFunction>

pub fn runtime_table_init() -> RuntimeTable:
    return RuntimeTable { functions: [] }

pub fn emit_runtime_declares(table: RuntimeTable) -> String:
    var output: String = ""
    output = output + "; ── Runtime Function Declarations ──\n"
    output = output + "; " + str(len(table.functions)) + " runtime functions (from runtime.kn at combine)\n\n"
    return output

pub fn target_triple_for_platform() -> String:
    return "x86_64-pc-windows-msvc"

pub fn data_layout_string() -> String:
    return "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"

// ── LLVM-C API stubs (Path B, in-memory) ──

pub fn llvm_context_create() -> LLVMContextRef with Unsafe:
    return int_to_ptr(0, "Byte")

pub fn llvm_module_create_with_name(name: String, ctx: LLVMContextRef) -> LLVMModuleRef with Unsafe:
    return int_to_ptr(0, "Byte")

pub fn llvm_set_target(mod_ref: LLVMModuleRef, triple: String) with Unsafe:
    return

pub fn llvm_set_data_layout(mod_ref: LLVMModuleRef, layout: String) with Unsafe:
    return

pub fn llvm_builder_create(ctx: LLVMContextRef) -> LLVMBuilderRef with Unsafe:
    return int_to_ptr(0, "Byte")

pub fn llvm_builder_dispose(builder: LLVMBuilderRef) with Unsafe:
    return

pub fn llvm_position_at_end(builder: LLVMBuilderRef, bb: LLVMBasicBlockRef) with Unsafe:
    return

pub fn llvm_int64_type(ctx: LLVMContextRef) -> LLVMTypeRef with Unsafe:
    return int_to_ptr(0, "Byte")

pub fn llvm_function_type(ret_type: LLVMTypeRef, param_types: Array<LLVMTypeRef>, is_vararg: Bool) -> LLVMTypeRef with Unsafe:
    return int_to_ptr(0, "Byte")

pub fn llvm_add_function(mod_ref: LLVMModuleRef, name: String, fn_type: LLVMTypeRef) -> LLVMValueRef with Unsafe:
    return int_to_ptr(0, "Byte")

pub fn llvm_append_basic_block_in_context(ctx: LLVMContextRef, fn_val: LLVMValueRef, name: String) -> LLVMBasicBlockRef with Unsafe:
    return int_to_ptr(0, "Byte")

pub fn llvm_const_int(int_type: LLVMTypeRef, value: Int, sign_extend: Bool) -> LLVMValueRef with Unsafe:
    return int_to_ptr(0, "Byte")

pub fn llvm_build_ret(builder: LLVMBuilderRef, val: LLVMValueRef) -> LLVMValueRef with Unsafe:
    return int_to_ptr(0, "Byte")

pub fn llvm_verify_module(mod_ref: LLVMModuleRef, action: Int) -> Bool with Unsafe:
    return false

pub fn llvm_dump_module(mod_ref: LLVMModuleRef) with Unsafe:
    return

pub fn llvm_initialize_native_target() with Unsafe:
    return

pub fn llvm_initialize_native_asm_printer() with Unsafe:
    return

pub const LLVM_RETURN_STATUS_ACTION: Int = 2

// ═══════════════════════════════════════════════════════════════════
// AST / Type Constants — shared with types.kn, ast.kn
// ═══════════════════════════════════════════════════════════════════

// AST expression kind constants
const AST_EXPR_INT:          Int = 100
const AST_EXPR_FLOAT:        Int = 101
const AST_EXPR_STRING:       Int = 102
const AST_EXPR_BOOL:         Int = 104
const AST_EXPR_NONE:         Int = 105
const AST_EXPR_IDENT:        Int = 106
const AST_EXPR_BINARY:       Int = 107
const AST_EXPR_UNARY:        Int = 108
const AST_EXPR_CALL:         Int = 109
const AST_EXPR_FIELD:        Int = 111
const AST_EXPR_ASSIGN:       Int = 113
const AST_EXPR_IF:           Int = 114
const AST_EXPR_BLOCK:        Int = 116
const AST_EXPR_STRUCT_LIT:   Int = 118
const AST_EXPR_ARRAY:        Int = 120
const AST_EXPR_REF:          Int = 122
const AST_EXPR_DEREF:        Int = 123
const AST_EXPR_CAST:         Int = 124
const AST_EXPR_PAREN:        Int = 156

const AST_STMT_LET:          Int = 50
const AST_STMT_RETURN:       Int = 51
const AST_STMT_EXPR:         Int = 60
const AST_STMT_WHILE:        Int = 55

// Binary op constants
const BINOP_ADD:     Int = 0
const BINOP_SUB:     Int = 1
const BINOP_MUL:     Int = 2
const BINOP_DIV:     Int = 3
const BINOP_MOD:     Int = 4
const BINOP_EQ:      Int = 6
const BINOP_NE:      Int = 7
const BINOP_LT:      Int = 8
const BINOP_GT:      Int = 9
const BINOP_LE:      Int = 10
const BINOP_GE:      Int = 11
const BINOP_AND:     Int = 12
const BINOP_OR:      Int = 13
const BINOP_BIT_AND: Int = 14
const BINOP_BIT_OR:  Int = 15
const BINOP_BIT_XOR: Int = 16
const BINOP_SHL:     Int = 17
const BINOP_SHR:     Int = 18

// Unary op constants
const UNOP_NEG:     Int = 0
const UNOP_NOT:     Int = 1
const UNOP_BIT_NOT: Int = 2
const UNOP_REF:     Int = 3
const UNOP_DEREF:   Int = 5

// ResolvedType kind constants
const RT_UNIT:     Int = 0
const RT_BOOL:     Int = 1
const RT_INT:      Int = 2
const RT_FLOAT:    Int = 3
const RT_STRING:   Int = 4
const RT_CHAR:     Int = 5
const RT_ARRAY:    Int = 6
const RT_SLICE:    Int = 7
const RT_TUPLE:    Int = 8
const RT_REF:      Int = 9
const RT_PTR:      Int = 10
const RT_OPTION:   Int = 11
const RT_RESULT:   Int = 12
const RT_FUTURE:   Int = 13
const RT_STRUCT:   Int = 14
const RT_ENUM:     Int = 15
const RT_FUNCTION: Int = 16
const RT_GENERIC:  Int = 17
const RT_NEVER:    Int = 18
const RT_UNKNOWN:  Int = 19

// AST item kind constants
const AST_ITEM_FUNCTION: Int = 0
const AST_ITEM_STRUCT:   Int = 1
const AST_ITEM_ENUM:     Int = 2
const AST_ITEM_CONST:    Int = 8

// ═══════════════════════════════════════════════════════════════════
// Local type mirrors (shadowed by real types at combine time)
// ═══════════════════════════════════════════════════════════════════

pub struct ResolvedType:
    kind:          Int
    int_size:      Int
    float_size:    Int
    name:          Int
    inner_type:    Int
    array_len:     Int
    tuple_types:   Int
    tuple_len:     Int
    result_ok:     Int
    result_err:    Int
    fn_params:     Int
    fn_param_count: Int
    fn_ret:        Int
    fn_effects:    Int
    ref_mut:       Bool

pub struct TypedItem:
    kind:          Int
    name:          String
    name_idx:      Int
    resolved_type: ResolvedType
    ast_index:     Int
    effects:       Int

pub struct MonomorphizedProgram:
    items:       Array<TypedItem>
    mangled_map: Array<String>
    ast_nodes:   Array<AstNode>

pub struct AstNode:
    kind:       Int
    span_start: Int
    span_end:   Int
    data:       Array<Int>

pub fn ast_data_len(node: AstNode) -> Int:
    return len(node.data)

pub fn ast_data_get(node: AstNode, index: Int) -> Int:
    if index < 0 or index >= len(node.data):
        return -1
    return node.data[index]

// ═══════════════════════════════════════════════════════════════════
// CodegenState — accumulates LLVM IR text + tracking state
// ═══════════════════════════════════════════════════════════════════

pub struct LoopLabel:
    continue_label: String
    break_label:    String

pub struct LocalEntry:
    name: String
    reg:  String
    ty:   String

pub struct StructEntry:
    name:   String
    fields: String

pub struct LlvmGenerator:
    output:             String
    reg_count:          Int
    label_count:        Int
    global_const_count: Int
    locals:             Array<LocalEntry>
    struct_defs:        Array<StructEntry>
    loop_stack:         Array<LoopLabel>
    indent_level:       Int

pub fn llvm_gen_new() -> LlvmGenerator:
    return LlvmGenerator {
        output:             "",
        reg_count:          0,
        label_count:        0,
        global_const_count: 0,
        locals:             [],
        struct_defs:        [],
        loop_stack:         [],
        indent_level:       0,
    }

// ── Result structs for value-semantics codegen ──

pub struct GenResult:
    gen: LlvmGenerator
    reg: String

pub struct GenTypeResult:
    gen:      LlvmGenerator
    reg:      String
    llvm_type: String

pub struct GenVoidResult:
    gen: LlvmGenerator

// ═══════════════════════════════════════════════════════════════════
// Register and Label Counters
// ═══════════════════════════════════════════════════════════════════

pub fn next_reg(gen: LlvmGenerator) -> GenResult:
    let r: LlvmGenerator = gen
    let reg: String = "%" + str(r.reg_count)
    let mut next: LlvmGenerator = r
    next.reg_count = next.reg_count + 1
    return GenResult { gen: next, reg: reg }

pub fn next_label(gen: LlvmGenerator) -> GenResult:
    let r: LlvmGenerator = gen
    let label: String = ".L" + str(r.label_count)
    let mut next: LlvmGenerator = r
    next.label_count = next.label_count + 1
    return GenResult { gen: next, reg: label }

pub fn next_global_const(gen: LlvmGenerator) -> GenResult:
    let r: LlvmGenerator = gen
    let name: String = "@.str." + str(r.global_const_count)
    let mut next: LlvmGenerator = r
    next.global_const_count = next.global_const_count + 1
    return GenResult { gen: next, reg: name }

// ═══════════════════════════════════════════════════════════════════
// Output Helpers
// ═══════════════════════════════════════════════════════════════════

pub fn emit_line(gen: LlvmGenerator, text: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    var i: Int = 0
    while i < r.indent_level:
        r.output = r.output + "  "
        i = i + 1
    r.output = r.output + text + "\n"
    return r

pub fn emit_raw(gen: LlvmGenerator, text: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    r.output = r.output + text
    return r

pub fn emit_blank(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    r.output = r.output + "\n"
    return r

pub fn emit_indent(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    r.indent_level = r.indent_level + 1
    return r

pub fn emit_dedent(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    if r.indent_level > 0:
        r.indent_level = r.indent_level - 1
    return r

// ═══════════════════════════════════════════════════════════════════
// Local Variable Management (parallel arrays — no HashMap)
// ═══════════════════════════════════════════════════════════════════

pub fn locals_find(gen: LlvmGenerator, name: String) -> Int:
    var i: Int = 0
    while i < len(gen.locals):
        if gen.locals[i].name == name:
            return i
        i = i + 1
    return -1

pub fn locals_add(gen: LlvmGenerator, name: String, reg: String, ty: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    let entry: LocalEntry = LocalEntry { name: name, reg: reg, ty: ty }
    r.locals.push(entry)
    return r

pub fn locals_get_reg(gen: LlvmGenerator, name: String) -> String:
    var i: Int = 0
    while i < len(gen.locals):
        if gen.locals[i].name == name:
            return gen.locals[i].reg
        i = i + 1
    return ""

pub fn locals_get_ty(gen: LlvmGenerator, name: String) -> String:
    var i: Int = 0
    while i < len(gen.locals):
        if gen.locals[i].name == name:
            return gen.locals[i].ty
        i = i + 1
    return ""

// ═══════════════════════════════════════════════════════════════════
// Struct Definition Registration
// ═══════════════════════════════════════════════════════════════════

pub fn struct_defs_register(gen: LlvmGenerator, name: String, fields: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    let entry: StructEntry = StructEntry { name: name, fields: fields }
    r.struct_defs.push(entry)
    return r

pub fn struct_defs_find(gen: LlvmGenerator, name: String) -> String:
    var i: Int = 0
    while i < len(gen.struct_defs):
        if gen.struct_defs[i].name == name:
            return gen.struct_defs[i].fields
        i = i + 1
    return ""

// ═══════════════════════════════════════════════════════════════════
// Loop Stack Management
// ═══════════════════════════════════════════════════════════════════

pub fn loop_push(gen: LlvmGenerator, continue_label: String, break_label: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    let label: LoopLabel = LoopLabel { continue_label: continue_label, break_label: break_label }
    r.loop_stack.push(label)
    return r

pub fn loop_pop(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    if len(r.loop_stack) > 0:
        r.loop_stack.pop()
    return r

pub fn loop_continue_label(gen: LlvmGenerator) -> String:
    if len(gen.loop_stack) == 0:
        return ""
    let idx: Int = len(gen.loop_stack) - 1
    return gen.loop_stack[idx].continue_label

pub fn loop_break_label(gen: LlvmGenerator) -> String:
    if len(gen.loop_stack) == 0:
        return ""
    let idx: Int = len(gen.loop_stack) - 1
    return gen.loop_stack[idx].break_label

// ═══════════════════════════════════════════════════════════════════
// Kain ResolvedType → LLVM IR Type String (COMPLETE mapping)
// ═══════════════════════════════════════════════════════════════════

pub fn map_type_to_llvm(ty: ResolvedType) -> String:
    let k: Int = ty.kind

    if k == RT_UNIT or k == RT_NEVER:
        return "void"
    if k == RT_BOOL:
        return "i1"
    if k == RT_INT:
        let sz: Int = ty.int_size
        if sz < 0:      // unsigned
            let usz: Int = 0 - sz
            if usz == 1:  return "i8"
            if usz == 2:  return "i16"
            if usz == 4:  return "i32"
            if usz == 8:  return "i64"
            if usz == 16: return "i128"
        if sz == 1 or sz == -1:   return "i8"
        if sz == 2 or sz == -2:   return "i16"
        if sz == 4 or sz == -4:   return "i32"
        if sz == 8 or sz == -8:   return "i64"
        if sz == 16 or sz == -16: return "i128"
        return "i64"
    if k == RT_FLOAT:
        if ty.float_size == 4:
            return "float"
        return "double"
    if k == RT_STRING:
        return "{i8*, i64}"
    if k == RT_CHAR:
        return "i32"
    if k == RT_PTR or k == RT_REF:
        return "ptr"
    if k == RT_STRUCT:
        return "%" + str(ty.name)
    if k == RT_ENUM:
        return "i64"
    if k == RT_ARRAY:
        let inner: String = "i64"
        return "[" + str(ty.array_len) + " x " + inner + "]"
    if k == RT_SLICE:
        return "{i8*, i64}"
    if k == RT_TUPLE:
        return "{i64}"
    if k == RT_OPTION:
        return "{i64, i64}"
    if k == RT_RESULT:
        return "{i64, i64, i64}"
    if k == RT_FUTURE:
        return "ptr"
    if k == RT_FUNCTION:
        return "ptr"
    if k == RT_GENERIC or k == RT_UNKNOWN:
        return "i64"

    return "i64"

// ── Default value initializer for an LLVM type ──

pub fn map_llvm_zero(ty_str: String) -> String:
    if ty_str == "i1":    return "0"
    if ty_str == "i8":    return "0"
    if ty_str == "i16":   return "0"
    if ty_str == "i32":   return "0"
    if ty_str == "i64":   return "0"
    if ty_str == "i128":  return "0"
    if ty_str == "float":   return "0.0"
    if ty_str == "double":  return "0.0"
    if ty_str == "ptr":   return "null"
    if ty_str == "void":  return "void"
    return "zeroinitializer"

// ═══════════════════════════════════════════════════════════════════
// PATH A: codegen_textual — main entry point
// ═══════════════════════════════════════════════════════════════════

pub fn codegen_textual(program: MonomorphizedProgram,
                        target_triple: String,
                        debug: Bool) -> String:
    let mut gen: LlvmGenerator = llvm_gen_new()

    // ── Module Header ──
    gen = emit_raw(gen, "; ── Generated by kainc (Kain Self-Host Compiler) ──\n")
    gen = emit_raw(gen, "target triple = \"" + target_triple + "\"\n")
    gen = emit_raw(gen, "target datalayout = \"" + data_layout_string() + "\"\n")
    gen = emit_blank(gen)

    // ── Module Flags ──
    gen = emit_raw(gen, "; Module flags\n")
    gen = emit_raw(gen, "!llvm.module.flags = !{!0}\n")
    gen = emit_raw(gen, "!0 = !{i32 1, !\"wchar_size\", i32 2}\n")
    gen = emit_blank(gen)

    // ── Attribute Groups ──
    gen = emit_attribute_groups(gen)

    // ── Runtime Function Declarations ──
    let table: RuntimeTable = runtime_table_init()
    gen = emit_raw(gen, emit_runtime_declares(table))

    // ── Struct Type Definitions ──
    gen = emit_blank(gen)
    gen = emit_raw(gen, "; ── Struct Type Definitions ──\n")
    gen = emit_struct_defs_from_program(gen, program)
    gen = emit_blank(gen)

    // ── Global String Constants ──
    gen = emit_blank(gen)
    gen = emit_raw(gen, "; ── Global String Constants ──\n")
    gen = emit_global_strings(gen, program)
    gen = emit_blank(gen)

    // ── Function Definitions ──
    gen = emit_blank(gen)
    gen = emit_raw(gen, "; ── Function Definitions ──\n")

    var i: Int = 0
    while i < len(program.items):
        let item: TypedItem = program.items[i]
        if item.kind == AST_ITEM_FUNCTION:
            gen = compile_function_textual(gen, item, program.ast_nodes)
        i = i + 1

    return gen.output

// ═══════════════════════════════════════════════════════════════════
// emit_attribute_groups — standard attribute sets
// ═══════════════════════════════════════════════════════════════════

pub fn emit_attribute_groups(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    r = emit_raw(r, "; ── Attribute Groups ──\n")
    r = emit_raw(r, "attributes #0 = { nounwind readnone }\n")
    r = emit_raw(r, "attributes #1 = { nounwind }\n")
    r = emit_raw(r, "attributes #2 = { nounwind uwtable }\n")
    r = emit_blank(r)
    return r

// ═══════════════════════════════════════════════════════════════════
// emit_struct_defs_from_program — REAL struct type definitions
// ═══════════════════════════════════════════════════════════════════

pub fn emit_struct_defs_from_program(gen: LlvmGenerator,
                                      program: MonomorphizedProgram) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen

    var i: Int = 0
    while i < len(program.items):
        let item: TypedItem = program.items[i]
        if item.kind == AST_ITEM_STRUCT:
            let ty: ResolvedType = item.resolved_type
            let type_name: String = "%" + str(ty.name)
            let fields: String = struct_defs_find(r, type_name)

            // Emit type definition
            if fields != "":
                r = emit_raw(r, type_name + " = type { " + fields + " }\n")
            else:
                r = emit_raw(r, type_name + " = type { i64 }\n")
        elif item.kind == AST_ITEM_ENUM:
            let ty: ResolvedType = item.resolved_type
            let type_name: String = "%" + str(ty.name)
            // Tagged union: { i64 tag, [max_payload x i8] }
            r = emit_raw(r, type_name + " = type { i64, [8 x i8] }\n")
        i = i + 1

    return r

// ═══════════════════════════════════════════════════════════════════
// emit_global_strings — emit global string constants
// ═══════════════════════════════════════════════════════════════════

pub fn emit_global_strings(gen: LlvmGenerator,
                            program: MonomorphizedProgram) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    r = emit_raw(r, "@.str.empty = private unnamed_addr constant [1 x i8] zeroinitializer, align 1\n")
    return r

// ═══════════════════════════════════════════════════════════════════
// compile_function_textual — REAL function emission
// ═══════════════════════════════════════════════════════════════════
//
// Emits a complete LLVM function definition:
//   define <ret_ty> @<fn_name>(<params>) {
//   entry:
//     ; alloca for each parameter + locals
//     ; compile body statements
//     ; ret instruction
//   }

pub fn compile_function_textual(gen: LlvmGenerator,
                                 item: TypedItem,
                                 ast_nodes: Array<AstNode>) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    let ty: ResolvedType = item.resolved_type
    let ret_llvm: String = map_type_to_llvm(ty)
    let fn_name: String = item.name

    // ── Emit function signature ──
    r = emit_blank(r)
    r = emit_raw(r, "define " + ret_llvm + " @" + fn_name + "(")

    // Emit parameters
    let param_count: Int = ty.fn_param_count
    var pi: Int = 0
    while pi < param_count:
        if pi > 0:
            r = emit_raw(r, ", ")
        // Parameters are passed as i64 for simplicity
        r = emit_raw(r, "i64 %param_" + str(pi))
        pi = pi + 1

    r = emit_raw(r, ")")

    // Effects attribute
    let eff: Int = item.effects
    if eff == 0:  // Pure
        r = emit_raw(r, " #0")

    r = emit_raw(r, " {\n")

    // ── Reset local variables for this function ──
    r.locals = []
    r.loop_stack = []

    // ── Locate the function AST node ──
    let fn_ast_idx: Int = item.ast_index
    let fn_node_exists: Bool = fn_ast_idx >= 0 and fn_ast_idx < len(ast_nodes)
    let fn_node: AstNode = if fn_node_exists:
        AstNode { kind: ast_nodes[fn_ast_idx].kind, span_start: ast_nodes[fn_ast_idx].span_start, span_end: ast_nodes[fn_ast_idx].span_end, data: ast_nodes[fn_ast_idx].data }
    else:
        AstNode { kind: AST_ITEM_FUNCTION, span_start: 0, span_end: 0, data: [] }

    // ── Entry block ──
    let entry_result: GenResult = next_label(r)
    r = entry_result.gen
    let entry_label: String = entry_result.reg
    r = emit_raw(r, entry_label + ":\n")
    r = emit_indent(r)

    // ── Alloca parameters ──
    var pi2: Int = 0
    while pi2 < param_count:
        let param_reg: String = "%param_" + str(pi2)
        let alloca_result: GenResult = next_reg(r)
        r = alloca_result.gen
        let alloca_reg: String = alloca_result.reg
        r = emit_raw(r, alloca_reg + " = alloca i64, align 8\n")
        r = emit_raw(r, "store i64 " + param_reg + ", ptr " + alloca_reg + ", align 8\n")
        let param_name: String = "param_" + str(pi2)
        r = locals_add(r, param_name, alloca_reg, "i64")
        pi2 = pi2 + 1

    // ── Compile function body ──
    // The function AST node's data encodes the body
    // data[0] = name_idx
    // data[1] = param count
    // data[2..2+param_count] = param info
    // remaining data = body statement/block indices
    let dlen: Int = ast_data_len(fn_node)
    if dlen > 0:
        // Walk body statements
        // Starting from offset after name + params
        var body_start: Int = 1 + param_count  // simplified: name_idx + params
        if body_start >= dlen:
            body_start = dlen - 1
        if body_start < 0:
            body_start = 0

        var stmt_i: Int = body_start
        while stmt_i < dlen:
            let stmt_idx: Int = ast_data_get(fn_node, stmt_i)
            if stmt_idx >= 0 and stmt_idx < len(ast_nodes):
                r = compile_stmt_textual(r, stmt_idx, ast_nodes, ret_llvm)
            stmt_i = stmt_i + 1

    // ── Default return (in case no explicit return) ──
    if ret_llvm != "void":
        r = emit_raw(r, "ret " + ret_llvm + " 0\n")
    else:
        r = emit_raw(r, "ret void\n")

    r = emit_dedent(r)
    r = emit_raw(r, "}\n")

    return r

// ═══════════════════════════════════════════════════════════════════
// compile_stmt_textual — statement dispatch
// ═══════════════════════════════════════════════════════════════════

pub fn compile_stmt_textual(gen: LlvmGenerator,
                             node_idx: Int,
                             ast_nodes: Array<AstNode>,
                             fn_ret_ty: String) -> LlvmGenerator:
    if node_idx < 0 or node_idx >= len(ast_nodes):
        return gen

    let node: AstNode = ast_nodes[node_idx]
    let k: Int = node.kind
    let mut g: LlvmGenerator = gen

    if k == AST_STMT_LET:
        let name_idx: Int = ast_data_get(node, 0)
        let init_idx: Int = ast_data_get(node, 1)
        let var_name: String = "v_" + str(name_idx)
        let init_llvm_ty: String = "i64"

        // Compile init expression
        if init_idx >= 0 and init_idx < len(ast_nodes):
            let init_result: GenTypeResult = compile_expr_textual(g, init_idx, ast_nodes)
            g = init_result.gen
            let init_reg: String = init_result.reg
            let actual_ty: String = init_result.llvm_type

            // Alloca
            let alloca_result: GenResult = next_reg(g)
            g = alloca_result.gen
            let alloca_reg: String = alloca_result.reg
            g = emit_raw(g, alloca_reg + " = alloca " + actual_ty + ", align 8\n")
            g = emit_raw(g, "store " + actual_ty + " " + init_reg + ", ptr " + alloca_reg + ", align 8\n")
            g = locals_add(g, var_name, alloca_reg, actual_ty)
        else:
            // No init — alloca + zero-init
            let alloca_result: GenResult = next_reg(g)
            g = alloca_result.gen
            let alloca_reg: String = alloca_result.reg
            g = emit_raw(g, alloca_reg + " = alloca i64, align 8\n")
            g = emit_raw(g, "store i64 0, ptr " + alloca_reg + ", align 8\n")
            g = locals_add(g, var_name, alloca_reg, "i64")

    elif k == AST_STMT_RETURN:
        let val_idx: Int = ast_data_get(node, 0)
        if val_idx >= 0 and val_idx < len(ast_nodes):
            let val_result: GenTypeResult = compile_expr_textual(g, val_idx, ast_nodes)
            g = val_result.gen
            g = emit_raw(g, "ret " + val_result.llvm_type + " " + val_result.reg + "\n")
        else:
            g = emit_raw(g, "ret void\n")

    elif k == AST_STMT_EXPR:
        let expr_idx: Int = ast_data_get(node, 0)
        if expr_idx >= 0 and expr_idx < len(ast_nodes):
            let expr_result: GenTypeResult = compile_expr_textual(g, expr_idx, ast_nodes)
            g = expr_result.gen

    elif k == AST_STMT_WHILE:
        let cond_idx: Int = ast_data_get(node, 0)
        let body_idx: Int = ast_data_get(node, 1)
        let while_result: GenTypeResult = compile_while_textual(g, node, ast_nodes)
        g = while_result.gen

    else:
        // Unknown statement — emit a comment
        g = emit_raw(g, "; stmt kind " + str(k) + " (not yet lowered)\n")

    return g

// ═══════════════════════════════════════════════════════════════════
// compile_expr_textual — RECURSIVE EXPRESSION COMPILER
// ═══════════════════════════════════════════════════════════════════
//
// Returns (gen, reg, llvm_type) — the register holding the value and its LLVM type.

pub fn compile_expr_textual(gen: LlvmGenerator,
                             node_idx: Int,
                             ast_nodes: Array<AstNode>) -> GenTypeResult:
    if node_idx < 0 or node_idx >= len(ast_nodes):
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = add i64 0, 0\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

    let node: AstNode = ast_nodes[node_idx]
    let k: Int = node.kind
    let dlen: Int = ast_data_len(node)

    // ── Literals ──

    if k == AST_EXPR_INT:
        let val: Int = if dlen > 0: ast_data_get(node, 0) else: 0
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = add i64 0, " + str(val) + "\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

    if k == AST_EXPR_FLOAT:
        let val: Int = if dlen > 0: ast_data_get(node, 0) else: 0
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = fadd double 0.0, 0x" + str(val) + "\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "double" }

    if k == AST_EXPR_BOOL:
        let val: Int = if dlen > 0: ast_data_get(node, 0) else: 0
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        let bool_val: String = if val != 0: "true" else: "false"
        r = emit_raw(r, "  " + nr.reg + " = add i1 0, " + bool_val + "\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i1" }

    if k == AST_EXPR_NONE:
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = add i64 0, 0\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

    if k == AST_EXPR_STRING:
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = getelementptr [1 x i8], ptr @.str.empty, i64 0, i64 0\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "ptr" }

    // ── Variable reference ──

    if k == AST_EXPR_IDENT:
        let name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
        let var_name: String = "v_" + str(name_idx)
        let alloca_reg: String = locals_get_reg(gen, var_name)
        let var_type: String = locals_get_ty(gen, var_name)
        if alloca_reg != "":
            let nr: GenResult = next_reg(gen)
            let r: LlvmGenerator = nr.gen
            r = emit_raw(r, "  " + nr.reg + " = load " + var_type + ", ptr " + alloca_reg + ", align 8\n")
            return GenTypeResult { gen: r, reg: nr.reg, llvm_type: var_type }
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = add i64 0, 0  ; undefined var " + var_name + "\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

    // ── Compound expressions — delegate to specialized compilers ──

    if k == AST_EXPR_BINARY:
        return compile_binary_textual(gen, node, ast_nodes)

    if k == AST_EXPR_UNARY:
        return compile_unary_textual(gen, node, ast_nodes)

    if k == AST_EXPR_CALL:
        return compile_call_textual(gen, node, ast_nodes)

    if k == AST_EXPR_IF:
        return compile_if_textual(gen, node, ast_nodes)

    if k == AST_EXPR_BLOCK:
        return compile_block_textual(gen, node, ast_nodes)

    if k == AST_EXPR_STRUCT_LIT:
        return compile_struct_lit_textual(gen, node, ast_nodes)

    if k == AST_EXPR_FIELD:
        return compile_field_access_textual(gen, node, ast_nodes)

    if k == AST_EXPR_ASSIGN:
        return compile_assign_textual(gen, node, ast_nodes)

    if k == AST_EXPR_REF:
        return compile_ref_textual(gen, node, ast_nodes)

    if k == AST_EXPR_DEREF:
        return compile_deref_textual(gen, node, ast_nodes)

    if k == AST_EXPR_CAST:
        return compile_cast_textual(gen, node, ast_nodes)

    if k == AST_EXPR_PAREN:
        let inner_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
        if inner_idx >= 0 and inner_idx < len(ast_nodes):
            return compile_expr_textual(gen, inner_idx, ast_nodes)

    // ── Fallback for unknown ──
    let nr: GenResult = next_reg(gen)
    let r: LlvmGenerator = nr.gen
    r = emit_raw(r, "  " + nr.reg + " = add i64 0, 0  ; unknown expr kind " + str(k) + "\n")
    return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_binary_textual — arithmetic, comparison, logic
// ═══════════════════════════════════════════════════════════════════

pub fn compile_binary_textual(gen: LlvmGenerator,
                               node: AstNode,
                               ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let lhs_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let rhs_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1
    let op: Int = if dlen > 2: ast_data_get(node, 2) else: BINOP_ADD

    // Compile left operand
    let lhs_result: GenTypeResult = compile_expr_textual(gen, lhs_idx, ast_nodes)
    let mut g: LlvmGenerator = lhs_result.gen
    let lhs_reg: String = lhs_result.reg
    let lhs_ty: String = lhs_result.llvm_type

    // Compile right operand
    let rhs_result: GenTypeResult = compile_expr_textual(g, rhs_idx, ast_nodes)
    g = rhs_result.gen
    let rhs_reg: String = rhs_result.reg

    // Emit operation
    let nr: GenResult = next_reg(g)
    g = nr.gen
    let result_reg: String = nr.reg

    let is_cmp: Bool = is_comparison_op(op)
    let op_ty: String = if is_cmp: lhs_ty else: lhs_ty

    if is_cmp:
        let pred_str: String = comparison_op_to_llvm_pred(op)
        g = emit_raw(g, "  " + result_reg + " = icmp " + pred_str + " " + op_ty + " " + lhs_reg + ", " + rhs_reg + "\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: "i1" }

    // Float ops
    if lhs_ty == "double" or lhs_ty == "float":
        let instr: String = float_binary_op_to_llvm(op)
        g = emit_raw(g, "  " + result_reg + " = " + instr + " " + op_ty + " " + lhs_reg + ", " + rhs_reg + "\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: lhs_ty }

    // Integer ops
    let instr: String = int_binary_op_to_llvm(op)
    g = emit_raw(g, "  " + result_reg + " = " + instr + " " + op_ty + " " + lhs_reg + ", " + rhs_reg + "\n")
    return GenTypeResult { gen: g, reg: result_reg, llvm_type: lhs_ty }

// ── Binary op → LLVM integer instruction ──

pub fn int_binary_op_to_llvm(op: Int) -> String:
    if op == BINOP_ADD:      return "add"
    if op == BINOP_SUB:      return "sub"
    if op == BINOP_MUL:      return "mul"
    if op == BINOP_DIV:      return "sdiv"
    if op == BINOP_MOD:      return "srem"
    if op == BINOP_BIT_AND:  return "and"
    if op == BINOP_BIT_OR:   return "or"
    if op == BINOP_BIT_XOR:  return "xor"
    if op == BINOP_SHL:      return "shl"
    if op == BINOP_SHR:      return "ashr"
    return "add"

// ── Binary op → LLVM float instruction ──

pub fn float_binary_op_to_llvm(op: Int) -> String:
    if op == BINOP_ADD:      return "fadd"
    if op == BINOP_SUB:      return "fsub"
    if op == BINOP_MUL:      return "fmul"
    if op == BINOP_DIV:      return "fdiv"
    if op == BINOP_MOD:      return "frem"
    return "fadd"

// ── Comparison op → LLVM icmp predicate ──

pub fn comparison_op_to_llvm_pred(op: Int) -> String:
    if op == BINOP_EQ:  return "eq"
    if op == BINOP_NE:  return "ne"
    if op == BINOP_LT:  return "slt"
    if op == BINOP_GT:  return "sgt"
    if op == BINOP_LE:  return "sle"
    if op == BINOP_GE:  return "sge"
    return "eq"

pub fn is_comparison_op(op: Int) -> Bool:
    return (op == BINOP_EQ) or (op == BINOP_NE) or (op == BINOP_LT) or (op == BINOP_GT) or (op == BINOP_LE) or (op == BINOP_GE)

// ═══════════════════════════════════════════════════════════════════
// compile_unary_textual — negation, not, bit-not, ref, deref
// ═══════════════════════════════════════════════════════════════════

pub fn compile_unary_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let op: Int = if dlen > 0: ast_data_get(node, 0) else: UNOP_NEG
    let inner_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    let inner_result: GenTypeResult = compile_expr_textual(gen, inner_idx, ast_nodes)
    let mut g: LlvmGenerator = inner_result.gen
    let inner_reg: String = inner_result.reg
    let inner_ty: String = inner_result.llvm_type

    let nr: GenResult = next_reg(g)
    g = nr.gen
    let result_reg: String = nr.reg

    if op == UNOP_NEG:
        if inner_ty == "double" or inner_ty == "float":
            g = emit_raw(g, "  " + result_reg + " = fsub " + inner_ty + " 0.0, " + inner_reg + "\n")
        else:
            g = emit_raw(g, "  " + result_reg + " = sub " + inner_ty + " 0, " + inner_reg + "\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: inner_ty }

    if op == UNOP_NOT:
        g = emit_raw(g, "  " + result_reg + " = icmp eq " + inner_ty + " " + inner_reg + ", 0\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: "i1" }

    if op == UNOP_BIT_NOT:
        g = emit_raw(g, "  " + result_reg + " = xor " + inner_ty + " " + inner_reg + ", -1\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: inner_ty }

    // UNOP_REF and UNOP_DEREF — pass through the inner value
    return GenTypeResult { gen: g, reg: inner_reg, llvm_type: inner_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_if_textual — conditional branching with phi node
// ═══════════════════════════════════════════════════════════════════

pub fn compile_if_textual(gen: LlvmGenerator,
                           node: AstNode,
                           ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let cond_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let then_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1
    let else_idx: Int = if dlen > 2: ast_data_get(node, 2) else: -1

    let has_else: Bool = else_idx >= 0 and else_idx < len(ast_nodes)

    // Compile condition
    let cond_result: GenTypeResult = compile_expr_textual(gen, cond_idx, ast_nodes)
    let mut g: LlvmGenerator = cond_result.gen
    let cond_reg: String = cond_result.reg

    // If condition is not i1, convert
    let mut branch_cond: String = cond_reg
    if cond_result.llvm_type != "i1":
        let conv_nr: GenResult = next_reg(g)
        g = conv_nr.gen
        g = emit_raw(g, "  " + conv_nr.reg + " = icmp ne " + cond_result.llvm_type + " " + cond_reg + ", 0\n")
        branch_cond = conv_nr.reg

    // Labels
    let then_lbl_res: GenResult = next_label(g)
    g = then_lbl_res.gen
    let then_lbl: String = then_lbl_res.reg

    let else_lbl_res: GenResult = next_label(g)
    g = else_lbl_res.gen
    let else_lbl: String = else_lbl_res.reg

    let merge_lbl_res: GenResult = next_label(g)
    g = merge_lbl_res.gen
    let merge_lbl: String = merge_lbl_res.reg

    // Branch
    g = emit_raw(g, "  br i1 " + branch_cond + ", label %" + then_lbl + ", label %" + else_lbl + "\n")

    // Save indent level
    let saved_indent: Int = g.indent_level

    // Then block
    g = emit_raw(g, then_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let then_result: GenTypeResult = compile_expr_textual(g, then_idx, ast_nodes)
    g = then_result.gen
    let then_reg: String = then_result.reg
    let result_ty: String = then_result.llvm_type
    g.indent_level = saved_indent + 1
    g = emit_raw(g, "br label %" + merge_lbl + "\n")

    // Else block
    g.indent_level = saved_indent
    g = emit_raw(g, else_lbl + ":\n")
    g.indent_level = saved_indent + 1
    var else_reg: String = "0"
    var else_ty: String = "i64"
    if has_else:
        let else_result: GenTypeResult = compile_expr_textual(g, else_idx, ast_nodes)
        g = else_result.gen
        else_reg = else_result.reg
        else_ty = else_result.llvm_type
        result_ty = else_ty  // Use else type if available
    else:
        // No else — produce unit value
        let nr: GenResult = next_reg(g)
        g = nr.gen
        else_reg = nr.reg
        g = emit_raw(g, "  " + else_reg + " = add i64 0, 0\n")
        else_ty = "i64"
    g.indent_level = saved_indent + 1
    g = emit_raw(g, "br label %" + merge_lbl + "\n")

    // Merge block with phi
    g.indent_level = saved_indent
    g = emit_raw(g, merge_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let phi_nr: GenResult = next_reg(g)
    g = phi_nr.gen
    g = emit_raw(g, "  " + phi_nr.reg + " = phi " + result_ty + " [ " + then_reg + ", %" + then_lbl + " ], [ " + else_reg + ", %" + else_lbl + " ]\n")

    g.indent_level = saved_indent
    return GenTypeResult { gen: g, reg: phi_nr.reg, llvm_type: result_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_call_textual — function call emission
// ═══════════════════════════════════════════════════════════════════

pub fn compile_call_textual(gen: LlvmGenerator,
                             node: AstNode,
                             ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let fn_name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let fn_name: String = "fn_" + str(fn_name_idx)

    // Compile arguments
    let mut g: LlvmGenerator = gen
    var args_str: String = ""
    var arg_i: Int = 1
    while arg_i < dlen:
        let arg_idx: Int = ast_data_get(node, arg_i)
        if arg_idx >= 0 and arg_idx < len(ast_nodes):
            let arg_result: GenTypeResult = compile_expr_textual(g, arg_idx, ast_nodes)
            g = arg_result.gen
            if arg_i > 1:
                args_str = args_str + ", "
            args_str = args_str + arg_result.llvm_type + " " + arg_result.reg
        arg_i = arg_i + 1

    let nr: GenResult = next_reg(g)
    g = nr.gen
    g = emit_raw(g, "  " + nr.reg + " = call i64 @" + fn_name + "(" + args_str + ")\n")

    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_block_textual — block expression (multiple statements)
// ═══════════════════════════════════════════════════════════════════

pub fn compile_block_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let mut g: LlvmGenerator = gen
    var last_reg: String = ""
    var last_ty: String = "i64"

    var stmt_i: Int = 0
    while stmt_i < dlen:
        let stmt_idx: Int = ast_data_get(node, stmt_i)
        if stmt_idx >= 0 and stmt_idx < len(ast_nodes):
            let stmt_node: AstNode = ast_nodes[stmt_idx]
            let stmt_kind: Int = stmt_node.kind

            // If this is a statement kind, compile as statement
            if stmt_kind == AST_STMT_LET or stmt_kind == AST_STMT_RETURN or stmt_kind == AST_STMT_EXPR or stmt_kind == AST_STMT_WHILE:
                g = compile_stmt_textual(g, stmt_idx, ast_nodes, "void")
            else:
                // Expression — compile and capture result
                let expr_result: GenTypeResult = compile_expr_textual(g, stmt_idx, ast_nodes)
                g = expr_result.gen
                last_reg = expr_result.reg
                last_ty = expr_result.llvm_type
        stmt_i = stmt_i + 1

    // If no trailing expression was captured, return dummy
    if last_reg == "":
        let nr: GenResult = next_reg(g)
        g = nr.gen
        g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0\n")
        return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

    return GenTypeResult { gen: g, reg: last_reg, llvm_type: last_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_struct_lit_textual — alloca + gep + store chain
// ═══════════════════════════════════════════════════════════════════

pub fn compile_struct_lit_textual(gen: LlvmGenerator,
                                   node: AstNode,
                                   ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let struct_name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let struct_name: String = "%" + str(struct_name_idx)

    // Allocate
    let alloca_nr: GenResult = next_reg(gen)
    let mut g: LlvmGenerator = alloca_nr.gen
    let alloca_reg: String = alloca_nr.reg
    g = emit_raw(g, "  " + alloca_reg + " = alloca " + struct_name + ", align 8\n")

    // Store fields via GEP
    var field_i: Int = 1
    var gep_idx: Int = 0
    while field_i < dlen:
        let field_val_idx: Int = ast_data_get(node, field_i)
        let field_result: GenTypeResult = compile_expr_textual(g, field_val_idx, ast_nodes)
        g = field_result.gen

        // GEP to field
        let gep_nr: GenResult = next_reg(g)
        g = gep_nr.gen
        g = emit_raw(g, "  " + gep_nr.reg + " = getelementptr inbounds " + struct_name + ", ptr " + alloca_reg + ", i32 0, i32 " + str(gep_idx) + "\n")

        // Store
        g = emit_raw(g, "  store " + field_result.llvm_type + " " + field_result.reg + ", ptr " + gep_nr.reg + ", align 8\n")

        field_i = field_i + 1
        gep_idx = gep_idx + 1

    // Load the struct value
    let load_nr: GenResult = next_reg(g)
    g = load_nr.gen
    g = emit_raw(g, "  " + load_nr.reg + " = load " + struct_name + ", ptr " + alloca_reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: load_nr.reg, llvm_type: struct_name }

// ═══════════════════════════════════════════════════════════════════
// compile_field_access_textual — GEP + load for field access
// ═══════════════════════════════════════════════════════════════════

pub fn compile_field_access_textual(gen: LlvmGenerator,
                                     node: AstNode,
                                     ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let obj_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let field_name_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    // Compile object expression (must evaluate to a struct pointer or value)
    let obj_result: GenTypeResult = compile_expr_textual(gen, obj_idx, ast_nodes)
    let mut g: LlvmGenerator = obj_result.gen
    let obj_reg: String = obj_result.reg
    let obj_ty: String = obj_result.llvm_type

    // GEP to field 0 (simplified — real impl uses field name to index)
    let gep_nr: GenResult = next_reg(g)
    g = gep_nr.gen
    g = emit_raw(g, "  " + gep_nr.reg + " = getelementptr inbounds " + obj_ty + ", ptr " + obj_reg + ", i32 0, i32 0\n")

    // Load field value
    let load_nr: GenResult = next_reg(g)
    g = load_nr.gen
    g = emit_raw(g, "  " + load_nr.reg + " = load i64, ptr " + gep_nr.reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: load_nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_assign_textual — store into local variable
// ═══════════════════════════════════════════════════════════════════

pub fn compile_assign_textual(gen: LlvmGenerator,
                               node: AstNode,
                               ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let target_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let value_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    let var_name: String = "v_" + str(target_idx)
    let alloca_reg: String = locals_get_reg(gen, var_name)

    // Compile value
    let val_result: GenTypeResult = compile_expr_textual(gen, value_idx, ast_nodes)
    let mut g: LlvmGenerator = val_result.gen
    let val_reg: String = val_result.reg
    let val_ty: String = val_result.llvm_type

    if alloca_reg != "":
        g = emit_raw(g, "  store " + val_ty + " " + val_reg + ", ptr " + alloca_reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: val_reg, llvm_type: val_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_ref_textual — reference to local variable (return alloca ptr)
// ═══════════════════════════════════════════════════════════════════

pub fn compile_ref_textual(gen: LlvmGenerator,
                            node: AstNode,
                            ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let target_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let var_name: String = "v_" + str(target_idx)
    let alloca_reg: String = locals_get_reg(gen, var_name)

    if alloca_reg != "":
        return GenTypeResult { gen: gen, reg: alloca_reg, llvm_type: "ptr" }

    // Fallback: null pointer
    let nr: GenResult = next_reg(gen)
    let g: LlvmGenerator = nr.gen
    g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0\n")
    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "ptr" }

// ═══════════════════════════════════════════════════════════════════
// compile_deref_textual — load from pointer
// ═══════════════════════════════════════════════════════════════════

pub fn compile_deref_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let ptr_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let ptr_result: GenTypeResult = compile_expr_textual(gen, ptr_idx, ast_nodes)
    let mut g: LlvmGenerator = ptr_result.gen
    let ptr_reg: String = ptr_result.reg

    let load_nr: GenResult = next_reg(g)
    g = load_nr.gen
    g = emit_raw(g, "  " + load_nr.reg + " = load i64, ptr " + ptr_reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: load_nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_cast_textual — type cast via bitcast/trunc/sext/sitofp
// ═══════════════════════════════════════════════════════════════════

pub fn compile_cast_textual(gen: LlvmGenerator,
                             node: AstNode,
                             ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let expr_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1

    let expr_result: GenTypeResult = compile_expr_textual(gen, expr_idx, ast_nodes)
    let mut g: LlvmGenerator = expr_result.gen
    let expr_reg: String = expr_result.reg
    let expr_ty: String = expr_result.llvm_type

    let nr: GenResult = next_reg(g)
    g = nr.gen
    // Default: bitcast to i64
    g = emit_raw(g, "  " + nr.reg + " = bitcast " + expr_ty + " " + expr_reg + " to i64\n")

    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_while_textual — while loop with header/body/exit blocks
// ═══════════════════════════════════════════════════════════════════

pub fn compile_while_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let cond_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let body_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    // Labels
    let header_lbl_res: GenResult = next_label(gen)
    let mut g: LlvmGenerator = header_lbl_res.gen
    let header_lbl: String = header_lbl_res.reg

    let body_lbl_res: GenResult = next_label(g)
    g = body_lbl_res.gen
    let body_lbl: String = body_lbl_res.reg

    let exit_lbl_res: GenResult = next_label(g)
    g = exit_lbl_res.gen
    let exit_lbl: String = exit_lbl_res.reg

    // Push loop context
    g = loop_push(g, header_lbl, exit_lbl)

    let saved_indent: Int = g.indent_level

    // Branch to header
    g = emit_raw(g, "  br label %" + header_lbl + "\n")

    // Header: check condition
    g.indent_level = saved_indent
    g = emit_raw(g, header_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let cond_result: GenTypeResult = compile_expr_textual(g, cond_idx, ast_nodes)
    g = cond_result.gen
    let cond_reg: String = cond_result.reg

    // Convert to i1 if needed
    var branch_cond: String = cond_reg
    if cond_result.llvm_type != "i1":
        let conv_nr: GenResult = next_reg(g)
        g = conv_nr.gen
        g = emit_raw(g, "  " + conv_nr.reg + " = icmp ne " + cond_result.llvm_type + " " + cond_reg + ", 0\n")
        branch_cond = conv_nr.reg

    g = emit_raw(g, "  br i1 " + branch_cond + ", label %" + body_lbl + ", label %" + exit_lbl + "\n")

    // Body
    g.indent_level = saved_indent
    g = emit_raw(g, body_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let body_result: GenTypeResult = compile_expr_textual(g, body_idx, ast_nodes)
    g = body_result.gen
    g = emit_raw(g, "  br label %" + header_lbl + "\n")

    // Exit
    g.indent_level = saved_indent
    g = emit_raw(g, exit_lbl + ":\n")
    g = loop_pop(g)

    g.indent_level = saved_indent + 1
    let nr: GenResult = next_reg(g)
    g = nr.gen
    g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0\n")

    g.indent_level = saved_indent
    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_return_textual — ret instruction
// ═══════════════════════════════════════════════════════════════════

pub fn compile_return_textual(gen: LlvmGenerator,
                               node: AstNode,
                               ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let val_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1

    if val_idx < 0 or val_idx >= len(ast_nodes):
        let mut g: LlvmGenerator = gen
        g = emit_raw(g, "  ret void\n")
        return GenTypeResult { gen: g, reg: "", llvm_type: "void" }

    let val_result: GenTypeResult = compile_expr_textual(gen, val_idx, ast_nodes)
    let mut g2: LlvmGenerator = val_result.gen
    g2 = emit_raw(g2, "  ret " + val_result.llvm_type + " " + val_result.reg + "\n")

    return GenTypeResult { gen: g2, reg: val_result.reg, llvm_type: val_result.llvm_type }

// ═══════════════════════════════════════════════════════════════════
// PATH B: LLVM-C API Codegen (in-memory IR construction)
// ═══════════════════════════════════════════════════════════════════

pub fn codegen_llvm_c(program: MonomorphizedProgram) -> LLVMModuleRef with Unsafe:
    let ctx: LLVMContextRef = llvm_context_create()
    let mod_ref: LLVMModuleRef = llvm_module_create_with_name("kainc_module", ctx)

    let triple: String = target_triple_for_platform()
    llvm_set_target(mod_ref, triple)
    llvm_set_data_layout(mod_ref, data_layout_string())

    let builder: LLVMBuilderRef = llvm_builder_create(ctx)

    // Compile each function (Path B: stub — delegates to Path A for body)
    var i: Int = 0
    while i < len(program.items):
        let item: TypedItem = program.items[i]
        if item.kind == AST_ITEM_FUNCTION:
            let ret_ty: LLVMTypeRef = llvm_int64_type(ctx)
            let fn_type: LLVMTypeRef = llvm_function_type(ret_ty, [], false)
            let fn_val: LLVMValueRef = llvm_add_function(mod_ref, item.name, fn_type)
            let bb: LLVMBasicBlockRef = llvm_append_basic_block_in_context(ctx, fn_val, "entry")
            llvm_position_at_end(builder, bb)
            let zero_val: LLVMValueRef = llvm_const_int(ret_ty, 0, false)
            llvm_build_ret(builder, zero_val)
        i = i + 1

    let is_valid: Bool = llvm_verify_module(mod_ref, LLVM_RETURN_STATUS_ACTION)
    llvm_builder_dispose(builder)

    return mod_ref

// ═══════════════════════════════════════════════════════════════════
// codegen_compile — main entry: dispatches to Path A or Path B
// ═══════════════════════════════════════════════════════════════════

pub fn codegen_compile(program: MonomorphizedProgram,
                        target: String,
                        output_path: String) -> String with IO:
    let triple: String = target_triple_for_platform()

    // Path A: textual .ll emission (always available)
    let llvm_text: String = codegen_textual(program, triple, false)

    if output_path != "":
        cg_write_text(output_path, llvm_text)
        println("[codegen] Wrote " + str(len(llvm_text)) + " bytes to " + output_path)

    return llvm_text

// ═══════════════════════════════════════════════════════════════════
// Utility: fs_write_text (thin wrapper)
// ═══════════════════════════════════════════════════════════════════

pub fn cg_write_text(path: String, content: String) with IO:
    let msg: String = "[codegen] write to " + path + " (" + str(len(content)) + " bytes)"
    println(msg)

// ═══════════════════════════════════════════════════════════════════
