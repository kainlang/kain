// main.kn — Entry point for the Kain Self-Host Compiler (kainc)
// STREAM: GOLF
//
// Wires the CLI argument parser to the subcommand dispatcher.
// All heavy lifting is delegated to subcommand handlers in cli.kn,
// which route through CHARLIE's orchestrator entry points.

use std::process

// ── Forward type declarations (resolved at ouroboros combine time) ──
pub struct CliConfig:
    subcommand:       Int
    input_path:       String
    target:           String
    profile:          String
    json_output:      Bool
    json_out_path:    String
    verbose:          Bool
    debug_info:       Bool
    verify_ouroboros: Bool
    stage:            String
    extra_args:       Array<String>

// ── Stub functions (real implementations in cli.kn) ──
pub fn parse_args(args: Array<String>) -> CliConfig:
    return CliConfig {
        subcommand: 10, input_path: ".", target: "llvm", profile: "debug",
        json_output: false, json_out_path: "", verbose: false,
        debug_info: false, verify_ouroboros: false, stage: "",
        extra_args: [],
    }

pub fn run_subcommand(config: CliConfig) -> Int with IO:
    println("kainc 0.1.0-alpha")
    return 0

// ── Version constant ──
pub const VERSION: String = "0.1.0-alpha"
pub const BUILD_DATE: String = "2026-06-12"

// ── Entry Point ──

pub fn main() -> Int with IO:
    // Parse command-line arguments
    let args: Array<String> = process_args()
    let config: CliConfig = parse_args(args)

    // Dispatch to the appropriate subcommand handler
    return run_subcommand(config)

// ── Public utilities accessible from the CLI ──

pub fn version_string() -> String:
    return "kainc " + VERSION + " (" + BUILD_DATE + ")"

pub fn print_banner() with IO:
    println(version_string())
    println("Self-Host Kain Compiler — LLVM native codegen")
    println("Target: x86_64-pc-windows-msvc")
