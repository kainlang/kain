// types.kn — Type system core: ResolvedType, TypeEnv, 4-pass pipeline
// STREAM: FOXTROT
// Consumed by: GOLF (codegen)
//
// Defines the 20 ResolvedType variants, the TypeEnv, the 4-pass typecheck
// pipeline (predeclare→register→re-register→check), the central
// types_compatible() decision tree, expression inference, and stub strategy
// for Layers 1-7 constructs.

use effects

// ═══════════════════════════════════════════════════════════════════
// ResolvedType kind constants (20 variants)
// ═══════════════════════════════════════════════════════════════════

pub const RT_UNIT:     Int = 0
pub const RT_BOOL:     Int = 1
pub const RT_INT:      Int = 2
pub const RT_FLOAT:    Int = 3
pub const RT_STRING:   Int = 4
pub const RT_CHAR:     Int = 5
pub const RT_ARRAY:    Int = 6
pub const RT_SLICE:    Int = 7
pub const RT_TUPLE:    Int = 8
pub const RT_REF:      Int = 9
pub const RT_PTR:      Int = 10
pub const RT_OPTION:   Int = 11
pub const RT_RESULT:   Int = 12
pub const RT_FUTURE:   Int = 13
pub const RT_STRUCT:   Int = 14
pub const RT_ENUM:     Int = 15
pub const RT_FUNCTION: Int = 16
pub const RT_GENERIC:  Int = 17
pub const RT_NEVER:    Int = 18
pub const RT_UNKNOWN:  Int = 19

pub const RT_COUNT:    Int = 20

// ── ResolvedType kind name lookup ──
pub fn rt_kind_name(kind: Int) -> String:
    if kind == RT_UNIT:     return "Unit"
    if kind == RT_BOOL:     return "Bool"
    if kind == RT_INT:      return "Int"
    if kind == RT_FLOAT:    return "Float"
    if kind == RT_STRING:   return "String"
    if kind == RT_CHAR:     return "Char"
    if kind == RT_ARRAY:    return "Array"
    if kind == RT_SLICE:    return "Slice"
    if kind == RT_TUPLE:    return "Tuple"
    if kind == RT_REF:      return "Ref"
    if kind == RT_PTR:      return "Ptr"
    if kind == RT_OPTION:   return "Option"
    if kind == RT_RESULT:   return "Result"
    if kind == RT_FUTURE:   return "Future"
    if kind == RT_STRUCT:   return "Struct"
    if kind == RT_ENUM:     return "Enum"
    if kind == RT_FUNCTION: return "Function"
    if kind == RT_GENERIC:  return "Generic"
    if kind == RT_NEVER:    return "Never"
    if kind == RT_UNKNOWN:  return "Unknown"
    return "?"

// ═══════════════════════════════════════════════════════════════════
// ResolvedType struct — flat representation with integer indices
// ═══════════════════════════════════════════════════════════════════

pub struct ResolvedType:
    kind:          Int       // RT_* discriminant
    int_size:      Int       // RT_INT: 1=I8,2=I16,4=I32,8=I64; positive=signed, negative=unsigned
    float_size:    Int       // RT_FLOAT: 4=F32, 8=F64
    name:          Int       // RT_STRUCT/RT_ENUM/RT_GENERIC: string table index
    inner_type:    Int       // compound inner type index into TypeEnv.all_types (-1 if none)
    array_len:     Int       // RT_ARRAY: compile-time constant length
    tuple_types:   Int       // RT_TUPLE: index into TypeEnv.all_types (start of element types)
    tuple_len:     Int       // RT_TUPLE: number of elements
    result_ok:     Int       // RT_RESULT: ok type index
    result_err:    Int       // RT_RESULT: err type index
    fn_params:     Int       // RT_FUNCTION: start index in TypeEnv.all_types
    fn_param_count: Int      // RT_FUNCTION: number of parameters
    fn_ret:        Int       // RT_FUNCTION: return type index
    fn_effects:    Int       // RT_FUNCTION: effect bitmask
    ref_mutable:   Bool      // RT_REF/RT_PTR: mutability flag

// ── Zero-initialized ResolvedType (RT_UNKNOWN) ──
pub fn rt_zero() -> ResolvedType:
    return ResolvedType {
        kind: RT_UNKNOWN, int_size: 0, float_size: 0, name: -1,
        inner_type: -1, array_len: 0, tuple_types: -1, tuple_len: 0,
        result_ok: -1, result_err: -1,
        fn_params: -1, fn_param_count: 0, fn_ret: -1, fn_effects: 0,
        ref_mutable: false,
    }

// ── Constructors for common primitive types ──
pub fn rt_unit() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_UNIT
    return t

pub fn rt_bool() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_BOOL
    return t

pub fn rt_int(size: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_INT
    t.int_size = size
    return t

pub fn rt_i64() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_INT
    t.int_size = 8
    return t

pub fn rt_float(size: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_FLOAT
    t.float_size = size
    return t

pub fn rt_f64() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_FLOAT
    t.float_size = 8
    return t

pub fn rt_string() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_STRING
    return t

pub fn rt_char() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_CHAR
    return t

pub fn rt_unknown() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_UNKNOWN
    return t

pub fn rt_never() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_NEVER
    return t

pub fn rt_struct(name: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_STRUCT
    t.name = name
    return t

pub fn rt_enum(name: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_ENUM
    t.name = name
    return t

pub fn rt_generic(name: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_GENERIC
    t.name = name
    return t

// ── Constructor helpers for compound types ──
pub fn rt_array(inner_idx: Int, len_val: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_ARRAY
    t.inner_type = inner_idx
    t.array_len = len_val
    return t

pub fn rt_slice(inner_idx: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_SLICE
    t.inner_type = inner_idx
    return t

pub fn rt_option(inner_idx: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_OPTION
    t.inner_type = inner_idx
    return t

pub fn rt_result(ok_idx: Int, err_idx: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_RESULT
    t.result_ok = ok_idx
    t.result_err = err_idx
    return t

pub fn rt_future(inner_idx: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_FUTURE
    t.inner_type = inner_idx
    return t

pub fn rt_ref(inner_idx: Int, is_mut: Bool) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_REF
    t.inner_type = inner_idx
    t.ref_mutable = is_mut
    return t

pub fn rt_ptr(inner_idx: Int, is_mut: Bool) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_PTR
    t.inner_type = inner_idx
    t.ref_mutable = is_mut
    return t

// ═══════════════════════════════════════════════════════════════════
// TypeEnv — the type environment
// ═══════════════════════════════════════════════════════════════════
//
// Uses parallel arrays (no HashMap) for bootstrap compatibility.
// all_types + all_type_names: flat registry of all resolved types indexed by Int.
// type_names + type_defs: named type declarations (struct, enum).
// value_names + value_types: variable bindings in current scope chain.
// scopes: stack of start indices into value arrays. pop_scope truncates.

pub struct TypeEnv:
    // Named type declarations
    type_names:        Array<String>
    type_defs:         Array<ResolvedType>

    // Flat type registry (index-based references for compound types)
    all_types:         Array<ResolvedType>
    all_type_names:    Array<String>

    // Value bindings (variables in scope)
    value_names:       Array<String>
    value_types:       Array<ResolvedType>

    // Scope stack: each entry is the start index in value_names (pre-scope length)
    scopes:            Array<Int>

    // Enum variant registry: enum_name_idx → (variant_name → payload_type)
    enum_names:        Array<Int>
    enum_variants:     Array<Array<Int>>    // parallel: variant name indices per enum
    enum_variant_types: Array<Array<ResolvedType>>

    // Current function effects for call-site checking
    current_effects:   Int

    // Skip vectors for 4-pass pipeline
    skip_2:            Array<Bool>
    skip_3:            Array<Bool>

    // Error accumulation
    errors:            KcDiagnosticBag

// ── Create a fresh TypeEnv with pre-registered primitive types ──
pub fn type_env_new() -> TypeEnv:
    let mut env: TypeEnv = TypeEnv {
        type_names:        [],
        type_defs:         [],
        all_types:         [],
        all_type_names:    [],
        value_names:       [],
        value_types:       [],
        scopes:            [],
        enum_names:        [],
        enum_variants:     [],
        enum_variant_types: [],
        current_effects:   effects::EFF_PURE,
        skip_2:            [],
        skip_3:            [],
        errors:            kc_diag_bag_new(),
    }

    // Push initial (global) scope
    env.scopes.push(0)

    // Pre-register primitive types
    env = register_type(env, "Unit", rt_unit())
    env = register_type(env, "Bool", rt_bool())
    env = register_type(env, "Int", rt_int(8))
    env = register_type(env, "I8", rt_int(1))
    env = register_type(env, "I16", rt_int(2))
    env = register_type(env, "I32", rt_int(4))
    env = register_type(env, "I64", rt_int(8))
    env = register_type(env, "I128", rt_int(16))
    env = register_type(env, "Isize", rt_int(8))
    env = register_type(env, "U8", rt_int(-1))
    env = register_type(env, "U16", rt_int(-2))
    env = register_type(env, "U32", rt_int(-4))
    env = register_type(env, "U64", rt_int(-8))
    env = register_type(env, "U128", rt_int(-16))
    env = register_type(env, "Usize", rt_int(-8))
    env = register_type(env, "UInt", rt_int(-8))
    env = register_type(env, "Float", rt_float(8))
    env = register_type(env, "F32", rt_float(4))
    env = register_type(env, "F64", rt_float(8))
    env = register_type(env, "String", rt_string())
    env = register_type(env, "Char", rt_char())

    return env

// ── Register a type in the all_types flat array, return updated env ──
pub fn register_type(env: TypeEnv, name: String, ty: ResolvedType) -> TypeEnv:
    let mut new_env: TypeEnv = env
    new_env.all_types.push(ty)
    new_env.all_type_names.push(name)
    return new_env

// ── Look up a named type in the type registry ──
pub fn lookup_type(env: TypeEnv, name: String) -> ResolvedType:
    var i: Int = 0
    while i < len(env.all_type_names):
        if env.all_type_names[i] == name:
            return env.all_types[i]
        i = i + 1
    return rt_unknown()

// ── Look up a named type index ──
pub fn lookup_type_idx(env: TypeEnv, name: String) -> Int:
    var i: Int = 0
    while i < len(env.all_type_names):
        if env.all_type_names[i] == name:
            return i
        i = i + 1
    return -1

// ── Get type by index from all_types ──
pub fn type_env_get(env: TypeEnv, idx: Int) -> ResolvedType:
    if idx < 0 or idx >= len(env.all_types):
        return rt_unknown()
    return env.all_types[idx]

// ── Declare a named type (struct/enum) ──
pub fn declare_named_type(env: TypeEnv, name: String, ty: ResolvedType) -> TypeEnv:
    let mut new_env: TypeEnv = env
    new_env.type_names.push(name)
    new_env.type_defs.push(ty)
    // Also register in all_types
    new_env = register_type(new_env, name, ty)
    return new_env

// ── Look up a named type declaration ──
pub fn lookup_named_type(env: TypeEnv, name: String) -> ResolvedType:
    var i: Int = 0
    while i < len(env.type_names):
        if env.type_names[i] == name:
            return env.type_defs[i]
        i = i + 1
    return rt_unknown()

// ── Push a new scope ──
pub fn push_scope(env: TypeEnv) -> TypeEnv:
    let mut new_env: TypeEnv = env
    new_env.scopes.push(len(new_env.value_names))
    return new_env

// ── Pop current scope (remove its bindings) ──
pub fn pop_scope(env: TypeEnv) -> TypeEnv:
    let mut new_env: TypeEnv = env
    if len(new_env.scopes) <= 1:
        return new_env
    let scope_start: Int = new_env.scopes[len(new_env.scopes) - 1]
    // Truncate value arrays back to scope_start
    // Kain arrays have `truncate` or we rebuild. Use `pop` in a loop.
    var pop_count: Int = len(new_env.value_names) - scope_start
    var i: Int = 0
    while i < pop_count:
        new_env.value_names.pop()
        new_env.value_types.pop()
        i = i + 1
    new_env.scopes.pop()
    return new_env

// ── Define a variable in the current scope ──
pub fn define_var(env: TypeEnv, name: String, ty: ResolvedType) -> TypeEnv:
    let mut new_env: TypeEnv = env
    new_env.value_names.push(name)
    new_env.value_types.push(ty)
    return new_env

// ── Look up a variable binding (searches scope chain, innermost first) ──
pub fn lookup_var(env: TypeEnv, name: String) -> ResolvedType:
    // Search backwards through value_names (innermost scope = end of array)
    var i: Int = len(env.value_names) - 1
    while i >= 0:
        if env.value_names[i] == name:
            return env.value_types[i]
        i = i - 1
    return rt_unknown()

// ── Add an error to the diagnostic bag ──
pub fn type_error(env: TypeEnv, message: String, kind: String, span_start: Int, span_end: Int) -> TypeEnv:
    let mut new_env: TypeEnv = env
    let d: KcDiagnostic = kc_diagnostic_new(
        SEV_ERROR, "", 0, 0, message, kind, span_start, span_end, ""
    )
    new_env.errors = kc_diag_bag_add_error(new_env.errors, d)
    return new_env

// ═══════════════════════════════════════════════════════════════════
// types_compatible() — THE HEART OF THE TYPECHECKER
// ═══════════════════════════════════════════════════════════════════
//
// Complete pairwise type compatibility covering all 20 ResolvedType variants.
// Takes TypeEnv for resolving compound type indices.

pub fn types_compatible(env: TypeEnv, expected: ResolvedType, actual: ResolvedType) -> Bool:
    // ── Escape valves (leniency) ──
    if expected.kind == RT_UNKNOWN or actual.kind == RT_UNKNOWN:
        return true
    if expected.kind == RT_NEVER or actual.kind == RT_NEVER:
        return true
    if expected.kind == RT_GENERIC or actual.kind == RT_GENERIC:
        return true

    // ── Primitives ──
    if expected.kind == RT_UNIT and actual.kind == RT_UNIT:
        return true
    if expected.kind == RT_BOOL and actual.kind == RT_BOOL:
        return true
    if expected.kind == RT_STRING and actual.kind == RT_STRING:
        return true
    if expected.kind == RT_CHAR and actual.kind == RT_CHAR:
        return true

    // Integer — any sizes cross-compatible
    if expected.kind == RT_INT and actual.kind == RT_INT:
        return true

    // Float — any sizes cross-compatible
    if expected.kind == RT_FLOAT and actual.kind == RT_FLOAT:
        return true

    // Numeric promotion: Int ↔ Float
    let int_to_float: Bool = (expected.kind == RT_INT) and (actual.kind == RT_FLOAT)
    let float_to_int: Bool = (expected.kind == RT_FLOAT) and (actual.kind == RT_INT)
    if int_to_float or float_to_int:
        return true

    // ── Array ──
    if expected.kind == RT_ARRAY and actual.kind == RT_ARRAY:
        // Length must match, or either zero (unknown length)
        if expected.array_len != 0 and actual.array_len != 0:
            if expected.array_len != actual.array_len:
                return false
        return types_compatible(env, type_env_get(env, expected.inner_type),
                                type_env_get(env, actual.inner_type))

    // ── Slice ──
    if expected.kind == RT_SLICE and actual.kind == RT_SLICE:
        return types_compatible(env, type_env_get(env, expected.inner_type),
                                type_env_get(env, actual.inner_type))

    // Slice from Array (or Array from Slice)
    if expected.kind == RT_SLICE and actual.kind == RT_ARRAY:
        return types_compatible(env, type_env_get(env, expected.inner_type),
                                type_env_get(env, actual.inner_type))
    if expected.kind == RT_ARRAY and actual.kind == RT_SLICE:
        return types_compatible(env, type_env_get(env, expected.inner_type),
                                type_env_get(env, actual.inner_type))

    // ── Tuple ──
    if expected.kind == RT_TUPLE and actual.kind == RT_TUPLE:
        if expected.tuple_len != actual.tuple_len:
            return false
        var ti: Int = 0
        while ti < expected.tuple_len:
            let et: ResolvedType = type_env_get(env, expected.tuple_types + ti)
            let at: ResolvedType = type_env_get(env, actual.tuple_types + ti)
            if !types_compatible(env, et, at):
                return false
            ti = ti + 1
        return true

    // ── Option<T> ──
    if expected.kind == RT_OPTION and actual.kind == RT_OPTION:
        return types_compatible(env, type_env_get(env, expected.inner_type),
                                type_env_get(env, actual.inner_type))

    // ── Result<T, E> ──
    if expected.kind == RT_RESULT and actual.kind == RT_RESULT:
        let ok_compat: Bool = types_compatible(env, type_env_get(env, expected.result_ok),
                                type_env_get(env, actual.result_ok))
        let err_compat: Bool = types_compatible(env, type_env_get(env, expected.result_err),
                                type_env_get(env, actual.result_err))
        return ok_compat and err_compat

    // ── Future<T> ──
    if expected.kind == RT_FUTURE and actual.kind == RT_FUTURE:
        return types_compatible(env, type_env_get(env, expected.inner_type),
                                type_env_get(env, actual.inner_type))

    // ── References — auto-deref for immutable refs ──
    if expected.kind == RT_REF and !expected.ref_mutable:
        // Expected is an immutable ref: actual must be compatible with the ref's inner
        return types_compatible(env, type_env_get(env, expected.inner_type), actual)
    if actual.kind == RT_REF and !actual.ref_mutable:
        // Actual is an immutable ref: its inner must be compatible with expected
        return types_compatible(env, expected, type_env_get(env, actual.inner_type))

    // Ref ↔ Ref (both mutable or explicit)
    if expected.kind == RT_REF and actual.kind == RT_REF:
        // Mutable expected: actual must also be mutable
        if expected.ref_mutable and !actual.ref_mutable:
            return false
        return types_compatible(env, type_env_get(env, expected.inner_type),
                                type_env_get(env, actual.inner_type))

    // ── Pointers ──
    if expected.kind == RT_PTR and actual.kind == RT_PTR:
        // Mutable expected: actual must also be mutable
        if expected.ref_mutable and !actual.ref_mutable:
            return false
        // Opaque pointer comparison: consider compatible if both are Ptr
        return true

    // Ref ≠ Ptr (deliberately different)
    let ref_to_ptr: Bool = (expected.kind == RT_REF) and (actual.kind == RT_PTR)
    let ptr_to_ref: Bool = (expected.kind == RT_PTR) and (actual.kind == RT_REF)
    if ref_to_ptr or ptr_to_ref:
        return false

    // ── Functions ──
    if expected.kind == RT_FUNCTION and actual.kind == RT_FUNCTION:
        if expected.fn_param_count != actual.fn_param_count:
            return false
        if !types_compatible(env, type_env_get(env, expected.fn_ret),
                             type_env_get(env, actual.fn_ret)):
            return false
        var pi: Int = 0
        while pi < expected.fn_param_count:
            if !types_compatible(env, type_env_get(env, expected.fn_params + pi),
                                 type_env_get(env, actual.fn_params + pi)):
                return false
            pi = pi + 1
        // Note: effects NOT checked here — checked separately at call sites
        return true

    // ── Named types — nominal matching ──
    if expected.kind == RT_STRUCT and actual.kind == RT_STRUCT:
        return expected.name == actual.name
    if expected.kind == RT_ENUM and actual.kind == RT_ENUM:
        return expected.name == actual.name

    // ── Struct/Tuple/Array/Slice cross-compat (dynamic interop) ──
    if expected.kind == RT_STRUCT and (actual.kind == RT_TUPLE or actual.kind == RT_ARRAY or actual.kind == RT_SLICE):
        return true
    if actual.kind == RT_STRUCT and (expected.kind == RT_TUPLE or expected.kind == RT_ARRAY or expected.kind == RT_SLICE):
        return true
    if expected.kind == RT_TUPLE and (actual.kind == RT_ARRAY or actual.kind == RT_SLICE):
        return true
    if actual.kind == RT_TUPLE and (expected.kind == RT_ARRAY or expected.kind == RT_SLICE):
        return true

    // ── Fallthrough: structural equality ──
    return false

// ═══════════════════════════════════════════════════════════════════
// TypedProgram + TypedItem — typechecker output
// ═══════════════════════════════════════════════════════════════════

pub struct TypedProgram:
    items:   Array<TypedItem>
    env:     TypeEnv
    errors:  KcDiagnosticBag

pub struct TypedItem:
    kind:           Int       // AST item kind tag
    name:           String    // item name
    name_idx:       Int       // string table index of name
    resolved_type:  ResolvedType
    ast_index:      Int       // back-reference to AstNode index
    effects:        Int       // effect bitmask
    typed_data:     Array<Int> // extra type data (field types, param types, etc.)

// ── TypedFunction result ──
pub struct TypedFunction:
    ast_index:     Int
    name:          String
    name_idx:      Int
    param_count:   Int
    param_types:   Array<ResolvedType>
    param_names:   Array<String>
    return_type:   ResolvedType
    effects:       Int
    body_typed:    Bool

// ── TypeEnv helpers for skip vectors ──
pub fn init_skip_vectors(env: TypeEnv, count: Int) -> TypeEnv:
    let mut new_env: TypeEnv = env
    var i: Int = 0
    while i < count:
        new_env.skip_2.push(true)
        new_env.skip_3.push(true)
        i = i + 1
    return new_env

// ═══════════════════════════════════════════════════════════════════
// 4-PASS TYPECHECK PIPELINE
// ═══════════════════════════════════════════════════════════════════

pub fn typecheck(env: TypeEnv, program: AstProgram) -> TypedProgram:
    let nodes: Array<AstNode> = program.nodes
    let n: Int = len(nodes)

    // Initialize skip vectors: all items start as "passed"
    var env1: TypeEnv = init_skip_vectors(env, n)

    // PASS 1: Predeclare type names
    env1 = pass1_predeclare(env1, nodes)

    // PASS 2: Register field/variant/method types
    env1 = pass2_register(env1, nodes)

    // PASS 3: Re-register for forward references
    env1 = pass3_re_register(env1, nodes)

    // PASS 4: Full expression typecheck
    let items: Array<TypedItem> = pass4_check(env1, nodes)

    return TypedProgram {
        items: items,
        env: env1,
        errors: env1.errors,
    }

// ── PASS 1: Predeclare type names ──
pub fn pass1_predeclare(env: TypeEnv, nodes: Array<AstNode>) -> TypeEnv:
    let mut env1: TypeEnv = env
    var i: Int = 0
    while i < len(nodes):
        let node: AstNode = nodes[i]
        let kind: Int = node.kind

        if kind == AST_ITEM_STRUCT:
            let name_idx: Int = ast_data_get(node, 0)
            let name: String = "struct_" + str(name_idx)
            let shell: ResolvedType = rt_struct(name_idx)
            env1 = declare_named_type(env1, name, shell)

        elif kind == AST_ITEM_ENUM:
            let name_idx: Int = ast_data_get(node, 0)
            let name: String = "enum_" + str(name_idx)
            let shell: ResolvedType = rt_enum(name_idx)
            env1 = declare_named_type(env1, name, shell)

        elif kind == AST_ITEM_TRAIT:
            // Stub: just record the trait name exists
            let name_idx: Int = ast_data_get(node, 0)
            let name: String = "trait_" + str(name_idx)
            // Register as a special "trait" marker type
            let shell: ResolvedType = rt_struct(name_idx)
            env1 = declare_named_type(env1, name, shell)

        // ── Stub strategy: predeclare Layer 1-7 constructs as Struct shells ──
        elif kind == AST_ITEM_WORLD or kind == AST_ITEM_ACTOR or kind == AST_ITEM_COMPONENT:
            let name_idx: Int = ast_data_get(node, 0)
            let name: String = "stub_" + str(name_idx)
            let shell: ResolvedType = rt_struct(name_idx)
            env1 = declare_named_type(env1, name, shell)

        i = i + 1

    return env1

// ── PASS 2: Resolve field/variant/method types ──
pub fn pass2_register(env: TypeEnv, nodes: Array<AstNode>) -> TypeEnv:
    let mut env2: TypeEnv = env
    var i: Int = 0
    while i < len(nodes):
        let node: AstNode = nodes[i]
        let kind: Int = node.kind

        if kind == AST_ITEM_STRUCT:
            // Try to resolve field types. If any fail, mark skip_2[i] = false
            // For now: all structs pass (fields resolved in pass 4)
            env2.skip_2[i] = true

        elif kind == AST_ITEM_ENUM:
            // Try to resolve variant payload types
            env2.skip_2[i] = true

        elif kind == AST_ITEM_TRAIT or kind == AST_ITEM_IMPL:
            env2.skip_2[i] = true

        elif kind == AST_ITEM_FUNCTION:
            // try to resolve param/return types
            env2.skip_2[i] = true

        // ── Stub: Layer 1-7 items always pass Pass 2 ──
        elif kind == AST_ITEM_PATCH:
            env2.skip_2[i] = true
        elif kind == AST_ITEM_LAW:
            env2.skip_2[i] = true
        elif kind == AST_ITEM_CONVERGE:
            env2.skip_2[i] = true
        elif kind == AST_ITEM_ORCHESTRATE:
            env2.skip_2[i] = true
        elif kind == AST_ITEM_PULSE:
            env2.skip_2[i] = true
        elif kind == AST_ITEM_RESONATE:
            env2.skip_2[i] = true
        elif kind == AST_ITEM_AXIOM:
            env2.skip_2[i] = true

        elif kind == AST_ITEM_WORLD or kind == AST_ITEM_ACTOR or kind == AST_ITEM_COMPONENT:
            env2.skip_2[i] = true

        i = i + 1

    return env2

// ── PASS 3: Single retry for forward references ──
pub fn pass3_re_register(env: TypeEnv, nodes: Array<AstNode>) -> TypeEnv:
    let mut env3: TypeEnv = env
    var i: Int = 0
    while i < len(nodes):
        if !env3.skip_2[i]:
            env3.skip_3[i] = false
        i = i + 1
    return env3

// ── PASS 4: Full expression typecheck ──
pub fn pass4_check(env: TypeEnv, nodes: Array<AstNode>) -> Array<TypedItem>:
    let mut items: Array<TypedItem> = []
    let mut env4: TypeEnv = env
    var i: Int = 0
    while i < len(nodes):
        if env4.skip_2[i] and env4.skip_3[i]:
            let node: AstNode = nodes[i]
            let typed: TypedItem = check_item(env4, node, i)
            items.push(typed)
        i = i + 1
    return items

// ═══════════════════════════════════════════════════════════════════
// check_item() — dispatch on item kind
// ═══════════════════════════════════════════════════════════════════

pub fn check_item(env: TypeEnv, node: AstNode, idx: Int) -> TypedItem:
    let kind: Int = node.kind

    if kind == AST_ITEM_FUNCTION:
        return check_function_item(env, node, idx)
    elif kind == AST_ITEM_STRUCT:
        return check_struct_item(env, node, idx)
    elif kind == AST_ITEM_ENUM:
        return check_enum_item(env, node, idx)
    elif kind == AST_ITEM_CONST:
        return check_const_item(env, node, idx)
    elif kind == AST_ITEM_TYPE_ALIAS:
        return check_type_alias_item(env, node, idx)
    elif kind == AST_ITEM_USE or kind == AST_ITEM_MOD:
        return empty_typed_item(kind, "module_item", idx)
    elif kind == AST_ITEM_TRAIT or kind == AST_ITEM_IMPL:
        return check_trait_impl_item(env, node, idx)
    // ── Stubs for Layer 1-7 ──
    elif kind == AST_ITEM_PATCH or kind == AST_ITEM_LAW:
        return check_patch_law_stub(env, node, idx, kind)
    elif kind == AST_ITEM_CONVERGE:
        return check_converge_stub(env, node, idx)
    elif kind == AST_ITEM_ORCHESTRATE:
        return check_orchestrate_stub(env, node, idx)
    elif kind == AST_ITEM_PULSE or kind == AST_ITEM_RESONATE:
        return check_pulse_resonate_stub(env, node, idx, kind)
    elif kind == AST_ITEM_AXIOM:
        return check_axiom_stub(env, node, idx)
    elif kind == AST_ITEM_WORLD or kind == AST_ITEM_ACTOR or kind == AST_ITEM_COMPONENT:
        return check_world_actor_component_stub(env, node, idx, kind)
    elif kind == AST_ITEM_ENTANGLE:
        return check_entangle_stub(env, node, idx)
    elif kind == AST_ITEM_SHADER:
        return check_shader_stub(env, node, idx)
    else:
        return empty_typed_item(kind, "unknown", idx)

// ── Empty typed item for unhandled/stub items ──
pub fn empty_typed_item(kind: Int, name: String, idx: Int) -> TypedItem:
    return TypedItem {
        kind: kind,
        name: name,
        name_idx: -1,
        resolved_type: rt_unit(),
        ast_index: idx,
        effects: effects::EFF_PURE,
        typed_data: [],
    }

// ── check_function_item: typecheck a fn declaration ──
pub fn check_function_item(env: TypeEnv, node: AstNode, idx: Int) -> TypedItem:
    // Extract function metadata from AstNode data[]
    // data[0] = name string table index
    // data[1] = attributes child index (or -1)
    // data[2] = generic count (G)
    // data[3..3+2*G-1] = generic param pairs
    // data[3+2*G] = parameter count (P)
    // data[3+2*G+1..3+2*G+P] = parameter indices
    // data[3+2*G+P+1] = return_type child index (-1 for inferred)
    // data[3+2*G+P+2] = where_clause child index (-1)
    // data[3+2*G+P+3] = effect count (E)
    // data[3+2*G+P+4..] = effect kind values
    // last data entry = body child index

    let dlen: Int = ast_data_len(node)
    if dlen < 1:
        return TypedItem {
            kind: AST_ITEM_FUNCTION, name: "?fn", name_idx: -1,
            resolved_type: rt_unit(), ast_index: idx,
            effects: effects::EFF_PURE, typed_data: [],
        }

    let name_idx: Int = ast_data_get(node, 0)

    // Parse the function signature
    let generic_count: Int = if dlen > 2: ast_data_get(node, 2) else: 0
    let offset: Int = 3 + (2 * generic_count)

    let param_count: Int = if dlen > offset: ast_data_get(node, offset) else: 0
    let ret_offset: Int = offset + 1 + param_count
    let ret_type_idx: Int = if dlen > ret_offset: ast_data_get(node, ret_offset) else: -1
    let where_offset: Int = ret_offset + 1
    let _where_idx: Int = if dlen > where_offset: ast_data_get(node, where_offset) else: -1
    let eff_offset: Int = where_offset + 1
    let eff_count: Int = if dlen > eff_offset: ast_data_get(node, eff_offset) else: 0

    // Extract effect mask
    let mut effect_mask: Int = effects::EFF_PURE
    var ei: Int = 0
    while ei < eff_count:
        let ekind: Int = if dlen > (eff_offset + 1 + ei): ast_data_get(node, eff_offset + 1 + ei) else: 0
        effect_mask = effect_mask or effect_kind_to_mask(ekind)
        ei = ei + 1

    // Build param types (for now: all I64 since we can't resolve type ASTs deeply)
    let mut param_types: Array<ResolvedType> = []
    let mut param_names: Array<String> = []
    var pi: Int = 0
    while pi < param_count:
        param_types.push(rt_i64())
        param_names.push("p" + str(pi))
        pi = pi + 1

    // Build return type
    let return_type: ResolvedType = if ret_type_idx >= 0:
        rt_i64()  // stub: resolve from type AST node
    else:
        rt_unit()

    // Build the function's resolved type
    let fn_type: ResolvedType = make_function_type(env, param_types, return_type, effect_mask)

    return TypedItem {
        kind: AST_ITEM_FUNCTION,
        name: "fn_" + str(name_idx),
        name_idx: name_idx,
        resolved_type: fn_type,
        ast_index: idx,
        effects: effect_mask,
        typed_data: [],
    }

// ── Helper: convert effect kind int to mask ──
pub fn effect_kind_to_mask(ekind: Int) -> Int:
    if ekind == 0: return effects::EFF_PURE
    if ekind == 1: return effects::EFF_IO
    if ekind == 2: return effects::EFF_GPU
    if ekind == 3: return effects::EFF_ASYNC
    if ekind == 4: return effects::EFF_REACTIVE
    if ekind == 5: return effects::EFF_UNSAFE
    if ekind == 6: return effects::EFF_ALLOC
    if ekind == 7: return effects::EFF_PANIC
    return effects::EFF_PURE

// ── Build a function type from param/return types ──
pub fn make_function_type(env: TypeEnv, param_types: Array<ResolvedType>, return_type: ResolvedType, eff_mask: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_FUNCTION
    t.fn_param_count = len(param_types)
    t.fn_ret = -1  // Will be set after registering return type
    t.fn_effects = eff_mask

    // Register return type
    let mut env_tmp: TypeEnv = env
    env_tmp = register_type(env_tmp, "__fn_ret", return_type)
    t.fn_ret = len(env_tmp.all_types) - 1

    // Register param types (contiguous in all_types)
    if len(param_types) > 0:
        t.fn_params = len(env_tmp.all_types)
        var pi: Int = 0
        while pi < len(param_types):
            env_tmp = register_type(env_tmp, "__fn_param_" + str(pi), param_types[pi])
            pi = pi + 1
    else:
        t.fn_params = -1

    return t

// ── check_struct_item: typecheck a struct declaration ──
pub fn check_struct_item(_env: TypeEnv, node: AstNode, idx: Int) -> TypedItem:
    let dlen: Int = ast_data_len(node)
    let name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    return TypedItem {
        kind: AST_ITEM_STRUCT,
        name: "struct_" + str(name_idx),
        name_idx: name_idx,
        resolved_type: rt_struct(name_idx),
        ast_index: idx,
        effects: effects::EFF_PURE,
        typed_data: [],
    }

