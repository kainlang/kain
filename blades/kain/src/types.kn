// ═══════════════════════════════════════════════════════════════════
// infer_expr_type — basic expression type inference
// ═══════════════════════════════════════════════════════════════════

pub fn infer_expr_type(env: TypeEnv, node: AstNode) -> ResolvedType:
    let kind: Int = node.kind

    if kind == AST_EXPR_INT:
        return rt_i64()
    elif kind == AST_EXPR_FLOAT:
        return rt_f64()
    elif kind == AST_EXPR_STRING or kind == AST_EXPR_FSTRING:
        return rt_string()
    elif kind == AST_EXPR_BOOL:
        return rt_bool()
    elif kind == AST_EXPR_CHAR:
        return rt_char()
    elif kind == AST_EXPR_NONE:
        return rt_option(-1)  // Option(Unknown) — inner type from context
    elif kind == AST_EXPR_IDENT:
        let name_idx: Int = ast_data_get(node, 0)
        return lookup_var(env, "ident_" + str(name_idx))
    elif kind == AST_EXPR_BINARY:
        return infer_binary_type(env, node)
    elif kind == AST_EXPR_UNARY:
        return infer_unary_type(env, node)
    elif kind == AST_EXPR_CALL:
        return infer_call_type(env, node)
    elif kind == AST_EXPR_BLOCK:
        return infer_block_type(env, node)
    elif kind == AST_EXPR_IF:
        return infer_if_type(env, node)
    elif kind == AST_EXPR_ASSIGN:
        return rt_unit()
    elif kind == AST_EXPR_REF:
        return infer_ref_type(env, node)
    elif kind == AST_EXPR_DEREF:
        return infer_deref_type(env, node)
    elif kind == AST_EXPR_ARRAY:
        return infer_array_type(env, node)
    elif kind == AST_EXPR_TUPLE:
        return infer_tuple_type(env, node)
    elif kind == AST_EXPR_STRUCT_LIT:
        return infer_struct_lit_type(env, node)
    elif kind == AST_EXPR_FIELD:
        return infer_field_type(env, node)
    elif kind == AST_EXPR_INDEX:
        return infer_index_type(env, node)
    elif kind == AST_EXPR_CAST:
        return rt_i64()  // stub
    elif kind == AST_EXPR_LAMBDA:
        let param_count: Int = if ast_data_len(node) > 0: ast_data_get(node, 0) else: 0
        return make_lambda_type(env, param_count)
    elif kind == AST_EXPR_METHOD_CALL:
        return infer_method_call_type(env, node)
    elif kind == AST_EXPR_SPAWN or kind == AST_EXPR_SEND:
        return rt_unit()
    elif kind == AST_EXPR_COLLAPSE or kind == AST_EXPR_OBSERVE:
        // Ownership expressions: return the body's type
        let dlen: Int = ast_data_len(node)
        let body_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1
        return rt_i64()
    elif kind == AST_EXPR_DECAY:
        return rt_unit()
    elif kind == AST_EXPR_MATCH:
        return infer_match_type(env, node)
    elif kind == AST_EXPR_RANGE:
        return rt_unknown()
    elif kind == AST_EXPR_ASM:
        return rt_unit()
    elif kind == AST_EXPR_ALLOC or kind == AST_EXPR_ALLOCA:
        return rt_ptr(-1, true)
    elif kind == AST_EXPR_MEM_LOAD:
        return rt_i64()
    elif kind == AST_EXPR_MEM_STORE:
        return rt_unit()
    elif kind == AST_EXPR_PTR_OFFSET:
        return rt_ptr(-1, true)
    elif kind == AST_EXPR_SIZEOF or kind == AST_EXPR_ALIGNOF:
        return rt_i64()
    elif kind == AST_EXPR_BITCAST:
        return rt_i64()
    elif kind == AST_EXPR_PAREN:
        let inner_idx: Int = ast_data_get(node, 0)
        // Would resolve from program, simplified here
        return rt_unknown()
    else:
        return rt_unknown()

// ── infer_binary_type ──
pub fn infer_binary_type(env: TypeEnv, node: AstNode) -> ResolvedType:
    let dlen: Int = ast_data_len(node)
    let op: Int = if dlen > 2: ast_data_get(node, 2) else: 0

    // Comparison / logical operators → Bool
    let is_cmp: Bool = (op == BINOP_EQ) or (op == BINOP_NE) or (op == BINOP_LT) or (op == BINOP_GT)
    let is_cmp2: Bool = (op == BINOP_LE) or (op == BINOP_GE)
    let is_logic: Bool = (op == BINOP_AND) or (op == BINOP_OR)
    if is_cmp or is_cmp2 or is_logic:
        return rt_bool()
    // Arithmetic → Int (or Float)
    return rt_i64()

// ── infer_unary_type ──
pub fn infer_unary_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    let dlen: Int = ast_data_len(node)
    let op: Int = if dlen > 0: ast_data_get(node, 0) else: 0
    if op == UNOP_NOT:
        return rt_bool()
    if op == UNOP_REF or op == UNOP_REF_MUT:
        return rt_ref(-1, op == UNOP_REF_MUT)
    if op == UNOP_DEREF:
        return rt_i64()  // simplified
    return rt_i64()

// ── infer_call_type ──
pub fn infer_call_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    // For now: return I64 for most calls
    return rt_i64()

// ── infer_block_type ──
pub fn infer_block_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    // Block type = type of last expression (or Unit if empty)
    let dlen: Int = ast_data_len(node)
    if dlen > 0:
        let last_child: Int = ast_data_get(node, dlen - 1)
        if last_child >= 0:
            return rt_i64()
    return rt_unit()

// ── infer_if_type ──
pub fn infer_if_type(env: TypeEnv, node: AstNode) -> ResolvedType:
    // if is an expression: unified type of then/else branches
    let dlen: Int = ast_data_len(node)
    let _then_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1
    return rt_i64()

// ── infer_ref_type ──
pub fn infer_ref_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    let dlen: Int = ast_data_len(node)
    let inner_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    return rt_ref(-1, false)

// ── infer_deref_type ──
pub fn infer_deref_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    return rt_i64()

// ── infer_array_type ──
pub fn infer_array_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    let dlen: Int = ast_data_len(node)
    let elem_count: Int = if dlen > 0: ast_data_get(node, 0) else: 0
    return rt_array(-1, elem_count)

// ── infer_tuple_type ──
pub fn infer_tuple_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    let dlen: Int = ast_data_len(node)
    let elem_count: Int = if dlen > 0: ast_data_get(node, 0) else: 0
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_TUPLE
    t.tuple_len = elem_count
    t.tuple_types = -1
    return t

// ── infer_struct_lit_type ──
pub fn infer_struct_lit_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    let name_idx: Int = if ast_data_len(node) > 0: ast_data_get(node, 0) else: -1
    return rt_struct(name_idx)

// ── infer_field_type ──
pub fn infer_field_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    return rt_i64()

// ── infer_index_type ──
pub fn infer_index_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    return rt_i64()

// ── infer_match_type ──
pub fn infer_match_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    return rt_i64()

// ── infer_method_call_type ──
pub fn infer_method_call_type(_env: TypeEnv, node: AstNode) -> ResolvedType:
    return rt_i64()

// ── make_lambda_type ──
pub fn make_lambda_type(env: TypeEnv, param_count: Int) -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_FUNCTION
    t.fn_param_count = param_count
    t.fn_params = -1
    t.fn_ret = -1
    t.fn_effects = effects::EFF_PURE
    return t

