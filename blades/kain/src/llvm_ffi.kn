// ── Helper: resolve LLVM constant enum values at runtime ──
// These are stubs for the textual .ll bootstrap path

pub fn llvm_const(name: String) -> Int:
    if name == "LLVM_ATTR_INDEX_FUNCTION":  return -1
    if name == "LLVM_ATTR_INDEX_RETURN_TYPE": return 0
    if name == "LLVM_ATTR_INDEX_FUNCTION":  return -1
    if name == "LLVM_ATTR_INDEX_PARAM_0":    return 1
    return 0

