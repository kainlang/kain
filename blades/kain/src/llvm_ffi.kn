// ── Builder: Aggregate ──

pub fn llvm_build_extract_value(builder: LLVMBuilderRef, agg: LLVMValueRef,
                                  index: Int,
                                  name: String) -> LLVMValueRef with Unsafe:
    return llvm.LLVMBuildExtractValue(builder, agg, index, name)

pub fn llvm_build_insert_value(builder: LLVMBuilderRef, agg: LLVMValueRef,
                                 val: LLVMValueRef, index: Int,
                                 name: String) -> LLVMValueRef with Unsafe:
    return llvm.LLVMBuildInsertValue(builder, agg, val, index, name)

// ── Global Variables ──

pub fn llvm_add_global(mod_ref: LLVMModuleRef, ty: LLVMTypeRef,
                         name: String) -> LLVMValueRef with Unsafe:
    return llvm.LLVMAddGlobal(mod_ref, ty, name)

pub fn llvm_set_initializer(global: LLVMValueRef,
                              const_val: LLVMValueRef) with Unsafe:
    llvm.LLVMSetInitializer(global, const_val)

pub fn llvm_set_linkage(global: LLVMValueRef, linkage: Int) with Unsafe:
    llvm.LLVMSetLinkage(global, linkage)

pub fn llvm_set_global_constant(global: LLVMValueRef, is_const: Bool) with Unsafe:
    let c: Int = if is_const: 1 else: 0
    llvm.LLVMSetGlobalConstant(global, c)

// ── Function Attributes ──

pub fn llvm_add_function_attr(fn_val: LLVMValueRef, attr: Int) with Unsafe:
    let attr_ref: LLVMAttributeRef = llvm.LLVMCreateEnumAttribute(
        llvm.LLVMGetGlobalContext(), attr, 0)
    llvm.LLVMAddAttributeAtIndex(fn_val,
        llvm_const("LLVM_ATTR_INDEX_FUNCTION"), attr_ref)

// ── Verification ──

pub fn llvm_verify_module(mod_ref: LLVMModuleRef,
                            action: Int) -> Bool with Unsafe:
    let status: Int = llvm.LLVMVerifyModule(mod_ref, action, ptr<Byte>(0))
    return status == 0

pub fn llvm_verify_function(fn_val: LLVMValueRef,
                              action: Int) -> Bool with Unsafe:
    return llvm.LLVMVerifyFunction(fn_val, action) == 1

pub fn llvm_print_module_to_string(mod_ref: LLVMModuleRef) -> String with Unsafe:
    return llvm.LLVMPrintModuleToString(mod_ref)

// ── BitWriter ──

pub fn llvm_write_bitcode_to_file(mod_ref: LLVMModuleRef,
                                    path: String) with Unsafe:
    llvm_bitwriter.LLVMWriteBitcodeToFile(mod_ref, path)

// ── Target Initialization ──

pub fn llvm_initialize_native_target() with Unsafe:
    llvm_target.LLVMInitializeNativeTarget()

pub fn llvm_initialize_native_asm_printer() with Unsafe:
    llvm_target.LLVMInitializeNativeAsmPrinter()

pub fn llvm_initialize_native_disassembler() with Unsafe:
    llvm_target.LLVMInitializeNativeDisassembler()

pub fn llvm_initialize_all_target_infos() with Unsafe:
    llvm_target.LLVMInitializeAllTargetInfos()

pub fn llvm_initialize_all_targets() with Unsafe:
    llvm_target.LLVMInitializeAllTargets()

pub fn llvm_initialize_all_target_mcs() with Unsafe:
    llvm_target.LLVMInitializeAllTargetMCs()

pub fn llvm_initialize_all_asm_printers() with Unsafe:
    llvm_target.LLVMInitializeAllAsmPrinters()

pub fn llvm_initialize_all_disassemblers() with Unsafe:
    llvm_target.LLVMInitializeAllDisassemblers()

// ── Helper: resolve LLVM constant enum values at runtime ──
// These are stubs for the textual .ll bootstrap path

pub fn llvm_const(name: String) -> Int:
    if name == "LLVM_ATTR_INDEX_FUNCTION":  return -1
    if name == "LLVM_ATTR_INDEX_RETURN_TYPE": return 0
    if name == "LLVM_ATTR_INDEX_FUNCTION":  return -1
    if name == "LLVM_ATTR_INDEX_PARAM_0":    return 1
    return 0

// ── Module dump (for debugging) ──

pub fn llvm_dump_module(mod_ref: LLVMModuleRef) with Unsafe:
    llvm.LLVMDumpModule(mod_ref)

// ── Set function calling convention ──

pub fn llvm_set_function_call_conv(fn_val: LLVMValueRef, cc: Int) with Unsafe:
    llvm.LLVMSetFunctionCallConv(fn_val, cc)

