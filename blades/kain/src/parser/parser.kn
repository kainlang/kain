pub fn parse_include(st: ParserState) -> ParseResult:
    let sp: SpanPair = parser_current_span(st)
    let mut cur: ParserState = parser_advance(st)
    var path_idx: Int = -1
    let tok: Token = parser_current(cur)
    if tok.kind == TOKEN_STRING:
        cur = parser_advance(cur)
        let pr: InternResult = parser_intern(cur, tok.literal_string)
        cur = pr.state
        path_idx = pr.index
    elif tok.kind == TOKEN_LT:
        cur = parser_advance(cur)
        var header: String = ""
        while parser_check(cur, TOKEN_GT) == false and parser_current(cur).kind != TOKEN_EOF:
            let ht: Token = parser_current(cur)
            header = header + ht.text
            cur = parser_advance(cur)
        if parser_check(cur, TOKEN_GT):
            cur = parser_advance(cur)
        let pr: InternResult = parser_intern(cur, header)
        cur = pr.state
        path_idx = pr.index
    var alias_idx: Int = -1
    if parser_check(cur, TOKEN_AS):
        cur = parser_advance(cur)
        let at: Token = parser_current(cur)
        if at.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            let ar: InternResult = parser_intern(cur, at.text)
            cur = ar.state
            alias_idx = ar.index
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(path_idx)
    data.push(alias_idx)
    let node: AstNode = ast_new_node(AST_ITEM_IMPORT, sp.start, end_off, data)
    return parser_push_result(cur, node)

pub fn parse_import(st: ParserState) -> ParseResult:
    let sp: SpanPair = parser_current_span(st)
    let mut cur: ParserState = parser_advance(st)
    var path_parts: Array<Int> = []
    let tok: Token = parser_current(cur)
    if tok.kind == TOKEN_IDENT:
        cur = parser_advance(cur)
        let ir: InternResult = parser_intern(cur, tok.text)
        cur = ir.state
        path_parts.push(ir.index)
    var alias_idx: Int = -1
    if parser_check(cur, TOKEN_AS):
        cur = parser_advance(cur)
        let at: Token = parser_current(cur)
        if at.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            let ar: InternResult = parser_intern(cur, at.text)
            cur = ar.state
            alias_idx = ar.index
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(len(path_parts))
    var pi: Int = 0
    while pi < len(path_parts):
        data.push(path_parts[pi])
        pi = pi + 1
    data.push(alias_idx)
    let node: AstNode = ast_new_node(AST_ITEM_IMPORT, sp.start, end_off, data)
    return parser_push_result(cur, node)

pub fn parse_from_import(st: ParserState) -> ParseResult:
    let sp: SpanPair = parser_current_span(st)
    let mut cur: ParserState = parser_advance(st)
    var module_idx: Int = -1
    let mt: Token = parser_current(cur)
    if mt.kind == TOKEN_IDENT:
        cur = parser_advance(cur)
        let mr: InternResult = parser_intern(cur, mt.text)
        cur = mr.state
        module_idx = mr.index
    var import_idx: Int = -1
    if parser_current(cur).kind == TOKEN_IDENT and parser_current(cur).text == "import":
        cur = parser_advance(cur)
        let it: Token = parser_current(cur)
        if it.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            let irr: InternResult = parser_intern(cur, it.text)
            cur = irr.state
            import_idx = irr.index
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(module_idx)
    data.push(import_idx)
    let node: AstNode = ast_new_node(AST_ITEM_IMPORT, sp.start, end_off, data)
    return parser_push_result(cur, node)

// ── Component parser ──

pub fn parse_component(st: ParserState, vis_val: Int, attrs: Array<Int>) -> ParseResult:
    let sp: SpanPair = parser_current_span(st)
    let mut cur: ParserState = parser_advance(st)

    let name_tok: Token = parser_current(cur)
    if name_tok.kind != TOKEN_IDENT:
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let name_ir: InternResult = parser_intern(cur, name_tok.text)
    cur = name_ir.state
    let name_idx: Int = name_ir.index

    var prop_names: Array<Int> = []
    var prop_types: Array<Int> = []
    if parser_check(cur, TOKEN_LPAREN):
        cur = parser_advance(cur)
        while parser_check(cur, TOKEN_RPAREN) == false and parser_current(cur).kind != TOKEN_EOF:
            let pn: Token = parser_current(cur)
            if pn.kind == TOKEN_IDENT:
                cur = parser_advance(cur)
                let pr: InternResult = parser_intern(cur, pn.text)
                cur = pr.state
                prop_names.push(pr.index)
                if parser_check(cur, TOKEN_COLON):
                    cur = parser_advance(cur)
                let pt: ParseResult = parse_type(cur)
                cur = pt.state
                prop_types.push(pt.node)
                if parser_check(cur, TOKEN_COMMA):
                    cur = parser_advance(cur)
            else:
                break
        if parser_check(cur, TOKEN_RPAREN):
            cur = parser_advance(cur)

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(name_idx)
    data.push(len(prop_names))
    var pi: Int = 0
    while pi < len(prop_names):
        data.push(prop_names[pi])
        data.push(prop_types[pi])
        pi = pi + 1
    data.push(body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_COMPONENT, sp.start, end_off, data)
    return parser_push_result(cur, node)

pub fn parse_shader(st: ParserState) -> ParseResult:
    let sp: SpanPair = parser_current_span(st)
    let mut cur: ParserState = parser_advance(st)
    var body_idx: Int = -1
    let kind_tok: Token = parser_current(cur)
    let is_shader_kind: Bool = kind_tok.kind == TOKEN_VERTEX or kind_tok.kind == TOKEN_FRAGMENT or kind_tok.kind == TOKEN_COMPTIME or (kind_tok.kind == TOKEN_IDENT and kind_tok.text == "compute")
    if is_shader_kind:
        cur = parser_advance(cur)
    let name_tok: Token = parser_current(cur)
    if name_tok.kind == TOKEN_IDENT:
        cur = parser_advance(cur)
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node
    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_SHADER, sp.start, end_off, data)
    return parser_push_result(cur, node)

pub fn parse_actor(st: ParserState, vis_val: Int, attrs: Array<Int>) -> ParseResult:
    let sp: SpanPair = parser_current_span(st)
    let mut cur: ParserState = parser_advance(st)

    let name_tok: Token = parser_current(cur)
    if name_tok.kind != TOKEN_IDENT:
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let name_ir: InternResult = parser_intern(cur, name_tok.text)
    cur = name_ir.state
    let name_idx: Int = name_ir.index

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(name_idx)
    data.push(body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_ACTOR, sp.start, end_off, data)
    return parser_push_result(cur, node)

// ═══════════════════════════════════════════════════════════════════════════
// JSX PARSER
// ═══════════════════════════════════════════════════════════════════════════

pub fn parse_jsx_element(st: ParserState) -> ParseResult:
    let sp: SpanPair = parser_current_span(st)
    let mut cur: ParserState = parser_advance(st)

    let tag_tok: Token = parser_current(cur)
    if tag_tok.kind != TOKEN_IDENT:
        cur = parser_error(cur, "expected JSX tag name", ERR_PARSE_EXPECTED_TOKEN,
            tag_tok.byte_offset, tag_tok.byte_offset + len(tag_tok.text))
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let tag_ir: InternResult = parser_intern(cur, tag_tok.text)
    cur = tag_ir.state
    let tag_idx: Int = tag_ir.index

    // Attributes
    var attr_names: Array<Int> = []
    var attr_values: Array<Int> = []
    var attr_loop: Bool = true
    while attr_loop:
        let tkind: Int = parser_current(cur).kind
        if tkind == TOKEN_GT or tkind == TOKEN_SLASH:
            attr_loop = false
            continue
        if tkind == TOKEN_IDENT:
            let aname_tok: Token = parser_current(cur)
            cur = parser_advance(cur)
            let anr: InternResult = parser_intern(cur, aname_tok.text)
            cur = anr.state
            attr_names.push(anr.index)
            if parser_check(cur, TOKEN_EQ):
                cur = parser_advance(cur)
                let aval_tok: Token = parser_current(cur)
                if aval_tok.kind == TOKEN_STRING:
                    cur = parser_advance(cur)
                    let avr: InternResult = parser_intern(cur, aval_tok.literal_string)
                    cur = avr.state
                    attr_values.push(avr.index)
                elif aval_tok.kind == TOKEN_LBRACE:
                    cur = parser_advance(cur)
                    let expr_res: ParseResult = parse_expr(cur)
                    cur = expr_res.state
                    attr_values.push(expr_res.node)
                    if parser_check(cur, TOKEN_RBRACE):
                        cur = parser_advance(cur)
                else:
                    attr_values.push(-1)
            else:
                attr_values.push(-1)
        else:
            cur = parser_advance(cur)

    // Self-closing tag
    var children_idxs: Array<Int> = []
    if parser_check(cur, TOKEN_SLASH):
        cur = parser_advance(cur)
        if parser_check(cur, TOKEN_GT):
            cur = parser_advance(cur)
        let end_off: Int = parser_current(cur).byte_offset
        let mut data: Array<Int> = []
        data.push(tag_idx)
        data.push(len(attr_names))
        var ai: Int = 0
        while ai < len(attr_names):
            data.push(attr_names[ai])
            data.push(attr_values[ai])
            ai = ai + 1
        data.push(0)
        let node: AstNode = ast_new_node(AST_EXPR_JSX, sp.start, end_off, data)
        return parser_push_result(cur, node)

    if parser_check(cur, TOKEN_GT):
        cur = parser_advance(cur)

    // Children
    while parser_current(cur).kind != TOKEN_EOF:
        if parser_check(cur, TOKEN_LT_SLASH):
            break
        let ckind: Int = parser_current(cur).kind
        if ckind == TOKEN_LT:
            let child_res: ParseResult = parse_jsx_element(cur)
            cur = child_res.state
            if child_res.node >= 0:
                children_idxs.push(child_res.node)
        elif ckind == TOKEN_LBRACE:
            cur = parser_advance(cur)
            let expr_res: ParseResult = parse_expr(cur)
            cur = expr_res.state
            if expr_res.node >= 0:
                children_idxs.push(expr_res.node)
            if parser_check(cur, TOKEN_RBRACE):
                cur = parser_advance(cur)
        elif ckind == TOKEN_NEWLINE or ckind == TOKEN_INDENT or ckind == TOKEN_DEDENT:
            cur = parser_advance(cur)
        elif ckind == TOKEN_IDENT or ckind == TOKEN_STRING or ckind == TOKEN_INT:
            let text_tok: Token = parser_current(cur)
            cur = parser_advance(cur)
            let txt: String = text_tok.text
            let tr: InternResult = parser_intern(cur, txt)
            cur = tr.state
            let text_node: AstNode = ast_new_leaf(AST_EXPR_STRING, text_tok.byte_offset,
                text_tok.byte_offset + len(txt), tr.index)
            let tidx: Int = len(cur.program)
            cur.program.push(text_node)
            children_idxs.push(tidx)
        else:
            cur = parser_advance(cur)

    // Closing tag
    if parser_check(cur, TOKEN_LT_SLASH):
        cur = parser_advance(cur)
        let close_tok: Token = parser_current(cur)
        if close_tok.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            if parser_check(cur, TOKEN_GT):
                cur = parser_advance(cur)

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(tag_idx)
    data.push(len(attr_names))
    var aai: Int = 0
    while aai < len(attr_names):
        data.push(attr_names[aai])
        data.push(attr_values[aai])
        aai = aai + 1
    data.push(len(children_idxs))
    var ci: Int = 0
    while ci < len(children_idxs):
        data.push(children_idxs[ci])
        ci = ci + 1
    let node: AstNode = ast_new_node(AST_EXPR_JSX, sp.start, end_off, data)
    return parser_push_result(cur, node)

// ═══════════════════════════════════════════════════════════════════════════
// MISCELLANEOUS HELPERS
// ═══════════════════════════════════════════════════════════════════════════

pub fn node_span_end_prog(prog: Array<AstNode>, node_idx: Int) -> Int:
    return node_span_end(prog, node_idx)

// Missing constants
pub const UNOP_ADD: Int = 6
pub const UNOP_SUB: Int = 7

