    cur = name_ir.state
    let name_idx: Int = name_ir.index

    var aliased_idx: Int = -1
    if parser_check(cur, TOKEN_EQ):
        cur = parser_advance(cur)
        let ty_res: ParseResult = parse_type(cur)
        cur = ty_res.state
        aliased_idx = ty_res.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(name_idx)
    data.push(aliased_idx)
    let node: AstNode = ast_new_node(AST_ITEM_TYPE_ALIAS, sp.start, end_off, data)
    return parser_push_result(cur, node)

pub fn parse_use(st: ParserState) -> ParseResult:
    let sp: SpanPair = parser_current_span(st)
    let mut cur: ParserState = parser_advance(st)
    var segments: Array<Int> = []
    var looping: Bool = true
    while looping:
        let seg_tok: Token = parser_current(cur)
        if seg_tok.kind == TOKEN_IDENT:
            cur = parser_advance(cur)
            let sr: InternResult = parser_intern(cur, seg_tok.text)
            cur = sr.state
            segments.push(sr.index)
        elif seg_tok.kind == TOKEN_SELF_LOWER:
            cur = parser_advance(cur)
            let sr: InternResult = parser_intern(cur, "self")
            cur = sr.state
            segments.push(sr.index)
        else:
            looping = false
            continue
        if parser_check(cur, TOKEN_COLON_COLON):
            cur = parser_advance(cur)
        else:
            looping = false

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(len(segments))
    var si: Int = 0
    while si < len(segments):
        data.push(segments[si])
        si = si + 1
    let node: AstNode = ast_new_node(AST_ITEM_USE, sp.start, end_off, data)
    return parser_push_result(cur, node)

