// ═══════════════════════════════════════════════════════════════════════════
// CONTEXTUAL ITEM PARSERS (patch, law, converge, world, etc.)
// ═══════════════════════════════════════════════════════════════════════════

pub fn parse_patch_item(st: ParserState, vis_val: Int, attrs: Array<Int>) -> ParseResult:
    let sp: SpanPair = parser_current_span(st)
    let mut cur: ParserState = parser_advance(st)

    let name_tok: Token = parser_current(cur)
    if name_tok.kind != TOKEN_IDENT:
        cur = parser_synchronize(cur)
        return ParseResult { state: cur, node: -1 }
    cur = parser_advance(cur)
    let name_ir: InternResult = parser_intern(cur, name_tok.text)
    cur = name_ir.state
    let name_idx: Int = name_ir.index

    var param_names: Array<Int> = []
    var param_types: Array<Int> = []
    if parser_check(cur, TOKEN_LPAREN):
        cur = parser_advance(cur)
        while parser_check(cur, TOKEN_RPAREN) == false and parser_current(cur).kind != TOKEN_EOF:
            let pn: Token = parser_current(cur)
            if pn.kind == TOKEN_IDENT:
                cur = parser_advance(cur)
                let pr: InternResult = parser_intern(cur, pn.text)
                cur = pr.state
                param_names.push(pr.index)
                if parser_check(cur, TOKEN_COLON):
                    cur = parser_advance(cur)
                let pt: ParseResult = parse_type(cur)
                cur = pt.state
                param_types.push(pt.node)
                if parser_check(cur, TOKEN_COMMA):
                    cur = parser_advance(cur)
            else:
                break
        if parser_check(cur, TOKEN_RPAREN):
            cur = parser_advance(cur)

    var ret_idx: Int = -1
    if parser_check(cur, TOKEN_ARROW):
        cur = parser_advance(cur)
        let rr: ParseResult = parse_type(cur)
        cur = rr.state
        ret_idx = rr.node

    var body_idx: Int = -1
    if parser_check(cur, TOKEN_COLON):
        cur = parser_advance(cur)
        let br: ParseResult = parse_block_or_expr(cur)
        cur = br.state
        body_idx = br.node

    let end_off: Int = parser_current(cur).byte_offset
    let mut data: Array<Int> = []
    data.push(name_idx)
    data.push(len(param_names))
    var pi: Int = 0
    while pi < len(param_names):
        data.push(param_names[pi])
        data.push(param_types[pi])
        pi = pi + 1
    data.push(ret_idx)
    data.push(body_idx)
    let node: AstNode = ast_new_node(AST_ITEM_PATCH, sp.start, end_off, data)
    return parser_push_result(cur, node)

