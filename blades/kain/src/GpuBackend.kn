// GPU.kn — Shader + Dispatch construct file
// STREAM: RED (typecheck) + BLUE (codegen stubs)
//
// GPU subsystem in the decision ladder:
//   shader vertex/fragment/compute — GPU kernel items with typed params, uniforms, workgroups
//   dispatch — host-side GPU launch statement (GPU + Unsafe effects required)
//
// SELF-CONTAINED for standalone check (duplicates types.kn constants).
// When compiled in the workspace, types from types.kn, ast.kn, effects.kn
// are resolved from earlier source_order modules.
//
// Construction flow:
//   1. GPU_SHADER_STAGE_* constants identify the three shader variants
//   2. check_shader() validates shader item AST and returns TypedItem with EFF_GPU
//   3. check_dispatch_stmt() validates dispatch key format + GPU/Unsafe effect requirements
//   4. Codegen stubs (compile_shader_artifact, compile_dispatch_stmt)
//   5. GPU compatibility helpers (is_gpu_compatible_type)

// ═══════════════════════════════════════════════════════════════════
// Effect Constants (local duplicates for standalone check)
// ═══════════════════════════════════════════════════════════════════
const EFF_PURE:     Int = 0x00
const EFF_IO:       Int = 0x01
const EFF_GPU:      Int = 0x02
const EFF_ASYNC:    Int = 0x04
const EFF_REACTIVE: Int = 0x08
const EFF_UNSAFE:   Int = 0x10
const EFF_ALLOC:    Int = 0x20
const EFF_PANIC:    Int = 0x40

// ═══════════════════════════════════════════════════════════════════
// AST Tag Constants (local duplicates for standalone check)
// ═══════════════════════════════════════════════════════════════════
const AST_ITEM_SHADER:   Int = 22
const AST_STMT_DISPATCH: Int = 59

// ═══════════════════════════════════════════════════════════════════
// Local Types (mini-mirrors of types.kn for standalone check)
// ═══════════════════════════════════════════════════════════════════

const RT_UNIT:     Int = 0
const RT_BOOL:     Int = 1
const RT_INT:      Int = 2
const RT_FLOAT:    Int = 3
const RT_STRING:   Int = 4
const RT_CHAR:     Int = 5
const RT_ARRAY:    Int = 6
const RT_SLICE:    Int = 7
const RT_TUPLE:    Int = 8
const RT_REF:      Int = 9
const RT_PTR:      Int = 10
const RT_OPTION:   Int = 11
const RT_RESULT:   Int = 12
const RT_FUTURE:   Int = 13
const RT_STRUCT:   Int = 14
const RT_ENUM:     Int = 15
const RT_FUNCTION: Int = 16
const RT_GENERIC:  Int = 17
const RT_NEVER:    Int = 18
const RT_UNKNOWN:  Int = 19

pub struct ResolvedType:
    kind:          Int
    int_size:      Int
    float_size:    Int
    name:          Int
    inner_type:    Int
    array_len:     Int
    tuple_types:   Int
    tuple_len:     Int
    result_ok:     Int
    result_err:    Int
    fn_params:     Int
    fn_param_count: Int
    fn_ret:        Int
    fn_effects:    Int
    ref_mut:       Bool

pub fn rt_zero() -> ResolvedType:
    return ResolvedType {
        kind: RT_UNKNOWN, int_size: 0, float_size: 0, name: -1,
        inner_type: -1, array_len: 0, tuple_types: -1, tuple_len: 0,
        result_ok: -1, result_err: -1,
        fn_params: -1, fn_param_count: 0, fn_ret: -1, fn_effects: 0,
        ref_mut: false,
    }

pub fn rt_unit() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_UNIT
    return t

pub fn rt_unknown() -> ResolvedType:
    let mut t: ResolvedType = rt_zero()
    t.kind = RT_UNKNOWN
    return t

pub fn strtab_lookup_name_stub(env: TypeEnv, idx: Int) -> String:
    return ""

// Local AstNode (mirrors types.kn for standalone check)
pub struct AstNode:
    kind:       Int
    span_start: Int
    span_end:   Int
    data:       Array<Int>

pub fn ast_data_len(node: AstNode) -> Int:
    return len(node.data)

pub fn ast_data_get(node: AstNode, index: Int) -> Int:
    if index < 0 or index >= len(node.data):
        return -1
    return node.data[index]

// TypeEnv stub (only fields needed by GPU.kn)
pub struct TypeEnv:
    ast_nodes:     Array<AstNode>
    crnt_effects:  Int

pub struct TypedItem:
    kind:          Int
    name:          String
    name_idx:      Int
    resolved_type: ResolvedType
    ast_index:     Int
    effects:       Int

pub struct TypedItemAndEnv:
    env:  TypeEnv
    item: TypedItem

// ── type_error stub (mirrors types.kn for standalone check) ──
pub fn type_error_stub(env: TypeEnv, message: String, kind: String, span_start: Int, span_end: Int) -> TypeEnv:
    return env

// ═══════════════════════════════════════════════════════════════════
// GPU SHADER STAGE CONSTANTS
// ═══════════════════════════════════════════════════════════════════

pub const GPU_SHADER_STAGE_COMPUTE:  Int = 0
pub const GPU_SHADER_VERTEX:         Int = 1
pub const GPU_SHADER_FRAGMENT:       Int = 2

// ═══════════════════════════════════════════════════════════════════
// GPU TYPE COMPATIBILITY HELPERS
// ═══════════════════════════════════════════════════════════════════

pub const GPU_TYPE_VEC2:  String = "Vec2"
pub const GPU_TYPE_VEC3:  String = "Vec3"
pub const GPU_TYPE_VEC4:  String = "Vec4"
pub const GPU_TYPE_IVEC2: String = "IVec2"
pub const GPU_TYPE_UVEC2: String = "UVec2"
pub const GPU_TYPE_UVEC3: String = "UVec3"
pub const GPU_TYPE_MAT4:  String = "Mat4"
pub const GPU_TYPE_STORAGE_BUFFER: String = "StorageBuffer"
pub const GPU_TYPE_SAMPLER2D:      String = "Sampler2D"

// ── is_gpu_compatible_type ──
pub fn is_gpu_compatible_type(env: TypeEnv, ty: ResolvedType) -> Bool:
    if ty.kind == RT_FLOAT or ty.kind == RT_INT:
        return true
    if ty.kind == RT_STRUCT:
        let name: String = strtab_lookup_name_stub(env, ty.name)
        if name == GPU_TYPE_VEC2 or name == GPU_TYPE_VEC3 or name == GPU_TYPE_VEC4:
            return true
        if name == GPU_TYPE_IVEC2 or name == GPU_TYPE_UVEC2 or name == GPU_TYPE_UVEC3:
            return true
        if name == GPU_TYPE_MAT4:
            return true
    return false

// ── is_gpu_uniform_type ──
pub fn is_gpu_uniform_type(env: TypeEnv, ty: ResolvedType) -> Bool:
    if is_gpu_compatible_type(env, ty):
        return true
    if ty.kind == RT_GENERIC:
        let name: String = strtab_lookup_name_stub(env, ty.name)
        if name == GPU_TYPE_STORAGE_BUFFER or name == GPU_TYPE_SAMPLER2D:
            return true
    return false

// ═══════════════════════════════════════════════════════════════════
// TYPECHECKER: GPU constructs
// ═══════════════════════════════════════════════════════════════════

// ── check_shader — validate shader item declaration ──
pub fn check_shader(env: TypeEnv, node: AstNode, idx: Int) -> TypedItemAndEnv:
    let name_idx: Int = if ast_data_len(node) > 0: ast_data_get(node, 0) else: -1
    return TypedItemAndEnv {
        env: env,
        item: TypedItem {
            kind: AST_ITEM_SHADER, name: "shd_" + str(name_idx), name_idx: name_idx,
            resolved_type: rt_unit(), ast_index: idx,
            effects: EFF_GPU,
        }
    }

// ── check_dispatch_stmt — validate dispatch statement ──
pub fn check_dispatch_stmt(env: TypeEnv, node: AstNode, idx: Int) -> TypedItemAndEnv:
    let has_gpu: Bool = (env.crnt_effects and EFF_GPU) != 0
    let has_unsafe: Bool = (env.crnt_effects and EFF_UNSAFE) != 0
    let mut e: TypeEnv = env
    if !has_gpu:
        e = type_error_stub(e, "dispatch requires GPU effect", "ERR_MISSING_GPU_EFFECT",
                          node.span_start, node.span_end)
    if !has_unsafe:
        e = type_error_stub(e, "dispatch requires Unsafe effect", "ERR_MISSING_UNSAFE_EFFECT",
                          node.span_start, node.span_end)
    return TypedItemAndEnv {
        env: e,
        item: TypedItem {
            kind: AST_STMT_DISPATCH, name: "dispatch_" + str(idx), name_idx: -1,
            resolved_type: rt_unit(), ast_index: idx,
            effects: EFF_GPU or EFF_UNSAFE,
        }
    }

// ═══════════════════════════════════════════════════════════════════
// CODEGEN STUBS (BLUE stream — real emission deferred)
// ═══════════════════════════════════════════════════════════════════

pub fn compile_shader_artifact() -> String:
    return ""

pub fn compile_dispatch_stmt() -> Int:
    return 0
