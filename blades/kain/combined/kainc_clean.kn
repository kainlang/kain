// ═══════════════════════════════════════════════════════════════════
// Entry Point
// ═══════════════════════════════════════════════════════════════════

pub fn main() -> Int with IO:
    let raw_args: Array<String> = process_args()
    let cli_config: CliConfig = parse_args(raw_args)
    return run_subcommand(cli_config)
 


