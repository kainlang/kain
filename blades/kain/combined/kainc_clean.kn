    let name_idx: Int = if ast_data_len(node) > 0: ast_data_get(node, 0) else: -1
    let ret: ResolvedType = if kind == AST_ITEM_LAW: rt_bool() else: rt_i64()
    return TypedItemAndEnv {
        env: env,
