// === FILE: jit_cache.kn ===
// =============================================================================
//  jit_cache.kn — shatter struct code cache for JIT-compiled functions
//  STREAM: BRAVO
//
//  Uses shatter struct for Structure-of-Arrays (SoA) layout.
//  Hashes are stored contiguously → 8 hashes per 64-byte cache line
//  vs 1 hash per cache line in AoS layout. Linear scans are L1-cache friendly.
//
//  All cache functions use functional style (value in, value out) — same
//  pattern as blades/markscript/src/jit.kn.
// =============================================================================

// ── Shatter-Struct Code Cache ───────────────────────────────────────────────

shatter struct CacheStore:
    hashes:   Array<Int>
    ptrs:     Array<ptr<Byte>>
    sizes:    Array<Int>
    count:    Int
    hits:     Int
    misses:   Int
    bytes:    Int
    compiles: Int

// ── Constructor ─────────────────────────────────────────────────────────────

pub fn cache_store_new() -> CacheStore:
    return CacheStore {
        hashes: [],
        ptrs: [],
        sizes: [],
        count: 0,
        hits: 0,
        misses: 0,
        bytes: 0,
        compiles: 0,
    }

// ── Lookup — linear scan of hashes array (SoA: contiguous in L1 cache) ─────

pub fn cache_store_lookup(cache: CacheStore, hash: Int) -> ptr<Byte>:
    var i: Int = 0
    while i < cache.count:
        if cache.hashes[i] == hash:
            return cache.ptrs[i]
        i = i + 1
    return int_to_ptr(0, "ptr<Byte>")

// ── Check — lookup with hit/miss telemetry (returns result + updated cache) ─

pub fn cache_store_check(cache: CacheStore, hash: Int) -> CacheStore:
    var i: Int = 0
    while i < cache.count:
        if cache.hashes[i] == hash:
            var c: CacheStore = cache
            c.hits = c.hits + 1
            return c
        i = i + 1
    var c: CacheStore = cache
    c.misses = c.misses + 1
    return c

// ── Register — add new compiled entry to cache ──────────────────────────────

pub fn cache_store_register(cache: CacheStore, hash: Int, ptr: ptr<Byte>, size: Int) -> CacheStore:
    var c: CacheStore = cache
    c.hashes.push(hash)
    c.ptrs.push(ptr)
    c.sizes.push(size)
    c.count = c.count + 1
    c.bytes = c.bytes + size
    c.compiles = c.compiles + 1
    return c

// ── Record hit (without lookup) ─────────────────────────────────────────────

pub fn cache_store_record_hit(cache: CacheStore) -> CacheStore:
    var c: CacheStore = cache
    c.hits = c.hits + 1
    return c

// ── Record miss (without lookup) ────────────────────────────────────────────

pub fn cache_store_record_miss(cache: CacheStore) -> CacheStore:
    var c: CacheStore = cache
    c.misses = c.misses + 1
    return c

// ── Telemetry ───────────────────────────────────────────────────────────────

pub fn cache_store_hit_rate(cache: CacheStore) -> Float:
    let total: Float = (cache.hits + cache.misses) as Float
    if total == 0.0:
        return 0.0
    return (cache.hits as Float) / total

pub fn cache_store_stats_str(cache: CacheStore) -> String:
    var result: String = "cache: "
    result = result + str(cache.count) + " entries, "
    result = result + str(cache.hits) + " hits, "
    result = result + str(cache.misses) + " misses, "
    result = result + str(cache.bytes) + " bytes, "
    result = result + str(cache.compiles) + " compiles, "
    result = result + "hit_rate=" + str(cache_store_hit_rate(cache))
    return result

// ── Entry count / total bytes ───────────────────────────────────────────────

pub fn cache_store_entry_count(cache: CacheStore) -> Int:
    return cache.count

pub fn cache_store_total_bytes(cache: CacheStore) -> Int:
    return cache.bytes

// === FILE: jit.kn ===
// =============================================================================
//  jit.kn — JIT dispatcher: selects Path A (x86-64 direct) or Path B (OrcJIT)
//  STREAM: BRAVO
//  Consumed by: GOLF (as entry point for JIT execution)
//
//  Path selection logic:
//    - If target is "jit" and x86-64 platform → Path A (direct emission)
//    - If OrcJIT available (has_llvm true) → Path B (LLVM OrcJIT)
//    - Otherwise → Path A fallback (always available, zero LLVM dependency)
//
//  Path A (jit_x86.kn): instant startup, sub-millisecond compile time,
//    zero external dependencies. Emits raw x86-64 machine code directly.
//
//  Path B (jit_orc.kn): full LLVM optimization pipeline (O0-O3, LTO),
//    requires LLVM shared library, ~50-200ms startup. Routes through
//    the same shared W^X trampoline as Path A.
// =============================================================================

use src::jit_metal
use src::jit_x86
use src::jit_orc
use src::jit_cache

// ── JIT path availability ───────────────────────────────────────────────────

pub fn jit_path_available(path: String) -> Bool:
    if path == "x86":
        return true  // Path A is always available (pure Kain, no deps)
    if path == "orc":
        let orc_state: OrcJitState = jit_orc_init()
        return jit_orc_available(orc_state)
    return false

// ── Execute bytecode through the selected path ──────────────────────────────
//
//  bytecode: raw opcode stream (e.g., [7, 42, 0] = push 42, halt)
//  len:      bytecode length (or start index to scan from)
//  path:     "x86" for Path A, "orc" for Path B, "auto" for auto-select
//
//  Returns: result from executing the bytecode (RAX value after return)

pub fn jit_execute(bytecode: Array<Int>, len: Int, path: String) -> Int with Unsafe:
    // Auto-select: try OrcJIT first, fall back to x86-64 direct
    if path == "auto" or path == "orc":
        let orc_state: OrcJitState = jit_orc_init()
        if jit_orc_available(orc_state):
            // Path B: OrcJIT — requires LLVM IR module from GOLF
            // For raw bytecode, OrcJIT path is not directly usable without
            // the LLVM IR module. Defer to Path A.
            // Full Path B integration routes through jit_execute_llvm_module()
            let disposed: OrcJitState = jit_orc_dispose(orc_state)
            // Fall through to Path A

    // Path A: x86-64 direct machine code emission (always available)
    let code: Array<Int> = jit_x86.jit_compile_block(bytecode, 0, len)
    return jit_metal.jit_compile_and_run(code, len(code))

// ── Execute bytecode with cache integration ─────────────────────────────────
//
//  Tries cache first; on miss, compiles via Path A, registers in cache,
//  and executes. Returns the result.

pub fn jit_execute_cached(bytecode: Array<Int>, len: Int, cache: CacheStore) -> Int with Unsafe:
    // Simple hash: sum of first few bytes
    var hash: Int = 0
    var hi: Int = 0
    while hi < len and hi < 8:
        hash = (hash * 31) + bytecode[hi]
        hi = hi + 1

    // Check cache
    let cached_ptr: ptr<Byte> = cache_store_lookup(cache, hash)
    if ptr_to_int(cached_ptr) != 0:
        // Cache hit — execute directly
        return jit_metal.call_jit_code(cached_ptr)

    // Cache miss — compile
    let code: Array<Int> = jit_x86.jit_compile_block(bytecode, 0, len)
    let result: Int = jit_metal.jit_compile_and_run(code, len(code))

    // TODO: Register in cache (requires saving code_ptr from jit_compile_and_run)
    // For now, just return result. The full cache integration will be
    // implemented when jit_compile_and_run is refactored to return both
    // the result and the code pointer.

    return result

// ── Path B entry point — execute an LLVM IR module ──────────────────────────
//
//  This is the entry point for Path B when GOLF has an LLVM IR module ready.
//  The module is compiled in-memory via OrcJIT, the entry symbol is looked up,
//  and the resulting native code is executed via the shared W^X trampoline.

pub fn jit_execute_llvm_module(module: ptr<Byte>, entry: String) -> Int with Unsafe:
    let orc_state: OrcJitState = jit_orc_init()
    let available: Bool = jit_orc_available(orc_state)

    if available:
        let result: Int = jit_orc_compile_and_call(orc_state, module, entry)
        let disposed: OrcJitState = jit_orc_dispose(orc_state)
        return result

    let disposed: OrcJitState = jit_orc_dispose(orc_state)
    return -3  // ERR_JIT_LLVM_UNAVAILABLE

// ── Convenience: compile and execute raw bytecode via Path A ─────────────────

pub fn jit_run(bytecode: Array<Int>) -> Int with Unsafe:
    let code: Array<Int> = jit_x86.jit_compile_block(bytecode, 0, len(bytecode))
    return jit_metal.jit_compile_and_run(code, len(code))

// === FILE: parser.kn ===
// parser.kn — Recursive-descent + Pratt parser
// STREAM: DELTA
// Consumed by: FOXTROT (typechecker reads parsed AST)
//
// Converts indent-processed Array<Token> into a flat Array<AstNode>
// using integer-index child references.
//
// Value semantics throughout — functions return new ParserState via result structs.
// Contextual keywords arrive as TOKEN_IDENT and are resolved here.


// ═══════════════════════════════════════════════════════════════════════════
// RESULT STRUCTS — all function returns use these, not tuples
// ═══════════════════════════════════════════════════════════════════════════

pub struct ParseResult:
    state: ParserState
    node:  Int

pub struct InternResult:
    state: ParserState
    index: Int

pub struct PTokenResult:
    state: ParserState
    token: Token

pub struct ParamsResult:
    state: ParserState
    params: Array<Int>

pub struct EffectsResult:
    state: ParserState
    effects: Array<Int>

pub struct BoolResult:
    state: ParserState
    ok: Bool

pub struct PIntResult:
    state: ParserState
    value: Int

pub struct ProgResult:
    state:  ParserState
    program: AstProgram

pub struct SpanPair:
    start: Int
    end: Int

// ═══════════════════════════════════════════════════════════════════════════
// PARSER STATE
// ═══════════════════════════════════════════════════════════════════════════

pub struct LoopLabel:
    break_idx:    Int
    continue_idx: Int

pub struct ParserState:
    tokens:         Array<Token>
    pos:            Int
    program:        Array<AstNode>
    errors:         KcDiagnosticBag
    string_table:   StringTable
    loop_stack:     Array<LoopLabel>
    injected:       Array<Token>
    synth_counter:  Int
    file_path:      String
    source:         String

pub fn parser_new(tokens_in: Array<Token>, file_path: String, source: String) -> ParserState:
    return ParserState {
        tokens: tokens_in,
        pos: 0,
        program: [],
        errors: kc_diag_bag_new(),
        string_table: strtab_new(),
        loop_stack: [],
        injected: [],
        synth_counter: 0,
        file_path: file_path,
        source: source,
    }

// ═══════════════════════════════════════════════════════════════════════════
// TOKEN CURSOR HELPERS
// ═══════════════════════════════════════════════════════════════════════════

pub fn parser_current(st: ParserState) -> Token:
    if st.pos >= len(st.tokens):
        return token_new(TOKEN_EOF, "", 0, 0, 0)
    return st.tokens[st.pos]

pub fn parser_peek(st: ParserState, ahead: Int) -> Token:
    let idx: Int = st.pos + ahead
    if idx >= len(st.tokens):
        return token_new(TOKEN_EOF, "", 0, 0, 0)
    return st.tokens[idx]

pub fn parser_advance(st: ParserState) -> ParserState:
    let mut new_st: ParserState = st
    if new_st.pos < len(new_st.tokens):
        new_st.pos = new_st.pos + 1
    return new_st

pub fn parser_check(st: ParserState, kind: Int) -> Bool:
    return parser_current(st).kind == kind

pub fn parser_is_at_end(st: ParserState) -> Bool:
    return parser_current(st).kind == TOKEN_EOF

// ── Token consumption ──

pub fn parser_consume(st: ParserState, kind: Int) -> PTokenResult:
    let tok: Token = parser_current(st)
    if tok.kind == kind:
        return PTokenResult { state: parser_advance(st), token: tok }
    return PTokenResult { state: st, token: tok }

pub fn parser_expect(st: ParserState, kind: Int) -> PTokenResult:
    let tok: Token = parser_current(st)
    if tok.kind == kind:
        return PTokenResult { state: parser_advance(st), token: tok }
    let mut new_st: ParserState = st
    let msg: String = "expected " + token_kind_name(kind) + ", found " + tok.text
    new_st = parser_error(new_st, msg, ERR_PARSE_EXPECTED_TOKEN, tok.byte_offset, tok.byte_offset + len(tok.text))
    return PTokenResult { state: new_st, token: tok }

// ── Contextual keyword helpers ──

pub fn parser_peek_contextual(st: ParserState, expected: String) -> Bool:
    let tok: Token = parser_current(st)
    return tok.kind == TOKEN_IDENT and tok.text == expected

pub fn parser_expect_contextual(st: ParserState, expected: String) -> BoolResult:
    let tok: Token = parser_current(st)
    if tok.kind == TOKEN_IDENT and tok.text == expected:
        return BoolResult { state: parser_advance(st), ok: true }
    let mut new_st: ParserState = st
    let msg: String = "expected '" + expected + "', found " + tok.text
    new_st = parser_error(new_st, msg, ERR_PARSE_EXPECTED_TOKEN, tok.byte_offset, tok.byte_offset + len(tok.text))
    return BoolResult { state: new_st, ok: false }

// ── Span helpers ──

pub fn parser_current_span(st: ParserState) -> SpanPair:
    let tok: Token = parser_current(st)
    return SpanPair { start: tok.byte_offset, end: tok.byte_offset + len(tok.text) }

pub fn parser_span_of(st: ParserState, tok: Token) -> SpanPair:
    return SpanPair { start: tok.byte_offset, end: tok.byte_offset + len(tok.text) }

// ── Error reporting ──

pub fn parser_error(st: ParserState, message: String, kind_str: String,
                     span_start: Int, span_end: Int) -> ParserState:
    let mut new_st: ParserState = st
    let tok: Token = parser_current(st)
    let src_line: String = ""
    let diag: KcDiagnostic = kc_diagnostic_new(SEV_ERROR, new_st.file_path, tok.line_no,
        tok.col_no, message, kind_str, span_start, span_end, src_line)
    new_st.errors = kc_diag_bag_add_error(new_st.errors, diag)
    return new_st

// ── Intern identifier string ──

pub fn parser_intern(st: ParserState, name: String) -> InternResult:
    let mut cur: ParserState = st
    let tab_res: StrTabResult = strtab_intern(cur.string_table, name)
    cur.string_table = tab_res.table
    return InternResult { state: cur, index: tab_res.index }

// ── Push a node into the flat array, return its index ──

pub fn parser_push_node(st: ParserState, node: AstNode) -> PIntResult:
    let mut cur: ParserState = st
    let idx: Int = len(cur.program)
    cur.program.push(node)
    return PIntResult { state: cur, value: idx }

// ── Push a node and return ParseResult ──

pub fn parser_push_result(st: ParserState, node: AstNode) -> ParseResult:
    let res: PIntResult = parser_push_node(st, node)
    return ParseResult { state: res.state, node: res.value }

// ═══════════════════════════════════════════════════════════════════════════
// TOKEN KIND NAMES (for error messages)
// ═══════════════════════════════════════════════════════════════════════════

pub fn token_kind_name(kind: Int) -> String:
    if kind == TOKEN_FN:         return "'fn'"
    if kind == TOKEN_LET:        return "'let'"
    if kind == TOKEN_IF:         return "'if'"
    if kind == TOKEN_IDENT:      return "identifier"
    if kind == TOKEN_INT:        return "integer literal"
    if kind == TOKEN_STRING:     return "string literal"
    if kind == TOKEN_EOF:        return "end of file"
    if kind == TOKEN_LPAREN:     return "'('"
    if kind == TOKEN_RPAREN:     return "')'"
    if kind == TOKEN_LBRACE:     return "'{'"
    if kind == TOKEN_RBRACE:     return "'}'"
    if kind == TOKEN_LBRACKET:   return "'['"
    if kind == TOKEN_RBRACKET:   return "']'"
    if kind == TOKEN_COLON:      return "':'"
    if kind == TOKEN_EQ:         return "'='"
    if kind == TOKEN_ARROW:      return "'->'"
    if kind == TOKEN_SEMI:       return "';'"
    if kind == TOKEN_NEWLINE:    return "newline"
    if kind == TOKEN_INDENT:     return "indent"
    if kind == TOKEN_DEDENT:     return "dedent"
    if kind == TOKEN_COMMA:      return "','"
    if kind == TOKEN_DOT:        return "'.'"
    if kind == TOKEN_COLON_COLON: return "'::'"
    if kind == TOKEN_FAT_ARROW:  return "'=>'"
    if kind == TOKEN_WITH:       return "'with'"
    if kind == TOKEN_AS:         return "'as'"
    if kind == TOKEN_IN:         return "'in'"
    if kind == TOKEN_STRUCT:     return "'struct'"
    if kind == TOKEN_ENUM:       return "'enum'"
    if kind == TOKEN_TRAIT:      return "'trait'"
    if kind == TOKEN_IMPL:       return "'impl'"
    if kind == TOKEN_PUB:        return "'pub'"
    if kind == TOKEN_MOD:        return "'mod'"
    if kind == TOKEN_USE:        return "'use'"
    if kind == TOKEN_CONST:      return "'const'"
    if kind == TOKEN_RETURN:     return "'return'"
    if kind == TOKEN_FOR:        return "'for'"
    if kind == TOKEN_WHILE:      return "'while'"
    if kind == TOKEN_LOOP:       return "'loop'"
    if kind == TOKEN_BREAK:      return "'break'"
    if kind == TOKEN_CONTINUE:   return "'continue'"
    if kind == TOKEN_DEFER:      return "'defer'"
    if kind == TOKEN_MATCH:      return "'match'"
    if kind == TOKEN_AWAIT:      return "'await'"
    if kind == TOKEN_MUT:        return "'mut'"
    if kind == TOKEN_VAR:        return "'var'"
    return "<kind=" + str(kind) + ">"

