// //  Models what happens after the root cause triggers.
// //
// //  Parameters:
// //    input: Int — The value from cause.kn to process downstream
// //
// //  Returns: Int — The computed downstream effect
// // ===========================================================================
//
// pub fn compute_effect(input: Int) -> Int:
