fn bool_word(flag: Bool) -> String:
    if flag:
        return "enabled"
    return "disabled"

fn fidelity_label(high_fidelity: Bool) -> String:
    if high_fidelity:
        return "cinematic"
    return "preview"

fn scene_caption(scene_name: String) -> String:
    if scene_name == "geometry_fixture":
        return "generic particle field"
    return "external scene"

fn color_caption(color_mode: String) -> String:
    if color_mode == "spectral":
        return "cyan, amber, and ultraviolet trails"
    elif color_mode == "ember":
        return "lava reds with incandescent gold"
    return "silver-white diagnostics"

fn camera_x(camera_label: String) -> Float:
    if camera_label == "wide sweep":
        return 18.0
    elif camera_label == "low hover":
        return 9.0
    return 12.0

fn camera_y(camera_label: String) -> Float:
    if camera_label == "wide sweep":
        return 7.0
    elif camera_label == "low hover":
        return 4.0
    return 6.0

fn camera_z(camera_label: String) -> Float:
    if camera_label == "wide sweep":
        return 28.0
    elif camera_label == "low hover":
        return 16.0
    return 18.0

fn target_y(camera_label: String) -> Float:
    if camera_label == "wide sweep":
        return 4.0
    elif camera_label == "low hover":
        return 1.6
    return 2.0

fn fog_density(scene_name: String, high_fidelity: Bool) -> Float:
    if high_fidelity:
        return 0.018
    return 0.010

fn viewport_profile(color_mode: String, high_fidelity: Bool) -> String:
    if color_mode == "spectral":
        if high_fidelity:
            return "chronos_spectral_cinematic"
        return "chronos_spectral_preview"
    elif color_mode == "ember":
        if high_fidelity:
            return "chronos_ember_cinematic"
        return "chronos_ember_preview"
    if high_fidelity:
        return "chronos_mono_cinematic"
    return "chronos_mono_preview"

fn preset_score(seed: Int, bloom_enabled: Bool, high_fidelity: Bool) -> Int:
    let bloom_bonus = 12
    let fidelity_bonus = 24
    let total = seed
    if bloom_enabled:
        total = total + bloom_bonus
    if high_fidelity:
        total = total + fidelity_bonus
    return total

fn chronos_detail_line(scene_name: String, color_mode: String, camera_label: String) -> String:
    return f"{scene_caption(scene_name)} | {color_caption(color_mode)} | camera={camera_label}"

law chronos_scene_is_supported(scene_name: String) -> Bool:
    return scene_name == "geometry_fixture"

converge resolve_particle_budget(high_fidelity: Bool) -> Int:
    spec reference:
        if high_fidelity:
            return 1080
        return 360
    fast interpret_lane when target("interpret"):
        if high_fidelity:
            return 1080
        return 360
    fast dispatch_lane when capability("converge.dispatch"):
        if high_fidelity:
            return 1080
        return 360

world ChronosLab:
    state preset_label: String = "Nebula Swarm"
    state scene_name: String = "geometry_fixture"
    state camera_label: String = "orbital drift"
    state color_mode: String = "spectral"
    state bloom_enabled: Bool = true
    state high_fidelity: Bool = false
    state particle_budget: Int = 360
    state particle_budget_text: String = "360 particles | preview"
    state status_line: String = "Chronos native authoring proof booted in preview fidelity."
    state detail_line: String = "generic particle field | cyan, amber, and ultraviolet trails | camera=orbital drift"
    state stage_line: String = "Preset=Nebula Swarm | Scene=geometry_fixture | Bloom=enabled"
    state preset_score: Int = 100
    state hot_reload_note: String = "Hot reload should preserve the chosen preset, dock layout, and current tab."
    surface native_ui => App
    surface viewport3d => "geometry_fixture"

patch sync_manifest(lab: ChronosLab) -> String:
    let supported = chronos_scene_is_supported(lab.scene_name)
    if !supported:
        lab.scene_name = "geometry_fixture"
        lab.preset_label = "Nebula Swarm"
        lab.camera_label = "orbital drift"
    lab.particle_budget = resolve_particle_budget(lab.high_fidelity)
    lab.particle_budget_text = f"{lab.particle_budget} particles | {fidelity_label(lab.high_fidelity)}"
    lab.status_line = f"Chronos {lab.preset_label} | fidelity={fidelity_label(lab.high_fidelity)} | color={lab.color_mode}"
    lab.detail_line = chronos_detail_line(lab.scene_name, lab.color_mode, lab.camera_label)
    lab.stage_line = f"Preset={lab.preset_label} | Scene={lab.scene_name} | Bloom={bool_word(lab.bloom_enabled)}"
    lab.preset_score = preset_score(lab.preset_score, lab.bloom_enabled, lab.high_fidelity)
    lab.hot_reload_note = f"selected scene={lab.scene_name} | camera={lab.camera_label} | current fidelity={fidelity_label(lab.high_fidelity)}"
    return lab.status_line

patch apply_preset(lab: ChronosLab, preset_label: String, scene_name: String, camera_label: String, score_seed: Int) -> String:
    if chronos_scene_is_supported(scene_name):
        lab.preset_label = preset_label
        lab.scene_name = scene_name
        lab.camera_label = camera_label
        lab.preset_score = score_seed
    return sync_manifest(lab)

patch set_color_mode(lab: ChronosLab, color_mode: String) -> String:
    lab.color_mode = color_mode
    return sync_manifest(lab)

patch set_camera_mode(lab: ChronosLab, camera_label: String) -> String:
    lab.camera_label = camera_label
    return sync_manifest(lab)

patch toggle_bloom(lab: ChronosLab) -> Bool:
    lab.bloom_enabled = !lab.bloom_enabled
    sync_manifest(lab)
    return lab.bloom_enabled

patch toggle_high_fidelity(lab: ChronosLab) -> Bool:
    lab.high_fidelity = !lab.high_fidelity
    sync_manifest(lab)
    return lab.high_fidelity

fn select_nebula_swarm():
    apply_preset(ChronosLab, "Nebula Swarm", "geometry_fixture", "orbital drift", 88)

fn select_generic_scene():
    apply_preset(ChronosLab, "Generic Scene", "geometry_fixture", "wide sweep", 94)

fn select_harbor_pulse():
    apply_preset(ChronosLab, "Harbor Pulse", "geometry_fixture", "low hover", 90)

fn choose_spectral():
    set_color_mode(ChronosLab, "spectral")

fn choose_ember():
    set_color_mode(ChronosLab, "ember")

fn choose_monochrome():
    set_color_mode(ChronosLab, "monochrome")

fn choose_orbital_drift():
    set_camera_mode(ChronosLab, "orbital drift")

fn choose_wide_sweep():
    set_camera_mode(ChronosLab, "wide sweep")

fn choose_low_hover():
    set_camera_mode(ChronosLab, "low hover")

fn toggle_bloom_mode():
    toggle_bloom(ChronosLab)

fn toggle_fidelity_mode():
    toggle_high_fidelity(ChronosLab)

component App():
    render <slot>
        <theme name="chronos_native_lab">
            <scope name="chronos" selector="chronos-native-lab" />
            <token name="theme.background.top" category="color" value="#07131f" />
            <token name="theme.background.bottom" category="color" value="#0f2235" />
            <token name="theme.surface.base" category="color" value="#102034" />
            <token name="theme.surface.alt" category="color" value="#152840" />
            <token name="theme.surface.overlay" category="color" value="#132236d8" />
            <token name="theme.accent.primary" category="color" value="#ff9d4d" />
            <token name="theme.accent.soft" category="color" value="#ffd4b0" />
            <token name="theme.highlight" category="color" value="#7fe5ff" />
            <token name="theme.text.default" category="color" value="#edf6ff" />
            <token name="theme.text.muted" category="color" value="#9cb8d2" />
            <token name="theme.typography.scale" category="type" value={1.08} />
            <token name="theme.spacing.scale" category="space" value={1.02} />
            <token name="theme.radius.scale" category="radius" value={1.14} />
            <token name="widget.panel.surface.mode" category="surface" value="glass" />
            <token name="widget.inspector.surface.mode" category="surface" value="flat" />
            <token name="widget.tree.surface.mode" category="surface" value="ghost" />
            <token name="widget.graph.surface.mode" category="surface" value="canvas" />
            <token name="widget.timeline.surface.mode" category="surface" value="accent" />
            <token name="widget.viewport3d.surface.mode" category="surface" value="canvas" />
            <variant scope="chronos" name="shell">
                <token name="surface.mode" category="surface" value="ghost" />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.visible" category="state" value={false} />
            </variant>
            <variant scope="chronos" name="hero">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.padding" category="space" value={18} />
            </variant>
            <variant scope="chronos" name="rail">
                <token name="surface.mode" category="surface" value="flat" />
                <token name="surface.padding" category="space" value={12} />
            </variant>
            <variant scope="chronos" name="stage">
                <token name="surface.mode" category="surface" value="layered" />
                <token name="surface.padding" category="space" value={14} />
            </variant>
            <variant scope="chronos" name="meter">
                <token name="surface.mode" category="surface" value="accent" />
                <token name="surface.padding" category="space" value={10} />
            </variant>
            <widget kind="element" scope="chronos" variant="command_button">
                <token name="surface.mode" category="surface" value="glass" />
                <token name="surface.fill" category="color" value="#1d2f47" />
                <token name="surface.stroke" category="color" value="#ff9d4d" />
                <token name="surface.radius" category="surface" value={16} />
                <token name="surface.padding" category="space" value={10} />
                <token name="title.color" category="color" value="#edf6ff" />
                <token name="text.color" category="color" value="#edf6ff" />
                <token name="accent.color" category="color" value="#7fe5ff" />
            </widget>
        </theme>

        <panel title="Chronos Native Lab" scope="chronos" variant="shell" layout="dock" persistent_layout_id="chronos_native_shell" gap={16} padding={16}>
            <panel title="Preset Rail" dock="left" scope="chronos" variant="rail" split_ratio={0.24} min_width={280} max_width={380} resizable={true} layout="column" gap={12}>
                <panel title="Chronos Native Proof" scope="chronos" variant="hero" layout="column" gap={8}>
                    <text role="eyebrow">KAIN NATIVE AUTHORING / HOT RELOAD</text>
                    <text role="hero">A desktop-scale Chronos shell authored directly in Kain.</text>
                    <text role="body">This lab drives the viewport, dock chrome, tabs, status rails, theme system, and shader bundle from one source tree so the native UI dev loop has a real flagship surface.</text>
                </panel>

                <panel title="Preset Packets" scope="chronos" variant="rail" layout="column" gap={8}>
                    <button variant="command_button" onclick={select_nebula_swarm}>Nebula Swarm</button>
                    <button variant="command_button" onclick={select_generic_scene}>Generic Scene</button>
                    <button variant="command_button" onclick={select_harbor_pulse}>Harbor Pulse</button>
                </panel>

                <panel title="Color Modes" scope="chronos" variant="rail" layout="column" gap={8}>
                    <button variant="command_button" onclick={choose_spectral}>Spectral</button>
                    <button variant="command_button" onclick={choose_ember}>Ember</button>
                    <button variant="command_button" onclick={choose_monochrome}>Monochrome</button>
                </panel>

                <panel title="Camera Modes" scope="chronos" variant="rail" layout="column" gap={8}>
                    <button variant="command_button" onclick={choose_orbital_drift}>Orbital Drift</button>
                    <button variant="command_button" onclick={choose_wide_sweep}>Wide Sweep</button>
                    <button variant="command_button" onclick={choose_low_hover}>Low Hover</button>
                </panel>

                <panel title="Runtime Toggles" scope="chronos" variant="rail" layout="column" gap={8}>
                    <button variant="command_button" onclick={toggle_bloom_mode}>Toggle Bloom</button>
                    <button variant="command_button" onclick={toggle_fidelity_mode}>Toggle Fidelity</button>
                </panel>
            </panel>

            <panel title="Chronos Workspace" dock="center" scope="chronos" variant="stage" layout="dock" gap={14}>
                <panel title="Viewport Studio" scope="chronos" variant="stage" layout="dock" gap={12} persistent_layout_id="chronos_native_studio_page" tab_group_id="chronos-pages" tab_label="Studio" tab_order={0} tab_default_active={true}>
                    <panel title="Chronos Viewport" dock="center" scope="chronos" variant="stage" layout="column" gap={12}>
                        <viewport3d title="Chronos Particle View" scene={ChronosLab.scene_name} viewport_profile={viewport_profile(ChronosLab.color_mode, ChronosLab.high_fidelity)} viewport_fog_density={fog_density(ChronosLab.scene_name, ChronosLab.high_fidelity)} viewport_particle_budget={ChronosLab.particle_budget} gizmo_profile="dcc_transform_universal" gizmo_visible={true} gizmo_default_mode="translate" gizmo_default_space="world" gizmo_drag_trigger="ctrl_primary_drag" gizmo_selection_required={true} gizmo_hotkey_translate="T" gizmo_hotkey_rotate="R" gizmo_hotkey_scale="Y" gizmo_hotkey_cycle_space="U" gizmo_hotkey_toggle_snap="I" gizmo_snap_translate={0.5} gizmo_snap_rotate_degrees={15.0} gizmo_snap_scale_percent={10.0} gizmo_snap_default_enabled={false} />
                        <panel title="Particle Deck" scope="chronos" variant="stage" layout="row" gap={12}>
                            <graph title="Emitter Drift" />
                            <timeline title="Preset Transition Rail" />
                        </panel>
                    </panel>

                    <panel title="Operator Notes" dock="right" scope="chronos" variant="rail" split_ratio={0.26} min_width={300} max_width={400} resizable={true} layout="column" gap={12}>
                        <inspector title="Viewport Contract">
                            <text role="metric">{ChronosLab.particle_budget}</text>
                            <text role="caption">particle budget</text>
                            <text role="caption">{ChronosLab.particle_budget_text}</text>
                            <text role="caption">{ChronosLab.detail_line}</text>
                        </inspector>
                        <panel title="Hot Reload Note" scope="chronos" variant="rail" layout="column" gap={4}>
                            <text role="title">{ChronosLab.status_line}</text>
                            <text role="caption">{ChronosLab.hot_reload_note}</text>
                        </panel>
                    </panel>
                </panel>

                <panel title="Shader Diagnostics" scope="chronos" variant="stage" layout="dock" gap={12} persistent_layout_id="chronos_native_diagnostics_page" tab_group_id="chronos-pages" tab_label="Diagnostics" tab_order={1}>
                    <panel title="Shader Canvases" dock="center" scope="chronos" variant="stage" layout="row" gap={12}>
                        <canvas title="Chronos Ribbon" text={ChronosLab.color_mode} shader_ref="ChronosRibbon" shader_stage="fragment" shader_format="spirv" font_family="ui-sans" />
                        <canvas title="Chronos Pulse" text={ChronosLab.scene_name} shader_ref="ChronosPulseField" shader_stage="fragment" shader_format="spirv" font_family="ui-mono" />
                    </panel>

                    <panel title="Bundle Readout" dock="right" scope="chronos" variant="rail" split_ratio={0.28} min_width={300} max_width={390} resizable={true} layout="column" gap={12}>
                        <inspector title="Shader Bundle">
                            <text role="caption">fragment: ChronosRibbon</text>
                            <text role="caption">fragment: ChronosPulseField</text>
                            <text role="caption">compute: ChronosParticleAdvance</text>
                            <text role="caption">These artifacts should hot-reload without restarting the shell when compatibility holds.</text>
                        </inspector>
                        <graph title="Bundle Activity" />
                    </panel>
                </panel>
            </panel>

            <panel title="Status Strip" dock="bottom" scope="chronos" variant="rail" split_ratio={0.20} min_height={170} max_height={260} resizable={true} layout="row" gap={12}>
                <panel title="Preset Status" scope="chronos" variant="meter" layout="column" gap={2}>
                    <text role="metric">{ChronosLab.preset_label}</text>
                    <text role="caption">{ChronosLab.stage_line}</text>
                </panel>
                <panel title="Visual Stack" scope="chronos" variant="meter" layout="column" gap={2}>
                    <text role="metric">{ChronosLab.color_mode}</text>
                    <text role="caption">bloom {bool_word(ChronosLab.bloom_enabled)} | fidelity {fidelity_label(ChronosLab.high_fidelity)}</text>
                </panel>
                <panel title="Preset Score" scope="chronos" variant="meter" layout="column" gap={2}>
                    <text role="metric">{ChronosLab.preset_score}</text>
                    <text role="caption">{"native-ui state score"}</text>
                </panel>
            </panel>
        </panel>
    </slot>

shader fragment ChronosRibbon(uv: Vec2) -> Vec4:
    let dx = uv.x - 0.48
    let dy = uv.y - 0.40
    let radial_energy = dx * dx + dy * dy
    var halo = 1.0 - radial_energy * 3.4
    if halo < 0.0:
        halo = 0.0
    if halo > 1.0:
        halo = 1.0

    let sweep_a = uv.x * 0.65 + uv.y * 0.35
    let sweep_b = (1.0 - uv.x) * 0.45 + uv.y * 0.55
    let sweep_c = uv.y * uv.y

    let base_r = 0.06 + halo * 0.12 + sweep_b * 0.18
    let base_g = 0.09 + halo * 0.16 + sweep_a * 0.10
    let base_b = 0.14 + halo * 0.22 + sweep_c * 0.12 + sweep_b * 0.06
    return vec4(base_r, base_g, base_b, 1.0)

shader fragment ChronosPulseField(uv: Vec2) -> Vec4:
    let pulse_dx = uv.x - 0.28
    let pulse_dy = uv.y - 0.62
    var pulse = 1.0 - (pulse_dx * pulse_dx + pulse_dy * pulse_dy) * 6.0
    if pulse < 0.0:
        pulse = 0.0
    if pulse > 1.0:
        pulse = 1.0

    let conduit_dy = uv.y - 0.36
    var conduit = 1.0 - conduit_dy * conduit_dy * 20.0
    if conduit < 0.0:
        conduit = 0.0
    if conduit > 1.0:
        conduit = 1.0

    let drift = uv.x * 0.35 + uv.y * 0.65
    let shimmer = (1.0 - uv.x) * uv.y

    let base_r = 0.04 + drift * 0.04 + pulse * 0.10
    let base_g = 0.08 + shimmer * 0.08 + conduit * 0.14 + pulse * 0.08
    let base_b = 0.11 + conduit * 0.16 + pulse * 0.18
    return vec4(base_r, base_g, base_b, 1.0)

shader compute ChronosParticleAdvance(id: UVec3) -> Vec4:
    uniform source_energy: StorageBuffer<Float> @0
    uniform target_energy: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [64, 1, 1],
            [
                ("source_energy", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("target_energy", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("chronos_particle_advance", "phase_step", ["source_energy"], ["target_energy"], false),
            ],
        )

    let sample = source_energy[0]
    let pulse = sample + 0.0625
    target_energy[0] = pulse
    return vec4(pulse, pulse * 0.4, 1.0 - pulse * 0.2, 1.0)

fn main() -> Int:
    sync_manifest(ChronosLab)
    if chronos_scene_is_supported(ChronosLab.scene_name):
        return 0
    return 1
