component App():
    render <panel title="Kain Native Viewport Lab" layout="dock" gap={16} padding={16}>
        <panel title="Launch Deck" layout="row" gap={14}>
            <inspector title="Session">
                Kain native terrain viewport
                terraced caldera with magma and ash
                WGPU preferred, compiled bundle boot
            </inspector>
            <tree title="Controls">
                click geometry to select
                T translate gizmo
                R rotate gizmo
                Y scale gizmo
                roam with WASD + QE
                drag mouse to look
            </tree>
        </panel>
        <panel title="Viewport Stage" gap={14}>
            <viewport3d title="Generic Scene" scene="geometry_fixture" />
            <panel title="Signal Stack" layout="row" gap={12}>
                <graph title="Thermal Flow" />
                <timeline title="Gravity Drift" />
            </panel>
        </panel>
    </panel>
