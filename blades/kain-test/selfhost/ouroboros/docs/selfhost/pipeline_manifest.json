{
  "version": 4,
  "schema_version": 1,
  "description": "Manifest-driven orchestration for Ouroboros V2 selfhost lanes.",
  "defaults": {
    "phase2_root": "{ouroboros_root}/out/selfhost/phase2",
    "repaired_root": "{ouroboros_root}/out/selfhost/phase2_repaired",
    "repair_docs": "{ouroboros_root}/docs/selfhost/repairs",
    "repair_runner": "{ouroboros_root}/tools/selfhost_repair/repair_runner.py",
    "workspace_status_script": "{ouroboros_root}/scripts/selfhost_workspace_status.py",
    "pipeline_out": "{ouroboros_root}/out/selfhost/pipeline",
    "owned_manifest": "{repo_root}/src/KAIN.toml",
    "owned_selfhost_root": "{repo_root}/src/.selfhost",
    "owned_reports_root": "{repo_root}/src/.selfhost/reports",
    "owned_combined_source": "{repo_root}/src/.selfhost/phase0/combined/kain_core_selfhost.kn",
    "owned_llvm_output": "{repo_root}/src/.selfhost/phase0/out/kain_core_selfhost.ll",
    "owned_runtime_contract_output": "{repo_root}/src/.selfhost/phase0/out/kain_core_selfhost.runtime_contract.json",
    "owned_realtime_app_output": "{repo_root}/src/.selfhost/phase0/out/kain_core_selfhost.realtime_app.json",
    "owned_native_output": "{repo_root}/src/.selfhost/phase0/out/kainc",
    "owned_ouroboros_output": "{repo_root}/src/.selfhost/ouroboros/kain_core_selfhost.stage2.ll",
    "native_runtime_manifest": "{repo_root}/runtime/native_core_runtime.toml",
    "native_runtime_build_script": "{repo_root}/runtime/compile_native_runtime.sh"
  },
  "crate_slices": {
    "phase2-core": [
      "kain-core"
    ],
    "phase2-full": [
      "kain-core",
      "kain-import",
      "kain-sys-codegen",
      "cli"
    ],
    "owned-core": [
      "src/core"
    ]
  },
  "lanes": [
    {
      "id": "analyze",
      "description": "Classify current phase2 failures and refresh reports without mutation.",
      "failure_policy": "stop_on_failure",
      "continue_on_failure": false,
      "dependencies": [],
      "crate_slice": [],
      "required_artifacts": [
        "{phase2_root}/stage2_workspace/stage2_build.log"
      ],
      "steps": [
        {
          "id": "repair_analyze",
          "kind": "argv",
          "timeout_seconds": 180,
          "retry_policy": "never",
          "consumes": [
            "{phase2_root}/stage2_workspace/stage2_build.log"
          ],
          "produces": [
            "{repaired_root}/phase2_repair_report.json",
            "{repaired_root}/phase2_repair_report.md"
          ],
          "argv": [
            "{python_executable}",
            "{repair_runner}",
            "analyze",
            "--input-root",
            "{phase2_root}",
            "--repaired-root",
            "{repaired_root}",
            "--repair-docs",
            "{repair_docs}"
          ],
          "expected_logs": [
            "{repaired_root}/phase2_repair_report.json",
            "{repaired_root}/phase2_repair_report.md"
          ]
        }
      ]
    },
    {
      "id": "phase2-core",
      "description": "Repair copied outputs and run the fast stage2 kain-core check against the repaired workspace.",
      "failure_policy": "stop_on_failure",
      "continue_on_failure": false,
      "dependencies": [],
      "crate_slice": [
        "kain-core"
      ],
      "required_artifacts": [
        "{phase2_root}/stage2_workspace/Cargo.toml",
        "{phase2_root}/stage2_workspace/crates/kain-core/src/lib.rs"
      ],
      "steps": [
        {
          "id": "repair_skip_validation",
          "kind": "argv",
          "timeout_seconds": 300,
          "retry_policy": "never",
          "consumes": [
            "{phase2_root}/stage2_workspace/Cargo.toml",
            "{phase2_root}/stage2_workspace/crates/kain-core/src/lib.rs"
          ],
          "produces": [
            "{repaired_root}/phase2_repair_report.json",
            "{repaired_root}/phase2_repair_report.md"
          ],
          "argv": [
            "{python_executable}",
            "{repair_runner}",
            "repair",
            "--validation",
            "skip",
            "--input-root",
            "{phase2_root}",
            "--repaired-root",
            "{repaired_root}",
            "--repair-docs",
            "{repair_docs}"
          ],
          "expected_logs": [
            "{repaired_root}/phase2_repair_report.json",
            "{repaired_root}/phase2_repair_report.md"
          ]
        },
        {
          "id": "core_check",
          "kind": "argv",
          "timeout_seconds": 900,
          "retry_policy": "never",
          "consumes": [
            "{repaired_root}/stage2_workspace/Cargo.toml",
            "{repaired_root}/stage2_workspace/crates/kain-core/src/lib.rs"
          ],
          "produces": [
            "{repaired_root}/stage2_workspace/stage2_kain-core_check.log",
            "{repaired_root}/front_errors.json",
            "{repaired_root}/front_errors.md"
          ],
          "cwd": "{repaired_root}/stage2_workspace",
          "argv": [
            "cargo",
            "check",
            "-p",
            "kain-core"
          ],
          "artifact_log": "{repaired_root}/stage2_workspace/stage2_kain-core_check.log",
          "expected_logs": [
            "{repaired_root}/stage2_workspace/stage2_kain-core_check.log"
          ]
        }
      ]
    },
    {
      "id": "phase2-full",
      "description": "Repair copied outputs, verify the core crate, then run the full stage2 workspace check against the repaired workspace.",
      "failure_policy": "stop_on_failure",
      "continue_on_failure": false,
      "dependencies": [
        "phase2-core"
      ],
      "crate_slice": [
        "kain-core",
        "kain-import",
        "kain-sys-codegen",
        "cli"
      ],
      "required_artifacts": [
        "{phase2_root}/stage2_workspace/Cargo.toml",
        "{phase2_root}/stage2_workspace/crates/cli/src/main.rs"
      ],
      "steps": [
        {
          "id": "full_check",
          "kind": "argv",
          "timeout_seconds": 1800,
          "retry_policy": "never",
          "consumes": [
            "{repaired_root}/stage2_workspace/Cargo.toml",
            "{repaired_root}/stage2_workspace/crates/cli/src/main.rs"
          ],
          "produces": [
            "{repaired_root}/stage2_workspace/stage2_build.log",
            "{repaired_root}/front_errors.json",
            "{repaired_root}/front_errors.md"
          ],
          "cwd": "{repaired_root}/stage2_workspace",
          "argv": [
            "cargo",
            "check",
            "-p",
            "cli",
            "--bin",
            "kain"
          ],
          "artifact_log": "{repaired_root}/stage2_workspace/stage2_build.log",
          "expected_logs": [
            "{repaired_root}/stage2_workspace/stage2_build.log"
          ]
        }
      ]
    },
    {
      "id": "owned-bootstrap",
      "description": "Resolve the hand-written selfhost manifest, assemble the ordered src/core bootstrap unit, and emit the first LLVM + report artifact set without linking a native executable.",
      "failure_policy": "stop_on_failure",
      "continue_on_failure": false,
      "dependencies": [],
      "crate_slice": [
        "src/core"
      ],
      "required_artifacts": [
        "{owned_manifest}",
        "{native_runtime_manifest}"
      ],
      "success_criteria": [
        "The owned manifest under src/KAIN.toml resolves from repo root and names every ordered src/core source file.",
        "The bootstrap command emits the aggregate compatibility source, LLVM output, native sidecars, and machine-readable reports under src/.selfhost/.",
        "The command exits non-zero if manifest loading, source resolution, compile, or artifact staging fails."
      ],
      "validation_commands": [
        [
          "cargo",
          "run",
          "-q",
          "-p",
          "cli",
          "--bin",
          "kain",
          "--",
          "selfhost",
          "bootstrap",
          "--combine-only"
        ],
        [
          "cargo",
          "run",
          "-q",
          "-p",
          "cli",
          "--bin",
          "kain",
          "--",
          "selfhost",
          "bootstrap",
          "--emit-llvm-only"
        ]
      ],
      "steps": [
        {
          "id": "owned_combine_only",
          "kind": "argv",
          "timeout_seconds": 300,
          "retry_policy": "never",
          "consumes": [
            "{owned_manifest}"
          ],
          "produces": [
            "{owned_combined_source}",
            "{owned_reports_root}/bootstrap_report.json",
            "{owned_reports_root}/bootstrap_report.md"
          ],
          "cwd": "{repo_root}",
          "argv": [
            "cargo",
            "run",
            "-q",
            "-p",
            "cli",
            "--bin",
            "kain",
            "--",
            "selfhost",
            "bootstrap",
            "--combine-only"
          ],
          "artifact_log": "{owned_reports_root}/bootstrap_report.md",
          "expected_logs": [
            "{owned_reports_root}/bootstrap_report.json",
            "{owned_reports_root}/bootstrap_report.md"
          ]
        },
        {
          "id": "owned_emit_llvm",
          "kind": "argv",
          "timeout_seconds": 900,
          "retry_policy": "never",
          "consumes": [
            "{owned_combined_source}",
            "{native_runtime_manifest}"
          ],
          "produces": [
            "{owned_llvm_output}",
            "{owned_runtime_contract_output}",
            "{owned_realtime_app_output}",
            "{owned_reports_root}/bootstrap_report.json",
            "{owned_reports_root}/bootstrap_report.md"
          ],
          "cwd": "{repo_root}",
          "argv": [
            "cargo",
            "run",
            "-q",
            "-p",
            "cli",
            "--bin",
            "kain",
            "--",
            "selfhost",
            "bootstrap",
            "--emit-llvm-only"
          ],
          "artifact_log": "{owned_reports_root}/bootstrap_report.md",
          "expected_logs": [
            "{owned_reports_root}/bootstrap_report.json",
            "{owned_reports_root}/bootstrap_report.md"
          ]
        }
      ]
    },
    {
      "id": "owned-native",
      "description": "Build or reuse the lean native C runtime bundle from runtime/native_core_runtime.toml and link the hand-written bootstrap lane into a runnable native kainc binary.",
      "failure_policy": "stop_on_failure",
      "continue_on_failure": false,
      "dependencies": [
        "owned-bootstrap"
      ],
      "crate_slice": [
        "src/core"
      ],
      "required_artifacts": [
        "{owned_manifest}",
        "{owned_llvm_output}",
        "{native_runtime_manifest}",
        "{native_runtime_build_script}"
      ],
      "success_criteria": [
        "The bootstrap command resolves the native runtime manifest instead of guessing -lkain_runtime.",
        "The command reuses or builds the real runtime objects and archives, stages the standard LLVM/native sidecars, and links a runnable native compiler binary.",
        "The command exits non-zero if runtime resolution, runtime build, link, or expected-artifact checks fail."
      ],
      "validation_commands": [
        [
          "cargo",
          "run",
          "-q",
          "-p",
          "cli",
          "--bin",
          "kain",
          "--",
          "selfhost",
          "bootstrap",
          "--link-native"
        ]
      ],
      "steps": [
        {
          "id": "owned_link_native",
          "kind": "argv",
          "timeout_seconds": 3600,
          "retry_policy": "never",
          "consumes": [
            "{owned_manifest}",
            "{owned_llvm_output}",
            "{native_runtime_manifest}",
            "{native_runtime_build_script}"
          ],
          "produces": [
            "{owned_native_output}",
            "{owned_reports_root}/bootstrap_report.json",
            "{owned_reports_root}/bootstrap_report.md"
          ],
          "cwd": "{repo_root}",
          "argv": [
            "cargo",
            "run",
            "-q",
            "-p",
            "cli",
            "--bin",
            "kain",
            "--",
            "selfhost",
            "bootstrap",
            "--link-native"
          ],
          "artifact_log": "{owned_reports_root}/bootstrap_report.md",
          "expected_logs": [
            "{owned_reports_root}/bootstrap_report.json",
            "{owned_reports_root}/bootstrap_report.md"
          ]
        }
      ]
    },
    {
      "id": "owned-ouroboros",
      "description": "Use the native hand-written compiler to recompile the same manifest and classify artifact parity for the first full ouroboros loop.",
      "failure_policy": "stop_on_failure",
      "continue_on_failure": false,
      "dependencies": [
        "owned-native"
      ],
      "crate_slice": [
        "src/core"
      ],
      "required_artifacts": [
        "{owned_manifest}",
        "{owned_native_output}"
      ],
      "success_criteria": [
        "The stage1 native compiler can recompile the same manifest-driven source set without falling back to Rust compiler passes.",
        "The verification step emits a deterministic comparison result and records whether artifact parity is exact, drifted, or blocked.",
        "The command exits non-zero when the produced native compiler cannot complete the recompile or when required comparison artifacts are missing."
      ],
      "validation_commands": [
        [
          "cargo",
          "run",
          "-q",
          "-p",
          "cli",
          "--bin",
          "kain",
          "--",
          "selfhost",
          "bootstrap",
          "--verify-ouroboros"
        ]
      ],
      "steps": [
        {
          "id": "owned_verify_ouroboros",
          "kind": "argv",
          "timeout_seconds": 3600,
          "retry_policy": "never",
          "consumes": [
            "{owned_manifest}",
            "{owned_native_output}"
          ],
          "produces": [
            "{owned_ouroboros_output}",
            "{owned_reports_root}/bootstrap_report.json",
            "{owned_reports_root}/bootstrap_report.md"
          ],
          "cwd": "{repo_root}",
          "argv": [
            "cargo",
            "run",
            "-q",
            "-p",
            "cli",
            "--bin",
            "kain",
            "--",
            "selfhost",
            "bootstrap",
            "--verify-ouroboros"
          ],
          "artifact_log": "{owned_reports_root}/bootstrap_report.md",
          "expected_logs": [
            "{owned_reports_root}/bootstrap_report.json",
            "{owned_reports_root}/bootstrap_report.md"
          ]
        }
      ]
    }
  ]
}
