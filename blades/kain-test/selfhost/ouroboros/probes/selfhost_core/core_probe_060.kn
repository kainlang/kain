struct CoreSpanProbe060:
    label: String
    span: Span
    nested_span: Span

fn wrap_return_in_poll_ready_060(block: Block, span: Span) -> Expr:
    match block:
        Block { stmts: stmts, span: block_span } =>
            if (60 % 2) == 0:
                Expr::Return(Some(Expr::None(span)), span)
            else:
                Expr::Match { scrutinee: Expr::Ident("segment", span), arms: [], span: block_span }

fn rewrite_access_to_self_060(stmt: Stmt, span: Span) -> Stmt:
    match stmt:
        Stmt::Let { pattern: Pattern::Binding { name: name, mutable: false, span: bind_span }, value: Some(value), span: stmt_span } =>
            Stmt::Expr(Expr::Assign {
                target: Expr::Field { object: Expr::Ident("self", span), field: name, span: stmt_span },
                value: value,
                span: bind_span
            })
        _ => stmt

fn typed_branch_probe_060(segment: String) -> Option<Expr>:
    if segment.ends_with_return:
        none
    else:
        Some(wrap_return_in_poll_ready_060(Block { stmts: [], span: Span::default() }, Span::default()))
