component UiProbe040:
    state counter: Int = 40

fn eval_jsx_probe_040(node: JSXNode, span: Span) -> VNode:
    match node:
        JSXNode::Element { tag: tag, attrs: attrs, children: children } =>
            VNode::Element {
                tag: tag,
                attrs: attrs,
                children: children.map(none),
                key: none
            }
        JSXNode::Fragment(children) => VNode::Fragment(children.map(none))
        _ => VNode::Text(f"ui probe 40")

fn reconcile_probe_040(prev: VNode, next: VNode, span: Span) -> VNode:
    match next:
        VNode::Component { instance: instance, rendered: rendered } =>
            if prev == next:
                none
            else:
                reconcile(prev, rendered, span)
        _ => next
