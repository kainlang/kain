enum TraitProbeValue060:
    Unit
    Text(String)

impl Display for TraitProbeValue060:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue060::Unit => write(f, "unit-60")
            TraitProbeValue060::Text(value) => write(f, value)

impl Default for TraitProbeValue060:
    fn default_() -> Self_:
        TraitProbeValue060__Unit

fn trait_helper_probe_060(value: TraitProbeValue060) -> String:
    format("{}", value)
