enum TraitProbeValue015:
    Unit
    Text(String)

impl Display for TraitProbeValue015:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue015::Unit => write(f, "unit-15")
            TraitProbeValue015::Text(value) => write(f, value)

impl Default for TraitProbeValue015:
    fn default_() -> Self_:
        TraitProbeValue015__Unit

fn trait_helper_probe_015(value: TraitProbeValue015) -> String:
    format("{}", value)
