enum TraitProbeValue042:
    Unit
    Text(String)

impl Display for TraitProbeValue042:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue042::Unit => write(f, "unit-42")
            TraitProbeValue042::Text(value) => write(f, value)

impl Default for TraitProbeValue042:
    fn default_() -> Self_:
        TraitProbeValue042__Unit

fn trait_helper_probe_042(value: TraitProbeValue042) -> String:
    format("{}", value)
