enum TraitProbeValue008:
    Unit
    Text(String)

impl Display for TraitProbeValue008:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue008::Unit => write(f, "unit-8")
            TraitProbeValue008::Text(value) => write(f, value)

impl Default for TraitProbeValue008:
    fn default_() -> Self_:
        TraitProbeValue008__Unit

fn trait_helper_probe_008(value: TraitProbeValue008) -> String:
    format("{}", value)
