enum TraitProbeValue055:
    Unit
    Text(String)

impl Display for TraitProbeValue055:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue055::Unit => write(f, "unit-55")
            TraitProbeValue055::Text(value) => write(f, value)

impl Default for TraitProbeValue055:
    fn default_() -> Self_:
        TraitProbeValue055__Unit

fn trait_helper_probe_055(value: TraitProbeValue055) -> String:
    format("{}", value)
