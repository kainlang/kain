enum TraitProbeValue001:
    Unit
    Text(String)

impl Display for TraitProbeValue001:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue001::Unit => write(f, "unit-1")
            TraitProbeValue001::Text(value) => write(f, value)

impl Default for TraitProbeValue001:
    fn default_() -> Self_:
        TraitProbeValue001__Unit

fn trait_helper_probe_001(value: TraitProbeValue001) -> String:
    format("{}", value)
