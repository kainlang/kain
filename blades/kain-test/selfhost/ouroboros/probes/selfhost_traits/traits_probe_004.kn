enum TraitProbeValue004:
    Unit
    Text(String)

impl Display for TraitProbeValue004:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue004::Unit => write(f, "unit-4")
            TraitProbeValue004::Text(value) => write(f, value)

impl Default for TraitProbeValue004:
    fn default_() -> Self_:
        TraitProbeValue004__Unit

fn trait_helper_probe_004(value: TraitProbeValue004) -> String:
