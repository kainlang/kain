enum TraitProbeValue026:
    Unit
    Text(String)

impl Display for TraitProbeValue026:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue026::Unit => write(f, "unit-26")
            TraitProbeValue026::Text(value) => write(f, value)

impl Default for TraitProbeValue026:
    fn default_() -> Self_:
        TraitProbeValue026__Unit

fn trait_helper_probe_026(value: TraitProbeValue026) -> String:
    format("{}", value)
