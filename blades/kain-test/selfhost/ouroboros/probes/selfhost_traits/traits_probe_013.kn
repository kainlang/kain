enum TraitProbeValue013:
    Unit
    Text(String)

impl Display for TraitProbeValue013:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue013::Unit => write(f, "unit-13")
            TraitProbeValue013::Text(value) => write(f, value)

impl Default for TraitProbeValue013:
    fn default_() -> Self_:
        TraitProbeValue013__Unit

fn trait_helper_probe_013(value: TraitProbeValue013) -> String:
    format("{}", value)
