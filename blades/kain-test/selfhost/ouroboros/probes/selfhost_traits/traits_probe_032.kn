enum TraitProbeValue032:
    Unit
    Text(String)

impl Display for TraitProbeValue032:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue032::Unit => write(f, "unit-32")
            TraitProbeValue032::Text(value) => write(f, value)

impl Default for TraitProbeValue032:
    fn default_() -> Self_:
        TraitProbeValue032__Unit

fn trait_helper_probe_032(value: TraitProbeValue032) -> String:
    format("{}", value)
