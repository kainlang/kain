enum TraitProbeValue041:
    Unit
    Text(String)

impl Display for TraitProbeValue041:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue041::Unit => write(f, "unit-41")
            TraitProbeValue041::Text(value) => write(f, value)

impl Default for TraitProbeValue041:
    fn default_() -> Self_:
        TraitProbeValue041__Unit

fn trait_helper_probe_041(value: TraitProbeValue041) -> String:
    format("{}", value)
