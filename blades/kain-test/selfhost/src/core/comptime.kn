use ast::Program
use error::ErrorKind
use error::KainError
use span::SourceSpan

# Kain Comptime Seed

struct ComptimeStats:
    blocks_seen: Int
    expressions_folded: Int

struct ComptimeEvalOutput:
    program: Program
    stats: ComptimeStats

pub fn eval_program(program: Program) -> Result<Program, KainError>:
    let result: Result<Program, KainError> = Result::Ok(program)
    return result

pub fn eval_program_with_stats(program: Program) -> Result<ComptimeEvalOutput, KainError>:
    let result: Result<ComptimeEvalOutput, KainError> = Result::Ok(ComptimeEvalOutput {
        program: program,
        stats: ComptimeStats {
            blocks_seen: 0,
            expressions_folded: 0
        }
    })
    return result

pub fn reject_unsupported_host_evaluation(message: String) -> KainError:
    return KainError {
        kind: ErrorKind::Runtime,
        message: "kain comptime host evaluation not yet implemented: " + message,
        span: SourceSpan { start: 0, end: 0, file: "" },
        filename: "",
        hint: none
    }
