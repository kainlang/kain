// ============================================================================
// Kain Span System - bootstrap-safe data declarations
// ============================================================================
// The owned bootstrap lane currently uses span values directly through struct
// literals. Keep helper behavior out of this file until the parser/typechecker
// subset is strong enough to support the richer method surface again.
// ============================================================================

use stdlib

pub struct SourceLocation:
    line_: Int
    column_: Int
    offset_: Int
    length_: Int
    source_line: String

pub struct SourceSpan:
    start: Int
    end: Int
    file: String
