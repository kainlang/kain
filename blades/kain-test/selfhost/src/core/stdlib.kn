# Kain Standard Library Seed

enum CompileTarget:
    Llvm
    Rust
    Js
    Wasm
    Interpret
    Test

struct StdLibBuiltin:
    name: String
    arity: Int
    summary: String

struct StdLibCatalog:
    builtins: Array<StdLibBuiltin>

impl CompileTarget:
    pub fn from_str(name: String) -> CompileTarget:
        if name == "llvm" || name == "native":
            return CompileTarget::Llvm
        if name == "rust" || name == "rs":
            return CompileTarget::Rust
        if name == "js" || name == "javascript":
            return CompileTarget::Js
        if name == "wasm":
            return CompileTarget::Wasm
        if name == "run" || name == "interpret":
            return CompileTarget::Interpret
        if name == "test":
            return CompileTarget::Test
        return CompileTarget::Interpret

impl StdLibCatalog:
    pub fn core() -> StdLibCatalog:
        return StdLibCatalog {
            builtins: [
                StdLibBuiltin {
                    name: "println",
                    arity: 1,
                    summary: "write a line to stdout"
                },
                StdLibBuiltin {
                    name: "panic",
                    arity: 1,
                    summary: "abort execution with a message"
                },
                StdLibBuiltin {
                    name: "len",
                    arity: 1,
                    summary: "return the length of an array or string"
                },
                StdLibBuiltin {
                    name: "str",
                    arity: 1,
                    summary: "convert a value into a string"
                }
            ]
        }

pub fn load_stdlib_for_target(target: CompileTarget) -> String:
    match target:
        CompileTarget::Llvm => ""
        CompileTarget::Rust => ""
        CompileTarget::Js => ""
        CompileTarget::Wasm => ""
        CompileTarget::Interpret => ""
        CompileTarget::Test => ""

pub fn core_keywords() -> Array<String>:
    return [
        "fn",
        "let",
        "var",
        "if",
        "else",
        "while",
        "for",
        "in",
        "return",
        "match",
        "struct",
        "enum",
        "trait",
        "impl",
        "use",
        "pub",
        "async",
        "await",
        "break",
        "continue",
        "const",
        "extern",
        "effect",
        "module",
        "comptime"
    ]

fn substring(text: String, start: Int, end: Int) -> String:
    let result = ""
    let i = start
    while i < end && i < len(text):
        result = result + char_at(text, i)
        i = i + 1
    return result

fn to_float(value: String) -> Float:
    let i = 0
    let sign = 1.0
    if len(value) > 0:
        let first = char_at(value, 0)
        if first == "-":
            sign = -1.0
            i = 1
        else if first == "+":
            i = 1

    let int_part = 0.0
    let frac_part = 0.0
    let divisor = 10.0
    let seen_dot = false

    while i < len(value):
        let ch = char_at(value, i)
        if ch == ".":
            seen_dot = true
        else if ch != "_":
            let digit = 0.0
            if ch == "1":
                digit = 1.0
            else if ch == "2":
                digit = 2.0
            else if ch == "3":
                digit = 3.0
            else if ch == "4":
                digit = 4.0
            else if ch == "5":
                digit = 5.0
            else if ch == "6":
                digit = 6.0
            else if ch == "7":
                digit = 7.0
            else if ch == "8":
                digit = 8.0
            else if ch == "9":
                digit = 9.0
            if !seen_dot:
                int_part = int_part * 10.0 + digit
            else:
                frac_part = frac_part + digit / divisor
                divisor = divisor * 10.0
        i = i + 1

    return sign * (int_part + frac_part)

fn to_int(value: String) -> Int:
    let i = 0
    let sign = 1
    if len(value) > 0:
        let first = char_at(value, 0)
        if first == "-":
            sign = -1
            i = 1
        else if first == "+":
            i = 1

    let result = 0
    while i < len(value):
        let ch = char_at(value, i)
        if ch == ".":
            return sign * result
        if ch != "_":
            let digit = 0
            if ch == "1":
                digit = 1
            else if ch == "2":
                digit = 2
            else if ch == "3":
                digit = 3
            else if ch == "4":
                digit = 4
            else if ch == "5":
                digit = 5
            else if ch == "6":
                digit = 6
            else if ch == "7":
                digit = 7
            else if ch == "8":
                digit = 8
            else if ch == "9":
                digit = 9
            result = result * 10 + digit
        i = i + 1

    return sign * result
