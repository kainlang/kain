use crate::error::KainError

use crate::error::KainResult

use std::path::PathBuf

@doc(doc = " Run Python post-processor to auto-fix edge cases")
pub fn run_python_post_processor(plugin_path: &std::path::PathBuf, plugin_name: String) -> Result<(), KainError>:
    use std::process::Command

    let mut script_path = none
    let cwd_script = std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from(".")).join("kain").join("python").join("post_process.py")
    if cwd_script.exists():
        script_path = Option::Some(cwd_script)
        ()
        ()
        ()
        ()
    else:
        let mut current = std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from("."))
        for _ in range(0, 5):
            let candidate = current.join("kain").join("python").join("post_process.py")
            if candidate.exists():
                script_path = Option::Some(candidate)
                ()
                break
            match current.parent():
                Some(parent) =>
                    current = parent.to_path_buf()
                    ()
                _ => break
        ()
        if script_path.is_none():
            match std__env__current_exe():
                Ok(exe_path) =>
                    match exe_path.parent():
                        Some(exe_dir) =>
                            let exe_script = exe_dir.join("python").join("post_process.py")
                            if exe_script.exists():
                                script_path = Option::Some(exe_script)
                                ()
                                ()
                                ()
                                ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            ()
        ()
    let script_path = match script_path:
        Some(p) => p
        None =>
            println("   ⚠\u{fe0f}  Python post-processor not found (skipping)")
            return Result::Ok(())
    let output = Command__new_("python").arg(&script_path).arg(plugin_path).arg(plugin_name).arg("--verbose").output()
    match output:
        Ok(output) =>
            if output.status.success():
                let stdout = String__from_utf8_lossy(&output.stdout)
                match stdout.lines().last():
                    Some(json_line) =>
                        match serde_json__from_str(json_line):
                            Ok(result) =>
                                match result.get("fixes_applied").and_then(fn(v): v.as_u64()):
                                    Some(fixes) =>
                                        println(f"   ✅ Applied {fixes} auto-fixes")
                                        match result.get("fixes").and_then(fn(v): v.as_array()):
                                            Some(fixes_list) =>
                                                for fix in fixes_list:
                                                    match fix.as_str():
                                                        Some(fix_str) => println(f"      - {fix_str}")
                                                        _ => ()
                                                ()
                                                ()
                                            _ =>
                                                ()
                                                ()
                                        ()
                                    _ =>
                                        ()
                                        ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                let stderr = String__from_utf8_lossy(&output.stderr)
                println("   ⚠\u{fe0f}  Python post-processor failed:")
                println(stderr)
                ()
                ()
            ()
        Err(e) =>
            println(f"   ⚠️  Could not run Python post-processor: {e}")
            println("      (Make sure Python is installed and in PATH)")
            ()
            ()
    Result::Ok(())

@doc(doc = " Convert span position to line:column for better error messages")
pub fn format_error_with_location(source: String, error_msg: String, file_name: String) -> String:
    match error_msg.find("Span { start: "):
        Some(start_idx) =>
            match error_msg[start_idx..].find(" }"):
                Some(end_idx) =>
                    let span_str = &error_msg[start_idx..((start_idx + end_idx) + 2)]
                    match span_str.split("start: ").nth(1):
                        Some(start_pos) =>
                            match start_pos.split(",").next():
                                Some(start_num_str) =>
                                    match start_num_str.parse():
                                        Ok(start_pos) =>
                                            let (line_, col) = position_to_line_col(source, start_pos)
                                            let line_content = get_line_content(source, line_)
                                            return "\n   {file_name}:{line_}:{col}\n   |\n{line_} | {line_content}\n   | {(\" \").repeat(col.saturating_sub(1))}^\n   |\n   {error_msg.split(\": \").last().unwrap_or(error_msg)}"
                                        _ =>
                                            ()
                                            ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    error_msg.to_string()

@doc(doc = " Convert byte position to line:column (1-indexed)")
fn position_to_line_col(source: String, pos: usize) -> (usize, usize):
    let mut line_ = 1
    let mut col = 1
    for selfhost_for_item in source.chars().enumerate():
        let (i, ch) = selfhost_for_item
        if (i >= pos):
            break
        if (ch == "\n"):
            line_ = (line_ + 1)
            ()
            col = 1
            ()
        else:
            col = (col + 1)
            ()
    ()
    (line_, col)

@doc(doc = " Get the content of a specific line (1-indexed)")
fn get_line_content(source: String, line_num: usize) -> String:
    source.lines().nth(line_num.saturating_sub(1)).unwrap_or("").to_string()

@doc(doc = " Extract shader names from KAIN source code")
pub fn extract_shader_names(source: String) -> Result<Array<String>, KainError>:
    match Lexer__new_(source).tokenize():
        Ok(tokens) =>
            let span_mapper = SpanMapper__new_(source)
            match Parser__new_(&tokens, &span_mapper, "<shader_extract>").parse():
                Ok(ast) =>
                    let names: Array<String> = ast.items.iter().filter_map(fn(item): none).collect()
                    Result::Ok(names)
                Err(e) => Result::Err(KainError__runtime(f"Failed to parse source: {e}"))
        Err(e) => Result::Err(KainError__runtime(f"Failed to tokenize source: {e}"))

