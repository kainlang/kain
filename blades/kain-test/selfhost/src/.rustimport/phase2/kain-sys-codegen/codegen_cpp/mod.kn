use kain_core::ast::BinaryOp

use kain_core::ast::Block

use kain_core::ast::ElseBranch

use kain_core::ast::Enum

use kain_core::ast::EnumVariantFields

use kain_core::ast::Expr

use kain_core::ast::Function

use kain_core::ast::Impl

use kain_core::ast::Param

use kain_core::ast::Pattern

use kain_core::ast::Stmt

use kain_core::ast::Struct

use kain_core::ast::Type

use kain_core::ast::UnaryOp

use kain_core::ast::VariantFields

use kain_core::error::KainResult

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

use kain_core::lower_typed_program_memory_for_target

use kain_core::CompileTarget

@doc(doc = " Generate C++ source code from a typed program")
pub fn generate(program: &kain_core::types::TypedProgram) -> Result<String, KainError>:
    let lowered = kain_core__lower_typed_program_memory_for_target(program, kain_core__CompileTarget__Cpp)?
    let mut gen = CppGen__new_()
    Result::Ok(gen.gen_program(&lowered))

struct StringBuilder:
    lines: Array<String>

impl StringBuilder:
    fn new_() -> StringBuilder:
        StringBuilder { lines: Vec__new_() }

    fn push(_self: &mut StringBuilder, text: String):
        (*_self).lines.push(text.to_string())
        ()

    fn push_line(_self: &mut StringBuilder, text: String):
        (*_self).lines.push(f"{text}\n")
        ()

    fn build(_self: &StringBuilder) -> String:
        (*_self).lines.join("")


struct CppGen:
    output: StringBuilder
    indent: usize

impl CppGen:
    fn new_() -> CppGen:
        CppGen { output: StringBuilder__new_(), indent: 0 }

    fn push_indent(_self: &mut CppGen):
        (*_self).indent = ((*_self).indent + 1)
        ()

    fn pop_indent(_self: &mut CppGen):
        if ((*_self).indent > 0):
            (*_self).indent = ((*_self).indent - 1)
            ()

    fn indent_str(_self: &CppGen) -> String:
        ("    ").repeat((*_self).indent)

    fn write_line(_self: &mut CppGen, line_: String):
        let indented = f"{(*_self).indent_str()}{line_}"
        (*_self).output.push_line(&indented)
        ()

    fn write_blank(_self: &mut CppGen):
        (*_self).output.push_line("")
        ()

    fn gen_program(_self: &mut CppGen, program: &kain_core::types::TypedProgram) -> String:
        (*_self).write_line("// Generated by KAIN Compiler")
        ()
        (*_self).write_line("// Do not edit - regenerate from .kn source")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("#include <cstdint>")
        ()
        (*_self).write_line("#include <string>")
        ()
        (*_self).write_line("#include <vector>")
        ()
        (*_self).write_line("#include <optional>")
        ()
        (*_self).write_line("#include <variant>")
        ()
        (*_self).write_line("#include <memory>")
        ()
        (*_self).write_line("#include <iostream>")
        ()
        (*_self).write_line("#include <cstring>")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_low_level_memory_helpers()
        ()
        (*_self).write_blank()
        ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Struct(st) =>
                    (*_self).write_line(&f"struct {st.ast.name};")
                    ()
                _ => ()
        ()
        if (*program).items.iter().any(fn(i): none):
            (*_self).write_blank()
            ()
            ()
            ()
            ()
        for item in &(*program).items:
            (*_self).gen_item(item)
            ()
            (*_self).write_blank()
            ()
        ()
        (*_self).output.build()

    fn write_low_level_memory_helpers(_self: &mut CppGen):
        (*_self).write_line("// ============================================================================")
        ()
        (*_self).write_line("// KAIN Low-Level Memory Helper ABI - C++ Backend")
        ()
        (*_self).write_line("// ============================================================================")
        ()
        (*_self).write_line("//")
        ()
        (*_self).write_line("// This backend provides PARTIAL support for the canonical low-level helper")
        ()
        (*_self).write_line("// surface defined in runtime/native/include/memory.h")
        ()
        (*_self).write_line("//")
        ()
        (*_self).write_line("// SUPPORTED HELPERS:")
        ()
        (*_self).write_line("//   - __kain_union_wrap, __kain_union_get, __kain_union_set (union operations)")
        ()
        (*_self).write_line("//   - __kain_bitfield_get, __kain_bitfield_set (bitfield operations)")
        ()
        (*_self).write_line("//   - __kain_alloc, __kain_realloc (allocation operations - inline)")
        ()
        (*_self).write_line("//")
        ()
        (*_self).write_line("// UNSUPPORTED HELPERS (will cause compile errors if emitted):")
        ()
        (*_self).write_line("//   - __kain_bind_local (pointer binding)")
        ()
        (*_self).write_line("//   - __kain_addr_of (address-of operations)")
        ()
        (*_self).write_line("//   - __kain_ptr_offset (pointer arithmetic)")
        ()
        (*_self).write_line("//   - __kain_field_ptr (field pointer calculation)")
        ()
        (*_self).write_line("//   - __kain_index_ptr (array element pointer)")
        ()
        (*_self).write_line("//   - __kain_mem_load (raw memory load)")
        ()
        (*_self).write_line("//   - __kain_mem_store (raw memory store)")
        ()
        (*_self).write_line("//")
        ()
        (*_self).write_line("// STATUS: The C++ backend currently generates inline code for most operations")
        ()
        (*_self).write_line("// and does not yet emit calls to the canonical pointer/memory helpers.")
        ()
        (*_self).write_line("// Full ABI parity is tracked in task 4.5 of the native runtime completion spec.")
        ()
        (*_self).write_line("//")
        ()
        (*_self).write_line("// For full low-level memory support, use the LLVM backend or native C runtime.")
        ()
        (*_self).write_line("// ============================================================================")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("// Forward declarations for canonical helpers (UNSUPPORTED - will fail at link time)")
        ()
        (*_self).write_line("template<typename T> T* __kain_bind_local(T* ptr);")
        ()
        (*_self).write_line("template<typename T> T* __kain_addr_of(T* ptr, size_t size);")
        ()
        (*_self).write_line("template<typename T> T* __kain_ptr_offset(T* ptr, int64_t offset, int64_t stride);")
        ()
        (*_self).write_line("template<typename T> void* __kain_field_ptr(T* ptr, const char* field, size_t offset);")
        ()
        (*_self).write_line("template<typename T> T* __kain_index_ptr(T* ptr, int64_t index, int64_t stride);")
        ()
        (*_self).write_line("template<typename T> void __kain_mem_load(const void* ptr, T* out, size_t size);")
        ()
        (*_self).write_line("template<typename T> void __kain_mem_store(void* ptr, const T* value, size_t size);")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("// Allocation helpers (inline implementations)")
        ()
        (*_self).write_line("inline void* __kain_alloc(size_t size, size_t stride, int zeroed) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("const size_t total = size * stride;")
        ()
        (*_self).write_line("if (zeroed) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("return std::calloc(1, total);")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("} else {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("return std::malloc(total);")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("inline void* __kain_realloc(void* ptr, size_t size, size_t stride, int zeroed_new) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("const size_t new_total = size * stride;")
        ()
        (*_self).write_line("void* new_ptr = std::realloc(ptr, new_total);")
        ()
        (*_self).write_line("// Note: zeroed_new not fully implemented - would require tracking old size")
        ()
        (*_self).write_line("return new_ptr;")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("// Union operations (SUPPORTED)")
        ()
        (*_self).write_line("template<typename TObject, typename TValue> TObject __kain_union_wrap(TObject value, const char*, const char*, long long byte_size, long long union_size, const TValue& active_value) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("const auto copy_span = std::min<long long>(std::min<long long>(byte_size, union_size), std::min<long long>(sizeof(TObject), sizeof(TValue)));")
        ()
        (*_self).write_line("if (union_size > 0) { std::memset(&value, 0, static_cast<size_t>(std::min<long long>(union_size, sizeof(TObject)))); }")
        ()
        (*_self).write_line("if (copy_span > 0) { std::memcpy(&value, &active_value, static_cast<size_t>(copy_span)); }")
        ()
        (*_self).write_line("return value;")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("template<typename TObject, typename TValue> TValue __kain_union_get(const TObject& value, const char*, const char*, long long byte_size, long long union_size, const TValue& fallback) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("TValue result = fallback;")
        ()
        (*_self).write_line("const auto copy_span = std::min<long long>(std::min<long long>(byte_size, union_size), std::min<long long>(sizeof(TObject), sizeof(TValue)));")
        ()
        (*_self).write_line("if (copy_span > 0) { std::memcpy(&result, &value, static_cast<size_t>(copy_span)); }")
        ()
        (*_self).write_line("return result;")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("template<typename TObject, typename TValue> TValue __kain_union_set(TObject& value, const char*, const char*, long long byte_size, long long union_size, const TValue& next) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("if (union_size > 0) { std::memset(&value, 0, static_cast<size_t>(std::min<long long>(union_size, sizeof(TObject)))); }")
        ()
        (*_self).write_line("const auto copy_span = std::min<long long>(std::min<long long>(byte_size, union_size), std::min<long long>(sizeof(TObject), sizeof(TValue)));")
        ()
        (*_self).write_line("if (copy_span > 0) { std::memcpy(&value, &next, static_cast<size_t>(copy_span)); }")
        ()
        (*_self).write_line("return next;")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("// Bitfield operations (SUPPORTED)")
        ()
        (*_self).write_line("template<typename TObject> unsigned long long __kain_load_bitfield_unit(const TObject& value, long long unit_offset) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("if (unit_offset < 0 || unit_offset >= static_cast<long long>(sizeof(TObject))) { return 0ULL; }")
        ()
        (*_self).write_line("unsigned long long unit = 0ULL;")
        ()
        (*_self).write_line("const auto available = std::min<long long>(8, static_cast<long long>(sizeof(TObject)) - unit_offset);")
        ()
        (*_self).write_line("std::memcpy(&unit, reinterpret_cast<const unsigned char*>(&value) + unit_offset, static_cast<size_t>(available));")
        ()
        (*_self).write_line("return unit;")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("template<typename TObject> void __kain_store_bitfield_unit(TObject& value, long long unit_offset, unsigned long long unit) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("if (unit_offset < 0 || unit_offset >= static_cast<long long>(sizeof(TObject))) { return; }")
        ()
        (*_self).write_line("const auto available = std::min<long long>(8, static_cast<long long>(sizeof(TObject)) - unit_offset);")
        ()
        (*_self).write_line("std::memcpy(reinterpret_cast<unsigned char*>(&value) + unit_offset, &unit, static_cast<size_t>(available));")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("inline unsigned long long __kain_bitfield_mask(long long width) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("if (width <= 0) { return 0ULL; }")
        ()
        (*_self).write_line("if (width >= 64) { return ~0ULL; }")
        ()
        (*_self).write_line("return (1ULL << width) - 1ULL;")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("inline long long __kain_sign_extend(unsigned long long value, long long width) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("if (width <= 0) { return 0LL; }")
        ()
        (*_self).write_line("if (width >= 64) { return static_cast<long long>(value); }")
        ()
        (*_self).write_line("const auto sign_bit = 1ULL << (width - 1);")
        ()
        (*_self).write_line("if ((value & sign_bit) == 0ULL) { return static_cast<long long>(value); }")
        ()
        (*_self).write_line("const auto full_mask = ~__kain_bitfield_mask(width);")
        ()
        (*_self).write_line("return static_cast<long long>(value | full_mask);")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("template<typename TObject> long long __kain_bitfield_get(const TObject& value, const char*, long long unit_offset, long long bit_offset, long long width, bool is_signed, long long) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("const auto mask = __kain_bitfield_mask(width);")
        ()
        (*_self).write_line("const auto unit = __kain_load_bitfield_unit(value, unit_offset);")
        ()
        (*_self).write_line("const auto shifted = bit_offset <= 0 ? unit : (unit >> bit_offset);")
        ()
        (*_self).write_line("const auto encoded = shifted & mask;")
        ()
        (*_self).write_line("return is_signed ? __kain_sign_extend(encoded, width) : static_cast<long long>(encoded);")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()
        (*_self).write_line("template<typename TObject, typename TValue> TValue __kain_bitfield_set(TObject& value, const char*, long long unit_offset, long long bit_offset, long long width, bool is_signed, long long promoted_bits, const TValue& next) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line("const auto mask = __kain_bitfield_mask(width);")
        ()
        (*_self).write_line("auto unit = __kain_load_bitfield_unit(value, unit_offset);")
        ()
        (*_self).write_line("const auto encoded = static_cast<unsigned long long>(static_cast<long long>(next)) & mask;")
        ()
        (*_self).write_line("const auto shifted_mask = bit_offset <= 0 ? mask : (mask << bit_offset);")
        ()
        (*_self).write_line("unit = (unit & ~shifted_mask) | (bit_offset <= 0 ? encoded : (encoded << bit_offset));")
        ()
        (*_self).write_line("__kain_store_bitfield_unit(value, unit_offset, unit);")
        ()
        (*_self).write_line("return static_cast<TValue>(__kain_bitfield_get(value, \"\", unit_offset, bit_offset, width, is_signed, promoted_bits));")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()

    fn gen_item(_self: &mut CppGen, item: &kain_core::types::TypedItem):
        match item:
            kain_core__types__TypedItem::Function(fn_typed) => (*_self).gen_function(&fn_typed.ast)
            kain_core__types__TypedItem::Struct(st) => (*_self).gen_struct(&st.ast)
            kain_core__types__TypedItem::Enum(en) => (*_self).gen_enum(&en.ast)
            kain_core__types__TypedItem::Impl(im) => (*_self).gen_impl(&im.ast)
            _ => ()

    fn gen_function(_self: &mut CppGen, func: &kain_core::ast::Function):
        let params = (*_self).gen_params(&(*func).params)
        let ret = match &(*func).return_type:
            Some(ty) => (*_self).map_type(ty)
            _ => ("void").to_string()
        let has_return_type = (*func).return_type.is_some()
        (*_self).write_line(&"{ret} {(*func).name}({params}) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).gen_block_with_implicit_return(&(*func).body, has_return_type)
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()

    fn gen_params(_self: &CppGen, params: &[kain_core::ast::Param]) -> String:
        let parts: Array<String> = params.iter().map(fn(p): none).collect()
        parts.join(", ")

    fn gen_struct(_self: &mut CppGen, struct_def: &kain_core::ast::Struct):
        (*_self).write_line(&"struct {(*struct_def).name} {")
        ()
        (*_self).push_indent()
        ()
        for field in &(*struct_def).fields:
            (*_self).write_line(&f"{(*_self).map_type(&field.ty)} {field.name};")
            ()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("};")
        ()

    fn gen_enum(_self: &mut CppGen, enum_def: &kain_core::ast::Enum):
        let is_simple = (*enum_def).variants.iter().all(fn(v): none)
        if is_simple:
            (*_self).write_line(&"enum class {(*enum_def).name} {")
            ()
            (*_self).push_indent()
            ()
            for variant in &(*enum_def).variants:
                (*_self).write_line(&f"{variant.name},")
                ()
            ()
            (*_self).pop_indent()
            ()
            (*_self).write_line("};")
            ()
        else:
            (*_self).write_line(&f"// Tagged union: {(*enum_def).name}")
            ()
            for variant in &(*enum_def).variants:
                match &variant.fields:
                    kain_core__ast__VariantFields::Unit =>
                        (*_self).write_line(&"struct {(*enum_def).name}_{variant.name} {};")
                        ()
                    kain_core__ast__VariantFields::Tuple(types) =>
                        (*_self).write_line(&"struct {(*enum_def).name}_{variant.name} {")
                        ()
                        (*_self).push_indent()
                        ()
                        for selfhost_for_item in types.iter().enumerate():
                            let (i, ty) = selfhost_for_item
                            (*_self).write_line(&f"{(*_self).map_type(ty)} _{i};")
                            ()
                        ()
                        (*_self).pop_indent()
                        ()
                        (*_self).write_line("};")
                        ()
                    kain_core__ast__VariantFields::Struct(fields) =>
                        (*_self).write_line(&"struct {(*enum_def).name}_{variant.name} {")
                        ()
                        (*_self).push_indent()
                        ()
                        for f in fields:
                            (*_self).write_line(&f"{(*_self).map_type(&f.ty)} {f.name};")
                            ()
                        ()
                        (*_self).pop_indent()
                        ()
                        (*_self).write_line("};")
                        ()
            ()
            let variant_types: Array<String> = (*enum_def).variants.iter().map(fn(v): f"{(*enum_def).name}_{v.name}").collect()
            (*_self).write_line(&"using {(*enum_def).name} = std::variant<{variant_types.join(\", \")}>;")
            ()

    fn gen_impl(_self: &mut CppGen, impl_def: &kain_core::ast::Impl):
        let target = (*_self).map_type(&(*impl_def).target_type)
        (*_self).write_line(&f"// Methods for {target}")
        ()
        for method in &(*impl_def).methods:
            (*_self).gen_function(method)
            ()
            (*_self).write_blank()
            ()

    fn gen_block(_self: &mut CppGen, block: &kain_core::ast::Block):
        for stmt in &(*block).stmts:
            (*_self).gen_stmt(stmt)
            ()

    fn gen_block_with_implicit_return(_self: &mut CppGen, block: &kain_core::ast::Block, implicit_return: Bool):
        let len = (*block).stmts.len()
        for selfhost_for_item in (*block).stmts.iter().enumerate():
            let (i, stmt) = selfhost_for_item
            let is_last = (i == (len - 1))
            if (is_last && implicit_return):
                match stmt:
                    kain_core__ast__Stmt::Expr(expr) =>
                        if (!none):
                            let expr_str = (*_self).gen_expr(expr)
                            (*_self).write_line(&f"return {expr_str};")
                            ()
                            continue
                        ()
                    _ =>
                        ()
                        ()
                ()
            (*_self).gen_stmt(stmt)
            ()

    fn gen_stmt(_self: &mut CppGen, stmt: &kain_core::ast::Stmt):
        match stmt:
            kain_core__ast__Stmt::Let { pattern: pattern, ty: ty, value: value } =>
                match pattern:
                    kain_core__ast__Pattern::Binding { name: name, mutable_: mutable_ } =>
                        let ty_str = ty.map(fn(t): (*_self).map_type(t)).unwrap_or_else(fn(): ("auto").to_string())
                        match value:
                            Some(val) => if (*mutable_): none else: none
                            _ =>
                                (*_self).write_line(&f"{ty_str} {name};")
                                ()
                    _ => ()
            kain_core__ast__Stmt::Return(maybe_expr, _) =>
                match maybe_expr:
                    Some(expr) =>
                        (*_self).write_line(&f"return {(*_self).gen_expr(expr)};")
                        ()
                    _ =>
                        (*_self).write_line("return;")
                        ()
            kain_core__ast__Stmt::Break(_, _) =>
                (*_self).write_line("break;")
                ()
            kain_core__ast__Stmt::Continue(_) =>
                (*_self).write_line("continue;")
                ()
            kain_core__ast__Stmt::For { binding: binding, iter: iter, body: body } =>
                match binding:
                    kain_core__ast__Pattern::Binding { name: name } =>
                        (*_self).write_line(&"for (auto {name} : {(*_self).gen_expr(iter)}) {")
                        ()
                        (*_self).push_indent()
                        ()
                        (*_self).gen_block(body)
                        ()
                        (*_self).pop_indent()
                        ()
                        (*_self).write_line("}")
                        ()
                    _ => ()
            kain_core__ast__Stmt::While { condition: condition, body: body } =>
                (*_self).write_line(&"while ({(*_self).gen_expr(condition)}) {")
                ()
                (*_self).push_indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).pop_indent()
                ()
                (*_self).write_line("}")
                ()
            kain_core__ast__Stmt::Loop { body: body } =>
                (*_self).write_line("while (true) {")
                ()
                (*_self).push_indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).pop_indent()
                ()
                (*_self).write_line("}")
                ()
            kain_core__ast__Stmt::Expr(expr) =>
                match expr:
                    kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                        (*_self).gen_if_stmt(condition, then_branch, else_branch)
                        ()
                    _ =>
                        match expr:
                            kain_core__ast__Expr::Assign { target: target, value: value } =>
                                (*_self).write_line(&f"{(*_self).gen_expr(target)} = {(*_self).gen_expr(value)};")
                                ()
                            _ =>
                                let expr_str = (*_self).gen_expr(expr)
                                if (!expr_str.is_empty()):
                                    (*_self).write_line(&f"{expr_str};")
                                    ()
            kain_core__ast__Stmt::Item(_) => ()

    fn gen_if_stmt(_self: &mut CppGen, condition: &kain_core::ast::Expr, then_branch: &kain_core::ast::Block, else_branch: &Option<Box<kain_core::ast::ElseBranch>>):
        (*_self).write_line(&"if ({(*_self).gen_expr(condition)}) {")
        ()
        (*_self).push_indent()
        ()
        (*_self).gen_block(then_branch)
        ()
        (*_self).pop_indent()
        ()
        match else_branch:
            Some(else_br) =>
                match else_br:
                    kain_core__ast__ElseBranch::Else(block) =>
                        (*_self).write_line("} else {")
                        ()
                        (*_self).push_indent()
                        ()
                        (*_self).gen_block(block)
                        ()
                        (*_self).pop_indent()
                        ()
                        (*_self).write_line("}")
                        ()
                    kain_core__ast__ElseBranch::ElseIf(cond, block, next_else) =>
                        (*_self).write_line(&"} else if ({(*_self).gen_expr(cond)}) {")
                        ()
                        (*_self).push_indent()
                        ()
                        (*_self).gen_block(block)
                        ()
                        (*_self).pop_indent()
                        ()
                        match next_else:
                            Some(next) =>
                                (*_self).gen_else_branch_continuation(next)
                                ()
                            _ =>
                                (*_self).write_line("}")
                                ()
            _ =>
                (*_self).write_line("}")
                ()

    fn gen_else_branch_continuation(_self: &mut CppGen, branch: &kain_core::ast::ElseBranch):
        match branch:
            kain_core__ast__ElseBranch::Else(block) =>
                (*_self).write_line("} else {")
                ()
                (*_self).push_indent()
                ()
                (*_self).gen_block(block)
                ()
                (*_self).pop_indent()
                ()
                (*_self).write_line("}")
                ()
            kain_core__ast__ElseBranch::ElseIf(cond, block, next_else) =>
                (*_self).write_line(&"} else if ({(*_self).gen_expr(cond)}) {")
                ()
                (*_self).push_indent()
                ()
                (*_self).gen_block(block)
                ()
                (*_self).pop_indent()
                ()
                match next_else:
                    Some(next) =>
                        (*_self).gen_else_branch_continuation(next)
                        ()
                    _ =>
                        (*_self).write_line("}")
                        ()

    fn gen_expr(_self: &CppGen, expr: &kain_core::ast::Expr) -> String:
        match expr:
            kain_core__ast__Expr::Int(n, _) => n.to_string()
            kain_core__ast__Expr::Float(f, _) => f
            kain_core__ast__Expr::String(s, _) => f"std::string(\"{(*_self).escape_string(s)}\")"
            kain_core__ast__Expr::Bool(b, _) => if (*b): ("true").to_string() else: ("false").to_string()
            kain_core__ast__Expr::None(_) => ("std::nullopt").to_string()
            kain_core__ast__Expr::Ident(name, _) => name.clone()
            kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
                let l = (*_self).gen_expr(left)
                let r = (*_self).gen_expr(right)
                let cpp_op = (*_self).map_binop(op)
                f"({l} {cpp_op} {r})"
            kain_core__ast__Expr::Unary { op: op, operand: operand } =>
                let o = (*_self).gen_expr(operand)
                let cpp_op = (*_self).map_unaryop(op)
                f"({cpp_op}{o})"
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                let fn_name = (*_self).gen_expr(callee)
                if ((fn_name == "println") || (fn_name == "print")):
                    let arg_strs: Array<String> = args.iter().map(fn(a): (*_self).gen_expr(&a.value)).collect()
                    if (fn_name == "println"):
                        return "std::cout << {arg_strs.join(\" << \\\" \\\" << \")} << std::endl"
                    else:
                        return "std::cout << {arg_strs.join(\" << \\\" \\\" << \")}"
                    ()
                let arg_strs: Array<String> = args.iter().map(fn(a): (*_self).gen_expr(&a.value)).collect()
                "{fn_name}({arg_strs.join(\", \")})"
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                let recv = (*_self).gen_expr(receiver)
                let arg_strs: Array<String> = args.iter().map(fn(a): (*_self).gen_expr(&a.value)).collect()
                "{recv}.{method}({arg_strs.join(\", \")})"
            kain_core__ast__Expr::Field { object: object, field: field } => f"{(*_self).gen_expr(object)}.{field}"
            kain_core__ast__Expr::Index { object: object, index: index } => f"{(*_self).gen_expr(object)}[{(*_self).gen_expr(index)}]"
            kain_core__ast__Expr::Array(elements, _) =>
                let elems: Array<String> = elements.iter().map(fn(e): (*_self).gen_expr(e)).collect()
                "std::vector{{elems.join(\", \")}}"
            kain_core__ast__Expr::Tuple(elements, _) =>
                let elems: Array<String> = elements.iter().map(fn(e): (*_self).gen_expr(e)).collect()
                "std::make_tuple({elems.join(\", \")})"
            kain_core__ast__Expr::Struct { name: name, fields: fields } =>
                let field_strs: Array<String> = fields.iter().map(fn(__kain_closure_arg0): (*_self).gen_expr(__kain_closure_arg0.__kain_tuple_1)).collect()
                "{name}{{field_strs.join(\", \")}}"
            kain_core__ast__Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: fields } =>
                match fields:
                    kain_core__ast__EnumVariantFields::Unit => f"{enum_name}::{variant}"
                    kain_core__ast__EnumVariantFields::Tuple(args) =>
                        let arg_strs: Array<String> = args.iter().map(fn(a): (*_self).gen_expr(a)).collect()
                        "{enum_name}_{variant}{ {arg_strs.join(\", \")} }"
                    kain_core__ast__EnumVariantFields::Struct(fields) =>
                        let field_strs: Array<String> = fields.iter().map(fn(__kain_closure_arg1): f".{__kain_closure_arg1.__kain_tuple_0} = {(*_self).gen_expr(__kain_closure_arg1.__kain_tuple_1)}").collect()
                        "{enum_name}_{variant}{ {field_strs.join(\", \")} }"
            kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                if ((then_branch.stmts.len() == 1) && else_branch.is_some()):
                    match &then_branch.stmts[0]:
                        kain_core__ast__Stmt::Expr(then_expr) =>
                            match else_branch.map(fn(b): b):
                                Some(kain_core__ast__ElseBranch::Else(else_block)) =>
                                    if (else_block.stmts.len() == 1):
                                        match &else_block.stmts[0]:
                                            kain_core__ast__Stmt::Expr(else_expr) =>
                                                let cond = (*_self).gen_expr(condition)
                                                let then_code = (*_self).gen_expr(then_expr)
                                                let else_code = (*_self).gen_expr(else_expr)
                                                return f"({cond} ? {then_code} : {else_code})"
                                            _ =>
                                                ()
                                                ()
                                        ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                ("/* complex if expr */").to_string()
            kain_core__ast__Expr::Match { scrutinee: scrutinee, arms: arms } =>
                let scrut = (*_self).gen_expr(scrutinee)
                f"/* match {scrut} */"
            kain_core__ast__Expr::Lambda { params: params, body: body } =>
                let param_strs: Array<String> = params.iter().map(fn(p): f"auto {p.name}").collect()
                "[&]({param_strs.join(\", \")}){{(*_self).gen_expr(body)}}"
            kain_core__ast__Expr::Ref { mutable_: mutable_, value: value } => if (*mutable_): f"&{(*_self).gen_expr(value)}" else: f"&{(*_self).gen_expr(value)}"
            kain_core__ast__Expr::Deref(inner, _) => f"*{(*_self).gen_expr(inner)}"
            kain_core__ast__Expr::Cast { value: value, target: target } => f"static_cast<{(*_self).map_type(target)}>({(*_self).gen_expr(value)})"
            kain_core__ast__Expr::Range { start: start, end: end, inclusive: inclusive } =>
                let s = start.map(fn(e): (*_self).gen_expr(e)).unwrap_or_default()
                let e = end.map(fn(e): (*_self).gen_expr(e)).unwrap_or_default()
                "/* range {s}..{if (*inclusive): \"=\" else: \"\"}{e} */"
            kain_core__ast__Expr::Block(block_2, _) => "[&](){ /* block */ }()"
            kain_core__ast__Expr::Paren(inner, _) => f"({(*_self).gen_expr(inner)})"
            kain_core__ast__Expr::Return(maybe_expr, _) =>
                match maybe_expr:
                    Some(expr) => f"return {(*_self).gen_expr(expr)}"
                    _ => ("return").to_string()
            kain_core__ast__Expr::Break(_, _) => ("break").to_string()
            kain_core__ast__Expr::Continue(_) => ("continue").to_string()
            kain_core__ast__Expr::FString(parts, _) =>
                let mut result = String__from("std::string()")
                for part in parts:
                    match part:
                        kain_core__ast__Expr::String(s, _) =>
                            result.push_str(&f" + \"{s}\"")
                            ()
                        _ =>
                            result.push_str(&f" + std::to_string({(*_self).gen_expr(part)})")
                            ()
                ()
                result
            _ => ("/* unhandled expr */").to_string()

    fn map_type(_self: &CppGen, ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                let cpp_name = match name.as_str():
                    "Int" => "int64_t"
                    "Float" => "double"
                    "Bool" => "bool"
                    "String" => "std::string"
                    "Unit" => "void"
                    "()" => "void"
                    "Array" => "std::vector"
                    "Option" => "std::optional"
                    _ => name
                if generics.is_empty():
                    cpp_name.to_string()
                else:
                    let gen_strs: Array<String> = generics.iter().map(fn(g): (*_self).map_type(g)).collect()
                    "{cpp_name}<{gen_strs.join(\", \")}>"
            kain_core__ast__Type::Tuple(types, _) =>
                let type_strs: Array<String> = types.iter().map(fn(t): (*_self).map_type(t)).collect()
                "std::tuple<{type_strs.join(\", \")}>"
            kain_core__ast__Type::Array(inner, size, _) => f"std::array<{(*_self).map_type(inner)}, {size}>"
            kain_core__ast__Type::Slice(inner, _) => f"std::span<{(*_self).map_type(inner)}>"
            kain_core__ast__Type::Ref { mutable_: mutable_, inner: inner } => if (*mutable_): f"{(*_self).map_type(inner)}&" else: f"const {(*_self).map_type(inner)}&"
            kain_core__ast__Type::Ptr { inner: inner } => f"{(*_self).map_type(inner)}*"
            kain_core__ast__Type::Function { params: params, return_type: return_type } =>
                let param_strs: Array<String> = params.iter().map(fn(p): (*_self).map_type(p)).collect()
                "std::function<{(*_self).map_type(return_type)}({param_strs.join(\", \")})>"
            kain_core__ast__Type::Option(inner, _) => f"std::optional<{(*_self).map_type(inner)}>"
            kain_core__ast__Type::Result(ok, err, _) => f"std::variant<{(*_self).map_type(ok)}, {(*_self).map_type(err)}>"
            kain_core__ast__Type::Infer(_) => ("auto").to_string()
            kain_core__ast__Type::Never(_) => ("[[noreturn]] void").to_string()
            kain_core__ast__Type::Unit(_) => ("void").to_string()
            kain_core__ast__Type::Impl { trait_name: trait_name, generics: generics } =>
                if generics.is_empty():
                    f"/* impl {trait_name} */"
                else:
                    let gen_strs: Array<String> = generics.iter().map(fn(g): (*_self).map_type(g)).collect()
                    "/* impl {trait_name}<{gen_strs.join(\", \")}> */"

    fn map_binop(_self: &CppGen, op: &kain_core::ast::BinaryOp) -> String:
        match op:
            kain_core__ast__BinaryOp::Add => "+"
            kain_core__ast__BinaryOp::Sub => "-"
            kain_core__ast__BinaryOp::Mul => "*"
            kain_core__ast__BinaryOp::Div => "/"
            kain_core__ast__BinaryOp::Mod => "%"
            kain_core__ast__BinaryOp::Pow => "/* pow */"
            kain_core__ast__BinaryOp::And => "&&"
            kain_core__ast__BinaryOp::Or => "||"
            kain_core__ast__BinaryOp::Eq => "=="
            kain_core__ast__BinaryOp::Ne => "!="
            kain_core__ast__BinaryOp::Lt => "<"
            kain_core__ast__BinaryOp::Le => "<="
            kain_core__ast__BinaryOp::Gt => ">"
            kain_core__ast__BinaryOp::Ge => ">="
            kain_core__ast__BinaryOp::BitAnd => "&"
            kain_core__ast__BinaryOp::BitOr => "|"
            kain_core__ast__BinaryOp::BitXor => "^"
            kain_core__ast__BinaryOp::Shl => "<<"
            kain_core__ast__BinaryOp::Shr => ">>"
            kain_core__ast__BinaryOp::Assign => "="
            kain_core__ast__BinaryOp::AddAssign => "+="
            kain_core__ast__BinaryOp::SubAssign => "-="
            kain_core__ast__BinaryOp::MulAssign => "*="
            kain_core__ast__BinaryOp::DivAssign => "/="
            kain_core__ast__BinaryOp::Range => ".."
            kain_core__ast__BinaryOp::RangeInclusive => "..="

    fn map_unaryop(_self: &CppGen, op: &kain_core::ast::UnaryOp) -> String:
        match op:
            kain_core__ast__UnaryOp::Not => "!"
            kain_core__ast__UnaryOp::Neg => "-"
            kain_core__ast__UnaryOp::Ref => "&"
            kain_core__ast__UnaryOp::RefMut => "&"
            kain_core__ast__UnaryOp::BitNot => "~"
            kain_core__ast__UnaryOp::Deref => "*"

    fn escape_string(_self: &CppGen, s: String) -> String:
        let mut result = String__new_()
        for c in s.chars():
            match c:
                "\n" => result.push_str("\\n")
                "\t" => result.push_str("\\t")
                "\\" => result.push_str("\\\\")
                "\"" => result.push_str("\\\"")
                _ => result.push(c)
        ()
        result


