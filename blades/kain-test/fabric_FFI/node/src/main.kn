use std::javascript::bridge

fn app_root() -> String:
    return "labs/threejs_node_ffi_space_lab"

fn runtime_module() -> Any:
    return js_import("./labs/threejs_node_ffi_space_lab/helpers/space_lab_runtime.mjs")

fn output_path(name: String) -> String:
    return app_root() + "/outputs/" + name

fn main() -> String:
    let runtime = runtime_module()
    let summary = js_call_method(runtime, "buildApp", [app_root()])

    let report = "Kain Three.js Space Lab build\n"
    let report = report + "app: " + summary.name + "\n"
    let report = report + "scene: " + summary.scene_name + "\n"
    let report = report + "server_url: " + summary.server_url + "\n"
    let report = report + "html_entry: " + summary.html_entry + "\n"
    let report = report + "client_bundle: " + summary.client_bundle + "\n"
    let report = report + "star_count: " + str(summary.star_count) + "\n"
    let report = report + "beacon_count: " + str(summary.beacon_count) + "\n"

    write_file(output_path("kain_threejs_space_lab_build.txt"), report)
    println(report)
    return report
