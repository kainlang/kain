@wasm fn orb_hover_units(frame_units: Int, cycle_units: Int, amplitude_units: Int) -> Int:
    if cycle_units <= 1:
        return 0

    let mut local_frame = frame_units
    while local_frame >= cycle_units:
        local_frame = local_frame - cycle_units

    let half_cycle = cycle_units / 2
    if half_cycle <= 0:
        return 0

    if local_frame < half_cycle:
        return ((local_frame * amplitude_units * 2) / half_cycle) - amplitude_units

    let falling_frame = local_frame - half_cycle
    return amplitude_units - ((falling_frame * amplitude_units * 2) / half_cycle)

fn beacon_spin_units(frame_units: Int, speed_units: Int, cycle_units: Int) -> Int:
    if cycle_units <= 0:
        return 0

    let mut rotation_units = frame_units * speed_units
    while rotation_units >= cycle_units:
        rotation_units = rotation_units - cycle_units

    return rotation_units
