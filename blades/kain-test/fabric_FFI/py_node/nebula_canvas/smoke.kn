use std::python::bridge
use std::python::numpy
use std::javascript::bridge
use std::javascript::web

fn smoke_output(name: String) -> String:
    return "outputs/" + name

fn install_python_kernel():
    py_bridge_exec("import numpy as np\n\ndef kain_py_node_nebula(width, height, count, phase):\n    angles = np.linspace(0.0, np.pi * 2.0, count, endpoint=False, dtype=np.float32)\n    ring = 0.26 + 0.11 * np.sin(angles * 3.0 + phase * 0.06) + 0.05 * np.cos(angles * 7.0 - phase * 0.04)\n    xs = width * 0.5 + np.cos(angles) * width * ring\n    ys = height * 0.5 + np.sin(angles) * height * (0.21 + 0.08 * np.cos(angles * 5.0 + phase * 0.03))\n    glow = 0.28 + 0.56 * (0.5 + 0.5 * np.sin(angles * 6.0 + phase * 0.08))\n    points = []\n    for index in range(count):\n        points.append([int(xs[index]), int(ys[index]), int(4 + ((index + phase) % 6)), float(glow[index])])\n    return {'width': int(width), 'height': int(height), 'points': points, 'accent': '#7ef2ff', 'secondary': '#ffd166', 'background': 'radial-gradient(circle at top, #182844 0%, #060912 72%)', 'title': 'Nebula Canvas'}\n")

fn build_svg(payload) -> String:
    let width = payload.width
    let height = payload.height
    let points = payload.points
    let svg = "<svg viewBox='0 0 " + str(width) + " " + str(height) + "' xmlns='http://www.w3.org/2000/svg'>"
    let svg = svg + "<defs><linearGradient id='nebula-beam' x1='0%' y1='0%' x2='100%' y2='100%'><stop offset='0%' stop-color='" + payload.secondary + "' /><stop offset='100%' stop-color='" + payload.accent + "' /></linearGradient></defs>"
    let svg = svg + "<rect width='" + str(width) + "' height='" + str(height) + "' rx='28' fill='#050813' />"
    let i = 0
    while i + 1 < len(points):
        let point = points[i]
        let next = points[i + 1]
        let svg = svg + "<line x1='" + str(point[0]) + "' y1='" + str(point[1]) + "' x2='" + str(next[0]) + "' y2='" + str(next[1]) + "' stroke='url(#nebula-beam)' stroke-opacity='0.26' stroke-width='3' />"
        i = i + 1
    let first = points[0]
    let last = points[len(points) - 1]
    let svg = svg + "<line x1='" + str(last[0]) + "' y1='" + str(last[1]) + "' x2='" + str(first[0]) + "' y2='" + str(first[1]) + "' stroke='url(#nebula-beam)' stroke-opacity='0.26' stroke-width='3' />"
    let i = 0
    while i < len(points):
        let point = points[i]
        let color = payload.accent
        if i % 2 == 0:
            color = payload.secondary
        let svg = svg + "<circle cx='" + str(point[0]) + "' cy='" + str(point[1]) + "' r='" + str(point[2]) + "' fill='" + color + "' opacity='" + str(point[3]) + "' />"
        i = i + 1
    let svg = svg + "<circle cx='" + str(width / 2) + "' cy='" + str(height / 2) + "' r='24' fill='none' stroke='" + payload.accent + "' stroke-opacity='0.42' stroke-width='2' />"
    let svg = svg + "</svg>"
    return svg

test py_node_nebula_canvas:
    install_python_kernel()
    assert(py_numpy_available(), "numpy must be installed for the Python + Node smoke")
    let helper = js_bridge_import("./helpers/payload_studio.mjs")
    let payload = py_bridge_call("kain_py_node_nebula", [320, 200, 28, 19])
    let svg = build_svg(payload)
    let document = js_bridge_call_method_raw(helper, "makeDocumentPayload", [payload.title, svg, payload.background, payload.accent])
    let image = js_bridge_call_method_raw(helper, "makeSvgImagePayload", ["nebula_canvas", svg, payload.width, payload.height, payload.accent])
    let document_info = js_web_document_info(document)
    let image_info = js_web_canvas_info(image)
    let image_bytes = js_web_canvas_bytes(image)
    assert(document_info.mime_type == "text/html", "expected document payload")
    assert(image_info.kind == "canvas", "expected canvas image payload")
    assert(image_info.width == 320, "expected image width")
    assert(len(image_bytes) == image_info.byte_length, "expected image byte snapshot to match metadata")
    assert(js_web_document_text(document) != "", "expected document text content")

fn main() -> String:
    install_python_kernel()
    assert(py_numpy_available(), "numpy must be installed for the Python + Node smoke")

    let helper = js_bridge_import("./helpers/payload_studio.mjs")
    let payload = py_bridge_call("kain_py_node_nebula", [1440, 820, 84, 37])
    let svg = build_svg(payload)
    let document = js_bridge_call_method_raw(helper, "makeDocumentPayload", [payload.title, svg, payload.background, payload.accent])
    let image = js_bridge_call_method_raw(helper, "makeSvgImagePayload", ["nebula_canvas", svg, payload.width, payload.height, payload.accent])
    let html_path = smoke_output("nebula_canvas.html")
    let svg_path = smoke_output("nebula_canvas.svg")
    let report_path = smoke_output("nebula_canvas_report.txt")
    let document_info = js_web_document_info(document)
    let image_info = js_web_canvas_info(image)
    let bytes = js_web_canvas_bytes(image)

    js_web_document_write(html_path, document)
    js_web_canvas_write(svg_path, image)

    let report = "Python + Node nebula canvas smoke\n"
    let report = report + "title: " + payload.title + "\n"
    let report = report + "point_count: " + str(len(payload.points)) + "\n"
    let report = report + "document_bytes: " + str(document_info.byte_length) + "\n"
    let report = report + "image_kind: " + image_info.kind + "\n"
    let report = report + "image_dims: " + str(image_info.width) + "x" + str(image_info.height) + "\n"
    let report = report + "image_bytes: " + str(len(bytes)) + "\n"
    let report = report + "python_role: generated orbital point data + palette\n"
    let report = report + "node_role: packaged html and canvas payloads + wrote artifacts\n"
    let report = report + "kain_role: composed svg scene + runtime report\n"
    let report = report + "html_path: " + html_path + "\n"
    let report = report + "svg_path: " + svg_path

    write_file(report_path, report + "\n")
    println(report)
    return report
