{
  "schema_version": 1,
  "pipelines": [
    {
      "id": "doctor",
      "type": "kain",
      "description": "Capture the active compiler, feature, and toolchain surface.",
      "working_directory": "../..",
      "args": ["doctor"],
      "cleanup_paths": [],
      "expected_outputs": []
    },
    {
      "id": "import_ts",
      "type": "kain",
      "description": "Exercise the direct TypeScript import pipeline.",
      "working_directory": "outputs/import_ts",
      "args": [
        "import-ts",
        "../../fixtures/import_ts/typescript_bridge.ts",
        "--output",
        "typescript_bridge.imported.kn",
        "--report-json",
        "typescript_import_report.json"
      ],
      "cleanup_paths": [
        "outputs/import_ts/typescript_bridge.imported.kn",
        "outputs/import_ts/typescript_import_report.json"
      ],
      "expected_outputs": [
        "outputs/import_ts/typescript_bridge.imported.kn",
        "outputs/import_ts/typescript_import_report.json"
      ]
    },
    {
      "id": "import_asm",
      "type": "kain",
      "description": "Exercise the direct assembly import pipeline.",
      "working_directory": "outputs/import_asm",
      "args": [
        "import-asm",
        "../../fixtures/import_asm/firmware_seed.asm",
        "--format",
        "6502-furby"
      ],
      "cleanup_paths": [
        "outputs/import_asm/generated",
        "outputs/import_asm/Research"
      ],
      "expected_outputs": [
        "outputs/import_asm/generated/furby_firmware.kn",
        "outputs/import_asm/generated/furby_map.json",
        "outputs/import_asm/Research/furby/furby_canonical.asm",
        "outputs/import_asm/Research/furby/furby_recovery_report.json"
      ]
    },
    {
      "id": "c_ffi_native_build",
      "type": "process",
      "description": "Build the dedicated C ABI bridge fixture for the standalone FFI smoke.",
      "working_directory": "fixtures/c_ffi",
      "executable": "python",
      "args": [
        "../../build_shared_library.py",
        "native/beacon_math.c",
        "beacon_math",
        "native/beacon_math.build.txt"
      ],
      "cleanup_paths": [
        "fixtures/c_ffi/native/beacon_math.build.txt"
      ],
      "expected_outputs": [
        "fixtures/c_ffi/native/beacon_math.build.txt"
      ]
    },
    {
      "id": "c_ffi_interpret",
      "type": "kain",
      "description": "Interpret a standalone use c::... smoke and emit C ABI bridge outputs.",
      "working_directory": "fixtures/c_ffi",
      "args": [
        "smoke.kn",
        "-t",
        "interpret"
      ],
      "cleanup_paths": [
        "outputs/c_ffi/beacon_signature.txt",
        "outputs/c_ffi/beacon_report.txt",
        "fixtures/c_ffi/.kain/cache/c_ffi"
      ],
      "expected_outputs": [
        "outputs/c_ffi/beacon_signature.txt",
        "outputs/c_ffi/beacon_report.txt"
      ]
    },
    {
      "id": "crate_import",
      "type": "kain",
      "description": "Run the explicit import-crate lane and capture generated Rust FFI bindings.",
      "working_directory": "fixtures/crate_ffi",
      "args": [
        "import-crate",
        "allinone_crate_lab",
        "--mode",
        "both",
        "--crate-path",
        "local_crate",
        "--output",
        "../../outputs/crate_ffi/generated",
        "--report-json",
        "../../outputs/crate_ffi/generated/allinone_crate_lab_report_override.json"
      ],
      "cleanup_paths": [
        "outputs/crate_ffi/generated",
        "fixtures/crate_ffi/.kain/cache/crate_ffi"
      ],
      "expected_outputs": [
        "outputs/crate_ffi/generated/allinone_crate_lab.kn",
        "outputs/crate_ffi/generated/allinone_crate_lab_prelude.kn",
        "outputs/crate_ffi/generated/allinone_crate_lab_report.json",
        "outputs/crate_ffi/generated/allinone_crate_lab_report.txt",
        "outputs/crate_ffi/generated/allinone_crate_lab_report_override.json"
      ]
    },
    {
      "id": "crate_ffi_interpret",
      "type": "kain",
      "description": "Interpret a standalone use rust::... smoke and emit Rust crate FFI outputs.",
      "working_directory": "fixtures/crate_ffi",
      "args": [
        "smoke.kn",
        "-t",
        "interpret"
      ],
      "cleanup_paths": [
        "outputs/crate_ffi/cargo_wave.txt",
        "outputs/crate_ffi/cargo_bridge_report.txt",
        "fixtures/crate_ffi/.kain/cache/crate_ffi"
      ],
      "expected_outputs": [
        "outputs/crate_ffi/cargo_wave.txt",
        "outputs/crate_ffi/cargo_bridge_report.txt"
      ]
    },
    {
      "id": "gpu_artifacts",
      "type": "kain",
      "description": "Emit paired SPIR-V, reflection, and Rust GPU host artifacts.",
      "working_directory": "fixtures/gpu",
      "args": [
        "gpu-artifacts",
        "pipeline_shader.kn",
        "--output",
        "../../outputs/gpu_artifacts/allinone_gpu"
      ],
      "cleanup_paths": [
        "outputs/gpu_artifacts/allinone_gpu.spv",
        "outputs/gpu_artifacts/allinone_gpu.gpu.rs",
        "outputs/gpu_artifacts/allinone_gpu.reflect.json",
        "outputs/gpu_artifacts/allinone_gpu.shader_bundle.json"
      ],
      "expected_outputs": [
        "outputs/gpu_artifacts/allinone_gpu.spv",
        "outputs/gpu_artifacts/allinone_gpu.gpu.rs",
        "outputs/gpu_artifacts/allinone_gpu.reflect.json",
        "outputs/gpu_artifacts/allinone_gpu.shader_bundle.json"
      ]
    },
    {
      "id": "omni_build",
      "type": "kain",
      "description": "Stage TS, C, and ASM imports and emit TypeScript, KainScript, shader, UE5, and GPU omni outputs.",
      "working_directory": "fixtures/omni",
      "args": [
        "omni",
        "build",
        "--manifest",
        "KAIN.omni.toml"
      ],
      "cleanup_paths": [
        "outputs/omni/staged",
        "outputs/omni/dist",
        "outputs/omni/ue5",
        "outputs/omni/ue5_editor",
        "outputs/omni/workspace",
        "fixtures/omni/.kain/cache"
      ],
      "expected_outputs": [
        "outputs/omni/staged/omni_signal.kn",
        "outputs/omni/staged/omni_math.kn",
        "outputs/omni/staged/omni_firmware.kn",
        "outputs/omni/dist/allinone_omni.ts",
        "outputs/omni/dist/allinone_omni.ks",
        "outputs/omni/dist/allinone_omni.hlsl",
        "outputs/omni/dist/allinone_omni.usf",
        "outputs/omni/dist/allinone_omni.spv",
        "outputs/omni/dist/gpu_bundle/entry.rs",
        "outputs/omni/dist/gpu_bundle/entry.gpu.rs",
        "outputs/omni/dist/gpu_bundle/entry.reflect.json",
        "outputs/omni/dist/gpu_bundle/entry.spv",
        "outputs/omni/ue5/AllInOneOmni/Source/AllInOneOmni/Public/AllInOneOmni.h",
        "outputs/omni/ue5_editor/AllInOneOmniEditor/Source/AllInOneOmniEditor/Public/AllInOneOmniEditor.h"
      ]
    },
    {
      "id": "fabric_native_build",
      "type": "process",
      "description": "Build the local Fabric C ABI sidecar.",
      "working_directory": "fixtures/fabric",
      "executable": "python",
      "args": [
        "../../build_shared_library.py",
        "native/image_fx.c",
        "image_fx",
        "native/image_fx.build.txt"
      ],
      "cleanup_paths": [
        "fixtures/fabric/native/image_fx.build.txt"
      ],
      "expected_outputs": [
        "fixtures/fabric/native/image_fx.build.txt"
      ]
    },
    {
      "id": "fabric_validate",
      "type": "kain",
      "description": "Validate the combined Fabric manifest.",
      "working_directory": "fixtures/fabric",
      "args": [
        "fabric",
        "validate",
        "--manifest",
        "KAIN.fabric.toml"
      ],
      "cleanup_paths": [],
      "expected_outputs": []
    },
    {
      "id": "fabric_run",
      "type": "kain",
      "description": "Run the combined Fabric manifest across all local adapters.",
      "working_directory": "fixtures/fabric",
      "args": [
        "fabric",
        "run",
        "--manifest",
        "KAIN.fabric.toml"
      ],
      "cleanup_paths": [
        "outputs/fabric/reports",
        "fixtures/fabric/.kain/cache"
      ],
      "expected_outputs": [
        "outputs/fabric/reports"
      ]
    },
    {
      "id": "ue5_packager",
      "type": "kain",
      "description": "Run the local minimal UE5 plugin packager lane.",
      "working_directory": "fixtures/ue5",
      "args": [
        "build",
        "--ue5"
      ],
      "cleanup_paths": [
        "outputs/ue5/AllInOneUe5Smoke",
        "fixtures/ue5/.kain/cache"
      ],
      "expected_outputs": [
        "outputs/ue5/AllInOneUe5Smoke/AllInOneUe5Smoke.uplugin"
      ]
    },
    {
      "id": "compiler_owned_intent",
      "type": "process",
      "description": "Run the compiler-owned intent quartet smoke through kain run plus LLVM bundle staging.",
      "working_directory": "compiler_owned_intent",
      "executable": "python",
      "args": [
        "run_smoke.py"
      ],
      "cleanup_paths": [
        "compiler_owned_intent/output"
      ],
      "expected_outputs": [
        "compiler_owned_intent/output/compiler_owned_intent.ll",
        "compiler_owned_intent/output/compiler_owned_intent.runtime_contract.json",
        "compiler_owned_intent/output/compiler_owned_intent.realtime_app.json",
        "compiler_owned_intent/output/summary.txt"
      ]
    }
  ]
}
