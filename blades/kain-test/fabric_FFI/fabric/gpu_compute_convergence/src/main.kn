use std::interop::bridge

struct FabricBuffers:
    src: Any
    dst: Any
    report: String

fn push_f32_demo(bytes: Array<Int>, value: Int) -> Void:
    if value == 1:
        bytes.push(0)
        bytes.push(0)
        bytes.push(128)
        bytes.push(63)
        return
    if value == 2:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        return
    if value == 3:
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        bytes.push(64)
        return
    if value == 4:
        bytes.push(0)
        bytes.push(0)
        bytes.push(128)
        bytes.push(64)
        return
    bytes.push(0)
    bytes.push(0)
    bytes.push(0)
    bytes.push(0)
    return

fn build_src_bytes(start: Int, step: Int, count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        let value = start + index * step
        push_f32_demo(bytes, value)
        index = index + 1
    return bytes

fn build_zero_bytes(count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        index = index + 1
    return bytes

fn main() -> FabricBuffers:
    let settings = fabric_inputs.python_source.settings
    let src_bytes = build_src_bytes(settings.start, settings.step, settings.count)
    let dst_bytes = build_zero_bytes(settings.count)
    let src = interop_shared_buffer_from_bytes(
        src_bytes,
        "f32",
        [settings.count],
        "f32",
        "application/octet-stream",
    )
    let dst = interop_shared_buffer_from_bytes(
        dst_bytes,
        "f32",
        [settings.count],
        "f32",
        "application/octet-stream",
    )
    let report = settings.title + ":" + str(settings.start) + ":" + str(settings.step) + ":" + str(settings.bias)
    return FabricBuffers { src: src, dst: dst, report: report }
