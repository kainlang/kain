{
  "schema_version": 1,
  "target": "rust",
  "render": {
    "scenes": [
      {
        "viewport_node": "surface.node.6",
        "viewport_kind": "viewport3d",
        "scene": "tensor_stream_probe",
        "title": "Tensor Stream Viewport",
        "material_refs": [],
        "shader_bundle_ref_keys": [
          "shader::StreamPulse::compute"
        ]
      }
    ],
    "materials": []
  },
  "shader_bundle_refs": [
    {
      "key": "shader::StreamPulse::compute",
      "shader": "StreamPulse",
      "module_name": "StreamPulse",
      "stage": "compute",
      "entry_point": "main",
      "source": "kain-core",
      "execution_domain": "tensor-stream",
      "workgroup_size": [
        8,
        8,
        1
      ],
      "dispatch_size": [
        32,
        1,
        1
      ],
      "resource_bindings": [
        {
          "key": "src",
          "type": "storage_buffer",
          "stage": "compute",
          "access": "read",
          "slot": 0
        },
        {
          "key": "dst",
          "type": "storage_buffer",
          "stage": "compute",
          "access": "write",
          "slot": 1
        }
      ],
      "tensor_bindings": [
        {
          "key": "src",
          "element_type": "f32",
          "shape": [
            "dispatch.x"
          ],
          "role": "input",
          "contract": "kain.shared.buffer"
        },
        {
          "key": "dst",
          "element_type": "f32",
          "shape": [
            "dispatch.x"
          ],
          "role": "output",
          "contract": "kain.shared.buffer"
        }
      ],
      "stream_bindings": [
        {
          "key": "src",
          "direction": "ingress",
          "cadence": "continuous",
          "contract": "kain.shared.buffer"
        },
        {
          "key": "dst",
          "direction": "egress",
          "cadence": "continuous",
          "contract": "kain.shared.buffer"
        }
      ],
      "neural_nodes": [
        {
          "key": "stream_pulse",
          "op": "pulse_mix",
          "inputs": [
            "src"
          ],
          "outputs": [
            "dst"
          ],
          "stateful": false
        }
      ]
    }
  ],
  "assets": [],
  "tool_caps": [
    "gpu.compute",
    "gpu.compute-plan",
    "gpu.shader",
    "tool.graph",
    "viewport.3d"
  ],
  "requirements": [
    "data.continuous-stream",
    "gpu.compute-dispatch",
    "gpu.compute-plan",
    "gpu.shader-bundles",
    "host.native-ui",
    "interop.shared-buffer",
    "runtime.contract.bundle",
    "scene.runtime-bundle",
    "shader.bundle.metadata",
    "viewport.presented-or-fallback"
  ]
}