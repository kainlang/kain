use std::interop::bridge

struct GpuSeedOutputs:
    src: Any
    dst: Any
    report: String

fn push_f32_demo(bytes: Array<Int>, value: Int) -> Void:
    if value == 1:
        bytes.push(0)
        bytes.push(0)
        bytes.push(128)
        bytes.push(63)
        return
    if value == 2:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        return
    if value == 3:
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        bytes.push(64)
        return
    if value == 4:
        bytes.push(0)
        bytes.push(0)
        bytes.push(128)
        bytes.push(64)
        return
    bytes.push(0)
    bytes.push(0)
    bytes.push(0)
    bytes.push(0)
    return

fn build_src_bytes(start: Int, step: Int, count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        push_f32_demo(bytes, start + index * step)
        index = index + 1
    return bytes

fn build_zero_bytes(count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        index = index + 1
    return bytes

fn main() -> GpuSeedOutputs:
    let settings = fabric_inputs.python_source.settings
    let src = interop_shared_buffer_from_bytes(
        build_src_bytes(settings.gpu_start, settings.gpu_step, settings.gpu_count),
        "f32",
        [settings.gpu_count],
        "f32",
        "application/octet-stream",
    )
    let dst = interop_shared_buffer_from_bytes(
        build_zero_bytes(settings.gpu_count),
        "f32",
        [settings.gpu_count],
        "f32",
        "application/octet-stream",
    )
    let report = "gpu-seed:" + str(settings.gpu_start) + ":" + str(settings.gpu_step) + ":" + str(settings.gpu_count)
    return GpuSeedOutputs { src: src, dst: dst, report: report }
