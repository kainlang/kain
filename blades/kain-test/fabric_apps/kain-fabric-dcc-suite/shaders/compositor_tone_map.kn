shader compute DccSuiteCompositorToneMap(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("dcc_suite_compositor_tone_map", "compositor_tone_map", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let source_value = src[index]
    let exposure_shaped = (source_value * 0.44) + 0.12
    let filmic_curve = (source_value * 0.18) + 0.11
    let grade_lift = (source_value * 0.10) + 0.06
    let composited_value = exposure_shaped + filmic_curve + grade_lift
    dst[index] = composited_value
    return vec4(composited_value, exposure_shaped, filmic_curve, grade_lift)
