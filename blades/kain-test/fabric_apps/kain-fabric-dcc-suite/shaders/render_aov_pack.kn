shader compute DccSuiteRenderAovPack(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("dcc_suite_render_aov_pack", "render_aov_pack", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let source_value = src[index]
    let beauty_like = source_value * 0.50
    let utility_like = (source_value * 0.20) + 0.13
    let mask_like = (source_value * 0.12) + 0.08
    let packed_aov_value = beauty_like + utility_like + mask_like
    dst[index] = packed_aov_value
    return vec4(beauty_like, utility_like, mask_like, packed_aov_value)
