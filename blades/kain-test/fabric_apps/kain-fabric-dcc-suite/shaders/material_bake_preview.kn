shader compute DccSuiteMaterialBakePreview(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("dcc_suite_material_bake_preview", "copy_preview_stream", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let input_value = src[index]
    let normalized = input_value * 0.25
    let roughness_like = 1.0 - (normalized * 0.5)
    let metallic_like = (normalized * 0.35) + 0.1
    dst[index] = normalized
    return vec4(normalized, roughness_like, metallic_like, 1.0)
