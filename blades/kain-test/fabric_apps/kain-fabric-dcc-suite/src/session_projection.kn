fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let session_report = fabric_inputs.dcc_suite_seed.session_report
    let material_report = fabric_inputs.material_authoring_projection.material_authoring_report
    let svg_report = fabric_inputs.svg_material_mask_projection.svg_mask_report
    return "lane-plan:" + settings.workspace_mode + ":" + session_report + ":" + material_report + ":" + svg_report
