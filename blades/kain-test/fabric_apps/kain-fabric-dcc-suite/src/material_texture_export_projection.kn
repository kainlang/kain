fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn material_texture_export_report_path() -> String:
    return app_state_root() + "/material_texture_export_report.json"

fn build_material_texture_export_report_json(settings: Any, material_summary: String, svg_summary: String) -> String:
    let packed_output_count = 4
    let udim_tile_count = settings.runtimePackCount
    let channel_pack_profile = "metalrough+orm+height+emissive"
    let runtime_receipt_profile = "gltf_pbr+usd_preview+native_ui"
    let json = "{\n"
    let json = json + "  \\\\\\\"kind\\\\\\\": \\\\\\\"material_texture_export_report\\\\\\\",\\n"
    let json = json + "  \\\\\\\"project\\\\\\\": \\\\\\\"" + settings.projectName + "\\\\\\\",\\n"
    let json = json + "  \\\\\\\"texture_set_id\\\\\\\": \\\\\\\"textureset/hero_body_udim1001\\\\\\\",\\n"
    let json = json + "  \\\\\\\"export_preset\\\\\\\": \\\\\\\"export/metalrough_orm_painter\\\\\\\",\\n"
    let json = json + "  \\\\\\\"target_runtime\\\\\\\": \\\\\\\"" + runtime_receipt_profile + "\\\\\\\",\\n"
    let json = json + "  \\\\\\\"channel_pack_profile\\\\\\\": \\\\\\\"" + channel_pack_profile + "\\\\\\\",\\n"
    let json = json + "  \\\\\\\"packed_output_count\\\\\\\": " + str(packed_output_count) + ",\\n"
    let json = json + "  \\\\\\\"udim_tile_count\\\\\\\": " + str(udim_tile_count) + ",\\n"
    let json = json + "  \\\\\\\"output_root\\\\\\\": \\\\\\\"apps/kain-fabric-dcc-suite/outputs/materials/hero_surface\\\\\\\",\\n"
    let json = json + "  \\\\\\\"upstream_material_summary\\\\\\\": \\\\\\\"" + material_summary + "\\\\\\\",\\n"
    let json = json + "  \\\\\\\"upstream_svg_summary\\\\\\\": \\\\\\\"" + svg_summary + "\\\\\\\"\\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let material_summary = fabric_inputs.material_authoring_projection.material_authoring_report
    let svg_summary = fabric_inputs.svg_material_mask_projection.svg_mask_report
    let report_json = build_material_texture_export_report_json(settings, material_summary, svg_summary)

    write_file(material_texture_export_report_path(), report_json)

    return "material-export:scene_assembly:packs=4:udim=12"
