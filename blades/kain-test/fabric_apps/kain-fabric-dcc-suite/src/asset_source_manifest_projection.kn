fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn asset_source_manifest_report_path() -> String:
    return app_state_root() + "/asset_source_manifest_report.json"

fn build_asset_source_manifest_report_json(settings: Any, source_id: String, source_uri: String, import_profile_id: String, transcode_profile_id: String, lineage_id: String) -> String:
    let json = "{\n"
    let json = json + "  \"kind\": \"asset_source_manifest_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"source_id\": \"" + source_id + "\",\n"
    let json = json + "  \"source_uri\": \"" + source_uri + "\",\n"
    let json = json + "  \"import_profile_id\": \"" + import_profile_id + "\",\n"
    let json = json + "  \"transcode_profile_id\": \"" + transcode_profile_id + "\",\n"
    let json = json + "  \"lineage_id\": \"" + lineage_id + "\",\n"
    let json = json + "  \"source_priority\": \"source_id_first\",\n"
    let json = json + "  \"manifest_policy\": \"asset source records own canonical ids before payload expansion\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let source_id = fabric_inputs.asset_ingest_session.source_id
    let source_uri = fabric_inputs.asset_ingest_session.source_uri
    let import_profile_id = fabric_inputs.asset_ingest_session.import_profile_id
    let transcode_profile_id = fabric_inputs.asset_ingest_session.transcode_profile_id
    let lineage_id = "asset_lineage/" + source_id
    let report_json = build_asset_source_manifest_report_json(settings, source_id, source_uri, import_profile_id, transcode_profile_id, lineage_id)

    write_file(asset_source_manifest_report_path(), report_json)

    return "asset-source-manifest:" + source_id + ":" + transcode_profile_id
