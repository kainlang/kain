fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn material_uv_policy_report_path() -> String:
    return app_state_root() + "/material_uv_policy_report.json"

fn build_material_uv_policy_report_json(settings: Any, material_document: String) -> String:
    let uv_policy_id = "uv_policy/udim_tiled_islands"
    let texel_density_target = 256
    let texel_density_range = "192-320"
    let chart_policy = "rotation_margin_priority_pack"
    let json = "{\\n"
    let json = json + "  \\\"kind\\\": \\\"material_uv_policy_report\\\",\\n"
    let json = json + "  \\\"project\\\": \\\"" + settings.project_name + "\\\",\\n"
    let json = json + "  \\\"workspace_mode\\\": \\\"" + settings.workspace_mode + "\\\",\\n"
    let json = json + "  \\\"material_document\\\": \\\"" + material_document + "\\\",\\n"
    let json = json + "  \\\"uv_policy_id\\\": \\\"" + uv_policy_id + "\\\",\\n"
    let json = json + "  \\\"texel_density_target\\\": " + str(texel_density_target) + ",\\n"
    let json = json + "  \\\"texel_density_range\\\": \\\"" + texel_density_range + "\\\",\\n"
    let json = json + "  \\\"chart_policy\\\": \\\"" + chart_policy + "\\\",\\n"
    let json = json + "  \\\"tile_policy\\\": \\\"hero_body_udim_1001_to_1004\\\",\\n"
    let json = json + "  \\\"padding_policy\\\": \\\"2_to_4_px_dynamic\\\"\\n"
    let json = json + "}\\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let material_document = fabric_inputs.dcc_suite_seed.material_authoring_document
    let report_json = build_material_uv_policy_report_json(settings, material_document)

    write_file(material_uv_policy_report_path(), report_json)

    return "material-uv-policy:" + settings.workspace_mode + ":policy=udim_tiled_islands:density=256"