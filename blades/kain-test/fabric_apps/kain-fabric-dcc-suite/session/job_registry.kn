struct AutomationJobDescriptor:
    id: String
    label: String
    schedule: String
    summary: String

fn default_jobs() -> Array<AutomationJobDescriptor>:
    return [
        AutomationJobDescriptor {
            id: "thumbnail_refresh",
            label: "Thumbnail Refresh",
            schedule: "on_asset_ingest",
            summary: "Refreshes asset thumbnails and preview products after ingest"
        },
        AutomationJobDescriptor {
            id: "nightly_material_rebake",
            label: "Nightly Material Rebake",
            schedule: "nightly",
            summary: "Rebuilds preview materials, svg mask atlases, and cached bake outputs"
        },
        AutomationJobDescriptor {
            id: "svg_mask_cache_rebuild",
            label: "SVG Mask Cache Rebuild",
            schedule: "on_material_edit",
            summary: "Recompiles vector mask stacks and anchor projections after material-layer edits"
        },
        AutomationJobDescriptor {
            id: "smart_material_cache_warmup",
            label: "Smart Material Cache Warmup",
            schedule: "on_scene_open",
            summary: "Stages smart material presets, packed brush responses, and texture-set defaults"
        },
        AutomationJobDescriptor {
            id: "rig_health_audit",
            label: "Rig Health Audit",
            schedule: "on_publish_candidate",
            summary: "Recomputes rig and graph health before publish promotion"
        },
        AutomationJobDescriptor {
            id: "simulation_cache_warmup",
            label: "Simulation Cache Warmup",
            schedule: "on_scene_open",
            summary: "Stages warm caches for repeatable simulation review"
        },
        AutomationJobDescriptor {
            id: "evaluation_graph_recompute",
            label: "Evaluation Graph Recompute",
            schedule: "on_scene_open_and_selection_change",
            summary: "Recomputes dependency flow and graph cooks after authoring changes"
        },
        AutomationJobDescriptor {
            id: "cache_materialization_pass",
            label: "Cache Materialization Pass",
            schedule: "on_evaluation_cook_or_publish_candidate",
            summary: "Materializes cooked graph output for render, publish, and bridge consumers"
        },
        AutomationJobDescriptor {
            id: "tensor_readiness_probe",
            label: "Tensor Readiness Probe",
            schedule: "manual_or_nightly",
            summary: "Checks tensor lane readiness, training corpus shape, and PyTorch availability"
        },
        AutomationJobDescriptor {
            id: "tensor_artifact_audit",
            label: "Tensor Artifact Audit",
            schedule: "on_publish_candidate",
            summary: "Verifies tensor feature buffers, checkpoints, and inference outputs before publish"
        },
        AutomationJobDescriptor {
            id: "publish_receipt_archive",
            label: "Publish Receipt Archive",
            schedule: "on_publish",
            summary: "Archives publish receipts and operator-facing reports"
        },
        AutomationJobDescriptor {
            id: "jobs_retry_requeue",
            label: "Jobs Retry And Requeue",
            schedule: "on_job_failure",
            summary: "Requeues failed jobs using retry ledgers and resumable receipts"
        },
        AutomationJobDescriptor {
            id: "launch_manifest_materialize",
            label: "Launch Manifest Materialize",
            schedule: "on_workspace_preset_change",
            summary: "Materializes launch manifests and bundle-ready workspace presets"
        },
        AutomationJobDescriptor {
            id: "runtime_reflection_refresh",
            label: "Runtime Reflection Refresh",
            schedule: "on_schema_or_registry_change",
            summary: "Refreshes runtime reflection catalogs and registry-driven metadata views"
        },
        AutomationJobDescriptor {
            id: "delivery_materialization_pass",
            label: "Delivery Materialization Pass",
            schedule: "nightly_or_promoted",
            summary: "Runs delivery materialization and promotion-safe receipt generation"
        }
    ]
