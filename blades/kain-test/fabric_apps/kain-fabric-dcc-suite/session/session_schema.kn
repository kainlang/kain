struct CommandEnvelope:
    id: String
    kind: String
    scope: String
    issued_at: String
    payload_summary: String
    workspace_mode: String
    selection_summary: String

struct ProjectState:
    project_id: String
    project_name: String
    schema_version: Int

struct WorkspaceState:
    active_mode: String
    layout_id: String
    available_modes: Array<String>

struct WorkbenchState:
    active_workbench_id: String
    active_tab_group_id: String
    active_dock_id: String
    active_pane_id: String
    last_materialized_shell_path: String
    last_runtime_snapshot_path: String

struct ViewportState:
    active_mode: String
    overlay_policy_id: String
    tool_policy_id: String
    view_profile_id: String
    hud_density: String
    mode_count: Int
    mode_summary: String
    mode_registry_summary: String
    mode_registry_entries: Array<String>

struct ToolState:
    active_tool: String
    brush_radius: Int
    brush_strength_percent: Int
    brush_falloff_profile: String
    brush_surface_policy: String
    uv_policy_id: String

struct GizmoState:
    active_profile_id: String
    mode: String
    space: String
    snap_enabled: Bool
    visible: Bool
    drag_trigger: String

struct SelectionState:
    entity_ids: Array<String>
    subobject_ids: Array<String>

struct SceneState:
    active_document_id: String
    active_collection_id: String
    active_variant: String

struct MeshState:
    active_document_id: String
    active_edit_target_id: String
    mesh_authoring_policy_id: String
    active_primitive_template_id: String
    topology_edit_mode: String

struct TopologyHistoryState:
    history_document_id: String
    history_document_uri: String
    last_lineage_reason: String
    last_upstream_topology_report: String
    last_active_edit_target_id: String
    last_topology_output_id: String

struct AssetIngestState:
    last_package_uri: String
    last_package_kind: String
    staged_package_count: Int

struct AssetPipelineState:
    source_id: String
    session_route_scope: String
    source_priority: String
    transcode_profiles: Array<String>
    routed_runtime_ids: Array<String>
    lineage_receipts: Array<String>
    registry_entries: Array<String>
    summary: String

struct MaterialState:
    active_material_id: String
    active_graph_id: String
    active_texture_set_id: String
    active_layer_stack_id: String
    active_svg_document_id: String
    active_bake_preset_id: String
    active_export_preset_id: String
    preview_profile: String
    channel_profile: String
    layer_response_profile: String
    brush_response_profile: String
    smart_mask_profile: String
    scan_ingest_profile: String
    uv_policy_id: String
    texture_set_receipt_id: String
    export_receipt_id: String
    deformation_surface_id: String
    paint_resolution: Int
    texel_density_target: Int

struct RigState:
    active_rig_id: String
    active_control_set: String
    deformation_profile: String

struct AnimationState:
    active_clip_id: String
    frame: Int
    playback_mode: String

struct SimulationState:
    cache_profile: String
    last_tick_frame: Int
    solver_profile: String

struct EvaluationState:
    graph_document_id: String
    graph_document_uri: String
    last_recompute_reason: String
    last_upstream_dependency_report: String
    last_cook_output_id: String

struct CacheState:
    cache_graph_id: String
    cache_graph_uri: String
    last_materialization_reason: String
    last_materialized_resource_id: String
    last_cache_report_path: String

struct RenderState:
    camera_id: String
    view_transform: String
    render_profile: String
    lighting_profile_id: String
    aov_set: String
    accumulation_profile: String
    denoise_profile: String
    review_capture_profile: String

struct CompositorState:
    active_stack_id: String
    last_rebuild_reason: String

struct PublishState:
    profile_id: String
    target_bundle: String
    delivery_channel: String

struct AutomationState:
    enabled: Bool
    active_job_ids: Array<String>
    last_audit_status: String

struct DirtyState:
    asset_dirty: Bool
    sculpt_dirty: Bool
    topology_dirty: Bool
    material_dirty: Bool
    rig_dirty: Bool
    animation_dirty: Bool
    simulation_dirty: Bool
    render_dirty: Bool
    compositor_dirty: Bool
    publish_dirty: Bool
    tensor_dirty: Bool
    session_needs_save: Bool

struct JobState:
    latest_fabric_session_id: String
    latest_fabric_status: String
    active_intents: Array<String>
    active_jobs: Array<String>

struct ReportState:
    mesh_contract_report_id: String
    mesh_contract_report_uri: String
    mesh_contract_report_path: String

struct RuntimeLaneEntry:
    id: String
    label: String
    owner: String
    runtime: String
    summary: String

struct RuntimePackEntry:
    id: String
    label: String
    category: String
    summary: String

struct FabricIntentEntry:
    id: String
    label: String
    lane: String
    graph: String
    summary: String

struct SessionDocument:
    project: ProjectState
    workspace: WorkspaceState
    workbench: WorkbenchState
    viewport: ViewportState
    tooling: ToolState
    gizmo: GizmoState
    selection: SelectionState
    scene: SceneState
    mesh: MeshState
    topology_history: TopologyHistoryState
    ingest: AssetIngestState
    asset_pipeline: AssetPipelineState
    materials: MaterialState
    rig: RigState
    animation: AnimationState
    simulation: SimulationState
    evaluation: EvaluationState
    cache: CacheState
    render: RenderState
    compositor: CompositorState
    publish: PublishState
    automation: AutomationState
    reports: ReportState
    runtime_lane_registry: Array<RuntimeLaneEntry>
    runtime_pack_registry: Array<RuntimePackEntry>
    fabric_intent_registry: Array<FabricIntentEntry>
    command_registry: Array<CommandRegistryEntry>
    assist: AssistState
    dirty: DirtyState
    jobs: JobState

fn default_workspace_modes() -> Array<String>:
    return [
        "scene_assembly",
        "sculpt_model",
        "material_lookdev",
        "rig_anim",
        "sim_fx",
        "render_comp",
        "publish_automation"
    ]

fn default_viewport_mode_for_workspace_mode(workspace_mode: String) -> ViewportState:
    if workspace_mode == "sculpt_model":
        return ViewportState {
            active_mode: "model",
            overlay_policy_id: "overlay_policy/model_topology",
            tool_policy_id: "tool_policy/model_edit_first",
            view_profile_id: "view_profile/model_topology",
            hud_density: "medium",
            mode_count: 6,
            mode_summary: "layout | model | sculpt | paint | lookdev | render",
            mode_registry_summary: "layout => overlay_policy/layout_clear | model => overlay_policy/model_topology | sculpt => overlay_policy/sculpt_brush | paint => overlay_policy/paint_layers | lookdev => overlay_policy/lookdev_balanced | render => overlay_policy/render_review",
            mode_registry_entries: ["Layout [layout] => overlay_policy/layout_clear / tool_policy/layout_nav_first / view_profile/layout_blocking", "Model [model] => overlay_policy/model_topology / tool_policy/model_edit_first / view_profile/model_topology", "Sculpt [sculpt] => overlay_policy/sculpt_brush / tool_policy/sculpt_brush_first / view_profile/sculpt_surface", "Paint [paint] => overlay_policy/paint_layers / tool_policy/paint_layer_first / view_profile/paint_authoring", "Lookdev [lookdev] => overlay_policy/lookdev_balanced / tool_policy/lookdev_eval / view_profile/lookdev_balanced", "Render [render] => overlay_policy/render_review / tool_policy/render_review / view_profile/render_room"]
        }
    if workspace_mode == "material_lookdev":
        return ViewportState {
            active_mode: "lookdev",
            overlay_policy_id: "overlay_policy/lookdev_balanced",
            tool_policy_id: "tool_policy/lookdev_eval",
            view_profile_id: "view_profile/lookdev_balanced",
            hud_density: "balanced",
            mode_count: 6,
            mode_summary: "layout | model | sculpt | paint | lookdev | render",
            mode_registry_summary: "layout => overlay_policy/layout_clear | model => overlay_policy/model_topology | sculpt => overlay_policy/sculpt_brush | paint => overlay_policy/paint_layers | lookdev => overlay_policy/lookdev_balanced | render => overlay_policy/render_review"
            mode_registry_entries: ["Layout [layout] => overlay_policy/layout_clear / tool_policy/layout_nav_first / view_profile/layout_blocking", "Model [model] => overlay_policy/model_topology / tool_policy/model_edit_first / view_profile/model_topology", "Sculpt [sculpt] => overlay_policy/sculpt_brush / tool_policy/sculpt_brush_first / view_profile/sculpt_surface", "Paint [paint] => overlay_policy/paint_layers / tool_policy/paint_layer_first / view_profile/paint_authoring", "Lookdev [lookdev] => overlay_policy/lookdev_balanced / tool_policy/lookdev_eval / view_profile/lookdev_balanced", "Render [render] => overlay_policy/render_review / tool_policy/render_review / view_profile/render_room"]
        }
    if workspace_mode == "render_comp":
        return ViewportState {
            active_mode: "render",
            overlay_policy_id: "overlay_policy/render_review",
            tool_policy_id: "tool_policy/render_review",
            view_profile_id: "view_profile/render_room",
            hud_density: "balanced",
            mode_count: 6,
            mode_summary: "layout | model | sculpt | paint | lookdev | render",
            mode_registry_summary: "layout => overlay_policy/layout_clear | model => overlay_policy/model_topology | sculpt => overlay_policy/sculpt_brush | paint => overlay_policy/paint_layers | lookdev => overlay_policy/lookdev_balanced | render => overlay_policy/render_review"
            mode_registry_entries: ["Layout [layout] => overlay_policy/layout_clear / tool_policy/layout_nav_first / view_profile/layout_blocking", "Model [model] => overlay_policy/model_topology / tool_policy/model_edit_first / view_profile/model_topology", "Sculpt [sculpt] => overlay_policy/sculpt_brush / tool_policy/sculpt_brush_first / view_profile/sculpt_surface", "Paint [paint] => overlay_policy/paint_layers / tool_policy/paint_layer_first / view_profile/paint_authoring", "Lookdev [lookdev] => overlay_policy/lookdev_balanced / tool_policy/lookdev_eval / view_profile/lookdev_balanced", "Render [render] => overlay_policy/render_review / tool_policy/render_review / view_profile/render_room"]
        }
    if workspace_mode == "scene_assembly":
        return ViewportState {
            active_mode: "layout",
            overlay_policy_id: "overlay_policy/layout_clear",
            tool_policy_id: "tool_policy/layout_nav_first",
            view_profile_id: "view_profile/layout_blocking",
            hud_density: "light",
            mode_count: 6,
            mode_summary: "layout | model | sculpt | paint | lookdev | render",
            mode_registry_summary: "layout => overlay_policy/layout_clear | model => overlay_policy/model_topology | sculpt => overlay_policy/sculpt_brush | paint => overlay_policy/paint_layers | lookdev => overlay_policy/lookdev_balanced | render => overlay_policy/render_review"
            mode_registry_entries: ["Layout [layout] => overlay_policy/layout_clear / tool_policy/layout_nav_first / view_profile/layout_blocking", "Model [model] => overlay_policy/model_topology / tool_policy/model_edit_first / view_profile/model_topology", "Sculpt [sculpt] => overlay_policy/sculpt_brush / tool_policy/sculpt_brush_first / view_profile/sculpt_surface", "Paint [paint] => overlay_policy/paint_layers / tool_policy/paint_layer_first / view_profile/paint_authoring", "Lookdev [lookdev] => overlay_policy/lookdev_balanced / tool_policy/lookdev_eval / view_profile/lookdev_balanced", "Render [render] => overlay_policy/render_review / tool_policy/render_review / view_profile/render_room"]
        }
    return ViewportState {
        active_mode: "layout",
        overlay_policy_id: "overlay_policy/layout_clear",
        tool_policy_id: "tool_policy/layout_nav_first",
        view_profile_id: "view_profile/layout_blocking",
        hud_density: "light",
        mode_count: 6,
        mode_summary: "layout | model | sculpt | paint | lookdev | render",
        mode_registry_summary: "layout => overlay_policy/layout_clear | model => overlay_policy/model_topology | sculpt => overlay_policy/sculpt_brush | paint => overlay_policy/paint_layers | lookdev => overlay_policy/lookdev_balanced | render => overlay_policy/render_review"
    }

