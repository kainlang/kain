fn default_tensor_resource_descriptor() -> TensorResourceDescriptor with Pure:
    let descriptor = TensorResourceDescriptor()
    descriptor.tensor_id = "surface_brush_tensor"
    descriptor.tensor_kind = "brush_field"
    descriptor.storage_domain = "gpu"
    descriptor.residency = "persistent"
    descriptor.precision = "f32"
    descriptor.lifetime_policy = "frame_or_stroke"
    descriptor

fn default_tensor_pipeline_descriptor() -> TensorPipelineDescriptor with Pure:
    let descriptor = TensorPipelineDescriptor()
    descriptor.pipeline_id = "sculpt_stroke_tensor_pipeline"
    descriptor.domain = "sculpt"
    descriptor.priority = "latency_critical"
    descriptor.pass_count = 2
    descriptor.requires_gpu = true
    descriptor.execution_mode = "interactive"
    descriptor

fn default_tensor_scheduling_policy() -> TensorSchedulingPolicy with Pure:
    let policy = TensorSchedulingPolicy()
    policy.allow_async = true
    policy.favor_low_latency = true
    policy.persist_intermediate_tensors = false
    policy.export_reflection_metadata = true
    policy.allow_background_streaming = true
    policy

