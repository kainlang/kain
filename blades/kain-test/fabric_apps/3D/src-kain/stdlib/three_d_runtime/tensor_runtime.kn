    camera_pipeline: TensorPipelineDescriptor
    cache_pipeline: TensorPipelineDescriptor
    scene_object_pipeline: TensorPipelineDescriptor
    native_controls_pipeline: TensorPipelineDescriptor
    schema_pipeline: TensorPipelineDescriptor
    physics_pipeline: TensorPipelineDescriptor
    shader_pipeline: TensorPipelineDescriptor
    resource_pipeline: TensorPipelineDescriptor
    mesh_pipeline: TensorPipelineDescriptor
    baking_pipeline: TensorPipelineDescriptor
    scripting_pipeline: TensorPipelineDescriptor
