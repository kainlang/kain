// Tensor and compute pipeline contracts.

struct TensorResourceDescriptor:
    tensor_id: String
    tensor_kind: String
    storage_domain: String
    residency: String
    precision: String
    lifetime_policy: String

struct TensorPipelineDescriptor:
    pipeline_id: String
    domain: String
    priority: String
    pass_count: UInt
    requires_gpu: Bool
    execution_mode: String

struct TensorSchedulingPolicy:
    allow_async: Bool
    favor_low_latency: Bool
    persist_intermediate_tensors: Bool
    export_reflection_metadata: Bool
    allow_background_streaming: Bool

struct TensorRuntimeCatalog:
    render_pipeline: TensorPipelineDescriptor
    sculpt_pipeline: TensorPipelineDescriptor
    animation_pipeline: TensorPipelineDescriptor
    simulation_pipeline: TensorPipelineDescriptor
    world_pipeline: TensorPipelineDescriptor
    procedural_pipeline: TensorPipelineDescriptor
    groom_pipeline: TensorPipelineDescriptor
    volumetric_pipeline: TensorPipelineDescriptor
    photogrammetry_pipeline: TensorPipelineDescriptor
    audio_pipeline: TensorPipelineDescriptor
    collaboration_pipeline: TensorPipelineDescriptor
    orchestration_pipeline: TensorPipelineDescriptor
    constraint_pipeline: TensorPipelineDescriptor
    biome_pipeline: TensorPipelineDescriptor
    destruction_pipeline: TensorPipelineDescriptor
    review_pipeline: TensorPipelineDescriptor
    compositor_pipeline: TensorPipelineDescriptor
    scene_exchange_pipeline: TensorPipelineDescriptor
    metrology_pipeline: TensorPipelineDescriptor
    fabrication_pipeline: TensorPipelineDescriptor
    review_database_pipeline: TensorPipelineDescriptor
    scene_semantics_pipeline: TensorPipelineDescriptor
    query_selection_pipeline: TensorPipelineDescriptor
    runtime_bundle_pipeline: TensorPipelineDescriptor
    materialization_pipeline: TensorPipelineDescriptor
    asset_registry_pipeline: TensorPipelineDescriptor
    character_pipeline: TensorPipelineDescriptor
    virtual_production_pipeline: TensorPipelineDescriptor
    geospatial_pipeline: TensorPipelineDescriptor
    xr_pipeline: TensorPipelineDescriptor
    networking_pipeline: TensorPipelineDescriptor
    device_pipeline: TensorPipelineDescriptor
    runtime_reflection_pipeline: TensorPipelineDescriptor
    lookdev_pipeline: TensorPipelineDescriptor
    simulation_authoring_pipeline: TensorPipelineDescriptor
    delivery_pipeline: TensorPipelineDescriptor
    sequencing_pipeline: TensorPipelineDescriptor
    navigation_pipeline: TensorPipelineDescriptor
    vehicle_pipeline: TensorPipelineDescriptor
    lighting_pipeline: TensorPipelineDescriptor
    broadcast_pipeline: TensorPipelineDescriptor
    evaluation_pipeline: TensorPipelineDescriptor
    viewport_pipeline: TensorPipelineDescriptor
    interaction_pipeline: TensorPipelineDescriptor
    persistence_pipeline: TensorPipelineDescriptor
    jobs_pipeline: TensorPipelineDescriptor
    telemetry_pipeline: TensorPipelineDescriptor
    security_pipeline: TensorPipelineDescriptor
    entity_pipeline: TensorPipelineDescriptor
    prefab_pipeline: TensorPipelineDescriptor
    command_pipeline: TensorPipelineDescriptor
    state_migration_pipeline: TensorPipelineDescriptor
    workspace_layout_pipeline: TensorPipelineDescriptor
    gameplay_pipeline: TensorPipelineDescriptor
    presentation_pipeline: TensorPipelineDescriptor
    replay_pipeline: TensorPipelineDescriptor
    localization_pipeline: TensorPipelineDescriptor
    streaming_pipeline: TensorPipelineDescriptor
