// Device and runtime hardware-control contracts for displays, sensors, trackers, and machine-adjacent IO.

struct DeviceClassDescriptor:
    device_class_id: String
    transport_kind: String
    hotplug_policy: String
    authority_policy: String

struct DeviceProfileDescriptor:
    profile_id: String
    profile_kind: String
    tensor_pipeline_id: String
    latency_budget: String

struct DeviceRuntimeProfile:
    graphics_adapter: DeviceClassDescriptor
    display_wall: DeviceClassDescriptor
    spatial_input: DeviceClassDescriptor
    sensor_rig: DeviceClassDescriptor
    machine_io: DeviceProfileDescriptor

fn default_device_class_descriptor(
    device_class_id: String,
    transport_kind: String,
    authority_policy: String
) -> DeviceClassDescriptor with Pure:
    let descriptor = DeviceClassDescriptor()
    descriptor.device_class_id = device_class_id
    descriptor.transport_kind = transport_kind
    descriptor.hotplug_policy = "runtime_discovery"
    descriptor.authority_policy = authority_policy
    descriptor

fn default_device_profile_descriptor(
    profile_id: String,
    profile_kind: String,
    tensor_pipeline_id: String,
    latency_budget: String
) -> DeviceProfileDescriptor with Pure:
    let descriptor = DeviceProfileDescriptor()
    descriptor.profile_id = profile_id
    descriptor.profile_kind = profile_kind
    descriptor.tensor_pipeline_id = tensor_pipeline_id
    descriptor.latency_budget = latency_budget
    descriptor

fn default_device_runtime_profile() -> DeviceRuntimeProfile with Pure:
    let profile = DeviceRuntimeProfile()
    profile.graphics_adapter = default_device_class_descriptor("graphics_adapter", "pci_or_external_gpu", "workspace_render_authority")
    profile.display_wall = default_device_class_descriptor("display_wall", "displayport_hdmi_sdi_ndi", "stage_or_desktop_authority")
    profile.spatial_input = default_device_class_descriptor("spatial_input", "xr_controller_hand_tracking", "session_authority_gate")
    profile.sensor_rig = default_device_class_descriptor("sensor_rig", "mocap_camera_lidar_imu", "capture_supervisor_gate")
    profile.machine_io = default_device_profile_descriptor("machine_io_bridge", "robotics_and_fabrication_device_bridge", "device_orchestration_tensor_pipeline", "latency_or_safety_gated")
    profile
