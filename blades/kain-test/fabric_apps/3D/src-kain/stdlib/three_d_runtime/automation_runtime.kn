// Automation recipe and command-graph contracts for recurring, batch, and operator-driven 3D workflows.

struct AutomationRecipeDescriptor:
    recipe_id: String
    recipe_kind: String
    trigger_policy: String
    approval_policy: String

struct CommandGraphDescriptor:
    graph_id: String
    graph_kind: String
    queue_id: String

struct AutomationReceiptDescriptor:
    receipt_id: String
    retention_policy: String
    audit_policy: String

struct AutomationRuntimeProfile:
    workspace_recipe: AutomationRecipeDescriptor
    farm_recipe: AutomationRecipeDescriptor
    command_graph: CommandGraphDescriptor
    automation_receipt: AutomationReceiptDescriptor

fn default_automation_runtime_profile() -> AutomationRuntimeProfile with Pure:
    let profile = AutomationRuntimeProfile()

    profile.workspace_recipe = AutomationRecipeDescriptor()
    profile.workspace_recipe.recipe_id = "workspace_automation_recipe"
    profile.workspace_recipe.recipe_kind = "interactive_and_scheduled_workspace_recipe"
    profile.workspace_recipe.trigger_policy = "manual_schedule_or_scene_event"
    profile.workspace_recipe.approval_policy = "workspace_supervisor_gate"

    profile.farm_recipe = AutomationRecipeDescriptor()
    profile.farm_recipe.recipe_id = "farm_automation_recipe"
    profile.farm_recipe.recipe_kind = "batch_materialization_and_delivery_recipe"
    profile.farm_recipe.trigger_policy = "queue_and_approval_driven"
    profile.farm_recipe.approval_policy = "pipeline_supervisor_gate"

    profile.command_graph = CommandGraphDescriptor()
    profile.command_graph.graph_id = "automation_command_graph"
    profile.command_graph.graph_kind = "manifest_driven_recipe_orchestration"
    profile.command_graph.queue_id = "automation_recipe_queue"

    profile.automation_receipt = AutomationReceiptDescriptor()
    profile.automation_receipt.receipt_id = "automation_execution_receipt"
    profile.automation_receipt.retention_policy = "project_and_delivery_scoped"
    profile.automation_receipt.audit_policy = "command_graph_and_output_tracked"
    profile
