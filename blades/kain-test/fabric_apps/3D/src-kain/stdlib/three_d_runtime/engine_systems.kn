fn realtime_system(system_id: String, lane: String, tensor_pipeline_id: String) -> RuntimeSystemDescriptor with Pure:
    let descriptor = RuntimeSystemDescriptor()
    descriptor.system_id = system_id
    descriptor.lane = lane
    descriptor.enabled = true
    descriptor.update_frequency = "realtime"
    descriptor.tensor_pipeline_id = tensor_pipeline_id
    descriptor.orchestration_mode = "interactive"
    descriptor

fn batch_system(system_id: String, lane: String, tensor_pipeline_id: String) -> RuntimeSystemDescriptor with Pure:
    let descriptor = RuntimeSystemDescriptor()
    descriptor.system_id = system_id
    descriptor.lane = lane
    descriptor.enabled = true
    descriptor.update_frequency = "batched"
    descriptor.tensor_pipeline_id = tensor_pipeline_id
    descriptor.orchestration_mode = "queued"
    descriptor

fn default_renderer_system_bundle() -> RendererSystemBundle with Pure:
    let bundle = RendererSystemBundle()
    bundle.visibility_system = realtime_system("visibility_cluster_cull", "render", "renderer_frame_tensor_pipeline")
    bundle.material_system = realtime_system("material_layer_stack_tensor", "render", "renderer_frame_tensor_pipeline")
    bundle.viewport_compositor = realtime_system("viewport_composite_tensor", "render", "renderer_frame_tensor_pipeline")
    bundle.post_stack = realtime_system("post_stack", "render", "renderer_frame_tensor_pipeline")
    bundle

