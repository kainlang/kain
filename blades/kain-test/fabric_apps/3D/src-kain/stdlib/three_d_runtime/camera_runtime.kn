// Camera rigs, lens packs, shot context, and capture-routing contracts shared by viewport, runtime, XR, and stage lanes.

struct CameraRigDescriptor:
    rig_id: String
    rig_kind: String
    sync_policy: String

struct LensProfileDescriptor:
    lens_id: String
    lens_kind: String
    calibration_policy: String

struct CaptureRouteDescriptor:
    route_id: String
    route_scope: String
    delivery_policy: String

struct CameraRuntimeProfile:
    camera_rig: CameraRigDescriptor
    lens_profile: LensProfileDescriptor
    capture_route: CaptureRouteDescriptor

fn default_camera_runtime_profile() -> CameraRuntimeProfile with Pure:
    let profile = CameraRuntimeProfile()

    profile.camera_rig = CameraRigDescriptor()
    profile.camera_rig.rig_id = "universal_camera_rig"
    profile.camera_rig.rig_kind = "editor_runtime_stage_broadcast_and_xr_safe_camera_rig"
    profile.camera_rig.sync_policy = "selection_sequence_stage_and_delivery_context_bound"

    profile.lens_profile = LensProfileDescriptor()
    profile.lens_profile.lens_id = "universal_lens_profile"
    profile.lens_profile.lens_kind = "perspective_ortho_virtual_production_and_cinematic_lens_pack"
    profile.lens_profile.calibration_policy = "tracked_camera_and_review_reference_aware"

    profile.capture_route = CaptureRouteDescriptor()
    profile.capture_route.route_id = "camera_capture_route"
    profile.capture_route.route_scope = "viewport_review_broadcast_replay_and_delivery_capture"
    profile.capture_route.delivery_policy = "channel_and_bundle_registry_bound"
    profile
