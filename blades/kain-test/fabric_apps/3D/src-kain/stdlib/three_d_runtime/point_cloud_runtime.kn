// Point-cloud, LiDAR, and splat-authoring contracts for scan-heavy 3D products.

struct PointCloudDescriptor:
    point_cloud_id: String
    point_cloud_kind: String
    residency_policy: String

struct LidarDescriptor:
    lidar_id: String
    lidar_kind: String
    ingest_policy: String

struct SplatDescriptor:
    splat_id: String
    splat_kind: String
    view_policy: String

struct PointCloudRuntimeProfile:
    point_cloud: PointCloudDescriptor
    lidar: LidarDescriptor
    splat: SplatDescriptor

fn default_point_cloud_runtime_profile() -> PointCloudRuntimeProfile with Pure:
    let profile = PointCloudRuntimeProfile()

    profile.point_cloud = PointCloudDescriptor()
    profile.point_cloud.point_cloud_id = "point_cloud_runtime"
    profile.point_cloud.point_cloud_kind = "dense_sparse_semantic_and_segmented_clouds"
    profile.point_cloud.residency_policy = "streamed_chunked_and_query_ready"

    profile.lidar = LidarDescriptor()
    profile.lidar.lidar_id = "lidar_ingest_runtime"
    profile.lidar.lidar_kind = "scan_capture_alignment_and_semantic_ingest"
    profile.lidar.ingest_policy = "manifest_driven_transform_and_classification"

    profile.splat = SplatDescriptor()
    profile.splat.splat_id = "point_splat_runtime"
    profile.splat.splat_kind = "splat_render_segmentation_and_decimation"
    profile.splat.view_policy = "viewport_and_streaming_ready"
    profile
