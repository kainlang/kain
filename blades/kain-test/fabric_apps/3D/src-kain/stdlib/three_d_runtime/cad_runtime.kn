// CAD and NURBS authoring contracts for exact modeling and manufacturing-adjacent workflows.

struct NurbsSurfaceDescriptor:
    surface_id: String
    continuity_policy: String
    tessellation_pipeline_id: String

struct CadAssemblyDescriptor:
    assembly_id: String
    constraint_policy: String
    exchange_policy: String

struct CadRuntimeProfile:
    primary_surface_modeler: NurbsSurfaceDescriptor
    mechanical_assembly: CadAssemblyDescriptor
    drafting_surface: CadAssemblyDescriptor

fn default_nurbs_surface(surface_id: String, continuity_policy: String) -> NurbsSurfaceDescriptor with Pure:
    let descriptor = NurbsSurfaceDescriptor()
    descriptor.surface_id = surface_id
    descriptor.continuity_policy = continuity_policy
    descriptor.tessellation_pipeline_id = "cad_surface_tensor_pipeline"
    descriptor

fn default_cad_assembly(assembly_id: String, constraint_policy: String, exchange_policy: String) -> CadAssemblyDescriptor with Pure:
    let descriptor = CadAssemblyDescriptor()
    descriptor.assembly_id = assembly_id
    descriptor.constraint_policy = constraint_policy
    descriptor.exchange_policy = exchange_policy
    descriptor

fn default_cad_runtime_profile() -> CadRuntimeProfile with Pure:
    let profile = CadRuntimeProfile()
    profile.primary_surface_modeler = default_nurbs_surface("primary_surface_modeler", "g2_or_g3")
    profile.mechanical_assembly = default_cad_assembly("mechanical_assembly", "parametric_and_solver_backed", "step_and_iges")
    profile.drafting_surface = default_cad_assembly("drafting_surface", "annotated_projection_views", "drawing_and_cut_sheet")
    profile
