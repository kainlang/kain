// Animation, rigging, retargeting, and mocap contracts.

struct RigRuntimeDescriptor:
    rig_id: String
    rig_kind: String
    pose_pipeline_id: String
    deformation_policy: String

struct RetargetRuntimeDescriptor:
    retarget_id: String
    source_profile: String
    target_profile: String
    tensor_pipeline_id: String

struct AnimationRuntimeProfile:
    character_rig: RigRuntimeDescriptor
    facial_rig: RigRuntimeDescriptor
    mocap_retarget: RetargetRuntimeDescriptor

fn default_rig_runtime(rig_id: String, rig_kind: String) -> RigRuntimeDescriptor with Pure:
    let rig = RigRuntimeDescriptor()
    rig.rig_id = rig_id
    rig.rig_kind = rig_kind
    rig.pose_pipeline_id = "animation_pose_tensor_pipeline"
    rig.deformation_policy = "gpu_skinning"
    rig

fn default_animation_runtime_profile() -> AnimationRuntimeProfile with Pure:
    let profile = AnimationRuntimeProfile()
    profile.character_rig = default_rig_runtime("character_rig", "biped")
    profile.facial_rig = default_rig_runtime("facial_rig", "blendshape_or_joint")

    profile.mocap_retarget = RetargetRuntimeDescriptor()
    profile.mocap_retarget.retarget_id = "mocap_retarget"
    profile.mocap_retarget.source_profile = "sensor_capture"
    profile.mocap_retarget.target_profile = "runtime_character_rig"
    profile.mocap_retarget.tensor_pipeline_id = "animation_pose_tensor_pipeline"
    profile
