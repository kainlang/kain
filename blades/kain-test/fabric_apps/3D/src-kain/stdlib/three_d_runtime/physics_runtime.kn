// Physics authoring/runtime contracts for rigid bodies, collision layers, joints, controllers, and deterministic simulation handoff.

struct PhysicsSolverDescriptor:
    solver_id: String
    solver_kind: String
    determinism_policy: String

struct CollisionDescriptor:
    collision_id: String
    collision_scope: String
    query_policy: String

struct JointDescriptor:
    joint_id: String
    joint_family: String
    bake_policy: String

struct PhysicsRuntimeProfile:
    solver_runtime: PhysicsSolverDescriptor
    collision_runtime: CollisionDescriptor
    joint_runtime: JointDescriptor

fn default_physics_runtime_profile() -> PhysicsRuntimeProfile with Pure:
    let profile = PhysicsRuntimeProfile()

    profile.solver_runtime = PhysicsSolverDescriptor()
    profile.solver_runtime.solver_id = "universal_physics_solver"
    profile.solver_runtime.solver_kind = "rigid_body_character_controller_and_scene_interaction_solver"
    profile.solver_runtime.determinism_policy = "checkpoint_replay_and_network_safe"

    profile.collision_runtime = CollisionDescriptor()
    profile.collision_runtime.collision_id = "physics_collision_runtime"
    profile.collision_runtime.collision_scope = "bodies_shapes_layers_queries_and_contact_events"
    profile.collision_runtime.query_policy = "scene_query_and_gameplay_runtime_aligned"

    profile.joint_runtime = JointDescriptor()
    profile.joint_runtime.joint_id = "physics_joint_runtime"
    profile.joint_runtime.joint_family = "hinge_slider_ball_socket_suspension_and_constraint_joints"
    profile.joint_runtime.bake_policy = "interactive_baked_and_delivery_safe"
    profile
