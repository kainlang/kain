// Lookdev and lighting review contracts for wedges, references, approvals, and shot-context review.

struct LookdevReviewDescriptor:
    review_id: String
    review_scope: String
    tensor_pipeline_id: String
    approval_policy: String

struct LookdevWedgeDescriptor:
    wedge_id: String
    wedge_scope: String
    scoring_policy: String
    output_root: String

struct LightingRigDescriptor:
    rig_id: String
    rig_kind: String
    context_policy: String
    reference_policy: String

struct LookdevApprovalDescriptor:
    approval_id: String
    approval_scope: String
    diff_policy: String
    registry_id: String

struct LookdevRuntimeProfile:
    shot_review: LookdevReviewDescriptor
    material_wedge_review: LookdevReviewDescriptor
    material_wedge_set: LookdevWedgeDescriptor
    lighting_rig: LightingRigDescriptor
    reference_matching: LightingRigDescriptor
    approval_runtime: LookdevApprovalDescriptor

fn default_lookdev_review_descriptor(
    review_id: String,
    review_scope: String,
    approval_policy: String
) -> LookdevReviewDescriptor with Pure:
    let descriptor = LookdevReviewDescriptor()
    descriptor.review_id = review_id
    descriptor.review_scope = review_scope
    descriptor.tensor_pipeline_id = "lookdev_review_tensor_pipeline"
    descriptor.approval_policy = approval_policy
    descriptor

fn default_lookdev_runtime_profile() -> LookdevRuntimeProfile with Pure:
    let profile = LookdevRuntimeProfile()
    profile.shot_review = default_lookdev_review_descriptor("lookdev_shot_review", "shot_context_lighting_and_surface_approval", "lookdev_supervisor_gate")
    profile.material_wedge_review = default_lookdev_review_descriptor("lookdev_material_wedge", "a_b_and_multi_wedge_review", "lookdev_supervisor_gate")

    profile.material_wedge_set = LookdevWedgeDescriptor()
    profile.material_wedge_set.wedge_id = "lookdev_material_wedge_set"
    profile.material_wedge_set.wedge_scope = "material_variant_lighting_and_reference_wedge_sets"
    profile.material_wedge_set.scoring_policy = "perceptual_diff_and_supervisor_annotation_bound"
    profile.material_wedge_set.output_root = "generated/lookdev/wedges"

    profile.lighting_rig = LightingRigDescriptor()
    profile.lighting_rig.rig_id = "lookdev_lighting_rig"
    profile.lighting_rig.rig_kind = "studio_stage_hdr_and_key_fill_rim"
    profile.lighting_rig.context_policy = "shot_and_asset_context_switchable"
    profile.lighting_rig.reference_policy = "reference_locked_or_exploratory"

    profile.reference_matching = LightingRigDescriptor()
    profile.reference_matching.rig_id = "lookdev_reference_match"
    profile.reference_matching.rig_kind = "reference_plate_and_capture_match"
    profile.reference_matching.context_policy = "reference_and_deliverable_paired"
    profile.reference_matching.reference_policy = "score_and_annotation_driven"

    profile.approval_runtime = LookdevApprovalDescriptor()
    profile.approval_runtime.approval_id = "lookdev_approval_runtime"
    profile.approval_runtime.approval_scope = "lookdev_review_wedge_reference_and_delivery_readiness"
    profile.approval_runtime.diff_policy = "perceptual_diff_score_and_annotation_receipt_bound"
    profile.approval_runtime.registry_id = "lookdev_delivery_registry"
    profile
