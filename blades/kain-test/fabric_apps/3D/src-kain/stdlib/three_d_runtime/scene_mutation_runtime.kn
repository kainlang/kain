// Scene-mutation contracts for transactional edits, dependency-safe deltas, replicated updates, and audit-visible scene change receipts.

struct SceneMutationDescriptor:
    mutation_id: String
    mutation_scope: String
    transaction_policy: String

struct SceneDeltaDescriptor:
    delta_id: String
    delta_scope: String
    replay_policy: String

struct SceneReceiptDescriptor:
    receipt_id: String
    receipt_scope: String
    audit_policy: String

struct SceneMutationRuntimeProfile:
    mutation_runtime: SceneMutationDescriptor
    delta_runtime: SceneDeltaDescriptor
    receipt_runtime: SceneReceiptDescriptor

fn default_scene_mutation_runtime_profile() -> SceneMutationRuntimeProfile with Pure:
    let profile = SceneMutationRuntimeProfile()

    profile.mutation_runtime = SceneMutationDescriptor()
    profile.mutation_runtime.mutation_id = "scene_mutation_runtime"
    profile.mutation_runtime.mutation_scope = "entity_component_relationship_layer_bundle_and_instance_mutations"
    profile.mutation_runtime.transaction_policy = "undo_redo_command_and_replication_safe"

    profile.delta_runtime = SceneDeltaDescriptor()
    profile.delta_runtime.delta_id = "scene_delta_runtime"
    profile.delta_runtime.delta_scope = "viewport_editor_runtime_delivery_and_review_visible_scene_deltas"
    profile.delta_runtime.replay_policy = "deterministic_branchable_and_cache_aware"

    profile.receipt_runtime = SceneReceiptDescriptor()
    profile.receipt_runtime.receipt_id = "scene_mutation_receipt_runtime"
    profile.receipt_runtime.receipt_scope = "audit_telemetry_materialization_and_session_handoff_receipts"
    profile.receipt_runtime.audit_policy = "operator_visible_and_schema_compatible"
    profile
