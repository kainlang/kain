struct ThreeDDeploymentPolicy:
    native_shell_kind: String
    default_viewport_backend: String
    runtime_bundle_policy: String
    workspace_preset_manifest: String
    plugin_policy: String
    review_policy: String
    release_channel_policy: String

struct ThreeDProjectProfile:
    identity: ThreeDProjectIdentity
    features: ThreeDFeatureToggles
    domain_packs: ThreeDDomainPackToggles
    outputs: ThreeDBuildOutputs
    deployment: ThreeDDeploymentPolicy

fn default_three_d_project_profile() -> ThreeDProjectProfile with Pure:
