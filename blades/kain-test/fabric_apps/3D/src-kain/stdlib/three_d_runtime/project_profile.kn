    profile.outputs.generate_updates_exports = true

    profile.deployment = ThreeDDeploymentPolicy()
    profile.deployment.native_shell_kind = "kain_native_ui"
    profile.deployment.default_viewport_backend = "native"
    profile.deployment.runtime_bundle_policy = "multi_target"
    profile.deployment.workspace_preset_manifest = "manifests/workspace_presets.json"
    profile.deployment.plugin_policy = "contract_driven_optional"
    profile.deployment.review_policy = "collaborative_or_local"
    profile.deployment.release_channel_policy = "manifest_gated"
    profile
