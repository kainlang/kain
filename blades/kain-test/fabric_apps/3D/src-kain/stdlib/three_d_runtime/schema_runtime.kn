// Runtime/import/export schema contracts for reflection catalogs, compatibility windows, and exchange-safe contract validation.

struct SchemaCatalogDescriptor:
    catalog_id: String
    catalog_scope: String
    evolution_policy: String

struct SchemaCompatibilityDescriptor:
    compatibility_id: String
    compatibility_scope: String
    validation_policy: String

struct ExchangeSchemaDescriptor:
    exchange_id: String
    exchange_kind: String
    receipt_policy: String

struct GeneratedSchemaDescriptor:
    schema_id: String
    schema_scope: String
    schema_root: String
    validation_policy: String
    reflection_catalog_id: String

struct GeneratedSchemaEmitterDescriptor:
    emitter_id: String
    schema_id: String
    document_kind: String
    template_root: String
    index_root: String
    emission_policy: String
    reflection_catalog_id: String

struct SchemaRuntimeProfile:
    schema_catalog: SchemaCatalogDescriptor
    compatibility_runtime: SchemaCompatibilityDescriptor
    exchange_schema: ExchangeSchemaDescriptor
    workspace_preset_launch_manifest_schema: GeneratedSchemaDescriptor
    workspace_preset_receipt_schema: GeneratedSchemaDescriptor
    workspace_preset_launch_manifest_emitter: GeneratedSchemaEmitterDescriptor
    workspace_preset_receipt_emitter: GeneratedSchemaEmitterDescriptor
    jobs_receipt_schema: GeneratedSchemaDescriptor
    jobs_receipt_emitter: GeneratedSchemaEmitterDescriptor

fn default_schema_runtime_profile() -> SchemaRuntimeProfile with Pure:
    let profile = SchemaRuntimeProfile()

    profile.schema_catalog = SchemaCatalogDescriptor()
    profile.schema_catalog.catalog_id = "universal_runtime_schema_catalog"
    profile.schema_catalog.catalog_scope = "runtime_ui_interchange_plugin_and_delivery_contracts"
    profile.schema_catalog.evolution_policy = "versioned_reflected_and_manifest_registered"

    profile.compatibility_runtime = SchemaCompatibilityDescriptor()
    profile.compatibility_runtime.compatibility_id = "runtime_schema_compatibility"
    profile.compatibility_runtime.compatibility_scope = "project_upgrade_exchange_and_bundle_compatibility_windows"
    profile.compatibility_runtime.validation_policy = "gate_before_materialization_publish_or_mount"

    profile.exchange_schema = ExchangeSchemaDescriptor()
    profile.exchange_schema.exchange_id = "schema_exchange_contract"
    profile.exchange_schema.exchange_kind = "import_export_transcode_and_plugin_schema_contract"
    profile.exchange_schema.receipt_policy = "validation_and_delivery_receipt_bound"

    profile.workspace_preset_launch_manifest_schema = GeneratedSchemaDescriptor()
    profile.workspace_preset_launch_manifest_schema.schema_id = "workspace_preset_launch_manifest_schema"
    profile.workspace_preset_launch_manifest_schema.schema_scope = "workspace_preset_launch_packet_bundle_binding_and_layout_contract"
    profile.workspace_preset_launch_manifest_schema.schema_root = "generated/schemas/workspace-presets/launch-manifests"
    profile.workspace_preset_launch_manifest_schema.validation_policy = "gate_before_bundle_assembly_or_workspace_launch"
    profile.workspace_preset_launch_manifest_schema.reflection_catalog_id = "workspace_preset_launch_schema_catalog"

    profile.workspace_preset_receipt_schema = GeneratedSchemaDescriptor()
    profile.workspace_preset_receipt_schema.schema_id = "workspace_preset_delivery_receipt_schema"
    profile.workspace_preset_receipt_schema.schema_scope = "workspace_preset_materialization_delivery_and_promotion_receipt_contract"
    profile.workspace_preset_receipt_schema.schema_root = "generated/schemas/workspace-presets/receipts"
    profile.workspace_preset_receipt_schema.validation_policy = "gate_before_delivery_reflection_or_receipt_promotion"
    profile.workspace_preset_receipt_schema.reflection_catalog_id = "workspace_preset_receipt_schema_catalog"

    profile.workspace_preset_launch_manifest_emitter = GeneratedSchemaEmitterDescriptor()
    profile.workspace_preset_launch_manifest_emitter.emitter_id = "workspace_preset_launch_manifest_schema_emitter"
    profile.workspace_preset_launch_manifest_emitter.schema_id = "workspace_preset_launch_manifest_schema"
    profile.workspace_preset_launch_manifest_emitter.document_kind = "workspace_preset_launch_manifest_schema_bundle"
    profile.workspace_preset_launch_manifest_emitter.template_root = "generated/schemas/workspace-presets/launch-manifests/templates"
    profile.workspace_preset_launch_manifest_emitter.index_root = "generated/schemas/workspace-presets/launch-manifests/indexes"
    profile.workspace_preset_launch_manifest_emitter.emission_policy = "emit_canonical_templates_before_bundle_assembly_or_workspace_launch"
    profile.workspace_preset_launch_manifest_emitter.reflection_catalog_id = "workspace_preset_launch_template_catalog"

    profile.workspace_preset_receipt_emitter = GeneratedSchemaEmitterDescriptor()
    profile.workspace_preset_receipt_emitter.emitter_id = "workspace_preset_delivery_receipt_schema_emitter"
    profile.workspace_preset_receipt_emitter.schema_id = "workspace_preset_delivery_receipt_schema"
    profile.workspace_preset_receipt_emitter.document_kind = "workspace_preset_delivery_receipt_schema_bundle"
    profile.workspace_preset_receipt_emitter.template_root = "generated/schemas/workspace-presets/receipts/templates"
    profile.workspace_preset_receipt_emitter.index_root = "generated/schemas/workspace-presets/receipts/indexes"
    profile.workspace_preset_receipt_emitter.emission_policy = "emit_canonical_templates_before_delivery_reflection_or_receipt_promotion"
    profile.workspace_preset_receipt_emitter.reflection_catalog_id = "workspace_preset_receipt_template_catalog"

    profile.jobs_receipt_schema = GeneratedSchemaDescriptor()
    profile.jobs_receipt_schema.schema_id = "jobs_delivery_receipt_schema"
    profile.jobs_receipt_schema.schema_scope = "jobs_dispatch_delivery_retry_and_promotion_receipt_contract"
    profile.jobs_receipt_schema.schema_root = "generated/schemas/jobs/receipts"
    profile.jobs_receipt_schema.validation_policy = "gate_before_job_promotion_receipt_resume_or_worker_requeue"
    profile.jobs_receipt_schema.reflection_catalog_id = "jobs_receipt_schema_catalog"

    profile.jobs_receipt_emitter = GeneratedSchemaEmitterDescriptor()
    profile.jobs_receipt_emitter.emitter_id = "jobs_delivery_receipt_schema_emitter"
    profile.jobs_receipt_emitter.schema_id = "jobs_delivery_receipt_schema"
    profile.jobs_receipt_emitter.document_kind = "jobs_delivery_receipt_schema_bundle"
    profile.jobs_receipt_emitter.template_root = "generated/schemas/jobs/receipts/templates"
    profile.jobs_receipt_emitter.index_root = "generated/schemas/jobs/receipts/indexes"
    profile.jobs_receipt_emitter.emission_policy = "emit_canonical_job_receipt_templates_before_retry_resume_or_distribution_promotion"
    profile.jobs_receipt_emitter.reflection_catalog_id = "jobs_receipt_template_catalog"
    profile
