// Viewport composition, camera policy, overlays, and renderer-resource presentation contracts.

struct ViewportDescriptor:
    viewport_id: String
    viewport_kind: String
    residency_policy: String
    composition_policy: String
    framing_policy: String

struct CameraRigDescriptor:
    rig_id: String
    navigation_policy: String
    sync_policy: String

struct OverlayDescriptor:
    overlay_id: String
    overlay_scope: String
    capture_policy: String

struct ViewportRuntimeProfile:
    viewport: ViewportDescriptor
    camera_rig: CameraRigDescriptor
    overlays: OverlayDescriptor

fn default_viewport_runtime_profile() -> ViewportRuntimeProfile with Pure:
    let profile = ViewportRuntimeProfile()

    profile.viewport = ViewportDescriptor()
    profile.viewport.viewport_id = "primary_runtime_viewport"
    profile.viewport.viewport_kind = "native_renderer_owned_multi_surface_viewport"
    profile.viewport.residency_policy = "persistent_gpu_resources_and_overlay_channels"
    profile.viewport.composition_policy = "scene_summary_driven_and_launch_preset_bound"
    profile.viewport.framing_policy = "bounds_fov_and_aspect_ratio_fit"

    profile.camera_rig = CameraRigDescriptor()
    profile.camera_rig.rig_id = "viewport_camera_rig"
    profile.camera_rig.navigation_policy = "editor_runtime_xr_and_stage_profiles"
    profile.camera_rig.sync_policy = "selection_stage_and_review_context_bound"

    profile.overlays = OverlayDescriptor()
    profile.overlays.overlay_id = "viewport_overlay_stack"
    profile.overlays.overlay_scope = "selection_gizmos_guides_review_and_telemetry"
    profile.overlays.capture_policy = "frame_review_and_broadcast_aware"
    profile
