// Renderer graph authoring and frame scheduling contracts.

struct RendererGraphNodeDescriptor:
    node_id: String
    node_kind: String
    execution_stage: String
    tensor_pipeline_id: String

struct RendererGraphRuntimeProfile:
    frame_graph: RendererGraphNodeDescriptor
    lighting_graph: RendererGraphNodeDescriptor
    post_graph: RendererGraphNodeDescriptor

fn default_renderer_graph_node(node_id: String, node_kind: String, execution_stage: String) -> RendererGraphNodeDescriptor with Pure:
    let descriptor = RendererGraphNodeDescriptor()
    descriptor.node_id = node_id
    descriptor.node_kind = node_kind
    descriptor.execution_stage = execution_stage
    descriptor.tensor_pipeline_id = "renderer_graph_tensor_pipeline"
    descriptor

fn default_renderer_graph_runtime_profile() -> RendererGraphRuntimeProfile with Pure:
    let profile = RendererGraphRuntimeProfile()
    profile.frame_graph = default_renderer_graph_node("frame_graph", "render_graph", "frame_execution")
    profile.lighting_graph = default_renderer_graph_node("lighting_graph", "lighting_graph", "lighting_evaluation")
    profile.post_graph = default_renderer_graph_node("post_graph", "post_graph", "post_present")
    profile
