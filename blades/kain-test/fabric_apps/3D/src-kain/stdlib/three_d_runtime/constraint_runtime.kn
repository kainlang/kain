// Constraint, rig assembly, and solver contracts for animation, simulation, and editor tools.

struct ConstraintDescriptor:
    constraint_id: String
    constraint_kind: String
    solve_policy: String
    tensor_pipeline_id: String

struct ConstraintGraphDescriptor:
    graph_id: String
    graph_kind: String
    authority_lane: String
    evaluation_policy: String

struct ConstraintRuntimeProfile:
    rig_constraints: ConstraintGraphDescriptor
    simulation_constraints: ConstraintGraphDescriptor
    assembly_constraints: ConstraintGraphDescriptor
    live_solver: ConstraintDescriptor

fn default_constraint_graph(graph_id: String, graph_kind: String, authority_lane: String) -> ConstraintGraphDescriptor with Pure:
    let descriptor = ConstraintGraphDescriptor()
    descriptor.graph_id = graph_id
    descriptor.graph_kind = graph_kind
    descriptor.authority_lane = authority_lane
    descriptor.evaluation_policy = "interactive_and_bakeable"
    descriptor

fn default_constraint_runtime_profile() -> ConstraintRuntimeProfile with Pure:
    let profile = ConstraintRuntimeProfile()
    profile.rig_constraints = default_constraint_graph("rig_constraints", "hierarchy_graph", "animation")
    profile.simulation_constraints = default_constraint_graph("simulation_constraints", "solver_graph", "simulation")
    profile.assembly_constraints = default_constraint_graph("assembly_constraints", "mechanical_graph", "editor")

    profile.live_solver = ConstraintDescriptor()
    profile.live_solver.constraint_id = "constraint_jacobi_solve"
    profile.live_solver.constraint_kind = "multi_domain_constraint_solver"
    profile.live_solver.solve_policy = "iterative_gpu_preferred"
    profile.live_solver.tensor_pipeline_id = "constraint_solver_tensor_pipeline"
    profile
