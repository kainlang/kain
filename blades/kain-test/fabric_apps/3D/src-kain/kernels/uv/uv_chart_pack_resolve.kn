// SPIR-V seed for UV chart packing, UDIM tile assignment, and texel-density-aware layout receipts.

kernel uv_chart_pack_resolve:
    stage = "compute"
    domain = "uv"
    dispatch = [128, 1, 1]

    input uv_charts: Tensor
    input packing_constraints: Tensor
    input texel_density_targets: Tensor
    input layout_context: Tensor

    output packed_uv_layout: Tensor
    output uv_layout_receipts: Tensor
