// SPIR-V artifact graph materialization seed.

shader compute artifact_materialization_resolve(id: UVec3) -> Vec4:
    uniform runtime_app_nodes: StorageBuffer<Vec4> @0
    uniform kernel_nodes: StorageBuffer<Vec4> @1
    uniform package_nodes: StorageBuffer<Vec4> @2
    uniform materialization_plan: StorageBuffer<Vec4> @3
    let node_index = id.x
    let runtime_node = runtime_app_nodes[node_index]
    let kernel_node = kernel_nodes[node_index]
    let package_node = package_nodes[node_index]
    let output = vec4(
        runtime_node.x + kernel_node.x,
        runtime_node.y + package_node.y,
        kernel_node.z + package_node.z,
        1.0
    )
    materialization_plan[node_index] = output
    return output
