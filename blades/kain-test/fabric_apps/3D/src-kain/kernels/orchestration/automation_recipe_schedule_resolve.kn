// SPIR-V automation recipe scheduling and queue-shaping seed.

shader compute automation_recipe_schedule_resolve(id: UVec3) -> Vec4:
    uniform recipe_nodes: StorageBuffer<Vec4> @0
    uniform trigger_nodes: StorageBuffer<Vec4> @1
    uniform approval_nodes: StorageBuffer<Vec4> @2
    uniform scheduled_recipe_batches: StorageBuffer<Vec4> @3
    let record_index = id.x
    let recipe_node = recipe_nodes[record_index]
    let trigger_node = trigger_nodes[record_index]
    let approval_node = approval_nodes[record_index]
    let output = vec4(
        recipe_node.x + trigger_node.x,
        recipe_node.y + approval_node.y,
        trigger_node.z + approval_node.z,
        1.0
    )
    scheduled_recipe_batches[record_index] = output
    return output
