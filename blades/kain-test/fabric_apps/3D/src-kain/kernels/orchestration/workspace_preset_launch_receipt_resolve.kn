// SPIR-V seed for workspace-preset launch-manifest and delivery-receipt materialization.

shader compute workspace_preset_launch_receipt_resolve(id: UVec3) -> Vec4:
    uniform preset_manifest_entries: StorageBuffer<Vec4> @0
    uniform runtime_app_bindings: StorageBuffer<Vec4> @1
    uniform layout_binding_state: StorageBuffer<Vec4> @2
    uniform delivery_registry_state: StorageBuffer<Vec4> @3
    uniform materialized_launch_manifests: StorageBuffer<Vec4> @4
    uniform workspace_preset_delivery_receipts: StorageBuffer<Vec4> @5
    let preset_index = id.x
    let preset = preset_manifest_entries[preset_index]
    let runtime = runtime_app_bindings[preset_index]
    let layout = layout_binding_state[preset_index]
    let delivery = delivery_registry_state[0]
    let launch_manifest = vec4(
        preset.x + runtime.x,
        preset.y + layout.y,
        runtime.z + layout.z,
        1.0
    )
    let delivery_receipt = vec4(
        launch_manifest.x + delivery.x,
        launch_manifest.y + delivery.y,
        launch_manifest.z + delivery.z,
        1.0
    )
    materialized_launch_manifests[preset_index] = launch_manifest
    workspace_preset_delivery_receipts[preset_index] = delivery_receipt
    return delivery_receipt
