// SPIR-V seed for fleet capacity balancing, worker leasing, and cross-domain dispatch receipts.

kernel fleet_capacity_dispatch_resolve:
    stage = "compute"
    domain = "fleet"
    dispatch = [64, 1, 1]

    input worker_pools: Tensor
    input job_batches: Tensor
    input capability_windows: Tensor
    input failover_routes: Tensor

    output resolved_fleet_dispatch: Tensor
    output fleet_lease_receipts: Tensor
