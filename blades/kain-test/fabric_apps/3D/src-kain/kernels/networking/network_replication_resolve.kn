// SPIR-V networking replication seed.

shader compute network_replication_resolve(id: UVec3) -> Vec4:
    uniform local_entity_state: StorageBuffer<Vec4> @0
    uniform remote_entity_state: StorageBuffer<Vec4> @1
    uniform authority_state: StorageBuffer<Vec4> @2
    uniform replicated_entity_state: StorageBuffer<Vec4> @3
    let entity_index = id.x
    let local = local_entity_state[entity_index]
    let remote = remote_entity_state[entity_index]
    let authority = authority_state[entity_index]
    let output = vec4(
        local.x + remote.x,
        local.y + authority.y,
        remote.z + authority.z,
        1.0
    )
    replicated_entity_state[entity_index] = output
    return output
