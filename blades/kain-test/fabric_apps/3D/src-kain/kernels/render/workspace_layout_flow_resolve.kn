// SPIR-V seed for workspace dock-flow, window-surface routing, and overlay layout resolution.

fn workspace_layout_flow_resolve() -> Void:
    let layout_scope = "workspace_dock_graph"
    let window_scope = "multi_window_surface_layout"
    let routing_scope = "focus_drag_drop_and_command_context"
    let overlay_scope = "viewport_overlay_safe_layout"
    layout_scope
    window_scope
    routing_scope
    overlay_scope
