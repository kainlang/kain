// SPIR-V lighting probe-grid and shadow-context resolve seed.

shader compute lighting_probe_grid_resolve(id: UVec3) -> Vec4:
    uniform light_rigs: StorageBuffer<Vec4> @0
    uniform probe_grid_state: StorageBuffer<Vec4> @1
    uniform shadow_contexts: StorageBuffer<Vec4> @2
    uniform resolved_lighting_probes: StorageBuffer<Vec4> @3
    let probe_index = id.x
    let rig = light_rigs[probe_index]
    let probe = probe_grid_state[probe_index]
    let shadow = shadow_contexts[probe_index]
    let output = vec4(
        rig.x + probe.x,
        rig.y + shadow.y,
        probe.z + shadow.z,
        1.0
    )
    resolved_lighting_probes[probe_index] = output
    return output
