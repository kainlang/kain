// SPIR-V rig skinning pose resolve seed.

shader compute rig_skinning_pose_resolve(id: UVec3) -> Vec4:
    uniform bone_matrices: StorageBuffer<Vec4> @0
    uniform vertex_weights: StorageBuffer<Vec4> @1
    uniform bind_pose_positions: StorageBuffer<Vec4> @2
    uniform skinned_positions: StorageBuffer<Vec4> @3
    let vertex_index = id.x
    let bone = bone_matrices[vertex_index]
    let weight = vertex_weights[vertex_index]
    let bind = bind_pose_positions[vertex_index]
    let output = vec4(
        bind.x + bone.x * weight.x,
        bind.y + bone.y * weight.y,
        bind.z + bone.z * weight.z,
        1.0
    )
    skinned_positions[vertex_index] = output
    return output
