// SPIR-V clustered fracture resolution seed.

shader compute fracture_cluster_resolve(id: UVec3) -> Vec4:
    uniform fracture_sites: StorageBuffer<Vec4> @0
    uniform impact_state: StorageBuffer<Vec4> @1
    uniform material_resistance: StorageBuffer<Vec4> @2
    uniform fracture_clusters: StorageBuffer<Vec4> @3
    let site_index = id.x
    let site = fracture_sites[site_index]
    let impact = impact_state[site_index]
    let resistance = material_resistance[site_index]
    let output = vec4(
        site.x + impact.x - resistance.x,
        site.y + impact.y - resistance.y,
        site.z + impact.z - resistance.z,
        1.0
    )
    fracture_clusters[site_index] = output
    return output
