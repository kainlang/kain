// SPIR-V metrology deviation analysis seed.

shader compute surface_deviation_resolve(id: UVec3) -> Vec4:
    uniform measured_surface_samples: StorageBuffer<Vec4> @0
    uniform reference_surface_samples: StorageBuffer<Vec4> @1
    uniform tolerance_profile: StorageBuffer<Vec4> @2
    uniform deviation_field: StorageBuffer<Vec4> @3
    let sample_index = id.x
    let measured = measured_surface_samples[sample_index]
    let reference = reference_surface_samples[sample_index]
    let tolerance = tolerance_profile[0]
    let output = vec4(
        measured.x - reference.x,
        measured.y - reference.y,
        abs(measured.z - reference.z) + tolerance.z,
        1.0
    )
    deviation_field[sample_index] = output
    return output
