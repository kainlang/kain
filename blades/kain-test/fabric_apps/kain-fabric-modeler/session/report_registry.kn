struct ReportDescriptor:
    uri: String
    producer_intent: String
    status: String
    summary: String

fn default_reports() -> Array<ReportDescriptor>:
    return [
        ReportDescriptor {
            uri: "report://scene/current",
            producer_intent: "project.bootstrap",
            status: "ready",
            summary: "Current scene report."
        },
        ReportDescriptor {
            uri: "report://topology/current",
            producer_intent: "analysis.topology_refresh",
            status: "ready",
            summary: "Current topology report."
        },
        ReportDescriptor {
            uri: "artifact://publish/summary",
            producer_intent: "publish.summary_refresh",
            status: "ready",
            summary: "Current publish summary artifact."
        }
    ]
