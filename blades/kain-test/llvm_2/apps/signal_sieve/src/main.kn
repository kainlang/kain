fn clamp_int(value: Int, floor: Int, ceiling: Int) -> Int:
    if value < floor:
        return floor
    else:
        if value > ceiling:
            return ceiling
    return value

fn frame_score(amplitude: Int, frequency: Int, phase: Int, drift: Int) -> Int:
    let mix = (amplitude & 63) + (frequency ^ phase)
    return amplitude + frequency + phase + drift + mix

fn classify_frame(score: Int) -> Int:
    if score < 90:
        return 0
    else:
        if score < 180:
            return 1
        else:
            if score < 260:
                return 2
    return 3

fn main() -> Int:
    let score = frame_score(42, 17, 9, 5)
    let band = classify_frame(score)
    let normalized = clamp_int(score + band, 0, 99)
    return normalized
