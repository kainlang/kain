use std::runtime

component HelloWindow():
    render <panel title="Kain Window Proof" fill_color="#1a1a2e">
        <text value="Hello from the Kain component surface!" font_size={18} fill_color="#21d4a1" />
        <text value="If you can see this, the pipeline works." font_size={14} fill_color="#e8e8f0" />
    </panel>

world ProofWorld:
    surface native_ui => HelloWindow

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init
    return 0
