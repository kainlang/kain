// ===================================================================
// TEST 14: IME
// ===================================================================

fn test_ime() -> Int:
    let _reset = ui_reset()
    let session = ui_session_create("proof.ime", 640, 480)
    if session <= 0:
        return OFFSET_IME * 100 + 10 + session

    let node = ui_node_create(session, "input")
    if node < 1:
        return OFFSET_IME * 100 + 20 + node

    // IME begin — returns Int
    let begun = ui_ime_begin(session, node)
    if begun < 0:
        return OFFSET_IME * 100 + 30

    // Active node — returns Int
    let _active = ui_ime_active_node(session)

    // Commit text — returns Int
    let committed = ui_ime_commit_text(session, "hello")
    if committed < 0:
        return OFFSET_IME * 100 + 40

    // IME end — returns Int
    let ended = ui_ime_end(session)
    if ended < 0:
        return OFFSET_IME * 100 + 50

    let _destroy = ui_node_destroy(session, node)
    let _sess_destroy = ui_session_destroy(session)
    return 0

// ===================================================================
// TEST 15: Hot Reload
// ===================================================================

fn test_hot_reload() -> Int:
    let _reset = ui_reset()
    let session = ui_session_create("proof.hotreload", 640, 480)
    if session <= 0:
        return OFFSET_HOTRELOAD * 100 + 10 + session

    // Begin — returns generation (Int)
    let gen = ui_hot_reload_begin(session, "rev.1")
    if gen < 0:
        return OFFSET_HOTRELOAD * 100 + 20 + gen

    // Commit — returns Int
    let committed = ui_hot_reload_commit(session)
    if committed < 0:
        return OFFSET_HOTRELOAD * 100 + 30

    // Generation — returns Int
    let _generation = ui_hot_reload_generation(session)

    let _sess_destroy = ui_session_destroy(session)
    return 0

// ===================================================================
// TEST 16: Menu
// ===================================================================

fn test_menu() -> Int:
    let _reset = ui_reset()
    let session = ui_session_create("proof.menu", 640, 480)
    if session <= 0:
        return OFFSET_MENU * 100 + 10 + session

    // Create menu — returns menu ID
    let menu = ui_menu_create(session, "file.menu")
    if menu < 0:
        return OFFSET_MENU * 100 + 20 + menu

    // Add items — returns Int
    let _item1 = ui_menu_add_item(session, menu, "file.open", "Open", 100)
    let _item2 = ui_menu_add_item(session, menu, "file.save", "Save", 101)
    let _item3 = ui_menu_add_item(session, menu, "file.exit", "Exit", 102)

    // Item count — returns Int
    let item_ct = ui_menu_item_count(session, menu)
    if item_ct < 1:
        return OFFSET_MENU * 100 + 30

    // Open menu — returns Int
    let opened = ui_menu_open(session, menu, 100.0, 50.0)
    if opened < 0:
        return OFFSET_MENU * 100 + 60

    // Active menu — returns Int
    let _active = ui_menu_active(session)

    let _sess_destroy = ui_session_destroy(session)
    return 0

// ===================================================================
// TEST 17: Drag & Drop
// ===================================================================

fn test_drag_drop() -> Int:
    let _reset = ui_reset()
    let session = ui_session_create("proof.drag", 640, 480)
    if session <= 0:
        return OFFSET_DRAG * 100 + 10 + session

    let source = ui_node_create(session, "draggable")
    let target = ui_node_create(session, "dropzone")
    if source < 1 or target < 1:
        return OFFSET_DRAG * 100 + 20

    let _sr = ui_node_set_rect(session, source, 0.0, 0.0, 50.0, 50.0)
    let _tr = ui_node_set_rect(session, target, 200.0, 200.0, 100.0, 100.0)

    // Begin drag — returns Int
    let begun = ui_drag_begin(session, source, "{id:42}", 10.0, 10.0)
    if begun < 0:
        return OFFSET_DRAG * 100 + 30

    // Active drag node — returns Int
    let active = ui_drag_active_node(session)
    if active != source:
        return OFFSET_DRAG * 100 + 40

    // Drag x, y — returns Float
    let _dx = ui_drag_x(session)
    let _dy = ui_drag_y(session)

    // Update — returns Int
    let updated = ui_drag_update(session, 220.0, 220.0, target)
    if updated < 0:
        return OFFSET_DRAG * 100 + 60

    // Drop target — returns Int
    let _drop_tgt = ui_drag_drop_target(session)

    // Drop — returns Int
    let dropped = ui_drag_drop(session, target)
    if dropped < 0:
        return OFFSET_DRAG * 100 + 70

    let _destroy_src = ui_node_destroy(session, source)
    let _destroy_tgt = ui_node_destroy(session, target)
    let _sess_destroy = ui_session_destroy(session)
    return 0

// ===================================================================
// TEST 18: Dialog
// ===================================================================

fn test_dialog() -> Int:
    let _reset = ui_reset()
    let session = ui_session_create("proof.dialog", 640, 480)
    if session <= 0:
        return OFFSET_DIALOG * 100 + 10 + session

    // Request dialog — returns dialog ID
    let dialog = ui_dialog_request(session, "info", "Confirm", "Continue?")
    if dialog < 0:
        return OFFSET_DIALOG * 100 + 20 + dialog

    // Respond — returns Int
    let responded = ui_dialog_respond(session, dialog, 1, "ok")
    if responded < 0:
        return OFFSET_DIALOG * 100 + 60

    // Poll response — returns Int
    let _poll = ui_dialog_poll_response(session)

    let _sess_destroy = ui_session_destroy(session)
    return 0

// ===================================================================
// TEST 19: Layout Helpers (pure math — always works)
// ===================================================================

fn test_layout_helpers() -> Int:
    // ui_float_min/max/clamp
    if ui_float_min(3.0, 7.0) != 3.0:
        return OFFSET_LAYOUT * 100 + 10
    if ui_float_max(3.0, 7.0) != 7.0:
        return OFFSET_LAYOUT * 100 + 20
    if ui_float_clamp(15.0, 0.0, 10.0) != 10.0:
        return OFFSET_LAYOUT * 100 + 30
    if ui_float_clamp(-5.0, 0.0, 10.0) != 0.0:
        return OFFSET_LAYOUT * 100 + 35
    if ui_float_clamp(5.0, 0.0, 10.0) != 5.0:
        return OFFSET_LAYOUT * 100 + 38

    // ui_rect_right/bottom
    if ui_rect_right(10.0, 200.0) != 210.0:
        return OFFSET_LAYOUT * 100 + 40
    if ui_rect_bottom(20.0, 150.0) != 170.0:
        return OFFSET_LAYOUT * 100 + 50

    // ui_rect_contains
    if ui_rect_contains(50.0, 50.0, 0.0, 0.0, 200.0, 200.0) != 1:
        return OFFSET_LAYOUT * 100 + 60
    if ui_rect_contains(300.0, 50.0, 0.0, 0.0, 200.0, 200.0) != 0:
        return OFFSET_LAYOUT * 100 + 70

    // Layout column/row
    if ui_layout_column_y(0.0, 20.0, 30.0, 10.0) != 20.0:
        return OFFSET_LAYOUT * 100 + 80
    if ui_layout_column_y(1.0, 20.0, 30.0, 10.0) != 60.0:
        return OFFSET_LAYOUT * 100 + 85
    if ui_layout_row_x(0.0, 10.0, 80.0, 8.0) != 10.0:
        return OFFSET_LAYOUT * 100 + 90
    if ui_layout_row_x(1.0, 10.0, 80.0, 8.0) != 98.0:
        return OFFSET_LAYOUT * 100 + 95

    // Layout insets
    if ui_layout_inset_x(10.0, 5.0) != 15.0:
        return OFFSET_LAYOUT * 100 + 100
    if ui_layout_inset_y(20.0, 8.0) != 28.0:
        return OFFSET_LAYOUT * 100 + 105
    if ui_layout_inset_width(200.0, 10.0, 10.0) != 180.0:
        return OFFSET_LAYOUT * 100 + 110
    if ui_layout_inset_height(100.0, 5.0, 5.0) != 90.0:
        return OFFSET_LAYOUT * 100 + 115

    // Center
    let cx = ui_layout_center_x(50.0, 200.0, 100.0)
    if cx != 100.0:
        return OFFSET_LAYOUT * 100 + 120
    let cy = ui_layout_center_y(50.0, 200.0, 100.0)
    if cy != 100.0:
        return OFFSET_LAYOUT * 100 + 125

    // Column/row height/width
    if ui_layout_column_height(0.0, 30.0, 10.0) != 0.0:
        return OFFSET_LAYOUT * 100 + 130
    if ui_layout_column_height(3.0, 30.0, 10.0) != 110.0:
        return OFFSET_LAYOUT * 100 + 135
    if ui_layout_row_width(4.0, 80.0, 12.0) != 356.0:
        return OFFSET_LAYOUT * 100 + 140

    // Split
    let left_w = ui_layout_split_left_width(300.0, 0.6, 10.0)
    if left_w != 174.0:
        return OFFSET_LAYOUT * 100 + 150
    let right_x = ui_layout_split_right_x(0.0, 300.0, 0.6, 10.0)
    if right_x != 184.0:
        return OFFSET_LAYOUT * 100 + 160
    let right_w = ui_layout_split_right_width(300.0, 0.6, 10.0)
    if right_w != 116.0:
        return OFFSET_LAYOUT * 100 + 170

    return 0

// ===================================================================
// TEST 20: Convenience — reconcile, style helpers, state helpers, render
// ===================================================================

fn test_convenience() -> Int:
    let _reset = ui_reset()
    let session = ui_session_create("proof.conv", 800, 600)
    if session <= 0:
        return OFFSET_CONVENIENCE * 100 + 10 + session

    // Font for render tests
    let font = ui_font_create(session, "font.conv.body", "JetBrains Mono", 14.0)

    // reconcile_node — returns node ID
    let root = ui_reconcile_node(session, 0, "root", "conv.root", 0.0, 0.0, 800.0, 600.0)
    if root < 1:
        return OFFSET_CONVENIENCE * 100 + 20 + root

    // reconcile_text_node
    let label = ui_reconcile_text_node(session, root, "text", "conv.label", "Hello", 20.0, 20.0, 200.0, 24.0)
    if label < 1:
        return OFFSET_CONVENIENCE * 100 + 30 + label

    // reconcile_labeled_node
    let panel = ui_reconcile_labeled_node(session, root, "panel", "conv.panel", "panel-content", "region", "My Panel", 40.0, 60.0, 300.0, 200.0)
    if panel < 1:
        return OFFSET_CONVENIENCE * 100 + 40 + panel

    // reconcile_focusable_node
    let button = ui_reconcile_focusable_node(session, panel, "button", "conv.button", "Click", "button", "Click Button", 10.0, 10.0, 120.0, 36.0)
    if button < 1:
        return OFFSET_CONVENIENCE * 100 + 50 + button

    // reconcile_stateful_node
    let s_node = ui_reconcile_stateful_node(session, root, "widget", "conv.stateful", "toggle", "on", 400.0, 20.0, 100.0, 50.0)
    if s_node < 1:
        return OFFSET_CONVENIENCE * 100 + 55 + s_node

    // Style color RGBA helpers — return Int
    let _cr = ui_style_color_rgba(session, root, "ui.root", 0.05, 0.08, 0.12, 1.0)
    let _cp = ui_style_color_rgba(session, panel, "ui.panel", 0.15, 0.20, 0.28, 1.0)

    // ui_style_metric — returns Int
    let _sm = ui_style_metric(session, panel, "ui.panel", "border.radius", 8.0)

    // ui_style_padding — returns Int
    let _sp = ui_style_padding(session, panel, "ui.panel", 12.0, 8.0, 12.0, 8.0)

    // ui_style_spacing — returns Int
    let _ss = ui_style_spacing(session, panel, "ui.panel", 6.0)

    // State helpers (Int-returning)
    let _s1 = ui_state_set_i64(session, button, "click.count", 3)
    let s1r = ui_state_i64(session, button, "click.count", -1)
    if s1r != 3:
        return OFFSET_CONVENIENCE * 100 + 80

    let _s2 = ui_state_set_bool(session, button, "enabled", 1)
    let s2r = ui_state_bool(session, button, "enabled", 0)
    if s2r != 1:
        return OFFSET_CONVENIENCE * 100 + 85

    let _toggle = ui_state_toggle(session, button, "enabled")
    let s3r = ui_state_bool(session, button, "enabled", 0)
    if s3r != 0:
        return OFFSET_CONVENIENCE * 100 + 90

    // Counter — returns Int
    let c1 = ui_state_counter(session, button, "click.count", 1)
    if c1 != 4:
        return OFFSET_CONVENIENCE * 100 + 95

    // Reference, shape, hit, draw, resource — return Int
    let _ref = ui_state_reference(session, button, "related", label)
    let _shape = ui_state_shape(session, panel, "rect", "rounded")
    let _hit = ui_state_hit(session, panel, "button", "conv.button")
    let _draw = ui_state_draw(session, panel, "border", "1px")
    let _resource = ui_state_resource(session, panel, "icon", "check", 0)

    // Frame + render helpers
    let _begin = ui_frame_begin(session, 16.0)
    let _r_root = ui_render_box(session, root, "ui.root")
    let _r_panel = ui_render_box(session, panel, "ui.panel")
    let _r_at = ui_render_box_at(session, root, 0.0, 0.0, 800.0, 600.0, "ui.root")

    if font > 0:
        let _r_text = ui_render_text(session, label, font, 20.0, 20.0, "ui.label")
        let _r_txt_val = ui_render_text_value(session, label, font, "explicit", 20.0, 20.0, "ui.label")
        let _r_txt_box = ui_render_text_in_box(session, label, font, 4.0, 18.0, "ui.label")

    // Resource rendering
    let _r_res = ui_render_resource(session, root, 0, 10.0, 10.0, 32.0, 32.0, "sprite")
    let _r_res_node = ui_render_resource_in_node(session, panel, 0, "sprite")

    // ui_present_to_attached_host (calls end_frame + present + host_present)
    let _pth = ui_present_to_attached_host(session)

    // Event drain
    let _drained = ui_drain_events_for_node(session, button)

    let _node_contains = ui_node_contains_point(session, button, 50.0, 25.0)
    let _cust_hit = ui_custom_hit_contains(session, button, 50.0, 25.0)

    let _sess_destroy = ui_session_destroy(session)
    return 0

// ===================================================================
// MAIN — run all tests
// ===================================================================

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return -100 + init

    // Run all tests sequentially — first failure wins
    let tests: [Int] = [
        test_session_lifecycle(),
        test_node_lifecycle(),
        test_style(),
        test_state(),
        test_frame(),
        test_focus_hit_dirty(),
        test_events(),
        test_draw_commands(),
        test_resources(),
        test_font_texture_canvas(),
        test_text_measure(),
        test_accessibility(),
        test_clipboard(),
        test_ime(),
        test_hot_reload(),
        test_menu(),
        test_drag_drop(),
        test_dialog(),
        test_layout_helpers(),
        test_convenience(),
    ]

    var first_failure: Int = 0
    var idx: Int = 0
    while idx < len(tests):
        let result = tests[idx]
        if result != 0:
            first_failure = result
            break
        idx = idx + 1

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return -200 + shutdown

    return first_failure
