// ============================================================================
// shader_host.kn — FRAGMENT SHADER HOST SCAFFOLD
// ============================================================================
//
// WHAT THIS PROVES:
//   1. The Vulkan ABI library exposes `kain_vulkan_abi_load_shader(hex)` and
//      `kain_vulkan_abi_set_uniform(binding, data, size)` for uniform updates.
//      This file is the Kain-side scaffold that matches that contract.
//
//   2. The uniform signature (time @0, resolution @1, mouse @2) matches the
//      shaders in blades/shaderlib/ (ocean.kn, blackhole.kn). The descriptor
//      set layout in the Vulkan ABI library has 3 uniform buffer bindings:
//        - Binding 0: Float (time)
//        - Binding 1: Vec2 (resolution)
//        - Binding 2: Vec2 (mouse)
//
//   3. The `surface vulkan => ShaderFragment` proposal from NEWSLETTER-4 would
//      auto-generate a frame loop that calls load_shader + set_uniform instead
//      of a component render function. Until that's implemented, this file shows
//      the COMPONENT-SIDE scaffold — a world with surface native_ui that displays
//      the shader uniforms as text, proving the data contract is correct.
//
// ARCHITECTURE (when surface vulkan => ShaderFragment is implemented):
//   Compiler emits for `surface vulkan => OceanFragment`:
//     1. Compile ocean.kn → SPIR-V hex at build time
//     2. surface = kain_component_surface_resolve("native_ui")
//          → RENDERER_BACKEND=vulkan routes to GPU shim
//     3. session_create + session_attach_platform
//     4. kain_vulkan_abi_load_shader(session, spirv_hex)
//          → vkCreateShaderModule(fragment SPIR-V)
//          → vkCreateGraphicsPipeline(embedded VS + fragment)
//          → vkCreateRenderPass + vkCreateFramebuffer per swapchain image
//          → vkCreateDescriptorSetLayout(time/resolution/mouse)
//          → vkAllocateDescriptorSets + vkUpdateDescriptorSets
//     5. LOOP:
//          set_uniform(0, &time, 4)      // Float
//          set_uniform(1, &resolution, 8) // Vec2
//          set_uniform(2, &mouse, 8)      // Vec2
//          begin_frame → vkCmdDraw(3) → end_frame → present
//
// HOW TO RUN (current component scaffold, renders uniforms as text):
//   kain build src/shader_host.kn --target llvm && .kain/out/shader_host.exe
//
// HOW TO RUN (future 〰 when surface vulkan => ShaderFragment lands):
//   $env:RENDERER_BACKEND = "vulkan"
//   kain build src/shader_host.kn --target llvm && .kain/out/shader_host.exe
//   # The ocean.kn shader renders through the GPU fullscreen triangle
// ============================================================================

use std::runtime

// ============================================================================
// CONSTANTS — shader uniform contract (matches ocean.kn / blackhole.kn)
// ============================================================================
// WHY const: These are compile-time values that describe the shader uniform
// layout. They match the descriptor set bindings in the Vulkan ABI library:
//   - Binding 0: VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER at VK_SHADER_STAGE_FRAGMENT_BIT
//   - Binding 1: VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER at VK_SHADER_STAGE_FRAGMENT_BIT
//   - Binding 2: VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER at VK_SHADER_STAGE_FRAGMENT_BIT
// The 4th uniform (StorageBuffer<Float> @3) is a padding trick — it forces
// descriptor-based binding instead of push constants. See NEWSLETTER-1 §5.

const UNIFORM_TIME_BINDING: Int = 0
const UNIFORM_TIME_SIZE: Int = 4       // sizeof(Float)

const UNIFORM_RESOLUTION_BINDING: Int = 1
const UNIFORM_RESOLUTION_SIZE: Int = 8  // sizeof(Vec2) = 2 × Float

const UNIFORM_MOUSE_BINDING: Int = 2
const UNIFORM_MOUSE_SIZE: Int = 8       // sizeof(Vec2) = 2 × Float

// ============================================================================
// WORLD — shader host state authority
// ============================================================================
// WHY world: The shader host needs persistent state (frame counter, uniform
// values) that survives the frame loop. The world is the compiler-owned state
// authority. The component reads world state via `ShaderWorld.field`.

world ShaderWorld:
    state frames: Int = 0
    state sim_time: Float = 0.0
    state res_x: Int = 1280
    state res_y: Int = 720
    state mouse_x: Float = 0.5
    state mouse_y: Float = 0.5
    state shader_name: String = "none"
    surface native_ui => ShaderHostPanel

// ============================================================================
// FORMATTING HELPERS — top-level functions for JSX {expr}
// ============================================================================
// WHY top-level fn: Component methods from JSX {expr} are not yet supported
// by the codegen. Top-level fns with explicit args ARE supported. This is
// the proven working pattern from dashboard.kn.

fn uniform_time_str(t: Float) -> String:
    // Simulated time value — in the real pipeline this would be updated
    // every frame via kain_vulkan_abi_set_uniform(0, &time, 4)
    return "time: " + str(t as Int) + " s"

fn uniform_resolution_str(x: Int, y: Int) -> String:
    return "resolution: " + str(x) + " × " + str(y)

fn uniform_mouse_str(mx: Float, my: Float) -> String:
    return "mouse: (" + str(mx as Int) + ", " + str(my as Int) + ")"

fn shader_name_label(name: String) -> String:
    if name == "none":
        return "No shader loaded"
    return "Shader: " + name

// WHY helper fn: The dead-state validator requires at least one top-level
// function to directly read each world state field. JSX {expr} reads via
// `ShaderWorld.shader_name` aren't tracked yet.
fn read_shader_name() -> String:
    return ShaderWorld.shader_name

fn frame_label(frames: Int) -> String:
    return "Frame " + str(frames)

// ============================================================================
// SHADER SIGNATURE TABLE — documents the uniform contract
// ============================================================================
// WHY detailed labels: This acts as documentation for any fragment shader
// that targets the Kain shader host pipeline. The 4 uniforms match exactly
// what ocean.kn and blackhole.kn declare.

fn binding_table_row0() -> String:
    return "Binding 0 | Float            | time        | 4 bytes  | " + uniform_time_str(ShaderWorld.sim_time)

fn binding_table_row1() -> String:
    return "Binding 1 | Vec2             | resolution  | 8 bytes  | " + uniform_resolution_str(ShaderWorld.res_x, ShaderWorld.res_y)

fn binding_table_row2() -> String:
    return "Binding 2 | Vec2             | mouse       | 8 bytes  | " + uniform_mouse_str(ShaderWorld.mouse_x, ShaderWorld.mouse_y)

fn binding_table_row3() -> String:
    return "Binding 3 | StorageBuffer<Float> | _padding | N/A       | Push-constant bypass (see NEWSLETTER-1 §5)"

// ============================================================================
// COMPONENT — displays shader host state and uniform contract
// ============================================================================

component ShaderHostPanel():
    render <panel title="Kain Shader Host — Fragment Shader Scaffold">
        <stack direction="vertical" padding={24} spacing={16}>
            // Header
            <stack direction="horizontal" spacing={12}>
                <text value="SHADER HOST PIPELINE" font_size={20} />
                <text value={shader_name_label(read_shader_name())} font_size={12} />
            </stack>

            // Frame counter — proves render loop is alive
            <text value="── LIVE ──" font_size={14} />
            <text value={frame_label(ShaderWorld.frames)} font_size={24} />

            // Uniform binding contract — matches Vulkan ABI descriptor set layout
            <text value="── UNIFORM BINDING CONTRACT ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value="Binding | Type             | Name        | Size     | Current Value" font_size={10} />
                <text value={binding_table_row0()} font_size={10} />
                <text value={binding_table_row1()} font_size={10} />
                <text value={binding_table_row2()} font_size={10} />
                <text value={binding_table_row3()} font_size={10} />
            </stack>

            // Compatible shaders
            <text value="── COMPATIBLE SHADERS ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value="blades/shaderlib/ocean.kn     — Ray-traced ocean, 200+ lines, 64-step water column march" font_size={10} />
                <text value="blades/shaderlib/blackhole.kn — Schwarzschild black hole, 512-step gravitational raymarcher" font_size={10} />
                <text value="Both declare: uniform time: Float @0, resolution: Vec2 @1, mouse: Vec2 @2, _pad: StorageBuffer<Float> @3" font_size={10} />
            </stack>

            // Vulkan ABI library API
            <text value="── VULKAN ABI API (when surface vulkan => ShaderFragment lands) ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value="kain_vulkan_abi_load_shader(session, spirv_hex)" font_size={10} />
                <text value="  → vkCreateShaderModule → vkCreateGraphicsPipeline (with embedded fullscreen-triangle VS)" font_size={10} />
                <text value="  → vkCreateRenderPass → vkCreateFramebuffer per swapchain image" font_size={10} />
                <text value="  → vkCreateDescriptorSetLayout → vkAllocateDescriptorSets → vkUpdateDescriptorSets" font_size={10} />
                <text value="kain_vulkan_abi_set_uniform(session, binding, data, size)" font_size={10} />
                <text value="  → vkMapMemory → memcpy → vkUnmapMemory (host-visible, coherent)" font_size={10} />
                <text value="begin_frame → vkAcquireNextImageKHR → vkCmdBeginRenderPass → vkCmdBindPipeline" font_size={10} />
                <text value="→ vkCmdBindDescriptorSets → vkCmdDraw(3) → vkCmdEndRenderPass" font_size={10} />
                <text value="present → vkQueueSubmit → vkQueuePresentKHR" font_size={10} />
            </stack>

            // How to run
            <text value="── HOW TO RUN WITH A SHADER ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value="1. Build SPIR-V:  kain gpu-artifacts blades/shaderlib/ocean.kn --target spirv" font_size={10} />
                <text value="2. Set backend:     $env:RENDERER_BACKEND = 'vulkan'" font_size={10} />
                <text value="3. Run:             kain run src/shader_host.kn --target llvm" font_size={10} />
                <text value="4. The ocean shader renders through the fullscreen triangle pipeline" font_size={10} />
            </stack>

            // Pipeline diagram
            <text value="── END-TO-END ──" font_size={14} />
            <text value="Kain shader → SPIR-V hex → load_shader → VkPipeline → set_uniform per frame → vkCmdDraw(3)" font_size={10} />
        </stack>
    </panel>

// ============================================================================
// ENTRY POINT
// ============================================================================

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    // WHY: The dead-state validator doesn't track JSX {expr} reads of world
    // state. These calls register each field as "read" so the validator
    // passes. The values are also read inside the component JSX.
    let _shader_name: String = read_shader_name()
    let _frames: Int = ShaderWorld.frames
    let _sim_time: Float = ShaderWorld.sim_time
    let _res_x: Int = ShaderWorld.res_x
    let _res_y: Int = ShaderWorld.res_y
    let _mouse_x: Float = ShaderWorld.mouse_x
    let _mouse_y: Float = ShaderWorld.mouse_y

    // The auto-generated frame loop renders ShaderHostPanel every frame.
    // When `surface vulkan => ShaderFragment` is implemented, the compiler
    // will emit a DIFFERENT frame loop for that surface kind — one that
    // calls load_shader + set_uniform instead of Component_render.

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    return 0
