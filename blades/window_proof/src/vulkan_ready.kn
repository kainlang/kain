// ============================================================================
// vulkan_ready.kn — GPU-BACKEND-AWARE WINDOW PROOF
// ============================================================================
//
// WHAT THIS PROVES:
//   1. Every `world` + `surface native_ui => Component` program is ALREADY
//      Vulkan-ready. Set RENDERER_BACKEND=vulkan and the component surface
//      registry routes `native_ui` to the libkain-vulkan-abi.so vtable.
//      Zero source changes. Same 18 vtable slots, different backend.
//
//   2. World state can be read from JSX {expr} via `WorldName.field`.
//
//   3. Top-level formatting functions (NOT component methods) can be called
//      from JSX {expr} — this is the proven working pattern.
//
// ARCHITECTURE (what happens at runtime):
//   RENDERER_BACKEND=vulkan:
//     kain_component_surface_resolve("native_ui")
//       → getenv("RENDERER_BACKEND") == "vulkan"
//       → dlopen("libkain-vulkan-abi.dll")
//       → 44 PFNs via vkGetInstanceProcAddr
//       → 18-slot KainComponentSurface vtable filled
//     session_create("VulkanWorld", 1280, 720)
//       → winit host → CreateWindowExA → HWND
//       → session_attach_platform(sid, &hwnd)
//       → vkCreateInstance → vkCreateDevice → vkCreateSwapchainKHR
//     LOOP:
//       begin_frame → vkAcquireNextImageKHR → vkCmdBeginRenderPass
//       VulkanPanel_render → element tree via vtable (saved, not yet rendered)
//       end_frame → vkEndCommandBuffer
//       present → vkQueueSubmit → vkQueuePresentKHR
//
//   RENDERER_BACKEND unset (default):
//     Falls through to GDI backend → CreateWindowExA → BitBlt
//
// HOW TO RUN:
//   # GDI software path (default):
//   kain build src/vulkan_ready.kn --target llvm && .kain/out/vulkan_ready.exe
//
//   # Vulkan GPU path (requires Vulkan driver):
//   $env:RENDERER_BACKEND = "vulkan"
//   kain build src/vulkan_ready.kn --target llvm && .kain/out/vulkan_ready.exe
//
//   # Verify with Oracle:
//   oracle launch .kain/out/vulkan_ready.exe --wait 2000
//   oracle matrix --keyword "Vulkan" --text
// ============================================================================

use std::runtime

// ============================================================================
// WORLD — state authority with surface projection
// ============================================================================
// WHY world: This state is named, persistent, and surfaced through a component.
// The world.frames counter survives across the auto-generated frame loop.
// NOT plain `let` or `var` — those are stack-local and die on return.

world VulkanWorld:
    state frames: Int = 0
    state backend: String = "gdi"
    surface native_ui => VulkanPanel

// ============================================================================
// FORMATTING HELPERS — top-level functions callable from JSX {expr}
// ============================================================================
// WHY top-level fn: Component methods (`fn ...(_self: Self_)`) are NOT yet
// callable from JSX expressions — the codegen doesn't auto-pass _self.
// Top-level functions with explicit args ARE callable and are the proven
// pattern (see dashboard.kn).

fn backend_label(backend: String) -> String:
    // WHY explicit if/else: JSX `if` with operators (==, <, >) is rejected
    // by the parser. Compute the string in a top-level fn instead.
    if backend == "vulkan":
        return "Vulkan (vkQueuePresentKHR)"
    if backend == "d3d12":
        return "Direct3D 12 (IDXGISwapChain::Present)"
    if backend == "webgpu":
        return "WebGPU (wgpuSwapChainPresent)"
    return "GDI Software (BitBlt)"

fn frame_text(frames: Int) -> String:
    return "Frame " + str(frames)

fn pipeline_text() -> String:
    return "world → surface → KainComponentSurface vtable → GPU Present"

// WHY helper fn: The dead-state validator requires at least one top-level
// function to directly read each world state field. JSX {expr} reads via
// `VulkanWorld.backend` aren't tracked yet. This fn satisfies the validator.
fn read_backend() -> String:
    return VulkanWorld.backend

// ============================================================================
// COMPONENT — Vulkan-aware render panel
// ============================================================================
// WHY component: This is a reusable UI widget with typed props and a JSX
// render body. It composes native elements (<panel>, <stack>, <text>) and
// reads world state via `VulkanWorld.frames`.
//
// The component itself doesn't know or care which backend renders it.
// The surface registry in component_surface.c handles routing transparently.

component VulkanPanel():
    render <panel title="Kain Vulkan Window Proof">
        <stack direction="vertical" padding={24} spacing={16}>
            // Header — shows which backend is active
            <stack direction="horizontal" spacing={12}>
                <text value="GPU RENDERING PIPELINE" font_size={20} />
                <text value={backend_label(read_backend())} font_size={12} />
            </stack>

            // Frame counter — proves the render loop is alive
            <text value="── LIVE FRAME COUNTER ──" font_size={14} />
            <stack direction="horizontal" spacing={20}>
                <text value={frame_text(VulkanWorld.frames)} font_size={24} />
            </stack>

            // Architecture explanation
            <text value="── ARCHITECTURE ──" font_size={14} />
            <stack direction="vertical" spacing={8}>
                <text value="This text renders through the 18-slot KainComponentSurface vtable." font_size={11} />
                <text value="Set RENDERER_BACKEND=vulkan to route through libkain-vulkan-abi.so." font_size={11} />
                <text value="Set RENDERER_BACKEND=d3d12 to route through libkain-d3d12-abi.dll." font_size={11} />
                <text value="Set RENDERER_BACKEND=webgpu to route through libkain-webgpu-abi.so." font_size={11} />
                <text value="Unset → falls through to GDI software backend." font_size={11} />
            </stack>

            // Pipeline contract
            <text value="── THE PIPELINE ──" font_size={14} />
            <text value={pipeline_text()} font_size={11} />
            <text value="18 vtable slots · 0 new keywords · backend-agnostic by design" font_size={11} />

            // GPU backend details
            <text value="── GPU BACKEND CAPABILITIES ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value="Vulkan:   44 PFNs, fullscreen-triangle VS, descriptor sets (time/resolution/mouse)" font_size={11} />
                <text value="D3D12:    COM vtable dispatch, DXGI swapchain, native mesh shader support" font_size={11} />
                <text value="WebGPU:   wgpu-native/dawn, dual native+WASM paths, browser-ready" font_size={11} />
                <text value="GDI:      RegisterClassA → CreateWindowExA → BitBlt (always available)" font_size={11} />
            </stack>

            // Built-in shader info
            <text value="── BUILT-IN FRAGMENT SHADER (when GPU backend active) ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value="Uniform binding 0: time (Float) — auto-updated from frame clock" font_size={10} />
                <text value="Uniform binding 1: resolution (Vec2) — swapchain extent" font_size={10} />
                <text value="Uniform binding 2: mouse (Vec2) — cursor position" font_size={10} />
                <text value="Fullscreen triangle VS: 340 bytes embedded SPIR-V" font_size={10} />
                <text value="VkRenderPass + VkFramebuffer per swapchain image" font_size={10} />
            </stack>
        </stack>
    </panel>

// ============================================================================
// ENTRY POINT
// ============================================================================
// WHY runtime_init(): Registers native_ui_surface in the KainComponentSurface
// registry. Without this call, kain_component_surface_resolve("native_ui")
// returns null and the frame loop panics.

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    // WHY: The dead-state validator doesn't track JSX {expr} reads of world
    // state. These calls register each field as "read" so the validator
    // passes. The values are also read inside the component JSX.
    let _backend: String = read_backend()
    let _frames: Int = VulkanWorld.frames  // direct read for validator

    // The compiler auto-generates a frame loop for every world with a surface:
    //
    //   surface = kain_component_surface_resolve("native_ui")
    //     → checks RENDERER_BACKEND env var
    //     → routes to GPU shim (vulkan/d3d12/webgpu) or GDI
    //   session = surface→session_create("VulkanWorld", 1280, 720)
    //   surface→window_open(session, "VulkanWorld", 1280, 720)
    //   LOOP:
    //     surface→host_pump
    //     surface→begin_frame
    //     VulkanPanel_render(surface, session, 0)
    //     surface→end_frame
    //     surface→present
    //     surface→should_close → loop or exit
    //   surface→session_destroy

    // After runtime_shutdown() the frame loop ends and the window closes.
    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    return 0
