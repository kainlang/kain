use std::runtime
use std::ui

fn main() -> Int:
    let _init = runtime_init()
    let s = ui_host_session_create("nns", "NNS", 400, 300, "winit")
    if s <= 0:
        return 1

    let root = ui_reconcile_node(s, 0, "root", "nns.root", 0.0, 0.0, 400.0, 300.0)

    let _b = ui_frame_begin(s, 16.0)
    let _x = ui_frame_submit(s)

    let _d = ui_session_destroy(s)
    return runtime_shutdown()
