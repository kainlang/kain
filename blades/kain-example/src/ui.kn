        let _status_copy = native_ui_node_set_text(session, status_text, page_name_copy(selected_page) + " / " + page_summary_copy(selected_page))
        let _sidebar_a = native_ui_node_set_text(session, sidebar_line_a, "page: " + page_name_copy(selected_page))
        let _sidebar_b = native_ui_node_set_text(session, sidebar_line_b, "frame: " + str(frame_counter))
        let _sidebar_c = native_ui_node_set_text(session, sidebar_line_c, "input.proof: " + str(input_proof_score))
