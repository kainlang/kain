        if slot == 2:
            return "Respawn"
        return "Stop"
    if page_id == page_three_d():
        if slot == 0:
            return "Instances +1"
        if slot == 1:
            return "Instances -1"
        if slot == 2:
            return "Orbit +Axis"
        return "Redraw"
    if page_id == page_network():
        if slot == 0:
            return "Run Roundtrip"
        if slot == 1:
            return "Run Again"
        if slot == 2:
            return "Inspect Route"
        return "Probe State"
    if page_id == page_entangle():
        if slot == 0:
            return "Energy +16"
        if slot == 1:
            return "Energy -8"
        if slot == 2:
            return "Seed Lattice"
        return "Sync Check"
    if slot == 0:
        return "Run Labs"
    if slot == 1:
        return "Read Report"
    if slot == 2:
        return "Preview Quine"
    return "Preview HTML"

