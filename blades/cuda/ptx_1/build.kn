use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let pkg = package("cuda")
        .version("0.1.0")
        .description("Author-first CUDA/PTX blade: Kain drives multi-stage compute and a native C++ reference comparator.")

    let blade_spec = blade("cuda")
        .kind("kain_library")
        .entry("src/main.kn")
        .source_root("src")
        .module_root("src")
        .build_target("llvm")

    let defaults = build_defaults()
        .entry("src/main.kn")
        .artifact_root(".kain/out")
        .cache_root(".kain/cache/build")
        .profile("debug")
        .target("llvm")

    let run = run_defaults()
        .entry("src/main.kn")
        .target("llvm")

    let check = build_check("check-llvm")
        .entry("src/main.kn")
        .target("llvm")
        .axis("target", "llvm")
        .telemetry("llm.cuda")
        .input("src/main.kn")
        .input("native/cuda_visual_bridge.h")
        .input("native/cuda_visual_bridge.cpp")
        .input("build-cuda-bridge.ps1")
        .input("run.ps1")
        .input("build.kn")
        .input("KAIN.toml")

    let root_exe = native_executable("root-executable")
        .entry("src/main.kn")
        .root_output("$blade/cuda.exe")
        .requires("check-llvm")
        .input("src/main.kn")
        .input("run.ps1")
        .input("build.kn")
        .input("KAIN.toml")

    return build_graph()
        .package(pkg)
        .blade(blade_spec)
        .defaults(defaults)
        .run(run)
        .task(check)
        .task(root_exe)
