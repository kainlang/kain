// ERROR: ownership use after teleport move
// @expected_code: KAIN-TYPE-0001
// @expected_mode: OwnershipViolation
// @expected_repair: s

world Authority23:
    state count: Int = 0
    surface native_ui => Panel

world Mirror23:
    state count_copy: Int = 0
    surface web => Panel

shatter struct Shard23:
    bias: Int
    phase: Int

fn main() -> Int:
    let s = Shard23 { bias: 1, phase: 2 }
    let moved = teleport s from Authority23 to Mirror23 via bus
    let _shape = s.bias
    return 0
