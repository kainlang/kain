// @expected_code: KAIN-SHADER-0010
// @expected_mode: CudaKernelContract
// @expected_repair: use_lower_ptx_arch

// A compute shader that requires a newer PTX architecture than the target.
shader compute SmTooOld:
    uniform input: Vec4 @0
    uniform output: Vec4 @1
    fn main():
        // Uses cuda_require_tensor_cores which needs sm_70+
        cuda_require_tensor_cores
        let gid = dispatch_thread_id.x
        mem_store(output, gid, mem_load(input, gid, "Vec4"))
        return
