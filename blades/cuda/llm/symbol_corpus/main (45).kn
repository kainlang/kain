use c::ffi_boundary_shared

fn main() -> Int:
    let iterations: Int = 5000000
    let expected: Int = 374126489
    var acc: Int = 1
    var index: Int = 0
    while index < iterations:
        acc = ffi_boundary_mix(acc + index, index)
        index = index + 1

    if acc != expected:
        return 1
    return 0
