use c::modeler_ops
use std::interop::bridge

struct NativeBrushOutputs:
    brush_snapshot: Any
    signature: String

fn main() -> NativeBrushOutputs:
    let settings = fabric_inputs.python_project_seed.project_settings
    let preview = fabric_inputs.model_seed.preview_image
    let preview_info = interop_shared_image_info(preview)
    modeler_stamp_highlight(preview, preview_info.byte_length, settings.brush_accent)
    let bytes = interop_shared_image_bytes(preview)
    let brush_snapshot = interop_shared_buffer_from_bytes(
        bytes,
        "u8",
        [len(bytes)],
        "rgba8",
        "application/octet-stream",
    )
    let signature = modeler_signature(preview_info.width, preview_info.height, settings.brush_accent)
    return NativeBrushOutputs {
        brush_snapshot: brush_snapshot,
        signature: signature
    }
