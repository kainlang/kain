use std::interop::bridge

struct ModelSeedOutputs:
    mesh_stream: Any
    preview_src: Any
    preview_dst: Any
    preview_image: Any
    scene_report: String

fn push_f32_demo(bytes: Array<Int>, value: Int) -> Void:
    if value == 1:
        bytes.push(0)
        bytes.push(0)
        bytes.push(128)
        bytes.push(63)
        return
    if value == 2:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        return
    if value == 3:
        bytes.push(0)
        bytes.push(0)
        bytes.push(64)
        bytes.push(64)
        return
    if value == 4:
        bytes.push(0)
        bytes.push(0)
        bytes.push(128)
        bytes.push(64)
        return
    bytes.push(0)
    bytes.push(0)
    bytes.push(160)
    bytes.push(64)

fn build_mesh_stream(vertex_count: Int, accent: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < vertex_count:
        bytes.push((index * 17 + accent) % 255)
        bytes.push((index * 29 + accent) % 255)
        bytes.push((index * 37 + accent) % 255)
        bytes.push(255)
        index = index + 1
    return bytes

fn build_preview_stream(count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        let value = (index % 4) + 1
        push_f32_demo(bytes, value)
        index = index + 1
    return bytes

fn build_zero_stream(count: Int) -> Array<Int>:
    let bytes = []
    let index = 0
    while index < count:
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        index = index + 1
    return bytes

fn build_preview_pixels(width: Int, height: Int, accent: Int) -> Array<Int>:
    let pixels = []
    let y = 0
    while y < height:
        let x = 0
        while x < width:
            let base = (x * 13 + y * 19 + accent) % 255
            pixels.push(base)
            pixels.push((base + accent) % 255)
            pixels.push((255 - base) % 255)
            pixels.push(255)
            x = x + 1
        y = y + 1
    return pixels

fn main() -> ModelSeedOutputs:
    let settings = fabric_inputs.python_project_seed.project_settings
    let mesh_bytes = build_mesh_stream(settings.mesh_vertex_count, settings.brush_accent)
    let preview_src_bytes = build_preview_stream(settings.preview_count)
    let preview_dst_bytes = build_zero_stream(settings.preview_count)
    let preview_pixels = build_preview_pixels(8, 8, settings.brush_accent)
    let mesh_stream = interop_shared_buffer_from_bytes(
        mesh_bytes,
        "u8",
        [len(mesh_bytes)],
        "rgba8",
        "application/octet-stream",
    )
    let preview_src = interop_shared_buffer_from_bytes(
        preview_src_bytes,
        "f32",
        [settings.preview_count],
        "f32",
        "application/octet-stream",
    )
    let preview_dst = interop_shared_buffer_from_bytes(
        preview_dst_bytes,
        "f32",
        [settings.preview_count],
        "f32",
        "application/octet-stream",
    )
    let preview_image = interop_shared_image_from_bytes(
        preview_pixels,
        8,
        8,
        4,
        "HWC",
        "rgba8",
        "image/x-kain-raster",
    )
    let scene_report = settings.project_name + ":" + settings.workspace_mode + ":vertices=" + str(settings.mesh_vertex_count)
    return ModelSeedOutputs {
        mesh_stream: mesh_stream,
        preview_src: preview_src,
        preview_dst: preview_dst,
        preview_image: preview_image,
        scene_report: scene_report
    }
