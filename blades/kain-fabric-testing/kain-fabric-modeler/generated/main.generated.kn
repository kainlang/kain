component App():
    render <slot>
        <theme name="kain_fabric_modeler">
            <token name="theme.background.top" category="color" value="#120e0b" />
            <token name="theme.background.bottom" category="color" value="#1e1915" />
            <token name="theme.surface.default" category="color" value="#211b16" />
            <token name="theme.surface.alt" category="color" value="#2d241d" />
            <token name="theme.surface.raised" category="color" value="#3a2d23" />
            <token name="theme.outline.soft" category="color" value="#5e4a39" />
            <token name="theme.outline.bright" category="color" value="#f59e0b" />
            <token name="theme.accent.primary" category="color" value="#ea580c" />
            <token name="theme.accent.soft" category="color" value="#fdba74" />
            <token name="text.default" category="color" value="#f8eee5" />
            <token name="theme.typography.scale" category="type" value={1.08} />
            <token name="theme.spacing.scale" category="space" value={1.02} />
            <token name="theme.radius.scale" category="radius" value={1.08} />
        </theme>
        <panel title="Kain Fabric Modeler" layout="dock" persistent_layout_id="kain_fabric_modeler_shell" gap={18} padding={18}>
            <panel title="Session Rail" dock="left" split_ratio={0.24} min_width={280} max_width={420} resizable={true} gap={12}>
                <inspector title="Workspace Modes">
                    <text role="body">{"Model Core | Poly modeling, kitbashing, and scene assembly."}</text>
                    <text role="body">{"Sculpt Forge | Brush-heavy form work, voxel remesh, and high frequency detail."}</text>
                    <text role="body">{"Surface Graph | Material layering, shader previews, and lookdev iteration."}</text>
                    <text role="body">{"UV And Paint | UV layout, texture projection, and paint layer review."}</text>
                    <text role="body">{"Rig And Pose | Rig controls, deformation checks, and pose-space sculpt review."}</text>
                    <text role="body">{"Review And Publish | Topology review, export summaries, and materialization receipts."}</text>
                </inspector>
                <inspector title="Command Surface">
                    <text role="body">{"Bootstrap Project | project.bootstrap | Seeds the canonical project, scene, preview, and publish session state."}</text>
                    <text role="body">{"Switch Workspace | workspace.switch_mode | Moves the operator into a different workspace mode and marks downstream inspectors for refresh."}</text>
                    <text role="body">{"Activate Tool | tool.activate | Changes the active authoring tool and updates the live tool preset context."}</text>
                    <text role="body">{"Set Selection | selection.set | Replaces the live entity selection and updates inspector read models."}</text>
                    <text role="body">{"Frame Selection | viewport.frame_selection | Repositions the active camera around the current selection without mutating resources."}</text>
                    <text role="body">{"Apply Brush | mesh.brush_apply | Applies a sculpt stroke, invalidates preview/topology state, and schedules the brush intent lane."}</text>
                    <text role="body">{"Rebake Preview | preview.rebake | Refreshes the GPU preview resources for the current session state."}</text>
                    <text role="body">{"Refresh Topology | analysis.topology_refresh | Runs the topology report intent against the current mesh resources."}</text>
                    <text role="body">{"Refresh Publish Summary | publish.summary_refresh | Recomputes the publish summary artifact from the latest reports and resources."}</text>
                </inspector>
                <inspector title="Imported Runtime Packs">
                    <text role="body">{"Render Runtime | runtime-pack"}</text>
                    <text role="body">{"Scene Runtime | runtime-pack"}</text>
                    <text role="body">{"Editor Runtime | runtime-pack"}</text>
                    <text role="body">{"UI Workbench | runtime-pack"}</text>
                    <text role="body">{"Workspace Preset Runtime | runtime-pack"}</text>
                    <text role="body">{"Procedural Runtime | runtime-pack"}</text>
                    <text role="body">{"Material Runtime | runtime-pack"}</text>
                    <text role="body">{"Shader Runtime | runtime-pack"}</text>
                    <text role="body">{"Viewport Runtime | runtime-pack"}</text>
                    <text role="body">{"Interaction Runtime | runtime-pack"}</text>
                    <text role="body">{"Physics Runtime | runtime-pack"}</text>
                    <text role="body">{"Mesh Runtime | runtime-pack"}</text>
                </inspector>
            </panel>
            <panel title="Modeling Stage" dock="center" gap={14}>
                <viewport3d title="Viewport Stage" scene="modeler_scene" />
                <panel title="Realtime Deck" layout="row" gap={12}>
                    <graph title="Material Graph" />
                    <graph title="Procedural Stack" />
                    <timeline title="Fabric Timeline" />
                </panel>
                <panel title="State Projection" layout="row" gap={12}>
                    <graph title="Intent Queue" />
                    <graph title="Topology Console" />
                    <graph title="Publish Summary" />
                </panel>
            </panel>
            <panel title="Authoring Rails" dock="right" split_ratio={0.26} min_width={320} max_width={460} resizable={true} gap={12}>
                <inspector title="Surface Registry">
                    <text role="body">{"Viewport Stage | viewport3d | Primary model editing viewport backed by the native runtime lane."}</text>
                    <text role="body">{"Scene Outliner | tree | Hierarchy navigation for scene objects, kits, and fabrication groups."}</text>
                    <text role="body">{"Asset Browser | tree | Mesh, material, shader, brush, and package browsing."}</text>
                    <text role="body">{"Selection Inspector | inspector | Transforms, topology, metadata, and material assignment."}</text>
                    <text role="body">{"Tool Shelf | inspector | Model, sculpt, retopo, UV, paint, and review tools."}</text>
                    <text role="body">{"Material Graph | graph | Surface graph authoring and shader routing."}</text>
                    <text role="body">{"Procedural Stack | graph | Procedural modifiers, instancing, and generation layers."}</text>
                    <text role="body">{"Topology Console | graph | Topology metrics, retopo hints, and mesh health reporting."}</text>
                    <text role="body">{"Fabric Timeline | timeline | Fabric step execution and report flow."}</text>
                    <text role="body">{"Publish Summary | inspector | Export readiness, delivery notes, and bundle summary."}</text>
                </inspector>
                <inspector title="Tool Rail">
                    <text role="body">{"Select | Selection, hierarchy filtering, and transform handoff."}</text>
                    <text role="body">{"Extrude | Poly modeling and shell generation."}</text>
                    <text role="body">{"Boolean | Destructive and non-destructive mesh cutting."}</text>
                    <text role="body">{"Clay Sculpt | Brush-based form building with native preview stamping."}</text>
                    <text role="body">{"Voxel Remesh | Topology reset and sculpt mesh cleanup."}</text>
                    <text role="body">{"UV Pack | Chart packing and texel density review."}</text>
                    <text role="body">{"Material Paint | Mask, ID, and layer authoring."}</text>
                    <text role="body">{"Publish Bundle | Fabric summary, bundle materialization, and export review."}</text>
                </inspector>
                <inspector title="Intent Library">
                    <text role="body">{"Project Bootstrap | fabric/intents/project_bootstrap.fabric.toml | produces 4 targets"}</text>
                    <text role="body">{"Brush Apply | fabric/intents/brush_apply.fabric.toml | produces 1 targets"}</text>
                    <text role="body">{"Preview Rebake | fabric/intents/preview_rebake.fabric.toml | produces 2 targets"}</text>
                    <text role="body">{"Topology Refresh | fabric/intents/topology_refresh.fabric.toml | produces 0 targets"}</text>
                    <text role="body">{"Publish Summary Refresh | fabric/intents/publish_summary.fabric.toml | produces 1 targets"}</text>
                </inspector>
                <inspector title="Resource Registry">
                    <text role="body">{"mesh://scene/main/entity/cube_01 | shared_buffer | Primary scene mesh stream authored by the Kain seed step."}</text>
                    <text role="body">{"buffer://preview/source | shared_buffer | Source preview buffer passed into the GPU compute preview lane."}</text>
                    <text role="body">{"buffer://preview/destination | shared_buffer | Destination preview buffer populated by the GPU preview bake."}</text>
                    <text role="body">{"image://preview/baked | shared_image | Baked preview image projected into the viewport and publish inspectors."}</text>
                    <text role="body">{"buffer://brush/latest_stamp | shared_buffer | Latest brush stamp buffer emitted by the native helper."}</text>
                </inspector>
            </panel>
            <panel title="Runtime Telemetry" dock="bottom" split_ratio={0.25} min_height={200} max_height={340} resizable={true} layout="row" gap={12}>
                <inspector title="Fabric Pipeline">
                    <text role="body">{"python_project_seed | python | Seeds project defaults, viewport sizing, brush accent, and mesh counts."}</text>
                    <text role="body">{"model_seed | kain | Authors the scene seed, mesh stream, preview image, and scene report."}</text>
                    <text role="body">{"native_brush | c_abi | Uses the native helper to stamp the preview and emit a brush snapshot."}</text>
                    <text role="body">{"topology_analyzer | rust_crate | Computes topology-facing checksums and health reporting."}</text>
                    <text role="body">{"gpu_preview | gpu_compute | Runs the preview stream through the Fabric GPU path."}</text>
                    <text role="body">{"node_publisher | kain | Builds the operator-facing publish/export summary through the Kain-to-Node bridge."}</text>
                </inspector>
                <inspector title="Session Truth">
                    <text role="body">{"Canonical session document lives in session/session_schema.kn"}</text>
                    <text role="body">{"Reducers mark dirty state before heavy work executes"}</text>
                    <text role="body">{"Intent planner maps commands into reusable Fabric graphs"}</text>
                    <text role="body">{"Resource and report stores project back into the native runtime snapshot"}</text>
                </inspector>
                <inspector title="Capabilities">
                    <text role="body">{"ui.runtime"}</text>
                    <text role="body">{"actor.runtime"}</text>
                    <text role="body">{"async.runtime"}</text>
                    <text role="body">{"host.bridge"}</text>
                    <text role="body">{"reflection"}</text>
                    <text role="body">{"gfx.viewport"}</text>
                    <text role="body">{"scene.runtime"}</text>
                    <text role="body">{"scene.query"}</text>
                    <text role="body">{"scene.mutation"}</text>
                    <text role="body">{"asset.gltf"}</text>
                    <text role="body">{"asset.realtime"}</text>
                    <text role="body">{"ui.bundle"}</text>
                    <text role="body">{"device.reflection"}</text>
                </inspector>
            </panel>
        </panel>
    </slot>