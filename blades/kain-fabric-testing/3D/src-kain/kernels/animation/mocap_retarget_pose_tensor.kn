// SPIR-V mocap retargeting seed.

shader compute mocap_retarget_pose_tensor(id: UVec3) -> Vec4:
    uniform source_pose: StorageBuffer<Vec4> @0
    uniform target_rig_map: StorageBuffer<Vec4> @1
    uniform retarget_constraints: StorageBuffer<Vec4> @2
    uniform target_pose: StorageBuffer<Vec4> @3
    let joint_index = id.x
    let source = source_pose[joint_index]
    let rig_map = target_rig_map[joint_index]
    let constraint = retarget_constraints[joint_index]
    let output = vec4(
        source.x + rig_map.x * constraint.x,
        source.y + rig_map.y * constraint.y,
        source.z + rig_map.z * constraint.z,
        1.0
    )
    target_pose[joint_index] = output
    return output
