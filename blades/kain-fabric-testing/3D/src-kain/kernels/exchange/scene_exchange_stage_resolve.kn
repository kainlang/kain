// SPIR-V scene exchange stage resolve seed.

shader compute scene_exchange_stage_resolve(id: UVec3) -> Vec4:
    uniform stage_layers: StorageBuffer<Vec4> @0
    uniform variant_state: StorageBuffer<Vec4> @1
    uniform resolver_state: StorageBuffer<Vec4> @2
    uniform resolved_stage_payload: StorageBuffer<Vec4> @3
    let layer_index = id.x
    let layer = stage_layers[layer_index]
    let variant = variant_state[layer_index]
    let resolver = resolver_state[0]
    let output = vec4(
        layer.x + variant.x,
        layer.y + resolver.y,
        variant.z + resolver.z,
        1.0
    )
    resolved_stage_payload[layer_index] = output
    return output
