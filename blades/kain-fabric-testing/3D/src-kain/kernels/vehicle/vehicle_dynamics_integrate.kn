// SPIR-V vehicle dynamics integration seed.

shader compute vehicle_dynamics_integrate(id: UVec3) -> Vec4:
    uniform chassis_state: StorageBuffer<Vec4> @0
    uniform wheel_contact_state: StorageBuffer<Vec4> @1
    uniform drivetrain_state: StorageBuffer<Vec4> @2
    uniform integrated_vehicle_state: StorageBuffer<Vec4> @3
    let vehicle_index = id.x
    let chassis = chassis_state[vehicle_index]
    let wheel = wheel_contact_state[vehicle_index]
    let drivetrain = drivetrain_state[vehicle_index]
    let output = vec4(
        chassis.x + wheel.x,
        chassis.y + drivetrain.y,
        wheel.z + drivetrain.z,
        1.0
    )
    integrated_vehicle_state[vehicle_index] = output
    return output
