// SPIR-V virtual production stage sync seed.

shader compute led_volume_sync(id: UVec3) -> Vec4:
    uniform camera_tracking_state: StorageBuffer<Vec4> @0
    uniform wall_playback_state: StorageBuffer<Vec4> @1
    uniform color_sync_state: StorageBuffer<Vec4> @2
    uniform stage_sync_state: StorageBuffer<Vec4> @3
    let sync_index = id.x
    let camera = camera_tracking_state[sync_index]
    let wall = wall_playback_state[sync_index]
    let color = color_sync_state[0]
    let output = vec4(
        camera.x + wall.x,
        camera.y + color.y,
        wall.z + color.z,
        1.0
    )
    stage_sync_state[sync_index] = output
    return output
