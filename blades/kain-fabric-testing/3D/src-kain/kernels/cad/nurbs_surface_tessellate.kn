// SPIR-V NURBS surface tessellation seed.

shader compute nurbs_surface_tessellate(id: UVec3) -> Vec4:
    uniform control_points: StorageBuffer<Vec4> @0
    uniform knot_vectors: StorageBuffer<Vec4> @1
    uniform tessellation_policy: StorageBuffer<Vec4> @2
    uniform tessellated_surface: StorageBuffer<Vec4> @3
    let control_index = id.x
    let control = control_points[control_index]
    let knot = knot_vectors[control_index]
    let policy = tessellation_policy[0]
    let output = vec4(
        control.x + knot.x,
        control.y + policy.y,
        knot.z + policy.z,
        1.0
    )
    tessellated_surface[control_index] = output
    return output
