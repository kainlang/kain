// SPIR-V dyntopo/voxel remesh seed.

shader compute dyntopo_voxel_remesh(id: UVec3) -> Vec4:
    uniform surface_voxels: StorageBuffer<Vec4> @0
    uniform remesh_density: StorageBuffer<Vec4> @1
    uniform surface_velocity: StorageBuffer<Vec4> @2
    uniform remeshed_surface_voxels: StorageBuffer<Vec4> @3
    let voxel_index = id.x
    let voxel = surface_voxels[voxel_index]
    let density = remesh_density[voxel_index]
    let velocity = surface_velocity[voxel_index]
    let output = vec4(
        voxel.x + density.x * 0.1,
        voxel.y + velocity.y * 0.05,
        voxel.z + density.z * 0.1,
        1.0
    )
    remeshed_surface_voxels[voxel_index] = output
    return output
