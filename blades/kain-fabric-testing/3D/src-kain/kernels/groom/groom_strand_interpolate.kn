// SPIR-V groom strand interpolation seed.

shader compute groom_strand_interpolate(id: UVec3) -> Vec4:
    uniform guide_roots: StorageBuffer<Vec4> @0
    uniform guide_tangents: StorageBuffer<Vec4> @1
    uniform groom_controls: StorageBuffer<Vec4> @2
    uniform strand_vertices: StorageBuffer<Vec4> @3
    let strand_index = id.x
    let root = guide_roots[strand_index]
    let tangent = guide_tangents[strand_index]
    let control = groom_controls[strand_index]
    let output = vec4(
        root.x + tangent.x * control.x,
        root.y + tangent.y * control.y,
        root.z + tangent.z * control.z,
        1.0
    )
    strand_vertices[strand_index] = output
    return output
