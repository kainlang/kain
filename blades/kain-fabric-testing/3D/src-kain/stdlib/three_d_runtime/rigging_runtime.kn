// Skeleton authoring, control-rig solve, skin binding, and retarget-safe rig assembly contracts.

struct SkeletonDescriptor:
    skeleton_id: String
    skeleton_scope: String
    binding_policy: String

struct ControlRigDescriptor:
    control_rig_id: String
    solve_policy: String
    tensor_pipeline_id: String

struct SkinBindingDescriptor:
    skin_binding_id: String
    binding_kind: String
    validation_policy: String

struct RiggingRuntimeProfile:
    skeleton_runtime: SkeletonDescriptor
    control_rig_runtime: ControlRigDescriptor
    skin_binding_runtime: SkinBindingDescriptor

fn default_rigging_runtime_profile() -> RiggingRuntimeProfile with Pure:
    let profile = RiggingRuntimeProfile()

    profile.skeleton_runtime = SkeletonDescriptor()
    profile.skeleton_runtime.skeleton_id = "universal_skeleton_runtime"
    profile.skeleton_runtime.skeleton_scope = "character_creature_prop_machine_and_stage_rig_hierarchies"
    profile.skeleton_runtime.binding_policy = "scene_safe_authoring_with_pose_and_delivery_visibility"

    profile.control_rig_runtime = ControlRigDescriptor()
    profile.control_rig_runtime.control_rig_id = "control_rig_runtime"
    profile.control_rig_runtime.solve_policy = "pose_driver_constraint_widget_and_retarget_aware"
    profile.control_rig_runtime.tensor_pipeline_id = "rigging_control_tensor_pipeline"

    profile.skin_binding_runtime = SkinBindingDescriptor()
    profile.skin_binding_runtime.skin_binding_id = "skin_binding_runtime"
    profile.skin_binding_runtime.binding_kind = "weights_correctives_dual_quaternion_and_groom_attach"
    profile.skin_binding_runtime.validation_policy = "paint_deform_export_and_runtime_bundle_safe"
    profile
