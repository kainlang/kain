// Sequencing, cinematic timeline, editorial conform, and shot-assembly contracts.

struct SequenceDescriptor:
    sequence_id: String
    sequence_kind: String
    timeline_policy: String

struct ShotDescriptor:
    shot_id: String
    shot_scope: String
    playback_policy: String

struct EditorialDescriptor:
    editorial_id: String
    conform_policy: String
    review_policy: String

struct SequencingRuntimeProfile:
    master_sequence: SequenceDescriptor
    shot_clip: ShotDescriptor
    editorial_conform: EditorialDescriptor

fn default_sequencing_runtime_profile() -> SequencingRuntimeProfile with Pure:
    let profile = SequencingRuntimeProfile()

    profile.master_sequence = SequenceDescriptor()
    profile.master_sequence.sequence_id = "master_sequence"
    profile.master_sequence.sequence_kind = "shot_take_and_runtime_stage_sequence"
    profile.master_sequence.timeline_policy = "editorial_and_runtime_linked"

    profile.shot_clip = ShotDescriptor()
    profile.shot_clip.shot_id = "active_shot_clip"
    profile.shot_clip.shot_scope = "camera_animation_audio_and_stage_events"
    profile.shot_clip.playback_policy = "realtime_preview_or_conform_locked"

    profile.editorial_conform = EditorialDescriptor()
    profile.editorial_conform.editorial_id = "editorial_conform"
    profile.editorial_conform.conform_policy = "timeline_receipt_and_review_bound"
    profile.editorial_conform.review_policy = "shot_context_and_take_approval_gated"
    profile
