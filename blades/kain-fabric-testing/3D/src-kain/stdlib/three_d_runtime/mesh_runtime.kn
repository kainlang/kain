// Mesh/topology contracts for authoring, remeshing, LOD generation, UV policy, and runtime-safe geometry mutation.

struct MeshTopologyDescriptor:
    topology_id: String
    topology_scope: String
    mutation_policy: String

struct MeshOptimizationDescriptor:
    optimization_id: String
    optimization_kind: String
    lod_policy: String

struct MeshSurfaceDescriptor:
    surface_id: String
    surface_scope: String
    uv_policy: String

struct MeshRuntimeProfile:
    topology_runtime: MeshTopologyDescriptor
    optimization_runtime: MeshOptimizationDescriptor
    surface_runtime: MeshSurfaceDescriptor

fn default_mesh_runtime_profile() -> MeshRuntimeProfile with Pure:
    let profile = MeshRuntimeProfile()

    profile.topology_runtime = MeshTopologyDescriptor()
    profile.topology_runtime.topology_id = "universal_mesh_topology_runtime"
    profile.topology_runtime.topology_scope = "poly_subd_voxel_retopo_and_runtime_mutation_meshes"
    profile.topology_runtime.mutation_policy = "transactional_checkpoint_bound_and_scene_safe"

    profile.optimization_runtime = MeshOptimizationDescriptor()
    profile.optimization_runtime.optimization_id = "mesh_optimization_runtime"
    profile.optimization_runtime.optimization_kind = "lod_decimation_remesh_reprojection_and_validation"
    profile.optimization_runtime.lod_policy = "interactive_preview_baked_and_delivery_aligned"

    profile.surface_runtime = MeshSurfaceDescriptor()
    profile.surface_runtime.surface_id = "mesh_surface_runtime"
    profile.surface_runtime.surface_scope = "normals_tangents_uvs_vertex_colors_and_attribute_layers"
    profile.surface_runtime.uv_policy = "material_bake_exchange_and_runtime_bundle_safe"
    profile
