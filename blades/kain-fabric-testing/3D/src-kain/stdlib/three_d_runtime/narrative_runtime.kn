// Narrative, dialogue, branching-state, and quest-safe runtime contracts for game and previz applications.

struct NarrativeGraphDescriptor:
    graph_id: String
    graph_scope: String
    branching_policy: String

struct DialogueRuntimeDescriptor:
    dialogue_id: String
    dialogue_kind: String
    localization_policy: String

struct QuestStateDescriptor:
    quest_id: String
    quest_scope: String
    transition_policy: String

struct NarrativeRuntimeProfile:
    graph_runtime: NarrativeGraphDescriptor
    dialogue_runtime: DialogueRuntimeDescriptor
    quest_runtime: QuestStateDescriptor

fn default_narrative_runtime_profile() -> NarrativeRuntimeProfile with Pure:
    let profile = NarrativeRuntimeProfile()

    profile.graph_runtime = NarrativeGraphDescriptor()
    profile.graph_runtime.graph_id = "narrative_state_graph_runtime"
    profile.graph_runtime.graph_scope = "story_branching_mission_logic_previz_and_runtime_authoring"
    profile.graph_runtime.branching_policy = "replay_safe_save_safe_and_operator_visible"

    profile.dialogue_runtime = DialogueRuntimeDescriptor()
    profile.dialogue_runtime.dialogue_id = "dialogue_runtime"
    profile.dialogue_runtime.dialogue_kind = "voiced_text_branching_prompt_and_cinematic_dialogue"
    profile.dialogue_runtime.localization_policy = "subtitle_audio_and_region_bundle_aligned"

    profile.quest_runtime = QuestStateDescriptor()
    profile.quest_runtime.quest_id = "quest_state_runtime"
    profile.quest_runtime.quest_scope = "objective_gate_task_sequence_and_world_state_authoring"
    profile.quest_runtime.transition_policy = "event_driven_checkpointed_and_network_ready"
    profile
