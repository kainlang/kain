// Fleet contracts for worker/device pools, capacity planning, leases, and cross-domain dispatch.

struct FleetCapacityDescriptor:
    capacity_id: String
    capacity_scope: String
    balancing_policy: String

struct FleetLeaseDescriptor:
    lease_id: String
    lease_scope: String
    isolation_policy: String

struct FleetDispatchDescriptor:
    dispatch_id: String
    dispatch_scope: String
    failover_policy: String

struct FleetRuntimeProfile:
    fleet_capacity: FleetCapacityDescriptor
    fleet_lease: FleetLeaseDescriptor
    fleet_dispatch: FleetDispatchDescriptor

fn default_fleet_runtime_profile() -> FleetRuntimeProfile with Pure:
    let profile = FleetRuntimeProfile()

    profile.fleet_capacity = FleetCapacityDescriptor()
    profile.fleet_capacity.capacity_id = "fleet_capacity_runtime"
    profile.fleet_capacity.capacity_scope = "render_bake_sim_ai_streaming_review_and_delivery_worker_pools"
    profile.fleet_capacity.balancing_policy = "deadline_cost_device_and_capability_aware"

    profile.fleet_lease = FleetLeaseDescriptor()
    profile.fleet_lease.lease_id = "fleet_lease_runtime"
    profile.fleet_lease.lease_scope = "gpu_machine_sensor_stage_and_cloud_worker_leases"
    profile.fleet_lease.isolation_policy = "tenant_project_authority_and_trust_zone_safe"

    profile.fleet_dispatch = FleetDispatchDescriptor()
    profile.fleet_dispatch.dispatch_id = "fleet_dispatch_runtime"
    profile.fleet_dispatch.dispatch_scope = "job_assignment_retry_failover_and_delivery_receipt_routing"
    profile.fleet_dispatch.failover_policy = "multi_pool_resumable_and_audit_visible"
    profile
