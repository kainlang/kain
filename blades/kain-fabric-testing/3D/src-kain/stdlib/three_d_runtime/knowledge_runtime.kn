// Project knowledge, operations memory, and searchable runtime context contracts for large 3D productions.

struct KnowledgeCatalogDescriptor:
    catalog_id: String
    catalog_kind: String
    indexing_policy: String

struct OperationalRecordDescriptor:
    record_id: String
    record_family: String
    retention_policy: String

struct KnowledgeQueryDescriptor:
    query_id: String
    query_scope: String
    response_policy: String

struct KnowledgeRuntimeProfile:
    production_catalog: KnowledgeCatalogDescriptor
    asset_catalog: KnowledgeCatalogDescriptor
    operational_record: OperationalRecordDescriptor
    knowledge_query: KnowledgeQueryDescriptor

fn default_knowledge_runtime_profile() -> KnowledgeRuntimeProfile with Pure:
    let profile = KnowledgeRuntimeProfile()

    profile.production_catalog = KnowledgeCatalogDescriptor()
    profile.production_catalog.catalog_id = "production_knowledge_catalog"
    profile.production_catalog.catalog_kind = "scene_review_delivery_and_operator_context"
    profile.production_catalog.indexing_policy = "manifest_scene_and_receipt_aware"

    profile.asset_catalog = KnowledgeCatalogDescriptor()
    profile.asset_catalog.catalog_id = "asset_knowledge_catalog"
    profile.asset_catalog.catalog_kind = "asset_lineage_exchange_and_runtime_usage"
    profile.asset_catalog.indexing_policy = "registry_and_provenance_bound"

    profile.operational_record = OperationalRecordDescriptor()
    profile.operational_record.record_id = "operational_memory_record"
    profile.operational_record.record_family = "automation_review_delivery_and_workspace_events"
    profile.operational_record.retention_policy = "project_policy_and_release_scoped"

    profile.knowledge_query = KnowledgeQueryDescriptor()
    profile.knowledge_query.query_id = "knowledge_ops_query"
    profile.knowledge_query.query_scope = "production_asset_runtime_and_delivery_context"
    profile.knowledge_query.response_policy = "searchable_graph_and_summary_bundle"
    profile
