// Scene bundle authoring contracts for reusable runtime/editor scene packages and launchable bundle presets.

struct SceneBundleDescriptor:
    bundle_id: String
    bundle_kind: String
    composition_policy: String
    activation_policy: String

struct SceneBundleLayerDescriptor:
    layer_id: String
    layer_role: String
    source_policy: String

struct SceneBundlePresetDescriptor:
    preset_id: String
    target_app: String
    delivery_policy: String

struct SceneBundleRuntimeProfile:
    authoring_bundle: SceneBundleDescriptor
    runtime_bundle: SceneBundleDescriptor
    layer_stack: SceneBundleLayerDescriptor
    launch_preset: SceneBundlePresetDescriptor

fn default_scene_bundle_runtime_profile() -> SceneBundleRuntimeProfile with Pure:
    let profile = SceneBundleRuntimeProfile()

    profile.authoring_bundle = SceneBundleDescriptor()
    profile.authoring_bundle.bundle_id = "authoring_scene_bundle"
    profile.authoring_bundle.bundle_kind = "dcc_or_editor_scene_bundle"
    profile.authoring_bundle.composition_policy = "manifest_and_scene_authored"
    profile.authoring_bundle.activation_policy = "workspace_selected"

    profile.runtime_bundle = SceneBundleDescriptor()
    profile.runtime_bundle.bundle_id = "runtime_scene_bundle"
    profile.runtime_bundle.bundle_kind = "playable_or_headless_scene_bundle"
    profile.runtime_bundle.composition_policy = "delivery_graph_materialized"
    profile.runtime_bundle.activation_policy = "launch_profile_selected"

    profile.layer_stack = SceneBundleLayerDescriptor()
    profile.layer_stack.layer_id = "scene_bundle_layer_stack"
    profile.layer_stack.layer_role = "collections_variants_lighting_simulation_and_review"
    profile.layer_stack.source_policy = "composed_from_registered_scene_domains"

    profile.launch_preset = SceneBundlePresetDescriptor()
    profile.launch_preset.preset_id = "scene_bundle_launch_preset"
    profile.launch_preset.target_app = "scene_bundle_studio"
    profile.launch_preset.delivery_policy = "bundle_registry_and_delivery_channel_gated"
    profile
