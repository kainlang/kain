// Deformer stacks, morph layers, wrap cages, lattices, and pose-space correction contracts.

struct DeformerStackDescriptor:
    stack_id: String
    stack_scope: String
    ordering_policy: String

struct CorrectiveLayerDescriptor:
    layer_id: String
    layer_kind: String
    activation_policy: String

struct EnvelopeDescriptor:
    envelope_id: String
    envelope_kind: String
    cache_policy: String

struct DeformationRuntimeProfile:
    deformer_stack_runtime: DeformerStackDescriptor
    corrective_layer_runtime: CorrectiveLayerDescriptor
    envelope_runtime: EnvelopeDescriptor

fn default_deformation_runtime_profile() -> DeformationRuntimeProfile with Pure:
    let profile = DeformationRuntimeProfile()

    profile.deformer_stack_runtime = DeformerStackDescriptor()
    profile.deformer_stack_runtime.stack_id = "deformer_stack_runtime"
    profile.deformer_stack_runtime.stack_scope = "skin_wrap_lattice_morph_curve_space_and_pose_space_deformation"
    profile.deformer_stack_runtime.ordering_policy = "deterministic_transactional_and_checkpoint_safe"

    profile.corrective_layer_runtime = CorrectiveLayerDescriptor()
    profile.corrective_layer_runtime.layer_id = "corrective_layer_runtime"
    profile.corrective_layer_runtime.layer_kind = "pose_space_tension_collision_and_artist_authored_correctives"
    profile.corrective_layer_runtime.activation_policy = "rig_state_scene_semantics_and_runtime_mode_bound"

    profile.envelope_runtime = EnvelopeDescriptor()
    profile.envelope_runtime.envelope_id = "deformation_envelope_runtime"
    profile.envelope_runtime.envelope_kind = "falloff_cage_mask_and_region_weight_management"
    profile.envelope_runtime.cache_policy = "preview_interactive_and_delivery_receipt_visible"
    profile
