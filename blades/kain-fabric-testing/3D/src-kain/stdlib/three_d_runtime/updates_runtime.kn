// Update and patch-delivery contracts for runtime/editor/tool bundles without requiring host-toolchain management.

struct UpdateChannelDescriptor:
    channel_id: String
    channel_scope: String
    approval_policy: String

struct PatchBundleDescriptor:
    patch_id: String
    patch_kind: String
    rollback_policy: String

struct InstallRouteDescriptor:
    install_id: String
    install_scope: String
    migration_policy: String

struct UpdatesRuntimeProfile:
    channel_runtime: UpdateChannelDescriptor
    patch_runtime: PatchBundleDescriptor
    install_runtime: InstallRouteDescriptor

fn default_updates_runtime_profile() -> UpdatesRuntimeProfile with Pure:
    let profile = UpdatesRuntimeProfile()

    profile.channel_runtime = UpdateChannelDescriptor()
    profile.channel_runtime.channel_id = "update_channel_runtime"
    profile.channel_runtime.channel_scope = "workspace_partner_public_and_private_release_channels"
    profile.channel_runtime.approval_policy = "manifest_gated_operator_aware_and_receipt_visible"

    profile.patch_runtime = PatchBundleDescriptor()
    profile.patch_runtime.patch_id = "patch_bundle_runtime"
    profile.patch_runtime.patch_kind = "tool_content_runtime_schema_and_feature_pack_updates"
    profile.patch_runtime.rollback_policy = "versioned_differential_and_state_migration_safe"

    profile.install_runtime = InstallRouteDescriptor()
    profile.install_runtime.install_id = "install_route_runtime"
    profile.install_runtime.install_scope = "local_cloud_remote_stream_and_bundle_registry_installs"
    profile.install_runtime.migration_policy = "compatibility_checked_resume_safe_and_audit_bound"
    profile
