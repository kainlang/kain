// Artifact materialization, receipts, and generated-output control contracts.

struct MaterializationPlanDescriptor:
    plan_id: String
    plan_scope: String
    tensor_pipeline_id: String
    orchestration_policy: String

struct MaterializationReceiptDescriptor:
    receipt_id: String
    receipt_kind: String
    retention_policy: String

struct GeneratedOutputDescriptor:
    output_id: String
    output_root: String
    promotion_policy: String

struct MaterializationRuntimeProfile:
    artifact_plan: MaterializationPlanDescriptor
    promotion_plan: MaterializationPlanDescriptor
    materialization_receipt: MaterializationReceiptDescriptor
    generated_output: GeneratedOutputDescriptor

fn default_materialization_runtime_profile() -> MaterializationRuntimeProfile with Pure:
    let profile = MaterializationRuntimeProfile()

    profile.artifact_plan = MaterializationPlanDescriptor()
    profile.artifact_plan.plan_id = "artifact_materialization_plan"
    profile.artifact_plan.plan_scope = "runtime_kernel_and_distribution_outputs"
    profile.artifact_plan.tensor_pipeline_id = "materialization_receipt_tensor_pipeline"
    profile.artifact_plan.orchestration_policy = "manifest_driven"

    profile.promotion_plan = MaterializationPlanDescriptor()
    profile.promotion_plan.plan_id = "artifact_promotion_plan"
    profile.promotion_plan.plan_scope = "review_and_release_promotion"
    profile.promotion_plan.tensor_pipeline_id = "materialization_receipt_tensor_pipeline"
    profile.promotion_plan.orchestration_policy = "approval_gated"

    profile.materialization_receipt = MaterializationReceiptDescriptor()
    profile.materialization_receipt.receipt_id = "artifact_materialization_receipt"
    profile.materialization_receipt.receipt_kind = "generated_output_provenance"
    profile.materialization_receipt.retention_policy = "incremental_and_promoted_snapshots"

    profile.generated_output = GeneratedOutputDescriptor()
    profile.generated_output.output_id = "materialized_output_root"
    profile.generated_output.output_root = "generated/materialized"
    profile.generated_output.promotion_policy = "receipt_verified"
    profile
