// Brush libraries, alpha/tip presets, stroke engines, and tablet-aware interaction contracts.

struct BrushLibraryDescriptor:
    library_id: String
    library_scope: String
    preset_policy: String

struct BrushEngineDescriptor:
    engine_id: String
    stroke_policy: String
    tensor_pipeline_id: String

struct TabletInputDescriptor:
    input_id: String
    input_scope: String
    routing_policy: String

struct BrushRuntimeProfile:
    library_runtime: BrushLibraryDescriptor
    engine_runtime: BrushEngineDescriptor
    tablet_input_runtime: TabletInputDescriptor

fn default_brush_runtime_profile() -> BrushRuntimeProfile with Pure:
    let profile = BrushRuntimeProfile()

    profile.library_runtime = BrushLibraryDescriptor()
    profile.library_runtime.library_id = "brush_library_runtime"
    profile.library_runtime.library_scope = "sculpt_paint_mask_polish_trim_pose_and_gizmo_assist_brushes"
    profile.library_runtime.preset_policy = "versioned_workspace_shareable_and_mod_safe"

    profile.engine_runtime = BrushEngineDescriptor()
    profile.engine_runtime.engine_id = "brush_engine_runtime"
    profile.engine_runtime.stroke_policy = "dab_spacing_lazy_mouse_symmetry_projection_and_surface_follow"
    profile.engine_runtime.tensor_pipeline_id = "brush_engine_tensor_pipeline"

    profile.tablet_input_runtime = TabletInputDescriptor()
    profile.tablet_input_runtime.input_id = "tablet_input_runtime"
    profile.tablet_input_runtime.input_scope = "pressure_tilt_rotation_velocity_and_multi_device_stylus_profiles"
    profile.tablet_input_runtime.routing_policy = "interaction_runtime_viewport_focus_and_tool_context_bound"
    profile
