// Scan ingest, reconstruction, calibration, and texture reprojection contracts.

struct CaptureSessionDescriptor:
    session_id: String
    source_kind: String
    calibration_policy: String
    tensor_pipeline_id: String

struct ReconstructionDescriptor:
    reconstruction_id: String
    reconstruction_kind: String
    mesh_policy: String
    texture_policy: String

struct PhotogrammetryRuntimeProfile:
    image_capture: CaptureSessionDescriptor
    lidar_capture: CaptureSessionDescriptor
    reconstruction: ReconstructionDescriptor

fn default_capture_session(session_id: String, source_kind: String) -> CaptureSessionDescriptor with Pure:
    let descriptor = CaptureSessionDescriptor()
    descriptor.session_id = session_id
    descriptor.source_kind = source_kind
    descriptor.calibration_policy = "bundle_adjust_and_validate"
    descriptor.tensor_pipeline_id = "photogrammetry_reconstruction_tensor_pipeline"
    descriptor

fn default_photogrammetry_runtime_profile() -> PhotogrammetryRuntimeProfile with Pure:
    let profile = PhotogrammetryRuntimeProfile()
    profile.image_capture = default_capture_session("image_capture", "multi_view_images")
    profile.lidar_capture = default_capture_session("lidar_capture", "depth_or_point_cloud")

    profile.reconstruction = ReconstructionDescriptor()
    profile.reconstruction.reconstruction_id = "scan_reconstruction"
    profile.reconstruction.reconstruction_kind = "mesh_and_texture"
    profile.reconstruction.mesh_policy = "dense_then_retopo_ready"
    profile.reconstruction.texture_policy = "atlas_and_projection"
    profile
