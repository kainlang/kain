// Material and shader graph contracts for 3D authoring suites and runtime engines.

struct MaterialGraphDescriptor:
    graph_id: String
    shading_model: String
    evaluation_pipeline_id: String
    preview_surface_id: String

struct TextureStackDescriptor:
    stack_id: String
    color_space: String
    compression_policy: String
    residency: String

struct MaterialRuntimeProfile:
    surface_graph: MaterialGraphDescriptor
    decal_graph: MaterialGraphDescriptor
    texture_stack: TextureStackDescriptor

fn default_material_graph(graph_id: String, shading_model: String) -> MaterialGraphDescriptor with Pure:
    let graph = MaterialGraphDescriptor()
    graph.graph_id = graph_id
    graph.shading_model = shading_model
    graph.evaluation_pipeline_id = "renderer_frame_tensor_pipeline"
    graph.preview_surface_id = "material_graph"
    graph

fn default_material_runtime_profile() -> MaterialRuntimeProfile with Pure:
    let profile = MaterialRuntimeProfile()
    profile.surface_graph = default_material_graph("surface_graph", "pbr_layered")
    profile.decal_graph = default_material_graph("decal_graph", "decal_blend")

    profile.texture_stack = TextureStackDescriptor()
    profile.texture_stack.stack_id = "default_texture_stack"
    profile.texture_stack.color_space = "linear_plus_srgb"
    profile.texture_stack.compression_policy = "streaming_ready"
    profile.texture_stack.residency = "gpu_preferred"
    profile
