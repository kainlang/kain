// Native widget and tool-surface authoring contracts for Kain UI-driven 3D desktop applications.

struct NativeWidgetDescriptor:
    widget_id: String
    widget_kind: String
    layout_policy: String
    binding_policy: String

struct ToolOverlayDescriptor:
    overlay_id: String
    overlay_kind: String
    viewport_binding: String

struct WorkspacePresetDescriptor:
    preset_id: String
    persistence_policy: String
    command_routing_policy: String

struct WidgetRuntimeProfile:
    dock_widget: NativeWidgetDescriptor
    property_widget: NativeWidgetDescriptor
    tool_overlay: ToolOverlayDescriptor
    workspace_preset: WorkspacePresetDescriptor

fn default_widget_runtime_profile() -> WidgetRuntimeProfile with Pure:
    let profile = WidgetRuntimeProfile()

    profile.dock_widget = NativeWidgetDescriptor()
    profile.dock_widget.widget_id = "native_dock_widget"
    profile.dock_widget.widget_kind = "dockable_editor_surface"
    profile.dock_widget.layout_policy = "persistent_and_workspace_switchable"
    profile.dock_widget.binding_policy = "manifest_and_runtime_contract_bound"

    profile.property_widget = NativeWidgetDescriptor()
    profile.property_widget.widget_id = "property_sheet_widget"
    profile.property_widget.widget_kind = "inspector_and_graph_companion"
    profile.property_widget.layout_policy = "selection_and_context_sensitive"
    profile.property_widget.binding_policy = "schema_reflection_and_command_bound"

    profile.tool_overlay = ToolOverlayDescriptor()
    profile.tool_overlay.overlay_id = "viewport_tool_overlay"
    profile.tool_overlay.overlay_kind = "gizmo_selection_brush_and_measure"
    profile.tool_overlay.viewport_binding = "primary_scene_viewport"

    profile.workspace_preset = WorkspacePresetDescriptor()
    profile.workspace_preset.preset_id = "native_widget_workspace_preset"
    profile.workspace_preset.persistence_policy = "per_workspace_and_per_role"
    profile.workspace_preset.command_routing_policy = "tool_context_and_modal_stack_bound"
    profile
