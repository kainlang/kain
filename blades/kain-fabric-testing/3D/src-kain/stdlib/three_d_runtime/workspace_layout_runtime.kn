// Multi-window workspace layout, dock graph, and authored tool-surface contracts for Kain UI.

struct WorkspaceLayoutDescriptor:
    layout_id: String
    layout_kind: String
    persistence_policy: String

struct DockGraphDescriptor:
    dock_graph_id: String
    composition_policy: String
    routing_policy: String

struct WindowSurfaceDescriptor:
    surface_id: String
    window_kind: String
    focus_policy: String

struct WorkspacePresetRoutingDescriptor:
    registry_id: String
    manifest_source: String
    layout_binding_policy: String

struct WorkspaceLayoutRuntimeProfile:
    workspace_layout: WorkspaceLayoutDescriptor
    dock_graph: DockGraphDescriptor
    window_surface: WindowSurfaceDescriptor
    preset_routing: WorkspacePresetRoutingDescriptor

fn default_workspace_layout_runtime_profile() -> WorkspaceLayoutRuntimeProfile with Pure:
    let profile = WorkspaceLayoutRuntimeProfile()

    profile.workspace_layout = WorkspaceLayoutDescriptor()
    profile.workspace_layout.layout_id = "universal_workspace_layout"
    profile.workspace_layout.layout_kind = "multi_window_dock_and_overlay_layout"
    profile.workspace_layout.persistence_policy = "per_user_per_role_and_per_project"

    profile.dock_graph = DockGraphDescriptor()
    profile.dock_graph.dock_graph_id = "workspace_dock_graph"
    profile.dock_graph.composition_policy = "widget_schema_and_runtime_contract_bound"
    profile.dock_graph.routing_policy = "command_context_and_focus_aware"

    profile.window_surface = WindowSurfaceDescriptor()
    profile.window_surface.surface_id = "workspace_window_surface"
    profile.window_surface.window_kind = "main_viewport_tool_overlay_and_auxiliary_editor"
    profile.window_surface.focus_policy = "viewport_modal_and_drag_drop_safe"

    profile.preset_routing = WorkspacePresetRoutingDescriptor()
    profile.preset_routing.registry_id = "workspace_preset_registry"
    profile.preset_routing.manifest_source = "manifests/workspace_presets.json"
    profile.preset_routing.layout_binding_policy = "workspace_preset_bound_favorites_and_role_aware_window_routes"
    profile
