// Metrology, inspection, and deviation-analysis contracts for manufacturing and review-adjacent work.

struct InspectionProbeDescriptor:
    probe_id: String
    probe_kind: String
    tensor_pipeline_id: String
    sampling_policy: String

struct DeviationFieldDescriptor:
    field_id: String
    reference_policy: String
    reporting_policy: String

struct ToleranceGateDescriptor:
    gate_id: String
    tolerance_profile: String
    escalation_policy: String

struct MetrologyRuntimeProfile:
    surface_probe: InspectionProbeDescriptor
    assembly_probe: InspectionProbeDescriptor
    deviation_field: DeviationFieldDescriptor
    tolerance_gate: ToleranceGateDescriptor

fn default_inspection_probe(probe_id: String, probe_kind: String, sampling_policy: String) -> InspectionProbeDescriptor with Pure:
    let descriptor = InspectionProbeDescriptor()
    descriptor.probe_id = probe_id
    descriptor.probe_kind = probe_kind
    descriptor.tensor_pipeline_id = "metrology_inspection_tensor_pipeline"
    descriptor.sampling_policy = sampling_policy
    descriptor

fn default_metrology_runtime_profile() -> MetrologyRuntimeProfile with Pure:
    let profile = MetrologyRuntimeProfile()
    profile.surface_probe = default_inspection_probe("surface_probe", "surface_deviation_probe", "dense_surface_sampling")
    profile.assembly_probe = default_inspection_probe("assembly_probe", "assembly_clearance_probe", "critical_feature_sampling")

    profile.deviation_field = DeviationFieldDescriptor()
    profile.deviation_field.field_id = "deviation_field"
    profile.deviation_field.reference_policy = "cad_or_scan_reference"
    profile.deviation_field.reporting_policy = "heatmap_and_report_bundle"

    profile.tolerance_gate = ToleranceGateDescriptor()
    profile.tolerance_gate.gate_id = "inspection_tolerance_gate"
    profile.tolerance_gate.tolerance_profile = "product_and_process_specific"
    profile.tolerance_gate.escalation_policy = "review_database_and_fabrication_hold"
    profile
