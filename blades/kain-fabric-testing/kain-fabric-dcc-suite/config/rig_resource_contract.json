{
  "schema_version": 1,
  "rig_documents": [
    {
      "id": "rig_control_state_document",
      "resource_uri": "rig://control/current",
      "owner": "app",
      "kind": "value",
      "source": "rig_sync_projection",
      "summary": "Canonical rig control state document for control targets, pose goals, and deformation readiness."
    },
    {
      "id": "rig_deformation_output_document",
      "resource_uri": "rig://deformation/output/current",
      "owner": "app",
      "kind": "value",
      "source": "rig_sync_projection",
      "summary": "Durable rig deformation output document for solved transforms and downstream consumers."
    },
    {
      "id": "rig_solver_bridge_document",
      "resource_uri": "rig://solver/bridge/current",
      "owner": "app",
      "kind": "value",
      "source": "rig_sync_projection",
      "summary": "Extension seam document that records the native Rust/C++ solver adapter expected to own IK and bone evaluation."
    }
  ],
  "semantic_rules": {
    "stable_ids": true,
    "session_owned_truth": true,
    "native_solver_is_external": true,
    "control_and_deformation_round_trip": false
  }
}
