fn app_state_root() -> String:
    return "apps/kain-fabric-dcc-suite/state"

fn interchange_transcode_report_path() -> String:
    return app_state_root() + "/interchange_transcode_report.json"

fn build_interchange_transcode_report_json(settings: Any, source_id: String, source_uri: String, transcode_profile_id: String, interchange_id: String, media_route_id: String) -> String:
    let json = "{\n"
    let json = json + "  \"kind\": \"interchange_transcode_report\",\n"
    let json = json + "  \"project\": \"" + settings.project_name + "\",\n"
    let json = json + "  \"workspace_mode\": \"" + settings.workspace_mode + "\",\n"
    let json = json + "  \"source_id\": \"" + source_id + "\",\n"
    let json = json + "  \"source_uri\": \"" + source_uri + "\",\n"
    let json = json + "  \"transcode_profile_id\": \"" + transcode_profile_id + "\",\n"
    let json = json + "  \"interchange_id\": \"" + interchange_id + "\",\n"
    let json = json + "  \"media_route_id\": \"" + media_route_id + "\",\n"
    let json = json + "  \"delivery_policy\": \"manifest_driven_quality_gated_and_receipt_safe\"\n"
    let json = json + "}\n"
    return json

fn main() -> String:
    let settings = fabric_inputs.python_suite_bootstrap.project_settings
    let source_id = fabric_inputs.asset_ingest_session.source_id
    let source_uri = fabric_inputs.asset_ingest_session.source_uri
    let transcode_profile_id = fabric_inputs.asset_ingest_session.transcode_profile_id
    let interchange_id = fabric_inputs.interchange_runtime_projection.interchange_id
    let media_route_id = fabric_inputs.media_runtime_projection.media_route_id
    let report_json = build_interchange_transcode_report_json(settings, source_id, source_uri, transcode_profile_id, interchange_id, media_route_id)

    write_file(interchange_transcode_report_path(), report_json)

    return "interchange-transcode:" + transcode_profile_id + ":" + media_route_id
