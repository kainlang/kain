shader compute DccSuitePathTracePreviewLighting(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("dcc_suite_pathtrace_preview_lighting", "pathtrace_preview_lighting", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let source_value = src[index]
    let bounce_light = (source_value * 0.68) + 0.22
    let caustic_hint = (source_value * 0.31) + 0.11
    let filmic = bounce_light + caustic_hint
    dst[index] = filmic
    return vec4(filmic, bounce_light, caustic_hint, source_value)
