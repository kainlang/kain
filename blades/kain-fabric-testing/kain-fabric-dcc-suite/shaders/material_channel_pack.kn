shader compute DccSuiteMaterialChannelPack(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("dcc_suite_material_channel_pack", "material_channel_pack", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let source_value = src[index]
    let base_color_like = source_value * 0.52
    let roughness_like = (source_value * 0.21) + 0.18
    let metallic_like = (source_value * 0.17) + 0.10
    let packed_value = base_color_like + roughness_like + metallic_like
    dst[index] = packed_value
    return vec4(base_color_like, roughness_like, metallic_like, packed_value)
