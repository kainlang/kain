shader compute DccSuiteRenderPreviewLighting(id: UVec3) -> Vec4:
    uniform src: StorageBuffer<Float> @0
    uniform dst: StorageBuffer<Float> @1
    uniform LOCAL_SIZE_X: UInt @100
    uniform LOCAL_SIZE_Y: UInt @101
    uniform LOCAL_SIZE_Z: UInt @102

    comptime:
        let compute = (
            [8, 1, 1],
            [
                ("src", "f32", ["dispatch.x"], "input", "kain.shared.buffer"),
                ("dst", "f32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [
                ("dcc_suite_render_preview_lighting", "render_preview_lighting", ["src"], ["dst"], false),
            ],
        )

    let index = id.x
    let source_value = src[index]
    let direct_light = (source_value * 0.48) + 0.14
    let indirect_light = (source_value * 0.24) + 0.09
    let specular_hint = (source_value * 0.16) + 0.05
    let render_value = direct_light + indirect_light + specular_hint
    dst[index] = render_value
    return vec4(render_value, direct_light, indirect_light, specular_hint)
