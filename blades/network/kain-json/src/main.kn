use kain_fmt::fmt_join_strings
use kain_json::json_message_object
use kain_json::json_parse_text
use kain_json::json_to_text

fn main() -> Int:
    let parsed = json_parse_text("{\"blade\":\"kain-json\",\"ready\":true}")
    let summary = fmt_join_strings(["kain-json", "ready"], " ")
    let payload = json_message_object(summary)
    json_object_set(payload, "parsed", parsed)
    println(json_to_text(payload))
    return 0
