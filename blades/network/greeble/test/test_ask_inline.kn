use std::runtime

actor InlineActor:
    state hits: Int = 0

    on Echo(reply_to: P, val: Int):
        self.hits = self.hits + 1
        send reply_to.Reply(value = val * 2)

pub fn run_tests() -> Int:
    let init = runtime_init()
    if init != 0:
        println("runtime_init failed")
        return 1

    let echo = spawn InlineActor(hits = 0)
    let reply = ask(echo, "Echo", 21)
    if reply != 42:
        println("FAIL: expected 42 got " + str(reply))
        return 2

    println("PASS: inline ask works: " + str(reply))
    let shutdown = runtime_shutdown()
    return 0
