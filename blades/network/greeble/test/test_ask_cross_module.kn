use std::runtime
use std::actor
use gateway

pub fn run_tests() -> Int:
    let init = runtime_init()
    if init != 0:
        println("runtime_init failed")
        return 1

    let limiter = spawn_rate_limiter(10)
    let id: Int = limiter as Int
    println("limiter ID: " + str(id))

    let result = ask(limiter, "Check", "test")
    println("result: " + str(result))

    let shutdown = runtime_shutdown()
    return 0
