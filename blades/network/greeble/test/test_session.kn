// ============================================================================
//  test_session.kn — Session Actor Unit Tests
//
//  Ladder: Layer 0 — Plain Code (test functions)
//  Exercises the SessionActor from session.kn with pool delegation.
//
//  SessionActor tests:
//    test_session_spawn                     — spawn session, verify actor exists
//    test_session_request_delegates_to_pool — session delegates request to pool
// ============================================================================

use std::runtime
use std::actor
use types
use worker
use session

// ============================================================================
//  ASSERTION HELPERS
// ============================================================================

fn assert_eq(actual: Int, expected: Int, msg: String) -> Int:
    if actual != expected:
        println("  [FAIL] " + msg + ": expected " + str(expected) + " got " + str(actual))
        return 1
    println("  [PASS] " + msg)
    return 0

fn assert_true(condition: Bool, msg: String) -> Int:
    if condition:
        println("  [PASS] " + msg)
        return 0
    println("  [FAIL] " + msg)
    return 1

fn assert_false(condition: Bool, msg: String) -> Int:
    return assert_true(condition == false, msg)

// ============================================================================
//  SESSION ACTOR TESTS
// ============================================================================

//  Test: Spawn SessionActor, verify actor is valid
fn test_session_spawn() -> Int:
    println("\n--- Test: SessionActor spawn ---")
    let session = spawn_session(42)

    let id: Int = session as Int
    if id <= 0:
        println("  [FAIL] session ID is non-positive: " + str(id))
        return 1

    // Verify actor ID is valid via runtime
    let valid: Bool = actor_id_is_valid(id)
    if valid == false:
        println("  [FAIL] session ID " + str(id) + " is not valid")
        return 2

    // Send Close (fire-and-forget) — verifies handler processes without crash
    send session.Close()

    println("  [PASS] SessionActor spawned ID=" + str(id) + " valid=" + str(valid))
    return 0

//  Test: Session delegates a request to a worker pool via Request handler
//  Note: SessionActor.Request expects (body: String, worker_pool: WorkerPoolSupervisor).
//  We pass the pool as part of the ask payload.
fn test_session_request_delegates_to_pool() -> Int:
    println("\n--- Test: SessionActor request delegates to pool ---")
    let session = spawn_session(99)
    let pool = spawn_worker_pool(2, 64)

    // Verify pool is alive
    let pool_id: Int = pool as Int
    if pool_id <= 0:
        println("  [FAIL] pool ID is non-positive: " + str(pool_id))
        return 3

    // Verify session is alive
    let session_id: Int = session as Int
    if session_id <= 0:
        println("  [FAIL] session ID is non-positive: " + str(session_id))
        return 4

    // Ask session to process a request by delegating to the pool
    // The Request handler forwards body to the worker pool via ask
    let result = ask(session, "Request", "test_body", pool)
    if result < 0:
        println("  [FAIL] session.Request returned negative: " + str(result))
        return 5

    let request_processed = unpack_first(result)
    let request_checksum = unpack_second(result)

    if request_processed != 1:
        println("  [FAIL] session.Request processed expected 1, got " + str(request_processed))
        return 6
    if request_checksum <= 0:
        println("  [FAIL] session.Request checksum expected > 0, got " + str(request_checksum))
        return 7

    // Verify pool stats reflect the delegated work
    let pool_stats = ask(pool, "GetPoolStats", 0)
    let pool_processed = unpack_first(pool_stats)
    let pool_checksum = unpack_second(pool_stats)

    if pool_processed < 1:
        println("  [FAIL] pool total_processed expected >= 1, got " + str(pool_processed))
        return 8
    if pool_checksum <= 0:
        println("  [FAIL] pool total_checksum expected > 0, got " + str(pool_checksum))
        return 9

    println("  [PASS] Session delegated to pool:"
        + " request_processed=" + str(request_processed)
        + " pool_processed=" + str(pool_processed)
        + " pool_checksum=" + str(pool_checksum))
    return 0

// ============================================================================
//  RUN ALL SESSION TESTS
// ============================================================================

pub fn run_tests() -> Int:
    println("=== GREEBLE SESSION ACTOR TESTS ===")
    println("")
    println("Testing: SessionActor spawn, request delegation to worker pool")

    let init = runtime_init()
    if init != 0:
        println("  [CRITICAL] runtime_init failed: " + str(init))
        return 100

    var failures: Int = 0

    failures = failures + test_session_spawn()
    failures = failures + test_session_request_delegates_to_pool()

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        println("  [WARN] runtime_shutdown returned " + str(shutdown))

    println("")
    println("=== SESSION TESTS: " + str(failures) + " failure(s) ===")
    return failures
