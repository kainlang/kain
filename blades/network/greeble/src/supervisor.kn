// ============================================================================
//  supervisor.kn — Supervision Tree Actors
//
//  Ladder: Layer 7 — Systems (actor)
//  Erlang/OTP-style supervision with OneForAll and OneForOne strategies,
//  restart tracking, and escalation on excessive restarts.
//
//  Dependencies:
//    types.kn   — GreebleConfig, pack, unpack_first, unpack_second,
//                 SUP_POLICY_PERMANENT, SUP_POLICY_TEMPORARY, SUP_POLICY_TRANSIENT
//    router.kn  — spawn_router, route_add
//    gateway.kn — spawn_rate_limiter, spawn_auth_gate
//    worker.kn  — spawn_worker_pool
// ============================================================================

use std::actor
use types
use router
use gateway
use worker

// ============================================================================
//  CONSTANTS
// ============================================================================

const SUP_MAX_RESTARTS: Int = 5

// ============================================================================
//  ROOT SUPERVISOR — OneForAll Strategy
//
//  Children: RouterActor, RateLimiter, AuthGate, WorkerPoolSupervisor
//  When ANY child dies: restart ALL children (OneForAll).
//  If a single child exceeds 5 restarts: escalate (count tracked).
// ============================================================================

actor RootSupervisor:
    state children: Array<Int> = []
    state child_names: Array<String> = []
    state restart_counts: Array<Int> = []
    state escalation_count: Int = 0

    // ---- Child Exit Handler -----------------------------------------------

    on ChildExited(child_id: Int, exit_reason: Int):
        // Find the exited child and increment its restart count
        var i: Int = 0
        var found_idx: Int = -1
        while i < len(self.children):
            if self.children[i] == child_id:
                self.restart_counts[i] = self.restart_counts[i] + 1
                found_idx = i
                if self.restart_counts[i] > SUP_MAX_RESTARTS:
                    self.escalation_count = self.escalation_count + 1
                i = len(self.children)
            i = i + 1

        // OneForAll: restart ALL children regardless of which failed
        var j: Int = 0
        while j < len(self.children):
            let name = self.child_names[j]
            let new_id = actor_spawn(name, "")
            self.children[j] = new_id
            j = j + 1

    // ---- Spawn Child (for initial population) -----------------------------

    on SpawnChild(actor_name: String, init_payload: String):
        let child_id = actor_spawn(actor_name, init_payload)
        push(self.children, child_id)
        push(self.child_names, actor_name)
        push(self.restart_counts, 0)

    // ---- Telemetry Query --------------------------------------------------

    on GetTelemetry(reply_to: P, unused: Int):
        var total_restarts: Int = 0
        var k: Int = 0
        while k < len(self.restart_counts):
            total_restarts = total_restarts + self.restart_counts[k]
            k = k + 1
        let packed = pack(total_restarts, self.escalation_count)
        send reply_to.Reply(value = packed)

// ============================================================================
//  GATEWAY SUPERVISOR — OneForOne Strategy
//
//  Children: RateLimiter, AuthGate
//  Restart policies vary per child:
//    PERMANENT  — always restart (RateLimiter)
//    TRANSIENT  — restart on non-zero exit (AuthGate)
//    TEMPORARY  — never restart
// ============================================================================

actor GatewaySupervisor:
    state children: Array<Int> = []
    state child_policies: Array<Int> = []
    state restart_counts: Array<Int> = []

    // ---- Child Exit Handler -----------------------------------------------

    on ChildExited(child_id: Int, exit_reason: Int):
        var i: Int = 0
        while i < len(self.children):
            if self.children[i] == child_id:
                self.restart_counts[i] = self.restart_counts[i] + 1
                let policy = self.child_policies[i]

                // OneForOne: only restart the failed child
                if policy == SUP_POLICY_PERMANENT:
                    // Always restart regardless of exit reason
                    let new_id = actor_spawn("gateway-child", "")
                    self.children[i] = new_id

                elif policy == SUP_POLICY_TRANSIENT:
                    // Restart only on abnormal exit (exit_reason != 0)
                    if exit_reason != 0:
                        let new_id = actor_spawn("gateway-child", "")
                        self.children[i] = new_id

                // SUP_POLICY_TEMPORARY: never restart — child stays dead

                i = len(self.children)
            i = i + 1

    // ---- Spawn Child with Restart Policy ----------------------------------

    on SpawnChild(actor_name: String, init_payload: String, restart_policy: Int):
        let child_id = actor_spawn(actor_name, init_payload)
        push(self.children, child_id)
        push(self.child_policies, restart_policy)
        push(self.restart_counts, 0)

// ============================================================================
//  PUBLIC API
// ============================================================================

pub fn spawn_supervision_tree(config: GreebleConfig) -> Int:
    // 1. Spawn all component actors (returns actor types, cast to Int for wiring)
    let router_actor: RouterActor = spawn_router(config)
    let rl = spawn_rate_limiter(1000)
    let ag = spawn_auth_gate()
    let pool = spawn_worker_pool(config.worker_pool_size, config.mailbox_capacity)

    // 2. Wire dependency IDs back to the router (cast actor types to Int for send)
    send router_actor.SetDependencies(
        rate_limiter_id = rl as Int,
        auth_gate_id = ag as Int,
        worker_pool_id = pool as Int,
    )

    // 3. Spawn the root supervisor
    let sup = spawn RootSupervisor()
    let sup_id: Int = sup as Int

    // 4. Register for telemetry lookups
    let _ = actor_registry_register("greeble-root", sup_id)

    return sup_id

pub fn supervisor_restart_count(sup_id: Int) -> Int:
    // v0.1: cannot ask on Int at LLVM codegen time — return stub value.
    // Full implementation requires callers to hold the actor type reference.
    return 0

pub fn supervisor_escalation_count(sup_id: Int) -> Int:
    // v0.1: cannot ask on Int at LLVM codegen time — return stub value.
    // Full implementation requires callers to hold the actor type reference.
    return 0
