//     text = text + "  -d, --dashboard        Enable live terminal dashboard\n"
//     text = text + "      --dashboard-ms <N> Dashboard tick interval in ms (default: " + str(DEFAULT_DASHBOARD_INTERVAL_MS) + ")\n"
//     text = text + "      --no-telemetry     Disable /_telemetry JSON endpoint\n"
