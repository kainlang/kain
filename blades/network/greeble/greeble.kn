//         scheduler_overflow_spawns: ofs,
//         supervision_restart_count: sup_restarts,
//         supervision_escalation_count: sup_escalations,
//         patch_journal_count: pjc,
//         entangle_propagation_count: epc,
//         converge_mismatch_count: cmc,
