use common::build_tool_result
use common::command_result_payload
use common::command_summary
use common::extract_json_object_from_text
use common::optional_bool_param
use common::optional_string_array_param
use common::optional_string_param
use common::resolve_from_base
use runtime_settings::McpRuntimeSettings

fn append_json_payload_from_stdout(target: Any, result: Any, field_name: String) -> Unit:
    let json_text = extract_json_object_from_text(result.stdout)
    if len(json_text) > 0:
        json_object_set(target, field_name, json_parse(json_text))

fn base_command_payload(result: Any) -> Any:
    return command_result_payload(result)

pub fn handle_kain_doctor(settings: McpRuntimeSettings, _params: Any) -> Any:
    let result = command_run(settings.kain_bin, ["doctor"], settings.repo_root)
    let structured = base_command_payload(result)
    json_object_set(structured, "repo_root", settings.repo_root)
    json_object_set(structured, "kain_bin", settings.kain_bin)
    json_object_set(structured, "blade_root", settings.blade_root)
    return build_tool_result(command_summary("kain doctor", result), structured, true, !result.success)

pub fn handle_kain_check(settings: McpRuntimeSettings, params: Any) -> Any:
    let requested_path = optional_string_param(params, "path", "")
    let resolved_path = resolve_from_base(settings.repo_root, requested_path)
    let report_path = fs_temp_file("kain_mcp_check")
    let args = ["check"]
    let target = optional_string_param(params, "target", "")
    if len(target) > 0:
        push(args, "-t")
        push(args, target)
    push(args, resolved_path)
    push(args, "--json")
    push(args, report_path)

    let result = command_run(settings.kain_bin, args, settings.repo_root)
    let structured = base_command_payload(result)
    json_object_set(structured, "input", resolved_path)
    json_object_set(structured, "reportPath", report_path)
    if file_exists(report_path):
        json_object_set(structured, "report", json_parse(read_file(report_path)))
    return build_tool_result(command_summary("kain check", result), structured, true, !result.success)

pub fn handle_kain_run_plan(settings: McpRuntimeSettings, params: Any) -> Any:
    let requested_path = optional_string_param(params, "path", "")
    let resolved_path = resolve_from_base(settings.repo_root, requested_path)
    let args = ["run", "plan", "--json", resolved_path]
    let result = command_run(settings.kain_bin, args, settings.repo_root)
    let structured = base_command_payload(result)
    json_object_set(structured, "input", resolved_path)
    append_json_payload_from_stdout(structured, result, "plan")
    return build_tool_result(command_summary("kain run plan", result), structured, true, !result.success)

pub fn handle_kain_build(settings: McpRuntimeSettings, params: Any) -> Any:
    let args = ["build"]
    let requested_path = optional_string_param(params, "path", "")
    if len(requested_path) > 0:
        push(args, resolve_from_base(settings.repo_root, requested_path))
    let target = optional_string_param(params, "target", "")
    if len(target) > 0:
        push(args, "-t")
        push(args, target)
    let output = optional_string_param(params, "output", "")
    if len(output) > 0:
        push(args, "-o")
        push(args, resolve_from_base(settings.repo_root, output))
    let result = command_run(settings.kain_bin, args, settings.repo_root)
    let structured = base_command_payload(result)
    if len(requested_path) > 0:
        json_object_set(structured, "input", resolve_from_base(settings.repo_root, requested_path))
    return build_tool_result(command_summary("kain build", result), structured, true, !result.success)

pub fn handle_kain_commands_help(settings: McpRuntimeSettings, params: Any) -> Any:
    let args = ["commands", "help", "--bin", "kain"]
    let extra_args = optional_string_array_param(params, "argv")
    for item in extra_args:
        push(args, item)
    let result = command_run(settings.kain_bin, args, settings.repo_root)
    let structured = base_command_payload(result)
    return build_tool_result(command_summary("kain commands help", result), structured, true, !result.success)

pub fn handle_kain_blades_inspect(settings: McpRuntimeSettings, params: Any) -> Any:
    let blade_name = json_get_string(params, "blade")
    let workspace_path = resolve_from_base(settings.repo_root, optional_string_param(params, "path", settings.repo_root))
    let args = ["equip", blade_name, "--path", workspace_path, "--json"]
    let result = command_run(settings.kain_bin, args, settings.repo_root)
    let structured = base_command_payload(result)
    json_object_set(structured, "blade", blade_name)
    json_object_set(structured, "workspacePath", workspace_path)
    append_json_payload_from_stdout(structured, result, "bladePlan")
    return build_tool_result(command_summary("kain equip", result), structured, true, !result.success)

pub fn handle_kain_blades_build(settings: McpRuntimeSettings, params: Any) -> Any:
    let args = ["blades", "build", "--json"]
    let profile = optional_string_param(params, "profile", "")
    if len(profile) > 0:
        push(args, "--profile")
        push(args, profile)
    let target = optional_string_param(params, "target", "")
    if len(target) > 0:
        push(args, "--target")
        push(args, target)
    if optional_bool_param(params, "dryRun", false):
        push(args, "--dry-run")
    if optional_bool_param(params, "clean", false):
        push(args, "--clean")
    let requested_path = resolve_from_base(settings.repo_root, optional_string_param(params, "path", settings.repo_root))
    push(args, requested_path)

    let result = command_run(settings.kain_bin, args, settings.repo_root)
    let structured = base_command_payload(result)
    json_object_set(structured, "path", requested_path)
    append_json_payload_from_stdout(structured, result, "buildReport")
    return build_tool_result(command_summary("kain blades build", result), structured, true, !result.success)
