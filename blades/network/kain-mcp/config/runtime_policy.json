{
  "schema_version": 1,
  "environment": {
    "repo_root_keys": ["KAIN_REPO_ROOT", "KAIN_MCP_REPO_ROOT"],
    "kain_bin_override_key": "KAIN_MCP_KAIN_BIN",
    "allow_writes_key": "KAIN_MCP_ALLOW_WRITES",
    "include_hidden_key": "KAIN_MCP_INCLUDE_HIDDEN",
    "skip_dirs_key": "KAIN_MCP_SKIP_DIRS"
  },
  "paths": {
    "tools_manifest": "config/tools.json",
    "examples_manifest": "../../docs/examples/examples_manifest.json",
    "examples_validator": "../../docs/examples/validate_examples.py"
  },
  "python_runner": {
    "program": "py",
    "args": ["-3"]
  },
  "kain_binary_candidates": [
    ".kain/bin/kain.exe",
    ".kain/bin/kain",
    "target/debug/kain.exe",
    "target/debug/kain",
    "target/release/kain.exe",
    "target/release/kain",
    "PATH:kain"
  ],
  "kain_launcher_dirs_windows": [
    ".kain/bin"
  ],
  "kain_launcher_dirs_unix": [
    ".kain/bin"
  ],
  "launcher_sync": {
    "enabled": false,
    "prefer_synced_binary": false,
    "state_root_env_key": "KAIN_SYNC_ROOT",
    "default_state_root_windows": ".kain/state",
    "default_state_root_unix": ".kain/state",
    "shared_launcher_dir_windows": ".kain/bin",
    "shared_launcher_dir_unix": ".kain/bin",
    "shadow_launcher_dirs_windows": [],
    "shadow_launcher_dirs_unix": [],
    "launcher_binary_names": ["kain", "kn", "blade"],
    "bazel_binary_output_names": {
      "blade": "blade_bin"
    },
    "bazel_default_config_windows": "dev",
    "cargo_bazel_auto_repin_enabled": true,
    "cargo_bazel_repin_lock_relative_path": "locks/cargo-bazel-repin.lock",
    "cargo_bazel_repin_lock_timeout_seconds": 300,
    "lock_relative_path": "locks/sync.lock",
    "stamp_relative_path": "state/kain_sync_stamp.json",
    "build_counter_relative_path": "state/build_counter.json",
    "launch_trace_enabled": true,
    "launch_trace_relative_path": "state/kain_mcp_launcher_trace.jsonl",
    "cooldown_seconds": 45,
    "stale_lock_seconds": 900,
    "preflight_enabled": true,
    "preflight_timeout_seconds": 20,
    "sync_command_windows": [
      "py",
      "-3",
      "scripts/python/kain_bazel_sync.py",
      "sync",
      "--managed-sync"
    ],
    "sync_command_unix": [
      "python3",
      "scripts/python/kain_bazel_sync.py",
      "sync",
      "--managed-sync"
    ],
    "runtime_stamp_files": [
      "runtime/runtime.c",
      "runtime/native_core_runtime.toml",
      "blades/kain-mcp/config/runtime_policy.json"
    ],
    "source_watch_paths": [
      "crates",
      "runtime",
      "src",
      "tools/bazel",
      "toolchain/rules_rust",
      "Cargo.toml",
      "Cargo.lock",
      "Cargo.Bazel.lock",
      "BUILD.bazel",
      "MODULE.bazel",
      "MODULE.bazel.lock",
      ".bazelrc",
      ".bazelversion",
      ".bazeliskrc"
    ],
    "source_filesystem_watch_paths": [
      "toolchain/rules_rust"
    ]
  },
  "defaults": {
    "allow_writes": true,
    "include_hidden": false,
    "timeout_ms": 1800000,
    "max_list_entries": 250,
    "default_read_limit": 200000,
    "skip_dirs": [
      ".git",
      "target",
      "node_modules",
      "dist",
      "build",
      "generated",
      "out",
      "coverage",
      ".cache",
      ".venv"
    ]
  }
}
