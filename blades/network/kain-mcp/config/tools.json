{
  "schema_version": 1,
  "server": {
    "name": "kain-mcp",
    "title": "Kain MCP Blade",
    "version": "0.1.0",
    "description": "Canonical Kain-authored MCP blade for filesystem, Kain CLI, and authoring workflows."
  },
  "instructions": "Use fs.* for repo-local file work, kain.* for the current Kain CLI surface, and authoring.* for the docs/examples ladder.",
  "tools": [
    {
      "name": "fs.list_directory",
      "title": "List Directory",
      "description": "List a directory tree from the repo, optionally recursively.",
      "handler": "fs_list_directory",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "recursive": { "type": "boolean" },
          "includeHidden": { "type": "boolean" },
          "maxEntries": { "type": "integer" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "fs.read_file",
      "title": "Read File",
      "description": "Read a text file from disk.",
      "handler": "fs_read_file",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "maxBytes": { "type": "integer" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "fs.write_file",
      "title": "Write File",
      "description": "Write text to a file, optionally refusing overwrite.",
      "handler": "fs_write_file",
      "writes": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" },
          "overwrite": { "type": "boolean" }
        },
        "required": ["path", "content"],
        "additionalProperties": false
      }
    },
    {
      "name": "fs.make_directory",
      "title": "Make Directory",
      "description": "Create a directory tree.",
      "handler": "fs_make_directory",
      "writes": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "kain.doctor",
      "title": "Kain Doctor",
      "description": "Run `kain doctor` against the resolved Kain binary.",
      "handler": "kain_doctor",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "kain.check",
      "title": "Kain Check",
      "description": "Typecheck a Kain source file or directory and return the structured check report.",
      "handler": "kain_check",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "target": { "type": "string" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "kain.run.plan",
      "title": "Kain Run Plan",
      "description": "Resolve a `kain run plan` report for a file, blade, or workspace path.",
      "handler": "kain_run_plan",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "kain.build",
      "title": "Kain Build",
      "description": "Run `kain build` for a file or project path.",
      "handler": "kain_build",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "target": { "type": "string" },
          "output": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "kain.commands.help",
      "title": "Kain Commands Help",
      "description": "Print live command help from the current Kain binary.",
      "handler": "kain_commands_help",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "argv": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "kain.blades.inspect",
      "title": "Inspect Blade",
      "description": "Resolve a blade through `kain equip` and return the JSON blade plan.",
      "handler": "kain_blades_inspect",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "blade": { "type": "string" },
          "path": { "type": "string" }
        },
        "required": ["blade"],
        "additionalProperties": false
      }
    },
    {
      "name": "kain.blades.build",
      "title": "Build Blade Workspace",
      "description": "Run `kain blades build` and return the JSON build report.",
      "handler": "kain_blades_build",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "profile": { "type": "string" },
          "target": { "type": "string" },
          "dryRun": { "type": "boolean" },
          "clean": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "authoring.topics",
      "title": "Authoring Topics",
      "description": "Return the docs/examples ladder and its coverage topics.",
      "handler": "authoring_topics",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "authoring.example",
      "title": "Authoring Example",
      "description": "Load one docs/examples entry plus its source text.",
      "handler": "authoring_example",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "example": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "authoring.validate_examples",
      "title": "Validate Examples",
      "description": "Run the docs/examples validator with the current Kain binary.",
      "handler": "authoring_validate_examples",
      "writes": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "only": { "type": "string" },
          "validationClass": { "type": "string" },
          "outputRoot": { "type": "string" },
          "keepOutput": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  ]
}
