    let _chart_energy = kaintana_immediate_chart_bar(session, charts_panel, "chart.energy", "energy", Float(energy), 140.0, kaintana_column_slot(chart_lane, 0.0, 58.0, 10.0), theme, body_font, 16.0, theme.signal_red, theme.signal_green, theme.signal_blue)
    let _chart_projected = kaintana_immediate_chart_bar(session, charts_panel, "chart.projected", "projected", Float(projected_energy), 160.0, kaintana_column_slot(chart_lane, 1.0, 58.0, 10.0), theme, body_font, 16.0, theme.accent_red, theme.accent_green, theme.accent_blue)
    let _chart_orchestrated = kaintana_immediate_chart_bar(session, charts_panel, "chart.orchestrated", "orchestrated", Float(orchestrated_energy), 180.0, kaintana_column_slot(chart_lane, 2.0, 58.0, 10.0), theme, body_font, 16.0, theme.signal_red, theme.signal_green, theme.signal_blue)
    let _chart_axis = kaintana_immediate_chart_bar(session, charts_panel, "chart.axis", "orbit", orbit_value * 100.0, 200.0, kaintana_column_slot(chart_lane, 3.0, 58.0, 10.0), theme, body_font, 16.0, theme.accent_red, theme.accent_green, theme.accent_blue)

    let _flow_title = kaintana_retained_label(session, flow_panel, "flow.title", "AUTHORING FLOW", kaintana_rect(flow_inner.x, flow_inner.y, flow_inner.width, 24.0), theme, badge_font, 18.0)
    let _flow_copy = kaintana_retained_muted_label(session, flow_panel, "flow.copy", "Raw fills + text. No prefab catalog.", kaintana_rect(flow_inner.x, flow_inner.y + 34.0, flow_inner.width, 24.0), theme, micro_font, 13.0)
    let flow_steps = kaintana_rect(flow_inner.x, flow_inner.y + 86.0, flow_inner.width, flow_inner.height - 86.0)
    let flow_step_0 = kaintana_column_slot(flow_steps, 0.0, 54.0, 10.0)
    let flow_step_1 = kaintana_column_slot(flow_steps, 1.0, 54.0, 10.0)
    let flow_step_2 = kaintana_column_slot(flow_steps, 2.0, 54.0, 10.0)
    let flow_step_3 = kaintana_column_slot(flow_steps, 3.0, 54.0, 10.0)
    let _flow_fill_0 = kaintana_primitive_fill(session, flow_panel, "flow.step.fill.0", flow_step_0, theme.shell_red, theme.shell_green, theme.shell_blue)
    let _flow_rule_0 = kaintana_primitive_fill(session, flow_panel, "flow.step.rule.0", kaintana_rect(flow_step_0.x + 12.0, flow_step_0.y + 14.0, 34.0, 4.0), theme.signal_red, theme.signal_green, theme.signal_blue)
    let _flow_text_0 = kaintana_primitive_text(session, flow_panel, "flow.step.text.0", "1 // carve", kaintana_rect(flow_step_0.x + 12.0, flow_step_0.y + 6.0, flow_step_0.width - 24.0, 18.0), theme.ink_red, theme.ink_green, theme.ink_blue, micro_font, 15.0)
    let _flow_fill_1 = kaintana_primitive_fill(session, flow_panel, "flow.step.fill.1", flow_step_1, theme.shell_red, theme.shell_green, theme.shell_blue)
    let _flow_rule_1 = kaintana_primitive_fill(session, flow_panel, "flow.step.rule.1", kaintana_rect(flow_step_1.x + 12.0, flow_step_1.y + 14.0, 54.0, 4.0), theme.accent_red, theme.accent_green, theme.accent_blue)
    let _flow_text_1 = kaintana_primitive_text(session, flow_panel, "flow.step.text.1", "2 // place tools", kaintana_rect(flow_step_1.x + 12.0, flow_step_1.y + 6.0, flow_step_1.width - 24.0, 18.0), theme.ink_red, theme.ink_green, theme.ink_blue, micro_font, 15.0)
    let _flow_fill_2 = kaintana_primitive_fill(session, flow_panel, "flow.step.fill.2", flow_step_2, theme.shell_red, theme.shell_green, theme.shell_blue)
    let _flow_rule_2 = kaintana_primitive_fill(session, flow_panel, "flow.step.rule.2", kaintana_rect(flow_step_2.x + 12.0, flow_step_2.y + 14.0, 86.0, 4.0), theme.signal_red, theme.signal_green, theme.signal_blue)
    let _flow_text_2 = kaintana_primitive_text(session, flow_panel, "flow.step.text.2", "3 // draw bars", kaintana_rect(flow_step_2.x + 12.0, flow_step_2.y + 6.0, flow_step_2.width - 24.0, 18.0), theme.ink_red, theme.ink_green, theme.ink_blue, micro_font, 15.0)
    let _flow_fill_3 = kaintana_primitive_fill(session, flow_panel, "flow.step.fill.3", flow_step_3, theme.shell_red, theme.shell_green, theme.shell_blue)
    let _flow_rule_3 = kaintana_primitive_fill(session, flow_panel, "flow.step.rule.3", kaintana_rect(flow_step_3.x + 12.0, flow_step_3.y + 14.0, 112.0, 4.0), theme.accent_red, theme.accent_green, theme.accent_blue)
    let _flow_text_3 = kaintana_primitive_text(session, flow_panel, "flow.step.text.3", "4 // services", kaintana_rect(flow_step_3.x + 12.0, flow_step_3.y + 6.0, flow_step_3.width - 24.0, 18.0), theme.ink_red, theme.ink_green, theme.ink_blue, micro_font, 15.0)

    let _inspector_title = kaintana_retained_label(session, inspector_panel, "inspector.title", "INSPECTOR", kaintana_rect(inspector_inner.x, inspector_inner.y, inspector_inner.width, 24.0), theme, badge_font, 18.0)
    let _inspector_copy = kaintana_retained_muted_label(session, inspector_panel, "inspector.copy", "Settings anchors menus + services.", kaintana_rect(inspector_inner.x, inspector_inner.y + 34.0, inspector_inner.width, 22.0), theme, micro_font, 13.0)
    let _slider_energy = kaintana_immediate_slider(session, inspector_panel, "slider.energy", "gain.drive", Float(energy), 0.0, 128.0, kaintana_rect(inspector_inner.x, inspector_inner.y + 244.0, inspector_inner.width, 62.0), theme, body_font, 16.0)
    let _slider_axis = kaintana_immediate_slider(session, inspector_panel, "slider.axis", "orbit.axis", orbit_value * 100.0, 0.0, 200.0, kaintana_rect(inspector_inner.x, inspector_inner.y + 314.0, inspector_inner.width, 62.0), theme, body_font, 16.0)
    let _slider_lane = kaintana_immediate_slider(session, inspector_panel, "slider.lane", "agent.mix", Float(orchestrated_energy), 0.0, 180.0, kaintana_rect(inspector_inner.x, inspector_inner.y + 384.0, inspector_inner.width, 62.0), theme, body_font, 16.0)
    let _inspector_focus = kaintana_immediate_metric(session, inspector_panel, "inspector.focus", "focus.node", str(kaintana_focused_node(session)), kaintana_rect(inspector_inner.x, inspector_inner.y + 458.0, inspector_inner.width, 20.0), theme, micro_font, 13.0)
    let _inspector_clipboard = kaintana_immediate_metric(session, inspector_panel, "inspector.clipboard", "clipboard.bytes", str(len(kaintana_clipboard_text(session))), kaintana_rect(inspector_inner.x, inspector_inner.y + 484.0, inspector_inner.width, 20.0), theme, micro_font, 13.0)
    let _inspector_ime = kaintana_immediate_metric(session, inspector_panel, "inspector.ime", "ime.text", kaintana_ime_text(session), kaintana_rect(inspector_inner.x, inspector_inner.y + 510.0, inspector_inner.width, 20.0), theme, micro_font, 13.0)
    let _inspector_menu = kaintana_immediate_metric(session, inspector_panel, "inspector.menu", "menu.items", str(kaintana_menu_item_count(session, settings_menu)), kaintana_rect(inspector_inner.x, inspector_inner.y + 536.0, inspector_inner.width, 20.0), theme, micro_font, 13.0)

    let _keypad_title = kaintana_retained_label(session, keypad_panel, "keypad.title", "KEYPAD", kaintana_rect(keypad_inner.x, keypad_inner.y, keypad_inner.width, 24.0), theme, badge_font, 18.0)
    let keypad_grid = kaintana_rect(keypad_inner.x, keypad_inner.y + 34.0, keypad_inner.width, keypad_inner.height - 34.0)
    let _pad_7 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.7", "7", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 0.0, 0.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_8 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.8", "8", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 1.0, 0.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_9 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.9", "9", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 2.0, 0.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_4 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.4", "4", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 0.0, 1.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_5 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.5", "5", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 1.0, 1.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_6 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.6", "6", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 2.0, 1.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_1 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.1", "1", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 0.0, 2.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_2 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.2", "2", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 1.0, 2.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_3 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.3", "3", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 2.0, 2.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_dot = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.dot", ".", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 0.0, 3.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_0 = kaintana_immediate_toolbar_button(session, keypad_panel, "pad.0", "0", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 1.0, 3.0, 10.0, 10.0), theme, body_font, 28.0)
    let _pad_enter = kaintana_immediate_button(session, keypad_panel, "pad.enter", "ENT", kaintana_grid_cell(keypad_grid, 3.0, 4.0, 2.0, 3.0, 10.0, 10.0), theme, body_font, 28.0)

    let _status_copy = kaintana_retained_muted_label(session, status_panel, "status.copy", "Low-level path: viewport -> charts -> sliders -> keypad -> host snapshot.", kaintana_rect(status_inner.x, status_inner.y + 2.0, 760.0, 18.0), theme, micro_font, 13.0)
    let status_metric_band = kaintana_rect(status_inner.x + 790.0, status_inner.y + 2.0, status_inner.width - 790.0, 18.0)
    let _status_lane = kaintana_immediate_metric(session, status_panel, "status.lane", "lane", str(active_lane), kaintana_row_slot(status_metric_band, 0.0, 110.0, 14.0), theme, micro_font, 14.0)
    let _status_dialog = kaintana_immediate_metric(session, status_panel, "status.dialog", "dialog", str(dialog_result), kaintana_row_slot(status_metric_band, 1.0, 120.0, 14.0), theme, micro_font, 14.0)
    let _status_trace = kaintana_immediate_metric(session, status_panel, "status.trace", "trace.events", str(kaintana_action_event_count(action_session)), kaintana_row_slot(status_metric_band, 2.0, 146.0, 14.0), theme, micro_font, 14.0)

    let _focus_ring = kaintana_render_focus_ring(session, settings_button, theme, 4.0)
    let _commit = kaintana_commit_frame(session)

    if !broadcast_energy_valid(energy):
        println("energy law failed")
        return 20
    if kaintana_focused_node(session) != settings_button:
        return 21
    if kaintana_clipboard_text(session) != headline:
        return 22
    if kaintana_ime_active_node(session) != settings_button:
        return 23
    if kaintana_ime_text(session) != "settings://agent/commit":
        return 24
    if kaintana_active_menu(session) != settings_menu:
        return 25
    if kaintana_menu_item_count(session, settings_menu) != 3:
        return 26
    if kaintana_menu_item_command(session, settings_menu, 0) != 301:
        return 27
    if dialog_id <= 0 or dialog_result != 7:
        return 28
    if kaintana_dialog_response_text(session) != "accepted":
        return 29
    if kaintana_popover_is_open(session, settings_button, settings_popover_spec) != 1:
        return 30
    if kaintana_action_frame_index(action_session) < 8:
        return 31
    if kaintana_action_event_count(action_session) < 1:
        return 32
    if orbit_value != 1.5:
        return 33

    let _frame_report = kaintana_write_frame_report(session, spec, theme, headline)
    let _snapshot = kaintana_write_harness_artifacts(session, action_session, spec, theme, headline, harness)
    let _popover_close = kaintana_popover_close(session, settings_button, settings_popover_spec)
    let host_status = kaintana_host_run_window(spec)
    let _host_report = kaintana_host_write_report(spec)
    let _host_shot = kaintana_host_write_screenshot(spec)
    let _action_destroy = kaintana_action_session_destroy(action_session)

    println("backend=" + settings.backend + " frames=" + str(kaintana_host_frames_presented(spec)) + " geometry=" + str(kaintana_host_geometry_count(spec)))

    if host_status != 0:
        return 40
    return 0
