// style: orbital service workbench
use c::kaintana_desktop_bridge
use kaintana::*

component App():
    render <panel title="KaintanaTest" />

world SignalAuthority:
    state broadcast_energy: Int = 72
    state selected_lane: Int = 0
    surface native_ui => App

world SignalMirror:
    state mirrored_energy: Int = 72
    state mirrored_lane: Int = 0
    surface web => App

entangle SignalAuthority.broadcast_energy <-> SignalMirror.mirrored_energy with single_writer
entangle SignalAuthority.selected_lane <-> SignalMirror.mirrored_lane with single_writer

patch set_broadcast_energy(authority: SignalAuthority, value: Int) -> Int:
    authority.broadcast_energy = value
    return authority.broadcast_energy

patch set_selected_lane(authority: SignalAuthority, value: Int) -> Int:
    authority.selected_lane = value
    return authority.selected_lane

law broadcast_energy_valid(value: Int) -> Bool:
    return value >= 0 and value <= 512

converge signal_projection(value: Int) -> Int:
    spec reference:
        return value + 6
    fast native_lane when capability("native.actor"):
        return value + 6
    verify random(4)

fn lane_bias(value: Int) -> Int:
    return value + 9

orchestrate broadcast_pipeline(value: Int) -> Int:
    let projected: Int = kain signal_projection(value)
    let biased: Int = rust lane_bias(projected)
    return biased

fn kaintana_is_digit_char(ch: String) -> Bool:
    return ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"

fn kaintana_digit_value(ch: String) -> Int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    return 9

fn kaintana_parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    let sign = 1
    let index = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    let value = 0
    while index < len(text):
        if !kaintana_is_digit_char(char_at(text, index)):
            return value * sign
        value = value * 10 + kaintana_digit_value(char_at(text, index))
        index = index + 1
    return value * sign

fn kaintana_frame_budget_or_default(default_value: Int) -> Int:
    let override_text = env("KAINTANA_TEST_FRAME_BUDGET")
    if len(override_text) == 0:
        return default_value
    let override_value = kaintana_parse_int_text(override_text)
    if override_value <= 0:
        return default_value
    return override_value

pub struct KaintanaTestSettings:
    title: String
    backend: String
    theme_name: String
    width: Int
    height: Int
    frame_budget: Int
    revision_key: String
    clear_red: Int
    clear_green: Int
    clear_blue: Int
    accent_red: Int
    accent_green: Int
    accent_blue: Int
    frame_report_path: String
    host_report_path: String
    screenshot_path: String
    snapshot_path: String
    input_trace_path: String
    vertex_shader_path: String
    fragment_shader_path: String

pub fn kaintana_test_settings_desktop() -> KaintanaTestSettings:
    return KaintanaTestSettings {
        title: "Kaintana // Oxide Control Deck",
        backend: kaintana_backend_desktop(),
        theme_name: "oxide-dcc",
        width: 1680,
        height: 1000,
        frame_budget: kaintana_frame_budget_or_default(180),
        revision_key: "kaintana-test-desktop-v3-oxide-dcc",
        clear_red: 18,
        clear_green: 20,
        clear_blue: 24,
        accent_red: 255,
        accent_green: 156,
        accent_blue: 74,
        frame_report_path: ".kain/run/kaintana_test_desktop_frame.txt",
        host_report_path: ".kain/run/kaintana_test_desktop_host.txt",
        screenshot_path: ".kain/run/kaintana_test_desktop.bmp",
        snapshot_path: ".kain/run/kaintana_test_desktop_snapshot.txt",
        input_trace_path: ".kain/run/kaintana_test_desktop_input_trace.txt",
        vertex_shader_path: "",
        fragment_shader_path: "",
    }

fn build_window_spec(settings: KaintanaTestSettings) -> KaintanaWindowSpec:
    return kaintana_window_spec(
        settings.title,
        settings.width,
        settings.height,
        settings.frame_budget,
        settings.backend,
        "software",
        settings.clear_red,
        settings.clear_green,
        settings.clear_blue,
        settings.accent_red,
        settings.accent_green,
        settings.accent_blue,
        settings.vertex_shader_path,
        settings.fragment_shader_path,
        settings.frame_report_path,
        settings.host_report_path,
        settings.screenshot_path,
    )

fn build_harness_spec(settings: KaintanaTestSettings) -> KaintanaHarnessSpec:
    return kaintana_harness_spec(settings.snapshot_path, settings.input_trace_path)

fn headline_for_backend(backend: String, energy: Int, projection: Int) -> String:
    return "KAINTANA // " + backend + " // energy=" + str(energy) + " // projected=" + str(projection)

fn bind_action_map(action_session: Int) -> Int:
    let _activate_focused = kaintana_action_bind(action_session, kaintana_key_down_binding("Enter", "ui.activate.focused"))
    let _activate_focus_release = kaintana_action_bind(action_session, kaintana_key_up_binding("Enter", "ui.activate.focused"))
    let _reroute_focused = kaintana_action_bind(action_session, kaintana_key_down_binding("Space", "ui.reroute.focused"))
    let _reroute_focus_release = kaintana_action_bind(action_session, kaintana_key_up_binding("Space", "ui.reroute.focused"))
    let _copy_clipboard = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyC", "service.clipboard.copy"))
    let _copy_clipboard_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyC", "service.clipboard.copy"))
    let _open_menu = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyM", "service.menu.open"))
    let _open_menu_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyM", "service.menu.open"))
    let _request_dialog = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyD", "service.dialog.request"))
    let _request_dialog_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyD", "service.dialog.request"))
    let _orbit_axis = kaintana_axis_bind(action_session, kaintana_axis_binding("human.pointer", "axis", "orbit_x", "service.orbit.x", 0.25))
    return 1

fn press_key(action_session: Int, code: String) -> Int:
    let _down = kaintana_action_push_key_down(action_session, "keyboard.proof", code)
    return kaintana_action_begin_frame(action_session, 16.0)

fn release_key(action_session: Int, code: String) -> Int:
    let _up = kaintana_action_push_key_up(action_session, "keyboard.proof", code)
    return kaintana_action_begin_frame(action_session, 16.0)

fn pump_axis(action_session: Int, value: Float) -> Int:
    let _axis = kaintana_action_push_axis(action_session, "human.pointer", "pointer.proof", "orbit_x", value)
    return kaintana_action_begin_frame(action_session, 16.0)

fn pump_agent_intent(action_session: Int, action: String, command_text: String) -> Int:
    let _intent = kaintana_action_push_agent_intent(action_session, "codex", action, command_text, 0.99)
    return kaintana_action_begin_frame(action_session, 16.0)

fn action_status_text(action_session: Int) -> String:
    return str(kaintana_action_frame_index(action_session)) + "f/" + str(kaintana_action_event_count(action_session)) + "e"

fn main() -> Int:
    let runtime_status = native_runtime_init()
    if runtime_status != 0:
        println("runtime init failed")
        return 10

    let _action_reset = kaintana_action_reset()
    let settings = kaintana_test_settings_desktop()
    let harness = build_harness_spec(settings)
    let theme: KaintanaTheme = kaintana_theme_named(settings.theme_name)
    let spec = build_window_spec(settings)
    let authority = SignalAuthority
    var energy = set_broadcast_energy(authority, 72)
    let active_lane = set_selected_lane(authority, 1)
    let dialog_result = 0

    if settings.backend == kaintana_backend_desktop() and kaintana_desktop_probe() != 1:
        println("desktop host unavailable")
        return 11

    if settings.backend == kaintana_backend_desktop():
        let _scene = kaintana_desktop_scene_begin(spec)

    let session = kaintana_session_create("kaintana-test", spec)
    let action_session = kaintana_action_session_create("kaintana-test-actions")
    let _bindings = bind_action_map(action_session)
    let body_font = native_ui_font_create(session, "font.kaintana.body", "Segoe UI", 15.0)
    let title_font = native_ui_font_create(session, "font.kaintana.title", "Bahnschrift SemiBold", 24.0)
    let badge_font = native_ui_font_create(session, "font.kaintana.badge", "Consolas", 12.0)
    let micro_font = native_ui_font_create(session, "font.kaintana.micro", "Segoe UI", 11.0)
    let _frame = kaintana_begin_frame(session, settings.revision_key, 16.0)

    let window_rect = kaintana_window_rect(spec)
    let shell_rect = kaintana_inset(window_rect, 14.0, 14.0, 14.0, 14.0)
    let top_bar_rect = kaintana_rect(shell_rect.x, shell_rect.y, shell_rect.width, 60.0)
    let status_rect = kaintana_rect(shell_rect.x, shell_rect.y + shell_rect.height - 42.0, shell_rect.width, 42.0)
    let work_rect = kaintana_rect(shell_rect.x, top_bar_rect.y + top_bar_rect.height + 10.0, shell_rect.width, status_rect.y - (top_bar_rect.y + top_bar_rect.height + 10.0) - 10.0)
    let tool_rect = kaintana_split_left(work_rect, 0.10, 12.0)
    let inspector_rect = kaintana_split_right(work_rect, 0.75, 12.0)
    let center_rect = kaintana_rect(tool_rect.x + tool_rect.width + 12.0, work_rect.y, inspector_rect.x - (tool_rect.x + tool_rect.width + 12.0) - 12.0, work_rect.height)
    let viewport_rect = kaintana_split_top(center_rect, 0.54, 12.0)
    let lower_rect = kaintana_split_bottom(center_rect, 0.54, 12.0)
    let charts_rect = kaintana_split_left(lower_rect, 0.52, 12.0)
    let flow_rect = kaintana_split_right(lower_rect, 0.52, 12.0)
    let inspector_top_rect = kaintana_split_top(inspector_rect, 0.62, 12.0)
    let keypad_rect = kaintana_split_bottom(inspector_rect, 0.62, 12.0)

    let shell_node = kaintana_retained_region(session, 0, "shell", "oxide.shell", shell_rect, theme)
    let top_bar = kaintana_immediate_panel(session, shell_node, "panel.topbar", "", top_bar_rect, theme, badge_font, 24.0)
    let tool_panel = kaintana_immediate_panel(session, shell_node, "panel.tools", "", tool_rect, theme, badge_font, 22.0)
    let viewport_surface = kaintana_retained_surface(session, shell_node, "surface.viewport", "surface.viewport.dcc", "VIEWPORT", viewport_rect, theme, badge_font, 20.0)
    let charts_panel = kaintana_retained_region(session, shell_node, "panel.charts", "charts", charts_rect, theme)
    let flow_panel = kaintana_retained_region(session, shell_node, "panel.flow", "flow", flow_rect, theme)
    let inspector_panel = kaintana_retained_region(session, shell_node, "panel.inspector", "inspector", inspector_top_rect, theme)
    let keypad_panel = kaintana_retained_region(session, shell_node, "panel.keypad", "keypad", keypad_rect, theme)
    let status_panel = kaintana_immediate_panel(session, shell_node, "panel.status", "", status_rect, theme, badge_font, 22.0)

    let top_inner = kaintana_inset(top_bar_rect, 14.0, 10.0, 14.0, 10.0)
    let tool_inner = kaintana_inset(tool_rect, 12.0, 46.0, 12.0, 12.0)
    let viewport_inner = kaintana_inset(viewport_rect, 22.0, 24.0, 22.0, 22.0)
    let charts_inner = kaintana_inset(charts_rect, 18.0, 18.0, 18.0, 18.0)
    let flow_inner = kaintana_inset(flow_rect, 18.0, 18.0, 18.0, 18.0)
    let inspector_inner = kaintana_inset(inspector_top_rect, 18.0, 18.0, 18.0, 18.0)
    let keypad_inner = kaintana_inset(keypad_rect, 16.0, 18.0, 16.0, 16.0)
    let status_inner = kaintana_inset(status_rect, 16.0, 10.0, 16.0, 10.0)

    let _brand = kaintana_immediate_badge(session, top_bar, "badge.brand", "KAINTANA", kaintana_row_slot(kaintana_rect(top_inner.x, top_inner.y, 150.0, top_inner.height), 0.0, 150.0, 0.0), theme, badge_font, 20.0)
    let toolbar_band = kaintana_rect(top_inner.x + 164.0, top_inner.y, 520.0, top_inner.height)
    let _file_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.file", "File", kaintana_row_slot(toolbar_band, 0.0, 80.0, 8.0), theme, micro_font, 22.0)
    let _edit_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.edit", "Edit", kaintana_row_slot(toolbar_band, 1.0, 80.0, 8.0), theme, micro_font, 22.0)
    let _view_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.view", "View", kaintana_row_slot(toolbar_band, 2.0, 80.0, 8.0), theme, micro_font, 22.0)
    let _layout_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.layout", "Layout", kaintana_row_slot(toolbar_band, 3.0, 98.0, 8.0), theme, micro_font, 22.0)
    let _snapshot_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.snapshot", "Snapshot", kaintana_row_slot(toolbar_band, 4.0, 118.0, 8.0), theme, micro_font, 22.0)
    let settings_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.settings", "Settings", kaintana_rect(top_inner.x + top_inner.width - 350.0, top_inner.y, 110.0, top_inner.height), theme, micro_font, 22.0)
    let _backend_badge = kaintana_immediate_badge(session, top_bar, "badge.backend", settings.backend, kaintana_rect(top_inner.x + top_inner.width - 226.0, top_inner.y + 2.0, 98.0, 30.0), theme, badge_font, 18.0)
    let _reload_badge = kaintana_immediate_badge(session, top_bar, "badge.reload", "reload " + str(kaintana_hot_reload_generation(session)), kaintana_rect(top_inner.x + top_inner.width - 118.0, top_inner.y + 2.0, 104.0, 30.0), theme, badge_font, 18.0)

    let inspector_action_lane = kaintana_rect(inspector_inner.x, inspector_inner.y + 88.0, inspector_inner.width, 142.0)
    let boost_button = kaintana_immediate_button(session, inspector_panel, "action.boost", "PATCH // BOOST", kaintana_column_slot(inspector_action_lane, 0.0, 42.0, 8.0), theme, body_font, 26.0)
    let reroute_button = kaintana_immediate_button(session, inspector_panel, "action.reroute", "KEYMAP // REROUTE", kaintana_column_slot(inspector_action_lane, 1.0, 42.0, 8.0), theme, body_font, 26.0)
    let backend_button = kaintana_immediate_button(session, inspector_panel, "action.backend", "AGENT // HOST LANE", kaintana_column_slot(inspector_action_lane, 2.0, 42.0, 8.0), theme, body_font, 26.0)

    let settings_menu = kaintana_menu_create(session, "menu.settings.deck")
    let _menu_preferences = kaintana_menu_add_item(session, settings_menu, kaintana_menu_item("menu.preferences", "Preferences", 301))
    let _menu_snapshot = kaintana_menu_add_item(session, settings_menu, kaintana_menu_item("menu.snapshot", "Write Snapshot", 302))
    let _menu_reset = kaintana_menu_add_item(session, settings_menu, kaintana_menu_item("menu.reset", "Reset Layout", 303))
    let settings_popover_spec = kaintana_popover_spec("settings.deck", 260.0, 132.0, -12.0, 10.0)

    let _proof_click = kaintana_click_node(session, boost_button)
    while kaintana_poll_event(session) == 1:
        if kaintana_action_activated(session, action_session, boost_button, "ui.activate.focused") == 1:
            energy = set_broadcast_energy(authority, energy + 18)

    let _focus_reroute = kaintana_focus_node(session, reroute_button)
    let _reroute_press = press_key(action_session, "Space")
    if kaintana_action_activated(session, action_session, reroute_button, "ui.reroute.focused") == 1:
        energy = set_broadcast_energy(authority, signal_projection(energy))
    let _reroute_release = release_key(action_session, "Space")
    let _reroute_state = kaintana_action_activated(session, action_session, reroute_button, "ui.reroute.focused")

    let _focus_backend = kaintana_focus_node(session, backend_button)
    let _backend_intent = pump_agent_intent(action_session, "ui.backend.focused", "route backend lane through the service bus")
    if kaintana_action_activated(session, action_session, backend_button, "ui.backend.focused") == 1:
        active_lane = set_selected_lane(authority, 2)

    let _orbit_axis = pump_axis(action_session, 6.0)
    let orbit_value = kaintana_action_axis_value(action_session, "service.orbit.x")
    let projected_energy = signal_projection(energy)
    let orchestrated_energy = broadcast_pipeline(energy)
    let headline = headline_for_backend(settings.backend, energy, projected_energy)

    let _copy_press = press_key(action_session, "KeyC")
    if kaintana_action_pressed(action_session, "service.clipboard.copy") == 1:
        let _copy = kaintana_clipboard_copy_text(session, headline)
    let _copy_release = release_key(action_session, "KeyC")

    let _ime_begin = kaintana_ime_begin(session, settings_button)
    let _ime_commit = kaintana_ime_commit_text(session, "settings://agent/commit")

    let _menu_press = press_key(action_session, "KeyM")
    if kaintana_action_pressed(action_session, "service.menu.open") == 1:
        let _menu_open = kaintana_menu_open_below_node(session, settings_menu, settings_button, 10.0)
        let _popover_open = kaintana_popover_open(session, settings_button, settings_popover_spec)
    let _menu_release = release_key(action_session, "KeyM")

    let dialog_id = 0
    let _dialog_press = press_key(action_session, "KeyD")
    if kaintana_action_pressed(action_session, "service.dialog.request") == 1:
        dialog_id = kaintana_dialog_request(session, "confirm", "Commit Layout Snapshot", headline)
        let _dialog_response = kaintana_dialog_respond(session, dialog_id, 7, "accepted")
    dialog_result = kaintana_dialog_poll_response(session)
    let _dialog_release = release_key(action_session, "KeyD")
    let _focus_restore = kaintana_focus_node(session, settings_button)

    let _tool_title = kaintana_retained_label(session, tool_panel, "tool.title", "OPERATORS", kaintana_rect(tool_inner.x, tool_inner.y - 18.0, tool_inner.width, 24.0), theme, badge_font, 18.0)
    let _tool_select = kaintana_immediate_toolbar_button(session, tool_panel, "tool.select", "Select", kaintana_column_slot(tool_inner, 0.0, 42.0, 10.0), theme, micro_font, 24.0)
    let _tool_move = kaintana_immediate_toolbar_button(session, tool_panel, "tool.move", "Move", kaintana_column_slot(tool_inner, 1.0, 42.0, 10.0), theme, micro_font, 24.0)
    let _tool_orbit = kaintana_immediate_toolbar_button(session, tool_panel, "tool.orbit", "Orbit", kaintana_column_slot(tool_inner, 2.0, 42.0, 10.0), theme, micro_font, 24.0)
    let _tool_node = kaintana_immediate_toolbar_button(session, tool_panel, "tool.node", "Node", kaintana_column_slot(tool_inner, 3.0, 42.0, 10.0), theme, micro_font, 24.0)
    let _tool_graph = kaintana_immediate_toolbar_button(session, tool_panel, "tool.graph", "Graph", kaintana_column_slot(tool_inner, 4.0, 42.0, 10.0), theme, micro_font, 24.0)
    let _tool_render = kaintana_immediate_toolbar_button(session, tool_panel, "tool.render", "Render", kaintana_column_slot(tool_inner, 5.0, 42.0, 10.0), theme, micro_font, 24.0)
    let _tool_note = kaintana_retained_muted_label(session, tool_panel, "tool.note", "DCC lane: tools, viewport, inspector, services.", kaintana_rect(tool_inner.x, tool_inner.y + 316.0, tool_inner.width, 52.0), theme, micro_font, 14.0)

    let _hero_title = kaintana_retained_label(session, viewport_surface, "hero.title", "UI FRAMEWORK // CONTROL DECK", kaintana_rect(viewport_inner.x, viewport_inner.y, viewport_inner.width, 32.0), theme, title_font, 24.0)
    let _hero_subtitle = kaintana_retained_muted_label(session, viewport_surface, "hero.subtitle", "Menus, sliders, keypad, host services, traces.", kaintana_rect(viewport_inner.x, viewport_inner.y + 38.0, viewport_inner.width, 28.0), theme, micro_font, 15.0)
    let _hero_signal = kaintana_retained_label(session, viewport_surface, "hero.signal", headline, kaintana_rect(viewport_inner.x, viewport_inner.y + 78.0, viewport_inner.width, 24.0), theme, body_font, 18.0)
    let waveform_rect = kaintana_rect(viewport_inner.x, viewport_inner.y + 116.0, viewport_inner.width - 20.0, 166.0)
    let _wave_back = kaintana_primitive_fill(session, viewport_surface, "wave.back", waveform_rect, theme.shell_red, theme.shell_green, theme.shell_blue)
    let _wave_bar_0 = kaintana_primitive_fill(session, viewport_surface, "wave.bar.0", kaintana_rect(waveform_rect.x + 20.0, waveform_rect.y + 108.0, 56.0, 56.0), theme.signal_red, theme.signal_green, theme.signal_blue)
    let _wave_bar_1 = kaintana_primitive_fill(session, viewport_surface, "wave.bar.1", kaintana_rect(waveform_rect.x + 96.0, waveform_rect.y + 72.0, 56.0, 92.0), theme.accent_red, theme.accent_green, theme.accent_blue)
    let _wave_bar_2 = kaintana_primitive_fill(session, viewport_surface, "wave.bar.2", kaintana_rect(waveform_rect.x + 172.0, waveform_rect.y + 42.0, 56.0, 122.0), theme.signal_red, theme.signal_green, theme.signal_blue)
    let _wave_bar_3 = kaintana_primitive_fill(session, viewport_surface, "wave.bar.3", kaintana_rect(waveform_rect.x + 248.0, waveform_rect.y + 90.0, 56.0, 74.0), theme.accent_red, theme.accent_green, theme.accent_blue)
    let _wave_bar_4 = kaintana_primitive_fill(session, viewport_surface, "wave.bar.4", kaintana_rect(waveform_rect.x + 324.0, waveform_rect.y + 28.0, 56.0, 136.0), theme.signal_red, theme.signal_green, theme.signal_blue)
    let _wave_bar_5 = kaintana_primitive_fill(session, viewport_surface, "wave.bar.5", kaintana_rect(waveform_rect.x + 400.0, waveform_rect.y + 84.0, 56.0, 80.0), theme.accent_red, theme.accent_green, theme.accent_blue)
    let _wave_bar_6 = kaintana_primitive_fill(session, viewport_surface, "wave.bar.6", kaintana_rect(waveform_rect.x + 476.0, waveform_rect.y + 56.0, 56.0, 108.0), theme.signal_red, theme.signal_green, theme.signal_blue)
    let _wave_bar_7 = kaintana_primitive_fill(session, viewport_surface, "wave.bar.7", kaintana_rect(waveform_rect.x + 552.0, waveform_rect.y + 96.0, 56.0, 68.0), theme.accent_red, theme.accent_green, theme.accent_blue)
