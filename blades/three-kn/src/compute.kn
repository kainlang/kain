// ============================================================================
//  COMPUTE — GPU Compute Shaders for Three-KN
//  Compiled to SPIR-V / HLSL via `kain gpu-artifacts`
// ============================================================================
//
//  Contains all compute shader declarations referenced by the engine:
//    - audio_fft: Cooley-Tukey radix-2 FFT for audio spectrum analysis
//    - pmrem_equirect_to_cubemap: Equirect HDR to cubemap conversion
//    - pmrem_ggx_vndf: GGX VNDF importance sampling for env map prefiltering
//    - pmrem_irradiance: Irradiance convolution for diffuse IBL
//
//  NOTE: These shaders use GPU-specific keywords (shared_mem, workgroup_barrier)
//  that are only valid during GPU artifact compilation. Regular kain check
//  will report errors for these keywords — this is expected.
// ============================================================================

// ============================================================================
//  AUDIO FFT — Cooley-Tukey Radix-2
// ============================================================================

shader compute audio_fft(id: UVec3) -> Void workgroup(256, 1, 1):
    uniform input_buffer: StorageBuffer<Float> @0
    uniform output_buffer: StorageBuffer<Float> @1
    uniform fft_size: UInt @2
    uniform window_type: UInt @3

    comptime:
        let compute = (
            [256, 1, 1],
            [
                ("input_buffer", "f32", ["fft_size"], "input", "kain.shared.buffer"),
                ("output_buffer", "f32", ["fft_size / 2"], "output", "kain.shared.buffer"),
                ("fft_size", "u32", [1], "uniform", "kain.uniform"),
                ("window_type", "u32", [1], "uniform", "kain.uniform"),
            ],
            [],
        )

    shared_mem Float s_real[256]
    shared_mem Float s_imag[256]
    let lane: Int = id.x
    let N: Int = fft_size
    if lane < N:
        let window: Float = 0.5 * (1.0 - cos(6.283185 * lane / (N - 1)))
        s_real[lane] = input_buffer[lane] * window
        s_imag[lane] = 0.0
    workgroup_barrier()
    let rev: Int = bit_reverse(lane, N)
    if lane < rev:
        let tmp_r: Float = s_real[lane]
        let tmp_i: Float = s_imag[lane]
        s_real[lane] = s_real[rev]
        s_imag[lane] = s_imag[rev]
        s_real[rev] = tmp_r
        s_imag[rev] = tmp_i
    workgroup_barrier()
    var s: Int = 1
    while s < N:
        let stride: Int = s * 2
        var sub_fft: Int = 0
        while sub_fft < N:
            let group: Int = lane - sub_fft
            if group >= 0 and group < s:
                let even_idx: Int = sub_fft + group
                let odd_idx: Int = even_idx + s
                let twiddle: Float = -6.283185 * group / stride
                let cos_t: Float = cos(twiddle)
                let sin_t: Float = sin(twiddle)
                let re_odd: Float = s_real[odd_idx] * cos_t - s_imag[odd_idx] * sin_t
                let im_odd: Float = s_real[odd_idx] * sin_t + s_imag[odd_idx] * cos_t
                let tmp_re: Float = s_real[even_idx]
                let tmp_im: Float = s_imag[even_idx]
                s_real[even_idx] = tmp_re + re_odd
                s_imag[even_idx] = tmp_im + im_odd
                s_real[odd_idx] = tmp_re - re_odd
                s_imag[odd_idx] = tmp_im - im_odd
            sub_fft = sub_fft + stride
        workgroup_barrier()
        s = s * 2
    if lane < N / 2:
        let re_f: Float = s_real[lane]
        let im_f: Float = s_imag[lane]
        output_buffer[lane] = sqrt(re_f * re_f + im_f * im_f)
    return

// ============================================================================
//  BIT-REVERSAL HELPER
// ============================================================================

fn bit_reverse(value: Int, max_val: Int) -> Int with Pure:
    var v: Int = value
    var result: Int = 0
    var bits: Int = 0
    var tmp: Int = max_val
    while tmp > 1:
        tmp = tmp / 2
        bits = bits + 1
    var i: Int = 0
    while i < bits:
        result = (result << 1) | (v & 1)
        v = v >> 1
        i = i + 1
    return result
