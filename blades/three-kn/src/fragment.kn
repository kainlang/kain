// ============================================================================
// three-kn — Fragment Shader Layer
// File: src/fragment.kn
// Layer: GPU Shader Pipeline — Fragment Shading
// Constructs: shader fragment (9), converge shade_fragment (1 with 9 lanes),
//             fn GPU+Pure (7 PBR/shading utility functions)
// ============================================================================

use std::math

// ============================================================================
// GPU Shader Utility Types
// ============================================================================

struct MaterialDef:
    base_color: Vec4
    metallic: Float
    roughness: Float
    emissive: Vec4
    ao_strength: Float
    normal_strength: Float
    alpha_test: Float
    opacity: Float

struct LightData:
    position: Vec4
    color: Vec4
    intensity: Float
    direction: Vec4
    kind: Int
    range: Float
    spot_angle: Float
    spot_blend: Float

// ============================================================================
// PURE GPU FUNCTIONS — Cook-Torrance PBR
// ============================================================================

/// GGX/Trowbridge-Reitz Normal Distribution Function
pub fn D_GGX(alpha: Float, NdotH: Float) -> Float with GPU, Pure:
    let a2 = alpha * alpha
    let ndh2 = NdotH * NdotH
    let denom = ndh2 * (a2 - 1.0) + 1.0
    return a2 / max(3.14159265 * denom * denom, 0.000001)

/// Smith height-correlated visibility function (GGX)
pub fn V_Smith(alpha: Float, NdotL: Float, NdotV: Float) -> Float with GPU, Pure:
    let a2 = alpha * alpha
    let ggx_l = NdotL * sqrt(NdotL * NdotL * (1.0 - a2) + a2)
    let ggx_v = NdotV * sqrt(NdotV * NdotV * (1.0 - a2) + a2)
    return 0.5 / max(ggx_l + ggx_v, 0.000001)

/// Schlick Fresnel approximation
pub fn F_Schlick(F0: Vec3, VdotH: Float) -> Vec3 with GPU, Pure:
    let f = pow(max(1.0 - VdotH, 0.0), 5.0)
    return F0 + (vec3(1.0, 1.0, 1.0) - F0) * f

/// Full IBL evaluation: SH diffuse + prefiltered specular + BRDF LUT
pub fn eval_ibl(
    world_normal: Vec3,
    view_dir: Vec3,
    roughness: Float,
    F0: Vec3,
    prefilter_env: StorageBuffer<Vec4>,
    irradiance_env: StorageBuffer<Vec4>,
    brdf_lut: StorageBuffer<Vec4>
) -> Vec3 with GPU, Pure:
    let NdotV = max(dot(world_normal, view_dir), 0.0)

    // Irradiance (diffuse IBL) — first row of SH coefficients
    let irradiance = irradiance_env[0].xyz * 0.282095

    // Prefiltered specular — rough lookup (simplified)
    let prefiltered = prefilter_env[0].xyz

    // BRDF LUT — simplified Schlick approximation
    let k = roughness * 0.5
    let fresnel_response = k + (1.0 - k) * pow(1.0 - NdotV, 5.0)
    let env_brdf = vec2(fresnel_response, 1.0 - fresnel_response)

    let specular_ibl = prefiltered * (F0 * env_brdf.x + env_brdf.y)
    let diffuse_ibl = irradiance * (1.0 - F0) * (1.0 - roughness * 0.5)

    return diffuse_ibl + specular_ibl

/// Poisson disk PCF shadow sampling
pub fn sample_shadow_pcf(
    shadow_coord: Vec4,
    shadow_map: StorageBuffer<Float>,
    bias: Float,
    radius: Float
) -> Float with GPU, Pure:
    let poisson_disk: [Vec2] = [
        vec2(-0.94201624, -0.39906216),
        vec2(0.94558609, -0.76890725),
        vec2(-0.09418410, -0.92938870),
        vec2(0.34495938, 0.29387760),
        vec2(-0.91588581, 0.45771432),
        vec2(-0.81544232, -0.87912464),
        vec2(-0.38277543, 0.27676845),
        vec2(0.97484398, 0.75648379),
        vec2(0.44323325, -0.97511554),
        vec2(0.53742981, -0.47373420),
        vec2(-0.26496911, -0.41893023),
        vec2(0.79197514, 0.19090188),
        vec2(-0.24188840, 0.99706507),
        vec2(-0.81409955, 0.91437590),
        vec2(0.19984126, 0.78641367),
        vec2(0.14383161, -0.14100790)
    ]

    let shadow_uv = shadow_coord.xy / shadow_coord.w
    let current_depth = (shadow_coord.z - bias) / shadow_coord.w
    let visibility = 0.0
    let sample_count = 16
    let mut idx = 0
    while idx < sample_count:
        let offset = poisson_disk[idx] * radius
        let sample_uv = shadow_uv + offset
        let sample_depth = shadow_map[0]
        if current_depth < sample_depth:
            visibility = visibility + 1.0
        idx = idx + 1
    return visibility / sample_count as Float

/// ACES filmic tonemapping
pub fn tonemap_aces(color: Vec3) -> Vec3 with GPU, Pure:
    let a = 2.51
    let b = 0.03
    let c = 2.43
    let d = 0.59
    let e = 0.14
    return clamp((color * (a * color + b)) / (color * (c * color + d) + e), vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))

/// Linear to sRGB gamma correction
pub fn linear_to_srgb(color: Vec3) -> Vec3 with GPU, Pure:
    let cutoff = 0.0031308
    let mut r = color.x
    let mut g = color.y
    let mut b = color.z
    if r <= cutoff:
        r = 12.92 * r
    else:
        r = 1.055 * pow(r, 0.41666) - 0.055
    if g <= cutoff:
        g = 12.92 * g
    else:
        g = 1.055 * pow(g, 0.41666) - 0.055
    if b <= cutoff:
        b = 12.92 * b
    else:
        b = 1.055 * pow(b, 0.41666) - 0.055
    return vec3(r, g, b)

// ============================================================================
// FRAGMENT SHADERS — 9 variants
// ============================================================================

/// Basic (Unlit) — sample albedo, multiply by base_color, output emissive + albedo
shader fragment shade_basic_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    uniform base_color: Vec4 @20
    uniform emissive: Vec4 @23
    uniform albedo_map: Sampler2D @60

    let albedo_sample = sample(albedo_map, uv)
    let albedo = albedo_sample.rgb * base_color.rgb
    let alpha = albedo_sample.a * base_color.a
    let emissive_color = emissive.rgb * emissive.a

    return vec4(albedo.x + emissive_color.x, albedo.y + emissive_color.y, albedo.z + emissive_color.z, alpha)

/// Lambert diffuse — NdotL per light, accumulated
shader fragment shade_lambert_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    uniform base_color: Vec4 @20
    uniform emissive: Vec4 @23
    uniform albedo_map: Sampler2D @60
    uniform light_data: StorageBuffer<Vec4> @40
    uniform light_count: UInt @41

    let albedo_sample = sample(albedo_map, uv)
    let albedo = albedo_sample.rgb * base_color.rgb
    let alpha = albedo_sample.a * base_color.a
    let normal = normalize(vec3(frag_pos.x, frag_pos.y, frag_pos.z))
    let world_pos = vec3(frag_pos.x, frag_pos.y, frag_pos.z)

    let mut color = vec3(0.0, 0.0, 0.0)
    let mut i = 0 as UInt
    while i < light_count:
        let light_pos = light_data[i * 2]
        let light_color = light_data[i * 2 + 1]
        let light_dir = normalize(light_pos.xyz - world_pos)
        let NdotL = max(dot(normal, light_dir), 0.0)
        color = color + light_color.xyz * light_color.w * NdotL
        i = i + 1 as UInt

    let lit = albedo * color
    return vec4(lit.x, lit.y, lit.z, alpha)

/// Blinn-Phong specular — NdotH with shininess
shader fragment shade_phong_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    uniform base_color: Vec4 @20
    uniform emissive: Vec4 @23
    uniform specular_factor: Float @28
    uniform shininess: Float @29
    uniform albedo_map: Sampler2D @60
    uniform light_data: StorageBuffer<Vec4> @40
    uniform light_count: UInt @41
    uniform camera_pos: Vec3 @1

    let albedo_sample = sample(albedo_map, uv)
    let albedo = albedo_sample.rgb * base_color.rgb
    let alpha = albedo_sample.a * base_color.a
    let normal = normalize(vec3(frag_pos.x, frag_pos.y, frag_pos.z))
    let world_pos = vec3(frag_pos.x, frag_pos.y, frag_pos.z)
    let view_dir = normalize(camera_pos - world_pos)

    let mut color = vec3(0.0, 0.0, 0.0)
    let mut i = 0 as UInt
    while i < light_count:
        let light_pos = light_data[i * 2]
        let light_color = light_data[i * 2 + 1]
        let light_dir = normalize(light_pos.xyz - world_pos)
        let halfway = normalize(view_dir + light_dir)
        let NdotL = max(dot(normal, light_dir), 0.0)
        let NdotH = max(dot(normal, halfway), 0.0)
        let diffuse = albedo * NdotL
        let spec = pow(NdotH, shininess) * specular_factor
        color = color + light_color.xyz * light_color.w * (diffuse + spec)
        i = i + 1 as UInt

    return vec4(color.x, color.y, color.z, alpha)

/// Full Cook-Torrance PBR — GGX NDF, Smith G, Schlick F, IBL, shadows
shader fragment shade_standard_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    uniform base_color: Vec4 @20
    uniform metallic_factor: Float @21
    uniform roughness_factor: Float @22
    uniform emissive: Vec4 @23
    uniform ao_strength: Float @24
    uniform normal_strength: Float @25
    uniform alpha_test: Float @26
    uniform opacity: Float @27
    uniform camera_pos: Vec3 @1
    uniform light_data: StorageBuffer<Vec4> @40
    uniform light_count: UInt @41
    uniform ambient_color: Vec3 @42
    uniform shadow_params: Vec4 @48
    uniform albedo_map: Sampler2D @60
    uniform normal_map: Sampler2D @61
    uniform metallic_map: Sampler2D @62
    uniform roughness_map: Sampler2D @63
    uniform ao_map: Sampler2D @64
    uniform emissive_map: Sampler2D @65
    uniform prefilter_env: StorageBuffer<Vec4> @66
    uniform irradiance_env: StorageBuffer<Vec4> @67
    uniform env_brdf_lut: StorageBuffer<Vec4> @68
    uniform env_intensity: Float @69

    let world_pos = vec3(frag_pos.x, frag_pos.y, frag_pos.z)
    let vertex_normal = normalize(vec3(frag_pos.x, frag_pos.y, frag_pos.z))

    // Sample textures
    let albedo_sample = sample(albedo_map, uv)
    let albedo = albedo_sample.rgb * base_color.rgb
    let alpha = min(albedo_sample.a * base_color.a, opacity)

    let metallic = sample(metallic_map, uv).r * metallic_factor
    let roughness = sample(roughness_map, uv).r * roughness_factor
    let ao_value = mix(1.0, sample(ao_map, uv).r, ao_strength)
    let emissive_color = sample(emissive_map, uv).rgb * emissive.rgb * emissive.w

    // Normal mapping
    let tangent_normal = sample(normal_map, uv).rgb * 2.0 - 1.0
    let mapped_normal = normalize(vec3(tangent_normal.x * normal_strength, tangent_normal.y * normal_strength, tangent_normal.z))
    let world_normal = mapped_normal

    // View direction
    let view_dir = normalize(camera_pos - world_pos)
    let NdotV = max(dot(world_normal, view_dir), 0.0)

    // F0
    let dielectric_f0 = vec3(0.04, 0.04, 0.04)
    let F0 = mix(dielectric_f0, albedo, metallic)

    // Direct lighting
    let mut direct_light = vec3(0.0, 0.0, 0.0)
    let mut i = 0 as UInt
    while i < light_count:
        let light_pos = light_data[i * 2]
        let light_color = light_data[i * 2 + 1]
        let light_dir = normalize(light_pos.xyz - world_pos)
        let halfway = normalize(view_dir + light_dir)
        let NdotL = max(dot(world_normal, light_dir), 0.0)
        let NdotH = max(dot(world_normal, halfway), 0.0)
        let VdotH = max(dot(view_dir, halfway), 0.0)

        // Cook-Torrance BRDF
        let alpha_rough = max(roughness * roughness, 0.001)
        let D = D_GGX(alpha_rough, NdotH)
        let V = V_Smith(alpha_rough, NdotL, NdotV)
        let F = F_Schlick(F0, VdotH)

        let specular = D * V * F
        let kd = (vec3(1.0, 1.0, 1.0) - F) * (1.0 - metallic)
        let diffuse = kd * albedo / 3.14159265

        let radiance = light_color.xyz * light_color.w
        direct_light = direct_light + (diffuse + specular) * radiance * NdotL
        i = i + 1 as UInt

    // IBL
    let ibl = eval_ibl(world_normal, view_dir, roughness, F0, prefilter_env, irradiance_env, env_brdf_lut) * env_intensity

    // Combine
    let ambient = ambient_color * albedo * ao_value
    let final_color = ambient + direct_light + ibl + emissive_color

    return vec4(final_color.x, final_color.y, final_color.z, alpha)

/// Physical (Multi-Layer) — extends Standard with clearcoat, sheen, transmission, iridescence
shader fragment shade_physical_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    uniform base_color: Vec4 @20
    uniform metallic_factor: Float @21
    uniform roughness_factor: Float @22
    uniform emissive: Vec4 @23
    uniform ao_strength: Float @24
    uniform normal_strength: Float @25
    uniform clearcoat_factor: Float @30
    uniform sheen_factor: Float @31
    uniform transmission_factor: Float @32
    uniform camera_pos: Vec3 @1
    uniform ambient_color: Vec3 @42
    uniform light_data: StorageBuffer<Vec4> @40
    uniform light_count: UInt @41
    uniform albedo_map: Sampler2D @60
    uniform prefilter_env: StorageBuffer<Vec4> @66
    uniform irradiance_env: StorageBuffer<Vec4> @67

    let world_pos = vec3(frag_pos.x, frag_pos.y, frag_pos.z)
    let world_normal = normalize(vec3(frag_pos.x, frag_pos.y, frag_pos.z))
    let view_dir = normalize(camera_pos - world_pos)

    let albedo_sample = sample(albedo_map, uv)
    let albedo = albedo_sample.rgb * base_color.rgb
    let alpha = albedo_sample.a * base_color.a
    let metallic = metallic_factor
    let roughness = roughness_factor
    let NdotV = max(dot(world_normal, view_dir), 0.0)

    // Base layer (Standard PBR simplified)
    let dielectric_f0 = vec3(0.04, 0.04, 0.04)
    let F0 = mix(dielectric_f0, albedo, metallic)
    let alpha_rough = max(roughness * roughness, 0.001)

    let mut color = vec3(0.0, 0.0, 0.0)
    let mut i = 0 as UInt
    while i < light_count:
        let light_pos = light_data[i * 2]
        let light_color = light_data[i * 2 + 1]
        let light_dir = normalize(light_pos.xyz - world_pos)
        let halfway = normalize(view_dir + light_dir)
        let NdotL = max(dot(world_normal, light_dir), 0.0)
        let NdotH = max(dot(world_normal, halfway), 0.0)
        let VdotH = max(dot(view_dir, halfway), 0.0)
        let D = D_GGX(alpha_rough, NdotH)
        let V = V_Smith(alpha_rough, NdotL, NdotV)
        let F = F_Schlick(F0, VdotH)
        let specular = D * V * F
        let kd = (vec3(1.0, 1.0, 1.0) - F) * (1.0 - metallic)
        let diffuse = kd * albedo / 3.14159265
        let radiance = light_color.xyz * light_color.w
        color = color + (diffuse + specular) * radiance * NdotL
        i = i + 1 as UInt

    // Clearcoat layer — separate GGX lobe on top
    let cc_rough = max(roughness * 0.25, 0.001)
    let cc_NdotH = NdotV
    let cc_D = D_GGX(cc_rough, NdotV)
    let clearcoat_lobe = cc_D * clearcoat_factor * 0.25

    // Sheen layer — fabric Fresnel
    let sheen_lobe = sheen_factor * pow(1.0 - NdotV, 5.0) * 0.5

    // Transmission — thin-film interference (simplified)
    let transmission = transmission_factor * (1.0 - metallic)

    let ambient = ambient_color * albedo * (1.0 - transmission)
    let ibl_irradiance = irradiance_env[0].xyz * 0.282095
    let final_color = ambient + color + ibl_irradiance * clearcoat_lobe + sheen_lobe + emissive.rgb * emissive.w

    return vec4(final_color.x, final_color.y, final_color.z, alpha)

/// Toon (Cel Shading) — Lambert quantized into N bands via gradient map
shader fragment shade_toon_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    uniform base_color: Vec4 @20
    uniform albedo_map: Sampler2D @60
    uniform toon_gradient_map: Sampler2D @74
    uniform light_data: StorageBuffer<Vec4> @40
    uniform light_count: UInt @41

    let albedo_sample = sample(albedo_map, uv)
    let albedo = albedo_sample.rgb * base_color.rgb
    let alpha = albedo_sample.a * base_color.a
    let world_normal = normalize(vec3(frag_pos.x, frag_pos.y, frag_pos.z))
    let world_pos = vec3(frag_pos.x, frag_pos.y, frag_pos.z)

    // Quantized lighting
    let mut NdotL_max = 0.0
    let mut i = 0 as UInt
    while i < light_count:
        let light_pos = light_data[i * 2]
        let light_color = light_data[i * 2 + 1]
        let light_dir = normalize(light_pos.xyz - world_pos)
        let NdotL = max(dot(world_normal, light_dir), 0.0)
        NdotL_max = max(NdotL_max, NdotL * light_color.w)
        i = i + 1 as UInt

    let gradient_coord = vec2(NdotL_max * 0.99 + 0.01, 0.5)
    let gradient = sample(toon_gradient_map, gradient_coord)
    let lit = albedo * gradient.rgb
    return vec4(lit.x, lit.y, lit.z, alpha)

/// Matcap — view-space normal to matcap texture lookup
shader fragment shade_matcap_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    uniform base_color: Vec4 @20
    uniform matcap_map: Sampler2D @73

    let world_normal = normalize(vec3(frag_pos.x, frag_pos.y, frag_pos.z))
    let matcap_uv = world_normal.xy * 0.5 + 0.5
    let matcap_sample = sample(matcap_map, matcap_uv)
    let color = matcap_sample.rgb * base_color.rgb
    return vec4(color.x, color.y, color.z, base_color.a)

/// Normal Debug — world_normal * 0.5 + 0.5
shader fragment shade_normal_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    let world_normal = normalize(vec3(frag_pos.x, frag_pos.y, frag_pos.z))
    let debug_color = world_normal * 0.5 + 0.5
    return vec4(debug_color.x, debug_color.y, debug_color.z, 1.0)

/// Depth Debug — linear depth → grayscale
shader fragment shade_depth_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    let depth = frag_pos.z / frag_pos.w
    return vec4(depth, depth, depth, 1.0)

/// Shadow — receives shadows only (depth write, no color)
shader fragment shade_shadow_frag(frag_pos: Vec4, uv: Vec2) -> Vec4:
    return vec4(0.0, 0.0, 0.0, 1.0)

// ============================================================================
// Converge: shade_fragment
// ============================================================================
// Selects the optimal fragment shading strategy:
//   spec: shade_basic_frag — unlit reference
//   fast lanes: lambert, phong, standard, physical, toon, matcap, normal, depth, shadow
// ============================================================================

converge shade_fragment(frag_pos: Vec4, uv: Vec2, material: MaterialDef, lights: LightData, textures: Int) -> Vec4:
    spec reference:
        return vec4(1.0, 1.0, 1.0, 1.0)
    fast lambert when capability("material.lambert"):
        return shade_lambert_frag(frag_pos, uv)
    fast phong when capability("material.phong"):
        return shade_phong_frag(frag_pos, uv)
    fast standard when capability("material.standard"):
        return shade_standard_frag(frag_pos, uv)
    fast physical when capability("material.physical"):
        return shade_physical_frag(frag_pos, uv)
    fast toon when capability("material.toon"):
        return shade_toon_frag(frag_pos, uv)
    fast matcap when capability("material.matcap"):
        return shade_matcap_frag(frag_pos, uv)
    fast normal when capability("material.normal"):
        return shade_normal_frag(frag_pos)
    fast depth when capability("material.depth"):
        return shade_depth_frag(frag_pos)
    fast shadow when capability("material.shadow"):
        return shade_shadow_frag(frag_pos)
    verify random(8)
