// ============================================================================
//  BACKEND — Graphics Backend Selection
//  Layer 6 (axiom) + Layer 3 (converge)
// ============================================================================
//
//  Four axiom declarations, one per graphics API, each declaring the required
//  machine capabilities. converge select_backend() selects at runtime.
//
//  CONSTANTS for backend identifiers passed to std::graphics::backend_select().
// ============================================================================

use std::runtime

// ============================================================================
//  BACKEND IDENTIFIER CONSTANTS
// ============================================================================

const GRAPHICS_BACKEND_AUTO: String = "auto"
const GRAPHICS_BACKEND_VULKAN: String = "vulkan"
const GRAPHICS_BACKEND_DX12: String = "dx12"
const GRAPHICS_BACKEND_METAL: String = "metal"
const GRAPHICS_BACKEND_WEBGPU: String = "webgpu"

// ============================================================================
//  AXIOM DECLARATIONS
// ============================================================================

/// Vulkan 1.3 backend with push constants, descriptor indexing, and compute
axiom vulkan_supported:
    when target("llvm")
    when capability("gfx.vulkan")
    when capability("gpu.compute")
    guarantee "Vulkan 1.3: push constants, descriptor indexing, compute dispatch"
    fallback check_dx12

/// DirectX 12 Ultimate with DXR raytracing, mesh shaders, and compute
axiom dx12_supported:
    when target("llvm")
    when capability("gfx.dx12")
    when capability("gpu.compute")
    guarantee "DirectX 12 Ultimate: raytracing, mesh shaders, compute"
    fallback check_metal

/// Metal 3 with argument buffers, GPU-driven rendering, and compute
axiom metal_supported:
    when target("llvm")
    when capability("gfx.metal")
    when capability("gpu.compute")
    guarantee "Metal 3: argument buffers, GPU-driven rendering, compute"
    fallback check_webgpu

/// WebGPU with WGSL shaders, bind groups, and compute pass
axiom webgpu_supported:
    when target("llvm")
    when capability("gfx.webgpu")
    when capability("gpu.compute")
    guarantee "WebGPU: WGSL shaders, bind groups, compute pass"
    fallback check_software

// ============================================================================
//  FALLBACK FUNCTIONS
// ============================================================================

fn check_dx12() -> String:
    /// Fallback from Vulkan: try DX12, then Metal, then WebGPU, then software.
    let dx12_ready: Int = runtime_cpu_has_capability("gfx.dx12")
    if dx12_ready != 0:
        return GRAPHICS_BACKEND_DX12
    let metal_ready: Int = runtime_cpu_has_capability("gfx.metal")
    if metal_ready != 0:
        return GRAPHICS_BACKEND_METAL
    let webgpu_ready: Int = runtime_cpu_has_capability("gfx.webgpu")
    if webgpu_ready != 0:
        return GRAPHICS_BACKEND_WEBGPU
    return GRAPHICS_BACKEND_AUTO

fn check_metal() -> String:
    /// Fallback from DX12: try Metal, then WebGPU, then software.
    let metal_ready: Int = runtime_cpu_has_capability("gfx.metal")
    if metal_ready != 0:
        return GRAPHICS_BACKEND_METAL
    let webgpu_ready: Int = runtime_cpu_has_capability("gfx.webgpu")
    if webgpu_ready != 0:
        return GRAPHICS_BACKEND_WEBGPU
    return GRAPHICS_BACKEND_AUTO

fn check_webgpu() -> String:
    /// Fallback from Metal: try WebGPU, then software.
    let webgpu_ready: Int = runtime_cpu_has_capability("gfx.webgpu")
    if webgpu_ready != 0:
        return GRAPHICS_BACKEND_WEBGPU
    return GRAPHICS_BACKEND_AUTO

fn check_software() -> String:
    /// Ultimate fallback: let the runtime decide.
    return GRAPHICS_BACKEND_AUTO

// ============================================================================
//  CONVERGE SELECT BACKEND
// ============================================================================

/// Select the best graphics backend for the current machine.
/// Spec: return AUTO and let the runtime decide.
/// Fast lanes: try each backend when the capability is available.
converge select_backend() -> String:
    spec reference:
        return GRAPHICS_BACKEND_AUTO

    fast vulkan_lane when capability("gfx.vulkan"):
        return GRAPHICS_BACKEND_VULKAN

    fast dx12_lane when capability("gfx.dx12"):
        return GRAPHICS_BACKEND_DX12

    fast metal_lane when capability("gfx.metal"):
        return GRAPHICS_BACKEND_METAL

    fast webgpu_lane when capability("gfx.webgpu"):
        return GRAPHICS_BACKEND_WEBGPU

    verify random(1)

// ============================================================================
//  UNIT TEST
// ============================================================================

fn test_select_backend() -> Int with Pure:
    /// Test that select_backend returns a valid backend string.
    let backend: String = select_backend()
    if backend == GRAPHICS_BACKEND_AUTO:
        return 1
    if backend == GRAPHICS_BACKEND_VULKAN:
        return 1
    if backend == GRAPHICS_BACKEND_DX12:
        return 1
    if backend == GRAPHICS_BACKEND_METAL:
        return 1
    if backend == GRAPHICS_BACKEND_WEBGPU:
        return 1
    return 0
