// ============================================================================
//  HELPERS — Debug Visualization Components
//  Layer UI (component) — JSX components for 3D debug visualization
// ============================================================================
//
//  11 helper components that generate geometry + metadata for the
//  3D debug visualization system. Each component renders a panel
//  describing the current state; actual line rendering is handled
//  by the GPU pipeline.
// ============================================================================

use std::math

// ============================================================================
//  COMPONENT — AxesHelper
// ============================================================================

component AxesHelper(length: Float = 1.0):
    fn label_text(_self: Self_) -> String:
        return "AxesHelper length=" + str(_self.length)

    render <panel title="AxesHelper">
        <text value={label_text()} />
    </panel>

// ============================================================================
//  COMPONENT — GridHelper
// ============================================================================

component GridHelper(size: Float = 10.0, divisions: Int = 10):

    fn grid_label(_self: Self_) -> String:
        return "GridHelper size=" + str(_self.size) + " div=" + str(_self.divisions)

    render <panel title="GridHelper">
        <text value={grid_label()} />
    </panel>

// ============================================================================
//  COMPONENT — BoxHelper
// ============================================================================

component BoxHelper(box_min: Vec3, box_max: Vec3):

    fn box_label(_self: Self_) -> String:
        return "BoxHelper"

    render <panel title="BoxHelper">
        <text value={box_label()} />
    </panel>

// ============================================================================
//  COMPONENT — CameraHelper
// ============================================================================

component CameraHelper(frustum_near: Float = 0.1, frustum_far: Float = 100.0):

    fn cam_label(_self: Self_) -> String:
        return "CameraHelper near=" + str(_self.frustum_near) + " far=" + str(_self.frustum_far)

    render <panel title="CameraHelper">
        <text value={cam_label()} />
    </panel>

// ============================================================================
//  COMPONENT — ArrowHelper
// ============================================================================

component ArrowHelper(direction: Vec3, origin: Vec3, length: Float = 1.0, head_length: Float = 0.2, head_width: Float = 0.1):

    fn arrow_label(_self: Self_) -> String:
        return "ArrowHelper len=" + str(_self.length)

    render <panel title="ArrowHelper">
        <text value={arrow_label()} />
    </panel>

// ============================================================================
//  COMPONENT — DirectionalLightHelper
// ============================================================================

component DirectionalLightHelper(light_position: Vec3, light_direction: Vec3):

    fn dir_label(_self: Self_) -> String:
        return "DirectionalLightHelper"

    render <panel title="DirectionalLightHelper">
        <text value={dir_label()} />
    </panel>

// ============================================================================
//  COMPONENT — PointLightHelper
// ============================================================================

component PointLightHelper(light_position: Vec3):

    fn pt_label(_self: Self_) -> String:
        return "PointLightHelper"

    render <panel title="PointLightHelper">
        <text value={pt_label()} />
    </panel>

// ============================================================================
//  COMPONENT — SpotLightHelper
// ============================================================================

component SpotLightHelper(light_position: Vec3, light_direction: Vec3, outer_angle: Float = 0.5236, range_val: Float = 10.0):

    fn spot_label(_self: Self_) -> String:
        return "SpotLightHelper angle=" + str(_self.outer_angle)

    render <panel title="SpotLightHelper">
        <text value={spot_label()} />
    </panel>

// ============================================================================
//  COMPONENT — HemisphereLightHelper
// ============================================================================

component HemisphereLightHelper(light_position: Vec3, size: Float = 1.0):

    fn hemi_label(_self: Self_) -> String:
        return "HemisphereLightHelper size=" + str(_self.size)

    render <panel title="HemisphereLightHelper">
        <text value={hemi_label()} />
    </panel>

// ============================================================================
//  COMPONENT — PlaneHelper
// ============================================================================

component PlaneHelper(plane_center: Vec3, plane_normal: Vec3, plane_size: Float = 1.0):

    fn plane_label(_self: Self_) -> String:
        return "PlaneHelper size=" + str(_self.plane_size)

    render <panel title="PlaneHelper">
        <text value={plane_label()} />
    </panel>

// ============================================================================
//  COMPONENT — SkeletonHelper
// ============================================================================

component SkeletonHelper(bone_positions: [Vec3], bone_parents: [Int]):

    fn skel_label(_self: Self_) -> String:
        return "SkeletonHelper bones=" + str(len(_self.bone_positions))

    render <panel title="SkeletonHelper">
        <text value={skel_label()} />
    </panel>

// ============================================================================
//  INITIALIZATION
// ============================================================================

fn init_helpers() -> Int:
    return 0
