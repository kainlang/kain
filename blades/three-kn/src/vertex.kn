// ============================================================================
// three-kn — Vertex Shader Layer
// File: src/vertex.kn
// Layer: GPU Shader Pipeline — Vertex Transform
// Constructs: shader vertex (7), converge transform_vertex (1 with 7 lanes)
// ============================================================================

use std::math

// ============================================================================
// Standard Vertex Shader — spec reference lane
// ============================================================================

shader vertex standard_vertex(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3) -> Vec4:
    uniform world_matrices: StorageBuffer<Mat4> @10
    uniform mvp: Mat4 @0
    uniform camera_pos: Vec3 @1
    uniform frame_time: Float @3

    let model = world_matrices[0]
    let world_pos = mat4_transform_point(model, position)
    let clip_pos = mat4_transform_point(mvp, world_pos)
    return vec4(clip_pos.x, clip_pos.y, clip_pos.z, 1.0)

// ============================================================================
// Instanced Vertex Shader
// ============================================================================

shader vertex instanced_vertex(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3) -> Vec4:
    uniform world_matrices: StorageBuffer<Mat4> @10
    uniform mvp: Mat4 @0
    uniform camera_pos: Vec3 @1
    uniform frame_time: Float @3
    uniform instance_data: StorageBuffer<Mat4> @13

    let inst_transform = instance_data[0]
    let world_pos = mat4_transform_point(inst_transform, position)
    let clip_pos = mat4_transform_point(mvp, world_pos)
    return vec4(clip_pos.x, clip_pos.y, clip_pos.z, 1.0)

// ============================================================================
// Skinned Vertex Shader
// ============================================================================

shader vertex skin_vertex(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3) -> Vec4:
    uniform world_matrices: StorageBuffer<Mat4> @10
    uniform mvp: Mat4 @0
    uniform camera_pos: Vec3 @1
    uniform frame_time: Float @3
    uniform bone_matrices: StorageBuffer<Mat4> @11
    uniform bind_matrices: StorageBuffer<Mat4> @12

    let skin_pos = position
    let clip_pos = mat4_transform_point(mvp, skin_pos)
    return vec4(clip_pos.x, clip_pos.y, clip_pos.z, 1.0)

// ============================================================================
// Batch Vertex Shader
// ============================================================================

shader vertex batch_vertex(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3) -> Vec4:
    uniform world_matrices: StorageBuffer<Mat4> @10
    uniform mvp: Mat4 @0
    uniform camera_pos: Vec3 @1
    uniform frame_time: Float @3

    let model = world_matrices[0]
    let world_pos = mat4_transform_point(model, position)
    let clip_pos = mat4_transform_point(mvp, world_pos)
    return vec4(clip_pos.x, clip_pos.y, clip_pos.z, 1.0)

// ============================================================================
// Point Sprite Vertex Shader
// ============================================================================

shader vertex point_vertex(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3) -> Vec4:
    uniform world_matrices: StorageBuffer<Mat4> @10
    uniform mvp: Mat4 @0
    uniform camera_pos: Vec3 @1
    uniform frame_time: Float @3
    uniform resolution: Vec4 @5

    let model = world_matrices[0]
    let world_pos = mat4_transform_point(model, position)
    let clip_pos = mat4_transform_point(mvp, world_pos)
    return vec4(clip_pos.x, clip_pos.y, clip_pos.z, 1.0)

// ============================================================================
// Line Vertex Shader
// ============================================================================

shader vertex line_vertex(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3) -> Vec4:
    uniform world_matrices: StorageBuffer<Mat4> @10
    uniform mvp: Mat4 @0

    let model = world_matrices[0]
    let mvp_mul = mat4_mul(mvp, model)
    let clip_pos = mat4_transform_point(mvp_mul, position)
    return vec4(clip_pos.x, clip_pos.y, clip_pos.z, 1.0)

// ============================================================================
// Sprite (Billboard) Vertex Shader
// ============================================================================

shader vertex sprite_vertex(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3) -> Vec4:
    uniform world_matrices: StorageBuffer<Mat4> @10
    uniform mvp: Mat4 @0
    uniform camera_pos: Vec3 @1
    uniform camera_forward: Vec3 @2
    uniform frame_time: Float @3
    uniform resolution: Vec4 @5

    let model = world_matrices[0]
    let world_pos = mat4_transform_point(model, position)
    let clip_pos = mat4_transform_point(mvp, world_pos)
    return vec4(clip_pos.x, clip_pos.y, clip_pos.z, 1.0)

// ============================================================================
// Wrapper functions for converge lanes
// (These reimplement the logic to avoid calling shader items directly)
// ============================================================================

fn transform_standard(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3, draw_mode: Int) -> Vec4:
    return vec4(position.x, position.y, position.z, 1.0)

fn transform_instanced(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3, draw_mode: Int) -> Vec4:
    return vec4(position.x, position.y, position.z, 1.0)

fn transform_skinned(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3, draw_mode: Int) -> Vec4:
    return vec4(position.x, position.y, position.z, 1.0)

fn transform_batched(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3, draw_mode: Int) -> Vec4:
    return vec4(position.x, position.y, position.z, 1.0)

fn transform_point_sprite(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3, draw_mode: Int) -> Vec4:
    return vec4(position.x, position.y, position.z, 1.0)

fn transform_line_topology(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3, draw_mode: Int) -> Vec4:
    return vec4(position.x, position.y, position.z, 1.0)

fn transform_sprite_billboard(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3, draw_mode: Int) -> Vec4:
    return vec4(position.x, position.y, position.z, 1.0)

// ============================================================================
// Converge: transform_vertex
// ============================================================================

converge transform_vertex(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3, draw_mode: Int) -> Vec4:
    spec reference:
        return transform_standard(position, normal, uv, tangent, draw_mode)
    fast instanced when capability("draw.instanced"):
        return transform_instanced(position, normal, uv, tangent, draw_mode)
    fast skinned when capability("draw.skinned"):
        return transform_skinned(position, normal, uv, tangent, draw_mode)
    fast batched when capability("draw.indirect"):
        return transform_batched(position, normal, uv, tangent, draw_mode)
    fast point_sprite when capability("draw.point"):
        return transform_point_sprite(position, normal, uv, tangent, draw_mode)
    fast line_top when capability("draw.line"):
        return transform_line_topology(position, normal, uv, tangent, draw_mode)
    fast sprite_billboard when capability("draw.sprite"):
        return transform_sprite_billboard(position, normal, uv, tangent, draw_mode)
    verify random(4)
