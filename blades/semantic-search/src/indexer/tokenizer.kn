    if s == "include":   return true
    if s == "define":    return true
    if s == "ifdef":     return true
    if s == "ifndef":    return true
    if s == "endif":     return true
    if s == "pragma":    return true
    return false

// ============================================================================
//  LANGUAGE-SPECIFIC TOKENIZERS (converge fast lanes)
// ============================================================================

// Rust-aware tokenization.
// Handles: ident, ident::path, 'lifetime, #![attr], macro_name!
fn tokenize_rust(source: String) -> [String]:
    var tokens: [String] = []
    var current: String = ""
    var i: Int = 0
    let n: Int = len(source)
    var in_string: Bool = false
    var in_comment: Bool = false
    var in_line_comment: Bool = false

    while i < n:
        let ch: String = char_at(source, i)
        let next_ch: String = if i + 1 < n: char_at(source, i + 1) else: ""

        // Skip line comments //
        if ch == "/" and next_ch == "/":
            in_line_comment = true
            if len(current) > 0:
                push(tokens, current)
                current = ""
            i = i + 2
            continue

        // End of line comment
        if in_line_comment:
            if ch == "\n":
                in_line_comment = false
            i = i + 1
            continue

        // Skip block comments
        if ch == "/" and next_ch == "*":
            in_comment = true
            i = i + 2
            continue
        if ch == "*" and next_ch == "/" and in_comment:
            in_comment = false
            i = i + 2
            continue
        if in_comment:
            i = i + 1
            continue

        // Strings
        if ch == "\"":
            in_string = in_string == false
            i = i + 1
            continue
        if in_string:
            i = i + 1
            continue

        // Identifier characters
        if is_ident_char(ch):
            current = current + ch
            i = i + 1
            continue

        // : : → Rust path separator — keep as double-colon token
        if ch == ":" and next_ch == ":":
            if len(current) > 0:
                push(tokens, current)
                current = ""
            push(tokens, "::")
            i = i + 2
            continue

        // ' → Rust lifetime starter
        if ch == "'" and is_ident_char(next_ch):
            if len(current) > 0:
                push(tokens, current)
                current = ""
            current = "'"
            i = i + 1
            continue

        // Flush current token on any non-ident char
        if len(current) > 0:
            push(tokens, current)
            current = ""

        i = i + 1

    // Flush remaining
    if len(current) > 0:
        push(tokens, current)

    return tokens

// C-aware tokenization.
// Handles: #include, #define, MACROS, preprocessor directives
fn tokenize_c(source: String) -> [String]:
    var tokens: [String] = []
    var current: String = ""
    var i: Int = 0
    let n: Int = len(source)
    var in_string: Bool = false
    var in_line_comment: Bool = false
    var in_block_comment: Bool = false

    while i < n:
        let ch: String = char_at(source, i)
        let next_ch: String = if i + 1 < n: char_at(source, i + 1) else: ""

        // Line comments
        if ch == "/" and next_ch == "/":
            in_line_comment = true
            if len(current) > 0:
                push(tokens, current)
                current = ""
            i = i + 2
            continue
        if in_line_comment:
            if ch == "\n":
                in_line_comment = false
            i = i + 1
            continue

        // Block comments
        if ch == "/" and next_ch == "*":
            in_block_comment = true
            i = i + 2
            continue
        if ch == "*" and next_ch == "/" and in_block_comment:
            in_block_comment = false
            i = i + 2
            continue
        if in_block_comment:
            i = i + 1
            continue

        // Strings
        if ch == "\"":
            in_string = in_string == false
            i = i + 1
            continue
        if in_string:
            i = i + 1
            continue

        // Preprocessor directives — keep the # prefix
        if ch == "#":
            if len(current) > 0:
                push(tokens, current)
                current = ""
            current = "#"
            i = i + 1
            continue

        // Identifier chars
        if is_ident_char(ch):
            current = current + ch
            i = i + 1
            continue

        // Flush on non-ident
        if len(current) > 0:
            push(tokens, current)
            current = ""

        i = i + 1

    if len(current) > 0:
        push(tokens, current)

    return tokens

// Kain-aware tokenization.
// Handles: :: paths (world::field), @extern, macro_name!
fn tokenize_kain(source: String) -> [String]:
    var tokens: [String] = []
    var current: String = ""
    var i: Int = 0
    let n: Int = len(source)
    var in_string: Bool = false
    var in_comment: Bool = false
    var in_line_comment: Bool = false

    while i < n:
        let ch: String = char_at(source, i)
        let next_ch: String = if i + 1 < n: char_at(source, i + 1) else: ""

        // Line comments
        if ch == "/" and next_ch == "/":
            in_line_comment = true
            if len(current) > 0:
                push(tokens, current)
                current = ""
            i = i + 2
            continue
        if in_line_comment:
            if ch == "\n":
                in_line_comment = false
            i = i + 1
            continue

        // Block comments
        if ch == "/" and next_ch == "*":
            in_comment = true
            i = i + 2
            continue
        if ch == "*" and next_ch == "/" and in_comment:
            in_comment = false
            i = i + 2
            continue
        if in_comment:
            i = i + 1
            continue

        // Strings
        if ch == "\"":
            in_string = in_string == false
            i = i + 1
            continue
        if in_string:
            i = i + 1
            continue

        // Identifier chars
        if is_ident_char(ch):
            current = current + ch
            i = i + 1
            continue

        // :: path separator
        if ch == ":" and next_ch == ":":
            if len(current) > 0:
                push(tokens, current)
                current = ""
            push(tokens, "::")
            i = i + 2
            continue

        // @ attribute prefix
        if ch == "@":
            if len(current) > 0:
                push(tokens, current)
                current = ""
            current = "@"
            i = i + 1
            continue

        // Flush on non-ident
        if len(current) > 0:
            push(tokens, current)
            current = ""

        i = i + 1

    if len(current) > 0:
        push(tokens, current)

    return tokens

// ============================================================================
//  SPEC REFERENCE — Simple Universal Tokenizer
// ============================================================================

fn tokenize_simple(source: String) -> [String]:
    var tokens: [String] = []
    var current: String = ""
    var i: Int = 0
    let n: Int = len(source)

    while i < n:
        let ch: String = char_at(source, i)

        // Alphanumeric or underscore → accumulate
        if is_ident_char(ch):
            current = current + ch
            i = i + 1
            continue

        // Non-ident → flush token
        if len(current) > 0:
            push(tokens, current)
            current = ""

        // Skip whitespace; keep punctuation as single-char tokens
        if is_whitespace(ch) == false:
            push(tokens, ch)

        i = i + 1

    // Flush remaining
    if len(current) > 0:
        push(tokens, current)

    return tokens

// ============================================================================
//  CONVERGE — Language-Aware Tokenizer
// ============================================================================

converge tokenize(source: String, lang: String) -> [String]:
    spec reference:
        return tokenize_simple(source)
    fast rust_lang when target("llvm"):
        if lang == "rust":
            return tokenize_rust(source)
        return tokenize_simple(source)
    fast c_lang when target("llvm"):
        if lang == "c":
            return tokenize_c(source)
        return tokenize_simple(source)
    fast kain_lang when target("llvm"):
        if lang == "kain":
            return tokenize_kain(source)
        return tokenize_simple(source)

// ============================================================================
//  POST-PROCESSING
// ============================================================================

// Normalize tokens: lowercase, strip common affixes
pub fn normalize_term(t: String) -> String:
    return to_lower_simple(t)

// Filter tokens: discard noise like single chars, pure numbers, short tokens
pub fn is_valid_term(t: String) -> Bool:
    let n: Int = len(t)
    if n < 2:
        return false
    if n > 128:
        return false
    // Skip pure numeric tokens
    var all_digits: Bool = true
    var i: Int = 0
    while i < n:
        let ch: String = char_at(t, i)
        if ch < "0" or ch > "9":
            all_digits = false
            i = n
        i = i + 1
    if all_digits:
        return false
    return true

// Full tokenize + normalize + filter pipeline
pub fn extract_terms(source: String, lang: String) -> [String]:
    let raw_tokens: [String] = tokenize(source, lang)
    var terms: [String] = []
    var i: Int = 0
    while i < len(raw_tokens):
        let t: String = normalize_term(raw_tokens[i])
        if is_valid_term(t):
            push(terms, t)
        i = i + 1
    return terms

// ============================================================================
//  AXIOM — Fast Tokenizer Capability Assumption
// ============================================================================

axiom fast_tokenizer:
    when target("llvm")
    when capability("cpu.scalar")
    guarantee "tokenizer fast lanes produce correct results on valid UTF-8 input"
    fallback tokenize_simple
