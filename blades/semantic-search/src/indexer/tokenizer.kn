// ============================================================================
//  indexer/tokenizer.kn — Language-Aware Tokenizer
//
//  Layer 3: converge with language-specific fast lanes for term extraction.
//
//  Spec reference: simple split on whitespace/punctuation (universal).
//  Fast lanes: Rust-aware (identifiers, :::: paths, lifetimes), C-aware
//  (#include, macros, preprocessor), Kain-aware (keywords, :: paths).
//
//  verify random(64) proves fast lanes agree with spec on random inputs.
// ============================================================================

use util

// ============================================================================
//  KAIN KEYWORDS — for Kain-aware tokenization
// ============================================================================

fn is_kain_keyword(s: String) -> Bool:
    // Core keywords
    if s == "fn":       return true
    if s == "let":      return true
    if s == "mut":      return true
    if s == "var":      return true
    if s == "const":    return true
    if s == "if":       return true
    if s == "elif":     return true
    if s == "else":     return true
    if s == "match":    return true
    if s == "for":      return true
    if s == "while":    return true
    if s == "loop":     return true
    if s == "break":    return true
    if s == "continue": return true
    if s == "return":   return true
    if s == "defer":    return true
    if s == "struct":   return true
    if s == "enum":     return true

    // Semantic constructs
    if s == "world":       return true
    if s == "entangle":    return true
    if s == "patch":       return true
    if s == "law":         return true
    if s == "converge":    return true
    if s == "orchestrate": return true
    if s == "pulse":       return true
    if s == "resonate":    return true
    if s == "actor":       return true
    if s == "spawn":       return true
    if s == "send":        return true
    if s == "ask":         return true
    if s == "collapse":    return true
    if s == "observe":     return true
    if s == "decay":       return true
    if s == "teleport":    return true
    if s == "shatter":     return true
    if s == "axiom":       return true
    if s == "shader":      return true
    if s == "dispatch":    return true
    if s == "component":   return true
    if s == "render":      return true

    // Traits, effects, types
    if s == "trait":       return true
    if s == "impl":        return true
    if s == "pub":         return true
    if s == "mod":         return true
    if s == "use":         return true
    if s == "include":     return true
    if s == "import":      return true
    if s == "type":        return true
    if s == "where":       return true
    if s == "as":          return true
    if s == "Pure":        return true
    if s == "IO":          return true
    if s == "Async":       return true
    if s == "GPU":         return true
    if s == "Reactive":    return true
    if s == "Unsafe":      return true
    if s == "Self":        return true
    if s == "self":        return true

    return false

