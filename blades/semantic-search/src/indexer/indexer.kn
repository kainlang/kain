// ============================================================================
//  indexer/indexer.kn — Main Index Builder
//
//  Layer 4 (orchestrate) + Layer 7 (actor) + Layer 2 (patch, law).
//
//  Orchestrates the full index build pipeline:
//    discover files → chunk → tokenize → build FST → build postings → store
//
//  Uses actor IndexWorker for parallel file processing with fanout.
//  The pipeline is a typed stage graph: every dependency is explicit,
//  every stage has a runtime kind, residency, and policy.
// ============================================================================

use std::fs
use std::time

use types::SearchIndex
use types::DocMeta
use types::FSTNode
use types::Posting
use types::Connection
use types::MAX_DOCS
use types::MAX_POSTINGS
use types::MAX_TERMS
use config
use config_reader
use chunker
use tokenizer
use fst_builder
use postings_writer
use profile::connection_graph
use util

// ============================================================================
//  ACTOR — Parallel File Indexing Worker
// ============================================================================

actor IndexWorker:
    state files_indexed:  Int = 0
    state terms_indexed:  Int = 0
    state errors:         Int = 0

    on ProcessFile(reply_to: P, file_path: String, domain: String, subsys: String, lang: String):
        self.files_indexed = self.files_indexed + 1
        let content: String = fs_read_text(file_path)
        let terms: [String] = extract_terms(content, lang)
        self.terms_indexed = self.terms_indexed + len(terms)
        send reply_to.Reply(
            value = file_path
        )

// ============================================================================
//  PATCHES — Journaled Index Mutations
// ============================================================================

patch store_indexed_file(
    file_path: String, domain: String, subsys: String,
    lang: String, lines: Int, terms: [String]
):
    let doc_id: Int = SearchIndex.doc_count
    let meta: DocMeta = DocMeta {
        path: file_path, domain: domain, subsys: subsys,
        lines: lines, lang: lang, chunk_index: 0, checksum: ""
    }
    SearchIndex.doc_store[doc_id] = meta
    SearchIndex.doc_count = doc_id + 1
    SearchIndex.total_files = SearchIndex.total_files + 1
    SearchIndex.total_terms_in_docs = SearchIndex.total_terms_in_docs + len(terms)

patch finalize_index():
    SearchIndex.is_dirty = false
    SearchIndex.last_updated = now_millis()
    SearchIndex.index_version = SearchIndex.index_version + 1
    SearchIndex.avg_doc_len = (to_float(SearchIndex.total_terms_in_docs)
        / to_float(i_max(SearchIndex.doc_count, 1)))

// ============================================================================
//  LAWS — Index Invariants
// ============================================================================

law index_capacity_valid() -> Bool:
    return SearchIndex.doc_count < MAX_DOCS

law term_count_valid() -> Bool:
    return true  // always passes — term count is bounded by available memory

// ============================================================================
//  INDEX BUILD FUNCTIONS
// ============================================================================

fn build_index_from_paths(paths: Array<String>) -> Int with Unsafe, IO:
    // Initialize connection graph
    let _ = init_connections()

    let _ = init_fst()
    let _ = init_term_hash()
    let _ = init_postings()
    let _ = init_term_strings()

    // Doc store is a Kain dynamic array
    SearchIndex.doc_store = []

    var total_files: Int = 0
    var total_terms_added: Int = 0

    var fi: Int = 0
    while fi < len(paths):
        let file_path: String = paths[fi]
        let content: String = fs_read_text(file_path)

        if len(content) > 0:
            // Compute metadata from path
            let ext: String = file_extension(file_path)
            let lang: String = extension_to_lang(ext)
            let domain: String = path_to_domain(file_path)
            let subsys: String = path_to_subsys(file_path)

            // Tokenize
            let terms: Array<String> = extract_terms(content, lang)

            if len(terms) > 0 and SearchIndex.doc_count < MAX_DOCS:
                // Add doc - compute lines from content
                var lines: Int = 1
                var ci: Int = 0
                while ci < len(content):
                    if char_at(content, ci) == "\n":
                        lines = lines + 1
                    ci = ci + 1

                let meta: DocMeta = DocMeta {
                    path: file_path, domain: domain,
                    subsys: subsys, lines: lines,
                    lang: lang, chunk_index: 0, checksum: ""
                }
                push(SearchIndex.doc_store, meta)
                SearchIndex.doc_count = SearchIndex.doc_count + 1
                total_files = total_files + 1

                // Process unique terms
                var processed_terms: Array<String> = []
                var ti: Int = 0
                while ti < len(terms):
                    let term: String = terms[ti]

                    // Check if already processed for this doc
                    var already: Bool = false
                    var pi: Int = 0
                    while pi < len(processed_terms):
                        if processed_terms[pi] == term:
                            already = true
                            pi = len(processed_terms)
                        pi = pi + 1

                    if already == false:
                        push(processed_terms, term)
                        let tid: Int = term_hash_lookup(term)
                        if tid < 0:
                            let new_tid: Int = SearchIndex.term_count
                            if new_tid < MAX_TERMS:
                                let _ = term_hash_insert(term, new_tid)
                                let _ = fst_insert(term, new_tid)
                                let _ = store_term(term)
                                total_terms_added = total_terms_added + 1

                        // Record (term_id, doc_id) pair for postings building
                        let final_tid: Int = term_hash_lookup(term)
                        if final_tid >= 0:
                            let _ = append_posting(final_tid, SearchIndex.doc_count - 1)

                    ti = ti + 1

                // Extract and register connections from this file's source
                let _ = extract_connections_from_file(
                    file_path, domain, subsys, lang, content)

                SearchIndex.total_terms_in_docs = SearchIndex.total_terms_in_docs + len(terms)

        fi = fi + 1

    // Build per-term ranges
    let _ = build_term_ranges()

    SearchIndex.total_files = total_files
    SearchIndex.avg_doc_len = compute_avgdl()
    SearchIndex.last_updated = now_millis()
    SearchIndex.index_version = 1

    return total_files

// ============================================================================
//  CLEAR INDEX — Free all allocations and reset index state
// ============================================================================

// Clear the entire index: free all allocated memory and reset counters.
// Safe to call before a rebuild.
pub fn clear_index() -> Int with Unsafe:
    // Free major allocations
    let tids: ptr<Int> = SearchIndex.posting_term_ids
    if ptr_to_int(tids) != 0:
        decay tids
    let dids: ptr<Int> = SearchIndex.posting_doc_ids
    if ptr_to_int(dids) != 0:
        decay dids
    let tfs: ptr<Int> = SearchIndex.posting_term_freqs
    if ptr_to_int(tfs) != 0:
        decay tfs
    let cc_codes: ptr<Int> = SearchIndex.fst_char_codes
    if ptr_to_int(cc_codes) != 0:
        decay cc_codes
    let sb: ptr<Int> = SearchIndex.fst_siblings
    if ptr_to_int(sb) != 0:
        decay sb
    let ch: ptr<Int> = SearchIndex.fst_children
    if ptr_to_int(ch) != 0:
        decay ch
    let iv: ptr<Int> = SearchIndex.fst_is_finals
    if ptr_to_int(iv) != 0:
        decay iv
    let df: ptr<Int> = SearchIndex.fst_doc_freqs
    if ptr_to_int(df) != 0:
        decay df
    let ti: ptr<Int> = SearchIndex.fst_term_ids
    if ptr_to_int(ti) != 0:
        decay ti
    let hs: ptr<Int> = SearchIndex.term_hash_slots
    if ptr_to_int(hs) != 0:
        decay hs
    let ids: ptr<Int> = SearchIndex.term_id_slots
    if ptr_to_int(ids) != 0:
        decay ids
    let ts: ptr<Int> = SearchIndex.term_strings
    if ptr_to_int(ts) != 0:
        decay ts
    let tpos: ptr<Int> = SearchIndex.term_strings_pos
    if ptr_to_int(tpos) != 0:
        decay tpos
    let tdf: ptr<Int> = SearchIndex.term_doc_freqs
    if ptr_to_int(tdf) != 0:
        decay tdf
    let ps: ptr<Int> = SearchIndex.postings_start
    if ptr_to_int(ps) != 0:
        decay ps
    let pe: ptr<Int> = SearchIndex.postings_end
    if ptr_to_int(pe) != 0:
        decay pe

    // Reset all counters and arrays
    SearchIndex.postings_count = 0
    SearchIndex.postings_cap = 0
    SearchIndex.fst_count = 0
    SearchIndex.fst_cap = 0
    SearchIndex.term_count = 0
    SearchIndex.term_strings_len = 0
    SearchIndex.doc_count = 0
    SearchIndex.doc_store = []
    SearchIndex.conn_count = 0
    SearchIndex.connections = []
    SearchIndex.total_terms_in_docs = 0
    SearchIndex.total_files = 0
    SearchIndex.total_chunks = 0
    SearchIndex.last_updated = 0
    SearchIndex.is_dirty = false
    SearchIndex.index_version = 0
    SearchIndex.avg_doc_len = 0.0

    // Null all pointers
    SearchIndex.posting_term_ids = int_to_ptr(0, "Int")
    SearchIndex.posting_doc_ids = int_to_ptr(0, "Int")
    SearchIndex.posting_term_freqs = int_to_ptr(0, "Int")
    SearchIndex.fst_char_codes = int_to_ptr(0, "Int")
    SearchIndex.fst_siblings = int_to_ptr(0, "Int")
    SearchIndex.fst_children = int_to_ptr(0, "Int")
    SearchIndex.fst_is_finals = int_to_ptr(0, "Int")
    SearchIndex.fst_doc_freqs = int_to_ptr(0, "Int")
    SearchIndex.fst_term_ids = int_to_ptr(0, "Int")
    SearchIndex.term_hash_slots = int_to_ptr(0, "Int")
    SearchIndex.term_id_slots = int_to_ptr(0, "Int")
    SearchIndex.term_strings = int_to_ptr(0, "Int")
    SearchIndex.term_strings_pos = int_to_ptr(0, "Int")
    SearchIndex.term_doc_freqs = int_to_ptr(0, "Int")
    SearchIndex.postings_start = int_to_ptr(0, "Int")
    SearchIndex.postings_end = int_to_ptr(0, "Int")

    return 0

// ============================================================================
//  AGGREGATE INDEX BUILD (no actor — sequential for codegen compat)
// ============================================================================

pub fn build_all_domains(index_crates: Bool, index_runtime: Bool, index_stdlib: Bool) -> Int with Unsafe, IO:
    var total: Int = 0
    var all_paths: Array<String> = []

    // Read target directories from config.md (falls back to DEFAULT_* constants)
    let targets: [String] = read_targets()

    var ti: Int = 0
    while ti < len(targets):
        let dir_path: String = targets[ti]
        let dom: String = path_to_domain(dir_path)
        let subsys: String = path_to_subsys(dir_path)

        var should_index: Bool = false
        if dom == "crates" and index_crates:
            should_index = true
        elif dom == "runtime" and index_runtime:
            should_index = true
        elif dom == "stdlib" and index_stdlib:
            should_index = true
        // Index everything if all three flags are on (for default mode)
        elif (index_crates == false and index_runtime == false and index_stdlib == false):
            should_index = true

        if should_index:
            let entries: Array<FsDirEntry> = fs_walk(dir_path)
            var ei: Int = 0
            while ei < len(entries):
                let entry: FsDirEntry = entries[ei]
                if entry.file_type == "file":
                    let ext: String = file_extension(entry.path)
                    let lang: String = extension_to_lang(ext)
                    if lang != "unknown":
                        push(all_paths, entry.path)
                ei = ei + 1
        else:
            // skip this domain
            let _ = 0

        ti = ti + 1

    total = build_index_from_paths(all_paths)
    return total

// ============================================================================
//  AXIOM — Index Builder Capability
// ============================================================================

axiom index_builder_capability:
    when capability("cpu.scalar")
    guarantee "index builder can process 2700+ files sequentially on any CPU"
    fallback build_index_single
