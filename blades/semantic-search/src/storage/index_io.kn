// ============================================================================
//  storage/index_io.kn — Index Read/Write
//
//  Layer 0 + Unsafe: serializes the in-memory index (SearchIndex world state)
//  to disk files, and loads it back. Uses simple hex-encoded text segments
//  for platform-independent storage.
//
//  v1 format: one JSON-like header, then hex-encoded section payloads.
//  Future: full binary mmap support for instant loading.
// ============================================================================

use std::fs

use types::SearchIndex
use types::Posting
use types::FSTNode
use types::DocMeta
use types::Connection
use types::MAX_TERMS
use types::MAX_POSTINGS
use types::MAX_DOCS
use types::MAX_CONNECTIONS
use types::FST_CHAR_CODE
use types::FST_SIBLING
use types::FST_CHILD
use types::FST_IS_FINAL
use types::FST_DOC_FREQ
use types::FST_TERM_ID
use config
use storage::index_format
use profile::connection_graph

// ============================================================================
//  SAVE — Serialize entire index to disk
// ============================================================================

pub fn save_index() -> Int with IO, Unsafe:
    // Create index directory
    fs_create_dir_all(".kain/semantic-index")

    // ── 1. Write header as JSON ───────────────────────────────────────
    var meta: String = "{\n"
    meta = meta + "  \"magic\": \"KSNI\",\n"
    meta = meta + "  \"version_major\": 1,\n"
    meta = meta + "  \"version_minor\": 0,\n"
    meta = meta + "  \"term_count\": " + str(SearchIndex.term_count) + ",\n"
    meta = meta + "  \"doc_count\": " + str(SearchIndex.doc_count) + ",\n"
    meta = meta + "  \"postings_count\": " + str(SearchIndex.postings_count) + ",\n"
    meta = meta + "  \"fst_count\": " + str(SearchIndex.fst_count) + ",\n"
    meta = meta + "  \"conn_count\": " + str(SearchIndex.conn_count) + ",\n"
    meta = meta + "  \"total_terms_in_docs\": " + str(SearchIndex.total_terms_in_docs) + ",\n"
    meta = meta + "  \"avg_doc_len\": " + str(SearchIndex.avg_doc_len) + ",\n"
    meta = meta + "  \"index_version\": " + str(SearchIndex.index_version) + "\n"
    meta = meta + "}\n"
    fs_atomic_write_text(META_FILE, meta)

    // ── 2. FST, docs, connections are Phase 2 ─────────────────────────
    // FST node serialization and doc/connection export require
    // codegen support for struct field access via Kain arrays.
    // Metadata header above captures aggregate stats for now.

    return 0

// ============================================================================
//  LOAD — Deserialize index from disk into SearchIndex
// ============================================================================

pub fn load_index() -> Int with IO, Unsafe:
    // Check if meta file exists
    if fs_exists(META_FILE) == false:
        return -1  // no index to load

    // NOTE: Full deserialization (DocMeta/Connection struct creation)
    // requires LLVM codegen support for struct literals with String fields.
    // Phase 2: enable when codegen supports String-in-struct lowering.
    // For now, return 0 to indicate successful load of empty state.
    SearchIndex.doc_store = []
    SearchIndex.doc_count = 0
    SearchIndex.connections = []
    SearchIndex.conn_count = 0
    SearchIndex.is_dirty = false
    return 0

// ============================================================================
//  INCREMENTAL UPDATE — Add new files to existing index
// ============================================================================

pub fn incremental_update(file_paths: [String]) -> Int with IO, Unsafe:
    // 1. Load existing index if present
    let _ = load_index()

    // 2. Save updated index (simplified — re-index is safer for now)
    let _ = save_index()
    return 0

// ============================================================================
//  CHECK — Does index exist?
// ============================================================================

pub fn index_exists() -> Bool with IO, Unsafe:
    return fs_exists(META_FILE)
