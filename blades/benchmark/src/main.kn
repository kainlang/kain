// ============================================================================
//  main.kn — Kain Bench — zero-friction microbenchmark runner
//
//  Drop .kn files in a folder. Each file self-times using the template at:
//    blades/benchmark/template.kn
//
//  Usage:
//    kain run blades/benchmark/ -- run my_benches/
//    kain run blades/benchmark/ -- list my_benches/
//
//  Ladder: Layer 0 — plain fn + IO effect for process/filesystem.
// ============================================================================

use std::time
use std::fs
use std::path
use std::os
use std::runtime
use std::text
use std::ascii

// ============================================================================
//  CONFIG
// ============================================================================

const TARGET_DURATION_MS: Int = 1000

// ============================================================================
//  RESULT
// ============================================================================

struct BenchResult:
    bench_name:  String
    exe_path:    String
    description: String
    meta_fields: Array<String>
    iters:       Int
    checksum:    Int
    min_ms:      Int
    max_ms:      Int
    median_ms:   Int
    mean_ms:     Int
    samples:     Array<Int>
    build_ok:    Bool
    run_ok:      Bool
    error:       String

// ============================================================================
//  MAIN
// ============================================================================

fn main() -> Int:
    let init = runtime_init()
    if init != 0: return 100 + init

    let args = user_args()
    if len(args) < 2:
        println("usage: bench run <folder>")
        println("  bench list <folder>")
        let _s = runtime_shutdown()
        return 1

    let cmd = args[0]
    let dir = args[1]

    if fs_exists(dir) == false:
        println("folder not found: " + dir)
        let _s = runtime_shutdown()
        return 2

    if cmd == "list":
        let _s = runtime_shutdown()
        return cmd_list(dir)
    if cmd == "run":
        let _s = runtime_shutdown()
        return cmd_run(dir)

    println("unknown command: " + cmd)
    let _s = runtime_shutdown()
    return 3

fn user_args() -> Array<String>:
    let count = process_arg_count()
    let args: Array<String> = []
    var i = 1
    while i < count:
        push(args, process_arg(i))
        i = i + 1
    return args

// ============================================================================
//  CMD LIST
// ============================================================================

fn cmd_list(dir: String) -> Int:
    let cwd = os_getcwd()
    var abs_dir = dir
    if text_contains_string(dir, ":") == false:
        abs_dir = path_join(cwd, dir)
    let files = find_kn_files(abs_dir)
    if len(files) == 0:
        println("no .kn files in " + dir)
        return 0
    println(str(len(files)) + " benchmark file(s) in " + dir + ":")
    var i = 0
    while i < len(files):
        println("  " + files[i])
        i = i + 1
    return 0

// ============================================================================
//  CMD RUN
// ============================================================================

fn cmd_run(dir: String) -> Int:
    let cwd = os_getcwd()
    var abs_dir = dir
    if text_contains_string(dir, ":") == false:
        abs_dir = path_join(cwd, dir)

    let files = find_kn_files(abs_dir)
    if len(files) == 0:
        println("no .kn files in " + dir)
        return 0

    let results: Array<BenchResult> = []
    var i = 0
    while i < len(files):
        let file = files[i]
        let abs_file = path_join(abs_dir, file)
        let bname = path_stem(file)
        println("[" + str(i + 1) + "/" + str(len(files)) + "] " + bname + " ...")
        let result = bench_file(abs_file)
        push(results, result)
        if result.build_ok and result.run_ok:
            let ns = (result.median_ms * 1000000) / result.iters
            println("  -> " + str(result.median_ms) + "ms median, " +
                    str(result.iters) + " iters, ~" + str(ns) + " ns/iter")
        else:
            println("  -> FAILED: " + result.error)
        i = i + 1

    let report = write_markdown_report(abs_dir, results)
    println("")
    println("report: " + report)
    return 0

// ============================================================================
//  FIND .kn FILES
// ============================================================================

fn find_kn_files(dir: String) -> Array<String>:
    let entries = fs_walk(dir)
    let result: Array<String> = []
    var i = 0
    while i < len(entries):
        let ep = entries[i].path
        if text_ends_with_string(ep, ".kn"):
            push(result, path_file_name(ep))
        i = i + 1
    return result

// ============================================================================
//  BENCH A SINGLE FILE — build, run once, parse BENCH: stdout lines
// ============================================================================

fn bench_file(abs_kn_path: String) -> BenchResult:
    let bname = path_stem(abs_kn_path)

    // Build
    let fixed_path = text_replace_string(abs_kn_path, "\\", "/")
    let _bs = os_system("kain build " + fixed_path + " --target llvm")

    // Find built exe
    let exe = find_built_exe(abs_kn_path)
    if exe == "":
        return fail_result(bname, "", false, "build failed — no exe produced")

    // Run once, capture stdout
    let fixed_exe = text_replace_string(exe, "\\", "/")
    let output = os_popen_read(fixed_exe, 300000)
    if output == "":
        return fail_result(bname, exe, true, "exe produced no output")

    // Parse BENCH:/DESCRIPTION:/META: lines
    let samples: Array<Int> = []
    var checksum = 0
    var iters = 0
    var description = ""
    let meta_fields: Array<String> = []

    let lines = split_lines(output)
    var li = 0
    while li < len(lines):
        let ln = text_trim_string(lines[li])
        if text_starts_with_string(ln, "DESCRIPTION:"):
            description = parse_description(ln)
        elif text_starts_with_string(ln, "META:"):
            push(meta_fields, parse_meta_value(ln))
        elif text_starts_with_string(ln, "BENCH:"):
            let ms = parse_int_field(ln, "ELAPSED_MS:")
            if ms >= 0: push(samples, ms)
            let it = parse_int_field(ln, "ITERS:")
            if it >= 0: iters = it
            let chk = parse_int_field(ln, "CHECKSUM:")
            if chk >= 0: checksum = chk
        li = li + 1

    if len(samples) == 0:
        return fail_result(bname, exe, true, "no BENCH: lines in output")

    let stats = compute_stats(samples)
    return BenchResult {
        bench_name: bname, exe_path: exe, description: description,
        meta_fields: meta_fields,
        iters: iters, checksum: checksum,
        min_ms: stats[0], max_ms: stats[1], median_ms: stats[2], mean_ms: stats[3],
        samples: samples, build_ok: true, run_ok: true, error: "",
    }

// ============================================================================
//  FIND BUILT EXE — walk upward from file dir looking for .kain/out/<name>.exe
// ============================================================================

fn find_built_exe(abs_kn_path: String) -> String:
    let bname = path_stem(abs_kn_path)
    let target_name = bname + ".exe"

    // 1. Walk .kain/out (fresh build from kain build command)
    var search_dir = path_parent(abs_kn_path)
    var attempts = 0
    while attempts < 5:
        let out_path = path_join(path_join(search_dir, ".kain"), "out")
        if fs_exists(out_path):
            let entries = fs_walk(out_path)
            var i = 0
            while i < len(entries):
                if text_ends_with_string(entries[i].path, target_name):
                    return entries[i].path
                i = i + 1
        let up = path_parent(search_dir)
        if up == search_dir: break
        search_dir = up
        attempts = attempts + 1

    // 2. Check sibling (next to .kn file)
    let parent = path_parent(abs_kn_path)
    let sibling = path_join(parent, target_name)
    if fs_exists(sibling):
        return sibling

    // 3. Check repo root
    let cwd = os_getcwd()
    let root_exe = path_join(cwd, target_name)
    if fs_exists(root_exe):
        return root_exe

    return ""

// ============================================================================
//  PARSE HELPERS
// ============================================================================

fn fail_result(bname: String, exe: String, built: Bool, msg: String) -> BenchResult:
    return BenchResult {
        bench_name: bname, exe_path: exe, description: "", meta_fields: [],
        iters: 0, checksum: 0,
        min_ms: 0, max_ms: 0, median_ms: 0, mean_ms: 0,
        samples: [], build_ok: built, run_ok: false, error: msg,
    }

fn parse_int_field(ln: String, key: String) -> Int:
    // Find "|KEY:" in ln, parse trailing integer
    var i = 0
    while i <= len(ln) - len(key) - 1:
        if char_at(ln, i) != "|":
            i = i + 1
            continue
        var matched = true
        var j = 0
        while j < len(key):
            if char_at(ln, i + 1 + j) != char_at(key, j):
                matched = false
                break
            j = j + 1
        if matched:
            var start = i + 1 + len(key)
            var val = 0
            var sign = 1
            if start < len(ln) and char_at(ln, start) == "-":
                sign = -1
                start = start + 1
            var k = start
            while k < len(ln):
                let c = char_at(ln, k)
                let code = ascii_char_code(c)
                if code >= 48 and code <= 57:
                    val = val * 10 + (code - 48)
                else:
                    break
                k = k + 1
            return val * sign
        i = i + 1
    return -1

fn parse_description(ln: String) -> String:
    // Format: DESCRIPTION:<name>|<text>
    let prefix = "DESCRIPTION:"
    var i = len(prefix)
    // Skip the bench name (until first |)
    while i < len(ln) and char_at(ln, i) != "|":
        i = i + 1
    if i < len(ln): i = i + 1  // skip the |
    var text = ""
    while i < len(ln):
        text = text + char_at(ln, i)
        i = i + 1
    return text

fn parse_meta_value(ln: String) -> String:
    // Format: META:<name>|<key>=<value>
    let prefix = "META:"
    var i = len(prefix)
    while i < len(ln) and char_at(ln, i) != "|":
        i = i + 1
    if i < len(ln): i = i + 1
    var val = ""
    while i < len(ln):
        val = val + char_at(ln, i)
        i = i + 1
    return val

fn split_lines(text: String) -> Array<String>:
    let result: Array<String> = []
    var current = ""
    var i = 0
    while i < len(text):
        let c = char_at(text, i)
        if c == "\n":
            push(result, current)
            current = ""
        elif c != "\r":
            current = current + c
        i = i + 1
    if current != "": push(result, current)
    return result

// ============================================================================
//  COMPUTE STATS — returns [min, max, median, mean]
// ============================================================================

fn compute_stats(samples: Array<Int>) -> Array<Int>:
    var si = 1
    while si < len(samples):
        let key = samples[si]
        var sj = si - 1
        var shifting = true
        while shifting:
            if sj < 0: shifting = false
            elif samples[sj] <= key: shifting = false
            else:
                samples[sj + 1] = samples[sj]
                sj = sj - 1
        samples[sj + 1] = key
        si = si + 1
    let mid = len(samples) / 2
    let median = samples[mid]
    let min_val = samples[0]
    let max_val = samples[len(samples) - 1]
    var total = 0
    var j = 0
    while j < len(samples):
        total = total + samples[j]
        j = j + 1
    return [min_val, max_val, median, total / len(samples)]

// ============================================================================
//  WRITE MARKDOWN REPORT
// ============================================================================

fn write_markdown_report(dir: String, results: Array<BenchResult>) -> String:
    var md = "# Bench Report\n\n"
    md = md + "**Folder:** `" + dir + "`  \n"
    md = md + "**Date:** " + iso_now() + "  \n"
    md = md + "**Target:** " + str(TARGET_DURATION_MS) + "ms per benchmark  \n"
    md = md + "**Benchmarks:** " + str(len(results)) + "\n\n"

    md = md + "| Benchmark | Iters | Median | Min | Max | Mean | ns/iter | Checksum |\n"
    md = md + "|-----------|-------|--------|-----|-----|------|---------|----------|\n"
    var i = 0
    while i < len(results):
        let r = results[i]
        if r.build_ok and r.run_ok:
            let ns = (r.median_ms * 1000000) / r.iters
            var row = "| `" + r.bench_name + "` | " + str(r.iters) + " | "
            row = row + str(r.median_ms) + "ms | " + str(r.min_ms) + "ms | "
            row = row + str(r.max_ms) + "ms | " + str(r.mean_ms) + "ms | "
            row = row + str(ns) + " | `" + str(r.checksum) + "` |\n"
            md = md + row
        else:
            md = md + "| `" + r.bench_name + "` | — | — | — | — | — | — | ❌ " + r.error + " |\n"
        i = i + 1

    md = md + "\n## Details\n\n"
    i = 0
    while i < len(results):
        let r = results[i]
        md = md + "### " + r.bench_name + "\n\n"
        if r.build_ok == false:
            md = md + "❌ **Build failed:** " + r.error + "\n\n"
        elif r.run_ok == false:
            md = md + "❌ **Run failed:** " + r.error + "\n\n"
        else:
            // Description block (shown above metrics)
            if r.description != "":
                md = md + r.description + "\n\n"
            md = md + "- **Iterations:** " + str(r.iters) + "\n"
            md = md + "- **Checksum:** `" + str(r.checksum) + "`\n"
            var med_line = "- **Median:** " + str(r.median_ms) + "ms ("
            med_line = med_line + str((r.median_ms * 1000000) / r.iters) + " ns/iter)\n"
            md = md + med_line
            md = md + "- **Min/Max:** " + str(r.min_ms) + "ms / " + str(r.max_ms) + "ms\n"
            md = md + "- **Mean:** " + str(r.mean_ms) + "ms\n"
            md = md + "- **Samples:** "
            var j = 0
            while j < len(r.samples):
                md = md + str(r.samples[j]) + "ms"
                if j + 1 < len(r.samples): md = md + ", "
                j = j + 1
            md = md + "\n"
            md = md + "- **Binary:** `" + r.exe_path + "`\n"
            // Custom telemetry (META fields)
            if len(r.meta_fields) > 0:
                md = md + "\n**Custom telemetry:**\n"
                var m = 0
                while m < len(r.meta_fields):
                    md = md + "- `" + r.meta_fields[m] + "`\n"
                    m = m + 1
        md = md + "\n"
        i = i + 1

    let report_path = path_join(dir, "report.md")
    let ok = os_write_text(report_path, md)
    if ok: return report_path
    return ""

fn iso_now() -> String:
    let now = now_millis()
    let dt = datetime_from_epoch_millis(now)
    var buf = str(dt.year) + "-" + zero2(dt.month) + "-" + zero2(dt.day)
    buf = buf + " " + zero2(dt.hour) + ":" + zero2(dt.minute) + ":" + zero2(dt.second)
    return buf

fn zero2(v: Int) -> String:
    if v < 10: return "0" + str(v)
    return str(v)
