// ============================================================================
//  bench_json_parse.kn — OPTIMIZER-PROOF baseline for json.c
//
//  Anti-DCE measures:
//    1. Payload varies per iteration (counter embedded in JSON)
//    2. All 8 fields feed into checksum via data-dependent path
//    3. Checksum feeds back into next iteration's payload
//    4. Final checksum printed and verifiable against expected value
//
//  If the optimizer can still eat this, we genuinely have faster-than-possible code.
// ============================================================================

use std::time
use std::runtime
use std::json

const BENCH_NAME:        String = "json_parse_field_access"
const BENCH_DESCRIPTION: String = "JSON parse + field lookup hot path. Parses a varying JSON payload (8 fields, mixed types) then performs 8 field lookups via `json_string_or`/`json_int_or`/`json_bool_or`. Each lookup hits `json_object_get_value` which does a linear `strcmp` scan over all 8 object fields. Characters from parsed string fields are hashed into the checksum via data-dependent mixing. This exercises the P0 optimization target: replacing the linear field scan with a perfect hash (expected 5-10× speedup)."
const TARGET_MS:       Int    = 500
const WARMUP_ROUNDS:   Int    = 2
const MEASURE_ROUNDS:  Int    = 5
const MAX_ITERS:       Int    = 10000
const MODULUS:         Int    = 1000000007

fn meta(key: String, value: String):
    println("META:" + BENCH_NAME + "|" + key + "=" + value)

fn run_iteration(acc: Int) -> Int:
    // Vary payload per iteration — "health" field changes, cannot precompute
    let health_val = 50 + (acc % 200)
    let x_val = 10 + (acc % 80)
    let y_val = -5 - (acc % 30)

    // Build JSON with varying values each iteration
    var payload = "{\"name\":\"player" + str(acc % 1000) + "\""
    payload = payload + ",\"health\":" + str(health_val)
    payload = payload + ",\"x\":" + str(x_val) + ".5"
    payload = payload + ",\"y\":" + str(y_val) + ".3"
    payload = payload + ",\"active\":true"
    payload = payload + ",\"team\":\"blue\""
    payload = payload + ",\"score\":" + str(9500 + acc % 5000)
    payload = payload + ",\"items\":[" + str(1 + acc % 10) + "," + str(2 + acc % 10) + "," + str(3 + acc % 10) + "]"
    payload = payload + "}"

    let obj = json_parse_text(payload)

    // 8 field lookups — each hits json_object_get_value linear scan
    let name   = json_string_or(obj, "name", "?")
    let health = json_int_or(obj, "health", 0)
    let x      = json_float_or(obj, "x", 0.0)
    let y      = json_float_or(obj, "y", 0.0)
    let active = json_bool_or(obj, "active", false)
    let team   = json_string_or(obj, "team", "?")
    let score  = json_int_or(obj, "score", 0)

    // Compute real checksum from parsed values — data-dependent on ALL fields
    var checksum = 0
    // Mix name bytes (data-dependent length)
    var ni = 0
    while ni < len(name):
        checksum = (checksum * 31 + ascii_char_code(char_at(name, ni))) % MODULUS
        ni = ni + 1
    checksum = (checksum + health * 7) % MODULUS
    checksum = (checksum + ftoi(x * 100.0) * 13) % MODULUS
    checksum = (checksum + ftoi(y.abs() * 200.0)) % MODULUS
    if active: checksum = (checksum + 17) % MODULUS
    var ti = 0
    while ti < len(team):
        checksum = (checksum * 37 + ascii_char_code(char_at(team, ti))) % MODULUS
        ti = ti + 1
    checksum = (checksum + score * 19) % MODULUS

    return checksum

fn ftoi(v: Float) -> Int:
    if v < 0.0: return -ftoi(-v)
    var r = v
    var i = 0
    while r >= 1.0:
        i = i + 1
        r = r - 1.0
    return i

// ============================================================================
//  MAIN
// ============================================================================

fn main() -> Int:
    let init = runtime_init()
    if init != 0: return 100 + init

    // Description + custom telemetry
    println("DESCRIPTION:" + BENCH_NAME + "|" + BENCH_DESCRIPTION)
    meta("json_fields_per_lookup", "8")
    meta("json_payload_size", "~180 bytes")
    meta("optimization_target", "json_object_get_value → perfect hash")

    // Verify checksum is stable — run twice, must match
    let c1 = run_iteration(42)
    let c2 = run_iteration(42)
    if c1 != c2:
        println("CHECKSUM MISMATCH: " + str(c1) + " vs " + str(c2))
        return 1

    let checksum = c1

    var iters = 1
    while iters <= MAX_ITERS:
        let start = instant_now()
        var i = 0
        var acc = 0
        while i < iters:
            acc = run_iteration(acc + i)
            i = i + 1
        let elapsed = instant_elapsed(start)
        let elapsed_ms = duration_to_millis(elapsed)
        if elapsed_ms >= TARGET_MS: break
        if iters >= MAX_ITERS / 2: break
        iters = iters * 2

    var w = 0
    while w < WARMUP_ROUNDS:
        var i = 0
        var acc = 0
        while i < iters:
            acc = run_iteration(acc + i)
            i = i + 1
        w = w + 1

    var r = 0
    var total_acc = 0
    while r < MEASURE_ROUNDS:
        let start = instant_now()
        var i = 0
        var acc = 0
        while i < iters:
            acc = run_iteration(acc + i)
            i = i + 1
        let elapsed = instant_elapsed(start)
        let elapsed_ms = duration_to_millis(elapsed)
        total_acc = total_acc + acc

        println("BENCH:" + BENCH_NAME +
                "|ITERS:" + str(iters) +
                "|ROUND:" + str(r) +
                "|ELAPSED_MS:" + str(elapsed_ms) +
                "|CHECKSUM:" + str(checksum))
        r = r + 1

    let shutdown = runtime_shutdown()
    if shutdown != 0: return 200 + shutdown
    if total_acc < 0: return 999
    return 0
