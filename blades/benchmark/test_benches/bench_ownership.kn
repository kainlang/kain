// ============================================================================
//  bench_ownership.kn — OPTIMIZER-PROOF baseline for buddy.c + ownership.c
//
//  Anti-DCE measures:
//    1. Each collapse writes values dependent on the previous observe-read
//    2. Checksum chains across all 200 cycles (data-dependent, cannot collapse)
//    3. Allocation size varies per iteration
//    4. Memory pattern: write→read→decay→realloc, each step feeds the next
//
//  This exercises: buddy allocator log2, ownership % ringbuffer, free slot scan.
//  If 17ns/cycle is real, this benchmark proves the ownership subsystem is
//  operating at near-theoretical minimum latency.
// ============================================================================

use std::time
use std::runtime

const BENCH_NAME:        String = "ownership_alloc_churn"
const BENCH_DESCRIPTION: String = "Ownership hot path: 200 rapid alloc/collapse/observe/decay cycles per iteration. Each cycle allocates 4-16 Int cells via `alloc_zeroed`, writes data-dependent values inside `collapse`, reads one cell back via `observe`, then `decay`s the allocation. The read value feeds into the next cycle's write pattern via a multiplicative checksum chain. Allocation sizes vary per round to prevent size-based caching. This exercises three P0/P1 optimization targets: buddy allocator `kain_buddy_log2_exact()` (CLZ replacement, 10-30× expected), ownership ringbuffer `% 4096` (bitmask replacement, 2-5× expected), and ownership free-slot scan (summary word + ctz, 16-64× expected)."
const TARGET_MS:       Int    = 500
const WARMUP_ROUNDS:   Int    = 2
const MEASURE_ROUNDS:  Int    = 5
const MAX_ITERS:       Int    = 10000
const MODULUS:         Int    = 1000000007

fn meta(key: String, value: String):
    println("META:" + BENCH_NAME + "|" + key + "=" + value)

fn run_iteration(seed: Int) -> Int:
    var checksum = seed
    var round = 0

    while round < 200:
        // Vary allocation size per round — prevents size-based caching
        let alloc_size = 4 + (round % 13)  // 4 to 16 Int cells

        let ptr: ptr<Int> = alloc_zeroed(alloc_size, "Int")

        // Write pattern depends on previous checksum (data dependency chain)
        collapse ptr:
            var j = 0
            while j < alloc_size:
                let val = (checksum * 31 + round * 7 + j * 13) % MODULUS
                mem_store(ptr_offset(ptr, j, "Int"), val, "Int")
                j = j + 1
            0

        // Read back — value feeds into next iteration's checksum
        let read_idx = round % alloc_size
        let val = observe ptr:
            mem_load(ptr_offset(ptr, read_idx, "Int"), "Int")

        decay ptr

        // Chain: this iteration's read feeds next iteration's write
        checksum = (checksum * 17 + val + read_idx) % MODULUS
        round = round + 1

    return checksum

// ============================================================================
//  MAIN
// ============================================================================

fn main() -> Int:
    let init = runtime_init()
    if init != 0: return 100 + init

    println("DESCRIPTION:" + BENCH_NAME + "|" + BENCH_DESCRIPTION)
    meta("alloc_cycles_per_iter", "200")
    meta("alloc_size_range", "4-16 Int cells")
    meta("ownership_ops", "collapse + observe + decay per cycle")
    meta("optimization_targets", "buddy.c log2→CLZ, ownership.c %→&, free-slot→ctz")

    let c1 = run_iteration(42)
    let c2 = run_iteration(42)
    if c1 != c2:
        println("CHECKSUM MISMATCH: " + str(c1) + " vs " + str(c2))
        return 1

    let checksum = c1

    var iters = 1
    while iters <= MAX_ITERS:
        let start = instant_now()
        var i = 0
        var acc = 0
        while i < iters:
            acc = run_iteration(acc + i)
            i = i + 1
        let elapsed = instant_elapsed(start)
        let elapsed_ms = duration_to_millis(elapsed)
        if elapsed_ms >= TARGET_MS: break
        if iters >= MAX_ITERS / 2: break
        iters = iters * 2

    var w = 0
    while w < WARMUP_ROUNDS:
        var i = 0
        var acc = 0
        while i < iters:
            acc = run_iteration(acc + i)
            i = i + 1
        w = w + 1

    var r = 0
    var total_acc = 0
    while r < MEASURE_ROUNDS:
        let start = instant_now()
        var i = 0
        var acc = 0
        while i < iters:
            acc = run_iteration(acc + i)
            i = i + 1
        let elapsed = instant_elapsed(start)
        let elapsed_ms = duration_to_millis(elapsed)
        total_acc = total_acc + acc

        println("BENCH:" + BENCH_NAME +
                "|ITERS:" + str(iters) +
                "|ROUND:" + str(r) +
                "|ELAPSED_MS:" + str(elapsed_ms) +
                "|CHECKSUM:" + str(checksum))
        r = r + 1

    let shutdown = runtime_shutdown()
    if shutdown != 0: return 200 + shutdown
    if total_acc < 0: return 999
    return 0
