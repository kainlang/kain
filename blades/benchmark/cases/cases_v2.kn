//
// // ============================================================================
// //  CONVERGE — converge, spec, fast, when, target, capability, verify, random
// // ============================================================================
//
// fn crucible_mix_scalar(v: Int, seed: Int) -> Int:
//     return crucible_mod((v * 31 + seed) * 17 + 7, CRUCIBLE_MODULUS)
//
// fn crucible_mix_closed(v: Int, seed: Int) -> Int:
