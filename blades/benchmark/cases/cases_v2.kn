//
// // ============================================================================
// //  PATCH FUNCTIONS — patch keyword (journaled world mutations)
// // ============================================================================
//
// patch crucible_commit_signal(authority: CrucibleAuthority, value: Int) -> Int:
//     authority.signal = value
//     authority.epoch  = authority.epoch + 1
