// ============================================================================
//  template.kn — Copy-paste benchmark template for the Kain bench blade
//
//  Self-times internally. Prints BENCH: lines + DESCRIPTION: line to stdout.
//  The blade parses everything and renders a rich markdown report.
//
//  WHAT YOU CHANGE:
//    1. BENCH_NAME — short identifier
//    2. BENCH_DESCRIPTION — markdown description shown in report
//    3. run_iteration() — your hot loop, returns deterministic Int checksum
//    4. META fields — add any custom telemetry via `meta()` calls
//    5. Imports — add std:: modules as needed
// ============================================================================

use std::time
use std::runtime

// ============================================================================
//  CONFIG — change these for each benchmark
// ============================================================================

const BENCH_NAME:        String = "template"
const BENCH_DESCRIPTION: String = "Template benchmark — replace with your own description."
const TARGET_MS:         Int    = 100
const WARMUP_ROUNDS:     Int    = 1
const MEASURE_ROUNDS:    Int    = 3
const MAX_ITERS:         Int    = 100000

// ============================================================================
//  WILDCARD TELEMETRY — add META fields to appear in the report
//
//  Use: meta("allocations_per_iter", str(200))
//       meta("cells_touched", str(2400))
//       meta("ownership_transitions", str(600))
//
//  All meta calls before the first BENCH: line are collected into the report.
// ============================================================================

fn meta(key: String, value: String):
    println("META:" + BENCH_NAME + "|" + key + "=" + value)

// ============================================================================
//  YOUR HOT LOOP — replace everything inside this function.
//
//  Rules:
//    - MUST be deterministic (same inputs → same checksum every run)
//    - MUST return an Int checksum
//    - SHOULD do enough work per call that auto-scaling finds <10000 iters
//    - CAN use any Kain construct: actors, pulse, world, shatter, etc.
// ============================================================================

fn run_iteration(acc: Int) -> Int:
    // Example: scalar integer mix (1M inner loop)
    let modulus = 1000000007
    var result = 0
    var i = 0
    while i < 100000:
        let a_val = (i * 31 + 7) % modulus
        let b_val = (a_val * 17 + 13) % modulus
        result = (result + a_val * b_val) % modulus
        i = i + 1
    return acc + result

// ============================================================================
//  MAIN — timing harness (DO NOT MODIFY)
// ============================================================================

fn main() -> Int:
    let init = runtime_init()
    if init != 0: return 100 + init

    // Print description once (blade captures it for report header)
    println("DESCRIPTION:" + BENCH_NAME + "|" + BENCH_DESCRIPTION)

    // Fire wildcard telemetry
    meta("target_ms", str(TARGET_MS))
    meta("warmup_rounds", str(WARMUP_ROUNDS))
    meta("measure_rounds", str(MEASURE_ROUNDS))

    let checksum = run_iteration(0)

    // Auto-scale
    var iters = 1
    while iters <= MAX_ITERS:
        let start = instant_now()
        var i = 0
        var acc = 0
        while i < iters:
            acc = run_iteration(acc)
            i = i + 1
        let elapsed = instant_elapsed(start)
        let elapsed_ms = duration_to_millis(elapsed)
        if elapsed_ms >= TARGET_MS: break
        if iters >= MAX_ITERS / 2: break
        iters = iters * 2

    // Warmup
    var w = 0
    while w < WARMUP_ROUNDS:
        var i = 0
        var acc = 0
        while i < iters:
            acc = run_iteration(acc)
            i = i + 1
        w = w + 1

    // Measure
    var r = 0
    var total_acc = 0
    while r < MEASURE_ROUNDS:
        let start = instant_now()
        var i = 0
        var acc = 0
        while i < iters:
            acc = run_iteration(acc)
            i = i + 1
        let elapsed = instant_elapsed(start)
        let elapsed_ms = duration_to_millis(elapsed)
        total_acc = total_acc + acc

        println("BENCH:" + BENCH_NAME +
                "|ITERS:" + str(iters) +
                "|ROUND:" + str(r) +
                "|ELAPSED_MS:" + str(elapsed_ms) +
                "|CHECKSUM:" + str(checksum))
        r = r + 1

    // Prevent DCE
    let shutdown = runtime_shutdown()
    if shutdown != 0: return 200 + shutdown
    if total_acc < 0: return 999
    return 0
