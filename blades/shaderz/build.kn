// ═══════════════════════════════════════════════════════════════════════════
//  shaderz/build.kn — Interactive Shader + Component Playground
//
//  A workspace that fuses the component surface, world state, shader GPU
//  pipeline, and input system into interactive animated experiences.
//
//  Targets:
//    kain build --target llvm     → native executable (GDI fallback)
//    $env:RENDERER_BACKEND=vulkan → GPU-accelerated via libkain-vulkan-abi
//
//  Entry points:
//    src/interactive_playground.kn  — world + shader + component + input
//    src/shader_dashboard.kn        — component HUD over animated shader
//    src/particle_world.kn          — GPU particles + world state + UI
// ═══════════════════════════════════════════════════════════════════════════

let project = build_project()
    .name("shaderz")
    .target("llvm")
    .profile("debug")

// ── Interactive Playground: world + shader + component + input ──
let playground = project
    .native_executable("interactive_playground")
    .source("src/interactive_playground.kn")
    .output("interactive_playground.exe")

// ── Shader Dashboard: component HUD over animated shader ──
let dashboard = project
    .native_executable("shader_dashboard")
    .source("src/shader_dashboard.kn")
    .output("shader_dashboard.exe")

// ── Particle World: GPU particles + world state + telemetry ──
let particle_world = project
    .native_executable("particle_world")
    .source("src/particle_world.kn")
    .output("particle_world.exe")

// ── Multi-Shader World: one world, multiple shader surfaces ──
let multi_shader = project
    .native_executable("multi_shader_world")
    .source("src/multi_shader_world.kn")
    .output("multi_shader_world.exe")

project.build_all()
