// ═══════════════════════════════════════════════════════════════════════════
//  particle_world.kn — GPU Particles Driven by World State
//
//  A particle simulation where the COMPUTE SHADER runs on GPU and the
//  FRAGMENT SHADER visualizes the particles. A component HUD shows
//  telemetry. World state bridges all three.
//
//  ARCHITECTURE:
//    ParticleWorld
//      ├── surface shader_canvas => ParticleVisualizer    (fragment: renders particles)
//      └── surface native_ui => ParticleHUD            (component: telemetry)
//
//    World state stores particle count, emission rate, gravity, color theme.
//    The fragment shader receives particle parameters as uniforms.
//    The component displays particle count, FPS, and controls reference.
//
//  This demonstrates the GPU compute → fragment visualization pipeline
//  where world state is the dispatch authority.
// ═══════════════════════════════════════════════════════════════════════════

use std::runtime

// ═══════════════════════════════════════════════════════════════════════════
//  WORLD — particle simulation authority
// ═══════════════════════════════════════════════════════════════════════════

world ParticleWorld:
    // Particle system parameters
    state particle_count: Int = 4096
    state emit_rate: Int = 64
    state gravity: Float = -9.8
    state speed: Float = 1.0
    state spread: Float = 0.5
    state lifetime: Float = 3.0

    // Color theme
    state color_r: Float = 0.2
    state color_g: Float = 0.6
    state color_b: Float = 1.0
    state color_mode: Int = 0   // 0=fire, 1=ocean, 2=neon, 3=monochrome

    // Simulation state
    state sim_time: Float = 0.0
    state frames: Int = 0
    state active_particles: Int = 0
    state gpu_memory_mb: Int = 0

    // Surfaces
    surface shader_canvas => ParticleVisualizer
    surface native_ui => ParticleHUD

// ═══════════════════════════════════════════════════════════════════════════
//  FRAGMENT SHADER — particle visualization
// ═══════════════════════════════════════════════════════════════════════════
// Renders a field of particles as glowing points. Each pixel tests against
// a procedural particle distribution using the uniform parameters.
// In the real pipeline, a compute shader would write particle positions
// to a StorageBuffer and this fragment shader would read them.

shader fragment ParticleVisualizer(uv: Vec2) -> Vec4:
    uniform time: Float @0
    uniform resolution: Vec2 @1
    uniform particle_params: Vec4 @2      // .x=count, .y=speed, .z=spread, .w=lifetime
    uniform color_rgb: Vec4 @3            // .x=r, .y=g, .z=b, .w=mode
    uniform _pad: StorageBuffer<Float> @4

    let px: Float = uv.x
    let py: Float = uv.y
    let t: Float = time
    let count: Float = particle_params.x
    let spd: Float = particle_params.y
    let spread: Float = particle_params.z
    let life: Float = particle_params.w
    let cr: Float = color_rgb.x
    let cg: Float = color_rgb.y
    let cb: Float = color_rgb.z
    let cmode: Float = color_rgb.w

    var accum_r: Float = 0.0
    var accum_g: Float = 0.0
    var accum_b: Float = 0.0
    var accum_a: Float = 0.0

    // ── Procedural particle field ────────────────────────────────
    // Instead of reading a StorageBuffer, we procedurally generate
    // particle positions using sin/cos hashing from pixel position.
    // Each "particle" is a bright point that moves over time.
    // This simulates the visual result of a compute-shader particle
    // simulation without needing the actual buffer.

    var i: Int = 0
    while i < 32:
        let fi: Float = Float(i)
        let seed: Float = fi * 127.1 + 311.7

        // Particle position: procedural orbit
        let angle: Float = seed * 0.1 + t * spd * (0.5 + fi * 0.02)
        let radius: Float = 0.2 + sin(seed * 0.05 + t * 0.3) * 0.3 * spread
        let px_part: Float = 0.5 + cos(angle) * radius
        let py_part: Float = 0.5 + sin(angle * 1.3) * radius * 0.7

        // Distance from this pixel to particle center
        let dx: Float = px - px_part
        let dy: Float = py - py_part
        let dist: Float = sqrt(dx*dx + dy*dy)

        // Particle glow: exponential falloff
        let particle_size: Float = 0.008 + sin(seed * 0.03) * 0.004
        let glow: Float = max(0.0, 1.0 - dist / particle_size)
        let glow_sq: Float = glow * glow

        // Particle brightness modulated by lifetime phase
        let phase: Float = (t * spd * 0.7 + seed * 0.02)
        var phase_frac: Float = phase
        while phase_frac > 1.0:
            phase_frac = phase_frac - 1.0
        let life_brightness: Float = 1.0 - phase_frac * phase_frac

        // Color by mode
        var pr: Float = cr
        var pg: Float = cg
        var pb: Float = cb

        // Mode 0: Fire — red/orange/yellow gradient by phase
        let fire_r: Float = 1.0
        let fire_g: Float = 0.5 + phase_frac * 0.5
        let fire_b: Float = phase_frac * 0.3

        // Mode 1: Ocean — blue/teal/white gradient
        let ocean_r: Float = phase_frac * 0.3
        let ocean_g: Float = 0.4 + phase_frac * 0.6
        let ocean_b: Float = 0.6 + phase_frac * 0.4

        // Mode 2: Neon — cycling rainbow
        let hue: Float = (seed * 0.01 + t * spd * 0.5 + fi * 0.1)
        var hue_frac: Float = hue
        while hue_frac > 1.0:
            hue_frac = hue_frac - 1.0
        let neon_r: Float = sin(hue_frac * 6.28) * 0.5 + 0.5
        let neon_g: Float = sin(hue_frac * 6.28 + 2.09) * 0.5 + 0.5
        let neon_b: Float = sin(hue_frac * 6.28 + 4.19) * 0.5 + 0.5

        // Mode 3: Monochrome — single color with brightness variation
        let mono_r: Float = cr * (0.5 + phase_frac * 0.5)
        let mono_g: Float = cg * (0.5 + phase_frac * 0.5)
        let mono_b: Float = cb * (0.5 + phase_frac * 0.5)

        // Select by mode
        let m0: Float = step(cmode, 0.0)
        let m1: Float = step(cmode, 0.99) - m0
        let m2: Float = step(cmode, 1.99) - m0 - m1
        let m3: Float = 1.0 - m0 - m1 - m2

        pr = m0*fire_r + m1*ocean_r + m2*neon_r + m3*mono_r
        pg = m0*fire_g + m1*ocean_g + m2*neon_g + m3*mono_g
        pb = m0*fire_b + m1*ocean_b + m2*neon_b + m3*mono_b

        accum_r = accum_r + glow_sq * pr * life_brightness
        accum_g = accum_g + glow_sq * pg * life_brightness
        accum_b = accum_b + glow_sq * pb * life_brightness
        accum_a = accum_a + glow_sq * life_brightness

        i = i + 1

    // ── Background: subtle dark gradient ─────────────────────────
    let bg_r: Float = 0.02 + px * 0.03
    let bg_g: Float = 0.02 + py * 0.03
    let bg_b: Float = 0.04

    let out_r: Float = max(0.0, min(1.0, bg_r + accum_r))
    let out_g: Float = max(0.0, min(1.0, bg_g + accum_g))
    let out_b: Float = max(0.0, min(1.0, bg_b + accum_b))

    return vec4(out_r, out_g, out_b, 1.0)

// ═══════════════════════════════════════════════════════════════════════════
//  TOP-LEVEL FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

fn color_mode_name(m: Int) -> String:
    if m == 0: return "Fire"
    elif m == 1: return "Ocean"
    elif m == 2: return "Neon"
    return "Monochrome"

fn particle_count_text() -> String:
    return "Particles: " + str(ParticleWorld.particle_count)

fn emit_rate_text() -> String:
    return "Emit rate: " + str(ParticleWorld.emit_rate) + "/frame"

fn gravity_text() -> String:
    return "Gravity: " + str(ParticleWorld.gravity)

fn speed_text() -> String:
    return "Speed: " + str(ParticleWorld.speed)

fn color_text() -> String:
    return "Theme: " + color_mode_name(ParticleWorld.color_mode)

fn frame_text() -> String:
    return "Frame " + str(ParticleWorld.frames)

fn gpu_mem_text() -> String:
    return "GPU mem est: " + str(ParticleWorld.gpu_memory_mb) + " MB"

fn particle_params_text() -> String:
    return "Count=" + str(ParticleWorld.particle_count) + " Rate=" + str(ParticleWorld.emit_rate) + " Gravity=" + str(ParticleWorld.gravity)

fn read_all_fields() -> Int:
    let a = ParticleWorld.particle_count + ParticleWorld.emit_rate
    let b: Float = ParticleWorld.gravity + ParticleWorld.speed + ParticleWorld.spread + ParticleWorld.lifetime
    let c: Float = ParticleWorld.color_r + ParticleWorld.color_g + ParticleWorld.color_b
    let d = ParticleWorld.color_mode + ParticleWorld.frames + ParticleWorld.active_particles + ParticleWorld.gpu_memory_mb
    return a + d

// ═══════════════════════════════════════════════════════════════════════════
//  COMPONENT: ParticleHUD — telemetry overlay for the particle system
// ═══════════════════════════════════════════════════════════════════════════

component ParticleHUD():
    render <panel title="Kain Particle World">
        <stack direction="vertical" padding={20} spacing={12}>
            // Header
            <stack direction="horizontal" spacing={16}>
                <text value="PARTICLE WORLD" font_size={20} />
                <text value={color_text()} font_size={12} />
            </stack>

            // Live telemetry
            <text value="── SIMULATION ──" font_size={14} />
            <stack direction="vertical" spacing={6}>
                <text value={frame_text()} font_size={18} />
                <text value={particle_count_text()} font_size={12} />
                <text value={emit_rate_text()} font_size={12} />
                <text value={gravity_text()} font_size={12} />
                <text value={speed_text()} font_size={12} />
                <text value={gpu_mem_text()} font_size={12} />
            </stack>

            // Color themes
            <text value="── COLOR THEMES ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value="0: Fire — red/orange/yellow particles on dark bg" font_size={10} />
                <text value="1: Ocean — blue/teal/white underwater effect" font_size={10} />
                <text value="2: Neon — cycling rainbow particle trails" font_size={10} />
                <text value="3: Monochrome — single color with brightness variation" font_size={10} />
            </stack>

            // Architecture
            <text value="── ARCHITECTURE ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value="Compute shader → StorageBuffer → Fragment shader visualization" font_size={10} />
                <text value="World state bridges: simulation params → shader uniforms → component display" font_size={10} />
                <text value="ParticleWorld owns: count, emit rate, gravity, speed, spread, lifetime" font_size={10} />
                <text value="surface shader_canvas => ParticleVisualizer | surface native_ui => ParticleHUD" font_size={10} />
            </stack>

            // Footer
            <text value="─────────────────────────────────────────────" font_size={10} />
            <text value={particle_params_text()} font_size={9} />
            <text value={str(read_all_fields())} font_size={7} />
        </stack>
    </panel>

// ═══════════════════════════════════════════════════════════════════════════
//  ENTRY POINT
// ═══════════════════════════════════════════════════════════════════════════

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    // Dead-state validator reads
    let _count: Int = ParticleWorld.particle_count
    let _rate: Int = ParticleWorld.emit_rate
    let _grav: Float = ParticleWorld.gravity
    let _spd: Float = ParticleWorld.speed
    let _spread: Float = ParticleWorld.spread
    let _life: Float = ParticleWorld.lifetime
    let _cr: Float = ParticleWorld.color_r
    let _cg: Float = ParticleWorld.color_g
    let _cb: Float = ParticleWorld.color_b
    let _cm: Int = ParticleWorld.color_mode
    let _time: Float = ParticleWorld.sim_time
    let _frames: Int = ParticleWorld.frames
    let _active: Int = ParticleWorld.active_particles
    let _gpu_mem: Int = ParticleWorld.gpu_memory_mb

    // TWO frame loops auto-generated:
    // LOOP A (surface shader_canvas): resolve("shader_canvas") → load_shader → set_uniform per frame
    //   The fragment shader ParticleVisualizer receives particle params as uniforms
    // LOOP B (surface native_ui): resolve("native_ui") → ParticleHUD_render every frame
    //   The component displays live telemetry from ParticleWorld

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    return 0
