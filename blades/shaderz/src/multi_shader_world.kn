// ═══════════════════════════════════════════════════════════════════════════
//  multi_shader_world.kn — One World, Three Visual Modes, One Shader
//
//  A single world projects to ONE fragment shader that internally switches
//  between three visual modes (plasma, waves, fractal tunnel) based on a
//  mode uniform. The component overlay shows live telemetry and controls.
//
//  ARCHITECTURE:
//    MultiShaderWorld
//      ├── surface shader_canvas => TripleShader        (3-in-1 GPU shader)
//      └── surface native_ui    => ShaderSelector        (component HUD)
//
//  WHY one shader surface: A world can only declare one surface per kind.
//  Mode switching via uniforms lets one shader render N visual styles.
// ═══════════════════════════════════════════════════════════════════════════

use std::runtime

// ═══════════════════════════════════════════════════════════════════════════
//  WORLD — multi-mode shader authority
// ═══════════════════════════════════════════════════════════════════════════

world MultiShaderWorld:
    // Shared shader parameters — all three modes read these
    state sim_time: Float = 0.0
    state speed: Float = 1.0
    state complexity: Float = 0.5
    state zoom: Float = 1.0
    state hue_shift: Float = 0.0
    state mouse_x: Float = 0.5
    state mouse_y: Float = 0.5

    // Mode selection
    state shader_mode: Int = 0       // 0=plasma, 1=waves, 2=tunnel

    // Display
    state frames: Int = 0

    // One shader surface + one component surface
    surface shader_canvas => TripleShader
    surface native_ui => ShaderSelector

// ═══════════════════════════════════════════════════════════════════════════
//  TRIPLE SHADER — three visual modes in one fragment shader
// ═══════════════════════════════════════════════════════════════════════════
// Mode 0: Plasma — warped sine rings with zoom
// Mode 1: Waves — horizontal/vertical wave interference
// Mode 2: Tunnel — recursive fractal zoom

shader fragment TripleShader(uv: Vec2) -> Vec4:
    uniform time: Float @0
    uniform resolution: Vec2 @1
    uniform params: Vec4 @2           // .x=speed, .y=complexity, .z=zoom, .w=hue_shift
    uniform mode_vec: Vec4 @3         // .x=mode (0=plasma, 1=waves, 2=tunnel)
    uniform _pad: StorageBuffer<Float> @4

    let px: Float = uv.x
    let py: Float = uv.y
    let t: Float = time
    let spd: Float = params.x
    let cmplx: Float = params.y
    let zm: Float = params.z
    let hue: Float = params.w
    let mode_val: Float = mode_vec.x

    var r: Float = 0.0
    var g: Float = 0.0
    var b: Float = 0.0

    // ── MODE 0: Warped Plasma ────────────────────────────────────
    let zx: Float = (px - 0.5) * zm + 0.5
    let zy: Float = (py - 0.5) * zm + 0.5
    let r1: Float = sqrt((zx - 0.4)*(zx - 0.4) + (zy - 0.3)*(zy - 0.3))
    let r2: Float = sqrt((zx - 0.6)*(zx - 0.6) + (zy - 0.7)*(zy - 0.7))
    let r3: Float = sqrt((zx - 0.5)*(zx - 0.5) + (zy - 0.5)*(zy - 0.5))
    let v1: Float = sin(r1 * 6.0 * cmplx + t * spd * 0.8) * 0.5 + 0.5
    let v2: Float = sin(r2 * 5.0 * cmplx + t * spd * 1.1) * 0.5 + 0.5
    let v3: Float = sin(r3 * 7.0 * cmplx - t * spd * 0.6) * 0.5 + 0.5
    let plasma_r: Float = sin(v1 * 6.28 + hue * 2.0) * 0.6 + 0.4
    let plasma_g: Float = sin(v2 * 6.28 + hue * 4.0) * 0.5 + 0.5
    let plasma_b: Float = sin(v3 * 6.28 + hue * 1.5) * 0.7 + 0.3

    // ── MODE 1: Wave Interference ────────────────────────────────
    let w1: Float = sin(px * 8.0 * cmplx + t * spd * 1.5) * 0.5 + 0.5
    let w2: Float = sin(py * 6.0 * cmplx + t * spd * 1.2 + px * 3.0) * 0.5 + 0.5
    let w3: Float = sin((px + py) * 5.0 * cmplx + t * spd * 0.9) * 0.5 + 0.5
    let w4: Float = sin((px - py) * 7.0 * cmplx + t * spd * 1.7) * 0.5 + 0.5
    let wave: Float = (w1 + w2 + w3 + w4) * 0.25
    let wave_sq: Float = wave * wave
    let wave_r: Float = wave * (0.6 + hue * 0.3) + wave_sq * 0.3
    let wave_g: Float = wave * (0.4 + hue * 0.4) + wave_sq * 0.2
    let wave_b: Float = wave * (0.8 - hue * 0.3) + wave_sq * 0.1

    // ── MODE 2: Fractal Tunnel ───────────────────────────────────
    var cx: Float = (px - 0.5) * zm
    var cy: Float = (py - 0.5) * zm
    var iter: Int = 0
    var total: Float = 0.0
    var escaped: Bool = false
    while iter < 8:
        if escaped == false:
            let angle: Float = t * spd * 0.3 + Float(iter) * 0.5
            let c: Float = cos(angle)
            let s: Float = sin(angle)
            let rx: Float = cx * c - cy * s
            let ry: Float = cx * s + cy * c
            let fx: Float = abs(rx)
            let fy: Float = abs(ry)
            let scale: Float = 0.5 + cmplx * 0.5
            cx = fx * (2.0 - scale)
            cy = fy * (2.0 - scale)
            let dist: Float = sqrt(cx*cx + cy*cy)
            if dist > 2.0:
                escaped = true
            total = total + dist * 0.2
            iter = iter + 1
    let tunnel: Float = total * 0.3
    let tunnel_r: Float = sin(tunnel * 8.0 + hue * 3.0 + t * spd * 0.4) * 0.5 + 0.5
    let tunnel_g: Float = sin(tunnel * 7.0 + hue * 5.0 + t * spd * 0.6) * 0.5 + 0.5
    let tunnel_b: Float = sin(tunnel * 6.0 + hue * 2.0 + t * spd * 0.3) * 0.5 + 0.5

    // ── Branchless mode selection via step() ─────────────────────
    let m0: Float = step(mode_val, 0.0)
    let m1: Float = step(mode_val, 0.99) - m0
    let m2: Float = 1.0 - m0 - m1

    r = m0*plasma_r + m1*wave_r + m2*tunnel_r
    g = m0*plasma_g + m1*wave_g + m2*tunnel_g
    b = m0*plasma_b + m1*wave_b + m2*tunnel_b

    // ── Vignette ─────────────────────────────────────────────────
    let cx2: Float = px - 0.5
    let cy2: Float = py - 0.5
    let edge: Float = sqrt(cx2*cx2 + cy2*cy2)
    let vig: Float = 1.0 - edge * 0.4

    let out_r: Float = max(0.0, min(1.0, r * vig))
    let out_g: Float = max(0.0, min(1.0, g * vig))
    let out_b: Float = max(0.0, min(1.0, b * vig))

    return vec4(out_r, out_g, out_b, 1.0)

// ═══════════════════════════════════════════════════════════════════════════
//  TOP-LEVEL FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

fn mode_name(m: Int) -> String:
    if m == 0: return "Plasma Sphere"
    elif m == 1: return "Wave Field"
    return "Fractal Tunnel"

fn mode_is_plasma() -> Bool:
    return MultiShaderWorld.shader_mode == 0

fn mode_is_wave() -> Bool:
    return MultiShaderWorld.shader_mode == 1

fn mode_is_tunnel() -> Bool:
    return MultiShaderWorld.shader_mode == 2

fn plasma_active_text() -> String:
    if mode_is_plasma(): return "● ACTIVE"
    return "○"

fn wave_active_text() -> String:
    if mode_is_wave(): return "● ACTIVE"
    return "○"

fn tunnel_active_text() -> String:
    if mode_is_tunnel(): return "● ACTIVE"
    return "○"

fn frame_label() -> String:
    return "Frame " + str(MultiShaderWorld.frames)

fn mode_label() -> String:
    return "Active: " + mode_name(MultiShaderWorld.shader_mode)

fn speed_label() -> String:
    return "Speed: " + str(MultiShaderWorld.speed)

fn complexity_label() -> String:
    return "Complexity: " + str(MultiShaderWorld.complexity)

fn zoom_label() -> String:
    return "Zoom: " + str(MultiShaderWorld.zoom)

fn hue_label() -> String:
    return "Hue shift: " + str(MultiShaderWorld.hue_shift)

fn read_all_fields() -> Int:
    let a: Float = MultiShaderWorld.sim_time + MultiShaderWorld.speed + MultiShaderWorld.complexity
    let b: Float = MultiShaderWorld.zoom + MultiShaderWorld.hue_shift
    return MultiShaderWorld.frames + MultiShaderWorld.shader_mode

// ═══════════════════════════════════════════════════════════════════════════
//  COMPONENT: ShaderSelector — shows active mode and all options
// ═══════════════════════════════════════════════════════════════════════════

component ShaderSelector():
    render <panel title="Kain Multi-Mode Shader World">
        <stack direction="vertical" padding={20} spacing={12}>
            // Header
            <text value="MULTI-MODE SHADER WORLD" font_size={20} />
            <text value={mode_label()} font_size={14} />

            // Shader mode status
            <text value="── VISUAL MODES (one shader, three styles) ──" font_size={14} />
            <stack direction="vertical" spacing={6}>
                <text value={plasma_active_text() + "  Plasma Sphere   — warped sine rings + zoom"} font_size={11} />
                <text value={wave_active_text() + "  Wave Field      — 4-layer wave interference"} font_size={11} />
                <text value={tunnel_active_text() + "  Fractal Tunnel  — recursive zoom + mirror fold"} font_size={11} />
            </stack>

            // Live parameters
            <text value="── SHARED PARAMETERS ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value={frame_label()} font_size={16} />
                <text value={speed_label()} font_size={12} />
                <text value={complexity_label()} font_size={12} />
                <text value={zoom_label()} font_size={12} />
                <text value={hue_label()} font_size={12} />
            </stack>

            // Architecture
            <text value="── ARCHITECTURE ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value="surface shader_canvas => TripleShader  — one GPU shader, three modes" font_size={10} />
                <text value="surface native_ui    => ShaderSelector — component HUD overlay" font_size={10} />
                <text value="Mode switching via uniform: mode_vec.x = 0/1/2 selects visual style" font_size={10} />
                <text value="All parameters (speed, complexity, zoom, hue) shared across modes" font_size={10} />
            </stack>

            // Footer
            <text value="─────────────────────────────────────────────" font_size={10} />
            <text value="Plasma Sphere · Wave Field · Fractal Tunnel" font_size={9} />
            <text value={str(read_all_fields())} font_size={7} />
        </stack>
    </panel>

// ═══════════════════════════════════════════════════════════════════════════
//  ENTRY POINT
// ═══════════════════════════════════════════════════════════════════════════

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    // Dead-state validator reads
    let _time: Float = MultiShaderWorld.sim_time
    let _spd: Float = MultiShaderWorld.speed
    let _cmplx: Float = MultiShaderWorld.complexity
    let _zm: Float = MultiShaderWorld.zoom
    let _hue: Float = MultiShaderWorld.hue_shift
    let _mx: Float = MultiShaderWorld.mouse_x
    let _my: Float = MultiShaderWorld.mouse_y
    let _mode: Int = MultiShaderWorld.shader_mode
    let _frames: Int = MultiShaderWorld.frames

    // TWO frame loops auto-generated:
    // LOOP A (surface shader_canvas → TripleShader):
    //   resolve("shader_canvas") → get_gpu_extension → load_shader
    //   WHILE: set_uniform(mode_vec) → set_uniform(params)
    //          → begin_frame → vkCmdDraw(3) → end_frame → present
    //
    // LOOP B (surface native_ui → ShaderSelector):
    //   resolve("native_ui") → session_create → window_open
    //   WHILE: host_pump → begin_frame → ShaderSelector_render
    //          → end_frame → present

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    return 0
