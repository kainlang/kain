// ═══════════════════════════════════════════════════════════════════════════
//  shader_dashboard.kn — Component HUD Over Animated GPU Background
//
//  A monitoring dashboard where the BACKGROUND is a live GPU fragment shader
//  and the FOREGROUND is a component UI with metrics, controls, and status.
//  The shader's colors and motion reflect system state from the world.
//
//  ARCHITECTURE:
//    DashWorld
//      ├── surface shader_canvas => DashboardBackground   (GPU animated bg)
//      └── surface native_ui => DashboardOverlay       (component metrics UI)
//
//    World state holds metrics (cpu, memory, fps, alerts).
//    The shader background animates based on alert level and throughput.
//    The component overlay displays live numbers from the same world.
//
//  VISUAL DESIGN:
//    Background shader: calm blue waves when healthy, red pulses on alerts.
//    Component overlay: semi-transparent cards with metrics and status.
// ═══════════════════════════════════════════════════════════════════════════

use std::runtime

// ═══════════════════════════════════════════════════════════════════════════
//  WORLD — dashboard state authority
// ═══════════════════════════════════════════════════════════════════════════

world DashWorld:
    // System metrics
    state cpu_pct: Int = 23
    state memory_mb: Int = 147
    state disk_pct: Int = 31
    state network_kbs: Int = 2048
    state fps: Int = 60
    state uptime_hours: Int = 72
    state active_connections: Int = 12
    state error_count: Int = 0
    state alert_level: Int = 0      // 0=normal, 1=warning, 2=critical

    // Dashboard config
    state theme: String = "midnight"
    state refresh_rate: Int = 60
    state show_details: Bool = true

    // Shader parameters (mapped to fragment shader uniforms)
    state shader_time: Float = 0.0
    state shader_intensity: Float = 0.3

    // Frame counter
    state frames: Int = 0

    // Surfaces
    surface shader_canvas => DashboardBackground
    surface native_ui => DashboardOverlay

// ═══════════════════════════════════════════════════════════════════════════
//  FRAGMENT SHADER — animated dashboard background
// ═══════════════════════════════════════════════════════════════════════════
// The background reflects system health:
//   alert_level=0 → calm blue/purple waves
//   alert_level=1 → amber pulsing grid
//   alert_level=2 → red radial alarm pulses

shader fragment DashboardBackground(uv: Vec2) -> Vec4:
    uniform time: Float @0
    uniform resolution: Vec2 @1
    uniform alert_and_intensity: Vec2 @2    // .x=alert_level, .y=intensity
    uniform throughput: Float @3            // network throughput influence
    uniform _pad: StorageBuffer<Float> @4

    let px: Float = uv.x
    let py: Float = uv.y
    let t: Float = time
    let alert: Float = alert_and_intensity.x
    let intensity: Float = alert_and_intensity.y
    let thrpt: Float = throughput

    var r: Float = 0.0
    var g: Float = 0.0
    var b: Float = 0.0

    // ── Base: animated gradient grid ─────────────────────────────
    let grid_x: Float = sin(px * 8.0 + t * 0.3) * 0.5 + 0.5
    let grid_y: Float = sin(py * 6.0 + t * 0.4) * 0.5 + 0.5
    let grid_pattern: Float = (grid_x * grid_y) * 0.15

    // Slow background wave
    let wave1: Float = sin(py * 4.0 + t * 0.5 + px * 2.0) * 0.5 + 0.5
    let wave2: Float = sin(px * 5.0 - t * 0.6 + py * 3.0) * 0.5 + 0.5

    // ── Alert level 0: calm blue (healthy) ──────────────────────
    let calm_r: Float = 0.05 + grid_pattern * 0.3 + wave1 * 0.08
    let calm_g: Float = 0.08 + grid_pattern * 0.4 + wave2 * 0.06
    let calm_b: Float = 0.15 + grid_pattern * 0.6 + wave1 * 0.12

    // ── Alert level 1: amber pulsing grid ───────────────────────
    let alert_pulse: Float = sin(t * 3.0) * 0.5 + 0.5
    let amber_r: Float = 0.12 + grid_pattern * 0.5 + alert_pulse * 0.15
    let amber_g: Float = 0.08 + grid_pattern * 0.3 + alert_pulse * 0.08
    let amber_b: Float = 0.02 + grid_pattern * 0.1

    // ── Alert level 2: red radial alarm ─────────────────────────
    let cx: Float = px - 0.5
    let cy: Float = py - 0.5
    let dist: Float = sqrt(cx*cx + cy*cy)
    let alarm_pulse: Float = sin(dist * 10.0 - t * 5.0) * 0.5 + 0.5
    let red_r: Float = 0.08 + alarm_pulse * 0.35 + intensity * 0.3
    let red_g: Float = 0.01 + alarm_pulse * 0.06
    let red_b: Float = 0.01 + alarm_pulse * 0.04

    // ── Blend between alert levels ──────────────────────────────
    let is_calm: Float = step(alert, 0.0)
    let is_warn: Float = step(alert, 0.99) - is_calm
    let is_crit: Float = 1.0 - is_calm - is_warn

    r = is_calm*calm_r + is_warn*amber_r + is_crit*red_r
    g = is_calm*calm_g + is_warn*amber_g + is_crit*red_g
    b = is_calm*calm_b + is_warn*amber_b + is_crit*red_b

    // ── Throughput indicator: subtle scan line ──────────────────
    let scan_y: Float = (t * thrpt * 0.1)
    let scan_y_frac: Float = scan_y
    var scan_y_mod: Float = scan_y_frac
    while scan_y_mod > 1.0:
        scan_y_mod = scan_y_mod - 1.0
    let scan_dist: Float = abs(py - scan_y_mod)
    let scan_line: Float = max(0.0, 1.0 - scan_dist * 20.0) * 0.08

    r = r + scan_line
    g = g + scan_line * 0.7
    b = b + scan_line * 0.4

    // ── Vignette ─────────────────────────────────────────────────
    let edge: Float = sqrt(cx*cx + cy*cy)
    let vig: Float = 1.0 - edge * 0.6

    let out_r: Float = max(0.0, min(1.0, r * vig))
    let out_g: Float = max(0.0, min(1.0, g * vig))
    let out_b: Float = max(0.0, min(1.0, b * vig))

    return vec4(out_r, out_g, out_b, 1.0)

// ═══════════════════════════════════════════════════════════════════════════
//  TOP-LEVEL FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

fn alert_name(level: Int) -> String:
    if level == 0: return "● HEALTHY"
    elif level == 1: return "◐ WARNING"
    return "✕ CRITICAL"

fn alert_is_normal() -> Bool:
    return DashWorld.alert_level == 0

fn alert_is_warning() -> Bool:
    return DashWorld.alert_level == 1

fn fmt_pct(v: Int) -> String:
    return str(v) + "%"

fn fmt_mb(v: Int) -> String:
    return str(v) + " MB"

fn fmt_kbs(v: Int) -> String:
    return str(v) + " KB/s"

fn uptime_days(hours: Int) -> String:
    let d: Int = hours / 24
    let h: Int = hours
    if d > 0:
        h = hours - d * 24
    return str(d) + "d " + str(h) + "h"

fn frame_text() -> String:
    return "Frame " + str(DashWorld.frames)

fn theme_text() -> String:
    return "Theme: " + DashWorld.theme

fn shader_label() -> String:
    return "Background: surface shader_canvas => DashboardBackground"

fn ui_label() -> String:
    return "Foreground: surface native_ui => DashboardOverlay"

fn arch_label() -> String:
    return "One world, two surfaces, one data source"

fn read_all_fields() -> Int:
    let a = DashWorld.cpu_pct + DashWorld.memory_mb + DashWorld.disk_pct
    let b = DashWorld.network_kbs + DashWorld.fps + DashWorld.uptime_hours
    let c = DashWorld.active_connections + DashWorld.error_count + DashWorld.alert_level
    let d = DashWorld.refresh_rate
    let e: Float = DashWorld.shader_time + DashWorld.shader_intensity
    return a + b + c + d

// ═══════════════════════════════════════════════════════════════════════════
//  COMPONENT: MetricCard — a single dashboard metric
// ═══════════════════════════════════════════════════════════════════════════

component MetricCard(label: String, value: String, unit: String):
    render <stack direction="vertical" padding={8} spacing={3}>
        <text value={label} font_size={10} />
        <stack direction="horizontal" spacing={4}>
            <text value={value} font_size={20} />
            <text value={unit} font_size={10} />
        </stack>
    </stack>

// ═══════════════════════════════════════════════════════════════════════════
//  COMPONENT: MetricRow — horizontal cluster of metric cards
// ═══════════════════════════════════════════════════════════════════════════

component MetricRow():
    render <stack direction="horizontal" spacing={16}>
        <MetricCard label="CPU" value={fmt_pct(DashWorld.cpu_pct)} unit="" />
        <MetricCard label="Memory" value={fmt_mb(DashWorld.memory_mb)} unit="" />
        <MetricCard label="Disk" value={fmt_pct(DashWorld.disk_pct)} unit="" />
        <MetricCard label="Network" value={fmt_kbs(DashWorld.network_kbs)} unit="" />
    </stack>

component SecondRow():
    render <stack direction="horizontal" spacing={16}>
        <MetricCard label="FPS" value={str(DashWorld.fps)} unit="" />
        <MetricCard label="Uptime" value={uptime_days(DashWorld.uptime_hours)} unit="" />
        <MetricCard label="Connections" value={str(DashWorld.active_connections)} unit="active" />
        <MetricCard label="Errors" value={str(DashWorld.error_count)} unit="total" />
    </stack>

// ═══════════════════════════════════════════════════════════════════════════
//  COMPONENT: StatusPanel — shows alert level with color-coded text
// ═══════════════════════════════════════════════════════════════════════════

component StatusPanel():
    render <stack direction="vertical" padding={8} spacing={8}>
        <text value={"SYSTEM STATUS"} font_size={13} />
        <text value={alert_name(DashWorld.alert_level)} font_size={18} />
        <text value={"Throughput: " + fmt_kbs(DashWorld.network_kbs)} font_size={11} />
        <text value={"Errors (24h): " + str(DashWorld.error_count)} font_size={11} />
        <text value="" font_size={1} />
        <text value="── BACKGROUND SHADER ──" font_size={11} />
        <text value={shader_label()} font_size={10} />
        <text value="Alert level drives shader color palette:" font_size={9} />
        <text value="  0 = calm blue waves · 1 = amber pulses · 2 = red alarms" font_size={9} />
    </stack>

// ═══════════════════════════════════════════════════════════════════════════
//  COMPONENT: DashboardOverlay — the root component
// ═══════════════════════════════════════════════════════════════════════════

component DashboardOverlay():
    render <panel title="Kain Shader Dashboard">
        <stack direction="vertical" padding={20} spacing={16}>
            // Header
            <stack direction="horizontal" spacing={16}>
                <text value="SHADER DASHBOARD" font_size={20} />
                <text value={alert_name(DashWorld.alert_level)} font_size={12} />
                <text value={theme_text()} font_size={11} />
            </stack>

            // Live metrics
            <text value="── SYSTEM METRICS ──" font_size={14} />
            <MetricRow />
            <SecondRow />

            // Status
            <StatusPanel />

            // Architecture
            <text value="── ARCHITECTURE ──" font_size={14} />
            <stack direction="vertical" spacing={4}>
                <text value={ui_label()} font_size={10} />
                <text value={shader_label()} font_size={10} />
                <text value={arch_label()} font_size={10} />
            </stack>

            // Footer
            <text value="─────────────────────────────────────────────" font_size={10} />
            <stack direction="horizontal" spacing={16}>
                <text value={frame_text()} font_size={10} />
                <text value="shaderz/shader_dashboard.kn" font_size={9} />
            </stack>
            <text value={str(read_all_fields())} font_size={7} />
        </stack>
    </panel>

// ═══════════════════════════════════════════════════════════════════════════
//  ENTRY POINT
// ═══════════════════════════════════════════════════════════════════════════

fn main() -> Int:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    // Dead-state validator reads
    let _cpu: Int = DashWorld.cpu_pct
    let _mem: Int = DashWorld.memory_mb
    let _disk: Int = DashWorld.disk_pct
    let _net: Int = DashWorld.network_kbs
    let _fps: Int = DashWorld.fps
    let _uptime: Int = DashWorld.uptime_hours
    let _conn: Int = DashWorld.active_connections
    let _err: Int = DashWorld.error_count
    let _alert: Int = DashWorld.alert_level
    let _theme: String = DashWorld.theme
    let _refresh: Int = DashWorld.refresh_rate
    let _show: Bool = DashWorld.show_details
    let _time: Float = DashWorld.shader_time
    let _intensity: Float = DashWorld.shader_intensity
    let _frames: Int = DashWorld.frames

    // TWO frame loops auto-generated:
    // LOOP A (surface shader_canvas):  resolve("shader_canvas") → load_shader → set_uniform per frame
    // LOOP B (surface native_ui): resolve("native_ui") → DashboardOverlay_render every frame

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    return 0
