use common::build_error_payload
use common::build_tool_result
use common::command_result_payload
use common::command_summary
use common::optional_bool_param
use common::optional_string_param
use common::resolve_from_base
use runtime_settings::McpRuntimeSettings

fn load_examples_manifest(settings: McpRuntimeSettings) -> Any:
    return json_parse(read_file(settings.examples_manifest_path))

pub fn handle_authoring_topics(settings: McpRuntimeSettings, _params: Any) -> Any:
    let manifest = load_examples_manifest(settings)
    let examples = json_get(manifest, "examples")
    let structured = json_object_new()
    json_object_set(structured, "suite_name", json_get_string(manifest, "suite_name"))
    json_object_set(structured, "schema_version", json_get_int(manifest, "schema_version"))
    json_object_set(structured, "notes", json_get(manifest, "notes"))
    json_object_set(structured, "example_count", len(examples))
    json_object_set(structured, "examples", examples)
    let summary = "Loaded " + str(len(examples)) + " authoring examples from docs/examples."
    return build_tool_result(summary, structured, true, false)

pub fn handle_authoring_example(settings: McpRuntimeSettings, params: Any) -> Any:
    let requested = optional_string_param(params, "path", optional_string_param(params, "example", ""))
    if len(requested) == 0:
        let payload = build_error_payload("Pass `path` or `example` with a docs/examples file name.")
        return build_tool_result("No example path was provided.", payload, true, true)

    let manifest = load_examples_manifest(settings)
    let examples = json_get(manifest, "examples")
    for entry in examples:
        let entry_path = json_get_string(entry, "path")
        let entry_title = json_get_string(entry, "title")
        if entry_path == requested or entry_title == requested:
            let examples_root = path_parent(settings.examples_manifest_path)
            let absolute_path = resolve_from_base(examples_root, entry_path)
            let structured = json_object_new()
            json_object_set(structured, "suite_name", json_get_string(manifest, "suite_name"))
            json_object_set(structured, "absolute_path", absolute_path)
            json_object_set(structured, "entry", entry)
            json_object_set(structured, "source", read_file(absolute_path))
            return build_tool_result("Loaded authoring example " + entry_path, structured, true, false)

    let not_found_payload = build_error_payload("The docs/examples manifest does not contain that example.")
    return build_tool_result("Example not found: " + requested, not_found_payload, true, true)

pub fn handle_authoring_validate_examples(settings: McpRuntimeSettings, params: Any) -> Any:
    let args = []
    for item in settings.python_args:
        push(args, item)
    push(args, settings.examples_validator_path)
    push(args, "--kain")
    push(args, settings.kain_bin)

    let only = optional_string_param(params, "only", "")
    if len(only) > 0:
        push(args, "--only")
        push(args, only)

    let validation_class = optional_string_param(params, "validationClass", "")
    if len(validation_class) > 0:
        push(args, "--class")
        push(args, validation_class)

    let output_root = optional_string_param(params, "outputRoot", "")
    if len(output_root) > 0:
        push(args, "--output-root")
        push(args, resolve_from_base(settings.repo_root, output_root))

    if optional_bool_param(params, "keepOutput", false):
        push(args, "--keep-output")

    let result = command_run(settings.python_program, args, settings.repo_root)
    let structured = command_result_payload(result)
    json_object_set(structured, "validator", settings.examples_validator_path)
    json_object_set(structured, "kain_bin", settings.kain_bin)
    let summary = command_summary("docs/examples validation", result)
    return build_tool_result(summary, structured, true, !result.success)
