use common::resolve_from_base
use kain_config::config_env_bool
use kain_config::config_env_string
use kain_config::config_load_json_file
use kain_config::config_parse_csv
use kain_config::config_resolve_path_field
use kain_config::config_string_array_field

pub struct McpRuntimeSettings:
    blade_root: String
    repo_root: String
    kain_bin: String
    python_program: String
    python_args: Array<String>
    allow_writes: Bool
    include_hidden: Bool
    skip_dirs: Array<String>
    timeout_ms: Int
    max_list_entries: Int
    default_read_limit: Int
    tool_registry_path: String
    examples_manifest_path: String
    examples_validator_path: String

fn resolve_blade_root() -> String:
    let current = cwd()
    let override_root = env("KAIN_MCP_BLADE_ROOT").trim()
    if len(override_root) > 0:
        return resolve_from_base(current, override_root)
    let repo_local_blade = path_join(current, "blades/kain-mcp")
    if path_is_dir(path_join(repo_local_blade, "config")):
        return repo_local_blade
    if path_is_dir(path_join(current, "config")):
        return current
    if path_file_name(current) == "src":
        return path_parent(current)
    let parent = path_parent(current)
    let parent_repo_local_blade = path_join(parent, "blades/kain-mcp")
    if path_is_dir(path_join(parent_repo_local_blade, "config")):
        return parent_repo_local_blade
    if path_is_dir(path_join(parent, "config")):
        return parent
    return current

fn load_runtime_policy(blade_root: String) -> Any:
    let policy_path = path_join(blade_root, "config/runtime_policy.json")
    return config_load_json_file(policy_path)

fn resolve_repo_root(policy: Any, blade_root: String) -> String:
    let environment = json_get(policy, "environment")
    let repo_root_keys = config_string_array_field(environment, "repo_root_keys")
    return config_env_string(repo_root_keys, path_parent(path_parent(blade_root)))

fn resolve_kain_bin(policy: Any, repo_root: String) -> String:
    let environment = json_get(policy, "environment")
    let override_key = json_get_string(environment, "kain_bin_override_key")
    let override_path = env(override_key).trim()
    if len(override_path) > 0:
        return override_path

    let fallback_command = "kain"
    let candidates = config_string_array_field(policy, "kain_binary_candidates")
    for candidate in candidates:
        if candidate.starts_with("PATH:"):
            return substring(candidate, len("PATH:"), len(candidate))
        let candidate_path = resolve_from_base(repo_root, candidate)
        if file_exists(candidate_path):
            return candidate_path
    return fallback_command

pub fn load_runtime_settings() -> McpRuntimeSettings:
    let blade_root = resolve_blade_root()
    let policy = load_runtime_policy(blade_root)
    let environment = json_get(policy, "environment")
    let defaults = json_get(policy, "defaults")
    let paths = json_get(policy, "paths")
    let python_runner = json_get(policy, "python_runner")

    let repo_root = resolve_repo_root(policy, blade_root)
    let kain_bin = resolve_kain_bin(policy, repo_root)

    let allow_writes = config_env_bool(json_get_string(environment, "allow_writes_key"), json_get_bool(defaults, "allow_writes"))
    let include_hidden = config_env_bool(json_get_string(environment, "include_hidden_key"), json_get_bool(defaults, "include_hidden"))

    let skip_dirs = config_string_array_field(defaults, "skip_dirs")
    let skip_override = env(json_get_string(environment, "skip_dirs_key")).trim()
    if len(skip_override) > 0:
        skip_dirs = config_parse_csv(skip_override)

    return McpRuntimeSettings {
        blade_root: blade_root,
        repo_root: repo_root,
        kain_bin: kain_bin,
        python_program: json_get_string(python_runner, "program"),
        python_args: config_string_array_field(python_runner, "args"),
        allow_writes: allow_writes,
        include_hidden: include_hidden,
        skip_dirs: skip_dirs,
        timeout_ms: json_get_int(defaults, "timeout_ms"),
        max_list_entries: json_get_int(defaults, "max_list_entries"),
        default_read_limit: json_get_int(defaults, "default_read_limit"),
        tool_registry_path: config_resolve_path_field(blade_root, paths, "tools_manifest", "config/tools.json"),
        examples_manifest_path: config_resolve_path_field(blade_root, paths, "examples_manifest", "../../docs/examples/examples_manifest.json"),
        examples_validator_path: config_resolve_path_field(blade_root, paths, "examples_validator", "../../docs/examples/validate_examples.py"),
    }
