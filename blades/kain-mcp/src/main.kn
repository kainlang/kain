use common::build_error_payload
use common::build_tool_result
use kain_log::log_eprint_message
use kain_log::log_level_info
use protocol::*
use runtime_settings::*
use tool_dispatch::dispatch_tool_handler
use tool_registry::*

fn initialize_response(registry: ToolRegistry, raw_request: String) -> String:
    let request = json_parse(raw_request)
    let requested_protocol = ""
    if json_has(request, "params"):
        let params = json_get(request, "params")
        if json_has(params, "protocolVersion"):
            requested_protocol = json_get_string(params, "protocolVersion")
    return build_jsonrpc_success(raw_request, build_initialize_result(registry, requested_protocol))

fn write_denied_result() -> Any:
    let payload = build_error_payload("Set KAIN_MCP_ALLOW_WRITES=1 before launching the server.")
    return build_tool_result("Write tools are disabled for this MCP session.", payload, true, true)

fn handle_tool_call(settings: McpRuntimeSettings, registry: ToolRegistry, raw_request: String) -> String:
    let request = json_parse(raw_request)
    let params = json_get(request, "params")
    let tool_name = json_get_string(params, "name")
    let tool_args = json_object_new()
    if json_has(params, "arguments"):
        tool_args = json_get(params, "arguments")

    let handler = resolve_tool_handler(registry, tool_name)
    if len(handler) == 0:
        return build_jsonrpc_error(raw_request, -32601, "Unknown tool: " + tool_name)

    if !settings.allow_writes:
        if resolve_tool_write_flag(registry, tool_name):
            return build_jsonrpc_success(raw_request, write_denied_result())

    let dispatch = dispatch_tool_handler(settings, handler, tool_args)
    if dispatch.handled:
        return build_jsonrpc_success(raw_request, dispatch.result)

    return build_jsonrpc_success(raw_request, build_tool_result("Unsupported handler id: " + handler, build_error_payload("The tool registry referenced a handler the blade does not implement."), true, true))

fn route_request(settings: McpRuntimeSettings, registry: ToolRegistry, raw_request: String) -> String:
    let request = json_parse(raw_request)
    let method = json_get_string(request, "method")
    if method == "initialize":
        return initialize_response(registry, raw_request)
    if method == "notifications/initialized":
        return build_jsonrpc_success(raw_request, json_parse("null"))
    if method == "shutdown":
        return build_jsonrpc_success(raw_request, json_parse("null"))
    if method == "ping":
        return build_jsonrpc_success(raw_request, json_object_new())
    if method == "tools/list":
        let result = build_tools_list_result(registry)
        return build_jsonrpc_success(raw_request, result)
    if method == "tools/call":
        return handle_tool_call(settings, registry, raw_request)
    return build_jsonrpc_error(raw_request, -32601, "Method not found: " + method)

fn main() -> Int:
    let settings = load_runtime_settings()
    let registry = load_tool_registry(settings.tool_registry_path)

    log_eprint_message(log_level_info(), "kain-mcp", "starting at repo " + settings.repo_root)

    while true:
        let raw_request = read_next_request_frame()
        if len(raw_request) == 0:
            break
        let response = route_request(settings, registry, raw_request)
        write_response_frame(response)

    return 0
