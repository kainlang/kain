{
  "schema_version": 1,
  "environment": {
    "repo_root_keys": ["KAIN_REPO_ROOT", "KAIN_MCP_REPO_ROOT"],
    "kain_bin_override_key": "KAIN_MCP_KAIN_BIN",
    "allow_writes_key": "KAIN_MCP_ALLOW_WRITES",
    "include_hidden_key": "KAIN_MCP_INCLUDE_HIDDEN",
    "skip_dirs_key": "KAIN_MCP_SKIP_DIRS"
  },
  "paths": {
    "tools_manifest": "config/tools.json",
    "examples_manifest": "../../docs/examples/examples_manifest.json",
    "examples_validator": "../../docs/examples/validate_examples.py"
  },
  "python_runner": {
    "program": "py",
    "args": ["-3"]
  },
  "kain_binary_candidates": [
    "PATH:kain",
    "target/debug/kain.exe",
    "target/debug/kain",
    "target/release/kain.exe",
    "target/release/kain"
  ],
  "kain_launcher_dirs_windows": [
    "D:/Kain-Bazel/bin"
  ],
  "launcher_sync": {
    "enabled": false,
    "prefer_synced_binary": false,
    "state_root_env_key": "KAIN_SYNC_ROOT",
    "default_state_root_windows": "%USERPROFILE%/.kain",
    "default_state_root_unix": "~/.kain",
    "shared_launcher_dir_windows": "D:/Kain-Bazel/bin",
    "shadow_launcher_dirs_windows": [
      "%USERPROFILE%/.cargo/bin"
    ],
    "bazel_default_config_windows": "dev",
    "lock_relative_path": "locks/sync.lock",
    "stamp_relative_path": "state/kain_sync_stamp.json",
    "build_counter_relative_path": "state/build_counter.json",
    "launch_trace_enabled": true,
    "launch_trace_relative_path": "state/kain_mcp_launcher_trace.jsonl",
    "cooldown_seconds": 45,
    "stale_lock_seconds": 900,
    "preflight_enabled": true,
    "preflight_timeout_seconds": 20,
    "sync_command_windows": [
      "powershell",
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "scripts/windows/sync-kain-source-of-truth.ps1",
      "-ManagedSync"
    ],
    "sync_command_unix": [
      "python3",
      "install_kain.py"
    ],
    "runtime_stamp_files": [
      "runtime/runtime.c",
      "runtime/native_core_runtime.toml",
      "blades/kain-mcp/config/runtime_policy.json"
    ],
    "source_watch_paths": [
      "crates",
      "runtime",
      "src",
      "Cargo.toml",
      "Cargo.lock",
      "BUILD.bazel",
      "MODULE.bazel",
      "MODULE.bazel.lock"
    ]
  },
  "defaults": {
    "allow_writes": true,
    "include_hidden": false,
    "timeout_ms": 1800000,
    "max_list_entries": 250,
    "default_read_limit": 200000,
    "skip_dirs": [
      ".git",
      "target",
      "node_modules",
      "dist",
      "build",
      "generated",
      "out",
      "coverage",
      ".cache",
      ".venv"
    ]
  }
}
