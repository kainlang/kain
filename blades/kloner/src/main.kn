    let values = [0.60, 1.15, 3.20, 2.40, 1.05, 1.70, 2.10, 8.00, 2.25, 1.60, 0.95, 1.90, 1.10, 0.70, 0.50, 1.35]
    return values[int_clamp(kind, 0, len(values) - 1)]

fn kloner_modifier_amount(kind: Int) -> Float:
