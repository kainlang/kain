    let values = [208, 208, 208, 208, 196, 196, 196, 196, 156, 156, 156, 156, 110, 110, 110, 255]
    return values[int_clamp(kind, 0, len(values) - 1)]

fn kloner_modifier_accent_b(kind: Int) -> Int:
    let values = [255, 255, 255, 255, 255, 255, 255, 255, 74, 74, 74, 74, 196, 196, 196, 132]
    return values[int_clamp(kind, 0, len(values) - 1)]

fn kloner_chain_name(chain_index: Int) -> String:
    let names = ["GRID LIFT", "CROWN SWARM", "EXPORT DRIFT"]
    return names[int_clamp(chain_index, 0, len(names) - 1)]

fn kloner_chain_duration_ms(chain_index: Int) -> Int:
    let durations = [2200, 2500, 2100]
    return durations[int_clamp(chain_index, 0, len(durations) - 1)]

fn kloner_chain_modifier_count(chain_index: Int) -> Int:
    let counts = [4, 4, 4]
    return counts[int_clamp(chain_index, 0, len(counts) - 1)]

fn kloner_chain_modifier_kind(chain_index: Int, slot: Int) -> Int:
    if chain_index == 0:
        let kinds = [KLONER_MOD_ORBIT, KLONER_MOD_PULSE, KLONER_MOD_FLOAT, KLONER_MOD_STEP]
        return kinds[int_clamp(slot, 0, len(kinds) - 1)]
    if chain_index == 1:
        let kinds = [KLONER_MOD_FIGURE8, KLONER_MOD_TWIST, KLONER_MOD_BREATHE, KLONER_MOD_NOISE_FLOW]
        return kinds[int_clamp(slot, 0, len(kinds) - 1)]
    let kinds = [KLONER_MOD_SPIRAL, KLONER_MOD_BOUNCE, KLONER_MOD_TUMBLE, KLONER_MOD_CODE]
    return kinds[int_clamp(slot, 0, len(kinds) - 1)]

fn kloner_chain_step_interval_ms(chain_index: Int) -> Int:
    if chain_index == 0:
        return 125
    return 0

fn kloner_total_duration_ms() -> Int:
    return kloner_chain_duration_ms(0) + kloner_chain_duration_ms(1) + kloner_chain_duration_ms(2)

fn kloner_active_chain_for_time(current_time_ms: Int) -> Int:
    if current_time_ms < kloner_chain_duration_ms(0):
        return 0
    if current_time_ms < kloner_chain_duration_ms(0) + kloner_chain_duration_ms(1):
        return 1
    return 2

fn kloner_local_chain_time_ms(current_time_ms: Int, chain_index: Int) -> Int:
    if chain_index == 0:
        return current_time_ms
    if chain_index == 1:
        return current_time_ms - kloner_chain_duration_ms(0)
    return current_time_ms - kloner_chain_duration_ms(0) - kloner_chain_duration_ms(1)

fn kloner_clamp01(value: Float) -> Float:
    if value < 0.0:
        return 0.0
    if value > 1.0:
        return 1.0
    return value

fn kloner_lerp(a: Float, b: Float, t: Float) -> Float:
    return a + ((b - a) * kloner_clamp01(t))

fn kloner_float_max(left: Float, right: Float) -> Float:
    if left >= right:
        return left
    return right

fn kloner_abs_int(value: Int) -> Int:
    if value < 0:
        return 0 - value
    return value

fn kloner_string_slice(text: String, start: Int, finish: Int) -> String:
    let result = ""
    let index = int_max(start, 0)
    let safe_finish = int_min(finish, len(text))
    while index < safe_finish:
        result = result + char_at(text, index)
        index = index + 1
    return result

fn kloner_sample_track4(current_time_ms: Int, t0: Int, v0: Float, t1: Int, v1: Float, t2: Int, v2: Float, t3: Int, v3: Float) -> Float:
    if current_time_ms <= t0:
        return v0
    if current_time_ms < t1:
        return kloner_lerp(v0, v1, Float(current_time_ms - t0) / Float(t1 - t0))
    if current_time_ms < t2:
        return kloner_lerp(v1, v2, Float(current_time_ms - t1) / Float(t2 - t1))
    if current_time_ms < t3:
        return kloner_lerp(v2, v3, Float(current_time_ms - t2) / Float(t3 - t2))
    return v3

fn kloner_key_sample(track_id: Int, current_time_ms: Int, default_value: Float) -> Float:
    if track_id == 0:
        return kloner_sample_track4(current_time_ms, 0, 4.0, 2200, 7.2, 4700, 5.8, 6800, 8.4)
    if track_id == 1:
        return kloner_sample_track4(current_time_ms, 0, 1.4, 2200, 1.9, 4700, 1.2, 6800, 1.6)
    if track_id == 2:
        return kloner_sample_track4(current_time_ms, 0, 0.18, 2200, 0.36, 4700, 0.22, 6800, 0.30)
    if track_id == 3:
        return kloner_sample_track4(current_time_ms, 0, 0.42, 2200, 0.74, 4700, 0.38, 6800, 0.66)
    return default_value

fn kloner_noise_unit(seed: Int) -> Float:
    let bucket = hash_bucket_mod(hash_mix32(97, seed), 1000)
    return Float(bucket) / 999.0

fn kloner_variant_for_index(distribution_mode: Int, chain_index: Int, clone_index: Int) -> Int:
    if distribution_mode == KLONER_DISTRIBUTION_RANDOM:
        return hash_bucket_mod(hash_triple32(chain_index, clone_index, 77), 3)
    return clone_index % 3

fn kloner_variant_red(variant: Int) -> Int:
    let values = [theme_signal_red(), theme_accent_red(), 255]
    return values[int_clamp(variant, 0, len(values) - 1)]

fn kloner_variant_green(variant: Int) -> Int:
    let values = [theme_signal_green(), theme_accent_green(), 214]
    return values[int_clamp(variant, 0, len(values) - 1)]

fn kloner_variant_blue(variant: Int) -> Int:
    let values = [theme_signal_blue(), theme_accent_blue(), 132]
    return values[int_clamp(variant, 0, len(values) - 1)]

fn theme_signal_red() -> Int:
    return 92

fn theme_signal_green() -> Int:
    return 208

fn theme_signal_blue() -> Int:
    return 255

fn theme_accent_red() -> Int:
    return 255

fn theme_accent_green() -> Int:
    return 156

fn theme_accent_blue() -> Int:
    return 74

fn kloner_reference_line_count(text: String) -> Int:
    if len(text) == 0:
        return 0
    let count = 1
    let index = 0
    while index < len(text):
        if char_at(text, index) == "\n":
            count = count + 1
        index = index + 1
    return count

fn kloner_first_line(text: String) -> String:
    if len(text) == 0:
        return ""
    let index = 0
    while index < len(text) and char_at(text, index) != "\n":
        index = index + 1
    return kloner_string_slice(text, 0, index)

fn kloner_path_leaf(path: String) -> String:
    if len(path) == 0:
        return ""
    let last = 0
    let index = 0
    while index < len(path):
        let ch = char_at(path, index)
        if ch == "/" or ch == "\\":
            last = index + 1
        index = index + 1
    return kloner_string_slice(path, last, len(path))

fn kloner_headline(mode_id: Int, chain_index: Int, export_format: Int, clone_total: Int) -> String:
    return "KLONER // " + kloner_mode_name(mode_id) + " // " + kloner_chain_name(chain_index) + " // " + kloner_export_format_name(export_format) + " // clones=" + str(clone_total)

fn kloner_bind_action_map(action_session: Int) -> Int:
    let _play = kaintana_action_bind(action_session, kaintana_key_down_binding("Enter", "transport.play"))
    let _play_release = kaintana_action_bind(action_session, kaintana_key_up_binding("Enter", "transport.play"))
    let _mode_grid = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyG", "mode.grid"))
    let _mode_grid_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyG", "mode.grid"))
    let _mode_radial = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyR", "mode.radial"))
    let _mode_radial_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyR", "mode.radial"))
    let _browse = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyB", "library.browse"))
    let _browse_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyB", "library.browse"))
    let _vat = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyV", "export.vat"))
    let _vat_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyV", "export.vat"))
    let _instance = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyI", "export.instance"))
    let _instance_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyI", "export.instance"))
    let _unreal = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyU", "target.unreal"))
    let _unreal_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyU", "target.unreal"))
    let _chain = kaintana_action_bind(action_session, kaintana_key_down_binding("Digit2", "chain.crown"))
    let _chain_release = kaintana_action_bind(action_session, kaintana_key_up_binding("Digit2", "chain.crown"))
    let _settings = kaintana_action_bind(action_session, kaintana_key_down_binding("KeyS", "service.settings"))
    let _settings_release = kaintana_action_bind(action_session, kaintana_key_up_binding("KeyS", "service.settings"))
    let _axis = kaintana_axis_bind(action_session, kaintana_axis_binding("human.pointer", "axis", "orbit_x", "preview.orbit", 0.25))
    return 1

fn kloner_press_key(action_session: Int, code: String) -> Int:
    let _down = kaintana_action_push_key_down(action_session, "keyboard.proof", code)
    return kaintana_action_begin_frame(action_session, 16.0)

fn kloner_release_key(action_session: Int, code: String) -> Int:
    let _up = kaintana_action_push_key_up(action_session, "keyboard.proof", code)
    return kaintana_action_begin_frame(action_session, 16.0)

fn kloner_pump_axis(action_session: Int, value: Float) -> Int:
    let _axis = kaintana_action_push_axis(action_session, "human.pointer", "pointer.proof", "orbit_x", value)
    return kaintana_action_begin_frame(action_session, 16.0)

fn kloner_pump_agent_intent(action_session: Int, action: String, command_text: String) -> Int:
    let _intent = kaintana_action_push_agent_intent(action_session, "codex", action, command_text, 0.99)
    return kaintana_action_begin_frame(action_session, 16.0)

fn kloner_clone_total(mode_id: Int, grid_x: Int, grid_y: Int, grid_z: Int, radial_count: Int, linear_count: Int) -> Int:
    if mode_id == KLONER_MODE_SINGLE:
        return 1
    if mode_id == KLONER_MODE_GRID:
        return grid_x * grid_y * grid_z
    if mode_id == KLONER_MODE_RADIAL:
        return radial_count
    return linear_count

fn kloner_base_pose(mode_id: Int, clone_index: Int, grid_x: Int, grid_y: Int, grid_z: Int, spacing_x: Float, spacing_y: Float, spacing_z: Float, radial_count: Int, radial_radius: Float, linear_count: Int) -> KlonerClonePose:
    let x = 0.0
    let y = 0.0
    let z = 0.0
    let yaw = 0.0
    if mode_id == KLONER_MODE_GRID:
        let offset_x = (Float(grid_x) - 1.0) * spacing_x * 0.5
        let offset_y = (Float(grid_y) - 1.0) * spacing_y * 0.5
        let offset_z = (Float(grid_z) - 1.0) * spacing_z * 0.5
        let remaining = clone_index
        let iz = remaining % grid_z
        remaining = remaining / grid_z
        let iy = remaining % grid_y
        remaining = remaining / grid_y
        let ix = remaining
        return KlonerClonePose {
            x: Float(ix) * spacing_x - offset_x,
            y: Float(iy) * spacing_y - offset_y,
            z: Float(iz) * spacing_z - offset_z,
            scale: 1.0,
            yaw: 0.0,
            variant: 0,
        }
    if mode_id == KLONER_MODE_RADIAL:
        let angle = (TAU / Float(radial_count)) * Float(clone_index)
        return KlonerClonePose {
            x: cos(angle) * radial_radius,
            y: 0.0,
            z: sin(angle) * radial_radius,
            scale: 1.0,
            yaw: -angle,
            variant: 0,
        }
    if mode_id == KLONER_MODE_LINEAR:
        let offset = (Float(linear_count) - 1.0) * spacing_y * 0.5
        return KlonerClonePose {
            x: 0.0,
            y: Float(clone_index) * spacing_y - offset,
            z: 0.0,
            scale: 1.0,
            yaw: 0.0,
            variant: 0,
        }
    return KlonerClonePose {
        x: x,
        y: y,
        z: z,
        scale: 1.0,
        yaw: yaw,
        variant: 0,
    }

fn kloner_apply_modifier(pose: KlonerClonePose, kind: Int, local_time_ms: Int, clone_index: Int, chain_index: Int) -> KlonerClonePose:
    let t = Float(local_time_ms) / 1000.0
    let x = pose.x
    let y = pose.y
    let z = pose.z
    let scale = pose.scale
    let yaw = pose.yaw
    let speed = kloner_modifier_speed(kind)
    let amount = kloner_modifier_amount(kind)
    let phase = Float(clone_index) * 0.19
    if kind == KLONER_MOD_ORBIT:
        x = x + cos(t * speed + phase) * amount
        z = z + sin(t * speed + phase) * amount
        yaw = yaw + (t * speed * 0.75)
    elif kind == KLONER_MOD_FLOAT:
        y = y + sin(t * speed + phase) * amount
    elif kind == KLONER_MOD_PULSE:
        scale = scale + sin(t * speed) * kloner_key_sample(2, local_time_ms, amount)
    elif kind == KLONER_MOD_ELASTIC:
        let envelope = sin(t * speed + phase)
        y = y + abs(envelope) * 0.22
        scale = scale + envelope * amount
    elif kind == KLONER_MOD_FIGURE8:
        x = x + sin(t * speed + phase) * amount
        z = z + sin((t * speed * 2.0) + phase) * amount * 0.54
    elif kind == KLONER_MOD_WOBBLE:
        x = x + sin(t * speed + phase) * amount * 0.35
        yaw = yaw + sin(t * speed + phase) * amount * 0.65
    elif kind == KLONER_MOD_HEARTBEAT:
        let beat = abs(sin(t * speed + phase))
        scale = scale + beat * amount
        y = y + beat * 0.12
    elif kind == KLONER_MOD_BOUNCE:
        let arc = abs(sin(t * speed + phase))
        y = y + arc * amount * 1.8
        scale = scale - arc * 0.08
    elif kind == KLONER_MOD_TUMBLE:
        yaw = yaw + (t * speed) + (Float(clone_index % 5) * 0.06)
        x = x + sin(t * speed * 0.5 + phase) * 0.22
    elif kind == KLONER_MOD_SWAY:
        x = x + sin(t * speed + phase) * 0.18
        yaw = yaw + sin(t * speed + phase) * amount
    elif kind == KLONER_MOD_TWIST:
        yaw = yaw + (t * speed * 0.9) + (Float(chain_index) * 0.16)
        scale = scale + sin(t * speed + phase) * 0.08
    elif kind == KLONER_MOD_SPIRAL:
        let angle = (t * speed) + (Float(clone_index) * 0.22)
        let radius = amount + Float(clone_index % 4) * 0.14
        x = x + cos(angle) * radius
        z = z + sin(angle) * radius
        y = y + sin(angle * 0.5) * 0.32
    elif kind == KLONER_MOD_NOISE_FLOW:
        let drift_a = kloner_noise_unit((chain_index * 8192) + clone_index + local_time_ms)
        let drift_b = kloner_noise_unit((chain_index * 16384) + clone_index * 3 + local_time_ms)
        x = x + (drift_a - 0.5) * amount * 2.0
        z = z + (drift_b - 0.5) * amount * 2.0
        y = y + sin(t * 0.7 + phase) * 0.16
    elif kind == KLONER_MOD_BREATHE:
        let breath = sin(t * speed)
        scale = scale + breath * amount
        y = y + breath * 0.10
    elif kind == KLONER_MOD_CODE:
        x = x + cos((t * speed * 1.3) + phase) * 0.16
        y = y + sin((t * speed * 1.9) + phase) * 0.28
        scale = scale + kloner_key_sample(3, local_time_ms, amount) * 0.18
    return KlonerClonePose {
        x: x,
        y: y,
        z: z,
        scale: scale,
        yaw: yaw,
        variant: pose.variant,
    }

fn kloner_clone_pose(mode_id: Int, distribution_mode: Int, chain_index: Int, current_time_ms: Int, clone_index: Int, grid_x: Int, grid_y: Int, grid_z: Int, spacing_x: Float, spacing_y: Float, spacing_z: Float, radial_count: Int, radial_radius: Float, linear_count: Int) -> KlonerClonePose:
    let local_time_ms = kloner_local_chain_time_ms(current_time_ms, chain_index)
    let step_interval_ms = kloner_chain_step_interval_ms(chain_index)
    let effective_time_ms = local_time_ms
    if step_interval_ms > 0:
        effective_time_ms = local_time_ms - (local_time_ms % step_interval_ms)
    let base = kloner_base_pose(mode_id, clone_index, grid_x, grid_y, grid_z, spacing_x, spacing_y, spacing_z, radial_count, radial_radius, linear_count)
    let variant = kloner_variant_for_index(distribution_mode, chain_index, clone_index)
    let mut current = KlonerClonePose {
        x: base.x,
        y: base.y,
        z: base.z,
        scale: base.scale,
        yaw: base.yaw,
        variant: variant,
    }
    let slot = 0
    while slot < kloner_chain_modifier_count(chain_index):
        current = kloner_apply_modifier(current, kloner_chain_modifier_kind(chain_index, slot), effective_time_ms, clone_index, chain_index)
        slot = slot + 1
    return current

fn kloner_preview_x(plot_rect: KaintanaRect, pose: KlonerClonePose) -> Float:
    return plot_rect.x + (plot_rect.width * 0.5) + (pose.x * 28.0) + (pose.z * 8.0)

fn kloner_preview_y(plot_rect: KaintanaRect, pose: KlonerClonePose) -> Float:
    return plot_rect.y + (plot_rect.height * 0.62) - (pose.y * 38.0) + (pose.z * 6.0)

fn kloner_preview_width(pose: KlonerClonePose) -> Float:
    return kloner_float_max(8.0, 10.0 + (pose.scale * 8.0))

fn kloner_preview_height(pose: KlonerClonePose) -> Float:
    return kloner_float_max(10.0, 14.0 + (pose.scale * 12.0))

fn kloner_draw_viewport_grid(session: Int, parent: Int, plot_rect: KaintanaRect, theme: KaintanaTheme) -> Int:
    let _back = kaintana_primitive_fill(session, parent, "viewport.plot.back", plot_rect, theme.panel_red, theme.panel_green, theme.panel_blue)
    let horizon_y = plot_rect.y + (plot_rect.height * 0.62)
    let _horizon = kaintana_primitive_fill(session, parent, "viewport.plot.horizon", kaintana_rect(plot_rect.x + 12.0, horizon_y, plot_rect.width - 24.0, 2.0), theme.muted_red, theme.muted_green, theme.muted_blue)
    let lane = 0
    while lane < 6:
        let x = plot_rect.x + 24.0 + (Float(lane) * ((plot_rect.width - 48.0) / 5.0))
        let _line = kaintana_primitive_fill(session, parent, "viewport.grid.v." + str(lane), kaintana_rect(x, plot_rect.y + 16.0, 1.0, plot_rect.height - 32.0), theme.shell_red + 12, theme.shell_green + 12, theme.shell_blue + 12)
        lane = lane + 1
    lane = 0
    while lane < 5:
        let y = plot_rect.y + 22.0 + (Float(lane) * ((plot_rect.height - 44.0) / 4.0))
        let _line = kaintana_primitive_fill(session, parent, "viewport.grid.h." + str(lane), kaintana_rect(plot_rect.x + 18.0, y, plot_rect.width - 36.0, 1.0), theme.shell_red + 12, theme.shell_green + 12, theme.shell_blue + 12)
        lane = lane + 1
    return 1

fn kloner_draw_clone(session: Int, parent: Int, plot_rect: KaintanaRect, index: Int, pose: KlonerClonePose, theme: KaintanaTheme, micro_font: Int) -> Int:
    let center_x = kloner_preview_x(plot_rect, pose)
    let center_y = kloner_preview_y(plot_rect, pose)
    let width = kloner_preview_width(pose)
    let height = kloner_preview_height(pose)
    let shadow = kaintana_rect(center_x - (width * 0.5), center_y + (height * 0.42), width, 4.0)
    let body = kaintana_rect(center_x - (width * 0.5), center_y - (height * 0.5), width, height)
    let rule = kaintana_rect(body.x, body.y, body.width, 3.0)
    let glow = kaintana_rect(body.x - 1.0, body.y - 1.0, body.width + 2.0, body.height + 2.0)
    let label_rect = kaintana_rect(body.x + 3.0, body.y + 2.0, body.width - 6.0, 10.0)
    let red = kloner_variant_red(pose.variant)
    let green = kloner_variant_green(pose.variant)
    let blue = kloner_variant_blue(pose.variant)
    let _shadow = kaintana_primitive_fill(session, parent, "clone.shadow." + str(index), shadow, theme.shell_red, theme.shell_green, theme.shell_blue)
    let _glow = kaintana_primitive_fill(session, parent, "clone.glow." + str(index), glow, theme.shell_red + 10, theme.shell_green + 10, theme.shell_blue + 10)
    let _body = kaintana_primitive_fill(session, parent, "clone.body." + str(index), body, red, green, blue)
    let _rule = kaintana_primitive_fill(session, parent, "clone.rule." + str(index), rule, theme.accent_red, theme.accent_green, theme.accent_blue)
    if index < 12:
        let _label = kaintana_primitive_text(session, parent, "clone.label." + str(index), str(index), label_rect, theme.shell_red, theme.shell_green, theme.shell_blue, micro_font, 10.0)
    return 1

fn kloner_state_snapshot_text(headline: String, distribution_mode: Int, export_mode: Int, target_engine: Int, orbit_value: Float, reference_lines: Int, reference_bytes: Int, dialog_result: Int, preview_hash: Int, export_signature: Int) -> String:
    var output = ""
    output = output + headline + "\n"
    output = output + "distribution=" + kloner_distribution_name(distribution_mode) + "\n"
    output = output + "export_mode=" + kloner_export_mode_name(export_mode) + "\n"
    output = output + "target_engine=" + kloner_target_name(target_engine) + "\n"
    output = output + "orbit_axis=" + str(orbit_value) + "\n"
    output = output + "reference_lines=" + str(reference_lines) + "\n"
    output = output + "reference_bytes=" + str(reference_bytes) + "\n"
    output = output + "dialog_result=" + str(dialog_result) + "\n"
    output = output + "preview_hash=" + str(preview_hash) + "\n"
    output = output + "export_signature=" + str(export_signature) + "\n"
    return output

fn kloner_export_preview_json(reference_asset_label: String, mode_id: Int, distribution_mode: Int, export_format: Int, export_mode: Int, target_engine: Int, chain_index: Int, clone_total: Int, current_time_ms: Int, preview_hash: Int, export_signature: Int, grid_x: Int, grid_y: Int, grid_z: Int, spacing_x: Float, spacing_y: Float, spacing_z: Float, radial_count: Int, radial_radius: Float, linear_count: Int) -> String:
    var output = "{\n"
    output = output + "  \"reference\": \"" + reference_asset_label + "\",\n"
    output = output + "  \"mode\": \"" + kloner_mode_name(mode_id) + "\",\n"
    output = output + "  \"distribution\": \"" + kloner_distribution_name(distribution_mode) + "\",\n"
    output = output + "  \"export_format\": \"" + kloner_export_format_name(export_format) + "\",\n"
    output = output + "  \"export_mode\": \"" + kloner_export_mode_name(export_mode) + "\",\n"
    output = output + "  \"target_engine\": \"" + kloner_target_name(target_engine) + "\",\n"
    output = output + "  \"active_chain\": \"" + kloner_chain_name(chain_index) + "\",\n"
    output = output + "  \"clone_total\": " + str(clone_total) + ",\n"
    output = output + "  \"time_ms\": " + str(current_time_ms) + ",\n"
    output = output + "  \"preview_hash\": " + str(preview_hash) + ",\n"
    output = output + "  \"export_signature\": " + str(export_signature) + ",\n"
    output = output + "  \"samples\": [\n"
    let sample_count = int_min(clone_total, 8)
    let sample_index = 0
    while sample_index < sample_count:
        let pose = kloner_clone_pose(mode_id, distribution_mode, chain_index, current_time_ms, sample_index, grid_x, grid_y, grid_z, spacing_x, spacing_y, spacing_z, radial_count, radial_radius, linear_count)
        output = output + "    {\"index\": " + str(sample_index) + ", \"x\": " + str(pose.x) + ", \"y\": " + str(pose.y) + ", \"z\": " + str(pose.z) + ", \"scale\": " + str(pose.scale) + ", \"variant\": " + str(pose.variant) + "}"
        if sample_index + 1 < sample_count:
            output = output + ","
        output = output + "\n"
        sample_index = sample_index + 1
    output = output + "  ]\n"
    output = output + "}\n"
    return output

fn kloner_frame_report_text(settings: KlonerSettings, theme: KaintanaTheme, headline: String, status_text: String, active_mode: Int, active_chain: Int, active_export: Int, export_mode: Int, target_engine: Int, clone_total: Int, current_time_ms: Int, preview_hash: Int, export_signature: Int, dialog_result: Int, action_session: Int) -> String:
    var output = "framework=kloner\n"
    output = output + "headline=" + headline + "\n"
    output = output + "theme=" + theme.name + "\n"
    output = output + "status=" + status_text + "\n"
    output = output + "mode=" + kloner_mode_name(active_mode) + "\n"
    output = output + "active_chain=" + kloner_chain_name(active_chain) + "\n"
    output = output + "export_format=" + kloner_export_format_name(active_export) + "\n"
    output = output + "export_mode=" + kloner_export_mode_name(export_mode) + "\n"
    output = output + "target=" + kloner_target_name(target_engine) + "\n"
    output = output + "clone_total=" + str(clone_total) + "\n"
    output = output + "current_time_ms=" + str(current_time_ms) + "\n"
    output = output + "preview_hash=" + str(preview_hash) + "\n"
    output = output + "export_signature=" + str(export_signature) + "\n"
    output = output + "dialog_result=" + str(dialog_result) + "\n"
    output = output + "action_frame_index=" + str(kaintana_action_frame_index(action_session)) + "\n"
    output = output + "action_event_count=" + str(kaintana_action_event_count(action_session)) + "\n"
    return output

fn main() -> Int:
    let runtime_status = native_runtime_init()
    if runtime_status != 0:
        println("runtime init failed")
        return 10

    let settings = kloner_settings_desktop()
    let harness = kloner_build_harness_spec(settings)
    let theme: KaintanaTheme = kaintana_theme_named(settings.theme_name)
    let spec = kloner_build_window_spec(settings)
    let authority = KlonerAuthority

    let _action_reset = kaintana_action_reset()
    if kaintana_desktop_probe() != 1:
        println("desktop host unavailable")
        return 11

    fs_create_dir_all(".kain")
    fs_create_dir_all(fs_path_join(".kain", "run"))
    let _scene = kaintana_desktop_scene_begin(spec)

    let session = kaintana_session_create("kloner", spec)
    let action_session = kaintana_action_session_create("kloner-actions")
    let _bindings = kloner_bind_action_map(action_session)
    let body_font = native_ui_font_create(session, "font.kloner.body", "Segoe UI", 15.0)
    let title_font = native_ui_font_create(session, "font.kloner.title", "Bahnschrift SemiBold", 24.0)
    let badge_font = native_ui_font_create(session, "font.kloner.badge", "Consolas", 12.0)
    let micro_font = native_ui_font_create(session, "font.kloner.micro", "Segoe UI", 11.0)
    let _frame = kaintana_begin_frame(session, settings.revision_key, 16.0)

    let reference_listing = ""
    if fs_exists(settings.reference_root):
        reference_listing = fs_read_dir_paths_text(settings.reference_root)
    let reference_source = ""
    if fs_exists(settings.reference_spec_path):
        reference_source = fs_read_text(settings.reference_spec_path)
    let reference_lines = kloner_reference_line_count(reference_listing)
    if len(reference_source) > 0:
        reference_lines = kloner_reference_line_count(reference_source)
    let reference_asset_label = kloner_path_leaf(settings.reference_spec_path)
    if len(reference_listing) > 0:
        reference_asset_label = kloner_path_leaf(kloner_first_line(reference_listing))
    let reference_bytes = len(reference_source)

    var active_mode = set_active_mode(authority, KLONER_MODE_GRID)
    var active_chain = set_active_chain(authority, 0)
    var active_export = set_active_export(authority, KLONER_EXPORT_FORMAT_GLB)
    var distribution_mode = KLONER_DISTRIBUTION_RANDOM
    var export_mode = KLONER_EXPORT_MODE_ANIM
    var target_engine = KLONER_TARGET_GENERIC
    var normalize_scale = 1
    var show_reference_browser = 0
    var dialog_id = 0
    var dialog_result = 0
    var current_time_ms = 320
    var status_text = "boot // awaiting reference uplift"

    let grid_x = 6
    let grid_y = 2
    let grid_z = 6
    let spacing_x = 1.45
    let spacing_y = 1.4
    let spacing_z = 1.45
    let radial_count = 18
    let linear_count = 16
    let radial_radius = 6.0

    let window_rect = kaintana_window_rect(spec)
    let shell_rect = kaintana_inset(window_rect, 14.0, 14.0, 14.0, 14.0)
    let top_bar_rect = kaintana_rect(shell_rect.x, shell_rect.y, shell_rect.width, 58.0)
    let footer_rect = kaintana_rect(shell_rect.x, shell_rect.y + shell_rect.height - 98.0, shell_rect.width, 98.0)
    let work_rect = kaintana_rect(shell_rect.x, top_bar_rect.y + top_bar_rect.height + 12.0, shell_rect.width, footer_rect.y - (top_bar_rect.y + top_bar_rect.height + 24.0))
    let left_rect = kaintana_split_left(work_rect, 0.20, 14.0)
    let right_rect = kaintana_split_right(work_rect, 0.78, 14.0)
    let center_rect = kaintana_rect(left_rect.x + left_rect.width + 14.0, work_rect.y, right_rect.x - (left_rect.x + left_rect.width + 28.0), work_rect.height)
    let viewport_rect = kaintana_split_top(center_rect, 0.66, 12.0)
    let sequencer_rect = kaintana_split_bottom(center_rect, 0.66, 12.0)
    let right_top_rect = kaintana_split_top(right_rect, 0.44, 12.0)
    let right_bottom_rect = kaintana_split_bottom(right_rect, 0.44, 12.0)

    let shell_node = kaintana_retained_region(session, 0, "shell", "kloner.shell", shell_rect, theme)
    let top_bar = kaintana_immediate_panel(session, shell_node, "panel.topbar", "", top_bar_rect, theme, badge_font, 24.0)
    let left_panel = kaintana_retained_region(session, shell_node, "panel.left", "kloner.left", left_rect, theme)
    let viewport_surface = kaintana_retained_surface(session, shell_node, "surface.viewport", "surface.viewport.kloner", "CLONE VIEWPORT", viewport_rect, theme, badge_font, 20.0)
    let sequencer_panel = kaintana_retained_region(session, shell_node, "panel.sequencer", "kloner.sequencer", sequencer_rect, theme)
    let chains_panel = kaintana_retained_region(session, shell_node, "panel.chains", "kloner.chains", right_top_rect, theme)
    let inspector_panel = kaintana_retained_region(session, shell_node, "panel.inspector", "kloner.inspector", right_bottom_rect, theme)
    let footer_panel = kaintana_immediate_panel(session, shell_node, "panel.footer", "", footer_rect, theme, badge_font, 24.0)

    let top_inner = kaintana_inset(top_bar_rect, 14.0, 10.0, 14.0, 10.0)
    let left_inner = kaintana_inset(left_rect, 16.0, 18.0, 16.0, 18.0)
    let viewport_inner = kaintana_inset(viewport_rect, 20.0, 20.0, 20.0, 20.0)
    let sequencer_inner = kaintana_inset(sequencer_rect, 18.0, 18.0, 18.0, 18.0)
    let chains_inner = kaintana_inset(right_top_rect, 18.0, 18.0, 18.0, 18.0)
    let inspector_inner = kaintana_inset(right_bottom_rect, 18.0, 18.0, 18.0, 18.0)
    let footer_inner = kaintana_inset(footer_rect, 16.0, 14.0, 16.0, 14.0)

    let _brand = kaintana_immediate_badge(session, top_bar, "badge.brand", "K-CLONER", kaintana_rect(top_inner.x, top_inner.y + 2.0, 144.0, 30.0), theme, badge_font, 18.0)
    let _version = kaintana_immediate_badge(session, top_bar, "badge.version", "0.5 ALPHA", kaintana_rect(top_inner.x + 154.0, top_inner.y + 2.0, 118.0, 30.0), theme, badge_font, 18.0)
    let browse_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.browse", "Browse", kaintana_rect(top_inner.x + 296.0, top_inner.y, 96.0, 34.0), theme, micro_font, 22.0)
    let play_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.play", "Play", kaintana_rect(top_inner.x + 400.0, top_inner.y, 88.0, 34.0), theme, micro_font, 22.0)
    let export_commit_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.export", "Export", kaintana_rect(top_inner.x + 496.0, top_inner.y, 96.0, 34.0), theme, micro_font, 22.0)
    let settings_button = kaintana_immediate_toolbar_button(session, top_bar, "toolbar.settings", "Settings", kaintana_rect(top_inner.x + top_inner.width - 354.0, top_inner.y, 112.0, 34.0), theme, micro_font, 22.0)
    let _theme_badge = kaintana_immediate_badge(session, top_bar, "badge.theme", settings.theme_name, kaintana_rect(top_inner.x + top_inner.width - 228.0, top_inner.y + 2.0, 116.0, 30.0), theme, badge_font, 18.0)
    let _reload_badge = kaintana_immediate_badge(session, top_bar, "badge.reload", "reload " + str(kaintana_hot_reload_generation(session)), kaintana_rect(top_inner.x + top_inner.width - 102.0, top_inner.y + 2.0, 88.0, 30.0), theme, badge_font, 18.0)

    let mode_band = kaintana_rect(left_inner.x, left_inner.y + 42.0, left_inner.width, 42.0)
    let mode_single_button = kaintana_immediate_toolbar_button(session, left_panel, "mode.single", "SINGLE", kaintana_grid_cell(mode_band, 4.0, 1.0, 0.0, 0.0, 8.0, 0.0), theme, micro_font, 24.0)
