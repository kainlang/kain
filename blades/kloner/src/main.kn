// style: reference-faithful clone workbench
use c::kaintana_desktop_bridge
use kaintana::*
use std::collections
use std::fs
use std::hash
use std::input
use std::intent
use std::math
use std::ui

const KLONER_MODE_SINGLE: Int = 0
const KLONER_MODE_GRID: Int = 1
const KLONER_MODE_RADIAL: Int = 2
const KLONER_MODE_LINEAR: Int = 3

const KLONER_DISTRIBUTION_ROUND_ROBIN: Int = 0
const KLONER_DISTRIBUTION_RANDOM: Int = 1

const KLONER_EXPORT_FORMAT_GLB: Int = 0
const KLONER_EXPORT_FORMAT_OBJ: Int = 1
const KLONER_EXPORT_FORMAT_USDZ: Int = 2
const KLONER_EXPORT_FORMAT_VAT: Int = 3

const KLONER_EXPORT_MODE_ANIM: Int = 0
const KLONER_EXPORT_MODE_INSTANCE: Int = 1
const KLONER_EXPORT_MODE_SEPARATED: Int = 2

const KLONER_TARGET_GENERIC: Int = 0
const KLONER_TARGET_UNREAL: Int = 1
const KLONER_TARGET_UNITY: Int = 2

const KLONER_MOD_ORBIT: Int = 0
const KLONER_MOD_FLOAT: Int = 1
const KLONER_MOD_PULSE: Int = 2
const KLONER_MOD_ELASTIC: Int = 3
const KLONER_MOD_FIGURE8: Int = 4
const KLONER_MOD_WOBBLE: Int = 5
const KLONER_MOD_HEARTBEAT: Int = 6
const KLONER_MOD_STEP: Int = 7
const KLONER_MOD_BOUNCE: Int = 8
const KLONER_MOD_TUMBLE: Int = 9
const KLONER_MOD_SWAY: Int = 10
const KLONER_MOD_TWIST: Int = 11
const KLONER_MOD_SPIRAL: Int = 12
const KLONER_MOD_NOISE_FLOW: Int = 13
const KLONER_MOD_BREATHE: Int = 14
const KLONER_MOD_CODE: Int = 15

const KLONER_FAMILY_BASIC: Int = 0
const KLONER_FAMILY_RHYTHMIC: Int = 1
const KLONER_FAMILY_PHYSICS: Int = 2
const KLONER_FAMILY_ADVANCED: Int = 3
const KLONER_FAMILY_SCRIPT: Int = 4

const KLONER_MAX_PREVIEW_CLONES: Int = 72
const KLONER_CHAIN_COUNT: Int = 3
const KLONER_SEGMENT_COUNT: Int = 16

component KlonerPanel():
    render <panel title="Kloner" />

world KlonerAuthority:
    state active_mode: Int = KLONER_MODE_GRID
    state active_chain: Int = 0
    state active_export: Int = KLONER_EXPORT_FORMAT_GLB
    state clone_total: Int = 1
    state preview_hash: Int = 1
    surface native_ui => KlonerPanel

world KlonerMirror:
    state mode_copy: Int = KLONER_MODE_GRID
    state chain_copy: Int = 0
    state export_copy: Int = KLONER_EXPORT_FORMAT_GLB
    state clone_total_copy: Int = 1
    state preview_hash_copy: Int = 1
    surface web => KlonerPanel

entangle KlonerAuthority.active_mode <-> KlonerMirror.mode_copy with single_writer
entangle KlonerAuthority.active_chain <-> KlonerMirror.chain_copy with single_writer
entangle KlonerAuthority.active_export <-> KlonerMirror.export_copy with single_writer
entangle KlonerAuthority.clone_total <-> KlonerMirror.clone_total_copy with single_writer
entangle KlonerAuthority.preview_hash <-> KlonerMirror.preview_hash_copy with single_writer

patch set_active_mode(authority: KlonerAuthority, value: Int) -> Int:
    authority.active_mode = value
    return authority.active_mode

patch set_active_chain(authority: KlonerAuthority, value: Int) -> Int:
    authority.active_chain = value
    return authority.active_chain

patch set_active_export(authority: KlonerAuthority, value: Int) -> Int:
    authority.active_export = value
    return authority.active_export

patch set_clone_total(authority: KlonerAuthority, value: Int) -> Int:
    authority.clone_total = value
    return authority.clone_total

patch set_preview_hash(authority: KlonerAuthority, value: Int) -> Int:
    authority.preview_hash = value
    return authority.preview_hash

law kloner_mode_valid(value: Int) -> Bool:
    return value >= KLONER_MODE_SINGLE and value <= KLONER_MODE_LINEAR

law kloner_clone_budget_valid(value: Int) -> Bool:
    return value >= 1 and value <= 4096

law kloner_preview_hash_valid(value: Int) -> Bool:
    return value != 0

converge kloner_hash_lane(value: Int) -> Int:
    spec reference:
        return hash_mix32(17, value)
    fast llvm_lane when target("llvm"):
        return hash_mix32(17, value)
    verify random(8)

fn kloner_bias(value: Int) -> Int:
    return hash_pair32(value, 31)

orchestrate kloner_export_signature(seed: Int) -> Int:
    let mixed: Int = kain kloner_hash_lane(seed)
    let biased: Int = rust kloner_bias(mixed)
    return biased

struct KlonerSettings:
    title: String
    theme_name: String
    width: Int
    height: Int
    frame_budget: Int
    revision_key: String
    clear_red: Int
    clear_green: Int
    clear_blue: Int
    accent_red: Int
    accent_green: Int
    accent_blue: Int
    frame_report_path: String
    host_report_path: String
    screenshot_path: String
    snapshot_path: String
    input_trace_path: String
    state_path: String
    export_preview_path: String
    scene_report_path: String
    reference_root: String
    reference_spec_path: String

struct KlonerClonePose:
    x: Float
    y: Float
    z: Float
    scale: Float
    yaw: Float
    variant: Int

fn kloner_is_digit_char(ch: String) -> Bool:
    return ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"

fn kloner_digit_value(ch: String) -> Int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    return 9

fn kloner_parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    let sign = 1
    let index = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    let value = 0
    while index < len(text):
        if !kloner_is_digit_char(char_at(text, index)):
            return value * sign
        value = value * 10 + kloner_digit_value(char_at(text, index))
        index = index + 1
    return value * sign

fn kloner_frame_budget_or_default(default_value: Int) -> Int:
    let override_text = env("KLONER_FRAME_BUDGET")
    if len(override_text) == 0:
        return default_value
    let override_value = kloner_parse_int_text(override_text)
    if override_value <= 0:
        return default_value
    return override_value

fn kloner_settings_desktop() -> KlonerSettings:
    let run_root = fs_path_join(".kain", "run")
    let reference_root = "reference"
    return KlonerSettings {
        title: "Kloner // Kain Native Clone Workstation",
        theme_name: "oxide-dcc",
        width: 1700,
        height: 1040,
        frame_budget: kloner_frame_budget_or_default(180),
        revision_key: "kloner-desktop-v1-reference-faithful",
        clear_red: 18,
        clear_green: 20,
        clear_blue: 24,
        accent_red: 255,
        accent_green: 156,
        accent_blue: 74,
        frame_report_path: fs_path_join(run_root, "kloner_frame.txt"),
        host_report_path: fs_path_join(run_root, "kloner_host.txt"),
        screenshot_path: fs_path_join(run_root, "kloner.bmp"),
        snapshot_path: fs_path_join(run_root, "kloner_snapshot.txt"),
        input_trace_path: fs_path_join(run_root, "kloner_input_trace.txt"),
        state_path: fs_path_join(run_root, "kloner_state_snapshot.txt"),
        export_preview_path: fs_path_join(run_root, "kloner_export_preview.json"),
        scene_report_path: fs_path_join(run_root, "kloner_scene.txt"),
        reference_root: reference_root,
        reference_spec_path: fs_path_join(reference_root, "KCloner.tsx"),
    }

fn kloner_build_window_spec(settings: KlonerSettings) -> KaintanaWindowSpec:
    return kaintana_window_spec(
        settings.title,
        settings.width,
        settings.height,
        settings.frame_budget,
        kaintana_backend_desktop(),
        "software",
        settings.clear_red,
        settings.clear_green,
        settings.clear_blue,
        settings.accent_red,
        settings.accent_green,
        settings.accent_blue,
        "",
        "",
        settings.frame_report_path,
        settings.host_report_path,
        settings.screenshot_path,
    )

fn kloner_build_harness_spec(settings: KlonerSettings) -> KaintanaHarnessSpec:
    return kaintana_harness_spec(settings.snapshot_path, settings.input_trace_path)

