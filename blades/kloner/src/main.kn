    let target_generic_button = kaintana_immediate_toolbar_button(session, footer_panel, "target.generic", "GENERIC", kaintana_grid_cell(target_band, 3.0, 1.0, 0.0, 0.0, 8.0, 0.0), theme, micro_font, 22.0)
    let target_unreal_button = kaintana_immediate_toolbar_button(session, footer_panel, "target.unreal", "UNREAL", kaintana_grid_cell(target_band, 3.0, 1.0, 1.0, 0.0, 8.0, 0.0), theme, micro_font, 22.0)
    let target_unity_button = kaintana_immediate_toolbar_button(session, footer_panel, "target.unity", "UNITY", kaintana_grid_cell(target_band, 3.0, 1.0, 2.0, 0.0, 8.0, 0.0), theme, micro_font, 22.0)

    let settings_menu = kaintana_menu_create(session, "menu.kloner.settings")
    let _menu_write = kaintana_menu_add_item(session, settings_menu, kaintana_menu_item("menu.write", "Write Export Preview", 701))
    let _menu_reference = kaintana_menu_add_item(session, settings_menu, kaintana_menu_item("menu.reference", "Inspect Reference Spec", 702))
    let _menu_theme = kaintana_menu_add_item(session, settings_menu, kaintana_menu_item("menu.theme", "Keep Oxide Theme", 703))
    let settings_popover = kaintana_popover_spec("popover.kloner.settings", 274.0, 108.0, -12.0, 10.0)
    let browser_popover = kaintana_popover_spec("popover.kloner.browser", 360.0, 150.0, -18.0, 12.0)

    let _proof_click = kaintana_click_node(session, mode_single_button)
    while kaintana_poll_event(session) == 1:
        if kaintana_button_activated(session, mode_single_button) == 1:
            active_mode = set_active_mode(authority, KLONER_MODE_SINGLE)
            status_text = "pointer // single seed armed"

    let _focus_play = kaintana_focus_node(session, play_button)
    let _play_press = kloner_press_key(action_session, "Enter")
    if kaintana_action_activated(session, action_session, play_button, "transport.play") == 1:
        current_time_ms = 4180
        status_text = "transport // timeline engaged"
    let _play_release = kloner_release_key(action_session, "Enter")

    let _focus_grid = kaintana_focus_node(session, mode_grid_button)
    let _grid_press = kloner_press_key(action_session, "KeyG")
    if kaintana_action_activated(session, action_session, mode_grid_button, "mode.grid") == 1:
        active_mode = set_active_mode(authority, KLONER_MODE_GRID)
    let _grid_release = kloner_release_key(action_session, "KeyG")

    let _focus_radial = kaintana_focus_node(session, mode_radial_button)
    let _radial_press = kloner_press_key(action_session, "KeyR")
    if kaintana_action_activated(session, action_session, mode_radial_button, "mode.radial") == 1:
        active_mode = set_active_mode(authority, KLONER_MODE_RADIAL)
        status_text = "mode // radial crown from reference rhythm"
    let _radial_release = kloner_release_key(action_session, "KeyR")

    let _focus_chain = kaintana_focus_node(session, chain_crown_swarm)
    let _chain_press = kloner_press_key(action_session, "Digit2")
    if kaintana_action_activated(session, action_session, chain_crown_swarm, "chain.crown") == 1:
        active_chain = set_active_chain(authority, 1)
    let _chain_release = kloner_release_key(action_session, "Digit2")

    let _focus_browse = kaintana_focus_node(session, browse_button)
    let _browse_press = kloner_press_key(action_session, "KeyB")
    if kaintana_action_activated(session, action_session, browse_button, "library.browse") == 1:
        show_reference_browser = 1
        status_text = "reference // mounted " + reference_asset_label
        let _popover_open = kaintana_popover_open(session, browse_button, browser_popover)
    let _browse_release = kloner_release_key(action_session, "KeyB")

    let _focus_vat = kaintana_focus_node(session, export_vat_button)
    let _vat_press = kloner_press_key(action_session, "KeyV")
    if kaintana_action_activated(session, action_session, export_vat_button, "export.vat") == 1:
        active_export = set_active_export(authority, KLONER_EXPORT_FORMAT_VAT)
    let _vat_release = kloner_release_key(action_session, "KeyV")

    let _focus_instance = kaintana_focus_node(session, export_instance_button)
    let _instance_press = kloner_press_key(action_session, "KeyI")
    if kaintana_action_activated(session, action_session, export_instance_button, "export.instance") == 1:
        export_mode = KLONER_EXPORT_MODE_INSTANCE
    let _instance_release = kloner_release_key(action_session, "KeyI")

    let _focus_unreal = kaintana_focus_node(session, target_unreal_button)
    let _unreal_press = kloner_press_key(action_session, "KeyU")
    if kaintana_action_activated(session, action_session, target_unreal_button, "target.unreal") == 1:
        target_engine = KLONER_TARGET_UNREAL
    let _unreal_release = kloner_release_key(action_session, "KeyU")

    let _focus_settings = kaintana_focus_node(session, settings_button)
    let _settings_press = kloner_press_key(action_session, "KeyS")
    if kaintana_action_activated(session, action_session, settings_button, "service.settings") == 1:
        let _menu_open = kaintana_menu_open_below_node(session, settings_menu, settings_button, 10.0)
        let _popover_open = kaintana_popover_open(session, settings_button, settings_popover)
        status_text = "settings // export deck live"
    let _settings_release = kloner_release_key(action_session, "KeyS")

    let _focus_export = kaintana_focus_node(session, export_commit_button)
    let _export_intent = kloner_pump_agent_intent(action_session, "export.commit", "bake vat preview from KCloner reference shell")
    if kaintana_action_activated(session, action_session, export_commit_button, "export.commit") == 1:
        dialog_id = kaintana_dialog_request(session, "confirm", "Commit Export Preview", "Write a VAT-oriented preview artifact from the faithful Kain deck.")
        let _dialog_response = kaintana_dialog_respond(session, dialog_id, 207, "export-preview-written")
        dialog_result = kaintana_dialog_poll_response(session)
        status_text = "export // preview synthesized"
    let _axis = kloner_pump_axis(action_session, 6.0)
    let orbit_value = kaintana_action_axis_value(action_session, "preview.orbit")

    spacing_y = kloner_key_sample(1, current_time_ms, 1.4)
    radial_radius = kloner_key_sample(0, current_time_ms, 6.0)

    let clone_total = kloner_clone_total(active_mode, grid_x, grid_y, grid_z, radial_count, linear_count)
    let _clone_total = set_clone_total(authority, clone_total)
    let headline = kloner_headline(active_mode, active_chain, active_export, clone_total)
    let preview_hash_seed = hash_quad32(active_mode, active_chain, active_export, clone_total)
    let preview_hash = set_preview_hash(authority, kloner_hash_lane(preview_hash_seed))
    let export_signature = kloner_export_signature(hash_pair32(preview_hash, dialog_result + 19))
    let _clipboard = kaintana_clipboard_copy_text(session, settings.export_preview_path)

    let state_text = kloner_state_snapshot_text(headline, distribution_mode, export_mode, target_engine, orbit_value, reference_lines, reference_bytes, dialog_result, preview_hash, export_signature)
    let export_preview = kloner_export_preview_json(reference_asset_label, active_mode, distribution_mode, active_export, export_mode, target_engine, active_chain, clone_total, current_time_ms, preview_hash, export_signature, grid_x, grid_y, grid_z, spacing_x, spacing_y, spacing_z, radial_count, radial_radius, linear_count)
    fs_write_text(settings.state_path, state_text)
    fs_atomic_write_text(settings.export_preview_path, export_preview)

    let _left_title = kaintana_retained_label(session, left_panel, "left.title", "CLONER STRUCTURE", kaintana_rect(left_inner.x, left_inner.y, left_inner.width, 22.0), theme, badge_font, 18.0)
    let _left_copy = kaintana_retained_muted_label(session, left_panel, "left.copy", "Reference faithful: mode rail, modifier library, asset intake, export posture.", kaintana_rect(left_inner.x, left_inner.y + 90.0, left_inner.width, 46.0), theme, micro_font, 14.0)
    let _library_title = kaintana_retained_label(session, left_panel, "left.library", "MODIFIER LIBRARY", kaintana_rect(left_inner.x, left_inner.y + 122.0, left_inner.width, 22.0), theme, badge_font, 18.0)
    let _asset_title = kaintana_retained_label(session, left_panel, "left.asset", "REFERENCE ASSET", kaintana_rect(left_inner.x, left_inner.y + 378.0, left_inner.width, 22.0), theme, badge_font, 18.0)
    let _asset_card = kaintana_primitive_fill(session, left_panel, "left.asset.card", kaintana_rect(left_inner.x, left_inner.y + 406.0, left_inner.width, 126.0), theme.shell_red, theme.shell_green, theme.shell_blue)
    let _asset_name = kaintana_primitive_text(session, left_panel, "left.asset.name", reference_asset_label, kaintana_rect(left_inner.x + 12.0, left_inner.y + 420.0, left_inner.width - 24.0, 18.0), theme.ink_red, theme.ink_green, theme.ink_blue, body_font, 16.0)
    let _asset_ref = kaintana_primitive_text(session, left_panel, "left.asset.ref", "source_lines=" + str(reference_lines) + " // bytes=" + str(reference_bytes), kaintana_rect(left_inner.x + 12.0, left_inner.y + 444.0, left_inner.width - 24.0, 18.0), theme.muted_red, theme.muted_green, theme.muted_blue, micro_font, 12.0)
    let _asset_dist = kaintana_primitive_text(session, left_panel, "left.asset.dist", "distribution=" + kloner_distribution_name(distribution_mode) + " // auto_scale=" + str(normalize_scale), kaintana_rect(left_inner.x + 12.0, left_inner.y + 466.0, left_inner.width - 24.0, 18.0), theme.muted_red, theme.muted_green, theme.muted_blue, micro_font, 12.0)
    let _asset_status = kaintana_primitive_text(session, left_panel, "left.asset.status", status_text, kaintana_rect(left_inner.x + 12.0, left_inner.y + 492.0, left_inner.width - 24.0, 24.0), theme.signal_red, theme.signal_green, theme.signal_blue, micro_font, 13.0)

    let _viewport_title = kaintana_retained_label(session, viewport_surface, "viewport.title", "FAITHFUL WORKSTATION PREVIEW", kaintana_rect(viewport_inner.x, viewport_inner.y, viewport_inner.width, 30.0), theme, title_font, 24.0)
    let _viewport_subtitle = kaintana_retained_muted_label(session, viewport_surface, "viewport.subtitle", "The viewport is Kain-authored: clone math, chain timing, variant spread, and export bias all live in source.", kaintana_rect(viewport_inner.x, viewport_inner.y + 36.0, viewport_inner.width, 32.0), theme, micro_font, 15.0)
    let _viewport_headline = kaintana_retained_label(session, viewport_surface, "viewport.headline", headline, kaintana_rect(viewport_inner.x, viewport_inner.y + 80.0, viewport_inner.width, 24.0), theme, body_font, 18.0)
    let plot_rect = kaintana_rect(viewport_inner.x, viewport_inner.y + 118.0, viewport_inner.width, viewport_inner.height - 164.0)
    let _grid = kloner_draw_viewport_grid(session, viewport_surface, plot_rect, theme)
    let preview_count = int_min(clone_total, KLONER_MAX_PREVIEW_CLONES)
    let clone_index = 0
    while clone_index < preview_count:
        let pose = kloner_clone_pose(active_mode, distribution_mode, active_chain, current_time_ms, clone_index, grid_x, grid_y, grid_z, spacing_x, spacing_y, spacing_z, radial_count, radial_radius, linear_count)
        let _draw = kloner_draw_clone(session, viewport_surface, plot_rect, clone_index, pose, theme, micro_font)
        clone_index = clone_index + 1
    let _viewport_metric = kaintana_immediate_metric(session, viewport_surface, "viewport.metric", "preview.clones", str(preview_count) + " / " + str(clone_total), kaintana_rect(viewport_inner.x, viewport_inner.y + viewport_inner.height - 28.0, 240.0, 18.0), theme, micro_font, 13.0)
    let _viewport_hash = kaintana_immediate_metric(session, viewport_surface, "viewport.hash", "preview.hash", str(preview_hash), kaintana_rect(viewport_inner.x + 254.0, viewport_inner.y + viewport_inner.height - 28.0, 240.0, 18.0), theme, micro_font, 13.0)
    let _viewport_signature = kaintana_immediate_metric(session, viewport_surface, "viewport.sig", "export.sig", str(export_signature), kaintana_rect(viewport_inner.x + 508.0, viewport_inner.y + viewport_inner.height - 28.0, 240.0, 18.0), theme, micro_font, 13.0)

    let _seq_title = kaintana_retained_label(session, sequencer_panel, "seq.title", "CHAIN TIMELINE", kaintana_rect(sequencer_inner.x, sequencer_inner.y, sequencer_inner.width, 22.0), theme, badge_font, 18.0)
    let _seq_copy = kaintana_retained_muted_label(session, sequencer_panel, "seq.copy", "KCloner parity lane: chained durations, keyed radius/scale tracks, transport owner, and split export intent.", kaintana_rect(sequencer_inner.x, sequencer_inner.y + 28.0, sequencer_inner.width, 24.0), theme, micro_font, 13.0)
    let timeline_rect = kaintana_rect(sequencer_inner.x, sequencer_inner.y + 72.0, sequencer_inner.width, 72.0)
    let _timeline_back = kaintana_primitive_fill(session, sequencer_panel, "seq.timeline.back", timeline_rect, theme.shell_red, theme.shell_green, theme.shell_blue)
    let total_duration_ms = kloner_total_duration_ms()
    let cursor_x = timeline_rect.x + (timeline_rect.width * (Float(current_time_ms) / Float(total_duration_ms)))
    let segment_index = 0
    while segment_index < KLONER_SEGMENT_COUNT:
        let key_x = timeline_rect.x + 14.0 + (Float(segment_index) * ((timeline_rect.width - 28.0) / Float(KLONER_SEGMENT_COUNT - 1)))
        let _tick = kaintana_primitive_fill(session, sequencer_panel, "seq.tick." + str(segment_index), kaintana_rect(key_x, timeline_rect.y + 8.0, 1.0, timeline_rect.height - 16.0), theme.panel_red + 12, theme.panel_green + 12, theme.panel_blue + 12)
        segment_index = segment_index + 1
    let chain_a_rect = kaintana_rect(timeline_rect.x + 12.0, timeline_rect.y + 16.0, (timeline_rect.width - 24.0) * (Float(kloner_chain_duration_ms(0)) / Float(total_duration_ms)), 14.0)
    let chain_b_rect = kaintana_rect(chain_a_rect.x + chain_a_rect.width + 6.0, timeline_rect.y + 16.0, (timeline_rect.width - 30.0) * (Float(kloner_chain_duration_ms(1)) / Float(total_duration_ms)), 14.0)
    let chain_c_rect = kaintana_rect(chain_b_rect.x + chain_b_rect.width + 6.0, timeline_rect.y + 16.0, timeline_rect.x + timeline_rect.width - (chain_b_rect.x + chain_b_rect.width + 18.0), 14.0)
    let _chain_a = kaintana_primitive_fill(session, sequencer_panel, "seq.chain.a", chain_a_rect, theme.signal_red, theme.signal_green, theme.signal_blue)
    let _chain_b = kaintana_primitive_fill(session, sequencer_panel, "seq.chain.b", chain_b_rect, theme.accent_red, theme.accent_green, theme.accent_blue)
    let _chain_c = kaintana_primitive_fill(session, sequencer_panel, "seq.chain.c", chain_c_rect, 214, 132, 255)
    let _playhead = kaintana_primitive_fill(session, sequencer_panel, "seq.playhead", kaintana_rect(cursor_x, timeline_rect.y + 6.0, 3.0, timeline_rect.height - 12.0), theme.ink_red, theme.ink_green, theme.ink_blue)
    let _time_text = kaintana_primitive_text(session, sequencer_panel, "seq.time", str(Float(current_time_ms) / 1000.0) + "s / " + str(Float(total_duration_ms) / 1000.0) + "s", kaintana_rect(timeline_rect.x + 12.0, timeline_rect.y + 42.0, 240.0, 18.0), theme.ink_red, theme.ink_green, theme.ink_blue, micro_font, 12.0)
    let _key_text = kaintana_primitive_text(session, sequencer_panel, "seq.keys", "keys: radius=" + str(4) + " pulse=" + str(4) + " code=" + str(4), kaintana_rect(timeline_rect.x + 268.0, timeline_rect.y + 42.0, 240.0, 18.0), theme.muted_red, theme.muted_green, theme.muted_blue, micro_font, 12.0)
    let _seq_metric_chain = kaintana_immediate_metric(session, sequencer_panel, "seq.metric.chain", "active.chain", kloner_chain_name(active_chain), kaintana_rect(sequencer_inner.x, sequencer_inner.y + 160.0, 280.0, 18.0), theme, micro_font, 13.0)
    let _seq_metric_track = kaintana_immediate_metric(session, sequencer_panel, "seq.metric.track", "radial.radius", str(radial_radius), kaintana_rect(sequencer_inner.x + 294.0, sequencer_inner.y + 160.0, 220.0, 18.0), theme, micro_font, 13.0)
    let _seq_metric_orbit = kaintana_immediate_metric(session, sequencer_panel, "seq.metric.orbit", "orbit.axis", str(orbit_value), kaintana_rect(sequencer_inner.x + 528.0, sequencer_inner.y + 160.0, 220.0, 18.0), theme, micro_font, 13.0)

    let _chains_title = kaintana_retained_label(session, chains_panel, "chains.title", "CHAIN STACK", kaintana_rect(chains_inner.x, chains_inner.y, chains_inner.width, 22.0), theme, badge_font, 18.0)
    let _chains_copy = kaintana_retained_muted_label(session, chains_panel, "chains.copy", "The original operator lives on duration-aware stacks. This Kain version keeps the same idea but makes the logic inspectable in-source.", kaintana_rect(chains_inner.x, chains_inner.y + 104.0, chains_inner.width, 44.0), theme, micro_font, 14.0)
    let slot_rect = kaintana_rect(chains_inner.x, chains_inner.y + 162.0, chains_inner.width, 146.0)
    let chain_slot = 0
    while chain_slot < kloner_chain_modifier_count(active_chain):
        let modifier_kind = kloner_chain_modifier_kind(active_chain, chain_slot)
        let card = kaintana_column_slot(slot_rect, Float(chain_slot), 30.0, 8.0)
        let _card = kaintana_primitive_fill(session, chains_panel, "chains.card." + str(chain_slot), card, theme.shell_red, theme.shell_green, theme.shell_blue)
        let _card_rule = kaintana_primitive_fill(session, chains_panel, "chains.card.rule." + str(chain_slot), kaintana_rect(card.x, card.y, 4.0, card.height), kloner_modifier_accent_r(modifier_kind), kloner_modifier_accent_g(modifier_kind), kloner_modifier_accent_b(modifier_kind))
        let _card_label = kaintana_primitive_text(session, chains_panel, "chains.card.label." + str(chain_slot), "0" + str(chain_slot + 1) + " // " + kloner_modifier_name(modifier_kind), kaintana_rect(card.x + 12.0, card.y + 4.0, card.width - 24.0, 18.0), theme.ink_red, theme.ink_green, theme.ink_blue, micro_font, 13.0)
        chain_slot = chain_slot + 1
    let _chains_metric_duration = kaintana_immediate_metric(session, chains_panel, "chains.duration", "duration.ms", str(kloner_chain_duration_ms(active_chain)), kaintana_rect(chains_inner.x, chains_inner.y + 320.0, chains_inner.width, 18.0), theme, micro_font, 13.0)

    let selected_modifier_kind = kloner_chain_modifier_kind(active_chain, 1)
    let _inspector_title = kaintana_retained_label(session, inspector_panel, "inspector.title", "PARAMETERS", kaintana_rect(inspector_inner.x, inspector_inner.y, inspector_inner.width, 22.0), theme, badge_font, 18.0)
    let _inspector_mod = kaintana_retained_label(session, inspector_panel, "inspector.mod", kloner_modifier_name(selected_modifier_kind), kaintana_rect(inspector_inner.x, inspector_inner.y + 34.0, inspector_inner.width, 24.0), theme, body_font, 18.0)
    let _inspector_family = kaintana_retained_muted_label(session, inspector_panel, "inspector.family", "family=" + kloner_family_name(kloner_modifier_family(selected_modifier_kind)) + " // axis=" + kloner_modifier_axis(selected_modifier_kind), kaintana_rect(inspector_inner.x, inspector_inner.y + 60.0, inspector_inner.width, 22.0), theme, micro_font, 13.0)
    let _slider_speed = kaintana_immediate_slider(session, inspector_panel, "inspector.speed", "speed", kloner_modifier_speed(selected_modifier_kind) * 100.0, 0.0, 400.0, kaintana_rect(inspector_inner.x, inspector_inner.y + 104.0, inspector_inner.width, 62.0), theme, body_font, 16.0)
    let _slider_amount = kaintana_immediate_slider(session, inspector_panel, "inspector.amount", "amount", kloner_modifier_amount(selected_modifier_kind) * 100.0, 0.0, 150.0, kaintana_rect(inspector_inner.x, inspector_inner.y + 176.0, inspector_inner.width, 62.0), theme, body_font, 16.0)
    let _slider_key = kaintana_immediate_slider(session, inspector_panel, "inspector.key", "key.track", kloner_key_sample(3, current_time_ms, 0.44) * 100.0, 0.0, 100.0, kaintana_rect(inspector_inner.x, inspector_inner.y + 248.0, inspector_inner.width, 62.0), theme, body_font, 16.0)
    let _chart_total = kaintana_immediate_chart_bar(session, inspector_panel, "inspector.chart.total", "clone_total", Float(clone_total), 128.0, kaintana_rect(inspector_inner.x, inspector_inner.y + 326.0, inspector_inner.width, 54.0), theme, body_font, 16.0, theme.signal_red, theme.signal_green, theme.signal_blue)
    let _chart_signature = kaintana_immediate_chart_bar(session, inspector_panel, "inspector.chart.sig", "export_sig", Float(kloner_abs_int(export_signature % 1000)), 1000.0, kaintana_rect(inspector_inner.x, inspector_inner.y + 388.0, inspector_inner.width, 54.0), theme, body_font, 16.0, theme.accent_red, theme.accent_green, theme.accent_blue)
    let _metric_mode = kaintana_immediate_metric(session, inspector_panel, "inspector.metric.mode", "mode", kloner_mode_name(active_mode), kaintana_rect(inspector_inner.x, inspector_inner.y + 456.0, inspector_inner.width, 18.0), theme, micro_font, 13.0)
    let _metric_export = kaintana_immediate_metric(session, inspector_panel, "inspector.metric.export", "export", kloner_export_format_name(active_export) + " / " + kloner_export_mode_name(export_mode), kaintana_rect(inspector_inner.x, inspector_inner.y + 482.0, inspector_inner.width, 18.0), theme, micro_font, 13.0)
    let _metric_target = kaintana_immediate_metric(session, inspector_panel, "inspector.metric.target", "target", kloner_target_name(target_engine), kaintana_rect(inspector_inner.x, inspector_inner.y + 508.0, inspector_inner.width, 18.0), theme, micro_font, 13.0)
    let _metric_ref = kaintana_immediate_metric(session, inspector_panel, "inspector.metric.ref", "reference", reference_asset_label, kaintana_rect(inspector_inner.x, inspector_inner.y + 534.0, inspector_inner.width, 18.0), theme, micro_font, 13.0)

    let _footer_status = kaintana_retained_muted_label(session, footer_panel, "footer.status", status_text, kaintana_rect(footer_inner.x, footer_inner.y + 4.0, 490.0, 18.0), theme, micro_font, 13.0)
    let _footer_transport = kaintana_immediate_metric(session, footer_panel, "footer.transport", "transport.ms", str(current_time_ms), kaintana_rect(footer_inner.x, footer_inner.y + 34.0, 170.0, 18.0), theme, micro_font, 13.0)
    let _footer_dialog = kaintana_immediate_metric(session, footer_panel, "footer.dialog", "dialog", str(dialog_result), kaintana_rect(footer_inner.x + 184.0, footer_inner.y + 34.0, 120.0, 18.0), theme, micro_font, 13.0)
    let _footer_menu = kaintana_immediate_metric(session, footer_panel, "footer.menu", "menu.items", str(kaintana_menu_item_count(session, settings_menu)), kaintana_rect(footer_inner.x + 318.0, footer_inner.y + 34.0, 140.0, 18.0), theme, micro_font, 13.0)
    let _footer_trace = kaintana_immediate_metric(session, footer_panel, "footer.trace", "input.events", str(kaintana_action_event_count(action_session)), kaintana_rect(footer_inner.x + 472.0, footer_inner.y + 34.0, 160.0, 18.0), theme, micro_font, 13.0)
    let _footer_clip = kaintana_immediate_metric(session, footer_panel, "footer.clip", "clipboard", str(len(kaintana_clipboard_text(session))), kaintana_rect(footer_inner.x + 646.0, footer_inner.y + 34.0, 140.0, 18.0), theme, micro_font, 13.0)
    let _footer_file = kaintana_immediate_metric(session, footer_panel, "footer.file", "preview.file", kloner_path_leaf(settings.export_preview_path), kaintana_rect(footer_inner.x + 800.0, footer_inner.y + 34.0, 240.0, 18.0), theme, micro_font, 13.0)

    if kaintana_popover_is_open(session, settings_button, settings_popover) == 1:
        let popover_bounds = kaintana_rect(top_inner.x + top_inner.width - 314.0, top_inner.y + 44.0, 274.0, 108.0)
        let settings_region = kaintana_popover_region(session, top_bar, settings_button, "SETTINGS", popover_bounds, settings_popover, theme, badge_font, 18.0)
        let _popover_a = kaintana_retained_muted_label(session, settings_region, "popover.a", "target=" + kloner_target_name(target_engine) + " // format=" + kloner_export_format_name(active_export), kaintana_rect(popover_bounds.x + 14.0, popover_bounds.y + 36.0, popover_bounds.width - 28.0, 18.0), theme, micro_font, 13.0)
        let _popover_b = kaintana_retained_muted_label(session, settings_region, "popover.b", "export_path=" + kloner_path_leaf(settings.export_preview_path), kaintana_rect(popover_bounds.x + 14.0, popover_bounds.y + 58.0, popover_bounds.width - 28.0, 18.0), theme, micro_font, 13.0)
        let _popover_c = kaintana_retained_muted_label(session, settings_region, "popover.c", "entangle.mode=" + str(active_mode) + " // menu.command0=" + str(kaintana_menu_item_command(session, settings_menu, 0)), kaintana_rect(popover_bounds.x + 14.0, popover_bounds.y + 80.0, popover_bounds.width - 28.0, 18.0), theme, micro_font, 13.0)

    if show_reference_browser == 1 and kaintana_popover_is_open(session, browse_button, browser_popover) == 1:
        let browser_bounds = kaintana_rect(viewport_inner.x + viewport_inner.width - 370.0, viewport_inner.y + 18.0, 350.0, 150.0)
        let browser_region = kaintana_popover_region(session, viewport_surface, browse_button, "REFERENCE BROWSER", browser_bounds, browser_popover, theme, badge_font, 18.0)
        let _browser_a = kaintana_retained_label(session, browser_region, "browser.file", reference_asset_label, kaintana_rect(browser_bounds.x + 14.0, browser_bounds.y + 34.0, browser_bounds.width - 28.0, 20.0), theme, body_font, 16.0)
        let _browser_b = kaintana_retained_muted_label(session, browser_region, "browser.lines", "lines=" + str(reference_lines) + " // bytes=" + str(reference_bytes), kaintana_rect(browser_bounds.x + 14.0, browser_bounds.y + 58.0, browser_bounds.width - 28.0, 18.0), theme, micro_font, 13.0)
        let _browser_c = kaintana_retained_muted_label(session, browser_region, "browser.note", "The legacy TSX stays the source of truth while the authored Kain lane absorbs the same operator vocabulary.", kaintana_rect(browser_bounds.x + 14.0, browser_bounds.y + 84.0, browser_bounds.width - 28.0, 40.0), theme, micro_font, 13.0)

    let _focus_ring = kaintana_render_focus_ring(session, export_commit_button, theme, 4.0)
    let _commit = kaintana_commit_frame(session)
    let frame_report = kloner_frame_report_text(settings, theme, headline, status_text, active_mode, active_chain, active_export, export_mode, target_engine, clone_total, current_time_ms, preview_hash, export_signature, dialog_result, action_session)
    fs_write_text(settings.frame_report_path, frame_report)
    fs_write_text(settings.snapshot_path, state_text)
    fs_write_text(settings.input_trace_path, kaintana_action_trace_text(action_session))
    let _scene_report = kaintana_desktop_scene_write_report(settings.scene_report_path)
    let _popover_close = kaintana_popover_close(session, settings_button, settings_popover)

    if !kloner_mode_valid(active_mode):
        return 20
    if !kloner_clone_budget_valid(clone_total):
        return 21
    if !kloner_preview_hash_valid(preview_hash):
        return 22
    if dialog_id <= 0 or dialog_result != 207:
        return 23
    if kaintana_active_menu(session) != settings_menu:
        return 24
    if kaintana_menu_item_count(session, settings_menu) != 3:
        return 25
    if show_reference_browser != 1 or kaintana_popover_is_open(session, browse_button, browser_popover) != 1:
        return 26
    if kaintana_action_event_count(action_session) < 1:
        return 27
    if kaintana_clipboard_text(session) != settings.export_preview_path:
        return 28
    if !fs_exists(settings.state_path) or !fs_exists(settings.export_preview_path) or !fs_exists(settings.frame_report_path) or !fs_exists(settings.snapshot_path) or !fs_exists(settings.input_trace_path) or !fs_exists(settings.scene_report_path):
        return 29

    let host_status = kaintana_host_run_window(spec)
    let _host_report = kaintana_host_write_report(spec)
    let _host_shot = kaintana_host_write_screenshot(spec)
    let _action_destroy = kaintana_action_session_destroy(action_session)

    if host_status != 0:
        return 30
    if kaintana_host_frames_presented(spec) < 1:
        return 31
    if kaintana_host_geometry_count(spec) < 1:
        return 32
    if !fs_exists(settings.screenshot_path):
        return 33
    return 0
