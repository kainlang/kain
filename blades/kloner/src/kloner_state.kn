    let run_root = fs_path_join(".kain", "run")
    let reference_root = "reference"
    let vulkain_root = "../vulkain/.kain/gpu/basic_window"
    return KlonerSettings {
        title: "Kloner // 3D Clone Workstation",
        theme_name: "oxide-dcc",
        width: 1720,
        height: 1040,
        frame_budget: kloner_frame_budget_or_default(160),
        revision_key: "kloner-desktop-v2-vulkain-sidecar",
        clear_red: 18,
        clear_green: 20,
        clear_blue: 24,
        accent_red: 255,
        accent_green: 156,
        accent_blue: 74,
        frame_report_path: fs_path_join(run_root, "kloner_frame.txt"),
        host_report_path: fs_path_join(run_root, "kloner_host.txt"),
        screenshot_path: fs_path_join(run_root, "kloner.bmp"),
        snapshot_path: fs_path_join(run_root, "kloner_snapshot.txt"),
        input_trace_path: fs_path_join(run_root, "kloner_input_trace.txt"),
        state_path: fs_path_join(run_root, "kloner_state_snapshot.txt"),
        export_preview_path: fs_path_join(run_root, "kloner_export_preview.json"),
        scene_report_path: fs_path_join(run_root, "kloner_scene.txt"),
        vulkain_report_path: fs_path_join(run_root, "kloner_vulkain_report.txt"),
        vulkain_vertex_shader_path: fs_path_join(vulkain_root, "vulkain_basic.vert.spv"),
        vulkain_fragment_shader_path: fs_path_join(vulkain_root, "vulkain_basic.frag.spv"),
        reference_root: reference_root,
        reference_spec_path: fs_path_join(reference_root, "KCloner.tsx"),
    }

