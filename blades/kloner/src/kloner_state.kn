pub fn kloner_chain_name(chain_index: Int) -> String:
    let names = ["GRID LIFT", "CROWN SWARM", "EXPORT DRIFT"]
    return names[int_clamp(chain_index, 0, len(names) - 1)]

pub fn kloner_chain_duration_ms(chain_index: Int) -> Int:
    let durations = [2200, 2500, 2100]
    return durations[int_clamp(chain_index, 0, len(durations) - 1)]

pub fn kloner_chain_modifier_count(chain_index: Int) -> Int:
    let counts = [4, 4, 4]
    return counts[int_clamp(chain_index, 0, len(counts) - 1)]

pub fn kloner_chain_modifier_kind(chain_index: Int, slot: Int) -> Int:
    if chain_index == 0:
        let kinds = [KLONER_MOD_ORBIT, KLONER_MOD_PULSE, KLONER_MOD_FLOAT, KLONER_MOD_STEP]
        return kinds[int_clamp(slot, 0, len(kinds) - 1)]
    if chain_index == 1:
        let kinds = [KLONER_MOD_FIGURE8, KLONER_MOD_TWIST, KLONER_MOD_BREATHE, KLONER_MOD_NOISE_FLOW]
        return kinds[int_clamp(slot, 0, len(kinds) - 1)]
    let kinds = [KLONER_MOD_SPIRAL, KLONER_MOD_BOUNCE, KLONER_MOD_TUMBLE, KLONER_MOD_CODE]
    return kinds[int_clamp(slot, 0, len(kinds) - 1)]

pub fn kloner_chain_step_interval_ms(chain_index: Int) -> Int:
    if chain_index == 0:
        return 125
    return 0

pub fn kloner_total_duration_ms() -> Int:
    return kloner_chain_duration_ms(0) + kloner_chain_duration_ms(1) + kloner_chain_duration_ms(2)

pub fn kloner_active_chain_for_time(current_time_ms: Int) -> Int:
    if current_time_ms < kloner_chain_duration_ms(0):
        return 0
    if current_time_ms < kloner_chain_duration_ms(0) + kloner_chain_duration_ms(1):
        return 1
    return 2

pub fn kloner_local_chain_time_ms(current_time_ms: Int, chain_index: Int) -> Int:
    if chain_index == 0:
        return current_time_ms
    if chain_index == 1:
        return current_time_ms - kloner_chain_duration_ms(0)
    return current_time_ms - kloner_chain_duration_ms(0) - kloner_chain_duration_ms(1)

pub fn kloner_clamp01(value: Float) -> Float:
    if value < 0.0:
        return 0.0
    if value > 1.0:
        return 1.0
    return value

pub fn kloner_lerp(a: Float, b: Float, t: Float) -> Float:
    return a + ((b - a) * kloner_clamp01(t))

pub fn kloner_float_max(left: Float, right: Float) -> Float:
    if left >= right:
        return left
    return right

pub fn kloner_abs_int(value: Int) -> Int:
    if value < 0:
        return 0 - value
    return value

pub fn kloner_string_slice(text: String, start: Int, finish: Int) -> String:
    let result = ""
    let index = int_max(start, 0)
    let safe_finish = int_min(finish, len(text))
    while index < safe_finish:
        result = result + char_at(text, index)
        index = index + 1
    return result

pub fn kloner_first_line(text: String) -> String:
    if len(text) == 0:
        return ""
    let index = 0
    while index < len(text) and char_at(text, index) != "\n":
        index = index + 1
    return kloner_string_slice(text, 0, index)

pub fn kloner_path_leaf(path: String) -> String:
    if len(path) == 0:
        return ""
    let last = 0
    let index = 0
    while index < len(path):
        let ch = char_at(path, index)
        if ch == "/" or ch == "\\":
            last = index + 1
        index = index + 1
    return kloner_string_slice(path, last, len(path))

pub fn kloner_reference_line_count(text: String) -> Int:
    if len(text) == 0:
        return 0
    let count = 1
    let index = 0
    while index < len(text):
        if char_at(text, index) == "\n":
            count = count + 1
        index = index + 1
    return count

pub fn kloner_headline(mode_id: Int, chain_index: Int, export_format: Int, clone_total: Int) -> String:
    return "KLONER // " + kloner_mode_name(mode_id) + " // " + kloner_chain_name(chain_index) + " // " + kloner_export_format_name(export_format) + " // clones=" + str(clone_total)

