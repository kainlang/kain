// style: marine relay adapter probe
use c::kaintana_desktop_bridge
use c::vulkain_bridge
use kaintana::kaintana_backend_vulkan
use kaintana::kaintana_default_window_spec
use kaintana_vulkan::kaintana_vulkan_embed_available

fn main() -> Int:
    let spec = kaintana_default_window_spec("Kaintana Vulkan // Adapter Probe", 960, 540, kaintana_backend_vulkan())
    println("kaintana_vulkan.backend=" + spec.backend_id)
    println("kaintana_vulkan.available=" + str(kaintana_vulkan_embed_available()))
    if spec.width != 960:
        return 10
    if kaintana_vulkan_embed_available() != 1:
        return 20
    return 0
