// // ============================================================================
// //                          std::mcp — Model Context Protocol
// // ============================================================================
// // Kain-native MCP server construction for the 2025-03-26 protocol revision.
// //
// // This module provides universal JSON-RPC 2.0 framing, the lifecycle handshake,
// // content-type constructors, stdio transport I/O, structured logging to stderr,
// // and a reference event loop.  Streamable HTTP transport is a future lane.
// //
// // Import:  use std::mcp
// //
// // Runtime primitives used directly (no @extern wrappers needed):
// //   read_line()       — block until newline on stdin, return line ("" on EOF)
// //   stdout_write(s)   — write to stdout, flush
// //   stderr_write(s)   — write to stderr, flush
//
// use std::json
//
