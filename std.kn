// pub fn native_reload_actor_migration_plan(session_id: Int) -> ReloadMigrationPlan:
//     return native_reload_plan_for_lane(session_id, native_reload_lane_actor())
//
// pub fn native_reload_gpu_migration_plan(session_id: Int) -> ReloadMigrationPlan:
//     return native_reload_plan_for_lane(session_id, native_reload_lane_gpu())
//
// # root-domain aliases: generated public std names
