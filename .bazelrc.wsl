# WSL Bazel config — hermetic sibling cache pattern
# Cache lives at ../.bazel-cache/kain/ one level up from repo root
common --repository_cache=../.bazel-cache/kain/repo
startup --output_user_root=../.bazel-cache/kain/output-user-root
common --repo_env=TMP=../.bazel-cache/kain/tmp
common --repo_env=TEMP=../.bazel-cache/kain/tmp
common --repo_env=TMPDIR=../.bazel-cache/kain/tmp
common --action_env=TMP=../.bazel-cache/kain/tmp
common --action_env=TEMP=../.bazel-cache/kain/tmp
common --action_env=TMPDIR=../.bazel-cache/kain/tmp
build --action_env=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
