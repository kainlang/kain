use std::actor
  use std::intent
  use std::python
  use std::runtime
  use std::time

  import pygame as pygame

  const WIDTH: Int = 960
  const HEIGHT: Int = 540
  const BALL_RADIUS: Int = 18
  const PADDLE_W: Int = 170
  const PADDLE_H: Int = 18
  const FLOOR_Y: Int = HEIGHT - 42
  const AUTO_EXIT_AFTER: Int = 0

  component GamePanel():
      render <panel title="Kain LLVM // pygame actor mirror" />

  struct GameFrameState:
      frame: Int
      ball_x: Int
      ball_y: Int
      vx: Int
      vy: Int
      paddle_x: Int
      score: Int
      energy: Int

  world GameAuthority:
      state frame: Int = 0
      state ball_x: Int = WIDTH / 2
      state ball_y: Int = HEIGHT / 2
      state paddle_x: Int = WIDTH / 2
      state score: Int = 0
      state energy: Int = 0
      state accent: Int = 0
      surface native_ui => GamePanel

  world GameMirror:
      state frame_copy: Int = 0
      state ball_x_copy: Int = WIDTH / 2
      state ball_y_copy: Int = HEIGHT / 2
      state paddle_x_copy: Int = WIDTH / 2
      state score_copy: Int = 0
      state energy_copy: Int = 0
      state accent_copy: Int = 0
      surface web => GamePanel

  entangle GameAuthority.frame <-> GameMirror.frame_copy with single_writer
  entangle GameAuthority.ball_x <-> GameMirror.ball_x_copy with single_writer
  entangle GameAuthority.ball_y <-> GameMirror.ball_y_copy with single_writer
  entangle GameAuthority.paddle_x <-> GameMirror.paddle_x_copy with single_writer
  entangle GameAuthority.score <-> GameMirror.score_copy with single_writer
  entangle GameAuthority.energy <-> GameMirror.energy_copy with single_writer
  entangle GameAuthority.accent <-> GameMirror.accent_copy with single_writer

  actor MotionOracle:
      state bias: Int = 17
      state turns: Int = 0

      on Tick(reply_to: P, request: Int):
          self.turns = self.turns + 1
          let impulse = ((request * 17) + (self.bias * 13) + (self.turns * 7) + 29) % 97
          send reply_to.Reply(value = impulse)

  law coord_ok(value: Int, limit: Int) -> Bool:
      return value >= 0 and value < limit

  patch commit_frame(authority: GameAuthority, frame: Int, ball_x: Int, ball_y: Int, paddle_x: Int, score: Int, energy: Int, accent: Int) -> Int:
      authority.frame = frame
      authority.ball_x = ball_x
      authority.ball_y = ball_y
      authority.paddle_x = paddle_x
      authority.score = score
      authority.energy = energy
      authority.accent = accent
      return authority.frame

  fn clamp_int(value: Int, low: Int, high: Int) -> Int:
      if value < low:
          return low
      if value > high:
          return high
      return value

  fn abs_int(value: Int) -> Int:
      if value < 0:
          return 0 - value
      return value

  fn metal_mix(frame: Int, x: Int, y: Int, score: Int) -> Int with Unsafe:
      let cells: ptr<Int> = alloc_zeroed(4, "Int")
      mem_store(ptr_offset(cells, 0, "Int"), frame, "Int")
      mem_store(ptr_offset(cells, 1, "Int"), x, "Int")
      mem_store(ptr_offset(cells, 2, "Int"), y, "Int")
      mem_store(ptr_offset(cells, 3, "Int"), score, "Int")
      let mixed = (
          (mem_load(ptr_offset(cells, 0, "Int"), "Int") * 3) +
          (mem_load(ptr_offset(cells, 1, "Int"), "Int") * 5) +
          (mem_load(ptr_offset(cells, 2, "Int"), "Int") * 7) +
          (mem_load(ptr_offset(cells, 3, "Int"), "Int") * 11)
      ) % 255
      decay cells
      return mixed

  fn seed_state() -> GameFrameState:
      return GameFrameState {
          frame: 0,
          ball_x: WIDTH / 2,
          ball_y: HEIGHT / 3,
          vx: 6,
          vy: 5,
          paddle_x: (WIDTH - PADDLE_W) / 2,
          score: 0,
          energy: 41
      }

  fn should_quit() -> Bool:
      let event_mod = python_getattr_raw(pygame, "event")
      let _pump = python_call_attr_raw(event_mod, "pump", [])
      let quit_code = python_getattr_raw(pygame, "QUIT")
      let seen = to_string(python_call_attr_raw(event_mod, "peek", [quit_code]))
      return seen == "True"

  fn step_state(state: GameFrameState, oracle_bias: Int) -> GameFrameState:
      let drift = (oracle_bias % 3) - 1
      var next_vx = state.vx
      var next_vy = state.vy
      var next_ball_x = state.ball_x + state.vx + drift
      var next_ball_y = state.ball_y + state.vy
      var next_score = state.score
      var next_energy = (state.energy + oracle_bias + 3) % 100000

      if next_ball_x <= BALL_RADIUS:
          next_ball_x = BALL_RADIUS
          next_vx = abs_int(next_vx)
          next_score = next_score + 1
      if next_ball_x >= WIDTH - BALL_RADIUS:
          next_ball_x = WIDTH - BALL_RADIUS
          next_vx = 0 - abs_int(next_vx)
          next_score = next_score + 1
      if next_ball_y <= BALL_RADIUS:
          next_ball_y = BALL_RADIUS
          next_vy = abs_int(next_vy)
          next_score = next_score + 2

      let paddle_target = clamp_int(next_ball_x - (PADDLE_W / 2), 0, WIDTH - PADDLE_W)
      let paddle_step = (paddle_target - state.paddle_x) / 5
      let next_paddle_x = clamp_int(state.paddle_x + paddle_step, 0, WIDTH - PADDLE_W)

      let paddle_top = FLOOR_Y
      let ball_bottom = next_ball_y + BALL_RADIUS
      if ball_bottom >= paddle_top and ball_bottom <= paddle_top + PADDLE_H + 8 and next_vy > 0:
          if next_ball_x >= next_paddle_x - BALL_RADIUS and next_ball_x <= next_paddle_x + PADDLE_W + BALL_RADIUS:
              next_ball_y = paddle_top - BALL_RADIUS
              next_vy = 0 - abs_int(next_vy)
              if next_ball_x > next_paddle_x + (PADDLE_W / 2):
                  next_vx = abs_int(next_vx) + 1
              else:
                  next_vx = 0 - (abs_int(next_vx) + 1)
              next_score = next_score + 11
              next_energy = next_energy + 29

      if next_ball_y >= HEIGHT + BALL_RADIUS:
          next_ball_x = WIDTH / 2
          next_ball_y = HEIGHT / 3
          next_vx = 5 - (oracle_bias % 3)
          next_vy = 5
          next_score = max(0, next_score - 7)
          next_energy = next_energy + 101

      return GameFrameState {
          frame: state.frame + 1,
          ball_x: next_ball_x,
          ball_y: next_ball_y,
          vx: next_vx,
          vy: next_vy,
          paddle_x: next_paddle_x,
          score: next_score,
          energy: next_energy
      }

  fn draw_scene(screen: Any, authority: GameAuthority) -> Int with Unsafe:
      let display = python_getattr_raw(pygame, "display")
      let draw = python_getattr_raw(pygame, "draw")
      let accent = metal_mix(authority.frame, authority.ball_x, authority.ball_y, authority.score)
      let glow_r = 64 + (accent % 191)
      let glow_g = 90 + ((authority.energy + accent) % 165)
      let glow_b = 120 + (((authority.frame * 3) + accent) % 135)

      let _fill = python_call_attr_raw(screen, "fill", [[10, 12, 18]])
      let _floor = python_call_attr_raw(draw, "rect", [screen, [24, 32, 48], [0, FLOOR_Y + PADDLE_H, WIDTH, HEIGHT - (FLOOR_Y + PADDLE_H)]])
      let _mirror = python_call_attr_raw(draw, "circle", [screen, [40, 170, 255], [GameMirror.ball_x_copy, GameMirror.ball_y_copy], 7])
      let _paddle = python_call_attr_raw(draw, "rect", [screen, [235, 235, 245], [authority.paddle_x, FLOOR_Y, PADDLE_W, PADDLE_H]])
      let _ball = python_call_attr_raw(draw, "circle", [screen, [glow_r, glow_g, glow_b], [authority.ball_x, authority.ball_y], BALL_RADIUS])
      let _score_bar = python_call_attr_raw(draw, "rect", [screen, [80, 220, 140], [24, 24, 40 + (authority.score % 260), 12]])
      let _flip = python_call_attr_raw(display, "flip", [])
      return accent

  fn main() -> Int with Unsafe:
      let authority = GameAuthority
      let boot = runtime_init()
      if boot != 0:
          return 100 + boot

      let _init = python_call_attr_raw(pygame, "init", [])
      let display = python_getattr_raw(pygame, "display")
      let _caption = python_call_attr_raw(display, "set_caption", ["Kain LLVM // actor entangle pygame lane"])
      let screen = python_call_attr_raw(display, "set_mode", [[WIDTH, HEIGHT]])
      let version = to_string(python_getattr_raw(python_getattr_raw(pygame, "version"), "ver"))
      println("pygame=" + version)

      let oracle = spawn MotionOracle(bias = 17)
      var state = seed_state()
      var running = true

      while running:
          if should_quit():
              running = false
          else:
              let oracle_bias = ask(oracle, "Tick", state.frame + state.score + state.energy)
              state = step_state(state, oracle_bias)
              let accent = metal_mix(state.frame, state.ball_x, state.ball_y, state.score)
              let committed = commit_frame(authority, state.frame, state.ball_x, state.ball_y, state.paddle_x, state.score, state.energy, accent)
              if committed != state.frame:
                  running = false
              else:
                  let _drawn_accent = draw_scene(screen, authority)
                  if AUTO_EXIT_AFTER > 0 and authority.frame >= AUTO_EXIT_AFTER:
                      running = false
                  sleep_millis(16)

      let _quit = python_call_attr_raw(pygame, "quit", [])
      if coord_ok(authority.ball_x, WIDTH) == false or coord_ok(authority.paddle_x, WIDTH) == false:
          let shutdown_bad = runtime_shutdown()
          if shutdown_bad != 0:
              return 300 + shutdown_bad
          return 20

      let shutdown = runtime_shutdown()
      if shutdown != 0:
          return 400 + shutdown
      println("final_score=" + str(authority.score) + " mirror_frame=" + str(GameMirror.frame_copy))
      return 0