//                          SECTION 3: Process Identity
// ============================================================================
//  Python: os.getpid(), os.getppid(), os.getuid(), os.getgid(), os.getlogin()

pub fn os_getpid() -> Int:
    return process_current_id()

pub fn os_getppid() -> Int:
    return abi_os_getppid()

pub fn os_getlogin() -> String:
    return abi_os_getlogin()

pub fn os_getuid() -> Int:
    return abi_os_getuid()

pub fn os_getgid() -> Int:
    return abi_os_getgid()

