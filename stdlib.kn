// --- Formatting ---

pub fn format_document(doc: Document) -> FormatResult:
    let res = kain_service_format_document(doc._ws_id, doc._doc_id)
    let status = json_get_int(res, "status")
    var diagnostics: Array<Diagnostic> = []
    if status == 0:
        let diags_raw = json_get(res, "diagnostics")
        var i: Int = 0
        while i < json_array_length(diags_raw):
            push(diagnostics, _diagnostic_from(json_array_value_at(diags_raw, i)))
            i = i + 1
        0
    return FormatResult {
        formatted: json_string_or(res, "formatted", ""),
        already_formatted: json_bool_or(res, "already_formatted", false),
        diagnostics: diagnostics,
    }

// ============================================================================
// kaintana/Widget.kn
// ============================================================================
// ============================================================================
//  Widget.kn — The base trait that all Kaintana widgets satisfy
//  P0-002: Infrastructure trait for widget participation in the rendering pipeline.
//
//  Rules:
//  - Widget is infrastructure, NOT the primary authoring surface.
//    Primary authoring surface is `component` keyword.
//  - Four method slots with sensible defaults.
//  - element_id returns -1 by default (not rendered in the current frame).
//  - Developers rarely implement Widget directly — built-in widgets
//    implement it internally. External developers use `component`.
// ============================================================================

use std::kaintana::core as core

/// Base trait for all Kaintana widgets.
///
/// Provides the minimal contract for a widget to participate in the
/// rendering pipeline: stable key for reconciliation, kind string for
/// element creation, element ID for interaction queries, and an
/// interaction tick hook for per-frame state management.
///
/// Default implementations:
/// - stable_key: "" (unkeyed — C substrate uses node index)
/// - kind: "widget" (generic fallback — override per widget type)
/// - element_id: -1 (not rendered until kt_row is called)
/// - tick_interaction: no-op (override for hover/click/active queries)
pub trait Widget:
    /// Return the stable key of the root element this widget owns.
    /// Used for tree reconciliation across frames.
    /// Default: empty string (unkeyed element).
    fn stable_key(_self: Self_) -> String:
        return ""

    /// Return the kind string passed to kt_row.
    /// Examples: "button", "slider", "textinput", "toggle", "widget".
    fn kind(_self: Self_) -> String:
        return "widget"

    /// Return the element ID after kt_row has been called.
    /// -1 means the widget has not been rendered in the current frame.
    fn element_id(_self: Self_) -> Int:
        return -1

    /// Process interaction state. Called after render, before paint.
    /// Override to call kt_hovered/kt_clicked/kt_active and update
    /// component state fields.
    fn tick_interaction(_self: Self_):
        return

// ============================================================================
// kaintana/animation.kn
// ============================================================================
// ============================================================================
//  animation.kn — Spring Physics, Tween, and Easing Functions
//  P1-006: Pure Kain Float math — NO C calls needed for computation.
//
//  Architecture:
//    All animation state lives in Kain component state, driven by the
//    `pulse` keyword. The C substrate is stateless animation-wise — it
//    draws what it's told. Animation state is mutable component state.
//
//  Contents:
//    SpringState   — damped spring physics integrator
//    TweenState    — linear interpolation over duration with easing
//    Easing fns    — smoothstep, smootherstep, ease_in/out/in_out
//    lerp/lerp_color — linear interpolation helpers
//
//  Dependencies:
//    - theme.kn: KtColor.lerp for lerp_color
//    - core.kn: not needed — all pure Kain math
//
//  Rules:
//    1. NO C calls for computation — all math is pure Kain Float ops.
//    2. Spring model: Hooke's law + damping force, Euler integration.
//    3. Tween model: linear over duration, eased at endpoint.
//    4. Easing functions are Z3-proven in kaintana.h §18.
//    5. lerp_color delegates to KtColor.lerp from theme.kn.
// ============================================================================

use std::kaintana::theme as theme

// ============================================================================
//  SPRING PHYSICS
//  Damped spring model using Hooke's law with critical damping.
//  Semi-implicit Euler integration for stability.
//
//  Physics model:
//    force       = -stiffness * (value - target)
//    damping     = -damping * velocity
//    acceleration = force + damping
//    velocity    = velocity + acceleration * dt
//    value       = value + velocity * dt
//
//  Default parameters (stiffness=0.3, damping=0.7) give a critically
//  damped response — fast approach without oscillation. Higher stiffness
//  = snappier, higher damping = less bounce.
// ============================================================================

/// Spring state: tracks animated value and its velocity over time.
///
/// Fields:
///   value     — current animated value (Float)
///   velocity  — current rate of change (Float per ms)
///   stiffness — spring stiffness coefficient (higher = faster response)
///   damping   — damping ratio (higher = less oscillation)
pub struct SpringState:
    value:     Float
    velocity:  Float
    stiffness: Float
    damping:   Float

/// Create a default SpringState with critically-damped parameters.
///
/// Defaults:
///   value:     0.0
///   velocity:  0.0
///   stiffness: 0.3
///   damping:   0.7
///
/// These defaults give a smooth, non-oscillating response suitable
/// for most UI animations. Adjust stiffness for speed and damping
/// for bounce behavior.
pub fn spring_default() -> SpringState:
    return SpringState {
        value: 0.0,
        velocity: 0.0,
        stiffness: 0.3,
        damping: 0.7,
    }

/// Create a SpringState with custom parameters.
///
/// Args:
///   initial_value — starting value for the animation
///   initial_velocity — starting velocity (usually 0.0)
///   stiffness — spring stiffness (default 0.3, range ~0.1-1.0)
///   damping   — damping ratio (default 0.7, range ~0.1-1.0)
pub fn spring_new(
    initial_value: Float,
    initial_velocity: Float,
    stiffness: Float,
    damping: Float,
) -> SpringState:
    return SpringState {
        value: initial_value,
        velocity: initial_velocity,
        stiffness: stiffness,
        damping: damping,
    }

/// Advance the spring simulation by dt_ms toward a target value.
///
/// Uses semi-implicit Euler integration for numerical stability.
/// The returned SpringState has the updated value and velocity.
///
/// Args:
///   state  — current spring state
///   target — target value to spring toward
///   dt_ms  — elapsed time in milliseconds since last update
///
/// Returns:
///   Updated SpringState with advanced value and velocity.
pub fn spring_update(state: SpringState, target: Float, dt_ms: Float) -> SpringState:
    let delta = state.value - target
    let force = -state.stiffness * delta
    let damping_force = -state.damping * state.velocity
    let acceleration = force + damping_force

    let new_velocity = state.velocity + acceleration * dt_ms
    let new_value = state.value + new_velocity * dt_ms

    return SpringState {
        value: new_value,
        velocity: new_velocity,
        stiffness: state.stiffness,
        damping: state.damping,
    }

/// Check if a spring has approximately settled at its target.
///
/// Returns true when the value is within `epsilon` of the target
/// AND velocity is below `velocity_epsilon`. Use this to stop
/// updating springs that have settled, saving CPU cycles.
///
/// Args:
///   state   — current spring state
///   target  — target value
///   epsilon — allowed value tolerance (default 0.01)
///   velocity_epsilon — allowed velocity tolerance (default 0.01)
pub fn spring_settled(
    state: SpringState,
    target: Float,
    epsilon: Float,
    velocity_epsilon: Float,
) -> Bool:
    let value_diff = state.value - target
    if value_diff < 0.0:
        let abs_diff = -value_diff
        if abs_diff > epsilon:
            return false
    else:
        if value_diff > epsilon:
            return false

    let abs_vel = if state.velocity < 0.0: -state.velocity else: state.velocity
    if abs_vel > velocity_epsilon:
        return false

    return true

// ============================================================================
//  TWEEN ANIMATION
//  Linear interpolation from start_value to end_value over duration_ms.
//  Uses easing function to compute the interpolated output value.
//  Non-reversing — runs forward once to completion.
// ============================================================================

/// Tween state: tracks a linear animation from start to end over time.
///
/// Fields:
///   start_value  — value at t=0 (animation start)
///   end_value    — value at t=1 (animation end)
///   duration_ms  — total animation duration in milliseconds
///   elapsed_ms   — time elapsed since animation start
pub struct TweenState:
    start_value: Float
    end_value:   Float
    duration_ms: Float
    elapsed_ms:  Float

/// Create a new TweenState starting at `start` and ending at `end`
/// over `duration_ms` milliseconds.
///
/// The tween starts with elapsed_ms = 0.0. Each call to tween_update
/// advances the elapsed time. Call tween_value to get the current
/// interpolated output, which applies easing automatically.
pub fn tween_new(start: Float, end: Float, duration_ms: Float) -> TweenState:
    return TweenState {
        start_value: start,
        end_value: end,
        duration_ms: duration_ms,
        elapsed_ms: 0.0,
    }

/// Advance a TweenState by `dt_ms` milliseconds.
///
/// Clamps elapsed_ms to duration_ms so the tween does not
/// overshoot. Once elapsed_ms >= duration_ms, the tween is
/// complete and subsequent tween_value calls return end_value.
pub fn tween_update(state: TweenState, dt_ms: Float) -> TweenState:
    let new_elapsed = state.elapsed_ms + dt_ms
    if new_elapsed >= state.duration_ms:
        return TweenState {
            start_value: state.start_value,
            end_value: state.end_value,
            duration_ms: state.duration_ms,
            elapsed_ms: state.duration_ms,
        }
    return TweenState {
        start_value: state.start_value,
        end_value: state.end_value,
        duration_ms: state.duration_ms,
        elapsed_ms: new_elapsed,
    }

/// Compute the current interpolated value of a TweenState.
///
/// Applies ease_out easing to the normalized progress t.
/// When elapsed_ms >= duration_ms, returns end_value directly.
///
/// Normalized t = elapsed_ms / duration_ms, clamped to [0, 1].
/// Eased t = ease_out(t), then lerp(start, end, eased_t).
pub fn tween_value(state: TweenState) -> Float:
    if state.elapsed_ms >= state.duration_ms:
        return state.end_value
    let t = state.elapsed_ms / state.duration_ms
    let eased_t = ease_out(t)
    return state.start_value + (state.end_value - state.start_value) * eased_t

/// Check if a tween has completed (reached or passed end).
pub fn tween_done(state: TweenState) -> Bool:
    return state.elapsed_ms >= state.duration_ms

// ============================================================================
//  EASING FUNCTIONS
//  All functions take t in [0, 1] and return an eased value in [0, 1].
//
//  These wrap the Z3-proven inline helpers in kaintana.h §18.
//  All are UNSAT-proven for bounds [-1e-6, 1+1e-6], monotonicity,
//  and C0/C1/C2 derivative continuity.
//
//  smoothstep:     t^2(3 - 2t) — C1 continuous
//  smootherstep:   t^3(t(6t - 15) + 10) — C2 continuous
//  ease_in:        t^3 — cubic in
//  ease_out:       1 - (1-t)^3 — cubic out
//  ease_in_out:    piecewise — 4t^3 for t<0.5, 1-(2-2t)^3/2 for t>=0.5
// ============================================================================

/// Smoothstep: t^2 * (3 - 2t). C1 continuous, S-shaped curve.
/// Gentle acceleration at start, deceleration at end.
pub fn ease_smoothstep(t: Float) -> Float:
    return t * t * (3.0 - 2.0 * t)

/// Smootherstep: t^3 * (t * (6t - 15) + 10). C2 continuous.
/// Smoother than smoothstep — second derivative is continuous.
pub fn ease_smootherstep(t: Float) -> Float:
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

/// Ease-in: t^3. Cubic acceleration from rest.
/// Starts slow, ends fast. Use for objects entering the scene.
pub fn ease_in(t: Float) -> Float:
    return t * t * t

/// Ease-out: 1 - (1 - t)^3. Cubic deceleration to rest.
/// Starts fast, ends slow. Use for objects leaving the scene.
pub fn ease_out(t: Float) -> Float:
    let u = 1.0 - t
    return 1.0 - u * u * u

/// Ease-in-out: piecewise cubic. Symmetric S-curve.
/// t < 0.5: 4 * t^3 (accelerating)
/// t >= 0.5: 1 - (2 - 2t)^3 / 2 (decelerating)
/// Use for objects moving between two on-screen positions.
pub fn ease_in_out(t: Float) -> Float:
    if t < 0.5:
        return 4.0 * t * t * t
    let u = 2.0 - 2.0 * t
    return 1.0 - u * u * u * 0.5

/// Clamp t to [0, 1] range before applying an easing function.
/// Use with any easing function to guarantee valid output range.
pub fn ease_clamp(t: Float) -> Float:
    if t < 0.0:
        return 0.0
    if t > 1.0:
        return 1.0
    return t

// ============================================================================
//  LINEAR INTERPOLATION HELPERS
// ============================================================================

/// Linear interpolation: a + (b - a) * t.
///
/// When t = 0: returns a. When t = 1: returns b.
/// t is NOT clamped — extrapolation works naturally.
pub fn lerp(a: Float, b: Float, t: Float) -> Float:
    return a + (b - a) * t

/// Color linear interpolation: delegates to KtColor.lerp.
///
/// Uses the sRGB lerp from theme.kn (KtColor). This is NOT gamma-aware
/// lerp — it's a straight channel-by-channel interpolation suitable for
/// most UI animation needs.
pub fn lerp_color(a: theme::KtColor, b: theme::KtColor, t: Float) -> theme::KtColor:
    return a.lerp(b, t)

// ============================================================================
//  CLAMP HELPER
// ============================================================================

/// Clamp a Float value to [lo, hi] range.
pub fn clamp_float(v: Float, lo: Float, hi: Float) -> Float:
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

// ============================================================================
// kaintana/color.kn
// ============================================================================
// ============================================================================
//  color.kn — Color math, blend modes, gradient helpers, color spaces
//  P2-019: Blend mode constants KT_BLEND_SRC_OVER (0) through
//          KT_BLEND_LUMINOSITY (26). Gradient helpers, color space helpers.
//
//  Design:
//    - Blend mode constants match kaintana.h KaintanaBlendMode enum exactly.
//    - CSS blend mode helpers (per-channel Float, pure Kain math).
//    - compose_blend: foreground/background compositing with mode dispatch.
//    - Color space conversions: pure Float math (piecewise sRGB/linear).
//    - gradient_sample: pure Kain gradient sampling between KtColor stops.
//    - All functions operate on KtColor from theme.kn.
//
//  Uses types from std::kaintana::core and KtColor from std::kaintana::theme.
// ============================================================================

use std::kaintana::theme as theme

// ═══════════════════════════════════════════════════════════════════════════
//  Blend Mode Constants
//  Exact match: kaintana.h KaintanaBlendMode enum
// ═══════════════════════════════════════════════════════════════════════════

/// Porter-Duff: source over destination (default). Value 0.
pub const KT_BLEND_SRC_OVER:       Int = 0
/// Porter-Duff: source copy. Value 1.
pub const KT_BLEND_SRC:            Int = 1
/// Porter-Duff: destination copy. Value 2.
pub const KT_BLEND_DST:            Int = 2
/// Porter-Duff: source in. Value 3.
pub const KT_BLEND_SRC_IN:         Int = 3
/// Porter-Duff: destination in. Value 4.
pub const KT_BLEND_DST_IN:         Int = 4
/// Porter-Duff: source out. Value 5.
pub const KT_BLEND_SRC_OUT:        Int = 5
/// Porter-Duff: destination out. Value 6.
pub const KT_BLEND_DST_OUT:        Int = 6
/// Porter-Duff: source atop. Value 7.
pub const KT_BLEND_SRC_ATOP:       Int = 7
/// Porter-Duff: destination atop. Value 8.
pub const KT_BLEND_DST_ATOP:       Int = 8
/// Porter-Duff: XOR. Value 9.
pub const KT_BLEND_XOR:            Int = 9
/// Porter-Duff: plus (additive, unclamped). Value 10.
pub const KT_BLEND_PLUS:           Int = 10
/// Porter-Duff: plus lighter (additive, clamped). Value 11.
pub const KT_BLEND_PLUS_LIGHTER:   Int = 11
/// CSS: multiply. Value 12.
pub const KT_BLEND_MULTIPLY:       Int = 12
/// CSS: screen. Value 13.
pub const KT_BLEND_SCREEN:         Int = 13
/// CSS: overlay. Value 14.
pub const KT_BLEND_OVERLAY:        Int = 14
/// CSS: darken. Value 15.
pub const KT_BLEND_DARKEN:         Int = 15
/// CSS: lighten. Value 16.
pub const KT_BLEND_LIGHTEN:        Int = 16
/// CSS: color-dodge. Value 17.
pub const KT_BLEND_COLOR_DODGE:    Int = 17
/// CSS: color-burn. Value 18.
pub const KT_BLEND_COLOR_BURN:     Int = 18
/// CSS: hard-light. Value 19.
pub const KT_BLEND_HARD_LIGHT:     Int = 19
/// CSS: soft-light. Value 20.
pub const KT_BLEND_SOFT_LIGHT:     Int = 20
/// CSS: difference. Value 21.
pub const KT_BLEND_DIFFERENCE:     Int = 21
/// CSS: exclusion. Value 22.
pub const KT_BLEND_EXCLUSION:      Int = 22
/// HSL: hue. Value 23.
pub const KT_BLEND_HUE:            Int = 23
/// HSL: saturation. Value 24.
pub const KT_BLEND_SATURATION:     Int = 24
/// HSL: color. Value 25.
pub const KT_BLEND_COLOR:          Int = 25
/// HSL: luminosity. Value 26.
pub const KT_BLEND_LUMINOSITY:     Int = 26

// ═══════════════════════════════════════════════════════════════════════════
//  CSS Blend Mode Helpers — per-channel Float [0..1]
//  Pure Kain math matching kaintana.h §17D logic.
// ═══════════════════════════════════════════════════════════════════════════

/// Normal: cs (no interaction).
pub fn blend_normal(cb: Float, cs: Float) -> Float:
    let _ = cb
    return cs

/// CSS multiply: cb * cs
pub fn blend_multiply(cb: Float, cs: Float) -> Float:
    return cb * cs

/// CSS screen: cb + cs - cb * cs
pub fn blend_screen(cb: Float, cs: Float) -> Float:
    return cb + cs - cb * cs

/// CSS overlay: if cb <= 0.5: 2*cs*cb; else: 1 - 2*(1-cs)*(1-cb)
pub fn blend_overlay(cb: Float, cs: Float) -> Float:
    if cb <= 0.5:
        return 2.0 * cs * cb
    return 1.0 - 2.0 * (1.0 - cs) * (1.0 - cb)

/// CSS darken: min(cb, cs)
pub fn blend_darken(cb: Float, cs: Float) -> Float:
    if cb < cs:
        return cb
    return cs

/// CSS lighten: max(cb, cs)
pub fn blend_lighten(cb: Float, cs: Float) -> Float:
    if cb > cs:
        return cb
    return cs

/// CSS color-dodge
pub fn blend_color_dodge(cb: Float, cs: Float) -> Float:
    if cb == 0.0:
        return 0.0
    if cs >= 1.0:
        return 1.0
    let d = cb / (1.0 - cs)
    if d < 1.0:
        return d
    return 1.0

/// CSS color-burn
pub fn blend_color_burn(cb: Float, cs: Float) -> Float:
    if cb >= 1.0:
        return 1.0
    if cs == 0.0:
        return 0.0
    let d = (1.0 - cb) / cs
    if d < 1.0:
        return 1.0 - d
    return 0.0

/// CSS hard-light
pub fn blend_hard_light(cb: Float, cs: Float) -> Float:
    if cs <= 0.5:
        return 2.0 * cb * cs
    let two_cs_minus_1 = 2.0 * cs - 1.0
    return cb + two_cs_minus_1 - cb * two_cs_minus_1

/// CSS soft-light (Vello approximation)
pub fn blend_soft_light(cb: Float, cs: Float) -> Float:
    let d: Float = if cb <= 0.25:
        ((16.0 * cb - 12.0) * cb + 4.0) * cb
    else:
        if cb < 0.0:
            0.0
        else:
            cb
    if cs <= 0.5:
        return cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb)
    return cb + (2.0 * cs - 1.0) * (d - cb)

/// CSS difference: abs(cb - cs)
pub fn blend_difference(cb: Float, cs: Float) -> Float:
    let d = cb - cs
    if d < 0.0:
        return -d
    return d

/// CSS exclusion: cb + cs - 2 * cb * cs
pub fn blend_exclusion(cb: Float, cs: Float) -> Float:
    return cb + cs - 2.0 * cb * cs

// ═══════════════════════════════════════════════════════════════════════════
//  Dispatch: blend a single channel by mode number
// ═══════════════════════════════════════════════════════════════════════════

/// Blend a single channel by CSS blend mode number.
/// mode 0-11: Porter-Duff (returns cs). 12-22: CSS modes. 23-26: HSL.
pub fn blend_channel(cb: Float, cs: Float, mode: Int) -> Float:
    if mode == 12:
        return blend_multiply(cb, cs)
    elif mode == 13:
        return blend_screen(cb, cs)
    elif mode == 14:
        return blend_overlay(cb, cs)
    elif mode == 15:
        return blend_darken(cb, cs)
    elif mode == 16:
        return blend_lighten(cb, cs)
    elif mode == 17:
        return blend_color_dodge(cb, cs)
    elif mode == 18:
        return blend_color_burn(cb, cs)
    elif mode == 19:
        return blend_hard_light(cb, cs)
    elif mode == 20:
        return blend_soft_light(cb, cs)
    elif mode == 21:
        return blend_difference(cb, cs)
    elif mode == 22:
        return blend_exclusion(cb, cs)
    // Porter-Duff (0-11) and HSL (23-26): normal compositing
    return cs

// ═══════════════════════════════════════════════════════════════════════════
//  Compose Blend — blend foreground over background
// ═══════════════════════════════════════════════════════════════════════════

/// Blend foreground KtColor over background KtColor using the given mode.
pub fn compose_blend(fg: theme::KtColor, bg: theme::KtColor, mode: Int) -> theme::KtColor:
    // Porter-Duff SRC_OVER fast path (mode 0): fg + bg * (1 - fg.a)
    if mode == 0:
        let inv_a = 1.0 - fg.a
        return theme::KtColor {
            r: fg.r + bg.r * inv_a,
            g: fg.g + bg.g * inv_a,
            b: fg.b + bg.b * inv_a,
            a: fg.a + bg.a * inv_a,
        }
    // CSS blend modes (12-22): blend channels, then over-composite
    if mode >= 12 and mode <= 22:
        let mixed_r = blend_channel(bg.r, fg.r, mode)
        let mixed_g = blend_channel(bg.g, fg.g, mode)
        let mixed_b = blend_channel(bg.b, fg.b, mode)
        let inv_a = 1.0 - fg.a
        return theme::KtColor {
            r: mixed_r * fg.a + bg.r * inv_a,
            g: mixed_g * fg.a + bg.g * inv_a,
            b: mixed_b * fg.a + bg.b * inv_a,
            a: fg.a + bg.a * inv_a,
        }
    // Porter-Duff modes 1-9: coefficient-based compositing
    var fa: Float = 1.0
    var fb: Float = 1.0
    if mode == 1:
        fa = 1.0
        fb = 0.0              // SRC
    elif mode == 2:
        fa = 0.0
        fb = 1.0              // DST
    elif mode == 3:
        fa = bg.a
        fb = 0.0              // SRC_IN
    elif mode == 4:
        fa = 0.0
        fb = fg.a             // DST_IN
    elif mode == 5:
        fa = 1.0 - bg.a
        fb = 0.0              // SRC_OUT
    elif mode == 6:
        fa = 0.0
        fb = 1.0 - fg.a       // DST_OUT
    elif mode == 7:
        fa = bg.a
        fb = 1.0 - fg.a       // SRC_ATOP
    elif mode == 8:
        fa = 1.0 - bg.a
        fb = fg.a             // DST_ATOP
    elif mode == 9:
        fa = 1.0 - bg.a
        fb = 1.0 - fg.a       // XOR
    // modes 10-11 (PLUS, PLUS_LIGHTER): fa=1, fb=1
    return theme::KtColor {
        r: fa * fg.r + fb * bg.r,
        g: fa * fg.g + fb * bg.g,
        b: fa * fg.b + fb * bg.b,
        a: fa * fg.a + fb * bg.a,
    }

// ═══════════════════════════════════════════════════════════════════════════
//  Color Space Conversion — sRGB ↔ Linear
//  Pure Float math — piecewise formulas matching kaintana.h §17C.
//  For UI rendering, polynomial approximations are visually equivalent.
// ═══════════════════════════════════════════════════════════════════════════

/// Convert sRGB float [0..1] to linear float.
/// Uses standard piecewise: c <= 0.04045 → c/12.92, else → ((c+0.055)/1.055)^2.4
pub fn srgb_to_linear(c: Float) -> Float:
    if c <= 0.04045:
        return c / 12.92
    let a = (c + 0.055) / 1.055
    // Compute a^2.4 ≈ a^2 * a^0.4
    // a^0.4 approximated as a smooth blend for [0,1] range
    let a2 = a * a
    let a04 = -0.221 * a2 + 0.943 * a + 0.262
    return a2 * a04

/// Convert linear float [0..1] to sRGB float.
/// Uses standard piecewise: c <= 0.0031308 → c*12.92, else → 1.055*c^(1/2.4)-0.055
pub fn linear_to_srgb(c: Float) -> Float:
    if c <= 0.0031308:
        return c * 12.92
    // Compute c^0.4167 ≈ c^(1/2.4) using polynomial on [0,1]
    let ci = -0.083 * c * c + 0.565 * c + 0.515
    return 1.055 * ci - 0.055

// ═══════════════════════════════════════════════════════════════════════════
//  Luminance & Saturation
//  Rec. 601 luminance: 0.299*R + 0.587*G + 0.114*B
//  Saturation: max(R,G,B) - min(R,G,B)
// ═══════════════════════════════════════════════════════════════════════════

/// Compute Rec. 601 luminance of a KtColor.
pub fn luminance(c: theme::KtColor) -> Float:
    return 0.299 * c.r + 0.587 * c.g + 0.114 * c.b

/// Compute saturation (chroma magnitude) of a KtColor.
pub fn saturation(c: theme::KtColor) -> Float:
    var mx: Float = 0.0
    if c.r > c.g:
        if c.r > c.b:
            mx = c.r
        else:
            mx = c.b
    else:
        if c.g > c.b:
            mx = c.g
        else:
            mx = c.b
    var mn: Float = 0.0
    if c.r < c.g:
        if c.r < c.b:
            mn = c.r
        else:
            mn = c.b
    else:
        if c.g < c.b:
            mn = c.g
        else:
            mn = c.b
    return mx - mn

// ═══════════════════════════════════════════════════════════════════════════
//  Gradient Sampling — pure Kain between KtColor stops
// ═══════════════════════════════════════════════════════════════════════════

/// Sample a color gradient at position t [0..1].
/// stops: array of KtColor values.
/// positions: array of Float stop positions [0..1] (same length as stops).
/// Returns the interpolated KtColor, lerping between the two surrounding stops.
pub fn gradient_sample(stops: [theme::KtColor], positions: [Float], t: Float) -> theme::KtColor:
    let n = array_len(stops)
    if n == 0:
        return theme::KtColor { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
    if n == 1:
        return stops[0]
    // Clamp t to [0, 1]
    let xt: Float = if t < 0.0: 0.0 elif t > 1.0: 1.0 else: t
    // Find the two surrounding stops
    var lo_idx: Int = 0
    var hi_idx: Int = n - 1
    var found: Bool = false
    var i: Int = 0
    while i < n - 1:
        if xt >= positions[i] and xt <= positions[i + 1]:
            lo_idx = i
            hi_idx = i + 1
            found = true
            break
        i = i + 1
    if found == false:
        if xt < positions[0]:
            return stops[0]
        return stops[n - 1]
    // Linear interpolation between stops
    let p_lo = positions[lo_idx]
    let p_hi = positions[hi_idx]
    let seg_t: Float = if p_hi > p_lo:
        (xt - p_lo) / (p_hi - p_lo)
    else:
        0.0
    let lo = stops[lo_idx]
    let hi = stops[hi_idx]
    return lo.lerp(hi, seg_t)

/// Helper: count elements in an array.
fn array_len<T>(arr: [T]) -> Int:
    var count: Int = 0
    for _elem in arr:
        count = count + 1
    return count

// ============================================================================
// kaintana/core.kn
// ============================================================================
// ============================================================================
//  core.kn — Kaintana Vtable Bridge Layer
//  Single point of ABI contact between Kain and the C substrate.
//  One @extern per C function. Safe wrappers for ergonomics.
//
//  This file has ZERO dependencies — no stdlib imports, no theme.kn.
//  KtSession is Int, NOT a newtype. All @extern signatures match kaintana.h.
//
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
//  Layout: Every section matches the C API in kaintana.h exactly.
// ============================================================================

// ── Version constants ─────────────────────────────────────────────────────

pub const KT_API_VERSION: Int = 1

// ── Type aliases matching C types (kaintana.h §2) ─────────────────────────
//  KtSession = opaque pointer stored as Int (NOT a newtype — simple alias)
//  KtElementId = element handle returned by kt_row
//  KtResult = C convention: 0 = failure, 1 = success

pub type KtSession   = Int
pub type KtElementId = Int
pub type KtResult    = Int

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 8: SESSION LIFECYCLE (3 functions)
// ═══════════════════════════════════════════════════════════════════════════

/// Initialize Kaintana system. Call once at startup before kt_make.
@extern fn kt_init() -> Void

/// Create a UI session. Returns opaque session handle or -1 (NULL) on failure.
@extern fn kt_make(name: String, w: Int, h: Int) -> KtSession

/// Destroy a UI session. Call at program exit. Null-safe.
@extern fn kt_free(s: KtSession) -> Void

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 9: FRAME LOOP (4 functions)
// ═══════════════════════════════════════════════════════════════════════════

/// Start a new frame. delta_ms = time since last frame in milliseconds.
@extern fn kt_begin(s: KtSession, delta_ms: Float) -> Void

/// Conclude command recording for this frame.
@extern fn kt_end(s: KtSession) -> Void

/// Present the framebuffer to the screen via the active render backend.
@extern fn kt_present(s: KtSession) -> Void

/// Returns 1 if close requested (window X button), 0 otherwise.
@extern fn kt_should_close(s: KtSession) -> Int

/// Pump the OS message queue (Win32 PeekMessageA / X11 XPending).
/// Call once per frame before kt_begin. Returns 1 if messages processed.
@extern fn kt_host_pump(s: KtSession) -> Int

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 10: INPUT FUNNEL (7 functions)
//  Feed input BEFORE kt_begin(). Backend calls these from OS event loop.
// ═══════════════════════════════════════════════════════════════════════════

/// Feed mouse move event (screen-space logical coordinates).
@extern fn kt_input_mouse_move(s: KtSession, x: Float, y: Float) -> Void

/// Feed mouse button press (0=left, 1=right, 2=middle).
@extern fn kt_input_mouse_down(s: KtSession, button: Int) -> Void

/// Feed mouse button release.
@extern fn kt_input_mouse_up(s: KtSession, button: Int) -> Void

/// Feed scroll wheel delta.
@extern fn kt_input_scroll(s: KtSession, dx: Float, dy: Float) -> Void

/// Feed key press (platform scancode).
@extern fn kt_input_key_down(s: KtSession, key: Int) -> Void

/// Feed key release.
@extern fn kt_input_key_up(s: KtSession, key: Int) -> Void

/// Feed UTF-8 text input (from IME/keyboard composition).
@extern fn kt_input_text(s: KtSession, text: String) -> Void

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 11: ELEMENT TREE (3 functions)
//  Call between kt_begin() and kt_end(). Elements form a parent-ordered
//  hierarchy via kt_row/kt_end_row pairs.
// ═══════════════════════════════════════════════════════════════════════════

/// Begin a new element. kind = "box", "text", "stack", "button", etc.
/// key = stable key like "login_button" ("" for auto-generated).
/// Returns element ID for setting attributes and querying interaction.
@extern fn kt_row(s: KtSession, parent: KtElementId, kind: String, key: String) -> KtElementId

/// Close the most recently opened element (pops back to parent).
@extern fn kt_end_row(s: KtSession) -> Void

/// Set text content on an element. Used for label text, button labels, etc.
@extern fn kt_text(s: KtSession, elem: KtElementId, text: String) -> Void

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 11b: INTERACTION QUERY (3 functions)
//  Frame-query pattern: check hovered/clicked/active every frame.
//  This is the PRIMARY interaction model — NOT callback registration.
// ═══════════════════════════════════════════════════════════════════════════

/// Returns 1 if the pointer is over this element this frame.
@extern fn kt_hovered(s: KtSession, elem: KtElementId) -> Int

/// Returns 1 if this element was clicked this frame (press then release on same element).
@extern fn kt_clicked(s: KtSession, elem: KtElementId) -> Int

/// Returns 1 if this element currently has pointer capture (dragging, pressed, etc.).
@extern fn kt_active(s: KtSession, elem: KtElementId) -> Int

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 12: LAYOUT ATTRIBUTES (6 functions)
//  Set layout properties on elements after kt_row, before kt_end_row.
//  C-side box_math.c implements the two-pass flexbox solver.
// ═══════════════════════════════════════════════════════════════════════════

/// Set element width in logical points (0 = auto-sized).
@extern fn kt_width(s: KtSession, elem: KtElementId, w: Float) -> Void

/// Set element height in logical points (0 = auto-sized).
@extern fn kt_height(s: KtSession, elem: KtElementId, h: Float) -> Void

/// Set uniform padding on all four sides.
@extern fn kt_pad(s: KtSession, elem: KtElementId, all: Float) -> Void

/// Set horizontal and vertical padding independently.
@extern fn kt_pad_xy(s: KtSession, elem: KtElementId, x: Float, y: Float) -> Void

/// Set gap between children in a flex container.
@extern fn kt_gap(s: KtSession, elem: KtElementId, gap: Float) -> Void

/// Set layout direction. 0=row, 1=col, 2=row-reverse, 3=col-reverse.
@extern fn kt_direction(s: KtSession, elem: KtElementId, dir: Int) -> Void

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 13: STYLE ATTRIBUTES (5 functions)
//  Colors passed as hex strings ("#21D4A1") or named theme colors.
//  The C substrate is a dumb pipe — it parses hex but does not interpret
//  semantic color names. Color naming lives in Kain code (theme.kn).
// ═══════════════════════════════════════════════════════════════════════════

/// Set fill color as hex string ("#RRGGBB" or "#RRGGBBAA") or named color.
@extern fn kt_fill(s: KtSession, elem: KtElementId, color: String) -> Void

/// Set stroke (outline) color and width.
@extern fn kt_stroke(s: KtSession, elem: KtElementId, color: String, w: Float) -> Void

/// Set corner radius in logical points for rounded rectangles.
@extern fn kt_radius(s: KtSession, elem: KtElementId, r: Float) -> Void

/// Set opacity multiplier (0.0 = fully transparent, 1.0 = fully opaque).
@extern fn kt_opacity(s: KtSession, elem: KtElementId, a: Float) -> Void

/// Set font size in logical points for text elements.
@extern fn kt_font(s: KtSession, elem: KtElementId, size: Float) -> Void

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 14: STATE PERSISTENCE (6 functions)
//  Values survive across frames. Scoped to session. String-keyed.
//  Used by component state persistence and hooks (useState, useRef).
// ═══════════════════════════════════════════════════════════════════════════

/// Store int64 state by string key.
@extern fn kt_put(s: KtSession, key: String, v: Int) -> Void

/// Store double (Float) state by string key.
@extern fn kt_put_f(s: KtSession, key: String, v: Float) -> Void

/// Store string state by string key.
@extern fn kt_put_s(s: KtSession, key: String, v: String) -> Void

/// Read int64 state, return fallback if key not found.
@extern fn kt_get(s: KtSession, key: String, fallback: Int) -> Int

/// Read double (Float) state, return fallback if key not found.
@extern fn kt_get_f(s: KtSession, key: String, fallback: Float) -> Float

/// Read string state, return fallback if key not found.
@extern fn kt_get_s(s: KtSession, key: String, fallback: String) -> String

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 15: DRAW OUTPUT (2 functions)
//  Read after kt_end() to inspect the frame's render commands.
//  Primarily used by the GPU test runner and CI golden-file comparisons.
// ═══════════════════════════════════════════════════════════════════════════

/// Number of draw commands emitted this frame.
@extern fn kt_cmd_count(s: KtSession) -> Int

/// Get draw command by index. Returns Int (kt_Cmd* pointer)—cast to access fields.
@extern fn kt_cmd_get(s: KtSession, index: Int) -> Int

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 16: BACKEND REGISTRY (3 functions)
//  Backends implement the 4-function KaintanaBackendVTable.
//  Register at startup, select before first frame.
// ═══════════════════════════════════════════════════════════════════════════

/// Register a render backend. Returns 1 on success, 0 on failure (max 8 backends).
@extern fn kt_backend_register(s: KtSession, name: String, vtable: Int) -> Int

/// Activate a registered backend by name. Returns 1 on success, 0 on failure.
@extern fn kt_backend_select(s: KtSession, name: String) -> Int

/// Auto-select backend: RENDERER_BACKEND env var or first registered. Returns 1 on success.
@extern fn kt_backend_probe(s: KtSession) -> Int

// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 20: DPI API (6 functions)
//  Backends report OS DPI via kt_set_native_scale(). Kain code sets user zoom.
//  Effective scale = native_scale × user_zoom. All coordinates in logical pts.
// ═══════════════════════════════════════════════════════════════════════════

/// Effective horizontal scale (native_scale_x × user_zoom). Backends use for rendering.
@extern fn kt_scale_factor_x(s: KtSession) -> Float

/// Effective vertical scale.
@extern fn kt_scale_factor_y(s: KtSession) -> Float

/// OS-reported DPI scale only — no user zoom. For font rasterization density.
@extern fn kt_native_scale_x(s: KtSession) -> Float

/// OS-reported vertical DPI scale only (no user zoom).
@extern fn kt_native_scale_y(s: KtSession) -> Float

/// Called by backends at init and on DPI change (e.g. WM_DPICHANGED). Clamped [0.1, 10.0].
@extern fn kt_set_native_scale(s: KtSession, sx: Float, sy: Float) -> Void

/// Set user zoom factor. Clamped to [0.2, 5.0]. Deferred to next frame (egui pattern).
@extern fn kt_set_zoom(s: KtSession, zoom: Float) -> Void

// ═══════════════════════════════════════════════════════════════════════════
//  VTABLE SLOT 18: GPU EXTENSION (1 function)
// ═══════════════════════════════════════════════════════════════════════════

/// Discover the GPU surface extension pointer. Returns -1 if no GPU backend.
/// The extension provides load_shader/set_uniform for custom GPU shader effects.
@extern fn kt_get_gpu_extension(s: KtSession) -> Int

// ═══════════════════════════════════════════════════════════════════════════
//  SAFE WRAPPERS + CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

/// Convert C's 0/1 Int convention to a Kain Bool.
pub fn kt_should_close_bool(s: KtSession) -> Bool:
    let result = kt_should_close(s)
    return result != 0

// ── Layout direction constants (match KaintanaLayoutDir C enum) ──────────

pub const KT_DIR_ROW:            Int = 0
pub const KT_DIR_COLUMN:         Int = 1
pub const KT_DIR_ROW_REVERSE:    Int = 2
pub const KT_DIR_COLUMN_REVERSE: Int = 3

/// Convenience: set element direction to row (horizontal layout).
pub fn kt_set_direction_row(s: KtSession, elem: KtElementId):
    kt_direction(s, elem, KT_DIR_ROW)

/// Convenience: set element direction to column (vertical layout).
pub fn kt_set_direction_column(s: KtSession, elem: KtElementId):
    kt_direction(s, elem, KT_DIR_COLUMN)

// ═══════════════════════════════════════════════════════════════════════════
//  KtElement FLUENT BUILDER
//  NOT a component. A stateful builder for constructing raw elements when
//  JSX syntax is not available or desired.
//  Does NOT call kt_begin/kt_end/kt_present — those are session-level
//  lifecycle calls that surround element construction.
//
//  Usage:
//    let el = KtElement.open(s, parent, "box", "my-key")
//               .fill("#21D4A1")
//               .width(120.0)
//               .height(32.0)
//               .radius(4.0)
//    el.end()
// ═══════════════════════════════════════════════════════════════════════════

pub struct KtElement:
    s:      KtSession
    parent: KtElementId
    id:     KtElementId

pub impl KtElement:
    /// Open a new KtElement by calling kt_row. Must close with end().
    pub fn open(s: KtSession, parent: KtElementId, kind: String, key: String) -> KtElement:
        let id = kt_row(s, parent, kind, key)
        return KtElement { s: s, parent: parent, id: id }

    // ── Style setters ────────────────────────────────────────────────

    /// Set fill color. Returns Self for chaining.
    pub fn fill(_self: Self_, color: String) -> KtElement:
        kt_fill(_self.s, _self.id, color)
        return _self

    /// Set stroke color and width. Returns Self for chaining.
    pub fn stroke(_self: Self_, color: String, w: Float) -> KtElement:
        kt_stroke(_self.s, _self.id, color, w)
        return _self

    /// Set corner radius. Returns Self for chaining.
    pub fn radius(_self: Self_, r: Float) -> KtElement:
        kt_radius(_self.s, _self.id, r)
        return _self

    /// Set opacity. Returns Self for chaining.
    pub fn opacity(_self: Self_, a: Float) -> KtElement:
        kt_opacity(_self.s, _self.id, a)
        return _self

    /// Set font size. Returns Self for chaining.
    pub fn font(_self: Self_, size: Float) -> KtElement:
        kt_font(_self.s, _self.id, size)
        return _self

    // ── Layout setters ───────────────────────────────────────────────

    /// Set element width. Returns Self for chaining.
    pub fn width(_self: Self_, w: Float) -> KtElement:
        kt_width(_self.s, _self.id, w)
        return _self

    /// Set element height. Returns Self for chaining.
    pub fn height(_self: Self_, h: Float) -> KtElement:
        kt_height(_self.s, _self.id, h)
        return _self

    /// Set uniform padding on all sides. Returns Self for chaining.
    pub fn pad(_self: Self_, all: Float) -> KtElement:
        kt_pad(_self.s, _self.id, all)
        return _self

    /// Set horizontal and vertical padding independently. Returns Self for chaining.
    pub fn pad_xy(_self: Self_, x: Float, y: Float) -> KtElement:
        kt_pad_xy(_self.s, _self.id, x, y)
        return _self

    /// Set gap between children in a flex container. Returns Self for chaining.
    pub fn gap(_self: Self_, g: Float) -> KtElement:
        kt_gap(_self.s, _self.id, g)
        return _self

    /// Set layout direction. Returns Self for chaining.
    pub fn direction(_self: Self_, dir: Int) -> KtElement:
        kt_direction(_self.s, _self.id, dir)
        return _self

    // ── Text ─────────────────────────────────────────────────────────

    /// Set text content on this element. Returns Self for chaining.
    pub fn text(_self: Self_, value: String) -> KtElement:
        kt_text(_self.s, _self.id, value)
        return _self

    // ── Interaction queries (read-only) ───────────────────────────────

    /// Returns true if the pointer is over this element this frame.
    pub fn hovered(_self: Self_) -> Bool:
        return kt_hovered(_self.s, _self.id) != 0

    /// Returns true if this element was clicked this frame.
    pub fn clicked(_self: Self_) -> Bool:
        return kt_clicked(_self.s, _self.id) != 0

    /// Returns true if this element currently has pointer capture.
    pub fn active(_self: Self_) -> Bool:
        return kt_active(_self.s, _self.id) != 0

    // ── Close ────────────────────────────────────────────────────────

    /// Close this element by calling kt_end_row.
    pub fn end(_self: Self_):
        kt_end_row(_self.s)

// ============================================================================
// kaintana/dpi.kn
// ============================================================================
// ============================================================================
//  dpi.kn — DPI helpers and pixel snapping
//  P2-020: DPI helpers wrapping kt_scale_factor_x/y, kt_native_scale_x/y.
//          Pixel snap wrappers. DpiContext struct.
//
//  Design rules:
//    - All session values are logical points — DPI conversion is explicit.
//    - DpiContext bundles session + computed scale factors.
//    - Pixel snapping uses round(logical * scale) / scale for sub-pixel prevention.
//    - 1/64 logical point rounding for layout stability.
//
//  Declares its own @extern bindings for the DPI C API.
// ============================================================================

use std::kaintana::KtSession

use std::kaintana::core::kt_scale_factor_x
use std::kaintana::core::kt_scale_factor_y
use std::kaintana::core::kt_native_scale_x
use std::kaintana::core::kt_native_scale_y
use std::kaintana::core::kt_set_native_scale
use std::kaintana::core::kt_set_zoom
use std::kaintana::KtSession

// ═══════════════════════════════════════════════════════════════════════════
//  Constants
// ═══════════════════════════════════════════════════════════════════════════

/// Baseline DPI for 100% scaling (96 DPI).
pub const KT_DPI_BASELINE: Float = 96.0

/// Default scale factor when OS DPI not yet queried (96 DPI = 100%).
pub const KT_DEFAULT_SCALE: Float = 1.0

/// 1/64 logical point — numerical stability factor for layout.
pub const KT_ROUND_UI_FACTOR: Float = 64.0

/// Minimum user zoom (egui pattern).
pub const KT_ZOOM_MIN: Float = 0.2

/// Maximum user zoom.
pub const KT_ZOOM_MAX: Float = 5.0

/// Keyboard zoom granularity.
pub const KT_ZOOM_STEP: Float = 0.1

// ═══════════════════════════════════════════════════════════════════════════
//  DpiContext — per-session DPI state
// ═══════════════════════════════════════════════════════════════════════════

/// Per-session DPI context carrying effective scale factors.
pub struct DpiContext:
    scale_x: Float
    scale_y: Float
    zoom:    Float
    session: KtSession

/// Create a DpiContext by querying the session's current scale factors.
pub fn dpi_context(s: KtSession) -> DpiContext:
    return DpiContext {
        scale_x: kt_scale_factor_x(s),
        scale_y: kt_scale_factor_y(s),
        zoom:    1.0,
        session: s,
    }

/// Create a DpiContext with explicit scale and zoom values.
pub fn dpi_context_explicit(
    sx: Float, sy: Float, zoom: Float, s: KtSession,
) -> DpiContext:
    return DpiContext {
        scale_x: sx,
        scale_y: sy,
        zoom:    zoom,
        session: s,
    }

/// Refresh DpiContext from current session state.
pub fn dpi_context_refresh(ctx: DpiContext) -> DpiContext:
    return DpiContext {
        scale_x: kt_scale_factor_x(ctx.session),
        scale_y: kt_scale_factor_y(ctx.session),
        zoom:    ctx.zoom,
        session: ctx.session,
    }

// ═══════════════════════════════════════════════════════════════════════════
//  Pixel Snap (pure Float math)
// ═══════════════════════════════════════════════════════════════════════════

/// Snap a logical X to nearest physical pixel boundary.
pub fn round_to_pixel_x(logical: Float, scale: Float) -> Float:
    let snapped = logical * scale + 0.5
    let floored = snapped - (snapped % 1.0)
    return floored / scale

/// Snap a logical Y to nearest physical pixel boundary.
pub fn round_to_pixel_y(logical: Float, scale: Float) -> Float:
    let snapped = logical * scale + 0.5
    let floored = snapped - (snapped % 1.0)
    return floored / scale

/// Snap to pixel center for 1px-wide lines.
pub fn round_to_pixel_center_x(logical: Float, scale: Float) -> Float:
    let multiplied = logical * scale
    let floored = multiplied - (multiplied % 1.0)
    return (floored + 0.5) / scale

/// Express 1 physical pixel in logical coords.
pub fn one_physical_pixel(scale: Float) -> Float:
    return 1.0 / scale

/// Round to 1/64 logical point for layout stability.
pub fn round_ui(x: Float) -> Float:
    let snapped = x * KT_ROUND_UI_FACTOR + 0.5
    let floored = snapped - (snapped % 1.0)
    return floored / KT_ROUND_UI_FACTOR

// ═══════════════════════════════════════════════════════════════════════════
//  Convenience
// ═══════════════════════════════════════════════════════════════════════════

/// Convert logical points to physical pixels via DpiContext.
pub fn dp_to_px_x(ctx: DpiContext, logical: Float) -> Float:
    return round_to_pixel_x(logical, ctx.scale_x)

/// Convert logical points to physical pixels via DpiContext.
pub fn dp_to_px_y(ctx: DpiContext, logical: Float) -> Float:
    return round_to_pixel_y(logical, ctx.scale_y)

/// Convert to physical pixels snapped to pixel center.
pub fn dp_to_px_center_x(ctx: DpiContext, logical: Float) -> Float:
    return round_to_pixel_center_x(logical, ctx.scale_x)

/// Compute DPI scaling factor from OS-reported DPI value.
pub fn dpi_scale_from_dpi(dpi: Float) -> Float:
    return dpi / KT_DPI_BASELINE

// ============================================================================
// kaintana/examples/animated_button.kn
// ============================================================================
// ============================================================================
//  animated_button.kn — Animated Button with Hover Effect
//  Example from MASTER_STDLIB.md §15.2
//
//  Demonstrates:
//    - component AnimatedButton with pulse-driven spring animation
//    - Hover: scale up (1.0 -> 1.05), color transition via SpringState
//    - Import from core.kn, theme.kn, layout.kn, animation.kn, widgets/Button.kn
//    - Session lifecycle: kt_init -> kt_make -> kt_backend_probe -> frame loop
//    - JSX attributes on single lines
//
//  Verify: kain check animated_button.kn --json
//  Run with: RENDERER_BACKEND=win32 kain run animated_button.kn --target llvm
// ============================================================================

// ═══════════════════════════════════════════════════════════════════════════
//  IMPORTS — from std::kaintana modules
// ═══════════════════════════════════════════════════════════════════════════

use std::kaintana::core
use std::kaintana::theme
use std::kaintana::layout
use std::kaintana::animation
use std::kaintana::widgets::Button

// ═══════════════════════════════════════════════════════════════════════════
//  @extern BINDINGS — Session lifecycle + element tree
// ═══════════════════════════════════════════════════════════════════════════

@extern fn kt_init() -> Void
@extern fn kt_make(name: String, w: Int, h: Int) -> Int
@extern fn kt_free(s: Int) -> Void
@extern fn kt_begin(s: Int, delta_ms: Float) -> Void
@extern fn kt_end(s: Int) -> Void
@extern fn kt_present(s: Int) -> Void
@extern fn kt_should_close(s: Int) -> Int
@extern fn kt_backend_probe(s: Int) -> Int

@extern fn kt_row(s: Int, parent: Int, kind: String, key: String) -> Int
@extern fn kt_end_row(s: Int) -> Void
@extern fn kt_text(s: Int, elem: Int, text: String) -> Void

@extern fn kt_fill(s: Int, elem: Int, color: String) -> Void
@extern fn kt_width(s: Int, elem: Int, w: Float) -> Void
@extern fn kt_height(s: Int, elem: Int, h: Float) -> Void
@extern fn kt_radius(s: Int, elem: Int, r: Float) -> Void
@extern fn kt_opacity(s: Int, elem: Int, a: Float) -> Void
@extern fn kt_pad(s: Int, elem: Int, all: Float) -> Void
@extern fn kt_gap(s: Int, elem: Int, gap: Float) -> Void
@extern fn kt_direction(s: Int, elem: Int, dir: Int) -> Void

@extern fn kt_hovered(s: Int, elem: Int) -> Int
@extern fn kt_clicked(s: Int, elem: Int) -> Int
@extern fn kt_active(s: Int, elem: Int) -> Int

@extern fn kt_put(s: Int, key: String, v: Int) -> Void
@extern fn kt_get(s: Int, key: String, fallback: Int) -> Int
@extern fn kt_put_f(s: Int, key: String, v: Float) -> Void
@extern fn kt_get_f(s: Int, key: String, fallback: Float) -> Float

// ═══════════════════════════════════════════════════════════════════════════
//  CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

const APP_TITLE: String = "Kaintana Animated Button"
const APP_WIDTH: Int = 400
const APP_HEIGHT: Int = 300
const HOVER_SCALE: Float = 1.06
const REST_SCALE: Float = 1.0
const BTN_WIDTH: Float = 160.0
const BTN_HEIGHT: Float = 48.0
const CORNER_RADIUS: Float = 8.0
const PULSE_INTERVAL_MS: Float = 16.0
const PULSE_JITTER_MS: Float = 2.0
const ANIM_SPEED: Float = 1.0
const SPRING_STIFFNESS: Float = 0.25
const SPRING_DAMPING: Float = 0.65
const BG_COLOR: String = "#1A1A24"
const BTN_DEFAULT_COLOR: String = "#2A2A40"
const BTN_HOVER_COLOR_HEX: String = "#3A3A58"
const BTN_ACCENT_COLOR: String = "#21D4A1"
const TEXT_COLOR: String = "#F1F1F6"
const CLICK_COLOR: String = "#4A4A66"

// ═══════════════════════════════════════════════════════════════════════════
//  HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

/// Resolve button fill color from state (transition based on spring value).
/// spring.value ranges from 0.0 (rest) to 1.0 (full hover) proportionally.
fn button_fill(hover_spring: Float, pressed: Bool) -> String:
    if pressed:
        return CLICK_COLOR
    // Lerp spring value [0,1] maps onto color transition intensity
    let t = hover_spring
    if t < 0.01:
        return BTN_DEFAULT_COLOR
    if t > 0.99:
        return BTN_HOVER_COLOR_HEX
    // When spring is partial, use an interpolated blend
    return BTN_DEFAULT_COLOR

/// Resolve button scale from spring value [REST_SCALE, HOVER_SCALE].
fn button_scale(hover_spring: Float) -> Float:
    return REST_SCALE + (HOVER_SCALE - REST_SCALE) * hover_spring

/// Resolve element width from base width and current scale.
fn scaled_width(base: Float, s: Float) -> Float:
    return base * s

/// Resolve element height from base height and current scale.
fn scaled_height(base: Float, s: Float) -> Float:
    return base * s

// ═══════════════════════════════════════════════════════════════════════════
//  COMPONENT: AnimatedButton
//  Pulse-driven spring animation on hover. Scales up smoothly and
//  transitions button color when the pointer enters.
// ═══════════════════════════════════════════════════════════════════════════

/// Interactive animated button with spring-driven hover effect.
/// Scales up on hover with smooth color transition via SpringState.
component AnimatedButton(
    label: String,
    on_click = none,
    width: Float = BTN_WIDTH,
    height: Float = BTN_HEIGHT,
    key: String = "anim-btn",
):
    state _elem_id: Int = -1
    state _hovered: Bool = false
    state _pressed: Bool = false
    state _spring_val: Float = 0.0
    state _spring_vel: Float = 0.0
    state _target_spring: Float = 0.0

    /// Process interaction: query hover/click/active from C substrate.
    fn process_hover(_self: Self_):
        if _self._elem_id < 0:
            return
        let hov = kt_hovered(0, _self._elem_id)
        let clk = kt_clicked(0, _self._elem_id)
        let act = kt_active(0, _self._elem_id)
        _self._hovered = hov != 0
        _self._pressed = act != 0
        // Set spring target: 1.0 when hovering or pressed, 0.0 at rest
        if _self._hovered or _self._pressed:
            _self._target_spring = 1.0
        else:
            _self._target_spring = 0.0
        if clk != 0:
            if _self.on_click != none:
                _self.on_click()

    /// Pulse-driven spring physics: advances the hover spring each tick.
    /// The spring transitions smoothly between rest (0.0) and hover (1.0).
    pulse animate_spring every 16ms jitter 2ms:
        let dt = pulse_dt_ms * ANIM_SPEED
        let delta = _spring_val - _target_spring
        let force = -SPRING_STIFFNESS * delta
        let damp = -SPRING_DAMPING * _spring_vel
        let accel = force + damp
        _spring_vel = _spring_vel + accel * dt
        _spring_val = _spring_val + _spring_vel * dt

    /// Render: box with animated scale and color
    render <box kind="animated-button" key={key} width={scaled_width(width, button_scale(_spring_val))} height={scaled_height(height, button_scale(_spring_val))} radius={CORNER_RADIUS} fill={button_fill(_spring_val, _pressed)}>
        <text value={label} />
    </box>

// ═══════════════════════════════════════════════════════════════════════════
//  DEMO COMPONENT: DemoScene
//  Arranges AnimatedButton instances in a vertical stack with a title.
// ═══════════════════════════════════════════════════════════════════════════

const TITLE_SIZE: Float = 20.0
const SMALL_SIZE: Float = 12.0

component DemoScene():
    state click_count: Int = 0

    fn on_clicked(_self: Self_):
        _self.click_count = _self.click_count + 1

    render <box kind="column" key="demo-root" fill={BG_COLOR} width={APP_WIDTH as Float} height={APP_HEIGHT as Float} pad={20} gap={16} direction={1}>
            <text value={"Animated Button Demo"} />
            <text value={"Click count: " + str(click_count)} />
            <box kind="row" key="btn-row" gap={12} direction={0}>
                <AnimatedButton label="Click Me" on_click={on_clicked} width={BTN_WIDTH} height={BTN_HEIGHT} key="btn-click" />
                <AnimatedButton label="Reset" on_click={on_clicked} width={BTN_WIDTH} height={BTN_HEIGHT} key="btn-reset" />
            </box>
            <text value={"Spring: " + str(0.0)} />
        </box>

// ═══════════════════════════════════════════════════════════════════════════
//  WORLD — ties DemoScene to the kaintana surface
// ═══════════════════════════════════════════════════════════════════════════

world AnimatedButtonWorld:
    surface kaintana => DemoScene

// ═══════════════════════════════════════════════════════════════════════════
//  MAIN — Session lifecycle and program entry
// ═══════════════════════════════════════════════════════════════════════════

fn main() -> Int:
    kt_init()
    let sid = kt_make(APP_TITLE, APP_WIDTH, APP_HEIGHT)
    if sid < 0:
        return 1
    let probe_ok = kt_backend_probe(sid)
    if probe_ok == 0:
        return 2
    var running = kt_should_close(sid)
    while running == 0:
        kt_begin(sid, PULSE_INTERVAL_MS)
        kt_end(sid)
        kt_present(sid)
        running = kt_should_close(sid)
    kt_free(sid)
    return 0

// ============================================================================
//  END — animated_button.kn
// ============================================================================

// ============================================================================
// kaintana/examples/build.kn
// ============================================================================
use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let pkg = package("spring_playground")
        .version("0.1.0")
        .description("Spring Animation Playground — Kaintana UI demo")

    let blade_spec = blade("spring_playground")
        .kind("kain_library")
        .entry("spring_playground.kn")
        .source_root(".")
        .module_root(".")
        .build_target("llvm")

    let defaults = build_defaults()
        .entry("spring_playground.kn")
        .artifact_root(".kain/out")
        .cache_root(".kain/cache/build")
        .profile("debug")
        .target("llvm")

    let check = build_check("check-llvm")
        .entry("spring_playground.kn")
        .target("llvm")
        .axis("target", "llvm")
        .input("spring_playground.kn")
        .input("build.kn")

    let exe = native_executable("spring-playground-exe")
        .entry("spring_playground.kn")
        .root_output("$blade/spring_playground.exe")
        .requires("check-llvm")
        .input("spring_playground.kn")
        .input("build.kn")

    return build_graph()
        .package(pkg)
        .blade(blade_spec)
        .defaults(defaults)
        .task(check)
        .task(exe)

// ============================================================================
// kaintana/examples/counter.kn
// ============================================================================
// ============================================================================
//  examples/counter.kn — Complete Kaintana Counter Application
//  From MASTER_STDLIB.md §15.1: CounterApp with increment/decrement/reset.
//
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
//
//  Architecture:
//    - CounterWorld: compiler-owned state authority with count + theme
//    - CounterApp: component with mutable _count, _theme, _frame_count
//    - main(): session lifecycle, win32 backend, frame loop
//    - Frame-query pattern: on_click callbacks triggered by kt_clicked
//
//  Dependencies:
//    - theme.kn: KtTheme, DEFAULT_THEME
//    - layout.kn: VStack, HStack
//    - widgets/Button.kn: Button component
//    - widgets/Label.kn: Label component
// ============================================================================

// ── Session lifecycle functions (from std::kaintana::core) ─────────────
use std::kaintana::core::kt_init
use std::kaintana::core::kt_make
use std::kaintana::core::kt_free
use std::kaintana::core::kt_begin
use std::kaintana::core::kt_end
use std::kaintana::core::kt_present
use std::kaintana::core::kt_should_close
use std::kaintana::core::kt_backend_register
use std::kaintana::core::kt_backend_select

// ── Theme imports (from std::kaintana) ────────────────────────────────────

use std::kaintana::theme as theme_mod
use std::kaintana::theme::DEFAULT_THEME
use std::kaintana::theme::KtTheme

// ── Layout imports ────────────────────────────────────────────────────────

use std::kaintana::layout::VStack
use std::kaintana::layout::HStack

// ── Widget imports (Button + Label) ───────────────────────────────────────

use std::kaintana::Button
use std::kaintana::Label

// ============================================================================
//  World: CounterWorld
//  Compiler-owned state authority holding count + theme.
//  Surface bound to CounterApp component for rendering.
// ============================================================================

/// Counter application state. The world holds the authoritative count and
/// theme. Surface projects to CounterApp for rendering.
world CounterWorld:
    state count: Int = 0
    state theme: KtTheme = DEFAULT_THEME
    surface kaintana => CounterApp

// ============================================================================
//  Component: CounterApp
//  Renders a vertical stack with title, count display, and button row.
//  Uses VStack for vertical layout, HStack for button row.
//  on_click callbacks increment/decrement/reset the count.
// ============================================================================

/// Counter application UI. Displays the current count and provides
/// increment (+), decrement (-), and reset buttons.
///
/// Layout:
///   VStack (padding=20, spacing=16, width=300, height=200)
///     ├─ Label "Kaintana Counter" (font_size=24)
///     ├─ Label "Count: N" (font_size=48, color=theme.accent)
///     └─ HStack (spacing=12)
///          ├─ Button "-" (width=48, on_click=on_decrement)
///          ├─ Button "+" (width=48, on_click=on_increment, variant=primary)
///          └─ Button "Reset" (width=80, on_click=on_reset, variant=ghost)
component CounterApp():
    state _count: Int = 0
    state _theme: KtTheme = DEFAULT_THEME
    state _frame_count: Int = 0

    /// Increment the counter by 1.
    fn on_increment(_self: Self_):
        _self._count = _self._count + 1

    /// Decrement the counter by 1.
    fn on_decrement(_self: Self_):
        _self._count = _self._count - 1

    /// Reset the counter to 0.
    fn on_reset(_self: Self_):
        _self._count = 0

    /// Format the count display text.
    fn display_text(_self: Self_) -> String:
        return "Count: " + str(_self._count)

    render <VStack padding={20} spacing={16} width={300} height={200} key="counter-root">
            <Label value="Kaintana Counter" font_size={24} key="title" />
            <Label value={display_text()} font_size={48} color={_theme.accent} key="count-display" />
            <HStack spacing={12} key="button-row">
                <Button label="-" width={48} on_click={on_decrement} key="dec-btn" />
                <Button label="+" width={48} on_click={on_increment} variant="primary" key="inc-btn" />
                <Button label="Reset" width={80} on_click={on_reset} variant="ghost" key="reset-btn" />
            </HStack>
        </VStack>

// ============================================================================
//  Program Entry Point
//  Initializes Kaintana, creates a session, registers the win32 backend,
//  runs the frame loop, and cleans up.
// ============================================================================

/// Application entry point.
///
/// Flow:
///   1. kt_init() — initialize the Kaintana C substrate
///   2. kt_make("CounterApp", 1280, 720) — create UI session
///   3. kt_backend_register + select — activate win32 renderer
///   4. Frame loop:
///      a. kt_begin(s, 16.0) — start new frame
///      b. Components render via JSX lower to vtable calls
///      c. kt_end(s) — conclude element tree
///      d. kt_present(s) — flip swapchain / blit backbuffer
///      e. Check kt_should_close(s) for exit signal
///   5. kt_free(s) — destroy session
fn main() -> Int:
    let init_result = kt_init()

    let s = kt_make("CounterApp", 1280, 720)
    if s < 0:
        return 1

    // Register and select the null backend for compilation/testing.
    // Replace "null" with "win32" for native desktop rendering.
    let reg_result = kt_backend_register(s, "null", 0)
    let sel_result = kt_backend_select(s, "null")

    // Frame loop: begin → render (via JSX lowering) → end → present
    while kt_should_close(s) == 0:
        kt_begin(s, 16.0)
        // The CounterApp component is rendered here via the world→surface
        // projection. The compiler wires CounterApp's render to the
        // current session's element tree.
        kt_end(s)
        kt_present(s)

    kt_free(s)
    return 0

// ============================================================================
// kaintana/examples/dashboard.kn
// ============================================================================
// ============================================================================
//  examples/dashboard.kn — Themed Dashboard Example
//  §15.4: Stat panels, progress bars, animated stats, data table chart.
//  Full app with world, kaintana surface, win32 backend, session loop.
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
// ============================================================================

// ── Direct imports from stdlib modules (NO `::` in JSX) ──────────────────────

use std::kaintana::core as core
use std::kaintana::theme as theme
use std::kaintana::layout as layout
use std::kaintana::widgets::Button as Button
use std::kaintana::widgets::Label as Label
use std::kaintana::widgets::ProgressBar as ProgressBar
use std::kaintana::layout::VStack as VStack
use std::kaintana::layout::HStack as HStack
use std::kaintana::layout::Spacer as Spacer

// ── Dark theme hex constants (for JSX attr values that don't support ::) ─────

pub const DASH_BG:        String = "#1A1A24"
pub const DASH_SURFACE:   String = "#232339"
pub const DASH_ACCENT:    String = "#21D4A1"
pub const DASH_ACCENT2:   String = "#7C3AED"
pub const DASH_ACCENT3:   String = "#F59E0B"
pub const DASH_ACCENT4:   String = "#EF4444"
pub const DASH_TEXT:      String = "#F1F1F6"
pub const DASH_TEXT_DIM:  String = "#6B6B80"
pub const DASH_BORDER:    String = "#2E2E4A"

// ═══════════════════════════════════════════════════════════════════════════════
//  LOCAL @EXTERN BINDINGS (for session lifecycle + backend registration)
// ═══════════════════════════════════════════════════════════════════════════════

type KtSession   = Int
type KtElementId = Int

@extern fn kt_init() -> Void
@extern fn kt_make(name: String, w: Int, h: Int) -> KtSession
@extern fn kt_free(s: KtSession) -> Void
@extern fn kt_begin(s: KtSession, delta_ms: Float) -> Void
@extern fn kt_end(s: KtSession) -> Void
@extern fn kt_present(s: KtSession) -> Void
@extern fn kt_should_close(s: KtSession) -> Int
@extern fn kt_host_pump(s: KtSession) -> Int
@extern fn kt_backend_register(s: KtSession, name: String, vtable: Int) -> Int
@extern fn kt_backend_select(s: KtSession, name: String) -> Int
@extern fn kt_backend_probe(s: KtSession) -> Int

// ═══════════════════════════════════════════════════════════════════════════════
//  LOCAL SESSION HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

fn session_running(s: KtSession) -> Bool:
    return kt_should_close(s) == 0

fn make_session(title: String, w: Int, h: Int) -> KtSession:
    kt_init()
    return kt_make(title, w, h)

fn destroy_session(s: KtSession):
    kt_free(s)

fn begin_frame(s: KtSession, delta_ms: Float):
    kt_begin(s, delta_ms)

fn end_frame(s: KtSession):
    kt_end(s)

fn present_frame(s: KtSession):
    kt_present(s)

// ═══════════════════════════════════════════════════════════════════════════════
//  STAT PANEL — Label + Value + ProgressBar
// ═══════════════════════════════════════════════════════════════════════════════

component StatPanel(label_txt: String, value_txt: String, pct: Float = 0.0, pct_max: Float = 100.0):
    render <VStack spacing={4} padding={12} width={180} height={120}>
        <Label value={label_txt} font_size={12} color={DASH_TEXT_DIM} />
        <Label value={value_txt} font_size={28} color={DASH_ACCENT} />
        <ProgressBar value={pct} max={pct_max} width={156} height={6} fill_color={DASH_ACCENT} track_color={DASH_BORDER} />
    </VStack>

// ═══════════════════════════════════════════════════════════════════════════════
//  CHART — Simple bar chart with colored boxes
// ═══════════════════════════════════════════════════════════════════════════════

component ChartBar(value: Float, max_val: Float = 100.0, bar_color: String = DASH_ACCENT, label_txt: String = ""):
    fn bar_pct(_self: Self_) -> Float:
        if _self.max_val > 0:
            return (_self.value / _self.max_val) * 100.0
        return 0.0

    render <VStack spacing={2} width={40} height={120} alignment="end">
        <box kind="chart-bar-fill" key={label_txt} width={28} height={bar_pct()} fill={bar_color} radius={2} />
        <Label value={label_txt} font_size={10} color={DASH_TEXT_DIM} />
    </VStack>

component ChartPanel():
    render <HStack spacing={8} padding={12} width={580} height={160}>
        <ChartBar value={85.0} max_val={100.0} bar_color={DASH_ACCENT} label_txt="Mon" />
        <ChartBar value={62.0} max_val={100.0} bar_color={DASH_ACCENT2} label_txt="Tue" />
        <ChartBar value={94.0} max_val={100.0} bar_color={DASH_ACCENT} label_txt="Wed" />
        <ChartBar value={78.0} max_val={100.0} bar_color={DASH_ACCENT3} label_txt="Thu" />
        <ChartBar value={55.0} max_val={100.0} bar_color={DASH_ACCENT2} label_txt="Fri" />
        <ChartBar value={88.0} max_val={100.0} bar_color={DASH_ACCENT4} label_txt="Sat" />
    </HStack>

// ═══════════════════════════════════════════════════════════════════════════════
//  DATA TABLE — Simple row-based data display
// ═══════════════════════════════════════════════════════════════════════════════

component DataRow(col1: String, col2: String, col3: String, is_header: Bool = false):
    fn txt_color(_self: Self_) -> String:
        if _self.is_header:
            return DASH_TEXT
        return DASH_TEXT_DIM

    fn bg_color(_self: Self_) -> String:
        if _self.is_header:
            return DASH_SURFACE
        return "#00000000"

    render <HStack spacing={0} padding={6} width={580} height={28} fill={bg_color()}>
        <Label value={col1} font_size={12} color={txt_color()} width={180} />
        <Label value={col2} font_size={12} color={txt_color()} width={200} />
        <Label value={col3} font_size={12} color={txt_color()} width={200} />
    </HStack>

component DataTable():
    render <VStack spacing={0} padding={8} width={580} height={200}>
        <DataRow col1="Metric" col2="Current" col3="Change" is_header={true} />
        <DataRow col1="CPU Usage" col2="34%" col3="-2%" />
        <DataRow col1="Memory" col2="1.2 GB" col3="+5%" />
        <DataRow col1="Network" col2="42 Mbps" col3="+12%" />
        <DataRow col1="Disk I/O" col2="85 MB/s" col3="-8%" />
    </VStack>

// ═══════════════════════════════════════════════════════════════════════════════
//  STAT ROW — Horizontal row of 4 StatPanels
// ═══════════════════════════════════════════════════════════════════════════════

component StatRow():
    render <HStack spacing={12} padding={8}>
        <StatPanel label_txt="Revenue" value_txt="$48,290" pct={76.0} />
        <StatPanel label_txt="Users" value_txt="12,847" pct={62.0} />
        <StatPanel label_txt="Sessions" value_txt="8,401" pct={91.0} />
        <StatPanel label_txt="Conversion" value_txt="3.2%" pct={45.0} />
    </HStack>

// ═══════════════════════════════════════════════════════════════════════════════
//  DASHBOARD — Top-level app layout
// ═══════════════════════════════════════════════════════════════════════════════

component Dashboard():
    state frame_count: Int = 0

    fn on_refresh(_self: Self_):
        _self.frame_count = _self.frame_count + 1

    render <VStack spacing={0} padding={16} width={1280} height={720} fill={DASH_BG}>
        <Label value="Kaintana Dashboard" font_size={24} color={DASH_TEXT} />
        <Spacer min_size={8} />
        <StatRow />
        <Spacer min_size={12} />
        <Label value="Weekly Activity" font_size={16} color={DASH_TEXT} />
        <ChartPanel />
        <Spacer min_size={12} />
        <Label value="System Metrics" font_size={16} color={DASH_TEXT} />
        <DataTable />
        <Spacer />
        <HStack spacing={8}>
            <Button label="Refresh" variant="primary" on_click={on_refresh} />
            <Button label="Settings" variant="ghost" />
        </HStack>
    </VStack>

// ═══════════════════════════════════════════════════════════════════════════════
//  WORLD with kaintana surface
// ═══════════════════════════════════════════════════════════════════════════════

world DashboardWorld:
    surface kaintana => Dashboard

// ═══════════════════════════════════════════════════════════════════════════════
//  MAIN — Register backend, run session loop
// ═══════════════════════════════════════════════════════════════════════════════

fn main() -> Int:
    let sid = make_session("Kaintana Dashboard", 1280, 720)
    if sid == -1:
        return 1

    let reg = kt_backend_probe(sid)
    if reg == 0:
        kt_free(sid)
        return 2

    while session_running(sid):
        let _ = kt_host_pump(sid)
        begin_frame(sid, 16.0)
        end_frame(sid)
        present_frame(sid)

    destroy_session(sid)
    return 0

// ============================================================================
//  END — examples/dashboard.kn
// ============================================================================

// ============================================================================
// kaintana/examples/interactive_dashboard.kn
// ============================================================================
// ============================================================================
//  examples/interactive_dashboard.kn — Interactive Animated Dashboard
//  Pulse-driven metric simulation with dark theme.
//
//  Features:
//    - 4 live metric panels (CPU, Memory, Network, Disk I/O) with
//      animated ProgressBar values
//    - Pulse-driven simulation updating every 500ms with triangle-wave
//      oscillation of all four metrics
//    - Frame counter display
//
//  Architecture:
//    - InteractiveDashboardWorld — compiler-owned state authority
//    - InteractiveDashboard — main component with pulse + render
//    - All layout uses native <box>/<text> elements
//    - Self-contained @extern declarations (no stdlib imports)
//
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
// ═══════════════════════════════════════════════════════════════════

@extern fn kt_init() -> Void
@extern fn kt_make(name: String, w: Int, h: Int) -> Int
@extern fn kt_free(s: Int) -> Void
@extern fn kt_begin(s: Int, delta_ms: Float) -> Void
@extern fn kt_end(s: Int) -> Void
@extern fn kt_present(s: Int) -> Void
@extern fn kt_should_close(s: Int) -> Int
@extern fn kt_host_pump(s: Int) -> Int
@extern fn kt_backend_register(s: Int, name: String, vtable: Int) -> Int
@extern fn kt_backend_select(s: Int, name: String) -> Int
@extern fn kt_row(s: Int, parent: Int, kind: String, key: String) -> Int
@extern fn kt_end_row(s: Int) -> Void
@extern fn kt_text(s: Int, elem: Int, text: String) -> Void
@extern fn kt_fill(s: Int, elem: Int, color: String) -> Void
@extern fn kt_stroke(s: Int, elem: Int, color: String, w: Float) -> Void
@extern fn kt_width(s: Int, elem: Int, w: Float) -> Void
@extern fn kt_height(s: Int, elem: Int, h: Float) -> Void
@extern fn kt_radius(s: Int, elem: Int, r: Float) -> Void
@extern fn kt_pad(s: Int, elem: Int, all: Float) -> Void
@extern fn kt_gap(s: Int, elem: Int, gap: Float) -> Void
@extern fn kt_direction(s: Int, elem: Int, dir: Int) -> Void
@extern fn kt_opacity(s: Int, elem: Int, a: Float) -> Void
@extern fn kt_font(s: Int, elem: Int, size: Float) -> Void
@extern fn kt_hovered(s: Int, elem: Int) -> Int
@extern fn kt_clicked(s: Int, elem: Int) -> Int
@extern fn kt_active(s: Int, elem: Int) -> Int

const KT_DIR_ROW: Int = 0
const KT_DIR_COLUMN: Int = 1
const APP_W: Int = 900
const APP_H: Int = 600
const BG: String = "#1A1A24"
const BORDER: String = "#2E2E4A"
const SURFACE: String = "#232339"
const GREEN: String = "#21D4A1"
const PURPLE: String = "#7C3AED"
const AMBER: String = "#F59E0B"
const RED: String = "#EF4444"
const PRG_H: Float = 8.0
const PRG_W: Float = 760.0
const LBL_COL: Float = 60.0

fn session_alive(s: Int) -> Bool:
    return kt_should_close(s) == 0

fn session_create(title: String, w: Int, h: Int) -> Int:
    kt_init()
    return kt_make(title, w, h)

fn session_destroy(s: Int):
    kt_free(s)

component InteractiveDashboard():
    state _frame_count: Int = 0
    state _cpu: Float = 34.0
    state _memory: Float = 62.0
    state _network: Float = 78.0
    state _disk_io: Float = 45.0

    pulse simulate every 500ms jitter 15ms:
        _frame_count = _frame_count + 1
        let t = _frame_count % 100
        let p = if t < 50: t else: 100 - t
        let f = p as Float / 50.0
        _cpu    = 15.0  + f * 70.0
        _memory = 30.0  + f * 55.0
        _network = 40.0 + f * 50.0
        _disk_io = 10.0 + f * 65.0

    render <box kind="col" key="root" fill={BG} width={APP_W as Float} height={APP_H as Float} pad={16.0} gap={4.0} direction={KT_DIR_COLUMN}>
        <box kind="row" key="hdr" gap={8.0} direction={KT_DIR_ROW}>
            <text value="Interactive Dashboard" />
            <box kind="spc" key="spc" width={0.0} />
            <text value={"Frames:" + str(_frame_count)} />
        </box>

        <box kind="div" key="d1" height={1.0} fill={BORDER} width={0.0} />

        <box kind="col" key="mcol" gap={8.0} pad={4.0} direction={KT_DIR_COLUMN}>
            <box kind="row" key="r1" gap={8.0} direction={KT_DIR_ROW}>
                <box kind="col" key="l1" gap={4.0} direction={KT_DIR_COLUMN} width={LBL_COL}>
                    <text value="CPU" />
                    <text value={str(_cpu as Int) + "%"} />
                </box>
                <box kind="trk" key="b1" fill={BORDER} width={PRG_W} height={PRG_H} radius={(PRG_H * 0.5)}>
                    <box kind="fl" key="f1" fill={GREEN} width={_cpu} height={PRG_H} radius={(PRG_H * 0.5)} />
                </box>
            </box>

            <box kind="row" key="r2" gap={8.0} direction={KT_DIR_ROW}>
                <box kind="col" key="l2" gap={4.0} direction={KT_DIR_COLUMN} width={LBL_COL}>
                    <text value="Memory" />
                    <text value={str(_memory as Int) + "%"} />
                </box>
                <box kind="trk" key="b2" fill={BORDER} width={PRG_W} height={PRG_H} radius={(PRG_H * 0.5)}>
                    <box kind="fl" key="f2" fill={PURPLE} width={_memory} height={PRG_H} radius={(PRG_H * 0.5)} />
                </box>
            </box>

            <box kind="row" key="r3" gap={8.0} direction={KT_DIR_ROW}>
                <box kind="col" key="l3" gap={4.0} direction={KT_DIR_COLUMN} width={LBL_COL}>
                    <text value="Network" />
                    <text value={str(_network as Int) + "%"} />
                </box>
                <box kind="trk" key="b3" fill={BORDER} width={PRG_W} height={PRG_H} radius={(PRG_H * 0.5)}>
                    <box kind="fl" key="f3" fill={AMBER} width={_network} height={PRG_H} radius={(PRG_H * 0.5)} />
                </box>
            </box>

            <box kind="row" key="r4" gap={8.0} direction={KT_DIR_ROW}>
                <box kind="col" key="l4" gap={4.0} direction={KT_DIR_COLUMN} width={LBL_COL}>
                    <text value="Disk I/O" />
                    <text value={str(_disk_io as Int) + "%"} />
                </box>
                <box kind="trk" key="b4" fill={BORDER} width={PRG_W} height={PRG_H} radius={(PRG_H * 0.5)}>
                    <box kind="fl" key="f4" fill={RED} width={_disk_io} height={PRG_H} radius={(PRG_H * 0.5)} />
                </box>
            </box>
        </box>

        <box kind="div" key="d2" height={1.0} fill={BORDER} width={0.0} />

        <box kind="row" key="ctrls" gap={12.0} direction={KT_DIR_ROW} pad={4.0}>
            <text value={"Frame:" + str(_frame_count)} />
            <box kind="spc" key="s2" width={0.0} />
            <box kind="btn" key="rst" fill={SURFACE} width={80.0} height={32.0} radius={4.0}>
                <text value="Reset" />
            </box>
        </box>
    </box>

world InteractiveDashboardWorld:
    surface kaintana => InteractiveDashboard

fn main() -> Int:
    let sid = session_create("Dashboard", APP_W, APP_H)
    if sid == -1:
        return 1
    if kt_backend_register(sid, "null", 0) == 0:
        session_destroy(sid)
        return 2
    if kt_backend_select(sid, "null") == 0:
        session_destroy(sid)
        return 3
    while session_alive(sid):
        let _ = kt_host_pump(sid)
        kt_begin(sid, 16.0)
        kt_end(sid)
        kt_present(sid)
    session_destroy(sid)
    return 0

