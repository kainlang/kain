pub const GPU_STAGE_TASK: Int = 8
pub const GPU_STAGE_MESH: Int = 16
pub const GPU_STAGE_RAYGEN: Int = 32
pub const GPU_STAGE_ANY_HIT: Int = 64
pub const GPU_STAGE_CLOSEST_HIT: Int = 128
pub const GPU_STAGE_MISS: Int = 256
pub const GPU_STAGE_INTERSECTION: Int = 512
pub const GPU_STAGE_CALLABLE: Int = 1024
pub const GPU_STAGE_COPY: Int = 2048
pub const GPU_STAGE_RESOLVE: Int = 4096
