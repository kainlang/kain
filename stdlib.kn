        session_id: session_id,
        frame_index: input_frame_index(session_id),
        event_count: input_event_count(session_id),
        trace_json: input_trace_json(session_id),
    }

pub fn input_trace_record_json(trace: InputTraceRecord) -> JsonObject:
    let payload = json_object()
    let _session = json_object_set_int(payload, "session_id", trace.session_id)
    let _frame = json_object_set_int(payload, "frame_index", trace.frame_index)
    let _count = json_object_set_int(payload, "event_count", trace.event_count)
    let _trace = json_object_set_string(payload, "trace_json", trace.trace_json)
    return payload

pub fn input_replay_trace_record(session_id: Int, trace: InputTraceRecord) -> Int:
    return input_replay_trace_json(session_id, trace.trace_json)

