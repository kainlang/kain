pub struct FsMetadata:
    file_type: String
    len: Int
    readonly: Bool
    created_millis: Int
    modified_millis: Int
    accessed_millis: Int

pub struct FsMetadataResult:
    ok: Bool
    value: FsMetadata
    status: Int
    error: FsError

pub struct FsDirEntry:
