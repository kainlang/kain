pub fn fs_read_text(path: String) -> String:
    // Keep the fast helper pinned to the raw ABI string lane for now.
    // `abi_fs_read_text` returns the correct owned Kain string, while the
    // richer `FsTextResult` wrapper path is currently mispacking success
    // results under native LLVM in smoketest pressure.
    return abi_fs_read_text(path)

