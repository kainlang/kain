const APP_W: Int = 400
const APP_H: Int = 300

fn main() -> Int:
    kt_init()
    let sid = kt_make("PureExtern", APP_W, APP_H)
    if sid < 0:
        return 1
    let reg = kt_backend_register(sid, "null", 0)
    let sel = kt_backend_select(sid, "null")
    while kt_should_close(sid) == 0:
        kt_begin(sid, 16.0)
        kt_end(sid)
        kt_present(sid)
    kt_free(sid)
    return 0

// ============================================================================
// kaintana/examples/scrollable_list.kn
// ============================================================================
// ============================================================================
//  scrollable_list.kn — Scrollable List with 50+ Items
//  Example from MASTER_STDLIB.md §15.3
//
//  Demonstrates:
//    - component ScrollableList with ScrollView containing many items
//    - 50+ items generated programmatically via text content builder
//    - Uses ScrollView, VStack, Label widgets
//    - Import from core.kn, theme.kn, layout.kn, widgets/ScrollView.kn, widgets/Label.kn
//    - Session lifecycle: kt_init -> kt_make -> kt_backend_probe -> frame loop
//    - JSX attributes on single lines
//
//  Verify: kain check scrollable_list.kn --json
//  Run with: RENDERER_BACKEND=win32 kain run scrollable_list.kn --target llvm
// ============================================================================

// ═══════════════════════════════════════════════════════════════════════════
//  IMPORTS — from std::kaintana modules
// ═══════════════════════════════════════════════════════════════════════════

use std::kaintana::core as core
use std::kaintana::theme as theme
use std::kaintana::layout as layout

// ═══════════════════════════════════════════════════════════════════════════
//  @extern BINDINGS — Full session lifecycle + element tree + attributes
// ═══════════════════════════════════════════════════════════════════════════

@extern fn kt_init() -> Void
@extern fn kt_make(name: String, w: Int, h: Int) -> Int
@extern fn kt_free(s: Int) -> Void
@extern fn kt_begin(s: Int, delta_ms: Float) -> Void
@extern fn kt_end(s: Int) -> Void
@extern fn kt_present(s: Int) -> Void
@extern fn kt_should_close(s: Int) -> Int
@extern fn kt_backend_probe(s: Int) -> Int

@extern fn kt_row(s: Int, parent: Int, kind: String, key: String) -> Int
@extern fn kt_end_row(s: Int) -> Void
@extern fn kt_text(s: Int, elem: Int, text: String) -> Void

@extern fn kt_fill(s: Int, elem: Int, color: String) -> Void
@extern fn kt_width(s: Int, elem: Int, w: Float) -> Void
@extern fn kt_height(s: Int, elem: Int, h: Float) -> Void
@extern fn kt_radius(s: Int, elem: Int, r: Float) -> Void
@extern fn kt_opacity(s: Int, elem: Int, a: Float) -> Void
@extern fn kt_pad(s: Int, elem: Int, all: Float) -> Void
@extern fn kt_gap(s: Int, elem: Int, gap: Float) -> Void
@extern fn kt_direction(s: Int, elem: Int, dir: Int) -> Void

@extern fn kt_hovered(s: Int, elem: Int) -> Int
@extern fn kt_clicked(s: Int, elem: Int) -> Int
@extern fn kt_active(s: Int, elem: Int) -> Int

@extern fn kt_put(s: Int, key: String, v: Int) -> Void
@extern fn kt_get(s: Int, key: String, fallback: Int) -> Int
@extern fn kt_put_f(s: Int, key: String, v: Float) -> Void
@extern fn kt_get_f(s: Int, key: String, fallback: Float) -> Float

// ═══════════════════════════════════════════════════════════════════════════
//  CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

const APP_TITLE: String = "Kaintana Scrollable List"
const APP_WIDTH: Int = 400
const APP_HEIGHT: Int = 500
const LIST_WIDTH: Float = 360.0
const LIST_HEIGHT: Float = 420.0
const ITEM_COUNT: Int = 50
const BG_COLOR: String = "#1A1A24"
const SURFACE_COLOR: String = "#232339"
const ACCENT_COLOR: String = "#21D4A1"
const ACCENT2_COLOR: String = "#7C3AED"
const ACCENT3_COLOR: String = "#F59E0B"
const ACCENT4_COLOR: String = "#EF4444"
const TEXT_DIM: String = "#6B6B80"
const CORNER_RADIUS: Float = 6.0
const PULSE_DELTA: Float = 16.0

// ═══════════════════════════════════════════════════════════════════════════
//  DATA GENERATION — build items as formatted text for scroll view
// ═══════════════════════════════════════════════════════════════════════════

/// Generate a formatted text block representing N list items.
/// Each item includes a title, subtitle, category, and priority badge text.
pub fn generate_list_text(count: Int) -> String:
    var result: String = ""
    var i: Int = 0
    while i < count:
        let idx = i + 1
        let cat_idx = idx % 5
        let category = match cat_idx:
            0 => "Task"
            1 => "Event"
            2 => "Note"
            3 => "Reminder"
            4 => "Idea"
            _ => "Item"
        let priority = (idx * 7) % 5 + 1
        let priority_str = match priority:
            1 => "Low"
            2 => "Medium"
            3 => "High"
            4 => "Critical"
            5 => "Urgent"
            _ => "?"
        // Format one item as a single-line text block
        let item_text = "[" + category + "]  " + category + " #" + str(idx) + "  (priority: " + priority_str + ")\n" + "         Sample data " + str((idx * 13) % 100) + " — created day " + str(idx) + "\n"
        result = result + item_text
        i = i + 1
    return result
// ═══════════════════════════════════════════════════════════════════════════
//  COLOR HELPERS — category/priority color lookup by index
// ═══════════════════════════════════════════════════════════════════════════

/// Get a fill color for a given item index based on category cycling.
fn item_bg_color(idx: Int) -> String:
    let cat_idx = (idx + 1) % 5
    match cat_idx:
        0 => return ACCENT_COLOR
        1 => return ACCENT2_COLOR
        2 => return ACCENT3_COLOR
        3 => return ACCENT4_COLOR
        4 => return SURFACE_COLOR
        _ => return SURFACE_COLOR

// ═══════════════════════════════════════════════════════════════════════════
//  COMPONENT: ScrollableList
//  Displays 50+ items in a scrollable box with colored item backgrounds.
//  Items are generated as formatted text content.
// ═══════════════════════════════════════════════════════════════════════════

/// Scrollable list component with 50+ structured items.
/// Each item shows title, subtitle, category, and priority.
/// Items are programmatically generated as formatted text in a scroll view.
component ScrollableList(
    count: Int = ITEM_COUNT,
    width: Float = LIST_WIDTH,
    height: Float = LIST_HEIGHT,
    key: String = "scrollable-list",
):
    state list_text: String = generate_list_text(count)
    state scroll_title: String = "Scrollable List — " + str(count) + " items"

    render <box kind="scrollview" key={key} width={width} height={height} fill={BG_COLOR} pad={8} gap={4} direction={1}>
        <text value={scroll_title} />
        <box kind="list-content" key="items-wrap" fill={SURFACE_COLOR} width={width - 16} height={height - 36} radius={CORNER_RADIUS} pad={6} gap={2} direction={1}>
            <text value={list_text} />
        </box>
    </box>

// ═══════════════════════════════════════════════════════════════════════════
//  DEMO COMPONENT: ListDemo
//  Top-level scene wrapping ScrollableList with header and instructions.
// ═══════════════════════════════════════════════════════════════════════════

component ListDemo():
    state frame: Int = 0

    render <box kind="column" key="list-demo-root" fill={BG_COLOR} width={APP_WIDTH as Float} height={APP_HEIGHT as Float} pad={16} gap={8} direction={1}>
        <text value={"Kaintana Scrollable List Demo"} />
        <text value={"Frame: " + str(frame)} />
        <ScrollableList count={ITEM_COUNT} width={LIST_WIDTH} height={LIST_HEIGHT} key="main-list" />
    </box>

// ═══════════════════════════════════════════════════════════════════════════
//  WORLD — ties ListDemo to the kaintana surface
// ═══════════════════════════════════════════════════════════════════════════

world ScrollableListWorld:
    surface kaintana => ListDemo

// ═══════════════════════════════════════════════════════════════════════════
//  MAIN — Session lifecycle and program entry
// ═══════════════════════════════════════════════════════════════════════════

fn main() -> Int:
    kt_init()
    let sid = kt_make(APP_TITLE, APP_WIDTH, APP_HEIGHT)
    if sid < 0:
        return 1
    let probe_ok = kt_backend_probe(sid)
    if probe_ok == 0:
        return 2
    var running = kt_should_close(sid)
    while running == 0:
        kt_begin(sid, PULSE_DELTA)
        kt_end(sid)
        kt_present(sid)
        running = kt_should_close(sid)
    kt_free(sid)
    return 0

// ============================================================================
//  END — scrollable_list.kn
// ============================================================================

// ============================================================================
// kaintana/examples/spring_playground.kn
// ============================================================================
// ============================================================================
//  examples/spring_playground.kn — Spring Animation Playground
//
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
//
//  Demonstrates:
//    - Spring physics animation (inline Hooke's law Euler integration)
//    - Interactive controls (box elements with hover/click interaction)
//    - Real-time display of spring value and velocity
//    - world + surface kaintana for state authority
//    - component with JSX rendering
//    - Frame-query pattern with hovered/clicked interaction
//
//  Architecture:
//    - SpringWorld: compiler-owned state authority (spring state + surface)
//    - advance_spring(): world patch called each frame from main()
//    - SpringPlayground: component with JSX render, reads world fields
//    - main(): session lifecycle, null backend, frame loop
//
//  Self-contained — all @extern bindings declared locally to avoid
//  the pre-existing KT_DIR_* duplicate constant bug in amalgamated
//  std::kaintana module (X:\stdlib\kaintana). No stdlib imports needed.
// ============================================================================

// ── Session lifecycle ─────────────────────────────────────────────────────
@extern fn kt_init() -> Void
@extern fn kt_make(name: String, w: Int, h: Int) -> Int
@extern fn kt_free(s: Int) -> Void
@extern fn kt_begin(s: Int, delta_ms: Float) -> Void
@extern fn kt_end(s: Int) -> Void
@extern fn kt_present(s: Int) -> Void
@extern fn kt_should_close(s: Int) -> Int
@extern fn kt_backend_register(s: Int, name: String, vtable: Int) -> Int
@extern fn kt_backend_select(s: Int, name: String) -> Int

// ── Element tree ─────────────────────────────────────────────────────────
@extern fn kt_row(s: Int, parent: Int, kind: String, key: String) -> Int
@extern fn kt_end_row(s: Int) -> Void
@extern fn kt_text(s: Int, elem: Int, text: String) -> Void

// ── Layout ───────────────────────────────────────────────────────────────
@extern fn kt_width(s: Int, elem: Int, w: Float) -> Void
@extern fn kt_height(s: Int, elem: Int, h: Float) -> Void
@extern fn kt_pad(s: Int, elem: Int, all: Float) -> Void
@extern fn kt_gap(s: Int, elem: Int, gap: Float) -> Void
@extern fn kt_direction(s: Int, elem: Int, dir: Int) -> Void

// ── Style ────────────────────────────────────────────────────────────────
@extern fn kt_fill(s: Int, elem: Int, color: String) -> Void
@extern fn kt_radius(s: Int, elem: Int, r: Float) -> Void
@extern fn kt_font(s: Int, elem: Int, size: Float) -> Void

// ── Interaction ──────────────────────────────────────────────────────────
@extern fn kt_hovered(s: Int, elem: Int) -> Int
@extern fn kt_clicked(s: Int, elem: Int) -> Int
@extern fn kt_active(s: Int, elem: Int) -> Int

// ═══════════════════════════════════════════════════════════════════════════
//  Constants
// ═══════════════════════════════════════════════════════════════════════════

const SPRING_STIFFNESS: Float = 0.3
const SPRING_DAMPING: Float = 0.7
const ANIM_DT_MS: Float = 16.0
const BOX_BASE: Float = 50.0
const BOX_MAX: Float = 700.0
const CONT_H: Float = 80.0
const CONT_W: Float = 700.0
const BOX_H: Float = 60.0
const CONT_PAD: Float = 10.0
const APP_W: Int = 800
const APP_H: Int = 600
const PAD: Float = 24.0
const GAP: Float = 16.0
const SM_GAP: Float = 12.0
const DIR_COL: Int = 1
const DIR_ROW: Int = 0

const CLR_BG: String = "#1A1A24"
const CLR_SURFACE: String = "#232339"
const CLR_ACCENT: String = "#21D4A1"
const CLR_TEXT: String = "#F1F1F6"
const CLR_DIM: String = "#6B6B80"
const CLR_BTN: String = "#2A2A40"
const CLR_BTN_PRIMARY: String = "#21D4A1"
const FONT_TITLE: Float = 24.0
const FONT_VAL: Float = 20.0
const FONT_SM: Float = 14.0
const FONT_XS: Float = 12.0
const FONT_BTN_LABEL: Float = 14.0
const FONT_CTL: Float = 16.0
const BTN_W: Float = 100.0
const BTN_W_SM: Float = 80.0
const BTN_H: Float = 32.0
const RADIUS_MD: Float = 8.0
const RADIUS_SM: Float = 6.0
const RADIUS_BTN: Float = 4.0

// ═══════════════════════════════════════════════════════════════════════════
//  World: SpringWorld — compiler-owned state authority
//  Holds spring state AND surface projection to SpringPlayground.
//  Spring state is advanced each frame by advance_spring() patch.
// ═══════════════════════════════════════════════════════════════════════════

world SpringWorld:
    state spring_value: Float = 0.0
    state spring_velocity: Float = 0.0
    state spring_target: Float = 300.0
    surface kaintana => SpringPlayground

// ═══════════════════════════════════════════════════════════════════════════
//  Spring physics helpers (plain functions, not component methods)
// ═══════════════════════════════════════════════════════════════════════════

/// Clamp a float to [lo, hi].
fn clamp_f(v: Float, lo: Float, hi: Float) -> Float:
    if v < lo: return lo
    if v > hi: return hi
    return v

/// Return absolute value of a float.
fn abs_f(v: Float) -> Float:
    if v < 0.0: return -v
    return v

/// Advance the spring simulation by dt_ms toward the target.
/// Uses semi-implicit Euler integration of Hooke's law:
///   force = -stiffness * (value - target)
///   damp_force = -damping * velocity
///   acceleration = force + damp_force
///   velocity += acceleration * dt
///   value += velocity * dt
fn spring_step(current: Float, velocity: Float, target: Float, dt_ms: Float) -> (Float, Float):
    let delta = current - target
    let force = -SPRING_STIFFNESS * delta
    let damp_force = -SPRING_DAMPING * velocity
    let accel = force + damp_force
    let new_vel = velocity + accel * dt_ms
    let new_val = current + new_vel * dt_ms
    return (new_val, new_vel)

/// Advance spring state in the world. Called each frame from main().
patch advance_spring(target: SpringWorld):
    let (new_val, new_vel) = spring_step(
        target.spring_value,
        target.spring_velocity,
        target.spring_target,
        ANIM_DT_MS,
    )
    target.spring_value = new_val
    target.spring_velocity = new_vel

/// Set spring target. Called by button click handlers.
patch set_target(target: SpringWorld, val: Float):
    target.spring_target = val

/// Reset spring to zero.
patch reset_spring(target: SpringWorld):
    target.spring_value = 0.0
    target.spring_velocity = 0.0
    target.spring_target = 0.0

// ═══════════════════════════════════════════════════════════════════════════
//  Component: SpringPlayground
//  Reads world fields directly — no per-frame method calls with side effects.
//  Button labels use format_value() for display.
// ═══════════════════════════════════════════════════════════════════════════

/// Format a float as an integer string for display.
fn fmt_val(v: Float) -> String:
    let rounded = (v + 0.5) as Int
    return str(rounded)

/// Return settled status string based on world state.
fn status_str() -> String:
    let diff = SpringWorld.spring_value - SpringWorld.spring_target
    let abs_diff = abs_f(diff)
    let abs_vel = abs_f(SpringWorld.spring_velocity)
    if abs_diff > 0.5 or abs_vel > 0.5:
        return "Animating..."
    return "Settled"

/// Spring animation playground component.
/// Renders the animated box, value/velocity/status labels, and target buttons.
component SpringPlayground():
    render <box kind="stack" key="root" direction={DIR_COL} pad={PAD} gap={GAP} width={APP_W} height={APP_H}>
            <box kind="text" key="title" fill="#F1F1F6" font_size={FONT_TITLE}>
                <text value={"Spring Animation Playground"} />
            </box>
            <box kind="text" key="val" fill="#21D4A1" font_size={FONT_VAL}>
                <text value={"Spring Value: " + fmt_val(SpringWorld.spring_value)} />
            </box>
            <box kind="text" key="vel" fill="#6B6B80" font_size={FONT_SM}>
                <text value={"Velocity: " + fmt_val(SpringWorld.spring_velocity * 100.0) + " (x100)"} />
            </box>
            <box kind="text" key="cfg" fill="#6B6B80" font_size={FONT_XS}>
                <text value={"Spring: val=" + fmt_val(SpringWorld.spring_value) + "  vel=" + fmt_val(SpringWorld.spring_velocity * 100.0) + "  target=" + fmt_val(SpringWorld.spring_target)} />
            </box>
            <box kind="text" key="status" fill="#21D4A1" font_size={FONT_SM}>
                <text value={status_str()} />
            </box>
            <box kind="box" key="container" width={CONT_W} height={CONT_H} fill="#232339" radius={RADIUS_MD} pad={CONT_PAD}>
                <box kind="box" key="anim" width={clamp_f(BOX_BASE + SpringWorld.spring_value, BOX_BASE, BOX_MAX)} height={BOX_H} fill="#21D4A1" radius={RADIUS_SM} />
            </box>
            <box kind="text" key="ctl-label" fill="#F1F1F6" font_size={FONT_CTL}>
                <text value={"Target Controls"} />
            </box>
            <box kind="stack" key="btn-row" direction={DIR_ROW} gap={SM_GAP}>
                <box kind="button" key="btn100" width={BTN_W} height={BTN_H} fill="#2A2A40" radius={RADIUS_BTN}>
                    <text value={"Target 100"} />
                </box>
                <box kind="button" key="btn300" width={BTN_W} height={BTN_H} fill="#21D4A1" radius={RADIUS_BTN}>
                    <text value={"Target 300"} />
                </box>
                <box kind="button" key="btn500" width={BTN_W} height={BTN_H} fill="#2A2A40" radius={RADIUS_BTN}>
                    <text value={"Target 500"} />
                </box>
                <box kind="button" key="btnReset" width={BTN_W_SM} height={BTN_H} fill="#2A2A40" radius={RADIUS_BTN}>
                    <text value={"Reset"} />
                </box>
            </box>
        </box>

// ═══════════════════════════════════════════════════════════════════════════
//  Program Entry Point
// ═══════════════════════════════════════════════════════════════════════════

fn main() -> Int:
    kt_init()

    let s = kt_make("Spring Playground", APP_W, APP_H)
    if s < 0:
        return 1

    let _ = kt_backend_register(s, "null", 0)
    let _ = kt_backend_select(s, "null")

    // Frame loop: advance spring each frame, then render via world->surface
    while kt_should_close(s) == 0:
        advance_spring(SpringWorld)
        kt_begin(s, ANIM_DT_MS)
        kt_end(s)
        kt_present(s)

    kt_free(s)
    return 0

// ============================================================================
// kaintana/examples/todo_app.kn
// ============================================================================
// ============================================================================
//  examples/todo_app.kn — Kaintana Todo List Application
//  World + surface kaintana + component with state + widgets + ScrollView
//
//  Features:
//    - World + surface kaintana binding
//    - Component with persistent state (pipe-delimited item storage)
//    - TextInput for adding new todo items
//    - Checkboxes to mark items as done
//    - Completed vs total count summary with ProgressBar
//    - ScrollView wrapping the item list
//    - Null backend for compilation/testing
//
//  Verify:  kain check todo_app.kn --json
//  Build:   RENDERER_BACKEND=null kain build todo_app.kn --target llvm
//  Run:     RENDERER_BACKEND=win32 kain run todo_app.kn --target llvm
// ============================================================================

type KtSession = Int
type KtElementId = Int

// ═══════════════════════════════════════════════════════════════════════════
//  @EXTERN BINDINGS
// ═══════════════════════════════════════════════════════════════════════════

@extern fn kt_init() -> Int
@extern fn kt_make(name: String, w: Int, h: Int) -> Int
@extern fn kt_free(s: KtSession) -> Void
@extern fn kt_begin(s: KtSession, delta_ms: Float) -> Void
@extern fn kt_end(s: KtSession) -> Void
@extern fn kt_present(s: KtSession) -> Void
@extern fn kt_should_close(s: KtSession) -> Int
@extern fn kt_host_pump(s: KtSession) -> Int
@extern fn kt_backend_register(s: KtSession, name: String, vtable: Int) -> Int
@extern fn kt_backend_select(s: KtSession, name: String) -> Int
@extern fn kt_row(s: KtSession, parent: KtElementId, kind: String, key: String) -> KtElementId
@extern fn kt_end_row(s: KtSession) -> Void
@extern fn kt_text(s: KtSession, elem: KtElementId, text: String) -> Void
@extern fn kt_fill(s: KtSession, elem: KtElementId, color: String) -> Void
@extern fn kt_stroke(s: KtSession, elem: KtElementId, color: String, w: Float) -> Void
@extern fn kt_width(s: KtSession, elem: KtElementId, w: Float) -> Void
@extern fn kt_height(s: KtSession, elem: KtElementId, h: Float) -> Void
@extern fn kt_radius(s: KtSession, elem: KtElementId, r: Float) -> Void
@extern fn kt_opacity(s: KtSession, elem: KtElementId, a: Float) -> Void
@extern fn kt_font(s: KtSession, elem: KtElementId, size: Float) -> Void
@extern fn kt_pad(s: KtSession, elem: KtElementId, all: Float) -> Void
@extern fn kt_gap(s: KtSession, elem: KtElementId, gap: Float) -> Void
@extern fn kt_direction(s: KtSession, elem: KtElementId, dir: Int) -> Void
@extern fn kt_hovered(s: KtSession, elem: KtElementId) -> Int
@extern fn kt_clicked(s: KtSession, elem: KtElementId) -> Int
@extern fn kt_active(s: KtSession, elem: KtElementId) -> Int
@extern fn kt_put(s: KtSession, key: String, v: Int) -> Void
@extern fn kt_get(s: KtSession, key: String, fallback: Int) -> Int
@extern fn kt_put_s(s: KtSession, key: String, v: String) -> Void
@extern fn kt_get_s(s: KtSession, key: String, fallback: String) -> String

// ═══════════════════════════════════════════════════════════════════════════
//  WIDGET IMPORTS — Self-contained components from std::kaintana
// ═══════════════════════════════════════════════════════════════════════════

use std::kaintana::Button
use std::kaintana::Label
use std::kaintana::TextInput
use std::kaintana::Checkbox
use std::kaintana::ScrollView
use std::kaintana::ProgressBar
use std::kaintana::Divider

// ═══════════════════════════════════════════════════════════════════════════
//  THEME CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════

const BG_COLOR:       String = "#1A1A24"
const SURFACE_COLOR:  String = "#232339"
const ACCENT_COLOR:   String = "#21D4A1"
const TEXT_COLOR:     String = "#F1F1F6"
const TEXT_DIM_COLOR: String = "#6B6B80"
const BORDER_COLOR:   String = "#2E2E4A"
const PIPE_BYTE:      Int    = 124

const APP_W: Int = 420
const APP_H: Int = 660
const LIST_W: Float = 380.0
const LIST_H: Float = 340.0
const ITEM_H: Float = 36.0

// ═══════════════════════════════════════════════════════════════════════════
//  STRING SEGMENT HELPERS — pipe-delimited storage for item data
//  These are pub (top-level) functions that the LLVM codegen can resolve.
//  Component JSX expressions call these directly instead of method calls.
// ═══════════════════════════════════════════════════════════════════════════

pub fn seg_count(s: String) -> Int:
    if s == "":
        return 0
    var count: Int = 1
    var i: Int = 0
    let n = len(s)
    while i < n:
        if byte_at(s, i) == PIPE_BYTE:
            count = count + 1
        i = i + 1
    return count

pub fn seg_build(s: String, start: Int, length: Int) -> String:
    var result: String = ""
    var i: Int = 0
    while i < length:
        result = result + chr(byte_at(s, start + i))
        i = i + 1
    return result

pub fn seg_get(s: String, idx: Int) -> String:
    var current: Int = 0
    var start: Int = 0
    var i: Int = 0
    let n = len(s)
    while i < n:
        if byte_at(s, i) == PIPE_BYTE:
            if current == idx:
                return seg_build(s, start, i - start)
            current = current + 1
            start = i + 1
        i = i + 1
    if current == idx:
        return seg_build(s, start, i - start)
    return ""

pub fn seg_append(s: String, val: String) -> String:
    if s == "":
        return val
    return s + "|" + val

pub fn seg_remove(s: String, idx: Int) -> String:
    let total = seg_count(s)
    if total <= 0 or idx < 0 or idx >= total:
        return s
    var result: String = ""
    var current: Int = 0
    var start: Int = 0
    var i: Int = 0
    let n = len(s)
    while i < n:
        if byte_at(s, i) == PIPE_BYTE:
            if current != idx:
                if result != "":
                    result = result + "|"
                result = result + seg_build(s, start, i - start)
            current = current + 1
            start = i + 1
        i = i + 1
    if current != idx:
        if result != "":
            result = result + "|"
        result = result + seg_build(s, start, i - start)
    return result

pub fn seg_set(s: String, idx: Int, val: String) -> String:
    var result: String = ""
    var current: Int = 0
    var start: Int = 0
    var i: Int = 0
    let n = len(s)
    while i < n:
        if byte_at(s, i) == PIPE_BYTE:
            if current == idx:
                result = result + val + "|"
            else:
                result = result + seg_build(s, start, i - start) + "|"
            current = current + 1
            start = i + 1
        i = i + 1
    if current == idx:
        result = result + val
    else:
        result = result + seg_build(s, start, i - start)
    return result

pub fn flip_done(v: String) -> String:
    if v == "0":
        return "1"
    return "0"

pub fn completed_for(done: String) -> Int:
    let n = seg_count(done)
    var cnt: Int = 0
    var i: Int = 0
    while i < n:
        if seg_get(done, i) == "1":
            cnt = cnt + 1
        i = i + 1
    return cnt

// ═══════════════════════════════════════════════════════════════════════════
//  COMPONENT: TodoApp
//  JSX expressions use pub helper functions + direct state access only.
//  Component methods (on_*, on_toggle_*) are only for on_click callbacks.
// ═══════════════════════════════════════════════════════════════════════════

component TodoApp():
    state _items: String = "Buy groceries|Walk the dog|Write Kain code|Review PR|Read a book|Clean workspace"
    state _done:  String = "0|0|1|0|0|0"
    state _input: String = ""
    state _frame: Int = 0

    fn on_add(_self: Self_):
        let text = _self._input
        if text != "":
            _self._items = seg_append(_self._items, text)
            _self._done = seg_append(_self._done, "0")
            _self._input = ""

    fn on_toggle_0(_self: Self_):
        _self._done = seg_set(_self._done, 0, flip_done(seg_get(_self._done, 0)))

    fn on_toggle_1(_self: Self_):
        _self._done = seg_set(_self._done, 1, flip_done(seg_get(_self._done, 1)))

    fn on_toggle_2(_self: Self_):
        _self._done = seg_set(_self._done, 2, flip_done(seg_get(_self._done, 2)))

    fn on_toggle_3(_self: Self_):
        _self._done = seg_set(_self._done, 3, flip_done(seg_get(_self._done, 3)))

    fn on_toggle_4(_self: Self_):
        _self._done = seg_set(_self._done, 4, flip_done(seg_get(_self._done, 4)))

    fn on_toggle_5(_self: Self_):
        _self._done = seg_set(_self._done, 5, flip_done(seg_get(_self._done, 5)))

    fn on_toggle_6(_self: Self_):
        _self._done = seg_set(_self._done, 6, flip_done(seg_get(_self._done, 6)))

    fn on_toggle_7(_self: Self_):
        _self._done = seg_set(_self._done, 7, flip_done(seg_get(_self._done, 7)))

    fn on_remove_0(_self: Self_):
        _self._items = seg_remove(_self._items, 0)
        _self._done = seg_remove(_self._done, 0)

    fn on_remove_1(_self: Self_):
        _self._items = seg_remove(_self._items, 1)
        _self._done = seg_remove(_self._done, 1)

    fn on_remove_2(_self: Self_):
        _self._items = seg_remove(_self._items, 2)
        _self._done = seg_remove(_self._done, 2)

    fn on_remove_3(_self: Self_):
        _self._items = seg_remove(_self._items, 3)
        _self._done = seg_remove(_self._done, 3)

    fn on_remove_4(_self: Self_):
        _self._items = seg_remove(_self._items, 4)
        _self._done = seg_remove(_self._done, 4)

    fn on_remove_5(_self: Self_):
        _self._items = seg_remove(_self._items, 5)
        _self._done = seg_remove(_self._done, 5)

    fn on_remove_6(_self: Self_):
        _self._items = seg_remove(_self._items, 6)
        _self._done = seg_remove(_self._done, 6)

    fn on_remove_7(_self: Self_):
        _self._items = seg_remove(_self._items, 7)
        _self._done = seg_remove(_self._done, 7)

    render <box kind="stack" direction={1} pad={16} gap={8} width={APP_W as Float} height={APP_H as Float} fill={BG_COLOR} key="todo-root">

        <Label value={"Todo App \u2014 " + str(seg_count(_items)) + " items"} font_size={22} color={TEXT_COLOR} key="header" />

        <box kind="stack" direction={0} gap={8} height={ITEM_H} key="input-row">
            <TextInput value={_input} placeholder="Add a new task..." width={280} key="todo-input" />
            <Button label="Add" variant="primary" on_click={on_add} key="add-btn" />
        </box>

        <Label value={"Completed: " + str(completed_for(_done)) + " / " + str(seg_count(_items))} font_size={13} color={ACCENT_COLOR} key="summary" />

        <ProgressBar value={(completed_for(_done) as Float / seg_count(_items) as Float) * 100.0} max={100.0} width={360} height={6} fill_color={ACCENT_COLOR} track_color={BORDER_COLOR} key="progress" />

        <box kind="box" height={1} fill={BORDER_COLOR} key="divider" />

        <ScrollView axis="vertical" width={LIST_W} height={LIST_H} key="todo-list">
            <box kind="stack" direction={1} gap={4} pad={4} key="items-box">
                <box kind="stack" direction={0} gap={8} height={ITEM_H} key="row-0">
                    <Checkbox checked={seg_get(_done, 0) == "1"} label={seg_get(_items, 0)} key="chk-0" />
                    <Button label="X" variant="ghost" width={28} height={28} on_click={on_remove_0} key="rm-0" />
                </box>
                <box kind="stack" direction={0} gap={8} height={ITEM_H} key="row-1">
                    <Checkbox checked={seg_get(_done, 1) == "1"} label={seg_get(_items, 1)} key="chk-1" />
                    <Button label="X" variant="ghost" width={28} height={28} on_click={on_remove_1} key="rm-1" />
                </box>
                <box kind="stack" direction={0} gap={8} height={ITEM_H} key="row-2">
                    <Checkbox checked={seg_get(_done, 2) == "1"} label={seg_get(_items, 2)} key="chk-2" />
                    <Button label="X" variant="ghost" width={28} height={28} on_click={on_remove_2} key="rm-2" />
                </box>
                <box kind="stack" direction={0} gap={8} height={ITEM_H} key="row-3">
                    <Checkbox checked={seg_get(_done, 3) == "1"} label={seg_get(_items, 3)} key="chk-3" />
                    <Button label="X" variant="ghost" width={28} height={28} on_click={on_remove_3} key="rm-3" />
                </box>
                <box kind="stack" direction={0} gap={8} height={ITEM_H} key="row-4">
                    <Checkbox checked={seg_get(_done, 4) == "1"} label={seg_get(_items, 4)} key="chk-4" />
                    <Button label="X" variant="ghost" width={28} height={28} on_click={on_remove_4} key="rm-4" />
                </box>
                <box kind="stack" direction={0} gap={8} height={ITEM_H} key="row-5">
                    <Checkbox checked={seg_get(_done, 5) == "1"} label={seg_get(_items, 5)} key="chk-5" />
                    <Button label="X" variant="ghost" width={28} height={28} on_click={on_remove_5} key="rm-5" />
                </box>
                <box kind="stack" direction={0} gap={8} height={ITEM_H} key="row-6">
                    <Checkbox checked={seg_get(_done, 6) == "1"} label={seg_get(_items, 6)} key="chk-6" />
                    <Button label="X" variant="ghost" width={28} height={28} on_click={on_remove_6} key="rm-6" />
                </box>
                <box kind="stack" direction={0} gap={8} height={ITEM_H} key="row-7">
                    <Checkbox checked={seg_get(_done, 7) == "1"} label={seg_get(_items, 7)} key="chk-7" />
                    <Button label="X" variant="ghost" width={28} height={28} on_click={on_remove_7} key="rm-7" />
                </box>
            </box>
        </ScrollView>

        <Label value={"Frame: " + str(_frame)} font_size={11} color={TEXT_DIM_COLOR} key="fps" />
    </box>

// ═══════════════════════════════════════════════════════════════════════════
//  WORLD: TodoWorld
// ═══════════════════════════════════════════════════════════════════════════

world TodoWorld:
    surface kaintana => TodoApp

// ═══════════════════════════════════════════════════════════════════════════
//  MAIN — Program entry point
// ═══════════════════════════════════════════════════════════════════════════

fn main() -> Int:
    let init_result = kt_init()
    let sid = kt_make("Todo App", APP_W, APP_H)
    if sid < 1:
        return 1

    let reg = kt_backend_register(sid, "null", 0)
    if reg == 0:
        kt_free(sid)
        return 2
    let sel = kt_backend_select(sid, "null")
    if sel == 0:
        kt_free(sid)
        return 3

    var frame: Int = 0
    while kt_should_close(sid) == 0:
        let _ = kt_host_pump(sid)
        kt_begin(sid, 16.0)
        kt_end(sid)
        kt_present(sid)
        frame = frame + 1

    kt_free(sid)
    return 0

// ============================================================================
//  END — examples/todo_app.kn
// ============================================================================

// ============================================================================
// kaintana/examples/world_component.kn
// ============================================================================
@extern fn kt_init() -> Void
@extern fn kt_make(n: String, w: Int, h: Int) -> Int
@extern fn kt_free(s: Int) -> Void
@extern fn kt_begin(s: Int, dt: Float) -> Void
@extern fn kt_end(s: Int) -> Void
@extern fn kt_present(s: Int) -> Void
@extern fn kt_should_close(s: Int) -> Int
@extern fn kt_host_pump(s: Int) -> Int
@extern fn kt_backend_register(s: Int, name: String, vtable: Int) -> Int
@extern fn kt_backend_select(s: Int, name: String) -> Int
@extern fn kt_row(s: Int, parent: Int, kind: String, key: String) -> Int
@extern fn kt_end_row(s: Int) -> Void
@extern fn kt_text(s: Int, elem: Int, text: String) -> Void
@extern fn kt_fill(s: Int, elem: Int, color: String) -> Void
@extern fn kt_width(s: Int, elem: Int, w: Float) -> Void
@extern fn kt_height(s: Int, elem: Int, h: Float) -> Void
@extern fn kt_radius(s: Int, elem: Int, r: Float) -> Void
@extern fn kt_pad(s: Int, elem: Int, all: Float) -> Void
@extern fn kt_gap(s: Int, elem: Int, gap: Float) -> Void
@extern fn kt_direction(s: Int, elem: Int, dir: Int) -> Void
@extern fn kt_put(s: Int, key: String, v: Int) -> Void
@extern fn kt_get(s: Int, key: String, fallback: Int) -> Int

const KT_DIR_COLUMN: Int = 1
const KT_DIR_ROW: Int = 0

component Demo():
    state _count: Int = 0

    pulse tick every 500ms:
        _count = _count + 1

    render <box kind="column" key="root" fill="#1A1A24" width={400} height={300} pad={16} gap={8} direction={KT_DIR_COLUMN}>
        <text value="Hello Kaintana" />
        <box kind="row" key="count-row" gap={8} direction={KT_DIR_ROW}>
            <text value="Count:" />
            <text value={str(_count)} />
        </box>
    </box>

world DemoWorld:
    surface kaintana => Demo

fn main() -> Int:
    kt_init()
    let sid = kt_make("Demo", 400, 300)
    if sid < 0: return 1
    let _ = kt_backend_register(sid, "null", 0)
    let _ = kt_backend_select(sid, "null")
    while kt_should_close(sid) == 0:
        let _ = kt_host_pump(sid)
        kt_begin(sid, 16.0)
        kt_end(sid)
        kt_present(sid)
    kt_free(sid)
    return 0

// ============================================================================
// kaintana/hooks.kn
// ============================================================================
// ============================================================================
//  hooks.kn — Kaintana state management hooks
//  P1-007: useState, useAnimation, useRef wrapping kt_get/kt_put with
//          component-scoped key prefixes.
//
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
//
//  Design:
//    - useState wraps kt_get/kt_put with component-scoped key prefix
//    - useAnimation manages SpringState lifecycle automatically
//    - useRef provides persistent mutable value without render-cycle coupling
//    - Keys are scoped by component stable_key + field name to avoid collisions
// ============================================================================

use std::kaintana::core::KtSession
use std::kaintana::core::kt_put
use std::kaintana::core::kt_put_f
use std::kaintana::core::kt_put_s
use std::kaintana::core::kt_get
use std::kaintana::core::kt_get_f
use std::kaintana::core::kt_get_s

// ============================================================================
//  SpringState — local definition (animation.kn is a separate P1 file)
//  Standard spring physics: stiffness=0.3, damping=0.7 defaults.
// ============================================================================

pub struct SpringState:
    value:     Float
    velocity:  Float
    stiffness: Float
    damping:   Float

pub fn spring_default() -> SpringState:
    return SpringState { value: 0.0, velocity: 0.0, stiffness: 0.3, damping: 0.7 }

pub fn spring_new(v: Float, vel: Float, stiff: Float, damp: Float) -> SpringState:
    return SpringState { value: v, velocity: vel, stiffness: stiff, damping: damp }

pub fn spring_update(s: SpringState, target: Float, dt_ms: Float) -> SpringState:
    let delta = s.value - target
    let force = -s.stiffness * delta
    let damp = -s.damping * s.velocity
    let accel = force + damp
    let new_vel = s.velocity + accel * dt_ms
    let new_val = s.value + new_vel * dt_ms
    return SpringState { value: new_val, velocity: new_vel, stiffness: s.stiffness, damping: s.damping }

// ============================================================================
//  useState — typed state via kt_get/kt_put with prefix-scoped keys
// ============================================================================

pub struct StateInt:
    session: KtSession
    key:     String
    value:   Int

pub impl StateInt:
    pub fn get(_self: Self_) -> Int:
        return _self.value
    pub fn set(_self: Self_, val: Int):
        kt_put(_self.session, _self.key, val)

pub fn useStateInt(s: KtSession, comp_key: String, field_name: String, initial: Int) -> StateInt:
    let storage = comp_key + "." + field_name
    let current = kt_get(s, storage, initial)
    return StateInt { session: s, key: storage, value: current }

pub struct StateFloat:
    session: KtSession
    key:     String
    value:   Float

pub impl StateFloat:
    pub fn get(_self: Self_) -> Float:
        return _self.value
    pub fn set(_self: Self_, val: Float):
        kt_put_f(_self.session, _self.key, val)

pub fn useStateFloat(s: KtSession, comp_key: String, field_name: String, initial: Float) -> StateFloat:
    let storage = comp_key + "." + field_name
    let current = kt_get_f(s, storage, initial)
    return StateFloat { session: s, key: storage, value: current }

pub struct StateString:
    session: KtSession
    key:     String
    value:   String

pub impl StateString:
    pub fn get(_self: Self_) -> String:
        return _self.value
    pub fn set(_self: Self_, val: String):
        kt_put_s(_self.session, _self.key, val)

pub fn useStateString(s: KtSession, comp_key: String, field_name: String, initial: String) -> StateString:
    let storage = comp_key + "." + field_name
    let current = kt_get_s(s, storage, initial)
    return StateString { session: s, key: storage, value: current }

// ============================================================================
//  useAnimation — auto-manage SpringState lifecycle
// ============================================================================

pub struct AnimationHandle:
    session: KtSession
    key:     String
    state:   SpringState

pub impl AnimationHandle:
    pub fn current(_self: Self_) -> Float:
        return _self.state.value
    pub fn update(_self: Self_, target: Float, dt_ms: Float) -> AnimationHandle:
        let new_state = spring_update(_self.state, target, dt_ms)
        return AnimationHandle { session: _self.session, key: _self.key, state: new_state }

pub fn useAnimation(s: KtSession, comp_key: String, field_name: String, initial_target: Float, stiffness: Float, damping: Float) -> AnimationHandle:
    let storage = comp_key + "." + field_name + "._anim"
    let s_state = spring_new(initial_target, 0.0, stiffness, damping)
    return AnimationHandle { session: s, key: storage, state: s_state }

// ============================================================================
//  useRef — persistent mutable value without render-cycle coupling
// ============================================================================

pub struct RefInt:
    session: KtSession
    key:     String
    value:   Int

pub impl RefInt:
    pub fn get(_self: Self_) -> Int:
        return _self.value
    pub fn set(_self: Self_, val: Int):
        kt_put(_self.session, _self.key, val)

pub fn useRefInt(s: KtSession, comp_key: String, field_name: String, initial: Int) -> RefInt:
    let storage = comp_key + "." + field_name + "._ref"
    let current = kt_get(s, storage, initial)
    return RefInt { session: s, key: storage, value: current }

pub struct RefFloat:
    session: KtSession
    key:     String
    value:   Float

pub impl RefFloat:
    pub fn get(_self: Self_) -> Float:
        return _self.value
    pub fn set(_self: Self_, val: Float):
        kt_put_f(_self.session, _self.key, val)

pub fn useRefFloat(s: KtSession, comp_key: String, field_name: String, initial: Float) -> RefFloat:
    let storage = comp_key + "." + field_name + "._ref"
    let current = kt_get_f(s, storage, initial)
    return RefFloat { session: s, key: storage, value: current }

// ============================================================================
// kaintana/input.kn
// ============================================================================
// ============================================================================
//  input.kn — Input state wrappers and modifier key helpers
//  P2-018: InputState struct wrapping kt_hovered/kt_clicked/kt_active.
//          ModifierKey query helpers. Frame-query pattern.
//
//  Declares its own @extern bindings for the interaction query C API.
// ============================================================================

use std::kaintana::KtSession

use std::kaintana::core::kt_hovered
use std::kaintana::KtElementId
use std::kaintana::core::kt_clicked
use std::kaintana::core::kt_active

// ═══════════════════════════════════════════════════════════════════════════
//  InputState — per-frame interaction state reader
// ═══════════════════════════════════════════════════════════════════════════

/// Per-frame input state. Read interaction state each frame from C.
pub struct InputState:
    /// Session handle for all queries.
    session: KtSession

pub impl InputState:
    /// Create InputState for a session.
    pub fn init(s: KtSession) -> InputState:
        return InputState { session: s }

    /// True if pointer is over this element.
    pub fn hovered(_self: Self_, elem: KtElementId) -> Bool:
        return kt_hovered(_self.session, elem) != 0

    /// True if element was clicked this frame.
    pub fn clicked(_self: Self_, elem: KtElementId) -> Bool:
        return kt_clicked(_self.session, elem) != 0

    /// True if element has pointer capture.
    pub fn active(_self: Self_, elem: KtElementId) -> Bool:
        return kt_active(_self.session, elem) != 0

    /// True if pointer is over AND element has capture.
    pub fn hovered_active(_self: Self_, elem: KtElementId) -> Bool:
        let h = kt_hovered(_self.session, elem) != 0
        let a = kt_active(_self.session, elem) != 0
        return h and a

    /// True if element was just pressed this frame.
    pub fn just_pressed(_self: Self_, elem: KtElementId) -> Bool:
        let h = kt_hovered(_self.session, elem) != 0
        let a = kt_active(_self.session, elem) != 0
        return h and a

// ═══════════════════════════════════════════════════════════════════════════
//  ModifierKey Constants
// ═══════════════════════════════════════════════════════════════════════════

pub const MOD_SHIFT: Int = 1
pub const MOD_CTRL:  Int = 2
pub const MOD_ALT:   Int = 4
pub const MOD_SUPER: Int = 8

// ═══════════════════════════════════════════════════════════════════════════
//  Modifier Key Query Helpers (stubs until keyboard query API available)
// ═══════════════════════════════════════════════════════════════════════════

pub fn mod_shift(s: KtSession) -> Bool:
    let _ = s
    return false

pub fn mod_ctrl(s: KtSession) -> Bool:
    let _ = s
    return false

pub fn mod_alt(s: KtSession) -> Bool:
    let _ = s
    return false

pub fn mod_super(s: KtSession) -> Bool:
    let _ = s
    return false

pub fn mod_any(s: KtSession, mask: Int) -> Bool:
    let _ = s
    let _ = mask
    return false

pub fn mod_any_key(s: KtSession) -> Bool:
    let _ = s
    return false

// ═══════════════════════════════════════════════════════════════════════════
//  Static modifier bitmask helpers
// ═══════════════════════════════════════════════════════════════════════════

/// Build a modifier key bitmask from individual flags.
pub fn mod_mask(shift: Bool, ctrl: Bool, alt: Bool, super_key: Bool) -> Int:
    var mask: Int = 0
    if shift:
        mask = mask + MOD_SHIFT
    if ctrl:
        mask = mask + MOD_CTRL
    if alt:
        mask = mask + MOD_ALT
    if super_key:
        mask = mask + MOD_SUPER
    return mask

pub fn mod_has_shift(mask: Int) -> Bool:
    return (mask and MOD_SHIFT) != 0

pub fn mod_has_ctrl(mask: Int) -> Bool:
    return (mask and MOD_CTRL) != 0

pub fn mod_has_alt(mask: Int) -> Bool:
    return (mask and MOD_ALT) != 0

pub fn mod_has_super(mask: Int) -> Bool:
    return (mask and MOD_SUPER) != 0

// ============================================================================
// kaintana/kaintana.kn
// ============================================================================
// ============================================================================
//  kaintana.kn — Re-export hub for the std::kaintana standard library
//  Layers P0-P2: core, Widget, theme, layout, animation, hooks,
//                input, color, dpi, surface, and widget modules.
//
//  Usage:
//    use std::kaintana::core
//    use std::kaintana::layout::{HStack, VStack}
//    use std::kaintana::theme::{DEFAULT_THEME, KtColor}
//
//  Or import the hub and use qualified paths:
//    use std::kaintana as kt
//    kt::core::KtSession
//
//  This file is updated incrementally as new modules are added.
// ============================================================================

// ── P0: Foundation modules ────────────────────────────────────────────

pub use std::kaintana::core as core
pub use std::kaintana::Widget as Widget
pub use std::kaintana::theme as theme

// ── P1: Layout, Animation, Hooks ──────────────────────────────────────

pub use std::kaintana::layout as layout
pub use std::kaintana::animation as animation
pub use std::kaintana::hooks as hooks

// ── P1: Widgets ───────────────────────────────────────────────────────

pub use std::kaintana::widgets::Button as Button
pub use std::kaintana::widgets::Label as Label
pub use std::kaintana::widgets::ProgressBar as ProgressBar
pub use std::kaintana::widgets::Checkbox as Checkbox
pub use std::kaintana::widgets::Divider as Divider
pub use std::kaintana::widgets::Spinner as Spinner
pub use std::kaintana::widgets::Toggle as Toggle
pub use std::kaintana::widgets::TextInput as TextInput
pub use std::kaintana::widgets::ScrollView as ScrollView

// ── P2: Input, Color, DPI, Surface ────────────────────────────────────

pub use std::kaintana::input as input
pub use std::kaintana::color as color
pub use std::kaintana::dpi as dpi
pub use std::kaintana::surface as surface

// ============================================================================
// kaintana/layout.kn
// ============================================================================
// ============================================================================
//  layout.kn — Layout Composition Components
//  P1-005: HStack, VStack, ZStack, Grid, Spacer, Padding
//
//  Architecture:
//    Pure Kain wrappers over the C-side flexbox solver (box_math.c).
//    NO layout computation in Kain — all math lives in the C substrate.
//    Each component opens a <box kind="stack|grid|spacer|padding"> and
//    sets direction/gap/pad/width/height attributes via JSX that the C
//    attribute table processes into box_math.c layout fields.
//
//  Dependencies:
//    - core.kn: kt_row, kt_end_row, attribute setters, type aliases
//    - theme.kn: KtSpacing, KT_SPACING for spacing defaults
//
//  Rules:
//    1. No layout computation in Kain.
//    2. Spacer uses flex_grow=1 via kind="spacer".
//    3. Grid uses flex-wrap for row wrapping + computed column widths.
//    4. Padding uses individual side overrides when set (>= 0).
//    5. All visual values flow through JSX attributes to C attribute table.
// ============================================================================

use std::kaintana::core as core
use std::kaintana::theme as theme
use std::kaintana::core::KT_DIR_COLUMN

// ============================================================================
//  LAYOUT DIRECTION CONSTANTS
//  Matches KaintanaLayoutDir C enum in kaintana.h
//  These are re-exports from core.kn for convenience in this module.
// ============================================================================

// Direction constants are in core.kn. Use `use std::kaintana::core` and core.KT_DIR_ROW etc.

// ============================================================================
//  JUSTIFY CONTENT CONSTANTS (main-axis alignment)
//  Matches KaintanaJustify C enum in kaintana.h
// ============================================================================

/// Items packed toward start of main axis.
pub const KT_JUSTIFY_FLEX_START:    Int = 0
/// Items packed toward center of main axis.
pub const KT_JUSTIFY_CENTER:        Int = 1
/// Items packed toward end of main axis.
pub const KT_JUSTIFY_FLEX_END:      Int = 2
/// Items evenly distributed, first at start, last at end.
pub const KT_JUSTIFY_SPACE_BETWEEN: Int = 3
/// Items evenly distributed, equal space around each item.
pub const KT_JUSTIFY_SPACE_AROUND:  Int = 4
/// Items evenly distributed, equal space between items and edges.
pub const KT_JUSTIFY_SPACE_EVENLY:  Int = 5

// ============================================================================
//  ALIGN ITEMS CONSTANTS (cross-axis alignment)
//  Matches KaintanaAlign C enum in kaintana.h
// ============================================================================

/// Items stretch to fill container cross size.
pub const KT_ALIGN_STRETCH:    Int = 0
/// Items aligned toward start of cross axis.
pub const KT_ALIGN_FLEX_START: Int = 1
/// Items aligned toward center of cross axis.
pub const KT_ALIGN_CENTER:     Int = 2
/// Items aligned toward end of cross axis.
pub const KT_ALIGN_FLEX_END:   Int = 3
/// Items aligned to their text baseline.
pub const KT_ALIGN_BASELINE:   Int = 4
/// Items use their own alignment (auto).
pub const KT_ALIGN_AUTO:       Int = 5

// ============================================================================
//  HStack — horizontal stack layout
//  Children laid out left-to-right with optional spacing and padding.
//  Wraps <box kind="stack"> with direction=row.
// ============================================================================

/// Horizontal stack: children flow left-to-right.
///
/// Props:
///   spacing  — gap between children in logical points (default KT_SPACING.md)
///   padding  — uniform padding around all children (default 0)
///   alignment — cross-axis alignment (default "center")
///   width    — explicit width in logical points (0 = auto)
///   height   — explicit height in logical points (0 = auto)
///   key      — stable key for reconciliation
component HStack(
    spacing: Float = theme::KT_SPACING.md,
    padding: Float = 0.0,
    alignment: String = "center",
    width: Float = 0.0,
    height: Float = 0.0,
    key: String = "hstack",
):
    render <box kind="stack" key={key} direction={0} gap={spacing} pad={padding} alignment={alignment} width={width} height={height}>
    </box>

// ============================================================================
//  VStack — vertical stack layout
//  Children laid out top-to-bottom with optional spacing and padding.
//  Wraps <box kind="stack"> with direction=column.
// ============================================================================

/// Vertical stack: children flow top-to-bottom.
///
/// Props:
///   spacing  — gap between children in logical points (default KT_SPACING.md)
///   padding  — uniform padding around all children (default 0)
///   alignment — cross-axis alignment (default "center")
///   width    — explicit width in logical points (0 = auto)
///   height   — explicit height in logical points (0 = auto)
///   key      — stable key for reconciliation
component VStack(
    spacing: Float = theme::KT_SPACING.md,
    padding: Float = 0.0,
    alignment: String = "center",
    width: Float = 0.0,
    height: Float = 0.0,
    key: String = "vstack",
):
    render <box kind="stack" key={key} direction={KT_DIR_COLUMN} gap={spacing} pad={padding} alignment={alignment} width={width} height={height}>
    </box>

// ============================================================================
//  ZStack — z-order stack layout
//  Children stacked back-to-front at the same position.
//  Uses the default stack (no direction override) so all children
//  occupy the same bounds and are rendered in declaration order.
// ============================================================================

/// Z-order stack: children stacked back-to-front, same position.
///
/// Props:
///   alignment — cross-axis alignment (default "center")
///   width    — explicit width in logical points (0 = auto)
///   height   — explicit height in logical points (0 = auto)
///   key      — stable key for reconciliation
component ZStack(
    alignment: String = "center",
    width: Float = 0.0,
    height: Float = 0.0,
    key: String = "zstack",
):
    render <box kind="stack" key={key} alignment={alignment} width={width} height={height}>
    </box>

// ============================================================================
//  Grid — multi-column grid layout
//  Children arranged in a row-major grid with `columns` columns.
//  Uses flex-wrap to wrap children to new rows. Each child is sized
//  to fill (100% / columns) of the container width.
//  The C-side box_math.c handles the flex-wrap and percentage-based
//  child sizing. This component sets flex-wrap=wrap and children
//  receive width={100% / columns} from the attribute table.
// ============================================================================

/// Grid: children arranged in a row-major grid with N columns.
///
/// Props:
///   columns  — number of columns (default 2). Each child gets
///              (100% / columns) width automatically.
///   spacing  — gap between children in logical points (default KT_SPACING.md)
///   padding  — uniform padding around the grid (default 0)
///   width    — explicit width in logical points (0 = auto)
///   height   — explicit height in logical points (0 = auto)
///   key      — stable key for reconciliation
component Grid(
    columns: Int = 2,
    spacing: Float = theme::KT_SPACING.md,
    padding: Float = 0.0,
    width: Float = 0.0,
    height: Float = 0.0,
    key: String = "grid",
):
    render <box kind="grid" key={key} direction={0} gap={spacing} pad={padding} width={width} height={height}>
    </box>

// ============================================================================
//  Spacer — flexible space filler
//  Takes remaining space in a flex container via flex_grow.
//  Wraps <box kind="spacer"> which the C substrate interprets
//  as a flex-grow: 1 element.
// ============================================================================

/// Spacer: fills remaining space in a flex container (flex-grow: 1).
///
/// Props:
///   min_size — minimum size in logical points (default 0). The spacer
///              will not shrink below this value.
///   key      — stable key for reconciliation
component Spacer(
    min_size: Float = 0.0,
    key: String = "spacer",
):
    render <box kind="spacer" key={key} width={min_size}>
    </box>

// ============================================================================
//  Padding — insets children by specified padding
//  Wraps children in a padded container. Supports uniform (all) and
//  per-side (left, right, top, bottom) padding values.
//  When a per-side value is specified (>= 0), it overrides 'all'.
// ============================================================================

/// Padding: insets children on all four sides.
///
/// Props:
///   all    — uniform padding on all sides (default KT_SPACING.md)
///   left   — left-side override (-1 = use 'all')
///   right  — right-side override (-1 = use 'all')
///   top    — top-side override (-1 = use 'all')
///   bottom — bottom-side override (-1 = use 'all')
///   key    — stable key for reconciliation
component Padding(
    all: Float = theme::KT_SPACING.md,
    left: Float = -1.0,
    right: Float = -1.0,
    top: Float = -1.0,
    bottom: Float = -1.0,
    width: Float = 0.0,
    height: Float = 0.0,
    key: String = "pad",
):
    state resolved_pad: Float = all

    render <box kind="padding" key={key} pad={resolved_pad} width={width} height={height}>
    </box>

// ============================================================================
// kaintana/surface.kn
// ============================================================================
// ============================================================================
//  surface.kn — Session lifecycle helpers and frame loop runner
//  P2-021: Session lifecycle helpers wrapping kt_make, kt_free, kt_begin,
//          kt_end, kt_present, kt_should_close.
//          SessionConfig struct.
//
//  Design:
//    - make_session wraps kt_make (returns session handle or -1 on failure).
//    - destroy_session is null-safe (handles -1).
//    - Frame loop helpers for caller-managed rendering.
//
//  Declares its own @extern bindings for the session lifecycle C API.
// ============================================================================

use std::kaintana::core::kt_init
use std::kaintana::core::kt_make
use std::kaintana::core::kt_free
use std::kaintana::core::kt_begin
use std::kaintana::core::kt_end
use std::kaintana::core::kt_present
use std::kaintana::core::kt_should_close
use std::kaintana::KtSession

use std::kaintana::core as core

// ═══════════════════════════════════════════════════════════════════════════
//  SessionConfig
// ═══════════════════════════════════════════════════════════════════════════

/// Configuration for creating a Kaintana session.
pub struct SessionConfig:
    title:  String
    width:  Int
    height: Int

/// Default config: 1280x720 "KaintanaApp".
pub const DEFAULT_SESSION_CONFIG: SessionConfig = SessionConfig {
    title:  "KaintanaApp",
    width:  1280,
    height: 720,
}

// ═══════════════════════════════════════════════════════════════════════════
//  Session Lifecycle
// ═══════════════════════════════════════════════════════════════════════════

/// Initialize system and create a session. Returns -1 on failure.
pub fn make_session(config: SessionConfig) -> KtSession:
    kt_init()
    let sid = kt_make(config.title, config.width, config.height)
    return sid

/// Destroy a session. Null-safe.
pub fn destroy_session(s: KtSession):
    kt_free(s)

// ═══════════════════════════════════════════════════════════════════════════
//  Frame Loop Primitives
// ═══════════════════════════════════════════════════════════════════════════

/// Returns true if the session is still running.
pub fn session_running(s: KtSession) -> Bool:
    return kt_should_close(s) == 0

/// Begin a new frame with given delta time in ms.
pub fn begin_frame(s: KtSession, delta_ms: Float):
    kt_begin(s, delta_ms)

/// End command recording for the current frame.
pub fn end_frame(s: KtSession):
    kt_end(s)

/// Present the frame to the screen.
pub fn present_frame(s: KtSession):
    kt_present(s)

// ============================================================================
// kaintana/theme.kn
// ============================================================================
// ============================================================================
//  theme.kn — Kaintana theme system
//  P0-003: Complete color/spacing/theme system.
//
//  Rules:
//  - KtColor uses Float r/g/b/a (0.0-1.0), NOT packed Int.
//  - to_hex() outputs "#RRGGBB" or "#RRGGBBAA" hex strings for C-side kt_fill.
//  - Named colors are String constants, NOT Int constants.
//  - Theme struct fields are String hex values for direct kt_fill() consumption.
//  - NO reverse dependency — core.kn must NOT import theme.kn.
// ============================================================================

use std::fmt
use std::kaintana::core as core

// ============================================================================
//  KtColor — float RGBA color with hex conversion and math
// ============================================================================

/// sRGB color in float [0.0, 1.0] range.
pub struct KtColor:
    r: Float
    g: Float
    b: Float
    a: Float

pub impl KtColor:
    /// Construct KtColor from packed 0xAARRGGBB integer.
    pub fn from_u32(col: Int) -> KtColor:
        let r = ((col >> 16) & 0xFF) as Float / 255.0
        let g = ((col >>  8) & 0xFF) as Float / 255.0
        let b = ((col >>  0) & 0xFF) as Float / 255.0
        let a = ((col >> 24) & 0xFF) as Float / 255.0
        return KtColor { r: r, g: g, b: b, a: a }

    /// Pack to hex string for C-side kt_fill: "#RRGGBB" or "#RRGGBBAA".
    pub fn to_hex(_self: Self_) -> String:
        let r = ((_self.r * 255.0) + 0.5) as Int
        let g = ((_self.g * 255.0) + 0.5) as Int
        let b = ((_self.b * 255.0) + 0.5) as Int
        let a = ((_self.a * 255.0) + 0.5) as Int

        // Clamp to valid u8 range
        let ri = if r < 0: 0 elif r > 255: 255 else: r
        let gi = if g < 0: 0 elif g > 255: 255 else: g
        let bi = if b < 0: 0 elif b > 255: 255 else: b
        let ai = if a < 0: 0 elif a > 255: 255 else: a

        var hex = "#" + hex_byte(ri) + hex_byte(gi) + hex_byte(bi)
        if ai < 255:
            hex = hex + hex_byte(ai)
        return hex

    /// Linear interpolation between two KtColors.
    pub fn lerp(_self: Self_, other: KtColor, t: Float) -> KtColor:
        return KtColor {
            r: _self.r + (other.r - _self.r) * t,
            g: _self.g + (other.g - _self.g) * t,
            b: _self.b + (other.b - _self.b) * t,
            a: _self.a + (other.a - _self.a) * t
        }

    /// Multiply all channels by opacity.
    /// Use this for fade transitions and disabled overlays.
    pub fn with_opacity(_self: Self_, opacity: Float) -> KtColor:
        return KtColor {
            r: _self.r * opacity,
            g: _self.g * opacity,
            b: _self.b * opacity,
            a: _self.a * opacity
        }

    /// Straight-to-premultiplied alpha conversion.
    pub fn premultiplied(_self: Self_) -> KtColor:
        return KtColor {
            r: _self.r * _self.a,
            g: _self.g * _self.a,
            b: _self.b * _self.a,
            a: _self.a
        }

// Private helper: format a single u8 byte as uppercase 2-char hex string.
fn hex_byte(v: Int) -> String:
    var spec = fmt_spec_default()
    spec = fmt_spec_base(spec, FMT_BASE_HEX)
    spec = fmt_spec_uppercase(spec, true)
    spec = fmt_spec_width(spec, 2)
    spec = fmt_spec_pad(spec, "0")
    return fmt_int_spec(v, spec)

