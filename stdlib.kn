const SLOT_MAP_KEY_INDEX_BASE: Int = 1000000000
const SLOT_MAP_INITIAL_GENERATION: Int = 1
const SLOT_MAP_EMPTY: Int = 0
const SLOT_MAP_OCCUPIED: Int = 1
const SLOT_MAP_INVALID_INDEX: Int = -1

pub struct SlotMapKey:
    raw: Int

pub struct SlotMap:
    values: ptr<Int>
    generations: ptr<Int>
    occupied: ptr<Int>
    next_free: ptr<Int>
    capacity: Int
    count: Int
    free_head: Int

