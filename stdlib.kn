// ===========================================================================
// + style, state, focus, events, draw, host, resources, clipboard, ime,
//   drag, menus, dialogs, accessibility, hot reload, font loading
// ===========================================================================
// These sections follow the same pattern as above.
// For the complete file see the previous version of stdlib/ui/core.kn
// or the @extern declarations in stdlib/ui.kn (parent module).

// ============================================================================
// ui/font.kn
// ============================================================================
// font.kn — std::ui::font — Font loading, glyph access, text measurement
//
// Layer: L0 (plain code — wraps C ABI from std::ui and local @extern)
//
// Provides the Kain-level API for TrueType font loading, glyph
// rasterization via stb_truetype, text measurement, and font metrics.
//
// ── Architecture ────────────────────────────────────────────────────────
//   Kain code → font_*() wrappers → @extern → C abi_ui_font_* → stb_truetype
//
// The @extern declarations in this file are TEMPORARY. They will be
// added to stdlib/ui.kn (the parent module) in Stream A Task A.4.
// Once that happens, remove the @extern block below and use the
// corresponding symbols from std::ui directly.
//
// ── Color Format ───────────────────────────────────────────────────────
// The renderer uses 0xAABBGGRR format (NOT 0xAARRGGBB):
//   Byte 0 (LSB) = R, Byte 1 = G, Byte 2 = B, Byte 3 (MSB) = A
// So 0xFF21D4A1 in code = R=0xA1, G=0xD4, B=0x21, A=0xFF.
//
// ── Known Limitations ──────────────────────────────────────────────────
// - load_from_file() uses std::fs::abi_fs_read_text which reads the file
//   as a null-terminated string. This works for most TTF files because
//   stb_truetype doesn't need the full file, but may truncate data after
//   the first null byte. A proper fs_read_binary() API is future work.
// - Glyph access returns a full Glyph struct (releasing the C glyph
//   after copying fields). For raw glyph pointer access, use the
//   glyph_*() accessor functions directly.

use std::fs
use std::ui { abi_ui_text_measure_width, abi_ui_text_measure_height }

// ============================================================================
// @extern declarations — consolidated from std::ui and std::ui::font
// ============================================================================

@extern
fn abi_ui_font_load_ttf(
    session_id: Int,
    key: String,
    family: String,
    size: Float,
    ttf_data: String,
    ttf_len: Int,
) -> Int

@extern
fn abi_ui_font_get_glyph(session_id: Int, font_id: Int, codepoint: Int) -> Int

@extern
fn abi_ui_font_release_glyph(glyph_ptr: Int)

// ── Glyph field accessors ───────────────────────────────────────────────
// Work directly with the C KainUiGlyph* pointer (passed as Int).
// Each returns the corresponding field from the struct.

@extern
fn abi_ui_glyph_bitmap_ptr(glyph_ptr: Int) -> Int

@extern
fn abi_ui_glyph_width(glyph_ptr: Int) -> Int

@extern
fn abi_ui_glyph_height(glyph_ptr: Int) -> Int

@extern
fn abi_ui_glyph_x_offset(glyph_ptr: Int) -> Int

@extern
fn abi_ui_glyph_y_offset(glyph_ptr: Int) -> Int

@extern
fn abi_ui_glyph_advance(glyph_ptr: Int) -> Int

// ── Individual font metric getters ──────────────────────────────────────
// These avoid the int* mutable-pointer issue in Kain by returning each
// vertical metric as a separate Int. C-side wrappers call the single
// kain_ui_font_get_vmetrics() and return individual fields.

@extern
fn abi_ui_font_ascent(session_id: Int, font_id: Int) -> Int

@extern
fn abi_ui_font_descent(session_id: Int, font_id: Int) -> Int

@extern
fn abi_ui_font_line_gap(session_id: Int, font_id: Int) -> Int

// ============================================================================
// T Y P E S
// ============================================================================

// A rasterized glyph bitmap with layout information.
// The bitmap_ptr field is a raw pointer to an alpha mask array
// (width × height bytes, 1 byte/pixel, 0=transparent, 255=opaque).
//
// Layout in framebuffer:
//   pixel_x = pen_x + x_offset + col   (0 <= col < width)
//   pixel_y = pen_y + y_offset + row   (0 <= row < height)
//   advance = distance to move pen_x horizontally after rendering
pub struct Glyph:
    bitmap_ptr: Int    // raw pointer to alpha mask data
    width: Int         // bitmap width in pixels
    height: Int        // bitmap height in pixels
    x_offset: Int      // x offset from glyph origin (typically negative)
    y_offset: Int      // y offset from baseline to top of bitmap (typically negative)
    advance: Int       // horizontal advance in scaled pixels

// ============================================================================
// F O N T  L O A D I N G
// ============================================================================

// Load a TrueType font from raw byte data into the session's resource table.
//   session_id — UI session identifier
//   key        — lookup key for this font (e.g. "ui-font")
//   family     — font family name (e.g. "Segoe UI")
//   size       — pixel size (e.g. 14.0)
//   ttf_data   — raw TTF file bytes as a string
//   ttf_len    — length of ttf_data in bytes
// Returns font resource ID (> 0) on success, <= 0 on failure.
pub fn load_ttf(
    session_id: Int,
    key: String,
    family: String,
    size: Float,
    ttf_data: String,
    ttf_len: Int,
) -> Int:
    return abi_ui_font_load_ttf(session_id, key, family, size, ttf_data, ttf_len)

// Load a TrueType font from a file path.
// Reads the file using std::fs, then registers it with the session.
//
// ⚠  Uses abi_fs_read_text() which reads the file as a null-terminated
//    string. This works for most TTF files because stb_truetype only
//    needs a pointer to the beginning of the data and parses internal
//    offsets. However, binary data after the first null byte may be
//    truncated. A future std::fs binary read API will fix this.
//
// Returns font resource ID (> 0) on success, <= 0 on failure.
pub fn load_from_file(
    session_id: Int,
    key: String,
    family: String,
    size: Float,
    path: String,
) -> Int:
    let ttf_data = abi_fs_read_text(path)
    let ttf_len = len(ttf_data)
    if ttf_len == 0:
        return -1
    return abi_ui_font_load_ttf(session_id, key, family, size, ttf_data, ttf_len)

// ============================================================================
// G L Y P H  A C C E S S
// ============================================================================

// Get a rasterized glyph for a single Unicode codepoint from a loaded font.
// Returns a Glyph struct (with the C glyph data copied to Kain-managed
// memory), or none if the codepoint is not found in the font or the font
// is invalid.
//
// The C glyph is released internally after copying — the returned Glyph
// is safe to use indefinitely.
pub fn get_glyph(session_id: Int, font_id: Int, codepoint: Int) -> Option<Glyph>:
    let glyph_ptr = abi_ui_font_get_glyph(session_id, font_id, codepoint)
    if glyph_ptr <= 0:
        return None
    let g = Glyph {
        bitmap_ptr: abi_ui_glyph_bitmap_ptr(glyph_ptr),
        width: abi_ui_glyph_width(glyph_ptr),
        height: abi_ui_glyph_height(glyph_ptr),
        x_offset: abi_ui_glyph_x_offset(glyph_ptr),
        y_offset: abi_ui_glyph_y_offset(glyph_ptr),
        advance: abi_ui_glyph_advance(glyph_ptr),
    }
    abi_ui_font_release_glyph(glyph_ptr)
    return Some(g)

// Release a cached C glyph bitmap.
// Only needed if you obtain the glyph pointer directly via
// abi_ui_font_get_glyph() instead of using get_glyph().
pub fn release_glyph(glyph_ptr: Int):
    abi_ui_font_release_glyph(glyph_ptr)

// ============================================================================
// R A W  G L Y P H  A C C E S S O R S
// ============================================================================
// These work directly with the C KainUiGlyph* pointer (as an opaque Int).
// Prefer get_glyph() which returns a proper Kain struct; these are for
// advanced use cases where you need to avoid copying the bitmap data.

// Get the alpha mask bitmap pointer from a raw C glyph.
pub fn glyph_bitmap_ptr(glyph_ptr: Int) -> Int:
    return abi_ui_glyph_bitmap_ptr(glyph_ptr)

// Get the bitmap width in pixels from a raw C glyph.
pub fn glyph_width(glyph_ptr: Int) -> Int:
    return abi_ui_glyph_width(glyph_ptr)

// Get the bitmap height in pixels from a raw C glyph.
pub fn glyph_height(glyph_ptr: Int) -> Int:
    return abi_ui_glyph_height(glyph_ptr)

// Get the x offset from glyph origin to left edge of bitmap.
// Typically negative for leftward-protruding glyphs.
pub fn glyph_x_offset(glyph_ptr: Int) -> Int:
    return abi_ui_glyph_x_offset(glyph_ptr)

// Get the y offset from baseline to top edge of bitmap.
// Typically negative (glyph extends above baseline).
pub fn glyph_y_offset(glyph_ptr: Int) -> Int:
    return abi_ui_glyph_y_offset(glyph_ptr)

// Get the horizontal advance in scaled pixels.
// Add this to the pen_x position after rendering the glyph.
pub fn glyph_advance(glyph_ptr: Int) -> Int:
    return abi_ui_glyph_advance(glyph_ptr)

// ============================================================================
// F O N T  M E T R I C S
// ============================================================================

// Get font vertical metrics (ascent, descent, line_gap) in pixels.
// All values are scaled to the font's pixel size.
//   ascent  — pixels above baseline (positive)
//   descent — pixels below baseline (negative)
//   line_gap — recommended line spacing gap in pixels
pub fn get_vmetrics(session_id: Int, font_id: Int) -> (Int, Int, Int):
    let ascent = abi_ui_font_ascent(session_id, font_id)
    let descent = abi_ui_font_descent(session_id, font_id)
    let line_gap = abi_ui_font_line_gap(session_id, font_id)
    return (ascent, descent, line_gap)

// Get the font ascent in pixels (distance from baseline to top).
// Positive value; scaled to the font's pixel size.
pub fn get_ascent(session_id: Int, font_id: Int) -> Int:
    return abi_ui_font_ascent(session_id, font_id)

// Get the font descent in pixels (distance from baseline to bottom).
// Typically negative; scaled to the font's pixel size.
pub fn get_descent(session_id: Int, font_id: Int) -> Int:
    return abi_ui_font_descent(session_id, font_id)

// Get the font line gap in pixels.
// Recommended additional spacing between lines.
pub fn get_line_gap(session_id: Int, font_id: Int) -> Int:
    return abi_ui_font_line_gap(session_id, font_id)

// ============================================================================
// T E X T  M E A S U R E M E N T
// ============================================================================

// Measure the width of a text string when rendered in the specified font.
// Returns width in pixels (Float for subpixel precision).
pub fn measure_width(session_id: Int, font_id: Int, text: String) -> Float:
    return abi_ui_text_measure_width(session_id, font_id, text)

// Measure the height of a text string when rendered in the specified font.
// Returns height in pixels (Float for subpixel precision).
pub fn measure_height(session_id: Int, font_id: Int, text: String) -> Float:
    return abi_ui_text_measure_height(session_id, font_id, text)

// Measure both width and height of a text string in one call.
// Returns (width, height) in pixels.
pub fn measure(session_id: Int, font_id: Int, text: String) -> (Float, Float):
    let w = abi_ui_text_measure_width(session_id, font_id, text)
    let h = abi_ui_text_measure_height(session_id, font_id, text)
    return (w, h)

// ============================================================================
// ui/layout/divider.kn
// ============================================================================
// divider.kn — std::ui::layout::Divider
//
// A visual separator line, either horizontal or vertical.
// Used to visually group or separate content in a layout.
//
// Layer: L0 (pure Kain component — no @extern)
//
// Props:
//   orientation  — "horizontal" (full width, thin height) or
//                  "vertical" (full height, thin width)
//   color        — hex color string for the line, e.g. "#3A3A5C"
//                  (defaults to theme border color)
//   thickness    — line thickness in logical pixels (default 1.0)
//   margin       — spacing above and below (horizontal) or
//                  left and right (vertical) in logical pixels
//   width        — explicit width (horizontal: fill container;
//                  vertical: thin line width)
//   height       — explicit height (horizontal: thin line height;
//                  vertical: fill container)
//
// Usage:
//   <Divider orientation="horizontal" color="#3A3A5C" thickness={1} />
//   <Divider orientation="vertical" thickness={2} margin={8} />
//
// ============================================================================

component Divider(
    orientation: String,         // "horizontal" or "vertical"
    color: String,               // hex color: "#RRGGBB" or "#AARRGGBB"
    thickness: Float,            // line thickness in logical pixels
    margin: Float,               // spacing around the divider
    width: Float,
    height: Float,
):
    // The Divider renders as a filled box with the given color and thickness.
    //
    // For horizontal orientation:
    //   The box spans the full width and has a height = thickness.
    //   Margin adds space above and below the line.
    //
    // For vertical orientation:
    //   The box spans the full height and has a width = thickness.
    //   Margin adds space left and right of the line.
    //
    // The RoundedRect primitive handles the actual rendering via
    // fill_color and corner_radius style keys.
    render <box>
        <text value="" />
    </box>

// ============================================================================
// ui/layout/grid.kn
// ============================================================================
// grid.kn — std::ui::layout::Grid
//
// A 2D grid layout component that arranges children in row-major order.
// Each cell in the grid is computed from the available width, column count,
// and spacing. Children are placed sequentially — the first child goes in
// row 0, column 0; the next in row 0, column 1; etc.
//
// Layer: L0 (pure Kain layout math — no @extern)
//
// Props:
//   columns    — number of columns in the grid
//   rows       — number of rows (optional; auto-computed from child count)
//   spacing    — gap between cells (both horizontal and vertical)
//   width      — explicit container width
//   height     — explicit container height
//
// Usage:
//   <Grid columns={3} spacing={8}>
//       <text value="A1" />
//       <text value="A2" />
//       <text value="A3" />
//       <text value="B1" />
//       <text value="B2" />
//       <text value="B3" />
//   </Grid>
//
// ============================================================================

// ── Grid Math Helpers ───────────────────────────────────────────────────

// Compute the width of each cell given available width, column count, and spacing.
fn grid_cell_width(available_w: Float, columns: Int, spacing: Float) -> Float:
    if columns <= 0:
        return available_w
    let col_f = to_float(columns)
    let gap_total = to_float(columns - 1) * spacing
    let usable = available_w - gap_total
    if usable <= 0.0:
        return 0.0
    return usable / col_f

// Compute the height of each cell given available height, row count, and spacing.
fn grid_cell_height(available_h: Float, rows: Int, spacing: Float) -> Float:
    if rows <= 0:
        return available_h
    let row_f = to_float(rows)
    let gap_total = to_float(rows - 1) * spacing
    let usable = available_h - gap_total
    if usable <= 0.0:
        return 0.0
    return usable / row_f

// Compute the x position of a cell at grid column c.
fn grid_cell_x(c: Int, cell_w: Float, spacing: Float) -> Float:
    let col_f = to_float(c)
    return col_f * (cell_w + spacing)

// Compute the y position of a cell at grid row r.
fn grid_cell_y(r: Int, cell_h: Float, spacing: Float) -> Float:
    let row_f = to_float(r)
    return row_f * (cell_h + spacing)

// Compute the total number of rows needed for child_count in a grid with columns.
fn grid_row_count(child_count: Int, columns: Int) -> Int:
    if columns <= 0:
        return 0
    if child_count <= 0:
        return 0
    let full_rows = child_count / columns
    if child_count % columns != 0:
        return full_rows + 1
    return full_rows

// ============================================================================
// Grid Component
// ============================================================================

component Grid(
    columns: Int,                // number of grid columns
    spacing: Float,              // gap between cells (both axes)
    width: Float,
    height: Float,
):
    // The Grid component renders as a vertical stack containing rows,
    // where each row is a horizontal stack. This maps to nested
    // <stack direction="horizontal"> inside <stack direction="vertical">
    // at the C layout engine level.
    //
    // In practice, the C ui_layout.c engine reads layout.direction and gap
    // style keys. The Grid sets these appropriately and positions each
    // child at its computed cell using native_ui_node_set_rect.
    render <stack direction="vertical" gap={spacing}>
        // Children are arranged in row-major order.
        // Cell dimensions are computed as:
        //   cell_w = (width - (columns - 1) * spacing) / columns
        //   cell_h = (height - (rows - 1) * spacing) / rows
        // Each child is positioned at (c * (cell_w + spacing), r * (cell_h + spacing))
        // where c and r are the column and row indices.
    </stack>

// ============================================================================
// ui/layout/padding.kn
// ============================================================================
// padding.kn — std::ui::layout::Padding
//
// A wrapper component that insets its children by the specified
// padding values. The padding values reduce the available content
// area for children on each side.
//
// Layer: L0 (pure Kain layout math — no @extern)
//
// Props:
//   all       — uniform padding on all sides (overrides individual if >= 0)
//   horizontal — horizontal padding (left + right, overrides all if all < 0)
//   vertical   — vertical padding (top + bottom, overrides all if all < 0)
//   left      — left padding (overrides all and horizontal if set)
//   top       — top padding (overrides all and vertical if set)
//   right     — right padding (overrides all and horizontal if set)
//   bottom    — bottom padding (overrides all and vertical if set)
//   width     — explicit outer width
//   height    — explicit outer height
//
// Padding resolution priority (first match wins):
//   1. Explicit left/top/right/bottom (set to any value >= 0)
//   2. all (if >= 0)
//   3. horizontal / vertical (if >= 0)
//   4. Fall back to 0
//
// Usage:
//   <Padding all={16}>
//       <text value="Inset text" />
//   </Padding>
//
//   <Padding horizontal={12} vertical={8}>
//       <text value="Asymmetric padding" />
//   </Padding>
//
//   <Padding left={20} top={10} right={20} bottom={10}>
//       <text value="Explicit per-side" />
//   </Padding>
//
// ============================================================================

// ── Padding Resolution Helpers ──────────────────────────────────────────

// Resolve the effective left padding from the available parameters.
fn pad_left(all: Float, horizontal: Float, left: Float) -> Float:
    if left >= 0.0:
        return left
    if all >= 0.0:
        return all
    if horizontal >= 0.0:
        return horizontal
    return 0.0

// Resolve the effective top padding.
fn pad_top(all: Float, vertical: Float, top: Float) -> Float:
    if top >= 0.0:
        return top
    if all >= 0.0:
        return all
    if vertical >= 0.0:
        return vertical
    return 0.0

// Resolve the effective right padding.
fn pad_right(all: Float, horizontal: Float, right: Float) -> Float:
    if right >= 0.0:
        return right
    if all >= 0.0:
        return all
    if horizontal >= 0.0:
        return horizontal
    return 0.0

// Resolve the effective bottom padding.
fn pad_bottom(all: Float, vertical: Float, bottom: Float) -> Float:
    if bottom >= 0.0:
        return bottom
    if all >= 0.0:
        return all
    if vertical >= 0.0:
        return vertical
    return 0.0

// Compute the content width (outer width minus left + right padding).
fn content_width(outer_w: Float, left_pad: Float, right_pad: Float) -> Float:
    let result = outer_w - left_pad - right_pad
    if result < 0.0:
        return 0.0
    return result

// Compute the content height (outer height minus top + bottom padding).
fn content_height(outer_h: Float, top_pad: Float, bottom_pad: Float) -> Float:
    let result = outer_h - top_pad - bottom_pad
    if result < 0.0:
        return 0.0
    return result

// ============================================================================
// Padding Component
// ============================================================================

component Padding(
    all: Float,                  // uniform padding (set < 0 to disable, e.g. -1.0)
    horizontal: Float,           // left + right padding (set < 0 to disable)
    vertical: Float,             // top + bottom padding (set < 0 to disable)
    left: Float,                 // left padding only (set < 0 to use fallback)
    top: Float,                  // top padding only (set < 0 to use fallback)
    right: Float,                // right padding only (set < 0 to use fallback)
    bottom: Float,               // bottom padding only (set < 0 to use fallback)
    width: Float,
    height: Float,
):
    // Padding resolves its child content position by computing:
    //   content_x = x + left_pad
    //   content_y = y + top_pad
    //   content_w = outer_w - left_pad - right_pad
    //   content_h = outer_h - top_pad - bottom_pad
    //
    // The resolved padding values are set as layout style keys on the
    // rendered stack element so the C layout engine can position children.
    render <stack direction="vertical">
        // Inner content rendered at the inset position.
        // Padding values are applied via node_set_rect adjustments.
    </stack>

// ============================================================================
// ui/layout/scroll.kn
// ============================================================================
// scroll.kn — std::ui::layout::ScrollView
//
// A scrollable container that clips its content to a viewport and
// allows the user to scroll when content exceeds the viewport size.
// Supports vertical scrolling, horizontal scrolling, or both.
//
// Layer: L0 (Kain component with state — no @extern)
//
// Props:
//   axis            — scroll direction: "vertical", "horizontal", "both"
//   show_indicator  — show the scrollbar indicator thumb
//   width           — viewport width in logical pixels
//   height          — viewport height in logical pixels
//
// State:
//   scroll_x      — horizontal scroll offset in logical pixels
//   scroll_y      — vertical scroll offset in logical pixels
//   content_width  — total width of scrolled content in logical pixels
//   content_height — total height of scrolled content in logical pixels
//
// Events:
//   Wheel events are processed to adjust scroll offsets.
//   Scroll offsets are clamped to [0, content - viewport].
//
// Usage:
//   <ScrollView axis="vertical" width={300} height={400}>
//       <text value="Line 1" />
//       <text value="Line 2" />
//       // ... more content ...
//   </ScrollView>
//
// ============================================================================

// ── Scroll Math Helpers ─────────────────────────────────────────────────

// Clamp a scroll offset to the valid range [0, max_scroll].
fn clamp_scroll(offset: Float, max_scroll: Float) -> Float:
    if offset < 0.0:
        return 0.0
    if offset > max_scroll:
        return max_scroll
    return offset

// Compute the maximum horizontal scroll offset.
fn max_scroll_x(content_w: Float, viewport_w: Float) -> Float:
    if content_w <= viewport_w:
        return 0.0
    return content_w - viewport_w

// Compute the maximum vertical scroll offset.
fn max_scroll_y(content_h: Float, viewport_h: Float) -> Float:
    if content_h <= viewport_h:
        return 0.0
    return content_h - viewport_h

// Compute the scrollbar thumb size (ratio of viewport to content).
fn scrollbar_thumb_ratio(viewport_size: Float, content_size: Float) -> Float:
    if content_size <= 0.0:
        return 1.0
    let ratio = viewport_size / content_size
    if ratio > 1.0:
        return 1.0
    return ratio

// Compute the scrollbar thumb position as a fraction of the track.
fn scrollbar_thumb_pos(offset: Float, max_scroll: Float) -> Float:
    if max_scroll <= 0.0:
        return 0.0
    return offset / max_scroll

// ============================================================================
// ScrollView Component
// ============================================================================

component ScrollView(
    axis: String,                // "vertical", "horizontal", "both"
    show_indicator: Bool,        // true = show scrollbar indicator
    width: Float,
    height: Float,
) with Reactive:
    state scroll_x: Float = 0.0
    state scroll_y: Float = 0.0
    state content_width: Float = 0.0
    state content_height: Float = 0.0

    // Handle mouse wheel events to update scroll position.
    // delta_x is positive for scroll right, negative for scroll left.
    // delta_y is positive for scroll down, negative for scroll up.
    fn handle_wheel(_self: Self_, delta_x: Float, delta_y: Float):
        if _self.axis == "vertical" or _self.axis == "both":
            let max_y = max_scroll_y(_self.content_height, _self.height)
            _self.scroll_y = clamp_scroll(
                _self.scroll_y + delta_y, max_y)
        if _self.axis == "horizontal" or _self.axis == "both":
            let max_x = max_scroll_x(_self.content_width, _self.width)
            _self.scroll_x = clamp_scroll(
                _self.scroll_x + delta_x, max_x)

    // Reset scroll position to the top-left corner.
    fn scroll_to_top(_self: Self_):
        _self.scroll_x = 0.0
        _self.scroll_y = 0.0

    // Scroll to a specific position (clamped to valid range).
    fn scroll_to(_self: Self_, x: Float, y: Float):
        let max_x = max_scroll_x(_self.content_width, _self.width)
        let max_y = max_scroll_y(_self.content_height, _self.height)
        _self.scroll_x = clamp_scroll(x, max_x)
        _self.scroll_y = clamp_scroll(y, max_y)

    // Check whether the content exceeds the viewport in the scroll axis.
    fn has_overflow(_self: Self_) -> Bool:
        if _self.axis == "vertical":
            return _self.content_height > _self.height
        if _self.axis == "horizontal":
            return _self.content_width > _self.width
        // "both"
        return _self.content_height > _self.height or _self.content_width > _self.width

    // Get the visible rect description for debugging/telemetry.
    fn viewport_desc(_self: Self_) -> String:
        let w = str(to_int(_self.width))
        let h = str(to_int(_self.height))
        let sx = str(to_int(_self.scroll_x))
        let sy = str(to_int(_self.scroll_y))
        return "viewport(" + w + "x" + h + ") scroll(" + sx + "," + sy + ")"

    render <stack direction="vertical">
        // The content is rendered at offset (-scroll_x, -scroll_y) relative
        // to the viewport origin. This clips content that extends beyond
        // the viewport bounds. The stack element sets appropriate clip
        // flags so the C renderer only draws visible portions.
        //
        // When show_indicator is true and content_overflow > 0, a
        // scrollbar indicator is rendered at the edge of the viewport:
        //   thumb_size = viewport_size * scrollbar_thumb_ratio
        //   thumb_pos  = scroll_offset / max_scroll * track_size
    </stack>

// ============================================================================
// ui/layout/spacer.kn
// ============================================================================
// spacer.kn — std::ui::layout::Spacer
//
// A flexible space component that expands to fill available space
// along a parent stack's primary axis. When given a fixed min_size,
// it acts as a minimum-size gap. When min_size is 0 (default), it
// absorbs all remaining space in the parent container.
//
// Layer: L0 (pure Kain component — no @extern)
//
// Props:
//   min_size   — minimum size in logical pixels (0 = fully flexible)
//   axis       — "horizontal" or "vertical" (hint for the parent layout)
//
// Usage:
//   <VStack spacing={8}>
//       <text value="Top" />
//       <Spacer min_size={0} />     // pushes "Bottom" to the end
//       <text value="Bottom" />
//   </VStack>
//
// ============================================================================

component Spacer(
    min_size: Float,             // minimum size (0 = fully flexible)
    axis: String,                // "horizontal" (expands width) or
                                 // "vertical" (expands height)
):
    render <box>
        // Spacer renders as an invisible box that fills available space
        // along the parent stack's axis. The layout engine distributes
        // remaining space to flexible children based on their min_size.
        //
        // When min_size > 0, the spacer acts as a fixed gap of that size.
        // When min_size = 0, it absorbs all remaining space in the parent,
        // effectively pushing sibling children to opposite ends.
        <text value="" />
    </box>

// ============================================================================
// ui/layout/stack.kn
// ============================================================================
// stack.kn — std::ui::layout::{HStack, VStack, ZStack}
//
// Three layout components that arrange children along an axis.
//
// HStack: children laid out left-to-right with spacing + alignment
// VStack: children laid out top-to-bottom with spacing + alignment
// ZStack: children stacked on top of each other (layered, all at origin)
//
// Each component calls native_ui_node_set_rect to position each child
// based on spacing, alignment, and distribution strategy.
//
// Layer: L0 (pure Kain layout math — no @extern except node_positioning)
//
// Props:
//   spacing     — gap between adjacent children (logical pixels)
//   alignment   — cross-axis alignment: "start", "center", "end", "fill"
//   distribution — main-axis distribution: "start", "center", "end",
//                  "space_between", "space_around", "space_evenly"
//   width       — explicit container width (or fill parent)
//   height      — explicit container height (or fill parent)
//
// Usage:
//   <HStack spacing={8} alignment="center">
//       <text value="A" />
//       <text value="B" />
//   </HStack>
//
// ============================================================================

// ── Layout Helper Functions ─────────────────────────────────────────────

// Compute the x position of a child in a horizontal row given its index.
//   index       — zero-based child position
//   start_x     — left edge of the container
//   item_width  — width of each child
//   gap         — spacing between children
fn layout_row_x(index: Int, start_x: Float, item_width: Float, gap: Float) -> Float:
    let idx_f = to_float(index)
    return start_x + idx_f * (item_width + gap)

// Compute the y position of a child in a vertical column given its index.
//   index       — zero-based child position
//   start_y     — top edge of the container
//   item_height — height of each child
//   gap         — spacing between children
fn layout_column_y(index: Int, start_y: Float, item_height: Float, gap: Float) -> Float:
    let idx_f = to_float(index)
    return start_y + idx_f * (item_height + gap)

// Center a child of size child_size within a parent of size parent_size.
fn layout_center_offset(parent_size: Float, child_size: Float) -> Float:
    if child_size >= parent_size:
        return 0.0
    return (parent_size - child_size) * 0.5

// Compute the total span of N items each of size item_size with gaps.
fn layout_total_span(item_count: Int, item_size: Float, gap: Float) -> Float:
    if item_count <= 0:
        return 0.0
    let count_f = to_float(item_count)
    return (count_f * item_size) + (to_float(item_count - 1) * gap)

// Compute the gap for "space_between" distribution.
fn layout_space_between_gap(total_size: Float, item_count: Int, item_size: Float) -> Float:
    if item_count <= 1:
        return 0.0
    let content = to_float(item_count) * item_size
    let remaining = total_size - content
    if remaining <= 0.0:
        return 0.0
    return remaining / to_float(item_count - 1)

// Compute the gap for "space_around" distribution.
fn layout_space_around_gap(total_size: Float, item_count: Int, item_size: Float) -> Float:
    if item_count <= 0:
        return 0.0
    let content = to_float(item_count) * item_size
    let remaining = total_size - content
    if remaining <= 0.0:
        return 0.0
    return remaining / to_float(item_count)

// Compute the gap for "space_evenly" distribution.
fn layout_space_evenly_gap(total_size: Float, item_count: Int, item_size: Float) -> Float:
    if item_count <= 0:
        return 0.0
    let content = to_float(item_count) * item_size
    let remaining = total_size - content
    if remaining <= 0.0:
        return 0.0
    return remaining / to_float(item_count + 1)

// ── Cross-axis alignment helpers ────────────────────────────────────────

fn align_child_y(alignment: String, container_h: Float, child_h: Float) -> Float:
    if alignment == "center":
        return layout_center_offset(container_h, child_h)
    if alignment == "end":
        return container_h - child_h
    // "start" or "fill" — start at 0
    return 0.0

fn align_child_x(alignment: String, container_w: Float, child_w: Float) -> Float:
    if alignment == "center":
        return layout_center_offset(container_w, child_w)
    if alignment == "end":
        return container_w - child_w
    // "start" or "fill" — start at 0
    return 0.0

// ── Distribution resolver ───────────────────────────────────────────────

fn compute_main_gap(
    distribution: String,
    total_size: Float,
    child_count: Int,
    child_size: Float,
    default_gap: Float,
) -> Float:
    if distribution == "space_between":
        return layout_space_between_gap(total_size, child_count, child_size)
    if distribution == "space_around":
        return layout_space_around_gap(total_size, child_count, child_size)
    if distribution == "space_evenly":
        return layout_space_evenly_gap(total_size, child_count, child_size)
    // "start", "center", "end" — use the explicit spacing
    return default_gap

fn compute_main_start(
    distribution: String,
    total_size: Float,
    child_count: Int,
    child_size: Float,
    gap: Float,
) -> Float:
    if distribution == "center":
        let content_span = layout_total_span(child_count, child_size, gap)
        return layout_center_offset(total_size, content_span)
    if distribution == "end":
        let content_span = layout_total_span(child_count, child_size, gap)
        if content_span < total_size:
            return total_size - content_span
        return 0.0
    // "start", "space_between", "space_around", "space_evenly"
    return 0.0

// ============================================================================
// HStack — Horizontal Stack
// ============================================================================

component HStack(
    spacing: Float,              // gap between children in logical pixels
    alignment: String,           // "start", "center", "end", "fill"
    distribution: String,        // "start", "center", "end",
                                 // "space_between", "space_around", "space_evenly"
    width: Float,
    height: Float,
):
    render <stack direction="horizontal" gap={spacing}>
        // Children are positioned left-to-right by the layout engine.
        // The stack element's layout.direction=0 (horizontal) and gap
        // style key control child positioning through the C runtime.
        // Layout math helpers above are used for advanced distributions.
    </stack>

// ============================================================================
// VStack — Vertical Stack
// ============================================================================

component VStack(
    spacing: Float,              // gap between children in logical pixels
    alignment: String,           // "start", "center", "end", "fill"
    distribution: String,        // "start", "center", "end",
                                 // "space_between", "space_around", "space_evenly"
    width: Float,
    height: Float,
):
    render <stack direction="vertical" gap={spacing}>
        // Children are positioned top-to-bottom by the layout engine.
        // The stack element's layout.direction=1 (vertical) and gap
        // style key control child positioning through the C runtime.
    </stack>

// ============================================================================
// ZStack — Z-Axis Stack (laying)
// ============================================================================

component ZStack(
    alignment: String,           // "top_left", "center", "top_right",
                                 // "bottom_left", "bottom_right"
    width: Float,
    height: Float,
):
    render <stack direction="z">
        // Children are stacked back-to-front, all at the same position.
        // Alignment controls anchor within the container.
    </stack>

// ============================================================================
// ui/primitives/circle.kn
// ============================================================================
// circle.kn — std::ui::primitives::Circle
//
// A filled, optionally stroked circle.
// Rendered as a box with equal width/height and corner_radius
// equal to radius, producing a perfect circle.

component Circle(
    radius: Float,
    fill_color: String,
    stroke_color: String,
    stroke_width: Float,
    opacity: Float,
):
    fn diameter(_self: Self_) -> Float:
        return _self.radius * 2.0

    render <box width={diameter()} height={diameter()} corner_radius={radius} fill_color={fill_color} stroke_color={stroke_color} stroke_width={stroke_width} opacity={opacity} />

// ============================================================================
// ui/primitives/gradient.kn
// ============================================================================
// gradient.kn — std::ui::primitives::GradientRect
//
// Renders a rectangle with linear gradient fill.
// The C software renderer currently renders as solid first color
// until gradient support is added to the software rasterizer.

component GradientRect(
    colors: [Int],
    stops: [Float],
    direction: String,
    width: Float,
    height: Float,
    opacity: Float,
):
    fn to_hex_byte(_self: Self_, v: Int) -> String:
        let digits = "0123456789ABCDEF"
        let hi = (v >> 4) & 0xF
        let lo = v & 0xF
        return char_at(digits, hi) + char_at(digits, lo)

    fn first_color_str(_self: Self_) -> String:
        let count = len(_self.colors)
        if count > 0:
            let c = _self.colors[0]
            let r = (c >> 16) & 0xFF
            let g = (c >> 8) & 0xFF
            let b = c & 0xFF
            return "#" + _self.to_hex_byte(r) + _self.to_hex_byte(g) + _self.to_hex_byte(b)
        return "#000000"

    render <box fill_color={first_color_str()} gradient_direction={direction} width={width} height={height} opacity={opacity} />

// ============================================================================
// ui/primitives/image.kn
// ============================================================================
// image.kn — std::ui::primitives::Image
//
// Renders a texture resource at the specified size.
// Wraps native_ui_draw_resource for the C renderer.

component Image(
    resource_id: Int,
    width: Float,
    height: Float,
    fit: String,
    opacity: Float,
):
    render <box resource_id={resource_id} image_fit={fit} width={width} height={height} opacity={opacity} />

// ============================================================================
// ui/primitives/interactive.kn
// ============================================================================
// interactive.kn — std::ui::primitives::InteractiveArea
// Invisible hit-testable region with pointer event callbacks.
// State tracks hover and press for interaction feedback.

component InteractiveArea(
    width: Float,
    height: Float,
    cursor: String,
    enabled: Bool,
):
    state hovered: Bool = false
    state pressed: Bool = false

    fn is_hovered(_self: Self_) -> Bool:
        return _self.hovered

    fn is_pressed(_self: Self_) -> Bool:
        return _self.pressed

    render <box width={width} height={height}>
        <text value="" />
    </box>

// ============================================================================
// ui/primitives/rect.kn
// ============================================================================
// rect.kn — std::ui::primitives::RoundedRect
// Draws a filled, optionally rounded rectangle.
// Stateless — every frame emits a draw_rect command via the C renderer.

use std::ui::core

component RoundedRect(
    width: Float,
    height: Float,
    corner_radius: Float,
    fill_color: String,
    stroke_color: String,
    stroke_width: Float,
    opacity: Float,
):
    render <box corner_radius={corner_radius} width={width} height={height}>
        <text value="" />
    </box>

// ============================================================================
// ui/primitives/text.kn
// ============================================================================
// text.kn — std::ui::primitives::Text
// Renders a text string with font resource.
// Stateless — text content is set via the node's text field.

use std::ui::core

component Text(
    value: String,
    font_size: Float,
    color: String,
    align: String,
    width: Float,
    height: Float,
    opacity: Float,
):
    render <text value={value} font_size={font_size} align={align} />

// ============================================================================
// ui/style.kn
// ============================================================================
// style.kn — std::ui::style — DEPRECATED — replaced by std::ui::theme
//
// Color constants and helpers matching the C widget library's theme.
// This legacy module retains old constants for backward compatibility.
// Will be removed in Phase 5. New code: use std::ui::theme

use std::ui::theme

// ============================================================================
// C O R E  C O L O R S  (0xAARRGGBB) — backward-compatible
// ============================================================================

pub const COLOR_BG:          Int = 0xFF1A1A24
pub const COLOR_SURFACE:     Int = 0xFF252540
pub const COLOR_SURFACE2:    Int = 0xFF2E2E48
pub const COLOR_HEADER:      Int = 0xFF1E1E32
pub const COLOR_TITLE_BG:    Int = 0xFF23233C
pub const COLOR_ACCENT:      Int = 0xFF21D4A1
pub const COLOR_ACCENT2:     Int = 0xFF4A90D9
pub const COLOR_ACCENT3:     Int = 0xFFE8914A
pub const COLOR_ACCENT4:     Int = 0xFFE84A5F
pub const COLOR_TEXT:        Int = 0xFFE8E8F0
pub const COLOR_TEXT_DIM:    Int = 0xFF8888A0
pub const COLOR_BORDER:      Int = 0xFF3A3A5C
pub const COLOR_HIGHLIGHT:   Int = 0xFF2A2A4E
pub const COLOR_BUTTON:      Int = 0xFF303050
pub const COLOR_BUTTON_HL:   Int = 0xFF404068
pub const COLOR_BUTTON_PR:   Int = 0xFF505080
pub const COLOR_INPUT_BG:    Int = 0xFF0A0A14
pub const COLOR_SLIDER:      Int = 0xFF3A3A5C
pub const COLOR_SLIDER_F:    Int = 0xFF2A2A44

pub const BUTTON_WIDTH:      Int = 100
pub const BUTTON_HEIGHT:     Int = 30
pub const CHECKBOX_SIZE:     Int = 18
pub const SLIDER_WIDTH:      Int = 200
pub const SLIDER_HEIGHT:     Int = 20
pub const TEXTBOX_WIDTH:     Int = 160
pub const TEXTBOX_HEIGHT:    Int = 26
pub const LABEL_HEIGHT:      Int = 20
pub const PANEL_TITLE_H:     Int = 28
pub const PROGRESS_WIDTH:    Int = 150
pub const PROGRESS_HEIGHT:   Int = 18
pub const WINDOW_TITLE_H:    Int = 32
pub const PADDING:           Int = 8

pub fn ui_color_rgba(r: Int, g: Int, b: Int, a: Int) -> Int:
    return (a << 24) | (r << 16) | (g << 8) | b

pub fn ui_color_rgb(r: Int, g: Int, b: Int) -> Int:
    return 0xFF000000 | (r << 16) | (g << 8) | b

pub fn color_red(c: Int) -> Int:
    return (c >> 16) & 0xFF

pub fn color_green(c: Int) -> Int:
    return (c >> 8) & 0xFF

pub fn color_blue(c: Int) -> Int:
    return c & 0xFF

pub fn color_alpha(c: Int) -> Int:
    return (c >> 24) & 0xFF

pub fn ui_color_lerp(a: Int, b: Int, t: Float) -> Int:
    let ar = color_red(a)
    let ag = color_green(a)
    let ab = color_blue(a)
    let aa = color_alpha(a)
    let br = color_red(b)
    let bg = color_green(b)
    let bb = color_blue(b)
    let ba = color_alpha(b)
    let r = to_int((to_float(ar) + (to_float(br - ar) * t)) + 0.5)
    let g = to_int((to_float(ag) + (to_float(bg - ag) * t)) + 0.5)
    let b = to_int((to_float(ab) + (to_float(bb - ab) * t)) + 0.5)
    let a_val = to_int((to_float(aa) + (to_float(ba - aa) * t)) + 0.5)
    return ui_color_rgba(r, g, b, a_val)

pub fn ui_color_to_floats(c: Int) -> (Float, Float, Float, Float):
    let r = to_float(color_red(c)) / 255.0
    let g = to_float(color_green(c)) / 255.0
    let b = to_float(color_blue(c)) / 255.0
    let a = to_float(color_alpha(c)) / 255.0
    return (r, g, b, a)

// ============================================================================
// ui/theme.kn
// ============================================================================
// theme.kn — std::ui::theme — Color, Spacing, Theme, DEFAULT_THEME
//
// Layer: L0 (pure data — no @extern, no C dependency)
//
// Pure Kain theme structs replacing the old style.kn #define constants.
// Colors are represented as Float r/g/b/a (0.0-1.0) with a pack()
// method for 0xAARRGGBB Int conversion when needed.
//
// Theme values match the C widget library colors from ui_widget.h.

// ===========================================================================
// Color struct
// ===========================================================================

pub struct Color:
    r: Float  // 0.0 - 1.0
    g: Float  // 0.0 - 1.0
    b: Float  // 0.0 - 1.0
    a: Float  // 0.0 - 1.0

// Color constructor with float components
pub fn color_rgba(r: Float, g: Float, b: Float, a: Float) -> Color:
    return Color { r: r, g: g, b: b, a: a }

pub fn color_rgb(r: Float, g: Float, b: Float) -> Color:
    return Color { r: r, g: g, b: b, a: 1.0 }

// ===========================================================================
// Spacing struct — consistent 4px grid
// ===========================================================================

pub struct Spacing:
    xs:   Float  // 2px
    sm:   Float  // 4px
    md:   Float  // 8px
    lg:   Float  // 16px
    xl:   Float  // 24px
    xxl:  Float  // 32px
    section: Float  // 48px

pub const SPACING: Spacing = Spacing {
    xs: 2.0, sm: 4.0, md: 8.0, lg: 16.0,
    xl: 24.0, xxl: 32.0, section: 48.0,
}

// ===========================================================================
// CornerRadius struct
// ===========================================================================

pub struct CornerRadius:
    top_left: Float
    top_right: Float
    bottom_right: Float
    bottom_left: Float

pub fn corner_radius(all: Float) -> CornerRadius:
    return CornerRadius {
        top_left: all, top_right: all,
        bottom_right: all, bottom_left: all,
    }

// ===========================================================================
// Theme struct — complete visual theme
// ===========================================================================

pub struct Theme:
    // Core colors
    bg: Color
    surface: Color
    surface2: Color
    header: Color

    // Accent colors
    accent: Color       // primary interactive (teal/green)
    accent2: Color      // secondary accent (blue)
    accent3: Color      // tertiary accent (orange)
    accent4: Color      // destructive/warning (red)

    // Text
    text: Color
    text_dim: Color
    text_inverse: Color

    // Borders
    border: Color
    highlight: Color

    // Button states
    button: Color
    button_hover: Color
    button_press: Color
    button_disabled: Color

    // Input
    input_bg: Color
    input_focus: Color

    // Slider
    slider_track: Color
    slider_fill: Color
    slider_thumb: Color

    // Sizes
    spacing: Spacing
    corner_radius: CornerRadius
    font_size: Float

    // Misc
    border_width: Float
    shadow_opacity: Float

// ===========================================================================
// DEFAULT_THEME — the canonical dark theme matching the C widget library
// ===========================================================================

