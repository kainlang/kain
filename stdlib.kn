    font_size_md:  Float
    font_size_lg:  Float
    font_size_xl:  Float

    // ── Corner radii ──────────────────────────────────────────────────────
    radius_sm:     Float
    radius_md:     Float
    radius_lg:     Float
    radius_full:   Float

    // ── Animation ─────────────────────────────────────────────────────────
    anim_speed:    Float

