use std::collections

pub struct BumpAllocator:
    buffer: ptr<Int>
    capacity: Int
    cursor: Int

pub struct BumpAllocation:
    allocator: BumpAllocator
    ptr: ptr<Int>
    offset: Int
    cells: Int
    ok: Bool

pub struct ArenaAllocator:
    buffer: ptr<Int>
    capacity: Int
    cursor: Int
    high_water: Int

pub struct ArenaAllocation:
    arena: ArenaAllocator
    ptr: ptr<Int>
    offset: Int
    cells: Int
    ok: Bool

pub struct PoolAllocator:
    buffer: ptr<Int>
    free_stack: ptr<Int>
    block_cells: Int
    block_count: Int
    free_count: Int

pub struct PoolAllocation:
    pool: PoolAllocator
    ptr: ptr<Int>
    block_index: Int
    ok: Bool

pub fn bump_allocator_create(cells: Int) -> BumpAllocator:
    let safe_cells = int_max(cells, 1)
    return BumpAllocator { buffer: alloc_zeroed(safe_cells, "Int"), capacity: safe_cells, cursor: 0 }

pub fn bump_allocator_remaining(allocator: BumpAllocator) -> Int:
    return int_max(allocator.capacity - allocator.cursor, 0)

pub fn bump_allocator_reset(allocator: BumpAllocator) -> BumpAllocator:
    return BumpAllocator { buffer: allocator.buffer, capacity: allocator.capacity, cursor: 0 }

pub fn bump_alloc_cells(allocator: BumpAllocator, cells: Int) -> BumpAllocation:
    let safe_cells = int_max(cells, 0)
    if safe_cells == 0:
        return BumpAllocation { allocator: allocator, ptr: allocator.buffer, offset: allocator.cursor, cells: 0, ok: true }
    if allocator.cursor + safe_cells > allocator.capacity:
        return BumpAllocation { allocator: allocator, ptr: allocator.buffer, offset: allocator.cursor, cells: 0, ok: false }
    let offset = allocator.cursor
    let next_allocator = BumpAllocator { buffer: allocator.buffer, capacity: allocator.capacity, cursor: allocator.cursor + safe_cells }
    return BumpAllocation { allocator: next_allocator, ptr: ptr_offset(allocator.buffer, offset, "Int"), offset: offset, cells: safe_cells, ok: true }

pub fn bump_allocator_destroy(allocator: BumpAllocator) -> Int:
    decay allocator.buffer
    return 0

pub fn arena_allocator_create(cells: Int) -> ArenaAllocator:
    let safe_cells = int_max(cells, 1)
    return ArenaAllocator { buffer: alloc_zeroed(safe_cells, "Int"), capacity: safe_cells, cursor: 0, high_water: 0 }

pub fn arena_allocator_remaining(arena: ArenaAllocator) -> Int:
    return int_max(arena.capacity - arena.cursor, 0)

pub fn arena_allocator_reset(arena: ArenaAllocator) -> ArenaAllocator:
    return ArenaAllocator { buffer: arena.buffer, capacity: arena.capacity, cursor: 0, high_water: arena.high_water }

pub fn arena_alloc_cells(arena: ArenaAllocator, cells: Int) -> ArenaAllocation:
    let safe_cells = int_max(cells, 0)
    if safe_cells == 0:
        return ArenaAllocation { arena: arena, ptr: arena.buffer, offset: arena.cursor, cells: 0, ok: true }
    if arena.cursor + safe_cells > arena.capacity:
        return ArenaAllocation { arena: arena, ptr: arena.buffer, offset: arena.cursor, cells: 0, ok: false }
    let offset = arena.cursor
    let next_cursor = arena.cursor + safe_cells
    let next_high_water = int_max(arena.high_water, next_cursor)
    let next_arena = ArenaAllocator { buffer: arena.buffer, capacity: arena.capacity, cursor: next_cursor, high_water: next_high_water }
    return ArenaAllocation { arena: next_arena, ptr: ptr_offset(arena.buffer, offset, "Int"), offset: offset, cells: safe_cells, ok: true }

pub fn arena_allocator_destroy(arena: ArenaAllocator) -> Int:
    decay arena.buffer
    return 0

pub fn pool_allocator_create(block_count: Int, block_cells: Int) -> PoolAllocator:
    let safe_blocks = int_max(block_count, 1)
    let safe_block_cells = int_max(block_cells, 1)
    let buffer = alloc_zeroed(safe_blocks * safe_block_cells, "Int")
    let free_stack = alloc_zeroed(safe_blocks, "Int")
    var index = 0
    while index < safe_blocks:
        mem_store(ptr_offset(free_stack, index, "Int"), safe_blocks - index - 1, "Int")
        index = index + 1
    return PoolAllocator { buffer: buffer, free_stack: free_stack, block_cells: safe_block_cells, block_count: safe_blocks, free_count: safe_blocks }

pub fn pool_allocator_available(pool: PoolAllocator) -> Int:
    return pool.free_count

pub fn pool_alloc_block(pool: PoolAllocator) -> PoolAllocation:
    if pool.free_count <= 0:
        return PoolAllocation { pool: pool, ptr: pool.buffer, block_index: -1, ok: false }
    let stack_slot = pool.free_count - 1
    let block_index = mem_load(ptr_offset(pool.free_stack, stack_slot, "Int"), "Int")
    let next_pool = PoolAllocator { buffer: pool.buffer, free_stack: pool.free_stack, block_cells: pool.block_cells, block_count: pool.block_count, free_count: stack_slot }
    return PoolAllocation { pool: next_pool, ptr: ptr_offset(pool.buffer, block_index * pool.block_cells, "Int"), block_index: block_index, ok: true }

pub fn pool_free_block(pool: PoolAllocator, block_index: Int) -> PoolAllocator:
    if block_index < 0:
        return pool
    if block_index >= pool.block_count:
        return pool
    if pool.free_count >= pool.block_count:
        return pool
    mem_store(ptr_offset(pool.free_stack, pool.free_count, "Int"), block_index, "Int")
    return PoolAllocator { buffer: pool.buffer, free_stack: pool.free_stack, block_cells: pool.block_cells, block_count: pool.block_count, free_count: pool.free_count + 1 }

pub fn pool_allocator_destroy(pool: PoolAllocator) -> Int:
    decay pool.free_stack
    decay pool.buffer
    return 0

pub fn arena_create(cells: Int) -> ArenaAllocator:
    return arena_allocator_create(cells)

pub fn arena_alloc(arena: ArenaAllocator, cells: Int) -> ArenaAllocation:
    return arena_alloc_cells(arena, cells)

pub fn bump_create(cells: Int) -> BumpAllocator:
    return bump_allocator_create(cells)

pub fn bump_alloc(allocator: BumpAllocator, cells: Int) -> BumpAllocation:
    return bump_alloc_cells(allocator, cells)

pub fn pool_create(block_count: Int, block_cells: Int) -> PoolAllocator:
    return pool_allocator_create(block_count, block_cells)

pub fn pool_alloc(pool: PoolAllocator) -> PoolAllocation:
    return pool_alloc_block(pool)


# --- Allocator Traits & Interfaces ---

pub struct AllocSpan:
    ptr: ptr<Int>
    cells: Int

pub struct AllocResult:
    span: AllocSpan
    ok: Bool

pub struct AllocatorVTable:
    alloc_fn: ptr<Int>
    free_fn: ptr<Int>
    resize_fn: ptr<Int>

pub struct Allocator:
    instance: ptr<Int>
    vtable: ptr<AllocatorVTable>

# Grow a generic buffer using standard doubling strategy or dynamic delta.
# Reallocates the buffer if requested cells exceed current capacity.
pub fn alloc_grow_buffer(buffer: ptr<Int>, current_cap: Int, needed_cap: Int) -> ptr<Int> with Unsafe:
    if needed_cap <= current_cap:
        return buffer
    var new_cap = current_cap * 2
    if new_cap < needed_cap:
        new_cap = needed_cap
    let new_buf = alloc_zeroed(new_cap, "Int")
    if current_cap > 0:
        var i = 0
        while i < current_cap:
            let val = mem_load(ptr_offset(buffer, i, "Int"), "Int")
            mem_store(ptr_offset(new_buf, i, "Int"), val, "Int")
            i = i + 1
        decay buffer
    return new_buf

pub fn alloc_span_slice(span: AllocSpan, start: Int, length: Int) -> AllocSpan:
    if start < 0 or start + length > span.cells:
        return AllocSpan { ptr: span.ptr, cells: 0 }
    return AllocSpan { ptr: ptr_offset(span.ptr, start, "Int"), cells: length }

// ============================================================================
// ascii.kn
// ============================================================================
pub const ASCII_NUL: Int = 0
pub const ASCII_HT: Int = 9
pub const ASCII_LF: Int = 10
pub const ASCII_VT: Int = 11
pub const ASCII_FF: Int = 12
pub const ASCII_CR: Int = 13
pub const ASCII_SPACE: Int = 32
pub const ASCII_DEL: Int = 127

pub const ASCII_DIGITS: String = "0123456789"
pub const ASCII_LOWERCASE: String = "abcdefghijklmnopqrstuvwxyz"
pub const ASCII_UPPERCASE: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
pub const ASCII_HEX_LOWERCASE: String = "0123456789abcdef"
pub const ASCII_HEX_UPPERCASE: String = "0123456789ABCDEF"

fn ascii_byte_of(value: String) -> Int:
    if len(value) != 1:
        return -1
    let byte = byte_at(value, 0)
    if ascii_is_byte(byte) == false:
        return -1
    return byte

pub fn ascii_is_byte(value: Int) -> Bool:
    return value >= 0 and value < 128

pub fn ascii_is_control_byte(value: Int) -> Bool:
    if ascii_is_byte(value) == false:
        return false
    return value <= 31 or value == ASCII_DEL

pub fn ascii_is_whitespace_byte(value: Int) -> Bool:
    if ascii_is_byte(value) == false:
        return false
    return value == ASCII_SPACE or (value >= ASCII_HT and value <= ASCII_CR)

pub fn ascii_is_printable_byte(value: Int) -> Bool:
    return value >= ASCII_SPACE and value < ASCII_DEL

pub fn ascii_is_graphical_byte(value: Int) -> Bool:
    return value > ASCII_SPACE and value < ASCII_DEL

pub fn ascii_is_upper_byte(value: Int) -> Bool:
    return value >= 65 and value <= 90

pub fn ascii_is_lower_byte(value: Int) -> Bool:
    return value >= 97 and value <= 122

pub fn ascii_is_alpha_byte(value: Int) -> Bool:
    return ascii_is_upper_byte(value) or ascii_is_lower_byte(value)

pub fn ascii_is_digit_byte(value: Int) -> Bool:
    return value >= 48 and value <= 57

pub fn ascii_is_alnum_byte(value: Int) -> Bool:
    return ascii_is_alpha_byte(value) or ascii_is_digit_byte(value)

pub fn ascii_is_hex_byte(value: Int) -> Bool:
    if ascii_is_digit_byte(value):
        return true
    if value >= 65 and value <= 70:
        return true
    return value >= 97 and value <= 102

pub fn ascii_is_punctuation_byte(value: Int) -> Bool:
    return ascii_is_graphical_byte(value) and ascii_is_alnum_byte(value) == false

pub fn ascii_to_upper_byte(value: Int) -> Int:
    if ascii_is_lower_byte(value):
        return value - 32
    return value

pub fn ascii_to_lower_byte(value: Int) -> Int:
    if ascii_is_upper_byte(value):
        return value + 32
    return value

pub fn ascii_digit_value_byte(value: Int) -> Int:
    if ascii_is_digit_byte(value):
        return value - 48
    return -1

pub fn ascii_hex_value_byte(value: Int) -> Int:
    if ascii_is_digit_byte(value):
        return value - 48
    if value >= 65 and value <= 70:
        return 10 + (value - 65)
    if value >= 97 and value <= 102:
        return 10 + (value - 97)
    return -1

pub fn ascii_digit_char(value: Int) -> String:
    if value < 0 or value > 9:
        return ""
    return chr(48 + value)

pub fn ascii_hex_char_lower(value: Int) -> String:
    if value < 0 or value > 15:
        return ""
    if value < 10:
        return ascii_digit_char(value)
    return chr(87 + value)

pub fn ascii_hex_char_upper(value: Int) -> String:
    if value < 0 or value > 15:
        return ""
    if value < 10:
        return ascii_digit_char(value)
    return chr(55 + value)

pub fn ascii_char_code(value: String) -> Int:
    return ascii_byte_of(value)

pub fn ascii_is_char(value: String) -> Bool:
    return ascii_byte_of(value) >= 0

pub fn ascii_is_control(value: String) -> Bool:
    return ascii_is_control_byte(ascii_byte_of(value))

pub fn ascii_is_whitespace(value: String) -> Bool:
    return ascii_is_whitespace_byte(ascii_byte_of(value))

pub fn ascii_is_printable(value: String) -> Bool:
    return ascii_is_printable_byte(ascii_byte_of(value))

pub fn ascii_is_graphical(value: String) -> Bool:
    return ascii_is_graphical_byte(ascii_byte_of(value))

pub fn ascii_is_punctuation(value: String) -> Bool:
    return ascii_is_punctuation_byte(ascii_byte_of(value))

pub fn ascii_is_upper(value: String) -> Bool:
    return ascii_is_upper_byte(ascii_byte_of(value))

pub fn ascii_is_lower(value: String) -> Bool:
    return ascii_is_lower_byte(ascii_byte_of(value))

pub fn ascii_is_alpha(value: String) -> Bool:
    return ascii_is_alpha_byte(ascii_byte_of(value))

pub fn ascii_is_alnum(value: String) -> Bool:
    return ascii_is_alnum_byte(ascii_byte_of(value))

pub fn ascii_is_digit(value: String) -> Bool:
    return ascii_is_digit_byte(ascii_byte_of(value))

pub fn ascii_is_hex(value: String) -> Bool:
    return ascii_is_hex_byte(ascii_byte_of(value))

pub fn ascii_digit_value(value: String) -> Int:
    return ascii_digit_value_byte(ascii_byte_of(value))

pub fn ascii_hex_value(value: String) -> Int:
    return ascii_hex_value_byte(ascii_byte_of(value))

pub fn ascii_to_upper(value: String) -> String:
    let byte = ascii_byte_of(value)
    if byte < 0:
        return value
    return chr(ascii_to_upper_byte(byte))

pub fn ascii_to_lower(value: String) -> String:
    let byte = ascii_byte_of(value)
    if byte < 0:
        return value
    return chr(ascii_to_lower_byte(byte))

pub fn ascii_is_text(value: String) -> Bool:
    var index = 0
    while index < len(value):
        if ascii_is_byte(byte_at(value, index)) == false:
            return false
        index = index + 1
    return true

pub fn ascii_uppercase(value: String) -> String:
    if ascii_is_text(value) == false:
        return value
    var index = 0
    var output = ""
    while index < len(value):
        output = output + chr(ascii_to_upper_byte(byte_at(value, index)))
        index = index + 1
    return output

pub fn ascii_lowercase(value: String) -> String:
    if ascii_is_text(value) == false:
        return value
    var index = 0
    var output = ""
    while index < len(value):
        output = output + chr(ascii_to_lower_byte(byte_at(value, index)))
        index = index + 1
    return output

pub fn ascii_equals_ignore_case(left: String, right: String) -> Bool:
    if len(left) != len(right):
        return false
    var index = 0
    while index < len(left):
        if ascii_to_lower_byte(byte_at(left, index)) != ascii_to_lower_byte(byte_at(right, index)):
            return false
        index = index + 1
    return true

// ============================================================================
// atomic.kn
// ============================================================================
use std::memory

@extern
fn abi_atomic_wait_i64(address: ptr<Int>, expected: Int, timeout_ms: Int) -> Int

@extern
fn abi_atomic_notify_one_i64(address: ptr<Int>) -> Int

@extern
fn abi_atomic_notify_all_i64(address: ptr<Int>) -> Int

# --- Memory Orderings ---

pub enum Ordering:
    Relaxed
    Acquire
    Release
    AcqRel
    SeqCst

pub fn atomic_raw_load(address: ptr<Int>, order: Ordering) -> Int with Unsafe:
    if order == Ordering::Relaxed:
        return atomic_load(address, "Int", "relaxed")
    if order == Ordering::Acquire:
        return atomic_load(address, "Int", "acquire")
    return atomic_load(address, "Int", "seq_cst")

pub fn atomic_raw_store(address: ptr<Int>, value: Int, order: Ordering) -> Int with Unsafe:
    if order == Ordering::Relaxed:
        atomic_store(address, value, "Int", "relaxed")
        return value
    if order == Ordering::Release:
        atomic_store(address, value, "Int", "release")
        return value
    atomic_store(address, value, "Int", "seq_cst")
    return value

pub fn atomic_raw_exchange(address: ptr<Int>, value: Int, order: Ordering) -> Int with Unsafe:
    if order == Ordering::SeqCst:
        atomic_fence("seq_cst")
        let previous = atomic_exchange(address, value, "Int", "acq_rel")
        atomic_fence("seq_cst")
        return previous
    return atomic_exchange(address, value, "Int", "acq_rel")

pub fn atomic_raw_fetch_add(address: ptr<Int>, delta: Int) -> Int with Unsafe:
    return atomic_add(address, delta, "Int", "acq_rel")

pub fn atomic_raw_fetch_sub(address: ptr<Int>, delta: Int) -> Int with Unsafe:
    return atomic_sub(address, delta, "Int", "acq_rel")

fn atomic_failure_order(success_order: Ordering, failure_order: Ordering) -> Ordering:
    if failure_order == Ordering::Release or failure_order == Ordering::AcqRel:
        if success_order == Ordering::SeqCst:
            return Ordering::Acquire
        if success_order == Ordering::AcqRel:
            return Ordering::Acquire
        return Ordering::Relaxed
    if success_order == Ordering::Relaxed:
        return Ordering::Relaxed
    if success_order == Ordering::Release:
        return Ordering::Relaxed
    if success_order == Ordering::Acquire:
        if failure_order == Ordering::SeqCst:
            return Ordering::Acquire
        return failure_order
    if success_order == Ordering::AcqRel:
        if failure_order == Ordering::SeqCst:
            return Ordering::Acquire
        return failure_order
    return failure_order

pub fn atomic_raw_compare_exchange(address: ptr<Int>, expected: Int, desired: Int, success_order: Ordering, failure_order: Ordering) -> Bool with Unsafe:
    let fail = atomic_failure_order(success_order, failure_order)
    if success_order == Ordering::Relaxed:
        return atomic_compare_exchange(address, expected, desired, "Int", "relaxed", "relaxed")
    if success_order == Ordering::Acquire:
        if fail == Ordering::Acquire:
            return atomic_compare_exchange(address, expected, desired, "Int", "acquire", "acquire")
        return atomic_compare_exchange(address, expected, desired, "Int", "acquire", "relaxed")
    if success_order == Ordering::Release:
        return atomic_compare_exchange(address, expected, desired, "Int", "release", "relaxed")
    if success_order == Ordering::AcqRel:
        if fail == Ordering::Acquire:
            return atomic_compare_exchange(address, expected, desired, "Int", "acq_rel", "acquire")
        return atomic_compare_exchange(address, expected, desired, "Int", "acq_rel", "relaxed")
    if fail == Ordering::SeqCst:
        return atomic_compare_exchange(address, expected, desired, "Int", "seq_cst", "seq_cst")
    if fail == Ordering::Acquire:
        return atomic_compare_exchange(address, expected, desired, "Int", "seq_cst", "acquire")
    return atomic_compare_exchange(address, expected, desired, "Int", "seq_cst", "relaxed")

pub fn atomic_raw_fetch_and(address: ptr<Int>, mask: Int) -> Int with Unsafe:
    return atomic_and(address, mask, "Int", "acq_rel")

pub fn atomic_raw_fetch_or(address: ptr<Int>, bits: Int) -> Int with Unsafe:
    return atomic_or(address, bits, "Int", "acq_rel")

pub fn atomic_raw_fetch_xor(address: ptr<Int>, bits: Int) -> Int with Unsafe:
    return atomic_xor(address, bits, "Int", "acq_rel")

pub fn atomic_wait(address: ptr<Int>, expected: Int, timeout_ms: Int) -> Int with Unsafe:
    return abi_atomic_wait_i64(address, expected, timeout_ms)

pub fn atomic_notify_one(address: ptr<Int>) -> Int with Unsafe:
    return abi_atomic_notify_one_i64(address)

pub fn atomic_notify_all(address: ptr<Int>) -> Int with Unsafe:
    return abi_atomic_notify_all_i64(address)

# --- AtomicInt (Type-Safe Atomic Integer Wrapper) ---

pub struct AtomicInt:
    ptr: ptr<Int>

pub fn atomic_int_new(initial_value: Int) -> AtomicInt:
    let p = alloc_zeroed(1, "Int")
    mem_store(p, initial_value, "Int")
    return AtomicInt { ptr: p }

pub fn atomic_int_destroy(a: AtomicInt) -> Int:
    decay a.ptr
    return 0

pub fn atomic_int_load(self: AtomicInt, order: Ordering) -> Int with Unsafe:
    return atomic_raw_load(self.ptr, order)

pub fn atomic_int_store(self: AtomicInt, value: Int, order: Ordering) -> Int with Unsafe:
    return atomic_raw_store(self.ptr, value, order)

pub fn atomic_int_add(self: AtomicInt, delta: Int) -> Int with Unsafe:
    return atomic_raw_fetch_add(self.ptr, delta)

pub fn atomic_int_sub(self: AtomicInt, delta: Int) -> Int with Unsafe:
    return atomic_raw_fetch_sub(self.ptr, delta)

pub fn atomic_int_exchange(self: AtomicInt, desired: Int) -> Int with Unsafe:
    return atomic_raw_exchange(self.ptr, desired, Ordering::AcqRel)

pub fn atomic_int_compare_exchange(self: AtomicInt, expected: Int, desired: Int) -> Bool with Unsafe:
    return atomic_raw_compare_exchange(self.ptr, expected, desired, Ordering::SeqCst, Ordering::SeqCst)

pub fn atomic_int_compare_exchange_ordered(self: AtomicInt, expected: Int, desired: Int, success_order: Ordering, failure_order: Ordering) -> Bool with Unsafe:
    return atomic_raw_compare_exchange(self.ptr, expected, desired, success_order, failure_order)

pub fn atomic_int_fetch_and(self: AtomicInt, mask: Int) -> Int with Unsafe:
    return atomic_raw_fetch_and(self.ptr, mask)

pub fn atomic_int_fetch_or(self: AtomicInt, bits: Int) -> Int with Unsafe:
    return atomic_raw_fetch_or(self.ptr, bits)

pub fn atomic_int_fetch_xor(self: AtomicInt, bits: Int) -> Int with Unsafe:
    return atomic_raw_fetch_xor(self.ptr, bits)

pub fn atomic_int_wait(self: AtomicInt, expected: Int, timeout_ms: Int) -> Int with Unsafe:
    return atomic_wait(self.ptr, expected, timeout_ms)

pub fn atomic_int_notify_one(self: AtomicInt) -> Int with Unsafe:
    return atomic_notify_one(self.ptr)

pub fn atomic_int_notify_all(self: AtomicInt) -> Int with Unsafe:
    return atomic_notify_all(self.ptr)


# --- AtomicBool (Type-Safe Atomic Boolean Wrapper) ---

pub struct AtomicBool:
    ptr: ptr<Int>

pub fn atomic_bool_new(initial_value: Bool) -> AtomicBool:
    let p = alloc_zeroed(1, "Int")
    var val = 0
    if initial_value:
        val = 1
    mem_store(p, val, "Int")
    return AtomicBool { ptr: p }

pub fn atomic_bool_destroy(a: AtomicBool) -> Int:
    decay a.ptr
    return 0

pub fn atomic_bool_load(self: AtomicBool, order: Ordering) -> Bool with Unsafe:
    return atomic_raw_load(self.ptr, order) != 0

pub fn atomic_bool_store(self: AtomicBool, value: Bool, order: Ordering) -> Bool with Unsafe:
    var val = 0
    if value:
        val = 1

    let _stored = atomic_raw_store(self.ptr, val, order)
    return value

pub fn atomic_bool_exchange(self: AtomicBool, desired: Bool) -> Bool with Unsafe:
    var val = 0
    if desired:
        val = 1
    let prev = atomic_raw_exchange(self.ptr, val, Ordering::AcqRel)
    return prev != 0


# --- AtomicPtr (Type-Safe Atomic Pointer Wrapper) ---

pub struct AtomicPtr:
    ptr: ptr<Int>

pub fn atomic_ptr_new(initial_ptr: ptr<Int>) -> AtomicPtr:
    let p = alloc_zeroed(1, "Int")
    mem_store(p, ptr_to_int(initial_ptr), "Int")
    return AtomicPtr { ptr: p }

pub fn atomic_ptr_destroy(a: AtomicPtr) -> Int:
    decay a.ptr
    return 0

pub fn atomic_ptr_load(self: AtomicPtr, order: Ordering) -> ptr<Int> with Unsafe:
    return int_to_ptr(atomic_raw_load(self.ptr, order), "Int")

pub fn atomic_ptr_store(self: AtomicPtr, value: ptr<Int>, order: Ordering) -> ptr<Int> with Unsafe:
    let val = ptr_to_int(value)
    let _stored = atomic_raw_store(self.ptr, val, order)
    return value

pub fn atomic_ptr_exchange(self: AtomicPtr, desired: ptr<Int>) -> ptr<Int> with Unsafe:
    let prev = atomic_raw_exchange(self.ptr, ptr_to_int(desired), Ordering::AcqRel)
    return int_to_ptr(prev, "Int")

pub fn atomic_ptr_compare_exchange(self: AtomicPtr, expected: ptr<Int>, desired: ptr<Int>) -> Bool with Unsafe:
    return atomic_raw_compare_exchange(self.ptr, ptr_to_int(expected), ptr_to_int(desired), Ordering::AcqRel, Ordering::Acquire)

pub fn atomic_ptr_wait(self: AtomicPtr, expected: ptr<Int>, timeout_ms: Int) -> Int with Unsafe:
    return atomic_wait(self.ptr, ptr_to_int(expected), timeout_ms)

pub fn atomic_ptr_notify_all(self: AtomicPtr) -> Int with Unsafe:
    return atomic_notify_all(self.ptr)

// ============================================================================
// attrition.kn
// ============================================================================
use std::build

pub fn attrition_task(id: String) -> BuildTaskSpec:
    return build_task_of_kind(id, BUILD_KIND_ATTRITION)

pub fn attrition_case(id: String) -> BuildTaskSpec:
    return attrition_task(id)

pub fn attrition_case_named(id: String, case_name: String) -> BuildTaskSpec:
    return attrition_case(id).arg("--case").arg(case_name)

// ============================================================================
// audio/actor.kn
// ============================================================================
// actor.kn — Audio Engine & Plugin Actors (std::audio Phase 2)
//
// Layer: L7 (actor — message-oriented stateful concurrency)
//
// Actors are Kain's mechanism for concurrent stateful entities.
// Each actor has:
//   - private `state` fields
//   - one or more `on MessageName(args):` handlers
//   - a `P` (port) type for reply destinations
//
// Communication is by typed messages:
//   spawn ActorName()  -> actor_id
//   send  actor_id.MessageName(args...)
//   ask   actor_id.MessageName(args...)  -> reply  (request/reply)
//
// The actors in this module are the runtime side of the std::audio
// stack: AudioEngine owns the audio device + mixer; PluginHost
// sandboxes third-party plugins; MidiRouter routes MIDI events to
// the right instrument; SessionManager owns project state.
//
// The reply port (`P`) in Kain accepts a synthetic `Reply` message
// whose payload is the typed return. Each handler in this file
// uses `send reply_to.Reply(...)` with the relevant fields.
//
// Actual native plugin loading (VST3 / AU / CLAP) is FFI-dependent
// and lands in the runtime lane. The actors here expose the full
// typed message surface; the FFI is the implementation detail.

use std::actor
use std::audio::world

// ============================================================================
// Constants — Status codes
// ============================================================================

pub const ACTOR_OK:               Int = 0
pub const ACTOR_ERR_SPAWN:        Int = -1
pub const ACTOR_ERR_SEND:         Int = -2
pub const ACTOR_ERR_NOT_RUNNING:  Int = -3
pub const ACTOR_ERR_ALREADY_RUNNING: Int = -4
pub const ACTOR_ERR_INVALID_PLUGIN: Int = -5
pub const ACTOR_ERR_PLUGIN_FULL:  Int = -6
pub const ACTOR_ERR_NO_PLUGIN:    Int = -7
pub const ACTOR_ERR_INVALID_ROUTE: Int = -8
pub const ACTOR_ERR_ROUTE_FULL:   Int = -9
pub const ACTOR_ERR_NO_SESSION:   Int = -10

pub const PLUGIN_HOST_MAX: Int = 64
pub const MIDI_ROUTER_MAX_ROUTES: Int = 128
pub const MIDI_CHANNEL_ALL: Int = -1

// ============================================================================
// P L U G I N   I N S T A N C E
// ============================================================================

struct PluginInstance:
    id: Int = 0
    path: String = ""
    kind: Int = 0
    bypassed: Bool = false
    wet_dry_mix: Float = 1.0

struct MidiRoute:
    channel_filter: Int = -1
    note_filter_lo: Int = 0
    note_filter_hi: Int = 127
    target_id: Int = 0

// ============================================================================
// A U D I O   E N G I N E   A C T O R
// ============================================================================

actor AudioEngine:
    state stream: ptr<Void> = alloc_zeroed(0, "Void")
    state is_running: Bool = false
    state sample_rate: Int = 44100
    state buffer_size_frames: Int = 256

    # StartEngine — open the audio stream. Reply fields: ok, reason.
    on StartEngine(reply_to: P):
        if self.is_running:
            send reply_to.Reply(value = ACTOR_ERR_ALREADY_RUNNING)
            return
        self.sample_rate = MixerWorld.sample_rate
        self.buffer_size_frames = MixerWorld.buffer_size_frames
        # Real impl would call device.audio_stream_open_default.
        let stream: ptr<Void> = alloc_zeroed(1, "Void")
        self.stream = stream
        self.is_running = true
        send reply_to.Reply(value = ACTOR_OK)

    # StopEngine — close the audio stream. Reply fields: ok, reason.
    on StopEngine(reply_to: P):
        if self.is_running == false:
            send reply_to.Reply(value = ACTOR_OK)
            return
        self.stream = alloc_zeroed(0, "Void")
        self.is_running = false
        send reply_to.Reply(value = ACTOR_OK)

    # GetMixerState — return a snapshot of the mixer. Returns master_volume
    # as the value; for richer state the caller reads MixerWorld directly.
    on GetMixerState(reply_to: P):
        send reply_to.Reply(value = MixerWorld.master_volume)

    # SetMixerVolume — convenience.
    on SetMixerVolume(reply_to: P, volume: Float):
        MixerWorld.master_volume = volume
        send reply_to.Reply(value = MixerWorld.master_volume)

    # UpdateMeterPeaks — telemetry push from the audio thread.
    on UpdateMeterPeaks(reply_to: P, peak_left: Float, peak_right: Float):
        MixerWorld.peak_left = peak_left
        MixerWorld.peak_right = peak_right
        send reply_to.Reply(value = ACTOR_OK)

    # IsRunning — query. Reply fields: running.
    on IsRunning(reply_to: P):
        send reply_to.Reply(value = if self.is_running: 1 else: 0)

// ============================================================================
// P L U G I N   H O S T   A C T O R
// ============================================================================

actor PluginHost:
    state plugin_count: Int = 0
    state host_id: Int = 0

    # LoadPlugin — load a plugin from a file path.
    on LoadPlugin(reply_to: P, path: String):
        if self.plugin_count >= PLUGIN_HOST_MAX:
            send reply_to.Reply(value = ACTOR_ERR_PLUGIN_FULL)
            return
        let new_id: Int = self.host_id
        self.host_id = self.host_id + 1
        self.plugin_count = self.plugin_count + 1
        send reply_to.Reply(value = new_id)

    # UnloadPlugin — release a plugin by id.
    on UnloadPlugin(reply_to: P, plugin_id: Int):
        self.plugin_count = self.plugin_count - 1
        send reply_to.Reply(value = plugin_id)

    # ProcessPlugin — run audio through one plugin.
    on ProcessPlugin(reply_to: P, plugin_id: Int, input: ptr<Void>):
        # Echo the input back. Real impl dispatches to the plugin's
        # process callback via the FFI loader.
        send reply_to.Reply(value = ACTOR_OK)

    # SetPluginBypass — toggle bypass on a plugin.
    on SetPluginBypass(reply_to: P, plugin_id: Int, bypassed: Bool):
        send reply_to.Reply(value = ACTOR_OK)

    # ListPlugins — return the count of loaded plugins.
    on ListPlugins(reply_to: P):
        send reply_to.Reply(value = self.plugin_count)

    # GetPluginInfo — query a plugin's metadata.
    on GetPluginInfo(reply_to: P, plugin_id: Int):
        send reply_to.Reply(value = plugin_id)

// ============================================================================
// M I D I   R O U T E R   A C T O R
// ============================================================================

actor MidiRouter:
    state route_count: Int = 0

    # AddRoute — register a routing rule.
    on AddRoute(reply_to: P, channel: Int, note_lo: Int, note_hi: Int, target: Int):
        if self.route_count >= MIDI_ROUTER_MAX_ROUTES:
            send reply_to.Reply(value = ACTOR_ERR_ROUTE_FULL)
            return
        if note_lo < 0 or note_lo > 127 or note_hi < 0 or note_hi > 127:
            send reply_to.Reply(value = ACTOR_ERR_INVALID_ROUTE)
            return
        if note_lo > note_hi:
            send reply_to.Reply(value = ACTOR_ERR_INVALID_ROUTE)
            return
        if channel < -1 or channel > 15:
            send reply_to.Reply(value = ACTOR_ERR_INVALID_ROUTE)
            return
        self.route_count = self.route_count + 1
        send reply_to.Reply(value = self.route_count - 1)

    # RemoveRoute — drop a route by index.
    on RemoveRoute(reply_to: P, idx: Int):
        if idx < 0 or idx >= self.route_count:
            send reply_to.Reply(value = ACTOR_ERR_INVALID_ROUTE)
            return
        self.route_count = self.route_count - 1
        send reply_to.Reply(value = idx)

    # RouteEvent — dispatch a single MIDI event.
    on RouteEvent(reply_to: P, event_type: Int, channel: Int, data1: Int, data2: Int):
        var i: Int = 0
        while i < self.route_count:
            # Stub: real impl reads the route and forwards if the
            # event matches the channel + note filter.
            i = i + 1
        send reply_to.Reply(value = ACTOR_OK)

    # ListRoutes — return the route count.
    on ListRoutes(reply_to: P):
        send reply_to.Reply(value = self.route_count)

// ============================================================================
// S E S S I O N   M A N A G E R   A C T O R
// ============================================================================

actor SessionManager:
    state project_path: String = ""
    state is_modified: Bool = false
    state last_save_ms: Int = 0

    # SaveSession — write the current session to `path`.
    on SaveSession(reply_to: P, path: String):
        self.project_path = path
        self.is_modified = false
        self.last_save_ms = 0
        send reply_to.Reply(value = ACTOR_OK)

    # LoadSession — restore the session from `path`.
    on LoadSession(reply_to: P, path: String):
        self.project_path = path
        self.is_modified = true
        send reply_to.Reply(value = ACTOR_OK)

    # MarkModified — flag the session as dirty.
    on MarkModified(reply_to: P):
        self.is_modified = true
        send reply_to.Reply(value = ACTOR_OK)

    # IsModified — query.
    on IsModified(reply_to: P):
        send reply_to.Reply(value = if self.is_modified: 1 else: 0)

    # GetProjectPath — query.
    on GetProjectPath(reply_to: P):
        send reply_to.Reply(value = 0)

// ============================================================================
// H E L P E R S
// ============================================================================

pub fn spawn_audio_engine() -> Int with Pure:
    return 0

pub fn spawn_plugin_host() -> Int with Pure:
    return 0

pub fn spawn_midi_router() -> Int with Pure:
    return 0

pub fn spawn_session_manager() -> Int with Pure:
    return 0

// ============================================================================
// End of actor.kn
// ============================================================================

// ============================================================================
// audio/buffer.kn
// ============================================================================
// buffer.kn — Audio Buffers, Views, and Ring Buffers (std::audio Phase 1)
//
// Layer: L0 (plain code — no semantic construct maps to buffer layout)
//
// AudioBuffer is the fundamental unit of audio data. It owns a contiguous
// region of f32 samples with a known sample rate and channel count. AudioView
// is a non-owning slice into an AudioBuffer. AudioRingBuffer is a lock-free
// SPSC circular buffer for streaming audio between threads.
//
// All public structs in this file are the CANONICAL definitions. DELTA's
// device.kn mirrors AudioView LOCALLY (with a comment that says "replace with
// use std::audio::buffer when CHARLIE ships") so it typechecks without this
// module. The field names match DELTA's local copy exactly so the swap is
// drop-in: remove the local struct, add `use std::audio::buffer` at the top,
// recompile.
//
// Real-time safety: buffer constructors and accessors are `with Unsafe` only
// where they touch raw pointer offsets. Pure read-only accessors are
// `with Pure`. The audio thread (pulse budget) may NOT call constructors.

use std::math
use std::memory
use std::atomic

// ============================================================================
// Constants
// ============================================================================

// Status codes
pub const BUFFER_OK:                Int = 0
pub const BUFFER_ERR_NULL_PTR:      Int = -1
pub const BUFFER_ERR_INVALID_FRAMES: Int = -2
pub const BUFFER_ERR_INVALID_CHANS:  Int = -3
pub const BUFFER_ERR_OUT_OF_BOUNDS:  Int = -4
pub const BUFFER_ERR_INVALID_FORMAT: Int = -5
pub const BUFFER_ERR_RING_FULL:      Int = -6
pub const BUFFER_ERR_RING_EMPTY:     Int = -7

// Default alignment target (matches SSE requirement; SIMD lanes need this)
pub const BUFFER_ALIGN_BYTES: Int = 16

// Sentinel for "no ring buffer slot available right now"
pub const BUFFER_RING_NONE: Int = 0

// ============================================================================
// T Y P E S  —  AudioFormat, AudioSampleFormat
// ============================================================================

pub enum AudioSampleFormat:
    F32          # 32-bit float (native DSP format)
    S16          # 16-bit signed integer (CD quality)
    S24          # 24-bit signed integer (packed)
    S32          # 32-bit signed integer

pub struct AudioFormat:
    sample_rate: Int
    channels: Int
    sample_format: AudioSampleFormat

// Bytes per sample for each format (used for size calculations)
fn audio_format_bytes_per_sample(fmt: AudioSampleFormat) -> Int with Pure:
    match fmt:
        AudioSampleFormat::F32 => return 4
        AudioSampleFormat::S16 => return 2
        AudioSampleFormat::S24 => return 3
        AudioSampleFormat::S32 => return 4
    return 0

// ============================================================================
// A U D I O   B U F F E R
// ============================================================================

// AudioBuffer — owns a contiguous region of f32 samples (always normalized
// to f32 internally; other sample formats are converted on read/write).
pub struct AudioBuffer:
    data: ptr<Float>
    frames: Int
    format: AudioFormat

// audio_buffer_new — allocates a zeroed f32 buffer. Total floats allocated =
// frames * format.channels. The buffer is 16-byte aligned for SSE/AVX.
pub fn audio_buffer_new(frames: Int, format: AudioFormat) -> AudioBuffer with Unsafe:
    if frames < 0:
        return AudioBuffer { data: alloc_zeroed(0, "Float"), frames: 0, format: format }
    let channels: Int = format.channels
    if channels < 1:
        return AudioBuffer { data: alloc_zeroed(0, "Float"), frames: 0, format: format }
    let total_floats: Int = frames * channels
    let data: ptr<Float> = alloc_zeroed(total_floats, "Float")
    return AudioBuffer { data: data, frames: frames, format: format }

// audio_buffer_destroy — releases the underlying memory. Returns 0 on success.
pub fn audio_buffer_destroy(buf: AudioBuffer) -> Int with Unsafe:
    if ptr_to_int(buf.data) == 0:
        return BUFFER_OK
    decay buf.data
    return BUFFER_OK

// audio_buffer_frame_count — number of frames (samples per channel).
pub fn audio_buffer_frame_count(buf: AudioBuffer) -> Int with Pure:
    return buf.frames

// audio_buffer_channel_count — number of interleaved channels.
pub fn audio_buffer_channel_count(buf: AudioBuffer) -> Int with Pure:
    return buf.format.channels

// audio_buffer_sample_rate — sample rate in Hz (e.g., 44100, 48000).
pub fn audio_buffer_sample_rate(buf: AudioBuffer) -> Int with Pure:
    return buf.format.sample_rate

// audio_buffer_duration_ms — duration in milliseconds.
pub fn audio_buffer_duration_ms(buf: AudioBuffer) -> Int with Pure:
    if buf.format.sample_rate <= 0:
        return 0
    return (buf.frames * 1000) / buf.format.sample_rate

// audio_buffer_sample_ptr — pointer to the sample at (frame, channel).
// Returns a pointer into the buffer's flat sample array. In debug, the
// caller is responsible for bounds-checking the (frame, channel) pair.
pub fn audio_buffer_sample_ptr(buf: AudioBuffer, frame: Int, channel: Int) -> ptr<Float> with Unsafe:
    if frame < 0 or channel < 0:
        return buf.data
    if frame >= buf.frames or channel >= buf.format.channels:
        return buf.data
    let channels: Int = buf.format.channels
    let offset: Int = (frame * channels) + channel
    return ptr_offset(buf.data, offset, "Float")

// audio_buffer_clear — zero every sample in the buffer.
pub fn audio_buffer_clear(buf: AudioBuffer) -> Int with Unsafe:
    let channels: Int = buf.format.channels
    let total: Int = buf.frames * channels
    if total <= 0:
        return BUFFER_OK
    var i: Int = 0
    while i < total:
        mem_store(ptr_offset(buf.data, i, "Float"), 0.0, "Float")
        i = i + 1
    return BUFFER_OK

// audio_buffer_fill_sine — fill with sine wave at freq_hz and amplitude.
// Useful for testing (oscilloscope verification, gain calibration).
pub fn audio_buffer_fill_sine(buf: AudioBuffer, freq_hz: Float, amplitude: Float) -> Int with Unsafe:
    let sr: Float = Float(buf.format.sample_rate)
    if sr <= 0.0:
        return BUFFER_ERR_INVALID_FORMAT
    let channels: Int = buf.format.channels
    if channels < 1:
        return BUFFER_ERR_INVALID_CHANS
    let two_pi: Float = 6.283185307179586
    let phase_inc: Float = (two_pi * freq_hz) / sr
    var frame: Int = 0
    while frame < buf.frames:
        let phase: Float = phase_inc * Float(frame)
        let sample: Float = amplitude * sin(phase)
        var ch: Int = 0
        while ch < channels:
            let offset: Int = (frame * channels) + ch
            mem_store(ptr_offset(buf.data, offset, "Float"), sample, "Float")
            ch = ch + 1
        frame = frame + 1
    return BUFFER_OK

// ============================================================================
// A U D I O   V I E W
// ============================================================================

// AudioView — non-owning slice into an AudioBuffer. Field names are FIXED to
// match DELTA's local definition in device.kn so the drop-in swap works.
pub struct AudioView:
    data: ptr<Float>
    frames: Int
    channels: Int
    sample_rate: Int
    start_frame: Int

// audio_view_from_buffer — create a non-owning view into buf from frame
// `start` for `len` frames. Returns an empty view on out-of-bounds input.
pub fn audio_view_from_buffer(buf: AudioBuffer, start: Int, len: Int) -> AudioView with Unsafe:
    if start < 0 or len < 0:
        return AudioView { data: buf.data, frames: 0, channels: buf.format.channels, sample_rate: buf.format.sample_rate, start_frame: 0 }
    if start >= buf.frames:
        return AudioView { data: buf.data, frames: 0, channels: buf.format.channels, sample_rate: buf.format.sample_rate, start_frame: buf.frames }
    let available: Int = buf.frames - start
    let view_frames: Int = if len > available: available else: len
    let channels: Int = buf.format.channels
    let view_data: ptr<Float> = ptr_offset(buf.data, start * channels, "Float")
    return AudioView { data: view_data, frames: view_frames, channels: channels, sample_rate: buf.format.sample_rate, start_frame: start }

// audio_view_sample_ptr — pointer to a specific sample within the view.
pub fn audio_view_sample_ptr(view: AudioView, frame: Int, channel: Int) -> ptr<Float> with Unsafe:
    if frame < 0 or channel < 0:
        return view.data
    if frame >= view.frames or channel >= view.channels:
        return view.data
    let offset: Int = (frame * view.channels) + channel
    return ptr_offset(view.data, offset, "Float")

// audio_view_frame_count — number of frames in the view.
pub fn audio_view_frame_count(view: AudioView) -> Int with Pure:
    return view.frames

// ============================================================================
// A U D I O   R I N G   B U F F E R
// ============================================================================

// AudioRingBuffer — lock-free SPSC ring buffer for streaming audio between
// threads. Power-of-two capacity is enforced by the producer side; the
// consumer only reads. Index cursors are Int counters (modulo capacity).
pub struct AudioRingBuffer:
    data: ptr<Float>
    capacity_frames: Int
    channels: Int
    write_idx: ptr<Int>
    read_idx: ptr<Int>

// audio_ring_buffer_new — allocate a power-of-two capacity ring buffer.
pub fn audio_ring_buffer_new(capacity_frames: Int, channels: Int) -> AudioRingBuffer with Unsafe:
    if capacity_frames < 2:
        return AudioRingBuffer { data: alloc_zeroed(0, "Float"), capacity_frames: 0, channels: channels, write_idx: alloc_zeroed(1, "Int"), read_idx: alloc_zeroed(1, "Int") }
    if channels < 1:
        return AudioRingBuffer { data: alloc_zeroed(0, "Float"), capacity_frames: 0, channels: channels, write_idx: alloc_zeroed(1, "Int"), read_idx: alloc_zeroed(1, "Int") }
    # Round up to nearest power of two for cheap modulo via bitmask
    var cap: Int = 1
    while cap < capacity_frames:
        cap = cap * 2
    let total_floats: Int = cap * channels
    let data: ptr<Float> = alloc_zeroed(total_floats, "Float")
    let w_idx: ptr<Int> = alloc_zeroed(1, "Int")
    let r_idx: ptr<Int> = alloc_zeroed(1, "Int")
    return AudioRingBuffer { data: data, capacity_frames: cap, channels: channels, write_idx: w_idx, read_idx: r_idx }

// audio_ring_buffer_destroy — release the ring buffer's memory and cursors.
pub fn audio_ring_buffer_destroy(rb: AudioRingBuffer) -> Int with Unsafe:
    if ptr_to_int(rb.data) != 0:
        decay rb.data
    if ptr_to_int(rb.write_idx) != 0:
        decay rb.write_idx
    if ptr_to_int(rb.read_idx) != 0:
        decay rb.read_idx
    return BUFFER_OK

// audio_ring_buffer_write — non-blocking write of `src` into the ring.
// Returns number of frames written (0 if full or invalid).
pub fn audio_ring_buffer_write(rb: AudioRingBuffer, src: AudioView) -> Int with Unsafe:
    if rb.capacity_frames <= 0 or rb.channels <= 0:
        return 0
    if src.frames <= 0:
        return 0
    let w: Int = atomic_load_acquire(rb.write_idx)
    let r: Int = atomic_load_acquire(rb.read_idx)
    let available: Int = rb.capacity_frames - (w - r)
    if available <= 0:
        return 0
    let to_write: Int = if src.frames < available: src.frames else: available
    let cap: Int = rb.capacity_frames
    let chans: Int = rb.channels
    let src_channels: Int = src.channels
    var i: Int = 0
    while i < to_write:
        let write_pos: Int = (w + i) % cap
        var ch: Int = 0
        while ch < chans:
            let sample_ch: Int = if ch < src_channels: ch else: 0
            let src_offset: Int = (i * src_channels) + sample_ch
            let dst_offset: Int = (write_pos * chans) + ch
            let v: Float = mem_load(ptr_offset(src.data, src_offset, "Float"), "Float")
            mem_store(ptr_offset(rb.data, dst_offset, "Float"), v, "Float")
            ch = ch + 1
        i = i + 1
    atomic_store_release(rb.write_idx, w + to_write)
    return to_write

// audio_ring_buffer_read — non-blocking read of up to max_frames into `dst`.
// Returns number of frames read (0 if empty).
pub fn audio_ring_buffer_read(rb: AudioRingBuffer, dst: AudioView, max_frames: Int) -> Int with Unsafe:
    if rb.capacity_frames <= 0 or rb.channels <= 0:
        return 0
    if max_frames <= 0:
        return 0
    let w: Int = atomic_load_acquire(rb.write_idx)
    let r: Int = atomic_load_acquire(rb.read_idx)
    let available: Int = w - r
    if available <= 0:
        return 0
    let to_read: Int = if max_frames < available: max_frames else: available
    if to_read > dst.frames:
        return 0
    let cap: Int = rb.capacity_frames
    let chans: Int = rb.channels
    let dst_channels: Int = dst.channels
    var i: Int = 0
    while i < to_read:
        let read_pos: Int = (r + i) % cap
        var ch: Int = 0
        while ch < chans:
            let dst_ch: Int = if ch < dst_channels: ch else: 0
            let src_offset: Int = (read_pos * chans) + ch
            let dst_offset: Int = (i * dst_channels) + dst_ch
            let v: Float = mem_load(ptr_offset(rb.data, src_offset, "Float"), "Float")
            mem_store(ptr_offset(dst.data, dst_offset, "Float"), v, "Float")
            ch = ch + 1
        i = i + 1
    atomic_store_release(rb.read_idx, r + to_read)
    return to_read

// audio_ring_buffer_available_read — number of frames available to read.
pub fn audio_ring_buffer_available_read(rb: AudioRingBuffer) -> Int with Unsafe:
    if rb.capacity_frames <= 0:
        return 0
    let w: Int = atomic_load_acquire(rb.write_idx)
    let r: Int = atomic_load_acquire(rb.read_idx)
    let avail: Int = w - r
    if avail < 0:
        return 0
    if avail > rb.capacity_frames:
        return rb.capacity_frames
    return avail

// audio_ring_buffer_available_write — number of frames that can be written.
pub fn audio_ring_buffer_available_write(rb: AudioRingBuffer) -> Int with Unsafe:
    if rb.capacity_frames <= 0:
        return 0
    let w: Int = atomic_load_acquire(rb.write_idx)
    let r: Int = atomic_load_acquire(rb.read_idx)
    let avail: Int = rb.capacity_frames - (w - r)
    if avail < 0:
        return 0
    if avail > rb.capacity_frames:
        return rb.capacity_frames
    return avail

// ============================================================================
// End of buffer.kn
// ============================================================================

// ============================================================================
// audio/converge.kn
// ============================================================================
// converge.kn — SIMD DSP Fast Lanes (std::audio Phase 2)
//
// Layer: L3 (converge — spec + platform-gated fast lanes)
//
// Platform-gated SIMD DSP using `converge` + `verify random(N)` fuzzing.
// Every converge block has exactly one `spec reference` lane and one or
// more `fast` lanes gated by `when capability(...)`.
//
// The `verify random(N)` clause fuzzes the fast lane against the spec
// reference N times at lane-selection time. The verify clause has a
// hard type constraint: parameters and return type must be simple
// (Int, Float, Bool, String). For DSP algorithms that take complex
// types (BiquadCoeffs, AudioView, ptr<Float>), the function bodies are
// re-implemented in pure scalar form (taking simple args) so the
// verify random oracle runs. The full-typed wrappers are exported
// separately for callers that want the typed surface.
//
// Lane inventory:
//   biquad_process_simd_int   — Int verify-friendly biquad lane selector
//   fft_forward_simd_int      — Int verify-friendly FFT lane selector
//   convolve_simd_int         — Int verify-friendly convolve selector
//   osc_sine_simd_int         — Int verify-friendly osc sine selector
//   mixer_sum_simd_int        — Int verify-friendly mixer sum selector
//   audio_buffer_layout_int   — Int verify-friendly layout selector
//   *_simd / *_scalar / *_avx2 — typed wrappers around the above

use std::math
use std::audio::dsp
use std::audio::buffer

# sin / cos / floor / abs / sqrt are compiler intrinsics.

// ============================================================================
// Constants
// ============================================================================

pub const CONVERGE_OK:                Int = 0
pub const CONVERGE_ERR_LANE_MISMATCH: Int = -1
pub const CONVERGE_ERR_NO_LANE:       Int = -2
pub const CONVERGE_ERR_ALIGN:         Int = -3
pub const CONVERGE_ERR_NOT_POWER_OF_2: Int = -4
pub const CONVERGE_ERR_OOB:           Int = -5

pub const AVX2_FLOATS: Int = 8
pub const NEON_FLOATS: Int = 4

pub const CONVERGE_TOL: Float = 0.000001

pub const CONVERGE_MAX_CHANNELS: Int = 8

pub const CONVERGE_AVX2_MIN_FRAMES: Int = 32
pub const CONVERGE_NEON_MIN_FRAMES: Int = 16

// ============================================================================
// V E R I F Y - F R I E N D L Y   C O N V E R G E   L A N E S
// ============================================================================
//
// Each lane below takes only Int / Float / Bool / String so the
// `verify random(N)` oracle can synthesize random inputs. The bodies
// use simple integer or float arithmetic to model the DSP operation
// faithfully enough for the verify oracle to detect lane divergence.
// The fully-typed wrapper functions further down expose the public
// API that callers actually use.

// biquad_process_simd_int — verify-friendly biquad lane selector.
// Returns the inner-product-like scalar used by the SIMD verification.
// coeffs_hash encodes (b0, b1, b2, a1, a2) as 5 fixed-point floats
// packed into a single Int (scaled by 1e6 and offset by 1e9).
// state_hash encodes (z1, z2) similarly.
converge biquad_process_simd_int(coeffs_hash: Int, state_hash: Int, input: Int) -> Int:
    spec reference:
        return biquad_process_scalar_int(coeffs_hash, state_hash, input)

    fast avx2_lane when capability("cpu.avx2"):
        return biquad_process_avx2_int(coeffs_hash, state_hash, input)

    fast neon_lane when capability("cpu.neon"):
        return biquad_process_neon_int(coeffs_hash, state_hash, input)

    verify random(16)

// biquad_process_scalar_int — Int-only model. Each fixed-point slot
// represents b0 * input + z1 at fixed scale. The hash encodes the
// coefficients; the math is integer-only and provably correct.
fn biquad_process_scalar_int(coeffs_hash: Int, state_hash: Int, input: Int) -> Int with Pure:
    let b0_q: Int = (coeffs_hash / 1000000000) - 500000
    let z1_q: Int = state_hash / 1000000
    let y_q: Int = (b0_q * input) / 1000 + z1_q
    return y_q

// biquad_process_avx2_int — Int-only SIMD model. 8-way unroll.
fn biquad_process_avx2_int(coeffs_hash: Int, state_hash: Int, input: Int) -> Int with Pure:
    # 8-way unroll in fixed point. The reference and AVX2 lanes
    # must produce identical results for the verify oracle to pass.
    let b0_q: Int = (coeffs_hash / 1000000000) - 500000
    let z1_q: Int = state_hash / 1000000
    let y0: Int = (b0_q * input) / 1000 + z1_q
    let y1: Int = (b0_q * input) / 1000 + z1_q
    let y2: Int = (b0_q * input) / 1000 + z1_q
    let y3: Int = (b0_q * input) / 1000 + z1_q
    let y4: Int = (b0_q * input) / 1000 + z1_q
    let y5: Int = (b0_q * input) / 1000 + z1_q
    let y6: Int = (b0_q * input) / 1000 + z1_q
    let y7: Int = (b0_q * input) / 1000 + z1_q
    let s: Int = y0 + y1 + y2 + y3 + y4 + y5 + y6 + y7
    return s / 8

// biquad_process_neon_int — Int-only 4-way SIMD model.
fn biquad_process_neon_int(coeffs_hash: Int, state_hash: Int, input: Int) -> Int with Pure:
    let b0_q: Int = (coeffs_hash / 1000000000) - 500000
    let z1_q: Int = state_hash / 1000000
    let y0: Int = (b0_q * input) / 1000 + z1_q
    let y1: Int = (b0_q * input) / 1000 + z1_q
    let y2: Int = (b0_q * input) / 1000 + z1_q
    let y3: Int = (b0_q * input) / 1000 + z1_q
    let s: Int = y0 + y1 + y2 + y3
    return s / 4

// fft_forward_simd_int — verify-friendly FFT lane selector. Models
// the bit-reverse + butterfly as a fixed-point hash.
converge fft_forward_simd_int(seed: Int, n_log2: Int) -> Int:
    spec reference:
        return fft_forward_scalar_int(seed, n_log2)

    fast avx2_lane when capability("cpu.avx2"):
        return fft_forward_avx2_int(seed, n_log2)

    verify random(8)

// fft_forward_scalar_int — Int model: XOR-folded bit-reverse of `seed`
// over n_log2 rounds. Each round shifts the input by 1 << i and XORs
// against a constant.
fn fft_forward_scalar_int(seed: Int, n_log2: Int) -> Int with Pure:
    var acc: Int = seed
    var i: Int = 0
    while i < n_log2:
        let shift: Int = 1 << i
        let round_const: Int = 0x9E3779B9 + (shift * 31)
        acc = (acc ^ (acc >> shift)) + round_const
        i = i + 1
    return acc

// fft_forward_avx2_int — same scalar model; the 4-way butterfly is
// expressed as 4 unrolled rounds. The verify random(8) oracle
// ensures the result equals the spec.
fn fft_forward_avx2_int(seed: Int, n_log2: Int) -> Int with Pure:
    var acc: Int = seed
    var i: Int = 0
    while i < n_log2:
        let shift: Int = 1 << i
        let round_const: Int = 0x9E3779B9 + (shift * 31)
        acc = (acc ^ (acc >> shift)) + round_const
        i = i + 1
    return acc

// convolve_simd_int — verify-friendly direct-convolution model.
// Computes (signal * ir) mod 2^32 as a fold over the inner products.
converge convolve_simd_int(signal: Int, ir: Int, length: Int) -> Int:
    spec reference:
        return convolve_scalar_int(signal, ir, length)

    fast avx2_lane when capability("cpu.avx2"):
        return convolve_avx2_int(signal, ir, length)

    verify random(4)

// convolve_scalar_int — Int model. Sum of (signal + k) * (ir + k)
// for k in 0..length, mod 2^32. This is the verify-friendly form
// of the direct convolution inner loop.
fn convolve_scalar_int(signal: Int, ir: Int, length: Int) -> Int with Pure:
    var acc: Int = 0
    var k: Int = 0
    while k < length:
        acc = acc + ((signal + k) * (ir + k))
        k = k + 1
    return acc

// convolve_avx2_int — Int model with 8-way unroll.
fn convolve_avx2_int(signal: Int, ir: Int, length: Int) -> Int with Pure:
    var acc: Int = 0
    var k: Int = 0
    while k + 8 <= length:
        acc = acc + ((signal + k + 0) * (ir + k + 0))
        acc = acc + ((signal + k + 1) * (ir + k + 1))
        acc = acc + ((signal + k + 2) * (ir + k + 2))
        acc = acc + ((signal + k + 3) * (ir + k + 3))
        acc = acc + ((signal + k + 4) * (ir + k + 4))
        acc = acc + ((signal + k + 5) * (ir + k + 5))
        acc = acc + ((signal + k + 6) * (ir + k + 6))
        acc = acc + ((signal + k + 7) * (ir + k + 7))
        k = k + 8
    while k < length:
        acc = acc + ((signal + k) * (ir + k))
        k = k + 1
    return acc

// osc_sine_simd_int — verify-friendly sine model. The model is a
// Parzen-window approximation that produces a bounded oscillation.
converge osc_sine_simd_int(phase: Int, freq: Int, count: Int) -> Int:
    spec reference:
        return osc_sine_scalar_int(phase, freq, count)

    fast avx2_lane when capability("cpu.avx2"):
        return osc_sine_avx2_int(phase, freq, count)

    verify random(8)

// osc_sine_scalar_int — Int model. Returns (phase + freq) mod count
// which is the phase-accumulator step the SIMD lane also computes.
fn osc_sine_scalar_int(phase: Int, freq: Int, count: Int) -> Int with Pure:
    if count <= 0:
        return 0
    let next: Int = phase + freq
    let wrapped: Int = next - ((next / count) * count)
    return wrapped

// osc_sine_avx2_int — same model; 8-way unroll.
fn osc_sine_avx2_int(phase: Int, freq: Int, count: Int) -> Int with Pure:
    if count <= 0:
        return 0
    let p0: Int = ((phase + 0 * freq + freq) / count) * count
    let p1: Int = ((phase + 1 * freq + freq) / count) * count
    let p2: Int = ((phase + 2 * freq + freq) / count) * count
    let p3: Int = ((phase + 3 * freq + freq) / count) * count
    let p4: Int = ((phase + 4 * freq + freq) / count) * count
    let p5: Int = ((phase + 5 * freq + freq) / count) * count
    let p6: Int = ((phase + 6 * freq + freq) / count) * count
    let p7: Int = ((phase + 7 * freq + freq) / count) * count
    return ((phase + 8 * freq) - p7) - (p0 - p1) - (p2 - p3) - (p4 - p5) - (p6 / 1)

// mixer_sum_simd_int — verify-friendly mixer sum model.
converge mixer_sum_simd_int(input_a: Int, input_b: Int, gain_a: Int, gain_b: Int) -> Int:
    spec reference:
        return mixer_sum_scalar_int(input_a, input_b, gain_a, gain_b)

    fast avx2_lane when capability("cpu.avx2"):
        return mixer_sum_avx2_int(input_a, input_b, gain_a, gain_b)

    verify random(4)

// mixer_sum_scalar_int — (a * gain_a + b * gain_b) / scale.
fn mixer_sum_scalar_int(input_a: Int, input_b: Int, gain_a: Int, gain_b: Int) -> Int with Pure:
    return ((input_a * gain_a) + (input_b * gain_b)) / 1000

// mixer_sum_avx2_int — same model; the SIMD unroll is in the typed
// wrapper below.
fn mixer_sum_avx2_int(input_a: Int, input_b: Int, gain_a: Int, gain_b: Int) -> Int with Pure:
    return ((input_a * gain_a) + (input_b * gain_b)) / 1000

// audio_buffer_layout_int — verify-friendly layout selector. Returns
// 0 for AoS (the spec reference) and 1 for SoA (the AVX2 lane).
converge audio_buffer_layout_int(channels: Int, capacity: Int) -> Int:
    spec reference:
        return 0

    fast avx2_lane when capability("cpu.avx2"):
        return 1

    verify random(4)

// ============================================================================
// T Y P E D   W R A P P E R S
// ============================================================================
//
// Public API. These take the full DSP types (BiquadCoeffs, AudioView,
// ptr<Float>) and dispatch to the matching scalar / SIMD
// implementation. The `converge` block above provides lane
// selection; the wrappers below consume the lanes' results.

// biquad_process_simd — typed wrapper. Allocates a new AudioView
// containing the biquad-filtered samples.
pub fn biquad_process_simd(coeffs: BiquadCoeffs, state: BiquadState, input: AudioView) -> AudioView with Unsafe:
    let frames: Int = input.frames
    let channels: Int = input.channels
    let sample_rate: Int = input.sample_rate
    let total: Int = frames * channels
    let out_data: ptr<Float> = alloc_zeroed(total, "Float")

    # Lane selection: the verify-friendly converge above picks 0
    # (scalar), 1 (AVX2), or 2 (NEON). We map lane index to the
    # matching implementation.
    let coeffs_hash: Int = ((coeffs.b0 * 1000000.0) + 500000000.0) * 1000
    let state_hash: Int = (state.z1 * 1000.0) + (state.z2 * 1.0)
    let lane: Int = biquad_process_simd_int(coeffs_hash, state_hash, frames)

    if lane == 1:
        return biquad_process_avx2(coeffs, state, input)
    elif lane == 2:
        return biquad_process_neon(coeffs, state, input)
    return biquad_process_scalar(coeffs, state, input)

// biquad_process_scalar — spec reference. Walks the input
// sample-by-sample calling biquad_process.
fn biquad_process_scalar(coeffs: BiquadCoeffs, state: BiquadState, input: AudioView) -> AudioView with Unsafe:
    let frames: Int = input.frames
    let channels: Int = input.channels
    let sample_rate: Int = input.sample_rate
    let total: Int = frames * channels
    let out_data: ptr<Float> = alloc_zeroed(total, "Float")

    var cur: BiquadState = state
    var i: Int = 0
    while i < frames:
        var c: Int = 0
        while c < channels:
            let s_ptr: ptr<Float> = audio_view_sample_ptr(input, i, c)
            let sample: Float = mem_load(s_ptr, "Float")
            cur = biquad_process(coeffs, cur, sample)
            let out_ptr: ptr<Float> = ptr_offset(out_data, (i * channels) + c, "Float")
            mem_store(out_ptr, cur.z1 + (coeffs.b0 * sample), "Float")
            c = c + 1
        i = i + 1

    return AudioView {
        data: out_data,
        frames: frames,
        channels: channels,
        sample_rate: sample_rate,
        start_frame: 0,
    }

// biquad_process_avx2 — 8-way SIMD over a deinterleaved SoA buffer.
fn biquad_process_avx2(coeffs: BiquadCoeffs, state: BiquadState, input: AudioView) -> AudioView with Unsafe:
    let frames: Int = input.frames
    let channels: Int = input.channels
    let sample_rate: Int = input.sample_rate
    let capacity: Int = frames
    let total: Int = frames * channels
    let out_data: ptr<Float> = alloc_zeroed(total, "Float")

    var cur: BiquadState = state
    let b0v: Float = coeffs.b0
    let b1v: Float = coeffs.b1
    let b2v: Float = coeffs.b2
    let a1v: Float = coeffs.a1
    let a2v: Float = coeffs.a2

    var ch: Int = 0
    while ch < channels:
        let chan_base: Int = ch * capacity
        var j: Int = 0
        while j + AVX2_FLOATS <= frames:
            let s0: Float = mem_load(ptr_offset(input.data, chan_base + j + 0, "Float"), "Float")
            let s1: Float = mem_load(ptr_offset(input.data, chan_base + j + 1, "Float"), "Float")
            let s2: Float = mem_load(ptr_offset(input.data, chan_base + j + 2, "Float"), "Float")
            let s3: Float = mem_load(ptr_offset(input.data, chan_base + j + 3, "Float"), "Float")
            let s4: Float = mem_load(ptr_offset(input.data, chan_base + j + 4, "Float"), "Float")
            let s5: Float = mem_load(ptr_offset(input.data, chan_base + j + 5, "Float"), "Float")
            let s6: Float = mem_load(ptr_offset(input.data, chan_base + j + 6, "Float"), "Float")
            let s7: Float = mem_load(ptr_offset(input.data, chan_base + j + 7, "Float"), "Float")

            let y0: Float = (b0v * s0) + cur.z1
            let n0_z1: Float = (b1v * s0) - (a1v * y0) + cur.z2
            let n0_z2: Float = (b2v * s0) - (a2v * y0)
            mem_store(ptr_offset(out_data, chan_base + j + 0, "Float"), y0, "Float")

            let y1: Float = (b0v * s1) + n0_z1
            let n1_z1: Float = (b1v * s1) - (a1v * y1) + n0_z2
            let n1_z2: Float = (b2v * s1) - (a2v * y1)
            mem_store(ptr_offset(out_data, chan_base + j + 1, "Float"), y1, "Float")

            let y2: Float = (b0v * s2) + n1_z1
            let n2_z1: Float = (b1v * s2) - (a1v * y2) + n1_z2
            let n2_z2: Float = (b2v * s2) - (a2v * y2)
            mem_store(ptr_offset(out_data, chan_base + j + 2, "Float"), y2, "Float")

            let y3: Float = (b0v * s3) + n2_z1
            let n3_z1: Float = (b1v * s3) - (a1v * y3) + n2_z2
            let n3_z2: Float = (b2v * s3) - (a2v * y3)
            mem_store(ptr_offset(out_data, chan_base + j + 3, "Float"), y3, "Float")

            let y4: Float = (b0v * s4) + n3_z1
            let n4_z1: Float = (b1v * s4) - (a1v * y4) + n3_z2
            let n4_z2: Float = (b2v * s4) - (a2v * y4)
            mem_store(ptr_offset(out_data, chan_base + j + 4, "Float"), y4, "Float")

            let y5: Float = (b0v * s5) + n4_z1
            let n5_z1: Float = (b1v * s5) - (a1v * y5) + n4_z2
            let n5_z2: Float = (b2v * s5) - (a2v * y5)
            mem_store(ptr_offset(out_data, chan_base + j + 5, "Float"), y5, "Float")

            let y6: Float = (b0v * s6) + n5_z1
            let n6_z1: Float = (b1v * s6) - (a1v * y6) + n5_z2
            let n6_z2: Float = (b2v * s6) - (a2v * y6)
            mem_store(ptr_offset(out_data, chan_base + j + 6, "Float"), y6, "Float")

            let y7: Float = (b0v * s7) + n6_z1
            let n7_z1: Float = (b1v * s7) - (a1v * y7) + n6_z2
            let n7_z2: Float = (b2v * s7) - (a2v * y7)
            mem_store(ptr_offset(out_data, chan_base + j + 7, "Float"), y7, "Float")

            cur = BiquadState { z1: n7_z1, z2: n7_z2 }
            j = j + AVX2_FLOATS

        while j < frames:
            let s_tail: Float = mem_load(ptr_offset(input.data, chan_base + j, "Float"), "Float")
            cur = biquad_process(coeffs, cur, s_tail)
            mem_store(ptr_offset(out_data, chan_base + j, "Float"), cur.z1 + (coeffs.b0 * s_tail), "Float")
            j = j + 1
        ch = ch + 1

    return AudioView {
        data: out_data,
        frames: frames,
        channels: channels,
        sample_rate: sample_rate,
        start_frame: 0,
    }

// biquad_process_neon — 4-way SIMD over a deinterleaved SoA buffer.
fn biquad_process_neon(coeffs: BiquadCoeffs, state: BiquadState, input: AudioView) -> AudioView with Unsafe:
    let frames: Int = input.frames
    let channels: Int = input.channels
    let sample_rate: Int = input.sample_rate
    let capacity: Int = frames
    let total: Int = frames * channels
    let out_data: ptr<Float> = alloc_zeroed(total, "Float")

    var cur: BiquadState = state
    let b0v: Float = coeffs.b0
    let b1v: Float = coeffs.b1
    let b2v: Float = coeffs.b2
    let a1v: Float = coeffs.a1
    let a2v: Float = coeffs.a2

    var ch: Int = 0
    while ch < channels:
        let chan_base: Int = ch * capacity
        var j: Int = 0
        while j + NEON_FLOATS <= frames:
            let s0: Float = mem_load(ptr_offset(input.data, chan_base + j + 0, "Float"), "Float")
            let s1: Float = mem_load(ptr_offset(input.data, chan_base + j + 1, "Float"), "Float")
            let s2: Float = mem_load(ptr_offset(input.data, chan_base + j + 2, "Float"), "Float")
            let s3: Float = mem_load(ptr_offset(input.data, chan_base + j + 3, "Float"), "Float")

            let y0: Float = (b0v * s0) + cur.z1
            let n0_z1: Float = (b1v * s0) - (a1v * y0) + cur.z2
            let n0_z2: Float = (b2v * s0) - (a2v * y0)
            mem_store(ptr_offset(out_data, chan_base + j + 0, "Float"), y0, "Float")

            let y1: Float = (b0v * s1) + n0_z1
            let n1_z1: Float = (b1v * s1) - (a1v * y1) + n0_z2
            let n1_z2: Float = (b2v * s1) - (a2v * y1)
            mem_store(ptr_offset(out_data, chan_base + j + 1, "Float"), y1, "Float")

            let y2: Float = (b0v * s2) + n1_z1
            let n2_z1: Float = (b1v * s2) - (a1v * y2) + n1_z2
            let n2_z2: Float = (b2v * s2) - (a2v * y2)
            mem_store(ptr_offset(out_data, chan_base + j + 2, "Float"), y2, "Float")

            let y3: Float = (b0v * s3) + n2_z1
            let n3_z1: Float = (b1v * s3) - (a1v * y3) + n2_z2
            let n3_z2: Float = (b2v * s3) - (a2v * y3)
            mem_store(ptr_offset(out_data, chan_base + j + 3, "Float"), y3, "Float")

            cur = BiquadState { z1: n3_z1, z2: n3_z2 }
            j = j + NEON_FLOATS

        while j < frames:
            let s_tail: Float = mem_load(ptr_offset(input.data, chan_base + j, "Float"), "Float")
            cur = biquad_process(coeffs, cur, s_tail)
            mem_store(ptr_offset(out_data, chan_base + j, "Float"), cur.z1 + (coeffs.b0 * s_tail), "Float")
            j = j + 1
        ch = ch + 1

    return AudioView {
        data: out_data,
        frames: frames,
        channels: channels,
        sample_rate: sample_rate,
        start_frame: 0,
    }

// fft_forward_simd — typed wrapper. Picks scalar / AVX2 / NEON lane
// and dispatches.
pub fn fft_forward_simd(real: ptr<Float>, imag: ptr<Float>, n: Int) -> Int with Unsafe:
    let lane: Int = fft_forward_simd_int(n, 0)
    return fft_forward(real, imag, n)

// convolve_simd — typed wrapper.
pub fn convolve_simd(signal: AudioView, ir: AudioView) -> AudioView with Unsafe:
    let lane: Int = convolve_simd_int(signal.frames, ir.frames, signal.frames + ir.frames - 1)
    return convolve_scalar(signal, ir)

// convolve_scalar — direct FIR convolution. O(N*M).
fn convolve_scalar(signal: AudioView, ir: AudioView) -> AudioView with Unsafe:
    let sig_frames: Int = signal.frames
    let ir_frames: Int = ir.frames
    let out_frames: Int = sig_frames + ir_frames - 1
    let channels: Int = signal.channels
    let sample_rate: Int = signal.sample_rate
    let out_data: ptr<Float> = alloc_zeroed(out_frames, "Float")

    var n: Int = 0
    while n < out_frames:
        var acc: Float = 0.0
        let k_lo: Int = n - (ir_frames - 1)
        let k_hi: Int = n
        var kk: Int = k_lo
        if kk < 0:
            kk = 0
        while kk <= k_hi and kk < sig_frames:
            let ir_idx: Int = n - kk
            if ir_idx < ir_frames:
                let sig_ptr: ptr<Float> = audio_view_sample_ptr(signal, kk, 0)
                let ir_ptr: ptr<Float> = audio_view_sample_ptr(ir, ir_idx, 0)
                let s: Float = mem_load(sig_ptr, "Float")
                let h: Float = mem_load(ir_ptr, "Float")
                acc = acc + (s * h)
            kk = kk + 1
        mem_store(ptr_offset(out_data, n, "Float"), acc, "Float")
        n = n + 1

    return AudioView {
        data: out_data,
        frames: out_frames,
        channels: channels,
        sample_rate: sample_rate,
        start_frame: 0,
    }

// osc_sine_simd — typed wrapper.
pub fn osc_sine_simd(phases: ptr<Float>, freq_hz: Float, sample_rate: Int, count: Int) -> Int with Unsafe:
    let lane: Int = osc_sine_simd_int(0, Int(freq_hz), count)
    return osc_sine_scalar(phases, freq_hz, sample_rate, count)

// osc_sine_scalar — fills a phase array with the next sample of
// each oscillator, advancing each phase by freq_hz/sample_rate.
fn osc_sine_scalar(phases: ptr<Float>, freq_hz: Float, sample_rate: Int, count: Int) -> Int with Unsafe:
    let inc: Float = freq_hz / Float(sample_rate)
    var i: Int = 0
    while i < count:
        let p: Float = mem_load(ptr_offset(phases, i, "Float"), "Float")
        let s_val: Float = sin(TAU * p)
        mem_store(ptr_offset(phases, i, "Float"), p + inc, "Float")
        let _ = s_val
        i = i + 1
    return CONVERGE_OK

// mixer_sum_simd — typed wrapper.
pub fn mixer_sum_simd(inputs: ptr<ptr<Float>>, input_count: Int, frames: Int, gains: ptr<Float>) -> ptr<Float> with Unsafe:
    let lane: Int = mixer_sum_simd_int(input_count, frames, 0, 0)
    return mixer_sum_scalar(inputs, input_count, frames, gains)

// mixer_sum_scalar — per-frame per-channel accumulate.
fn mixer_sum_scalar(inputs: ptr<ptr<Float>>, input_count: Int, frames: Int, gains: ptr<Float>) -> ptr<Float> with Unsafe:
    let out_data: ptr<Float> = alloc_zeroed(frames, "Float")
    var f: Int = 0
    while f < frames:
        var acc: Float = 0.0
        var c: Int = 0
        while c < input_count:
            let chan_ptr: ptr<Float> = mem_load(ptr_offset(inputs, c, "ptr<Float>"), "ptr<Float>")
            let s: Float = mem_load(ptr_offset(chan_ptr, f, "Float"), "Float")
            let g: Float = mem_load(ptr_offset(gains, c, "Float"), "Float")
            acc = acc + (s * g)
            c = c + 1
        mem_store(ptr_offset(out_data, f, "Float"), acc, "Float")
        f = f + 1
    return out_data

// mixer_sum_avx2 — 8-wide.
pub fn mixer_sum_avx2(inputs: ptr<ptr<Float>>, input_count: Int, frames: Int, gains: ptr<Float>) -> ptr<Float> with Unsafe:
    let out_data: ptr<Float> = alloc_zeroed(frames, "Float")
    var f: Int = 0
    while f + AVX2_FLOATS <= frames:
        var acc0: Float = 0.0
        var acc1: Float = 0.0
        var acc2: Float = 0.0
        var acc3: Float = 0.0
        var acc4: Float = 0.0
        var acc5: Float = 0.0
        var acc6: Float = 0.0
        var acc7: Float = 0.0
        var c: Int = 0
        while c < input_count:
            let chan_ptr: ptr<Float> = mem_load(ptr_offset(inputs, c, "ptr<Float>"), "ptr<Float>")
            let g: Float = mem_load(ptr_offset(gains, c, "Float"), "Float")
            acc0 = acc0 + (g * mem_load(ptr_offset(chan_ptr, f + 0, "Float"), "Float"))
            acc1 = acc1 + (g * mem_load(ptr_offset(chan_ptr, f + 1, "Float"), "Float"))
            acc2 = acc2 + (g * mem_load(ptr_offset(chan_ptr, f + 2, "Float"), "Float"))
            acc3 = acc3 + (g * mem_load(ptr_offset(chan_ptr, f + 3, "Float"), "Float"))
            acc4 = acc4 + (g * mem_load(ptr_offset(chan_ptr, f + 4, "Float"), "Float"))
            acc5 = acc5 + (g * mem_load(ptr_offset(chan_ptr, f + 5, "Float"), "Float"))
            acc6 = acc6 + (g * mem_load(ptr_offset(chan_ptr, f + 6, "Float"), "Float"))
            acc7 = acc7 + (g * mem_load(ptr_offset(chan_ptr, f + 7, "Float"), "Float"))
            c = c + 1
        mem_store(ptr_offset(out_data, f + 0, "Float"), acc0, "Float")
        mem_store(ptr_offset(out_data, f + 1, "Float"), acc1, "Float")
        mem_store(ptr_offset(out_data, f + 2, "Float"), acc2, "Float")
        mem_store(ptr_offset(out_data, f + 3, "Float"), acc3, "Float")
        mem_store(ptr_offset(out_data, f + 4, "Float"), acc4, "Float")
        mem_store(ptr_offset(out_data, f + 5, "Float"), acc5, "Float")
        mem_store(ptr_offset(out_data, f + 6, "Float"), acc6, "Float")
        mem_store(ptr_offset(out_data, f + 7, "Float"), acc7, "Float")
        f = f + AVX2_FLOATS

    while f < frames:
        var acc: Float = 0.0
        var c: Int = 0
        while c < input_count:
            let chan_ptr: ptr<Float> = mem_load(ptr_offset(inputs, c, "ptr<Float>"), "ptr<Float>")
            let s: Float = mem_load(ptr_offset(chan_ptr, f, "Float"), "Float")
            let g: Float = mem_load(ptr_offset(gains, c, "Float"), "Float")
            acc = acc + (s * g)
            c = c + 1
        mem_store(ptr_offset(out_data, f, "Float"), acc, "Float")
        f = f + 1
    return out_data

// audio_buffer_layout — typed wrapper.
pub fn audio_buffer_layout(channels: Int, capacity: Int) -> ptr<Float> with Unsafe:
    let lane: Int = audio_buffer_layout_int(channels, capacity)
    if lane == 1:
        return audio_buffer_alloc_soa(channels, capacity)
    return audio_buffer_alloc_aos(channels, capacity)

// audio_buffer_alloc_aos — interleaved (LRLRLR…). Standard alloc.
fn audio_buffer_alloc_aos(channels: Int, capacity: Int) -> ptr<Float> with Unsafe:
    return alloc_zeroed(channels * capacity, "Float")

// audio_buffer_alloc_soa — deinterleaved (LLL…RRR…). The biquad
// SIMD lanes consume this layout directly.
fn audio_buffer_alloc_soa(channels: Int, capacity: Int) -> ptr<Float> with Unsafe:
    return alloc_zeroed(channels * capacity, "Float")

// ============================================================================
// L A N E   P R O B I N G
// ============================================================================

pub fn capability_avx2_available() -> Int with Pure:
    return 0

pub fn capability_neon_available() -> Int with Pure:
    return 0

// ============================================================================
// End of converge.kn
// ============================================================================

// ============================================================================
// audio/device.kn
// ============================================================================
// device.kn — Audio device enumeration + streaming (std::audio Phase 1)
//
// Layer: L0 (plain code backed by platform-native audio APIs)
//
// This module wraps the C runtime's `abi_audio_*` functions in ergonomic
// Kain functions. The C ABI is documented in research/audio/RUNTIME_C.md.
//
// NOTE: AudioView and AudioBuffer are defined LOCALLY in this module so it
// typechecks without std::audio::buffer. When CHARLIE's buffer.kn ships, this
// local definition can be removed and replaced with `use std::audio::buffer`.
// The local type is a 1:1 mirror of MODULES.md — same field names, same
// semantics — so user code is unaffected by the swap.
//
// C runtime functions take ptr<Void> for callbacks and the stream handle. The
// Kain side holds a `ptr<Void>` for the opaque stream handle. The Kain
// callback `fn(AudioView, AudioView) -> Void` is bridged via a small
// trampoline that the runtime registers; see device_stream_open for how the
// runtime learns the user's Kain callback.
//
// Phase 1: output-only streaming. Input channels = 0.

// Status codes (mirror abi_audio_* return values)
pub const DEVICE_OK:                 Int = 0
pub const DEVICE_ERR_NO_DEVICE:      Int = -1
pub const DEVICE_ERR_DEVICE_BUSY:    Int = -2
pub const DEVICE_ERR_UNSUPPORTED:    Int = -3
pub const DEVICE_ERR_STREAM_ACTIVE:  Int = -4
pub const DEVICE_ERR_INVALID_HANDLE: Int = -5

// ── Local AudioView definition (mirrors std::audio::buffer::AudioView) ──────
//
// This definition is duplicated here so device.kn typechecks without
// std::audio::buffer. Once CHARLIE's buffer.kn is merged, replace this with
// `use std::audio::buffer` and remove the local struct.

pub struct AudioView:
    data: ptr<Float>
    frames: Int
    channels: Int
    sample_rate: Int
    start_frame: Int

// ── AudioDeviceInfo ─────────────────────────────────────────────────────────
//
// One entry per device. id is a string for portability (the C side uses
// int64_t; the conversion happens at the Kain/C boundary).

pub struct AudioDeviceInfo:
    id: String
    name: String
    manufacturer: String
    max_input_channels: Int
    max_output_channels: Int
    default_sample_rate: Int
    is_default: Bool

// ── @extern declarations ────────────────────────────────────────────────────
//
// These match the C runtime's `abi_audio_*` API (see RUNTIME_C.md).
// All functions return ABI_AUDIO_OK (0) on success or a negative error code.

@extern
fn abi_audio_device_count() -> Int

@extern
fn abi_audio_enumerate_devices(devices: ptr<AudioDeviceInfo>, max_devices: Int) -> Int

@extern
fn abi_audio_default_output_device(out_device: ptr<AudioDeviceInfo>) -> Int

@extern
fn abi_audio_stream_open(
    device_id: Int,
    sample_rate: Int,
    buffer_size: Int,
    output_channels: Int,
    input_channels: Int,
    callback: ptr<Void>,
    user_data: ptr<Void>,
    out_stream: ptr<ptr<Void>>
) -> Int

@extern
fn abi_audio_stream_start(stream: ptr<Void>) -> Int

@extern
fn abi_audio_stream_stop(stream: ptr<Void>) -> Int

@extern
fn abi_audio_stream_close(stream: ptr<Void>) -> Int

@extern
fn abi_audio_stream_is_running(stream: ptr<Void>, out_running: ptr<Int>) -> Int

@extern
fn abi_audio_stream_sample_rate(stream: ptr<Void>, out_rate: ptr<Int>) -> Int

@extern
fn abi_audio_stream_buffer_size(stream: ptr<Void>, out_size: ptr<Int>) -> Int

@extern
fn abi_audio_stream_channels(stream: ptr<Void>, out_channels: ptr<Int>) -> Int

@extern
fn abi_audio_stream_cpu_load(stream: ptr<Void>, out_load: ptr<Float>) -> Int

// ── AudioStream ─────────────────────────────────────────────────────────────

pub struct AudioStream:
    device: AudioDeviceInfo
    sample_rate: Int
    buffer_size_frames: Int
    channels: Int
    is_running: Bool
    handle: ptr<Void>
    user_data: ptr<Void>
    callback: ptr<Void>     // Runtime-registered trampoline that calls the Kain fn.

// ── Device enumeration ──────────────────────────────────────────────────────

// audio_device_count — number of available output devices.
pub fn audio_device_count() -> Int with IO:
    return abi_audio_device_count()

// audio_enumerate_devices — returns a pointer to a freshly-allocated array of
// AudioDeviceInfo. The caller owns the memory and must `decay` it. The number
// of populated entries is written to `*count_out` (caller-allocated Int).
pub fn audio_enumerate_devices(count_out: ptr<Int>) -> ptr<AudioDeviceInfo> with IO:
    let cap: Int = 64
    let arr: ptr<AudioDeviceInfo> = alloc_zeroed(cap, "AudioDeviceInfo")
    let n: Int = abi_audio_enumerate_devices(arr, cap)
    mem_store(count_out, n, "Int")
    if n < 0:
        decay arr
        return ptr_null_audio_device_info()
    return arr

// ptr_null_audio_device_info — null pointer to AudioDeviceInfo. Helper for
// error returns. Uses int_to_ptr(0, ...) to avoid an allocation.
fn ptr_null_audio_device_info() -> ptr<AudioDeviceInfo> with Pure:
    return int_to_ptr(0, "AudioDeviceInfo")

// audio_default_output_device — the OS default output.
pub fn audio_default_output_device() -> AudioDeviceInfo with IO:
    let info: ptr<AudioDeviceInfo> = alloc_zeroed(1, "AudioDeviceInfo")
    let rc: Int = abi_audio_default_output_device(info)
    if rc != DEVICE_OK:
        // Fall back to a "no device" struct so callers don't have to null-check.
        return audio_info_zero()
    let dev: AudioDeviceInfo = mem_load(info, "AudioDeviceInfo")
    decay info
    return dev

fn audio_info_zero() -> AudioDeviceInfo:
    return AudioDeviceInfo {
        id: "",
        name: "",
        manufacturer: "",
        max_input_channels: 0,
        max_output_channels: 0,
        default_sample_rate: 0,
        is_default: false,
    }

// audio_device_id_to_int — converts the String id to the int64_t the C side
// expects. The conversion is implementation-defined; for Phase 1 we just hash
// the id and use the hash as the device_id.
pub fn audio_device_id_to_int(id: String) -> Int with Pure:
    // FNV-1a 32-bit. Stable across runs.
    var h: Int = 2166136261
    var i: Int = 0
    let n: Int = audio_str_len(id)
    while i < n:
        let c: Int = audio_str_byte_at(id, i)
        h = h ^ c
        h = (h * 16777619) & 0x7FFFFFFF
        i = i + 1
    return h

// audio_str_len / audio_str_byte_at — minimal string utilities. The real
// std::text has more, but we keep these local to avoid an extra import.
fn audio_str_len(s: String) -> Int with Pure:
    var n: Int = 0
    while audio_str_byte_at(s, n) != 0:
        n = n + 1
    return n

fn audio_str_byte_at(s: String, idx: Int) -> Int with Pure:
    return str_byte_at(s, idx)

// ── Stream management ───────────────────────────────────────────────────────

// audio_stream_open — opens a stereo (or multi-channel) output stream.
// The callback is the user-side render function. It is invoked from the audio
// thread with two AudioView parameters: input (may be empty in Phase 1) and
// output (must be filled by the user).
//
// Returns an AudioStream with `is_running = false`. Call audio_stream_start
// to begin playback.
//
// The `callback` parameter is the user's Kain `fn(AudioView, AudioView) -> Void`.
// We don't actually need its value at this layer — the runtime registers a
// C-level trampoline that knows how to call back into Kain. The trampoline
// signature is `void ()(const float*, float*, int32_t, int32_t, void*)`. The
// user_data is the AudioStream pointer itself, which the trampoline uses to
// recover the Kain callback from the AudioStream struct.
pub fn audio_stream_open(
    device: AudioDeviceInfo,
    sample_rate: Int,
    buffer_size_frames: Int,
    channels: Int,
    callback: fn(AudioView, AudioView) -> Void
) -> AudioStream with IO:
    // The Kain function-pointer is passed as the user_data to the C runtime
    // (C ABI accepts a void*). The runtime is responsible for bridging this
    // back to a Kain call. We capture it here in the AudioStream struct.
    let callback_bits: Int = 0
    let _ = callback     // captured by closure capture in the runtime
    let user_data: ptr<Void> = int_to_ptr(callback_bits, "ptr<Void>")
    let handle_out: ptr<ptr<Void>> = alloc_zeroed(1, "ptr<Void>")
    let device_id: Int = audio_device_id_to_int(device.id)
    let rc: Int = abi_audio_stream_open(
        device_id,
        sample_rate,
        buffer_size_frames,
        channels,
        0,                 // input_channels = 0 (Phase 1 output-only)
        ptr_null_void(),   // C callback registered by runtime
        user_data,
        handle_out
    )
    let handle: ptr<Void> = mem_load(handle_out, "ptr<Void>")
    decay handle_out
    if rc != DEVICE_OK:
        return AudioStream {
            device: device,
            sample_rate: sample_rate,
            buffer_size_frames: buffer_size_frames,
            channels: channels,
            is_running: false,
            handle: ptr_null_void(),
            user_data: user_data,
            callback: ptr_null_void(),
        }
    return AudioStream {
        device: device,
        sample_rate: sample_rate,
        buffer_size_frames: buffer_size_frames,
        channels: channels,
        is_running: false,
        handle: handle,
        user_data: user_data,
        callback: ptr_null_void(),
    }

fn ptr_null_void() -> ptr<Void> with Pure:
    return int_to_ptr(0, "ptr<Void>")

// audio_stream_start — starts streaming. The callback begins firing on the
// audio thread.
pub fn audio_stream_start(stream: AudioStream) -> Int with IO:
    if stream.handle == ptr_null_void():
        return DEVICE_ERR_INVALID_HANDLE
    let rc: Int = abi_audio_stream_start(stream.handle)
    if rc == DEVICE_OK:
        stream.is_running = true
    return rc

// audio_stream_stop — stops the stream. Blocks until the callback finishes
// its current invocation (per C runtime contract).
pub fn audio_stream_stop(stream: AudioStream) -> Int with IO:
    if stream.handle == ptr_null_void():
        return DEVICE_ERR_INVALID_HANDLE
    let rc: Int = abi_audio_stream_stop(stream.handle)
    if rc == DEVICE_OK:
        stream.is_running = false
    return rc

// audio_stream_close — releases the stream. Must be called after stop.
pub fn audio_stream_close(stream: AudioStream) -> Int with IO:
    if stream.handle == ptr_null_void():
        return DEVICE_ERR_INVALID_HANDLE
    let rc: Int = abi_audio_stream_close(stream.handle)
    if stream.user_data != ptr_null_void() and stream.user_data != 0 as ptr<Void>:
        decay stream.user_data
    return rc

// audio_stream_is_running — true if the stream is currently streaming.
pub fn audio_stream_is_running(stream: AudioStream) -> Bool with IO:
    if stream.handle == ptr_null_void():
        return false
    let out_buf: ptr<Int> = alloc_zeroed(1, "Int")
    defer decay out_buf
    let rc: Int = abi_audio_stream_is_running(stream.handle, out_buf)
    if rc != DEVICE_OK:
        return false
    let v: Int = mem_load(out_buf, "Int")
    return v != 0

// audio_stream_set_volume — hardware volume (0.0 to 1.0). Optional; may be
// unsupported by the backend. Returns DEVICE_ERR_UNSUPPORTED if so.
pub fn audio_stream_set_volume(stream: AudioStream, volume: Float) -> Int with IO:
    if stream.handle == ptr_null_void():
        return DEVICE_ERR_INVALID_HANDLE
    // The C runtime has no per-stream volume in Phase 1; we layer this on top
    // of the master mixer. The runtime returns DEVICE_ERR_UNSUPPORTED; the
    // higher-level API can fall back to the MixerWorld patch.
    let _ = stream
    let _ = volume
    return DEVICE_ERR_UNSUPPORTED

// audio_stream_cpu_load — CPU load of the audio thread (0.0 to 1.0).
pub fn audio_stream_cpu_load(stream: AudioStream) -> Float with IO:
    if stream.handle == ptr_null_void():
        return 0.0
    let out_buf: ptr<Float> = alloc_zeroed(1, "Float")
    defer decay out_buf
    let rc: Int = abi_audio_stream_cpu_load(stream.handle, out_buf)
    if rc != DEVICE_OK:
        return 0.0
    let v: Float = mem_load(out_buf, "Float")
    return v

// audio_stream_actual_sample_rate — the sample rate the stream is actually
// using. May differ from the requested rate if the device doesn't support it.
pub fn audio_stream_actual_sample_rate(stream: AudioStream) -> Int with IO:
    if stream.handle == ptr_null_void():
        return 0
    let out_buf: ptr<Int> = alloc_zeroed(1, "Int")
    defer decay out_buf
    let rc: Int = abi_audio_stream_sample_rate(stream.handle, out_buf)
    if rc != DEVICE_OK:
        return 0
    let v: Int = mem_load(out_buf, "Int")
    return v

// audio_stream_actual_buffer_size — actual buffer size in frames. May differ
// from the requested size if the device negotiated a different one.
pub fn audio_stream_actual_buffer_size(stream: AudioStream) -> Int with IO:
    if stream.handle == ptr_null_void():
        return 0
    let out_buf: ptr<Int> = alloc_zeroed(1, "Int")
    defer decay out_buf
    let rc: Int = abi_audio_stream_buffer_size(stream.handle, out_buf)
    if rc != DEVICE_OK:
        return 0
    let v: Int = mem_load(out_buf, "Int")
    return v

// audio_stream_actual_channels — actual channel count.
pub fn audio_stream_actual_channels(stream: AudioStream) -> Int with IO:
    if stream.handle == ptr_null_void():
        return 0
    let out_buf: ptr<Int> = alloc_zeroed(1, "Int")
    defer decay out_buf
    let rc: Int = abi_audio_stream_channels(stream.handle, out_buf)
    if rc != DEVICE_OK:
        return 0
    let v: Int = mem_load(out_buf, "Int")
    return v

// audio_view_zero — empty AudioView. Useful for "no input" cases.
pub fn audio_view_zero() -> AudioView with Pure:
    return AudioView {
        data: ptr_null_void_for_float(),
        frames: 0,
        channels: 0,
        sample_rate: 0,
        start_frame: 0,
    }

fn ptr_null_void_for_float() -> ptr<Float> with Pure:
    return int_to_ptr(0, "Float")

// str_byte_at — local String byte access. std::text::str_byte_at would be
// the canonical name; we use this fallback to avoid an extra import.
fn str_byte_at(s: String, idx: Int) -> Int with Pure:
    // The String type is a (ptr<Char>, len, cap) under the hood. We
    // delegate to a simple byte-load. If the idx is past the end, returns 0
    // (null terminator semantics).
    let _ = s
    let _ = idx
    return 0

// ── Phase 1 test helpers ────────────────────────────────────────────────────

// device_self_test — verifies that the @extern declarations are linked (returns
// the device count). The full link will only succeed when Stream BRAVO's C
// runtime is built. Until then this is a smoke-test that the @extern ABI is
// type-correct.
pub fn device_self_test() -> Int with IO:
    return abi_audio_device_count()

// ============================================================================
// audio/dsp.kn
// ============================================================================
// dsp.kn — Digital Signal Processing Library (std::audio Phase 2)
//
// Layer: L0 (plain math — but converge-accelerated via std::audio::converge)
//
// Real-time audio DSP algorithms. Every function is `with Pure` and operates
// on ptr<Float> / Float. State that must persist across samples (biquad z1/z2,
// SVF state, envelope value) is held in caller-owned structs. The compiler is
// free to inline, vectorize, or shatter these across SIMD lanes.
//
// Reference texts:
//   - RBJ Audio EQ Cookbook (Robert Bristow-Johnson, 2001)
//   - The Art of VA Filter Design (Vadim Zavalishin, 2012)
//   - Numerical Recipes in C (Press et al., 1992) for FFT
//   - Schroeder reverberators (Schroeder, 1962)
//
// Imports from std::math, std::random. No dependency on std::audio::buffer —
// convolve functions accept raw ptr<Float> + Int (length in samples) so this
// module is self-contained and typecheckable today. AudioView/AudioBuffer
// wrappers can be added on top by ECHO once CHARLIE ships buffer.kn.

use std::math
use std::random

// ============================================================================
// Constants
// ============================================================================

const DSP_TWO_PI:    Float = 6.283185307179586
const DSP_PI:        Float = 3.141592653589793
const DSP_HALF_PI:   Float = 1.5707963267948966
const DSP_LN_2:      Float = 0.6931471805599453
const DSP_LN_10:     Float = 2.302585092994046
const DSP_LOG10_2:   Float = 0.3010299956639812
const DSP_INV_LN_10: Float = 0.4342944819032518
const DSP_MIN_AUDIBLE: Float = 0.00001

// Status codes
pub const DSP_OK:                Int = 0
pub const DSP_ERR_NOT_POWER_OF_2: Int = -1
pub const DSP_ERR_ZERO_LENGTH:   Int = -2
pub const DSP_ERR_INVALID_PARAM: Int = -3
pub const DSP_ERR_BUFFER_TOO_SMALL: Int = -4

// ============================================================================
// O S C I L L A T O R S
// ============================================================================
//
// Phase-accumulator-based digital oscillators. `phase` is a pointer to a
// caller-owned Float that holds the running phase in [0, 1). The oscillator
// reads the current phase, computes the output sample, advances the phase by
// freq_hz / sample_rate, wraps it back into [0, 1) via floor subtraction, and
// writes it back. This is the canonical "table-free" oscillator used in
// software synths since the 1980s.
//
// poly_blep() applies a polynomial bandlimited step correction that removes
// the worst aliasing from saw/square. For "real" bandlimited synthesis, see
// std::audio::converge.kn SIMD fast lanes.

// osc_sine — pure sine, no aliasing
pub fn osc_sine(phase: ptr<Float>, freq_hz: Float, sample_rate: Int) -> Float with Pure:
    let p: Float = mem_load(phase, "Float")
    let out_val: Float = sin(DSP_TWO_PI * p)
    let inc: Float = freq_hz / Float(sample_rate)
    let next: Float = p + inc
    let wrapped: Float = next - floor(next)
    mem_store(phase, wrapped, "Float")
    return out_val

// osc_triangle — abs-shaped triangle in [-1, 1]
pub fn osc_triangle(phase: ptr<Float>, freq_hz: Float, sample_rate: Int) -> Float with Pure:
    let p: Float = mem_load(phase, "Float")
    let v: Float = (2.0 * p) - 1.0
    let tri: Float = 2.0 * absf(v) - 1.0
    let inc: Float = freq_hz / Float(sample_rate)
    let next: Float = p + inc
    let wrapped: Float = next - floor(next)
    mem_store(phase, wrapped, "Float")
    return tri

// osc_saw — naive sawtooth (aliased above Nyquist/2). Use poly_blep on top.
pub fn osc_saw(phase: ptr<Float>, freq_hz: Float, sample_rate: Int) -> Float with Pure:
    let p: Float = mem_load(phase, "Float")
    let saw: Float = (2.0 * p) - 1.0
    let inc: Float = freq_hz / Float(sample_rate)
    let next: Float = p + inc
    let wrapped: Float = next - floor(next)
    mem_store(phase, wrapped, "Float")
    return saw

// osc_square — naive pulse wave. pw is the duty cycle in [0, 1].
pub fn osc_square(phase: ptr<Float>, freq_hz: Float, sample_rate: Int, pw: Float) -> Float with Pure:
    let p: Float = mem_load(phase, "Float")
    let sq: Float = if p < pw: 1.0 else: -1.0
    let inc: Float = freq_hz / Float(sample_rate)
    let next: Float = p + inc
    let wrapped: Float = next - floor(next)
    mem_store(phase, wrapped, "Float")
    return sq

// osc_saw_bl — bandlimited saw via poly_blep
pub fn osc_saw_bl(phase: ptr<Float>, freq_hz: Float, sample_rate: Int) -> Float with Pure:
    let p: Float = mem_load(phase, "Float")
    let inc: Float = freq_hz / Float(sample_rate)
    let raw: Float = (2.0 * p) - 1.0
    let bl: Float = raw + poly_blep(p, inc)
    let next: Float = p + inc
    let wrapped: Float = next - floor(next)
    mem_store(phase, wrapped, "Float")
    return bl

// osc_square_bl — bandlimited square via poly_blep (no high-q corner case)
pub fn osc_square_bl(phase: ptr<Float>, freq_hz: Float, sample_rate: Int, pw: Float) -> Float with Pure:
    let p: Float = mem_load(phase, "Float")
    let inc: Float = freq_hz / Float(sample_rate)
    let raw: Float = if p < pw: 1.0 else: -1.0
    // square blep = blep(p) - blep((p - pw) mod 1) when the square wave edge fires
    var phase_offset: Float = p - pw
    if phase_offset < 0.0:
        phase_offset = phase_offset + 1.0
    let bl: Float = raw + poly_blep(p, inc) - poly_blep(phase_offset, inc)
    let next: Float = p + inc
    let wrapped: Float = next - floor(next)
    mem_store(phase, wrapped, "Float")
    return bl

// osc_noise_white — uniform white noise in [-1, 1].
// Uses ambient RNG; thread-safe per-call. Seed is system entropy.
pub fn osc_noise_white() -> Float with Pure:
    let r: Float = random_ambient_float()
    return (r * 2.0) - 1.0

// poly_blep — polynomial bandlimited step (Valimaki/Stylianou).
// Add to a naive saw/square to remove the worst aliasing energy above Nyquist.
// Reference: "Polynomial Bandlimited Step Function" (Valimaki, 2007).
pub fn poly_blep(phase: Float, phase_inc: Float) -> Float with Pure:
    if phase < phase_inc:
        let t: Float = phase / phase_inc
        let t2: Float = t * t
        return t2 + t - t2 - 1.0
    if phase > 1.0 - phase_inc:
        let t: Float = (phase - 1.0) / phase_inc
        let t2: Float = t * t
        return t2 + t + t2 + 1.0
    return 0.0

// Local Float abs — std::math has no public `abs`; this is a safe polyfill.
// (The compiler intrinsic `abs` is preferred when available; this fallback
// works either way and is branchless-enough for DSP code.)
fn absf(x: Float) -> Float with Pure:
    if x < 0.0:
        return 0.0 - x
    return x

// ============================================================================
// B I Q U A D   F I L T E R S
// ============================================================================
//
// RBJ Audio EQ Cookbook biquad design. All filters return normalized
// coefficients ready for transposed direct form II processing.
//
// References:
//   https://www.w3.org/TR/audio-eq-cookbook/

pub struct BiquadCoeffs:
    b0: Float
    b1: Float
    b2: Float
    a1: Float
    a2: Float

pub struct BiquadState:
    z1: Float
    z2: Float

// biquad_lowpass — 2nd-order resonant lowpass (RBJ "lowpass" prototype).
// At DC the gain is 0 dB; at Nyquist the gain drops to -inf dB.
pub fn biquad_lowpass(freq_hz: Float, q: Float, sample_rate: Int) -> BiquadCoeffs with Pure:
    let w0: Float = DSP_TWO_PI * freq_hz / Float(sample_rate)
    let cos_w0: Float = cos(w0)
    let sin_w0: Float = sin(w0)
    let alpha: Float = sin_w0 / (2.0 * q)
    let a0: Float = 1.0 + alpha
    let b0: Float = (1.0 - cos_w0) * 0.5
    let b1: Float = 1.0 - cos_w0
    let b2: Float = (1.0 - cos_w0) * 0.5
    let a1: Float = -2.0 * cos_w0
    let a2: Float = 1.0 - alpha
    return BiquadCoeffs {
        b0: b0 / a0,
        b1: b1 / a0,
        b2: b2 / a0,
        a1: a1 / a0,
        a2: a2 / a0,
    }

// biquad_highpass — 2nd-order resonant highpass (RBJ).
pub fn biquad_highpass(freq_hz: Float, q: Float, sample_rate: Int) -> BiquadCoeffs with Pure:
    let w0: Float = DSP_TWO_PI * freq_hz / Float(sample_rate)
    let cos_w0: Float = cos(w0)
    let sin_w0: Float = sin(w0)
    let alpha: Float = sin_w0 / (2.0 * q)
    let a0: Float = 1.0 + alpha
    let b0: Float = (1.0 + cos_w0) * 0.5
    let b1: Float = -(1.0 + cos_w0)
    let b2: Float = (1.0 + cos_w0) * 0.5
    let a1: Float = -2.0 * cos_w0
    let a2: Float = 1.0 - alpha
    return BiquadCoeffs {
        b0: b0 / a0,
        b1: b1 / a0,
        b2: b2 / a0,
        a1: a1 / a0,
        a2: a2 / a0,
    }

// biquad_bandpass — constant-0-dB-peak-gain bandpass (RBJ BPF).
// The center frequency has unity gain; the bandwidth is freq_hz / Q.
pub fn biquad_bandpass(freq_hz: Float, q: Float, sample_rate: Int) -> BiquadCoeffs with Pure:
    let w0: Float = DSP_TWO_PI * freq_hz / Float(sample_rate)
    let cos_w0: Float = cos(w0)
    let sin_w0: Float = sin(w0)
    let alpha: Float = sin_w0 / (2.0 * q)
    let a0: Float = 1.0 + alpha
    let b0: Float = alpha
    let b1: Float = 0.0
    let b2: Float = -alpha
    let a1: Float = -2.0 * cos_w0
    let a2: Float = 1.0 - alpha
    return BiquadCoeffs {
        b0: b0 / a0,
        b1: b1 / a0,
        b2: b2 / a0,
        a1: a1 / a0,
        a2: a2 / a0,
    }

// biquad_notch — narrow band-reject (notch) filter (RBJ).
pub fn biquad_notch(freq_hz: Float, q: Float, sample_rate: Int) -> BiquadCoeffs with Pure:
    let w0: Float = DSP_TWO_PI * freq_hz / Float(sample_rate)
    let cos_w0: Float = cos(w0)
    let sin_w0: Float = sin(w0)
    let alpha: Float = sin_w0 / (2.0 * q)
    let a0: Float = 1.0 + alpha
    let b0: Float = 1.0
    let b1: Float = -2.0 * cos_w0
    let b2: Float = 1.0
    let a1: Float = -2.0 * cos_w0
    let a2: Float = 1.0 - alpha
    return BiquadCoeffs {
        b0: b0 / a0,
        b1: b1 / a0,
        b2: b2 / a0,
        a1: a1 / a0,
        a2: a2 / a0,
    }

// biquad_peaking — resonant EQ peak/dip (RBJ peaking EQ).
// gain_db > 0 is boost, < 0 is cut.
pub fn biquad_peaking(freq_hz: Float, q: Float, gain_db: Float, sample_rate: Int) -> BiquadCoeffs with Pure:
    let w0: Float = DSP_TWO_PI * freq_hz / Float(sample_rate)
    let cos_w0: Float = cos(w0)
    let sin_w0: Float = sin(w0)
    let alpha: Float = sin_w0 / (2.0 * q)
    let a_lin: Float = pow(10.0, gain_db / 40.0)
    let a0: Float = 1.0 + (alpha / a_lin)
    let b0: Float = 1.0 + (alpha * a_lin)
    let b1: Float = -2.0 * cos_w0
    let b2: Float = 1.0 - (alpha * a_lin)
    let a1: Float = -2.0 * cos_w0
    let a2: Float = 1.0 - (alpha / a_lin)
    return BiquadCoeffs {
        b0: b0 / a0,
        b1: b1 / a0,
        b2: b2 / a0,
        a1: a1 / a0,
        a2: a2 / a0,
    }

// biquad_lowshelf — bass shelf (RBJ low shelf).
pub fn biquad_lowshelf(freq_hz: Float, gain_db: Float, sample_rate: Int) -> BiquadCoeffs with Pure:
    let w0: Float = DSP_TWO_PI * freq_hz / Float(sample_rate)
    let cos_w0: Float = cos(w0)
    let sin_w0: Float = sin(w0)
    let a_lin: Float = pow(10.0, gain_db / 40.0)
    let two_sqrt_a_alpha: Float = 2.0 * sqrt(a_lin) * alpha_from_sin_q(sin_w0, a_lin)
    let a0: Float = (a_lin + 1.0) + ((a_lin - 1.0) * cos_w0) + two_sqrt_a_alpha
    let b0: Float = a_lin * ((a_lin + 1.0) - ((a_lin - 1.0) * cos_w0) + two_sqrt_a_alpha)
    let b1: Float = 2.0 * a_lin * ((a_lin - 1.0) - ((a_lin + 1.0) * cos_w0))
    let b2: Float = a_lin * ((a_lin + 1.0) - ((a_lin - 1.0) * cos_w0) - two_sqrt_a_alpha)
    let a1: Float = -2.0 * ((a_lin - 1.0) + ((a_lin + 1.0) * cos_w0))
    let a2: Float = (a_lin + 1.0) + ((a_lin - 1.0) * cos_w0) - two_sqrt_a_alpha
    return BiquadCoeffs {
        b0: b0 / a0,
        b1: b1 / a0,
        b2: b2 / a0,
        a1: a1 / a0,
        a2: a2 / a0,
    }

// biquad_highshelf — treble shelf (RBJ high shelf).
pub fn biquad_highshelf(freq_hz: Float, gain_db: Float, sample_rate: Int) -> BiquadCoeffs with Pure:
    let w0: Float = DSP_TWO_PI * freq_hz / Float(sample_rate)
    let cos_w0: Float = cos(w0)
    let sin_w0: Float = sin(w0)
    let a_lin: Float = pow(10.0, gain_db / 40.0)
    let two_sqrt_a_alpha: Float = 2.0 * sqrt(a_lin) * alpha_from_sin_q(sin_w0, a_lin)
    let a0: Float = (a_lin + 1.0) - ((a_lin - 1.0) * cos_w0) + two_sqrt_a_alpha
    let b0: Float = a_lin * ((a_lin + 1.0) + ((a_lin - 1.0) * cos_w0) + two_sqrt_a_alpha)
    let b1: Float = -2.0 * a_lin * ((a_lin - 1.0) + ((a_lin + 1.0) * cos_w0))
    let b2: Float = a_lin * ((a_lin + 1.0) + ((a_lin - 1.0) * cos_w0) - two_sqrt_a_alpha)
    let a1: Float = 2.0 * ((a_lin - 1.0) - ((a_lin + 1.0) * cos_w0))
    let a2: Float = (a_lin + 1.0) - ((a_lin - 1.0) * cos_w0) - two_sqrt_a_alpha
    return BiquadCoeffs {
        b0: b0 / a0,
        b1: b1 / a0,
        b2: b2 / a0,
        a1: a1 / a0,
        a2: a2 / a0,
    }

// alpha_from_sin_q — RBJ's "alpha" for shelf filters. Q is implicitly 1/sqrt(2).
fn alpha_from_sin_q(sin_w0: Float, a_lin: Float) -> Float with Pure:
    // RBJ shelf alpha: sin(w0)/2 * sqrt((A + 1/A) * (1/S - 1) + 2)
    // where S = shelf slope (typically 1). For S=1 the term under sqrt simplifies.
    return sin_w0 * 0.5 * sqrt((a_lin + 1.0 / a_lin) * 0.0 + 2.0)

// biquad_process — transposed direct form II (1 sample).
// Numerically the most stable form for fixed-point and float biquads.
// state.z1/z2 are updated in-place by the caller.
pub fn biquad_process(coeffs: BiquadCoeffs, state: BiquadState, input: Float) -> BiquadState with Pure:
    let y: Float = (coeffs.b0 * input) + state.z1
    let new_z1: Float = (coeffs.b1 * input) - (coeffs.a1 * y) + state.z2
    let new_z2: Float = (coeffs.b2 * input) - (coeffs.a2 * y)
    return BiquadState { z1: new_z1, z2: new_z2 }

// biquad_onepole_lp — 1-pole lowpass (cheap "smooth" filter).
// Coefficients describe: y[n] = b0*x[n] + b1*x[n-1] - a1*y[n-1]
pub fn biquad_onepole_lp(freq_hz: Float, sample_rate: Int) -> BiquadCoeffs with Pure:
    let sr: Float = Float(sample_rate)
    let fc: Float = freq_hz
    // RC = 1 / (2*pi*fc),   alpha = dt / (RC + dt) = 1 / (1 + 1/(2*pi*fc*dt))
    let dt: Float = 1.0 / sr
    let rc: Float = 1.0 / (DSP_TWO_PI * fc)
    let a: Float = dt / (rc + dt)
    return BiquadCoeffs { b0: a, b1: 0.0, b2: 0.0, a1: 1.0 - a, a2: 0.0 }

// biquad_onepole_hp — 1-pole highpass (DC blocker, ~cutoff freq).
pub fn biquad_onepole_hp(freq_hz: Float, sample_rate: Int) -> BiquadCoeffs with Pure:
    let sr: Float = Float(sample_rate)
    let fc: Float = freq_hz
    let dt: Float = 1.0 / sr
    let rc: Float = 1.0 / (DSP_TWO_PI * fc)
    let a: Float = rc / (rc + dt)
    return BiquadCoeffs { b0: a, b1: -a, b2: 0.0, a1: 0.0, a2: 0.0 }

// ============================================================================
// S V F   F I L T E R   (Chamberlin state-variable filter)
// ============================================================================
//
// The SVF is a 2-pole multimode filter that simultaneously exposes lowpass,
// bandpass, and highpass outputs. It has better modulation behavior than the
// biquad at high cutoff frequencies and is the modern choice for synth filters.
//
// Reference: "Musical Applications of Microprocessors" (Chamberlin, 1980).

pub struct SVFState:
    lp: Float
    bp: Float
    hp: Float

// svf_process — one sample of the trapezoidal SVF.
//   state.lp/bp/hp are caller-owned integrator states.
//   freq_hz must be in (0, sample_rate/2). q is resonance (>0, ~0.5..10 typical).
pub fn svf_process(state: SVFState, input: Float, freq_hz: Float, q: Float, sample_rate: Int) -> SVFState with Pure:
    let f: Float = 2.0 * sin(DSP_PI * freq_hz / Float(sample_rate))
    let damp: Float = 1.0 / q
    let new_hp: Float = input - state.lp - (damp * state.bp)
    let new_bp: Float = state.bp + (f * new_hp)
    let new_lp: Float = state.lp + (f * new_bp)
    return SVFState { lp: new_lp, bp: new_bp, hp: new_hp }

// ============================================================================
// F F T   (radix-2 Cooley-Tukey, in-place)
// ============================================================================
//
// In-place decimation-in-time FFT. n MUST be a power of 2 (use
// next_power_of_two() from std::math if unsure). The function writes
// intermediate results to `imag` for butterfly coefficients; on return `real`
// holds the real spectrum and `imag` holds the imaginary spectrum.
//
// Reference: Numerical Recipes in C, Chapter 12.

pub fn fft_forward(real: ptr<Float>, imag: ptr<Float>, n: Int) -> Int with Pure:
    if n <= 0:
        return DSP_ERR_ZERO_LENGTH
    if (n & (n - 1)) != 0:
        return DSP_ERR_NOT_POWER_OF_2

    fft_bit_reverse_inplace(real, imag, n)

    var size: Int = 2
    while size <= n:
        let half_size: Int = size / 2
        let table_step: Float = -DSP_TWO_PI / Float(size)
        var i: Int = 0
        while i < n:
            var k: Int = 0
            var j: Int = i
            while j < i + half_size:
                let cos_w: Float = cos(Float(k) * table_step)
                let sin_w: Float = sin(Float(k) * table_step)
                let tpre: Float = (cos_w * mem_load(ptr_offset(real, j + half, "Float"), "Float")) - (sin_w * mem_load(ptr_offset(imag, j + half, "Float"), "Float"))
                let tpim: Float = (sin_w * mem_load(ptr_offset(real, j + half, "Float"), "Float")) + (cos_w * mem_load(ptr_offset(imag, j + half, "Float"), "Float"))
                let xr: Float = mem_load(ptr_offset(real, j, "Float"), "Float")
                let xi: Float = mem_load(ptr_offset(imag, j, "Float"), "Float")
                mem_store(ptr_offset(real, j, "Float"), xr + tpre, "Float")
                mem_store(ptr_offset(imag, j, "Float"), xi + tpim, "Float")
                mem_store(ptr_offset(real, j + half, "Float"), xr - tpre, "Float")
                mem_store(ptr_offset(imag, j + half, "Float"), xi - tpim, "Float")
                k = k + 1
                j = j + 1
            i = i + size
        size = size * 2

    return DSP_OK

pub fn fft_inverse(real: ptr<Float>, imag: ptr<Float>, n: Int) -> Int with Pure:
    if n <= 0:
        return DSP_ERR_ZERO_LENGTH
    if (n & (n - 1)) != 0:
        return DSP_ERR_NOT_POWER_OF_2

    // Inverse FFT: conjugate input, forward FFT, conjugate + scale by 1/n.
    var i: Int = 0
    while i < n:
        let v: Float = mem_load(ptr_offset(imag, i, "Float"), "Float")
        mem_store(ptr_offset(imag, i, "Float"), 0.0 - v, "Float")
        i = i + 1

    let r1: Int = fft_forward(real, imag, n)
    if r1 != DSP_OK:
        return r1

    let inv_n: Float = 1.0 / Float(n)
    i = 0
    while i < n:
        let v: Float = mem_load(ptr_offset(imag, i, "Float"), "Float")
        mem_store(ptr_offset(imag, i, "Float"), 0.0 - v, "Float")
        let r: Float = mem_load(ptr_offset(real, i, "Float"), "Float")
        mem_store(ptr_offset(real, i, "Float"), r * inv_n, "Float")
        i = i + 1

    return DSP_OK

// fft_magnitude_spectrum — returns a freshly-allocated ptr<Float> of length n/2+1
// with bin magnitudes. Caller owns the returned pointer (must decay).
pub fn fft_magnitude_spectrum(real: ptr<Float>, imag: ptr<Float>, n: Int) -> ptr<Float> with Unsafe:
    let bins: Int = (n / 2) + 1
    let out_buf: ptr<Float> = alloc_zeroed(bins, "Float")
    var i: Int = 0
    while i < bins:
        let r: Float = mem_load(ptr_offset(real, i, "Float"), "Float")
        let v: Float = mem_load(ptr_offset(imag, i, "Float"), "Float")
        let m: Float = sqrt((r * r) + (v * v))
        mem_store(ptr_offset(out_buf, i, "Float"), m, "Float")
        i = i + 1
    return out_buf

// fft_bit_reverse_inplace — internal helper: bit-reversal permutation.
fn fft_bit_reverse_inplace(real: ptr<Float>, imag: ptr<Float>, n: Int) with Pure:
    var j: Int = 0
    var i: Int = 1
    while i < n:
        let mut bit: Int = n / 2
        while (j & bit) != 0:
            j = j ^ bit
            bit = bit / 2
        j = j ^ bit
        if i < j:
            let tr: Float = mem_load(ptr_offset(real, i, "Float"), "Float")
            let ti: Float = mem_load(ptr_offset(imag, i, "Float"), "Float")
            let jr_r: Float = mem_load(ptr_offset(real, j, "Float"), "Float")
            let jr_i: Float = mem_load(ptr_offset(imag, j, "Float"), "Float")
            mem_store(ptr_offset(real, i, "Float"), jr_r, "Float")
            mem_store(ptr_offset(imag, i, "Float"), jr_i, "Float")
            mem_store(ptr_offset(real, j, "Float"), tr, "Float")
            mem_store(ptr_offset(imag, j, "Float"), ti, "Float")
        i = i + 1

// ============================================================================
// C O N V O L U T I O N
// ============================================================================
//
// Direct FIR convolution is O(N*M) and works fine for short IRs (< 100 taps).
// For long IRs, use convolve_fft which is O((N+M) log (N+M)).
//
// API: we use raw ptr<Float> + Int instead of AudioView/AudioBuffer so dsp.kn
// typechecks without buffer.kn. The signatures match MODULES.md once CHARLIE
// lands — wrappers are trivial.

// convolve_direct — out_len must be signal_len + ir_len - 1.
//   signal_ptr:    [0..signal_len)
//   ir_ptr:        [0..ir_len)
//   out_ptr:       [0..signal_len + ir_len - 1) — caller-allocated
pub fn convolve_direct(signal_ptr: ptr<Float>, signal_len: Int, ir_ptr: ptr<Float>, ir_len: Int, out_ptr: ptr<Float>) -> Int with Unsafe:
    if signal_len <= 0 or ir_len <= 0:
        return DSP_ERR_ZERO_LENGTH
    let out_len: Int = signal_len + ir_len - 1
    var i: Int = 0
    while i < out_len:
        mem_store(ptr_offset(out_ptr, i, "Float"), 0.0, "Float")
        i = i + 1
    i = 0
    while i < signal_len:
        var j: Int = 0
        while j < ir_len:
            let s: Float = mem_load(ptr_offset(signal_ptr, i, "Float"), "Float")
            let h: Float = mem_load(ptr_offset(ir_ptr, j, "Float"), "Float")
            let acc: Float = mem_load(ptr_offset(out_ptr, i + j, "Float"), "Float")
            mem_store(ptr_offset(out_ptr, i + j, "Float"), acc + (s * h), "Float")
            j = j + 1
        i = i + 1
    return DSP_OK

// convolve_fft — overlap-add FFT convolution. Slower for short IRs due to
// FFT overhead; dominates direct only when ir_len > ~64.
//   out_ptr must be allocated to at least (signal_len + ir_len - 1) Floats.
//   scratch_ptr and scratch2_ptr are FFT scratch (each >= next_pow2(signal_len+ir_len-1) * 2).
//   n_fft is the next power of 2 >= (signal_len + ir_len - 1).
pub fn convolve_fft(signal_ptr: ptr<Float>, signal_len: Int, ir_ptr: ptr<Float>, ir_len: Int, out_ptr: ptr<Float>, scratch_ptr: ptr<Float>, scratch2_ptr: ptr<Float>, n_fft: Int) -> Int with Unsafe:
    if signal_len <= 0 or ir_len <= 0:
        return DSP_ERR_ZERO_LENGTH
    if (n_fft & (n_fft - 1)) != 0 or n_fft < (signal_len + ir_len - 1):
        return DSP_ERR_INVALID_PARAM
    // Zero scratch
    var i: Int = 0
    while i < n_fft:
        mem_store(ptr_offset(scratch_ptr, i, "Float"), 0.0, "Float")
        mem_store(ptr_offset(scratch2_ptr, i, "Float"), 0.0, "Float")
        i = i + 1
    // Copy signal + IR into scratch (real parts only)
    i = 0
    while i < signal_len:
        mem_store(ptr_offset(scratch_ptr, i, "Float"), mem_load(ptr_offset(signal_ptr, i, "Float"), "Float"), "Float")
        i = i + 1
    i = 0
    while i < ir_len:
        mem_store(ptr_offset(scratch2_ptr, i, "Float"), mem_load(ptr_offset(ir_ptr, i, "Float"), "Float"), "Float")
        i = i + 1
    // Forward FFT
    let r1: Int = fft_forward(scratch_ptr, scratch2_ptr, n_fft)
    if r1 != DSP_OK:
        return r1
    // Multiply pointwise
    i = 0
    while i < n_fft:
        let ar: Float = mem_load(ptr_offset(scratch_ptr, i, "Float"), "Float")
        let ai: Float = mem_load(ptr_offset(scratch2_ptr, i, "Float"), "Float")
        let br: Float = mem_load(ptr_offset(scratch_ptr, i, "Float"), "Float")
        let bi: Float = mem_load(ptr_offset(scratch2_ptr, i, "Float"), "Float")
        // (a + bi)(b + ki) = (a*b - i*k) + (a*k + b*i)i
        mem_store(ptr_offset(scratch_ptr, i, "Float"), (ar * br) - (ai * bi), "Float")
        mem_store(ptr_offset(scratch2_ptr, i, "Float"), (ar * bi) + (ai * br), "Float")
        i = i + 1
    // Inverse FFT
    let r2: Int = fft_inverse(scratch_ptr, scratch2_ptr, n_fft)
    if r2 != DSP_OK:
        return r2
    // Copy to out
    let out_len: Int = signal_len + ir_len - 1
    i = 0
    while i < out_len:
        mem_store(ptr_offset(out_ptr, i, "Float"), mem_load(ptr_offset(scratch_ptr, i, "Float"), "Float"), "Float")
        i = i + 1
    return DSP_OK

// ============================================================================
// D Y N A M I C S
// ============================================================================

pub struct CompressorState:
    envelope: Float
    hold_samples: Int

// compressor_process — feed-forward RMS compressor with soft knee.
//   threshold_db: level above which compression begins (typically -24..-6)
//   ratio:        compression ratio above threshold (1 = unity, 8 = strong)
//   attack_ms:    time to respond to increases (typical 5..50)
//   release_ms:   time to respond to decreases (typical 50..500)
pub fn compressor_process(state: CompressorState, input: Float, threshold_db: Float, ratio: Float, attack_ms: Float, release_ms: Float, sample_rate: Int) -> Float with Pure:
    let sr: Float = Float(sample_rate)
    // Instantaneous squared envelope (1-pole smoother with separate attack/release).
    let inst_sq: Float = input * input
    let is_attack: Float = if inst_sq > state.envelope: 1.0 else: 0.0
    let att: Float = exp_coeff(attack_ms, sr)
    let rel: Float = exp_coeff(release_ms, sr)
    let coeff: Float = if is_attack > 0.5: att else: rel
    let env: Float = state.envelope + (coeff * (inst_sq - state.envelope))
    let env_db: Float = 10.0 * math_ln(maxf(env, DSP_MIN_AUDIBLE)) / DSP_LN_10
    // Soft knee: 6 dB wide around threshold.
    let knee: Float = 6.0
    let overshoot: Float = env_db - threshold_db
    var gain_reduction_db: Float = 0.0
    if overshoot < -knee * 0.5:
        gain_reduction_db = 0.0
    elif overshoot > knee * 0.5:
        gain_reduction_db = overshoot - (overshoot / ratio)
    else:
        // Linear interpolation across the knee (smooth transition).
        let x: Float = overshoot + (knee * 0.5)
        let gain: Float = (x * x) / (2.0 * knee)
        gain_reduction_db = gain - (gain / ratio)
    let gain: Float = pow(10.0, -gain_reduction_db / 20.0)
    return input * gain

// exp_coeff — exponential smoothing coefficient. time_constant_ms is the
// time to decay to 1/e of initial value.
fn exp_coeff(time_ms: Float, sample_rate: Float) -> Float with Pure:
    if time_ms <= 0.0:
        return 1.0
    return exp_neg(1.0 / (time_ms * 0.001 * sample_rate))

// exp_neg — e^(-x) via std::random::math_ln + identity. We can't call e^x
// directly because std::math has no public `exp`. math_ln is the inverse of
// exp so we can use the Taylor series for e^x around 0.
fn exp_neg(x: Float) -> Float with Pure:
    if x <= 0.0:
        return 1.0
    // e^(-x) = 1 / e^x
    let ex: Float = exp_pos(x)
    if ex <= 0.0:
        return 0.0
    return 1.0 / ex

fn exp_pos(x: Float) -> Float with Pure:
    if x <= 0.0:
        return 1.0
    // Range reduction: e^x = 2^(x/ln2) = 2^k * 2^f
    let k: Float = floor(x / DSP_LN_2)
    let f: Float = x - (k * DSP_LN_2)
    // 2^k = (2^32)^(k/32) = bit-shift trick (skipped for clarity)
    // For small f, use Taylor: 2^f = 1 + f*ln2 + f^2*ln2^2/2 + ...
    let ln2: Float = DSP_LN_2
    let two_to_f: Float = 1.0 + f * ln2 + f * f * (ln2 * ln2 * 0.5) + f * f * f * (ln2 * ln2 * ln2 * 0.1666667)
    // 2^k via integer power of 2 (compile-time known for typical k)
    var k_int: Int = Int(k)
    if k_int < 0:
        k_int = 0
    var pow2: Float = 1.0
    var i: Int = 0
    while i < k_int:
        pow2 = pow2 * 2.0
        i = i + 1
    return pow2 * two_to_f

// limiter_process — simple peak limiter with release. Use for "do not exceed" cases.
pub fn limiter_process(input: Float, threshold_db: Float, release_ms: Float, sample_rate: Int) -> Float with Pure:
    let _ = release_ms
    let _ = sample_rate
    let in_db: Float = 20.0 * math_ln(maxf(absf(input), DSP_MIN_AUDIBLE)) / DSP_LN_10
    if in_db <= threshold_db:
        return input
    let gain_db: Float = threshold_db - in_db
    return input * pow(10.0, gain_db / 20.0)

// gate_process — noise gate: silences signal below threshold with smooth attack/release.
pub fn gate_process(input: Float, threshold_db: Float, attack_ms: Float, release_ms: Float, sample_rate: Int, state: ptr<Float>) -> Float with Pure:
    let sr: Float = Float(sample_rate)
    let env_att: Float = exp_coeff(attack_ms, sr)
    let env_rel: Float = exp_coeff(release_ms, sr)
    let level_db: Float = 20.0 * math_ln(maxf(absf(input), DSP_MIN_AUDIBLE)) / DSP_LN_10
    let s: Float = mem_load(state, "Float")
    let target: Float = if level_db > threshold_db: 1.0 else: 0.0
    let coeff: Float = if target > s: env_att else: env_rel
    let new_s: Float = s + (coeff * (target - s))
    mem_store(state, new_s, "Float")
    return input * new_s

fn maxf(a: Float, b: Float) -> Float with Pure:
    if a > b:
        return a
    return b

fn minf(a: Float, b: Float) -> Float with Pure:
    if a < b:
        return a
    return b

// ============================================================================
// R E V E R B   (Schroeder 1962)
// ============================================================================
//
// Classic 4 parallel comb filters + 2 series allpass filters. Cheap and
// recognizable. Freeverb (Jezar's) is a popular refinement; this is the
// simpler form. Delay times are at prime ratios to the sample rate to avoid
// metallic resonances.

// Private ring buffer (we keep this local to dsp.kn so the module is
// self-contained. When CHARLIE's AudioRingBuffer lands, dsp.kn can switch
// its SchroederReverb to use that type without changing the public API.)
struct DspRingBuffer:
    data: ptr<Float>
    capacity: Int
    write_idx: Int

fn dsp_ring_new(capacity: Int) -> DspRingBuffer with Unsafe:
    let data: ptr<Float> = alloc_zeroed(capacity, "Float")
    return DspRingBuffer { data: data, capacity: capacity, write_idx: 0 }

fn dsp_ring_tick(rb: DspRingBuffer, input: Float) -> Float with Unsafe:
    let w: Int = rb.write_idx
    mem_store(ptr_offset(rb.data, w, "Float"), input, "Float")
    let delayed: Float = mem_load(ptr_offset(rb.data, w, "Float"), "Float")
    var next: Int = w + 1
    if next >= rb.capacity:
        next = 0
    return delayed

fn dsp_ring_advance(rb: DspRingBuffer) -> DspRingBuffer with Unsafe:
    var w: Int = rb.write_idx + 1
    if w >= rb.capacity:
        w = 0
    return DspRingBuffer { data: rb.data, capacity: rb.capacity, write_idx: w }

pub struct SchroederReverb:
    comb_a: DspRingBuffer
    comb_b: DspRingBuffer
    comb_c: DspRingBuffer
    comb_d: DspRingBuffer
    comb_a_g: Float
    comb_b_g: Float
    comb_c_g: Float
    comb_d_g: Float
    allpass_a: DspRingBuffer
    allpass_b: DspRingBuffer
    allpass_a_g: Float
    allpass_b_g: Float

// schroeder_reverb_new — delay times in samples. Defaults are for 25 kHz;
// for 44.1/48 kHz scale them up (use schroeder_reverb_new_for_rate for that).
pub fn schroeder_reverb_new(sample_rate: Int) -> SchroederReverb with Unsafe:
    return schroeder_reverb_new_for_rate(sample_rate, 0.84)

// schroeder_reverb_new_for_rate — scale all delays to a target sample rate
// (relative to 25 kHz reference). decay is the comb feedback gain (0..1).
pub fn schroeder_reverb_new_for_rate(sample_rate: Int, decay_val: Float) -> SchroederReverb with Unsafe:
    let ref_sr: Float = 25000.0
    let sr_f: Float = Float(sample_rate)
    let scale: Float = sr_f / ref_sr
    var d_a: Int = Int(901.0 * scale)
    var d_b: Int = Int(778.0 * scale)
    var d_c: Int = Int(1182.0 * scale)
    var d_d: Int = Int(1392.0 * scale)
    if d_a < 1: d_a = 1
    if d_b < 1: d_b = 1
    if d_c < 1: d_c = 1
    if d_d < 1: d_d = 1
    var d_ap1: Int = Int(480.0 * scale)
    var d_ap2: Int = Int(161.0 * scale)
    if d_ap1 < 1: d_ap1 = 1
    if d_ap2 < 1: d_ap2 = 1
    return SchroederReverb {
        comb_a: dsp_ring_new(d_a),
        comb_b: dsp_ring_new(d_b),
        comb_c: dsp_ring_new(d_c),
        comb_d: dsp_ring_new(d_d),
        comb_a_g: decay_val,
        comb_b_g: decay_val,
        comb_c_g: decay_val,
        comb_d_g: decay_val,
        allpass_a: dsp_ring_new(d_ap1),
        allpass_b: dsp_ring_new(d_ap2),
        allpass_a_g: 0.7,
        allpass_b_g: 0.7,
    }

// schroeder_reverb_process — feed one input sample, returns wet output.
pub fn schroeder_reverb_process(rev: SchroederReverb, input: Float) -> Float with Unsafe:
    // 4 parallel combs, summed, then through 2 series allpasses.
    let a: Float = dsp_ring_tick(rev.comb_a, input + (dsp_ring_read(rev.comb_a) * rev.comb_a_g))
    let b: Float = dsp_ring_tick(rev.comb_b, input + (dsp_ring_read(rev.comb_b) * rev.comb_b_g))
    let c: Float = dsp_ring_tick(rev.comb_c, input + (dsp_ring_read(rev.comb_c) * rev.comb_c_g))
    let d: Float = dsp_ring_tick(rev.comb_d, input + (dsp_ring_read(rev.comb_d) * rev.comb_d_g))
    let comb_sum: Float = (a + b + c + d) * 0.25
    // Allpass: y = -g*x + ring.read; x' = x + g*y; write x'
    let ap1_in: Float = comb_sum
    let ap1_delayed: Float = dsp_ring_read(rev.allpass_a)
    let ap1_y: Float = (0.0 - rev.allpass_a_g) * ap1_in + ap1_delayed
    let _ap1_write: Float = dsp_ring_tick(rev.allpass_a, ap1_in + (rev.allpass_a_g * ap1_y))
    let ap2_in: Float = ap1_y
    let ap2_delayed: Float = dsp_ring_read(rev.allpass_b)
    let ap2_y: Float = (0.0 - rev.allpass_b_g) * ap2_in + ap2_delayed
    let _ap2_write: Float = dsp_ring_tick(rev.allpass_b, ap2_in + (rev.allpass_b_g * ap2_y))
    return ap2_y

fn dsp_ring_read(rb: DspRingBuffer) -> Float with Unsafe:
    return mem_load(ptr_offset(rb.data, rb.write_idx, "Float"), "Float")

// ============================================================================
// E N V E L O P E
// ============================================================================
//
// ADSR state machine for amplitude envelopes (notes/gates).
//   phase: 0 = attack, 1 = decay, 2 = sustain, 3 = release

pub const ADSR_ATTACK: Int = 0
pub const ADSR_DECAY: Int = 1
pub const ADSR_SUSTAIN: Int = 2
pub const ADSR_RELEASE: Int = 3
pub const ADSR_IDLE: Int = 4

pub struct ADSRState:
    phase: Int
    value: Float
    samples_in_phase: Int

// adsr_process — gate=true triggers attack; gate=false triggers release.
pub fn adsr_process(state: ADSRState, gate: Bool, attack_ms: Float, decay_ms: Float, sustain_level: Float, release_ms: Float, sample_rate: Int) -> ADSRState with Pure:
    let sr: Float = Float(sample_rate)
    var next_phase: Int = state.phase
    var next_value: Float = state.value
    var next_samples: Int = state.samples_in_phase + 1

    if gate:
        if state.phase == ADSR_IDLE or state.phase == ADSR_RELEASE:
            next_phase = ADSR_ATTACK
            next_samples = 0
            next_value = 0.0
    else:
        if state.phase != ADSR_IDLE and state.phase != ADSR_RELEASE:
            next_phase = ADSR_RELEASE
            next_samples = 0

    if next_phase == ADSR_ATTACK:
        let att_samples: Int = Int(attack_ms * sr * 0.001)
        if att_samples < 1:
            next_value = 1.0
            next_phase = ADSR_DECAY
            next_samples = 0
        else:
            next_value = Float(next_samples) / Float(att_samples)
            if next_samples >= att_samples:
                next_value = 1.0
                next_phase = ADSR_DECAY
                next_samples = 0
    elif next_phase == ADSR_DECAY:
        let dec_samples: Int = Int(decay_ms * sr * 0.001)
        if dec_samples < 1:
            next_value = sustain_level
            next_phase = ADSR_SUSTAIN
            next_samples = 0
        else:
            let t: Float = Float(next_samples) / Float(dec_samples)
            if t >= 1.0:
                next_value = sustain_level
                next_phase = ADSR_SUSTAIN
                next_samples = 0
            else:
                next_value = 1.0 + t * (sustain_level - 1.0)
    elif next_phase == ADSR_SUSTAIN:
        next_value = sustain_level
    elif next_phase == ADSR_RELEASE:
        let rel_samples: Int = Int(release_ms * sr * 0.001)
        if rel_samples < 1:
            next_value = 0.0
            next_phase = ADSR_IDLE
            next_samples = 0
        else:
            let t: Float = Float(next_samples) / Float(rel_samples)
            if t >= 1.0:
                next_value = 0.0
                next_phase = ADSR_IDLE
                next_samples = 0
            else:
                next_value = sustain_level * (1.0 - t)
    elif next_phase == ADSR_IDLE:
        next_value = 0.0

    return ADSRState { phase: next_phase, value: next_value, samples_in_phase: next_samples }

// envelope_follower — RMS envelope follower. state is a single Float (sum of squares).
pub fn envelope_follower(input: Float, attack_ms: Float, release_ms: Float, sample_rate: Int, state: ptr<Float>) -> Float with Pure:
    let sr: Float = Float(sample_rate)
    let att: Float = exp_coeff(attack_ms, sr)
    let rel: Float = exp_coeff(release_ms, sr)
    let s: Float = mem_load(state, "Float")
    let inst_sq: Float = input * input
    var new_s: Float = s
    if inst_sq > s:
        new_s = s + (att * (inst_sq - s))
    else:
        new_s = s + (rel * (inst_sq - s))
    mem_store(state, new_s, "Float")
    return sqrt(new_s)

// peak_envelope_follower — peak (not RMS) follower. Tracks the absolute peak.
pub fn peak_envelope_follower(input: Float, attack_ms: Float, release_ms: Float, sample_rate: Int, state: ptr<Float>) -> Float with Pure:
    let sr: Float = Float(sample_rate)
    let att: Float = exp_coeff(attack_ms, sr)
    let rel: Float = exp_coeff(release_ms, sr)
    let abs_in: Float = absf(input)
    let s: Float = mem_load(state, "Float")
    var new_s: Float = s
    if abs_in > s:
        new_s = s + (att * (abs_in - s))
    else:
        new_s = s + (rel * (abs_in - s))
    mem_store(state, new_s, "Float")
    return new_s

// ============================================================================
// D E L A Y
// ============================================================================
//
// Single delay line with feedback, plus ping-pong (stereo cross-feedback).

// delay_tap_process — single mono delay with feedback. Self-contained ring buffer.
pub fn delay_tap_process(delay_line: DspRingBuffer, input: Float, delay_ms: Float, feedback: Float, sample_rate: Int) -> Float with Unsafe:
    let _ = sample_rate
    let _ = delay_ms
    let delayed: Float = dsp_ring_read(delay_line)
    let to_write: Float = input + (delayed * feedback)
    let _wrote: Float = dsp_ring_tick(delay_line, to_write)
    return delayed

// delay_ping_pong_process — left/right cross-feedback delay.
// Returns (left_out, right_out) as a tuple.
pub fn delay_ping_pong_process(left_in: Float, right_in: Float, delay_ms: Float, feedback: Float, sample_rate: Int, line_l: DspRingBuffer, line_r: DspRingBuffer) -> (Float, Float) with Unsafe:
    let _ = delay_ms
    let _ = sample_rate
    let delayed_l: Float = dsp_ring_read(line_l)
    let delayed_r: Float = dsp_ring_read(line_r)
    // Cross-feedback: L -> R, R -> L (ping-pong)
    let _w_l: Float = dsp_ring_tick(line_l, right_in + (delayed_l * feedback))
    let _w_r: Float = dsp_ring_tick(line_r, left_in + (delayed_r * feedback))
    return (delayed_l, delayed_r)

// ============================================================================
// M O D U L A T I O N   E F F E C T S
// ============================================================================
//
// All modulation effects share an LFO phase pointer (in [0, 1)) that the
// caller drives with osc_sine/osc_triangle/etc.

// tremolo_process — amplitude modulation by LFO. depth in [0, 1].
pub fn tremolo_process(input: Float, lfo_phase: ptr<Float>, rate_hz: Float, depth: Float, sample_rate: Int) -> Float with Pure:
    let p: Float = mem_load(lfo_phase, "Float")
    let lfo: Float = sin(DSP_TWO_PI * p)
    let gain: Float = 1.0 - (depth * 0.5) + (depth * 0.5 * lfo)
    let inc: Float = rate_hz / Float(sample_rate)
    var next: Float = p + inc
    next = next - floor(next)
    mem_store(lfo_phase, next, "Float")
    return input * gain

// vibrato_process — pitch modulation. width in semitones (0..2 typical).
pub fn vibrato_process(input: Float, lfo_phase: ptr<Float>, rate_hz: Float, width_semitones: Float, sample_rate: Int) -> Float with Pure:
    let p: Float = mem_load(lfo_phase, "Float")
    let lfo: Float = sin(DSP_TWO_PI * p)
    let factor: Float = pow(2.0, (lfo * width_semitones) / 12.0)
    let inc: Float = rate_hz / Float(sample_rate)
    var next: Float = p + inc
    next = next - floor(next)
    mem_store(lfo_phase, next, "Float")
    // Without time-warping this is "static" vibrato. Caller is expected
    // to use a delay line + read-position modulation for real pitch shift;
    // we expose the modulation factor here so the caller can drive a delay.
    return input * factor

// chorus_process — single-tap modulated delay. mix in [0, 1], depth_ms is the
// max LFO delay offset, rate_hz is LFO frequency, base_delay_ms is the
// static delay around which modulation swings.
pub fn chorus_process(input: Float, lfo_phase: ptr<Float>, line_buf: DspRingBuffer, rate_hz: Float, depth_ms: Float, base_delay_ms: Float, mix: Float, sample_rate: Int) -> Float with Unsafe:
    let _ = sample_rate
    let _ = base_delay_ms
    let _ = depth_ms
    let p: Float = mem_load(lfo_phase, "Float")
    let lfo: Float = sin(DSP_TWO_PI * p)
    let inc: Float = rate_hz / Float(sample_rate)
    var next: Float = p + inc
    next = next - floor(next)
    mem_store(lfo_phase, next, "Float")
    let delayed: Float = dsp_ring_read(line_buf)
    let _wrote: Float = dsp_ring_tick(line_buf, input)
    let wet: Float = delayed * (0.5 + 0.5 * lfo)
    return input * (1.0 - mix) + wet * mix

// flanger_process — short modulated delay with feedback (similar to chorus
// but smaller delay range and feedback).
pub fn flanger_process(input: Float, lfo_phase: ptr<Float>, line_buf: DspRingBuffer, rate_hz: Float, feedback: Float, mix: Float, sample_rate: Int) -> Float with Unsafe:
    let _ = sample_rate
    let p: Float = mem_load(lfo_phase, "Float")
    let lfo: Float = sin(DSP_TWO_PI * p)
    let inc: Float = rate_hz / Float(sample_rate)
    var next: Float = p + inc
    next = next - floor(next)
    mem_store(lfo_phase, next, "Float")
    let delayed: Float = dsp_ring_read(line_buf)
    let to_write: Float = input + (delayed * feedback)
    let _wrote: Float = dsp_ring_tick(line_buf, to_write)
    let wet: Float = delayed * (0.5 + 0.5 * lfo)
    return input * (1.0 - mix) + wet * mix

// phaser_process — allpass-stack phaser (caller owns the 4 allpass states).
// We expose the LFO output only; the caller drives the allpass chain.
pub fn phaser_process(lfo_phase: ptr<Float>, rate_hz: Float, sample_rate: Int) -> Float with Pure:
    let p: Float = mem_load(lfo_phase, "Float")
    let lfo: Float = sin(DSP_TWO_PI * p)
    let inc: Float = rate_hz / Float(sample_rate)
    var next: Float = p + inc
    next = next - floor(next)
    mem_store(lfo_phase, next, "Float")
    return lfo

// ============================================================================
// U T I L I T I E S
// ============================================================================

// db_to_linear — convert dB (power ratio) to linear amplitude.
pub fn db_to_linear(db: Float) -> Float with Pure:
    return pow(10.0, db / 20.0)

// linear_to_db — convert linear amplitude to dB. Clamps to DSP_MIN_AUDIBLE.
pub fn linear_to_db(linear: Float) -> Float with Pure:
    if linear <= 0.0:
        return -120.0
    return 20.0 * math_ln(linear) / DSP_LN_10

// midi_to_freq — convert MIDI note number to Hz. A4 (note 69) = tuning_hz.
pub fn midi_to_freq(note: Float, tuning_hz: Float) -> Float with Pure:
    return tuning_hz * pow(2.0, (note - 69.0) / 12.0)

// freq_to_midi — convert Hz to MIDI note number.
pub fn freq_to_midi(freq_hz: Float, tuning_hz: Float) -> Float with Pure:
    if freq_hz <= 0.0 or tuning_hz <= 0.0:
        return 0.0
    return 69.0 + 12.0 * math_ln(freq_hz / tuning_hz) / DSP_LN_2

// pan_equal_power — constant-power panning. pan in [-1, 1].
//   pan = -1 → full left,  pan = 0 → center,  pan = +1 → full right.
// Returns (left_gain, right_gain).
pub fn pan_equal_power(pan: Float) -> (Float, Float) with Pure:
    let clamped: Float = maxf(minf(pan, 1.0), -1.0)
    // sqrt(2)/2 * (cos(theta) + sin(theta)) law, where theta = (pan+1)*pi/4
    let theta: Float = (clamped + 1.0) * (DSP_PI * 0.25)
    let l: Float = cos(theta)
    let r: Float = sin(theta)
    return (l, r)

// pan_linear — linear (equal-amplitude) panning. pan in [-1, 1].
pub fn pan_linear(pan: Float) -> (Float, Float) with Pure:
    let clamped: Float = maxf(minf(pan, 1.0), -1.0)
    let l: Float = 0.5 * (1.0 - clamped)
    let r: Float = 0.5 * (1.0 + clamped)
    return (l, r)

// crossfade — equal-power crossfade. mix in [0, 1] → 0 = a, 1 = b.
pub fn crossfade(a: Float, b: Float, mix: Float) -> Float with Pure:
    let m: Float = maxf(minf(mix, 1.0), 0.0)
    let aw: Float = cos(m * DSP_HALF_PI)
    let bw: Float = sin(m * DSP_HALF_PI)
    return a * aw + b * bw

// dc_blocker — single-pole highpass at ~20 Hz. state is one Float (last input, last output).
pub fn dc_blocker(input: Float, state: ptr<Float>) -> Float with Pure:
    // R = 0.995 (cutoff ~ 35 Hz at 48 kHz; caller should adjust for sample rate).
    let r: Float = 0.995
    let s0: Float = mem_load(state, "Float")
    // y[n] = x[n] - x[n-1] + R * y[n-1]
    let prev_out: Float = mem_load(ptr_offset(state, 1, "Float"), "Float")
    let out_val: Float = input - s0 + (r * prev_out)
    // Update state: first slot = last input, second slot = last output.
    mem_store(state, input, "Float")
    mem_store(ptr_offset(state, 1, "Float"), out_val, "Float")
    return out_val

// polynomial_clipper — soft clipper: f(x) = x - (1/3) * x^3 clamped to [-1, 1].
// Cheaper than tanh and avoids transcendentals.
pub fn polynomial_clipper(input: Float) -> Float with Pure:
    let x2: Float = input * input
    let x3: Float = x2 * input
    let y: Float = input - (x3 * 0.3333333)
    if y > 1.0:
        return 1.0
    if y < -1.0:
        return -1.0
    return y

// tanh_clipper — soft clipper via tanh. Uses std::math::tanh_scalar.
pub fn tanh_clipper(input: Float) -> Float with Pure:
    return tanh_scalar(input)

// ============================================================================
// T E S T   H E L P E R S
// ============================================================================
//
// Public test helpers for the dsp_test suite. NOT in the spec but useful for
// verifying the algorithms. They expose internal state for assertions. These
// functions intentionally use `with Unsafe` (they allocate, decay, and call
// oscillator internals directly).

// dsp_test_osc_sine_period — count samples per cycle at given freq.
// Returns the sample index of the second zero-crossing (period in samples).
pub fn dsp_test_osc_sine_period(freq_hz: Float, sample_rate: Int) -> Int with Unsafe:
    let phase: ptr<Float> = alloc_zeroed(1, "Float")
    defer decay phase
    mem_store(phase, 0.0, "Float")
    var zeros: Int = 0
    var prev: Float = 0.0
    var i: Int = 0
    let total: Int = sample_rate
    while i < total:
        let v: Float = osc_sine(phase, freq_hz, sample_rate)
        if prev <= 0.0 and v > 0.0:
            zeros = zeros + 1
            if zeros == 2:
                return i
        prev = v
        i = i + 1
    return total

// dsp_test_fft_roundtrip — verify forward + inverse preserves input (within EPS).
pub fn dsp_test_fft_roundtrip(n: Int) -> Int with Unsafe:
    let real: ptr<Float> = alloc_zeroed(n, "Float")
    let imag: ptr<Float> = alloc_zeroed(n, "Float")
    defer decay real
    defer decay imag
    var i: Int = 0
    while i < n:
        // Test signal: cosine at bin 3 + sine at bin 5
        let v: Float = cos(DSP_TWO_PI * Float(i) * 3.0 / Float(n)) + sin(DSP_TWO_PI * Float(i) * 5.0 / Float(n))
        mem_store(ptr_offset(real, i, "Float"), v, "Float")
        i = i + 1
    let r1: Int = fft_forward(real, imag, n)
    if r1 != DSP_OK:
        return r1
    let r2: Int = fft_inverse(real, imag, n)
    if r2 != DSP_OK:
        return r2
    return DSP_OK

// dsp_test_biquad_dc_gain — verify a 100 Hz lowpass passes DC (unity at 0 Hz).
// Returns DSP_OK if gain is within 0.01 of 1.0.
pub fn dsp_test_biquad_dc_gain() -> Int with Pure:
    let coeffs: BiquadCoeffs = biquad_lowpass(100.0, 0.707, 48000)
    // DC: y = (b0 + b1 + b2) / (1 + a1 + a2)
    let num: Float = coeffs.b0 + coeffs.b1 + coeffs.b2
    let den: Float = 1.0 + coeffs.a1 + coeffs.a2
    if den == 0.0:
        return -1
    let gain: Float = num / den
    // Should be ~1.0
    let diff: Float = absf(gain - 1.0)
    if diff > 0.01:
        return -2
    return DSP_OK

// dsp_test_db_linear — verify db_to_linear roundtrip.
pub fn dsp_test_db_linear() -> Int with Pure:
    if absf(db_to_linear(0.0) - 1.0) > 0.0001:
        return -1
    let v: Float = db_to_linear(-6.0)
    if absf(v - 0.501187) > 0.001:
        return -2
    if absf(linear_to_db(1.0)) > 0.0001:
        return -3
    if absf(linear_to_db(0.5) - (-6.0206)) > 0.01:
        return -4
    return DSP_OK

// dsp_test_midi_freq — A4 = 440 Hz, A5 = 880 Hz, C4 = ~261.63 Hz.
pub fn dsp_test_midi_freq() -> Int with Pure:
    let a4: Float = midi_to_freq(69.0, 440.0)
    if absf(a4 - 440.0) > 0.01:
        return -1
    let a5: Float = midi_to_freq(81.0, 440.0)
    if absf(a5 - 880.0) > 0.01:
        return -2
    let c4: Float = midi_to_freq(60.0, 440.0)
    if absf(c4 - 261.6256) > 0.01:
        return -3
    // Round-trip
    let n: Float = freq_to_midi(440.0, 440.0)
    if absf(n - 69.0) > 0.001:
        return -4
    return DSP_OK

// dsp_test_pan — equal power pan should sum to ~1.0 at any position.
pub fn dsp_test_pan() -> Int with Pure:
    let l0: Float = 1.0
    let r0: Float = 0.0
    let (la, ra) = pan_equal_power(0.0)
    if absf(la - l0) > 0.01 or absf(ra - r0) > 0.01:
        return -1
    // Center: both ~0.707
    let (lc, rc) = pan_equal_power(0.0)
    let s: Float = (lc * lc) + (rc * rc)
    if absf(s - 1.0) > 0.01:
        return -2
    return DSP_OK

// dsp_test_suite — runs all internal tests. Returns 0 if all pass.
pub fn dsp_test_suite() -> Int with Unsafe:
    let r1: Int = dsp_test_db_linear()
    if r1 != DSP_OK:
        return r1
    let r2: Int = dsp_test_midi_freq()
    if r2 != DSP_OK:
        return r2
    let r3: Int = dsp_test_pan()
    if r3 != DSP_OK:
        return r3
    let r4: Int = dsp_test_biquad_dc_gain()
    if r4 != DSP_OK:
        return r4
    let r5: Int = dsp_test_osc_sine_period(440.0, 44100)
    // 440 Hz at 44100 sr: period = 44100/440 = 100.23 samples
    if r5 < 99 or r5 > 102:
        return r5
    let r6: Int = dsp_test_fft_roundtrip(64)
    if r6 != DSP_OK:
        return r6
    return DSP_OK

// ============================================================================
// audio/entangle.kn
// ============================================================================
// entangle.kn — UI State Mirrors (std::audio Phase 2)
//
// Layer: L1 (entangle — bidirectional state sync with single_writer)
//
// MixerUIMirror is a display-only copy of MixerWorld. The audio
// thread writes to MixerWorld via patches; the UI thread reads from
// MixerUIMirror. The `entangle` declaration tells the compiler to
// propagate every write to the bound source field to the bound
// destination field on the mirror, under the `single_writer` policy.
//
// `single_writer` means ONLY the source world (MixerWorld) is allowed
// to write the field; the mirror receives propagated copies. The
// compiler verifies this at typecheck time and at runtime tracks
// `entangle_propagation_count()` for telemetry.
//
// Field naming convention: `<source>_display` on the mirror.

use std::audio::world
use std::sync

// ============================================================================
// Constants
// ============================================================================

pub const ENTANGLE_OK:            Int = 0
pub const ENTANGLE_ERR_NOT_INIT:  Int = -1
pub const ENTANGLE_ERR_TYPE:      Int = -2
pub const ENTANGLE_ERR_DISABLED:  Int = -3

pub const MIRROR_DEFAULT_VOLUME:    Float = 1.0
pub const MIRROR_DEFAULT_PEAK:      Float = 0.0
pub const MIRROR_DEFAULT_TRANSPORT: Int = 0
pub const MIRROR_DEFAULT_POSITION:  Int = 0
pub const MIRROR_DEFAULT_CPU:       Float = 0.0

pub const MIRROR_UI_REFRESH_HZ: Int = 60

// ============================================================================
// M I X E R   U I   M I R R O R
// ============================================================================
//
// Display-only copy of MixerWorld. Every field on the mirror has a
// corresponding field on MixerWorld via an entangle binding. The
// mirror has NO patches; the only way its fields change is via
// entangle propagation from MixerWorld.

world MixerUIMirror:
    state master_volume_display: Float = MIRROR_DEFAULT_VOLUME
    state master_mute_display: Bool = false
    state solo_channel_display: Int = -1
    state transport_state_display: Int = MIRROR_DEFAULT_TRANSPORT
    state position_display_frames: Int = MIRROR_DEFAULT_POSITION
    state loop_start_display: Int = 0
    state loop_end_display: Int = 0
    state loop_enabled_display: Bool = false
    state sample_rate_display: Int = 44100
    state buffer_size_display: Int = 256
    state tempo_bpm_display: Float = 120.0
    state time_sig_num_display: Int = 4
    state time_sig_den_display: Int = 4
    state peak_left_display: Float = MIRROR_DEFAULT_PEAK
    state peak_right_display: Float = MIRROR_DEFAULT_PEAK
    state rms_left_display: Float = MIRROR_DEFAULT_PEAK
    state rms_right_display: Float = MIRROR_DEFAULT_PEAK
    state cpu_load_display: Float = MIRROR_DEFAULT_CPU
    surface web => MixerPanelDisplay
    surface native_ui => MixerPanelDisplay

// MixerPanelDisplay — UI surface component stub.
component MixerPanelDisplay():
    state frame_count: Int = 0
    render <panel title="Kain Audio Mixer (Mirror)" />

// ============================================================================
// E N T A N G L E   B I N D I N G S
// ============================================================================

entangle MixerWorld.master_volume <-> MixerUIMirror.master_volume_display with single_writer
entangle MixerWorld.master_mute <-> MixerUIMirror.master_mute_display with single_writer
entangle MixerWorld.master_solo_channel <-> MixerUIMirror.solo_channel_display with single_writer
entangle MixerWorld.transport_state <-> MixerUIMirror.transport_state_display with single_writer
entangle MixerWorld.transport_position_frames <-> MixerUIMirror.position_display_frames with single_writer
entangle MixerWorld.transport_loop_start <-> MixerUIMirror.loop_start_display with single_writer
entangle MixerWorld.transport_loop_end <-> MixerUIMirror.loop_end_display with single_writer
entangle MixerWorld.transport_loop_enabled <-> MixerUIMirror.loop_enabled_display with single_writer
entangle MixerWorld.sample_rate <-> MixerUIMirror.sample_rate_display with single_writer
entangle MixerWorld.buffer_size_frames <-> MixerUIMirror.buffer_size_display with single_writer
entangle MixerWorld.tempo_bpm <-> MixerUIMirror.tempo_bpm_display with single_writer
entangle MixerWorld.time_signature_numerator <-> MixerUIMirror.time_sig_num_display with single_writer
entangle MixerWorld.time_signature_denominator <-> MixerUIMirror.time_sig_den_display with single_writer
entangle MixerWorld.peak_left <-> MixerUIMirror.peak_left_display with single_writer
entangle MixerWorld.peak_right <-> MixerUIMirror.peak_right_display with single_writer
entangle MixerWorld.rms_left <-> MixerUIMirror.rms_left_display with single_writer
entangle MixerWorld.rms_right <-> MixerUIMirror.rms_right_display with single_writer
entangle MixerWorld.cpu_load_percent <-> MixerUIMirror.cpu_load_display with single_writer

// ============================================================================
// M I R R O R   A C C E S S O R S
// ============================================================================

pub fn mirror_master_volume() -> Float with Pure:
    return MixerUIMirror.master_volume_display

pub fn mirror_master_mute() -> Bool with Pure:
    return MixerUIMirror.master_mute_display

pub fn mirror_solo_channel() -> Int with Pure:
    return MixerUIMirror.solo_channel_display

pub fn mirror_transport_state() -> Int with Pure:
    return MixerUIMirror.transport_state_display

pub fn mirror_position_frames() -> Int with Pure:
    return MixerUIMirror.position_display_frames

pub fn mirror_loop_start() -> Int with Pure:
    return MixerUIMirror.loop_start_display

pub fn mirror_loop_end() -> Int with Pure:
    return MixerUIMirror.loop_end_display

pub fn mirror_loop_enabled() -> Bool with Pure:
    return MixerUIMirror.loop_enabled_display

pub fn mirror_sample_rate() -> Int with Pure:
    return MixerUIMirror.sample_rate_display

pub fn mirror_buffer_size() -> Int with Pure:
    return MixerUIMirror.buffer_size_display

pub fn mirror_tempo_bpm() -> Float with Pure:
    return MixerUIMirror.tempo_bpm_display

pub fn mirror_time_sig_num() -> Int with Pure:
    return MixerUIMirror.time_sig_num_display

pub fn mirror_time_sig_den() -> Int with Pure:
    return MixerUIMirror.time_sig_den_display

pub fn mirror_peak_left() -> Float with Pure:
    return MixerUIMirror.peak_left_display

pub fn mirror_peak_right() -> Float with Pure:
    return MixerUIMirror.peak_right_display

pub fn mirror_rms_left() -> Float with Pure:
    return MixerUIMirror.rms_left_display

pub fn mirror_rms_right() -> Float with Pure:
    return MixerUIMirror.rms_right_display

pub fn mirror_cpu_load() -> Float with Pure:
    return MixerUIMirror.cpu_load_display

// mirror_is_stale — returns true if the mirror's last propagation
// is older than `max_age_ms`. Real impl reads runtime timestamp.
pub fn mirror_is_stale(max_age_ms: Int) -> Bool with Pure:
    if max_age_ms < 0:
        return true
    return false

// mirror_propagation_count — return the runtime's count of
// successful entangle propagations.
pub fn mirror_propagation_count() -> Int with Pure:
    return 0

// ============================================================================
// End of entangle.kn
// ============================================================================

// ============================================================================
// audio/file.kn
// ============================================================================
// file.kn — Audio File I/O (std::audio Phase 1)
//
// Layer: L0 (plain code — backed by std::fs for raw I/O)
//
// Read and write audio files. Phase 1 supports WAV (uncompressed PCM)
// — the baseline format for sample loading and export. Phase 2 adds
// FLAC, MP3, OGG, AIFF.
//
// The WAV parser handles 8-bit unsigned, 16-bit signed, 24-bit packed,
// 32-bit signed, and 32-bit float. Output buffers are always 32-bit
// float (the canonical DSP format). The sample_format field on the
// returned AudioBuffer records the source format for round-tripping
// metadata.
//
// All file I/O delegates to std::fs. No direct C headers, no manual
// file handle juggling.

use std::fs
use std::audio::buffer

// ============================================================================
// Constants — Status Codes
// ============================================================================

pub const FILE_OK:               Int = 0
pub const FILE_ERR_OPEN:         Int = -1
pub const FILE_ERR_READ:         Int = -2
pub const FILE_ERR_INVALID_WAV:  Int = -3
pub const FILE_ERR_UNSUPPORTED:  Int = -4
pub const FILE_ERR_WRITE:        Int = -5
pub const FILE_ERR_BUFFER_EMPTY: Int = -6
pub const FILE_ERR_TRUNCATED:    Int = -7

// ============================================================================
// Constants — WAV File Format
// ============================================================================

// RIFF / WAVE magic numbers
pub const WAV_RIFF_MAGIC: Int = 0x52494646     # "RIFF" as big-endian int
pub const WAV_WAVE_MAGIC: Int = 0x57415645     # "WAVE" as big-endian int
pub const WAV_FMT_MAGIC:  Int = 0x666D7420     # "fmt " as big-endian int (with trailing space)
pub const WAV_DATA_MAGIC: Int = 0x64617461     # "data" as big-endian int

// WAV format codes
pub const WAV_FMT_PCM:        Int = 0x0001
pub const WAV_FMT_IEEE_FLOAT: Int = 0x0003
pub const WAV_FMT_EXTENSIBLE: Int = 0xFFFE

// Bit depths supported
pub const WAV_BITS_8:  Int = 8
pub const WAV_BITS_16: Int = 16
pub const WAV_BITS_24: Int = 24
pub const WAV_BITS_32: Int = 32

// Sample format encoding (matches AudioSampleFormat)
pub const SAMPLE_FMT_F32: Int = 0
pub const SAMPLE_FMT_S16: Int = 1
pub const SAMPLE_FMT_S24: Int = 2
pub const SAMPLE_FMT_S32: Int = 3
pub const SAMPLE_FMT_U8:  Int = 4

// Standard sample rates
pub const SAMPLE_RATE_44100: Int = 44100
pub const SAMPLE_RATE_48000: Int = 48000

// Header layout offsets (in bytes)
pub const WAV_RIFF_OFFSET:        Int = 0
pub const WAV_RIFF_SIZE_OFFSET:   Int = 4
pub const WAV_WAVE_OFFSET:        Int = 8
pub const WAV_CHUNK_ID_OFFSET:    Int = 0
pub const WAV_CHUNK_SIZE_OFFSET:  Int = 4
pub const WAV_CHUNK_DATA_OFFSET:  Int = 8
pub const WAV_FMT_CHUNK_SIZE_MIN: Int = 16
pub const WAV_FMT_FMT_OFFSET:     Int = 8
pub const WAV_FMT_CHAN_OFFSET:    Int = 10
pub const WAV_FMT_RATE_OFFSET:    Int = 12
pub const WAV_FMT_BYTERATE_OFFSET: Int = 16
pub const WAV_FMT_BLOCKALIGN_OFFSET: Int = 20
pub const WAV_FMT_BPS_OFFSET:     Int = 22

// Sentinel for invalid / missing data
pub const INVALID_OFFSET: Int = -1
pub const INT24_SIGN_BIT: Int = 0x800000

// Conversion denominators
pub const S16_TO_F32_DIVISOR: Float = 32768.0
pub const S24_TO_F32_DIVISOR: Float = 8388608.0
pub const S24_PACKED_MAX: Int = 8388607       # 2^23 - 1
pub const S24_PACKED_MIN: Int = -8388608      # -2^23
pub const S32_TO_F32_DIVISOR: Float = 2147483648.0
pub const U8_TO_F32_OFFSET: Float = 128.0
pub const U8_TO_F32_DIVISOR: Float = 128.0

// ============================================================================
// B Y T E   H E L P E R S
// ============================================================================

// file_read_byte_at — read one byte from an Array<Int> at offset.
// Returns -1 if out_bytes of range.
fn file_read_byte_at(bytes: Array<Int>, offset: Int) -> Int with Pure:
    if offset < 0:
        return -1
    if offset >= bytes.length:
        return -1
    let b: Int = bytes[offset]
    return b & 0xFF

// file_read_u16_le — read little-endian uint16 at offset.
fn file_read_u16_le(bytes: Array<Int>, offset: Int) -> Int with Pure:
    let lo: Int = file_read_byte_at(bytes, offset)
    let hi: Int = file_read_byte_at(bytes, offset + 1)
    if lo < 0 or hi < 0:
        return -1
    return lo + (hi * 256)

// file_read_u32_le — read little-endian uint32 at offset.
fn file_read_u32_le(bytes: Array<Int>, offset: Int) -> Int with Pure:
    let b0: Int = file_read_byte_at(bytes, offset)
    let b1: Int = file_read_byte_at(bytes, offset + 1)
    let b2: Int = file_read_byte_at(bytes, offset + 2)
    let b3: Int = file_read_byte_at(bytes, offset + 3)
    if b0 < 0 or b1 < 0 or b2 < 0 or b3 < 0:
        return -1
    return b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216)

// file_read_chunk_id — read 4 bytes as big-endian int ("RIFF", "fmt ", etc.).
fn file_read_chunk_id(bytes: Array<Int>, offset: Int) -> Int with Pure:
    let b0: Int = file_read_byte_at(bytes, offset)
    let b1: Int = file_read_byte_at(bytes, offset + 1)
    let b2: Int = file_read_byte_at(bytes, offset + 2)
    let b3: Int = file_read_byte_at(bytes, offset + 3)
    if b0 < 0 or b1 < 0 or b2 < 0 or b3 < 0:
        return -1
    return (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3

// ============================================================================
// W A V   P A R S E R
// ============================================================================

// wav_read — read a WAV file into an AudioBuffer.
// Returns an empty buffer (frames = 0) on error. Supports 8-bit unsigned,
// 16-bit signed, 24-bit packed, 32-bit signed, and 32-bit float.
pub fn wav_read(path: String) -> AudioBuffer with Unsafe:
    if fs_exists(path) == false:
        return wav_empty_buffer()

    let bytes: Array<Int> = fs_read_bytes(path)
    if bytes.length < WAV_CHUNK_DATA_OFFSET:
        return wav_empty_buffer()

    # Validate RIFF / WAVE header
    let riff_id: Int = file_read_chunk_id(bytes, WAV_RIFF_OFFSET)
    if riff_id != WAV_RIFF_MAGIC:
        return wav_empty_buffer()
    let wave_id: Int = file_read_chunk_id(bytes, WAV_WAVE_OFFSET)
    if wave_id != WAV_WAVE_MAGIC:
        return wav_empty_buffer()

    # Walk chunks starting at offset 12 (after RIFF header)
    var offset: Int = 12
    var fmt_code: Int = 0
    var channels: Int = 0
    var sample_rate: Int = 0
    var bits_per_sample: Int = 0
    var data_offset: Int = INVALID_OFFSET
    var data_size: Int = 0
    var loop_ok: Bool = true
    while loop_ok:
        if offset + 8 > bytes.length:
            loop_ok = false
        else:
            let chunk_id: Int = file_read_chunk_id(bytes, offset)
            let chunk_size: Int = file_read_u32_le(bytes, offset + 4)
            if chunk_id == WAV_FMT_MAGIC:
                fmt_code = file_read_u16_le(bytes, offset + WAV_FMT_FMT_OFFSET)
                channels = file_read_u16_le(bytes, offset + WAV_FMT_CHAN_OFFSET)
                sample_rate = file_read_u32_le(bytes, offset + WAV_FMT_RATE_OFFSET)
                bits_per_sample = file_read_u16_le(bytes, offset + WAV_FMT_BPS_OFFSET)
            elif chunk_id == WAV_DATA_MAGIC:
                data_offset = offset + WAV_CHUNK_DATA_OFFSET
                data_size = chunk_size
                loop_ok = false
            # Skip to next chunk (chunks are word-aligned)
            var next_offset: Int = offset + 8 + chunk_size
            if (chunk_size & 1) == 1:
                next_offset = next_offset + 1
            offset = next_offset

    if data_offset == INVALID_OFFSET:
        return wav_empty_buffer()
    if channels < 1 or sample_rate < 1 or bits_per_sample < 1:
        return wav_empty_buffer()

    # Decode samples into float32
    let bytes_per_sample: Int = bits_per_sample / 8
    let total_samples: Int = data_size / bytes_per_sample
    let frames: Int = total_samples / channels
    if frames < 1:
        return wav_empty_buffer()

    let fmt: AudioFormat = wav_format_new(sample_rate, channels, wav_sample_format_from_bits(bits_per_sample, fmt_code))
    let buf: AudioBuffer = audio_buffer_new(frames, fmt)
    let dst: ptr<Float> = buf.data

    # Copy / decode samples
    if bits_per_sample == 16:
        wav_decode_s16(bytes, data_offset, channels, frames, dst)
    elif bits_per_sample == 24:
        wav_decode_s24(bytes, data_offset, channels, frames, dst)
    elif bits_per_sample == 32 and fmt_code == WAV_FMT_IEEE_FLOAT:
        wav_decode_f32(bytes, data_offset, channels, frames, dst)
    elif bits_per_sample == 32:
        wav_decode_s32(bytes, data_offset, channels, frames, dst)
    elif bits_per_sample == 8:
        wav_decode_u8(bytes, data_offset, channels, frames, dst)
    else:
        # Unsupported — return empty buffer
        let _drop: Int = audio_buffer_destroy(buf)
        return wav_empty_buffer()

    return buf

// wav_read_info — read the WAV header without loading samples.
pub fn wav_read_info(path: String) -> AudioFormat with Unsafe:
    if fs_exists(path) == false:
        return wav_format_empty()

    let bytes: Array<Int> = fs_read_bytes(path)
    if bytes.length < WAV_CHUNK_DATA_OFFSET:
        return wav_format_empty()

    let riff_id: Int = file_read_chunk_id(bytes, WAV_RIFF_OFFSET)
    if riff_id != WAV_RIFF_MAGIC:
        return wav_format_empty()
    let wave_id: Int = file_read_chunk_id(bytes, WAV_WAVE_OFFSET)
    if wave_id != WAV_WAVE_MAGIC:
        return wav_format_empty()

    var offset: Int = 12
    var fmt_code: Int = 0
    var channels: Int = 0
    var sample_rate: Int = 0
    var bits_per_sample: Int = 0
    var found: Bool = false
    var loop_ok: Bool = true
    while loop_ok and found == false:
        if offset + 8 > bytes.length:
            loop_ok = false
        else:
            let chunk_id: Int = file_read_chunk_id(bytes, offset)
            let chunk_size: Int = file_read_u32_le(bytes, offset + 4)
            if chunk_id == WAV_FMT_MAGIC:
                fmt_code = file_read_u16_le(bytes, offset + WAV_FMT_FMT_OFFSET)
                channels = file_read_u16_le(bytes, offset + WAV_FMT_CHAN_OFFSET)
                sample_rate = file_read_u32_le(bytes, offset + WAV_FMT_RATE_OFFSET)
                bits_per_sample = file_read_u16_le(bytes, offset + WAV_FMT_BPS_OFFSET)
                found = true
            var next_offset: Int = offset + 8 + chunk_size
            if (chunk_size & 1) == 1:
                next_offset = next_offset + 1
            offset = next_offset

    if found == false:
        return wav_format_empty()
    if channels < 1 or sample_rate < 1 or bits_per_sample < 1:
        return wav_format_empty()

    return wav_format_new(sample_rate, channels, wav_sample_format_from_bits(bits_per_sample, fmt_code))

// wav_duration_ms — return the duration of a WAV file in milliseconds.
// Reads only the header.
pub fn wav_duration_ms(path: String) -> Int with Unsafe:
    if fs_exists(path) == false:
        return 0

    let bytes: Array<Int> = fs_read_bytes(path)
    if bytes.length < WAV_CHUNK_DATA_OFFSET:
        return 0

    let riff_id: Int = file_read_chunk_id(bytes, WAV_RIFF_OFFSET)
    if riff_id != WAV_RIFF_MAGIC:
        return 0
    let wave_id: Int = file_read_chunk_id(bytes, WAV_WAVE_OFFSET)
    if wave_id != WAV_WAVE_MAGIC:
        return 0

    var offset: Int = 12
    var channels: Int = 0
    var sample_rate: Int = 0
    var bits_per_sample: Int = 0
    var data_size: Int = 0
    var loop_ok: Bool = true
    var found_data: Bool = false
    while loop_ok:
        if offset + 8 > bytes.length:
            loop_ok = false
        else:
            let chunk_id: Int = file_read_chunk_id(bytes, offset)
            let chunk_size: Int = file_read_u32_le(bytes, offset + 4)
            if chunk_id == WAV_FMT_MAGIC:
                channels = file_read_u16_le(bytes, offset + WAV_FMT_CHAN_OFFSET)
                sample_rate = file_read_u32_le(bytes, offset + WAV_FMT_RATE_OFFSET)
                bits_per_sample = file_read_u16_le(bytes, offset + WAV_FMT_BPS_OFFSET)
            elif chunk_id == WAV_DATA_MAGIC:
                data_size = chunk_size
                found_data = true
                loop_ok = false
            var next_offset: Int = offset + 8 + chunk_size
            if (chunk_size & 1) == 1:
                next_offset = next_offset + 1
            offset = next_offset

    if found_data == false or sample_rate < 1 or channels < 1 or bits_per_sample < 1:
        return 0
    let bytes_per_sample: Int = bits_per_sample / 8
    let total_samples: Int = data_size / bytes_per_sample
    let frames: Int = total_samples / channels
    if frames < 1:
        return 0
    return (frames * 1000) / sample_rate

// wav_write — write an AudioBuffer to a WAV file at the given bit depth.
// bit_depth must be 16, 24, or 32 (8 is read-only). The function converts
// from f32 to the requested integer format and writes the WAV header.
pub fn wav_write(path: String, buf: AudioBuffer, bit_depth: Int) -> Int with Unsafe:
    if buf.data == buf.data and ptr_to_int(buf.data) == 0:
        return FILE_ERR_BUFFER_EMPTY
    if buf.frames < 1 or buf.format.channels < 1:
        return FILE_ERR_BUFFER_EMPTY
    if bit_depth != 16 and bit_depth != 24 and bit_depth != 32:
        return FILE_ERR_UNSUPPORTED

    let sample_rate: Int = buf.format.sample_rate
    let channels: Int = buf.format.channels
    let frames: Int = buf.frames
    let total_samples: Int = frames * channels
    let bytes_per_sample: Int = bit_depth / 8
    let data_size: Int = total_samples * bytes_per_sample
    let fmt_code: Int = WAV_FMT_PCM
    let byte_rate: Int = sample_rate * channels * bytes_per_sample
    let block_align: Int = channels * bytes_per_sample

    # Allocate the file buffer
    let header_size: Int = 44
    let file_size: Int = header_size + data_size
    let out_bytes: Array<Int> = wav_alloc_bytes(file_size)

    # RIFF header
    wav_write_u32_be(out_bytes, WAV_RIFF_OFFSET, WAV_RIFF_MAGIC)
    wav_write_u32_le(out_bytes, WAV_RIFF_SIZE_OFFSET, file_size - 8)
    wav_write_u32_be(out_bytes, WAV_WAVE_OFFSET, WAV_WAVE_MAGIC)

    # fmt chunk
    wav_write_u32_be(out_bytes, 12, WAV_FMT_MAGIC)
    wav_write_u32_le(out_bytes, 16, 16)
    wav_write_u16_le(out_bytes, 20, fmt_code)
    wav_write_u16_le(out_bytes, 22, channels)
    wav_write_u32_le(out_bytes, 24, sample_rate)
    wav_write_u32_le(out_bytes, 28, byte_rate)
    wav_write_u16_le(out_bytes, 32, block_align)
    wav_write_u16_le(out_bytes, 34, bit_depth)

    # data chunk
    wav_write_u32_be(out_bytes, 36, WAV_DATA_MAGIC)
    wav_write_u32_le(out_bytes, 40, data_size)

    # Sample data
    if bit_depth == 16:
        wav_encode_s16(buf, total_samples, out_bytes, header_size)
    elif bit_depth == 24:
        wav_encode_s24(buf, total_samples, out_bytes, header_size)
    else:
        wav_encode_s32(buf, total_samples, out_bytes, header_size)

    # Write the file
    fs_write_bytes(path, out_bytes)
    return FILE_OK

// ============================================================================
// S A M P L E   D E C O D E   /   E N C O D E
// ============================================================================

// wav_decode_s16 — decode signed 16-bit samples to float32 in-place.
fn wav_decode_s16(bytes: Array<Int>, data_offset: Int, channels: Int, frames: Int, dst: ptr<Float>) -> Void:
    let total: Int = frames * channels
    var i: Int = 0
    while i < total:
        let s: Int = file_read_u16_le(bytes, data_offset + (i * 2))
        var signed_val: Int = s
        if signed_val >= 32768:
            signed_val = signed_val - 65536
        let sample_f: Float = Float(signed_val) / S16_TO_F32_DIVISOR
        mem_store(ptr_offset(dst, i, "Float"), sample_f, "Float")
        i = i + 1

// wav_decode_s24 — decode signed 24-bit packed (LSB first) to float32.
fn wav_decode_s24(bytes: Array<Int>, data_offset: Int, channels: Int, frames: Int, dst: ptr<Float>) -> Void:
    let total: Int = frames * channels
    var i: Int = 0
    while i < total:
        let b0: Int = file_read_byte_at(bytes, data_offset + (i * 3))
        let b1: Int = file_read_byte_at(bytes, data_offset + (i * 3) + 1)
        let b2: Int = file_read_byte_at(bytes, data_offset + (i * 3) + 2)
        if b0 < 0 or b1 < 0 or b2 < 0:
            mem_store(ptr_offset(dst, i, "Float"), 0.0, "Float")
        else:
            var raw: Int = b0 + (b1 * 256) + (b2 * 65536)
            if (raw & INT24_SIGN_BIT) != 0:
                raw = raw - 16777216
            if raw > S24_PACKED_MAX:
                raw = S24_PACKED_MAX
            if raw < S24_PACKED_MIN:
                raw = S24_PACKED_MIN
            let sample_f: Float = Float(raw) / S24_TO_F32_DIVISOR
            mem_store(ptr_offset(dst, i, "Float"), sample_f, "Float")
        i = i + 1

// wav_decode_s32 — decode signed 32-bit samples to float32.
fn wav_decode_s32(bytes: Array<Int>, data_offset: Int, channels: Int, frames: Int, dst: ptr<Float>) -> Void:
    let total: Int = frames * channels
    var i: Int = 0
    while i < total:
        let s: Int = file_read_u32_le(bytes, data_offset + (i * 4))
        let sample_f: Float = Float(s) / S32_TO_F32_DIVISOR
        mem_store(ptr_offset(dst, i, "Float"), sample_f, "Float")
        i = i + 1

// wav_decode_f32 — copy 32-bit IEEE float samples directly.
fn wav_decode_f32(bytes: Array<Int>, data_offset: Int, channels: Int, frames: Int, dst: ptr<Float>) -> Void:
    let total: Int = frames * channels
    var i: Int = 0
    while i < total:
        # Read 4 bytes as an IEEE 754 float (little-endian)
        let b0: Int = file_read_byte_at(bytes, data_offset + (i * 4))
        let b1: Int = file_read_byte_at(bytes, data_offset + (i * 4) + 1)
        let b2: Int = file_read_byte_at(bytes, data_offset + (i * 4) + 2)
        let b3: Int = file_read_byte_at(bytes, data_offset + (i * 4) + 3)
        if b0 < 0 or b1 < 0 or b2 < 0 or b3 < 0:
            mem_store(ptr_offset(dst, i, "Float"), 0.0, "Float")
        else:
            # We rely on Kain's bit-cast semantics: re-interpret the
            # 32-bit pattern as an IEEE 754 float. Kain stores Float as
            # 32 bits so the byte pattern is preserved.
            let bits: Int = b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216)
            let bits_ptr: ptr<Float> = int_to_ptr(bits, "Float")
            let sample_f: Float = mem_load(bits_ptr, "Float")
            mem_store(ptr_offset(dst, i, "Float"), sample_f, "Float")
        i = i + 1

// wav_decode_u8 — decode unsigned 8-bit samples (centered at 128) to float32.
fn wav_decode_u8(bytes: Array<Int>, data_offset: Int, channels: Int, frames: Int, dst: ptr<Float>) -> Void:
    let total: Int = frames * channels
    var i: Int = 0
    while i < total:
        let u: Int = file_read_byte_at(bytes, data_offset + i)
        if u < 0:
            mem_store(ptr_offset(dst, i, "Float"), 0.0, "Float")
        else:
            let sample_f: Float = (Float(u) - U8_TO_F32_OFFSET) / U8_TO_F32_DIVISOR
            mem_store(ptr_offset(dst, i, "Float"), sample_f, "Float")
        i = i + 1

// wav_encode_s16 — encode float32 samples to signed 16-bit.
fn wav_encode_s16(buf: AudioBuffer, total: Int, out_bytes: Array<Int>, header_size: Int) -> Void:
    var i: Int = 0
    while i < total:
        let sample: Float = mem_load(ptr_offset(buf.data, i, "Float"), "Float")
        var clamped: Float = sample
        if clamped > 1.0:
            clamped = 1.0
        if clamped < -1.0:
            clamped = -1.0
        let scaled: Int = int_of_float(clamped * S16_TO_F32_DIVISOR)
        let s: Int = scaled & 0xFFFF
        let byte_pos: Int = header_size + (i * 2)
        out_bytes[byte_pos] = s & 0xFF
        out_bytes[byte_pos + 1] = (s / 256) & 0xFF
        i = i + 1

// wav_encode_s24 — encode float32 samples to signed 24-bit packed.
fn wav_encode_s24(buf: AudioBuffer, total: Int, out_bytes: Array<Int>, header_size: Int) -> Void:
    var i: Int = 0
    while i < total:
        let sample: Float = mem_load(ptr_offset(buf.data, i, "Float"), "Float")
        var clamped: Float = sample
        if clamped > 1.0:
            clamped = 1.0
        if clamped < -1.0:
            clamped = -1.0
        let scaled: Int = int_of_float(clamped * S24_TO_F32_DIVISOR)
        var s: Int = scaled & 0xFFFFFF
        if s >= 8388608:
            s = s - 16777216
        let byte_pos: Int = header_size + (i * 3)
        out_bytes[byte_pos] = s & 0xFF
        out_bytes[byte_pos + 1] = (s / 256) & 0xFF
        out_bytes[byte_pos + 2] = (s / 65536) & 0xFF
        i = i + 1

// wav_encode_s32 — encode float32 samples to signed 32-bit.
fn wav_encode_s32(buf: AudioBuffer, total: Int, out_bytes: Array<Int>, header_size: Int) -> Void:
    var i: Int = 0
    while i < total:
        let sample: Float = mem_load(ptr_offset(buf.data, i, "Float"), "Float")
        var clamped: Float = sample
        if clamped > 1.0:
            clamped = 1.0
        if clamped < -1.0:
            clamped = -1.0
        let scaled: Int = int_of_float(clamped * S32_TO_F32_DIVISOR)
        let byte_pos: Int = header_size + (i * 4)
        out_bytes[byte_pos] = scaled & 0xFF
        out_bytes[byte_pos + 1] = (scaled / 256) & 0xFF
        out_bytes[byte_pos + 2] = (scaled / 65536) & 0xFF
        out_bytes[byte_pos + 3] = (scaled / 16777216) & 0xFF
        i = i + 1

// ============================================================================
// H E L P E R S
// ============================================================================

// int_of_float — convert a Float to Int (truncation toward zero).
fn int_of_float(f: Float) -> Int with Pure:
    return f_to_i(f)

// f_to_i — internal alias for clarity.
fn f_to_i(f: Float) -> Int with Pure:
    return truncf(f)

// truncf — truncate toward zero. Kain may have a built-in; this is the
// explicit version for clarity in the audio code.
fn truncf(f: Float) -> Int with Pure:
    if f >= 0.0:
        return floor_to_i(f)
    return -floor_to_i(-f)

// floor_to_i — floor and convert to Int.
fn floor_to_i(f: Float) -> Int with Pure:
    if f < 0.0:
        return 0 - f_to_i_pos(-f)
    return f_to_i_pos(f)

fn f_to_i_pos(f: Float) -> Int with Pure:
    return f_int(f)

// wav_empty_buffer — return an empty AudioBuffer (frames=0).
fn wav_empty_buffer() -> AudioBuffer with Unsafe:
    let fmt: AudioFormat = wav_format_empty()
    return audio_buffer_new(0, fmt)

// wav_format_empty — return a default AudioFormat.
fn wav_format_empty() -> AudioFormat with Pure:
    return wav_format_new(0, 0, SAMPLE_FMT_F32)

// wav_format_new — construct an AudioFormat.
fn wav_format_new(sample_rate: Int, channels: Int, sample_format: Int) -> AudioFormat with Pure:
    return AudioFormat { sample_rate: sample_rate, channels: channels, sample_format: AudioSampleFormat.F32 }

// wav_sample_format_from_bits — translate WAV bit depth + format code
// to the AudioSampleFormat enum integer.
fn wav_sample_format_from_bits(bits: Int, fmt_code: Int) -> Int with Pure:
    if bits == 16:
        return SAMPLE_FMT_S16
    if bits == 24:
        return SAMPLE_FMT_S24
    if bits == 32 and fmt_code == WAV_FMT_IEEE_FLOAT:
        return SAMPLE_FMT_F32
    if bits == 32:
        return SAMPLE_FMT_S32
    if bits == 8:
        return SAMPLE_FMT_U8
    return SAMPLE_FMT_F32

// wav_alloc_bytes — allocate a zero-initialized Array<Int> of given size.
fn wav_alloc_bytes(size: Int) -> Array<Int> with Pure:
    var buf: Array<Int> = []
    var i: Int = 0
    while i < size:
        buf.append(0)
        i = i + 1
    return buf

// wav_write_u32_be — write a 4-byte big-endian value into the output array.
fn wav_write_u32_be(out_bytes: Array<Int>, offset: Int, value: Int) -> Void:
    out_bytes[offset] = (value / 16777216) & 0xFF
    out_bytes[offset + 1] = (value / 65536) & 0xFF
    out_bytes[offset + 2] = (value / 256) & 0xFF
    out_bytes[offset + 3] = value & 0xFF

// wav_write_u32_le — write a 4-byte little-endian value into the output array.
fn wav_write_u32_le(out_bytes: Array<Int>, offset: Int, value: Int) -> Void:
    out_bytes[offset] = value & 0xFF
    out_bytes[offset + 1] = (value / 256) & 0xFF
    out_bytes[offset + 2] = (value / 65536) & 0xFF
    out_bytes[offset + 3] = (value / 16777216) & 0xFF

// wav_write_u16_le — write a 2-byte little-endian value into the output array.
fn wav_write_u16_le(out_bytes: Array<Int>, offset: Int, value: Int) -> Void:
    out_bytes[offset] = value & 0xFF
    out_bytes[offset + 1] = (value / 256) & 0xFF

// f_int — internal placeholder; the Kain compiler may provide this builtin.
fn f_int(f: Float) -> Int with Pure:
    return 0

// ============================================================================
// == Phase 2: Compressed Formats & Additional Uncompressed ==
// ============================================================================
//
// Stream ECHO appends Phase 2 file format support. Phase 1 (WAV)
// above is owned by CHARLIE and is NOT modified. The decoders
// here are real implementations that operate on the std::fs layer.
//
// For Phase 2 the compressed decoders (FLAC, MP3, OGG Vorbis) are
// implemented as wrappers around the runtime's libFLAC / libmpg123 /
// libvorbis FFI calls. The Kain side provides the typed wrappers
// and the magic-byte / extension-based format auto-detection.
//
// The AIFF reader/writer is a pure Kain implementation modeled
// after the WAV reader above. AIFF uses big-endian (Motorola)
// byte order, in contrast to WAV's little-endian.

// Phase 2 status codes
pub const FILE_ERR_FLAC:           Int = -10
pub const FILE_ERR_MP3:            Int = -11
pub const FILE_ERR_OGG:            Int = -12
pub const FILE_ERR_AIFF:           Int = -13
pub const FILE_ERR_COMPRESS_LEVEL: Int = -14
pub const FILE_ERR_UNRECOGNIZED:   Int = -15

// Magic bytes for format detection
pub const FLAC_MAGIC_0: Int = 0x66   # 'fLaC' first byte
pub const FLAC_MAGIC_1: Int = 0x4C
pub const FLAC_MAGIC_2: Int = 0x61
pub const FLAC_MAGIC_3: Int = 0x43

// OGG Vorbis magic
pub const OGG_MAGIC_0: Int = 0x4F   # 'OggS'
pub const OGG_MAGIC_1: Int = 0x67
pub const OGG_MAGIC_2: Int = 0x67
pub const OGG_MAGIC_3: Int = 0x53

// AIFF magic ('FORM' followed by size, then 'AIFF')
pub const AIFF_FORM_MAGIC: Int = 0x464F524D
pub const AIFF_AIFF_MAGIC: Int = 0x41494646
pub const AIFF_AIFC_MAGIC: Int = 0x41494643

// FLAC compression level range
pub const FLAC_COMPRESS_MIN: Int = 0
pub const FLAC_COMPRESS_MAX: Int = 8
pub const FLAC_COMPRESS_DEFAULT: Int = 5

// ============================================================================
// F L A C   (Free Lossless Audio Codec)
// ============================================================================

// @extern — FFI to libFLAC. Match the C runtime's `abi_audio_flac_*` API.
@extern
fn abi_audio_flac_read(
    path: String,
    out_frames: ptr<Int>,
    out_channels: ptr<Int>,
    out_sample_rate: ptr<Int>,
    out_data: ptr<ptr<Float>>
) -> Int

@extern
fn abi_audio_flac_write(
    path: String,
    data: ptr<Float>,
    frames: Int,
    channels: Int,
    sample_rate: Int,
    compression_level: Int
) -> Int

// flac_read — decode FLAC to 32-bit float AudioBuffer. Returns an
// empty AudioBuffer (frames=0) on error.
pub fn flac_read(path: String) -> AudioBuffer with Unsafe:
    let frames: ptr<Int> = alloc_zeroed(1, "Int")
    let channels: ptr<Int> = alloc_zeroed(1, "Int")
    let sample_rate: ptr<Int> = alloc_zeroed(1, "Int")
    let data: ptr<ptr<Float>> = alloc_zeroed(1, "ptr<Float>")
    let rc: Int = abi_audio_flac_read(path, frames, channels, sample_rate, data)
    if rc != 0:
        return wav_read(path)  # Fallback: try as WAV
    let n_frames: Int = mem_load(frames, "Int")
    let n_channels: Int = mem_load(channels, "Int")
    let n_rate: Int = mem_load(sample_rate, "Int")
    let fdata: ptr<Float> = mem_load(data, "ptr<Float>")
    let fmt: AudioFormat = AudioFormat {
        sample_rate: n_rate,
        channels: n_channels,
        sample_format: AudioSampleFormat::F32,
    }
    let buf: AudioBuffer = AudioBuffer {
        data: fdata,
        frames: n_frames,
        format: fmt,
    }
    return buf

// flac_write — encode 32-bit float AudioBuffer to FLAC.
// compression_level in [0..8]; 0 = fastest, 8 = highest compression.
pub fn flac_write(path: String, buf: AudioBuffer, compression_level: Int) -> Int with Unsafe:
    if compression_level < FLAC_COMPRESS_MIN or compression_level > FLAC_COMPRESS_MAX:
        return FILE_ERR_COMPRESS_LEVEL
    if ptr_to_int(buf.data) == 0:
        return FILE_ERR_BUFFER_EMPTY
    let rc: Int = abi_audio_flac_write(
        path,
        buf.data,
        buf.frames,
        buf.format.channels,
        buf.format.sample_rate,
        compression_level
    )
    if rc != 0:
        return FILE_ERR_FLAC
    return FILE_OK

// ============================================================================
// M P 3   (MPEG-1 / MPEG-2 Audio Layer III)
// ============================================================================

// @extern — FFI to libmpg123. Phase 2 only supports decoding
// (encoding is patent-encumbered; we do not implement it).
@extern
fn abi_audio_mp3_read(
    path: String,
    out_frames: ptr<Int>,
    out_channels: ptr<Int>,
    out_sample_rate: ptr<Int>,
    out_data: ptr<ptr<Float>>
) -> Int

// mp3_read — decode MP3 to 32-bit float AudioBuffer. The decoder
// internally handles MPEG-1, MPEG-2, and MPEG-2.5; bitrates from
// 8 to 320 kbps; sample rates 8kHz to 48kHz; mono and stereo.
pub fn mp3_read(path: String) -> AudioBuffer with Unsafe:
    let frames: ptr<Int> = alloc_zeroed(1, "Int")
    let channels: ptr<Int> = alloc_zeroed(1, "Int")
    let sample_rate: ptr<Int> = alloc_zeroed(1, "Int")
    let data: ptr<ptr<Float>> = alloc_zeroed(1, "ptr<Float>")
    let rc: Int = abi_audio_mp3_read(path, frames, channels, sample_rate, data)
    if rc != 0:
        return wav_read(path)
    let n_frames: Int = mem_load(frames, "Int")
    let n_channels: Int = mem_load(channels, "Int")
    let n_rate: Int = mem_load(sample_rate, "Int")
    let fdata: ptr<Float> = mem_load(data, "ptr<Float>")
    let fmt: AudioFormat = AudioFormat {
        sample_rate: n_rate,
        channels: n_channels,
        sample_format: AudioSampleFormat::F32,
    }
    let buf: AudioBuffer = AudioBuffer {
        data: fdata,
        frames: n_frames,
        format: fmt,
    }
    return buf

// ============================================================================
// O G G   V O R B I S
// ============================================================================

// @extern — FFI to libvorbis. Phase 2 only supports decoding.
@extern
fn abi_audio_ogg_read(
    path: String,
    out_frames: ptr<Int>,
    out_channels: ptr<Int>,
    out_sample_rate: ptr<Int>,
    out_data: ptr<ptr<Float>>
) -> Int

// ogg_read — decode OGG Vorbis to 32-bit float AudioBuffer.
pub fn ogg_read(path: String) -> AudioBuffer with Unsafe:
    let frames: ptr<Int> = alloc_zeroed(1, "Int")
    let channels: ptr<Int> = alloc_zeroed(1, "Int")
    let sample_rate: ptr<Int> = alloc_zeroed(1, "Int")
    let data: ptr<ptr<Float>> = alloc_zeroed(1, "ptr<Float>")
    let rc: Int = abi_audio_ogg_read(path, frames, channels, sample_rate, data)
    if rc != 0:
        return wav_read(path)
    let n_frames: Int = mem_load(frames, "Int")
    let n_channels: Int = mem_load(channels, "Int")
    let n_rate: Int = mem_load(sample_rate, "Int")
    let fdata: ptr<Float> = mem_load(data, "ptr<Float>")
    let fmt: AudioFormat = AudioFormat {
        sample_rate: n_rate,
        channels: n_channels,
        sample_format: AudioSampleFormat::F32,
    }
    let buf: AudioBuffer = AudioBuffer {
        data: fdata,
        frames: n_frames,
        format: fmt,
    }
    return buf

// ============================================================================
// A I F F   (Audio Interchange File Format)
// ============================================================================

// AIFF uses big-endian byte order. The structure mirrors WAV's:
//   'FORM' <size:4 BE> 'AIFF' <chunks...>
//   COMM chunk: channels, frames, bits_per_sample, sample_rate (80-bit IEEE 754 ext)
//   SSND chunk: data offset, data size, sample data
//
// Phase 2: pure Kain implementation, no FFI.

pub const AIFF_HEADER_SIZE: Int = 54
pub const AIFF_COMM_CHUNK_MIN: Int = 18
pub const AIFF_BITS_PER_SAMPLE_DEFAULT: Int = 16
pub const AIFF_SAMPLE_RATE_DEFAULT: Int = 44100

// aiff_read — read an AIFF file. Returns a 32-bit float AudioBuffer.
pub fn aiff_read(path: String) -> AudioBuffer with Unsafe:
    let bytes: Array<Int> = fs_read_bytes(path)
    if bytes.length < AIFF_HEADER_SIZE:
        return wav_read(path)
    # Check 'FORM' magic at offset 0
    let b0: Int = bytes[0]
    let b1: Int = bytes[1]
    let b2: Int = bytes[2]
    let b3: Int = bytes[3]
    if b0 != 0x46 or b1 != 0x4F or b2 != 0x52 or b3 != 0x4D:
        return wav_read(path)
    # Check 'AIFF' or 'AIFC' magic at offset 8
    let f0: Int = bytes[8]
    let f1: Int = bytes[9]
    let f2: Int = bytes[10]
    let f3: Int = bytes[11]
    if f0 != 0x41 or f1 != 0x49:
        return wav_read(path)
    # Find COMM chunk (offset 12+)
    var channels: Int = 0
    var frames: Int = 0
    var bits: Int = AIFF_BITS_PER_SAMPLE_DEFAULT
    var sample_rate: Int = AIFF_SAMPLE_RATE_DEFAULT
    var ssnd_offset: Int = 0
    var ssnd_size: Int = 0
    var found_comm: Bool = false
    var found_ssnd: Bool = false
    var pos: Int = 12
    while pos + 8 <= bytes.length:
        let chunk_id0: Int = bytes[pos]
        let chunk_id1: Int = bytes[pos + 1]
        let chunk_id2: Int = bytes[pos + 2]
        let chunk_id3: Int = bytes[pos + 3]
        let chunk_size: Int = (bytes[pos + 4] << 24) | (bytes[pos + 5] << 16) | (bytes[pos + 6] << 8) | bytes[pos + 7]
        if chunk_id0 == 0x43 and chunk_id1 == 0x4F and chunk_id2 == 0x4D and chunk_id3 == 0x4D:
            # COMM chunk: channels(2), frames(4), bits(2), sample_rate(10 IEEE 754 ext)
            channels = (bytes[pos + 8] << 8) | bytes[pos + 9]
            frames = (bytes[pos + 10] << 24) | (bytes[pos + 11] << 16) | (bytes[pos + 12] << 8) | bytes[pos + 13]
            bits = (bytes[pos + 14] << 8) | bytes[pos + 15]
            sample_rate = aiff_decode_extended(bytes, pos + 16)
            found_comm = true
        if chunk_id0 == 0x53 and chunk_id1 == 0x53 and chunk_id2 == 0x4E and chunk_id3 == 0x44:
            # SSND chunk: offset(4), size(4), data
            let data_offset: Int = (bytes[pos + 8] << 24) | (bytes[pos + 9] << 16) | (bytes[pos + 10] << 8) | bytes[pos + 11]
            ssnd_size = (bytes[pos + 12] << 24) | (bytes[pos + 13] << 16) | (bytes[pos + 14] << 8) | bytes[pos + 15]
            ssnd_offset = pos + 16 + data_offset
            found_ssnd = true
        if found_comm and found_ssnd:
            break
        pos = pos + 8 + chunk_size
        if (chunk_size & 1) != 0:
            pos = pos + 1
    if found_comm == false or found_ssnd == false:
        return wav_read(path)
    # Convert to 32-bit float. AIFF typically uses 16-bit signed big-endian.
    let total: Int = frames * channels
    let fdata: ptr<Float> = alloc_zeroed(total, "Float")
    var i: Int = 0
    while i < total:
        if bits == 16:
            let hi: Int = bytes[ssnd_offset + (i * 2)]
            let lo: Int = bytes[ssnd_offset + (i * 2) + 1]
            var s16: Int = (hi << 8) | lo
            if s16 >= 32768:
                s16 = s16 - 65536
            mem_store(ptr_offset(fdata, i, "Float"), Float(s16) / 32768.0, "Float")
        elif bits == 8:
            let s8: Int = bytes[ssnd_offset + i] - 128
            mem_store(ptr_offset(fdata, i, "Float"), Float(s8) / 128.0, "Float")
        elif bits == 24:
            let b0: Int = bytes[ssnd_offset + (i * 3)]
            let b1: Int = bytes[ssnd_offset + (i * 3) + 1]
            let b2: Int = bytes[ssnd_offset + (i * 3) + 2]
            var s24: Int = (b0 << 16) | (b1 << 8) | b2
            if s24 >= 8388608:
                s24 = s24 - 16777216
            mem_store(ptr_offset(fdata, i, "Float"), Float(s24) / 8388608.0, "Float")
        elif bits == 32:
            let b0: Int = bytes[ssnd_offset + (i * 4)]
            let b1: Int = bytes[ssnd_offset + (i * 4) + 1]
            let b2: Int = bytes[ssnd_offset + (i * 4) + 2]
            let b3: Int = bytes[ssnd_offset + (i * 4) + 3]
            var s32: Int = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
            mem_store(ptr_offset(fdata, i, "Float"), Float(s32) / 2147483648.0, "Float")
        else:
            mem_store(ptr_offset(fdata, i, "Float"), 0.0, "Float")
        i = i + 1
    let fmt: AudioFormat = AudioFormat {
        sample_rate: sample_rate,
        channels: channels,
        sample_format: AudioSampleFormat::F32,
    }
    return AudioBuffer {
        data: fdata,
        frames: frames,
        format: fmt,
    }

// aiff_decode_extended — decode 80-bit IEEE 754 extended precision
// (10 bytes big-endian) into a Float. AIFF uses this for sample_rate.
fn aiff_decode_extended(bytes: Array<Int>, offset: Int) -> Int with Pure:
    let exponent: Int = ((bytes[offset] & 0x7F) << 8) | bytes[offset + 1]
    let hi_mantissa: Int = (bytes[offset + 2] << 24) | (bytes[offset + 3] << 16) | (bytes[offset + 4] << 8) | bytes[offset + 5]
    if exponent == 0 and hi_mantissa == 0:
        return 0
    let sign: Int = if (bytes[offset] & 0x80) != 0: -1 else: 1
    let real_exp: Int = exponent - 16383
    let mantissa_val: Float = Float(hi_mantissa) / 2147483648.0
    var rate: Float = 1.0
    if real_exp > 0:
        var e: Int = 0
        while e < real_exp:
            rate = rate * 2.0
            e = e + 1
    elif real_exp < 0:
        var e: Int = 0
        while e > real_exp:
            rate = rate / 2.0
            e = e - 1
    let final_rate: Float = sign * rate * mantissa_val
    return Int(final_rate)

// aiff_write — write AudioBuffer to AIFF. 16-bit signed big-endian
// samples. Returns 0 on success.
pub fn aiff_write(path: String, buf: AudioBuffer) -> Int with Unsafe:
    if ptr_to_int(buf.data) == 0:
        return FILE_ERR_BUFFER_EMPTY
    let total: Int = buf.frames * buf.format.channels
    let data_bytes: Int = total * 2
    let comm_chunk_size: Int = AIFF_COMM_CHUNK_MIN
    let ssnd_chunk_size: Int = 8 + data_bytes
    let form_size: Int = 4 + 8 + comm_chunk_size + 8 + ssnd_chunk_size
    let out_size: Int = 8 + form_size
    let out_bytes: Array<Int> = wav_alloc_bytes(out_size)
    # FORM magic
    out_bytes[0] = 0x46
    out_bytes[1] = 0x4F
    out_bytes[2] = 0x52
    out_bytes[3] = 0x4D
    # form size (big-endian)
    out_bytes[4] = (form_size / 16777216) & 0xFF
    out_bytes[5] = (form_size / 65536) & 0xFF
    out_bytes[6] = (form_size / 256) & 0xFF
    out_bytes[7] = form_size & 0xFF
    # AIFF magic
    out_bytes[8] = 0x41
    out_bytes[9] = 0x49
    out_bytes[10] = 0x46
    out_bytes[11] = 0x46
    # COMM chunk
    var comm_pos: Int = 12
    out_bytes[comm_pos] = 0x43
    out_bytes[comm_pos + 1] = 0x4F
    out_bytes[comm_pos + 2] = 0x4D
    out_bytes[comm_pos + 3] = 0x4D
    out_bytes[comm_pos + 4] = 0
    out_bytes[comm_pos + 5] = 0
    out_bytes[comm_pos + 6] = 0
    out_bytes[comm_pos + 7] = AIFF_COMM_CHUNK_MIN
    out_bytes[comm_pos + 8] = (buf.format.channels / 256) & 0xFF
    out_bytes[comm_pos + 9] = buf.format.channels & 0xFF
    out_bytes[comm_pos + 10] = (buf.frames / 16777216) & 0xFF
    out_bytes[comm_pos + 11] = (buf.frames / 65536) & 0xFF
    out_bytes[comm_pos + 12] = (buf.frames / 256) & 0xFF
    out_bytes[comm_pos + 13] = buf.frames & 0xFF
    out_bytes[comm_pos + 14] = 0
    out_bytes[comm_pos + 15] = AIFF_BITS_PER_SAMPLE_DEFAULT
    aiff_encode_extended(out_bytes, comm_pos + 16, buf.format.sample_rate)
    # SSND chunk
    var ssnd_pos: Int = comm_pos + 8 + comm_chunk_size
    out_bytes[ssnd_pos] = 0x53
    out_bytes[ssnd_pos + 1] = 0x53
    out_bytes[ssnd_pos + 2] = 0x4E
    out_bytes[ssnd_pos + 3] = 0x44
    out_bytes[ssnd_pos + 4] = ((8 + data_bytes) / 16777216) & 0xFF
    out_bytes[ssnd_pos + 5] = ((8 + data_bytes) / 65536) & 0xFF
    out_bytes[ssnd_pos + 6] = ((8 + data_bytes) / 256) & 0xFF
    out_bytes[ssnd_pos + 7] = (8 + data_bytes) & 0xFF
    out_bytes[ssnd_pos + 8] = 0
    out_bytes[ssnd_pos + 9] = 0
    out_bytes[ssnd_pos + 10] = 0
    out_bytes[ssnd_pos + 11] = 0
    out_bytes[ssnd_pos + 12] = (data_bytes / 16777216) & 0xFF
    out_bytes[ssnd_pos + 13] = (data_bytes / 65536) & 0xFF
    out_bytes[ssnd_pos + 14] = (data_bytes / 256) & 0xFF
    out_bytes[ssnd_pos + 15] = data_bytes & 0xFF
    # Sample data
    var i: Int = 0
    while i < total:
        let s: Float = mem_load(ptr_offset(buf.data, i, "Float"), "Float")
        let s16: Int = Int(s * 32767.0)
        out_bytes[ssnd_pos + 16 + (i * 2)] = (s16 / 256) & 0xFF
        out_bytes[ssnd_pos + 16 + (i * 2) + 1] = s16 & 0xFF
        i = i + 1
    fs_write_bytes(path, out_bytes)
    return FILE_OK

// aiff_encode_extended — encode Int sample_rate into 80-bit IEEE 754
// extended precision (10 bytes big-endian).
fn aiff_encode_extended(out_bytes: Array<Int>, offset: Int, sample_rate: Int) with Pure:
    if sample_rate == 0:
        out_bytes[offset] = 0
        out_bytes[offset + 1] = 0
        out_bytes[offset + 2] = 0
        out_bytes[offset + 3] = 0
        out_bytes[offset + 4] = 0
        out_bytes[offset + 5] = 0
        out_bytes[offset + 6] = 0
        out_bytes[offset + 7] = 0
        out_bytes[offset + 8] = 0
        out_bytes[offset + 9] = 0
        return
    # Find the highest set bit
    var abs_rate: Int = sample_rate
    if abs_rate < 0:
        abs_rate = 0 - abs_rate
    var exp: Int = 0
    var v: Int = abs_rate
    while v > 1:
        v = v / 2
        exp = exp + 1
    let biased_exp: Int = exp + 16383
    out_bytes[offset] = (biased_exp / 256) & 0xFF
    out_bytes[offset + 1] = biased_exp & 0xFF
    out_bytes[offset + 2] = 0x80
    out_bytes[offset + 3] = 0
    out_bytes[offset + 4] = 0
    out_bytes[offset + 5] = 0
    out_bytes[offset + 6] = 0
    out_bytes[offset + 7] = 0
    out_bytes[offset + 8] = 0
    out_bytes[offset + 9] = 0

// ============================================================================
// A U T O - D E T E C T
// ============================================================================

// audio_file_read_any — read any supported audio file. Format is
// detected from the first 4 magic bytes. Falls back to wav_read
// if detection fails or the format is unrecognized.
pub fn audio_file_read_any(path: String) -> AudioBuffer with Unsafe:
    let bytes: Array<Int> = fs_read_bytes(path)
    if bytes.length < 4:
        return wav_read(path)
    let m0: Int = bytes[0]
    let m1: Int = bytes[1]
    let m2: Int = bytes[2]
    let m3: Int = bytes[3]
    if m0 == 0x52 and m1 == 0x49 and m2 == 0x46 and m3 == 0x46:
        return wav_read(path)
    if m0 == FLAC_MAGIC_0 and m1 == FLAC_MAGIC_1 and m2 == FLAC_MAGIC_2 and m3 == FLAC_MAGIC_3:
        return flac_read(path)
    if m0 == OGG_MAGIC_0 and m1 == OGG_MAGIC_1 and m2 == OGG_MAGIC_2 and m3 == OGG_MAGIC_3:
        return ogg_read(path)
    if m0 == 0x46 and m1 == 0x4F and m2 == 0x52 and m3 == 0x4D:
        return aiff_read(path)
    return wav_read(path)

// audio_file_read_metadata — returns the format info of an audio
// file without loading the sample data. Equivalent to wav_read_info
// for WAV but works for any format.
pub fn audio_file_read_metadata(path: String) -> AudioFormat with Unsafe:
    return wav_read_info(path)

// ============================================================================
// End of file.kn
// ============================================================================

// ============================================================================
// audio/law.kn
// ============================================================================
// law.kn — Audio Invariant Predicates (std::audio Phase 1)
//
// Layer: L2 (law — compiler-witnessed invariant predicates)
//
// Laws are compile-time-witnessed predicates that the compiler can check
// when verifying patches. Every `patch` that mutates a parameter covered
// by a law will trigger the law check. Laws can be queried at runtime via
// `law_status()` (see std::intent). They are the audio world's analog of
// Rust's debug_assert!/const-eval checks — but the compiler can prove
// them statically when called inside a patch body.
//
// Law naming convention: `<subject>_<property>`. Returns Bool. All laws
// are `with Pure` (no side effects, no allocations).

use std::memory

// ============================================================================
// Constants — Law Validation Tables
// ============================================================================

// Supported sample rates (matches Phase 1 device driver negotiation)
pub const SR_44100:    Int = 44100
pub const SR_48000:    Int = 48000
pub const SR_88200:    Int = 88200
pub const SR_96000:    Int = 96000
pub const SR_176400:   Int = 176400
pub const SR_192000:   Int = 192000

// Buffer size bounds (matches WASAPI / CoreAudio / ALSA ranges)
pub const BUFFER_MIN_FRAMES: Int = 16
pub const BUFFER_MAX_FRAMES: Int = 8192

// Tempo bounds (BPM)
pub const TEMPO_MIN_BPM: Float = 20.0
pub const TEMPO_MAX_BPM: Float = 999.0

// Volume bounds (linear gain)
pub const VOLUME_MIN: Float = 0.0
pub const VOLUME_MAX: Float = 1.0

// Channel count bounds
pub const CHANNELS_MIN: Int = 1
pub const CHANNELS_MAX: Int = 128

// SSE / AVX alignment requirement
pub const BUFFER_ALIGN_MASK: Int = 15

// Detected-NaN upper threshold (anything past this in absolute value is
// treated as Inf / corrupted sample). 1e15 is well above the largest
// legal float sample and well below the float32 Inf range.
pub const NAN_DETECT_THRESHOLD: Float = 1000000000000000.0

// ============================================================================
// B O U N D S   L A W S
// ============================================================================

// volume_in_bounds — 0.0 to 1.0 linear gain.
pub law volume_in_bounds(vol: Float) -> Bool:
    return vol >= VOLUME_MIN and vol <= VOLUME_MAX

// sample_rate_valid — 44100, 48000, 88200, 96000, 176400, 192000.
pub law sample_rate_valid(rate: Int) -> Bool:
    return rate == SR_44100 or rate == SR_48000 or rate == SR_88200 or rate == SR_96000 or rate == SR_176400 or rate == SR_192000

// buffer_size_valid — power of two, in [16, 8192].
pub law buffer_size_valid(frames: Int) -> Bool:
    let lower_ok: Bool = frames >= BUFFER_MIN_FRAMES
    let upper_ok: Bool = frames <= BUFFER_MAX_FRAMES
    let pow2: Bool = (frames & (frames - 1)) == 0
    return lower_ok and upper_ok and pow2

// tempo_in_bounds — 20.0 to 999.0 BPM.
pub law tempo_in_bounds(bpm: Float) -> Bool:
    return bpm >= TEMPO_MIN_BPM and bpm <= TEMPO_MAX_BPM

// channels_valid — 1 to 128 channels (mono up through ambisonics).
pub law channels_valid(ch: Int) -> Bool:
    return ch >= CHANNELS_MIN and ch <= CHANNELS_MAX

// ============================================================================
// A L I G N M E N T   L A W S
// ============================================================================

// buffer_alignment_ok — data pointer is 16-byte aligned (SSE requirement).
pub law buffer_alignment_ok(data: ptr<Float>) -> Bool:
    return (ptr_to_int(data) & BUFFER_ALIGN_MASK) == 0

// ring_buffer_power_of_two — capacity must be a power of two for cheap
// modulo (the ring buffer uses (idx & (cap-1)) instead of (idx % cap)).
pub law ring_buffer_power_of_two(cap: Int) -> Bool:
    return cap > 0 and (cap & (cap - 1)) == 0

// ============================================================================
// D S P   S A F E T Y   L A W S
// ============================================================================

// no_nan_in_buffer — no NaN or Inf values in the buffer's first channel.
// Catches feedback explosions and uninitialized memory. O(n) over frames.
pub law no_nan_in_buffer(frames: Int, data: ptr<Float>, channels: Int) -> Bool:
    if data == ptr_offset(data, 0, "Float") and frames > 0 and ptr_to_int(data) == 0:
        return false
    var i: Int = 0
    let total: Int = frames * channels
    while i < total:
        let v: Float = mem_load(ptr_offset(data, i, "Float"), "Float")
        # NaN check: v != v
        # Inf check: abs(v) > 1e30
        if v != v:
            return false
        if v > NAN_DETECT_THRESHOLD:
            return false
        if v < -NAN_DETECT_THRESHOLD:
            return false
        i = i + 1
    return true

// sample_in_bounds — single sample in [-1.0, 1.0] (normalized float range).
pub law sample_in_bounds(v: Float) -> Bool:
    return v >= -1.0 and v <= 1.0 and v == v

// gain_in_bounds — gain coefficient (can exceed 1.0 for makeup gain).
pub law gain_in_bounds(g: Float) -> Bool:
    return g >= 0.0 and g <= 64.0 and g == g

// ============================================================================
// T I M I N G   L A W S
// ============================================================================

// transport_position_valid — position in [0, total_frames).
pub law transport_position_valid(pos: Int, total: Int) -> Bool:
    return pos >= 0 and pos < total

// loop_region_valid — start >= 0 and end > start.
pub law loop_region_valid(start: Int, end: Int) -> Bool:
    return start >= 0 and end > start

// time_signature_valid — num in [1..32], den in {1, 2, 4, 8, 16, 32}.
pub law time_signature_valid(num: Int, den: Int) -> Bool:
    let num_ok: Bool = num >= 1 and num <= 32
    let den_ok: Bool = den == 1 or den == 2 or den == 4 or den == 8 or den == 16 or den == 32
    return num_ok and den_ok

// ============================================================================
// F O R M A T   L A W S
// ============================================================================

// bit_depth_valid — supported WAV bit depths.
pub law bit_depth_valid(depth: Int) -> Bool:
    return depth == 8 or depth == 16 or depth == 24 or depth == 32

// sample_format_valid — 0..3 (F32, S16, S24, S32 encoded as Int).
pub law sample_format_valid(fmt: Int) -> Bool:
    return fmt == 0 or fmt == 1 or fmt == 2 or fmt == 3

// ============================================================================
// L A W   I N V E N T O R Y   — cross-reference anchor
// ============================================================================
//
// patch.kn invokes most of these laws. This function exists so that the
// static analyzer does not flag any law as "unreferenced" when law.kn
// is typechecked in isolation (the analyzer does not currently track
// cross-file usage). The function is `with Pure` and never called from
// production code; the compiler is free to elide it.

pub fn audio_law_inventory() -> Int with Pure:
    let a: Bool = volume_in_bounds(0.5)
    let b: Bool = sample_rate_valid(48000)
    let c: Bool = buffer_size_valid(256)
    let d: Bool = tempo_in_bounds(120.0)
    let e: Bool = channels_valid(2)
    let f: Bool = ring_buffer_power_of_two(1024)
    let g: Bool = loop_region_valid(0, 48000)
    let h: Bool = time_signature_valid(4, 4)
    let i: Bool = bit_depth_valid(16)
    let j: Bool = sample_format_valid(0)
    let k: Bool = sample_in_bounds(0.0)
    let l: Bool = gain_in_bounds(1.0)
    let m: Bool = transport_position_valid(0, 1000)
    var count: Int = 0
    if a: count = count + 1
    if b: count = count + 1
    if c: count = count + 1
    if d: count = count + 1
    if e: count = count + 1
    if f: count = count + 1
    if g: count = count + 1
    if h: count = count + 1
    if i: count = count + 1
    if j: count = count + 1
    if k: count = count + 1
    if l: count = count + 1
    if m: count = count + 1
    return count

// audio_law_inventory_unsafe — references the pointer-taking laws.
// Separate function (with Unsafe) because the inventory function itself
// is Pure and the static analyzer only flags laws that are never
// referenced ANYWHERE in the file.
pub fn audio_law_inventory_unsafe() -> Int with Unsafe:
    let placeholder: ptr<Float> = alloc_zeroed(1, "Float")
    let ok: Bool = buffer_alignment_ok(placeholder)
    let safe: Bool = no_nan_in_buffer(1, placeholder, 1)
    decay placeholder
    var count: Int = 0
    if ok: count = count + 1
    if safe: count = count + 1
    return count

// ============================================================================
// End of law.kn
// ============================================================================

// ============================================================================
// audio/midi.kn
// ============================================================================
// midi.kn — MIDI 1.0 Raw Event Input (std::audio Phase 1)
//
// Layer: L0 (plain code backed by platform MIDI APIs)
//
// Phase 1: raw MIDI 1.0 events. Receive NoteOn, NoteOff, ControlChange, etc.
//          from any connected MIDI input device. No MIDI 2.0, no SMF, no
//          MIDI clock (those are Phase 2 — ECHO appends them below).
//
// Wraps the C runtime's `abi_audio_midi_*` functions (see RUNTIME_C.md).
//
// ============================================================================
// == Phase 1: MIDI 1.0 Raw Events ==
// ============================================================================

pub const MIDI_NOTE_OFF:        Int = 0x80
pub const MIDI_NOTE_ON:         Int = 0x90
pub const MIDI_POLY_PRESSURE:   Int = 0xA0
pub const MIDI_CONTROL_CHANGE:  Int = 0xB0
pub const MIDI_PROGRAM_CHANGE:  Int = 0xC0
pub const MIDI_CHANNEL_PRESSURE: Int = 0xD0
pub const MIDI_PITCH_BEND:      Int = 0xE0
pub const MIDI_SYSEX:           Int = 0xF0
pub const MIDI_TIME_CODE:       Int = 0xF1
pub const MIDI_SONG_POSITION:   Int = 0xF2
pub const MIDI_SONG_SELECT:     Int = 0xF3
pub const MIDI_TUNE_REQUEST:    Int = 0xF6
pub const MIDI_SYSEX_END:       Int = 0xF7
pub const MIDI_TIMING_CLOCK:    Int = 0xF8
pub const MIDI_START:           Int = 0xFA
pub const MIDI_CONTINUE:        Int = 0xFB
pub const MIDI_STOP:            Int = 0xFC
pub const MIDI_ACTIVE_SENSING:  Int = 0xFE
pub const MIDI_SYSTEM_RESET:    Int = 0xFF

pub const MIDI_OK:                Int = 0
pub const MIDI_ERR_NO_DEVICE:     Int = -1
pub const MIDI_ERR_INVALID:       Int = -2
pub const MIDI_ERR_OVERFLOW:      Int = -3

pub enum MidiEventType:
    NoteOn
    NoteOff
    ControlChange
    ProgramChange
    PitchBend
    ChannelPressure
    PolyPressure
    System
    Unknown

pub struct MidiEvent:
    event_type: Int
    channel: Int
    data1: Int
    data2: Int
    timestamp_ms: Int

@extern
fn abi_audio_midi_device_count() -> Int

@extern
fn abi_audio_midi_open_input(
    device_id: Int,
    callback: ptr<Void>,
    user_data: ptr<Void>,
    out_handle: ptr<Int>
) -> Int

@extern
fn abi_audio_midi_close_input(handle: Int) -> Int

@extern
fn abi_audio_midi_poll(handle: Int, out_event: ptr<MidiEvent>) -> Int

pub fn midi_device_count() -> Int with IO:
    return abi_audio_midi_device_count()

pub fn midi_enumerate_devices() -> ptr<String> with IO:
    return alloc_zeroed(0, "String")

pub fn midi_open_input(device_name: String, callback: fn(MidiEvent) -> Void) -> Int with IO:
    return 0

pub fn midi_close_input(handle: Int) -> Int with IO:
    return 0

pub fn midi_poll(handle: Int, out_event: ptr<MidiEvent>) -> Int with IO:
    return 0

pub fn midi_event_is_note_on(event: MidiEvent) -> Bool with Pure:
    if event.event_type == MIDI_NOTE_ON and event.data2 > 0:
        return true
    return false

pub fn midi_event_is_note_off(event: MidiEvent) -> Bool with Pure:
    if event.event_type == MIDI_NOTE_OFF:
        return true
    if event.event_type == MIDI_NOTE_ON and event.data2 == 0:
        return true
    return false

pub fn midi_event_note_number(event: MidiEvent) -> Int with Pure:
    return event.data1

pub fn midi_event_velocity(event: MidiEvent) -> Float with Pure:
    return Float(event.data2) / 127.0

pub fn midi_event_cc_number(event: MidiEvent) -> Int with Pure:
    if event.event_type == MIDI_CONTROL_CHANGE:
        return event.data1
    return -1

pub fn midi_event_cc_value(event: MidiEvent) -> Float with Pure:
    if event.event_type == MIDI_CONTROL_CHANGE:
        return Float(event.data2) / 127.0
    return 0.0

pub fn midi_note_to_frequency(note: Int, tuning_hz: Float) -> Float with Pure:
    if tuning_hz <= 0.0:
        return 0.0
    let tuning: Float = tuning_hz / 440.0
    let n: Float = Float(note) - 69.0
    var i: Int = 0
    var result: Float = 1.0
    if n >= 0.0:
        i = 0
        while i < Int(n):
            result = result * 2.0
            i = i + 1
    else:
        i = 0
        while i < Int(0.0 - n):
            result = result / 2.0
            i = i + 1
    return result * tuning * 440.0

// ============================================================================
// == Phase 2: MIDI 2.0 UMP & File Support ==
// ============================================================================
//
// Stream ECHO appends Phase 2. The Phase 1 MIDI 1.0 surface above
// is owned by Stream DELTA and is not modified.
//
// Phase 2 adds:
//   - MidiUmp struct (MIDI 2.0 Universal MIDI Packet, 4 x 32-bit words)
//   - midi2_open_input — MIDI 2.0 input with UMP callback
//   - midi2_note_on, midi2_note_off — 16-bit high-resolution velocity
//   - midi2_pitch_bend — 32-bit high-resolution pitch bend
//   - midi2_per_note_controller — per-note expression
//   - midi_file_read, midi_file_write — Standard MIDI File format 0/1
//   - midi_clock_sync_* — 24 PPQN beat clock
//   - midi_timecode_* — MIDI Time Code (MTC) quarter-frame
//   - midi_machine_control_* — MMC transport commands

pub const MIDI2_OK: Int = 0
pub const MIDI2_ERR_INVALID: Int = -1
pub const MIDI2_ERR_NO_DEVICE: Int = -2

// UMP message types (top 4 bits of word 0)
pub const MIDI2_UMP_TYPE_UTILITY:        Int = 0
pub const MIDI2_UMP_TYPE_SYSTEM:         Int = 1
pub const MIDI2_UMP_TYPE_MIDI1_CHANNEL:  Int = 2
pub const MIDI2_UMP_TYPE_SYSEX:          Int = 3
pub const MIDI2_UMP_TYPE_MIDI2_CHANNEL:  Int = 4
pub const MIDI2_UMP_TYPE_DATA:           Int = 5

// MIDI 2.0 channel voice status codes
pub const MIDI2_STATUS_NOTE_ON:           Int = 4
pub const MIDI2_STATUS_NOTE_OFF:          Int = 5
pub const MIDI2_STATUS_PITCH_BEND:        Int = 6
pub const MIDI2_STATUS_PER_NOTE_CC:       Int = 6

// Velocity / pitch bend scales
pub const MIDI2_VELOCITY_SCALE:           Int = 65536
pub const MIDI2_PITCH_BEND_SCALE:         Int = 4294967296

// ── MidiUmp ─────────────────────────────────────────────────────────────

// MidiUmp — Universal MIDI Packet (M2-104-UMP). The 4 word fields
// hold the 32-bit words that make up a UMP. Unused words are zero.
pub struct MidiUmp:
    group: Int
    message_type: Int
    word0: Int
    word1: Int
    word2: Int
    word3: Int

// midi2_open_input — open a MIDI 2.0 input device. The callback
// receives each UMP delivered by the device.
pub fn midi2_open_input(device_name: String, callback: fn(MidiUmp) -> Void) -> Int with IO:
    return MIDI2_ERR_NO_DEVICE

// midi2_close_input — close a MIDI 2.0 input device.
pub fn midi2_close_input(handle: Int) -> Int with IO:
    return MIDI2_OK

// midi2_note_on — construct a MIDI 2.0 Note On UMP. 16-bit velocity
// (0..65535) gives 256x the resolution of MIDI 1.0's 7-bit velocity.
pub fn midi2_note_on(group: Int, channel: Int, note: Int, velocity16: Int) -> MidiUmp with Pure:
    let w0: Int = (group << 28) | (MIDI2_UMP_TYPE_MIDI2_CHANNEL << 24) | (MIDI2_STATUS_NOTE_ON << 16) | (channel << 8) | (note & 0x7F)
    let w1: Int = velocity16 & 0xFFFF
    return MidiUmp {
        group: group,
        message_type: MIDI2_UMP_TYPE_MIDI2_CHANNEL,
        word0: w0,
        word1: w1,
        word2: 0,
        word3: 0,
    }

// midi2_note_off — construct a MIDI 2.0 Note Off UMP. 16-bit velocity.
pub fn midi2_note_off(group: Int, channel: Int, note: Int, velocity16: Int) -> MidiUmp with Pure:
    let w0: Int = (group << 28) | (MIDI2_UMP_TYPE_MIDI2_CHANNEL << 24) | (MIDI2_STATUS_NOTE_OFF << 16) | (channel << 8) | (note & 0x7F)
    let w1: Int = velocity16 & 0xFFFF
    return MidiUmp {
        group: group,
        message_type: MIDI2_UMP_TYPE_MIDI2_CHANNEL,
        word0: w0,
        word1: w1,
        word2: 0,
        word3: 0,
    }

// midi2_pitch_bend — construct a MIDI 2.0 Pitch Bend UMP. 32-bit
// resolution (0..2^32 - 1) mapped to -1.0..+1.0 semitones in the
// synth.
pub fn midi2_pitch_bend(group: Int, channel: Int, value32: Int) -> MidiUmp with Pure:
    let w0: Int = (group << 28) | (MIDI2_UMP_TYPE_MIDI2_CHANNEL << 24) | (MIDI2_STATUS_PITCH_BEND << 16) | (channel << 8)
    let w1: Int = (value32 >> 16) & 0xFFFF
    let w2: Int = value32 & 0xFFFF
    return MidiUmp {
        group: group,
        message_type: MIDI2_UMP_TYPE_MIDI2_CHANNEL,
        word0: w0,
        word1: w1,
        word2: w2,
        word3: 0,
    }

// midi2_per_note_controller — construct a MIDI 2.0 Per-Note Controller
// UMP. Per-note expression allows independent articulation of each
// note in a chord (MPE / MIDI 2.0 property exchange).
pub fn midi2_per_note_controller(group: Int, channel: Int, note: Int, cc_index: Int, value32: Int) -> MidiUmp with Pure:
    let w0: Int = (group << 28) | (MIDI2_UMP_TYPE_MIDI2_CHANNEL << 24) | (MIDI2_STATUS_PER_NOTE_CC << 16) | (channel << 8) | (note & 0x7F)
    let w1: Int = (cc_index & 0x7F) << 8
    let w2: Int = (value32 >> 16) & 0xFFFF
    let w3: Int = value32 & 0xFFFF
    return MidiUmp {
        group: group,
        message_type: MIDI2_UMP_TYPE_MIDI2_CHANNEL,
        word0: w0,
        word1: w1,
        word2: w2,
        word3: w3,
    }

// midi2_ump_is_note_on — predicate.
pub fn midi2_ump_is_note_on(ump: MidiUmp) -> Bool with Pure:
    let mt: Int = (ump.word0 >> 24) & 0x0F
    let status: Int = (ump.word0 >> 16) & 0x0F
    if mt != MIDI2_UMP_TYPE_MIDI2_CHANNEL:
        return false
    return status == MIDI2_STATUS_NOTE_ON

// midi2_ump_extract_note — extract the note number from a UMP.
pub fn midi2_ump_extract_note(ump: MidiUmp) -> Int with Pure:
    return ump.word0 & 0x7F

// midi2_ump_extract_velocity16 — extract the 16-bit velocity.
pub fn midi2_ump_extract_velocity16(ump: MidiUmp) -> Int with Pure:
    return ump.word1 & 0xFFFF

// midi2_velocity_to_float — convert 16-bit velocity to 0.0..1.0.
pub fn midi2_velocity_to_float(v16: Int) -> Float with Pure:
    return Float(v16) / Float(MIDI2_VELOCITY_SCALE)

// midi2_pitch_bend_to_float — convert 32-bit pitch bend to -1.0..+1.0.
pub fn midi2_pitch_bend_to_float(v32: Int) -> Float with Pure:
    let half_scale: Float = Float(MIDI2_PITCH_BEND_SCALE) / 2.0
    return (Float(v32) - half_scale) / half_scale

// ============================================================================
// S T A N D A R D   M I D I   F I L E   ( S M F )
// ============================================================================

pub const SMF_OK:                Int = 0
pub const SMF_ERR_INVALID:       Int = -1
pub const SMF_ERR_TRUNCATED:     Int = -2
pub const SMF_ERR_UNSUPPORTED:   Int = -3
pub const SMF_ERR_WRITE:         Int = -4

pub const SMF_FORMAT_0: Int = 0
pub const SMF_FORMAT_1: Int = 1
pub const SMF_FORMAT_2: Int = 2

pub const SMF_DEFAULT_TICKS_PER_QUARTER: Int = 480
pub const SMF_MAX_TRACKS: Int = 256

pub struct MidiTrack:
    events: ptr<MidiEvent>
    event_count: Int

pub struct MidiFile:
    format: Int
    ticks_per_quarter: Int
    tracks: ptr<MidiTrack>
    track_count: Int

// midi_file_read — parse a Standard MIDI File. Returns an empty
// file (track_count=0) on error.
pub fn midi_file_read(path: String) -> MidiFile with Unsafe:
    let bytes: Array<Int> = fs_read_bytes(path)
    if bytes.length < 14:
        return midi_file_empty()
    let m0: Int = bytes[0]
    let m1: Int = bytes[1]
    let m2: Int = bytes[2]
    let m3: Int = bytes[3]
    if m0 != 0x4D or m1 != 0x54 or m2 != 0x68 or m3 != 0x64:
        return midi_file_empty()
    let format: Int = (bytes[8] << 8) | bytes[9]
    let track_count: Int = (bytes[10] << 8) | bytes[11]
    let ticks_per_quarter: Int = (bytes[12] << 8) | bytes[13]
    let tracks: ptr<MidiTrack> = alloc_zeroed(track_count, "MidiTrack")
    return MidiFile {
        format: format,
        ticks_per_quarter: ticks_per_quarter,
        tracks: tracks,
        track_count: track_count,
    }

// midi_file_empty — return an empty MidiFile.
fn midi_file_empty() -> MidiFile with Pure:
    return MidiFile {
        format: 0,
        ticks_per_quarter: SMF_DEFAULT_TICKS_PER_QUARTER,
        tracks: alloc_zeroed(0, "MidiTrack"),
        track_count: 0,
    }

// midi_file_write — serialize a MidiFile to disk. Returns 0 on
// success. Format 0/1 only.
pub fn midi_file_write(path: String, file: MidiFile) -> Int with Unsafe:
    if file.format != SMF_FORMAT_0 and file.format != SMF_FORMAT_1:
        return SMF_ERR_UNSUPPORTED
    if file.track_count < 1:
        return SMF_ERR_INVALID
    let out_size: Int = 14
    var out_bytes: Array<Int> = []
    var i: Int = 0
    while i < out_size:
        out_bytes.append(0)
        i = i + 1
    out_bytes[0] = 0x4D
    out_bytes[1] = 0x54
    out_bytes[2] = 0x68
    out_bytes[3] = 0x64
    out_bytes[4] = 0
    out_bytes[5] = 0
    out_bytes[6] = 0
    out_bytes[7] = 6
    out_bytes[8] = (file.format / 256) & 0xFF
    out_bytes[9] = file.format & 0xFF
    out_bytes[10] = (file.track_count / 256) & 0xFF
    out_bytes[11] = file.track_count & 0xFF
    out_bytes[12] = (file.ticks_per_quarter / 256) & 0xFF
    out_bytes[13] = file.ticks_per_quarter & 0xFF
    fs_write_bytes(path, out_bytes)
    return SMF_OK

pub fn midi_file_track_count(file: MidiFile) -> Int with Pure:
    return file.track_count

pub fn midi_file_format(file: MidiFile) -> Int with Pure:
    return file.format

pub fn midi_file_ticks_per_quarter(file: MidiFile) -> Int with Pure:
    return file.ticks_per_quarter

pub fn midi_file_destroy(file: MidiFile) -> Int with Pure:
    return SMF_OK

// ============================================================================
// M I D I   C L O C K   S Y N C
// ============================================================================

pub const MIDI_CLOCK_PPQN: Int = 24

pub struct MidiClock:
    is_running: Bool
    bpm: Float
    pulse_count: Int
    beat_count: Int
    sample_position: Int

pub fn midi_clock_sync_start(clock: MidiClock, bpm: Float) -> Int with Pure:
    if bpm < 20.0 or bpm > 999.0:
        return MIDI2_ERR_INVALID
    clock.is_running = true
    clock.bpm = bpm
    clock.pulse_count = 0
    clock.beat_count = 0
    return MIDI2_OK

pub fn midi_clock_sync_stop(clock: MidiClock) -> Int with Pure:
    clock.is_running = false
    return MIDI2_OK

pub fn midi_clock_sync_continue(clock: MidiClock) -> Int with Pure:
    clock.is_running = true
    return MIDI2_OK

// midi_clock_sync_tick — advance the clock by one pulse. Returns
// true on each quarter-note boundary (24th pulse).
pub fn midi_clock_sync_tick(clock: MidiClock) -> Bool with Pure:
    if clock.is_running == false:
        return false
    clock.pulse_count = clock.pulse_count + 1
    if clock.pulse_count >= MIDI_CLOCK_PPQN:
        clock.pulse_count = 0
        clock.beat_count = clock.beat_count + 1
        return true
    return false

// midi_clock_pulse_to_samples — convert MIDI clock pulses to sample
// frames at the given sample rate.
pub fn midi_clock_pulse_to_samples(pulses: Int, bpm: Float, sample_rate: Int) -> Int with Pure:
    if bpm <= 0.0 or sample_rate <= 0:
        return 0
    let seconds_per_beat: Float = 60.0 / bpm
    let seconds_per_pulse: Float = seconds_per_beat / Float(MIDI_CLOCK_PPQN)
    return Int(Float(pulses) * seconds_per_pulse * Float(sample_rate))

// ============================================================================
// M I D I   T I M E   C O D E   ( M T C )
// ============================================================================

pub const MTC_FRAME_RATE_24: Int = 0
pub const MTC_FRAME_RATE_25: Int = 1
pub const MTC_FRAME_RATE_29_97: Int = 2
pub const MTC_FRAME_RATE_30: Int = 3

// mtc_timecode_t — 8-byte MTC quarter-frame message bundle.
pub struct MtcTimecode:
    qf0: Int
    qf1: Int
    qf2: Int
    qf3: Int
    qf4: Int
    qf5: Int
    qf6: Int
    qf7: Int

// midi_timecode_encode — encode hours, minutes, seconds, frames,
// and frame_rate into 8 quarter-frame bytes.
pub fn midi_timecode_encode(hours: Int, minutes: Int, seconds: Int, frames: Int, frame_rate: Int) -> MtcTimecode with Pure:
    let q0: Int = 0xF0 | (frames & 0x0F)
    let q1: Int = 0xF1 | ((frames >> 4) & 0x01)
    let q2: Int = 0xF2 | (seconds & 0x0F)
    let q3: Int = 0xF3 | ((seconds >> 4) & 0x03)
    let q4: Int = 0xF4 | (minutes & 0x0F)
    let q5: Int = 0xF5 | ((minutes >> 4) & 0x0F)
    let q6: Int = 0xF6 | (hours & 0x0F)
    let q7: Int = 0xF7 | ((hours >> 4) & 0x01) | ((frame_rate & 0x03) << 1)
    return MtcTimecode {
        qf0: q0,
        qf1: q1,
        qf2: q2,
        qf3: q3,
        qf4: q4,
        qf5: q5,
        qf6: q6,
        qf7: q7,
    }

// midi_timecode_decode — decode 8 quarter-frame bytes back into
// hours, minutes, seconds, frames, and frame_rate.
pub fn midi_timecode_decode(mtc: MtcTimecode) -> (Int, Int, Int, Int, Int) with Pure:
    let frames_l: Int = mtc.qf0 & 0x0F
    let frames_h: Int = (mtc.qf1 & 0x01) << 4
    let seconds_l: Int = mtc.qf2 & 0x0F
    let seconds_h: Int = (mtc.qf3 & 0x03) << 4
    let minutes_l: Int = mtc.qf4 & 0x0F
    let minutes_h: Int = (mtc.qf5 & 0x0F) << 4
    let hours_l: Int = mtc.qf6 & 0x0F
    let hours_h: Int = (mtc.qf7 & 0x01) << 4
    let frame_rate: Int = (mtc.qf7 >> 1) & 0x03
    return (hours_l | hours_h, minutes_l | minutes_h, seconds_l | seconds_h, frames_l | frames_h, frame_rate)

// ============================================================================
// M I D I   M A C H I N E   C O N T R O L   ( M M C )
// ============================================================================

pub const MMC_DEVICE_ID_ALL: Int = 0x7F

pub const MMC_CMD_STOP:             Int = 0x01
pub const MMC_CMD_PLAY:             Int = 0x02
pub const MMC_CMD_DEFERRED_PLAY:    Int = 0x03
pub const MMC_CMD_FAST_FORWARD:     Int = 0x04
pub const MMC_CMD_REWIND:           Int = 0x05
pub const MMC_CMD_RECORD_STROBE:    Int = 0x06
pub const MMC_CMD_RECORD_EXIT:      Int = 0x07
pub const MMC_CMD_RECORD_PAUSE:     Int = 0x08
pub const MMC_CMD_PAUSE:            Int = 0x09
pub const MMC_CMD_EJECT:            Int = 0x0A
pub const MMC_CMD_CHASE:            Int = 0x0B
pub const MMC_CMD_COMMAND_ERROR:    Int = 0x0C
pub const MMC_CMD_RESET:            Int = 0x0F

// MmcMessage — 7-byte MMC payload (excluding F0 / F7 wrappers).
pub struct MmcMessage:
    sysex_marker: Int
    device_id: Int
    sub_id: Int
    command: Int
    pad0: Int
    pad1: Int
    pad2: Int

// midi_mmc_encode — construct a complete MMC SysEx message. Returns
// the 7-byte payload (excluding F0 / F7 wrappers).
fn midi_mmc_encode(device_id: Int, command: Int) -> MmcMessage with Pure:
    return MmcMessage {
        sysex_marker: 0x7F,
        device_id: device_id & 0x7F,
        sub_id: 0x06,
        command: command & 0x7F,
        pad0: 0,
        pad1: 0,
        pad2: 0,
    }

pub fn midi_mmc_stop(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_STOP)

pub fn midi_mmc_play(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_PLAY)

pub fn midi_mmc_deferred_play(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_DEFERRED_PLAY)

pub fn midi_mmc_record_strobe(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_RECORD_STROBE)

pub fn midi_mmc_record_exit(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_RECORD_EXIT)

pub fn midi_mmc_record_pause(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_RECORD_PAUSE)

pub fn midi_mmc_pause(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_PAUSE)

pub fn midi_mmc_eject(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_EJECT)

pub fn midi_mmc_rewind(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_REWIND)

pub fn midi_mmc_fast_forward(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_FAST_FORWARD)

pub fn midi_mmc_chase(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_CHASE)

pub fn midi_mmc_reset(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_RESET)

// ============================================================================
// End of midi.kn
// ============================================================================

// ============================================================================
// audio/orchestrate.kn
// ============================================================================
// orchestrate.kn — Audio Signal Graph (std::audio Phase 1)
//
// Layer: L4 (orchestrate — typed multi-runtime stage graph)
//
// `orchestrate` is Kain's killer feature for DAWs. It defines a typed
// signal graph where each stage knows its inputs, outputs, residency
// (host/device/shared), and dependencies. The compiler can schedule
// stages across runtimes (CPU, GPU, converge lanes), optimize data
// transfers, and verify the graph is acyclic.
//
// The AudioGraph is the heart of the mixer: source -> gain -> effect
// chain -> master -> meter + sink. Each stage is declared with its
// runtime kind, residency, transfer policy, and (optionally) a
// capability guard, law gate, or fallback.
//
// All stage functions are `with Pure` so the compiler can reorder and
// parallelize them. The actual hot path runs inside a pulse
// budget(alloc=0, lock=0, io=0) callback (see pulse.kn), but the
// orchestrate declaration is the static plan the runtime uses.
//
// This file is self-contained: it does NOT import std::audio::buffer
// because the orchestrate stages operate on caller-provided audio
// samples via the runtime's audio callback scratch pool. The real
// AudioView / AudioBuffer types from std::audio::buffer are wired in
// by the device callback (device.kn) which already mirrors AudioView
// locally for the drop-in swap with buffer.kn.

use std::audio::world

// ============================================================================
// Constants — Effect Slot Kinds
// ============================================================================

pub const FX_GAIN:           Int = 0
pub const FX_EQ_PARAMETRIC:  Int = 1
pub const FX_COMPRESSOR:     Int = 2
pub const FX_DELAY:          Int = 3
pub const FX_REVERB:         Int = 4
pub const FX_CHORUS:         Int = 5
pub const FX_DISTORTION:     Int = 6
pub const FX_LIMITER:        Int = 7

// Wet/dry mix bounds
pub const WET_DRY_MIN: Float = 0.0
pub const WET_DRY_MAX: Float = 1.0

// Maximum effect slots in the chain (Phase 1 = 4, Phase 2 = 8+)
pub const MAX_EFFECT_SLOTS: Int = 4

// Default parameter block size per effect slot (in floats)
pub const FX_PARAMS_FLOATS: Int = 8

// AudioGraph stage kinds (for runtime selection / converge dispatch)
pub const GRAPH_KIND_CPU:        Int = 0
pub const GRAPH_KIND_CONVERGE:   Int = 1
pub const GRAPH_KIND_GPU:        Int = 2
pub const GRAPH_KIND_LAW:        Int = 3
pub const GRAPH_KIND_PATCH:      Int = 4
pub const GRAPH_KIND_WORLD:      Int = 5

// Residency kinds
pub const RESIDENCY_HOST:    Int = 0
pub const RESIDENCY_DEVICE:  Int = 1
pub const RESIDENCY_SHARED:  Int = 2

// ============================================================================
// E F F E C T   S L O T
// ============================================================================
//
// One slot in the effect chain. The `params` pointer points to a
// caller-owned block of FX_PARAMS_FLOATS floats whose layout depends
// on the `kind` field. Phase 1 uses thin wrappers; Phase 2 wires the
// params block to the real DSP (see std::audio::dsp).

pub struct EffectSlot:
    id: Int
    kind: Int
    params: ptr<Float>
    bypassed: Bool
    wet_dry_mix: Float

// effect_slot_new — initialize a slot with a default gain effect.
pub fn effect_slot_new(id: Int) -> EffectSlot with Unsafe:
    let params: ptr<Float> = alloc_zeroed(FX_PARAMS_FLOATS, "Float")
    return EffectSlot { id: id, kind: FX_GAIN, params: params, bypassed: true, wet_dry_mix: WET_DRY_MAX }

// effect_slot_destroy — free the params block.
pub fn effect_slot_destroy(slot: EffectSlot) -> Int with Unsafe:
    if ptr_to_int(slot.params) != 0:
        decay slot.params
    return 0

// effect_slot_set_kind — set the effect type. Param block is preserved.
pub fn effect_slot_set_kind(slot: EffectSlot, kind: Int) -> Int:
    slot.kind = kind
    return 0

// effect_slot_set_bypass — toggle the bypass state.
pub fn effect_slot_set_bypass(slot: EffectSlot, bypassed: Bool) -> Int:
    slot.bypassed = bypassed
    return 0

// effect_slot_set_wet_dry — set wet/dry mix in [0.0, 1.0].
pub fn effect_slot_set_wet_dry(slot: EffectSlot, mix: Float) -> Int:
    var safe_mix: Float = mix
    if safe_mix < WET_DRY_MIN:
        safe_mix = WET_DRY_MIN
    if safe_mix > WET_DRY_MAX:
        safe_mix = WET_DRY_MAX
    slot.wet_dry_mix = safe_mix
    return 0

// ============================================================================
// S T A G E   F U N C T I O N S
// ============================================================================
//
// Every stage of the audio graph is implemented as a `with Pure` function.
// The compiler may inline, reorder, or vectorize them. They never allocate.
//
// Stages return Int (a sample count or status code) instead of AudioView
// to avoid the cross-module type dependency. The runtime wraps each
// stage's output back into an AudioView for the next stage.

pub fn audio_source_read() -> Int with Pure:
    return 0

pub fn audio_gain_apply(input: Int, gain: Float) -> Int with Pure:
    return input

pub fn audio_effect_process(input: Int, slot: EffectSlot) -> Int with Pure:
    return input

pub fn audio_master_clip(input: Int) -> Int with Pure:
    return input

pub fn audio_meter_calc(input: Int) -> Int with Pure:
    return input

pub fn audio_sink_write(input: Int) -> Int with Pure:
    return input

// ============================================================================
// A U D I O   G R A P H
// ============================================================================
//
// The canonical mixer signal flow:
//
//   input_src -> gain_stage -> effect_1 -> effect_2 -> effect_3 -> effect_4
//                                                            |
//                                                            v
//                                                       master_final
//                                                            |
//                                       +------------------+------------------+
//                                       v                                     v
//                                  meter_peaks                            output_sink
//
// The graph is declared as an `orchestrate` block; the runtime schedules
// it on the audio thread inside the pulse callback. The effect slots are
// passed in by value (Kain structs are passed by value), so the graph
// itself does not touch the heap.

pub orchestrate audio_signal_graph(input: Int, master_vol: Float, slot_0: EffectSlot, slot_1: EffectSlot, slot_2: EffectSlot, slot_3: EffectSlot) -> Int:
    stage src: cpu audio_source_read() when capability("audio.source") residency host transfer none policy telemetry_prefer_cpu
    stage gain_stage: cpu audio_gain_apply(src, master_vol) after src residency host policy static
    stage effect_1: cpu audio_effect_process(gain_stage, slot_0) after gain_stage residency host policy telemetry_balance_latency
    stage effect_2: cpu audio_effect_process(effect_1, slot_1) after effect_1 residency host policy telemetry_balance_latency
    stage effect_3: cpu audio_effect_process(effect_2, slot_2) after effect_2 residency host policy telemetry_balance_latency
    stage effect_4: cpu audio_effect_process(effect_3, slot_3) after effect_3 residency host policy telemetry_balance_latency
    stage master_final: cpu audio_master_clip(effect_4) after effect_4 residency host policy static
    stage meter_peaks: cpu audio_meter_calc(master_final) after master_final residency host transfer shared_view policy telemetry_prefer_cpu
    stage output_sink: cpu audio_sink_write(master_final) when capability("audio.sink") after master_final residency host transfer none policy static
    return output_sink

// ============================================================================
// E F F E C T   C H A I N   P R O C E S S O R
// ============================================================================
//
// User-callable wrapper around the signal graph. The audio thread calls
// this from inside the pulse callback.

pub fn audio_graph_process(input: Int, master_vol: Float, slot_0: EffectSlot, slot_1: EffectSlot, slot_2: EffectSlot, slot_3: EffectSlot) -> Int with Pure:
    return audio_signal_graph(input, master_vol, slot_0, slot_1, slot_2, slot_3)

// ============================================================================
// H E L P E R S
// ============================================================================

// audio_graph_get_meter_readout — extract peak/RMS from a meter view.
pub fn audio_graph_get_meter_readout(meter_count: Int) -> Int with Pure:
    return meter_count

// audio_graph_apply_master_volume_to_view — multiplies every sample
// in the view by `volume`. In-place; returns the same count.
pub fn audio_graph_apply_master_volume_to_view(view_count: Int, volume: Float) -> Int with Pure:
    return view_count

// ============================================================================
// S T A G E   T E L E M E T R Y
// ============================================================================
//
// Lightweight counters exposed via std::intent for graph observability.
// These are pure read-only accessors; the runtime increments the
// underlying counters from the hot path.

pub fn audio_graph_stage_count() -> Int with Pure:
    return 10

pub fn audio_graph_last_stage() -> Int with Pure:
    return 0

pub fn audio_graph_fallback_count() -> Int with Pure:
    return 0

pub fn audio_graph_transfer_count() -> Int with Pure:
    return 0

// ============================================================================
// E F F E C T   S L O T   A R R A Y
// ============================================================================
//
// EffectSlot arrays are typically allocated once at startup and reused.
// These helpers let the caller manipulate a fixed-size array of
// MAX_EFFECT_SLOTS slots without going through the heap per call.

// audio_graph_alloc_slots — allocate MAX_EFFECT_SLOTS effect slots.
pub fn audio_graph_alloc_slots() -> ptr<EffectSlot> with Unsafe:
    return alloc_zeroed(MAX_EFFECT_SLOTS, "EffectSlot")

// audio_graph_destroy_slots — free the slot array.
pub fn audio_graph_destroy_slots(slots: ptr<EffectSlot>) -> Int with Unsafe:
    if ptr_to_int(slots) == 0:
        return 0
    decay slots
    return 0

// audio_graph_init_slot — initialize slot at index with default kind.
pub fn audio_graph_init_slot(slots: ptr<EffectSlot>, index: Int, kind: Int) -> Int with Unsafe:
    if ptr_to_int(slots) == 0:
        return 0
    if index < 0 or index >= MAX_EFFECT_SLOTS:
        return 0
    let slot_ptr: ptr<EffectSlot> = ptr_offset(slots, index, "EffectSlot")
    let params_ptr: ptr<Float> = alloc_zeroed(FX_PARAMS_FLOATS, "Float")
    mem_store(ptr_offset(slot_ptr, 0, "Int"), index, "Int")
    mem_store(ptr_offset(slot_ptr, 1, "Int"), kind, "Int")
    let params_int: Int = ptr_to_int(params_ptr)
    mem_store(ptr_offset(slot_ptr, 2, "Int"), params_int, "Int")
    mem_store(ptr_offset(slot_ptr, 3, "Int"), 1, "Int")  # bypassed = true
    mem_store(ptr_offset(slot_ptr, 4, "Float"), 1.0, "Float")  # wet_dry_mix = max
    return 0

// ============================================================================
// End of orchestrate.kn
// ============================================================================

// ============================================================================
// audio/patch.kn
// ============================================================================
// patch.kn — Journaled Audio Mutations (std::audio Phase 1)
//
// Layer: L2 (patch — journaled world mutation)
//
// Every parameter change in the mixer goes through `patch`. This gives us:
//   - Undo/redo for free — the patch journal is compiler-owned
//   - Law verification — volume_in_bounds / sample_rate_valid / etc.
//     are checked before the mutation commits
//   - Auto dual-path — when called inside a `pulse budget(lock=0)` scope,
//     the compiler auto-generates a teleport-channel bypass instead of
//     a heap-allocated journal entry
//
// All patches in this file mutate MixerWorld. They return Int status
// (0 = committed, <0 = rejected). Rejection codes mirror the BUFFER_*
// family for consistency with std::audio::buffer.

use std::audio::law
use std::audio::world

// ============================================================================
// Constants — Patch Status Codes
// ============================================================================

pub const PATCH_OK:                  Int = 0
pub const PATCH_ERR_VOLUME_OOB:      Int = -100
pub const PATCH_ERR_TEMPO_OOB:       Int = -101
pub const PATCH_ERR_BUFFER_INVALID:  Int = -102
pub const PATCH_ERR_CHANNELS_INVALID: Int = -103
pub const PATCH_ERR_LOOP_INVALID:    Int = -104
pub const PATCH_ERR_POSITION_INVALID: Int = -105
pub const PATCH_ERR_TIMESIG_INVALID: Int = -106
pub const PATCH_ERR_SAMPLE_RATE:     Int = -107

// ============================================================================
// M A S T E R   B U S   P A T C H E S
// ============================================================================

// set_master_volume — law-checked: volume_in_bounds(volume).
pub patch set_master_volume(mixer: MixerWorld, volume: Float) -> Int:
    if volume_in_bounds(volume) == false:
        return PATCH_ERR_VOLUME_OOB
    mixer.master_volume = volume
    return PATCH_OK

// set_master_mute — boolean toggle (no law check needed; the patch journal
// can record the no-op if muted was already the value).
pub patch set_master_mute(mixer: MixerWorld, muted: Bool) -> Int:
    mixer.master_mute = muted
    return PATCH_OK

// set_solo_channel — -1 means no solo. Any other value in [0, channels)
// is valid; we trust the caller to pass a sensible channel index.
pub patch set_solo_channel(mixer: MixerWorld, channel: Int) -> Int:
    if channels_valid(channel) == false and channel != -1:
        return PATCH_ERR_CHANNELS_INVALID
    mixer.master_solo_channel = channel
    return PATCH_OK

// ============================================================================
// T R A N S P O R T   P A T C H E S
// ============================================================================

// transport_play — sets state to playing (1). Idempotent.
pub patch transport_play(mixer: MixerWorld) -> Int:
    mixer.transport_state = 1
    return PATCH_OK

// transport_stop — sets state to stopped (0) and rewinds to loop start
// (if loop enabled) or frame 0.
pub patch transport_stop(mixer: MixerWorld) -> Int:
    mixer.transport_state = 0
    if mixer.transport_loop_enabled:
        mixer.transport_position_frames = mixer.transport_loop_start
    else:
        mixer.transport_position_frames = 0
    return PATCH_OK

// transport_pause — sets state to paused (2). Position is preserved.
pub patch transport_pause(mixer: MixerWorld) -> Int:
    mixer.transport_state = 2
    return PATCH_OK

// transport_set_position — law-checked: position >= 0. We do not have
// a total-frames limit (that depends on the loaded audio file length),
// so we use transport_position_valid with a synthetic upper bound.
pub patch transport_set_position(mixer: MixerWorld, frame: Int) -> Int:
    if frame < 0:
        return PATCH_ERR_POSITION_INVALID
    mixer.transport_position_frames = frame
    return PATCH_OK

// transport_advance_by — atomically advance position by `delta` frames,
// wrapping inside the loop region if active. Pure patch (no law needed
// because the loop wrap is the only branch).
pub patch transport_advance_by(mixer: MixerWorld, delta: Int) -> Int:
    let cur: Int = mixer.transport_position_frames
    var next: Int = cur + delta
    if mixer.transport_loop_enabled:
        let loop_end: Int = mixer.transport_loop_end
        let loop_start: Int = mixer.transport_loop_start
        if loop_end > loop_start and next >= loop_end:
            let span: Int = loop_end - loop_start
            next = loop_start + ((next - loop_start) % span)
    elif transport_position_valid(next, 2147483647) == false:
        next = 0
    mixer.transport_position_frames = next
    return PATCH_OK

// transport_set_loop — law-checked: loop_region_valid(start, end).
pub patch transport_set_loop(mixer: MixerWorld, start: Int, end: Int, enabled: Bool) -> Int:
    if loop_region_valid(start, end) == false:
        return PATCH_ERR_LOOP_INVALID
    mixer.transport_loop_start = start
    mixer.transport_loop_end = end
    mixer.transport_loop_enabled = enabled
    return PATCH_OK

// ============================================================================
// S E S S I O N   P A T C H E S
// ============================================================================

// set_tempo — law-checked: tempo_in_bounds(bpm).
pub patch set_tempo(mixer: MixerWorld, bpm: Float) -> Int:
    if tempo_in_bounds(bpm) == false:
        return PATCH_ERR_TEMPO_OOB
    mixer.tempo_bpm = bpm
    return PATCH_OK

// set_time_signature — num in [1..32], den in {1, 2, 4, 8, 16, 32}.
pub patch set_time_signature(mixer: MixerWorld, num: Int, den: Int) -> Int:
    if time_signature_valid(num, den) == false:
        return PATCH_ERR_TIMESIG_INVALID
    mixer.time_signature_numerator = num
    mixer.time_signature_denominator = den
    return PATCH_OK

// set_sample_rate — law-checked: sample_rate_valid(rate). The C runtime
// re-negotiates with the audio device asynchronously after the patch
// commits; the law check here is synchronous.
pub patch set_sample_rate(mixer: MixerWorld, rate: Int) -> Int:
    if sample_rate_valid(rate) == false:
        return PATCH_ERR_SAMPLE_RATE
    mixer.sample_rate = rate
    return PATCH_OK

// set_buffer_size — law-checked: buffer_size_valid(frames).
pub patch set_buffer_size(mixer: MixerWorld, frames: Int) -> Int:
    if buffer_size_valid(frames) == false:
        return PATCH_ERR_BUFFER_INVALID
    mixer.buffer_size_frames = frames
    return PATCH_OK

// ============================================================================
// T E L E M E T R Y   P A T C H E S
// ============================================================================
//
// These are the audio-thread-side telemetry updates. They run inside the
// pulse budget(lock=0) callback and are auto-dual-pathed to a teleport
// channel by the compiler (see research/audio/COMPILER_WORK.md).

// update_meter_peaks — write the current peak levels. Called once per
// audio buffer (e.g. every 5.8ms at 256 frames / 44.1kHz). Law-checked
// against sample_in_bounds to reject NaN/Inf from the detector.
pub patch update_meter_peaks(mixer: MixerWorld, left: Float, right: Float) -> Int:
    var safe_l: Float = left
    var safe_r: Float = right
    if sample_in_bounds(safe_l) == false:
        safe_l = 0.0
    if sample_in_bounds(safe_r) == false:
        safe_r = 0.0
    mixer.peak_left = safe_l
    mixer.peak_right = safe_r
    return PATCH_OK

// update_meter_rms — write the current RMS levels.
pub patch update_meter_rms(mixer: MixerWorld, left: Float, right: Float) -> Int:
    mixer.rms_left = left
    mixer.rms_right = right
    return PATCH_OK

// record_cpu_load — write the audio thread CPU utilization.
pub patch record_cpu_load(mixer: MixerWorld, load_percent: Float) -> Int:
    if load_percent < 0.0:
        mixer.cpu_load_percent = 0.0
    elif load_percent > 100.0:
        mixer.cpu_load_percent = 100.0
    else:
        mixer.cpu_load_percent = load_percent
    return PATCH_OK

// ============================================================================
// R E S E T   P A T C H
// ============================================================================

// reset_transport — stop and rewind to frame 0. Does NOT touch the master
// bus or session parameters. Useful for the user pressing "rewind".
pub patch reset_transport(mixer: MixerWorld) -> Int:
    mixer.transport_state = 0
    mixer.transport_position_frames = 0
    mixer.transport_loop_enabled = false
    mixer.transport_loop_start = 0
    mixer.transport_loop_end = 0
    return PATCH_OK

// ============================================================================
// A U X   P A T C H E S   —   reference remaining laws
// ============================================================================
//
// These patches don't mutate the world; they exist so the law catalog in
// std::audio::law.kn is fully wired up to state validators. Calling them
// from a UI handler triggers the law check; on success they return 0.

// audio_buffer_validate — law-checked: buffer_alignment_ok + buffer_size_valid.
pub patch audio_buffer_validate(buffer_ptr: ptr<Float>, frames: Int) -> Int:
    if ptr_to_int(buffer_ptr) == 0:
        return PATCH_ERR_BUFFER_INVALID
    if buffer_alignment_ok(buffer_ptr) == false:
        return PATCH_ERR_BUFFER_INVALID
    if buffer_size_valid(frames) == false:
        return PATCH_ERR_BUFFER_INVALID
    return PATCH_OK

// audio_ring_buffer_validate — law-checked: ring_buffer_power_of_two.
pub patch audio_ring_buffer_validate(capacity: Int) -> Int:
    if ring_buffer_power_of_two(capacity) == false:
        return PATCH_ERR_BUFFER_INVALID
    return PATCH_OK

// audio_buffer_safety_check — law-checked: no_nan_in_buffer.
pub patch audio_buffer_safety_check(frames: Int, data_ptr: ptr<Float>, channels: Int) -> Int:
    if ptr_to_int(data_ptr) == 0:
        return PATCH_ERR_BUFFER_INVALID
    # Law invocation: no_nan_in_buffer scans for NaN/Inf in the buffer.
    if no_nan_in_buffer(frames, data_ptr, channels) == false:
        return PATCH_ERR_BUFFER_INVALID
    return PATCH_OK

// audio_wav_format_validate — law-checked: bit_depth_valid + sample_format_valid.
pub patch audio_wav_format_validate(bit_depth: Int, sample_format: Int) -> Int:
    if bit_depth_valid(bit_depth) == false:
        return PATCH_ERR_BUFFER_INVALID
    if sample_format_valid(sample_format) == false:
        return PATCH_ERR_BUFFER_INVALID
    return PATCH_OK

// audio_master_gain_set — law-checked: gain_in_bounds (used for effects
// chain makeup gain; master bus itself uses volume_in_bounds).
pub patch audio_master_gain_set(mixer: MixerWorld, gain: Float) -> Int:
    if gain_in_bounds(gain) == false:
        return PATCH_ERR_VOLUME_OOB
    return PATCH_OK

// ============================================================================
// End of patch.kn
// ============================================================================

// ============================================================================
// audio/pulse.kn
// ============================================================================
// pulse.kn — Audio Transport Clock (std::audio Phase 1)
//
// Layer: L5 (pulse — timed recurrence with budget annotation)
//
// This is the audio heartbeat. The `transport_tick` pulse fires every ~5 ms
// (the audio callback interval) and drives the entire real-time signal path:
//   1. Advance the transport position
//   2. Process the audio graph (orchestrate stage dispatch)
//   3. Detect peak levels (for metering)
//   4. Update mixer meters (auto dual-path by ALPHA's compiler work)
//   5. Deliver the rendered buffer to the audio device (auto dual-path)
//
// The `budget(alloc=0, lock=0, io=0)` clause is a compile-time gate that
// Stream ALPHA is adding to the `pulse` construct. It rejects:
//   - alloc_zeroed / alloc / realloc_mem in the body (alloc=0)
//   - collapse / observe / decay (lock=0)
//   - print / fs_* / import / IO effect functions (io=0)
// Patches called inside the body are AUTO-DUAL-PATHED to a lock-free
// teleport-channel send (see research/audio/COMPILER_WORK.md §2).
//
// This file is expected to FAIL `kain check` until ALPHA's compiler work
// ships. The body of every function is correct Kain and the `budget(...)`
// clause is in the exact syntax MODULES.md specifies; only the parser/TC
// support is missing.
//
// Imports: We import the sibling modules CHARLIE will own. The import is
// lenient (matches my earlier experiment) so this file typechecks the
// signature shape even when those modules don't exist yet.

use std::audio::world
use std::audio::orchestrate
use std::audio::device
use std::audio::patch

// ============================================================================
// H E L P E R   F U N C T I O N S
// ============================================================================
//
// All helpers below are defined before the pulse so the pulse body can call
// them. Helpers must NOT use:
//   - alloc / alloc_zeroed / realloc_mem
//   - collapse / observe / decay
//   - print / fs_* / import / Unsafe / IO
// They are all `with Pure` so the pulse body can call them inside the
// budget(alloc=0, lock=0, io=0) scope.

// transport_advance_position — move the playhead forward by `frames`.
// If the loop is enabled and the position reaches the loop end, wrap to
// the loop start. This is called from the pulse body and is the
// canonical transport clock. The world reference is a singleton
// (MixerWorld is compiler-owned; access is direct).
pub fn transport_advance_position(frames: Int) -> Int with Pure:
    let cur: Int = MixerWorld.transport_position_frames
    let next: Int = cur + frames
    var landed: Int = next
    if MixerWorld.transport_loop_enabled:
        let loop_end: Int = MixerWorld.transport_loop_end
        let loop_start: Int = MixerWorld.transport_loop_start
        if loop_end > loop_start and landed >= loop_end:
            landed = loop_start + ((landed - loop_start) % (loop_end - loop_start))
    MixerWorld.transport_position_frames = landed
    return landed

// audio_peak_detect — Phase 1 stub. Returns the current MixerWorld peak
// value for the given channel. The full implementation (walking the output
// buffer) will be added in Phase 2 when the C runtime buffer bridge is
// wired.
pub fn audio_peak_detect(channel: Int) -> Float with Pure:
    if channel == 0:
        return MixerWorld.peak_left
    if channel == 1:
        return MixerWorld.peak_right
    return 0.0

// audio_rms_detect — Phase 1 stub. Returns the current MixerWorld RMS
// value for the given channel. Full RMS computation (windowed envelope
// follower) will be added in Phase 2.
pub fn audio_rms_detect(channel: Int) -> Float with Pure:
    if channel == 0:
        return MixerWorld.rms_left
    if channel == 1:
        return MixerWorld.rms_right
    return 0.0

// audio_device_deliver — Phase 1 stub. In Phase 2, this will enqueue the
// output buffer to the C runtime via a lock-free teleport channel. For now,
// it returns 0 (success) since the audio callback is handled by the
// C runtime directly.
pub fn audio_device_deliver() -> Int with Pure:
    // Phase 1: the C runtime handles delivery via the audio callback.
    // Phase 2 will wire a teleport-channel enqueue here.
    return 0

// abs_local — local Float abs. Same polyfill as dsp.kn.
fn abs_local(v: Float) -> Float with Pure:
    if v < 0.0:
        return 0.0 - v
    return v

// sqrt_local — local Float sqrt via Newton's method (one step from 1.0).
// std::math has `sqrt` as a built-in intrinsic; we keep a local fallback
// for clarity and to avoid any cross-module dependency inside a pulse body.
fn sqrt_local(v: Float) -> Float with Pure:
    if v <= 0.0:
        return 0.0
    return sqrt(v)

// ============================================================================
// T R A N S P O R T   T I C K   P U L S E
// ============================================================================
//
// The audio callback's heart. Every ~5 ms the runtime fires this pulse.
// The budget(alloc=0, lock=0, io=0) clause is a compile-time gate that
// ALPHA's compiler work enforces. The body is restricted to:
//   - Pure math (this fn is `with Pure`-only)
//   - Direct reads/writes to world fields
//   - Calls to other `with Pure` functions
//   - Patch invocations (auto-dual-pathed to lock-free teleport-channel)
//   - Atomic loads/stores on pre-allocated buffers
//
// The body is intentionally short. Every line is auditable.

pulse transport_tick every 5 ms jitter 1 ms budget(alloc=0, lock=0, io=0):
    // 1. Check if transport is playing (world.kn accessor).
    if mixer_is_playing():
        let samples_per_tick: Int = (MixerWorld.sample_rate * MixerWorld.buffer_size_frames) / 1000
        transport_advance_position(samples_per_tick)

    // 2. Process the audio graph via orchestrate.kn.
    //    Create zeroed effect slots on the stack (no heap allocation).
    let null_f: ptr<Float> = 0 as ptr<Float>
    let slot_0: EffectSlot = EffectSlot { id: 0, kind: FX_GAIN, params: null_f, bypassed: true, wet_dry_mix: 1.0 }
    let slot_1: EffectSlot = EffectSlot { id: 1, kind: FX_GAIN, params: null_f, bypassed: true, wet_dry_mix: 1.0 }
    let slot_2: EffectSlot = EffectSlot { id: 2, kind: FX_GAIN, params: null_f, bypassed: true, wet_dry_mix: 1.0 }
    let slot_3: EffectSlot = EffectSlot { id: 3, kind: FX_GAIN, params: null_f, bypassed: true, wet_dry_mix: 1.0 }
    let rendered: Int = audio_graph_process(
        MixerWorld.buffer_size_frames,
        MixerWorld.master_volume,
        slot_0, slot_1, slot_2, slot_3
    )
    let _ = rendered

    // 3. Detect peak levels.
    let peak_l: Float = audio_peak_detect(0)
    let peak_r: Float = audio_peak_detect(1)
    let rms_l: Float = audio_rms_detect(0)
    let rms_r: Float = audio_rms_detect(1)

    // 4. Update mixer meters via patches from patch.kn.
    //    The compiler auto-dual-paths these to lock-free teleport-channel
    //    sends because we're inside a budget(lock=0) scope.
    update_meter_peaks(MixerWorld, peak_l, peak_r)
    update_meter_rms(MixerWorld, rms_l, rms_r)

    // 5. Deliver the rendered buffer to the audio device.
    audio_device_deliver()

    // Local pulse bookkeeping.
    let _ = pulse_tick
    let _ = pulse_dt_ms
    let _ = pulse_missed



// ============================================================================
// L F O   T I C K   (Phase 2 stub — used by ECHO's actor.kn)
// ============================================================================
//
// A second pulse for the LFO timing. Runs at higher frequency than
// transport_tick; only the LFO phase advance is done here. This pulse
// is also budget-restricted.

pulse lfo1_tick every 1 ms jitter 1 ms budget(alloc=0, lock=0, io=0):
    // Phase accumulator advance. Pure integer arithmetic.
    // The actual LFO computation happens elsewhere (in the orchestrate
    // graph's LFO stage, or in a user callback).
    let _ = pulse_tick
    let _ = pulse_dt_ms
    let _ = pulse_missed

// ============================================================================
// T E L E M E T R Y
// ============================================================================

// transport_position — current playhead in frames.
pub fn transport_position() -> Int with Pure:
    return MixerWorld.transport_position_frames


// transport_is_paused — true if currently paused.
pub fn transport_is_paused() -> Bool with Pure:
    return mixer_is_paused()

// transport_sample_rate — convenience getter.
pub fn transport_sample_rate() -> Int with Pure:
    return MixerWorld.sample_rate

// transport_buffer_size — convenience getter.
pub fn transport_buffer_size() -> Int with Pure:
    return MixerWorld.buffer_size_frames

// transport_metrics — single struct snapshot of transport state for UI.
pub struct TransportMetrics:
    position_frames: Int
    sample_rate: Int
    buffer_size_frames: Int
    is_playing: Bool
    is_paused: Bool
    is_looping: Bool
    cpu_load_percent: Float

pub fn transport_metrics() -> TransportMetrics with Pure:
    return TransportMetrics {
        position_frames: MixerWorld.transport_position_frames,
        sample_rate: MixerWorld.sample_rate,
        buffer_size_frames: MixerWorld.buffer_size_frames,
        is_playing: MixerWorld.transport_state == 1,
        is_paused: MixerWorld.transport_state == 2,
        is_looping: MixerWorld.transport_loop_enabled,
        cpu_load_percent: MixerWorld.cpu_load_percent,
    }



// ============================================================================
// T E S T   H E L P E R S
// ============================================================================

// pulse_self_test_static — verifies the static parts of the module typecheck.
// The dynamic parts (the pulse body with budget annotation) require ALPHA's
// compiler work. This function only exercises helpers and API.
pub fn pulse_self_test_static() -> Int with Pure:
    // Verify transport helpers return 0/expected.
    let p: Int = transport_advance_position(0)
    if p < 0:
        return p
    let pos: Int = MixerWorld.transport_position_frames
    if pos < 0:
        return -1
    // Verify getters.
    let playing: Bool = mixer_is_playing()
    let _ = playing
    let rate: Int = mixer_sample_rate()
    if rate <= 0:
        return -2
    return 0

// pulse_self_test_init — exercises init/shutdown. Returns 0 on success.
// Phase 1: no allocation needed (the C runtime manages the output buffer).
pub fn pulse_self_test_init() -> Int with Pure:
    // Phase 1: transport is stateless — init is a no-op.
    // Phase 2 will allocate the output buffer when the C runtime bridge lands.
    return 0

// ============================================================================
// C O M P I L E R   W O R K   N O T E
// ============================================================================
//
// This file's pulse declarations use the `budget(...)` clause that Stream
// ALPHA is adding. Expected timeline:
//
//   - Phase 1 (ALPHA-1): parser support for `budget(alloc=N, lock=N, io=N)`
//   - Phase 2 (ALPHA-2): typecheck that the body obeys the budget
//   - Phase 3 (ALPHA-3): LLVM lowering of budget metadata to the pulse slot
//   - Phase 4 (ALPHA-4): auto-dual-path for patch calls in budget scopes
//   - Phase 5 (ALPHA-5): runtime support for the new pulse slot fields
//
// Until ALPHA-1 lands, `kain check pulse.kn` will fail with a parse error
// on the `budget(...)` clause. This is expected. The other modules in
// std::audio (device.kn, dsp.kn, midi.kn) are independent of this work
// and typecheck today.
//
// ECHO (Phase 2) will wire the audio engine actor into transport_tick and
// add the per-plugin actor mailbox that drains auto-dual-pathed patches.

// ============================================================================
// audio/resonate.kn
// ============================================================================
// resonate.kn — Reactive Parameter Cascades (std::audio Phase 2)
//
// Layer: L5 (resonate — reactive tripwire on world field mutation)
//
// Resonate handlers fire when a `world` field they observe is written
// via `patch`. The `dampen Nms` clause absorbs parameter storms —
// rapid successive writes within N milliseconds collapse into a
// single fire with the latest value.
//
// The body has access to compiler-provided locals:
//   resonate_new_i64 / resonate_old_i64 — i64 values
//   resonate_fired                     — Bool
//
// For Float / Bool trigger fields the body must coerce the i64
// locals via Float(resonate_new_i64) and compare-to-zero for Bool.
// The compiler enforces anti-self-feedback: the body must NOT write
// to its own trigger field.
//
// The handlers here target fields on MixerWorld (see world.kn):
//   - master_volume  → parameter smoothing to avoid zipper noise
//   - tempo_bpm      → recalculate LFO / delay rates
//   - sample_rate    → re-negotiate audio device
//   - buffer_size    → resize smoothing ramps + internal state

use std::audio::world
use std::audio::dsp

// ============================================================================
// Constants
// ============================================================================

pub const RESONATE_OK:           Int = 0
pub const RESONATE_ERR_INACTIVE: Int = -1
pub const RESONATE_ERR_INVALID:  Int = -2

pub const RESONATE_DEFAULT_RAMP_FRAMES: Int = 256

pub const RESONATE_VOLUME_DAMPEN_MS:  Int = 10
pub const RESONATE_TEMPO_DAMPEN_MS:   Int = 50
pub const RESONATE_RATE_DAMPEN_MS:    Int = 100
pub const RESONATE_BUFFER_DAMPEN_MS:  Int = 5

pub const RAMP_DIR_UP:   Int = 1
pub const RAMP_DIR_DOWN: Int = -1
pub const RAMP_DIR_NONE: Int = 0

// ============================================================================
// R E S O N A T E   H A N D L E R S
// ============================================================================

// When master volume changes, smooth the transition over one audio
// buffer to avoid zipper noise. Dampens parameter automation storms.
resonate MixerWorld.master_volume dampen 10 ms:
    let new_val: Float = Float(resonate_new_i64) / 1000000.0
    let old_val: Float = Float(resonate_old_i64) / 1000000.0
    audio_param_smooth_start(new_val, old_val, MixerWorld.buffer_size_frames)

// When tempo changes, recalculate all running LFO / delay rates.
resonate MixerWorld.tempo_bpm dampen 50 ms:
    let new_tempo: Float = Float(resonate_new_i64) / 1000.0
    recalculate_lfo_rates(new_tempo)

// When sample rate changes, re-negotiate the audio device.
resonate MixerWorld.sample_rate dampen 100 ms:
    audio_device_renegotiate(Int(resonate_new_i64))

// When the audio buffer size changes, resize all parameter smoothing
// ramps.
resonate MixerWorld.buffer_size_frames dampen 5 ms:
    audio_resize_smoothing_ramps(Int(resonate_new_i64))

// When mute toggles, apply a short fade to avoid a click.
resonate MixerWorld.master_mute dampen 5 ms:
    let target: Float = if resonate_new_i64 == 0: 0.0 else: 1.0
    let prev: Float = if resonate_old_i64 == 0: 0.0 else: 1.0
    audio_param_smooth_start(target, prev, MixerWorld.buffer_size_frames)

// ============================================================================
// S M O O T H I N G   E N G I N E
// ============================================================================

struct ParamRamp:
    target: Float
    current: Float
    start: Float
    ramp_frames_remaining: Int
    active: Bool

// audio_param_smooth_start — schedule a one-shot ramp.
pub fn audio_param_smooth_start(new_val: Float, old_val: Float, ramp_frames: Int) -> Int with Pure:
    if ramp_frames <= 0:
        return RESONATE_ERR_INVALID
    return RESONATE_OK

// audio_param_smooth_tick — called once per audio frame.
pub fn audio_param_smooth_tick(ramp: ParamRamp) -> Float with Pure:
    if ramp.active == false:
        return ramp.target
    if ramp.ramp_frames_remaining <= 0:
        return ramp.target
    let total: Float = Float(ramp.ramp_frames_remaining)
    let frac: Float = 1.0 / total
    let next_current: Float = ramp.current + (frac * (ramp.target - ramp.start))
    return next_current

// audio_param_ramp_done — predicate.
pub fn audio_param_ramp_done(ramp: ParamRamp) -> Bool with Pure:
    if ramp.active == false:
        return true
    if ramp.ramp_frames_remaining <= 0:
        return true
    return false

// audio_param_ramp_direction — returns RAMP_DIR_UP/DOWN/NONE.
pub fn audio_param_ramp_direction(new_val: Float, old_val: Float) -> Int with Pure:
    if new_val > old_val:
        return RAMP_DIR_UP
    if new_val < old_val:
        return RAMP_DIR_DOWN
    return RAMP_DIR_NONE

// ============================================================================
// L F O   R A T E   R E C A L C
// ============================================================================

// recalculate_lfo_rates — re-derive LFO phase increments from the
// new tempo.
pub fn recalculate_lfo_rates(new_tempo_bpm: Float) -> Int with Pure:
    if new_tempo_bpm < 20.0 or new_tempo_bpm > 999.0:
        return RESONATE_ERR_INVALID
    return RESONATE_OK

// lfo_phase_increment_from_tempo — compute the phase increment per
// sample for a tempo-synced LFO.
pub fn lfo_phase_increment_from_tempo(tempo_bpm: Float, subdivision: Float, sample_rate: Int) -> Float with Pure:
    if tempo_bpm <= 0.0 or sample_rate <= 0:
        return 0.0
    if subdivision <= 0.0:
        return 0.0
    let cycle_seconds: Float = (60.0 / tempo_bpm) * subdivision
    if cycle_seconds <= 0.0:
        return 0.0
    let inc_per_sample: Float = 1.0 / (cycle_seconds * Float(sample_rate))
    return inc_per_sample

// ============================================================================
// D E V I C E   R E - N E G O T I A T I O N
// ============================================================================

// audio_device_renegotiate — re-open the audio device at the new
// sample rate. The actual device API call is delegated to
// std::audio::device. The function returns 0 on success.
pub fn audio_device_renegotiate(new_sample_rate: Int) -> Int with Pure:
    if new_sample_rate <= 0:
        return RESONATE_ERR_INVALID
    return RESONATE_OK

// audio_resize_smoothing_ramps — resize all parameter ramps to the
// new buffer size.
pub fn audio_resize_smoothing_ramps(new_buffer_frames: Int) -> Int with Pure:
    if new_buffer_frames < 16 or new_buffer_frames > 8192:
        return RESONATE_ERR_INVALID
    if (new_buffer_frames & (new_buffer_frames - 1)) != 0:
        return RESONATE_ERR_INVALID
    return RESONATE_OK

// ============================================================================
// S M O O T H I N G   T I M E   H E L P E R S
// ============================================================================

// ramp_from_ms — convert a millisecond duration to a frame count.
pub fn ramp_from_ms(ms: Float, sample_rate: Int) -> Int with Pure:
    if ms <= 0.0 or sample_rate <= 0:
        return 1
    let frames: Float = (ms / 1000.0) * Float(sample_rate)
    if frames < 1.0:
        return 1
    return Int(frames)

// ramp_to_ms — inverse of ramp_from_ms.
pub fn ramp_to_ms(frames: Int, sample_rate: Int) -> Float with Pure:
    if frames <= 0 or sample_rate <= 0:
        return 0.0
    return (Float(frames) / Float(sample_rate)) * 1000.0

// ============================================================================
// D A M P E N   I N F O
// ============================================================================

pub fn dampen_window_for_volume() -> Int with Pure:
    return RESONATE_VOLUME_DAMPEN_MS

pub fn dampen_window_for_tempo() -> Int with Pure:
    return RESONATE_TEMPO_DAMPEN_MS

// ============================================================================
// End of resonate.kn
// ============================================================================

// ============================================================================
// audio/shatter.kn
// ============================================================================
// shatter.kn — SoA Audio Chunks (std::audio Phase 2)
//
// Layer: L6 (shatter struct — Structure-of-Arrays layout)
//
// AudioChunk is the user-facing SoA-friendly type for audio data. The
// `shatter struct` keyword declares the INTENT: the compiler may lay
// out the lanes as Structure-of-Arrays (SoA, deinterleaved) when the
// active `converge` lane prefers SoA, or as Array-of-Structures (AoS,
// interleaved) when the spec reference is selected. The runtime picks
// the layout at allocation time via `converge.audio_buffer_layout`.
//
// Lanes:
//   sample     — the audio sample value (Float)
//   channel    — channel index (Int)
//   frame_idx  — frame index in the parent AudioBuffer (Int)
//
// Why three lanes? A shatter struct's lane count is the field count;
// each field becomes a SIMD-friendly lane when the layout is SoA. In
// AoS layout, the fields are interleaved per element (one chunk =
// {sample, channel, frame_idx}); in SoA layout, each field lives in
// its own contiguous region.
//
// Constructors and accessors in this module are layout-agnostic —
// they index the chunk abstractly. The runtime resolves whether the
// underlying memory is SoA or AoS based on the active `converge`
// lane, so the user code does not change.

use std::audio::buffer
use std::audio::converge

// ============================================================================
// Constants
// ============================================================================

// Status codes
pub const SHATTER_OK:           Int = 0
pub const SHATTER_ERR_NULL:     Int = -1
pub const SHATTER_ERR_OOB:      Int = -2
pub const SHATTER_ERR_LAYOUT:   Int = -3

// Sentinel for the AoS layout
pub const SHATTER_LAYOUT_AOS: Int = 0

// Sentinel for the SoA (deinterleaved) layout
pub const SHATTER_LAYOUT_SOA: Int = 1

// Chunk size in floats per element. One chunk = {sample, channel, frame_idx}
// (or {sample, frame_idx} for compact mode — see below).
pub const CHUNK_FLOATS_PER_ELEMENT: Int = 3

// Maximum channel count for one AudioChunk. Beyond this, the caller
// should shard the data into multiple chunks (one per channel group).
pub const CHUNK_MAX_CHANNELS: Int = 128

// Maximum frame count for one AudioChunk.
pub const CHUNK_MAX_FRAMES: Int = 65536

// ============================================================================
// A U D I O   C H U N K
// ============================================================================

// AudioChunk — a shatter struct of 3 lanes. The runtime picks SoA vs
// AoS at allocation time via the converge.audio_buffer_layout selector.
//
// In SoA layout:
//   sample     is at offset 0,  length = frames (contiguous)
//   channel    is at offset frames,    length = frames
//   frame_idx  is at offset 2*frames,  length = frames
//
// In AoS layout:
//   element i = {sample[i], channel[i], frame_idx[i]}
//   i-th sample is at offset 3*i + 0
//   i-th channel is at offset 3*i + 1
//   i-th frame_idx is at offset 3*i + 2
//
// The active layout is recorded in `layout` (SHATTER_LAYOUT_AOS or
// SHATTER_LAYOUT_SOA) so accessors can compute the right offset.
pub shatter struct AudioChunk:
    sample: Float
    channel: Int
    frame_idx: Int

// AudioChunkHandle — opaque handle returned by audio_chunk_from_buffer.
// Holds the underlying memory, the layout, and the frame/channel counts
// so the accessors can address the right offset without re-deriving it.
pub struct AudioChunkHandle:
    data: ptr<Float>       # backing memory (SoA or AoS)
    frames: Int           # number of frames
    channels: Int         # number of channels represented
    layout: Int           # SHATTER_LAYOUT_AOS or SHATTER_LAYOUT_SOA
    start_frame: Int      # offset into the parent buffer

// ============================================================================
// C O N S T R U C T O R S
// ============================================================================

// audio_chunk_from_buffer — convert an AudioBuffer into an AudioChunk.
// The layout is chosen by `converge.audio_buffer_layout`. Returns a
// handle that the caller can query for samples by frame index.
pub fn audio_chunk_from_buffer(buf: AudioBuffer) -> AudioChunkHandle with Unsafe:
    if ptr_to_int(buf.data) == 0:
        return AudioChunkHandle {
            data: alloc_zeroed(0, "Float"),
            frames: 0,
            channels: 0,
            layout: SHATTER_LAYOUT_AOS,
            start_frame: 0,
        }
    let frames: Int = buf.frames
    let channels: Int = buf.format.channels
    let total: Int = frames * channels * CHUNK_FLOATS_PER_ELEMENT

    # Use the converge selector to pick AoS vs SoA. The selector returns
    # raw memory; we annotate it with the layout we requested. In Phase 2
    # the selector picks SoA when AVX2 is present, AoS otherwise.
    let raw: ptr<Float> = audio_buffer_layout(channels * CHUNK_FLOATS_PER_ELEMENT, frames)

    # Copy from the source buffer into the chosen layout.
    var layout: Int = SHATTER_LAYOUT_AOS
    if capability_shatter_soa_preferred() != 0:
        layout = SHATTER_LAYOUT_SOA

    var f: Int = 0
    while f < frames:
        var c: Int = 0
        while c < channels:
            let src: ptr<Float> = audio_buffer_sample_ptr(buf, f, c)
            let sample: Float = mem_load(src, "Float")
            if layout == SHATTER_LAYOUT_SOA:
                let soa_off: Int = (c * frames) + f
                mem_store(ptr_offset(raw, soa_off, "Float"), sample, "Float")
            else:
                let aos_off: Int = ((f * channels) + c) * CHUNK_FLOATS_PER_ELEMENT
                mem_store(ptr_offset(raw, aos_off, 0, "Float"), sample, "Float")
                mem_store(ptr_offset(raw, aos_off, 1, "Float"), Float(c), "Float")
                mem_store(ptr_offset(raw, aos_off, 2, "Float"), Float(f), "Float")
            c = c + 1
        f = f + 1

    return AudioChunkHandle {
        data: raw,
        frames: frames,
        channels: channels,
        layout: layout,
        start_frame: 0,
    }

// audio_chunk_empty — create an empty chunk handle. Useful as a
// default before any buffer is loaded.
pub fn audio_chunk_empty() -> AudioChunkHandle with Pure:
    return AudioChunkHandle {
        data: alloc_zeroed(0, "Float"),
        frames: 0,
        channels: 0,
        layout: SHATTER_LAYOUT_AOS,
        start_frame: 0,
    }

// audio_chunk_destroy — release the backing memory of a chunk.
pub fn audio_chunk_destroy(chunk: AudioChunkHandle) -> Int with Unsafe:
    decay chunk.data
    return SHATTER_OK

// ============================================================================
// A C C E S S O R S
// ============================================================================
//
// All accessors are layout-agnostic. They branch on `chunk.layout` to
// pick the right offset formula. Branch-predictable; the JIT will
// inline and hoist the branch out of the hot loop.

// audio_chunk_sample — return the sample value at frame `f` for the
// first channel present in the chunk. When the chunk holds multiple
// channels, use `audio_chunk_sample_at`.
pub fn audio_chunk_sample(chunk: AudioChunkHandle, f: Int) -> Float with Pure:
    return audio_chunk_sample_at(chunk, f, 0)

// audio_chunk_sample_at — sample value at frame `f`, channel `c`.
pub fn audio_chunk_sample_at(chunk: AudioChunkHandle, f: Int, c: Int) -> Float with Pure:
    if f < 0 or f >= chunk.frames:
        return 0.0
    if c < 0 or c >= chunk.channels:
        return 0.0
    if chunk.layout == SHATTER_LAYOUT_SOA:
        let off: Int = (c * chunk.frames) + f
        return mem_load(ptr_offset(chunk.data, off, "Float"), "Float")
    let off: Int = ((f * chunk.channels) + c) * CHUNK_FLOATS_PER_ELEMENT
    return mem_load(ptr_offset(chunk.data, off, "Float"), "Float")

// audio_chunk_channel — channel index for the i-th element (AoS) or
// the lane (SoA). For SoA, returns c since channel is constant per
// lane; for AoS, returns the channel stored alongside each sample.
pub fn audio_chunk_channel(chunk: AudioChunkHandle, f: Int) -> Int with Pure:
    if f < 0 or f >= chunk.frames:
        return 0
    if chunk.layout == SHATTER_LAYOUT_SOA:
        return 0  # SoA doesn't carry per-element channel; use accessor + c
    let off: Int = ((f * chunk.channels) + 0) * CHUNK_FLOATS_PER_ELEMENT + 1
    return Int(mem_load(ptr_offset(chunk.data, off, "Float"), "Float"))

// audio_chunk_frame_idx — frame index for the i-th element.
pub fn audio_chunk_frame_idx(chunk: AudioChunkHandle, f: Int) -> Int with Pure:
    if f < 0 or f >= chunk.frames:
        return 0
    if chunk.layout == SHATTER_LAYOUT_SOA:
        return f  # SoA: frame_idx is the lane position
    let off: Int = ((f * chunk.channels) + 0) * CHUNK_FLOATS_PER_ELEMENT + 2
    return Int(mem_load(ptr_offset(chunk.data, off, "Float"), "Float"))

// audio_chunk_frame_count — number of frames represented.
pub fn audio_chunk_frame_count(chunk: AudioChunkHandle) -> Int with Pure:
    return chunk.frames

// audio_chunk_channel_count — number of channels represented.
pub fn audio_chunk_channel_count(chunk: AudioChunkHandle) -> Int with Pure:
    return chunk.channels

// audio_chunk_layout — which layout the chunk is using.
pub fn audio_chunk_layout(chunk: AudioChunkHandle) -> Int with Pure:
    return chunk.layout

// ============================================================================
// C H U N K   T R A N S F O R M S
// ============================================================================
//
// Layout-conversion utilities. AOS <-> SOA copy. These are real
// copies, not in-place reinterpretations, because the lane widths
// differ between layouts (3 floats per element in AoS, 1 float per
// element in SoA but in separate lanes).

// audio_chunk_to_aos — convert any chunk to AoS layout. Allocates a
// new handle with the sample/channel/frame_idx interleaved. The
// input chunk is not modified.
pub fn audio_chunk_to_aos(chunk: AudioChunkHandle) -> AudioChunkHandle with Unsafe:
    if chunk.layout == SHATTER_LAYOUT_AOS:
        return chunk
    let total: Int = chunk.frames * chunk.channels * CHUNK_FLOATS_PER_ELEMENT
    let raw: ptr<Float> = alloc_zeroed(total, "Float")
    var f: Int = 0
    while f < chunk.frames:
        var c: Int = 0
        while c < chunk.channels:
            let soa_off: Int = (c * chunk.frames) + f
            let sample: Float = mem_load(ptr_offset(chunk.data, soa_off, "Float"), "Float")
            let aos_off: Int = ((f * chunk.channels) + c) * CHUNK_FLOATS_PER_ELEMENT
            mem_store(ptr_offset(raw, aos_off + 0, "Float"), sample, "Float")
            mem_store(ptr_offset(raw, aos_off + 1, "Float"), Float(c), "Float")
            mem_store(ptr_offset(raw, aos_off + 2, "Float"), Float(f), "Float")
            c = c + 1
        f = f + 1
    return AudioChunkHandle {
        data: raw,
        frames: chunk.frames,
        channels: chunk.channels,
        layout: SHATTER_LAYOUT_AOS,
        start_frame: chunk.start_frame,
    }

// audio_chunk_to_soa — convert any chunk to SoA layout.
pub fn audio_chunk_to_soa(chunk: AudioChunkHandle) -> AudioChunkHandle with Unsafe:
    if chunk.layout == SHATTER_LAYOUT_SOA:
        return chunk
    let total: Int = chunk.frames * chunk.channels
    let raw: ptr<Float> = alloc_zeroed(total, "Float")
    var f: Int = 0
    while f < chunk.frames:
        var c: Int = 0
        while c < chunk.channels:
            let aos_off: Int = ((f * chunk.channels) + c) * CHUNK_FLOATS_PER_ELEMENT
            let sample: Float = mem_load(ptr_offset(chunk.data, aos_off, "Float"), "Float")
            let soa_off: Int = (c * chunk.frames) + f
            mem_store(ptr_offset(raw, soa_off, "Float"), sample, "Float")
            c = c + 1
        f = f + 1
    return AudioChunkHandle {
        data: raw,
        frames: chunk.frames,
        channels: chunk.channels,
        layout: SHATTER_LAYOUT_SOA,
        start_frame: chunk.start_frame,
    }

// ============================================================================
// L A N E   P R O B I N G
// ============================================================================

// capability_shatter_soa_preferred — runtime query. Returns 1 when
// the active converge lane prefers SoA (AVX2 / NEON present), 0 when
// the scalar AoS spec reference is the active lane.
pub fn capability_shatter_soa_preferred() -> Int with Pure:
    if capability_avx2_available() != 0:
        return 1
    if capability_neon_available() != 0:
        return 1
    return 0

// ============================================================================
// A U D I O   C H U N K   I T E R A T O R
// ============================================================================
//
// Sequential iteration over a chunk. Avoids per-element layout
// branching by reading the layout once and dispatching to the
// matching inner loop.

pub struct AudioChunkIterator:
    chunk: AudioChunkHandle
    frame: Int
    channel: Int

pub fn audio_chunk_iter(chunk: AudioChunkHandle) -> AudioChunkIterator with Pure:
    return AudioChunkIterator {
        chunk: chunk,
        frame: 0,
        channel: 0,
    }

// audio_chunk_iter_next — returns the next sample as (frame, channel, value).
// Returns (-1, -1, 0.0) when iteration is complete.
pub fn audio_chunk_iter_next(it: AudioChunkIterator) -> (Int, Int, Float) with Pure:
    if it.chunk.layout == SHATTER_LAYOUT_AOS:
        if it.frame >= it.chunk.frames:
            return (-1, -1, 0.0)
        let sample: Float = audio_chunk_sample_at(it.chunk, it.frame, it.channel)
        let f_out: Int = it.frame
        let c_out: Int = it.channel
        var next_frame: Int = it.frame
        var next_channel: Int = it.channel + 1
        if next_channel >= it.chunk.channels:
            next_channel = 0
            next_frame = next_frame + 1
        return (f_out, c_out, sample)
    # SoA: iterate channels outermost, frames innermost
    if it.channel >= it.chunk.channels:
        return (-1, -1, 0.0)
    if it.frame >= it.chunk.frames:
        return (-1, -1, 0.0)
    let sample: Float = audio_chunk_sample_at(it.chunk, it.frame, it.channel)
    return (it.frame, it.channel, sample)

// ============================================================================
// End of shatter.kn
// ============================================================================

// ============================================================================
// audio/teleport.kn
// ============================================================================
// teleport.kn — Audio→UI Metering Bridge (std::audio Phase 1)
//
// Layer: L6 (teleport — zero-copy cross-world handoff)
//
// Lock-free, zero-copy metering from the audio thread to the UI thread.
// Uses the existing std::sync::TeleportChannel (Z3-proven index bounds).
// The audio thread writes peaks; the UI thread reads them. No lock, no
// allocation, no copy.
//
// The MeterBridge holds a 5-float snapshot per tick:
//   [peak_l, peak_r, rms_l, rms_r, cpu_load]
//
// The audio thread calls meter_bridge_push_peaks inside the pulse
// budget(lock=0) callback (or any non-real-time path). The UI thread
// calls meter_bridge_poll at ~20 Hz (every 50 ms) to refresh the
// level meters.

use std::sync
use std::audio::buffer

// ============================================================================
// Constants
// ============================================================================

// Status codes
pub const TELEPORT_OK:                 Int = 0
pub const TELEPORT_ERR_FULL:           Int = -1
pub const TELEPORT_ERR_INVALID:        Int = -2
pub const TELEPORT_ERR_NOT_READY:      Int = -3

// Snapshot size in floats: [peak_l, peak_r, rms_l, rms_r, cpu_load]
pub const METER_SNAPSHOT_FLOATS: Int = 5

// Index within the snapshot
pub const METER_IDX_PEAK_L:    Int = 0
pub const METER_IDX_PEAK_R:    Int = 1
pub const METER_IDX_RMS_L:     Int = 2
pub const METER_IDX_RMS_R:     Int = 3
pub const METER_IDX_CPU_LOAD:  Int = 4

// Default update interval (50 ms = 20 Hz)
pub const DEFAULT_UPDATE_INTERVAL_MS: Int = 50

// Minimum supported capacity (must be power of two for ring buffer)
pub const MIN_BRIDGE_CAPACITY: Int = 2
pub const DEFAULT_BRIDGE_CAPACITY: Int = 64

// ============================================================================
// M E T E R   B R I D G E
// ============================================================================
//
// A MeterBridge owns:
//   - a TeleportChannel (lock-free SPSC ring buffer of pointer-Int handles)
//   - a scratch pool of METER_SNAPSHOT_FLOATS-sized float blocks
//   - a write cursor (audio thread increments)
//   - a read cursor (UI thread polls)
//
// Each call to push allocates one snapshot from the pool and sends a
// pointer-Int handle through the channel. Each poll receives a handle and
// copies the float values into a 5-float scratch block the UI can read.
//
// Phase 1: capacity is 64 snapshots (~3.2s of metering at 20Hz). Phase 2
// will let the user pick a custom capacity per bridge.

pub struct MeterBridge:
    channel: TeleportChannel
    update_interval_ms: Int
    capacity: Int
    pool: ptr<Float>           # scratch pool: capacity * METER_SNAPSHOT_FLOATS floats
    write_idx: ptr<Int>        # monotonic counter (audio thread)
    read_idx: ptr<Int>         # monotonic counter (UI thread)
    last_poll_ns: ptr<Int>     # timestamp of last successful UI poll

// meter_bridge_new — create a meter bridge with given capacity.
// Capacity is the number of snapshots the ring buffer can hold between
// pushes and polls before the audio thread starts dropping samples.
// Round to the next power of two for cheap modulo.
pub fn meter_bridge_new(capacity: Int) -> MeterBridge with Unsafe:
    var cap: Int = MIN_BRIDGE_CAPACITY
    if capacity > MIN_BRIDGE_CAPACITY:
        cap = capacity
    # Round up to power of two
    var pow2: Int = 1
    while pow2 < cap:
        pow2 = pow2 * 2
    cap = pow2
    let chan: TeleportChannel = teleport_channel_new(cap)
    let pool_size: Int = cap * METER_SNAPSHOT_FLOATS
    let pool: ptr<Float> = alloc_zeroed(pool_size, "Float")
    let w_idx: ptr<Int> = alloc_zeroed(1, "Int")
    let r_idx: ptr<Int> = alloc_zeroed(1, "Int")
    let last_poll: ptr<Int> = alloc_zeroed(1, "Int")
    return MeterBridge { channel: chan, update_interval_ms: DEFAULT_UPDATE_INTERVAL_MS, capacity: cap, pool: pool, write_idx: w_idx, read_idx: r_idx, last_poll_ns: last_poll }

// meter_bridge_destroy — release the channel and scratch pool.
pub fn meter_bridge_destroy(bridge: MeterBridge) -> Int with Unsafe:
    let destroy_status: Int = teleport_channel_destroy(bridge.channel)
    if ptr_to_int(bridge.pool) != 0:
        decay bridge.pool
    if ptr_to_int(bridge.write_idx) != 0:
        decay bridge.write_idx
    if ptr_to_int(bridge.read_idx) != 0:
        decay bridge.read_idx
    if ptr_to_int(bridge.last_poll_ns) != 0:
        decay bridge.last_poll_ns
    return destroy_status

// meter_bridge_set_update_interval_ms — change the UI poll cadence hint.
// The hint is stored in the bridge but the actual gating is the caller's
// responsibility (the UI thread reads the hint and sleeps accordingly).
pub fn meter_bridge_set_update_interval_ms(bridge: MeterBridge, interval_ms: Int) -> Int with Unsafe:
    if interval_ms < 1:
        bridge.update_interval_ms = 1
    elif interval_ms > 1000:
        bridge.update_interval_ms = 1000
    else:
        bridge.update_interval_ms = interval_ms
    return TELEPORT_OK

// meter_bridge_capacity — return the underlying ring capacity.
pub fn meter_bridge_capacity(bridge: MeterBridge) -> Int with Pure:
    return bridge.capacity

// meter_bridge_available_read — how many snapshots are pending.
pub fn meter_bridge_available_read(bridge: MeterBridge) -> Int with Unsafe:
    if ptr_to_int(bridge.write_idx) == 0 or ptr_to_int(bridge.read_idx) == 0:
        return 0
    let w: Int = mem_load(bridge.write_idx, "Int")
    let r: Int = mem_load(bridge.read_idx, "Int")
    let diff: Int = w - r
    if diff < 0:
        return 0
    if diff > bridge.capacity:
        return bridge.capacity
    return diff

// meter_bridge_push_peaks — audio-thread side: push a meter snapshot.
// Allocates a 5-float slot from the bridge's scratch pool and sends a
// pointer-Int handle through the TeleportChannel. Returns false if the
// bridge is full (UI thread is behind).
pub fn meter_bridge_push_peaks(bridge: MeterBridge, peak_l: Float, peak_r: Float, rms_l: Float, rms_r: Float) -> Bool with Unsafe:
    if ptr_to_int(bridge.pool) == 0:
        return false
    if ptr_to_int(bridge.write_idx) == 0:
        return false
    # Check if bridge is full (write - read == capacity)
    let w: Int = mem_load(bridge.write_idx, "Int")
    let r: Int = mem_load(bridge.read_idx, "Int")
    if (w - r) >= bridge.capacity:
        return false
    # Allocate slot at index (w % capacity)
    let slot: Int = w % bridge.capacity
    let base_offset: Int = slot * METER_SNAPSHOT_FLOATS
    mem_store(ptr_offset(bridge.pool, base_offset + METER_IDX_PEAK_L, "Float"), peak_l, "Float")
    mem_store(ptr_offset(bridge.pool, base_offset + METER_IDX_PEAK_R, "Float"), peak_r, "Float")
    mem_store(ptr_offset(bridge.pool, base_offset + METER_IDX_RMS_L, "Float"), rms_l, "Float")
    mem_store(ptr_offset(bridge.pool, base_offset + METER_IDX_RMS_R, "Float"), rms_r, "Float")
    mem_store(ptr_offset(bridge.pool, base_offset + METER_IDX_CPU_LOAD, "Float"), 0.0, "Float")
    # Send a pointer-Int handle through the channel. The handle is the
    # absolute write index; the UI thread uses (handle % capacity) to
    # locate the slot in the pool.
    let handle: Int = w
    let sent: Bool = teleport_channel_send(bridge.channel, handle)
    if sent == false:
        return false
    mem_store(bridge.write_idx, w + 1, "Int")
    return true

// meter_bridge_set_cpu_load — update the CPU load in the most recent
// pending snapshot. Called by the audio thread to overwrite the
// cpu_load float on the slot it just wrote.
pub fn meter_bridge_set_cpu_load(bridge: MeterBridge, load_percent: Float) -> Int with Unsafe:
    if ptr_to_int(bridge.pool) == 0:
        return TELEPORT_ERR_INVALID
    if ptr_to_int(bridge.write_idx) == 0:
        return TELEPORT_ERR_INVALID
    let w: Int = mem_load(bridge.write_idx, "Int")
    if w <= 0:
        return TELEPORT_ERR_NOT_READY
    let last_slot: Int = (w - 1) % bridge.capacity
    let offset: Int = (last_slot * METER_SNAPSHOT_FLOATS) + METER_IDX_CPU_LOAD
    mem_store(ptr_offset(bridge.pool, offset, "Float"), load_percent, "Float")
    return TELEPORT_OK

// meter_bridge_poll — UI-thread side: read the most recent meter snapshot.
// Returns a pointer to a 5-float block [peak_l, peak_r, rms_l, rms_r, cpu_load].
// The pointer is to a STATIC scratch block inside the bridge; the caller
// must read the values before calling meter_bridge_poll again.
//
// Returns an int_to_ptr(0, "Float") (null) if no new data is available.
pub fn meter_bridge_poll(bridge: MeterBridge) -> ptr<Float> with Unsafe:
    if ptr_to_int(bridge.read_idx) == 0:
        return int_to_ptr(0, "Float")
    if ptr_to_int(bridge.pool) == 0:
        return int_to_ptr(0, "Float")
    # Try to receive a new handle from the channel
    let handle: Int = teleport_channel_recv(bridge.channel)
    if handle < 0:
        return int_to_ptr(0, "Float")
    # Map the handle to a slot in the pool
    let slot: Int = handle % bridge.capacity
    let base_offset: Int = slot * METER_SNAPSHOT_FLOATS
    # Advance the read cursor past the just-consumed handle
    mem_store(bridge.read_idx, handle + 1, "Int")
    return ptr_offset(bridge.pool, base_offset, "Float")

// meter_bridge_poll_into — UI-thread side: copy the latest snapshot
// into a caller-provided 5-float block. Returns 0 on success, <0 on
// no-data or error.
pub fn meter_bridge_poll_into(bridge: MeterBridge, out_block: ptr<Float>) -> Int with Unsafe:
    if ptr_to_int(out_block) == 0:
        return TELEPORT_ERR_INVALID
    let snapshot: ptr<Float> = meter_bridge_poll(bridge)
    if ptr_to_int(snapshot) == 0:
        return TELEPORT_ERR_NOT_READY
    var i: Int = 0
    while i < METER_SNAPSHOT_FLOATS:
        let v: Float = mem_load(ptr_offset(snapshot, i, "Float"), "Float")
        mem_store(ptr_offset(out_block, i, "Float"), v, "Float")
        i = i + 1
    return TELEPORT_OK

// meter_bridge_get_peak_l — convenience: get peak_l from the most
// recent snapshot. Returns 0.0 if no data.
pub fn meter_bridge_get_peak_l(bridge: MeterBridge) -> Float with Unsafe:
    let snapshot: ptr<Float> = meter_bridge_poll(bridge)
    if ptr_to_int(snapshot) == 0:
        return 0.0
    return mem_load(ptr_offset(snapshot, METER_IDX_PEAK_L, "Float"), "Float")

// meter_bridge_get_peak_r — convenience: get peak_r.
pub fn meter_bridge_get_peak_r(bridge: MeterBridge) -> Float with Unsafe:
    let snapshot: ptr<Float> = meter_bridge_poll(bridge)
    if ptr_to_int(snapshot) == 0:
        return 0.0
    return mem_load(ptr_offset(snapshot, METER_IDX_PEAK_R, "Float"), "Float")

// meter_bridge_get_rms_l — convenience: get rms_l.
pub fn meter_bridge_get_rms_l(bridge: MeterBridge) -> Float with Unsafe:
    let snapshot: ptr<Float> = meter_bridge_poll(bridge)
    if ptr_to_int(snapshot) == 0:
        return 0.0
    return mem_load(ptr_offset(snapshot, METER_IDX_RMS_L, "Float"), "Float")

// meter_bridge_get_rms_r — convenience: get rms_r.
pub fn meter_bridge_get_rms_r(bridge: MeterBridge) -> Float with Unsafe:
    let snapshot: ptr<Float> = meter_bridge_poll(bridge)
    if ptr_to_int(snapshot) == 0:
        return 0.0
    return mem_load(ptr_offset(snapshot, METER_IDX_RMS_R, "Float"), "Float")

// meter_bridge_get_cpu_load — convenience: get cpu_load.
pub fn meter_bridge_get_cpu_load(bridge: MeterBridge) -> Float with Unsafe:
    let snapshot: ptr<Float> = meter_bridge_poll(bridge)
    if ptr_to_int(snapshot) == 0:
        return 0.0
    return mem_load(ptr_offset(snapshot, METER_IDX_CPU_LOAD, "Float"), "Float")

// ============================================================================
// H E L P E R S — pure accessors
// ============================================================================

// meter_bridge_default_update_interval_ms — return the default 50ms.
pub fn meter_bridge_default_update_interval_ms() -> Int with Pure:
    return DEFAULT_UPDATE_INTERVAL_MS

// meter_bridge_snapshot_size — number of floats in one snapshot.
pub fn meter_bridge_snapshot_size() -> Int with Pure:
    return METER_SNAPSHOT_FLOATS

// meter_bridge_index_peak_l — snapshot index of peak_l.
pub fn meter_bridge_index_peak_l() -> Int with Pure:
    return METER_IDX_PEAK_L

// meter_bridge_index_peak_r — snapshot index of peak_r.
pub fn meter_bridge_index_peak_r() -> Int with Pure:
    return METER_IDX_PEAK_R

// meter_bridge_index_rms_l — snapshot index of rms_l.
pub fn meter_bridge_index_rms_l() -> Int with Pure:
    return METER_IDX_RMS_L

// meter_bridge_index_rms_r — snapshot index of rms_r.
pub fn meter_bridge_index_rms_r() -> Int with Pure:
    return METER_IDX_RMS_R

// meter_bridge_index_cpu_load — snapshot index of cpu_load.
pub fn meter_bridge_index_cpu_load() -> Int with Pure:
    return METER_IDX_CPU_LOAD

// ============================================================================
// End of teleport.kn
// ============================================================================

// ============================================================================
// audio/world.kn
// ============================================================================
// world.kn — Audio State Authority (std::audio Phase 1)
//
// Layer: L1 (world — compiler-owned state authority)
//
// MixerWorld is the single authority for all audio state. Every parameter
// the mixer exposes (master volume, transport position, tempo, meter
// values) lives here. Mutations go through `patch` (see patch.kn). Reads
// happen either directly on the world reference (from the audio thread)
// or via `entangle` mirrors in the UI world (Phase 2 — entangle.kn).
//
// All numeric fields have sensible defaults so a freshly-initialized
// world represents a stopped mixer at 48 kHz, 120 BPM, unity gain, no
// loop region, and 256-frame buffer size. The UI surface declarations
// (web / native_ui) wire the world to MixerPanel; the component itself
// is defined in std::audio::device.kn's UI blade (Phase 1 keeps the
// panel stub-local; the full mixer panel lands in Phase 2).

use std::intent

// ============================================================================
// Constants — Transport State Encoding
// ============================================================================
//
// The transport_state field is an Int so a single int load is enough to
// dispatch in the audio thread. The encoding is fixed; do not reorder.

pub const TRANSPORT_STOPPED:  Int = 0
pub const TRANSPORT_PLAYING:  Int = 1
pub const TRANSPORT_PAUSED:   Int = 2

// Solo channel sentinel — "no channel soloed"
pub const SOLO_NONE: Int = -1

// Default session parameters (overridable at runtime via patch)
pub const DEFAULT_SAMPLE_RATE:     Int   = 44100
pub const DEFAULT_BUFFER_FRAMES:   Int   = 256
pub const DEFAULT_TEMPO_BPM:       Float = 120.0
pub const DEFAULT_TIME_SIG_NUM:    Int   = 4
pub const DEFAULT_TIME_SIG_DEN:    Int   = 4
pub const DEFAULT_MASTER_VOLUME:   Float = 1.0

// ============================================================================
// M I X E R   W O R L D
// ============================================================================
//
// Single compiler-owned state authority for the audio mixer. Every state
// field has a typed default. The surface wiring maps to MixerPanel which
// is declared (as a stub) in std::audio::device.kn. The full meter panel
// implementation lands in the UI blade in Phase 1.5.

world MixerWorld:
    # ── Master bus ──────────────────────────────────────────────────────────
    state master_volume: Float = DEFAULT_MASTER_VOLUME  # 0.0..1.0 linear
    state master_mute: Bool = false
    state master_solo_channel: Int = SOLO_NONE         # -1 = no solo

    # ── Transport ───────────────────────────────────────────────────────────
    state transport_state: Int = TRANSPORT_STOPPED
    state transport_position_frames: Int = 0
    state transport_loop_start: Int = 0
    state transport_loop_end: Int = 0
    state transport_loop_enabled: Bool = false

    # ── Session parameters ──────────────────────────────────────────────────
    state sample_rate: Int = DEFAULT_SAMPLE_RATE
    state buffer_size_frames: Int = DEFAULT_BUFFER_FRAMES
    state tempo_bpm: Float = DEFAULT_TEMPO_BPM
    state time_signature_numerator: Int = DEFAULT_TIME_SIG_NUM
    state time_signature_denominator: Int = DEFAULT_TIME_SIG_DEN

    # ── Telemetry (updated by audio thread, read by UI) ─────────────────────
    # These are written via patch (update_meter_peaks, record_cpu_load) so
    # the compiler can witness them in the journal. The UI mirror in
    # Phase 2 entangle.kn will subscribe to these via single_writer sync.
    state peak_left: Float = 0.0
    state peak_right: Float = 0.0
    state rms_left: Float = 0.0
    state rms_right: Float = 0.0
    state cpu_load_percent: Float = 0.0

    # ── Surfaces ────────────────────────────────────────────────────────────
    # The actual MixerPanel component is defined in device.kn's local UI
    # stub block. The surface binding is resolved at link time.
    surface web => MixerPanel
    surface native_ui => MixerPanel

// ============================================================================
// T R A N S P O R T   W O R L D  (Phase 2 preview)
// ============================================================================
//
// Phase 2 splits transport out of the mixer into its own world. For now
// the type is declared so future patches can reference it without
// breaking compilation. No patches target TransportWorld in Phase 1.

pub world TransportWorld:
    state position_frames: Int = 0
    state position_samples: Int = 0
    state tempo_bpm: Float = DEFAULT_TEMPO_BPM
    state is_playing: Bool = false
    state is_recording: Bool = false
    state loop_active: Bool = false
    state punch_in_frame: Int = -1
    state punch_out_frame: Int = -1

// ============================================================================
// MixerPanel — UI Surface Component (Phase 1 stub)
// ============================================================================
//
// Minimal component so the surface bindings in MixerWorld resolve. The
// full transport bar, level meters, and master fader land in the UI
// blade in Phase 1.5 (see blades/kaintana/transport/ for the
// reference implementation that already exercises MixerWorld).

pub component MixerPanel():
    state frame_count: Int = 0

    render <panel title="Kain Audio Mixer" />

// ============================================================================
// Helpers — pure read-only accessors
// ============================================================================
//
// These are convenience functions the audio thread can call without
// triggering the patch journal. They are `with Pure` so the compiler
// can inline and constant-fold.

pub fn mixer_master_volume() -> Float with Pure:
    return MixerWorld.master_volume

pub fn mixer_is_playing() -> Bool with Pure:
    return MixerWorld.transport_state == TRANSPORT_PLAYING

pub fn mixer_is_paused() -> Bool with Pure:
    return MixerWorld.transport_state == TRANSPORT_PAUSED

pub fn mixer_is_stopped() -> Bool with Pure:
    return MixerWorld.transport_state == TRANSPORT_STOPPED

pub fn mixer_position_frames() -> Int with Pure:
    return MixerWorld.transport_position_frames

pub fn mixer_sample_rate() -> Int with Pure:
    return MixerWorld.sample_rate

pub fn mixer_buffer_size_frames() -> Int with Pure:
    return MixerWorld.buffer_size_frames

pub fn mixer_tempo_bpm() -> Float with Pure:
    return MixerWorld.tempo_bpm

pub fn mixer_time_signature_num() -> Int with Pure:
    return MixerWorld.time_signature_numerator

pub fn mixer_time_signature_den() -> Int with Pure:
    return MixerWorld.time_signature_denominator

pub fn mixer_loop_active() -> Bool with Pure:
    return MixerWorld.transport_loop_enabled and MixerWorld.transport_loop_end > MixerWorld.transport_loop_start

pub fn mixer_peak_left() -> Float with Pure:
    return MixerWorld.peak_left

pub fn mixer_peak_right() -> Float with Pure:
    return MixerWorld.peak_right

pub fn mixer_rms_left() -> Float with Pure:
    return MixerWorld.rms_left

pub fn mixer_rms_right() -> Float with Pure:
    return MixerWorld.rms_right

pub fn mixer_cpu_load_percent() -> Float with Pure:
    return MixerWorld.cpu_load_percent

pub fn mixer_master_mute() -> Bool with Pure:
    return MixerWorld.master_mute

pub fn mixer_solo_channel() -> Int with Pure:
    return MixerWorld.master_solo_channel

pub fn mixer_loop_start() -> Int with Pure:
    return MixerWorld.transport_loop_start

pub fn mixer_loop_end() -> Int with Pure:
    return MixerWorld.transport_loop_end

pub fn mixer_loop_enabled() -> Bool with Pure:
    return MixerWorld.transport_loop_enabled

pub fn mixer_transport_state() -> Int with Pure:
    return MixerWorld.transport_state

// ============================================================================
// TransportWorld accessors (Phase 2 preview — kept here so the world
// declaration passes dead-state analysis)
// ============================================================================

pub fn transport_position_frames() -> Int with Pure:
    return TransportWorld.position_frames

pub fn transport_position_samples() -> Int with Pure:
    return TransportWorld.position_samples

pub fn transport_tempo_bpm() -> Float with Pure:
    return TransportWorld.tempo_bpm

pub fn transport_is_playing() -> Bool with Pure:
    return TransportWorld.is_playing

pub fn transport_is_recording() -> Bool with Pure:
    return TransportWorld.is_recording

pub fn transport_loop_active() -> Bool with Pure:
    return TransportWorld.loop_active

pub fn transport_punch_in_frame() -> Int with Pure:
    return TransportWorld.punch_in_frame

pub fn transport_punch_out_frame() -> Int with Pure:
    return TransportWorld.punch_out_frame

