pub const GPU_QUEUE_PRESENT: Int = 8
pub const GPU_QUEUE_HOST: Int = 16
pub const GPU_QUEUE_ASYNC: Int = 32

pub const GPU_ACCESS_READ: Int = 1
pub const GPU_ACCESS_WRITE: Int = 2
pub const GPU_ACCESS_ATOMIC: Int = 4
pub const GPU_ACCESS_PERSISTENT_MAP: Int = 8
