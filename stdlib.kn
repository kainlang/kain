pub const GPU_STAGE_ALL_RAYTRACING: Int = GPU_STAGE_RAYGEN | GPU_STAGE_ANY_HIT | GPU_STAGE_CLOSEST_HIT | GPU_STAGE_MISS | GPU_STAGE_INTERSECTION | GPU_STAGE_CALLABLE
pub const GPU_STAGE_ALL: Int = GPU_STAGE_ALL_GRAPHICS | GPU_STAGE_COMPUTE | GPU_STAGE_ALL_RAYTRACING | GPU_STAGE_COPY | GPU_STAGE_RESOLVE

