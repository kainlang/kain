    if !json_has_key(object, key):
        return json_object_result_error(json_missing_key_status(key))
    let value = json_get_value(object, key)
    let actual_kind_code = json_value_kind_code(value)
    if actual_kind_code != JSON_KIND_CODE_OBJECT:
