// ============================================================================
// kaintana/widgets/ProgressBar.kn
// ============================================================================
// ============================================================================
//  widgets/ProgressBar.kn — Horizontal progress bar with track and fill
//  P2-014: value/max ratio determines fill portion. Stateless — pure function
//          of props. Themed fill colors with optional percentage text overlay.
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
// ============================================================================

use std::kaintana::core::KtSession
use std::kaintana::core::KtElementId
use std::kaintana::core::kt_row
use std::kaintana::core::kt_end_row
use std::kaintana::core::kt_fill
use std::kaintana::core::kt_width
use std::kaintana::core::kt_height
use std::kaintana::core::kt_radius
use std::kaintana::core::kt_text

// ── Widget trait (from Widget.kn) ────────────────────────────────────────
pub trait Widget:
    fn stable_key(_self: Self_) -> String:
        return ""
    fn kind(_self: Self_) -> String:
        return "widget"
    fn element_id(_self: Self_) -> Int:
        return -1
    fn tick_interaction(_self: Self_):
        return

// ============================================================================
//  Component: ProgressBar
// ============================================================================

/// Horizontal progress bar with background track and filled portion.
/// Stateless — pure function of value/max ratio. Displays themed fill
/// colors with optional percentage text overlay centered on the bar.
component ProgressBar(
    value:  Float = 0.0,
    max:    Float = 100.0,
    track_color: String = "#2E2E4A",
    fill_color:  String = "#21D4A1",
    width:  Float = 200.0,
    height: Float = 8.0,
    show_pct: Bool = false,
    key:    String = "progress",
):
    /// Compute fill ratio from value/max, clamped to [0, 1].
    fn fill_ratio(_self: Self_) -> Float:
        if _self.max <= 0.0:
            return 0.0
        let raw = _self.value / _self.max
        if raw < 0.0: return 0.0
        if raw > 1.0: return 1.0
        return raw

    /// Compute fill width as percentage of parent for the fill overlay.
    fn fill_width(_self: Self_) -> Float:
        return _self.fill_ratio() * 100.0

    render <box kind="progress" key={key} fill={track_color} width={width} height={height} radius={(height * 0.5)}>
        <box kind="progress-fill" fill={fill_color} width={fill_width()} height={height} radius={(height * 0.5)} />
    </box>

// ============================================================================
//  Widget trait implementation for ProgressBar
// ============================================================================

impl Widget for ProgressBar:
    fn stable_key(_self: Self_) -> String:
        return _self.key
    fn kind(_self: Self_) -> String:
        return "progress"
    fn element_id(_self: Self_) -> Int:
        return -1
    fn tick_interaction(_self: Self_):
        return

// ============================================================================
// kaintana/widgets/ScrollView.kn
// ============================================================================
// ============================================================================
//  widgets/ScrollView.kn — Scrollable container with inertia physics
//  P2-017: Pulse-driven momentum scroll with friction, rubber-band overscroll
//          damping, and optional scrollbar indicators. Axis selection (vertical
//          / horizontal / both). Stateful — maintains scroll position, velocity,
//          and content dimensions across frames.
//
//  Physics model:
//    - Friction: velocity *= 0.92^(dt*60) per frame — frame-rate independent
//    - Rubber-band: ratio/(1+ratio) * viewport for overscroll damping
//    - Settle: stops updating when velocity < SV_EPSILON
//
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
// ============================================================================

use std::kaintana::core::KtSession
use std::kaintana::core::KtElementId
use std::kaintana::core::kt_row
use std::kaintana::core::kt_end_row
use std::kaintana::core::kt_fill
use std::kaintana::core::kt_width
use std::kaintana::core::kt_height
use std::kaintana::core::kt_radius
use std::kaintana::core::kt_opacity
use std::kaintana::core::kt_direction
use std::kaintana::core::kt_pad
use std::kaintana::core::kt_gap

// ── Widget trait (from Widget.kn) ────────────────────────────────────────
pub trait Widget:
    fn stable_key(_self: Self_) -> String:
        return ""
    fn kind(_self: Self_) -> String:
        return "widget"
    fn element_id(_self: Self_) -> Int:
        return -1
    fn tick_interaction(_self: Self_):
        return

// ── Pure helper functions (not component methods) ─────────────────────────
//  These take raw Float/String values and compute physics/layout.

/// Absolute value for Float.
fn abs_f(v: Float) -> Float:
    if v < 0.0: return -v
    return v

/// Frame-rate independent friction factor: 0.92^(dt*60).
/// Computed via iterated multiply since Kain lacks pow().
fn friction_for_dt(dt_ms: Float) -> Float:
    var f: Float = 1.0
    var rem: Float = dt_ms
    while rem > 0.0:
        f = f * 0.92
        rem = rem - 16.0
    return f

/// Rubber-band overscroll damping: ratio/(1+ratio) * viewport.
/// Maps infinite overscroll to [0, viewport) via asymptotic clamping.
pub fn rubber_band(overscroll: Float, viewport: Float) -> Float:
    if overscroll <= 0.0:
        return overscroll
    let ratio = overscroll / viewport
    let clamped = ratio / (1.0 + ratio)
    return clamped * viewport

/// Minimum of two Float values.
fn min_f(a: Float, b: Float) -> Float:
    if a < b: return a
    return b

/// Maximum of two Float values.
fn max_f(a: Float, b: Float) -> Float:
    if a > b: return a
    return b

/// Clamp value to [lo, hi].
fn clamp_f(v: Float, lo: Float, hi: Float) -> Float:
    var r = v
    if r < lo: r = lo
    if r > hi: r = hi
    return r

// ── ScrollView constants ────────────────────────────────────────────────

/// Clamp threshold for settle detection.
pub const SV_EPSILON: Float = 0.5

/// Scrollbar track color (semi-transparent white overlay).
pub const SV_BAR_COLOR:  String = "#FFFFFF33"

/// Scrollbar active/hover color.
pub const SV_BAR_ACTIVE: String = "#FFFFFF66"

/// Scrollbar thickness in logical points.
pub const SV_BAR_WIDTH:  Float = 6.0

/// Scrollbar corner radius.
pub const SV_BAR_RADIUS: Float = 3.0

/// Minimum scrollbar length in logical points.
pub const SV_BAR_MIN:    Float = 20.0

// ============================================================================
//  Component: ScrollView
// ============================================================================

/// Scrollable container with inertia physics.
///
/// Manages scroll position and velocity via pulse-driven physics.
/// Supports vertical and/or horizontal scrolling with rubber-band
/// overscroll and optional scrollbar indicators. The content offset
/// and clip region are handled by the C substrate when it processes
/// the "scrollview" element kind.
///
/// Physics pulse runs every 16ms:
///   1. Apply friction to velocity
///   2. Update scroll position from velocity
///   3. Rubber-band at scroll boundaries
///   4. Settle when velocity drops below threshold
component ScrollView(
    axis:           String = "vertical",
    show_indicator: Bool = true,
    width:          Float = 200.0,
    height:         Float = 300.0,
    key:            String = "scroll",
):
    // ── Scroll position state ─────────────────────────────────────────
    state scroll_x: Float = 0.0
    state scroll_y: Float = 0.0

    // ── Inertia velocity state ────────────────────────────────────────
    state velocity_x: Float = 0.0
    state velocity_y: Float = 0.0

    // ── Content dimensions (updated when children are measured) ───────
    state content_width:  Float = 600.0
    state content_height: Float = 900.0

    // ── Scroll physics helpers ────────────────────────────────────────

    /// Check if horizontal scrolling is allowed.
    fn can_scroll_x(_self: Self_) -> Bool:
        return _self.axis == "horizontal" or _self.axis == "both"

    /// Check if vertical scrolling is allowed.
    fn can_scroll_y(_self: Self_) -> Bool:
        return _self.axis == "vertical" or _self.axis == "both"

    /// Maximum scroll position in x (clamped to 0 if content ≤ viewport).
    fn max_scroll_x(_self: Self_) -> Float:
        return max_f(_self.content_width - _self.width, 0.0)

    /// Maximum scroll position in y (clamped to 0 if content ≤ viewport).
    fn max_scroll_y(_self: Self_) -> Float:
        return max_f(_self.content_height - _self.height, 0.0)

    /// Apply rubber-band to overscrolled position, x-axis.
    fn clamp_scroll_x(_self: Self_) -> Float:
        var sx = _self.scroll_x
        if sx < 0.0:
            let damped = rubber_band(-sx, _self.width)
            sx = -damped
        let max_sx = _self.max_scroll_x()
        if sx > max_sx:
            let overscroll = sx - max_sx
            sx = max_sx + rubber_band(overscroll, _self.width)
        return sx

    /// Apply rubber-band to overscrolled position, y-axis.
    fn clamp_scroll_y(_self: Self_) -> Float:
        var sy = _self.scroll_y
        if sy < 0.0:
            let damped = rubber_band(-sy, _self.height)
            sy = -damped
        let max_sy = _self.max_scroll_y()
        if sy > max_sy:
            let overscroll = sy - max_sy
            sy = max_sy + rubber_band(overscroll, _self.height)
        return sy

    /// Vertical scrollbar height in logical points.
    fn scrollbar_v_height(_self: Self_) -> Float:
        if _self.content_height <= 0.0:
            return _self.height
        let ratio = _self.height / _self.content_height
        let raw = ratio * _self.height
        return max_f(raw, SV_BAR_MIN)

    /// Vertical scrollbar opacity: 1.0 when visible, 0.0 when hidden.
    fn scrollbar_v_opacity(_self: Self_) -> Float:
        if _self.show_indicator == false:
            return 0.0
        if _self.axis == "horizontal":
            return 0.0
        return 1.0

    /// Horizontal scrollbar width in logical points.
    fn scrollbar_h_width(_self: Self_) -> Float:
        if _self.content_width <= 0.0:
            return _self.width
        let ratio = _self.width / _self.content_width
        let raw = ratio * _self.width
        return max_f(raw, SV_BAR_MIN)

    /// Horizontal scrollbar opacity: 1.0 when visible, 0.0 when hidden.
    fn scrollbar_h_opacity(_self: Self_) -> Float:
        if _self.show_indicator == false:
            return 0.0
        if _self.axis == "vertical":
            return 0.0
        return 1.0

    // ── Inertia scroll physics pulse ──────────────────────────────────

    /// Pulse-driven scroll physics: apply friction, update position,
    /// rubber-band at boundaries, settle when velocity is negligible.
    pulse scroll_physics every 16ms jitter 2ms:
        let dt = pulse_dt_ms

        // Compute frame-rate-independent friction factor
        let ff = friction_for_dt(dt)

        // Apply friction to velocity
        if can_scroll_x(self):
            velocity_x = velocity_x * ff
        else:
            velocity_x = 0.0

        if can_scroll_y(self):
            velocity_y = velocity_y * ff
        else:
            velocity_y = 0.0

        // Update scroll position from velocity
        // Velocity is in "pixels per 60fps frame" units
        let dt_norm = dt / 16.0
        scroll_x = scroll_x + velocity_x * dt_norm
        scroll_y = scroll_y + velocity_y * dt_norm

        // Apply rubber-band overscroll clamping
        scroll_x = clamp_scroll_x(self)
        scroll_y = clamp_scroll_y(self)

        // Settle detection: stop when velocity is negligible
        if abs_f(velocity_x) < SV_EPSILON and abs_f(velocity_y) < SV_EPSILON:
            velocity_x = 0.0
            velocity_y = 0.0

    // ── Render ────────────────────────────────────────────────────────

    render <box kind="scrollview" key={key} width={width} height={height}>
        <box key="scrollbar-v" fill={SV_BAR_COLOR} width={SV_BAR_WIDTH} height={scrollbar_v_height()} radius={SV_BAR_RADIUS} opacity={scrollbar_v_opacity()} />
        <box key="scrollbar-h" fill={SV_BAR_COLOR} height={SV_BAR_WIDTH} width={scrollbar_h_width()} radius={SV_BAR_RADIUS} opacity={scrollbar_h_opacity()} />
    </box>

// ============================================================================
//  Widget trait implementation for ScrollView
// ============================================================================

impl Widget for ScrollView:
    fn stable_key(_self: Self_) -> String:
        return _self.key
    fn kind(_self: Self_) -> String:
        return "scrollview"
    fn element_id(_self: Self_) -> Int:
        return -1
    fn tick_interaction(_self: Self_):
        return

// ============================================================================
// kaintana/widgets/Spinner.kn
// ============================================================================
// ============================================================================
//  widgets/Spinner.kn — Animated loading spinner with rotating arc segments
//  P2-015: Pulse-driven angle animation. 8 segments arranged in a circular
//          pattern with varying opacity to simulate rotation. Speed multiplier
//          prop. Themed accent color with color override support.
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
// ============================================================================

use std::kaintana::core::KtSession
use std::kaintana::core::KtElementId
use std::kaintana::core::kt_row
use std::kaintana::core::kt_end_row
use std::kaintana::core::kt_fill
use std::kaintana::core::kt_width
use std::kaintana::core::kt_height
use std::kaintana::core::kt_radius
use std::kaintana::core::kt_opacity
use std::kaintana::core::kt_direction
use std::kaintana::core::kt_gap
use std::kaintana::core::kt_pad

// ── Widget trait (from Widget.kn) ────────────────────────────────────────
pub trait Widget:
    fn stable_key(_self: Self_) -> String:
        return ""
    fn kind(_self: Self_) -> String:
        return "widget"
    fn element_id(_self: Self_) -> Int:
        return -1
    fn tick_interaction(_self: Self_):
        return

// ── Pure helper functions (not component methods) ─────────────────────────
//  These take raw Float values and compute geometry/opacity for spinner
//  segments. Called from JSX expressions in the render block.

/// Compute opacity for a spinner segment given current rotation angle
/// and the segment's base angle (degrees). Returns [0.15, 1.0].
fn seg_opacity_at(angle: Float, base: Float) -> Float:
    let diff = angle - base
    let abs_diff = if diff < 0.0: -diff else: diff
    let wrapped = if abs_diff > 180.0: 360.0 - abs_diff else: abs_diff
    let opacity = 1.0 - wrapped / 180.0
    if opacity < 0.15: return 0.15
    return opacity

/// Compute segment square dimension from spinner size.
fn seg_dim_from(spinner_size: Float) -> Float:
    return spinner_size * 0.22

/// Compute segment corner radius from spinner size.
fn seg_radius_from(spinner_size: Float) -> Float:
    return seg_dim_from(spinner_size) * 0.25

// ============================================================================
//  Component: Spinner
// ============================================================================

/// Animated loading spinner with pulse-driven rotation.
/// Renders 8 arc segments arranged in a circular 3x3 pattern (center empty).
/// Segment opacity modulates with _angle to create the illusion of a
/// rotating arc. The speed prop scales the rotation rate.
component Spinner(
    size:  Float = 24.0,
    color: String = "#21D4A1",
    speed: Float = 1.0,
    key:   String = "spinner",
):
    state _angle: Float = 0.0

    /// Advance the rotation angle each tick. Wraps at 360 degrees.
    /// Speed multiplier: angle increment = 6.0 * speed per tick (~375 deg/s at 1x).
    pulse rotate every 16ms jitter 2ms:
        _angle = (_angle + 6.0 * speed) % 360.0

    render <box kind="spinner" key={key} width={size} height={size}>
        <box direction={0} gap={0} pad={0}>
            <box fill={color} width={seg_dim_from(size)} height={seg_dim_from(size)} radius={seg_radius_from(size)} opacity={seg_opacity_at(_angle,   0.0)} />
            <box fill={color} width={seg_dim_from(size)} height={seg_dim_from(size)} radius={seg_radius_from(size)} opacity={seg_opacity_at(_angle,  45.0)} />
            <box fill={color} width={seg_dim_from(size)} height={seg_dim_from(size)} radius={seg_radius_from(size)} opacity={seg_opacity_at(_angle,  90.0)} />
        </box>
        <box direction={0} gap={0} pad={0}>
            <box fill={color} width={seg_dim_from(size)} height={seg_dim_from(size)} radius={seg_radius_from(size)} opacity={seg_opacity_at(_angle, 315.0)} />
            <box fill={color} width={seg_dim_from(size)} height={seg_dim_from(size)} radius={seg_radius_from(size)} opacity={seg_opacity_at(_angle, 135.0)} />
        </box>
        <box direction={0} gap={0} pad={0}>
            <box fill={color} width={seg_dim_from(size)} height={seg_dim_from(size)} radius={seg_radius_from(size)} opacity={seg_opacity_at(_angle, 270.0)} />
            <box fill={color} width={seg_dim_from(size)} height={seg_dim_from(size)} radius={seg_radius_from(size)} opacity={seg_opacity_at(_angle, 225.0)} />
            <box fill={color} width={seg_dim_from(size)} height={seg_dim_from(size)} radius={seg_radius_from(size)} opacity={seg_opacity_at(_angle, 180.0)} />
        </box>
    </box>

// ============================================================================
//  Widget trait implementation for Spinner
// ============================================================================

impl Widget for Spinner:
    fn stable_key(_self: Self_) -> String:
        return _self.key
    fn kind(_self: Self_) -> String:
        return "spinner"
    fn element_id(_self: Self_) -> Int:
        return -1
    fn tick_interaction(_self: Self_):
        return

// ============================================================================
// kaintana/widgets/TextInput.kn
// ============================================================================
// ============================================================================
//  widgets/TextInput.kn — Single-line text input with cursor, placeholder,
//                          focus state, and password mode
//  P2-012: Focus state tracked via _focused component state. Cursor position
//          tracked via component _cursor_pos state. Password mode masks
//          displayed characters with "•". Placeholder text shows when _text
//          empty AND not focused. Cursor blink driven by pulse animate block
//          (500ms cycle). on_change fires on each character input, on_submit
//          fires on Enter key.
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
// ============================================================================

use std::kaintana::core::KtSession
use std::kaintana::core::KtElementId
use std::kaintana::core::kt_row
use std::kaintana::core::kt_end_row
use std::kaintana::core::kt_text
use std::kaintana::core::kt_hovered
use std::kaintana::core::kt_clicked
use std::kaintana::core::kt_active
use std::kaintana::core::kt_fill
use std::kaintana::core::kt_width
use std::kaintana::core::kt_height
use std::kaintana::core::kt_radius
use std::kaintana::core::kt_stroke
use std::kaintana::core::kt_opacity
use std::kaintana::core::kt_font
use std::kaintana::core::kt_pad
use std::kaintana::core::kt_gap

// ── Widget trait (from Widget.kn) ─────────────────────────────────────────────
pub trait Widget:
    fn stable_key(_self: Self_) -> String:
        return ""
    fn kind(_self: Self_) -> String:
        return "widget"
    fn element_id(_self: Self_) -> Int:
        return -1
    fn tick_interaction(_self: Self_):
        return

// ============================================================================
//  Component: TextInput
// ============================================================================

/// Single-line text input with cursor, placeholder text, focus handling,
/// password masking, and on_change/on_submit callbacks.
///
/// Props:
///   value       — initial text value (String)
///   placeholder — placeholder text shown when empty and not focused (String)
///   theme       — accent color hex string for focused border (defaults to "#21D4A1")
///   password    — if true, masks displayed characters with "•" (Bool)
///   width       — element width in logical points (default 200.0)
///   on_change   — callback fired on each character input with new text (optional)
///   on_submit   — callback fired on Enter key with current text (optional)
///   key         — stable key for element reconciliation
///
/// State:
///   _focused       — whether the input has keyboard focus
///   _text          — current text content
///   _cursor_pos    — cursor position index within _text
///   _cursor_visible — whether the cursor is currently blinking visible
///   _elem          — element ID of the root box for interaction queries
///
/// Pulse:
///   blink — toggles _cursor_visible every 500ms when focused
///
/// Interaction:
///   Click to focus. Click outside to blur (requires parent to manage).
///   Keyboard input appends characters when focused.
///   Backspace removes character before cursor.
///   Enter fires on_submit.
component TextInput(
    value:       String = "",
    placeholder: String = "",
    theme:       String = "",
    password:    Bool = false,
    width:       Float = 200.0,
    on_change = none,
    on_submit = none,
    key:         String = "input",
):
    state _focused:        Bool = false
    state _text:           String = value
    state _cursor_pos:     Int = len(value)
    state _cursor_visible: Bool = false
    state _elem:           Int = -1

    /// Resolve fill color: input focus bg when focused, input bg when default.
    fn input_fill(_self: Self_) -> String:
        if _self._focused:
            return "#1A1A28"
        return "#141420"

    /// Resolve border stroke color: accent when focused, border when default.
    fn input_stroke(_self: Self_) -> String:
        if _self._focused:
            if _self.theme != "":
                return _self.theme
            return "#21D4A1"
        return "#2E2E4A"

    /// Resolve font size. Fixed at 14px body text.
    fn input_font_size(_self: Self_) -> Float:
        return 14.0

    /// Compute display text: masked if password, raw if not.
    fn display_text(_self: Self_) -> String:
        if _self._text == "":
            return ""
        if _self.password:
            var masked: String = ""
            var i: Int = 0
            while i < len(_self._text):
                masked = masked + "•"
                i = i + 1
            return masked
        return _self._text

    /// Resolve visible text: placeholder when empty+unfocused, text otherwise.
    fn visible_text(_self: Self_) -> String:
        if _self._text == "" and _self._focused == false:
            return _self.placeholder
        return _self.display_text()

    /// Resolve text color: placeholder dim when showing placeholder, normal text otherwise.
    fn text_color(_self: Self_) -> String:
        if _self._text == "" and _self._focused == false:
            return "#6B6B80"
        return "#F1F1F6"

    /// Build cursor text: a vertical bar "|" shown when focused and cursor is visible.
    fn cursor_text(_self: Self_) -> String:
        if _self._focused == false:
            return ""
        if _self._cursor_visible == false:
            return ""
        return "|"

    /// Handle character input: append character to _text, advance cursor, fire on_change.
    fn handle_char(_self: Self_, ch: String):
        _self._text = _self._text + ch
        _self._cursor_pos = len(_self._text)
        if _self.on_change != none:
            _self.on_change(_self._text)

    /// Handle backspace: remove last character from _text, adjust cursor, fire on_change.
    fn handle_backspace(_self: Self_):
        if _self._text == "":
            return
        let n = len(_self._text)
        var new_text: String = ""
        var i: Int = 0
        while i < n - 1:
            new_text = new_text + chr(byte_at(_self._text, i))
            i = i + 1
        _self._text = new_text
        _self._cursor_pos = len(_self._text)
        if _self.on_change != none:
            _self.on_change(_self._text)

    /// Process interaction: handle click to focus, keyboard input when focused.
    fn process_interaction(_self: Self_, s: KtSession):
        if _self._elem < 0:
            return
        let clk = kt_clicked(s, _self._elem)
        if clk != 0:
            _self._focused = true

    // ── Cursor blink pulse ──────────────────────────────────
    pulse blink every 500ms:
        if _focused:
            _cursor_visible = _cursor_visible == false

    render <box kind="textinput" key={key} width={width} height={32} fill={input_fill} stroke={input_stroke} stroke_width={1} radius={4} pad={8} gap={4} direction={0}>
        <text value={visible_text} color={text_color} font_size={input_font_size} />
        <text value={cursor_text} color="#F1F1F6" font_size={input_font_size} />
    </box>

// ============================================================================
//  Widget trait implementation for TextInput
// ============================================================================

impl Widget for TextInput:
    fn stable_key(_self: Self_) -> String:
        return _self.key
    fn kind(_self: Self_) -> String:
        return "textinput"
    fn element_id(_self: Self_) -> Int:
        return _self._elem
    fn tick_interaction(_self: Self_):
        return

// ⚠ NOTE: Keyboard input handling (character insertion, backspace, Enter) is
//   partially implemented via handle_char/handle_backspace methods. Full keyboard
//   event dispatch requires the C substrate's key event queue to be wired into
//   the component interaction pipeline via kt_input_key_down/kt_input_text.
//   When the input system delivers key events to focused components, call
//   handle_char() for printable characters and handle_backspace() for backspace.
//   For Enter: fire on_submit(current_text).
//   For left/right arrows: adjust _cursor_pos within [0, len(_text)].

// ============================================================================
// kaintana/widgets/Toggle.kn
// ============================================================================
// ============================================================================
//  widgets/Toggle.kn — Capsule-shaped toggle switch with animated thumb
//  P2-013: Capsule shape = full corner radius (theme.radius_full ~ 999).
//          Track fill: on = accent, off = border. Thumb animated via pulse
//          spring physics toward target (1.0 or 0.0). Thumb x-position =
//          lerp(2, track_width - thumb_size - 2, _anim_progress).
//          on_toggle fires after each toggle.
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
// ============================================================================

use std::kaintana::core::KtSession
use std::kaintana::core::KtElementId
use std::kaintana::core::kt_row
use std::kaintana::core::kt_end_row
use std::kaintana::core::kt_text
use std::kaintana::core::kt_hovered
use std::kaintana::core::kt_clicked
use std::kaintana::core::kt_active
use std::kaintana::core::kt_fill
use std::kaintana::core::kt_width
use std::kaintana::core::kt_height
use std::kaintana::core::kt_radius
use std::kaintana::core::kt_stroke
use std::kaintana::core::kt_opacity
use std::kaintana::core::kt_gap

// ── Constants ────────────────────────────────────────────────────────────────
// Track capsule dimensions
const TOGGLE_WIDTH:  Float = 44.0
const TOGGLE_HEIGHT: Float = 24.0
const THUMB_SIZE:    Float = 20.0
const THUMB_MARGIN:  Float = 2.0   // padding from track edge to thumb

// ── Widget trait (from Widget.kn) ─────────────────────────────────────────────
pub trait Widget:
    fn stable_key(_self: Self_) -> String:
        return ""
    fn kind(_self: Self_) -> String:
        return "widget"
    fn element_id(_self: Self_) -> Int:
        return -1
    fn tick_interaction(_self: Self_):
        return

// ============================================================================
//  Component: Toggle
// ============================================================================

/// Capsule-shaped toggle switch with animated thumb circle.
///
/// Props:
///   checked   — initial checked state (Bool)
///   theme     — accent color hex string for on state (defaults to "#21D4A1")
///   disabled  — if true, interaction is disabled (Bool)
///   on_toggle — callback fired on click with new checked value (optional)
///   key       — stable key for element reconciliation
///
/// State:
///   _checked       — current checked state, toggled on click
///   _anim_progress — 0.0 (off) to 1.0 (on), driven by pulse spring animation
///
/// Pulse:
///   animate — spring toward target (1.0 if checked, 0.0 if unchecked)
///             Uses lerp-based smoothing: _anim_progress += diff * 0.25
component Toggle(
    checked:   Bool = false,
    theme:     String = "",
    disabled:  Bool = false,
    on_toggle  = none,
    key:       String = "toggle",
):
    state _checked:       Bool = checked
    state _anim_progress: Float = if checked: 1.0 else: 0.0
    state _elem:          Int = -1

    /// Resolve track fill color: accent when checked (or custom theme), border when unchecked.
    fn track_fill(_self: Self_) -> String:
        if _self.disabled:
            return "#1A1A28"
        if _self._checked:
            if _self.theme != "":
                return _self.theme
            return "#21D4A1"
        return "#2E2E4A"

    /// Compute thumb horizontal offset: lerp between left and right positions.
    /// Left  = THUMB_MARGIN (2px)
    /// Right = TOGGLE_WIDTH - THUMB_SIZE - THUMB_MARGIN (44 - 20 - 2 = 22px)
    fn thumb_offset(_self: Self_) -> Float:
        let left  = THUMB_MARGIN
        let right = TOGGLE_WIDTH - THUMB_SIZE - THUMB_MARGIN
        return left + (right - left) * _self._anim_progress

    /// Compute opacity: full opacity when enabled, 0.5 when disabled.
    fn widget_opacity(_self: Self_) -> Float:
        if _self.disabled:
            return 0.5
        return 1.0

    /// Process click interaction. Toggles _checked and fires on_toggle.
    fn process_interaction(_self: Self_, s: KtSession):
        if _self.disabled:
            return
        if _self._elem < 0:
            return
        let clk = kt_clicked(s, _self._elem)
        if clk != 0:
            _self._checked = _self._checked == false
            if _self.on_toggle != none:
                _self.on_toggle(_self._checked)

    // ── Spring animation pulse ──────────────────────────────────
    // Smoothly animate _anim_progress toward target (1.0 or 0.0).
    // Uses lerp-based spring with factor 0.25 for responsive feel.
    pulse animate every 16ms jitter 2ms:
        let target = if _checked: 1.0 else: 0.0
        let diff = target - _anim_progress
        if diff > 0.01 or diff < -0.01:
            _anim_progress = _anim_progress + diff * 0.25
        else:
            _anim_progress = target

    render <box kind="toggle" key={key} width={TOGGLE_WIDTH} height={TOGGLE_HEIGHT} fill={track_fill} radius={999} opacity={widget_opacity}>
        <box kind="toggle_thumb" width={THUMB_SIZE} height={THUMB_SIZE} fill="#FFFFFF" radius={999} />
    </box>

// ============================================================================
//  Widget trait implementation for Toggle
// ============================================================================

impl Widget for Toggle:
    fn stable_key(_self: Self_) -> String:
        return _self.key
    fn kind(_self: Self_) -> String:
        return "toggle"
    fn element_id(_self: Self_) -> Int:
        return _self._elem
    fn tick_interaction(_self: Self_):
        return

// ============================================================================
// kaintana/widgets/Tooltip.kn
// ============================================================================
// ============================================================================
//  widgets/Tooltip.kn — Hover-revealed tooltip with delay timer
//  P3-023: Hover-revealed tooltip with delay timer (hover for N ms before
//          show). Positioned relative to parent element. Auto-dismiss on
//          mouse leave. Optional theming.
//
//  Layer: L3 of 4-layer stack — Pure Kain atop the 24-slot vtable.
//
//  Design:
//    - Tooltip wraps a trigger area (children between JSX tags)
//    - Hover timer tracked via _timer state, incremented each frame
//    - Tooltip overlay shown after delay_ms of continuous hover
//    - Auto-dismiss on mouse leave (kt_hovered returns 0)
//    - Tooltip rendered as overlay box with themed surface bg + text
//    - Position prop controls overlay placement (top/bottom/left/right)
//    - process_timer method called by application after each frame render
//
//  Dependencies:
//    - core.kn: kt_row, kt_end_row, kt_text, kt_hovered, kt_fill,
//               kt_radius, kt_opacity, KtSession, KtElementId
//    - theme.kn: resolved_bg defaults to surface (#232339)
// ============================================================================

// ── Type aliases matching C types (from core.kn) ─────────────────────────

use std::kaintana::core::KtSession
use std::kaintana::core::KtElementId
use std::kaintana::core::kt_row
use std::kaintana::core::kt_end_row
use std::kaintana::core::kt_text
use std::kaintana::core::kt_hovered
use std::kaintana::core::kt_fill
use std::kaintana::core::kt_radius
use std::kaintana::core::kt_opacity
use std::kaintana::core::kt_width
use std::kaintana::core::kt_height

// ── Widget trait (from Widget.kn) ─────────────────────────────────────────

pub trait Widget:
    fn stable_key(_self: Self_) -> String:
        return ""
    fn kind(_self: Self_) -> String:
        return "widget"
    fn element_id(_self: Self_) -> Int:
        return -1
    fn tick_interaction(_self: Self_):
        return

// ── Tooltip layout mode constants ─────────────────────────────────────────

/// Tooltip appears above the trigger (default).
pub const KT_TIP_TOP:    Int = 0
/// Tooltip appears below the trigger.
pub const KT_TIP_BOTTOM: Int = 1
/// Tooltip appears to the left of the trigger.
pub const KT_TIP_LEFT:   Int = 2
/// Tooltip appears to the right of the trigger.
pub const KT_TIP_RIGHT:  Int = 3

// ============================================================================
//  Component: Tooltip
// ============================================================================

/// Hover-revealed tooltip with configurable delay and position.
///
/// Props:
///   text     — tooltip text content (required)
///   position — placement hint: "top", "bottom", "left", "right" (default "top")
///   delay_ms — hover time before showing tooltip in ms (default 500)
///   theme    — hex color string for background, "" = surface default
///   key      — stable key for reconciliation
///
/// State:
///   _visible      — becomes true after delay_ms of continuous hover
///   _timer        — accumulated hover time in ms, resets on mouse leave
///   _trigger_elem — root box element ID for hover queries
///
/// Usage:
///   <Tooltip text="Click to save" position="top" delay_ms={500}>
///       <Button label="Save" variant="primary" />
///   </Tooltip>
///
/// Call process_timer(s) after each frame's element tree is built
/// to update the hover timer and tooltip visibility.
component Tooltip(
    text: String,
    position: String = "top",
    delay_ms: Float = 500.0,
    theme: String = "",
    key: String = "tooltip",
):
    state _visible: Bool = false
    state _timer: Float = 0.0
    state _trigger_elem: Int = -1

    /// Resolve tooltip background color from theme prop or default surface.
    fn resolved_bg(_self: Self_) -> String:
        if _self.theme != "":
            return _self.theme
        return "#232339"

    /// Resolve tooltip text color — always uses the theme text default.
    fn resolved_text(_self: Self_) -> String:
        return "#F1F1F6"

    /// Process hover timer each frame. Call after element tree is built.
    ///
    /// Checks kt_hovered on the trigger element. If hovering, increments
    /// _timer by approximate frame delta (16ms). When _timer >= delay_ms,
    /// sets _visible true. On mouse leave, resets timer and hides.
    fn process_timer(_self: Self_, s: KtSession):
        if _self._trigger_elem < 0:
            return
        let hov = kt_hovered(s, _self._trigger_elem)
        if hov != 0:
            if _self._visible == false:
                _self._timer = _self._timer + 16.0
                if _self._timer >= _self.delay_ms:
                    _self._visible = true
        else:
            if _self._visible != false:
                _self._visible = false
                _self._timer = 0.0

    /// Resolve opacity: 1.0 when visible, 0.0 when hidden.
    fn overlay_opacity(_self: Self_) -> Float:
        if _self._visible:
            return 1.0
        return 0.0

    render <box kind="tooltip" key={key}>
        <box kind="tooltip-overlay" key={key + ".overlay"} fill={resolved_bg()} radius={4.0} opacity={overlay_opacity()} width={160.0}>
            <text value={text} />
        </box>
    </box>

// ============================================================================
//  Widget trait implementation for Tooltip
// ============================================================================

impl Widget for Tooltip:
    fn stable_key(_self: Self_) -> String:
        return _self.key
    fn kind(_self: Self_) -> String:
        return "tooltip"
    fn element_id(_self: Self_) -> Int:
        return _self._trigger_elem
    fn tick_interaction(_self: Self_):
        return

