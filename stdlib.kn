pub const COLOR_ACCENT3:     Int = 0xFFE8914A
pub const COLOR_ACCENT4:     Int = 0xFFE84A5F
pub const COLOR_TEXT:        Int = 0xFFE8E8F0
pub const COLOR_TEXT_DIM:    Int = 0xFF8888A0
pub const COLOR_BORDER:      Int = 0xFF3A3A5C
pub const COLOR_HIGHLIGHT:   Int = 0xFF2A2A4E
pub const COLOR_BUTTON:      Int = 0xFF303050
pub const COLOR_BUTTON_HL:   Int = 0xFF404068
pub const COLOR_BUTTON_PR:   Int = 0xFF505080
pub const COLOR_INPUT_BG:    Int = 0xFF0A0A14
pub const COLOR_SLIDER:      Int = 0xFF3A3A5C
pub const COLOR_SLIDER_F:    Int = 0xFF2A2A44
pub const BUTTON_WIDTH:      Int = 100
pub const BUTTON_HEIGHT:     Int = 30
pub const CHECKBOX_SIZE:     Int = 18
pub const SLIDER_WIDTH:      Int = 200
pub const SLIDER_HEIGHT:     Int = 20
pub const TEXTBOX_WIDTH:     Int = 160
pub const TEXTBOX_HEIGHT:    Int = 26
pub const LABEL_HEIGHT:      Int = 20
pub const PANEL_TITLE_H:     Int = 28
pub const PROGRESS_WIDTH:    Int = 150
pub const PROGRESS_HEIGHT:   Int = 18
pub const WINDOW_TITLE_H:    Int = 32
pub const PADDING:           Int = 8
pub const SPACING:           Int = 4

pub fn ui_color_rgba(r: Int, g: Int, b: Int, a: Int) -> Int:
    return (a << 24) | (r << 16) | (g << 8) | b

pub fn ui_color_rgb(r: Int, g: Int, b: Int) -> Int:
    return 0xFF000000 | (r << 16) | (g << 8) | b

// ============================================================================
// ui/component.kn
// ============================================================================
// component.kn — std::ui::component — DEPRECATED
//
// Bridge between Kain components and the immediate-mode widget system.
// Retained for backward compatibility. Will be removed in Phase 5.
// Uses widget ABI functions declared locally.

@extern fn abi_ui_widget_button(ctx_ptr: Int, label: String) -> Bool
@extern fn abi_ui_widget_label(ctx_ptr: Int, text: String) -> Int
@extern fn abi_ui_widget_checkbox(ctx_ptr: Int, label: String, current_value: Int) -> Int
@extern fn abi_ui_widget_slider(ctx_ptr: Int, current_value: Float, lo: Float, hi: Float) -> Int
@extern fn abi_ui_widget_textbox(ctx_ptr: Int, text: String, max_len: Int) -> String
@extern fn abi_ui_widget_panel_begin(ctx_ptr: Int, title: String, x: Float, y: Float, w: Float, h: Float) -> Int
@extern fn abi_ui_widget_panel_end(ctx_ptr: Int)
@extern fn abi_ui_widget_progress(ctx_ptr: Int, label: String, value: Float, max: Float) -> Int
@extern fn abi_ui_widget_window(ctx_ptr: Int, title: String, x: Float, y: Float, w: Float, h: Float, open: Int) -> Bool
@extern fn abi_ui_widget_layout_set_next(ctx_ptr: Int, w: Int, h: Int) -> Int
@extern fn abi_ui_widget_begin_frame(ctx_ptr: Int)
@extern fn abi_ui_widget_end_frame(ctx_ptr: Int)

pub fn begin_frame(ctx: Int):
    abi_ui_widget_begin_frame(ctx)

pub fn end_frame(ctx: Int):
    abi_ui_widget_end_frame(ctx)

pub fn render_button(ctx: Int, label: String, has_handler: Int, enabled: Int) -> Bool:
    if has_handler == 0 or enabled == 0:
        return false
    return abi_ui_widget_button(ctx, label)

pub fn render_label(ctx: Int, text: String):
    let _ = abi_ui_widget_label(ctx, text)

pub fn render_panel(ctx: Int, title: String, x: Float, y: Float, w: Float, h: Float):
    let _ = abi_ui_widget_panel_begin(ctx, title, x, y, w, h)

pub fn render_panel_end(ctx: Int):
    abi_ui_widget_panel_end(ctx)

pub fn render_checkbox(ctx: Int, label: String, value: Int) -> Int:
    let value_bool = value != 0
    let packed = abi_ui_widget_checkbox(ctx, label, if value_bool: 1 else: 0)
    let new_val = (packed & 1) != 0
    if new_val: return 1
    return 0

pub fn render_slider(ctx: Int, value: Float, lo: Float, hi: Float) -> Float:
    let packed = abi_ui_widget_slider(ctx, value, lo, hi)
    let changed = (packed >> 63) != 0
    if changed:
        let int_val = packed & 0x7FFFFFFFFFFFFFFF
        return to_float(int_val) * 0.001
    return value

pub fn render_textbox(ctx: Int, buf: String, max_len: Int) -> String:
    return abi_ui_widget_textbox(ctx, buf, max_len)

pub fn render_progress(ctx: Int, label: String, value: Float, max: Float):
    let _ = abi_ui_widget_progress(ctx, label, value, max)

pub fn render_window(ctx: Int, title: String, x: Float, y: Float, w: Float, h: Float, open: Int) -> Int:
    let open_bool = open != 0
    let still_open = abi_ui_widget_window(ctx, title, x, y, w, h, if open_bool: 1 else: 0)
    if still_open: return 1
    return 0

pub fn layout_row(ctx: Int, widths: [Int]):
    var i = 0
    while i < len(widths):
        abi_ui_widget_layout_set_next(ctx, widths[i], 0)
        i = i + 1

pub fn layout_column(ctx: Int, heights: [Int]):
    var i = 0
    while i < len(heights):
        abi_ui_widget_layout_set_next(ctx, 0, heights[i])
        i = i + 1

pub fn layout_set_next(ctx: Int, w: Int, h: Int):
    abi_ui_widget_layout_set_next(ctx, w, h)

// ============================================================================
// ui/components/button.kn
// ============================================================================
// button.kn — std::ui::components::Button
//
// Interactive button with hover/press visual states.
// Variants: "primary", "secondary", "destructive", "ghost"
//
// NOTE: Method calls in JSX render expressions are not yet lowered by LLVM codegen.
// State-dependent color logic is simplified; full interactivity pending codegen fix.

component Button(
    label: String,
    variant: String,
    disabled: Bool,
    width: Float,
    height: Float,
):
    state hovered: Bool = false
    state pressed: Bool = false

    fn handle_click(_self: Self_):
        if _self.disabled:
            return

    fn handle_enter(_self: Self_):
        if _self.disabled:
            return
        _self.hovered = true

    fn handle_leave(_self: Self_):
        _self.hovered = false

    fn handle_press(_self: Self_):
        if _self.disabled:
            return
        _self.pressed = true

    fn handle_release(_self: Self_):
        _self.pressed = false

    render <box fill_color="button" width={width} height={height}>
        <text value={label} font_size={14.0} color="text" align="center" width={width} height={height} />
    </box>

// ============================================================================
// ui/components/checkbox.kn
// ============================================================================
// checkbox.kn — std::ui::components::Checkbox
//
// Square toggle box with checkmark and optional label.
// Hover feedback on the box background.
//
// NOTE: Method calls in JSX render expressions are not yet lowered by LLVM codegen.
// Visual state hardcoded; full interactivity pending codegen fix.

component Checkbox(
    label: String,
    checked: Bool,
):
    state hovered: Bool = false

    fn handle_toggle(_self: Self_):
        let _ = _self.checked

    fn handle_enter(_self: Self_):
        _self.hovered = true

    fn handle_leave(_self: Self_):
        _self.hovered = false

    render <stack direction="horizontal" spacing={8.0}>
        <box fill_color="button" width={18.0} height={18.0}>
            <text value="" font_size={12.0} color="text_inverse" align="center" width={18.0} height={18.0} />
        </box>
        <text value={label} font_size={14.0} color="text" align="left" />
    </stack>

// ============================================================================
// ui/components/label.kn
// ============================================================================
// label.kn — std::ui::components::Label
//
// Thin wrapper over the Text primitive with theme defaults.
// Pure display component — no interaction state.
//
// NOTE: Method calls in JSX render expressions are not yet lowered by LLVM codegen.
// Props with defaults are used directly instead of method wrappers.

component Label(
    value: String,
    font_size: Float = 14.0,
    color: String = "text",
    align: String = "left",
    weight: Int = 400,
    width: Float = 0.0,
    height: Float = 0.0,
):
    render <text value={value} font_size={font_size} color={color} align={align} weight={weight} width={width} height={height} />

// ============================================================================
// ui/components/progress.kn
// ============================================================================
// progress.kn — std::ui::components::ProgressBar
//
// Horizontal progress bar showing value/max completion ratio.
// Variant: "success"=green, "warning"=orange, "error"=red, default=blue.
//
// NOTE: Method calls in JSX render expressions are not yet lowered by LLVM codegen.
// Fill width and color hardcoded; full theming pending codegen fix.

component ProgressBar(
    value: Float,
    max: Float,
    variant: String,
):
    render <stack direction="horizontal" spacing={0}>
        <box fill_color="slider_track" width={200.0} height={18.0}>
            <box fill_color="accent2" width={100.0} height={18.0} />
        </box>
        <text value="50%" font_size={12.0} color="text" align="left" width={40.0} height={18.0} />
    </stack>

// ============================================================================
// ui/components/slider.kn
// ============================================================================
// slider.kn — std::ui::components::Slider
//
// Horizontal track with draggable thumb.
// Value clamped to [min, max] with optional step granularity.
//
// NOTE: Method calls in JSX render expressions are not yet lowered by LLVM codegen.
// Track fill width hardcoded; full interactivity pending codegen fix.

component Slider(
    value: Float,
    min: Float,
    max: Float,
    step: Float,
):
    state dragging: Bool = false
    state drag_value: Float = value

    fn current_value(_self: Self_) -> Float:
        if _self.dragging:
            return _self.drag_value
        return _self.value

    fn fraction(_self: Self_) -> Float:
        let range = _self.max - _self.min
        if range <= 0.0:
            return 0.0
        return (_self.current_value() - _self.min) / range

    fn handle_drag_start(_self: Self_):
        _self.dragging = true
        _self.drag_value = _self.value

    fn handle_drag_move(_self: Self_, mouse_x: Float):
        let fraction = (mouse_x - 8.0) / 184.0
        let clamped = if fraction < 0.0: 0.0 elif fraction > 1.0: 1.0 else: fraction
        let raw = _self.min + clamped * (_self.max - _self.min)
        if _self.step > 0.0:
            let steps = to_float(to_int((raw - _self.min) / _self.step + 0.5))
            _self.drag_value = _self.min + steps * _self.step
        else:
            _self.drag_value = raw

    fn handle_drag_end(_self: Self_):
        _self.dragging = false

    render <stack direction="vertical" spacing={0}>
        <box fill_color="slider_track" width={200.0} height={6.0} />
        <box fill_color="slider_fill" width={92.0} height={6.0} />
        <box fill_color="slider_thumb" width={16.0} height={16.0} />
    </stack>

// ============================================================================
// ui/components/spinner.kn
// ============================================================================
// spinner.kn — std::ui::components::Spinner
//
// Animated loading spinner with pulse-driven rotation.
// Renders as a filled circle with accent color.
// Angle advances each tick via pulse clock.
//
// NOTE: Method calls in JSX render expressions are not yet lowered by LLVM codegen.
// Size and color hardcoded; full theming pending codegen fix.

component Spinner(
    size: Float,
    color: String,
    speed: Float,
):
    state angle: Float = 0.0

    render <box fill_color="accent" corner_radius={12.0} width={24.0} height={24.0}>
        <text value="" />
    </box>

// ============================================================================
// ui/components/textinput.kn
// ============================================================================
// textinput.kn — std::ui::components::TextInput
//
// Single-line editable text field with cursor and IME support.
// Password mode masks input. Placeholder shown when empty.
//
// NOTE: Method calls in JSX render expressions are not yet lowered by LLVM codegen.
// Display logic simplified; full interactivity pending codegen fix.

component TextInput(
    value: String,
    placeholder: String,
    width: Float = 200.0,
    password: Bool,
):
    state focused: Bool = false
    state cursor_pos: Int = len(value)
    state cursor_blink: Bool = true

    fn handle_focus(_self: Self_):
        _self.focused = true

    fn handle_blur(_self: Self_):
        _self.focused = false

    fn handle_key(_self: Self_, key: String):
        if key == "Backspace":
            if _self.cursor_pos > 0:
                _self.cursor_pos = _self.cursor_pos - 1

    render <box fill_color="input_bg" width={width} height={28.0}>
        <text value={value} font_size={14.0} color="text" align="left" width={width} height={26.0} />
        <text value="|" font_size={14.0} color="accent" align="left" width={10.0} height={26.0} />
    </box>

// ============================================================================
// ui/components/toggle.kn
// ============================================================================
// toggle.kn — std::ui::components::Toggle
//
// Pill-shaped toggle / switch with animated thumb.
// Track uses corner_radius = h/2 for capsule shape.
//
// NOTE: Method calls in JSX render expressions are not yet lowered by LLVM codegen.
// Visual state hardcoded; full interactivity pending codegen fix.

component Toggle(
    checked: Bool,
    disabled: Bool,
):
    state hovered: Bool = false
    state anim_progress: Float = if checked: 1.0 else: 0.0

    fn handle_toggle(_self: Self_):
        if _self.disabled:
            return
        let _ = _self.checked

    fn handle_enter(_self: Self_):
        _self.hovered = true

    fn handle_leave(_self: Self_):
        _self.hovered = false

    render <box fill_color="slider_track" corner_radius={12.0} width={44.0} height={24.0}>
        <box fill_color="text" corner_radius={10.0} width={20.0} height={20.0} />
    </box>

