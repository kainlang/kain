pub const GPU_RESIDENCY_HOST_VISIBLE: Int = 1
pub const GPU_RESIDENCY_HOST_COHERENT: Int = 2
pub const GPU_RESIDENCY_DEVICE_LOCAL: Int = 4
pub const GPU_RESIDENCY_SHARED: Int = 8
