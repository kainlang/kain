// Experimental KAIN MCP server.
//
// Transport:
// - stdin/stdout for JSON-RPC frames
// - stderr for logs only
//
// Runtime contract:
// - the router is an actor so the request path stays actor-backed
// - file and CLI work are routed through explicit helper functions

struct McpRuntimeSettings:
    repo_root: String
    kain_bin: String
    allow_writes: Bool
    include_hidden: Bool
    skip_dirs: Array<String>
    timeout_ms: Int
    max_list_entries: Int
    max_connection_results: Int
    default_read_limit: Int

struct ToolSpec:
    name: String
    title: String
    description: String
    input_schema_json: String

struct McpRouterState:
    settings: McpRuntimeSettings
    specs: Array<ToolSpec>

fn parse_truthy_env(name: String, default_value: Bool) -> Bool:
    let raw = env(name).trim().to_ascii_lowercase()
    if len(raw) == 0:
        return default_value
    if raw == "1":
        return true
    if raw == "true":
        return true
    if raw == "yes":
        return true
    if raw == "on":
        return true
    return false

fn parse_csv_env(name: String, fallback_csv: String) -> Array<String>:
    let raw = env(name).trim()
    var source = fallback_csv
    if len(raw) > 0:
        source = raw

    var items: Array<String> = []
    var current = ""
    var index = 0
    while index < len(source):
        let ch = char_at(source, index)
        if ch == ",":
            let trimmed = current.trim()
            if len(trimmed) > 0:
                push(items, trimmed)
            current = ""
        else:
            current = current + ch
        index = index + 1

    let final_piece = current.trim()
    if len(final_piece) > 0:
        push(items, final_piece)
    return items

fn resolve_repo_root() -> String:
    let primary = env("KAIN_REPO_ROOT").trim()
    if len(primary) > 0:
        return primary
    let fallback = env("KAIN_MCP_REPO_ROOT").trim()
    if len(fallback) > 0:
        return fallback
    return cwd()

fn resolve_kain_bin(repo_root: String) -> String:
    let override_bin = env("KAIN_MCP_KAIN_BIN").trim()
    if len(override_bin) > 0:
        return override_bin

    let local_binary = path_join(repo_root, "target/debug/kain")
    if file_exists(local_binary):
        return local_binary

    return "kain"

fn resolve_settings() -> McpRuntimeSettings:
    let repo_root = resolve_repo_root()
    let kain_bin = resolve_kain_bin(repo_root)
    let allow_writes = parse_truthy_env("KAIN_MCP_ALLOW_WRITES", true)
    let include_hidden = parse_truthy_env("KAIN_MCP_INCLUDE_HIDDEN", false)
    let skip_dirs = parse_csv_env(
        "KAIN_MCP_SKIP_DIRS",
        ".git,target,node_modules,dist,build,generated,out,coverage,.cache,.venv",
    )

    return McpRuntimeSettings {
        repo_root: repo_root,
        kain_bin: kain_bin,
        allow_writes: allow_writes,
        include_hidden: include_hidden,
        skip_dirs: skip_dirs,
        timeout_ms: 1800000,
        max_list_entries: 250,
        max_connection_results: 80,
        default_read_limit: 200000,
    }

fn select_protocol_version(requested: String) -> String:
    if requested == "2025-11-25":
        return requested
    if requested == "2025-06-18":
        return requested
    if requested == "2025-03-26":
        return requested
    return "2025-06-18"

fn build_tool_specs() -> Array<ToolSpec>:
    return [
        ToolSpec {
            name: "fs.list_directory",
            title: "List Directory",
            description: "List the contents of a directory, optionally recursively.",
            input_schema_json: "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"recursive\":{\"type\":\"boolean\"},\"includeHidden\":{\"type\":\"boolean\"},\"maxEntries\":{\"type\":\"integer\"}},\"required\":[\"path\"],\"additionalProperties\":false}",
        },
        ToolSpec {
            name: "fs.read_file",
            title: "Read File",
            description: "Read a file from disk and return its contents.",
            input_schema_json: "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"maxBytes\":{\"type\":\"integer\"}},\"required\":[\"path\"],\"additionalProperties\":false}",
        },
        ToolSpec {
            name: "fs.write_file",
            title: "Write File",
            description: "Write text to a file and optionally overwrite an existing file.",
            input_schema_json: "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"}},\"required\":[\"path\",\"content\"],\"additionalProperties\":false}",
        },
        ToolSpec {
            name: "fs.make_directory",
            title: "Make Directory",
            description: "Create a directory tree.",
            input_schema_json: "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"],\"additionalProperties\":false}",
        },
        ToolSpec {
            name: "fs.get_connections",
            title: "Get Connections",
            description: "Heuristically discover connected files around a path.",
            input_schema_json: "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"searchRoot\":{\"type\":\"string\"},\"recursive\":{\"type\":\"boolean\"},\"includeHidden\":{\"type\":\"boolean\"},\"maxResults\":{\"type\":\"integer\"}},\"required\":[\"path\"],\"additionalProperties\":false}",
        },
    ]

fn build_tools_list_result(specs: Array<ToolSpec>) -> String:
    let result = json_object_new()
    let tools = json_array_new()

    for spec in specs:
        let tool = json_object_new()
        json_object_set(tool, "name", spec.name)
        json_object_set(tool, "title", spec.title)
        json_object_set(tool, "description", spec.description)
        json_object_set(tool, "inputSchema", json_parse(spec.input_schema_json))
        json_array_push(tools, tool)

    json_object_set(result, "tools", tools)
    return json_string(result)

fn build_initialize_result(protocol_version: String) -> String:
    let result = json_object_new()
    let capabilities = json_object_new()
    let tools = json_object_new()
    let server_info = json_object_new()

    json_object_set(result, "protocolVersion", protocol_version)
    json_object_set(tools, "listChanged", false)
    json_object_set(capabilities, "tools", tools)
    json_object_set(result, "capabilities", capabilities)

    json_object_set(server_info, "name", "kain-mcp")
    json_object_set(server_info, "title", "KAIN MCP Server")
    json_object_set(server_info, "version", "0.1.0-experimental")
    json_object_set(
        server_info,
        "description",
        "Experimental KAIN-authored MCP server with filesystem and KAIN CLI lanes.",
    )
    json_object_set(result, "serverInfo", server_info)
    json_object_set(
        result,
        "instructions",
        "Use fs.* for file work, kain.* for CLI/import/build lanes, and workspace.init for scaffolding.",
    )

    return json_string(result)

fn build_tool_result(summary: String, structured_json: String, is_error: Bool) -> String:
    let result = json_object_new()
    let content = json_array_new()
    let text_item = json_object_new()

    json_object_set(text_item, "type", "text")
    json_object_set(text_item, "text", summary)
    json_array_push(content, text_item)

    json_object_set(result, "content", content)
    json_object_set(result, "isError", is_error)

    if len(structured_json) > 0:
        json_object_set(result, "structuredContent", json_parse(structured_json))

    return json_string(result)

fn build_jsonrpc_success(raw_request: String, result_json: String) -> String:
    let request = json_parse(raw_request)
    let response = json_object_new()
    json_object_set(response, "jsonrpc", "2.0")
    json_object_set(response, "id", json_get(request, "id"))
    json_object_set(response, "result", json_parse(result_json))
    return json_string(response)

fn build_jsonrpc_error(raw_request: String, code: Int, message: String) -> String:
    let request = json_parse(raw_request)
    let response = json_object_new()
    let error = json_object_new()

    json_object_set(response, "jsonrpc", "2.0")
    json_object_set(response, "id", json_get(request, "id"))
    json_object_set(error, "code", code)
    json_object_set(error, "message", message)
    json_object_set(response, "error", error)

    return json_string(response)

fn build_parse_error(message: String) -> String:
    let response = json_object_new()
    let error = json_object_new()

    json_object_set(response, "jsonrpc", "2.0")
    json_object_set(response, "id", None)
    json_object_set(error, "code", -32700)
    json_object_set(error, "message", message)
    json_object_set(response, "error", error)

    return json_string(response)

fn write_response_frame(body: String) -> Unit:
    let header = "Content-Length: " + json_string(len(body)) + "\r\n\r\n"
    stdout_write(header)
    stdout_write(body)

fn read_next_request_frame() -> String:
    var content_length = 0

    while true:
        let header_line = read_line()
        if len(header_line) == 0:
            break

        if header_line.starts_with("Content-Length:"):
            let value = substring(header_line, len("Content-Length:"), len(header_line)).trim()
            content_length = to_int(value)

    if content_length <= 0:
        return ""

    return stdin_read_exact(content_length)

fn is_text_like_file(path_name: String) -> Bool:
    let ext = path_extension(path_name).trim().to_ascii_lowercase()
    if ext == "kn":
        return true
    if ext == "md":
        return true
    if ext == "toml":
        return true
    if ext == "json":
        return true
    if ext == "rs":
        return true
    if ext == "ts":
        return true
    if ext == "js":
        return true
    if ext == "py":
        return true
    if ext == "sh":
        return true
    if ext == "ps1":
        return true
    if ext == "c":
        return true
    if ext == "h":
        return true
    if ext == "cpp":
        return true
    if ext == "hpp":
        return true
    if ext == "yaml":
        return true
    if ext == "yml":
        return true
    if ext == "txt":
        return true
    return false

fn should_skip_directory(directory_name: String, include_hidden: Bool, skip_dirs: Array<String>) -> Bool:
    if len(directory_name) == 0:
        return false
    if !include_hidden:
        if directory_name.starts_with("."):
            return true
    if skip_dirs.contains(directory_name):
        return true
    return false

fn handle_fs_list_directory(settings: McpRuntimeSettings, params: Any) -> String:
    return "List directory is temporarily simplified."

fn handle_fs_read_file(settings: McpRuntimeSettings, params: Any) -> String:
    return "Read file is temporarily simplified."

fn handle_fs_write_file(settings: McpRuntimeSettings, params: Any) -> String:
    return "Write file is temporarily simplified."

fn handle_fs_make_directory(settings: McpRuntimeSettings, params: Any) -> String:
    return "Make directory is temporarily simplified."

fn handle_fs_get_connections(settings: McpRuntimeSettings, params: Any) -> String:
    let entries = read_dir(settings.repo_root)
    let summary = entries.join("\n")
    return build_tool_result(summary, "", false)

fn handle_initialize_request(raw_request: String) -> String:
    eprintln("initialize build start")
    let response = build_jsonrpc_success(raw_request, json_string(json_object_new()))
    eprintln("initialize build done")
    return response

fn handle_tools_call(settings: McpRuntimeSettings, raw_request: String, specs: Array<ToolSpec>) -> String:
    let request = json_parse(raw_request)
    let params = json_get(request, "params")
    let tool_name = json_get_string(params, "name")
    var tool_args = json_object_new()
    if json_has(params, "arguments"):
        tool_args = json_get(params, "arguments")

    match tool_name:
        "fs.list_directory" => build_jsonrpc_success(raw_request, handle_fs_list_directory(settings, tool_args))
        "fs.read_file" => build_jsonrpc_success(raw_request, handle_fs_read_file(settings, tool_args))
        "fs.write_file" => build_jsonrpc_success(raw_request, handle_fs_write_file(settings, tool_args))
        "fs.make_directory" => build_jsonrpc_success(raw_request, handle_fs_make_directory(settings, tool_args))
        "fs.get_connections" => build_jsonrpc_success(raw_request, handle_fs_get_connections(settings, tool_args))
        _ => build_jsonrpc_error(raw_request, -32601, "Unknown tool: " + tool_name)

fn route_request(settings: McpRuntimeSettings, specs: Array<ToolSpec>, raw_request: String) -> String:
    let request = json_parse(raw_request)
    let method = json_get_string(request, "method")
    eprintln("route_request method=" + method)

    match method:
        "initialize" => handle_initialize_request(raw_request)
        "notifications/initialized" => build_jsonrpc_success(raw_request, "null")
        "shutdown" => build_jsonrpc_success(raw_request, "null")
        "ping" => build_jsonrpc_success(raw_request, json_string(json_object_new()))
        "tools/list" => build_jsonrpc_success(raw_request, build_tools_list_result(specs))
        "tools/call" => handle_tools_call(settings, raw_request, specs)
        _ => build_jsonrpc_error(raw_request, -32601, "Method not found: " + method)

fn main() -> Int:
    let settings = resolve_settings()
    let specs = build_tool_specs()
    let router_state = McpRouterState {
        settings: settings,
        specs: specs,
    }
    let router = gen_server_start_link(
        router_state,
        |raw_request, state| gen_server_call_result(route_request(state.settings, state.specs, raw_request), state),
        |message, state| state,
        |message, state| state
    )

    eprintln("KAIN MCP server starting at " + settings.repo_root)

    while true:
        let raw_request = read_next_request_frame()
        match len(raw_request) == 0:
            true => break
            false => write_response_frame(gen_server_call(router, raw_request))

    return 0
