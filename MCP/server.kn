fn build_tools_list_result(specs: Array<ToolSpec>) -> String:
    let result = json_object_new()
    let tools = json_array_new()

    for spec in specs:
        let tool = json_object_new()
        json_object_set(tool, "name", spec.name)
        json_object_set(tool, "title", spec.title)
        json_object_set(tool, "description", spec.description)
        json_object_set(tool, "inputSchema", json_parse(spec.input_schema_json))
        json_array_push(tools, tool)

    json_object_set(result, "tools", tools)
    return json_string(result)

fn build_initialize_result(protocol_version: String) -> String:
    let result = json_object_new()
    let capabilities = json_object_new()
    let tools = json_object_new()
    let server_info = json_object_new()

    json_object_set(result, "protocolVersion", protocol_version)
    json_object_set(tools, "listChanged", false)
    json_object_set(capabilities, "tools", tools)
    json_object_set(result, "capabilities", capabilities)

    json_object_set(server_info, "name", "kain-mcp")
    json_object_set(server_info, "title", "KAIN MCP Server")
    json_object_set(server_info, "version", "0.1.0-experimental")
    json_object_set(
        server_info,
        "description",
        "Experimental KAIN-authored MCP server with filesystem and KAIN CLI lanes.",
    )
    json_object_set(result, "serverInfo", server_info)
    json_object_set(
        result,
        "instructions",
        "Use fs.* for file work, kain.* for CLI/import/build lanes, and workspace.init for scaffolding.",
    )

    return json_string(result)

fn build_tool_result(summary: String, structured_json: String, is_error: Bool) -> String:
    let result = json_object_new()
    let content = json_array_new()
    let text_item = json_object_new()

    json_object_set(text_item, "type", "text")
    json_object_set(text_item, "text", summary)
    json_array_push(content, text_item)

    json_object_set(result, "content", content)
    json_object_set(result, "isError", is_error)

    if len(structured_json) > 0:
        json_object_set(result, "structuredContent", json_parse(structured_json))

    return json_string(result)

fn build_jsonrpc_success(raw_request: String, result_json: String) -> String:
    let request = json_parse(raw_request)
    let response = json_object_new()
    json_object_set(response, "jsonrpc", "2.0")
    json_object_set(response, "id", json_get(request, "id"))
    json_object_set(response, "result", json_parse(result_json))
    return json_string(response)

fn build_jsonrpc_error(raw_request: String, code: Int, message: String) -> String:
    let request = json_parse(raw_request)
    let response = json_object_new()
    let error = json_object_new()

    json_object_set(response, "jsonrpc", "2.0")
    json_object_set(response, "id", json_get(request, "id"))
    json_object_set(error, "code", code)
    json_object_set(error, "message", message)
    json_object_set(response, "error", error)

    return json_string(response)

fn build_parse_error(message: String) -> String:
    let response = json_object_new()
    let error = json_object_new()

    json_object_set(response, "jsonrpc", "2.0")
    json_object_set(response, "id", None)
    json_object_set(error, "code", -32700)
    json_object_set(error, "message", message)
    json_object_set(response, "error", error)

    return json_string(response)

fn write_response_frame(body: String) -> Unit:
    let header = "Content-Length: " + to_string(len(body)) + "\r\n\r\n"
    stdout_write(header)
    stdout_write(body)

fn read_next_request_frame() -> String:
    var content_length = 0

    while true:
        let header_line = read_line()
        if len(header_line) == 0:
            break

        if starts_with(header_line, "Content-Length:"):
            let value = trim(substring(header_line, len("Content-Length:"), len(header_line)))
            content_length = to_int(value)

    if content_length <= 0:
        return ""

    return stdin_read_exact(content_length)

fn ensure_parent_directory(target_path: String) -> Unit:
    let parent_path = path_parent(target_path)
    if len(parent_path) > 0:
        create_dir_all(parent_path)

fn is_text_like_file(path_name: String) -> Bool:
    let ext = path_extension(path_name).trim().to_ascii_lowercase()
    if ext == "kn":
        return true
    if ext == "md":
        return true
    if ext == "toml":
        return true
    if ext == "json":
        return true
    if ext == "rs":
        return true
    if ext == "ts":
        return true
    if ext == "js":
        return true
    if ext == "py":
        return true
    if ext == "sh":
        return true
    if ext == "ps1":
        return true
    if ext == "c":
        return true
    if ext == "h":
        return true
    if ext == "cpp":
        return true
    if ext == "hpp":
        return true
    if ext == "yaml":
        return true
    if ext == "yml":
        return true
    if ext == "txt":
        return true
    return false

fn should_skip_directory(directory_name: String, include_hidden: Bool, skip_dirs: Array<String>) -> Bool:
    if len(directory_name) == 0:
        return false
    if !include_hidden:
        if starts_with(directory_name, "."):
            return true
    if contains(skip_dirs, directory_name):
        return true
    return false

fn collect_directory_entries(current_path: String, recursive: Bool, include_hidden: Bool, skip_dirs: Array<String>, max_entries: Int, output: Array<String>) -> Unit:
    if len(output) >= max_entries:
        return

    let entries = read_dir(current_path)
    for entry in entries:
        if len(output) >= max_entries:
            return

        let entry_name = path_file_name(entry)
        if path_is_dir(entry):
            if !should_skip_directory(entry_name, include_hidden, skip_dirs):
                push(output, entry)
                if recursive:
                    collect_directory_entries(entry, recursive, include_hidden, skip_dirs, max_entries, output)
        else:
            if path_is_file(entry):
                if include_hidden:
                    push(output, entry)
                else:
                    if !starts_with(entry_name, "."):
                        push(output, entry)

fn collect_connection_descriptors(search_root: String, target_path: String, target_name: String, target_stem: String, target_extension: String, recursive: Bool, include_hidden: Bool, skip_dirs: Array<String>, max_results: Int, output: Array<String>) -> Unit:
    if len(output) >= max_results:
        return

    let entries = read_dir(search_root)
    for entry in entries:
        if len(output) >= max_results:
            return

        if path_is_dir(entry):
            let entry_name = path_file_name(entry)
            if !should_skip_directory(entry_name, include_hidden, skip_dirs):
                if recursive:
                    collect_connection_descriptors(entry, target_path, target_name, target_stem, target_extension, recursive, include_hidden, skip_dirs, max_results, output)
        else:
            let reason = build_connection_reason(entry, target_path, target_name, target_stem, target_extension)
            if len(reason) > 0:
                push(output, reason + " | " + entry)

fn build_connection_reason(entry: String, target_path: String, target_name: String, target_stem: String, target_extension: String) -> String:
    let entry_name = path_file_name(entry)
    if !path_is_file(entry):
        return ""
    if starts_with(entry_name, "."):
        return ""
    if !is_text_like_file(entry_name):
        return ""
    if entry == target_path:
        return ""

    var reason = ""
    let parent_path = path_parent(entry)
    let target_parent = path_parent(target_path)
    if len(parent_path) > 0:
        if parent_path == target_parent:
            reason = "same_directory"

    let candidate_extension = path_extension(entry).trim().to_ascii_lowercase()
    if len(target_extension) > 0:
        if candidate_extension == target_extension:
            if len(reason) == 0:
                reason = "same_extension"
            else:
                reason = reason + ",same_extension"

    let candidate_contents = read_file(entry)
    if len(target_name) > 0:
        if contains(candidate_contents, target_name):
            if len(reason) == 0:
                reason = "name_mention"
            else:
                reason = reason + ",name_mention"

    if len(target_stem) > 0:
        if contains(candidate_contents, target_stem):
            if len(reason) == 0:
                reason = "stem_mention"
            else:
                reason = reason + ",stem_mention"

    return reason

fn build_list_directory_result(path: String, recursive: Bool, include_hidden: Bool, entries: Array<String>) -> String:
    let structured = json_object_new()
    let structured_entries = json_array_new()

    for entry in entries:
        json_array_push(structured_entries, entry)

    json_object_set(structured, "path", path)
    json_object_set(structured, "recursive", recursive)
    json_object_set(structured, "includeHidden", include_hidden)
    json_object_set(structured, "entries", structured_entries)

    var summary = join(entries, "\n")
    if len(summary) == 0:
        summary = "(empty directory)"

    return build_tool_result(summary, json_string(structured), false)

fn build_read_file_result(path: String, contents: String, max_bytes: Int) -> String:
    var output = contents
    var truncated = false
    if len(output) > max_bytes:
        output = substring(output, 0, max_bytes)
        truncated = true

    let structured = json_object_new()
    json_object_set(structured, "path", path)
    json_object_set(structured, "bytes", len(contents))
    json_object_set(structured, "truncated", truncated)
    json_object_set(structured, "returnedBytes", len(output))

    var summary = output
    if truncated:
        summary = summary + "\n[truncated to " + to_string(max_bytes) + " bytes]"
    if len(summary) == 0:
        summary = "(empty file)"

    return build_tool_result(summary, json_string(structured), false)

fn build_write_file_result(path: String, bytes_written: Int, overwrite: Bool) -> String:
    let structured = json_object_new()
    json_object_set(structured, "path", path)
    json_object_set(structured, "bytesWritten", bytes_written)
    json_object_set(structured, "overwrite", overwrite)

    let summary = "Wrote " + to_string(bytes_written) + " bytes to " + path
    return build_tool_result(summary, json_string(structured), false)

fn build_make_directory_result(path: String) -> String:
    let structured = json_object_new()
    json_object_set(structured, "path", path)
    let summary = "Created directory " + path
    return build_tool_result(summary, json_string(structured), false)

fn build_get_connections_result(path: String, search_root: String, recursive: Bool, include_hidden: Bool, connections: Array<String>) -> String:
    let structured = json_object_new()
    let structured_connections = json_array_new()

    for connection in connections:
        json_array_push(structured_connections, connection)

    json_object_set(structured, "path", path)
    json_object_set(structured, "searchRoot", search_root)
    json_object_set(structured, "recursive", recursive)
    json_object_set(structured, "includeHidden", include_hidden)
    json_object_set(structured, "connections", structured_connections)

    var summary = join(connections, "\n")
    if len(summary) == 0:
        summary = "(no connections found)"

    return build_tool_result(summary, json_string(structured), false)

fn build_command_tool_result(action: String, result: CommandRunResult) -> String:
    var summary = action + " exited " + to_string(result.status)
    if result.success:
        if len(result.stdout) > 0:
            summary = result.stdout
        else:
            summary = action + " completed successfully"
    else:
        if len(result.stderr) > 0:
            summary = result.stderr
        else:
            summary = action + " failed"

    return build_tool_result(summary, json_string(result), !result.success)

fn run_kain_command(settings: McpRuntimeSettings, args: Array<String>) -> CommandRunResult:
    return command_run(settings.kain_bin, args, settings.repo_root)

fn append_string_array_to_args(flag: String, values: Array<String>, args: Array<String>) -> Unit:
    for value in values:
        push(args, flag)
        push(args, value)

fn handle_fs_list_directory(settings: McpRuntimeSettings, params: Any) -> String:
    let path = json_get_string(params, "path")
    var recursive = false
    var include_hidden = settings.include_hidden
    var max_entries = settings.max_list_entries

    if json_has(params, "recursive"):
        recursive = json_get_bool(params, "recursive")
    if json_has(params, "includeHidden"):
        include_hidden = json_get_bool(params, "includeHidden")
    if json_has(params, "maxEntries"):
        max_entries = json_get_int(params, "maxEntries")

    if !file_exists(path):
        return build_tool_result("Path does not exist: " + path, "", true)
    if !path_is_dir(path):
        return build_tool_result("Path is not a directory: " + path, "", true)

    var entries: Array<String> = []
    collect_directory_entries(path, recursive, include_hidden, settings.skip_dirs, max_entries, entries)
    return build_list_directory_result(path, recursive, include_hidden, entries)

fn handle_fs_read_file(settings: McpRuntimeSettings, params: Any) -> String:
    let path = json_get_string(params, "path")
    var max_bytes = settings.default_read_limit
    if json_has(params, "maxBytes"):
        max_bytes = json_get_int(params, "maxBytes")

    if !file_exists(path):
        return build_tool_result("Path does not exist: " + path, "", true)
    if !path_is_file(path):
        return build_tool_result("Path is not a file: " + path, "", true)

    let contents = read_file(path)
    return build_read_file_result(path, contents, max_bytes)

fn handle_fs_write_file(settings: McpRuntimeSettings, params: Any) -> String:
    let path = json_get_string(params, "path")
    let content = json_get_string(params, "content")
    var overwrite = false
    if json_has(params, "overwrite"):
        overwrite = json_get_bool(params, "overwrite")

    if !settings.allow_writes:
        return build_tool_result("Writes are disabled by server policy.", "", true)

    if file_exists(path) && path_is_dir(path):
        return build_tool_result("Target exists but is a directory: " + path, "", true)
    if file_exists(path) && !overwrite:
        return build_tool_result("File exists and overwrite is false: " + path, "", true)

    ensure_parent_directory(path)
    write_file(path, content)
    return build_write_file_result(path, len(content), overwrite)

fn handle_fs_make_directory(settings: McpRuntimeSettings, params: Any) -> String:
    let path = json_get_string(params, "path")

    if !settings.allow_writes:
        return build_tool_result("Writes are disabled by server policy.", "", true)

    if file_exists(path) && path_is_file(path):
        return build_tool_result("Target exists but is a file: " + path, "", true)

    create_dir_all(path)
    return build_make_directory_result(path)

fn handle_fs_get_connections(settings: McpRuntimeSettings, params: Any) -> String:
    let path = json_get_string(params, "path")
    var search_root = settings.repo_root
    var recursive = true
    var include_hidden = settings.include_hidden
    var max_results = settings.max_connection_results

    if json_has(params, "searchRoot"):
        search_root = json_get_string(params, "searchRoot")
    if json_has(params, "recursive"):
        recursive = json_get_bool(params, "recursive")
    if json_has(params, "includeHidden"):
        include_hidden = json_get_bool(params, "includeHidden")
    if json_has(params, "maxResults"):
        max_results = json_get_int(params, "maxResults")

    if !file_exists(path):
        return build_tool_result("Path does not exist: " + path, "", true)

    if !file_exists(search_root):
        search_root = settings.repo_root
    if !path_is_dir(search_root):
        search_root = settings.repo_root

    let target_name = path_file_name(path)
    let target_stem = path_stem(path)
    let target_extension = path_extension(path).trim().to_ascii_lowercase()

    var connections: Array<String> = []
    collect_connection_descriptors(
        search_root,
        path,
        target_name,
        target_stem,
        target_extension,
        recursive,
        include_hidden,
        settings.skip_dirs,
        max_results,
        connections,
    )

    return build_get_connections_result(path, search_root, recursive, include_hidden, connections)

fn handle_kain_build(settings: McpRuntimeSettings, params: Any) -> String:
    let path = json_get_string(params, "path")
    let target = json_get_string(params, "target")
    var output = ""
    var run_after = false
    var watch = false
    var strict = false

    if json_has(params, "output"):
        output = json_get_string(params, "output")
    if json_has(params, "run"):
        run_after = json_get_bool(params, "run")
    if json_has(params, "watch"):
        watch = json_get_bool(params, "watch")
    if json_has(params, "strict"):
        strict = json_get_bool(params, "strict")

    var args: Array<String> = []
    push(args, "build")
    push(args, path)
    push(args, "-t")
    push(args, target)

    if len(output) > 0:
        push(args, "-o")
        push(args, output)
    if run_after:
        push(args, "-r")
    if watch:
        push(args, "-w")
    if strict:
        push(args, "--strict")

    let result = run_kain_command(settings, args)
    return build_command_tool_result("kain build", result)

fn append_optional_tool_filters(params: Any, args: Array<String>) -> Unit:
    if json_has(params, "include"):
        let include_items = json_get(params, "include")
        var include_index = 0
        while include_index < json_array_len(include_items):
            push(args, "--include")
            push(args, to_string(json_array_get(include_items, include_index)))
            include_index = include_index + 1

    if json_has(params, "exclude"):
        let exclude_items = json_get(params, "exclude")
        var exclude_index = 0
        while exclude_index < json_array_len(exclude_items):
            push(args, "--exclude")
            push(args, to_string(json_array_get(exclude_items, exclude_index)))
            exclude_index = exclude_index + 1

fn handle_import_tool(settings: McpRuntimeSettings, params: Any, command_name: String) -> String:
    let path = json_get_string(params, "path")
    var output = ""
    var target = ""
    var flat = false
    var fail_fast = false
    var report_json = false

    if json_has(params, "output"):
        output = json_get_string(params, "output")
    if json_has(params, "target"):
        target = json_get_string(params, "target")
    if json_has(params, "flat"):
        flat = json_get_bool(params, "flat")
    if json_has(params, "failFast"):
        fail_fast = json_get_bool(params, "failFast")
    if json_has(params, "reportJson"):
        report_json = json_get_bool(params, "reportJson")

    var args: Array<String> = []
    push(args, command_name)
    push(args, path)

    if len(output) > 0:
        push(args, "-o")
        push(args, output)
    if len(target) > 0:
        push(args, "-t")
        push(args, target)
    if flat:
        push(args, "--flat")
    if fail_fast:
        push(args, "--fail-fast")
    if report_json:
        push(args, "--report-json")

    append_optional_tool_filters(params, args)

    let result = run_kain_command(settings, args)
    return build_command_tool_result("kain " + command_name, result)

