fn create_file_if_missing(path: String, content: String, created_files: Array<String>) -> Unit:
    if file_exists(path):
        return
    ensure_parent_directory(path)
    write_file(path, content)
    push(created_files, path)

fn build_mcp_scaffold_readme() -> String:
    return "# KAIN MCP Scaffold\n\nThis workspace was initialized by the KAIN MCP server.\n\nFiles:\n- `MCP/server.kn`\n- `MCP/README.md`\n"

fn build_mcp_scaffold_server() -> String:
    return "// KAIN MCP server scaffold.\n// Replace this file with the experimental MCP router you want to host.\nfn main() -> Int:\n    println(\"KAIN MCP scaffold\")\n    return 0\n"

fn build_scripts_scaffold_readme() -> String:
    return "# KAIN Scripts Lane\n\nThis workspace was initialized with a KAIN scripts lane scaffold.\n\nSuggested folders:\n- `scripts/kain/`\n- `scripts/kain/actor/`\n"

fn build_scripts_scaffold_example() -> String:
    return "fn main() -> Int:\n    println(\"Hello from a KAIN script lane scaffold\")\n    return 0\n"

fn handle_workspace_init(settings: McpRuntimeSettings, params: Any) -> String:
    let path = json_get_string(params, "path")
    let profile = json_get_string(params, "profile")
    var name = ""
    if json_has(params, "name"):
        name = json_get_string(params, "name")

    if profile == "plain":
        var args: Array<String> = []
        push(args, "init")
        push(args, path)
        if len(name) > 0:
            push(args, "--name")
            push(args, name)
        let result = run_kain_command(settings, args)
        return build_command_tool_result("kain init", result)

    if profile == "omni":
        var omni_args: Array<String> = []
        push(omni_args, "omni")
        push(omni_args, "init")
        push(omni_args, path)
        let omni_result = run_kain_command(settings, omni_args)
        return build_command_tool_result("kain omni init", omni_result)

    if profile == "fabric_local":
        var fabric_args: Array<String> = []
        push(fabric_args, "fabric")
        push(fabric_args, "init")
        push(fabric_args, path)
        push(fabric_args, "--template")
        push(fabric_args, "local")
        let fabric_result = run_kain_command(settings, fabric_args)
        return build_command_tool_result("kain fabric init", fabric_result)

    if profile == "fabric_polyglot":
        var poly_args: Array<String> = []
        push(poly_args, "fabric")
        push(poly_args, "init")
        push(poly_args, path)
        push(poly_args, "--template")
        push(poly_args, "polyglot")
        let poly_result = run_kain_command(settings, poly_args)
        return build_command_tool_result("kain fabric init", poly_result)

    if profile == "mcp_server":
        if !settings.allow_writes:
            return build_tool_result("Writes are disabled by server policy.", "", true)

        var created_files: Array<String> = []
        let mcp_dir = path_join(path, "MCP")
        create_dir_all(mcp_dir)
        create_file_if_missing(path_join(mcp_dir, "README.md"), build_mcp_scaffold_readme(), created_files)
        create_file_if_missing(path_join(mcp_dir, "server.kn"), build_mcp_scaffold_server(), created_files)

        let structured = json_object_new()
        let created = json_array_new()
        for created_file in created_files:
            json_array_push(created, created_file)
        json_object_set(structured, "profile", profile)
        json_object_set(structured, "path", path)
        json_object_set(structured, "createdFiles", created)
        var summary = join(created_files, "\n")
        if len(summary) == 0:
            summary = "MCP scaffold already existed at " + path
        return build_tool_result(summary, json_string(structured), false)

    if profile == "script_lane":
        if !settings.allow_writes:
            return build_tool_result("Writes are disabled by server policy.", "", true)

        var created_script_files: Array<String> = []
        let scripts_dir = path_join(path, "scripts/kain")
        create_dir_all(scripts_dir)
        create_file_if_missing(path_join(scripts_dir, "README.md"), build_scripts_scaffold_readme(), created_script_files)
        create_file_if_missing(path_join(scripts_dir, "hello.kn"), build_scripts_scaffold_example(), created_script_files)

        let structured = json_object_new()
        let created = json_array_new()
        for created_file in created_script_files:
            json_array_push(created, created_file)
        json_object_set(structured, "profile", profile)
        json_object_set(structured, "path", path)
        json_object_set(structured, "createdFiles", created)
        var script_summary = join(created_script_files, "\n")
        if len(script_summary) == 0:
            script_summary = "Script lane scaffold already existed at " + path
        return build_tool_result(script_summary, json_string(structured), false)

    return build_tool_result("Unknown workspace profile: " + profile, "", true)

fn handle_tools_call(settings: McpRuntimeSettings, raw_request: String, specs: Array<ToolSpec>) -> String:
    let request = json_parse(raw_request)
    let params = json_get(request, "params")
    let tool_name = json_get_string(params, "name")
    let tool_args = if json_has(params, "arguments"):
        json_get(params, "arguments")
    else:
        json_object_new()

    if tool_name == "fs.list_directory":
        return build_jsonrpc_success(raw_request, handle_fs_list_directory(settings, tool_args))
    if tool_name == "fs.read_file":
        return build_jsonrpc_success(raw_request, handle_fs_read_file(settings, tool_args))
    if tool_name == "fs.write_file":
        return build_jsonrpc_success(raw_request, handle_fs_write_file(settings, tool_args))
    if tool_name == "fs.make_directory":
        return build_jsonrpc_success(raw_request, handle_fs_make_directory(settings, tool_args))
    if tool_name == "fs.get_connections":
        return build_jsonrpc_success(raw_request, handle_fs_get_connections(settings, tool_args))
    if tool_name == "kain.build":
        return build_jsonrpc_success(raw_request, handle_kain_build(settings, tool_args))
    if tool_name == "kain.import_rust":
        return build_jsonrpc_success(raw_request, handle_import_tool(settings, tool_args, "import-rust"))
    if tool_name == "kain.import_c":
        return build_jsonrpc_success(raw_request, handle_import_tool(settings, tool_args, "import-c"))
    if tool_name == "kain.import_ts":
        return build_jsonrpc_success(raw_request, handle_import_tool(settings, tool_args, "import-ts"))
    if tool_name == "kain.omni_init":
        return build_jsonrpc_success(raw_request, handle_omni_init(settings, tool_args))
    if tool_name == "kain.omni_build":
        return build_jsonrpc_success(raw_request, handle_omni_build(settings, tool_args))
    if tool_name == "kain.fabric_init":
        return build_jsonrpc_success(raw_request, handle_fabric_init(settings, tool_args))
    if tool_name == "kain.fabric_validate":
        return build_jsonrpc_success(raw_request, handle_fabric_validate(settings, tool_args))
    if tool_name == "kain.fabric_run":
        return build_jsonrpc_success(raw_request, handle_fabric_run(settings, tool_args))
    if tool_name == "workspace.init":
        return build_jsonrpc_success(raw_request, handle_workspace_init(settings, tool_args))

    return build_jsonrpc_error(raw_request, -32601, "Unknown tool: " + tool_name)

fn route_request(settings: McpRuntimeSettings, specs: Array<ToolSpec>, raw_request: String) -> String:
    let request = json_parse(raw_request)
    let method = json_get_string(request, "method")

    if !json_has(request, "id"):
        return ""

    if method == "initialize":
        var protocol_version = "2025-06-18"
        if json_has(request, "params"):
            let init_params = json_get(request, "params")
            if json_has(init_params, "protocolVersion"):
                protocol_version = select_protocol_version(json_get_string(init_params, "protocolVersion"))
        return build_jsonrpc_success(raw_request, build_initialize_result(protocol_version))

    if method == "notifications/initialized":
        return ""

    if method == "shutdown":
        return build_jsonrpc_success(raw_request, "null")

    if method == "ping":
        let ping_result = json_object_new()
        return build_jsonrpc_success(raw_request, json_string(ping_result))

    if method == "tools/list":
        return build_jsonrpc_success(raw_request, build_tools_list_result(specs))

    if method == "tools/call":
        return handle_tools_call(settings, raw_request, specs)

    return build_jsonrpc_error(raw_request, -32601, "Method not found: " + method)

actor McpRouter:
    state settings: McpRuntimeSettings = McpRuntimeSettings {
        repo_root: "",
        kain_bin: "",
        allow_writes: true,
        include_hidden: false,
        skip_dirs: [],
        timeout_ms: 1800000,
        max_list_entries: 250,
        max_connection_results: 80,
        default_read_limit: 200000,
    }
    state specs: Array<ToolSpec> = []

    on Dispatch(reply_to: P, raw_request: String):
        let response = route_request(self.settings, self.specs, raw_request)
        send reply_to.Reply(value = response)

fn main() -> Int:
    let settings = resolve_settings()
    let specs = build_tool_specs()
    let router = spawn McpRouter(settings = settings, specs = specs)

    eprintln("KAIN MCP server starting at " + settings.repo_root)

    while true:
        let raw_request = read_next_request_frame()
        if len(raw_request) == 0:
            break

        let response = ask_timeout(router, "Dispatch", raw_request, settings.timeout_ms)
        if len(response) > 0:
            write_response_frame(response)

    return 0
