// Experimental KAIN MCP server.
//
// Transport:
// - stdin/stdout for JSON-RPC frames
// - stderr for logs only
//
// Runtime contract:
// - the router is an actor so the request path stays actor-backed
// - file and CLI work are routed through explicit helper functions

struct McpRuntimeSettings:
    repo_root: String
    kain_bin: String
    allow_writes: Bool
    include_hidden: Bool
    skip_dirs: Array<String>
    timeout_ms: Int
    max_list_entries: Int
    max_connection_results: Int
    default_read_limit: Int

struct ToolSpec:
    name: String
    title: String
    description: String
    input_schema_json: String

fn parse_truthy_env(name: String, default_value: Bool) -> Bool:
    let raw = env(name).trim().to_ascii_lowercase()
    if len(raw) == 0:
        return default_value
    if raw == "1":
        return true
    if raw == "true":
        return true
    if raw == "yes":
        return true
    if raw == "on":
        return true
    return false

fn parse_csv_env(name: String, fallback_csv: String) -> Array<String>:
    let raw = env(name).trim()
    let source = if len(raw) == 0:
        fallback_csv
    else:
        raw

    var items: Array<String> = []
    let pieces = split(source, ",")
    for piece in pieces:
        let trimmed = piece.trim()
        if len(trimmed) > 0:
            push(items, trimmed)
    return items

fn resolve_repo_root() -> String:
    let primary = env("KAIN_REPO_ROOT").trim()
    if len(primary) > 0:
        return primary
    let fallback = env("KAIN_MCP_REPO_ROOT").trim()
    if len(fallback) > 0:
        return fallback
    return cwd()

fn resolve_kain_bin(repo_root: String) -> String:
    let override_bin = env("KAIN_MCP_KAIN_BIN").trim()
    if len(override_bin) > 0:
        return override_bin

    let local_binary = path_join(repo_root, "target/debug/kain")
    if file_exists(local_binary):
        return local_binary

    return "kain"

fn resolve_settings() -> McpRuntimeSettings:
    let repo_root = resolve_repo_root()
    let kain_bin = resolve_kain_bin(repo_root)
    let allow_writes = parse_truthy_env("KAIN_MCP_ALLOW_WRITES", true)
    let include_hidden = parse_truthy_env("KAIN_MCP_INCLUDE_HIDDEN", false)
    let skip_dirs = parse_csv_env(
        "KAIN_MCP_SKIP_DIRS",
        ".git,target,node_modules,dist,build,generated,out,coverage,.cache,.venv",
    )

    return McpRuntimeSettings {
        repo_root: repo_root,
        kain_bin: kain_bin,
        allow_writes: allow_writes,
        include_hidden: include_hidden,
        skip_dirs: skip_dirs,
        timeout_ms: 1800000,
        max_list_entries: 250,
        max_connection_results: 80,
        default_read_limit: 200000,
    }

fn select_protocol_version(requested: String) -> String:
    if requested == "2025-11-25":
        return requested
    if requested == "2025-06-18":
        return requested
    if requested == "2025-03-26":
        return requested
    return "2025-06-18"

