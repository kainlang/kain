use std::runtime
use memory::smoke_memory_lane
use ownership::smoke_ownership_lane

fn main() -> Int with Unsafe:
    let boot = runtime_init()
    if boot != 0:
        return 100 + boot

    let memory_status = smoke_memory_lane()
    if memory_status != 0:
        let _shutdown_memory = runtime_shutdown()
        return 10 + memory_status

    let ownership_status = smoke_ownership_lane()
    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown
    if ownership_status != 0:
        return 20 + ownership_status
    return 0
