include train_gpt2.h as tg2

// Kain-facing wrapper around the train_gpt2 C ABI lane.
// This keeps policy in Kain while C handles the compact lexical/statistical core.

pub fn gpt2_error_route(text: String, lane_mask_hint: Int) -> Int:
    return tg2_kain_route(text, lane_mask_hint)

pub fn gpt2_error_score(text: String, lane_mask_hint: Int, code_hint: Int, repair_hint: Int) -> Int:
    return tg2_kain_repair_score(text, lane_mask_hint, code_hint, repair_hint)

pub fn gpt2_error_similarity(lhs: String, rhs: String) -> Int:
    return tg2_kain_similarity(lhs, rhs)

pub fn gpt2_repair_decision(query: String, candidate: String, lane_mask_hint: Int, code_hint: Int, repair_hint: Int) -> Int:
    let query_score = gpt2_error_score(query, lane_mask_hint, code_hint, repair_hint)
    let candidate_score = gpt2_error_score(candidate, lane_mask_hint, code_hint, repair_hint)
    let similarity = gpt2_error_similarity(query, candidate)
    let route = gpt2_error_route(query, lane_mask_hint)
    return query_score + candidate_score + similarity + route * 31

fn main() -> Int:
    let query = "// @expected_code: KAIN-SHADER-0003\nshader compute UniformConflict:"
    let candidate = "// @expected_repair: unique_binding_slot\nuniform input_a: Vec4 @0"
    let route = gpt2_error_route(query, 1 << 4)
    let score = gpt2_error_score(query, 1 << 4, 3, 11)
    let sim = gpt2_error_similarity(query, candidate)
    let decision = gpt2_repair_decision(query, candidate, 1 << 4, 3, 11)
    if route <= 0:
        return 1
    if score <= 0:
        return 2
    if sim < 0:
        return 3
    if decision <= 0:
        return 4
    println("train_gpt2_c_abi_ok")
    return 0
