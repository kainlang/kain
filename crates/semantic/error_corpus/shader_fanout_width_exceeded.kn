// @expected_code: KAIN-SHADER-0009
// @expected_mode: ShaderResourceContract
// @expected_repair: reduce_fanout_width

// A fanout operation whose width exceeds the GPU's maximum wavefront size.
shader compute WideFanout:
    uniform data: Vec4 @0
    fn main():
        fanout data:
            mem_store(data, 0, "Int")
        return
