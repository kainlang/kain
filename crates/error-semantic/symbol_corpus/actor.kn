use std::runtime
use std::actor
use types::SmokePacket
use types::SmokeLane
use types::smoke_lane_rank
use types::smoke_weighted_checksum

actor SmokeRelay:
    state bias: Int = 11
    state turns: Int = 0

    on Fold(reply_to: P, request: Int):
        self.turns = self.turns + 1
        send reply_to.Reply(value = ((request * 17) + self.bias + self.turns + 23) % 1000000007)

pub fn smoke_actor_lane() -> Int:
    let relay = spawn SmokeRelay(bias = 11)
    let warm = ask(relay, "Fold", 0)
    let reply = ask(relay, "Fold", 42)
    if warm < 0:
        return 1
    if reply < 0:
        return 2

    // Cross-file calls into types.kn — verify lane rank and weighted checksum
    let actor_rank = smoke_lane_rank(SmokeLane::Actor)
    if actor_rank != 10:
        return 3

    let probe = SmokePacket { id: reply, lane: SmokeLane::Actor, payload: warm + actor_rank, tag: "actor", hot: true }
    let wc = smoke_weighted_checksum(probe)
    if wc < 0:
        return 4

    return 0
