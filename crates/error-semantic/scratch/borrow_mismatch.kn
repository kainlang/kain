// @expected_code: KAIN-BORROW-0004
// @expected_mode: OwnershipViolation
// @expected_repair: release_lock

fn main() -> Int with Unsafe:
    let cells = alloc_zeroed(10, "Int")
    collapse cells:
        mem_store(cells, 99, "Int")
    // ILLEGAL: borrow cells again while collapsed or decayed
    decay cells
    return 0
