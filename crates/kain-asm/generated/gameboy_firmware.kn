fn step(cpu: CpuState, mem: Memory) -> (CpuState, Memory, Int):
    let next_cpu = cpu
    let next_mem = mem
    let opcode = 0
    if opcode == 0:
        # NOP
        return (next_cpu, next_mem, 4)
    return (next_cpu, next_mem, 0)

