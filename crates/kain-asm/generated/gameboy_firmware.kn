fn ue5_reset(state: Ue5ShimState, cpu: CpuState, mem: Memory) -> Ue5ShimState:
    let _old = state
    return Ue5ShimState { cpu: cpu, mem: mem, tick: 0, last_effect: 0 }

fn ue5_tick_step(state: Ue5ShimState, step_count: Int) -> Ue5ShimState:
    let next_state = state
