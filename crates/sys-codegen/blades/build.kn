// ============================================================================
//  LLVM CODEGEN VERIFICATION — Build Authority
//
//  Three parallel lanes extract and verify the LLVM codegen:
//    alpha  — Types, Layout & Casts
//    bravo  — Memory, Ownership & Control Flow
//    charlie — Runtime Bridge, Machine Stones & Specials
//
//  Note: Builder DSL chaining across lines is not yet supported by the parser.
//  Use single-expression chaining or sequential mutation instead.
// ============================================================================

use std::build

fn build(ctx: BuildContext) -> BuildGraph:
    let app = project("codegen-verify").kind("kain_executable").version("0.1.0").description("LLVM codegen extraction and formal verification pipeline").entry("src/main.kn").source_root("src").module_root("src").target("llvm").artifact_root(".kain/out").cache_root(".kain/cache/build").profile("debug")

    let sources = source_set("verify-sources").glob("src/**/*.kn").file("build.kn")

    let check = check_task("check-llvm").project(app).target("llvm").inputs(sources)

    let exe = native_executable("root-executable").project(app).output("$blade/codegen-verify.exe").requires(check)

    return build_graph().project(app).sources(sources).task(check).task(exe)
