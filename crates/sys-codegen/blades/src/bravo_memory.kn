        name: "compile_cpu_cache_flush", line_start: 3158, line_end: 3189, category: CATEGORY_ATOMIC,
        description: "Compiles clflush via volatile inline asm, x86_64-only"
    },
]

// ============================================================================
//  PARSER HELPERS — work with Array<Int> (raw bytes) for Rust source analysis
// ============================================================================

fn is_whitespace_byte(b: Int) -> Bool:
    return b == 32 or b == 9 or b == 13 or b == 10

fn is_alpha_byte(b: Int) -> Bool:
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95

fn is_ident_byte(b: Int) -> Bool:
    return is_alpha_byte(b) or (b >= 48 and b <= 57) or b == 95

fn byte_to_char(b: Int) -> String:
    // Single-byte to single-char mapping for ASCII
    // Uses text_chr which converts a codepoint to a string
    return text_chr(b)

fn extract_word_at(bytes: Array<Int>, start: Int) -> String:
    var result = ""
    var idx = start
    while idx < len(bytes) and is_ident_byte(bytes[idx]):
        result = result + byte_to_char(bytes[idx])
        idx = idx + 1
    return result

fn bytes_equal_at(bytes: Array<Int>, offset: Int, pattern: String) -> Bool:
    var j = 0
    while j < len(pattern):
        if offset + j >= len(bytes):
            return false
        let pb = text_ord(text_substring_string(pattern, j, 1))
        if bytes[offset + j] != pb:
            return false
        j = j + 1
    return true

fn line_number_of(bytes: Array<Int>, offset: Int) -> Int:
    var line_num = 1
    var idx = 0
    while idx < offset and idx < len(bytes):
        if bytes[idx] == 10:
            line_num = line_num + 1
        idx = idx + 1
    return line_num

fn skip_whitespace(bytes: Array<Int>, start: Int) -> Int:
    var idx = start
    while idx < len(bytes) and is_whitespace_byte(bytes[idx]):
        idx = idx + 1
    return idx

// Find "fn " keyword at Rust function declarations
fn find_fn_declarations(bytes: Array<Int>) -> Array<Int>:
    var positions: Array<Int> = []
    var idx = 0
    while idx + 3 < len(bytes):
        // Look for "fn " after whitespace or at line start
        if bytes[idx] == 102 and bytes[idx+1] == 110 and (bytes[idx+2] == 32 or bytes[idx+2] == 10):
            let prev = if idx > 0: bytes[idx-1] else: 32
            if is_whitespace_byte(prev) or prev == 10 or prev == 13:
                let fn_name = extract_word_at(bytes, idx + 3)
                if len(fn_name) > 0:
                    push(positions, idx)
        idx = idx + 1
    return positions

fn extract_function_name(bytes: Array<Int>, fn_pos: Int) -> String:
    var idx = fn_pos + 2  // skip "fn"
    while idx < len(bytes) and is_whitespace_byte(bytes[idx]) and bytes[idx] != 10:
        idx = idx + 1
    return extract_word_at(bytes, idx)

fn extract_function_signature(bytes: Array<Int>, fn_pos: Int) -> String:
    var sig_text = ""
    var idx = fn_pos
    var found_end = false
    while idx < len(bytes) and idx < fn_pos + 8000 and found_end == false:
        if bytes[idx] == 123:  // '{' — start of body
            found_end = true
        elif bytes[idx] == 59:  // ';' — extern decl, no body
            found_end = true
        elif found_end == false:
            if bytes[idx] == 10:
                sig_text = sig_text + " "
            else:
                sig_text = sig_text + byte_to_char(bytes[idx])
        idx = idx + 1
    if len(sig_text) > 250:
        sig_text = text_substring_string(sig_text, 0, 250) + "..."
    return sig_text

fn find_function_end_line(bytes: Array<Int>, fn_pos: Int) -> Int:
    var depth = 0
    var found_open = false
    var start_line = line_number_of(bytes, fn_pos)
    var idx = fn_pos
    while idx < len(bytes):
        if bytes[idx] == 123:  // '{'
            depth = depth + 1
            found_open = true
        elif bytes[idx] == 125:  // '}'
            depth = depth - 1
            if found_open and depth == 0:
                return line_number_of(bytes, idx)
        elif bytes[idx] == 59 and found_open == false:
            return line_number_of(bytes, idx)
        idx = idx + 1
    return start_line + 5  // fallback

fn extract_return_type(sig: String) -> String:
    let arrow = text_find(text_from(sig), "->")
    if arrow < 0:
        return "void"
    var after = text_trim_string(text_substring_string(sig, arrow + 2, len(sig) - arrow - 2))
    // Take first word: iterate until non-alpha
    var i = 0
    var result = ""
    while i < len(after) and is_alpha_byte(text_ord(text_substring_string(after, i, 1))):
        result = result + text_substring_string(after, i, 1)
        i = i + 1
    if len(result) > 0:
        return result
    return after

fn extract_params(sig: String) -> Array<ParamMeta>:
    var params: Array<ParamMeta> = []
    let open = text_find(text_from(sig), "(")
    let close = text_find(text_from(sig), ")")
    if open < 0 or close < 0 or close <= open:
        return params
    let param_str = text_substring_string(sig, open + 1, close - open - 1)
    if len(text_trim_string(param_str)) == 0:
        return params
    let parts = text_split_string(param_str, ",")
    var pi = 0
    while pi < len(parts):
        let part = text_trim_string(parts[pi])
        if len(part) > 0:
            var is_self = false
            var is_mut = false
            var pname = ""
            var ptype = part

            if text_contains_string(part, "&mut self"):
                is_self = true
                is_mut = true
                pname = "self"
                ptype = "&mut self"
            elif text_contains_string(part, "&self"):
                is_self = true
                pname = "self"
                ptype = "&self"
            elif text_contains_string(part, "mut self"):
                is_self = true
                is_mut = true
                pname = "self"
                ptype = "mut self"
            elif text_starts_with_string(part, "self"):
                is_self = true
                pname = "self"
                ptype = "self"
            else:
                let colon = text_find(text_from(part), ":")
                if colon >= 0:
                    pname = text_trim_string(text_substring_string(part, 0, colon))
                    ptype = text_trim_string(text_substring_string(part, colon + 1, len(part) - colon - 1))

            push(params, ParamMeta {
                name: pname,
                ty: ptype,
                is_self: is_self,
                is_mut: is_mut,
            })
        pi = pi + 1
    return params

// ============================================================================
//  EXTRACTION — parse the source and produce FunctionMeta array
// ============================================================================

pub fn extract_function_meta(target: ExtractionTarget) -> Array<FunctionMeta>:
    var results: Array<FunctionMeta> = []
    let bytes = target.source_bytes
    let positions = find_fn_declarations(bytes)

    var i = 0
    while i < len(positions):
        let fn_pos = positions[i]
        let name = extract_function_name(bytes, fn_pos)
        if len(name) == 0:
            i = i + 1
            continue

        let sig = extract_function_signature(bytes, fn_pos)
        let line_start = line_number_of(bytes, fn_pos)
        let line_end = find_function_end_line(bytes, fn_pos)
        let ret_ty = extract_return_type(sig)
        let params = extract_params(sig)
        let is_pub = text_contains_string(sig, "pub fn") or text_contains_string(sig, "pub(crate) fn")

        push(results, FunctionMeta {
            name: name,
            line_start: line_start,
            line_end: line_end,
            signature: sig,
            return_type: ret_ty,
            params: params,
            doc_comment: "",
            is_pub: is_pub,
            is_impl_method: true,
            impl_target: "",
            domain: "memory",
        })

        i = i + 1

    return results

// ============================================================================
//  FUNCTION SELECTION — filter extraction results by domain categories
// ============================================================================

fn list_contains_name(list: Array<FunctionDescriptor>, name: String) -> Bool:
    var i = 0
    while i < len(list):
        if list[i].name == name:
            return true
        i = i + 1
    return false

pub fn matches_bravo_domain(meta: FunctionMeta) -> Bool:
    let name = meta.name

    if list_contains_name(EPHEMERAL_FUNCTIONS, name):   return true
    if list_contains_name(CANDIDATE_FUNCTIONS, name):    return true
    if list_contains_name(I64_TRACKING_FUNCTIONS, name): return true
    if list_contains_name(HEAP_RC_FUNCTIONS, name):     return true
    if list_contains_name(SCOPE_FUNCTIONS, name):        return true
    if list_contains_name(CONTROL_FUNCTIONS, name):      return true
    if list_contains_name(ATOMIC_FUNCTIONS, name):      return true

    return false

// ============================================================================
//  HELPER — push all elements from one array into another
// ============================================================================

fn bravo_push_all(dest: Array<Invariant>, src: Array<Invariant>):
    var j = 0
    while j < len(src):
        push(dest, src[j])
        j = j + 1

// ============================================================================
//  INVARIANT DEFINITIONS
//
//  Each invariant represents a property that must hold for correctness.
//  Categories: ephemeral_lowering, ephemeral_candidate, heap_rc, scope_lifetime,
//  control_flow, atomic_fence.
// ============================================================================

fn make_invariant(
    name: String, description: String, category: String,
    smt2: String, proof_ref: String
) -> Invariant:
    return Invariant {
        name: name,
        description: description,
        category: category,
        smt2_skeleton: smt2,
        is_proven: false,
        proof_ref: proof_ref,
    }

// ============================================================================
//  EPHEMERAL LOWERING INVARIANTS
// ============================================================================

pub fn define_ephemeral_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []

    // EPH-001: SSA-lowered variable must never have its address taken
    push(invs, make_invariant(
        "EPH-001",
        "A variable lowered as SSA must never have its address taken.",
        CATEGORY_EPHEMERAL_LOWER,
        "(set-logic QF_LIA)\n(declare-const ssa_lowered Bool)\n(declare-const addr_taken Bool)\n(assert ssa_lowered)\n(assert addr_taken)\n(check-sat)",
        ""
    ))

    // EPH-002: Alloca must dominate all uses
    push(invs, make_invariant(
        "EPH-002",
        "An alloca emitted for a variable must dominate all loads/stores.",
        CATEGORY_EPHEMERAL_LOWER,
        "(set-logic QF_LIA)\n(declare-const alloca_line Int)\n(declare-const use_line Int)\n(assert (>= use_line alloca_line))\n(assert (< use_line alloca_line))\n(check-sat)",
        ""
    ))

    // EPH-003: Ephemeral candidates must not escape their scope
    push(invs, make_invariant(
        "EPH-003",
        "An ephemeral candidate must not be captured by ref, passed to escape-prone functions, or stored to heap.",
        CATEGORY_EPHEMERAL_LOWER,
        "(set-logic QF_LIA)\n(declare-const is_ephemeral Bool)\n(declare-const escapes_scope Bool)\n(assert is_ephemeral)\n(assert escapes_scope)\n(check-sat)",
        ""
    ))

    // EPH-004: Pointer coercion preserves memory access width
    push(invs, make_invariant(
        "EPH-004",
        "Bitcast must preserve the storage width; inttoptr must recover the address.",
        CATEGORY_EPHEMERAL_LOWER,
        "(set-logic QF_BV)\n(declare-const src_ptr (_ BitVec 64))\n(declare-const typed_ptr (_ BitVec 64))\n(assert (= typed_ptr (bvand src_ptr #xFFFFFFFFFFFFFFFF)))\n(assert (not (= typed_ptr src_ptr)))\n(check-sat)",
        ""
    ))

    // EPH-005: Forwarding store/load pair must see same value
    push(invs, make_invariant(
        "EPH-005",
        "When a forwarded memory store/load pair matches, the loaded value must equal the stored value.",
        CATEGORY_EPHEMERAL_LOWER,
        "(set-logic QF_BV)\n(declare-const stored (_ BitVec 64))\n(declare-const loaded (_ BitVec 64))\n(assert (= stored loaded))\n(assert (not (= loaded stored)))\n(check-sat)",
        ""
    ))

    // EPH-006: Ephemeral storage layout keeps element offsets aligned
    push(invs, make_invariant(
        "EPH-006",
        "The element type's byte width must divide the alloca offset.",
        CATEGORY_EPHEMERAL_LOWER,
        "(set-logic QF_LIA)\n(declare-const byte_width Int)\n(declare-const offset Int)\n(assert (> byte_width 0))\n(assert (= (mod offset byte_width) 0))\n(check-sat)",
        "z3/proofs/generated/memory-ephemeral-typed-array-stack-layout-keeps-element-offsets-aligned.yaml"
    ))

    return invs

// ============================================================================
//  HEAP & RC MANAGEMENT INVARIANTS
// ============================================================================

pub fn define_heap_rc_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []

    // RC-001: Every retain must be paired with a release
    push(invs, make_invariant(
        "RC-001",
        "For every retain on a value, there must be a corresponding release. No leak, no double-free.",
        CATEGORY_HEAP_RC,
        "(set-logic QF_LIA)\n(declare-fun retain_count () Int)\n(declare-fun release_count () Int)\n(assert (= retain_count release_count))\n(assert (not (= retain_count release_count)))\n(check-sat)",
        ""
    ))

    // RC-002: No retain on new objects (RC=1)
    push(invs, make_invariant(
        "RC-002",
        "is_new_object must return true only for freshly constructed objects. Double-retaining a new object would leak.",
        CATEGORY_HEAP_RC,
        "(set-logic QF_LIA)\n(declare-const is_new Bool)\n(declare-const emitted_retain Bool)\n(assert is_new)\n(assert emitted_retain)\n(check-sat)",
        ""
    ))

    // RC-003: Raw pointers must stay RC-neutral
    push(invs, make_invariant(
        "RC-003",
        "Raw pointers must never route through rc_retain/rc_release.",
        CATEGORY_HEAP_RC,
        "(set-logic QF_LIA)\n(declare-const is_raw Bool)\n(declare-const rc_retain_emitted Bool)\n(assert is_raw)\n(assert rc_retain_emitted)\n(check-sat)",
        "z3/proofs/memory-rc-escape-transfer-balance.yaml"
    ))

    // RC-004: Release on struct must recursively release pointer fields
    push(invs, make_invariant(
        "RC-004",
        "emit_release on a struct must recursively release each pointer field.",
        CATEGORY_HEAP_RC,
        "(set-logic QF_LIA)\n(declare-const num_releases Int)\n(declare-const num_ptr_fields Int)\n(assert (>= num_releases num_ptr_fields))\n(check-sat)",
        ""
    ))

    // RC-005: Escape transfer retains before scope cleanup releases
    push(invs, make_invariant(
        "RC-005",
        "compile_block_with_result must emit retain BEFORE scope exit destroys locals.",
        CATEGORY_HEAP_RC,
        "(set-logic QF_LIA)\n(declare-const retain_ir_line Int)\n(declare-const scope_exit_ir_line Int)\n(assert (< retain_ir_line scope_exit_ir_line))\n(check-sat)",
        ""
    ))

    return invs

// ============================================================================
//  SCOPE LIFETIME INVARIANTS
// ============================================================================

pub fn define_scope_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []

    // SCP-001: Variables must be cleaned up before scope exit
    push(invs, make_invariant(
        "SCP-001",
        "emit_scope_cleanup_for_vars must release every variable in the current scope.",
        CATEGORY_SCOPE,
        "(set-logic QF_LIA)\n(declare-const vars_in_scope Int)\n(declare-const vars_cleaned Int)\n(assert (= vars_in_scope vars_cleaned))\n(check-sat)",
        ""
    ))

    // SCP-002: Deferred expressions must execute in reverse order (LIFO)
    push(invs, make_invariant(
        "SCP-002",
        "emit_current_scope_defers must iterate defer_scopes in reverse.",
        CATEGORY_SCOPE,
        "(set-logic QF_LIA)\n(declare-const defer_a_pos Int)\n(declare-const defer_b_pos Int)\n(declare-const defer_a_line Int)\n(declare-const defer_b_line Int)\n(assert (> defer_a_pos defer_b_pos))\n(assert (> defer_a_line defer_b_line))\n(check-sat)",
        ""
    ))

    // SCP-003: Borrowed locals must be exempt from cleanup
    push(invs, make_invariant(
        "SCP-003",
        "Scope cleanup must skip variables in self.borrowed_locals.",
        CATEGORY_SCOPE,
        "(set-logic QF_LIA)\n(declare-const is_borrowed Bool)\n(declare-const emitted_release Bool)\n(assert is_borrowed)\n(assert emitted_release)\n(check-sat)",
        ""
    ))

    return invs

// ============================================================================
//  CONTROL FLOW INVARIANTS
// ============================================================================

pub fn define_control_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []

    // CTL-001: All paths through if/else must converge to consistent PHI
    push(invs, make_invariant(
        "CTL-001",
        "compile_if_statement must generate PHI nodes that reconcile values from all branch targets.",
        CATEGORY_CONTROL,
        "(set-logic QF_LIA)\n(declare-const then_ty Int)\n(declare-const else_ty Int)\n(assert (= then_ty else_ty))\n(assert (not (= then_ty else_ty)))\n(check-sat)",
        ""
    ))

    // CTL-002: Loop headers must dominate loop bodies
    push(invs, make_invariant(
        "CTL-002",
        "The entry block of a while/for/loop must dominate all blocks in the loop body.",
        CATEGORY_CONTROL,
        "(set-logic QF_LIA)\n(declare-const header_bb Int)\n(declare-const body_bb Int)\n(assert (>= body_bb header_bb))\n(check-sat)",
        ""
    ))

    // CTL-003: Match arms must be exhaustive
    push(invs, make_invariant(
        "CTL-003",
        "compile_stmt for match expressions must handle all enum variants.",
        CATEGORY_CONTROL,
        "(set-logic QF_LIA)\n(declare-const num_variants Int)\n(declare-const num_arms Int)\n(assert (>= num_arms num_variants))\n(check-sat)",
        ""
    ))

    // CTL-004: Return value retain must precede scope exit
    push(invs, make_invariant(
        "CTL-004",
        "compile_block_with_result must emit retain before emit_scope_exit_except.",
        CATEGORY_CONTROL,
        "(set-logic QF_LIA)\n(declare-const retain_idx Int)\n(declare-const exit_idx Int)\n(assert (< retain_idx exit_idx))\n(assert (>= retain_idx exit_idx))\n(check-sat)",
        ""
    ))

    // CTL-005: All blocks must push/pop matching scopes
    push(invs, make_invariant(
        "CTL-005",
        "compile_block must have matching push/pop on all paths including error paths.",
        CATEGORY_CONTROL,
        "(set-logic QF_LIA)\n(declare-const pushes Int)\n(declare-const pops Int)\n(assert (= pushes pops))\n(check-sat)",
        ""
    ))

    return invs

// ============================================================================
//  ATOMIC & FENCE INVARIANTS
// ============================================================================

pub fn define_atomic_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []

    // ATM-001: Store ordering must never be Acquire or AcqRel
    push(invs, make_invariant(
        "ATM-001",
        "Atomic stores must only use Relaxed (0), Release (2), or SeqCst (4) ordering.",
        CATEGORY_ATOMIC,
        "(set-logic QF_LIA)\n(declare-const ordering Int)\n(assert (>= ordering 0))\n(assert (<= ordering 4))\n(assert (or (= ordering 0) (= ordering 2) (= ordering 4)))\n(assert (not (or (= ordering 0) (= ordering 2) (= ordering 4))))\n(check-sat)",
        "z3/proofs/memory-atomic-store-validation-rejects-acquire-and-acqrel.yaml"
    ))

    // ATM-002: CAS failure ordering <= success ordering
    push(invs, make_invariant(
        "ATM-002",
        "For atomic compare-exchange, failure ordering must be <= success ordering.",
        CATEGORY_ATOMIC,
        "(set-logic QF_LIA)\n(declare-const succ Int)\n(declare-const fail Int)\n(assert (>= succ fail))\n(assert (< succ fail))\n(check-sat)",
        "z3/proofs/memory-atomic-compare-exchange-validation-rejects-invalid-failure-orderings.yaml"
    ))

    // ATM-003: Inline asm constraints must match operand count
    push(invs, make_invariant(
        "ATM-003",
        "emit_inline_asm_call must ensure constraint count equals operand count.",
        CATEGORY_ATOMIC,
        "(set-logic QF_LIA)\n(declare-const num_constraints Int)\n(declare-const num_operands Int)\n(assert (= num_constraints num_operands))\n(assert (not (= num_constraints num_operands)))\n(check-sat)",
        ""
    ))

    // ATM-004: x86_64-only operations must gate on target
    push(invs, make_invariant(
        "ATM-004",
        "compile_inline_asm and compile_cpu_cache_flush must check target_is_x86_64().",
        CATEGORY_ATOMIC,
        "(set-logic QF_LIA)\n(declare-const is_x86_64 Bool)\n(declare-const asm_emitted Bool)\n(assert (not is_x86_64))\n(assert asm_emitted)\n(check-sat)",
        ""
    ))

    return invs

// ============================================================================
//  Z3 PROOF PACK GENERATOR
// ============================================================================

fn make_pack_id(inv_name: String) -> String:
    let lowered = text_lower(inv_name)
    let cleaned = text_replace_string(lowered, " ", "_")
    return "kain.sys.codegen.llvm.proofs." + cleaned + ".generated"

pub fn generate_proof_pack_for_invariant(
    inv: Invariant,
    source_path: String,
    source_symbol: String,
    source_line: Int,
) -> ProofPackSkeleton:
    return ProofPackSkeleton {
        pack_id: make_pack_id(inv.name),
        kind: "check_smt2",
        description: inv.description,
        tags: ["llvm", "memory", "ownership", "generated", inv.category],
        source_path: source_path,
        source_symbol: source_symbol,
        source_line: source_line,
        smt2: inv.smt2_skeleton,
        needs_materialize: true,
    }

// ============================================================================
//  MATERIALIZATION — write proof pack skeleton as YAML string
// ============================================================================

pub fn materialize_proof_pack_to_yaml(skeleton: ProofPackSkeleton) -> String:
    var yml = "version: 1\n"
    yml = yml + "id: " + skeleton.pack_id + "\n"
    yml = yml + "kind: " + skeleton.kind + "\n"
    yml = yml + "description: >\n  " + skeleton.description + "\n"
    yml = yml + "tags:\n"
    var t = 0
    while t < len(skeleton.tags):
        yml = yml + "  - " + skeleton.tags[t] + "\n"
        t = t + 1
    yml = yml + "source:\n"
    yml = yml + "  path: " + skeleton.source_path + "\n"
    yml = yml + "  symbol: " + skeleton.source_symbol + "\n"
    yml = yml + "  start_line: " + str(skeleton.source_line) + "\n"
    yml = yml + "  reason: auto-generated by bravo_memory verification engine\n"
    yml = yml + "case:\n"
    yml = yml + "  smt2: |\n"
    let smt2_lines = text_split_string(skeleton.smt2, "\n")
    var li = 0
    while li < len(smt2_lines):
        yml = yml + "    " + smt2_lines[li] + "\n"
        li = li + 1
    yml = yml + "  include_model: false\n"
    yml = yml + "  include_stats: false\n"
    return yml

// ============================================================================
//  REPORT DRIVER — main entry point for the BRAVO lane
// ============================================================================

pub fn run_bravo(target: ExtractionTarget) -> VerificationReport:
    println("[BRAVO] Extracting memory, ownership & control flow functions...")

    // Step 1: Extract function metadata from source
    let all_meta = extract_function_meta(target)

    // Filter to bravo domain functions
    var bravo_meta: Array<FunctionMeta> = []
    var i = 0
    while i < len(all_meta):
        if matches_bravo_domain(all_meta[i]):
            push(bravo_meta, all_meta[i])
        i = i + 1

    target.num_functions = len(bravo_meta)
    println("[BRAVO] Found " + str(len(bravo_meta)) + " functions in domain")

    // Step 2: Define all invariants
    var all_invariants: Array<Invariant> = []

    bravo_push_all(all_invariants, define_ephemeral_invariants())
    bravo_push_all(all_invariants, define_heap_rc_invariants())
    bravo_push_all(all_invariants, define_scope_invariants())
    bravo_push_all(all_invariants, define_control_invariants())
    bravo_push_all(all_invariants, define_atomic_invariants())

    println("[BRAVO] Defined " + str(len(all_invariants)) + " invariants across 5 categories")

    // Step 3: Generate proof pack skeletons
    var proof_packs: Array<ProofPackSkeleton> = []

    i = 0
    while i < len(bravo_meta):
        let meta = bravo_meta[i]
        var k = 0
        while k < len(all_invariants):
            let inv = all_invariants[k]
            var matched = false

            let cat = inv.category
            if cat == CATEGORY_EPHEMERAL_LOWER or cat == CATEGORY_EPHEMERAL_CAND:
                if list_contains_name(EPHEMERAL_FUNCTIONS, meta.name): matched = true
                if list_contains_name(CANDIDATE_FUNCTIONS, meta.name):  matched = true
            elif cat == CATEGORY_HEAP_RC or cat == CATEGORY_SCOPE:
                if list_contains_name(HEAP_RC_FUNCTIONS, meta.name): matched = true
                if list_contains_name(SCOPE_FUNCTIONS, meta.name):    matched = true
            elif cat == CATEGORY_CONTROL:
                if list_contains_name(CONTROL_FUNCTIONS, meta.name): matched = true
            elif cat == CATEGORY_ATOMIC:
                if list_contains_name(ATOMIC_FUNCTIONS, meta.name): matched = true
            elif cat == CATEGORY_I64_TRACK:
                if list_contains_name(I64_TRACKING_FUNCTIONS, meta.name): matched = true

            if matched:
                let pack = generate_proof_pack_for_invariant(
                    inv, target.source_path, meta.name, meta.line_start
                )
                push(proof_packs, pack)
            k = k + 1
        i = i + 1

    println("[BRAVO] Generated " + str(len(proof_packs)) + " proof pack skeletons")

    // Step 4: Build and return report
    var report = empty_report("bravo", "memory")
    report.invariants_found = len(all_invariants)
    report.invariants_proven = 0
    report.invariants_failed = 0
    report.proof_packs_generated = len(proof_packs)

    // Step 5: Print per-function summary
    i = 0
    while i < len(bravo_meta):
        let meta = bravo_meta[i]
        println("  [OK] " + meta.name + " (lines " + str(meta.line_start) + "-" + str(meta.line_end) + ")")
        i = i + 1

    return report

// ============================================================================
//  INSPECTION HELPERS — display function metadata for debugging
// ============================================================================

fn print_catalog_section(title: String, list: Array<FunctionDescriptor>):
    println(title + " (" + str(len(list)) + " functions)")
    var i = 0
    while i < len(list):
        let f = list[i]
        println("  " + f.name + " (L" + str(f.line_start) + "-" + str(f.line_end) + ")")
        i = i + 1

pub fn print_function_catalog():
    println("=== BRAVO Function Catalog ===")
    println("")
    print_catalog_section("--- Ephemeral Storage Lowering", EPHEMERAL_FUNCTIONS)
    println("")
    print_catalog_section("--- Ephemeral Candidate Tracking", CANDIDATE_FUNCTIONS)
    println("")
    print_catalog_section("--- I64 Literal & Loop Tracking", I64_TRACKING_FUNCTIONS)
    println("")
    print_catalog_section("--- Heap Allocation & RC Management", HEAP_RC_FUNCTIONS)
    println("")
    print_catalog_section("--- Scope Lifetime Management", SCOPE_FUNCTIONS)
    println("")
    print_catalog_section("--- Control Flow Compilation", CONTROL_FUNCTIONS)
    println("")
    print_catalog_section("--- Atomic & Fence Operations", ATOMIC_FUNCTIONS)
    println("")
    let total = len(EPHEMERAL_FUNCTIONS) + len(CANDIDATE_FUNCTIONS) + len(I64_TRACKING_FUNCTIONS) + len(HEAP_RC_FUNCTIONS) + len(SCOPE_FUNCTIONS) + len(CONTROL_FUNCTIONS) + len(ATOMIC_FUNCTIONS)
    println("TOTAL: " + str(total) + " functions cataloged")

// ============================================================================
//  SUMMARY
// ============================================================================

pub fn print_summary(report: VerificationReport):
    println("")
    println("=== BRAVO Verification Summary ===")
    println("  Invariants defined:       " + str(report.invariants_found))
    println("  Invariants proven:        " + str(report.invariants_proven))
    println("  Invariants failed:        " + str(report.invariants_failed))
    println("  Proof packs generated:    " + str(report.proof_packs_generated))
    println("  Errors:                   " + str(len(report.errors)))
    println("  Warnings:                 " + str(len(report.warnings)))
    println("")

    if len(report.errors) > 0:
        println("Errors:")
        var ei = 0
        while ei < len(report.errors):
            println("  [ERROR] " + report.errors[ei])
            ei = ei + 1

    if len(report.warnings) > 0:
        println("Warnings:")
        var wi = 0
        while wi < len(report.warnings):
            println("  [WARN]  " + report.warnings[wi])
            wi = wi + 1
