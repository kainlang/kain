// ============================================================================
//  bravo_memory.kn — Memory, Ownership & Control Flow Verification Engine
//
//  Domain: Extracts logic from codegen_llvm/mod.rs, defines invariants, and
//  generates Z3 proof pack skeletons for ephemeral storage lowering, heap/RC
//  management, scope lifetime, control flow, and atomics/fences.
//
//  Design: Layer 0 (fn + struct + enum). Value semantics. The verification
//  pipeline is a read-only analysis engine — no concurrent state, no journaled
//  mutation, no UI. Uses fn composition with structured reports.
//
//  Ladder Decision:
//    - No world (no shared concurrent state)
//    - No actor (no message-passing concurrency)
//    - No patch/law (no journaled mutation to guard)
//    - No converge/orchestrate (no spec/fast lanes, no multi-stage graph)
//    - Layer 0 is correct: fn, struct, let, match, for, if are sufficient.
// ============================================================================

use data
use std::text

// ============================================================================
//  DOMAIN & LANE CONSTANTS
// ============================================================================

pub const CATEGORY_EPHEMERAL_LOWER:  String = "ephemeral_lowering"
pub const CATEGORY_EPHEMERAL_CAND:   String = "ephemeral_candidate"
pub const CATEGORY_HEAP_RC:          String = "heap_rc"
pub const CATEGORY_SCOPE:            String = "scope_lifetime"
pub const CATEGORY_CONTROL:          String = "control_flow"
pub const CATEGORY_ATOMIC:           String = "atomic_fence"
pub const CATEGORY_I64_TRACK:        String = "i64_literal_tracking"

// ============================================================================
//  FUNCTION DESCRIPTOR — metadata for one cataloged function
// ============================================================================

pub struct FunctionDescriptor:
    name:        String
    line_start:  Int
    line_end:    Int
    category:    String
    description: String

// ============================================================================
//  FUNCTION CATALOGS — all functions in BRAVO domain, by category
// ============================================================================

