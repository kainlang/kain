// ============================================================================
//  alpha_types.kn — Types, Layout & Casts Verification Engine (LANE ALPHA)
//
//  Domain: Type mapping, struct layout, integer/float cast lowering, tagged
//  ABI encoding, JSON/Any bridge, helper alloc layout, pointer type tracking.
//
//  Extracts 90+ function metadata from the Rust LLVM codegen mod.rs, defines
//  mathematical invariants for each function category, and generates Z3 proof
//  pack skeletons (YAML + SMT-LIB v2) for formal verification.
//
//  Ladder: Layer 0 — fn + struct + enum with IO effects for file I/O.
//  Entry point: pub fn run_alpha(target: ExtractionTarget) -> VerificationReport
//
//  Usage: Import this module and call run_alpha() with a configured
//  ExtractionTarget pointing at the codegen_llvm/mod.rs source.
// ============================================================================

use std::fs
use std::text
use data   // ExtractionTarget, FunctionMeta, ParamMeta, IrPattern,
            // Invariant, ProofPackSkeleton, VerificationReport,
            // DOMAIN_TYPES, LANE_ALPHA, default_target, empty_report, format_report

