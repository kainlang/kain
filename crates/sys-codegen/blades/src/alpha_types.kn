// ============================================================================
//  ALL DOMAIN FUNCTIONS — merged catalog of every function to cover
// ============================================================================

pub const ALL_ALPHA_FUNCTIONS: Array<String> = concat_all()

fn concat_all() -> Array<String>:
    var result: Array<String> = []
    result = extend(result, FN_TYPE_MAPPING)
    result = extend(result, FN_TAGGED_VALUE)
    result = extend(result, FN_STRUCT_LAYOUT)
    result = extend(result, FN_CASTS)
    result = extend(result, FN_ALIGNMENT)
    result = extend(result, FN_JSON_ANY)
    result = extend(result, FN_STRUCT_ANY_FIELDS)
    result = extend(result, FN_HELPER_ALLOC)
    result = extend(result, FN_POINTER_TRACKING)
    result = extend(result, FN_POINTER_TRACKING_EXTRA)
    return result

fn extend(dest: Array<String>, src: Array<String>) -> Array<String>:
    var _i = 0
    while _i < len(src):
        let item = src[_i]
        push(dest, item)
        _i = _i + 1
    return dest

