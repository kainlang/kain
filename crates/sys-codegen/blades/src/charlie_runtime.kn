        category: "bounds",
        smt2_skeleton: "; LINE-COLUMN: line >= 1, col >= 1\n(set-logic QF_LIA)\n(declare-const line Int)\n(declare-const col Int)\n(assert (or (< line 1) (< col 1)))\n(check-sat)",
        is_proven: false,
