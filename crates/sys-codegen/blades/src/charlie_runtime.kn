fn catalog_debug() -> Array<CatalogEntry>:
    var entries: Array<CatalogEntry> = []
    push(entries, CatalogEntry {
        name: "byte_offset_to_line_column",
        signature: "fn(&self, byte_offset: usize) -> (usize, usize)",
        line_start: 1514, line_end: 1526,
        domain: DOMAIN_DEBUG,
        description: "Converts byte offset to 1-based line/col using line-starts",
    })
    push(entries, CatalogEntry {
        name: "stmt_span",
        signature: "fn(stmt: &Stmt) -> Span",
        line_start: 1528, line_end: 1543,
        domain: DOMAIN_DEBUG,
        description: "Extracts source span from any statement variant",
    })
    push(entries, CatalogEntry {
        name: "generate_with_debug",
        signature: "fn(program, source, filename) -> KainResult<Vec<u8>>",
        line_start: 470, line_end: 495,
        domain: DOMAIN_DEBUG,
        description: "Generates LLVM IR with DWARF debug metadata",
    })
    return entries

// ============================================================================
//  ASSEMBLE FULL CATALOG
// ============================================================================

fn assemble_full_catalog() -> Array<CatalogEntry>:
    var cat: Array<CatalogEntry> = []
    cat = append_entries(cat, catalog_runtime_bridge())
    cat = append_entries(cat, catalog_machine_stones())
    cat = append_entries(cat, catalog_world_patch_law())
    cat = append_entries(cat, catalog_targets_abi())
    cat = append_entries(cat, catalog_strings())
    cat = append_entries(cat, catalog_map_hash())
    cat = append_entries(cat, catalog_python_bridge())
    cat = append_entries(cat, catalog_symbols())
    cat = append_entries(cat, catalog_debug())
    return cat

fn append_entries(target: Array<CatalogEntry>, source: Array<CatalogEntry>) -> Array<CatalogEntry>:
    var _i = 0
    while _i < len(source):
        let entry = source[_i]
        push(target, entry)
        _i = _i + 1
    return target

// ============================================================================
//  INVARIANT DEFINITIONS
//
//  For each function category, define mathematical invariants that must hold
//  for correctness. Each invariant includes an SMT-LIB v2 skeleton.
// ============================================================================

// --- PULSE INVARIANTS -------------------------------------------------------

fn define_pulse_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []
    push(invs, Invariant {
        name: "pulse-duration-ns-correct",
        description: "machine_pulse_duration_ns must produce correct nanosecond values for ms/s/us/ns. Value must be saturated (no overflow). Interval must be strictly > 0.",
        category: "bounds",
        smt2_skeleton: "; PULSE-TIMING: verify nanosecond conversion\n(set-logic QF_BV)\n(declare-const value (_ BitVec 64))\n(declare-const unit_ms (_ BitVec 64))\n(declare-const unit_s  (_ BitVec 64))\n(assert (bvugt value #x0000000000000000))\n(assert (not (= (bvmul value #x00000000000F4240) (bvmul value #x00000000000F4240))))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "pulse-fire-snapshot-before-body",
        description: "The fire wrapper must call kain_machine_pulse_snapshot BEFORE calling the pulse body. SSA ordering must preserve this.",
        category: "control",
        smt2_skeleton: "; PULSE-ORDER: snapshot call must dominate body call\n(echo \"PULSE-FIRE-ORDER: verified by IR pattern matching\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "pulse-body-symbol-deterministic",
        description: "machine_pulse_body_symbol and machine_pulse_fire_symbol must produce deterministic symbols.",
        category: "abi",
        smt2_skeleton: "; PULSE-SYMBOL: symbol names must be sanitized and prefixed\n(echo \"PULSE-SYMBOL: deterministic symbol generation\")",
        is_proven: false,
        proof_ref: "",
    })
    return invs

// --- AXIOM INVARIANTS -------------------------------------------------------

fn define_axiom_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []
    push(invs, Invariant {
        name: "axiom-capability-bit-unique",
        description: "Every known capability string must map to a unique bit position. No two capabilities may share the same bit. The mask must fit in u64.",
        category: "bounds",
        smt2_skeleton: "; AXIOM-BIT-UNIQUE: verify capability bits are disjoint\n(set-logic QF_BV)\n(declare-const a (_ BitVec 64))\n(declare-const b (_ BitVec 64))\n(assert (distinct a b))\n(assert (not (= (bvand a b) #x0000000000000000)))\n(assert (or (= a (_ bv0 64)) (= b (_ bv0 64))))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "axiom-capability-bit-coverage",
        description: "All capability strings (sse2, avx, avx2, avx512, shatter, teleport, pulse, bitmask) map to bits 0-63.",
        category: "bounds",
        smt2_skeleton: "; AXIOM-BIT-RANGE: all bits within u64\n(set-logic QF_BV)\n(declare-const mask (_ BitVec 64))\n(assert (bvugt mask #x0000000000000000))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "axiom-accept-return-type",
        description: "compile_axiom must emit a function returning i64 (the accept status).",
        category: "types",
        smt2_skeleton: "; AXIOM-RETURN: assert return type is i64\n(echo \"AXIOM-RETURN-TYPE: i64\")",
        is_proven: false,
        proof_ref: "",
    })
    return invs

// --- CONVERGE INVARIANTS ----------------------------------------------------

fn define_converge_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []
    push(invs, Invariant {
        name: "converge-lane-count-bounded",
        description: "Fast lane count must be <= KAIN_CONVERGE_LANE_MAX_LLVM (8). Exceeding this is a compile-time error.",
        category: "bounds",
        smt2_skeleton: "; CONVERGE-BOUND: lane_count <= 8\n(set-logic QF_LIA)\n(declare-const lane_count Int)\n(assert (> lane_count 8))\n(assert (>= lane_count 0))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "converge-spec-lane-must-exist",
        description: "Every converge must have exactly one spec lane, used as the switch default fallback.",
        category: "control",
        smt2_skeleton: "; CONVERGE-SPEC: spec lane existence\n(echo \"CONVERGE-SPEC-LANE: always compiled as default\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "converge-selector-static-eligibility-consistent",
        description: "None selector -> Some(true), Target(llvm/native) -> Some(true). CPU capability -> None (dynamic).",
        category: "control",
        smt2_skeleton: "; CONVERGE-SELECTOR: static eligibility deterministic\n(echo \"CONVERGE-SELECTOR-STATIC: exhaustiveness check\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "converge-cached-lane-global-type",
        description: "The cached lane global must be internal global i64 initialized to -2.",
        category: "types",
        smt2_skeleton: "; CONVERGE-CACHE: valid lane index range 0..N-1\n(echo \"CONVERGE-CACHE: internal global i64 -2\")",
        is_proven: false,
        proof_ref: "",
    })
    return invs

// --- HASH INVARIANTS --------------------------------------------------------

fn define_hash_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []
    push(invs, Invariant {
        name: "hash-mix-u64-is-invertible",
        description: "kain_map_codegen_mix_u64 must be a bijection on u64 (Murmur3 finalizer with avalanche property).",
        category: "math",
        smt2_skeleton: "; HASH-BIJECTION: mix_u64 is injective (prove by collision)\n(set-logic QF_BV)\n(declare-const x (_ BitVec 64))\n(declare-const y (_ BitVec 64))\n(assert (distinct x y))\n(define-fun mix ((v (_ BitVec 64))) (_ BitVec 64)\n  (let ((a (bvxor v (bvlshr v #x0000000000000021))))\n  (let ((b (bvmul a #xFF51AFD7ED558CCD)))\n  (let ((c (bvxor b (bvlshr b #x0000000000000021))))\n  (let ((d (bvmul c #xC4CEB9FE1A85EC53)))\n  (bvxor d (bvlshr d #x0000000000000021)))))))\n(assert (= (mix x) (mix y)))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "hash-bytes-deterministic",
        description: "kain_map_codegen_hash_bytes must produce the same hash for same input bytes across platforms.",
        category: "math",
        smt2_skeleton: "; HASH-DETERMINISM: same bytes -> same hash\n(echo \"HASH-BYTES: deterministic by construction\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "stable-runtime-hash64-deterministic",
        description: "stable_runtime_hash64 must be deterministic across platforms (FNV-1a with fixed constants).",
        category: "math",
        smt2_skeleton: "; FNV1A-DETERMINISM: FNV-1a with fixed constant\n(echo \"STABLE-RUNTIME-HASH64: deterministic FNV-1a\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "map-static-key-metadata-self-consistent",
        description: "kain_map_codegen_static_key_metadata must produce (len, hash, prefix) where len == key.len().",
        category: "math",
        smt2_skeleton: "; MAP-KEY-METADATA: self-consistent with hash_bytes\n(echo \"STATIC-KEY-METADATA: self-consistent\")",
        is_proven: false,
        proof_ref: "",
    })
    return invs

// --- TARGET ABI INVARIANTS --------------------------------------------------

fn define_target_abi_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []
    push(invs, Invariant {
        name: "target-registry-complete",
        description: "Every LlvmTargetId variant must have a descriptor. Triple and datalayout strings must be non-empty.",
        category: "abi",
        smt2_skeleton: "; TARGET-REGISTRY: 3 variants = 3 descriptors\n(echo \"TARGET-REGISTRY: completeness by construction\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "resolve-host-descriptor-correct",
        description: "resolve_host_llvm_target_descriptor must match the host platform. Fallback is WindowsX64Msvc.",
        category: "abi",
        smt2_skeleton: "; HOST-DETECT: cfg!() gates cover all targets\n(echo \"RESOLVE-HOST: fallback chain correctness\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "tagged-immediate-range-valid",
        description: "ABI_TAGGED_IMMEDIATE_INT_MIN = -(1<<60), INT_MAX = (1<<60)-1. Range = (1<<61)-1.",
        category: "bounds",
        smt2_skeleton: "; TAGGED-IMMEDIATE: range verification\n(set-logic QF_BV)\n(declare-const v (_ BitVec 64))\n(define-fun min_val () (_ BitVec 64) (bvneg (bvshl #x0000000000000001 #x000000000000003C)))\n(define-fun max_val () (_ BitVec 64) (bvsub (bvshl #x0000000000000001 #x000000000000003C) #x0000000000000001))\n(assert (bvsgt v min_val))\n(assert (bvslt v max_val))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "converge-lane-max-reasonable",
        description: "KAIN_CONVERGE_LANE_MAX_LLVM = 8 fits in u64 lane mask (64 bits available).",
        category: "bounds",
        smt2_skeleton: "; CONVERGE-MAX: 8 <= 64\n(set-logic QF_LIA)\n(assert (not (<= 8 64)))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    return invs

// --- STRING INVARIANTS ------------------------------------------------------

fn define_string_invariants() -> Array<Invariant>:
    var invs: Array<Invariant> = []
    push(invs, Invariant {
        name: "char-at-bounds-check",
        description: "char_at fast path must check index < string length before extraction.",
        category: "bounds",
        smt2_skeleton: "; CHAR-AT-BOUNDS: index < len before extraction\n(set-logic QF_LIA)\n(declare-const idx Int)\n(declare-const len Int)\n(assert (>= idx len))\n(assert (>= idx 0))\n(assert (>= len 0))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "byte-at-fast-path-bounds",
        description: "byte_at_fast_path must check index < length before emitting GEP + load.",
        category: "bounds",
        smt2_skeleton: "; BYTE-AT-BOUNDS: index < len before GEP\n(set-logic QF_LIA)\n(declare-const idx Int)\n(declare-const len Int)\n(assert (>= idx 0))\n(assert (>= len 0))\n(assert (>= idx len))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "find-substring-search-window-bounds",
        description: "find_substring must ensure search window (hlen - nlen + 1) stays within bounds.",
        category: "bounds",
        smt2_skeleton: "; FIND-SUBSTRING: window = hlen - nlen + 1 >= 0\n(set-logic QF_LIA)\n(declare-const hlen Int)\n(declare-const nlen Int)\n(assert (>= hlen 0))\n(assert (>= nlen 0))\n(assert (> nlen hlen))\n(assert (not (>= (+ (- hlen nlen) 1) 0)))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "string-concat-arity-valid",
        description: "emit_fixed_arity_string_concat_call must only accept arity in range 3..=10.",
        category: "bounds",
        smt2_skeleton: "; CONCAT-ARITY: 3 <= arity <= 10\n(set-logic QF_LIA)\n(declare-const arity Int)\n(assert (>= arity 3))\n(assert (<= arity 10))\n(check-sat)",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "extract-string-literal-idempotent",
        description: "extract_string_literal must return the same literal for direct String expressions.",
        category: "math",
        smt2_skeleton: "; STRING-LITERAL: idempotent for Expr::String(s)\n(echo \"EXTRACT-STRING: idempotent for direct literals\")",
        is_proven: false,
        proof_ref: "",
    })
    return invs

