    })
    push(invs, Invariant {
        name: "windows-tls-subsection-live",
        description: "windows_tls_subsection_is_live: true only for suffixes lexicographically < 'ZZZ'.",
        category: "abi",
        smt2_skeleton: "; TLS-LIVE: suffix < ZZZ is live\n(echo \"TLS-SUBSECTION-LIVE: string comparison contract\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "normalize-tls-section-prefix",
        description: "normalize_windows_tls_section_name_for_coff must always produce a .tls$ prefix that sorts before .tls$ZZZ.",
        category: "abi",
        smt2_skeleton: "; TLS-NORMALIZE: always .tls$KAIN* prefix\n(echo \"TLS-NORMALIZE: prefix contract enforced\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "patch-current-name-save-restore",
        description: "compile_patch must save/restore current_patch_name with Option::replace (balanced, no leak).",
        category: "control",
        smt2_skeleton: "; PATCH-CTX: save/restore balanced\n(echo \"PATCH-CONTEXT: Option::replace ensures restore\")",
        is_proven: false,
        proof_ref: "",
    })
    push(invs, Invariant {
        name: "world-init-lazy-guard",
        description: "compile_world_initializer must emit init_flag check (i1) that skips re-initialization.",
        category: "control",
        smt2_skeleton: "; WORLD-INIT: lazy init flag pattern\n(echo \"WORLD-INIT-GUARD: flag-based lazy initialization\")",
        is_proven: false,
        proof_ref: "",
    })
    return invs

// ============================================================================
//  ASSEMBLE ALL INVARIANTS
// ============================================================================

fn assemble_all_invariants() -> Array<Invariant>:
    var all: Array<Invariant> = []
    all = append_invariants(all, define_pulse_invariants())
    all = append_invariants(all, define_axiom_invariants())
    all = append_invariants(all, define_converge_invariants())
    all = append_invariants(all, define_hash_invariants())
    all = append_invariants(all, define_target_abi_invariants())
    all = append_invariants(all, define_string_invariants())
    all = append_invariants(all, define_runtime_symbol_invariants())
    all = append_invariants(all, define_python_bridge_invariants())
    all = append_invariants(all, define_symbol_debug_invariants())
    return all

fn append_invariants(target: Array<Invariant>, source: Array<Invariant>) -> Array<Invariant>:
    var _i = 0
    while _i < len(source):
        let inv = source[_i]
        push(target, inv)
        _i = _i + 1
    return target

// ============================================================================
//  Z3 PROOF PACK GENERATION
// ============================================================================

fn build_pack_id(domain: String, invariant_name: String) -> String:
    return "kain.sys.codegen.llvm.proofs." + domain + "_" + invariant_name

fn generate_proof_packs(invariants: Array<Invariant>, source_functions: Array<String>) -> Array<ProofPackSkeleton>:
    var packs: Array<ProofPackSkeleton> = []
    var joined_sources = ""
    var i = 0
    while i < len(source_functions):
        if i > 0: joined_sources = joined_sources + ", "
        joined_sources = joined_sources + source_functions[i]
        i = i + 1
    var _i = 0
    while _i < len(invariants):
        let inv = invariants[_i]
        var pack = ProofPackSkeleton {
            pack_id: build_pack_id("charlie", inv.name),
            kind: "check_smt2",
            description: inv.description,
            tags: ["llvm", "charlie", inv.category],
            source_path: SOURCE_PATH,
            source_symbol: joined_sources,
            source_line: 0,
            smt2: inv.smt2_skeleton,
            needs_materialize: true,
        }
        push(packs, pack)
        _i = _i + 1
    return packs

// ============================================================================
//  VERIFICATION — run invariants against function metadata
// ============================================================================

fn verify_functions(functions: Array<FunctionMeta>, invariants: Array<Invariant>) -> VerificationReport:
    var report = empty_report("charlie-runtime-all", "charlie-aggregate")
    report.invariants_found = len(invariants)

    if len(functions) == 0:
        push(report.errors, "No functions extracted from source")
        return report

    if len(invariants) == 0:
        push(report.errors, "No invariants defined")
        return report

    var proven = 0
    var failed = 0
    var _i = 0
    while _i < len(invariants):
        let inv = invariants[_i]
        if inv.is_proven:
            proven = proven + 1
        else:
            failed = failed + 1
        _i = _i + 1

    report.invariants_proven = proven
    report.invariants_failed = failed
    report.proof_packs_generated = len(invariants)
    report.function_name = "charlie-runtime (aggregate)"

    return report

// ============================================================================
//  CATEGORY HELPER — map domain name to invariant category
// ============================================================================

fn category_for_domain(domain: String) -> String:
    if domain == DOMAIN_RUNTIME_BRIDGE: return "abi"
    if domain == DOMAIN_PULSE:          return "bounds"
    if domain == DOMAIN_AXIOM:          return "bounds"
    if domain == DOMAIN_RESONATE:       return "control"
    if domain == DOMAIN_CONVERGE:       return "control"
    if domain == DOMAIN_ORCHESTRATE:    return "control"
    if domain == DOMAIN_WORLD_PATCH:    return "control"
    if domain == DOMAIN_TARGET_ABI:     return "abi"
    if domain == DOMAIN_STRINGS:        return "bounds"
    if domain == DOMAIN_MAP_HASH:       return "math"
    if domain == DOMAIN_PYTHON_BRIDGE:  return "abi"
    if domain == DOMAIN_SYMBOLS:        return "abi"
    if domain == DOMAIN_DEBUG:          return "bounds"
    return "unknown"

fn filter_invariants_by_category(invariants: Array<Invariant>, category: String) -> Array<Invariant>:
    var result: Array<Invariant> = []
    var _i = 0
    while _i < len(invariants):
        let inv = invariants[_i]
        if inv.category == category:
            push(result, inv)
        _i = _i + 1
    return result

// ============================================================================
//  BUILD CATEGORIES — group functions by domain, attach invariants
// ============================================================================

fn build_categories(functions: Array<FunctionMeta>, invariants: Array<Invariant>) -> Array<Category>:
    var categories: Array<Category> = []
    var _fi = 0
    while _fi < len(functions):
        let func = functions[_fi]
        var cat_str = category_for_domain(func.domain)
        var domain_invs = filter_invariants_by_category(invariants, cat_str)

        var packs: Array<ProofPackSkeleton> = []
        var _ii = 0
        while _ii < len(domain_invs):
            let inv = domain_invs[_ii]
            var pack = ProofPackSkeleton {
                pack_id: build_pack_id(func.domain, inv.name),
                kind: "check_smt2",
                description: inv.description,
                tags: ["llvm", "charlie", inv.category],
                source_path: SOURCE_PATH,
                source_symbol: func.name,
                source_line: func.line_start,
                smt2: inv.smt2_skeleton,
                needs_materialize: true,
            }
            push(packs, pack)
            _ii = _ii + 1

        var cat = Category {
            name: func.domain,
            domain: func.domain,
            description: "Coverage for " + func.domain,
            functions: [func],
            invariants: domain_invs,
            proof_packs: packs,
        }
        push(categories, cat)
        _fi = _fi + 1

    return categories

// ============================================================================
//  MATERIALIZE PROOF PACKS — generate YAML strings
// ============================================================================

fn materialize_proof_pack(pack: ProofPackSkeleton) -> String:
    var yaml = "version: 1\n"
    yaml = yaml + "id: " + pack.pack_id + "\n"
    yaml = yaml + "kind: " + pack.kind + "\n"
    yaml = yaml + "description: " + pack.description + "\n"
    yaml = yaml + "tags:\n"
    var _ti = 0
    while _ti < len(pack.tags):
        let tag = pack.tags[_ti]
        yaml = yaml + "  - " + tag + "\n"
        _ti = _ti + 1
    yaml = yaml + "source:\n"
    yaml = yaml + "  path: " + pack.source_path + "\n"
    yaml = yaml + "  symbol: " + pack.source_symbol + "\n"
    yaml = yaml + "  start_line: " + str(pack.source_line) + "\n"
    yaml = yaml + "  reason: Charlie lane runtime verification\n"
    yaml = yaml + "case:\n"
    yaml = yaml + "  smt2: |\n"
    yaml = yaml + "    " + pack.smt2 + "\n"
    yaml = yaml + "  include_model: false\n"
    yaml = yaml + "  include_stats: false\n"
    return yaml

// ============================================================================
//  REPORT FORMATTING — show all categories and their coverage
// ============================================================================

fn format_full_report(context: CharlieContext) -> String:
    var s = "=== CHARLIE LANE VERIFICATION REPORT ===\n"
    s = s + "Lane: " + LANE_NAME + "\n"
    s = s + "Source: " + SOURCE_PATH + "\n"
    s = s + "\n"
    s = s + "--- Function Coverage ---\n"
    s = s + "Total functions tracked: " + str(context.total_functions) + "\n"
    s = s + "Categories: " + str(len(context.categories)) + "\n"
    s = s + "\n"

    var _ci = 0
    while _ci < len(context.categories):
        let cat = context.categories[_ci]
        s = s + "  [" + cat.domain + "] " + cat.name + "\n"
        s = s + "    Functions: " + str(len(cat.functions)) + "\n"
        s = s + "    Invariants: " + str(len(cat.invariants)) + "\n"
        s = s + "    Proof packs: " + str(len(cat.proof_packs)) + "\n"
        var prov = 0
        var _ji = 0
        while _ji < len(cat.invariants):
            let inv = cat.invariants[_ji]
            if inv.is_proven:
                prov = prov + 1
            _ji = _ji + 1
        s = s + "    Proven: " + str(prov) + "/" + str(len(cat.invariants)) + "\n"
        _ci = _ci + 1

    s = s + "\n--- Invariant Summary ---\n"
    s = s + "Total invariants: " + str(context.total_invariants) + "\n"
    s = s + "Proof packs generated: " + str(context.total_proofs) + "\n"

    s = s + "\n--- Verification Status ---\n"
    s = s + "Invariants found:   " + str(context.report.invariants_found) + "\n"
    s = s + "Invariants proven:   " + str(context.report.invariants_proven) + "\n"
    s = s + "Invariants unproven: " + str(context.report.invariants_failed) + "\n"
    s = s + "Proof packs ready:   " + str(context.report.proof_packs_generated) + "\n"

    if len(context.report.errors) > 0:
        s = s + "\n--- ERRORS ---\n"
        var _ei = 0
        while _ei < len(context.report.errors):
            let err = context.report.errors[_ei]
            s = s + "  " + err + "\n"
            _ei = _ei + 1

    if len(context.report.warnings) > 0:
        s = s + "\n--- WARNINGS ---\n"
        var _wi = 0
        while _wi < len(context.report.warnings):
            let warn = context.report.warnings[_wi]
            s = s + "  " + warn + "\n"
            _wi = _wi + 1

    s = s + "\n=== END REPORT ===\n"
    return s

// ============================================================================
//  CATALOG → FUNCTIONMETA conversion
// ============================================================================

fn catalog_to_function_meta(catalog: Array<CatalogEntry>) -> Array<FunctionMeta>:
    var functions: Array<FunctionMeta> = []
    var _i = 0
    while _i < len(catalog):
        let entry = catalog[_i]
        var meta = FunctionMeta {
            name: entry.name,
            line_start: entry.line_start,
            line_end: entry.line_end,
            signature: entry.signature,
            return_type: "",
            params: [],
            doc_comment: entry.description,
            is_pub: true,
            is_impl_method: false,
            impl_target: "",
            domain: entry.domain,
        }
        push(functions, meta)
        _i = _i + 1
    return functions

// ============================================================================
//  PUBLIC: RUN CHARLIE VERIFICATION
//
//  Entry point for the Charlie lane. Called from the CLI or programmatically.
//  Returns a VerificationReport with full coverage details.
// ============================================================================

pub fn run_charlie(target: ExtractionTarget) -> VerificationReport:
    // 1. Build catalog
    let catalog = assemble_full_catalog()

    // 2. Convert to FunctionMeta
    let functions = catalog_to_function_meta(catalog)

    // 3. Define all invariants
    let invariants = assemble_all_invariants()

    // 4. Build categories with invariant assignments
    let categories = build_categories(functions, invariants)

    // 5. Generate proof packs
    var all_proof_packs: Array<ProofPackSkeleton> = []
    var _ci = 0
    while _ci < len(categories):
        let cat = categories[_ci]
        var _pi = 0
        while _pi < len(cat.proof_packs):
            let pack = cat.proof_packs[_pi]
            push(all_proof_packs, pack)
            _pi = _pi + 1
        _ci = _ci + 1

    var report = empty_report("charlie-runtime", "aggregate")
    report.invariants_found = len(invariants)

    var proven = 0
    var failed = 0
    var _ii = 0
    while _ii < len(invariants):
        let inv = invariants[_ii]
        if inv.is_proven:
            proven = proven + 1
        else:
            failed = failed + 1
        _ii = _ii + 1
    report.invariants_proven = proven
    report.invariants_failed = failed
    report.proof_packs_generated = len(all_proof_packs)

    // 7. Build context for summary
    var ctx = CharlieContext {
        target: target,
        categories: categories,
        total_functions: len(functions),
        total_invariants: len(invariants),
        total_proofs: len(all_proof_packs),
        report: report,
    }

    // 8. Print report
    println(format_full_report(ctx))

    return report

// ============================================================================
//  PUBLIC: RUN CHARLIE WITH QUIET MODE
// ============================================================================

pub fn run_charlie_quiet(target: ExtractionTarget) -> VerificationReport:
    let catalog = assemble_full_catalog()
    let functions = catalog_to_function_meta(catalog)
    let invariants = assemble_all_invariants()

    var report = empty_report("charlie-runtime", "aggregate")
    report.invariants_found = len(invariants)
    report.proof_packs_generated = len(invariants)

    var proven = 0
    var _ii2 = 0
    while _ii2 < len(invariants):
        let inv = invariants[_ii2]
        if inv.is_proven:
            proven = proven + 1
        _ii2 = _ii2 + 1
    report.invariants_proven = proven
    report.invariants_failed = len(invariants) - proven

    return report

// ============================================================================
//  PUBLIC: EXPORT PROOF PACKS TO YAML STRINGS
// ============================================================================

pub fn export_proof_packs(target: ExtractionTarget) -> Array<String>:
    let invariants = assemble_all_invariants()
    let catalog = assemble_full_catalog()
    var source_names: Array<String> = []
    var _ei = 0
    while _ei < len(catalog):
        let entry = catalog[_ei]
        push(source_names, entry.name)
        _ei = _ei + 1

    let packs = generate_proof_packs(invariants, source_names)
    var yamls: Array<String> = []
    var _pi2 = 0
    while _pi2 < len(packs):
        let pack = packs[_pi2]
        push(yamls, materialize_proof_pack(pack))
        _pi2 = _pi2 + 1
    return yamls

// ============================================================================
//  PUBLIC: GET CATALOG SUMMARY
// ============================================================================

pub fn get_catalog_summary() -> String:
    let catalog = assemble_full_catalog()
    var s = "Charlie Lane Catalog: " + str(len(catalog)) + " functions\n"
    s = s + "  Runtime Bridge:    " + str(len(catalog_runtime_bridge())) + "\n"
    s = s + "  Machine Stones:    " + str(len(catalog_machine_stones())) + "\n"
    s = s + "  World/Patch/Law:   " + str(len(catalog_world_patch_law())) + "\n"
    s = s + "  Targets & ABI:     " + str(len(catalog_targets_abi())) + "\n"
    s = s + "  Strings:           " + str(len(catalog_strings())) + "\n"
    s = s + "  Map Hashing:       " + str(len(catalog_map_hash())) + "\n"
    s = s + "  Python Bridge:     " + str(len(catalog_python_bridge())) + "\n"
    s = s + "  Symbol Management: " + str(len(catalog_symbols())) + "\n"
    s = s + "  Debug Metadata:    " + str(len(catalog_debug())) + "\n"
    return s


