// ============================================================================
//  charlie_runtime.kn — CHARLIE LANE: Runtime Bridge, Machine Stones & Specials
//
//  Self-contained verification pipeline for the Charlie domain of the LLVM
//  codegen module. Covers:
//    - Runtime symbol bridge (stdlib → native C symbols)
//    - Machine stones: pulse, axiom, resonate, converge, orchestrate
//    - World/entangle/patch/law compilation
//    - Targets & ABI constants
//    - String intrinsics (concat, char_at, byte_at, find_substring)
//    - Map codegen hashing (Murmur3-like finalizer, hash_bytes, metadata)
//    - Python import bridge
//    - Symbol management & debug metadata
//
//  Ladder: Layer 0 — plain fn + struct + enum. Value semantics throughout.
// ============================================================================

use data

// ============================================================================
//  CONSTANTS
// ============================================================================

const LANE_NAME:      String = "charlie"
const SOURCE_PATH:    String = "crates/sys-codegen/src/codegen_llvm/mod.rs"

const DOMAIN_RUNTIME_BRIDGE: String = "runtime-bridge"
const DOMAIN_PULSE:          String = "pulse"
const DOMAIN_AXIOM:          String = "axiom"
const DOMAIN_RESONATE:       String = "resonate"
const DOMAIN_CONVERGE:       String = "converge"
const DOMAIN_ORCHESTRATE:    String = "orchestrate"
const DOMAIN_WORLD_PATCH:    String = "world-patch"
const DOMAIN_TARGET_ABI:     String = "target-abi"
const DOMAIN_STRINGS:        String = "strings"
const DOMAIN_MAP_HASH:       String = "map-hash"
const DOMAIN_PYTHON_BRIDGE:  String = "python-bridge"
const DOMAIN_SYMBOLS:        String = "symbols"
const DOMAIN_DEBUG:          String = "debug"

const PROOF_DIR: String = "z3/proofs/generated/"

// ============================================================================
//  CATEGORY — a logical grouping of related functions
// ============================================================================

pub struct Category:
    name:         String
    domain:       String
    description:  String
    functions:    Array<FunctionMeta>
    invariants:   Array<Invariant>
    proof_packs:  Array<ProofPackSkeleton>

// ============================================================================
//  CHARLIE CONTEXT — all state needed by the verification engine
// ============================================================================

struct CharlieContext:
    target:           ExtractionTarget
    categories:       Array<Category>
    total_functions:  Int
    total_invariants: Int
    total_proofs:     Int
    report:           VerificationReport

// ============================================================================
//  STATIC FUNCTION CATALOG — every function in the Charlie domain
//  Each entry: (name, signature_hint, line_start, domain)
// ============================================================================

struct CatalogEntry:
    name:          String
    signature:     String
    line_start:    Int
    line_end:      Int
    domain:        String
    description:   String

// ============================================================================
//  BUILD THE STATIC CATALOG
//
//  Every function covered by the Charlie lane. Line numbers reference the
//  canonical Rust source at crates/sys-codegen/src/codegen_llvm/mod.rs.
// ============================================================================

fn catalog_runtime_bridge() -> Array<CatalogEntry>:
    var entries: Array<CatalogEntry> = []
    push(entries, CatalogEntry {
        name: "runtime_symbol_for_stdlib_function",
        signature: "fn(name: &str) -> &str",
        line_start: 228, line_end: 236,
        domain: DOMAIN_RUNTIME_BRIDGE,
        description: "Maps Kain stdlib function names to runtime C symbol names",
    })
    push(entries, CatalogEntry {
        name: "stdlib_function_uses_borrowed_string_param",
        signature: "fn(name: &str, index: usize) -> bool",
        line_start: 238, line_end: 242,
        domain: DOMAIN_RUNTIME_BRIDGE,
        description: "Detects borrowed string params that need retain before call",
    })
    push(entries, CatalogEntry {
        name: "llvm_runtime_declaration_is_preemitted",
        signature: "fn(name: &str) -> bool",
        line_start: 244, line_end: 331,
        domain: DOMAIN_RUNTIME_BRIDGE,
        description: "Checks if a runtime declaration is already emitted",
    })
    return entries

