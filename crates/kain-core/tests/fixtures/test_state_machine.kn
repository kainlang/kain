// Test fixture for state machine syntax
// This demonstrates the @state_machine, @state, and @transition attributes

@state_machine
struct CharacterAnimations:
    @state(entry: true)
    struct Idle:
        animation: "Idle_Anim"
        
        @transition(to: "Walk")
        fn can_walk() -> Bool:
            return speed > 0.1
        
        @transition(to: "Jump")
        fn can_jump() -> Bool:
            return jump_pressed
    
    @state
    struct Walk:
        animation: "Walk_Anim"
        
        @transition(to: "Run")
        fn can_run() -> Bool:
            return speed > 5.0
        
        @transition(to: "Idle")
        fn should_idle() -> Bool:
            return speed < 0.1
    
    @state
    struct Run:
        animation: "Run_Anim"
        
        @transition(to: "Walk")
        fn should_walk() -> Bool:
            return speed < 5.0
    
    @state
    struct Jump:
        animation: "Jump_Anim"
        air_time: Float = 0.0
        
        @transition(to: "Idle")
        fn should_land() -> Bool:
            return is_grounded

@state_machine
struct CombatStateMachine:
    @state(entry: true)
    struct Idle:
        animation: "Combat_Idle"
        timeout: Float = 5.0
        
        @transition(to: "Attack")
        fn should_attack() -> Bool:
            return has_target and attack_pressed
        
        @transition(to: "Block")
        fn should_block() -> Bool:
            return block_pressed
    
    @state
    struct Attack:
        animation: "Attack_Anim"
        damage: Float = 10.0
        
        @transition(to: "Idle")
        fn attack_finished() -> Bool:
            return animation_complete
    
    @state
    struct Block:
        animation: "Block_Anim"
        damage_reduction: Float = 0.5
        
        @transition(to: "Idle")
        fn stop_blocking() -> Bool:
            return not block_pressed
