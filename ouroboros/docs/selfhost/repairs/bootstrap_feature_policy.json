{
  "version": 1,
  "description": "Bootstrap-mode feature policy for self-host phase2. Unsupported or low-value feature families can be stubbed during stage2 convergence.",
  "phase": "phase2",
  "policies": [
    {
      "id": "jsx_parser_family",
      "crate": "kain-core",
      "kind": "parser_family",
      "mode": "stub",
      "members": [
        "parse_jsx",
        "parse_jsx_element",
        "parse_jsx_tag_name",
        "parse_jsx_attribute_name",
        "finish_jsx_node",
        "parse_jsx_braced_child",
        "parse_jsx_inline_node"
      ],
      "rationale": "JSX parser generation is currently noisy and not required for initial stage2 bootstrap."
    },
    {
      "id": "graph_editor_family",
      "crate": "kain-core",
      "kind": "parser_family",
      "mode": "stub",
      "members": [
        "parse_graph_runtime",
        "parse_graph_data",
        "parse_node_data",
        "parse_graph_instance",
        "parse_pin_config",
        "parse_state_machine",
        "parse_state",
        "parse_transition",
        "parse_editor_module",
        "parse_menu_entry",
        "parse_toolbar_button",
        "parse_toolbar_widget"
      ],
      "rationale": "Graph/editor parser families are structurally useful but not required for first self-host compiler bootstrap."
    },
    {
      "id": "gameplay_family",
      "crate": "kain-core",
      "kind": "parser_family",
      "mode": "stub",
      "members": [
        "parse_gameplay_effect",
        "parse_gameplay_cue",
        "parse_ability_task",
        "parse_target_actor"
      ],
      "rationale": "Gameplay DSL parsing can be deferred until after phase2 bootstrap succeeds."
    },
    {
      "id": "python_bridge_runtime",
      "crate": "kain-core",
      "kind": "runtime_surface",
      "mode": "stub",
      "members": [
        "py_to_value",
        "python_scope",
        "with_gil"
      ],
      "rationale": "Python bridge integration is not required for first stage2 compiler bootstrap."
    },
    {
      "id": "native_registry_runtime",
      "crate": "kain-core",
      "kind": "runtime_surface",
      "mode": "stub",
      "members": [
        "register_stdlib",
        "register_json_stdlib",
        "register_net_stdlib",
        "register_kos_bridge",
        "define_native"
      ],
      "rationale": "Native runtime registration can be reduced to no-op/stub behavior during bootstrap convergence."
    },
    {
      "id": "low_level_memory_family",
      "crate": "kain-core",
      "kind": "memory_lowering",
      "mode": "bootstrap_safe_replace",
      "members": [
        "LayoutRegistry::build_with_abi",
        "__kain_bitfield_get",
        "__kain_bitfield_set",
        "infer_field_offset"
      ],
      "rationale": "Low-level memory lowering is currently the most concentrated unresolved family in stage2 and should be treated as one replaceable bootstrap surface."
    },
    {
      "id": "parser_slice_helpers",
      "crate": "kain-core",
      "kind": "parser_helper",
      "mode": "repair",
      "members": [
        "slice(self.source, start, None)",
        "slice(self.source, span.start, span.end)",
        "slice(ws, 1, None)",
        "slice(expected, None, expected.len() - 1)"
      ],
      "rationale": "Generated parser helper calls should be normalized systematically instead of patched one site at a time."
    }
  ]
}
