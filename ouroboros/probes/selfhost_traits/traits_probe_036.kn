enum TraitProbeValue036:
    Unit
    Text(String)

impl Display for TraitProbeValue036:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue036::Unit => write(f, "unit-36")
            TraitProbeValue036::Text(value) => write(f, value)

impl Default for TraitProbeValue036:
    fn default_() -> Self_:
        TraitProbeValue036__Unit

fn trait_helper_probe_036(value: TraitProbeValue036) -> String:
    format("{}", value)
