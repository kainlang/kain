enum TraitProbeValue002:
    Unit
    Text(String)

impl Display for TraitProbeValue002:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue002::Unit => write(f, "unit-2")
            TraitProbeValue002::Text(value) => write(f, value)

impl Default for TraitProbeValue002:
    fn default_() -> Self_:
        TraitProbeValue002__Unit

fn trait_helper_probe_002(value: TraitProbeValue002) -> String:
    format("{}", value)
