enum TraitProbeValue065:
    Unit
    Text(String)

impl Display for TraitProbeValue065:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue065::Unit => write(f, "unit-65")
            TraitProbeValue065::Text(value) => write(f, value)

impl Default for TraitProbeValue065:
    fn default_() -> Self_:
        TraitProbeValue065__Unit

fn trait_helper_probe_065(value: TraitProbeValue065) -> String:
    format("{}", value)
