enum TraitProbeValue054:
    Unit
    Text(String)

impl Display for TraitProbeValue054:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue054::Unit => write(f, "unit-54")
            TraitProbeValue054::Text(value) => write(f, value)

impl Default for TraitProbeValue054:
    fn default_() -> Self_:
        TraitProbeValue054__Unit

fn trait_helper_probe_054(value: TraitProbeValue054) -> String:
    format("{}", value)
