enum TraitProbeValue061:
    Unit
    Text(String)

impl Display for TraitProbeValue061:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue061::Unit => write(f, "unit-61")
            TraitProbeValue061::Text(value) => write(f, value)

impl Default for TraitProbeValue061:
    fn default_() -> Self_:
        TraitProbeValue061__Unit

fn trait_helper_probe_061(value: TraitProbeValue061) -> String:
    format("{}", value)
