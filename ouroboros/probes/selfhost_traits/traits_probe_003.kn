enum TraitProbeValue003:
    Unit
    Text(String)

impl Display for TraitProbeValue003:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue003::Unit => write(f, "unit-3")
            TraitProbeValue003::Text(value) => write(f, value)

impl Default for TraitProbeValue003:
    fn default_() -> Self_:
        TraitProbeValue003__Unit

fn trait_helper_probe_003(value: TraitProbeValue003) -> String:
    format("{}", value)
