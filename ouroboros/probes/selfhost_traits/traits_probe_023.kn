enum TraitProbeValue023:
    Unit
    Text(String)

impl Display for TraitProbeValue023:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue023::Unit => write(f, "unit-23")
            TraitProbeValue023::Text(value) => write(f, value)

impl Default for TraitProbeValue023:
    fn default_() -> Self_:
        TraitProbeValue023__Unit

fn trait_helper_probe_023(value: TraitProbeValue023) -> String:
    format("{}", value)
