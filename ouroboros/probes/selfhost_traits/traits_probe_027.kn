enum TraitProbeValue027:
    Unit
    Text(String)

impl Display for TraitProbeValue027:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue027::Unit => write(f, "unit-27")
            TraitProbeValue027::Text(value) => write(f, value)

impl Default for TraitProbeValue027:
    fn default_() -> Self_:
        TraitProbeValue027__Unit

fn trait_helper_probe_027(value: TraitProbeValue027) -> String:
