enum TraitProbeValue022:
    Unit
    Text(String)

impl Display for TraitProbeValue022:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue022::Unit => write(f, "unit-22")
            TraitProbeValue022::Text(value) => write(f, value)

impl Default for TraitProbeValue022:
