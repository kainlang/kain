enum TraitProbeValue021:
    Unit
    Text(String)

impl Display for TraitProbeValue021:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue021::Unit => write(f, "unit-21")
            TraitProbeValue021::Text(value) => write(f, value)

impl Default for TraitProbeValue021:
    fn default_() -> Self_:
        TraitProbeValue021__Unit

fn trait_helper_probe_021(value: TraitProbeValue021) -> String:
    format("{}", value)
