enum TraitProbeValue006:
    Unit
    Text(String)

impl Display for TraitProbeValue006:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue006::Unit => write(f, "unit-6")
            TraitProbeValue006::Text(value) => write(f, value)

impl Default for TraitProbeValue006:
    fn default_() -> Self_:
