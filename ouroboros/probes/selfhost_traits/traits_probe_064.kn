enum TraitProbeValue064:
    Unit
    Text(String)

impl Display for TraitProbeValue064:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue064::Unit => write(f, "unit-64")
            TraitProbeValue064::Text(value) => write(f, value)

impl Default for TraitProbeValue064:
    fn default_() -> Self_:
        TraitProbeValue064__Unit

fn trait_helper_probe_064(value: TraitProbeValue064) -> String:
    format("{}", value)
