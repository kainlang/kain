enum TraitProbeValue050:
    Unit
    Text(String)

impl Display for TraitProbeValue050:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue050::Unit => write(f, "unit-50")
            TraitProbeValue050::Text(value) => write(f, value)

impl Default for TraitProbeValue050:
    fn default_() -> Self_:
        TraitProbeValue050__Unit

fn trait_helper_probe_050(value: TraitProbeValue050) -> String:
    format("{}", value)
