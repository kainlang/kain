enum TraitProbeValue056:
    Unit
    Text(String)

impl Display for TraitProbeValue056:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue056::Unit => write(f, "unit-56")
            TraitProbeValue056::Text(value) => write(f, value)

impl Default for TraitProbeValue056:
    fn default_() -> Self_:
        TraitProbeValue056__Unit

fn trait_helper_probe_056(value: TraitProbeValue056) -> String:
