enum TraitProbeValue009:
    Unit
    Text(String)

impl Display for TraitProbeValue009:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue009::Unit => write(f, "unit-9")
            TraitProbeValue009::Text(value) => write(f, value)

impl Default for TraitProbeValue009:
    fn default_() -> Self_:
        TraitProbeValue009__Unit

fn trait_helper_probe_009(value: TraitProbeValue009) -> String:
