enum TraitProbeValue051:
    Unit
    Text(String)

impl Display for TraitProbeValue051:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue051::Unit => write(f, "unit-51")
            TraitProbeValue051::Text(value) => write(f, value)

impl Default for TraitProbeValue051:
    fn default_() -> Self_:
        TraitProbeValue051__Unit

fn trait_helper_probe_051(value: TraitProbeValue051) -> String:
    format("{}", value)
