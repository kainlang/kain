enum TraitProbeValue025:
    Unit
    Text(String)

impl Display for TraitProbeValue025:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue025::Unit => write(f, "unit-25")
            TraitProbeValue025::Text(value) => write(f, value)

impl Default for TraitProbeValue025:
    fn default_() -> Self_:
        TraitProbeValue025__Unit

fn trait_helper_probe_025(value: TraitProbeValue025) -> String:
    format("{}", value)
