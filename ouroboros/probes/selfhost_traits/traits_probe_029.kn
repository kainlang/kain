enum TraitProbeValue029:
    Unit
    Text(String)

impl Display for TraitProbeValue029:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue029::Unit => write(f, "unit-29")
            TraitProbeValue029::Text(value) => write(f, value)

impl Default for TraitProbeValue029:
    fn default_() -> Self_:
        TraitProbeValue029__Unit

fn trait_helper_probe_029(value: TraitProbeValue029) -> String:
    format("{}", value)
