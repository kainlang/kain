enum TraitProbeValue012:
    Unit
    Text(String)

impl Display for TraitProbeValue012:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue012::Unit => write(f, "unit-12")
            TraitProbeValue012::Text(value) => write(f, value)

impl Default for TraitProbeValue012:
    fn default_() -> Self_:
        TraitProbeValue012__Unit

fn trait_helper_probe_012(value: TraitProbeValue012) -> String:
    format("{}", value)
