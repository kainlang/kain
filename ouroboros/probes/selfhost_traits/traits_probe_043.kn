enum TraitProbeValue043:
    Unit
    Text(String)

impl Display for TraitProbeValue043:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue043::Unit => write(f, "unit-43")
            TraitProbeValue043::Text(value) => write(f, value)

impl Default for TraitProbeValue043:
    fn default_() -> Self_:
        TraitProbeValue043__Unit

fn trait_helper_probe_043(value: TraitProbeValue043) -> String:
    format("{}", value)
