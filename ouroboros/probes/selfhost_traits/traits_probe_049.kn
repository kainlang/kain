    Text(String)

impl Display for TraitProbeValue049:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue049::Unit => write(f, "unit-49")
            TraitProbeValue049::Text(value) => write(f, value)

impl Default for TraitProbeValue049:
