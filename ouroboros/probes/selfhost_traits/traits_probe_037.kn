enum TraitProbeValue037:
    Unit
    Text(String)

impl Display for TraitProbeValue037:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue037::Unit => write(f, "unit-37")
            TraitProbeValue037::Text(value) => write(f, value)

impl Default for TraitProbeValue037:
    fn default_() -> Self_:
        TraitProbeValue037__Unit

fn trait_helper_probe_037(value: TraitProbeValue037) -> String:
    format("{}", value)
