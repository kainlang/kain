enum TraitProbeValue016:
    Unit
    Text(String)

impl Display for TraitProbeValue016:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue016::Unit => write(f, "unit-16")
            TraitProbeValue016::Text(value) => write(f, value)

impl Default for TraitProbeValue016:
    fn default_() -> Self_:
        TraitProbeValue016__Unit

fn trait_helper_probe_016(value: TraitProbeValue016) -> String:
    format("{}", value)
