enum TraitProbeValue017:
    Unit
    Text(String)

impl Display for TraitProbeValue017:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue017::Unit => write(f, "unit-17")
            TraitProbeValue017::Text(value) => write(f, value)

impl Default for TraitProbeValue017:
    fn default_() -> Self_:
        TraitProbeValue017__Unit

fn trait_helper_probe_017(value: TraitProbeValue017) -> String:
    format("{}", value)
