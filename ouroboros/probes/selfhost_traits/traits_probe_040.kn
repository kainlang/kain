enum TraitProbeValue040:
    Unit
    Text(String)

impl Display for TraitProbeValue040:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue040::Unit => write(f, "unit-40")
            TraitProbeValue040::Text(value) => write(f, value)

impl Default for TraitProbeValue040:
    fn default_() -> Self_:
        TraitProbeValue040__Unit

fn trait_helper_probe_040(value: TraitProbeValue040) -> String:
    format("{}", value)
