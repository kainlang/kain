enum TraitProbeValue034:
    Unit
    Text(String)

impl Display for TraitProbeValue034:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue034::Unit => write(f, "unit-34")
            TraitProbeValue034::Text(value) => write(f, value)

impl Default for TraitProbeValue034:
    fn default_() -> Self_:
        TraitProbeValue034__Unit

fn trait_helper_probe_034(value: TraitProbeValue034) -> String:
    format("{}", value)
