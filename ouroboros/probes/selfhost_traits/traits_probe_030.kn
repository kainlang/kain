enum TraitProbeValue030:
    Unit
    Text(String)

impl Display for TraitProbeValue030:
    fn fmt(_self: &Self_, f: &mut Formatter) -> Result<(), Error>:
        match _self:
            TraitProbeValue030::Unit => write(f, "unit-30")
            TraitProbeValue030::Text(value) => write(f, value)

impl Default for TraitProbeValue030:
    fn default_() -> Self_:
        TraitProbeValue030__Unit

fn trait_helper_probe_030(value: TraitProbeValue030) -> String:
    format("{}", value)
