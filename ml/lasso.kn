use std::fs
use std::path
use std::process
use std::text

const RAW: String = "ml/raw"

fn root() -> String:
    var r = process_environment("KAIN_HOME")
    if r == "":
        r = process_current_working_directory()
    r = text_replace_string(r, "/", "\\")
    if text_starts_with_string(r, "\\\\?\\"): r = substring(r, 4, len(r))
    if text_starts_with_string(r, ".\\"):     r = substring(r, 2, len(r))
    while len(r) > 3 and text_ends_with_string(r, "\\"):
        r = substring(r, 0, len(r) - 1)
    if text_ends_with_string(r, "\\.kain") or text_ends_with_string(r, "\\ml"):
        r = path_parent(r)
    return r

fn main() -> Int:
    let r = root()
    let rl = len(r) + 1
    let raw = path_join(r, RAW)
    if fs_exists(raw): fs_remove_dir_all(raw)
    fs_create_dir_all(raw)

    let dirs = ["blades", "benchmark/cases_v2", "benchmark/cases", "smoketest/src"]
    var n: Int = 0
    var di: Int = 0
    while di < len(dirs):
        let src = path_join(r, dirs[di])
        if fs_exists(src) == false:
            println("missing: " + src)
            return 1
        let ents = fs_walk(src)
        var ei: Int = 0
        let ec = len(ents)
        while ei < ec:
            let ep = ents[ei].path
            ei = ei + 1
            if text_ends_with_string(ep, ".kn") == false or fs_is_file(ep) == false:
                continue
            // Normalize path and strip root prefix
            let key = text_replace_string(ep, "/", "\\")
            let skip: Int = if text_starts_with_string(key, "\\\\?\\"): 4 else: 0
            let rel = substring(key, rl + skip, len(key))
            // Flatten relative path into a single filename: replace \ with _
            let flat = text_replace_string(rel, "\\", "_")
            fs_copy_file_streaming(ep, path_join(raw, flat), 65536)
            n = n + 1
        di = di + 1

    println("copied_total=" + str(n))
    return if n > 0: 0 else: 2
