    return native_reload_snapshot(session_id)

pub fn reload_snapshot_record(session_id: Int) -> ReloadSnapshotRecord:
    return native_reload_snapshot_record(session_id)

pub fn reload_package_surface() -> String:
    return native_reload_package_surface()

