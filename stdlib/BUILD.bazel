load("//:tools/bazel/kain_rules.bzl", "kain_stdlib_map", "kain_stdlib_map_check")

package(default_visibility = ["//visibility:public"])

STDLIB_KAIN_SRCS = glob(["*.kn"])

NATIVE_MANIFESTS = [
    "//runtime:native_core_runtime.toml",
    "//runtime:native_runtime.toml",
]

exports_files([
    "STDLIB_MAP.llm.md",
    "stdlib.map.json",
])

kain_stdlib_map(
    name = "stdlib_map",
    srcs = STDLIB_KAIN_SRCS,
    native_manifests = NATIVE_MANIFESTS,
)

kain_stdlib_map_check(
    name = "stdlib_map_check",
    srcs = STDLIB_KAIN_SRCS,
    native_manifests = NATIVE_MANIFESTS,
)
