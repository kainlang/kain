pub fn fs_read_bytes(path: String) -> Array<Int>:
    return fs_hex_to_bytes(abi_fs_read_bytes_hex(path))

pub fn fs_read_bytes_range(path: String, offset: Int, length: Int) -> Array<Int>:
    return fs_hex_to_bytes(abi_fs_read_byte_range_hex(path, offset, length))

