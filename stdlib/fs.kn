    let _status = abi_fs_write_bytes_hex(path, hex)

pub fn fs_write_bytes(path: String, bytes: Array<Int>) -> Unit:
    let _status = abi_fs_write_bytes_hex(path, fs_bytes_to_hex(bytes))

pub fn fs_append_bytes(path: String, bytes: Array<Int>) -> Unit:
