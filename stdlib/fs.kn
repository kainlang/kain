fn fs_parse_int_or_zero(value: String) -> Int:
    if value == "":
        return 0
    return to_int(value)

fn fs_hex_to_bytes(hex: String) -> Array<Int>:
    let decoded = hex_decode(hex)
    let mut bytes: Array<Int> = []
    var index = 0
    while index < len(decoded):
        push(bytes, byte_at(decoded, index))
        index = index + 1
    return bytes

fn fs_bytes_to_hex(bytes: Array<Int>) -> String:
    var text = ""
    var index = 0
    while index < len(bytes):
        text = text + chr(bytes[index] & 255)
        index = index + 1
    return hex_encode(text)

fn fs_nonempty_lines(text: String) -> Array<String>:
    let raw_lines = text_split_lines(text)
    let mut lines: Array<String> = []
    var index = 0
    while index < len(raw_lines):
        if raw_lines[index] != "":
            push(lines, raw_lines[index])
        index = index + 1
    return lines

fn fs_metadata_line_value(metadata_text: String, key: String) -> String:
    let prefix = key + "="
    let lines = fs_nonempty_lines(metadata_text)
    var index = 0
    while index < len(lines):
        let metadata_row = lines[index]
        if text_starts_with_string(metadata_row, prefix):
            return text_substring_string(metadata_row, len(prefix), len(metadata_row) - len(prefix))
        index = index + 1
    return ""

fn fs_parse_metadata_text(metadata_text: String) -> FsMetadata:
    return FsMetadata {
        file_type: fs_metadata_line_value(metadata_text, "file_type"),
        len: fs_parse_int_or_zero(fs_metadata_line_value(metadata_text, "len")),
        readonly: fs_metadata_line_value(metadata_text, "readonly") == "1",
        created_millis: fs_parse_int_or_zero(fs_metadata_line_value(metadata_text, "created_millis")),
        modified_millis: fs_parse_int_or_zero(fs_metadata_line_value(metadata_text, "modified_millis")),
        accessed_millis: fs_parse_int_or_zero(fs_metadata_line_value(metadata_text, "accessed_millis"))
    }

fn fs_dir_entry_for_path(path: String) -> FsDirEntry:
    let metadata = fs_metadata(path)
    return FsDirEntry {
        path: path,
        file_name: fs_path_file_name(path),
        file_type: metadata.file_type,
        metadata: metadata
    }

