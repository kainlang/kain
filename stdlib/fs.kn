pub fn fs_try_read_bytes(path: String) -> FsBytesResult:
    let raw = fs_try_read_bytes_hex(path)
    return FsBytesResult {
        ok: raw.ok,
        value: if raw.ok: fs_hex_to_bytes(raw.value) else: [],
        status: raw.status,
        error: raw.error
    }

