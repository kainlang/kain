pub fn fs_parse_int_or_zero(value: String) -> Int:
    if value == "":
        return 0
    return to_int(value)

pub fn fs_hex_to_bytes(hex: String) -> Array<Int>:
    let decoded = hex_decode(hex)
    let mut bytes: Array<Int> = []
    var index = 0
    while index < len(decoded):
        push(bytes, byte_at(decoded, index))
        index = index + 1
    return bytes

pub fn fs_bytes_to_hex(bytes: Array<Int>) -> String:
    var text = ""
    var index = 0
    while index < len(bytes):
        text = text + chr(bytes[index] & 255)
        index = index + 1
    return hex_encode(text)

pub fn fs_nonempty_lines(text: String) -> Array<String>:
    let raw_lines = text_split_lines(text)
    let mut lines: Array<String> = []
    var index = 0
    while index < len(raw_lines):
        if raw_lines[index] != "":
            push(lines, raw_lines[index])
        index = index + 1
    return lines

pub fn fs_metadata_line_value(metadata_text: String, key: String) -> String:
    let prefix = key + "="
    let lines = text_split_lines(metadata_text)
    var index = 0
    while index < len(lines):
        let metadata_row = lines[index]
        if metadata_row != "" and text_starts_with_string(metadata_row, prefix):
            return text_substring_string(metadata_row, len(prefix), len(metadata_row) - len(prefix))
        index = index + 1
    return ""

pub fn fs_parse_metadata_text(metadata_text: String) -> FsMetadata:
    var file_type = ""
    var len_value = 0
    var readonly = false
    var created_millis = 0
    var modified_millis = 0
    var accessed_millis = 0
    let lines = text_split_lines(metadata_text)
    var index = 0
    while index < len(lines):
        let metadata_row = lines[index]
        if metadata_row != "":
            if text_starts_with_string(metadata_row, "file_type="):
                file_type = text_substring_string(metadata_row, 10, len(metadata_row) - 10)
            if text_starts_with_string(metadata_row, "len="):
                let value = text_substring_string(metadata_row, 4, len(metadata_row) - 4)
                if value != "":
                    len_value = to_int(value)
            if text_starts_with_string(metadata_row, "readonly="):
                readonly = text_substring_string(metadata_row, 9, len(metadata_row) - 9) == "1"
            if text_starts_with_string(metadata_row, "created_millis="):
                let value = text_substring_string(metadata_row, 15, len(metadata_row) - 15)
                if value != "":
                    created_millis = to_int(value)
            if text_starts_with_string(metadata_row, "modified_millis="):
                let value = text_substring_string(metadata_row, 16, len(metadata_row) - 16)
                if value != "":
                    modified_millis = to_int(value)
            if text_starts_with_string(metadata_row, "accessed_millis="):
                let value = text_substring_string(metadata_row, 16, len(metadata_row) - 16)
                if value != "":
                    accessed_millis = to_int(value)
        index = index + 1
    return FsMetadata {
        file_type: file_type,
        len: len_value,
        readonly: readonly,
        created_millis: created_millis,
        modified_millis: modified_millis,
        accessed_millis: accessed_millis
    }

pub fn fs_dir_entry_for_path(path: String) -> FsDirEntry:
    let metadata_text = abi_fs_metadata_text(path)
    var file_type = ""
    var len_value = 0
    var readonly = false
    var created_millis = 0
    var modified_millis = 0
    var accessed_millis = 0
    let lines = text_split_lines(metadata_text)
    var index = 0
    while index < len(lines):
        let metadata_row = lines[index]
        if metadata_row != "":
            if text_starts_with_string(metadata_row, "file_type="):
                file_type = text_substring_string(metadata_row, 10, len(metadata_row) - 10)
            if text_starts_with_string(metadata_row, "len="):
                let value = text_substring_string(metadata_row, 4, len(metadata_row) - 4)
                if value != "":
                    len_value = to_int(value)
            if text_starts_with_string(metadata_row, "readonly="):
                readonly = text_substring_string(metadata_row, 9, len(metadata_row) - 9) == "1"
            if text_starts_with_string(metadata_row, "created_millis="):
                let value = text_substring_string(metadata_row, 15, len(metadata_row) - 15)
                if value != "":
                    created_millis = to_int(value)
            if text_starts_with_string(metadata_row, "modified_millis="):
                let value = text_substring_string(metadata_row, 16, len(metadata_row) - 16)
                if value != "":
                    modified_millis = to_int(value)
            if text_starts_with_string(metadata_row, "accessed_millis="):
                let value = text_substring_string(metadata_row, 16, len(metadata_row) - 16)
                if value != "":
                    accessed_millis = to_int(value)
        index = index + 1
    let metadata = FsMetadata {
        file_type: file_type,
        len: len_value,
        readonly: readonly,
        created_millis: created_millis,
        modified_millis: modified_millis,
        accessed_millis: accessed_millis
    }
    return FsDirEntry {
        path: path,
        file_name: abi_fs_path_file_name(path),
        file_type: metadata.file_type,
        metadata: metadata
    }

