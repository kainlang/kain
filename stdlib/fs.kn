pub fn fs_read_dir(path: String) -> Array<FsDirEntry>:
    let raw_lines = text_split_lines(abi_fs_read_dir_paths_text(path))
    let mut entries: Array<FsDirEntry> = []
    var index = 0
    while index < len(raw_lines):
        let entry_path = raw_lines[index]
        if entry_path != "":
            let metadata_text = abi_fs_metadata_text(entry_path)
            var file_type = ""
            var len_value = 0
            var readonly = false
            var created_millis = 0
            var modified_millis = 0
            var accessed_millis = 0
            let metadata_lines = text_split_lines(metadata_text)
            var metadata_index = 0
            while metadata_index < len(metadata_lines):
                let metadata_row = metadata_lines[metadata_index]
                if metadata_row != "":
                    if text_starts_with_string(metadata_row, "file_type="):
                        file_type = text_substring_string(metadata_row, 10, len(metadata_row) - 10)
                    if text_starts_with_string(metadata_row, "len="):
                        let value = text_substring_string(metadata_row, 4, len(metadata_row) - 4)
                        if value != "":
                            len_value = to_int(value)
                    if text_starts_with_string(metadata_row, "readonly="):
                        readonly = text_substring_string(metadata_row, 9, len(metadata_row) - 9) == "1"
                    if text_starts_with_string(metadata_row, "created_millis="):
                        let value = text_substring_string(metadata_row, 15, len(metadata_row) - 15)
                        if value != "":
                            created_millis = to_int(value)
                    if text_starts_with_string(metadata_row, "modified_millis="):
                        let value = text_substring_string(metadata_row, 16, len(metadata_row) - 16)
                        if value != "":
                            modified_millis = to_int(value)
                    if text_starts_with_string(metadata_row, "accessed_millis="):
                        let value = text_substring_string(metadata_row, 16, len(metadata_row) - 16)
                        if value != "":
                            accessed_millis = to_int(value)
                metadata_index = metadata_index + 1
            let metadata = FsMetadata {
                file_type: file_type,
                len: len_value,
                readonly: readonly,
                created_millis: created_millis,
                modified_millis: modified_millis,
                accessed_millis: accessed_millis
            }
            push(entries, FsDirEntry {
                path: entry_path,
                file_name: abi_fs_path_file_name(entry_path),
                file_type: metadata.file_type,
                metadata: metadata
            })
        index = index + 1
    return entries

pub fn fs_walk_paths_text(path: String) -> String:
    return abi_fs_walk_paths_text(path)

pub fn fs_walk(path: String) -> Array<FsDirEntry>:
    let paths = text_split_lines(abi_fs_walk_paths_text(path))
    let mut entries: Array<FsDirEntry> = []
    var index = 0
    while index < len(paths):
        let entry_path = paths[index]
        if entry_path != "":
            let metadata_text = abi_fs_metadata_text(entry_path)
            var file_type = ""
            var len_value = 0
            var readonly = false
            var created_millis = 0
            var modified_millis = 0
            var accessed_millis = 0
            let metadata_lines = text_split_lines(metadata_text)
            var metadata_index = 0
            while metadata_index < len(metadata_lines):
                let metadata_row = metadata_lines[metadata_index]
                if metadata_row != "":
                    if text_starts_with_string(metadata_row, "file_type="):
                        file_type = text_substring_string(metadata_row, 10, len(metadata_row) - 10)
                    if text_starts_with_string(metadata_row, "len="):
                        let value = text_substring_string(metadata_row, 4, len(metadata_row) - 4)
                        if value != "":
                            len_value = to_int(value)
                    if text_starts_with_string(metadata_row, "readonly="):
                        readonly = text_substring_string(metadata_row, 9, len(metadata_row) - 9) == "1"
                    if text_starts_with_string(metadata_row, "created_millis="):
                        let value = text_substring_string(metadata_row, 15, len(metadata_row) - 15)
                        if value != "":
                            created_millis = to_int(value)
                    if text_starts_with_string(metadata_row, "modified_millis="):
                        let value = text_substring_string(metadata_row, 16, len(metadata_row) - 16)
                        if value != "":
                            modified_millis = to_int(value)
                    if text_starts_with_string(metadata_row, "accessed_millis="):
                        let value = text_substring_string(metadata_row, 16, len(metadata_row) - 16)
                        if value != "":
                            accessed_millis = to_int(value)
                metadata_index = metadata_index + 1
            let metadata = FsMetadata {
                file_type: file_type,
                len: len_value,
                readonly: readonly,
                created_millis: created_millis,
                modified_millis: modified_millis,
                accessed_millis: accessed_millis
            }
            push(entries, FsDirEntry {
                path: entry_path,
                file_name: abi_fs_path_file_name(entry_path),
                file_type: metadata.file_type,
                metadata: metadata
            })
        index = index + 1
    return entries

