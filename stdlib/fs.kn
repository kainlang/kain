    return fs_parse_metadata_text(abi_fs_metadata_text(path))

pub fn fs_read_dir_paths_text(path: String) -> String:
    return abi_fs_read_dir_paths_text(path)

pub fn fs_read_dir_paths(path: String) -> Array<String>:
    return fs_nonempty_lines(abi_fs_read_dir_paths_text(path))

pub fn fs_read_dir(path: String) -> Array<FsDirEntry>:
    let paths = fs_read_dir_paths(path)
    let mut entries: Array<FsDirEntry> = []
    var index = 0
    while index < len(paths):
        push(entries, fs_dir_entry_for_path(paths[index]))
        index = index + 1
    return entries

pub fn fs_walk_paths_text(path: String) -> String:
    return abi_fs_walk_paths_text(path)

pub fn fs_walk(path: String) -> Array<FsDirEntry>:
    let paths = fs_nonempty_lines(abi_fs_walk_paths_text(path))
    let mut entries: Array<FsDirEntry> = []
    var index = 0
    while index < len(paths):
        push(entries, fs_dir_entry_for_path(paths[index]))
        index = index + 1
    return entries

