pub fn fs_copy_file_streaming(src: String, dest: String, chunk_size: Int) -> Int:
    return abi_fs_copy_file_streaming(src, dest, chunk_size)

pub fn fs_stream_chunks(path: String, chunk_size: Int) -> Array<FsChunk>:
    let metadata = fs_metadata(path)
    let safe_chunk_size = int_max(chunk_size, 1)
    let mut chunks: Array<FsChunk> = []
    var index = 0
    var offset = 0
    while offset < metadata.len:
        let remaining = metadata.len - offset
        let current_size = int_min(safe_chunk_size, remaining)
        let bytes = fs_read_bytes_range(path, offset, current_size)
        push(chunks, FsChunk {
            index: index,
            offset: offset,
            len: len(bytes),
            bytes: bytes
        })
        index = index + 1
        offset = offset + current_size
    return chunks

