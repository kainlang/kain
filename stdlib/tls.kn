use std::native::net

pub fn tls_client_state() -> Int:
    return net_capability_state("tls.client")

pub fn tls_client_supported() -> Bool:
    return net_capability_supported("tls.client")

pub fn tls_client_available() -> Bool:
    return net_capability_available("tls.client")

pub fn tls_platform_name() -> String:
    return net_platform_name()

pub fn tls_https_request_create(method: String, url: String) -> Int:
    return http_request_create(method, url)

pub fn tls_https_request_set_header(request_id: Int, key: String, value: String) -> Int:
    return http_request_set_header(request_id, key, value)

pub fn tls_https_request_set_body_text(request_id: Int, payload: String) -> Int:
    return http_request_set_body_text(request_id, payload)

pub fn tls_https_request_set_timeout(request_id: Int, timeout_ms: Int) -> Int:
    return http_request_set_timeout(request_id, timeout_ms)

pub fn tls_https_client_send(request_id: Int) -> Int:
    return http_client_send(request_id)

pub fn tls_https_response_protocol(response_id: Int) -> String:
    return http_response_protocol(response_id)

pub fn tls_https_get_text(url: String) -> String:
    let request = tls_https_request_create("GET", url)
    let response = tls_https_client_send(request)
    return http_response_body_text(response)
