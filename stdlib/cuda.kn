pub const CUDA_COMPUTE_RESIDENCY_ENV: String = "KAIN_CUDA_COMPUTE_RESIDENCY"
pub const CUDA_RUNTIME_LIBRARY_ENV: String = "KAIN_GPU_RUNTIME_LIBRARY"
