pub const CUDA_COMPUTE_RESIDENCY_FILE_NAME: String = "kain_compute_residency.json"

pub struct CudaPaths:
    runtime_library_path: String
    shader_bundle_path: String
    compute_residency_path: String

pub struct CudaRuntimeState:
    driver_available: Bool
    runtime_library_available: Bool
    runtime_ready: Bool
    paths: CudaPaths
    last_status: Int
    last_error_kind: String
    last_error_message: String

pub struct CudaDispatchStats:
    ok: Bool
    status: Int
    message: String
    compute_key: String
    shader_bundle_path: String
    compute_residency_path: String
    dispatch_invocations: Int
    tensor_binding_count: Int
    stream_binding_count: Int
    neural_node_count: Int
    output_binding_count: Int
    total_output_bytes: Int

pub struct CudaBindingLocator:
    ok: Bool
    compute_key: String
    binding_key: String
    payload_path: String
    descriptor_kind: String
    access_mode: String
    element_type: String
    slot: Int
    byte_length: Int

struct CudaTextRange:
    ok: Bool
    start: Int
    end: Int

// ============================================================================
//                    CUDA device-side PTX intrinsic surface
// ============================================================================
// These are intentionally extern-only: the CUDA/PTX backend owns the lowering,
// while normal host/runtime CUDA helpers below stay in Kain.

