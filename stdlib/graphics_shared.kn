    let binding = gpu_binding_plan(-1, GPU_DESCRIPTOR_RAW_IMAGE, GPU_STAGE_FRAGMENT, GPU_ACCESS_READ_WRITE, GPU_QUEUE_GRAPHICS | GPU_QUEUE_TRANSFER)
