pub fn graphics_shared_color_attachment(resource: GpuImage) -> GraphicsSharedImage:
    let binding = gpu_binding_plan(-1, GPU_DESCRIPTOR_RAW_IMAGE, GPU_STAGE_FRAGMENT, GPU_ACCESS_READ_WRITE, GPU_QUEUE_GRAPHICS | GPU_QUEUE_PRESENT | GPU_QUEUE_TRANSFER)
    return GraphicsSharedImage {
        resource: resource,
        binding: binding,
        graphics_kind: GRAPHICS_SHARED_KIND_COLOR_ATTACHMENT,
        ready: graphics_shared_image_ready(resource, GPU_IMAGE_USAGE_COLOR_ATTACHMENT, binding)
    }

