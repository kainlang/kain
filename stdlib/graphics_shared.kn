            GPU_QUEUE_GRAPHICS | GPU_QUEUE_COMPUTE | GPU_QUEUE_TRANSFER | GPU_QUEUE_HOST,
            GPU_LAYOUT_STD140,
            GPU_DESCRIPTOR_UNIFORM_BUFFER
        ),
        GPU_BUFFER_USAGE_UNIFORM | GPU_BUFFER_USAGE_TRANSFER_DST,
        debug_name
    )

