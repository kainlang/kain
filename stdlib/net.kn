pub fn http_server_create(host: String, port: Int) -> Int:
    return abi_http_server_create(host, port)

pub fn http_server_create_localhost(port: Int) -> Int:
    return abi_http_server_create("127.0.0.1", port)

pub fn http_server_listen(server_id: Int) -> Int:
    return abi_http_server_listen(server_id)

