    return abi_http_server_route_actor(server_id, method, path, actor_id, message_kind)

pub fn http_server_pump(server_id: Int, timeout_ms: Int) -> Int:
    return abi_http_server_pump(server_id, timeout_ms)

pub fn http_server_pending_request_count(server_id: Int) -> Int:
    return abi_http_server_pending_request_count(server_id)

