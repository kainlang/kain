@extern
fn kain_native_input_reset() -> Int

@extern
fn kain_native_input_session_create(name: String) -> Int

@extern
fn kain_native_input_session_destroy(session_id: Int) -> Int

@extern
fn kain_native_input_session_count() -> Int

@extern
fn kain_native_input_bind_action(session_id: Int, source_kind: String, event_kind: String, code: String, action: String) -> Int

@extern
fn kain_native_input_bind_axis(session_id: Int, source_kind: String, event_kind: String, code: String, axis: String, scale: Float) -> Int

@extern
fn kain_native_input_push_event(session_id: Int, source_kind: String, source_id: String, event_kind: String, code: String, value: Float, text: String, confidence: Float) -> Int

@extern
fn kain_native_input_push_agent_intent(session_id: Int, source_id: String, action: String, command_text: String, confidence: Float) -> Int

@extern
fn kain_native_input_begin_frame(session_id: Int, delta_ms: Float) -> Int

@extern
fn kain_native_input_frame_index(session_id: Int) -> Int

@extern
fn kain_native_input_event_count(session_id: Int) -> Int

@extern
fn kain_native_input_event_kind(session_id: Int, index: Int) -> String

@extern
fn kain_native_input_event_source_kind(session_id: Int, index: Int) -> String

@extern
fn kain_native_input_event_code(session_id: Int, index: Int) -> String

@extern
fn kain_native_input_event_action(session_id: Int, index: Int) -> String

@extern
fn kain_native_input_event_text(session_id: Int, index: Int) -> String

