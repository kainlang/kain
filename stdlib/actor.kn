pub fn native_actor_send(actor_id: Int, message_name: String, data_payload: String) -> Int:
    return abi_actor_send(actor_id, message_name, data_payload)

pub fn native_actor_id_is_valid(actor_id: Int) -> Bool:
    return actor_id != native_actor_invalid_id()

pub fn native_actor_state_invalid(actor_id: Int) -> Bool:
    return abi_actor_state_invalid(actor_id)

pub fn native_actor_get_state(actor_id: Int) -> Int:
    return abi_actor_get_state(actor_id)

pub fn native_actor_is_running(actor_id: Int) -> Bool:
    return native_actor_get_state(actor_id) == 2

pub fn native_actor_is_terminal(actor_id: Int) -> Bool:
    let actor_status = native_actor_get_state(actor_id)
    if actor_status == 5:
        return true
    return actor_status == 6

