@extern
fn kain_native_runtime_init() -> Int

@extern
fn kain_native_runtime_shutdown() -> Int

@extern
fn kain_native_runtime_heap_validate() -> Int

pub fn native_runtime_init() -> Int:
    return kain_native_runtime_init()

pub fn native_runtime_shutdown() -> Int:
    return kain_native_runtime_shutdown()

pub fn native_runtime_heap_validate() -> Int:
    return kain_native_runtime_heap_validate()

pub fn native_runtime_with_status(status: Int) -> Int:
    if status == 0:
        return native_runtime_init()
    return status

pub fn native_runtime_cleanup_status(status: Int) -> Int:
    let shutdown_status = native_runtime_shutdown()
    if status != 0:
        return status
    return shutdown_status

# root-domain aliases: generated public std names
pub fn runtime_init() -> Int:
    return native_runtime_init()

pub fn runtime_shutdown() -> Int:
    return native_runtime_shutdown()

pub fn runtime_heap_validate() -> Int:
    return native_runtime_heap_validate()

pub fn runtime_with_status(status: Int) -> Int:
    return native_runtime_with_status(status)

pub fn runtime_cleanup_status(status: Int) -> Int:
    return native_runtime_cleanup_status(status)
# end root-domain aliases
