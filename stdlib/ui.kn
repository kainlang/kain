// ui.kn — std::ui — Re-export hub (self-contained)
//
// @extern declarations: the canonical source is std::ui::core.
// This file keeps @extern for backward compatibility.
// Theme constants extracted to std::ui::theme.
// New code should prefer: use std::ui::core, use std::ui::theme

