// ===========================================================================
// CONVENIENCE
// ===========================================================================
pub fn ui_host_session_create(app_name: String, window_title: String, width: Int, height: Int, backend_id: String) -> Int:
    let session = native_ui_session_create(app_name, width, height)
    let _ = native_ui_window_open(session, window_title, width, height)
    let _ = native_ui_host_attach(session, backend_id)
    return session

pub fn ui_present_to_attached_host(session_id: Int) -> Int:
    let _ = native_ui_end_frame(session_id)
    let _ = native_ui_present(session_id)
    return native_ui_host_present(session_id)

