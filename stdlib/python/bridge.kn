pub fn py_bridge_bootstrap():
    py_exec("import importlib.util\n\ndef __kain_module_available(name):\n    return importlib.util.find_spec(name) is not None\n")

pub fn py_bridge_exec(code: String):
    py_exec(code)

pub fn py_bridge_eval(code: String) -> Any:
    return py_eval(code)

pub fn py_bridge_eval_raw(code: String) -> Any:
    return py_eval_raw(code)

pub fn py_bridge_module_available(name: String) -> Bool:
    py_bridge_bootstrap()
    return py_call("__kain_module_available", [name])

pub fn py_bridge_require_module(name: String) -> Any:
    assert(py_bridge_module_available(name), "python module missing: " + name)
    return py_import(name)

pub fn py_bridge_call(target: Any, args: Any) -> Any:
    return py_call(target, args)

pub fn py_bridge_call_kwargs(target: Any, args: Any, kwargs: Any) -> Any:
    return py_call(target, args, kwargs)

pub fn py_bridge_call_attr(target: Any, attr: String, args: Any) -> Any:
    return py_call(target, attr, args)

pub fn py_bridge_call_attr_kwargs(target: Any, attr: String, args: Any, kwargs: Any) -> Any:
    return py_call(target, attr, args, kwargs)

pub fn py_bridge_call_raw(target: Any, args: Any) -> Any:
    return py_call_raw(target, args)

pub fn py_bridge_call_attr_raw(target: Any, attr: String, args: Any) -> Any:
    return py_call_raw(target, attr, args)

pub fn py_bridge_getattr(target: Any, name: String) -> Any:
    return py_getattr(target, name)

pub fn py_bridge_getattr_raw(target: Any, name: String) -> Any:
    return py_getattr_raw(target, name)

pub fn py_bridge_setattr(target: Any, name: String, value: Any):
    py_setattr(target, name, value)

pub fn py_bridge_hasattr(target: Any, name: String) -> Bool:
    return py_hasattr(target, name)

pub fn py_bridge_shared_buffer(target: Any) -> Any:
    return kain_shared_buffer_from_py(target)

pub fn py_bridge_shared_image(target: Any) -> Any:
    return kain_shared_image_from_py(target)
