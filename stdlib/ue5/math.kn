// KAIN UE5 Standard Library - Math
// Maps Unreal Engine's FMath and Vector types

/// Vector types (Automatically mapped to FVector/FVector2D/FVector4 in C++)
type Vec2 = vec2
type Vec3 = vec3
type Vec4 = vec4
type Color = vec4
type Rotation = rotation
type Transform = transform

// --- SCALAR MATH ---

@extern
fn max(a: Float, b: Float) -> Float

@extern
fn min(a: Float, b: Float) -> Float

@extern
fn abs(x: Float) -> Float

@extern
fn sqrt(x: Float) -> Float

@extern
fn pow(base: Float, exp: Float) -> Float

@extern
fn floor(x: Float) -> Float

@extern
fn ceil(x: Float) -> Float

@extern
fn round(x: Float) -> Float

@extern
fn clamp(value: Float, min_val: Float, max_val: Float) -> Float

@extern
fn sin(x: Float) -> Float

@extern
fn cos(x: Float) -> Float

@extern
fn tan(x: Float) -> Float

@extern
fn asin(x: Float) -> Float

@extern
fn acos(x: Float) -> Float

@extern
fn atan(x: Float) -> Float

@extern
fn atan2(y: Float, x: Float) -> Float

@extern
fn random() -> Float

// --- VECTOR MATH ---

@extern
fn Vector_Length(v: Vec3) -> Float

@extern
fn Vector_Normalize(v: Vec3) -> Vec3

@extern
fn Vector_Dot(a: Vec3, b: Vec3) -> Float

@extern
fn Vector_Cross(a: Vec3, b: Vec3) -> Vec3

@extern
fn Vector_Distance(a: Vec3, b: Vec3) -> Float

// --- ROTATION MATH ---

@extern
fn Rotator_GetForwardVector(r: Rotation) -> Vec3

@extern
fn Rotator_GetRightVector(r: Rotation) -> Vec3

@extern
fn Rotator_GetUpVector(r: Rotation) -> Vec3

// --- INTERPOLATION ---

@extern
fn Lerp(a: Float, b: Float, alpha: Float) -> Float

@extern
fn VLerp(a: Vec3, b: Vec3, alpha: Float) -> Vec3

@extern
fn RLerp(a: Rotation, b: Rotation, alpha: Float, shortest_path: Bool) -> Rotation

@extern
fn FInterpTo(current: Float, target: Float, delta_time: Float, speed: Float) -> Float

@extern
fn VInterpTo(current: Vec3, target: Vec3, delta_time: Float, speed: Float) -> Vec3
