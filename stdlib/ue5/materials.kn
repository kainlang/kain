# Material Functions
# Material parameter control for dynamic material instances

# Scalar Parameters
@extern
fn SetScalarParameter(material: Material, param_name: String, value: Float)

@extern
fn GetScalarParameter(material: Material, param_name: String) -> Float

# Vector Parameters
@extern
fn SetVectorParameter(material: Material, param_name: String, value: Vec3)

@extern
fn GetVectorParameter(material: Material, param_name: String) -> Vec3

# Texture Parameters
@extern
fn SetTextureParameter(material: Material, param_name: String, tex: TextureObject)

# Material Instance Management
@extern
fn CreateDynamicMaterialInstance(material: Material) -> Material

@extern
fn SetMaterial(mesh: MeshComponent, slot: Int, material: Material)

@extern
fn GetMaterial(mesh: MeshComponent, slot: Int) -> Material

# Additional Parameter Functions
@extern
fn SetScalarParameterValueByInfo(material: Material, param_info: String, value: Float)

@extern
fn SetVectorParameterValueByInfo(material: Material, param_info: String, value: Vec3)

@extern
fn GetMaterialParameterCollection(collection_name: String) -> MaterialParameterCollection

@extern
fn SetScalarParameterValueOnMaterials(param_name: String, value: Float)

@extern
fn SetVectorParameterValueOnMaterials(param_name: String, value: Vec3)

@extern
fn ClearParameterValues(material: Material)

# Material Queries
@extern
fn GetBaseMaterial(material: Material) -> Material

@extern
fn GetMaterialInstanceDynamic(mesh: MeshComponent, slot: Int) -> Material

@extern
fn SetMaterialByName(mesh: MeshComponent, material_name: String)

@extern
fn GetNumMaterials(mesh: MeshComponent) -> Int

# Material Properties
@extern
fn SetMaterialOpacity(material: Material, opacity: Float)

@extern
fn SetMaterialEmissive(material: Material, emissive_color: Vec3, intensity: Float)

@extern
fn SetMaterialRoughness(material: Material, roughness: Float)

@extern
fn SetMaterialMetallic(material: Material, metallic: Float)
