# KAIN UE5 Standard Library - Common Type Patterns
# Type definitions used across gameplay systems
# These are marked @stdlib_optional to prevent generation unless explicitly used

# Loot rarity levels for item drops and rewards
@stdlib_optional
enum LootRarity:
    Common
    Uncommon
    Rare
    Epic
    Legendary
    Mythic
    LootRarity_MAX

# Buff types for status effect systems
@stdlib_optional
enum BuffType:
    Damage
    Defense
    Speed
    Healing
    BuffType_MAX

# Inventory slot data structure
@stdlib_optional
struct KainInventorySlot:
    item_id: Int
    quantity: Int
    max_stack: Int

# Health component data structure
@stdlib_optional
struct KainHealthComponent:
    current_health: Float
    max_health: Float
    is_invulnerable: Bool

# Damage type classification for combat systems
@stdlib_optional
enum DamageType:
    Physical
    Fire
    Ice
    Lightning
    Poison
    Holy
    Dark
    DamageType_MAX

# Quest status tracking
@stdlib_optional
enum QuestStatus:
    NotStarted
    InProgress
    Completed
    Failed
    QuestStatus_MAX

# Dialogue node types for conversation systems
enum DialogueNodeType:
    Speech
    Choice
    Condition
    Action
    End
    DialogueNodeType_MAX

# Crafting recipe data structure
struct CraftingRecipe:
    recipe_id: Int
    required_items: Array<Int>
    required_quantities: Array<Int>
    output_item_id: Int
    output_quantity: Int
    crafting_time: Float

# Save game data structure
struct SaveGameData:
    save_slot: Int
    player_level: Int
    player_experience: Int
    current_location: String
    play_time_seconds: Float

# Achievement data structure
struct AchievementData:
    achievement_id: Int
    achievement_name: String
    is_unlocked: Bool
    unlock_timestamp: Float
    progress: Float

# Skill tree node structure
struct SkillTreeNode:
    skill_id: Int
    skill_name: String
    skill_level: Int
    max_level: Int
    is_unlocked: Bool
    required_skill_ids: Array<Int>

# Status effect data structure
struct StatusEffect:
    effect_id: Int
    effect_type: BuffType
    duration: Float
    remaining_time: Float
    stack_count: Int
    max_stacks: Int

# Weapon stats structure
struct WeaponStats:
    base_damage: Float
    attack_speed: Float
    crit_chance: Float
    crit_multiplier: Float
    durability: Float
    max_durability: Float

# Armor stats structure
struct ArmorStats:
    defense_rating: Float
    damage_reduction: Float
    weight: Float
    durability: Float
    max_durability: Float
