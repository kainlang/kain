# Actor Functions
# Common AActor functions for UE5 actors

# ============================================================================
# Location and Transform
# ============================================================================

/// Get the actor's current world location
///
/// # Returns
/// Vec3 - The actor's location in world space
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorLocation() -> Vec3

/// Set the actor's world location
///
/// # Parameters
/// - location: Vec3 - The new world location for the actor
///
/// # Side Effects
/// Modifies actor transform, may trigger collision events
@extern
fn SetActorLocation(location: Vec3)

/// Get the actor's current world rotation
///
/// # Returns
/// Rotator - The actor's rotation in world space (pitch, yaw, roll)
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorRotation() -> Rotator

/// Set the actor's world rotation
///
/// # Parameters
/// - rotation: Rotator - The new world rotation for the actor
///
/// # Side Effects
/// Modifies actor transform, may trigger collision events
@extern
fn SetActorRotation(rotation: Rotator)

/// Get the actor's current world scale
///
/// # Returns
/// Vec3 - The actor's scale in world space (X, Y, Z)
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorScale() -> Vec3

/// Set the actor's world scale
///
/// # Parameters
/// - scale: Vec3 - The new world scale for the actor (X, Y, Z)
///
/// # Side Effects
/// Modifies actor transform, affects collision bounds
@extern
fn SetActorScale(scale: Vec3)

# ============================================================================
# Direction Vectors
# ============================================================================

/// Get the actor's forward direction vector (X axis)
///
/// # Returns
/// Vec3 - Normalized forward vector in world space
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorForwardVector() -> Vec3

/// Get the actor's right direction vector (Y axis)
///
/// # Returns
/// Vec3 - Normalized right vector in world space
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorRightVector() -> Vec3

/// Get the actor's up direction vector (Z axis)
///
/// # Returns
/// Vec3 - Normalized up vector in world space
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorUpVector() -> Vec3

# ============================================================================
# Actor Lifecycle
# ============================================================================

/// Destroy this actor and remove it from the world
///
/// # Side Effects
/// Destroys actor, triggers EndPlay, removes from world, cleans up components
///
/// # Note
/// Actor is not immediately deleted but marked for destruction
@extern
fn DestroyActor()

/// Calculate distance from this actor to another actor
///
/// # Parameters
/// - other: Actor - The target actor to measure distance to
///
/// # Returns
/// Float - Distance in world units between actor origins
///
/// # Side Effects
/// None (read-only)
@extern
fn GetDistanceTo(other: Actor) -> Float

/// Set whether the actor is hidden in game
///
/// # Parameters
/// - hidden: Bool - True to hide actor, false to show
///
/// # Side Effects
/// Modifies actor visibility, affects rendering
@extern
fn SetActorHiddenInGame(hidden: Bool)

/// Enable or disable collision for this actor
///
/// # Parameters
/// - enable: Bool - True to enable collision, false to disable
///
/// # Side Effects
/// Modifies collision state, affects physics interactions
@extern
fn SetActorEnableCollision(enable: Bool)

# ============================================================================
# Actor Properties
# ============================================================================

/// Get the actor's bounding box extents
///
/// # Returns
/// Vec3 - Half-extents of the actor's bounding box (X, Y, Z)
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorBounds() -> Vec3

/// Check if the actor is currently being destroyed
///
/// # Returns
/// Bool - True if actor is pending destruction, false otherwise
///
/// # Side Effects
/// None (read-only)
@extern
fn IsActorBeingDestroyed() -> Bool

# ============================================================================
# Movement
# ============================================================================

/// Add an offset to the actor's world location
///
/// # Parameters
/// - offset: Vec3 - The offset to add in world space
///
/// # Side Effects
/// Modifies actor location, may trigger collision events, respects collision
@extern
fn AddActorWorldOffset(offset: Vec3)

/// Add a rotation to the actor's world rotation
///
/// # Parameters
/// - rotation: Rotator - The rotation to add in world space
///
/// # Side Effects
/// Modifies actor rotation, may trigger collision events
@extern
fn AddActorWorldRotation(rotation: Rotator)

# ============================================================================
# Lifetime Management
# ============================================================================

/// Set the actor's lifespan in seconds
///
/// # Parameters
/// - seconds: Float - Time in seconds before actor is automatically destroyed (0 = infinite)
///
/// # Side Effects
/// Sets destruction timer, actor will be destroyed after specified time
@extern
fn SetLifeSpan(seconds: Float)

/// Get the actor's remaining lifespan
///
/// # Returns
/// Float - Remaining time in seconds before destruction (0 = infinite)
///
/// # Side Effects
/// None (read-only)
@extern
fn GetLifeSpan() -> Float

# ============================================================================
# Attachment
# ============================================================================

/// Attach this actor to another actor
///
/// # Parameters
/// - parent: Actor - The actor to attach to
///
/// # Side Effects
/// Creates attachment relationship, actor moves with parent
@extern
fn AttachToActor(parent: Actor)

/// Detach this actor from its parent
///
/// # Side Effects
/// Breaks attachment relationship, actor becomes independent
@extern
fn DetachFromActor()

/// Get all actors attached to this actor
///
/// # Returns
/// Array<Actor> - List of child actors attached to this actor
///
/// # Side Effects
/// None (read-only)
@extern
fn GetAttachedActors() -> Array<Actor>

/// Get the parent actor this actor is attached to
///
/// # Returns
/// Actor - The parent actor, or null if not attached
///
/// # Side Effects
/// None (read-only)
@extern
fn GetAttachParentActor() -> Actor

/// Attach this actor to a specific component
///
/// # Parameters
/// - target_component: SceneComponent - The component to attach to
///
/// # Side Effects
/// Creates attachment relationship, actor moves with component
@extern
fn AttachToComponent(target_component: SceneComponent)

# ============================================================================
# Velocity and Physics
# ============================================================================

/// Get the actor's current velocity
///
/// # Returns
/// Vec3 - The actor's velocity in world space (units per second)
///
/// # Side Effects
/// None (read-only)
@extern
fn GetVelocity() -> Vec3

/// Set the actor's velocity
///
/// # Parameters
/// - velocity: Vec3 - The new velocity in world space (units per second)
///
/// # Side Effects
/// Modifies actor velocity, affects physics simulation
@extern
fn SetVelocity(velocity: Vec3)

/// Get the actor's angular velocity
///
/// # Returns
/// Vec3 - The actor's angular velocity (radians per second)
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorAngularVelocity() -> Vec3

/// Set the actor's angular velocity
///
/// # Parameters
/// - angular_velocity: Vec3 - The new angular velocity (radians per second)
///
/// # Side Effects
/// Modifies actor angular velocity, affects physics simulation
@extern
fn SetActorAngularVelocity(angular_velocity: Vec3)

# ============================================================================
# Teleportation
# ============================================================================

/// Teleport the actor to a new location and rotation
///
/// # Parameters
/// - location: Vec3 - The target world location
/// - rotation: Rotator - The target world rotation
///
/// # Returns
/// Bool - True if teleport succeeded, false if blocked by collision
///
/// # Side Effects
/// Instantly moves actor, ignores collision during teleport, may trigger overlap events
@extern
fn TeleportTo(location: Vec3, rotation: Rotator) -> Bool

# ============================================================================
# Relative Transform
# ============================================================================

/// Set the actor's location relative to its parent
///
/// # Parameters
/// - location: Vec3 - The new relative location
///
/// # Side Effects
/// Modifies actor transform relative to parent
@extern
fn SetActorRelativeLocation(location: Vec3)

/// Set the actor's rotation relative to its parent
///
/// # Parameters
/// - rotation: Rotator - The new relative rotation
///
/// # Side Effects
/// Modifies actor transform relative to parent
@extern
fn SetActorRelativeRotation(rotation: Rotator)

/// Set the actor's scale relative to its parent
///
/// # Parameters
/// - scale: Vec3 - The new relative scale (X, Y, Z)
///
/// # Side Effects
/// Modifies actor transform relative to parent
@extern
fn SetActorRelativeScale3D(scale: Vec3)

/// Get the actor's location relative to its parent
///
/// # Returns
/// Vec3 - The relative location
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorRelativeLocation() -> Vec3

/// Get the actor's rotation relative to its parent
///
/// # Returns
/// Rotator - The relative rotation
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorRelativeRotation() -> Rotator

/// Get the actor's scale relative to its parent
///
/// # Returns
/// Vec3 - The relative scale (X, Y, Z)
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorRelativeScale3D() -> Vec3

# ============================================================================
# Component Access
# ============================================================================

/// Get a component of the actor by class name
///
/// # Parameters
/// - component_class: String - The component class name (e.g., "StaticMeshComponent")
///
/// # Returns
/// Component - The first component of the specified class, or null if not found
///
/// # Side Effects
/// None (read-only)
@extern
fn GetComponentByClass(component_class: String) -> Component

/// Get all components of the actor by class name
///
/// # Parameters
/// - component_class: String - The component class name (e.g., "StaticMeshComponent")
///
/// # Returns
/// Array<Component> - List of all components of the specified class
///
/// # Side Effects
/// None (read-only)
@extern
fn GetComponentsByClass(component_class: String) -> Array<Component>

/// Get the actor's root component
///
/// # Returns
/// SceneComponent - The root component that defines the actor's transform
///
/// # Side Effects
/// None (read-only)
@extern
fn GetRootComponent() -> SceneComponent

# ============================================================================
# Transform Operations
# ============================================================================

/// Add an offset to the actor's location in local space
///
/// # Parameters
/// - offset: Vec3 - The offset to add in local space
///
/// # Side Effects
/// Modifies actor location, may trigger collision events
@extern
fn AddActorLocalOffset(offset: Vec3)

/// Add a rotation to the actor's rotation in local space
///
/// # Parameters
/// - rotation: Rotator - The rotation to add in local space
///
/// # Side Effects
/// Modifies actor rotation, may trigger collision events
@extern
fn AddActorLocalRotation(rotation: Rotator)

/// Set the actor's complete transform (location, rotation, scale)
///
/// # Parameters
/// - location: Vec3 - The new world location
/// - rotation: Rotator - The new world rotation
/// - scale: Vec3 - The new world scale (X, Y, Z)
///
/// # Side Effects
/// Modifies actor transform, may trigger collision events
@extern
fn SetActorTransform(location: Vec3, rotation: Rotator, scale: Vec3)

/// Get the actor's complete transform
///
/// # Returns
/// Transform - The actor's world transform (location, rotation, scale)
///
/// # Side Effects
/// None (read-only)
@extern
fn GetActorTransform() -> Transform

# ============================================================================
# Actor Tags
# ============================================================================

/// Check if the actor has a specific tag
///
/// # Parameters
/// - tag: String - The tag name to check
///
/// # Returns
/// Bool - True if actor has the tag, false otherwise
///
/// # Side Effects
/// None (read-only)
@extern
fn ActorHasTag(tag: String) -> Bool

/// Add a tag to the actor
///
/// # Parameters
/// - tag: String - The tag name to add
///
/// # Side Effects
/// Adds tag to actor's tag list, enables tag-based queries
@extern
fn AddActorTag(tag: String)

/// Remove a tag from the actor
///
/// # Parameters
/// - tag: String - The tag name to remove
///
/// # Side Effects
/// Removes tag from actor's tag list
@extern
fn RemoveActorTag(tag: String)

# ============================================================================
# Actor Queries
# ============================================================================

/// Get the actor's owner
///
/// # Returns
/// Actor - The owning actor, or null if no owner
///
/// # Side Effects
/// None (read-only)
@extern
fn GetOwner() -> Actor

/// Set the actor's owner
///
/// # Parameters
/// - owner: Actor - The new owning actor
///
/// # Side Effects
/// Sets ownership relationship, affects replication and authority
@extern
fn SetOwner(owner: Actor)

/// Get the actor's instigator
///
/// # Returns
/// Actor - The instigating actor, or null if no instigator
///
/// # Side Effects
/// None (read-only)
@extern
fn GetInstigator() -> Actor

/// Set the actor's instigator
///
/// # Parameters
/// - instigator: Actor - The new instigating actor
///
/// # Side Effects
/// Sets instigator relationship, used for damage attribution
@extern
fn SetInstigator(instigator: Actor)
