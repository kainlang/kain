# World Functions
# Common UWorld functions for time, spawning, and world queries

# Time Functions
@extern
fn GetWorldTimeSeconds() -> Float

@extern
fn GetWorldDeltaSeconds() -> Float

# Network Context
@extern
fn IsServer() -> Bool

@extern
fn IsClient() -> Bool

@extern
fn IsStandalone() -> Bool

# Actor Spawning
@extern
fn SpawnActor(class_name: String, location: Vec3, rotation: Rotator) -> Actor

@extern
fn SpawnActorDeferred(class_name: String, location: Vec3, rotation: Rotator) -> Actor

@extern
fn FinishSpawningActor(spawned: Actor)

# Debug Output
@extern
fn PrintToScreen(message: String)

@extern
fn PrintToLog(message: String)

# Game Framework
@extern
fn GetGameMode() -> Actor

@extern
fn GetGameState() -> Actor

@extern
fn GetPlayerController() -> Actor

@extern
fn GetPlayerPawn() -> Actor

# Line Traces
@extern
fn LineTraceSingle(start: Vec3, end: Vec3, channel: Int) -> Bool

@extern
fn LineTraceMulti(start: Vec3, end: Vec3, channel: Int) -> Array<Actor>

@extern
fn SphereTraceSingle(start: Vec3, end: Vec3, radius: Float, channel: Int) -> Bool

@extern
fn BoxTraceSingle(start: Vec3, end: Vec3, half_size: Vec3, channel: Int) -> Bool

# Additional Line Traces
@extern
fn SphereTraceMulti(start: Vec3, end: Vec3, radius: Float, channel: Int) -> Array<Actor>

@extern
fn BoxTraceMulti(start: Vec3, end: Vec3, half_size: Vec3, channel: Int) -> Array<Actor>

@extern
fn CapsuleTraceSingle(start: Vec3, end: Vec3, radius: Float, half_height: Float, channel: Int) -> Bool

@extern
fn CapsuleTraceMulti(start: Vec3, end: Vec3, radius: Float, half_height: Float, channel: Int) -> Array<Actor>

# Sound Functions
@extern
fn SpawnSound2D(sound_asset: String, volume: Float, pitch: Float) -> Bool

@extern
fn SpawnSoundAtLocation(sound_asset: String, location: Vec3, volume: Float, pitch: Float) -> Bool

@extern
fn SpawnSoundAttached(sound_asset: String, attach_component: Component, volume: Float, pitch: Float) -> Bool

# Debug Drawing
@extern
fn DrawDebugLine(start: Vec3, end: Vec3, color: Vec3, duration: Float, thickness: Float)

@extern
fn DrawDebugSphere(center: Vec3, radius: Float, color: Vec3, duration: Float)

@extern
fn DrawDebugBox(center: Vec3, extent: Vec3, color: Vec3, duration: Float)

@extern
fn DrawDebugCapsule(center: Vec3, half_height: Float, radius: Float, color: Vec3, duration: Float)

@extern
fn DrawDebugString(location: Vec3, text: String, color: Vec3, duration: Float)

@extern
fn DrawDebugArrow(start: Vec3, end: Vec3, color: Vec3, duration: Float, thickness: Float)

# World Queries
@extern
fn GetAllActorsOfClass(class_name: String) -> Array<Actor>

@extern
fn GetAllActorsWithTag(tag: String) -> Array<Actor>

@extern
fn GetActorCount() -> Int

# Gravity and Physics
@extern
fn GetGravityZ() -> Float

@extern
fn SetGravityZ(gravity: Float)
