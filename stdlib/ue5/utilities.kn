# Utility Functions
# Pure KAIN helper functions for common operations

# Math Utilities
@blueprint
fn remap(value: Float, in_min: Float, in_max: Float, out_min: Float, out_max: Float) -> Float:
    let normalized = (value - in_min) / (in_max - in_min)
    return out_min + normalized * (out_max - out_min)

@blueprint
fn smooth_step(edge0: Float, edge1: Float, x: Float) -> Float:
    let t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)

@blueprint
fn lerp_color(a: Vec3, b: Vec3, alpha: Float) -> Vec3:
    let r = a.x + (b.x - a.x) * alpha
    let g = a.y + (b.y - a.y) * alpha
    let b_val = a.z + (b.z - a.z) * alpha
    return vec3(r, g, b_val)

@blueprint
fn distance_2d(a: Vec2, b: Vec2) -> Float:
    let dx = b.x - a.x
    let dy = b.y - a.y
    return sqrt(dx * dx + dy * dy)

# Random Utilities
@blueprint
fn random_range(min: Float, max: Float) -> Float:
    let rand_val = random()
    return min + rand_val * (max - min)

@blueprint
fn random_int_range(min: Int, max: Int) -> Int:
    let range = max - min + 1
    let rand_val = random()
    return min + floor(rand_val * range)

@blueprint
fn random_bool(probability: Float) -> Bool:
    return random() < probability

@blueprint
fn weighted_random(weights: Array<Float>) -> Int:
    let total_weight = 0.0
    let i = 0
    while i < weights.len():
        total_weight = total_weight + weights[i]
        i = i + 1
    
    let rand_val = random() * total_weight
    let cumulative = 0.0
    let j = 0
    while j < weights.len():
        cumulative = cumulative + weights[j]
        if rand_val <= cumulative:
            return j
        j = j + 1
    
    return weights.len() - 1

# Clamping and Normalization
@blueprint
fn clamp_01(value: Float) -> Float:
    if value < 0.0:
        return 0.0
    if value > 1.0:
        return 1.0
    return value

@blueprint
fn normalize_angle(angle: Float) -> Float:
    let normalized = angle
    while normalized > 180.0:
        normalized = normalized - 360.0
    while normalized < -180.0:
        normalized = normalized + 360.0
    return normalized

# Formatting Utilities
@blueprint
fn format_time(seconds: Float) -> String:
    let total_seconds = floor(seconds)
    let minutes = floor(total_seconds / 60.0)
    let remaining_seconds = total_seconds - (minutes * 60.0)
    
    if minutes > 0.0:
        return "{minutes}m {remaining_seconds}s"
    return "{remaining_seconds}s"

@blueprint
fn format_number(value: Float, decimals: Int) -> String:
    let multiplier = pow(10.0, decimals)
    let rounded = round(value * multiplier) / multiplier
    return "{rounded}"

# Advanced Math Utilities
@blueprint
fn remap_clamped(value: Float, in_min: Float, in_max: Float, out_min: Float, out_max: Float) -> Float:
    let clamped = clamp(value, in_min, in_max)
    let normalized = (clamped - in_min) / (in_max - in_min)
    return out_min + normalized * (out_max - out_min)

@blueprint
fn inverse_lerp(a: Float, b: Float, value: Float) -> Float:
    if abs(b - a) < 0.0001:
        return 0.0
    return (value - a) / (b - a)

@blueprint
fn ease_in_out(t: Float) -> Float:
    let clamped = clamp_01(t)
    return clamped * clamped * (3.0 - 2.0 * clamped)

# Vector Utilities
@blueprint
fn random_unit_vector() -> Vec3:
    let theta = random() * 6.28318530718
    let phi = acos(2.0 * random() - 1.0)
    let x = sin(phi) * cos(theta)
    let y = sin(phi) * sin(theta)
    let z = cos(phi)
    return vec3(x, y, z)

@blueprint
fn random_point_in_sphere(radius: Float) -> Vec3:
    let dir = random_unit_vector()
    let r = pow(random(), 0.333333) * radius
    return vec3(dir.x * r, dir.y * r, dir.z * r)

@blueprint
fn clamp_vector(v: Vec3, min_val: Float, max_val: Float) -> Vec3:
    let x = clamp(v.x, min_val, max_val)
    let y = clamp(v.y, min_val, max_val)
    let z = clamp(v.z, min_val, max_val)
    return vec3(x, y, z)

@blueprint
fn clamp_angle(angle: Float, min_angle: Float, max_angle: Float) -> Float:
    let normalized = normalize_angle(angle)
    return clamp(normalized, min_angle, max_angle)

# Numeric Utilities
@blueprint
fn sign(value: Float) -> Float:
    if value > 0.0:
        return 1.0
    if value < 0.0:
        return -1.0
    return 0.0

@blueprint
fn wrap(value: Float, min_val: Float, max_val: Float) -> Float:
    let range = max_val - min_val
    if range <= 0.0:
        return min_val
    let offset = value - min_val
    return min_val + (offset - floor(offset / range) * range)

@blueprint
fn ping_pong(t: Float, length: Float) -> Float:
    let t_mod = t - floor(t / length) * length
    return length - abs(t_mod - length)

# String Formatting Utilities
@blueprint
fn format_vector(v: Vec3) -> String:
    return "({v.x}, {v.y}, {v.z})"

@blueprint
fn format_percentage(value: Float) -> String:
    let percent = value * 100.0
    return "{percent}%"

@blueprint
fn parse_float(str: String) -> Float:
    return 0.0

@blueprint
fn parse_int(str: String) -> Int:
    return 0
