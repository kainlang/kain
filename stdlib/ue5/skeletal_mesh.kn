# Skeletal Mesh Functions
# Animation and skeletal mesh control for character systems

# Animation Playback
@extern
fn PlayAnimation(mesh: SkeletalMesh, anim_name: String)

@extern
fn StopAnimation(mesh: SkeletalMesh)

@extern
fn SetAnimationSpeed(mesh: SkeletalMesh, speed: Float)

@extern
fn IsAnimationPlaying(mesh: SkeletalMesh) -> Bool

# Bone Manipulation
@extern
fn GetBoneLocation(mesh: SkeletalMesh, bone_name: String) -> Vec3

@extern
fn GetBoneRotation(mesh: SkeletalMesh, bone_name: String) -> Rotator

@extern
fn SetBoneTransform(mesh: SkeletalMesh, bone_name: String, location: Vec3, rotation: Rotator)

# Socket Operations
@extern
fn AttachToSocket(mesh: SkeletalMesh, socket_name: String, target: Actor)

@extern
fn GetSocketLocation(mesh: SkeletalMesh, socket_name: String) -> Vec3

@extern
fn GetSocketRotation(mesh: SkeletalMesh, socket_name: String) -> Rotator

# Physics and Ragdoll
@extern
fn EnableRagdoll(mesh: SkeletalMesh)

@extern
fn DisableRagdoll(mesh: SkeletalMesh)

@extern
fn AddImpulseToBone(mesh: SkeletalMesh, bone_name: String, impulse: Vec3)

# Morph Targets
@extern
fn SetMorphTarget(mesh: SkeletalMesh, morph_name: String, value: Float)

@extern
fn GetMorphTarget(mesh: SkeletalMesh, morph_name: String) -> Float

# Animation Montage
@extern
fn PlayAnimMontage(mesh: SkeletalMesh, montage_name: String, play_rate: Float) -> Float

@extern
fn StopAnimMontage(mesh: SkeletalMesh, montage_name: String)

@extern
fn GetCurrentMontage(mesh: SkeletalMesh) -> String

@extern
fn IsPlayingMontage(mesh: SkeletalMesh) -> Bool

# Advanced Bone Manipulation
@extern
fn SetBoneLocationByName(mesh: SkeletalMesh, bone_name: String, location: Vec3)

@extern
fn SetBoneRotationByName(mesh: SkeletalMesh, bone_name: String, rotation: Rotator)

@extern
fn SetBoneTransformByName(mesh: SkeletalMesh, bone_name: String, location: Vec3, rotation: Rotator, scale: Vec3)

@extern
fn GetBoneIndex(mesh: SkeletalMesh, bone_name: String) -> Int

# Socket Queries
@extern
fn GetSocketByName(mesh: SkeletalMesh, socket_name: String) -> Socket

@extern
fn GetAllSocketNames(mesh: SkeletalMesh) -> Array<String>

@extern
fn DoesSocketExist(mesh: SkeletalMesh, socket_name: String) -> Bool

# Animation Blueprint
@extern
fn GetAnimInstance(mesh: SkeletalMesh) -> AnimInstance

@extern
fn SetAnimInstanceClass(mesh: SkeletalMesh, anim_class: String)

# Morph Target Management
@extern
fn ClearMorphTargets(mesh: SkeletalMesh)

@extern
fn GetAllMorphTargetNames(mesh: SkeletalMesh) -> Array<String>

# Physics Simulation
@extern
fn SetAllBodiesSimulatePhysics(mesh: SkeletalMesh, simulate: Bool)

@extern
fn SetAllBodiesPhysicsBlendWeight(mesh: SkeletalMesh, weight: Float)

@extern
fn AddForceToAllBodiesBelow(mesh: SkeletalMesh, bone_name: String, force: Vec3)
