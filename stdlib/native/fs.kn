pub fn native_fs_last_status() -> Int:
    return abi_fs_last_status()

pub fn native_fs_last_error_kind() -> String:
    return abi_fs_last_error_kind()

pub fn native_fs_last_error_message() -> String:
    return abi_fs_last_error_message()

pub fn fs_read_text(path: String) -> String:
    return abi_fs_read_text(path)

pub fn fs_read_text_range(path: String, offset: Int, length: Int) -> String:
    return abi_fs_read_text_range(path, offset, length)

pub fn fs_write_text(path: String, content: String) -> Unit:
    let _status = abi_fs_write_text_len(path, content, len(content))

pub fn fs_append_text(path: String, content: String) -> Unit:
    let _status = abi_fs_append_text_len(path, content, len(content))

pub fn fs_atomic_write_text(path: String, content: String) -> Unit:
    let _status = abi_fs_atomic_write_text_len(path, content, len(content))

pub fn fs_read_bytes_hex(path: String) -> String:
    return abi_fs_read_bytes_hex(path)

pub fn fs_read_byte_range_hex(path: String, offset: Int, length: Int) -> String:
    return abi_fs_read_byte_range_hex(path, offset, length)

pub fn fs_write_bytes_hex(path: String, hex: String) -> Unit:
    let _status = abi_fs_write_bytes_hex(path, hex)

pub fn fs_exists(path: String) -> Bool:
    return abi_fs_exists(path)

pub fn fs_is_file(path: String) -> Bool:
    return abi_fs_is_file(path)

pub fn fs_is_dir(path: String) -> Bool:
    return abi_fs_is_dir(path)

pub fn fs_metadata_text(path: String) -> String:
    return abi_fs_metadata_text(path)

pub fn fs_read_dir_paths_text(path: String) -> String:
    return abi_fs_read_dir_paths_text(path)

pub fn fs_walk_paths_text(path: String) -> String:
    return abi_fs_walk_paths_text(path)

pub fn fs_create_dir_all(path: String) -> Unit:
    let _status = abi_fs_create_dir_all(path)

pub fn fs_copy_file(src: String, dest: String) -> Unit:
    let _status = abi_fs_copy_file(src, dest)

pub fn fs_copy_file_streaming(src: String, dest: String, chunk_size: Int) -> Int:
    return abi_fs_copy_file_streaming(src, dest, chunk_size)

pub fn fs_move_path(src: String, dest: String) -> Unit:
    let _status = abi_fs_move_path(src, dest)

pub fn fs_remove_file(path: String) -> Unit:
    let _status = abi_fs_remove_file(path)

pub fn fs_remove_dir_all(path: String) -> Unit:
    let _status = abi_fs_remove_dir_all(path)

pub fn fs_temp_file(prefix: String) -> String:
    return abi_fs_temp_file(prefix)

pub fn fs_temp_dir(prefix: String) -> String:
    return abi_fs_temp_dir(prefix)

pub fn fs_hash_file(path: String) -> String:
    return abi_fs_hash_file(path)

pub fn fs_path_join(base: String, child: String) -> String:
    return abi_fs_path_join(base, child)

# root-domain aliases: generated public std names
pub fn fs_last_status() -> Int:
    return native_fs_last_status()

pub fn fs_last_error_kind() -> String:
    return native_fs_last_error_kind()

pub fn fs_last_error_message() -> String:
    return native_fs_last_error_message()
# end root-domain aliases
