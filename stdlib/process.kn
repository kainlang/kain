pub fn process_stdio_inherit() -> String:
    return "inherit"

pub fn process_stdio_pipe() -> String:
    return "pipe"

pub fn process_stdio_null() -> String:
    return "null"

pub fn process_reset() -> Int:
    return abi_process_reset()

pub fn process_platform_available() -> Int:
    return abi_process_platform_available()

pub fn process_spec_create(executable: String) -> Int:
    return abi_process_spec_create(executable)

pub fn process_spec_destroy(spec_id: Int) -> Int:
