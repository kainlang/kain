// toggle.kn — std::ui::components::Toggle
//
// Pill-shaped toggle / switch with animated thumb.
// Track uses corner_radius = h/2 for capsule shape.
//
// NOTE: Method calls in JSX render expressions are not yet lowered by LLVM codegen.
// Visual state hardcoded; full interactivity pending codegen fix.

component Toggle(
    checked: Bool,
    disabled: Bool,
):
    state hovered: Bool = false
    state anim_progress: Float = if checked: 1.0 else: 0.0

    fn handle_toggle(_self: Self_):
        if _self.disabled:
            return
        let _ = _self.checked

    fn handle_enter(_self: Self_):
        _self.hovered = true

    fn handle_leave(_self: Self_):
        _self.hovered = false

    render <box fill_color="slider_track" corner_radius={12.0} width={44.0} height={24.0}>
        <box fill_color="text" corner_radius={10.0} width={20.0} height={20.0} />
    </box>
