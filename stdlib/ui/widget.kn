// widget.kn — std::ui::widget — DEPRECATED
//
// Immediate-mode widget library wrapping the C widget ABI.
// Retained for backward compatibility during Phase 4 migration.
// Will be removed in Phase 5.

@extern fn abi_ui_widget_create(session_id: Int) -> Int
@extern fn abi_ui_widget_destroy(ctx_ptr: Int)
@extern fn abi_ui_widget_begin_frame(ctx_ptr: Int)
@extern fn abi_ui_widget_end_frame(ctx_ptr: Int)
@extern fn abi_ui_widget_load_font(ctx_ptr: Int, filepath: String, size: Float) -> Int
@extern fn abi_ui_widget_load_default_font(ctx_ptr: Int, size: Float) -> Int
@extern fn abi_ui_widget_button(ctx_ptr: Int, label: String) -> Bool
@extern fn abi_ui_widget_label(ctx_ptr: Int, text: String) -> Int
@extern fn abi_ui_widget_checkbox(ctx_ptr: Int, label: String, current_value: Int) -> Int
@extern fn abi_ui_widget_slider(ctx_ptr: Int, current_value: Float, lo: Float, hi: Float) -> Int
@extern fn abi_ui_widget_textbox_poll(ctx_ptr: Int, buf_ptr: Int, buf_size: Int) -> Int
@extern fn abi_ui_widget_textbox(ctx_ptr: Int, text: String, max_len: Int) -> String
@extern fn abi_ui_widget_panel_begin(ctx_ptr: Int, title: String, x: Float, y: Float, w: Float, h: Float) -> Int
@extern fn abi_ui_widget_panel_end(ctx_ptr: Int)
@extern fn abi_ui_widget_progress(ctx_ptr: Int, label: String, value: Float, max: Float) -> Int
@extern fn abi_ui_widget_window(ctx_ptr: Int, title: String, x: Float, y: Float, w: Float, h: Float, open: Int) -> Bool
@extern fn abi_ui_widget_layout_row(ctx_ptr: Int, count: Int, widths: ptr<Int>) -> Int
@extern fn abi_ui_widget_layout_column(ctx_ptr: Int, count: Int, heights: ptr<Int>) -> Int
@extern fn abi_ui_widget_layout_set_next(ctx_ptr: Int, w: Int, h: Int) -> Int
@extern fn abi_ui_widget_layout_begin(ctx_ptr: Int, count: Int, layout_type: Int) -> Int
@extern fn abi_ui_widget_layout_set_size(ctx_ptr: Int, index: Int, size: Int) -> Int

pub type WidgetContext = Int

pub struct CheckboxResult:
    toggled: Bool
    value: Bool

pub struct SliderResult:
    changed: Bool
    value: Float

pub fn create(session_id: Int) -> WidgetContext:
    return abi_ui_widget_create(session_id)

pub fn destroy(ctx: WidgetContext):
    if ctx == 0: return
    abi_ui_widget_destroy(ctx)

pub fn w_begin_frame(ctx: WidgetContext):
    abi_ui_widget_begin_frame(ctx)

pub fn w_end_frame(ctx: WidgetContext):
    abi_ui_widget_end_frame(ctx)

pub fn load_font(ctx: WidgetContext, path: String, size: Float) -> Int:
    return abi_ui_widget_load_font(ctx, path, size)

pub fn load_default_font(ctx: WidgetContext, size: Float) -> Int:
    return abi_ui_widget_load_default_font(ctx, size)

pub fn button(ctx: WidgetContext, label: String) -> Bool:
    return abi_ui_widget_button(ctx, label)

pub fn label(ctx: WidgetContext, text: String) -> Int:
    return abi_ui_widget_label(ctx, text)

pub fn checkbox(ctx: WidgetContext, label: String, value: Bool) -> CheckboxResult:
    let packed = abi_ui_widget_checkbox(ctx, label, if value: 1 else: 0)
    let new_val = (packed & 1) != 0
    let toggled = (packed & 2) != 0
    return CheckboxResult { toggled: toggled, value: new_val }

pub fn slider(ctx: WidgetContext, value: Float, lo: Float, hi: Float) -> SliderResult:
    let packed = abi_ui_widget_slider(ctx, value, lo, hi)
    let changed = (packed >> 63) != 0
    let int_val = packed & 0x7FFFFFFFFFFFFFFF
    let result_val = to_float(int_val) * 0.001
    return SliderResult { changed: changed, value: result_val }

pub fn textbox(ctx: WidgetContext, text: String, max_len: Int) -> String:
    return abi_ui_widget_textbox(ctx, text, max_len)

pub fn panel_begin(ctx: WidgetContext, title: String, x: Float, y: Float, w: Float, h: Float) -> Int:
    return abi_ui_widget_panel_begin(ctx, title, x, y, w, h)

pub fn panel_end(ctx: WidgetContext):
    abi_ui_widget_panel_end(ctx)

pub fn progress(ctx: WidgetContext, label: String, value: Float, max: Float) -> Int:
    if max <= 0.0: return 0
    return abi_ui_widget_progress(ctx, label, value, max)

pub fn window(ctx: WidgetContext, title: String, x: Float, y: Float, w: Float, h: Float, open: Bool) -> Bool:
    return abi_ui_widget_window(ctx, title, x, y, w, h, if open: 1 else: 0)

pub fn layout_row(ctx: WidgetContext, count: Int, widths: [Int]):
    let _ = abi_ui_widget_layout_begin(ctx, count, 0)
    var i = 0
    while i < count:
        let _ = abi_ui_widget_layout_set_size(ctx, i, widths[i])
        i = i + 1

pub fn layout_column(ctx: WidgetContext, count: Int, heights: [Int]):
    let _ = abi_ui_widget_layout_begin(ctx, count, 1)
    var i = 0
    while i < count:
        let _ = abi_ui_widget_layout_set_size(ctx, i, heights[i])
        i = i + 1

pub fn layout_set_next(ctx: WidgetContext, w: Int, h: Int):
    abi_ui_widget_layout_set_next(ctx, w, h)
