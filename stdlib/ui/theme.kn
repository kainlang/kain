// ===========================================================================
// Color utility helpers
// ===========================================================================

// Pack a Color to 0xAARRGGBB Int
pub fn color_pack(c: Color) -> Int:
    let ri = (to_int(c.r * 255.0) & 0xFF) << 16
    let gi = (to_int(c.g * 255.0) & 0xFF) << 8
    let bi = to_int(c.b * 255.0) & 0xFF
    let ai = (to_int(c.a * 255.0) & 0xFF) << 24
    return ai | ri | gi | bi

// Create color from packed 0xAARRGGBB integer
pub fn color_from_packed(packed: Int) -> Color:
    let b = to_float(packed & 0xFF) / 255.0
    let g = to_float((packed >> 8) & 0xFF) / 255.0
    let r = to_float((packed >> 16) & 0xFF) / 255.0
    let a = to_float((packed >> 24) & 0xFF) / 255.0
    return Color { r: r, g: g, b: b, a: a }

// Linear interpolate between two colors
pub fn color_lerp(a: Color, b: Color, t: Float) -> Color:
    return Color {
        r: a.r + (b.r - a.r) * t,
        g: a.g + (b.g - a.g) * t,
        b: a.b + (b.b - a.b) * t,
        a: a.a + (b.a - a.a) * t,
    }

// Multiply alpha by factor
pub fn color_with_alpha(c: Color, alpha: Float) -> Color:
    return Color { r: c.r, g: c.g, b: c.b, a: c.a * alpha }

// Blend two colors using source-over alpha compositing
pub fn color_blend(over: Color, under: Color) -> Color:
    let out_a = over.a + under.a * (1.0 - over.a)
    if out_a <= 0.0:
        return Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
    return Color {
        r: (over.r * over.a + under.r * under.a * (1.0 - over.a)) / out_a,
        g: (over.g * over.a + under.g * under.a * (1.0 - over.a)) / out_a,
        b: (over.b * over.a + under.b * under.a * (1.0 - over.a)) / out_a,
        a: out_a,
    }

// Convert 0xAARRGGBB to 0xAABBGGRR (renderer format)
pub fn color_to_renderer_format(val: Int) -> Int:
    let a = (val >> 24) & 0xFF
    let r = (val >> 16) & 0xFF
    let g = (val >> 8) & 0xFF
    let b = val & 0xFF
    return (a << 24) | (b << 16) | (g << 8) | r
