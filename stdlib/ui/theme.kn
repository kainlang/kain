// theme.kn — std::ui::theme — Color, Spacing, Theme, DEFAULT_THEME
//
// Layer: L0 (pure data — no @extern, no C dependency)
//
// Pure Kain theme structs replacing the old style.kn #define constants.
// Colors are represented as Float r/g/b/a (0.0-1.0) with a pack()
// method for 0xAARRGGBB Int conversion when needed.
//
// Theme values match the C widget library colors from ui_widget.h.

// ===========================================================================
// Color struct
// ===========================================================================

pub struct Color:
    r: Float  // 0.0 - 1.0
    g: Float  // 0.0 - 1.0
    b: Float  // 0.0 - 1.0
    a: Float  // 0.0 - 1.0

// Color constructor with float components
pub fn color_rgba(r: Float, g: Float, b: Float, a: Float) -> Color:
    return Color { r: r, g: g, b: b, a: a }

pub fn color_rgb(r: Float, g: Float, b: Float) -> Color:
    return Color { r: r, g: g, b: b, a: 1.0 }

// ===========================================================================
// Spacing struct — consistent 4px grid
// ===========================================================================

pub struct Spacing:
    xs:   Float  // 2px
    sm:   Float  // 4px
    md:   Float  // 8px
    lg:   Float  // 16px
    xl:   Float  // 24px
    xxl:  Float  // 32px
    section: Float  // 48px

pub const SPACING: Spacing = Spacing {
    xs: 2.0, sm: 4.0, md: 8.0, lg: 16.0,
    xl: 24.0, xxl: 32.0, section: 48.0,
}

// ===========================================================================
// CornerRadius struct
// ===========================================================================

pub struct CornerRadius:
    top_left: Float
    top_right: Float
    bottom_right: Float
    bottom_left: Float

pub fn corner_radius(all: Float) -> CornerRadius:
    return CornerRadius {
        top_left: all, top_right: all,
        bottom_right: all, bottom_left: all,
    }

// ===========================================================================
// Theme struct — complete visual theme
// ===========================================================================

pub struct Theme:
    // Core colors
    bg: Color
    surface: Color
    surface2: Color
    header: Color

    // Accent colors
    accent: Color       // primary interactive (teal/green)
    accent2: Color      // secondary accent (blue)
    accent3: Color      // tertiary accent (orange)
    accent4: Color      // destructive/warning (red)

    // Text
    text: Color
    text_dim: Color
    text_inverse: Color

    // Borders
    border: Color
    highlight: Color

    // Button states
    button: Color
    button_hover: Color
    button_press: Color
    button_disabled: Color

    // Input
    input_bg: Color
    input_focus: Color

    // Slider
    slider_track: Color
    slider_fill: Color
    slider_thumb: Color

    // Sizes
    spacing: Spacing
    corner_radius: CornerRadius
    font_size: Float

    // Misc
    border_width: Float
    shadow_opacity: Float

// ===========================================================================
// DEFAULT_THEME — the canonical dark theme matching the C widget library
// ===========================================================================

