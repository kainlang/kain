// component.kn — std::ui::component — DEPRECATED
//
// Bridge between Kain components and the immediate-mode widget system.
// Retained for backward compatibility. Will be removed in Phase 5.
// Uses widget ABI functions declared locally.

@extern fn abi_ui_widget_button(ctx_ptr: Int, label: String) -> Bool
@extern fn abi_ui_widget_label(ctx_ptr: Int, text: String) -> Int
@extern fn abi_ui_widget_checkbox(ctx_ptr: Int, label: String, current_value: Int) -> Int
@extern fn abi_ui_widget_slider(ctx_ptr: Int, current_value: Float, lo: Float, hi: Float) -> Int
@extern fn abi_ui_widget_textbox(ctx_ptr: Int, text: String, max_len: Int) -> String
@extern fn abi_ui_widget_panel_begin(ctx_ptr: Int, title: String, x: Float, y: Float, w: Float, h: Float) -> Int
@extern fn abi_ui_widget_panel_end(ctx_ptr: Int)
@extern fn abi_ui_widget_progress(ctx_ptr: Int, label: String, value: Float, max: Float) -> Int
@extern fn abi_ui_widget_window(ctx_ptr: Int, title: String, x: Float, y: Float, w: Float, h: Float, open: Int) -> Bool
@extern fn abi_ui_widget_layout_set_next(ctx_ptr: Int, w: Int, h: Int) -> Int
@extern fn abi_ui_widget_begin_frame(ctx_ptr: Int)
@extern fn abi_ui_widget_end_frame(ctx_ptr: Int)

pub fn begin_frame(ctx: Int):
    abi_ui_widget_begin_frame(ctx)

pub fn end_frame(ctx: Int):
    abi_ui_widget_end_frame(ctx)

pub fn render_button(ctx: Int, label: String, has_handler: Int, enabled: Int) -> Bool:
    if has_handler == 0 or enabled == 0:
        return false
    return abi_ui_widget_button(ctx, label)

pub fn render_label(ctx: Int, text: String):
    let _ = abi_ui_widget_label(ctx, text)

pub fn render_panel(ctx: Int, title: String, x: Float, y: Float, w: Float, h: Float):
    let _ = abi_ui_widget_panel_begin(ctx, title, x, y, w, h)

pub fn render_panel_end(ctx: Int):
    abi_ui_widget_panel_end(ctx)

pub fn render_checkbox(ctx: Int, label: String, value: Int) -> Int:
    let value_bool = value != 0
    let packed = abi_ui_widget_checkbox(ctx, label, if value_bool: 1 else: 0)
    let new_val = (packed & 1) != 0
    if new_val: return 1
    return 0

pub fn render_slider(ctx: Int, value: Float, lo: Float, hi: Float) -> Float:
    let packed = abi_ui_widget_slider(ctx, value, lo, hi)
    let changed = (packed >> 63) != 0
    if changed:
        let int_val = packed & 0x7FFFFFFFFFFFFFFF
        return to_float(int_val) * 0.001
    return value

pub fn render_textbox(ctx: Int, buf: String, max_len: Int) -> String:
    return abi_ui_widget_textbox(ctx, buf, max_len)

pub fn render_progress(ctx: Int, label: String, value: Float, max: Float):
    let _ = abi_ui_widget_progress(ctx, label, value, max)

pub fn render_window(ctx: Int, title: String, x: Float, y: Float, w: Float, h: Float, open: Int) -> Int:
    let open_bool = open != 0
    let still_open = abi_ui_widget_window(ctx, title, x, y, w, h, if open_bool: 1 else: 0)
    if still_open: return 1
    return 0

pub fn layout_row(ctx: Int, widths: [Int]):
    var i = 0
    while i < len(widths):
        abi_ui_widget_layout_set_next(ctx, widths[i], 0)
        i = i + 1

pub fn layout_column(ctx: Int, heights: [Int]):
    var i = 0
    while i < len(heights):
        abi_ui_widget_layout_set_next(ctx, 0, heights[i])
        i = i + 1

pub fn layout_set_next(ctx: Int, w: Int, h: Int):
    abi_ui_widget_layout_set_next(ctx, w, h)
