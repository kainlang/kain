// style.kn — std::ui::style — DEPRECATED — replaced by std::ui::theme
//
// Color constants and helpers matching the C widget library's theme.
// This legacy module retains old constants for backward compatibility.
// Will be removed in Phase 5. New code: use std::ui::theme

use std::ui::theme

// ============================================================================
// C O R E  C O L O R S  (0xAARRGGBB) — backward-compatible
// ============================================================================

pub const COLOR_BG:          Int = 0xFF1A1A24
pub const COLOR_SURFACE:     Int = 0xFF252540
pub const COLOR_SURFACE2:    Int = 0xFF2E2E48
pub const COLOR_HEADER:      Int = 0xFF1E1E32
pub const COLOR_TITLE_BG:    Int = 0xFF23233C
pub const COLOR_ACCENT:      Int = 0xFF21D4A1
pub const COLOR_ACCENT2:     Int = 0xFF4A90D9
pub const COLOR_ACCENT3:     Int = 0xFFE8914A
pub const COLOR_ACCENT4:     Int = 0xFFE84A5F
pub const COLOR_TEXT:        Int = 0xFFE8E8F0
pub const COLOR_TEXT_DIM:    Int = 0xFF8888A0
pub const COLOR_BORDER:      Int = 0xFF3A3A5C
pub const COLOR_HIGHLIGHT:   Int = 0xFF2A2A4E
pub const COLOR_BUTTON:      Int = 0xFF303050
pub const COLOR_BUTTON_HL:   Int = 0xFF404068
pub const COLOR_BUTTON_PR:   Int = 0xFF505080
pub const COLOR_INPUT_BG:    Int = 0xFF0A0A14
pub const COLOR_SLIDER:      Int = 0xFF3A3A5C
pub const COLOR_SLIDER_F:    Int = 0xFF2A2A44

pub const BUTTON_WIDTH:      Int = 100
pub const BUTTON_HEIGHT:     Int = 30
pub const CHECKBOX_SIZE:     Int = 18
pub const SLIDER_WIDTH:      Int = 200
pub const SLIDER_HEIGHT:     Int = 20
pub const TEXTBOX_WIDTH:     Int = 160
pub const TEXTBOX_HEIGHT:    Int = 26
pub const LABEL_HEIGHT:      Int = 20
pub const PANEL_TITLE_H:     Int = 28
pub const PROGRESS_WIDTH:    Int = 150
pub const PROGRESS_HEIGHT:   Int = 18
pub const WINDOW_TITLE_H:    Int = 32
pub const PADDING:           Int = 8

pub fn ui_color_rgba(r: Int, g: Int, b: Int, a: Int) -> Int:
    return (a << 24) | (r << 16) | (g << 8) | b

pub fn ui_color_rgb(r: Int, g: Int, b: Int) -> Int:
    return 0xFF000000 | (r << 16) | (g << 8) | b

pub fn color_red(c: Int) -> Int:
    return (c >> 16) & 0xFF

pub fn color_green(c: Int) -> Int:
    return (c >> 8) & 0xFF

pub fn color_blue(c: Int) -> Int:
    return c & 0xFF

pub fn color_alpha(c: Int) -> Int:
    return (c >> 24) & 0xFF

pub fn ui_color_lerp(a: Int, b: Int, t: Float) -> Int:
    let ar = color_red(a)
    let ag = color_green(a)
    let ab = color_blue(a)
    let aa = color_alpha(a)
    let br = color_red(b)
    let bg = color_green(b)
    let bb = color_blue(b)
    let ba = color_alpha(b)
    let r = to_int((to_float(ar) + (to_float(br - ar) * t)) + 0.5)
    let g = to_int((to_float(ag) + (to_float(bg - ag) * t)) + 0.5)
    let b = to_int((to_float(ab) + (to_float(bb - ab) * t)) + 0.5)
    let a_val = to_int((to_float(aa) + (to_float(ba - aa) * t)) + 0.5)
    return ui_color_rgba(r, g, b, a_val)

pub fn ui_color_to_floats(c: Int) -> (Float, Float, Float, Float):
    let r = to_float(color_red(c)) / 255.0
    let g = to_float(color_green(c)) / 255.0
    let b = to_float(color_blue(c)) / 255.0
    let a = to_float(color_alpha(c)) / 255.0
    return (r, g, b, a)
