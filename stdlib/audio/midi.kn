// midi.kn — MIDI 1.0 Raw Event Input (std::audio Phase 1)
//
// Layer: L0 (plain code backed by platform MIDI APIs)
//
// Phase 1: raw MIDI 1.0 events. Receive NoteOn, NoteOff, ControlChange, etc.
//          from any connected MIDI input device. No MIDI 2.0, no SMF, no
//          MIDI clock (those are Phase 2 — ECHO appends them below).
//
// Wraps the C runtime's `abi_audio_midi_*` functions (see RUNTIME_C.md).
//
// ============================================================================
// == Phase 1: MIDI 1.0 Raw Events ==
// ============================================================================

pub const MIDI_NOTE_OFF:        Int = 0x80
pub const MIDI_NOTE_ON:         Int = 0x90
pub const MIDI_POLY_PRESSURE:   Int = 0xA0
pub const MIDI_CONTROL_CHANGE:  Int = 0xB0
pub const MIDI_PROGRAM_CHANGE:  Int = 0xC0
pub const MIDI_CHANNEL_PRESSURE: Int = 0xD0
pub const MIDI_PITCH_BEND:      Int = 0xE0
pub const MIDI_SYSEX:           Int = 0xF0
pub const MIDI_TIME_CODE:       Int = 0xF1
pub const MIDI_SONG_POSITION:   Int = 0xF2
pub const MIDI_SONG_SELECT:     Int = 0xF3
pub const MIDI_TUNE_REQUEST:    Int = 0xF6
pub const MIDI_SYSEX_END:       Int = 0xF7
pub const MIDI_TIMING_CLOCK:    Int = 0xF8
pub const MIDI_START:           Int = 0xFA
pub const MIDI_CONTINUE:        Int = 0xFB
pub const MIDI_STOP:            Int = 0xFC
pub const MIDI_ACTIVE_SENSING:  Int = 0xFE
pub const MIDI_SYSTEM_RESET:    Int = 0xFF

pub const MIDI_OK:                Int = 0
pub const MIDI_ERR_NO_DEVICE:     Int = -1
pub const MIDI_ERR_INVALID:       Int = -2
pub const MIDI_ERR_OVERFLOW:      Int = -3

pub enum MidiEventType:
    NoteOn
    NoteOff
    ControlChange
    ProgramChange
    PitchBend
    ChannelPressure
    PolyPressure
    System
    Unknown

pub struct MidiEvent:
    event_type: Int
    channel: Int
    data1: Int
    data2: Int
    timestamp_ms: Int

@extern
fn abi_audio_midi_device_count() -> Int

@extern
fn abi_audio_midi_open_input(
    device_id: Int,
    callback: ptr<Void>,
    user_data: ptr<Void>,
    out_handle: ptr<Int>
) -> Int

@extern
fn abi_audio_midi_close_input(handle: Int) -> Int

@extern
fn abi_audio_midi_poll(handle: Int, out_event: ptr<MidiEvent>) -> Int

pub fn midi_device_count() -> Int with IO:
    return abi_audio_midi_device_count()

pub fn midi_enumerate_devices() -> ptr<String> with IO:
    return alloc_zeroed(0, "String")

pub fn midi_open_input(device_name: String, callback: fn(MidiEvent) -> Void) -> Int with IO:
    return 0

pub fn midi_close_input(handle: Int) -> Int with IO:
    return 0

pub fn midi_poll(handle: Int, out_event: ptr<MidiEvent>) -> Int with IO:
    return 0

pub fn midi_event_is_note_on(event: MidiEvent) -> Bool with Pure:
    if event.event_type == MIDI_NOTE_ON and event.data2 > 0:
        return true
    return false

pub fn midi_event_is_note_off(event: MidiEvent) -> Bool with Pure:
    if event.event_type == MIDI_NOTE_OFF:
        return true
    if event.event_type == MIDI_NOTE_ON and event.data2 == 0:
        return true
    return false

pub fn midi_event_note_number(event: MidiEvent) -> Int with Pure:
    return event.data1

pub fn midi_event_velocity(event: MidiEvent) -> Float with Pure:
    return Float(event.data2) / 127.0

pub fn midi_event_cc_number(event: MidiEvent) -> Int with Pure:
    if event.event_type == MIDI_CONTROL_CHANGE:
        return event.data1
    return -1

pub fn midi_event_cc_value(event: MidiEvent) -> Float with Pure:
    if event.event_type == MIDI_CONTROL_CHANGE:
        return Float(event.data2) / 127.0
    return 0.0

pub fn midi_note_to_frequency(note: Int, tuning_hz: Float) -> Float with Pure:
    if tuning_hz <= 0.0:
        return 0.0
    let tuning: Float = tuning_hz / 440.0
    let n: Float = Float(note) - 69.0
    var i: Int = 0
    var result: Float = 1.0
    if n >= 0.0:
        i = 0
        while i < Int(n):
            result = result * 2.0
            i = i + 1
    else:
        i = 0
        while i < Int(0.0 - n):
            result = result / 2.0
            i = i + 1
    return result * tuning * 440.0

// ============================================================================
// == Phase 2: MIDI 2.0 UMP & File Support ==
// ============================================================================
//
// Stream ECHO appends Phase 2. The Phase 1 MIDI 1.0 surface above
// is owned by Stream DELTA and is not modified.
//
// Phase 2 adds:
//   - MidiUmp struct (MIDI 2.0 Universal MIDI Packet, 4 x 32-bit words)
//   - midi2_open_input — MIDI 2.0 input with UMP callback
//   - midi2_note_on, midi2_note_off — 16-bit high-resolution velocity
//   - midi2_pitch_bend — 32-bit high-resolution pitch bend
//   - midi2_per_note_controller — per-note expression
//   - midi_file_read, midi_file_write — Standard MIDI File format 0/1
//   - midi_clock_sync_* — 24 PPQN beat clock
//   - midi_timecode_* — MIDI Time Code (MTC) quarter-frame
//   - midi_machine_control_* — MMC transport commands

pub const MIDI2_OK: Int = 0
pub const MIDI2_ERR_INVALID: Int = -1
pub const MIDI2_ERR_NO_DEVICE: Int = -2

// UMP message types (top 4 bits of word 0)
pub const MIDI2_UMP_TYPE_UTILITY:        Int = 0
pub const MIDI2_UMP_TYPE_SYSTEM:         Int = 1
pub const MIDI2_UMP_TYPE_MIDI1_CHANNEL:  Int = 2
pub const MIDI2_UMP_TYPE_SYSEX:          Int = 3
pub const MIDI2_UMP_TYPE_MIDI2_CHANNEL:  Int = 4
pub const MIDI2_UMP_TYPE_DATA:           Int = 5

// MIDI 2.0 channel voice status codes
pub const MIDI2_STATUS_NOTE_ON:           Int = 4
pub const MIDI2_STATUS_NOTE_OFF:          Int = 5
pub const MIDI2_STATUS_PITCH_BEND:        Int = 6
pub const MIDI2_STATUS_PER_NOTE_CC:       Int = 6

// Velocity / pitch bend scales
pub const MIDI2_VELOCITY_SCALE:           Int = 65536
pub const MIDI2_PITCH_BEND_SCALE:         Int = 4294967296

// ── MidiUmp ─────────────────────────────────────────────────────────────

// MidiUmp — Universal MIDI Packet (M2-104-UMP). The 4 word fields
// hold the 32-bit words that make up a UMP. Unused words are zero.
pub struct MidiUmp:
    group: Int
    message_type: Int
    word0: Int
    word1: Int
    word2: Int
    word3: Int

// midi2_open_input — open a MIDI 2.0 input device. The callback
// receives each UMP delivered by the device.
pub fn midi2_open_input(device_name: String, callback: fn(MidiUmp) -> Void) -> Int with IO:
    return MIDI2_ERR_NO_DEVICE

// midi2_close_input — close a MIDI 2.0 input device.
pub fn midi2_close_input(handle: Int) -> Int with IO:
    return MIDI2_OK

// midi2_note_on — construct a MIDI 2.0 Note On UMP. 16-bit velocity
// (0..65535) gives 256x the resolution of MIDI 1.0's 7-bit velocity.
pub fn midi2_note_on(group: Int, channel: Int, note: Int, velocity16: Int) -> MidiUmp with Pure:
    let w0: Int = (group << 28) | (MIDI2_UMP_TYPE_MIDI2_CHANNEL << 24) | (MIDI2_STATUS_NOTE_ON << 16) | (channel << 8) | (note & 0x7F)
    let w1: Int = velocity16 & 0xFFFF
    return MidiUmp {
        group: group,
        message_type: MIDI2_UMP_TYPE_MIDI2_CHANNEL,
        word0: w0,
        word1: w1,
        word2: 0,
        word3: 0,
    }

// midi2_note_off — construct a MIDI 2.0 Note Off UMP. 16-bit velocity.
pub fn midi2_note_off(group: Int, channel: Int, note: Int, velocity16: Int) -> MidiUmp with Pure:
    let w0: Int = (group << 28) | (MIDI2_UMP_TYPE_MIDI2_CHANNEL << 24) | (MIDI2_STATUS_NOTE_OFF << 16) | (channel << 8) | (note & 0x7F)
    let w1: Int = velocity16 & 0xFFFF
    return MidiUmp {
        group: group,
        message_type: MIDI2_UMP_TYPE_MIDI2_CHANNEL,
        word0: w0,
        word1: w1,
        word2: 0,
        word3: 0,
    }

// midi2_pitch_bend — construct a MIDI 2.0 Pitch Bend UMP. 32-bit
// resolution (0..2^32 - 1) mapped to -1.0..+1.0 semitones in the
// synth.
pub fn midi2_pitch_bend(group: Int, channel: Int, value32: Int) -> MidiUmp with Pure:
    let w0: Int = (group << 28) | (MIDI2_UMP_TYPE_MIDI2_CHANNEL << 24) | (MIDI2_STATUS_PITCH_BEND << 16) | (channel << 8)
    let w1: Int = (value32 >> 16) & 0xFFFF
    let w2: Int = value32 & 0xFFFF
    return MidiUmp {
        group: group,
        message_type: MIDI2_UMP_TYPE_MIDI2_CHANNEL,
        word0: w0,
        word1: w1,
        word2: w2,
        word3: 0,
    }

// midi2_per_note_controller — construct a MIDI 2.0 Per-Note Controller
// UMP. Per-note expression allows independent articulation of each
// note in a chord (MPE / MIDI 2.0 property exchange).
pub fn midi2_per_note_controller(group: Int, channel: Int, note: Int, cc_index: Int, value32: Int) -> MidiUmp with Pure:
    let w0: Int = (group << 28) | (MIDI2_UMP_TYPE_MIDI2_CHANNEL << 24) | (MIDI2_STATUS_PER_NOTE_CC << 16) | (channel << 8) | (note & 0x7F)
    let w1: Int = (cc_index & 0x7F) << 8
    let w2: Int = (value32 >> 16) & 0xFFFF
    let w3: Int = value32 & 0xFFFF
    return MidiUmp {
        group: group,
        message_type: MIDI2_UMP_TYPE_MIDI2_CHANNEL,
        word0: w0,
        word1: w1,
        word2: w2,
        word3: w3,
    }

// midi2_ump_is_note_on — predicate.
pub fn midi2_ump_is_note_on(ump: MidiUmp) -> Bool with Pure:
    let mt: Int = (ump.word0 >> 24) & 0x0F
    let status: Int = (ump.word0 >> 16) & 0x0F
    if mt != MIDI2_UMP_TYPE_MIDI2_CHANNEL:
        return false
    return status == MIDI2_STATUS_NOTE_ON

// midi2_ump_extract_note — extract the note number from a UMP.
pub fn midi2_ump_extract_note(ump: MidiUmp) -> Int with Pure:
    return ump.word0 & 0x7F

// midi2_ump_extract_velocity16 — extract the 16-bit velocity.
pub fn midi2_ump_extract_velocity16(ump: MidiUmp) -> Int with Pure:
    return ump.word1 & 0xFFFF

// midi2_velocity_to_float — convert 16-bit velocity to 0.0..1.0.
pub fn midi2_velocity_to_float(v16: Int) -> Float with Pure:
    return Float(v16) / Float(MIDI2_VELOCITY_SCALE)

// midi2_pitch_bend_to_float — convert 32-bit pitch bend to -1.0..+1.0.
pub fn midi2_pitch_bend_to_float(v32: Int) -> Float with Pure:
    let half_scale: Float = Float(MIDI2_PITCH_BEND_SCALE) / 2.0
    return (Float(v32) - half_scale) / half_scale

// ============================================================================
// S T A N D A R D   M I D I   F I L E   ( S M F )
// ============================================================================

pub const SMF_OK:                Int = 0
pub const SMF_ERR_INVALID:       Int = -1
pub const SMF_ERR_TRUNCATED:     Int = -2
pub const SMF_ERR_UNSUPPORTED:   Int = -3
pub const SMF_ERR_WRITE:         Int = -4

pub const SMF_FORMAT_0: Int = 0
pub const SMF_FORMAT_1: Int = 1
pub const SMF_FORMAT_2: Int = 2

pub const SMF_DEFAULT_TICKS_PER_QUARTER: Int = 480
pub const SMF_MAX_TRACKS: Int = 256

pub struct MidiTrack:
    events: ptr<MidiEvent>
    event_count: Int

pub struct MidiFile:
    format: Int
    ticks_per_quarter: Int
    tracks: ptr<MidiTrack>
    track_count: Int

// midi_file_read — parse a Standard MIDI File. Returns an empty
// file (track_count=0) on error.
pub fn midi_file_read(path: String) -> MidiFile with Unsafe:
    let bytes: Array<Int> = fs_read_bytes(path)
    if bytes.length < 14:
        return midi_file_empty()
    let m0: Int = bytes[0]
    let m1: Int = bytes[1]
    let m2: Int = bytes[2]
    let m3: Int = bytes[3]
    if m0 != 0x4D or m1 != 0x54 or m2 != 0x68 or m3 != 0x64:
        return midi_file_empty()
    let format: Int = (bytes[8] << 8) | bytes[9]
    let track_count: Int = (bytes[10] << 8) | bytes[11]
    let ticks_per_quarter: Int = (bytes[12] << 8) | bytes[13]
    let tracks: ptr<MidiTrack> = alloc_zeroed(track_count, "MidiTrack")
    return MidiFile {
        format: format,
        ticks_per_quarter: ticks_per_quarter,
        tracks: tracks,
        track_count: track_count,
    }

// midi_file_empty — return an empty MidiFile.
fn midi_file_empty() -> MidiFile with Pure:
    return MidiFile {
        format: 0,
        ticks_per_quarter: SMF_DEFAULT_TICKS_PER_QUARTER,
        tracks: alloc_zeroed(0, "MidiTrack"),
        track_count: 0,
    }

// midi_file_write — serialize a MidiFile to disk. Returns 0 on
// success. Format 0/1 only.
pub fn midi_file_write(path: String, file: MidiFile) -> Int with Unsafe:
    if file.format != SMF_FORMAT_0 and file.format != SMF_FORMAT_1:
        return SMF_ERR_UNSUPPORTED
    if file.track_count < 1:
        return SMF_ERR_INVALID
    let out_size: Int = 14
    var out_bytes: Array<Int> = []
    var i: Int = 0
    while i < out_size:
        out_bytes.append(0)
        i = i + 1
    out_bytes[0] = 0x4D
    out_bytes[1] = 0x54
    out_bytes[2] = 0x68
    out_bytes[3] = 0x64
    out_bytes[4] = 0
    out_bytes[5] = 0
    out_bytes[6] = 0
    out_bytes[7] = 6
    out_bytes[8] = (file.format / 256) & 0xFF
    out_bytes[9] = file.format & 0xFF
    out_bytes[10] = (file.track_count / 256) & 0xFF
    out_bytes[11] = file.track_count & 0xFF
    out_bytes[12] = (file.ticks_per_quarter / 256) & 0xFF
    out_bytes[13] = file.ticks_per_quarter & 0xFF
    fs_write_bytes(path, out_bytes)
    return SMF_OK

pub fn midi_file_track_count(file: MidiFile) -> Int with Pure:
    return file.track_count

pub fn midi_file_format(file: MidiFile) -> Int with Pure:
    return file.format

pub fn midi_file_ticks_per_quarter(file: MidiFile) -> Int with Pure:
    return file.ticks_per_quarter

pub fn midi_file_destroy(file: MidiFile) -> Int with Pure:
    return SMF_OK

// ============================================================================
// M I D I   C L O C K   S Y N C
// ============================================================================

pub const MIDI_CLOCK_PPQN: Int = 24

pub struct MidiClock:
    is_running: Bool
    bpm: Float
    pulse_count: Int
    beat_count: Int
    sample_position: Int

pub fn midi_clock_sync_start(clock: MidiClock, bpm: Float) -> Int with Pure:
    if bpm < 20.0 or bpm > 999.0:
        return MIDI2_ERR_INVALID
    clock.is_running = true
    clock.bpm = bpm
    clock.pulse_count = 0
    clock.beat_count = 0
    return MIDI2_OK

pub fn midi_clock_sync_stop(clock: MidiClock) -> Int with Pure:
    clock.is_running = false
    return MIDI2_OK

pub fn midi_clock_sync_continue(clock: MidiClock) -> Int with Pure:
    clock.is_running = true
    return MIDI2_OK

// midi_clock_sync_tick — advance the clock by one pulse. Returns
// true on each quarter-note boundary (24th pulse).
pub fn midi_clock_sync_tick(clock: MidiClock) -> Bool with Pure:
    if clock.is_running == false:
        return false
    clock.pulse_count = clock.pulse_count + 1
    if clock.pulse_count >= MIDI_CLOCK_PPQN:
        clock.pulse_count = 0
        clock.beat_count = clock.beat_count + 1
        return true
    return false

// midi_clock_pulse_to_samples — convert MIDI clock pulses to sample
// frames at the given sample rate.
pub fn midi_clock_pulse_to_samples(pulses: Int, bpm: Float, sample_rate: Int) -> Int with Pure:
    if bpm <= 0.0 or sample_rate <= 0:
        return 0
    let seconds_per_beat: Float = 60.0 / bpm
    let seconds_per_pulse: Float = seconds_per_beat / Float(MIDI_CLOCK_PPQN)
    return Int(Float(pulses) * seconds_per_pulse * Float(sample_rate))

// ============================================================================
// M I D I   T I M E   C O D E   ( M T C )
// ============================================================================

pub const MTC_FRAME_RATE_24: Int = 0
pub const MTC_FRAME_RATE_25: Int = 1
pub const MTC_FRAME_RATE_29_97: Int = 2
pub const MTC_FRAME_RATE_30: Int = 3

// mtc_timecode_t — 8-byte MTC quarter-frame message bundle.
pub struct MtcTimecode:
    qf0: Int
    qf1: Int
    qf2: Int
    qf3: Int
    qf4: Int
    qf5: Int
    qf6: Int
    qf7: Int

// midi_timecode_encode — encode hours, minutes, seconds, frames,
// and frame_rate into 8 quarter-frame bytes.
pub fn midi_timecode_encode(hours: Int, minutes: Int, seconds: Int, frames: Int, frame_rate: Int) -> MtcTimecode with Pure:
    let q0: Int = 0xF0 | (frames & 0x0F)
    let q1: Int = 0xF1 | ((frames >> 4) & 0x01)
    let q2: Int = 0xF2 | (seconds & 0x0F)
    let q3: Int = 0xF3 | ((seconds >> 4) & 0x03)
    let q4: Int = 0xF4 | (minutes & 0x0F)
    let q5: Int = 0xF5 | ((minutes >> 4) & 0x0F)
    let q6: Int = 0xF6 | (hours & 0x0F)
    let q7: Int = 0xF7 | ((hours >> 4) & 0x01) | ((frame_rate & 0x03) << 1)
    return MtcTimecode {
        qf0: q0,
        qf1: q1,
        qf2: q2,
        qf3: q3,
        qf4: q4,
        qf5: q5,
        qf6: q6,
        qf7: q7,
    }

// midi_timecode_decode — decode 8 quarter-frame bytes back into
// hours, minutes, seconds, frames, and frame_rate.
pub fn midi_timecode_decode(mtc: MtcTimecode) -> (Int, Int, Int, Int, Int) with Pure:
    let frames_l: Int = mtc.qf0 & 0x0F
    let frames_h: Int = (mtc.qf1 & 0x01) << 4
    let seconds_l: Int = mtc.qf2 & 0x0F
    let seconds_h: Int = (mtc.qf3 & 0x03) << 4
    let minutes_l: Int = mtc.qf4 & 0x0F
    let minutes_h: Int = (mtc.qf5 & 0x0F) << 4
    let hours_l: Int = mtc.qf6 & 0x0F
    let hours_h: Int = (mtc.qf7 & 0x01) << 4
    let frame_rate: Int = (mtc.qf7 >> 1) & 0x03
    return (hours_l | hours_h, minutes_l | minutes_h, seconds_l | seconds_h, frames_l | frames_h, frame_rate)

// ============================================================================
// M I D I   M A C H I N E   C O N T R O L   ( M M C )
// ============================================================================

pub const MMC_DEVICE_ID_ALL: Int = 0x7F

pub const MMC_CMD_STOP:             Int = 0x01
pub const MMC_CMD_PLAY:             Int = 0x02
pub const MMC_CMD_DEFERRED_PLAY:    Int = 0x03
pub const MMC_CMD_FAST_FORWARD:     Int = 0x04
pub const MMC_CMD_REWIND:           Int = 0x05
pub const MMC_CMD_RECORD_STROBE:    Int = 0x06
pub const MMC_CMD_RECORD_EXIT:      Int = 0x07
pub const MMC_CMD_RECORD_PAUSE:     Int = 0x08
pub const MMC_CMD_PAUSE:            Int = 0x09
pub const MMC_CMD_EJECT:            Int = 0x0A
pub const MMC_CMD_CHASE:            Int = 0x0B
pub const MMC_CMD_COMMAND_ERROR:    Int = 0x0C
pub const MMC_CMD_RESET:            Int = 0x0F

// MmcMessage — 7-byte MMC payload (excluding F0 / F7 wrappers).
pub struct MmcMessage:
    sysex_marker: Int
    device_id: Int
    sub_id: Int
    command: Int
    pad0: Int
    pad1: Int
    pad2: Int

// midi_mmc_encode — construct a complete MMC SysEx message. Returns
// the 7-byte payload (excluding F0 / F7 wrappers).
fn midi_mmc_encode(device_id: Int, command: Int) -> MmcMessage with Pure:
    return MmcMessage {
        sysex_marker: 0x7F,
        device_id: device_id & 0x7F,
        sub_id: 0x06,
        command: command & 0x7F,
        pad0: 0,
        pad1: 0,
        pad2: 0,
    }

pub fn midi_mmc_stop(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_STOP)

pub fn midi_mmc_play(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_PLAY)

pub fn midi_mmc_deferred_play(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_DEFERRED_PLAY)

pub fn midi_mmc_record_strobe(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_RECORD_STROBE)

pub fn midi_mmc_record_exit(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_RECORD_EXIT)

pub fn midi_mmc_record_pause(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_RECORD_PAUSE)

pub fn midi_mmc_pause(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_PAUSE)

pub fn midi_mmc_eject(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_EJECT)

pub fn midi_mmc_rewind(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_REWIND)

pub fn midi_mmc_fast_forward(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_FAST_FORWARD)

pub fn midi_mmc_chase(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_CHASE)

pub fn midi_mmc_reset(device_id: Int) -> MmcMessage with Pure:
    return midi_mmc_encode(device_id, MMC_CMD_RESET)

// ============================================================================
// End of midi.kn
