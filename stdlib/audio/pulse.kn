// pulse.kn — Audio Transport Clock (std::audio Phase 1)
//
// Layer: L5 (pulse — timed recurrence with budget annotation)
//
// This is the audio heartbeat. The `transport_tick` pulse fires every ~5 ms
// (the audio callback interval) and drives the entire real-time signal path:
//   1. Advance the transport position
//   2. Process the audio graph (orchestrate stage dispatch)
//   3. Detect peak levels (for metering)
//   4. Update mixer meters (auto dual-path by ALPHA's compiler work)
//   5. Deliver the rendered buffer to the audio device (auto dual-path)
//
// The `budget(alloc=0, lock=0, io=0)` clause is a compile-time gate that
// Stream ALPHA is adding to the `pulse` construct. It rejects:
//   - alloc_zeroed / alloc / realloc_mem in the body (alloc=0)
//   - collapse / observe / decay (lock=0)
//   - print / fs_* / import / IO effect functions (io=0)
// Patches called inside the body are AUTO-DUAL-PATHED to a lock-free
// teleport-channel send (see research/audio/COMPILER_WORK.md §2).
//
// This file is expected to FAIL `kain check` until ALPHA's compiler work
// ships. The body of every function is correct Kain and the `budget(...)`
// clause is in the exact syntax MODULES.md specifies; only the parser/TC
// support is missing.
//
// Imports: We import the sibling modules CHARLIE will own. The import is
// lenient (matches my earlier experiment) so this file typechecks the
// signature shape even when those modules don't exist yet.

use std::audio::world
use std::audio::orchestrate
use std::audio::device
use std::audio::patch

// ============================================================================
// H E L P E R   F U N C T I O N S
// ============================================================================
//
// All helpers below are defined before the pulse so the pulse body can call
// them. Helpers must NOT use:
//   - alloc / alloc_zeroed / realloc_mem
//   - collapse / observe / decay
//   - print / fs_* / import / Unsafe / IO
// They are all `with Pure` so the pulse body can call them inside the
// budget(alloc=0, lock=0, io=0) scope.

// transport_advance_position — move the playhead forward by `frames`.
// If the loop is enabled and the position reaches the loop end, wrap to
// the loop start. This is called from the pulse body and is the
// canonical transport clock. The world reference is a singleton
// (MixerWorld is compiler-owned; access is direct).
pub fn transport_advance_position(frames: Int) -> Int with Pure:
    let cur: Int = MixerWorld.transport_position_frames
    let next: Int = cur + frames
    var landed: Int = next
    if MixerWorld.transport_loop_enabled:
        let loop_end: Int = MixerWorld.transport_loop_end
        let loop_start: Int = MixerWorld.transport_loop_start
        if loop_end > loop_start and landed >= loop_end:
            landed = loop_start + ((landed - loop_start) % (loop_end - loop_start))
    MixerWorld.transport_position_frames = landed
    return landed

// audio_peak_detect — Phase 1 stub. Returns the current MixerWorld peak
// value for the given channel. The full implementation (walking the output
// buffer) will be added in Phase 2 when the C runtime buffer bridge is
// wired.
pub fn audio_peak_detect(channel: Int) -> Float with Pure:
    if channel == 0:
        return MixerWorld.peak_left
    if channel == 1:
        return MixerWorld.peak_right
    return 0.0

// audio_rms_detect — Phase 1 stub. Returns the current MixerWorld RMS
// value for the given channel. Full RMS computation (windowed envelope
// follower) will be added in Phase 2.
pub fn audio_rms_detect(channel: Int) -> Float with Pure:
    if channel == 0:
        return MixerWorld.rms_left
    if channel == 1:
        return MixerWorld.rms_right
    return 0.0

// audio_device_deliver — Phase 1 stub. In Phase 2, this will enqueue the
// output buffer to the C runtime via a lock-free teleport channel. For now,
// it returns 0 (success) since the audio callback is handled by the
// C runtime directly.
pub fn audio_device_deliver() -> Int with Pure:
    // Phase 1: the C runtime handles delivery via the audio callback.
    // Phase 2 will wire a teleport-channel enqueue here.
    return 0

// abs_local — local Float abs. Same polyfill as dsp.kn.
fn abs_local(v: Float) -> Float with Pure:
    if v < 0.0:
        return 0.0 - v
    return v

// sqrt_local — local Float sqrt via Newton's method (one step from 1.0).
// std::math has `sqrt` as a built-in intrinsic; we keep a local fallback
// for clarity and to avoid any cross-module dependency inside a pulse body.
fn sqrt_local(v: Float) -> Float with Pure:
    if v <= 0.0:
        return 0.0
    return sqrt(v)

// ============================================================================
// T R A N S P O R T   T I C K   P U L S E
// ============================================================================
//
// The audio callback's heart. Every ~5 ms the runtime fires this pulse.
// The budget(alloc=0, lock=0, io=0) clause is a compile-time gate that
// ALPHA's compiler work enforces. The body is restricted to:
//   - Pure math (this fn is `with Pure`-only)
//   - Direct reads/writes to world fields
//   - Calls to other `with Pure` functions
//   - Patch invocations (auto-dual-pathed to lock-free teleport-channel)
//   - Atomic loads/stores on pre-allocated buffers
//
// The body is intentionally short. Every line is auditable.

pulse transport_tick every 5 ms jitter 1 ms budget(alloc=0, lock=0, io=0):
    // 1. Check if transport is playing (world.kn accessor).
    if mixer_is_playing():
        let samples_per_tick: Int = (MixerWorld.sample_rate * MixerWorld.buffer_size_frames) / 1000
        transport_advance_position(samples_per_tick)

    // 2. Process the audio graph via orchestrate.kn.
    //    Create zeroed effect slots on the stack (no heap allocation).
    let null_f: ptr<Float> = 0 as ptr<Float>
    let slot_0: EffectSlot = EffectSlot { id: 0, kind: FX_GAIN, params: null_f, bypassed: true, wet_dry_mix: 1.0 }
    let slot_1: EffectSlot = EffectSlot { id: 1, kind: FX_GAIN, params: null_f, bypassed: true, wet_dry_mix: 1.0 }
    let slot_2: EffectSlot = EffectSlot { id: 2, kind: FX_GAIN, params: null_f, bypassed: true, wet_dry_mix: 1.0 }
    let slot_3: EffectSlot = EffectSlot { id: 3, kind: FX_GAIN, params: null_f, bypassed: true, wet_dry_mix: 1.0 }
    let rendered: Int = audio_graph_process(
        MixerWorld.buffer_size_frames,
        MixerWorld.master_volume,
        slot_0, slot_1, slot_2, slot_3
    )
    let _ = rendered

    // 3. Detect peak levels.
    let peak_l: Float = audio_peak_detect(0)
    let peak_r: Float = audio_peak_detect(1)
    let rms_l: Float = audio_rms_detect(0)
    let rms_r: Float = audio_rms_detect(1)

    // 4. Update mixer meters via patches from patch.kn.
    //    The compiler auto-dual-paths these to lock-free teleport-channel
    //    sends because we're inside a budget(lock=0) scope.
    update_meter_peaks(MixerWorld, peak_l, peak_r)
    update_meter_rms(MixerWorld, rms_l, rms_r)

    // 5. Deliver the rendered buffer to the audio device.
    audio_device_deliver()

    // Local pulse bookkeeping.
    let _ = pulse_tick
    let _ = pulse_dt_ms
    let _ = pulse_missed



// ============================================================================
// L F O   T I C K   (Phase 2 stub — used by ECHO's actor.kn)
// ============================================================================
//
// A second pulse for the LFO timing. Runs at higher frequency than
// transport_tick; only the LFO phase advance is done here. This pulse
// is also budget-restricted.

pulse lfo1_tick every 1 ms jitter 1 ms budget(alloc=0, lock=0, io=0):
    // Phase accumulator advance. Pure integer arithmetic.
    // The actual LFO computation happens elsewhere (in the orchestrate
    // graph's LFO stage, or in a user callback).
    let _ = pulse_tick
    let _ = pulse_dt_ms
    let _ = pulse_missed

// ============================================================================
// T E L E M E T R Y
// ============================================================================

// transport_position — current playhead in frames.
pub fn transport_position() -> Int with Pure:
    return MixerWorld.transport_position_frames


// transport_is_paused — true if currently paused.
pub fn transport_is_paused() -> Bool with Pure:
    return mixer_is_paused()

// transport_sample_rate — convenience getter.
pub fn transport_sample_rate() -> Int with Pure:
    return MixerWorld.sample_rate

// transport_buffer_size — convenience getter.
pub fn transport_buffer_size() -> Int with Pure:
    return MixerWorld.buffer_size_frames

// transport_metrics — single struct snapshot of transport state for UI.
pub struct TransportMetrics:
    position_frames: Int
    sample_rate: Int
    buffer_size_frames: Int
    is_playing: Bool
    is_paused: Bool
    is_looping: Bool
    cpu_load_percent: Float

pub fn transport_metrics() -> TransportMetrics with Pure:
    return TransportMetrics {
        position_frames: MixerWorld.transport_position_frames,
        sample_rate: MixerWorld.sample_rate,
        buffer_size_frames: MixerWorld.buffer_size_frames,
        is_playing: MixerWorld.transport_state == 1,
        is_paused: MixerWorld.transport_state == 2,
        is_looping: MixerWorld.transport_loop_enabled,
        cpu_load_percent: MixerWorld.cpu_load_percent,
    }



// ============================================================================
// T E S T   H E L P E R S
// ============================================================================

// pulse_self_test_static — verifies the static parts of the module typecheck.
// The dynamic parts (the pulse body with budget annotation) require ALPHA's
// compiler work. This function only exercises helpers and API.
pub fn pulse_self_test_static() -> Int with Pure:
    // Verify transport helpers return 0/expected.
    let p: Int = transport_advance_position(0)
    if p < 0:
        return p
    let pos: Int = MixerWorld.transport_position_frames
    if pos < 0:
        return -1
    // Verify getters.
    let playing: Bool = mixer_is_playing()
    let _ = playing
    let rate: Int = mixer_sample_rate()
    if rate <= 0:
        return -2
    return 0

// pulse_self_test_init — exercises init/shutdown. Returns 0 on success.
// Phase 1: no allocation needed (the C runtime manages the output buffer).
pub fn pulse_self_test_init() -> Int with Pure:
    // Phase 1: transport is stateless — init is a no-op.
    // Phase 2 will allocate the output buffer when the C runtime bridge lands.
    return 0

// ============================================================================
// C O M P I L E R   W O R K   N O T E
// ============================================================================
//
// This file's pulse declarations use the `budget(...)` clause that Stream
// ALPHA is adding. Expected timeline:
//
//   - Phase 1 (ALPHA-1): parser support for `budget(alloc=N, lock=N, io=N)`
//   - Phase 2 (ALPHA-2): typecheck that the body obeys the budget
//   - Phase 3 (ALPHA-3): LLVM lowering of budget metadata to the pulse slot
//   - Phase 4 (ALPHA-4): auto-dual-path for patch calls in budget scopes
//   - Phase 5 (ALPHA-5): runtime support for the new pulse slot fields
//
// Until ALPHA-1 lands, `kain check pulse.kn` will fail with a parse error
// on the `budget(...)` clause. This is expected. The other modules in
// std::audio (device.kn, dsp.kn, midi.kn) are independent of this work
// and typecheck today.
//
// ECHO (Phase 2) will wire the audio engine actor into transport_tick and
// add the per-plugin actor mailbox that drains auto-dual-pathed patches.
