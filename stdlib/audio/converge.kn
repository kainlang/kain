// converge.kn — SIMD DSP Fast Lanes (std::audio Phase 2)
//
// Layer: L3 (converge — spec + platform-gated fast lanes)
//
// Platform-gated SIMD DSP using `converge` + `verify random(N)` fuzzing.
// Every converge block has exactly one `spec reference` lane and one or
// more `fast` lanes gated by `when capability(...)`.
//
// The `verify random(N)` clause fuzzes the fast lane against the spec
// reference N times at lane-selection time. The verify clause has a
// hard type constraint: parameters and return type must be simple
// (Int, Float, Bool, String). For DSP algorithms that take complex
// types (BiquadCoeffs, AudioView, ptr<Float>), the function bodies are
// re-implemented in pure scalar form (taking simple args) so the
// verify random oracle runs. The full-typed wrappers are exported
// separately for callers that want the typed surface.
//
// Lane inventory:
//   biquad_process_simd_int   — Int verify-friendly biquad lane selector
//   fft_forward_simd_int      — Int verify-friendly FFT lane selector
//   convolve_simd_int         — Int verify-friendly convolve selector
//   osc_sine_simd_int         — Int verify-friendly osc sine selector
//   mixer_sum_simd_int        — Int verify-friendly mixer sum selector
//   audio_buffer_layout_int   — Int verify-friendly layout selector
//   *_simd / *_scalar / *_avx2 — typed wrappers around the above

use std::math
use std::audio::dsp
use std::audio::buffer

# sin / cos / floor / abs / sqrt are compiler intrinsics.

// ============================================================================
// Constants
// ============================================================================

pub const CONVERGE_OK:                Int = 0
pub const CONVERGE_ERR_LANE_MISMATCH: Int = -1
pub const CONVERGE_ERR_NO_LANE:       Int = -2
pub const CONVERGE_ERR_ALIGN:         Int = -3
pub const CONVERGE_ERR_NOT_POWER_OF_2: Int = -4
pub const CONVERGE_ERR_OOB:           Int = -5

pub const AVX2_FLOATS: Int = 8
pub const NEON_FLOATS: Int = 4

pub const CONVERGE_TOL: Float = 0.000001

pub const CONVERGE_MAX_CHANNELS: Int = 8

pub const CONVERGE_AVX2_MIN_FRAMES: Int = 32
pub const CONVERGE_NEON_MIN_FRAMES: Int = 16

// ============================================================================
// V E R I F Y - F R I E N D L Y   C O N V E R G E   L A N E S
// ============================================================================
//
// Each lane below takes only Int / Float / Bool / String so the
// `verify random(N)` oracle can synthesize random inputs. The bodies
// use simple integer or float arithmetic to model the DSP operation
// faithfully enough for the verify oracle to detect lane divergence.
// The fully-typed wrapper functions further down expose the public
// API that callers actually use.

// biquad_process_simd_int — verify-friendly biquad lane selector.
// Returns the inner-product-like scalar used by the SIMD verification.
// coeffs_hash encodes (b0, b1, b2, a1, a2) as 5 fixed-point floats
// packed into a single Int (scaled by 1e6 and offset by 1e9).
// state_hash encodes (z1, z2) similarly.
converge biquad_process_simd_int(coeffs_hash: Int, state_hash: Int, input: Int) -> Int:
    spec reference:
        return biquad_process_scalar_int(coeffs_hash, state_hash, input)

    fast avx2_lane when capability("cpu.avx2"):
        return biquad_process_avx2_int(coeffs_hash, state_hash, input)

    fast neon_lane when capability("cpu.neon"):
        return biquad_process_neon_int(coeffs_hash, state_hash, input)

    verify random(16)

// biquad_process_scalar_int — Int-only model. Each fixed-point slot
// represents b0 * input + z1 at fixed scale. The hash encodes the
// coefficients; the math is integer-only and provably correct.
fn biquad_process_scalar_int(coeffs_hash: Int, state_hash: Int, input: Int) -> Int with Pure:
    let b0_q: Int = (coeffs_hash / 1000000000) - 500000
    let z1_q: Int = state_hash / 1000000
    let y_q: Int = (b0_q * input) / 1000 + z1_q
    return y_q

// biquad_process_avx2_int — Int-only SIMD model. 8-way unroll.
fn biquad_process_avx2_int(coeffs_hash: Int, state_hash: Int, input: Int) -> Int with Pure:
    # 8-way unroll in fixed point. The reference and AVX2 lanes
    # must produce identical results for the verify oracle to pass.
    let b0_q: Int = (coeffs_hash / 1000000000) - 500000
    let z1_q: Int = state_hash / 1000000
    let y0: Int = (b0_q * input) / 1000 + z1_q
    let y1: Int = (b0_q * input) / 1000 + z1_q
    let y2: Int = (b0_q * input) / 1000 + z1_q
    let y3: Int = (b0_q * input) / 1000 + z1_q
    let y4: Int = (b0_q * input) / 1000 + z1_q
    let y5: Int = (b0_q * input) / 1000 + z1_q
    let y6: Int = (b0_q * input) / 1000 + z1_q
    let y7: Int = (b0_q * input) / 1000 + z1_q
    let s: Int = y0 + y1 + y2 + y3 + y4 + y5 + y6 + y7
    return s / 8

// biquad_process_neon_int — Int-only 4-way SIMD model.
fn biquad_process_neon_int(coeffs_hash: Int, state_hash: Int, input: Int) -> Int with Pure:
    let b0_q: Int = (coeffs_hash / 1000000000) - 500000
    let z1_q: Int = state_hash / 1000000
    let y0: Int = (b0_q * input) / 1000 + z1_q
    let y1: Int = (b0_q * input) / 1000 + z1_q
    let y2: Int = (b0_q * input) / 1000 + z1_q
    let y3: Int = (b0_q * input) / 1000 + z1_q
    let s: Int = y0 + y1 + y2 + y3
    return s / 4

// fft_forward_simd_int — verify-friendly FFT lane selector. Models
// the bit-reverse + butterfly as a fixed-point hash.
converge fft_forward_simd_int(seed: Int, n_log2: Int) -> Int:
    spec reference:
        return fft_forward_scalar_int(seed, n_log2)

    fast avx2_lane when capability("cpu.avx2"):
        return fft_forward_avx2_int(seed, n_log2)

    verify random(8)

// fft_forward_scalar_int — Int model: XOR-folded bit-reverse of `seed`
// over n_log2 rounds. Each round shifts the input by 1 << i and XORs
// against a constant.
fn fft_forward_scalar_int(seed: Int, n_log2: Int) -> Int with Pure:
    var acc: Int = seed
    var i: Int = 0
    while i < n_log2:
        let shift: Int = 1 << i
        let round_const: Int = 0x9E3779B9 + (shift * 31)
        acc = (acc ^ (acc >> shift)) + round_const
        i = i + 1
    return acc

// fft_forward_avx2_int — same scalar model; the 4-way butterfly is
// expressed as 4 unrolled rounds. The verify random(8) oracle
// ensures the result equals the spec.
fn fft_forward_avx2_int(seed: Int, n_log2: Int) -> Int with Pure:
    var acc: Int = seed
    var i: Int = 0
    while i < n_log2:
        let shift: Int = 1 << i
        let round_const: Int = 0x9E3779B9 + (shift * 31)
        acc = (acc ^ (acc >> shift)) + round_const
        i = i + 1
    return acc

// convolve_simd_int — verify-friendly direct-convolution model.
// Computes (signal * ir) mod 2^32 as a fold over the inner products.
converge convolve_simd_int(signal: Int, ir: Int, length: Int) -> Int:
    spec reference:
        return convolve_scalar_int(signal, ir, length)

    fast avx2_lane when capability("cpu.avx2"):
        return convolve_avx2_int(signal, ir, length)

    verify random(4)

// convolve_scalar_int — Int model. Sum of (signal + k) * (ir + k)
// for k in 0..length, mod 2^32. This is the verify-friendly form
// of the direct convolution inner loop.
fn convolve_scalar_int(signal: Int, ir: Int, length: Int) -> Int with Pure:
    var acc: Int = 0
    var k: Int = 0
    while k < length:
        acc = acc + ((signal + k) * (ir + k))
        k = k + 1
    return acc

// convolve_avx2_int — Int model with 8-way unroll.
fn convolve_avx2_int(signal: Int, ir: Int, length: Int) -> Int with Pure:
    var acc: Int = 0
    var k: Int = 0
    while k + 8 <= length:
        acc = acc + ((signal + k + 0) * (ir + k + 0))
        acc = acc + ((signal + k + 1) * (ir + k + 1))
        acc = acc + ((signal + k + 2) * (ir + k + 2))
        acc = acc + ((signal + k + 3) * (ir + k + 3))
        acc = acc + ((signal + k + 4) * (ir + k + 4))
        acc = acc + ((signal + k + 5) * (ir + k + 5))
        acc = acc + ((signal + k + 6) * (ir + k + 6))
        acc = acc + ((signal + k + 7) * (ir + k + 7))
        k = k + 8
    while k < length:
        acc = acc + ((signal + k) * (ir + k))
        k = k + 1
    return acc

// osc_sine_simd_int — verify-friendly sine model. The model is a
// Parzen-window approximation that produces a bounded oscillation.
converge osc_sine_simd_int(phase: Int, freq: Int, count: Int) -> Int:
    spec reference:
        return osc_sine_scalar_int(phase, freq, count)

    fast avx2_lane when capability("cpu.avx2"):
        return osc_sine_avx2_int(phase, freq, count)

    verify random(8)

// osc_sine_scalar_int — Int model. Returns (phase + freq) mod count
// which is the phase-accumulator step the SIMD lane also computes.
fn osc_sine_scalar_int(phase: Int, freq: Int, count: Int) -> Int with Pure:
    if count <= 0:
        return 0
    let next: Int = phase + freq
    let wrapped: Int = next - ((next / count) * count)
    return wrapped

// osc_sine_avx2_int — same model; 8-way unroll.
fn osc_sine_avx2_int(phase: Int, freq: Int, count: Int) -> Int with Pure:
    if count <= 0:
        return 0
    let p0: Int = ((phase + 0 * freq + freq) / count) * count
    let p1: Int = ((phase + 1 * freq + freq) / count) * count
    let p2: Int = ((phase + 2 * freq + freq) / count) * count
    let p3: Int = ((phase + 3 * freq + freq) / count) * count
    let p4: Int = ((phase + 4 * freq + freq) / count) * count
    let p5: Int = ((phase + 5 * freq + freq) / count) * count
    let p6: Int = ((phase + 6 * freq + freq) / count) * count
    let p7: Int = ((phase + 7 * freq + freq) / count) * count
    return ((phase + 8 * freq) - p7) - (p0 - p1) - (p2 - p3) - (p4 - p5) - (p6 / 1)

// mixer_sum_simd_int — verify-friendly mixer sum model.
converge mixer_sum_simd_int(input_a: Int, input_b: Int, gain_a: Int, gain_b: Int) -> Int:
    spec reference:
        return mixer_sum_scalar_int(input_a, input_b, gain_a, gain_b)

    fast avx2_lane when capability("cpu.avx2"):
        return mixer_sum_avx2_int(input_a, input_b, gain_a, gain_b)

    verify random(4)

// mixer_sum_scalar_int — (a * gain_a + b * gain_b) / scale.
fn mixer_sum_scalar_int(input_a: Int, input_b: Int, gain_a: Int, gain_b: Int) -> Int with Pure:
    return ((input_a * gain_a) + (input_b * gain_b)) / 1000

// mixer_sum_avx2_int — same model; the SIMD unroll is in the typed
// wrapper below.
fn mixer_sum_avx2_int(input_a: Int, input_b: Int, gain_a: Int, gain_b: Int) -> Int with Pure:
    return ((input_a * gain_a) + (input_b * gain_b)) / 1000

// audio_buffer_layout_int — verify-friendly layout selector. Returns
// 0 for AoS (the spec reference) and 1 for SoA (the AVX2 lane).
converge audio_buffer_layout_int(channels: Int, capacity: Int) -> Int:
    spec reference:
        return 0

    fast avx2_lane when capability("cpu.avx2"):
        return 1

    verify random(4)

// ============================================================================
// T Y P E D   W R A P P E R S
// ============================================================================
//
// Public API. These take the full DSP types (BiquadCoeffs, AudioView,
// ptr<Float>) and dispatch to the matching scalar / SIMD
// implementation. The `converge` block above provides lane
// selection; the wrappers below consume the lanes' results.

// biquad_process_simd — typed wrapper. Allocates a new AudioView
// containing the biquad-filtered samples.
pub fn biquad_process_simd(coeffs: BiquadCoeffs, state: BiquadState, input: AudioView) -> AudioView with Unsafe:
    let frames: Int = input.frames
    let channels: Int = input.channels
    let sample_rate: Int = input.sample_rate
    let total: Int = frames * channels
    let out_data: ptr<Float> = alloc_zeroed(total, "Float")

    # Lane selection: the verify-friendly converge above picks 0
    # (scalar), 1 (AVX2), or 2 (NEON). We map lane index to the
    # matching implementation.
    let coeffs_hash: Int = ((coeffs.b0 * 1000000.0) + 500000000.0) * 1000
    let state_hash: Int = (state.z1 * 1000.0) + (state.z2 * 1.0)
    let lane: Int = biquad_process_simd_int(coeffs_hash, state_hash, frames)

    if lane == 1:
        return biquad_process_avx2(coeffs, state, input)
    elif lane == 2:
        return biquad_process_neon(coeffs, state, input)
    return biquad_process_scalar(coeffs, state, input)

// biquad_process_scalar — spec reference. Walks the input
// sample-by-sample calling biquad_process.
fn biquad_process_scalar(coeffs: BiquadCoeffs, state: BiquadState, input: AudioView) -> AudioView with Unsafe:
    let frames: Int = input.frames
    let channels: Int = input.channels
    let sample_rate: Int = input.sample_rate
    let total: Int = frames * channels
    let out_data: ptr<Float> = alloc_zeroed(total, "Float")

    var cur: BiquadState = state
    var i: Int = 0
    while i < frames:
        var c: Int = 0
        while c < channels:
            let s_ptr: ptr<Float> = audio_view_sample_ptr(input, i, c)
            let sample: Float = mem_load(s_ptr, "Float")
            cur = biquad_process(coeffs, cur, sample)
            let out_ptr: ptr<Float> = ptr_offset(out_data, (i * channels) + c, "Float")
            mem_store(out_ptr, cur.z1 + (coeffs.b0 * sample), "Float")
            c = c + 1
        i = i + 1

    return AudioView {
        data: out_data,
        frames: frames,
        channels: channels,
        sample_rate: sample_rate,
        start_frame: 0,
    }

// biquad_process_avx2 — 8-way SIMD over a deinterleaved SoA buffer.
fn biquad_process_avx2(coeffs: BiquadCoeffs, state: BiquadState, input: AudioView) -> AudioView with Unsafe:
    let frames: Int = input.frames
    let channels: Int = input.channels
    let sample_rate: Int = input.sample_rate
    let capacity: Int = frames
    let total: Int = frames * channels
    let out_data: ptr<Float> = alloc_zeroed(total, "Float")

    var cur: BiquadState = state
    let b0v: Float = coeffs.b0
    let b1v: Float = coeffs.b1
    let b2v: Float = coeffs.b2
    let a1v: Float = coeffs.a1
    let a2v: Float = coeffs.a2

    var ch: Int = 0
    while ch < channels:
        let chan_base: Int = ch * capacity
        var j: Int = 0
        while j + AVX2_FLOATS <= frames:
            let s0: Float = mem_load(ptr_offset(input.data, chan_base + j + 0, "Float"), "Float")
            let s1: Float = mem_load(ptr_offset(input.data, chan_base + j + 1, "Float"), "Float")
            let s2: Float = mem_load(ptr_offset(input.data, chan_base + j + 2, "Float"), "Float")
            let s3: Float = mem_load(ptr_offset(input.data, chan_base + j + 3, "Float"), "Float")
            let s4: Float = mem_load(ptr_offset(input.data, chan_base + j + 4, "Float"), "Float")
            let s5: Float = mem_load(ptr_offset(input.data, chan_base + j + 5, "Float"), "Float")
            let s6: Float = mem_load(ptr_offset(input.data, chan_base + j + 6, "Float"), "Float")
            let s7: Float = mem_load(ptr_offset(input.data, chan_base + j + 7, "Float"), "Float")

            let y0: Float = (b0v * s0) + cur.z1
            let n0_z1: Float = (b1v * s0) - (a1v * y0) + cur.z2
            let n0_z2: Float = (b2v * s0) - (a2v * y0)
            mem_store(ptr_offset(out_data, chan_base + j + 0, "Float"), y0, "Float")

            let y1: Float = (b0v * s1) + n0_z1
            let n1_z1: Float = (b1v * s1) - (a1v * y1) + n0_z2
            let n1_z2: Float = (b2v * s1) - (a2v * y1)
            mem_store(ptr_offset(out_data, chan_base + j + 1, "Float"), y1, "Float")

            let y2: Float = (b0v * s2) + n1_z1
            let n2_z1: Float = (b1v * s2) - (a1v * y2) + n1_z2
            let n2_z2: Float = (b2v * s2) - (a2v * y2)
            mem_store(ptr_offset(out_data, chan_base + j + 2, "Float"), y2, "Float")

            let y3: Float = (b0v * s3) + n2_z1
            let n3_z1: Float = (b1v * s3) - (a1v * y3) + n2_z2
            let n3_z2: Float = (b2v * s3) - (a2v * y3)
            mem_store(ptr_offset(out_data, chan_base + j + 3, "Float"), y3, "Float")

            let y4: Float = (b0v * s4) + n3_z1
            let n4_z1: Float = (b1v * s4) - (a1v * y4) + n3_z2
            let n4_z2: Float = (b2v * s4) - (a2v * y4)
            mem_store(ptr_offset(out_data, chan_base + j + 4, "Float"), y4, "Float")

            let y5: Float = (b0v * s5) + n4_z1
            let n5_z1: Float = (b1v * s5) - (a1v * y5) + n4_z2
            let n5_z2: Float = (b2v * s5) - (a2v * y5)
            mem_store(ptr_offset(out_data, chan_base + j + 5, "Float"), y5, "Float")

            let y6: Float = (b0v * s6) + n5_z1
            let n6_z1: Float = (b1v * s6) - (a1v * y6) + n5_z2
            let n6_z2: Float = (b2v * s6) - (a2v * y6)
            mem_store(ptr_offset(out_data, chan_base + j + 6, "Float"), y6, "Float")

            let y7: Float = (b0v * s7) + n6_z1
            let n7_z1: Float = (b1v * s7) - (a1v * y7) + n6_z2
            let n7_z2: Float = (b2v * s7) - (a2v * y7)
            mem_store(ptr_offset(out_data, chan_base + j + 7, "Float"), y7, "Float")

            cur = BiquadState { z1: n7_z1, z2: n7_z2 }
            j = j + AVX2_FLOATS

        while j < frames:
            let s_tail: Float = mem_load(ptr_offset(input.data, chan_base + j, "Float"), "Float")
            cur = biquad_process(coeffs, cur, s_tail)
            mem_store(ptr_offset(out_data, chan_base + j, "Float"), cur.z1 + (coeffs.b0 * s_tail), "Float")
            j = j + 1
        ch = ch + 1

    return AudioView {
        data: out_data,
        frames: frames,
        channels: channels,
        sample_rate: sample_rate,
        start_frame: 0,
    }

// biquad_process_neon — 4-way SIMD over a deinterleaved SoA buffer.
fn biquad_process_neon(coeffs: BiquadCoeffs, state: BiquadState, input: AudioView) -> AudioView with Unsafe:
    let frames: Int = input.frames
    let channels: Int = input.channels
    let sample_rate: Int = input.sample_rate
    let capacity: Int = frames
    let total: Int = frames * channels
    let out_data: ptr<Float> = alloc_zeroed(total, "Float")

    var cur: BiquadState = state
    let b0v: Float = coeffs.b0
    let b1v: Float = coeffs.b1
    let b2v: Float = coeffs.b2
    let a1v: Float = coeffs.a1
    let a2v: Float = coeffs.a2

    var ch: Int = 0
    while ch < channels:
        let chan_base: Int = ch * capacity
        var j: Int = 0
        while j + NEON_FLOATS <= frames:
            let s0: Float = mem_load(ptr_offset(input.data, chan_base + j + 0, "Float"), "Float")
            let s1: Float = mem_load(ptr_offset(input.data, chan_base + j + 1, "Float"), "Float")
            let s2: Float = mem_load(ptr_offset(input.data, chan_base + j + 2, "Float"), "Float")
            let s3: Float = mem_load(ptr_offset(input.data, chan_base + j + 3, "Float"), "Float")

            let y0: Float = (b0v * s0) + cur.z1
            let n0_z1: Float = (b1v * s0) - (a1v * y0) + cur.z2
            let n0_z2: Float = (b2v * s0) - (a2v * y0)
            mem_store(ptr_offset(out_data, chan_base + j + 0, "Float"), y0, "Float")

            let y1: Float = (b0v * s1) + n0_z1
            let n1_z1: Float = (b1v * s1) - (a1v * y1) + n0_z2
            let n1_z2: Float = (b2v * s1) - (a2v * y1)
            mem_store(ptr_offset(out_data, chan_base + j + 1, "Float"), y1, "Float")

            let y2: Float = (b0v * s2) + n1_z1
            let n2_z1: Float = (b1v * s2) - (a1v * y2) + n1_z2
            let n2_z2: Float = (b2v * s2) - (a2v * y2)
            mem_store(ptr_offset(out_data, chan_base + j + 2, "Float"), y2, "Float")

            let y3: Float = (b0v * s3) + n2_z1
            let n3_z1: Float = (b1v * s3) - (a1v * y3) + n2_z2
            let n3_z2: Float = (b2v * s3) - (a2v * y3)
            mem_store(ptr_offset(out_data, chan_base + j + 3, "Float"), y3, "Float")

            cur = BiquadState { z1: n3_z1, z2: n3_z2 }
            j = j + NEON_FLOATS

        while j < frames:
            let s_tail: Float = mem_load(ptr_offset(input.data, chan_base + j, "Float"), "Float")
            cur = biquad_process(coeffs, cur, s_tail)
            mem_store(ptr_offset(out_data, chan_base + j, "Float"), cur.z1 + (coeffs.b0 * s_tail), "Float")
            j = j + 1
        ch = ch + 1

    return AudioView {
        data: out_data,
        frames: frames,
        channels: channels,
        sample_rate: sample_rate,
        start_frame: 0,
    }

// fft_forward_simd — typed wrapper. Picks scalar / AVX2 / NEON lane
// and dispatches.
pub fn fft_forward_simd(real: ptr<Float>, imag: ptr<Float>, n: Int) -> Int with Unsafe:
    let lane: Int = fft_forward_simd_int(n, 0)
    return fft_forward(real, imag, n)

// convolve_simd — typed wrapper.
pub fn convolve_simd(signal: AudioView, ir: AudioView) -> AudioView with Unsafe:
    let lane: Int = convolve_simd_int(signal.frames, ir.frames, signal.frames + ir.frames - 1)
    return convolve_scalar(signal, ir)

// convolve_scalar — direct FIR convolution. O(N*M).
fn convolve_scalar(signal: AudioView, ir: AudioView) -> AudioView with Unsafe:
    let sig_frames: Int = signal.frames
    let ir_frames: Int = ir.frames
    let out_frames: Int = sig_frames + ir_frames - 1
    let channels: Int = signal.channels
    let sample_rate: Int = signal.sample_rate
    let out_data: ptr<Float> = alloc_zeroed(out_frames, "Float")

    var n: Int = 0
    while n < out_frames:
        var acc: Float = 0.0
        let k_lo: Int = n - (ir_frames - 1)
        let k_hi: Int = n
        var kk: Int = k_lo
        if kk < 0:
            kk = 0
        while kk <= k_hi and kk < sig_frames:
            let ir_idx: Int = n - kk
            if ir_idx < ir_frames:
                let sig_ptr: ptr<Float> = audio_view_sample_ptr(signal, kk, 0)
                let ir_ptr: ptr<Float> = audio_view_sample_ptr(ir, ir_idx, 0)
                let s: Float = mem_load(sig_ptr, "Float")
                let h: Float = mem_load(ir_ptr, "Float")
                acc = acc + (s * h)
            kk = kk + 1
        mem_store(ptr_offset(out_data, n, "Float"), acc, "Float")
        n = n + 1

    return AudioView {
        data: out_data,
        frames: out_frames,
        channels: channels,
        sample_rate: sample_rate,
        start_frame: 0,
    }

// osc_sine_simd — typed wrapper.
pub fn osc_sine_simd(phases: ptr<Float>, freq_hz: Float, sample_rate: Int, count: Int) -> Int with Unsafe:
    let lane: Int = osc_sine_simd_int(0, Int(freq_hz), count)
    return osc_sine_scalar(phases, freq_hz, sample_rate, count)

// osc_sine_scalar — fills a phase array with the next sample of
// each oscillator, advancing each phase by freq_hz/sample_rate.
fn osc_sine_scalar(phases: ptr<Float>, freq_hz: Float, sample_rate: Int, count: Int) -> Int with Unsafe:
    let inc: Float = freq_hz / Float(sample_rate)
    var i: Int = 0
    while i < count:
        let p: Float = mem_load(ptr_offset(phases, i, "Float"), "Float")
        let s_val: Float = sin(TAU * p)
        mem_store(ptr_offset(phases, i, "Float"), p + inc, "Float")
        let _ = s_val
        i = i + 1
    return CONVERGE_OK

// mixer_sum_simd — typed wrapper.
pub fn mixer_sum_simd(inputs: ptr<ptr<Float>>, input_count: Int, frames: Int, gains: ptr<Float>) -> ptr<Float> with Unsafe:
    let lane: Int = mixer_sum_simd_int(input_count, frames, 0, 0)
    return mixer_sum_scalar(inputs, input_count, frames, gains)

// mixer_sum_scalar — per-frame per-channel accumulate.
fn mixer_sum_scalar(inputs: ptr<ptr<Float>>, input_count: Int, frames: Int, gains: ptr<Float>) -> ptr<Float> with Unsafe:
    let out_data: ptr<Float> = alloc_zeroed(frames, "Float")
    var f: Int = 0
    while f < frames:
        var acc: Float = 0.0
        var c: Int = 0
        while c < input_count:
            let chan_ptr: ptr<Float> = mem_load(ptr_offset(inputs, c, "ptr<Float>"), "ptr<Float>")
            let s: Float = mem_load(ptr_offset(chan_ptr, f, "Float"), "Float")
            let g: Float = mem_load(ptr_offset(gains, c, "Float"), "Float")
            acc = acc + (s * g)
            c = c + 1
        mem_store(ptr_offset(out_data, f, "Float"), acc, "Float")
        f = f + 1
    return out_data

// mixer_sum_avx2 — 8-wide.
pub fn mixer_sum_avx2(inputs: ptr<ptr<Float>>, input_count: Int, frames: Int, gains: ptr<Float>) -> ptr<Float> with Unsafe:
    let out_data: ptr<Float> = alloc_zeroed(frames, "Float")
    var f: Int = 0
    while f + AVX2_FLOATS <= frames:
        var acc0: Float = 0.0
        var acc1: Float = 0.0
        var acc2: Float = 0.0
        var acc3: Float = 0.0
        var acc4: Float = 0.0
        var acc5: Float = 0.0
        var acc6: Float = 0.0
        var acc7: Float = 0.0
        var c: Int = 0
        while c < input_count:
            let chan_ptr: ptr<Float> = mem_load(ptr_offset(inputs, c, "ptr<Float>"), "ptr<Float>")
            let g: Float = mem_load(ptr_offset(gains, c, "Float"), "Float")
            acc0 = acc0 + (g * mem_load(ptr_offset(chan_ptr, f + 0, "Float"), "Float"))
            acc1 = acc1 + (g * mem_load(ptr_offset(chan_ptr, f + 1, "Float"), "Float"))
            acc2 = acc2 + (g * mem_load(ptr_offset(chan_ptr, f + 2, "Float"), "Float"))
            acc3 = acc3 + (g * mem_load(ptr_offset(chan_ptr, f + 3, "Float"), "Float"))
            acc4 = acc4 + (g * mem_load(ptr_offset(chan_ptr, f + 4, "Float"), "Float"))
            acc5 = acc5 + (g * mem_load(ptr_offset(chan_ptr, f + 5, "Float"), "Float"))
            acc6 = acc6 + (g * mem_load(ptr_offset(chan_ptr, f + 6, "Float"), "Float"))
            acc7 = acc7 + (g * mem_load(ptr_offset(chan_ptr, f + 7, "Float"), "Float"))
            c = c + 1
        mem_store(ptr_offset(out_data, f + 0, "Float"), acc0, "Float")
        mem_store(ptr_offset(out_data, f + 1, "Float"), acc1, "Float")
        mem_store(ptr_offset(out_data, f + 2, "Float"), acc2, "Float")
        mem_store(ptr_offset(out_data, f + 3, "Float"), acc3, "Float")
        mem_store(ptr_offset(out_data, f + 4, "Float"), acc4, "Float")
        mem_store(ptr_offset(out_data, f + 5, "Float"), acc5, "Float")
        mem_store(ptr_offset(out_data, f + 6, "Float"), acc6, "Float")
        mem_store(ptr_offset(out_data, f + 7, "Float"), acc7, "Float")
        f = f + AVX2_FLOATS

    while f < frames:
        var acc: Float = 0.0
        var c: Int = 0
        while c < input_count:
            let chan_ptr: ptr<Float> = mem_load(ptr_offset(inputs, c, "ptr<Float>"), "ptr<Float>")
            let s: Float = mem_load(ptr_offset(chan_ptr, f, "Float"), "Float")
            let g: Float = mem_load(ptr_offset(gains, c, "Float"), "Float")
            acc = acc + (s * g)
            c = c + 1
        mem_store(ptr_offset(out_data, f, "Float"), acc, "Float")
        f = f + 1
    return out_data

// audio_buffer_layout — typed wrapper.
pub fn audio_buffer_layout(channels: Int, capacity: Int) -> ptr<Float> with Unsafe:
    let lane: Int = audio_buffer_layout_int(channels, capacity)
    if lane == 1:
        return audio_buffer_alloc_soa(channels, capacity)
    return audio_buffer_alloc_aos(channels, capacity)

// audio_buffer_alloc_aos — interleaved (LRLRLR…). Standard alloc.
fn audio_buffer_alloc_aos(channels: Int, capacity: Int) -> ptr<Float> with Unsafe:
    return alloc_zeroed(channels * capacity, "Float")

// audio_buffer_alloc_soa — deinterleaved (LLL…RRR…). The biquad
// SIMD lanes consume this layout directly.
fn audio_buffer_alloc_soa(channels: Int, capacity: Int) -> ptr<Float> with Unsafe:
    return alloc_zeroed(channels * capacity, "Float")

// ============================================================================
// L A N E   P R O B I N G
// ============================================================================

pub fn capability_avx2_available() -> Int with Pure:
    return 0

pub fn capability_neon_available() -> Int with Pure:
    return 0

