// ─── Random bytes ────────────────────────────────────────────────────────
pub fn os_urandom(byte_count: Int) -> String:
    return abi_os_urandom(byte_count)

pub fn os_urandom_bytes(byte_count: Int) -> Array<Int>:
    let raw = hex_decode(abi_os_urandom(byte_count))
    let bytes = []
    var index: Int = 0
    while index < len(raw):
        push(bytes, byte_at(raw, index))
        index = index + 1
    return bytes

// ─── Terminal size ───────────────────────────────────────────────────────
pub struct OsTerminalSize:
    columns: Int
    rows: Int

pub fn os_get_terminal_size() -> OsTerminalSize:
    let columns = abi_os_terminal_columns()
    let rows = abi_os_terminal_rows()
    return OsTerminalSize {
        columns: if columns > 0: columns else: 80,
        rows: if rows > 0: rows else: 24
    }

// ─── Page size ───────────────────────────────────────────────────────────
pub fn os_getpagesize() -> Int:
    return vm_page_size()

