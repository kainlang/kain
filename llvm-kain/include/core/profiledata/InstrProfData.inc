//===----------------------------------------------------------------------===//
// This file is included multiple times with different macro definitions.
// Each inclusion generates a different aspect of the profiling data structures.
//===----------------------------------------------------------------------===//

// This file is a hand-written stub for the llvm-kain flat layout build.
// The canonical upstream version is generated by tablegen from InstrProfData.td.
//
// Supported macro redefinitions at include time:
//   INSTR_PROF_SECT_ENTRY(Kind, SectNameCommon, SectNameCoff, Prefix) → sections
//   VALUE_PROF_KIND(Enumerator, Value, Descr) → value profile kind enum
//   INSTR_PROF_VALUE_PROF_DATA → value profiling data (defined but empty)
//   INSTR_PROF_DATA(Type, LLVMType, Name, Init) → raw profile data fields
//   INSTR_PROF_VTABLE_DATA(Type, LLVMType, Name, Init) → vtable data fields
//   INSTR_PROF_RAW_HEADER(Type, Name, Init) → raw header fields
//   COVMAP_FUNC_RECORD(Type, LLVMType, Name, Init) → coverage mapping record fields
//   COVMAP_HEADER(Type, LLVMType, Name, Init) → coverage mapping header fields
//   INSTR_PROF_COMMON_API_IMPL → common API implementations
//
// Standalone macros defined unconditionally:
//   INSTR_PROF_VALUE_PROF_FUNC_STR, INSTR_PROF_VALUE_PROF_MEMOP_FUNC_STR,
//   INSTR_PROF_INSTRUMENT_GPU_FUNC_STR, INSTR_PROF_PROFILE_RUNTIME_VAR,
//   INSTR_PROF_PROFILE_COUNTER_BIAS_VAR, INSTR_PROF_PROFILE_BITMAP_BIAS_VAR,
//   INSTR_PROF_QUOTE, INSTR_PROF_INDEX_VERSION, INSTR_PROF_RAW_VERSION,
//   INSTR_PROF_RAW_MAGIC_64, INSTR_PROF_RAW_MAGIC_32,
//   INSTR_PROF_MAX_NUM_VAL_PER_SITE, INSTR_PROF_COVMAP_VERSION,
//   IPVK_First, IPVK_Last, INSTR_PROF_RAW_VERSION_VAR
//===----------------------------------------------------------------------===//

//===----------------------------------------------------------------------===//
// Stand-alone macros — defined once, used across all inclusion contexts.
//===----------------------------------------------------------------------===//

#ifndef INSTR_PROF_DATA_INC_STANDALONE
#define INSTR_PROF_DATA_INC_STANDALONE

// String-typed constants for runtime function names
#define INSTR_PROF_VALUE_PROF_FUNC_STR "__llvm_profile_instrument"
#define INSTR_PROF_VALUE_PROF_MEMOP_FUNC_STR "__llvm_profile_instrument_memop"
#define INSTR_PROF_INSTRUMENT_GPU_FUNC_STR "__llvm_profile_instrument_gpu"
#define INSTR_PROF_PROFILE_RUNTIME_VAR "__llvm_profile_runtime"
#define INSTR_PROF_PROFILE_COUNTER_BIAS_VAR "__llvm_profile_counter_bias"
#define INSTR_PROF_PROFILE_BITMAP_BIAS_VAR "__llvm_profile_bitmap_bias"
#define INSTR_PROF_RAW_VERSION_VAR "__llvm_profile_raw_version"

// Stringify helper
#define INSTR_PROF_QUOTE(x) #x
#define INSTR_PROF_DO_QUOTE(x) INSTR_PROF_QUOTE(x)

// Version constants
#define INSTR_PROF_INDEX_VERSION 13ULL
#define INSTR_PROF_RAW_VERSION 10ULL
#define INSTR_PROF_COVMAP_VERSION 7ULL

// Magic constants
#define INSTR_PROF_RAW_MAGIC_64  \
  ((uint64_t)255 << 56 | (uint64_t)'l' << 48 | (uint64_t)'p' << 40 |  \
   (uint64_t)'r' << 32 | (uint64_t)'o' << 24 | (uint64_t)'f' << 16 |  \
   (uint64_t)'i' << 8 | (uint64_t)129)
#define INSTR_PROF_RAW_MAGIC_32  \
  ((uint32_t)255 << 24 | (uint32_t)'l' << 16 | (uint32_t)'p' << 8 |  \
   (uint32_t)'r')

// Max values
#define INSTR_PROF_MAX_NUM_VAL_PER_SITE 255

#endif // INSTR_PROF_DATA_INC_STANDALONE

//===----------------------------------------------------------------------===//
// VALUE_PROF_KIND — defines InstrProfValueKind enum entries.
// The caller must define VALUE_PROF_KIND(Enumerator, Value, Descr).
//===----------------------------------------------------------------------===//

#ifdef VALUE_PROF_KIND
VALUE_PROF_KIND(IPVK_IndirectCallTarget, 0,
                "Indirect Call Target")
VALUE_PROF_KIND(IPVK_VTableTarget, 1,
                "VTable Target")
VALUE_PROF_KIND(IPVK_MemOPSize, 2,
                "MemOP Size")
#undef VALUE_PROF_KIND
#endif

// Derived constants for value profile kind range
#ifndef IPVK_First
#define IPVK_First IPVK_IndirectCallTarget
#endif
#ifndef IPVK_Last
#define IPVK_Last IPVK_MemOPSize
#endif

