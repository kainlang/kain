INSTR_PROF_DATA(const IntPtrT, IntPtrT, NumCounters, Constant)
INSTR_PROF_DATA(const IntPtrT, IntPtrT, NumBitmapBytes, Constant)
INSTR_PROF_DATA(const IntPtrT, IntPtrT, NumValueSites, Constant)
#undef INSTR_PROF_DATA
#endif

