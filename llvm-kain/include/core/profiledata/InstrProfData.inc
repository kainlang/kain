//===----------------------------------------------------------------------===//
// COVMAP_FUNC_RECORD — coverage mapping per-function record fields.
// The caller must define COVMAP_FUNC_RECORD(Type, LLVMType, Name, Init).
// COVMAP_V1, COVMAP_V2, COVMAP_V3 may be defined before inclusion to
// select the record variant.
//===----------------------------------------------------------------------===//

#ifdef COVMAP_FUNC_RECORD
#if defined(COVMAP_V1)
COVMAP_FUNC_RECORD(IntPtrT, IntPtrT, NamePtr, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, NameSize, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, DataSize, Constant)
COVMAP_FUNC_RECORD(uint64_t, uint64_t, FuncHash, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, FilenamesSize, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, CoverageSize, Constant)
#elif defined(COVMAP_V2)
COVMAP_FUNC_RECORD(uint64_t, uint64_t, NameRef, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, DataSize, Constant)
COVMAP_FUNC_RECORD(uint64_t, uint64_t, FuncHash, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, FilenamesSize, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, CoverageSize, Constant)
#else // COVMAP_V3
COVMAP_FUNC_RECORD(uint64_t, uint64_t, NameRef, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, DataSize, Constant)
COVMAP_FUNC_RECORD(uint64_t, uint64_t, FuncHash, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, FilenamesSize, Constant)
COVMAP_FUNC_RECORD(uint64_t, uint64_t, FilenamesRef, Constant)
COVMAP_FUNC_RECORD(uint32_t, uint32_t, CoverageSize, Constant)
// Inline coverage mapping data follows after this struct
#endif
#undef COVMAP_FUNC_RECORD
#endif

