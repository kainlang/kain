//===----------------------------------------------------------------------===//
// INSTR_PROF_VALUE_PROF_DATA — value profiling data structures.
// Defined when INSTR_PROF_VALUE_PROF_DATA is defined before inclusion.
//===----------------------------------------------------------------------===//

#ifdef INSTR_PROF_VALUE_PROF_DATA

// ValueProfRecord and ValueProfRuntimeRecord are closures used by
// the profiling runtime API.
struct ValueProfRecord {
  uint32_t NumValueKinds;
  // Followed by InstrProfValueKind entries, then value data per kind.
};

// Closure for runtime callbacks
struct ValueProfRuntimeRecord {
  uint32_t NumValueKinds;
};

#endif // INSTR_PROF_VALUE_PROF_DATA

