use std::runtime
use std::reload
use std::ui

const RELOAD_ATTRITION_MODULUS: Int = 1000000007

fn digit_value(ch: String) -> Int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    return 9

fn parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    let mut sign = 1
    let mut index = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    let mut value = 0
    while index < len(text):
        value = value * 10 + digit_value(char_at(text, index))
        index = index + 1
    return value * sign

fn attrition_env_int(key: String, fallback: Int) -> Int:
    let text = env(key)
    if len(text) == 0:
        return fallback
    return parse_int_text(text)

fn attrition_record(status: Int, checksum: Int, message: String) -> Int:
    let _result = runtime_attrition_result_set(checksum, status, message)
    return status

fn run_reload_attrition_lane() -> Int:
    let ops = attrition_env_int("KAIN_ATTRITION_OPS", 16)
    let sabotage = env("KAIN_ATTRITION_SABOTAGE")
    let _ui_reset = ui_reset()
    let baseline_sessions = ui_session_count()
    let session = ui_session_create("reload-attrition", 320, 180)
    if session <= 0:
        return attrition_record(1, 0, "ui session invalid")
    if ui_session_count() != baseline_sessions + 1:
        return attrition_record(2, 0, "ui session count mismatch after create")

    var index = 0
    var checksum = 0
    let revision_key = "reload.attrition.rev"
    while index < ops:
        let generation_before = reload_generation(session)
        if generation_before != index:
            return attrition_record(3, checksum, "reload generation before begin mismatch")
        let begun = reload_begin(session, revision_key)
        if begun != index + 1:
            return attrition_record(4, checksum, "reload begin generation mismatch")

        checksum = (checksum + begun + len(revision_key) + index + 97) % RELOAD_ATTRITION_MODULUS
        let _checkpoint = runtime_attrition_checkpoint("reload.commit.generation", begun)

        let mut committed = reload_commit(session)
        if sabotage == "skip_final_commit" and index + 1 == ops:
            committed = begun - 1
        if committed != begun:
            return attrition_record(5, checksum, "reload commit generation mismatch")
        if reload_generation(session) != begun:
            return attrition_record(6, checksum, "reload generation after commit mismatch")

        let _progress = runtime_attrition_note_progress(index, checksum)
        index = index + 1

    if sabotage != "skip_session_destroy":
        let destroyed = ui_session_destroy(session)
        if destroyed < 0:
            return attrition_record(7, checksum, "ui session destroy failed")
    else:
        return attrition_record(8, checksum, "sabotage skip_session_destroy triggered")

    if ui_session_count() != baseline_sessions:
        return attrition_record(9, checksum, "ui session count mismatch after destroy")
    if runtime_heap_validate() < 0:
        return attrition_record(10, checksum, "runtime heap validate failed")
    let _result = runtime_attrition_result_set(checksum, 0, "")
    return 0

fn main() -> Int:
    let boot = runtime_init()
    if boot != 0:
        return 100 + boot
    let status = run_reload_attrition_lane()
    let shutdown_status = runtime_shutdown()
    if shutdown_status != 0:
        if status != 0:
            return status
        return 200 + shutdown_status
    return status
