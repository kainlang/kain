use std::runtime

const ACTOR_ATTRITION_MODULUS: Int = 1000000007

actor Echo:
    state bias: Int = 1

    on Call(reply_to: P, request: Int):
        send reply_to.Reply(value = request + self.bias)

actor Gate:
    on Probe(reply_to: P, request: Int):
        send reply_to.Reply(value = request == 7)

fn digit_value(ch: String) -> Int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    return 9

fn parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    let mut sign = 1
    let mut index = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    let mut value = 0
    while index < len(text):
        value = value * 10 + digit_value(char_at(text, index))
        index = index + 1
    return value * sign

fn attrition_env_int(key: String, fallback: Int) -> Int:
    let text = env(key)
    if len(text) == 0:
        return fallback
    return parse_int_text(text)

fn attrition_record(status: Int, checksum: Int, message: String) -> Int:
    let _result = runtime_attrition_result_set(checksum, status, message)
    return status

fn actor_bool_score(flag: Bool, when_true: Int, when_false: Int) -> Int:
    if flag:
        return when_true
    return when_false

fn run_actor_attrition_lane() -> Int:
    let ops = attrition_env_int("KAIN_ATTRITION_OPS", 256)
    let echo = spawn Echo(bias = 1)
    let gate = spawn Gate()
    let warm = ask(echo, "Call", 9)
    if warm != 10:
        return attrition_record(1, 0, "warm ask mismatch")

    var index = 0
    var checksum = 0
    while index < ops:
        let base = ((index * 13) + 7) % ACTOR_ATTRITION_MODULUS
        let first = ask(echo, "Call", base)
        let second = ask_timeout(echo, "Call", base + 31, 1000)
        let third = ask(echo, "Call", base + 63)
        let allowed: Bool = ask(gate, "Probe", 7)
        let denied: Bool = ask_timeout(gate, "Probe", 9, 1000)
        if first != base + 1:
            return attrition_record(2, checksum, "first ask mismatch")
        if second != base + 32:
            return attrition_record(3, checksum, "ask_timeout mismatch")
        if third != base + 64:
            return attrition_record(4, checksum, "third ask mismatch")
        if allowed == false:
            return attrition_record(5, checksum, "gate allowed probe mismatch")
        if denied != false:
            return attrition_record(6, checksum, "gate denied probe mismatch")
        checksum = (checksum + first + second + third + actor_bool_score(allowed, 7, 3) + actor_bool_score(denied, 11, 5) + index) % ACTOR_ATTRITION_MODULUS
        if index % 256 == 0:
            let _progress = runtime_attrition_note_progress(index, checksum)
        index = index + 1

    return attrition_record(0, checksum, "")

fn main() -> Int:
    let boot = runtime_init()
    if boot != 0:
        return 100 + boot
    let status = run_actor_attrition_lane()
    let shutdown_status = runtime_shutdown()
    if shutdown_status != 0:
        if status != 0:
            return status
        return 200 + shutdown_status
    return status
