use std::runtime
use std::fmt
use std::json
use std::text
use std::collections
use std::crypto
use std::alloc
use std::sync

const STDLIB_FOUNDATIONS_ATTRITION_MODULUS: Int = 1000000007
const SHA256_EMPTY: String = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
const HMAC_SHA256_QUICK: String = "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"
const BLAKE3_EMPTY: String = "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"

fn digit_value(ch: String) -> Int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    return 9

fn parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    var index = 0
    var sign = 1
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    var value = 0
    while index < len(text):
        value = value * 10 + digit_value(char_at(text, index))
        index = index + 1
    return value * sign

fn attrition_env_int(key: String, fallback: Int) -> Int:
    let text = env(key)
    if len(text) == 0:
        return fallback
    return parse_int_text(text)

fn attrition_complete(status: Int, checksum: Int, message: String) -> Int:
    let _result = runtime_attrition_result_set(checksum, status, message)
    let shutdown_status = runtime_shutdown()
    if shutdown_status != 0:
        if status != 0:
            return status
        return 200 + shutdown_status
    return status

fn exercise_foundations(iteration: Int) -> Int with Unsafe:
    let text = text_trim(text_from("  attrition:foundation priority:hot  "))
    if text_contains(text, "foundation") == false:
        return -1
    if text_contains(text, "priority") == false:
        return -2

    var metrics = typed_map_new()
    metrics = typed_map_set(metrics, "iteration", iteration + 3)
    metrics = typed_map_set(metrics, "text", text_len(text))

    var queue = queue_create(4)
    queue = queue_push(queue, iteration + 1)
    queue = queue_push(queue, iteration + 2)
    let queue_score = queue_peek(queue)
    let _queue_destroy = queue_destroy(queue)

    var pq = priority_queue_create(4)
    pq = priority_queue_push(pq, iteration + 10, 2)
    pq = priority_queue_push(pq, iteration + 20, 9)
    let pq_score = priority_queue_peek_value(pq) + priority_queue_peek_priority(pq)
    let _pq_destroy = priority_queue_destroy(pq)

    var slots = slot_map_create(2)
    let slot_a = slot_map_insert(slots, iteration + 101)
    if slot_a.ok == false:
        return -9
    slots = slot_a.map
    let slot_removed = slot_map_remove(slots, slot_a.key)
    if slot_removed.ok == false:
        return -10
    slots = slot_removed.map
    if slot_map_contains(slots, slot_a.key):
        return -11
    let slot_b = slot_map_insert(slots, iteration + 202)
    if slot_b.ok == false:
        return -12
    slots = slot_b.map
    if slot_map_key_generation(slot_b.key) == slot_map_key_generation(slot_a.key):
        return -13
    let slot_score = slot_removed.value + slot_map_get_or(slots, slot_b.key, 0) + slot_map_key_generation(slot_b.key)
    let _slots_destroy = slot_map_destroy(slots)

    var bump = bump_create(4)
    let bump_cell = bump_alloc(bump, 1)
    if bump_cell.ok == false:
        return -3
    bump = bump_cell.allocator
    mem_store(bump_cell.ptr, iteration % 997, "Int")
    let bump_score = mem_load(bump_cell.ptr, "Int")
    let _bump_destroy = bump_allocator_destroy(bump)

    var pool = pool_create(1, 2)
    let block = pool_alloc(pool)
    if block.ok == false:
        return -4
    pool = block.pool
    mem_store(block.ptr, iteration + 31, "Int")
    let pool_score = mem_load(block.ptr, "Int")
    let _pool_destroy = pool_allocator_destroy(pool)

    if sha256("") != SHA256_EMPTY:
        return -5
    if hmac_sha256("key", "The quick brown fox jumps over the lazy dog") != HMAC_SHA256_QUICK:
        return -6
    if blake3("") != BLAKE3_EMPTY:
        return -7
    if iteration % 8 == 0:
        if len(random_bytes(8)) != 16:
            return -8

    let payload = json_object()
    let _json_name = json_object_set_string(payload, "name", "attrition")
    let _json_iteration = json_object_set_int(payload, "iteration", iteration)
    let _json_ratio = json_object_set_float(payload, "ratio", (iteration % 7) / 2.0)
    let _json_flags = json_object_set_bool_array(payload, "flags", [true, false])
    let rendered = json_stringify(payload)
    let parsed = json_parse_text(rendered)
    if text_contains_string(rendered, "\"iteration\":") == false:
        return -28
    if text_contains_string(rendered, "\"ratio\":") == false:
        return -29
    if text_contains_string(rendered, "\"flags\":[true,false]") == false:
        return -30
    let scan = json_scan_report(rendered)
    if scan.ok == false:
        return -31
    if json_string_required(parsed, "name") != "attrition":
        return -32
    let parsed_flags = json_bool_array_field_result(parsed, "flags")
    if parsed_flags.ok == false or len(parsed_flags.value) != 2:
        return -33
    if parsed_flags.value[0] == false or parsed_flags.value[1] == true:
        return -34
    let parsed_ratio = json_float_required(parsed, "ratio")
    if parsed_ratio < 0.0 or parsed_ratio > 3.0:
        return -35
    let rendered_again = fmt_writer_build(json_fmt_writer_push_value(fmt_writer_new(), payload))
    if rendered_again != rendered:
        return -36

    let lock = mcs_mutex_new()
    let node = mcs_node_new()
    if mcs_mutex_lock(lock, node) != SYNC_OK:
        return -14
    if mcs_mutex_unlock(lock, node) != SYNC_OK:
        return -15
    let _node_destroy = mcs_node_destroy(node)
    let _lock_destroy = mcs_mutex_destroy(lock)

    let chan = teleport_channel_new(1)
    let chan_item = alloc_zeroed(1, "Int")
    mem_store(chan_item, iteration + 31, "Int")
    let chan_token = ptr_to_int(chan_item)
    if teleport_channel_send(chan, chan_token) == false:
        return -16
    if teleport_channel_recv(chan) != chan_token:
        return -17
    let chan_score = mem_load(int_to_ptr(chan_token, "ptr<Int>"), "Int")
    decay chan_item
    let _chan_destroy = teleport_channel_destroy(chan)

    let gate = once_new()
    if once_do(gate) != 1:
        return -18
    if iteration % 3 == 0:
        if once_reset(gate) != SYNC_OK:
            return -19
        if once_do(gate) != 1:
            return -20
    if once_complete(gate) != SYNC_OK:
        return -21
    if once_do(gate) != 0:
        return -22
    let _gate_destroy = once_destroy(gate)

    let wg = wait_group_new()
    if wait_group_add(wg, 2) != SYNC_OK:
        return -23
    if wait_group_done(wg) != SYNC_OK:
        return -24
    if wait_group_done(wg) != SYNC_OK:
        return -25
    if wait_group_wait(wg) != SYNC_OK:
        return -26
    if wait_group_done(wg) != SYNC_ERR_NEGATIVE_COUNT:
        return -27
    let _wg_destroy = wait_group_destroy(wg)

    let map_score = typed_map_get(metrics, "iteration") + typed_map_get(metrics, "text")
    let json_score = len(rendered) + len(json_string_required(parsed, "name")) + 98
    let _metrics_destroy = typed_map_destroy(metrics)
    let text_score = text_byte_at(text, iteration % text_len(text))
    return (map_score + queue_score + pq_score + slot_score + bump_score + pool_score + text_score + chan_score + json_score) % STDLIB_FOUNDATIONS_ATTRITION_MODULUS

fn main() -> Int with Unsafe:
    let boot = runtime_init()
    if boot < 0:
        return 100 + boot
    let ops = attrition_env_int("KAIN_ATTRITION_OPS", 8)
    var index = 0
    var checksum = 0
    while index < ops:
        let score = exercise_foundations(index)
        if score < 0:
            return attrition_complete(10 - score, checksum, "stdlib foundation exercise failed")
        checksum = (checksum + score + index * 17) % STDLIB_FOUNDATIONS_ATTRITION_MODULUS
        if index % 4 == 0:
            let _progress = runtime_attrition_note_progress(index, checksum)
        index = index + 1
    if runtime_heap_validate() < 0:
        return attrition_complete(90, checksum, "runtime heap validate failed")
    return attrition_complete(0, checksum, "")
