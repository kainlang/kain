use std::runtime
use std::actor
use std::collections
use std::diagnostics
use std::result
use std::time
use std::intent
use std::fs
use std::input
use std::net
use std::http
use std::tls
use std::http2
use std::process
use std::graphics
use std::ui

const STDLIB_ATTRITION_MODULUS: Int = 1000000007

actor StdDomainActor:
    state score: Int = 0

    on Ping(payload: String):
        self.score = self.score + len(payload)

fn digit_value(ch: String) -> Int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    return 9

fn parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    let mut sign = 1
    let mut index = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    let mut value = 0
    while index < len(text):
        value = value * 10 + digit_value(char_at(text, index))
        index = index + 1
    return value * sign

fn attrition_env_int(key: String, fallback: Int) -> Int:
    let text = env(key)
    if len(text) == 0:
        return fallback
    return parse_int_text(text)

fn attrition_complete(status: Int, checksum: Int, message: String) -> Int:
    let _result = runtime_attrition_result_set(checksum, status, message)
    let shutdown_status = runtime_shutdown()
    if shutdown_status != 0:
        if status != 0:
            return status
        return 200 + shutdown_status
    return status

fn main() -> Int:
    let boot = runtime_init()
    if boot < 0:
        return 100 + boot

    if result_ok() != 0:
        return attrition_complete(1, 0, "result_ok mismatch")
    if result_is_ok(result_ok()) == false:
        return attrition_complete(2, 0, "result_is_ok mismatch")
    if status_ok(0) == false:
        return attrition_complete(3, 0, "status_ok mismatch")
    if bool_to_status(true) != 0:
        return attrition_complete(4, 0, "bool_to_status mismatch")
    if int_clamp(19, 0, 7) != 7:
        return attrition_complete(5, 0, "int_clamp mismatch")
    if bool_to_int(true) != 1:
        return attrition_complete(6, 0, "bool_to_int mismatch")
    if process_platform_available() < 0:
        return attrition_complete(7, 0, "process platform unavailable")
    if net_platform_available() < 0:
        return attrition_complete(8, 0, "net platform unavailable")
    if net_capability_state("tcp") <= 0:
        return attrition_complete(9, 0, "tcp capability unavailable")
    if tls_client_state() < 0:
        return attrition_complete(10, 0, "tls client state unavailable")

    let ops = attrition_env_int("KAIN_ATTRITION_OPS", 8)
    var index = 0
    var checksum = 0
    while index < ops:
        let start_ms = now_millis()
        if deadline_millis(0) < start_ms:
            return attrition_complete(11, checksum, "deadline_millis regressed")

        let actor_id = actor_spawn("StdDomainActor", "score=0")
        if actor_id_is_valid(actor_id) == false:
            return attrition_complete(12, checksum, "actor spawn invalid")
        let _actor_send = actor_send(actor_id, "Ping", "stdlib")
        let _actor_stop = actor_shutdown(actor_id)

        let _entangle_reset = entangle_reset()
        if entangle_registered_count() < 0:
            return attrition_complete(13, checksum, "entangle count invalid")
        if law_status(true) != 0:
            return attrition_complete(14, checksum, "law_status mismatch")

        let temp_path = fs_temp_file("stdlib-domains")
        fs_write_text(temp_path, "root-stdlib")
        if fs_read_text(temp_path) != "root-stdlib":
            return attrition_complete(15, checksum, "fs readback mismatch")
        fs_remove_file(temp_path)
        if fs_exists(temp_path):
            return attrition_complete(16, checksum, "fs remove mismatch")

        let _input_reset = input_reset()
        let input_session = input_session_create("stdlib-domains")
        if input_session <= 0:
            return attrition_complete(17, checksum, "input session invalid")
        let _input_push = input_push_key_down(input_session, "keyboard-main", "KeyA")
        let _input_frame = input_begin_frame(input_session, 16.0)
        if input_frame_index(input_session) < 0:
            return attrition_complete(18, checksum, "input frame invalid")
        let _input_destroy = input_session_destroy(input_session)

        let request = request_create("GET", "http://127.0.0.1:1/")
        if request <= 0:
            return attrition_complete(19, checksum, "http request invalid")
        if request_protocol(request) != "http/1.1":
            return attrition_complete(20, checksum, "http protocol mismatch")
        let h2_request = http2_request_create("GET", "https://example.invalid/")
        if h2_request <= 0:
            return attrition_complete(21, checksum, "http2 request invalid")
        if http2_request_protocol(h2_request) != "http/2":
            return attrition_complete(22, checksum, "http2 protocol mismatch")
        let _request_destroy = request_destroy(request)
        let _h2_destroy = request_destroy(h2_request)

        let _graphics_reset = graphics_reset()
        let graphics_session = graphics_session_create("stdlib-domains", 64, 64)
        if graphics_session <= 0:
            return attrition_complete(23, checksum, "graphics session invalid")
        if graphics_session_count() <= 0:
            return attrition_complete(24, checksum, "graphics session count invalid")
        let _graphics_destroy = graphics_session_destroy(graphics_session)

        let _ui_reset = ui_reset()
        let ui_session = ui_session_create("stdlib-domains", 320, 180)
        if ui_session <= 0:
            return attrition_complete(25, checksum, "ui session invalid")
        let node = ui_node_create(ui_session, "panel")
        if node <= 0:
            return attrition_complete(26, checksum, "ui node invalid")
        let _node_rect = ui_node_set_rect(ui_session, node, 8.0, 9.0, 120.0, 32.0)
        let _node_text = ui_node_set_text(ui_session, node, "std.ui")
        if ui_node_text(ui_session, node) != "std.ui":
            return attrition_complete(27, checksum, "ui text mismatch")
        let _ui_destroy = ui_session_destroy(ui_session)

        checksum = (checksum + 97 + (index * 17) + len("root-stdlib") + len("std.ui")) % STDLIB_ATTRITION_MODULUS
        if index % 4 == 0:
            let _progress = runtime_attrition_note_progress(index, checksum)
        index = index + 1

    if runtime_heap_validate() < 0:
        return attrition_complete(28, checksum, "runtime heap validate failed")
    return attrition_complete(0, checksum, "")
