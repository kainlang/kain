component App():
    render <panel title="Kain Native Bundle Smoke" layout="dock" gap={12} padding={12}>
        <panel title="Studio" layout="row" gap={12}>
            <inspector title="Selection">
                Native bundle runtime validation
            </inspector>
            <tree title="Assets">
                scenes/
                retirement_demo.scene
            </tree>
        </panel>
        <timeline title="Animation" />
        <viewport3d title="Scene Preview" scene="retirement_demo" />
    </panel>
