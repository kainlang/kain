use std::cuda
use std::fs
use std::json

const PROBE_REPO_ROOT: String = "."
const PROBE_MANIFEST_PATH: String = "blades/cuda/kain_compute_residency.json"
const PROBE_REPORT_PATH: String = "blades/cuda/.kain/run/cuda_manifest_probe.txt"

fn append_line(report: String, label: String, value: String) -> String:
    return report + label + "=" + value + "\n"

fn bool_string(value: Bool) -> String:
    if value:
        return "true"
    return "false"

fn synthetic_manifest_json() -> String:
    let binding = json_object()
    json_object_set_string(binding, "key", "dst")
    json_object_set_string(binding, "descriptor_kind", "storage_buffer")
    json_object_set_string(binding, "element_type", "u32")
    json_object_set_string(binding, "access_mode", "write")
    json_object_set_int(binding, "slot", 0)
    json_object_set_int(binding, "byte_length", 16)
    json_object_set_string(binding, "payload_file", "dst.bin")

    let bindings = json_array()
    json_array_push_object(bindings, binding)

    let entry = json_object()
    json_object_set_string(entry, "key", "synthetic.kernel")
    json_object_set_array(entry, "bindings", bindings)

    let entries = json_array()
    json_array_push_object(entries, entry)

    let manifest = json_object()
    json_object_set_int(manifest, "schema_version", 1)
    json_object_set_array(manifest, "compute_shaders", entries)
    return json_stringify(manifest)

fn inspect_text(text: String, tag: String, report: String) -> String:
    let scan = json_scan_report(text)
    let parsed = json_parse_text(text)
    let array_result = json_array_field(parsed, "compute_shaders")
    let reparsed_text = json_stringify(parsed)
    var next = report
    next = append_line(next, tag + ".text_len", to_string(len(text)))
    next = append_line(next, tag + ".scan_ok", bool_string(scan.ok))
    next = append_line(next, tag + ".scan_code", to_string(scan.code))
    next = append_line(next, tag + ".parsed_kind", json_value_kind(parsed))
    next = append_line(next, tag + ".parsed_text_len", to_string(len(reparsed_text)))
    next = append_line(next, tag + ".has_compute_shaders", bool_string(json_has_key(parsed, "compute_shaders")))
    next = append_line(next, tag + ".array_ok", bool_string(array_result.ok))
    next = append_line(next, tag + ".array_status", to_string(array_result.status.code))
    if json_has_key(parsed, "compute_shaders"):
        let raw_field = json_get_value(parsed, "compute_shaders")
        let raw_field_text = json_stringify(raw_field)
        next = append_line(next, tag + ".raw_field_kind", json_value_kind(raw_field))
        next = append_line(next, tag + ".raw_field_text_len", to_string(len(raw_field_text)))

    if array_result.ok:
        next = append_line(next, tag + ".array_len", to_string(json_array_length(array_result.value)))
        if json_array_length(array_result.value) > 0:
            let first = json_array_value_at(array_result.value, 0)
            let first_text = json_stringify(first)
            let first_object = json_parse_text(first_text)
            let first_key = json_string_field(first_object, "key")
            next = append_line(next, tag + ".first_kind", json_value_kind(first))
            next = append_line(next, tag + ".first_text_len", to_string(len(first_text)))
            next = append_line(next, tag + ".first_key_ok", bool_string(first_key.ok))
            next = append_line(next, tag + ".first_key", if first_key.ok: first_key.value else: "")
    else:
        next = append_line(next, tag + ".array_len", "-1")
    return next

fn inspect_manifest(path: String, tag: String, report: String) -> String:
    let text = fs_read_text(path)
    var next = report
    next = append_line(next, tag + ".exists", bool_string(fs_exists(path)))
    next = inspect_text(text, tag, next)

    let keys = cuda_compute_keys_from_path(path)
    next = append_line(next, tag + ".cuda_key_count", to_string(len(keys)))
    if len(keys) > 0:
        next = append_line(next, tag + ".cuda_first_key", keys[0])
    return next

fn main() -> Int:
    var report = ""
    report = append_line(report, "repo_root.exists", bool_string(fs_exists(PROBE_REPO_ROOT)))
    report = inspect_text(synthetic_manifest_json(), "synthetic", report)
    report = inspect_manifest(PROBE_MANIFEST_PATH, "real", report)
    fs_write_text(PROBE_REPORT_PATH, report)
    return 0
