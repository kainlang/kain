pub const MCP_PROBE_PATH: String = "/mcp/health"
pub const MCP_PROBE_QUERY: String = "transport=http"
pub const MCP_PROBE_METHOD: String = "GET"
pub const MCP_PROBE_PROTOCOL: String = "http/1.1"
pub const MCP_PROBE_RESPONSE_STATUS: Int = 207
pub const MCP_PROBE_BODY: String = "{\"jsonrpc\":\"2.0\",\"method\":\"mcp.probe\",\"id\":1}"

pub fn mcp_probe_request_text() -> String:
    return "GET /mcp/health?transport=http HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 45\r\n\r\n{\"jsonrpc\":\"2.0\",\"method\":\"mcp.probe\",\"id\":1}"

pub fn mcp_probe_response_header() -> String:
    return "x-kain-mcp"

pub fn mcp_probe_response_header_value() -> String:
    return "network-scaffold"
