use std::json
use std::process
use std::text
use agent_mcp_config::load_agent_mcp_config
use agent_mcp_protocol::mcp_build_initialize_result
use agent_mcp_protocol::mcp_build_jsonrpc_error
use agent_mcp_protocol::mcp_build_jsonrpc_success
use agent_mcp_protocol::mcp_build_tools_list_result
use agent_mcp_protocol::mcp_read_next_request_frame
use agent_mcp_protocol::mcp_write_response_frame
use agent_mcp_tools::dispatch_agent_mcp_tool
use agent_mcp_util::mcp_string_field_or

pub struct McpRouteResult:
    response: String
    should_exit: Bool

fn route_request(raw_request: String) -> McpRouteResult:
    let request = json_parse_text(raw_request)
    let method = mcp_string_field_or(request, "method", "")
    let has_id = json_has_key(request, "id")
    let params_result = json_object_field(request, "params")
    let params = if params_result.ok:
        params_result.value
    else:
        json_object()

    if method == "initialize":
        if has_id == false:
            return McpRouteResult { response: "", should_exit: false }
        let requested_protocol = mcp_string_field_or(params, "protocolVersion", "")
        return McpRouteResult {
            response: mcp_build_jsonrpc_success(request, mcp_build_initialize_result(requested_protocol)),
            should_exit: false,
        }

    if method == "notifications/initialized":
        return McpRouteResult { response: "", should_exit: false }

    if method == "ping":
        if has_id == false:
            return McpRouteResult { response: "", should_exit: false }
        return McpRouteResult {
            response: mcp_build_jsonrpc_success(request, json_object()),
            should_exit: false,
        }

    if method == "tools/list":
        if has_id == false:
            return McpRouteResult { response: "", should_exit: false }
        return McpRouteResult {
            response: mcp_build_jsonrpc_success(request, mcp_build_tools_list_result()),
            should_exit: false,
        }

    if method == "tools/call":
        if has_id == false:
            return McpRouteResult { response: "", should_exit: false }
        let tool_name = mcp_string_field_or(params, "name", "")
        let args_result = json_object_field(params, "arguments")
        let tool_args = if args_result.ok:
            args_result.value
        else:
            json_object()
        let config = load_agent_mcp_config()
        let tool_result = dispatch_agent_mcp_tool(config, tool_name, tool_args)
        return McpRouteResult {
            response: mcp_build_jsonrpc_success(request, tool_result),
            should_exit: false,
        }

    if method == "shutdown":
        if has_id == false:
            return McpRouteResult { response: "", should_exit: false }
        return McpRouteResult {
            response: mcp_build_jsonrpc_success(request, json_parse_text("null")),
            should_exit: false,
        }

    if method == "exit":
        return McpRouteResult { response: "", should_exit: true }

    if has_id == false:
        return McpRouteResult { response: "", should_exit: false }
    return McpRouteResult {
        response: mcp_build_jsonrpc_error(request, -32601, "Method not found: " + method),
        should_exit: false,
    }

fn self_test_request(id: Int, method: String, params_text: String) -> String:
    return "{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"method\":\"" + method + "\",\"params\":" + params_text + "}"

fn self_test() -> Int:
    let initialize = route_request(self_test_request(1, "initialize", "{\"protocolVersion\":\"2025-06-18\"}"))
    if len(initialize.response) == 0:
        return 1
    let initialize_json = json_parse_text(initialize.response)
    let initialize_result = json_object_field(initialize_json, "result")
    if initialize_result.ok == false:
        return 2
    if mcp_string_field_or(initialize_result.value, "protocolVersion", "") == "":
        return 3

    let tools = route_request(self_test_request(2, "tools/list", "{}"))
    let tools_json = json_parse_text(tools.response)
    let tools_result = json_object_field(tools_json, "result")
    if tools_result.ok == false:
        return 4
    let tools_array = json_array_field(tools_result.value, "tools")
    if tools_array.ok == false or json_array_length(tools_array.value) < 6:
        return 5

    let stdlib_query = route_request(
        self_test_request(3, "tools/call", "{\"name\":\"stdlib.query\",\"arguments\":{\"module\":\"net\",\"contains\":\"tcp\",\"limit\":3}}")
    )
    let stdlib_json = json_parse_text(stdlib_query.response)
    let stdlib_result = json_object_field(stdlib_json, "result")
    if stdlib_result.ok == false:
        return 6
    let stdlib_error = json_bool_field(stdlib_result.value, "isError")
    if stdlib_error.ok and stdlib_error.value:
        return 7

    let examples_query = route_request(
        self_test_request(4, "tools/call", "{\"name\":\"repo.examples\",\"arguments\":{\"topic\":\"gpu\",\"limit\":3}}")
    )
    let examples_json = json_parse_text(examples_query.response)
    let examples_result = json_object_field(examples_json, "result")
    if examples_result.ok == false:
        return 8
    let examples_error = json_bool_field(examples_result.value, "isError")
    if examples_error.ok and examples_error.value:
        return 9

    let commands_query = route_request(
        self_test_request(5, "tools/call", "{\"name\":\"kain.commands.describe\",\"arguments\":{\"query\":\"run plan\"}}")
    )
    let commands_json = json_parse_text(commands_query.response)
    let commands_result = json_object_field(commands_json, "result")
    if commands_result.ok == false:
        return 10
    let commands_error = json_bool_field(commands_result.value, "isError")
    if commands_error.ok and commands_error.value:
        return 11

    return 0

fn boot_mode() -> String:
    let env_mode = text_lower(text_trim_string(process_environment("KAIN_AGENT_MCP_BOOT_MODE")))
    if len(env_mode) > 0:
        return env_mode
    return "stdio"

// ============================================================================
//                         runtime-native MCP main loop
// ============================================================================

pub fn run_agent_mcp() -> Int:
    let mode = boot_mode()
    if mode == "self-test":
        return self_test()
    if mode == "exit":
        return 0

    let user_args = process_user_args()
    var arg_index = 0
    while arg_index < len(user_args):
        if user_args[arg_index] == "--self-test":
            return self_test()
        arg_index = arg_index + 1

    while true:
        let raw_request = mcp_read_next_request_frame()
        if len(raw_request) == 0:
            return 0
        let routed = route_request(raw_request)
        if len(routed.response) > 0:
            mcp_write_response_frame(routed.response)
        if routed.should_exit:
            return 0
    return 0
