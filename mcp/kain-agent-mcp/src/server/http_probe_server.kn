use std::net
use std::http
use std::tls
use std::http2
use http_probe_protocol::MCP_PROBE_BODY
use http_probe_protocol::MCP_PROBE_METHOD
use http_probe_protocol::MCP_PROBE_PATH
use http_probe_protocol::MCP_PROBE_PROTOCOL
use http_probe_protocol::MCP_PROBE_QUERY
use http_probe_protocol::MCP_PROBE_RESPONSE_STATUS
use http_probe_protocol::mcp_probe_request_text
use http_probe_protocol::mcp_probe_response_header
use http_probe_protocol::mcp_probe_response_header_value
use health_tool::health_ping_response
use health_tool::health_response_is_valid

actor McpProbeActor:
    state hits: Int = 0

    on Probe(payload: String):
        self.hits = self.hits + len(payload)

pub fn run_mcp_http_probe() -> Int:
    let _reset = net_reset()

    if net_platform_available() != 1:
        return 0
    if net_platform_name() == "":
        return 1

    let server = server_create_localhost(0)
    if server <= 0:
        return 2
    if server_listen(server) != 0:
        return 3

    let port = server_local_port(server)
    if port <= 0:
        return 4

    let handler = native_actor_spawn("McpProbeActor", "hits=0")
    if handler <= 0:
        return 5
    if route_actor(server, MCP_PROBE_METHOD, MCP_PROBE_PATH, handler, "Probe") != 0:
        return 6

    let client = tcp_connect("127.0.0.1", port, 5000)
    if client <= 0:
        return 7
    if tcp_write_text(client, mcp_probe_request_text()) != 0:
        return 8

    let incoming = server_pump(server, 5000)
    if incoming <= 0:
        return 9
    if server_next_request(server) != incoming:
        return 10
    if server_pending_request_count(server) != 0:
        return 11
    if request_method(incoming) != MCP_PROBE_METHOD:
        return 12
    if request_path(incoming) != MCP_PROBE_PATH:
        return 13
    if request_query(incoming) != MCP_PROBE_QUERY:
        return 14
    if request_protocol(incoming) != MCP_PROBE_PROTOCOL:
        return 15
    let body = request_body_text(incoming)
    if body != MCP_PROBE_BODY:
        return 16

    let tls_request = tls_https_request_create("GET", "https://example.invalid/mcp")
    if tls_request <= 0:
        return 17
    if request_protocol(tls_request) != MCP_PROBE_PROTOCOL:
        return 18
    let h2_request = http2_request_create("GET", "https://example.invalid/mcp")
    if h2_request <= 0:
        return 19
    if http2_request_protocol(h2_request) != "http/2":
        return 20

    let tls_state = tls_client_state()
    let http2_state = http2_client_state()
    if tls_state < 0:
        return 21
    if http2_state < 0:
        return 22

    let _header = response_set_header_for_request(incoming, mcp_probe_response_header(), mcp_probe_response_header_value())
    let payload = health_ping_response(port, body, tls_state, http2_state)
    if respond_text(incoming, MCP_PROBE_RESPONSE_STATUS, payload) != 0:
        return 23

    let response_text = tcp_read_text(client)
    if health_response_is_valid(response_text) == false:
        return 24

    let _destroy_tls = request_destroy(tls_request)
    let _destroy_h2 = request_destroy(h2_request)
    let _close_client = tcp_close(client)
    let _close_server = server_close(server)
    return 0
