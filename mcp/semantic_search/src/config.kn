// ============================================================================
//                    semantic-search :: config loader
// ============================================================================
// Reads config.toml from the package root and exposes typed config values.
// This is a minimal TOML parser — we only need to handle the flat sections
// we defined in config.toml, not full TOML compliance.

use std::fs
use std::text
use std::json

pub struct SemanticSearchConfig:
    repo_root: String
    code_dirs: Array<String>
    kain_dirs: Array<String>
    code_extensions: Array<String>
    kain_extensions: Array<String>
    index_dir: String
    model_name: String
    dim: Int
    batch_size: Int
    max_chunk_chars: Int
    min_chunk_chars: Int
    overlap_chars: Int
    default_top_k: Int
    max_top_k: Int
    min_score: Float
    server_host: String
    server_port: Int
    max_concurrent: Int
    request_timeout_ms: Int
    gpu_enabled: Bool
    gpu_device_index: Int
    gpu_threads_per_block: Int
    gpu_batch_chunks: Int

// ---- default config --------------------------------------------------------

pub fn default_config() -> SemanticSearchConfig:
    let mut code_dirs: Array<String> = []
    push(code_dirs, "crates")
    push(code_dirs, "runtime")
    let mut kain_dirs: Array<String> = []
    push(kain_dirs, "stdlib")
    push(kain_dirs, "blades")
    push(kain_dirs, "smoketest")
    push(kain_dirs, "benchmark")
    push(kain_dirs, "library_of_kain")
    let mut code_extensions: Array<String> = []
    push(code_extensions, "rs")
    push(code_extensions, "c")
    push(code_extensions, "h")
    push(code_extensions, "cpp")
    push(code_extensions, "hpp")
    push(code_extensions, "toml")
    push(code_extensions, "bazel")
    push(code_extensions, "bzl")
    let mut kain_extensions: Array<String> = []
    push(kain_extensions, "kn")
    return SemanticSearchConfig {
        repo_root: "..\\..",
        code_dirs: code_dirs,
        kain_dirs: kain_dirs,
        code_extensions: code_extensions,
        kain_extensions: kain_extensions,
        index_dir: ".kain/indices",
        model_name: "all-MiniLM-L6-v2",
        dim: 384,
        batch_size: 64,
        max_chunk_chars: 2048,
        min_chunk_chars: 128,
        overlap_chars: 256,
        default_top_k: 10,
        max_top_k: 100,
        min_score: 0.0,
        server_host: "127.0.0.1",
        server_port: 9020,
        max_concurrent: 8,
        request_timeout_ms: 30000,
        gpu_enabled: true,
        gpu_device_index: 0,
        gpu_threads_per_block: 256,
        gpu_batch_chunks: 100000,
    }

// ---- load from file --------------------------------------------------------

pub fn load_config(path: String) -> SemanticSearchConfig:
    if fs_exists(path) == false:
        return default_config()
    let raw = fs_read_text(path)
    let parsed = parse_config_text(raw)
    return resolve_config_paths(sanitize_config(parsed), path)

// ---- minimal TOML parser ---------------------------------------------------

fn parse_config_text(raw: String) -> SemanticSearchConfig:
    let mut cfg = default_config()
    let lines = text_split_lines(raw)
    var section: String = ""
    var i: Int = 0
    while i < len(lines):
        let src_line = text_trim_string(lines[i])
        i = i + 1
        if src_line == "" or text_starts_with_string(src_line, "#"):
            continue
        if text_starts_with_string(src_line, "[") and text_ends_with_string(src_line, "]"):
            section = substring(src_line, 1, len(src_line) - 1)
            continue
        let eq = text_find(text_slice(src_line, 0, len(src_line)), "=")
        if eq < 0:
            continue
        let key = text_trim_string(substring(src_line, 0, eq))
        let val_raw = text_trim_string(substring(src_line, eq + 1, len(src_line)))
        let mut val = val_raw
        if text_starts_with_string(val_raw, "[") and text_ends_with_string(val_raw, "]") == false:
            while i < len(lines):
                let next_line = text_trim_string(lines[i])
                i = i + 1
                if next_line == "" or text_starts_with_string(next_line, "#"):
                    continue
                val = val + next_line
                if text_ends_with_string(next_line, "]"):
                    break
        val = toml_strip_quotes(val)
        cfg = apply_toml_key(cfg, section, key, val)
    return cfg

fn toml_strip_quotes(s: String) -> String:
    if len(s) >= 2 and text_starts_with_string(s, "\"") and text_ends_with_string(s, "\""):
        return substring(s, 1, len(s) - 1)
    if len(s) >= 2 and text_starts_with_string(s, "'") and text_ends_with_string(s, "'"):
        return substring(s, 1, len(s) - 1)
    return s

fn apply_toml_key(cfg: SemanticSearchConfig, section: String, key: String, val: String) -> SemanticSearchConfig:
    if section == "paths" and key == "repo_root":
        cfg.repo_root = val
    if section == "paths" and key == "index_dir":
        cfg.index_dir = val
    if section == "paths" and key == "code_dirs":
        cfg.code_dirs = toml_string_array(val)
    if section == "paths" and key == "kain_dirs":
        cfg.kain_dirs = toml_string_array(val)
    if section == "paths" and key == "code_extensions":
        cfg.code_extensions = toml_string_array(val)
    if section == "paths" and key == "kain_extensions":
        cfg.kain_extensions = toml_string_array(val)
    if section == "embedding" and key == "model_name":
        cfg.model_name = val
    if section == "embedding" and key == "dim":
        cfg.dim = toml_int(val)
    if section == "embedding" and key == "batch_size":
        cfg.batch_size = toml_int(val)
    if section == "chunking" and key == "max_chunk_chars":
        cfg.max_chunk_chars = toml_int(val)
    if section == "chunking" and key == "min_chunk_chars":
        cfg.min_chunk_chars = toml_int(val)
    if section == "chunking" and key == "overlap_chars":
        cfg.overlap_chars = toml_int(val)
    if section == "search" and key == "default_top_k":
        cfg.default_top_k = toml_int(val)
    if section == "search" and key == "max_top_k":
        cfg.max_top_k = toml_int(val)
    if section == "search" and key == "min_score":
        cfg.min_score = toml_float(val)
    if section == "server" and key == "host":
        cfg.server_host = val
    if section == "server" and key == "port":
        cfg.server_port = toml_int(val)
    if section == "server" and key == "max_concurrent":
        cfg.max_concurrent = toml_int(val)
    if section == "server" and key == "request_timeout_ms":
        cfg.request_timeout_ms = toml_int(val)
    if section == "gpu" and key == "enabled":
        cfg.gpu_enabled = toml_bool(val)
    if section == "gpu" and key == "device_index":
        cfg.gpu_device_index = toml_int(val)
    if section == "gpu" and key == "threads_per_block":
        cfg.gpu_threads_per_block = toml_int(val)
    if section == "gpu" and key == "batch_chunks":
        cfg.gpu_batch_chunks = toml_int(val)
    if section == "gpu" and key == "gpu_batch_chunks":
        cfg.gpu_batch_chunks = toml_int(val)
    return cfg

// ---- TOML value parsers ----------------------------------------------------

fn toml_string_array(raw: String) -> Array<String>:
    let trimmed = text_trim_string(raw)
    if text_starts_with_string(trimmed, "[") == false or text_ends_with_string(trimmed, "]") == false:
        return []
    let inner = text_trim_string(substring(trimmed, 1, len(trimmed) - 1))
    if inner == "":
        return []
    let parts = text_split_string(inner, ",")
    let mut result: Array<String> = []
    var j: Int = 0
    while j < len(parts):
        let item = toml_strip_quotes(text_trim_string(parts[j]))
        if item != "":
            push(result, item)
        j = j + 1
    return result

fn toml_int(raw: String) -> Int:
    return to_int(raw)

fn toml_float(raw: String) -> Float:
    return to_float(raw)

fn toml_bool(raw: String) -> Bool:
    return raw == "true"

fn sanitize_config(cfg: SemanticSearchConfig) -> SemanticSearchConfig:
    let defaults = default_config()
    cfg.code_dirs = config_compact_or_default(cfg.code_dirs, defaults.code_dirs)
    cfg.kain_dirs = config_compact_or_default(cfg.kain_dirs, defaults.kain_dirs)
    cfg.code_extensions = config_extensions_or_default(cfg.code_extensions, defaults.code_extensions)
    cfg.kain_extensions = config_extensions_or_default(cfg.kain_extensions, defaults.kain_extensions)
    if cfg.index_dir == "":
        cfg.index_dir = defaults.index_dir
    if cfg.repo_root == "":
        cfg.repo_root = defaults.repo_root
    return cfg

fn config_array_is_missing_or_boolish(values: Array<String>) -> Bool:
    if len(values) == 0:
        return true
    if len(values) == 1 and (values[0] == "true" or values[0] == "false"):
        return true
    return false

fn config_compact_or_default(values: Array<String>, fallback: Array<String>) -> Array<String>:
    let mut compact: Array<String> = []
    var i: Int = 0
    while i < len(values):
        let item = text_trim_string(values[i])
        if item != "" and item != "true" and item != "false":
            push(compact, item)
        i = i + 1
    if len(compact) == 0:
        return fallback
    return compact

fn config_extensions_or_default(values: Array<String>, fallback: Array<String>) -> Array<String>:
    let mut compact: Array<String> = []
    var i: Int = 0
    while i < len(values):
        let item = text_trim_string(values[i])
        if config_looks_like_extension(item):
            push(compact, item)
        i = i + 1
    if len(compact) == 0:
        return fallback
    return compact

fn config_looks_like_extension(value: String) -> Bool:
    if value == "":
        return false
    var i: Int = 0
    while i < len(value):
        let ch = char_at(value, i)
        let is_alpha = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z")
        let is_digit = ch >= "0" and ch <= "9"
        if is_alpha == false and is_digit == false and ch != "_" and ch != "-":
            return false
        i = i + 1
    return true

fn resolve_config_paths(cfg: SemanticSearchConfig, config_path: String) -> SemanticSearchConfig:
    let config_dir = fs_path_parent(config_path)
    if config_dir == "":
        return cfg
    if config_path_is_absolute(cfg.repo_root) == false:
        cfg.repo_root = fs_path_join(config_dir, cfg.repo_root)
    if config_path_is_absolute(cfg.index_dir) == false:
        cfg.index_dir = fs_path_join(config_dir, cfg.index_dir)
    return cfg

fn config_path_is_absolute(path: String) -> Bool:
    if len(path) >= 2 and char_at(path, 1) == ":":
        return true
    if text_starts_with_string(path, "\\\\"):
        return true
    if text_starts_with_string(path, "/"):
        return true
    return false



