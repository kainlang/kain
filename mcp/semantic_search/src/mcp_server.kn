// ============================================================================
//                    semantic-search :: MCP server
// ============================================================================
// HTTP server exposing the semantic_search MCP tool.

use std::net
use std::fs
use std::text
use types::SearchResult
use types::SearchResponse
use config::SemanticSearchConfig
use search_engine::search
use utils::int_to_str
use utils::float_to_str

pub fn start_server(cfg: SemanticSearchConfig) -> Int:
    let host = cfg.server_host
    let port = cfg.server_port

    println("starting MCP semantic search server...")
    println("  host: " + host + ":" + int_to_str(port))
    println("  endpoints:")
    println("    POST /tools/semantic_search")
    println("    GET  /health")

    let server_id = http_server_create(host, port)
    if server_id < 0:
        println("ERROR: failed to create HTTP server (code " + int_to_str(server_id) + ")")
        return 1

    let listen_status = http_server_listen(server_id)
    if listen_status != 0:
        println("ERROR: failed to listen (code " + int_to_str(listen_status) + ")")
        return 1

    println("  server started, listening on " + host + ":" + int_to_str(port))

    var running: Bool = true
    while running:
        let pumped = http_server_pump(server_id, 100)
        if pumped < 0:
            println("WARN: server pump returned " + int_to_str(pumped))

        let pending = http_server_pending_request_count(server_id)
        var processed: Int = 0
        while processed < pending and processed < 100:
            let req_id = http_server_next_request(server_id)
            if req_id < 0:
                break
            handle_request(req_id, cfg)
            processed = processed + 1

    http_server_close(server_id)
    return 0

// ---- routing ---------------------------------------------------------------

fn handle_request(req_id: Int, cfg: SemanticSearchConfig) -> Unit:
    let method = http_request_method(req_id)
    let path = http_request_path(req_id)

    if method == "GET" and path == "/health":
        let response = "{ \"status\": \"ok\", \"service\": \"semantic-search-mcp\" }"
        http_respond_text(req_id, 200, response)
    else:
        if method == "POST" and (path == "/tools/semantic_search" or path == "/semantic_search"):
            let body = http_request_body_text(req_id)
            if body == "":
                let err = "{ \"error\": \"empty request body\" }"
                http_respond_text(req_id, 400, err)
            else:
                let query = json_field(body, "query")
                if query == "":
                    let err = "{ \"error\": \"missing 'query' field\" }"
                    http_respond_text(req_id, 400, err)
                else:
                    let index_name = json_field_or(body, "index", "kain")
                    let top_k_str = json_field_or(body, "top_k", "10")
                    let top_k = to_int(top_k_str)
                    if top_k <= 0:
                        top_k = cfg.default_top_k
                    if top_k > cfg.max_top_k:
                        top_k = cfg.max_top_k

                    let resp = search(query, index_name, top_k, cfg)
                    let json = response_to_json(resp)
                    http_respond_text(req_id, 200, json)
        else:
            let body = "{ \"error\": \"not found\", \"method\": \"" + method + "\", \"path\": \"" + path + "\" }"
            http_respond_text(req_id, 404, body)

// ---- minimal JSON parser ---------------------------------------------------

fn json_field(json_text: String, key: String) -> String:
    let search_key = "\"" + key + "\""
    let key_pos = text_find(text_slice(json_text, 0, len(json_text)), search_key)
    if key_pos < 0:
        return ""
    var cursor = key_pos + len(search_key)
    while cursor < len(json_text) and (char_at(json_text, cursor) == " " or char_at(json_text, cursor) == ":" or char_at(json_text, cursor) == "\t"):
        cursor = cursor + 1
    if cursor >= len(json_text):
        return ""
    let ch = char_at(json_text, cursor)
    if ch == "\"":
        let start = cursor + 1
        var end = start
        while end < len(json_text) and char_at(json_text, end) != "\"":
            if char_at(json_text, end) == "\\":
                end = end + 2
            else:
                end = end + 1
        return substring(json_text, start, end)
    var num_end = cursor
    while num_end < len(json_text):
        let nc = char_at(json_text, num_end)
        if (nc >= "0" and nc <= "9") or nc == "." or nc == "-":
            num_end = num_end + 1
        else:
            break
    return substring(json_text, cursor, num_end)

fn json_field_or(json_text: String, key: String, fallback: String) -> String:
    let val = json_field(json_text, key)
    if val == "":
        return fallback
    return val

fn json_escape(s: String) -> String:
    var result = ""
    var i: Int = 0
    while i < len(s):
        let ch = substring(s, i, i + 1)
        if ch == "\"":
            result = result + "\\\""
        else:
            if ch == "\\":
                result = result + "\\\\"
            else:
                if ch == "\n":
                    result = result + "\\n"
                else:
                    result = result + ch
        i = i + 1
    return result

// ---- response serialization ------------------------------------------------

fn response_to_json(resp: SearchResponse) -> String:
    var json = "{"
    json = json + "\"results\": ["
    var i: Int = 0
    while i < len(resp.results):
        if i > 0:
            json = json + ","
        let r = resp.results[i]
        json = json + "{"
        json = json + "\"file\": \"" + json_escape(r.file_path) + "\","
        json = json + "\"line_start\": " + int_to_str(r.line_start) + ","
        json = json + "\"line_end\": " + int_to_str(r.line_end) + ","
        json = json + "\"kind\": \"" + json_escape(r.kind) + "\","
        json = json + "\"symbol\": \"" + json_escape(r.symbol) + "\","
        json = json + "\"score\": " + float_to_str(r.score) + ","
        json = json + "\"snippet\": \"" + json_escape(r.snippet) + "\""
        json = json + "}"
        i = i + 1
    json = json + "],"
    json = json + "\"query_ms\": " + float_to_str(resp.query_ms) + ","
    json = json + "\"total_indexed\": " + int_to_str(resp.total_indexed) + ","
    json = json + "\"index_name\": \"" + json_escape(resp.index_name) + "\","
    json = json + "\"error\": \"" + json_escape(resp.error) + "\""
    json = json + "}"
    return json





