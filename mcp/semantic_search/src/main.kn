// ============================================================================
//                    semantic-search :: main entry point
// ============================================================================

use std::runtime
use std::fs
use std::process
use std::cuda
use config::SemanticSearchConfig
use config::load_config
use config::locate_config_path
use config::config_runtime_root
use indexer::build_index
use mcp_server::start_server
use mcp_server::search_response_to_json
use mcp_server::json_escape
use mcp_server::json_bool
use search_engine::search
use search_engine::cuda_search_shader_bundle_path
use search_engine::cuda_search_residency_path
use utils::int_to_str
use utils::float_to_str
use utils::bool_to_str

fn main() -> Int with Unsafe:
    let _boot = runtime_init()
    let internal_mode = env("KAIN_SEMANTIC_SEARCH_MODE")
    let mut command = command_from_internal_mode(internal_mode)
    let mut args: Array<String> = []
    if command == "":
        args = tool_args()
        if len(args) > 0:
            command = args[0]
    if command == "":
        command = "mcp"
    let cfg = load_tool_config()
    if command_is_silent(command) == false:
        print_intro(cfg)
    let mut result = 0
    if command == "index":
        result = handle_index(args, cfg)
    else:
        if command == "serve" or command == "mcp":
            result = handle_serve(cfg)
        else:
            if command == "search":
                result = handle_search_once(args, cfg)
            else:
                if command == "__mcp_search_json":
                    result = handle_search_json(args, cfg)
                else:
                    if command == "__mcp_health_json":
                        result = handle_health_json(cfg)
                    else:
                        if command == "__mcp_args_json":
                            result = handle_args_json(args)
                        else:
                            handle_help()
                            result = 0
    let _shutdown = runtime_shutdown()
    return result

fn tool_args() -> Array<String>:
    let exe_path = process_current_executable_path()
    let mut values: Array<String> = []
    let count = process_arg_count()
    var i: Int = 0
    while i < count:
        let value = process_arg(i)
        if value != "":
            if len(values) > 0 or arg_looks_like_bootstrap(value, exe_path) == false:
                push(values, value)
        i = i + 1
    return values

fn arg_looks_like_bootstrap(arg: String, exe_path: String) -> Bool:
    if arg == "":
        return false
    if exe_path != "" and (arg == exe_path or same_file_name(arg, exe_path)):
        return true
    let lower = to_lower(arg)
    if ends_with(lower, ".exe"):
        return true
    if ends_with(lower, ".kn"):
        return true
    return contains(arg, "\\") or contains(arg, "/")

fn same_file_name(left: String, right: String) -> Bool:
    return to_lower(fs_path_file_name(left)) == to_lower(fs_path_file_name(right))

fn load_tool_config() -> SemanticSearchConfig:
    let forced = env("KAIN_SEMANTIC_SEARCH_CONFIG")
    if forced != "":
        return load_config(forced)
    return load_config(locate_config_path())

fn command_from_internal_mode(mode: String) -> String:
    if mode == "search_json":
        return "__mcp_search_json"
    if mode == "health_json":
        return "__mcp_health_json"
    if mode == "index":
        return "index"
    return ""

fn command_is_silent(command: String) -> Bool:
    if command == "mcp" or command == "serve":
        return true
    if command == "__mcp_search_json" or command == "__mcp_health_json" or command == "__mcp_args_json":
        return true
    return false

fn print_intro(cfg: SemanticSearchConfig) -> Unit:
    println("=== semantic-search mcp ===")
    println("  config:      " + locate_config_path())
    println("  runtime dir: " + config_runtime_root())
    println("  index dir:   " + cfg.index_dir)
    println("  model:       " + cfg.model_name)
    println("  dim:         " + int_to_str(cfg.dim))
    println("  gpu enabled: " + bool_to_str(cfg.gpu_enabled))
    println("")

fn handle_index(args: Array<String>, cfg: SemanticSearchConfig) -> Int with Unsafe:
    let mut target = "all"
    let forced = env("KAIN_SEMANTIC_SEARCH_INDEX_NAME")
    if forced != "":
        target = forced
    else:
        if len(args) > 1:
            target = args[1]
    if target == "all" or target == "code":
        println("--- building code index ---")
        let ok_code = build_index("code", cfg)
        if ok_code == false:
            println("WARNING: code index build failed")
        println("")
    if target == "all" or target == "kain":
        println("--- building kain index ---")
        let ok_kain = build_index("kain", cfg)
        if ok_kain == false:
            println("WARNING: kain index build failed")
        println("")
    println("indexing complete")
    return 0

fn handle_serve(cfg: SemanticSearchConfig) -> Int with Unsafe:
    return start_server(cfg)

fn handle_search_once(args: Array<String>, cfg: SemanticSearchConfig) -> Int:
    if len(args) < 2:
        println("usage: search <index_name> <query> [top_k]")
        return 1
    let index_name = args[1]
    let mut query = ""
    if len(args) > 2:
        query = args[2]
    let mut top_k = cfg.default_top_k
    if len(args) > 3:
        top_k = to_int(args[3])
    if query == "":
        println("usage: search <index_name> <query> [top_k]")
        return 1
    let resp = search(query, index_name, top_k, cfg)
    if resp.error != "":
        println("ERROR: " + resp.error)
        return 1
    println("results for '" + query + "' (" + index_name + "):")
    println("  total indexed: " + int_to_str(resp.total_indexed))
    var i: Int = 0
    while i < len(resp.results):
        let r = resp.results[i]
        println("  " + int_to_str(i + 1) + ". [" + float_to_str(r.score) + "] " + r.file_path + ":" + int_to_str(r.line_start) + " " + r.kind + " " + r.symbol)
        i = i + 1
    return 0

fn handle_help() -> Int:
    println("semantic-search — GPU semantic search MCP tool")
    println("")
    println("commands:")
    println("  mcp                      Start the embedded FastMCP stdio server (default)")
    println("  serve                    Alias for mcp")
    println("  index [code|kain|all]    Build search indices")
    println("  search <index> <query>   Run a single search")
    println("")
    println("FastMCP tools:")
    println("  semantic_search")
    println("  semantic_search_reindex")
    println("  semantic_search_health")
    return 0

fn handle_search_json(args: Array<String>, cfg: SemanticSearchConfig) -> Int:
    let mut index_name = env("KAIN_SEMANTIC_SEARCH_INDEX")
    if index_name == "":
        index_name = "kain"
    if index_name == "kain" and len(args) > 1:
        index_name = args[1]
    let mut query = env("KAIN_SEMANTIC_SEARCH_QUERY")
    if query == "" and len(args) > 2:
        query = args[2]
    let mut top_k = cfg.default_top_k
    let env_top_k = env("KAIN_SEMANTIC_SEARCH_TOP_K")
    if env_top_k != "":
        top_k = to_int(env_top_k)
    else:
        if len(args) > 3:
            top_k = to_int(args[3])
    let resp = search(query, index_name, top_k, cfg)
    println(search_response_to_json(resp))
    return 0

fn handle_health_json(cfg: SemanticSearchConfig) -> Int:
    let code_path = index_path("code", cfg)
    let kain_path = index_path("kain", cfg)
    let exe_path = process_current_executable_path()
    let bundle_path = cuda_search_shader_bundle_path()
    let residency_path = cuda_search_residency_path()
    var json = "{"
    json = json + "\"status\": \"ok\","
    json = json + "\"service\": \"semantic-search\","
    json = json + "\"transport\": \"kain-fastmcp-embedded\","
    json = json + "\"config_path\": \"" + json_escape(locate_config_path()) + "\","
    json = json + "\"runtime_root\": \"" + json_escape(config_runtime_root()) + "\","
    json = json + "\"executable\": \"" + json_escape(exe_path) + "\","
    json = json + "\"repo_root\": \"" + json_escape(cfg.repo_root) + "\","
    json = json + "\"index_dir\": \"" + json_escape(cfg.index_dir) + "\","
    json = json + "\"gpu_enabled\": " + json_bool(cfg.gpu_enabled) + ","
    json = json + "\"cuda_driver_available\": " + json_bool(cuda_driver_available()) + ","
    json = json + "\"cuda_runtime_library_available\": " + json_bool(cuda_runtime_library_available()) + ","
    json = json + "\"code_index_present\": " + json_bool(fs_exists(code_path)) + ","
    json = json + "\"kain_index_present\": " + json_bool(fs_exists(kain_path)) + ","
    json = json + "\"cuda_bundle_present\": " + json_bool(bundle_path != "") + ","
    json = json + "\"cuda_residency_present\": " + json_bool(residency_path != "") + ","
    json = json + "\"cuda_bundle_path\": \"" + json_escape(bundle_path) + "\","
    json = json + "\"cuda_residency_path\": \"" + json_escape(residency_path) + "\""
    json = json + "}"
    println(json)
    return 0

fn handle_args_json(args: Array<String>) -> Int:
    let raw = raw_args()
    let exe = process_current_executable_path()
    var json = "{"
    json = json + "\"executable\": \"" + json_escape(exe) + "\","
    json = json + "\"raw_args\": " + string_array_to_json(raw) + ","
    json = json + "\"tool_args\": " + string_array_to_json(args)
    json = json + "}"
    println(json)
    return 0

fn index_path(index_name: String, cfg: SemanticSearchConfig) -> String:
    return fs_path_join(fs_path_join(cfg.index_dir, index_name), "index.kaindex")

fn string_array_to_json(values: Array<String>) -> String:
    var json = "["
    var i: Int = 0
    while i < len(values):
        if i > 0:
            json = json + ","
        json = json + "\"" + json_escape(values[i]) + "\""
        i = i + 1
    json = json + "]"
    return json

fn raw_args() -> Array<String>:
    let count = process_arg_count()
    let mut values: Array<String> = []
    var i: Int = 0
    while i < count:
        push(values, process_arg(i))
        i = i + 1
    return values


