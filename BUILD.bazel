load("@rules_python//python:defs.bzl", "py_test")
load("//tools/bazel:kain_public_targets.bzl", "declare_kain_public_targets")

package(default_visibility = ["//visibility:public"])

declare_kain_public_targets()

alias(
    name = "stdlib_map_check",
    actual = "//stdlib:stdlib_map_check",
)

alias(
    name = "native_core_runtime",
    actual = "//runtime:native_core_runtime",
)

alias(
    name = "native_runtime",
    actual = "//runtime:native_runtime",
)

test_suite(
    name = "native_runtime_tests",
    tests = [
        "//runtime:native_runtime_tests",
    ],
)

test_suite(
    name = "developer_smoke_tests",
    tests = [
        ":kain_bazel_sync_test",
        ":key_crate_tests",
    ],
)

test_suite(
    name = "workspace_diagnostic_tests",
    tests = [
        ":kain_bazel_sync_test",
        ":diagnostic_crate_tests",
        ":native_runtime_tests",
    ],
)

py_test(
    name = "kain_bazel_sync_test",
    srcs = [
        "scripts/python/kain_bazel_sync.py",
        "scripts/python/test_kain_bazel_sync.py",
    ],
    main = "scripts/python/test_kain_bazel_sync.py",
    python_version = "PY3",
)
