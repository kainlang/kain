use element_kernel::ElementBond

use element_kernel::ElementBondRole

use element_kernel::ElementContract

use element_kernel::ElementDiagnostic

use element_kernel::ElementFamily

use element_kernel::ElementNode

use element_kernel::ElementOwnershipMode

use element_kernel::ElementPhysicalProfile

use element_kernel::ElementSemanticKind

use element_kernel::ElementSemanticProjection

use element_kernel::ElementThreadMode

use element_kernel::append_diagnostics

use element_kernel::count_bonds_with_role

use element_kernel::push_error

use element_kernel::push_note

use element_kernel::validate_emits_single_value

use element_kernel::validate_exact_valency

use element_kernel::validate_local_storage

use element_kernel::validate_no_mutable_inputs

use element_kernel::validate_no_unfenced_shared_state

use element_kernel::validate_ownership_window

use element_kernel::validate_projection_matches_physical_profile

pub fn oxygen_physical_profile() -> ElementPhysicalProfile:
    return ElementPhysicalProfile { symbol: "O", display_name: "Oxygen", atomic_number: 8, period_number: 2, group_number: 16, standard_atomic_weight_milli: 15999, pauling_electronegativity_milli: 344, valence_electron_count: 6, typical_covalent_bond_count: 2, lone_pair_count: 2, common_oxidation_states: [-1, -2], default_molecular_form: "O2" }

pub fn oxygen_semantic_projection() -> ElementSemanticProjection:
    return ElementSemanticProjection { kind: ElementSemanticKind::OwnershipSink, exact_valency: 2, memory_width_bits: 16, hidden_context_slots: 0, minimum_moved_owners: 1, maximum_moved_owners: 2, minimum_borrow_visible_inputs: 0, maximum_surviving_borrows: 1, default_ownership: ElementOwnershipMode::Move, thread_mode: ElementThreadMode::ShareableReadOnly, family: ElementFamily::Chalcogen, semantic_shape: "binary oxidation gate", lowering_hint: "lower as a two-input reducer that consumes at least one owner and returns one stabilized result", requires_single_emitted_value: true, rejects_mutable_inputs: true, rejects_shared_state: true }

pub fn oxygen_contract() -> ElementContract:
    return ElementContract { symbol: "O", display_name: "Oxygen", physical_profile: oxygen_physical_profile(), semantic_projection: oxygen_semantic_projection() }

pub fn oxygen_contract_audit() -> Array<ElementDiagnostic>:
    return validate_projection_matches_physical_profile(oxygen_contract())

pub fn oxygen_default_node(debug_name: String) -> ElementNode:
    return ElementNode { instruction_symbol: "O", debug_name: debug_name, bonds: [ElementBond { role: ElementBondRole::Input, label: "oxidizer_left", target_symbol: "?", owns_value: true, mutable_access: false }, ElementBond { role: ElementBondRole::Input, label: "oxidizer_right", target_symbol: "?", owns_value: false, mutable_access: false }], moved_input_count: 1, borrowed_input_count: 1, emitted_value_count: 1, local_storage_bits: 16, heap_allocated: false, touches_shared_state: false, requires_parallel_safety: false }

pub fn oxygen_execution_model() -> String:
    return "Oxygen is a two-operand ownership sink. Its two public bond sites become two input slots, while its strong electronegativity and common negative oxidation posture justify consuming at least one owner and collapsing the pair into one stabilized result."

pub fn oxygen_lowering_story() -> String:
    return "At lowering time O becomes a binary reducer or comparator. The node takes two child values, performs a chemistry-backed ownership pull, emits one result register, and allows at most one surviving borrow to remain visible after stabilization."

pub fn oxygen_projection_justification() -> Array<String>:
    return ["Oxygen is a group-16 element, so the profile records 6 valence electrons.", "Two typical covalent bonds justify O exposing exactly 2 public bond slots in the AST.", "Two remaining lone pairs explain why O is saturated after two public bonds without needing any hidden control slot.", "Pauling electronegativity 3.44 and common oxidation states -1/-2 justify O acting as an ownership sink rather than a passive borrow node.", "Standard atomic weight 15.999 maps O into the 16-bit memory tier in the current Element mass ladder."]

pub fn oxygen_validate(node: ElementNode) -> Array<ElementDiagnostic>:
    let contract = oxygen_contract()
    let diagnostics = []
    append_diagnostics(diagnostics, validate_projection_matches_physical_profile(contract))
    append_diagnostics(diagnostics, validate_exact_valency(contract, node))
    append_diagnostics(diagnostics, validate_emits_single_value(contract, node))
    append_diagnostics(diagnostics, validate_local_storage(contract, node))
    append_diagnostics(diagnostics, validate_no_mutable_inputs(contract, node))
    append_diagnostics(diagnostics, validate_no_unfenced_shared_state(contract, node))
    append_diagnostics(diagnostics, validate_ownership_window(contract, node))
    let input_bond_count = count_bonds_with_role(node, ElementBondRole::Input)
    if input_bond_count != 2:
        push_error(diagnostics, "oxygen-input-shape", node.debug_name + " must expose exactly two input bonds because oxygen models a two-bond covalent surface")
    if len(diagnostics) == 1:
        if diagnostics[0].code == "projection-audited":
            push_note(diagnostics, "oxygen-stable", node.debug_name + " satisfies oxygen: profile-audited chemistry, 2 bonds, at least one moved owner, one emitted result")
    return diagnostics

pub fn oxygen_semantic_rules() -> Array<String>:
    return ["O accepts exactly two bonded operands because oxygen typically contributes two public covalent bonds.", "O emits exactly one result value because the semantic projection is an ownership sink, not a fan-out node.", "O consumes at least one input owner because its high electronegativity maps to a hard ownership pull.", "O may preserve at most one surviving borrow because a two-bond ownership sink cannot leave both inputs alive as free aliases.", "O rejects mutable shared-state behavior and acts as a pure reduction gate."]
