use element_kernel::ElementBond

use element_kernel::ElementBondRole

use element_kernel::ElementContract

use element_kernel::ElementDiagnostic

use element_kernel::ElementFamily

use element_kernel::ElementNode

use element_kernel::ElementOwnershipMode

use element_kernel::ElementPhysicalProfile

use element_kernel::ElementSemanticKind

use element_kernel::ElementSemanticProjection

use element_kernel::ElementThreadMode

use element_kernel::append_diagnostics

use element_kernel::count_bonds_with_role

use element_kernel::push_error

use element_kernel::push_note

use element_kernel::validate_emits_single_value

use element_kernel::validate_exact_valency

use element_kernel::validate_local_storage

use element_kernel::validate_no_mutable_inputs

use element_kernel::validate_no_unfenced_shared_state

use element_kernel::validate_ownership_window

use element_kernel::validate_projection_matches_physical_profile

pub fn nitrogen_physical_profile() -> ElementPhysicalProfile:
    return ElementPhysicalProfile { symbol: "N", display_name: "Nitrogen", atomic_number: 7, period_number: 2, group_number: 15, standard_atomic_weight_milli: 14007, pauling_electronegativity_milli: 304, valence_electron_count: 5, typical_covalent_bond_count: 3, lone_pair_count: 1, common_oxidation_states: [5, 4, 3, 2, -3], default_molecular_form: "N2" }

pub fn nitrogen_semantic_projection() -> ElementSemanticProjection:
    return ElementSemanticProjection { kind: ElementSemanticKind::BranchCoordinator, exact_valency: 3, memory_width_bits: 16, hidden_context_slots: 1, minimum_moved_owners: 0, maximum_moved_owners: 1, minimum_borrow_visible_inputs: 2, maximum_surviving_borrows: 3, default_ownership: ElementOwnershipMode::AffineBorrow, thread_mode: ElementThreadMode::DefaultSingleOwner, family: ElementFamily::Pnictogen, semantic_shape: "triadic branch coordinator", lowering_hint: "lower as condition + true-lane + false-lane, with a hidden lone-pair scratch slot for decision context", requires_single_emitted_value: true, rejects_mutable_inputs: true, rejects_shared_state: false }

pub fn nitrogen_contract() -> ElementContract:
    return ElementContract { symbol: "N", display_name: "Nitrogen", physical_profile: nitrogen_physical_profile(), semantic_projection: nitrogen_semantic_projection() }

pub fn nitrogen_contract_audit() -> Array<ElementDiagnostic>:
    return validate_projection_matches_physical_profile(nitrogen_contract())

pub fn nitrogen_default_node(debug_name: String) -> ElementNode:
    return ElementNode { instruction_symbol: "N", debug_name: debug_name, bonds: [ElementBond { role: ElementBondRole::BranchCondition, label: "condition", target_symbol: "?", owns_value: false, mutable_access: false }, ElementBond { role: ElementBondRole::BranchTrue, label: "then_lane", target_symbol: "?", owns_value: false, mutable_access: false }, ElementBond { role: ElementBondRole::BranchFalse, label: "else_lane", target_symbol: "?", owns_value: false, mutable_access: false }], moved_input_count: 0, borrowed_input_count: 3, emitted_value_count: 1, local_storage_bits: 16, heap_allocated: false, touches_shared_state: false, requires_parallel_safety: false }

pub fn nitrogen_execution_model() -> String:
    return "Nitrogen is a triadic coordinator. Its three public bond sites become condition, true lane, and false lane, while its remaining lone pair becomes hidden control context that selects one stabilized branch result."

pub fn nitrogen_lone_pair_model() -> String:
    return "Nitrogen's lone pair becomes an implicit scratch slot for control context: cached predicate state, tag dispatch metadata, or branch selection bookkeeping that does not count as a public bond."

pub fn nitrogen_projection_justification() -> Array<String>:
    return ["Nitrogen is a group-15 element, so the profile records 5 valence electrons.", "Three typical covalent bonds justify N exposing exactly 3 public bond slots in the AST.", "One remaining lone pair justifies a single hidden control slot that is not visible as a fourth public bond.", "Nitrogen's oxidation range from -3 through +5 supports a multi-outcome coordination role instead of a one-way ownership sink.", "Standard atomic weight 14.007 maps N into the 16-bit memory tier in the current Element mass ladder."]

pub fn nitrogen_validate(node: ElementNode) -> Array<ElementDiagnostic>:
    let contract = nitrogen_contract()
    let diagnostics = []
    append_diagnostics(diagnostics, validate_projection_matches_physical_profile(contract))
    append_diagnostics(diagnostics, validate_exact_valency(contract, node))
    append_diagnostics(diagnostics, validate_emits_single_value(contract, node))
    append_diagnostics(diagnostics, validate_local_storage(contract, node))
    append_diagnostics(diagnostics, validate_no_mutable_inputs(contract, node))
    append_diagnostics(diagnostics, validate_no_unfenced_shared_state(contract, node))
    append_diagnostics(diagnostics, validate_ownership_window(contract, node))
    if count_bonds_with_role(node, ElementBondRole::BranchCondition) != 1:
        push_error(diagnostics, "nitrogen-missing-condition", node.debug_name + " must expose exactly one condition bond because nitrogen coordinates control rather than plain arithmetic")
    if count_bonds_with_role(node, ElementBondRole::BranchTrue) != 1:
        push_error(diagnostics, "nitrogen-missing-true-lane", node.debug_name + " must expose exactly one true-lane bond")
    if count_bonds_with_role(node, ElementBondRole::BranchFalse) != 1:
        push_error(diagnostics, "nitrogen-missing-false-lane", node.debug_name + " must expose exactly one false-lane bond")
    if node.touches_shared_state and !node.requires_parallel_safety:
        push_error(diagnostics, "nitrogen-unfenced-shared-state", node.debug_name + " touches shared state without an explicit synchronization boundary")
    if node.local_storage_bits < 4:
        push_note(diagnostics, "nitrogen-lone-pair-thin", node.debug_name + " leaves very little local room for nitrogen's hidden lone-pair control slot")
    if len(diagnostics) == 1:
        if diagnostics[0].code == "projection-audited":
            push_note(diagnostics, "nitrogen-stable", node.debug_name + " satisfies nitrogen: profile-audited chemistry, condition + true lane + false lane, one emitted result")
    return diagnostics

pub fn nitrogen_semantic_rules() -> Array<String>:
    return ["N accepts exactly three bonded operands because nitrogen typically contributes three public covalent bonds.", "N uses those bonds as condition, true lane, and false lane.", "N emits exactly one chosen result.", "N keeps at least two inputs borrow-visible and consumes at most one owner.", "N reserves its single lone pair as hidden branch-selection context."]
