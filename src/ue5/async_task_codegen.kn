use crate::async_task_ir::AsyncTaskCallbackIR

use crate::async_task_ir::AsyncTaskIR

use crate::async_task_ir::AsyncTaskThreadIR

@doc(doc = " Output from async task code generation")
@derive(Debug, Clone)
pub struct AsyncTaskCodegenOutput:
    task_header: String
    task_source: String
    queue_header: String
    queue_source: String
    includes: Array<String>

@doc(doc = " Generate async task code from IR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `ir` - The async task intermediate representation")
@doc(doc = " * `plugin_name` - Name of the plugin (for API macro)")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `AsyncTaskCodegenOutput` - Generated header and source files")
pub fn generate_async_task_code(ir: &AsyncTaskIR, plugin_name: String) -> AsyncTaskCodegenOutput:
    let task_class_name = f"F{(*ir).task_name}Task"
    let queue_class_name = f"U{(*ir).task_name}TaskQueue"
    let api_macro = f"{plugin_name.to_uppercase()}_API"
    let mut task_header = String__new_()
    let mut task_source = String__new_()
    let mut queue_header = String__new_()
    let mut queue_source = String__new_()
    generate_task_header(ir, &task_class_name, &api_macro, &mut task_header)
    ()
    generate_task_source(ir, &task_class_name, &mut task_source)
    ()
    generate_queue_header(ir, &queue_class_name, &task_class_name, &api_macro, &mut queue_header)
    ()
    generate_queue_source(ir, &queue_class_name, &task_class_name, &mut queue_source)
    ()
    AsyncTaskCodegenOutput { task_header: task_header, task_source: task_source, queue_header: queue_header, queue_source: queue_source, includes: [("CoreMinimal.h").to_string(), ("HAL/Runnable.h").to_string(), ("HAL/RunnableThread.h").to_string(), ("Async/AsyncWork.h").to_string(), ("UObject/NoExportTypes.h").to_string()] }

@doc(doc = " Generate task class header (FRunnable implementation)")
fn generate_task_header(ir: &AsyncTaskIR, task_class_name: String, api_macro: String, output: String):
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"HAL/Runnable.h\"\n")
    ()
    output.push_str("#include \"Async/AsyncWork.h\"\n\n")
    ()
    output.push_str(&f"class U{(*ir).task_name}TaskQueue;\n\n")
    ()
    output.push_str(&"/**\n")
    ()
    output.push_str(&f" * Async task for {(*ir).task_name} - runs on worker thread\n")
    ()
    output.push_str(&" * Implements FRunnable for thread pool execution\n")
    ()
    output.push_str(&" */\n")
    ()
    output.push_str(&f"class {api_macro} {task_class_name} : public FRunnable\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"    {task_class_name}(")
    ()
    let mut params = Vec__new_()
    for field in &(*ir).input_fields:
        params.push(f"const {field.cpp_type}& In{capitalize(&field.name)}")
        ()
    ()
    params.push(f"U{(*ir).task_name}TaskQueue* InQueue")
    ()
    output.push_str(&params.join(", "))
    ()
    output.push_str(");\n\n")
    ()
    output.push_str(&f"    virtual ~{task_class_name}();\n\n")
    ()
    output.push_str("    // FRunnable interface\n")
    ()
    output.push_str("    virtual bool Init() override;\n")
    ()
    output.push_str("    virtual uint32 Run() override;\n")
    ()
    output.push_str("    virtual void Stop() override;\n")
    ()
    output.push_str("    virtual void Exit() override;\n\n")
    ()
    output.push_str("    /** Cancel this task */\n")
    ()
    output.push_str("    void Cancel();\n\n")
    ()
    output.push_str("    /** Check if task is cancelled */\n")
    ()
    output.push_str("    bool IsCancelled() const { return bCancelled; }\n\n")
    ()
    output.push_str("    /** Get task priority */\n")
    ()
    output.push_str(&"    int32 GetPriority() const { return {(*ir).priority}; }\n\n")
    ()
    output.push_str("private:\n")
    ()
    if (!(*ir).input_fields.is_empty()):
        output.push_str("    // Input data\n")
        ()
        for field in &(*ir).input_fields:
            output.push_str(&f"    {field.cpp_type} {field.name};\n")
            ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    if (!(*ir).output_fields.is_empty()):
        output.push_str("    // Output data\n")
        ()
        for field in &(*ir).output_fields:
            output.push_str(&f"    {field.cpp_type} {field.name};\n")
            ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    output.push_str("    // Queue reference for callback\n")
    ()
    output.push_str(&f"    U{(*ir).task_name}TaskQueue* Queue;\n\n")
    ()
    output.push_str("    // Cancellation flag\n")
    ()
    output.push_str("    FThreadSafeBool bCancelled;\n\n")
    ()
    output.push_str("    /** Main work method - override this to implement task logic */\n")
    ()
    output.push_str("    void DoWork();\n")
    ()
    output.push_str("};\n")
    ()

@doc(doc = " Generate task class source")
fn generate_task_source(ir: &AsyncTaskIR, task_class_name: String, output: String):
    output.push_str(&f"#include \"{(*ir).task_name}.h\"\n")
    ()
    output.push_str(&f"#include \"{(*ir).task_name}TaskQueue.h\"\n\n")
    ()
    output.push_str(&f"{task_class_name}::{task_class_name}(")
    ()
    let mut params = Vec__new_()
    for field in &(*ir).input_fields:
        params.push(f"const {field.cpp_type}& In{capitalize(&field.name)}")
        ()
    ()
    params.push(f"U{(*ir).task_name}TaskQueue* InQueue")
    ()
    output.push_str(&params.join(", "))
    ()
    output.push_str(")\n")
    ()
    let mut initializers = Vec__new_()
    for field in &(*ir).input_fields:
        initializers.push(f"    {field.name}(In{capitalize(&field.name)})")
        ()
    ()
    initializers.push("    Queue(InQueue)")
    ()
    initializers.push(("    bCancelled(false)").to_string())
    ()
    if (!initializers.is_empty()):
        output.push_str("    : ")
        ()
        output.push_str(&initializers.join(",\n      "))
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    output.push_str("{\n")
    ()
    for field in &(*ir).output_fields:
        if field.is_array:
            output.push_str(&f"    {field.name}.Empty();\n")
            ()
        elif ((field.cpp_type == "int32") || (field.cpp_type == "int64")):
            output.push_str(&f"    {field.name} = 0;\n")
            ()
        elif ((field.cpp_type == "float") || (field.cpp_type == "double")):
            output.push_str(&f"    {field.name} = 0.0f;\n")
            ()
        elif (field.cpp_type == "bool"):
            output.push_str(&f"    {field.name} = false;\n")
            ()
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"{task_class_name}::~{task_class_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"bool {task_class_name}::Init()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    return true;\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"uint32 {task_class_name}::Run()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    if (!bCancelled)\n")
    ()
    output.push_str("    {\n")
    ()
    output.push_str("        DoWork();\n")
    ()
    output.push_str("    }\n")
    ()
    output.push_str("    return 0;\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {task_class_name}::Stop()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    bCancelled = true;\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {task_class_name}::Exit()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {task_class_name}::Cancel()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    bCancelled = true;\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {task_class_name}::DoWork()\n")
    ()
    output.push_str("{\n")
    ()
    match &(*ir).do_work_body:
        Some(body) =>
            output.push_str(&"    // User-defined work\n")
            ()
            output.push_str(&f"    {body}\n")
            ()
            ()
            ()
            ()
        _ =>
            output.push_str("    // TODO: Implement task logic\n")
            ()
            output.push_str("    // Process input fields and populate output fields\n")
            ()
            ()
            ()
            ()
    output.push_str("}\n")
    ()

@doc(doc = " Generate task queue class header (UObject)")
fn generate_queue_header(ir: &AsyncTaskIR, queue_class_name: String, task_class_name: String, api_macro: String, output: String):
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"UObject/NoExportTypes.h\"\n")
    ()
    output.push_str("#include \"HAL/RunnableThread.h\"\n")
    ()
    output.push_str(&f"#include \"{(*ir).task_name}.generated.h\"\n\n")
    ()
    output.push_str(&f"class {task_class_name};\n\n")
    ()
    output.push_str(&"/**\n")
    ()
    output.push_str(&f" * Task queue for {(*ir).task_name} - manages thread pool and task execution\n")
    ()
    output.push_str(&" */\n")
    ()
    output.push_str("UCLASS(BlueprintType)\n")
    ()
    output.push_str(&f"class {api_macro} {queue_class_name} : public UObject\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    GENERATED_BODY()\n\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"    {queue_class_name}();\n\n")
    ()
    output.push_str(&f"    virtual ~{queue_class_name}();\n\n")
    ()
    output.push_str("    /** Queue a new task for execution */\n")
    ()
    output.push_str("    UFUNCTION(BlueprintCallable, Category = \"Async Tasks\")\n")
    ()
    output.push_str("    void QueueTask(")
    ()
    let mut params = Vec__new_()
    for field in &(*ir).input_fields:
        params.push(f"const {field.cpp_type}& {field.name}")
        ()
    ()
    output.push_str(&params.join(", "))
    ()
    output.push_str(");\n\n")
    ()
    output.push_str("    /** Cancel all pending tasks */\n")
    ()
    output.push_str("    UFUNCTION(BlueprintCallable, Category = \"Async Tasks\")\n")
    ()
    output.push_str("    void CancelAllTasks();\n\n")
    ()
    output.push_str("    /** Get number of active tasks */\n")
    ()
    output.push_str("    UFUNCTION(BlueprintPure, Category = \"Async Tasks\")\n")
    ()
    output.push_str("    int32 GetActiveTaskCount() const;\n\n")
    ()
    match &(*ir).callback:
        Some(callback) =>
            generate_callback_declaration(ir, callback, output)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    output.push_str("private:\n")
    ()
    output.push_str("    // Active tasks\n")
    ()
    output.push_str(&f"    TArray<{task_class_name}*> ActiveTasks;\n\n")
    ()
    output.push_str("    // Thread pool\n")
    ()
    output.push_str("    TArray<FRunnableThread*> ThreadPool;\n\n")
    ()
    output.push_str("    // Thread pool size\n")
    ()
    output.push_str("    int32 ThreadPoolSize;\n\n")
    ()
    output.push_str("    /** Clean up completed tasks */\n")
    ()
    output.push_str("    void CleanupCompletedTasks();\n")
    ()
    output.push_str("};\n")
    ()

@doc(doc = " Generate callback declaration in queue header")
fn generate_callback_declaration(_ir: &AsyncTaskIR, callback: &AsyncTaskCallbackIR, output: String):
    output.push_str(&"    /** Callback when task completes */\n")
    ()
    if ((*callback).thread == AsyncTaskThreadIR__Main):
        output.push_str("    UFUNCTION(BlueprintNativeEvent, Category = \"Async Tasks\")\n")
        ()
        ()
        ()
        ()
    output.push_str(&f"    void {(*callback).name}(")
    ()
    let mut params = Vec__new_()
    for param in &(*callback).params:
        params.push(f"const {param.cpp_type}& {param.name}")
        ()
    ()
    output.push_str(&params.join(", "))
    ()
    output.push_str(");\n\n")
    ()

@doc(doc = " Generate task queue class source")
fn generate_queue_source(ir: &AsyncTaskIR, queue_class_name: String, task_class_name: String, output: String):
    output.push_str(&f"#include \"{(*ir).task_name}TaskQueue.h\"\n")
    ()
    output.push_str(&f"#include \"{(*ir).task_name}.h\"\n")
    ()
    output.push_str("#include \"Async/Async.h\"\n\n")
    ()
    output.push_str(&f"{queue_class_name}::{queue_class_name}()\n")
    ()
    output.push_str("    : ThreadPoolSize(4)\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"{queue_class_name}::~{queue_class_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    CancelAllTasks();\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {queue_class_name}::QueueTask(")
    ()
    let mut params = Vec__new_()
    for field in &(*ir).input_fields:
        params.push(f"const {field.cpp_type}& {field.name}")
        ()
    ()
    output.push_str(&params.join(", "))
    ()
    output.push_str(")\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    // Clean up completed tasks first\n")
    ()
    output.push_str("    CleanupCompletedTasks();\n\n")
    ()
    output.push_str("    // Create new task\n")
    ()
    output.push_str(&f"    {task_class_name}* Task = new {task_class_name}(")
    ()
    let mut args = Vec__new_()
    for field in &(*ir).input_fields:
        args.push(field.name.clone())
        ()
    ()
    args.push(("this").to_string())
    ()
    output.push_str(&args.join(", "))
    ()
    output.push_str(");\n\n")
    ()
    output.push_str("    // Add to active tasks\n")
    ()
    output.push_str("    ActiveTasks.Add(Task);\n\n")
    ()
    output.push_str("    // Create thread and start execution\n")
    ()
    output.push_str(&f"    FRunnableThread* Thread = FRunnableThread::Create(Task, TEXT(\"{(*ir).task_name}Task\"));\n")
    ()
    output.push_str("    ThreadPool.Add(Thread);\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {queue_class_name}::CancelAllTasks()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    // Cancel all active tasks\n")
    ()
    output.push_str("    for (auto* Task : ActiveTasks)\n")
    ()
    output.push_str("    {\n")
    ()
    output.push_str("        if (Task)\n")
    ()
    output.push_str("        {\n")
    ()
    output.push_str("            Task->Cancel();\n")
    ()
    output.push_str("        }\n")
    ()
    output.push_str("    }\n\n")
    ()
    output.push_str("    // Wait for threads to complete\n")
    ()
    output.push_str("    for (auto* Thread : ThreadPool)\n")
    ()
    output.push_str("    {\n")
    ()
    output.push_str("        if (Thread)\n")
    ()
    output.push_str("        {\n")
    ()
    output.push_str("            Thread->WaitForCompletion();\n")
    ()
    output.push_str("            delete Thread;\n")
    ()
    output.push_str("        }\n")
    ()
    output.push_str("    }\n\n")
    ()
    output.push_str("    // Clean up tasks\n")
    ()
    output.push_str("    for (auto* Task : ActiveTasks)\n")
    ()
    output.push_str("    {\n")
    ()
    output.push_str("        delete Task;\n")
    ()
    output.push_str("    }\n\n")
    ()
    output.push_str("    ActiveTasks.Empty();\n")
    ()
    output.push_str("    ThreadPool.Empty();\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"int32 {queue_class_name}::GetActiveTaskCount() const\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    return ActiveTasks.Num();\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {queue_class_name}::CleanupCompletedTasks()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    // Remove completed threads\n")
    ()
    output.push_str("    for (int32 i = ThreadPool.Num() - 1; i >= 0; --i)\n")
    ()
    output.push_str("    {\n")
    ()
    output.push_str("        if (ThreadPool[i] && ThreadPool[i]->Kill(true))\n")
    ()
    output.push_str("        {\n")
    ()
    output.push_str("            delete ThreadPool[i];\n")
    ()
    output.push_str("            ThreadPool.RemoveAt(i);\n")
    ()
    output.push_str("        }\n")
    ()
    output.push_str("    }\n")
    ()
    output.push_str("}\n\n")
    ()
    match &(*ir).callback:
        Some(callback) =>
            generate_callback_implementation(ir, callback, queue_class_name, output)
            ()
        _ => ()

@doc(doc = " Generate callback implementation in queue source")
fn generate_callback_implementation(_ir: &AsyncTaskIR, callback: &AsyncTaskCallbackIR, queue_class_name: String, output: String):
    output.push_str(&f"void {queue_class_name}::{(*callback).name}(")
    ()
    let mut params = Vec__new_()
    for param in &(*callback).params:
        params.push(f"const {param.cpp_type}& {param.name}")
        ()
    ()
    output.push_str(&params.join(", "))
    ()
    output.push_str(")\n")
    ()
    output.push_str("{\n")
    ()
    if ((*callback).thread == AsyncTaskThreadIR__Main):
        output.push_str("    // Execute on main thread\n")
        ()
        output.push_str(&f"    {(*callback).body}\n")
        ()
        ()
        ()
        ()
    else:
        output.push_str("    // Execute on worker thread\n")
        ()
        output.push_str(&f"    {(*callback).body}\n")
        ()
        ()
        ()
        ()
    output.push_str("}\n")
    ()

@doc(doc = " Capitalize first letter of a string")
fn capitalize(s: String) -> String:
    let mut chars = s.chars()
    match chars.next():
        None => String__new_()
        Some(first) => (first.to_uppercase().collect() + chars.as_str())

