use std::collections::HashMap

@doc(doc = " Mapping from KAIN stdlib function to UE5 implementation")
@derive(Debug, Clone)
pub struct StdLibMapping:
    kain_name: String
    ue5_template: String
    param_count: usize
    requires_include: Option<String>
    description: Option<String>

@doc(doc = " Resolves KAIN stdlib function calls to UE5 equivalents")
pub struct StdLibResolver:
    mappings: Map<String, StdLibMapping>

impl StdLibResolver:
    pub fn new_() -> StdLibResolver:
        let mut resolver = StdLibResolver { mappings: HashMap__new_() }
        resolver.add("abs", StdLibMapping { kain_name: ("abs").into(), ue5_template: ("FMath::Abs($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Absolute value").into()) })
        ()
        resolver.add("sqrt", StdLibMapping { kain_name: ("sqrt").into(), ue5_template: ("FMath::Sqrt($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Square root").into()) })
        ()
        resolver.add("pow", StdLibMapping { kain_name: ("pow").into(), ue5_template: ("FMath::Pow($0, $1)").into(), param_count: 2, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Power (base^exponent)").into()) })
        ()
        resolver.add("exp", StdLibMapping { kain_name: ("exp").into(), ue5_template: ("FMath::Exp($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Exponential (e^x)").into()) })
        ()
        resolver.add("log", StdLibMapping { kain_name: ("log").into(), ue5_template: ("FMath::Loge($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Natural logarithm").into()) })
        ()
        resolver.add("log2", StdLibMapping { kain_name: ("log2").into(), ue5_template: ("FMath::Log2($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Base-2 logarithm").into()) })
        ()
        resolver.add("sin", StdLibMapping { kain_name: ("sin").into(), ue5_template: ("FMath::Sin($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Sine (radians)").into()) })
        ()
        resolver.add("cos", StdLibMapping { kain_name: ("cos").into(), ue5_template: ("FMath::Cos($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Cosine (radians)").into()) })
        ()
        resolver.add("tan", StdLibMapping { kain_name: ("tan").into(), ue5_template: ("FMath::Tan($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Tangent (radians)").into()) })
        ()
        resolver.add("asin", StdLibMapping { kain_name: ("asin").into(), ue5_template: ("FMath::Asin($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Arc sine (returns radians)").into()) })
        ()
        resolver.add("acos", StdLibMapping { kain_name: ("acos").into(), ue5_template: ("FMath::Acos($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Arc cosine (returns radians)").into()) })
        ()
        resolver.add("atan", StdLibMapping { kain_name: ("atan").into(), ue5_template: ("FMath::Atan($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Arc tangent (returns radians)").into()) })
        ()
        resolver.add("atan2", StdLibMapping { kain_name: ("atan2").into(), ue5_template: ("FMath::Atan2($0, $1)").into(), param_count: 2, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Two-argument arc tangent (y, x)").into()) })
        ()
        resolver.add("floor", StdLibMapping { kain_name: ("floor").into(), ue5_template: ("FMath::FloorToFloat($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Round down to nearest integer").into()) })
        ()
        resolver.add("ceil", StdLibMapping { kain_name: ("ceil").into(), ue5_template: ("FMath::CeilToFloat($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Round up to nearest integer").into()) })
        ()
        resolver.add("round", StdLibMapping { kain_name: ("round").into(), ue5_template: ("FMath::RoundToFloat($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Round to nearest integer").into()) })
        ()
        resolver.add("fract", StdLibMapping { kain_name: ("fract").into(), ue5_template: ("FMath::Frac($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Fractional part (x - floor(x))").into()) })
        ()
        resolver.add("frac", StdLibMapping { kain_name: ("frac").into(), ue5_template: ("FMath::Frac($0)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Fractional part (alias for fract)").into()) })
        ()
        resolver.add("min", StdLibMapping { kain_name: ("min").into(), ue5_template: ("FMath::Min($0, $1)").into(), param_count: 2, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Minimum of two values").into()) })
        ()
        resolver.add("max", StdLibMapping { kain_name: ("max").into(), ue5_template: ("FMath::Max($0, $1)").into(), param_count: 2, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Maximum of two values").into()) })
        ()
        resolver.add("clamp", StdLibMapping { kain_name: ("clamp").into(), ue5_template: ("FMath::Clamp($0, $1, $2)").into(), param_count: 3, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Clamp value between min and max").into()) })
        ()
        resolver.add("lerp", StdLibMapping { kain_name: ("lerp").into(), ue5_template: ("FMath::Lerp($0, $1, $2)").into(), param_count: 3, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Linear interpolation (a, b, t)").into()) })
        ()
        resolver.add("mix", StdLibMapping { kain_name: ("mix").into(), ue5_template: ("FMath::Lerp($0, $1, $2)").into(), param_count: 3, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Linear interpolation (GLSL alias for lerp)").into()) })
        ()
        resolver.add("smoothstep", StdLibMapping { kain_name: ("smoothstep").into(), ue5_template: ("FMath::SmoothStep($0, $1, $2)").into(), param_count: 3, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Smooth Hermite interpolation (edge0, edge1, x)").into()) })
        ()
        resolver.add("saturate", StdLibMapping { kain_name: ("saturate").into(), ue5_template: ("FMath::Clamp($0, 0.0f, 1.0f)").into(), param_count: 1, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Clamp to [0, 1] range").into()) })
        ()
        resolver.add("random", StdLibMapping { kain_name: ("random").into(), ue5_template: ("FMath::FRand()").into(), param_count: 0, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Random float in [0, 1)").into()) })
        ()
        resolver.add("rand", StdLibMapping { kain_name: ("rand").into(), ue5_template: ("FMath::FRand()").into(), param_count: 0, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Random float in [0, 1) (alias)").into()) })
        ()
        resolver.add("random_range", StdLibMapping { kain_name: ("random_range").into(), ue5_template: ("FMath::FRandRange($0, $1)").into(), param_count: 2, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Random float in [min, max)").into()) })
        ()
        resolver.add("rand_range", StdLibMapping { kain_name: ("rand_range").into(), ue5_template: ("FMath::FRandRange($0, $1)").into(), param_count: 2, requires_include: Option::Some(("Math/UnrealMathUtility.h").into()), description: Option::Some(("Random float in [min, max) (alias)").into()) })
        ()
        resolver.add("len", StdLibMapping { kain_name: ("len").into(), ue5_template: ("$0.Num()").into(), param_count: 1, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Get array length").into()) })
        ()
        resolver.add("push", StdLibMapping { kain_name: ("push").into(), ue5_template: ("$0.Add($1)").into(), param_count: 2, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Push element to array").into()) })
        ()
        resolver.add("pop", StdLibMapping { kain_name: ("pop").into(), ue5_template: ("$0.Pop()").into(), param_count: 1, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Pop last element from array").into()) })
        ()
        resolver.add("first", StdLibMapping { kain_name: ("first").into(), ue5_template: ("$0[0]").into(), param_count: 1, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Get first element of array").into()) })
        ()
        resolver.add("last", StdLibMapping { kain_name: ("last").into(), ue5_template: ("$0[$0.Num() - 1]").into(), param_count: 1, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Get last element of array").into()) })
        ()
        resolver.add("reverse", StdLibMapping { kain_name: ("reverse").into(), ue5_template: ("Algo::Reverse($0)").into(), param_count: 1, requires_include: Option::Some(("Algo/Reverse.h").into()), description: Option::Some(("Reverse array in-place").into()) })
        ()
        resolver.add("contains", StdLibMapping { kain_name: ("contains").into(), ue5_template: ("$0.Contains($1)").into(), param_count: 2, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Check if array contains value").into()) })
        ()
        resolver.add("index_of", StdLibMapping { kain_name: ("index_of").into(), ue5_template: ("$0.Find($1)").into(), param_count: 2, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Find index of value in array").into()) })
        ()
        resolver.add("remove", StdLibMapping { kain_name: ("remove").into(), ue5_template: ("$0.RemoveAt($1)").into(), param_count: 2, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Remove element at index").into()) })
        ()
        resolver.add("clear", StdLibMapping { kain_name: ("clear").into(), ue5_template: ("$0.Empty()").into(), param_count: 1, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Clear all elements from array").into()) })
        ()
        resolver.add("is_empty", StdLibMapping { kain_name: ("is_empty").into(), ue5_template: ("$0.IsEmpty()").into(), param_count: 1, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Check if array is empty").into()) })
        ()
        resolver.add("reserve", StdLibMapping { kain_name: ("reserve").into(), ue5_template: ("$0.Reserve($1)").into(), param_count: 2, requires_include: Option::Some(("Containers/Array.h").into()), description: Option::Some(("Reserve capacity for array").into()) })
        ()
        resolver.add("trim", StdLibMapping { kain_name: ("trim").into(), ue5_template: ("$0.TrimStartAndEnd()").into(), param_count: 1, requires_include: none, description: Option::Some(("Trim whitespace from start and end of string").into()) })
        ()
        resolver.add("upper", StdLibMapping { kain_name: ("upper").into(), ue5_template: ("$0.ToUpper()").into(), param_count: 1, requires_include: none, description: Option::Some(("Convert string to uppercase").into()) })
        ()
        resolver.add("lower", StdLibMapping { kain_name: ("lower").into(), ue5_template: ("$0.ToLower()").into(), param_count: 1, requires_include: none, description: Option::Some(("Convert string to lowercase").into()) })
        ()
        resolver.add("str_contains", StdLibMapping { kain_name: ("str_contains").into(), ue5_template: ("$0.Contains($1)").into(), param_count: 2, requires_include: none, description: Option::Some(("Check if string contains substring").into()) })
        ()
        resolver.add("starts_with", StdLibMapping { kain_name: ("starts_with").into(), ue5_template: ("$0.StartsWith($1)").into(), param_count: 2, requires_include: none, description: Option::Some(("Check if string starts with prefix").into()) })
        ()
        resolver.add("ends_with", StdLibMapping { kain_name: ("ends_with").into(), ue5_template: ("$0.EndsWith($1)").into(), param_count: 2, requires_include: none, description: Option::Some(("Check if string ends with suffix").into()) })
        ()
        resolver.add("replace", StdLibMapping { kain_name: ("replace").into(), ue5_template: ("$0.Replace(*$1, *$2)").into(), param_count: 3, requires_include: none, description: Option::Some(("Replace all occurrences of substring").into()) })
        ()
        resolver.add("substring", StdLibMapping { kain_name: ("substring").into(), ue5_template: ("$0.Mid($1, $2)").into(), param_count: 3, requires_include: none, description: Option::Some(("Extract substring (start, length)").into()) })
        ()
        resolver.add("char_at", StdLibMapping { kain_name: ("char_at").into(), ue5_template: ("FString(1, &$0[$1])").into(), param_count: 2, requires_include: none, description: Option::Some(("Get character at index as string").into()) })
        ()
        resolver.add("to_int", StdLibMapping { kain_name: ("to_int").into(), ue5_template: ("FCString::Atoi(*$0)").into(), param_count: 1, requires_include: none, description: Option::Some(("Convert string to integer").into()) })
        ()
        resolver.add("to_float", StdLibMapping { kain_name: ("to_float").into(), ue5_template: ("FCString::Atof(*$0)").into(), param_count: 1, requires_include: none, description: Option::Some(("Convert string to float").into()) })
        ()
        resolver.add("str_is_empty", StdLibMapping { kain_name: ("str_is_empty").into(), ue5_template: ("$0.IsEmpty()").into(), param_count: 1, requires_include: none, description: Option::Some(("Check if string is empty").into()) })
        ()
        resolver.add("join", StdLibMapping { kain_name: ("join").into(), ue5_template: ("FString::Join($0, *$1)").into(), param_count: 2, requires_include: none, description: Option::Some(("Join array of strings with delimiter").into()) })
        ()
        resolver.add("str_len", StdLibMapping { kain_name: ("str_len").into(), ue5_template: ("$0.Len()").into(), param_count: 1, requires_include: none, description: Option::Some(("Get string length").into()) })
        ()
        resolver.add("split", StdLibMapping { kain_name: ("split").into(), ue5_template: ("[&](){ TArray<FString> Parts; $0.ParseIntoArray(Parts, *$1); return Parts; }()").into(), param_count: 2, requires_include: none, description: Option::Some(("Split string by delimiter into array").into()) })
        ()
        resolver

    pub fn add(_self: &mut StdLibResolver, name: String, mapping: StdLibMapping):
        (*_self).mappings.insert(name.to_string(), mapping)
        ()

    fn is_vector_expr(expr: String) -> Bool:
        (((((expr.starts_with("FVector(") || expr.starts_with("FVector2D(")) || expr.starts_with("FVector4(")) || expr.contains(".GetSafeNormal()")) || expr.contains("::CrossProduct")) || expr.contains("::DotProduct"))

    fn gen_vector_componentwise(fn_name: String, arg: String) -> Option<String>:
        let is_vec2 = arg.starts_with("FVector2D(")
        let is_vec4 = arg.starts_with("FVector4(")
        match fn_name:
            "floor" =>
                if is_vec2:
                    Option::Some(f"FVector2D(FMath::FloorToFloat(({arg}).X), FMath::FloorToFloat(({arg}).Y))")
                elif is_vec4:
                    Option::Some(f"FVector4(FMath::FloorToFloat(({arg}).X), FMath::FloorToFloat(({arg}).Y), FMath::FloorToFloat(({arg}).Z), FMath::FloorToFloat(({arg}).W))")
                else:
                    Option::Some(f"FVector(FMath::FloorToFloat(({arg}).X), FMath::FloorToFloat(({arg}).Y), FMath::FloorToFloat(({arg}).Z))")
            "frac" =>
                if is_vec2:
                    Option::Some(f"FVector2D(FMath::Frac(({arg}).X), FMath::Frac(({arg}).Y))")
                elif is_vec4:
                    Option::Some(f"FVector4(FMath::Frac(({arg}).X), FMath::Frac(({arg}).Y), FMath::Frac(({arg}).Z), FMath::Frac(({arg}).W))")
                else:
                    Option::Some(f"FVector(FMath::Frac(({arg}).X), FMath::Frac(({arg}).Y), FMath::Frac(({arg}).Z))")
            "fract" =>
                if is_vec2:
                    Option::Some(f"FVector2D(FMath::Frac(({arg}).X), FMath::Frac(({arg}).Y))")
                elif is_vec4:
                    Option::Some(f"FVector4(FMath::Frac(({arg}).X), FMath::Frac(({arg}).Y), FMath::Frac(({arg}).Z), FMath::Frac(({arg}).W))")
                else:
                    Option::Some(f"FVector(FMath::Frac(({arg}).X), FMath::Frac(({arg}).Y), FMath::Frac(({arg}).Z))")
            "abs" =>
                if is_vec2:
                    Option::Some(f"FVector2D(FMath::Abs(({arg}).X), FMath::Abs(({arg}).Y))")
                elif is_vec4:
                    Option::Some(f"FVector4(FMath::Abs(({arg}).X), FMath::Abs(({arg}).Y), FMath::Abs(({arg}).Z), FMath::Abs(({arg}).W))")
                else:
                    Option::Some(f"FVector(FMath::Abs(({arg}).X), FMath::Abs(({arg}).Y), FMath::Abs(({arg}).Z))")
            "ceil" =>
                if is_vec2:
                    Option::Some(f"FVector2D(FMath::CeilToFloat(({arg}).X), FMath::CeilToFloat(({arg}).Y))")
                elif is_vec4:
                    Option::Some(f"FVector4(FMath::CeilToFloat(({arg}).X), FMath::CeilToFloat(({arg}).Y), FMath::CeilToFloat(({arg}).Z), FMath::CeilToFloat(({arg}).W))")
                else:
                    Option::Some(f"FVector(FMath::CeilToFloat(({arg}).X), FMath::CeilToFloat(({arg}).Y), FMath::CeilToFloat(({arg}).Z))")
            "round" =>
                if is_vec2:
                    Option::Some(f"FVector2D(FMath::RoundToFloat(({arg}).X), FMath::RoundToFloat(({arg}).Y))")
                elif is_vec4:
                    Option::Some(f"FVector4(FMath::RoundToFloat(({arg}).X), FMath::RoundToFloat(({arg}).Y), FMath::RoundToFloat(({arg}).Z), FMath::RoundToFloat(({arg}).W))")
                else:
                    Option::Some(f"FVector(FMath::RoundToFloat(({arg}).X), FMath::RoundToFloat(({arg}).Y), FMath::RoundToFloat(({arg}).Z))")
            "sqrt" =>
                if is_vec2:
                    Option::Some(f"FVector2D(FMath::Sqrt(({arg}).X), FMath::Sqrt(({arg}).Y))")
                elif is_vec4:
                    Option::Some(f"FVector4(FMath::Sqrt(({arg}).X), FMath::Sqrt(({arg}).Y), FMath::Sqrt(({arg}).Z), FMath::Sqrt(({arg}).W))")
                else:
                    Option::Some(f"FVector(FMath::Sqrt(({arg}).X), FMath::Sqrt(({arg}).Y), FMath::Sqrt(({arg}).Z))")
            _ => none

    pub fn resolve(_self: &StdLibResolver, fn_name: String, args: &[String]) -> Result<String, String>:
        let mapping = (*_self).mappings.get(fn_name).ok_or_else(fn(): f"Unknown stdlib function: {fn_name}")?
        if (args.len() != mapping.param_count):
            return Result::Err(f"Function '{fn_name}' expects {mapping.param_count} arguments, got {args.len()}")
        if ((args.len() == 1) && StdLibResolver__is_vector_expr(&args[0])):
            match StdLibResolver__gen_vector_componentwise(fn_name, &args[0]):
                Some(vector_code) => return Result::Ok(vector_code)
                _ =>
                    ()
                    ()
            ()
        let mut result = mapping.ue5_template.clone()
        for selfhost_for_item in args.iter().enumerate():
            let (i, arg) = selfhost_for_item
            result = result.replace(&f"${i}", arg)
            ()
        ()
        Result::Ok(result)

    pub fn is_stdlib_function(_self: &StdLibResolver, fn_name: String) -> Bool:
        (*_self).mappings.contains_key(fn_name)

    pub fn get_required_include(_self: &StdLibResolver, fn_name: String) -> Option<String>:
        (*_self).mappings.get(fn_name).and_then(fn(m): m.requires_include)

    pub fn get_all_functions(_self: &StdLibResolver) -> Array<String>:
        (*_self).mappings.keys().map(fn(s): s.as_str()).collect()

    pub fn get_mapping(_self: &StdLibResolver, fn_name: String) -> Option<&StdLibMapping>:
        (*_self).mappings.get(fn_name)


impl Default for StdLibResolver:
    fn default_() -> StdLibResolver:
        StdLibResolver__new_()


