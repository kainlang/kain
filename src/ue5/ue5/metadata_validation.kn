use jsonschema::Draft

use jsonschema::JSONSchema

use serde_json::Value

use std::collections::HashMap

use std::path::Path

use std::path::PathBuf

pub type ValidationResult<T> = Result<T, ValidationError>

@doc(doc = " Structured error for metadata validation failures")
@derive(Debug, Clone)
pub struct ValidationError:
    file_path: std::path::PathBuf
    json_path: Option<String>
    message: String
    suggestion: Option<String>

@doc(doc = " Warning for incomplete metadata")
@derive(Debug, Clone)
pub struct ValidationWarning:
    file_path: std::path::PathBuf
    field_path: String
    message: String

@doc(doc = " Completeness check result")
@derive(Debug)
pub struct CompletenessReport:
    errors: Array<ValidationError>
    warnings: Array<ValidationWarning>
    missing_files: Array<std::path::PathBuf>

impl CompletenessReport:
    pub fn new_() -> CompletenessReport:
        CompletenessReport { errors: Vec__new_(), warnings: Vec__new_(), missing_files: Vec__new_() }

    pub fn has_errors(_self: &CompletenessReport) -> Bool:
        ((!(*_self).errors.is_empty()) || (!(*_self).missing_files.is_empty()))

    pub fn add_error(_self: &mut CompletenessReport, error: ValidationError):
        (*_self).errors.push(error)
        ()

    pub fn add_warning(_self: &mut CompletenessReport, warning: ValidationWarning):
        (*_self).warnings.push(warning)
        ()

    pub fn add_missing_file(_self: &mut CompletenessReport, path: std::path::PathBuf):
        (*_self).missing_files.push(path)
        ()


impl fmt::Display for ValidationError:
    fn fmt(_self: &ValidationError, f: &mut fmt::Formatter<_>) -> Result<(), Error>:
        __kain_write_fmt!(f, f"Metadata validation error in {(*_self).file_path.display()}: {(*_self).message}")?
        ()
        match &(*_self).json_path:
            Some(json_path) =>
                __kain_write_fmt!(f, f" at {json_path}")?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &(*_self).suggestion:
            Some(suggestion) =>
                __kain_write_fmt!(f, f"\n  Suggestion: {suggestion}")?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        Result::Ok(())


impl error::Error for ValidationError:
    fn __selfhost_empty_impl__():
        let __selfhost_empty = none

@doc(doc = " Metadata schema validator")
pub struct MetadataValidator:
    schemas: Map<String, jsonschema::JSONSchema>

impl MetadataValidator:
    pub fn new_() -> MetadataValidator:
        let mut validator = MetadataValidator { schemas: HashMap__new_() }
        validator.load_engine_knowledge_schema()
        ()
        validator.load_module_graph_schema()
        ()
        validator.load_uht_rules_schema()
        ()
        validator.load_shader_knowledge_schema()
        ()
        validator.load_widget_registry_schema()
        ()
        validator.load_editor_attributes_schema()
        ()
        validator.load_virtual_obligations_schema()
        ()
        validator.load_codegen_rules_schema()
        ()
        validator.load_version_config_schema()
        ()
        validator

    pub fn check_completeness(_self: &MetadataValidator, metadata_dir: &std::path::Path) -> CompletenessReport:
        let mut report = CompletenessReport__new_()
        let required_files = ["engine_knowledge.json", "module_graph.json", "uht_rules.json", "shader_knowledge.json", "widget_registry.json"]
        let optional_files = ["editor_attributes.json", "virtual_obligations.json", "codegen_rules.json", "engine_knowledge_expanded.json"]
        for filename in required_files:
            let file_path = metadata_dir.join(filename)
            if (!file_path.exists()):
                report.add_error(ValidationError { file_path: file_path.clone(), json_path: none, message: f"Required metadata file missing: {filename}", suggestion: Option::Some(f"Run metadata extraction scripts to generate {filename}") })
                ()
                report.add_missing_file(file_path)
                ()
            else:
                match std__fs__metadata(&file_path):
                    Ok(metadata) =>
                        if (metadata.len() == 0):
                            report.add_error(ValidationError { file_path: file_path.clone(), json_path: none, message: f"Required metadata file is empty: {filename}", suggestion: Option::Some(("Re-run metadata extraction scripts").to_string()) })
                            ()
                    _ => ()
        ()
        for filename in optional_files:
            let file_path = metadata_dir.join(filename)
            if (!file_path.exists()):
                report.add_warning(ValidationWarning { file_path: file_path.clone(), field_path: String__new_(), message: f"Optional metadata file missing: {filename}" })
                ()
        ()
        let engine_knowledge_path = metadata_dir.join("engine_knowledge.json")
        if engine_knowledge_path.exists():
            match std__fs__read_to_string(&engine_knowledge_path):
                Ok(content) =>
                    match serde_json__from_str(&content):
                        Ok(json) =>
                            (*_self).check_engine_knowledge_completeness(&engine_knowledge_path, &json, &mut report)
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            ()
        let module_graph_path = metadata_dir.join("module_graph.json")
        if module_graph_path.exists():
            match std__fs__read_to_string(&module_graph_path):
                Ok(content) =>
                    match serde_json__from_str(&content):
                        Ok(json) =>
                            (*_self).check_module_graph_completeness(&module_graph_path, &json, &mut report)
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            ()
        report

    fn check_engine_knowledge_completeness(_self: &MetadataValidator, file_path: &std::path::Path, json: &serde_json::Value, report: &mut CompletenessReport):
        if json.get("classes").is_none():
            report.add_warning(ValidationWarning { file_path: file_path.to_path_buf(), field_path: ("classes").to_string(), message: ("Missing 'classes' array in engine_knowledge.json").to_string() })
            ()
            ()
            ()
            ()
        if json.get("structs").is_none():
            report.add_warning(ValidationWarning { file_path: file_path.to_path_buf(), field_path: ("structs").to_string(), message: ("Missing 'structs' array in engine_knowledge.json").to_string() })
            ()
            ()
            ()
            ()
        if json.get("enums").is_none():
            report.add_warning(ValidationWarning { file_path: file_path.to_path_buf(), field_path: ("enums").to_string(), message: ("Missing 'enums' array in engine_knowledge.json").to_string() })
            ()
            ()
            ()
            ()
        let common_types = ["AActor", "UObject", "UActorComponent", "FVector", "FRotator", "FTransform"]
        match json.get("classes").and_then(fn(c): c.as_array()):
            Some(classes) =>
                for expected_type in common_types:
                    let found = classes.iter().any(fn(c): (c.get("name").and_then(fn(n): n.as_str()) == Option::Some(expected_type)))
                    if (!found):
                        report.add_warning(ValidationWarning { file_path: file_path.to_path_buf(), field_path: f"classes[{expected_type}]", message: f"Common UE5 type '{expected_type}' not found in engine_knowledge.json" })
                        ()
            _ => ()

    fn check_module_graph_completeness(_self: &MetadataValidator, file_path: &std::path::Path, json: &serde_json::Value, report: &mut CompletenessReport):
        if json.get("modules").is_none():
            report.add_warning(ValidationWarning { file_path: file_path.to_path_buf(), field_path: ("modules").to_string(), message: ("Missing 'modules' array in module_graph.json").to_string() })
            ()
            ()
            ()
            ()
        if json.get("include_to_module").is_none():
            report.add_warning(ValidationWarning { file_path: file_path.to_path_buf(), field_path: ("include_to_module").to_string(), message: ("Missing 'include_to_module' map in module_graph.json").to_string() })
            ()
            ()
            ()
            ()
        let common_modules = ["Core", "CoreUObject", "Engine", "Slate", "SlateCore"]
        match json.get("modules").and_then(fn(m): m.as_array()):
            Some(modules) =>
                for expected_module in common_modules:
                    let found = modules.iter().any(fn(m): (m.get("name").and_then(fn(n): n.as_str()) == Option::Some(expected_module)))
                    if (!found):
                        report.add_warning(ValidationWarning { file_path: file_path.to_path_buf(), field_path: f"modules[{expected_module}]", message: f"Common UE5 module '{expected_module}' not found in module_graph.json" })
                        ()
            _ => ()

    pub fn validate_file(_self: &MetadataValidator, file_path: &std::path::Path, content: String) -> ValidationResult<serde_json::Value>:
        let instance: serde_json::Value = serde_json__from_str(content).map_err(fn(e): ValidationError { file_path: file_path.to_path_buf(), json_path: none, message: f"Failed to parse JSON: {e}", suggestion: Option::Some(("Check JSON syntax for missing commas, brackets, or quotes").to_string()) })?
        let filename = file_path.file_name().and_then(fn(n): n.to_str()).ok_or_else(fn(): ValidationError { file_path: file_path.to_path_buf(), json_path: none, message: ("Invalid file path").to_string(), suggestion: none })?
        let schema_name = (*_self).get_schema_name(filename)
        let schema = (*_self).schemas.get(&schema_name).ok_or_else(fn(): ValidationError { file_path: file_path.to_path_buf(), json_path: none, message: f"No schema found for file type: {filename}", suggestion: Option::Some(("This metadata file type is not yet supported for validation").to_string()) })?
        match schema.validate(&instance):
            Err(errors) =>
                let error_messages: Array<String> = errors.map(fn(e): f"{e} at {e.instance_path}").collect()
                return Result::Err(ValidationError { file_path: file_path.to_path_buf(), json_path: Option::Some(error_messages.join("; ")), message: ("Schema validation failed").to_string(), suggestion: Option::Some(("Check the metadata file structure against the expected schema").to_string()) })
            _ =>
                ()
                ()
        Result::Ok(instance)

    fn get_schema_name(_self: &MetadataValidator, filename: String) -> String:
        if (filename.starts_with("engine_") && filename.ends_with("_scanned.json")):
            ("engine_knowledge").to_string()
        elif ((filename == "engine_knowledge.json") || (filename == "engine_knowledge_expanded.json")):
            ("engine_knowledge").to_string()
        elif (filename == "module_graph.json"):
            ("module_graph").to_string()
        elif (filename == "uht_rules.json"):
            ("uht_rules").to_string()
        elif (filename == "shader_knowledge.json"):
            ("shader_knowledge").to_string()
        elif (filename == "widget_registry.json"):
            ("widget_registry").to_string()
        elif (filename == "editor_attributes.json"):
            ("editor_attributes").to_string()
        elif (filename == "virtual_obligations.json"):
            ("virtual_obligations").to_string()
        elif (filename == "codegen_rules.json"):
            ("codegen_rules").to_string()
        elif (filename.ends_with(".json") && filename.chars().next().map_or(false, fn(c): c.is_numeric())):
            ("version_config").to_string()
        else:
            ("unknown").to_string()

    fn load_engine_knowledge_schema(_self: &mut MetadataValidator):
        let schema_json = serde_json::json!()
        match JSONSchema__options().with_draft(jsonschema__Draft__Draft7).compile_(&schema_json):
            Ok(schema) =>
                (*_self).schemas.insert(("engine_knowledge").to_string(), schema)
                ()
            _ => ()

