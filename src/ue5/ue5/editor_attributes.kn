use serde::Deserialize

use serde::Serialize

use std::collections::HashMap

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct NamingConvention:
    prefix: String
    suffix: String
    pattern: String
    viewport_prefix: String
    viewport_suffix: String
    client_prefix: String
    client_suffix: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct BoilerplateFlags:
    slate_begin_args: Bool
    slate_end_args: Bool
    construct_method: Bool
    customize_details_method: Bool
    detail_layout_builder: Bool
    init_editor_method: Bool
    toolkit_name_methods: Bool
    register_tab_spawners: Bool
    startup_module_method: Bool
    shutdown_module_method: Bool
    implement_module_macro: Bool

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct ExampleInfo:
    name: String
    header: String
    module: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct AttributeInfo:
    description: String
    base_class: String
    class_prefix: String
    class_suffix: String
    generates: String
    required_includes: Array<String>
    required_modules: Array<String>
    examples: Array<ExampleInfo>
    naming_convention: Option<NamingConvention>
    boilerplate: Option<BoilerplateFlags>
    requires_client: Bool
    client_base: String
    client_prefix: String
    client_suffix: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct MetaInfo:
    generator: String
    source: String
    total_attributes: usize
    description: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct EditorAttributesData:
    meta: MetaInfo
    attributes: Map<String, AttributeInfo>

@derive(Debug, Clone)
pub struct EditorAttributesRegistry:
    attributes: Map<String, AttributeInfo>
    meta: Option<MetaInfo>

impl Default for EditorAttributesRegistry:
    fn default_() -> EditorAttributesRegistry:
        EditorAttributesRegistry__new_()


impl EditorAttributesRegistry:
    pub fn new_() -> EditorAttributesRegistry:
        EditorAttributesRegistry { attributes: HashMap__new_(), meta: none }

    pub fn load(_self: &mut EditorAttributesRegistry, json_data: String) -> Result<(), String>:
        let data: EditorAttributesData = serde_json__from_str(json_data).map_err(fn(e): f"Failed to parse editor_attributes.json: {e}")?
        (*_self).attributes = data.attributes
        ()
        (*_self).meta = Option::Some(data.meta)
        ()
        Result::Ok(())

    pub fn is_editor_attribute(_self: &EditorAttributesRegistry, name: String) -> Bool:
        (*_self).attributes.contains_key(name)

    pub fn get_attribute(_self: &EditorAttributesRegistry, name: String) -> Option<&AttributeInfo>:
        (*_self).attributes.get(name)

    pub fn get_base_class(_self: &EditorAttributesRegistry, name: String) -> Option<String>:
        (*_self).attributes.get(name).map(fn(a): a.base_class.as_str())

    pub fn get_class_prefix(_self: &EditorAttributesRegistry, name: String) -> Option<String>:
        (*_self).attributes.get(name).map(fn(a): a.class_prefix.as_str()).filter(fn(s): (!s.is_empty()))

    pub fn get_class_suffix(_self: &EditorAttributesRegistry, name: String) -> Option<String>:
        (*_self).attributes.get(name).map(fn(a): a.class_suffix.as_str()).filter(fn(s): (!s.is_empty()))

    pub fn get_required_includes(_self: &EditorAttributesRegistry, name: String) -> Array<String>:
        (*_self).attributes.get(name).map(fn(a): a.required_includes.iter().map(fn(s): s.as_str()).collect()).unwrap_or_default()

    pub fn get_required_modules(_self: &EditorAttributesRegistry, name: String) -> Array<String>:
        (*_self).attributes.get(name).map(fn(a): a.required_modules.iter().map(fn(s): s.as_str()).collect()).unwrap_or_default()

    pub fn get_naming_convention(_self: &EditorAttributesRegistry, name: String) -> Option<&NamingConvention>:
        (*_self).attributes.get(name).and_then(fn(a): a.naming_convention)

    pub fn get_boilerplate(_self: &EditorAttributesRegistry, name: String) -> Option<&BoilerplateFlags>:
        (*_self).attributes.get(name).and_then(fn(a): a.boilerplate)

    pub fn requires_client(_self: &EditorAttributesRegistry, name: String) -> Bool:
        (*_self).attributes.get(name).map(fn(a): a.requires_client).unwrap_or(false)

    pub fn get_client_base(_self: &EditorAttributesRegistry, name: String) -> Option<String>:
        (*_self).attributes.get(name).map(fn(a): a.client_base.as_str()).filter(fn(s): (!s.is_empty()))

    pub fn attribute_names(_self: &EditorAttributesRegistry) -> Array<String>:
        (*_self).attributes.keys().map(fn(k): k.as_str()).collect()

    pub fn count(_self: &EditorAttributesRegistry) -> usize:
        (*_self).attributes.len()

    pub fn get_examples(_self: &EditorAttributesRegistry, name: String) -> Array<&ExampleInfo>:
        (*_self).attributes.get(name).map(fn(a): a.examples.iter().collect()).unwrap_or_default()

    pub fn get_description(_self: &EditorAttributesRegistry, name: String) -> Option<String>:
        (*_self).attributes.get(name).map(fn(a): a.description.as_str())

    pub fn get_generates(_self: &EditorAttributesRegistry, name: String) -> Option<String>:
        (*_self).attributes.get(name).map(fn(a): a.generates.as_str())


