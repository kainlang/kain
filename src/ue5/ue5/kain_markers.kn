use kain_core::ast::*

pub enum MarkerStyle:
    Block
    Inline
    None

@doc(doc = " Configuration for KAIN marker generation")
@derive(Debug, Clone)
pub struct MarkerConfig:
    style: MarkerStyle
    include_attributes: Bool
    include_types: Bool
    include_expressions: Bool

impl Default for MarkerConfig:
    fn default_() -> MarkerConfig:
        MarkerConfig { style: MarkerStyle__None, include_attributes: true, include_types: true, include_expressions: false }


impl MarkerConfig:
    pub fn enabled() -> MarkerConfig:
        MarkerConfig { style: MarkerStyle__Block, include_attributes: true, include_types: true, include_expressions: false }


@doc(doc = " Generate KAIN source marker for an actor")
pub fn actor_marker(actor_: &Actor, config: &MarkerConfig) -> String:
    if ((*config).style == MarkerStyle__None):
        return String__new_()
    f"// KAIN: actor {actor_.name}:"

@doc(doc = " Generate KAIN source marker for actor method end")
pub fn actor_end_marker(actor_: &Actor, config: &MarkerConfig) -> String:
    if ((*config).style == MarkerStyle__Block):
        f"// KAIN_END: actor {actor_.name}"
    else:
        String__new_()

@doc(doc = " Generate KAIN source marker for a message handler (RPC)")
pub fn message_handler_marker(handler: &MessageHandler, config: &MarkerConfig) -> String:
    if ((*config).style == MarkerStyle__None):
        return String__new_()
    f"// KAIN: on {(*handler).message_type}(...)"

@doc(doc = " Generate KAIN source marker for a struct")
pub fn struct_marker(struct_def: &Struct, config: &MarkerConfig) -> String:
    if ((*config).style == MarkerStyle__None):
        return String__new_()
    f"// KAIN: struct {(*struct_def).name}:"

@doc(doc = " Generate KAIN source marker for struct end")
pub fn struct_end_marker(struct_def: &Struct, config: &MarkerConfig) -> String:
    if ((*config).style == MarkerStyle__Block):
        f"// KAIN_END: struct {(*struct_def).name}"
    else:
        String__new_()

@doc(doc = " Generate KAIN source marker for an enum")
pub fn enum_marker(enum_def: &Enum, config: &MarkerConfig) -> String:
    if ((*config).style == MarkerStyle__None):
        return String__new_()
    f"// KAIN: enum {(*enum_def).name}:"

@doc(doc = " Generate KAIN source marker for a blueprint function")
pub fn blueprint_function_marker(func: &Function, config: &MarkerConfig) -> String:
    if ((*config).style == MarkerStyle__None):
        return String__new_()
    f"// KAIN: @blueprint fn {(*func).name}(...)"

@allow(dead_code)
fn format_type(_ty: &Type) -> String:
    ("Type").to_string()

@allow(dead_code)
fn format_expr(_expr: &Expr) -> String:
    ("...").to_string()

@allow(dead_code)
fn format_attr_args(_args: &[CallArg]) -> String:
    ("...").to_string()

