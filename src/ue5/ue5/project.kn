use std::collections::HashSet

@doc(doc = " Plugin descriptor (.uplugin file)")
@derive(Debug, Clone)
pub struct PluginDescriptor:
    name: String
    version: String
    description: String
    category: String
    created_by: String
    loading_phase: LoadingPhase
    modules: Array<ModuleDescriptor>

pub enum LoadingPhase:
    Default
    PostConfigInit
    PreDefault
    PostDefault
    PostEngineInit

impl LoadingPhase:
    pub fn as_str(_self: &LoadingPhase) -> String:
        match *_self:
            LoadingPhase::Default => "Default"
            LoadingPhase::PostConfigInit => "PostConfigInit"
            LoadingPhase::PreDefault => "PreDefault"
            LoadingPhase::PostDefault => "PostDefault"
            LoadingPhase::PostEngineInit => "PostEngineInit"


@derive(Debug, Clone)
pub struct ModuleDescriptor:
    name: String
    module_type: ModuleType
    loading_phase: LoadingPhase

pub enum ModuleType:
    Runtime
    RuntimeNoCommandlet
    Developer
    Editor
    EditorNoCommandlet
    Program

impl ModuleType:
    pub fn as_str(_self: &ModuleType) -> String:
        match *_self:
            ModuleType::Runtime => "Runtime"
            ModuleType::RuntimeNoCommandlet => "RuntimeNoCommandlet"
            ModuleType::Developer => "Developer"
            ModuleType::Editor => "Editor"
            ModuleType::EditorNoCommandlet => "EditorNoCommandlet"
            ModuleType::Program => "Program"


impl PluginDescriptor:
    pub fn to_json(_self: &PluginDescriptor) -> String:
        "{\n\t\"FileVersion\": 3,\n\t\"Version\": 1,\n\t\"VersionName\": \"{(*_self).version}\",\n\t\"FriendlyName\": \"{(*_self).name}\",\n\t\"Description\": \"{(*_self).description}\",\n\t\"Category\": \"{(*_self).category}\",\n\t\"CreatedBy\": \"{(*_self).created_by}\",\n\t\"CreatedByURL\": \"\",\n\t\"DocsURL\": \"\",\n\t\"MarketplaceURL\": \"\",\n\t\"SupportURL\": \"\",\n\t\"CanContainContent\": true,\n\t\"IsBetaVersion\": false,\n\t\"IsExperimentalVersion\": false,\n\t\"Installed\": false,\n\t\"Modules\": [\n\t\t{\n\t\t\t\"Name\": \"{(*_self).modules[0].name}\",\n\t\t\t\"Type\": \"{(*_self).modules[0].module_type.as_str()}\",\n\t\t\t\"LoadingPhase\": \"{(*_self).modules[0].loading_phase.as_str()}\"\n\t\t}\n\t]\n}"


@doc(doc = " Build.cs file generator with automatic dependency detection")
@derive(Debug, Clone)
pub struct BuildFile:
    module_name: String
    public_dependencies: Set<String>
    private_dependencies: Set<String>
    features_used: Set<String>

impl BuildFile:
    pub fn new_(module_name: impl Into<String>) -> BuildFile:
        let mut public_deps = HashSet__new_()
        public_deps.insert(("Core").to_string())
        ()
        public_deps.insert(("CoreUObject").to_string())
        ()
        public_deps.insert(("Engine").to_string())
        ()
        BuildFile { module_name: module_name.into(), public_dependencies: public_deps, private_dependencies: HashSet__new_(), features_used: HashSet__new_() }

    pub fn add_dependency_for_feature(_self: &mut BuildFile, feature: String) -> Bool:
        (*_self).features_used.insert(feature.to_string())
        ()
        match feature:
            "Slate" =>
                (*_self).public_dependencies.insert(("Slate").to_string())
                ()
                (*_self).public_dependencies.insert(("SlateCore").to_string())
                ()
                true
            "SlateWidget" =>
                (*_self).public_dependencies.insert(("Slate").to_string())
                ()
                (*_self).public_dependencies.insert(("SlateCore").to_string())
                ()
                true
            "UMG" =>
                (*_self).public_dependencies.insert(("UMG").to_string())
                ()
                true
            "Widget" =>
                (*_self).public_dependencies.insert(("UMG").to_string())
                ()
                true
            "EnhancedInput" =>
                (*_self).public_dependencies.insert(("EnhancedInput").to_string())
                ()
                true
            "Networking" =>
                (*_self).public_dependencies.insert(("OnlineSubsystem").to_string())
                ()
                true
            "Replication" =>
                (*_self).public_dependencies.insert(("OnlineSubsystem").to_string())
                ()
                true
            "Shader" =>
                (*_self).public_dependencies.insert(("RenderCore").to_string())
                ()
                (*_self).public_dependencies.insert(("Renderer").to_string())
                ()
                (*_self).public_dependencies.insert(("RHI").to_string())
                ()
                true
            "RenderCore" =>
                (*_self).public_dependencies.insert(("RenderCore").to_string())
                ()
                (*_self).public_dependencies.insert(("Renderer").to_string())
                ()
                (*_self).public_dependencies.insert(("RHI").to_string())
                ()
                true
            "Projects" =>
                (*_self).public_dependencies.insert(("Projects").to_string())
                ()
                true
            _ => false

    pub fn to_csharp(_self: &BuildFile) -> String:
        let public_deps: Array<_> = (*_self).public_dependencies.iter().collect()
        let private_deps: Array<_> = (*_self).private_dependencies.iter().collect()
        "using UnrealBuildTool;\n\npublic class {(*_self).module_name} : ModuleRules\n{\n\tpublic {(*_self).module_name}(ReadOnlyTargetRules Target) : base(Target)\n\t{\n\t\tPCHUsage = PCHUsageMode.UseExplicitOrSharedPCHs;\n\n\t\tPublicDependencyModuleNames.AddRange(new string[] {\n\t\t\t{public_deps.iter().map(fn(s): f\"\\\"{s}\\\"\").collect().join(\", \")}\n\t\t});\n\n\t\tPrivateDependencyModuleNames.AddRange(new string[] {\n\t\t\t{if private_deps.is_empty(): (\"\").to_string() else: private_deps.iter().map(fn(s): f\"\\\"{s}\\\"\").collect().join(\", \")}\n\t\t});\n\t}\n}"


