@doc(doc = " Validation context for tracking state during validation")
pub struct ValidationContext<a>:
    errors: Array<String>
    warnings: Array<String>
    span_mapper: &a kain_core::diagnostics::SpanMapper
    filename: String

impl<a> ValidationContext<a>:
    pub fn new_(span_mapper: &a kain_core::diagnostics::SpanMapper, filename: String) -> ValidationContext<a>:
        ValidationContext { errors: Vec__new_(), warnings: Vec__new_(), span_mapper: span_mapper, filename: filename }

    pub fn error(_self: &mut ValidationContext<a>, msg: String):
        (*_self).errors.push(msg)
        ()

    pub fn error_with_span(_self: &mut ValidationContext<a>, msg: String, span: kain_core::span::Span):
        let loc = (*_self).span_mapper.span_to_location(span, (*_self).filename)
        let formatted = f"{loc.file}:{loc.line_}:{loc.col}: {msg}"
        (*_self).errors.push(formatted)
        ()

    pub fn warning(_self: &mut ValidationContext<a>, msg: String):
        (*_self).warnings.push(msg)
        ()

    pub fn warning_with_span(_self: &mut ValidationContext<a>, msg: String, span: kain_core::span::Span):
        let loc = (*_self).span_mapper.span_to_location(span, (*_self).filename)
        let formatted = f"{loc.file}:{loc.line_}:{loc.col}: {msg}"
        (*_self).warnings.push(formatted)
        ()

    pub fn has_errors(_self: &ValidationContext<a>) -> Bool:
        (!(*_self).errors.is_empty())

    pub fn report(_self: &ValidationContext<a>) -> String:
        let mut report = String__new_()
        if (!(*_self).errors.is_empty()):
            report.push_str("❌ Unreal Semantic Validation Errors:\n")
            ()
            for selfhost_for_item in (*_self).errors.iter().enumerate():
                let (i, error) = selfhost_for_item
                report.push_str(&f"   {(i + 1)}. {error}\n")
                ()
            ()
            ()
        if (!(*_self).warnings.is_empty()):
            report.push_str("\n⚠\u{fe0f}  Warnings:\n")
            ()
            for selfhost_for_item in (*_self).warnings.iter().enumerate():
                let (i, warning) = selfhost_for_item
                report.push_str(&f"   {(i + 1)}. {warning}\n")
                ()
            ()
            ()
        report


@doc(doc = " Main validation entry point - runs BEFORE C++ codegen")
pub fn validate_program(program: &kain_core::types::TypedProgram, span_mapper: &kain_core::diagnostics::SpanMapper, filename: String) -> Result<(), KainError>:
    let kb = EngineKnowledge__new_()
    validate_program_with_knowledge(program, &kb, span_mapper, filename)

@doc(doc = " Validation with explicit EngineKnowledge (used when context already has one)")
pub fn validate_program_with_knowledge(program: &kain_core::types::TypedProgram, kb: &EngineKnowledge, span_mapper: &kain_core::diagnostics::SpanMapper, filename: String) -> Result<(), KainError>:
    let uht = UhtRules__new_()
    validate_program_full(program, kb, &uht, span_mapper, filename)

@doc(doc = " Full validation with EngineKnowledge + UHT rules (used when Ue5Context is available)")
pub fn validate_program_full(program: &kain_core::types::TypedProgram, kb: &EngineKnowledge, uht: &UhtRules, span_mapper: &kain_core::diagnostics::SpanMapper, filename: String) -> Result<(), KainError>:
    let custom_rules = ValidationRules__load("unreal/metadata/validation_rules.json").unwrap_or_else(fn(_): ValidationRules { version: ("1.0.0").to_string(), rules: Vec__new_() })
    validate_program_with_custom_rules(program, kb, uht, &custom_rules, span_mapper, filename)

@doc(doc = " Full validation with custom rules support")
pub fn validate_program_with_custom_rules(program: &kain_core::types::TypedProgram, kb: &EngineKnowledge, uht: &UhtRules, custom_rules: &ValidationRules, span_mapper: &kain_core::diagnostics::SpanMapper, filename: String) -> Result<(), KainError>:
    let mut ctx = ValidationContext__new_(span_mapper, filename)
    let conflicts = custom_rules.detect_conflicts()
    if (!conflicts.is_empty()):
        for selfhost_for_item in conflicts:
            let (rule1, rule2, reason) = selfhost_for_item
            ctx.error(f"Conflicting validation rules '{rule1}' and '{rule2}': {reason}")
            ()
        ()
        return Result::Err(KainError__runtime(ctx.report()))
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Function(func) => validate_function(&mut ctx, func)
            kain_core__types__TypedItem::Actor(actor_) => validate_actor(&mut ctx, actor_, kb)
            kain_core__types__TypedItem::Struct(struct_def) => validate_struct(&mut ctx, struct_def, kb)
            kain_core__types__TypedItem::Component(comp) => validate_component(&mut ctx, comp, kb)
            kain_core__types__TypedItem::Enum(en) => validate_enum(&mut ctx, en, kb)
            _ => ()
    ()
    if uht.is_loaded():
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Actor(actor_) => validate_actor_uht(&mut ctx, actor_, uht)
                kain_core__types__TypedItem::Struct(struct_def) => validate_struct_uht(&mut ctx, struct_def, uht)
                kain_core__types__TypedItem::Component(comp) => validate_component_uht(&mut ctx, comp, uht)
                _ => ()
        ()
        ()
    validate_replication(&mut ctx, program)
    ()
    validate_rpcs(&mut ctx, program)
    ()
    validate_datatables(&mut ctx, program, kb)
    ()
    validate_components_enhanced(&mut ctx, program)
    ()
    validate_name_collisions(&mut ctx, program, kb)
    ()
    validate_circular_dependencies(&mut ctx, program)
    ()
    enforce_custom_rules(&mut ctx, program, custom_rules, kb)
    ()
    if ctx.has_errors():
        return Result::Err(KainError__runtime(ctx.report()))
    Result::Ok(())

@doc(doc = " Validate function specifiers (UFUNCTION rules)")
fn validate_function(ctx: &mut ValidationContext, func: &kain_core::types::TypedFunction):
    let func_name = &(*func).ast.name
    let func_span = (*func).ast.span
    let mut flags = FunctionFlags__new_()
    if func_name.starts_with("Server_"):
        flags.net = true
        ()
        flags.net_server = true
        ()
        ()
        ()
        ()
    elif func_name.starts_with("Client_"):
        flags.net = true
        ()
        flags.net_client = true
        ()
        ()
        ()
        ()
    elif func_name.starts_with("Multicast_"):
        flags.net = true
        ()
        flags.net_multicast = true
        ()
        ()
        ()
        ()
    for attr in &(*func).ast.attributes:
        match attr.name.as_str():
            "blueprint" =>
                flags.blueprint_callable = true
                ()
            "blueprint_pure" =>
                flags.blueprint_callable = true
                ()
                flags.blueprint_pure = true
                ()
            "blueprint_event" =>
                flags.blueprint_event = true
                ()
            "blueprint_implementable_event" =>
                flags.blueprint_event = true
                ()
                flags.blueprint_implementable = true
                ()
            "blueprint_native_event" =>
                flags.blueprint_event = true
                ()
                flags.blueprint_native = true
                ()
            "blueprint_getter" =>
                flags.blueprint_getter = true
                ()
            "blueprint_setter" =>
                flags.blueprint_setter = true
                ()
            _ => ()
    ()
    let is_private = ((*func).ast.visibility == kain_core__ast__Visibility__Private)
    if (is_private && flags.blueprint_event):
        ctx.error_with_span(f"Function '{func_name}': A Private function cannot be a BlueprintImplementableEvent or BlueprintNativeEvent.", func_span)
        ()
        ()
        ()
        ()
    if (flags.blueprint_event && flags.blueprint_getter):
        ctx.error_with_span(f"Function '{func_name}': Function cannot be a blueprint event and a blueprint getter.", func_span)
        ()
        ()
        ()
        ()
    if (flags.blueprint_implementable && flags.net):
        ctx.error_with_span(f"Function '{func_name}': BlueprintImplementableEvent functions cannot be replicated (Server/Client/Multicast)", func_span)
        ()
        ()
        ()
        ()
    if (flags.blueprint_native && flags.net):
        ctx.error_with_span(f"Function '{func_name}': BlueprintNativeEvent functions cannot be replicated (Server/Client/Multicast)", func_span)
        ()
        ()
        ()
        ()
    if (flags.blueprint_implementable && flags.blueprint_native):
        ctx.error_with_span(f"Function '{func_name}': Cannot be both BlueprintImplementableEvent and BlueprintNativeEvent", func_span)
        ()
        ()
        ()
        ()
    if (flags.exec && flags.net):
        ctx.error_with_span(f"Function '{func_name}': Exec functions cannot be replicated", func_span)
        ()
        ()
        ()
        ()
    let is_rigvm = (*func).ast.attributes.iter().any(fn(a): (a.name == "rigvm_method"))
    if (is_rigvm && (!(*func).ast.params.is_empty())):
        ctx.error(f"Function '{func_name}': RIGVM_METHOD functions cannot have parameters in UE 5.2+. Use the struct state instead.")
        ()
        ()
        ()
        ()
    if flags.net:
        for param in &(*func).ast.params:
            if is_delegate_type(&param.ty):
                ctx.error(f"Function '{func_name}', parameter '{param.name}': Replicated functions (Server/Client/Multicast) cannot have delegate parameters. This is a security/stability restriction.")
                ()

@doc(doc = " Validate actor-specific rules")
fn validate_actor(ctx: &mut ValidationContext, actor_: &kain_core::types::TypedActor, kb: &EngineKnowledge):
    let actor_name = &actor_.ast.name
    let mut has_blueprint_implementable = false
    let mut has_blueprint_native = false
    for attr in &actor_.ast.attributes:
        match attr.name.as_str():
            "blueprint_implementable_event" => has_blueprint_implementable = true
            "blueprint_native_event" => has_blueprint_native = true
            _ => ()
    ()
    let engine_name = ue5__naming__to_actor_name(actor_name)
    if (engine_name.len() <= 1):
        ctx.error(f"Actor '{actor_name}': Resulting engine name '{engine_name}' is invalid. Ensure you haven't used an empty or numeric name.")
        ()
        ()
        ()
        ()
    if (has_blueprint_implementable && has_blueprint_native):
        ctx.error(f"Actor '{actor_name}': Cannot be both BlueprintImplementableEvent and BlueprintNativeEvent")
        ()
        ()
        ()
        ()
    for state_ in &actor_.ast.state_:
        validate_property(ctx, &state_.name, &actor_name, false, &state_.ty, &[], kb)
        ()
    ()
    for handler in &actor_.ast.handlers:
        let handler_name = &handler.message_type
        let is_server_rpc = handler_name.starts_with("Server_")
        let is_client_rpc = handler_name.starts_with("Client_")
        let is_multicast_rpc = handler_name.starts_with("Multicast_")
        let is_any_rpc = ((is_server_rpc || is_client_rpc) || is_multicast_rpc)
        if (has_blueprint_implementable && is_any_rpc):
            ctx.error(f"Actor '{actor_name}', handler '{handler_name}': BlueprintImplementableEvent functions cannot be replicated (Server/Client/Multicast)")
            ()
            ()
            ()
            ()
        if (has_blueprint_native && is_any_rpc):
            ctx.error(f"Actor '{actor_name}', handler '{handler_name}': BlueprintNativeEvent functions cannot be replicated (Server/Client/Multicast)")
            ()
    ()
    for method in &actor_.ast.methods:
        let mut method_has_blueprint_implementable = false
        let mut method_has_blueprint_native = false
        let mut method_has_exec = false
        for attr in &method.attributes:
            match attr.name.as_str():
                "blueprint_implementable_event" => method_has_blueprint_implementable = true
                "blueprint_native_event" => method_has_blueprint_native = true
                "exec" => method_has_exec = true
                _ => ()
        ()
        let is_server_rpc = method.name.starts_with("Server_")
        let is_client_rpc = method.name.starts_with("Client_")
        let is_multicast_rpc = method.name.starts_with("Multicast_")
        let is_any_rpc = ((is_server_rpc || is_client_rpc) || is_multicast_rpc)
        if (method_has_blueprint_implementable && is_any_rpc):
            ctx.error(f"Actor '{actor_name}', method '{method.name}': BlueprintImplementableEvent functions cannot be replicated (Server/Client/Multicast)")
            ()
            ()
            ()
            ()
        if (method_has_blueprint_native && is_any_rpc):
            ctx.error(f"Actor '{actor_name}', method '{method.name}': BlueprintNativeEvent functions cannot be replicated (Server/Client/Multicast)")
            ()
            ()
            ()
            ()
        if (method_has_blueprint_implementable && method_has_blueprint_native):
            ctx.error(f"Actor '{actor_name}', method '{method.name}': Cannot be both BlueprintImplementableEvent and BlueprintNativeEvent")
            ()
            ()
            ()
            ()
        if (method_has_exec && is_any_rpc):
            ctx.error(f"Actor '{actor_name}', method '{method.name}': Exec functions cannot be replicated")
            ()

@doc(doc = " Validate struct-specific rules")
fn validate_struct(ctx: &mut ValidationContext, struct_def: &kain_core::types::TypedStruct, kb: &EngineKnowledge):
    let struct_name = &(*struct_def).ast.name
    for field in &(*struct_def).ast.fields:
        validate_property(ctx, &field.name, &struct_name, true, &field.ty, &field.attributes, kb)
        ()
    ()
    let engine_name = naming__to_struct_name(struct_name)
    if (engine_name.len() <= 1):
        ctx.error(f"Struct '{struct_name}': Resulting engine name '{engine_name}' is too short or empty. Use a more descriptive name.")
        ()
        ()
        ()
        ()
    check_engine_name_collision(ctx, struct_name, "Struct", kb)
    ()

@doc(doc = " Validate enum-specific rules")
fn validate_enum(ctx: &mut ValidationContext, enum_def: &kain_core::types::TypedEnum, kb: &EngineKnowledge):
    let enum_name = &(*enum_def).ast.name
    for variant in &(*enum_def).ast.variants:
        let variant_lower = variant.name.to_lowercase()
        if ((variant_lower == "true") || (variant_lower == "false")):
            ctx.error(f"Enum '{enum_name}', variant '{variant.name}': Enumerations cannot have variants named 'true' or 'false' (case-insensitive). This is a UE5 restriction.")
            ()
    ()
    let has_max = (*enum_def).ast.variants.iter().any(fn(v): v.name.to_uppercase().ends_with("MAX"))
    if (!has_max):
        ctx.warning(f"Enum '{enum_name}': Missing a '_MAX' variant. Unreal Engine metadata systems (and Blueprints) often require a MAX entry for stability.")
        ()
        ()
        ()
        ()
    let engine_name = naming__to_enum_name(enum_name)
    if (engine_name.len() <= 1):
        ctx.error(f"Enum '{enum_name}': Resulting engine name '{engine_name}' is invalid.")
        ()
        ()
        ()
        ()
    check_engine_name_collision(ctx, enum_name, "Enum", kb)
    ()

fn validate_component(ctx: &mut ValidationContext, comp: &kain_core::types::TypedComponent, kb: &EngineKnowledge):
    let comp_name = &(*comp).ast.name
    let engine_name = naming__to_component_name(comp_name)
    if (engine_name.len() <= 1):
        ctx.error(f"Component '{comp_name}': Resulting engine name '{engine_name}' is invalid.")
        ()
        ()
        ()
        ()
    for state_ in &(*comp).ast.state_:
        validate_property(ctx, &state_.name, &comp_name, false, &state_.ty, &[], kb)
        ()

@doc(doc = " Validate property specifiers (UPROPERTY rules)")
fn validate_property(ctx: &mut ValidationContext, prop_name: String, owner_name: String, is_struct_member: Bool, ty: &kain_core::ast::Type, attributes: &[kain_core::ast::Attribute], _kb: &EngineKnowledge):
    let mut is_replicated = false
    let mut is_blueprint_read_only = false
    let mut is_blueprint_setter = false
    let mut has_uproperty = false
    for attr in attributes:
        match attr.name.as_str():
            "replicated" =>
                is_replicated = true
                ()
            "blueprint_read_only" =>
                is_blueprint_read_only = true
                ()
            "blueprint_setter" =>
                is_blueprint_setter = true
                ()
            "property" =>
                has_uproperty = true
                ()
            _ => ()
        if (none):
            has_uproperty = true
            ()
    ()
    if (is_struct_member && is_replicated):
        ctx.error(f"Property '{prop_name}' in Struct '{owner_name}': Struct members cannot be replicated.")
        ()
        ()
        ()
        ()
    if (is_blueprint_read_only && is_blueprint_setter):
        ctx.error(f"Property '{prop_name}' in '{owner_name}': Cannot specify a property as being both BlueprintReadOnly and having a BlueprintSetter.")
        ()

@doc(doc = " Function flags tracker (mirrors UE5's EFunctionFlags)")
struct FunctionFlags:
    net: Bool
    net_server: Bool
    net_client: Bool
    net_multicast: Bool
    blueprint_callable: Bool
    blueprint_pure: Bool
    blueprint_event: Bool
    blueprint_implementable: Bool
    blueprint_native: Bool
    blueprint_getter: Bool
    blueprint_setter: Bool
    exec: Bool

impl FunctionFlags:
    fn new_() -> FunctionFlags:
        FunctionFlags { net: false, net_server: false, net_client: false, net_multicast: false, blueprint_callable: false, blueprint_pure: false, blueprint_event: false, blueprint_implementable: false, blueprint_native: false, blueprint_getter: false, blueprint_setter: false, exec: false }


@doc(doc = " Validate actor state fields against UHT property type rules")
fn validate_actor_uht(ctx: &mut ValidationContext, actor_: &kain_core::types::TypedActor, uht: &UhtRules):
    for state_ in &actor_.ast.state_:
        validate_property_type_uht(ctx, &state_.name, &actor_.ast.name, &state_.ty, &[], false, uht)
        ()

@doc(doc = " Validate struct fields against UHT property type rules")
fn validate_struct_uht(ctx: &mut ValidationContext, struct_def: &kain_core::types::TypedStruct, uht: &UhtRules):
    for field in &(*struct_def).ast.fields:
        validate_property_type_uht(ctx, &field.name, &(*struct_def).ast.name, &field.ty, &field.attributes, true, uht)
        ()

@doc(doc = " Validate component state fields against UHT property type rules")
fn validate_component_uht(ctx: &mut ValidationContext, comp: &kain_core::types::TypedComponent, uht: &UhtRules):
    for state_ in &(*comp).ast.state_:
        validate_property_type_uht(ctx, &state_.name, &(*comp).ast.name, &state_.ty, &[], false, uht)
        ()

@doc(doc = " Data-driven property type validation using UHT rules")
fn validate_property_type_uht(ctx: &mut ValidationContext, prop_name: String, owner_name: String, ty: &kain_core::ast::Type, attributes: &[kain_core::ast::Attribute], is_struct_member: Bool, uht: &UhtRules):
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } =>
            let type_name = map_kain_container(name)
            if uht.is_container_type(&type_name):
                for param in generics:
                    match param:
                        kain_core__ast__Type::Named { name: inner_name } =>
                            let inner_type = map_kain_container(inner_name)
                            if uht.is_container_type(&inner_type):
                                ctx.error(f"Property '{prop_name}' in '{owner_name}': Nested containers are not supported by UHT. '{type_name}<..., {inner_type}<...>>' will fail UE5 compilation. Use a wrapper struct instead.")
                                ()
                        _ => ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    let mut seen_specifiers: Array<String> = Vec__new_()
    for attr in attributes:
        let spec_name = map_kain_attr_to_specifier(&attr.name)
        if (!spec_name.is_empty()):
            for prev in &seen_specifiers:
                match uht.are_incompatible(&spec_name, prev):
                    Some(msg) =>
                        ctx.error(f"Property '{prop_name}' in '{owner_name}': {msg} (UHT rule)")
                        ()
                    _ => ()
            ()
            seen_specifiers.push(spec_name)
            ()
    ()
    if is_struct_member:
        for attr in attributes:
            if (attr.name == "blueprint_setter"):
                ctx.error(f"Property '{prop_name}' in struct '{owner_name}': Cannot specify BlueprintSetter for a struct member. This is only valid on class (actor/component) members. (UHT rule)")
                ()
                ()
                ()
                ()
            if (attr.name == "blueprint_getter"):
                ctx.error(f"Property '{prop_name}' in struct '{owner_name}': Cannot specify BlueprintGetter for a struct member. This is only valid on class (actor/component) members. (UHT rule)")
                ()
        ()
        ()
    let is_blueprint_exposed = attributes.iter().any(fn(a): ((a.name == "blueprint_read_write") || (a.name == "blueprint_read_only")))
    let is_editor_only = attributes.iter().any(fn(a): (a.name == "editor_only"))
    if ((is_struct_member && is_blueprint_exposed) && is_editor_only):
        ctx.error(f"Property '{prop_name}' in struct '{owner_name}': Blueprint exposed struct members cannot be editor only. (UHT rule)")
        ()

@doc(doc = " Map KAIN container type names to UHT type names")
fn map_kain_container(name: String) -> String:
    match name:
        "Array" => ("Array").to_string()
        "TArray" => ("Array").to_string()
        "Map" => ("Map").to_string()
        "TMap" => ("Map").to_string()
        "Set" => ("Set").to_string()
        "TSet" => ("Set").to_string()
        "Optional" => ("Optional").to_string()
        "TOptional" => ("Optional").to_string()
        _ => name.to_string()

@doc(doc = " Map KAIN attribute names to UHT specifier names for compatibility checking")
fn map_kain_attr_to_specifier(attr_name: String) -> String:
    match attr_name:
        "blueprint_read_write" => ("BlueprintReadWrite").to_string()
        "blueprint_read_only" => ("BlueprintReadOnly").to_string()
        "blueprint_setter" => ("BlueprintSetter").to_string()
        "blueprint_getter" => ("BlueprintGetter").to_string()
        "edit_anywhere" => ("EditAnywhere").to_string()
        "edit_defaults_only" => ("EditDefaultsOnly").to_string()
        "edit_instance_only" => ("EditInstanceOnly").to_string()
        "visible_anywhere" => ("VisibleAnywhere").to_string()
        "visible_defaults_only" => ("VisibleDefaultsOnly").to_string()
        "visible_instance_only" => ("VisibleInstanceOnly").to_string()
        "replicated" => ("Replicated").to_string()
        "transient" => ("Transient").to_string()
        "savegame" => ("SaveGame").to_string()
        "config" => ("Config").to_string()
        "interp" => ("Interp").to_string()
        _ => String__new_()

@doc(doc = " Helper: Check if a type is a delegate")
fn is_delegate_type(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } => name.to_lowercase().contains("delegate")
        _ => false

@doc(doc = " Helper: Check for name collisions with known UE5 engine types")
@doc(doc = " Uses EngineKnowledge for comprehensive collision detection instead of a hardcoded list.")
@doc(doc = " This prevents UHT errors like \"shares engine name with class/struct in Engine\"")
fn check_engine_name_collision(ctx: &mut ValidationContext, type_name: String, type_kind: String, kb: &EngineKnowledge):
    let emitted_name = match type_kind:
        "Actor" => naming__to_actor_name(type_name)
        "Component" => naming__to_component_name(type_name)
        "Struct" => naming__to_struct_name(type_name)
        "Enum" => naming__to_enum_name(type_name)
        "UObject" => naming__to_uobject_name(type_name)
        _ => type_name.to_string()
    let emitted_engine_name = strip_ue_prefix(&emitted_name)
    let emitted_collides = ((kb.is_known_type(&emitted_name) || kb.is_known_type(emitted_engine_name)) || kb.resolve_type_alias(emitted_engine_name).is_some())
    if emitted_collides:
        ctx.warning(f"{type_kind} '{type_name}': This name may collide with a UE5 engine type. The UE5 naming layer should remap hard collisions, but this name deserves review if generated code still trips UHT. Consider a more specific name (e.g., 'My{type_name}', 'Custom{type_name}', 'Game{type_name}').")
        ()

fn strip_ue_prefix(name: String) -> String:
    match name.chars().next():
        Some(first) =>
            if (none && name.chars().nth(1).map_or(false, fn(c): c.is_uppercase())):
                return &name[1..]
            ()
        _ =>
            ()
            ()
    name

@doc(doc = " Task 4.1: Validate replication setup")
@doc(doc = " Requirement 3.1: Verify GetLifetimeReplicatedProps will be generated")
@doc(doc = " Requirement 3.2: Verify RPC naming conventions and parameter serialization")
fn validate_replication(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram):
    let enum_names: Set<String> = (*program).items.iter().filter_map(fn(item): none).collect()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Actor(actor_) =>
                let actor_name = &actor_.ast.name
                let mut has_replicated_props = false
                for state_ in &actor_.ast.state_:
                    let is_replicated = state_.attributes.iter().any(fn(a): (a.name == "replicated"))
                    if is_replicated:
                        has_replicated_props = true
                        ()
                        if (!is_serializable_type(&state_.ty, &enum_names)):
                            ctx.error(f"Actor '{actor_name}', property '{state_.name}': Replicated properties must be UE5-serializable. Type '{state_.ty}' cannot be replicated. Use primitives, structs, enums, or UObject pointers.")
                            ()
                ()
                if has_replicated_props:
                    ()
                ()
            _ =>
                ()
                ()
        match item:
            kain_core__types__TypedItem::Component(comp) =>
                let comp_name = &comp.ast.name
                for state_ in &comp.ast.state_:
                    let is_replicated = state_.attributes.iter().any(fn(a): (a.name == "replicated"))
                    if is_replicated:
                        if (!is_serializable_type(&state_.ty, &enum_names)):
                            ctx.error(f"Component '{comp_name}', property '{state_.name}': Replicated properties must be UE5-serializable. Type '{state_.ty}' cannot be replicated.")
                            ()
            _ => ()

@doc(doc = " Task 4.2: Validate RPC naming and parameters")
@doc(doc = " Requirement 3.2: Verify Server_*, Client_*, Multicast_* naming")
@doc(doc = " Requirement 3.2: Validate RPC parameter types are serializable")
fn validate_rpcs(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram):
    let enum_names: Set<String> = (*program).items.iter().filter_map(fn(item): none).collect()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Actor(actor_) =>
                let actor_name = &actor_.ast.name
                for handler in &actor_.ast.handlers:
                    let handler_name = &handler.message_type
                    let is_server = handler_name.starts_with("Server_")
                    let is_client = handler_name.starts_with("Client_")
                    let is_multicast = handler_name.starts_with("Multicast_")
                    if ((is_server || is_client) || is_multicast):
                        for param in &handler.params:
                            if (!is_serializable_type(&param.ty, &enum_names)):
                                ctx.error(f"Actor '{actor_name}', RPC '{handler_name}', parameter '{param.name}': RPC parameters must be serializable. Type '{param.ty}' cannot be used in RPCs.")
                                ()
                                ()
                                ()
                                ()
                            if is_delegate_type(&param.ty):
                                ctx.error(f"Actor '{actor_name}', RPC '{handler_name}', parameter '{param.name}': RPC parameters cannot be delegates. This is a UE5 security/stability restriction.")
                                ()
                ()
                for method in &actor_.ast.methods:
                    let method_name = &method.name
                    let is_server = method_name.starts_with("Server_")
                    let is_client = method_name.starts_with("Client_")
                    let is_multicast = method_name.starts_with("Multicast_")
                    if ((is_server || is_client) || is_multicast):
                        for param in &method.params:
                            if (!is_serializable_type(&param.ty, &enum_names)):
                                ctx.error(f"Actor '{actor_name}', RPC '{method_name}', parameter '{param.name}': RPC parameters must be serializable. Type '{param.ty}' cannot be used in RPCs.")
                                ()
                                ()
                                ()
                                ()
                            if is_delegate_type(&param.ty):
                                ctx.error(f"Actor '{actor_name}', RPC '{method_name}', parameter '{param.name}': RPC parameters cannot be delegates.")
                                ()
            _ => ()

@doc(doc = " Task 4.3: Validate datatable structs")
@doc(doc = " Requirement 3.3: Verify all fields are UE5-serializable, no pointers")
fn validate_datatables(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, _kb: &EngineKnowledge):
    let user_defined_types: Set<String> = (*program).items.iter().filter_map(fn(item): none).collect()
    let enum_names: Set<String> = (*program).items.iter().filter_map(fn(item): none).collect()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(struct_def) =>
                let is_datatable = struct_def.ast.attributes.iter().any(fn(a): (a.name == "datatable"))
                if is_datatable:
                    let struct_name = &struct_def.ast.name
                    for field in &struct_def.ast.fields:
                        let is_user_type = match &field.ty:
                            kain_core__ast__Type::Named { name: name } => user_defined_types.contains(name.as_str())
                            _ => false
                        if ((!is_user_type) && (!is_serializable_type(&field.ty, &enum_names))):
                            ctx.error(f"DataTable struct '{struct_name}', field '{field.name}': DataTable fields must be UE5-serializable. Type '{field.ty}' cannot be used in DataTables.")
                            ()
                            ()
                            ()
                            ()
                        if is_pointer_type(&field.ty):
                            ctx.error(f"DataTable struct '{struct_name}', field '{field.name}': DataTable fields cannot be pointers. Use value types or soft object references instead.")
                            ()
            _ => ()

@doc(doc = " Task 4.4: Validate component-specific rules")
@doc(doc = " Requirement 3.4: Verify no actor-only features in components")
fn validate_components_enhanced(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram):
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Component(comp) =>
                let comp_name = &comp.ast.name
                for method in &comp.ast.methods:
                    if ((method.name == "Tick") || (method.name == "tick")):
                        ctx.warning(f"Component '{comp_name}': Tick functions in components must be explicitly enabled with PrimaryComponentTick.bCanEverTick = true. Consider using timers or events instead for better performance.")
                        ()
                        ()
                        ()
                        ()
                    if ((method.name.starts_with("Server_") || method.name.starts_with("Client_")) || method.name.starts_with("Multicast_")):
                        ctx.warning(f"Component '{comp_name}', method '{method.name}': RPCs in components are unusual. Consider moving networking logic to the owning actor.")
                        ()
            _ => ()

@doc(doc = " Task 4.5: Validate name collisions with engine types")
@doc(doc = " Requirement 3.10: Check against EngineKnowledge for engine types")
@doc(doc = " Requirement 3.11: Check for C++ keywords and UE5 macro names")
fn validate_name_collisions(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, kb: &EngineKnowledge):
    const CPP_KEYWORDS: Array<String> = ["alignas", "alignof", "and", "and_eq", "asm", "auto", "bitand", "bitor", "bool", "break", "case", "catch", "char", "char8_t", "char16_t", "char32_t", "class", "compl", "concept", "const", "consteval", "constexpr", "constinit", "const_cast", "continue", "co_await", "co_return", "co_yield", "decltype", "default", "delete", "do", "double", "dynamic_cast", "else", "enum", "explicit", "export", "extern", "false", "float", "for", "friend", "goto", "if", "inline", "int", "long", "mutable", "namespace", "new", "noexcept", "not", "not_eq", "nullptr", "operator", "or", "or_eq", "private", "protected", "public", "register", "reinterpret_cast", "requires", "return", "short", "signed", "sizeof", "static", "static_assert", "static_cast", "struct", "switch", "template", "this", "thread_local", "throw", "true", "try", "typedef", "typeid", "typename", "union", "unsigned", "using", "virtual", "void", "volatile", "wchar_t", "while", "xor", "xor_eq"]

    const UE5_MACROS: Array<String> = ["UCLASS", "USTRUCT", "UENUM", "UFUNCTION", "UPROPERTY", "UMETA", "GENERATED_BODY", "GENERATED_UCLASS_BODY", "GENERATED_USTRUCT_BODY", "TEXT", "LOCTEXT", "NSLOCTEXT", "TEXTVIEW", "UPARAM", "UDELEGATE", "DECLARE_DYNAMIC_MULTICAST_DELEGATE"]

    for item in &(*program).items:
        let (type_name, type_kind) = match item:
            kain_core__types__TypedItem::Enum(en) => (&en.ast.name, "Enum")
            kain_core__types__TypedItem::Struct(st) => (&st.ast.name, "Struct")
            kain_core__types__TypedItem::Actor(actor_) => (&actor_.ast.name, "Actor")
            kain_core__types__TypedItem::Component(comp) => (&comp.ast.name, "Component")
            _ => continue
        let lower_name = type_name.to_lowercase()
        if CPP_KEYWORDS.contains(&lower_name.as_str()):
            ctx.error(f"{type_kind} '{type_name}': This name is a C++ keyword and cannot be used as an identifier.")
            ()
            ()
            ()
            ()
        if UE5_MACROS.contains(&type_name.as_str()):
            ctx.error(f"{type_kind} '{type_name}': This name is a UE5 macro and cannot be used as a type name.")
            ()

@doc(doc = " Task 4.6: Validate circular dependencies")
@doc(doc = " Requirement 3.12: Detect cycles and suggest forward declarations")
fn validate_circular_dependencies(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram):
    use std::collections::HashMap

    use std::collections::HashSet

    let mut dependencies: Map<String, Set<String>> = HashMap__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(struct_def) =>
                let struct_name = struct_def.ast.name.clone()
                let mut deps = HashSet__new_()
                for field in &struct_def.ast.fields:
                    match extract_type_name(&field.ty):
                        Some(dep_name) =>
                            deps.insert(dep_name)
                            ()
                        _ => ()
                ()
                dependencies.insert(struct_name, deps)
                ()
            kain_core__types__TypedItem::Actor(actor_) =>
                let actor_name = actor_.ast.name.clone()
                let mut deps = HashSet__new_()
                for state_ in &actor_.ast.state_:
                    match extract_type_name(&state_.ty):
                        Some(dep_name) =>
                            deps.insert(dep_name)
                            ()
                        _ => ()
                ()
                dependencies.insert(actor_name, deps)
                ()
            kain_core__types__TypedItem::Component(comp) =>
                let comp_name = comp.ast.name.clone()
                let mut deps = HashSet__new_()
                for state_ in &comp.ast.state_:
                    match extract_type_name(&state_.ty):
                        Some(dep_name) =>
                            deps.insert(dep_name)
                            ()
                        _ => ()
                ()
                dependencies.insert(comp_name, deps)
                ()
            _ => ()
    ()
    let mut visited = HashSet__new_()
    let mut rec_stack = HashSet__new_()
    for type_name in dependencies.keys():
        if (!visited.contains(type_name)):
            if detect_cycle(type_name, &dependencies, &mut visited, &mut rec_stack, &mut Vec__new_(), ctx):
                let __selfhost_empty = none

@doc(doc = " Helper: Detect cycles in dependency graph using DFS")
fn detect_cycle(node: String, graph: &Map<String, Set<String>>, visited: &mut Set<String>, rec_stack: &mut Set<String>, path: &mut Array<String>, ctx: &mut ValidationContext) -> Bool:
    visited.insert(node.to_string())
    ()
    rec_stack.insert(node.to_string())
    ()
    path.push(node.to_string())
    ()
    match graph.get(node):
        Some(neighbors) =>
            for neighbor in neighbors:
                if (!visited.contains(neighbor)):
                    if detect_cycle(neighbor, graph, visited, rec_stack, path, ctx):
                        return true
                elif rec_stack.contains(neighbor):
                    let cycle_start = path.iter().position(fn(n): (n == neighbor)).unwrap()
                    let cycle: Array<_> = path[cycle_start..].iter().cloned().collect()
                    ctx.error("Circular dependency detected: {cycle.join(\" → \")} → {neighbor}. Use forward declarations or pointers to break the cycle.")
                    ()
                    return true
            ()
            ()
        _ =>
            ()
            ()
    rec_stack.remove(node)
    ()
    path.pop()
    ()
    false

@doc(doc = " Helper: Extract type name from Type AST node")
fn extract_type_name(ty: &kain_core::ast::Type) -> Option<String>:
    match ty:
        kain_core__ast__Type::Named { name: name } => Option::Some(name.clone())
        _ => none

@doc(doc = " Helper: Check if a type is serializable for replication/RPCs")
fn is_serializable_type(ty: &kain_core::ast::Type, enum_names: &Set<String>) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } =>
            if enum_names.contains(name):
                return true
            ((((none || name.starts_with("E")) || name.starts_with("F")) || name.starts_with("U")) || name.starts_with("A"))
        _ => false

@doc(doc = " Helper: Check if a type is a pointer type")
fn is_pointer_type(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } => ((name.starts_with("U") || name.starts_with("A")) || name.contains("*"))
        _ => false

@doc(doc = " Enforce custom validation rules from validation_rules.json")
fn enforce_custom_rules(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, rules: &ValidationRules, kb: &EngineKnowledge):
    for rule in rules.enabled_rules():
        match &rule.condition:
            RuleCondition::TypeCollision { type_names: type_names } =>
                enforce_type_collision_rule(ctx, program, rule, type_names)
                ()
            RuleCondition::IncompatibleAttributes { attributes: attributes } =>
                enforce_incompatible_attributes_rule(ctx, program, rule, attributes)
                ()
            RuleCondition::InvalidRpcNaming { pattern: pattern } =>
                enforce_rpc_naming_rule(ctx, program, rule, pattern)
                ()
            RuleCondition::NestedContainer { outer: outer, inner: inner } =>
                enforce_nested_container_rule(ctx, program, rule, outer, inner)
                ()
            RuleCondition::InvalidNaming { pattern: pattern, applies_to: applies_to } =>
                enforce_invalid_naming_rule(ctx, program, rule, pattern, applies_to)
                ()
            RuleCondition::MissingAttribute { required_attribute: required_attribute, when_attribute: when_attribute } =>
                enforce_missing_attribute_rule(ctx, program, rule, required_attribute, when_attribute)
                ()
            RuleCondition::ForbiddenType { forbidden_types: forbidden_types, context: type_context } =>
                enforce_forbidden_type_rule(ctx, program, rule, forbidden_types, type_context)
                ()

@doc(doc = " Enforce type collision rule")
fn enforce_type_collision_rule(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, rule: &ValidationRule, type_names: &[String]):
    for item in &(*program).items:
        let item_name = match item:
            kain_core__types__TypedItem::Actor(a) => Option::Some(&a.ast.name)
            kain_core__types__TypedItem::Struct(s) => Option::Some(&s.ast.name)
            kain_core__types__TypedItem::Enum(e) => Option::Some(&e.ast.name)
            kain_core__types__TypedItem::Component(c) => Option::Some(&c.ast.name)
            _ => none
        match item_name:
            Some(name) =>
                if type_names.contains(name):
                    let msg = f"{(*rule).message}: {name}"
                    match (*rule).severity:
                        Severity::Error =>
                            ctx.error(msg)
                            ()
                            match &(*rule).suggestion:
                                Some(suggestion) =>
                                    ctx.error(f"  Suggestion: {suggestion}")
                                    ()
                                _ => ()
                        Severity::Warning =>
                            ctx.warning(msg)
                            ()
                            match &(*rule).suggestion:
                                Some(suggestion) =>
                                    ctx.warning(f"  Suggestion: {suggestion}")
                                    ()
                                _ => ()
                        Severity::Info =>
                            ctx.warning(f"Info: {msg}")
                            ()
            _ => ()

@doc(doc = " Enforce incompatible attributes rule")
fn enforce_incompatible_attributes_rule(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, rule: &ValidationRule, attribute_pairs: &[(String, String)]):
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Actor(actor_) =>
                for field in &actor_.ast.state_:
                    check_incompatible_attrs(ctx, rule, &field.attributes, &field.name, attribute_pairs)
                    ()
            kain_core__types__TypedItem::Struct(struct_def) =>
                for field in &struct_def.ast.fields:
                    check_incompatible_attrs(ctx, rule, &field.attributes, &field.name, attribute_pairs)
                    ()
            kain_core__types__TypedItem::Component(comp) =>
                for field in &comp.ast.state_:
                    check_incompatible_attrs(ctx, rule, &field.attributes, &field.name, attribute_pairs)
                    ()
            _ => ()

fn check_incompatible_attrs(ctx: &mut ValidationContext, rule: &ValidationRule, attributes: &[kain_core::ast::Attribute], field_name: String, attribute_pairs: &[(String, String)]):
    let attr_names: Array<String> = attributes.iter().map(fn(a): a.name.clone()).collect()
    for selfhost_for_item in attribute_pairs:
        let (attr1, attr2) = selfhost_for_item
        if (attr_names.contains(attr1) && attr_names.contains(attr2)):
            let msg = f"{(*rule).message} (field: {field_name})"
            match (*rule).severity:
                Severity::Error =>
                    ctx.error(msg)
                    ()
                    match &(*rule).suggestion:
                        Some(suggestion) =>
                            ctx.error(f"  Suggestion: {suggestion}")
                            ()
                        _ => ()
                Severity::Warning =>
                    ctx.warning(msg)
                    ()
                Severity::Info =>
                    ctx.warning(f"Info: {msg}")
                    ()

@doc(doc = " Enforce RPC naming rule")
fn enforce_rpc_naming_rule(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, rule: &ValidationRule, pattern: String):
    let re = match Regex__new_(pattern):
        Ok(r) => r
        Err(_) => return
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Actor(actor_) =>
                for method in &actor_.ast.methods:
                    let has_rpc_attr = method.attributes.iter().any(fn(a): none)
                    if (has_rpc_attr && (!re.is_match(&method.name))):
                        let msg = f"{(*rule).message}: {method.name}"
                        match (*rule).severity:
                            Severity::Error =>
                                ctx.error(msg)
                                ()
                                match &(*rule).suggestion:
                                    Some(suggestion) =>
                                        ctx.error(f"  Suggestion: {suggestion}")
                                        ()
                                    _ => ()
                            Severity::Warning =>
                                ctx.warning(msg)
                                ()
                            Severity::Info =>
                                ctx.warning(f"Info: {msg}")
                                ()
            _ => ()

@doc(doc = " Enforce nested container rule")
fn enforce_nested_container_rule(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, rule: &ValidationRule, outer: &[String], inner: &[String]):
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Actor(actor_) =>
                for field in &actor_.ast.state_:
                    check_nested_container(ctx, rule, &field.ty, &field.name, outer, inner)
                    ()
            kain_core__types__TypedItem::Struct(struct_def) =>
                for field in &struct_def.ast.fields:
                    check_nested_container(ctx, rule, &field.ty, &field.name, outer, inner)
                    ()
            kain_core__types__TypedItem::Component(comp) =>
                for field in &comp.ast.state_:
                    check_nested_container(ctx, rule, &field.ty, &field.name, outer, inner)
                    ()
            _ => ()

fn check_nested_container(ctx: &mut ValidationContext, rule: &ValidationRule, ty: &kain_core::ast::Type, field_name: String, outer: &[String], inner: &[String]):
    match ty:
        kain_core__ast__Type::Named { name: outer_name, generics: inner_types } =>
            if outer.contains(outer_name):
                for inner_ty in inner_types:
                    match inner_ty:
                        kain_core__ast__Type::Named { name: inner_name } =>
                            if inner.contains(inner_name):
                                let msg = f"{(*rule).message} (field: {field_name}, type: {outer_name})"
                                match (*rule).severity:
                                    Severity::Error =>
                                        ctx.error(msg)
                                        ()
                                        match &(*rule).suggestion:
                                            Some(suggestion) =>
                                                ctx.error(f"  Suggestion: {suggestion}")
                                                ()
                                            _ => ()
                                    Severity::Warning =>
                                        ctx.warning(msg)
                                        ()
                                    Severity::Info =>
                                        ctx.warning(f"Info: {msg}")
                                        ()
                        _ => ()
        _ => ()

@doc(doc = " Enforce invalid naming rule")
fn enforce_invalid_naming_rule(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, rule: &ValidationRule, pattern: String, applies_to: &[String]):
    let re = match Regex__new_(pattern):
        Ok(r) => r
        Err(_) => return
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Actor(actor_) if applies_to.contains(&("actor").to_string()) =>
                if re.is_match(&actor_.ast.name):
                    report_naming_violation(ctx, rule, &actor_.ast.name, "actor")
                    ()
            kain_core__types__TypedItem::Struct(struct_def) if applies_to.contains(&("struct").to_string()) =>
                if re.is_match(&struct_def.ast.name):
                    report_naming_violation(ctx, rule, &struct_def.ast.name, "struct")
                    ()
            kain_core__types__TypedItem::Enum(enum_def) if applies_to.contains(&("enum").to_string()) =>
                if re.is_match(&enum_def.ast.name):
                    report_naming_violation(ctx, rule, &enum_def.ast.name, "enum")
                    ()
            kain_core__types__TypedItem::Component(comp) if applies_to.contains(&("component").to_string()) =>
                if re.is_match(&comp.ast.name):
                    report_naming_violation(ctx, rule, &comp.ast.name, "component")
                    ()
            kain_core__types__TypedItem::Function(func) if applies_to.contains(&("function").to_string()) =>
                if re.is_match(&func.ast.name):
                    report_naming_violation(ctx, rule, &func.ast.name, "function")
                    ()
            _ => ()

fn report_naming_violation(ctx: &mut ValidationContext, rule: &ValidationRule, name: String, kind: String):
    let msg = f"{(*rule).message} ({kind} '{name}')"
    match (*rule).severity:
        Severity::Error =>
            ctx.error(msg)
            ()
            match &(*rule).suggestion:
                Some(suggestion) =>
                    ctx.error(f"  Suggestion: {suggestion}")
                    ()
                _ => ()
        Severity::Warning =>
            ctx.warning(msg)
            ()
        Severity::Info =>
            ctx.warning(f"Info: {msg}")
            ()

@doc(doc = " Enforce missing attribute rule")
fn enforce_missing_attribute_rule(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, rule: &ValidationRule, _required_attribute: String, _when_attribute: String):
    let __selfhost_empty = none

@doc(doc = " Enforce forbidden type rule")
fn enforce_forbidden_type_rule(ctx: &mut ValidationContext, program: &kain_core::types::TypedProgram, rule: &ValidationRule, forbidden_types: &[String], type_context: String):
    match type_context:
        "datatable" =>
            for item in &(*program).items:
                match item:
                    kain_core__types__TypedItem::Struct(struct_def) =>
                        let is_datatable = struct_def.ast.attributes.iter().any(fn(a): (a.name == "datatable"))
                        if is_datatable:
                            for field in &struct_def.ast.fields:
                                if contains_forbidden_type(&field.ty, forbidden_types):
                                    let msg = f"{(*rule).message} (struct: {struct_def.ast.name}, field: {field.name})"
                                    match (*rule).severity:
                                        Severity::Error =>
                                            ctx.error(msg)
                                            ()
                                            match &(*rule).suggestion:
                                                Some(suggestion) =>
                                                    ctx.error(f"  Suggestion: {suggestion}")
                                                    ()
                                                _ => ()
                                        Severity::Warning =>
                                            ctx.warning(msg)
                                            ()
                                        Severity::Info =>
                                            ctx.warning(f"Info: {msg}")
                                            ()
                    _ => ()
        "rpc_parameter" =>
            for item in &(*program).items:
                match item:
                    kain_core__types__TypedItem::Actor(actor_) =>
                        for method in &actor_.ast.methods:
                            let has_rpc_attr = method.attributes.iter().any(fn(a): none)
                            if has_rpc_attr:
                                for param in &method.params:
                                    if contains_forbidden_type(&param.ty, forbidden_types):
                                        let msg = f"{(*rule).message} (RPC: {method.name}, parameter: {param.name})"
                                        match (*rule).severity:
                                            Severity::Error =>
                                                ctx.error(msg)
                                                ()
                                                match &(*rule).suggestion:
                                                    Some(suggestion) =>
                                                        ctx.error(f"  Suggestion: {suggestion}")
                                                        ()
                                                    _ => ()
                                            Severity::Warning =>
                                                ctx.warning(msg)
                                                ()
                                            Severity::Info =>
                                                ctx.warning(f"Info: {msg}")
                                                ()
                    _ => ()
        _ => ()

fn contains_forbidden_type(ty: &kain_core::ast::Type, forbidden_types: &[String]) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } =>
            if forbidden_types.iter().any(fn(ft): name.contains(ft)):
                return true
            generics.iter().any(fn(t): contains_forbidden_type(t, forbidden_types))
        kain_core__ast__Type::Tuple(types, _) => types.iter().any(fn(t): contains_forbidden_type(t, forbidden_types))
        kain_core__ast__Type::Array(inner, _, _) => contains_forbidden_type(inner, forbidden_types)
        kain_core__ast__Type::Slice(inner, _) => contains_forbidden_type(inner, forbidden_types)
        kain_core__ast__Type::Option(inner, _) => contains_forbidden_type(inner, forbidden_types)
        kain_core__ast__Type::Result(ok, err, _) => (contains_forbidden_type(ok, forbidden_types) || contains_forbidden_type(err, forbidden_types))
        kain_core__ast__Type::Ref { inner: inner } => contains_forbidden_type(inner, forbidden_types)
        kain_core__ast__Type::Function { params: params, return_type: return_type } => (params.iter().any(fn(t): contains_forbidden_type(t, forbidden_types)) || contains_forbidden_type(return_type, forbidden_types))
        _ => false

