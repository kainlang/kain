use serde::Deserialize

use serde::Serialize

use std::collections::HashMap

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct WidgetProperty:
    prop_type: String
    kind: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct WidgetEvent:
    delegate_type: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct WidgetSlot:
    name: String
    kind: String
    slot_class: Option<String>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct WidgetInfo:
    name: String
    parent: String
    header: String
    properties: Map<String, WidgetProperty>
    events: Map<String, WidgetEvent>
    slots: Array<WidgetSlot>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct DelegateInfo:
    name: String
    return_type: String
    params: Array<String>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct SlotRequirement:
    required_slots: Array<String>
    max_children: i32
    slot_type: String
    description: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct PropertyDependency:
    requires: Array<String>
    validation: String
    description: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct PropertyExclusion:
    mutually_exclusive: Array<Array<String>>
    description: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct ParentChildCompatibility:
    can_contain: Array<String>
    description: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct CompositionRules:
    slot_requirements: Map<String, SlotRequirement>
    property_dependencies: Map<String, Map<String, PropertyDependency>>
    property_exclusions: Map<String, PropertyExclusion>
    parent_child_compatibility: Map<String, ParentChildCompatibility>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct PropertyConstraint:
    validation: String
    default_range: Option<serde_json::Value>
    components: Array<String>
    component_range: Option<serde_json::Value>
    values: Array<String>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct WidgetRegistryData:
    widgets: Map<String, WidgetInfo>
    delegates: Map<String, DelegateInfo>
    composition_rules: Option<CompositionRules>
    property_constraints: Map<String, PropertyConstraint>

@derive(Debug, Clone)
pub struct WidgetRegistry:
    widgets: Map<String, WidgetInfo>
    delegates: Map<String, DelegateInfo>
    composition_rules: Option<CompositionRules>
    property_constraints: Map<String, PropertyConstraint>
    event_delegate_map: Map<String, String>

impl Default for WidgetRegistry:
    fn default_() -> WidgetRegistry:
        WidgetRegistry__new_()


impl WidgetRegistry:
    pub fn new_() -> WidgetRegistry:
        WidgetRegistry { widgets: HashMap__new_(), delegates: HashMap__new_(), composition_rules: none, property_constraints: HashMap__new_(), event_delegate_map: HashMap__new_() }

    pub fn load(_self: &mut WidgetRegistry, json_data: String) -> Result<(), String>:
        let data: WidgetRegistryData = serde_json__from_str(json_data).map_err(fn(e): f"Failed to parse widget registry: {e}")?
        (*_self).widgets = data.widgets
        ()
        (*_self).delegates = data.delegates
        ()
        (*_self).composition_rules = data.composition_rules
        ()
        (*_self).property_constraints = data.property_constraints
        ()
        (*_self).rebuild_event_map()
        ()
        Result::Ok(())

    fn rebuild_event_map(_self: &mut WidgetRegistry):
        (*_self).event_delegate_map.clear()
        ()
        let mut freq: Map<String, Map<String, usize>> = HashMap__new_()
        for widget in (*_self).widgets.values():
            for selfhost_for_item in &widget.events:
                let (event_name, event_info) = selfhost_for_item
                (*freq.entry(event_name.clone()).or_default().entry(event_info.delegate_type.clone()).or_insert(0)) = ((*freq.entry(event_name.clone()).or_default().entry(event_info.delegate_type.clone()).or_insert(0)) + 1)
                ()
        ()
        for selfhost_for_item in freq:
            let (event_name, type_counts) = selfhost_for_item
            match type_counts.into_iter().max_by_key(fn(__kain_closure_arg0): (*__kain_closure_arg0.__kain_tuple_1)):
                Some((best_type, _)) =>
                    (*_self).event_delegate_map.insert(event_name, best_type)
                    ()
                _ => ()

    pub fn get_widget(_self: &WidgetRegistry, name: String) -> Option<&WidgetInfo>:
        (*_self).widgets.get(name)

    pub fn get_event_delegate(_self: &WidgetRegistry, widget_name: String, event_name: String) -> Option<String>:
        ((*_self).widgets.get(widget_name)?).events.get(event_name).map(fn(e): e.delegate_type.as_str())

    pub fn get_event_delegate_any(_self: &WidgetRegistry, event_name: String) -> Option<String>:
        (*_self).event_delegate_map.get(event_name).map(fn(s): s.as_str())

    pub fn get_property_type(_self: &WidgetRegistry, widget_name: String, property_name: String) -> Option<String>:
        ((*_self).widgets.get(widget_name)?).properties.get(property_name).map(fn(p): p.prop_type.as_str())

    pub fn get_widget_header(_self: &WidgetRegistry, widget_name: String) -> Option<String>:
        (*_self).widgets.get(widget_name).map(fn(w): w.header.as_str()).filter(fn(h): (!h.is_empty()))

    pub fn has_default_slot(_self: &WidgetRegistry, widget_name: String) -> Bool:
        (*_self).widgets.get(widget_name).map_or(false, fn(w): w.slots.iter().any(fn(s): (s.kind == "default")))

    pub fn has_multi_slot(_self: &WidgetRegistry, widget_name: String) -> Bool:
        (*_self).widgets.get(widget_name).map_or(false, fn(w): w.slots.iter().any(fn(s): (s.kind == "multi")))

    pub fn get_delegate(_self: &WidgetRegistry, name: String) -> Option<&DelegateInfo>:
        (*_self).delegates.get(name)

    pub fn is_known_widget(_self: &WidgetRegistry, name: String) -> Bool:
        (*_self).widgets.contains_key(name)

    pub fn get_parent(_self: &WidgetRegistry, widget_name: String) -> Option<String>:
        (*_self).widgets.get(widget_name).map(fn(w): w.parent.as_str()).filter(fn(p): (!p.is_empty()))

    pub fn get_widget_events(_self: &WidgetRegistry, widget_name: String) -> Array<String>:
        (*_self).widgets.get(widget_name).map_or(Vec__new_(), fn(w): w.events.keys().map(fn(k): k.as_str()).collect())

    pub fn get_widget_properties(_self: &WidgetRegistry, widget_name: String) -> Array<String>:
        (*_self).widgets.get(widget_name).map_or(Vec__new_(), fn(w): w.properties.keys().map(fn(k): k.as_str()).collect())

    pub fn stats(_self: &WidgetRegistry) -> (usize, usize, usize):
        let total_events: usize = (*_self).widgets.values().map(fn(w): w.events.len()).sum()
        ((*_self).widgets.len(), total_events, (*_self).delegates.len())

    pub fn get_slot_requirements(_self: &WidgetRegistry, widget_name: String) -> Option<&SlotRequirement>:
        ((*_self).composition_rules?).slot_requirements.get(widget_name)

    pub fn get_property_dependencies(_self: &WidgetRegistry, widget_name: String, property_name: String) -> Option<&PropertyDependency>:
        (((*_self).composition_rules?).property_dependencies.get(widget_name)?).get(property_name)

    pub fn get_property_exclusions(_self: &WidgetRegistry, widget_name: String) -> Option<&PropertyExclusion>:
        ((*_self).composition_rules?).property_exclusions.get(widget_name)

    pub fn get_parent_child_compatibility(_self: &WidgetRegistry, widget_class: String) -> Option<&ParentChildCompatibility>:
        ((*_self).composition_rules?).parent_child_compatibility.get(widget_class)

    pub fn get_property_constraint(_self: &WidgetRegistry, type_name: String) -> Option<&PropertyConstraint>:
        (*_self).property_constraints.get(type_name)

    pub fn can_contain_children(_self: &WidgetRegistry, widget_name: String) -> Bool:
        match (*_self).get_slot_requirements(widget_name):
            Some(req) => return (req.max_children != 0)
            _ =>
                ()
                ()
        (*_self).widgets.get(widget_name).map_or(false, fn(w): (!w.slots.is_empty()))

    pub fn validate_property_value(_self: &WidgetRegistry, type_name: String, value: String) -> Result<(), String>:
        match (*_self).get_property_constraint(type_name):
            Some(constraint) =>
                match constraint.validation.as_str():
                    "is_finite" =>
                        match value.parse():
                            Ok(f) =>
                                if (!f.is_finite()):
                                    return Result::Err(f"{type_name} must be a finite number")
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    "is_integer" =>
                        if value.parse().is_err():
                            return Result::Err(f"{type_name} must be an integer")
                        ()
                    "is_enum" =>
                        if (!constraint.values.contains(&value.to_string())):
                            return Result::Err("{type_name} must be one of: {constraint.values.join(\", \")}")
                        ()
                    _ => ()
                ()
            _ =>
                ()
                ()
        Result::Ok(())


