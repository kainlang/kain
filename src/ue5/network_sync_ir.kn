use crate::ue5::context::Ue5Context

use crate::ue5::types::TypeMapper

use kain_core::ast::Attribute

use kain_core::ast::BinaryOp

use kain_core::ast::Field

use kain_core::ast::Struct

@doc(doc = " Network synchronization intermediate representation")
@doc(doc = " Represents a component with replicated properties and network configuration")
@derive(Debug, Clone)
pub struct NetworkSyncIR:
    component_name: String
    replicated_properties: Array<ReplicatedPropertyIR>
    config: NetworkConfigIR

@doc(doc = " A single replicated property with its replication mode")
@derive(Debug, Clone)
pub struct ReplicatedPropertyIR:
    name: String
    cpp_type: String
    mode: ReplicationModeIR
    compression: Option<CompressionSettingsIR>

pub enum ReplicationModeIR:
    Simple
    Interpolated { back_time: f32, buffer_size: usize }
    Extrapolated { limit: f32 }
    Compressed { threshold: f32, use_half_float: Bool }

@doc(doc = " Compression settings for bandwidth optimization")
@derive(Debug, Clone)
pub struct CompressionSettingsIR:
    threshold: f32
    quantize: Bool
    quantize_bits: u8

@doc(doc = " Network configuration for the component")
@derive(Debug, Clone)
pub struct NetworkConfigIR:
    snap_threshold: f32
    send_rate: f32
    owner_time_sync: Bool
    optimize_bandwidth: Bool

impl Default for NetworkConfigIR:
    fn default_() -> NetworkConfigIR:
        NetworkConfigIR { snap_threshold: 500, send_rate: 30, owner_time_sync: true, optimize_bandwidth: true }


@doc(doc = " Convert a component struct with @replicated attributes to NetworkSyncIR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `component` - The component struct from AST")
@doc(doc = " * `ctx` - UE5 compilation context for type mapping")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `Ok(NetworkSyncIR)` - Successfully converted IR")
@doc(doc = " * `Err(String)` - Conversion error with description")
pub fn convert_to_network_sync_ir(component_: &kain_core::ast::Struct, ctx: &Ue5Context) -> Result<NetworkSyncIR, String>:
    let mut type_mapper = TypeMapper__with_knowledge((*ctx).knowledge.clone())
    for enum_name in &(*ctx).enum_names:
        type_mapper.register_enum(enum_name.clone())
        ()
    ()
    for struct_name in &(*ctx).struct_names:
        type_mapper.register_struct(struct_name.clone())
        ()
    ()
    for component_name in &(*ctx).component_names:
        type_mapper.register_component(component_name.clone())
        ()
    ()
    for actor_name in &(*ctx).actor_names:
        type_mapper.register_actor(actor_name.clone())
        ()
    ()
    for delegate_name in &(*ctx).delegate_names:
        type_mapper.register_delegate(delegate_name.clone())
        ()
    ()
    let mut replicated_properties = Vec__new_()
    for field in &component_.fields:
        match find_attribute(&field.attributes, "replicated"):
            Some(repl_attr) =>
                let property = convert_replicated_property(field, &repl_attr, &type_mapper)?
                replicated_properties.push(property)
                ()
            _ => ()
    ()
    let config = extract_network_config(&component_.attributes)?
    Result::Ok(NetworkSyncIR { component_name: component_.name.clone(), replicated_properties: replicated_properties, config: config })

@doc(doc = " Convert a single field with @replicated attribute to ReplicatedPropertyIR")
fn convert_replicated_property(field: &kain_core::ast::Field, repl_attr: &kain_core::ast::Attribute, type_mapper: &TypeMapper) -> Result<ReplicatedPropertyIR, String>:
    let cpp_type = type_mapper.map_type_string(&(*field).ty)
    let mode = parse_replication_mode(repl_attr)?
    let compression = parse_compression_settings(repl_attr)?
    Result::Ok(ReplicatedPropertyIR { name: (*field).name.clone(), cpp_type: cpp_type, mode: mode, compression: compression })

@doc(doc = " Parse replication mode from @replicated attribute")
@doc(doc = "")
@doc(doc = " Supported formats:")
@doc(doc = " - @replicated - defaults to Simple")
@doc(doc = " - @replicated(mode: Simple)")
@doc(doc = " - @replicated(mode: Interpolated, back_time: 0.1, buffer_size: 32)")
@doc(doc = " - @replicated(mode: Extrapolated, limit: 100.0)")
@doc(doc = " - @replicated(mode: Compressed, threshold: 0.01, use_half_float: true)")
fn parse_replication_mode(attr: &kain_core::ast::Attribute) -> Result<ReplicationModeIR, String>:
    let mode_arg = (*attr).args.iter().find(fn(arg): none)
    let mode_name = match mode_arg:
        Some(arg) => extract_mode_name(arg)?
        _ => ("Simple").to_string()
    match mode_name.as_str():
        "Simple" => Result::Ok(ReplicationModeIR__Simple)
        "Interpolated" =>
            let back_time = extract_float_param(attr, "back_time").unwrap_or(0.1)
            let buffer_size = extract_int_param(attr, "buffer_size").unwrap_or(32)
            Result::Ok(ReplicationModeIR::Interpolated { back_time: back_time, buffer_size: buffer_size as usize })
        "Extrapolated" =>
            let limit = extract_float_param(attr, "limit").unwrap_or(100)
            Result::Ok(ReplicationModeIR::Extrapolated { limit: limit })
        "Compressed" =>
            let threshold = extract_float_param(attr, "threshold").unwrap_or(0.01)
            let use_half_float = extract_bool_param(attr, "use_half_float").unwrap_or(false)
            Result::Ok(ReplicationModeIR::Compressed { threshold: threshold, use_half_float: use_half_float })
        _ => Result::Err(f"Unknown replication mode: {mode_name}")

@doc(doc = " Parse optional compression settings from attribute")
fn parse_compression_settings(attr: &kain_core::ast::Attribute) -> Result<Option<CompressionSettingsIR>, String>:
    let has_compression = (*attr).args.iter().any(fn(arg): none)
    if (!has_compression):
        return Result::Ok(none)
    let threshold = extract_float_param(attr, "threshold").unwrap_or(0.01)
    let quantize = extract_bool_param(attr, "quantize").unwrap_or(false)
    let quantize_bits = extract_int_param(attr, "quantize_bits").unwrap_or(8) as u8
    Result::Ok(Option::Some(CompressionSettingsIR { threshold: threshold, quantize: quantize, quantize_bits: quantize_bits }))

@doc(doc = " Extract network configuration from component attributes")
fn extract_network_config(attributes: &[kain_core::ast::Attribute]) -> Result<NetworkConfigIR, String>:
    let mut config = NetworkConfigIR__default_()
    match find_attribute(attributes, "network_config"):
        Some(attr) =>
            match extract_float_param(attr, "snap_threshold"):
                Some(snap) =>
                    config.snap_threshold = snap
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match extract_float_param(attr, "send_rate"):
                Some(rate) =>
                    config.send_rate = rate
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match extract_bool_param(attr, "owner_time_sync"):
                Some(sync) =>
                    config.owner_time_sync = sync
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match extract_bool_param(attr, "optimize_bandwidth"):
                Some(opt) =>
                    config.optimize_bandwidth = opt
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    Result::Ok(config)

@doc(doc = " Find an attribute by name")
fn find_attribute<a>(attributes: &a [kain_core::ast::Attribute], name: String) -> Option<&a kain_core::ast::Attribute>:
    attributes.iter().find(fn(attr): (attr.name == name))

@doc(doc = " Extract mode name from binary expression (mode: ModeName)")
fn extract_mode_name(expr: &kain_core::ast::Expr) -> Result<String, String>:
    use kain_core::ast::Expr

    match expr:
        kain_core__ast__Expr::Binary { op: op, right: right } =>
            if ((*op) == kain_core__ast__BinaryOp__Assign):
                match &(*(*right)):
                    kain_core__ast__Expr::Ident(name, _) => return Result::Ok(name.clone())
                    _ =>
                        ()
                        ()
                ()
            ()
        _ =>
            ()
            ()
    Result::Err(("Invalid mode specification").to_string())

@doc(doc = " Extract float parameter from attribute arguments")
fn extract_float_param(attr: &kain_core::ast::Attribute, param_name: String) -> Option<f32>:
    use kain_core::ast::Expr

    for arg in &(*attr).args:
        match arg:
            kain_core__ast__Expr::Binary { op: op, left: left, right: right } =>
                if ((*op) == kain_core__ast__BinaryOp__Assign):
                    match &(*(*left)):
                        kain_core__ast__Expr::Ident(name, _) =>
                            if (name == param_name):
                                match &(*(*right)):
                                    kain_core__ast__Expr::Float(val, _) => return Option::Some((*val) as f32)
                                    _ =>
                                        ()
                                        ()
                                match &(*(*right)):
                                    kain_core__ast__Expr::Int(val, _) => return Option::Some((*val) as f32)
                                    _ => ()
                        _ => ()
            _ => ()
    ()
    none

@doc(doc = " Extract integer parameter from attribute arguments")
fn extract_int_param(attr: &kain_core::ast::Attribute, param_name: String) -> Option<i64>:
    use kain_core::ast::Expr

    for arg in &(*attr).args:
        match arg:
            kain_core__ast__Expr::Binary { op: op, left: left, right: right } =>
                if ((*op) == kain_core__ast__BinaryOp__Assign):
                    match &(*(*left)):
                        kain_core__ast__Expr::Ident(name, _) =>
                            if (name == param_name):
                                match &(*(*right)):
                                    kain_core__ast__Expr::Int(val, _) => return Option::Some((*val))
                                    _ => ()
                        _ => ()
            _ => ()
    ()
    none

@doc(doc = " Extract boolean parameter from attribute arguments")
fn extract_bool_param(attr: &kain_core::ast::Attribute, param_name: String) -> Option<Bool>:
    use kain_core::ast::Expr

    for arg in &(*attr).args:
        match arg:
            kain_core__ast__Expr::Binary { op: op, left: left, right: right } =>
                if ((*op) == kain_core__ast__BinaryOp__Assign):
                    match &(*(*left)):
                        kain_core__ast__Expr::Ident(name, _) =>
                            if (name == param_name):
                                match &(*(*right)):
                                    kain_core__ast__Expr::Bool(val, _) => return Option::Some((*val))
                                    _ =>
                                        ()
                                        ()
                                match &(*(*right)):
                                    kain_core__ast__Expr::Ident(val, _) =>
                                        match val.as_str():
                                            "true" => return Option::Some(true)
                                            "false" => return Option::Some(false)
                                            _ => ()
                                    _ => ()
                        _ => ()
            _ => ()
    ()
    none

