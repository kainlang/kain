impl Default for FabricManifest:
    fn default_() -> FabricManifest:
        polyglot_manifest_template()


impl Default for FabricWorkspace:
    fn default_() -> FabricWorkspace:
        FabricWorkspace { root: default_workspace_root(), search_roots: [PathBuf__from("src"), PathBuf__from("scripts"), PathBuf__from("native")] }


impl Default for FabricReportConfig:
    fn default_() -> FabricReportConfig:
        FabricReportConfig { directory: default_report_directory(), emit_jsonl_events: true }


pub fn init_fabric_manifest(root: &std::path::Path, template_: FabricTemplateKind) -> OmniResult<FabricInitResult>:
    std__fs__create_dir_all(root)?
    ()
    let manifest = match template_:
        FabricTemplateKind::Local => local_manifest_template()
        FabricTemplateKind::Polyglot => polyglot_manifest_template()
    let manifest_path = root.join(FABRIC_MANIFEST_FILE_NAME)
    std__fs__write(&manifest_path, toml__to_string_pretty(&manifest)?)?
    ()
    let mut created_paths = [manifest_path.clone()]
    match template_:
        FabricTemplateKind::Local =>
            let src_dir = root.join("src")
            std__fs__create_dir_all(&src_dir)?
            ()
            let kain_entry = src_dir.join("main.kn")
            write_if_missing(&kain_entry, "fn main() -> String:\n    return \"kain-fabric-local\"\n")?
            ()
            created_paths.push(kain_entry)
            ()
            ()
            ()
            ()
        FabricTemplateKind::Polyglot =>
            let src_dir = root.join("src")
            let scripts_dir = root.join("scripts")
            let native_dir = root.join("native")
            let local_crate_dir = root.join("local_crate")
            let local_crate_src_dir = local_crate_dir.join("src")
            std__fs__create_dir_all(&src_dir)?
            ()
            std__fs__create_dir_all(&scripts_dir)?
            ()
            std__fs__create_dir_all(&native_dir)?
            ()
            std__fs__create_dir_all(&local_crate_src_dir)?
            ()
            let kain_entry = src_dir.join("main.kn")
            write_if_missing(&kain_entry, POLYGLOT_KAIN_ENTRY)?
            ()
            created_paths.push(kain_entry)
            ()
            let python_step = scripts_dir.join("python_step.py")
            write_if_missing(&python_step, POLYGLOT_PYTHON_STEP)?
            ()
            created_paths.push(python_step)
            ()
            let node_step = scripts_dir.join("node_step.mjs")
            write_if_missing(&node_step, POLYGLOT_NODE_STEP)?
            ()
            created_paths.push(node_step)
            ()
            let rust_entry = src_dir.join("rust_step.kn")
            write_if_missing(&rust_entry, POLYGLOT_RUST_ENTRY)?
            ()
            created_paths.push(rust_entry)
            ()
            let native_entry = src_dir.join("native_step.kn")
            write_if_missing(&native_entry, POLYGLOT_NATIVE_ENTRY)?
            ()
            created_paths.push(native_entry)
            ()
            let kain_manifest = root.join("KAIN.toml")
            write_if_missing(&kain_manifest, &render_polyglot_kain_manifest())?
            ()
            created_paths.push(kain_manifest)
            ()
            let local_crate_manifest = local_crate_dir.join("Cargo.toml")
            write_if_missing(&local_crate_manifest, POLYGLOT_LOCAL_CRATE_MANIFEST)?
            ()
            created_paths.push(local_crate_manifest)
            ()
            let local_crate_lib = local_crate_src_dir.join("lib.rs")
            write_if_missing(&local_crate_lib, POLYGLOT_LOCAL_CRATE_LIB)?
            ()
            created_paths.push(local_crate_lib)
            ()
            let native_header = native_dir.join("image_fx.h")
            write_if_missing(&native_header, POLYGLOT_NATIVE_HEADER)?
            ()
            created_paths.push(native_header)
            ()
            let native_source = native_dir.join("image_fx.c")
            write_if_missing(&native_source, POLYGLOT_NATIVE_SOURCE)?
            ()
            created_paths.push(native_source)
            ()
            let readme = root.join("FABRIC.README.md")
            write_if_missing(&readme, &render_polyglot_readme())?
            ()
            created_paths.push(readme)
            ()
            ()
            ()
            ()
    created_paths.sort()
    ()
    created_paths.dedup()
    ()
    Result::Ok(FabricInitResult { manifest_path: manifest_path, created_paths: created_paths })

pub fn load_fabric_manifest(path: &std::path::Path) -> OmniResult<FabricManifest>:
    let content = std__fs__read_to_string(path)?
    Result::Ok(toml__from_str(&content)?)

pub fn validate_fabric_manifest_path(path: &std::path::Path) -> OmniResult<FabricValidationResult>:
    let manifest = load_fabric_manifest(path)?
    validate_fabric_manifest(path, &manifest)

pub fn validate_fabric_manifest(manifest_path: &std::path::Path, manifest: &FabricManifest) -> OmniResult<FabricValidationResult>:
    if ((*manifest).version != FABRIC_SCHEMA_VERSION):
        return Result::Err(OmniError::Config(f"Fabric manifest version {(*manifest).version} is not supported. Expected {FABRIC_SCHEMA_VERSION}"))
    if (*manifest).steps.is_empty():
        return Result::Err(OmniError::Config(("Fabric manifest must declare at least one step").to_string()))
    let mut ids = BTreeSet__new_()
    let mut runtime_counts = BTreeMap__new_()
    let mut required_capabilities = BTreeSet__new_()
    let supported_capabilities = supported_local_fabric_capabilities()
    for requirement in &(*manifest).requires:
        validate_capability_requirement(requirement, &supported_capabilities)?
        ()
        required_capabilities.insert(requirement.key.clone())
        ()
    ()
    for step in &(*manifest).steps:
        let trimmed_id = step.id.trim()
        if trimmed_id.is_empty():
            return Result::Err(OmniError::Config(("Fabric steps must have a non-empty id").to_string()))
        if (!ids.insert(trimmed_id.to_string())):
            return Result::Err(OmniError::Config(f"Fabric step id '{trimmed_id}' is duplicated"))
        validate_step_shape(step)?
        ()
        (*runtime_counts.entry(step.runtime.display_name().to_string()).or_insert(0)) = ((*runtime_counts.entry(step.runtime.display_name().to_string()).or_insert(0)) + 1)
        ()
        required_capabilities.insert(step.runtime.implied_capability_key().to_string())
        ()
        for requirement in &step.requires:
            validate_capability_requirement(requirement, &supported_capabilities)?
            ()
            required_capabilities.insert(requirement.key.clone())
            ()
        ()
        for output in &step.outputs:
            required_capabilities.insert(output.kind.implied_capability_key().to_string())
            ()
    ()
    for step in &(*manifest).steps:
        for dependency in &step.depends_on:
            if (!ids.contains(dependency)):
                return Result::Err(OmniError::Config(f"Fabric step '{step.id}' depends on unknown step '{dependency}'"))
            if (dependency == &step.id):
                return Result::Err(OmniError::Config(f"Fabric step '{step.id}' cannot depend on itself"))
    ()
    detect_dependency_cycles(&(*manifest).steps)?
    ()
    Result::Ok(FabricValidationResult { manifest_path: manifest_path.to_path_buf(), step_count: (*manifest).steps.len(), runtime_counts: runtime_counts, required_capabilities: required_capabilities.into_iter().collect() })

pub fn detect_dependency_cycles(steps: &[FabricStep]) -> OmniResult<()>:
    enum VisitState:
        Visiting
        Done

    fn visit(step_id: String, graph: &Map<String, Array<String>>, states: &mut Map<String, VisitState>, stack: &mut Array<String>) -> OmniResult<()>:
        match states.get(step_id).copied():
            Some(state_) =>
                if (state_ == VisitState__Done):
                    return Result::Ok(())
                if (state_ == VisitState__Visiting):
                    stack.push(step_id.to_string())
                    ()
                    return Result::Err(OmniError::Config("Fabric dependency cycle detected: {stack.join(\" -> \")}"))
                ()
            _ =>
                ()
                ()
        states.insert(step_id.to_string(), VisitState__Visiting)
        ()
        stack.push(step_id.to_string())
        ()
        match graph.get(step_id):
            Some(dependencies) =>
                for dependency in dependencies:
                    visit(dependency, graph, states, stack)?
                    ()
                ()
                ()
            _ =>
                ()
                ()
        stack.pop()
        ()
        states.insert(step_id.to_string(), VisitState__Done)
        ()
        Result::Ok(())

    let graph = steps.iter().map(fn(step): (step.id.clone(), step.depends_on.clone())).collect()
    let mut states = BTreeMap__new_()
    let mut stack = Vec__new_()
    for step in steps:
        visit(&step.id, &graph, &mut states, &mut stack)?
        ()
    ()
    Result::Ok(())

pub fn topological_step_order(steps: &[FabricStep]) -> OmniResult<Array<String>>:
    let mut in_degree = steps.iter().map(fn(step): (step.id.clone(), step.depends_on.len())).collect()
    let mut dependents = BTreeMap__new_()
    for step in steps:
        for dependency in &step.depends_on:
            dependents.entry(dependency.clone()).or_default().push(step.id.clone())
            ()
    ()
    let mut ready = in_degree.iter().filter(fn(__kain_closure_arg0): ((*(*__kain_closure_arg0.__kain_tuple_1)) == 0)).map(fn(__kain_closure_arg1): __kain_closure_arg1.__kain_tuple_0.clone()).collect()
    let mut ordered = (fn(__kain_ctor_arg0): Vec__new_())(steps.len())
    loop:
        match ready.iter().next().cloned():
            Some(next_id) =>
                ready.remove(&next_id)
                ()
                ordered.push(next_id.clone())
                ()
                match dependents.get(&next_id):
                    Some(children) =>
                        for child in children:
                            let Some(count) = in_degree.get_mut(child)
                            (*count) = count.saturating_sub(1)
                            ()
                            if ((*count) == 0):
                                ready.insert(child.clone())
                                ()
                    _ => ()
            _ => break
    ()
    if (ordered.len() != steps.len()):
        return Result::Err(OmniError::Config(("Fabric execution order could not be resolved").to_string()))
    Result::Ok(ordered)

pub fn supported_local_fabric_capabilities() -> Set<String>:
    (["session.local", "runtime.kain", "runtime.python", "runtime.rust-crate", "runtime.c-abi", "runtime.node", "runtime.gpu-compute", "contract.value", "contract.shared-buffer", "contract.shared-image", "contract.compute-plan"]).into_iter().map(str__to_string).collect()

pub fn resolve_fabric_path(base: &std::path::Path, path: &std::path::Path) -> std::path::PathBuf:
    if path.is_absolute():
        path.to_path_buf()
    else:
        base.join(path)

pub fn write_fabric_json<T>(path: &std::path::Path, value: &T) -> OmniResult<()>:
    let encoded = serde_json__to_string_pretty(value).map_err(fn(err): OmniError::Config(f"Failed to serialize Fabric artifact: {err}"))?
    std__fs__write(path, encoded)?
    ()
    Result::Ok(())

pub fn unix_timestamp_ms() -> u128:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).map(fn(duration): duration.as_millis()).unwrap_or(0)

fn validate_capability_requirement(requirement: &FabricCapabilityRequirement, supported_capabilities: &Set<String>) -> OmniResult<()>:
    let key = (*requirement).key.trim()
    if key.is_empty():
        return Result::Err(OmniError::Config(("Fabric capability keys must be non-empty").to_string()))
    if (!supported_capabilities.contains(key)):
        return Result::Err(OmniError::Config(f"Fabric capability '{key}' is not supported by the current local validator"))
    Result::Ok(())

fn validate_step_shape(step: &FabricStep) -> OmniResult<()>:
    match (*step).runtime:
        FabricRuntimeKind::Kain =>
            if (*step).entry.is_none():
                return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' with runtime 'kain' must declare 'entry'"))
            ()
        FabricRuntimeKind::Python =>
            if ((*step).entry.is_none() && (*step).module.is_none_or(fn(value): value.trim().is_empty())):
                return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' with runtime '{(*step).runtime.display_name()}' must declare 'entry' or 'module'"))
            ()
        FabricRuntimeKind::Node =>
            if ((*step).entry.is_none() && (*step).module.is_none_or(fn(value): value.trim().is_empty())):
                return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' with runtime '{(*step).runtime.display_name()}' must declare 'entry' or 'module'"))
            ()
        FabricRuntimeKind::RustCrate =>
            if (*step).crate_name.is_none_or(fn(value): value.trim().is_empty()):
                return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' with runtime 'rust_crate' must declare 'crate_name'"))
            if (*step).entry.is_none():
                return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' with runtime 'rust_crate' must declare 'entry' so kain-host can run local glue against the imported crate"))
            ()
        FabricRuntimeKind::CAbi =>
            if (*step).library.is_none():
                return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' with runtime 'c_abi' must declare 'library'"))
            if (*step).entry.is_none():
                return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' with runtime 'c_abi' must declare 'entry' so kain-host can run local glue against the imported library"))
            ()
        FabricRuntimeKind::GpuCompute =>
            if (*step).shader_source.is_none():
                return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' with runtime 'gpu_compute' must declare 'shader_source' pointing to a .kn shader file"))
            if (*step).compute_key.is_none_or(fn(k): k.trim().is_empty()):
                return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' with runtime 'gpu_compute' must declare 'compute_key'"))
            ()
    for output in &(*step).outputs:
        if output.name.trim().is_empty():
            return Result::Err(OmniError::Config(f"Fabric step '{(*step).id}' has an output with an empty name"))
    ()
    Result::Ok(())

fn write_if_missing(path: &std::path::Path, content: String) -> OmniResult<()>:
    if (!path.exists()):
        std__fs__write(path, content)?
        ()
        ()
        ()
        ()
    Result::Ok(())

fn default_fabric_schema_version() -> u32:
    FABRIC_SCHEMA_VERSION

fn default_workspace_root() -> std::path::PathBuf:
    PathBuf__from(".")

fn default_capability_version() -> u32:
    1

fn default_report_directory() -> std::path::PathBuf:
    PathBuf__from(".kain/fabric/reports")

const POLYGLOT_PYTHON_STEP: String = "def run(fabric_inputs):\n    return {\n        \"width\": 6,\n        \"height\": 4,\n        \"accent\": 29,\n        \"title\": \"fabric-local\",\n    }\n"

const POLYGLOT_NODE_STEP: String = "export function run(fabricInputs) {\n  const report = fabricInputs.kain_orchestrator.report;\n  const analysis = fabricInputs.rust_analyzer.analysis;\n  const image = fabricInputs.native_filter.filtered_image;\n  const snapshot = fabricInputs.native_filter.snapshot;\n  return [\n    \"<article data-fabric='local-first'>\",\n    `<h1>${analysis}</h1>`,\n    `<p>${report}</p>`,\n    `<p>image=${image.width}x${image.height} channels=${image.channels}</p>`,\n    `<p>snapshot-bytes=${snapshot.byte_length}</p>`,\n    \"</article>\",\n  ].join(\"\");\n}\n"

const POLYGLOT_KAIN_ENTRY: String = "use std::interop::bridge\n\nstruct KainOutputs:\n    image: Any\n    report: String\n\nfn build_pixels(width: Int, height: Int, accent: Int) -> Array<Int>:\n    let bytes = []\n    let y = 0\n    while y < height:\n        let x = 0\n        while x < width:\n            let base = (x * 17 + y * 23 + accent) % 255\n            bytes.push(base)\n            bytes.push((base + accent) % 255)\n            bytes.push((base + x + y) % 255)\n            bytes.push(255)\n            x = x + 1\n        y = y + 1\n    return bytes\n\nfn main() -> KainOutputs:\n    let settings = fabric_inputs.python_source.settings\n    let width = settings.width\n    let height = settings.height\n    let accent = settings.accent\n    let pixels = build_pixels(width, height, accent)\n    let image = interop_shared_image_from_bytes(\n        pixels,\n        width,\n        height,\n        4,\n        \"HWC\",\n        \"rgba8\",\n        \"image/x-kain-raster\",\n    )\n    let info = interop_shared_image_info(image)\n    let report = settings.title + \":\" + str(info.width) + \"x\" + str(info.height) + \":\" + str(accent)\n    return KainOutputs { image: image, report: report }\n"

const POLYGLOT_NATIVE_ENTRY: String = "use c::image_fx\nuse std::interop::bridge\n\nstruct NativeOutputs:\n    filtered_image: Any\n    snapshot: Any\n\nfn main() -> NativeOutputs:\n    let image = fabric_inputs.kain_orchestrator.image\n    let info = interop_shared_image_info(image)\n    let before_bytes = interop_shared_image_bytes(image)\n    let before_first_channel = before_bytes[0]\n    imagefx_halo_rgba(image, info.byte_length, 37)\n    let after_bytes = interop_shared_image_bytes(image)\n    assert(\n        before_first_channel != after_bytes[0],\n        \"expected native image filter to mutate the shared image\"\n    )\n    let bytes = interop_shared_image_bytes(image)\n    let snapshot = interop_shared_buffer_from_bytes(\n        bytes,\n        \"u8\",\n        [len(bytes)],\n        \"rgba8\",\n        \"application/octet-stream\",\n    )\n    return NativeOutputs { filtered_image: image, snapshot: snapshot }\n"

const POLYGLOT_RUST_ENTRY: String = "use rust::fabric_runtime_lab\nuse std::interop::bridge\n\nfn main() -> String:\n    let snapshot = fabric_inputs.native_filter.snapshot\n    let snapshot_info = interop_shared_buffer_info(snapshot)\n    let bytes = interop_shared_buffer_bytes(snapshot)\n    let checksum = buffer_checksum(bytes)\n    return analysis_label(\n        snapshot_info.byte_length,\n        checksum,\n        fabric_inputs.kain_orchestrator.report,\n    )\n"

const POLYGLOT_LOCAL_CRATE_MANIFEST: String = "[package]\nname = \"fabric_runtime_lab\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\nname = \"fabric_runtime_lab\"\npath = \"src/lib.rs\"\n\n[workspace]\n"

const POLYGLOT_LOCAL_CRATE_LIB: String = "pub fn buffer_checksum(bytes: Vec<i64>) -> i64 {\n    let mut total = 0i64;\n    for (index, value) in bytes.iter().enumerate() {\n        let weight = ((index as i64) % 19) + 3;\n        total = (total + value * weight + index as i64) % 1_000_003;\n    }\n    total\n}\n\npub fn analysis_label(byte_length: i64, checksum: i64, upstream_report: String) -> String {\n    format!(\n        \"rust-analysis:{}:checksum={}:{}\",\n        byte_length, checksum, upstream_report\n    )\n}\n"

const POLYGLOT_NATIVE_HEADER: String = "#if defined(_WIN32)\n#define IMAGEFX_EXPORT __declspec(dllexport)\n#else\n#define IMAGEFX_EXPORT\n#endif\n\n#include <stddef.h>\n#include <stdint.h>\n\nIMAGEFX_EXPORT uint64_t imagefx_checksum(const uint8_t* pixels, size_t len);\nIMAGEFX_EXPORT void imagefx_halo_rgba(uint8_t* pixels, size_t len, int accent);\nIMAGEFX_EXPORT const char* imagefx_signature(int width, int height, uint64_t checksum);\n"

const POLYGLOT_NATIVE_SOURCE: String = "#include \"image_fx.h\"\n\n#include <stdio.h>\n\nstatic char G_SIGNATURE[128];\n\nuint64_t imagefx_checksum(const uint8_t* pixels, size_t len) {\n    uint64_t checksum = 1469598103934665603ull;\n    size_t index = 0;\n    while (index < len) {\n        checksum ^= (uint64_t)pixels[index];\n        checksum *= 1099511628211ull;\n        index += 1;\n    }\n    return checksum;\n}\n\nvoid imagefx_halo_rgba(uint8_t* pixels, size_t len, int accent) {\n    size_t index = 0;\n    while (index + 3 < len) {\n        pixels[index + 0] = (uint8_t)((pixels[index + 0] + accent) % 255);\n        pixels[index + 1] = (uint8_t)((pixels[index + 1] + (accent / 2)) % 255);\n        pixels[index + 2] = (uint8_t)(255 - pixels[index + 2]);\n        pixels[index + 3] = 255;\n        index += 4;\n    }\n}\n\nconst char* imagefx_signature(int width, int height, uint64_t checksum) {\n    snprintf(\n        G_SIGNATURE,\n        sizeof(G_SIGNATURE),\n        \"imagefx:%dx%d:%llu\",\n        width,\n        height,\n        (unsigned long long)checksum\n    );\n    return G_SIGNATURE;\n}\n"

fn polyglot_native_compile_command() -> String:
    if cfg!(target_os = "windows"):
        "clang -shared -O2 native/image_fx.c -o native/image_fx.dll"
    elif cfg!(target_os = "macos"):
        "clang -shared -O2 native/image_fx.c -o native/libimage_fx.dylib"
    else:
        "clang -shared -O2 -fPIC native/image_fx.c -o native/libimage_fx.so"

fn render_polyglot_kain_manifest() -> String:
    ("[c_ffi]\n\n[[c_ffi.libraries]]\nname = \"image_fx\"\nheader = \"native/image_fx.h\"\nshared_lib = \"native/${kain_dynlib:image_fx}\"\n").to_string()

fn render_polyglot_readme() -> String:
    f"# Fabric Polyglot Starter\n\nThis scaffold mirrors `smoketest/fabric/polyglot_local` and is meant to be runnable as a local-first proof, not just a validation example.\n\n## Pipeline Shape\n\n- `python_source` produces settings\n- `kain_orchestrator` builds a shared image and report\n- `native_filter` mutates the shared image and snapshots bytes through the C ABI lane\n- `rust_analyzer` computes a report from the shared buffer snapshot\n- `node_packager` renders the final HTML bundle\n\n## Quickstart\n\n1. Build the native library:\n   `{polyglot_native_compile_command()}`\n2. Validate the manifest:\n   `kain fabric validate --manifest KAIN.fabric.toml`\n3. Run the pipeline:\n   `kain fabric run --manifest KAIN.fabric.toml`\n\nFabric reports land under `.kain/fabric/reports/<session>/` with `report.json`, `session.lock.json`, and `events.jsonl`.\n"

fn local_manifest_template() -> FabricManifest:
    FabricManifest { version: FABRIC_SCHEMA_VERSION, workspace: FabricWorkspace { root: PathBuf__from("."), search_roots: [PathBuf__from("src")] }, requires: [FabricCapabilityRequirement { key: ("session.local").to_string(), version: 1, optional: false }], steps: [FabricStep { id: ("main").to_string(), runtime: FabricRuntimeKind__Kain, entry: Option::Some(PathBuf__from("src/main.kn")), module: none, crate_name: none, manifest_path: none, library: none, shader_source: none, compute_key: none, depends_on: Vec__new_(), requires: Vec__new_(), outputs: [FabricOutputBinding { name: ("result").to_string(), kind: FabricContractKind__Value }] }], reports: FabricReportConfig__default_() }

fn polyglot_manifest_template() -> FabricManifest:
    FabricManifest { version: FABRIC_SCHEMA_VERSION, workspace: FabricWorkspace { root: PathBuf__from("."), search_roots: [PathBuf__from("src"), PathBuf__from("scripts"), PathBuf__from("native"), PathBuf__from("local_crate")] }, requires: [FabricCapabilityRequirement { key: ("session.local").to_string(), version: 1, optional: false }], steps: [FabricStep { id: ("python_source").to_string(), runtime: FabricRuntimeKind__Python, entry: Option::Some(PathBuf__from("scripts/python_step.py")), module: none, crate_name: none, manifest_path: none, library: none, shader_source: none, compute_key: none, depends_on: Vec__new_(), requires: Vec__new_(), outputs: [FabricOutputBinding { name: ("settings").to_string(), kind: FabricContractKind__Value }] }, FabricStep { id: ("kain_orchestrator").to_string(), runtime: FabricRuntimeKind__Kain, entry: Option::Some(PathBuf__from("src/main.kn")), module: none, crate_name: none, manifest_path: none, library: none, shader_source: none, compute_key: none, depends_on: [("python_source").to_string()], requires: Vec__new_(), outputs: [FabricOutputBinding { name: ("image").to_string(), kind: FabricContractKind__SharedImage }, FabricOutputBinding { name: ("report").to_string(), kind: FabricContractKind__Value }] }, FabricStep { id: ("native_filter").to_string(), runtime: FabricRuntimeKind__CAbi, entry: Option::Some(PathBuf__from("src/native_step.kn")), module: Option::Some(("image_fx").to_string()), crate_name: none, manifest_path: none, library: Option::Some(PathBuf__from("native/${kain_dynlib:image_fx}")), shader_source: none, compute_key: none, depends_on: [("kain_orchestrator").to_string()], requires: Vec__new_(), outputs: [FabricOutputBinding { name: ("filtered_image").to_string(), kind: FabricContractKind__SharedImage }, FabricOutputBinding { name: ("snapshot").to_string(), kind: FabricContractKind__SharedBuffer }] }, FabricStep { id: ("rust_analyzer").to_string(), runtime: FabricRuntimeKind__RustCrate, entry: Option::Some(PathBuf__from("src/rust_step.kn")), module: none, crate_name: Option::Some(("fabric_runtime_lab").to_string()), manifest_path: Option::Some(PathBuf__from("local_crate/Cargo.toml")), library: none, shader_source: none, compute_key: none, depends_on: [("native_filter").to_string(), ("kain_orchestrator").to_string()], requires: Vec__new_(), outputs: [FabricOutputBinding { name: ("analysis").to_string(), kind: FabricContractKind__Value }] }, FabricStep { id: ("node_packager").to_string(), runtime: FabricRuntimeKind__Node, entry: Option::Some(PathBuf__from("scripts/node_step.mjs")), module: none, crate_name: none, manifest_path: none, library: none, shader_source: none, compute_key: none, depends_on: [("kain_orchestrator").to_string(), ("native_filter").to_string(), ("rust_analyzer").to_string()], requires: Vec__new_(), outputs: [FabricOutputBinding { name: ("html_bundle").to_string(), kind: FabricContractKind__Value }] }], reports: FabricReportConfig__default_() }

