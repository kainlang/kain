use std::collections::BTreeMap

use std::collections::BTreeSet

use std::fs

use std::path::Path

use std::path::PathBuf

use std::str::FromStr

use std::time::SystemTime

use std::time::UNIX_EPOCH

use serde::Deserialize

use serde::Serialize

use serde_json::Value as JsonValue

use crate::OmniError

use crate::OmniResult

pub const FABRIC_MANIFEST_FILE_NAME: String = "KAIN.fabric.toml"

const FABRIC_SCHEMA_VERSION: u32 = 1

pub enum FabricTemplateKind:
    Local
    Polyglot

impl std::str::FromStr for FabricTemplateKind:
    fn from_str(value: String) -> Result<FabricTemplateKind, Self_::Err>:
        match value.trim().to_ascii_lowercase().as_str():
            "local" => Result::Ok(FabricTemplateKind__Local)
            "polyglot" => Result::Ok(FabricTemplateKind__Polyglot)
            "default" => Result::Ok(FabricTemplateKind__Polyglot)
            other => Result::Err(OmniError::Config(f"unknown Fabric template '{other}'. expected 'local' or 'polyglot'"))


@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct FabricManifest:
    version: u32
    workspace: FabricWorkspace
    requires: Array<FabricCapabilityRequirement>
    steps: Array<FabricStep>
    reports: FabricReportConfig

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct FabricWorkspace:
    root: std::path::PathBuf
    search_roots: Array<std::path::PathBuf>

pub enum FabricRuntimeKind:
    Kain
    Python
    RustCrate
    CAbi
    Node
    GpuCompute

impl FabricRuntimeKind:
    pub fn implied_capability_key(_self: &FabricRuntimeKind) -> String:
        match *_self:
            FabricRuntimeKind::Kain => "runtime.kain"
            FabricRuntimeKind::Python => "runtime.python"
            FabricRuntimeKind::RustCrate => "runtime.rust-crate"
            FabricRuntimeKind::CAbi => "runtime.c-abi"
            FabricRuntimeKind::Node => "runtime.node"
            FabricRuntimeKind::GpuCompute => "runtime.gpu-compute"

    pub fn display_name(_self: &FabricRuntimeKind) -> String:
        match *_self:
            FabricRuntimeKind::Kain => "kain"
            FabricRuntimeKind::Python => "python"
            FabricRuntimeKind::RustCrate => "rust_crate"
            FabricRuntimeKind::CAbi => "c_abi"
            FabricRuntimeKind::Node => "node"
            FabricRuntimeKind::GpuCompute => "gpu_compute"


@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct FabricCapabilityRequirement:
    key: String
    version: u32
    optional: Bool

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct FabricStep:
    id: String
    runtime: FabricRuntimeKind
    entry: Option<std::path::PathBuf>
    module: Option<String>
    crate_name: Option<String>
    manifest_path: Option<std::path::PathBuf>
    library: Option<std::path::PathBuf>
    shader_source: Option<std::path::PathBuf>
    compute_key: Option<String>
    depends_on: Array<String>
    requires: Array<FabricCapabilityRequirement>
    outputs: Array<FabricOutputBinding>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct FabricOutputBinding:
    name: String
    kind: FabricContractKind

pub enum FabricContractKind:
    SharedBuffer
    SharedImage
    Value
    ComputePlan

impl FabricContractKind:
    pub fn implied_capability_key(_self: &FabricContractKind) -> String:
        match *_self:
            FabricContractKind::SharedBuffer => "contract.shared-buffer"
            FabricContractKind::SharedImage => "contract.shared-image"
            FabricContractKind::Value => "contract.value"
            FabricContractKind::ComputePlan => "contract.compute-plan"


@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct FabricReportConfig:
    directory: std::path::PathBuf
    emit_jsonl_events: Bool

@derive(Debug, Clone)
pub struct FabricInitResult:
    manifest_path: std::path::PathBuf
    created_paths: Array<std::path::PathBuf>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct FabricValidationResult:
    manifest_path: std::path::PathBuf
    step_count: usize
    runtime_counts: Map<String, usize>
    required_capabilities: Array<String>

pub enum FabricSessionStatus:
    Succeeded
    Failed

pub enum FabricStepStatus:
    Pending
    Succeeded
    Failed
    Blocked

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
