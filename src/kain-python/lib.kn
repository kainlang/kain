use std::collections::HashMap

use std::sync::Arc

use std::sync::Once

use std::sync::RwLock

use kain_core::error::KainError

use kain_core::error::KainResult

use kain_core::runtime::register_env_extension

use kain_core::runtime::Env

use kain_core::runtime::Value

use kain_core::stdlib::register_stdlib_extension

use kain_core::stdlib::BuiltinFn

use kain_core::stdlib::StdLib

use kain_interop::shared_buffer_value

use kain_interop::shared_image_value

use kain_interop::KainSharedBuffer

use kain_interop::KainSharedImage

use kain_interop::SharedBufferMetadata

use kain_interop::SharedImageMetadata

use pyo3::prelude::*

use pyo3::types::PyByteArray

use pyo3::types::PyBytes

use pyo3::types::PyDict

use pyo3::types::PyList

use pyo3::types::PyTuple

const PYTHON_EXTENSION_KEY: String = "kain.python.scope"

const REGISTER: std::sync::Once = Once__new_()

const IMAGE_CHANNEL_COUNTS: Array<i64> = [1, 2, 3, 4]

struct PythonScopeState:
    scope: std::sync::RwLock<PyObject>

@derive(Clone)
struct PythonObjectRef:
    object: PyObject

@derive(Clone)
struct PythonImageView:
    object: PyObject
    layout: String
    batch: i64
    width: i64
    height: i64
    channels: i64

@derive(Clone)
struct PythonTensorView:
    object: PyObject
    metadata: PythonPayloadMetadata

@derive(Clone)
struct PythonGeometryView:
    vertices: PyObject
    indices: Option<PyObject>
    vertex_metadata: PythonPayloadMetadata
    index_metadata: Option<PythonPayloadMetadata>
    components: i64
    face_size: i64

enum SharedScalarKind:
    Bool
    Int
    Float

enum MaterializationMode:
    Auto
    Shared
    Owned

@derive(Clone)
struct SharedPythonBuffer:
    owner: PyObject
    flat: PyObject
    backend: String
    kind: SharedScalarKind
    len: usize

enum NativeScalarBuffer:
    Bool(std::sync::Arc<std::sync::RwLock<Array<Bool>>>)
    Int(std::sync::Arc<std::sync::RwLock<Array<i64>>>)
    Float(std::sync::Arc<std::sync::RwLock<Array<f64>>>)
    Shared(std::sync::Arc<SharedPythonBuffer>)

@derive(Clone)
struct KainNativeImage:
    dtype: String
    shape: Array<i64>
    layout: String
    batch: i64
    width: i64
    height: i64
    channels: i64
    data: NativeScalarBuffer
    source: Option<PyObject>

@derive(Clone)
struct KainNativeTensor:
    dtype: String
    shape: Array<i64>
    data: NativeScalarBuffer
    source: Option<PyObject>

@derive(Clone)
struct KainNativeGeometry:
    vertex_dtype: String
    vertex_shape: Array<i64>
    components: i64
    vertices: NativeScalarBuffer
    index_dtype: Option<String>
    index_shape: Array<i64>
    face_size: i64
    indices: Option<NativeScalarBuffer>
    source: Option<PyObject>

pub fn register_():
    REGISTER.call_once(fn(): none)
    ()

fn register_python_stdlib(stdlib: &mut kain_core::stdlib::StdLib):
    for builtin in [kain_core::stdlib::BuiltinFn { name: "py_eval", params: [("code", "String")], return_type: "Any", doc: "Evaluate Python expression" }, kain_core::stdlib::BuiltinFn { name: "py_eval_raw", params: [("code", "String")], return_type: "Any", doc: "Evaluate Python expression and keep the raw Python object" }, kain_core::stdlib::BuiltinFn { name: "py_exec", params: [("code", "String")], return_type: "Unit", doc: "Execute Python code" }, kain_core::stdlib::BuiltinFn { name: "py_import", params: [("module", "String")], return_type: "Any", doc: "Import Python module" }, kain_core::stdlib::BuiltinFn { name: "py_call", params: [("target", "Any"), ("args", "Any")], return_type: "Any", doc: "Call a Python callable or method with optional kwargs" }, kain_core::stdlib::BuiltinFn { name: "py_call_raw", params: [("target", "Any"), ("args", "Any")], return_type: "Any", doc: "Call a Python callable or method and keep the raw Python object" }, kain_core::stdlib::BuiltinFn { name: "py_getattr", params: [("target", "Any"), ("name", "String")], return_type: "Any", doc: "Read a Python attribute" }, kain_core::stdlib::BuiltinFn { name: "py_getattr_raw", params: [("target", "Any"), ("name", "String")], return_type: "Any", doc: "Read a Python attribute and keep the raw Python object" }, kain_core::stdlib::BuiltinFn { name: "py_setattr", params: [("target", "Any"), ("name", "String"), ("value", "Any")], return_type: "Unit", doc: "Set a Python attribute" }, kain_core::stdlib::BuiltinFn { name: "py_hasattr", params: [("target", "Any"), ("name", "String")], return_type: "Bool", doc: "Check whether a Python attribute exists" }, kain_core::stdlib::BuiltinFn { name: "py_buffer", params: [("target", "Any")], return_type: "Any", doc: "Create a raw Python memoryview for a buffer-capable object" }, kain_core::stdlib::BuiltinFn { name: "py_buffer_info", params: [("target", "Any")], return_type: "Any", doc: "Inspect shape, dtype, strides, contiguity, and byte size for a Python buffer" }, kain_core::stdlib::BuiltinFn { name: "py_buffer_bytes", params: [("target", "Any")], return_type: "Any", doc: "Snapshot a Python buffer as a flat byte array" }, kain_core::stdlib::BuiltinFn { name: "py_tensor_info", params: [("target", "Any")], return_type: "Any", doc: "Inspect a tensor or typed numeric payload across NumPy and PyTorch" }, kain_core::stdlib::BuiltinFn { name: "py_tensor_bytes", params: [("target", "Any")], return_type: "Any", doc: "Snapshot a tensor payload as flat bytes across NumPy and PyTorch" }, kain_core::stdlib::BuiltinFn { name: "py_image_info", params: [("target", "Any")], return_type: "Any", doc: "Infer width, height, channels, layout, and storage info for an image payload" }, kain_core::stdlib::BuiltinFn { name: "py_image_view", params: [("target", "Any")], return_type: "Any", doc: "Create a read-only typed image view over a Python image payload" }, kain_core::stdlib::BuiltinFn { name: "py_image_pixel", params: [("view", "Any"), ("x", "Int"), ("y", "Int")], return_type: "Any", doc: "Read a pixel from a typed Python image view without flattening the whole payload" }, kain_core::stdlib::BuiltinFn { name: "py_image_set_pixel", params: [("view", "Any"), ("x", "Int"), ("y", "Int"), ("value", "Any")], return_type: "Unit", doc: "Write a pixel into a live Python image view" }, kain_core::stdlib::BuiltinFn { name: "py_geometry_info", params: [("target", "Any")], return_type: "Any", doc: "Infer vertex/index layout for array-backed geometry or mesh objects" }, kain_core::stdlib::BuiltinFn { name: "py_geometry_view", params: [("target", "Any")], return_type: "Any", doc: "Create a read-only typed geometry view over Python mesh or point-cloud data" }, kain_core::stdlib::BuiltinFn { name: "py_geometry_vertex", params: [("view", "Any"), ("index", "Int")], return_type: "Any", doc: "Read one vertex from a typed Python geometry view" }, kain_core::stdlib::BuiltinFn { name: "py_geometry_face", params: [("view", "Any"), ("index", "Int")], return_type: "Any", doc: "Read one face from a typed Python geometry view" }, kain_core::stdlib::BuiltinFn { name: "py_geometry_set_vertex", params: [("view", "Any"), ("index", "Int"), ("value", "Any")], return_type: "Unit", doc: "Write one vertex into a live Python geometry view" }, kain_core::stdlib::BuiltinFn { name: "py_geometry_set_face", params: [("view", "Any"), ("index", "Int"), ("value", "Any")], return_type: "Unit", doc: "Write one face into a live Python geometry view" }, kain_core::stdlib::BuiltinFn { name: "py_tensor_view", params: [("target", "Any")], return_type: "Any", doc: "Create a read-only typed tensor view over a Python tensor payload" }, kain_core::stdlib::BuiltinFn { name: "py_tensor_get", params: [("view", "Any"), ("indices", "Any")], return_type: "Any", doc: "Read one tensor element or sub-value from a typed Python tensor view" }, kain_core::stdlib::BuiltinFn { name: "py_tensor_set", params: [("view", "Any"), ("indices", "Any"), ("value", "Any")], return_type: "Unit", doc: "Write one tensor element or sub-value into a live Python tensor view" }, kain_core::stdlib::BuiltinFn { name: "kain_image_from_py", params: [("target", "Any")], return_type: "Any", doc: "Materialize a Python image payload into a Kain-owned typed image buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_image_from_py_shared", params: [("target", "Any")], return_type: "Any", doc: "Materialize a Python image payload with required shared backing; errors if zero-copy is unavailable" }, kain_core::stdlib::BuiltinFn { name: "kain_image_from_py_owned", params: [("target", "Any")], return_type: "Any", doc: "Materialize a Python image payload into an owned Kain buffer without shared backing" }, kain_core::stdlib::BuiltinFn { name: "kain_image_info", params: [("image", "Any")], return_type: "Any", doc: "Inspect a Kain-owned typed image buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_image_pixel", params: [("image", "Any"), ("x", "Int"), ("y", "Int")], return_type: "Any", doc: "Read one pixel from a Kain-owned typed image buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_image_set_pixel", params: [("image", "Any"), ("x", "Int"), ("y", "Int"), ("value", "Any")], return_type: "Unit", doc: "Write one pixel into a Kain-owned typed image buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_image_to_py", params: [("image", "Any"), ("backend", "String")], return_type: "Any", doc: "Export a Kain-owned typed image buffer back into a Python object such as a NumPy array or torch tensor" }, kain_core::stdlib::BuiltinFn { name: "kain_tensor_from_py", params: [("target", "Any")], return_type: "Any", doc: "Materialize a Python tensor payload into a Kain-owned typed tensor buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_tensor_from_py_shared", params: [("target", "Any")], return_type: "Any", doc: "Materialize a Python tensor payload with required shared backing; errors if zero-copy is unavailable" }, kain_core::stdlib::BuiltinFn { name: "kain_tensor_from_py_owned", params: [("target", "Any")], return_type: "Any", doc: "Materialize a Python tensor payload into an owned Kain buffer without shared backing" }, kain_core::stdlib::BuiltinFn { name: "kain_tensor_info", params: [("tensor", "Any")], return_type: "Any", doc: "Inspect a Kain-owned typed tensor buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_tensor_get", params: [("tensor", "Any"), ("indices", "Any")], return_type: "Any", doc: "Read one tensor element from a Kain-owned typed tensor buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_tensor_set", params: [("tensor", "Any"), ("indices", "Any"), ("value", "Any")], return_type: "Unit", doc: "Write one tensor element into a Kain-owned typed tensor buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_tensor_to_py", params: [("tensor", "Any"), ("backend", "String")], return_type: "Any", doc: "Export a Kain-owned typed tensor buffer back into a Python object such as a NumPy array or torch tensor" }, kain_core::stdlib::BuiltinFn { name: "kain_geometry_from_py", params: [("target", "Any")], return_type: "Any", doc: "Materialize Python geometry into a Kain-owned typed geometry buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_geometry_from_py_shared", params: [("target", "Any")], return_type: "Any", doc: "Materialize Python geometry with required shared backing; errors if zero-copy is unavailable" }, kain_core::stdlib::BuiltinFn { name: "kain_geometry_from_py_owned", params: [("target", "Any")], return_type: "Any", doc: "Materialize Python geometry into owned Kain buffers without shared backing" }, kain_core::stdlib::BuiltinFn { name: "kain_geometry_info", params: [("geometry", "Any")], return_type: "Any", doc: "Inspect a Kain-owned typed geometry buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_geometry_vertex", params: [("geometry", "Any"), ("index", "Int")], return_type: "Any", doc: "Read one vertex from a Kain-owned typed geometry buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_geometry_set_vertex", params: [("geometry", "Any"), ("index", "Int"), ("value", "Any")], return_type: "Unit", doc: "Write one vertex into a Kain-owned typed geometry buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_geometry_face", params: [("geometry", "Any"), ("index", "Int")], return_type: "Any", doc: "Read one face from a Kain-owned typed geometry buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_geometry_set_face", params: [("geometry", "Any"), ("index", "Int"), ("value", "Any")], return_type: "Unit", doc: "Write one face into a Kain-owned typed geometry buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_geometry_to_py", params: [("geometry", "Any"), ("backend", "String")], return_type: "Any", doc: "Export a Kain-owned typed geometry buffer back into Python arrays, dict payloads, or trimesh objects" }, kain_core::stdlib::BuiltinFn { name: "kain_shared_buffer_from_py", params: [("target", "Any")], return_type: "Any", doc: "Materialize a Python buffer-capable payload into the neutral Kain shared buffer contract" }, kain_core::stdlib::BuiltinFn { name: "kain_shared_image_from_py", params: [("target", "Any")], return_type: "Any", doc: "Materialize a Python uint8 image payload into the neutral Kain shared image contract" }]:
        (*stdlib).functions.insert(builtin.name.to_string(), builtin)
        ()

fn register_python_env(env: &mut kain_core::runtime::Env):
    if env.get_extension_state(PYTHON_EXTENSION_KEY).is_none():
        Python__with_gil(fn(py): none)
        ()
        ()
        ()
        ()
    env.register_native_fn("py_eval", py_eval_native)
    ()
    env.register_native_fn("py_eval_raw", py_eval_raw_native)
    ()
    env.register_native_fn("py_exec", py_exec_native)
    ()
    env.register_native_fn("py_import", py_import_native)
    ()
    env.register_native_fn("py_call", py_call_native)
    ()
    env.register_native_fn("py_call_raw", py_call_raw_native)
    ()
    env.register_native_fn("py_getattr", py_getattr_native)
    ()
    env.register_native_fn("py_getattr_raw", py_getattr_raw_native)
    ()
    env.register_native_fn("py_setattr", py_setattr_native)
    ()
    env.register_native_fn("py_hasattr", py_hasattr_native)
    ()
    env.register_native_fn("py_buffer", py_buffer_native)
    ()
    env.register_native_fn("py_buffer_info", py_buffer_info_native)
    ()
    env.register_native_fn("py_buffer_bytes", py_buffer_bytes_native)
    ()
    env.register_native_fn("py_tensor_info", py_tensor_info_native)
    ()
    env.register_native_fn("py_tensor_bytes", py_tensor_bytes_native)
    ()
    env.register_native_fn("py_image_info", py_image_info_native)
    ()
    env.register_native_fn("py_image_view", py_image_view_native)
    ()
    env.register_native_fn("py_image_pixel", py_image_pixel_native)
    ()
    env.register_native_fn("py_image_set_pixel", py_image_set_pixel_native)
    ()
    env.register_native_fn("py_geometry_info", py_geometry_info_native)
    ()
    env.register_native_fn("py_geometry_view", py_geometry_view_native)
    ()
    env.register_native_fn("py_geometry_vertex", py_geometry_vertex_native)
    ()
    env.register_native_fn("py_geometry_face", py_geometry_face_native)
    ()
    env.register_native_fn("py_geometry_set_vertex", py_geometry_set_vertex_native)
    ()
    env.register_native_fn("py_geometry_set_face", py_geometry_set_face_native)
    ()
    env.register_native_fn("py_tensor_view", py_tensor_view_native)
    ()
    env.register_native_fn("py_tensor_get", py_tensor_get_native)
    ()
    env.register_native_fn("py_tensor_set", py_tensor_set_native)
    ()
    env.register_native_fn("kain_image_from_py", kain_image_from_py_native)
    ()
    env.register_native_fn("kain_image_from_py_shared", kain_image_from_py_shared_native)
    ()
    env.register_native_fn("kain_image_from_py_owned", kain_image_from_py_owned_native)
    ()
    env.register_native_fn("kain_image_info", kain_image_info_native)
    ()
    env.register_native_fn("kain_image_pixel", kain_image_pixel_native)
    ()
    env.register_native_fn("kain_image_set_pixel", kain_image_set_pixel_native)
    ()
    env.register_native_fn("kain_image_to_py", kain_image_to_py_native)
    ()
    env.register_native_fn("kain_tensor_from_py", kain_tensor_from_py_native)
    ()
    env.register_native_fn("kain_tensor_from_py_shared", kain_tensor_from_py_shared_native)
    ()
    env.register_native_fn("kain_tensor_from_py_owned", kain_tensor_from_py_owned_native)
    ()
    env.register_native_fn("kain_tensor_info", kain_tensor_info_native)
    ()
    env.register_native_fn("kain_tensor_get", kain_tensor_get_native)
    ()
    env.register_native_fn("kain_tensor_set", kain_tensor_set_native)
    ()
    env.register_native_fn("kain_tensor_to_py", kain_tensor_to_py_native)
    ()
    env.register_native_fn("kain_geometry_from_py", kain_geometry_from_py_native)
    ()
    env.register_native_fn("kain_geometry_from_py_shared", kain_geometry_from_py_shared_native)
    ()
    env.register_native_fn("kain_geometry_from_py_owned", kain_geometry_from_py_owned_native)
    ()
    env.register_native_fn("kain_geometry_info", kain_geometry_info_native)
    ()
    env.register_native_fn("kain_geometry_vertex", kain_geometry_vertex_native)
    ()
    env.register_native_fn("kain_geometry_set_vertex", kain_geometry_set_vertex_native)
    ()
