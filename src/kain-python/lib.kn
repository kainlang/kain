fn kain_image_to_py_native(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    let image = match args.as_slice():
        [image] => extract_native_image(image)?
        [image, kain_core__runtime__Value::String(_)] => extract_native_image(image)?
        _ => return Result::Err(KainError__runtime("kain_image_to_py: expected (image) or (image, backend)"))
    let backend = parse_optional_backend_arg("kain_image_to_py", &args, "numpy")?
    Python__with_gil(fn(py): wrap_python_object((export_native_image_pyobject(py, image, &backend)?).as_ref(py)))

fn kain_tensor_to_py_native(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    let tensor = match args.as_slice():
