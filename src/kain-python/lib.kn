fn shared_buffer_to_python_object(py: Python<_>, buffer: &kain_interop::KainSharedBuffer) -> Result<PyObject, KainError>:
    let dict = PyDict__new_(py)
    dict.set_item("contract", "kain.shared.buffer").map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
