fn python_contract_field<py>(target: &py PyAny, name: String) -> Option<&py PyAny>:
    match target.downcast():
        Ok(dict) => return dict.get_item(name).ok().flatten()
        _ =>
            ()
            ()
    target.getattr(name).ok()

fn python_contract_string(target: &PyAny, name: String) -> Result<Option<String>, KainError>:
    let Some(value) = python_contract_field(target, name)
    if value.is_none():
        return Result::Ok(none)
    value.extract().map(fn(__kain_closure_arg0): Option::Some(__kain_closure_arg0)).map_err(fn(err): KainError__runtime(f"shared contract field '{name}' must be a string: {err}"))

fn python_contract_int(target: &PyAny, name: String) -> Result<Option<i64>, KainError>:
    let Some(value) = python_contract_field(target, name)
    if value.is_none():
        return Result::Ok(none)
    value.extract().map(fn(__kain_closure_arg1): Option::Some(__kain_closure_arg1)).map_err(fn(err): KainError__runtime(f"shared contract field '{name}' must be an int: {err}"))

fn python_contract_int_list(target: &PyAny, name: String) -> Result<Option<Array<i64>>, KainError>:
    let Some(value) = python_contract_field(target, name)
    if value.is_none():
        return Result::Ok(none)
    value.extract().map(fn(__kain_closure_arg2): Option::Some(__kain_closure_arg2)).map_err(fn(err): KainError__runtime(f"shared contract field '{name}' must be a list of ints: {err}"))

fn python_contract_string_list(target: &PyAny, name: String) -> Result<Option<Array<String>>, KainError>:
