    env.register_native_fn("kain_shared_image_from_py", kain_shared_image_from_py_native)
    ()

fn py_eval_native(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 1):
        return Result::Err(KainError__runtime("py_eval: expected 1 argument (code)"))
    let code = match &args[0]:
        kain_core__runtime__Value::String(s) => s
        _ => return Result::Err(KainError__runtime("py_eval: expected string"))
    let state_ = python_scope_state(env)?
    Python__with_gil(fn(py): none)

fn py_eval_raw_native(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 1):
        return Result::Err(KainError__runtime("py_eval_raw: expected 1 argument (code)"))
    let code = match &args[0]:
        kain_core__runtime__Value::String(s) => s
        _ => return Result::Err(KainError__runtime("py_eval_raw: expected string"))
    let state_ = python_scope_state(env)?
    Python__with_gil(fn(py): none)

fn py_exec_native(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 1):
        return Result::Err(KainError__runtime("py_exec: expected 1 argument"))
    let code = match &args[0]:
        kain_core__runtime__Value::String(s) => s
        _ => return Result::Err(KainError__runtime("py_exec: expected string"))
    let state_ = python_scope_state(env)?
    Python__with_gil(fn(py): none)

fn py_import_native(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 1):
        return Result::Err(KainError__runtime("py_import: expected 1 argument"))
    let module_name = match &args[0]:
        kain_core__runtime__Value::String(s) => s
        _ => return Result::Err(KainError__runtime("py_import: argument must be string"))
    let state_ = python_scope_state(env)?
    Python__with_gil(fn(py): none)

fn py_call_native(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    py_call_with_mode(env, args, false)

fn py_call_raw_native(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    py_call_with_mode(env, args, true)

fn py_call_with_mode(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>, raw_result: Bool) -> Result<kain_core::runtime::Value, KainError>:
    let state_ = python_scope_state(env)?
    let call_spec = parse_python_call(&args)?
    Python__with_gil(fn(py): none)

fn py_getattr_native(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    py_getattr_with_mode(env, args, false)

fn py_getattr_raw_native(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    py_getattr_with_mode(env, args, true)

fn py_getattr_with_mode(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>, raw_result: Bool) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 2):
        return Result::Err(KainError__runtime("py_getattr: expected 2 arguments (target, name)"))
    let attr_name = match &args[1]:
        kain_core__runtime__Value::String(name) => name.clone()
        _ => return Result::Err(KainError__runtime("py_getattr: attribute name must be string"))
    let state_ = python_scope_state(env)?
    Python__with_gil(fn(py): none)

fn py_setattr_native(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 3):
        return Result::Err(KainError__runtime("py_setattr: expected 3 arguments (target, name, value)"))
    let attr_name = match &args[1]:
        kain_core__runtime__Value::String(name) => name.clone()
        _ => return Result::Err(KainError__runtime("py_setattr: attribute name must be string"))
    let state_ = python_scope_state(env)?
    Python__with_gil(fn(py): none)

