    ()
    dict.set_item("element_type", (*buffer).metadata.element_type.clone()).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("element_size", (*buffer).metadata.element_size).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("shape", PyList__new_(py, (*buffer).metadata.shape.iter().copied())).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("strides", PyList__new_(py, (*buffer).metadata.strides.iter().copied())).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("format", (*buffer).metadata.format.clone().map(fn(value): value.into_py(py)).unwrap_or_else(fn(): py.None())).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("mime_type", (*buffer).metadata.mime_type.clone().map(fn(value): value.into_py(py)).unwrap_or_else(fn(): py.None())).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("source_runtime", (*buffer).metadata.source_runtime.clone()).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("source_backend", (*buffer).metadata.source_backend.clone().map(fn(value): value.into_py(py)).unwrap_or_else(fn(): py.None())).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("ownership", (*buffer).metadata.ownership.clone()).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("labels", PyList__new_(py, (*buffer).metadata.labels.iter())).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    dict.set_item("bytes", PyByteArray__new_(py, &buffer.bytes())).map_err(fn(err): KainError__runtime(f"shared buffer export error: {err}"))?
    ()
    Result::Ok(dict.into())

