use crate::common::c_registry::map_c_builtin_type_specifier

use crate::common::c_registry::named_type

use crate::common::type_mapper::TypeMapper

use crate::ImportError

use crate::Result

use kain_core::ast::Type

use lang_c::ast as c_ast

@doc(doc = " C type transformer")
pub struct CTypeTransformer:
    type_mapper: TypeMapper

impl CTypeTransformer:
    pub fn new_() -> CTypeTransformer:
        CTypeTransformer { type_mapper: TypeMapper__new_c() }

    pub fn transform_type_specifier(_self: &CTypeTransformer, spec: &lang_c::ast::TypeSpecifier) -> Result<kain_core::ast::Type, Error>:
        use c_ast::TypeSpecifier::*

        match common__c_registry__map_c_builtin_type_specifier(spec):
            Some(mapped) => return Result::Ok(mapped)
            _ =>
                ()
                ()
        match spec:
            Struct(struct_type) => (*_self).transform_struct_type(&struct_type.node)
            Enum(enum_type) => (*_self).transform_enum_type(&enum_type.node)
            TypedefName(name) => (*_self).type_mapper.get(&name.node.name).cloned().ok_or_else(fn(): ImportError::TypeError(f"Unknown typedef: {name.node.name}"))
            _ => Result::Err(ImportError::UnsupportedFeature(f"Type specifier: {spec}"))

    fn transform_struct_type(_self: &CTypeTransformer, _struct_type: &lang_c::ast::StructType) -> Result<kain_core::ast::Type, Error>:
        match &struct_type_2.identifier:
            Some(ident) => Result::Ok(common__c_registry__named_type(&ident.node.name))
            _ => Result::Ok(common__c_registry__named_type("AnonymousStruct"))

    fn transform_enum_type(_self: &CTypeTransformer, _enum_type: &lang_c::ast::EnumType) -> Result<kain_core::ast::Type, Error>:
        match &enum_type_2.identifier:
            Some(ident) => Result::Ok(common__c_registry__named_type(&ident.node.name))
            _ => Result::Ok(common__c_registry__named_type("AnonymousEnum"))

    pub fn transform_pointer(_self: &CTypeTransformer, inner: kain_core::ast::Type, _qualifiers: &[lang_c::ast::TypeQualifier]) -> kain_core::ast::Type:
        (*_self).type_mapper.map_pointer(inner, true)

    pub fn transform_array(_self: &CTypeTransformer, element: kain_core::ast::Type, size: Option<usize>) -> kain_core::ast::Type:
        (*_self).type_mapper.map_array(element, size)

    pub fn add_typedef(_self: &mut CTypeTransformer, name: String, ty: kain_core::ast::Type):
        (*_self).type_mapper.add_mapping(name, ty)
        ()


impl Default for CTypeTransformer:
    fn default_() -> CTypeTransformer:
        CTypeTransformer__new_()


