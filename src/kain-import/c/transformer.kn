                Result::Ok(Expr::AggregateInit { ty: ty.clone(), fields: (*_self).normalize_aggregate_fields_for_type(ty, fields), zero_fill_rest: true, span: Span__default_() })
            Type::Array(inner, count, _) =>
                let values = (*_self).transform_array_initializer(inner, (*count), items)?
                Result::Ok(Expr::Array(values, Span__default_()))
            _ =>
                let mut exprs = Vec__new_()
                for item in items:
                    exprs.push((*_self).transform_initializer(&item.node.initializer.node)?)
                    ()
                ()
                Result::Ok(Expr::Array(exprs, Span__default_()))

    fn default_value_for_type(_self: &CTransformer, ty: &Type) -> Expr:
        match ty:
            Type::Array(inner, count, _) => Expr::Array((range(0, (*count))).map(fn(_): (*_self).default_value_for_type(inner)).collect(), Span__default_())
            Type::Named { name: name } =>
                if (*_self).structs.contains_key(name):
                    return Expr::AggregateInit { ty: ty.clone(), fields: Vec__new_(), zero_fill_rest: true, span: Span__default_() }
                match name.as_str():
                    "Int" => Expr::Int(0, Span__default_())
                    "i32" => Expr::Int(0, Span__default_())
                    "i64" => Expr::Int(0, Span__default_())
                    "Float" => Expr::Float(0, Span__default_())
                    "f32" => Expr::Float(0, Span__default_())
                    "f64" => Expr::Float(0, Span__default_())
                    "Bool" => Expr::Bool(false, Span__default_())
                    "Char" => Expr::String(("\0").to_string(), Span__default_())
                    _ => Expr::None(Span__default_())
            Type::Unit(_) => Expr::Tuple(Vec__new_(), Span__default_())
            _ => Expr::None(Span__default_())

    fn field_name_for_index(_self: &CTransformer, ty: &Type, index: usize) -> Option<String>:
        let Type::Named { name: name } = ty
        ((*_self).structs.get(name)?).fields.get(index).map(fn(field): field.name.clone())

    fn transform_compound_initializer_for_type(_self: &mut CTransformer, ty: &Type, items: &[lang_c::span::Node<lang_c::ast::InitializerListItem>]) -> Result<Array<(String, Expr)>, Error>:
        let mut fields: Array<(String, Expr)> = Vec__new_()
        let mut cursor = 0
        for item in items:
            let designators = item.node.designation.as_slice()
            let (field_name, remainder, next_cursor) = match designators.first():
                Some(first) =>
                    match &first.node:
                        lang_c__ast__Designator::Member(ident) => ((*_self).rename_field_identifier(&ident.node.name), &designators[1..], cursor)
                        lang_c__ast__Designator::Index(index_expr) =>
                            let index = (*_self).extract_designator_index(&index_expr.node)?
                            ((*_self).field_name_for_index(ty, index).unwrap_or_else(fn(): f"field_{index}"), &designators[1..], index.saturating_add(1))
                        _ => (f"field_{cursor}", &designators[1..], cursor.saturating_add(1))
                _ =>
                    let field_name = (*_self).field_name_for_index(ty, cursor).unwrap_or_else(fn(): f"field_{cursor}")
                    (field_name, &designators[0..0], cursor.saturating_add(1))
            let field_ty = (*_self).lookup_field_type(ty, &field_name)
            let current = fields.iter().find(fn(__kain_closure_arg0): (__kain_closure_arg0.__kain_tuple_0 == &field_name)).map(fn(__kain_closure_arg1): __kain_closure_arg1.__kain_tuple_1.clone()).unwrap_or_else(fn(): field_ty.map(fn(field_ty): (*_self).default_value_for_type(field_ty)).unwrap_or_else(fn(): Expr::None(Span__default_())))
            let value = match field_ty:
                Some(field_ty) => (*_self).apply_designators_to_value(field_ty, current, remainder, &item.node.initializer.node)?
                _ => (*_self).transform_initializer(&item.node.initializer.node)?
            CTransformer__upsert_named_expr(&mut fields, field_name, value)
            ()
            cursor = next_cursor
            ()
        ()
        Result::Ok((*_self).normalize_aggregate_fields_for_type(ty, fields))

    fn transform_initializer_for_type(_self: &mut CTransformer, init: &lang_c::ast::Initializer, ty: Option<&Type>) -> Result<Expr, Error>:
        match (init, ty):
            (lang_c__ast__Initializer::Expression(expr), _) => (*_self).transform_expression(&expr.node)
            (lang_c__ast__Initializer::List(items), Some(ty)) => (*_self).transform_compound_literal_for_type(ty, items)
            (lang_c__ast__Initializer::List(items), None) =>
                let mut exprs = Vec__new_()
                for item in items:
                    exprs.push((*_self).transform_initializer(&item.node.initializer.node)?)
                    ()
                ()
                Result::Ok(Expr::Array(exprs, Span__default_()))

    fn transform_array_initializer(_self: &mut CTransformer, element_ty: &Type, count: usize, items: &[lang_c::span::Node<lang_c::ast::InitializerListItem>]) -> Result<Array<Expr>, Error>:
        let mut values = (range(0, count)).map(fn(_): (*_self).default_value_for_type(element_ty)).collect()
        let mut cursor = 0
        for item in items:
            let designators = item.node.designation.as_slice()
            let (target_index, remainder) = match designators.first():
                Some(first) =>
                    match &first.node:
                        lang_c__ast__Designator::Index(index_expr) => ((*_self).extract_designator_index(&index_expr.node)?, &designators[1..])
                        _ => (cursor, &designators[1..])
                _ => (cursor, &designators[0..0])
            let current = values.get(target_index).cloned().unwrap_or_else(fn(): (*_self).default_value_for_type(element_ty))
            let value = (*_self).apply_designators_to_value(element_ty, current, remainder, &item.node.initializer.node)?
            if (target_index < values.len()):
                values[target_index] = value
                ()
                ()
                ()
                ()
            else:
                values.resize_with(target_index, fn(): (*_self).default_value_for_type(element_ty))
                ()
                values.push(value)
                ()
                ()
                ()
                ()
            cursor = target_index.saturating_add(1)
            ()
        ()
        Result::Ok(values)

    fn extract_designator_index(_self: &mut CTransformer, expr: &lang_c::ast::Expression) -> Result<usize, Error>:
        (*_self).extract_const_usize_expr(expr, "designated initializer index")

    fn extract_const_usize_expr(_self: &mut CTransformer, expr: &lang_c::ast::Expression, context: String) -> Result<usize, Error>:
        match ((*_self).transform_expression(expr)?):
            Expr::Int(value, _) if (value >= 0) => Result::Ok(value as usize)
            _ => Result::Err(ImportError::UnsupportedFeature(f"Non-constant {context}"))

    fn lookup_field_type(_self: &CTransformer, ty: &Type, field_name: String) -> Option<Type>:
        let Type::Named { name: name } = ty
        ((*_self).structs.get(name)?).fields.iter().find(fn(field): (field.name == field_name)).map(fn(field): field.ty.clone())

    fn apply_designators_to_value(_self: &mut CTransformer, ty: &Type, current: Expr, designators: &[lang_c::span::Node<lang_c::ast::Designator>], init: &lang_c::ast::Initializer) -> Result<Expr, Error>:
        if designators.is_empty():
            return (*_self).transform_initializer_for_type(init, Option::Some(ty))
        match ty:
            Type::Named {  } =>
                let (field_name, field_ty) = match &designators[0].node:
                    lang_c__ast__Designator::Member(ident) =>
                        let field_name = (*_self).rename_field_identifier(&ident.node.name)
                        let field_ty = (*_self).lookup_field_type(ty, &field_name)
                        (field_name, field_ty)
                    lang_c__ast__Designator::Index(index_expr) =>
                        let index = (*_self).extract_designator_index(&index_expr.node)?
                        let field_name = (*_self).field_name_for_index(ty, index).unwrap_or_else(fn(): f"field_{index}")
                        let field_ty = (*_self).lookup_field_type(ty, &field_name)
                        (field_name, field_ty)
                    _ => return (*_self).transform_initializer_for_type(init, Option::Some(ty))
                let mut fields = match current:
                    Expr::AggregateInit { fields: fields } => fields
                    _ => Vec__new_()
                let Some(field_ty) = field_ty
                let nested_current = fields.iter().find(fn(__kain_closure_arg2): (__kain_closure_arg2.__kain_tuple_0 == &field_name)).map(fn(__kain_closure_arg3): __kain_closure_arg3.__kain_tuple_1.clone()).unwrap_or_else(fn(): (*_self).default_value_for_type(&field_ty))
                let nested_value = (*_self).apply_designators_to_value(&field_ty, nested_current, &designators[1..], init)?
                CTransformer__upsert_named_expr(&mut fields, field_name, nested_value)
                ()
                Result::Ok(Expr::AggregateInit { ty: ty.clone(), fields: (*_self).normalize_aggregate_fields_for_type(ty, fields), zero_fill_rest: true, span: Span__default_() })
            Type::Array(inner, count, _) =>
                let target_index = match &designators[0].node:
                    lang_c__ast__Designator::Index(index_expr) => (*_self).extract_designator_index(&index_expr.node)?
                    _ => return (*_self).transform_initializer_for_type(init, Option::Some(ty))
                let mut values = match current:
                    Expr::Array(values, _) => values
                    _ => (range(0, (*count))).map(fn(_): (*_self).default_value_for_type(inner)).collect()
                if (target_index >= values.len()):
                    values.resize_with((target_index + 1), fn(): (*_self).default_value_for_type(inner))
                    ()
                    ()
                    ()
                    ()
                let nested_current = values.get(target_index).cloned().unwrap_or_else(fn(): (*_self).default_value_for_type(inner))
                let nested_value = (*_self).apply_designators_to_value(inner, nested_current, &designators[1..], init)?
                values[target_index] = nested_value
                ()
                Result::Ok(Expr::Array(values, Span__default_()))
            _ => (*_self).transform_initializer_for_type(init, Option::Some(ty))

    fn upsert_named_expr(fields: &mut Array<(String, Expr)>, field_name: String, value: Expr):
        match fields.iter().position(fn(__kain_closure_arg4): (__kain_closure_arg4.__kain_tuple_0 == &field_name)):
            Some(index) =>
                fields.remove(index)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        fields.push((field_name, value))
        ()

    fn try_lower_allocator_call(_self: &mut CTransformer, call: &lang_c::ast::CallExpression) -> Result<Option<Expr>, Error>:
        let lang_c__ast__Expression::Identifier(ident) = &(*call).callee.node
        let name = ident.node.name.as_str()
        if (!none):
            return Result::Ok(none)
        let args = (*call).arguments.iter().map(fn(arg): (*_self).transform_expression(&arg.node)).collect()?
        let span = Span__default_()
        let lowered = match (name, args.as_slice()):
            ("malloc", [size]) => Expr::Alloc { size: Box__new_(size.clone()), ty: (*_self).infer_heap_type_from_size_expr(size), zeroed: false, span: span }
            ("calloc", [count, elem_size]) => Expr::Alloc { size: Box__new_(Expr::Binary { left: Box__new_(count.clone()), op: BinaryOp__Mul, right: Box__new_(elem_size.clone()), span: span }), ty: (*_self).infer_heap_type_from_size_expr(elem_size), zeroed: true, span: span }
            ("realloc", [pointer, size]) => Expr::Realloc { pointer: Box__new_(pointer.clone()), size: Box__new_(size.clone()), ty: (*_self).infer_heap_type_from_size_expr(size), zeroed_new: false, span: span }
            _ => return Result::Ok(none)
        Result::Ok(Option::Some(lowered))

    fn infer_heap_type_from_size_expr(_self: &CTransformer, expr: &Expr) -> Option<Type>:
        match expr:
            Expr::SizeOfType { target: target } => Option::Some(target.clone())
            Expr::Binary { left: left, op: BinaryOp::Mul, right: right } => (*_self).infer_heap_type_from_size_expr(left).or_else(fn(): (*_self).infer_heap_type_from_size_expr(right))
            _ => none

    fn estimate_sizeof_named_type(_self: &CTransformer, name: String, visited: &mut Set<String>) -> i64:
        if (!visited.insert(name.to_string())):
            return 8
        let value = match name:
            "Bool" => 1
            "Char" => 1
            "Int" => 8
            "Float" => 8
            other =>
                match (*_self).structs.get(other):
                    Some(struct_def) => struct_def.fields.iter().map(fn(field): (*_self).estimate_sizeof_type_inner(&field.ty, visited)).sum()
                    _ =>
                        match (*_self).typedefs.get(other):
                            Some(alias_ty) => (*_self).estimate_sizeof_type_inner(alias_ty, visited)
                            _ => 8
        visited.remove(name)
        ()
        value

    fn estimate_sizeof_type_inner(_self: &CTransformer, ty: &Type, visited: &mut Set<String>) -> i64:
        match ty:
            Type::Unit(_) => 0
            Type::Named { name: name } => (*_self).estimate_sizeof_named_type(name, visited)
            Type::Array(inner, count, _) =>
                let elem = (*_self).estimate_sizeof_type_inner(inner, visited)
                ((elem * (*count) as i64)).max(0)
            Type::Slice(_, _) => 8
            Type::Ref {  } => 8
            Type::Tuple(items, _) => items.iter().map(fn(item): (*_self).estimate_sizeof_type_inner(item, visited)).sum()
            _ => 8

    fn estimate_sizeof_type(_self: &CTransformer, ty: &Type) -> i64:
        let mut visited = HashSet__new_()
        (*_self).estimate_sizeof_type_inner(ty, &mut visited)

    fn estimate_sizeof_expression(_self: &mut CTransformer, expr: &lang_c::ast::Expression) -> i64:
        use c_ast::Expression::*

        match expr:
            Identifier(ident) =>
                let name = ident.node.name.as_str()
                if (*_self).structs.contains_key(name):
                    (*_self).estimate_sizeof_type(&Type::Named { name: name.to_string(), generics: Vec__new_(), span: Span__default_() })
                else:
                    match (*_self).typedefs.get(name):
                        Some(alias_ty) => (*_self).estimate_sizeof_type(alias_ty)
                        _ => 8
            Cast(cast) =>
                let ty = (*_self).extract_type_from_type_name(&cast.node.type_name.node)
                match ty:
                    Ok(ty) => (*_self).estimate_sizeof_type(&ty)
                    Err(_) => 8
            Constant(constant) =>
                match &constant.node:
                    lang_c__ast__Constant::Character(_) => 1
                    lang_c__ast__Constant::Integer(_) => 8
                    lang_c__ast__Constant::Float(_) => 8
            StringLiteral(_) => 8
            _ => 8

    fn lower_inc_dec(_self: &mut CTransformer, operand: &lang_c::ast::Expression, increment: Bool, prefix: Bool) -> Result<Expr, Error>:
        let operand_expr = (*_self).transform_expression(operand)?
        if (!none):
            return Result::Err(ImportError::UnsupportedFeature(("Increment/decrement target must be assignable").to_string()))
        let span = Span__default_()
        let binding = (*_self).fresh_temp("__kain_c_incdec")
        let bound_ident = Expr::Ident(binding.clone(), span)
        let updated = Expr::Binary { left: Box__new_(bound_ident.clone()), op: if increment: BinaryOp__Add else: BinaryOp__Sub, right: Box__new_(Expr::Int(1, span)), span: span }
        let assign_expr = Expr::Assign { target: Box__new_(operand_expr.clone()), value: Box__new_(updated.clone()), span: span }
        let result_expr = if prefix:
            updated
        else:
            bound_ident
        let sequenced = Expr::Index { object: Box__new_(Expr::Array([assign_expr, result_expr], span)), index: Box__new_(Expr::Int(1, span)), span: span }
        Result::Ok(Expr::Match { scrutinee: Box__new_(operand_expr), arms: [MatchArm { pattern: Pattern::Binding { name: binding, mutable_: false, span: span }, guard: none, body: sequenced, span: span }], span: span })

    fn ensure_binary_op_supported(_self: &CTransformer, op: BinaryOp) -> Result<(), Error>:
        if (!(*_self).language_capabilities.supports_parser_binary_op(op)):
            return Result::Err(ImportError::UnsupportedFeature(f"Binary operator '{op}' is not enabled by parser capabilities"))
        if (!(*_self).language_capabilities.supports_runtime_binary_op(op)):
            return Result::Err(ImportError::UnsupportedFeature(f"Binary operator '{op}' is not enabled by runtime capabilities"))
        Result::Ok(())

    fn lower_assignment_expression(_self: &mut CTransformer, operator_: &lang_c::ast::BinaryOperator, lhs: &lang_c::ast::Expression, rhs: &lang_c::ast::Expression) -> Result<Expr, Error>:
        if (none):
            let target = (*_self).transform_expression(lhs)?
            let value = (*_self).transform_expression(rhs)?
            return (*_self).lower_store_or_assign(target, value)
        match common__c_registry__resolve_c_compound_assignment_binary_operator(operator_):
            Some(lowered_op) =>
                (*_self).ensure_binary_op_supported(lowered_op)?
                ()
                let target_expr = (*_self).transform_expression(lhs)?
                let value_expr = (*_self).transform_expression(rhs)?
                let updated = Expr::Binary { left: Box__new_(target_expr.clone()), op: lowered_op, right: Box__new_(value_expr), span: Span__default_() }
                return (*_self).lower_store_or_assign(target_expr, updated)
            _ =>
                ()
                ()
        Result::Err(ImportError::UnsupportedFeature(f"Binary assignment operator is not representable in KAIN AST: {operator_}"))

    fn infer_expr_type(_self: &CTransformer, expr: &Expr) -> Option<Type>:
        match expr:
            Expr::Int(_, span) => Some(Type::Named { name: "Int".to_string(), generics: Vec__new_(), span: span.clone() })
            Expr::Float(_, span) => Some(Type::Named { name: "Float".to_string(), generics: Vec__new_(), span: span.clone() })
            Expr::Bool(_, span) => Some(Type::Named { name: "Bool".to_string(), generics: Vec__new_(), span: span.clone() })
            Expr::Ident(name, _) => ctx.local_types.get(name).cloned()
            Expr::Field { object: object, field: field } =>
                let object_ty = infer_expr_type(object, ctx)?
                field_type_from_object(&object_ty, field, ctx)
            Expr::Index { object: object } => infer_element_type(object, ctx)
            Expr::Cast { target: target } => Some(target.clone())
            _ => none

    fn is_pointer_like_type(_self: &CTransformer, ty: &Type) -> Bool:
        match ty:
            Type::Ref {  } => true
            Type::Ptr {  } => true
            Type::Array(_, _, _) => true
            Type::Slice(_, _) => true
            _ => false

    fn is_integer_like_expr(_self: &CTransformer, expr: &Expr) -> Bool:
        (none || none)

    fn lower_pointer_offset(_self: &CTransformer, base: Expr, offset: Expr, subtract: Bool) -> Expr:
        let span = Span__default_()
        let offset = if subtract:
            Expr::Binary { left: Box__new_(Expr::Int(0, span)), op: BinaryOp__Sub, right: Box__new_(offset), span: span }
        else:
            offset
        let element_ty = match (*_self).infer_expr_type(&base):
            Some(Type::Ptr { inner: inner }) => Option::Some((*inner))
            Some(Type::Ref { inner: inner }) => Option::Some((*inner))
            Some(Type::Array(inner, _, _)) => Option::Some((*inner))
            Some(Type::Slice(inner, _)) => Option::Some((*inner))
            _ => none
        Expr::PtrOffset { pointer: Box__new_(base), offset: Box__new_(offset), element_ty: element_ty, span: span }

    fn lower_memory_load(_self: &CTransformer, pointer: Expr) -> Expr:
        let load_ty = match (*_self).infer_expr_type(&pointer):
            Some(Type::Ref { inner: inner }) => Option::Some((*inner))
            Some(Type::Ptr { inner: inner }) => Option::Some((*inner))
            _ => none
        Expr::MemLoad { pointer: Box__new_(pointer), load_ty: load_ty, span: Span__default_() }

    fn lower_store_or_assign(_self: &CTransformer, target: Expr, value: Expr) -> Result<Expr, Error>:
        match target:
            Expr::MemLoad { pointer: pointer, load_ty: load_ty } => Result::Ok(Expr::MemStore { pointer: pointer, value: Box__new_(value), store_ty: load_ty, span: Span__default_() })
            other => Result::Ok(Expr::Assign { target: Box__new_(other), value: Box__new_(value), span: Span__default_() })

    fn maybe_lower_pointer_arithmetic(_self: &CTransformer, operator_: &lang_c::ast::BinaryOperator, left: Expr, right: Expr) -> Result<Option<Expr>, Error>:
        use c_ast::BinaryOperator as BinOp

        let left_ty = (*_self).infer_expr_type(&left)
        let right_ty = (*_self).infer_expr_type(&right)
        let left_is_pointer = left_ty.is_some_and(fn(ty): (*_self).is_pointer_like_type(ty))
        let right_is_pointer = right_ty.is_some_and(fn(ty): (*_self).is_pointer_like_type(ty))
        match operator_:
            c_ast__BinaryOperator::Plus if (left_is_pointer && (*_self).is_integer_like_expr(&right)) => Result::Ok(Option::Some((*_self).lower_pointer_offset(left, right, false)))
            c_ast__BinaryOperator::Plus if (right_is_pointer && (*_self).is_integer_like_expr(&left)) => Result::Ok(Option::Some((*_self).lower_pointer_offset(right, left, false)))
            c_ast__BinaryOperator::Minus if (left_is_pointer && (*_self).is_integer_like_expr(&right)) => Result::Ok(Option::Some((*_self).lower_pointer_offset(left, right, true)))
            c_ast__BinaryOperator::Minus if (left_is_pointer && right_is_pointer) => (*_self).memory_lowering_required("pointer difference requires an explicit raw-memory lowering strategy")
            c_ast__BinaryOperator::Plus if (left_is_pointer || right_is_pointer) => (*_self).memory_lowering_required("pointer arithmetic currently supports only pointer +/- integer forms")
            c_ast__BinaryOperator::Minus if (left_is_pointer || right_is_pointer) => (*_self).memory_lowering_required("pointer arithmetic currently supports only pointer - integer forms")
            _ => Result::Ok(none)

    fn lower_address_of_expression(_self: &mut CTransformer, operand: &lang_c::ast::Expression) -> Result<Expr, Error>:
        use c_ast::BinaryOperator as BinOp

        match operand:
            lang_c__ast__Expression::BinaryOperator(bin_op) if none =>
                let object_expr = (*_self).transform_expression(&bin_op.node.lhs.node)?
                let idx_expr = (*_self).transform_expression(&bin_op.node.rhs.node)?
                if (*_self).infer_expr_type(&object_expr).is_some_and(fn(ty): none):
                    Result::Ok((*_self).lower_pointer_offset(object_expr, idx_expr, false))
                else:
                    let pointee_ty = (*_self).infer_expr_type(&Expr::Index { object: Box__new_(object_expr.clone()), index: Box__new_(idx_expr.clone()), span: Span__default_() })
                    Result::Ok(Expr::AddrOf { value: Box__new_(Expr::Index { object: Box__new_(object_expr), index: Box__new_(idx_expr), span: Span__default_() }), pointee_ty: pointee_ty, span: Span__default_() })
            _ =>
                let value = (*_self).transform_expression(operand)?
                if (*_self).expr_field_is_bitfield(&value):
                    let code = kain_core__diagnostic_registry__spec_for_code(kain_core__diagnostic_registry__DiagnosticCode__MemoryIllegalBitfieldAddress).code_str
                    return Result::Err(ImportError::UnsupportedFeature(f"{code}: cannot take the address of a C bitfield; lower it through bitfield load/store semantics instead"))
                let pointee_ty = (*_self).infer_expr_type(&value)
                Result::Ok(Expr::AddrOf { value: Box__new_(value), pointee_ty: pointee_ty, span: Span__default_() })

    fn decode_c_escape_sequence(chars: &[Char], idx: &mut usize) -> Option<Char>:
        let next = (*chars.get((*idx))?)
        (*idx) = ((*idx) + 1)
        ()
        match next:
            "'" => Option::Some("'")
            "\"" => Option::Some("\"")
            "?" => Option::Some("?")
            "\\" => Option::Some("\\")
            "a" => Option::Some("\u{7}")
            "b" => Option::Some("\u{8}")
            "f" => Option::Some("\u{c}")
            "n" => Option::Some("\n")
            "r" => Option::Some("\r")
            "t" => Option::Some("\t")
            "v" => Option::Some("\u{b}")
            _ =>
                let mut digits = String__from(next)
                while (digits.len() < 3):
                    let Some(peek) = chars.get((*idx))
                    if ((!peek.is_ascii_digit()) || ((*peek) > "7")):
                        break
                    digits.push((*peek))
                    ()
                    (*idx) = ((*idx) + 1)
                    ()
                ()
                u32__from_str_radix(&digits, 8).ok().and_then(char__from_u32)
            "x" =>
                let mut digits = String__new_()
                loop:
                    match chars.get((*idx)):
                        Some(peek) =>
                            if (!peek.is_ascii_hexdigit()):
                                break
                            digits.push((*peek))
                            ()
                            (*idx) = ((*idx) + 1)
                            ()
                        _ => break
                ()
                if digits.is_empty():
                    none
                else:
                    u32__from_str_radix(&digits, 16).ok().and_then(char__from_u32)
            "u" =>
                let width = if (next == "u"):
                    4
                else:
                    8
                let mut digits = String__new_()
                for _ in range(0, width):
                    let Some(peek) = chars.get((*idx))
                    if (!peek.is_ascii_hexdigit()):
                        break
                    digits.push((*peek))
                    ()
                    (*idx) = ((*idx) + 1)
                    ()
                ()
                if digits.is_empty():
                    none
                else:
                    u32__from_str_radix(&digits, 16).ok().and_then(char__from_u32)
            "U" =>
                let width = if (next == "u"):
                    4
                else:
                    8
                let mut digits = String__new_()
                for _ in range(0, width):
                    let Some(peek) = chars.get((*idx))
                    if (!peek.is_ascii_hexdigit()):
                        break
                    digits.push((*peek))
                    ()
                    (*idx) = ((*idx) + 1)
                    ()
                ()
                if digits.is_empty():
                    none
                else:
                    u32__from_str_radix(&digits, 16).ok().and_then(char__from_u32)
            other => Option::Some(other)

    fn decode_c_literal_body(_self: &CTransformer, body: String) -> String:
        let chars = body.chars().collect()
        let mut decoded = String__new_()
        let mut idx = 0
        while (idx < chars.len()):
            let ch = chars[idx]
            idx = (idx + 1)
            ()
            if (ch == "\\"):
                match CTransformer__decode_c_escape_sequence(&chars, &mut idx):
                    Some(decoded_ch) =>
                        decoded.push(decoded_ch)
                        ()
                    _ => ()
            else:
                decoded.push(ch)
                ()
        ()
        decoded

    fn strip_c_literal_delimiters<a>(_self: &CTransformer, token: String, delimiter: Char) -> Option<String>:
        let start = token.find(delimiter)?
        let end = token.rfind(delimiter)?
        if (end <= start):
            return none
        Option::Some(&token[(start + 1)..end])

    fn decode_c_string_literal(_self: &CTransformer, parts: &[String]) -> String:
        parts.iter().filter_map(fn(part): (*_self).strip_c_literal_delimiters(part, "\"")).map(fn(body): (*_self).decode_c_literal_body(body)).collect().join("")

    fn decode_c_char_literal(_self: &CTransformer, token: String) -> String:
        (*_self).strip_c_literal_delimiters(token, "'").map(fn(body): (*_self).decode_c_literal_body(body)).unwrap_or_default()

    fn extract_function_name(_self: &CTransformer, declarator: &lang_c::ast::Declarator) -> Result<String, Error>:
        use c_ast::DeclaratorKind::*

        match &(*declarator).kind.node:
            Identifier(ident) => Result::Ok(ident.node.name.clone())
            Declarator(inner) => (*_self).extract_function_name(&inner.node)
            _ => Result::Ok(String__new_())

    fn transform_statement(_self: &mut CTransformer, stmt: &lang_c::ast::Statement) -> Result<Option<Stmt>, Error>:
        use c_ast::Statement::*

        match stmt:
            Return(expr) =>
                let value = match expr:
                    Some(e) => Option::Some((*_self).transform_expression(&e.node)?)
                    _ =>
                        none
                Result::Ok(Option::Some(Stmt::Return(value, Span__default_())))
            If(if_stmt) =>
                let condition = (*_self).transform_expression(&if_stmt.node.condition.node)?
                let then_body = (*_self).transform_compound_statement(&if_stmt.node.then_statement.node)?
                let else_branch = match if_stmt.node.else_statement:
                    Some(else_stmt) => Option::Some((*_self).transform_compound_statement(&else_stmt.node)?)
                    _ =>
                        none
                Result::Ok(Option::Some(Stmt::Expr(Expr::If { condition: Box__new_(condition), then_branch: then_body, else_branch: else_branch.map(fn(b): Box__new_(ElseBranch::Else(b))), span: Span__default_() })))
            While(while_stmt) =>
                let condition = (*_self).transform_expression(&while_stmt.node.expression.node)?
                let body = (*_self).transform_compound_statement(&while_stmt.node.statement.node)?
                Result::Ok(Option::Some(Stmt::While { condition: condition, body: body, span: Span__default_() }))
            For(for_stmt) =>
                let mut stmts = Vec__new_()
                match &for_stmt.node.initializer.node:
                    lang_c__ast__ForInitializer::Declaration(decl) =>
                        stmts.extend((*_self).transform_local_declaration(&decl.node)?)
                        ()
                        ()
                        ()
                        ()
                    lang_c__ast__ForInitializer::Expression(expr) =>
                        stmts.push(Stmt::Expr((*_self).transform_expression(&expr.node)?))
                        ()
                        ()
                        ()
                        ()
                    _ => ()
                let condition = match for_stmt.node.condition:
                    Some(cond) => (*_self).transform_expression(&cond.node)?
                    _ => Expr::Bool(true, Span__default_())
                let mut body_stmts = ((*_self).transform_compound_statement(&for_stmt.node.statement.node)?).stmts
                match for_stmt.node.step:
                    Some(step) =>
                        body_stmts.push(Stmt::Expr((*_self).transform_expression(&step.node)?))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                stmts.push(Stmt::While { condition: condition, body: Block { stmts: body_stmts, span: Span__default_() }, span: Span__default_() })
                ()
                Result::Ok(Option::Some(Stmt::Expr(Expr::Block(Block { stmts: stmts, span: Span__default_() }, Span__default_()))))
            Expression(expr) =>
                match expr:
                    Some(e) => Result::Ok(Option::Some(Stmt::Expr((*_self).transform_expression(&e.node)?)))
                    _ => Result::Ok(none)
            Break => Result::Ok(Option::Some(Stmt::Break(none, Span__default_())))
            Continue => Result::Ok(Option::Some(Stmt::Continue(Span__default_())))
            Compound(_) =>
                let block = (*_self).transform_compound_statement(stmt)?
                Result::Ok(Option::Some(Stmt::Expr(Expr::Block(block, Span__default_()))))
            _ => Result::Ok(none)

    fn transform_expression(_self: &mut CTransformer, expr: &lang_c::ast::Expression) -> Result<Expr, Error>:
        use c_ast::Expression::*

        match expr:
            Constant(constant) => (*_self).transform_constant(&constant.node)
            StringLiteral(string_lit) => Result::Ok(Expr::String((*_self).decode_c_string_literal(&string_lit.node.iter().cloned().collect()), Span__default_()))
            Identifier(ident) => Result::Ok(Expr::Ident((*_self).rename_value_identifier(&ident.node.name), Span__default_()))
            BinaryOperator(bin_op) =>
                use c_ast::BinaryOperator as BinOp

                match &bin_op.node.operator_.node:
                    c_ast__BinaryOperator::Index =>
                        let object_expr = (*_self).transform_expression(&bin_op.node.lhs.node)?
                        let idx_expr = (*_self).transform_expression(&bin_op.node.rhs.node)?
                        if (*_self).infer_expr_type(&object_expr).is_some_and(fn(ty): none):
                            Result::Ok((*_self).lower_memory_load((*_self).lower_pointer_offset(object_expr, idx_expr, false)))
                        else:
                            Result::Ok(Expr::Index { object: Box__new_(object_expr), index: Box__new_(idx_expr), span: Span__default_() })
                    c_ast__BinaryOperator::Assign => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignPlus => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignMinus => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignMultiply => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignDivide => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignModulo => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignShiftLeft => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignShiftRight => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignBitwiseAnd => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignBitwiseOr => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    c_ast__BinaryOperator::AssignBitwiseXor => (*_self).lower_assignment_expression(&bin_op.node.operator_.node, &bin_op.node.lhs.node, &bin_op.node.rhs.node)
                    _ =>
                        let left_expr = (*_self).transform_expression(&bin_op.node.lhs.node)?
                        let right_expr = (*_self).transform_expression(&bin_op.node.rhs.node)?
                        match ((*_self).maybe_lower_pointer_arithmetic(&bin_op.node.operator_.node, left_expr.clone(), right_expr.clone())?):
                            Some(lowered) => return Result::Ok(lowered)
                            _ =>
                                ()
                                ()
                        let left = Box__new_(left_expr)
                        let right = Box__new_(right_expr)
                        let op = (*_self).transform_binary_operator(&bin_op.node.operator_.node)?
                        Result::Ok(Expr::Binary { left: left, op: op, right: right, span: Span__default_() })
            UnaryOperator(unary_op) =>
                match unary_op.node.operator_.node:
                    lang_c__ast__UnaryOperator::Address => (*_self).lower_address_of_expression(&unary_op.node.operand.node)
                    lang_c__ast__UnaryOperator::Indirection =>
                        let value = Box__new_((*_self).transform_expression(&unary_op.node.operand.node)?)
                        Result::Ok(Expr::MemLoad { pointer: value, load_ty: none, span: Span__default_() })
                    lang_c__ast__UnaryOperator::PreIncrement => (*_self).lower_inc_dec(&unary_op.node.operand.node, true, true)
                    lang_c__ast__UnaryOperator::PostIncrement => (*_self).lower_inc_dec(&unary_op.node.operand.node, true, false)
                    lang_c__ast__UnaryOperator::PreDecrement => (*_self).lower_inc_dec(&unary_op.node.operand.node, false, true)
                    lang_c__ast__UnaryOperator::PostDecrement => (*_self).lower_inc_dec(&unary_op.node.operand.node, false, false)
                    lang_c__ast__UnaryOperator::Plus => (*_self).transform_expression(&unary_op.node.operand.node)
                    _ =>
                        let operand = Box__new_((*_self).transform_expression(&unary_op.node.operand.node)?)
                        let op = (*_self).transform_unary_operator(&unary_op.node.operator_.node)?
                        Result::Ok(Expr::Unary { op: op, operand: operand, span: Span__default_() })
            SizeOfTy(size_of_ty) =>
                let target_ty = (*_self).extract_type_from_type_name(&size_of_ty.node.field_0.node)?
                Result::Ok(Expr::SizeOfType { target: target_ty, span: Span__default_() })
            SizeOfVal(size_of_val) =>
                let lowered = (*_self).transform_expression(&size_of_val.node.field_0.node)?
                match (*_self).infer_expr_type(&lowered):
                    Some(ty) => Result::Ok(Expr::SizeOfType { target: ty, span: Span__default_() })
                    _ => Result::Ok(Expr::Int((*_self).estimate_sizeof_expression(&size_of_val.node.field_0.node), Span__default_()))
            AlignOf(align_of_ty) =>
                let target_ty = (*_self).extract_type_from_type_name(&align_of_ty.node.field_0.node)?
                Result::Ok(Expr::AlignOfType { target: target_ty, span: Span__default_() })
            Call(call) =>
                match ((*_self).try_lower_allocator_call(&call.node)?):
                    Some(lowered) => Result::Ok(lowered)
                    _ =>
                        let callee = Box__new_((*_self).transform_expression(&call.node.callee.node)?)
                        let mut args = Vec__new_()
                        for arg in &call.node.arguments:
                            args.push(CallArg { name: none, value: (*_self).transform_expression(&arg.node)?, span: Span__default_() })
                            ()
                        ()
                        Result::Ok(Expr::Call { callee: callee, args: args, span: Span__default_() })
            Member(member) =>
                let object = Box__new_((*_self).transform_expression(&member.node.expression.node)?)
                let field = (*_self).rename_field_identifier(&member.node.identifier.node.name)
                Result::Ok(Expr::Field { object: object, field: field, span: Span__default_() })
            Cast(cast) =>
                let value = Box__new_((*_self).transform_expression(&cast.node.expression.node)?)
                let target = (*_self).extract_type_from_type_name(&cast.node.type_name.node)?
                Result::Ok(Expr::Cast { value: value, target: target, span: Span__default_() })
            Conditional(cond) =>
                let condition = Box__new_((*_self).transform_expression(&cond.node.condition.node)?)
                let then_expr = (*_self).transform_expression(&cond.node.then_expression.node)?
                let else_expr = (*_self).transform_expression(&cond.node.else_expression.node)?
                Result::Ok(Expr::If { condition: condition, then_branch: Block { stmts: [Stmt::Expr(then_expr)], span: Span__default_() }, else_branch: Option::Some(Box__new_(ElseBranch::Else(Block { stmts: [Stmt::Expr(else_expr)], span: Span__default_() }))), span: Span__default_() })
            Comma(exprs) =>
                match exprs.last():
                    Some(last) => (*_self).transform_expression(&last.node)
                    _ => Result::Ok(Expr::Int(0, Span__default_()))
            CompoundLiteral(compound) =>
                let type_name = (*_self).extract_type_from_type_name(&compound.node.type_name.node)?
                (*_self).transform_compound_literal_for_type(&type_name, &compound.node.initializer_list)
            _ => Result::Err(ImportError::UnsupportedFeature(f"Expression: {expr}"))

    fn transform_constant(_self: &CTransformer, constant: &lang_c::ast::Constant) -> Result<Expr, Error>:
        use c_ast::Constant::*

        match constant:
            Integer(int_) =>
                let value = int_.number.parse().unwrap_or(0)
                Result::Ok(Expr::Int(value, Span__default_()))
            Float(float_) =>
                let value = float_.number.parse().unwrap_or(0)
                Result::Ok(Expr::Float(value, Span__default_()))
            Character(ch) => Result::Ok(Expr::String((*_self).decode_c_char_literal(ch), Span__default_()))

    fn transform_binary_operator(_self: &CTransformer, op: &lang_c::ast::BinaryOperator) -> Result<BinaryOp, Error>:
        let mapped = match common__c_registry__resolve_c_binary_operator(op):
            CBinaryOperatorResolution::Supported(mapped) => mapped
            CBinaryOperatorResolution::UnsupportedAssignment => return Result::Err(ImportError::UnsupportedFeature(f"Binary assignment operator is not representable in KAIN AST: {op}"))
            CBinaryOperatorResolution::Unsupported => return Result::Err(ImportError::UnsupportedFeature(f"Binary operator: {op}"))
        (*_self).ensure_binary_op_supported(mapped)?
        ()
        Result::Ok(mapped)

    fn transform_unary_operator(_self: &CTransformer, op: &lang_c::ast::UnaryOperator) -> Result<UnaryOp, Error>:
        use c_ast::UnaryOperator::*

        Result::Ok(none)


impl Default for CTransformer:
    fn default_() -> CTransformer:
        CTransformer__new_()


pub fn transform_with_language_capabilities_and_layout_metadata(tu: lang_c::ast::TranslationUnit, language_capabilities: kain_core::language_features::LanguageCapabilities, layout_metadata: CSourceLayoutMetadata) -> Result<Program, Error>:
    let mut transformer = CTransformer__with_language_capabilities_and_layout_metadata(language_capabilities, layout_metadata)
    transformer.transform(tu)

fn parse_c_integer_literal(number: String) -> Option<usize>:
    let digits = number.trim().trim_end_matches(fn(c: Char): none)
    match digits.strip_prefix("0x").or_else(fn(): digits.strip_prefix("0X")):
        Some(hex) => usize__from_str_radix(hex, 16).ok()
        _ =>
            match digits.strip_prefix("0b").or_else(fn(): digits.strip_prefix("0B")):
                Some(bin) => usize__from_str_radix(bin, 2).ok()
                _ => if ((digits.len() > 1) && digits.starts_with("0")): usize__from_str_radix(&digits[1..], 8).ok() else: digits.parse().ok()

