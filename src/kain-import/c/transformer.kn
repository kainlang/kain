use crate::c::parser::CSourceLayoutMetadata

use crate::c::types::CTypeTransformer

use crate::common::c_registry::resolve_c_binary_operator

use crate::common::c_registry::resolve_c_compound_assignment_binary_operator

use crate::common::c_registry::CBinaryOperatorResolution

use crate::common::identifier_registry::IdentifierDomain

use crate::common::identifier_registry::StableIdentifierRenamer

use crate::ImportError

use crate::Result

use kain_core::ast::*

use kain_core::diagnostic_registry::DiagnosticCode

use kain_core::effects::Effect

use kain_core::language_features::default_language_capabilities

use kain_core::language_features::LanguageCapabilities

use kain_core::low_level_abi::default_c_abi_policy

use kain_core::low_level_memory_metadata::marker_attr

use kain_core::low_level_memory_metadata::usize_attr

use kain_core::low_level_memory_metadata::usize_bool_attr

use kain_core::low_level_memory_metadata::C_BITFIELD_ATTR

use kain_core::low_level_memory_metadata::C_PACKED_ATTR

use kain_core::low_level_memory_metadata::C_PACK_ALIGN_ATTR

use kain_core::low_level_memory_metadata::C_STORAGE_ALIGN_ATTR

use kain_core::low_level_memory_metadata::C_STORAGE_BITS_ATTR

use kain_core::low_level_memory_metadata::C_TYPE_ALIGN_ATTR

use kain_core::low_level_memory_metadata::C_UNION_ATTR

use kain_core::span::Span

use lang_c::ast as c_ast

use lang_c::span::Node

use lang_c::span::Span as CSpan

use std::collections::HashMap

use std::collections::HashSet

@doc(doc = " C to KAIN AST transformer")
pub struct CTransformer:
    type_transformer: CTypeTransformer
    current_function: Option<String>
    structs: Map<String, Struct>
    enums: Map<String, Enum>
    typedefs: Map<String, Type>
    identifier_renamer: StableIdentifierRenamer
    language_capabilities: kain_core::language_features::LanguageCapabilities
    temp_counter: usize
    symbol_scopes: Array<Map<String, Type>>
    layout_metadata: Option<CSourceLayoutMetadata>
    pending_items: Array<Item>
    emitted_synthetic_type_keys: Set<String>

impl CTransformer:
    pub fn new_() -> CTransformer:
        CTransformer__with_language_capabilities(kain_core__language_features__default_language_capabilities())

    pub fn with_language_capabilities(language_capabilities: kain_core::language_features::LanguageCapabilities) -> CTransformer:
        CTransformer { type_transformer: CTypeTransformer__new_(), current_function: none, structs: HashMap__new_(), enums: HashMap__new_(), typedefs: HashMap__new_(), identifier_renamer: StableIdentifierRenamer__default_(), language_capabilities: language_capabilities, temp_counter: 0, symbol_scopes: [HashMap__new_()], layout_metadata: none, pending_items: Vec__new_(), emitted_synthetic_type_keys: HashSet__new_() }

    pub fn with_language_capabilities_and_layout_metadata(language_capabilities: kain_core::language_features::LanguageCapabilities, layout_metadata: CSourceLayoutMetadata) -> CTransformer:
        let mut transformer = CTransformer__with_language_capabilities(language_capabilities)
        transformer.layout_metadata = Option::Some(layout_metadata)
        ()
        transformer

    fn rename_identifier(_self: &mut CTransformer, domain: IdentifierDomain, raw: String) -> String:
        (*_self).identifier_renamer.resolve(domain, raw)

    fn rename_value_identifier(_self: &mut CTransformer, raw: String) -> String:
        (*_self).rename_identifier(IdentifierDomain__Value, raw)

    fn rename_type_identifier(_self: &mut CTransformer, raw: String) -> String:
        (*_self).rename_identifier(IdentifierDomain__Type, raw)

    fn rename_field_identifier(_self: &mut CTransformer, raw: String) -> String:
        (*_self).rename_identifier(IdentifierDomain__Field, raw)

    fn rename_variant_identifier(_self: &mut CTransformer, raw: String) -> String:
        (*_self).rename_identifier(IdentifierDomain__Variant, raw)

    fn fresh_temp(_self: &mut CTransformer, prefix: String) -> String:
        let name = f"{prefix}_{(*_self).temp_counter}"
        (*_self).temp_counter = ((*_self).temp_counter + 1)
        ()
        (*_self).rename_value_identifier(&name)

    fn anonymous_type_name(_self: &mut CTransformer, owner_name: String, field_name: String, kind: String) -> String:
        let raw = f"{owner_name}_{field_name}_{kind}"
        (*_self).rename_type_identifier(&raw)

    fn register_pending_synthetic_item(_self: &mut CTransformer, item: Item):
        let key = match &item:
            Item::Struct(s) => f"struct:{s.name}"
            Item::Enum(e) => f"enum:{e.name}"
            _ => return
        if (*_self).emitted_synthetic_type_keys.insert(key):
            (*_self).pending_items.push(item)
            ()

    fn drain_pending_items(_self: &mut CTransformer, out_: &mut Array<Item>):
        out_.extend((*_self).pending_items.drain(range(0, 0)))
        ()

    fn memory_lowering_required<T>(_self: &CTransformer, context: impl Into<String>) -> Result<T, Error>:
        let context = context.into()
        Result::Err(ImportError::UnsupportedFeature(f"{kain_core__diagnostic_registry__spec_for_code(kain_core__diagnostic_registry__DiagnosticCode__MemoryLoweringRequired).code_str}: {context}. Add or select a pointer lowering policy before importing this expression form."))

    fn push_symbol_scope(_self: &mut CTransformer):
        (*_self).symbol_scopes.push(HashMap__new_())
        ()

    fn pop_symbol_scope(_self: &mut CTransformer):
        if ((*_self).symbol_scopes.len() > 1):
            (*_self).symbol_scopes.pop()
            ()

    fn define_symbol_type(_self: &mut CTransformer, name: String, ty: Type):
        match (*_self).symbol_scopes.last_mut():
            Some(scope) =>
                scope.insert(name, ty)
                ()
            _ => ()

    fn lookup_symbol_type(_self: &CTransformer, name: String) -> Option<Type>:
        (*_self).symbol_scopes.iter().rev().find_map(fn(scope): scope.get(name).cloned())

    fn sanitize_type(_self: &mut CTransformer, ty: Type) -> Type:
        match ty:
            Type::Named { name: name, generics: generics, span: span } => Type::Named { name: (*_self).rename_type_identifier(&name), generics: generics.into_iter().map(fn(inner): (*_self).sanitize_type(inner)).collect(), span: span }
            Type::Tuple(items, span) => Type::Tuple(items.into_iter().map(fn(inner): (*_self).sanitize_type(inner)).collect(), span)
            Type::Array(inner, len, span) => Type::Array(Box__new_((*_self).sanitize_type((*inner))), len, span)
            Type::Slice(inner, span) => Type::Slice(Box__new_((*_self).sanitize_type((*inner))), span)
            Type::Ref { mutable_: mutable_, inner: inner, lifetime: lifetime, span: span } => Type::Ref { mutable_: mutable_, inner: Box__new_((*_self).sanitize_type((*inner))), lifetime: lifetime, span: span }
            Type::Function { params: params, return_type: return_type, effects: effects, span: span } => Type::Function { params: params.into_iter().map(fn(inner): (*_self).sanitize_type(inner)).collect(), return_type: Box__new_((*_self).sanitize_type((*return_type))), effects: effects, span: span }
            Type::Option(inner, span) => Type::Option(Box__new_((*_self).sanitize_type((*inner))), span)
            Type::Result(ok, err, span) => Type::Result(Box__new_((*_self).sanitize_type((*ok))), Box__new_((*_self).sanitize_type((*err))), span)
            Type::Impl { trait_name: trait_name, generics: generics, span: span } => Type::Impl { trait_name: (*_self).rename_type_identifier(&trait_name), generics: generics.into_iter().map(fn(inner): (*_self).sanitize_type(inner)).collect(), span: span }
            other => other

    fn struct_def_for_type(_self: &CTransformer, ty: &Type) -> Option<&Struct>:
        let Type::Named { name: name } = ty
        (*_self).structs.get(name)

    fn struct_is_union_type(_self: &CTransformer, ty: &Type) -> Bool:
        (*_self).struct_def_for_type(ty).map(fn(st): st.attributes.iter().any(fn(attr): (attr.name == kain_core__low_level_memory_metadata__C_UNION_ATTR))).unwrap_or(false)

    fn normalize_aggregate_fields_for_type(_self: &CTransformer, ty: &Type, fields: Array<(String, Expr)>) -> Array<(String, Expr)>:
        if (!(*_self).struct_is_union_type(ty)):
            return fields
        let Some((active_name, active_value)) = fields.last().cloned()
        [(active_name, active_value)]

    fn lookup_field(_self: &CTransformer, ty: &Type, field_name: String) -> Option<&Field>:
        ((*_self).struct_def_for_type(ty)?).fields.iter().find(fn(field): (field.name == field_name))

    fn expr_field_is_bitfield(_self: &CTransformer, expr: &Expr) -> Bool:
        let Expr::Field { object: object, field: field } = expr
        let Some(object_ty) = (*_self).infer_expr_type(object)
        (*_self).lookup_field(&object_ty, field).map(fn(field_def): field_def.attributes.iter().any(fn(attr): (attr.name == kain_core__low_level_memory_metadata__C_BITFIELD_ATTR))).unwrap_or(false)

    fn c_storage_layout_for_specifiers(_self: &CTransformer, specifiers: &[lang_c::span::Node<lang_c::ast::SpecifierQualifier>]) -> (usize, usize):
        let abi = kain_core__low_level_abi__default_c_abi_policy()
        let mut saw_char = false
        let mut saw_short = false
        let mut saw_long_count = 0
        let mut saw_float = false
        let mut saw_double = false
        let mut saw_bool = false
        for spec in specifiers:
            match &spec.node:
                lang_c__ast__SpecifierQualifier::TypeSpecifier(type_spec) =>
                    match &type_spec.node:
                        lang_c__ast__TypeSpecifier::Char => saw_char = true
                        lang_c__ast__TypeSpecifier::Short => saw_short = true
                        lang_c__ast__TypeSpecifier::Long => saw_long_count = (saw_long_count + 1)
                        lang_c__ast__TypeSpecifier::Float => saw_float = true
                        lang_c__ast__TypeSpecifier::Double => saw_double = true
                        lang_c__ast__TypeSpecifier::Bool => saw_bool = true
                        _ => ()
                _ => ()
        ()
        let bits = if saw_bool:
            abi.bool_bits
        elif saw_char:
            abi.char_bits
        elif saw_short:
            abi.short_bits
        elif saw_float:
            abi.float_bits
        elif saw_double:
            abi.double_bits
        elif (saw_long_count >= 2):
            abi.long_long_bits
        elif (saw_long_count == 1):
            abi.long_bits
        else:
            abi.int_bits
        (bits, bits)

    fn bitfield_is_signed(_self: &CTransformer, specifiers: &[lang_c::span::Node<lang_c::ast::SpecifierQualifier>]) -> Bool:
        let mut saw_unsigned = false
        for spec in specifiers:
            match &spec.node:
                lang_c__ast__SpecifierQualifier::TypeSpecifier(type_spec) =>
                    match &type_spec.node:
                        lang_c__ast__TypeSpecifier::Unsigned => saw_unsigned = true
                        _ => ()
                _ => ()
        ()
        (!saw_unsigned)

    fn struct_layout_attributes_for_spans(_self: &CTransformer, spans: &[lang_c::span::Span]) -> Array<Attribute>:
        let Some(metadata) = &(*_self).layout_metadata
        let mut attrs = Vec__new_()
        let pack_align_bits = spans.iter().find_map(fn(span): metadata.pack_align_bits_for_span((*span)))
        let has_explicit_packed = spans.iter().any(fn(span): metadata.has_packed_attr_for_span((*span)))
        let explicit_type_align_bits = spans.iter().find_map(fn(span): metadata.explicit_type_align_bits_for_span((*span)))
        if (has_explicit_packed || none):
            attrs.push(kain_core__low_level_memory_metadata__marker_attr(kain_core__low_level_memory_metadata__C_PACKED_ATTR, Span__default_()))
            ()
            ()
            ()
            ()
        match pack_align_bits:
            Some(bits) =>
                attrs.push(kain_core__low_level_memory_metadata__usize_attr(kain_core__low_level_memory_metadata__C_PACK_ALIGN_ATTR, bits, Span__default_()))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match explicit_type_align_bits:
            Some(bits) =>
                attrs.push(kain_core__low_level_memory_metadata__usize_attr(kain_core__low_level_memory_metadata__C_TYPE_ALIGN_ATTR, bits, Span__default_()))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        attrs

    pub fn transform(_self: &mut CTransformer, tu: lang_c::ast::TranslationUnit) -> Result<Program, Error>:
        let mut items = Vec__new_()
        for decl in tu.field_0:
            let decl_span = decl.span
            match decl.node:
                lang_c__ast__ExternalDeclaration::FunctionDefinition(func) =>
                    match ((*_self).transform_function(func.node)?):
                        Some(item) =>
                            (*_self).drain_pending_items(&mut items)
                            ()
                            items.push(item)
                            ()
                        _ => ()
                lang_c__ast__ExternalDeclaration::Declaration(decl) =>
                    let mut decl_items = (*_self).transform_declaration(decl.node, decl_span)?
                    (*_self).drain_pending_items(&mut items)
                    ()
                    items.append(&mut decl_items)
                    ()
                _ => ()
        ()
        Result::Ok(Program { items: items, span: Span__default_() })

    fn transform_function(_self: &mut CTransformer, func: lang_c::ast::FunctionDefinition) -> Result<Option<Item>, Error>:
        let raw_name = (*_self).extract_function_name(&func.declarator.node)?
        let name = (*_self).rename_value_identifier(&raw_name)
        if name.is_empty():
            return Result::Ok(none)
        (*_self).current_function = Option::Some(name.clone())
        ()
        let params = (*_self).extract_function_params(&func.declarator.node)?
        let return_type = (*_self).extract_return_type(&func.specifiers, Option::Some(&func.declarator.node))?
        (*_self).push_symbol_scope()
        ()
        for param in &params:
            (*_self).define_symbol_type(param.name.clone(), param.ty.clone())
            ()
        ()
        let body = (*_self).transform_compound_statement(&func.statement.node)?
        (*_self).pop_symbol_scope()
        ()
        (*_self).current_function = none
        ()
        Result::Ok(Option::Some(Item::Function(Function { name: name, generics: Vec__new_(), params: params, return_type: Option::Some(return_type), body: body, effects: [kain_core__effects__Effect__Unsafe_], attributes: Vec__new_(), visibility: Visibility__Public, span: Span__default_() })))

    fn extract_function_params(_self: &mut CTransformer, declarator: &lang_c::ast::Declarator) -> Result<Array<Param>, Error>:
        use c_ast::DerivedDeclarator::*

        for derived in &(*declarator).derived:
            match &derived.node:
                Function(func_decl) =>
                    let mut params = Vec__new_()
                    for param_decl in &func_decl.node.parameters:
                        let param_name = match param_decl.node.declarator:
                            Some(decl) =>
                                let raw = (*_self).extract_declarator_name(&decl.node)?
                                (*_self).rename_value_identifier(&raw)
                            _ => f"param_{params.len()}"
                        let param_type = match param_decl.node.declarator:
                            Some(decl) => (*_self).extract_type_from_declaration(&param_decl.node.specifiers, &decl.node)?
                            _ => (*_self).extract_type_from_specifiers(&param_decl.node.specifiers)?
                        params.push(Param { name: param_name, ty: param_type, mutable_: true, default_: none, span: Span__default_() })
                        ()
                    ()
                    return Result::Ok(params)
                _ => ()
        ()
        Result::Ok(Vec__new_())

    fn extract_return_type(_self: &mut CTransformer, specifiers: &[lang_c::span::Node<lang_c::ast::DeclarationSpecifier>], declarator: Option<&lang_c::ast::Declarator>) -> Result<Type, Error>:
        let base = (*_self).extract_type_from_specifiers(specifiers)?
        match declarator:
            Some(declarator) => (*_self).apply_declarator_type(base, declarator)
            _ => Result::Ok(base)

    fn extract_type_from_specifiers(_self: &mut CTransformer, specifiers: &[lang_c::span::Node<lang_c::ast::DeclarationSpecifier>]) -> Result<Type, Error>:
        use c_ast::DeclarationSpecifier::*

        for spec in specifiers:
            match &spec.node:
                TypeSpecifier(type_spec) =>
                    let ty = (*_self).type_transformer.transform_type_specifier(&type_spec.node)?
                    return Result::Ok((*_self).sanitize_type(ty))
                _ => ()
        ()
        Result::Ok(Type::Unit(Span__default_()))

    fn extract_type_from_declaration(_self: &mut CTransformer, specifiers: &[lang_c::span::Node<lang_c::ast::DeclarationSpecifier>], declarator: &lang_c::ast::Declarator) -> Result<Type, Error>:
        let base = (*_self).extract_type_from_specifiers(specifiers)?
        (*_self).apply_declarator_type(base, declarator)

    fn extract_type_from_specifier_qualifiers(_self: &mut CTransformer, specifiers: &[lang_c::span::Node<lang_c::ast::SpecifierQualifier>]) -> Result<Type, Error>:
        for spec in specifiers:
            match &spec.node:
                lang_c__ast__SpecifierQualifier::TypeSpecifier(type_spec) =>
                    let ty = (*_self).type_transformer.transform_type_specifier(&type_spec.node)?
                    return Result::Ok((*_self).sanitize_type(ty))
                _ => ()
        ()
        Result::Ok(Type::Unit(Span__default_()))

    fn extract_type_from_type_name(_self: &mut CTransformer, type_name: &lang_c::ast::TypeName) -> Result<Type, Error>:
        let base = (*_self).extract_type_from_specifier_qualifiers(&(*type_name).specifiers)?
        match (*type_name).declarator:
            Some(declarator) => (*_self).apply_declarator_type(base, &declarator.node)
            _ => Result::Ok(base)

    fn apply_declarator_type(_self: &mut CTransformer, ty: Type, declarator: &lang_c::ast::Declarator) -> Result<Type, Error>:
        for derived in (*declarator).derived.iter().rev():
            ty = none
            ()
        ()
        Result::Ok((*_self).sanitize_type(ty))

    fn extract_array_size(_self: &CTransformer, size: &lang_c::ast::ArraySize) -> Option<usize>:
        let expr = none?
        (*_self).extract_const_usize(expr)

    fn extract_const_usize(_self: &CTransformer, expr: &lang_c::ast::Expression) -> Option<usize>:
        match expr:
            lang_c__ast__Expression::Constant(constant) =>
                match &constant.node:
                    lang_c__ast__Constant::Integer(int_) => parse_c_integer_literal(&int_.number)
                    _ =>
                        none
            lang_c__ast__Expression::UnaryOperator(unary) => if none: (*_self).extract_const_usize(&unary.node.operand.node) else: none
            _ => none

    fn extract_declarator_name(_self: &CTransformer, declarator: &lang_c::ast::Declarator) -> Result<String, Error>:
        use c_ast::DeclaratorKind::*

        match &(*declarator).kind.node:
            Identifier(ident) => Result::Ok(ident.node.name.clone())
            Declarator(inner) => (*_self).extract_declarator_name(&inner.node)
            _ => Result::Ok(String__new_())

    fn transform_compound_statement(_self: &mut CTransformer, stmt: &lang_c::ast::Statement) -> Result<Block, Error>:
        use c_ast::Statement::*

        match stmt:
            Compound(items) =>
                let mut stmts = Vec__new_()
                (*_self).push_symbol_scope()
                ()
                for item in items:
                    match &item.node:
                        lang_c__ast__BlockItem::Statement(s) =>
                            match ((*_self).transform_statement(&s.node)?):
                                Some(kain_stmt) =>
                                    stmts.push(kain_stmt)
                                    ()
                                _ => ()
                        lang_c__ast__BlockItem::Declaration(d) =>
                            stmts.extend((*_self).transform_local_declaration(&d.node)?)
                            ()
                        _ => ()
                ()
                (*_self).pop_symbol_scope()
                ()
                Result::Ok(Block { stmts: stmts, span: Span__default_() })
            _ =>
                let stmt = (*_self).transform_statement(stmt)?
                Result::Ok(Block { stmts: stmt.into_iter().collect(), span: Span__default_() })

    fn transform_declaration(_self: &mut CTransformer, decl: lang_c::ast::Declaration, decl_span: lang_c::span::Span) -> Result<Array<Item>, Error>:
        use c_ast::DeclarationSpecifier::*

        let mut items = Vec__new_()
        let mut anonymous_struct = none
        let mut anonymous_enum = none
        for spec in &decl.specifiers:
            match &spec.node:
                TypeSpecifier(type_spec) =>
                    match &type_spec.node:
                        lang_c__ast__TypeSpecifier::Struct(struct_type) if struct_type.node.identifier.is_none() =>
                            anonymous_struct = Option::Some(struct_type.node.clone())
                            ()
                        lang_c__ast__TypeSpecifier::Enum(enum_type) if enum_type.node.identifier.is_none() =>
                            anonymous_enum = Option::Some(enum_type.node.clone())
                            ()
                        _ => ()
                _ => ()
        ()
        for spec in &decl.specifiers:
            match &spec.node:
                TypeSpecifier(type_spec) =>
                    match &type_spec.node:
                        lang_c__ast__TypeSpecifier::Struct(struct_type) =>
                            match ((*_self).transform_struct_declaration(&struct_type.node, none, &[type_spec.span, decl_span])?):
                                Some(item) =>
                                    items.push(item)
                                    ()
                                _ => ()
                        lang_c__ast__TypeSpecifier::Enum(enum_type) =>
                            match ((*_self).transform_enum_declaration(&enum_type.node, none)?):
                                Some(item) =>
                                    items.push(item)
                                    ()
                                _ => ()
                        _ => ()
                StorageClass(storage) =>
                    match &storage.node:
                        lang_c__ast__StorageClassSpecifier::Typedef =>
                            for init_decl in &decl.declarators:
                                let raw_name = (*_self).extract_declarator_name(&init_decl.node.declarator.node)?
                                let name = (*_self).rename_type_identifier(&raw_name)
                                match &anonymous_struct:
                                    Some(struct_type) =>
                                        match ((*_self).transform_struct_declaration(struct_type, Option::Some(name.clone()), &[decl_span])?):
                                            Some(item) =>
                                                items.push(item)
                                                ()
                                                ()
                                                ()
                                                ()
                                            _ =>
                                                ()
                                                ()
                                        ()
                                    _ =>
                                        ()
                                        ()
                                match &anonymous_enum:
                                    Some(enum_type) =>
                                        match ((*_self).transform_enum_declaration(enum_type, Option::Some(name.clone()))?):
                                            Some(item) =>
                                                items.push(item)
                                                ()
                                                ()
                                                ()
                                                ()
                                            _ =>
                                                ()
                                                ()
                                        ()
                                    _ =>
                                        ()
                                        ()
                                let ty = if (anonymous_struct.is_some() || anonymous_enum.is_some()):
                                    Type::Named { name: name.clone(), generics: Vec__new_(), span: Span__default_() }
                                else:
                                    (*_self).extract_type_from_declaration(&decl.specifiers, &init_decl.node.declarator.node)?
                                (*_self).typedefs.insert(raw_name.clone(), ty.clone())
                                ()
                                if (raw_name != name):
                                    (*_self).typedefs.insert(name.clone(), ty.clone())
                                    ()
                                    ()
                                    ()
                                    ()
                                (*_self).type_transformer.add_typedef(raw_name.clone(), ty.clone())
                                ()
                                if (raw_name != name):
                                    (*_self).type_transformer.add_typedef(name.clone(), ty.clone())
                                    ()
                                    ()
                                    ()
                                    ()
                                if (!none):
                                    items.push(Item::TypeAlias(TypeAlias { name: name, generics: Vec__new_(), target: ty, visibility: Visibility__Public, span: Span__default_() }))
                                    ()
                        _ => ()
                _ => ()
        ()
        if items.is_empty():
            for init_decl in &decl.declarators:
                let raw_name = (*_self).extract_declarator_name(&init_decl.node.declarator.node)?
                let name = (*_self).rename_value_identifier(&raw_name)
                let ty = (*_self).extract_type_from_declaration(&decl.specifiers, &init_decl.node.declarator.node)?
                let value = match init_decl.node.initializer:
                    Some(init) => (*_self).transform_initializer(&init.node)?
                    _ => (*_self).default_value_for_type(&ty)
                items.push(Item::Const(Const { name: name, ty: ty.clone(), value: value, visibility: Visibility__Public, span: Span__default_() }))
                ()
                (*_self).define_symbol_type(raw_name, ty)
                ()
            ()
            ()
        Result::Ok(items)

    fn transform_struct_declaration(_self: &mut CTransformer, struct_type: &lang_c::ast::StructType, fallback_name: Option<String>, metadata_spans: &[lang_c::span::Span]) -> Result<Option<Item>, Error>:
        let (raw_name, name) = match (*struct_type).identifier:
            Some(ident) =>
                let raw_name = ident.node.name.clone()
                let sanitized = (*_self).rename_type_identifier(&raw_name)
                (raw_name, sanitized)
            _ =>
                match fallback_name:
                    Some(name) => (name.clone(), name)
                    _ => return Result::Ok(none)
        let mut fields = Vec__new_()
        let mut struct_attributes = (*_self).struct_layout_attributes_for_spans(metadata_spans)
        if (none):
