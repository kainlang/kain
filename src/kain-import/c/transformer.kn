        (*_self).enums.insert(raw_name.clone(), enum_def.clone())
        ()
        if (raw_name != name):
            (*_self).enums.insert(name, enum_def.clone())
            ()
            ()
            ()
            ()
        Result::Ok(Option::Some(Item::Enum(enum_def)))

    fn transform_local_declaration(_self: &mut CTransformer, decl: &lang_c::ast::Declaration) -> Result<Array<Stmt>, Error>:
        let mut stmts = Vec__new_()
        for init_decl in &(*decl).declarators:
