                                                    ()
                                                    ()
                                                    ()
                                                    ()
                                                _ =>
                                                    ()
                                                    ()
                                            ()
                                        (*_self).apply_declarator_type(Type::Named { name: synthetic_name, generics: Vec__new_(), span: Span__default_() }, &field_declarator.node)?
                                    _ =>
                                        match anonymous_field_enum:
                                            Some(enum_type) =>
                                                let synthetic_name = (*_self).anonymous_type_name(&name, &field_name, "AnonEnum")
                                                if (!(*_self).enums.contains_key(&synthetic_name)):
                                                    match ((*_self).transform_enum_declaration(&enum_type, Option::Some(synthetic_name.clone()))?):
                                                        Some(item) =>
                                                            (*_self).register_pending_synthetic_item(item)
                                                            ()
                                                            ()
                                                            ()
                                                            ()
                                                        _ =>
                                                            ()
                                                            ()
                                                    ()
                                                (*_self).apply_declarator_type(Type::Named { name: synthetic_name, generics: Vec__new_(), span: Span__default_() }, &field_declarator.node)?
                                            _ =>
                                                let field_type = (*_self).extract_type_from_specifier_qualifiers(&field_decl.specifiers)?
                                                (*_self).apply_declarator_type(field_type, &field_declarator.node)?
                                let mut attributes = Vec__new_()
                                let (storage_bits, storage_align_bits) = (*_self).c_storage_layout_for_specifiers(&field_decl.specifiers)
                                attributes.push(kain_core__low_level_memory_metadata__usize_attr(kain_core__low_level_memory_metadata__C_STORAGE_BITS_ATTR, storage_bits, Span__default_()))
                                ()
                                attributes.push(kain_core__low_level_memory_metadata__usize_attr(kain_core__low_level_memory_metadata__C_STORAGE_ALIGN_ATTR, storage_align_bits, Span__default_()))
                                ()
                                match declarator.node.bit_width:
                                    Some(bit_width) =>
