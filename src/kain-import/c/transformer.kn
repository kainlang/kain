                                        attributes.push(kain_core__low_level_memory_metadata__usize_bool_attr(kain_core__low_level_memory_metadata__C_BITFIELD_ATTR, width, (*_self).bitfield_is_signed(&field_decl.specifiers), Span__default_()))
