            Type::Unit(_) => Expr::Tuple(Vec__new_(), S)
            Type::Never(_) => Expr::Tuple(Vec__new_(), S)
            Type::Function {  } => Expr::Tuple(Vec__new_(), S)
            Type::Impl {  } => Expr::Tuple(Vec__new_(), S)
            Type::Infer(_) => Expr::Tuple(Vec__new_(), S)

    fn transform_impl(_self: &mut RustTransformer, i: &syn::ItemImpl) -> Result<Impl, Error>:
