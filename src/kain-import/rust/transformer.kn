            Expr::AggregateInit { ty: ty, fields: fields, zero_fill_rest: zero_fill_rest, span: span } => Expr::AggregateInit { ty: ty, fields: fields.into_iter().map(fn(__kain_closure_arg10): (__kain_closure_arg10.__kain_tuple_0, RustTransformer__normalize_const_expr(__kain_closure_arg10.__kain_tuple_1))).collect(), zero_fill_rest: zero_fill_rest, span: span }
            Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: fields, span: span } => Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: none, span: span }
            other => other

    fn normalize_for_iter_expr(expr: Expr) -> Expr:
        match expr:
            Expr::Paren(inner, _) => RustTransformer__normalize_for_iter_expr((*inner))
            other => other

    fn transform_type_alias(_self: &mut RustTransformer, t: &syn::ItemType) -> Result<TypeAlias, Error>:
        let name = (*_self).rename_type(&(*t).ident.to_string())
        let generics = (*_self).type_mapper.map_generic_params(&(*t).generics.params)
