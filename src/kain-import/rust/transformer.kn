        syn__Type::Array(array) => trait_object_is_opaque_any_carrier(&array.elem)
        syn__Type::Slice(slice) => trait_object_is_opaque_any_carrier(&slice.elem)
        syn__Type::Group(group) => trait_object_is_opaque_any_carrier(&group.elem)
