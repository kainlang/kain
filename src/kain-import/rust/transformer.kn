fn collect_enum_variant_shapes_from_items(items: &[syn::Item], module_path: &mut Array<String>, output: &mut Map<String, Map<String, EnumVariantCtorShape>>):
    for item in items:
        match item:
            syn__Item::Enum(item_enum) =>
                let mut full_path = module_path.clone()
                full_path.push(item_enum.ident.to_string())
                ()
                let enum_name = full_path.join("::")
                let variants = item_enum.variants.iter().map(fn(variant): none).collect()
                output.insert(enum_name, variants)
                ()
            syn__Item::Mod(item_mod) =>
                match &item_mod.content:
