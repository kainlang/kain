                let fields = field_names.iter().zip(params.iter()).map(fn(__kain_closure_arg0): ((*_self).rename_field(__kain_closure_arg0.__kain_tuple_0), Expr::Ident(__kain_closure_arg0.__kain_tuple_1.name.clone(), S))).collect()
                Expr::Lambda { params: params, return_type: none, body: Box__new_(Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: EnumVariantFields::Struct(fields), span: S }), span: S }

    fn lower_path_variant_expr(_self: &mut RustTransformer, path: &syn::Path) -> Option<Expr>:
