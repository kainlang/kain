            Type::Named { name: name } if none => Expr::Float(0, S)
            Type::Named { name: name } if (name == "String") => Expr::Call { callee: Box__new_(Expr::Ident(("String__new_").to_string(), S)), args: Vec__new_(), span: S }
            Type::Named { name: name } if (name == "Array") => Expr::Call { callee: Box__new_(Expr::Ident(("Vec__new_").to_string(), S)), args: Vec__new_(), span: S }
            Type::Named { name: name } if (name == "Map") => Expr::Call { callee: Box__new_(Expr::Ident(("HashMap__new_").to_string(), S)), args: Vec__new_(), span: S }
            Type::Named { name: name } if (name == "Set") => Expr::Call { callee: Box__new_(Expr::Ident(("HashSet__new_").to_string(), S)), args: Vec__new_(), span: S }
