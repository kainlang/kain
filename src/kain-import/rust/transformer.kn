                ()
                Result::Ok([])
            _ =>
                (*_self).note_lossy(("unknown item kind skipped").to_string())
                ()
                Result::Ok([])

    fn transform_mod(_self: &mut RustTransformer, m: &syn::ItemMod) -> Result<Array<Item>, Error>:
        if (*_self).should_skip_module(m):
