    fn transform_block(_self: &mut RustTransformer, block: &syn::Block) -> Result<Block, Error>:
        (*_self).push_scope()
        ()
        let mut stmts = Vec__new_()
        for selfhost_for_item in (*block).stmts.iter().enumerate():
            let (index, stmt) = selfhost_for_item
            let is_tail_stmt = ((index + 1) == (*block).stmts.len())
            stmts.extend((*_self).transform_stmt(stmt, is_tail_stmt)?)
            ()
        ()
        (*_self).pop_scope()
        ()
        Result::Ok(Block { stmts: stmts, span: S })

    fn transform_stmt(_self: &mut RustTransformer, stmt: &syn::Stmt, is_tail_stmt: Bool) -> Result<Array<Stmt>, Error>:
        match stmt:
            syn__Stmt::Local(local) =>
                let pattern = (*_self).transform_pattern(&local.pat)
                let ty = (*_self).type_from_local_pat(&local.pat)
