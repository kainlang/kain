                        collect_enum_variant_shapes_from_items(nested, module_path, output)
                        ()
                        module_path.pop()
                        ()
                    _ => ()
            _ => ()

fn starts_with_uppercase(value: String) -> Bool:
    value.chars().next().is_some_and(fn(ch): ch.is_ascii_uppercase())

fn has_cfg_test_attr(attrs: &[syn::Attribute]) -> Bool:
    attrs.iter().any(fn(attr): (attr.path().is_ident("cfg") && attr.parse_args().is_ok_and(fn(ident): (ident == "test"))))

