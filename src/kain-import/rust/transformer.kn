    fn transform_item(_self: &mut RustTransformer, item: &syn::Item) -> Result<Array<Item>, Error>:
        if (*_self).should_skip_item(item):
            return Result::Ok([])
        match item:
            syn__Item::Fn(f) => Result::Ok(((*_self).transform_fn(f)?).into_iter().map(Item__Function).collect())
            syn__Item::Struct(s) =>
                let struct_item = (*_self).transform_struct(s)?
                let mut items = [Item::Struct(struct_item)]
                match ((*_self).synthesize_derived_default_impl_for_struct(s)?):
                    Some(default_impl) =>
                        items.push(Item::Impl(default_impl))
                        ()
                        ()
                        ()
                        ()
                    _ =>
