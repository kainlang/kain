    fn collect_use_tree(_self: &mut RustTransformer, prefix: Array<String>, tree: &syn::UseTree, items: &mut Array<Item>) -> Result<(), Error>:
        match tree:
            syn__UseTree::Path(path) =>
                let mut next_prefix = prefix
                next_prefix.push(path.ident.to_string())
                ()
                (*_self).collect_use_tree(next_prefix, &path.tree, items)
            syn__UseTree::Name(name) =>
                if (name.ident == "self"):
                    match prefix.last().cloned():
                        Some(visible) =>
                            (*_self).type_mapper.register_visible_path(visible, prefix.clone())
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    items.push(Item::Use(Use { path: prefix, alias: none, glob: false, span: S }))
                    ()
                    ()
                    ()
                    ()
                else:
                    let mut full_path = prefix
                    full_path.push(name.ident.to_string())
                    ()
                    (*_self).type_mapper.register_visible_path(name.ident.to_string(), full_path.clone())
                    ()
                    items.push(Item::Use(Use { path: full_path, alias: none, glob: false, span: S }))
                    ()
                    ()
                    ()
                    ()
                Result::Ok(())
            syn__UseTree::Rename(rename) =>
                let mut full_path = prefix
                full_path.push(rename.ident.to_string())
                ()
                (*_self).type_mapper.register_visible_path(rename.rename.to_string(), full_path.clone())
                ()
                items.push(Item::Use(Use { path: full_path, alias: Option::Some(rename.rename.to_string()), glob: false, span: S }))
                ()
                Result::Ok(())
            syn__UseTree::Glob(_) =>
                items.push(Item::Use(Use { path: prefix, alias: none, glob: true, span: S }))
                ()
                Result::Ok(())
            syn__UseTree::Group(group) =>
                for item in &group.items:
                    (*_self).collect_use_tree(prefix.clone(), item, items)?
                    ()
                ()
                Result::Ok(())

