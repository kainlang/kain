        syn__Type::Ptr(pointer) => trait_like_type_name(&pointer.elem)
        syn__Type::Array(array) => trait_like_type_name(&array.elem)
        syn__Type::Slice(slice) => trait_like_type_name(&slice.elem)
        syn__Type::Group(group) => trait_like_type_name(&group.elem)
        syn__Type::Paren(paren) => trait_like_type_name(&paren.elem)
        syn__Type::Tuple(tuple) => tuple.elems.iter().find_map(trait_like_type_name)
