        if (resolved.len() < 2):
            return none
        let variant = (resolved.last()?).clone()
        let enum_name = (*_self).normalize_variant_enum_name(&resolved[..(resolved.len() - 1)])
        (*_self).enum_variant_shapes.get(&enum_name).and_then(fn(variants): variants.get(&variant)).cloned().map(fn(shape): (enum_name, variant, shape))

    fn fallback_explicit_variant_head(_self: &mut RustTransformer, resolved: &[String]) -> Option<(String, String)>:
        if (resolved.len() < 2):
            return none
        let variant = (resolved.last()?).clone()
        let enum_segments = &resolved[..(resolved.len() - 1)]
        let enum_tail = enum_segments.last()?
        ((starts_with_uppercase(&variant) && looks_like_type_name(enum_tail))).then(fn(): ((*_self).normalize_variant_enum_name(enum_segments), variant))

    fn make_variant_constructor_lambda(_self: &mut RustTransformer, enum_name: String, variant: String, shape: EnumVariantCtorShape) -> Expr:
        match shape:
            EnumVariantCtorShape::Unit => Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: EnumVariantFields__Unit, span: S }
