    fn transform_const(_self: &mut RustTransformer, c: &syn::ItemConst) -> Result<Const, Error>:
        let name = (*_self).rename_value(&(*c).ident.to_string())
        let ty = RustTransformer__normalize_const_type((*_self).map_type_checked(&(*c).ty))
        let value = RustTransformer__normalize_const_expr((*_self).transform_expr(&(*c).expr)?)
        Result::Ok(Const { name: name, ty: ty, value: value, visibility: visibility(&(*c).vis), span: S })

    fn transform_static(_self: &mut RustTransformer, s: &syn::ItemStatic) -> Result<Const, Error>:
