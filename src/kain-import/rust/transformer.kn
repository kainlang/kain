@derive(Clone, Copy)
struct AssociatedConstructorRewrite:
    source_path: &static [String]
    target_path: &static [String]
    exact_arg_count: usize

const ASSOCIATED_CONSTRUCTOR_REWRITES: Array<AssociatedConstructorRewrite> = [AssociatedConstructorRewrite { source_path: ["Vec", "with_capacity"], target_path: ["Vec", "new"], exact_arg_count: 1 }, AssociatedConstructorRewrite { source_path: ["String", "with_capacity"], target_path: ["String", "new"], exact_arg_count: 1 }, AssociatedConstructorRewrite { source_path: ["HashMap", "with_capacity"], target_path: ["HashMap", "new"], exact_arg_count: 1 }, AssociatedConstructorRewrite { source_path: ["std", "collections", "HashMap", "with_capacity"], target_path: ["std", "collections", "HashMap", "new"], exact_arg_count: 1 }, AssociatedConstructorRewrite { source_path: ["HashSet", "with_capacity"], target_path: ["HashSet", "new"], exact_arg_count: 1 }, AssociatedConstructorRewrite { source_path: ["std", "collections", "HashSet", "with_capacity"], target_path: ["std", "collections", "HashSet", "new"], exact_arg_count: 1 }]

fn visibility(vis: &syn::Visibility) -> Visibility:
    match vis:
        syn__Visibility::Public(_) => Visibility__Public
        syn__Visibility::Restricted(restricted) => if restricted.in_token.is_none(): none else: Visibility__Private
        _ => Visibility__Private

fn has_derive_attr(attrs: &[syn::Attribute], derive_name: String) -> Bool:
    attrs.iter().any(fn(attr): none)

fn has_default_variant_attr(attrs: &[syn::Attribute]) -> Bool:
    attrs.iter().any(fn(attr): attr.path().is_ident("default"))

fn path_to_ident(path: &syn::Path) -> String:
    (*path).segments.iter().map(fn(s): s.ident.to_string()).collect().join("::")

fn rewrite_associated_constructor_path(resolved: &[String], arg_count: usize) -> Option<Array<String>>:
    ASSOCIATED_CONSTRUCTOR_REWRITES.iter().find(fn(rewrite): (((rewrite.exact_arg_count == arg_count) && (rewrite.source_path.len() == resolved.len())) && rewrite.source_path.iter().zip(resolved.iter()).all(fn(__kain_closure_arg21): ((*__kain_closure_arg21.__kain_tuple_0) == __kain_closure_arg21.__kain_tuple_1)))).map(fn(rewrite): rewrite.target_path.iter().map(fn(segment): ((*segment)).to_string()).collect())

fn looks_like_type_name(segment: String) -> Bool:
    segment.chars().next().is_some_and(fn(ch): ch.is_ascii_uppercase())

fn normalize_local_type_name(name: String) -> Option<String>:
    let mut segments = name.split("::")
    let root = segments.next()?
    if (!none):
        return none
    let final_segment = name.rsplit("::").next()?
    if (!looks_like_type_name(final_segment)):
        return none
    Option::Some(final_segment.to_string())

fn collect_enum_variant_shapes(items: &[syn::Item]) -> Map<String, Map<String, EnumVariantCtorShape>>:
    let mut shapes = HashMap__new_()
    let mut module_path = Vec__new_()
    collect_enum_variant_shapes_from_items(items, &mut module_path, &mut shapes)
