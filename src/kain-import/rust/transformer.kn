                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                Result::Ok(items)
            syn__Item::Impl(i) => Result::Ok([Item::Impl((*_self).transform_impl(i)?)])
            syn__Item::Const(c) => Result::Ok([Item::Const((*_self).transform_const(c)?)])
            syn__Item::Static(s) => Result::Ok([Item::Const((*_self).transform_static(s)?)])
            syn__Item::Type(t) => Result::Ok([Item::TypeAlias((*_self).transform_type_alias(t)?)])
            syn__Item::Mod(m) => (*_self).transform_mod(m)
            syn__Item::Use(u) => (*_self).transform_use(u)
            syn__Item::Trait(t) => Result::Ok([Item::Trait((*_self).transform_trait(t)?)])
            syn__Item::TraitAlias(t) =>
