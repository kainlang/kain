        let ty = RustTransformer__normalize_const_type((*_self).map_type_checked(&(*s).ty))
        let value = RustTransformer__normalize_const_expr((*_self).transform_expr(&(*s).expr)?)
        Result::Ok(Const { name: name, ty: ty, value: value, visibility: visibility(&(*s).vis), span: S })

    fn normalize_const_type(ty: Type) -> Type:
        match ty:
            Type::Ref { inner: inner } => RustTransformer__normalize_const_type((*inner))
            Type::Slice(inner, span) => Type::Named { name: ("Array").to_string(), generics: [RustTransformer__normalize_const_type((*inner))], span: span }
            Type::Array(inner, size, span) => Type::Array(Box__new_(RustTransformer__normalize_const_type((*inner))), size, span)
            Type::Tuple(types, span) => Type::Tuple(types.into_iter().map(RustTransformer__normalize_const_type).collect(), span)
            Type::Option(inner, span) => Type::Option(Box__new_(RustTransformer__normalize_const_type((*inner))), span)
            Type::Result(ok, err, span) => Type::Result(Box__new_(RustTransformer__normalize_const_type((*ok))), Box__new_(RustTransformer__normalize_const_type((*err))), span)
            Type::Named { name: name, generics: generics, span: span } => Type::Named { name: name, generics: generics.into_iter().map(RustTransformer__normalize_const_type).collect(), span: span }
            Type::Ptr { mutable_: mutable_, inner: inner, provenance: provenance, span: span } => Type::Ptr { mutable_: mutable_, inner: Box__new_(RustTransformer__normalize_const_type((*inner))), provenance: provenance, span: span }
            Type::Function { params: params, return_type: return_type, effects: effects, span: span } => Type::Function { params: params.into_iter().map(RustTransformer__normalize_const_type).collect(), return_type: Box__new_(RustTransformer__normalize_const_type((*return_type))), effects: effects, span: span }
            Type::Impl { trait_name: trait_name, generics: generics, span: span } => Type::Impl { trait_name: trait_name, generics: generics.into_iter().map(RustTransformer__normalize_const_type).collect(), span: span }
            Type::Never(span) => Type::Never(span)
            Type::Infer(span) => Type::Infer(span)
            Type::Unit(span) => Type::Unit(span)

    fn normalize_const_expr(expr: Expr) -> Expr:
        match expr:
            Expr::Ref { value: value } => RustTransformer__normalize_const_expr((*value))
            Expr::Paren(inner, _) => RustTransformer__normalize_const_expr((*inner))
            Expr::Array(values, span) => Expr::Array(values.into_iter().map(RustTransformer__normalize_const_expr).collect(), span)
            Expr::Tuple(values, span) => Expr::Tuple(values.into_iter().map(RustTransformer__normalize_const_expr).collect(), span)
