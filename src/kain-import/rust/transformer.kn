    fn transform_fn(_self: &mut RustTransformer, f: &syn::ItemFn) -> Result<Array<Function>, Error>:
        let name = (*_self).rename_value(&(*f).sig.ident.to_string())
        (*_self).current_function = Option::Some(name.clone())
