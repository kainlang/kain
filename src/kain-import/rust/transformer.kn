use super::types::RustTypeMapper

use crate::common::identifier_registry::IdentifierDomain

use crate::common::identifier_registry::StableIdentifierRenamer

use crate::Result

use kain_core::ast::*

use kain_core::effects::Effect

use kain_core::span::Span

use std::collections::HashMap

use std::collections::HashSet

use syn

@derive(Debug, Clone, Default)
pub struct RustTransformOptions:
    strict_selfhost: Bool
    macro_policy: RustMacroPolicy

impl Default for RustTransformOptions:
    pub fn default_() -> RustTransformOptions:
        RustTransformOptions { strict_selfhost: false, macro_policy: RustMacroPolicy__default_() }


@derive(Debug, Clone, Default)
pub struct RustMacroPolicy:
    lower_directly: Set<String>
    preserve: Set<String>
    reject: Set<String>

impl Default for RustMacroPolicy:
    pub fn default_() -> RustMacroPolicy:
        RustMacroPolicy { lower_directly: HashSet__new_(), preserve: HashSet__new_(), reject: HashSet__new_() }


impl RustMacroPolicy:
    pub fn phase1_default() -> RustMacroPolicy:
        RustMacroPolicy { lower_directly: (["assert", "assert_eq", "debug_assert", "eprint", "eprintln", "format", "matches", "panic", "print", "println", "unreachable", "vec", "write", "writeln"]).into_iter().map(str__to_string).collect(), preserve: (["cfg", "derive", "arg", "command", "error", "from", "test"]).into_iter().map(str__to_string).collect(), reject: HashSet__new_() }


enum EnumVariantCtorShape:
    Unit
    Tuple(usize)
    Struct(Array<String>)

pub struct RustTransformer:
    type_mapper: RustTypeMapper
    identifier_renamer: StableIdentifierRenamer
    generics_in_scope: Array<String>
    current_function: Option<String>
    current_impl_target: Option<Type>
    local_types: Array<Map<String, Type>>
    value_substitutions: Array<Map<String, Expr>>
    closure_param_counter: usize
    enum_variant_shapes: Map<String, Map<String, EnumVariantCtorShape>>
    diagnostics: Array<String>
    reported_diagnostic_keys: Set<String>
    options: RustTransformOptions

impl RustTransformer:
    pub fn new_() -> RustTransformer:
        RustTransformer__with_options(RustTransformOptions__default_())

    pub fn new_selfhost() -> RustTransformer:
        RustTransformer__with_options(RustTransformOptions { strict_selfhost: true, macro_policy: RustMacroPolicy__phase1_default() })

    pub fn with_options(options: RustTransformOptions) -> RustTransformer:
        let type_mapper = if options.strict_selfhost:
            RustTypeMapper__new_selfhost()
        else:
            RustTypeMapper__new_()
        RustTransformer { type_mapper: type_mapper, identifier_renamer: StableIdentifierRenamer__default_(), generics_in_scope: Vec__new_(), current_function: none, current_impl_target: none, local_types: [HashMap__new_()], value_substitutions: [HashMap__new_()], closure_param_counter: 0, enum_variant_shapes: HashMap__new_(), diagnostics: Vec__new_(), reported_diagnostic_keys: HashSet__new_(), options: options }

    fn transform_attributes(_self: &mut RustTransformer, attrs: &[syn::Attribute]) -> Array<Attribute>:
        let mut lowered = Vec__new_()
        for attr in attrs:
            let name = path_to_ident(attr.path())
            let args = match &attr.meta:
                syn__Meta::Path(_) => Vec__new_()
                syn__Meta::List(_) =>
                    let parsed = attr.parse_args_with(Punctuated__parse_terminated)
                    match parsed:
                        Ok(exprs) => exprs.iter().filter_map(fn(expr): (*_self).transform_attr_expr(expr).ok()).collect()
                        Err(err) =>
                            (*_self).note_lossy_class("attribute_lowering", f"attribute {name} args skipped: {err}")
                            ()
                            Vec__new_()
                syn__Meta::NameValue(value) =>
                    let target = Expr::Ident(path_to_ident(&value.path), S)
                    let value = (*_self).transform_attr_expr(&value.value).unwrap_or_else(fn(_): Expr::None(S))
                    [Expr::Assign { target: Box__new_(target), value: Box__new_(value), span: S }]
            lowered.push(Attribute { name: name, args: args, span: S })
            ()
        ()
        lowered

    fn transform_attr_expr(_self: &mut RustTransformer, expr: &syn::Expr) -> Result<Expr, Error>:
        (*_self).transform_expr(expr)

    fn rename_value(_self: &mut RustTransformer, raw: String) -> String:
        if (raw == "self"):
            return ("_self").to_string()
        (*_self).identifier_renamer.resolve(IdentifierDomain__Value, raw)

    fn rename_type(_self: &mut RustTransformer, raw: String) -> String:
        (*_self).identifier_renamer.resolve(IdentifierDomain__Type, raw)

    fn rename_field(_self: &mut RustTransformer, raw: String) -> String:
        (*_self).identifier_renamer.resolve(IdentifierDomain__Field, raw)

    fn rename_variant(_self: &mut RustTransformer, raw: String) -> String:
        (*_self).identifier_renamer.resolve(IdentifierDomain__Variant, raw)

    fn note(_self: &mut RustTransformer, msg: impl Into<String>):
        (*_self).diagnostics.push(msg.into())
        ()

    fn note_lossy(_self: &mut RustTransformer, msg: impl Into<String>):
        let msg = msg.into()
        if (*_self).options.strict_selfhost:
            (*_self).diagnostics.push(f"SELFHOST_STRICT: {msg}")
            ()
        else:
            (*_self).diagnostics.push(msg)
            ()

    fn note_lossy_class(_self: &mut RustTransformer, class_: String, msg: impl Into<String>):
        let msg = msg.into()
        let key = f"{class_}::{msg}"
        if (!(*_self).reported_diagnostic_keys.insert(key)):
            return
        if (*_self).options.strict_selfhost:
            (*_self).diagnostics.push(f"SELFHOST_STRICT [class:{class_}]: {msg}")
            ()
        else:
            (*_self).diagnostics.push(msg)
            ()

    fn lit_kind_name(lit: &syn::Lit) -> String:
        match lit:
            syn__Lit::Bool(_) => "bool"
            syn__Lit::Byte(_) => "byte"
            syn__Lit::ByteStr(_) => "byte-str"
            syn__Lit::Char(_) => "char"
            syn__Lit::Float(_) => "float"
            syn__Lit::Int(_) => "int"
            syn__Lit::Str(_) => "str"
            syn__Lit::Verbatim(_) => "verbatim"
            _ => "unknown"

    fn expr_kind_name(expr: &syn::Expr) -> String:
        match expr:
            syn__Expr::Array(_) => "array"
            syn__Expr::Assign(_) => "assign"
            syn__Expr::Async_(_) => "async"
            syn__Expr::Await(_) => "await"
            syn__Expr::Binary(_) => "binary"
            syn__Expr::Block(_) => "block"
            syn__Expr::Break(_) => "break"
            syn__Expr::Call(_) => "call"
            syn__Expr::Cast(_) => "cast"
            syn__Expr::Closure(_) => "closure"
            syn__Expr::Const(_) => "const"
            syn__Expr::Continue(_) => "continue"
            syn__Expr::Field(_) => "field"
            syn__Expr::ForLoop(_) => "for-loop"
            syn__Expr::Group(_) => "group"
            syn__Expr::If(_) => "if"
            syn__Expr::Index(_) => "index"
            syn__Expr::Infer(_) => "infer"
            syn__Expr::Let(_) => "let"
            syn__Expr::Lit(_) => "literal"
            syn__Expr::Loop(_) => "loop"
            syn__Expr::Macro(_) => "macro"
            syn__Expr::Match(_) => "match"
            syn__Expr::MethodCall(_) => "method-call"
            syn__Expr::Paren(_) => "paren"
            syn__Expr::Path(_) => "path"
            syn__Expr::Range(_) => "range"
            syn__Expr::Reference(_) => "reference"
            syn__Expr::Repeat(_) => "repeat"
            syn__Expr::Return(_) => "return"
            syn__Expr::Struct(_) => "struct"
            syn__Expr::Try(_) => "try"
            syn__Expr::TryBlock(_) => "try-block"
            syn__Expr::Tuple(_) => "tuple"
            syn__Expr::Unary(_) => "unary"
            syn__Expr::Unsafe_(_) => "unsafe"
            syn__Expr::While(_) => "while"
            syn__Expr::Yield(_) => "yield"
            _ => "unknown"

    fn should_skip_item(_self: &RustTransformer, item: &syn::Item) -> Bool:
        match item:
            syn__Item::Const(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Enum(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::ExternCrate(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Fn(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::ForeignMod(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Impl(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Macro(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Mod(module) => (*_self).should_skip_module(module)
            syn__Item::Static(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Struct(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Trait(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::TraitAlias(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Type(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Union(node) => has_cfg_test_attr(&node.attrs)
            syn__Item::Use(node) => has_cfg_test_attr(&node.attrs)
            _ => false

    fn should_skip_module(_self: &RustTransformer, module: &syn::ItemMod) -> Bool:
        if ((*module).ident == "tests"):
            return true
        has_cfg_test_attr(&(*module).attrs)

    fn push_scope(_self: &mut RustTransformer):
        (*_self).local_types.push(HashMap__new_())
        ()

    fn pop_scope(_self: &mut RustTransformer):
        if ((*_self).local_types.len() > 1):
            (*_self).local_types.pop()
            ()

    fn define(_self: &mut RustTransformer, name: String, ty: Type):
        match (*_self).local_types.last_mut():
            Some(scope) =>
                scope.insert(name.to_string(), ty)
                ()
            _ => ()

    fn lookup_local_type(_self: &RustTransformer, name: String) -> Option<&Type>:
        (*_self).local_types.iter().rev().find_map(fn(scope): scope.get(name))

    fn push_value_substitution_scope(_self: &mut RustTransformer):
        (*_self).value_substitutions.push(HashMap__new_())
        ()

    fn pop_value_substitution_scope(_self: &mut RustTransformer):
        if ((*_self).value_substitutions.len() > 1):
            (*_self).value_substitutions.pop()
            ()

    fn add_value_substitution(_self: &mut RustTransformer, name: String, expr: Expr):
        match (*_self).value_substitutions.last_mut():
            Some(scope) =>
                scope.insert(name, expr)
                ()
            _ => ()

    fn lookup_value_substitution(_self: &RustTransformer, path: &syn::Path) -> Option<Expr>:
        if ((*path).leading_colon.is_some() || ((*path).segments.len() != 1)):
            return none
        let name = ((*path).segments.first()?).ident.to_string()
        (*_self).value_substitutions.iter().rev().find_map(fn(scope): scope.get(&name).cloned())

    fn next_closure_param_name(_self: &mut RustTransformer) -> String:
        let name = f"__kain_closure_arg{(*_self).closure_param_counter}"
        (*_self).closure_param_counter = ((*_self).closure_param_counter + 1)
        ()
        name

    fn closure_param_can_bind_directly(_self: &RustTransformer, pat: &syn::Pat) -> Bool:
        match pat:
            syn__Pat::Ident(_) => true
            syn__Pat::Wild(_) => true
            syn__Pat::Paren(paren) => (*_self).closure_param_can_bind_directly(&paren.pat)
            syn__Pat::Type(typed) => (*_self).closure_param_can_bind_directly(&typed.pat)
            syn__Pat::Reference(_) => false
            _ => false

    fn tuple_binding_expr(_self: &RustTransformer, access: &Expr, index: usize) -> Expr:
        Expr::Field { object: Box__new_(access.clone()), field: f"__kain_tuple_{index}", span: S }

    fn register_pattern_substitutions(_self: &mut RustTransformer, pat: &syn::Pat, access: Expr):
        match pat:
            syn__Pat::Ident(ident) =>
                let name = ident.ident.to_string()
                let bound = if ident.by_ref.is_some():
                    Expr::Ref { mutable_: ident.mutability.is_some(), value: Box__new_(access.clone()), span: S }
                else:
                    access.clone()
                (*_self).add_value_substitution(name, bound)
                ()
                match &ident.subpat:
                    Some((_, subpat)) =>
                        (*_self).register_pattern_substitutions(subpat, access)
                        ()
                    _ => ()
            syn__Pat::Paren(paren) => (*_self).register_pattern_substitutions(&paren.pat, access)
            syn__Pat::Type(typed) => (*_self).register_pattern_substitutions(&typed.pat, access)
            syn__Pat::Reference(reference) =>
                (*_self).register_pattern_substitutions(&reference.pat, Expr::Deref(Box__new_(access), S))
                ()
            syn__Pat::Tuple(tuple) =>
                for selfhost_for_item in tuple.elems.iter().enumerate():
                    let (index, element) = selfhost_for_item
                    (*_self).register_pattern_substitutions(element, (*_self).tuple_binding_expr(&access, index))
                    ()
            syn__Pat::TupleStruct(tuple_struct) =>
                for selfhost_for_item in tuple_struct.elems.iter().enumerate():
                    let (index, element) = selfhost_for_item
                    (*_self).register_pattern_substitutions(element, Expr::Field { object: Box__new_(access.clone()), field: f"field_{index}", span: S })
                    ()
            syn__Pat::Struct(struct_pat) =>
                for field in &struct_pat.fields:
                    let field_name = (*_self).rename_field(&member_name(&field.member))
                    (*_self).register_pattern_substitutions(&field.pat, Expr::Field { object: Box__new_(access.clone()), field: field_name, span: S })
                    ()
            syn__Pat::Slice(slice) =>
                for selfhost_for_item in slice.elems.iter().enumerate():
                    let (index, element) = selfhost_for_item
                    (*_self).register_pattern_substitutions(element, Expr::Index { object: Box__new_(access.clone()), index: Box__new_(Expr::Int(index as i64, S)), span: S })
                    ()
            syn__Pat::Wild(_) => ()
            syn__Pat::Lit(_) => ()
            syn__Pat::Path(_) => ()
            syn__Pat::Range(_) => ()
            syn__Pat::Rest(_) => ()
            _ =>
                (*_self).note_lossy_class("closure_pattern_lowering", ("unsupported closure pattern binding lowered lossy").to_string())
                ()

    fn build_closure_param(_self: &mut RustTransformer, pat: &syn::Pat) -> Param:
        let ty = (*_self).type_from_local_pat(pat).unwrap_or(Type::Infer(S))
        if (*_self).closure_param_can_bind_directly(pat):
            let (name, mutable_) = (*_self).local_pat_name(pat)
            return Param { name: name, ty: ty, mutable_: mutable_, default_: none, span: S }
        let name = (*_self).next_closure_param_name()
        (*_self).register_pattern_substitutions(pat, Expr::Ident(name.clone(), S))
        ()
        Param { name: name, ty: ty, mutable_: false, default_: none, span: S }

    fn map_type_checked(_self: &mut RustTransformer, ty: &syn::Type) -> Type:
        match trait_like_type_name(ty):
            Some((kind, trait_name)) =>
                if ((kind != "impl trait") && (!trait_object_is_opaque_any_carrier(ty))):
                    let message = if (kind == "dyn trait"):
                        f"dyn trait object lowered to impl {trait_name} (dynamic dispatch / vtable semantics erased)"
                    else:
                        f"{kind} lowered to impl {trait_name}"
                    (*_self).note_lossy_class("trait_object_lowering", message)
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                ()
                ()
        (*_self).resolve_impl_self_type((*_self).type_mapper.map_type(ty))

    fn resolve_impl_self_type(_self: &RustTransformer, ty: Type) -> Type:
        match ty:
            Type::Named { name: name, generics: generics, span: span } if (name == "Self") => (*_self).current_impl_target.clone().unwrap_or(Type::Named { name: name, generics: generics, span: span })
            Type::Named { name: name, generics: generics, span: span } => Type::Named { name: normalize_local_type_name(&name).unwrap_or(name), generics: generics.into_iter().map(fn(generic): (*_self).resolve_impl_self_type(generic)).collect(), span: span }
            Type::Tuple(types, span) => Type::Tuple(types.into_iter().map(fn(item): (*_self).resolve_impl_self_type(item)).collect(), span)
            Type::Array(inner, size, span) => Type::Array(Box__new_((*_self).resolve_impl_self_type((*inner))), size, span)
            Type::Slice(inner, span) => Type::Slice(Box__new_((*_self).resolve_impl_self_type((*inner))), span)
            Type::Ref { mutable_: mutable_, inner: inner, lifetime: lifetime, span: span } => Type::Ref { mutable_: mutable_, inner: Box__new_((*_self).resolve_impl_self_type((*inner))), lifetime: lifetime, span: span }
            Type::Ptr { mutable_: mutable_, inner: inner, provenance: provenance, span: span } => Type::Ptr { mutable_: mutable_, inner: Box__new_((*_self).resolve_impl_self_type((*inner))), provenance: provenance, span: span }
            Type::Function { params: params, return_type: return_type, effects: effects, span: span } => Type::Function { params: params.into_iter().map(fn(param): (*_self).resolve_impl_self_type(param)).collect(), return_type: Box__new_((*_self).resolve_impl_self_type((*return_type))), effects: effects, span: span }
            Type::Option(inner, span) => Type::Option(Box__new_((*_self).resolve_impl_self_type((*inner))), span)
            Type::Result(ok, err, span) => Type::Result(Box__new_((*_self).resolve_impl_self_type((*ok))), Box__new_((*_self).resolve_impl_self_type((*err))), span)
            Type::Impl { trait_name: trait_name, generics: generics, span: span } => Type::Impl { trait_name: trait_name, generics: generics.into_iter().map(fn(generic): (*_self).resolve_impl_self_type(generic)).collect(), span: span }
            other => other

    fn current_impl_type_path(_self: &RustTransformer) -> Option<String>:
        match (*_self).current_impl_target:
            Some(Type::Named { name: name }) => Option::Some(name.clone())
            _ => none

    fn resolve_impl_self_path_segments(_self: &RustTransformer, segments: Array<String>) -> Array<String>:
        if segments.first().is_some_and(fn(segment): (segment == "Self")):
            match (*_self).current_impl_type_path():
                Some(type_path) =>
                    segments[0] = type_path
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        segments

    fn path_expr_may_need_explicit_deref(_self: &mut RustTransformer, path: &syn::Path) -> Bool:
        if (*path).segments.is_empty():
            return false
        let name = (*_self).resolve_value_path(path)
        match (*_self).lookup_local_type(&name):
            Some(Type::Ref {  }) => true
            Some(Type::Ptr {  }) => true
            _ => false

    fn inferred_receiver_type_hint(_self: &mut RustTransformer, expr: &syn::Expr) -> Option<Type>:
        match expr:
            syn__Expr::Path(path) =>
                if path.path.segments.is_empty():
                    return none
                let name = (*_self).resolve_value_path(&path.path)
                (*_self).lookup_local_type(&name).cloned()
            syn__Expr::Paren(paren) => (*_self).inferred_receiver_type_hint(&paren.expr)
            _ => none

    fn lower_borrow_adapter_call(_self: &mut RustTransformer, receiver: Expr, receiver_ty: Option<Type>) -> Expr:
        match receiver_ty:
            Some(Type::Ref {  }) => Expr::Deref(Box__new_(receiver), S)
            Some(Type::Ptr {  }) => Expr::Deref(Box__new_(receiver), S)
            Some(Type::Named { name: name }) if (name == "Box") => Expr::Deref(Box__new_(receiver), S)
            _ => receiver

    fn lower_option_as_ref_call(_self: &mut RustTransformer, receiver: Expr, receiver_ty: Option<Type>) -> Expr:
        match receiver_ty:
            Some(Type::Ref { inner: inner }) if none => (*_self).lower_option_as_ref_match(Expr::Deref(Box__new_(receiver), S))
            Some(Type::Option(_, _)) => (*_self).lower_option_as_ref_match(receiver)
            _ => (*_self).lower_borrow_adapter_call(receiver, receiver_ty)

    fn lower_option_as_ref_match(_self: &RustTransformer, scrutinee: Expr) -> Expr:
        let binding_name = ("__kain_option_as_ref_value").to_string()
        Expr::Match { scrutinee: Box__new_(scrutinee), arms: [MatchArm { pattern: Pattern::Variant { enum_name: Option::Some(("Option").to_string()), variant: ("Some").to_string(), fields: VariantPatternFields::Tuple([Pattern::Binding { name: binding_name.clone(), mutable_: false, span: S }]), span: S }, guard: none, body: Expr::EnumVariant { enum_name: ("Option").to_string(), variant: ("Some").to_string(), fields: EnumVariantFields::Tuple([Expr::Ref { mutable_: false, value: Box__new_(Expr::Ident(binding_name, S)), span: S }]), span: S }, span: S }, MatchArm { pattern: Pattern::Variant { enum_name: Option::Some(("Option").to_string()), variant: ("None").to_string(), fields: VariantPatternFields__Unit, span: S }, guard: none, body: Expr::None(S), span: S }], span: S }

    fn resolved_path_segments(_self: &RustTransformer, path: &syn::Path) -> Array<String>:
        (*_self).resolve_impl_self_path_segments((*_self).type_mapper.resolve_path_segments(path))

    fn resolved_value_ident(_self: &mut RustTransformer, resolved: &[String]) -> String:
        if (resolved.len() == 1):
            (*_self).rename_value(&resolved[0])
        else:
            resolved.join("::")

    fn build_rewritten_constructor_call(_self: &mut RustTransformer, resolved: &[String], evaluated_args: Array<Expr>) -> Expr:
        let constructor = Expr::Call { callee: Box__new_(Expr::Ident((*_self).resolved_value_ident(resolved), S)), args: Vec__new_(), span: S }
        if evaluated_args.is_empty():
            return constructor
        let params = (range(0, evaluated_args.len())).map(fn(index): Param { name: f"__kain_ctor_arg{index}", ty: Type::Infer(S), mutable_: false, default_: none, span: S }).collect()
        let args = evaluated_args.into_iter().map(fn(value): CallArg { name: none, value: value, span: S }).collect()
        Expr::Call { callee: Box__new_(Expr::Lambda { params: params, return_type: none, body: Box__new_(constructor), span: S }), args: args, span: S }

    fn lower_known_constructor_call(_self: &mut RustTransformer, path: &syn::Path, args: &syn::punctuated::Punctuated<syn::Expr, Unknown>) -> Option<Result<Expr, Error>>:
        let resolved = (*_self).resolved_path_segments(path)
        match (*_self).lower_eager_wrapper_constructor(&resolved, args):
            Some(lowered) => return Option::Some(lowered)
            _ =>
                ()
                ()
        let rewritten = rewrite_associated_constructor_path(&resolved, args.len())?
        Option::Some(args.iter().map(fn(expr): (*_self).transform_expr(expr).map(fn(value): (*_self).peel_expr_wrapper(value))).collect().map(fn(evaluated_args): (*_self).build_rewritten_constructor_call(&rewritten, evaluated_args)))

    fn lower_eager_wrapper_constructor(_self: &mut RustTransformer, resolved: &[String], args: &syn::punctuated::Punctuated<syn::Expr, Unknown>) -> Option<Result<Expr, Error>>:
        let is_lazy_new = match resolved:
            [name, method] => ((name == "Lazy") && (method == "new"))
            [_, _, name, method] => ((name == "Lazy") && (method == "new"))
            _ => false
        if (!is_lazy_new):
            return none
        if (args.len() != 1):
            return Option::Some(Result::Err(ImportError::UnsupportedFeature(("Lazy::new expects exactly one factory argument").to_string())))
        Option::Some((*_self).transform_expr(args.first().expect("checked single arg")).map(fn(factory): Expr::Call { callee: Box__new_((*_self).peel_expr_wrapper(factory)), args: Vec__new_(), span: S }))

    fn builtin_variant_shape(_self: &RustTransformer, resolved: &[String]) -> Option<(String, String, EnumVariantCtorShape)>:
        match resolved:
            [variant] if (variant == "None") => Option::Some((("Option").to_string(), ("None").to_string(), EnumVariantCtorShape__Unit))
            [variant] if (variant == "Some") => Option::Some((("Option").to_string(), ("Some").to_string(), EnumVariantCtorShape::Tuple(1)))
            [variant] if (variant == "Ok") => Option::Some((("Result").to_string(), ("Ok").to_string(), EnumVariantCtorShape::Tuple(1)))
            [variant] if (variant == "Err") => Option::Some((("Result").to_string(), ("Err").to_string(), EnumVariantCtorShape::Tuple(1)))
            [enum_name, variant] if ((enum_name == "Option") && (variant == "None")) => Option::Some((("Option").to_string(), ("None").to_string(), EnumVariantCtorShape__Unit))
            [enum_name, variant] if ((enum_name == "Option") && (variant == "Some")) => Option::Some((("Option").to_string(), ("Some").to_string(), EnumVariantCtorShape::Tuple(1)))
            [enum_name, variant] if ((enum_name == "Result") && (variant == "Ok")) => Option::Some((("Result").to_string(), ("Ok").to_string(), EnumVariantCtorShape::Tuple(1)))
            [enum_name, variant] if ((enum_name == "Result") && (variant == "Err")) => Option::Some((("Result").to_string(), ("Err").to_string(), EnumVariantCtorShape::Tuple(1)))
            _ => none

    fn known_variant_shape(_self: &mut RustTransformer, resolved: &[String]) -> Option<(String, String, EnumVariantCtorShape)>:
        match (*_self).builtin_variant_shape(resolved):
