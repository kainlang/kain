use crate::Result

use std::collections::HashMap

use std::path::Path

use std::path::PathBuf

@doc(doc = " Preprocessor configuration")
pub struct PreprocessorConfig:
    include_paths: Array<std::path::PathBuf>
    defines: Map<String, String>
    follow_system_includes: Bool

impl PreprocessorConfig:
    pub fn new_() -> PreprocessorConfig:
        PreprocessorConfig { include_paths: Vec__new_(), defines: HashMap__new_(), follow_system_includes: false }

    pub fn add_include_path(_self: &mut PreprocessorConfig, path: impl Into<std::path::PathBuf>):
        (*_self).include_paths.push(path.into())
        ()

    pub fn add_define(_self: &mut PreprocessorConfig, name: impl Into<String>, value: impl Into<String>):
        (*_self).defines.insert(name.into(), value.into())
        ()


impl Default for PreprocessorConfig:
    fn default_() -> PreprocessorConfig:
        PreprocessorConfig__new_()


@doc(doc = " Resolve an include path")
pub fn resolve_include(include_name: String, current_file: &std::path::Path, config: &PreprocessorConfig) -> Result<Option<std::path::PathBuf>, Error>:
    let relative = current_file.parent().map(fn(p): p.join(include_name))
    match relative:
        Some(path) =>
            if path.exists():
                return Result::Ok(Option::Some(path))
            ()
        _ =>
            ()
            ()
    for include_path in &(*config).include_paths:
        let path = include_path.join(include_name)
        if path.exists():
            return Result::Ok(Option::Some(path))
    ()
    if (!(*config).follow_system_includes):
        return Result::Ok(none)
    Result::Ok(none)

