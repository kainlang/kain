const REGISTER_EXTENSION_ONCE: std::sync::Once = Once__new_()

const LOADED_BRIDGES: std::sync::RwLock<Map<std::path::PathBuf, LoadedBridge>> = (fn(): RwLock__new_(BTreeMap__new_()))()

type RegisterBridgeFn = fn(ptr_mut<kain_core::runtime::Env>) -> ()

struct LoadedBridge:
    library: libloading::Library
    register_: RegisterBridgeFn

pub fn register_():
    REGISTER_EXTENSION_ONCE.call_once(fn(): none)
    ()

pub fn import_libraries_for_source(source: String, options: &model::ImportCOptions, prepare: &model::PrepareContext) -> Result<Array<model::ImportCOutput>, kain_core::error::KainError>:
    let imports = detect_c_library_imports(source)
    let mut outputs = Vec__new_()
    for import_name in imports:
        outputs.push(import_library(&import_name, options, prepare)?)
        ()
    ()
    Result::Ok(outputs)

pub fn load_prebuilt_bridge(dylib_path: &std::path::Path) -> Result<(), kain_core::error::KainError>:
    ensure_bridge_loaded(dylib_path)

pub fn shared_library_env_var(import_name: String) -> String:
    let mut suffix = (fn(__kain_ctor_arg0): String__new_())(import_name.len())
    for ch in import_name.chars():
        match ch:
            _ => suffix.push(ch)
            _ => suffix.push(ch.to_ascii_uppercase())
            _ => suffix.push(ch)
            _ => suffix.push("_")
    ()
    f"KAIN_C_FFI_SHARED_LIB_{suffix}"

pub fn load_packaged_bridges_from_manifest(manifest_path: &std::path::Path) -> Result<usize, kain_core::error::KainError>:
    register_()
    ()
    let manifest_source = std__fs__read_to_string(manifest_path).map_err(fn(err): KainError__runtime(f"Failed to read packaged C FFI manifest '{manifest_path.display()}': {err}"))?
    let manifest: model::PackagedBridgeManifest = serde_json__from_str(&manifest_source).map_err(fn(err): KainError__runtime(f"Failed to parse packaged C FFI manifest '{manifest_path.display()}': {err}"))?
    let manifest_dir = manifest_path.parent().unwrap_or_else(fn(): Path__new_("."))
    let mut loaded = 0
    for import in manifest.imports:
        match import.shared_library:
            Some(shared_library) =>
                let shared_path = resolve_packaged_bridge_artifact(manifest_dir, shared_library).ok_or_else(fn(): KainError__runtime(f"Failed to resolve packaged shared library '{shared_library.file_name}' for C import '{import.import_name}'"))?
                std__env__set_var(shared_library_env_var(&import.import_name), &shared_path)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let bridge_path = resolve_packaged_bridge_artifact(manifest_dir, &import.bridge_library).ok_or_else(fn(): KainError__runtime(f"Failed to resolve packaged bridge library '{import.bridge_library.file_name}' for C import '{import.import_name}'"))?
        ensure_bridge_loaded(&bridge_path)?
        ()
        loaded = (loaded + 1)
        ()
    ()
    Result::Ok(loaded)

pub fn import_library(import_name: String, options: &model::ImportCOptions, prepare: &model::PrepareContext) -> Result<model::ImportCOutput, kain_core::error::KainError>:
    register_()
    ()
    let (resolved, manifest_context) = resolve_library(import_name, prepare)?
    let bundle = extract__extract_binding_bundle(&resolved)?
    let hash = build_cache_hash(&resolved, &bundle.source_fingerprints, generate__BRIDGE_FORMAT_VERSION)
    let cache_dir = default_cache_root(prepare).join("c_ffi").join(hash)
    std__fs__create_dir_all(&cache_dir).map_err(kain_core__error__KainError__Io)?
    ()
    let (artifacts, mut output) = generate__write_generated_artifacts(&resolved, &bundle, &cache_dir, (*options).output_dir)?
    output.config_root = manifest_context.root_dir.clone()
    ()
    output.c_ffi_config = manifest_context.config.clone()
    ()
    match (*options).report_json:
        Some(report_json_path) =>
            match report_json_path.parent():
                Some(parent) =>
                    std__fs__create_dir_all(parent).map_err(kain_core__error__KainError__Io)?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            let report_json = serde_json__to_string_pretty(&artifacts.report).map_err(fn(err): KainError__runtime(f"Failed to serialize C FFI report override: {err}"))?
            std__fs__write(report_json_path, report_json).map_err(kain_core__error__KainError__Io)?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    if (*options).mode.wants_live():
        let (dylib_path, cache_hit) = ensure_bridge_library(&output)?
        ensure_bridge_loaded(&dylib_path)?
        ()
        output.dylib_path = Option::Some(dylib_path)
        ()
        output.cache_hit = cache_hit
        ()
        ()
        ()
        ()
    Result::Ok(output)

pub fn augment_source_for_runtime(source: String, target: kain_core::CompileTarget, prepare: &model::PrepareContext) -> Result<String, kain_core::error::KainError>:
    let imports = detect_c_library_imports(source)
    if imports.is_empty():
        return Result::Ok(source.to_string())
    let mode = artifact_mode_for_target(target).ok_or_else(fn(): KainError__runtime("C ABI FFI is currently available in Interpret, Test, Rust/native packaging, and LLVM lanes"))?
    let mut outputs = (fn(__kain_ctor_arg0): Vec__new_())(imports.len())
    for import_name in imports:
        outputs.push(import_library(&import_name, &model::ImportCOptions { mode: mode, ..ImportCOptions__default_() }, prepare)?)
        ()
    ()
    let mut sections = Vec__new_()
    for output in outputs:
        sections.push(output.canonical_module_source)
        ()
    ()
    sections.push(source.to_string())
    ()
    Result::Ok(sections.join("\n"))

pub fn detect_c_library_imports(source: String) -> Array<String>:
    const IMPORT_REGEX: regex::Regex = (fn(): Regex__new_("(?m)^\\s*use\\s+c(?:::|/)([A-Za-z_][A-Za-z0-9_]*)").expect("regex"))()

    let mut seen = BTreeSet__new_()
    let mut imports = Vec__new_()
    for captures in IMPORT_REGEX.captures_iter(source):
        match captures.get(1):
            Some(value) =>
                let import_name = value.as_str().to_string()
                if seen.insert(import_name.clone()):
                    imports.push(import_name)
                    ()
            _ => ()
    ()
    imports

fn apply_loaded_bridges(env: &mut kain_core::runtime::Env):
    let registry = LOADED_BRIDGES.read().expect("c ffi bridge registry read")
    for bridge in registry.values():
        bridge.register_(env as ptr_mut<kain_core::runtime::Env>)
        ()
        ()

fn resolve_packaged_bridge_artifact(manifest_dir: &std::path::Path, artifact: &model::PackagedBridgeBinaryArtifact) -> Option<std::path::PathBuf>:
    match std__env__current_exe().ok().and_then(fn(exe): exe.parent().map(fn(dir): dir.join(&(*artifact).file_name))).filter(fn(path): path.exists()):
        Some(current_exe_candidate) => return Option::Some(current_exe_candidate)
        _ =>
            ()
            ()
    let manifest_candidate = manifest_dir.join(&(*artifact).file_name)
    if manifest_candidate.exists():
        return Option::Some(manifest_candidate)
    (*artifact).source_path.map(PathBuf__from).filter(fn(path): path.exists())

fn artifact_mode_for_target(target: kain_core::CompileTarget) -> Option<model::ArtifactMode>:
    match target:
        kain_core__CompileTarget::Interpret => Option::Some(model__ArtifactMode__Both)
        kain_core__CompileTarget::Test => Option::Some(model__ArtifactMode__Both)
        kain_core__CompileTarget::Rust => Option::Some(model__ArtifactMode__Generate)
        kain_core__CompileTarget::Llvm => Option::Some(model__ArtifactMode__Generate)
        _ => none

fn ensure_bridge_loaded(dylib_path: &std::path::Path) -> Result<(), kain_core::error::KainError>:
    register_()
    ()
    let canonical_path = std__fs__canonicalize(dylib_path).unwrap_or_else(fn(_): dylib_path.to_path_buf())
    if LOADED_BRIDGES.read().expect("c ffi bridge registry read").contains_key(&canonical_path):
        return Result::Ok(())
    let library = Library__new_(&canonical_path).map_err(fn(err): KainError__runtime(f"Failed to load C FFI bridge '{canonical_path.display()}': {err}"))?
    let register_ = none
    LOADED_BRIDGES.write().expect("c ffi bridge registry write").insert(canonical_path, LoadedBridge { library: library, register_: register_ })
    ()
    Result::Ok(())

fn ensure_bridge_library(output: &model::ImportCOutput) -> Result<(std::path::PathBuf, Bool), kain_core::error::KainError>:
    let bridge_name = generate__bridge_crate_name(&(*output).resolved.import_name)
    let target_dir = (*output).cache_dir.join("bridge").join("target")
    let dylib_path = target_dir.join(target_directory_name()).join(lib_filename(&bridge_name))
    if dylib_path.exists():
        return Result::Ok((dylib_path, true))
    let status = Command__new_("cargo").arg("build").arg("--manifest-path").arg(&(*output).bridge_manifest_path).env("CARGO_TARGET_DIR", &target_dir).status().map_err(fn(err): KainError__runtime(f"Failed to run cargo build for C FFI bridge '{(*output).bridge_manifest_path.display()}': {err}"))?
    if (!status.success()):
        return Result::Err(KainError__runtime(f"Cargo build failed for C FFI bridge '{(*output).bridge_manifest_path.display()}'"))
    if (!dylib_path.exists()):
        return Result::Err(KainError__runtime(f"C FFI bridge build succeeded but '{dylib_path.display()}' was not produced"))
    Result::Ok((dylib_path, false))

fn resolve_library(import_name: String, prepare: &model::PrepareContext) -> Result<(model::ResolvedCLibrary, model::ManifestContext), kain_core::error::KainError>:
    let start_dir = (*prepare).manifest_path.and_then(fn(value): value.parent().map(Path__to_path_buf)).or_else(fn(): (*prepare).current_dir.clone()).unwrap_or_else(fn(): std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from(".")))
    let manifest_root = find_kain_manifest_root(&start_dir).ok_or_else(fn(): KainError__runtime(f"Could not resolve KAIN.toml for C FFI import '{import_name}'"))?
    let config = (load_c_ffi_config(&manifest_root)?).ok_or_else(fn(): KainError__runtime(f"KAIN.toml at '{manifest_root.display()}' is missing [c_ffi] configuration"))?
    let library = config.libraries.iter().find(fn(value): (value.name == import_name)).cloned().ok_or_else(fn(): KainError__runtime("No [c_ffi] library named '{import_name}' found in '{manifest_root.join(\"KAIN.toml\").display()}'"))?
    let header_path = resolve_relative_path(&manifest_root, &library.header)
    if (!header_path.exists()):
        return Result::Err(KainError__runtime(f"C FFI header '{header_path.display()}' does not exist"))
    let shared_lib_path = library.shared_lib.map(fn(value): resolve_relative_path(&manifest_root, value))
    Result::Ok((model::ResolvedCLibrary { import_name: import_name.to_string(), manifest_root: manifest_root.clone(), header_path: header_path, shared_lib_path: shared_lib_path, config: library, global_config: config.clone() }, model::ManifestContext { root_dir: Option::Some(manifest_root), config: Option::Some(config) }))

fn load_c_ffi_config(root: &std::path::Path) -> Result<Option<config::CFfiConfig>, kain_core::error::KainError>:
    for name in ["KAIN.toml", "kain.toml"]:
        let manifest_path = root.join(name)
        if (!manifest_path.exists()):
            continue
        let source = std__fs__read_to_string(&manifest_path).map_err(kain_core__error__KainError__Io)?
        let value: toml::Value = toml__from_str(&source).map_err(fn(err): KainError__runtime(f"Failed to parse '{manifest_path.display()}': {err}"))?
        match value.get("c_ffi"):
            Some(table) =>
                let config = table.clone().try_into().map_err(fn(err): KainError__runtime(f"Failed to parse [c_ffi] in '{manifest_path.display()}': {err}"))?
                return Result::Ok(Option::Some(config))
            _ =>
                ()
                ()
        return Result::Ok(none)
    ()
    Result::Ok(none)

fn find_kain_manifest_root(start_dir: &std::path::Path) -> Option<std::path::PathBuf>:
    let mut current = Option::Some(start_dir)
    loop:
        match current:
            Some(dir) =>
                if (["KAIN.toml", "kain.toml"]).iter().any(fn(name): dir.join(name).exists()):
                    return Option::Some(dir.to_path_buf())
                current = dir.parent()
                ()
            _ => break
    ()
    none

fn resolve_relative_path(root: &std::path::Path, path: &std::path::Path) -> std::path::PathBuf:
    let expanded = expand_platform_dynamic_library_tokens(path)
    if expanded.is_absolute():
        expanded
    else:
        root.join(expanded)

fn expand_platform_dynamic_library_tokens(path: &std::path::Path) -> std::path::PathBuf:
    let source = path.to_string_lossy()
    let mut expanded = source.into_owned()
    const TOKEN_PREFIX: String = "${kain_dynlib:"

    loop:
        match expanded.find(TOKEN_PREFIX):
            Some(start) =>
                let token_end = expanded[start..].find("}").map(fn(offset): (start + offset)).unwrap_or(expanded.len())
                if (token_end >= expanded.len()):
                    break
                let library_stem = &expanded[(start + TOKEN_PREFIX.len())..token_end]
                let replacement = current_platform_dynamic_library_name(library_stem)
                expanded.replace_range(range(start, (token_end + 1)), &replacement)
                ()
            _ => break
    ()
    PathBuf__from(expanded)

fn current_platform_dynamic_library_name(stem: String) -> String:
    if cfg!(target_os = "windows"):
        f"{stem}.dll"
    elif cfg!(target_os = "macos"):
        f"lib{stem}.dylib"
    else:
        f"lib{stem}.so"

fn build_cache_hash(resolved: &model::ResolvedCLibrary, fingerprints: &[model::FileFingerprint], format_version: String) -> String:
    let mut hasher = Sha256__new_()
    hasher.update((*resolved).import_name.as_bytes())
    ()
    hasher.update((*resolved).header_path.display().to_string().as_bytes())
    ()
    match &(*resolved).shared_lib_path:
        Some(path) =>
            hasher.update(path.display().to_string().as_bytes())
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    hasher.update(format_version.as_bytes())
    ()
    for fingerprint in fingerprints:
        hasher.update(fingerprint.path.as_bytes())
        ()
        hasher.update(fingerprint.sha256.as_bytes())
        ()
    ()
    hasher.finalize()

fn default_cache_root(prepare: &model::PrepareContext) -> std::path::PathBuf:
    match (*prepare).current_dir:
        Some(dir) => return dir.join(".kain").join("cache")
        _ =>
            ()
            ()
    std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from(".")).join(".kain").join("cache")

fn target_directory_name() -> String:
    "debug"

fn lib_filename(crate_name: String) -> String:
    if cfg!(target_os = "windows"):
        f"{crate_name}.dll"
    elif cfg!(target_os = "macos"):
        f"lib{crate_name}.dylib"
    else:
        f"lib{crate_name}.so"

