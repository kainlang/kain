@derive(Debug, Clone)
pub struct BridgeParam:
    name: String
    ty: BridgeType

@derive(Debug, Clone)
pub struct CFunctionBinding:
    emitted_name: String
    exported_aliases: Array<String>
    symbol_name: String
    params: Array<BridgeParam>
    return_type: BridgeType

pub enum BridgeType:
    Unit
    Bool
    SignedInt(String)
    UnsignedInt(String)
    Float32
    Float64
    CString
    ByteBuffer { mutable_: Bool, element_type: String }
    OpaqueHandle { mutable_: Bool, pointee: String }

impl BridgeType:
    pub fn render_kain(_self: &BridgeType) -> String:
        match *_self:
            BridgeType::Unit => ("Void").to_string()
            BridgeType::Bool => ("Bool").to_string()
            BridgeType::SignedInt(_) => ("Int").to_string()
            BridgeType::UnsignedInt(_) => ("Int").to_string()
            BridgeType::Float32 => ("Float").to_string()
            BridgeType::Float64 => ("Float").to_string()
            BridgeType::CString => ("String").to_string()
            BridgeType::ByteBuffer {  } => ("Any").to_string()
            BridgeType::OpaqueHandle {  } => ("Any").to_string()

    pub fn default_literal(_self: &BridgeType) -> String:
        match *_self:
            BridgeType::Unit => "()"
            BridgeType::Bool => "false"
            BridgeType::SignedInt(_) => "0"
            BridgeType::UnsignedInt(_) => "0"
            BridgeType::Float32 => "0.0"
            BridgeType::Float64 => "0.0"
            BridgeType::CString => "\"\""
            BridgeType::ByteBuffer {  } => "()"
            BridgeType::OpaqueHandle {  } => "()"

    pub fn render_rust_ffi(_self: &BridgeType) -> String:
        match *_self:
            BridgeType::Unit => ("()").to_string()
            BridgeType::Bool => ("bool").to_string()
            BridgeType::SignedInt(name) => name.clone()
            BridgeType::UnsignedInt(name) => name.clone()
            BridgeType::Float32 => ("f32").to_string()
            BridgeType::Float64 => ("f64").to_string()
            BridgeType::CString => ("*const std::os::raw::c_char").to_string()
            BridgeType::ByteBuffer { mutable_: mutable_ } => if (*mutable_): ("*mut u8").to_string() else: ("*const u8").to_string()
            BridgeType::OpaqueHandle { mutable_: mutable_ } => if (*mutable_): ("*mut std::ffi::c_void").to_string() else: ("*const std::ffi::c_void").to_string()


@derive(Debug, Clone)
pub struct BindingBundle:
