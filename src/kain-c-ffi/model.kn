use crate::config::CFfiConfig

use crate::config::CLibraryConfig

use serde::Deserialize

use serde::Serialize

use std::path::PathBuf

pub enum ArtifactMode:
    Live
    Generate
    Both

impl ArtifactMode:
    pub fn wants_live(_self: ArtifactMode) -> Bool:
        match _self:
            ArtifactMode::Live => true
            ArtifactMode::Both => true
            _ => false

    pub fn wants_generate(_self: ArtifactMode) -> Bool:
        match _self:
            ArtifactMode::Generate => true
            ArtifactMode::Both => true
            _ => false


impl Default for ArtifactMode:
    fn default_() -> ArtifactMode:
        ArtifactMode__Both


@derive(Debug, Clone, Default)
pub struct PrepareContext:
    current_dir: Option<std::path::PathBuf>
    manifest_path: Option<std::path::PathBuf>

impl Default for PrepareContext:
    pub fn default_() -> PrepareContext:
        PrepareContext { current_dir: none, manifest_path: none }


@derive(Debug, Clone, Default)
pub struct ImportCOptions:
    output_dir: Option<std::path::PathBuf>
    report_json: Option<std::path::PathBuf>
    mode: ArtifactMode

impl Default for ImportCOptions:
    pub fn default_() -> ImportCOptions:
        ImportCOptions { output_dir: none, report_json: none, mode: ArtifactMode__default_() }


@derive(Debug, Clone)
pub struct ManifestContext:
    root_dir: Option<std::path::PathBuf>
    config: Option<CFfiConfig>

@derive(Debug, Clone)
pub struct ResolvedCLibrary:
