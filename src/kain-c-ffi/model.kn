pub enum ItemStatus:
    Callable
    TypeOnly
    OpaqueHandle
    Stubbed
    Unsupported

pub enum ItemKind:
    Function
    Struct
    Enum
    Typedef
    Callback
    Global

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct BindingReportEntry:
    symbol_path: String
