# Kore Language Features

// This file is the feature contract for the owned Kore core. It names the
// language surfaces we want, the ones we are still borrowing from donors, and
// the ones intentionally excluded from wave 1.

enum FeatureDomain:
    Syntax
    Semantics
    Runtime
    NativeLlvm
    Memory
    Tooling
    Excluded

enum FeatureStatus:
    Owned
    DonorOnly
    Planned
    Excluded

enum FeatureScope:
    Core
    Bootstrap
    Pipeline
    UE5
    Experimental

struct FeatureRule:
    name: String
    domain: FeatureDomain
    status: FeatureStatus
    scope: FeatureScope
    owner: String
    donor: Option<String>
    rationale: String

struct KoreOwnershipContract:
    canonical_root: String
    owned_tree: String
    donor_trees: Array<String>
    excluded_trees: Array<String>
    current_wave: String
    notes: String

struct KoreLanguageProfile:
    contract: KoreOwnershipContract
    features: Array<FeatureRule>

const KORE_CANONICAL_ROOT: String = "src/kore"
const KORE_DONOR_ROOT: String = "src/rust-import"
const KORE_LEGACY_DONOR_ROOT: String = "src/.legacy"
const KORE_EXCLUDED_SURFACES: Array<String> = [
    "ue5",
    "shader codegen",
    "pipeline orchestration",
    "repair orchestration",
    "report generation",
    "bundle-era adapters"
]

