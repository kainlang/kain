// ============================================================================
// Kain Span System - source code locations and spans
// ============================================================================
// Modernized from the legacy Kain span model and the current Rust-import
// shape. This stays intentionally small and foundational.
// ============================================================================

use stdlib

/// Human-readable source location used by diagnostics.
pub struct SourceLocation:
    line_: Int
    column_: Int
    offset_: Int
    length_: Int
    source_line: String

/// A byte span in a source file.
pub struct Span:
    start: Int
    end: Int
    file: String

impl Span:
    pub fn new_(start: Int, end: Int, file: String) -> Span:
        return Span { start: start, end: end, file: file }

    pub fn empty() -> Span:
        return Span { start: 0, end: 0, file: "" }

    pub fn is_defined(self) -> Bool:
        return self.start != 0 || self.end != 0

    pub fn is_empty(self) -> Bool:
        return self.start == self.end

    pub fn len(self) -> Int:
        return self.end - self.start

    pub fn merge(self, other: Span) -> Span:
        let start = self.start
        if other.start < start:
            start = other.start

        let end = self.end
        if other.end > end:
            end = other.end

        let file = self.file
        if file == "":
            file = other.file

        return Span { start: start, end: end, file: file }

    pub fn extend_to(self, pos: Int) -> Span:
        let start = self.start
        let end = self.end

        if pos < start:
            return Span { start: pos, end: end, file: self.file }
        if pos > end:
            return Span { start: start, end: pos, file: self.file }

        return self

    pub fn location(self, source: String) -> SourceLocation:
        let source_len = len(source)
        let line_ = 1
        let line_start = 0
        let index = 0

        while index < self.start && index < source_len:
            let ch = char_at(source, index)
            if ch == "\n":
                line_ = line_ + 1
                line_start = index + 1
            index = index + 1

        let column = self.start - line_start + 1

        let line_end = self.start
        while line_end < source_len:
            let ch = char_at(source, line_end)
            if ch == "\n":
                break
            line_end = line_end + 1

        let source_line = ""
        let line_index = line_start
        while line_index < line_end && line_index < source_len:
            source_line = source_line + char_at(source, line_index)
            line_index = line_index + 1

        return SourceLocation {
            line_: line_,
            column_: column,
            offset_: self.start,
            length_: self.len(),
            source_line: source_line
        }
