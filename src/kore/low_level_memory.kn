use ast::Program
use error::KainResult
use low_level_memory_metadata::MemoryTypeLayout

# Kain Low-Level Memory Lowering Seed

struct MemoryLoweringOutput:
    program: Program
    layouts: Array<MemoryTypeLayout>

pub fn lower_program_memory(program: Program) -> KainResult<MemoryLoweringOutput>:
    return Ok(MemoryLoweringOutput {
        program: program,
        layouts: []
    })
