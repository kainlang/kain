                    kain_core__ast__EnumVariantFields::Struct(values) =>
                        let parts: Array<String> = values.iter().map(fn(__kain_closure_arg10): f"{sanitize_emitted_identifier(__kain_closure_arg10.__kain_tuple_0)}: {(*_self).gen_expr(__kain_closure_arg10.__kain_tuple_1)}").collect()
