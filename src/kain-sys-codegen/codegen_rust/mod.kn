                let else_tail = tail.map(fn(next): f" else {(*_self).gen_else_branch_expr(next)}").unwrap_or_default()
                f"if {(*_self).gen_expr(condition)} {(*_self).gen_block_expr(block)}{else_tail}"

    fn string_literal_expr(expr: &kain_core::ast::Expr) -> Option<String>:
        match expr:
