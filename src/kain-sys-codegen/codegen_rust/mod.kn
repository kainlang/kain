    fn rust_function_name(_self: &RustGen, name: String) -> String:
        name.split("::").filter(fn(segment): (!segment.is_empty())).map(sanitize_emitted_identifier).collect().join("__")

    fn rust_method_name(_self: &RustGen, name: String) -> String:
        let mut emitted = (*_self).rust_function_name(name)
        match (*_self).current_impl_target():
            Some(target) =>
                for prefix in [f"{target}__", f"{target}_"]:
                    match emitted.strip_prefix(&prefix):
                        Some(stripped) =>
                            emitted = stripped.to_string()
                            ()
                            break
                        _ => ()
                ()
                if emitted.ends_with("_fmt"):
                    return ("fmt_impl").to_string()
                ()
            _ =>
                ()
                ()
        match (*_self).current_impl_trait():
            Some(trait_name) =>
                match trait_name:
                    _ if ((*_self).trait_name_matches(trait_name, "Display") && emitted.ends_with("_fmt")) => return ("fmt").to_string()
                    _ if ((*_self).trait_name_matches(trait_name, "Default") && (((emitted.ends_with("_default") || (emitted == "default")) || (emitted == "default_")))) => return ("default").to_string()
                    _ => ()
                ()
            _ =>
                ()
                ()
        if ((*_self).current_impl_target().is_some() || (*_self).current_impl_trait().is_some()):
            (*_self).normalize_runtime_method(&emitted)
        else:
            emitted

    fn map_trait_name(_self: &RustGen, name: String) -> String:
        match name:
            "Display" => ("std::fmt::Display").to_string()
            "Debug" => ("std::fmt::Debug").to_string()
            _ => (*_self).normalize_runtime_path(name)

    fn trait_name_matches(_self: &RustGen, trait_name: String, target: String) -> Bool:
        ((trait_name == target) || trait_name.ends_with(&f"::{target}"))

    fn normalize_runtime_head_segment(_self: &RustGen, segment: String) -> String:
        let normalized = desanitize_kain_identifier(segment)
        if RUST_PATH_ROOT_SEGMENTS.contains(&normalized.as_str()):
            normalized
        else:
            (*_self).map_named_type(&normalized)

    fn normalize_runtime_path(_self: &RustGen, path: String) -> String:
        const STRIP_COLON_PREFIXES: Array<String> = ["crate::runtime::", "crate::ui::", "crate::ast::", "crate::error::", "crate::effects::", "crate::types::", "crate::lexer::", "crate::diagnostic_registry::", "crate::diagnostics::", "crate::parser::", "crate::span::", "crate::language_features::", "crate::low_level_abi::", "crate::low_level_memory::", "crate::low_level_memory_metadata::", "crate::monomorphize::", "crate::stdlib::", "crate::comptime::", "crate::asm_ir::", "crate::tokio::runtime::", "runtime::", "ui::", "ast::", "error::", "effects::", "types::", "lexer::", "diagnostic_registry::", "diagnostics::", "parser::", "span::", "language_features::", "low_level_abi::", "low_level_memory::", "low_level_memory_metadata::", "monomorphize::", "stdlib::", "comptime::", "asm_ir::", "tokio::runtime::"]

        const STRIP_DUNDER_PREFIXES: Array<String> = ["crate__runtime__", "crate__ui__", "crate__ast__", "crate__error__", "crate__effects__", "crate__types__", "crate__lexer__", "crate__diagnostic_registry__", "crate__diagnostics__", "crate__parser__", "crate__span__", "crate__language_features__", "crate__low_level_abi__", "crate__low_level_memory__", "crate__low_level_memory_metadata__", "crate__monomorphize__", "crate__stdlib__", "crate__comptime__", "crate__asm_ir__", "crate__tokio__runtime__", "runtime__", "ui__", "ast__", "error__", "effects__", "types__", "lexer__", "diagnostic_registry__", "diagnostics__", "parser__", "span__", "language_features__", "low_level_abi__", "low_level_memory__", "low_level_memory_metadata__", "monomorphize__", "stdlib__", "comptime__", "asm_ir__", "tokio__runtime__"]

        if ((path == "_self") || (path == "self")):
            if (*_self).current_self_type().is_none():
                match (*_self).free_self_alias_stack.last():
                    Some(Some(alias)) => return alias.clone()
                    _ =>
                        ()
                        ()
                ()
            return ("self").to_string()
        match (*_self).current_self_type():
            Some(self_ty) =>
                if ((path == "Self_") || (path == "Self")):
                    return self_ty.to_string()
                match path.strip_prefix("Self::"):
                    Some(rest) => return f"{self_ty}::{rest}"
                    _ =>
                        ()
                        ()
                match path.strip_prefix("Self_::"):
                    Some(rest) => return f"{self_ty}::{rest}"
                    _ =>
                        ()
                        ()
                match path.strip_prefix("Self___"):
                    Some(rest) => return f"{self_ty}::{(*_self).normalize_runtime_segment(rest, true)}"
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        let mut normalized = path
        if (normalized.contains("__") && normalized.contains("::")):
            let canonical = normalized.replace("__", "::")
            if (canonical != normalized):
                return (*_self).normalize_runtime_path(&canonical)
            ()
        if (!(*_self).has_modules):
            for prefix in STRIP_COLON_PREFIXES:
                match normalized.strip_prefix(prefix):
                    Some(rest) =>
                        normalized = rest
                        ()
                        break
                    _ => ()
            ()
            for prefix in STRIP_DUNDER_PREFIXES:
                match normalized.strip_prefix(prefix):
                    Some(rest) =>
                        normalized = rest
                        ()
                        break
                    _ => ()
            ()
            ()
        if (normalized == "Self_"):
            return ("Self").to_string()
        if ((!(*_self).has_modules) && normalized.starts_with("crate::")):
            normalized = normalized.trim_start_matches("crate::")
            ()
            ()
            ()
            ()
        if normalized.starts_with("__kain_"):
            return normalized.to_string()
        if normalized.contains("::"):
            let segments = normalized.split("::").filter(fn(segment): (!segment.is_empty())).collect()
            match segments.split_first():
                Some((first, rest)) =>
                    let mapped = (*_self).normalize_runtime_head_segment(first)
                    let rest = rest.iter().map(fn(segment): (*_self).normalize_runtime_segment(segment, true)).collect()
                    return if rest.is_empty(): mapped else: "{mapped}::{rest.join(\"::\")}"
                _ =>
                    ()
                    ()
            ()
        if (!normalized.contains("__")):
            return (*_self).normalize_runtime_head_segment(normalized)
        let segments = split_sanitized_dunder_path(normalized).into_iter().filter(fn(segment): (!segment.is_empty())).collect()
        match segments.split_first():
            Some((first, rest)) =>
                let mapped = (*_self).normalize_runtime_head_segment(first)
                let rest = rest.iter().map(fn(segment): (*_self).normalize_runtime_segment(segment, true)).collect()
                return if rest.is_empty(): mapped else: "{mapped}::{rest.join(\"::\")}"
            _ =>
                ()
                ()
        String__new_()

    fn normalize_runtime_segment(_self: &RustGen, segment: String, terminal: Bool) -> String:
        let normalized = if terminal:
            if (segment.starts_with("_") && segment.chars().nth(1).is_some_and(fn(ch): ch.is_ascii_uppercase())):
                segment.trim_start_matches("_").to_string()
            else:
                match segment:
                    "new_" => ("new").to_string()
                    "default_" => ("default").to_string()
                    "var_" => ("var").to_string()
                    "spawn_" => ("spawn").to_string()
                    _ => segment.to_string()
        else:
            segment.to_string()
        sanitize_emitted_identifier(&normalized)

    fn normalize_runtime_method(_self: &RustGen, method: String) -> String:
        if (method.starts_with("_") && method.chars().nth(1).is_some_and(fn(ch): ch.is_ascii_uppercase())):
            return method.trim_start_matches("_").to_string()
        let normalized = match method:
            "send_" => ("send").to_string()
            "spawn_" => ("spawn").to_string()
            "or_" => ("or").to_string()
            "with_" => ("with").to_string()
            "new_" => ("new").to_string()
            "default_" => ("default").to_string()
            "var_" => ("var").to_string()
            _ => desanitize_kain_identifier(method)
        sanitize_rust_identifier(&normalized)

    fn render_interpolated_string(_self: &RustGen, parts: &[kain_core::ast::Expr]) -> String:
        if parts.is_empty():
            return ("String::new()").to_string()
        let mut lines = (fn(__kain_ctor_arg0): Vec__new_())((parts.len() + 4))
        lines.push(("{").to_string())
        ()
        lines.push(("let mut __kain_fstr = String::new();").to_string())
        ()
        for part in parts:
            match part:
                kain_core__ast__Expr::String(value, _) =>
                    lines.push(f"__kain_fstr.push_str({value});")
                    ()
                expr =>
                    lines.push("__kain_fstr.push_str(&format!(\"{}\", {(*_self).gen_expr(expr)}));")
                    ()
        ()
        lines.push(("__kain_fstr").to_string())
        ()
        lines.push(("}").to_string())
        ()
        lines.join(" ")

    fn current_return_struct(_self: &RustGen) -> Option<String>:
        (*_self).current_return_struct_stack.last().and_then(fn(value): value)

    fn normalize_variant_head(_self: &RustGen, enum_name: Option<String>, variant: String, enum_hint: Option<String>) -> String:
        match enum_name:
            Some(enum_name) =>
                if ((enum_name == "Self_") || (enum_name == "Self")):
                    match enum_hint:
                        Some(enum_hint) => return f"{(*_self).normalize_runtime_path(enum_hint)}::{(*_self).normalize_runtime_method(variant)}"
                        _ =>
                            ()
                            ()
                    match (*_self).current_self_type():
                        Some(self_ty) => return f"{(*_self).normalize_runtime_path(self_ty)}::{(*_self).normalize_runtime_method(variant)}"
                        _ =>
                            ()
                            ()
                    ()
                return f"{(*_self).normalize_runtime_path(enum_name)}::{(*_self).normalize_runtime_method(variant)}"
            _ =>
                ()
                ()
        if variant.contains("__"):
            let mut parts = variant.split("__").filter(fn(segment): (!segment.is_empty())).collect()
            match parts.pop():
                Some(last) =>
                    let mut head = parts.join("::")
                    if ((((head == "Self") || (head == "Self_"))) && enum_hint.is_some()):
                        head = (*_self).normalize_runtime_path(enum_hint.unwrap())
                        ()
                        ()
                        ()
                        ()
                    elif ((head == "Self") || (head == "Self_")):
                        match (*_self).current_self_type():
                            Some(self_ty) =>
                                head = (*_self).normalize_runtime_path(self_ty)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    if (!head.is_empty()):
                        return f"{head}::{(*_self).normalize_runtime_method(last)}"
                    ()
                _ =>
                    ()
                    ()
            ()
        match enum_hint:
            Some(enum_hint) => return f"{(*_self).normalize_runtime_path(enum_hint)}::{(*_self).normalize_runtime_method(variant)}"
            _ =>
                ()
                ()
        (*_self).normalize_runtime_method(variant)

    fn coerce_statement_placeholder(_self: &RustGen, body: String) -> String:
        if (body == "None"):
            return ("()").to_string()
        if (body.trim() == "{ None }"):
            return ("{ () }").to_string()
        body.replace(" else { None }", " else { () }")

    fn coerce_placeholder_branches(_self: &RustGen, then_expr: String, else_expr: String):
        let then_snapshot = then_expr.clone()
        let else_snapshot = else_expr.clone()
        match (*_self).replace_placeholder_expr(then_expr, &else_snapshot):
            Some(preserved) =>
                (*then_expr) = preserved
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*_self).replace_placeholder_expr(else_expr, &then_snapshot):
            Some(preserved) =>
                (*else_expr) = preserved
                ()
            _ => ()

    fn replace_placeholder_expr(_self: &RustGen, candidate: String, other: String) -> Option<String>:
        let trimmed = candidate.trim()
        if (trimmed == "None"):
            return Option::Some((*_self).placeholder_for_peer_branch(other))
        if (trimmed == "{ None }"):
            return Option::Some("{ {(*_self).placeholder_for_peer_branch(other)} }")
        none

    fn placeholder_for_peer_branch(_self: &RustGen, other: String) -> String:
        let other = other.trim()
        if other.contains("VNode::"):
            if ((*_self).current_function_name() == Option::Some("reconcile")):
                return ("next.clone()").to_string()
            return ("VNode::Fragment(Vec::new())").to_string()
        if (((other == "()") || (other == "{ () }")) || other.contains("return ")):
            return ("()").to_string()
        if (other.starts_with("Some(") || (other == "None")):
            return ("None").to_string()
        ("None").to_string()

    fn map_type(_self: &RustGen, ty: &kain_core::ast::Type) -> String:
        (*_self).map_type_in_context(ty, none, false)

    fn sanitize_lifetime_name(_self: &RustGen, lifetime: String) -> String:
        let normalized = lifetime.trim_start_matches("'")
        if ((normalized == "static") || (normalized == "_")):
            normalized.to_string()
        else:
            sanitize_rust_identifier(normalized)

    fn render_field_accessor(_self: &RustGen, field: String) -> String:
        match tuple_field_marker_index(field):
            Some(index) => index.to_string()
            _ => sanitize_emitted_identifier(field)

    fn render_ref_lifetime(_self: &RustGen, lifetime: Option<String>) -> String:
        lifetime.map(fn(name): f"'{(*_self).sanitize_lifetime_name(name)} ").unwrap_or_default()

    fn lifetime_generic_arg_name(_self: &RustGen, ty: &kain_core::ast::Type) -> Option<String>:
        let kain_core__ast__Type::Named { name: name, generics: generics } = ty
        if (!generics.is_empty()):
            return none
        let leaf = name.rsplit("::").next().unwrap_or(name)
        (((((leaf == "_") || (leaf == "static"))) || (((((*_self).current_generic_lifetimes().contains(name) || (*_self).current_generic_lifetimes().contains(leaf))) && (*_self).looks_like_lifetime_name(leaf))))).then(fn(): leaf.to_string())

    fn map_generic_arg_in_context(_self: &RustGen, ty: &kain_core::ast::Type, current_self: Option<String>, recursive_slot: Bool) -> String:
        match (*_self).lifetime_generic_arg_name(ty):
            Some(lifetime_name) => f"'{(*_self).sanitize_lifetime_name(&lifetime_name)}"
            _ => (*_self).map_type_in_context(ty, current_self, recursive_slot)

    fn map_storage_type(_self: &RustGen, ty: &kain_core::ast::Type, current_self: Option<String>) -> String:
        (*_self).map_owned_type_in_context(ty, current_self, true)

    fn map_return_type(_self: &RustGen, ty: &kain_core::ast::Type, current_self: Option<String>) -> String:
        (*_self).map_type_in_context(ty, current_self, false)

    fn map_owned_type_in_context(_self: &RustGen, ty: &kain_core::ast::Type, current_self: Option<String>, recursive_slot: Bool) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                let rust_name = (*_self).normalize_type_name(name, current_self)
                if (recursive_slot && current_self.is_some_and(fn(self_name): (rust_name == self_name))):
                    return f"Box<{rust_name}>"
                if generics.is_empty():
                    rust_name
                else:
                    let gen_strs: Array<String> = generics.iter().map(fn(g): (*_self).map_generic_arg_in_context(g, current_self, false)).collect()
                    "{rust_name}<{gen_strs.join(\", \")}>"
            kain_core__ast__Type::Ref { inner: inner } => (*_self).map_owned_type_in_context(inner, current_self, false)
            kain_core__ast__Type::Tuple(types, _) =>
                let type_strs: Array<String> = types.iter().map(fn(t): (*_self).map_owned_type_in_context(t, current_self, true)).collect()
                if (type_strs.len() == 1):
                    f"({type_strs[0]},)"
                else:
                    "({type_strs.join(\", \")})"
            kain_core__ast__Type::Array(inner, size, _) => f"[{(*_self).map_owned_type_in_context(inner, current_self, true)}; {size}]"
            kain_core__ast__Type::Slice(inner, _) => f"Vec<{(*_self).map_owned_type_in_context(inner, current_self, true)}>"
            kain_core__ast__Type::Function { params: params, return_type: return_type } =>
                let param_strs: Array<String> = params.iter().map(fn(p): (*_self).map_owned_type_in_context(p, current_self, false)).collect()
                "fn({param_strs.join(\", \")}) -> {(*_self).map_owned_type_in_context(return_type, current_self, false)}"
            kain_core__ast__Type::Option(inner, _) => f"Option<{(*_self).map_owned_type_in_context(inner, current_self, true)}>"
            kain_core__ast__Type::Result(ok, err, _) => f"Result<{(*_self).map_owned_type_in_context(ok, current_self, true)}, {(*_self).map_owned_type_in_context(err, current_self, true)}>"
            _ => (*_self).map_type_in_context(ty, current_self, recursive_slot)

    fn map_type_in_context(_self: &RustGen, ty: &kain_core::ast::Type, current_self: Option<String>, recursive_slot: Bool) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                let rust_name = (*_self).normalize_type_name(name, current_self)
                if (recursive_slot && current_self.is_some_and(fn(self_name): (rust_name == self_name))):
                    return f"Box<{rust_name}>"
                if generics.is_empty():
                    rust_name
                else:
                    let gen_strs: Array<String> = generics.iter().map(fn(g): (*_self).map_generic_arg_in_context(g, current_self, false)).collect()
                    "{rust_name}<{gen_strs.join(\", \")}>"
            kain_core__ast__Type::Tuple(types, _) =>
                let type_strs: Array<String> = types.iter().map(fn(t): (*_self).map_type_in_context(t, current_self, true)).collect()
                if (type_strs.len() == 1):
                    f"({type_strs[0]},)"
                else:
                    "({type_strs.join(\", \")})"
            kain_core__ast__Type::Array(inner, size, _) => f"[{(*_self).map_type_in_context(inner, current_self, true)}; {size}]"
            kain_core__ast__Type::Slice(inner, _) => f"[{(*_self).map_type_in_context(inner, current_self, true)}]"
            kain_core__ast__Type::Ref { mutable_: mutable_, inner: inner, lifetime: lifetime } =>
                let lifetime = (*_self).render_ref_lifetime(lifetime)
                if (*mutable_):
                    f"&{lifetime}mut {(*_self).map_type_in_context(inner, current_self, false)}"
                else:
                    f"&{lifetime}{(*_self).map_type_in_context(inner, current_self, false)}"
            kain_core__ast__Type::Ptr { mutable_: mutable_, inner: inner } => if (*mutable_): f"*mut {(*_self).map_type_in_context(inner, current_self, false)}" else: f"*const {(*_self).map_type_in_context(inner, current_self, false)}"
            kain_core__ast__Type::Function { params: params, return_type: return_type } =>
                let param_strs: Array<String> = params.iter().map(fn(p): (*_self).map_type_in_context(p, current_self, false)).collect()
                "fn({param_strs.join(\", \")}) -> {(*_self).map_type_in_context(return_type, current_self, false)}"
            kain_core__ast__Type::Option(inner, _) => f"Option<{(*_self).map_type_in_context(inner, current_self, true)}>"
            kain_core__ast__Type::Result(ok, err, _) => f"Result<{(*_self).map_type_in_context(ok, current_self, true)}, {(*_self).map_type_in_context(err, current_self, true)}>"
            kain_core__ast__Type::Infer(_) => ("_").to_string()
            kain_core__ast__Type::Never(_) => ("!").to_string()
            kain_core__ast__Type::Unit(_) => ("()").to_string()
            kain_core__ast__Type::Impl { trait_name: trait_name, generics: generics } =>
                if generics.is_empty():
                    f"impl {trait_name}"
                else:
                    let gen_strs: Array<String> = generics.iter().map(fn(g): (*_self).map_generic_arg_in_context(g, current_self, false)).collect()
                    "impl {trait_name}<{gen_strs.join(\", \")}>"

    fn visibility_prefix(_self: &RustGen, visibility: kain_core::ast::Visibility) -> String:
        match visibility:
            kain_core__ast__Visibility::Public => "pub "
            kain_core__ast__Visibility::Private => ""
            kain_core__ast__Visibility::Crate => "pub(crate) "
            kain_core__ast__Visibility::Super => "pub(super) "

    fn function_modifiers(_self: &RustGen, effects: &[kain_core::effects::Effect]) -> String:
        let mut parts = Vec__new_()
        if effects.contains(&kain_core__effects__Effect__Async_):
            parts.push("async")
            ()
            ()
            ()
            ()
        if effects.contains(&kain_core__effects__Effect__Unsafe_):
            parts.push("unsafe")
            ()
            ()
            ()
            ()
        if parts.is_empty():
            String__new_()
        else:
            "{parts.join(\" \")} "

    fn map_named_type(_self: &RustGen, name: String) -> String:
        let mapped = match name:
            "Int" => ("i64").to_string()
            "UInt" => ("u64").to_string()
            "Int8" => ("i8").to_string()
            "Int16" => ("i16").to_string()
            "Int32" => ("i32").to_string()
            "Int64" => ("i64").to_string()
            "UInt8" => ("u8").to_string()
            "UInt16" => ("u16").to_string()
            "UInt32" => ("u32").to_string()
            "UInt64" => ("u64").to_string()
            "Float" => ("f64").to_string()
            "Float32" => ("f32").to_string()
            "Float64" => ("f64").to_string()
            "Bool" => ("bool").to_string()
            "String" => ("String").to_string()
            "Char" => ("char").to_string()
            "Unit" => ("()").to_string()
            "Array" => ("Vec").to_string()
            "Map" => ("std::collections::HashMap").to_string()
            "Set" => ("std::collections::HashSet").to_string()
            "Range" => ("std::ops::Range").to_string()
            "Error" => ("crate::error::KainError").to_string()
            "PathBuf" => ("std::path::PathBuf").to_string()
            "Path" => ("std::path::Path").to_string()
            "Formatter" => ("std::fmt::Formatter").to_string()
            "Sender" => ("flume::Sender").to_string()
            "Receiver" => ("flume::Receiver").to_string()
            "Lazy" => ("once_cell::sync::Lazy").to_string()
            "PyAny" => ("pyo3::PyAny").to_string()
            "PyResult" => ("pyo3::PyResult").to_string()
            "PyObject" => ("pyo3::PyObject").to_string()
            "Python" => ("pyo3::Python").to_string()
            _ => name.to_string()
        sanitize_emitted_path(&mapped)

    fn normalize_type_name(_self: &RustGen, name: String, current_self: Option<String>) -> String:
        let raw = name.trim()
        let mut leaf = raw.rsplit("::").next().unwrap_or(raw).trim()
        match leaf.strip_prefix("&mut "):
            Some(stripped) =>
                leaf = stripped.trim()
                ()
                ()
                ()
                ()
            _ =>
                match leaf.strip_prefix("&"):
                    Some(stripped) =>
                        leaf = stripped.trim()
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
        if ((leaf == "Self_") || (leaf == "Self")):
            current_self.map(str__to_string).unwrap_or_else(fn(): ("Self").to_string())
        elif raw.contains("::"):
            sanitize_emitted_path(raw)
        else:
            (*_self).map_named_type(leaf)

    fn inferred_self_type<a>(_self: &RustGen, fn_name: String) -> Option<String>:
        let (prefix, _) = fn_name.split_once("_")?
        if prefix.chars().next().is_some_and(fn(ch): ch.is_ascii_uppercase()):
            Option::Some(prefix)
        else:
            none

    fn register_symbol(_self: &mut RustGen, kind: String, name: String) -> Bool:
        (*_self).emitted_symbols.insert(f"{kind}:{name}")

    fn should_emit_function(_self: &RustGen, func: &kain_core::ast::Function) -> Bool:
        let lower = (*func).name.to_ascii_lowercase()
        if (((lower.starts_with("test_") || lower.ends_with("_test")) || lower.contains("_test_")) || lower.starts_with("create_test_")):
            return false
        (!(*func).attributes.iter().any(fn(attr): attr.name.eq_ignore_ascii_case("test")))

    fn map_binop(_self: &RustGen, op: &kain_core::ast::BinaryOp) -> String:
        match op:
            kain_core__ast__BinaryOp::Add => "+"
            kain_core__ast__BinaryOp::Sub => "-"
            kain_core__ast__BinaryOp::Mul => "*"
            kain_core__ast__BinaryOp::Div => "/"
            kain_core__ast__BinaryOp::Mod => "%"
            kain_core__ast__BinaryOp::Pow => ".pow"
            kain_core__ast__BinaryOp::And => "&&"
            kain_core__ast__BinaryOp::Or => "||"
            kain_core__ast__BinaryOp::Eq => "=="
            kain_core__ast__BinaryOp::Ne => "!="
            kain_core__ast__BinaryOp::Lt => "<"
            kain_core__ast__BinaryOp::Le => "<="
            kain_core__ast__BinaryOp::Gt => ">"
            kain_core__ast__BinaryOp::Ge => ">="
            kain_core__ast__BinaryOp::BitAnd => "&"
            kain_core__ast__BinaryOp::BitOr => "|"
            kain_core__ast__BinaryOp::BitXor => "^"
            kain_core__ast__BinaryOp::Shl => "<<"
            kain_core__ast__BinaryOp::Shr => ">>"
            kain_core__ast__BinaryOp::Assign => "="
            kain_core__ast__BinaryOp::AddAssign => "+="
            kain_core__ast__BinaryOp::SubAssign => "-="
            kain_core__ast__BinaryOp::MulAssign => "*="
            kain_core__ast__BinaryOp::DivAssign => "/="
            kain_core__ast__BinaryOp::Range => ".."
            kain_core__ast__BinaryOp::RangeInclusive => "..="

    fn map_unaryop(_self: &RustGen, op: &kain_core::ast::UnaryOp) -> String:
        match op:
            kain_core__ast__UnaryOp::Not => "!"
            kain_core__ast__UnaryOp::Neg => "-"
            kain_core__ast__UnaryOp::Ref => "&"
            kain_core__ast__UnaryOp::RefMut => "&mut "
            kain_core__ast__UnaryOp::BitNot => "!"
            kain_core__ast__UnaryOp::Deref => "*"

    fn escape_string(_self: &RustGen, s: String) -> String:
        let mut result = String__new_()
        for c in s.chars():
            match c:
                "\n" => result.push_str("\\n")
                "\t" => result.push_str("\\t")
                "\\" => result.push_str("\\\\")
                "\"" => result.push_str("\\\"")
                _ => result.push(c)
        ()
        result


@doc(doc = " Generate a Cargo.toml for the transpiled Rust project")
pub fn gen_cargo_toml(name: String, deps: &[String]) -> String:
    let mut sb = StringBuilder__new_()
    sb.push_line("[package]")
    ()
    sb.push_line(&f"name = \"{name}\"")
    ()
    sb.push_line("version = \"0.1.0\"")
    ()
    sb.push_line("edition = \"2021\"")
    ()
    sb.push_line("")
    ()
    sb.push_line("# Generated by KAIN Compiler")
    ()
    sb.push_line("")
    ()
    sb.push_line("[dependencies]")
    ()
    for dep in deps:
        sb.push_line(&f"{dep} = \"*\"")
        ()
    ()
    sb.build()

