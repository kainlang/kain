                    let vis = (*_self).visibility_prefix(alias.ast.visibility)
                    let generics = (*_self).render_generic_params(&alias.ast.generics, &lifetime_names)
                    (*_self).write_line(&f"{vis}type {sanitize_emitted_identifier(&alias.ast.name)}{generics} = {(*_self).map_type(&alias.ast.target)};")
                    ()
                    (*_self).pop_generic_lifetimes()
