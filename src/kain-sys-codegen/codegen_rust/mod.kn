    fn gen_jsx(_self: &RustGen, node: &kain_core::ast::JSXNode) -> String:
        match node:
            kain_core__ast__JSXNode::Text(text, _) => f"\"{(*_self).escape_string(text)}\".to_string()"
            kain_core__ast__JSXNode::Expression(expr) => "format!(\"{}\", {(*_self).gen_expr(expr)})"
            kain_core__ast__JSXNode::Fragment(children, _) => (*_self).gen_jsx_children_expr(children)
            kain_core__ast__JSXNode::Element { tag: tag, attributes: attributes, children: children } =>
                let attr_strs: Array<String> = attributes.iter().map(fn(attr): none).collect()
                let attrs_expr = if attr_strs.is_empty():
                    ("String::new()").to_string()
                else:
                    "vec![{attr_strs.join(\", \")}].join(\"\")"
                let children_expr = (*_self).gen_jsx_children_expr(children)
                "format!(\"<{tag}{}{}</{tag}>\", {attrs_expr}, {children_expr})"
            kain_core__ast__JSXNode::ComponentCall { name: name, props: props, children: children } =>
                let props_name = (*_self).component_props_name(name)
                let mut field_strs: Array<String> = props.iter().map(fn(prop): f"{prop.name}: {(*_self).gen_jsx_attr_value_expr(&prop.value)}").collect()
                field_strs.push(f"children: {(*_self).gen_jsx_children_expr(children)}")
                ()
                "{name}({props_name} { {field_strs.join(\", \")} })"
            kain_core__ast__JSXNode::For { binding: binding, iter: iter, body: body } => f"({(*_self).gen_expr(iter)}).into_iter().map(|{binding}| {(*_self).gen_jsx(body)}).collect::<Vec<String>>().join(\"\")"
            kain_core__ast__JSXNode::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                let else_expr = else_branch.map(fn(branch): (*_self).gen_jsx(branch)).unwrap_or_else(fn(): ("String::new()").to_string())
                "if {(*_self).gen_expr(condition)} { {(*_self).gen_jsx(then_branch)} } else { {else_expr} }"

    fn gen_match_expr(_self: &RustGen, scrutinee: &kain_core::ast::Expr, arms: &[kain_core::ast::MatchArm], statement_context: Bool) -> String:
        let enum_hint = (*_self).enum_hint_for_expr(scrutinee)
        let mut arm_bodies: Array<String> = arms.iter().map(fn(arm): (*_self).gen_expr(&arm.body)).collect()
        let prefers_string = arm_bodies.iter().any(fn(body): body.contains(".to_string()"))
        if prefers_string:
            for body in &mut arm_bodies:
                if body.ends_with(".as_str()"):
                    (*body) = f"{body}.to_string()"
                    ()
            ()
            ()
        if statement_context:
            for body in &mut arm_bodies:
                (*body) = (*_self).coerce_statement_placeholder(body)
                ()
            ()
            ()
        let arm_strs: Array<String> = arms.iter().zip(arm_bodies.iter()).map(fn(__kain_closure_arg14): none).collect()
        "match {(*_self).gen_expr(scrutinee)} { {arm_strs.join(\", \")} }"

    fn gen_pattern(_self: &RustGen, pattern: &kain_core::ast::Pattern) -> String:
        (*_self).gen_pattern_with_hint(pattern, none)

    fn gen_pattern_with_hint(_self: &RustGen, pattern: &kain_core::ast::Pattern, enum_hint: Option<String>) -> String:
        match pattern:
            kain_core__ast__Pattern::Wildcard(_) => ("_").to_string()
            kain_core__ast__Pattern::Literal(expr) => (*_self).gen_pattern_literal(expr)
            kain_core__ast__Pattern::Binding { name: name, mutable_: mutable_ } => if (*mutable_): f"mut {sanitize_emitted_identifier(name)}" else: sanitize_emitted_identifier(name)
            kain_core__ast__Pattern::Struct { name: name, fields: fields, rest: rest } =>
                let mut field_strs: Array<String> = fields.iter().map(fn(__kain_closure_arg15): f"{sanitize_emitted_identifier(__kain_closure_arg15.__kain_tuple_0)}: {(*_self).gen_pattern_with_hint(__kain_closure_arg15.__kain_tuple_1, none)}").collect()
                if ((*rest) || (!fields.is_empty())):
                    field_strs.push(("..").to_string())
                    ()
                    ()
                    ()
                    ()
                "{(*_self).normalize_runtime_path(name)} { {field_strs.join(\", \")} }"
            kain_core__ast__Pattern::Tuple(patterns, _) =>
                let parts: Array<String> = patterns.iter().map(fn(pat): (*_self).gen_pattern_with_hint(pat, none)).collect()
                if (parts.len() == 1):
                    f"({parts[0]},)"
                else:
                    "({parts.join(\", \")})"
            kain_core__ast__Pattern::Variant { enum_name: enum_name, variant: variant, fields: fields } =>
                let head = (*_self).normalize_variant_head(enum_name, variant, enum_hint)
                match fields:
                    kain_core__ast__VariantPatternFields::Unit => head
                    kain_core__ast__VariantPatternFields::Tuple(patterns) =>
                        let parts: Array<String> = patterns.iter().map(fn(pat): (*_self).gen_pattern_with_hint(pat, none)).collect()
                        "{head}({parts.join(\", \")})"
                    kain_core__ast__VariantPatternFields::Struct(fields) =>
                        let mut parts: Array<String> = fields.iter().map(fn(__kain_closure_arg16): f"{__kain_closure_arg16.__kain_tuple_0}: {(*_self).gen_pattern_with_hint(__kain_closure_arg16.__kain_tuple_1, none)}").collect()
                        parts.push(("..").to_string())
                        ()
                        "{head} { {parts.join(\", \")} }"
            kain_core__ast__Pattern::Slice { patterns: patterns, rest: rest } =>
                let mut parts: Array<String> = patterns.iter().map(fn(pat): (*_self).gen_pattern_with_hint(pat, none)).collect()
                match rest:
                    Some(rest_name) =>
                        parts.push(f"{rest_name} @ ..")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                "[{parts.join(\", \")}]"
            kain_core__ast__Pattern::Or(patterns, _) => patterns.iter().map(fn(pat): (*_self).gen_pattern_with_hint(pat, enum_hint)).collect().join(" | ")
            kain_core__ast__Pattern::Range { start: start, end: end, inclusive: inclusive } =>
                let start = start.map(fn(value): (*_self).gen_pattern_literal(value)).unwrap_or_default()
                let end = end.map(fn(value): (*_self).gen_pattern_literal(value)).unwrap_or_default()
                if (*inclusive):
                    f"{start}..={end}"
                else:
                    f"{start}..{end}"

    fn collect_binding_types(_self: &RustGen, func: &kain_core::ast::Function) -> Map<String, String>:
        (*func).params.iter().filter_map(fn(param): (*_self).extract_named_type_name(&param.ty).map(fn(name): (param.name.clone(), name))).collect()

    fn current_self_type(_self: &RustGen) -> Option<String>:
        (*_self).self_type_stack.last().map(String__as_str)

    fn current_impl_target(_self: &RustGen) -> Option<String>:
        (*_self).impl_target_stack.last().cloned()

    fn current_function_name(_self: &RustGen) -> Option<String>:
        (*_self).current_function_stack.last().map(String__as_str)

    fn current_impl_trait(_self: &RustGen) -> Option<String>:
        (*_self).impl_trait_stack.last().and_then(fn(value): value)

    fn is_selfhost_empty_block(_self: &RustGen, block: &kain_core::ast::Block) -> Bool:
        match (*block).stmts.as_slice():
            [kain_core__ast__Stmt::Let { pattern: kain_core__ast__Pattern::Binding { name: name }, value: Some(kain_core__ast__Expr::None(_)) }] if (name == "__selfhost_empty") => true
            _ => false

    fn extract_named_type_name(_self: &RustGen, ty: &kain_core::ast::Type) -> Option<String>:
        match ty:
            kain_core__ast__Type::Named { name: name } => Option::Some(name.clone())
            kain_core__ast__Type::Ref { inner: inner } => (*_self).extract_named_type_name(inner)
            _ => none

    fn enum_hint_for_expr(_self: &RustGen, expr: &kain_core::ast::Expr) -> Option<String>:
        let kain_core__ast__Expr::Ident(name, _) = expr
        (*_self).binding_type_stack.iter().rev().find_map(fn(scope): scope.get(name).cloned())

