            kain_core__ast__Expr::Deref(inner, _) => (*_self).record_assignment_target(inner, names)
            _ => ()

    fn gen_pattern_literal(_self: &RustGen, expr: &kain_core::ast::Expr) -> String:
        match expr:
            kain_core__ast__Expr::String(value, _) => f"\"{(*_self).escape_string(value)}\""
            kain_core__ast__Expr::Int(value, _) => value.to_string()
            kain_core__ast__Expr::Float(value, _) => value
            kain_core__ast__Expr::Bool(value, _) => value.to_string()
            kain_core__ast__Expr::None(_) => ("None").to_string()
            kain_core__ast__Expr::Ident(name, _) => (*_self).normalize_runtime_path(name)
            kain_core__ast__Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: fields } =>
                match fields:
                    kain_core__ast__EnumVariantFields::Unit => (*_self).normalize_variant_head(Option::Some(enum_name), variant, none)
                    kain_core__ast__EnumVariantFields::Tuple(values) =>
                        let parts: Array<String> = values.iter().map(fn(value): (*_self).gen_pattern_literal(value)).collect()
                        "{(*_self).normalize_variant_head(Option::Some(enum_name), variant, none)}({parts.join(\", \")})"
                    kain_core__ast__EnumVariantFields::Struct(values) =>
                        let parts: Array<String> = values.iter().map(fn(__kain_closure_arg17): f"{sanitize_emitted_identifier(__kain_closure_arg17.__kain_tuple_0)}: {(*_self).gen_pattern_literal(__kain_closure_arg17.__kain_tuple_1)}").collect()
                        "{(*_self).normalize_variant_head(Option::Some(enum_name), variant, none)} { {parts.join(\", \")} }"
