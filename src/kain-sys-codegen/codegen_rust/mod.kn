                ()
            _ =>
                ()
                ()
        if (none):
            (*_self).write_line(&f"{vis}static {name}: &str = {(*_self).gen_const_value_expr(value)};")
            ()
            return
        if (*_self).is_simple_const(ty, value):
            (*_self).write_line(&f"{vis}static {name}: {(*_self).map_storage_type(ty, none)} = {(*_self).gen_const_value_expr(value)};")
            ()
            return
        (*_self).write_line(&f"{vis}static {name}: once_cell::sync::Lazy<{(*_self).map_const_type(ty)}> = once_cell::sync::Lazy::new(|| {(*_self).gen_const_value_expr(value)});")
