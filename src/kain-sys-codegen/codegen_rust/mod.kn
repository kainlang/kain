    fn gen_trait(_self: &mut RustGen, trait_def: &kain_core::ast::Trait):
        let lifetime_names = (*_self).trait_lifetime_generic_names(trait_def)
        (*_self).push_generic_lifetimes(lifetime_names.clone())
