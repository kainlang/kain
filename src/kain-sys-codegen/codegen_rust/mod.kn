                let field_strs: Array<String> = fields.iter().map(fn(__kain_closure_arg9): f"{sanitize_emitted_identifier(__kain_closure_arg9.__kain_tuple_0)}: {(*_self).gen_expr(__kain_closure_arg9.__kain_tuple_1)}").collect()
