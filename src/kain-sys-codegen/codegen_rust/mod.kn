    fn map_const_type(_self: &RustGen, ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Array(inner, _, _) => f"Vec<{(*_self).map_const_type(inner)}>"
            kain_core__ast__Type::Slice(inner, _) => f"Vec<{(*_self).map_const_type(inner)}>"
            kain_core__ast__Type::Ref { inner: inner } => (*_self).map_const_type(inner)
            kain_core__ast__Type::Tuple(items, _) =>
                let parts: Array<String> = items.iter().map(fn(item): (*_self).map_const_type(item)).collect()
                if (parts.len() == 1):
