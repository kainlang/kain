            kain_core__types__TypedItem::Mod(module) => (*_self).gen_typed_mod(module)
            _ => ()

    fn gen_const(_self: &mut RustGen, name: String, ty: &kain_core::ast::Type, value: &kain_core::ast::Expr, visibility: kain_core::ast::Visibility):
        let vis = (*_self).visibility_prefix(visibility)
        match ty:
