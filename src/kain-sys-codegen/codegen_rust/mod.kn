                "{name}!({literal}, {rendered_rest.join(\", \")})"
            _ =>
                let rendered_args: Array<String> = args.iter().map(fn(arg): (*_self).gen_expr(arg)).collect()
                let placeholders = ([]).join(" ")
                "{name}!(\"{placeholders}\", {rendered_args.join(\", \")})"

    fn render_builtin_macro_exprs(_self: &RustGen, name: String, args: &[&kain_core::ast::Expr]) -> Option<String>:
        let rendered = match name:
            "format" => (*_self).render_format_head_macro("format", args)
            "panic" => (*_self).render_format_head_macro(name, args)
            "unreachable" => (*_self).render_format_head_macro(name, args)
            "todo" => (*_self).render_format_head_macro(name, args)
            "__kain_write_fmt" =>
                let arg_strs: Array<String> = args.iter().map(fn(arg): (*_self).gen_expr(arg)).collect()
                if (arg_strs.len() == 2):
                    "write!({arg_strs[0]}, \"{}\", {arg_strs[1]})"
                else:
                    "write!({arg_strs.join(\", \")})"
            "__kain_writeln_fmt" =>
                let arg_strs: Array<String> = args.iter().map(fn(arg): (*_self).gen_expr(arg)).collect()
                if (arg_strs.len() == 2):
                    "writeln!({arg_strs[0]}, \"{}\", {arg_strs[1]})"
                else:
                    "writeln!({arg_strs.join(\", \")})"
            "println" => (*_self).render_format_head_macro(name, args)
            "print" => (*_self).render_format_head_macro(name, args)
            "eprintln" => (*_self).render_format_head_macro(name, args)
            "eprint" => (*_self).render_format_head_macro(name, args)
            _ => return none
        Option::Some(rendered)

    fn render_bootstrap_intrinsic_call(_self: &RustGen, name: String, args: &[kain_core::ast::CallArg]) -> Option<String>:
        match name:
