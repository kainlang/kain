    fn gen_item(_self: &mut RustGen, item: &kain_core::types::TypedItem):
        match item:
            kain_core__types__TypedItem::Function(fn_typed) =>
                let emitted_name = (*_self).rust_function_name(&fn_typed.ast.name)
                if (*_self).should_emit_function(&fn_typed.ast):
                    match (*_self).synthetic_impl_target(&fn_typed.ast):
                        Some(target) =>
                            if (*_self).register_symbol("method", &f"{target}::{emitted_name}"):
                                (*_self).gen_synthetic_impl_function(&target, &fn_typed.ast)
                                ()
                        _ =>
