            _ => none

    fn render_format_head_macro(_self: &RustGen, name: String, args: &[&kain_core::ast::Expr]) -> String:
        let Some((first, rest)) = args.split_first()
        if rest.is_empty():
            return "{name}!(\"{}\", {(*_self).gen_expr(first)})"
        match RustGen__string_literal_expr(first):
            Some(literal) =>
