                else:
                    "({parts.join(\", \")})"
            _ => (*_self).map_storage_type(ty, none)

    fn gen_const_value_expr(_self: &RustGen, expr: &kain_core::ast::Expr) -> String:
        match expr:
            kain_core__ast__Expr::String(value, _) => value
            kain_core__ast__Expr::Ref { value: value } => (*_self).gen_const_value_expr(value)
            kain_core__ast__Expr::AddrOf { value: value } => (*_self).gen_const_value_expr(value)
            kain_core__ast__Expr::Array(items, _) =>
                let parts: Array<String> = items.iter().map(fn(item): (*_self).gen_const_value_expr(item)).collect()
                "vec![{parts.join(\", \")}]"
            kain_core__ast__Expr::Tuple(items, _) =>
                let parts: Array<String> = items.iter().map(fn(item): (*_self).gen_const_value_expr(item)).collect()
                if (parts.len() == 1):
                    f"({parts[0]},)"
                else:
                    "({parts.join(\", \")})"
            kain_core__ast__Expr::Struct { name: name, fields: fields, rest: rest } =>
                let mut field_strs: Array<String> = fields.iter().map(fn(__kain_closure_arg2): f"{sanitize_emitted_identifier(__kain_closure_arg2.__kain_tuple_0)}: {(*_self).gen_const_value_expr(__kain_closure_arg2.__kain_tuple_1)}").collect()
                match rest:
                    Some(rest) =>
                        field_strs.push(f"..{(*_self).gen_const_value_expr(rest)}")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                if field_strs.is_empty():
                    "{(*_self).normalize_runtime_path(name)} {}"
                else:
                    "{(*_self).normalize_runtime_path(name)} { {field_strs.join(\", \")} }"
            kain_core__ast__Expr::AggregateInit { ty: ty, fields: fields, zero_fill_rest: zero_fill_rest } =>
                match ty:
                    kain_core__ast__Type::Named { name: name } =>
                        match name.rsplit_once("__"):
                            Some((enum_name, variant)) =>
                                let head = (*_self).normalize_variant_head(Option::Some(&enum_name.to_string()), variant, none)
                                let field_strs: Array<String> = fields.iter().map(fn(__kain_closure_arg3): f"{sanitize_emitted_identifier(__kain_closure_arg3.__kain_tuple_0)}: {(*_self).gen_const_value_expr(__kain_closure_arg3.__kain_tuple_1)}").collect()
                                return "{head} { {field_strs.join(\", \")} }"
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                let ty_name = (*_self).map_type(ty)
                let field_strs: Array<String> = fields.iter().map(fn(__kain_closure_arg4): f"{sanitize_emitted_identifier(__kain_closure_arg4.__kain_tuple_0)}: {(*_self).gen_const_value_expr(__kain_closure_arg4.__kain_tuple_1)}").collect()
                if (*zero_fill_rest):
                    if field_strs.is_empty():
                        "{ty_name} { ..Default::default() }"
                    else:
                        "{ty_name} { {field_strs.join(\", \")}, ..Default::default() }"
                else:
                    "{ty_name} { {field_strs.join(\", \")} }"
            kain_core__ast__Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: fields } =>
                match fields:
                    kain_core__ast__EnumVariantFields::Unit => (*_self).normalize_variant_head(Option::Some(enum_name), variant, none)
                    kain_core__ast__EnumVariantFields::Tuple(values) =>
                        let parts: Array<String> = values.iter().map(fn(value): (*_self).gen_const_value_expr(value)).collect()
                        "{(*_self).normalize_variant_head(Option::Some(enum_name), variant, none)}({parts.join(\", \")})"
                    kain_core__ast__EnumVariantFields::Struct(values) =>
                        let parts: Array<String> = values.iter().map(fn(__kain_closure_arg5): f"{__kain_closure_arg5.__kain_tuple_0}: {(*_self).gen_const_value_expr(__kain_closure_arg5.__kain_tuple_1)}").collect()
                        "{(*_self).normalize_variant_head(Option::Some(enum_name), variant, none)} { {parts.join(\", \")} }"
            _ => (*_self).gen_expr(expr)

    fn gen_function(_self: &mut RustGen, func: &kain_core::ast::Function):
        match (*func).name.strip_suffix("_fmt"):
            Some(target) =>
                if (!target.is_empty()):
                    (*_self).display_helpers.insert(target.to_string())
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                ()
                ()
        let self_ctx = (*_self).current_impl_target()
        let self_ctx_ref = self_ctx
        let free_self_alias = if (self_ctx_ref.is_none() && (*func).params.first().is_some_and(fn(param): none)):
            Option::Some(("value").to_string())
        else:
            none
        let mutated_params = (*_self).collect_mutated_bindings_in_block(&(*func).body)
        let binding_types = (*_self).collect_binding_types(func)
        (*_self).current_function_stack.push((*func).name.clone())
        ()
        let lifetime_names = (*_self).function_lifetime_generic_names(func)
        (*_self).push_generic_lifetimes(lifetime_names.clone())
        ()
        let vis = (*_self).visibility_prefix((*func).visibility)
        let modifiers = (*_self).function_modifiers(&(*func).effects)
        let params = (*_self).gen_params_with_context(&(*func).params, self_ctx_ref, Option::Some(&mutated_params), free_self_alias)
        let generic_params = (*_self).collect_function_generic_params(func)
        let generic_suffix = (*_self).render_generic_names(&generic_params, &lifetime_names)
        let ret = match (*_self).current_impl_trait():
            Some(trait_name) => if ((((*_self).trait_name_matches(trait_name, "Display") || (*_self).trait_name_matches(trait_name, "Debug"))) && ((*_self).rust_method_name(&(*func).name) == "fmt")): (" -> std::fmt::Result").to_string() else: none
            _ =>
                match &(*func).return_type:
                    Some(ty) => f" -> {(*_self).map_return_type(ty, self_ctx_ref)}"
                    _ => String__new_()
        let return_struct = (*func).return_type.and_then(fn(ty): none)
        let has_implicit_return = (*func).return_type.is_some_and(fn(ty): (!none))
        (*_self).emit_rust_attributes(&(*func).attributes)
        ()
        (*_self).write_line(&"{vis}{modifiers}fn {(*_self).rust_method_name(&(*func).name)}{generic_suffix}({params}){ret} {")
        ()
        (*_self).push_indent()
        ()
        match &self_ctx:
            Some(self_ctx) =>
                (*_self).self_type_stack.push(strip_rendered_type_generics(self_ctx))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).free_self_alias_stack.push(free_self_alias)
        ()
        (*_self).current_return_struct_stack.push(return_struct)
        ()
        (*_self).binding_type_stack.push(binding_types)
        ()
        (*_self).gen_block_with_implicit_return(&(*func).body, has_implicit_return)
        ()
        (*_self).binding_type_stack.pop()
        ()
        (*_self).current_return_struct_stack.pop()
        ()
        (*_self).free_self_alias_stack.pop()
        ()
        if self_ctx.is_some():
            (*_self).self_type_stack.pop()
            ()
            ()
            ()
            ()
        (*_self).pop_generic_lifetimes()
        ()
        (*_self).current_function_stack.pop()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()

    fn synthetic_impl_target(_self: &RustGen, func: &kain_core::ast::Function) -> Option<String>:
        if (*_self).current_impl_target().is_some():
            return none
        let target = (*_self).inferred_self_type(&(*func).name)?
        if (*_self).known_type_names.contains(target):
            Option::Some(target.to_string())
        else:
            none

    fn gen_synthetic_impl_function(_self: &mut RustGen, target: String, func: &kain_core::ast::Function):
        (*_self).write_line(&"impl {(*_self).normalize_runtime_path(target)} {")
        ()
        (*_self).push_indent()
        ()
        (*_self).impl_target_stack.push(target.to_string())
        ()
        (*_self).impl_trait_stack.push(none)
        ()
        (*_self).gen_function(func)
        ()
        (*_self).impl_trait_stack.pop()
        ()
        (*_self).impl_target_stack.pop()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()

    fn gen_params(_self: &RustGen, params: &[kain_core::ast::Param]) -> String:
        (*_self).gen_params_with_context(params, none, none, none)

    fn gen_params_with_context(_self: &RustGen, params: &[kain_core::ast::Param], self_ctx: Option<String>, mutated_params: Option<&Set<String>>, free_self_alias: Option<String>) -> String:
        let free_self_target = if (self_ctx.is_none() && free_self_alias.is_some()):
            (*_self).current_function_name().and_then(fn(name): (*_self).inferred_self_type(name))
        else:
            none
        let parts: Array<String> = params.iter().enumerate().map(fn(__kain_closure_arg6): none).collect()
        parts.join(", ")

    fn collect_function_generic_params(_self: &RustGen, func: &kain_core::ast::Function) -> Array<String>:
        let mut names: Array<String> = (*func).generics.iter().map(fn(generic): generic.name.clone()).collect()
        if ((*_self).current_impl_target().is_none() && (*_self).current_impl_trait().is_none()):
            let mut inferred = BTreeSet__new_()
            for param in &(*func).params:
                (*_self).collect_type_generic_params(&param.ty, &mut inferred)
                ()
            ()
            match &(*func).return_type:
                Some(return_type) =>
                    (*_self).collect_type_generic_params(return_type, &mut inferred)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            for inferred_name in inferred:
                if (!names.iter().any(fn(name): (name == &inferred_name))):
                    names.push(inferred_name)
                    ()
            ()
            ()
        names

    fn collect_type_generic_params(_self: &RustGen, ty: &kain_core::ast::Type, out_: &mut Set<String>):
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                let leaf = name.rsplit("::").next().unwrap_or(name).trim()
                for generic in generics:
                    (*_self).collect_type_generic_params(generic, out_)
                    ()
                ()
                if ((generics.is_empty() && leaf.chars().all(fn(ch): ch.is_ascii_uppercase())) && (!(*_self).known_type_names.contains(leaf))):
                    out_.insert(leaf.to_string())
                    ()
            kain_core__ast__Type::Tuple(types, _) =>
                for item in types:
                    (*_self).collect_type_generic_params(item, out_)
                    ()
            kain_core__ast__Type::Array(inner, _, _) =>
                (*_self).collect_type_generic_params(inner, out_)
                ()
            kain_core__ast__Type::Slice(inner, _) =>
                (*_self).collect_type_generic_params(inner, out_)
                ()
            kain_core__ast__Type::Ref { inner: inner } =>
                (*_self).collect_type_generic_params(inner, out_)
                ()
            kain_core__ast__Type::Ptr { inner: inner } =>
                (*_self).collect_type_generic_params(inner, out_)
                ()
            kain_core__ast__Type::Option(inner, _) =>
                (*_self).collect_type_generic_params(inner, out_)
                ()
            kain_core__ast__Type::Result(ok, err, _) =>
                (*_self).collect_type_generic_params(ok, out_)
                ()
                (*_self).collect_type_generic_params(err, out_)
                ()
            kain_core__ast__Type::Function { params: params, return_type: return_type } =>
                for param in params:
                    (*_self).collect_type_generic_params(param, out_)
                    ()
                ()
                (*_self).collect_type_generic_params(return_type, out_)
                ()
            kain_core__ast__Type::Impl { generics: generics } =>
                for generic in generics:
                    (*_self).collect_type_generic_params(generic, out_)
                    ()
            kain_core__ast__Type::Infer(_) => ()
            kain_core__ast__Type::Never(_) => ()
            kain_core__ast__Type::Unit(_) => ()

    fn looks_like_lifetime_name(_self: &RustGen, name: String) -> Bool:
        let leaf = name.rsplit("::").next().unwrap_or(name)
        if leaf.is_empty():
            return false
        if ((leaf == "static") || (leaf == "_")):
            return true
        let mut chars = leaf.chars()
        (none && chars.all(fn(ch): (ch.is_ascii_alphanumeric() || (ch == "_"))))

    fn collect_declared_lifetime_generic_names_from_type(_self: &RustGen, ty: &kain_core::ast::Type, declared_names: &Set<String>, out_: &mut Set<String>):
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                let leaf = name.rsplit("::").next().unwrap_or(name)
                if ((generics.is_empty() && ((declared_names.contains(name) || declared_names.contains(leaf)))) && (*_self).looks_like_lifetime_name(leaf)):
                    out_.insert(leaf.to_string())
                    ()
                    ()
                    ()
                    ()
                for generic in generics:
                    (*_self).collect_declared_lifetime_generic_names_from_type(generic, declared_names, out_)
                    ()
            kain_core__ast__Type::Tuple(types, _) =>
                for item in types:
                    (*_self).collect_declared_lifetime_generic_names_from_type(item, declared_names, out_)
                    ()
            kain_core__ast__Type::Array(inner, _, _) =>
                (*_self).collect_declared_lifetime_generic_names_from_type(inner, declared_names, out_)
                ()
            kain_core__ast__Type::Slice(inner, _) =>
                (*_self).collect_declared_lifetime_generic_names_from_type(inner, declared_names, out_)
                ()
            kain_core__ast__Type::Ptr { inner: inner } =>
                (*_self).collect_declared_lifetime_generic_names_from_type(inner, declared_names, out_)
                ()
            kain_core__ast__Type::Option(inner, _) =>
                (*_self).collect_declared_lifetime_generic_names_from_type(inner, declared_names, out_)
                ()
            kain_core__ast__Type::Ref { inner: inner, lifetime: lifetime } =>
                match lifetime:
                    Some(name) =>
                        let leaf = name.rsplit("::").next().unwrap_or(name)
                        if (((declared_names.contains(name) || declared_names.contains(leaf))) && (*_self).looks_like_lifetime_name(leaf)):
                            out_.insert(leaf.to_string())
                            ()
                            ()
                            ()
                            ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).collect_declared_lifetime_generic_names_from_type(inner, declared_names, out_)
                ()
            kain_core__ast__Type::Result(ok, err, _) =>
                (*_self).collect_declared_lifetime_generic_names_from_type(ok, declared_names, out_)
                ()
                (*_self).collect_declared_lifetime_generic_names_from_type(err, declared_names, out_)
                ()
            kain_core__ast__Type::Function { params: params, return_type: return_type } =>
                for param in params:
                    (*_self).collect_declared_lifetime_generic_names_from_type(param, declared_names, out_)
                    ()
                ()
                (*_self).collect_declared_lifetime_generic_names_from_type(return_type, declared_names, out_)
                ()
            kain_core__ast__Type::Impl { generics: generics } =>
                for generic in generics:
                    (*_self).collect_declared_lifetime_generic_names_from_type(generic, declared_names, out_)
                    ()
            kain_core__ast__Type::Infer(_) => ()
            kain_core__ast__Type::Never(_) => ()
            kain_core__ast__Type::Unit(_) => ()

    fn function_lifetime_generic_names(_self: &RustGen, func: &kain_core::ast::Function) -> Set<String>:
        let declared_names: Set<String> = (*func).generics.iter().map(fn(generic): generic.name.clone()).collect()
        let mut out_ = HashSet__new_()
        for param in &(*func).params:
            (*_self).collect_declared_lifetime_generic_names_from_type(&param.ty, &declared_names, &mut out_)
            ()
        ()
        match &(*func).return_type:
            Some(return_type) =>
                (*_self).collect_declared_lifetime_generic_names_from_type(return_type, &declared_names, &mut out_)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        out_

    fn struct_lifetime_generic_names(_self: &RustGen, struct_def: &kain_core::ast::Struct) -> Set<String>:
        let declared_names: Set<String> = (*struct_def).generics.iter().map(fn(generic): generic.name.clone()).collect()
        let mut out_ = HashSet__new_()
        for field in &(*struct_def).fields:
            (*_self).collect_declared_lifetime_generic_names_from_type(&field.ty, &declared_names, &mut out_)
            ()
        ()
        out_

    fn enum_lifetime_generic_names(_self: &RustGen, enum_def: &kain_core::ast::Enum) -> Set<String>:
        let declared_names: Set<String> = (*enum_def).generics.iter().map(fn(generic): generic.name.clone()).collect()
        let mut out_ = HashSet__new_()
        for variant in &(*enum_def).variants:
            match &variant.fields:
                kain_core__ast__VariantFields::Unit => ()
                kain_core__ast__VariantFields::Tuple(types) =>
                    for ty in types:
                        (*_self).collect_declared_lifetime_generic_names_from_type(ty, &declared_names, &mut out_)
                        ()
                kain_core__ast__VariantFields::Struct(fields) =>
                    for field in fields:
                        (*_self).collect_declared_lifetime_generic_names_from_type(&field.ty, &declared_names, &mut out_)
                        ()
        ()
        out_

    fn trait_lifetime_generic_names(_self: &RustGen, trait_def: &kain_core::ast::Trait) -> Set<String>:
        let declared_names: Set<String> = (*trait_def).generics.iter().map(fn(generic): generic.name.clone()).collect()
        let mut out_ = HashSet__new_()
        for method in &(*trait_def).methods:
            for param in &method.params:
                (*_self).collect_declared_lifetime_generic_names_from_type(&param.ty, &declared_names, &mut out_)
                ()
            ()
            match &method.return_type:
                Some(return_type) =>
                    (*_self).collect_declared_lifetime_generic_names_from_type(return_type, &declared_names, &mut out_)
                    ()
                _ => ()
        ()
        out_

    fn impl_lifetime_generic_names(_self: &RustGen, impl_def: &kain_core::ast::Impl) -> Set<String>:
        let declared_names: Set<String> = (*impl_def).generics.iter().map(fn(generic): generic.name.clone()).collect()
        let mut out_ = HashSet__new_()
        (*_self).collect_declared_lifetime_generic_names_from_type(&(*impl_def).target_type, &declared_names, &mut out_)
        ()
        for generic in &(*impl_def).trait_generics:
            (*_self).collect_declared_lifetime_generic_names_from_type(generic, &declared_names, &mut out_)
            ()
        ()
        for method in &(*impl_def).methods:
            for param in &method.params:
                (*_self).collect_declared_lifetime_generic_names_from_type(&param.ty, &declared_names, &mut out_)
                ()
            ()
            match &method.return_type:
                Some(return_type) =>
                    (*_self).collect_declared_lifetime_generic_names_from_type(return_type, &declared_names, &mut out_)
                    ()
                _ => ()
        ()
        out_

    fn type_alias_lifetime_generic_names(_self: &RustGen, generics: &[kain_core::ast::Generic], target: &kain_core::ast::Type) -> Set<String>:
        let declared_names: Set<String> = generics.iter().map(fn(generic): generic.name.clone()).collect()
        let mut out_ = HashSet__new_()
        (*_self).collect_declared_lifetime_generic_names_from_type(target, &declared_names, &mut out_)
        ()
        out_

    fn render_generic_name(_self: &RustGen, name: String, lifetime_names: &Set<String>) -> String:
        let leaf = name.rsplit("::").next().unwrap_or(name)
        if (((lifetime_names.contains(name) || lifetime_names.contains(leaf))) && (*_self).looks_like_lifetime_name(leaf)):
            f"'{(*_self).sanitize_lifetime_name(leaf)}"
        else:
            sanitize_emitted_identifier(name)

    fn render_generic_names(_self: &RustGen, names: &[String], lifetime_names: &Set<String>) -> String:
        if names.is_empty():
            String__new_()
        else:
            "<{names.iter().map(fn(name): (*_self).render_generic_name(name, lifetime_names)).collect().join(\", \")}>"

    fn render_generic_params(_self: &RustGen, generics: &[kain_core::ast::Generic], lifetime_names: &Set<String>) -> String:
        if generics.is_empty():
            String__new_()
        else:
            let names = generics.iter().map(fn(generic): generic.name.clone()).collect()
            (*_self).render_generic_names(&names, lifetime_names)

    fn emit_rust_attributes(_self: &mut RustGen, attrs: &[kain_core::ast::Attribute]):
        for attr in attrs:
            match (*_self).render_rust_attribute(attr):
                Some(rendered) =>
                    (*_self).write_line(&rendered)
                    ()
                _ => ()

    fn has_rust_attribute(_self: &RustGen, attrs: &[kain_core::ast::Attribute], target: String) -> Bool:
        attrs.iter().any(fn(attr): ((*_self).normalize_runtime_path(&attr.name) == target))

    fn render_rust_attribute(_self: &RustGen, attr: &kain_core::ast::Attribute) -> Option<String>:
        let name = (*_self).normalize_runtime_path(&(*attr).name)
        if (name == "doc"):
            if ((*attr).args.len() == 1):
                match (*_self).render_rust_doc_attr_value(&(*attr).args[0]):
                    Some(value) => return Option::Some(f"#[doc = {value}]")
                    _ =>
                        ()
                        ()
                ()
            ()
        if (*attr).args.is_empty():
            Option::Some(f"#[{name}]")
        else:
            Option::Some("#[{name}({(*attr).args.iter().map(fn(arg): (*_self).render_rust_attr_expr(arg)).collect().join(\", \")})]")

    fn render_rust_doc_attr_value(_self: &RustGen, expr: &kain_core::ast::Expr) -> Option<String>:
        match expr:
            kain_core__ast__Expr::Tuple(parts, _) if (parts.len() == 2) =>
                match &parts[0]:
                    kain_core__ast__Expr::Ident(name, _) =>
                        if ((*_self).normalize_runtime_path(name) == "doc"):
                            return Option::Some((*_self).render_rust_attr_expr(&parts[1]))
                        ()
                    _ =>
                        ()
                        ()
                none
            kain_core__ast__Expr::Assign { target: target, value: value } => if none: Option::Some((*_self).render_rust_attr_expr(value)) else: none
            kain_core__ast__Expr::String(_, _) => Option::Some((*_self).render_rust_attr_expr(expr))
            _ => none

    fn render_rust_attr_expr(_self: &RustGen, expr: &kain_core::ast::Expr) -> String:
        match expr:
            kain_core__ast__Expr::Ident(name, _) => (*_self).normalize_runtime_path(name)
            kain_core__ast__Expr::String(value, _) => value
            kain_core__ast__Expr::Int(value, _) => value.to_string()
            kain_core__ast__Expr::Float(value, _) => value.to_string()
            kain_core__ast__Expr::Bool(value, _) => value.to_string()
            kain_core__ast__Expr::Tuple(parts, _) if (parts.len() == 2) =>
                match &parts[0]:
                    kain_core__ast__Expr::Ident(name, _) => return f"{(*_self).normalize_runtime_path(name)} = {(*_self).render_rust_attr_expr(&parts[1])}"
                    _ =>
                        ()
                        ()
                (*_self).gen_expr(expr)
            kain_core__ast__Expr::Assign { target: target, value: value } => f"{(*_self).render_rust_attr_expr(target)} = {(*_self).render_rust_attr_expr(value)}"
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                let callee = (*_self).render_rust_attr_expr(callee)
                let args = args.iter().map(fn(arg): none).collect().join(", ")
                f"{callee}({args})"
            kain_core__ast__Expr::Field { object: object, field: field } => f"{(*_self).render_rust_attr_expr(object)}.{(*_self).render_field_accessor(field)}"
            _ => (*_self).gen_expr(expr)

    fn gen_struct(_self: &mut RustGen, struct_def: &kain_core::ast::Struct):
        let lifetime_names = (*_self).struct_lifetime_generic_names(struct_def)
        (*_self).push_generic_lifetimes(lifetime_names.clone())
        ()
        let vis = (*_self).visibility_prefix((*struct_def).visibility)
        let generics = (*_self).render_generic_params(&(*struct_def).generics, &lifetime_names)
        (*_self).emit_rust_attributes(&(*struct_def).attributes)
        ()
        if (!(*_self).has_rust_attribute(&(*struct_def).attributes, "derive")):
            (*_self).write_line("#[derive(Debug, Clone, PartialEq)]")
            ()
            ()
            ()
            ()
        (*_self).write_line(&"{vis}struct {sanitize_emitted_identifier(&(*struct_def).name)}{generics} {")
        ()
        (*_self).push_indent()
        ()
        for field in &(*struct_def).fields:
            (*_self).emit_rust_attributes(&field.attributes)
            ()
            (*_self).write_line(&f"{(*_self).visibility_prefix(field.visibility)}{sanitize_emitted_identifier(&field.name)}: {(*_self).map_storage_type(&field.ty, Option::Some(&(*struct_def).name))},")
            ()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).pop_generic_lifetimes()
        ()

    fn gen_impl(_self: &mut RustGen, impl_def: &kain_core::ast::Impl):
        let lifetime_names = (*_self).impl_lifetime_generic_names(impl_def)
        (*_self).push_generic_lifetimes(lifetime_names.clone())
        ()
        let impl_generics = (*_self).render_generic_params(&(*impl_def).generics, &lifetime_names)
        let target = (*_self).map_type(&(*impl_def).target_type)
        let trait_name = (*impl_def).trait_name.map(fn(name): none)
        match &trait_name:
            Some(trait_name) =>
                (*_self).write_line(&"impl{impl_generics} {trait_name} for {target} {")
                ()
                ()
                ()
                ()
            _ =>
                (*_self).write_line(&"impl{impl_generics} {target} {")
                ()
                ()
                ()
                ()
        (*_self).push_indent()
        ()
        (*_self).impl_target_stack.push(target.clone())
        ()
        (*_self).impl_trait_stack.push((*impl_def).trait_name.clone())
        ()
        for method in &(*impl_def).methods:
            (*_self).gen_function(method)
            ()
            (*_self).write_blank()
            ()
        ()
        (*_self).impl_trait_stack.pop()
        ()
        (*_self).impl_target_stack.pop()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).pop_generic_lifetimes()
        ()

    fn gen_enum(_self: &mut RustGen, enum_def: &kain_core::ast::Enum):
        let lifetime_names = (*_self).enum_lifetime_generic_names(enum_def)
        (*_self).push_generic_lifetimes(lifetime_names.clone())
        ()
        let generics = (*_self).render_generic_params(&(*enum_def).generics, &lifetime_names)
        (*_self).write_line("#[derive(Debug, Clone, PartialEq)]")
        ()
        (*_self).write_line(&"{(*_self).visibility_prefix((*enum_def).visibility)}enum {sanitize_emitted_identifier(&(*enum_def).name)}{generics} {")
        ()
        (*_self).push_indent()
        ()
        for variant in &(*enum_def).variants:
            match &variant.fields:
                kain_core__ast__VariantFields::Unit =>
                    (*_self).write_line(&f"{sanitize_emitted_identifier(&variant.name)},")
                    ()
                kain_core__ast__VariantFields::Tuple(types) =>
                    let fields: Array<String> = types.iter().map(fn(t): (*_self).map_storage_type(t, Option::Some(&(*enum_def).name))).collect()
                    (*_self).write_line(&"{sanitize_emitted_identifier(&variant.name)}({fields.join(\", \")}),")
                    ()
                kain_core__ast__VariantFields::Struct(fields) =>
                    (*_self).write_line(&"{sanitize_emitted_identifier(&variant.name)} {")
                    ()
                    (*_self).push_indent()
                    ()
                    for f in fields:
                        (*_self).write_line(&f"{sanitize_emitted_identifier(&f.name)}: {(*_self).map_storage_type(&f.ty, Option::Some(&(*enum_def).name))},")
                        ()
                    ()
                    (*_self).pop_indent()
                    ()
                    (*_self).write_line("},")
                    ()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).pop_generic_lifetimes()
        ()

    fn component_props_name(_self: &RustGen, name: String) -> String:
        f"{name}Props"

    fn gen_component_props_struct(_self: &mut RustGen, comp: &kain_core::ast::Component):
        let props_name = (*_self).component_props_name(&(*comp).name)
        let vis = (*_self).visibility_prefix((*comp).visibility)
        (*_self).write_line("#[derive(Debug, Clone, PartialEq)]")
        ()
        (*_self).write_line(&"{vis}struct {props_name} {")
        ()
        (*_self).push_indent()
        ()
        for prop in &(*comp).props:
            (*_self).write_line(&f"pub {prop.name}: {(*_self).map_type(&prop.ty)},")
            ()
        ()
        (*_self).write_line("pub children: String,")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()
        (*_self).write_blank()
        ()

    fn gen_component(_self: &mut RustGen, comp: &kain_core::ast::Component):
        let vis = (*_self).visibility_prefix((*comp).visibility)
        let modifiers = (*_self).function_modifiers(&(*comp).effects)
        let props_name = (*_self).component_props_name(&(*comp).name)
        let mut prop_bindings: Array<String> = (*comp).props.iter().map(fn(prop): prop.name.clone()).collect()
        prop_bindings.push(("children").to_string())
        ()
        (*_self).gen_component_props_struct(comp)
        ()
        (*_self).write_line(&"{vis}{modifiers}fn {(*_self).rust_function_name(&(*comp).name)}(props: {props_name}) -> String {")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_line(&"let {props_name} { {prop_bindings.join(\", \")} } = props;")
        ()
        if ((!(*comp).state_.is_empty()) || (!(*comp).methods.is_empty())):
            (*_self).write_blank()
            ()
            ()
            ()
            ()
        for state_ in &(*comp).state_:
            (*_self).write_line(&f"let mut {state_.name}: {(*_self).map_type(&state_.ty)} = {(*_self).gen_expr(&state_.initial)};")
            ()
        ()
        if ((!(*comp).state_.is_empty()) && (!(*comp).methods.is_empty())):
            (*_self).write_blank()
            ()
            ()
            ()
            ()
        for selfhost_for_item in (*comp).methods.iter().enumerate():
            let (index, method) = selfhost_for_item
            (*_self).gen_component_method_binding(method)
            ()
            if ((index + 1) != (*comp).methods.len()):
                (*_self).write_blank()
                ()
        ()
        if (!(*comp).methods.is_empty()):
            (*_self).write_blank()
            ()
            ()
            ()
            ()
        (*_self).write_line(&(*_self).gen_jsx(&(*comp).body))
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("}")
        ()

    fn gen_component_method_binding(_self: &mut RustGen, method: &kain_core::ast::Function):
        let params = (*_self).gen_params(&(*method).params)
        let ret = match &(*method).return_type:
            Some(ty) => f" -> {(*_self).map_return_type(ty, none)}"
            _ => String__new_()
        let has_implicit_return = (*method).return_type.is_some_and(fn(ty): (!none))
        (*_self).write_line(&"let mut {(*method).name} = |{params}|{ret} {")
        ()
        (*_self).push_indent()
        ()
        (*_self).gen_block_with_implicit_return(&(*method).body, has_implicit_return)
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_line("};")
        ()

    fn gen_block(_self: &mut RustGen, block: &kain_core::ast::Block):
        (*_self).gen_block_with_implicit_return(block, false)
        ()

    fn gen_block_with_implicit_return(_self: &mut RustGen, block: &kain_core::ast::Block, implicit_return: Bool):
        let len = (*block).stmts.len()
        for selfhost_for_item in (*block).stmts.iter().enumerate():
            let (i, stmt) = selfhost_for_item
            let is_last = ((i + 1) == len)
            if (implicit_return && is_last):
                match stmt:
                    kain_core__ast__Stmt::Expr(expr) =>
                        if (!none):
                            (*_self).write_line(&(*_self).gen_expr(expr))
                            ()
                            continue
                        ()
                    _ =>
                        ()
                        ()
                ()
            (*_self).gen_stmt(stmt)
            ()

    fn gen_stmt(_self: &mut RustGen, stmt: &kain_core::ast::Stmt):
        match stmt:
            kain_core__ast__Stmt::Let { pattern: pattern, ty: ty, value: value } =>
                let pat_str = (*_self).gen_pattern(pattern)
                let ty_str = ty.map(fn(t): f": {(*_self).map_type(t)}").unwrap_or_default()
                match value:
                    Some(val) =>
                        (*_self).write_line(&f"let {pat_str}{ty_str} = {(*_self).gen_expr(val)};")
                        ()
                    _ =>
                        (*_self).write_line(&f"let {pat_str}{ty_str};")
                        ()
            kain_core__ast__Stmt::Return(maybe_expr, _) =>
                match maybe_expr:
                    Some(expr) =>
                        (*_self).write_line(&f"return {(*_self).gen_expr(expr)};")
                        ()
                    _ =>
                        (*_self).write_line("return;")
                        ()
            kain_core__ast__Stmt::Break(maybe_expr, _) =>
                match maybe_expr:
                    Some(expr) =>
                        (*_self).write_line(&f"break {(*_self).gen_expr(expr)};")
                        ()
                    _ =>
                        (*_self).write_line("break;")
                        ()
            kain_core__ast__Stmt::Continue(_) =>
                (*_self).write_line("continue;")
                ()
            kain_core__ast__Stmt::For { binding: binding, iter: iter, body: body } =>
                let pat = (*_self).gen_pattern(binding)
                (*_self).write_line(&"for {pat} in {(*_self).gen_expr(iter)} {")
                ()
                (*_self).push_indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).pop_indent()
                ()
                (*_self).write_line("}")
                ()
            kain_core__ast__Stmt::While { condition: condition, body: body } =>
                (*_self).write_line(&"while {(*_self).gen_expr(condition)} {")
                ()
                (*_self).push_indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).pop_indent()
                ()
                (*_self).write_line("}")
                ()
            kain_core__ast__Stmt::Loop { body: body } =>
                (*_self).write_line("loop {")
                ()
                (*_self).push_indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).pop_indent()
                ()
                (*_self).write_line("}")
                ()
            kain_core__ast__Stmt::Expr(expr) =>
                match expr:
                    kain_core__ast__Expr::Assign { target: target, value: value } =>
                        (*_self).write_line(&f"{(*_self).gen_expr(target)} = {(*_self).gen_expr(value)};")
                        ()
                    _ =>
                        match expr:
                            kain_core__ast__Expr::Match { scrutinee: scrutinee, arms: arms } =>
                                (*_self).write_line(&(*_self).gen_match_expr(scrutinee, arms, true))
                                ()
                            _ =>
                                (*_self).write_line(&f"{(*_self).gen_expr(expr)};")
                                ()
            kain_core__ast__Stmt::Item(item) => (*_self).gen_nested_item(item)

    fn gen_block_expr(_self: &RustGen, block: &kain_core::ast::Block) -> String:
        if (*_self).is_selfhost_empty_block(block):
            return ("{ () }").to_string()
        let len = (*block).stmts.len()
        let mut stmt_strs = Vec__new_()
        for selfhost_for_item in (*block).stmts.iter().enumerate():
            let (index, stmt) = selfhost_for_item
            stmt_strs.push((*_self).gen_stmt_inline(stmt, ((index + 1) == len)))
            ()
        ()
        if stmt_strs.is_empty():
            ("{ () }").to_string()
        else:
            "{ {stmt_strs.join(\" \")} }"

    fn gen_stmt_inline(_self: &RustGen, stmt: &kain_core::ast::Stmt, is_last: Bool) -> String:
        match stmt:
            kain_core__ast__Stmt::Let { pattern: pattern, ty: ty, value: value } =>
                let pat_str = (*_self).gen_pattern(pattern)
                let ty_str = ty.map(fn(t): f": {(*_self).map_type(t)}").unwrap_or_default()
                match value:
