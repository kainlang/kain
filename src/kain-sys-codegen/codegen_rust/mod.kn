                    return none
                if ((normalized_method == "strip_prefix") && (args.len() == 1)):
                    match &args[0].value:
                        kain_core__ast__Expr::String(value, _) => return f"{recv}.strip_prefix(\"{(*_self).escape_string(value)}\")"
                        _ =>
