use crate::cue_ir::CueTypeIR

use crate::cue_ir::GameplayCueIR

use kain_core::error::KainResult

@doc(doc = " Output structure for cue codegen")
@derive(Debug, Clone)
pub struct GameplayCueOutput:
    header: String
    source: String

@doc(doc = " Generate complete C++ code for a gameplay cue")
pub fn generate(cue_ir: &GameplayCueIR, plugin_name: String) -> Result<GameplayCueOutput, KainError>:
    match (*cue_ir).cue_type:
        CueTypeIR::Static => generate_static_cue(cue_ir, plugin_name)
        CueTypeIR::Actor => generate_actor_cue(cue_ir, plugin_name)

@doc(doc = " Generate static cue (UGameplayCueNotify_Static)")
fn generate_static_cue(cue_ir: &GameplayCueIR, _plugin_name: String) -> Result<GameplayCueOutput, KainError>:
    let class_name = f"U{(*cue_ir).name}"
    let header = generate_static_header(cue_ir, &class_name)?
    let source = generate_static_source(cue_ir, &class_name)?
    Result::Ok(GameplayCueOutput { header: header, source: source })

@doc(doc = " Generate actor cue (AGameplayCueNotify_Actor)")
fn generate_actor_cue(cue_ir: &GameplayCueIR, _plugin_name: String) -> Result<GameplayCueOutput, KainError>:
    let class_name = f"A{(*cue_ir).name}"
    let header = generate_actor_header(cue_ir, &class_name)?
    let source = generate_actor_source(cue_ir, &class_name)?
    Result::Ok(GameplayCueOutput { header: header, source: source })

@doc(doc = " Generate static cue header")
fn generate_static_header(cue_ir: &GameplayCueIR, class_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"GameplayCueNotify_Static.h\"\n")
    ()
    output.push_str(&f"#include \"{(*cue_ir).name}.generated.h\"\n\n")
    ()
    output.push_str("UCLASS()\n")
    ()
    output.push_str(&f"class {class_name} : public UGameplayCueNotify_Static\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("\tGENERATED_BODY()\n\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"\t{class_name}();\n\n")
    ()
    if (*cue_ir).on_execute_body.is_some():
        output.push_str("\tvirtual bool OnExecute_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) const override;\n")
        ()
        ()
        ()
        ()
    if (*cue_ir).on_add_body.is_some():
        output.push_str("\tvirtual bool OnActive_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) const override;\n")
        ()
        ()
        ()
        ()
    if (*cue_ir).on_remove_body.is_some():
        output.push_str("\tvirtual bool OnRemove_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) const override;\n")
        ()
        ()
        ()
        ()
    if (*cue_ir).while_active_body.is_some():
        output.push_str("\tvirtual bool WhileActive_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) const override;\n")
        ()
        ()
        ()
        ()
    output.push_str("};\n")
    ()
    Result::Ok(output)

@doc(doc = " Generate static cue source")
fn generate_static_source(cue_ir: &GameplayCueIR, class_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str(&f"#include \"Cues/{(*cue_ir).name}.h\"\n")
    ()
    output.push_str("#include \"GameplayTags.h\"\n\n")
    ()
    output.push_str(&f"{class_name}::{class_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str(&f"\tGameplayCueTag = FGameplayTag::RequestGameplayTag(FName(\"{(*cue_ir).tag}\"));\n")
    ()
    output.push_str("}\n\n")
    ()
    match (*cue_ir).on_execute_body:
        Some(body) =>
            output.push_str(&f"bool {class_name}::OnExecute_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) const\n")
            ()
            output.push_str("{\n")
            ()
            output.push_str(&f"\t{body}\n")
            ()
            output.push_str("\treturn true;\n")
            ()
            output.push_str("}\n\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*cue_ir).on_add_body:
        Some(body) =>
            output.push_str(&f"bool {class_name}::OnActive_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) const\n")
            ()
            output.push_str("{\n")
            ()
            output.push_str(&f"\t{body}\n")
            ()
            output.push_str("\treturn true;\n")
            ()
            output.push_str("}\n\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*cue_ir).on_remove_body:
        Some(body) =>
            output.push_str(&f"bool {class_name}::OnRemove_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) const\n")
            ()
            output.push_str("{\n")
            ()
            output.push_str(&f"\t{body}\n")
            ()
            output.push_str("\treturn true;\n")
            ()
            output.push_str("}\n\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*cue_ir).while_active_body:
        Some(body) =>
            output.push_str(&f"bool {class_name}::WhileActive_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) const\n")
            ()
            output.push_str("{\n")
            ()
            output.push_str(&f"\t{body}\n")
            ()
            output.push_str("\treturn true;\n")
            ()
            output.push_str("}\n\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(output)

@doc(doc = " Generate actor cue header")
fn generate_actor_header(cue_ir: &GameplayCueIR, class_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"GameplayCueNotify_Actor.h\"\n")
    ()
    output.push_str(&f"#include \"{(*cue_ir).name}.generated.h\"\n\n")
    ()
    output.push_str("UCLASS()\n")
    ()
    output.push_str(&f"class {class_name} : public AGameplayCueNotify_Actor\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("\tGENERATED_BODY()\n\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"\t{class_name}();\n\n")
    ()
    for field in &(*cue_ir).state_fields:
        output.push_str("\tUPROPERTY()\n")
        ()
        output.push_str(&f"\t{field.field_type} {field.name};\n\n")
        ()
    ()
    if (*cue_ir).on_execute_body.is_some():
        output.push_str("\tvirtual bool OnExecute_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) override;\n")
        ()
        ()
        ()
        ()
    if (*cue_ir).on_add_body.is_some():
        output.push_str("\tvirtual bool OnActive_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) override;\n")
        ()
        ()
        ()
        ()
    if (*cue_ir).on_remove_body.is_some():
        output.push_str("\tvirtual bool OnRemove_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) override;\n")
        ()
        ()
        ()
        ()
    if (*cue_ir).while_active_body.is_some():
        output.push_str("\tvirtual bool WhileActive_Implementation(AActor* Target, const FGameplayCueParameters& Parameters) override;\n")
        ()
        ()
        ()
        ()
    output.push_str("};\n")
    ()
    Result::Ok(output)

@doc(doc = " Generate actor cue source")
fn generate_actor_source(cue_ir: &GameplayCueIR, class_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str(&f"#include \"Cues/{(*cue_ir).name}.h\"\n")
    ()
    output.push_str("#include \"GameplayTags.h\"\n\n")
    ()
    output.push_str(&f"{class_name}::{class_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str(&f"\tGameplayCueTag = FGameplayTag::RequestGameplayTag(FName(\"{(*cue_ir).tag}\"));\n")
    ()
    if (*cue_ir).auto_destroy:
        output.push_str("\tbAutoDestroyOnRemove = true;\n")
        ()
        ()
        ()
        ()
    output.push_str("}\n\n")
    ()
    match (*cue_ir).on_execute_body:
        Some(body) =>
            output.push_str(&f"bool {class_name}::OnExecute_Implementation(AActor* Target, const FGameplayCueParameters& Parameters)\n")
            ()
            output.push_str("{\n")
            ()
            output.push_str(&f"\t{body}\n")
            ()
            output.push_str("\treturn true;\n")
            ()
            output.push_str("}\n\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*cue_ir).on_add_body:
        Some(body) =>
            output.push_str(&f"bool {class_name}::OnActive_Implementation(AActor* Target, const FGameplayCueParameters& Parameters)\n")
            ()
            output.push_str("{\n")
            ()
            output.push_str(&f"\t{body}\n")
            ()
            output.push_str("\treturn true;\n")
            ()
            output.push_str("}\n\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*cue_ir).on_remove_body:
        Some(body) =>
            output.push_str(&f"bool {class_name}::OnRemove_Implementation(AActor* Target, const FGameplayCueParameters& Parameters)\n")
            ()
            output.push_str("{\n")
            ()
            output.push_str(&f"\t{body}\n")
            ()
            output.push_str("\treturn true;\n")
            ()
            output.push_str("}\n\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*cue_ir).while_active_body:
        Some(body) =>
            output.push_str(&f"bool {class_name}::WhileActive_Implementation(AActor* Target, const FGameplayCueParameters& Parameters)\n")
            ()
            output.push_str("{\n")
            ()
            output.push_str(&f"\t{body}\n")
            ()
            output.push_str("\treturn true;\n")
            ()
            output.push_str("}\n\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(output)

