fn node_prop_string(node: &UiNode, key: String) -> Option<String>:
    (*node).props.get(key).and_then(fn(value): none)

fn first_string_prop(node: &UiNode, keys: &[String]) -> Option<String>:
    keys.iter().find_map(fn(key): node_prop_string(node, key))

fn first_bool_prop(node: &UiNode, keys: &[String]) -> Option<Bool>:
    keys.iter().find_map(fn(key): (*node).props.get((*key)).and_then(fn(value): none))

impl UiNativeProjectionKind:
    fn from_widget_kind(kind: &UiWidgetKind) -> UiNativeProjectionKind:
        match kind:
            UiWidgetKind::Element(_) => UiNativeProjectionKind__Element
            UiWidgetKind::ComponentRef(_) => UiNativeProjectionKind__ComponentRef
            UiWidgetKind::Text => UiNativeProjectionKind__Text
            UiWidgetKind::Panel => UiNativeProjectionKind__Panel
            UiWidgetKind::Inspector => UiNativeProjectionKind__Inspector
            UiWidgetKind::Graph => UiNativeProjectionKind__Graph
            UiWidgetKind::Timeline => UiNativeProjectionKind__Timeline
            UiWidgetKind::Table => UiNativeProjectionKind__Table
            UiWidgetKind::Tree => UiNativeProjectionKind__Tree
            UiWidgetKind::Viewport2D => UiNativeProjectionKind__Viewport2D
            UiWidgetKind::Viewport3D => UiNativeProjectionKind__Viewport3D
            UiWidgetKind::Overlay => UiNativeProjectionKind__Overlay
            UiWidgetKind::Slot => UiNativeProjectionKind__Slot


@doc(doc = " Builder that assigns stable ids, retains nodes, and emits patch commands")
@doc(doc = " while the semantic graph is constructed.")
@derive(Clone, Debug, Default)
pub struct UiTreeBuilder:
    next_node_id: u64
    tree: UiTree
    patches: Array<UiPatch>

impl Default for UiTreeBuilder:
    pub fn default_() -> UiTreeBuilder:
        UiTreeBuilder { next_node_id: 0, tree: UiTree__default_(), patches: Vec__new_() }


impl UiTreeBuilder:
    pub fn new_() -> UiTreeBuilder:
        UiTreeBuilder__default_()

    pub fn alloc_id(_self: &mut UiTreeBuilder) -> UiNodeId:
        (*_self).next_node_id = ((*_self).next_node_id + 1)
        ()
        UiNodeId((*_self).next_node_id)

    pub fn add_node(_self: &mut UiTreeBuilder, node: UiNode):
        (*_self).tree.nodes.insert(node.id, node.clone())
        ()
        (*_self).patches.push(UiPatch::CreateNode { node: node })
        ()

    pub fn set_root(_self: &mut UiTreeBuilder, id: UiNodeId):
        (*_self).tree.root = Option::Some(id)
        ()
        (*_self).patches.push(UiPatch::SetRoot { id: id })
        ()

    pub fn replace_children(_self: &mut UiTreeBuilder, parent: UiNodeId, children: Array<UiNodeId>):
        match (*_self).tree.node_mut(parent):
            Some(node) =>
                node.children = children.clone()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).patches.push(UiPatch::ReplaceChildren { parent: parent, children: children })
        ()

    pub fn set_prop(_self: &mut UiTreeBuilder, id: UiNodeId, key: impl Into<String>, value: UiValue):
        let key = key.into()
        match (*_self).tree.node_mut(id):
            Some(node) =>
                node.props.insert(key.clone(), value.clone())
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).patches.push(UiPatch::SetProp { id: id, key: key, value: value })
        ()

    pub fn set_layout(_self: &mut UiTreeBuilder, id: UiNodeId, layout: UiLayoutSpec):
        match (*_self).tree.node_mut(id):
            Some(node) =>
                node.layout = layout.clone()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).patches.push(UiPatch::SetLayout { id: id, layout: layout })
        ()

    pub fn set_style(_self: &mut UiTreeBuilder, id: UiNodeId, style: UiStyleSpec):
        match (*_self).tree.node_mut(id):
            Some(node) =>
                node.style = style.clone()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).patches.push(UiPatch::SetStyle { id: id, style: style })
        ()

    pub fn finish(_self: UiTreeBuilder) -> UiBuildOutput:
        let systems = ui_runtime_systems_from_tree(&_self.tree)
        UiBuildOutput { tree: _self.tree, patches: _self.patches, systems: systems }


@doc(doc = " Debug helper for inspecting the semantic tree without a renderer.")
pub fn render_debug_tree(tree: &UiTree) -> String:
    let Some(root) = (*tree).root
    let mut out_ = Vec__new_()
    render_debug_tree_node(tree, root, 0, &mut out_)
    ()
    out_.join("\n")

fn render_debug_tree_node(tree: &UiTree, id: UiNodeId, depth: usize, out_: &mut Array<String>):
    let Some(node) = tree.node(id)
    let props = if node.props.is_empty():
        String__new_()
    else:
        let props = node.props.iter().map(fn(__kain_closure_arg15): f"{__kain_closure_arg15.__kain_tuple_0}={__kain_closure_arg15.__kain_tuple_1}").collect().join(", ")
        " {{props}}"
    out_.push("{(\"  \").repeat(depth)}{node.kind}#{node.id.field_0}{props}")
    ()
    for child in &node.children:
        render_debug_tree_node(tree, (*child), (depth + 1), out_)
        ()

