        UiResolvedLayout { viewport: UiRect__default_(), nodes: Vec__new_() }


@derive(Clone, Debug, PartialEq, serde__Serialize, serde__Deserialize)
pub struct UiPersistedDockState:
    placement: UiDockPlacement
    split_ratio: Option<f32>

@derive(Clone, Debug, Default, PartialEq, serde__Serialize, serde__Deserialize)
pub struct UiWorkspaceLayoutSnapshot:
    persistence_key: Option<String>
    active_tabs: Map<String, String>
    nodes: Map<String, UiPersistedDockState>

impl Default for UiWorkspaceLayoutSnapshot:
    pub fn default_() -> UiWorkspaceLayoutSnapshot:
        UiWorkspaceLayoutSnapshot { persistence_key: none, active_tabs: HashMap__new_(), nodes: HashMap__new_() }


pub fn ui_solve_workspace_layout(tree: &UiTree, systems: &UiRuntimeSystems, viewport_size: [f32; 2]) -> UiResolvedLayout:
    let viewport = UiRect { x: 0, y: 0, width: viewport_size[0].max(1), height: viewport_size[1].max(1) }
    let mut resolved = UiResolvedLayout { viewport: viewport, nodes: Vec__new_() }
    match (*tree).root:
        Some(root) =>
            solve_layout_node(tree, root, viewport, systems, &mut resolved)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    resolved

pub fn ui_workspace_layout_snapshot(tree: &UiTree, systems: &UiRuntimeSystems) -> UiWorkspaceLayoutSnapshot:
    let mut snapshot = UiWorkspaceLayoutSnapshot { persistence_key: (*systems).workspace_layout.persistence_key.clone(), active_tabs: (*systems).workspace_layout.active_tabs.clone(), nodes: BTreeMap__new_() }
    for node in (*tree).nodes.values():
        match node.layout.persistent_layout_id.or_(node.identity_key):
            Some(layout_id) =>
                snapshot.nodes.insert(layout_id.clone(), UiPersistedDockState { placement: node.layout.dock.unwrap_or(UiDockPlacement__Center), split_ratio: node.layout.split_ratio })
                ()
            _ => ()
    ()
    snapshot

pub fn ui_apply_workspace_layout_snapshot(tree: &mut UiTree, systems: &mut UiRuntimeSystems, snapshot: &UiWorkspaceLayoutSnapshot) -> usize:
    let mut applied = 0
    (*systems).workspace_layout.persistence_key = (*snapshot).persistence_key.clone()
    ()
    (*systems).workspace_layout.active_tabs = (*snapshot).active_tabs.clone()
    ()
    for node in (*tree).nodes.values_mut():
        let Some(layout_id) = node.layout.persistent_layout_id.clone().or_else(fn(): node.identity_key.clone())
        let Some(saved) = (*snapshot).nodes.get(&layout_id)
        node.layout.dock = Option::Some(saved.placement)
        ()
        node.layout.split_ratio = saved.split_ratio
        ()
        applied = (applied + 1)
        ()
    ()
    let mut rebuilt = ui_runtime_systems_from_tree(tree).workspace_layout
    rebuilt.persistence_key = (*snapshot).persistence_key.clone()
    ()
    rebuilt.active_tabs = resolve_workspace_active_tabs(tree, Option::Some(&(*snapshot).active_tabs))
    ()
    (*systems).workspace_layout = rebuilt
    ()
    applied

fn solve_layout_node(tree: &UiTree, id: UiNodeId, rect: UiRect, systems: &UiRuntimeSystems, resolved: &mut UiResolvedLayout):
    let Some(node) = tree.node(id)
    (*resolved).nodes.push(UiResolvedLayoutNode { node: id, rect: rect, layout_kind: node.layout.kind })
    ()
    if node.children.is_empty():
        return
    match node.layout.kind:
        UiLayoutKind::Dock => solve_dock_children(tree, node, rect, systems, resolved)
        UiLayoutKind::FlexRow => solve_row_children(tree, node, rect, systems, resolved)
        UiLayoutKind::FlexColumn => solve_column_children(tree, node, rect, systems, resolved)
        UiLayoutKind::Flow => solve_column_children(tree, node, rect, systems, resolved)
        UiLayoutKind::Stack =>
            for child in &node.children:
                solve_layout_node(tree, (*child), rect, systems, resolved)
                ()
        UiLayoutKind::Absolute =>
            for child in &node.children:
                solve_layout_node(tree, (*child), rect, systems, resolved)
                ()
        UiLayoutKind::Grid =>
            for child in &node.children:
                solve_layout_node(tree, (*child), rect, systems, resolved)
                ()

fn solve_dock_children(tree: &UiTree, node: &UiNode, rect: UiRect, systems: &UiRuntimeSystems, resolved: &mut UiResolvedLayout):
    let mut remaining = rect
    for child_id in &(*node).children:
        let Some(child) = tree.node((*child_id))
        let preferred_ratio = child.layout.split_ratio.or_else(fn(): persisted_split_ratio(child, systems)).unwrap_or(0.25).clamp(0.1, 0.9)
        let dock_placement = child.layout.dock.unwrap_or(UiDockPlacement__Center)
        if ((dock_placement == UiDockPlacement__Tab) && (!node_is_active_tab(tree, child, systems))):
            continue
        let child_rect = match dock_placement:
            UiDockPlacement::Left =>
                let width = (remaining.width * preferred_ratio)
                let child_rect = UiRect { x: remaining.x, y: remaining.y, width: width, height: remaining.height }
                remaining.x = (remaining.x + width)
                ()
                remaining.width = (remaining.width - width)
                ()
                child_rect
            UiDockPlacement::Right =>
                let width = (remaining.width * preferred_ratio)
                let child_rect = UiRect { x: ((remaining.x + remaining.width) - width), y: remaining.y, width: width, height: remaining.height }
                remaining.width = (remaining.width - width)
                ()
                child_rect
            UiDockPlacement::Top =>
                let height = (remaining.height * preferred_ratio)
                let child_rect = UiRect { x: remaining.x, y: remaining.y, width: remaining.width, height: height }
                remaining.y = (remaining.y + height)
                ()
                remaining.height = (remaining.height - height)
                ()
                child_rect
            UiDockPlacement::Bottom =>
                let height = (remaining.height * preferred_ratio)
                let child_rect = UiRect { x: remaining.x, y: ((remaining.y + remaining.height) - height), width: remaining.width, height: height }
                remaining.height = (remaining.height - height)
                ()
                child_rect
            UiDockPlacement::Center => remaining
            UiDockPlacement::Tab => remaining
        solve_layout_node(tree, (*child_id), child_rect, systems, resolved)
        ()

fn solve_row_children(tree: &UiTree, node: &UiNode, rect: UiRect, systems: &UiRuntimeSystems, resolved: &mut UiResolvedLayout):
    let total_gap = ((*node).layout.gap * (*node).children.len().saturating_sub(1) as f32)
    let total_flex = (*node).children.iter().filter_map(fn(child_id): tree.node((*child_id))).map(fn(child): child.layout.flex_grow.max(1)).sum().max(1)
    let mut cursor_x = rect.x
    for child_id in &(*node).children:
        let Some(child) = tree.node((*child_id))
        let share = (child.layout.flex_grow.max(1) / total_flex)
        let width = ((((rect.width - total_gap)).max(1)) * share)
        let child_rect = UiRect { x: cursor_x, y: rect.y, width: width, height: rect.height }
        cursor_x = (cursor_x + (width + (*node).layout.gap))
        ()
        solve_layout_node(tree, (*child_id), child_rect, systems, resolved)
        ()

fn solve_column_children(tree: &UiTree, node: &UiNode, rect: UiRect, systems: &UiRuntimeSystems, resolved: &mut UiResolvedLayout):
    let total_gap = ((*node).layout.gap * (*node).children.len().saturating_sub(1) as f32)
    let total_flex = (*node).children.iter().filter_map(fn(child_id): tree.node((*child_id))).map(fn(child): child.layout.flex_grow.max(1)).sum().max(1)
    let mut cursor_y = rect.y
    for child_id in &(*node).children:
        let Some(child) = tree.node((*child_id))
        let share = (child.layout.flex_grow.max(1) / total_flex)
        let height = ((((rect.height - total_gap)).max(1)) * share)
        let child_rect = UiRect { x: rect.x, y: cursor_y, width: rect.width, height: height }
        cursor_y = (cursor_y + (height + (*node).layout.gap))
        ()
        solve_layout_node(tree, (*child_id), child_rect, systems, resolved)
        ()

fn persisted_split_ratio(node: &UiNode, systems: &UiRuntimeSystems) -> Option<f32>:
    let persisted_id = (*node).layout.persistent_layout_id.or_((*node).identity_key)?
    (*systems).workspace_layout.roots.iter().find(fn(entry): (entry.persistent_layout_id == Option::Some(persisted_id))).and_then(fn(entry): entry.split_ratio)

fn node_layout_id(node: &UiNode) -> String:
    (*node).layout.persistent_layout_id.clone().or_else(fn(): (*node).identity_key.clone()).unwrap_or_else(fn(): f"node-{(*node).id.field_0}")

fn resolve_workspace_active_tabs(tree: &UiTree, persisted: Option<&Map<String, String>>) -> Map<String, String>:
    let mut grouped_tabs = BTreeMap__new_()
    let mut resolved = BTreeMap__new_()
    for node in (*tree).nodes.values():
        let Some(group_id) = node.layout.tab_group_id.clone()
        grouped_tabs.entry(group_id).or_default().push((node, node_layout_id(node)))
        ()
    ()
    for selfhost_for_item in grouped_tabs:
        let (group_id, mut tabs) = selfhost_for_item
        match persisted.and_then(fn(saved): saved.get(&group_id)):
            Some(saved_layout_id) =>
                if tabs.iter().any(fn(__kain_closure_arg0): (__kain_closure_arg0.__kain_tuple_1 == saved_layout_id)):
                    resolved.insert(group_id, saved_layout_id.clone())
                    ()
                    continue
                ()
            _ =>
                ()
                ()
        tabs.sort_by_key(fn(__kain_closure_arg1): (__kain_closure_arg1.__kain_tuple_0.layout.tab_order.unwrap_or(i32__MAX), __kain_closure_arg1.__kain_tuple_0.id.field_0))
        ()
        match tabs.iter().find(fn(__kain_closure_arg2): __kain_closure_arg2.__kain_tuple_0.layout.tab_default_active).or_else(fn(): tabs.first()).map(fn(__kain_closure_arg3): __kain_closure_arg3.__kain_tuple_1.clone()):
            Some(layout_id) =>
                resolved.insert(group_id, layout_id)
                ()
            _ => ()
    ()
    resolved

fn node_is_active_tab(tree: &UiTree, node: &UiNode, systems: &UiRuntimeSystems) -> Bool:
    let Some(group_id) = (*node).layout.tab_group_id
    let active_tabs = if (*systems).workspace_layout.active_tabs.is_empty():
        resolve_workspace_active_tabs(tree, none)
    else:
        (*systems).workspace_layout.active_tabs.clone()
    active_tabs.get(group_id).map_or(true, fn(active_layout_id): (active_layout_id == &node_layout_id(node)))

@derive(Clone, Debug, PartialEq, serde__Serialize, serde__Deserialize)
pub struct UiAnimationFrame:
    track_id: String
    target: UiNodeId
    property: String
    progress: f32
    eased_progress: f32
    completed: Bool

pub fn ui_step_animation_runtime(systems: &mut UiRuntimeSystems, delta_ms: u32) -> Array<UiAnimationFrame>:
    let mut frames = Vec__new_()
    for track in &(*systems).animation_tracks:
        let state_ = (*systems).animation_state.entry(track.id.clone()).or_default()
        if state_.completed:
            continue
        state_.elapsed_ms = state_.elapsed_ms.saturating_add(delta_ms)
        ()
        let duration = track.duration_ms.max(1)
        state_.progress = ((state_.elapsed_ms as f32 / duration as f32)).clamp(0, 1)
        ()
        state_.eased_progress = ease_progress(track.easing, state_.progress)
        ()
        state_.completed = (state_.progress >= 1)
        ()
        frames.push(UiAnimationFrame { track_id: track.id.clone(), target: track.target, property: track.property.clone(), progress: state_.progress, eased_progress: state_.eased_progress, completed: state_.completed })
        ()
    ()
    frames

fn ease_progress(easing: UiEasingKind, progress: f32) -> f32:
    match easing:
        UiEasingKind::Linear => progress
        UiEasingKind::EaseIn => (progress * progress)
        UiEasingKind::EaseOut => (1 - (((1 - progress)) * ((1 - progress))))
        UiEasingKind::EaseInOut => if (progress < 0.5): ((2 * progress) * progress) else: (1 - (((((-2) * progress) + 2)).powf(2) / 2))
        UiEasingKind::Spring =>
            let overshoot = 1.70158
            let shifted = (progress - 1)
            (1 + ((shifted * shifted) * (((((overshoot + 1)) * shifted) + overshoot))))

@derive(Clone, Debug, Default, PartialEq, serde__Serialize, serde__Deserialize)
pub struct UiHotReloadTransferReport:
    focus_transferred: Bool
    focus_nodes_transferred: usize
    focus_traversal_edges_transferred: usize
    selection_transferred: Bool
    selection_nodes_transferred: usize
    docking_transferred: Bool
    workspace_nodes_transferred: usize
    overlay_transferred: Bool
    overlay_entries_transferred: usize
    motion_policy_transferred: Bool
    animation_tracks_transferred: usize
    signal_values_transferred: usize
    session_values_transferred: usize
    identity_links: Array<UiHotReloadNodeLink>
    workspace_layout_links: Array<UiHotReloadNodeLink>
    overlay_links: Array<UiHotReloadOverlayLink>
    animation_track_links: Array<UiHotReloadNodeLink>
    signal_links: Array<UiHotReloadSignalLink>
    focus_scopes_preserved: Array<String>
    focus_scopes_dropped: Array<String>
    selection_scopes_preserved: Array<String>
    selection_scopes_dropped: Array<String>
    session_keys_preserved: Array<String>
    session_keys_dropped: Array<String>
    dropped_previous_nodes: Array<UiNodeId>
    invalidated_nodes: Array<UiNodeId>

impl Default for UiHotReloadTransferReport:
    pub fn default_() -> UiHotReloadTransferReport:
        UiHotReloadTransferReport { focus_transferred: false, focus_nodes_transferred: 0, focus_traversal_edges_transferred: 0, selection_transferred: false, selection_nodes_transferred: 0, docking_transferred: false, workspace_nodes_transferred: 0, overlay_transferred: false, overlay_entries_transferred: 0, motion_policy_transferred: false, animation_tracks_transferred: 0, signal_values_transferred: 0, session_values_transferred: 0, identity_links: Vec__new_(), workspace_layout_links: Vec__new_(), overlay_links: Vec__new_(), animation_track_links: Vec__new_(), signal_links: Vec__new_(), focus_scopes_preserved: Vec__new_(), focus_scopes_dropped: Vec__new_(), selection_scopes_preserved: Vec__new_(), selection_scopes_dropped: Vec__new_(), session_keys_preserved: Vec__new_(), session_keys_dropped: Vec__new_(), dropped_previous_nodes: Vec__new_(), invalidated_nodes: Vec__new_() }


pub fn ui_transfer_hot_reload_state(previous: &UiBuildOutput, next: &mut UiBuildOutput) -> UiHotReloadTransferReport:
    let mut report = UiHotReloadTransferReport__default_()
    let previous_reload_identity_map = node_identity_map(&(*previous).tree)
    let next_reload_identity_map = node_identity_map(&(*next).tree)
    let previous_layout_identity_map = node_layout_identity_map(&(*previous).tree)
    let next_layout_identity_map = node_layout_identity_map(&(*next).tree)
    let aliases = (*next).systems.hot_reload.identity_aliases.iter().map(fn(alias): (alias.from.clone(), alias.to.clone())).collect()
    report.identity_links = build_node_links(&previous_reload_identity_map, &next_reload_identity_map)
    ()
    report.workspace_layout_links = build_node_links(&previous_layout_identity_map, &next_layout_identity_map)
    ()
    report.dropped_previous_nodes = dropped_previous_nodes(&previous_reload_identity_map, &next_reload_identity_map)
    ()
    report.invalidated_nodes = Vec__new_()
    ()
    if (*next).systems.hot_reload.preserve_motion_policy:
        (*next).systems.motion_policy = (*previous).systems.motion_policy.clone()
        ()
        (*next).systems.motion_policy.recompute_capacitor()
        ()
        report.motion_policy_transferred = true
        ()
        ()
        ()
        ()
    if (*next).systems.hot_reload.preserve_docking:
        let snapshot = ui_workspace_layout_snapshot(&(*previous).tree, &(*previous).systems)
        let applied = ui_apply_workspace_layout_snapshot(&mut (*next).tree, &mut (*next).systems, &snapshot)
        report.docking_transferred = (((applied > 0) || snapshot.persistence_key.is_some()) || (!snapshot.active_tabs.is_empty()))
        ()
        report.workspace_nodes_transferred = applied
        ()
        ()
        ()
        ()
    if (*next).systems.hot_reload.preserve_focus:
        let previous_scopes = (*previous).systems.focus_graph.scopes.iter().cloned().collect()
        let next_scopes = (*next).systems.focus_graph.scopes.iter().cloned().collect()
        report.focus_scopes_preserved = previous_scopes.intersection(&next_scopes).cloned().collect()
        ()
        report.focus_scopes_dropped = previous_scopes.difference(&next_scopes).cloned().collect()
        ()
        match (*previous).systems.focus_graph.default_scope.clone():
            Some(default_scope) =>
                if next_scopes.contains(&default_scope):
                    (*next).systems.focus_graph.default_scope = Option::Some(default_scope)
                    ()
                    report.focus_transferred = true
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                ()
                ()
        let remapped_focus = remap_scoped_node_map(&(*previous).systems.focus_graph.focused, &next_scopes, &previous_reload_identity_map, &next_reload_identity_map, &aliases)
        report.focus_nodes_transferred = remapped_focus.len()
        ()
        (*next).systems.focus_graph.focused = remapped_focus
        ()
        let mut traversal_edges = Vec__new_()
        for edge in &(*previous).systems.focus_graph.traversal_edges:
            if (!next_scopes.contains(&edge.scope)):
                continue
            let Some(from_identity) = previous_reload_identity_map.iter().find_map(fn(__kain_closure_arg4): if ((*__kain_closure_arg4.__kain_tuple_0) == edge.from): Option::Some(__kain_closure_arg4.__kain_tuple_1.clone()) else: none)
            let Some(to_identity) = previous_reload_identity_map.iter().find_map(fn(__kain_closure_arg5): if ((*__kain_closure_arg5.__kain_tuple_0) == edge.to): Option::Some(__kain_closure_arg5.__kain_tuple_1.clone()) else: none)
            let Some(from_node) = resolve_identity_to_node(&from_identity, &next_reload_identity_map, &aliases)
            let Some(to_node) = resolve_identity_to_node(&to_identity, &next_reload_identity_map, &aliases)
            traversal_edges.push(UiFocusTraversalEdge { scope: edge.scope.clone(), kind: edge.kind, from: from_node, to: to_node })
            ()
        ()
        report.focus_traversal_edges_transferred = traversal_edges.len()
        ()
        if (!traversal_edges.is_empty()):
            (*next).systems.focus_graph.traversal_edges = traversal_edges
            ()
            report.focus_transferred = true
            ()
            ()
            ()
            ()
        ()
    if (*next).systems.hot_reload.preserve_selection:
        let previous_scopes = (*previous).systems.selection_model.scopes.iter().cloned().collect()
        let next_scopes = (*next).systems.selection_model.scopes.iter().cloned().collect()
        report.selection_scopes_preserved = previous_scopes.intersection(&next_scopes).cloned().collect()
        ()
        report.selection_scopes_dropped = previous_scopes.difference(&next_scopes).cloned().collect()
        ()
        match (*previous).systems.selection_model.active_scope.clone():
            Some(active_scope) =>
                if next_scopes.contains(&active_scope):
                    (*next).systems.selection_model.active_scope = Option::Some(active_scope)
                    ()
                    report.selection_transferred = true
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                ()
                ()
        let remapped_primary = remap_scoped_node_map(&(*previous).systems.selection_model.primary, &next_scopes, &previous_reload_identity_map, &next_reload_identity_map, &aliases)
        report.selection_nodes_transferred = (report.selection_nodes_transferred + remapped_primary.len())
        ()
        (*next).systems.selection_model.primary = remapped_primary
        ()
        let remapped_selected = remap_scoped_node_set_map(&(*previous).systems.selection_model.selected, &next_scopes, &previous_reload_identity_map, &next_reload_identity_map, &aliases)
        report.selection_nodes_transferred = (report.selection_nodes_transferred + remapped_selected.values().map(BTreeSet__len).sum())
        ()
        (*next).systems.selection_model.selected = remapped_selected
        ()
        report.selection_transferred = (report.selection_transferred || (report.selection_nodes_transferred > 0))
        ()
        ()
        ()
        ()
    if (*next).systems.hot_reload.preserve_overlays:
        let mut remapped_entries = Vec__new_()
        for overlay in &(*previous).systems.overlay_stack.entries:
            let Some(previous_node_identity) = previous_reload_identity_map.iter().find_map(fn(__kain_closure_arg6): if ((*__kain_closure_arg6.__kain_tuple_0) == overlay.node): Option::Some(__kain_closure_arg6.__kain_tuple_1.clone()) else: none)
            let Some(next_node) = resolve_identity_to_node(&previous_node_identity, &next_reload_identity_map, &aliases)
            let previous_anchor_target = overlay.anchor.map(fn(anchor): anchor.target)
            let next_anchor_target = overlay.anchor.and_then(fn(anchor): previous_reload_identity_map.iter().find_map(fn(__kain_closure_arg7): if ((*__kain_closure_arg7.__kain_tuple_0) == anchor.target): Option::Some(__kain_closure_arg7.__kain_tuple_1.clone()) else: none)).and_then(fn(identity): resolve_identity_to_node(&identity, &next_reload_identity_map, &aliases))
            let remapped_anchor = overlay.anchor.and_then(fn(anchor): next_anchor_target.map(fn(target): UiAnchorSpec { target: target, placement: anchor.placement, offset_px: anchor.offset_px, constraint: anchor.constraint }))
            if (overlay.anchor.is_some() && remapped_anchor.is_none()):
                report.invalidated_nodes.push(next_node)
                ()
                ()
                ()
                ()
            remapped_entries.push(UiOverlayEntry { id: overlay.id.clone(), node: next_node, order: overlay.order, anchor: remapped_anchor, modal: overlay.modal })
            ()
            report.overlay_links.push(UiHotReloadOverlayLink { overlay_id: overlay.id.clone(), previous_node: Option::Some(overlay.node), next_node: Option::Some(next_node), previous_anchor_target: previous_anchor_target, next_anchor_target: next_anchor_target })
            ()
        ()
        remapped_entries.sort_by(fn(a, b): ((a.order, a.id.clone())).cmp(&(b.order, b.id.clone())))
        ()
        report.overlay_entries_transferred = remapped_entries.len()
        ()
        report.overlay_transferred = (report.overlay_entries_transferred > 0)
        ()
        (*next).systems.overlay_stack.entries = remapped_entries
        ()
        ()
        ()
        ()
    if (*next).systems.hot_reload.preserve_signal_values:
        let previous_signal_keys = build_signal_key_index(previous)
        let next_signal_keys = build_signal_key_index(next)
        let mut remapped_signals = Vec__new_()
        let mut transferred_signal_ids = BTreeSet__new_()
        for selfhost_for_item in previous_signal_keys:
            let (signal_key, previous_signal) = selfhost_for_item
            let Some(next_signal) = next_signal_keys.get(&signal_key).copied()
            let Some(previous_value) = (*previous).systems.signal_values.get(&previous_signal).cloned()
            (*next).systems.signal_values.insert(next_signal, previous_value)
            ()
            remapped_signals.push(UiHotReloadSignalLink { signal_key: signal_key.clone(), previous_signal: Option::Some(previous_signal), next_signal: Option::Some(next_signal) })
            ()
            transferred_signal_ids.insert(next_signal)
            ()
        ()
        report.signal_values_transferred = remapped_signals.len()
        ()
        report.signal_links = remapped_signals
        ()
        report.invalidated_nodes.extend(transferred_signal_ids.into_iter().filter_map(fn(signal): signal_owner_node(&(*next).tree, &(*next).systems, signal)))
        ()
        ()
        ()
        ()
    if (*next).systems.hot_reload.preserve_session_state:
        let mut preserved = Vec__new_()
        let mut dropped = Vec__new_()
        for selfhost_for_item in &(*previous).systems.session_state:
            let (key, value) = selfhost_for_item
            if is_reload_transient_session_key(key):
                dropped.push(key.clone())
                ()
                continue
            (*next).systems.session_state.insert(key.clone(), value.clone())
            ()
            preserved.push(key.clone())
            ()
        ()
        report.session_values_transferred = preserved.len()
        ()
        report.session_keys_preserved = preserved
        ()
        report.session_keys_dropped = dropped
        ()
        ()
        ()
        ()
    if (*next).systems.hot_reload.preserve_animation_state:
        let next_animation_identity_map = node_reload_identity_map(&(*next).tree)
        let mut remapped_tracks = Vec__new_()
        for track in &(*next).systems.animation_tracks:
            if (!track.preserve_on_reload):
                continue
            let Some(target_identity) = next_animation_identity_map.get(&track.target)
            let previous_identity = aliases.iter().find_map(fn(__kain_closure_arg8): if (__kain_closure_arg8.__kain_tuple_1 == target_identity): Option::Some(__kain_closure_arg8.__kain_tuple_0.clone()) else: none).unwrap_or_else(fn(): target_identity.clone())
            let Some(previous_node) = previous_reload_identity_map.iter().find_map(fn(__kain_closure_arg9): if (__kain_closure_arg9.__kain_tuple_1 == &previous_identity): Option::Some((*__kain_closure_arg9.__kain_tuple_0)) else: none)
            let Some(previous_track) = (*previous).systems.animation_tracks.iter().find(fn(candidate): ((candidate.target == previous_node) && (candidate.property == track.property)))
            match (*previous).systems.animation_state.get(&previous_track.id):
                Some(state_) =>
                    (*next).systems.animation_state.insert(track.id.clone(), state_.clone())
                    ()
                    remapped_tracks.push(UiHotReloadNodeLink { stable_identity: track.id.clone(), previous_node: Option::Some(previous_node), next_node: Option::Some(track.target) })
                    ()
                    report.animation_tracks_transferred = (report.animation_tracks_transferred + 1)
                    ()
                _ => ()
        ()
        report.animation_track_links = remapped_tracks
        ()
        ()
        ()
        ()
    report.invalidated_nodes.sort()
    ()
    report.invalidated_nodes.dedup()
    ()
    report.dropped_previous_nodes.sort()
    ()
    report.dropped_previous_nodes.dedup()
    ()
    report

fn node_identity_map(tree: &UiTree) -> Map<UiNodeId, String>:
    (*tree).nodes.values().filter_map(fn(node): node.identity_key.clone().or_else(fn(): node.layout.persistent_layout_id.clone()).map(fn(identity): (node.id, identity))).collect()

fn node_reload_identity_map(tree: &UiTree) -> Map<UiNodeId, String>:
    node_identity_map(tree)

fn node_layout_identity_map(tree: &UiTree) -> Map<UiNodeId, String>:
    (*tree).nodes.values().filter_map(fn(node): node.layout.persistent_layout_id.clone().or_else(fn(): node.identity_key.clone()).map(fn(identity): (node.id, identity))).collect()

fn build_node_links(previous: &Map<UiNodeId, String>, next: &Map<UiNodeId, String>) -> Array<UiHotReloadNodeLink>:
    let mut identities = BTreeSet__new_()
    identities.extend(previous.values().cloned())
    ()
    identities.extend(next.values().cloned())
    ()
    identities.into_iter().map(fn(stable_identity): UiHotReloadNodeLink { previous_node: previous.iter().find_map(fn(__kain_closure_arg10): ((__kain_closure_arg10.__kain_tuple_1 == &stable_identity)).then_some((*__kain_closure_arg10.__kain_tuple_0))), next_node: next.iter().find_map(fn(__kain_closure_arg11): ((__kain_closure_arg11.__kain_tuple_1 == &stable_identity)).then_some((*__kain_closure_arg11.__kain_tuple_0))), stable_identity: stable_identity }).collect()

fn dropped_previous_nodes(previous: &Map<UiNodeId, String>, next: &Map<UiNodeId, String>) -> Array<UiNodeId>:
    let next_identities = next.values().cloned().collect()
    previous.iter().filter_map(fn(__kain_closure_arg12): ((!next_identities.contains(__kain_closure_arg12.__kain_tuple_1))).then_some((*__kain_closure_arg12.__kain_tuple_0))).collect()

fn resolve_identity_to_node(identity: String, next: &Map<UiNodeId, String>, aliases: &Map<String, String>) -> Option<UiNodeId>:
    let mut visited = BTreeSet__new_()
    let mut cursor = identity.to_string()
    loop:
        if (!visited.insert(cursor.clone())):
            return none
        match next.iter().find_map(fn(__kain_closure_arg13): ((__kain_closure_arg13.__kain_tuple_1 == &cursor)).then_some((*__kain_closure_arg13.__kain_tuple_0))):
            Some(node) => return Option::Some(node)
            _ =>
                ()
                ()
        let Some(next_identity) = aliases.get(&cursor).cloned()
        cursor = next_identity
        ()

fn remap_scoped_node_map(previous: &Map<String, UiNodeId>, next_scopes: &Set<String>, previous_identity_map: &Map<UiNodeId, String>, next_identity_map: &Map<UiNodeId, String>, aliases: &Map<String, String>) -> Map<String, UiNodeId>:
    let mut remapped = BTreeMap__new_()
    for selfhost_for_item in previous:
        let (scope, node) = selfhost_for_item
        if (!next_scopes.contains(scope)):
            continue
        let Some(identity) = previous_identity_map.get(node)
        let Some(next_node) = resolve_identity_to_node(identity, next_identity_map, aliases)
        remapped.insert(scope.clone(), next_node)
        ()
    ()
    remapped

fn remap_scoped_node_set_map(previous: &Map<String, Set<UiNodeId>>, next_scopes: &Set<String>, previous_identity_map: &Map<UiNodeId, String>, next_identity_map: &Map<UiNodeId, String>, aliases: &Map<String, String>) -> Map<String, Set<UiNodeId>>:
    let mut remapped = BTreeMap__new_()
    for selfhost_for_item in previous:
        let (scope, nodes) = selfhost_for_item
        if (!next_scopes.contains(scope)):
            continue
        let remapped_nodes = nodes.iter().filter_map(fn(node): previous_identity_map.get(node)).filter_map(fn(identity): resolve_identity_to_node(identity, next_identity_map, aliases)).collect()
        if (!remapped_nodes.is_empty()):
            remapped.insert(scope.clone(), remapped_nodes)
            ()
    ()
    remapped

fn build_signal_key_index(output: &UiBuildOutput) -> Map<String, UiSignalId>:
    let mut index = BTreeMap__new_()
    for selfhost_for_item in &(*output).systems.session_state:
        let (key, value) = selfhost_for_item
        let Some(raw_id) = key.strip_prefix("ui.signal.key.")
        let Ok(parsed_id) = raw_id.parse()
        let UiValue::String(signal_key) = value
        index.insert(signal_key.clone(), UiSignalId(parsed_id))
        ()
    ()
    index

fn signal_owner_node(tree: &UiTree, systems: &UiRuntimeSystems, signal: UiSignalId) -> Option<UiNodeId>:
    let signal_key = (*systems).session_state.get(&f"ui.signal.key.{signal.field_0}").and_then(fn(value): none)
    (*tree).nodes.values().find_map(fn(node): none)

fn is_reload_transient_session_key(key: String) -> Bool:
    (((key.starts_with("ui.reload.") || key.starts_with("ui.runtime.")) || key.starts_with("ui.devtools.")) || key.ends_with(".transient"))

pub fn ui_native_projection_from_output(output: &UiBuildOutput) -> UiNativeProjection:
    let mut projection = UiNativeProjection { root_id: (*output).tree.root.map(fn(id): id.field_0), ..UiNativeProjection__default_() }
    let active_tabs = if (*output).systems.workspace_layout.active_tabs.is_empty():
        resolve_workspace_active_tabs(&(*output).tree, none)
    else:
        (*output).systems.workspace_layout.active_tabs.clone()
    let Some(root_id) = (*output).tree.root
    projection.tab_groups = build_native_projection_tab_groups(&(*output).tree, &active_tabs)
    ()
    collect_native_projection_nodes(&(*output).tree, root_id, none, 0, &active_tabs, &mut projection)
    ()
    projection

fn ui_surface_for_node(node: &UiNode) -> Option<UiSurface>:
    let kind = surface_kind_for_node(node)?
    let shader_ = surface_shader_binding_for_node(node)
    let renderer_preference = surface_renderer_preference_for_node(node, shader_, &kind)
    let composition_mode = surface_composition_mode_for_node(node, shader_, &kind)
    let preferred_host_backend = surface_host_backend_for_node(node, &kind)
    let preferred_layout_engine = surface_layout_engine_for_node(node)
    let preferred_render_engine = surface_render_engine_for_node(node, shader_, &kind, renderer_preference)
    let gpu_backing_required = surface_gpu_backing_required(node, shader_, &kind, renderer_preference, composition_mode)
    Option::Some(UiSurface { id: f"surface.node.{(*node).id.field_0}", kind: kind, node: (*node).id, title: node_prop_string(node, "title"), renderer_preference: renderer_preference, composition_mode: composition_mode, preferred_host_backend: preferred_host_backend, preferred_layout_engine: preferred_layout_engine, preferred_render_engine: preferred_render_engine, gpu_backing_required: gpu_backing_required, shader_: shader_ })

fn surface_kind_for_node(node: &UiNode) -> Option<UiSurfaceKind>:
    match (*node).kind:
        UiWidgetKind::Element(tag) if is_canvas_surface_element(tag, node) => Option::Some(UiSurfaceKind__Canvas)
        UiWidgetKind::Graph => Option::Some(UiSurfaceKind__Graph)
        UiWidgetKind::Timeline => Option::Some(UiSurfaceKind__Timeline)
        UiWidgetKind::Table => Option::Some(UiSurfaceKind__Table)
        UiWidgetKind::Tree => Option::Some(UiSurfaceKind__Tree)
        UiWidgetKind::Viewport2D => Option::Some(UiSurfaceKind__Viewport2D)
        UiWidgetKind::Viewport3D => Option::Some(UiSurfaceKind__Viewport3D)
        UiWidgetKind::Overlay => Option::Some(UiSurfaceKind__Overlay)
        _ => none

fn is_canvas_surface_element(tag: String, node: &UiNode) -> Bool:
    (none || surface_shader_binding_for_node(node).is_some())

fn surface_shader_binding_for_node(node: &UiNode) -> Option<UiSurfaceShaderBinding>:
    let shader_ref = first_string_prop(node, &["shader_ref", "shader", "shader_bundle_ref", "shader_ref_key", "surface_shader"])?
    Option::Some(UiSurfaceShaderBinding { shader_ref: shader_ref, entry_point: first_string_prop(node, &["shader_entry", "shader_entry_point", "surface_shader_entry"]), stage: first_string_prop(node, &["shader_stage", "surface_shader_stage"]), derived_format: first_string_prop(node, &["shader_format", "shader_payload", "surface_shader_format"]) })

fn surface_renderer_preference_for_node(node: &UiNode, shader_: Option<&UiSurfaceShaderBinding>, kind: &UiSurfaceKind) -> UiSurfaceRendererPreference:
    match first_string_prop(node, &["renderer", "surface_renderer", "gpu_renderer", "ui_renderer"]).and_then(parse_surface_renderer_preference):
        Some(explicit_) => return explicit_
        _ =>
            ()
            ()
    if shader_.is_some():
        return UiSurfaceRendererPreference__Shader
    match kind:
        UiSurfaceKind::Canvas => UiSurfaceRendererPreference__Wgpu
        UiSurfaceKind::Viewport2D => UiSurfaceRendererPreference__Wgpu
        UiSurfaceKind::Viewport3D => UiSurfaceRendererPreference__Wgpu
        _ => UiSurfaceRendererPreference__Auto

fn surface_composition_mode_for_node(node: &UiNode, shader_: Option<&UiSurfaceShaderBinding>, kind: &UiSurfaceKind) -> UiSurfaceCompositionMode:
    match first_string_prop(node, &["composition", "surface_composition", "gpu_composition", "surface_mode"]).and_then(parse_surface_composition_mode):
        Some(explicit_) => return explicit_
        _ =>
            ()
            ()
    if shader_.is_some():
        return UiSurfaceCompositionMode__ShaderCanvas
    match kind:
        UiSurfaceKind::Canvas => UiSurfaceCompositionMode__ShaderCanvas
        UiSurfaceKind::Viewport2D => UiSurfaceCompositionMode__Viewport
        UiSurfaceKind::Viewport3D => UiSurfaceCompositionMode__Viewport
        UiSurfaceKind::Graph => UiSurfaceCompositionMode__LayeredGpu
        UiSurfaceKind::Timeline => UiSurfaceCompositionMode__LayeredGpu
        UiSurfaceKind::Overlay => UiSurfaceCompositionMode__LayeredGpu
        _ => UiSurfaceCompositionMode__Host

fn surface_host_backend_for_node(node: &UiNode, kind: &UiSurfaceKind) -> UiHostBackendKind:
    match first_string_prop(node, &["host_backend", "surface_backend", "ui_backend", "panel_backend"]).and_then(parse_surface_host_backend):
        Some(explicit_) => return explicit_
        _ =>
            ()
            ()
    match kind:
        UiSurfaceKind::Graph => UiHostBackendKind__Imgui
        UiSurfaceKind::Timeline => UiHostBackendKind__Imgui
        UiSurfaceKind::Overlay => UiHostBackendKind__Imgui
        UiSurfaceKind::Canvas => UiHostBackendKind__Qt
        UiSurfaceKind::Viewport2D => UiHostBackendKind__Qt
        UiSurfaceKind::Viewport3D => UiHostBackendKind__Qt
        _ => UiHostBackendKind__Auto

fn surface_layout_engine_for_node(node: &UiNode) -> UiLayoutEngineKind:
    first_string_prop(node, &["layout_engine", "surface_layout_engine", "ui_layout_engine"]).and_then(parse_surface_layout_engine).unwrap_or(UiLayoutEngineKind__Yoga)

fn surface_render_engine_for_node(node: &UiNode, shader_: Option<&UiSurfaceShaderBinding>, kind: &UiSurfaceKind, renderer_preference: UiSurfaceRendererPreference) -> UiRenderEngineKind:
    match first_string_prop(node, &["render_engine", "surface_render_engine", "paint_engine", "ui_render_engine"]).and_then(parse_surface_render_engine):
        Some(explicit_) => return explicit_
        _ =>
            ()
            ()
    if shader_.is_some():
        return UiRenderEngineKind__Shader
    match renderer_preference:
        UiSurfaceRendererPreference::Wgpu => UiRenderEngineKind__Wgpu
        UiSurfaceRendererPreference::Shader => UiRenderEngineKind__Shader
        UiSurfaceRendererPreference::Dom => UiRenderEngineKind__Browser
        UiSurfaceRendererPreference::Native => UiRenderEngineKind__Native
        UiSurfaceRendererPreference::Auto =>
            match kind:
                UiSurfaceKind::Graph => UiRenderEngineKind__Skia
                UiSurfaceKind::Timeline => UiRenderEngineKind__Skia
                UiSurfaceKind::Overlay => UiRenderEngineKind__Skia
                _ => UiRenderEngineKind__Auto

fn surface_gpu_backing_required(node: &UiNode, shader_: Option<&UiSurfaceShaderBinding>, kind: &UiSurfaceKind, renderer_preference: UiSurfaceRendererPreference, composition_mode: UiSurfaceCompositionMode) -> Bool:
    match first_bool_prop(node, &["gpu", "gpu_backed", "surface_gpu"]):
        Some(explicit_) => return explicit_
        _ =>
            ()
            ()
    (((shader_.is_some() || none) || none) || (!none))

fn parse_surface_renderer_preference(value: String) -> Option<UiSurfaceRendererPreference>:
    match value.trim().to_ascii_lowercase().as_str():
        "auto" => Option::Some(UiSurfaceRendererPreference__Auto)
        "native" => Option::Some(UiSurfaceRendererPreference__Native)
        "host" => Option::Some(UiSurfaceRendererPreference__Native)
        "dom" => Option::Some(UiSurfaceRendererPreference__Dom)
        "web" => Option::Some(UiSurfaceRendererPreference__Dom)
        "wgpu" => Option::Some(UiSurfaceRendererPreference__Wgpu)
        "gpu" => Option::Some(UiSurfaceRendererPreference__Wgpu)
        "shader" => Option::Some(UiSurfaceRendererPreference__Shader)
        "shader_canvas" => Option::Some(UiSurfaceRendererPreference__Shader)
        _ => none

fn parse_surface_host_backend(value: String) -> Option<UiHostBackendKind>:
    match value.trim().to_ascii_lowercase().as_str():
        "auto" => Option::Some(UiHostBackendKind__Auto)
        "native" => Option::Some(UiHostBackendKind__Native)
        "host" => Option::Some(UiHostBackendKind__Native)
        "legacy_egui" => Option::Some(UiHostBackendKind__LegacyEgui)
        "legacy-egui" => Option::Some(UiHostBackendKind__LegacyEgui)
        "egui" => Option::Some(UiHostBackendKind__LegacyEgui)
        "imgui" => Option::Some(UiHostBackendKind__Imgui)
        "rml" => Option::Some(UiHostBackendKind__RmlUi)
        "rmlui" => Option::Some(UiHostBackendKind__RmlUi)
        "slint" => Option::Some(UiHostBackendKind__Slint)
        "qt" => Option::Some(UiHostBackendKind__Qt)
        "cef" => Option::Some(UiHostBackendKind__Cef)
        "browser" => Option::Some(UiHostBackendKind__Cef)
        _ => none

fn parse_surface_layout_engine(value: String) -> Option<UiLayoutEngineKind>:
    match value.trim().to_ascii_lowercase().as_str():
        "auto" => Option::Some(UiLayoutEngineKind__Auto)
        "native" => Option::Some(UiLayoutEngineKind__Native)
        "yoga" => Option::Some(UiLayoutEngineKind__Yoga)
        "legacy_egui" => Option::Some(UiLayoutEngineKind__LegacyEgui)
        "legacy-egui" => Option::Some(UiLayoutEngineKind__LegacyEgui)
        "egui" => Option::Some(UiLayoutEngineKind__LegacyEgui)
        _ => none

fn parse_surface_render_engine(value: String) -> Option<UiRenderEngineKind>:
    match value.trim().to_ascii_lowercase().as_str():
        "auto" => Option::Some(UiRenderEngineKind__Auto)
        "native" => Option::Some(UiRenderEngineKind__Native)
        "skia" => Option::Some(UiRenderEngineKind__Skia)
        "wgpu" => Option::Some(UiRenderEngineKind__Wgpu)
        "gpu" => Option::Some(UiRenderEngineKind__Wgpu)
        "shader" => Option::Some(UiRenderEngineKind__Shader)
        "shader_canvas" => Option::Some(UiRenderEngineKind__Shader)
        "browser" => Option::Some(UiRenderEngineKind__Browser)
        "dom" => Option::Some(UiRenderEngineKind__Browser)
        "web" => Option::Some(UiRenderEngineKind__Browser)
        "legacy_egui" => Option::Some(UiRenderEngineKind__LegacyEgui)
        "legacy-egui" => Option::Some(UiRenderEngineKind__LegacyEgui)
        "egui" => Option::Some(UiRenderEngineKind__LegacyEgui)
        _ => none

fn parse_surface_composition_mode(value: String) -> Option<UiSurfaceCompositionMode>:
    match value.trim().to_ascii_lowercase().as_str():
        "host" => Option::Some(UiSurfaceCompositionMode__Host)
        "retained" => Option::Some(UiSurfaceCompositionMode__Host)
        "layered_gpu" => Option::Some(UiSurfaceCompositionMode__LayeredGpu)
        "gpu_layer" => Option::Some(UiSurfaceCompositionMode__LayeredGpu)
        "layered-gpu" => Option::Some(UiSurfaceCompositionMode__LayeredGpu)
        "viewport" => Option::Some(UiSurfaceCompositionMode__Viewport)
        "shader_canvas" => Option::Some(UiSurfaceCompositionMode__ShaderCanvas)
        "shader-canvas" => Option::Some(UiSurfaceCompositionMode__ShaderCanvas)
        "canvas" => Option::Some(UiSurfaceCompositionMode__ShaderCanvas)
        _ => none

fn collect_native_projection_nodes(tree: &UiTree, id: UiNodeId, parent_id: Option<UiNodeId>, depth: u32, active_tabs: &Map<String, String>, projection: &mut UiNativeProjection):
    let Some(node) = tree.node(id)
    let title = node_prop_string(node, "title")
    let text = node_prop_string(node, "text")
    let scene = node_prop_string(node, "scene")
    let tag = node_prop_string(node, "tag")
    let kind = UiNativeProjectionKind__from_widget_kind(&node.kind)
    let persistent_layout_id = Option::Some(node_layout_id(node))
    let tab_is_active = node.layout.tab_group_id.and_then(fn(group_id): active_tabs.get(group_id)).map_or(true, fn(active_layout_id): persistent_layout_id.is_some_and(fn(layout_id): (active_layout_id == layout_id)))
    if ((*projection).primary_panel_title.is_none() && (kind == UiNativeProjectionKind__Panel)):
        (*projection).primary_panel_title = title.clone()
        ()
        ()
        ()
        ()
    if ((*projection).primary_viewport_title.is_none() && (kind == UiNativeProjectionKind__Viewport3D)):
        (*projection).primary_viewport_title = title.clone()
        ()
        ()
        ()
        ()
    if ((*projection).primary_viewport_scene.is_none() && (kind == UiNativeProjectionKind__Viewport3D)):
        (*projection).primary_viewport_scene = scene.clone()
        ()
        ()
        ()
        ()
    (*projection).nodes.push(UiNativeProjectionNode { id: id.field_0, parent_id: parent_id.map(fn(value): value.field_0), depth: depth, kind: kind, title: title.clone(), text: text, tag: tag, scene: scene, layout_kind: node.layout.kind, dock_placement: node.layout.dock, split_ratio: node.layout.split_ratio, resizable: node.layout.resizable, persistent_layout_id: persistent_layout_id, tab_group_id: node.layout.tab_group_id.clone(), tab_label: node.layout.tab_label.clone().or_else(fn(): title.clone()), tab_order: node.layout.tab_order, tab_default_active: node.layout.tab_default_active, tab_closable: node.layout.tab_closable, tab_is_active: tab_is_active, child_count: node.children.len() })
    ()
    for child in &node.children:
        collect_native_projection_nodes(tree, (*child), Option::Some(id), (depth + 1), active_tabs, projection)
        ()

fn build_native_projection_tab_groups(tree: &UiTree, active_tabs: &Map<String, String>) -> Array<UiNativeProjectionTabGroup>:
    let mut counts = BTreeMap__new_()
    for node in (*tree).nodes.values():
        match node.layout.tab_group_id.clone():
            Some(group_id) =>
