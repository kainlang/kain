        UiRuntimeSystems { computed: Vec__new_(), resources: Vec__new_(), transactions: Vec__new_(), focus_graph: UiFocusGraph__default_(), event_routes: Vec__new_(), animation_tracks: Vec__new_(), motion_policy: UiMotionPolicy__default_(), surfaces: Vec__new_(), overlay_stack: UiOverlayStack__default_(), scheduler: UiScheduler__default_(), selection_model: UiSelectionModel__default_(), command_buffer: UiCommandBuffer__default_(), command_registry: UiCommandRegistry__default_(), theme_registry: UiThemeRegistry__default_(), workspace_layout: UiWorkspaceLayout__default_(), hot_reload: UiHotReloadPlan__default_(), signal_values: HashMap__new_(), animation_state: HashMap__new_(), session_state: HashMap__new_() }


impl UiRuntimeSystems:
    pub fn is_empty(_self: &UiRuntimeSystems) -> Bool:
        (((((((((((((((((((((((((((*_self).computed.is_empty() && (*_self).resources.is_empty()) && (*_self).transactions.is_empty()) && (*_self).focus_graph.scopes.is_empty()) && (*_self).focus_graph.default_scope.is_none()) && (*_self).focus_graph.focused.is_empty()) && (*_self).event_routes.is_empty()) && (*_self).animation_tracks.is_empty()) && ((*_self).motion_policy == UiMotionPolicy__default_())) && (*_self).surfaces.is_empty()) && (*_self).overlay_stack.entries.is_empty()) && (*_self).scheduler.pending.is_empty()) && (*_self).selection_model.scopes.is_empty()) && (*_self).selection_model.active_scope.is_none()) && (*_self).selection_model.primary.is_empty()) && (*_self).selection_model.selected.is_empty()) && (*_self).command_buffer.pending.is_empty()) && (*_self).command_buffer.executed.is_empty()) && (*_self).command_buffer.rejections.is_empty()) && (*_self).command_registry.snapshot.is_empty()) && (*_self).command_registry.commands_by_source.is_empty()) && (*_self).theme_registry.is_empty()) && (*_self).workspace_layout.is_empty()) && ((*_self).hot_reload == UiHotReloadPlan__default_())) && (*_self).signal_values.is_empty()) && (*_self).animation_state.is_empty()) && (*_self).session_state.is_empty())


impl Default for UiFocusGraph:
    fn default_() -> UiFocusGraph:
        UiFocusGraph { scopes: Vec__new_(), default_scope: none, focused: BTreeMap__new_(), traversal_edges: Vec__new_() }


