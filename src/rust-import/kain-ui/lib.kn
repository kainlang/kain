@doc(doc = " Runtime motion policy. This is intended to be stable, inspectable truth:")
@doc(doc = " motion changes are not ad-hoc booleans on random widgets.")
@derive(Clone, Debug, Default, PartialEq, serde__Serialize, serde__Deserialize)
@serde(default_)
pub struct UiMotionPolicy:
    mode: UiMotionMode
    performance_tier: UiPerformanceTier
    is_resizing: Bool
    is_pointer_active: Bool
    capacitor: UiCapacitorState

impl Default for UiMotionPolicy:
    pub fn default_() -> UiMotionPolicy:
        UiMotionPolicy { mode: UiMotionMode__default_(), performance_tier: UiPerformanceTier__default_(), is_resizing: false, is_pointer_active: false, capacitor: UiCapacitorState__default_() }


impl UiMotionPolicy:
    pub fn recompute_capacitor(_self: &mut UiMotionPolicy):
        (*_self).capacitor = none
        ()

    pub fn should_animate(_self: &UiMotionPolicy) -> Bool:
        ((((*_self).mode != UiMotionMode__Reduced) && ((*_self).performance_tier != UiPerformanceTier__Safe)) && (!(*_self).is_resizing))


