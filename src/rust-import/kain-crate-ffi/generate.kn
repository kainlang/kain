use crate::model::BindingBundle

use crate::model::BindingReport

use crate::model::BridgeFunctionBinding

use crate::model::BridgeParam

use crate::model::BridgeType

use crate::model::DependencySpec

use crate::model::GeneratedArtifacts

use crate::model::ImportCrateOutput

use crate::model::ModuleNode

use crate::model::ResolvedCrate

use heck::ToSnakeCase

use kain_core::error::KainError

use std::fs

use std::path::Path

use std::path::PathBuf

pub const BRIDGE_FORMAT_VERSION: String = "crate-ffi-v1"

pub const BRIDGE_SYMBOL_NAME: Array<u8> = [107, 97, 105, 110, 95, 114, 101, 103, 105, 115, 116, 101, 114, 95, 98, 114, 105, 100, 103, 101]

pub fn write_generated_artifacts(resolved: &ResolvedCrate, bundle: &BindingBundle, cache_dir: &std::path::Path, output_dir_override: Option<&std::path::Path>) -> Result<(GeneratedArtifacts, ImportCrateOutput), kain_core::error::KainError>:
    let generated_dir = output_dir_override.map(Path__to_path_buf).unwrap_or_else(fn(): cache_dir.to_path_buf())
    std__fs__create_dir_all(&generated_dir).map_err(kain_core__error__KainError__Io)?
    ()
    let bridge_dir = cache_dir.join("bridge")
    std__fs__create_dir_all(bridge_dir.join("src")).map_err(kain_core__error__KainError__Io)?
    ()
    let canonical_module_source = render_canonical_module_source(resolved, &(*bundle).module_root)
    let prelude_source = render_prelude_source(resolved, &(*bundle).bridge_functions)
    let bridge_source = render_bridge_source(resolved, &(*bundle).bridge_functions)
    let canonical_module_path = generated_dir.join(f"{(*resolved).import_name}.kn")
    let prelude_path = generated_dir.join(f"{(*resolved).import_name}_prelude.kn")
    let report_json_path = generated_dir.join(f"{(*resolved).import_name}_report.json")
    let report_text_path = generated_dir.join(f"{(*resolved).import_name}_report.txt")
    let bridge_manifest_path = bridge_dir.join("Cargo.toml")
    let bridge_source_path = bridge_dir.join("src").join("lib.rs")
    let mut report = BindingReport { crate_name: (*resolved).import_name.clone(), package_name: (*resolved).package_name.clone(), version: (*resolved).version.clone(), manifest_path: (*resolved).manifest_path.display().to_string(), resolution_kind: (*resolved).resolution_kind, cache_dir: cache_dir.display().to_string(), report_json_path: report_json_path.display().to_string(), report_text_path: report_text_path.display().to_string(), entries: (*bundle).report_entries.clone(), source_fingerprints: (*bundle).source_fingerprints.clone() }
    let report_text = render_report_text(&report)
    let report_json = serde_json__to_string_pretty(&report).map_err(fn(err): KainError__runtime(f"Failed to serialize crate FFI binding report for '{(*resolved).import_name}': {err}"))?
    std__fs__write(&canonical_module_path, &canonical_module_source).map_err(kain_core__error__KainError__Io)?
    ()
    std__fs__write(&prelude_path, &prelude_source).map_err(kain_core__error__KainError__Io)?
    ()
    std__fs__write(&report_json_path, report_json).map_err(kain_core__error__KainError__Io)?
    ()
    std__fs__write(&report_text_path, &report_text).map_err(kain_core__error__KainError__Io)?
    ()
    std__fs__write(&bridge_manifest_path, render_bridge_manifest(resolved, &bridge_dir)).map_err(kain_core__error__KainError__Io)?
    ()
    std__fs__write(&bridge_source_path, &bridge_source).map_err(kain_core__error__KainError__Io)?
    ()
    report.report_json_path = report_json_path.display().to_string()
    ()
    report.report_text_path = report_text_path.display().to_string()
    ()
    let artifacts = GeneratedArtifacts { canonical_module_source: canonical_module_source.clone(), prelude_source: prelude_source.clone(), bridge_source: bridge_source, report: report, report_text: report_text }
    let output = ImportCrateOutput { resolved: resolved.clone(), config_root: none, rust_ffi_config: none, cache_dir: cache_dir.to_path_buf(), canonical_module_path: canonical_module_path, prelude_path: prelude_path, report_json_path: report_json_path, report_text_path: report_text_path, bridge_manifest_path: bridge_manifest_path, bridge_source_path: bridge_source_path, dylib_path: none, canonical_module_source: canonical_module_source, prelude_source: prelude_source, cache_hit: false }
    Result::Ok((artifacts, output))

fn render_canonical_module_source(resolved: &ResolvedCrate, module_root: &ModuleNode) -> String:
    let mut output = String__new_()
    output.push_str(&f"# Generated by kain-crate-ffi for crate {(*resolved).import_name}\n# Resolution: {(*resolved).resolution_kind}\n\n")
    ()
    output.push_str("mod rust:\n")
    ()
    output.push_str("    ")
    ()
    output.push_str(&f"mod {(*resolved).import_name}:\n")
    ()
    render_module_node(module_root, 2, &mut output)
    ()
    output

fn render_module_node(node: &ModuleNode, indent: usize, output: String):
    for item in &(*node).items:
        write_docs(&item.docs, indent, output)
        ()
        for line_ in item.source.trim_end().lines():
            output.push_str(&("    ").repeat(indent))
            ()
            output.push_str(line_)
            ()
            output.push("\n")
            ()
        ()
        output.push("\n")
        ()
    ()
    for selfhost_for_item in &(*node).children:
        let (module_name, child) = selfhost_for_item
        output.push_str(&("    ").repeat(indent))
        ()
        output.push_str(&f"mod {module_name}:\n")
        ()
        render_module_node(child, (indent + 1), output)
        ()

fn write_docs(lines: &[String], indent: usize, output: String):
    for line_ in lines:
        output.push_str(&("    ").repeat(indent))
        ()
        output.push_str("# ")
        ()
        output.push_str(line_)
        ()
        output.push("\n")
        ()

fn render_prelude_source(resolved: &ResolvedCrate, functions: &[BridgeFunctionBinding]) -> String:
    let mut output = String__new_()
    output.push_str(&f"# Generated import shim for crate {(*resolved).import_name}\n")
    ()
    let mut emitted = BTreeSet__new_()
    for function in functions:
        match function.exported_aliases.get(1):
            Some(prefixed) =>
                if emitted.insert(prefixed.clone()):
                    output.push_str(&f"use rust::{(*resolved).import_name}::{prefixed} as {prefixed}\n")
                    ()
            _ => ()
    ()
    output

fn render_bridge_manifest(resolved: &ResolvedCrate, _bridge_dir: &std::path::Path) -> String:
    let dependency_block = match &(*resolved).dependency_spec:
        DependencySpec::Path { package: package, dependency_name: dependency_name, path: path } => "{dependency_name} = { package = {package}, path = {path.display().to_string()} }"
        DependencySpec::Registry { package: package, dependency_name: dependency_name, version: version, features: features, default_features: default_features } =>
            let mut rendered = "{dependency_name} = { package = {package}, version = {version}"
            if (!features.is_empty()):
                rendered.push_str(&f", features = {features}")
                ()
                ()
                ()
                ()
            if (!default_features):
                rendered.push_str(", default-features = false")
                ()
                ()
                ()
                ()
            rendered.push_str(" }")
            ()
            rendered
    let repo_root = PathBuf__from(env!("CARGO_MANIFEST_DIR")).parent().and_then(fn(value): value.parent()).map(Path__to_path_buf).unwrap_or_else(fn(): (*resolved).workspace_root.clone())
    let crate_name = bridge_crate_name(&(*resolved).import_name)
    "[package]\nname = {crate_name}\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\n\n[dependencies]\nkain-core = { path = {repo_root.join(\"crates\").join(\"kain-core\").display().to_string()} }\nkain-host = { path = {repo_root.join(\"crates\").join(\"kain-host\").display().to_string()}, default-features = false }\n{dependency_block}\n\n[profile.dev]\ndebug = 0\npanic = \"unwind\"\n\n[workspace]\nresolver = \"2\"\n"

fn render_bridge_source(_resolved: &ResolvedCrate, functions: &[BridgeFunctionBinding]) -> String:
    let mut output = String__new_()
    output.push_str("use kain_core::error::KainError;\n")
    ()
    output.push_str("use kain_core::runtime::{Env, Value};\n")
    ()
    output.push_str("use kain_host::{FromKainValue, ToKainValue};\n")
    ()
    output.push("\n")
    ()
    for function in functions:
        output.push_str(&render_bridge_wrapper(function))
        ()
        output.push("\n")
        ()
    ()
    output.push_str("fn register_all(env: &mut Env) {\n")
    ()
    for function in functions:
        let wrapper_name = wrapper_name(&function.emitted_name)
        for alias in &function.exported_aliases:
            output.push_str(&f"    env.register_native_fn({alias}, {wrapper_name});\n")
            ()
    ()
    output.push_str("}\n\n")
    ()
    output.push_str("#[no_mangle]\n")
    ()
    output.push_str("pub extern \"C\" fn kain_register_bridge(env: *mut Env) {\n")
    ()
    output.push_str("    let Some(env) = (unsafe { env.as_mut() }) else {\n")
    ()
    output.push_str("        return;\n")
    ()
    output.push_str("    };\n")
    ()
    output.push_str("    register_all(env);\n")
    ()
    output.push_str("}\n")
    ()
    output

fn render_bridge_wrapper(function: &BridgeFunctionBinding) -> String:
    let wrapper_name = wrapper_name(&(*function).emitted_name)
    let mut output = String__new_()
    output.push_str(&"fn {wrapper_name}(_env: &mut Env, args: Vec<Value>) -> Result<Value, KainError> {\n")
    ()
    output.push_str(&"    if args.len() != {(*function).params.len()} {\n")
    ()
    output.push_str(&"        return Err(KainError::runtime(format!(\"{(*function).emitted_name} expected {(*function).params.len()} argument(s), got {}\", args.len())));\n")
    ()
    output.push_str("    }\n")
    ()
    output.push_str("    let mut iter = args.into_iter();\n")
    ()
    for selfhost_for_item in (*function).params.iter().enumerate():
        let (index, param) = selfhost_for_item
        output.push_str(&render_param_conversion(index, param))
        ()
    ()
    let call_args = (*function).params.iter().map(fn(param): param.name.as_str()).collect().join(", ")
    output.push_str(&f"    let result = {(*function).rust_call_path}({call_args});\n")
    ()
    output.push_str(&render_return_conversion(&(*function).return_type))
    ()
    output.push_str("}\n")
    ()
    output

fn render_param_conversion(_index: usize, param: &BridgeParam) -> String:
    match &(*param).ty:
        BridgeType::StringRef => f"    let __{(*param).name}_owned = <String as FromKainValue>::from_kain_value(iter.next().expect(\"checked arg count\"))?;\n    let {(*param).name} = __{(*param).name}_owned.as_str();\n"
        _ =>
            let ty = (*param).ty.from_kain_trait_type().unwrap_or_else(fn(): (*param).ty.render_rust())
            f"    let {(*param).name} = <{ty} as FromKainValue>::from_kain_value(iter.next().expect(\"checked arg count\"))?;\n"

fn render_return_conversion(ty: &BridgeType) -> String:
    match ty:
        BridgeType::Unit => ("    Ok(ToKainValue::to_kain_value(result))\n").to_string()
        BridgeType::Bool(_) => ("    Ok(ToKainValue::to_kain_value(result))\n").to_string()
        BridgeType::Int(_) => ("    Ok(ToKainValue::to_kain_value(result))\n").to_string()
        BridgeType::Float(_) => ("    Ok(ToKainValue::to_kain_value(result))\n").to_string()
        BridgeType::StringOwned => ("    Ok(ToKainValue::to_kain_value(result))\n").to_string()
        BridgeType::StringRef => ("    Ok(ToKainValue::to_kain_value(result))\n").to_string()
        BridgeType::Option(_) => ("    Ok(ToKainValue::to_kain_value(result))\n").to_string()
        BridgeType::Array(_) => ("    Ok(ToKainValue::to_kain_value(result))\n").to_string()

fn render_report_text(report: &BindingReport) -> String:
    let mut output = String__new_()
    output.push_str(&f"crate: {(*report).crate_name}\npackage: {(*report).package_name}\nversion: {(*report).version}\nresolution: {(*report).resolution_kind}\nmanifest: {(*report).manifest_path}\ncache_dir: {(*report).cache_dir}\n\n")
    ()
    output.push_str("entries:\n")
    ()
    for entry in &(*report).entries:
        output.push_str(&f"- [{none}] {entry.kind} {entry.symbol_path}\n")
        ()
        match &entry.reason:
            Some(reason) =>
                output.push_str(&f"  reason: {reason}\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &entry.emitted_symbol:
            Some(emitted_symbol) =>
                output.push_str(&f"  emitted: {emitted_symbol}\n")
                ()
            _ => ()
    ()
    output.push_str("\nsource_fingerprints:\n")
    ()
    for fingerprint in &(*report).source_fingerprints:
        output.push_str(&f"- {fingerprint.sha256} {fingerprint.path}\n")
        ()
    ()
    output

fn wrapper_name(emitted_name: String) -> String:
    f"__kain_bridge_{emitted_name.to_snake_case()}"

pub fn bridge_crate_name(crate_name: String) -> String:
    f"kain_crate_ffi_bridge_{crate_name.to_snake_case()}"

