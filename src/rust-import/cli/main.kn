@derive(Debug, Default, serde__Deserialize)
struct NativeRuntimeManifest:
    name: Option<String>
    sources: Array<std::path::PathBuf>
    windows_sources: Array<std::path::PathBuf>
    linux_sources: Array<std::path::PathBuf>
    macos_sources: Array<std::path::PathBuf>
    include_dirs: Array<std::path::PathBuf>
    defines: Array<String>
    windows_defines: Array<String>
    linux_defines: Array<String>
    macos_defines: Array<String>
    link: NativeRuntimeLinkManifest

impl Default for NativeRuntimeManifest:
    pub fn default_() -> NativeRuntimeManifest:
        NativeRuntimeManifest { name: none, sources: Vec__new_(), windows_sources: Vec__new_(), linux_sources: Vec__new_(), macos_sources: Vec__new_(), include_dirs: Vec__new_(), defines: Vec__new_(), windows_defines: Vec__new_(), linux_defines: Vec__new_(), macos_defines: Vec__new_(), link: NativeRuntimeLinkManifest__default_() }


@derive(Debug, Default, serde__Deserialize)
struct NativeRuntimeLinkManifest:
    windows: Array<String>
    linux: Array<String>
    macos: Array<String>

impl Default for NativeRuntimeLinkManifest:
    pub fn default_() -> NativeRuntimeLinkManifest:
        NativeRuntimeLinkManifest { windows: Vec__new_(), linux: Vec__new_(), macos: Vec__new_() }


@derive(Debug)
struct ResolvedNativeRuntimeBundle:
    name: String
    sources: Array<std::path::PathBuf>
    include_dirs: Array<std::path::PathBuf>
    defines: Array<String>
    link_libs: Array<String>
    uses_cpp_runtime: Bool

@derive(clap__Parser, Debug)
@command(name = "kain")
@command(author = "Kipp")
@command(version = cli__VERSION)
@command(about = "The Ultimate Programming Language Compiler", long_about = none)
struct Args:
    command: Option<Commands>
    input: Option<std::path::PathBuf>
    code: Option<String>
    output: Option<std::path::PathBuf>
    target: String
    run: Bool
    watch: Bool
    emit_ast: Bool
    emit_typed: Bool
    verbose: Bool
    plugin: Option<String>
    plugins_dir: Option<std::path::PathBuf>
    dry_run: Bool
    strict: Bool
    analyze: Bool

enum BuildCommand:
    NativeUi { input: std::path::PathBuf, root_component: Option<String>, app_name: Option<String>, window_title: Option<String>, project_dir: Option<std::path::PathBuf>, artifact_dir: Option<std::path::PathBuf>, bundle_only: Bool, release: Bool, runtime_crate: String, runtime_path: Option<std::path::PathBuf>, runtime_version: Option<String> }

enum Commands:
    Init { path: std::path::PathBuf, name: Option<String> }
    Lsp
    Doctor { repair: cli::repair::DoctorRepairArgs }
    Selfhost { command: cli::selfhost::SelfHostCommand }
    Omni { command: cli::omni::OmniCommand }
    Fabric { command: cli::fabric::FabricCommand }
    Build { command: Option<BuildCommand>, input: Option<std::path::PathBuf>, output: Option<std::path::PathBuf>, target: Option<String>, targets: Option<Array<String>>, ue5: Bool, r_rust: Bool, embed: Bool }
    Run { input: std::path::PathBuf }
    GpuArtifacts { input: std::path::PathBuf, output: Option<std::path::PathBuf> }
    Inject { inputs: Array<std::path::PathBuf>, plugin_dir: Option<std::path::PathBuf>, plugin: Option<String>, force: Bool, dry_run: Bool, ue5: Bool }
    ImportAsm { input: std::path::PathBuf, format: String, out_: Option<std::path::PathBuf>, validate_only: Bool }
    ImportC { input: std::path::PathBuf, output: Option<std::path::PathBuf>, target: Option<String>, include_paths: Array<String>, defines: Array<String>, flat: Bool, include_filters: Array<String>, exclude_filters: Array<String>, fail_fast: Bool, report_json: Option<std::path::PathBuf> }
    ImportRust { input: std::path::PathBuf, output: Option<std::path::PathBuf>, target: Option<String>, flat: Bool, include_filters: Array<String>, exclude_filters: Array<String>, fail_fast: Bool, report_json: Option<std::path::PathBuf> }
    ImportCrate { crate_name: String, manifest_path: Option<std::path::PathBuf>, crate_path: Option<std::path::PathBuf>, mode: String, output: Option<std::path::PathBuf>, report_json: Option<std::path::PathBuf>, features: Array<String>, all_features: Bool, no_default_features: Bool }
    ImportTs { input: std::path::PathBuf, output: Option<std::path::PathBuf>, target: Option<String>, flat: Bool, include_filters: Array<String>, exclude_filters: Array<String>, fail_fast: Bool, report_json: Option<std::path::PathBuf> }

fn normalize_script_source(source: String) -> String:
    let source = source.trim_start_matches("\u{feff}").to_string()
    match source.strip_prefix("#!"):
        Some(rest) =>
            match rest.find("\n"):
                Some(newline_index) => rest[((newline_index + 1))..].to_string()
                _ => String__new_()
        _ => source

fn read_source_from_path(input: &std::path::Path) -> Result<String, String>:
    let source = if (input == Path__new_("-")):
        let mut buffer = String__new_()
        std__io__stdin().read_to_string(&mut buffer).map_err(fn(err): f"Failed to read stdin: {err}")?
        ()
        buffer
    else:
        std__fs__read_to_string(input).map_err(fn(err): f"Failed to read {input.display()}: {err}")?
    Result::Ok(normalize_script_source(source))

fn run_source(source_name: String, source_path: Option<&std::path::Path>, source: String, target: cli::CompileTarget, output: Option<&std::path::PathBuf>, _emit_ast: Bool, _emit_typed: Bool, verbose: Bool, _analyze: Bool, plugin_name: Option<String>) -> Bool:
    if verbose:
        println(f" Compiling: {source_name}")
        println(f" Source: {source.len()} bytes, {source.lines().count()} lines")
        ()
        ()
    if (target == cli__CompileTarget__Spirv):
        let output_path = match output.cloned().or_else(fn(): source_path.map(fn(path): path.with_extension(cli__target_extension(target)))):
            Some(path) => path
            None =>
                eprintln(" Output path is required when compiling inline or stdin source.")
                return false
        match cli__compile_spirv_binary(&source):
            Ok(spv_bytes) =>
                if (!ensure_parent_dir(&output_path)):
                    return false
                match std__fs__write(&output_path, &spv_bytes):
                    Err(e) =>
                        eprintln(f" Failed to write output: {e}")
                        return false
                    _ =>
                        ()
                        ()
                println(f" Compiled to: {output_path.display()} ({spv_bytes.len()} bytes)")
                return true
            Err(e) =>
                eprintln(f" Compile error: {e}")
                return false
        ()
    match cli__compile_(&source, target):
        Ok(compiled_output) =>
            if ((target == cli__CompileTarget__Interpret) || (target == cli__CompileTarget__Test)):
                let trimmed_output = compiled_output.trim()
                if ((!trimmed_output.is_empty()) && (trimmed_output != "()")):
                    println(compiled_output)
                    ()
                    ()
                println(" Execution complete")
                ()
                ()
            else:
                let default_ext = cli__target_extension(target)
                let output_path = if (target == cli__CompileTarget__Llvm):
                    match output:
                        Some(out_) =>
                            if out_.extension().map_or(false, fn(e): (e == "ll")):
                                out_.clone()
                            else:
                                let mut p = out_.clone()
                                p.set_extension("ll")
                                ()
                                p
                        _ =>
                            match source_path:
                                Some(path) => path.with_extension("ll")
                                _ =>
                                    eprintln(" Output path is required when compiling inline or stdin source.")
                                    return false
                elif (target == cli__CompileTarget__Usf):
                    match output:
                        Some(out_) =>
                            let mut p = out_.clone()
                            p.set_extension("usf")
                            ()
                            p
                        _ =>
                            match source_path:
                                Some(path) => path.with_extension("usf")
                                _ =>
                                    eprintln(" Output path is required when compiling inline or stdin source.")
                                    return false
                else:
                    match output.cloned().or_else(fn(): source_path.map(fn(path): path.with_extension(default_ext))):
                        Some(path) => path
                        None =>
                            eprintln(" Output path is required when compiling inline or stdin source.")
                            return false
                if (!ensure_parent_dir(&output_path)):
                    return false
                match std__fs__write(&output_path, &compiled_output):
                    Err(e) =>
                        eprintln(f" Failed to write output: {e}")
                        return false
                    _ =>
                        ()
                        ()
                println(f" Compiled to: {output_path.display()} ({compiled_output.len()} bytes)")
                if (target == cli__CompileTarget__Llvm):
                    match cli__llvm_native_stage__stage_llvm_native_artifacts(&source, &output_path, none):
                        Ok(staged) =>
                            println(f" Runtime contract: {staged.runtime_contract_path.display()}")
                            println(f" Realtime bundle: {staged.realtime_app_path.display()}")
                            match staged.compute_residency_path:
                                Some(compute_residency_path) =>
                                    println(f" Compute residency: {compute_residency_path.display()}")
                                    ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            match staged.shader_bundle_path:
                                Some(shader_bundle_path) =>
                                    println(f" Shader bundle: {shader_bundle_path.display()}")
                                    ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            ()
                        Err(err) =>
                            eprintln(f" Failed to stage LLVM native artifacts: {err}")
                            return false
                    ()
                if (target == cli__CompileTarget__Usf):
                    let shader_name = none
                    match cli__generate_usf_header(&source, &shader_name):
                        Ok(header_code) =>
                            let header_path = output_path.with_extension("h")
                            let header_path = output_path.with_extension("h")
                            if (!ensure_parent_dir(&header_path)):
                                eprintln(" Warning: Failed to create directory for header")
                                ()
                                ()
                            else:
                                match std__fs__write(&header_path, header_code.as_bytes()):
                                    Err(e) =>
                                        eprintln(f" Warning: Failed to write header: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f" Generated header: {header_path.display()}")
                                        ()
                                        ()
                                ()
                            ()
                        Err(e) =>
                            eprintln(f" Warning: Failed to generate header: {e}")
                            ()
                            ()
                    let plugin_name_str = plugin_name.unwrap_or("YourPlugin")
                    match cli__generate_usf_implementation(&source, &shader_name, plugin_name_str):
                        Ok(cpp_code) =>
                            let cpp_path = output_path.with_extension("cpp")
                            let cpp_path = output_path.with_extension("cpp")
                            if (!ensure_parent_dir(&cpp_path)):
                                eprintln(" Warning: Failed to create directory for implementation")
                                ()
                                ()
                            else:
                                match std__fs__write(&cpp_path, cpp_code.as_bytes()):
                                    Err(e) =>
                                        eprintln(f" Warning: Failed to write implementation: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f" Generated implementation: {cpp_path.display()}")
                                        ()
                                        ()
                                ()
                            ()
                        Err(e) =>
                            eprintln(f" Warning: Failed to generate implementation: {e}")
                            ()
                            ()
                    ()
                if (target == cli__CompileTarget__Ue5):
                    let output_name = output_path.file_stem().and_then(fn(s): s.to_str())
                    match cli__compile_ue5(&source, output_name, none):
                        Ok(ue5_output) =>
                            let header_path = output_path.with_extension("h")
                            let header_path = output_path.with_extension("h")
                            if (!ensure_parent_dir(&header_path)):
                                eprintln(" Warning: Failed to create directory for header")
                                ()
                                ()
                            else:
                                match std__fs__write(&header_path, ue5_output.header.as_bytes()):
                                    Err(e) =>
                                        eprintln(f" Warning: Failed to write header: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f" Generated header: {header_path.display()} ({ue5_output.header.len()} bytes)")
                                        ()
                                        ()
                                ()
                            let source_path = output_path.with_extension("cpp")
                            let source_path = output_path.with_extension("cpp")
                            if (!ensure_parent_dir(&source_path)):
                                eprintln(" Warning: Failed to create directory for source")
                                ()
                                ()
                            else:
                                match std__fs__write(&source_path, ue5_output.source.as_bytes()):
                                    Err(e) =>
                                        eprintln(f" Warning: Failed to write source: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f" Generated source: {source_path.display()} ({ue5_output.source.len()} bytes)")
                                        ()
                                        ()
                                ()
                            if (!ue5_output.shader_files.is_empty()):
                                println(f" Generated {ue5_output.shader_files.len()} shader files:")
                                for selfhost_for_item in &ue5_output.shader_files:
                                    let (filename, content) = selfhost_for_item
                                    let shader_path = output_path.with_file_name(filename)
                                    let shader_path = output_path.with_file_name(filename)
                                    if (!ensure_parent_dir(&shader_path)):
                                        eprintln(f"   Warning: Failed to create directory for {filename}")
                                    else:
                                        match std__fs__write(&shader_path, content.as_bytes()):
                                            Err(e) => eprintln(f"   Warning: Failed to write {filename}: {e}")
                                            _ => println(f"   - {shader_path.display()} ({content.len()} bytes)")
                                ()
                                ()
                            ()
                        Err(e) =>
                            eprintln(f" Warning: Failed to generate split UE5 files: {e}")
                            ()
                            ()
                    ()
                if (target == cli__CompileTarget__Ue5Editor):
                    match cli__compile_ue5editor(&source, "EditorTools", none):
                        Ok(editor_output) =>
                            let header_path = output_path.with_extension("h")
                            let header_path = output_path.with_extension("h")
                            if (!ensure_parent_dir(&header_path)):
                                eprintln(" Warning: Failed to create directory for header")
                                ()
                                ()
                            else:
                                match std__fs__write(&header_path, editor_output.header.as_bytes()):
                                    Err(e) =>
                                        eprintln(f" Warning: Failed to write header: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f" Generated header: {header_path.display()} ({editor_output.header.len()} bytes)")
                                        ()
                                        ()
                                ()
                            let source_path = output_path.with_extension("cpp")
                            let source_path = output_path.with_extension("cpp")
                            if (!ensure_parent_dir(&source_path)):
                                eprintln(" Warning: Failed to create directory for source")
                                ()
                                ()
                            else:
                                match std__fs__write(&source_path, editor_output.source.as_bytes()):
                                    Err(e) =>
                                        eprintln(f" Warning: Failed to write source: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f" Generated source: {source_path.display()} ({editor_output.source.len()} bytes)")
                                        ()
                                        ()
                                ()
                            ()
                        Err(e) =>
                            eprintln(f" Warning: Failed to generate UE5 Editor files: {e}")
                            ()
                            ()
                    ()
                if (target == cli__CompileTarget__Llvm):
                    let exe_path = match output:
                        Some(out_) => if out_.extension().map_or(false, fn(e): (e == "ll")): if cfg!(windows): out_.with_extension("exe") else: out_.with_extension("") else: out_.clone()
                        _ =>
                            let Some(path) = source_path
                            if cfg!(windows):
                                path.with_extension("exe")
                            else:
                                path.with_extension("")
                    println(" Linking executable...")
                    let clang_cmd = find_bundled_clang().or_else(fn(): if Command__new_("clang").arg("--version").output().is_ok(): Option::Some(("clang").to_string()) else: none).or_else(fn(): none).unwrap_or_else(fn(): ("clang").to_string())
                    let mut cmd = Command__new_(&clang_cmd)
                    let mut runtime_link_libs = Vec__new_()
                    let cffi_link_inputs = match resolve_c_ffi_shared_libraries_for_linking(&source):
                        Ok(paths) => paths
                        Err(err) =>
                            eprintln(f" Failed to resolve C FFI link inputs: {err}")
                            return false
                    match (none):
                        Some(runtime_bundle) =>
                            let runtime_objects = match compile_native_runtime_bundle(&runtime_bundle, &clang_cmd, &exe_path):
                                Ok(objects) => objects
                                Err(err) =>
                                    eprintln(f" Failed to compile runtime library: {err}")
                                    return false
                            for object in runtime_objects:
                                cmd.arg(object)
                                ()
                            ()
                            runtime_link_libs = runtime_bundle.link_libs
                            ()
                            if runtime_bundle.uses_cpp_runtime:
                                runtime_link_libs = unique_link_libs(([runtime_link_libs, default_native_runtime_cpp_link_libs()]).concat())
                                ()
                                ()
                                ()
                                ()
                            ()
                        _ =>
                            ()
                            ()
                    cmd.arg(&output_path).arg("-o").arg(&exe_path).arg("-Wno-override-module").arg("-g")
                    ()
                    for shared_library in cffi_link_inputs:
                        cmd.arg(shared_library)
                        ()
                    ()
                    runtime_link_libs = unique_link_libs(([runtime_link_libs, default_native_runtime_link_libs()]).concat())
                    ()
                    for link_lib in runtime_link_libs:
                        cmd.arg(f"-l{link_lib}")
                        ()
                    ()
                    let status = cmd.status()
                    match status:
                        Ok(s) if s.success() =>
                            println(f" Generated executable: {exe_path.display()}")
                            match cli__llvm_native_stage__stage_gpu_runtime_dll(&exe_path):
                                Ok(Some(dll_path)) =>
                                    println(f" Compute runtime DLL: {dll_path.display()}")
                                    ()
                                    ()
                                Ok(None) => ()
                                Err(err) =>
                                    eprintln(f" Failed to stage compute runtime DLL: {err}")
                                    return false
                            ()
                        Ok(_) =>
                            eprintln(" Linking failed.")
                            return false
                        Err(_) =>
                            eprintln(" 'clang' not found in PATH or standard locations.")
                            eprintln("   To generate an executable, install LLVM and run:")
                            eprintln(f"   clang {output_path.display()} -o {exe_path.display()}")
                            return false
                    ()
                ()
            true
        Err(e) =>
            let diag = Diagnostics__new_(&source, source_name)
            eprint(diag.format_error(&e))
            false

fn run_compile(input: &std::path::PathBuf, target: cli::CompileTarget, output: Option<&std::path::PathBuf>, emit_ast: Bool, emit_typed: Bool, verbose: Bool, analyze: Bool, plugin_name: Option<String>) -> Bool:
    let source = match read_source_from_path(input):
        Ok(value) => value
        Err(err) =>
            eprintln(f" {err}")
            return false
    let source_name = if (input == Path__new_("-")):
        "<stdin>"
    else:
        input.to_str().unwrap_or("<input>")
    let source_path = if (input == Path__new_("-")):
        none
    else:
        Option::Some(input.as_path())
    run_source(source_name, source_path, &source, target, output, emit_ast, emit_typed, verbose, analyze, plugin_name)

fn run_kn_repl() -> Bool:
    println(f"Kain {cli__VERSION} (build {cli__BUILD_NUMBER}) [{cli__BUILD_TARGET_TRIPLE}]")
    let stdin = std__io__stdin()
    let mut stdin = stdin.lock()
    let mut stdout = std__io__stdout()
    let mut buffer = String__new_()
    let mut line_ = String__new_()
    loop:
        let prompt = if buffer.trim().is_empty():
            ">>> "
        else:
            "... "
        if __kain_write_fmt!(stdout, prompt).and_then(fn(_): stdout.flush()).is_err():
            eprintln(" Failed to write REPL prompt.")
            return false
        line_.clear()
        ()
        let bytes_read = match stdin.read_line(&mut line_):
            Ok(value) => value
            Err(err) =>
                eprintln(f" Failed to read REPL input: {err}")
                return false
        if (bytes_read == 0):
            if buffer.trim().is_empty():
                println()
                return true
            let source = normalize_script_source(std__mem__take(&mut buffer))
            if (!run_source("<repl>", none, &source, cli__CompileTarget__Interpret, none, false, false, false, false, none)):
                return false
            println()
            return true
        let trimmed = line_.trim_end_matches(["\r", "\n"])
        match trimmed:
            ".quit" =>
                println()
                return true
            ".exit" =>
                println()
                return true
            ".clear" =>
                buffer.clear()
                ()
                continue
            ".run" =>
                if buffer.trim().is_empty():
                    continue
                let source = normalize_script_source(std__mem__take(&mut buffer))
                if (!run_source("<repl>", none, &source, cli__CompileTarget__Interpret, none, false, false, false, false, none)):
                    return false
                continue
            _ => ()
        if trimmed.is_empty():
            if buffer.trim().is_empty():
                continue
            let source = normalize_script_source(std__mem__take(&mut buffer))
            if (!run_source("<repl>", none, &source, cli__CompileTarget__Interpret, none, false, false, false, false, none)):
                return false
            continue
        buffer.push_str(&line_)
        ()

fn parse_artifact_mode(value: String) -> Result<kain_crate_ffi::ArtifactMode, String>:
    match value.trim().to_ascii_lowercase().as_str():
        "live" => Result::Ok(kain_crate_ffi__ArtifactMode__Live)
        "generate" => Result::Ok(kain_crate_ffi__ArtifactMode__Generate)
        "gen" => Result::Ok(kain_crate_ffi__ArtifactMode__Generate)
        "both" => Result::Ok(kain_crate_ffi__ArtifactMode__Both)
        other => Result::Err(f"Unknown crate FFI mode '{other}'. Use one of: live, generate, both")

fn watch_mode(input: std::path::PathBuf, target: cli::CompileTarget, output: Option<std::path::PathBuf>, emit_ast: Bool, emit_typed: Bool, verbose: Bool, analyze: Bool, plugin_name: Option<String>):
    use notify::Event

    use notify::RecursiveMode

    use notify::Watcher

    use std::sync::mpsc::channel

    let running = Arc__new_(AtomicBool__new_(true))
    let r = running.clone()
    ctrlc__set_handler(fn(): none).expect("Error setting Ctrl-C handler")
    ()
    println(f" Watching {input.display()} for changes... (Ctrl+C to stop)")
    println("")
    run_compile(&input, target, none, emit_ast, emit_typed, verbose, analyze, plugin_name)
    ()
    println("")
    let (tx, rx) = std__sync__mpsc__channel()
    let mut watcher = notify__recommended_watcher(fn(res: Result<notify::Event, notify::Error>): none).expect("Failed to create watcher")
    watcher.watch(&input, notify__RecursiveMode__NonRecursive).expect("Failed to watch file")
    ()
    match input.parent():
        Some(parent) =>
            let _ = watcher.watch(parent, notify__RecursiveMode__NonRecursive)
            ()
        _ =>
            ()
            ()
    while running.load(std__sync__atomic__Ordering__SeqCst):
        match rx.recv_timeout(Duration__from_millis(100)):
            Ok(_) =>
                std__thread__sleep(Duration__from_millis(50))
                ()
                while rx.try_recv().is_ok():
                    let __selfhost_empty = none
                ()
                println(" File changed, recompiling...")
                println("")
                run_compile(&input, target, none, emit_ast, emit_typed, verbose, analyze, plugin_name)
                ()
                println("")
            Err(sync__mpsc__RecvTimeoutError::Timeout) => ()
            Err(sync__mpsc__RecvTimeoutError::Disconnected) => break

fn main():
    let builder = Builder__new_().name(("main-thread").into()).stack_size(((8 * 1024) * 1024))
    let handler = builder.spawn_(fn(): none).unwrap()
    handler.join().unwrap()
    ()

fn print_repair_report(path: &std::path::Path, report: &kain_repair::RepairReport, mode: kain_repair::RepairMode, profile: String):
    println(f" Repair Target: {path.display()}")
    println(f" Selected Profile: {profile}")
    println(f" Repair Mode: {mode}")
    println(f" Safety Class: {(*report).safety_class}")
    println(f" Unknown Risk: {(*report).remaining_unknown_risk}")
    println(f" Parser Proof: {none}")
    if (*report).fixes.is_empty():
        println(" Fixes Applied: none needed")
        println(" Remaining Diagnostics: 0")
        return
    println(f" Fixes Applied: {(*report).fixes_applied}")
    println(" Fixes:")
    for fix in &(*report).fixes:
        let is_aggressive = is_aggressive_fix(fix)
        let note = fix.note.unwrap_or("repair applied")
        println("   - [{if is_aggressive: \"aggressive\" else: \"safe\"}] {fix.kind}: {note}")
    ()
    println(" Remaining Diagnostics: 0")

fn print_repair_tree_report(root: &std::path::Path, report: &cli::repair::DoctorRepairBatchReport, mode: kain_repair::RepairMode, profile: String):
    println(f" Repair Root: {root.display()}")
    println(f" Selected Profile: {profile}")
    println(f" Repair Mode: {mode}")
    println(" Action Class: {if none: \"aggressive\" else: \"safe\"}")
    println(f" Files Scanned: {(*report).scanned}")
    println(f" Files Changed: {(*report).changed}")
    println(f" Files Written: {(*report).written}")
    println(f" Files Failed: {(*report).failed}")
    for outcome in &(*report).outcomes:
        match &outcome.result:
            Ok(file_report) => println("   - {outcome.path.display()} [{if file_report.changed(): \"changed\" else: \"unchanged\"}] {if file_report.fixes.is_empty(): \"no fixes\" else: \"repairs applied\"}")
            Err(err) => println(f"   - {outcome.path.display()} [failed] {err}")

fn is_aggressive_fix(fix: &kain_repair::AppliedFix) -> Bool:
    match (*fix).kind:
        kain_repair__FixKind::RewriteReservedIdentifier => true
        kain_repair__FixKind::NormalizeSelfConstructorSyntax => true
        kain_repair__FixKind::RewriteInlineInitialization => true
        kain_repair__FixKind::NormalizeNamespacePath => true
        kain_repair__FixKind::ReconstructParserSafeBlock => true
        _ => false

fn print_doctor(active_launcher: cli::LauncherKind):
    let current_exe = std__env__current_exe().ok()
    let kain_path_command = which__which("kain").ok()
    let kn_path_command = which__which("kn").ok()
    let kain_path_matches = collect_path_matches("kain")
    let kn_path_matches = collect_path_matches("kn")
    let stdlib_roots = kain_core__stdlib__find_stdlib_search_roots()
    let runtime_c = find_runtime_c()
    let runtime_manifest = find_native_runtime_manifest()
    let resolved_clang = if cfg!(feature = "sys"):
        find_bundled_clang()
    else:
        none
    println(" KAIN Doctor")
    println(f" Version: {cli__VERSION}")
    println(f" Build: {cli__BUILD_NUMBER}")
    println(f" Built At (UTC): {format_build_time(cli__BUILD_UNIX_TIME)}")
    println(f" Git: {cli__BUILD_GIT_SHA} (commit #{cli__BUILD_GIT_COMMIT_COUNT}, {cli__BUILD_GIT_DIRTY})")
    println(f" Profile: {cli__BUILD_PROFILE}")
    println(f" Target Triple: {cli__BUILD_TARGET_TRIPLE} (host {cli__BUILD_HOST_TRIPLE})")
    match &current_exe:
        Some(path) =>
            println(f" Binary Path: {path.display()}")
            println(f" Binary Kind: {classify_binary_path(path)}")
            ()
            ()
        None =>
            println(" Binary Path: <unknown>")
            ()
    println(f" Active Launcher: {active_launcher.display_name()}")
    match &kain_path_command:
        Some(path) =>
            println(f" PATH kain: {path.display()}")
            ()
        None =>
            println(" PATH kain: <not found>")
            ()
    match &kn_path_command:
        Some(path) =>
            println(f" PATH kn: {path.display()}")
            ()
        None =>
            println(" PATH kn: <not found>")
            ()
    if (!kain_path_matches.is_empty()):
        println(" PATH Matches (kain):")
        for path in &kain_path_matches:
            println(f"   - {path.display()}")
        ()
        ()
    if (!kn_path_matches.is_empty()):
        println(" PATH Matches (kn):")
        for path in &kn_path_matches:
            println(f"   - {path.display()}")
        ()
        ()
    match std__env__current_dir():
        Ok(cwd) =>
            println(f" Current Dir: {cwd.display()}")
            match find_project_root(&cwd):
                Some(root) =>
                    println(f" Project Root: {root.display()}")
                    ()
                    ()
                _ =>
                    println(" Project Root: <not found (no KAIN.toml in parent chain)>")
                    ()
                    ()
            ()
        Err(err) =>
            println(f" Current Dir: <unknown> ({err})")
            ()
    println(f" Supported Targets: {cli__supported_targets_csv()}")
    println(" TS Target Available: {if cli__parse_compile_target(\"ts\").is_some(): \"yes\" else: \"no\"}")
    println(" Features: ue5={if cfg!(feature = \"ue5\"): \"on\" else: \"off\"}, web={if cfg!(feature = \"web\"): \"on\" else: \"off\"}, gpu={if cfg!(feature = \"gpu\"): \"on\" else: \"off\"}, sys={if cfg!(feature = \"sys\"): \"on\" else: \"off\"}")
    println(" PATH Match Status (kain): {doctor_path_status(current_exe, kain_path_command, \"kain\")}")
    println(" PATH Match Status (kn): {doctor_path_status(current_exe, kn_path_command, \"kn\")}")
    if stdlib_roots.is_empty():
        println(" Resolved Stdlib Roots: <none>")
        ()
        ()
    else:
        println(" Resolved Stdlib Roots:")
        for root in &stdlib_roots:
            println(f"   - {root.display()}")
        ()
        ()
    match runtime_c:
        Some(path) =>
            println(f" Resolved Runtime C: {path.display()}")
            ()
        None =>
            println(" Resolved Runtime C: <not found>")
            ()
    match runtime_manifest:
        Some(path) =>
            println(f" Resolved Runtime Manifest: {path.display()}")
            ()
        None =>
            println(" Resolved Runtime Manifest: <not found>")
            ()
    if cfg!(feature = "sys"):
        match resolved_clang:
            Some(path) =>
                println(f" Resolved LLVM Clang: {path}")
                ()
            None =>
                println(" Resolved LLVM Clang: <not found in bundled locations>")
                ()
        ()
    match current_exe:
        Some(path) =>
            if is_repo_target_binary(path):
                println(" Warning: active kain comes from a repo target directory.")
                if cfg!(windows):
                    println("          Refresh/install a stable PATH binary with scripts/windows/sync-kain-source-of-truth.ps1.")
                else:
                    println("          Refresh/install a stable PATH binary with python3 install_kain.py and source generated/kain-env.sh.")
        _ => ()

fn format_build_time(unix_time: String) -> String:
    let Ok(secs) = unix_time.parse()
    let Some(dt) = DateTime__from_timestamp(secs, 0)
    f"{dt.to_rfc3339()} (unix {unix_time})"

fn classify_binary_path(path: &std::path::Path) -> String:
    if is_repo_target_binary(path):
        "repo-target"
    elif is_cargo_bin_binary(path):
        "cargo-bin"
    else:
        "custom"

fn is_repo_target_binary(path: &std::path::Path) -> Bool:
    let normalized = path.to_string_lossy().replace("/", "\\").to_ascii_lowercase()
    (normalized.contains("\\target\\debug\\") || normalized.contains("\\target\\release\\"))

fn is_cargo_bin_binary(path: &std::path::Path) -> Bool:
    let cargo_home = std__env__var_os("CARGO_HOME").map(PathBuf__from).or_else(fn(): std__env__var_os("USERPROFILE").map(fn(profile): PathBuf__from(profile).join(".cargo")))
    cargo_home.map(fn(home): path.starts_with(home.join("bin"))).unwrap_or(false)

fn collect_path_matches(command_name: String) -> Array<std::path::PathBuf>:
    which__which_all(command_name).ok().map(fn(mut paths): paths.by_ref().take(4).collect()).unwrap_or_default()

fn doctor_path_status(current_exe: Option<&std::path::Path>, path_command: Option<&std::path::Path>, command_name: String) -> String:
    match (current_exe, path_command):
        (Some(current), Some(path_entry)) if paths_equivalent(current, path_entry) => ("current process matches PATH").to_string()
        (Some(_), Some(_)) => ("drift: current process differs from PATH").to_string()
        (Some(_), None) => f"current process exists, but {command_name} is not resolvable from PATH"
        (None, Some(_)) => f"PATH resolves {command_name}, but current process path is unknown"
        (None, None) => ("unknown").to_string()

fn paths_equivalent(a: &std::path::Path, b: &std::path::Path) -> Bool:
    match (std__fs__canonicalize(a), std__fs__canonicalize(b)):
        (Ok(left), Ok(right)) => (left == right)
        _ => (a == b)

fn find_project_root(start: &path::Path) -> Option<std::path::PathBuf>:
    for dir in start.ancestors():
        if dir.join("KAIN.toml").exists():
            return Option::Some(dir.to_path_buf())
    ()
    none

fn staging_dir() -> std::path::PathBuf:
    let cwd = std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from("."))
    let candidate1 = cwd.join("src-plugins")
    if candidate1.exists():
        return candidate1.join("_shaders")
    match cwd.parent():
        Some(parent) =>
            let candidate2 = parent.join("src-plugins")
            if candidate2.exists():
                return candidate2.join("_shaders")
            ()
        _ =>
            ()
            ()
    cwd.join("src-plugins").join("_shaders")

fn ensure_dir(p: &std::path::PathBuf) -> Bool:
    match std__fs__create_dir_all(p):
        Err(e) =>
            eprintln(f" Failed to create directory {p.display()}: {e}")
            return false
        _ =>
            ()
            ()
    true

@doc(doc = " Ensure parent directory exists for a file path.")
@doc(doc = " Creates all missing parent directories recursively.")
@doc(doc = " Returns true on success, false on failure (with error printed).")
fn ensure_parent_dir(file_path: &std::path::PathBuf) -> Bool:
    match file_path.parent():
        Some(parent) =>
            if (!parent.exists()):
                match std__fs__create_dir_all(parent):
                    Err(e) =>
                        eprintln(f" Failed to create directory {parent.display()}: {e}")
                        return false
                    _ =>
                        ()
                        ()
                ()
            ()
        _ =>
            ()
            ()
    true

fn find_runtime_c() -> Option<std::path::PathBuf>:
    match std__env__var_("KAIN_RUNTIME_C_PATH"):
        Ok(env_path) =>
            let p = PathBuf__from(env_path)
            if p.exists():
                return Option::Some(p)
            ()
        _ =>
            ()
            ()
    let candidates = [PathBuf__from("runtime/kain_runtime.c"), PathBuf__from("runtime/KAIN_runtime.c"), PathBuf__from("src/runtime/c/KAIN_runtime.c")]
    for candidate in candidates:
        if candidate.exists():
            return Option::Some(candidate)
    ()
    match std__env__current_exe():
        Ok(exe_path) =>
            match exe_path.parent().map(fn(p): p.to_path_buf()):
                Some(mut dir) =>
                    loop:
                        let candidate = dir.join("runtime").join("kain_runtime.c")
                        if candidate.exists():
                            return Option::Some(candidate)
                        if (!dir.pop()):
                            break
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    none

fn resolve_native_runtime_bundle() -> Result<Option<ResolvedNativeRuntimeBundle>, String>:
    match find_native_runtime_manifest():
        Some(manifest_path) => return load_native_runtime_manifest(&manifest_path).map(fn(__kain_closure_arg0): Option::Some(__kain_closure_arg0))
        _ =>
            ()
            ()
    match find_runtime_c():
        Some(runtime_c) => return Result::Ok(Option::Some(ResolvedNativeRuntimeBundle { name: ("kain-runtime-legacy").to_string(), sources: [runtime_c], include_dirs: Vec__new_(), defines: Vec__new_(), link_libs: default_native_runtime_link_libs(), uses_cpp_runtime: false }))
        _ =>
            ()
            ()
    Result::Ok(none)

fn resolve_c_ffi_shared_libraries_for_linking(source: String) -> Result<Array<std::path::PathBuf>, String>:
    let prepare = kain_c_ffi::PrepareContext { current_dir: std__env__current_dir().ok(), manifest_path: none }
    let outputs = kain_c_ffi__import_libraries_for_source(source, &kain_c_ffi::ImportCOptions { mode: kain_c_ffi__ArtifactMode__Generate, ..ImportCOptions__default_() }, &prepare).map_err(fn(err): err.to_string())?
    let mut shared_libraries = Vec__new_()
    for output in outputs:
        let shared_lib_path = output.resolved.shared_lib_path.ok_or_else(fn(): f"C FFI library '{output.resolved.import_name}' does not declare a shared library for LLVM linking")?
        if (!shared_lib_path.exists()):
            return Result::Err(f"C FFI shared library {shared_lib_path.display()} does not exist")
        shared_libraries.push(shared_lib_path)
        ()
    ()
    Result::Ok(shared_libraries)

fn load_native_runtime_manifest(manifest_path: &std::path::Path) -> Result<ResolvedNativeRuntimeBundle, String>:
    let manifest_source = std__fs__read_to_string(manifest_path).map_err(fn(err): f"unable to read runtime manifest {manifest_path.display()}: {err}")?
    let manifest: NativeRuntimeManifest = toml__from_str(&manifest_source).map_err(fn(err): f"unable to parse runtime manifest {manifest_path.display()}: {err}")?
    let selected_sources = current_platform_runtime_sources(&manifest)
    if (manifest.sources.is_empty() && selected_sources.is_empty()):
        return Result::Err(f"runtime manifest {manifest_path.display()} does not declare any sources")
    let manifest_dir = manifest_path.parent().ok_or_else(fn(): f"runtime manifest {manifest_path.display()} has no parent directory")?
    let sources = manifest.sources.iter().chain(selected_sources.iter()).map(fn(path): resolve_runtime_path(manifest_dir, path)).collect()
    let include_dirs = manifest.include_dirs.iter().map(fn(path): resolve_runtime_path(manifest_dir, path)).collect()
    let defines = current_platform_runtime_defines(&manifest)
    for source in &sources:
        if (!source.exists()):
            return Result::Err(f"runtime source {source.display()} does not exist")
    ()
    for include_dir in &include_dirs:
        if (!include_dir.exists()):
            return Result::Err(f"runtime include directory {include_dir.display()} does not exist")
    ()
    Result::Ok(ResolvedNativeRuntimeBundle { name: manifest.name.clone().filter(fn(value): (!value.trim().is_empty())).unwrap_or_else(fn(): ("kain-native-runtime").to_string()), sources: sources, include_dirs: include_dirs, defines: defines, link_libs: unique_link_libs(none), uses_cpp_runtime: manifest.sources.iter().chain(selected_sources.iter()).any(fn(path): runtime_source_uses_cpp(path)) })

fn current_platform_runtime_sources(manifest: &NativeRuntimeManifest) -> &[std::path::PathBuf]:
    if cfg!(windows):
        &(*manifest).windows_sources
    elif cfg!(target_os = "macos"):
        &(*manifest).macos_sources
    else:
        &(*manifest).linux_sources

fn current_platform_runtime_defines(manifest: &NativeRuntimeManifest) -> Array<String>:
    let mut defines = (*manifest).defines.clone()
    if cfg!(windows):
        defines.extend((*manifest).windows_defines.iter().cloned())
        ()
        ()
        ()
        ()
    elif cfg!(target_os = "macos"):
        defines.extend((*manifest).macos_defines.iter().cloned())
        ()
        ()
        ()
        ()
    else:
        defines.extend((*manifest).linux_defines.iter().cloned())
        ()
        ()
        ()
        ()
    defines

fn compile_native_runtime_bundle(bundle: &ResolvedNativeRuntimeBundle, clang_cmd: String, exe_path: &std::path::Path) -> Result<Array<std::path::PathBuf>, String>:
    let output_dir = exe_path.parent().unwrap_or_else(fn(): Path__new_("."))
    let runtime_obj_dir = output_dir.join(".kain-runtime").join(sanitize_runtime_name(&(*bundle).name))
    std__fs__create_dir_all(&runtime_obj_dir).map_err(fn(err): f"unable to create runtime object directory {runtime_obj_dir.display()}: {err}")?
    ()
    let object_ext = if cfg!(windows):
        "obj"
    else:
        "o"
    let mut objects = (fn(__kain_ctor_arg0): Vec__new_())((*bundle).sources.len())
    for selfhost_for_item in (*bundle).sources.iter().enumerate():
        let (index, source) = selfhost_for_item
        let object_path = runtime_obj_dir.join("{index}_{sanitize_runtime_name(&source.file_stem().and_then(fn(stem): stem.to_str()).unwrap_or(\"runtime\"))}.{object_ext}")
        let mut compile_cmd = Command__new_(clang_cmd)
        compile_cmd.arg("-c").arg(source).arg("-o").arg(&object_path).arg("-g")
        ()
        if runtime_source_uses_cpp(source):
            compile_cmd.arg("-std=c++20")
            ()
            ()
            ()
            ()
        for include_dir in &(*bundle).include_dirs:
            compile_cmd.arg("-I").arg(include_dir)
            ()
        ()
        for define in &(*bundle).defines:
            compile_cmd.arg(f"-D{define}")
            ()
        ()
        let status = compile_cmd.status().map_err(fn(err): f"unable to invoke clang for {source.display()}: {err}")?
        if (!status.success()):
            return Result::Err(f"clang returned a non-zero status while compiling {source.display()}")
        objects.push(object_path)
        ()
    ()
    Result::Ok(objects)

fn sanitize_runtime_name(value: String) -> String:
    let sanitized = value.chars().map(fn(ch): if ch.is_ascii_alphanumeric(): ch.to_ascii_lowercase() else: "_").collect()
    let trimmed = sanitized.trim_matches("_")
    if trimmed.is_empty():
        ("runtime").to_string()
    else:
        trimmed.to_string()

fn resolve_runtime_path(root: &std::path::Path, value: &std::path::Path) -> std::path::PathBuf:
    if value.is_absolute():
        value.to_path_buf()
    else:
        root.join(value)

fn runtime_source_uses_cpp(value: &std::path::Path) -> Bool:
    match value.extension().and_then(fn(extension): extension.to_str()):
        Some("cc") => true
        Some("cpp") => true
        Some("cxx") => true
        Some("mm") => true
        _ => false

fn unique_link_libs(values: Array<String>) -> Array<String>:
    let mut seen = BTreeSet__new_()
    let mut ordered = Vec__new_()
    for value in values:
        if seen.insert(value.clone()):
            ordered.push(value)
            ()
    ()
    ordered

fn platform_link_libs(link: &NativeRuntimeLinkManifest) -> Array<String>:
    if cfg!(windows):
        (*link).windows.clone()
    elif cfg!(target_os = "macos"):
        (*link).macos.clone()
    else:
        (*link).linux.clone()

fn default_native_runtime_link_libs() -> Array<String>:
    if cfg!(windows):
        [("legacy_stdio_definitions").to_string(), ("user32").to_string(), ("gdi32").to_string(), ("opengl32").to_string(), ("ws2_32").to_string()]
    elif cfg!(target_os = "linux"):
        [("m").to_string()]
    else:
        Vec__new_()

fn default_native_runtime_cpp_link_libs() -> Array<String>:
    if cfg!(windows):
        Vec__new_()
    elif cfg!(target_os = "macos"):
        [("c++").to_string()]
    else:
        [("stdc++").to_string()]

fn find_native_runtime_manifest() -> Option<std::path::PathBuf>:
    match std__env__var_("KAIN_RUNTIME_MANIFEST_PATH"):
        Ok(env_path) =>
            let path = PathBuf__from(env_path)
            if path.exists():
                return Option::Some(path)
            ()
        _ =>
            ()
            ()
    let candidate_suffixes = [PathBuf__from("runtime/native_runtime.toml"), PathBuf__from("runtime/native/runtime.toml")]
    for root in runtime_search_roots():
        for suffix in &candidate_suffixes:
            let candidate = root.join(suffix)
            if candidate.exists():
                return Option::Some(candidate)
    ()
    none

fn runtime_search_roots() -> Array<std::path::PathBuf>:
    let mut roots = Vec__new_()
    match std__env__current_dir():
        Ok(cwd) =>
            roots.push(cwd)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match std__env__current_exe():
        Ok(exe_path) =>
            match exe_path.parent().map(fn(path): path.to_path_buf()):
                Some(mut dir) =>
                    loop:
                        roots.push(dir.clone())
                        ()
                        if (!dir.pop()):
                            break
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    roots

fn find_bundled_clang() -> Option<String>:
    match std__env__var_("KAIN_CLANG_PATH"):
        Ok(env_path) =>
            let path = PathBuf__from(env_path)
            if path.exists():
                return Option::Some(path.to_string_lossy().into_owned())
            ()
        _ =>
            ()
            ()
    let candidate_suffixes = [PathBuf__from("toolchain/llvm/bin/clang.exe"), PathBuf__from("toolchain/llvm/bin/clang"), PathBuf__from("third_party/llvm/bin/clang.exe"), PathBuf__from("third_party/llvm/bin/clang"), PathBuf__from("llvm/bin/clang.exe"), PathBuf__from("llvm/bin/clang")]
    let mut search_roots = Vec__new_()
    match std__env__current_dir():
        Ok(cwd) =>
            search_roots.push(cwd)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match std__env__current_exe():
        Ok(exe_path) =>
            match exe_path.parent():
                Some(dir) =>
                    let mut cursor = dir.to_path_buf()
                    loop:
                        search_roots.push(cursor.clone())
                        ()
                        if (!cursor.pop()):
                            break
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    for root in search_roots:
        for suffix in &candidate_suffixes:
            let candidate = root.join(suffix)
            if candidate.exists():
                return Option::Some(candidate.to_string_lossy().into_owned())
    ()
    none

fn find_binary(name: String, fallback: Option<String>) -> Option<std::path::PathBuf>:
    if Command__new_(name).arg("--version").output().is_ok():
        return Option::Some(PathBuf__from(name))
    match fallback:
        Some(f) =>
            let pb = PathBuf__from(f)
            if pb.exists():
                return Option::Some(pb)
            ()
        _ =>
            ()
            ()
    none

fn derive_shader_paths(input: &std::path::PathBuf) -> (std::path::PathBuf, std::path::PathBuf, std::path::PathBuf):
    let stage = staging_dir()
    let stem = input.file_stem().and_then(fn(s): s.to_str()).unwrap_or("shader")
    let spv = stage.join(f"{stem}.spv")
    let hlsl = stage.join(f"{stem}.hlsl")
    let usf = stage.join(f"{stem}.usf")
    (spv, hlsl, usf)

fn resolve_plugin_dir(plugin: String, base_opt: &Option<std::path::PathBuf>) -> std::path::PathBuf:
    match base_opt:
        Some(base) => return base.join(plugin).join("Shaders")
        _ =>
            ()
            ()
    let cwd = std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from("."))
    let candidate1 = cwd.join("src-plugins")
    if candidate1.exists():
        return candidate1.join(plugin).join("Shaders")
    match cwd.parent():
        Some(parent) =>
            let candidate2 = parent.join("src-plugins")
            if candidate2.exists():
                return candidate2.join(plugin).join("Shaders")
            ()
        _ =>
            ()
            ()
    cwd.join("src-plugins").join(plugin).join("Shaders")

fn run_ue5_shader_pipeline(input: &std::path::PathBuf, args: &Args) -> Bool:
    let (spv_path, hlsl_path, usf_path) = derive_shader_paths(input)
    let stage_dir = staging_dir()
    if (!ensure_dir(&stage_dir)):
        return false
    let source = match std__fs__read_to_string(input):
        Ok(s) => s
        Err(e) =>
            eprintln(f" Failed to read {input.display()}: {e}")
            return false
    if (*args).verbose:
        println(f" Compiling: {input.display()}")
        ()
        ()
    let compiled_spv = match cli__compile_spirv_binary(&source):
        Ok(bytes) => bytes
        Err(e) =>
            let filename = input.file_name().and_then(fn(s): s.to_str()).unwrap_or("input.kn")
            let diag = Diagnostics__new_(&source, filename)
            eprint(diag.format_error(&e))
            return false
    if (*args).dry_run:
        println(f"→ Write SPIR-V {spv_path.display()}")
        ()
        ()
    else:
        match std__fs__write(&spv_path, &compiled_spv):
            Err(e) =>
                eprintln(f" Failed to write {spv_path.display()}: {e}")
                return false
            _ =>
                if (*args).verbose:
                    println(f" {spv_path.display()}")
                    ()
                    ()
                ()
        ()
    match find_binary("spirv-val", none):
        Some(val_bin) =>
            if (*args).verbose:
                println(" Validating SPIR-V")
                ()
                ()
            if (!(*args).dry_run):
                let status = Command__new_(val_bin).arg(&spv_path).status()
                match status:
                    Ok(s) =>
                        if (!s.success()):
                            eprintln(" SPIR-V validation failed")
                            return false
                        ()
                    _ =>
                        ()
                        ()
                ()
            ()
        _ =>
            ()
            ()
    let naga_bin = match find_binary("naga", none):
        Some(p) => p
        None =>
            eprintln(" 'naga' not found. Install with: cargo install naga-cli")
            return false
    if (*args).verbose:
        println(" Transpiling to HLSL")
        ()
        ()
    if (*args).dry_run:
        println(f"→ Run naga {spv_path.display()} {hlsl_path.display()}")
        ()
        ()
    else:
        let status = Command__new_(naga_bin).arg(&spv_path).arg(&hlsl_path).status()
        match status:
            Ok(s) if s.success() =>
                if (*args).verbose:
                    println(f" {hlsl_path.display()}")
                    ()
                    ()
                ()
            _ =>
                eprintln(" Naga transpilation failed")
                return false
        ()
    if (*args).dry_run:
        println(f"→ Write USF {usf_path.display()}")
        ()
        ()
    else:
        let stem = input.file_stem().and_then(fn(s): s.to_str()).unwrap_or("shader")
        let content = f"#include \"{stem}.hlsl\"\n"
        match std__fs__write(&usf_path, content):
            Err(e) =>
                eprintln(f" Failed to write {usf_path.display()}: {e}")
                return false
            _ =>
                ()
                ()
        ()
    match &(*args).plugin:
        Some(plugin) =>
            let target_dir = resolve_plugin_dir(plugin, &(*args).plugins_dir)
            if (*args).dry_run:
                println(f"→ Copy to {target_dir.display()}")
                ()
                ()
            else:
                if (!ensure_dir(&target_dir.clone())):
                    return false
                let hlsl_target = target_dir.join(hlsl_path.file_name().unwrap())
                let usf_target = target_dir.join(usf_path.file_name().unwrap())
                match std__fs__copy(&hlsl_path, &hlsl_target):
                    Err(e) =>
                        eprintln(f" Copy failed: {e}")
                        return false
                    _ =>
                        ()
                        ()
                match std__fs__copy(&usf_path, &usf_target):
                    Err(e) =>
                        eprintln(f" Copy failed: {e}")
                        return false
                    _ =>
                        ()
                        ()
                println(f" {target_dir.display()}")
                ()
                ()
            ()
        _ =>
            if (*args).verbose:
                println(f" Staged in {stage_dir.display()}")
                ()
                ()
            ()
    true

