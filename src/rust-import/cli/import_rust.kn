use crate::error::KainError

use crate::error::KainResult

use serde::Serialize

use std::collections::BTreeMap

use std::collections::HashMap

use std::fs

use std::path::Path

use std::path::PathBuf

@derive(Debug, Clone)
pub struct ImportRustBatchOptions:
    recursive: Bool
    flat: Bool
    include_filters: Array<String>
    exclude_filters: Array<String>
    fail_fast: Bool
    report_json: Option<std::path::PathBuf>

impl Default for ImportRustBatchOptions:
    fn default_() -> ImportRustBatchOptions:
        ImportRustBatchOptions { recursive: true, flat: false, include_filters: Vec__new_(), exclude_filters: Vec__new_(), fail_fast: false, report_json: none }


@derive(Debug, Default)
struct ImportRustSummary:
    discovered_files: usize
    imported_files: usize
    skipped_files: usize
    failed_files: Array<(std::path::PathBuf, String)>
    diagnostics: Array<(std::path::PathBuf, Array<String>)>

impl Default for ImportRustSummary:
    pub fn default_() -> ImportRustSummary:
        ImportRustSummary { discovered_files: 0, imported_files: 0, skipped_files: 0, failed_files: Vec__new_(), diagnostics: Vec__new_() }


@derive(Debug, serde__Serialize)
struct ImportRustFailureEntry:
    file: String
    module_path: Option<String>
    error: String
    repair_hint: Option<String>

@derive(Debug, serde__Serialize)
struct ImportRustDiagnosticEntry:
    file: String
    module_path: Option<String>
    diagnostics: Array<String>
    diagnostic_classes: Map<String, usize>
    repair_hint: Option<String>

@derive(Debug, serde__Serialize)
struct ImportRustFailureReport:
    input_path: String
    output_path: Option<String>
    target: Option<String>
    recursive: Bool
    flat: Bool
    include_filters: Array<String>
    exclude_filters: Array<String>
    discovered_files: usize
    imported_files: usize
    skipped_files: usize
    failed_files: Array<ImportRustFailureEntry>
    lossy_diagnostics: Array<ImportRustDiagnosticEntry>
    diagnostics_by_class: Map<String, usize>
    generated_kain_path: Option<String>
    compiled_output_path: Option<String>
    generated_at_utc: String

@doc(doc = " Import a Rust file into KAIN AST and optionally write/compile")
pub fn import_rust(input: &std::path::Path, output: Option<&std::path::Path>, target: Option<String>) -> Result<(), KainError>:
    import_rust_with_batch(input, output, target, &ImportRustBatchOptions__default_())

@doc(doc = " Import a Rust file or directory into KAIN AST and optionally write/compile.")
pub fn import_rust_with_batch(input: &std::path::Path, output: Option<&std::path::Path>, target: Option<String>, batch: &ImportRustBatchOptions) -> Result<(), KainError>:
    let resolved_output: Option<std::path::PathBuf> = match output:
        Some(path) => Option::Some(path.to_path_buf())
        None if input.is_dir() => Option::Some(input.with_extension("kn"))
        None => none
    let (program, summary) = import_path_to_program(input, batch)?
    if (input.is_dir() && (summary.imported_files == 0)):
        maybe_write_failure_report(input, resolved_output, target, batch, &summary, none, none)?
        ()
        return Result::Err(KainError__runtime(build_no_import_detail(&summary)))
    let kain_source = generate_kain_source(&program)?
    let mut generated_kain_path: Option<std::path::PathBuf> = none
    match resolved_output:
        Some(out_path) =>
            std__fs__write(out_path, &kain_source).map_err(fn(e): KainError__runtime(f"Failed to write output: {e}"))?
            ()
            generated_kain_path = Option::Some(out_path.to_path_buf())
            ()
            println(f"✓ Generated KAIN source: {out_path.display()} ({kain_source.len()} bytes)")
            ()
            ()
        _ =>
            ()
            ()
    let mut compiled_output_path: Option<std::path::PathBuf> = none
    match target:
        Some(target_str) =>
            let compile_target = parse_compile_target(target_str).ok_or_else(fn(): KainError__runtime(f"Unknown target: {target_str}"))?
            println(f"🔨 Compiling to target: {target_str}")
            let compiled = compile_(&kain_source, compile_target).map_err(fn(e): KainError__runtime(f"Compilation failed: {e}"))?
            let compiled_output = match resolved_output:
                Some(out_) => out_.with_extension(target_extension(compile_target))
                _ => input.with_extension(target_extension(compile_target))
            std__fs__write(&compiled_output, &compiled).map_err(fn(e): KainError__runtime(f"Failed to write compiled output: {e}"))?
            ()
            compiled_output_path = Option::Some(compiled_output.clone())
            ()
            println(f"✓ Compiled output: {compiled_output.display()} ({compiled.len()} bytes)")
            ()
            ()
        _ =>
            ()
            ()
    println("✅ Import complete")
    println(f"   Functions: {count_functions(&program)}")
    println(f"   Structs: {count_structs(&program)}")
    println(f"   Enums: {count_enums(&program)}")
    if input.is_dir():
        println("   Directory structure: preserved as nested modules unless flat mode is enabled")
        println(f"   Rust files: discovered {summary.discovered_files}, imported {summary.imported_files}, skipped {summary.skipped_files}, failed {summary.failed_files.len()}")
        if (!summary.failed_files.is_empty()):
            println("   Failed files:")
            for selfhost_for_item in summary.failed_files.iter().take(20):
                let (path, error) = selfhost_for_item
                println(f"     - {path.display()}: {error}")
            ()
            if (summary.failed_files.len() > 20):
                println(f"     ... {(summary.failed_files.len() - 20)} more")
                ()
                ()
            ()
        if (!summary.diagnostics.is_empty()):
            let total_diags: usize = summary.diagnostics.iter().map(fn(__kain_closure_arg0): __kain_closure_arg0.__kain_tuple_1.len()).sum()
            let class_counts = diagnostic_class_counts(&summary.diagnostics)
            let external_mod_diags = (*class_counts.get("external_mod_decl").unwrap_or(&0))
            let visible_diags = total_diags.saturating_sub(external_mod_diags)
            if (visible_diags > 0):
                println(f"   Lossy lowering: {visible_diags} diagnostic(s) across {summary.diagnostics.len()} file(s)")
                match class_counts.iter().find(fn(__kain_closure_arg1): (__kain_closure_arg1.__kain_tuple_0.as_str() != "external_mod_decl")):
                    Some((class_, count)) =>
                        println(f"   Primary repair seam: class:{class_} ({count} note(s))")
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            if (external_mod_diags > 0):
                println(f"   External module declarations: {external_mod_diags} note(s) (directory structure preserved)")
                ()
                ()
            ()
        ()
    elif (!summary.diagnostics.is_empty()):
        let total_diags: usize = summary.diagnostics.iter().map(fn(__kain_closure_arg2): __kain_closure_arg2.__kain_tuple_1.len()).sum()
        let class_counts = diagnostic_class_counts(&summary.diagnostics)
        let external_mod_diags = (*class_counts.get("external_mod_decl").unwrap_or(&0))
        let visible_diags = total_diags.saturating_sub(external_mod_diags)
        if (visible_diags > 0):
            println(f"   Lossy lowering: {visible_diags} diagnostic(s)")
            match class_counts.iter().find(fn(__kain_closure_arg3): (__kain_closure_arg3.__kain_tuple_0.as_str() != "external_mod_decl")):
                Some((class_, count)) =>
                    println(f"   Primary repair seam: class:{class_} ({count} note(s))")
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        if (external_mod_diags > 0):
            println(f"   External module declarations: {external_mod_diags} note(s)")
            ()
            ()
        ()
    maybe_write_failure_report(input, resolved_output, target, batch, &summary, generated_kain_path, compiled_output_path)?
    ()
    Result::Ok(())

fn import_path_to_program(input: &std::path::Path, batch: &ImportRustBatchOptions) -> Result<(kain_core::ast::Program, ImportRustSummary), KainError>:
    if input.is_file():
        let (program, diagnostics) = kain_import__import_rust_file_detailed(input).map_err(fn(e): KainError__runtime(f"Rust import failed: {e}"))?
        return Result::Ok((program, ImportRustSummary { discovered_files: 1, imported_files: 1, diagnostics: if diagnostics.is_empty(): Vec__new_() else: [(input.to_path_buf(), diagnostics)], ..ImportRustSummary__default_() }))
    if (!input.is_dir()):
        return Result::Err(KainError__runtime(f"Input is neither file nor directory: {input.display()}"))
    let mut candidates = Vec__new_()
    collect_rust_files(input, (*batch).recursive, &mut candidates)?
    ()
    candidates.sort()
    ()
    let mut summary = ImportRustSummary { discovered_files: candidates.len(), ..ImportRustSummary__default_() }
    let mut merged_items = Vec__new_()
    let mut module_name_counts: Map<String, usize> = HashMap__new_()
    let normalized_includes = normalize_filters(&(*batch).include_filters)
    let normalized_excludes = normalize_filters(&(*batch).exclude_filters)
    for file in candidates:
        let rel = file.strip_prefix(input).unwrap_or(file.as_path())
        if (!path_matches_filters(rel, &normalized_includes, &normalized_excludes)):
            summary.skipped_files = (summary.skipped_files + 1)
            ()
            continue
        match kain_import__import_rust_file_detailed(&file):
            Ok((program, diagnostics)) =>
                summary.imported_files = (summary.imported_files + 1)
                ()
                if (!diagnostics.is_empty()):
                    summary.diagnostics.push((file.clone(), diagnostics))
                    ()
                    ()
                    ()
                    ()
                if (*batch).flat:
                    merged_items.extend(program.items)
                    ()
                else:
                    let module_path = module_path_for_relative_file(rel)
                    if module_path.is_empty():
                        merged_items.extend(program.items)
                        ()
                    else:
                        let entry = module_name_counts.entry(module_path.join("::")).or_insert(0)
                        (*entry) = ((*entry) + 1)
                        ()
                        let resolved_module_path = if ((*entry) == 1):
                            module_path
                        else:
                            let mut adjusted = module_path
                            match adjusted.last_mut():
                                Some(last) =>
                                    (*last) = f"{last}_{(*entry)}"
                                    ()
                                    ()
                                    ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            adjusted
                        merged_items.push(build_nested_module(&resolved_module_path, program.items))
                        ()
            Err(err) =>
                let compact = compact_error_message(&err)
                summary.failed_files.push((file.clone(), compact))
                ()
                if (*batch).fail_fast:
                    return Result::Err(KainError__runtime(f"Rust import failed: {file.display()}: {err}"))
    ()
    Result::Ok((kain_core::ast::Program { items: merged_items, span: Span__default_() }, summary))

fn build_no_import_detail(summary: &ImportRustSummary) -> String:
    if (*summary).failed_files.is_empty():
        return ("No Rust source files matched include/exclude filters").to_string()
    let mut msg = String__from("All matching Rust files failed to import")
    let previews = (*summary).failed_files.iter().take(5).map(fn(__kain_closure_arg4): f"{__kain_closure_arg4.__kain_tuple_0.display()}: {__kain_closure_arg4.__kain_tuple_1}").collect()
    if (!previews.is_empty()):
        msg.push_str(&" (e.g. {previews.join(\" | \")})")
        ()
        ()
        ()
        ()
    msg

fn maybe_write_failure_report(input: &std::path::Path, output: Option<&std::path::Path>, target: Option<String>, batch: &ImportRustBatchOptions, summary: &ImportRustSummary, generated_kain_path: Option<&std::path::Path>, compiled_output_path: Option<&std::path::Path>) -> Result<(), KainError>:
    let Some(report_path) = resolve_report_path(input, output, batch, summary)
    let report = ImportRustFailureReport { input_path: input.display().to_string(), output_path: output.map(fn(p): p.display().to_string()), target: target.map(str__to_string), recursive: (*batch).recursive, flat: (*batch).flat, include_filters: (*batch).include_filters.clone(), exclude_filters: (*batch).exclude_filters.clone(), discovered_files: (*summary).discovered_files, imported_files: (*summary).imported_files, skipped_files: (*summary).skipped_files, failed_files: (*summary).failed_files.iter().map(fn(__kain_closure_arg5): ImportRustFailureEntry { file: __kain_closure_arg5.__kain_tuple_0.display().to_string(), module_path: module_path_string_for_report(input, __kain_closure_arg5.__kain_tuple_0), error: __kain_closure_arg5.__kain_tuple_1.clone(), repair_hint: Option::Some(("re-run the importer on this file with --report-json to isolate the failing seam").to_string()) }).collect(), lossy_diagnostics: (*summary).diagnostics.iter().map(fn(__kain_closure_arg6): ImportRustDiagnosticEntry { file: __kain_closure_arg6.__kain_tuple_0.display().to_string(), module_path: module_path_string_for_report(input, __kain_closure_arg6.__kain_tuple_0), diagnostic_classes: diagnostic_class_counts_single(__kain_closure_arg6.__kain_tuple_1), diagnostics: __kain_closure_arg6.__kain_tuple_1.clone(), repair_hint: Option::Some(("search these class markers in the generated .kn or import report; they point at the lowered seam").to_string()) }).collect(), diagnostics_by_class: diagnostic_class_counts(&(*summary).diagnostics), generated_kain_path: generated_kain_path.map(fn(p): p.display().to_string()), compiled_output_path: compiled_output_path.map(fn(p): p.display().to_string()), generated_at_utc: Utc__now().to_rfc3339() }
    match report_path.parent():
        Some(parent) =>
            if (!parent.as_os_str().is_empty()):
                std__fs__create_dir_all(parent).map_err(fn(e): KainError__runtime(f"Failed to create report directory {parent.display()}: {e}"))?
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    let json = serde_json__to_string_pretty(&report).map_err(fn(e): KainError__runtime(f"Failed to serialize import report: {e}"))?
    std__fs__write(&report_path, json).map_err(fn(e): KainError__runtime(f"Failed to write import report: {e}"))?
    ()
    println(f"📄 Failure report JSON: {report_path.display()}")
    Result::Ok(())

fn resolve_report_path(input: &std::path::Path, output: Option<&std::path::Path>, batch: &ImportRustBatchOptions, summary: &ImportRustSummary) -> Option<std::path::PathBuf>:
    match &(*batch).report_json:
        Some(path) => return Option::Some(path.clone())
        _ =>
            ()
            ()
    if (input.is_dir() && (((!(*summary).failed_files.is_empty()) || (!(*summary).diagnostics.is_empty())))):
        return Option::Some(output.map(fn(out_): out_.with_extension("import_report.json")).unwrap_or_else(fn(): input.with_extension("import_report.json")))
    if (input.is_file() && (!(*summary).diagnostics.is_empty())):
        return Option::Some(output.map(fn(out_): out_.with_extension("import_report.json")).unwrap_or_else(fn(): input.with_extension("import_report.json")))
    none

fn compact_error_message(raw: String) -> String:
    let flattened = raw.lines().take(2).map(str__trim).filter(fn(line_): (!line_.is_empty())).collect().join(" | ")
    let mut compact = if flattened.is_empty():
        raw.trim().to_string()
    else:
        flattened
    const LIMIT: usize = 320

    if (compact.len() > LIMIT):
        compact.truncate(LIMIT)
        ()
        compact.push_str("...")
        ()
        ()
        ()
        ()
    compact

fn collect_rust_files(root: &std::path::Path, recursive: Bool, out_: &mut Array<std::path::PathBuf>) -> Result<(), KainError>:
    let entries = std__fs__read_dir(root).map_err(fn(e): KainError__runtime(f"Failed to read directory {root.display()}: {e}"))?
    for entry in entries:
        let entry = entry.map_err(fn(e): KainError__runtime(f"Failed to read directory entry: {e}"))?
        let path = entry.path()
        if path.is_dir():
            if recursive:
                collect_rust_files(&path, recursive, out_)?
                ()
                ()
                ()
                ()
            continue
        if path.extension().and_then(fn(ext): ext.to_str()).is_some_and(fn(ext): ext.eq_ignore_ascii_case("rs")):
            out_.push(path)
            ()
    ()
    Result::Ok(())

fn normalize_filters(filters: &[String]) -> Array<String>:
    filters.iter().map(fn(f): f.trim().replace("\\", "/").to_ascii_lowercase()).filter(fn(f): (!f.is_empty())).collect()

fn path_matches_filters(path: &std::path::Path, includes: &[String], excludes: &[String]) -> Bool:
    let normalized = path.to_string_lossy().replace("\\", "/").to_ascii_lowercase()
    if ((!includes.is_empty()) && (!includes.iter().any(fn(inc): normalized.contains(inc)))):
        return false
    (!excludes.iter().any(fn(exc): normalized.contains(exc)))

fn module_path_for_relative_file(path: &std::path::Path) -> Array<String>:
    let mut parts = Vec__new_()
    let file_name = path.file_name().and_then(fn(s): s.to_str()).unwrap_or("")
    let preserve_root_file = match file_name:
        "lib.rs" => true
        "main.rs" => true
        _ => false
    let preserve_mod_file = (file_name == "mod.rs")
    if preserve_root_file:
        return Vec__new_()
    match path.parent():
        Some(parent) =>
            for component_ in parent.components():
                let part = sanitize_module_component(&component_.as_os_str().to_string_lossy())
                if (!part.is_empty()):
                    parts.push(part)
                    ()
            ()
            ()
        _ =>
            ()
            ()
    let file_stem = path.file_stem().and_then(fn(s): s.to_str()).unwrap_or("module")
    let leaf = if (preserve_mod_file && (!parts.is_empty())):
        none
    else:
        Option::Some(sanitize_module_component(file_stem))
    match leaf.filter(fn(leaf): (!leaf.is_empty())):
        Some(leaf) =>
            parts.push(leaf)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    if parts.is_empty():
        parts.push(("module").to_string())
        ()
        ()
        ()
        ()
    parts

fn sanitize_module_component(raw: String) -> String:
    let mut name = raw.chars().map(fn(ch): if ch.is_ascii_alphanumeric(): ch.to_ascii_lowercase() else: "_").collect()
    while name.contains("__"):
        name = name.replace("__", "_")
        ()
    ()
    name = name.trim_matches("_").to_string()
    ()
    if name.is_empty():
        return ("module").to_string()
    if name.chars().next().is_some_and(fn(c): c.is_ascii_digit()):
        return f"m_{name}"
    name

fn build_nested_module(path: &[String], items: Array<kain_core::ast::Item>) -> kain_core::ast::Item:
    let mut current = items
    for name in path.iter().rev():
        current = [kain_core__ast__Item::Mod(kain_core::ast::Mod { name: name.clone(), inline_: Option::Some(current), visibility: kain_core__ast__Visibility__Public, span: Span__default_() })]
        ()
    ()
    current.into_iter().next().expect("nested module wrapper")

@doc(doc = " Generate KAIN source code from AST")
fn generate_kain_source(program: &kain_core::ast::Program) -> Result<String, KainError>:
    use std::fmt::Write

    let mut output = String__new_()
    __kain_writeln_fmt!(output, "# Generated from Rust source by kain import-rust").map_err(fn(e): KainError__runtime(f"Failed to generate source: {e}"))?
    ()
    __kain_writeln_fmt!(output, "# Project Ouroboros — Rust → KAIN → Rust").map_err(fn(e): KainError__runtime(f"Failed to generate source: {e}"))?
    ()
    __kain_writeln_fmt!(output, "").map_err(fn(e): KainError__runtime(f"Failed to generate source: {e}"))?
    ()
    for item in &(*program).items:
        write_item(&mut output, item, 0)?
        ()
    ()
    Result::Ok(output)

fn write_item(output: String, item: &kain_core::ast::Item, indent: usize) -> Result<(), KainError>:
    use std::fmt::Write

    match item:
        kain_core__ast__Item::Function(func) => write_function(output, func, indent)
        kain_core__ast__Item::Struct(s) => write_struct(output, s, indent)
        kain_core__ast__Item::Enum(e) => write_enum(output, e, indent)
        kain_core__ast__Item::Trait(value) => write_trait(output, value, indent)
        kain_core__ast__Item::Impl(value) => write_impl(output, value, indent)
        kain_core__ast__Item::Mod(m) =>
            write_line(output, indent, &f"mod {m.name}:")?
            ()
            match &m.inline_:
                Some(children) =>
                    if (!children.is_empty()):
                        for child in children:
                            write_item(output, child, (indent + 1))?
                            ()
                        ()
                        ()
                    ()
                _ =>
                    ()
                    ()
            __kain_writeln_fmt!(output, "").map_err(fn(e): KainError__runtime(f"Failed to write module: {e}"))
        _ => Result::Ok(())

fn write_function(output: String, func: &kain_core::ast::Function, indent: usize) -> Result<(), KainError>:
    use std::fmt::Write

    let mut signature = f"fn {(*func).name}("
    for selfhost_for_item in (*func).params.iter().enumerate():
        let (i, param) = selfhost_for_item
        if (i > 0):
            signature.push_str(", ")
            ()
            ()
            ()
            ()
        signature.push_str(&f"{param.name}: {type_to_string(&param.ty)}")
        ()
    ()
    signature.push(")")
    ()
    match &(*func).return_type:
        Some(ret_ty) =>
            signature.push_str(&f" -> {type_to_string(ret_ty)}")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    signature.push(":")
    ()
    write_line(output, indent, &signature)?
    ()
    write_block(output, &(*func).body, (indent + 1))?
    ()
    __kain_writeln_fmt!(output, "").map_err(fn(e): KainError__runtime(f"Failed to write function: {e}"))?
    ()
    Result::Ok(())

fn write_struct(output: String, s: &kain_core::ast::Struct, indent: usize) -> Result<(), KainError>:
    use std::fmt::Write

    write_line(output, indent, &f"struct {(*s).name}:")?
    ()
    if (*s).fields.is_empty():
        write_line(output, (indent + 1), &lossy_marker("empty_struct_lowering", "empty Rust struct lowered to pass", none))?
        ()
        ()
        ()
        ()
    else:
        for field in &(*s).fields:
            write_line(output, (indent + 1), &f"{field.name}: {type_to_string(&field.ty)}")?
            ()
        ()
        ()
    __kain_writeln_fmt!(output, "").map_err(fn(e): KainError__runtime(f"Failed to write struct: {e}"))?
    ()
    Result::Ok(())

fn write_enum(output: String, e: &kain_core::ast::Enum, indent: usize) -> Result<(), KainError>:
    use std::fmt::Write

    write_line(output, indent, &f"enum {(*e).name}:")?
    ()
    if (*e).variants.is_empty():
        write_line(output, (indent + 1), &lossy_marker("empty_enum_lowering", "empty Rust enum lowered to pass", none))?
        ()
        ()
        ()
        ()
    else:
        for variant in &(*e).variants:
            let variant_str = match &variant.fields:
                kain_core__ast__VariantFields::Unit => variant.name.clone()
                kain_core__ast__VariantFields::Tuple(types) =>
                    let types_str = types.iter().map(type_to_string).collect().join(", ")
                    f"{variant.name}({types_str})"
                kain_core__ast__VariantFields::Struct(fields) =>
                    let fields_str = fields.iter().map(fn(field): f"{field.name}: {type_to_string(&field.ty)}").collect().join(", ")
                    "{variant.name} { {fields_str} }"
            write_line(output, (indent + 1), &variant_str)?
            ()
        ()
        ()
    __kain_writeln_fmt!(output, "").map_err(fn(e): KainError__runtime(f"Failed to write enum: {e}"))?
    ()
    Result::Ok(())

fn write_trait(output: String, value: &kain_core::ast::Trait, indent: usize) -> Result<(), KainError>:
    use std::fmt::Write

    let trait_header = if (*value).supertraits.is_empty():
        f"trait {(*value).name}:"
    else:
        let supertraits = (*value).supertraits.iter().map(type_to_string).collect().join(" + ")
        f"trait {(*value).name} <: {supertraits}:"
    write_line(output, indent, &trait_header)?
    ()
    if (*value).methods.is_empty():
        write_line(output, (indent + 1), &lossy_marker("empty_trait_lowering", "empty Rust trait lowered to pass", none))?
        ()
        ()
        ()
        ()
    else:
        for method in &(*value).methods:
            let mut signature = f"fn {method.name}("
            for selfhost_for_item in method.params.iter().enumerate():
                let (index, param) = selfhost_for_item
                if (index > 0):
                    signature.push_str(", ")
                    ()
                    ()
                    ()
                    ()
                signature.push_str(&f"{param.name}: {type_to_string(&param.ty)}")
                ()
            ()
            signature.push(")")
            ()
            match &method.return_type:
                Some(return_type) =>
                    signature.push_str(&f" -> {type_to_string(return_type)}")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            signature.push(":")
            ()
            write_line(output, (indent + 1), &signature)?
            ()
            match &method.default_impl:
                Some(default_impl) =>
                    write_block(output, default_impl, (indent + 2))?
                    ()
                _ =>
                    write_line(output, (indent + 2), &lossy_marker("missing_trait_default_body", "missing Rust trait default body lowered to pass", Option::Some("restore the original Rust body or add a concrete KAIN lowering")))?
                    ()
        ()
        ()
    __kain_writeln_fmt!(output, "").map_err(fn(e): KainError__runtime(f"Failed to write trait: {e}"))?
    ()
    Result::Ok(())

fn write_impl(output: String, value: &kain_core::ast::Impl, indent: usize) -> Result<(), KainError>:
    use std::fmt::Write

    let header = match &(*value).trait_name:
        Some(trait_name) => f"impl {trait_name} for {type_to_string(&(*value).target_type)}:"
        None => f"impl {type_to_string(&(*value).target_type)}:"
    write_line(output, indent, &header)?
    ()
    if (*value).methods.is_empty():
        write_line(output, (indent + 1), &lossy_marker("empty_impl_lowering", "empty Rust impl lowered to pass", none))?
        ()
        ()
        ()
        ()
    else:
        for method in &(*value).methods:
            write_function(output, method, (indent + 1))?
            ()
        ()
        ()
    __kain_writeln_fmt!(output, "").map_err(fn(e): KainError__runtime(f"Failed to write impl: {e}"))?
    ()
    Result::Ok(())

fn write_block(output: String, block: &kain_core::ast::Block, indent: usize) -> Result<(), KainError>:
    if (*block).stmts.is_empty():
        write_line(output, indent, "# LOSSY LOWERING: empty Rust block lowered to pass")?
        ()
        return Result::Ok(())
    for stmt in &(*block).stmts:
        write_stmt(output, stmt, indent)?
        ()
    ()
    Result::Ok(())

fn write_stmt(output: String, stmt: &kain_core::ast::Stmt, indent: usize) -> Result<(), KainError>:
    match stmt:
        kain_core__ast__Stmt::Let { pattern: pattern, ty: ty, value: value } =>
            let mut line_ = f"let {pattern_to_string(pattern)}"
            match ty:
                Some(ty) =>
                    line_.push_str(&f": {type_to_string(ty)}")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match value:
                Some(value) =>
                    line_.push_str(&f" = {expr_to_string(value)}")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            write_line(output, indent, &line_)
        kain_core__ast__Stmt::Expr(expr) => write_line(output, indent, &expr_to_string(expr))
        kain_core__ast__Stmt::Return(value, _) =>
            match value:
                Some(expr) => write_line(output, indent, &f"return {expr_to_string(expr)}")
                _ => write_line(output, indent, "return")
        _ => write_line(output, indent, &lossy_marker("unsupported_stmt_lowering", "unsupported Rust statement lowered as placeholder", Option::Some("inspect the matching diagnostic in import_report.json and replace this seam with a concrete lowering")))

fn write_line(output: String, indent: usize, line_: String) -> Result<(), KainError>:
    use std::fmt::Write

    __kain_writeln_fmt!(output, "{(\"    \").repeat(indent)}{line_}").map_err(fn(e): KainError__runtime(f"Failed to generate source: {e}"))

fn lossy_marker(class_: String, message: String, repair_hint: Option<String>) -> String:
    match repair_hint:
        Some(hint) => f"# LOSSY LOWERING [class:{class_}]: {message} | repair: {hint}"
        None => f"# LOSSY LOWERING [class:{class_}]: {message}"

fn module_path_string_for_report(root: &std::path::Path, path: &std::path::Path) -> Option<String>:
    let rel = path.strip_prefix(root).unwrap_or(path)
    let module_path = module_path_for_relative_file(rel)
    if module_path.is_empty():
        none
    else:
        Option::Some(module_path.join("::"))

fn diagnostic_class_counts_single(diagnostics: &[String]) -> Map<String, usize>:
    let mut counts = BTreeMap__new_()
    for diag in diagnostics:
        match diagnostic_class(diag):
            Some(class_) =>
                (*counts.entry(class_.to_string()).or_insert(0)) = ((*counts.entry(class_.to_string()).or_insert(0)) + 1)
                ()
            _ => ()
    ()
    counts

fn diagnostic_class_counts(diagnostics: &[(std::path::PathBuf, Array<String>)]) -> Map<String, usize>:
    let mut counts = BTreeMap__new_()
    for selfhost_for_item in diagnostics:
        let (_, file_diags) = selfhost_for_item
        for diag in file_diags:
            match diagnostic_class(diag):
                Some(class_) =>
                    (*counts.entry(class_.to_string()).or_insert(0)) = ((*counts.entry(class_.to_string()).or_insert(0)) + 1)
                    ()
                _ => ()
    ()
    counts

fn diagnostic_class(diag: String) -> Option<String>:
    (diag.split("[class:").nth(1)?).split("]").next().map(str__trim).filter(fn(s): (!s.is_empty()))

fn pattern_to_string(pattern: &kain_core::ast::Pattern) -> String:
    match pattern:
        kain_core__ast__Pattern::Wildcard(_) => ("_").to_string()
        kain_core__ast__Pattern::Binding { name: name, mutable_: mutable_ } => if (*mutable_): f"mut {name}" else: name.clone()
        _ => ("_").to_string()

fn expr_to_string(expr: &kain_core::ast::Expr) -> String:
    match expr:
        kain_core__ast__Expr::Int(value, _) => value.to_string()
        kain_core__ast__Expr::Float(value, _) => value.to_string()
        kain_core__ast__Expr::String(value, _) => value
        kain_core__ast__Expr::Bool(value, _) => value.to_string()
        kain_core__ast__Expr::None(_) => ("none").to_string()
        kain_core__ast__Expr::Ident(name, _) => name.clone()
        kain_core__ast__Expr::AsyncBlock(value, _) => f"async {expr_to_string(value)}"
        _ => lossy_marker("unsupported_expr_lowering", "unsupported Rust expression lowered as placeholder", Option::Some("inspect the matching diagnostic in import_report.json and restore the original Rust expression"))

fn type_to_string(ty: &kain_core::ast::Type) -> String:
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } => if generics.is_empty(): name.clone() else: "{name}<{generics.iter().map(type_to_string).collect().join(\", \")}>"
        kain_core__ast__Type::Tuple(types, _) =>
            let types_str = types.iter().map(type_to_string).collect().join(", ")
            f"({types_str})"
        kain_core__ast__Type::Array(inner, _, _) => f"Array<{type_to_string(inner)}>"
        kain_core__ast__Type::Slice(inner, _) => f"Slice<{type_to_string(inner)}>"
        kain_core__ast__Type::Ref { mutable_: mutable_, inner: inner } => if (*mutable_): f"&mut {type_to_string(inner)}" else: f"&{type_to_string(inner)}"
        kain_core__ast__Type::Ptr { mutable_: mutable_, inner: inner } => if (*mutable_): f"PtrMut<{type_to_string(inner)}>" else: f"Ptr<{type_to_string(inner)}>"
        kain_core__ast__Type::Function { params: params, return_type: return_type } => "fn({params.iter().map(type_to_string).collect().join(\", \")}) -> {type_to_string(return_type)}"
        kain_core__ast__Type::Option(inner, _) => f"Option<{type_to_string(inner)}>"
        kain_core__ast__Type::Result(ok, err, _) => f"Result<{type_to_string(ok)}, {type_to_string(err)}>"
        kain_core__ast__Type::Infer(_) => ("_").to_string()
        kain_core__ast__Type::Never(_) => ("!").to_string()
        kain_core__ast__Type::Unit(_) => ("()").to_string()
        kain_core__ast__Type::Impl { trait_name: trait_name, generics: generics } => if generics.is_empty(): f"impl {trait_name}" else: "impl {trait_name}<{generics.iter().map(type_to_string).collect().join(\", \")}>"

fn count_functions(program: &kain_core::ast::Program) -> usize:
    (*program).items.iter().filter(fn(item): none).count()

fn count_structs(program: &kain_core::ast::Program) -> usize:
    (*program).items.iter().filter(fn(item): none).count()

fn count_enums(program: &kain_core::ast::Program) -> usize:
    (*program).items.iter().filter(fn(item): none).count()

