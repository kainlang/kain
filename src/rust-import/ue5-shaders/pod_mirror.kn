use kain_core::ast::Type

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

use std::collections::HashMap

use std::collections::HashSet

@doc(doc = " A single POD-compatible field extracted from a `@component` struct.")
@derive(Debug, Clone)
pub struct PodField:
    name: String
    cpp_type: String
    hlsl_type: String

@doc(doc = " Returns the byte size of an HLSL scalar/vector type.")
@doc(doc = " Used for cbuffer alignment calculations.")
fn hlsl_type_size(hlsl_type: String) -> u32:
    match hlsl_type:
        "float" => 4
        "int" => 4
        "uint" => 4
        "bool" => 4
        "float2" => 8
        "int2" => 8
        "uint2" => 8
        "float3" => 12
        "int3" => 12
        "uint3" => 12
        "float4" => 16
        "int4" => 16
        "uint4" => 16
        "double" => 8
        _ => 4

@doc(doc = " Returns the alignment requirement of an HLSL type in a cbuffer.")
@doc(doc = " HLSL aligns each element to its own size, capped at 4 bytes (float4 = 16).")
fn hlsl_type_align(hlsl_type: String) -> u32:
    hlsl_type_size(hlsl_type).min(16)

@doc(doc = " Compute the padded field layout for a cbuffer struct.")
@doc(doc = " Returns a list of `(field_name, hlsl_type)` entries including any injected")
@doc(doc = " `_paddingN` fields needed to satisfy HLSL cbuffer packing rules.")
@doc(doc = "")
@doc(doc = " HLSL cbuffer rule: a field must not straddle a 16-byte boundary.")
@doc(doc = " If placing a field at the current offset would cross a 16-byte row,")
@doc(doc = " padding is injected to push it to the next row.")
pub fn compute_padded_hlsl_layout(fields: &[PodField]) -> Array<(String, String)>:
    let mut layout: Array<(String, String)> = Vec__new_()
    let mut offset: u32 = 0
    let mut pad_idx: u32 = 0
    @doc(doc = " Emit padding floats to fill `gap_bytes` bytes, updating pad_idx.")
    fn emit_padding(layout: &mut Array<(String, String)>, pad_idx: &mut u32, gap_bytes: u32):
        let mut remaining = gap_bytes
        while (remaining >= 16):
            layout.push((f"_padding{pad_idx}", ("float4").into()))
            ()
            (*pad_idx) = ((*pad_idx) + 1)
            ()
            remaining = (remaining - 16)
            ()
        ()
        match remaining:
            12 =>
                layout.push((f"_padding{pad_idx}", ("float3").into()))
                ()
                (*pad_idx) = ((*pad_idx) + 1)
                ()
            8 =>
                layout.push((f"_padding{pad_idx}", ("float2").into()))
                ()
                (*pad_idx) = ((*pad_idx) + 1)
                ()
            4 =>
                layout.push((f"_padding{pad_idx}", ("float").into()))
                ()
                (*pad_idx) = ((*pad_idx) + 1)
                ()
            0 => ()
            _ =>
                for _ in range(0, ((remaining / 4))):
                    layout.push((f"_padding{pad_idx}", ("float").into()))
                    ()
                    (*pad_idx) = ((*pad_idx) + 1)
                    ()

    for field in fields:
        let size = hlsl_type_size(&field.hlsl_type)
        let align = hlsl_type_align(&field.hlsl_type)
        let aligned_offset = (((((offset + align) - 1)) / align) * align)
        let row_start = ((aligned_offset / 16) * 16)
        let row_end = (row_start + 16)
        let place_offset = if ((aligned_offset + size) > row_end):
            row_end
        else:
            aligned_offset
        if (place_offset > offset):
            emit_padding(&mut layout, &mut pad_idx, (place_offset - offset))
            ()
            ()
            ()
            ()
        layout.push((field.name.clone(), field.hlsl_type.clone()))
        ()
        offset = (place_offset + size)
        ()
    ()
    let remainder = (offset % 16)
    if (remainder != 0):
        emit_padding(&mut layout, &mut pad_idx, (16 - remainder))
        ()
        ()
        ()
        ()
    layout

@doc(doc = " A generated POD mirror struct for a `@component`.")
@derive(Debug, Clone)
pub struct PodMirrorStruct:
    component_name: String
    pod_struct_name: String
    fields: Array<PodField>

impl PodMirrorStruct:
    pub fn generate_cpp_struct(_self: &PodMirrorStruct) -> String:
        let mut out_ = String__new_()
        out_.push_str(&f"// POD mirror for {(*_self).component_name} (GPU-compatible, cbuffer-aligned)\n")
        ()
        out_.push_str(&"struct {(*_self).pod_struct_name} {\n")
        ()
        let cpp_types: Map<String, String> = (*_self).fields.iter().map(fn(f): (f.name.as_str(), f.cpp_type.as_str())).collect()
        let layout = compute_padded_hlsl_layout(&(*_self).fields)
        for selfhost_for_item in &layout:
            let (name, hlsl_type) = selfhost_for_item
            if name.starts_with("_padding"):
                let cpp_pad_type = match hlsl_type.as_str():
                    "float" => "float"
                    "float2" => "FVector2f"
                    "float3" => "FVector3f"
                    "float4" => "FVector4f"
                    _ => "float"
                out_.push_str(&f"    {cpp_pad_type} {name};\n")
                ()
            else:
                let cpp_type = cpp_types.get(name.as_str()).copied().unwrap_or("float")
                out_.push_str(&f"    {cpp_type} {name};\n")
                ()
        ()
        out_.push_str("};\n\n")
        ()
        out_

    pub fn generate_hlsl_struct(_self: &PodMirrorStruct) -> String:
        let mut out_ = String__new_()
        out_.push_str(&f"// POD mirror for {(*_self).component_name} (cbuffer-aligned)\n")
        ()
        out_.push_str(&"struct {(*_self).pod_struct_name} {\n")
        ()
        let layout = compute_padded_hlsl_layout(&(*_self).fields)
        for selfhost_for_item in &layout:
            let (name, hlsl_type) = selfhost_for_item
            out_.push_str(&f"    {hlsl_type} {name};\n")
            ()
        ()
        out_.push_str("};\n\n")
        ()
        out_

    pub fn generate_population_code(_self: &PodMirrorStruct, component_var: String, pod_var: String, indent: String) -> String:
        let mut out_ = String__new_()
        out_.push_str(&"{indent}{(*_self).pod_struct_name} {pod_var} {};\n")
        ()
        if (component_var != "nullptr"):
            out_.push_str(&"{indent}if ({component_var} != nullptr) {\n")
            ()
            for field in &(*_self).fields:
                out_.push_str(&f"{indent}    {pod_var}.{field.name} = static_cast<{field.cpp_type}>({component_var}->{field.name});\n")
                ()
            ()
            out_.push_str(&"{indent}}\n")
            ()
            ()
            ()
            ()
        out_


@doc(doc = " Map a KAIN AST `Type` to `(cpp_type, hlsl_type)` for POD generation.")
@doc(doc = " Returns `None` for any non-POD type (Arrays, generic types, nested structs")
@doc(doc = " that are not known enums, etc.).")
fn map_field_to_pod_types(ty: &kain_core::ast::Type, enum_names: &Set<String>) -> Option<(String, String)>:
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } if generics.is_empty() =>
            match name.as_str():
                "Float" => Option::Some((("float").into(), ("float").into()))
                "f32" => Option::Some((("float").into(), ("float").into()))
                "Double" => Option::Some((("double").into(), ("double").into()))
                "f64" => Option::Some((("double").into(), ("double").into()))
                "Int" => Option::Some((("int32").into(), ("int").into()))
                "i32" => Option::Some((("int32").into(), ("int").into()))
                "i64" => Option::Some((("int32").into(), ("int").into()))
                "UInt" => Option::Some((("uint32").into(), ("uint").into()))
                "u32" => Option::Some((("uint32").into(), ("uint").into()))
                "u64" => Option::Some((("uint32").into(), ("uint").into()))
                "Bool" => Option::Some((("bool").into(), ("bool").into()))
                "Vec2" => Option::Some((("FVector2f").into(), ("float2").into()))
                "Vec3" => Option::Some((("FVector3f").into(), ("float3").into()))
                "Vec4" => Option::Some((("FVector4f").into(), ("float4").into()))
                other => if enum_names.contains(other): Option::Some((f"E{other}", ("int").into())) else: none
        _ => none

@doc(doc = " Collect POD mirror structs for every `@component` type in `program` that is")
@doc(doc = " referenced by at least one shader uniform.")
@doc(doc = "")
@doc(doc = " # Errors")
@doc(doc = " Returns `Err(message)` if any shader-used component has **zero** extractable")
@doc(doc = " POD fields (nothing to generate — hard error so the caller can surface a")
@doc(doc = " diagnostic).")
pub fn collect_component_mirrors(program: &kain_core::types::TypedProgram) -> Result<Map<String, PodMirrorStruct>, String>:
    let enum_names: Set<String> = (*program).items.iter().filter_map(fn(item): none).collect()
    let mut all_mirrors: Map<String, PodMirrorStruct> = HashMap__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(st) =>
                let is_component = st.ast.attributes.iter().any(fn(a): (a.name == "component"))
                if (!is_component):
                    continue
                let mut fields = Vec__new_()
                for field in &st.ast.fields:
                    match map_field_to_pod_types(&field.ty, &enum_names):
                        Some((cpp_type, hlsl_type)) =>
                            fields.push(PodField { name: field.name.clone(), cpp_type: cpp_type, hlsl_type: hlsl_type })
                            ()
                        _ => ()
                ()
                all_mirrors.insert(st.ast.name.clone(), PodMirrorStruct { component_name: st.ast.name.clone(), pod_struct_name: f"F{st.ast.name}Data", fields: fields })
                ()
            _ => ()
    ()
    let mut used: Set<String> = HashSet__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Shader(shader_) =>
                for uniform_ in &shader_.ast.uniforms:
                    match &uniform_.ty:
                        kain_core__ast__Type::Named { name: name, generics: generics } =>
                            if (generics.is_empty() && all_mirrors.contains_key(name.as_str())):
                                used.insert(name.clone())
                                ()
                        _ => ()
            _ => ()
    ()
    for comp_name in &used:
        match all_mirrors.get(comp_name):
            Some(mirror) =>
                if mirror.fields.is_empty():
                    return Result::Err(f"Component '{comp_name}' is used as a shader uniform but has no GPU-compatible (POD) fields. Only primitive types, vectors, and enums can cross the CPU/GPU boundary.")
            _ => ()
    ()
    Result::Ok(all_mirrors.into_iter().filter(fn(__kain_closure_arg0): used.contains(__kain_closure_arg0.__kain_tuple_0)).collect())

