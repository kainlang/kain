use once_cell::sync::Lazy

use std::collections::HashMap

@doc(doc = " TypeMapper provides a single source of truth for KAIN→HLSL type mappings.")
@doc(doc = " This ensures the validator and codegen use the same type definitions,")
@doc(doc = " eliminating false-positive validation errors and maintenance burden.")
@doc(doc = "")
@doc(doc = " # Design Rationale")
@doc(doc = " Previously, the validator maintained a hardcoded allowlist separate from")
@doc(doc = " the codegen type mapping table. When new KAIN type aliases were added to")
@doc(doc = " codegen (UVec2, UInt, Mat4, IVec2), the validator would reject them as")
@doc(doc = " invalid even though codegen correctly mapped them to HLSL types.")
@doc(doc = "")
@doc(doc = " With TypeMapper, adding a new type requires only one entry in the mappings")
@doc(doc = " HashMap, and both validator and codegen automatically use it.")
pub struct TypeMapper:
    mappings: Map<String, String>

impl TypeMapper:
    pub fn new_() -> TypeMapper:
        let mut mappings = HashMap__new_()
        mappings.insert(("Float").to_string(), ("float").to_string())
        ()
        mappings.insert(("Int").to_string(), ("int").to_string())
        ()
        mappings.insert(("UInt").to_string(), ("uint").to_string())
        ()
        mappings.insert(("Bool").to_string(), ("bool").to_string())
        ()
        mappings.insert(("Vec2").to_string(), ("float2").to_string())
        ()
        mappings.insert(("Vec3").to_string(), ("float3").to_string())
        ()
        mappings.insert(("Vec4").to_string(), ("float4").to_string())
        ()
        mappings.insert(("IVec2").to_string(), ("int2").to_string())
        ()
        mappings.insert(("IVec3").to_string(), ("int3").to_string())
        ()
        mappings.insert(("IVec4").to_string(), ("int4").to_string())
        ()
        mappings.insert(("UVec2").to_string(), ("uint2").to_string())
        ()
        mappings.insert(("UVec3").to_string(), ("uint3").to_string())
        ()
        mappings.insert(("UVec4").to_string(), ("uint4").to_string())
        ()
        mappings.insert(("Mat2").to_string(), ("float2x2").to_string())
        ()
        mappings.insert(("Mat3").to_string(), ("float3x3").to_string())
        ()
        mappings.insert(("Mat4").to_string(), ("float4x4").to_string())
        ()
        mappings.insert(("Sampler2D").to_string(), ("Texture2D").to_string())
        ()
        mappings.insert(("Sampler3D").to_string(), ("Texture3D").to_string())
        ()
        mappings.insert(("SamplerCube").to_string(), ("TextureCube").to_string())
        ()
        mappings.insert(("RWBuffer").to_string(), ("RWBuffer").to_string())
        ()
        mappings.insert(("RWTexture2D").to_string(), ("RWTexture2D").to_string())
        ()
        mappings.insert(("RWTexture3D").to_string(), ("RWTexture3D").to_string())
        ()
        TypeMapper { mappings: mappings }

    pub fn can_map(_self: &TypeMapper, kain_type: String) -> Bool:
        (*_self).mappings.contains_key(kain_type)

    pub fn map_to_hlsl(_self: &TypeMapper, kain_type: String) -> Option<String>:
        (*_self).mappings.get(kain_type).cloned()

    pub fn valid_types(_self: &TypeMapper) -> Array<String>:
        let mut types: Array<String> = (*_self).mappings.keys().cloned().collect()
        types.sort()
        ()
        types


impl Default for TypeMapper:
    fn default_() -> TypeMapper:
        TypeMapper__new_()


pub const TYPE_MAPPER: TypeMapper = TypeMapper__new_()

