use serde::Deserialize

use serde::Serialize

use ue5_asset_utils::KainEngineTarget

use ue5_asset_utils::PropertyDef

use ue5_asset_utils::PropertyValue

@doc(doc = " A component attached to a Blueprint via the SimpleConstructionScript.")
@doc(doc = " Maps to a `USCS_Node` in the .uasset.")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct ComponentDef:
    class_name: String
    variable_name: String
    attach_parent: Option<String>
    defaults: Array<ue5_asset_utils::PropertyDef>

impl ComponentDef:
    pub fn new_(class_name: impl Into<String>, variable_name: impl Into<String>) -> ComponentDef:
        ComponentDef { class_name: class_name.into(), variable_name: variable_name.into(), attach_parent: none, defaults: Vec__new_() }

    pub fn with_parent(_self: ComponentDef, parent: impl Into<String>) -> ComponentDef:
        _self.attach_parent = Option::Some(parent.into())
        ()
        _self

    pub fn with_default(_self: ComponentDef, prop: ue5_asset_utils::PropertyDef) -> ComponentDef:
        _self.defaults.push(prop)
        ()
        _self


@doc(doc = " A simple function call node in the event graph.")
@doc(doc = " Phase 1: supports calling C++ functions exposed to Blueprints.")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct KismetCall:
    function_name: String
    target: Option<String>
    is_pure: Bool

impl KismetCall:
    pub fn function(name: impl Into<String>) -> KismetCall:
        KismetCall { function_name: name.into(), target: none, is_pure: false }

    pub fn on(_self: KismetCall, target: impl Into<String>) -> KismetCall:
        _self.target = Option::Some(target.into())
        ()
        _self

    pub fn pure(_self: KismetCall) -> KismetCall:
        _self.is_pure = true
        ()
        _self


pub enum EventGraphNode:
    BeginPlay { calls: Array<KismetCall> }
    Tick { calls: Array<KismetCall> }
    CustomEvent { event_name: String, calls: Array<KismetCall> }

impl EventGraphNode:
    pub fn begin_play(calls: Array<KismetCall>) -> EventGraphNode:
        EventGraphNode::BeginPlay { calls: calls }

    pub fn tick(calls: Array<KismetCall>) -> EventGraphNode:
        EventGraphNode::Tick { calls: calls }

    pub fn custom(event_name: impl Into<String>, calls: Array<KismetCall>) -> EventGraphNode:
        EventGraphNode::CustomEvent { event_name: event_name.into(), calls: calls }


@doc(doc = " The complete data-driven description of a Blueprint asset KAIN will generate.")
@doc(doc = " Consumed by both:")
@doc(doc = "   - `BlueprintBinaryWriter`  → writes real .uasset bytes (no editor needed)")
@doc(doc = "   - `BlueprintFactoryWriter` → writes C++ factory code (editor-startup fallback)")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct BlueprintDef:
    name: String
    package_path: String
    parent_class: String
    components: Array<ComponentDef>
    defaults: Array<ue5_asset_utils::PropertyDef>
    event_graph: Array<EventGraphNode>
    engine_version: BlueprintEngineVersion

pub type BlueprintEngineVersion = ue5_asset_utils::KainEngineTarget

impl BlueprintDef:
    pub fn new_(name: impl Into<String>, package_path: impl Into<String>, parent_class: impl Into<String>) -> BlueprintDef:
        BlueprintDef { name: name.into(), package_path: package_path.into(), parent_class: parent_class.into(), components: Vec__new_(), defaults: Vec__new_(), event_graph: Vec__new_(), engine_version: BlueprintEngineVersion__default_() }

    pub fn asset_path(_self: &BlueprintDef) -> String:
        f"{(*_self).package_path}/{(*_self).name}"

    pub fn generated_class_path(_self: &BlueprintDef) -> String:
        f"{(*_self).package_path}/{(*_self).name}.{(*_self).name}_C"

    pub fn with_engine_version(_self: BlueprintDef, v: BlueprintEngineVersion) -> BlueprintDef:
        _self.engine_version = v
        ()
        _self

    pub fn add_component(_self: BlueprintDef, comp: ComponentDef) -> BlueprintDef:
        _self.components.push(comp)
        ()
        _self

    pub fn add_default(_self: BlueprintDef, prop: ue5_asset_utils::PropertyDef) -> BlueprintDef:
        _self.defaults.push(prop)
        ()
        _self

    pub fn add_event(_self: BlueprintDef, node: EventGraphNode) -> BlueprintDef:
        _self.event_graph.push(node)
        ()
        _self


