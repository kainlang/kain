use kain_core::ast::Struct

use kain_core::ast::Type

use kain_core::types::TypedStruct

pub struct ViewportGenerator:
    lines: Array<String>
    indent: usize

impl ViewportGenerator:
    pub fn new_() -> ViewportGenerator:
        ViewportGenerator { lines: Vec__new_(), indent: 0 }

    pub fn generate_viewport(_self: &mut ViewportGenerator, st: &kain_core::types::TypedStruct) -> (String, String):
        let viewport_name = &(*st).ast.name
        let widget_class = f"S{viewport_name}"
        let client_class = f"F{viewport_name}Client"
        let header = (*_self).generate_header(&(*st).ast, &widget_class, &client_class)
        let source = (*_self).generate_source(&(*st).ast, &widget_class, &client_class)
        (header, source)

    fn generate_header(_self: &mut ViewportGenerator, st: &kain_core::ast::Struct, widget_class: String, client_class: String) -> String:
        (*_self).lines.clear()
        ()
        (*_self).indent = 0
        ()
        let has_preview_mesh = (*st).fields.iter().any(fn(f): f.attributes.iter().any(fn(a): (a.name == "preview_mesh")))
        let has_camera = (*st).fields.iter().any(fn(f): f.attributes.iter().any(fn(a): (a.name == "camera")))
        (*_self).push_line(&f"class {widget_class};")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"class {client_class} : public FEditorViewportClient")
        ()
        (*_self).push_line("{")
        ()
        (*_self).push_line("public:")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line(&f"{client_class}(FPreviewScene* InPreviewScene, const TSharedRef<{widget_class}>& InViewportWidget);")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("virtual void Tick(float DeltaSeconds) override;")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("virtual void ProcessClick(FSceneView& View, HHitProxy* HitProxy, FKey Key, EInputEvent Event, uint32 HitX, uint32 HitY) override;")
        ()
        (*_self).push_line("")
        ()
        for method in &(*st).methods:
            let params = method.params.iter().map(fn(p): f"{(*_self).map_type(&p.ty)} {p.name}").collect().join(", ")
            (*_self).push_line(&f"void {method.name}({params});")
            ()
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("private:")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        if has_preview_mesh:
            (*_self).push_line("UStaticMeshComponent* PreviewMeshComponent;")
            ()
            ()
            ()
            ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("};")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"class {widget_class} : public SEditorViewport")
        ()
        (*_self).push_line("{")
        ()
        (*_self).push_line("public:")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line(&"SLATE_BEGIN_ARGS({widget_class}) {}")
        ()
        (*_self).push_line("SLATE_END_ARGS()")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("void Construct(const FArguments& InArgs);")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("virtual TSharedRef<FEditorViewportClient> MakeEditorViewportClient() override;")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&"TSharedPtr<{client_class}> GetViewportClient() const { return ViewportClient; }")
        ()
        (*_self).push_line("FPreviewScene* GetPreviewScene() const { return PreviewScene.Get(); }")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("private:")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line(&f"TSharedPtr<{client_class}> ViewportClient;")
        ()
        (*_self).push_line("TSharedPtr<FPreviewScene> PreviewScene;")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("};")
        ()
        (*_self).lines.join("\n")

    fn generate_source(_self: &mut ViewportGenerator, st: &kain_core::ast::Struct, widget_class: String, client_class: String) -> String:
        (*_self).lines.clear()
        ()
        (*_self).indent = 0
        ()
        let has_preview_mesh = (*st).fields.iter().any(fn(f): f.attributes.iter().any(fn(a): (a.name == "preview_mesh")))
        (*_self).push_line(&f"void {widget_class}::Construct(const FArguments& InArgs)")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("PreviewScene = MakeShareable(new FPreviewScene(FPreviewScene::ConstructionValues()));")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("SEditorViewport::Construct(SEditorViewport::FArguments());")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"TSharedRef<FEditorViewportClient> {widget_class}::MakeEditorViewportClient()")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line(&f"ViewportClient = MakeShareable(new {client_class}(PreviewScene.Get(), SharedThis(this)));")
        ()
        (*_self).push_line("return ViewportClient.ToSharedRef();")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"{client_class}::{client_class}(FPreviewScene* InPreviewScene, const TSharedRef<{widget_class}>& InViewportWidget)")
        ()
        (*_self).push_line(&"\t: FEditorViewportClient(nullptr, InPreviewScene, StaticCastSharedRef<SEditorViewport>(InViewportWidget))")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("SetViewLocation(FVector(-200.0f, 0.0f, 100.0f));")
        ()
        (*_self).push_line("SetViewRotation(FRotator(-15.0f, 0.0f, 0.0f));")
        ()
        (*_self).push_line("SetRealtime(true);")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("// Setup default lighting via preview scene")
        ()
        (*_self).push_line("if (InPreviewScene)")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("InPreviewScene->SetLightDirection(FRotator(-45.0f, 30.0f, 0.0f));")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        if has_preview_mesh:
            (*_self).push_line("")
            ()
            (*_self).push_line("// Preview mesh initialization")
            ()
            (*_self).push_line("PreviewMeshComponent = NewObject<UStaticMeshComponent>();")
            ()
            (*_self).push_line("InPreviewScene->AddComponent(PreviewMeshComponent, FTransform::Identity);")
            ()
            ()
            ()
            ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"void {client_class}::Tick(float DeltaSeconds)")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("FEditorViewportClient::Tick(DeltaSeconds);")
        ()
        (*_self).push_line("Invalidate();")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"void {client_class}::ProcessClick(FSceneView& View, HHitProxy* HitProxy, FKey Key, EInputEvent Event, uint32 HitX, uint32 HitY)")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("FEditorViewportClient::ProcessClick(View, HitProxy, Key, Event, HitX, HitY);")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        for method in &(*st).methods:
            let params = method.params.iter().map(fn(p): f"{(*_self).map_type(&p.ty)} {p.name}").collect().join(", ")
            (*_self).push_line(&f"void {client_class}::{method.name}({params})")
            ()
            (*_self).push_line("{")
            ()
            (*_self).indent = ((*_self).indent + 1)
            ()
            if (method.name.starts_with("Set") || method.name.starts_with("Update")):
                (*_self).push_line("// Update viewport state")
                ()
                (*_self).push_line("Invalidate();")
                ()
                ()
                ()
                ()
            elif (method.name.starts_with("Get") || method.name.starts_with("Query")):
                (*_self).push_line("// Query viewport state")
                ()
                match &method.return_type:
                    Some(ret_ty) =>
                        let cpp_type = (*_self).map_type(ret_ty)
                        if cpp_type.contains("bool"):
                            (*_self).push_line("return false;")
                            ()
                            ()
                            ()
                            ()
                        elif (cpp_type.contains("int") || cpp_type.contains("float")):
                            (*_self).push_line("return 0;")
                            ()
                            ()
                            ()
                            ()
                        elif cpp_type.contains("FVector"):
                            (*_self).push_line("return FVector::ZeroVector;")
                            ()
                            ()
                            ()
                            ()
                        elif cpp_type.contains("FRotator"):
                            (*_self).push_line("return FRotator::ZeroRotator;")
                            ()
                            ()
                            ()
                            ()
                        else:
                            (*_self).push_line(&f"return {cpp_type}();")
                            ()
                            ()
                            ()
                            ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            else:
                (*_self).push_line("// Custom viewport operation")
                ()
                (*_self).push_line("Invalidate();")
                ()
                ()
                ()
                ()
            (*_self).indent = ((*_self).indent - 1)
            ()
            (*_self).push_line("}")
            ()
            (*_self).push_line("")
            ()
        ()
        (*_self).lines.join("\n")

    fn map_type(_self: &ViewportGenerator, ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name } =>
                match name.as_str():
                    "Int" => ("int32").to_string()
                    "int" => ("int32").to_string()
                    "Float" => ("float").to_string()
                    "float" => ("float").to_string()
                    "Bool" => ("bool").to_string()
                    "bool" => ("bool").to_string()
                    "String" => ("FString").to_string()
                    "str" => ("FString").to_string()
                    "Text" => ("FText").to_string()
                    "Name" => ("FName").to_string()
                    "Vec2" => ("FVector2D").to_string()
                    "Vec3" => ("FVector").to_string()
                    "Vector" => ("FVector").to_string()
                    "Vec4" => ("FVector4").to_string()
                    "Rot" => ("FRotator").to_string()
                    "Rotator" => ("FRotator").to_string()
                    "Quat" => ("FQuat").to_string()
                    "Transform" => ("FTransform").to_string()
                    "Color" => ("FLinearColor").to_string()
                    "LinearColor" => ("FLinearColor").to_string()
                    "StaticMesh" => ("UStaticMesh*").to_string()
                    "Material" => ("UMaterialInterface*").to_string()
                    "MyMaterial" => ("UMaterialInterface*").to_string()
                    _ =>
                        if name.ends_with("World"):
                            return ("UObject*").to_string()
                        if (((((name.starts_with("F") || name.starts_with("U")) || name.starts_with("A")) || name.starts_with("E")) || name.starts_with("I")) || name.starts_with("T")):
                            name.clone()
                        else:
                            f"F{name}"
            _ => ("auto").to_string()

    fn push_line(_self: &mut ViewportGenerator, line_: String):
        let indent_str = ("\t").repeat((*_self).indent)
        (*_self).lines.push(f"{indent_str}{line_}")
        ()


