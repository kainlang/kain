use crate::AppliedFix

use crate::RepairMode

use crate::RepairProfile

pub enum RuleSafety:
    Safe
    Aggressive

pub enum RuleScope:
    Generic
    ProfileSensitive
    Code
    Class

@derive(Debug, Clone, Copy, PartialEq, Eq)
pub struct RuleMetadata:
    id: String
    kind: FixKind
    safety: RuleSafety
    scope: RuleScope

@derive(Debug, Clone, Copy, PartialEq, Eq)
pub struct RepairRule:
    metadata: RuleMetadata
    enabled_in_apply_safe: Bool
    enabled_in_apply_aggressive: Bool
    enabled_in_dry_run: Bool
    enabled_in_suggest: Bool
    profile_gate: fn(&RepairProfile) -> Bool
    apply: fn(String, RepairMode) -> Option<(String, AppliedFix)>

pub fn registry() -> &static [RepairRule]:
    &RULES

pub fn selected_rules(profile: &RepairProfile, mode: RepairMode) -> Array<&static RepairRule>:
    registry().iter().filter(fn(rule): rule.profile_gate(profile)).filter(fn(rule): none).collect()

fn line_endings(_: &RepairProfile) -> Bool:
    true

fn trailing_whitespace(_: &RepairProfile) -> Bool:
    true

fn blank_lines(_: &RepairProfile) -> Bool:
    true

fn block_comments(profile: &RepairProfile) -> Bool:
    (*profile).fix_unterminated_block_comments

fn indentation(profile: &RepairProfile) -> Bool:
    (*profile).normalize_indentation

fn declaration_headers(profile: &RepairProfile) -> Bool:
    (*profile).normalize_declaration_headers

fn flatten_nested_declarations(profile: &RepairProfile) -> Bool:
    (*profile).flatten_nested_declarations

fn reserved_identifiers(profile: &RepairProfile) -> Bool:
    (*profile).rewrite_reserved_identifiers

fn self_ctor(profile: &RepairProfile) -> Bool:
    (*profile).normalize_self_constructor_syntax

fn inline_initializers(profile: &RepairProfile) -> Bool:
    (*profile).rewrite_inline_initializers

fn namespace_paths(profile: &RepairProfile) -> Bool:
    (*profile).normalize_namespace_paths

fn parser_safe_blocks(profile: &RepairProfile) -> Bool:
    (*profile).reconstruct_parser_safe_blocks

const RULES: [RepairRule; 12] = [RepairRule { metadata: RuleMetadata { id: "normalize_line_endings", kind: FixKind__NormalizeLineEndings, safety: RuleSafety__Safe, scope: RuleScope__Generic }, enabled_in_apply_safe: true, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: line_endings, apply: engine__apply_normalize_line_endings }, RepairRule { metadata: RuleMetadata { id: "trim_trailing_whitespace", kind: FixKind__TrimTrailingWhitespace, safety: RuleSafety__Safe, scope: RuleScope__Generic }, enabled_in_apply_safe: true, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: trailing_whitespace, apply: engine__apply_trim_trailing_whitespace }, RepairRule { metadata: RuleMetadata { id: "collapse_extra_blank_lines", kind: FixKind__CollapseExtraBlankLines, safety: RuleSafety__Safe, scope: RuleScope__Generic }, enabled_in_apply_safe: true, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: blank_lines, apply: engine__apply_collapse_extra_blank_lines }, RepairRule { metadata: RuleMetadata { id: "close_unterminated_block_comment", kind: FixKind__CloseUnterminatedBlockComment, safety: RuleSafety__Safe, scope: RuleScope__Class }, enabled_in_apply_safe: true, enabled_in_apply_aggressive: true, enabled_in_dry_run: false, enabled_in_suggest: true, profile_gate: block_comments, apply: engine__apply_close_unterminated_block_comment }, RepairRule { metadata: RuleMetadata { id: "normalize_indentation", kind: FixKind__NormalizeIndentation, safety: RuleSafety__Safe, scope: RuleScope__Code }, enabled_in_apply_safe: true, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: indentation, apply: engine__apply_normalize_indentation }, RepairRule { metadata: RuleMetadata { id: "normalize_declaration_headers", kind: FixKind__NormalizeDeclarationHeader, safety: RuleSafety__Safe, scope: RuleScope__Class }, enabled_in_apply_safe: true, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: declaration_headers, apply: engine__apply_normalize_declaration_headers }, RepairRule { metadata: RuleMetadata { id: "flatten_nested_declaration_placement", kind: FixKind__FlattenNestedDeclarationPlacement, safety: RuleSafety__Safe, scope: RuleScope__Class }, enabled_in_apply_safe: true, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: flatten_nested_declarations, apply: engine__apply_flatten_nested_declaration_placement }, RepairRule { metadata: RuleMetadata { id: "rewrite_reserved_identifiers", kind: FixKind__RewriteReservedIdentifier, safety: RuleSafety__Aggressive, scope: RuleScope__Class }, enabled_in_apply_safe: false, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: reserved_identifiers, apply: engine__apply_rewrite_reserved_identifiers }, RepairRule { metadata: RuleMetadata { id: "normalize_self_constructor_syntax", kind: FixKind__NormalizeSelfConstructorSyntax, safety: RuleSafety__Aggressive, scope: RuleScope__Code }, enabled_in_apply_safe: false, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: self_ctor, apply: engine__apply_normalize_self_constructor_syntax }, RepairRule { metadata: RuleMetadata { id: "rewrite_inline_initializers", kind: FixKind__RewriteInlineInitialization, safety: RuleSafety__Aggressive, scope: RuleScope__ProfileSensitive }, enabled_in_apply_safe: false, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: inline_initializers, apply: engine__apply_rewrite_inline_initializers }, RepairRule { metadata: RuleMetadata { id: "normalize_namespace_paths", kind: FixKind__NormalizeNamespacePath, safety: RuleSafety__Aggressive, scope: RuleScope__ProfileSensitive }, enabled_in_apply_safe: false, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: namespace_paths, apply: engine__apply_normalize_namespace_paths }, RepairRule { metadata: RuleMetadata { id: "reconstruct_parser_safe_blocks", kind: FixKind__ReconstructParserSafeBlock, safety: RuleSafety__Aggressive, scope: RuleScope__Code }, enabled_in_apply_safe: false, enabled_in_apply_aggressive: true, enabled_in_dry_run: true, enabled_in_suggest: true, profile_gate: parser_safe_blocks, apply: engine__apply_reconstruct_parser_safe_blocks }]

