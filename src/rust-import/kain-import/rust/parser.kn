use crate::ImportError

use crate::Result

use std::path::Path

use syn::File

@doc(doc = " Parse Rust source text into a `syn::File` AST.")
@doc(doc = "")
@doc(doc = " All syntax errors are converted to `ImportError::RustParseError`")
@doc(doc = " with the file path included for diagnostics.")
pub fn parse_rust(source: String, path: &std::path::Path) -> Result<syn::File, Error>:
    syn__parse_file(source).map_err(fn(e): ImportError::RustParseError(f"{path.display()}: {e}"))

