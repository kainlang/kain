use selfhost::import_rust_selfhost_dir

use selfhost::import_rust_selfhost_dir_detailed

use selfhost::RustCrateGraph

use selfhost::RustModuleNode

use selfhost::RustSelfHostImportResult

use selfhost::RustSelfHostModuleProgram

use selfhost::RustSelfHostOptions

use transformer::RustTransformer

use crate::ImportError

use crate::Result

use kain_core::ast::Program

use std::path::Path

@doc(doc = " Import a single Rust source file into KAIN AST.")
@doc(doc = "")
@doc(doc = " # Example")
@doc(doc = " ```bash")
@doc(doc = " kain import-rust ./crates/kain-core/src/lib.rs --output kain-core.kn")
@doc(doc = " ```")
pub fn import_rust_file(path: &std::path::Path) -> Result<kain_core::ast::Program, Error>:
    let source = std__fs__read_to_string(path).map_err(ImportError__IoError)?
    import_rust_source(&source, path)

@doc(doc = " Import a single Rust source file and return diagnostics.")
pub fn import_rust_file_detailed(path: &std::path::Path) -> Result<(kain_core::ast::Program, Array<String>), Error>:
    let source = std__fs__read_to_string(path).map_err(ImportError__IoError)?
    import_rust_source_detailed(&source, path)

@doc(doc = " Import Rust source from a string (useful for testing and REPL use).")
pub fn import_rust_source(source: String, path: &std::path::Path) -> Result<kain_core::ast::Program, Error>:
    import_rust_source_detailed(source, path).map(fn(__kain_closure_arg0): __kain_closure_arg0.__kain_tuple_0)

@doc(doc = " Import Rust source from a string and return diagnostics.")
pub fn import_rust_source_detailed(source: String, path: &std::path::Path) -> Result<(kain_core::ast::Program, Array<String>), Error>:
    let file = parser__parse_rust(source, path)?
    let mut tx = RustTransformer__new_()
    let program = tx.transform(file)?
    Result::Ok((program, tx.diagnostics))

@doc(doc = " Import multiple Rust files into a single merged KAIN program (flat mode).")
@doc(doc = "")
@doc(doc = " All symbols land in top-level scope. Use this for self-hosting imports")
@doc(doc = " where you want the entire compiler in one `.kn` file.")
pub fn import_rust_project(paths: &[&std::path::Path]) -> Result<kain_core::ast::Program, Error>:
    import_rust_project_detailed(paths).map(fn(__kain_closure_arg1): __kain_closure_arg1.__kain_tuple_0)

@doc(doc = " Import multiple Rust files into a single merged KAIN program and return diagnostics.")
pub fn import_rust_project_detailed(paths: &[&std::path::Path]) -> Result<(kain_core::ast::Program, Array<String>), Error>:
    let mut all_items = Vec__new_()
    let mut diagnostics = Vec__new_()
    let span = Span__default_()
    for path in paths:
        let source = std__fs__read_to_string(path).map_err(ImportError__IoError)?
        let file = parser__parse_rust(&source, path)?
        let mut tx = RustTransformer__new_()
        let program = tx.transform(file)?
        all_items.extend(program.items)
        ()
        diagnostics.extend(tx.diagnostics)
        ()
    ()
    Result::Ok((kain_core::ast::Program { items: all_items, span: span }, diagnostics))

@doc(doc = " Recursively collect and import all `.rs` files under a directory.")
@doc(doc = "")
@doc(doc = " `flat = true`  → all symbols merged into one top-level scope (for self-hosting)")
@doc(doc = " `flat = false` → each file wrapped in a `mod <name>:` block")
pub fn import_rust_dir(dir: &std::path::Path, flat: Bool) -> Result<kain_core::ast::Program, Error>:
    import_rust_dir_detailed(dir, flat).map(fn(__kain_closure_arg2): __kain_closure_arg2.__kain_tuple_0)

@doc(doc = " Import a Rust directory and return diagnostics.")
pub fn import_rust_dir_detailed(dir: &std::path::Path, flat: Bool) -> Result<(kain_core::ast::Program, Array<String>), Error>:
    let files = collect_rust_files(dir)?
    let paths: Array<&std::path::Path> = files.iter().map(fn(p): p.as_path()).collect()
    if flat:
        import_rust_project_detailed(&paths)
    else:
        import_rust_project_modular_detailed(&paths)

@doc(doc = " Import with per-file module wrapping (mirrors Rust's directory/module layout).")
fn import_rust_project_modular_detailed(paths: &[&std::path::Path]) -> Result<(kain_core::ast::Program, Array<String>), Error>:
    let mut top_items = Vec__new_()
    let mut diagnostics = Vec__new_()
    let span = Span__default_()
    for path in paths:
        let source = std__fs__read_to_string(path).map_err(ImportError__IoError)?
        let file = parser__parse_rust(&source, path)?
        let mut tx = RustTransformer__new_()
        let program = tx.transform(file)?
        diagnostics.extend(tx.diagnostics)
        ()
        let module_path = module_path_for_file(path)
        if module_path.is_empty():
            top_items.extend(program.items)
            ()
        else:
            top_items.push(build_nested_module(&module_path, program.items))
            ()
    ()
    Result::Ok((kain_core::ast::Program { items: top_items, span: span }, diagnostics))

fn module_path_for_file(path: &std::path::Path) -> Array<String>:
    let mut parts = Vec__new_()
    let file_name = path.file_name().and_then(fn(s): s.to_str()).unwrap_or("")
    if (none):
        return Vec__new_()
    match path.parent():
        Some(parent) =>
            for component_ in parent.components():
                let part = sanitize_module_component(&component_.as_os_str().to_string_lossy())
                if (!part.is_empty()):
                    parts.push(part)
                    ()
            ()
            ()
        _ =>
            ()
            ()
    let file_stem = path.file_stem().and_then(fn(s): s.to_str()).unwrap_or("module")
    if (!(((file_name == "mod.rs") && (!parts.is_empty())))):
        let leaf = sanitize_module_component(file_stem)
        if (!leaf.is_empty()):
            parts.push(leaf)
            ()
            ()
            ()
            ()
        ()
    if parts.is_empty():
        parts.push(("module").to_string())
        ()
        ()
        ()
        ()
    parts

fn sanitize_module_component(raw: String) -> String:
    let mut name = raw.chars().map(fn(ch): if ch.is_ascii_alphanumeric(): ch.to_ascii_lowercase() else: "_").collect()
    while name.contains("__"):
        name = name.replace("__", "_")
        ()
    ()
    name = name.trim_matches("_").to_string()
    ()
    if name.is_empty():
        return ("module").to_string()
    if name.chars().next().is_some_and(fn(c): c.is_ascii_digit()):
        return f"m_{name}"
    name

fn build_nested_module(path: &[String], items: Array<kain_core::ast::Item>) -> kain_core::ast::Item:
    let mut current = items
    for name in path.iter().rev():
        current = [kain_core__ast__Item::Mod(kain_core::ast::Mod { name: name.clone(), inline_: Option::Some(current), visibility: kain_core__ast__Visibility__Public, span: Span__default_() })]
        ()
    ()
    current.into_iter().next().expect("nested module wrapper")

fn collect_rust_files(dir: &std::path::Path) -> Result<Array<path::PathBuf>, Error>:
    let mut files = Vec__new_()
    collect_rust_files_into(dir, &mut files)?
    ()
    files.sort()
    ()
    Result::Ok(files)

fn collect_rust_files_into(dir: &std::path::Path, files: &mut Array<path::PathBuf>) -> Result<(), Error>:
    for entry in (std__fs__read_dir(dir).map_err(ImportError__IoError)?):
        let entry = entry.map_err(ImportError__IoError)?
        let path = entry.path()
        if path.is_dir():
            collect_rust_files_into(&path, files)?
            ()
        elif (path.extension().and_then(fn(e): e.to_str()) == Option::Some("rs")):
            files.push(path)
            ()
    ()
    Result::Ok(())

