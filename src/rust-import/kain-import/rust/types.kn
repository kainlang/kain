use kain_core::ast::PointerProvenance

use kain_core::ast::Type

use kain_core::span::Span

use std::collections::HashMap

pub struct RustTypeMapper:
    visible_paths: Map<String, Array<String>>
    preserve_wrapper_types: Bool

impl RustTypeMapper:
    pub fn new_() -> RustTypeMapper:
        RustTypeMapper { visible_paths: HashMap__new_(), preserve_wrapper_types: false }

    pub fn new_selfhost() -> RustTypeMapper:
        RustTypeMapper { visible_paths: HashMap__new_(), preserve_wrapper_types: true }

    pub fn register_visible_path(_self: &mut RustTypeMapper, visible_name: impl Into<String>, full_path: Array<String>):
        (*_self).visible_paths.insert(visible_name.into(), full_path)
        ()

    pub fn resolve_path_segments(_self: &RustTypeMapper, path: &syn::Path) -> Array<String>:
        let mut segments = (*_self).normalize_path_segments(path)
        match segments.first().cloned():
            Some(first) =>
                match (*_self).visible_paths.get(&first):
                    Some(expanded) =>
                        let mut resolved = expanded.clone()
                        resolved.extend(segments.drain(range(1, 0)))
                        ()
                        return resolved
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        segments

    pub fn resolve_value_path_segments(_self: &RustTypeMapper, path: &syn::Path) -> Array<String>:
        let mut segments = (*_self).collect_path_segments(path)
        match segments.first().cloned():
            Some(first) =>
                match (*_self).visible_paths.get(&first):
                    Some(expanded) =>
                        let mut resolved = expanded.clone()
                        resolved.extend(segments.into_iter().skip(1))
                        ()
                        segments = resolved
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        if (none):
            segments.remove(0)
            ()
            ()
            ()
            ()
        segments

    fn normalize_path_segments(_self: &RustTypeMapper, path: &syn::Path) -> Array<String>:
        let mut segments = (*_self).collect_path_segments(path)
        if segments.is_empty():
            return segments
        let rooted = match segments.first().map(String__as_str):
            Some("crate") => true
            Some("self") => true
            Some("super") => true
            Some("std") => true
            Some("core") => true
            Some("alloc") => true
            _ => false
        if rooted:
            segments.remove(0)
            ()
            ()
            ()
            ()
        segments

    fn collect_path_segments(_self: &RustTypeMapper, path: &syn::Path) -> Array<String>:
        (*path).segments.iter().map(fn(seg): seg.ident.to_string()).collect()

    pub fn map_type(_self: &RustTypeMapper, ty: &syn::Type) -> kain_core::ast::Type:
        match ty:
            syn__Type::Path(tp) => (*_self).map_path(tp)
            syn__Type::Reference(r) => (*_self).map_ref(r)
            syn__Type::Ptr(p) => (*_self).map_ptr(p)
            syn__Type::Array(a) => (*_self).map_array(a)
            syn__Type::Slice(s) => (*_self).map_slice(s)
            syn__Type::Tuple(t) => (*_self).map_tuple(t)
            syn__Type::BareFn(f) => (*_self).map_bare_fn(f)
            syn__Type::ImplTrait(i) => (*_self).map_impl_trait(i)
            syn__Type::TraitObject(t) => (*_self).map_trait_object(t)
            syn__Type::Paren(p) => (*_self).map_type(&p.elem)
            syn__Type::Group(g) => (*_self).map_type(&g.elem)
            syn__Type::Never(_) => kain_core__ast__Type::Never(S)
            syn__Type::Infer(_) => kain_core__ast__Type::Infer(S)
            _ => named("Unknown")

    fn map_path(_self: &RustTypeMapper, tp: &syn::TypePath) -> kain_core::ast::Type:
        let resolved_segments = (*_self).resolve_path_segments(&(*tp).path)
        let seg = match (*tp).path.segments.last():
            Some(s) => s
            None => return kain_core__ast__Type::Unit(S)
        let name = resolved_segments.last().cloned().unwrap_or_else(fn(): seg.ident.to_string())
        let generics = (*_self).generic_args(&seg.arguments)
        match name.as_str():
            "bool" => return named("Bool")
            "str" => return named("String")
            "String" => return named("String")
            "char" => return named("Char")
            "f32" => return named("f32")
            "f64" => return named("f64")
            "u8" => return named("u8")
            "u16" => return named("u16")
            "u32" => return named("u32")
            "u64" => return named("u64")
            "u128" => return named("u128")
            "usize" => return named("usize")
            "i8" => return named("i8")
            "i16" => return named("i16")
            "i32" => return named("i32")
            "i64" => return named("i64")
            "i128" => return named("i128")
            "isize" => return named("isize")
            _ => ()
        if (name == "Lazy"):
            match generics.first().cloned():
                Some(inner) => return inner
                _ =>
                    ()
                    ()
            return named("Unknown")
        if (RustTypeMapper__is_wrapper_type(name.as_str()) && (!(*_self).preserve_wrapper_types)):
            match generics.first().cloned():
                Some(inner) => return inner
                _ =>
                    ()
                    ()
            return named("Unknown")
        match name.as_str():
            "Vec" =>
                match generics.first().cloned():
                    Some(inner) => return kain_core__ast__Type::Named { name: ("Array").to_string(), generics: [inner], span: S }
                    _ =>
                        ()
                        ()
                ()
            "VecDeque" =>
                match generics.first().cloned():
                    Some(inner) => return kain_core__ast__Type::Named { name: ("Array").to_string(), generics: [inner], span: S }
                    _ =>
                        ()
                        ()
                ()
            "LinkedList" =>
                match generics.first().cloned():
                    Some(inner) => return kain_core__ast__Type::Named { name: ("Array").to_string(), generics: [inner], span: S }
                    _ =>
                        ()
                        ()
                ()
            "Option" =>
                match generics.first().cloned():
                    Some(inner) => return kain_core__ast__Type::Option(Box__new_(inner), S)
                    _ =>
                        ()
                        ()
                ()
            "Result" =>
                let mut g = generics.iter().cloned()
                let ok = g.next().unwrap_or(kain_core__ast__Type::Unit(S))
                let err = g.next().unwrap_or(named("Error"))
                return kain_core__ast__Type::Result(Box__new_(ok), Box__new_(err), S)
            "HashMap" => return kain_core__ast__Type::Named { name: ("Map").to_string(), generics: generics, span: S }
            "BTreeMap" => return kain_core__ast__Type::Named { name: ("Map").to_string(), generics: generics, span: S }
            "IndexMap" => return kain_core__ast__Type::Named { name: ("Map").to_string(), generics: generics, span: S }
            "HashSet" => return kain_core__ast__Type::Named { name: ("Set").to_string(), generics: generics, span: S }
            "BTreeSet" => return kain_core__ast__Type::Named { name: ("Set").to_string(), generics: generics, span: S }
            "IndexSet" => return kain_core__ast__Type::Named { name: ("Set").to_string(), generics: generics, span: S }
            "KainResult" =>
                let mut g = generics.iter().cloned()
                let ok = g.next().unwrap_or(named("String"))
                let err = g.next().unwrap_or(named("KainError"))
                return kain_core__ast__Type::Result(Box__new_(ok), Box__new_(err), S)
            _ => ()
        let qualified_name = if (resolved_segments.len() > 1):
            resolved_segments.join("::")
        else:
            name
        kain_core__ast__Type::Named { name: qualified_name, generics: generics, span: S }

    fn map_ref(_self: &RustTypeMapper, r: &syn::TypeReference) -> kain_core::ast::Type:
        if (*_self).reference_maps_to_canonical_string(r):
            return named("String")
        kain_core__ast__Type::Ref { mutable_: (*r).mutability.is_some(), inner: Box__new_((*_self).map_type(&(*r).elem)), lifetime: (*r).lifetime.map(fn(lt): lt.ident.to_string()), span: S }

    fn map_ptr(_self: &RustTypeMapper, p: &syn::TypePtr) -> kain_core::ast::Type:
        kain_core__ast__Type::Ptr { mutable_: (*p).mutability.is_some(), inner: Box__new_((*_self).map_type(&(*p).elem)), provenance: kain_core__ast__PointerProvenance__LoweredRef, span: S }

    fn map_array(_self: &RustTypeMapper, a: &syn::TypeArray) -> kain_core::ast::Type:
        let inner = (*_self).map_type(&(*a).elem)
        let len = extract_const_usize(&(*a).len).unwrap_or(0)
        kain_core__ast__Type::Array(Box__new_(inner), len, S)

    fn map_slice(_self: &RustTypeMapper, s: &syn::TypeSlice) -> kain_core::ast::Type:
        kain_core__ast__Type::Slice(Box__new_((*_self).map_type(&(*s).elem)), S)

    fn map_tuple(_self: &RustTypeMapper, t: &syn::TypeTuple) -> kain_core::ast::Type:
        if (*t).elems.is_empty():
            return kain_core__ast__Type::Unit(S)
        kain_core__ast__Type::Tuple((*t).elems.iter().map(fn(e): (*_self).map_type(e)).collect(), S)

    fn map_bare_fn(_self: &RustTypeMapper, f: &syn::TypeBareFn) -> kain_core::ast::Type:
        let params = (*f).inputs.iter().map(fn(a): (*_self).map_type(&a.ty)).collect()
        let return_type = match &(*f).output:
            syn__ReturnType::Default => kain_core__ast__Type::Unit(S)
            syn__ReturnType::Type(_, ty) => (*_self).map_type(ty)
        kain_core__ast__Type::Function { params: params, return_type: Box__new_(return_type), effects: [], span: S }

    fn map_impl_trait(_self: &RustTypeMapper, i: &syn::TypeImplTrait) -> kain_core::ast::Type:
        match (*_self).first_non_auto_trait_bound(&(*i).bounds):
            Some((trait_name, generics)) => return kain_core__ast__Type::Impl { trait_name: trait_name, generics: generics, span: S }
            _ =>
                ()
                ()
        kain_core__ast__Type::Infer(S)

    fn map_trait_object(_self: &RustTypeMapper, t: &syn::TypeTraitObject) -> kain_core::ast::Type:
        match (*_self).first_non_auto_trait_bound(&(*t).bounds):
            Some((trait_name, generics)) => return kain_core__ast__Type::Impl { trait_name: trait_name, generics: generics, span: S }
            _ =>
                ()
                ()
        kain_core__ast__Type::Infer(S)

    pub fn generic_args(_self: &RustTypeMapper, args: &syn::PathArguments) -> Array<kain_core::ast::Type>:
        match args:
            syn__PathArguments::AngleBracketed(ab) => ab.args.iter().filter_map(fn(arg): none).collect()
            _ => []

    pub fn map_generic_params(_self: &RustTypeMapper, params: &syn::punctuated::Punctuated<syn::GenericParam, syn::token::Comma>) -> Array<kain_core::ast::Generic>:
        params.iter().filter_map(fn(p): none).collect()

    fn first_non_auto_trait_bound(_self: &RustTypeMapper, bounds: &syn::punctuated::Punctuated<syn::TypeParamBound, Unknown>) -> Option<(String, Array<kain_core::ast::Type>)>:
        for bound in bounds:
            let syn__TypeParamBound::Trait(tb) = bound
            let Some(seg) = tb.path.segments.last()
            let trait_name = seg.ident.to_string()
            if (none):
                continue
            return Option::Some((trait_name, (*_self).generic_args(&seg.arguments)))
        ()
        none


impl RustTypeMapper:
    fn is_wrapper_type(name: String) -> Bool:
        match name:
            "Box" => true
            "Arc" => true
            "Rc" => true
            "Cell" => true
            "RefCell" => true
            "Mutex" => true
            "RwLock" => true
            "ManuallyDrop" => true
            "MaybeUninit" => true
            "Pin" => true
            "Cow" => true
            _ => false

    fn reference_maps_to_canonical_string(_self: &RustTypeMapper, reference: &syn::TypeReference) -> Bool:
        match (*reference).elem:
            syn__Type::Path(tp) => (*_self).type_path_is_string_like(tp)
            _ => false

    fn type_path_is_string_like(_self: &RustTypeMapper, tp: &syn::TypePath) -> Bool:
        let resolved_segments = (*_self).resolve_path_segments(&(*tp).path)
        match resolved_segments.last().map(String__as_str):
            Some("str") => true
            Some("String") => true
            _ => false


const S: kain_core::span::Span = kain_core::span::Span { start: 0, end: 0 }

fn named(n: String) -> kain_core::ast::Type:
    kain_core__ast__Type::Named { name: n.to_string(), generics: [], span: S }

fn extract_const_usize(expr: &syn::Expr) -> Option<usize>:
    match expr:
        syn__Expr::Lit(lit) =>
            match &lit.lit:
                syn__Lit::Int(i) => i.base10_parse().ok()
                _ =>
                    none
        _ => none

