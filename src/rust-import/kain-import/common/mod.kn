use std::collections::HashMap

@doc(doc = " Shared context for all importers")
pub struct ImportContext:
    type_map: Map<String, kain_core::ast::Type>
    current_file: Option<String>
    include_paths: Array<String>
    defines: Map<String, String>

impl ImportContext:
    pub fn new_() -> ImportContext:
        ImportContext { type_map: HashMap__new_(), current_file: none, include_paths: Vec__new_(), defines: HashMap__new_() }

    pub fn with_include_paths(_self: ImportContext, paths: Array<String>) -> ImportContext:
        _self.include_paths = paths
        ()
        _self

    pub fn with_defines(_self: ImportContext, defines: Map<String, String>) -> ImportContext:
        _self.defines = defines
        ()
        _self


impl Default for ImportContext:
    fn default_() -> ImportContext:
        ImportContext__new_()


