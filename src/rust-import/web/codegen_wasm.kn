            kain_core__ast__Expr::Float(_, _) => walrus__ValType__F64
            kain_core__ast__Expr::Bool(_, _) => walrus__ValType__I32
            kain_core__ast__Expr::String(_, _) => walrus__ValType__I32
            kain_core__ast__Expr::JSX(_, _) => walrus__ValType__I32
