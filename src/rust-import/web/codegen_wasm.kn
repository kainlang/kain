    fn compute_enum_layout(_self: &mut WasmCompiler, e: &kain_core::types::TypedEnum):
        let mut variant_tags = HashMap__new_()
        let mut max_payload_size = 0
        let mut variant_field_offsets = HashMap__new_()
        for selfhost_for_item in (*e).ast.variants.iter().enumerate():
            let (idx, variant) = selfhost_for_item
            variant_tags.insert(variant.name.clone(), idx as u32)
            ()
            let mut field_offsets = HashMap__new_()
            let mut payload_size = 0
            match (*e).variant_payload_types.get(&variant.name):
                Some(payload_types) =>
                    let mut current_offset = 0
                    match &variant.fields:
                        kain_core__ast__VariantFields::Struct(fields) =>
                            for selfhost_for_item in fields.iter().enumerate():
                                let (i, field) = selfhost_for_item
                                match payload_types.get(i):
                                    Some(ty) =>
                                        current_offset = (((current_offset + 3)) & (!3))
                                        ()
                                        field_offsets.insert(field.name.clone(), current_offset)
                                        ()
                                        let size = (*_self).type_size_of(ty)
                                        current_offset = (current_offset + size)
                                        ()
                                    _ => ()
                            ()
                            ()
                        kain_core__ast__VariantFields::Tuple(_) =>
                            for selfhost_for_item in payload_types.iter().enumerate():
                                let (i, ty) = selfhost_for_item
                                current_offset = (((current_offset + 3)) & (!3))
                                ()
                                field_offsets.insert(i.to_string(), current_offset)
                                ()
                                current_offset = (current_offset + (*_self).type_size_of(ty))
                                ()
                            ()
                            ()
                        kain_core__ast__VariantFields::Unit => ()
                    payload_size = (((current_offset + 3)) & (!3))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            variant_field_offsets.insert(variant.name.clone(), field_offsets)
            ()
            max_payload_size = max_payload_size.max(payload_size)
            ()
        ()
        (*_self).enum_layouts.insert((*e).ast.name.clone(), (variant_tags, max_payload_size, variant_field_offsets))
        ()

    fn type_size_of(_self: &WasmCompiler, ty: &kain_core::types::ResolvedType) -> u32:
        match ty:
            kain_core__types__ResolvedType::Unit => 0
            kain_core__types__ResolvedType::Bool => 4
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::I8) => 1
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::U8) => 1
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::I16) => 2
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::U16) => 2
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::I32) => 4
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::U32) => 4
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::I64) => 8
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::U64) => 8
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::Isize) => 8
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::Usize) => 8
            kain_core__types__ResolvedType::Float(kain_core__types__FloatSize::F32) => 4
            kain_core__types__ResolvedType::Float(kain_core__types__FloatSize::F64) => 8
            kain_core__types__ResolvedType::String => 4
            kain_core__types__ResolvedType::Char => 4
            kain_core__types__ResolvedType::Array(_, len) => (4 + (((*len) as u32 * 8)))
            kain_core__types__ResolvedType::Struct(_, _) => 4
            _ => 8

    fn emit_alloc(_self: &WasmCompiler, ctx: &CompilationContext, builder: &mut walrus::InstrSeqBuilder, size: u32):
        builder.global_get((*ctx).heap_ptr_global)
        ()
        builder.global_get((*ctx).heap_ptr_global)
        ()
        builder.i32_const(size as i32)
        ()
        builder.binop(walrus__ir__BinaryOp__I32Add)
        ()
        builder.i32_const(7)
        ()
        builder.binop(walrus__ir__BinaryOp__I32Add)
        ()
        builder.i32_const((-8))
        ()
        builder.binop(walrus__ir__BinaryOp__I32And)
        ()
        builder.global_set((*ctx).heap_ptr_global)
        ()

    fn collect_strings_in_block(_self: &mut WasmCompiler, block: &kain_core::ast::Block):
