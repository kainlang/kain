                    ()
            kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                (*_self).collect_lambdas_in_expr(condition, lambdas)
                ()
                (*_self).collect_lambdas_in_block(then_branch, lambdas)
                ()
                match else_branch:
                    Some(else_br) =>
