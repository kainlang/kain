                        ()
                    _ => ()

    fn collect_lambdas_in_block(_self: &mut WasmCompiler, block: &kain_core::ast::Block, lambdas: &mut Array<(u32, Array<kain_core::ast::Param>, kain_core::ast::Expr)>):
