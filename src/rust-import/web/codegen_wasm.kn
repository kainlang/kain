pub fn generate(program: &kain_core::types::TypedProgram) -> Result<Array<u8>, KainError>:
    let lowered = kain_core__lower_typed_program_memory_for_target(program, kain_core__CompileTarget__Wasm)?
    let mut compiler = WasmCompiler__new_()
    compiler.compile_program(&lowered)?
    ()
    Result::Ok(compiler.module.emit_wasm())

struct WasmCompiler:
    module: walrus::Module
    functions: Map<String, walrus::FunctionId>
    memory_id: Option<walrus::MemoryId>
    heap_ptr_global: walrus::GlobalId
    data_offset: u32
    string_table: Map<String, u32>
    struct_layouts: Map<String, (Map<String, u32>, u32)>
    enum_layouts: Map<String, (Map<String, u32>, u32, Map<String, Map<String, u32>>)>
    funcref_table: Option<walrus::TableId>
    lambda_counter: u32
    lambda_table: Map<u32, (u32, walrus::FunctionId)>

struct CompilationContext<a>:
    locals: Map<String, walrus::LocalId>
    functions: &a Map<String, walrus::FunctionId>
    string_table: &a Map<String, u32>
    struct_layouts: &a Map<String, (Map<String, u32>, u32)>
    enum_layouts: &a Map<String, (Map<String, u32>, u32, Map<String, Map<String, u32>>)>
    memory_id: walrus::MemoryId
    heap_ptr_global: walrus::GlobalId
    tmp_i32: walrus::LocalId
    tmp_i32_2: walrus::LocalId
    tmp_i64: walrus::LocalId
    funcref_table: Option<walrus::TableId>
    lambda_table: &a Map<u32, (u32, walrus::FunctionId)>

impl WasmCompiler:
    fn compile_print_like_args(_self: &WasmCompiler, ctx: &CompilationContext, builder: &mut walrus::InstrSeqBuilder, args: &[kain_core::ast::CallArg]) -> Result<(), KainError>:
        for arg in args:
            match &arg.value:
                kain_core__ast__Expr::Int(_, _) =>
                    (*_self).compile_expr(ctx, builder, &arg.value)?
                    ()
                    match (*ctx).functions.get("print_i64"):
                        Some(func_id) =>
                            builder.call((*func_id))
                            ()
                        _ => ()
                kain_core__ast__Expr::Float(_, _) =>
                    (*_self).compile_expr(ctx, builder, &arg.value)?
                    ()
                    match (*ctx).functions.get("print_f64"):
                        Some(func_id) =>
                            builder.call((*func_id))
                            ()
                        _ => ()
                kain_core__ast__Expr::Bool(_, _) =>
                    (*_self).compile_expr(ctx, builder, &arg.value)?
                    ()
                    match (*ctx).functions.get("print_bool"):
                        Some(func_id) =>
                            builder.call((*func_id))
                            ()
                        _ => ()
                kain_core__ast__Expr::String(s, _) =>
                    match (*ctx).string_table.get(s):
                        Some(offset) =>
                            builder.i32_const(((offset + 4)) as i32)
                            ()
                            builder.i32_const(s.len() as i32)
                            ()
                            match (*ctx).functions.get("print_str"):
                                Some(func_id) =>
                                    builder.call((*func_id))
                                    ()
                                _ => ()
                        _ => ()
                _ =>
                    let is_string = (*_self).is_string_expr(&arg.value)
                    let is_i32_var = match &arg.value:
                        kain_core__ast__Expr::Ident(name, _) => (*_self).is_i32_local(name, &(*ctx).locals)
                        _ => (*_self).is_i32_expr(&arg.value)
                    (*_self).compile_expr(ctx, builder, &arg.value)?
                    ()
                    if is_string:
                        builder.local_set((*ctx).tmp_i32)
                        ()
                        builder.local_get((*ctx).tmp_i32)
                        ()
                        builder.local_get((*ctx).tmp_i32)
                        ()
                        builder.i32_const(4)
                        ()
                        builder.binop(walrus__ir__BinaryOp__I32Sub)
                        ()
                        builder.load((*ctx).memory_id, walrus__ir__LoadKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 0 })
                        ()
                        match (*ctx).functions.get("print_str"):
                            Some(func_id) =>
                                builder.call((*func_id))
                                ()
                            _ => ()
                    elif is_i32_var:
                        builder.drop()
                        ()
                    else:
                        match (*ctx).functions.get("print_i64"):
                            Some(func_id) =>
                                builder.call((*func_id))
                                ()
                            _ => ()
        ()
        Result::Ok(())

    fn compile_expr_as_i32(_self: &WasmCompiler, ctx: &CompilationContext, builder: &mut walrus::InstrSeqBuilder, expr: &kain_core::ast::Expr) -> Result<(), KainError>:
        let already_i32 = (((*_self).is_string_expr(expr) || (*_self).is_i32_expr(expr)) || none)
        (*_self).compile_expr(ctx, builder, expr)?
        ()
        if (!already_i32):
            builder.unop(walrus__ir__UnaryOp__I32WrapI64)
            ()
            ()
            ()
            ()
        Result::Ok(())

    fn compile_expr_as_i64(_self: &WasmCompiler, ctx: &CompilationContext, builder: &mut walrus::InstrSeqBuilder, expr: &kain_core::ast::Expr) -> Result<(), KainError>:
        let already_i32 = (((*_self).is_string_expr(expr) || (*_self).is_i32_expr(expr)) || none)
        (*_self).compile_expr(ctx, builder, expr)?
        ()
        if already_i32:
            builder.unop(walrus__ir__UnaryOp__I64ExtendSI32)
            ()
            ()
            ()
            ()
        Result::Ok(())

    fn compile_c_runtime_call(_self: &WasmCompiler, ctx: &CompilationContext, builder: &mut walrus::InstrSeqBuilder, func_name: String, args: &[kain_core::ast::CallArg]) -> Result<Bool, KainError>:
        let Some(shim) = c_runtime_shims__wasm_c_runtime_shim(func_name)
        match shim.kind:
            WasmCRuntimeShimKind::Printf =>
                let print_args: Array<kain_core::ast::CallArg> = args.iter().skip(1).cloned().collect()
                (*_self).compile_print_like_args(ctx, builder, &print_args)?
                ()
                builder.i64_const(0)
                ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Fprintf =>
                let print_args: Array<kain_core::ast::CallArg> = args.iter().skip(2).cloned().collect()
                (*_self).compile_print_like_args(ctx, builder, &print_args)?
                ()
                builder.i64_const(0)
                ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Puts =>
                let print_args: Array<kain_core::ast::CallArg> = args.iter().take(1).cloned().collect()
                (*_self).compile_print_like_args(ctx, builder, &print_args)?
                ()
                match (*ctx).string_table.get("\n"):
                    Some(offset) =>
                        builder.i32_const(((offset + 4)) as i32)
                        ()
                        builder.i32_const(1)
                        ()
                        match (*ctx).functions.get("print_str"):
                            Some(func_id) =>
                                builder.call((*func_id))
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                builder.i64_const(0)
                ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Atoll =>
                match args.first():
                    Some(arg) =>
                        (*_self).compile_expr_as_i32(ctx, builder, &arg.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i32_const(0)
                        ()
                        ()
                        ()
                        ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Sprintf =>
                match args.first():
                    Some(dst) =>
                        (*_self).compile_expr_as_i32(ctx, builder, &dst.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i32_const(0)
                        ()
                        ()
                        ()
                        ()
                match args.get(1):
                    Some(fmt) =>
                        (*_self).compile_expr_as_i32(ctx, builder, &fmt.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i32_const(0)
                        ()
                        ()
                        ()
                        ()
                match args.get(2):
                    Some(value) =>
                        (*_self).compile_expr_as_i64(ctx, builder, &value.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i32_const(0)
                        ()
                        ()
                        ()
                        ()
                builder.unop(walrus__ir__UnaryOp__I64ExtendSI32)
                ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Exit =>
                match args.first():
                    Some(arg) =>
                        (*_self).compile_expr(ctx, builder, &arg.value)?
                        ()
                        builder.unop(walrus__ir__UnaryOp__I32WrapI64)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i32_const(0)
                        ()
                        ()
                        ()
                        ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                builder.i64_const(0)
                ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Free =>
                match args.first():
                    Some(arg) =>
                        (*_self).compile_expr(ctx, builder, &arg.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i32_const(0)
                        ()
                        ()
                        ()
                        ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                builder.i64_const(0)
                ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Fopen =>
                match args.first():
                    Some(path) =>
                        (*_self).compile_expr_as_i32(ctx, builder, &path.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i32_const(0)
                        ()
                        ()
                        ()
                        ()
                match args.get(1):
                    Some(mode) =>
                        (*_self).compile_expr_as_i32(ctx, builder, &mode.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i32_const(0)
                        ()
                        ()
                        ()
                        ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Fseek =>
                for idx in range(0, 3):
                    match args.get(idx):
                        Some(arg) =>
                            (*_self).compile_expr_as_i64(ctx, builder, &arg.value)?
                            ()
                        _ =>
                            builder.i64_const(0)
                            ()
                ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Ftell =>
                match args.first():
                    Some(arg) =>
                        (*_self).compile_expr_as_i64(ctx, builder, &arg.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Fclose =>
                match args.first():
                    Some(arg) =>
                        (*_self).compile_expr_as_i64(ctx, builder, &arg.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Fread =>
                for idx in range(0, 4):
                    match args.get(idx):
                        Some(arg) =>
                            (*_self).compile_expr_as_i64(ctx, builder, &arg.value)?
                            ()
                        _ =>
                            builder.i64_const(0)
                            ()
                ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Fwrite =>
                for idx in range(0, 4):
                    match args.get(idx):
                        Some(arg) =>
                            (*_self).compile_expr_as_i64(ctx, builder, &arg.value)?
                            ()
                        _ =>
                            builder.i64_const(0)
                            ()
                ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Strncpy =>
                for idx in range(0, 3):
                    match args.get(idx):
                        Some(arg) =>
                            (*_self).compile_expr_as_i64(ctx, builder, &arg.value)?
                            ()
                        _ =>
                            builder.i64_const(0)
                            ()
                ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Strdup =>
                match args.first():
                    Some(arg) =>
                        (*_self).compile_expr_as_i32(ctx, builder, &arg.value)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i32_const(0)
                        ()
                        ()
                        ()
                        ()
                match (*ctx).functions.get(func_name):
                    Some(func_id) =>
                        builder.call((*func_id))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        builder.i64_const(0)
                        ()
                        ()
                        ()
                        ()
                Result::Ok(true)
            WasmCRuntimeShimKind::Strlen => Result::Ok(false)
            WasmCRuntimeShimKind::Strcmp => Result::Ok(false)
            WasmCRuntimeShimKind::Strcpy => Result::Ok(false)
            WasmCRuntimeShimKind::Strcat => Result::Ok(false)

    fn new_() -> WasmCompiler:
        let config = ModuleConfig__new_()
        let mut module = Module__with_config(config)
        let memory_id = module.memories.add_local(false, false, 1, none, none)
        module.exports.add("memory", memory_id)
        ()
        let heap_ptr = 4096
        let heap_ptr_global = module.globals.add_local(walrus__ValType__I32, true, false, walrus__ConstExpr::Value(walrus__ir__Value::I32(heap_ptr as i32)))
        let mut functions = HashMap__new_()
        let print_i64_type = module.types.add(&[walrus__ValType__I64], &[])
        let (print_i64_func, _) = module.add_import_func("host", "print_i64", print_i64_type)
        functions.insert(("print_i64").to_string(), print_i64_func)
        ()
        let print_f64_type = module.types.add(&[walrus__ValType__F64], &[])
        let (print_f64_func, _) = module.add_import_func("host", "print_f64", print_f64_type)
        functions.insert(("print_f64").to_string(), print_f64_func)
        ()
        let print_str_type = module.types.add(&[walrus__ValType__I32, walrus__ValType__I32], &[])
        let (print_str_func, _) = module.add_import_func("host", "print_str", print_str_type)
        functions.insert(("print_str").to_string(), print_str_func)
        ()
        let print_bool_type = module.types.add(&[walrus__ValType__I32], &[])
        let (print_bool_func, _) = module.add_import_func("host", "print_bool", print_bool_type)
        functions.insert(("print_bool").to_string(), print_bool_func)
        ()
        let read_i64_type = module.types.add(&[], &[walrus__ValType__I64])
        let (read_i64_func, _) = module.add_import_func("host", "read_i64", read_i64_type)
        functions.insert(("read_i64").to_string(), read_i64_func)
        ()
        let int_to_str_type = module.types.add(&[walrus__ValType__I64], &[walrus__ValType__I32])
        let (int_to_str_func, _) = module.add_import_func("host", "int_to_str", int_to_str_type)
        functions.insert(("int_to_str").to_string(), int_to_str_func)
        ()
        let str_concat_type = module.types.add(&[walrus__ValType__I32, walrus__ValType__I32], &[walrus__ValType__I32])
        let (str_concat_func, _) = module.add_import_func("host", "str_concat", str_concat_type)
        functions.insert(("str_concat").to_string(), str_concat_func)
        ()
        let time_now_type = module.types.add(&[], &[walrus__ValType__I64])
        let (time_now_func, _) = module.add_import_func("host", "time_now", time_now_type)
        functions.insert(("time_now").to_string(), time_now_func)
        ()
        for shim in c_runtime_shims__WASM_C_RUNTIME_SHIMS:
            let Some(host_symbol) = shim.host_symbol
            let Some(signature) = shim.signature
            let (params, results) = c_runtime_shims__wasm_import_signature_types(signature)
            let import_type = module.types.add(params, results)
            let (func_id, _) = module.add_import_func("host", host_symbol, import_type)
            functions.insert(shim.c_symbol.to_string(), func_id)
            ()
        ()
        let dom_create_type = module.types.add(&[walrus__ValType__I32, walrus__ValType__I32], &[walrus__ValType__I32])
        let (dom_create_func, _) = module.add_import_func("host", "dom_create", dom_create_type)
        functions.insert(("dom_create").to_string(), dom_create_func)
        ()
        let dom_append_type = module.types.add(&[walrus__ValType__I32, walrus__ValType__I32], &[])
        let (dom_append_func, _) = module.add_import_func("host", "dom_append", dom_append_type)
        functions.insert(("dom_append").to_string(), dom_append_func)
        ()
        let dom_attr_type = module.types.add(&[walrus__ValType__I32, walrus__ValType__I32, walrus__ValType__I32, walrus__ValType__I32, walrus__ValType__I32], &[])
        let (dom_attr_func, _) = module.add_import_func("host", "dom_attr", dom_attr_type)
        functions.insert(("dom_attr").to_string(), dom_attr_func)
        ()
        let dom_text_type = module.types.add(&[walrus__ValType__I32, walrus__ValType__I32], &[walrus__ValType__I32])
        let (dom_text_func, _) = module.add_import_func("host", "dom_text", dom_text_type)
        functions.insert(("dom_text").to_string(), dom_text_func)
        ()
        let funcref_table = module.tables.add_local(false, 16, Option::Some(256), walrus__RefType__Funcref)
        WasmCompiler { module: module, functions: functions, memory_id: Option::Some(memory_id), heap_ptr_global: heap_ptr_global, data_offset: 0, string_table: HashMap__new_(), struct_layouts: HashMap__new_(), enum_layouts: HashMap__new_(), funcref_table: Option::Some(funcref_table), lambda_counter: 0, lambda_table: HashMap__new_() }

    fn compile_program(_self: &mut WasmCompiler, program: &kain_core::types::TypedProgram) -> Result<(), KainError>:
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Struct(s) =>
                    (*_self).compute_struct_layout(s)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match item:
                kain_core__types__TypedItem::Component(c) =>
                    (*_self).compute_component_layout(c)
                    ()
                _ => ()
        ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Enum(e) =>
                    (*_self).compute_enum_layout(e)
                    ()
                _ => ()
        ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Function(f) =>
                    (*_self).collect_strings_in_block(&f.ast.body)
                    ()
                _ => ()
        ()
        let mut all_lambdas = Vec__new_()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Function(f) =>
                    (*_self).collect_lambdas_in_block(&f.ast.body, &mut all_lambdas)
                    ()
                _ => ()
        ()
        for selfhost_for_item in &all_lambdas:
            let (id, params, body) = selfhost_for_item
            (*_self).compile_lambda((*id), &params, &body)?
            ()
        ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Function(f) =>
                    (*_self).declare_function(f)?
                    ()
                _ => ()
        ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Function(f) =>
                    (*_self).compile_function_body(f)?
                    ()
                _ => ()
        ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Component(c) =>
                    (*_self).compile_component(c)?
                    ()
                _ => ()
        ()
        Result::Ok(())

    fn compute_struct_layout(_self: &mut WasmCompiler, s: &kain_core::types::TypedStruct):
        let mut offset = 0
        let mut field_offsets = HashMap__new_()
        for field in &(*s).ast.fields:
            offset = (((offset + 3)) & (!3))
            ()
            field_offsets.insert(field.name.clone(), offset)
            ()
            let field_size = (*_self).type_size_of(&(*s).field_types.get(&field.name).cloned().unwrap_or(kain_core__types__ResolvedType::Int(kain_core__types__IntSize__I64)))
            offset = (offset + field_size)
            ()
        ()
        let total_size = (((offset + 3)) & (!3))
        (*_self).struct_layouts.insert((*s).ast.name.clone(), (field_offsets, total_size))
        ()

    fn compute_component_layout(_self: &mut WasmCompiler, c: &kain_core::types::TypedComponent):
        let mut offset = 0
        let mut field_offsets = HashMap__new_()
        for state_ in &(*c).ast.state_:
            offset = (((offset + 3)) & (!3))
            ()
            field_offsets.insert(state_.name.clone(), offset)
            ()
            offset = (offset + 8)
            ()
        ()
        let total_size = (((offset + 3)) & (!3))
