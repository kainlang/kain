        let self_local = (*_self).module.locals.add(walrus__ValType__I32)
        let tmp_i32 = (*_self).module.locals.add(walrus__ValType__I32)
        let tmp_i32_2 = (*_self).module.locals.add(walrus__ValType__I32)
        let tmp_i64 = (*_self).module.locals.add(walrus__ValType__I64)
