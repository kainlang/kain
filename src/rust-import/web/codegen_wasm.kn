            kain_core__ast__Expr::Binary { op: op } =>
                match op:
                    kain_core__ast__BinaryOp::Eq => walrus__ValType__I32
                    kain_core__ast__BinaryOp::Ne => walrus__ValType__I32
                    kain_core__ast__BinaryOp::Lt => walrus__ValType__I32
                    kain_core__ast__BinaryOp::Gt => walrus__ValType__I32
                    kain_core__ast__BinaryOp::Le => walrus__ValType__I32
                    kain_core__ast__BinaryOp::Ge => walrus__ValType__I32
                    kain_core__ast__BinaryOp::And => walrus__ValType__I32
