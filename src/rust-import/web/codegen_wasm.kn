    fn declare_function(_self: &mut WasmCompiler, func: &kain_core::types::TypedFunction) -> Result<(), KainError>:
        let (param_types, ret_type) = match &(*func).resolved_type:
            kain_core__types__ResolvedType::Function { params: params, ret: ret } => (params, ret)
            _ => return Result::Err(KainError__codegen("Expected function type", (*func).ast.span))
        let wasm_params: Array<walrus::ValType> = param_types.iter().map(fn(t): (*_self).map_type(t)).collect()
        let wasm_results = if ((*(*ret_type)) == kain_core__types__ResolvedType__Unit):
            []
        else:
            [(*_self).map_type(ret_type)]
        let builder = FunctionBuilder__new_(&mut (*_self).module.types, &wasm_params, &wasm_results)
        let mut param_local_ids = Vec__new_()
        for param_type in &wasm_params:
            param_local_ids.push((*_self).module.locals.add(param_type))
            ()
        ()
        let func_id = builder.finish(param_local_ids, &mut (*_self).module.funcs)
        (*_self).functions.insert((*func).ast.name.clone(), func_id)
        ()
        if (none):
            (*_self).module.exports.add(&(*func).ast.name, func_id)
            ()
            ()
            ()
            ()
        Result::Ok(())

    fn compile_function_body(_self: &mut WasmCompiler, func: &kain_core::types::TypedFunction) -> Result<(), KainError>:
        let func_id = (*(*_self).functions.get(&(*func).ast.name).unwrap())
        let (param_types, ret_type) = match &(*func).resolved_type:
            kain_core__types__ResolvedType::Function { params: params, ret: ret } => (params, ret)
            _ => return Result::Ok(())
        let wasm_params: Array<walrus::ValType> = param_types.iter().map(fn(t): (*_self).map_type(t)).collect()
        let wasm_results = if ((*(*ret_type)) == kain_core__types__ResolvedType__Unit):
            []
        else:
            [(*_self).map_type(ret_type)]
        let mut builder = FunctionBuilder__new_(&mut (*_self).module.types, &wasm_params, &wasm_results)
        let mut text_locals_map = HashMap__new_()
        let mut param_local_ids = Vec__new_()
        for selfhost_for_item in (*func).ast.params.iter().enumerate():
            let (i, param) = selfhost_for_item
            let local_id = (*_self).module.locals.add(wasm_params[i])
            text_locals_map.insert(param.name.clone(), local_id)
            ()
            param_local_ids.push(local_id)
            ()
        ()
        (*_self).preallocate_locals(&(*func).ast.body, &mut text_locals_map)
        ()
        let tmp_i32 = (*_self).module.locals.add(walrus__ValType__I32)
        let tmp_i32_2 = (*_self).module.locals.add(walrus__ValType__I32)
        let tmp_i64 = (*_self).module.locals.add(walrus__ValType__I64)
        let ctx = CompilationContext { locals: text_locals_map, functions: &(*_self).functions, string_table: &(*_self).string_table, struct_layouts: &(*_self).struct_layouts, enum_layouts: &(*_self).enum_layouts, memory_id: (*_self).memory_id.unwrap(), heap_ptr_global: (*_self).heap_ptr_global, tmp_i32: tmp_i32, tmp_i32_2: tmp_i32_2, tmp_i64: tmp_i64, funcref_table: (*_self).funcref_table, lambda_table: &(*_self).lambda_table }
        let mut func_body = builder.func_body()
        (*_self).compile_block(&ctx, &mut func_body, &(*func).ast.body)?
        ()
        if ((*func).ast.body.stmts.is_empty() && (!wasm_results.is_empty())):
            match wasm_results[0]:
                walrus__ValType::I64 =>
                    func_body.i64_const(0)
                    ()
                    ()
                    ()
                walrus__ValType::I32 =>
                    func_body.i32_const(0)
                    ()
                    ()
                    ()
                walrus__ValType::F64 =>
                    func_body.f64_const(0)
                    ()
                    ()
                    ()
                walrus__ValType::F32 =>
                    func_body.f32_const(0)
                    ()
                    ()
                    ()
                _ =>
                    func_body.i64_const(0)
                    ()
                    ()
                    ()
            ()
        let temp_func_id = builder.finish(param_local_ids, &mut (*_self).module.funcs)
        let dummy_type = (*_self).module.types.add(&[], &[])
        let (dummy_global_id, dummy_import_id) = (*_self).module.add_import_global("KAIN_internal", "dummy", walrus__ValType__I32, false, false)
        let dummy_kind = walrus__FunctionKind::Import(walrus::ImportedFunction { import: dummy_import_id, ty: dummy_type })
        let new_func = (*_self).module.funcs.get_mut(temp_func_id)
        let new_kind = std__mem__replace(&mut new_func.kind, dummy_kind)
        let old_func = (*_self).module.funcs.get_mut(func_id)
        let old_kind = std__mem__replace(&mut old_func.kind, new_kind)
        (*_self).module.funcs.delete_(temp_func_id)
        ()
        (*_self).module.imports.delete_(dummy_import_id)
        ()
        Result::Ok(())

    fn preallocate_locals(_self: &mut WasmCompiler, block: &kain_core::ast::Block, locals: &mut Map<String, walrus::LocalId>):
        for stmt in &(*block).stmts:
            match stmt:
                kain_core__ast__Stmt::Let { pattern: pattern, value: value } =>
                    match pattern:
                        kain_core__ast__Pattern::Binding { name: name } =>
                            if (!locals.contains_key(name)):
                                let val_type = match value:
                                    Some(expr) => (*_self).infer_wasm_type(expr)
                                    _ => walrus__ValType__I64
                                let local = (*_self).module.locals.add(val_type)
                                locals.insert(name.clone(), local)
                                ()
                        _ => ()
                kain_core__ast__Stmt::While { body: body } =>
                    (*_self).preallocate_locals(body, locals)
                    ()
                kain_core__ast__Stmt::For { binding: binding, body: body } =>
                    match binding:
                        kain_core__ast__Pattern::Binding { name: name } =>
