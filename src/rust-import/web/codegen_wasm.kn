                ()
            _ => ()

    fn collect_lambdas_in_else_branch(_self: &mut WasmCompiler, branch: &kain_core::ast::ElseBranch, lambdas: &mut Array<(u32, Array<kain_core::ast::Param>, kain_core::ast::Expr)>):
