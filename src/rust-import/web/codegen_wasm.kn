                            _ =>
                                (*_self).compile_stmt(ctx, builder, stmt)?
                                ()
                                builder.i64_const(0)
                                ()
                ()
                if block.stmts.is_empty():
                    builder.i64_const(0)
                    ()
                    ()
                    ()
                    ()
                ()
            _ => ()
        Result::Ok(())

    fn compile_else_branch(_self: &WasmCompiler, ctx: &CompilationContext, builder: &mut walrus::InstrSeqBuilder, branch: &kain_core::ast::ElseBranch) -> Result<(), KainError>:
        match branch:
            kain_core__ast__ElseBranch::Else(block) =>
                let _ = (*_self).compile_block(ctx, builder, block)
                ()
            kain_core__ast__ElseBranch::ElseIf(cond, then, next_else) =>
                (*_self).compile_expr(ctx, builder, cond)?
                ()
                builder.if_else(none, fn(then_builder): none, fn(else_builder): none)
                ()
                ()
                ()
                ()
        Result::Ok(())

    fn compile_jsx_node(_self: &WasmCompiler, ctx: &CompilationContext, builder: &mut walrus::InstrSeqBuilder, node: &kain_core::ast::JSXNode) -> Result<(), KainError>:
        match node:
            kain_core__ast__JSXNode::Element { tag: tag, attributes: attributes, children: children } =>
                for child in children:
                    (*_self).compile_jsx_node(ctx, builder, child)?
                    ()
                ()
                let child_count = children.len() as u32
                let children_size = (4 + ((child_count * 4)))
                (*_self).emit_alloc(ctx, builder, children_size)
                ()
                builder.local_set((*ctx).tmp_i32)
                ()
                for i in (range(0, child_count)).rev():
                    builder.local_set((*ctx).tmp_i32_2)
                    ()
                    builder.local_get((*ctx).tmp_i32)
                    ()
                    builder.i32_const(((4 + (i * 4))) as i32)
                    ()
                    builder.binop(walrus__ir__BinaryOp__I32Add)
                    ()
                    builder.local_get((*ctx).tmp_i32_2)
                    ()
                    builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 0 })
                    ()
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                builder.i32_const(child_count as i32)
                ()
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 0 })
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                let props_count = attributes.len() as u32
                for attr in attributes:
                    match (*ctx).string_table.get(&attr.name):
                        Some(offset) =>
                            builder.i32_const(((offset + 4)) as i32)
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            builder.i32_const(0)
                            ()
                            ()
                            ()
                            ()
                    match &attr.value:
                        kain_core__ast__JSXAttrValue::String(s) =>
                            match (*ctx).string_table.get(s):
                                Some(offset) =>
                                    builder.i32_const(((offset + 4)) as i32)
                                    ()
                                    ()
                                    ()
                                    ()
                                _ =>
                                    builder.i32_const(0)
                                    ()
                                    ()
                                    ()
                                    ()
                            builder.unop(walrus__ir__UnaryOp__I64ExtendUI32)
                            ()
                        kain_core__ast__JSXAttrValue::Expr(e) =>
                            (*_self).compile_expr(ctx, builder, e)?
                            ()
                        kain_core__ast__JSXAttrValue::Bool(b) =>
                            builder.i64_const(if (*b): 1 else: 0)
                            ()
                ()
                let props_item_size = 12
                let props_size = (4 + ((props_count * props_item_size)))
                (*_self).emit_alloc(ctx, builder, props_size)
                ()
                builder.local_set((*ctx).tmp_i32)
                ()
                for i in (range(0, props_count)).rev():
                    builder.local_set((*ctx).tmp_i64)
                    ()
                    builder.local_set((*ctx).tmp_i32_2)
                    ()
                    builder.local_get((*ctx).tmp_i32)
                    ()
                    builder.i32_const(((4 + (i * props_item_size))) as i32)
                    ()
                    builder.binop(walrus__ir__BinaryOp__I32Add)
                    ()
                    builder.local_get((*ctx).tmp_i32_2)
                    ()
                    builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 0 })
                    ()
                    builder.local_get((*ctx).tmp_i32)
                    ()
                    builder.i32_const((((4 + (i * props_item_size)) + 4)) as i32)
                    ()
                    builder.binop(walrus__ir__BinaryOp__I32Add)
                    ()
                    builder.local_get((*ctx).tmp_i64)
                    ()
                    builder.store((*ctx).memory_id, walrus__ir__StoreKind::I64 { atomic: false }, walrus::ir::MemArg { align: 8, offset: 0 })
                    ()
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                builder.i32_const(props_count as i32)
                ()
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 0 })
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                (*_self).emit_alloc(ctx, builder, 16)
                ()
                builder.local_set((*ctx).tmp_i32)
                ()
                builder.local_set((*ctx).tmp_i32_2)
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                builder.i32_const(8)
                ()
                builder.binop(walrus__ir__BinaryOp__I32Add)
                ()
                builder.local_get((*ctx).tmp_i32_2)
                ()
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 0 })
                ()
                builder.local_set((*ctx).tmp_i32_2)
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                builder.i32_const(12)
                ()
                builder.binop(walrus__ir__BinaryOp__I32Add)
                ()
                builder.local_get((*ctx).tmp_i32_2)
                ()
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 0 })
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                builder.i32_const(1)
                ()
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 0 })
                ()
                let tag_ptr = match (*ctx).string_table.get(tag):
                    Some(offset) => (offset + 4)
                    _ => 0
                builder.local_get((*ctx).tmp_i32)
                ()
                builder.i32_const(tag_ptr as i32)
                ()
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 4 })
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                ()
                ()
                ()
            kain_core__ast__JSXNode::Text(s, _) =>
                (*_self).emit_alloc(ctx, builder, 16)
                ()
                builder.local_set((*ctx).tmp_i32)
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                builder.i32_const(0)
                ()
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 0 })
                ()
                let text_ptr = match (*ctx).string_table.get(s):
                    Some(offset) => (offset + 4)
                    _ => 0
                builder.local_get((*ctx).tmp_i32)
                ()
                builder.i32_const(text_ptr as i32)
                ()
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: 12 })
                ()
                builder.local_get((*ctx).tmp_i32)
                ()
                ()
                ()
                ()
            kain_core__ast__JSXNode::Expression(e) =>
                (*_self).compile_expr(ctx, builder, e)?
                ()
                builder.unop(walrus__ir__UnaryOp__I32WrapI64)
                ()
                ()
                ()
                ()
            _ =>
                builder.i32_const(0)
                ()
                ()
                ()
                ()
        Result::Ok(())

    fn emit_store_for_expr(_self: &WasmCompiler, ctx: &CompilationContext, builder: &mut walrus::InstrSeqBuilder, expr: &kain_core::ast::Expr, offset: u32):
        match expr:
            kain_core__ast__Expr::Int(_, _) =>
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I64 { atomic: false }, walrus::ir::MemArg { align: 8, offset: offset })
                ()
            kain_core__ast__Expr::Float(_, _) =>
                builder.store((*ctx).memory_id, walrus__ir__StoreKind__F64, walrus::ir::MemArg { align: 8, offset: offset })
                ()
            kain_core__ast__Expr::Bool(_, _) =>
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: offset })
                ()
            kain_core__ast__Expr::String(_, _) =>
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I32 { atomic: false }, walrus::ir::MemArg { align: 4, offset: offset })
                ()
            _ =>
                builder.store((*ctx).memory_id, walrus__ir__StoreKind::I64 { atomic: false }, walrus::ir::MemArg { align: 8, offset: offset })
                ()


