    fn compile_expr(_self: &WasmCompiler, ctx: &CompilationContext, builder: &mut walrus::InstrSeqBuilder, expr: &kain_core::ast::Expr) -> Result<(), KainError>:
        match expr:
            kain_core__ast__Expr::Int(n, _) =>
