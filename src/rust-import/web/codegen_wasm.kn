    fn compile_lambda(_self: &mut WasmCompiler, id: u32, params: &[kain_core::ast::Param], body: &kain_core::ast::Expr) -> Result<(), KainError>:
        let wasm_params: Array<walrus::ValType> = params.iter().map(fn(_): walrus__ValType__I64).collect()
        let wasm_results = [walrus__ValType__I64]
        let mut builder = FunctionBuilder__new_(&mut (*_self).module.types, &wasm_params, &wasm_results)
        let mut locals = HashMap__new_()
        let mut param_local_ids = Vec__new_()
        for selfhost_for_item in params.iter().enumerate():
            let (i, param) = selfhost_for_item
            let local_id = (*_self).module.locals.add(wasm_params[i])
            locals.insert(param.name.clone(), local_id)
            ()
            param_local_ids.push(local_id)
            ()
        ()
        let tmp_i32 = (*_self).module.locals.add(walrus__ValType__I32)
        let tmp_i32_2 = (*_self).module.locals.add(walrus__ValType__I32)
        let tmp_i64 = (*_self).module.locals.add(walrus__ValType__I64)
        let ctx = CompilationContext { locals: locals, functions: &(*_self).functions, string_table: &(*_self).string_table, struct_layouts: &(*_self).struct_layouts, enum_layouts: &(*_self).enum_layouts, memory_id: (*_self).memory_id.unwrap(), heap_ptr_global: (*_self).heap_ptr_global, tmp_i32: tmp_i32, tmp_i32_2: tmp_i32_2, tmp_i64: tmp_i64, funcref_table: (*_self).funcref_table, lambda_table: &(*_self).lambda_table }
        let mut func_body = builder.func_body()
        (*_self).compile_expr(&ctx, &mut func_body, body)?
        ()
        let func_id = builder.finish(param_local_ids, &mut (*_self).module.funcs)
        let table_index = id
        match (*_self).funcref_table:
            Some(table_id) =>
                (*_self).module.elements.add(walrus__ElementKind::Active { table: table_id, offset: walrus__ConstExpr::Value(walrus__ir__Value::I32(table_index as i32)) }, walrus__ElementItems::Functions([func_id]))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).lambda_table.insert(id, (table_index, func_id))
        ()
        let lambda_name = f"__lambda_{id}"
        (*_self).functions.insert(lambda_name, func_id)
        ()
