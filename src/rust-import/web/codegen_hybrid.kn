use kain_core::error::KainResult

use kain_core::types::ResolvedType

use kain_core::types::TypedComponent

use kain_core::types::TypedFunction

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

@doc(doc = " Output from hybrid compilation")
pub struct HybridOutput:
    wasm: Array<u8>
    js: String
    ts: String
    wasm_exports: Array<WasmExport>

@doc(doc = " Metadata about an exported WASM function for binding generation")
@derive(Clone, Debug)
pub struct WasmExport:
    name: String
    params: Array<(String, kain_core::types::ResolvedType)>
    return_type: Option<kain_core::types::ResolvedType>

@doc(doc = " Check if a function has the @wasm attribute")
fn has_wasm_attr(func: &kain_core::types::TypedFunction) -> Bool:
    (*func).ast.attributes.iter().any(fn(attr): (attr.name == "wasm"))

@doc(doc = " Check if a component has the @wasm attribute")
fn component_has_wasm_attr(comp: &kain_core::types::TypedComponent) -> Bool:
    (*comp).ast.attributes.iter().any(fn(attr): (attr.name == "wasm"))

@doc(doc = " Extract export metadata from a function")
fn extract_export(func: &kain_core::types::TypedFunction) -> WasmExport:
    let params: Array<(String, kain_core::types::ResolvedType)> = (*func).ast.params.iter().map(fn(p): (p.name.clone(), (*func).resolved_type.clone())).collect()
    let return_type = match &(*func).resolved_type:
        kain_core__types__ResolvedType::Function { ret: ret } => Option::Some(((*(*ret))).clone())
        _ => none
    WasmExport { name: (*func).ast.name.clone(), params: params, return_type: return_type }

@doc(doc = " Generate hybrid WASM + JS output from a typed program")
pub fn generate(program: &kain_core::types::TypedProgram) -> Result<HybridOutput, KainError>:
    let mut wasm_items = Vec__new_()
    let mut js_items = Vec__new_()
    let mut wasm_exports = Vec__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Function(f) =>
                if has_wasm_attr(f):
                    wasm_exports.push(extract_export(f))
                    ()
                    wasm_items.push(item.clone())
                    ()
                else:
                    js_items.push(item.clone())
                    ()
            kain_core__types__TypedItem::Component(c) => if component_has_wasm_attr(c): none else: none
            kain_core__types__TypedItem::Struct(_) =>
                wasm_items.push(item.clone())
                ()
                js_items.push(item.clone())
                ()
            kain_core__types__TypedItem::Enum(_) =>
                wasm_items.push(item.clone())
                ()
                js_items.push(item.clone())
                ()
            _ =>
                js_items.push(item.clone())
                ()
    ()
    let wasm_program = kain_core::types::TypedProgram { items: wasm_items }
    let wasm_bytes = if (!wasm_program.items.is_empty()):
        codegen_wasm__generate(&wasm_program)?
    else:
        Vec__new_()
    let js_program = kain_core::types::TypedProgram { items: js_items }
    let mut js_code = codegen_js__generate(&js_program)?
    let mut ts_code = codegen_ts__generate(&js_program)?
    if (!wasm_exports.is_empty()):
        let runtime = generate_hybrid_runtime(&wasm_exports)
        js_code = f"{runtime}\n\n{js_code}"
        ()
        ts_code = f"{runtime}\n\n{ts_code}"
        ()
        ()
        ()
        ()
    Result::Ok(HybridOutput { wasm: wasm_bytes, js: js_code, ts: ts_code, wasm_exports: wasm_exports })

@doc(doc = " Generate the complete hybrid runtime with host imports and bindings")
fn generate_hybrid_runtime(exports: &[WasmExport]) -> String:
    let mut code = String__new_()
    code.push_str("// ══════════════════════════════════════════════════════════════════════════════\n")
    ()
    code.push_str("// KAIN Hybrid Runtime - Auto-generated WASM/JS bridge\n")
    ()
    code.push_str("// ══════════════════════════════════════════════════════════════════════════════\n\n")
    ()
    code.push_str("let __wasmInstance = null;\n")
    ()
    code.push_str("let __wasmMemory = null;\n")
    ()
    code.push_str("let __wasmReady = false;\n")
    ()
    code.push_str("let __wasmReadyPromise = null;\n")
    ()
    code.push_str("const __domNodes = new Map(); // node_id -> DOM element\n")
    ()
    code.push_str("let __nextNodeId = 1;\n\n")
    ()
    code.push_str(&generate_memory_helpers())
    ()
    code.push_str(&generate_host_imports())
    ()
    code.push_str(&generate_wasm_loader())
    ()
    code.push_str(&generate_function_bindings(exports))
    ()
    code.push_str("// Auto-initialize WASM on script load\n")
    ()
    code.push_str("__wasmReadyPromise = __initWasm();\n\n")
    ()
    code

@doc(doc = " Generate memory read/write helpers")
fn generate_memory_helpers() -> String:
    ("// ─────────────────────────────────────────────────────────────────────────────\n// Memory Helpers\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction __readString(ptr) {\n    if (!__wasmMemory || ptr === 0) return '';\n    const view = new DataView(__wasmMemory.buffer);\n    const len = view.getInt32(ptr, true);\n    const bytes = new Uint8Array(__wasmMemory.buffer, ptr + 4, len);\n    return new TextDecoder().decode(bytes);\n}\n\nfunction __writeString(str) {\n    if (!__wasmMemory) return 0;\n    const encoded = new TextEncoder().encode(str);\n    const len = encoded.length;\n    // Allocate: 4 bytes for length + string bytes\n    const ptr = __wasmAlloc(4 + len);\n    const view = new DataView(__wasmMemory.buffer);\n    view.setInt32(ptr, len, true);\n    new Uint8Array(__wasmMemory.buffer).set(encoded, ptr + 4);\n    return ptr;\n}\n\nfunction __readArray(ptr, elemSize, readElem) {\n    if (!__wasmMemory || ptr === 0) return [];\n    const view = new DataView(__wasmMemory.buffer);\n    const len = view.getInt32(ptr, true);\n    const result = [];\n    for (let i = 0; i < len; i++) {\n        result.push(readElem(view, ptr + 4 + i * elemSize));\n    }\n    return result;\n}\n\nfunction __wasmAlloc(size) {\n    // Use the WASM heap pointer global if exported, otherwise bump allocate\n    if (__wasmInstance && __wasmInstance.exports.__alloc) {\n        return __wasmInstance.exports.__alloc(size);\n    }\n    // Fallback: read/update heap pointer from WASM globals\n    // This assumes heap_ptr is at a known location - we'll use a simple bump\n    console.warn('Using fallback allocator - no __alloc export');\n    return 0;\n}\n\n").to_string()

@doc(doc = " Generate host import implementations")
fn generate_host_imports() -> String:
    ("// ─────────────────────────────────────────────────────────────────────────────\n// Host Import Implementations\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst __hostImports = {\n    host: {\n        // Print integer\n        print_i64(val) {\n            console.log(Number(val));\n        },\n        \n        // Print float\n        print_f64(val) {\n            console.log(val);\n        },\n        \n        // Print string from WASM memory\n        print_str(ptr, len) {\n            if (!__wasmMemory) return;\n            const bytes = new Uint8Array(__wasmMemory.buffer, ptr, len);\n            console.log(new TextDecoder().decode(bytes));\n        },\n        \n        // Print boolean\n        print_bool(val) {\n            console.log(val !== 0);\n        },\n        \n        // Read integer from prompt\n        read_i64() {\n            const input = prompt('Enter a number:');\n            return BigInt(parseInt(input) || 0);\n        },\n        \n        // Integer to string - returns pointer to new string in WASM memory\n        int_to_str(val) {\n            return __writeString(String(Number(val)));\n        },\n        \n        // Concatenate two strings - returns pointer to new string\n        str_concat(ptr1, ptr2) {\n            const s1 = __readString(ptr1);\n            const s2 = __readString(ptr2);\n            return __writeString(s1 + s2);\n        },\n        \n        // Get current time in milliseconds\n        time_now() {\n            return BigInt(Date.now());\n        },\n        \n        // DOM: Create element\n        dom_create(tagPtr, tagLen) {\n            const bytes = new Uint8Array(__wasmMemory.buffer, tagPtr, tagLen);\n            const tag = new TextDecoder().decode(bytes);\n            const el = document.createElement(tag);\n            const id = __nextNodeId++;\n            __domNodes.set(id, el);\n            return id;\n        },\n        \n        // DOM: Append child\n        dom_append(parentId, childId) {\n            const parent = __domNodes.get(parentId);\n            const child = __domNodes.get(childId);\n            if (parent && child) {\n                parent.appendChild(child);\n            }\n        },\n        \n        // DOM: Set attribute\n        dom_attr(nodeId, keyPtr, keyLen, valPtr, valLen) {\n            const node = __domNodes.get(nodeId);\n            if (!node) return;\n            const key = new TextDecoder().decode(new Uint8Array(__wasmMemory.buffer, keyPtr, keyLen));\n            const val = new TextDecoder().decode(new Uint8Array(__wasmMemory.buffer, valPtr, valLen));\n            node.setAttribute(key, val);\n        },\n        \n        // DOM: Create text node\n        dom_text(textPtr, textLen) {\n            const text = new TextDecoder().decode(new Uint8Array(__wasmMemory.buffer, textPtr, textLen));\n            const node = document.createTextNode(text);\n            const id = __nextNodeId++;\n            __domNodes.set(id, node);\n            return id;\n        },\n    }\n};\n\n").to_string()

@doc(doc = " Generate the WASM loader function")
fn generate_wasm_loader() -> String:
    ("// ─────────────────────────────────────────────────────────────────────────────\n// WASM Loader\n// ─────────────────────────────────────────────────────────────────────────────\n\nasync function __initWasm() {\n    if (__wasmReady) return true;\n    \n    try {\n        const response = await fetch('main.wasm');\n        if (!response.ok) {\n            console.warn('[KAIN] No WASM module found, running in JS-only mode');\n            return false;\n        }\n        \n        const buffer = await response.arrayBuffer();\n        const result = await WebAssembly.instantiate(buffer, __hostImports);\n        \n        __wasmInstance = result.instance;\n        __wasmMemory = __wasmInstance.exports.memory;\n        __wasmReady = true;\n        \n        console.log('[KAIN] WASM module loaded successfully');\n        return true;\n    } catch (e) {\n        console.error('[KAIN] Failed to load WASM:', e);\n        return false;\n    }\n}\n\n// Ensure WASM is ready before calling WASM functions\nasync function __ensureWasm() {\n    if (__wasmReady) return true;\n    if (__wasmReadyPromise) {\n        return await __wasmReadyPromise;\n    }\n    return false;\n}\n\n").to_string()

@doc(doc = " Generate function bindings with type-aware marshaling")
fn generate_function_bindings(exports: &[WasmExport]) -> String:
    let mut code = String__new_()
    code.push_str("// ─────────────────────────────────────────────────────────────────────────────\n")
    ()
    code.push_str("// WASM Function Bindings\n")
    ()
    code.push_str("// ─────────────────────────────────────────────────────────────────────────────\n\n")
    ()
    for export_ in exports:
        code.push_str(&"function {export_.name}(...args) {\n")
        ()
        code.push_str("    if (!__wasmReady) {\n")
        ()
        code.push_str(&f"        console.warn('[KAIN] WASM not ready, {export_.name} call failed');\n")
        ()
        match &export_.return_type:
            Some(kain_core__types__ResolvedType::String) =>
                code.push_str("        return '';\n")
                ()
            Some(kain_core__types__ResolvedType::Bool) =>
                code.push_str("        return false;\n")
                ()
            Some(kain_core__types__ResolvedType::Array(_, _)) =>
                code.push_str("        return [];\n")
                ()
            _ =>
                code.push_str("        return 0;\n")
                ()
        code.push_str("    }\n")
        ()
        code.push_str("    try {\n")
        ()
        code.push_str(&f"        const result = __wasmInstance.exports.{export_.name}(...args);\n")
        ()
        match &export_.return_type:
            Some(kain_core__types__ResolvedType::String) =>
                code.push_str("        return __readString(result);\n")
                ()
                ()
                ()
                ()
            Some(kain_core__types__ResolvedType::Array(_, _)) =>
                code.push_str("        return __readArray(result, 8, (v, p) => Number(v.getBigInt64(p, true)));\n")
                ()
                ()
                ()
                ()
            _ =>
                code.push_str("        return result;\n")
                ()
                ()
                ()
                ()
        code.push_str("    } catch (e) {\n")
        ()
        code.push_str(&f"        console.error('[KAIN] Error calling {export_.name}:', e);\n")
        ()
        code.push_str("        throw new Error(`WASM function '")
        ()
        code.push_str(&export_.name)
        ()
        code.push_str("' failed: ${e.message}`);\n")
        ()
        code.push_str("    }\n")
        ()
        code.push_str("}\n\n")
        ()
        code.push_str(&"async function {export_.name}_async(...args) {\n")
        ()
        code.push_str("    await __ensureWasm();\n")
        ()
        code.push_str(&f"    return {export_.name}(...args);\n")
        ()
        code.push_str("}\n\n")
        ()
    ()
    code

