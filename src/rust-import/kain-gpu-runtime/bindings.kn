use ash::vk

pub enum GpuDescriptorKind:
    StorageBuffer
    UniformBuffer

impl GpuDescriptorKind:
    pub fn as_str(_self: GpuDescriptorKind) -> String:
        match _self:
            GpuDescriptorKind::StorageBuffer => "storage_buffer"
            GpuDescriptorKind::UniformBuffer => "uniform_buffer"

    pub fn descriptor_type(_self: GpuDescriptorKind) -> ash::vk::DescriptorType:
        match _self:
            GpuDescriptorKind::StorageBuffer => ash__vk__DescriptorType__STORAGE_BUFFER
            GpuDescriptorKind::UniformBuffer => ash__vk__DescriptorType__UNIFORM_BUFFER

    pub fn buffer_usage(_self: GpuDescriptorKind) -> ash::vk::BufferUsageFlags:
        match _self:
            GpuDescriptorKind::StorageBuffer => ash__vk__BufferUsageFlags__STORAGE_BUFFER
            GpuDescriptorKind::UniformBuffer => ash__vk__BufferUsageFlags__UNIFORM_BUFFER


pub enum GpuBindingAccess:
    Read
    Write
    ReadWrite

impl GpuBindingAccess:
    pub fn as_str(_self: GpuBindingAccess) -> String:
        match _self:
            GpuBindingAccess::Read => "read"
            GpuBindingAccess::Write => "write"
            GpuBindingAccess::ReadWrite => "read_write"

    pub fn is_output(_self: GpuBindingAccess) -> Bool:
        match _self:
            GpuBindingAccess::Write => true
            GpuBindingAccess::ReadWrite => true
            _ => false


@derive(Clone, Debug)
pub struct ComputeBinding:
    kind: GpuDescriptorKind
    bytes: Array<u8>

impl ComputeBinding:
    pub fn storage_f32(values: &[f32]) -> ComputeBinding:
        ComputeBinding__new_(GpuDescriptorKind__StorageBuffer, values.iter().flat_map(fn(value): value.to_le_bytes()).collect())

    pub fn storage_u32(values: &[u32]) -> ComputeBinding:
        ComputeBinding__new_(GpuDescriptorKind__StorageBuffer, values.iter().flat_map(fn(value): value.to_le_bytes()).collect())

    pub fn storage_i32(values: &[i32]) -> ComputeBinding:
        ComputeBinding__new_(GpuDescriptorKind__StorageBuffer, values.iter().flat_map(fn(value): value.to_le_bytes()).collect())

    pub fn uniform_f32(values: &[f32]) -> ComputeBinding:
        ComputeBinding__new_(GpuDescriptorKind__UniformBuffer, values.iter().flat_map(fn(value): value.to_le_bytes()).collect())

    pub fn uniform_u32(values: &[u32]) -> ComputeBinding:
        ComputeBinding__new_(GpuDescriptorKind__UniformBuffer, values.iter().flat_map(fn(value): value.to_le_bytes()).collect())

    pub fn storage_bytes(bytes: Array<u8>) -> ComputeBinding:
        ComputeBinding__new_(GpuDescriptorKind__StorageBuffer, bytes)

    pub fn uniform_bytes(bytes: Array<u8>) -> ComputeBinding:
        ComputeBinding__new_(GpuDescriptorKind__UniformBuffer, bytes)

    pub fn kind(_self: &ComputeBinding) -> GpuDescriptorKind:
        (*_self).kind

    pub fn to_bytes(_self: &ComputeBinding) -> Array<u8>:
        (*_self).bytes.clone()

    fn new_(kind: GpuDescriptorKind, bytes: Array<u8>) -> ComputeBinding:
        ComputeBinding { kind: kind, bytes: bytes }


@derive(Clone, Debug)
pub struct GpuDispatchBinding:
    key: String
    binding_slot: u32
    descriptor_kind: GpuDescriptorKind
    access: GpuBindingAccess
    bytes: Array<u8>
    element_type: String
    shape: Array<i64>
    strides: Array<i64>

@derive(Clone, Debug)
pub struct GpuDispatchRequest:
    module_name: String
    entry_point: String
    workgroup_size: [u32; 3]
    dispatch_size: [u32; 3]
    bindings: Array<GpuDispatchBinding>
    tensor_binding_count: usize
    stream_binding_count: usize
    neural_node_count: usize

@derive(Clone, Debug, Default)
pub struct GpuDispatchResult:
    dispatch_invocations: u64
    output_bindings: Array<(u32, Array<u8>)>
    tensor_binding_count: usize
    stream_binding_count: usize
    neural_node_count: usize

impl Default for GpuDispatchResult:
    pub fn default_() -> GpuDispatchResult:
        GpuDispatchResult { dispatch_invocations: 0, output_bindings: Vec__new_(), tensor_binding_count: 0, stream_binding_count: 0, neural_node_count: 0 }


pub enum ExpectedOutput:
    F32 { values: Array<f32>, epsilon: f32 }
    U32(Array<u32>)
    I32(Array<i32>)

impl ExpectedOutput:
    pub fn byte_len(_self: &ExpectedOutput) -> usize:
        match *_self:
            ExpectedOutput::F32 { values: values } => (values.len() * std__mem__size_of())
            ExpectedOutput::U32(values) => (values.len() * std__mem__size_of())
            ExpectedOutput::I32(values) => (values.len() * std__mem__size_of())

    pub fn assert_matches(_self: &ExpectedOutput, bytes: &[u8]):
        match *_self:
            ExpectedOutput::F32 { values: values, epsilon: epsilon } =>
                let actual = decode_f32s(bytes)
                approx_eq_slice(&actual, values, (*epsilon))
                ()
            ExpectedOutput::U32(values) =>
                let actual = decode_u32s(bytes)
                if (actual != (*values)):
                    panic("u32 output mismatch")
            ExpectedOutput::I32(values) =>
                let actual = decode_i32s(bytes)
                if (actual != (*values)):
                    panic("i32 output mismatch")


@derive(Clone, Debug)
pub struct ComputeCase:
    name: String
    invocation_count: u32
    bindings: Array<ComputeBinding>
    output_binding: usize
    expected_output: ExpectedOutput

fn decode_f32s(bytes: &[u8]) -> Array<f32>:
    if ((bytes.len() % 4) != 0):
        panic("f32 byte slice length must be divisible by 4")
    bytes.chunks_exact(4).map(fn(chunk): f32__from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]])).collect()

fn decode_u32s(bytes: &[u8]) -> Array<u32>:
    if ((bytes.len() % 4) != 0):
        panic("u32 byte slice length must be divisible by 4")
    bytes.chunks_exact(4).map(fn(chunk): u32__from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]])).collect()

fn decode_i32s(bytes: &[u8]) -> Array<i32>:
    if ((bytes.len() % 4) != 0):
        panic("i32 byte slice length must be divisible by 4")
    bytes.chunks_exact(4).map(fn(chunk): i32__from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]])).collect()

fn approx_eq_slice(actual: &[f32], expected: &[f32], epsilon: f32):
    if (actual.len() != expected.len()):
        panic("slice length mismatch")
    for selfhost_for_item in actual.iter().zip(expected.iter()).enumerate():
        let (index, (a, e)) = selfhost_for_item
        let delta = ((a - e)).abs()
        if (!(delta <= epsilon)):
            panic(f"value mismatch at index {index}: actual={a}, expected={e}, delta={delta}, epsilon={epsilon}")

