use crate::config_ir::ConfigField

use crate::config_ir::ConfigStruct

use kain_core::ast::Type

@doc(doc = " Generate Blueprint getter function declaration for header")
pub fn generate_blueprint_getter_declaration(config: &ConfigStruct, field: &ConfigField) -> String:
    let category = f"{(*config).name} Settings"
    let getter_name = f"Get{field.ue5_property_name()}"
    let return_type = map_type_to_cpp(&(*field).ty)
    let property_name = field.ue5_property_name()
    f"\t/** Get {property_name} */\n\tUFUNCTION(BlueprintCallable, Category=\"{category}\")\n\tstatic {return_type} {getter_name}();"

@doc(doc = " Generate Blueprint setter function declaration for header (if writable)")
pub fn generate_blueprint_setter_declaration(config: &ConfigStruct, field: &ConfigField) -> Option<String>:
    if (!(*field).writable):
        return none
    let category = f"{(*config).name} Settings"
    let setter_name = f"Set{field.ue5_property_name()}"
    let param_type = map_type_to_cpp(&(*field).ty)
    let property_name = field.ue5_property_name()
    let param_decl = if is_string_type(&(*field).ty):
        f"const {param_type}& NewValue"
    else:
        f"{param_type} NewValue"
    Option::Some(f"\t/** Set {property_name} */\n\tUFUNCTION(BlueprintCallable, Category=\"{category}\")\n\tstatic void {setter_name}({param_decl});")

@doc(doc = " Generate Blueprint getter function implementation for cpp")
pub fn generate_blueprint_getter_implementation(config: &ConfigStruct, field: &ConfigField) -> String:
    let class_name = config.ue5_class_name()
    let getter_name = f"Get{field.ue5_property_name()}"
    let return_type = map_type_to_cpp(&(*field).ty)
    let property_name = field.ue5_property_name()
    "{return_type} {class_name}::{getter_name}()\n{\n\treturn Get()->{property_name};\n}"

@doc(doc = " Generate Blueprint setter function implementation for cpp (if writable)")
pub fn generate_blueprint_setter_implementation(config: &ConfigStruct, field: &ConfigField) -> Option<String>:
    if (!(*field).writable):
        return none
    let class_name = config.ue5_class_name()
    let setter_name = f"Set{field.ue5_property_name()}"
    let param_type = map_type_to_cpp(&(*field).ty)
    let property_name = field.ue5_property_name()
    let param_decl = if is_string_type(&(*field).ty):
        f"const {param_type}& NewValue"
    else:
        f"{param_type} NewValue"
    Option::Some("void {class_name}::{setter_name}({param_decl})\n{\n\t{class_name}* Settings = GetMutableDefault<{class_name}>();\n\tSettings->{property_name} = NewValue;\n\tSettings->SaveConfig();\n}")

@doc(doc = " Generate all Blueprint accessor declarations for header")
pub fn generate_blueprint_accessors_header(config: &ConfigStruct) -> Array<String>:
    let mut declarations = Vec__new_()
    for field in &(*config).fields:
        if (!field.blueprint):
            continue
        declarations.push(generate_blueprint_getter_declaration(config, field))
        ()
        match generate_blueprint_setter_declaration(config, field):
            Some(setter) =>
                declarations.push(setter)
                ()
            _ => ()
    ()
    declarations

@doc(doc = " Generate all Blueprint accessor implementations for cpp")
pub fn generate_blueprint_accessors_cpp(config: &ConfigStruct) -> Array<String>:
    let mut implementations = Vec__new_()
    for field in &(*config).fields:
        if (!field.blueprint):
            continue
        implementations.push(generate_blueprint_getter_implementation(config, field))
        ()
        match generate_blueprint_setter_implementation(config, field):
            Some(setter) =>
                implementations.push(setter)
                ()
            _ => ()
    ()
    implementations

@doc(doc = " Map KAIN type to UE5 C++ type")
fn map_type_to_cpp(ty: &kain_core::ast::Type) -> String:
    match ty:
        kain_core__ast__Type::Named { name: name } =>
            match name.as_str():
                "Float" => "float"
                "Int" => "int32"
                "Bool" => "bool"
                "String" => "FString"
                _ => "float"
        _ => "float"

@doc(doc = " Check if type is FString (needs const ref for parameters)")
fn is_string_type(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } => (name == "String")
        _ => false

