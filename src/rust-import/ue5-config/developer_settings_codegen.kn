use crate::config_ir::ConfigStruct

use kain_core::ast::Expr

use kain_core::ast::Type

use kain_core::error::KainError

use kain_core::error::KainResult

use minijinja::context

use minijinja::Environment

@doc(doc = " Output structure for developer settings codegen")
@derive(Debug, Clone)
pub struct DeveloperSettingsOutput:
    header: String
    source: String

@doc(doc = " Generate complete C++ code for a UDeveloperSettings subclass")
pub fn generate(config: &ConfigStruct, plugin_name: String) -> Result<DeveloperSettingsOutput, KainError>:
    let header = generate_developer_settings_header(config, plugin_name)?
    let source = generate_developer_settings_cpp(config, plugin_name)?
    Result::Ok(DeveloperSettingsOutput { header: header, source: source })

@doc(doc = " Generate header file (.h)")
pub fn generate_developer_settings_header(config: &ConfigStruct, plugin_name: String) -> Result<String, KainError>:
    let mut env = Environment__new_()
    env.add_template("developer_settings.h", include_str!("templates/developer_settings.h.jinja")).map_err(fn(e): KainError__codegen_error(f"Failed to add template: {e}"))?
    ()
    let template_ = env.get_template("developer_settings.h").map_err(fn(e): KainError__codegen_error(f"Failed to get template: {e}"))?
    let class_name = config.ue5_class_name()
    let api_macro = f"{plugin_name.to_uppercase()}_API"
    let display_name = config.get_display_name()
    let config_category = (*config).category.uclass_specifier()
    let fields: Array<_> = (*config).fields.iter().map(fn(field): none).collect()
    let ctx = context!()
    template_.render(ctx).map_err(fn(e): KainError__codegen_error(f"Failed to render template: {e}"))

@doc(doc = " Generate implementation file (.cpp)")
pub fn generate_developer_settings_cpp(config: &ConfigStruct, _plugin_name: String) -> Result<String, KainError>:
    let mut env = Environment__new_()
    env.add_template("developer_settings.cpp", include_str!("templates/developer_settings.cpp.jinja")).map_err(fn(e): KainError__codegen_error(f"Failed to add template: {e}"))?
    ()
    let template_ = env.get_template("developer_settings.cpp").map_err(fn(e): KainError__codegen_error(f"Failed to get template: {e}"))?
    let class_name = config.ue5_class_name()
    let display_name = config.get_display_name()
    let fields: Array<_> = (*config).fields.iter().map(fn(field): none).collect()
    let ctx = context!()
    template_.render(ctx).map_err(fn(e): KainError__codegen_error(f"Failed to render template: {e}"))

@doc(doc = " Map KAIN type to C++ type")
fn map_type_to_cpp(ty: &kain_core::ast::Type) -> String:
    match ty:
        kain_core__ast__Type::Named { name: name } =>
            match name.as_str():
                "Float" => ("float").to_string()
                "Int" => ("int32").to_string()
                "Bool" => ("bool").to_string()
                "String" => ("FString").to_string()
                other => other.to_string()
        _ => ("float").to_string()

@doc(doc = " Format default value expression to C++ literal")
fn format_default_value(expr: &kain_core::ast::Expr, ty: &kain_core::ast::Type) -> String:
    match expr:
        kain_core__ast__Expr::Float(val, _) =>
            let s = val.to_string()
            if s.contains("."):
                f"{s}f"
            else:
                f"{s}.0f"
        kain_core__ast__Expr::Int(val, _) => val.to_string()
        kain_core__ast__Expr::Bool(val, _) => if (*val): ("true").to_string() else: ("false").to_string()
        kain_core__ast__Expr::String(val, _) => f"TEXT(\"{val}\")"
        _ => get_default_value_for_type(ty)

@doc(doc = " Get default value for a type when no explicit default is provided")
fn get_default_value_for_type(ty: &kain_core::ast::Type) -> String:
    match ty:
        kain_core__ast__Type::Named { name: name } =>
            match name.as_str():
                "Float" => ("0.0f").to_string()
                "Int" => ("0").to_string()
                "Bool" => ("false").to_string()
                "String" => ("TEXT(\"\")").to_string()
                _ => ("{}").to_string()
        _ => ("{}").to_string()

