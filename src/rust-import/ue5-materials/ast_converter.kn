use crate::material_graph::*

use kain_core::ast::BinaryOp

use kain_core::ast::CallArg

use kain_core::ast::Expr

use kain_core::ast::MaterialGraphDef

use kain_core::ast::MaterialInput

use kain_core::ast::MaterialOutput

use kain_core::ast::MaterialStatement

use kain_core::ast::Type

use std::collections::HashMap

@doc(doc = " Converts KAIN AST material graph definitions to MaterialGraph IR")
pub struct MaterialGraphConverter:
    node_counter: usize
    variable_map: Map<String, String>
    default_uv_node: Option<String>
    time_node_id: Option<String>
    texture_param_nodes: Map<String, String>

impl MaterialGraphConverter:
    pub fn new_() -> MaterialGraphConverter:
        MaterialGraphConverter { node_counter: 0, variable_map: HashMap__new_(), default_uv_node: none, time_node_id: none, texture_param_nodes: HashMap__new_() }

    fn type_to_string(ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } => if generics.is_empty(): name.clone() else: "{name}< {generics.iter().map(fn(g): MaterialGraphConverter__type_to_string(g)).collect().join(\", \")} >"
            kain_core__ast__Type::Array(element, _, _) => f"Array<{MaterialGraphConverter__type_to_string(element)}>"
            kain_core__ast__Type::Option(inner, _) => f"Option<{MaterialGraphConverter__type_to_string(inner)}>"
            kain_core__ast__Type::Result(ok, err, _) => f"Result<{MaterialGraphConverter__type_to_string(ok)}, {MaterialGraphConverter__type_to_string(err)}>"
            kain_core__ast__Type::Tuple(elements, _) => "({elements.iter().map(fn(e): MaterialGraphConverter__type_to_string(e)).collect().join(\", \")})"
            kain_core__ast__Type::Function { params: params, return_type: return_type } => "fn({params.iter().map(fn(p): MaterialGraphConverter__type_to_string(p)).collect().join(\", \")}) -> {MaterialGraphConverter__type_to_string(return_type)}"
            kain_core__ast__Type::Slice(inner, _) => f"[{MaterialGraphConverter__type_to_string(inner)}]"
            kain_core__ast__Type::Ref { mutable_: mutable_, inner: inner } => if (*mutable_): f"&mut {MaterialGraphConverter__type_to_string(inner)}" else: f"&{MaterialGraphConverter__type_to_string(inner)}"
            kain_core__ast__Type::Ptr { mutable_: mutable_, inner: inner } => if (*mutable_): f"ptr_mut<{MaterialGraphConverter__type_to_string(inner)}>" else: f"ptr<{MaterialGraphConverter__type_to_string(inner)}>"
            kain_core__ast__Type::Never(_) => ("!").to_string()
            kain_core__ast__Type::Unit(_) => ("()").to_string()
            kain_core__ast__Type::Impl { trait_name: trait_name, generics: generics } => if generics.is_empty(): f"impl {trait_name}" else: "impl {trait_name}<{generics.iter().map(fn(g): MaterialGraphConverter__type_to_string(g)).collect().join(\", \")}>"
            kain_core__ast__Type::Infer {  } => ("_").to_string()

    pub fn convert(_self: &mut MaterialGraphConverter, def: &kain_core::ast::MaterialGraphDef) -> Result<MaterialGraph, String>:
        let mut graph = MaterialGraph__new_((*def).name.clone())
        graph.properties = (*_self).extract_properties(&(*def).attributes)?
        ()
        for input in &(*def).inputs:
            let node_id = (*_self).create_input_node(&mut graph, input)?
            (*_self).variable_map.insert(input.name.clone(), node_id)
            ()
        ()
        if graph.properties.expose_parameters:
            for input in &(*def).inputs:
                if (none):
                    let _ = graph.mark_parameter_dynamic(&input.name)
            ()
            ()
        for stmt in &(*def).body:
            match stmt:
                kain_core__ast__MaterialStatement::Let { name: name, value: value } =>
                    let node_id = (*_self).convert_expr(&mut graph, value)?
                    (*_self).variable_map.insert(name.clone(), node_id)
                    ()
        ()
        for output in &(*def).outputs:
            let node_id = (*_self).convert_expr(&mut graph, &output.value)?
            (*_self).set_output(&mut graph, &output.name, node_id)?
            ()
        ()
        Result::Ok(graph)

    fn next_node_id(_self: &mut MaterialGraphConverter) -> String:
        let id = f"node_{(*_self).node_counter}"
        (*_self).node_counter = ((*_self).node_counter + 1)
        ()
        id

    fn create_input_node(_self: &mut MaterialGraphConverter, graph: &mut MaterialGraph, input: &kain_core::ast::MaterialInput) -> Result<String, String>:
        let node_id = (*_self).next_node_id()
        let x = (-400)
        let y = (((*graph).nodes.len() as i32) * 100)
        let node = match &(*input).ty:
            kain_core__ast__Type::Named { name: name } if (name == "Float") =>
                let default_ = (*_self).extract_float_default(&(*input).default_)?
                MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::ScalarParameter { name: (*input).name.clone(), default_: default_ }, position: (x, y) }
            kain_core__ast__Type::Named { name: name } if (name == "Vec3") =>
                let default_ = (*_self).extract_vec3_default(&(*input).default_)?
                MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::VectorParameter { name: (*input).name.clone(), default_: default_ }, position: (x, y) }
            kain_core__ast__Type::Named { name: name } if (name == "Vec4") =>
                let default_ = (*_self).extract_vec4_default(&(*input).default_)?
                MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::VectorParameter { name: (*input).name.clone(), default_: [default_[0], default_[1], default_[2]] }, position: (x, y) }
            kain_core__ast__Type::Named { name: name } if (name == "Sampler2D") => MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::TextureSampleParameter2D { param_name: (*input).name.clone(), default_texture: none, uv_input: none }, position: (x, y) }
            _ => return Result::Err(f"Unsupported input type: {MaterialGraphConverter__type_to_string(&(*input).ty)}")
        (*graph).nodes.push(node)
        ()
        Result::Ok(node_id)

    fn convert_expr(_self: &mut MaterialGraphConverter, graph: &mut MaterialGraph, expr: &kain_core::ast::Expr) -> Result<String, String>:
        match expr:
            kain_core__ast__Expr::Ident(name, _) => (*_self).variable_map.get(name).cloned().ok_or_else(fn(): f"Undefined variable: {name}")
            kain_core__ast__Expr::Binary { op: op, left: left, right: right } =>
                let left_id = (*_self).convert_expr(graph, left)?
                let right_id = (*_self).convert_expr(graph, right)?
                let node_id = (*_self).next_node_id()
                let x = (-200)
                let y = (((*graph).nodes.len() as i32) * 100)
                let node_type = match op:
                    kain_core__ast__BinaryOp::Mul => MaterialNodeType::Multiply { a: left_id, b: right_id }
                    kain_core__ast__BinaryOp::Add => MaterialNodeType::Add { a: left_id, b: right_id }
                    kain_core__ast__BinaryOp::Sub => MaterialNodeType::Subtract { a: left_id, b: right_id }
                    kain_core__ast__BinaryOp::Div => MaterialNodeType::Divide { a: left_id, b: right_id }
                    _ =>
                        let op_name = match op:
                            kain_core__ast__BinaryOp::Eq => "=="
                            kain_core__ast__BinaryOp::Ne => "!="
                            kain_core__ast__BinaryOp::Lt => "<"
                            kain_core__ast__BinaryOp::Gt => ">"
                            kain_core__ast__BinaryOp::Le => "<="
                            kain_core__ast__BinaryOp::Ge => ">="
                            kain_core__ast__BinaryOp::And => "&&"
                            kain_core__ast__BinaryOp::Or => "||"
                            kain_core__ast__BinaryOp::Mod => "%"
                            kain_core__ast__BinaryOp::Pow => "**"
                            _ => "<unknown>"
                        return Result::Err(f"Unsupported binary op: '{op_name}'")
                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: node_type, position: (x, y) })
                ()
                Result::Ok(node_id)
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                match &(*(*callee)):
                    kain_core__ast__Expr::Ident(name, _) =>
                        match name.as_str():
                            "time" =>
                                if (!args.is_empty()):
                                    return Result::Err(f"time() expects 0 arguments, got {args.len()}")
                                let node_id = (*_self).create_time_node(graph)
                                Result::Ok(node_id)
                            "sin" =>
                                if (args.len() != 1):
                                    return Result::Err(f"sin() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Sine { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "cos" =>
                                if (args.len() != 1):
                                    return Result::Err(f"cos() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Cosine { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "lerp" =>
                                if (args.len() != 3):
                                    return Result::Err(f"lerp() expects 3 arguments (a, b, alpha), got {args.len()}")
                                let a_id = (*_self).convert_expr(graph, &args[0].value)?
                                let b_id = (*_self).convert_expr(graph, &args[1].value)?
                                let alpha_id = (*_self).convert_expr(graph, &args[2].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Lerp { a: a_id, b: b_id, alpha: alpha_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "clamp" =>
                                if (args.len() != 3):
                                    return Result::Err(f"clamp() expects 3 arguments (input, min, max), got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let min_id = (*_self).convert_expr(graph, &args[1].value)?
                                let max_id = (*_self).convert_expr(graph, &args[2].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Clamp { input: input_id, min: min_id, max: max_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "pow" =>
                                if (args.len() != 2):
                                    return Result::Err(f"pow() expects 2 arguments (base, exponent), got {args.len()}")
                                let base_id = (*_self).convert_expr(graph, &args[0].value)?
                                let exp_id = (*_self).convert_expr(graph, &args[1].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Power { base: base_id, exponent: exp_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "dot" =>
                                if (args.len() != 2):
                                    return Result::Err(f"dot() expects 2 arguments, got {args.len()}")
                                let a_id = (*_self).convert_expr(graph, &args[0].value)?
                                let b_id = (*_self).convert_expr(graph, &args[1].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Dot { a: a_id, b: b_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "cross" =>
                                if (args.len() != 2):
                                    return Result::Err(f"cross() expects 2 arguments, got {args.len()}")
                                let a_id = (*_self).convert_expr(graph, &args[0].value)?
                                let b_id = (*_self).convert_expr(graph, &args[1].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Cross { a: a_id, b: b_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "normalize" =>
                                if (args.len() != 1):
                                    return Result::Err(f"normalize() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Normalize { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "length" =>
                                if (args.len() != 1):
                                    return Result::Err(f"length() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Length { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "distance" =>
                                if (args.len() != 2):
                                    return Result::Err(f"distance() expects 2 arguments, got {args.len()}")
                                let a_id = (*_self).convert_expr(graph, &args[0].value)?
                                let b_id = (*_self).convert_expr(graph, &args[1].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Distance { a: a_id, b: b_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "abs" =>
                                if (args.len() != 1):
                                    return Result::Err(f"abs() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Abs { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "min" =>
                                if (args.len() != 2):
                                    return Result::Err(f"min() expects 2 arguments, got {args.len()}")
                                let a_id = (*_self).convert_expr(graph, &args[0].value)?
                                let b_id = (*_self).convert_expr(graph, &args[1].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Min { a: a_id, b: b_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "max" =>
                                if (args.len() != 2):
                                    return Result::Err(f"max() expects 2 arguments, got {args.len()}")
                                let a_id = (*_self).convert_expr(graph, &args[0].value)?
                                let b_id = (*_self).convert_expr(graph, &args[1].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Max { a: a_id, b: b_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "saturate" =>
                                if (args.len() != 1):
                                    return Result::Err(f"saturate() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Saturate { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "frac" =>
                                if (args.len() != 1):
                                    return Result::Err(f"frac() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Frac { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "floor" =>
                                if (args.len() != 1):
                                    return Result::Err(f"floor() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Floor { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "ceil" =>
                                if (args.len() != 1):
                                    return Result::Err(f"ceil() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Ceil { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "round" =>
                                if (args.len() != 1):
                                    return Result::Err(f"round() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Round { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "sqrt" =>
                                if (args.len() != 1):
                                    return Result::Err(f"sqrt() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Sqrt { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "exp" =>
                                if (args.len() != 1):
                                    return Result::Err(f"exp() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Exp { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "log" =>
                                if (args.len() != 1):
                                    return Result::Err(f"log() expects 1 argument, got {args.len()}")
                                let input_id = (*_self).convert_expr(graph, &args[0].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::Log { input: input_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "sample" =>
                                if (args.is_empty() || (args.len() > 2)):
                                    return Result::Err(f"sample() expects 1 or 2 arguments (texture, [uv]), got {args.len()}")
                                let texture_arg = &args[0].value
                                let texture_name = match texture_arg:
                                    kain_core__ast__Expr::Ident(name, _) => name.clone()
                                    _ => return Result::Err(("sample() first argument must be a texture input variable").to_string())
                                let uv_id = if (args.len() == 2):
                                    (*_self).convert_expr(graph, &args[1].value)?
                                else:
                                    (*_self).create_default_uv_node(graph)
                                let cache_key = f"{texture_name}_{uv_id}"
                                match (*_self).texture_param_nodes.get(&cache_key):
                                    Some(existing_node_id) => return Result::Ok(existing_node_id.clone())
                                    _ =>
                                        ()
                                        ()
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::TextureSampleParameter2D { param_name: texture_name, default_texture: none, uv_input: Option::Some(uv_id) }, position: (x, y) })
                                ()
                                (*_self).texture_param_nodes.insert(cache_key, node_id.clone())
                                ()
                                Result::Ok(node_id)
                            "texture_sample" =>
                                if (args.is_empty() || (args.len() > 2)):
                                    return Result::Err(f"sample() expects 1 or 2 arguments (texture, [uv]), got {args.len()}")
                                let texture_arg = &args[0].value
                                let texture_name = match texture_arg:
                                    kain_core__ast__Expr::Ident(name, _) => name.clone()
                                    _ => return Result::Err(("sample() first argument must be a texture input variable").to_string())
                                let uv_id = if (args.len() == 2):
                                    (*_self).convert_expr(graph, &args[1].value)?
                                else:
                                    (*_self).create_default_uv_node(graph)
                                let cache_key = f"{texture_name}_{uv_id}"
                                match (*_self).texture_param_nodes.get(&cache_key):
                                    Some(existing_node_id) => return Result::Ok(existing_node_id.clone())
                                    _ =>
                                        ()
                                        ()
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::TextureSampleParameter2D { param_name: texture_name, default_texture: none, uv_input: Option::Some(uv_id) }, position: (x, y) })
                                ()
                                (*_self).texture_param_nodes.insert(cache_key, node_id.clone())
                                ()
                                Result::Ok(node_id)
                            "vec3" =>
                                if (args.len() == 3):
                                    let x = (*_self).extract_float_from_expr(&args[0].value)?
                                    let y = (*_self).extract_float_from_expr(&args[1].value)?
                                    let z = (*_self).extract_float_from_expr(&args[2].value)?
                                    let node_id = (*_self).next_node_id()
                                    let pos_x = (-400)
                                    let pos_y = (((*graph).nodes.len() as i32) * 100)
                                    (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::ConstantVec3 { value: [x, y, z] }, position: (pos_x, pos_y) })
                                    ()
                                    Result::Ok(node_id)
                                else:
                                    Result::Err(f"vec3() expects 3 arguments, got {args.len()}")
                            "vec4" =>
                                if (args.len() == 4):
                                    let x = (*_self).extract_float_from_expr(&args[0].value)?
                                    let y = (*_self).extract_float_from_expr(&args[1].value)?
                                    let z = (*_self).extract_float_from_expr(&args[2].value)?
                                    let w = (*_self).extract_float_from_expr(&args[3].value)?
                                    let node_id = (*_self).next_node_id()
                                    let pos_x = (-400)
                                    let pos_y = (((*graph).nodes.len() as i32) * 100)
                                    (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::ConstantVec4 { value: [x, y, z, w] }, position: (pos_x, pos_y) })
                                    ()
                                    Result::Ok(node_id)
                                else:
                                    Result::Err(f"vec4() expects 4 arguments, got {args.len()}")
                            "call_shader" =>
                                if args.is_empty():
                                    return Result::Err(("call_shader() requires at least 1 argument (shader name)").to_string())
                                let shader_name = match &args[0].value:
                                    kain_core__ast__Expr::String(s, _) => s.clone()
                                    kain_core__ast__Expr::Ident(s, _) => s.clone()
                                    _ => return Result::Err(("call_shader() first argument must be a string literal or identifier").to_string())
                                let mut input_ids = Vec__new_()
                                for arg in &args[1..]:
                                    let input_id = (*_self).convert_expr(graph, &arg.value)?
                                    input_ids.push(input_id)
                                    ()
                                ()
                                let function_path = (*_self).resolve_shader_path(&shader_name)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::MaterialFunctionCall { function_path: function_path, inputs: input_ids }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "custom_hlsl" =>
                                if args.is_empty():
                                    return Result::Err(("custom_hlsl() requires at least 1 argument (HLSL code)").to_string())
                                let code = match &args[0].value:
                                    kain_core__ast__Expr::String(s, _) => s.clone()
                                    _ => return Result::Err(("custom_hlsl() first argument must be a string literal").to_string())
                                let mut output_type = CustomOutputType__Float3
                                let mut inputs = Vec__new_()
                                for arg in &args[1..]:
                                    match arg.name:
                                        Some("output_type") =>
                                            let type_str = match &arg.value:
                                                kain_core__ast__Expr::String(s, _) => s.as_str()
                                                _ => return Result::Err(("output_type must be a string literal").to_string())
                                            output_type = none
                                            ()
                                        Some("inputs") =>
                                            let input_array = match &arg.value:
                                                kain_core__ast__Expr::Array(items, _) => items
                                                _ => return Result::Err(("inputs must be an array literal").to_string())
                                            for item in input_array:
                                                let (input_name, input_type_str) = match item:
                                                    kain_core__ast__Expr::Tuple(elements, _) if (elements.len() == 2) =>
                                                        let name = match &elements[0]:
                                                            kain_core__ast__Expr::Ident(n, _) => n.clone()
                                                            _ => return Result::Err(("Input name must be an identifier").to_string())
                                                        let type_str = match &elements[1]:
                                                            kain_core__ast__Expr::String(s, _) => s.as_str()
                                                            _ => return Result::Err(("Input type must be a string literal").to_string())
                                                        (name, type_str)
                                                    _ => return Result::Err(("Each input must be a tuple (name, type)").to_string())
                                                let input_type = match input_type_str:
                                                    "float1" => CustomOutputType__Float1
                                                    "float" => CustomOutputType__Float1
                                                    "float2" => CustomOutputType__Float2
                                                    "float3" => CustomOutputType__Float3
                                                    "float4" => CustomOutputType__Float4
                                                    _ => return Result::Err(f"Invalid input type: '{input_type_str}'. Must be 'float1', 'float2', 'float3', or 'float4'")
                                                inputs.push(CustomInput { name: input_name, input_type: input_type })
                                                ()
                                        Some(other) => return Result::Err(f"Unknown named argument for custom_hlsl(): '{other}'")
                                        None => return Result::Err(("custom_hlsl() arguments after the first must be named (output_type: ..., inputs: ...)").to_string())
                                ()
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::CustomHLSL { code: code, output_type: output_type, inputs: inputs }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "uv_scroll" =>
                                if (args.len() != 3):
                                    return Result::Err(f"uv_scroll() expects 3 arguments (uv, offset_x, offset_y), got {args.len()}")
                                let uv_id = (*_self).convert_expr(graph, &args[0].value)?
                                let offset_x_id = (*_self).convert_expr(graph, &args[1].value)?
                                let offset_y_id = (*_self).convert_expr(graph, &args[2].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::UVScroll { uv_input: uv_id, offset_x: offset_x_id, offset_y: offset_y_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "uv_scale" =>
                                if (args.len() != 3):
                                    return Result::Err(f"uv_scale() expects 3 arguments (uv, scale_x, scale_y), got {args.len()}")
                                let uv_id = (*_self).convert_expr(graph, &args[0].value)?
                                let scale_x_id = (*_self).convert_expr(graph, &args[1].value)?
                                let scale_y_id = (*_self).convert_expr(graph, &args[2].value)?
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::UVScale { uv_input: uv_id, scale_x: scale_x_id, scale_y: scale_y_id }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "uv_rotate" =>
                                if ((args.len() != 2) && (args.len() != 4)):
                                    return Result::Err(f"uv_rotate() expects 2 or 4 arguments (uv, angle) or (uv, angle, center_x, center_y), got {args.len()}")
                                let uv_id = (*_self).convert_expr(graph, &args[0].value)?
                                let angle_id = (*_self).convert_expr(graph, &args[1].value)?
                                let center = if (args.len() == 4):
                                    let center_x_id = (*_self).convert_expr(graph, &args[2].value)?
                                    let center_y_id = (*_self).convert_expr(graph, &args[3].value)?
                                    Option::Some((center_x_id, center_y_id))
                                else:
                                    none
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::UVRotate { uv_input: uv_id, angle: angle_id, center: center }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "world_position" =>
                                if (!args.is_empty()):
                                    return Result::Err(f"world_position() expects 0 arguments, got {args.len()}")
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType__WorldPosition, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "world_normal" =>
                                if (!args.is_empty()):
                                    return Result::Err(f"world_normal() expects 0 arguments, got {args.len()}")
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType__WorldNormal, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "absolute_world_position" =>
                                if (!args.is_empty()):
                                    return Result::Err(f"absolute_world_position() expects 0 arguments, got {args.len()}")
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType__AbsoluteWorldPosition, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "camera_position" =>
                                if (!args.is_empty()):
                                    return Result::Err(f"camera_position() expects 0 arguments, got {args.len()}")
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType__CameraPosition, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "object_position" =>
                                if (!args.is_empty()):
                                    return Result::Err(f"object_position() expects 0 arguments, got {args.len()}")
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType__ObjectPosition, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "object_orientation" =>
                                if (!args.is_empty()):
                                    return Result::Err(f"object_orientation() expects 0 arguments, got {args.len()}")
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType__ObjectOrientation, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            "triplanar_sample" =>
                                if (args.is_empty() || (args.len() > 3)):
                                    return Result::Err(f"triplanar_sample() expects 1-3 arguments (texture, [world_position], [blend_sharpness]), got {args.len()}")
                                let texture_arg = &args[0].value
                                let texture_name = match texture_arg:
                                    kain_core__ast__Expr::Ident(name, _) => name.clone()
                                    _ => return Result::Err(("triplanar_sample() first argument must be a texture input variable").to_string())
                                let texture_id = (*_self).variable_map.get(&texture_name).cloned().ok_or_else(fn(): f"Undefined texture variable: {texture_name}")?
                                let world_position = if (args.len() >= 2):
                                    Option::Some((*_self).convert_expr(graph, &args[1].value)?)
                                else:
                                    none
                                let blend_sharpness = if (args.len() >= 3):
                                    (*_self).extract_float_from_expr(&args[2].value)?
                                else:
                                    4
                                let node_id = (*_self).next_node_id()
                                let x = (-200)
                                let y = (((*graph).nodes.len() as i32) * 100)
                                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::TriplanarSample { texture: texture_id, world_position: world_position, blend_sharpness: blend_sharpness }, position: (x, y) })
                                ()
                                Result::Ok(node_id)
                            _ => Result::Err(f"Unknown function: {name}")
                    _ => Result::Err(("Complex function calls not supported").to_string())
            kain_core__ast__Expr::Field { object: object, field: field } =>
                let object_id = (*_self).convert_expr(graph, object)?
                let node_id = (*_self).next_node_id()
                let x = (-200)
                let y = (((*graph).nodes.len() as i32) * 100)
                let mask = match field.as_str():
                    "r" => "R"
                    "x" => "R"
                    "g" => "G"
                    "y" => "G"
                    "b" => "B"
                    "z" => "B"
                    "a" => "A"
                    "w" => "A"
                    "rg" => "RG"
                    "xy" => "RG"
                    "rgb" => "RGB"
                    "xyz" => "RGB"
                    "rgba" => "RGBA"
                    "xyzw" => "RGBA"
                    _ => return Result::Err(f"Unknown component mask: {field}")
                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::ComponentMask { input: object_id, mask: mask.to_string() }, position: (x, y) })
                ()
                Result::Ok(node_id)
            kain_core__ast__Expr::Float(value, _) =>
                let node_id = (*_self).next_node_id()
                let x = (-400)
                let y = (((*graph).nodes.len() as i32) * 100)
                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::ConstantFloat { value: (*value) as f32 }, position: (x, y) })
                ()
                Result::Ok(node_id)
            kain_core__ast__Expr::Int(value, _) =>
                let node_id = (*_self).next_node_id()
                let x = (-400)
                let y = (((*graph).nodes.len() as i32) * 100)
                (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::ConstantFloat { value: (*value) as f32 }, position: (x, y) })
                ()
                Result::Ok(node_id)
            _ =>
                let expr_desc = match expr:
                    kain_core__ast__Expr::Match {  } => "match expression"
                    kain_core__ast__Expr::If {  } => "if expression"
                    kain_core__ast__Expr::Block {  } => "block expression"
                    kain_core__ast__Expr::Array {  } => "array literal"
                    kain_core__ast__Expr::Tuple {  } => "tuple"
                    kain_core__ast__Expr::Lambda {  } => "lambda function"
                    kain_core__ast__Expr::Await {  } => "await expression"
                    kain_core__ast__Expr::Range {  } => "range expression"
                    _ => "complex expression"
                Result::Err(f"Unsupported expression: {expr_desc}")

    fn extract_properties(_self: &MaterialGraphConverter, attributes: &[kain_core::ast::Attribute]) -> Result<MaterialProperties, String>:
        let mut props = MaterialProperties__default_()
        for attr in attributes:
            if (attr.name == "material_graph"):
                for arg in &attr.args:
                    let __selfhost_empty = none
                ()
                ()
            if (attr.name == "dynamic"):
                props.expose_parameters = true
                ()
        ()
        Result::Ok(props)

    fn extract_float_default(_self: &MaterialGraphConverter, default_: &Option<kain_core::ast::Expr>) -> Result<f32, String>:
        match default_:
            Some(kain_core__ast__Expr::Float(value, _)) => Result::Ok((*value) as f32)
            Some(kain_core__ast__Expr::Int(value, _)) => Result::Ok((*value) as f32)
            None => Result::Ok(0)
            _ => Result::Err(("Invalid float default value").to_string())

    fn extract_vec3_default(_self: &MaterialGraphConverter, default_: &Option<kain_core::ast::Expr>) -> Result<[f32; 3], String>:
        match default_:
            Some(kain_core__ast__Expr::Call { callee: callee, args: args }) =>
                match &(*(*callee)):
                    kain_core__ast__Expr::Ident(name, _) =>
                        if ((name == "vec3") && (args.len() == 3)):
                            let x = (*_self).extract_float_from_expr(&args[0].value)?
                            let y = (*_self).extract_float_from_expr(&args[1].value)?
                            let z = (*_self).extract_float_from_expr(&args[2].value)?
                            return Result::Ok([x, y, z])
                        ()
                    _ =>
                        ()
                        ()
                Result::Err(("Invalid vec3 constructor").to_string())
            None => Result::Ok([0, 0, 0])
            _ => Result::Err(("Invalid vec3 default value").to_string())

    fn extract_vec4_default(_self: &MaterialGraphConverter, default_: &Option<kain_core::ast::Expr>) -> Result<[f32; 4], String>:
        match default_:
            Some(kain_core__ast__Expr::Call { callee: callee, args: args }) =>
                match &(*(*callee)):
                    kain_core__ast__Expr::Ident(name, _) =>
                        if ((name == "vec4") && (args.len() == 4)):
                            let x = (*_self).extract_float_from_expr(&args[0].value)?
                            let y = (*_self).extract_float_from_expr(&args[1].value)?
                            let z = (*_self).extract_float_from_expr(&args[2].value)?
                            let w = (*_self).extract_float_from_expr(&args[3].value)?
                            return Result::Ok([x, y, z, w])
                        ()
                    _ =>
                        ()
                        ()
                Result::Err(("Invalid vec4 constructor").to_string())
            None => Result::Ok([0, 0, 0, 1])
            _ => Result::Err(("Invalid vec4 default value").to_string())

    fn extract_float_from_expr(_self: &MaterialGraphConverter, expr: &kain_core::ast::Expr) -> Result<f32, String>:
        match expr:
            kain_core__ast__Expr::Float(value, _) => Result::Ok((*value) as f32)
            kain_core__ast__Expr::Int(value, _) => Result::Ok((*value) as f32)
            _ => Result::Err(("Expected numeric value").to_string())

    fn create_time_node(_self: &mut MaterialGraphConverter, graph: &mut MaterialGraph) -> String:
        match &(*_self).time_node_id:
            Some(node_id) => return node_id.clone()
            _ =>
                ()
                ()
        let node_id = (*_self).next_node_id()
        let x = (-400)
        let y = (((*graph).nodes.len() as i32) * 100)
        (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType__Time, position: (x, y) })
        ()
        (*graph).is_dynamic = true
        ()
        (*_self).time_node_id = Option::Some(node_id.clone())
        ()
        node_id

    fn set_output(_self: &mut MaterialGraphConverter, graph: &mut MaterialGraph, name: String, node_id: String) -> Result<(), String>:
        match name:
            "base_color" =>
                (*graph).outputs.base_color = Option::Some(node_id)
                ()
            "emissive" =>
                (*graph).outputs.emissive = Option::Some(node_id)
                ()
            "roughness" =>
                (*graph).outputs.roughness = Option::Some(node_id)
                ()
            "metallic" =>
                (*graph).outputs.metallic = Option::Some(node_id)
                ()
            "normal" =>
                (*graph).outputs.normal = Option::Some(node_id)
                ()
            "opacity" =>
                (*graph).outputs.opacity = Option::Some(node_id)
                ()
            "specular" =>
                (*graph).outputs.specular = Option::Some(node_id)
                ()
            "ambient_occlusion" =>
                (*graph).outputs.ambient_occlusion = Option::Some(node_id)
                ()
            "world_position_offset" =>
                (*graph).outputs.world_position_offset = Option::Some(node_id)
                ()
                (*graph).uses_vertex_shader = true
                ()
                ()
                ()
                ()
            _ => return Result::Err(f"Unknown output: {name}")
        Result::Ok(())

    fn create_default_uv_node(_self: &mut MaterialGraphConverter, graph: &mut MaterialGraph) -> String:
        match &(*_self).default_uv_node:
            Some(node_id) => return node_id.clone()
            _ =>
                ()
                ()
        let node_id = (*_self).next_node_id()
        let x = (-400)
        let y = (((*graph).nodes.len() as i32) * 100)
        (*graph).nodes.push(MaterialNode { id: node_id.clone(), node_type: MaterialNodeType::TextureCoordinate { index: 0, tiling: [1, 1] }, position: (x, y) })
        ()
        (*_self).default_uv_node = Option::Some(node_id.clone())
        ()
        node_id

    fn resolve_shader_path(_self: &MaterialGraphConverter, shader_name: String) -> Result<String, String>:
        if shader_name.is_empty():
            return Result::Err(("Shader name cannot be empty").to_string())
        if (!shader_name.chars().all(fn(c): (c.is_alphanumeric() || (c == "_")))):
            return Result::Err(f"Invalid shader name '{shader_name}': must contain only alphanumeric characters and underscores")
        Result::Ok(f"/Game/Materials/Functions/{shader_name}")


impl Default for MaterialGraphConverter:
    fn default_() -> MaterialGraphConverter:
        MaterialGraphConverter__new_()


