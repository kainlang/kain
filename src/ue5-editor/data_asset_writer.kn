use std::io::Cursor

use ue5_asset_utils::import_builder::ImportBuilder

use ue5_asset_utils::property_converter::convert_property_defs

use ue5_asset_utils::property_types::PropertyDef

use unreal_asset::engine_version::EngineVersion

use unreal_asset::exports::base_export::BaseExport

use unreal_asset::exports::normal_export::NormalExport

use unreal_asset::exports::Export

use unreal_asset::flags::EObjectFlags

use unreal_asset::types::PackageIndex

use unreal_asset::Asset

pub enum DataAssetError:
    InvalidClassPath(String)
    Serialization(String)

impl fmt::Display for DataAssetError:
    fn fmt(_self: &DataAssetError, f: &mut fmt::Formatter<_>) -> Result<(), Error>:
        match *_self:
            DataAssetError::InvalidClassPath(p) => __kain_write_fmt!(f, f"invalid class path: {p}")
            DataAssetError::Serialization(msg) => __kain_write_fmt!(f, f"serialization error: {msg}")


impl error::Error for DataAssetError:
    fn __selfhost_empty_impl__():
        let __selfhost_empty = none

pub type Result<T> = Result<T, DataAssetError>

const DATA_ASSET_CLASS_ALIASES: Array<(String, String)> = [("DataAsset", "/Script/Engine.DataAsset"), ("PrimaryDataAsset", "/Script/Engine.PrimaryDataAsset")]

const DEFAULT_DATA_ASSET_CLASS: String = "/Script/Engine.DataAsset"

@doc(doc = " Write a `UDataAsset` `.uasset` file from a flat list of `PropertyDef` fields.")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = "")
@doc(doc = " * `name`           — Asset object name, e.g. `\"DA_ItemData\"`")
@doc(doc = " * `class_path`     — Full class path (e.g. `\"/Script/Engine.DataAsset\"`)")
@doc(doc = "                      or short alias (e.g. `\"DataAsset\"`, `\"PrimaryDataAsset\"`)")
@doc(doc = " * `fields`         — Typed property values for the export")
@doc(doc = " * `engine_version` — Target engine version for the binary format")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = "")
@doc(doc = " The raw bytes of a well-formed `.uasset` file.")
pub fn write_data_asset(name: String, class_path: String, fields: &[ue5_asset_utils::property_types::PropertyDef], engine_version: unreal_asset::engine_version::EngineVersion) -> Result<Array<u8>, Error>:
    let mut asset = Asset__new_empty(engine_version)
    let resolved_class = resolve_class_path(class_path)
    let (pkg_path, class_name) = ImportBuilder__parse_class_path(&resolved_class)
    let pkg_import = ImportBuilder__get_or_add_package(&mut asset, &pkg_path)
    let class_import = ImportBuilder__get_or_add_class(&mut asset, &class_name, pkg_import)
    let properties = ue5_asset_utils__property_converter__convert_property_defs(&mut asset, fields)
    let object_name = asset.add_fname(name)
    let export_ = unreal_asset::exports::normal_export::NormalExport { base_export: unreal_asset::exports::base_export::BaseExport { class_index: class_import, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: PackageIndex__new_(0), object_name: object_name, object_flags: (unreal_asset__flags__EObjectFlags__RF_PUBLIC | unreal_asset__flags__EObjectFlags__RF_STANDALONE), ..Default__default_() }, properties: properties, extras: Vec__new_() }
    asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(export_))
    ()
    asset.rebuild_name_map()
    ()
    let mut cursor = Cursor__new_(Vec__new_())
    asset.write_data(&mut cursor, none).map_err(fn(e): DataAssetError::Serialization(e))?
    ()
    Result::Ok(cursor.into_inner())

@doc(doc = " Resolve a `@data_asset` attribute value to a full class path.")
@doc(doc = "")
@doc(doc = " Rules (data-driven via `DATA_ASSET_CLASS_ALIASES`):")
@doc(doc = " * No argument / empty → `/Script/Engine.DataAsset`")
@doc(doc = " * Contains `/` → used as-is (full path)")
@doc(doc = " * Short alias hit → replaced from the alias table")
@doc(doc = " * Otherwise → `/Script/Engine.{value}` (assume Engine class)")
pub fn resolve_data_asset_class(attributes: &[kain_core::ast::Attribute]) -> String:
    for attr in attributes:
        if (attr.name == "data_asset"):
            match attr.args.first():
                Some(kain_core__ast__Expr::String(value, _)) => return resolve_class_path(value)
                _ => ()
    ()
    DEFAULT_DATA_ASSET_CLASS.to_string()

@doc(doc = " Convert a possibly-short class name to a full UE5 path.")
fn resolve_class_path(path: String) -> String:
    if path.is_empty():
        return DEFAULT_DATA_ASSET_CLASS.to_string()
    if path.contains("/"):
        return path.to_string()
    match DATA_ASSET_CLASS_ALIASES.iter().find(fn(__kain_closure_arg0): ((*__kain_closure_arg0.__kain_tuple_0) == path)):
        Some((_, full)) => return full.to_string()
        _ =>
            ()
            ()
    f"/Script/Engine.{path}"

@doc(doc = " Convert `Struct.fields` (from `kain_core::ast::Field`) into `PropertyDef` values.")
@doc(doc = "")
@doc(doc = " This reuses the same conversion logic proven in `ue5-blueprints/conversion.rs`.")
pub fn fields_from_struct(st: &kain_core::ast::Struct) -> Array<ue5_asset_utils::property_types::PropertyDef>:
    (*st).fields.iter().filter_map(fn(field): convert_field_expr_to_property(&field.name, &field.default_, Option::Some(&field.ty))).collect()

@doc(doc = " Convert an optional default expression + type hint to a PropertyDef.")
fn convert_field_expr_to_property(name: String, default_: &Option<kain_core::ast::Expr>, ty_hint: Option<&kain_core::ast::Type>) -> Option<ue5_asset_utils::property_types::PropertyDef>:
    match default_:
        Some(expr) => convert_expr_to_property(name, expr, ty_hint)
        None => ty_hint.and_then(fn(ty): zero_value_for_type(name, ty))

@doc(doc = " Generate a zero/empty PropertyDef for a type with no explicit default.")
fn zero_value_for_type(name: String, ty: &kain_core::ast::Type) -> Option<ue5_asset_utils::property_types::PropertyDef>:
    match ty:
        kain_core__ast__Type::Named { name: ty_name } =>
            match ty_name.as_str():
                "Float" => Option::Some(PropertyDef__float_(name, 0))
                "f32" => Option::Some(PropertyDef__float_(name, 0))
                "f64" => Option::Some(PropertyDef__float_(name, 0))
                "Int" => Option::Some(PropertyDef__int_(name, 0))
                "i32" => Option::Some(PropertyDef__int_(name, 0))
                "i64" => Option::Some(PropertyDef__int_(name, 0))
                "Bool" => Option::Some(PropertyDef__bool_(name, false))
                "String" => Option::Some(PropertyDef__str(name, ""))
                _ => none
        _ => none

@doc(doc = " Convert an AST expression to a PropertyDef.")
@doc(doc = " Mirrors `ue5-blueprints/conversion.rs :: convert_expr_to_property` exactly.")
fn convert_expr_to_property(name: String, expr: &kain_core::ast::Expr, _ty_hint: Option<&kain_core::ast::Type>) -> Option<ue5_asset_utils::property_types::PropertyDef>:
    use kain_core::ast

    match expr:
        kain_core__ast__Expr::Float(v, _) => Option::Some(PropertyDef__float_(name, (*v) as f32))
        kain_core__ast__Expr::Int(v, _) => Option::Some(PropertyDef__int_(name, (*v) as i32))
        kain_core__ast__Expr::Bool(v, _) => Option::Some(PropertyDef__bool_(name, (*v)))
        kain_core__ast__Expr::String(v, _) => if (v.starts_with("/Game/") || v.starts_with("/Script/")): Option::Some(PropertyDef__soft_object(name, v)) else: Option::Some(PropertyDef__str(name, v))
        kain_core__ast__Expr::Call { callee: callee, args: args } =>
            match &(*(*callee)):
                kain_core__ast__Expr::Ident(func_name, _) =>
                    match func_name.as_str():
                        "vec3" if (args.len() == 3) =>
                            let x = eval_float(&args[0].value).unwrap_or(0)
                            let y = eval_float(&args[1].value).unwrap_or(0)
                            let z = eval_float(&args[2].value).unwrap_or(0)
                            Option::Some(PropertyDef__vector(name, x, y, z))
                        "rotator" if (args.len() == 3) =>
                            let p = eval_float(&args[0].value).unwrap_or(0)
                            let y = eval_float(&args[1].value).unwrap_or(0)
                            let r = eval_float(&args[2].value).unwrap_or(0)
                            Option::Some(PropertyDef__rotator(name, p, y, r))
                        "color" if (args.len() >= 3) =>
                            let r = eval_float(&args[0].value).unwrap_or(0)
                            let g = eval_float(&args[1].value).unwrap_or(0)
                            let b = eval_float(&args[2].value).unwrap_or(0)
                            let a = if (args.len() >= 4):
                                eval_float(&args[3].value).unwrap_or(1)
                            else:
                                1
                            Option::Some(PropertyDef__color(name, r, g, b, a))
                        "linear_color" if (args.len() >= 3) =>
                            let r = eval_float(&args[0].value).unwrap_or(0)
                            let g = eval_float(&args[1].value).unwrap_or(0)
                            let b = eval_float(&args[2].value).unwrap_or(0)
                            let a = if (args.len() >= 4):
                                eval_float(&args[3].value).unwrap_or(1)
                            else:
                                1
                            Option::Some(PropertyDef__color(name, r, g, b, a))
                        _ => none
                _ =>
                    none
        kain_core__ast__Expr::EnumVariant { enum_name: enum_name, variant: variant } => Option::Some(PropertyDef__enum_val(name, enum_name, variant))
        kain_core__ast__Expr::Struct { name: struct_name, fields: fields } =>
            let inner: Array<ue5_asset_utils::property_types::PropertyDef> = fields.iter().filter_map(fn(__kain_closure_arg1): convert_expr_to_property(__kain_closure_arg1.__kain_tuple_0, __kain_closure_arg1.__kain_tuple_1, none)).collect()
            Option::Some(ue5_asset_utils::property_types::PropertyDef { name: name.to_string(), value: ue5_asset_utils__property_types__PropertyValue::Struct { struct_type: struct_name.clone(), fields: inner } })
        _ => none

@doc(doc = " Evaluate a simple numeric expression to f32.")
fn eval_float(expr: &kain_core::ast::Expr) -> Option<f32>:
    use kain_core::ast

    match expr:
        kain_core__ast__Expr::Float(v, _) => Option::Some((*v) as f32)
        kain_core__ast__Expr::Int(v, _) => Option::Some((*v) as f32)
        kain_core__ast__Expr::Unary { op: kain_core__ast__UnaryOp::Neg, operand: operand } => eval_float(operand).map(fn(v): (-v))
        _ => none

