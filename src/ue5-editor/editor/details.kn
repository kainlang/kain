use kain_core::ast::Expr

use kain_core::ast::Field

use kain_core::ast::Struct

use kain_core::ast::Type

use kain_core::types::TypedStruct

@doc(doc = " Information about a category group")
@derive(Debug, Clone)
struct CategoryGroup:
    name: String
    fields: Array<DetailField>

@doc(doc = " A field with its detail customization metadata")
@derive(Debug, Clone)
struct DetailField:
    name: String
    cpp_type: String
    widget_override: Option<WidgetOverride>
    visibility_condition: Option<String>
    display_name: Option<String>
    tooltip: Option<String>

enum WidgetOverride:
    Slider { min: f64, max: f64 }
    ColorPicker
    AssetPicker { allowed_classes: Array<String> }
    TextBox { multiline: Bool }
    CheckBox
    Button { label: String }

enum VisibilityConditionExpr:
    BoolField { field: String }
    NumericCompare { field: String, op: String, rhs: f64 }

pub struct DetailsGenerator:
    lines: Array<String>
    indent: usize

impl DetailsGenerator:
    pub fn new_() -> DetailsGenerator:
        DetailsGenerator { lines: Vec__new_(), indent: 0 }

    pub fn generate_customization(_self: &mut DetailsGenerator, st: &kain_core::types::TypedStruct) -> (String, String):
        let class_name = f"F{(*st).ast.name}Customization"
        let target_type_name = (*st).ast.name.strip_suffix("Details").unwrap_or(&(*st).ast.name).to_string()
        let header = (*_self).generate_header(&(*st).ast, &class_name)
        let source = (*_self).generate_source(&(*st).ast, &class_name, &target_type_name)
        (header, source)

    pub fn generate_registration(_self: &DetailsGenerator, st: &kain_core::types::TypedStruct) -> String:
        let class_name = f"F{(*st).ast.name}Customization"
        let target_type_name = (*st).ast.name.strip_suffix("Details").unwrap_or(&(*st).ast.name).to_string()
        format!(concat!("\t{{\n", "\t\tFPropertyEditorModule& PropertyModule = FModuleManager::LoadModuleChecked<FPropertyEditorModule>(\"PropertyEditor\");\n", "\t\tPropertyModule.RegisterCustomClassLayout(\n", "\t\t\tFName(TEXT(\"{}\")),\n", "\t\t\tFOnGetDetailCustomizationInstance::CreateStatic(&{}::MakeInstance)\n", "\t\t);\n", "\t}}"), target_type_name, class_name)

    fn generate_header(_self: &mut DetailsGenerator, st: &kain_core::ast::Struct, class_name: String) -> String:
        (*_self).lines.clear()
        ()
        (*_self).indent = 0
        ()
        (*_self).push_line(&f"class {class_name} : public IDetailCustomization")
        ()
        (*_self).push_line("{")
        ()
        (*_self).push_line("public:")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line(&"static TSharedRef<IDetailCustomization> MakeInstance() { return MakeShareable(new {class_name}()); }")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("virtual void CustomizeDetails(IDetailLayoutBuilder& DetailBuilder) override;")
        ()
        (*_self).push_line("")
        ()
        for field in &(*st).fields:
            if field.attributes.iter().any(fn(a): (a.name == "button")):
                let handler_name = f"OnButton_{field.name}"
                (*_self).push_line(&f"FReply {handler_name}();")
                ()
        ()
        for method in &(*st).methods:
            if method.attributes.iter().any(fn(a): (a.name == "button")):
                (*_self).push_line(&f"FReply On_{method.name}();")
                ()
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("private:")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("TWeakObjectPtr<UObject> CachedObject;")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("};")
        ()
        (*_self).lines.join("\n")

    fn generate_source(_self: &mut DetailsGenerator, st: &kain_core::ast::Struct, class_name: String, _target_type_name: String) -> String:
        (*_self).lines.clear()
        ()
        (*_self).indent = 0
        ()
        let categories = (*_self).build_categories(st)
        (*_self).push_line(&f"void {class_name}::CustomizeDetails(IDetailLayoutBuilder& DetailBuilder)")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("TArray<TWeakObjectPtr<UObject>> Objects;")
        ()
        (*_self).push_line("DetailBuilder.GetObjectsBeingCustomized(Objects);")
        ()
        (*_self).push_line("if (Objects.Num() > 0)")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("CachedObject = Objects[0];")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        for category in &categories:
            (*_self).push_line(&f"IDetailCategoryBuilder& {DetailsGenerator__sanitize_identifier(&category.name)}Cat = DetailBuilder.EditCategory(TEXT(\"{category.name}\"));")
            ()
            (*_self).push_line("")
            ()
            for field in &category.fields:
                (*_self).generate_field_customization(field, &category.name, class_name)
                ()
        ()
        let has_method_buttons = (*st).methods.iter().any(fn(m): m.attributes.iter().any(fn(a): (a.name == "button")))
        if has_method_buttons:
            (*_self).push_line("IDetailCategoryBuilder& ActionsCat = DetailBuilder.EditCategory(TEXT(\"Actions\"));")
            ()
            for method in &(*st).methods:
                match method.attributes.iter().find(fn(a): (a.name == "button")):
                    Some(button_attr) =>
                        let label = (*_self).extract_string_attr_arg(button_attr).unwrap_or_else(fn(): method.name.clone())
                        (*_self).push_line(&f"ActionsCat.AddCustomRow(FText::FromString(TEXT(\"{label}\")))")
                        ()
                        (*_self).push_line(".WholeRowContent()")
                        ()
                        (*_self).push_line("[")
                        ()
                        (*_self).indent = ((*_self).indent + 1)
                        ()
                        (*_self).push_line(&f"SNew(SButton).Text(FText::FromString(TEXT(\"{label}\"))).OnClicked(FOnClicked::CreateSP(this, &{class_name}::On_{method.name}))")
                        ()
                        (*_self).indent = ((*_self).indent - 1)
                        ()
                        (*_self).push_line("];")
                        ()
                    _ => ()
            ()
            (*_self).push_line("")
            ()
            ()
            ()
            ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        for field in &(*st).fields:
            if field.attributes.iter().any(fn(a): (a.name == "button")):
                let handler_name = f"OnButton_{field.name}"
                (*_self).push_line(&f"FReply {class_name}::{handler_name}()")
                ()
                (*_self).push_line("{")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line("// Execute button action")
                ()
                (*_self).push_line(&f"UE_LOG(LogTemp, Log, TEXT(\"Details button '{field.name}' clicked\"));")
                ()
                (*_self).push_line("")
                ()
                (*_self).push_line("// Notify property change if object is valid")
                ()
                (*_self).push_line("if (CachedObject.IsValid())")
                ()
                (*_self).push_line("{")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line("CachedObject->Modify();")
                ()
                (*_self).push_line("CachedObject->PostEditChange();")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("}")
                ()
                (*_self).push_line("")
                ()
                (*_self).push_line("return FReply::Handled();")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("}")
                ()
                (*_self).push_line("")
                ()
        ()
        for method in &(*st).methods:
            if method.attributes.iter().any(fn(a): (a.name == "button")):
                (*_self).push_line(&f"FReply {class_name}::On_{method.name}()")
                ()
                (*_self).push_line("{")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line("// Execute button action")
                ()
                (*_self).push_line(&f"UE_LOG(LogTemp, Log, TEXT(\"Details action '{method.name}' executed\"));")
                ()
                (*_self).push_line("")
                ()
                (*_self).push_line("// Notify property change if object is valid")
                ()
                (*_self).push_line("if (CachedObject.IsValid())")
                ()
                (*_self).push_line("{")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line("CachedObject->Modify();")
                ()
                (*_self).push_line("CachedObject->PostEditChange();")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("}")
                ()
                (*_self).push_line("")
                ()
                (*_self).push_line("return FReply::Handled();")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("}")
                ()
                (*_self).push_line("")
                ()
        ()
        (*_self).lines.join("\n")

    fn build_categories(_self: &DetailsGenerator, st: &kain_core::ast::Struct) -> Array<CategoryGroup>:
        let mut categories: Array<CategoryGroup> = Vec__new_()
        let mut current_category = ("Default").to_string()
        for field in &(*st).fields:
            match field.attributes.iter().find(fn(a): (a.name == "category")):
                Some(cat_attr) =>
                    match (*_self).extract_string_attr_arg(cat_attr):
                        Some(cat_name) =>
                            current_category = cat_name
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            let widget_override = (*_self).detect_widget_override(field)
            let visibility_condition = (*_self).detect_visibility_condition(field)
            let detail_field = DetailField { name: field.name.clone(), cpp_type: (*_self).map_type(&field.ty), widget_override: widget_override, visibility_condition: visibility_condition, display_name: (*_self).detect_display_name(field), tooltip: (*_self).detect_tooltip(field) }
            match categories.iter_mut().find(fn(c): (c.name == current_category)):
                Some(cat) =>
                    cat.fields.push(detail_field)
                    ()
                _ =>
                    categories.push(CategoryGroup { name: current_category.clone(), fields: [detail_field] })
                    ()
        ()
        categories

    fn detect_widget_override(_self: &DetailsGenerator, field: &kain_core::ast::Field) -> Option<WidgetOverride>:
        for attr in &(*field).attributes:
            match attr.name.as_str():
                "slider" =>
                    let min = (*_self).extract_float_arg_at(&attr.args, 0).unwrap_or(0)
                    let max = (*_self).extract_float_arg_at(&attr.args, 1).unwrap_or(100)
                    return Option::Some(WidgetOverride::Slider { min: min, max: max })
                "color_picker" => return Option::Some(WidgetOverride__ColorPicker)
                "asset_picker" =>
                    let classes = (*_self).extract_string_list_arg(&attr.args, "allowed_classes")
                    return Option::Some(WidgetOverride::AssetPicker { allowed_classes: classes })
                "text_box" => return Option::Some(WidgetOverride::TextBox { multiline: false })
                "multiline_text" => return Option::Some(WidgetOverride::TextBox { multiline: true })
                "checkbox" => return Option::Some(WidgetOverride__CheckBox)
                "button" =>
                    let label = (*_self).extract_string_attr_arg(attr).unwrap_or_else(fn(): (*field).name.clone())
                    return Option::Some(WidgetOverride::Button { label: label })
                _ => ()
        ()
        none

    fn detect_visibility_condition(_self: &DetailsGenerator, field: &kain_core::ast::Field) -> Option<String>:
        (*field).attributes.iter().find(fn(a): (a.name == "visible_if")).and_then(fn(a): (*_self).extract_string_attr_arg(a))

    fn detect_display_name(_self: &DetailsGenerator, field: &kain_core::ast::Field) -> Option<String>:
        (*field).attributes.iter().find(fn(a): (a.name == "display_name")).and_then(fn(a): (*_self).extract_string_attr_arg(a))

    fn detect_tooltip(_self: &DetailsGenerator, field: &kain_core::ast::Field) -> Option<String>:
        (*field).attributes.iter().find(fn(a): (a.name == "tooltip")).and_then(fn(a): (*_self).extract_string_attr_arg(a))

    fn parse_visibility_condition(condition: String) -> Option<VisibilityConditionExpr>:
        let cond = condition.trim()
        if cond.is_empty():
            return none
        for op in [">=", "<=", "==", "!=", ">", "<"]:
            match cond.find(op):
                Some(idx) =>
                    let left = cond[..idx].trim()
                    let right = cond[(idx + op.len())..].trim()
                    if DetailsGenerator__is_simple_identifier(left):
                        match right.parse():
                            Ok(rhs) => return Option::Some(VisibilityConditionExpr::NumericCompare { field: left.to_string(), op: op, rhs: rhs })
                            _ => ()
                _ => ()
        ()
        if DetailsGenerator__is_simple_identifier(cond):
            return Option::Some(VisibilityConditionExpr::BoolField { field: cond.to_string() })
        none

    fn is_simple_identifier(text: String) -> Bool:
        let mut chars = text.chars()
        match chars.next():
            Some(c) if ((c == "_") || c.is_ascii_alphabetic()) => ()
            _ => return false
        chars.all(fn(c): ((c == "_") || c.is_ascii_alphanumeric()))

    fn emit_visibility_for_custom_row(_self: &mut DetailsGenerator, visibility_condition: Option<String>):
        match visibility_condition:
            Some(condition) =>
                match DetailsGenerator__visibility_lambda_expr(condition):
                    Some(lambda) =>
                        (*_self).push_line(&f".Visibility({lambda})")
                        ()
                    _ => ()
            _ => ()

    fn emit_property_tooltip(_self: &mut DetailsGenerator, handle_var: String, tooltip: Option<String>):
        match tooltip:
            Some(tooltip_text) =>
                (*_self).push_line(&f"{handle_var}->SetToolTipText(FText::FromString(TEXT(\"{tooltip_text}\")));")
                ()
            _ => ()

    fn emit_visibility_for_property_row(_self: &mut DetailsGenerator, row_var: String, visibility_condition: Option<String>):
        match visibility_condition:
            Some(condition) =>
                match DetailsGenerator__visibility_lambda_expr(condition):
                    Some(lambda) =>
                        (*_self).push_line(&f"{row_var}.Visibility({lambda});")
                        ()
                    _ => ()
            _ => ()

    fn visibility_lambda_expr(condition: String) -> Option<String>:
        match DetailsGenerator__parse_visibility_condition(condition):
            Some(VisibilityConditionExpr::BoolField { field: field }) => Option::Some("TAttribute<EVisibility>::CreateLambda([&DetailBuilder]() -> EVisibility { bool bVisible = false; TSharedRef<IPropertyHandle> VisibleIfHandle = DetailBuilder.GetProperty(TEXT(\"{field}\")); if (VisibleIfHandle->GetValue(bVisible) == FPropertyAccess::Success && bVisible) { return EVisibility::Visible; } return EVisibility::Collapsed; })")
            Some(VisibilityConditionExpr::NumericCompare { field: field, op: op, rhs: rhs }) =>
                let rhs_str = if (rhs.fract() == 0):
                    rhs
                else:
                    rhs.to_string()
                Option::Some("TAttribute<EVisibility>::CreateLambda([&DetailBuilder]() -> EVisibility { TSharedRef<IPropertyHandle> VisibleIfHandle = DetailBuilder.GetProperty(TEXT(\"{field}\")); FString CondText; if (VisibleIfHandle->GetValueAsFormattedString(CondText) == FPropertyAccess::Success) { const double CondValue = FCString::Atod(*CondText); if (CondValue {op} {rhs_str}) { return EVisibility::Visible; } } return EVisibility::Collapsed; })")
            None => none

    fn generate_field_customization(_self: &mut DetailsGenerator, field: &DetailField, category_name: String, class_name: String):
        let cat_var = DetailsGenerator__sanitize_identifier(category_name)
        let handle_var = f"{(*field).name}Handle"
        let display_label = (*field).display_name.unwrap_or(&(*field).name)
        match &(*field).widget_override:
            Some(WidgetOverride::Slider { min: min, max: max }) =>
                (*_self).push_line(&f"// Custom slider for {(*field).name} (bound to property)")
                ()
                (*_self).push_line(&f"TSharedRef<IPropertyHandle> {handle_var} = DetailBuilder.GetProperty(TEXT(\"{(*field).name}\"));")
                ()
                (*_self).emit_property_tooltip(&handle_var, (*field).tooltip)
                ()
                (*_self).push_line(&f"{cat_var}Cat.AddCustomRow(FText::FromString(TEXT(\"{display_label}\")))")
                ()
                (*_self).push_line(".NameContent()")
                ()
                (*_self).push_line("[")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line(&f"SNew(STextBlock).Text(FText::FromString(TEXT(\"{display_label}\")))")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("]")
                ()
                (*_self).push_line(".ValueContent()")
                ()
                (*_self).push_line("[")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                if (((*field).cpp_type == "int32") || ((*field).cpp_type == "int64")):
                    let min_val = (*min) as i32
                    let max_val = (*max) as i32
                    (*_self).push_line(&"SNew(SSpinBox<int32>)\n\t\t.MinValue({min_val})\n\t\t.MaxValue({max_val})\n\t\t.Value_Lambda([{handle_var}]() -> int32 {\n\t\t\tint32 Val = 0;\n\t\t\t{handle_var}->GetValue(Val);\n\t\t\treturn Val;\n\t\t})\n\t\t.OnValueChanged_Lambda([{handle_var}](int32 NewVal) {\n\t\t\t{handle_var}->SetValue(NewVal);\n\t\t})")
                    ()
                    ()
                    ()
                    ()
                else:
                    let min_str = if (min.fract() == 0):
                        min
                    else:
                        min
                    let max_str = if (max.fract() == 0):
                        max
                    else:
                        max
                    (*_self).push_line(&"SNew(SSpinBox<float>)\n\t\t.MinValue({min_str}f)\n\t\t.MaxValue({max_str}f)\n\t\t.Value_Lambda([{handle_var}]() -> float {\n\t\t\tfloat Val = 0.0f;\n\t\t\t{handle_var}->GetValue(Val);\n\t\t\treturn Val;\n\t\t})\n\t\t.OnValueChanged_Lambda([{handle_var}](float NewVal) {\n\t\t\t{handle_var}->SetValue(NewVal);\n\t\t})")
                    ()
                    ()
                    ()
                    ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("]")
                ()
                (*_self).emit_visibility_for_custom_row((*field).visibility_condition)
                ()
                (*_self).push_line(";")
                ()
                (*_self).push_line("")
                ()
            Some(WidgetOverride::ColorPicker) =>
                (*_self).push_line(&f"// Color picker for {(*field).name} (bound to property)")
                ()
                (*_self).push_line(&f"TSharedRef<IPropertyHandle> {handle_var} = DetailBuilder.GetProperty(TEXT(\"{(*field).name}\"));")
                ()
                (*_self).emit_property_tooltip(&handle_var, (*field).tooltip)
                ()
                if (((*field).cpp_type == "FLinearColor") || ((*field).cpp_type == "FColor")):
                    (*_self).push_line(&f"{cat_var}Cat.AddCustomRow(FText::FromString(TEXT(\"{display_label}\")))")
                    ()
                    (*_self).push_line(".NameContent()")
                    ()
                    (*_self).push_line("[")
                    ()
                    (*_self).indent = ((*_self).indent + 1)
                    ()
                    (*_self).push_line(&f"SNew(STextBlock).Text(FText::FromString(TEXT(\"{display_label}\")))")
                    ()
                    (*_self).indent = ((*_self).indent - 1)
                    ()
                    (*_self).push_line("]")
                    ()
                    (*_self).push_line(".ValueContent()")
                    ()
                    (*_self).push_line("[")
                    ()
                    (*_self).indent = ((*_self).indent + 1)
                    ()
                    (*_self).push_line(&"SNew(SColorBlock)\n\t\t.Color_Lambda([{handle_var}]() -> FLinearColor {\n\t\t\tFLinearColor Val = FLinearColor::White;\n\t\t\t{handle_var}->GetValue(Val);\n\t\t\treturn Val;\n\t\t})")
                    ()
                    (*_self).indent = ((*_self).indent - 1)
                    ()
                    (*_self).push_line("]")
                    ()
                    (*_self).emit_visibility_for_custom_row((*field).visibility_condition)
                    ()
                    (*_self).push_line(";")
                    ()
                    ()
                    ()
                    ()
                else:
                    let row_var = f"{(*field).name}Row"
                    (*_self).push_line(&f"auto& {row_var} = {cat_var}Cat.AddProperty({handle_var});")
                    ()
                    (*_self).emit_visibility_for_property_row(&row_var, (*field).visibility_condition)
                    ()
                    ()
                    ()
                    ()
                (*_self).push_line("")
                ()
            Some(WidgetOverride::AssetPicker { allowed_classes: allowed_classes }) =>
                (*_self).push_line(&f"// Asset picker for {(*field).name} (bound to property)")
                ()
                let classes_str = allowed_classes.join(", ")
                (*_self).push_line(&f"// Allowed classes: {classes_str}")
                ()
                (*_self).push_line(&f"TSharedRef<IPropertyHandle> {handle_var} = DetailBuilder.GetProperty(TEXT(\"{(*field).name}\"));")
                ()
                (*_self).emit_property_tooltip(&handle_var, (*field).tooltip)
                ()
                (*_self).push_line(&f"{cat_var}Cat.AddCustomRow(FText::FromString(TEXT(\"{display_label}\")))")
                ()
                (*_self).push_line(".NameContent()")
                ()
                (*_self).push_line("[")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line(&f"SNew(STextBlock).Text(FText::FromString(TEXT(\"{display_label}\")))")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("]")
                ()
                (*_self).push_line(".ValueContent()")
                ()
                (*_self).push_line("[")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line("SNew(SObjectPropertyEntryBox)")
                ()
                match allowed_classes.first():
                    Some(first_class) =>
                        (*_self).push_line(&f".AllowedClass({first_class}::StaticClass())")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).push_line(&f".PropertyHandle({handle_var})")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("]")
                ()
                (*_self).emit_visibility_for_custom_row((*field).visibility_condition)
                ()
                (*_self).push_line(";")
                ()
                (*_self).push_line("")
                ()
            Some(WidgetOverride::TextBox { multiline: multiline }) =>
                (*_self).push_line(&f"// Text box for {(*field).name} (bound to property)")
                ()
                (*_self).push_line(&f"TSharedRef<IPropertyHandle> {handle_var} = DetailBuilder.GetProperty(TEXT(\"{(*field).name}\"));")
                ()
                (*_self).emit_property_tooltip(&handle_var, (*field).tooltip)
                ()
                (*_self).push_line(&f"{cat_var}Cat.AddCustomRow(FText::FromString(TEXT(\"{display_label}\")))")
                ()
                (*_self).push_line(".NameContent()")
                ()
                (*_self).push_line("[")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line(&f"SNew(STextBlock).Text(FText::FromString(TEXT(\"{display_label}\")))")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("]")
                ()
                (*_self).push_line(".ValueContent()")
                ()
                (*_self).push_line("[")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                if (*multiline):
                    (*_self).push_line(&"SNew(SMultiLineEditableTextBox)\n\t\t.Text_Lambda([{handle_var}]() -> FText {\n\t\t\tFString Val;\n\t\t\t{handle_var}->GetValue(Val);\n\t\t\treturn FText::FromString(Val);\n\t\t})\n\t\t.OnTextCommitted_Lambda([{handle_var}](const FText& NewText, ETextCommit::Type) {\n\t\t\t{handle_var}->SetValueFromFormattedString(NewText.ToString());\n\t\t})")
                    ()
                    ()
                    ()
                    ()
                else:
                    (*_self).push_line(&"SNew(SEditableTextBox)\n\t\t.Text_Lambda([{handle_var}]() -> FText {\n\t\t\tFString Val;\n\t\t\t{handle_var}->GetValue(Val);\n\t\t\treturn FText::FromString(Val);\n\t\t})\n\t\t.OnTextCommitted_Lambda([{handle_var}](const FText& NewText, ETextCommit::Type) {\n\t\t\t{handle_var}->SetValueFromFormattedString(NewText.ToString());\n\t\t})")
                    ()
                    ()
                    ()
                    ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("]")
                ()
                (*_self).emit_visibility_for_custom_row((*field).visibility_condition)
                ()
                (*_self).push_line(";")
                ()
                (*_self).push_line("")
                ()
            Some(WidgetOverride::CheckBox) =>
                (*_self).push_line(&f"// Checkbox for {(*field).name} (bound to property)")
                ()
                (*_self).push_line(&f"TSharedRef<IPropertyHandle> {handle_var} = DetailBuilder.GetProperty(TEXT(\"{(*field).name}\"));")
                ()
                (*_self).emit_property_tooltip(&handle_var, (*field).tooltip)
                ()
                (*_self).push_line(&f"{cat_var}Cat.AddCustomRow(FText::FromString(TEXT(\"{display_label}\")))")
                ()
                (*_self).push_line(".NameContent()")
                ()
                (*_self).push_line("[")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line(&f"SNew(STextBlock).Text(FText::FromString(TEXT(\"{display_label}\")))")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("]")
                ()
                (*_self).push_line(".ValueContent()")
                ()
                (*_self).push_line("[")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line(&"SNew(SCheckBox)\n\t\t.IsChecked_Lambda([{handle_var}]() -> ECheckBoxState {\n\t\t\tbool bVal = false;\n\t\t\t{handle_var}->GetValue(bVal);\n\t\t\treturn bVal ? ECheckBoxState::Checked : ECheckBoxState::Unchecked;\n\t\t})\n\t\t.OnCheckStateChanged_Lambda([{handle_var}](ECheckBoxState NewState) {\n\t\t\t{handle_var}->SetValue(NewState == ECheckBoxState::Checked);\n\t\t})")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("]")
                ()
                (*_self).emit_visibility_for_custom_row((*field).visibility_condition)
                ()
                (*_self).push_line(";")
                ()
                (*_self).push_line("")
                ()
            Some(WidgetOverride::Button { label: label }) =>
                let handler_name = f"OnButton_{(*field).name}"
                (*_self).push_line(&f"// Button: {label}")
                ()
                (*_self).push_line(&f"{cat_var}Cat.AddCustomRow(FText::FromString(TEXT(\"{label}\")))")
                ()
                (*_self).push_line(".WholeRowContent()")
                ()
                (*_self).push_line("[")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).push_line(&f"SNew(SButton)\n\t\t.Text(FText::FromString(TEXT(\"{label}\")))\n\t\t.OnClicked(FOnClicked::CreateSP(this, &{class_name}::{handler_name}))")
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("]")
                ()
                (*_self).emit_visibility_for_custom_row((*field).visibility_condition)
                ()
                (*_self).push_line(";")
                ()
                (*_self).push_line("")
                ()
            None =>
                (*_self).push_line(&f"TSharedRef<IPropertyHandle> {handle_var} = DetailBuilder.GetProperty(TEXT(\"{(*field).name}\"));")
                ()
                (*_self).emit_property_tooltip(&handle_var, (*field).tooltip)
                ()
                let row_var = f"{(*field).name}Row"
                (*_self).push_line(&f"auto& {row_var} = {cat_var}Cat.AddProperty({handle_var});")
                ()
                (*_self).emit_visibility_for_property_row(&row_var, (*field).visibility_condition)
                ()
                (*_self).push_line("")
                ()

    fn extract_string_attr_arg(_self: &DetailsGenerator, attr: &kain_core::ast::Attribute) -> Option<String>:
        (*attr).args.first().and_then(fn(arg): none)

    fn extract_float_arg_at(_self: &DetailsGenerator, args: &[kain_core::ast::Expr], index: usize) -> Option<f64>:
        match args.get(index):
            Some(arg) =>
                match arg:
                    kain_core__ast__Expr::Float(f, _) => return Option::Some((*f))
                    kain_core__ast__Expr::Int(n, _) => return Option::Some((*n) as f64)
                    kain_core__ast__Expr::Unary { op: kain_core__ast__UnaryOp::Neg, operand: operand } =>
                        match operand:
                            kain_core__ast__Expr::Float(f, _) => return Option::Some((-f))
                            kain_core__ast__Expr::Int(n, _) => return Option::Some((-((*n) as f64)))
                            _ => ()
                    _ => ()
                ()
            _ =>
                ()
                ()
        none

    fn extract_string_list_arg(_self: &DetailsGenerator, args: &[kain_core::ast::Expr], _name: String) -> Array<String>:
        let mut result = Vec__new_()
        for arg in args:
            match arg:
                kain_core__ast__Expr::String(s, _) =>
                    result.push(s.clone())
                    ()
                _ => ()
        ()
        result

    fn map_type(_self: &DetailsGenerator, ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name } =>
                match name.as_str():
                    "Int" => ("int32").to_string()
                    "int" => ("int32").to_string()
                    "Float" => ("float").to_string()
                    "float" => ("float").to_string()
                    "Bool" => ("bool").to_string()
                    "bool" => ("bool").to_string()
                    "String" => ("FString").to_string()
                    "str" => ("FString").to_string()
                    "Text" => ("FText").to_string()
                    "Color" => ("FLinearColor").to_string()
                    "Vec2" => ("FVector2D").to_string()
                    "Vec3" => ("FVector").to_string()
                    "Brush" => ("const FSlateBrush*").to_string()
                    "Margin" => ("FMargin").to_string()
                    "Texture2D" => ("UTexture2D*").to_string()
                    "StaticMesh" => ("UStaticMesh*").to_string()
                    "Material" => ("UMaterialInterface*").to_string()
                    _ => name.clone()
            kain_core__ast__Type::Array(element, _, _) => f"TArray<{(*_self).map_type(element)}>"
            kain_core__ast__Type::Unit(_) => ("void").to_string()
            _ => ("auto").to_string()

    fn push_line(_self: &mut DetailsGenerator, line_: String):
        let indent_str = ("\t").repeat((*_self).indent)
        (*_self).lines.push(f"{indent_str}{line_}")
        ()

    fn sanitize_identifier(s: String) -> String:
        let base = s.rsplit("|").next().unwrap_or(s).trim()
        let ident: String = base.chars().map(fn(c): if (c.is_alphanumeric() || (c == "_")): c else: "_").collect()
        if ident.is_empty():
            return ("Category").to_string()
        if ident.starts_with(fn(c: Char): c.is_ascii_digit()):
            f"_{ident}"
        else:
            ident


