use std::collections::HashMap

pub enum StyleResourceType:
    Brush
    Icon
    Font
    Color
    Sound

@doc(doc = " Style resource definition")
@derive(Debug, Clone)
pub struct StyleResource:
    name: String
    resource_type: StyleResourceType
    path: String
    size: Option<(u32, u32)>

@doc(doc = " Style set generator")
pub struct StyleGenerator:
    style_name: String
    resources: Map<String, StyleResource>
    lines: Array<String>
    indent: usize

impl StyleGenerator:
    pub fn new_(style_name: String) -> StyleGenerator:
        StyleGenerator { style_name: style_name.to_string(), resources: HashMap__new_(), lines: Vec__new_(), indent: 0 }

    pub fn add_resource(_self: &mut StyleGenerator, resource: StyleResource):
        (*_self).resources.insert(resource.name.clone(), resource)
        ()

    pub fn generate_header(_self: &mut StyleGenerator) -> String:
        (*_self).lines.clear()
        ()
        let class_name = f"F{(*_self).style_name}Style"
        (*_self).push_line(&f"class {class_name}")
        ()
        (*_self).push_line("{")
        ()
        (*_self).push_line("public:")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("static void Initialize();")
        ()
        (*_self).push_line("static void Shutdown();")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("static const ISlateStyle& Get();")
        ()
        (*_self).push_line("static FName GetStyleSetName();")
        ()
        (*_self).push_line("")
        ()
        let mut accessor_decls = Vec__new_()
        for selfhost_for_item in &(*_self).resources:
            let (name, resource) = selfhost_for_item
            let method_name = (*_self).to_method_name(name)
            match resource.resource_type:
                StyleResourceType::Brush =>
                    accessor_decls.push(f"static const FSlateBrush* Get{method_name}Brush();")
                    ()
                StyleResourceType::Icon =>
                    accessor_decls.push(f"static const FSlateBrush* Get{method_name}Brush();")
                    ()
                StyleResourceType::Font =>
                    accessor_decls.push(f"static FSlateFontInfo Get{method_name}Font();")
                    ()
                StyleResourceType::Color =>
                    accessor_decls.push(f"static FSlateColor Get{method_name}Color();")
                    ()
                StyleResourceType::Sound =>
                    accessor_decls.push(f"static FSlateSound Get{method_name}Sound();")
                    ()
        ()
        for decl in accessor_decls:
            (*_self).push_line(&decl)
            ()
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("private:")
        ()
        (*_self).push_line("static TSharedPtr<FSlateStyleSet> StyleInstance;")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("};")
        ()
        (*_self).lines.join("\n")

    pub fn generate_implementation(_self: &mut StyleGenerator) -> String:
        (*_self).lines.clear()
        ()
        let class_name = f"F{(*_self).style_name}Style"
        (*_self).push_line(&f"TSharedPtr<FSlateStyleSet> {class_name}::StyleInstance = nullptr;")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"void {class_name}::Initialize()")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("if (!StyleInstance.IsValid())")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line(&"StyleInstance = MakeShareable(new FSlateStyleSet(GetStyleSetName()));")
        ()
        (*_self).push_line("")
        ()
        let mut registration_lines = Vec__new_()
        for selfhost_for_item in &(*_self).resources:
            let (name, resource) = selfhost_for_item
            match resource.resource_type:
                StyleResourceType::Brush =>
                    match resource.size:
                        Some((w, h)) =>
                            registration_lines.push(f"StyleInstance->Set(\"{name}\", new IMAGE_BRUSH(\"{resource.path}\", FVector2D({w}, {h})));")
                            ()
                        _ =>
                            registration_lines.push(f"StyleInstance->Set(\"{name}\", new IMAGE_BRUSH(\"{resource.path}\", Icon40x40));")
                            ()
                StyleResourceType::Icon =>
                    match resource.size:
                        Some((w, h)) =>
                            registration_lines.push(f"StyleInstance->Set(\"{name}\", new IMAGE_BRUSH(\"{resource.path}\", FVector2D({w}, {h})));")
                            ()
                        _ =>
                            registration_lines.push(f"StyleInstance->Set(\"{name}\", new IMAGE_BRUSH(\"{resource.path}\", Icon40x40));")
                            ()
                StyleResourceType::Font =>
                    registration_lines.push(f"StyleInstance->Set(\"{name}\", FSlateFontInfo(\"{resource.path}\", 10));")
                    ()
                StyleResourceType::Color =>
                    registration_lines.push(f"StyleInstance->Set(\"{name}\", FSlateColor(FLinearColor::White));")
                    ()
                StyleResourceType::Sound =>
                    registration_lines.push(f"StyleInstance->Set(\"{name}\", FSlateSound::FromName(\"{resource.path}\"));")
                    ()
        ()
        for line_ in registration_lines:
            (*_self).push_line(&line_)
            ()
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("FSlateStyleRegistry::RegisterSlateStyle(*StyleInstance);")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"void {class_name}::Shutdown()")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("FSlateStyleRegistry::UnRegisterSlateStyle(*StyleInstance);")
        ()
        (*_self).push_line("ensure(StyleInstance.IsUnique());")
        ()
        (*_self).push_line("StyleInstance.Reset();")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"const ISlateStyle& {class_name}::Get()")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line("return *StyleInstance;")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line(&f"FName {class_name}::GetStyleSetName()")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line(&f"static FName StyleSetName(TEXT(\"{(*_self).style_name}\"));")
        ()
        (*_self).push_line("return StyleSetName;")
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("")
        ()
        let mut impl_lines = Vec__new_()
        for selfhost_for_item in &(*_self).resources:
            let (name, resource) = selfhost_for_item
            let method_name = (*_self).to_method_name(name)
            match resource.resource_type:
                StyleResourceType::Brush =>
                    impl_lines.push(f"const FSlateBrush* {class_name}::Get{method_name}Brush()")
                    ()
                    impl_lines.push(("{").to_string())
                    ()
                    impl_lines.push(f"\treturn StyleInstance->GetBrush(\"{name}\");")
                    ()
                    impl_lines.push(("}").to_string())
                    ()
                    impl_lines.push(("").to_string())
                    ()
                StyleResourceType::Icon =>
                    impl_lines.push(f"const FSlateBrush* {class_name}::Get{method_name}Brush()")
                    ()
                    impl_lines.push(("{").to_string())
                    ()
                    impl_lines.push(f"\treturn StyleInstance->GetBrush(\"{name}\");")
                    ()
                    impl_lines.push(("}").to_string())
                    ()
                    impl_lines.push(("").to_string())
                    ()
                StyleResourceType::Font =>
                    impl_lines.push(f"FSlateFontInfo {class_name}::Get{method_name}Font()")
                    ()
                    impl_lines.push(("{").to_string())
                    ()
                    impl_lines.push(f"\treturn StyleInstance->GetFontStyle(\"{name}\");")
                    ()
                    impl_lines.push(("}").to_string())
                    ()
                    impl_lines.push(("").to_string())
                    ()
                StyleResourceType::Color =>
                    impl_lines.push(f"FSlateColor {class_name}::Get{method_name}Color()")
                    ()
                    impl_lines.push(("{").to_string())
                    ()
                    impl_lines.push(f"\treturn StyleInstance->GetSlateColor(\"{name}\");")
                    ()
                    impl_lines.push(("}").to_string())
                    ()
                    impl_lines.push(("").to_string())
                    ()
                StyleResourceType::Sound =>
                    impl_lines.push(f"FSlateSound {class_name}::Get{method_name}Sound()")
                    ()
                    impl_lines.push(("{").to_string())
                    ()
                    impl_lines.push(f"\treturn StyleInstance->GetSound(\"{name}\");")
                    ()
                    impl_lines.push(("}").to_string())
                    ()
                    impl_lines.push(("").to_string())
                    ()
        ()
        for line_ in impl_lines:
            (*_self).push_line(&line_)
            ()
        ()
        (*_self).lines.join("\n")

    fn to_method_name(_self: &StyleGenerator, resource_name: String) -> String:
        resource_name.replace(".", "").replace("_", "")

    fn push_line(_self: &mut StyleGenerator, line_: String):
        let indent_str = ("\t").repeat((*_self).indent)
        (*_self).lines.push(f"{indent_str}{line_}")
        ()


@doc(doc = " Parse style definition from KAIN code")
pub fn parse_style_definition(content: String) -> Array<StyleResource>:
    let mut resources = Vec__new_()
    for line_ in content.lines():
        let line_ = line_.trim()
        if line_.starts_with("Icon("):
            match parse_icon_definition(line_):
                Some(resource) =>
                    resources.push(resource)
                    ()
                _ => ()
        elif line_.starts_with("Brush("):
            match parse_brush_definition(line_):
                Some(resource) =>
                    resources.push(resource)
                    ()
                _ => ()
        elif line_.starts_with("Font("):
            match parse_font_definition(line_):
                Some(resource) =>
                    resources.push(resource)
                    ()
                _ => ()
        elif line_.starts_with("Color("):
            match parse_color_definition(line_):
                Some(resource) =>
                    resources.push(resource)
                    ()
                _ => ()
    ()
    resources

fn parse_icon_definition(line_: String) -> Option<StyleResource>:
    let parts: Array<String> = line_.trim_start_matches("Icon(").trim_end_matches(")").split(",").map(fn(s): s.trim().trim_matches("\"")).collect()
    if (parts.len() >= 2):
        let name = parts[0].to_string()
        let path = parts[1].to_string()
        let size = if (parts.len() >= 4):
            Option::Some((parts[2].parse().ok()?, parts[3].parse().ok()?))
        else:
            none
        Option::Some(StyleResource { name: name, resource_type: StyleResourceType__Icon, path: path, size: size })
    else:
        none

fn parse_brush_definition(line_: String) -> Option<StyleResource>:
    parse_icon_definition(&line_.replace("Brush(", "Icon(")).map(fn(mut r): none)

fn parse_font_definition(line_: String) -> Option<StyleResource>:
    let parts: Array<String> = line_.trim_start_matches("Font(").trim_end_matches(")").split(",").map(fn(s): s.trim().trim_matches("\"")).collect()
    if (parts.len() >= 2):
        Option::Some(StyleResource { name: parts[0].to_string(), resource_type: StyleResourceType__Font, path: parts[1].to_string(), size: none })
    else:
        none

fn parse_color_definition(line_: String) -> Option<StyleResource>:
    let parts: Array<String> = line_.trim_start_matches("Color(").trim_end_matches(")").split(",").map(fn(s): s.trim().trim_matches("\"")).collect()
    if (!parts.is_empty()):
        Option::Some(StyleResource { name: parts[0].to_string(), resource_type: StyleResourceType__Color, path: String__new_(), size: none })
    else:
        none

