                    (*_self).push_line(&f".{method}({native}::CreateSP(this, &{(*_self).current_widget_class()}::Handle{(*_self).handler_name_from_args(args)}))")
                    ()
            "ListItemsSource" =>
                (*_self).push_line(&f".ListItemsSource({formatted_args})")
                ()
            "OnGenerateRow" =>
                (*_self).push_line(&f".OnGenerateRow({formatted_args})")
                ()
            "OnGetChildren" =>
                (*_self).push_line(&f".OnGetChildren({formatted_args})")
