                ()
            "FontSize" => ()
            "IsEnabled" =>
                (*_self).push_line(&f".IsEnabled({formatted_args})")
                ()
            "Visibility" =>
                (*_self).push_line(&f".Visibility({formatted_args})")
                ()
            "IsChecked" =>
                (*_self).push_line(&f".IsChecked({formatted_args})")
                ()
            "Value" =>
                (*_self).push_line(&f".Value({formatted_args})")
                ()
            "Percent" =>
                (*_self).push_line(&f".Percent({formatted_args})")
                ()
            "MinValue" => if ((*_self).parent_stack.last() == Option::Some(&WidgetType__Slider)): none else: none
            "MinSliderValue" => if ((*_self).parent_stack.last() == Option::Some(&WidgetType__Slider)): none else: none
            "MaxValue" => if ((*_self).parent_stack.last() == Option::Some(&WidgetType__Slider)): none else: none
