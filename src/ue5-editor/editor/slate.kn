                (*_self).push_line(&f".{method}({formatted_args})")
                ()

    fn extract_widget_type(_self: &SlateGenerator, expr: &kain_core::ast::Expr) -> WidgetType:
        match expr:
            kain_core__ast__Expr::Ident(name, _) => WidgetType__from_name(name)
            _ => WidgetType::Unknown(("Unknown").to_string())

    fn format_args(_self: &SlateGenerator, args: &[kain_core::ast::CallArg]) -> String:
        args.iter().map(fn(arg): (*_self).format_expr(&arg.value)).collect().join(", ")

    fn format_expr(_self: &SlateGenerator, expr: &kain_core::ast::Expr) -> String:
        match expr:
            kain_core__ast__Expr::String(s, _) => f"\"{s}\""
            kain_core__ast__Expr::Int(n, _) => n.to_string()
            kain_core__ast__Expr::Float(f, _) => if (f.fract() == 0): f"{f}f" else: f"{f}f"
            kain_core__ast__Expr::Bool(b, _) => b.to_string()
            kain_core__ast__Expr::Ident(name, _) => if (*_self).struct_field_names.contains(name): f"InArgs._{name}" else: name.clone()
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                match &(*(*callee)):
                    kain_core__ast__Expr::Ident(callee_name, _) =>
                        match (*_self).resolve_constructor_call(callee_name, args):
                            Some(resolved) => return resolved
                            _ =>
                                ()
                                ()
                        let formatted_args: Array<String> = args.iter().map(fn(a): (*_self).format_expr(&a.value)).collect()
                        return "{callee_name}({formatted_args.join(\", \")})"
                    _ =>
                        ()
                        ()
                let callee_str = (*_self).format_expr(callee)
                let formatted_args: Array<String> = args.iter().map(fn(a): (*_self).format_expr(&a.value)).collect()
                "{callee_str}({formatted_args.join(\", \")})"
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                let recv = (*_self).format_expr(receiver)
                let formatted_args: Array<String> = args.iter().map(fn(a): (*_self).format_expr(&a.value)).collect()
                if formatted_args.is_empty():
                    f"{recv}.{method}()"
                else:
                    "{recv}.{method}({formatted_args.join(\", \")})"
            kain_core__ast__Expr::Field { object: object, field: field } =>
                let obj = (*_self).format_expr(object)
                f"{obj}.{field}"
            kain_core__ast__Expr::Unary { op: op, operand: operand } =>
                let operand_str = (*_self).format_expr(operand)
                f"{none}{operand_str}"
            kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
                let l = (*_self).format_expr(left)
                let r = (*_self).format_expr(right)
                let op_str = match op:
                    kain_core__ast__BinaryOp::Add => "+"
                    kain_core__ast__BinaryOp::Sub => "-"
                    kain_core__ast__BinaryOp::Mul => "*"
                    kain_core__ast__BinaryOp::Div => "/"
                    kain_core__ast__BinaryOp::Mod => "%"
                    kain_core__ast__BinaryOp::Eq => "=="
                    kain_core__ast__BinaryOp::Ne => "!="
                    kain_core__ast__BinaryOp::Lt => "<"
                    kain_core__ast__BinaryOp::Le => "<="
                    kain_core__ast__BinaryOp::Gt => ">"
                    kain_core__ast__BinaryOp::Ge => ">="
                    kain_core__ast__BinaryOp::And => "&&"
                    kain_core__ast__BinaryOp::Or => "||"
                    kain_core__ast__BinaryOp::BitAnd => "&"
                    kain_core__ast__BinaryOp::BitOr => "|"
                    kain_core__ast__BinaryOp::BitXor => "^"
                    kain_core__ast__BinaryOp::Shl => "<<"
                    kain_core__ast__BinaryOp::Shr => ">>"
                    kain_core__ast__BinaryOp::Pow => "/* pow */"
                    kain_core__ast__BinaryOp::Assign => "="
                    kain_core__ast__BinaryOp::AddAssign => "+="
                    kain_core__ast__BinaryOp::SubAssign => "-="
                    kain_core__ast__BinaryOp::MulAssign => "*="
                    kain_core__ast__BinaryOp::DivAssign => "/="
                    kain_core__ast__BinaryOp::Range => "/* range */"
                    kain_core__ast__BinaryOp::RangeInclusive => "/* range_inclusive */"
                f"({l} {op_str} {r})"
            kain_core__ast__Expr::EnumVariant { enum_name: enum_name, variant: variant } =>
                let cpp_enum = match (*_self).context:
                    Some(ctx) => if ctx.enum_names.contains(enum_name): ue5__ue5__naming__to_enum_name(enum_name) else: enum_name.clone()
                    _ => ue5__ue5__naming__to_enum_name(enum_name)
                f"{cpp_enum}::{variant}"
            _ => ("/* <unsupported_expression> */").to_string()

    fn format_method_expr(_self: &SlateGenerator, expr: &kain_core::ast::Expr) -> String:
        match expr:
            kain_core__ast__Expr::String(s, _) => f"TEXT(\"{s}\")"
            kain_core__ast__Expr::Int(n, _) => n.to_string()
            kain_core__ast__Expr::Float(f, _) => if (f.fract() == 0): f"{f}f" else: f"{f}f"
            kain_core__ast__Expr::Bool(b, _) => b.to_string()
            kain_core__ast__Expr::Ident(name, _) => name.clone()
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                let callee_str = (*_self).format_method_expr(callee)
                let formatted_args: Array<String> = args.iter().map(fn(a): (*_self).format_method_expr(&a.value)).collect()
                "{callee_str}({formatted_args.join(\", \")})"
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                let recv = (*_self).format_method_expr(receiver)
                let formatted_args: Array<String> = args.iter().map(fn(a): (*_self).format_method_expr(&a.value)).collect()
                if formatted_args.is_empty():
                    f"{recv}.{method}()"
                else:
                    "{recv}.{method}({formatted_args.join(\", \")})"
            kain_core__ast__Expr::Field { object: object, field: field } =>
                match &(*(*object)):
                    kain_core__ast__Expr::Ident(obj_name, _) =>
                        let looks_type_like = ((((((obj_name.contains("::") || obj_name.starts_with("S")) || obj_name.starts_with("F")) || obj_name.starts_with("E")) || obj_name.starts_with("U")) || obj_name.starts_with("A")) || obj_name.starts_with("T"))
                        if looks_type_like:
                            return f"{obj_name}::{field}"
                        ()
                    _ =>
                        ()
                        ()
                f"{(*_self).format_method_expr(object)}.{field}"
            kain_core__ast__Expr::Unary { op: op, operand: operand } =>
                let operand_str = (*_self).format_method_expr(operand)
                let op_str = match op:
                    kain_core__ast__UnaryOp::Neg => "-"
                    kain_core__ast__UnaryOp::Not => "!"
                    kain_core__ast__UnaryOp::BitNot => "~"
                    kain_core__ast__UnaryOp::Ref => "&"
                    kain_core__ast__UnaryOp::RefMut => "&"
                    kain_core__ast__UnaryOp::Deref => "*"
                f"{op_str}{operand_str}"
            kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
                let l = (*_self).format_method_expr(left)
                let r = (*_self).format_method_expr(right)
                let op_str = match op:
                    kain_core__ast__BinaryOp::Add => "+"
                    kain_core__ast__BinaryOp::Sub => "-"
                    kain_core__ast__BinaryOp::Mul => "*"
                    kain_core__ast__BinaryOp::Div => "/"
                    kain_core__ast__BinaryOp::Mod => "%"
                    kain_core__ast__BinaryOp::Eq => "=="
                    kain_core__ast__BinaryOp::Ne => "!="
                    kain_core__ast__BinaryOp::Lt => "<"
                    kain_core__ast__BinaryOp::Le => "<="
                    kain_core__ast__BinaryOp::Gt => ">"
                    kain_core__ast__BinaryOp::Ge => ">="
                    kain_core__ast__BinaryOp::And => "&&"
                    kain_core__ast__BinaryOp::Or => "||"
                    kain_core__ast__BinaryOp::BitAnd => "&"
                    kain_core__ast__BinaryOp::BitOr => "|"
                    kain_core__ast__BinaryOp::BitXor => "^"
                    kain_core__ast__BinaryOp::Shl => "<<"
                    kain_core__ast__BinaryOp::Shr => ">>"
                    kain_core__ast__BinaryOp::Pow => "/* pow */"
                    kain_core__ast__BinaryOp::Assign => "="
                    kain_core__ast__BinaryOp::AddAssign => "+="
                    kain_core__ast__BinaryOp::SubAssign => "-="
                    kain_core__ast__BinaryOp::MulAssign => "*="
                    kain_core__ast__BinaryOp::DivAssign => "/="
                    kain_core__ast__BinaryOp::Range => "/* range */"
                    kain_core__ast__BinaryOp::RangeInclusive => "/* range_inclusive */"
                f"({l} {op_str} {r})"
            kain_core__ast__Expr::EnumVariant { enum_name: enum_name, variant: variant } =>
                let cpp_enum = match (*_self).context:
                    Some(ctx) => if ctx.enum_names.contains(enum_name): ue5__ue5__naming__to_enum_name(enum_name) else: enum_name.clone()
                    _ => ue5__ue5__naming__to_enum_name(enum_name)
                f"{cpp_enum}::{variant}"
            kain_core__ast__Expr::None(_) => ("nullptr").to_string()
            _ => (*_self).format_expr(expr)

    fn is_inargs_reference(_self: &SlateGenerator, formatted: String) -> Bool:
        formatted.contains("InArgs._")

    fn handler_name_from_args(_self: &SlateGenerator, args: &[kain_core::ast::CallArg]) -> String:
        match args.first():
            Some(arg) =>
                match &arg.value:
                    kain_core__ast__Expr::Ident(name, _) => return name.clone()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        ("UnknownHandler").to_string()

    fn native_delegate_for_property(_self: &SlateGenerator, property_name: String) -> Option<String>:
        match &(*_self).context:
            Some(ctx) =>
                let current_widget = (*_self).parent_stack.last().map(fn(w): w.to_slate_class())
                match current_widget:
                    Some(widget_name) =>
                        match ctx.widget_registry.get_event_delegate(&widget_name, property_name):
                            Some(delegate) => return Option::Some(delegate)
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                match ctx.widget_registry.get_event_delegate_any(property_name):
                    Some(delegate) => return Option::Some(delegate)
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        match property_name:
            "OnClicked" => Option::Some("FOnClicked")
            "OnPressed" => Option::Some("FSimpleDelegate")
            "OnReleased" => Option::Some("FSimpleDelegate")
            "OnHovered" => Option::Some("FSimpleDelegate")
            "OnUnhovered" => Option::Some("FSimpleDelegate")
            "OnValueChanged" => Option::Some("FOnFloatValueChanged")
            "OnTextCommitted" => Option::Some("FOnTextCommitted")
            "OnTextChanged" => Option::Some("FOnTextChanged")
            "OnCheckStateChanged" => Option::Some("FOnCheckStateChanged")
            "OnSelectionChanged" => Option::Some("FOnSelectionChanged")
            "OnColorChanged" => Option::Some("FOnLinearColorValueChanged")
            "OnMouseButtonDown" => Option::Some("FPointerEventHandler")
            "OnMouseButtonUp" => Option::Some("FPointerEventHandler")
            "OnKeyDown" => Option::Some("FKeyEventHandler")
            "OnKeyUp" => Option::Some("FKeyEventHandler")
            _ => none

    fn emit_delegate_bridge_or_passthrough(_self: &mut SlateGenerator, property_name: String, formatted_args: String):
        let field_name = formatted_args.trim_start_matches("InArgs._")
        let native_type = (*_self).native_delegate_for_property(property_name)
        let field_type = (*_self).field_type_map.get(field_name).cloned()
        let needs_bridge = match (&native_type, &field_type):
            (Some(native), Some(field)) => (native != field)
            _ => false
        if (!needs_bridge):
            (*_self).push_line(&f".{property_name}({formatted_args})")
            ()
            return
        let native = native_type.unwrap()
        match native:
            "FOnClicked" =>
                let broadcast_args = (*_self).get_default_broadcast_args(field_name)
                (*_self).push_line(&".OnClicked(FOnClicked::CreateLambda([=]() -> FReply { auto D = {formatted_args}; D.Broadcast({broadcast_args}); return FReply::Handled(); }))")
                ()
            "FOnFloatValueChanged" =>
                (*_self).push_line(&".OnValueChanged(FOnFloatValueChanged::CreateLambda([=](float Val) { auto D = {formatted_args}; D.Broadcast(Val); }))")
                ()
            "FSimpleDelegate" =>
                let broadcast_args = (*_self).get_default_broadcast_args(field_name)
                (*_self).push_line(&".{property_name}(FSimpleDelegate::CreateLambda([=]() { auto D = {formatted_args}; D.Broadcast({broadcast_args}); }))")
                ()
            "FOnTextCommitted" =>
                (*_self).push_line(&".OnTextCommitted(FOnTextCommitted::CreateLambda([=](const FText& Text, ETextCommit::Type Type) { auto D = {formatted_args}; D.Broadcast(Text, Type); }))")
                ()
            "FOnTextChanged" =>
                (*_self).push_line(&".OnTextChanged(FOnTextChanged::CreateLambda([=](const FText& Text) { auto D = {formatted_args}; D.Broadcast(Text); }))")
                ()
            "FOnCheckStateChanged" =>
                (*_self).push_line(&".OnCheckStateChanged(FOnCheckStateChanged::CreateLambda([=](ECheckBoxState State) { auto D = {formatted_args}; D.Broadcast(State); }))")
                ()
            "FOnLinearColorValueChanged" =>
                (*_self).push_line(&".OnColorChanged(FOnLinearColorValueChanged::CreateLambda([=](FLinearColor Color) { auto D = {formatted_args}; D.Broadcast(Color); }))")
                ()
            "FOnSelectionChanged" =>
                let broadcast_args = (*_self).get_default_broadcast_args(field_name)
                (*_self).push_line(&".OnSelectionChanged_Lambda([=](TSharedPtr<FString> Item, ESelectInfo::Type SelectInfo) { auto D = {formatted_args}; D.Broadcast({broadcast_args}); })")
                ()
            _ =>
                (*_self).push_line(&f".{property_name}({formatted_args})")
                ()

    fn get_default_broadcast_args(_self: &SlateGenerator, field_name: String) -> String:
        match (*_self).delegate_param_map.get(field_name):
            Some(param_types) =>
                if param_types.is_empty():
                    return String__new_()
                param_types.iter().map(fn(t): none).collect().join(", ")
            _ => String__new_()

    fn current_widget_class(_self: &SlateGenerator) -> String:
        (*_self).widget_class_name.clone().unwrap_or_else(fn(): ("Self").to_string())

    fn is_slot_context_expr(_self: &SlateGenerator, expr: &kain_core::ast::Expr) -> Bool:
        match expr:
            kain_core__ast__Expr::MethodCall { method: method, receiver: receiver } => (((method == "Add") || (method == "Slot")) || (*_self).is_slot_context_expr(receiver))
            _ => false

    fn generate_slate_args(_self: &mut SlateGenerator, st: &kain_core::ast::Struct, widget_name: String):
        let mut optimizer = LayoutOptimizer__new_()
        let analyses = optimizer.analyze_widget(st)
        (*_self).field_type_map.clear()
        ()
        let mut declared_delegates: Set<String> = HashSet__new_()
        for selfhost_for_item in (*st).fields.iter().zip(analyses.iter()):
            let (field, analysis) = selfhost_for_item
            let is_event_field = ((none || field.name.starts_with("on_")) || field.name.starts_with("On"))
            if is_event_field:
                let cpp_type = (*_self).map_type(&field.ty)
                let delegate_type = (*_self).map_event_delegate_type(&field.name, &cpp_type)
                if ((delegate_type.starts_with("F") && (delegate_type.len() > 1)) && (!declared_delegates.contains(&delegate_type))):
                    let is_known = (*_self).is_known_delegate_type(&delegate_type)
                    if (!is_known):
                        if (delegate_type == "FOnSelectionChanged"):
                            (*_self).push_line("DECLARE_DELEGATE_TwoParams(FOnSelectionChanged, TSharedPtr<FString>, ESelectInfo::Type);")
                            ()
                            ()
                            ()
                            ()
                        else:
                            (*_self).push_line(&f"DECLARE_DELEGATE({delegate_type});")
                            ()
                            ()
                            ()
                            ()
                        declared_delegates.insert(delegate_type)
                        ()
        ()
        if (!declared_delegates.is_empty()):
            (*_self).push_line("")
            ()
            ()
            ()
            ()
        let report = optimizer.generate_report(&analyses)
        for line_ in report.lines():
            (*_self).push_line(line_)
            ()
        ()
        (*_self).push_line(&f"SLATE_BEGIN_ARGS({widget_name})")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        (*_self).push_line(": _Content()")
        ()
        for field in &(*st).fields:
            let is_delegate = ((field.attributes.iter().any(fn(a): (a.name == "event")) || field.name.starts_with("on_")) || field.name.starts_with("On"))
            if is_delegate:
                let cpp_type = (*_self).map_type(&field.ty)
                let delegate_type = (*_self).map_event_delegate_type(&field.name, &cpp_type)
                (*_self).field_type_map.insert(field.name.clone(), delegate_type.clone())
                ()
                (*_self).push_line(&f", _{field.name}({delegate_type}())")
                ()
            else:
                let cpp_type = (*_self).map_type(&field.ty)
                (*_self).field_type_map.insert(field.name.clone(), cpp_type)
                ()
                let default_val = (*_self).get_default_value(&field.ty)
                (*_self).push_line(&f", _{field.name}({default_val})")
                ()
        ()
        (*_self).push_line("{}")
        ()
        (*_self).push_line("")
        ()
        (*_self).push_line("SLATE_DEFAULT_SLOT(FArguments, Content)")
        ()
        for selfhost_for_item in (*st).fields.iter().zip(analyses.iter()):
            let (field, analysis) = selfhost_for_item
            let cpp_type = (*_self).map_type(&field.ty)
            match analysis.reactivity:
                PropertyReactivity::Event =>
                    let delegate_type = (*_self).map_event_delegate_type(&field.name, &cpp_type)
                    (*_self).push_line(&f"SLATE_EVENT({delegate_type}, {field.name})")
                    ()
                PropertyReactivity::Static =>
                    if (field.name.starts_with("on_") || field.name.starts_with("On")):
                        let delegate_type = (*_self).map_event_delegate_type(&field.name, &cpp_type)
                        (*_self).push_line(&f"SLATE_ARGUMENT({delegate_type}, {field.name})")
                        ()
                    else:
                        (*_self).push_line(&f"SLATE_ARGUMENT({cpp_type}, {field.name})")
                        ()
                PropertyReactivity::Reactive_ =>
                    (*_self).push_line(&f"SLATE_ATTRIBUTE({cpp_type}, {field.name})")
                    ()
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("SLATE_END_ARGS()")
        ()
        (*_self).push_line("")
        ()

    fn map_event_delegate_type(_self: &SlateGenerator, name: String, cpp_type: String) -> String:
        if (cpp_type.starts_with("F") && (cpp_type.len() > 1)):
            let is_known_engine_delegate = match cpp_type:
                "FOnClicked" => true
                "FSimpleDelegate" => true
                "FOnFloatValueChanged" => true
                "FOnTextCommitted" => true
                "FOnTextChanged" => true
                "FOnCheckStateChanged" => true
                "FOnLinearColorValueChanged" => true
                "FPointerEventHandler" => true
                "FKeyEventHandler" => true
                "FOnGenerateRow" => true
                "FOnGetChildren" => true
                _ => false
            let is_known_custom_delegate = match (*_self).context:
                Some(ctx) =>
                    let stripped = cpp_type.strip_prefix("F").unwrap_or(cpp_type)
                    ctx.delegate_names.contains(stripped)
                _ => false
            if (is_known_engine_delegate || is_known_custom_delegate):
                return cpp_type.to_string()
            ()
        match (*_self).context:
            Some(ctx) =>
                let pascal_name = if name.starts_with("on_"):
                    let base = name.strip_prefix("on_").unwrap_or(name)
                    f"On{(*_self).to_pascal_case(base)}"
                else:
                    name.to_string()
                match ctx.widget_registry.get_event_delegate_any(&pascal_name):
                    Some(delegate) => return delegate.to_string()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        match name:
            "OnClicked" => ("FOnClicked").to_string()
            "on_clicked" => ("FOnClicked").to_string()
            "on_start_clicked" => ("FOnClicked").to_string()
            "on_stop_clicked" => ("FOnClicked").to_string()
            "on_pause_clicked" => ("FOnClicked").to_string()
            "OnPressed" => ("FSimpleDelegate").to_string()
            "OnReleased" => ("FSimpleDelegate").to_string()
            "OnHovered" => ("FSimpleDelegate").to_string()
            "OnUnhovered" => ("FSimpleDelegate").to_string()
            "OnTextCommitted" => ("FOnTextCommitted").to_string()
            "on_text_committed" => ("FOnTextCommitted").to_string()
            "OnTextChanged" => ("FOnTextChanged").to_string()
            "on_text_changed" => ("FOnTextChanged").to_string()
            "OnValueChanged" => ("FOnFloatValueChanged").to_string()
            "on_value_changed" => ("FOnFloatValueChanged").to_string()
            "OnCheckStateChanged" => ("FOnCheckStateChanged").to_string()
            "on_check_state_changed" => ("FOnCheckStateChanged").to_string()
            "OnSelectionChanged" => ("FOnSelectionChanged").to_string()
            "on_selection_changed" => ("FOnSelectionChanged").to_string()
            "OnGenerateRow" => ("FOnGenerateRow").to_string()
            "on_generate_row" => ("FOnGenerateRow").to_string()
            "OnGetChildren" => ("FOnGetChildren").to_string()
            "on_get_children" => ("FOnGetChildren").to_string()
            "OnMouseButtonDown" => ("FPointerEventHandler").to_string()
            "OnMouseButtonUp" => ("FPointerEventHandler").to_string()
            "OnKeyDown" => ("FKeyEventHandler").to_string()
            "OnKeyUp" => ("FKeyEventHandler").to_string()
            "OnColorChanged" => ("FOnLinearColorValueChanged").to_string()
            "on_color_changed" => ("FOnLinearColorValueChanged").to_string()
            _ =>
                match (*_self).context:
                    Some(ctx) =>
                        let base_name = name.strip_prefix("on_").unwrap_or(name)
                        let pascal_name = (*_self).to_pascal_case(base_name)
                        if ctx.delegate_names.contains(&pascal_name):
                            return f"F{pascal_name}"
                        ()
                    _ =>
                        ()
                        ()
                if (cpp_type == "void"):
                    ("FSimpleDelegate").to_string()
                else:
                    cpp_type.to_string()

    fn is_known_delegate_type(_self: &SlateGenerator, delegate_type: String) -> Bool:
        if (delegate_type == "FOnSelectionChanged"):
            return false
        let is_engine = match delegate_type:
            "FOnClicked" => true
            "FSimpleDelegate" => true
            "FOnFloatValueChanged" => true
            "FOnTextCommitted" => true
            "FOnTextChanged" => true
            "FOnCheckStateChanged" => true
            "FOnLinearColorValueChanged" => true
            "FPointerEventHandler" => true
            "FKeyEventHandler" => true
            "FOnGenerateRow" => true
            "FOnGetChildren" => true
            _ => false
        if is_engine:
            return true
        match (*_self).context:
            Some(ctx) =>
                let stripped = delegate_type.strip_prefix("F").unwrap_or(delegate_type)
                if ctx.delegate_names.contains(stripped):
                    return true
                ()
            _ =>
                ()
                ()
        false

    fn to_pascal_case(_self: &SlateGenerator, s: String) -> String:
        s.split("_").map(fn(word): none).collect()

    fn generate_event_handlers(_self: &mut SlateGenerator, st: &kain_core::ast::Struct):
        let widget_model = (*_self).resolve_widget_model(st)
        for field in &(*st).fields:
            if (field.name.starts_with("On") || field.name.starts_with("on_")):
                let cpp_type = (*_self).map_type(&field.ty)
                let delegate_type = (*_self).map_event_delegate_type(&field.name, &cpp_type)
                (*_self).push_line("")
                ()
                (*_self).push_line(&(*_self).handler_decl_for_delegate(&delegate_type, &field.name))
                ()
        ()
        for method in &(*st).methods:
            if ((method.name != "Compose") && (method.name != "Construct")):
                if ((method.name == "GenerateWidgetForColumn") && (widget_model.construct_kind == SlateConstructKind__TableRow)):
                    (*_self).push_line("")
                    ()
                    (*_self).push_line("virtual TSharedRef<SWidget> GenerateWidgetForColumn(const FName& ColumnName) override;")
                    ()
                    continue
                if ((method.name == "OnOpening") && (widget_model.construct_kind == SlateConstructKind__ToolTip)):
                    (*_self).push_line("")
                    ()
                    (*_self).push_line("virtual void OnOpening() override;")
                    ()
                    continue
                let params = method.params.iter().map(fn(p): f"{(*_self).map_type(&p.ty)} {p.name}").collect().join(", ")
                let ret_type = match &method.return_type:
                    Some(ret_ty) => (*_self).map_type(ret_ty)
                    _ =>
                        if (method.name == "OnOpening"):
                            ("void").to_string()
                        elif (method.name.starts_with("On") || method.name.starts_with("Handle")):
                            ("FReply").to_string()
                        else:
                            ("void").to_string()
                (*_self).push_line("")
                ()
                (*_self).push_line(&f"{ret_type} {method.name}({params});")
                ()

    fn handler_decl_for_delegate(_self: &SlateGenerator, delegate_type: String, field_name: String) -> String:
        match delegate_type:
            "FOnClicked" => f"FReply Handle{field_name}();"
            "FSimpleDelegate" => f"void Handle{field_name}();"
            "FOnFloatValueChanged" => f"void Handle{field_name}(float NewValue);"
            "FOnTextCommitted" => f"void Handle{field_name}(const FText& InText, ETextCommit::Type CommitType);"
            "FOnTextChanged" => f"void Handle{field_name}(const FText& InText);"
            "FOnCheckStateChanged" => f"void Handle{field_name}(ECheckBoxState NewState);"
            "FOnSelectionChanged" => f"void Handle{field_name}(TSharedPtr<FString> InItem, ESelectInfo::Type SelectInfo);"
            "FOnLinearColorValueChanged" => f"void Handle{field_name}(FLinearColor NewColor);"
            "FPointerEventHandler" => f"FReply Handle{field_name}(const FGeometry& Geometry, const FPointerEvent& MouseEvent);"
            "FKeyEventHandler" => f"FReply Handle{field_name}(const FGeometry& Geometry, const FKeyEvent& KeyEvent);"
            "FOnGenerateRow" => f"TSharedRef<ITableRow> Handle{field_name}(TSharedPtr<FString> InItem, const TSharedRef<STableViewBase>& OwnerTable);"
            "FOnGetChildren" => f"void Handle{field_name}(TSharedPtr<FString> InItem, TArray<TSharedPtr<FString>>& OutChildren);"
            _ => f"void Handle{field_name}();"

    fn has_list_data(_self: &SlateGenerator, st: &kain_core::ast::Struct) -> Bool:
        (*st).fields.iter().any(fn(f): (none || none))

    fn generate_list_view_support(_self: &mut SlateGenerator, st: &kain_core::ast::Struct):
        (*_self).push_line("")
        ()
        (*_self).push_line("// === List View Support ===")
        ()
        for field in &(*st).fields:
            let element_opt = match &field.ty:
                kain_core__ast__Type::Array(element, _, _) => Option::Some(element)
                kain_core__ast__Type::Named { name: name, generics: generics } if (name.eq_ignore_ascii_case("Array") && (!generics.is_empty())) => Option::Some(&generics[0])
                _ => none
            match element_opt:
                Some(element) =>
                    let element_type = (*_self).map_type(element)
                    let ptr_type = f"TSharedPtr<{element_type}>"
                    (*_self).list_item_types.insert(field.name.clone(), element_type.clone())
                    ()
                    (*_self).push_line(&f"TArray<{ptr_type}> {field.name};")
                    ()
                    (*_self).push_line("")
                    ()
                    (*_self).push_line(&f"{ptr_type} Selected{field.name}Item;")
                    ()
                    (*_self).push_line("")
                    ()
                    (*_self).push_line(&f"TSharedRef<ITableRow> OnGenerateRow_{field.name}({ptr_type} InItem, const TSharedRef<STableViewBase>& OwnerTable);")
                    ()
                    (*_self).push_line(&f"void OnSelectionChanged_{field.name}({ptr_type} InItem, ESelectInfo::Type SelectInfo);")
                    ()
                    (*_self).push_line("")
                    ()
                    (*_self).push_line(&f"TSharedPtr<SListView<{ptr_type}>> {field.name}ListView;")
                    ()
                _ => ()

    fn infer_list_item_type_from_method_calls(_self: &SlateGenerator, method_calls: &[MethodCallInfo]) -> Option<String>:
        for call in method_calls:
            if (call.method == "ListItemsSource"):
                match call.args.first():
                    Some(arg) =>
                        match (*_self).infer_list_item_type_from_expr(&arg.value):
                            Some(item_ty) => return Option::Some(item_ty)
                            _ => ()
                    _ => ()
        ()
        none

    fn infer_list_item_type_from_expr(_self: &SlateGenerator, expr: &kain_core::ast::Expr) -> Option<String>:
        match expr:
            kain_core__ast__Expr::Ident(name, _) => (*_self).list_item_types.get(name).cloned()
            kain_core__ast__Expr::Field { object: object, field: field } =>
                match &(*(*object)):
                    kain_core__ast__Expr::Ident(base, _) =>
                        if (base == "InArgs"):
                            return (*_self).list_item_types.get(field).cloned()
                        ()
                    _ =>
                        ()
                        ()
                none
            _ => none

    fn list_widget_stype(_self: &SlateGenerator, slate_class: String) -> String:
        (*_self).list_widget_stype_for(slate_class, none)

    fn list_widget_stype_for(_self: &SlateGenerator, slate_class: String, preferred_item_type: Option<String>) -> String:
        match preferred_item_type:
            Some(elem) => return f"SNew({slate_class}<TSharedPtr<{elem}>>)"
            _ =>
                ()
                ()
        if ((*_self).list_item_types.len() == 1):
            match (*_self).list_item_types.values().next():
                Some(elem) => return f"SNew({slate_class}<TSharedPtr<{elem}>>)"
                _ =>
                    ()
                    ()
            ()
        f"SNew({slate_class}<TSharedPtr<FString>>)"

    fn map_type(_self: &SlateGenerator, ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                if (name.eq_ignore_ascii_case("Array") && (!generics.is_empty())):
                    return f"TArray<{(*_self).map_type(&generics[0])}>"
                match name.as_str():
                    "Int" => ("int32").to_string()
                    "int" => ("int32").to_string()
                    "Float" => ("float").to_string()
                    "float" => ("float").to_string()
                    "Bool" => ("bool").to_string()
                    "bool" => ("bool").to_string()
                    "String" => ("FString").to_string()
                    "str" => ("FString").to_string()
                    "Text" => ("FText").to_string()
                    "Color" => ("FLinearColor").to_string()
                    "Vec2" => ("FVector2D").to_string()
                    "Vec3" => ("FVector").to_string()
                    "Vec4" => ("FVector4").to_string()
                    "Brush" => ("const FSlateBrush*").to_string()
                    "Margin" => ("FMargin").to_string()
                    "FOnClicked" => name.clone()
                    "FSimpleDelegate" => name.clone()
                    "FOnFloatValueChanged" => name.clone()
                    "FOnTextCommitted" => name.clone()
                    "FOnTextChanged" => name.clone()
                    "FOnCheckStateChanged" => name.clone()
                    "FOnSelectionChanged" => name.clone()
                    "FOnLinearColorValueChanged" => name.clone()
                    "FPointerEventHandler" => name.clone()
                    "FKeyEventHandler" => name.clone()
                    "FOnGenerateRow" => name.clone()
                    "FOnGetChildren" => name.clone()
                    _ =>
                        match (*_self).context:
                            Some(ctx) =>
                                let enum_base = name.strip_prefix("E").unwrap_or(name)
                                let mapped_enum_name = ue5__ue5__naming__to_enum_name(enum_base)
                                if (((ctx.enum_names.contains(name) || ctx.enum_names.contains(enum_base)) || ctx.enum_names.contains(&mapped_enum_name)) || ctx.enum_names.iter().any(fn(e): (ue5__ue5__naming__to_enum_name(e) == mapped_enum_name))):
                                    return mapped_enum_name
                                if ctx.struct_names.contains(name):
                                    return ue5__ue5__naming__to_struct_name(name)
                                if ctx.actor_names.contains(name):
                                    return f"{ue5__ue5__naming__to_actor_name(name)}*"
                                if ctx.component_names.contains(name):
                                    return f"{ue5__ue5__naming__to_uobject_name(name)}*"
                                if ctx.delegate_names.contains(name):
                                    return ue5__ue5__naming__to_struct_name(name)
                                ()
                            _ =>
                                ()
                                ()
                        ue5__ue5__naming__to_struct_name(name)
            kain_core__ast__Type::Array(element, _, _) => f"TArray<{(*_self).map_type(element)}>"
            kain_core__ast__Type::Unit(_) => ("void").to_string()
            _ => ("auto").to_string()

    fn get_default_value(_self: &SlateGenerator, ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                if (name.eq_ignore_ascii_case("Array") && (!generics.is_empty())):
                    return f"TArray<{(*_self).map_type(&generics[0])}>()"
                match name.as_str():
                    "Int" => ("0").to_string()
                    "int" => ("0").to_string()
                    "Float" => ("0.0f").to_string()
                    "float" => ("0.0f").to_string()
                    "Bool" => ("false").to_string()
                    "bool" => ("false").to_string()
                    "String" => ("FString()").to_string()
                    "str" => ("FString()").to_string()
                    "Text" => ("FText::GetEmpty()").to_string()
                    "Color" => ("FLinearColor::White").to_string()
                    "Vec2" => ("FVector2D::ZeroVector").to_string()
                    "Vec3" => ("FVector::ZeroVector").to_string()
                    "Vec4" => ("FVector4(0, 0, 0, 0)").to_string()
                    "Margin" => ("FMargin(0)").to_string()
                    "Brush" => ("nullptr").to_string()
                    _ =>
                        if (name.starts_with("On") || name.starts_with("on_")):
                            let delegate_type = (*_self).map_event_delegate_type(name, "")
                            f"{delegate_type}()"
                        else:
                            let mapped = (*_self).map_type(ty)
                            if mapped.ends_with("*"):
                                ("nullptr").to_string()
                            else:
                                f"{mapped}()"
            kain_core__ast__Type::Array(element, _, _) =>
                let element_type = (*_self).map_type(element)
                f"TArray<{element_type}>()"
            kain_core__ast__Type::Unit(_) => ("FSimpleDelegate()").to_string()
            _ => ("{}").to_string()

    fn push_line(_self: &mut SlateGenerator, line_: String):
        let indent_str = ("\t").repeat((*_self).indent)
        (*_self).lines.push(f"{indent_str}{line_}")
        ()


