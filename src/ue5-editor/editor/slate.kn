use kain_core::ast::Attribute

use kain_core::ast::Block

use kain_core::ast::ElseBranch

use kain_core::ast::Expr

use kain_core::ast::Function

use kain_core::ast::Pattern

use kain_core::ast::Stmt

use kain_core::ast::Struct

use kain_core::ast::Type

use kain_core::types::TypedStruct

use std::collections::HashMap

use crate::editor::reactive::LayoutOptimizer

use crate::editor::reactive::PropertyReactivity

use ue5::ue5::naming

pub enum WidgetType:
    VerticalBox
    HorizontalBox
    GridPanel
    UniformGridPanel
    ScrollBox
    Border
    Overlay
    Splitter
    WrapBox
    Canvas
    Button
    CheckBox
    ComboBox
    EditableTextBox
    Slider
    SpinBox
    ColorBlock
    TextBlock
    Image
    ProgressBar
    Separator
    ToolTip
    ListView
    TreeView
    TileView
    TableRow
    MenuAnchor
    Unknown(String)

impl WidgetType:
    pub fn from_name(name: String) -> WidgetType:
        match name:
            "VerticalBox" => WidgetType__VerticalBox
            "SVerticalBox" => WidgetType__VerticalBox
            "HorizontalBox" => WidgetType__HorizontalBox
            "SHorizontalBox" => WidgetType__HorizontalBox
            "GridPanel" => WidgetType__GridPanel
            "SGridPanel" => WidgetType__GridPanel
            "UniformGridPanel" => WidgetType__UniformGridPanel
            "SUniformGridPanel" => WidgetType__UniformGridPanel
            "ScrollBox" => WidgetType__ScrollBox
            "SScrollBox" => WidgetType__ScrollBox
            "Border" => WidgetType__Border
            "SBorder" => WidgetType__Border
            "Overlay" => WidgetType__Overlay
            "SOverlay" => WidgetType__Overlay
            "Splitter" => WidgetType__Splitter
            "SSplitter" => WidgetType__Splitter
            "WrapBox" => WidgetType__WrapBox
            "SWrapBox" => WidgetType__WrapBox
            "Canvas" => WidgetType__Canvas
            "SCanvas" => WidgetType__Canvas
            "Button" => WidgetType__Button
            "SButton" => WidgetType__Button
            "CheckBox" => WidgetType__CheckBox
            "SCheckBox" => WidgetType__CheckBox
            "ComboBox" => WidgetType__ComboBox
            "SComboBox" => WidgetType__ComboBox
            "EditableTextBox" => WidgetType__EditableTextBox
            "SEditableTextBox" => WidgetType__EditableTextBox
            "Slider" => WidgetType__Slider
            "SSlider" => WidgetType__Slider
            "SpinBox" => WidgetType__SpinBox
            "SSpinBox" => WidgetType__SpinBox
            "ColorBlock" => WidgetType__ColorBlock
            "SColorBlock" => WidgetType__ColorBlock
            "ColorPicker" => WidgetType__ColorBlock
            "SColorPicker" => WidgetType__ColorBlock
            "TextBlock" => WidgetType__TextBlock
            "STextBlock" => WidgetType__TextBlock
            "Image" => WidgetType__Image
            "SImage" => WidgetType__Image
            "ProgressBar" => WidgetType__ProgressBar
            "SProgressBar" => WidgetType__ProgressBar
            "Separator" => WidgetType__Separator
            "SSeparator" => WidgetType__Separator
            "ToolTip" => WidgetType__ToolTip
            "SToolTip" => WidgetType__ToolTip
            "ListView" => WidgetType__ListView
            "SListView" => WidgetType__ListView
            "TreeView" => WidgetType__TreeView
            "STreeView" => WidgetType__TreeView
            "TileView" => WidgetType__TileView
            "STileView" => WidgetType__TileView
            "TableRow" => WidgetType__TableRow
            "STableRow" => WidgetType__TableRow
            "MenuAnchor" => WidgetType__MenuAnchor
            "SMenuAnchor" => WidgetType__MenuAnchor
            _ => WidgetType::Unknown(name.to_string())

    pub fn to_slate_class(_self: &WidgetType) -> String:
        match *_self:
            WidgetType::VerticalBox => ("SVerticalBox").to_string()
            WidgetType::HorizontalBox => ("SHorizontalBox").to_string()
            WidgetType::GridPanel => ("SGridPanel").to_string()
            WidgetType::UniformGridPanel => ("SUniformGridPanel").to_string()
            WidgetType::ScrollBox => ("SScrollBox").to_string()
            WidgetType::Border => ("SBorder").to_string()
            WidgetType::Overlay => ("SOverlay").to_string()
            WidgetType::Splitter => ("SSplitter").to_string()
            WidgetType::WrapBox => ("SWrapBox").to_string()
            WidgetType::Canvas => ("SCanvas").to_string()
            WidgetType::Button => ("SButton").to_string()
            WidgetType::CheckBox => ("SCheckBox").to_string()
            WidgetType::ComboBox => ("SComboBox<TSharedPtr<FString>>").to_string()
            WidgetType::EditableTextBox => ("SEditableTextBox").to_string()
            WidgetType::Slider => ("SSlider").to_string()
            WidgetType::SpinBox => ("SSpinBox<float>").to_string()
            WidgetType::ColorBlock => ("SColorBlock").to_string()
            WidgetType::TextBlock => ("STextBlock").to_string()
            WidgetType::Image => ("SImage").to_string()
            WidgetType::ProgressBar => ("SProgressBar").to_string()
            WidgetType::Separator => ("SSeparator").to_string()
            WidgetType::ToolTip => ("SToolTip").to_string()
            WidgetType::ListView => ("SListView").to_string()
            WidgetType::TreeView => ("STreeView").to_string()
            WidgetType::TileView => ("STileView").to_string()
            WidgetType::TableRow => ("STableRow").to_string()
            WidgetType::MenuAnchor => ("SMenuAnchor").to_string()
            WidgetType::Unknown(name) => f"S{name}"

    pub fn has_slots(_self: &WidgetType) -> Bool:
        match *_self:
            WidgetType::VerticalBox => true
            WidgetType::HorizontalBox => true
            WidgetType::GridPanel => true
            WidgetType::UniformGridPanel => true
            WidgetType::ScrollBox => true
            WidgetType::Overlay => true
            WidgetType::Splitter => true
            WidgetType::WrapBox => true
            WidgetType::Canvas => true
            _ => false

    pub fn is_list_widget(_self: &WidgetType) -> Bool:
        match *_self:
            WidgetType::ListView => true
            WidgetType::TreeView => true
            WidgetType::TileView => true
            _ => false

    pub fn has_content_slot(_self: &WidgetType) -> Bool:
        match *_self:
            WidgetType::Border => true
            WidgetType::Button => true
            WidgetType::ToolTip => true
            WidgetType::MenuAnchor => true
            _ => false


@doc(doc = " Slot configuration for layout widgets")
@derive(Debug, Clone, Default)
pub struct SlotConfig:
    padding: Option<String>
    h_align: Option<String>
    v_align: Option<String>
    fill_width: Option<String>
    fill_height: Option<String>
    auto_width: Bool
    auto_height: Bool
    max_width: Option<String>
    max_height: Option<String>
    column: Option<i32>
    row: Option<i32>
    column_span: Option<i32>
    row_span: Option<i32>
    position: Option<String>
    size: Option<String>

impl Default for SlotConfig:
    pub fn default_() -> SlotConfig:
        SlotConfig { padding: none, h_align: none, v_align: none, fill_width: none, fill_height: none, auto_width: false, auto_height: false, max_width: none, max_height: none, column: none, row: none, column_span: none, row_span: none, position: none, size: none }


@doc(doc = " Shader brush tracked for generation")
struct ShaderBrush:
    id: usize
    material_expr: kain_core::ast::Expr
    size_expr: kain_core::ast::Expr

@doc(doc = " Widget information tracked in symbol table")
@derive(Debug, Clone)
struct WidgetInfo:
    construction: kain_core::ast::Expr
    method_calls: Array<MethodCallInfo>

@doc(doc = " Method call information for widget tree reconstruction")
@derive(Debug, Clone)
struct MethodCallInfo:
    method: String
    args: Array<kain_core::ast::CallArg>

enum SlateConstructKind:
    Compound
    TableRow
    ToolTip

@derive(Debug, Clone)
struct SlateWidgetModel:
    base_class: String
    construct_kind: SlateConstructKind

enum SpecialSlateMethodKind:
    GenerateWidgetForColumn
    OnOpening

impl SlateWidgetModel:
    fn compound() -> SlateWidgetModel:
        SlateWidgetModel { base_class: ("SCompoundWidget").to_string(), construct_kind: SlateConstructKind__Compound }


@doc(doc = " Slate widget generator with hierarchy tracking")
pub struct SlateGenerator:
    parent_stack: Array<WidgetType>
    indent: usize
    lines: Array<String>
    slot_configs: Map<String, SlotConfig>
    shader_brush_counter: usize
    context: Option<ue5::ue5::Ue5Context>
    struct_field_names: Set<String>
    field_type_map: Map<String, String>
    delegate_param_map: Map<String, Array<String>>
    list_item_types: Map<String, String>
    widget_class_name: Option<String>

impl SlateGenerator:
    pub fn new_() -> SlateGenerator:
        SlateGenerator { parent_stack: Vec__new_(), indent: 0, lines: Vec__new_(), slot_configs: HashMap__new_(), shader_brush_counter: 0, context: none, struct_field_names: HashSet__new_(), field_type_map: HashMap__new_(), delegate_param_map: HashMap__new_(), list_item_types: HashMap__new_(), widget_class_name: none }

    pub fn with_context(_self: SlateGenerator, context: ue5::ue5::Ue5Context) -> SlateGenerator:
        _self.context = Option::Some(context)
        ()
        _self

    fn resolve_widget_model(_self: &SlateGenerator, st: &kain_core::ast::Struct) -> SlateWidgetModel:
        let mut model = SlateWidgetModel__compound()
        match (*st).attributes.iter().find(fn(a): ((a.name == "base") || (a.name == "slate_base"))):
            Some(base_attr) =>
                match SlateGenerator__attr_first_arg_text(base_attr):
                    Some(base_name) =>
                        model.base_class = base_name
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        match (*st).attributes.iter().find(fn(a): ((a.name == "table_row") || (a.name == "multi_column_row"))):
            Some(row_attr) =>
                let item_type = row_attr.args.first().and_then(fn(arg): none).unwrap_or_else(fn(): ("FString").to_string())
                model.base_class = f"SMultiColumnTableRow<TSharedPtr<{item_type}>>"
                ()
                model.construct_kind = SlateConstructKind__TableRow
                ()
                return model
            _ =>
                ()
                ()
        if (*st).attributes.iter().any(fn(a): ((a.name == "tooltip_widget") || (a.name == "slate_tooltip"))):
            model.base_class = ("SToolTip").to_string()
            ()
            model.construct_kind = SlateConstructKind__ToolTip
            ()
            return model
        if model.base_class.contains("SMultiColumnTableRow"):
            model.construct_kind = SlateConstructKind__TableRow
            ()
            ()
            ()
            ()
        elif (model.base_class.ends_with("SToolTip") || (model.base_class == "SToolTip")):
            model.construct_kind = SlateConstructKind__ToolTip
            ()
            ()
            ()
            ()
        model

    fn attr_first_arg_text(attr: &kain_core::ast::Attribute) -> Option<String>:
        let first = (*attr).args.first()?
        match first:
            kain_core__ast__Expr::String(s, _) => Option::Some(s.clone())
            kain_core__ast__Expr::Ident(name, _) => Option::Some(name.clone())
            _ => none

    pub fn register_delegate_params(_self: &mut SlateGenerator, field_name: String, param_cpp_types: Array<String>):
        (*_self).delegate_param_map.insert(field_name.to_string(), param_cpp_types)
        ()

    fn scan_for_shader_brushes(_self: &SlateGenerator, st: &kain_core::types::TypedStruct) -> Array<ShaderBrush>:
        let mut brushes = Vec__new_()
        match (*st).ast.methods.iter().find(fn(m): (m.name == "Compose")):
            Some(compose_fn) =>
                match compose_fn.body.stmts.last():
                    Some(last_stmt) =>
                        let expr_opt = match last_stmt:
                            kain_core__ast__Stmt::Expr(expr) => Option::Some(expr)
                            kain_core__ast__Stmt::Return(Some(expr), _) => Option::Some(expr)
                            _ => none
                        match expr_opt:
                            Some(expr) =>
                                (*_self).visit_expr_for_brushes(expr, &mut brushes)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        brushes

    fn visit_expr_for_brushes(_self: &SlateGenerator, expr: &kain_core::ast::Expr, brushes: &mut Array<ShaderBrush>):
        match expr:
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                match &(*(*callee)):
                    kain_core__ast__Expr::Ident(name, _) =>
                        if (name == "shader_image"):
                            if (args.len() >= 2):
                                brushes.push(ShaderBrush { id: brushes.len(), material_expr: args[0].value.clone(), size_expr: args[1].value.clone() })
                                ()
                                return
                            ()
                        ()
                    _ =>
                        ()
                        ()
                for arg in args:
                    (*_self).visit_expr_for_brushes(&arg.value, brushes)
                    ()
            kain_core__ast__Expr::MethodCall { receiver: receiver, args: args } =>
                (*_self).visit_expr_for_brushes(receiver, brushes)
                ()
                for arg in args:
                    (*_self).visit_expr_for_brushes(&arg.value, brushes)
                    ()
            _ => ()

    pub fn generate_widget(_self: &mut SlateGenerator, st: &kain_core::types::TypedStruct) -> String:
        (*_self).lines.clear()
        ()
        let widget_name = f"S{(*st).ast.name}"
        (*_self).widget_class_name = Option::Some(widget_name.clone())
        ()
        let widget_model = (*_self).resolve_widget_model(&(*st).ast)
        (*_self).push_line(&f"class {widget_name} : public {widget_model.base_class}")
        ()
        (*_self).push_line("{")
        ()
        (*_self).push_line("public:")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        if (widget_model.construct_kind == SlateConstructKind__TableRow):
            (*_self).push_line(&f"using FSuperRowType = {widget_model.base_class};")
            ()
            (*_self).push_line("")
            ()
            ()
            ()
            ()
        (*_self).generate_slate_args(&(*st).ast, &widget_name)
        ()
        match widget_model.construct_kind:
            SlateConstructKind::TableRow =>
                (*_self).push_line("void Construct(const FArguments& InArgs, const TSharedRef<STableViewBase>& InOwnerTableView);")
                ()
                ()
                ()
                ()
            _ =>
                (*_self).push_line("void Construct(const FArguments& InArgs);")
                ()
        (*_self).generate_event_handlers(&(*st).ast)
        ()
        if (*_self).has_list_data(&(*st).ast):
            (*_self).generate_list_view_support(&(*st).ast)
            ()
            ()
            ()
            ()
        let brushes = (*_self).scan_for_shader_brushes(st)
        if (!brushes.is_empty()):
            (*_self).push_line("")
            ()
            (*_self).push_line("// Shader Brushes")
            ()
            for brush in brushes:
                (*_self).push_line(&f"TSharedPtr<FSlateImageBrush> ShaderBrush_{brush.id};")
                ()
            ()
            ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("};")
        ()
        (*_self).lines.join("\n")

    pub fn generate_construct_impl(_self: &mut SlateGenerator, st: &kain_core::types::TypedStruct, widget_name: String) -> String:
        (*_self).lines.clear()
        ()
        (*_self).widget_class_name = Option::Some(widget_name.to_string())
        ()
        let widget_model = (*_self).resolve_widget_model(&(*st).ast)
        (*_self).struct_field_names.clear()
        ()
        for field in &(*st).ast.fields:
            (*_self).struct_field_names.insert(field.name.clone())
            ()
        ()
        (*_self).push_line("BEGIN_SLATE_FUNCTION_BUILD_OPTIMIZATION")
        ()
        match widget_model.construct_kind:
            SlateConstructKind::TableRow =>
                (*_self).push_line(&f"void {widget_name}::Construct(const FArguments& InArgs, const TSharedRef<STableViewBase>& InOwnerTableView)")
                ()
                ()
                ()
                ()
            _ =>
                (*_self).push_line(&f"void {widget_name}::Construct(const FArguments& InArgs)")
                ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        let brushes = (*_self).scan_for_shader_brushes(st)
        for brush in &brushes:
            let mat_code = (*_self).format_expr_in_construct(&brush.material_expr)
            let size_code = (*_self).format_expr_in_construct(&brush.size_expr)
            (*_self).push_line(&f"ShaderBrush_{brush.id} = MakeShareable(new FSlateImageBrush({mat_code}, {size_code}));")
            ()
        ()
        if (widget_model.construct_kind == SlateConstructKind__TableRow):
            (*_self).push_line("FSuperRowType::Construct(FSuperRowType::FArguments(), InOwnerTableView);")
            ()
            ()
            ()
            ()
        match (*st).ast.methods.iter().find(fn(m): (m.name == "Compose")):
            Some(compose_fn) =>
                let symbol_table = (*_self).build_symbol_table(&compose_fn.body)
                match compose_fn.body.stmts.last():
                    Some(last_stmt) =>
                        let expr_opt = match last_stmt:
                            kain_core__ast__Stmt::Expr(expr) => Option::Some(expr)
                            kain_core__ast__Stmt::Return(Some(expr), _) => Option::Some(expr)
                            _ => none
                        match expr_opt:
                            Some(expr) =>
                                match widget_model.construct_kind:
                                    SlateConstructKind::Compound =>
                                        (*_self).push_line("ChildSlot")
                                        ()
                                        (*_self).push_line("[")
                                        ()
                                        (*_self).indent = ((*_self).indent + 1)
                                        ()
                                        (*_self).generate_widget_tree_with_context(expr, st, &symbol_table)
                                        ()
                                        (*_self).indent = ((*_self).indent - 1)
                                        ()
                                        (*_self).push_line("];")
                                        ()
                                        ()
                                        ()
                                        ()
                                    SlateConstructKind::ToolTip =>
                                        (*_self).push_line("SToolTip::FArguments ToolTipArgs = SToolTip::FArguments();")
                                        ()
                                        (*_self).push_line("ToolTipArgs.Content()")
                                        ()
                                        (*_self).push_line("[")
                                        ()
                                        (*_self).indent = ((*_self).indent + 1)
                                        ()
                                        (*_self).generate_widget_tree_with_context(expr, st, &symbol_table)
                                        ()
                                        (*_self).indent = ((*_self).indent - 1)
                                        ()
                                        (*_self).push_line("];")
                                        ()
                                        (*_self).push_line("SToolTip::Construct(ToolTipArgs);")
                                        ()
                                        ()
                                        ()
                                        ()
                                    SlateConstructKind::TableRow =>
                                        (*_self).push_line("// Compose() ignored for SMultiColumnTableRow; override GenerateWidgetForColumn instead.")
                                        ()
                                        ()
                                        ()
                                        ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                if (widget_model.construct_kind == SlateConstructKind__ToolTip):
                    (*_self).push_line("SToolTip::Construct(SToolTip::FArguments());")
                    ()
                    ()
                    ()
                    ()
                else:
                    (*_self).push_line("// No Compose() method found")
                    ()
                    ()
                    ()
                    ()
                ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        (*_self).push_line("END_SLATE_FUNCTION_BUILD_OPTIMIZATION")
        ()
        (*_self).generate_special_method_impls(st, widget_name)
        ()
        (*_self).lines.join("\n")

    fn generate_special_method_impls(_self: &mut SlateGenerator, st: &kain_core::types::TypedStruct, widget_name: String):
        let widget_model = (*_self).resolve_widget_model(&(*st).ast)
        let has_generate_widget_for_column = ((widget_model.construct_kind == SlateConstructKind__TableRow) && (*st).ast.methods.iter().any(fn(m): (m.name == "GenerateWidgetForColumn")))
        let has_on_opening = ((widget_model.construct_kind == SlateConstructKind__ToolTip) && (*st).ast.methods.iter().any(fn(m): (m.name == "OnOpening")))
        if has_generate_widget_for_column:
            match (*st).ast.methods.iter().find(fn(m): (m.name == "GenerateWidgetForColumn")):
                Some(method) =>
                    (*_self).emit_special_method_impl(st, widget_name, method, SpecialSlateMethodKind__GenerateWidgetForColumn)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        if has_on_opening:
            match (*st).ast.methods.iter().find(fn(m): (m.name == "OnOpening")):
                Some(method) =>
                    (*_self).emit_special_method_impl(st, widget_name, method, SpecialSlateMethodKind__OnOpening)
                    ()
                _ => ()

    fn emit_special_method_impl(_self: &mut SlateGenerator, st: &kain_core::types::TypedStruct, widget_name: String, method: &kain_core::ast::Function, kind: SpecialSlateMethodKind):
        let symbol_table = (*_self).build_symbol_table(&(*method).body)
        (*_self).push_line("")
        ()
        match kind:
            SpecialSlateMethodKind::GenerateWidgetForColumn =>
                (*_self).push_line(&f"TSharedRef<SWidget> {widget_name}::GenerateWidgetForColumn(const FName& ColumnName)")
                ()
                ()
                ()
                ()
            SpecialSlateMethodKind::OnOpening =>
                (*_self).push_line(&f"void {widget_name}::OnOpening()")
                ()
                ()
                ()
                ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        if (kind == SpecialSlateMethodKind__GenerateWidgetForColumn):
            (*_self).push_line("(void)ColumnName;")
            ()
            ()
            ()
            ()
        if (kind == SpecialSlateMethodKind__OnOpening):
            (*_self).push_line("SToolTip::OnOpening();")
            ()
            ()
            ()
            ()
        for stmt in &(*method).body.stmts:
            (*_self).emit_special_stmt(stmt, st, &symbol_table, kind)
            ()
        ()
        if (kind == SpecialSlateMethodKind__GenerateWidgetForColumn):
            (*_self).push_line("return SNullWidget::NullWidget;")
            ()
            ()
            ()
            ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()

    fn emit_special_stmt(_self: &mut SlateGenerator, stmt: &kain_core::ast::Stmt, st: &kain_core::types::TypedStruct, symbol_table: &Map<String, WidgetInfo>, kind: SpecialSlateMethodKind):
        match stmt:
            kain_core__ast__Stmt::Let { pattern: pattern, ty: ty, value: value } =>
                match pattern:
                    kain_core__ast__Pattern::Binding { name: name } =>
                        let cpp_ty = ty.map(fn(t): (*_self).map_type(t)).unwrap_or_else(fn(): ("auto").to_string())
                        match value:
                            Some(expr) =>
                                if (*_self).is_widget_expr(expr):
                                    (*_self).push_line(&f"{cpp_ty} {name} =")
                                    ()
                                    (*_self).indent = ((*_self).indent + 1)
                                    ()
                                    (*_self).generate_widget_tree_with_context(expr, st, symbol_table)
                                    ()
                                    (*_self).indent = ((*_self).indent - 1)
                                    ()
                                    (*_self).push_line(";")
                                    ()
                                else:
                                    (*_self).push_line(&f"{cpp_ty} {name} = {(*_self).format_method_expr(expr)};")
                                    ()
                            _ =>
                                (*_self).push_line(&f"{cpp_ty} {name};")
                                ()
                    _ => ()
            kain_core__ast__Stmt::Expr(expr) => (*_self).emit_special_expr_stmt(expr, st, symbol_table, kind)
            kain_core__ast__Stmt::Return(Some(expr), _) => (*_self).emit_special_return_expr(expr, st, symbol_table, kind)
            kain_core__ast__Stmt::Return(None, _) => (*_self).push_line("return;")
            kain_core__ast__Stmt::Break(Some(expr), _) => (*_self).push_line(&f"break /* {(*_self).format_method_expr(expr)} */;")
            kain_core__ast__Stmt::Break(None, _) => (*_self).push_line("break;")
            kain_core__ast__Stmt::Continue(_) => (*_self).push_line("continue;")
            kain_core__ast__Stmt::For { binding: binding, iter: iter, body: body } =>
                match binding:
                    kain_core__ast__Pattern::Binding { name: name } =>
                        (*_self).push_line(&f"for (auto {name} : {(*_self).format_method_expr(iter)})")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        (*_self).push_line(&f"for (auto _ : {(*_self).format_method_expr(iter)})")
                        ()
                        ()
                        ()
                        ()
                (*_self).push_line("{")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                for s in &body.stmts:
                    (*_self).emit_special_stmt(s, st, symbol_table, kind)
                    ()
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("}")
                ()
            kain_core__ast__Stmt::While { condition: condition, body: body } =>
                (*_self).push_line(&f"while ({(*_self).format_method_expr(condition)})")
                ()
                (*_self).push_line("{")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                for s in &body.stmts:
                    (*_self).emit_special_stmt(s, st, symbol_table, kind)
                    ()
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("}")
                ()
            kain_core__ast__Stmt::Loop { body: body } =>
                (*_self).push_line("while (true)")
                ()
                (*_self).push_line("{")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                for s in &body.stmts:
                    (*_self).emit_special_stmt(s, st, symbol_table, kind)
                    ()
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("}")
                ()
            kain_core__ast__Stmt::Item(_) => ()

    fn emit_special_expr_stmt(_self: &mut SlateGenerator, expr: &kain_core::ast::Expr, st: &kain_core::types::TypedStruct, symbol_table: &Map<String, WidgetInfo>, kind: SpecialSlateMethodKind):
        match expr:
            kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                (*_self).emit_special_if_stmt(condition, then_branch, else_branch, st, symbol_table, kind)
                ()
            kain_core__ast__Expr::Match { scrutinee: scrutinee, arms: arms } =>
                (*_self).emit_special_match_stmt(scrutinee, arms, false, st, symbol_table, kind)
                ()
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                if ((args.len() == 1) && (*_self).is_widget_expr(&args[0].value)):
                    (*_self).push_line(&f"{(*_self).format_method_expr(callee)}(")
                    ()
                    (*_self).indent = ((*_self).indent + 1)
                    ()
                    (*_self).generate_widget_tree_with_context(&args[0].value, st, symbol_table)
                    ()
                    (*_self).indent = ((*_self).indent - 1)
                    ()
                    (*_self).push_line(");")
                    ()
                else:
                    (*_self).push_line(&f"{(*_self).format_method_expr(expr)};")
                    ()
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                if ((args.len() == 1) && (*_self).is_widget_expr(&args[0].value)):
                    (*_self).push_line(&f"{(*_self).format_method_expr(receiver)}.{method}(")
                    ()
                    (*_self).indent = ((*_self).indent + 1)
                    ()
                    (*_self).generate_widget_tree_with_context(&args[0].value, st, symbol_table)
                    ()
                    (*_self).indent = ((*_self).indent - 1)
                    ()
                    (*_self).push_line(");")
                    ()
                else:
                    (*_self).push_line(&f"{(*_self).format_method_expr(expr)};")
                    ()
            _ => (*_self).push_line(&f"{(*_self).format_method_expr(expr)};")

    fn emit_special_return_expr(_self: &mut SlateGenerator, expr: &kain_core::ast::Expr, st: &kain_core::types::TypedStruct, symbol_table: &Map<String, WidgetInfo>, kind: SpecialSlateMethodKind):
        match expr:
            kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                (*_self).emit_special_if_stmt(condition, then_branch, else_branch, st, symbol_table, kind)
                ()
            kain_core__ast__Expr::Match { scrutinee: scrutinee, arms: arms } =>
                (*_self).emit_special_match_stmt(scrutinee, arms, true, st, symbol_table, kind)
                ()
            _ if ((kind == SpecialSlateMethodKind__GenerateWidgetForColumn) && (*_self).is_widget_expr(expr)) =>
                (*_self).push_line("return")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                (*_self).generate_widget_tree_with_context(expr, st, symbol_table)
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line(";")
                ()
            _ => (*_self).push_line(&f"return {(*_self).format_method_expr(expr)};")

    fn emit_special_if_stmt(_self: &mut SlateGenerator, condition: &kain_core::ast::Expr, then_branch: &kain_core::ast::Block, else_branch: Option<&kain_core::ast::ElseBranch>, st: &kain_core::types::TypedStruct, symbol_table: &Map<String, WidgetInfo>, kind: SpecialSlateMethodKind):
        (*_self).push_line(&f"if ({(*_self).format_method_expr(condition)})")
        ()
        (*_self).push_line("{")
        ()
        (*_self).indent = ((*_self).indent + 1)
        ()
        for s in &(*then_branch).stmts:
            (*_self).emit_special_stmt(s, st, symbol_table, kind)
            ()
        ()
        (*_self).indent = ((*_self).indent - 1)
        ()
        (*_self).push_line("}")
        ()
        match else_branch:
            Some(else_branch) =>
                (*_self).emit_special_else_branch(else_branch, st, symbol_table, kind)
                ()
            _ => ()

    fn emit_special_else_branch(_self: &mut SlateGenerator, else_branch: &kain_core::ast::ElseBranch, st: &kain_core::types::TypedStruct, symbol_table: &Map<String, WidgetInfo>, kind: SpecialSlateMethodKind):
        match else_branch:
            kain_core__ast__ElseBranch::Else(block) =>
                (*_self).push_line("else")
                ()
                (*_self).push_line("{")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                for s in &block.stmts:
                    (*_self).emit_special_stmt(s, st, symbol_table, kind)
                    ()
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("}")
                ()
            kain_core__ast__ElseBranch::ElseIf(cond, block, tail) =>
                (*_self).push_line(&f"else if ({(*_self).format_method_expr(cond)})")
                ()
                (*_self).push_line("{")
                ()
                (*_self).indent = ((*_self).indent + 1)
                ()
                for s in &block.stmts:
                    (*_self).emit_special_stmt(s, st, symbol_table, kind)
                    ()
                ()
                (*_self).indent = ((*_self).indent - 1)
                ()
                (*_self).push_line("}")
                ()
                match tail:
                    Some(next) =>
                        (*_self).emit_special_else_branch(next, st, symbol_table, kind)
                        ()
                    _ => ()

    fn emit_special_match_stmt(_self: &mut SlateGenerator, scrutinee: &kain_core::ast::Expr, arms: &[kain_core::ast::MatchArm], as_return: Bool, st: &kain_core::types::TypedStruct, symbol_table: &Map<String, WidgetInfo>, kind: SpecialSlateMethodKind):
        let scrutinee_str = (*_self).format_method_expr(scrutinee)
        let mut is_first = true
        for arm in arms:
            let mut cond = (*_self).match_pattern_condition(&scrutinee_str, &arm.pattern)
            match &arm.guard:
                Some(guard) =>
                    let guard_str = (*_self).format_method_expr(guard)
                    cond = none
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match cond:
                Some(cond_str) =>
                    if is_first:
                        (*_self).push_line(&f"if ({cond_str})")
                        ()
                        ()
                        ()
                        ()
                    else:
                        (*_self).push_line(&f"else if ({cond_str})")
                        ()
                        ()
                        ()
                        ()
                    ()
                None =>
                    if is_first:
                        (*_self).push_line("if (true)")
                        ()
                        ()
                        ()
                        ()
                    else:
                        (*_self).push_line("else")
                        ()
                        ()
                        ()
                        ()
                    ()
            (*_self).push_line("{")
            ()
            (*_self).indent = ((*_self).indent + 1)
            ()
            if as_return:
                (*_self).emit_special_return_expr(&arm.body, st, symbol_table, kind)
                ()
                ()
                ()
                ()
            else:
                (*_self).emit_special_expr_stmt(&arm.body, st, symbol_table, kind)
                ()
                ()
                ()
                ()
            (*_self).indent = ((*_self).indent - 1)
            ()
            (*_self).push_line("}")
            ()
            is_first = false
            ()

    fn match_pattern_condition(_self: &SlateGenerator, scrutinee: String, pattern: &kain_core::ast::Pattern) -> Option<String>:
        match pattern:
            kain_core__ast__Pattern::Wildcard(_) => none
            kain_core__ast__Pattern::Literal(expr) => Option::Some(f"{scrutinee} == {(*_self).format_method_expr(expr)}")
            kain_core__ast__Pattern::Range { start: start, end: end, inclusive: inclusive } =>
                let mut parts = Vec__new_()
                match start:
                    Some(lo) =>
                        parts.push(f"{scrutinee} >= {(*_self).format_method_expr(lo)}")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                match end:
                    Some(hi) =>
                        let op = if (*inclusive):
                            "<="
                        else:
                            "<"
                        parts.push(f"{scrutinee} {op} {(*_self).format_method_expr(hi)}")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                if parts.is_empty():
                    none
                else:
                    Option::Some(parts.join(" && "))
            kain_core__ast__Pattern::Or(patterns, _) =>
                let mut branches = Vec__new_()
                for p in patterns:
                    match (*_self).match_pattern_condition(scrutinee, p):
                        None => return none
                        Some(cond) => branches.push(f"({cond})")
                ()
                if branches.is_empty():
                    none
                else:
                    Option::Some(branches.join(" || "))
            kain_core__ast__Pattern::Variant { enum_name: enum_name, variant: variant, fields: fields } =>
                if (none):
                    let variant_ref = match enum_name:
                        Some(en) => f"{ue5__ue5__naming__to_enum_name(en)}::{variant}"
                        _ => variant.clone()
                    Option::Some(f"{scrutinee} == {variant_ref}")
                else:
                    Option::Some(("false").to_string())
            kain_core__ast__Pattern::Binding {  } => none
            _ => Option::Some(("false").to_string())

    fn is_widget_expr(_self: &SlateGenerator, expr: &kain_core::ast::Expr) -> Bool:
        match expr:
            kain_core__ast__Expr::Call { callee: callee } =>
                match &(*(*callee)):
                    kain_core__ast__Expr::Ident(name, _) => (!none)
                    _ => false
            kain_core__ast__Expr::MethodCall { receiver: receiver } => (*_self).is_widget_expr(receiver)
            _ => false

    fn build_symbol_table(_self: &SlateGenerator, block: &kain_core::ast::Block) -> Map<String, WidgetInfo>:
        let mut table = HashMap__new_()
        for stmt in &(*block).stmts:
            match stmt:
                kain_core__ast__Stmt::Let { pattern: pattern, value: value } =>
                    match pattern:
                        kain_core__ast__Pattern::Binding { name: name } =>
                            match value:
                                Some(value_expr) =>
                                    let widget_info = WidgetInfo { construction: value_expr.clone(), method_calls: Vec__new_() }
                                    table.insert(name.clone(), widget_info)
                                    ()
                                _ => ()
                        _ => ()
                kain_core__ast__Stmt::Expr(expr) =>
                    (*_self).track_method_calls(expr, &mut table)
                    ()
                _ => ()
        ()
        table

    fn track_method_calls(_self: &SlateGenerator, expr: &kain_core::ast::Expr, table: &mut Map<String, WidgetInfo>):
        match expr:
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                match &(*(*receiver)):
                    kain_core__ast__Expr::Ident(var_name, _) =>
                        match table.get_mut(var_name):
                            Some(widget_info) =>
                                widget_info.method_calls.push(MethodCallInfo { method: method.clone(), args: args.clone() })
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).track_method_calls(receiver, table)
                ()
                for arg in args:
                    (*_self).track_method_calls(&arg.value, table)
                    ()
            kain_core__ast__Expr::Call { args: args } =>
                for arg in args:
                    (*_self).track_method_calls(&arg.value, table)
                    ()
            _ => ()

    fn generate_widget_tree_with_context(_self: &mut SlateGenerator, expr: &kain_core::ast::Expr, st: &kain_core::types::TypedStruct, symbol_table: &Map<String, WidgetInfo>):
        match expr:
            kain_core__ast__Expr::Ident(name, _) =>
                match symbol_table.get(name):
                    Some(widget_info) =>
                        let widget_type = match &widget_info.construction:
                            kain_core__ast__Expr::Call { callee: callee } => (*_self).extract_widget_type(callee)
                            _ => WidgetType::Unknown(("Unknown").to_string())
                        let slate_class = widget_type.to_slate_class()
                        if widget_type.is_list_widget():
                            let inferred_item_type = (*_self).infer_list_item_type_from_method_calls(&widget_info.method_calls)
                            (*_self).push_line(&(*_self).list_widget_stype_for(&slate_class, inferred_item_type))
                            ()
                            ()
                            ()
                            ()
                        else:
                            (*_self).push_line(&f"SNew({slate_class})")
                            ()
                            ()
                            ()
                            ()
                        (*_self).parent_stack.push(widget_type.clone())
                        ()
                        for method_call in &widget_info.method_calls:
                            match method_call.method.as_str():
                                "Add" =>
                                    if widget_type.has_slots():
                                        let slot_type = widget_type.to_slate_class()
                                        (*_self).push_line("")
                                        ()
                                        (*_self).push_line(&f"+{slot_type}::Slot()")
                                        ()
                                        (*_self).push_line("[")
                                        ()
                                        (*_self).indent = ((*_self).indent + 1)
                                        ()
                                        match method_call.args.first():
                                            Some(first_arg) =>
                                                (*_self).generate_widget_tree_with_context(&first_arg.value, st, symbol_table)
                                                ()
                                                ()
                                                ()
                                                ()
                                            _ =>
                                                ()
                                                ()
                                        (*_self).indent = ((*_self).indent - 1)
                                        ()
                                        (*_self).push_line("]")
                                        ()
                                    elif widget_type.has_content_slot():
                                        (*_self).push_line("[")
                                        ()
                                        (*_self).indent = ((*_self).indent + 1)
                                        ()
                                        match method_call.args.first():
                                            Some(first_arg) =>
                                                (*_self).generate_widget_tree_with_context(&first_arg.value, st, symbol_table)
                                                ()
                                                ()
                                                ()
                                                ()
                                            _ =>
                                                ()
                                                ()
                                        (*_self).indent = ((*_self).indent - 1)
                                        ()
                                        (*_self).push_line("]")
                                        ()
                                "Content" =>
                                    (*_self).push_line("[")
                                    ()
                                    (*_self).indent = ((*_self).indent + 1)
                                    ()
                                    match method_call.args.first():
                                        Some(first_arg) =>
                                            (*_self).generate_widget_tree_with_context(&first_arg.value, st, symbol_table)
                                            ()
                                            ()
                                            ()
                                            ()
                                        _ =>
                                            ()
                                            ()
                                    (*_self).indent = ((*_self).indent - 1)
                                    ()
                                    (*_self).push_line("]")
                                    ()
                                _ =>
                                    (*_self).generate_widget_property(&method_call.method, &method_call.args)
                                    ()
                        ()
                        (*_self).parent_stack.pop()
                        ()
                    _ =>
                        match (*st).ast.fields.iter().find(fn(f): (&f.name == name)):
                            Some(field) =>
                                let type_name = match &field.ty:
                                    kain_core__ast__Type::Named { name: name } => name.clone()
                                    _ => ("Unknown").to_string()
                                (*_self).push_line(&f"SNew(S{type_name})")
                                ()
                            _ =>
                                (*_self).push_line(&f"SNew(S{name})")
                                ()
            kain_core__ast__Expr::Call { callee: callee, args: args_2 } =>
                match &(*(*callee)):
                    kain_core__ast__Expr::Ident(name, _) =>
                        if (name == "shader_image"):
                            let id = (*_self).shader_brush_counter
                            (*_self).shader_brush_counter = ((*_self).shader_brush_counter + 1)
                            ()
                            (*_self).push_line("SNew(SImage)")
                            ()
                            (*_self).push_line(&f".Image(ShaderBrush_{id}.Get())")
                            ()
                            (*_self).parent_stack.push(WidgetType__Image)
                            ()
                            (*_self).parent_stack.pop()
                            ()
                            return
                        ()
                    _ =>
                        ()
                        ()
                let widget_type = (*_self).extract_widget_type(callee)
                let slate_class = widget_type.to_slate_class()
                if widget_type.is_list_widget():
                    (*_self).push_line(&(*_self).list_widget_stype_for(&slate_class, none))
                    ()
                    ()
                    ()
                    ()
                else:
                    (*_self).push_line(&f"SNew({slate_class})")
                    ()
                    ()
                    ()
                    ()
                (*_self).parent_stack.push(widget_type.clone())
                ()
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                match method.as_str():
                    "Padding" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "HAlign" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "VAlign" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "FillWidth" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "FillHeight" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "AutoWidth" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "AutoHeight" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "MaxWidth" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "MaxHeight" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "Column" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "Row" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "ColumnSpan" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "RowSpan" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "Content" =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        match args.first():
                            Some(first_arg) =>
                                (*_self).push_line("[")
                                ()
                                (*_self).indent = ((*_self).indent + 1)
                                ()
                                (*_self).generate_widget_tree_with_context(&first_arg.value, st, symbol_table)
                                ()
                                (*_self).indent = ((*_self).indent - 1)
                                ()
                                (*_self).push_line("]")
                                ()
                            _ => ()
                    _ =>
                        (*_self).generate_widget_tree_with_context(receiver, st, symbol_table)
                        ()
                        (*_self).generate_widget_property(method, args)
                        ()
            _ =>
                (*_self).push_line("/* Unsupported widget expression */")
                ()

    fn format_expr_in_construct(_self: &SlateGenerator, expr: &kain_core::ast::Expr) -> String:
        match expr:
            kain_core__ast__Expr::Ident(name, _) => if (*_self).struct_field_names.contains(name): f"InArgs._{name}" else: name.clone()
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                match &(*(*callee)):
                    kain_core__ast__Expr::Ident(callee_name, _) =>
                        match (*_self).resolve_constructor_call(callee_name, args):
                            Some(resolved) => return resolved
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).format_expr(expr)
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                let recv = (*_self).format_expr_in_construct(receiver)
                let formatted_args: Array<String> = args.iter().map(fn(a): (*_self).format_expr_in_construct(&a.value)).collect()
                if formatted_args.is_empty():
                    f"{recv}.{method}()"
                else:
                    "{recv}.{method}({formatted_args.join(\", \")})"
            _ => (*_self).format_expr(expr)

    fn resolve_constructor_call(_self: &SlateGenerator, callee_name: String, args: &[kain_core::ast::CallArg]) -> Option<String>:
        let ue5_type = match callee_name:
            "vec2" => "FVector2D"
            "Vec2" => "FVector2D"
            "vector2d" => "FVector2D"
            "vec3" => "FVector"
            "Vec3" => "FVector"
            "vector" => "FVector"
            "Vector" => "FVector"
            "vec4" => "FVector4"
            "Vec4" => "FVector4"
            "rotator" => "FRotator"
            "Rotator" => "FRotator"
            "rot" => "FRotator"
            "Rot" => "FRotator"
            "quat" => "FQuat"
            "Quat" => "FQuat"
            "transform" => "FTransform"
            "Transform" => "FTransform"
            "linear_color" => "FLinearColor"
            "LinearColor" => "FLinearColor"
            "Color" => "FLinearColor"
            "margin" => "FMargin"
            "Margin" => "FMargin"
            "padding" => "FMargin"
            "Padding" => "FMargin"
            "color" =>
                if (args.len() == 1):
                    match &args[0].value:
                        kain_core__ast__Expr::String(color_name, _) =>
                            match &(*_self).context:
                                Some(ctx) =>
                                    match ctx.knowledge.resolve_named_color(color_name):
                                        Some(resolved) => return Option::Some(resolved)
                                        _ =>
                                            ()
                                            ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            let upper = color_name.to_uppercase()
                            return none
                        _ =>
                            ()
                            ()
                    ()
                "FLinearColor"
            _ => return none
        let formatted_args: Array<String> = args.iter().map(fn(a): (*_self).format_expr(&a.value)).collect()
        match &(*_self).context:
            Some(ctx) =>
                match ctx.knowledge.resolve_constructor(ue5_type, &formatted_args):
                    Some(resolved) => return Option::Some(resolved)
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        if formatted_args.is_empty():
            Option::Some(f"{ue5_type}()")
        else:
            Option::Some("{ue5_type}({formatted_args.join(\", \")})")

    fn generate_widget_tree(_self: &mut SlateGenerator, expr: &kain_core::ast::Expr, st: &kain_core::types::TypedStruct):
        match expr:
            kain_core__ast__Expr::Call { callee: callee, args: args_2 } =>
                match &(*(*callee)):
                    kain_core__ast__Expr::Ident(name, _) =>
                        if (name == "shader_image"):
                            let id = (*_self).shader_brush_counter
                            (*_self).shader_brush_counter = ((*_self).shader_brush_counter + 1)
                            ()
                            (*_self).push_line("SNew(SImage)")
                            ()
                            (*_self).push_line(&f".Image(ShaderBrush_{id}.Get())")
                            ()
                            (*_self).parent_stack.push(WidgetType__Image)
                            ()
                            (*_self).parent_stack.pop()
                            ()
                            return
                        ()
                    _ =>
                        ()
                        ()
                let widget_type = (*_self).extract_widget_type(callee)
                let slate_class = widget_type.to_slate_class()
                if widget_type.is_list_widget():
                    (*_self).push_line(&(*_self).list_widget_stype_for(&slate_class, none))
                    ()
                    ()
                    ()
                    ()
                else:
                    (*_self).push_line(&f"SNew({slate_class})")
                    ()
                    ()
                    ()
                    ()
                (*_self).parent_stack.push(widget_type.clone())
                ()
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                match method.as_str():
                    "Add" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        (*_self).generate_slot(args, st)
                        ()
                    "Slot" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        (*_self).generate_slot(args, st)
                        ()
                    "Padding" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "HAlign" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "VAlign" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "FillWidth" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "FillHeight" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "AutoWidth" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "AutoHeight" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "MaxWidth" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "MaxHeight" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "Column" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "Row" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "ColumnSpan" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "RowSpan" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        if (*_self).is_slot_context_expr(receiver):
                            (*_self).generate_slot_property(method, args)
                            ()
                        else:
                            (*_self).generate_widget_property(method, args)
                            ()
                    "Content" =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        match args.first():
                            Some(first_arg) =>
                                (*_self).push_line("[")
                                ()
                                (*_self).indent = ((*_self).indent + 1)
                                ()
                                (*_self).generate_widget_tree(&first_arg.value, st)
                                ()
                                (*_self).indent = ((*_self).indent - 1)
                                ()
                                (*_self).push_line("]")
                                ()
                            _ => ()
                    _ =>
                        (*_self).generate_widget_tree(receiver, st)
                        ()
                        (*_self).generate_widget_property(method, args)
                        ()
            kain_core__ast__Expr::Ident(name, _) =>
                match (*st).ast.fields.iter().find(fn(f): (&f.name == name)):
                    Some(field) =>
                        let type_name = match &field.ty:
                            kain_core__ast__Type::Named { name: name } => name.clone()
                            _ => ("Unknown").to_string()
                        (*_self).push_line(&f"SNew(S{type_name})")
                        ()
                    _ =>
                        (*_self).push_line(&f"SNew(S{name})")
                        ()
            _ =>
                (*_self).push_line("/* Unsupported widget expression */")
                ()

    fn generate_slot(_self: &mut SlateGenerator, args: &[kain_core::ast::CallArg], st: &kain_core::types::TypedStruct):
        match (*_self).parent_stack.last():
            Some(parent) =>
                if parent.has_slots():
                    let slot_type = parent.to_slate_class()
                    (*_self).push_line("")
                    ()
                    (*_self).push_line(&f"+{slot_type}::Slot()")
                    ()
                    (*_self).push_line("[")
                    ()
                    (*_self).indent = ((*_self).indent + 1)
                    ()
                    match args.first():
                        Some(first_arg) =>
                            (*_self).generate_widget_tree(&first_arg.value, st)
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    (*_self).indent = ((*_self).indent - 1)
                    ()
                    (*_self).push_line("]")
                    ()
                elif parent.has_content_slot():
                    (*_self).push_line("[")
                    ()
                    (*_self).indent = ((*_self).indent + 1)
                    ()
                    match args.first():
                        Some(first_arg) =>
                            (*_self).generate_widget_tree(&first_arg.value, st)
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    (*_self).indent = ((*_self).indent - 1)
                    ()
                    (*_self).push_line("]")
                    ()
            _ => ()

    fn generate_slot_property(_self: &mut SlateGenerator, method: String, args: &[kain_core::ast::CallArg]):
        let formatted_args = (*_self).format_args(args)
        match method:
            "Column" => (*_self).push_line(&f".Column({formatted_args})")
            "Row" => (*_self).push_line(&f".Row({formatted_args})")
            "ColumnSpan" => (*_self).push_line(&f".ColumnSpan({formatted_args})")
            "RowSpan" => (*_self).push_line(&f".RowSpan({formatted_args})")
            _ => (*_self).push_line(&f".{method}({formatted_args})")

    fn generate_widget_property(_self: &mut SlateGenerator, method: String, args: &[kain_core::ast::CallArg]):
        let formatted_args = (*_self).format_args(args)
        match method:
            "Text" =>
                match args.first():
                    Some(arg) =>
                        match &arg.value:
                            kain_core__ast__Expr::String(s, _) =>
                                (*_self).push_line(&f".Text(FText::FromString(TEXT(\"{s}\")))")
                                ()
                                return
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).push_line(&f".Text({formatted_args})")
                ()
            "HintText" =>
                match args.first():
                    Some(arg) =>
                        match &arg.value:
                            kain_core__ast__Expr::String(s, _) =>
                                (*_self).push_line(&f".HintText(FText::FromString(TEXT(\"{s}\")))")
                                ()
                                return
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).push_line(&f".HintText({formatted_args})")
                ()
            "ToolTipText" =>
                match args.first():
                    Some(arg) =>
                        match &arg.value:
                            kain_core__ast__Expr::String(s, _) =>
                                (*_self).push_line(&f".ToolTipText(FText::FromString(TEXT(\"{s}\")))")
                                ()
                                return
                            _ =>
