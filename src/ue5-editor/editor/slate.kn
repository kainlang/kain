                ()
            _ =>
                match args.first():
                    Some(arg) =>
                        match &arg.value:
                            kain_core__ast__Expr::String(s, _) =>
                                (*_self).push_line(&f".{method}(FText::FromString(TEXT(\"{s}\")))")
                                ()
                                return
                            _ =>
                                ()
