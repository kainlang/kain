                (*_self).push_line(&f".ToolTipText({formatted_args})")
                ()
            "ToolTip" =>
                (*_self).push_line(&f".ToolTip({formatted_args})")
                ()
            "OnClicked" =>
                if ((method == "OnColorChanged") && ((*_self).parent_stack.last() == Option::Some(&WidgetType__ColorBlock))):
                    return
                if (*_self).is_inargs_reference(&formatted_args):
                    (*_self).emit_delegate_bridge_or_passthrough(method, &formatted_args)
                    ()
                else:
                    let native = (*_self).native_delegate_for_property(method).unwrap_or("FSimpleDelegate")
                    (*_self).push_line(&f".{method}({native}::CreateSP(this, &{(*_self).current_widget_class()}::Handle{(*_self).handler_name_from_args(args)}))")
                    ()
            "OnPressed" =>
                if ((method == "OnColorChanged") && ((*_self).parent_stack.last() == Option::Some(&WidgetType__ColorBlock))):
                    return
                if (*_self).is_inargs_reference(&formatted_args):
                    (*_self).emit_delegate_bridge_or_passthrough(method, &formatted_args)
                    ()
                else:
                    let native = (*_self).native_delegate_for_property(method).unwrap_or("FSimpleDelegate")
                    (*_self).push_line(&f".{method}({native}::CreateSP(this, &{(*_self).current_widget_class()}::Handle{(*_self).handler_name_from_args(args)}))")
                    ()
            "OnReleased" =>
                if ((method == "OnColorChanged") && ((*_self).parent_stack.last() == Option::Some(&WidgetType__ColorBlock))):
