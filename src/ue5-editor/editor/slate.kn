                ()
            "HeaderRow" =>
                (*_self).push_line(&f".HeaderRow({formatted_args})")
                ()
            "ColorAndOpacity" => if ((*_self).parent_stack.last() == Option::Some(&WidgetType__ColorBlock)): none else: none
            "Color" =>
                match args.first():
                    Some(arg) =>
                        let expr_str = (*_self).format_expr(&arg.value)
                        if expr_str.starts_with("FVector("):
                            let inner = &expr_str[("FVector(").len()..(expr_str.len() - 1)]
                            (*_self).push_line(&f".Color(FLinearColor({inner}, 1.0f))")
                            ()
                            return
                        ()
                    _ =>
                        ()
                        ()
                if formatted_args.starts_with("InArgs._"):
                    let field_name = formatted_args.trim_start_matches("InArgs._")
                    match (*_self).field_type_map.get(field_name):
                        Some(field_ty) =>
                            if (field_ty == "FVector"):
                                (*_self).push_line(&f".Color(FLinearColor({formatted_args}.X, {formatted_args}.Y, {formatted_args}.Z, 1.0f))")
                                ()
                                return
                            ()
                        _ =>
                            ()
                            ()
