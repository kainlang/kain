use crate::editor::asset_editor_ir::convert_to_asset_editor_ir

use crate::editor::asset_editor_ir::AssetEditorIR

use kain_core::types::TypedStruct

use ue5::ue5::context::Ue5Context

@doc(doc = " Asset editor toolkit generator")
pub struct AssetEditorGenerator:
    context: ue5::ue5::context::Ue5Context

impl AssetEditorGenerator:
    pub fn new_(context: ue5::ue5::context::Ue5Context) -> AssetEditorGenerator:
        AssetEditorGenerator { context: context }

    pub fn generate_asset_editor(_self: &mut AssetEditorGenerator, st: &kain_core::types::TypedStruct) -> Result<(String, String), String>:
        let ir = editor__asset_editor_ir__convert_to_asset_editor_ir(&(*st).ast, &(*_self).context)?
        let header = (*_self).generate_header(&ir)?
        let source = (*_self).generate_source(&ir)?
        Result::Ok((header, source))

    fn generate_header(_self: &AssetEditorGenerator, ir: &AssetEditorIR) -> Result<String, String>:
        let class_name = f"F{(*ir).name}Toolkit"
        let mut header = String__new_()
        match (*ir).viewport:
            Some(viewport) =>
                header.push_str(&f"class S{viewport.viewport_type};\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        for widget in &(*ir).custom_widgets:
            header.push_str(&f"class S{widget.widget_type};\n")
            ()
        ()
        if ((!(*ir).custom_widgets.is_empty()) || (*ir).viewport.is_some()):
            header.push_str("\n")
            ()
            ()
            ()
            ()
        header.push_str(&f"class {class_name} : public FAssetEditorToolkit\n")
        ()
        header.push_str("{\n")
        ()
        header.push_str("public:\n")
        ()
        header.push_str(&f"\t{class_name}();\n")
        ()
        header.push_str(&f"\tvirtual ~{class_name}();\n\n")
        ()
        header.push_str("\tvoid InitEditor(const EToolkitMode::Type Mode, const TSharedPtr<IToolkitHost>& InitToolkitHost, UObject* InAsset);\n\n")
        ()
        header.push_str("\t// FAssetEditorToolkit interface\n")
        ()
        header.push_str("\tvirtual FName GetToolkitFName() const override;\n")
        ()
        header.push_str("\tvirtual FText GetBaseToolkitName() const override;\n")
        ()
        header.push_str("\tvirtual FString GetWorldCentricTabPrefix() const override;\n")
        ()
        header.push_str("\tvirtual FLinearColor GetWorldCentricTabColorScale() const override;\n")
        ()
        header.push_str("\tvirtual void OnClose() override;\n\n")
        ()
        if (*ir).viewport.is_some():
            header.push_str("\tTSharedRef<SDockTab> SpawnViewportTab(const FSpawnTabArgs& Args);\n")
            ()
            ()
            ()
            ()
        if (*ir).details.is_some():
            header.push_str("\tTSharedRef<SDockTab> SpawnDetailsTab(const FSpawnTabArgs& Args);\n")
            ()
            ()
            ()
            ()
        for widget in &(*ir).custom_widgets:
            let method_name = f"Spawn{widget.field_name}Tab"
            header.push_str(&f"\tTSharedRef<SDockTab> {method_name}(const FSpawnTabArgs& Args);\n")
            ()
        ()
        if (((*ir).viewport.is_some() || (*ir).details.is_some()) || (!(*ir).custom_widgets.is_empty())):
            header.push_str("\n")
            ()
            ()
            ()
            ()
        for method in &(*ir).custom_methods:
            let return_type = method.return_type.map(fn(s): s.as_str()).unwrap_or("void")
            let params_str = method.params.iter().map(fn(__kain_closure_arg0): f"{__kain_closure_arg0.__kain_tuple_1} {__kain_closure_arg0.__kain_tuple_0}").collect().join(", ")
            header.push_str(&f"\t{return_type} {method.name}({params_str});\n")
            ()
        ()
        header.push_str("\nprivate:\n")
        ()
        if (*ir).viewport.is_some():
            header.push_str("\tstatic const FName ViewportTabId;\n")
            ()
            ()
            ()
            ()
        if (*ir).details.is_some():
            header.push_str("\tstatic const FName DetailsTabId;\n")
            ()
            ()
            ()
            ()
        for widget in &(*ir).custom_widgets:
            header.push_str(&f"\tstatic const FName {widget.field_name}TabId;\n")
            ()
        ()
        if (((*ir).viewport.is_some() || (*ir).details.is_some()) || (!(*ir).custom_widgets.is_empty())):
            header.push_str("\n")
            ()
            ()
            ()
            ()
        if (*ir).viewport.is_some():
            header.push_str("\tTSharedPtr<SWidget> ViewportWidget;\n")
            ()
            ()
            ()
            ()
        if (*ir).details.is_some():
            header.push_str("\tTSharedPtr<IDetailsView> DetailsView;\n")
            ()
            ()
            ()
            ()
        for widget in &(*ir).custom_widgets:
            header.push_str(&f"\tTSharedPtr<S{widget.widget_type}> {widget.field_name}Widget;\n")
            ()
        ()
        header.push_str("\tTWeakObjectPtr<UObject> EditingAsset;\n")
        ()
        header.push_str("};\n")
        ()
        Result::Ok(header)

    fn generate_source(_self: &AssetEditorGenerator, ir: &AssetEditorIR) -> Result<String, String>:
        let class_name = f"F{(*ir).name}Toolkit"
        let mut source = String__new_()
        match (*ir).viewport:
            Some(viewport) =>
                source.push_str(&f"const FName {class_name}::ViewportTabId(TEXT(\"{viewport.tab_id}\"));\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*ir).details:
            Some(details) =>
                source.push_str(&f"const FName {class_name}::DetailsTabId(TEXT(\"{details.tab_id}\"));\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        for widget in &(*ir).custom_widgets:
            source.push_str(&f"const FName {class_name}::{widget.field_name}TabId(TEXT(\"{widget.tab_id}\"));\n")
            ()
        ()
        if (((*ir).viewport.is_some() || (*ir).details.is_some()) || (!(*ir).custom_widgets.is_empty())):
            source.push_str("\n")
            ()
            ()
            ()
            ()
        source.push_str(&"{class_name}::{class_name}() {}\n")
        ()
        source.push_str(&"{class_name}::~{class_name}() {}\n\n")
        ()
        source.push_str(&(*_self).generate_init_editor(ir, &class_name)?)
        ()
        match (*ir).viewport:
            Some(viewport) =>
                source.push_str(&(*_self).generate_viewport_spawner(ir, &class_name, viewport)?)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*ir).details:
            Some(details) =>
                source.push_str(&(*_self).generate_details_spawner(ir, &class_name, details)?)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        for widget in &(*ir).custom_widgets:
            source.push_str(&(*_self).generate_custom_widget_spawner(ir, &class_name, widget)?)
            ()
        ()
        source.push_str(&f"FName {class_name}::GetToolkitFName() const\n")
        ()
        source.push_str("{\n")
        ()
        source.push_str(&f"\treturn FName(\"{(*ir).name}\");\n")
        ()
        source.push_str("}\n\n")
        ()
        source.push_str(&f"FText {class_name}::GetBaseToolkitName() const\n")
        ()
        source.push_str("{\n")
        ()
        source.push_str(&f"\treturn FText::FromString(TEXT(\"{(*ir).name}\"));\n")
        ()
        source.push_str("}\n\n")
        ()
        source.push_str(&f"FString {class_name}::GetWorldCentricTabPrefix() const\n")
        ()
        source.push_str("{\n")
        ()
        source.push_str(&f"\treturn TEXT(\"{(*ir).name}\");\n")
        ()
        source.push_str("}\n\n")
        ()
        source.push_str(&f"FLinearColor {class_name}::GetWorldCentricTabColorScale() const\n")
        ()
        source.push_str("{\n")
        ()
        source.push_str("\treturn FLinearColor::White;\n")
        ()
        source.push_str("}\n\n")
        ()
        source.push_str(&f"void {class_name}::OnClose()\n")
        ()
        source.push_str("{\n")
        ()
        source.push_str("\tFAssetEditorToolkit::OnClose();\n")
        ()
        source.push_str("}\n\n")
        ()
        for method in &(*ir).custom_methods:
            let return_type = method.return_type.map(fn(s): s.as_str()).unwrap_or("void")
            let params_str = method.params.iter().map(fn(__kain_closure_arg1): f"{__kain_closure_arg1.__kain_tuple_1} {__kain_closure_arg1.__kain_tuple_0}").collect().join(", ")
            source.push_str(&f"{return_type} {class_name}::{method.name}({params_str})\n")
            ()
            source.push_str("{\n")
            ()
            source.push_str(&f"\t{method.body}\n")
            ()
            source.push_str("}\n\n")
            ()
        ()
        Result::Ok(source)

    fn generate_init_editor(_self: &AssetEditorGenerator, ir: &AssetEditorIR, class_name: String) -> Result<String, String>:
        let mut code = String__new_()
        code.push_str(&f"void {class_name}::InitEditor(const EToolkitMode::Type Mode, const TSharedPtr<IToolkitHost>& InitToolkitHost, UObject* InAsset)\n")
        ()
        code.push_str("{\n")
        ()
        code.push_str("\tEditingAsset = InAsset;\n\n")
        ()
        code.push_str(&f"\tconst TSharedRef<FTabManager::FLayout> Layout = FTabManager::NewLayout(TEXT(\"{(*ir).name}Layout\"))\n")
        ()
        code.push_str("\t\t->AddArea\n")
        ()
        code.push_str("\t\t(\n")
        ()
        code.push_str("\t\t\tFTabManager::NewPrimaryArea()->SetOrientation(Orient_Vertical)\n")
        ()
        match (*ir).layout.arrangement:
            editor__asset_editor_ir__TabArrangement::ViewportDetailsHorizontal =>
                if ((*ir).viewport.is_some() && (*ir).details.is_some()):
                    code.push_str("\t\t\t\t->Split\n")
                    ()
                    code.push_str("\t\t\t\t(\n")
                    ()
                    code.push_str("\t\t\t\t\tFTabManager::NewSplitter()->SetOrientation(Orient_Horizontal)\n")
                    ()
                    match (*ir).viewport:
                        Some(viewport) =>
                            code.push_str(&f"\t\t\t\t\t\t->Split(FTabManager::NewStack()->AddTab(ViewportTabId, ETabState::OpenedTab)->SetSizeCoefficient({viewport.size_coefficient}))\n")
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    match (*ir).details:
                        Some(details) =>
                            code.push_str(&f"\t\t\t\t\t\t->Split(FTabManager::NewStack()->AddTab(DetailsTabId, ETabState::OpenedTab)->SetSizeCoefficient({details.size_coefficient}))\n")
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    code.push_str("\t\t\t\t)\n")
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                if (*ir).viewport.is_some():
                    code.push_str("\t\t\t\t->Split(FTabManager::NewStack()->AddTab(ViewportTabId, ETabState::OpenedTab))\n")
                    ()
                    ()
                    ()
                    ()
                if (*ir).details.is_some():
                    code.push_str("\t\t\t\t->Split(FTabManager::NewStack()->AddTab(DetailsTabId, ETabState::OpenedTab))\n")
                    ()
                    ()
                    ()
                    ()
                ()
        for widget in &(*ir).custom_widgets:
            code.push_str(&f"\t\t\t\t->Split(FTabManager::NewStack()->AddTab({widget.field_name}TabId, ETabState::OpenedTab)->SetSizeCoefficient({widget.size_coefficient}))\n")
            ()
        ()
        code.push_str("\t\t);\n\n")
        ()
        code.push_str(&f"\tInitAssetEditor(Mode, InitToolkitHost, FName(TEXT(\"{(*ir).name}\")), Layout, true, true, InAsset);\n\n")
        ()
        if (*ir).viewport.is_some():
            code.push_str(&f"\tTabManager->RegisterTabSpawner(ViewportTabId, FOnSpawnTab::CreateSP(this, &{class_name}::SpawnViewportTab))\n")
            ()
            code.push_str("\t\t.SetDisplayName(FText::FromString(TEXT(\"Viewport\")))\n")
            ()
            code.push_str("\t\t.SetGroup(WorkspaceMenuCategory.ToSharedRef());\n")
            ()
            ()
            ()
            ()
        if (*ir).details.is_some():
            code.push_str(&f"\tTabManager->RegisterTabSpawner(DetailsTabId, FOnSpawnTab::CreateSP(this, &{class_name}::SpawnDetailsTab))\n")
            ()
            code.push_str("\t\t.SetDisplayName(FText::FromString(TEXT(\"Details\")))\n")
            ()
            code.push_str("\t\t.SetGroup(WorkspaceMenuCategory.ToSharedRef());\n")
            ()
            ()
            ()
            ()
        for widget in &(*ir).custom_widgets:
            let method_name = f"Spawn{widget.field_name}Tab"
            code.push_str(&f"\tTabManager->RegisterTabSpawner({widget.field_name}TabId, FOnSpawnTab::CreateSP(this, &{class_name}::{method_name}))\n")
            ()
            code.push_str(&f"\t\t.SetDisplayName(FText::FromString(TEXT(\"{widget.tab_name}\")))\n")
            ()
            code.push_str("\t\t.SetGroup(WorkspaceMenuCategory.ToSharedRef());\n")
            ()
        ()
        code.push_str("}\n\n")
        ()
        Result::Ok(code)

    fn generate_viewport_spawner(_self: &AssetEditorGenerator, _ir: &AssetEditorIR, class_name: String, viewport: &editor::asset_editor_ir::ViewportPanelIR) -> Result<String, String>:
        let mut code = String__new_()
        code.push_str(&f"TSharedRef<SDockTab> {class_name}::SpawnViewportTab(const FSpawnTabArgs& Args)\n")
        ()
        code.push_str("{\n")
        ()
        code.push_str(&f"\tViewportWidget = SNew(S{(*viewport).viewport_type});\n\n")
        ()
        code.push_str("\treturn SNew(SDockTab)\n")
        ()
        code.push_str(&f"\t\t.Label(FText::FromString(TEXT(\"{(*viewport).tab_name}\")))\n")
        ()
        code.push_str("\t\t[\n")
        ()
        code.push_str("\t\t\tViewportWidget.ToSharedRef()\n")
        ()
        code.push_str("\t\t];\n")
        ()
        code.push_str("}\n\n")
        ()
        Result::Ok(code)

    fn generate_details_spawner(_self: &AssetEditorGenerator, _ir: &AssetEditorIR, class_name: String, details: &editor::asset_editor_ir::DetailsPanelIR) -> Result<String, String>:
        let mut code = String__new_()
        code.push_str(&f"TSharedRef<SDockTab> {class_name}::SpawnDetailsTab(const FSpawnTabArgs& Args)\n")
        ()
        code.push_str("{\n")
        ()
        code.push_str("\tFPropertyEditorModule& PropertyModule = FModuleManager::LoadModuleChecked<FPropertyEditorModule>(\"PropertyEditor\");\n")
        ()
        code.push_str("\tFDetailsViewArgs DetailsViewArgs;\n")
        ()
        code.push_str("\tDetailsViewArgs.bUpdatesFromSelection = false;\n")
        ()
        code.push_str(&"\tDetailsViewArgs.bLockable = {if (*details).lockable: \"true\" else: \"false\"};\n")
        ()
        code.push_str(&"\tDetailsViewArgs.NameAreaSettings = {if (*details).show_name_area: \"FDetailsViewArgs::ObjectsUseNameArea\" else: \"FDetailsViewArgs::HideNameArea\"};\n")
        ()
        code.push_str("\n")
        ()
        code.push_str("\tDetailsView = PropertyModule.CreateDetailView(DetailsViewArgs);\n")
        ()
        code.push_str("\tDetailsView->SetObject(EditingAsset.Get());\n\n")
        ()
        code.push_str("\treturn SNew(SDockTab)\n")
        ()
        code.push_str(&f"\t\t.Label(FText::FromString(TEXT(\"{(*details).tab_name}\")))\n")
        ()
        code.push_str("\t\t[\n")
        ()
        code.push_str("\t\t\tDetailsView.ToSharedRef()\n")
        ()
        code.push_str("\t\t];\n")
        ()
        code.push_str("}\n\n")
        ()
        Result::Ok(code)

    fn generate_custom_widget_spawner(_self: &AssetEditorGenerator, _ir: &AssetEditorIR, class_name: String, widget: &editor::asset_editor_ir::CustomWidgetIR) -> Result<String, String>:
        let mut code = String__new_()
        let method_name = f"Spawn{(*widget).field_name}Tab"
        code.push_str(&f"TSharedRef<SDockTab> {class_name}::{method_name}(const FSpawnTabArgs& Args)\n")
        ()
        code.push_str("{\n")
        ()
        code.push_str(&f"\t{(*widget).field_name}Widget = SNew(S{(*widget).widget_type});\n\n")
        ()
        code.push_str("\treturn SNew(SDockTab)\n")
        ()
        code.push_str(&f"\t\t.Label(FText::FromString(TEXT(\"{(*widget).tab_name}\")))\n")
        ()
        code.push_str("\t\t[\n")
        ()
        code.push_str(&f"\t\t\t{(*widget).field_name}Widget.ToSharedRef()\n")
        ()
        code.push_str("\t\t];\n")
        ()
        code.push_str("}\n\n")
        ()
        Result::Ok(code)


