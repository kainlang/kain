use kain_core::ast::Attribute

use kain_core::ast::Field

use kain_core::ast::Struct

use ue5::ue5::context::Ue5Context

@doc(doc = " Asset editor intermediate representation")
@doc(doc = " Represents a complete asset editor toolkit with all its panels and configuration")
@derive(Debug, Clone)
pub struct AssetEditorIR:
    name: String
    viewport: Option<ViewportPanelIR>
    details: Option<DetailsPanelIR>
    toolbar: Option<ToolbarIR>
    custom_widgets: Array<CustomWidgetIR>
    asset_type: Option<String>
    layout: TabLayoutIR
    custom_methods: Array<CustomMethodIR>

@doc(doc = " Viewport panel configuration")
@derive(Debug, Clone)
pub struct ViewportPanelIR:
    field_name: String
    viewport_type: String
    tab_name: String
    tab_id: String
    size_coefficient: f32

@doc(doc = " Details panel configuration")
@derive(Debug, Clone)
pub struct DetailsPanelIR:
    field_name: String
    tab_name: String
    tab_id: String
    size_coefficient: f32
    show_name_area: Bool
    lockable: Bool

@doc(doc = " Toolbar configuration")
@derive(Debug, Clone)
pub struct ToolbarIR:
    field_name: String
    toolbar_type: String
    actions: Array<ToolbarActionIR>

@doc(doc = " Toolbar action definition")
@derive(Debug, Clone)
pub struct ToolbarActionIR:
    name: String
    action_type: ToolbarActionType
    label: String
    icon: Option<String>
    tooltip: Option<String>

pub enum ToolbarActionType:
    Button
    Toggle
    Dropdown
    Separator

@doc(doc = " Custom Slate widget panel")
@derive(Debug, Clone)
pub struct CustomWidgetIR:
    field_name: String
    widget_type: String
    tab_name: String
    tab_id: String
    size_coefficient: f32

@doc(doc = " Tab layout configuration")
@derive(Debug, Clone)
pub struct TabLayoutIR:
    orientation: LayoutOrientation
    arrangement: TabArrangement

pub enum LayoutOrientation:
    Horizontal
    Vertical

pub enum TabArrangement:
    SingleStack
    ViewportDetailsHorizontal
    ViewportDetailsVertical
    Custom

@doc(doc = " Custom method on asset editor")
@derive(Debug, Clone)
pub struct CustomMethodIR:
    name: String
    params: Array<(String, String)>
    return_type: Option<String>
    body: String

impl Default for TabLayoutIR:
    fn default_() -> TabLayoutIR:
        TabLayoutIR { orientation: LayoutOrientation__Horizontal, arrangement: TabArrangement__ViewportDetailsHorizontal }


@doc(doc = " Convert an asset editor struct from AST to AssetEditorIR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `asset_editor` - The asset editor struct from AST")
@doc(doc = " * `ctx` - UE5 compilation context for type mapping")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `Ok(AssetEditorIR)` - Successfully converted IR")
@doc(doc = " * `Err(String)` - Conversion error with description")
pub fn convert_to_asset_editor_ir(asset_editor: &kain_core::ast::Struct, ctx: &ue5::ue5::context::Ue5Context) -> Result<AssetEditorIR, String>:
    if (!has_attribute(&(*asset_editor).attributes, "asset_editor")):
        return Result::Err(f"Struct '{(*asset_editor).name}' does not have @asset_editor attribute")
    let viewport = extract_viewport_panel(&(*asset_editor).fields)?
    let details = extract_details_panel(&(*asset_editor).fields)?
    let toolbar = extract_toolbar(&(*asset_editor).fields)?
    let custom_widgets = extract_custom_widgets(&(*asset_editor).fields)?
    let asset_type = extract_asset_type(&(*asset_editor).attributes)?
    let layout = determine_tab_layout(&viewport, &details, &custom_widgets)
    let custom_methods = extract_custom_methods(&(*asset_editor).methods, ctx)?
    Result::Ok(AssetEditorIR { name: (*asset_editor).name.clone(), viewport: viewport, details: details, toolbar: toolbar, custom_widgets: custom_widgets, asset_type: asset_type, layout: layout, custom_methods: custom_methods })

@doc(doc = " Extract viewport panel from fields")
fn extract_viewport_panel(fields: &[kain_core::ast::Field]) -> Result<Option<ViewportPanelIR>, String>:
    for field in fields:
        if has_attribute(&field.attributes, "viewport"):
            let viewport_type = extract_type_name(&field.ty)?
            let tab_name = extract_tab_name(&field.attributes, "Viewport")
            let size_coefficient = extract_size_coefficient(&field.attributes, 0.7)
            return Result::Ok(Option::Some(ViewportPanelIR { field_name: field.name.clone(), viewport_type: viewport_type, tab_name: tab_name.clone(), tab_id: f"{field.name}TabId", size_coefficient: size_coefficient }))
    ()
    Result::Ok(none)

@doc(doc = " Extract details panel from fields")
fn extract_details_panel(fields: &[kain_core::ast::Field]) -> Result<Option<DetailsPanelIR>, String>:
    for field in fields:
        if (has_attribute(&field.attributes, "details") || has_attribute(&field.attributes, "details_panel")):
            let tab_name = extract_tab_name(&field.attributes, "Details")
            let size_coefficient = extract_size_coefficient(&field.attributes, 0.3)
            let show_name_area = extract_bool_attribute(&field.attributes, "show_name_area", false)
            let lockable = extract_bool_attribute(&field.attributes, "lockable", false)
            return Result::Ok(Option::Some(DetailsPanelIR { field_name: field.name.clone(), tab_name: tab_name.clone(), tab_id: f"{field.name}TabId", size_coefficient: size_coefficient, show_name_area: show_name_area, lockable: lockable }))
    ()
    Result::Ok(none)

@doc(doc = " Extract toolbar from fields")
fn extract_toolbar(fields: &[kain_core::ast::Field]) -> Result<Option<ToolbarIR>, String>:
    for field in fields:
        if has_attribute(&field.attributes, "toolbar"):
            let toolbar_type = extract_type_name(&field.ty)?
            return Result::Ok(Option::Some(ToolbarIR { field_name: field.name.clone(), toolbar_type: toolbar_type, actions: Vec__new_() }))
    ()
    Result::Ok(none)

@doc(doc = " Extract custom Slate widgets from fields")
fn extract_custom_widgets(fields: &[kain_core::ast::Field]) -> Result<Array<CustomWidgetIR>, String>:
    let mut widgets = Vec__new_()
    for field in fields:
        if (has_attribute(&field.attributes, "slate") || has_attribute(&field.attributes, "custom_widget")):
            let widget_type = extract_type_name(&field.ty)?
            let tab_name = extract_tab_name(&field.attributes, &field.name)
            let size_coefficient = extract_size_coefficient(&field.attributes, 0.3)
            widgets.push(CustomWidgetIR { field_name: field.name.clone(), widget_type: widget_type, tab_name: tab_name.clone(), tab_id: f"{field.name}TabId", size_coefficient: size_coefficient })
            ()
    ()
    Result::Ok(widgets)

@doc(doc = " Extract asset type from attributes")
fn extract_asset_type(attributes: &[kain_core::ast::Attribute]) -> Result<Option<String>, String>:
    for attr in attributes:
        if (attr.name == "asset_type"):
            match attr.args.first():
                Some(first_arg) =>
                    match first_arg:
                        kain_core__ast__Expr::Ident(type_name, _) => return Result::Ok(Option::Some(type_name.clone()))
                        _ =>
                            ()
                            ()
                    match first_arg:
                        kain_core__ast__Expr::String(type_name, _) => return Result::Ok(Option::Some(type_name.clone()))
                        _ => ()
                _ => ()
    ()
    Result::Ok(none)

@doc(doc = " Determine tab layout based on panels present")
fn determine_tab_layout(viewport: &Option<ViewportPanelIR>, details: &Option<DetailsPanelIR>, custom_widgets: &[CustomWidgetIR]) -> TabLayoutIR:
    if (viewport.is_some() && details.is_some()):
        return TabLayoutIR { orientation: LayoutOrientation__Horizontal, arrangement: TabArrangement__ViewportDetailsHorizontal }
    if (!custom_widgets.is_empty()):
        return TabLayoutIR { orientation: LayoutOrientation__Vertical, arrangement: TabArrangement__Custom }
    TabLayoutIR { orientation: LayoutOrientation__Vertical, arrangement: TabArrangement__SingleStack }

@doc(doc = " Extract custom methods from asset editor struct")
fn extract_custom_methods(methods: &[kain_core::ast::Function], _ctx: &ue5::ue5::context::Ue5Context) -> Result<Array<CustomMethodIR>, String>:
    let mut custom_methods = Vec__new_()
    for method in methods:
        let virtual_methods = ["GetToolkitFName", "GetBaseToolkitName", "GetWorldCentricTabPrefix", "GetWorldCentricTabColorScale", "OnClose"]
        if virtual_methods.contains(&method.name.as_str()):
            continue
        custom_methods.push(CustomMethodIR { name: method.name.clone(), params: Vec__new_(), return_type: none, body: f"// TODO: Implement {method.name}" })
        ()
    ()
    Result::Ok(custom_methods)

@doc(doc = " Check if an attribute with the given name exists")
fn has_attribute(attributes: &[kain_core::ast::Attribute], name: String) -> Bool:
    attributes.iter().any(fn(attr): (attr.name == name))

@doc(doc = " Extract type name from a Type AST node")
fn extract_type_name(ty: &kain_core::ast::Type) -> Result<String, String>:
    match ty:
        kain_core__ast__Type::Named { name: name } => Result::Ok(name.clone())
        _ =>
            let type_desc = match ty:
                kain_core__ast__Type::Array {  } => "array type"
                kain_core__ast__Type::Option {  } => "Option type"
                kain_core__ast__Type::Tuple {  } => "tuple type"
                kain_core__ast__Type::Function {  } => "function type"
                _ => "complex type"
            Result::Err(f"Expected named type, got {type_desc}")

@doc(doc = " Extract tab name from attributes or use default")
fn extract_tab_name(attributes: &[kain_core::ast::Attribute], default_: String) -> String:
    for attr in attributes:
        if (attr.name == "tab_name"):
            match attr.args.first():
                Some(first_arg) =>
                    match first_arg:
                        kain_core__ast__Expr::String(name, _) => return name.clone()
                        _ => ()
                _ => ()
    ()
    default_.to_string()

@doc(doc = " Extract size coefficient from attributes or use default")
fn extract_size_coefficient(attributes: &[kain_core::ast::Attribute], default_: f32) -> f32:
    for attr in attributes:
        if ((attr.name == "size") || (attr.name == "size_coefficient")):
            match attr.args.first():
                Some(first_arg) =>
                    match first_arg:
                        kain_core__ast__Expr::Float(val, _) => return (*val) as f32
                        _ =>
                            ()
                            ()
                    match first_arg:
                        kain_core__ast__Expr::Int(val, _) => return (*val) as f32
                        _ => ()
                _ => ()
    ()
    default_

@doc(doc = " Extract boolean attribute value or use default")
fn extract_bool_attribute(attributes: &[kain_core::ast::Attribute], name: String, default_: Bool) -> Bool:
    for attr in attributes:
        if (attr.name == name):
            match attr.args.first():
                Some(first_arg) =>
                    match first_arg:
                        kain_core__ast__Expr::Bool(val, _) => return (*val)
                        _ =>
                            ()
                            ()
                    match first_arg:
                        kain_core__ast__Expr::Ident(val, _) =>
                            match val.as_str():
                                "true" => return true
                                "false" => return false
                                _ => ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            if attr.args.is_empty():
                return true
    ()
    default_

