const SUPPORTED_FORMATS: Array<String> = ["lr35902-gameboy", "gameboy-lr35902", "gb-lr35902", "lr35902", "gameboy"]

const MAX_EXPAND_DEPTH: usize = 16

const FLAG_Z: u8 = 128

const FLAG_N: u8 = 64

const FLAG_H: u8 = 32

const FLAG_C: u8 = 16

@derive(Clone, Debug, PartialEq, Eq)
struct Lr35902State:
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
    h: u8
    l: u8
    f: u8
    sp: u16
    pc: u16
    ime: Bool
    ime_enable_delay: u8
    halted: Bool
    cycles: u64

enum MbcKind:
    None
    Mbc1
    Mbc5

@derive(Clone, Debug, PartialEq, Eq)
struct Lr35902Memory:
    rom0: Array<u8>
    romx: Array<Array<u8>>
    current_rom_bank: usize
    rom_bank_low5: u8
    rom_bank_high2: u8
    rom_bank_low8: u8
    rom_bank_high1: u8
    banking_mode: u8
    ram_enabled: Bool
    current_ram_bank: usize
    mbc_kind: MbcKind
    vram: [u8; 8192]
    eram: [[u8; 8192]; 4]
    wram0: [u8; 4096]
    wramx: [u8; 4096]
    oam: [u8; 160]
    hram: [u8; 127]
    io: [u8; 128]
    ie: u8
    div_cycle_accum: u16
    timer_cycle_accum: u16
    ppu_cycle_accum: u16
    dma_cycles_remaining: u16
    dma_cycle_accum: u8
    dma_source_page: u8
    dma_next_index: u8
    serial_cycles_remaining: u16
    joypad_last_low: u8
    joypad_buttons: u8
    joypad_dpad: u8
    framebuffer: Array<u8>
    last_ppu_mode: u8
    stat_irq_latch: Bool
    window_line_counter: u8
    apu_cycle_accum: u16
    apu_frame_step: u8

enum StepEffect:
    None
    Halt
    PortWrite { port: u8, value: u8 }
    Interrupt { vector: u16 }

@derive(Clone, Debug, PartialEq, Eq)
struct StepResult:
    state_: Lr35902State
    memory: Lr35902Memory
    effect: StepEffect
    opcode: u8
    cycles: u8

impl Default for Lr35902State:
    fn default_() -> Lr35902State:
        Lr35902State { a: 0, b: 0, c: 0, d: 0, e: 0, h: 0, l: 0, f: 0, sp: 65534, pc: 256, ime: false, ime_enable_delay: 0, halted: false, cycles: 0 }


