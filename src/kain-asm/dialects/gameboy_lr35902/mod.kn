const IF_BIT_VBLANK: u8 = 1

const IF_BIT_LCDSTAT: u8 = 2

const IF_BIT_TIMER: u8 = 4

const IF_BIT_SERIAL: u8 = 8

const IF_BIT_JOYPAD: u8 = 16

const IO_IF: usize = 15

const IO_DIV: usize = 4

const IO_TIMA: usize = 5

const IO_TMA: usize = 6

const IO_TAC: usize = 7

const IO_JOYP: usize = 0

const IO_SC: usize = 2

const IO_LCDC: usize = 64

const IO_STAT: usize = 65

const IO_SCY: usize = 66

const IO_SCX: usize = 67

const IO_LY: usize = 68

const IO_LYC: usize = 69

const IO_DMA: usize = 70

const IO_BGP: usize = 71

const IO_OBP0: usize = 72

const IO_OBP1: usize = 73

const IO_WY: usize = 74

const IO_WX: usize = 75

fn detect_mbc_kind(rom0: &[u8]) -> MbcKind:
    let cart_type = rom0.get(327).copied().unwrap_or(0)
    match cart_type:
        0 => MbcKind__None
        8 => MbcKind__None
        9 => MbcKind__None
        _ => MbcKind__Mbc1
        _ => MbcKind__Mbc5
        _ => MbcKind__Mbc1

fn effective_rom_bank0(mem: &Lr35902Memory) -> usize:
    match (*mem).mbc_kind:
        MbcKind::None => 0
        MbcKind::Mbc5 => 0
        MbcKind::Mbc1 => if ((*mem).banking_mode == 0): 0 else: (((*mem).rom_bank_high2 as usize) << 5)

fn effective_rom_bankx(mem: &Lr35902Memory) -> usize:
    let mut bank = match (*mem).mbc_kind:
        MbcKind::None => 1
        MbcKind::Mbc1 =>
            let high = if ((*mem).banking_mode == 0):
                (((*mem).rom_bank_high2 as usize) << 5)
            else:
                0
            (((*mem).rom_bank_low5 as usize) | high)
        MbcKind::Mbc5 => (((((*mem).rom_bank_high1 as usize) << 8)) | (*mem).rom_bank_low8 as usize)
    if (none && (bank == 0)):
        bank = 1
        ()
        ()
        ()
        ()
    bank

fn map_rom_bank(mem: &Lr35902Memory, bank: usize, off: usize) -> u8:
    if (bank == 0):
        return (*(*mem).rom0.get(off).unwrap_or(&255))
    if (*mem).romx.is_empty():
        return 255
    let idx = (((bank - 1)) % (*mem).romx.len())
    (*mem).romx.get(idx).and_then(fn(b): b.get(off)).copied().unwrap_or(255)

fn refresh_mbc_state(mem: &mut Lr35902Memory):
    (*mem).mbc_kind = detect_mbc_kind(&(*mem).rom0)
    ()
    (*mem).current_rom_bank = effective_rom_bankx(mem)
    ()
    (*mem).current_ram_bank = none
    ()
    if (!(*mem).eram.is_empty()):
        (*mem).current_ram_bank = ((*mem).current_ram_bank % (*mem).eram.len())
        ()

fn joypad_input_low_nibble(mem: &Lr35902Memory) -> u8:
    let select = ((*mem).io[IO_JOYP] & 48)
    let mut low = 15
    if (((select & 16)) == 0):
        low = (low & (*mem).joypad_dpad)
        ()
        ()
        ()
        ()
    if (((select & 32)) == 0):
        low = (low & (*mem).joypad_buttons)
        ()
        ()
        ()
        ()
    low

fn update_joypad_register(mem: &mut Lr35902Memory):
    let select = ((*mem).io[IO_JOYP] & 48)
    let low = joypad_input_low_nibble(mem)
    (*mem).io[IO_JOYP] = (select | low)
    ()
    if ((((*mem).joypad_last_low & (!low))) != 0):
        request_interrupt(mem, IF_BIT_JOYPAD)
        ()
        ()
        ()
        ()
    (*mem).joypad_last_low = low
    ()

fn dma_oam_transfer(mem: &mut Lr35902Memory, page: u8):
    (*mem).dma_source_page = page
    ()
    (*mem).dma_next_index = 0
    ()
    (*mem).dma_cycle_accum = 0
    ()
    (*mem).dma_cycles_remaining = (160 * 4)
    ()

fn read8_raw(mem: &Lr35902Memory, addr: u16) -> u8:
    match addr:
        _ =>
            let off = addr as usize
            let bank0 = effective_rom_bank0(mem)
            map_rom_bank(mem, bank0, off)
        _ =>
            let off = (addr as usize).saturating_sub(16384)
            let bankx = effective_rom_bankx(mem)
            map_rom_bank(mem, bankx, off)
        _ => (*mem).vram[((addr - 32768)) as usize]
        _ => if (!(*mem).ram_enabled): 255 else: (*mem).eram[(*mem).current_ram_bank.min(((*mem).eram.len() - 1))][((addr - 40960)) as usize]
        _ => (*mem).wram0[((addr - 49152)) as usize]
        _ => (*mem).wramx[((addr - 53248)) as usize]
        _ => (*mem).wram0[((addr - 57344)) as usize]
        _ => (*mem).wramx[((addr - 61440)) as usize]
        _ => (*mem).oam[((addr - 65024)) as usize]
        _ => 255
        _ => (*mem).io[((addr - 65280)) as usize]
        _ => (*mem).hram[((addr - 65408)) as usize]
        65535 => (*mem).ie

fn read8(state_: &Lr35902State, mem: &Lr35902Memory, addr: u16) -> u8:
    let _ = state_
    if (((*mem).dma_cycles_remaining > 0) && (addr < 65408)):
        return 255
    read8_raw(mem, addr)

fn write8(mem: &mut Lr35902Memory, addr: u16, value: u8):
    let detected = detect_mbc_kind(&(*mem).rom0)
    if ((*mem).mbc_kind != detected):
        (*mem).mbc_kind = detected
        ()
        ()
        ()
        ()
    if ((((*mem).dma_cycles_remaining > 0) && (addr < 65408)) && (addr != 65350)):
        return
    match addr:
        _ =>
            if (!none):
                (*mem).ram_enabled = (((value & 15)) == 10)
                ()
        _ =>
            match (*mem).mbc_kind:
                MbcKind::None => ()
                MbcKind::Mbc1 =>
                    (*mem).rom_bank_low5 = (value & 31)
                    ()
                    if ((*mem).rom_bank_low5 == 0):
                        (*mem).rom_bank_low5 = 1
                        ()
                        ()
                        ()
                        ()
                    ()
                MbcKind::Mbc5 =>
                    if (addr <= 12287):
                        (*mem).rom_bank_low8 = value
                        ()
                        ()
                        ()
                        ()
                    else:
                        (*mem).rom_bank_high1 = (value & 1)
                        ()
                        ()
                        ()
                        ()
                    ()
            refresh_mbc_state(mem)
            ()
        _ =>
            match (*mem).mbc_kind:
                MbcKind::None => ()
                MbcKind::Mbc1 =>
                    (*mem).rom_bank_high2 = (value & 3)
                    ()
                    ()
                    ()
                    ()
                MbcKind::Mbc5 =>
                    (*mem).rom_bank_high2 = (value & 15)
                    ()
                    ()
                    ()
                    ()
            refresh_mbc_state(mem)
            ()
        _ =>
            if (none):
                (*mem).banking_mode = (value & 1)
                ()
                ()
                ()
                ()
            refresh_mbc_state(mem)
            ()
        _ => (*mem).vram[((addr - 32768)) as usize] = value
        _ =>
            if (*mem).ram_enabled:
                let bank = (*mem).current_ram_bank.min(((*mem).eram.len() - 1))
                (*mem).eram[bank][((addr - 40960)) as usize] = value
                ()
        _ => (*mem).wram0[((addr - 49152)) as usize] = value
        _ => (*mem).wramx[((addr - 53248)) as usize] = value
        _ => (*mem).wram0[((addr - 57344)) as usize] = value
        _ => (*mem).wramx[((addr - 61440)) as usize] = value
        _ => (*mem).oam[((addr - 65024)) as usize] = value
        _ => ()
        _ =>
            let idx = ((addr - 65280)) as usize
            if (idx == IO_DIV):
                (*mem).io[IO_DIV] = 0
                ()
                (*mem).div_cycle_accum = 0
                ()
                ()
                ()
                ()
            elif (idx == IO_STAT):
                (*mem).io[IO_STAT] = (((value & 120)) | (((*mem).io[IO_STAT] & 7)))
                ()
                ()
                ()
                ()
            elif (idx == IO_JOYP):
                (*mem).io[IO_JOYP] = (((value & 48)) | (((*mem).io[IO_JOYP] & 15)))
                ()
                update_joypad_register(mem)
                ()
                ()
                ()
                ()
            elif (idx == IO_DMA):
                (*mem).io[IO_DMA] = value
                ()
                dma_oam_transfer(mem, value)
                ()
                ()
                ()
                ()
            elif (idx == IO_LCDC):
                let was_enabled = ((((*mem).io[IO_LCDC] & 128)) != 0)
                (*mem).io[IO_LCDC] = value
                ()
                let now_enabled = (((value & 128)) != 0)
                if (was_enabled && (!now_enabled)):
                    (*mem).ppu_cycle_accum = 0
                    ()
                    (*mem).io[IO_LY] = 0
                    ()
                    (*mem).last_ppu_mode = 0
                    ()
                    (*mem).stat_irq_latch = false
                    ()
                    (*mem).window_line_counter = 0
                    ()
                    ()
                    ()
                    ()
                elif ((!was_enabled) && now_enabled):
                    (*mem).ppu_cycle_accum = 0
                    ()
                    (*mem).last_ppu_mode = 2
                    ()
                    ()
                    ()
                    ()
                ()
            elif (idx == IO_SC):
                (*mem).io[IO_SC] = value
                ()
                if (((value & 128)) != 0):
                    (*mem).serial_cycles_remaining = 4096
                    ()
                    ()
                    ()
                    ()
                ()
            else:
                (*mem).io[idx] = value
                ()
                ()
                ()
                ()
            if (((idx == IO_STAT) || (idx == IO_LYC)) || (idx == IO_LCDC)):
                update_stat_and_irq(mem)
                ()
        _ => (*mem).hram[((addr - 65408)) as usize] = value
