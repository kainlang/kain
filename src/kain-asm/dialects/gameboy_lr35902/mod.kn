@derive(Clone)
struct SourceLine:
    text: String
    file: String
    line_: usize

@derive(Clone)
struct CanonLine:
    text: String
    file: String
    line_: usize
    canon: usize

@derive(Clone)
struct MacroDef:
    body: Array<CanonLine>

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct SourceProvenance:
    kind: String
    symbol: String
    source_file: String
    source_line_start: usize
    source_line_end: usize
    canonical_line_start: usize
    canonical_line_end: usize

@derive(serde__Serialize)
struct GameboyMap:
    translit_units: Array<kain_core::TranslitUnit>
    parity_trace_schema: kain_core::ParityTraceFrame
    source_provenance: Array<SourceProvenance>
    rom_model_path: String
    parity_harness_path: String
    trace_path: String
    diagnostics_path: String

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct RomSection:
    name: String
    bank: u16
    start: u16
    end: u16
    bytes: usize

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct RomBank:
    bank: u16
    used_bytes: usize

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct GameboyRomModel:
    sections: Array<RomSection>
    banks: Array<RomBank>

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct ParityCheckpoint:
    tick: u64
    label: String
    source_line: usize

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct SemanticTraceSample:
    step: u64
    pc: u16
    opcode: u8
    cycles: u8

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct TraceFrame:
    step: u64
    pc: u16
    opcode: u8
    cycles: u8
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
    h: u8
    l: u8
    f: u8
    sp: u16
    ime: Bool
    halted: Bool
    effect: String

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct GameboyTraceArtifact:
    frames: Array<TraceFrame>

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct GameboyParityHarness:
    checkpoints: Array<ParityCheckpoint>
    graph_nodes: usize
    graph_edges: usize
    semantic_probe_opcode: u8
    semantic_probe_cycles: u8
    semantic_trace: Array<SemanticTraceSample>

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct AsmDiagnostic:
    severity: String
    code: String
    message: String
    canonical_line: usize
    canonical_col: usize
    canonical_snippet: String
    source_file: String
    source_line: usize

@derive(Clone, serde__Serialize, schemars__JsonSchema)
struct GameboyDiagnostics:
    diagnostics: Array<AsmDiagnostic>

pub fn import_asm(input: &std::path::Path, format: String, out_kn: Option<&std::path::Path>, validate_only: Bool) -> AsmResult<ImportAsmOutput>:
    let _ = tracing_subscriber__fmt__try_init()
    let normalized = format.trim().to_ascii_lowercase()
    if (!SUPPORTED_FORMATS.iter().any(fn(v): ((*v) == normalized))):
        return Result::Err(AsmError__runtime("Unsupported asm format '{format}'. Supported: {SUPPORTED_FORMATS.join(\", \")}"))
    info!("kain-asm import start: format={}, input={}", normalized, input.display())
    let raw = load_asm_with_includes(input)?
    let canonical = canonicalize_asm(&raw)
    let canonical_text = canonical.iter().map(fn(l): l.text.as_str()).collect().join("\n")
    let expanded = expand_rgbds_semantics(&canonical)
    let expanded_text = expanded.iter().map(fn(l): l.text.as_str()).collect().join("\n")
    let (parsed, provenance) = parse_asm_program(&expanded)
    let translit_units = build_translit_units(&parsed)
    let report = build_recovery_report(input, &expanded, &parsed)
    let cwd = std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from("."))
    let root = if cwd.join("crates").is_dir():
        cwd.clone()
    elif cwd.join("Kain").join("crates").is_dir():
        cwd.join("Kain")
    else:
        cwd
    let research_dir = root.join("Research").join("gameboy")
    let generated_dir = root.join("generated")
    std__fs__create_dir_all(&research_dir).map_err(AsmError__Io)?
    ()
    std__fs__create_dir_all(&generated_dir).map_err(AsmError__Io)?
    ()
    let canonical_asm_path = research_dir.join("gameboy_canonical.asm")
    let generated_kn_path = out_kn.map(Path__to_path_buf).unwrap_or_else(fn(): generated_dir.join("gameboy_firmware.kn"))
    let map_json_path = generated_kn_path.parent().unwrap_or(&generated_dir).join("gameboy_map.json")
    let report_json_path = research_dir.join("gameboy_recovery_report.json")
    let rom_model_path = map_json_path.with_file_name("gameboy_rom_model.json")
    let parity_harness_path = map_json_path.with_file_name("gameboy_parity_harness.json")
    let trace_path = map_json_path.with_file_name("gameboy_trace.json")
    let diagnostics_path = map_json_path.with_file_name("gameboy_diagnostics.json")
    let rom_model = build_rom_model(&expanded, &parsed)
    let parity_harness = build_parity_harness(&parsed)
    let trace_artifact = build_trace_artifact()
    let diagnostics = build_diagnostics(&expanded, &expanded_text, &report)
    debug!("import stages done: canonical_lines={}, expanded_lines={}, blocks={}", canonical.len(), expanded.len(), parsed.blocks.len())
    if (!validate_only):
        std__fs__write(&canonical_asm_path, canonical_text).map_err(AsmError__Io)?
        ()
        std__fs__write(&generated_kn_path, render_kain_firmware(&parsed, &translit_units)).map_err(AsmError__Io)?
        ()
        let map = GameboyMap { translit_units: translit_units.clone(), parity_trace_schema: default_parity_trace_schema(), source_provenance: provenance, rom_model_path: rom_model_path.display().to_string(), parity_harness_path: parity_harness_path.display().to_string(), trace_path: trace_path.display().to_string(), diagnostics_path: diagnostics_path.display().to_string() }
        let map_json = serde_json__to_string_pretty(&map).map_err(fn(e): AsmError__runtime(f"Failed to serialize gameboy map: {e}"))?
        std__fs__write(&map_json_path, map_json).map_err(AsmError__Io)?
        ()
        let rom_json = serde_json__to_string_pretty(&rom_model).map_err(fn(e): AsmError__runtime(f"Failed to serialize rom model: {e}"))?
        std__fs__write(&rom_model_path, rom_json).map_err(AsmError__Io)?
        ()
        let parity_json = serde_json__to_string_pretty(&parity_harness).map_err(fn(e): AsmError__runtime(f"Failed to serialize parity harness: {e}"))?
        std__fs__write(&parity_harness_path, parity_json).map_err(AsmError__Io)?
        ()
        let trace_json = serde_json__to_string_pretty(&trace_artifact).map_err(fn(e): AsmError__runtime(f"Failed to serialize parity trace: {e}"))?
        std__fs__write(&trace_path, trace_json).map_err(AsmError__Io)?
        ()
        let diagnostics_json = serde_json__to_string_pretty(&diagnostics).map_err(fn(e): AsmError__runtime(f"Failed to serialize diagnostics: {e}"))?
        std__fs__write(&diagnostics_path, diagnostics_json).map_err(AsmError__Io)?
        ()
        ()
        ()
        ()
    let report_json = serde_json__to_string_pretty(&report).map_err(fn(e): AsmError__runtime(f"Failed to serialize gameboy recovery report: {e}"))?
    std__fs__write(&report_json_path, report_json).map_err(AsmError__Io)?
    ()
    Result::Ok(ImportAsmOutput { canonical_asm_path: canonical_asm_path, generated_kn_path: generated_kn_path, map_json_path: map_json_path, report_json_path: report_json_path, parsed: parsed, translit_units: translit_units })

fn load_asm_with_includes(entry: &std::path::Path) -> AsmResult<Array<SourceLine>>:
    fn walk(path: &std::path::Path, stack: &mut Set<std::path::PathBuf>, out_: &mut Array<SourceLine>) -> AsmResult<()>:
        let canonical = std__fs__canonicalize(path).or_else(fn(_): Result::Ok(path.to_path_buf())).map_err(AsmError__Io)?
        if (!stack.insert(canonical.clone())):
            return Result::Err(AsmError__runtime(f"Detected recursive include loop at {canonical.display()}"))
        let content = std__fs__read_to_string(&canonical).map_err(AsmError__Io)?
        let dir = canonical.parent().map(Path__to_path_buf).unwrap_or_else(fn(): PathBuf__from("."))
        let file = canonical.display().to_string()
        for selfhost_for_item in content.lines().enumerate():
            let (idx, line_) = selfhost_for_item
            let ln = (idx + 1)
            match parse_include_path(line_):
                Some(inc) =>
                    let inc_path = dir.join(inc)
                    if inc_path.exists():
                        walk(&inc_path, stack, out_)?
                        ()
                        continue
                    ()
                _ =>
                    ()
                    ()
            out_.push(SourceLine { text: line_.to_string(), file: file.clone(), line_: ln })
            ()
        ()
        stack.remove(&canonical)
        ()
        Result::Ok(())

    let mut out_ = Vec__new_()
    let mut stack = HashSet__new_()
    walk(entry, &mut stack, &mut out_)?
    ()
    Result::Ok(out_)

fn parse_include_path(line_: String) -> Option<String>:
    let code = strip_comment(line_).trim()
    if (!code.to_ascii_uppercase().starts_with("INCLUDE ")):
        return none
    let i0 = code.find("\"")?
    let rest = &code[(i0 + 1)..]
    let i1 = rest.find("\"")?
    Option::Some(rest[..i1].to_string())

fn canonicalize_asm(raw: &[SourceLine]) -> Array<CanonLine>:
    let mut out_ = Vec__new_()
    for line_ in raw:
        let trimmed = line_.text.replace("\u{feff}", "").trim().to_string()
        if trimmed.is_empty():
            continue
        let squashed = trimmed.chars().map(fn(c): if (c.is_ascii() && (!c.is_control())): c else: " ").collect().split_whitespace().collect().join(" ")
        if squashed.is_empty():
            continue
        out_.push(CanonLine { text: squashed, file: line_.file.clone(), line_: line_.line_, canon: (out_.len() + 1) })
        ()
    ()
    out_

fn expand_rgbds_semantics(lines: &[CanonLine]) -> Array<CanonLine>:
    let mut out_ = Vec__new_()
    let mut macros = IndexMap__new_()
    let mut symbols = IndexMap__new_()
    let mut stack = Vec__new_()
    let mut macro_invoke_counter = 0
    let mut active = true
    let mut i = 0
    while (i < lines.len()):
        let line_ = lines[i].clone()
        let text = strip_comment(&line_.text).trim().to_string()
        if text.is_empty():
            i = (i + 1)
            ()
            continue
        match parse_macro_definition(lines, i):
            Some((name, consumed)) =>
                if active:
                    macros.insert(name.to_ascii_uppercase(), MacroDef { body: lines[((i + 1))..(((i + consumed) - 1))].to_vec() })
                    ()
                    ()
                    ()
                    ()
                i = (i + consumed)
                ()
                continue
            _ =>
                ()
                ()
        let token = text.split_whitespace().next().unwrap_or("").to_ascii_uppercase()
        if (token == "IF"):
            let cond = if active:
                eval_cond(text[2..].trim(), &symbols)
            else:
                false
            stack.push((active, cond))
            ()
            active = (active && cond)
            ()
            i = (i + 1)
            ()
            continue
        if (token == "ELSE"):
            match stack.last().copied():
                Some((parent, cond)) =>
                    active = (parent && (!cond))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            i = (i + 1)
            ()
            continue
        if (token == "ENDC"):
            match stack.pop():
                Some((parent, _)) =>
                    active = parent
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            i = (i + 1)
            ()
            continue
        if (token == "REPT"):
            match parse_rept_block(lines, i, &symbols):
                Some((repeat_count, consumed)) =>
                    if active:
                        let body = &lines[((i + 1))..(((i + consumed) - 1))]
                        for _ in range(0, repeat_count):
                            for entry in body:
                                out_.extend(expand_macro_call(entry, &macros, &symbols, 0, &mut macro_invoke_counter))
                                ()
                        ()
                        ()
                    i = (i + consumed)
                    ()
                    continue
                _ =>
                    ()
                    ()
            ()
        if (!active):
            i = (i + 1)
            ()
            continue
        match parse_symbol_assignment(&text, &symbols):
            Some((name, value)) =>
                symbols.insert(name.to_ascii_uppercase(), value)
                ()
                out_.push(line_)
                ()
                i = (i + 1)
                ()
                continue
            _ =>
                ()
                ()
        out_.extend(expand_macro_call(&line_, &macros, &symbols, 0, &mut macro_invoke_counter))
        ()
        i = (i + 1)
        ()
    ()
    out_

fn parse_rept_block(lines: &[CanonLine], start: usize, symbols: &Map<String, i64>) -> Option<(usize, usize)>:
    let head = strip_comment(&lines[start].text).trim()
    let mut parts = head.split_whitespace()
    if (!(parts.next()?).eq_ignore_ascii_case("REPT")):
        return none
    let count_expr = parts.collect().join(" ")
    let repeat_count = (eval_expr_i64(count_expr.trim(), symbols)?).max(0) as usize
    let mut depth = 0
    let mut idx = (start + 1)
    while (idx < lines.len()):
        let token = strip_comment(&lines[idx].text).trim().split_whitespace().next().unwrap_or("").to_ascii_uppercase()
        if (token == "REPT"):
            depth = (depth + 1)
            ()
            ()
            ()
            ()
        elif (token == "ENDR"):
            if (depth == 0):
                return Option::Some((repeat_count, ((idx - start) + 1)))
            depth = (depth - 1)
            ()
            ()
            ()
            ()
        idx = (idx + 1)
        ()
    ()
    none

fn parse_macro_definition(lines: &[CanonLine], start: usize) -> Option<(String, usize)>:
    let head = strip_comment(&lines[start].text).trim()
    let name = match head.split_once(":"):
        Some((left, right)) => if right.trim().eq_ignore_ascii_case("MACRO"): left.trim().to_string() else: String__new_()
        _ =>
            let mut p = head.split_whitespace()
            if (p.next()?).eq_ignore_ascii_case("MACRO"):
                p.next().unwrap_or("").to_string()
            else:
                String__new_()
    if name.is_empty():
        return none
    let mut idx = (start + 1)
    while (idx < lines.len()):
        if strip_comment(&lines[idx].text).trim().eq_ignore_ascii_case("ENDM"):
            return Option::Some((name, ((idx - start) + 1)))
        idx = (idx + 1)
        ()
    ()
    none

fn parse_symbol_assignment(text: String, symbols: &Map<String, i64>) -> Option<(String, i64)>:
    match text.split_once(" EQU ").or_else(fn(): text.split_once(" equ ")):
        Some((left, right)) => return Option::Some((left.trim().to_string(), eval_expr_i64(right.trim(), symbols)?))
        _ =>
            ()
            ()
    let mut p = text.split_whitespace()
    let k = p.next()?
    let op = (p.next()?).to_ascii_uppercase()
    if ((op == "EQU") || (op == "DEF")):
        return Option::Some((k.to_string(), eval_expr_i64(p.collect().join(" ").trim(), symbols)?))
    none

fn eval_cond(expr: String, symbols: &Map<String, i64>) -> Bool:
    (eval_expr_i64(expr, symbols).unwrap_or(0) != 0)

fn parse_num(v: String) -> Option<i64>:
    let t = v.trim()
    match t.strip_prefix("$"):
        Some(h) => return i64__from_str_radix(h, 16).ok()
        _ =>
            ()
            ()
    match t.strip_prefix("0x").or_else(fn(): t.strip_prefix("0X")):
        Some(h) => return i64__from_str_radix(h, 16).ok()
        _ =>
            ()
            ()
    match t.strip_prefix("%"):
        Some(h) => return i64__from_str_radix(h, 2).ok()
        _ =>
            ()
            ()
    t.parse().ok()

enum ExprTok:
    Num(i64)
    Ident(String)
    LParen
    RParen
    Comma
    OrOr
    AndAnd
    EqEq
    NotEq
    Lt
    Lte
    Gt
    Gte
    Plus
    Minus
    Star
    Slash
    Percent
    Bang
    End

fn eval_expr_i64(expr: String, symbols: &Map<String, i64>) -> Option<i64>:
    let toks = tokenize_expr(expr)?
    let mut p = ExprParser { toks: toks, idx: 0, symbols: symbols }
    let value = p.parse_or()?
    if (p.peek() != &ExprTok__End):
        return none
    Option::Some(value)

fn tokenize_expr(expr: String) -> Option<Array<ExprTok>>:
    let mut out_ = SmallVec__new_()
    let bytes = expr.as_bytes()
    let mut i = 0
    while (i < bytes.len()):
        let c = bytes[i] as Char
        if c.is_ascii_whitespace():
            i = (i + 1)
            ()
            continue
        if (c == "$"):
            let start = (i + 1)
            let mut j = start
            while ((j < bytes.len()) && (bytes[j] as Char).is_ascii_hexdigit()):
                j = (j + 1)
                ()
            ()
            if (j == start):
                return none
            out_.push(ExprTok::Num(i64__from_str_radix(&expr[start..j], 16).ok()?))
            ()
            i = j
            ()
            continue
        if (c == "%"):
            let start = (i + 1)
            let mut j = start
            while ((j < bytes.len()) && none):
                j = (j + 1)
                ()
            ()
            if (j > start):
                out_.push(ExprTok::Num(i64__from_str_radix(&expr[start..j], 2).ok()?))
                ()
                i = j
                ()
                ()
                ()
                ()
            else:
                out_.push(ExprTok__Percent)
                ()
                i = (i + 1)
                ()
                ()
                ()
                ()
            continue
        if c.is_ascii_digit():
            let start = i
            let mut j = i
            while ((j < bytes.len()) && (bytes[j] as Char).is_ascii_alphanumeric()):
                j = (j + 1)
                ()
            ()
            out_.push(ExprTok::Num(parse_num(&expr[start..j])?))
            ()
            i = j
            ()
            continue
        if ((c.is_ascii_alphabetic() || (c == "_")) || (c == ".")):
            let start = i
            let mut j = i
            while (j < bytes.len()):
                let ch = bytes[j] as Char
                if ((ch.is_ascii_alphanumeric() || (ch == "_")) || (ch == ".")):
                    j = (j + 1)
                    ()
                else:
                    break
            ()
            out_.push(ExprTok::Ident(expr[start..j].to_ascii_uppercase()))
            ()
            i = j
            ()
            continue
        let two = if ((i + 1) < bytes.len()):
            Option::Some(&expr[i..(i + 2)])
        else:
            none
        match two:
            Some(op) =>
                match op:
                    "||" =>
                        out_.push(ExprTok__OrOr)
                        ()
                        i = (i + 2)
                        ()
                        continue
                    "&&" =>
                        out_.push(ExprTok__AndAnd)
                        ()
                        i = (i + 2)
                        ()
                        continue
                    "==" =>
                        out_.push(ExprTok__EqEq)
                        ()
                        i = (i + 2)
                        ()
                        continue
                    "!=" =>
                        out_.push(ExprTok__NotEq)
                        ()
                        i = (i + 2)
                        ()
                        continue
                    "<=" =>
                        out_.push(ExprTok__Lte)
                        ()
                        i = (i + 2)
                        ()
                        continue
                    ">=" =>
                        out_.push(ExprTok__Gte)
                        ()
                        i = (i + 2)
                        ()
                        continue
                    _ => ()
                ()
            _ =>
                ()
                ()
        match c:
            "(" =>
                out_.push(ExprTok__LParen)
                ()
            ")" =>
                out_.push(ExprTok__RParen)
                ()
            "," =>
                out_.push(ExprTok__Comma)
                ()
            "<" =>
                out_.push(ExprTok__Lt)
                ()
            ">" =>
                out_.push(ExprTok__Gt)
                ()
            "+" =>
                out_.push(ExprTok__Plus)
                ()
            "-" =>
                out_.push(ExprTok__Minus)
                ()
            "*" =>
                out_.push(ExprTok__Star)
                ()
            "/" =>
                out_.push(ExprTok__Slash)
                ()
            "!" =>
                out_.push(ExprTok__Bang)
                ()
            _ => return none
        i = (i + 1)
        ()
    ()
    out_.push(ExprTok__End)
    ()
    Option::Some(out_.into_vec())

struct ExprParser<a>:
    toks: Array<ExprTok>
    idx: usize
    symbols: &a Map<String, i64>

impl<a> ExprParser<a>:
    fn peek(_self: &ExprParser<a>) -> &ExprTok:
        &(*_self).toks[(*_self).idx]

    fn eat(_self: &mut ExprParser<a>) -> ExprTok:
        let t = (*_self).toks[(*_self).idx].clone()
        (*_self).idx = ((*_self).idx + 1)
        ()
        t

    fn expect(_self: &mut ExprParser<a>, tok: ExprTok) -> Option<()>:
        if ((*_self).peek() == &tok):
            (*_self).eat()
            ()
            Option::Some(())
        else:
            none

    fn parse_or(_self: &mut ExprParser<a>) -> Option<i64>:
        let mut lhs = (*_self).parse_and()?
        while ((*_self).peek() == &ExprTok__OrOr):
            (*_self).eat()
            ()
            let rhs = (*_self).parse_and()?
            lhs = if ((lhs != 0) || (rhs != 0)): 1 else: 0
            ()
        ()
        Option::Some(lhs)

    fn parse_and(_self: &mut ExprParser<a>) -> Option<i64>:
        let mut lhs = (*_self).parse_eq()?
        while ((*_self).peek() == &ExprTok__AndAnd):
            (*_self).eat()
            ()
            let rhs = (*_self).parse_eq()?
            lhs = if ((lhs != 0) && (rhs != 0)): 1 else: 0
            ()
        ()
        Option::Some(lhs)

    fn parse_eq(_self: &mut ExprParser<a>) -> Option<i64>:
        let mut lhs = (*_self).parse_rel()?
        loop:
            match (*_self).peek():
                ExprTok::EqEq =>
                    (*_self).eat()
                    ()
                    let rhs = (*_self).parse_rel()?
                    lhs = if (lhs == rhs): 1 else: 0
                    ()
                ExprTok::NotEq =>
                    (*_self).eat()
                    ()
                    let rhs = (*_self).parse_rel()?
                    lhs = if (lhs != rhs): 1 else: 0
                    ()
                _ => break
        ()
        Option::Some(lhs)

    fn parse_rel(_self: &mut ExprParser<a>) -> Option<i64>:
        let mut lhs = (*_self).parse_add()?
        loop:
            match (*_self).peek():
                ExprTok::Lt =>
                    (*_self).eat()
                    ()
                    let rhs = (*_self).parse_add()?
                    lhs = if (lhs < rhs): 1 else: 0
                    ()
                ExprTok::Lte =>
                    (*_self).eat()
                    ()
                    let rhs = (*_self).parse_add()?
                    lhs = if (lhs <= rhs): 1 else: 0
                    ()
                ExprTok::Gt =>
                    (*_self).eat()
                    ()
                    let rhs = (*_self).parse_add()?
                    lhs = if (lhs > rhs): 1 else: 0
                    ()
                ExprTok::Gte =>
                    (*_self).eat()
                    ()
                    let rhs = (*_self).parse_add()?
                    lhs = if (lhs >= rhs): 1 else: 0
                    ()
                _ => break
        ()
        Option::Some(lhs)

    fn parse_add(_self: &mut ExprParser<a>) -> Option<i64>:
        let mut lhs = (*_self).parse_mul()?
        loop:
            match (*_self).peek():
                ExprTok::Plus =>
                    (*_self).eat()
                    ()
                    lhs = (lhs + (*_self).parse_mul()?)
                    ()
                ExprTok::Minus =>
                    (*_self).eat()
                    ()
                    lhs = (lhs - (*_self).parse_mul()?)
                    ()
                _ => break
        ()
        Option::Some(lhs)

    fn parse_mul(_self: &mut ExprParser<a>) -> Option<i64>:
        let mut lhs = (*_self).parse_unary()?
        loop:
            match (*_self).peek():
                ExprTok::Star =>
                    (*_self).eat()
                    ()
                    lhs = (lhs * (*_self).parse_unary()?)
                    ()
                ExprTok::Slash =>
                    (*_self).eat()
                    ()
                    let rhs = (*_self).parse_unary()?
                    if (rhs == 0):
                        return none
                    lhs = (lhs / rhs)
                    ()
                ExprTok::Percent =>
                    (*_self).eat()
                    ()
                    let rhs = (*_self).parse_unary()?
                    if (rhs == 0):
                        return none
                    lhs = (lhs % rhs)
                    ()
                _ => break
        ()
        Option::Some(lhs)

    fn parse_unary(_self: &mut ExprParser<a>) -> Option<i64>:
        match (*_self).peek():
            ExprTok::Bang =>
                (*_self).eat()
                ()
                Option::Some(if ((*_self).parse_unary()? == 0): 1 else: 0)
            ExprTok::Minus =>
                (*_self).eat()
                ()
                Option::Some((-(*_self).parse_unary()?))
            ExprTok::Plus =>
                (*_self).eat()
                ()
                (*_self).parse_unary()
            _ => (*_self).parse_primary()

    fn parse_primary(_self: &mut ExprParser<a>) -> Option<i64>:
        match (*_self).eat():
            ExprTok::Num(n) => Option::Some(n)
            ExprTok::Ident(name) =>
                if (name == "TRUE"):
                    return Option::Some(1)
                if (name == "FALSE"):
                    return Option::Some(0)
                if (name == "DEF"):
                    (*_self).expect(ExprTok__LParen)?
                    ()
                    let symbol = match (*_self).eat():
                        ExprTok::Ident(s) => s
                        _ => return none
                    (*_self).expect(ExprTok__RParen)?
                    ()
                    return Option::Some(if (*_self).symbols.contains_key(&symbol): 1 else: 0)
                Option::Some((*_self).symbols.get(&name).copied().unwrap_or(0))
            ExprTok::LParen =>
                let v = (*_self).parse_or()?
                (*_self).expect(ExprTok__RParen)?
                ()
                Option::Some(v)
            _ => none


fn expand_macro_call(line_: &CanonLine, macros: &Map<String, MacroDef>, symbols: &Map<String, i64>, depth: usize, macro_invoke_counter: &mut u64) -> Array<CanonLine>:
    if (depth >= MAX_EXPAND_DEPTH):
        return [line_.clone()]
    let text = strip_comment(&line_.text).trim().to_string()
    let mut p = text.split_whitespace()
    let name = p.next().unwrap_or("")
    if name.ends_with(":"):
        return [line_.clone()]
    let Some(def) = macros.get(&name.to_ascii_uppercase())
    (*macro_invoke_counter) = ((*macro_invoke_counter) + 1)
    ()
    let macro_id = (*macro_invoke_counter)
    let local_prefix = f"__m{macro_id}_{name.to_ascii_lowercase()}"
    let args = split_csv_top_level(text[name.len()..].trim(), true)
    let mut local_symbols = symbols.clone()
    local_symbols.insert(("_NARG").to_string(), args.len() as i64)
    ()
    let mut conditional_stack = Vec__new_()
    let mut active = true
    let mut out_ = Vec__new_()
    for l in &def.body:
        let raw = strip_comment(&l.text).trim()
        let control_text = substitute_macro_placeholders(raw, &args, macro_id)
        let token = control_text.split_whitespace().next().unwrap_or("").to_ascii_uppercase()
        if (token == "IF"):
            let cond = if active:
                eval_cond(control_text[2..].trim(), &local_symbols)
            else:
                false
            conditional_stack.push((active, cond))
            ()
            active = (active && cond)
            ()
            continue
        if (token == "ELSE"):
            match conditional_stack.last().copied():
                Some((parent, cond)) =>
                    active = (parent && (!cond))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            continue
        if (token == "ENDC"):
            match conditional_stack.pop():
                Some((parent, _)) =>
                    active = parent
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            continue
        if (!active):
            continue
        match parse_symbol_assignment(&control_text, &local_symbols):
            Some((name, value)) =>
                local_symbols.insert(name.to_ascii_uppercase(), value)
                ()
                continue
            _ =>
                ()
                ()
        let mut t = substitute_macro_placeholders(&l.text, &args, macro_id)
        t = rewrite_local_macro_labels(&t, &local_prefix)
        ()
        let nested = expand_macro_call(&CanonLine { text: t, file: l.file.clone(), line_: l.line_, canon: l.canon }, macros, &local_symbols, (depth + 1), macro_invoke_counter)
        out_.extend(nested)
        ()
    ()
    out_

fn rewrite_local_macro_labels(text: String, prefix: String) -> String:
    let mut out_ = String__new_()
    let chars = text.chars().collect()
    let mut i = 0
    while (i < chars.len()):
        let c = chars[i]
        if (c == "."):
            let prev = if (i == 0):
                " "
            else:
                chars[(i - 1)]
            if (!(((prev.is_ascii_alphanumeric() || (prev == "_")) || (prev == ".")))):
                let mut j = (i + 1)
                while ((j < chars.len()) && ((chars[j].is_ascii_alphanumeric() || (chars[j] == "_")))):
                    j = (j + 1)
                    ()
                ()
                if (j > (i + 1)):
                    out_.push_str(prefix)
                    ()
                    out_.push("_")
                    ()
                    out_.extend(chars[((i + 1))..j].iter())
                    ()
                    i = j
                    ()
                    continue
                ()
            ()
        out_.push(c)
        ()
        i = (i + 1)
        ()
    ()
    out_

fn split_csv_top_level(text: String, keep_empty: Bool) -> Array<String>:
    let src = text.trim()
    if src.is_empty():
        return Vec__new_()
    let mut out_ = Vec__new_()
    let mut cur = String__new_()
    let mut in_quote: Option<Char> = none
    let mut escaped = false
    let mut paren_depth = 0
    let mut bracket_depth = 0
    let mut brace_depth = 0
    for ch in src.chars():
        match in_quote:
            Some(q) =>
                cur.push(ch)
                ()
                if escaped:
                    escaped = false
                    ()
                    continue
                if (ch == "\\"):
                    escaped = true
                    ()
                    continue
                if (ch == q):
                    in_quote = none
                    ()
                    ()
                    ()
                    ()
                continue
            _ =>
                ()
                ()
        match ch:
            "\"" =>
                in_quote = Option::Some(ch)
                ()
                cur.push(ch)
                ()
            "'" =>
                in_quote = Option::Some(ch)
                ()
                cur.push(ch)
                ()
            "(" =>
                paren_depth = (paren_depth + 1)
                ()
                cur.push(ch)
                ()
            ")" =>
                paren_depth = paren_depth.saturating_sub(1)
                ()
                cur.push(ch)
                ()
            "[" =>
                bracket_depth = (bracket_depth + 1)
                ()
                cur.push(ch)
                ()
            "]" =>
                bracket_depth = bracket_depth.saturating_sub(1)
                ()
                cur.push(ch)
                ()
            "{" =>
                brace_depth = (brace_depth + 1)
                ()
                cur.push(ch)
                ()
            "}" =>
                brace_depth = brace_depth.saturating_sub(1)
                ()
                cur.push(ch)
                ()
            "," if (((paren_depth == 0) && (bracket_depth == 0)) && (brace_depth == 0)) =>
                let trimmed = cur.trim().to_string()
                if (keep_empty || (!trimmed.is_empty())):
                    out_.push(trimmed)
                    ()
                    ()
                    ()
                    ()
                cur.clear()
                ()
            _ => cur.push(ch)
    ()
    let trimmed = cur.trim().to_string()
    if (keep_empty || (!trimmed.is_empty())):
        out_.push(trimmed)
        ()
        ()
        ()
        ()
    out_

fn substitute_macro_placeholders(text: String, args: &[String], macro_id: u64) -> String:
    let chars = text.chars().collect()
    let mut out_ = String__new_()
    let mut i = 0
    while (i < chars.len()):
        if (chars[i] != "\\"):
            out_.push(chars[i])
            ()
            i = (i + 1)
            ()
            continue
        if ((i + 1) >= chars.len()):
            out_.push("\\")
            ()
            i = (i + 1)
            ()
            continue
        if (chars[(i + 1)] == "@"):
            out_.push_str(&macro_id.to_string())
            ()
            i = (i + 2)
            ()
            continue
        if chars[(i + 1)].is_ascii_digit():
            let mut j = (i + 1)
            while ((j < chars.len()) && chars[j].is_ascii_digit()):
                j = (j + 1)
                ()
            ()
            let idx = chars[((i + 1))..j].iter().collect().parse().ok().unwrap_or(0)
            if (idx > 0):
                match args.get((idx - 1)):
                    Some(arg) =>
                        out_.push_str(arg)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        out_.push("0")
                        ()
                        ()
                        ()
                        ()
                ()
            else:
                out_.push("0")
                ()
                ()
                ()
                ()
            i = j
            ()
            continue
        out_.push("\\")
        ()
        out_.push(chars[(i + 1)])
        ()
        i = (i + 2)
        ()
    ()
    out_

fn normalize_kain_data_expr(expr: String) -> String:
    let chars = expr.chars().collect()
    let mut out_ = String__new_()
    let mut in_quote: Option<Char> = none
    let mut escaped = false
    let mut i = 0
    while (i < chars.len()):
        let ch = chars[i]
        match in_quote:
            Some(q) =>
                out_.push(ch)
                ()
                if escaped:
                    escaped = false
                    ()
                    i = (i + 1)
                    ()
                    continue
                if (ch == "\\"):
                    escaped = true
                    ()
                    i = (i + 1)
                    ()
                    continue
                if (ch == q):
                    in_quote = none
                    ()
                    ()
                    ()
                    ()
                i = (i + 1)
                ()
                continue
            _ =>
                ()
                ()
        if ((ch == "\"") || (ch == "'")):
            in_quote = Option::Some(ch)
            ()
            out_.push(ch)
            ()
            i = (i + 1)
            ()
            continue
        if (ch == "$"):
            let start = (i + 1)
            let mut j = start
            while ((j < chars.len()) && chars[j].is_ascii_hexdigit()):
                j = (j + 1)
                ()
            ()
            if (j > start):
                out_.push_str("0x")
                ()
                out_.extend(chars[start..j].iter())
                ()
                i = j
                ()
                continue
            ()
        if (ch == "%"):
            let start = (i + 1)
            let mut j = start
            while ((j < chars.len()) && (((chars[j] == "0") || (chars[j] == "1")))):
                j = (j + 1)
                ()
            ()
            if (j > start):
                out_.push_str("0b")
                ()
                out_.extend(chars[start..j].iter())
                ()
                i = j
                ()
                continue
            ()
        out_.push(ch)
        ()
        i = (i + 1)
        ()
    ()
    out_

fn is_simple_numeric_literal(expr: String) -> Bool:
    let t = expr.trim()
    if t.is_empty():
        return false
    let s = if (t.starts_with("-") || t.starts_with("+")):
        &t[1..]
    else:
        t
    match s.strip_prefix("0x").or_else(fn(): s.strip_prefix("0X")):
        Some(hex) => return ((!hex.is_empty()) && hex.chars().all(fn(c): c.is_ascii_hexdigit()))
        _ =>
            ()
            ()
    match s.strip_prefix("0b").or_else(fn(): s.strip_prefix("0B")):
        Some(bin) => return ((!bin.is_empty()) && bin.chars().all(fn(c): ((c == "0") || (c == "1"))))
        _ =>
            ()
            ()
    ((!s.is_empty()) && s.chars().all(fn(c): c.is_ascii_digit()))

fn coerce_kain_table_value(expr: String) -> String:
    let t = expr.trim()
    if is_simple_numeric_literal(t):
        t.to_string()
    else:
        ("0").to_string()

fn parse_asm_program(lines: &[CanonLine]) -> (kain_core::AsmProgram, Array<SourceProvenance>):
    let mut blocks = Vec__new_()
    let mut directives = Vec__new_()
    let mut data_tables = Vec__new_()
    let mut provenance = Vec__new_()
    let mut cur_label = String__new_()
    let mut cur_instrs = Vec__new_()
    let mut cur_start = 1
    let mut cur_file = String__new_()
    let mut cur_src_start = 1
    let mut cur_src_end = 1
    let flush = fn(end_line: usize, blocks: &mut Array<kain_core::AsmBlock>, provenance: &mut Array<SourceProvenance>, cur_label: String, cur_instrs: &mut Array<kain_core::AsmInstr>, cur_start: usize, cur_file: String, cur_src_start: usize, cur_src_end: usize): none
    for l in lines:
        let text = strip_comment(&l.text).trim()
        if text.is_empty():
            continue
        if is_label_line(text):
            flush(l.canon.saturating_sub(1), &mut blocks, &mut provenance, &mut cur_label, &mut cur_instrs, cur_start, &cur_file, cur_src_start, cur_src_end)
            ()
            cur_label = normalize_label(text)
            ()
            cur_start = l.canon
            ()
            cur_file = l.file.clone()
            ()
            cur_src_start = l.line_
            ()
            cur_src_end = l.line_
            ()
            continue
        if is_directive_line(text):
            let sym = text.split_whitespace().next().unwrap_or(text).to_string()
            directives.push(kain_core::AsmDirective { name: text.to_string(), args: Vec__new_(), source_line: l.canon })
            ()
            provenance.push(SourceProvenance { kind: ("directive").to_string(), symbol: sym, source_file: l.file.clone(), source_line_start: l.line_, source_line_end: l.line_, canonical_line_start: l.canon, canonical_line_end: l.canon })
            ()
            continue
        match parse_data_line(text):
            Some((label, bytes)) =>
                data_tables.push(kain_core::AsmDataTable { label: label.clone(), bytes: bytes, source_line_start: l.canon, source_line_end: l.canon })
                ()
                provenance.push(SourceProvenance { kind: ("data_table").to_string(), symbol: label, source_file: l.file.clone(), source_line_start: l.line_, source_line_end: l.line_, canonical_line_start: l.canon, canonical_line_end: l.canon })
                ()
                continue
            _ =>
                ()
                ()
        if cur_label.is_empty():
            cur_label = f"bank_entry_{l.canon}"
            ()
            cur_start = l.canon
            ()
            cur_file = l.file.clone()
            ()
            cur_src_start = l.line_
            ()
            cur_src_end = l.line_
            ()
            ()
            ()
            ()
        match parse_instruction(text, l.canon):
            Some(instr) =>
                cur_src_end = l.line_
                ()
                cur_instrs.push(instr)
                ()
            _ => ()
    ()
    flush(lines.len(), &mut blocks, &mut provenance, &mut cur_label, &mut cur_instrs, cur_start, &cur_file, cur_src_start, cur_src_end)
    ()
    (kain_core::AsmProgram { blocks: blocks, directives: directives, data_tables: data_tables }, provenance)

fn strip_comment(line_: String) -> String:
    line_.split_once(";").map(fn(__kain_closure_arg0): __kain_closure_arg0.__kain_tuple_0).unwrap_or(line_)

fn normalize_label(label: String) -> String:
    label.trim().trim_end_matches("::").trim_end_matches(":").to_string()

fn is_label_line(line_: String) -> Bool:
    let t = line_.trim()
    if t.ends_with("::"):
        let n = t.trim_end_matches("::")
        return ((!n.is_empty()) && n.chars().all(fn(c): ((c.is_ascii_alphanumeric() || (c == "_")) || (c == "."))))
    if t.ends_with(":"):
        let n = t.trim_end_matches(":")
        return ((!n.is_empty()) && n.chars().all(fn(c): ((c.is_ascii_alphanumeric() || (c == "_")) || (c == "."))))
    false

fn is_directive_line(line_: String) -> Bool:
    let code = strip_comment(line_).trim()
    if code.is_empty():
        return false
    let upper = code.to_ascii_uppercase()
    if upper.contains(" EQU "):
        return true
    let t = upper.split_whitespace().next().unwrap_or("")
    match t:
        "SECTION" => true
        "INCBIN" => true
        "INCLUDE" => true
        "ORG" => true
        "MACRO" => true
        "ENDM" => true
        "REPT" => true
        "ENDR" => true
        "DEF" => true
        "PURGE" => true
        "UNION" => true
        "NEXTU" => true
        "ENDU" => true
        "RSRESET" => true
        "RSSET" => true
        "FAIL" => true
        "WARN" => true
        "PRINTT" => true
        "PRINTV" => true
        "ASSERT" => true
        _ => false

fn parse_data_line(line_: String) -> Option<(String, Array<String>)>:
    let upper = line_.to_ascii_uppercase()
    let marker = if (upper.contains(" DB ") || upper.starts_with("DB ")):
        "DB"
    elif (upper.contains(" DW ") || upper.starts_with("DW ")):
        "DW"
    else:
        return none
    let pos = upper.find(&f" {marker} ").map(fn(p): (p + 1)).unwrap_or(0)
    let left = line_[..pos].trim()
    let right = line_[(pos + marker.len())..].trim()
    let label = if left.is_empty():
        ("__anonymous_table").to_string()
    else:
        normalize_label(left)
    let values = split_csv_top_level(right, false)
    if values.is_empty():
        none
    else:
        Option::Some((label, values))

fn parse_instruction(line_: String, source_line: usize) -> Option<kain_core::AsmInstr>:
    let mut parts = line_.split_whitespace()
    let opcode = (parts.next()?).to_ascii_uppercase()
    if (!is_opcode_keyword(&opcode)):
        return none
    let operand = parts.collect().join(" ")
    Option::Some(kain_core::AsmInstr { opcode: opcode, operand: if operand.is_empty(): none else: Option::Some(operand), source_line: source_line })

fn build_translit_units(program: &kain_core::AsmProgram) -> Array<kain_core::TranslitUnit>:
    (*program).blocks.par_iter().map(fn(b): kain_core::TranslitUnit { source_label: b.label.clone(), target_item: f"gb_{normalize_identifier(&b.label)}", source_line_start: b.source_line_start, source_line_end: b.source_line_end }).collect()

fn normalize_identifier(label: String) -> String:
    let mut out_ = String__new_()
    for c in label.chars():
        if c.is_ascii_alphanumeric():
            out_.push(c.to_ascii_lowercase())
            ()
        elif ((c == "_") || (c == ".")):
            out_.push("_")
            ()
    ()
    if out_.is_empty():
        ("bank_label").to_string()
    else:
        out_

fn render_kain_firmware(program: &kain_core::AsmProgram, units: &[kain_core::TranslitUnit]) -> String:
    let mut out_ = String__new_()
    out_.push_str("# Generated by kain import-asm --format lr35902-gameboy\n")
    ()
    out_.push_str("# Game Boy LR35902 transliteration seed\n")
    ()
    out_.push_str("# Includes UE5-facing runtime shim entrypoints for fixed-step simulation\n\n")
    ()
    out_.push_str("struct CpuState:\n    a: Int\n    b: Int\n    c: Int\n    d: Int\n    e: Int\n    h: Int\n    l: Int\n    f: Int\n    sp: Int\n    pc: Int\n    ime: Int\n    halted: Int\n    cycles: Int\n\n")
    ()
    out_.push_str("struct Memory:\n    wram: Array<Int>\n    hram: Array<Int>\n    vram: Array<Int>\n    io_ports: Array<Int>\n    rom_banks: Array<Array<Int>>\n\n")
    ()
    out_.push_str("struct Ue5ShimState:\n    cpu: CpuState\n    mem: Memory\n    tick: Int\n    last_effect: Int\n\n")
    ()
    out_.push_str("fn read_port(port_id: Int) -> Int:\n")
    ()
    out_.push_str("    let _port = port_id\n")
    ()
    out_.push_str("    return 0\n\n")
    ()
    out_.push_str("fn write_port(port_id: Int, value: Int):\n")
    ()
    out_.push_str("    let _port = port_id\n")
    ()
    out_.push_str("    let _value = value\n\n")
    ()
    out_.push_str("fn make_cpu_state(a: Int, b: Int, c: Int, d: Int, e: Int, h: Int, l: Int, f: Int, sp: Int, pc: Int, ime: Int, halted: Int, cycles: Int) -> CpuState:\n")
    ()
    out_.push_str("    let out_cpu = CpuState()\n")
    ()
    out_.push_str("    out_cpu.a = a\n")
    ()
    out_.push_str("    out_cpu.b = b\n")
    ()
    out_.push_str("    out_cpu.c = c\n")
    ()
    out_.push_str("    out_cpu.d = d\n")
    ()
    out_.push_str("    out_cpu.e = e\n")
    ()
    out_.push_str("    out_cpu.h = h\n")
    ()
    out_.push_str("    out_cpu.l = l\n")
    ()
    out_.push_str("    out_cpu.f = f\n")
    ()
    out_.push_str("    out_cpu.sp = sp\n")
    ()
    out_.push_str("    out_cpu.pc = pc\n")
    ()
    out_.push_str("    out_cpu.ime = ime\n")
    ()
    out_.push_str("    out_cpu.halted = halted\n")
    ()
    out_.push_str("    out_cpu.cycles = cycles\n")
    ()
    out_.push_str("    return out_cpu\n\n")
    ()
    out_.push_str("fn make_shim_state(cpu: CpuState, mem: Memory, tick: Int, last_effect: Int) -> Ue5ShimState:\n")
    ()
    out_.push_str("    let out_state = Ue5ShimState()\n")
    ()
    out_.push_str("    out_state.cpu = cpu\n")
    ()
    out_.push_str("    out_state.mem = mem\n")
    ()
    out_.push_str("    out_state.tick = tick\n")
    ()
    out_.push_str("    out_state.last_effect = last_effect\n")
    ()
    out_.push_str("    return out_state\n\n")
    ()
    out_.push_str("fn step(cpu: CpuState, mem: Memory) -> (CpuState, Memory, Int):\n")
    ()
    out_.push_str("    let next_cpu = make_cpu_state(cpu.a, cpu.b, cpu.c, cpu.d, cpu.e, cpu.h, cpu.l, cpu.f, cpu.sp, cpu.pc, cpu.ime, cpu.halted, cpu.cycles + 4)\n")
    ()
    out_.push_str("    let next_mem = mem\n")
    ()
    out_.push_str("    return (next_cpu, next_mem, 4)\n\n")
    ()
    out_.push_str("fn parity_frame(state: Ue5ShimState) -> Int:\n")
    ()
    out_.push_str("    let _state = state\n")
    ()
    out_.push_str("    return 0\n\n")
    ()
    out_.push_str("fn ue5_init(cpu: CpuState, mem: Memory) -> Ue5ShimState:\n    return make_shim_state(cpu, mem, 0, 0)\n\n")
    ()
    out_.push_str("fn ue5_reset(state: Ue5ShimState, cpu: CpuState, mem: Memory) -> Ue5ShimState:\n    let _old = state\n    return make_shim_state(cpu, mem, 0, 0)\n\n")
    ()
    out_.push_str("fn ue5_tick_step(state: Ue5ShimState, step_count: Int) -> Ue5ShimState:\n")
    ()
    out_.push_str("    if step_count <= 0:\n")
    ()
    out_.push_str("        return state\n")
    ()
    out_.push_str("    let (cpu1, mem1, eff1) = step(state.cpu, state.mem)\n")
    ()
    out_.push_str("    return make_shim_state(cpu1, mem1, state.tick + 1, eff1)\n\n")
    ()
    out_.push_str("fn ue5_apply_sensor_input(state: Ue5ShimState, port_id: Int, value: Int) -> Ue5ShimState:\n    write_port(port_id, value)\n    return state\n\n")
    ()
    out_.push_str("fn ue5_read_actuator_output(state: Ue5ShimState, port_id: Int) -> Int:\n    let _state = state\n    return read_port(port_id)\n\n")
    ()
    out_.push_str("const GAMEBOY_TABLES: Array<Array<Int>> = [\n")
    ()
    for table in &(*program).data_tables:
        let values = table.bytes.iter().map(fn(v): normalize_kain_data_expr(v)).map(fn(v): coerce_kain_table_value(&v)).collect().join(", ")
        out_.push_str(&f"    [{values}],\n")
        ()
    ()
    out_.push_str("]\n\n")
    ()
    for unit in units:
        out_.push_str(&f"fn {unit.target_item}(cpu: CpuState, mem: Memory) -> (CpuState, Memory):\n    let next_cpu = cpu\n    let next_mem = mem\n")
        ()
        match (*program).blocks.iter().find(fn(b): (b.label == unit.source_label)):
            Some(block) =>
                for instr in &block.instructions:
                    let op = instr.operand.unwrap_or("")
                    out_.push_str(&f"    # [{unit.source_label}:{instr.source_line}] {instr.opcode} {op}\n")
                    ()
                ()
                ()
            _ =>
                ()
                ()
        out_.push_str("    return (next_cpu, next_mem)\n\n")
        ()
    ()
    out_

fn build_rom_model(lines: &[CanonLine], program: &kain_core::AsmProgram) -> GameboyRomModel:
    let mut current_section = ("ROM0").to_string()
    let mut current_bank = 0
    let mut section_start = 0
    let mut pc = 0
    let mut section_bytes = 0
    let mut sections = Vec__new_()
    let mut bank_usage = BTreeMap__new_()
    let flush_section = fn(name: String, bank: u16, start: u16, pc_now: u16, bytes: usize, sections: &mut Array<RomSection>): none
    for line_ in lines:
        let text = strip_comment(&line_.text).trim()
        if text.is_empty():
            continue
        if text.to_ascii_uppercase().starts_with("SECTION "):
            flush_section(&current_section, current_bank, section_start, pc, section_bytes, &mut sections)
            ()
            let (name, bank, base) = parse_section_header(text).unwrap_or((("ROM0").to_string(), 0, pc))
            current_section = name
            ()
            current_bank = bank
            ()
            section_start = base
            ()
            pc = base
            ()
            section_bytes = 0
            ()
            continue
        if parse_data_line(text).is_some():
            match parse_data_line(text):
                Some((_, vals)) =>
                    section_bytes = (section_bytes + vals.len())
                    ()
                    pc = pc.saturating_add(vals.len() as u16)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            continue
        match parse_instruction(text, line_.canon):
            Some(instr) =>
                let size = estimate_instruction_size(&instr)
                section_bytes = (section_bytes + size as usize)
                ()
                pc = pc.saturating_add(size)
                ()
            _ => ()
    ()
    flush_section(&current_section, current_bank, section_start, pc, section_bytes, &mut sections)
    ()
    for sec in &sections:
        (*bank_usage.entry(sec.bank).or_insert(0)) = ((*bank_usage.entry(sec.bank).or_insert(0)) + sec.bytes)
        ()
    ()
    for table in &(*program).data_tables:
        let _ = table
    ()
    let banks = bank_usage.into_iter().map(fn(__kain_closure_arg1): RomBank { bank: __kain_closure_arg1.__kain_tuple_0, used_bytes: __kain_closure_arg1.__kain_tuple_1 }).collect()
    GameboyRomModel { sections: sections, banks: banks }

fn build_parity_harness(program: &kain_core::AsmProgram) -> GameboyParityHarness:
    let checkpoints = (*program).blocks.iter().take(512).enumerate().map(fn(__kain_closure_arg2): ParityCheckpoint { tick: __kain_closure_arg2.__kain_tuple_0 as u64, label: __kain_closure_arg2.__kain_tuple_1.label.clone(), source_line: __kain_closure_arg2.__kain_tuple_1.source_line_start }).collect()
    let mut graph = DiGraphMap__new_()
    for idx in range(0, (*program).blocks.len()):
        graph.add_node(idx)
        ()
    ()
    for selfhost_for_item in (*program).blocks.iter().enumerate():
        let (idx, block) = selfhost_for_item
        for instr in &block.instructions:
            let op = instr.opcode.as_str()
            if (((op != "JP") && (op != "JR")) && (op != "CALL")):
                continue
            let Some(operand) = instr.operand
            let target = operand.split(",").next_back().unwrap_or("").trim().trim_start_matches(".")
            if target.is_empty():
                continue
            match (*program).blocks.iter().position(fn(b): (b.label.eq_ignore_ascii_case(target) || b.label.ends_with(&f".{target}"))):
                Some(to_idx) =>
                    graph.add_edge(idx, to_idx, ())
                    ()
                _ => ()
    ()
    let probe = step_lr35902(Lr35902State__default_(), Lr35902Memory__default_())
    let semantic_trace = build_semantic_trace_sample()
    GameboyParityHarness { checkpoints: checkpoints, graph_nodes: graph.node_count(), graph_edges: graph.edge_count(), semantic_probe_opcode: probe.opcode, semantic_probe_cycles: probe.cycles, semantic_trace: semantic_trace }

fn build_semantic_trace_sample() -> Array<SemanticTraceSample>:
    let mut mem = Lr35902Memory__default_()
    mem.rom0[256] = 62
    ()
    mem.rom0[257] = 18
    ()
    mem.rom0[258] = 198
    ()
    mem.rom0[259] = 52
    ()
    mem.rom0[260] = 197
    ()
    mem.rom0[261] = 193
    ()
    mem.rom0[262] = 24
    ()
    mem.rom0[263] = 2
    ()
    mem.rom0[264] = 0
    ()
    mem.rom0[265] = 118
    ()
    let mut out_ = Vec__new_()
    let mut state_ = Lr35902State__default_()
    let mut memory = mem
    for step in range(0, 8):
        let before_pc = state_.pc
        let result = step_lr35902(state_, memory)
        out_.push(SemanticTraceSample { step: step, pc: before_pc, opcode: result.opcode, cycles: result.cycles })
        ()
        state_ = result.state_
        ()
        memory = result.memory
        ()
        if state_.halted:
            break
    ()
    out_

fn build_trace_artifact() -> GameboyTraceArtifact:
    let mut mem = Lr35902Memory__default_()
    mem.rom0[256] = 62
    ()
    mem.rom0[257] = 18
    ()
    mem.rom0[258] = 198
    ()
    mem.rom0[259] = 52
    ()
    mem.rom0[260] = 203
    ()
    mem.rom0[261] = 124
    ()
    mem.rom0[262] = 197
    ()
    mem.rom0[263] = 193
    ()
    mem.rom0[264] = 24
    ()
    mem.rom0[265] = 2
    ()
    mem.rom0[266] = 0
    ()
    mem.rom0[267] = 118
    ()
    let mut state_ = Lr35902State__default_()
    let mut memory = mem
    let mut frames = Vec__new_()
    for step in range(0, 16):
        let result = step_lr35902(state_, memory)
        let effect = match &result.effect:
            StepEffect::None => ("none").to_string()
            StepEffect::Halt => ("halt").to_string()
            StepEffect::PortWrite { port: port, value: value } => f"port_write:{port}={value}"
            StepEffect::Interrupt { vector: vector } => f"interrupt:{vector}"
        frames.push(TraceFrame { step: step, pc: result.state_.pc, opcode: result.opcode, cycles: result.cycles, a: result.state_.a, b: result.state_.b, c: result.state_.c, d: result.state_.d, e: result.state_.e, h: result.state_.h, l: result.state_.l, f: result.state_.f, sp: result.state_.sp, ime: result.state_.ime, halted: result.state_.halted, effect: effect })
        ()
        state_ = result.state_
        ()
        memory = result.memory
        ()
        if state_.halted:
            break
    ()
    GameboyTraceArtifact { frames: frames }

fn parse_section_header(text: String) -> Option<(String, u16, u16)>:
    let rest = (text.trim().strip_prefix("SECTION ")?).trim()
    let mut name = ("ROM0").to_string()
    match rest.find("\""):
        Some(i0) =>
            let rest2 = &rest[(i0 + 1)..]
            match rest2.find("\""):
                Some(i1) =>
                    name = rest2[..i1].to_string()
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    let up = rest.to_ascii_uppercase()
    let bank = match up.find("BANK["):
        Some(idx) =>
            let chunk = &rest[((idx + 5))..]
            match chunk.find("]"):
                Some(end) => parse_num(chunk[..end].trim()).unwrap_or(0).max(0) as u16
                _ => 0
        _ => 0
    let base = match up.find("ROM0[$"):
        Some(idx) =>
            let chunk = &rest[((idx + 6))..]
            match chunk.find("]"):
                Some(end) => parse_num(&f"${&chunk[..end]}").unwrap_or(0).max(0) as u16
                _ => 0
        _ =>
            match up.find("ROMX[$"):
                Some(idx) =>
                    let chunk = &rest[((idx + 6))..]
                    match chunk.find("]"):
                        Some(end) => parse_num(&f"${&chunk[..end]}").unwrap_or(0).max(0) as u16
                        _ => 16384
                _ => 0
    Option::Some((name, bank, base))

fn estimate_instruction_size(instr: &kain_core::AsmInstr) -> u16:
    let op = (*instr).opcode.as_str()
    let operand = (*instr).operand.unwrap_or("")
    if (((((((((((op == "RST") || (op == "RET")) || (op == "RETI")) || (op == "NOP")) || (op == "HALT")) || (op == "DAA")) || (op == "SCF")) || (op == "CCF")) || (op == "CPL")) || (op == "DI")) || (op == "EI")):
        return 1
    if ((op == "JP") || (op == "CALL")):
        return 3
    if (op == "JR"):
        return 2
    if (op == "LD"):
        if (operand.contains("[$") || operand.contains("($")):
            return 3
        if ((operand.contains("$") || operand.contains("%")) || operand.chars().any(fn(c): c.is_ascii_digit())):
            return 2
        return 1
    if (operand.contains("$") || operand.contains("%")):
        2
    else:
        1

fn build_recovery_report(input: &std::path::Path, canonical: &[CanonLine], parsed: &kain_core::AsmProgram) -> RecoveryReport:
    let mut unresolved_tokens = Vec__new_()
    let mut ambiguous_labels = Vec__new_()
    let mut seen = HashSet__new_()
    for line_ in canonical:
        let t = line_.text.trim()
        if t.is_empty():
            continue
        let ok = (((is_label_line(t) || is_directive_line(t)) || parse_data_line(t).is_some()) || parse_instruction(t, line_.canon).is_some())
        if (!ok):
            unresolved_tokens.push(RecoveryIssue { line_: line_.canon, message: f"Unrecognized canonical line: {t}" })
            ()
            ()
            ()
            ()
        if is_label_line(t):
            let label = normalize_label(t)
            if (!seen.insert(label.clone())):
                ambiguous_labels.push(RecoveryIssue { line_: line_.canon, message: f"Duplicate label '{label}'" })
                ()
    ()
    let total = canonical.len().max(1)
    let rec = canonical.len().saturating_sub(unresolved_tokens.len())
    let _ = parsed
    RecoveryReport { input: input.display().to_string(), canonical_output: ("Research/gameboy/gameboy_canonical.asm").to_string(), unresolved_tokens: unresolved_tokens, ambiguous_labels: ambiguous_labels, section_scores: [RecoverySectionScore { section: ("global").to_string(), recognized: rec, total: total, confidence: ((rec as f64) / (total as f64)) }] }

fn build_diagnostics(lines: &[CanonLine], expanded_text: String, report: &RecoveryReport) -> GameboyDiagnostics:
    let mapper = SpanMapper__new_(expanded_text)
    let line_starts = compute_line_starts(expanded_text)
    let mut diagnostics = Vec__new_()
    for issue in &(*report).unresolved_tokens:
        match issue_to_diag("error", "ASM_UNRESOLVED", issue, lines, &mapper, &line_starts):
            Some(diag) =>
                diagnostics.push(diag)
                ()
            _ => ()
    ()
    for issue in &(*report).ambiguous_labels:
        match issue_to_diag("warning", "ASM_AMBIGUOUS", issue, lines, &mapper, &line_starts):
            Some(diag) =>
                diagnostics.push(diag)
                ()
            _ => ()
    ()
    GameboyDiagnostics { diagnostics: diagnostics }

fn issue_to_diag(severity: String, code: String, issue: &RecoveryIssue, lines: &[CanonLine], mapper: &kain_core::diagnostics::SpanMapper, line_starts: &[usize]) -> Option<AsmDiagnostic>:
    if ((*issue).line_ == 0):
        return none
    let line_idx = lines.iter().position(fn(line_): (line_.canon == (*issue).line_)).or_else(fn(): (*issue).line_.checked_sub(1).filter(fn(idx): ((*idx) < lines.len())))?
    let canon = &lines[line_idx]
    let col0 = canon.text.char_indices().find_map(fn(__kain_closure_arg3): if __kain_closure_arg3.__kain_tuple_1.is_ascii_whitespace(): none else: Option::Some(__kain_closure_arg3.__kain_tuple_0)).unwrap_or(0)
    let span_start = line_starts.get(line_idx).copied().unwrap_or(0).saturating_add(col0)
    let span = Span__new_(span_start, span_start.saturating_add(1))
    let loc = mapper.span_to_location(span, "<expanded>")
    Option::Some(AsmDiagnostic { severity: severity.to_string(), code: code.to_string(), message: (*issue).message.clone(), canonical_line: canon.canon, canonical_col: loc.col, canonical_snippet: canon.text.clone(), source_file: canon.file.clone(), source_line: canon.line_ })

fn compute_line_starts(text: String) -> Array<usize>:
    let mut starts = [0]
    for selfhost_for_item in text.char_indices():
        let (idx, ch) = selfhost_for_item
        if (ch == "\n"):
            starts.push((idx + 1))
            ()
    ()
    starts

fn default_parity_trace_schema() -> kain_core::ParityTraceFrame:
    let mut registers = BTreeMap__new_()
    for reg in ["a", "b", "c", "d", "e", "h", "l", "f", "sp", "pc"]:
        registers.insert(reg.to_string(), 0)
        ()
    ()
    let mut flags = BTreeMap__new_()
    for fl in ["z", "n", "h", "c"]:
        flags.insert(fl.to_string(), false)
        ()
    ()
    kain_core::ParityTraceFrame { tick: 0, pc: 0, opcode: ("NOP").to_string(), registers: registers, flags: flags, notes: [("lr35902-schema").to_string()] }

fn is_opcode_keyword(kw: String) -> Bool:
    match kw:
        "ADC" => true
        "ADD" => true
        "AND" => true
        "BIT" => true
        "CALL" => true
        "CCF" => true
        "CP" => true
        "CPL" => true
        "DAA" => true
        "DEC" => true
        "DI" => true
        "EI" => true
        "HALT" => true
        "INC" => true
        "JP" => true
        "JR" => true
        "LD" => true
        "LDD" => true
        "LDH" => true
        "LDI" => true
        "NOP" => true
        "OR" => true
        "POP" => true
        "PUSH" => true
        "RES" => true
        "RET" => true
        "RETI" => true
        "RL" => true
        "RLA" => true
        "RLC" => true
        "RLCA" => true
        "RR" => true
        "RRA" => true
        "RRC" => true
        "RRCA" => true
        "RST" => true
        "SBC" => true
        "SCF" => true
        "SET" => true
        "SLA" => true
        "SRA" => true
        "SRL" => true
        "STOP" => true
        "SUB" => true
        "SWAP" => true
        "XOR" => true
        _ => false

