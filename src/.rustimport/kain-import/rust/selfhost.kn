use super::parser

use super::RustTransformer

use crate::common::language_schema::KainLanguageSchema

use crate::ImportError

use crate::Result

use kain_core::ast::Item

use kain_core::ast::Mod

use kain_core::ast::Program

use kain_core::ast::Visibility

use serde::Deserialize

use serde::Serialize

use std::collections::BTreeMap

use std::collections::HashSet

use std::path::Path

use std::path::PathBuf

@derive(Debug, Clone)
pub struct RustSelfHostOptions:
    include_tests: Bool
    allow_external_mod_decls: Bool
    schema: KainLanguageSchema
    allowlist: SelfHostAllowlist
    module_map: Option<SelfHostModuleMap>

impl Default for RustSelfHostOptions:
    fn default_() -> RustSelfHostOptions:
        RustSelfHostOptions { include_tests: false, allow_external_mod_decls: true, schema: KainLanguageSchema__bootstrap_core_schema(), allowlist: SelfHostAllowlist__default_(), module_map: none }


impl RustSelfHostOptions:
    pub fn from_inventory_dir(inventory_dir: &std::path::Path) -> Result<RustSelfHostOptions, Error>:
        let allowlist_path = inventory_dir.join("selfhost_allowlist.json")
        let module_map_path = inventory_dir.join("module_map.json")
        let allowlist: SelfHostAllowlist = serde_json__from_str(&std__fs__read_to_string(&allowlist_path).map_err(ImportError__IoError)?).map_err(fn(e): ImportError::TransformError(f"failed to parse {allowlist_path.display()}: {e}"))?
        let module_map: SelfHostModuleMap = serde_json__from_str(&std__fs__read_to_string(&module_map_path).map_err(ImportError__IoError)?).map_err(fn(e): ImportError::TransformError(f"failed to parse {module_map_path.display()}: {e}"))?
        Result::Ok(RustSelfHostOptions { allow_external_mod_decls: true, schema: KainLanguageSchema__bootstrap_core_schema(), allowlist: allowlist, module_map: Option::Some(module_map), ..RustSelfHostOptions__default_() })


@derive(Debug, Clone)
pub struct RustModuleNode:
    module_name: String
    file_path: std::path::PathBuf

@derive(Debug, Clone)
pub struct RustCrateGraph:
    crate_root: std::path::PathBuf
    modules: Array<RustModuleNode>
    entry_points: Map<String, std::path::PathBuf>

impl RustCrateGraph:
    pub fn discover(crate_root: &std::path::Path, options: &RustSelfHostOptions) -> Result<RustCrateGraph, Error>:
        let mut modules = Vec__new_()
        let mut entry_points = BTreeMap__new_()
        match &(*options).module_map:
            Some(module_map) =>
                match module_map.find_crate(crate_root):
                    Some(crate_spec) =>
                        collect_modules_from_spec(crate_root, crate_spec, options, &mut modules, &mut entry_points)?
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        collect_modules(crate_root, crate_root, options, &mut modules, &mut entry_points)?
                        ()
                        ()
                        ()
                        ()
                ()
            _ =>
                collect_modules(crate_root, crate_root, options, &mut modules, &mut entry_points)?
                ()
                ()
                ()
                ()
        modules.sort_by(fn(a, b): a.file_path.cmp(&b.file_path))
        ()
        Result::Ok(RustCrateGraph { crate_root: crate_root.to_path_buf(), modules: modules, entry_points: entry_points })


@derive(Debug, Clone)
pub struct RustSelfHostImportResult:
    program: kain_core::ast::Program
    module_programs: Array<RustSelfHostModuleProgram>
    diagnostics: Array<String>
    rejected: Bool
    graph: RustCrateGraph

@derive(Debug, Clone)
pub struct RustSelfHostModuleProgram:
    module: RustModuleNode
    program: kain_core::ast::Program

pub fn import_rust_selfhost_dir_detailed(crate_root: &std::path::Path, options: &RustSelfHostOptions) -> Result<RustSelfHostImportResult, Error>:
    let graph = RustCrateGraph__discover(crate_root, options)?
    let mut module_programs = Vec__new_()
    let mut diagnostics = Vec__new_()
    for module in &graph.modules:
        let source = std__fs__read_to_string(&module.file_path).map_err(ImportError__IoError)?
        let file = parser__parse_rust(&source, &module.file_path)?
        let mut tx = RustTransformer__with_options(options.transform_options())
        let program = tx.transform(file)?
        diagnostics.extend(tx.diagnostics.into_iter().filter(fn(diag): (!is_allowed_diagnostic(diag, options))))
        ()
        module_programs.push(RustSelfHostModuleProgram { module: module.clone(), program: program })
        ()
    ()
    Result::Ok(RustSelfHostImportResult { program: build_selfhost_program(crate_root, &module_programs), module_programs: module_programs, rejected: (!diagnostics.is_empty()), diagnostics: diagnostics, graph: graph })

pub fn import_rust_selfhost_dir(crate_root: &std::path::Path, options: &RustSelfHostOptions) -> Result<kain_core::ast::Program, Error>:
    let result = import_rust_selfhost_dir_detailed(crate_root, options)?
    if result.rejected:
        return Result::Err(ImportError::UnsupportedFeature("self-host import rejected {result.diagnostics.len()} diagnostic(s):\n{result.diagnostics.join(\"\\n\")}"))
    Result::Ok(result.program)

fn collect_modules(root: &std::path::Path, dir: &std::path::Path, options: &RustSelfHostOptions, modules: &mut Array<RustModuleNode>, entry_points: &mut Map<String, std::path::PathBuf>) -> Result<(), Error>:
    for entry in (std__fs__read_dir(dir).map_err(ImportError__IoError)?):
        let entry = entry.map_err(ImportError__IoError)?
        let path = entry.path()
        if path.is_dir():
            let name = path.file_name().and_then(fn(n): n.to_str()).unwrap_or_default()
            if ((!(*options).include_tests) && none):
                continue
            collect_modules(root, &path, options, modules, entry_points)?
            ()
            continue
        if (path.extension().and_then(fn(e): e.to_str()) != Option::Some("rs")):
            continue
        if ((!(*options).include_tests) && is_test_like_file(&path)):
            continue
        let module_name = module_name_for(root, &path)
        if (none):
            entry_points.insert(module_name.clone(), path.clone())
            ()
            ()
            ()
            ()
        modules.push(RustModuleNode { module_name: module_name, file_path: path })
        ()
    ()
    Result::Ok(())

fn collect_modules_from_spec(crate_root: &std::path::Path, spec: &SelfHostCrateSpec, options: &RustSelfHostOptions, modules: &mut Array<RustModuleNode>, entry_points: &mut Map<String, std::path::PathBuf>) -> Result<(), Error>:
    let src_dir = crate_root.join("src")
    let root_path = crate_root.join(relative_path_within_crate(&(*spec).root))
    if root_path.exists():
        entry_points.insert(("crate").to_string(), root_path.clone())
        ()
        modules.push(RustModuleNode { module_name: ("crate").to_string(), file_path: root_path })
        ()
        ()
        ()
        ()
    for module in &(*spec).root_modules:
        let direct = src_dir.join(f"{module}.rs")
        let nested = src_dir.join(module).join("mod.rs")
        let file_path = if direct.exists():
            direct
        else:
            nested
        if file_path.exists():
            modules.push(RustModuleNode { module_name: module.clone(), file_path: file_path })
            ()
    ()
    for selfhost_for_item in &(*spec).nested_modules:
        let (owner, children) = selfhost_for_item
        let owner_dir = owner.trim_end_matches("mod.rs").trim_end_matches("/").trim_end_matches("\\")
        let owner_path = src_dir.join(normalize_rel_path(owner_dir))
        for child in children:
            let direct = owner_path.join(f"{child}.rs")
            let nested = owner_path.join(child).join("mod.rs")
            let file_path = if direct.exists():
                direct
            else:
                nested
            if file_path.exists():
                modules.push(RustModuleNode { module_name: f"{owner_dir}::{child}", file_path: file_path })
                ()
    ()
    for extra in &(*spec).extra_files:
        let file_path = crate_root.join(relative_path_within_crate(extra))
        if file_path.exists():
            modules.push(RustModuleNode { module_name: module_name_for(crate_root, &file_path), file_path: file_path.clone() })
            ()
            if (none):
                entry_points.insert(module_name_for(crate_root, &file_path), file_path)
                ()
    ()
    if modules.is_empty():
        collect_modules(crate_root, crate_root, options, modules, entry_points)?
        ()
        ()
        ()
        ()
    Result::Ok(())

@derive(Default)
struct SelfHostModuleTree:
    items: Array<kain_core::ast::Item>
    children: Map<String, SelfHostModuleTree>

impl Default for SelfHostModuleTree:
    pub fn default_() -> SelfHostModuleTree:
        SelfHostModuleTree { items: Vec__new_(), children: HashMap__new_() }


fn build_selfhost_program(crate_root: &std::path::Path, module_programs: &[RustSelfHostModuleProgram]) -> kain_core::ast::Program:
    let mut root = SelfHostModuleTree__default_()
    for module_program in module_programs:
        let path = module_path_segments(crate_root, &module_program.module.file_path)
        insert_module_items(&mut root, &path, module_program.program.items.clone())
        ()
    ()
    kain_core::ast::Program { items: module_tree_into_items(root), span: Span__default_() }

fn module_path_segments(crate_root: &std::path::Path, file_path: &std::path::Path) -> Array<String>:
    let preferred_root = crate_root.join("src")
    let relative = file_path.strip_prefix(&preferred_root).or_else(fn(_): file_path.strip_prefix(crate_root)).unwrap_or(file_path)
    let mut segments = relative.iter().filter_map(fn(part): part.to_str()).map(str__to_string).collect()
    match segments.last_mut():
        Some(last) =>
            match last.as_str():
                "lib.rs" =>
                    segments.pop()
                    ()
                    ()
                    ()
                    ()
                "main.rs" =>
                    segments.pop()
                    ()
                    ()
                    ()
                    ()
                "mod.rs" =>
                    segments.pop()
                    ()
                    ()
                    ()
                    ()
                _ if last.ends_with(".rs") =>
                    (*last) = last.trim_end_matches(".rs").to_string()
                    ()
                    ()
                    ()
                    ()
                _ => ()
            ()
        _ =>
            ()
            ()
    segments

fn insert_module_items(tree: &mut SelfHostModuleTree, path: &[String], items: Array<kain_core::ast::Item>):
    if path.is_empty():
        (*tree).items.extend(items)
        ()
        return
    let child = (*tree).children.entry(path[0].clone()).or_default()
    insert_module_items(child, &path[1..], items)
    ()

fn module_tree_into_items(tree: SelfHostModuleTree) -> Array<kain_core::ast::Item>:
    let mut items = tree.items
    for selfhost_for_item in tree.children:
        let (name, child) = selfhost_for_item
        items.push(kain_core__ast__Item::Mod(kain_core::ast::Mod { name: name, inline_: Option::Some(module_tree_into_items(child)), visibility: kain_core__ast__Visibility__Public, span: Span__default_() }))
        ()
    ()
    items

fn module_name_for(root: &std::path::Path, file: &std::path::Path) -> String:
    let relative = file.strip_prefix(root).unwrap_or(file)
    let mut parts = relative.iter().filter_map(fn(part): part.to_str()).map(str__to_string).collect()
    match parts.last_mut():
        Some(last) =>
            if (last == "mod.rs"):
                (*last) = ("mod").to_string()
                ()
                ()
                ()
                ()
            elif last.ends_with(".rs"):
                (*last) = last.trim_end_matches(".rs").to_string()
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    parts.join("::")

fn is_test_like_file(path: &std::path::Path) -> Bool:
    path.file_name().and_then(fn(n): n.to_str()).is_some_and(fn(name): (name.ends_with("_test.rs") || name.ends_with("_tests.rs")))

fn is_allowed_diagnostic(diag: String, options: &RustSelfHostOptions) -> Bool:
    let diag_class = classify_diagnostic(diag)
    if is_always_fatal_diagnostic_class(diag_class):
        return false
    if (*options).allowlist.hard_fail_conditions.iter().any(fn(marker): marker_matches_diagnostic(marker, diag, diag_class)):
        return false
    if (*options).allowlist.phase1_acceptable_diagnostics.iter().any(fn(marker): marker_matches_diagnostic(marker, diag, diag_class)):
        return true
    if ((*options).allow_external_mod_decls && (diag_class == Option::Some("external_mod_decl"))):
        return true
    false

fn is_always_fatal_diagnostic_class(diag_class: Option<String>) -> Bool:
    match diag_class:
        Some("dyn_trait_lowering") => true
        Some("trait_object_lowering") => true
        Some("array_repeat_lowering") => true
        Some("macro_direct_lowering_miss") => true
        Some("macro_policy_rejected") => true
        Some("unsupported_expr_lowering") => true
        Some("unsupported_literal_lowering") => true
        Some("unsupported_pattern_lowering") => true
        _ => false

fn marker_matches_diagnostic(marker: String, diag: String, diag_class: Option<String>) -> Bool:
    let marker = marker.trim()
    if marker.is_empty():
        return false
    if diag.contains(marker):
        return true
    match marker_class(marker):
        Some(marker_class) => (diag_class == Option::Some(marker_class))
        None => false

fn marker_class(marker: String) -> Option<String>:
    let normalized = marker.trim().to_ascii_lowercase()
    match normalized.strip_prefix("class:"):
        Some(value) => return known_diagnostic_class(value.trim())
        _ =>
            ()
            ()
    if normalized.contains("external file"):
        return Option::Some("external_mod_decl")
    if (normalized.contains("trait object") || normalized.contains("dyn")):
        return Option::Some("trait_object_lowering")
    if normalized.contains("impl trait"):
        return Option::Some("impl_trait_lowering")
    if normalized.contains("array repeat"):
        return Option::Some("array_repeat_lowering")
    if ((normalized.contains("direct-lowering macro") || normalized.contains("lowered directly")) || normalized.contains("without explicit lowering policy")):
        return Option::Some("macro_direct_lowering_miss")
    if (normalized.contains("rejected by self-host policy") || normalized.contains("imported as plain text without metadata")):
        return Option::Some("macro_policy_rejected")
    if (((((((((normalized.contains("unsafe trait") || normalized.contains("auto trait")) || normalized.contains("supertraits lowered")) || normalized.contains("lifetime supertrait")) || normalized.contains("unsupported supertrait bound")) || normalized.contains("trait method")) || normalized.contains("impl method")) || normalized.contains("associated type")) || normalized.contains("associated const")) || normalized.contains("where-clause skipped")):
        return Option::Some("trait_surface_lowering")
    if normalized.contains("unsupported expression kind"):
        return Option::Some("unsupported_expr_lowering")
    if normalized.contains("closure pattern binding lowered lossy"):
        return Option::Some("closure_pattern_lowering")
    if normalized.contains("unsupported literal lowered to none"):
        return Option::Some("unsupported_literal_lowering")
    if normalized.contains("unsupported pattern lowered to wildcard"):
        return Option::Some("unsupported_pattern_lowering")
    none

fn classify_diagnostic(diag: String) -> Option<String>:
    match extract_inline_class_marker(diag):
        Some(class_) => return Option::Some(class_)
        _ =>
            ()
            ()
    let normalized = diag.to_ascii_lowercase()
    if normalized.contains("external file"):
        return Option::Some("external_mod_decl")
    if normalized.contains("dyn trait"):
        return Option::Some("trait_object_lowering")
    if normalized.contains("impl trait"):
        return Option::Some("impl_trait_lowering")
    if normalized.contains("array repeat"):
        return Option::Some("array_repeat_lowering")
    if (normalized.contains("could not be lowered directly") || normalized.contains("survive into imported self-host output")):
        return Option::Some("macro_direct_lowering_miss")
    if (normalized.contains("rejected by self-host policy") || normalized.contains("imported as plain text without metadata")):
        return Option::Some("macro_policy_rejected")
    if (((((((((normalized.contains("unsafe trait") || normalized.contains("auto trait")) || normalized.contains("supertraits lowered")) || normalized.contains("lifetime supertrait")) || normalized.contains("unsupported supertrait bound")) || normalized.contains("trait method")) || normalized.contains("impl method")) || normalized.contains("associated type")) || normalized.contains("associated const")) || normalized.contains("where-clause skipped")):
        return Option::Some("trait_surface_lowering")
    if normalized.contains("unsupported expression kind"):
        return Option::Some("unsupported_expr_lowering")
    if normalized.contains("closure pattern binding lowered lossy"):
        return Option::Some("closure_pattern_lowering")
    if normalized.contains("unsupported literal lowered to none"):
        return Option::Some("unsupported_literal_lowering")
    if normalized.contains("unsupported pattern lowered to wildcard"):
        return Option::Some("unsupported_pattern_lowering")
    none

fn extract_inline_class_marker(diag: String) -> Option<String>:
    let marker = "class:"
    let start = diag.find(marker)?
    let value = diag[(start + marker.len())..].chars().take_while(fn(ch): ((ch.is_ascii_lowercase() || ch.is_ascii_digit()) || ((*ch) == "_"))).collect()
    if value.is_empty():
        return none
    known_diagnostic_class(&value)

fn known_diagnostic_class(value: String) -> Option<String>:
    match value:
        "external_mod_decl" => Option::Some("external_mod_decl")
        "dyn_trait_lowering" => Option::Some("trait_object_lowering")
        "trait_object_lowering" => Option::Some("trait_object_lowering")
        "impl_trait_lowering" => Option::Some("impl_trait_lowering")
        "array_repeat_lowering" => Option::Some("array_repeat_lowering")
        "macro_direct_lowering_miss" => Option::Some("macro_direct_lowering_miss")
        "macro_policy_rejected" => Option::Some("macro_policy_rejected")
        "trait_surface_lowering" => Option::Some("trait_surface_lowering")
        "closure_pattern_lowering" => Option::Some("closure_pattern_lowering")
        "unsupported_expr_lowering" => Option::Some("unsupported_expr_lowering")
        "unsupported_literal_lowering" => Option::Some("unsupported_literal_lowering")
        "unsupported_pattern_lowering" => Option::Some("unsupported_pattern_lowering")
        _ => none

fn normalize_rel_path(path: String) -> std::path::PathBuf:
    let trimmed = path.strip_prefix("crates/").unwrap_or(path)
    PathBuf__from(trimmed.replace("/", "\\"))

fn relative_path_within_crate(path: String) -> std::path::PathBuf:
    let normalized = path.replace("\\", "/")
    match normalized.find("/src/"):
        Some(idx) => return PathBuf__from(normalized[(idx + 1)..].replace("/", "\\"))
        _ =>
            ()
            ()
    if ((normalized == "src/lib.rs") || (normalized == "src/main.rs")):
        return PathBuf__from(normalized.replace("/", "\\"))
    PathBuf__from(normalized.replace("/", "\\"))

@derive(Debug, Clone, Default, serde__Serialize, serde__Deserialize)
pub struct SelfHostAllowlist:
    initial_slice: Array<String>
    phase1_acceptable_diagnostics: Array<String>
    hard_fail_conditions: Array<String>
    macro_policy: SelfHostMacroPolicy
    trait_object_usage_count: usize

impl Default for SelfHostAllowlist:
    pub fn default_() -> SelfHostAllowlist:
        SelfHostAllowlist { initial_slice: Vec__new_(), phase1_acceptable_diagnostics: Vec__new_(), hard_fail_conditions: Vec__new_(), macro_policy: SelfHostMacroPolicy__default_(), trait_object_usage_count: 0 }


@derive(Debug, Clone, Default, serde__Serialize, serde__Deserialize)
pub struct SelfHostMacroPolicy:
    lower_directly: Array<String>
    preserve: Array<String>
    reject: Array<String>

impl Default for SelfHostMacroPolicy:
    pub fn default_() -> SelfHostMacroPolicy:
        SelfHostMacroPolicy { lower_directly: Vec__new_(), preserve: Vec__new_(), reject: Vec__new_() }


@derive(Debug, Clone, Default, serde__Serialize, serde__Deserialize)
pub struct SelfHostModuleMap:
    crates: Map<String, SelfHostCrateSpec>
    initial_slice: Array<String>
    phase2_slice: Array<String>

impl Default for SelfHostModuleMap:
    pub fn default_() -> SelfHostModuleMap:
        SelfHostModuleMap { crates: HashMap__new_(), initial_slice: Vec__new_(), phase2_slice: Vec__new_() }


impl SelfHostModuleMap:
    fn find_crate(_self: &SelfHostModuleMap, crate_root: &std::path::Path) -> Option<&SelfHostCrateSpec>:
        let crate_name = crate_root.file_name().and_then(fn(n): n.to_str())?
        (*_self).crates.get(crate_name)


@derive(Debug, Clone, Default, serde__Serialize, serde__Deserialize)
pub struct SelfHostCrateSpec:
    root: String
    root_modules: Array<String>
    nested_modules: Map<String, Array<String>>
    extra_files: Array<String>
    initial_selfhost_candidate: Bool

impl Default for SelfHostCrateSpec:
    pub fn default_() -> SelfHostCrateSpec:
        SelfHostCrateSpec { root: String__new_(), root_modules: Vec__new_(), nested_modules: HashMap__new_(), extra_files: Vec__new_(), initial_selfhost_candidate: false }


impl RustSelfHostOptions:
    fn transform_options(_self: &RustSelfHostOptions) -> transformer::RustTransformOptions:
        transformer::RustTransformOptions { strict_selfhost: true, macro_policy: transformer::RustMacroPolicy { lower_directly: (*_self).allowlist.macro_policy.lower_directly.iter().cloned().collect(), preserve: (*_self).allowlist.macro_policy.preserve.iter().cloned().collect(), reject: (*_self).allowlist.macro_policy.reject.iter().cloned().collect() } }


