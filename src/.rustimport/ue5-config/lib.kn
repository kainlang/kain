use anyhow::Result

use kain_core::ast::Program

@doc(doc = " Generated file output")
@derive(Debug, Clone, PartialEq)
pub struct GeneratedFile:
    path: String
    content: String

@doc(doc = " Generate UE5 configuration code from a KAIN program (AST entry point)")
pub fn generate_config_code(program: &kain_core::ast::Program, plugin_name: String, _module_api: String) -> Result<Array<GeneratedFile>, Error>:
    use crate::developer_settings_codegen::generate

    use crate::parser::parse_config_attribute

    use kain_core::ast::Item

    let mut generated_files = Vec__new_()
    for item in &(*program).items:
        match item:
            kain_core__ast__Item::Struct(struct_def) =>
                match (parser__parse_config_attribute(struct_def)?):
                    Some(config_struct) =>
                        let output = developer_settings_codegen__generate(&config_struct, plugin_name)?
                        let struct_name = &config_struct.name
                        generated_files.push(GeneratedFile { path: f"Source/Public/{struct_name}.h", content: output.header })
                        ()
                        generated_files.push(GeneratedFile { path: f"Source/Private/{struct_name}.cpp", content: output.source })
                        ()
                    _ => ()
            _ => ()
    ()
    Result::Ok(generated_files)

@doc(doc = " Generate UE5 configuration code from a TypedProgram (pipeline entry point)")
@doc(doc = "")
@doc(doc = " This is the entry point used by the CLI pipeline which works with")
@doc(doc = " TypedProgram after type-checking. Extracts struct ASTs from TypedStruct")
@doc(doc = " items and delegates to the same codegen logic.")
pub fn generate_config_code_typed(program: &kain_core::types::TypedProgram, plugin_name: String, module_api: String) -> Result<Array<GeneratedFile>, Error>:
    use crate::developer_settings_codegen::generate

    use crate::parser::parse_config_attribute

    use kain_core::types::TypedItem

    let mut generated_files = Vec__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(typed_struct) =>
                match (parser__parse_config_attribute(&typed_struct.ast)?):
                    Some(config_struct) =>
                        let output = developer_settings_codegen__generate(&config_struct, plugin_name)?
                        let struct_name = &config_struct.name
                        generated_files.push(GeneratedFile { path: f"Source/Public/{struct_name}.h", content: output.header })
                        ()
                        generated_files.push(GeneratedFile { path: f"Source/Private/{struct_name}.cpp", content: output.source })
                        ()
                        let ini_file_name = config_struct.get_ini_file()
                        match ini_file_generator__generate_ini_section(&config_struct, plugin_name):
                            Ok(ini_content) =>
                                if (!ini_content.is_empty()):
                                    generated_files.push(GeneratedFile { path: f"Config/{ini_file_name}", content: ini_content })
                                    ()
                            _ => ()
                    _ => ()
            _ => ()
    ()
    let _ = module_api
    Result::Ok(generated_files)

