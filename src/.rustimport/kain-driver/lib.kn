@cfg(feature = "ue5")
fn find_metadata_dir() -> std::path::PathBuf:
    match std__env__var_("KAIN_METADATA_DIR"):
        Ok(explicit_) =>
            let candidate = PathBuf__from(explicit_)
            if candidate.exists():
                return candidate
            ()
        _ =>
            ()
            ()
    let suffixes = [Path__new_("unreal").join("metadata"), Path__new_("Kain").join("unreal").join("metadata")]
    match std__env__var_("KAIN_ROOT"):
        Ok(root) =>
            let base = PathBuf__from(root)
            for suffix in &suffixes:
                let candidate = base.join(suffix)
                if candidate.exists():
                    return candidate
            ()
            ()
        _ =>
            ()
            ()
    match std__env__current_dir():
        Ok(mut dir) =>
            for _ in range(0, 10):
                for suffix in &suffixes:
                    let candidate = dir.join(suffix)
                    if candidate.exists():
                        return candidate
                ()
                match dir.parent():
                    Some(parent) => dir = parent.to_path_buf()
                    None => break
            ()
            ()
        _ =>
            ()
            ()
    std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from(".")).join(Path__new_("unreal").join("metadata"))

