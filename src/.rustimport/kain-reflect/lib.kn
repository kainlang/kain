use std::collections::BTreeMap

pub type AttrMap = Map<String, String>

pub enum PrimitiveType:
    Unit
    Bool
    Int
    Float
    String

pub enum TypeRef:
    Primitive(PrimitiveType)
    Named(String)
    Array(Box<TypeRef>)
    Option(Box<TypeRef>)

impl TypeRef:
    pub fn render_kain(_self: &TypeRef) -> String:
        match *_self:
            TypeRef::Primitive(primitive) => primitive.render_kain().to_string()
            TypeRef::Named(name) => name.clone()
            TypeRef::Array(inner) => f"Array<{inner.render_kain()}>"
            TypeRef::Option(inner) => f"Option<{inner.render_kain()}>"


impl PrimitiveType:
    pub fn render_kain(_self: &PrimitiveType) -> String:
        match *_self:
            PrimitiveType::Unit => "Unit"
            PrimitiveType::Bool => "Bool"
            PrimitiveType::Int => "Int"
            PrimitiveType::Float => "Float"
            PrimitiveType::String => "String"


@derive(Debug, Clone, PartialEq, Eq)
pub struct FieldSchema:
    name: String
    ty: TypeRef
    attrs: AttrMap

impl FieldSchema:
    pub fn new_(name: impl Into<String>, ty: TypeRef) -> FieldSchema:
        FieldSchema { name: name.into(), ty: ty, attrs: AttrMap__new_() }

    pub fn with_attr(_self: FieldSchema, key: impl Into<String>, value: impl Into<String>) -> FieldSchema:
        _self.attrs.insert(key.into(), value.into())
        ()
        _self


pub enum VariantShape:
    Unit
    Tuple
    Named

@derive(Debug, Clone, PartialEq, Eq)
pub struct VariantSchema:
    name: String
    shape: VariantShape
    fields: Array<FieldSchema>
    attrs: AttrMap

impl VariantSchema:
    pub fn new_(name: impl Into<String>, shape: VariantShape, fields: Array<FieldSchema>) -> VariantSchema:
        VariantSchema { name: name.into(), shape: shape, fields: fields, attrs: AttrMap__new_() }

    pub fn with_attr(_self: VariantSchema, key: impl Into<String>, value: impl Into<String>) -> VariantSchema:
        _self.attrs.insert(key.into(), value.into())
        ()
        _self


pub enum TypeKind:
    Struct { fields: Array<FieldSchema> }
    Enum { variants: Array<VariantSchema> }
    Transparent { inner: TypeRef }

@derive(Debug, Clone, PartialEq, Eq)
pub struct TypeSchema:
    name: String
    rust_name: String
    kind: TypeKind
    attrs: AttrMap

impl TypeSchema:
    pub fn new_(name: impl Into<String>, rust_name: impl Into<String>, kind: TypeKind) -> TypeSchema:
        TypeSchema { name: name.into(), rust_name: rust_name.into(), kind: kind, attrs: AttrMap__new_() }

    pub fn with_attr(_self: TypeSchema, key: impl Into<String>, value: impl Into<String>) -> TypeSchema:
        _self.attrs.insert(key.into(), value.into())
        ()
        _self

    pub fn render_kain(_self: &TypeSchema) -> String:
        match &(*_self).kind:
            TypeKind::Struct { fields: fields } =>
                if fields.is_empty():
                    f"struct {(*_self).name}:\n"
                else:
                    let mut out_ = f"struct {(*_self).name}:\n"
                    for field in fields:
                        out_.push_str(&f"    {field.name}: {field.ty.render_kain()}\n")
                        ()
                    ()
                    out_
            TypeKind::Enum { variants: variants } =>
                let mut out_ = f"enum {(*_self).name}:\n"
                for variant in variants:
                    match variant.shape:
                        VariantShape::Unit =>
                            out_.push_str(&f"    {variant.name}\n")
                            ()
                        VariantShape::Tuple =>
                            let fields = variant.fields.iter().map(fn(field): field.ty.render_kain()).collect().join(", ")
                            out_.push_str(&f"    {variant.name}({fields})\n")
                            ()
                        VariantShape::Named =>
                            let fields = variant.fields.iter().map(fn(field): field.ty.render_kain()).collect().join(", ")
                            out_.push_str(&f"    {variant.name}({fields})\n")
                            ()
                ()
                out_
            TypeKind::Transparent { inner: inner } => f"type {(*_self).name} = {inner.render_kain()}\n"


pub trait KainReflect:
    fn schema() -> TypeSchema:
        let __selfhost_empty = none
    fn register_(registry: &mut TypeRegistry):
        registry.register_schema(Self___schema())
        ()

pub trait StaticTypeRef:
    fn type_ref() -> TypeRef:
        let __selfhost_empty = none

@derive(Debug, Clone, Default)
pub struct TypeRegistry:
    schemas: Map<String, TypeSchema>

impl Default for TypeRegistry:
    pub fn default_() -> TypeRegistry:
        TypeRegistry { schemas: HashMap__new_() }


impl TypeRegistry:
    pub fn new_() -> TypeRegistry:
        TypeRegistry__default_()

    pub fn register_<T>(_self: &mut TypeRegistry):
        T__register_(*_self)
        ()

    pub fn register_schema(_self: &mut TypeRegistry, schema: TypeSchema) -> Option<TypeSchema>:
        (*_self).schemas.insert(schema.name.clone(), schema)

    pub fn get(_self: &TypeRegistry, name: String) -> Option<&TypeSchema>:
        (*_self).schemas.get(name)

    pub fn iter(_self: &TypeRegistry) -> impl Iterator:
        (*_self).schemas.iter()

    pub fn schemas(_self: &TypeRegistry) -> impl Iterator:
        (*_self).schemas.values()

    pub fn len(_self: &TypeRegistry) -> usize:
        (*_self).schemas.len()

    pub fn is_empty(_self: &TypeRegistry) -> Bool:
        (*_self).schemas.is_empty()

    pub fn render_kain_prelude(_self: &TypeRegistry) -> String:
        let mut out_ = String__new_()
        for schema in (*_self).schemas():
            out_.push_str(&schema.render_kain())
            ()
            if (!out_.ends_with("\n\n")):
                out_.push("\n")
                ()
        ()
        out_


impl StaticTypeRef for ():
    fn type_ref() -> TypeRef:
        TypeRef::Primitive(PrimitiveType__Unit)


impl StaticTypeRef for Bool:
    fn type_ref() -> TypeRef:
        TypeRef::Primitive(PrimitiveType__Bool)


impl StaticTypeRef for String:
    fn type_ref() -> TypeRef:
        TypeRef::Primitive(PrimitiveType__String)


impl StaticTypeRef for String:
    fn type_ref() -> TypeRef:
        TypeRef::Primitive(PrimitiveType__String)


impl<T> StaticTypeRef for Array<T>:
    fn type_ref() -> TypeRef:
        TypeRef::Array(Box__new_(T__type_ref()))


impl<T> StaticTypeRef for Option<T>:
    fn type_ref() -> TypeRef:
        TypeRef::Option(Box__new_(T__type_ref()))


impl<T> StaticTypeRef for T:
    fn type_ref() -> TypeRef:
        TypeRef::Named(T__schema().name)


