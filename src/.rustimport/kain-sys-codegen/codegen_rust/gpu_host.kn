use crate::codegen_rust::gpu_artifacts::collect_gpu_artifacts

use crate::codegen_rust::gpu_artifacts::RustGpuArtifactOutput

use crate::codegen_rust::gpu_artifacts::RustGpuBindingKind

use crate::codegen_rust::gpu_artifacts::RustGpuShaderStage

use kain_core::types::TypedProgram

pub fn generate_gpu_host(program: &kain_core::types::TypedProgram) -> String:
    let artifacts = codegen_rust__gpu_artifacts__collect_gpu_artifacts(program)
    render_gpu_host(&artifacts)

pub fn render_gpu_host(artifacts: &RustGpuArtifactOutput) -> String:
    let mut out_ = String__new_()
    out_.push_str("#![allow(dead_code)]\n")
    ()
    out_.push_str("#![allow(unused_variables)]\n\n")
    ()
    out_.push_str("pub mod kain_gpu_generated {\n")
    ()
    out_.push_str("    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n")
    ()
    out_.push_str("    pub enum ShaderStage {\n")
    ()
    out_.push_str("        Vertex,\n")
    ()
    out_.push_str("        Fragment,\n")
    ()
    out_.push_str("        Compute,\n")
    ()
    out_.push_str("        Surface,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n")
    ()
    out_.push_str("    pub enum BindingKind {\n")
    ()
    out_.push_str("        StorageBuffer,\n")
    ()
    out_.push_str("        Sampler2D,\n")
    ()
    out_.push_str("        Uniform,\n")
    ()
    out_.push_str("        LocalSize,\n")
    ()
    out_.push_str("        SpecializationConstant,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone, Copy)]\n")
    ()
    out_.push_str("    pub struct BindingDesc {\n")
    ()
    out_.push_str("        pub name: &'static str,\n")
    ()
    out_.push_str("        pub binding: u32,\n")
    ()
    out_.push_str("        pub descriptor_set: u32,\n")
    ()
    out_.push_str("        pub ty: &'static str,\n")
    ()
    out_.push_str("        pub kind: BindingKind,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone, Copy)]\n")
    ()
    out_.push_str("    pub struct BindingLayoutEntry {\n")
    ()
    out_.push_str("        pub binding: u32,\n")
    ()
    out_.push_str("        pub descriptor_set: u32,\n")
    ()
    out_.push_str("        pub kind: BindingKind,\n")
    ()
    out_.push_str("        pub ty: &'static str,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone, Copy)]\n")
    ()
    out_.push_str("    pub struct DispatchSize {\n")
    ()
    out_.push_str("        pub x: u32,\n")
    ()
    out_.push_str("        pub y: u32,\n")
    ()
    out_.push_str("        pub z: u32,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone)]\n")
    ()
    out_.push_str("    pub struct BuiltinInputParam {\n")
    ()
    out_.push_str("        pub name: &'static str,\n")
    ()
    out_.push_str("        pub ty: &'static str,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone)]\n")
    ()
    out_.push_str("    pub struct UniformParam {\n")
    ()
    out_.push_str("        pub ty: &'static str,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone)]\n")
    ()
    out_.push_str("    pub struct StorageBufferParam {\n")
    ()
    out_.push_str("        pub ty: &'static str,\n")
    ()
    out_.push_str("        pub read_only: bool,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone)]\n")
    ()
    out_.push_str("    pub struct Sampler2DParam {\n")
    ()
    out_.push_str("        pub ty: &'static str,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone)]\n")
    ()
    out_.push_str("    pub struct LocalSizeParam {\n")
    ()
    out_.push_str("        pub axis: &'static str,\n")
    ()
    out_.push_str("        pub default_value: u32,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone)]\n")
    ()
    out_.push_str("    pub struct SpecializationConstantParam {\n")
    ()
    out_.push_str("        pub ty: &'static str,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone)]\n")
    ()
    out_.push_str("    pub struct DispatchCall<'a, TParams> {\n")
    ()
    out_.push_str("        pub entry_point: &'static str,\n")
    ()
    out_.push_str("        pub stage: ShaderStage,\n")
    ()
    out_.push_str("        pub size: DispatchSize,\n")
    ()
    out_.push_str("        pub params: &'a TParams,\n")
    ()
    out_.push_str("    }\n\n")
    ()
    out_.push_str("    #[derive(Debug, Clone, Copy)]\n")
    ()
    out_.push_str("    pub struct ShaderDesc {\n")
    ()
    out_.push_str("        pub name: &'static str,\n")
    ()
    out_.push_str("        pub stage: ShaderStage,\n")
    ()
    out_.push_str("        pub entry_point: &'static str,\n")
    ()
    out_.push_str("        pub output_type: &'static str,\n")
    ()
    out_.push_str("        pub bindings: &'static [BindingDesc],\n")
    ()
    out_.push_str("    }\n\n")
    ()
    for shader_ in &(*artifacts).shaders:
        let shader_mod = sanitize_ident(&shader_.name)
        out_.push_str(&"    pub mod {shader_mod} {\n")
        ()
        out_.push_str("        use super::{\n")
        ()
        out_.push_str("            BindingDesc, BindingKind, BindingLayoutEntry, BuiltinInputParam, DispatchCall,\n")
        ()
        out_.push_str("            DispatchSize, LocalSizeParam, Sampler2DParam, ShaderDesc, ShaderStage,\n")
        ()
        out_.push_str("            SpecializationConstantParam, StorageBufferParam, UniformParam,\n")
        ()
        out_.push_str("        };\n\n")
        ()
        out_.push_str("        #[derive(Debug, Clone)]\n")
        ()
        out_.push_str("        pub struct Params {\n")
        ()
        for input in &shader_.inputs:
            out_.push_str(&f"            pub {sanitize_ident(&input.name)}: BuiltinInputParam,\n")
            ()
        ()
        for binding in &shader_.bindings:
            out_.push_str(&f"            pub {sanitize_ident(&binding.name)}: {binding_param_type(binding.kind)},\n")
            ()
        ()
        out_.push_str("        }\n\n")
        ()
        out_.push_str("        impl Default for Params {\n")
        ()
        out_.push_str("            fn default() -> Self {\n")
        ()
        out_.push_str("                Self {\n")
        ()
        for input in &shader_.inputs:
            out_.push_str(&"                    {sanitize_ident(&input.name)}: BuiltinInputParam { name: \"{input.name}\", ty: \"{input.ty}\" },\n")
            ()
        ()
        for binding in &shader_.bindings:
            out_.push_str(&f"                    {sanitize_ident(&binding.name)}: {default_binding_initializer(binding)},\n")
            ()
        ()
        out_.push_str("                }\n")
        ()
        out_.push_str("            }\n")
        ()
        out_.push_str("        }\n\n")
        ()
        out_.push_str("        pub const BINDINGS: &[BindingDesc] = &[\n")
        ()
        for binding in &shader_.bindings:
            out_.push_str("            BindingDesc { ")
            ()
            out_.push_str(&f"name: \"{binding.name}\", ")
            ()
            out_.push_str(&f"binding: {binding.binding}, ")
            ()
            out_.push_str(&f"descriptor_set: {binding.descriptor_set}, ")
            ()
            out_.push_str(&f"ty: \"{binding.ty}\", ")
            ()
            out_.push_str(&f"kind: BindingKind::{binding_kind_name(binding.kind)}, ")
            ()
            out_.push_str("},\n")
            ()
        ()
        out_.push_str("        ];\n\n")
        ()
        out_.push_str("        pub const SHADER: ShaderDesc = ShaderDesc { ")
        ()
        out_.push_str(&f"name: \"{shader_.name}\", ")
        ()
        out_.push_str(&f"stage: ShaderStage::{stage_name(shader_.stage)}, ")
        ()
        out_.push_str(&f"entry_point: \"{shader_.entry_point}\", ")
        ()
        out_.push_str(&f"output_type: \"{shader_.output_type}\", ")
        ()
        out_.push_str("bindings: BINDINGS, ")
        ()
        out_.push_str("};\n\n")
        ()
        out_.push_str("        pub fn descriptor() -> &'static ShaderDesc {\n")
        ()
        out_.push_str("            &SHADER\n")
        ()
        out_.push_str("        }\n\n")
        ()
        out_.push_str("        pub fn descriptor_layout() -> Vec<BindingLayoutEntry> {\n")
        ()
        out_.push_str("            BINDINGS\n")
        ()
        out_.push_str("                .iter()\n")
        ()
        out_.push_str("                .map(|binding| BindingLayoutEntry {\n")
        ()
        out_.push_str("                    binding: binding.binding,\n")
        ()
        out_.push_str("                    descriptor_set: binding.descriptor_set,\n")
        ()
        out_.push_str("                    kind: binding.kind,\n")
        ()
        out_.push_str("                    ty: binding.ty,\n")
        ()
        out_.push_str("                })\n")
        ()
        out_.push_str("                .collect()\n")
        ()
        out_.push_str("        }\n\n")
        ()
        out_.push_str("        pub fn dispatch<'a>(params: &'a Params, x: u32, y: u32, z: u32) -> DispatchCall<'a, Params> {\n")
        ()
        out_.push_str("            DispatchCall {\n")
        ()
        out_.push_str(&f"                entry_point: \"{shader_.entry_point}\",\n")
        ()
        out_.push_str(&f"                stage: ShaderStage::{stage_name(shader_.stage)},\n")
        ()
        out_.push_str("                size: DispatchSize { x, y, z },\n")
        ()
        out_.push_str("                params,\n")
        ()
        out_.push_str("            }\n")
        ()
        out_.push_str("        }\n")
        ()
        out_.push_str("    }\n\n")
        ()
    ()
    out_.push_str("    pub fn shaders() -> &'static [ShaderDesc] {\n")
    ()
    out_.push_str("        &[\n")
    ()
    for shader_ in &(*artifacts).shaders:
        out_.push_str(&f"            {sanitize_ident(&shader_.name)}::SHADER,\n")
        ()
    ()
    out_.push_str("        ]\n")
    ()
    out_.push_str("    }\n")
    ()
    out_.push_str("}\n")
    ()
    out_

fn stage_name(stage: RustGpuShaderStage) -> String:
    match stage:
        RustGpuShaderStage::Vertex => "Vertex"
        RustGpuShaderStage::Fragment => "Fragment"
        RustGpuShaderStage::Compute => "Compute"
        RustGpuShaderStage::Surface => "Surface"

fn binding_kind_name(kind: RustGpuBindingKind) -> String:
    match kind:
        RustGpuBindingKind::StorageBuffer => "StorageBuffer"
        RustGpuBindingKind::Sampler2D => "Sampler2D"
        RustGpuBindingKind::Uniform => "Uniform"
        RustGpuBindingKind::LocalSize => "LocalSize"
        RustGpuBindingKind::SpecializationConstant => "SpecializationConstant"

fn binding_param_type(kind: RustGpuBindingKind) -> String:
    match kind:
        RustGpuBindingKind::StorageBuffer => "StorageBufferParam"
        RustGpuBindingKind::Sampler2D => "Sampler2DParam"
        RustGpuBindingKind::Uniform => "UniformParam"
        RustGpuBindingKind::LocalSize => "LocalSizeParam"
        RustGpuBindingKind::SpecializationConstant => "SpecializationConstantParam"

fn default_binding_initializer(binding: &codegen_rust::gpu_artifacts::RustGpuBindingArtifact) -> String:
    match (*binding).kind:
        RustGpuBindingKind::StorageBuffer => "StorageBufferParam { ty: \"{(*binding).ty}\", read_only: false }"
        RustGpuBindingKind::Sampler2D => "Sampler2DParam { ty: \"{(*binding).ty}\" }"
        RustGpuBindingKind::Uniform => "UniformParam { ty: \"{(*binding).ty}\" }"
        RustGpuBindingKind::LocalSize =>
            let axis = (*binding).name.strip_prefix("LOCAL_SIZE_").unwrap_or(&(*binding).name)
            let default_value = if (axis == "Z"):
                1
            else:
                8
            "LocalSizeParam { axis: \"{axis}\", default_value: {default_value} }"
        RustGpuBindingKind::SpecializationConstant => "SpecializationConstantParam { ty: \"{(*binding).ty}\" }"

fn sanitize_ident(name: String) -> String:
    let mut out_ = String__new_()
    for ch in name.chars():
        if (ch.is_ascii_alphanumeric() || (ch == "_")):
            out_.push(ch.to_ascii_lowercase())
            ()
        else:
            out_.push("_")
            ()
    ()
    if out_.is_empty():
        ("binding").to_string()
    elif out_.chars().next().is_some_and(fn(ch): ch.is_ascii_digit()):
        f"binding_{out_}"
    else:
        out_

