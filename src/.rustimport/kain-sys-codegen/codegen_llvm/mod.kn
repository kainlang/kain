    fn compile_actor(_self: &mut LlvmGenerator, actor_: &kain_core::types::TypedActor) -> Result<(), KainError>:
        let name = &actor_.ast.name
        let struct_ty = f"%{name}"
        (*_self).emit_(&"define void @{name}_run(i8* %arg) {")
        ()
        (*_self).emit_label("entry")
        ()
        let self_ptr = (*_self).next_reg()
        (*_self).emit_(&f"  {self_ptr} = bitcast i8* %arg to {struct_ty}*")
        ()
        let mailbox_ptr = (*_self).next_reg()
        (*_self).emit_(&f"  {mailbox_ptr} = getelementptr inbounds {struct_ty}, {struct_ty}* {self_ptr}, i32 0, i32 0")
        ()
        let mailbox = (*_self).next_reg()
        (*_self).emit_(&f"  {mailbox} = load i8*, i8** {mailbox_ptr}")
        ()
        let label_loop = (*_self).next_label()
        let label_process = (*_self).next_label()
        let label_sleep = (*_self).next_label()
        (*_self).emit_(&f"  br label %{label_loop}")
        ()
        (*_self).emit_label(&label_loop)
        ()
        let tag_ptr = (*_self).next_reg()
        (*_self).emit_(&f"  {tag_ptr} = alloca i64")
        ()
        let data_ptr = (*_self).next_reg()
        (*_self).emit_(&f"  {data_ptr} = alloca i8*")
        ()
        let pop_res = (*_self).next_reg()
        (*_self).emit_(&f"  {pop_res} = call i32 @mq_pop(i8* {mailbox}, i64* {tag_ptr}, i8** {data_ptr})")
        ()
        let cond = (*_self).next_reg()
        (*_self).emit_(&f"  {cond} = icmp ne i32 {pop_res}, 0")
        ()
        (*_self).emit_(&f"  br i1 {cond}, label %{label_process}, label %{label_sleep}")
        ()
        (*_self).emit_label(&label_sleep)
        ()
        (*_self).emit_("  call void @KAIN_sleep(double 0.001)")
        ()
        (*_self).emit_(&f"  br label %{label_loop}")
        ()
        (*_self).emit_label(&label_process)
        ()
        let tag_val = (*_self).next_reg()
        (*_self).emit_(&f"  {tag_val} = load i64, i64* {tag_ptr}")
        ()
        let mut handler_labels = Vec__new_()
        for _ in &actor_.ast.handlers:
            handler_labels.push((*_self).next_label())
            ()
        ()
        let mut switch_cases = String__new_()
        for selfhost_for_item in actor_.ast.handlers.iter().enumerate():
            let (i, handler) = selfhost_for_item
            let tag = (*_self).hash_message_tag(name, &handler.message_type)
            switch_cases.push_str(&f"i64 {tag}, label %{handler_labels[i]} ")
            ()
        ()
        (*_self).emit_(&f"  switch i64 {tag_val}, label %{label_loop} [ {switch_cases} ]")
        ()
        for selfhost_for_item in actor_.ast.handlers.iter().enumerate():
            let (i, handler) = selfhost_for_item
            (*_self).emit_label(&handler_labels[i])
            ()
            let payload_void = (*_self).next_reg()
            (*_self).emit_(&f"  {payload_void} = load i8*, i8** {data_ptr}")
            ()
            let msg_struct_name = f"{name}_{handler.message_type}"
            let msg_struct_ty = f"%{msg_struct_name}"
            let payload = (*_self).next_reg()
            (*_self).emit_(&f"  {payload} = bitcast i8* {payload_void} to {msg_struct_ty}*")
            ()
            (*_self).scopes.push(Vec__new_())
            ()
            (*_self).locals.clear()
            ()
            (*_self).locals.insert(("self").to_string(), (self_ptr.clone(), struct_ty.clone()))
            ()
            for selfhost_for_item in handler.params.iter().enumerate():
                let (j, param) = selfhost_for_item
                let p_ty = (*_self).map_type_from_ast(&param.ty)
                let field_ptr = (*_self).next_reg()
                (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds {msg_struct_ty}, {msg_struct_ty}* {payload}, i32 0, i32 {j}")
                ()
                let val = (*_self).next_reg()
                (*_self).emit_(&f"  {val} = load {p_ty}, {p_ty}* {field_ptr}")
                ()
                let addr_reg = f"%{param.name}.addr"
                (*_self).emit_(&f"  {addr_reg} = alloca {p_ty}")
                ()
                (*_self).emit_(&f"  store {p_ty} {val}, {p_ty}* {addr_reg}")
                ()
                (*_self).locals.insert(param.name.clone(), (addr_reg, p_ty))
                ()
                match (*_self).scopes.last_mut():
                    Some(scope) =>
                        scope.push(param.name.clone())
                        ()
                    _ => ()
            ()
            (*_self).compile_block(&handler.body)?
            ()
            (*_self).emit_(&f"  call void @rc_release(i8* {payload_void})")
            ()
            (*_self).emit_(&f"  br label %{label_loop}")
            ()
        ()
        (*_self).emit_("}")
        ()
        (*_self).emit_("")
        ()
        (*_self).current_return_type = none
        ()
        Result::Ok(())

