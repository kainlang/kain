                                                        kain_core__ast__Type::Named { name: name } =>
                                                            for method in &imp.ast.methods:
                                                                let mut ret_ty = method.return_type.map(fn(ty): (*_self).map_type_from_ast(ty)).unwrap_or_else(fn(): ("void").to_string())
                                                                if (ret_ty == "void"):
