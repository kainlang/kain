    fn emit_stdlib_externs(_self: &mut LlvmGenerator):
        let stdlib = StdLib__new_()
        let skip_list = ["print", "println", "to_string"]
        for selfhost_for_item in stdlib.functions:
            let (name, func) = selfhost_for_item
            if skip_list.contains(&name.as_str()):
                continue
            let ret_ty = (*_self).map_type_from_str(func.return_type)
            let mut param_tys = Vec__new_()
            for selfhost_for_item in func.params:
                let (_, p_ty) = selfhost_for_item
                param_tys.push((*_self).map_type_from_str(p_ty))
                ()
            ()
            let runtime_symbol = runtime_symbol_for_stdlib_function(&name)
            (*_self).emit_(&"declare {ret_ty} @{runtime_symbol}({param_tys.join(\", \")})")
            ()

    fn emit_struct_destructors(_self: &mut LlvmGenerator):
