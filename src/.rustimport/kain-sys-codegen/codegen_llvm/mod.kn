                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        for selfhost_for_item in (*method).params.iter().enumerate():
            let (i, param) = selfhost_for_item
            let p_ty = (*_self).map_type_from_ast(&param.ty)
            let addr_reg = f"%{param.name}.addr"
            (*_self).emit_(&f"  {addr_reg} = alloca {p_ty}")
            ()
            (*_self).emit_(&f"  store {p_ty} %arg{(i + 1)}, {p_ty}* {addr_reg}")
            ()
            (*_self).locals.insert(param.name.clone(), (addr_reg, p_ty))
            ()
            match (*_self).scopes.last_mut():
                Some(scope) =>
                    scope.push(param.name.clone())
                    ()
                _ => ()
        ()
        (*_self).compile_block(&(*method).body)?
        ()
        (*_self).emit_scope_exit()
        ()
        if (ret_type == "void"):
            (*_self).emit_("  ret void")
            ()
            ()
            ()
            ()
        else:
            (*_self).emit_("  unreachable")
            ()
            ()
            ()
            ()
        (*_self).emit_("}")
        ()
        (*_self).emit_("")
        ()
        (*_self).current_return_type = none
        ()
        Result::Ok(())

    fn compile_named_callable(_self: &mut LlvmGenerator, callable_name: String, params: &[kain_core::ast::Param], body: &kain_core::ast::Block, resolved_type: &kain_core::types::ResolvedType, span: kain_core::Span) -> Result<(), KainError>:
        (*_self).reg_count = 0
        ()
        (*_self).locals.clear()
        ()
        (*_self).scopes.clear()
        ()
        (*_self).scopes.push(Vec__new_())
        ()
        let (param_types, mut ret_type) = (*_self).callable_signature(resolved_type, callable_name, span)?
        (*_self).current_return_type = Option::Some(ret_type.clone())
        ()
        let (llvm_name, is_main) = if (callable_name == "main"):
            if (ret_type == "void"):
                ret_type = ("i64").to_string()
                ()
                ()
                ()
                ()
            ("main", true)
        else:
            (callable_name, false)
        let mut param_str = String__new_()
        for selfhost_for_item in params.iter().enumerate():
            let (index, _) = selfhost_for_item
            if (index > 0):
                param_str.push_str(", ")
                ()
                ()
                ()
                ()
            let param_ty = (*_self).map_type(&param_types[index])
            param_str.push_str(&f"{param_ty} %arg{index}")
            ()
        ()
        (*_self).emit_(&"define {ret_type} @{llvm_name}({param_str}) {")
        ()
        (*_self).emit_label("entry")
        ()
        for selfhost_for_item in params.iter().enumerate():
            let (index, param) = selfhost_for_item
            let param_ty = (*_self).map_type(&param_types[index])
            let addr_reg = f"%{param.name}.addr"
            (*_self).emit_(&f"  {addr_reg} = alloca {param_ty}")
            ()
            (*_self).emit_(&f"  store {param_ty} %arg{index}, {param_ty}* {addr_reg}")
            ()
            (*_self).locals.insert(param.name.clone(), (addr_reg, param_ty))
            ()
            match (*_self).scopes.last_mut():
                Some(scope) =>
                    scope.push(param.name.clone())
                    ()
                _ => ()
        ()
        (*_self).compile_block(body)?
        ()
        (*_self).emit_scope_exit()
        ()
        if (ret_type == "void"):
            (*_self).emit_("  ret void")
            ()
            ()
            ()
            ()
        elif is_main:
            (*_self).emit_("  ret i64 0")
            ()
            ()
            ()
            ()
        else:
            (*_self).emit_("  unreachable")
            ()
            ()
            ()
            ()
        (*_self).emit_("}")
