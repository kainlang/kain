    fn compile_impl_method(_self: &mut LlvmGenerator, target_name: String, method: &kain_core::ast::Function) -> Result<(), KainError>:
        (*_self).reg_count = 0
        ()
        (*_self).locals.clear()
        ()
        (*_self).scopes.clear()
