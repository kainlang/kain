use kain_core::ast::BinaryOp

use kain_core::ast::Block

use kain_core::ast::ElseBranch

use kain_core::ast::Expr

use kain_core::ast::JSXAttrValue

use kain_core::ast::JSXNode

use kain_core::ast::Pattern

use kain_core::ast::Stmt

use kain_core::ast::UnaryOp

use kain_core::ast::VariantPatternFields

use kain_core::error::KainError

use kain_core::error::KainResult

use kain_core::types::ResolvedType

use kain_core::types::TypedComponent

use kain_core::types::TypedFunction

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

use kain_core::Span

use kain_core::lower_typed_program_memory_for_target

use kain_core::validate_typed_program_memory_support

use kain_core::CompileTarget

use std::collections::HashMap

use std::collections::HashSet

enum LlvmTargetId:
    WindowsX64Msvc
    LinuxX64Gnu
    MacOsArm64

@derive(Clone, Copy, Debug, PartialEq, Eq)
struct LlvmTargetDescriptor:
    id: LlvmTargetId
    triple: String
    datalayout: String

@derive(Clone, Debug)
struct WorldGlobalInfo:
    global_symbol: String
    init_flag_symbol: String
    init_fn_name: String

const LLVM_TARGET_WINDOWS_X64_MSVC: LlvmTargetDescriptor = LlvmTargetDescriptor { id: LlvmTargetId__WindowsX64Msvc, triple: "x86_64-pc-windows-msvc", datalayout: "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128" }

const LLVM_TARGET_LINUX_X64_GNU: LlvmTargetDescriptor = LlvmTargetDescriptor { id: LlvmTargetId__LinuxX64Gnu, triple: "x86_64-unknown-linux-gnu", datalayout: "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128" }

const LLVM_TARGET_MACOS_ARM64: LlvmTargetDescriptor = LlvmTargetDescriptor { id: LlvmTargetId__MacOsArm64, triple: "arm64-apple-darwin", datalayout: "e-m:o-i64:64-i128:128-n32:64-S128" }

const LLVM_TARGET_DESCRIPTOR_REGISTRY: Array<LlvmTargetDescriptor> = [LLVM_TARGET_WINDOWS_X64_MSVC, LLVM_TARGET_LINUX_X64_GNU, LLVM_TARGET_MACOS_ARM64]

fn runtime_symbol_for_stdlib_function(name: String) -> String:
    match name:
        "floor" => "kain_floor_i64"
        "ceil" => "kain_ceil_i64"
        "round" => "kain_round_i64"
        _ => name

fn resolve_host_llvm_target_descriptor() -> &static LlvmTargetDescriptor:
    let target_id = if cfg!(all(target_os = "windows", target_arch = "x86_64")):
        LlvmTargetId__WindowsX64Msvc
    elif cfg!(all(target_os = "linux", target_arch = "x86_64")):
        LlvmTargetId__LinuxX64Gnu
    elif cfg!(all(target_os = "macos", target_arch = "aarch64")):
        LlvmTargetId__MacOsArm64
    else:
        LlvmTargetId__WindowsX64Msvc
    LLVM_TARGET_DESCRIPTOR_REGISTRY.iter().find(fn(descriptor): (descriptor.id == target_id)).unwrap_or(&LLVM_TARGET_WINDOWS_X64_MSVC)

pub fn generate(program: &kain_core::types::TypedProgram) -> Result<Array<u8>, KainError>:
    let lowered = kain_core__lower_typed_program_memory_for_target(program, kain_core__CompileTarget__Llvm)?
    kain_core__validate_typed_program_memory_support(&lowered, kain_core__CompileTarget__Llvm)?
    ()
    let mut gen = LlvmGenerator__new_()
    gen.compile_module(&lowered)?
    ()
    Result::Ok(gen.output.into_bytes())

struct LlvmGenerator:
    output: String
    reg_count: usize
    label_count: usize
    locals: Map<String, (String, String)>
    functions: Map<String, String>
    function_params: Map<String, Array<String>>
    extern_functions: Set<String>
    strings: Map<String, String>
    string_counter: usize
    loop_stack: Array<(String, String)>
    scopes: Array<Array<String>>
    struct_defs: Map<String, Array<(String, String)>>
    component_defs: Map<String, Array<(String, String)>>
    current_block: String
    current_return_type: Option<String>
    target: &static LlvmTargetDescriptor
    world_globals: Map<String, WorldGlobalInfo>

impl LlvmGenerator:
    fn new_() -> LlvmGenerator:
        LlvmGenerator { output: String__new_(), reg_count: 0, label_count: 0, locals: HashMap__new_(), functions: HashMap__new_(), function_params: HashMap__new_(), extern_functions: HashSet__new_(), strings: HashMap__new_(), string_counter: 0, loop_stack: Vec__new_(), scopes: Vec__new_(), struct_defs: HashMap__new_(), component_defs: HashMap__new_(), current_block: ("entry").to_string(), current_return_type: none, target: resolve_host_llvm_target_descriptor(), world_globals: HashMap__new_() }

    fn emit_(_self: &mut LlvmGenerator, s: String):
        (*_self).output.push_str(s)
        ()
        (*_self).output.push("\n")
        ()

    fn emit_label(_self: &mut LlvmGenerator, label: String):
        (*_self).emit_(&f"{label}:")
        ()
        (*_self).current_block = label.to_string()
        ()

    fn next_reg(_self: &mut LlvmGenerator) -> String:
        let r = f"%{(*_self).reg_count}"
        (*_self).reg_count = ((*_self).reg_count + 1)
        ()
        r

    fn next_label(_self: &mut LlvmGenerator) -> String:
        let l = f"L{(*_self).label_count}"
        (*_self).label_count = ((*_self).label_count + 1)
        ()
        l

    fn sanitize_type_fragment(fragment_: String) -> String:
        fragment_.chars().map(fn(ch): if ch.is_ascii_alphanumeric(): ch else: "_").collect()

    fn tuple_struct_name_from_types(field_tys: &[String]) -> String:
        let mut name = String__from("__kain_tuple")
        for field_ty in field_tys:
            name.push("_")
            ()
            name.push_str(&LlvmGenerator__sanitize_type_fragment(field_ty))
            ()
        ()
        name

    fn tuple_struct_ptr_type_from_types(field_tys: &[String]) -> String:
        f"%{LlvmGenerator__tuple_struct_name_from_types(field_tys)}*"

    fn register_tuple_struct(_self: &mut LlvmGenerator, field_tys: Array<String>) -> String:
        let name = LlvmGenerator__tuple_struct_name_from_types(&field_tys)
        if (!(*_self).struct_defs.contains_key(&name)):
            let fields = field_tys.iter().enumerate().map(fn(__kain_closure_arg0): (f"_{__kain_closure_arg0.__kain_tuple_0}", __kain_closure_arg0.__kain_tuple_1.clone())).collect()
            (*_self).struct_defs.insert(name.clone(), fields)
            ()
            (*_self).emit_(&"%{name} = type { {field_tys.join(\", \")} }")
            ()
            ()
            ()
            ()
        name

    fn collect_tuple_types_from_ast(_self: &mut LlvmGenerator, ty: &kain_core::ast::Type):
        match ty:
            kain_core__ast__Type::Tuple(items, _) =>
                for item in items:
                    (*_self).collect_tuple_types_from_ast(item)
                    ()
                ()
                let field_tys = items.iter().map(fn(item): (*_self).map_type_from_ast(item)).collect()
                (*_self).register_tuple_struct(field_tys)
                ()
            kain_core__ast__Type::Array(inner, _, _) => (*_self).collect_tuple_types_from_ast(inner)
            kain_core__ast__Type::Slice(inner, _) => (*_self).collect_tuple_types_from_ast(inner)
            kain_core__ast__Type::Option(inner, _) => (*_self).collect_tuple_types_from_ast(inner)
            kain_core__ast__Type::Result(inner, _, _) => (*_self).collect_tuple_types_from_ast(inner)
            kain_core__ast__Type::Ref { inner: inner } => (*_self).collect_tuple_types_from_ast(inner)
            kain_core__ast__Type::Ptr { inner: inner } => (*_self).collect_tuple_types_from_ast(inner)
            _ => ()

    fn collect_tuple_types_from_resolved(_self: &mut LlvmGenerator, ty: &kain_core::types::ResolvedType):
        match ty:
            kain_core__types__ResolvedType::Tuple(items) =>
                for item in items:
                    (*_self).collect_tuple_types_from_resolved(item)
                    ()
                ()
                let field_tys = items.iter().map(fn(item): (*_self).map_type(item)).collect()
                (*_self).register_tuple_struct(field_tys)
                ()
            kain_core__types__ResolvedType::Array(inner, _) => (*_self).collect_tuple_types_from_resolved(inner)
            kain_core__types__ResolvedType::Slice(inner) => (*_self).collect_tuple_types_from_resolved(inner)
            kain_core__types__ResolvedType::Option(inner) => (*_self).collect_tuple_types_from_resolved(inner)
            kain_core__types__ResolvedType::Ref { inner: inner } => (*_self).collect_tuple_types_from_resolved(inner)
            kain_core__types__ResolvedType::Ptr { inner: inner } => (*_self).collect_tuple_types_from_resolved(inner)
            kain_core__types__ResolvedType::Result(ok, err) =>
                (*_self).collect_tuple_types_from_resolved(ok)
                ()
                (*_self).collect_tuple_types_from_resolved(err)
                ()
            kain_core__types__ResolvedType::Function { params: params, ret: ret } =>
                for param in params:
                    (*_self).collect_tuple_types_from_resolved(param)
                    ()
                ()
                (*_self).collect_tuple_types_from_resolved(ret)
                ()
            _ => ()

    fn collect_program_tuple_types(_self: &mut LlvmGenerator, program: &kain_core::types::TypedProgram):
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Function(func) =>
                    (*_self).collect_tuple_types_from_resolved(&func.resolved_type)
                    ()
                    for param in &func.ast.params:
                        (*_self).collect_tuple_types_from_ast(&param.ty)
                        ()
                    ()
                    match &func.ast.return_type:
                        Some(ret) =>
                            (*_self).collect_tuple_types_from_ast(ret)
                            ()
                        _ => ()
                kain_core__types__TypedItem::Patch(patch) =>
                    (*_self).collect_tuple_types_from_resolved(&patch.resolved_type)
                    ()
                    for param in &patch.ast.params:
                        (*_self).collect_tuple_types_from_ast(&param.ty)
                        ()
                    ()
                    match &patch.ast.return_type:
                        Some(ret) =>
                            (*_self).collect_tuple_types_from_ast(ret)
                            ()
                        _ => ()
                kain_core__types__TypedItem::Converge(converge) =>
                    (*_self).collect_tuple_types_from_resolved(&converge.resolved_type)
                    ()
                    for param in &converge.ast.params:
                        (*_self).collect_tuple_types_from_ast(&param.ty)
                        ()
                    ()
                    match &converge.ast.return_type:
                        Some(ret) =>
                            (*_self).collect_tuple_types_from_ast(ret)
                            ()
                        _ => ()
                kain_core__types__TypedItem::World(world) =>
                    for state_ in &world.ast.states:
                        (*_self).collect_tuple_types_from_ast(&state_.ty)
                        ()
                kain_core__types__TypedItem::Orchestrate(orchestrate) =>
                    (*_self).collect_tuple_types_from_resolved(&orchestrate.resolved_type)
                    ()
                    for param in &orchestrate.ast.params:
                        (*_self).collect_tuple_types_from_ast(&param.ty)
                        ()
                    ()
                    match &orchestrate.ast.return_type:
                        Some(ret) =>
                            (*_self).collect_tuple_types_from_ast(ret)
                            ()
                        _ => ()
                kain_core__types__TypedItem::Struct(s) =>
                    for ty in s.field_types.values():
                        (*_self).collect_tuple_types_from_resolved(ty)
                        ()
                kain_core__types__TypedItem::Component(component_) =>
                    for ty in component_.prop_types.values():
                        (*_self).collect_tuple_types_from_resolved(ty)
                        ()
                    ()
                    for prop in &component_.ast.props:
                        (*_self).collect_tuple_types_from_ast(&prop.ty)
                        ()
                kain_core__types__TypedItem::Actor(actor_) =>
                    for ty in actor_.state_types.values():
                        (*_self).collect_tuple_types_from_resolved(ty)
                        ()
                    ()
                    for state_ in &actor_.ast.state_:
                        (*_self).collect_tuple_types_from_ast(&state_.ty)
                        ()
                    ()
                    for handler in &actor_.ast.handlers:
                        for param in &handler.params:
                            (*_self).collect_tuple_types_from_ast(&param.ty)
                            ()
                kain_core__types__TypedItem::Enum(en) =>
                    for payload_types in en.variant_payload_types.values():
                        for ty in payload_types:
                            (*_self).collect_tuple_types_from_resolved(ty)
                            ()
                kain_core__types__TypedItem::Impl(imp) =>
                    (*_self).collect_tuple_types_from_ast(&imp.ast.target_type)
                    ()
                    for method in &imp.ast.methods:
                        for param in &method.params:
                            (*_self).collect_tuple_types_from_ast(&param.ty)
                            ()
                        ()
                        match &method.return_type:
                            Some(ret) =>
                                (*_self).collect_tuple_types_from_ast(ret)
                                ()
                            _ => ()
                _ => ()

    fn map_type_from_ast(_self: &LlvmGenerator, ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name } => (*_self).map_type_from_str(name)
            kain_core__ast__Type::Tuple(items, _) =>
                let field_tys = items.iter().map(fn(item): (*_self).map_type_from_ast(item)).collect()
                LlvmGenerator__tuple_struct_ptr_type_from_types(&field_tys)
            kain_core__ast__Type::Array(_, _, _) => ("i8*").into()
            kain_core__ast__Type::Slice(_, _) => ("i8*").into()
            kain_core__ast__Type::Ref { inner: inner } => f"{(*_self).map_type_from_ast(inner)}*"
            kain_core__ast__Type::Ptr { inner: inner } => f"{(*_self).map_type_from_ast(inner)}*"
            kain_core__ast__Type::Option(inner, _) => (*_self).map_type_from_ast(inner)
            kain_core__ast__Type::Result(ok, _, _) => (*_self).map_type_from_ast(ok)
            kain_core__ast__Type::Unit(_) => ("void").into()
            kain_core__ast__Type::Never(_) => ("void").into()
            _ => ("i64").into()

    fn map_type_from_str(_self: &LlvmGenerator, name: String) -> String:
        match name:
            "Int" => ("i64").into()
            "i64" => ("i64").into()
            "Float" => ("double").into()
            "f64" => ("double").into()
            "double" => ("double").into()
            "Bool" => ("i1").into()
            "bool" => ("i1").into()
            "String" => ("i8*").into()
            "str" => ("i8*").into()
            "Unit" => ("void").into()
            "()" => ("void").into()
            "void" => ("void").into()
            _ => if (*_self).struct_defs.contains_key(name): f"%{name}*" else: ("i64").into()

    fn map_type(_self: &LlvmGenerator, ty: &kain_core::types::ResolvedType) -> String:
        use kain_core::types::ResolvedType

        match ty:
            kain_core__types__ResolvedType::Int(_) => ("i64").into()
            kain_core__types__ResolvedType::Float(_) => ("double").into()
            kain_core__types__ResolvedType::Bool => ("i1").into()
            kain_core__types__ResolvedType::String => ("i8*").into()
            kain_core__types__ResolvedType::Unit => ("void").into()
            kain_core__types__ResolvedType::Char => ("i8").into()
            kain_core__types__ResolvedType::Struct(name, _) => if (*_self).struct_defs.contains_key(name): f"%{name}*" else: (*_self).map_type_from_str(name)
            kain_core__types__ResolvedType::Enum(name, _) => f"%{name}*"
            kain_core__types__ResolvedType::Array(_, _) => ("i64").into()
            kain_core__types__ResolvedType::Slice(_) => ("i64").into()
            kain_core__types__ResolvedType::Option(inner) => (*_self).map_type(inner)
            kain_core__types__ResolvedType::Result(ok, _) => (*_self).map_type(ok)
            kain_core__types__ResolvedType::Future(inner) => (*_self).map_type(inner)
            kain_core__types__ResolvedType::Function {  } => ("i64").into()
            kain_core__types__ResolvedType::Generic(name) => (*_self).map_type_from_str(name)
            kain_core__types__ResolvedType::Tuple(items) =>
                let field_tys = items.iter().map(fn(item): (*_self).map_type(item)).collect()
                LlvmGenerator__tuple_struct_ptr_type_from_types(&field_tys)
            kain_core__types__ResolvedType::Ref { inner: inner } => (*_self).map_type(inner)
            kain_core__types__ResolvedType::Ptr { inner: inner } => f"{(*_self).map_type(inner)}*"
            kain_core__types__ResolvedType::Never => ("void").into()
            kain_core__types__ResolvedType::Unknown => ("i64").into()

    fn compile_string_literal(_self: &mut LlvmGenerator, s: String) -> (String, String):
        let global_name = match (*_self).strings.get(s):
            Some(name) => name.clone()
            _ =>
                let name = f"@.str.{(*_self).string_counter}"
                (*_self).string_counter = ((*_self).string_counter + 1)
                ()
                (*_self).strings.insert(s.to_string(), name.clone())
                ()
                name
        let reg_static = (*_self).next_reg()
        let len = (s.len() + 1)
        (*_self).emit_(&f"  {reg_static} = getelementptr inbounds [{len} x i8], [{len} x i8]* {global_name}, i64 0, i64 0")
        ()
        let reg_rc = (*_self).next_reg()
        (*_self).emit_(&f"  {reg_rc} = call i8* @string_new(i8* {reg_static})")
        ()
        (reg_rc, ("i8*").to_string())

    fn concat_strings(_self: &mut LlvmGenerator, lhs: String, rhs: String) -> String:
        let res = (*_self).next_reg()
        (*_self).emit_(&f"  {res} = call i8* @str_concat(i8* {lhs}, i8* {rhs})")
        ()
        res

    fn stringify_value(_self: &mut LlvmGenerator, val: String, ty: String) -> Result<(String, String), KainError>:
        match ty:
            "i8*" => Result::Ok((val.to_string(), ("i8*").to_string()))
            "i64" =>
                let widened = if (ty == "i64"):
                    val.to_string()
                else:
                    let reg = (*_self).next_reg()
                    (*_self).emit_(&f"  {reg} = sext i8 {val} to i64")
                    ()
                    reg
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = call i8* @to_string(i64 {widened})")
                ()
                Result::Ok((res, ("i8*").to_string()))
            "i8" =>
                let widened = if (ty == "i64"):
                    val.to_string()
                else:
                    let reg = (*_self).next_reg()
                    (*_self).emit_(&f"  {reg} = sext i8 {val} to i64")
                    ()
                    reg
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = call i8* @to_string(i64 {widened})")
                ()
                Result::Ok((res, ("i8*").to_string()))
            "i1" =>
                let widened = (*_self).next_reg()
                (*_self).emit_(&f"  {widened} = zext i1 {val} to i64")
                ()
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = call i8* @to_string(i64 {widened})")
                ()
                Result::Ok((res, ("i8*").to_string()))
            "double" =>
                let narrowed = (*_self).next_reg()
                (*_self).emit_(&f"  {narrowed} = fptosi double {val} to i64")
                ()
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = call i8* @to_string(i64 {narrowed})")
                ()
                Result::Ok((res, ("i8*").to_string()))
            _ if ty.starts_with("%") => Result::Ok((*_self).compile_string_literal("<value>"))
            _ => Result::Ok((*_self).compile_string_literal("<value>"))

    fn zero_value_for_ty(_self: &LlvmGenerator, ty: String) -> String:
        match ty:
            "double" => ("0.0").into()
            "i1" => ("0").into()
            "i8" => ("0").into()
            "i64" => ("0").into()
            "void" => ("0").into()
            _ if ty.ends_with("*") => ("null").into()
            _ => ("0").into()

    fn compile_expr_for_target_type(_self: &mut LlvmGenerator, expr: &kain_core::ast::Expr, target_ty: String) -> Result<(String, String), KainError>:
        if (none):
            Result::Ok(((*_self).zero_value_for_ty(target_ty), target_ty.to_string()))
        else:
            (*_self).compile_expr(expr)

    fn align_abi_size(size: usize, align: usize) -> usize:
        if (align <= 1):
            size
        else:
            (size.div_ceil(align) * align)

    fn abi_layout_for_ty(_self: &LlvmGenerator, ty: String, span: kain_core::Span) -> Result<(usize, usize), KainError>:
        match ty:
            "i1" => Result::Ok((1, 1))
            "i8" => Result::Ok((1, 1))
            "i64" => Result::Ok((8, 8))
            "double" => Result::Ok((8, 8))
            "void" => Result::Err(KainError__codegen("Cannot compute runtime memory layout for void", span))
            _ if ty.ends_with("*") => Result::Ok((8, 8))
            _ if ty.starts_with("%") =>
                let struct_name = ty.trim_start_matches("%")
                let fields = (*_self).struct_defs.get(struct_name).ok_or_else(fn(): KainError__codegen(f"Unknown LLVM struct layout: {struct_name}", span))?
                let mut size = 0
                let mut max_align = 1
                for selfhost_for_item in fields:
                    let (_, field_ty) = selfhost_for_item
                    let (field_size, field_align) = (*_self).abi_layout_for_ty(field_ty, span)?
                    size = LlvmGenerator__align_abi_size(size, field_align)
                    ()
                    size = (size + field_size)
                    ()
                    max_align = max_align.max(field_align)
                    ()
                ()
                Result::Ok((LlvmGenerator__align_abi_size(size, max_align), max_align))
            _ => Result::Err(KainError__codegen(f"Unsupported LLVM runtime memory layout for type {ty}", span))

    fn compile_runtime_mem_load(_self: &mut LlvmGenerator, pointer: &kain_core::ast::Expr, load_ty: String, span: kain_core::Span) -> Result<(String, String), KainError>:
        let (ptr, ptr_ty) = (*_self).compile_expr(pointer)?
        let ptr_i64 = (*_self).coerce_to_i64_storage(&ptr, &ptr_ty)
        let (load_size, _) = (*_self).abi_layout_for_ty(load_ty, span)?
        let ptr_i8 = (*_self).next_reg()
        (*_self).emit_(&f"  {ptr_i8} = inttoptr i64 {ptr_i64} to i8*")
        ()
        let temp_ptr = (*_self).next_reg()
        (*_self).emit_(&f"  {temp_ptr} = alloca {load_ty}")
        ()
        let temp_i8 = (*_self).next_reg()
        (*_self).emit_(&f"  {temp_i8} = bitcast {load_ty}* {temp_ptr} to i8*")
        ()
        (*_self).emit_(&f"  call void @__kain_mem_load(i8* {ptr_i8}, i8* {temp_i8}, i64 {load_size})")
        ()
        let loaded = (*_self).next_reg()
        (*_self).emit_(&f"  {loaded} = load {load_ty}, {load_ty}* {temp_ptr}")
        ()
        Result::Ok((loaded, load_ty.to_string()))

    fn compile_runtime_mem_store(_self: &mut LlvmGenerator, pointer: &kain_core::ast::Expr, value: &kain_core::ast::Expr, span: kain_core::Span) -> Result<(String, String), KainError>:
        let (ptr, ptr_ty) = (*_self).compile_expr(pointer)?
        let ptr_i64 = (*_self).coerce_to_i64_storage(&ptr, &ptr_ty)
        let (stored_value, stored_ty) = (*_self).compile_expr(value)?
        let (store_size, _) = (*_self).abi_layout_for_ty(&stored_ty, span)?
        let ptr_i8 = (*_self).next_reg()
        (*_self).emit_(&f"  {ptr_i8} = inttoptr i64 {ptr_i64} to i8*")
        ()
        let temp_ptr = (*_self).next_reg()
        (*_self).emit_(&f"  {temp_ptr} = alloca {stored_ty}")
        ()
        (*_self).emit_(&f"  store {stored_ty} {stored_value}, {stored_ty}* {temp_ptr}")
        ()
        let temp_i8 = (*_self).next_reg()
        (*_self).emit_(&f"  {temp_i8} = bitcast {stored_ty}* {temp_ptr} to i8*")
        ()
        (*_self).emit_(&f"  call void @__kain_mem_store(i8* {ptr_i8}, i8* {temp_i8}, i64 {store_size})")
        ()
        Result::Ok((stored_value, stored_ty))

    fn coerce_to_i64_storage(_self: &mut LlvmGenerator, val: String, ty: String) -> String:
        match ty:
            "i64" => val.to_string()
            "i1" =>
                let reg = (*_self).next_reg()
                (*_self).emit_(&f"  {reg} = zext i1 {val} to i64")
                ()
                reg
            "i8" =>
                let reg = (*_self).next_reg()
                (*_self).emit_(&f"  {reg} = sext i8 {val} to i64")
                ()
                reg
            "double" =>
                let reg = (*_self).next_reg()
                (*_self).emit_(&f"  {reg} = fptosi double {val} to i64")
                ()
                reg
            _ if ty.ends_with("*") =>
                let reg = (*_self).next_reg()
                (*_self).emit_(&f"  {reg} = ptrtoint {ty} {val} to i64")
                ()
                reg
            _ => val.to_string()

    fn cast_numeric_value(_self: &mut LlvmGenerator, val: String, src_ty: String, dst_ty: String) -> Result<String, KainError>:
        if (src_ty == dst_ty):
            return Result::Ok(val)
        let reg = (*_self).next_reg()
        match (src_ty, dst_ty):
            ("i64", "double") =>
                (*_self).emit_(&f"  {reg} = sitofp i64 {val} to double")
                ()
                Result::Ok(reg)
            ("i1", "double") =>
                (*_self).emit_(&f"  {reg} = uitofp i1 {val} to double")
                ()
                Result::Ok(reg)
            ("i8", "double") =>
                (*_self).emit_(&f"  {reg} = sitofp i8 {val} to double")
                ()
                Result::Ok(reg)
            ("i1", "i64") =>
                (*_self).emit_(&f"  {reg} = zext i1 {val} to i64")
                ()
                Result::Ok(reg)
            ("i8", "i64") =>
                (*_self).emit_(&f"  {reg} = sext i8 {val} to i64")
                ()
                Result::Ok(reg)
            ("double", "i64") =>
                (*_self).emit_(&f"  {reg} = fptosi double {val} to i64")
                ()
                Result::Ok(reg)
            _ => Result::Err(KainError__codegen(f"Unsupported numeric cast from {src_ty} to {dst_ty}", Span__default_()))

    fn coerce_binary_operands(_self: &mut LlvmGenerator, lhs: String, lhs_ty: String, rhs: String, rhs_ty: String) -> Result<(String, String, String, String), KainError>:
        if (lhs_ty == rhs_ty):
            return Result::Ok((lhs, lhs_ty, rhs, rhs_ty))
        if (lhs_ty == "double"):
            let rhs_cast = (*_self).cast_numeric_value(rhs, &rhs_ty, "double")?
            return Result::Ok((lhs, lhs_ty, rhs_cast, ("double").to_string()))
        if (rhs_ty == "double"):
            let lhs_cast = (*_self).cast_numeric_value(lhs, &lhs_ty, "double")?
            return Result::Ok((lhs_cast, ("double").to_string(), rhs, rhs_ty))
        if (lhs_ty == "i64"):
            let rhs_cast = (*_self).cast_numeric_value(rhs, &rhs_ty, "i64")?
            return Result::Ok((lhs, lhs_ty, rhs_cast, ("i64").to_string()))
        if (rhs_ty == "i64"):
            let lhs_cast = (*_self).cast_numeric_value(lhs, &lhs_ty, "i64")?
            return Result::Ok((lhs_cast, ("i64").to_string(), rhs, rhs_ty))
        Result::Ok((lhs, lhs_ty, rhs, rhs_ty))

    fn compile_value_eq(_self: &mut LlvmGenerator, lhs: String, lhs_ty: String, rhs: String, rhs_ty: String, span: kain_core::Span) -> Result<String, KainError>:
        let (lhs, lhs_ty, rhs, rhs_ty) = (*_self).coerce_binary_operands(lhs.to_string(), lhs_ty.to_string(), rhs.to_string(), rhs_ty.to_string())?
        let res = (*_self).next_reg()
        if ((lhs_ty == "i8*") || (rhs_ty == "i8*")):
            (*_self).emit_(&f"  {res} = call i1 @deep_eq(i8* {lhs}, i8* {rhs})")
            ()
            return Result::Ok(res)
        match lhs_ty.as_str():
            "double" =>
                (*_self).emit_(&f"  {res} = fcmp oeq double {lhs}, {rhs}")
                ()
            "i1" =>
                (*_self).emit_(&f"  {res} = icmp eq {lhs_ty} {lhs}, {rhs}")
                ()
                ()
            "i8" =>
                (*_self).emit_(&f"  {res} = icmp eq {lhs_ty} {lhs}, {rhs}")
                ()
                ()
            "i64" =>
                (*_self).emit_(&f"  {res} = icmp eq {lhs_ty} {lhs}, {rhs}")
                ()
                ()
            _ if lhs_ty.ends_with("*") =>
                (*_self).emit_(&f"  {res} = icmp eq {lhs_ty} {lhs}, {rhs}")
                ()
                ()
            _ => return Result::Err(KainError__codegen(f"Unsupported equality comparison between {lhs_ty} and {rhs_ty}", span))
        Result::Ok(res)

    fn compile_range_check(_self: &mut LlvmGenerator, val: String, val_ty: String, start: &Option<Box<kain_core::ast::Expr>>, end: &Option<Box<kain_core::ast::Expr>>, inclusive: Bool, span: kain_core::Span) -> Result<String, KainError>:
        let mut checks = Vec__new_()
        match start:
            Some(lo) =>
                let (lo_val, lo_ty) = (*_self).compile_expr(lo)?
                let (lhs, lhs_ty, rhs, _) = (*_self).coerce_binary_operands(val.to_string(), val_ty.to_string(), lo_val, lo_ty)?
                let cmp = (*_self).next_reg()
                match lhs_ty.as_str():
                    "double" =>
                        (*_self).emit_(&f"  {cmp} = fcmp oge double {lhs}, {rhs}")
                        ()
                    "i1" =>
                        (*_self).emit_(&f"  {cmp} = icmp sge {lhs_ty} {lhs}, {rhs}")
                        ()
                        ()
                    "i8" =>
                        (*_self).emit_(&f"  {cmp} = icmp sge {lhs_ty} {lhs}, {rhs}")
                        ()
                        ()
                    "i64" =>
                        (*_self).emit_(&f"  {cmp} = icmp sge {lhs_ty} {lhs}, {rhs}")
                        ()
                        ()
                    _ => return Result::Err(KainError__codegen(f"Unsupported range lower bound type {lhs_ty}", span))
                checks.push(cmp)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match end:
            Some(hi) =>
                let (hi_val, hi_ty) = (*_self).compile_expr(hi)?
                let (lhs, lhs_ty, rhs, _) = (*_self).coerce_binary_operands(val.to_string(), val_ty.to_string(), hi_val, hi_ty)?
                let cmp = (*_self).next_reg()
                match lhs_ty.as_str():
                    "double" =>
                        let op = if inclusive:
                            "fcmp ole"
                        else:
                            "fcmp olt"
                        (*_self).emit_(&f"  {cmp} = {op} double {lhs}, {rhs}")
                        ()
                        ()
                        ()
                        ()
                    "i1" =>
                        let op = if inclusive:
                            "icmp sle"
                        else:
                            "icmp slt"
                        (*_self).emit_(&f"  {cmp} = {op} {lhs_ty} {lhs}, {rhs}")
                        ()
                        ()
                        ()
                        ()
                    "i8" =>
                        let op = if inclusive:
                            "icmp sle"
                        else:
                            "icmp slt"
                        (*_self).emit_(&f"  {cmp} = {op} {lhs_ty} {lhs}, {rhs}")
                        ()
                        ()
                        ()
                        ()
                    "i64" =>
                        let op = if inclusive:
                            "icmp sle"
                        else:
                            "icmp slt"
                        (*_self).emit_(&f"  {cmp} = {op} {lhs_ty} {lhs}, {rhs}")
                        ()
                        ()
                        ()
                        ()
                    _ => return Result::Err(KainError__codegen(f"Unsupported range upper bound type {lhs_ty}", span))
                checks.push(cmp)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        if checks.is_empty():
            return Result::Ok(("1").to_string())
        let mut current = checks[0].clone()
        for check in checks.iter().skip(1):
            let combined = (*_self).next_reg()
            (*_self).emit_(&f"  {combined} = and i1 {current}, {check}")
            ()
            current = combined
            ()
        ()
        Result::Ok(current)

    fn compile_pattern_condition(_self: &mut LlvmGenerator, pattern: &kain_core::ast::Pattern, scrutinee_val: String, scrutinee_ty: String, enum_name: Option<String>, span: kain_core::Span) -> Result<String, KainError>:
        match pattern:
            kain_core__ast__Pattern::Wildcard(_) => Result::Ok(("1").to_string())
            kain_core__ast__Pattern::Binding {  } => Result::Ok(("1").to_string())
            kain_core__ast__Pattern::Literal(expr) =>
                let (rhs, rhs_ty) = (*_self).compile_expr(expr)?
                (*_self).compile_value_eq(scrutinee_val, scrutinee_ty, &rhs, &rhs_ty, span)
            kain_core__ast__Pattern::Range { start: start, end: end, inclusive: inclusive } => (*_self).compile_range_check(scrutinee_val, scrutinee_ty, start, end, (*inclusive), span)
            kain_core__ast__Pattern::Or(items, _) =>
                let mut regs = Vec__new_()
                for item in items:
                    regs.push((*_self).compile_pattern_condition(item, scrutinee_val, scrutinee_ty, enum_name, span)?)
                    ()
                ()
                if regs.is_empty():
                    return Result::Ok(("0").to_string())
                let mut current = regs[0].clone()
                for reg in regs.iter().skip(1):
                    let merged = (*_self).next_reg()
                    (*_self).emit_(&f"  {merged} = or i1 {current}, {reg}")
                    ()
                    current = merged
                    ()
                ()
                Result::Ok(current)
            kain_core__ast__Pattern::Variant { variant: variant } =>
                let enum_name = enum_name.ok_or_else(fn(): KainError__codegen("Variant pattern requires an enum scrutinee", span))?
                let tag_ptr = (*_self).next_reg()
                (*_self).emit_(&f"  {tag_ptr} = getelementptr inbounds %{enum_name}, {scrutinee_ty} {scrutinee_val}, i32 0, i32 0")
                ()
                let tag = (*_self).next_reg()
                (*_self).emit_(&f"  {tag} = load i64, i64* {tag_ptr}")
                ()
                let cmp = (*_self).next_reg()
                (*_self).emit_(&f"  {cmp} = icmp eq i64 {tag}, {(*_self).hash_message_tag(enum_name, variant)}")
                ()
                Result::Ok(cmp)
            other => Result::Err(KainError__codegen(f"Unsupported LLVM pattern condition: {other}", span))

    fn bind_local_pattern_value(_self: &mut LlvmGenerator, pattern: &kain_core::ast::Pattern, val: String, ty: String) -> Result<(), KainError>:
        match pattern:
            kain_core__ast__Pattern::Wildcard(_) => Result::Ok(())
            kain_core__ast__Pattern::Binding { name: name } =>
                let addr_reg = f"%{name}.addr_{(*_self).reg_count}"
                (*_self).reg_count = ((*_self).reg_count + 1)
                ()
                (*_self).emit_(&f"  {addr_reg} = alloca {ty}")
                ()
                (*_self).emit_(&f"  store {ty} {val}, {ty}* {addr_reg}")
                ()
                (*_self).locals.insert(name.clone(), (addr_reg, ty))
                ()
                match (*_self).scopes.last_mut():
                    Some(scope) =>
                        scope.push(name.clone())
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                Result::Ok(())
            kain_core__ast__Pattern::Tuple(patterns, span) =>
                let struct_name = (ty.strip_prefix("%").and_then(fn(name): name.strip_suffix("*")).ok_or_else(fn(): KainError__codegen(f"Tuple pattern requires tuple pointer value, got {ty}", (*span)))?).to_string()
                let field_defs = (*_self).struct_defs.get(&struct_name).cloned().ok_or_else(fn(): KainError__codegen(f"Unknown tuple storage type for pattern: {struct_name}", (*span)))?
                for selfhost_for_item in patterns.iter().enumerate():
                    let (index, sub_pattern) = selfhost_for_item
                    let field_ty = field_defs.get(index).map(fn(__kain_closure_arg1): __kain_closure_arg1.__kain_tuple_1.clone()).unwrap_or_else(fn(): ("i64").to_string())
                    let field_ptr = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds %{struct_name}, {ty} {val}, i32 0, i32 {index}")
                    ()
                    let field_val = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_val} = load {field_ty}, {field_ty}* {field_ptr}")
                    ()
                    if (field_ty == "i8*"):
                        (*_self).emit_(&f"  call void @rc_retain(i8* {field_val})")
                        ()
                        ()
                        ()
                        ()
                    (*_self).bind_local_pattern_value(sub_pattern, field_val, field_ty)?
                    ()
                ()
                Result::Ok(())
            kain_core__ast__Pattern::Struct { name: name, fields: fields, span: span } =>
                let struct_name = (ty.strip_prefix("%").and_then(fn(name): name.strip_suffix("*")).ok_or_else(fn(): KainError__codegen(f"Struct pattern requires struct pointer value, got {ty}", (*span)))?).to_string()
                if (&struct_name != name):
                    return Result::Err(KainError__codegen(f"Struct pattern expected {name}, got {struct_name}", (*span)))
                let field_defs = (*_self).struct_defs.get(&struct_name).cloned().ok_or_else(fn(): KainError__codegen(f"Unknown struct storage type for pattern: {struct_name}", (*span)))?
                for selfhost_for_item in fields:
                    let (field_name, sub_pattern) = selfhost_for_item
                    let (index, field_ty) = field_defs.iter().enumerate().find(fn(__kain_closure_arg2): (__kain_closure_arg2.__kain_tuple_1.__kain_tuple_0 == field_name)).map(fn(__kain_closure_arg3): (__kain_closure_arg3.__kain_tuple_0, __kain_closure_arg3.__kain_tuple_1.__kain_tuple_1.clone())).ok_or_else(fn(): KainError__codegen(f"Unknown struct field '{field_name}' on {struct_name}", (*span)))?
                    let field_ptr = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds %{struct_name}, {ty} {val}, i32 0, i32 {index}")
                    ()
                    let field_val = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_val} = load {field_ty}, {field_ty}* {field_ptr}")
                    ()
                    if (field_ty == "i8*"):
                        (*_self).emit_(&f"  call void @rc_retain(i8* {field_val})")
                        ()
                        ()
                        ()
                        ()
                    (*_self).bind_local_pattern_value(sub_pattern, field_val, field_ty)?
                    ()
                ()
                Result::Ok(())
            _ => Result::Err(KainError__codegen("Local pattern binding currently supports wildcard, binding, tuple, and struct patterns", Span__default_()))

    fn bind_variant_pattern_fields(_self: &mut LlvmGenerator, enum_name: String, variant: String, fields: &kain_core::ast::VariantPatternFields, scrutinee_val: String, scrutinee_ty: String, span: kain_core::Span) -> Result<(), KainError>:
        let payload_struct_name = f"{enum_name}_{variant}"
        if (!(*_self).struct_defs.contains_key(&payload_struct_name)):
            return Result::Ok(())
        let payload_ty = f"%{payload_struct_name}"
        let payload_ptr_ty = f"{payload_ty}*"
        let payload_ptr_ptr = (*_self).next_reg()
        (*_self).emit_(&f"  {payload_ptr_ptr} = getelementptr inbounds %{enum_name}, {scrutinee_ty} {scrutinee_val}, i32 0, i32 1")
        ()
        let payload_void = (*_self).next_reg()
        (*_self).emit_(&f"  {payload_void} = load i8*, i8** {payload_ptr_ptr}")
        ()
        let payload_ptr = (*_self).next_reg()
        (*_self).emit_(&f"  {payload_ptr} = bitcast i8* {payload_void} to {payload_ptr_ty}")
        ()
        match fields:
            kain_core__ast__VariantPatternFields::Unit => Result::Ok(())
            kain_core__ast__VariantPatternFields::Tuple(patterns) =>
                let field_defs = (*_self).struct_defs.get(&payload_struct_name).cloned().unwrap_or_default()
                for selfhost_for_item in patterns.iter().enumerate():
                    let (index, pattern) = selfhost_for_item
                    let field_ty = field_defs.get(index).map(fn(__kain_closure_arg4): __kain_closure_arg4.__kain_tuple_1.clone()).unwrap_or_else(fn(): ("i64").to_string())
                    let field_ptr = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds {payload_ty}, {payload_ptr_ty} {payload_ptr}, i32 0, i32 {index}")
                    ()
                    let field_val = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_val} = load {field_ty}, {field_ty}* {field_ptr}")
                    ()
                    (*_self).bind_local_pattern_value(pattern, field_val, field_ty)?
                    ()
                ()
                Result::Ok(())
            kain_core__ast__VariantPatternFields::Struct(named_patterns) =>
                let field_defs = (*_self).struct_defs.get(&payload_struct_name).cloned().unwrap_or_default()
                for selfhost_for_item in named_patterns:
                    let (field_name, pattern) = selfhost_for_item
                    let (index, field_ty) = field_defs.iter().enumerate().find(fn(__kain_closure_arg5): (__kain_closure_arg5.__kain_tuple_1.__kain_tuple_0 == field_name)).map(fn(__kain_closure_arg6): (__kain_closure_arg6.__kain_tuple_0, __kain_closure_arg6.__kain_tuple_1.__kain_tuple_1.clone())).ok_or_else(fn(): KainError__codegen(f"Unknown payload field '{field_name}' for {enum_name}::{variant}", span))?
                    let field_ptr = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds {payload_ty}, {payload_ptr_ty} {payload_ptr}, i32 0, i32 {index}")
                    ()
                    let field_val = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_val} = load {field_ty}, {field_ty}* {field_ptr}")
                    ()
                    (*_self).bind_local_pattern_value(pattern, field_val, field_ty)?
                    ()
                ()
                Result::Ok(())

    fn bind_match_pattern(_self: &mut LlvmGenerator, pattern: &kain_core::ast::Pattern, scrutinee_val: String, scrutinee_ty: String, enum_name: Option<String>, span: kain_core::Span) -> Result<(), KainError>:
        match pattern:
            kain_core__ast__Pattern::Wildcard(_) => Result::Ok(())
            kain_core__ast__Pattern::Binding {  } => (*_self).bind_local_pattern_value(pattern, scrutinee_val.to_string(), scrutinee_ty.to_string())
            kain_core__ast__Pattern::Tuple(_, _) => (*_self).bind_local_pattern_value(pattern, scrutinee_val.to_string(), scrutinee_ty.to_string())
            kain_core__ast__Pattern::Struct {  } => (*_self).bind_local_pattern_value(pattern, scrutinee_val.to_string(), scrutinee_ty.to_string())
            kain_core__ast__Pattern::Variant { variant: variant, fields: fields } =>
                let enum_name = enum_name.ok_or_else(fn(): KainError__codegen("Variant pattern requires an enum scrutinee", span))?
                (*_self).bind_variant_pattern_fields(enum_name, variant, fields, scrutinee_val, scrutinee_ty, span)
            kain_core__ast__Pattern::Or(_, _) => Result::Ok(())
            kain_core__ast__Pattern::Literal(_) => Result::Ok(())
            kain_core__ast__Pattern::Range {  } => Result::Ok(())
            other => Result::Err(KainError__codegen(f"Unsupported LLVM match binding pattern: {other}", span))

    fn ptr_struct_name<a>(_self: &LlvmGenerator, ty: String) -> Option<String>:
        if (ty.starts_with("%") && ty.ends_with("*")):
            Option::Some(&ty[1..(ty.len() - 1)])
        else:
            none

    fn field_index(_self: &LlvmGenerator, struct_name: String, field: String) -> Option<usize>:
        ((*_self).struct_defs.get(struct_name)?).iter().position(fn(__kain_closure_arg7): (__kain_closure_arg7.__kain_tuple_0 == field))

    fn compile_temporary_address(_self: &mut LlvmGenerator, expr: &kain_core::ast::Expr) -> Result<(String, String), KainError>:
        let (val, ty) = (*_self).compile_expr(expr)?
        let addr = f"%tmp.addr.{(*_self).reg_count}"
        (*_self).reg_count = ((*_self).reg_count + 1)
        ()
        (*_self).emit_(&f"  {addr} = alloca {ty}")
        ()
        (*_self).emit_(&f"  store {ty} {val}, {ty}* {addr}")
        ()
        Result::Ok((addr, ty))

    fn compile_index_address_from_compiled(_self: &mut LlvmGenerator, obj_val: String, obj_ty: String, idx_val: String, span: kain_core::Span) -> Result<(String, String), KainError>:
        match obj_ty.strip_suffix("*"):
            Some(pointee_ty) =>
                let field_ptr = (*_self).next_reg()
                (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds {pointee_ty}, {obj_ty} {obj_val}, i64 {idx_val}")
                ()
                Result::Ok((field_ptr, pointee_ty.to_string()))
            _ =>
                if (obj_ty == "i64"):
                    let base_ptr = (*_self).next_reg()
                    (*_self).emit_(&f"  {base_ptr} = inttoptr i64 {obj_val} to i64*")
                    ()
                    let field_ptr = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds i64, i64* {base_ptr}, i64 {idx_val}")
                    ()
                    Result::Ok((field_ptr, ("i64").to_string()))
                else:
                    Result::Err(KainError__codegen(f"Indexing is not supported for LLVM type {obj_ty}", span))

    fn compile_addressable_ptr(_self: &mut LlvmGenerator, expr: &kain_core::ast::Expr) -> Result<(String, String), KainError>:
        match expr:
            kain_core__ast__Expr::Ident(name, span) => (*_self).locals.get(name).cloned().map(fn(__kain_closure_arg8): (__kain_closure_arg8.__kain_tuple_0, __kain_closure_arg8.__kain_tuple_1)).ok_or_else(fn(): KainError__codegen(f"Undefined variable: {name}", (*span)))
            kain_core__ast__Expr::Field { object: object, field: field, span: span } =>
                let (obj_val, obj_ty) = (*_self).compile_expr(object)?
                match (*_self).ptr_struct_name(&obj_ty).map(fn(name): name.to_string()):
                    Some(struct_name) =>
                        match (*_self).field_index(&struct_name, field):
                            Some(index) =>
                                let field_ty = (*_self).struct_defs.get(&struct_name).and_then(fn(fields): fields.get(index)).map(fn(__kain_closure_arg9): __kain_closure_arg9.__kain_tuple_1.clone()).unwrap_or_else(fn(): ("i64").to_string())
                                let field_ptr = (*_self).next_reg()
                                (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds %{struct_name}, {obj_ty} {obj_val}, i32 0, i32 {index}")
                                ()
                                Result::Ok((field_ptr, field_ty))
                            _ => Result::Err(KainError__codegen(f"Unknown field '{field}' on {struct_name}", (*span)))
                    _ => Result::Err(KainError__codegen("Field address requires a struct pointer", (*span)))
            kain_core__ast__Expr::Index { object: object, index: index, span: span } =>
                let (obj_val, obj_ty) = (*_self).compile_expr(object)?
                let (idx_val, _) = (*_self).compile_expr(index)?
                if (obj_ty == "i8*"):
                    Result::Err(KainError__codegen("Runtime array indexing is not addressable in LLVM", (*span)))
                else:
                    (*_self).compile_index_address_from_compiled(&obj_val, &obj_ty, &idx_val, (*span))
            _ => (*_self).compile_temporary_address(expr)

    fn compile_lowered_helper_call(_self: &mut LlvmGenerator, func_name: String, args: &[kain_core::ast::CallArg], span: kain_core::Span) -> Option<Result<(String, String), KainError>>:
        match func_name:
            "__kain_bind_local" =>
                if (args.len() != 1):
                    return Option::Some(Result::Err(KainError__codegen("__kain_bind_local expects 1 argument", span)))
                let (addr, ty) = match &args[0].value:
                    kain_core__ast__Expr::Ident(name, arg_span) =>
                        match (*_self).locals.get(name).cloned():
                            Some(pair) => pair
                            None => return Option::Some(Result::Err(KainError__codegen(f"Undefined variable: {name}", (*arg_span))))
                    other =>
                        match (*_self).compile_temporary_address(other):
                            Ok(pair) => pair
                            Err(err) => return Option::Some(Result::Err(err))
                let ptr_i8 = (*_self).next_reg()
                (*_self).emit_(&f"  {ptr_i8} = bitcast {ty}* {addr} to i8*")
                ()
                let result = (*_self).next_reg()
                (*_self).emit_(&f"  {result} = call i8* @__kain_bind_local(i8* {ptr_i8})")
                ()
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = ptrtoint i8* {result} to i64")
                ()
                Option::Some(Result::Ok((res, ("i64").to_string())))
            "__kain_addr_of" =>
                if (args.len() < 1):
                    return Option::Some(Result::Err(KainError__codegen("__kain_addr_of expects at least 1 argument", span)))
                let (addr, ty) = match (*_self).compile_addressable_ptr(&args[0].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let ptr_i8 = (*_self).next_reg()
                (*_self).emit_(&f"  {ptr_i8} = bitcast {ty}* {addr} to i8*")
                ()
                let size = if (args.len() > 1):
                    match (*_self).compile_expr(&args[1].value):
                        Ok((val, _)) => val
                        Err(err) => return Option::Some(Result::Err(err))
                else:
                    ("8").to_string()
                let result = (*_self).next_reg()
                (*_self).emit_(&f"  {result} = call i8* @__kain_addr_of(i8* {ptr_i8}, i64 {size})")
                ()
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = ptrtoint i8* {result} to i64")
                ()
                Option::Some(Result::Ok((res, ("i64").to_string())))
            "__kain_mem_load" =>
                if (args.len() != 1):
                    return Option::Some(Result::Err(KainError__codegen("__kain_mem_load expects 1 argument", span)))
                Option::Some((*_self).compile_runtime_mem_load(&args[0].value, "i64", span))
            "__kain_mem_store" =>
                if (args.len() != 2):
                    return Option::Some(Result::Err(KainError__codegen("__kain_mem_store expects 2 arguments", span)))
                Option::Some((*_self).compile_runtime_mem_store(&args[0].value, &args[1].value, span))
            "__kain_field_ptr" =>
                if (args.len() != 3):
                    return Option::Some(Result::Err(KainError__codegen("__kain_field_ptr expects 3 arguments (ptr, field_name, offset)", span)))
                let compiled_base = match (*_self).compile_expr(&args[0].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let base_i64 = (*_self).coerce_to_i64_storage(&compiled_base.field_0, &compiled_base.field_1)
                let field_name = match &args[1].value:
                    kain_core__ast__Expr::String(s, _) => s.clone()
                    _ => ("unknown").to_string()
                let (field_str, _) = (*_self).compile_string_literal(&field_name)
                let (offset, _) = match (*_self).compile_expr(&args[2].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let base_ptr = (*_self).next_reg()
                (*_self).emit_(&f"  {base_ptr} = inttoptr i64 {base_i64} to i8*")
                ()
                let result = (*_self).next_reg()
                (*_self).emit_(&f"  {result} = call i8* @__kain_field_ptr(i8* {base_ptr}, i8* {field_str}, i64 {offset})")
                ()
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = ptrtoint i8* {result} to i64")
                ()
                Option::Some(Result::Ok((res, ("i64").to_string())))
            "__kain_index_ptr" =>
                if (args.len() != 3):
                    return Option::Some(Result::Err(KainError__codegen("__kain_index_ptr expects 3 arguments (ptr, index, stride)", span)))
                let compiled_base = match (*_self).compile_expr(&args[0].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let base_i64 = (*_self).coerce_to_i64_storage(&compiled_base.field_0, &compiled_base.field_1)
                let (index, _) = match (*_self).compile_expr(&args[1].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let (stride, _) = match (*_self).compile_expr(&args[2].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let base_ptr = (*_self).next_reg()
                (*_self).emit_(&f"  {base_ptr} = inttoptr i64 {base_i64} to i8*")
                ()
                let result = (*_self).next_reg()
                (*_self).emit_(&f"  {result} = call i8* @__kain_index_ptr(i8* {base_ptr}, i64 {index}, i64 {stride})")
                ()
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = ptrtoint i8* {result} to i64")
                ()
                Option::Some(Result::Ok((res, ("i64").to_string())))
            "__kain_ptr_offset" =>
                if (args.len() != 3):
                    return Option::Some(Result::Err(KainError__codegen("__kain_ptr_offset expects 3 arguments (ptr, offset, stride)", span)))
                let compiled_base = match (*_self).compile_expr(&args[0].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let base_i64 = (*_self).coerce_to_i64_storage(&compiled_base.field_0, &compiled_base.field_1)
                let (offset, _) = match (*_self).compile_expr(&args[1].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let (stride, _) = match (*_self).compile_expr(&args[2].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let base_ptr = (*_self).next_reg()
                (*_self).emit_(&f"  {base_ptr} = inttoptr i64 {base_i64} to i8*")
                ()
                let result = (*_self).next_reg()
                (*_self).emit_(&f"  {result} = call i8* @__kain_ptr_offset(i8* {base_ptr}, i64 {offset}, i64 {stride})")
                ()
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = ptrtoint i8* {result} to i64")
                ()
                Option::Some(Result::Ok((res, ("i64").to_string())))
            "__kain_alloc" =>
                if (args.len() != 3):
                    return Option::Some(Result::Err(KainError__codegen("__kain_alloc expects 3 arguments (size, stride, zeroed)", span)))
                let (size, _) = match (*_self).compile_expr(&args[0].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let (stride, _) = match (*_self).compile_expr(&args[1].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let (zeroed, _) = match (*_self).compile_expr(&args[2].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let result = (*_self).next_reg()
                (*_self).emit_(&f"  {result} = call i8* @__kain_alloc(i64 {size}, i64 {stride}, i32 {zeroed})")
                ()
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = ptrtoint i8* {result} to i64")
                ()
                Option::Some(Result::Ok((res, ("i64").to_string())))
            "__kain_realloc" =>
                if (args.len() != 4):
                    return Option::Some(Result::Err(KainError__codegen("__kain_realloc expects 4 arguments (ptr, size, stride, zeroed_new)", span)))
                let (ptr, ptr_ty) = match (*_self).compile_expr(&args[0].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let ptr_i64 = (*_self).coerce_to_i64_storage(&ptr, &ptr_ty)
                let (size, _) = match (*_self).compile_expr(&args[1].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let (stride, _) = match (*_self).compile_expr(&args[2].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let (zeroed_new, _) = match (*_self).compile_expr(&args[3].value):
                    Ok(pair) => pair
                    Err(err) => return Option::Some(Result::Err(err))
                let ptr_i8 = (*_self).next_reg()
                (*_self).emit_(&f"  {ptr_i8} = inttoptr i64 {ptr_i64} to i8*")
                ()
                let result = (*_self).next_reg()
                (*_self).emit_(&f"  {result} = call i8* @__kain_realloc(i8* {ptr_i8}, i64 {size}, i64 {stride}, i32 {zeroed_new})")
                ()
                let res = (*_self).next_reg()
                (*_self).emit_(&f"  {res} = ptrtoint i8* {result} to i64")
                ()
                Option::Some(Result::Ok((res, ("i64").to_string())))
            _ => none

    fn jsx_span(_self: &LlvmGenerator, node: &kain_core::ast::JSXNode) -> kain_core::Span:
        match node:
            kain_core__ast__JSXNode::Element { span: span } => (*span)
            kain_core__ast__JSXNode::Text(_, span) => (*span)
            kain_core__ast__JSXNode::ComponentCall { span: span } => (*span)
            kain_core__ast__JSXNode::For { span: span } => (*span)
            kain_core__ast__JSXNode::If { span: span } => (*span)
            kain_core__ast__JSXNode::Fragment(_, span) => (*span)
            kain_core__ast__JSXNode::Expression(expr) => expr.span()

    fn compile_jsx(_self: &mut LlvmGenerator, node: &kain_core::ast::JSXNode) -> Result<(String, String), KainError>:
        match node:
            kain_core__ast__JSXNode::Text(text, _) => Result::Ok((*_self).compile_string_literal(text))
            kain_core__ast__JSXNode::Expression(expr) =>
                let (val, ty) = (*_self).compile_expr(expr)?
                (*_self).stringify_value(&val, &ty)
            kain_core__ast__JSXNode::Fragment(children, _) =>
                let (mut acc, _) = (*_self).compile_string_literal("")
                for child in children:
                    let (child_val, _) = (*_self).compile_jsx(child)?
                    acc = (*_self).concat_strings(&acc, &child_val)
                    ()
                ()
                Result::Ok((acc, ("i8*").to_string()))
            kain_core__ast__JSXNode::Element { tag: tag, attributes: attributes, children: children } =>
                let (mut acc, _) = (*_self).compile_string_literal(&f"<{tag}")
                for attr in attributes:
                    match &attr.value:
                        kain_core__ast__JSXAttrValue::String(value) =>
                            let (piece, _) = (*_self).compile_string_literal(&f" {attr.name}=\"{value}\"")
                            acc = (*_self).concat_strings(&acc, &piece)
                            ()
                        kain_core__ast__JSXAttrValue::Bool(true) =>
                            let (piece, _) = (*_self).compile_string_literal(&f" {attr.name}")
                            acc = (*_self).concat_strings(&acc, &piece)
                            ()
                        kain_core__ast__JSXAttrValue::Bool(false) => ()
                        kain_core__ast__JSXAttrValue::Expr(expr) =>
                            let (prefix, _) = (*_self).compile_string_literal(&f" {attr.name}=\"")
                            acc = (*_self).concat_strings(&acc, &prefix)
                            ()
                            let (value, ty) = (*_self).compile_expr(expr)?
                            let (value_str, _) = (*_self).stringify_value(&value, &ty)?
                            acc = (*_self).concat_strings(&acc, &value_str)
                            ()
                            let (suffix, _) = (*_self).compile_string_literal("\"")
                            acc = (*_self).concat_strings(&acc, &suffix)
                            ()
                ()
                let (open_end, _) = (*_self).compile_string_literal(">")
                acc = (*_self).concat_strings(&acc, &open_end)
                ()
                for child in children:
                    let (child_val, _) = (*_self).compile_jsx(child)?
                    acc = (*_self).concat_strings(&acc, &child_val)
                    ()
                ()
                let (close, _) = (*_self).compile_string_literal(&f"</{tag}>")
                acc = (*_self).concat_strings(&acc, &close)
                ()
                Result::Ok((acc, ("i8*").to_string()))
            kain_core__ast__JSXNode::ComponentCall { name: name, props: props, children: children, span: span } =>
                let defs = (*_self).component_defs.get(name).cloned().unwrap_or_default()
                let mut compiled_args = Vec__new_()
                let mut arg_types = Vec__new_()
                for selfhost_for_item in defs:
                    let (prop_name, prop_ty) = selfhost_for_item
                    match props.iter().find(fn(prop): (prop.name == prop_name)):
                        Some(prop) =>
                            match &prop.value:
                                kain_core__ast__JSXAttrValue::String(value) =>
                                    let (val, ty) = (*_self).compile_string_literal(value)
                                    compiled_args.push(val)
                                    ()
                                    arg_types.push(if (prop_ty == "i8*"): ty else: prop_ty.clone())
                                    ()
                                kain_core__ast__JSXAttrValue::Bool(value) =>
                                    compiled_args.push(if (*value): ("1").into() else: ("0").into())
                                    ()
                                    arg_types.push(prop_ty.clone())
                                    ()
                                kain_core__ast__JSXAttrValue::Expr(expr) =>
                                    let (val, ty) = (*_self).compile_expr(expr)?
                                    compiled_args.push(val)
                                    ()
                                    arg_types.push(ty)
                                    ()
                        _ =>
                            compiled_args.push((*_self).zero_value_for_ty(&prop_ty))
                            ()
                            arg_types.push(prop_ty.clone())
                            ()
                ()
                let (children_val, children_ty) = (*_self).compile_jsx(&kain_core__ast__JSXNode::Fragment(children.clone(), (*span)))?
                compiled_args.push(children_val)
                ()
                arg_types.push(children_ty)
                ()
                let res = (*_self).next_reg()
                let arg_str = compiled_args.iter().zip(arg_types.iter()).map(fn(__kain_closure_arg10): f"{__kain_closure_arg10.__kain_tuple_1} {__kain_closure_arg10.__kain_tuple_0}").collect().join(", ")
                (*_self).emit_(&f"  {res} = call i8* @{name}({arg_str})")
                ()
                Result::Ok((res, ("i8*").to_string()))
            kain_core__ast__JSXNode::For { binding: binding, iter: iter, body: body } =>
                let (iter_val, iter_ty) = (*_self).compile_expr(iter)?
                let _ = binding
                let _ = body
                (*_self).stringify_value(&iter_val, &iter_ty)
            kain_core__ast__JSXNode::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                let then_span = (*_self).jsx_span(then_branch)
                let expr = kain_core__ast__Expr::If { condition: condition.clone(), then_branch: kain_core::ast::Block { stmts: [kain_core__ast__Stmt::Expr(kain_core__ast__Expr::JSX(((*(*then_branch))).clone(), then_span))], span: then_span }, else_branch: else_branch.map(fn(branch): none), span: then_span }
                (*_self).compile_expr(&expr)

    fn hash_message_tag(_self: &LlvmGenerator, actor_: String, msg: String) -> i64:
        let s = f"{actor_}_{msg}"
        let mut hash: i64 = 5381
        for c in s.bytes():
            hash = ((((hash << 5)).wrapping_add(hash)) ^ (c as i64))
            ()
        ()
        hash

    fn callable_signature(_self: &LlvmGenerator, resolved_type: &kain_core::types::ResolvedType, callable_name: String, span: kain_core::Span) -> Result<(Array<kain_core::types::ResolvedType>, String), KainError>:
        let kain_core__types__ResolvedType::Function { params: params, ret: ret } = resolved_type
        let mut ret_type = (*_self).map_type(ret)
        if ((ret_type == "void") && (callable_name != "main")):
            ret_type = ("i64").to_string()
            ()
            ()
            ()
            ()
        Result::Ok((params.clone(), ret_type))

    fn extern_callable_signature(_self: &LlvmGenerator, resolved_type: &kain_core::types::ResolvedType, callable_name: String, span: kain_core::Span) -> Result<(Array<kain_core::types::ResolvedType>, String), KainError>:
        let kain_core__types__ResolvedType::Function { params: params, ret: ret } = resolved_type
        Result::Ok((params.clone(), (*_self).map_type(ret)))

    fn function_is_extern(func: &kain_core::types::TypedFunction) -> Bool:
        (*func).ast.attributes.iter().any(fn(attr): (attr.name == "extern"))

    fn register_world_type_and_global(_self: &mut LlvmGenerator, world: &kain_core::types::TypedWorld) -> Result<(), KainError>:
        let mut fields = Vec__new_()
        for state_ in &(*world).ast.states:
            fields.push((state_.name.clone(), (*_self).map_type_from_ast(&state_.ty)))
            ()
        ()
        (*_self).struct_defs.insert((*world).ast.name.clone(), fields.clone())
        ()
        let field_types: Array<String> = fields.iter().map(fn(__kain_closure_arg11): __kain_closure_arg11.__kain_tuple_1.clone()).collect()
        (*_self).emit_(&"%{(*world).ast.name} = type { {field_types.join(\", \")} }")
        ()
        let global_symbol = f"@__kain_world_{(*world).ast.name}"
        let init_flag_symbol = f"@__kain_world_init_flag_{(*world).ast.name}"
        let init_fn_name = f"__kain_init_world_{(*world).ast.name}"
        (*_self).world_globals.insert((*world).ast.name.clone(), WorldGlobalInfo { global_symbol: global_symbol.clone(), init_flag_symbol: init_flag_symbol.clone(), init_fn_name: init_fn_name })
        ()
        (*_self).emit_(&f"{global_symbol} = internal global %{(*world).ast.name} zeroinitializer")
        ()
        (*_self).emit_(&f"{init_flag_symbol} = internal global i1 0")
        ()
        (*_self).emit_("")
        ()
        Result::Ok(())

    fn compile_module(_self: &mut LlvmGenerator, program: &kain_core::types::TypedProgram) -> Result<(), KainError>:
        (*_self).emit_("; ModuleID = 'KAIN'")
        ()
        (*_self).emit_("source_filename = \"KAIN\"")
        ()
        (*_self).emit_(&f"target datalayout = \"{(*_self).target.datalayout}\"")
        ()
        (*_self).emit_(&f"target triple = \"{(*_self).target.triple}\"")
        ()
        (*_self).emit_("")
        ()
        (*_self).collect_program_tuple_types(program)
        ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Struct(s) =>
                    let mut fields = Vec__new_()
                    for field in &s.ast.fields:
                        match s.field_types.get(&field.name):
                            Some(res_ty) =>
                                fields.push((field.name.clone(), (*_self).map_type(res_ty)))
                                ()
                            _ =>
                                fields.push((field.name.clone(), ("i64").into()))
                                ()
                    ()
                    (*_self).struct_defs.insert(s.ast.name.clone(), fields.clone())
                    ()
                    let field_types: Array<String> = fields.iter().map(fn(__kain_closure_arg12): __kain_closure_arg12.__kain_tuple_1.clone()).collect()
                    (*_self).emit_(&"%{s.ast.name} = type { {field_types.join(\", \")} }")
                    ()
                _ =>
                    match item:
                        kain_core__types__TypedItem::World(world) =>
                            (*_self).register_world_type_and_global(world)?
                            ()
                        _ =>
                            match item:
                                kain_core__types__TypedItem::Component(component_) =>
                                    let mut props = Vec__new_()
                                    for prop in &component_.ast.props:
                                        match component_.prop_types.get(&prop.name):
                                            Some(res_ty) =>
                                                props.push((prop.name.clone(), (*_self).map_type(res_ty)))
                                                ()
                                            _ =>
                                                props.push((prop.name.clone(), (*_self).map_type_from_ast(&prop.ty)))
                                                ()
                                    ()
                                    props.push((("children").to_string(), ("i8*").to_string()))
                                    ()
                                    (*_self).component_defs.insert(component_.ast.name.clone(), props.clone())
                                    ()
                                    (*_self).functions.insert(component_.ast.name.clone(), ("i8*").to_string())
                                    ()
                                _ =>
                                    match item:
                                        kain_core__types__TypedItem::Actor(a) =>
                                            let mut fields = Vec__new_()
                                            fields.push((("__mailbox").to_string(), ("i8*").into()))
                                            ()
                                            for state_ in &a.ast.state_:
                                                match a.state_types.get(&state_.name):
                                                    Some(res_ty) =>
                                                        fields.push((state_.name.clone(), (*_self).map_type(res_ty)))
                                                        ()
                                                    _ =>
                                                        fields.push((state_.name.clone(), ("i64").into()))
                                                        ()
                                            ()
                                            (*_self).struct_defs.insert(a.ast.name.clone(), fields.clone())
                                            ()
                                            let field_types: Array<String> = fields.iter().map(fn(__kain_closure_arg13): __kain_closure_arg13.__kain_tuple_1.clone()).collect()
                                            (*_self).emit_(&"%{a.ast.name} = type { {field_types.join(\", \")} }")
                                            ()
                                            for handler in &a.ast.handlers:
                                                let mut payload_fields = Vec__new_()
                                                let mut field_defs = Vec__new_()
                                                for param in &handler.params:
                                                    let p_ty = (*_self).map_type_from_ast(&param.ty)
                                                    payload_fields.push(p_ty.clone())
                                                    ()
                                                    field_defs.push((param.name.clone(), p_ty))
                                                    ()
                                                ()
                                                let msg_struct_name = f"{a.ast.name}_{handler.message_type}"
                                                (*_self).struct_defs.insert(msg_struct_name.clone(), field_defs)
                                                ()
                                                (*_self).emit_(&"%{msg_struct_name} = type { {payload_fields.join(\", \")} }")
                                                ()
                                        _ =>
                                            match item:
                                                kain_core__types__TypedItem::Enum(e) =>
                                                    (*_self).emit_(&"%{e.ast.name} = type { i64, i8* }")
                                                    ()
                                                    for selfhost_for_item in &e.variant_payload_types:
                                                        let (variant_name, payload_types) = selfhost_for_item
                                                        if (!payload_types.is_empty()):
                                                            let field_types: Array<String> = payload_types.iter().map(fn(t): (*_self).map_type(t)).collect()
                                                            let struct_name = f"{e.ast.name}_{variant_name}"
                                                            (*_self).emit_(&"%{struct_name} = type { {field_types.join(\", \")} }")
                                                            ()
                                                            let mut fields = Vec__new_()
                                                            for selfhost_for_item in field_types.iter().enumerate():
                                                                let (i, ty) = selfhost_for_item
                                                                fields.push((f"_{i}", ty.clone()))
                                                                ()
                                                            ()
                                                            (*_self).struct_defs.insert(struct_name, fields)
                                                            ()
                                                _ => ()
        ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Function(func) =>
                    if LlvmGenerator__function_is_extern(func):
                        let (params, ret_ty) = (*_self).extern_callable_signature(&func.resolved_type, &func.ast.name, func.ast.span)?
                        (*_self).functions.insert(func.ast.name.clone(), ret_ty.clone())
                        ()
                        (*_self).function_params.insert(func.ast.name.clone(), params.into_iter().map(fn(param): (*_self).map_type(&param)).collect())
                        ()
                        (*_self).extern_functions.insert(func.ast.name.clone())
