        for selfhost_for_item in strings:
            let (content, name) = selfhost_for_item
            let len = (content.len() + 1)
            let mut escaped = String__new_()
            for b in content.bytes():
                if ((((b >= 32) && (b < 127)) && (b != 34)) && (b != 92)):
                    escaped.push(b as Char)
