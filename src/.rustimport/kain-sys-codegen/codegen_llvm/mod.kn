            let has_rc_fields = fields.iter().any(fn(__kain_closure_arg16): ((__kain_closure_arg16.__kain_tuple_1 == "i8*") || __kain_closure_arg16.__kain_tuple_1.starts_with("%")))
            if (!has_rc_fields):
                continue
            let struct_ty = f"%{name}"
            let dtor_name = f"dtor_{name}"
            (*_self).emit_(&"define void @{dtor_name}(i8* %ptr_void) {")
            ()
            (*_self).emit_label("entry")
            ()
            let ptr_typed = (*_self).next_reg()
            (*_self).emit_(&f"  {ptr_typed} = bitcast i8* %ptr_void to {struct_ty}*")
            ()
            for selfhost_for_item in fields.iter().enumerate():
                let (i, (_, field_ty)) = selfhost_for_item
                if ((field_ty == "i8*") || field_ty.starts_with("%")):
                    let field_ptr = (*_self).next_reg()
                    (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds {struct_ty}, {struct_ty}* {ptr_typed}, i32 0, i32 {i}")
                    ()
