                                            let (_, ret_ty) = (*_self).callable_signature(&orchestrate.resolved_type, &orchestrate.ast.name, orchestrate.ast.span)?
                                            (*_self).functions.insert(orchestrate.ast.name.clone(), ret_ty)
                                            ()
