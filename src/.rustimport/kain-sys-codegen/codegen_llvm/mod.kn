    fn compile_patch(_self: &mut LlvmGenerator, patch: &kain_core::types::TypedPatch) -> Result<(), KainError>:
        (*_self).compile_named_callable(&(*patch).ast.name, &(*patch).ast.params, &(*patch).ast.body, &(*patch).resolved_type, (*patch).ast.span)

    fn compile_converge(_self: &mut LlvmGenerator, converge: &kain_core::types::TypedConverge) -> Result<(), KainError>:
        (*_self).compile_named_callable(&(*converge).ast.name, &(*converge).ast.params, &(*converge).ast.spec_lane.body, &(*converge).resolved_type, (*converge).ast.span)

    fn compile_world_initializer(_self: &mut LlvmGenerator, world: &kain_core::types::TypedWorld) -> Result<(), KainError>:
        (*_self).reg_count = 0
        ()
        (*_self).locals.clear()
        ()
        (*_self).scopes.clear()
        ()
        (*_self).current_return_type = Option::Some(("void").to_string())
        ()
        let Some(world_info) = (*_self).world_globals.get(&(*world).ast.name).cloned()
        (*_self).emit_(&"define void @{world_info.init_fn_name}() {")
        ()
        (*_self).emit_label("entry")
        ()
        let init_loaded = (*_self).next_reg()
        (*_self).emit_(&f"  {init_loaded} = load i1, i1* {world_info.init_flag_symbol}")
        ()
        let init_block = (*_self).next_label()
        let already_init_block = (*_self).next_label()
        (*_self).emit_(&f"  br i1 {init_loaded}, label %{already_init_block}, label %{init_block}")
        ()
        (*_self).emit_label(&init_block)
        ()
        let world_ptr_type = f"%{(*world).ast.name}*"
        for selfhost_for_item in (*world).ast.states.iter().enumerate():
            let (index, state_) = selfhost_for_item
            let field_ty = (*_self).map_type_from_ast(&state_.ty)
            let field_ptr = (*_self).next_reg()
            (*_self).emit_(&f"  {field_ptr} = getelementptr inbounds %{(*world).ast.name}, {world_ptr_type} {world_info.global_symbol}, i32 0, i32 {index}")
            ()
            let (initial_value, initial_ty) = (*_self).compile_expr_for_target_type(&state_.initial, &field_ty)?
            (*_self).emit_(&f"  store {initial_ty} {initial_value}, {field_ty}* {field_ptr}")
            ()
        ()
        (*_self).emit_(&f"  store i1 1, i1* {world_info.init_flag_symbol}")
        ()
        (*_self).emit_(&f"  br label %{already_init_block}")
        ()
        (*_self).emit_label(&already_init_block)
        ()
        (*_self).emit_("  ret void")
        ()
        (*_self).emit_("}")
        ()
        (*_self).emit_("")
        ()
        (*_self).current_return_type = none
        ()
        Result::Ok(())

    fn compile_orchestrate(_self: &mut LlvmGenerator, orchestrate: &kain_core::types::TypedOrchestrate) -> Result<(), KainError>:
        (*_self).compile_named_callable(&(*orchestrate).ast.name, &(*orchestrate).ast.params, &(*orchestrate).ast.body, &(*orchestrate).resolved_type, (*orchestrate).ast.span)

    fn compile_function(_self: &mut LlvmGenerator, func: &kain_core::types::TypedFunction) -> Result<(), KainError>:
        if LlvmGenerator__function_is_extern(func):
            return (*_self).compile_extern_function(func)
        (*_self).compile_named_callable(&(*func).ast.name, &(*func).ast.params, &(*func).ast.body, &(*func).resolved_type, (*func).ast.span)

    fn compile_extern_function(_self: &mut LlvmGenerator, func: &kain_core::types::TypedFunction) -> Result<(), KainError>:
        let (param_types, ret_type) = (*_self).extern_callable_signature(&(*func).resolved_type, &(*func).ast.name, (*func).ast.span)?
        let mut param_str = String__new_()
        let mut emitted_index = 0
        for selfhost_for_item in (*func).ast.params.iter().enumerate():
            let (index, _) = selfhost_for_item
            let param_ty = (*_self).map_type(&param_types[index])
            if (param_ty == "void"):
                continue
            if (emitted_index > 0):
                param_str.push_str(", ")
                ()
                ()
                ()
                ()
            param_str.push_str(&f"{param_ty} %arg{emitted_index}")
            ()
            emitted_index = (emitted_index + 1)
            ()
        ()
        (*_self).extern_functions.insert((*func).ast.name.clone())
        ()
        (*_self).functions.insert((*func).ast.name.clone(), ret_type.clone())
        ()
        (*_self).emit_(&f"declare {ret_type} @{(*func).ast.name}({param_str})")
        ()
        (*_self).emit_("")
        ()
        Result::Ok(())

    fn compile_block(_self: &mut LlvmGenerator, block: &kain_core::ast::Block) -> Result<(), KainError>:
        (*_self).scopes.push(Vec__new_())
        ()
        for stmt in &(*block).stmts:
            (*_self).compile_stmt(stmt)?
            ()
        ()
        (*_self).emit_scope_exit()
        ()
        Result::Ok(())

    fn compile_block_with_result(_self: &mut LlvmGenerator, block: &kain_core::ast::Block) -> Result<Option<(String, String)>, KainError>:
        (*_self).scopes.push(Vec__new_())
        ()
        let mut last_res = none
        let mut last_is_new = false
        for selfhost_for_item in (*block).stmts.iter().enumerate():
            let (i, stmt) = selfhost_for_item
            if (i == ((*block).stmts.len() - 1)):
                match stmt:
                    kain_core__ast__Stmt::Expr(expr) =>
                        let (val, ty) = (*_self).compile_expr(expr)?
                        last_res = Option::Some((val, ty))
                        ()
                        last_is_new = (*_self).is_new_object(expr)
                        ()
                    _ =>
                        (*_self).compile_stmt(stmt)?
                        ()
            else:
                (*_self).compile_stmt(stmt)?
                ()
        ()
        match &last_res:
            Some((val, ty)) =>
                if ((ty == "i8*") && (!last_is_new)):
                    (*_self).emit_(&f"  call void @rc_retain(i8* {val})")
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                ()
                ()
        (*_self).emit_scope_exit()
        ()
        Result::Ok(last_res)

    fn emit_release(_self: &mut LlvmGenerator, val: String, ty: String):
        if (ty == "i8*"):
            (*_self).emit_(&f"  call void @rc_release(i8* {val})")
            ()
        elif ty.starts_with("%"):
            let struct_name = &ty[1..]
            match (*_self).struct_defs.get(struct_name).cloned():
                Some(fields) =>
                    for selfhost_for_item in fields.iter().enumerate():
                        let (i, (_, field_ty)) = selfhost_for_item
                        if ((field_ty == "i8*") || field_ty.starts_with("%")):
                            let field_val = (*_self).next_reg()
                            (*_self).emit_(&f"  {field_val} = extractvalue {ty} {val}, {i}")
                            ()
                            (*_self).emit_release(&field_val, field_ty)
                            ()
                _ => ()

    fn emit_scope_exit(_self: &mut LlvmGenerator):
        match (*_self).scopes.pop():
            Some(vars) =>
                for var_name in vars.iter().rev():
                    match (*_self).locals.get(var_name).cloned():
                        Some((addr, ty)) =>
                            if ((ty == "i8*") || ty.starts_with("%")):
                                let tmp = (*_self).next_reg()
                                (*_self).emit_(&f"  {tmp} = load {ty}, {ty}* {addr}")
                                ()
                                (*_self).emit_release(&tmp, &ty)
                                ()
                        _ => ()
            _ => ()

    fn emit_all_scopes_cleanup(_self: &mut LlvmGenerator):
        let mut vars_to_release = Vec__new_()
        for scope in (*_self).scopes.iter().rev():
            for var_ in scope.iter().rev():
                vars_to_release.push(var_.clone())
                ()
        ()
        for var_name in vars_to_release:
            match (*_self).locals.get(&var_name).cloned():
                Some((addr, ty)) =>
                    if ((ty == "i8*") || ty.starts_with("%")):
                        let tmp = (*_self).next_reg()
                        (*_self).emit_(&f"  {tmp} = load {ty}, {ty}* {addr}")
                        ()
                        (*_self).emit_release(&tmp, &ty)
                        ()
                _ => ()

    fn is_new_object(_self: &LlvmGenerator, expr: &kain_core::ast::Expr) -> Bool:
        match expr:
            kain_core__ast__Expr::String(_) => true
            kain_core__ast__Expr::Array(_) => true
            kain_core__ast__Expr::Tuple(_) => true
            kain_core__ast__Expr::Struct {  } => true
            kain_core__ast__Expr::Call {  } => true
            kain_core__ast__Expr::Binary { op: op } => ((*op) == kain_core__ast__BinaryOp__Add)
            kain_core__ast__Expr::If {  } => true
            _ => false

    fn compile_stmt(_self: &mut LlvmGenerator, stmt: &kain_core::ast::Stmt) -> Result<(), KainError>:
        match stmt:
            kain_core__ast__Stmt::Let { pattern: pattern, value: value, ty: ty } =>
                match value:
                    Some(val_expr) =>
                        match pattern:
                            kain_core__ast__Pattern::Binding { name: name } =>
                                let target_ty = ty.map(fn(declared): (*_self).map_type_from_ast(declared))
                                let (val_reg, val_ty) = match target_ty:
                                    Some(target_ty) => (*_self).compile_expr_for_target_type(val_expr, target_ty)?
                                    _ => (*_self).compile_expr(val_expr)?
                                let addr_reg = f"%{name}.addr_{(*_self).reg_count}"
                                (*_self).reg_count = ((*_self).reg_count + 1)
                                ()
                                (*_self).emit_(&f"  {addr_reg} = alloca {val_ty}")
                                ()
                                (*_self).emit_(&f"  store {val_ty} {val_reg}, {val_ty}* {addr_reg}")
                                ()
                                if (val_ty == "i8*"):
                                    if (!(*_self).is_new_object(val_expr)):
                                        (*_self).emit_(&f"  call void @rc_retain(i8* {val_reg})")
                                        ()
                                        ()
                                        ()
                                        ()
                                    ()
                                (*_self).locals.insert(name.clone(), (addr_reg, val_ty))
                                ()
                                match (*_self).scopes.last_mut():
                                    Some(scope) =>
                                        scope.push(name.clone())
                                        ()
                                        ()
                                        ()
                                        ()
                                    _ =>
                                        ()
                                        ()
                                ()
                            _ =>
                                let (val_reg, val_ty) = (*_self).compile_expr(val_expr)?
                                (*_self).bind_local_pattern_value(pattern, val_reg, val_ty)?
                                ()
                                ()
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            kain_core__ast__Stmt::Expr(expr) =>
                let (val, ty) = (*_self).compile_expr(expr)?
                if ((((ty == "i8*") || ty.starts_with("%"))) && (*_self).is_new_object(expr)):
                    (*_self).emit_release(&val, &ty)
                    ()
                    ()
                    ()
                    ()
                ()
            kain_core__ast__Stmt::Return(expr, _) =>
                match expr:
                    Some(e) =>
                        let (val, ty) = match (*_self).current_return_type.clone():
                            Some(target_ty) => (*_self).compile_expr_for_target_type(e, &target_ty)?
                            _ => (*_self).compile_expr(e)?
                        if (ty == "i8*"):
                            (*_self).emit_(&f"  call void @rc_retain(i8* {val})")
                            ()
                            ()
                            ()
                            ()
                        (*_self).emit_all_scopes_cleanup()
                        ()
                        (*_self).emit_(&f"  ret {ty} {val}")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        (*_self).emit_all_scopes_cleanup()
                        ()
                        (*_self).emit_("  ret void")
                        ()
                        ()
                        ()
                        ()
                let dead_label = (*_self).next_label()
                (*_self).emit_label(&dead_label)
                ()
                ()
                ()
                ()
            kain_core__ast__Stmt::Break(_, _) =>
                match (*_self).loop_stack.last():
                    Some((_, break_label)) =>
                        (*_self).emit_(&f"  br label %{break_label}")
                        ()
                        let dead_label = (*_self).next_label()
                        (*_self).emit_label(&dead_label)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            kain_core__ast__Stmt::Continue(_) =>
                match (*_self).loop_stack.last():
                    Some((continue_label, _)) =>
                        (*_self).emit_(&f"  br label %{continue_label}")
                        ()
                        let dead_label = (*_self).next_label()
                        (*_self).emit_label(&dead_label)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            kain_core__ast__Stmt::While { condition: condition, body: body } =>
                let label_cond = (*_self).next_label()
                let label_body = (*_self).next_label()
                let label_end = (*_self).next_label()
                (*_self).emit_(&f"  br label %{label_cond}")
                ()
                (*_self).emit_label(&label_cond)
                ()
                let (cond_val, _) = (*_self).compile_expr(condition)?
                (*_self).emit_(&f"  br i1 {cond_val}, label %{label_body}, label %{label_end}")
                ()
                (*_self).emit_label(&label_body)
                ()
                (*_self).loop_stack.push((label_cond.clone(), label_end.clone()))
                ()
                (*_self).compile_block(body)?
                ()
                (*_self).loop_stack.pop()
                ()
                (*_self).emit_(&f"  br label %{label_cond}")
                ()
                (*_self).emit_label(&label_end)
                ()
                ()
                ()
                ()
            kain_core__ast__Stmt::Loop { body: body } =>
                let label_body = (*_self).next_label()
                let label_end = (*_self).next_label()
                (*_self).emit_(&f"  br label %{label_body}")
                ()
                (*_self).emit_label(&label_body)
                ()
                (*_self).loop_stack.push((label_body.clone(), label_end.clone()))
                ()
                (*_self).compile_block(body)?
                ()
                (*_self).loop_stack.pop()
                ()
                (*_self).emit_(&f"  br label %{label_body}")
                ()
                (*_self).emit_label(&label_end)
                ()
                ()
                ()
                ()
            kain_core__ast__Stmt::For { binding: binding, iter: iter, body: body, span: span } =>
                let (start_val, end_val) = match iter:
                    kain_core__ast__Expr::Call { callee: callee, args: args } =>
                        match callee:
                            kain_core__ast__Expr::Ident(name, _) =>
                                if ((name == "range") && (args.len() == 2)):
                                    let (s, _) = (*_self).compile_expr(&args[0].value)?
                                    let (e, _) = (*_self).compile_expr(&args[1].value)?
                                    (s, e)
                                else:
                                    return Result::Err(KainError__codegen("Unsupported call in for loop", (*span)))
                            _ => return Result::Err(KainError__codegen("Unsupported call in for loop", (*span)))
                    kain_core__ast__Expr::Range { start: start, end: end, inclusive: inclusive } =>
                        let s = match start:
                            Some(e) => ((*_self).compile_expr(e)?).field_0
                            _ => ("0").into()
                        let mut e = match end:
                            Some(e) => ((*_self).compile_expr(e)?).field_0
                            _ => ("9223372036854775807").into()
                        if (*inclusive):
                            let tmp = (*_self).next_reg()
                            (*_self).emit_(&f"  {tmp} = add i64 {e}, 1")
                            ()
                            e = tmp
                            ()
                            ()
                            ()
                            ()
                        (s, e)
                    _ => return Result::Err(KainError__codegen("Unsupported iterator in for loop", (*span)))
                let loop_var = match binding:
                    kain_core__ast__Pattern::Binding { name: name } => name
                    _ => "it"
                let var_addr = f"%{loop_var}.addr_{(*_self).reg_count}"
                (*_self).reg_count = ((*_self).reg_count + 1)
                ()
                (*_self).emit_(&f"  {var_addr} = alloca i64")
                ()
                (*_self).emit_(&f"  store i64 {start_val}, i64* {var_addr}")
                ()
                (*_self).locals.insert(loop_var.to_string(), (var_addr.clone(), ("i64").into()))
                ()
                let label_cond = (*_self).next_label()
                let label_body = (*_self).next_label()
                let label_step = (*_self).next_label()
                let label_end = (*_self).next_label()
                (*_self).emit_(&f"  br label %{label_cond}")
                ()
                (*_self).emit_label(&label_cond)
                ()
                let curr_val = (*_self).next_reg()
                (*_self).emit_(&f"  {curr_val} = load i64, i64* {var_addr}")
                ()
                let cond_res = (*_self).next_reg()
                (*_self).emit_(&f"  {cond_res} = icmp slt i64 {curr_val}, {end_val}")
                ()
                (*_self).emit_(&f"  br i1 {cond_res}, label %{label_body}, label %{label_end}")
                ()
                (*_self).emit_label(&label_body)
                ()
                (*_self).loop_stack.push((label_step.clone(), label_end.clone()))
                ()
                (*_self).compile_block(body)?
                ()
                (*_self).loop_stack.pop()
                ()
                (*_self).emit_(&f"  br label %{label_step}")
                ()
                (*_self).emit_label(&label_step)
                ()
                let val_before_inc = (*_self).next_reg()
                (*_self).emit_(&f"  {val_before_inc} = load i64, i64* {var_addr}")
                ()
                let val_after_inc = (*_self).next_reg()
                (*_self).emit_(&f"  {val_after_inc} = add i64 {val_before_inc}, 1")
                ()
                (*_self).emit_(&f"  store i64 {val_after_inc}, i64* {var_addr}")
                ()
                (*_self).emit_(&f"  br label %{label_cond}")
                ()
                (*_self).emit_label(&label_end)
                ()
                ()
                ()
                ()
            _ => ()
        Result::Ok(())

    fn compile_direct_call(_self: &mut LlvmGenerator, func_name: String, args: &[kain_core::ast::CallArg]) -> Result<(String, String), KainError>:
        let mut compiled_args = Vec__new_()
        let mut arg_types = Vec__new_()
        let is_extern = (*_self).extern_functions.contains(func_name)
        let param_types = (*_self).function_params.get(func_name).cloned()
        for selfhost_for_item in args.iter().enumerate():
            let (index, arg) = selfhost_for_item
            let param_ty = param_types.and_then(fn(types): types.get(index)).cloned().unwrap_or_default()
            if (is_extern && (param_ty == "void")):
                continue
            let (val, ty) = (*_self).compile_expr(&arg.value)?
            let needs_cast_to_i64 = ((((ty == "i8*") || ty.starts_with("%"))) && (((((((func_name == "push") && (index == 1))) || (((func_name == "array_push") && (index == 1)))) || (((func_name == "array_set") && (index == 2)))) || (((func_name == "map_set") && (index == 2))))))
            if needs_cast_to_i64:
                let int_val = (*_self).next_reg()
                (*_self).emit_(&f"  {int_val} = ptrtoint {ty} {val} to i64")
                ()
                compiled_args.push(int_val)
                ()
                arg_types.push(("i64").to_string())
                ()
                continue
            compiled_args.push(val)
            ()
            arg_types.push(ty)
            ()
        ()
        let ret_ty = (*_self).functions.get(func_name).cloned().unwrap_or_else(fn(): ("i64").to_string())
        let arg_str = compiled_args.iter().zip(arg_types.iter()).map(fn(__kain_closure_arg18): f"{__kain_closure_arg18.__kain_tuple_1} {__kain_closure_arg18.__kain_tuple_0}").collect().join(", ")
        let callee_symbol = runtime_symbol_for_stdlib_function(func_name)
        if (ret_ty == "void"):
            (*_self).emit_(&f"  call void @{callee_symbol}({arg_str})")
            ()
            Result::Ok((("0").into(), ("i64").into()))
        else:
            let res = (*_self).next_reg()
            (*_self).emit_(&f"  {res} = call {ret_ty} @{callee_symbol}({arg_str})")
            ()
            Result::Ok((res, ret_ty))

    fn compile_expr(_self: &mut LlvmGenerator, expr: &kain_core::ast::Expr) -> Result<(String, String), KainError>:
        match expr:
            kain_core__ast__Expr::Int(n, _) => Result::Ok((n, ("i64").to_string()))
            kain_core__ast__Expr::Float(f, _) => Result::Ok((f, ("double").to_string()))
            kain_core__ast__Expr::Bool(b, _) => Result::Ok((if (*b): ("1").into() else: ("0").into(), ("i1").to_string()))
            kain_core__ast__Expr::String(s, _) => Result::Ok((*_self).compile_string_literal(s))
            kain_core__ast__Expr::FString(parts, _) =>
                let (mut acc, _) = (*_self).compile_string_literal("")
                for part in parts:
                    let (val, ty) = (*_self).compile_expr(part)?
                    let (text, _) = (*_self).stringify_value(&val, &ty)?
                    acc = (*_self).concat_strings(&acc, &text)
                    ()
                ()
                Result::Ok((acc, ("i8*").to_string()))
            kain_core__ast__Expr::None(_) => Result::Ok((("0").into(), ("i64").to_string()))
            kain_core__ast__Expr::JSX(node, _) => (*_self).compile_jsx(node)
            kain_core__ast__Expr::Paren(inner, _) => (*_self).compile_expr(inner)
            kain_core__ast__Expr::Block(block, _) => (*_self).compile_block_with_result(block).map(fn(res): res.unwrap_or((("0").into(), ("i64").into())))
            kain_core__ast__Expr::Cast { value: value, target: target } =>
                let dst_ty = (*_self).map_type_from_ast(target)
                match value:
                    kain_core__ast__Expr::Call { callee: callee, args: args, span: span } =>
                        match callee:
                            kain_core__ast__Expr::Ident(name, _) =>
                                if ((name == "__kain_mem_load") && (args.len() == 1)):
                                    return (*_self).compile_runtime_mem_load(&args[0].value, &dst_ty, (*span))
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                let (val, src_ty) = (*_self).compile_expr(value)?
                if (src_ty == dst_ty):
                    Result::Ok((val, dst_ty))
                elif ((src_ty == "i64") && (dst_ty == "double")):
                    let res = (*_self).next_reg()
                    (*_self).emit_(&f"  {res} = sitofp i64 {val} to double")
                    ()
                    Result::Ok((res, dst_ty))
                elif ((src_ty == "double") && (dst_ty == "i64")):
                    let res = (*_self).next_reg()
                    (*_self).emit_(&f"  {res} = fptosi double {val} to i64")
                    ()
                    Result::Ok((res, dst_ty))
                elif ((src_ty == "i1") && (dst_ty == "i64")):
                    let res = (*_self).next_reg()
                    (*_self).emit_(&f"  {res} = zext i1 {val} to i64")
                    ()
                    Result::Ok((res, dst_ty))
                elif ((src_ty == "i64") && (dst_ty == "i1")):
                    let res = (*_self).next_reg()
                    (*_self).emit_(&f"  {res} = icmp ne i64 {val}, 0")
                    ()
                    Result::Ok((res, dst_ty))
                elif ((src_ty == "i64") && dst_ty.ends_with("*")):
                    let res = (*_self).next_reg()
                    (*_self).emit_(&f"  {res} = inttoptr i64 {val} to {dst_ty}")
                    ()
                    Result::Ok((res, dst_ty))
                elif (src_ty.ends_with("*") && (dst_ty == "i64")):
                    let res = (*_self).next_reg()
                    (*_self).emit_(&f"  {res} = ptrtoint {src_ty} {val} to i64")
                    ()
                    Result::Ok((res, dst_ty))
                else:
                    Result::Ok((val, dst_ty))
            kain_core__ast__Expr::Ref { value: value } =>
                let (addr, ty) = (*_self).compile_addressable_ptr(value)?
                Result::Ok((addr, f"{ty}*"))
            kain_core__ast__Expr::AddrOf { value: value } =>
