        let self_ty = f"%{target_name}*"
        let mut ret_type = (*method).return_type.map(fn(ty): (*_self).map_type_from_ast(ty)).unwrap_or_else(fn(): ("void").to_string())
        if (ret_type == "void"):
            ret_type = ("i64").to_string()
            ()
            ()
            ()
            ()
        (*_self).current_return_type = Option::Some(ret_type.clone())
        ()
        let mut params = Vec__new_()
        params.push(f"{self_ty} %arg0")
        ()
        for selfhost_for_item in (*method).params.iter().enumerate():
            let (i, param) = selfhost_for_item
            params.push(f"{(*_self).map_type_from_ast(&param.ty)} %arg{(i + 1)}")
            ()
        ()
        (*_self).emit_(&"define {ret_type} @{target_name}_{(*method).name}({params.join(\", \")}) {")
