@derive(Debug, Default, serde__Deserialize)
struct NativeRuntimeManifest:
    name: Option<String>
    sources: Array<std::path::PathBuf>
    windows_sources: Array<std::path::PathBuf>
    linux_sources: Array<std::path::PathBuf>
    macos_sources: Array<std::path::PathBuf>
    include_dirs: Array<std::path::PathBuf>
    defines: Array<String>
    windows_defines: Array<String>
    linux_defines: Array<String>
    macos_defines: Array<String>
    archive_groups: Array<NativeRuntimeArchiveManifest>
    link: NativeRuntimeLinkManifest

impl Default for NativeRuntimeManifest:
    pub fn default_() -> NativeRuntimeManifest:
        NativeRuntimeManifest { name: none, sources: Vec__new_(), windows_sources: Vec__new_(), linux_sources: Vec__new_(), macos_sources: Vec__new_(), include_dirs: Vec__new_(), defines: Vec__new_(), windows_defines: Vec__new_(), linux_defines: Vec__new_(), macos_defines: Vec__new_(), archive_groups: Vec__new_(), link: NativeRuntimeLinkManifest__default_() }


@derive(Debug, Default, serde__Deserialize)
struct NativeRuntimeArchiveManifest:
    name: String
    source_prefixes: Array<std::path::PathBuf>

impl Default for NativeRuntimeArchiveManifest:
    pub fn default_() -> NativeRuntimeArchiveManifest:
        NativeRuntimeArchiveManifest { name: String__new_(), source_prefixes: Vec__new_() }


@derive(Debug, Default, serde__Deserialize)
struct NativeRuntimeLinkManifest:
    windows: Array<String>
    linux: Array<String>
    macos: Array<String>

impl Default for NativeRuntimeLinkManifest:
    pub fn default_() -> NativeRuntimeLinkManifest:
        NativeRuntimeLinkManifest { windows: Vec__new_(), linux: Vec__new_(), macos: Vec__new_() }


@derive(Debug)
struct ResolvedNativeRuntimeBundle:
    name: String
    sources: Array<std::path::PathBuf>
    include_dirs: Array<std::path::PathBuf>
    defines: Array<String>
    archive_groups: Array<ResolvedNativeRuntimeArchiveGroup>
    cache_root: std::path::PathBuf
    link_libs: Array<String>
    uses_cpp_runtime: Bool

@derive(Debug, Clone)
struct ResolvedNativeRuntimeArchiveGroup:
    name: String
    source_paths: Array<std::path::PathBuf>
    uses_cpp_runtime: Bool

@derive(Debug)
struct NativeRuntimeObjectCachePaths:
    object_path: std::path::PathBuf
    depfile_path: std::path::PathBuf
    fingerprint_path: std::path::PathBuf

@derive(Debug)
struct NativeRuntimeStaticArchivePaths:
    archive_path: std::path::PathBuf
    fingerprint_path: std::path::PathBuf

@derive(Debug, Default)
struct NativeRuntimeCompiledArtifacts:
    loose_objects: Array<std::path::PathBuf>
    static_archives: Array<std::path::PathBuf>

impl Default for NativeRuntimeCompiledArtifacts:
    pub fn default_() -> NativeRuntimeCompiledArtifacts:
        NativeRuntimeCompiledArtifacts { loose_objects: Vec__new_(), static_archives: Vec__new_() }


enum NativeRuntimeArchiverFlavor:
    GnuAr
    MsvcLib

@derive(Debug)
struct NativeRuntimeArchiver:
    command: String
    flavor: NativeRuntimeArchiverFlavor
    archive_ext: String

