use build::build_project

use build::build_rust_project

use config::*

use inject::inject_into_plugin

use registry::add_dependency

use registry::install_all

use ue5_pipeline::build_ue5_plugin

use ue5_pipeline::build_ue5_plugin_with_options

use crate::error::KainError

use crate::error::KainResult

use std::fs

use std::path::PathBuf

pub fn init_project(path: &std::path::PathBuf, name: Option<String>) -> Result<(), KainError>:
    if (!path.exists()):
        std__fs__create_dir_all(path).map_err(fn(e): KainError::Io(e))?
        ()
        ()
        ()
        ()
    let name = name.unwrap_or_else(fn(): path.file_name().and_then(fn(s): s.to_str()).unwrap_or("my_project").to_string())
    let manifest = PackageManifest__default_(&name)
    let toml = toml__to_string_pretty(&manifest).map_err(fn(e): KainError__runtime(f"Failed to serialize manifest: {e}"))?
    std__fs__write(path.join("KAIN.toml"), toml).map_err(fn(e): KainError::Io(e))?
    ()
    let src_dir = path.join("src")
    std__fs__create_dir_all(&src_dir).map_err(fn(e): KainError::Io(e))?
    ()
    let main_src = f"\n# {name} - Main Entry Point\n\nfn main():\n    println(\"Hello, KAIN World!\")\n"
    std__fs__write(src_dir.join("main.kn"), main_src.trim()).map_err(fn(e): KainError::Io(e))?
    ()
    std__fs__write(path.join(".gitignore"), "target/\ndeps/\n").map_err(fn(e): KainError::Io(e))?
    ()
    println(f" Initialized new KAIN project: {name}")
    Result::Ok(())

pub fn load_manifest(path: &std::path::PathBuf) -> Result<PackageManifest, KainError>:
    let manifest_path = if path.ends_with("KAIN.toml"):
        path.clone()
    else:
        path.join("KAIN.toml")
    if (!manifest_path.exists()):
        return Result::Err(KainError__runtime(f"No KAIN.toml found at {manifest_path.display()}"))
    let content = std__fs__read_to_string(&manifest_path).map_err(fn(e): KainError::Io(e))?
    let manifest: PackageManifest = toml__from_str(&content).map_err(fn(e): KainError__runtime(f"Failed to parse KAIN.toml: {e}"))?
    match manifest.ue5:
        Some(ue5) =>
            ue5.validate_module_configs().map_err(fn(e): KainError__runtime(f"Invalid [ue5.modules] configuration: {e}"))?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(manifest)

