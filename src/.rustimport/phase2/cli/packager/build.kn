use std::fs

use std::path::Path

use std::path::PathBuf

use crate::error::KainError

use crate::error::KainResult

use crate::rust_build

use crate::compile_

use crate::compile_hybrid_artifacts

use crate::compile_wasm_binary

use crate::parse_compile_target

use crate::target_extension

use serde::Serialize

use super::config::PackageManifest

@derive(Debug, serde__Serialize)
struct HybridBundleDescriptor:
    schema_version: u32
    target: String
    js: String
    ts: String
    wasm: String
    wasm_exports: Array<String>

fn patch_hybrid_wasm_reference(source: String, wasm_file_name: String) -> String:
    let wasm_url_expression = f"new URL('{wasm_file_name}', document.currentScript?.src ?? window.location.href).toString()"
    source.replace("'main.wasm'", &wasm_url_expression).replace("\"main.wasm\"", &wasm_url_expression)

fn write_hybrid_bundle(descriptor_path: &std::path::Path, artifacts: HybridArtifactOutput) -> Result<(), KainError>:
    let js_path = descriptor_path.with_extension("js")
    let ts_path = descriptor_path.with_extension("ts")
    let wasm_path = descriptor_path.with_extension("wasm")
    let wasm_file_name = wasm_path.file_name().and_then(fn(value): value.to_str()).ok_or_else(fn(): KainError__runtime(f"Invalid hybrid wasm path: {wasm_path.display()}"))?
    let js_file_name = js_path.file_name().and_then(fn(value): value.to_str()).ok_or_else(fn(): KainError__runtime(f"Invalid hybrid JS path: {js_path.display()}"))?
    let ts_file_name = ts_path.file_name().and_then(fn(value): value.to_str()).ok_or_else(fn(): KainError__runtime(f"Invalid hybrid TS path: {ts_path.display()}"))?
    let descriptor = HybridBundleDescriptor { schema_version: 1, target: "hybrid", js: js_file_name.to_string(), ts: ts_file_name.to_string(), wasm: wasm_file_name.to_string(), wasm_exports: artifacts.wasm_export_names }
    let descriptor_json = serde_json__to_string_pretty(&descriptor).map_err(fn(err): KainError__runtime(f"Failed to serialize hybrid bundle descriptor: {err}"))?
    std__fs__write(descriptor_path, descriptor_json).map_err(KainError__Io)?
    ()
    std__fs__write(&js_path, patch_hybrid_wasm_reference(artifacts.js, wasm_file_name)).map_err(KainError__Io)?
    ()
    std__fs__write(&ts_path, patch_hybrid_wasm_reference(artifacts.ts, wasm_file_name)).map_err(KainError__Io)?
    ()
    std__fs__write(&wasm_path, artifacts.wasm).map_err(KainError__Io)?
    ()
    println(f"   ✓ {descriptor_path.display()}")
    println(f"   ✓ {js_path.display()}")
    println(f"   ✓ {ts_path.display()}")
    println(f"   ✓ {wasm_path.display()}")
    Result::Ok(())

pub fn build_project(target_overrides: Option<Array<String>>) -> Result<(), KainError>:
    let cwd = std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from("."))
    let manifest = load_manifest(&cwd)?
    let targets = match target_overrides:
        Some(overrides) => overrides.clone()
        _ => manifest.build.targets.clone()
    if targets.is_empty():
        return Result::Err(KainError__runtime("No build targets specified"))
    build_targets(&manifest, &cwd, &targets)

pub fn build_rust_project() -> Result<(), KainError>:
    let cwd = std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from("."))
    let manifest = load_manifest(&cwd)?
    let config = manifest.r_rust.clone().unwrap_or_default()
    let entry_path = cwd.join(&manifest.build.entry)
    if (!entry_path.exists()):
        return Result::Err(KainError__runtime(f"Entry file not found: {entry_path.display()}"))
    let output_root = config.output.clone().map(fn(path): if path.is_absolute(): path else: cwd.join(path)).unwrap_or_else(fn(): cwd.join(&manifest.build.output).join("rust"))
    let written = rust_build__run_rust_build_pipeline(&entry_path, Option::Some(&output_root), Option::Some(&config))?
    for path in written:
        println(f"   ✓ {path.display()}")
    ()
    Result::Ok(())

fn build_targets(manifest: &PackageManifest, cwd: &std::path::PathBuf, targets: &[String]) -> Result<(), KainError>:
    let output_dir = cwd.join(&(*manifest).build.output)
    std__fs__create_dir_all(&output_dir).map_err(KainError__Io)?
    ()
    let entry_path = cwd.join(&(*manifest).build.entry)
    if (!entry_path.exists()):
        return Result::Err(KainError__runtime(f"Entry file not found: {entry_path.display()}"))
    let source = std__fs__read_to_string(&entry_path).map_err(KainError__Io)?
    for target_str in targets:
        let target = parse_target(target_str)?
        println(f"🎯 Building for target: {target}")
        let ext = target_extension(target)
        let output_file = output_dir.join(f"{(*manifest).package.name}.{ext}")
        match target:
            kain_core__CompileTarget::Wasm =>
                let output = compile_wasm_binary(&source)?
                std__fs__write(&output_file, output).map_err(KainError__Io)?
                ()
                println(f"   ✓ {output_file.display()}")
            kain_core__CompileTarget::Hybrid =>
                let artifacts = compile_hybrid_artifacts(&source)?
                write_hybrid_bundle(&output_file, artifacts)?
                ()
            _ =>
                let output = compile_(&source, target)?
                std__fs__write(&output_file, output).map_err(KainError__Io)?
                ()
                println(f"   ✓ {output_file.display()}")
    ()
    Result::Ok(())

fn parse_target(s: String) -> Result<kain_core::CompileTarget, KainError>:
    parse_compile_target(s).ok_or_else(fn(): KainError__runtime(f"Unknown target: {s}"))

