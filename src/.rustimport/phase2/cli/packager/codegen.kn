@doc(doc = " Helper function to enhance codegen errors with file:line:col location information")
fn enhance_codegen_result<T>(result: Result<T, KainError>, span_mapper: &kain_core::diagnostics::SpanMapper, file_path: String) -> Result<T, KainError>:
    result.map_err(fn(e): kain_core__diagnostics__enhance_error_with_location(e, span_mapper, file_path))

@derive(Debug, Clone, serde__Serialize, Default)
pub struct SymbolRoutingManifest:
    symbol_owner: Map<String, String>
    symbol_header: Map<String, String>
    symbol_output_stem: Map<String, String>
    output_name_collisions: Array<OutputNameCollision>

impl Default for SymbolRoutingManifest:
    pub fn default_() -> SymbolRoutingManifest:
        SymbolRoutingManifest { symbol_owner: HashMap__new_(), symbol_header: HashMap__new_(), symbol_output_stem: HashMap__new_(), output_name_collisions: Vec__new_() }


impl SymbolRoutingManifest:
    fn register_(_self: &mut SymbolRoutingManifest, symbol: String, module: String, include_path: String, output_stem: String):
        (*_self).symbol_owner.insert(symbol.to_string(), module.to_string())
        ()
        (*_self).symbol_header.insert(symbol.to_string(), include_path.replace("\\", "/"))
        ()
        (*_self).symbol_output_stem.insert(symbol.to_string(), output_stem.to_string())
        ()

    fn extend_from(_self: &mut SymbolRoutingManifest, other: &SymbolRoutingManifest):
        for selfhost_for_item in &(*other).symbol_owner:
            let (k, v) = selfhost_for_item
            (*_self).symbol_owner.insert(k.clone(), v.clone())
            ()
        ()
        for selfhost_for_item in &(*other).symbol_header:
            let (k, v) = selfhost_for_item
            (*_self).symbol_header.insert(k.clone(), v.clone())
            ()
        ()
        for selfhost_for_item in &(*other).symbol_output_stem:
            let (k, v) = selfhost_for_item
            (*_self).symbol_output_stem.insert(k.clone(), v.clone())
            ()
        ()
        (*_self).output_name_collisions.extend((*other).output_name_collisions.clone())
        ()


@derive(Debug, Clone, serde__Serialize)
pub struct OutputNameCollision:
    symbol: String
    requested_stem: String
    resolved_stem: String
    conflicting_symbol: String
    source_hint: Option<String>

@derive(Debug, Clone, Default)
struct OutputNameRegistry:
    resolved_for_symbol: Map<String, String>
    owner_for_resolved: Map<String, String>
    collisions: Array<OutputNameCollision>

impl Default for OutputNameRegistry:
    pub fn default_() -> OutputNameRegistry:
        OutputNameRegistry { resolved_for_symbol: HashMap__new_(), owner_for_resolved: HashMap__new_(), collisions: Vec__new_() }


impl OutputNameRegistry:
    fn resolve(_self: &mut OutputNameRegistry, symbol: String, requested_stem: String, bucket: String, symbol_source_map: &Map<String, std::path::PathBuf>) -> String:
        match (*_self).resolved_for_symbol.get(symbol):
            Some(existing) => return existing.clone()
            _ =>
                ()
                ()
        if (!(*_self).owner_for_resolved.contains_key(requested_stem)):
            (*_self).owner_for_resolved.insert(requested_stem.to_string(), symbol.to_string())
            ()
            (*_self).resolved_for_symbol.insert(symbol.to_string(), requested_stem.to_string())
            ()
            return requested_stem.to_string()
        let conflicting_symbol = (*_self).owner_for_resolved.get(requested_stem).cloned().unwrap_or_default()
        let source_hint = symbol_source_map.get(symbol).and_then(fn(path): path.file_stem()).and_then(fn(stem): stem.to_str()).map(sanitize_output_fragment).filter(fn(value): (!value.is_empty()))
        let mut candidates = Vec__new_()
        match source_hint:
            Some(hint) =>
                candidates.push(f"{requested_stem}{hint}")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let symbol_hint = sanitize_output_fragment(symbol)
        if (!symbol_hint.is_empty()):
            candidates.push(f"{requested_stem}{symbol_hint}")
            ()
            ()
            ()
            ()
        let bucket_hint = sanitize_output_fragment(bucket)
        if (!bucket_hint.is_empty()):
            candidates.push(f"{requested_stem}{bucket_hint}")
            ()
            ()
            ()
            ()
        let mut counter = 2
        loop:
            candidates.push(f"{requested_stem}{counter}")
            ()
            counter = (counter + 1)
            ()
            if (counter > 6):
                break
        ()
        let resolved_stem = candidates.into_iter().find(fn(candidate): (!(*_self).owner_for_resolved.contains_key(candidate))).unwrap_or_else(fn(): f"{requested_stem}{((*_self).owner_for_resolved.len() + 1)}")
        (*_self).owner_for_resolved.insert(resolved_stem.clone(), symbol.to_string())
        ()
        (*_self).resolved_for_symbol.insert(symbol.to_string(), resolved_stem.clone())
        ()
        (*_self).collisions.push(OutputNameCollision { symbol: symbol.to_string(), requested_stem: requested_stem.to_string(), resolved_stem: resolved_stem.clone(), conflicting_symbol: conflicting_symbol, source_hint: source_hint })
        ()
        resolved_stem


fn sanitize_output_fragment(value: String) -> String:
    let mut out_ = String__new_()
    let mut capitalize = true
    for ch in value.chars():
        if ch.is_ascii_alphanumeric():
            if capitalize:
                out_.push(ch.to_ascii_uppercase())
                ()
                capitalize = false
                ()
            else:
                out_.push(ch)
                ()
        else:
            capitalize = true
            ()
    ()
    out_

fn build_runtime_output_name_registry(program: &kain_core::types::TypedProgram, symbol_source_map: &Map<String, std::path::PathBuf>) -> OutputNameRegistry:
    let mut registry = OutputNameRegistry__default_()
    for item in &(*program).items:
        let (item_name, requested_output_name, bucket) = match item:
            kain_core__types__TypedItem::Actor(a) => (&a.ast.name, ue5__naming__to_actor_name(&a.ast.name), "actors")
            kain_core__types__TypedItem::Component(c) => (&c.ast.name, ue5__naming__to_component_name(&c.ast.name), "components")
            kain_core__types__TypedItem::Struct(s) => (&s.ast.name, ue5__naming__to_struct_name(&s.ast.name), "structs")
            kain_core__types__TypedItem::Enum(e) => (&e.ast.name, ue5__naming__to_enum_name(&e.ast.name), "enums")
            kain_core__types__TypedItem::StateMachine(sm) => (&sm.name, sm.name.clone(), "state_machines")
            kain_core__types__TypedItem::AsyncTask(at) => (&at.name, at.name.clone(), "async_tasks")
            _ => continue
        registry.resolve(item_name, &requested_output_name, bucket, symbol_source_map)
        ()
    ()
    registry

@derive(Debug, Clone)
struct ItemRoute:
    module_name: String
    public_dir: std::path::PathBuf
    private_dir: std::path::PathBuf
    include_prefix: String

fn normalize_path_for_match(path: &std::path::Path) -> String:
    path.to_string_lossy().replace("\\", "/")

fn wildcard_match(pattern: String, text: String) -> Bool:
    let p: Array<Char> = pattern.chars().collect()
    let t: Array<Char> = text.chars().collect()
    let (mut pi, mut ti, mut star_idx, mut match_idx) = (0, 0, none, 0)
    while (ti < t.len()):
        if ((pi < p.len()) && (((p[pi] == "?") || (p[pi] == t[ti])))):
            pi = (pi + 1)
            ()
            ti = (ti + 1)
            ()
        elif ((pi < p.len()) && (p[pi] == "*")):
            star_idx = Option::Some(pi)
            ()
            match_idx = ti
            ()
            pi = (pi + 1)
            ()
        else:
            match star_idx:
                Some(star) =>
                    pi = (star + 1)
                    ()
                    match_idx = (match_idx + 1)
                    ()
                    ti = match_idx
                    ()
                _ => return false
    ()
    while ((pi < p.len()) && (p[pi] == "*")):
        pi = (pi + 1)
        ()
    ()
    (pi == p.len())

fn source_matches_glob(source_path: &std::path::Path, glob: &std::path::Path) -> Bool:
    let source = normalize_path_for_match(source_path)
    let pat = normalize_path_for_match(glob)
    wildcard_match(&pat, &source)

fn default_runtime_module_name(config: &Ue5Config) -> Option<String>:
    (*config).modules.iter().find(fn(m): (none && (m.name == (*config).plugin_name))).or_else(fn(): (*config).modules.iter().find(fn(m): none)).or_else(fn(): (*config).modules.first()).map(fn(m): m.name.clone())

fn default_editor_module_name(config: &Ue5Config) -> Option<String>:
    (*config).modules.iter().find(fn(m): (m.module_type.is_editorish() && (m.name == f"{(*config).plugin_name}Editor"))).or_else(fn(): (*config).modules.iter().find(fn(m): m.module_type.is_editorish())).map(fn(m): m.name.clone())

fn resolve_item_module(config: &Ue5Config, symbol_name: String, is_editor_item: Bool, symbol_source_map: &Map<String, std::path::PathBuf>) -> Option<String>:
    if (!config.has_module_plan()):
        return none
    let source_path = symbol_source_map.get(symbol_name)
    match source_path:
        Some(src) =>
            for module in &(*config).modules:
                if module.source_globs.is_empty():
                    continue
                if module.source_globs.iter().any(fn(glob): (source_matches_glob(src, glob) || src.ends_with(glob))):
                    return Option::Some(module.name.clone())
            ()
            ()
        _ =>
            ()
            ()
    if is_editor_item:
        default_editor_module_name(config).or_else(fn(): default_runtime_module_name(config))
    else:
        default_runtime_module_name(config)

fn resolve_bucket_folder(module: &config::Ue5ModuleConfig, bucket: String) -> Option<std::path::PathBuf>:
    (*module).folders.get(bucket).cloned()

fn item_route(layout: &PluginLayout, config: &Ue5Config, symbol_name: String, is_editor_item: Bool, bucket: String, symbol_source_map: &Map<String, std::path::PathBuf>) -> ItemRoute:
    if (!config.has_module_plan()):
        if is_editor_item:
            let public_ = (*layout).editor_public_dir.clone().unwrap_or_else(fn(): (*layout).public_dir.join("Editor"))
            let private_ = (*layout).editor_private_dir.clone().unwrap_or_else(fn(): (*layout).private_dir.join("Editor"))
            return ItemRoute { module_name: f"{(*config).plugin_name}Editor", public_dir: public_, private_dir: private_, include_prefix: ("Editor").to_string() }
        return ItemRoute { module_name: (*config).plugin_name.clone(), public_dir: (*layout).public_dir.clone(), private_dir: (*layout).private_dir.clone(), include_prefix: String__new_() }
    let module_name = resolve_item_module(config, symbol_name, is_editor_item, symbol_source_map).unwrap_or_else(fn(): (*config).plugin_name.clone())
    let (mut public_dir, mut private_dir) = (*layout).module_dirs.get(&module_name).cloned().unwrap_or_else(fn(): ((*layout).public_dir.clone(), (*layout).private_dir.clone()))
    match (*config).modules.iter().find(fn(m): (m.name == module_name)):
        Some(module_cfg) =>
            match resolve_bucket_folder(module_cfg, bucket):
                Some(folder) =>
                    public_dir = public_dir.join(&folder)
                    ()
                    private_dir = private_dir.join(folder)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    ItemRoute { include_prefix: module_name.clone(), module_name: module_name, public_dir: public_dir, private_dir: private_dir }

fn build_include_path(route: &ItemRoute, filename: String, consumer_module: Option<String>) -> String:
    let mut include = filename.replace("\\", "/")
    let same_module = consumer_module.map(fn(m): (m == (*route).module_name)).unwrap_or(false)
    if ((!(*route).include_prefix.is_empty()) && (!same_module)):
        include = f"{(*route).include_prefix}/{include}"
        ()
        ()
        ()
        ()
    include

@doc(doc = " Compile shaders from the typed program into .usf/.h/.cpp files.")
pub fn compile_shaders(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram, shader_names: &[String]) -> Result<(), KainError>:
    if (!shader_names.is_empty()):
        eprintln(f"⚡ [PACKAGER] Found {shader_names.len()} shaders:")
        for name in shader_names:
            eprintln(f"   - {name}")
        ()
        println(f"⚡ Found {shader_names.len()} shaders:")
        for name in shader_names:
            println(f"   - {name}")
        ()
        println()
        match ue5_shaders__generate_shared_types_header(program, &(*config).plugin_name):
            Some(types_content) =>
                let types_path = (*layout).public_dir.join(f"{(*config).plugin_name}ShaderTypes.h")
                std__fs__write(&types_path, types_content).map_err(fn(e): KainError::Io(e))?
                ()
                println(f"   ✓ {(*config).plugin_name}ShaderTypes.h (shared POD mirror types)")
                ()
                ()
            _ =>
                ()
                ()
        let has_shared_library = match ue5_shaders__generate_shared_shader_library(program, &(*config).plugin_name):
            Some(ush_content) =>
                let ush_path = (*layout).shaders_dir.join(f"{(*config).plugin_name}Common.ush")
                std__fs__write(&ush_path, ush_content).map_err(fn(e): KainError::Io(e))?
                ()
                println(f"   ✓ {(*config).plugin_name}Common.ush (shared shader helpers)")
                true
            _ => false
        let ush_include = f"#include \"/Plugin/{(*config).plugin_name}/Shaders/{(*config).plugin_name}Common.ush\"\n"
        for shader_name in shader_names:
            eprintln(f"🔨 [PACKAGER] Compiling shader: {shader_name}")
            println(f"🔨 Compiling shader: {shader_name}")
            match ue5_shaders__compile_shader_artifacts(program, shader_name, &(*config).plugin_name):
                Ok(artifacts) =>
                    let usf_content = if has_shared_library:
                        let platform_include = "#include \"/Engine/Public/Platform.ush\"\n"
                        if artifacts.usf.contains(platform_include):
                            artifacts.usf.replacen(platform_include, &f"{platform_include}{&ush_include}", 1)
                        else:
                            f"{ush_include}{artifacts.usf}"
                    else:
                        artifacts.usf
                    let usf_path = (*layout).shaders_dir.join(f"{shader_name}.usf")
                    std__fs__write(&usf_path, usf_content).map_err(fn(e): KainError::Io(e))?
                    ()
                    println(f"   ✓ {shader_name}.usf")
                    let header_path = (*layout).public_dir.join(f"{shader_name}.h")
                    std__fs__write(&header_path, artifacts.header).map_err(fn(e): KainError::Io(e))?
                    ()
                    println(f"   ✓ {shader_name}.h")
                    let cpp_path = (*layout).private_dir.join(f"{shader_name}.cpp")
                    std__fs__write(&cpp_path, artifacts.cpp).map_err(fn(e): KainError::Io(e))?
                    ()
                    println(f"   ✓ {shader_name}.cpp")
                Err(e) =>
                    eprintln(f"   ✗ Failed to compile shader artifacts for {shader_name}: {e}")
                    continue
        ()
        ()
    else:
        println("ℹ\u{fe0f}  No shaders detected - skipping shader compilation")
        println()
        ()
        ()
    Result::Ok(())

@doc(doc = " Generate master header, delegate header, and EditorTypes header.")
@doc(doc = " Returns (master_header_path, delegate_count, type_headers).")
pub fn generate_headers(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram, symbol_source_map: &Map<String, std::path::PathBuf>) -> Result<(std::path::PathBuf, usize, Map<String, String>), KainError>:
    println("   📦 Generating master header with forward declarations...")
    let mut master_header = String__new_()
    master_header.push_str(&"// Copyright {Utc__now().year()} {(*config).copyright.unwrap_or(\"Epic Games, Inc.\")}. All Rights Reserved.\n")
    ()
    master_header.push_str("// Generated by KAIN-PRO - Godmode v3 (Modular Output)\n")
    ()
    master_header.push_str("// Master header - forward declarations and includes\n\n")
    ()
    master_header.push_str("#pragma once\n\n")
    ()
    master_header.push_str("#include \"CoreMinimal.h\"\n\n")
    ()
    master_header.push_str("// Forward declarations\n")
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(s) =>
                let is_editor = s.ast.attributes.iter().any(fn(a): ue5_editor__is_editor_attribute(&a.name))
                if (is_editor && (*layout).needs_split):
                    continue
                if s.ast.attributes.iter().any(fn(a): (a.name == "slate")):
                    let widget_name = f"S{s.ast.name}"
                    master_header.push_str(&f"class {widget_name};\n")
                    ()
                else:
                    let struct_name = ue5__naming__to_struct_name(&s.ast.name)
                    master_header.push_str(&f"struct {struct_name};\n")
                    ()
            kain_core__types__TypedItem::Enum(e) =>
                let enum_name = ue5__naming__to_enum_name(&e.ast.name)
                master_header.push_str(&f"enum class {enum_name} : uint8;\n")
                ()
            kain_core__types__TypedItem::Actor(a) =>
                let actor_name = ue5__naming__to_actor_name(&a.ast.name)
                master_header.push_str(&f"class {actor_name};\n")
                ()
            kain_core__types__TypedItem::Component(c) =>
                let comp_name = ue5__naming__to_component_name(&c.ast.name)
                master_header.push_str(&f"class {comp_name};\n")
                ()
            _ => ()
    ()
    let delegate_count = generate_delegate_header(layout, config, program)?
    generate_editor_types_header(layout, config, program, delegate_count)?
    ()
    master_header.push_str("\n// Module includes\n")
    ()
    if (delegate_count > 0):
        master_header.push_str(&f"#include \"{(*config).plugin_name}Delegates.h\"\n")
        ()
        ()
        ()
        ()
    let master_header_path = (*layout).public_dir.join(f"{(*config).plugin_name}.h")
    std__fs__write(&master_header_path, &master_header).map_err(fn(e): KainError::Io(e))?
    ()
    println(f"      ✓ {(*config).plugin_name}.h (master header with forward decls)")
    let mut type_headers = HashMap__new_()
    let output_registry = build_runtime_output_name_registry(program, symbol_source_map)
    for item in &(*program).items:
        let (item_name, output_name) = match item:
            kain_core__types__TypedItem::Actor(a) => (&a.ast.name, output_registry.resolved_for_symbol.get(&a.ast.name).cloned().unwrap_or_else(fn(): ue5__naming__to_actor_name(&a.ast.name)))
            kain_core__types__TypedItem::Component(c) => (&c.ast.name, output_registry.resolved_for_symbol.get(&c.ast.name).cloned().unwrap_or_else(fn(): ue5__naming__to_component_name(&c.ast.name)))
            kain_core__types__TypedItem::Struct(s) => (&s.ast.name, output_registry.resolved_for_symbol.get(&s.ast.name).cloned().unwrap_or_else(fn(): ue5__naming__to_struct_name(&s.ast.name)))
            kain_core__types__TypedItem::Enum(e) => (&e.ast.name, output_registry.resolved_for_symbol.get(&e.ast.name).cloned().unwrap_or_else(fn(): ue5__naming__to_enum_name(&e.ast.name)))
            kain_core__types__TypedItem::StateMachine(sm) => (&sm.name, output_registry.resolved_for_symbol.get(&sm.name).cloned().unwrap_or_else(fn(): sm.name.clone()))
            kain_core__types__TypedItem::AsyncTask(at) => (&at.name, output_registry.resolved_for_symbol.get(&at.name).cloned().unwrap_or_else(fn(): at.name.clone()))
            kain_core__types__TypedItem::TypeAlias(a) => (&a.ast.name, (*config).plugin_name)
            _ => continue
        type_headers.insert(item_name.clone(), f"{output_name}.h")
        ()
    ()
    Result::Ok((master_header_path, delegate_count, type_headers))

@doc(doc = " Generate the delegate header file. Returns the number of delegates generated.")
fn generate_delegate_header(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram) -> Result<usize, KainError>:
    let mut delegate_header_content = String__new_()
    let mut delegate_count = 0
    let mut delegate_type_dependencies: Set<String> = HashSet__new_()
    let mut type_mapper = TypeMapper__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Enum(e) =>
                type_mapper.register_enum(e.ast.name.clone())
                ()
            kain_core__types__TypedItem::Struct(s) => if s.ast.attributes.iter().any(fn(a): (a.name == "component")): none else: none
            kain_core__types__TypedItem::Actor(a) =>
                type_mapper.register_actor(a.ast.name.clone())
                ()
            kain_core__types__TypedItem::Component(c) =>
                type_mapper.register_component(c.ast.name.clone())
                ()
            kain_core__types__TypedItem::TypeAlias(alias) =>
                if (none):
                    type_mapper.register_delegate(alias.ast.name.clone())
                    ()
            _ => ()
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::TypeAlias(alias) =>
                match &alias.ast.target:
                    kain_core__ast__Type::Function { params: params } =>
                        let delegate_name = f"F{alias.ast.name}"
                        let mut map_type = fn(ty: &kain_core::ast::Type) -> String: none
                        let delegate_decl = if params.is_empty():
                            f"DECLARE_DYNAMIC_MULTICAST_DELEGATE({delegate_name});"
                        elif (params.len() == 1):
                            let param_type = map_type(&params[0])
                            f"DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam({delegate_name}, {param_type}, Param0);"
                        elif (params.len() == 2):
                            let param1_type = map_type(&params[0])
                            let param2_type = map_type(&params[1])
                            f"DECLARE_DYNAMIC_MULTICAST_DELEGATE_TwoParams({delegate_name}, {param1_type}, Param0, {param2_type}, Param1);"
                        elif (params.len() == 3):
                            let param1_type = map_type(&params[0])
                            let param2_type = map_type(&params[1])
                            let param3_type = map_type(&params[2])
                            f"DECLARE_DYNAMIC_MULTICAST_DELEGATE_ThreeParams({delegate_name}, {param1_type}, Param0, {param2_type}, Param1, {param3_type}, Param2);"
                        elif (params.len() <= 9):
                            let param_types: Array<String> = params.iter().map(fn(p): map_type(p)).collect()
                            let param_list: Array<String> = param_types.iter().enumerate().map(fn(__kain_closure_arg0): f"{__kain_closure_arg0.__kain_tuple_1}, Param{__kain_closure_arg0.__kain_tuple_0}").collect()
                            let macro_name = match params.len():
                                4 => "DECLARE_DYNAMIC_MULTICAST_DELEGATE_FourParams"
                                5 => "DECLARE_DYNAMIC_MULTICAST_DELEGATE_FiveParams"
                                6 => "DECLARE_DYNAMIC_MULTICAST_DELEGATE_SixParams"
                                7 => "DECLARE_DYNAMIC_MULTICAST_DELEGATE_SevenParams"
                                8 => "DECLARE_DYNAMIC_MULTICAST_DELEGATE_EightParams"
                                9 => "DECLARE_DYNAMIC_MULTICAST_DELEGATE_NineParams"
                                _ => panic("unreachable!")
                            "{macro_name}({delegate_name}, {param_list.join(\", \")});"
                        else:
                            f"// ERROR: Delegate {delegate_name} has {params.len()} parameters - UE5 supports up to 9"
                        delegate_header_content.push_str(&delegate_decl)
                        ()
                        delegate_header_content.push("\n")
                        ()
                        delegate_header_content.push("\n")
                        ()
                        delegate_count = (delegate_count + 1)
                        ()
                    _ => ()
            _ => ()
    ()
    if (delegate_count > 0):
        let mut full_delegate_header = String__new_()
        full_delegate_header.push_str(&"// Copyright {Utc__now().year()} {(*config).copyright.unwrap_or(\"Epic Games, Inc.\")}. All Rights Reserved.\n")
        ()
        full_delegate_header.push_str("// Generated by KAIN-PRO - Delegate Declarations\n")
        ()
        full_delegate_header.push_str("// This file contains ONLY delegate declarations to avoid circular dependencies\n\n")
        ()
        full_delegate_header.push_str("#pragma once\n\n")
        ()
        full_delegate_header.push_str("#include \"CoreMinimal.h\"\n")
        ()
        let mut sorted_deps: Array<String> = delegate_type_dependencies.into_iter().collect()
        sorted_deps.sort()
        ()
        for dep in &sorted_deps:
            full_delegate_header.push_str(&f"#include \"{dep}\"\n")
            ()
        ()
        full_delegate_header.push_str("\n")
        ()
        full_delegate_header.push_str(&f"#include \"{(*config).plugin_name}Delegates.generated.h\"\n")
        ()
        full_delegate_header.push_str("\n")
        ()
        full_delegate_header.push_str("// Delegate declarations\n")
        ()
        full_delegate_header.push_str(&delegate_header_content)
        ()
        full_delegate_header.push_str("// Internal struct for UHT processing\n")
        ()
        full_delegate_header.push_str("USTRUCT()\n")
        ()
        full_delegate_header.push_str(&f"struct F{(*config).plugin_name}Delegates_Internal\n")
        ()
        full_delegate_header.push_str("{\n")
        ()
        full_delegate_header.push_str("    GENERATED_BODY()\n")
        ()
        full_delegate_header.push_str("};\n")
        ()
        let delegate_header_path = (*layout).public_dir.join(f"{(*config).plugin_name}Delegates.h")
        std__fs__write(&delegate_header_path, full_delegate_header).map_err(fn(e): KainError::Io(e))?
        ()
        println(f"      ✓ {(*config).plugin_name}Delegates.h ({delegate_count} delegate declarations - ARCHITECTURAL IMPROVEMENT!)")
        ()
        ()
    Result::Ok(delegate_count)

@doc(doc = " Generate the EditorTypes header that provides all runtime types + delegates for editor code.")
fn generate_editor_types_header(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram, delegate_count: usize) -> Result<(), KainError>:
    let mut editor_types_header = String__new_()
    editor_types_header.push_str(&"// Copyright {Utc__now().year()} {(*config).copyright.unwrap_or(\"Epic Games, Inc.\")}. All Rights Reserved.\n")
    ()
    editor_types_header.push_str("// Generated by KAIN-PRO - Editor Types Header\n")
    ()
    editor_types_header.push_str("// This file provides ALL runtime types + delegates for editor code\n")
    ()
    editor_types_header.push_str("// Slate widgets, Details customizations, and Viewports should include this\n\n")
    ()
    editor_types_header.push_str("#pragma once\n\n")
    ()
    editor_types_header.push_str("#include \"CoreMinimal.h\"\n\n")
    ()
    editor_types_header.push_str("// Runtime types (enums, structs, actors, components)\n")
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(s) =>
                let is_editor_struct = s.ast.attributes.iter().any(fn(a): ue5_editor__is_editor_attribute(&a.name))
                if is_editor_struct:
                    continue
                ()
            _ =>
                ()
                ()
        if (none):
            continue
        let header_name = match item:
            kain_core__types__TypedItem::Actor(a) => Option::Some(f"{ue5__naming__to_actor_name(&a.ast.name)}.h")
            kain_core__types__TypedItem::Component(c) => Option::Some(f"{ue5__naming__to_component_name(&c.ast.name)}.h")
            kain_core__types__TypedItem::Struct(s) => Option::Some(f"{ue5__naming__to_struct_name(&s.ast.name)}.h")
            kain_core__types__TypedItem::Enum(e) => Option::Some(f"{ue5__naming__to_enum_name(&e.ast.name)}.h")
            _ => none
        match header_name:
            Some(header) =>
                editor_types_header.push_str(&f"#include \"{header}\"\n")
                ()
            _ => ()
    ()
    editor_types_header.push_str("\n")
    ()
    if (delegate_count > 0):
        editor_types_header.push_str("// Delegates\n")
        ()
        editor_types_header.push_str(&f"#include \"{(*config).plugin_name}Delegates.h\"\n")
        ()
        editor_types_header.push_str("\n")
        ()
        ()
        ()
        ()
    editor_types_header.push_str("// Forward declarations for Slate widgets (prevents circular dependencies)\n")
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(s) =>
                if s.ast.attributes.iter().any(fn(a): (a.name == "slate")):
                    let widget_name = f"S{s.ast.name}"
                    editor_types_header.push_str(&f"class {widget_name};\n")
                    ()
            _ => ()
    ()
    editor_types_header.push_str("\n")
    ()
    let editor_types_path = (*layout).public_dir.join(f"{(*config).plugin_name}EditorTypes.h")
    std__fs__write(&editor_types_path, editor_types_header).map_err(fn(e): KainError::Io(e))?
    ()
    println(f"      ✓ {(*config).plugin_name}EditorTypes.h (complete type definitions for editor code - OPTION 3!)")
    Result::Ok(())

@doc(doc = " Generate per-item runtime codegen files (actors, structs, enums, components).")
pub fn generate_runtime_items(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram, shader_names: &[String], type_headers: &Map<String, String>, master_header_path: &std::path::PathBuf, symbol_source_map: &Map<String, std::path::PathBuf>, embed_kain: Bool, has_gas_features: Bool) -> Result<SymbolRoutingManifest, KainError>:
    let mut routing_manifest = SymbolRoutingManifest__default_()
    let output_registry = build_runtime_output_name_registry(program, symbol_source_map)
    routing_manifest.output_name_collisions = output_registry.collisions.clone()
    ()
    let runtime_consumer_module = default_runtime_module_name(config).unwrap_or_else(fn(): (*config).plugin_name.clone())
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(s) =>
                let is_editor_struct = s.ast.attributes.iter().any(fn(a): ue5_editor__is_editor_attribute(&a.name))
                if is_editor_struct:
                    continue
                ()
            _ =>
                ()
                ()
        if (none):
            continue
        let is_state_machine = match item:
            kain_core__types__TypedItem::StateMachine(_) => true
            _ => false
        let is_async_task = match item:
            kain_core__types__TypedItem::AsyncTask(_) => true
            _ => false
        let (item_name, output_name) = match item:
            kain_core__types__TypedItem::Actor(a) => (&a.ast.name, output_registry.resolved_for_symbol.get(&a.ast.name).cloned().unwrap_or_else(fn(): ue5__naming__to_actor_name(&a.ast.name)))
            kain_core__types__TypedItem::Component(c) => (&c.ast.name, output_registry.resolved_for_symbol.get(&c.ast.name).cloned().unwrap_or_else(fn(): ue5__naming__to_component_name(&c.ast.name)))
            kain_core__types__TypedItem::Struct(s) => (&s.ast.name, output_registry.resolved_for_symbol.get(&s.ast.name).cloned().unwrap_or_else(fn(): ue5__naming__to_struct_name(&s.ast.name)))
            kain_core__types__TypedItem::Enum(e) => (&e.ast.name, output_registry.resolved_for_symbol.get(&e.ast.name).cloned().unwrap_or_else(fn(): ue5__naming__to_enum_name(&e.ast.name)))
            kain_core__types__TypedItem::StateMachine(sm) => (&sm.name, output_registry.resolved_for_symbol.get(&sm.name).cloned().unwrap_or_else(fn(): sm.name.clone()))
            kain_core__types__TypedItem::AsyncTask(at) => (&at.name, output_registry.resolved_for_symbol.get(&at.name).cloned().unwrap_or_else(fn(): at.name.clone()))
            _ => continue
        if routing_manifest.symbol_output_stem.contains_key(item_name):
            println(f"   ⊘ Skipping duplicate symbol slice: {item_name}")
            continue
        let bucket = match item:
            kain_core__types__TypedItem::Actor(_) => "actors"
            kain_core__types__TypedItem::Component(_) => "components"
            kain_core__types__TypedItem::Struct(_) => "structs"
            kain_core__types__TypedItem::Enum(_) => "enums"
            kain_core__types__TypedItem::StateMachine(_) => "state_machines"
            kain_core__types__TypedItem::AsyncTask(_) => "async_tasks"
            _ => "runtime"
        let route = item_route(layout, config, item_name, false, bucket, symbol_source_map)
        std__fs__create_dir_all(&route.public_dir).map_err(fn(e): KainError::Io(e))?
        ()
        std__fs__create_dir_all(&route.private_dir).map_err(fn(e): KainError::Io(e))?
        ()
        println(f"   📄 Slicing item: {item_name} → {output_name}.h/cpp")
        match ue5__generate_filtered_typed(program, &route.module_name, Option::Some(&output_name), Option::Some(item_name.clone()), (*config).copyright, type_headers.clone(), Option::Some(shader_names.to_vec()), embed_kain, has_gas_features):
            Ok(ue5_output) =>
                if (is_state_machine || is_async_task):
                    let expected_files: Array<String> = if is_state_machine:
                        [f"{output_name}.h", f"{output_name}.cpp"]
                    else:
                        [f"{output_name}.h", f"{output_name}.cpp", f"{output_name}TaskQueue.h", f"{output_name}TaskQueue.cpp"]
                    let mut wrote_count = 0
                    let mut include_lines = Vec__new_()
                    for expected in &expected_files:
                        match ue5_output.shader_files.iter().find(fn(__kain_closure_arg1): (__kain_closure_arg1.__kain_tuple_0 == expected)):
                            Some((filename, content)) =>
                                let is_header = filename.ends_with(".h")
                                let output_path = if is_header:
                                    route.public_dir.join(filename)
                                else:
                                    route.private_dir.join(filename)
                                std__fs__write(&output_path, content).map_err(fn(e): KainError::Io(e))?
                                ()
                                println(f"      ✓ {filename}")
                                wrote_count = (wrote_count + 1)
                                ()
                                if is_header:
                                    include_lines.push(f"#include \"{build_include_path(&route, filename, Option::Some(&runtime_consumer_module))}\"\n")
                                    ()
                            _ => ()
                    ()
                    if (wrote_count == 0):
                        eprintln(f"      ✗ Failed to generate sidecar artifacts for {item_name} (no expected files found)")
                        ()
                        ()
                    else:
                        let mut master = std__fs__read_to_string(master_header_path).map_err(fn(e): KainError::Io(e))?
                        for include_line in include_lines:
                            if (!master.contains(&include_line)):
                                master.push_str(&include_line)
                                ()
                        ()
                        std__fs__write(master_header_path, master).map_err(fn(e): KainError::Io(e))?
                        ()
                        ()
                        ()
                        ()
                    continue
                let header_filename = f"{output_name}.h"
                let header_path = route.public_dir.join(&header_filename)
                std__fs__write(&header_path, &ue5_output.header).map_err(fn(e): KainError::Io(e))?
                ()
                println(f"      ✓ {output_name}.h")
                let include_path = build_include_path(&route, &header_filename, Option::Some(&runtime_consumer_module))
                routing_manifest.register_(item_name, &route.module_name, &include_path, &output_name)
                ()
                let has_implementation = ue5_output.source.lines().any(fn(line_): none)
                if has_implementation:
                    let cpp_path = route.private_dir.join(f"{output_name}.cpp")
                    std__fs__write(&cpp_path, &ue5_output.source).map_err(fn(e): KainError::Io(e))?
                    ()
                    println(f"      ✓ {output_name}.cpp")
                    ()
                    ()
                else:
                    println(f"      ⊘ {output_name}.cpp (skipped - no implementation needed)")
                    ()
                    ()
                let mut master = std__fs__read_to_string(master_header_path).map_err(fn(e): KainError::Io(e))?
                master.push_str(&f"#include \"{include_path}\"\n")
                ()
                std__fs__write(master_header_path, master).map_err(fn(e): KainError::Io(e))?
                ()
            Err(e) => eprintln(f"      ✗ Failed to generate {output_name}: {e}")
    ()
    Result::Ok(routing_manifest)

@doc(doc = " Generate stdlib functions header if any exist.")
pub fn generate_stdlib_functions(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram, type_headers: &Map<String, String>, master_header_path: &std::path::PathBuf, has_gas_features: Bool) -> Result<(), KainError>:
    println("   📦 Generating stdlib functions header...")
    match ue5__generate_stdlib_functions(program, &(*config).plugin_name, (*config).copyright, type_headers.clone(), has_gas_features):
        Ok(stdlib_output) =>
            if stdlib_output.header.contains("static inline"):
                let stdlib_header_path = (*layout).public_dir.join("KainStdlib.h")
                std__fs__write(&stdlib_header_path, &stdlib_output.header).map_err(fn(e): KainError::Io(e))?
                ()
                println("      ✓ KainStdlib.h (stdlib utility functions)")
                let mut master = std__fs__read_to_string(master_header_path).map_err(fn(e): KainError::Io(e))?
                if (!master.contains("#include \"KainStdlib.h\"")):
                    master.push_str("\n// Stdlib functions\n#include \"KainStdlib.h\"\n")
                    ()
                    ()
                    ()
                    ()
                std__fs__write(master_header_path, master).map_err(fn(e): KainError::Io(e))?
                ()
                ()
                ()
                ()
            else:
                println("      ℹ\u{fe0f}  No stdlib functions to generate (skipped)")
                ()
                ()
            ()
        Err(e) =>
            eprintln(f"      ✗ Failed to generate stdlib functions: {e}")
            ()
            ()
    Result::Ok(())

@doc(doc = " Generate blueprint function library if any @blueprint functions exist.")
pub fn generate_blueprint_library(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram, type_headers: &Map<String, String>, master_header_path: &std::path::PathBuf) -> Result<(), KainError>:
    let has_blueprint_funcs = (*program).items.iter().any(fn(item): none)
    if has_blueprint_funcs:
        println("   📦 Generating blueprint function library...")
        let runtime_module_name = default_runtime_module_name(config).unwrap_or_else(fn(): (*config).plugin_name.clone())
        let bp_lib_name = f"{(*config).plugin_name}BlueprintLibrary"
        match ue5__generate_filtered_typed(program, &runtime_module_name, Option::Some(&bp_lib_name), Option::Some(("__BLUEPRINT_LIBRARY_ONLY__").to_string()), (*config).copyright, type_headers.clone(), none, false, false):
            Ok(bp_output) =>
                let bp_header_path = (*layout).public_dir.join(f"{bp_lib_name}.h")
                std__fs__write(&bp_header_path, &bp_output.header).map_err(fn(e): KainError::Io(e))?
                ()
                println(f"      ✓ {bp_lib_name}.h")
                let bp_cpp_path = (*layout).private_dir.join(f"{bp_lib_name}.cpp")
                std__fs__write(&bp_cpp_path, &bp_output.source).map_err(fn(e): KainError::Io(e))?
                ()
                println(f"      ✓ {bp_lib_name}.cpp")
                let mut master = std__fs__read_to_string(master_header_path).map_err(fn(e): KainError::Io(e))?
                master.push_str(&f"#include \"{bp_lib_name}.h\"\n")
                ()
                std__fs__write(master_header_path, master).map_err(fn(e): KainError::Io(e))?
                ()
                ()
                ()
                ()
            Err(e) =>
                eprintln(f"      ✗ Failed to generate blueprint library: {e}")
                ()
                ()
        ()
    Result::Ok(())

@doc(doc = " Generate editor tools (Slate UI, Details, Viewport, Toolbar...).")
pub fn generate_editor_items(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram, master_header_path: &std::path::PathBuf, symbol_source_map: &Map<String, std::path::PathBuf>) -> Result<SymbolRoutingManifest, KainError>:
    if (!(*layout).has_editor_items):
        println("   ℹ\u{fe0f}  No editor items detected - skipping editor codegen")
        return Result::Ok(SymbolRoutingManifest__default_())
    let mut routing_manifest = SymbolRoutingManifest__default_()
    println("   🎨 Generating editor tools (Slate UI, Details, Viewport, Toolbar...)...")
    let (ed_pub_dir, ed_priv_dir) = if (*layout).needs_split:
        let ed_pub = (*layout).editor_public_dir.ok_or_else(fn(): KainError__codegen_error("Editor public directory not set in split mode"))?
        let ed_priv = (*layout).editor_private_dir.ok_or_else(fn(): KainError__codegen_error("Editor private directory not set in split mode"))?
        (ed_pub.clone(), ed_priv.clone())
    else:
        let ed_pub = (*layout).public_dir.join("Editor")
        let ed_priv = (*layout).private_dir.join("Editor")
        std__fs__create_dir_all(&ed_pub).map_err(fn(e): KainError::Io(e))?
        ()
        std__fs__create_dir_all(&ed_priv).map_err(fn(e): KainError::Io(e))?
        ()
        (ed_pub, ed_priv)
    let editor_module_name = default_editor_module_name(config).unwrap_or_else(fn(): f"{(*config).plugin_name}Editor")
    let editor_master_header_path = if (*layout).needs_split:
        let ed_pub = (*layout).editor_public_dir.ok_or_else(fn(): KainError__codegen_error("Editor public directory not set in split mode"))?
        let mut ed_master = String__new_()
        ed_master.push_str(&"// Copyright {Utc__now().year()} {(*config).copyright.unwrap_or(\"Epic Games, Inc.\")}. All Rights Reserved.\n")
        ()
        ed_master.push_str("// Generated by KAIN-PRO - Editor Module Master Header\n")
        ()
        ed_master.push_str("#pragma once\n\n")
        ()
        ed_master.push_str("#include \"CoreMinimal.h\"\n")
        ()
        ed_master.push_str(&f"#include \"{(*config).plugin_name}.h\"\n\n")
        ()
        ed_master.push_str("// Editor module includes\n")
        ()
        let path = ed_pub.join(f"{editor_module_name}.h")
        std__fs__write(&path, &ed_master).map_err(fn(e): KainError::Io(e))?
        ()
        println(f"      ✓ {editor_module_name}.h (editor module master header)")
        Option::Some(path)
    else:
        none
    match ue5_editor__generate_per_item(program, &(*config).plugin_name, (*config).copyright):
        Ok(editor_items) =>
            let expected_names: Set<String> = editor_items.iter().map(fn(item): item.name.clone()).collect()
            match std__fs__read_dir(&ed_pub_dir):
                Ok(entries) =>
                    for entry in entries.flatten():
                        let path = entry.path()
                        if path.extension().map_or(false, fn(e): (e == "h")):
                            match path.file_stem().and_then(fn(s): s.to_str()):
                                Some(stem) =>
                                    let is_master = (stem == f"{(*config).plugin_name}Editor")
                                    let is_factory = stem.ends_with("Factory")
                                    if (((!is_master) && (!is_factory)) && (!expected_names.contains(stem))):
                                        let _ = std__fs__remove_file(&path)
                                        println(f"   🧹 Removed stale {path.file_name().unwrap_or_default().to_string_lossy()}")
                                _ => ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match std__fs__read_dir(&ed_priv_dir):
                Ok(entries) =>
                    for entry in entries.flatten():
                        let path = entry.path()
                        if path.extension().map_or(false, fn(e): (e == "cpp")):
                            match path.file_stem().and_then(fn(s): s.to_str()):
                                Some(stem) =>
                                    let is_factory = stem.ends_with("Factory")
                                    if ((!is_factory) && (!expected_names.contains(stem))):
                                        let _ = std__fs__remove_file(&path)
                                        println(f"   🧹 Removed stale {path.file_name().unwrap_or_default().to_string_lossy()}")
                                _ => ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            for editor_item in &editor_items:
                println(f"   📄 Editor item: {editor_item.name} [{editor_item.kind}] → {editor_item.name}.h/cpp")
                let route = item_route(layout, config, &editor_item.name, true, "editor", symbol_source_map)
                std__fs__create_dir_all(&route.public_dir).map_err(fn(e): KainError::Io(e))?
                ()
                std__fs__create_dir_all(&route.private_dir).map_err(fn(e): KainError::Io(e))?
                ()
                let header_filename = f"{editor_item.name}.h"
                let header_path = route.public_dir.join(&header_filename)
                std__fs__write(&header_path, &editor_item.header).map_err(fn(e): KainError::Io(e))?
                ()
                println(f"      ✓ {editor_item.name}.h")
                let editor_consumer_module = if (*layout).needs_split:
                    editor_module_name.clone()
                else:
                    (*config).plugin_name.clone()
                let include_path = build_include_path(&route, &header_filename, Option::Some(&editor_consumer_module))
                routing_manifest.register_(&editor_item.name, &route.module_name, &include_path, &editor_item.name)
                ()
                let has_implementation = editor_item.source.lines().any(fn(line_): none)
                if has_implementation:
                    let cpp_path = route.private_dir.join(f"{editor_item.name}.cpp")
                    std__fs__write(&cpp_path, &editor_item.source).map_err(fn(e): KainError::Io(e))?
                    ()
                    println(f"      ✓ {editor_item.name}.cpp")
                    ()
                    ()
                else:
                    println(f"      ⊘ {editor_item.name}.cpp (skipped - no implementation needed)")
                    ()
                    ()
                match editor_master_header_path:
                    Some(ed_master_path) =>
                        let mut master = std__fs__read_to_string(ed_master_path).map_err(fn(e): KainError::Io(e))?
                        master.push_str(&f"#include \"{include_path}\"\n")
                        ()
                        std__fs__write(ed_master_path, master).map_err(fn(e): KainError::Io(e))?
                        ()
                    _ =>
                        let mut master = std__fs__read_to_string(master_header_path).map_err(fn(e): KainError::Io(e))?
                        master.push_str(&f"#include \"{include_path}\"\n")
                        ()
                        std__fs__write(master_header_path, master).map_err(fn(e): KainError::Io(e))?
                        ()
            ()
            println(f"   ✅ {editor_items.len()} editor items generated")
            ()
            ()
        Err(e) =>
            eprintln(f"      ✗ Failed to generate editor tools: {e}")
            ()
            ()
    Result::Ok(routing_manifest)

@derive(Debug, serde__Serialize)
struct SymbolManifestEntry:
    symbol: String
    module: String
    include: String

@derive(Debug, serde__Serialize)
struct SymbolManifestFile:
    plugin: String
    symbols: Array<SymbolManifestEntry>

@derive(Debug, serde__Serialize)
struct ModuleIncludeManifestFile:
    plugin: String
    module_headers: Map<String, Array<String>>

pub fn write_cross_module_manifests(layout: &PluginLayout, config: &Ue5Config, runtime_manifest: &SymbolRoutingManifest, editor_manifest: &SymbolRoutingManifest) -> Result<(), KainError>:
    let mut merged = SymbolRoutingManifest__default_()
    merged.extend_from(runtime_manifest)
    ()
    merged.extend_from(editor_manifest)
    ()
    let mut symbols: Array<SymbolManifestEntry> = merged.symbol_owner.iter().filter_map(fn(__kain_closure_arg2): none).collect()
    symbols.sort_by(fn(a, b): a.symbol.cmp(&b.symbol))
    ()
    let mut module_headers: Map<String, Array<String>> = HashMap__new_()
    for entry in &symbols:
        module_headers.entry(entry.module.clone()).or_default().push(entry.include.clone())
        ()
    ()
    for headers in module_headers.values_mut():
        headers.sort()
        ()
        headers.dedup()
        ()
    ()
    let out_dir = (*layout).plugin_root.join("Intermediate").join("Kain")
    std__fs__create_dir_all(&out_dir).map_err(fn(e): KainError::Io(e))?
    ()
    let symbol_file = SymbolManifestFile { plugin: (*config).plugin_name.clone(), symbols: symbols }
    let include_file = ModuleIncludeManifestFile { plugin: (*config).plugin_name.clone(), module_headers: module_headers }
    let symbol_json = serde_json__to_string_pretty(&symbol_file).map_err(fn(e): KainError__runtime(f"Failed to serialize symbol manifest: {e}"))?
    let include_json = serde_json__to_string_pretty(&include_file).map_err(fn(e): KainError__runtime(f"Failed to serialize include manifest: {e}"))?
    std__fs__write(out_dir.join("symbol_ownership_manifest.json"), symbol_json).map_err(fn(e): KainError::Io(e))?
    ()
    std__fs__write(out_dir.join("module_include_manifest.json"), include_json).map_err(fn(e): KainError::Io(e))?
    ()
    println(f"   ✓ cross-module manifests emitted to {(*config).plugin_name}/Intermediate/Kain")
    Result::Ok(())

@doc(doc = " Generate module registration files (IMPLEMENT_MODULE).")
pub fn generate_module_registration(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram, has_shaders: Bool, has_material_factories: Bool) -> Result<(), KainError>:
    let has_editor_module = (*program).items.iter().any(fn(item): none)
    if (*layout).needs_split:
        let runtime_module_name = default_runtime_module_name(config).unwrap_or_else(fn(): (*config).plugin_name.clone())
        let editor_module_name = default_editor_module_name(config).unwrap_or_else(fn(): f"{(*config).plugin_name}Editor")
        eprintln("📦 [PACKAGER] Split mode — generating runtime module registration")
        let mut includes = [f"#include \"{(*config).plugin_name}.h\"", ("#include \"Modules/ModuleManager.h\"").to_string()]
        if has_material_factories:
            includes.push(("#include \"Generated/MaterialFactories.h\"").to_string())
            ()
            includes.push(("#include \"Misc/CoreDelegates.h\"").to_string())
            ()
            ()
            ()
            ()
        if has_shaders:
            includes.push(("#include \"Interfaces/IPluginManager.h\"").to_string())
            ()
            includes.push(("#include \"ShaderCore.h\"").to_string())
            ()
            ()
            ()
            ()
        let includes_str = includes.join("\n")
        let mut startup_body = String__from("        // Runtime module startup\n")
        if has_shaders:
            startup_body.push_str(&"\n        // Register shader virtual path mapping\n        // Maps /Plugin/{(*config).plugin_name} to physical Shaders/ directory\n        if (!AllShaderSourceDirectoryMappings().Contains(TEXT(\"/Plugin/{(*config).plugin_name}\")))\n        {\n            FString PluginShaderDir = FPaths::Combine(\n                IPluginManager::Get().FindPlugin(TEXT(\"{(*config).plugin_name}\"))->GetBaseDir(),\n                TEXT(\"Shaders\")\n            );\n            AddShaderSourceDirectoryMapping(TEXT(\"/Plugin/{(*config).plugin_name}\"), PluginShaderDir);\n        }\n")
            ()
            ()
            ()
            ()
        if has_material_factories:
            startup_body.push_str(&f"\n        #if WITH_EDITOR\n        // Generate editor materials once engine startup has completed.\n        FCoreDelegates::OnPostEngineInit.AddStatic(&F{(*config).plugin_name}MaterialFactory::GenerateMaterials);\n        #endif\n")
            ()
            ()
            ()
            ()
        let module_cpp = "// Generated by KAIN-PRO - Runtime Module Registration\n{includes_str}\n\nclass F{runtime_module_name}Module : public IModuleInterface\n{\npublic:\n    virtual void StartupModule() override\n    {\n{startup_body}    }\n\n    virtual void ShutdownModule() override\n    {\n        // Runtime module shutdown\n    }\n};\n\nIMPLEMENT_MODULE(F{runtime_module_name}Module, {runtime_module_name})\n"
        let module_cpp_path = (*layout).private_dir.join(f"{runtime_module_name}.cpp")
        std__fs__write(&module_cpp_path, module_cpp).map_err(fn(e): KainError::Io(e))?
        ()
        println(f"      ✓ {runtime_module_name}.cpp (runtime module registration)")
        if has_editor_module:
            println(f"      ✓ @editor_module provides IMPLEMENT_MODULE for {editor_module_name}")
            ()
            ()
        else:
            let mut includes = [f"#include \"{editor_module_name}.h\"", ("#include \"Modules/ModuleManager.h\"").to_string()]
            if has_shaders:
                includes.push(("#include \"Interfaces/IPluginManager.h\"").to_string())
                ()
                includes.push(("#include \"ShaderCore.h\"").to_string())
                ()
                ()
                ()
                ()
            let includes_str = includes.join("\n")
            let mut startup_body = String__from("        // Editor module startup\n")
            if has_shaders:
                startup_body.push_str(&"\n        // Register shader virtual path mapping\n        // Maps /Plugin/{(*config).plugin_name} to physical Shaders/ directory\n        if (!AllShaderSourceDirectoryMappings().Contains(TEXT(\"/Plugin/{(*config).plugin_name}\")))\n        {\n            FString PluginShaderDir = FPaths::Combine(\n                IPluginManager::Get().FindPlugin(TEXT(\"{(*config).plugin_name}\"))->GetBaseDir(),\n                TEXT(\"Shaders\")\n            );\n            AddShaderSourceDirectoryMapping(TEXT(\"/Plugin/{(*config).plugin_name}\"), PluginShaderDir);\n        }\n")
                ()
                ()
                ()
                ()
            let ed_module_cpp = "// Generated by KAIN-PRO - Editor Module Registration\n{includes_str}\n\nclass F{editor_module_name}Module : public IModuleInterface\n{\npublic:\n    virtual void StartupModule() override\n    {\n{startup_body}    }\n\n    virtual void ShutdownModule() override\n    {\n        // Editor module shutdown\n    }\n};\n\nIMPLEMENT_MODULE(F{editor_module_name}Module, {editor_module_name})\n"
            let ed_priv = (*layout).editor_private_dir.ok_or_else(fn(): KainError__codegen_error("Editor private directory not set in split mode"))?
            let ed_module_cpp_path = ed_priv.join(f"{editor_module_name}.cpp")
            std__fs__write(&ed_module_cpp_path, ed_module_cpp).map_err(fn(e): KainError::Io(e))?
            ()
            println(f"      ✓ {editor_module_name}.cpp (editor module registration)")
            ()
            ()
        ()
    elif has_editor_module:
        eprintln("📦 [PACKAGER] @editor_module detected — skipping default module registration")
        println(f"   ℹ️  @editor_module provides IMPLEMENT_MODULE — skipping default {(*config).plugin_name}.cpp")
        ()
        ()
    else:
        eprintln("📦 [PACKAGER] Generating module registration file...")
        let mut includes = [f"#include \"{(*config).plugin_name}.h\"", ("#include \"Modules/ModuleManager.h\"").to_string()]
        if has_material_factories:
            includes.push(("#include \"Generated/MaterialFactories.h\"").to_string())
            ()
            includes.push(("#include \"Misc/CoreDelegates.h\"").to_string())
            ()
            ()
            ()
            ()
        if has_shaders:
            includes.push(("#include \"Interfaces/IPluginManager.h\"").to_string())
            ()
            includes.push(("#include \"ShaderCore.h\"").to_string())
            ()
            ()
            ()
            ()
        let includes_str = includes.join("\n")
        let mut startup_body = String__from("        // Module startup\n")
        if has_shaders:
            startup_body.push_str(&"\n        // Register shader virtual path mapping\n        // Maps /Plugin/{(*config).plugin_name} to physical Shaders/ directory\n        if (!AllShaderSourceDirectoryMappings().Contains(TEXT(\"/Plugin/{(*config).plugin_name}\")))\n        {\n            FString PluginShaderDir = FPaths::Combine(\n                IPluginManager::Get().FindPlugin(TEXT(\"{(*config).plugin_name}\"))->GetBaseDir(),\n                TEXT(\"Shaders\")\n            );\n            AddShaderSourceDirectoryMapping(TEXT(\"/Plugin/{(*config).plugin_name}\"), PluginShaderDir);\n        }\n")
            ()
            ()
            ()
            ()
        if has_material_factories:
            startup_body.push_str(&f"\n        #if WITH_EDITOR\n        // Generate editor materials once engine startup has completed.\n        FCoreDelegates::OnPostEngineInit.AddStatic(&F{(*config).plugin_name}MaterialFactory::GenerateMaterials);\n        #endif\n")
            ()
            ()
            ()
            ()
        let module_cpp = "// Generated by KAIN-PRO - Module Registration\n{includes_str}\n\nclass F{(*config).plugin_name}Module : public IModuleInterface\n{\npublic:\n    virtual void StartupModule() override\n    {\n{startup_body}    }\n\n    virtual void ShutdownModule() override\n    {\n        // Module shutdown\n    }\n};\n\nIMPLEMENT_MODULE(F{(*config).plugin_name}Module, {(*config).plugin_name})\n"
        let module_cpp_path = (*layout).private_dir.join(f"{(*config).plugin_name}.cpp")
        std__fs__write(&module_cpp_path, module_cpp).map_err(fn(e): KainError::Io(e))?
        ()
        println(f"      ✓ {(*config).plugin_name}.cpp (module registration)")
        ()
        ()
    Result::Ok(())

@doc(doc = " Generate monolithic output (single .h/.cpp with all types merged).")
pub fn generate_monolithic(layout: &PluginLayout, config: &Ue5Config, program: &kain_core::types::TypedProgram) -> Result<(), KainError>:
    println("🎯 Generating main plugin files from merged program...")
    match ue5__generate_from_typed(program, Option::Some(&(*config).plugin_name), (*config).copyright):
        Ok(ue5_output) =>
            let main_header_path = (*layout).public_dir.join(f"{(*config).plugin_name}.h")
            std__fs__write(&main_header_path, &ue5_output.header).map_err(fn(e): KainError::Io(e))?
            ()
            println(f"   ✓ {(*config).plugin_name}.h (actors, structs, enums, components)")
            let main_cpp_path = (*layout).private_dir.join(f"{(*config).plugin_name}.cpp")
            std__fs__write(&main_cpp_path, &ue5_output.source).map_err(fn(e): KainError::Io(e))?
            ()
            println(f"   ✓ {(*config).plugin_name}.cpp (implementations + module registration)")
            ()
            ()
        Err(e) =>
            eprintln(f"   ✗ Failed to generate UE5 code: {e}")
            ()
            ()
    Result::Ok(())

@doc(doc = " Extract all UE5 type names referenced in a KAIN program (base classes, field types, etc.).")
@doc(doc = " These are used to resolve module dependencies via the module graph.")
fn extract_referenced_types(program: &kain_core::types::TypedProgram) -> Array<String>:
    let mut types: Set<String> = HashSet__new_()
    let builtins: Set<String> = (["Int", "Float", "Bool", "String", "Char", "Vec2", "Vec3", "Vec4", "Array", "Map", "Option", "Result", "Actor", "Component"]).iter().copied().collect()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(s) =>
                for field in &s.ast.fields:
                    collect_ast_type_names(&field.ty, &builtins, &mut types)
                    ()
            kain_core__types__TypedItem::Actor(a) =>
                for state_ in &a.ast.state_:
                    collect_ast_type_names(&state_.ty, &builtins, &mut types)
                    ()
                ()
                for method in &a.ast.methods:
                    for param in &method.params:
                        collect_ast_type_names(&param.ty, &builtins, &mut types)
                        ()
                    ()
                    match method.return_type:
                        Some(ret) =>
                            collect_ast_type_names(ret, &builtins, &mut types)
                            ()
                        _ => ()
                ()
                for handler in &a.ast.handlers:
                    for param in &handler.params:
                        collect_ast_type_names(&param.ty, &builtins, &mut types)
                        ()
            kain_core__types__TypedItem::Component(c) =>
                for prop in &c.ast.props:
                    collect_ast_type_names(&prop.ty, &builtins, &mut types)
                    ()
            kain_core__types__TypedItem::Function(f) =>
                for param in &f.ast.params:
                    collect_ast_type_names(&param.ty, &builtins, &mut types)
                    ()
                ()
                match f.ast.return_type:
                    Some(ret) =>
                        collect_ast_type_names(ret, &builtins, &mut types)
                        ()
                    _ => ()
            _ => ()
    ()
    types.into_iter().collect()

@doc(doc = " Recursively collect named type strings from a KAIN AST `Type`, skipping builtins.")
fn collect_ast_type_names(ty: &kain_core::ast::Type, builtins: &Set<String>, out_: &mut Set<String>):
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } =>
            if (!builtins.contains(name.as_str())):
                out_.insert(name.clone())
                ()
                ()
                ()
                ()
            for g in generics:
                collect_ast_type_names(g, builtins, out_)
                ()
        kain_core__ast__Type::Tuple(inner, _) =>
            for t in inner:
                collect_ast_type_names(t, builtins, out_)
                ()
        kain_core__ast__Type::Array(inner, _, _) => collect_ast_type_names(inner, builtins, out_)
        kain_core__ast__Type::Slice(inner, _) => collect_ast_type_names(inner, builtins, out_)
        kain_core__ast__Type::Option(inner, _) => collect_ast_type_names(inner, builtins, out_)
        kain_core__ast__Type::Result(ok, err, _) =>
            collect_ast_type_names(ok, builtins, out_)
            ()
            collect_ast_type_names(err, builtins, out_)
            ()
        kain_core__ast__Type::Ref { inner: inner } => collect_ast_type_names(inner, builtins, out_)
        _ => ()

@doc(doc = " Compute the extra module dependencies needed for runtime code.")
@doc(doc = " Uses the module graph when available, falls back to feature-based detection.")
fn compute_runtime_deps(has_shaders: Bool, has_gas_features: Bool, module_graph: &ue5::ue5::module_graph::ModuleGraph, program: &kain_core::types::TypedProgram) -> Array<String>:
    let base_modules = ["Core", "CoreUObject", "Engine", "Projects"]
    let mut deps = if module_graph.is_loaded():
        let referenced = extract_referenced_types(program)
        let type_refs: Array<String> = referenced.iter().map(fn(s): s.as_str()).collect()
        let mut apis: Array<String> = Vec__new_()
        if has_shaders:
            apis.push("AddShaderSourceDirectoryMapping")
            ()
            apis.push("AllShaderSourceDirectoryMappings")
            ()
            apis.push("IMPLEMENT_GLOBAL_SHADER")
            ()
            ()
            ()
            ()
        module_graph.resolve_deps_for_types(&type_refs, &[], &apis, &base_modules)
    else:
        Vec__new_()
    if has_shaders:
        for module in &["RenderCore", "RHI", "Renderer"]:
            let s = module.to_string()
            if (!deps.contains(&s)):
                deps.push(s)
                ()
        ()
        ()
    if has_gas_features:
        for module in &["GameplayTags", "GameplayAbilities", "GameplayTasks"]:
            let s = module.to_string()
            if (!deps.contains(&s)):
                deps.push(s)
                ()
        ()
        ()
    deps

@doc(doc = " Compute the extra module dependencies needed for editor code.")
@doc(doc = " Uses the module graph when available, falls back to feature-based detection.")
fn compute_editor_deps(has_shaders: Bool, module_graph: &ue5::ue5::module_graph::ModuleGraph, program: &kain_core::types::TypedProgram) -> (Array<String>, Array<String>):
    let base_modules = ["Core", "CoreUObject", "Engine"]
    if module_graph.is_loaded():
        let referenced = extract_referenced_types(program)
        let type_refs: Array<String> = referenced.iter().map(fn(s): s.as_str()).collect()
        let mut apis: Array<String> = Vec__new_()
        if has_shaders:
            apis.push("AddShaderSourceDirectoryMapping")
            ()
            apis.push("AllShaderSourceDirectoryMappings")
            ()
            ()
            ()
            ()
        let public_extra = module_graph.resolve_deps_for_types(&type_refs, &[], &apis, &base_modules)
        (public_extra, Vec__new_())
    else:
        let mut public_extra = Vec__new_()
        if has_shaders:
            public_extra.extend((["RenderCore", "RHI", "Renderer"]).iter().map(fn(s): s.to_string()))
            ()
            ()
            ()
            ()
        (public_extra, Vec__new_())

@doc(doc = " Write .uplugin and .Build.cs files.")
pub fn write_plugin_files(layout: &PluginLayout, config: &Ue5Config, description: &Option<String>, has_shaders: Bool, has_gas_features: Bool, module_graph: &ue5::ue5::module_graph::ModuleGraph, program: &kain_core::types::TypedProgram) -> Result<(), KainError>:
    let has_datatable = build_cs_gen__has_datatable_structs(program)
    let has_viewport = build_cs_gen__has_viewport_items(program)
    let has_toolbar = build_cs_gen__has_toolbar_items(program)
    let uplugin_path = (*layout).plugin_root.join(f"{(*config).plugin_name}.uplugin")
    println()
    println("📦 Generating .uplugin file...")
    let uplugin_content = if config.has_module_plan():
        uplugin_gen__generate_uplugin_file_from_modules(&(*config).plugin_name, description, has_shaders, &(*config).modules, &(*config).plugin_dependencies)
    else:
        uplugin_gen__generate_uplugin_file(&(*config).plugin_name, description, (*layout).has_editor_items, (*layout).needs_split, has_shaders, &(*config).plugin_dependencies)
    std__fs__write(&uplugin_path, uplugin_content).map_err(fn(e): KainError::Io(e))?
    ()
    println(f"   ✓ {(*config).plugin_name}.uplugin")
    if has_shaders:
        println("   ℹ\u{fe0f}  CanContainContent: true (required for shader loading)")
        ()
        ()
    if module_graph.is_loaded():
        let (mods, types, headers) = module_graph.stats()
        println(f"   📊 Module graph: {mods} modules, {types} types, {headers} headers")
        ()
        ()
    println()
    println("🔨 Generating .Build.cs file(s)...")
    if config.has_module_plan():
        for module in &(*config).modules:
            let (mut module_public_deps, module_private_deps): (Array<String>, Array<String>) = match module.module_type:
                config__Ue5ModuleType::Runtime =>
                    let mut deps = compute_runtime_deps(has_shaders, has_gas_features, module_graph, program)
                    if (!deps.contains(&("Core").to_string())):
                        deps.push(("Core").to_string())
                        ()
                        ()
                        ()
                        ()
                    if (!deps.contains(&("CoreUObject").to_string())):
                        deps.push(("CoreUObject").to_string())
                        ()
                        ()
                        ()
                        ()
                    if (!deps.contains(&("Engine").to_string())):
                        deps.push(("Engine").to_string())
                        ()
                        ()
                        ()
                        ()
                    if (!deps.contains(&("Projects").to_string())):
                        deps.push(("Projects").to_string())
                        ()
                        ()
                        ()
                        ()
                    (deps, Vec__new_())
                _ =>
                    let (pub_extra, priv_extra) = compute_editor_deps(has_shaders, module_graph, program)
                    (pub_extra, priv_extra)
            for dep in &module.public_deps:
                if (!module_public_deps.contains(dep)):
                    module_public_deps.push(dep.clone())
                    ()
            ()
            let mut merged_private = module_private_deps
            for dep in &module.private_deps:
                if (!merged_private.contains(dep)):
                    merged_private.push(dep.clone())
                    ()
            ()
            for dep in &module.depends_on:
                if (!module_public_deps.contains(dep)):
                    module_public_deps.push(dep.clone())
                    ()
            ()
            let module_dir = (*layout).source_dir.join(&module.name)
            std__fs__create_dir_all(&module_dir).map_err(fn(e): KainError::Io(e))?
            ()
            let build_cs_path = module_dir.join(f"{module.name}.Build.cs")
            let build_cs_content = build_cs_gen__generate_build_cs_module(&module.name, &module_public_deps, &merged_private)
            std__fs__write(&build_cs_path, build_cs_content).map_err(fn(e): KainError::Io(e))?
            ()
            println(f"   ✓ {module.name}.Build.cs (data-driven module: {module.name}, type={module.module_type.as_uplugin_type()})")
        ()
        return Result::Ok(())
    if (*layout).needs_split:
        let rt_extra = compute_runtime_deps(has_shaders, has_gas_features, module_graph, program)
        let rt_build_cs_path = (*layout).source_dir.join(&(*config).plugin_name).join(f"{(*config).plugin_name}.Build.cs")
        let rt_build_cs = build_cs_gen__generate_build_cs_runtime(&(*config).plugin_name, &rt_extra, has_datatable)
        std__fs__write(&rt_build_cs_path, rt_build_cs).map_err(fn(e): KainError::Io(e))?
        ()
        if (!rt_extra.is_empty()):
            println("   ✓ {(*config).plugin_name}.Build.cs (runtime) + auto-resolved: {rt_extra.join(\", \")}")
            ()
            ()
        else:
            println(f"   ✓ {(*config).plugin_name}.Build.cs (runtime module)")
            ()
            ()
        let (ed_pub_extra, ed_priv_extra) = compute_editor_deps(has_shaders, module_graph, program)
        let editor_module_name = f"{(*config).plugin_name}Editor"
        let ed_build_cs_path = (*layout).source_dir.join(&editor_module_name).join(f"{editor_module_name}.Build.cs")
        let ed_build_cs = build_cs_gen__generate_build_cs_editor(&(*config).plugin_name, &ed_pub_extra, &ed_priv_extra, has_viewport, has_toolbar)
        std__fs__write(&ed_build_cs_path, ed_build_cs).map_err(fn(e): KainError::Io(e))?
        ()
        if (!ed_pub_extra.is_empty()):
            println("   ✓ {editor_module_name}.Build.cs (editor) + auto-resolved: {ed_pub_extra.join(\", \")}")
            ()
            ()
        else:
            println(f"   ✓ {editor_module_name}.Build.cs (editor module)")
            ()
            ()
        ()
    else:
        let rt_extra = compute_runtime_deps(has_shaders, has_gas_features, module_graph, program)
        let build_cs_path = (*layout).source_dir.join(f"{(*config).plugin_name}.Build.cs")
        let build_cs_content = build_cs_gen__generate_build_cs(&(*config).plugin_name, (*layout).has_editor_items, &rt_extra, &[])
        std__fs__write(&build_cs_path, build_cs_content).map_err(fn(e): KainError::Io(e))?
        ()
        if (!rt_extra.is_empty()):
            println("   ✓ {(*config).plugin_name}.Build.cs + auto-resolved: {rt_extra.join(\", \")}")
            ()
            ()
        else:
            println(f"   ✓ {(*config).plugin_name}.Build.cs")
            ()
            ()
        ()
    Result::Ok(())

