pub type EnvExtensionRegistrar = fn(&mut Env) -> ()

const ENV_EXTENSION_REGISTRARS: std::sync::RwLock<Map<String, EnvExtensionRegistrar>> = (fn(): RwLock__new_(BTreeMap__new_()))()

fn lowered_impl_function_names(type_name: String, method_name: String) -> [String; 2]:
    [f"{type_name}_{method_name}", f"{type_name}__{method_name}"]

fn module_scoped_name(module_path: &[String], item_name: String) -> String:
    let mut parts = module_path.to_vec()
    parts.push(item_name.to_string())
    ()
    parts.join("__")

fn selfhost_enum_variant_alias_name(enum_name: String, variant_name: String) -> String:
    f"{enum_name}__{variant_name}"

pub fn register_env_extension(name: impl Into<String>, registrar: EnvExtensionRegistrar):
    ENV_EXTENSION_REGISTRARS.write().unwrap().insert(name.into(), registrar)
    ()

pub enum Value:
    Unit
    Bool(Bool)
    Int(i64)
    Float(f64)
    String(String)
    Array(std::sync::Arc<std::sync::RwLock<Array<Value>>>)
    Tuple(Array<Value>)
    Struct(String, std::sync::Arc<std::sync::RwLock<Map<String, Value>>>)
    HostObject(String, std::sync::Arc<impl Any>)
    Function(String)
    Patch(String)
    Law(String)
    Converge(String)
    Orchestrate(String)
    NativeFn(String, fn(&mut Env, Array<Value>) -> Result<Value, KainError>)
    ActorRef(ActorRef)
    None
    Return(Box<Value>)
    Break(Option<Box<Value>>)
    Continue
    Result(Bool, Box<Value>)
    Closure(Array<String>, Box<Expr>, Array<Map<String, Value>>)
    StructConstructor(String, Array<String>)
    JSX(VNode)
    EnumVariant(String, String, Array<Value>)
    Poll(Bool, Option<Box<Value>>)
    Future(String, std::sync::Arc<std::sync::RwLock<Map<String, Value>>>)

pub type NativeFn = fn(&mut Env, Array<Value>) -> Result<Value, KainError>

impl std::fmt::Debug for Value:
    fn fmt(_self: &Value, f: &mut std::fmt::Formatter<_>) -> Result<(), Error>:
        match *_self:
            Value::Unit => __kain_write_fmt!(f, "Unit")
            Value::Bool(b) => __kain_write_fmt!(f, f"Bool({b})")
            Value::Int(i) => __kain_write_fmt!(f, f"Int({i})")
            Value::Float(fl) => __kain_write_fmt!(f, f"Float({fl})")
            Value::String(s) => __kain_write_fmt!(f, f"String({s})")
            Value::Array(arr) => __kain_write_fmt!(f, f"Array({arr})")
            Value::Tuple(t) => __kain_write_fmt!(f, f"Tuple({t})")
            Value::Struct(name, fields) => __kain_write_fmt!(f, f"Struct({name}, {fields})")
            Value::HostObject(name, _) => __kain_write_fmt!(f, f"HostObject({name})")
            Value::Function(name) => __kain_write_fmt!(f, f"Function({name})")
            Value::Patch(name) => __kain_write_fmt!(f, f"Patch({name})")
            Value::Law(name) => __kain_write_fmt!(f, f"Law({name})")
            Value::Converge(name) => __kain_write_fmt!(f, f"Converge({name})")
            Value::Orchestrate(name) => __kain_write_fmt!(f, f"Orchestrate({name})")
            Value::NativeFn(name, _) => __kain_write_fmt!(f, f"NativeFn({name})")
            Value::StructConstructor(name, _) => __kain_write_fmt!(f, f"StructConstructor({name})")
            Value::ActorRef(r) => __kain_write_fmt!(f, f"ActorRef({r})")
            Value::None => __kain_write_fmt!(f, "None")
            Value::Return(v) => __kain_write_fmt!(f, f"Return({v})")
            Value::Result(ok, v) => if (*ok): __kain_write_fmt!(f, f"Ok({v})") else: __kain_write_fmt!(f, f"Err({v})")
            Value::Closure(params, _, _) => __kain_write_fmt!(f, f"Closure({params})")
            Value::JSX(node) => __kain_write_fmt!(f, f"JSX({node})")
            Value::EnumVariant(e, v, _) => __kain_write_fmt!(f, f"{e}::{v}")
            Value::Poll(ready, val) => if (*ready): __kain_write_fmt!(f, f"Poll::Ready({val})") else: __kain_write_fmt!(f, "Poll::Pending")
            Value::Future(name, _) => __kain_write_fmt!(f, f"Future<{name}>")
            Value::Break(v) => __kain_write_fmt!(f, f"Break({v})")
            Value::Continue => __kain_write_fmt!(f, "Continue")


impl std::fmt::Display for Value:
    fn fmt(_self: &Value, f: &mut std::fmt::Formatter<_>) -> Result<(), Error>:
        match *_self:
            Value::Unit => __kain_write_fmt!(f, "()")
            Value::Bool(b) => __kain_write_fmt!(f, b)
            Value::Int(i) => __kain_write_fmt!(f, i)
            Value::Float(fl) => __kain_write_fmt!(f, fl)
            Value::String(s) => __kain_write_fmt!(f, s)
            Value::Array(arr) =>
                __kain_write_fmt!(f, "[")?
                ()
                let arr = arr.read().unwrap()
                for selfhost_for_item in arr.iter().enumerate():
                    let (i, v) = selfhost_for_item
                    if (i > 0):
                        __kain_write_fmt!(f, ", ")?
                        ()
                        ()
                        ()
                        ()
                    __kain_write_fmt!(f, v)?
                    ()
                ()
                __kain_write_fmt!(f, "]")
            Value::Tuple(t) =>
                __kain_write_fmt!(f, "(")?
                ()
                for selfhost_for_item in t.iter().enumerate():
                    let (i, v) = selfhost_for_item
                    if (i > 0):
                        __kain_write_fmt!(f, ", ")?
                        ()
                        ()
                        ()
                        ()
                    __kain_write_fmt!(f, v)?
                    ()
                ()
                __kain_write_fmt!(f, ")")
            Value::Struct(name, fields) =>
                __kain_write_fmt!(f, "{name} {")?
                ()
                let fields = fields.read().unwrap()
                for selfhost_for_item in fields.iter().enumerate():
                    let (i, (k, v)) = selfhost_for_item
                    if (i > 0):
                        __kain_write_fmt!(f, ", ")?
                        ()
                        ()
                        ()
                        ()
                    __kain_write_fmt!(f, f"{k}: {v}")?
                    ()
                ()
                __kain_write_fmt!(f, "}")
            Value::HostObject(name, _) => __kain_write_fmt!(f, f"<host {name}>")
            Value::Function(name) => __kain_write_fmt!(f, f"<fn {name}>")
            Value::Patch(name) => __kain_write_fmt!(f, f"<patch {name}>")
            Value::Law(name) => __kain_write_fmt!(f, f"<law {name}>")
            Value::Converge(name) => __kain_write_fmt!(f, f"<converge {name}>")
            Value::Orchestrate(name) => __kain_write_fmt!(f, f"<orchestrate {name}>")
            Value::NativeFn(name, _) => __kain_write_fmt!(f, f"<native fn {name}>")
            Value::StructConstructor(name, _) => __kain_write_fmt!(f, f"<constructor {name}>")
            Value::ActorRef(r) => __kain_write_fmt!(f, f"<actor {r.id}>")
            Value::None => __kain_write_fmt!(f, "none")
            Value::Return(v) => __kain_write_fmt!(f, v)
            Value::Result(ok, v) => if (*ok): __kain_write_fmt!(f, f"Ok({v})") else: __kain_write_fmt!(f, f"Err({v})")
            Value::Closure(_, _, _) => __kain_write_fmt!(f, "<closure>")
            Value::JSX(node) => __kain_write_fmt!(f, node)
            Value::EnumVariant(enum_name, variant, fields) =>
                if fields.is_empty():
                    __kain_write_fmt!(f, f"{enum_name}::{variant}")
                else:
                    __kain_write_fmt!(f, f"{enum_name}::{variant}(")?
                    ()
                    for selfhost_for_item in fields.iter().enumerate():
                        let (i, v) = selfhost_for_item
                        if (i > 0):
                            __kain_write_fmt!(f, ", ")?
                            ()
                            ()
                            ()
                            ()
                        __kain_write_fmt!(f, v)?
                        ()
                    ()
                    __kain_write_fmt!(f, ")")
            Value::Poll(ready, val) => if (*ready): none else: __kain_write_fmt!(f, "Poll::Pending")
            Value::Future(name, _) => __kain_write_fmt!(f, f"<future {name}>")
            Value::Break(v) =>
                match v:
                    Some(val) => __kain_write_fmt!(f, f"<break {val}>")
                    _ => __kain_write_fmt!(f, "<break>")
            Value::Continue => __kain_write_fmt!(f, "<continue>")


impl Value:
    pub fn host_object(label: impl Into<String>, object: std::sync::Arc<impl Any>) -> Value:
        Value::HostObject(label.into(), object)

    pub fn downcast_host_object<T>(_self: &Value) -> Option<std::sync::Arc<T>>:
        match *_self:
            Value::HostObject(_, object) => object.clone().downcast().ok()
            _ => none

    pub fn host_object_label(_self: &Value) -> Option<String>:
        match *_self:
            Value::HostObject(label, _) => Option::Some(label.as_str())
            _ => none


@doc(doc = " Reference to an actor")
@derive(Debug, Clone)
pub struct ActorRef:
    id: u64
    sender: flume::Sender<Message>

@doc(doc = " Message for actor communication")
@derive(Debug, Clone)
pub struct Message:
    name: String
    args: Array<Value>

enum ExecutionLane:
    Interpret
    Test

@derive(Debug, Clone)
struct ActivePatchFrame:
    name: String
    mutation_paths: Array<String>
    undo_mode: String
    changes: Array<ActivePatchChange>

enum PatchMutationTarget:
    StructField { fields: std::sync::Arc<std::sync::RwLock<Map<String, Value>>>, field: String }
    ArrayIndex { values: std::sync::Arc<std::sync::RwLock<Array<Value>>>, index: usize }

@derive(Debug, Clone)
struct ActivePatchChange:
    path: String
    target: PatchMutationTarget
    old_value: Value
    new_value: Value

@derive(Debug, Clone)
pub struct PatchMutationRecord:
    path: String
    old_value: Value
    new_value: Value

@derive(Debug, Clone)
pub struct PatchCollaborationEvent:
    event_id: String
    patch_name: String
    mutation_paths: Array<String>
    undo_mode: String

@derive(Debug, Clone)
struct ReplayablePatchRecord:
    name: String
    undo_mode: String
    changes: Array<ActivePatchChange>

@derive(Debug, Clone)
pub struct PatchRuntimeRecord:
    name: String
    mutation_paths: Array<String>
    undo_mode: String
    changes: Array<PatchMutationRecord>
    collaboration_event: String

@doc(doc = " Interpreter environment")
@derive(Clone)
pub struct Env:
    scopes: Array<Map<String, Value>>
    functions: Map<String, Function>
    function_inline_scopes: Map<String, Map<String, Value>>
    patches: Map<String, PatchDef>
    laws: Map<String, LawDef>
    patch_undo_modes: Map<String, String>
    converges: Map<String, ConvergeDef>
    orchestrates: Map<String, OrchestrateDef>
    worlds: Map<String, std::sync::Arc<std::sync::RwLock<Map<String, Value>>>>
    components: Map<String, Component>
    inline_modules: Map<String, Array<Item>>
    methods: Map<String, Map<String, Function>>
    actors: Map<u64, flume::Sender<Message>>
    next_actor_id: u64
    actor_defs: Map<String, Actor>
    self_actor_id: Option<u64>
    execution_lane: ExecutionLane
    active_capabilities: Array<String>
    active_patch_frames: Array<ActivePatchFrame>
    patch_records: Array<PatchRuntimeRecord>
    patch_replay_catalog: Array<ReplayablePatchRecord>
    replayable_patch_history: Array<ReplayablePatchRecord>
    undone_patch_records: Array<ReplayablePatchRecord>
    patch_collaboration_events: Array<PatchCollaborationEvent>
    extension_state: Map<String, std::sync::Arc<impl Any>>

impl Env:
    pub fn new_() -> Env:
        let mut env = Env { scopes: [HashMap__new_()], functions: HashMap__new_(), function_inline_scopes: HashMap__new_(), patches: HashMap__new_(), laws: HashMap__new_(), patch_undo_modes: HashMap__new_(), converges: HashMap__new_(), orchestrates: HashMap__new_(), worlds: HashMap__new_(), components: HashMap__new_(), inline_modules: HashMap__new_(), methods: HashMap__new_(), actors: HashMap__new_(), next_actor_id: 1, actor_defs: HashMap__new_(), self_actor_id: none, execution_lane: ExecutionLane__Interpret, active_capabilities: [("patch.transactions").to_string(), ("converge.dispatch").to_string(), ("orchestrate.pipeline").to_string(), ("host.runtime.interpret").to_string()], active_patch_frames: Vec__new_(), patch_records: Vec__new_(), patch_replay_catalog: Vec__new_(), replayable_patch_history: Vec__new_(), undone_patch_records: Vec__new_(), patch_collaboration_events: Vec__new_(), extension_state: HashMap__new_() }
        env.register_stdlib()
        ()
        env.register_net_stdlib()
        ()
        env.register_json_stdlib()
        ()
        env.register_kos_bridge()
        ()
        env.apply_registered_extensions()
        ()
        env

    fn apply_registered_extensions(_self: &mut Env):
        let registrars = ENV_EXTENSION_REGISTRARS.read().unwrap().values().copied().collect()
        for registrar in registrars:
            registrar(*_self)
            ()

    pub fn set_extension_state(_self: &mut Env, key: impl Into<String>, state_: std::sync::Arc<impl Any>):
        (*_self).extension_state.insert(key.into(), state_)
        ()

    pub fn get_extension_state<T>(_self: &Env, key: String) -> Option<std::sync::Arc<T>>:
        (*_self).extension_state.get(key).cloned().and_then(fn(state_): state_.downcast().ok())

    pub fn register_kos_bridge(_self: &mut Env):
        (*_self).define_native("spawn_cube", fn(_env, args): none)
        ()
        (*_self).define_native("spawn_native_viewport", fn(_env, args): none)
        ()
        (*_self).define_native("spawn_native_sculpt_lab", fn(_env, args): none)
        ()
        (*_self).define_native("native_config_string", fn(_env, args): none)
        ()
        (*_self).define_native("native_config_int", fn(_env, args): none)
        ()
        (*_self).define_native("native_config_float", fn(_env, args): none)
        ()
        (*_self).define_native("native_config_flag", fn(_env, args): none)
        ()

    pub fn register_net_stdlib(_self: &mut Env):
        (*_self).define_native("http_get", fn(_env, args): none)
        ()
        (*_self).define_native("http_post_json", fn(_env, args): none)
        ()

    pub fn register_json_stdlib(_self: &mut Env):
        (*_self).define_native("json_parse", fn(_env, args): none)
        ()
        (*_self).define_native("json_string", fn(_env, args): none)
        ()

    pub fn register_stdlib(_self: &mut Env):
        (*_self).define(("None").to_string(), Value__None)
        ()
        (*_self).define(("none").to_string(), Value__None)
        ()
        (*_self).define_native("Some", fn(_env, args): none)
        ()
        (*_self).define_native("print", fn(_env, args): none)
        ()
        (*_self).define_native("println", fn(_env, args): none)
        ()
