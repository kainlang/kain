fn runtime_patch_target_path(target: &Expr) -> Option<String>:
    match target:
        Expr::Ident(name, _) => Option::Some(name.clone())
        Expr::Field { object: object, field: field } => runtime_patch_target_path(object).map(fn(base): f"{base}.{field}")
        Expr::Index { object: object, index: index } => runtime_patch_target_path(object).map(fn(base): none)
        Expr::Deref(inner, _) => runtime_patch_target_path(inner)
        _ => none

fn apply_patch_change_value(change: &ActivePatchChange, use_new_value: Bool) -> Result<(), KainError>:
    let value = if use_new_value:
        (*change).new_value.clone()
    else:
        (*change).old_value.clone()
    match &(*change).target:
        PatchMutationTarget::StructField { fields: fields, field: field } =>
            fields.write().unwrap().insert(field.clone(), value)
            ()
            Result::Ok(())
        PatchMutationTarget::ArrayIndex { values: values, index: index } =>
            let mut items = values.write().unwrap()
            if ((*index) >= items.len()):
                return Result::Err(KainError__runtime(f"Patch replay target '{(*change).path}' no longer exists at index {index}"))
            items[(*index)] = value
            ()
            Result::Ok(())

fn runtime_array_value(values: Array<Value>) -> Value:
    Value::Array(Arc__new_(RwLock__new_(values)))

fn runtime_string_array_value(values: &[String]) -> Value:
    runtime_array_value(values.iter().cloned().map(fn(__kain_closure_arg14): Value::String(__kain_closure_arg14)).collect())

fn runtime_struct_value(name: String, fields: Array<(String, Value)>) -> Value:
    let mut values = HashMap__new_()
    for selfhost_for_item in fields:
        let (field, value) = selfhost_for_item
        values.insert(field, value)
        ()
    ()
    Value::Struct(name.to_string(), Arc__new_(RwLock__new_(values)))

fn runtime_patch_mutation_record_value(change: &PatchMutationRecord) -> Value:
    runtime_struct_value("PatchMutationRecord", [(("path").to_string(), Value::String((*change).path.clone())), (("old_value").to_string(), (*change).old_value.clone()), (("new_value").to_string(), (*change).new_value.clone())])

fn runtime_patch_record_value(record: &PatchRuntimeRecord) -> Value:
    runtime_struct_value("PatchRuntimeRecord", [(("name").to_string(), Value::String((*record).name.clone())), (("mutation_paths").to_string(), runtime_string_array_value(&(*record).mutation_paths)), (("undo_mode").to_string(), Value::String((*record).undo_mode.clone())), (("collaboration_event").to_string(), Value::String((*record).collaboration_event.clone())), (("changes").to_string(), runtime_array_value((*record).changes.iter().map(runtime_patch_mutation_record_value).collect()))])

fn runtime_patch_collaboration_event_value(event: &PatchCollaborationEvent) -> Value:
    runtime_struct_value("PatchCollaborationEvent", [(("event_id").to_string(), Value::String((*event).event_id.clone())), (("patch_name").to_string(), Value::String((*event).patch_name.clone())), (("mutation_paths").to_string(), runtime_string_array_value(&(*event).mutation_paths)), (("undo_mode").to_string(), Value::String((*event).undo_mode.clone()))])

fn eval_binop(op: BinaryOp, left: Value, right: Value) -> Result<Value, KainError>:
    match (op, &left, &right):
        (BinaryOp::Add, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Int((a + b)))
        (BinaryOp::Sub, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Int((a - b)))
        (BinaryOp::Mul, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Int((a * b)))
        (BinaryOp::Div, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Int((a / b)))
        (BinaryOp::Mod, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Int((a % b)))
        (BinaryOp::Add, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Float((a + b)))
        (BinaryOp::Sub, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Float((a - b)))
        (BinaryOp::Mul, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Float((a * b)))
        (BinaryOp::Div, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Float((a / b)))
        (BinaryOp::Add, Value::String(a), Value::String(b)) => Result::Ok(Value::String((a.to_owned() + b)))
        (BinaryOp::Eq, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Bool((a == b)))
        (BinaryOp::Ne, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Bool((a != b)))
        (BinaryOp::Eq, Value::String(a), Value::String(b)) => Result::Ok(Value::Bool((a == b)))
        (BinaryOp::Ne, Value::String(a), Value::String(b)) => Result::Ok(Value::Bool((a != b)))
        (BinaryOp::Eq, Value::Bool(a), Value::Bool(b)) => Result::Ok(Value::Bool((a == b)))
        (BinaryOp::Ne, Value::Bool(a), Value::Bool(b)) => Result::Ok(Value::Bool((a != b)))
        (BinaryOp::Lt, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Bool((a < b)))
        (BinaryOp::Gt, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Bool((a > b)))
        (BinaryOp::Le, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Bool((a <= b)))
        (BinaryOp::Ge, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Bool((a >= b)))
        (BinaryOp::Eq, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Bool((((a - b)).abs() < f64__EPSILON)))
        (BinaryOp::Ne, Value::Float(a), Value::Float(b)) => Result::Ok(Value::Bool((((a - b)).abs() >= f64__EPSILON)))
        (BinaryOp::Lt, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Bool((a < b)))
        (BinaryOp::Gt, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Bool((a > b)))
        (BinaryOp::Le, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Bool((a <= b)))
        (BinaryOp::Ge, Value::Int(a), Value::Int(b)) => Result::Ok(Value::Bool((a >= b)))
        (BinaryOp::And, Value::Bool(a), Value::Bool(b)) => Result::Ok(Value::Bool(((*a) && (*b))))
        (BinaryOp::Or, Value::Bool(a), Value::Bool(b)) => Result::Ok(Value::Bool(((*a) || (*b))))
        (BinaryOp::BitAnd, Value::Int(a), Value::Int(b)) if language_features__runtime_supports_binary_op(BinaryOp__BitAnd) => Result::Ok(Value::Int((a & b)))
        (BinaryOp::BitOr, Value::Int(a), Value::Int(b)) if language_features__runtime_supports_binary_op(BinaryOp__BitOr) => Result::Ok(Value::Int((a | b)))
        (BinaryOp::BitXor, Value::Int(a), Value::Int(b)) if language_features__runtime_supports_binary_op(BinaryOp__BitXor) => Result::Ok(Value::Int((a ^ b)))
        (BinaryOp::Shl, Value::Int(a), Value::Int(b)) if language_features__runtime_supports_binary_op(BinaryOp__Shl) =>
            let shift = (((*b) as u32) & 63)
            Result::Ok(Value::Int(a.wrapping_shl(shift)))
        (BinaryOp::Shr, Value::Int(a), Value::Int(b)) if language_features__runtime_supports_binary_op(BinaryOp__Shr) =>
            let shift = (((*b) as u32) & 63)
            Result::Ok(Value::Int(a.wrapping_shr(shift)))
        (BinaryOp::Eq, Value::None, Value::None) => Result::Ok(Value::Bool(true))
        (BinaryOp::Ne, Value::None, Value::None) => Result::Ok(Value::Bool(false))
        (BinaryOp::Eq, Value::Unit, Value::Unit) => Result::Ok(Value::Bool(true))
        (BinaryOp::Ne, Value::Unit, Value::Unit) => Result::Ok(Value::Bool(false))
        (BinaryOp::Eq, _, _) => Result::Ok(Value::Bool(false))
        (BinaryOp::Ne, _, _) => Result::Ok(Value::Bool(true))
        _ => Result::Err(KainError__runtime(f"Type mismatch in binary operation: {left} {op} {right}"))

fn pattern_matches(pattern: &Pattern, value: &Value) -> Bool:
    match pattern:
        Pattern::Wildcard(_) => true
        Pattern::Binding {  } => true
        Pattern::Literal(Expr::Int(n, _)) =>
            match value:
                Value::Int(v) if ((*v) == (*n)) => true
                _ => false
        Pattern::Literal(Expr::String(s, _)) =>
            match value:
                Value::String(v) if (v == s) => true
                _ => false
        Pattern::Literal(Expr::Bool(b, _)) =>
            match value:
                Value::Bool(v) if ((*v) == (*b)) => true
                _ => false
        Pattern::Literal(Expr::None(_)) =>
            match value:
                Value::None => true
                _ => false
        Pattern::Variant { variant: variant, fields: fields } =>
            match value:
                Value::Poll(ready, val) =>
                    if ((*variant) == "Ready"):
                        if (!ready):
                            return false
                        match fields:
                            VariantPatternFields::Tuple(pats) =>
                                if (pats.len() == 1):
                                    return none
                                ()
                            _ =>
                                ()
                                ()
                        return false
                    elif ((*variant) == "Pending"):
                        return (!ready)
                    return false
                _ =>
                    ()
                    ()
            match value:
                Value::EnumVariant(_, v_name, v_fields) =>
                    if (variant != v_name):
                        return false
                    match fields:
                        VariantPatternFields::Unit => v_fields.is_empty()
                        VariantPatternFields::Tuple(pats) =>
                            if (pats.len() != v_fields.len()):
                                return false
                            pats.iter().zip(v_fields.iter()).all(fn(__kain_closure_arg15): pattern_matches(__kain_closure_arg15.__kain_tuple_0, __kain_closure_arg15.__kain_tuple_1))
                        _ => false
                _ => false
        _ => false

fn bind_pattern(env: &mut Env, pattern: &Pattern, value: &Value):
    match pattern:
        Pattern::Binding { name: name } =>
            env.define(name.clone(), value.clone())
            ()
        Pattern::Variant { variant: variant, fields: fields } =>
            match value:
                Value::Poll(ready, val) =>
                    if (((*variant) == "Ready") && (*ready)):
                        match fields:
                            VariantPatternFields::Tuple(pats) =>
                                if (pats.len() == 1):
                                    match val:
                                        Some(v) =>
                                            bind_pattern(env, &pats[0], v)
                                            ()
                                        _ => ()
                            _ => ()
                _ =>
                    match value:
                        Value::EnumVariant(_, _, v_fields) =>
                            match fields:
                                VariantPatternFields::Tuple(pats) =>
                                    for selfhost_for_item in pats.iter().zip(v_fields.iter()):
                                        let (p, v) = selfhost_for_item
                                        bind_pattern(env, p, v)
                                        ()
                                _ => ()
                        _ => ()
        _ => ()

@doc(doc = " Run all tests in the program")
pub fn run_tests(program: &TypedProgram) -> Result<(), KainError>:
    println("\n Running Tests...\n")
    let mut passed = 0
    let mut failed = 0
    let mut failure_messages = Vec__new_()
    let mut env = Env__new_()
    env.set_execution_lane(ExecutionLane__Test)
    ()
    env.register_typed_program(program)?
    ()
    env.apply_registered_extensions()
    ()
    for item in &(*program).items:
        match item:
            types__TypedItem::Test(test_) =>
                print(f"test {test_.ast.name} ... ")
                env.push_scope()
                ()
                match eval_block(&mut env, &test_.ast.body):
                    Ok(_) =>
                        println("ok")
                        passed = (passed + 1)
                        ()
                        ()
                        ()
                        ()
                    Err(e) =>
                        println("FAILED")
                        println(f"  Error: {e}")
                        failed = (failed + 1)
                        ()
                        failure_messages.push(f"{test_.ast.name}: {e}")
                        ()
                        ()
                        ()
                        ()
                env.pop_scope()
                ()
            _ => ()
    ()
    println("\nTest result: {if (failed == 0): \"ok\" else: \"FAILED\"}. {passed} passed; {failed} failed")
    if (failed > 0):
        Result::Err(KainError__runtime("Some tests failed: {failure_messages.join(\"; \")}"))
    else:
        Result::Ok(())

@doc(doc = " Poll a future repeatedly until it returns Ready")
fn poll_future_to_completion(env: &mut Env, future_val: Value) -> Result<Value, KainError>:
    let max_iterations = 100000
    let mut iterations = 0
    let current_future = future_val
    loop:
        iterations = (iterations + 1)
        ()
        if (iterations > max_iterations):
            return Result::Err(KainError__runtime("Async timeout: future did not complete"))
        let poll_result = poll_future_once(env, current_future.clone())?
        match extract_poll_result(&poll_result):
            PollState::Ready(val) => return Result::Ok(val)
            PollState::Pending =>
                std__thread__sleep(Duration__from_micros(10))
                ()
                continue
            PollState::NotAPoll => return Result::Ok(poll_result)

@doc(doc = " Poll a future exactly once and return the Poll result")
fn poll_future_once(env: &mut Env, future_val: Value) -> Result<Value, KainError>:
    match &future_val:
        Value::Future(struct_name, state_) =>
            let poll_fn_name = f"{struct_name}_poll"
            match (*env).functions.get(&poll_fn_name).cloned():
                Some(poll_fn) =>
                    let struct_val = Value::Struct(struct_name.clone(), state_.clone())
                    env.push_scope()
                    ()
                    env.define(("self").to_string(), struct_val.clone())
                    ()
                    match poll_fn.params.first():
                        Some(first_param) =>
                            env.define(first_param.name.clone(), struct_val)
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    let result = eval_block(env, &poll_fn.body)?
                    env.pop_scope()
                    ()
                    let actual_result = match result:
                        Value::Return(v) => (*v)
                        v => v
                    Result::Ok(normalize_poll_result(actual_result))
                _ => Result::Ok(Value::Poll(true, Option::Some(Box__new_(Value__Unit))))
        Value::Struct(struct_name, _) =>
            let poll_fn_name = f"{struct_name}_poll"
            match (*env).functions.get(&poll_fn_name).cloned():
                Some(poll_fn) =>
                    env.push_scope()
                    ()
                    env.define(("self").to_string(), future_val.clone())
                    ()
                    match poll_fn.params.first():
                        Some(first_param) =>
                            env.define(first_param.name.clone(), future_val.clone())
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    let result = eval_block(env, &poll_fn.body)?
                    env.pop_scope()
                    ()
                    let actual_result = match result:
                        Value::Return(v) => (*v)
                        v => v
                    Result::Ok(normalize_poll_result(actual_result))
                _ => Result::Ok(Value::Poll(true, Option::Some(Box__new_(future_val))))
        Value::Poll(_, _) => Result::Ok(future_val)
        Value::EnumVariant(enum_name, _, _) if (enum_name == "Poll") => Result::Ok(normalize_poll_result(future_val))
        _ => Result::Ok(Value::Poll(true, Option::Some(Box__new_(future_val))))

enum PollState:
    Ready(Value)
    Pending
    NotAPoll

@doc(doc = " Extract the poll state from a value")
fn extract_poll_result(val: &Value) -> PollState:
    match val:
        Value::Poll(true, Some(inner)) => PollState::Ready((*inner.clone()))
        Value::Poll(true, None) => PollState::Ready(Value__Unit)
        Value::Poll(false, _) => PollState__Pending
        Value::EnumVariant(enum_name, variant, fields) if (enum_name == "Poll") =>
            match variant.as_str():
                "Ready" => if fields.is_empty(): PollState::Ready(Value__Unit) else: PollState::Ready(fields[0].clone())
                "Pending" => PollState__Pending
                _ => PollState__NotAPoll
        Value::Struct(name, fields) =>
            if name.contains("Ready"):
                let fields_guard = fields.read().unwrap()
                match fields_guard.get("0").or_(fields_guard.get("value")).or_(fields_guard.values().next()):
                    Some(val) => PollState::Ready(val.clone())
                    _ => PollState::Ready(Value__Unit)
            elif name.contains("Pending"):
                PollState__Pending
            else:
                PollState__NotAPoll
        Value::Tuple(elems) if (elems.len() >= 1) =>
            match &elems[0]:
                Value::String(tag) =>
                    match tag.as_str():
                        "Ready" if (elems.len() >= 2) => PollState::Ready(elems[1].clone())
                        "Ready" => PollState::Ready(Value__Unit)
                        "Pending" => PollState__Pending
                        _ => PollState__NotAPoll
                _ => PollState__NotAPoll
        _ => PollState__NotAPoll

@doc(doc = " Normalize various poll representations to our standard Value::Poll")
fn normalize_poll_result(val: Value) -> Value:
    match extract_poll_result(&val):
        PollState::Ready(inner) => Value::Poll(true, Option::Some(Box__new_(inner)))
        PollState::Pending => Value::Poll(false, none)
        PollState::NotAPoll => val

