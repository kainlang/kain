                "find" if none => infer_builtin_string_arg_method(env, ctx, args, span, "String.find", ResolvedType::Option(Box__new_(ResolvedType::Int(IntSize__I64))))
                "split" if none => infer_builtin_string_arg_method(env, ctx, args, span, "String.split", dynamic_array_type(shared_ref_type(ResolvedType__String)))
                "strip_prefix" if none => infer_builtin_string_arg_method(env, ctx, args, span, "String.strip_prefix", ResolvedType::Option(Box__new_(shared_ref_type(ResolvedType__String))))
                "push_str" if none =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("String.push_str expects exactly one argument", span))
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&ResolvedType__String))?
                    ensure_type_compatible(env, &ResolvedType__String, &arg_ty, args[0].span, "String.push_str")?
                    ()
                    Result::Ok(ResolvedType__Unit)
                "push" if none =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("String.push expects exactly one argument", span))
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&ResolvedType__Char))?
                    ensure_type_compatible(env, &ResolvedType__Char, &arg_ty, args[0].span, "String.push")?
                    ()
                    Result::Ok(ResolvedType__Unit)
                "repeat" if none =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("String.repeat expects exactly one argument", span))
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&ResolvedType::Int(IntSize__I64)))?
                    ensure_type_compatible(env, &ResolvedType::Int(IntSize__I64), &arg_ty, args[0].span, "String.repeat")?
                    ()
                    Result::Ok(ResolvedType__String)
                "to_ascii_lowercase" if none => if args.is_empty(): Result::Ok(ResolvedType__String) else: Result::Err(env.type_error("String.to_ascii_lowercase expects no arguments", span))
                "parse" if none => if args.is_empty(): Result::Ok(ResolvedType::Result(Box__new_(ResolvedType__Unknown), Box__new_(ResolvedType__String))) else: Result::Err(env.type_error("String.parse expects no arguments", span))
                "min" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "max" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "div_ceil" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, "div_ceil")
                "saturating_add" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "saturating_sub" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "saturating_mul" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_add" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_sub" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_mul" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_shl" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_shr" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "is_uppercase" if none => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.{method} expects no arguments", span))
                "is_ascii_uppercase" if none => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.{method} expects no arguments", span))
                "is_ascii_alphabetic" if none => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.{method} expects no arguments", span))
                "is_ascii_alphanumeric" if none => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.{method} expects no arguments", span))
                "to_string" => if args.is_empty(): Result::Ok(ResolvedType__String) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.to_string expects no arguments", span))
                _ => Result::Err(env.type_error(f"Unknown method '{method}' on {describe_type(receiver_ty)}", span))
        ResolvedType::String =>
            match method:
                "len" if none => Result::Ok(ResolvedType::Int(IntSize__I64))
                "is_empty" if none => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error("String.is_empty expects no arguments", span))
                "chars" if none => if args.is_empty(): Result::Ok(dynamic_array_type(ResolvedType__String)) else: Result::Err(env.type_error("String.chars expects no arguments", span))
                "char_indices" if none => if args.is_empty(): Result::Ok(dynamic_array_type(ResolvedType::Tuple([ResolvedType::Int(IntSize__I64), ResolvedType__String]))) else: Result::Err(env.type_error("String.char_indices expects no arguments", span))
                "as_str" if none => if args.is_empty(): Result::Ok(shared_ref_type(ResolvedType__String)) else: Result::Err(env.type_error("String.as_str expects no arguments", span))
                "trim" if none => if args.is_empty(): Result::Ok(shared_ref_type(ResolvedType__String)) else: Result::Err(env.type_error("String.trim expects no arguments", span))
                "to_string_lossy" if none => if args.is_empty(): Result::Ok(ResolvedType__String) else: Result::Err(env.type_error("String.to_string_lossy expects no arguments", span))
                "starts_with" if none => infer_builtin_string_arg_predicate(env, ctx, args, span, if (method == "starts_with"): "String.starts_with" else: "String.eq_ignore_ascii_case")
                "eq_ignore_ascii_case" if none => infer_builtin_string_arg_predicate(env, ctx, args, span, if (method == "starts_with"): "String.starts_with" else: "String.eq_ignore_ascii_case")
                "find" if none => infer_builtin_string_arg_method(env, ctx, args, span, "String.find", ResolvedType::Option(Box__new_(ResolvedType::Int(IntSize__I64))))
                "split" if none => infer_builtin_string_arg_method(env, ctx, args, span, "String.split", dynamic_array_type(shared_ref_type(ResolvedType__String)))
                "strip_prefix" if none => infer_builtin_string_arg_method(env, ctx, args, span, "String.strip_prefix", ResolvedType::Option(Box__new_(shared_ref_type(ResolvedType__String))))
                "push_str" if none =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("String.push_str expects exactly one argument", span))
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&ResolvedType__String))?
                    ensure_type_compatible(env, &ResolvedType__String, &arg_ty, args[0].span, "String.push_str")?
                    ()
                    Result::Ok(ResolvedType__Unit)
                "push" if none =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("String.push expects exactly one argument", span))
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&ResolvedType__Char))?
                    ensure_type_compatible(env, &ResolvedType__Char, &arg_ty, args[0].span, "String.push")?
                    ()
                    Result::Ok(ResolvedType__Unit)
                "repeat" if none =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("String.repeat expects exactly one argument", span))
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&ResolvedType::Int(IntSize__I64)))?
                    ensure_type_compatible(env, &ResolvedType::Int(IntSize__I64), &arg_ty, args[0].span, "String.repeat")?
                    ()
                    Result::Ok(ResolvedType__String)
                "to_ascii_lowercase" if none => if args.is_empty(): Result::Ok(ResolvedType__String) else: Result::Err(env.type_error("String.to_ascii_lowercase expects no arguments", span))
                "parse" if none => if args.is_empty(): Result::Ok(ResolvedType::Result(Box__new_(ResolvedType__Unknown), Box__new_(ResolvedType__String))) else: Result::Err(env.type_error("String.parse expects no arguments", span))
                "min" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "max" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "div_ceil" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, "div_ceil")
                "saturating_add" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "saturating_sub" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "saturating_mul" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_add" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_sub" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_mul" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_shl" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "wrapping_shr" if none => infer_builtin_same_type_numeric_method(env, ctx, receiver_ty, args, span, method)
                "is_uppercase" if none => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.{method} expects no arguments", span))
                "is_ascii_uppercase" if none => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.{method} expects no arguments", span))
                "is_ascii_alphabetic" if none => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.{method} expects no arguments", span))
                "is_ascii_alphanumeric" if none => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.{method} expects no arguments", span))
                "to_string" => if args.is_empty(): Result::Ok(ResolvedType__String) else: Result::Err(env.type_error(f"{describe_type(receiver_ty)}.to_string expects no arguments", span))
                _ => Result::Err(env.type_error(f"Unknown method '{method}' on {describe_type(receiver_ty)}", span))
        ResolvedType::Unknown => Result::Ok(ResolvedType__Unknown)
        other => Result::Err(env.type_error(f"Method call requires a receiver with known methods, found {describe_type(other)}", span))

fn infer_named_method_call_type(env: &mut TypeEnv, ctx: Option<&SemanticContext>, type_name: String, receiver_ty: &ResolvedType, method: String, args: &[CallArg], span: Span) -> Result<ResolvedType, KainError>:
    match env.lookup_method(type_name, method).cloned():
        Some(method_ty) =>
            match method_ty:
                ResolvedType::Function { params: params, ret: ret, effects: effects } =>
                    let start_index = usize__from(params.first().map(fn(ty): method_receiver_param_matches(ty, receiver_ty)).unwrap_or(false))
                    let params = &params[start_index..]
                    if (params.len() != args.len()):
                        return Result::Err(env.type_error(f"Method '{method}' expects {params.len()} argument(s), found {args.len()}", span))
                    for selfhost_for_item in params.iter().zip(args.iter()):
                        let (param_ty, arg) = selfhost_for_item
                        let arg_ty = infer_expr_type_with_expected(env, &arg.value, ctx, Option::Some(param_ty))?
                        ensure_type_compatible(env, param_ty, &arg_ty, span, "method argument")?
                        ()
                    ()
                    match ctx:
                        Some(ctx) =>
                            effects__check_effect_call(&ctx.effects, &effects, &ctx.function_name, method, span)?
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    Result::Ok((*ret))
                _ => Result::Ok(ResolvedType__Unknown)
        _ => if (method == "to_string"): if args.is_empty(): Result::Ok(ResolvedType__String) else: Result::Err(env.type_error(f"{type_name}.to_string expects no arguments", span)) else: Result::Err(env.type_error(f"Unknown method '{method}' on {type_name}", span))

fn method_receiver_param_matches(param_ty: &ResolvedType, receiver_ty: &ResolvedType) -> Bool:
    if types_compatible(param_ty, receiver_ty):
        return true
    let owned_receiver = peel_receiver_refs(receiver_ty).clone()
    (types_compatible(param_ty, &owned_receiver) || types_compatible(param_ty, &shared_ref_type(owned_receiver)))

fn infer_index_lookup_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, inner_ty: &ResolvedType, args: &[CallArg], span: Span, method_name: String) -> Result<ResolvedType, KainError>:
    if (args.len() != 1):
        return Result::Err(env.type_error(f"{method_name} expects exactly one argument", span))
    let index_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&ResolvedType::Int(IntSize__I64)))?
    ensure_type_compatible(env, &ResolvedType::Int(IntSize__I64), &index_ty, args[0].span, method_name)?
    ()
    Result::Ok(ResolvedType::Option(Box__new_(ResolvedType::Ref { mutable_: false, inner: Box__new_(inner_ty.clone()) })))

fn dynamic_array_type(item_ty: ResolvedType) -> ResolvedType:
    ResolvedType::Array(Box__new_(item_ty), 0)

fn shared_ref_type(inner: ResolvedType) -> ResolvedType:
    ResolvedType::Ref { mutable_: false, inner: Box__new_(inner) }

fn infer_builtin_predicate_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, input_ty: &ResolvedType, args: &[CallArg], span: Span, method_name: String) -> Result<ResolvedType, KainError>:
    let predicate_ty = infer_builtin_unary_callback_return(env, ctx, input_ty, args, span, method_name)?
    ensure_type_compatible(env, &ResolvedType__Bool, &predicate_ty, args[0].span, method_name)?
    ()
    Result::Ok(ResolvedType__Bool)

fn infer_builtin_find_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, input_ty: &ResolvedType, args: &[CallArg], span: Span, method_name: String) -> Result<ResolvedType, KainError>:
    let predicate_ty = infer_builtin_unary_callback_return(env, ctx, input_ty, args, span, method_name)?
    ensure_type_compatible(env, &ResolvedType__Bool, &predicate_ty, args[0].span, method_name)?
    ()
    Result::Ok(ResolvedType::Option(Box__new_(input_ty.clone())))

fn infer_builtin_find_map_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, input_ty: &ResolvedType, args: &[CallArg], span: Span, method_name: String) -> Result<ResolvedType, KainError>:
    let mapped_ty = infer_builtin_unary_callback_return(env, ctx, input_ty, args, span, method_name)?
    match mapped_ty:
        ResolvedType::Option(inner) => Result::Ok(ResolvedType::Option(inner))
        ResolvedType::Unknown => Result::Ok(ResolvedType::Option(Box__new_(ResolvedType__Unknown)))
        other => Result::Err(env.type_error(f"{method_name} expects a callback returning Option<T>, found {describe_type(&other)}", args[0].span))

fn infer_builtin_collect_method(item_ty: &ResolvedType, args: &[CallArg], span: Span, env: &mut TypeEnv, method_name: String) -> Result<ResolvedType, KainError>:
    if (!args.is_empty()):
        return Result::Err(env.type_error(f"{method_name} expects no arguments", span))
    match item_ty:
        ResolvedType::Result(ok, err) => Result::Ok(ResolvedType::Result(Box__new_(dynamic_array_type(ok.clone())), err.clone()))
        ResolvedType::Option(inner) => Result::Ok(ResolvedType::Option(Box__new_(dynamic_array_type(inner.clone()))))
        ResolvedType::Tuple(items) if (items.len() == 2) => Result::Ok(selfhost_map_type())
        other => Result::Ok(dynamic_array_type(other.clone()))

fn infer_builtin_join_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, item_ty: &ResolvedType, args: &[CallArg], span: Span, method_name: String) -> Result<ResolvedType, KainError>:
    let string_item = ResolvedType__String
    let borrowed_string_item = shared_ref_type(ResolvedType__String)
    if ((!types_compatible(&string_item, item_ty)) && (!types_compatible(&borrowed_string_item, item_ty))):
        return Result::Err(env.type_error(f"{method_name} requires a String sequence, found {describe_type(item_ty)}", span))
    infer_builtin_string_arg_method(env, ctx, args, span, method_name, ResolvedType__String)

fn infer_builtin_first_method(item_ty: &ResolvedType, args: &[CallArg], span: Span, env: &mut TypeEnv, method_name: String) -> Result<ResolvedType, KainError>:
    if (!args.is_empty()):
        return Result::Err(env.type_error(f"{method_name} expects no arguments", span))
    let first_ty = match item_ty:
        ResolvedType::Ref {  } => item_ty.clone()
        other => shared_ref_type(other.clone())
    Result::Ok(ResolvedType::Option(Box__new_(first_ty)))

fn infer_builtin_clone_adapter(item_ty: &ResolvedType, args: &[CallArg], span: Span, env: &mut TypeEnv, method_name: String) -> Result<ResolvedType, KainError>:
    if (!args.is_empty()):
        return Result::Err(env.type_error(f"{method_name} expects no arguments", span))
    let cloned_item = match item_ty:
        ResolvedType::Ref { mutable_: false, inner: inner } => inner.clone()
        other => other.clone()
    Result::Ok(dynamic_array_type(cloned_item))

fn infer_builtin_option_clone_adapter(item_ty: &ResolvedType, args: &[CallArg], span: Span, env: &mut TypeEnv, method_name: String) -> Result<ResolvedType, KainError>:
    if (!args.is_empty()):
        return Result::Err(env.type_error(f"{method_name} expects no arguments", span))
    let cloned_item = match item_ty:
        ResolvedType::Ref { mutable_: false, inner: inner } => inner.clone()
        other => other.clone()
    Result::Ok(ResolvedType::Option(Box__new_(cloned_item)))

fn infer_builtin_zip_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, item_ty: &ResolvedType, args: &[CallArg], span: Span, method_name: String) -> Result<ResolvedType, KainError>:
    if (args.len() != 1):
        return Result::Err(env.type_error(f"{method_name} expects exactly one argument", span))
    let other_ty = infer_expr_type(env, &args[0].value, ctx)?
    let other_item_ty = match other_ty:
        ResolvedType::Array(inner, _) => (*inner)
        ResolvedType::Slice(inner) => (*inner)
        ResolvedType::Ref { inner: inner } =>
            match (*inner):
                ResolvedType::Array(inner, _) => (*inner)
                ResolvedType::Slice(inner) => (*inner)
                other => return Result::Err(env.type_error(f"{method_name} expects an array or slice argument, found {describe_type(&other)}", args[0].span))
        other => return Result::Err(env.type_error(f"{method_name} expects an array or slice argument, found {describe_type(&other)}", args[0].span))
    Result::Ok(dynamic_array_type(ResolvedType::Tuple([item_ty.clone(), other_item_ty])))

fn infer_builtin_sum_method(item_ty: &ResolvedType, args: &[CallArg], span: Span, env: &mut TypeEnv, method_name: String) -> Result<ResolvedType, KainError>:
    if (!args.is_empty()):
        return Result::Err(env.type_error(f"{method_name} expects no arguments", span))
    let numeric_ty = peel_shared_refs(item_ty)
    if (none):
        Result::Ok(numeric_ty.clone())
    else:
        Result::Err(env.type_error(f"{method_name} requires numeric items, found {describe_type(item_ty)}", span))

fn infer_builtin_max_method(item_ty: &ResolvedType, args: &[CallArg], span: Span, env: &mut TypeEnv, method_name: String) -> Result<ResolvedType, KainError>:
    if (!args.is_empty()):
        return Result::Err(env.type_error(f"{method_name} expects no arguments", span))
    Result::Ok(ResolvedType::Option(Box__new_(item_ty.clone())))

fn infer_builtin_unary_callback_return(env: &mut TypeEnv, ctx: Option<&SemanticContext>, input_ty: &ResolvedType, args: &[CallArg], span: Span, method_name: String) -> Result<ResolvedType, KainError>:
    if (args.len() != 1):
        return Result::Err(env.type_error(f"{method_name} expects exactly one argument", span))
    let expected_callback = ResolvedType::Function { params: [input_ty.clone()], ret: Box__new_(ResolvedType__Unknown), effects: EffectSet__new_() }
    let callback_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&expected_callback))?
    match callback_ty:
        ResolvedType::Function { params: params, ret: ret } if (params.len() == 1) =>
            ensure_type_compatible(env, input_ty, &params[0], args[0].span, method_name)?
            ()
            Result::Ok((*ret))
        ResolvedType::Unknown => Result::Ok(ResolvedType__Unknown)
        other => Result::Err(env.type_error(f"{method_name} expects a unary function, found {describe_type(&other)}", args[0].span))

fn infer_builtin_nullary_callback_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, args: &[CallArg], span: Span, method_name: String, wrap_output: impl FnOnce) -> Result<ResolvedType, KainError>:
    if (args.len() != 1):
        return Result::Err(env.type_error(f"{method_name} expects exactly one argument", span))
    let expected_callback = ResolvedType::Function { params: [], ret: Box__new_(ResolvedType__Unknown), effects: EffectSet__new_() }
    let callback_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&expected_callback))?
    match callback_ty:
        ResolvedType::Function { params: params, ret: ret } if params.is_empty() => wrap_output((*ret))
        ResolvedType::Unknown => wrap_output(ResolvedType__Unknown)
        other => Result::Err(env.type_error(f"{method_name} expects a nullary function, found {describe_type(&other)}", args[0].span))

fn infer_builtin_unary_result_callback(env: &mut TypeEnv, ctx: Option<&SemanticContext>, input_ty: &ResolvedType, args: &[CallArg], span: Span, method_name: String, wrap_output: impl FnOnce) -> Result<ResolvedType, KainError>:
    let mapped = infer_builtin_unary_callback_return(env, ctx, input_ty, args, span, method_name)?
    wrap_output(mapped)

fn ensure_type_compatible_option(mapped: ResolvedType, expected: &ResolvedType) -> Result<ResolvedType, KainError>:
    if (none || types_compatible(expected, &mapped)):
        Result::Ok(if none: expected.clone() else: mapped)
    else:
        Result::Ok(ResolvedType__Unknown)

fn ensure_option_return_type(mapped: ResolvedType, expected: &ResolvedType) -> Result<ResolvedType, KainError>:
    match mapped:
        ResolvedType::Option(inner) => if (none || types_compatible(expected, inner)): Result::Ok(ResolvedType::Option(Box__new_(if none: expected.clone() else: inner.clone()))) else: Result::Ok(ResolvedType::Option(Box__new_(ResolvedType__Unknown)))
        ResolvedType::Unknown => Result::Ok(ResolvedType::Option(Box__new_(expected.clone())))
        other => Result::Ok(ResolvedType::Option(Box__new_(other)))

fn ensure_result_type(mapped: ResolvedType, ok_ty: &ResolvedType) -> Result<ResolvedType, KainError>:
    match mapped:
        ResolvedType::Result(ok, err) => if types_compatible(ok_ty, ok): Result::Ok(ResolvedType::Result(Box__new_(ok_ty.clone()), err)) else: Result::Ok(ResolvedType::Result(Box__new_(ResolvedType__Unknown), err))
        ResolvedType::Unknown => Result::Ok(ResolvedType::Result(Box__new_(ok_ty.clone()), Box__new_(ResolvedType__Unknown)))
        other => Result::Ok(other)

fn infer_builtin_string_arg_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, args: &[CallArg], span: Span, method_name: String, return_ty: ResolvedType) -> Result<ResolvedType, KainError>:
    if (args.len() != 1):
        return Result::Err(env.type_error(f"{method_name} expects exactly one argument", span))
    let expected_borrowed = shared_ref_type(ResolvedType__String)
    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&expected_borrowed))?
    if (((!types_compatible(&ResolvedType__String, &arg_ty)) && (!types_compatible(&expected_borrowed, &arg_ty))) && (!types_compatible(&ResolvedType__String, peel_shared_refs(&arg_ty)))):
        return Result::Err(env.type_error(f"{method_name} expected String or &String, found {describe_type(&arg_ty)}", args[0].span))
    Result::Ok(return_ty)

fn infer_builtin_string_arg_predicate(env: &mut TypeEnv, ctx: Option<&SemanticContext>, args: &[CallArg], span: Span, method_name: String) -> Result<ResolvedType, KainError>:
    infer_builtin_string_arg_method(env, ctx, args, span, method_name, ResolvedType__Bool)

fn infer_builtin_same_type_numeric_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, receiver_ty: &ResolvedType, args: &[CallArg], span: Span, method_name: String) -> Result<ResolvedType, KainError>:
    if (args.len() != 1):
        return Result::Err(env.type_error(f"{method_name} expects exactly one argument", span))
    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(receiver_ty))?
    ensure_type_compatible(env, receiver_ty, &arg_ty, args[0].span, method_name)?
    ()
    Result::Ok(receiver_ty.clone())

fn peel_shared_refs<a>(ty: &a ResolvedType) -> &a ResolvedType:
    match ty:
        ResolvedType::Ref { mutable_: false, inner: inner } => peel_shared_refs(inner)
        other => other

fn peel_receiver_refs<a>(ty: &a ResolvedType) -> &a ResolvedType:
    match ty:
        ResolvedType::Ref { inner: inner } => peel_receiver_refs(inner)
        other => other

fn infer_builtin_transform_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, input_ty: &ResolvedType, args: &[CallArg], span: Span, wrap_output: impl FnOnce) -> Result<ResolvedType, KainError>:
    if (args.len() != 1):
        return Result::Err(env.type_error("transform method expects exactly one argument", span))
    let expected_mapper = ResolvedType::Function { params: [input_ty.clone()], ret: Box__new_(ResolvedType__Unknown), effects: EffectSet__new_() }
    let mapper_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&expected_mapper))?
    match mapper_ty:
        ResolvedType::Function { params: params, ret: ret } if (params.len() == 1) =>
            ensure_type_compatible(env, input_ty, &params[0], args[0].span, "transform callback input")?
            ()
            Result::Ok(wrap_output((*ret)))
        ResolvedType::Unknown => Result::Ok(wrap_output(ResolvedType__Unknown))
        other => Result::Err(env.type_error(f"transform method expects a unary function, found {describe_type(&other)}", args[0].span))

fn infer_builtin_option_chain_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, input_ty: &ResolvedType, args: &[CallArg], span: Span) -> Result<ResolvedType, KainError>:
    let mapped = infer_builtin_unary_callback_return(env, ctx, input_ty, args, span, "Option.and_then")?
    ensure_option_return_type(mapped, input_ty)

fn infer_builtin_option_filter_method(env: &mut TypeEnv, ctx: Option<&SemanticContext>, input_ty: &ResolvedType, args: &[CallArg], span: Span) -> Result<ResolvedType, KainError>:
    let predicate = infer_builtin_unary_callback_return(env, ctx, input_ty, args, span, "Option.filter")?
    ensure_type_compatible(env, &ResolvedType__Bool, &predicate, span, "Option.filter predicate")?
    ()
    Result::Ok(ResolvedType::Option(Box__new_(input_ty.clone())))

fn infer_macro_type(env: &mut TypeEnv, name: String, args: &[Expr], ctx: Option<&SemanticContext>) -> Result<ResolvedType, KainError>:
    match name:
        "vec" =>
            let arg_types = args.iter().map(fn(arg): infer_expr_type(env, arg, ctx)).collect()?
            let element_ty = arg_types.into_iter().fold(ResolvedType__Unknown, fn(acc, ty): if none: ty else: unify_types(&acc, &ty).unwrap_or(ResolvedType__Unknown))
            Result::Ok(ResolvedType::Array(Box__new_(element_ty), args.len()))
        "format" => Result::Ok(ResolvedType__String)
        "type_name" => Result::Ok(ResolvedType__String)
        "panic" => Result::Ok(ResolvedType__Never)
        _ => Result::Ok(ResolvedType__Unknown)

fn pattern_match_subject_type(ty: &ResolvedType) -> &ResolvedType:
    match ty:
        ResolvedType::Ref { inner: inner } => inner
        ResolvedType::Ptr { inner: inner } => inner
        other => other

fn borrowed_pattern_binding_type(container_ty: &ResolvedType, field_ty: &ResolvedType) -> ResolvedType:
    match container_ty:
        ResolvedType::Ref { mutable_: mutable_ } => ResolvedType::Ref { mutable_: (*mutable_), inner: Box__new_(field_ty.clone()) }
        ResolvedType::Ptr { mutable_: mutable_ } => ResolvedType::Ptr { mutable_: (*mutable_), inner: Box__new_(field_ty.clone()) }
        _ => field_ty.clone()

fn check_pattern_compatibility(env: &mut TypeEnv, pattern: &Pattern, scrutinee_ty: &ResolvedType) -> Result<(), KainError>:
    match pattern:
        Pattern::Wildcard(_) => Result::Ok(())
        Pattern::Binding {  } => Result::Ok(())
        Pattern::Literal(expr) =>
            let literal_ty = infer_expr_type(env, expr, none)?
            ensure_type_compatible(env, pattern_match_subject_type(scrutinee_ty), &literal_ty, expr.span(), "match pattern")
        Pattern::Tuple(patterns, span) =>
            match pattern_match_subject_type(scrutinee_ty):
                ResolvedType::Tuple(items) if (items.len() == patterns.len()) =>
                    for selfhost_for_item in patterns.iter().zip(items.iter()):
                        let (pattern, item_ty) = selfhost_for_item
                        check_pattern_compatibility(env, pattern, item_ty)?
                        ()
                    ()
                    Result::Ok(())
                ResolvedType::Unknown => Result::Ok(())
                other => Result::Err(env.type_error(f"Tuple pattern does not match {describe_type(other)}", (*span)))
        Pattern::Struct { name: name, fields: fields, span: span } =>
            match pattern_match_subject_type(scrutinee_ty):
                ResolvedType::Struct(struct_name, known_fields) if ((struct_name == name) || none) =>
                    for selfhost_for_item in fields:
                        let (field_name, field_pattern) = selfhost_for_item
                        let field_ty = known_fields.get(field_name).cloned().unwrap_or(ResolvedType__Unknown)
                        check_pattern_compatibility(env, field_pattern, &field_ty)?
                        ()
                    ()
                    Result::Ok(())
                ResolvedType::Unknown => Result::Ok(())
                other => Result::Err(env.type_error(f"Struct pattern '{name}' does not match {describe_type(other)}", (*span)))
        Pattern::Variant { enum_name: enum_name, variant: variant, fields: fields, span: span } =>
            let match_ty = pattern_match_subject_type(scrutinee_ty)
            let expected_enum = enum_name.or_else(fn(): none).unwrap_or_default()
            let field_types = if (!expected_enum.is_empty()):
                env.lookup_enum_variant_fields(expected_enum, variant).cloned()
            else:
                builtin_variant_field_types(match_ty, variant)
            match field_types:
                Some(field_types) =>
                    match (fields, field_types.as_slice()):
                        (VariantPatternFields::Unit, []) => ()
                        (VariantPatternFields::Tuple(patterns), types) if (patterns.len() == types.len()) =>
                            for selfhost_for_item in patterns.iter().zip(types.iter()):
                                let (pattern, field_ty) = selfhost_for_item
                                check_pattern_compatibility(env, pattern, field_ty)?
                                ()
                            ()
                            ()
                        (VariantPatternFields::Struct(patterns), _) =>
                            for selfhost_for_item in patterns:
                                let (field_name, pattern) = selfhost_for_item
                                match env.lookup_enum_variant_named_field(expected_enum, variant, field_name).cloned():
                                    Some(field_ty) =>
                                        check_pattern_compatibility(env, pattern, &field_ty)?
                                        ()
                                    _ => return Result::Err(env.type_error(f"Unknown field '{expected_enum}::{variant}.{field_name}'", (*span)))
                            ()
                            ()
                        _ => ()
                    ()
                _ =>
                    ()
                    ()
            match match_ty:
                ResolvedType::Enum(enum_name, _) if (expected_enum.is_empty() || (expected_enum == enum_name)) => Result::Ok(())
                ResolvedType::Struct(type_name, _) if ((!expected_enum.is_empty()) && (expected_enum == type_name)) => Result::Ok(())
                ResolvedType::Enum(_, _) => Result::Ok(())
                ResolvedType::Option(_) => Result::Ok(())
                ResolvedType::Result(_, _) => Result::Ok(())
                ResolvedType::Unknown => Result::Ok(())
                other => Result::Err(env.type_error(f"Variant pattern does not match {describe_type(other)}", (*span)))
        Pattern::Slice { patterns: patterns, span: span } =>
            match pattern_match_subject_type(scrutinee_ty):
                ResolvedType::Array(inner, _) =>
                    for pattern in patterns:
                        check_pattern_compatibility(env, pattern, inner)?
                        ()
                    ()
                    Result::Ok(())
                ResolvedType::Slice(inner) =>
                    for pattern in patterns:
                        check_pattern_compatibility(env, pattern, inner)?
                        ()
                    ()
                    Result::Ok(())
                ResolvedType::Unknown => Result::Ok(())
                other => Result::Err(env.type_error(f"Slice pattern does not match {describe_type(other)}", (*span)))
        Pattern::Or(patterns, _) =>
            for pattern in patterns:
                check_pattern_compatibility(env, pattern, scrutinee_ty)?
                ()
            ()
            Result::Ok(())
        Pattern::Range { start: start, end: end, span: span } =>
            match start:
                Some(start) =>
                    let start_ty = infer_expr_type(env, start, none)?
                    ensure_type_compatible(env, scrutinee_ty, &start_ty, (*span), "range pattern")?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match end:
                Some(end) =>
                    let end_ty = infer_expr_type(env, end, none)?
                    ensure_type_compatible(env, scrutinee_ty, &end_ty, (*span), "range pattern")?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            Result::Ok(())

fn bind_pattern_types(env: &mut TypeEnv, pattern: &Pattern, ty: &ResolvedType) -> Result<(), KainError>:
    match pattern:
        Pattern::Wildcard(_) => Result::Ok(())
        Pattern::Literal(_) => Result::Ok(())
        Pattern::Binding { name: name } =>
            env.define(name.clone(), ty.clone())
            ()
            Result::Ok(())
        Pattern::Tuple(patterns, _) =>
            match pattern_match_subject_type(ty):
                ResolvedType::Tuple(items) =>
                    for selfhost_for_item in patterns.iter().zip(items.iter()):
                        let (pattern, item_ty) = selfhost_for_item
                        let bound_ty = borrowed_pattern_binding_type(ty, item_ty)
                        bind_pattern_types(env, pattern, &bound_ty)?
                        ()
                    ()
                    ()
                ResolvedType::Unknown =>
                    for pattern in patterns:
                        bind_pattern_types(env, pattern, &ResolvedType__Unknown)?
                        ()
                    ()
                    ()
                _ => ()
            Result::Ok(())
        Pattern::Struct { fields: fields } =>
            match pattern_match_subject_type(ty):
                ResolvedType::Struct(_, known_fields) =>
                    for selfhost_for_item in fields:
                        let (field_name, pattern) = selfhost_for_item
                        match known_fields.get(field_name):
                            Some(field_ty) =>
                                let bound_ty = borrowed_pattern_binding_type(ty, field_ty)
                                bind_pattern_types(env, pattern, &bound_ty)?
                                ()
                            _ => ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            Result::Ok(())
        Pattern::Variant { enum_name: enum_name, variant: variant, fields: fields } =>
            let match_ty = pattern_match_subject_type(ty)
            let enum_name = enum_name.or_else(fn(): none)
            let field_types = match enum_name:
                Some(enum_name) => env.lookup_enum_variant_fields(enum_name, variant).cloned()
                _ => builtin_variant_field_types(match_ty, variant)
            match field_types:
                Some(field_types) =>
                    match fields:
                        VariantPatternFields::Tuple(patterns) =>
                            for selfhost_for_item in patterns.iter().zip(field_types.iter()):
                                let (pattern, field_ty) = selfhost_for_item
                                let bound_ty = borrowed_pattern_binding_type(ty, field_ty)
                                bind_pattern_types(env, pattern, &bound_ty)?
                                ()
                            ()
                            ()
                        VariantPatternFields::Struct(patterns) =>
                            match enum_name:
                                Some(enum_name) =>
                                    for selfhost_for_item in patterns:
                                        let (field_name, pattern) = selfhost_for_item
                                        match env.lookup_enum_variant_named_field(enum_name, variant, field_name):
                                            Some(field_ty) =>
                                                let bound_ty = borrowed_pattern_binding_type(ty, field_ty)
                                                bind_pattern_types(env, pattern, &bound_ty)?
                                                ()
                                            _ => ()
                                    ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            ()
                        VariantPatternFields::Unit => ()
                    ()
                _ =>
                    if (none):
                        match fields:
                            VariantPatternFields::Tuple(patterns) =>
                                for pattern in patterns:
                                    bind_pattern_types(env, pattern, &ResolvedType__Unknown)?
                                    ()
                                ()
                                ()
                            VariantPatternFields::Struct(patterns) =>
                                for selfhost_for_item in patterns:
                                    let (_, pattern) = selfhost_for_item
                                    bind_pattern_types(env, pattern, &ResolvedType__Unknown)?
                                    ()
                                ()
                                ()
                            VariantPatternFields::Unit => ()
                        ()
            Result::Ok(())
        Pattern::Slice { patterns: patterns, rest: rest } =>
            let item_ty = match pattern_match_subject_type(ty):
                ResolvedType::Array(inner, _) => inner.clone()
                ResolvedType::Slice(inner) => inner.clone()
                _ => ResolvedType__Unknown
            for pattern in patterns:
                let bound_ty = borrowed_pattern_binding_type(ty, &item_ty)
                bind_pattern_types(env, pattern, &bound_ty)?
                ()
            ()
            match rest:
                Some(rest_name) =>
                    let rest_ty = borrowed_pattern_binding_type(ty, &ResolvedType::Slice(Box__new_(item_ty)))
                    env.define(rest_name.clone(), rest_ty)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            Result::Ok(())
        Pattern::Or(patterns, _) =>
            for pattern in patterns:
                bind_pattern_types(env, pattern, ty)?
                ()
            ()
            Result::Ok(())
        Pattern::Range {  } => Result::Ok(())

fn check_jsx_semantics(env: &mut TypeEnv, node: &JSXNode, ctx: Option<&SemanticContext>) -> Result<(), KainError>:
    match node:
        JSXNode::Element { attributes: attributes, children: children } =>
            for attribute in attributes:
                match &attribute.value:
                    JSXAttrValue::Expr(expr) =>
                        let _ = infer_expr_type(env, expr, ctx)?
                    _ => ()
            ()
            for child in children:
                check_jsx_semantics(env, child, ctx)?
                ()
            ()
            ()
        JSXNode::ComponentCall { props: attributes, children: children } =>
            for attribute in attributes:
                match &attribute.value:
                    JSXAttrValue::Expr(expr) =>
                        let _ = infer_expr_type(env, expr, ctx)?
                    _ => ()
            ()
            for child in children:
                check_jsx_semantics(env, child, ctx)?
                ()
            ()
            ()
        JSXNode::Expression(expr) =>
            let _ = infer_expr_type(env, expr, ctx)?
            ()
        JSXNode::For { binding: binding, iter: iter, body: body } =>
            let iter_ty = infer_expr_type(env, iter, ctx)?
            let item_ty = match iter_ty:
                ResolvedType::Array(inner, _) => (*inner)
                ResolvedType::Slice(inner) => (*inner)
                ResolvedType::String => ResolvedType__String
                _ => ResolvedType__Unknown
            env.push_scope()
            ()
            env.define(binding.clone(), item_ty)
            ()
            check_jsx_semantics(env, body, ctx)?
            ()
            env.pop_scope()
            ()
            ()
            ()
            ()
        JSXNode::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
            let cond_ty = infer_expr_type(env, condition, ctx)?
            ensure_type_compatible(env, &ResolvedType__Bool, &cond_ty, condition.span(), "jsx if condition")?
            ()
            check_jsx_semantics(env, then_branch, ctx)?
            ()
            match else_branch:
                Some(else_branch) =>
                    check_jsx_semantics(env, else_branch, ctx)?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        JSXNode::Fragment(children, _) =>
            for child in children:
                check_jsx_semantics(env, child, ctx)?
                ()
            ()
            ()
        JSXNode::Text(_, _) => ()
    Result::Ok(())

fn infer_binary_type(env: &TypeEnv, op: &BinaryOp, left: &ResolvedType, right: &ResolvedType, span: Span) -> Result<ResolvedType, KainError>:
    use BinaryOp::*

    match op:
        Add =>
            if (none && none):
                return Result::Ok(ResolvedType__String)
            if (is_numeric_like(left) && is_numeric_like(right)):
                return Result::Ok(promote_numeric_type(left, right))
            if ((none && none) && types_compatible(left, right)):
                return Result::Ok(left.clone())
            if (none || none):
                return Result::Ok(ResolvedType__Unknown)
            Result::Err(env.type_error(f"Binary operator expects compatible numeric operands, found {describe_type(left)} and {describe_type(right)}", span))
        Sub =>
            if (none && none):
                return Result::Ok(ResolvedType__String)
            if (is_numeric_like(left) && is_numeric_like(right)):
                return Result::Ok(promote_numeric_type(left, right))
            if ((none && none) && types_compatible(left, right)):
                return Result::Ok(left.clone())
            if (none || none):
                return Result::Ok(ResolvedType__Unknown)
            Result::Err(env.type_error(f"Binary operator expects compatible numeric operands, found {describe_type(left)} and {describe_type(right)}", span))
        Mul =>
            if (none && none):
                return Result::Ok(ResolvedType__String)
            if (is_numeric_like(left) && is_numeric_like(right)):
                return Result::Ok(promote_numeric_type(left, right))
            if ((none && none) && types_compatible(left, right)):
                return Result::Ok(left.clone())
            if (none || none):
                return Result::Ok(ResolvedType__Unknown)
            Result::Err(env.type_error(f"Binary operator expects compatible numeric operands, found {describe_type(left)} and {describe_type(right)}", span))
        Div =>
            if (none && none):
                return Result::Ok(ResolvedType__String)
            if (is_numeric_like(left) && is_numeric_like(right)):
                return Result::Ok(promote_numeric_type(left, right))
            if ((none && none) && types_compatible(left, right)):
                return Result::Ok(left.clone())
            if (none || none):
                return Result::Ok(ResolvedType__Unknown)
            Result::Err(env.type_error(f"Binary operator expects compatible numeric operands, found {describe_type(left)} and {describe_type(right)}", span))
        Mod =>
            if (none && none):
                return Result::Ok(ResolvedType__String)
            if (is_numeric_like(left) && is_numeric_like(right)):
                return Result::Ok(promote_numeric_type(left, right))
            if ((none && none) && types_compatible(left, right)):
                return Result::Ok(left.clone())
            if (none || none):
                return Result::Ok(ResolvedType__Unknown)
            Result::Err(env.type_error(f"Binary operator expects compatible numeric operands, found {describe_type(left)} and {describe_type(right)}", span))
        Pow =>
            if (none && none):
                return Result::Ok(ResolvedType__String)
            if (is_numeric_like(left) && is_numeric_like(right)):
                return Result::Ok(promote_numeric_type(left, right))
            if ((none && none) && types_compatible(left, right)):
                return Result::Ok(left.clone())
            if (none || none):
                return Result::Ok(ResolvedType__Unknown)
            Result::Err(env.type_error(f"Binary operator expects compatible numeric operands, found {describe_type(left)} and {describe_type(right)}", span))
        Eq => if (((((is_numeric_like(left) && is_numeric_like(right))) || types_compatible(left, right)) || none) || none): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"Comparison operands do not agree: {describe_type(left)} vs {describe_type(right)}", span))
        Ne => if (((((is_numeric_like(left) && is_numeric_like(right))) || types_compatible(left, right)) || none) || none): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"Comparison operands do not agree: {describe_type(left)} vs {describe_type(right)}", span))
        Lt => if (((((is_numeric_like(left) && is_numeric_like(right))) || types_compatible(left, right)) || none) || none): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"Comparison operands do not agree: {describe_type(left)} vs {describe_type(right)}", span))
        Gt => if (((((is_numeric_like(left) && is_numeric_like(right))) || types_compatible(left, right)) || none) || none): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"Comparison operands do not agree: {describe_type(left)} vs {describe_type(right)}", span))
        Le => if (((((is_numeric_like(left) && is_numeric_like(right))) || types_compatible(left, right)) || none) || none): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"Comparison operands do not agree: {describe_type(left)} vs {describe_type(right)}", span))
        Ge => if (((((is_numeric_like(left) && is_numeric_like(right))) || types_compatible(left, right)) || none) || none): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"Comparison operands do not agree: {describe_type(left)} vs {describe_type(right)}", span))
        And => if (((none || none)) && ((none || none))): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"Logical operator expects Bool operands, found {describe_type(left)} and {describe_type(right)}", span))
        Or => if (((none || none)) && ((none || none))): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error(f"Logical operator expects Bool operands, found {describe_type(left)} and {describe_type(right)}", span))
        BitAnd =>
            if (is_integer_like(left) && is_integer_like(right)):
                Result::Ok(promote_numeric_type(left, right))
            elif (none || none):
                Result::Ok(ResolvedType__Unknown)
            else:
                Result::Err(env.type_error(f"Bitwise operator expects integer operands, found {describe_type(left)} and {describe_type(right)}", span))
        BitOr =>
            if (is_integer_like(left) && is_integer_like(right)):
                Result::Ok(promote_numeric_type(left, right))
            elif (none || none):
                Result::Ok(ResolvedType__Unknown)
            else:
                Result::Err(env.type_error(f"Bitwise operator expects integer operands, found {describe_type(left)} and {describe_type(right)}", span))
        BitXor =>
            if (is_integer_like(left) && is_integer_like(right)):
                Result::Ok(promote_numeric_type(left, right))
            elif (none || none):
                Result::Ok(ResolvedType__Unknown)
            else:
                Result::Err(env.type_error(f"Bitwise operator expects integer operands, found {describe_type(left)} and {describe_type(right)}", span))
        Shl =>
            if (is_integer_like(left) && is_integer_like(right)):
                Result::Ok(promote_numeric_type(left, right))
            elif (none || none):
                Result::Ok(ResolvedType__Unknown)
            else:
                Result::Err(env.type_error(f"Bitwise operator expects integer operands, found {describe_type(left)} and {describe_type(right)}", span))
        Shr =>
            if (is_integer_like(left) && is_integer_like(right)):
                Result::Ok(promote_numeric_type(left, right))
            elif (none || none):
                Result::Ok(ResolvedType__Unknown)
            else:
                Result::Err(env.type_error(f"Bitwise operator expects integer operands, found {describe_type(left)} and {describe_type(right)}", span))
        Assign => Result::Ok(ResolvedType__Unit)
        AddAssign => Result::Ok(ResolvedType__Unit)
        SubAssign => Result::Ok(ResolvedType__Unit)
        MulAssign => Result::Ok(ResolvedType__Unit)
        DivAssign => Result::Ok(ResolvedType__Unit)
        Range => Result::Ok(ResolvedType__Unknown)
        RangeInclusive => Result::Ok(ResolvedType__Unknown)

fn ensure_type_compatible(env: &TypeEnv, expected: &ResolvedType, actual: &ResolvedType, span: Span, context: String) -> Result<(), KainError>:
    if types_compatible(expected, actual):
        Result::Ok(())
    else:
        Result::Err(env.type_error(f"{context} expected {describe_type(expected)}, found {describe_type(actual)}", span))

fn types_compatible(expected: &ResolvedType, actual: &ResolvedType) -> Bool:
    match (expected, actual):
        (ResolvedType::Unknown, _) => true
        (_, ResolvedType::Unknown) => true
        (ResolvedType::Never, _) => true
        (_, ResolvedType::Never) => true
        (ResolvedType::Generic(_), _) => true
        (_, ResolvedType::Generic(_)) => true
        (ResolvedType::Unit, ResolvedType::Unit) => true
        (ResolvedType::Bool, ResolvedType::Bool) => true
        (ResolvedType::String, ResolvedType::String) => true
        (ResolvedType::Char, ResolvedType::Char) => true
        (ResolvedType::String, ResolvedType::Ref { mutable_: false, inner: inner }) => types_compatible(expected, peel_shared_refs(inner))
        (ResolvedType::Int(_), ResolvedType::Int(_)) => true
        (ResolvedType::Float(_), ResolvedType::Float(_)) => true
        (ResolvedType::Int(_), ResolvedType::Float(_)) => true
        (ResolvedType::Float(_), ResolvedType::Int(_)) => true
        (ResolvedType::Array(left, left_len), ResolvedType::Array(right, right_len)) => (((((left_len == right_len) || ((*left_len) == 0)) || ((*right_len) == 0))) && types_compatible(left, right))
        (ResolvedType::Slice(left), ResolvedType::Slice(right)) => types_compatible(left, right)
        (ResolvedType::Slice(left), ResolvedType::Array(right, _)) => types_compatible(left, right)
        (ResolvedType::Array(left, _), ResolvedType::Slice(right)) => types_compatible(left, right)
        (ResolvedType::Tuple(left), ResolvedType::Tuple(right)) => ((left.len() == right.len()) && left.iter().zip(right.iter()).all(fn(__kain_closure_arg7): types_compatible(__kain_closure_arg7.__kain_tuple_0, __kain_closure_arg7.__kain_tuple_1)))
        (ResolvedType::Option(left), ResolvedType::Option(right)) => types_compatible(left, right)
        (ResolvedType::Option(left), ResolvedType::Ref { mutable_: false, inner: inner }) =>
            match inner:
                ResolvedType::Option(right) => types_compatible(left, &shared_ref_type(right.clone()))
                _ => false
        (ResolvedType::Ref { mutable_: false, inner: inner }, ResolvedType::Option(right)) =>
            match inner:
                ResolvedType::Option(left) => types_compatible(&shared_ref_type(left.clone()), right)
                _ => false
        (ResolvedType::Result(left_ok, left_err), ResolvedType::Result(right_ok, right_err)) => (types_compatible(left_ok, right_ok) && types_compatible(left_err, right_err))
        (ResolvedType::Future(left), ResolvedType::Future(right)) => types_compatible(left, right)
        (ResolvedType::Ref { mutable_: expected_mutable, inner: expected_inner }, ResolvedType::Ref { mutable_: actual_mutable, inner: actual_inner }) => ((((!expected_mutable) || (*actual_mutable))) && if (*expected_mutable): types_compatible(expected_inner, actual_inner) else: types_compatible(expected_inner, peel_shared_refs(actual_inner)))
        (ResolvedType::Ptr { mutable_: expected_mutable, inner: expected_inner }, ResolvedType::Ptr { mutable_: actual_mutable, inner: actual_inner }) => ((((!expected_mutable) || (*actual_mutable))) && types_compatible(expected_inner, actual_inner))
        (ResolvedType::Function { params: left_params, ret: left_ret }, ResolvedType::Function { params: right_params, ret: right_ret }) => (((left_params.len() == right_params.len()) && left_params.iter().zip(right_params.iter()).all(fn(__kain_closure_arg8): types_compatible(__kain_closure_arg8.__kain_tuple_0, __kain_closure_arg8.__kain_tuple_1))) && types_compatible(left_ret, right_ret))
        (ResolvedType::Struct(left, _), ResolvedType::Struct(right, _)) => (left == right)
        (ResolvedType::Enum(left, _), ResolvedType::Enum(right, _)) => (left == right)
        _ => false

fn unify_types(left: &ResolvedType, right: &ResolvedType) -> Option<ResolvedType>:
    match (left, right):
        (ResolvedType::Unknown, other) => Option::Some(other.clone())
        (other, ResolvedType::Unknown) => Option::Some(other.clone())
        (ResolvedType::Never, other) => Option::Some(other.clone())
        (other, ResolvedType::Never) => Option::Some(other.clone())
        (ResolvedType::Int(_), ResolvedType::Int(_)) => Option::Some(promote_numeric_type(left, right))
        (ResolvedType::Float(_), ResolvedType::Float(_)) => Option::Some(promote_numeric_type(left, right))
        (ResolvedType::Int(_), ResolvedType::Float(_)) => Option::Some(promote_numeric_type(left, right))
        (ResolvedType::Float(_), ResolvedType::Int(_)) => Option::Some(promote_numeric_type(left, right))
        (ResolvedType::Generic(_), other) => Option::Some(other.clone())
        (other, ResolvedType::Generic(_)) => Option::Some(other.clone())
        _ if types_compatible(left, right) => Option::Some(left.clone())
        _ => none

fn promote_numeric_type(left: &ResolvedType, right: &ResolvedType) -> ResolvedType:
    if (none || none):
        ResolvedType::Float(FloatSize__F64)
    else:
        ResolvedType::Int(IntSize__I64)

fn is_numeric_like(ty: &ResolvedType) -> Bool:
    match ty:
        ResolvedType::Int(_) => true
        ResolvedType::Float(_) => true
        ResolvedType::Unknown => true
        _ => false

fn is_integer_like(ty: &ResolvedType) -> Bool:
    match ty:
        ResolvedType::Int(_) => true
        ResolvedType::Unknown => true
        _ => false

fn describe_type(ty: &ResolvedType) -> String:
    match ty:
        ResolvedType::Unit => ("Unit").to_string()
        ResolvedType::Bool => ("Bool").to_string()
        ResolvedType::Int(_) => ("Int").to_string()
        ResolvedType::Float(_) => ("Float").to_string()
        ResolvedType::String => ("String").to_string()
        ResolvedType::Char => ("Char").to_string()
        ResolvedType::Array(inner, _) => f"Array<{describe_type(inner)}>"
        ResolvedType::Slice(inner) => f"Slice<{describe_type(inner)}>"
        ResolvedType::Tuple(items) => "({items.iter().map(describe_type).collect().join(\", \")})"
        ResolvedType::Option(inner) => f"Option<{describe_type(inner)}>"
        ResolvedType::Result(ok, err) => f"Result<{describe_type(ok)}, {describe_type(err)}>"
        ResolvedType::Future(inner) => f"Future<{describe_type(inner)}>"
        ResolvedType::Ref { mutable_: mutable_, inner: inner } => if (*mutable_): f"&mut {describe_type(inner)}" else: f"&{describe_type(inner)}"
        ResolvedType::Ptr { mutable_: mutable_, inner: inner } => if (*mutable_): f"ptr_mut<{describe_type(inner)}>" else: f"ptr<{describe_type(inner)}>"
        ResolvedType::Function { params: params, ret: ret } => "fn({params.iter().map(describe_type).collect().join(\", \")}) -> {describe_type(ret)}"
        ResolvedType::Struct(name, _) => name.clone()
        ResolvedType::Enum(name, _) => name.clone()
        ResolvedType::Generic(name) => name.clone()
        ResolvedType::Never => ("!").to_string()
        ResolvedType::Unknown => ("Unknown").to_string()

fn resolved_type_name(ty: &ResolvedType) -> Option<String>:
    match ty:
        ResolvedType::Struct(name, _) => Option::Some(name.as_str())
        ResolvedType::Enum(name, _) => Option::Some(name.as_str())
        _ => none

fn tuple_field_type(env: &TypeEnv, items: &[ResolvedType], field: String, span: Span) -> Result<ResolvedType, KainError>:
    let index = match field:
        "x" => 0
        "r" => 0
        "y" => 1
        "g" => 1
        "z" => 2
        "b" => 2
        "w" => 3
        "a" => 3
        _ =>
            match field.strip_prefix("__kain_tuple_"):
                Some(index) => index.parse().map_err(fn(_): env.type_error(f"Unknown tuple/vector field '{field}'", span))?
                None => return Result::Err(env.type_error(f"Unknown tuple/vector field '{field}'", span))
    items.get(index).cloned().ok_or_else(fn(): env.type_error(f"Field '{field}' is out of bounds for this tuple", span))

fn field_access_type(env: &TypeEnv, object_ty: &ResolvedType, field: String, span: Span) -> Result<ResolvedType, KainError>:
    match object_ty:
        ResolvedType::Struct(name, fields) =>
            match fields.get(field):
                Some(field_ty) => return Result::Ok(field_ty.clone())
                _ =>
                    ()
                    ()
            match env.lookup_type(name):
                Some(ResolvedType::Struct(_, refreshed_fields)) =>
                    match refreshed_fields.get(field):
                        Some(field_ty) => return Result::Ok(field_ty.clone())
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            Result::Err(env.type_error(f"Unknown field '{field}'", span))
        ResolvedType::Tuple(items) => tuple_field_type(env, items, field, span)
        ResolvedType::Ref { inner: inner } => field_access_type(env, inner, field, span)
        ResolvedType::Ptr { inner: inner } => field_access_type(env, inner, field, span)
        ResolvedType::Unknown => Result::Ok(ResolvedType__Unknown)
        other => Result::Err(env.type_error(f"Field access requires a struct value, found {describe_type(other)}", span))

fn builtin_variant_field_types(ty: &ResolvedType, variant: String) -> Option<Array<ResolvedType>>:
    match (ty, variant):
        (ResolvedType::Option(_), "None") => Option::Some(Vec__new_())
        (ResolvedType::Option(inner), "Some") => Option::Some([inner.clone()])
        (ResolvedType::Result(ok, _), "Ok") => Option::Some([ok.clone()])
        (ResolvedType::Result(_, err), "Err") => Option::Some([err.clone()])
        _ => none

fn builtin_variant_expr_type(env: &mut TypeEnv, ctx: Option<&SemanticContext>, enum_name: String, variant: String, fields: &EnumVariantFields, span: Span) -> Result<Option<ResolvedType>, KainError>:
    match (enum_name, variant, fields):
        ("Option", "None", EnumVariantFields::Unit) => Result::Ok(Option::Some(ResolvedType::Option(Box__new_(ResolvedType__Unknown))))
        ("Option", "Some", EnumVariantFields::Tuple(values)) if (values.len() == 1) => Result::Ok(Option::Some(ResolvedType::Option(Box__new_(infer_expr_type(env, &values[0], ctx)?))))
        ("Result", "Ok", EnumVariantFields::Tuple(values)) if (values.len() == 1) => Result::Ok(Option::Some(ResolvedType::Result(Box__new_(infer_expr_type(env, &values[0], ctx)?), Box__new_(ResolvedType__Unknown))))
        ("Result", "Err", EnumVariantFields::Tuple(values)) if (values.len() == 1) => Result::Ok(Option::Some(ResolvedType::Result(Box__new_(ResolvedType__Unknown), Box__new_(infer_expr_type(env, &values[0], ctx)?))))
        ("Option", "None", _) => Result::Err(env.type_error(("Variant 'Option::None' does not accept fields").to_string(), span))
        ("Option", "Some", _) => Result::Err(env.type_error(("Variant 'Option::Some' expects exactly one tuple field").to_string(), span))
        ("Result", "Ok", _) => Result::Err(env.type_error(("Variant 'Result::Ok' expects exactly one tuple field").to_string(), span))
        ("Result", "Err", _) => Result::Err(env.type_error(("Variant 'Result::Err' expects exactly one tuple field").to_string(), span))
        _ => Result::Ok(none)

