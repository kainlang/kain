@derive(Debug, Clone)
pub struct TypedTrait:
    ast: Trait

pub enum ResolvedType:
    Unit
    Bool
    Int(IntSize)
    Float(FloatSize)
    String
    Char
    Array(Box<ResolvedType>, usize)
    Slice(Box<ResolvedType>)
    Tuple(Array<ResolvedType>)
    Option(Box<ResolvedType>)
    Result(Box<ResolvedType>, Box<ResolvedType>)
    Future(Box<ResolvedType>)
    Ref { mutable_: Bool, inner: Box<ResolvedType> }
    Ptr { mutable_: Bool, inner: Box<ResolvedType> }
    Function { params: Array<ResolvedType>, ret: Box<ResolvedType>, effects: EffectSet }
    Struct(String, Map<String, ResolvedType>)
    Enum(String, Array<(String, ResolvedType)>)
    Generic(String)
    Never
    Unknown

enum SelfhostConstructorKind:
    Array
    String
    Map
    Set

struct SelfhostConstructorSpec:
    name: String
    kind: SelfhostConstructorKind

const SELFHOST_CONSTRUCTOR_SPECS: Array<SelfhostConstructorSpec> = [SelfhostConstructorSpec { name: "Vec__new_", kind: SelfhostConstructorKind__Array }, SelfhostConstructorSpec { name: "String__new_", kind: SelfhostConstructorKind__String }, SelfhostConstructorSpec { name: "HashMap__new_", kind: SelfhostConstructorKind__Map }, SelfhostConstructorSpec { name: "BTreeMap__new_", kind: SelfhostConstructorKind__Map }, SelfhostConstructorSpec { name: "std__collections__HashMap__new_", kind: SelfhostConstructorKind__Map }, SelfhostConstructorSpec { name: "HashSet__new_", kind: SelfhostConstructorKind__Set }, SelfhostConstructorSpec { name: "BTreeSet__new_", kind: SelfhostConstructorKind__Set }, SelfhostConstructorSpec { name: "std__collections__HashSet__new_", kind: SelfhostConstructorKind__Set }]

pub enum IntSize:
    I8
    I16
    I32
    I64
    I128
    Isize
    U8
    U16
    U32
    U64
    U128
    Usize

pub enum FloatSize:
    F32
    F64

@derive(Clone)
struct SemanticContext:
    function_name: String
    return_type: ResolvedType
    effects: EffectSet

@doc(doc = " Type environment for checking")
pub struct TypeEnv<a>:
    scopes: Array<Map<String, ResolvedType>>
    types: Map<String, ResolvedType>
    globals: Map<String, ResolvedType>
    methods: Map<String, Map<String, ResolvedType>>
    enum_variants: Map<String, Map<String, EnumVariantTypeInfo>>
    span_mapper: &a SpanMapper
    filename: String

impl<a> TypeEnv<a>:
    pub fn new_(span_mapper: &a SpanMapper, filename: String) -> TypeEnv<a>:
        let mut env = TypeEnv { scopes: [HashMap__new_()], types: HashMap__new_(), globals: HashMap__new_(), methods: HashMap__new_(), enum_variants: HashMap__new_(), span_mapper: span_mapper, filename: filename }
        env.types.insert(("Int").into(), ResolvedType::Int(IntSize__I64))
        ()
        env.types.insert(("UInt").into(), ResolvedType::Int(IntSize__U64))
        ()
        env.types.insert(("Float").into(), ResolvedType::Float(FloatSize__F64))
        ()
        env.types.insert(("Void").into(), ResolvedType__Unit)
        ()
        env.types.insert(("Bool").into(), ResolvedType__Bool)
        ()
        env.types.insert(("Char").into(), ResolvedType__Char)
        ()
        env.types.insert(("String").into(), ResolvedType__String)
        ()
        env.types.insert(("Map").into(), selfhost_map_type())
        ()
        env.types.insert(("Set").into(), selfhost_set_type())
        ()
        env.types.insert(("Vec2").into(), ResolvedType::Tuple([ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32)]))
        ()
        env.types.insert(("Vec3").into(), ResolvedType::Tuple([ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32)]))
        ()
        env.types.insert(("Vec4").into(), ResolvedType::Tuple([ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32)]))
        ()
        env.define_global(("vec2").into(), ResolvedType::Function { params: [ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32)], ret: Box__new_(env.types.get("Vec2").cloned().unwrap_or(ResolvedType__Unknown)), effects: EffectSet__new_() })
        ()
        env.define_global(("vec3").into(), ResolvedType::Function { params: [ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32)], ret: Box__new_(env.types.get("Vec3").cloned().unwrap_or(ResolvedType__Unknown)), effects: EffectSet__new_() })
        ()
        env.define_global(("vec4").into(), ResolvedType::Function { params: [ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32), ResolvedType::Float(FloatSize__F32)], ret: Box__new_(env.types.get("Vec4").cloned().unwrap_or(ResolvedType__Unknown)), effects: EffectSet__new_() })
        ()
        env.define_global(("dispatch_thread_id").into(), ResolvedType::Struct(("DispatchThreadId").into(), HashMap__from([(("x").into(), ResolvedType::Int(IntSize__I64)), (("y").into(), ResolvedType::Int(IntSize__I64)), (("z").into(), ResolvedType::Int(IntSize__I64))])))
        ()
        register_builtin_global_functions(&mut env)
        ()
        register_selfhost_constructor_globals(&mut env)
        ()
        register_selfhost_collection_methods(&mut env)
        ()
        register_selfhost_host_bridge(&mut env)
        ()
        env

    pub fn push_scope(_self: &mut TypeEnv<a>):
        (*_self).scopes.push(HashMap__new_())
        ()

    pub fn pop_scope(_self: &mut TypeEnv<a>):
        (*_self).scopes.pop()
        ()

    pub fn define(_self: &mut TypeEnv<a>, name: String, ty: ResolvedType):
        match (*_self).scopes.last_mut():
            Some(scope) =>
                scope.insert(name, ty)
                ()
            _ => ()

    pub fn define_global(_self: &mut TypeEnv<a>, name: String, ty: ResolvedType):
        (*_self).globals.insert(name, ty)
        ()

    pub fn define_method(_self: &mut TypeEnv<a>, type_name: String, method_name: String, ty: ResolvedType):
        (*_self).methods.entry(type_name).or_default().insert(method_name, ty)
        ()

    pub fn lookup(_self: &TypeEnv<a>, name: String) -> Option<&ResolvedType>:
        for scope in (*_self).scopes.iter().rev():
            match scope.get(name):
                Some(ty) => return Option::Some(ty)
                _ => ()
        ()
        (*_self).globals.get(name).or_else(fn(): (*_self).types.get(name))

    pub fn lookup_type(_self: &TypeEnv<a>, name: String) -> Option<&ResolvedType>:
        (*_self).types.get(name)

    pub fn lookup_method(_self: &TypeEnv<a>, type_name: String, method_name: String) -> Option<&ResolvedType>:
        (*_self).methods.get(type_name).and_then(fn(methods): methods.get(method_name))

    pub fn lookup_enum_variant_fields(_self: &TypeEnv<a>, enum_name: String, variant_name: String) -> Option<&Array<ResolvedType>>:
        (*_self).enum_variants.get(enum_name).and_then(fn(variants): variants.get(variant_name)).map(fn(info): &info.payload_types)

    pub fn lookup_enum_variant_named_field(_self: &TypeEnv<a>, enum_name: String, variant_name: String, field_name: String) -> Option<&ResolvedType>:
        (*_self).enum_variants.get(enum_name).and_then(fn(variants): variants.get(variant_name)).and_then(fn(info): info.named_fields).and_then(fn(fields): fields.get(field_name))

    fn type_error(_self: &TypeEnv<a>, message: impl Into<String>, span: Span) -> KainError:
        let loc = (*_self).span_mapper.span_to_location(span, (*_self).filename)
        let formatted_message = f"{loc.file}:{loc.line_}:{loc.col}: {message.into()}"
        KainError__type_error(formatted_message, span)


fn selfhost_map_type() -> ResolvedType:
    ResolvedType::Struct(("Map").to_string(), HashMap__new_())

fn selfhost_set_type() -> ResolvedType:
    ResolvedType::Struct(("Set").to_string(), HashMap__new_())

fn selfhost_bootstrap_lexer_result_type() -> ResolvedType:
    ResolvedType::Result(Box__new_(dynamic_array_type(ResolvedType::Struct(("Token").to_string(), HashMap__new_()))), Box__new_(ResolvedType::Enum(("KainError").to_string(), Vec__new_())))

fn selfhost_kain_error_type() -> ResolvedType:
    ResolvedType::Enum(("KainError").to_string(), Vec__new_())

fn selfhost_host_result_type(ok: ResolvedType) -> ResolvedType:
    ResolvedType::Result(Box__new_(ok), Box__new_(selfhost_kain_error_type()))

fn selfhost_path_buf_type() -> ResolvedType:
    ResolvedType::Struct(("path::PathBuf").to_string(), HashMap__new_())

fn selfhost_path_type() -> ResolvedType:
    ResolvedType::Struct(("path::Path").to_string(), HashMap__new_())

fn selfhost_dir_entry_type() -> ResolvedType:
    ResolvedType::Struct(("DirEntry").to_string(), HashMap__new_())

fn selfhost_duration_type() -> ResolvedType:
    ResolvedType::Struct(("Duration").to_string(), HashMap__new_())

const SELFHOST_PATH_BUF_TYPE_ALIASES: Array<String> = ["path::PathBuf", "PathBuf"]

const SELFHOST_PATH_TYPE_ALIASES: Array<String> = ["path::Path", "Path"]

const SELFHOST_DIR_ENTRY_TYPE_ALIASES: Array<String> = ["DirEntry", "fs::DirEntry"]

const SELFHOST_DURATION_TYPE_ALIASES: Array<String> = ["Duration", "time::Duration"]

fn selfhost_constructor_return_type(kind: SelfhostConstructorKind) -> ResolvedType:
    match kind:
        SelfhostConstructorKind::Array => dynamic_array_type(ResolvedType__Unknown)
        SelfhostConstructorKind::String => ResolvedType__String
        SelfhostConstructorKind::Map => selfhost_map_type()
        SelfhostConstructorKind::Set => selfhost_set_type()

fn selfhost_nullary_function_type(ret: ResolvedType) -> ResolvedType:
    ResolvedType::Function { params: Vec__new_(), ret: Box__new_(ret), effects: EffectSet__new_() }

fn builtin_function_type(params: Array<ResolvedType>, ret: ResolvedType) -> ResolvedType:
    ResolvedType::Function { params: params, ret: Box__new_(ret), effects: EffectSet__new_() }

fn lowered_impl_function_name(type_name: String, method_name: String) -> String:
    f"{type_name}_{method_name}"

fn selfhost_static_impl_function_name(type_name: String, method_name: String) -> String:
    f"{type_name}__{method_name}"

fn selfhost_enum_variant_alias_name(enum_name: String, variant_name: String) -> String:
    f"{enum_name}__{variant_name}"

fn register_builtin_global_functions(env: &mut TypeEnv<_>):
    env.define_global(("print").into(), builtin_function_type([ResolvedType__Unknown], ResolvedType__Unit))
    ()
    env.define_global(("println").into(), builtin_function_type([ResolvedType__Unknown], ResolvedType__Unit))
    ()
    env.define_global(("eprint").into(), builtin_function_type([ResolvedType__Unknown], ResolvedType__Unit))
    ()
    env.define_global(("eprintln").into(), builtin_function_type([ResolvedType__Unknown], ResolvedType__Unit))
    ()
    env.define_global(("dbg").into(), builtin_function_type([ResolvedType__Unknown], ResolvedType__Unknown))
    ()
    env.define_global(("assert").into(), builtin_function_type([ResolvedType__Bool, ResolvedType__String], ResolvedType__Unit))
    ()
    env.define_global(("panic").into(), builtin_function_type([ResolvedType__String], ResolvedType__Never))
    ()
    env.define_global(("ask").into(), builtin_function_type([ResolvedType__Unknown, ResolvedType__String, ResolvedType__Unknown], ResolvedType__Unknown))
    ()
    env.define_global(("read_file").into(), builtin_function_type([ResolvedType__String], ResolvedType__String))
    ()
    env.define_global(("write_file").into(), builtin_function_type([ResolvedType__String, ResolvedType__String], ResolvedType__Unit))
    ()
    env.define_global(("file_exists").into(), builtin_function_type([ResolvedType__String], ResolvedType__Bool))
    ()
    env.define_global(("env").into(), builtin_function_type([ResolvedType__String], ResolvedType__String))
    ()
    env.define_global(("read_dir").into(), builtin_function_type([ResolvedType__String], dynamic_array_type(ResolvedType__String)))
    ()
    env.define_global(("create_dir_all").into(), builtin_function_type([ResolvedType__String], ResolvedType__Unit))
    ()
    env.define_global(("copy_file").into(), builtin_function_type([ResolvedType__String, ResolvedType__String], ResolvedType__Unit))
    ()
    env.define_global(("remove_file").into(), builtin_function_type([ResolvedType__String], ResolvedType__Unit))
    ()
    env.define_global(("path_join").into(), builtin_function_type([ResolvedType__String, ResolvedType__String], ResolvedType__String))
    ()
    env.define_global(("path_parent").into(), builtin_function_type([ResolvedType__String], ResolvedType__String))
    ()
    env.define_global(("path_file_name").into(), builtin_function_type([ResolvedType__String], ResolvedType__String))
    ()
    env.define_global(("path_extension").into(), builtin_function_type([ResolvedType__String], ResolvedType__String))
    ()
    env.define_global(("path_stem").into(), builtin_function_type([ResolvedType__String], ResolvedType__String))
    ()
    env.define_global(("path_is_file").into(), builtin_function_type([ResolvedType__String], ResolvedType__Bool))
    ()
    env.define_global(("path_is_dir").into(), builtin_function_type([ResolvedType__String], ResolvedType__Bool))
    ()
    env.define_global(("len").into(), builtin_function_type([ResolvedType__Unknown], ResolvedType::Int(IntSize__I64)))
    ()
    env.define_global(("push").into(), builtin_function_type([ResolvedType__Unknown, ResolvedType__Unknown], ResolvedType__Unit))
    ()
    env.define_global(("char_at").into(), builtin_function_type([ResolvedType__String, ResolvedType::Int(IntSize__I64)], ResolvedType__String))
    ()
    env.define_global(("ord").into(), builtin_function_type([ResolvedType__String], ResolvedType::Int(IntSize__I64)))
    ()
    env.define_global(("chr").into(), builtin_function_type([ResolvedType::Int(IntSize__I64)], ResolvedType__String))
    ()
    env.define_global(("Box__new_").into(), builtin_function_type([ResolvedType__Unknown], ResolvedType__Unknown))
    ()
    env.define_global(("Some").into(), builtin_function_type([ResolvedType__Unknown], ResolvedType::Option(Box__new_(ResolvedType__Unknown))))
    ()
    env.define_global(("None").into(), selfhost_nullary_function_type(ResolvedType::Option(Box__new_(ResolvedType__Unknown))))
    ()
    env.define_global(("__kain_bootstrap_lex_tokens").into(), builtin_function_type([shared_ref_type(ResolvedType__String)], selfhost_bootstrap_lexer_result_type()))
    ()

fn method_has_receiver_param(method: &Function) -> Bool:
    (*method).params.first().is_some_and(fn(param): none)

fn module_scoped_name(module_path: &[String], item_name: String) -> String:
    let mut parts = module_path.to_vec()
    parts.push(item_name.to_string())
    ()
    parts.join("__")

fn module_scoped_type_name(module_path: &[String], item_name: String) -> String:
    let mut parts = module_path.to_vec()
    parts.push(item_name.to_string())
    ()
    parts.join("::")

fn register_selfhost_constructor_globals(env: &mut TypeEnv<_>):
    for spec in SELFHOST_CONSTRUCTOR_SPECS:
        env.define_global(spec.name.to_string(), selfhost_nullary_function_type(selfhost_constructor_return_type(spec.kind)))
        ()

fn register_selfhost_collection_methods(env: &mut TypeEnv<_>):
    let map_receiver = selfhost_map_type()
    let set_receiver = selfhost_set_type()
    env.define_method(("Map").to_string(), ("get").to_string(), ResolvedType::Function { params: [map_receiver.clone(), ResolvedType__Unknown], ret: Box__new_(ResolvedType::Option(Box__new_(ResolvedType__Unknown))), effects: EffectSet__new_() })
    ()
    env.define_method(("Map").to_string(), ("iter").to_string(), ResolvedType::Function { params: [shared_ref_type(selfhost_map_type())], ret: Box__new_(dynamic_array_type(ResolvedType::Tuple([ResolvedType__String, ResolvedType__Unknown]))), effects: EffectSet__new_() })
    ()
    env.define_method(("Map").to_string(), ("insert").to_string(), ResolvedType::Function { params: [map_receiver.clone(), ResolvedType__Unknown, ResolvedType__Unknown], ret: Box__new_(ResolvedType::Option(Box__new_(ResolvedType__Unknown))), effects: EffectSet__new_() })
    ()
    env.define_method(("Map").to_string(), ("contains_key").to_string(), ResolvedType::Function { params: [map_receiver.clone(), ResolvedType__Unknown], ret: Box__new_(ResolvedType__Bool), effects: EffectSet__new_() })
    ()
    env.define_method(("Map").to_string(), ("entry").to_string(), ResolvedType::Function { params: [map_receiver, ResolvedType__Unknown], ret: Box__new_(ResolvedType__Unknown), effects: EffectSet__new_() })
    ()
    env.define_method(("Map").to_string(), ("len").to_string(), ResolvedType::Function { params: [shared_ref_type(selfhost_map_type())], ret: Box__new_(ResolvedType::Int(IntSize__I64)), effects: EffectSet__new_() })
    ()
    env.define_method(("Map").to_string(), ("is_empty").to_string(), ResolvedType::Function { params: [shared_ref_type(selfhost_map_type())], ret: Box__new_(ResolvedType__Bool), effects: EffectSet__new_() })
    ()
    env.define_method(("Set").to_string(), ("insert").to_string(), ResolvedType::Function { params: [set_receiver.clone(), ResolvedType__Unknown], ret: Box__new_(ResolvedType__Bool), effects: EffectSet__new_() })
    ()
    env.define_method(("Set").to_string(), ("contains").to_string(), ResolvedType::Function { params: [set_receiver.clone(), ResolvedType__Unknown], ret: Box__new_(ResolvedType__Bool), effects: EffectSet__new_() })
    ()
    env.define_method(("Set").to_string(), ("iter").to_string(), ResolvedType::Function { params: [set_receiver], ret: Box__new_(dynamic_array_type(ResolvedType__Unknown)), effects: EffectSet__new_() })
    ()
    env.define_method(("Set").to_string(), ("len").to_string(), ResolvedType::Function { params: [shared_ref_type(selfhost_set_type())], ret: Box__new_(ResolvedType::Int(IntSize__I64)), effects: EffectSet__new_() })
    ()
    env.define_method(("Set").to_string(), ("is_empty").to_string(), ResolvedType::Function { params: [shared_ref_type(selfhost_set_type())], ret: Box__new_(ResolvedType__Bool), effects: EffectSet__new_() })
    ()

fn register_selfhost_host_bridge(env: &mut TypeEnv<_>):
    register_selfhost_host_bridge_types(env)
    ()
    register_selfhost_host_bridge_methods(env)
    ()

fn register_selfhost_host_bridge_types(env: &mut TypeEnv<_>):
    register_host_type_aliases(env, SELFHOST_PATH_BUF_TYPE_ALIASES, selfhost_path_buf_type())
    ()
    register_host_type_aliases(env, SELFHOST_PATH_TYPE_ALIASES, selfhost_path_type())
    ()
    register_host_type_aliases(env, SELFHOST_DIR_ENTRY_TYPE_ALIASES, selfhost_dir_entry_type())
    ()
    register_host_type_aliases(env, SELFHOST_DURATION_TYPE_ALIASES, selfhost_duration_type())
    ()

fn register_host_type_aliases(env: &mut TypeEnv<_>, aliases: &[String], ty: ResolvedType):
    for alias in aliases:
        (*env).types.insert(((*alias)).to_string(), ty.clone())
        ()

fn register_selfhost_host_bridge_methods(env: &mut TypeEnv<_>):
    register_host_path_methods(env, SELFHOST_PATH_BUF_TYPE_ALIASES, selfhost_path_buf_type())
    ()
    register_host_path_methods(env, SELFHOST_PATH_TYPE_ALIASES, selfhost_path_type())
    ()
    for alias in SELFHOST_DIR_ENTRY_TYPE_ALIASES:
        env.define_method(((*alias)).to_string(), ("path").to_string(), ResolvedType::Function { params: [shared_ref_type(selfhost_dir_entry_type())], ret: Box__new_(selfhost_path_buf_type()), effects: EffectSet__new_() })
        ()

fn register_host_path_methods(env: &mut TypeEnv<_>, aliases: &[String], receiver: ResolvedType):
    for alias in aliases:
        env.define_method(((*alias)).to_string(), ("join").to_string(), ResolvedType::Function { params: [shared_ref_type(receiver.clone()), ResolvedType__Unknown], ret: Box__new_(selfhost_path_buf_type()), effects: EffectSet__new_() })
        ()
        env.define_method(((*alias)).to_string(), ("exists").to_string(), ResolvedType::Function { params: [shared_ref_type(receiver.clone())], ret: Box__new_(ResolvedType__Bool), effects: EffectSet__new_() })
        ()
        env.define_method(((*alias)).to_string(), ("is_dir").to_string(), ResolvedType::Function { params: [shared_ref_type(receiver.clone())], ret: Box__new_(ResolvedType__Bool), effects: EffectSet__new_() })
        ()
        env.define_method(((*alias)).to_string(), ("is_file").to_string(), ResolvedType::Function { params: [shared_ref_type(receiver.clone())], ret: Box__new_(ResolvedType__Bool), effects: EffectSet__new_() })
        ()
        env.define_method(((*alias)).to_string(), ("parent").to_string(), ResolvedType::Function { params: [shared_ref_type(receiver.clone())], ret: Box__new_(ResolvedType::Option(Box__new_(selfhost_path_buf_type()))), effects: EffectSet__new_() })
        ()
        env.define_method(((*alias)).to_string(), ("to_path_buf").to_string(), ResolvedType::Function { params: [shared_ref_type(receiver.clone())], ret: Box__new_(selfhost_path_buf_type()), effects: EffectSet__new_() })
        ()
        env.define_method(((*alias)).to_string(), ("to_string_lossy").to_string(), ResolvedType::Function { params: [shared_ref_type(receiver.clone())], ret: Box__new_(ResolvedType__String), effects: EffectSet__new_() })
        ()
        env.define_method(((*alias)).to_string(), ("display").to_string(), ResolvedType::Function { params: [shared_ref_type(receiver.clone())], ret: Box__new_(ResolvedType__String), effects: EffectSet__new_() })
        ()
        env.define_method(((*alias)).to_string(), ("file_name").to_string(), ResolvedType::Function { params: [shared_ref_type(receiver.clone())], ret: Box__new_(ResolvedType::Option(Box__new_(ResolvedType__String))), effects: EffectSet__new_() })
        ()

fn infer_selfhost_host_call_type(env: &mut TypeEnv, ctx: Option<&SemanticContext>, callee_name: String, args: &[CallArg], span: Span) -> Option<Result<ResolvedType, KainError>>:
    match callee_name:
        "std__env__var_" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__env__var_", &[ResolvedType__Unknown], selfhost_host_result_type(ResolvedType__String)))
        "std__env__current_exe" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, callee_name, &[], selfhost_host_result_type(selfhost_path_buf_type())))
        "std__env__current_dir" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, callee_name, &[], selfhost_host_result_type(selfhost_path_buf_type())))
        "std__env__set_current_dir" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__env__set_current_dir", &[ResolvedType__Unknown], selfhost_host_result_type(ResolvedType__Unit)))
        "std__env__temp_dir" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__env__temp_dir", &[], selfhost_path_buf_type()))
        "std__env__set_var" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__env__set_var", &[ResolvedType__Unknown, ResolvedType__Unknown], ResolvedType__Unit))
        "std__env__remove_var" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__env__remove_var", &[ResolvedType__Unknown], ResolvedType__Unit))
        "std__fs__read_dir" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__fs__read_dir", &[ResolvedType__Unknown], selfhost_host_result_type(dynamic_array_type(selfhost_dir_entry_type()))))
        "std__fs__read_to_string" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__fs__read_to_string", &[ResolvedType__Unknown], selfhost_host_result_type(ResolvedType__String)))
        "std__fs__create_dir_all" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, callee_name, &[ResolvedType__Unknown], selfhost_host_result_type(ResolvedType__Unit)))
        "std__fs__remove_dir_all" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, callee_name, &[ResolvedType__Unknown], selfhost_host_result_type(ResolvedType__Unit)))
        "std__fs__write" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__fs__write", &[ResolvedType__Unknown, ResolvedType__Unknown], selfhost_host_result_type(ResolvedType__Unit)))
        "std__iter__empty" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__iter__empty", &[], dynamic_array_type(ResolvedType::Tuple([ResolvedType__String, ResolvedType::Enum(("ResolvedType").to_string(), Vec__new_())]))))
        "std__mem__discriminant" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__mem__discriminant", &[ResolvedType__Unknown], ResolvedType::Int(IntSize__I64)))
        "std__mem__take" => Option::Some(infer_selfhost_mem_take_call(env, ctx, args, span))
        "std__mem__replace" => Option::Some(infer_selfhost_mem_replace_call(env, ctx, args, span))
        "Duration__from_micros" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "Duration__from_micros", &[ResolvedType::Int(IntSize__I64)], selfhost_duration_type()))
        "std__thread__sleep" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__thread__sleep", &[ResolvedType__Unknown], ResolvedType__Unit))
        "std__thread__spawn_" => Option::Some(infer_fixed_builtin_call(env, ctx, args, span, "std__thread__spawn_", &[ResolvedType__Unknown], ResolvedType__Unit))
        _ => none

fn infer_fixed_builtin_call(env: &mut TypeEnv, ctx: Option<&SemanticContext>, args: &[CallArg], span: Span, name: String, params: &[ResolvedType], ret: ResolvedType) -> Result<ResolvedType, KainError>:
    if (args.len() != params.len()):
        return Result::Err(env.type_error(f"{name} expects {params.len()} argument(s), found {args.len()}", span))
    for selfhost_for_item in params.iter().zip(args.iter()):
        let (param_ty, arg) = selfhost_for_item
        let arg_ty = infer_expr_type_with_expected(env, &arg.value, ctx, Option::Some(param_ty))?
        ensure_type_compatible(env, param_ty, &arg_ty, arg.span, name)?
        ()
    ()
    Result::Ok(ret)

fn infer_selfhost_mem_take_call(env: &mut TypeEnv, ctx: Option<&SemanticContext>, args: &[CallArg], span: Span) -> Result<ResolvedType, KainError>:
    if (args.len() != 1):
        return Result::Err(env.type_error(f"std__mem__take expects 1 argument, found {args.len()}", span))
    let source_ty = infer_expr_type(env, &args[0].value, ctx)?
    Result::Ok(none)

fn infer_selfhost_mem_replace_call(env: &mut TypeEnv, ctx: Option<&SemanticContext>, args: &[CallArg], span: Span) -> Result<ResolvedType, KainError>:
    if (args.len() != 2):
        return Result::Err(env.type_error(f"std__mem__replace expects 2 arguments, found {args.len()}", span))
    let target_ty = infer_expr_type(env, &args[0].value, ctx)?
    let replaced_ty = match target_ty:
        ResolvedType::Ref { inner: inner } => (*inner)
        ResolvedType::Ptr { inner: inner } => (*inner)
        other => other
    let replacement_ty = infer_expr_type_with_expected(env, &args[1].value, ctx, Option::Some(&replaced_ty))?
    ensure_type_compatible(env, &replaced_ty, &replacement_ty, args[1].span, "std__mem__replace")?
    ()
    Result::Ok(replaced_ty)

@doc(doc = " Main type checking entry point")
pub fn check(program: &Program, span_mapper: &SpanMapper, filename: String) -> Result<TypedProgram, KainError>:
    check_with_extra_globals(program, span_mapper, filename, std__iter__empty())

pub fn check_with_extra_globals<I>(program: &Program, span_mapper: &SpanMapper, filename: String, extra_globals: I) -> Result<TypedProgram, KainError>:
    let mut env = TypeEnv__new_(span_mapper, filename)
    for selfhost_for_item in extra_globals:
        let (name, ty) = selfhost_for_item
        env.define_global(name, ty)
        ()
    ()
    for item in &(*program).items:
        predeclare_item_types(&mut env, item)
        ()
    ()
    for item in &(*program).items:
        register_item_types(&mut env, item)?
        ()
    ()
    for item in &(*program).items:
        register_item_types(&mut env, item)?
        ()
    ()
    let mut typed_items = Vec__new_()
    for item in &(*program).items:
        check_item_into(&mut env, item, &mut typed_items)?
        ()
    ()
    Result::Ok(TypedProgram { items: typed_items })

fn predeclare_item_types(env: &mut TypeEnv, item: &Item):
    match item:
        Item::Struct(s) =>
            (*env).types.entry(s.name.clone()).or_insert_with(fn(): ResolvedType::Struct(s.name.clone(), HashMap__new_()))
            ()
        Item::Enum(e) =>
            (*env).types.entry(e.name.clone()).or_insert_with(fn(): ResolvedType::Enum(e.name.clone(), Vec__new_()))
            ()
            (*env).enum_variants.entry(e.name.clone()).or_default()
            ()
        Item::World(world) =>
            (*env).types.entry(world.name.clone()).or_insert_with(fn(): ResolvedType::Struct(world.name.clone(), HashMap__new_()))
            ()
        Item::Component(component_) =>
            (*env).types.entry(component_.name.clone()).or_insert_with(fn(): ResolvedType::Struct(component_.name.clone(), HashMap__new_()))
            ()
        Item::Actor(actor_) =>
            (*env).types.entry(actor_.name.clone()).or_insert_with(fn(): ResolvedType::Struct(actor_.name.clone(), HashMap__new_()))
            ()
        Item::Mod(module) =>
            match &module.inline_:
                Some(children) =>
                    let module_path = [module.name.clone()]
                    predeclare_inline_module_type_aliases(env, children, &module_path)
                    ()
                    for child in children:
                        predeclare_item_types(env, child)
                        ()
                _ => ()
        _ => ()

fn register_item_types(env: &mut TypeEnv, item: &Item) -> Result<(), KainError>:
    match item:
        Item::Struct(s) =>
            let mut fields = HashMap__new_()
            for f in &s.fields:
                fields.insert(f.name.clone(), resolve_type_in_env(env, &f.ty)?)
                ()
            ()
            let self_ty = ResolvedType::Struct(s.name.clone(), fields.clone())
            (*env).types.insert(s.name.clone(), self_ty.clone())
            ()
            register_method_signatures(env, &s.name, &self_ty, &s.methods)?
            ()
            ()
            ()
            ()
        Item::Enum(e) =>
            let mut variants = Vec__new_()
            let mut variant_map = HashMap__new_()
            let mut variant_aliases = Vec__new_()
            for v in &e.variants:
                let (payload_types, named_fields) = match &v.fields:
                    VariantFields::Unit => (Vec__new_(), none)
                    VariantFields::Tuple(items) => (items.iter().map(fn(ty): resolve_type_in_env(env, ty)).collect()?, none)
                    VariantFields::Struct(fields) =>
                        let mut payload_types = (fn(__kain_ctor_arg0): Vec__new_())(fields.len())
                        let mut named_fields = (fn(__kain_ctor_arg0): std__collections__HashMap__new_())(fields.len())
                        for field in fields:
                            let field_ty = resolve_type_in_env(env, &field.ty)?
                            payload_types.push(field_ty.clone())
                            ()
                            named_fields.insert(field.name.clone(), field_ty)
                            ()
                        ()
                        (payload_types, Option::Some(named_fields))
                variants.push((v.name.clone(), ResolvedType__Unit))
                ()
                variant_aliases.push((v.name.clone(), payload_types.clone(), none))
                ()
                variant_map.insert(v.name.clone(), EnumVariantTypeInfo { payload_types: payload_types, named_fields: named_fields })
                ()
            ()
            let enum_ty = ResolvedType::Enum(e.name.clone(), variants)
            (*env).types.insert(e.name.clone(), enum_ty.clone())
            ()
            (*env).enum_variants.insert(e.name.clone(), variant_map)
            ()
            for selfhost_for_item in variant_aliases:
                let (variant_name, payload_types, is_unit) = selfhost_for_item
                let alias = selfhost_enum_variant_alias_name(&e.name, &variant_name)
                let alias_ty = if is_unit:
                    enum_ty.clone()
                else:
                    ResolvedType::Function { params: payload_types, ret: Box__new_(enum_ty.clone()), effects: EffectSet__new_() }
                env.define_global(alias, alias_ty)
                ()
            ()
            ()
        Item::Function(f) =>
            env.define_global(f.name.clone(), function_signature(env, f, none)?)
            ()
            ()
            ()
            ()
        Item::Patch(patch) =>
            env.define_global(patch.name.clone(), function_signature(env, &patch_function_view(patch), none)?)
            ()
            ()
            ()
            ()
        Item::Law(law) =>
            env.define_global(law.name.clone(), function_signature(env, &law_function_view(law), none)?)
            ()
            ()
            ()
            ()
        Item::Converge(converge) =>
            env.define_global(converge.name.clone(), function_signature(env, &converge_dispatcher_view(converge), none)?)
            ()
            ()
            ()
            ()
        Item::World(world) =>
            let mut fields = HashMap__new_()
            for state_ in &world.states:
                fields.insert(state_.name.clone(), resolve_type_in_env(env, &state_.ty)?)
                ()
            ()
            let world_ty = ResolvedType::Struct(world.name.clone(), fields)
            (*env).types.insert(world.name.clone(), world_ty.clone())
            ()
            env.define_global(world.name.clone(), world_ty)
            ()
            ()
            ()
            ()
        Item::Orchestrate(orchestrate) =>
            env.define_global(orchestrate.name.clone(), function_signature(env, &orchestrate_function_view(orchestrate), none)?)
            ()
            ()
            ()
            ()
        Item::Const(c) =>
            env.define_global(c.name.clone(), resolve_type_in_env(env, &c.ty)?)
            ()
            ()
            ()
            ()
        Item::TypeAlias(alias) =>
            (*env).types.insert(alias.name.clone(), resolve_type_in_env(env, &alias.target)?)
            ()
            ()
            ()
            ()
        Item::Impl(imp) =>
            let self_ty = resolve_type_in_env(env, &imp.target_type)?
            match resolved_type_name(&self_ty):
                Some(target_name) =>
                    register_method_signatures(env, target_name, &self_ty, &imp.methods)?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        Item::Component(component_) =>
            let component_ty = ResolvedType::Struct(component_.name.clone(), HashMap__new_())
            (*env).types.insert(component_.name.clone(), component_ty.clone())
            ()
            register_method_signatures(env, &component_.name, &component_ty, &component_.methods)?
            ()
            ()
            ()
            ()
        Item::Actor(actor_) =>
            let actor_ty = ResolvedType::Struct(actor_.name.clone(), HashMap__new_())
            (*env).types.insert(actor_.name.clone(), actor_ty.clone())
            ()
            register_method_signatures(env, &actor_.name, &actor_ty, &actor_.methods)?
            ()
            ()
            ()
            ()
        Item::Mod(module) =>
            match &module.inline_:
                Some(children) =>
                    let module_path = [module.name.clone()]
                    register_inline_module_type_aliases(env, children, &module_path)
                    ()
                    register_inline_module_global_aliases(env, children, &module_path)?
                    ()
                    for child in children:
                        register_item_types(env, child)?
                        ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ => ()
    Result::Ok(())

fn register_method_signatures(env: &mut TypeEnv, type_name: String, self_ty: &ResolvedType, methods: &[Function]) -> Result<(), KainError>:
    for method in methods:
        let signature = function_signature(env, method, Option::Some(self_ty))?
        env.define_method(type_name.to_string(), method.name.clone(), signature.clone())
        ()
        if (!method_has_receiver_param(method)):
            env.define_global(lowered_impl_function_name(type_name, &method.name), signature.clone())
            ()
            env.define_global(selfhost_static_impl_function_name(type_name, &method.name), signature)
            ()
    ()
    Result::Ok(())

fn register_inline_module_global_aliases(env: &mut TypeEnv, items: &[Item], module_path: &[String]) -> Result<(), KainError>:
    for item in items:
        match item:
            Item::Function(f) =>
                env.define_global(module_scoped_name(module_path, &f.name), function_signature(env, f, none)?)
                ()
            Item::Const(c) =>
                env.define_global(module_scoped_name(module_path, &c.name), resolve_type_in_env(env, &c.ty)?)
                ()
            Item::Mod(module) =>
                match &module.inline_:
                    Some(children) =>
                        let mut nested_path = module_path.to_vec()
                        nested_path.push(module.name.clone())
                        ()
                        register_inline_module_global_aliases(env, children, &nested_path)?
                        ()
                    _ => ()
            _ => ()
    ()
    Result::Ok(())

fn predeclare_inline_module_type_aliases(env: &mut TypeEnv, items: &[Item], module_path: &[String]):
    for item in items:
        match item:
            Item::Struct(s) =>
                let scoped_name = module_scoped_type_name(module_path, &s.name)
                (*env).types.entry(scoped_name).or_insert_with(fn(): ResolvedType::Struct(s.name.clone(), HashMap__new_()))
                ()
            Item::Enum(e) =>
                let scoped_name = module_scoped_type_name(module_path, &e.name)
                (*env).types.entry(scoped_name.clone()).or_insert_with(fn(): ResolvedType::Enum(e.name.clone(), Vec__new_()))
                ()
                (*env).enum_variants.entry(scoped_name).or_default()
                ()
            Item::World(world) =>
                let scoped_name = module_scoped_type_name(module_path, &world.name)
                (*env).types.entry(scoped_name).or_insert_with(fn(): ResolvedType::Struct(world.name.clone(), HashMap__new_()))
                ()
            Item::Component(component_) =>
                let scoped_name = module_scoped_type_name(module_path, &component_.name)
                (*env).types.entry(scoped_name).or_insert_with(fn(): ResolvedType::Struct(component_.name.clone(), HashMap__new_()))
                ()
            Item::Actor(actor_) =>
                let scoped_name = module_scoped_type_name(module_path, &actor_.name)
                (*env).types.entry(scoped_name).or_insert_with(fn(): ResolvedType::Struct(actor_.name.clone(), HashMap__new_()))
                ()
            Item::Mod(module) =>
                match &module.inline_:
                    Some(children) =>
                        let mut nested_path = module_path.to_vec()
                        nested_path.push(module.name.clone())
                        ()
                        predeclare_inline_module_type_aliases(env, children, &nested_path)
                        ()
                    _ => ()
            _ => ()

fn register_inline_module_type_aliases(env: &mut TypeEnv, items: &[Item], module_path: &[String]):
    for item in items:
        match item:
            Item::Struct(s) =>
                match env.lookup_type(&s.name).cloned():
                    Some(resolved) =>
                        (*env).types.insert(module_scoped_type_name(module_path, &s.name), resolved)
                        ()
                    _ => ()
            Item::Enum(e) =>
                match env.lookup_type(&e.name).cloned():
                    Some(resolved) =>
                        let scoped_name = module_scoped_type_name(module_path, &e.name)
                        (*env).types.insert(scoped_name.clone(), resolved)
                        ()
                        match (*env).enum_variants.get(&e.name).cloned():
                            Some(variants) =>
                                (*env).enum_variants.insert(scoped_name, variants)
                                ()
                            _ => ()
                    _ => ()
            Item::TypeAlias(alias) =>
                match env.lookup_type(&alias.name).cloned():
                    Some(resolved) =>
                        (*env).types.insert(module_scoped_type_name(module_path, &alias.name), resolved)
                        ()
                    _ => ()
            Item::World(world) =>
                match env.lookup_type(&world.name).cloned():
                    Some(resolved) =>
                        (*env).types.insert(module_scoped_type_name(module_path, &world.name), resolved)
                        ()
                    _ => ()
            Item::Component(component_) =>
                match env.lookup_type(&component_.name).cloned():
                    Some(resolved) =>
                        (*env).types.insert(module_scoped_type_name(module_path, &component_.name), resolved)
                        ()
                    _ => ()
            Item::Actor(actor_) =>
                match env.lookup_type(&actor_.name).cloned():
                    Some(resolved) =>
                        (*env).types.insert(module_scoped_type_name(module_path, &actor_.name), resolved)
                        ()
                    _ => ()
            Item::Mod(module) =>
                match &module.inline_:
                    Some(children) =>
                        let mut nested_path = module_path.to_vec()
                        nested_path.push(module.name.clone())
                        ()
                        register_inline_module_type_aliases(env, children, &nested_path)
                        ()
                    _ => ()
            _ => ()

fn inline_module_scope_bindings(env: &mut TypeEnv, items: &[Item]) -> Result<Map<String, ResolvedType>, KainError>:
    let mut bindings = HashMap__new_()
    for item in items:
        match item:
            Item::Function(f) =>
                bindings.insert(f.name.clone(), function_signature(env, f, none)?)
                ()
            Item::Const(c) =>
                bindings.insert(c.name.clone(), resolve_type_in_env(env, &c.ty)?)
                ()
            _ => ()
    ()
    Result::Ok(bindings)

fn define_scope_bindings(env: &mut TypeEnv, bindings: &Map<String, ResolvedType>):
    for selfhost_for_item in bindings:
        let (name, ty) = selfhost_for_item
        env.define(name.clone(), ty.clone())
        ()

fn check_item_into(env: &mut TypeEnv, item: &Item, out_: &mut Array<TypedItem>) -> Result<(), KainError>:
    out_.push(check_item(env, item)?)
    ()
    Result::Ok(())

fn check_item(env: &mut TypeEnv, item: &Item) -> Result<TypedItem, KainError>:
    match item:
        Item::Function(f) => Result::Ok(TypedItem::Function(check_function(env, f)?))
        Item::Patch(patch) => Result::Ok(TypedItem::Patch(check_patch(env, patch)?))
        Item::Law(law) => Result::Ok(TypedItem::Law(check_law(env, law)?))
        Item::Converge(converge) => Result::Ok(TypedItem::Converge(check_converge(env, converge)?))
        Item::World(world) => Result::Ok(TypedItem::World(check_world(env, world)?))
        Item::Orchestrate(orchestrate) => Result::Ok(TypedItem::Orchestrate(check_orchestrate(env, orchestrate)?))
        Item::Struct(s) => Result::Ok(TypedItem::Struct(check_struct(env, s)?))
        Item::Enum(e) => Result::Ok(TypedItem::Enum(check_enum(env, e)?))
        Item::Trait(t) => Result::Ok(TypedItem::Trait(TypedTrait { ast: t.clone() }))
        Item::Component(c) => Result::Ok(TypedItem::Component(check_component(env, c)?))
        Item::Shader(s) => Result::Ok(TypedItem::Shader(check_shader(env, s)?))
        Item::Actor(a) => Result::Ok(TypedItem::Actor(check_actor(env, a)?))
        Item::Comptime(b) => Result::Ok(TypedItem::Comptime(TypedComptime { ast: b.body.clone() }))
        Item::Const(c) => Result::Ok(TypedItem::Const(check_const(env, c)?))
        Item::Macro(m) => Result::Ok(TypedItem::Macro(TypedMacro { ast: m.clone() }))
        Item::Use(u) => Result::Ok(TypedItem::Use(TypedUse { ast: u.clone() }))
        Item::Mod(module) => Result::Ok(TypedItem::Mod(check_mod(env, module)?))
        Item::Impl(i) => Result::Ok(TypedItem::Impl(check_impl(env, i)?))
        Item::Test(t) => Result::Ok(TypedItem::Test(check_test(env, t)?))
        Item::TypeAlias(ta) => Result::Ok(TypedItem::TypeAlias(TypedTypeAlias { ast: ta.clone() }))
        Item::MaterialGraph(mg) => Result::Ok(TypedItem::MaterialGraph(mg.clone()))
        Item::MaterialFunction(mf) => Result::Ok(TypedItem::MaterialFunction(mf.clone()))
        Item::GraphEditor(ge) => Result::Ok(TypedItem::GraphEditor(ge.clone()))
        Item::GraphRuntime(gr) => Result::Ok(TypedItem::GraphRuntime(gr.clone()))
        Item::StateMachine(sm) => Result::Ok(TypedItem::StateMachine(sm.clone()))
        Item::AsyncTask(at) => Result::Ok(TypedItem::AsyncTask(at.clone()))
        Item::EditorModule(em) => Result::Ok(TypedItem::EditorModule(em.clone()))
        Item::GameplayTags(gt) => Result::Ok(TypedItem::GameplayTags(gt.clone()))
        Item::GameplayAbility(ga) => Result::Ok(TypedItem::GameplayAbility(ga.clone()))
        Item::GameplayEffect(ge) => Result::Ok(TypedItem::GameplayEffect(ge.clone()))
        Item::GameplayCue(gc) => Result::Ok(TypedItem::GameplayCue(gc.clone()))
        _ => Result::Err(env.type_error("Item type not yet supported in type checker", item_span(item)))

fn check_mod(env: &mut TypeEnv, module: &Mod) -> Result<TypedMod, KainError>:
    let mut items = Vec__new_()
    match &(*module).inline_:
        Some(children) =>
            let bindings = inline_module_scope_bindings(env, children)?
            for child in children:
                match child:
                    Item::Mod(_) => check_item_into(env, child, &mut items)?
                    _ =>
                        env.push_scope()
                        ()
                        define_scope_bindings(env, &bindings)
                        ()
                        check_item_into(env, child, &mut items)?
                        ()
                        env.pop_scope()
                        ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(TypedMod { ast: module.clone(), items: items })

fn check_const(env: &mut TypeEnv, c: &Const) -> Result<TypedConst, KainError>:
    let ty = resolve_type_in_env(env, &(*c).ty)?
    let value_ty = infer_expr_type(env, &(*c).value, none)?
    ensure_type_compatible(env, &ty, &value_ty, (*c).value.span(), "const value")?
    ()
    Result::Ok(TypedConst { ast: c.clone(), ty: ty })

fn check_actor(env: &mut TypeEnv, a: &Actor) -> Result<TypedActor, KainError>:
    let mut state_types = HashMap__new_()
    for s in &(*a).state_:
        let ty = resolve_type_in_env(env, &s.ty)?
        let initial_ty = infer_expr_type(env, &s.initial, none)?
        ensure_type_compatible(env, &ty, &initial_ty, s.initial.span(), "actor state initializer")?
        ()
        state_types.insert(s.name.clone(), ty)
        ()
    ()
    let self_ty = ResolvedType::Struct((*a).name.clone(), state_types.clone())
    for handler in &(*a).handlers:
        let handler_return = ResolvedType__Unit
        let ctx = SemanticContext { function_name: f"{(*a).name}_{handler.message_type}", return_type: handler_return, effects: EffectSet__new_() }
        env.push_scope()
        ()
        env.define(("self").to_string(), self_ty.clone())
        ()
        for param in &handler.params:
            let ty = resolve_param_type(env, param, Option::Some(&self_ty))?
            env.define(param.name.clone(), ty)
            ()
        ()
        check_block_semantics(env, &handler.body, &ctx)?
        ()
        env.pop_scope()
        ()
    ()
    for method in &(*a).methods:
        check_function_with_self(env, method, &self_ty)?
        ()
    ()
    Result::Ok(TypedActor { ast: a.clone(), state_types: state_types })

fn check_test(env: &mut TypeEnv, t: &TestDef) -> Result<TypedTest, KainError>:
    let ctx = SemanticContext { function_name: f"test::{(*t).name}", return_type: ResolvedType__Unit, effects: EffectSet__new_() }
    env.push_scope()
    ()
    check_block_semantics(env, &(*t).body, &ctx)?
    ()
    env.pop_scope()
    ()
    Result::Ok(TypedTest { ast: t.clone() })

fn check_impl(env: &mut TypeEnv, imp: &Impl) -> Result<TypedImpl, KainError>:
    let self_ty = resolve_type_in_env(env, &(*imp).target_type)?
    for method in &(*imp).methods:
        check_function_with_self(env, method, &self_ty)?
        ()
    ()
    Result::Ok(TypedImpl { ast: imp.clone() })

fn check_function(env: &mut TypeEnv, f: &Function) -> Result<TypedFunction, KainError>:
    let resolved_type = function_signature(env, f, none)?
    let effects = match &resolved_type:
        ResolvedType::Function { effects: effects } => effects.clone()
        _ => EffectSet__new_()
    let ret = match &resolved_type:
        ResolvedType::Function { ret: ret } => ret.clone()
        _ => ResolvedType__Unit
    let ctx = SemanticContext { function_name: (*f).name.clone(), return_type: ret, effects: effects.clone() }
    env.push_scope()
    ()
    for p in &(*f).params:
        let ty = resolve_param_type(env, p, none)?
        env.define(p.name.clone(), ty)
        ()
    ()
    check_block_semantics(env, &(*f).body, &ctx)?
    ()
    env.pop_scope()
    ()
    Result::Ok(TypedFunction { ast: f.clone(), resolved_type: resolved_type, effects: effects })

fn check_function_with_self(env: &mut TypeEnv, f: &Function, self_ty: &ResolvedType) -> Result<TypedFunction, KainError>:
    let resolved_type = function_signature(env, f, Option::Some(self_ty))?
    let effects = match &resolved_type:
        ResolvedType::Function { effects: effects } => effects.clone()
        _ => EffectSet__new_()
    let ret = match &resolved_type:
        ResolvedType::Function { ret: ret } => ret.clone()
        _ => ResolvedType__Unit
    let ctx = SemanticContext { function_name: (*f).name.clone(), return_type: ret, effects: effects.clone() }
    env.push_scope()
    ()
    for p in &(*f).params:
        let ty = resolve_param_type(env, p, Option::Some(self_ty))?
        env.define(p.name.clone(), ty)
        ()
    ()
    check_block_semantics(env, &(*f).body, &ctx)?
    ()
    env.pop_scope()
    ()
    Result::Ok(TypedFunction { ast: f.clone(), resolved_type: resolved_type, effects: effects })

fn patch_function_view(patch: &PatchDef) -> Function:
    Function { name: (*patch).name.clone(), generics: [], params: (*patch).params.clone(), return_type: (*patch).return_type.clone(), effects: [], body: (*patch).body.clone(), visibility: (*patch).visibility, attributes: (*patch).attributes.clone(), span: (*patch).span }

fn law_function_view(law: &LawDef) -> Function:
    Function { name: (*law).name.clone(), generics: [], params: (*law).params.clone(), return_type: Option::Some((*law).return_type.clone()), effects: [], body: (*law).body.clone(), visibility: (*law).visibility, attributes: (*law).attributes.clone(), span: (*law).span }

fn converge_dispatcher_view(converge: &ConvergeDef) -> Function:
    Function { name: (*converge).name.clone(), generics: [], params: (*converge).params.clone(), return_type: (*converge).return_type.clone(), effects: [], body: Block { stmts: [], span: (*converge).span }, visibility: (*converge).visibility, attributes: (*converge).attributes.clone(), span: (*converge).span }

fn converge_lane_function_view(converge: &ConvergeDef, lane: &ConvergeLane) -> Function:
    Function { name: f"__kain_converge__{(*converge).name}__{(*lane).lane_name}", generics: [], params: (*converge).params.clone(), return_type: (*converge).return_type.clone(), effects: [], body: (*lane).body.clone(), visibility: (*converge).visibility, attributes: (*converge).attributes.clone(), span: (*lane).span }

fn orchestrate_function_view(orchestrate: &OrchestrateDef) -> Function:
    Function { name: (*orchestrate).name.clone(), generics: [], params: (*orchestrate).params.clone(), return_type: (*orchestrate).return_type.clone(), effects: [], body: (*orchestrate).body.clone(), visibility: (*orchestrate).visibility, attributes: (*orchestrate).attributes.clone(), span: (*orchestrate).span }

fn check_patch(env: &mut TypeEnv, patch: &PatchDef) -> Result<TypedPatch, KainError>:
    let typed_fn = check_function(env, &patch_function_view(patch))?
    let mutation_paths = collect_patch_mutation_paths_from_block(&(*patch).body)
    let undo_mode = if patch_body_requires_best_effort(&(*patch).body):
        PatchUndoMode__BestEffort
    else:
        PatchUndoMode__Reversible
    Result::Ok(TypedPatch { ast: patch.clone(), resolved_type: typed_fn.resolved_type, effects: typed_fn.effects, mutation_paths: mutation_paths, undo_mode: undo_mode })

fn check_law(env: &mut TypeEnv, law: &LawDef) -> Result<TypedLaw, KainError>:
    let typed_fn = check_function(env, &law_function_view(law))?
    let resolved_return_type = resolve_type_in_env(env, &(*law).return_type)?
    if (resolved_return_type != ResolvedType__Bool):
        return Result::Err(env.type_error(f"law '{(*law).name}' must return Bool, found {describe_type(&resolved_return_type)}", (*law).return_type.span()))
    Result::Ok(TypedLaw { ast: law.clone(), resolved_type: typed_fn.resolved_type, effects: typed_fn.effects })

fn check_converge(env: &mut TypeEnv, converge: &ConvergeDef) -> Result<TypedConverge, KainError>:
    let resolved_type = function_signature(env, &converge_dispatcher_view(converge), none)?
    let expected_signature = resolved_type.clone()
    if (*converge).verify_random_count.is_some():
        ensure_converge_verify_types_supported(env, converge, &expected_signature)?
        ()
        ()
        ()
        ()
    check_function(env, &converge_lane_function_view(converge, &(*converge).spec_lane))?
    ()
    for lane in &(*converge).fast_lanes:
        check_function(env, &converge_lane_function_view(converge, lane))?
        ()
        let lane_signature = function_signature(env, &converge_lane_function_view(converge, lane), none)?
        if (lane_signature != expected_signature):
            return Result::Err(env.type_error(f"Converge lane '{lane.lane_name}' does not match dispatcher signature", lane.span))
    ()
    Result::Ok(TypedConverge { ast: converge.clone(), resolved_type: resolved_type })

fn check_world(env: &mut TypeEnv, world: &WorldDef) -> Result<TypedWorld, KainError>:
    let mut state_types = HashMap__new_()
    let mut seen_surface_kinds = HashSet__new_()
    for state_ in &(*world).states:
        let resolved_ty = resolve_type_in_env(env, &state_.ty)?
        let initial_ty = infer_expr_type(env, &state_.initial, none)?
        ensure_type_compatible(env, &resolved_ty, &initial_ty, state_.initial.span(), "world state initializer")?
        ()
        state_types.insert(state_.name.clone(), resolved_ty)
        ()
    ()
    let world_ty = ResolvedType::Struct((*world).name.clone(), state_types)
    (*env).types.insert((*world).name.clone(), world_ty.clone())
    ()
    env.define_global((*world).name.clone(), world_ty)
    ()
    if (*world).surfaces.is_empty():
        return Result::Err(env.type_error(f"world '{(*world).name}' must declare at least one surface", (*world).span))
    for surface in &(*world).surfaces:
        if (!seen_surface_kinds.insert(surface.kind)):
            return Result::Err(env.type_error(f"world '{(*world).name}' declares duplicate '{surface.kind.as_str()}' surface", surface.span))
        check_world_surface_projection(env, surface)?
        ()
    ()
    Result::Ok(TypedWorld { ast: world.clone() })

fn check_orchestrate(env: &mut TypeEnv, orchestrate: &OrchestrateDef) -> Result<TypedOrchestrate, KainError>:
    let typed_fn = check_function(env, &orchestrate_function_view(orchestrate))?
    let stages = collect_orchestrate_stage_descriptors(env, orchestrate)?
    Result::Ok(TypedOrchestrate { ast: orchestrate.clone(), resolved_type: typed_fn.resolved_type, stages: stages })

fn check_world_surface_projection(env: &mut TypeEnv, surface: &WorldSurfaceProjection) -> Result<(), KainError>:
    match (*surface).kind:
        WorldSurfaceKind::NativeUi =>
            match &(*surface).expr:
                Expr::Ident(_, _) => Result::Ok(())
                Expr::Call { callee: callee } =>
                    match callee:
                        Expr::Ident(_, _) => Result::Ok(())
                        other => Result::Err(env.type_error(f"world surface '{(*surface).kind.as_str()}' expects a component identifier or call, found {other}", (*surface).span))
                other => Result::Err(env.type_error(f"world surface '{(*surface).kind.as_str()}' expects a component identifier or call, found {other}", (*surface).span))
        WorldSurfaceKind::Web =>
            match &(*surface).expr:
                Expr::Ident(_, _) => Result::Ok(())
                Expr::Call { callee: callee } =>
                    match callee:
                        Expr::Ident(_, _) => Result::Ok(())
                        other => Result::Err(env.type_error(f"world surface '{(*surface).kind.as_str()}' expects a component identifier or call, found {other}", (*surface).span))
                other => Result::Err(env.type_error(f"world surface '{(*surface).kind.as_str()}' expects a component identifier or call, found {other}", (*surface).span))
        WorldSurfaceKind::Viewport3d =>
            match &(*surface).expr:
                Expr::Ident(_, _) => Result::Ok(())
                Expr::String(_, _) => Result::Ok(())
                other => Result::Err(env.type_error(f"world surface '{(*surface).kind.as_str()}' expects an identifier or string literal, found {other}", (*surface).span))
        WorldSurfaceKind::Ue5 =>
            match &(*surface).expr:
                Expr::Ident(_, _) => Result::Ok(())
                Expr::String(_, _) => Result::Ok(())
                other => Result::Err(env.type_error(f"world surface '{(*surface).kind.as_str()}' expects an identifier or string literal, found {other}", (*surface).span))

fn collect_patch_mutation_paths_from_block(block: &Block) -> Array<String>:
    let mut paths = Vec__new_()
    for stmt in &(*block).stmts:
        collect_patch_mutation_paths_from_stmt(stmt, &mut paths)
        ()
    ()
    paths.sort()
    ()
    paths.dedup()
    ()
    paths

fn collect_patch_mutation_paths_from_stmt(stmt: &Stmt, output: &mut Array<String>):
    match stmt:
        Stmt::Let { value: value } =>
            match value:
                Some(value) =>
                    collect_patch_mutation_paths_from_expr(value, output)
                    ()
                _ => ()
        Stmt::Expr(expr) => collect_patch_mutation_paths_from_expr(expr, output)
        Stmt::Return(value, _) =>
            match value:
                Some(value) =>
                    collect_patch_mutation_paths_from_expr(value, output)
                    ()
                _ => ()
        Stmt::Break(value, _) =>
            match value:
                Some(value) =>
                    collect_patch_mutation_paths_from_expr(value, output)
                    ()
                _ => ()
        Stmt::For { iter: iter, body: body } =>
            collect_patch_mutation_paths_from_expr(iter, output)
            ()
            for stmt in &body.stmts:
                collect_patch_mutation_paths_from_stmt(stmt, output)
                ()
        Stmt::While { condition: condition, body: body } =>
            collect_patch_mutation_paths_from_expr(condition, output)
            ()
            for stmt in &body.stmts:
                collect_patch_mutation_paths_from_stmt(stmt, output)
                ()
        Stmt::Loop { body: body } =>
            for stmt in &body.stmts:
                collect_patch_mutation_paths_from_stmt(stmt, output)
                ()
        Stmt::Item(_) => ()
        Stmt::Continue(_) => ()

fn collect_patch_mutation_paths_from_expr(expr: &Expr, output: &mut Array<String>):
    match expr:
        Expr::Assign { target: target, value: value } =>
            match patch_target_path(target):
                Some(path) =>
                    output.push(path)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            collect_patch_mutation_paths_from_expr(value, output)
            ()
        Expr::Call { callee: callee, args: args } =>
            collect_patch_mutation_paths_from_expr(callee, output)
            ()
            for arg in args:
                collect_patch_mutation_paths_from_expr(&arg.value, output)
                ()
        Expr::StageCall { args: args } =>
            for arg in args:
                collect_patch_mutation_paths_from_expr(&arg.value, output)
                ()
        Expr::MethodCall { args: args } =>
            for arg in args:
                collect_patch_mutation_paths_from_expr(&arg.value, output)
                ()
        Expr::Binary { left: left, right: right } =>
            collect_patch_mutation_paths_from_expr(left, output)
            ()
            collect_patch_mutation_paths_from_expr(right, output)
            ()
        Expr::Unary { operand: operand } => collect_patch_mutation_paths_from_expr(operand, output)
        Expr::Try(operand, _) => collect_patch_mutation_paths_from_expr(operand, output)
        Expr::Await(operand, _) => collect_patch_mutation_paths_from_expr(operand, output)
        Expr::AsyncBlock(operand, _) => collect_patch_mutation_paths_from_expr(operand, output)
        Expr::Ref { value: operand } => collect_patch_mutation_paths_from_expr(operand, output)
        Expr::AddrOf { value: operand } => collect_patch_mutation_paths_from_expr(operand, output)
        Expr::Deref(operand, _) => collect_patch_mutation_paths_from_expr(operand, output)
        Expr::Paren(operand, _) => collect_patch_mutation_paths_from_expr(operand, output)
        Expr::Field { object: object } => collect_patch_mutation_paths_from_expr(object, output)
        Expr::Index { object: object, index: index } =>
            collect_patch_mutation_paths_from_expr(object, output)
            ()
            collect_patch_mutation_paths_from_expr(index, output)
            ()
        Expr::Struct { fields: fields, rest: rest } =>
            for selfhost_for_item in fields:
                let (_, value) = selfhost_for_item
                collect_patch_mutation_paths_from_expr(value, output)
                ()
            ()
            match rest:
                Some(rest) =>
                    collect_patch_mutation_paths_from_expr(rest, output)
                    ()
                _ => ()
        Expr::AggregateInit { fields: fields } =>
            for selfhost_for_item in fields:
                let (_, value) = selfhost_for_item
                collect_patch_mutation_paths_from_expr(value, output)
                ()
        Expr::EnumVariant { fields: fields } =>
            match fields:
                EnumVariantFields::Tuple(values) =>
                    for value in values:
                        collect_patch_mutation_paths_from_expr(value, output)
                        ()
                EnumVariantFields::Struct(values) =>
                    for selfhost_for_item in values:
                        let (_, value) = selfhost_for_item
                        collect_patch_mutation_paths_from_expr(value, output)
                        ()
                EnumVariantFields::Unit => ()
        Expr::Array(values, _) =>
            for value in values:
                collect_patch_mutation_paths_from_expr(value, output)
                ()
        Expr::Tuple(values, _) =>
            for value in values:
                collect_patch_mutation_paths_from_expr(value, output)
                ()
        Expr::Range { start: start, end: end } =>
            match start:
                Some(start) =>
                    collect_patch_mutation_paths_from_expr(start, output)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match end:
                Some(end) =>
                    collect_patch_mutation_paths_from_expr(end, output)
                    ()
                _ => ()
        Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
            collect_patch_mutation_paths_from_expr(condition, output)
            ()
            for stmt in &then_branch.stmts:
                collect_patch_mutation_paths_from_stmt(stmt, output)
                ()
            ()
            match else_branch:
                Some(else_branch) =>
                    collect_patch_mutation_paths_from_else_branch(else_branch, output)
                    ()
                _ => ()
        Expr::Match { scrutinee: scrutinee, arms: arms } =>
            collect_patch_mutation_paths_from_expr(scrutinee, output)
            ()
            for arm in arms:
                match &arm.guard:
                    Some(guard) =>
                        collect_patch_mutation_paths_from_expr(guard, output)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                collect_patch_mutation_paths_from_expr(&arm.body, output)
                ()
        Expr::Lambda { body: body } => collect_patch_mutation_paths_from_expr(body, output)
        Expr::MemStore { pointer: pointer, value: value } =>
            collect_patch_mutation_paths_from_expr(pointer, output)
            ()
            collect_patch_mutation_paths_from_expr(value, output)
            ()
        Expr::PtrOffset { pointer: pointer, offset: offset } =>
            collect_patch_mutation_paths_from_expr(pointer, output)
            ()
            collect_patch_mutation_paths_from_expr(offset, output)
            ()
        Expr::MemLoad { pointer: pointer } => collect_patch_mutation_paths_from_expr(pointer, output)
        Expr::Cast { value: pointer } => collect_patch_mutation_paths_from_expr(pointer, output)
        Expr::Comptime(pointer, _) => collect_patch_mutation_paths_from_expr(pointer, output)
        Expr::Spawn { init: init } =>
            for selfhost_for_item in init:
                let (_, value) = selfhost_for_item
                collect_patch_mutation_paths_from_expr(value, output)
                ()
        Expr::SendMsg { data: init } =>
            for selfhost_for_item in init:
                let (_, value) = selfhost_for_item
                collect_patch_mutation_paths_from_expr(value, output)
                ()
        Expr::Return(value, _) =>
            match value:
                Some(value) =>
                    collect_patch_mutation_paths_from_expr(value, output)
                    ()
                _ => ()
        Expr::Break(value, _) =>
            match value:
                Some(value) =>
                    collect_patch_mutation_paths_from_expr(value, output)
                    ()
                _ => ()
        Expr::JSX(_, _) => ()
        Expr::MacroCall {  } => ()
        Expr::Int(_, _) => ()
        Expr::Float(_, _) => ()
        Expr::String(_, _) => ()
        Expr::FString(_, _) => ()
        Expr::Bool(_, _) => ()
        Expr::None(_) => ()
        Expr::Ident(_, _) => ()
        Expr::Alloca {  } => ()
        Expr::Uninit {  } => ()
        Expr::Alloc {  } => ()
        Expr::Realloc {  } => ()
        Expr::SizeOfType {  } => ()
        Expr::AlignOfType {  } => ()
        Expr::Continue(_) => ()
        Expr::Block(block, _) =>
            for stmt in &block.stmts:
                collect_patch_mutation_paths_from_stmt(stmt, output)
                ()

fn collect_patch_mutation_paths_from_else_branch(branch: &ElseBranch, output: &mut Array<String>):
    match branch:
        ElseBranch::Else(block) =>
            for stmt in &block.stmts:
                collect_patch_mutation_paths_from_stmt(stmt, output)
                ()
        ElseBranch::ElseIf(condition, block, next) =>
            collect_patch_mutation_paths_from_expr(condition, output)
            ()
            for stmt in &block.stmts:
                collect_patch_mutation_paths_from_stmt(stmt, output)
                ()
            ()
            match next:
                Some(next) =>
                    collect_patch_mutation_paths_from_else_branch(next, output)
                    ()
                _ => ()

fn patch_target_path(target: &Expr) -> Option<String>:
    match target:
        Expr::Ident(name, _) => Option::Some(name.clone())
        Expr::Field { object: object, field: field } => patch_target_path(object).map(fn(base): f"{base}.{field}")
        Expr::Index { object: object, index: index } => patch_target_path(object).map(fn(base): none)
        Expr::Deref(inner, _) => patch_target_path(inner)
        _ => none

fn patch_body_requires_best_effort(block: &Block) -> Bool:
    (*block).stmts.iter().any(stmt_requires_best_effort_patch_mode)

fn stmt_requires_best_effort_patch_mode(stmt: &Stmt) -> Bool:
    match stmt:
        Stmt::Expr(expr) => expr_requires_best_effort_patch_mode(expr)
        Stmt::Let { value: value } => value.is_some_and(expr_requires_best_effort_patch_mode)
        Stmt::Return(value, _) => value.is_some_and(expr_requires_best_effort_patch_mode)
        Stmt::Break(value, _) => value.is_some_and(expr_requires_best_effort_patch_mode)
        Stmt::For { iter: iter, body: body } => (expr_requires_best_effort_patch_mode(iter) || body.stmts.iter().any(stmt_requires_best_effort_patch_mode))
        Stmt::While { condition: condition, body: body } => (expr_requires_best_effort_patch_mode(condition) || body.stmts.iter().any(stmt_requires_best_effort_patch_mode))
        Stmt::Loop { body: body } => body.stmts.iter().any(stmt_requires_best_effort_patch_mode)
        Stmt::Item(_) => false
        Stmt::Continue(_) => false

fn expr_requires_best_effort_patch_mode(expr: &Expr) -> Bool:
    match expr:
        Expr::Call {  } => true
        Expr::MethodCall {  } => true
        Expr::StageCall {  } => true
        Expr::Spawn {  } => true
        Expr::SendMsg {  } => true
        Expr::Await(_, _) => true
        Expr::AsyncBlock(_, _) => true
        Expr::Assign { target: target, value: value } => (expr_requires_best_effort_patch_mode(target) || expr_requires_best_effort_patch_mode(value))
        Expr::Binary { left: left, right: right } => (expr_requires_best_effort_patch_mode(left) || expr_requires_best_effort_patch_mode(right))
        Expr::Unary { operand: operand } => expr_requires_best_effort_patch_mode(operand)
        Expr::Try(operand, _) => expr_requires_best_effort_patch_mode(operand)
        Expr::Ref { value: operand } => expr_requires_best_effort_patch_mode(operand)
        Expr::AddrOf { value: operand } => expr_requires_best_effort_patch_mode(operand)
        Expr::Deref(operand, _) => expr_requires_best_effort_patch_mode(operand)
        Expr::Paren(operand, _) => expr_requires_best_effort_patch_mode(operand)
        Expr::Cast { value: operand } => expr_requires_best_effort_patch_mode(operand)
        Expr::Comptime(operand, _) => expr_requires_best_effort_patch_mode(operand)
        Expr::Field { object: object } => expr_requires_best_effort_patch_mode(object)
        Expr::Index { object: object, index: index } => (expr_requires_best_effort_patch_mode(object) || expr_requires_best_effort_patch_mode(index))
        Expr::Struct { fields: fields, rest: rest } => (fields.iter().any(fn(__kain_closure_arg0): expr_requires_best_effort_patch_mode(__kain_closure_arg0.__kain_tuple_1)) || rest.is_some_and(fn(rest): expr_requires_best_effort_patch_mode(rest)))
        Expr::AggregateInit { fields: fields } => fields.iter().any(fn(__kain_closure_arg1): expr_requires_best_effort_patch_mode(__kain_closure_arg1.__kain_tuple_1))
        Expr::EnumVariant { fields: fields } =>
            match fields:
                EnumVariantFields::Tuple(values) => values.iter().any(expr_requires_best_effort_patch_mode)
                EnumVariantFields::Struct(values) => values.iter().any(fn(__kain_closure_arg2): expr_requires_best_effort_patch_mode(__kain_closure_arg2.__kain_tuple_1))
                EnumVariantFields::Unit => false
        Expr::Array(values, _) => values.iter().any(expr_requires_best_effort_patch_mode)
        Expr::Tuple(values, _) => values.iter().any(expr_requires_best_effort_patch_mode)
        Expr::Range { start: start, end: end } => (start.is_some_and(fn(value): expr_requires_best_effort_patch_mode(value)) || end.is_some_and(fn(value): expr_requires_best_effort_patch_mode(value)))
        Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } => ((expr_requires_best_effort_patch_mode(condition) || then_branch.stmts.iter().any(stmt_requires_best_effort_patch_mode)) || else_branch.is_some_and(fn(branch): none))
        Expr::Match { scrutinee: scrutinee, arms: arms } => (expr_requires_best_effort_patch_mode(scrutinee) || arms.iter().any(fn(arm): (arm.guard.is_some_and(expr_requires_best_effort_patch_mode) || expr_requires_best_effort_patch_mode(&arm.body))))
        Expr::Lambda { body: body } => expr_requires_best_effort_patch_mode(body)
        Expr::PtrOffset { pointer: pointer, offset: offset } => (expr_requires_best_effort_patch_mode(pointer) || expr_requires_best_effort_patch_mode(offset))
        Expr::MemLoad { pointer: pointer } => expr_requires_best_effort_patch_mode(pointer)
        Expr::MemStore { pointer: pointer, value: value } => (expr_requires_best_effort_patch_mode(pointer) || expr_requires_best_effort_patch_mode(value))
        Expr::Return(value, _) => value.is_some_and(fn(value): expr_requires_best_effort_patch_mode(value))
        Expr::Break(value, _) => value.is_some_and(fn(value): expr_requires_best_effort_patch_mode(value))
        Expr::Block(block, _) => block.stmts.iter().any(stmt_requires_best_effort_patch_mode)
        Expr::JSX(_, _) => false
        Expr::MacroCall {  } => false
        Expr::Int(_, _) => false
        Expr::Float(_, _) => false
        Expr::String(_, _) => false
        Expr::FString(_, _) => false
        Expr::Bool(_, _) => false
        Expr::None(_) => false
        Expr::Ident(_, _) => false
        Expr::Alloca {  } => false
        Expr::Uninit {  } => false
        Expr::Alloc {  } => false
        Expr::Realloc {  } => false
        Expr::SizeOfType {  } => false
        Expr::AlignOfType {  } => false
        Expr::Continue(_) => false

fn collect_orchestrate_stage_descriptors(env: &TypeEnv, orchestrate: &OrchestrateDef) -> Result<Array<OrchestrateStageDescriptor>, KainError>:
    let mut stages = Vec__new_()
    let mut seen_non_stage_stmt = false
    for stmt in &(*orchestrate).body.stmts:
        match stmt:
            Stmt::Let { pattern: Pattern::Binding { name: name, mutable_: _, span: _ }, ty: Some(_), value: Some(Expr::StageCall { runtime: runtime, function: function }), span: span } =>
                if seen_non_stage_stmt:
                    return Result::Err(env.type_error(f"orchestrate '{(*orchestrate).name}' must declare stage steps before local computation", (*span)))
                stages.push(OrchestrateStageDescriptor { runtime: (*runtime), function: function.clone(), binding_name: name.clone() })
                ()
            Stmt::Let { value: Some(Expr::StageCall { span: span }) } => return Result::Err(env.type_error(f"orchestrate '{(*orchestrate).name}' stage steps must be top-level 'let binding: Type = <runtime> function(...)' declarations", (*span)))
            Stmt::Item(item) => return Result::Err(env.type_error(f"orchestrate '{(*orchestrate).name}' cannot declare nested items inside its pipeline body", item_span(item)))
            other =>
                match first_stage_call_in_stmt(other):
                    Some(stage_span) => return Result::Err(env.type_error(f"orchestrate '{(*orchestrate).name}' only permits stage calls in top-level typed let bindings", stage_span))
                    _ =>
                        ()
                        ()
                seen_non_stage_stmt = true
                ()
    ()
    Result::Ok(stages)

fn first_stage_call_in_stmt(stmt: &Stmt) -> Option<Span>:
    match stmt:
        Stmt::Let { value: value } => value.and_then(first_stage_call_in_expr)
        Stmt::Expr(expr) => first_stage_call_in_expr(expr)
        Stmt::Return(value, _) => value.and_then(first_stage_call_in_expr)
        Stmt::Break(value, _) => value.and_then(first_stage_call_in_expr)
        Stmt::For { iter: iter, body: body } => first_stage_call_in_expr(iter).or_else(fn(): first_stage_call_in_block(body))
        Stmt::While { condition: condition, body: body } => first_stage_call_in_expr(condition).or_else(fn(): first_stage_call_in_block(body))
        Stmt::Loop { body: body } => first_stage_call_in_block(body)
        Stmt::Item(_) => none
        Stmt::Continue(_) => none

fn first_stage_call_in_block(block: &Block) -> Option<Span>:
    (*block).stmts.iter().find_map(first_stage_call_in_stmt)

fn first_stage_call_in_else_branch(branch: &ElseBranch) -> Option<Span>:
    match branch:
        ElseBranch::Else(block) => first_stage_call_in_block(block)
        ElseBranch::ElseIf(condition, block, next) => first_stage_call_in_expr(condition).or_else(fn(): first_stage_call_in_block(block)).or_else(fn(): next.and_then(fn(branch): first_stage_call_in_else_branch(branch)))

fn first_stage_call_in_expr(expr: &Expr) -> Option<Span>:
    match expr:
        Expr::StageCall { span: span } => Option::Some((*span))
        Expr::Assign { target: target, value: value } => first_stage_call_in_expr(target).or_else(fn(): first_stage_call_in_expr(value))
        Expr::Call { callee: callee, args: args } => first_stage_call_in_expr(callee).or_else(fn(): args.iter().find_map(fn(arg): first_stage_call_in_expr(&arg.value)))
        Expr::MethodCall { args: args } => args.iter().find_map(fn(arg): first_stage_call_in_expr(&arg.value))
        Expr::Binary { left: left, right: right } => first_stage_call_in_expr(left).or_else(fn(): first_stage_call_in_expr(right))
        Expr::Unary { operand: operand } => first_stage_call_in_expr(operand)
        Expr::Try(operand, _) => first_stage_call_in_expr(operand)
        Expr::Await(operand, _) => first_stage_call_in_expr(operand)
        Expr::AsyncBlock(operand, _) => first_stage_call_in_expr(operand)
        Expr::Ref { value: operand } => first_stage_call_in_expr(operand)
        Expr::AddrOf { value: operand } => first_stage_call_in_expr(operand)
        Expr::Deref(operand, _) => first_stage_call_in_expr(operand)
        Expr::Paren(operand, _) => first_stage_call_in_expr(operand)
        Expr::Cast { value: operand } => first_stage_call_in_expr(operand)
        Expr::Comptime(operand, _) => first_stage_call_in_expr(operand)
        Expr::Field { object: object } => first_stage_call_in_expr(object)
        Expr::Index { object: object, index: index } => first_stage_call_in_expr(object).or_else(fn(): first_stage_call_in_expr(index))
        Expr::Struct { fields: fields, rest: rest } => fields.iter().find_map(fn(__kain_closure_arg3): first_stage_call_in_expr(__kain_closure_arg3.__kain_tuple_1)).or_else(fn(): rest.and_then(fn(rest): first_stage_call_in_expr(rest)))
        Expr::AggregateInit { fields: fields } => fields.iter().find_map(fn(__kain_closure_arg4): first_stage_call_in_expr(__kain_closure_arg4.__kain_tuple_1))
        Expr::EnumVariant { fields: fields } =>
            match fields:
                EnumVariantFields::Tuple(values) => values.iter().find_map(first_stage_call_in_expr)
                EnumVariantFields::Struct(values) => values.iter().find_map(fn(__kain_closure_arg5): first_stage_call_in_expr(__kain_closure_arg5.__kain_tuple_1))
                EnumVariantFields::Unit => none
        Expr::Array(values, _) => values.iter().find_map(first_stage_call_in_expr)
        Expr::Tuple(values, _) => values.iter().find_map(first_stage_call_in_expr)
        Expr::Range { start: start, end: end } => start.and_then(fn(value): first_stage_call_in_expr(value)).or_else(fn(): end.and_then(fn(value): first_stage_call_in_expr(value)))
        Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } => first_stage_call_in_expr(condition).or_else(fn(): first_stage_call_in_block(then_branch)).or_else(fn(): else_branch.and_then(fn(branch): first_stage_call_in_else_branch(branch)))
        Expr::Match { scrutinee: scrutinee, arms: arms } => first_stage_call_in_expr(scrutinee).or_else(fn(): arms.iter().find_map(fn(arm): arm.guard.and_then(first_stage_call_in_expr).or_else(fn(): first_stage_call_in_expr(&arm.body))))
        Expr::Lambda { body: body } => first_stage_call_in_expr(body)
        Expr::MemStore { pointer: pointer, value: value } => first_stage_call_in_expr(pointer).or_else(fn(): first_stage_call_in_expr(value))
        Expr::PtrOffset { pointer: pointer, offset: offset } => first_stage_call_in_expr(pointer).or_else(fn(): first_stage_call_in_expr(offset))
        Expr::MemLoad { pointer: pointer } => first_stage_call_in_expr(pointer)
        Expr::Spawn { init: init } => init.iter().find_map(fn(__kain_closure_arg6): first_stage_call_in_expr(__kain_closure_arg6.__kain_tuple_1))
        Expr::SendMsg { data: init } => init.iter().find_map(fn(__kain_closure_arg6): first_stage_call_in_expr(__kain_closure_arg6.__kain_tuple_1))
        Expr::Return(value, _) => value.and_then(fn(expr): first_stage_call_in_expr(expr))
        Expr::Break(value, _) => value.and_then(fn(expr): first_stage_call_in_expr(expr))
        Expr::Block(block, _) => first_stage_call_in_block(block)
        Expr::JSX(_, _) => none
        Expr::MacroCall {  } => none
        Expr::Int(_, _) => none
        Expr::Float(_, _) => none
        Expr::String(_, _) => none
        Expr::FString(_, _) => none
        Expr::Bool(_, _) => none
        Expr::None(_) => none
        Expr::Ident(_, _) => none
        Expr::Alloca {  } => none
        Expr::Uninit {  } => none
        Expr::Alloc {  } => none
        Expr::Realloc {  } => none
        Expr::SizeOfType {  } => none
        Expr::AlignOfType {  } => none
        Expr::Continue(_) => none

fn ensure_converge_verify_types_supported(env: &TypeEnv, converge: &ConvergeDef, signature: &ResolvedType) -> Result<(), KainError>:
    let ResolvedType::Function { params: params, ret: ret } = signature
    for selfhost_for_item in (*converge).params.iter().zip(params.iter()):
        let (param, ty) = selfhost_for_item
        if (!supports_converge_verify_sampling(ty)):
            return Result::Err(env.type_error(f"converge '{(*converge).name}' verify random(n) does not support parameter '{param.name}' of type {describe_type(ty)}", param.span))
    ()
    if (!supports_converge_verify_sampling(ret)):
        let return_span = (*converge).return_type.map(Type__span).unwrap_or((*converge).span)
        return Result::Err(env.type_error(f"converge '{(*converge).name}' verify random(n) does not support return type {describe_type(ret)}", return_span))
    Result::Ok(())

fn supports_converge_verify_sampling(ty: &ResolvedType) -> Bool:
    match ty:
        ResolvedType::Bool => true
        ResolvedType::Int(_) => true
        ResolvedType::Float(_) => true
        ResolvedType::Char => true
        ResolvedType::Array(inner, _) => supports_converge_verify_sampling(inner)
        ResolvedType::Option(inner) => supports_converge_verify_sampling(inner)
        ResolvedType::Tuple(items) => items.iter().all(supports_converge_verify_sampling)
        _ => false

fn check_struct(env: &mut TypeEnv, s: &Struct) -> Result<TypedStruct, KainError>:
    let mut fields = HashMap__new_()
    for f in &(*s).fields:
        let field_ty = resolve_type_in_env(env, &f.ty)?
        match &f.default_:
            Some(default_) =>
                let default_ty = infer_expr_type(env, default_, none)?
                ensure_type_compatible(env, &field_ty, &default_ty, default_.span(), "struct field default")?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        fields.insert(f.name.clone(), field_ty)
        ()
    ()
    let self_ty = ResolvedType::Struct((*s).name.clone(), fields.clone())
    for method in &(*s).methods:
        check_function_with_self(env, method, &self_ty)?
        ()
    ()
    Result::Ok(TypedStruct { ast: s.clone(), field_types: fields })

fn check_enum(env: &mut TypeEnv, e: &Enum) -> Result<TypedEnum, KainError>:
    let mut variant_payload_types: Map<String, Array<ResolvedType>> = HashMap__new_()
    for v in &(*e).variants:
        let payload_types = match &v.fields:
            VariantFields::Unit => Vec__new_()
            VariantFields::Tuple(items) => items.iter().map(fn(ty): resolve_type_in_env(env, ty)).collect()?
            VariantFields::Struct(fields) => fields.iter().map(fn(f): resolve_type_in_env(env, &f.ty)).collect()?
        variant_payload_types.insert(v.name.clone(), payload_types)
        ()
    ()
    Result::Ok(TypedEnum { ast: e.clone(), variant_payload_types: variant_payload_types })

fn check_component(env: &mut TypeEnv, c: &Component) -> Result<TypedComponent, KainError>:
    let mut props = HashMap__new_()
    for p in &(*c).props:
        props.insert(p.name.clone(), resolve_param_type(env, p, none)?)
        ()
    ()
    let self_ty = ResolvedType::Struct((*c).name.clone(), props.clone())
    env.push_scope()
    ()
    for selfhost_for_item in &props:
        let (name, ty) = selfhost_for_item
        env.define(name.clone(), ty.clone())
        ()
    ()
    for state_ in &(*c).state_:
        let state_ty = resolve_type_in_env(env, &state_.ty)?
        let initial_ty = infer_expr_type(env, &state_.initial, none)?
        ensure_type_compatible(env, &state_ty, &initial_ty, state_.initial.span(), "component state initializer")?
        ()
        env.define(state_.name.clone(), state_ty)
        ()
    ()
    for method in &(*c).methods:
        check_function_with_self(env, method, &self_ty)?
        ()
    ()
    check_jsx_semantics(env, &(*c).body, none)?
    ()
    env.pop_scope()
    ()
    Result::Ok(TypedComponent { ast: c.clone(), prop_types: props })

fn check_shader(env: &mut TypeEnv, s: &Shader) -> Result<TypedShader, KainError>:
    let inputs: Array<_> = (*s).inputs.iter().map(fn(p): resolve_param_type(env, p, none)).collect()?
    let output = resolve_type_in_env(env, &(*s).outputs)?
    let ctx = SemanticContext { function_name: (*s).name.clone(), return_type: output.clone(), effects: EffectSet__new_() }
    env.push_scope()
    ()
    for selfhost_for_item in (*s).inputs.iter().zip(inputs.iter()):
        let (param, ty) = selfhost_for_item
        env.define(param.name.clone(), ty.clone())
        ()
    ()
    for uniform_ in &(*s).uniforms:
        env.define(uniform_.name.clone(), resolve_type_in_env(env, &uniform_.ty)?)
        ()
    ()
    check_block_semantics(env, &(*s).body, &ctx)?
    ()
    env.pop_scope()
    ()
    Result::Ok(TypedShader { ast: s.clone(), input_types: inputs, output_type: output })

pub fn resolve_type(ty: &Type) -> Result<ResolvedType, KainError>:
    resolve_type_impl(none, ty)

fn resolve_type_in_env(env: &TypeEnv, ty: &Type) -> Result<ResolvedType, KainError>:
    resolve_type_impl(Option::Some(env), ty)

fn resolve_type_impl(env: Option<&TypeEnv>, ty: &Type) -> Result<ResolvedType, KainError>:
    match ty:
        Type::Named { name: name, generics: generics } =>
            match name.as_str():
                "Int" => Result::Ok(ResolvedType::Int(IntSize__I64))
                "UInt" => Result::Ok(ResolvedType::Int(IntSize__U64))
                "Float" => Result::Ok(ResolvedType::Float(FloatSize__F64))
                "i8" => Result::Ok(ResolvedType::Int(IntSize__I8))
                "i16" => Result::Ok(ResolvedType::Int(IntSize__I16))
                "i32" => Result::Ok(ResolvedType::Int(IntSize__I32))
                "i64" => Result::Ok(ResolvedType::Int(IntSize__I64))
                "i128" => Result::Ok(ResolvedType::Int(IntSize__I128))
                "isize" => Result::Ok(ResolvedType::Int(IntSize__Isize))
                "u8" => Result::Ok(ResolvedType::Int(IntSize__U8))
                "u16" => Result::Ok(ResolvedType::Int(IntSize__U16))
                "u32" => Result::Ok(ResolvedType::Int(IntSize__U32))
                "u64" => Result::Ok(ResolvedType::Int(IntSize__U64))
                "u128" => Result::Ok(ResolvedType::Int(IntSize__U128))
                "usize" => Result::Ok(ResolvedType::Int(IntSize__Usize))
                "f32" => Result::Ok(ResolvedType::Float(FloatSize__F32))
                "f64" => Result::Ok(ResolvedType::Float(FloatSize__F64))
                "Void" => Result::Ok(ResolvedType__Unit)
                "Bool" => Result::Ok(ResolvedType__Bool)
                "Char" => Result::Ok(ResolvedType__Char)
                "String" => Result::Ok(ResolvedType__String)
                "Box" if (generics.len() == 1) => resolve_type_impl(env, &generics[0])
                "Arc" if (generics.len() == 1) => resolve_type_impl(env, &generics[0])
                "Rc" if (generics.len() == 1) => resolve_type_impl(env, &generics[0])
                "Cell" if (generics.len() == 1) => resolve_type_impl(env, &generics[0])
                "RefCell" if (generics.len() == 1) => resolve_type_impl(env, &generics[0])
                "Array" if (generics.len() == 1) => Result::Ok(ResolvedType::Array(Box__new_(resolve_type_impl(env, &generics[0])?), 0))
                "Map" if (generics.len() == 2) => Result::Ok(selfhost_map_type())
                "Set" if (generics.len() == 1) => Result::Ok(selfhost_set_type())
                "StorageBuffer" if (generics.len() == 1) => Result::Ok(ResolvedType::Slice(Box__new_(resolve_type_impl(env, &generics[0])?)))
                "Option" if (generics.len() == 1) => Result::Ok(ResolvedType::Option(Box__new_(resolve_type_impl(env, &generics[0])?)))
                "Result" if (generics.len() == 2) => Result::Ok(ResolvedType::Result(Box__new_(resolve_type_impl(env, &generics[0])?), Box__new_(resolve_type_impl(env, &generics[1])?)))
                _ =>
                    if ((name.len() == 1) && name.chars().next().map(fn(c): c.is_uppercase()).unwrap_or(false)):
                        Result::Ok(ResolvedType::Generic(name.clone()))
                    elif (name.starts_with("_") && (name.len() > 1)):
                        Result::Ok(ResolvedType::Generic(name.clone()))
                    else:
                        match env:
                            Some(env) =>
                                match env.lookup_type(name):
                                    Some(resolved) => Result::Ok(resolved.clone())
                                    _ => Result::Ok(ResolvedType::Struct(name.clone(), HashMap__new_()))
                            _ => Result::Ok(ResolvedType::Struct(name.clone(), HashMap__new_()))
        Type::Unit(_) => Result::Ok(ResolvedType__Unit)
        Type::Never(_) => Result::Ok(ResolvedType__Never)
        Type::Tuple(inner, _) => Result::Ok(ResolvedType::Tuple(inner.iter().map(fn(ty): resolve_type_impl(env, ty)).collect()?))
        Type::Array(inner, len, _) => Result::Ok(ResolvedType::Array(Box__new_(resolve_type_impl(env, inner)?), (*len)))
        Type::Slice(inner, _) => Result::Ok(ResolvedType::Slice(Box__new_(resolve_type_impl(env, inner)?)))
        Type::Option(inner, _) => Result::Ok(ResolvedType::Option(Box__new_(resolve_type_impl(env, inner)?)))
        Type::Result(ok, err, _) => Result::Ok(ResolvedType::Result(Box__new_(resolve_type_impl(env, ok)?), Box__new_(resolve_type_impl(env, err)?)))
        Type::Ref { mutable_: mutable_, inner: inner } => Result::Ok(ResolvedType::Ref { mutable_: (*mutable_), inner: Box__new_(resolve_type_impl(env, inner)?) })
        Type::Function { params: params, return_type: return_type, effects: effects } =>
            let resolved_params = params.iter().map(fn(ty): resolve_type_impl(env, ty)).collect()?
            let resolved_ret = resolve_type_impl(env, return_type)?
            Result::Ok(ResolvedType::Function { params: resolved_params, ret: Box__new_(resolved_ret), effects: EffectSet__from(effects.clone()) })
        Type::Ptr { mutable_: mutable_, inner: inner } => Result::Ok(ResolvedType::Ptr { mutable_: (*mutable_), inner: Box__new_(resolve_type_impl(env, inner)?) })
        Type::Impl { trait_name: trait_name, generics: generics } if (trait_name == "Future") =>
            let inner = (generics.first().map(fn(ty): resolve_type_impl(env, ty)).transpose()?).unwrap_or(ResolvedType__Unknown)
            Result::Ok(ResolvedType::Future(Box__new_(inner)))
        Type::Infer(_) => Result::Ok(ResolvedType__Unknown)
        _ => Result::Ok(ResolvedType__Unknown)

fn item_span(item: &Item) -> crate::span::Span:
    match item:
        Item::Function(f) => f.span.clone()
        Item::Struct(s) => s.span.clone()
        Item::Enum(e) => e.span.clone()
        Item::Component(c) => c.span.clone()
        Item::Shader(s) => s.span.clone()
        Item::Actor(a) => a.span.clone()
        Item::Comptime(b) => b.span.clone()
        Item::Const(c) => c.span.clone()
        Item::Macro(m) => m.span.clone()
        Item::Use(u) => u.span.clone()
        Item::Mod(m) => m.span.clone()
        Item::Impl(i) => i.span.clone()
        Item::Test(t) => t.span.clone()
        _ => Span__new_(0, 0)

impl From<Array<effects::Effect>> for EffectSet:
    fn from(v: Array<effects::Effect>) -> EffectSet:
        let mut s = EffectSet__new_()
        for e in v:
            s.effects.insert(e)
            ()
        ()
        s


fn function_signature(env: &TypeEnv, function: &Function, self_ty: Option<&ResolvedType>) -> Result<ResolvedType, KainError>:
    let mut params = Vec__new_()
    for param in &(*function).params:
        params.push(resolve_param_type(env, param, self_ty)?)
        ()
    ()
    let ret = ((*function).return_type.map(fn(ty): resolve_type_in_env(env, ty)).transpose()?).unwrap_or(ResolvedType__Unit)
    Result::Ok(ResolvedType::Function { params: params, ret: Box__new_(ret), effects: EffectSet__from((*function).effects.clone()) })

fn resolve_param_type(env: &TypeEnv, param: &Param, self_ty: Option<&ResolvedType>) -> Result<ResolvedType, KainError>:
    match (&(*param).ty, self_ty):
        (Type::Infer(_), Some(self_ty)) if ((*param).name == "self") => Result::Ok(self_ty.clone())
        _ => resolve_type_in_env(env, &(*param).ty)

fn infer_expr_type_with_expected(env: &mut TypeEnv, expr: &Expr, ctx: Option<&SemanticContext>, expected: Option<&ResolvedType>) -> Result<ResolvedType, KainError>:
    match expr:
        Expr::Paren(inner, _) => return infer_expr_type_with_expected(env, inner, ctx, expected)
        _ =>
            ()
            ()
    match (expr, expected):
        (Expr::Lambda { params: params, return_type: return_type, body: body, span: _ }, Some(ResolvedType::Function { params: expected_params, ret: expected_ret })) =>
            let annotated_ret = (return_type.map(fn(ty): resolve_type_in_env(env, ty)).transpose()?).unwrap_or(ResolvedType__Unknown)
            env.push_scope()
            ()
            let mut param_types = (fn(__kain_ctor_arg0): Vec__new_())(params.len())
            for selfhost_for_item in params.iter().enumerate():
                let (index, param) = selfhost_for_item
                let param_ty = resolve_param_type(env, param, none)?
                let inferred_ty = match (expected_params.get(index), param_ty):
                    (Some(expected_param_ty), ResolvedType::Unknown) => expected_param_ty.clone()
                    (Some(expected_param_ty), actual_ty) =>
                        ensure_type_compatible(env, expected_param_ty, &actual_ty, param.span, "lambda parameter")?
                        ()
                        actual_ty
                    (None, actual_ty) => actual_ty
                env.define(param.name.clone(), inferred_ty.clone())
                ()
                param_types.push(inferred_ty)
                ()
            ()
            let body_expected = if (none):
                Option::Some(expected_ret)
            else:
                Option::Some(&annotated_ret)
            let body_ty = infer_expr_type_with_expected(env, body, ctx, body_expected)?
            env.pop_scope()
            ()
            if (!none):
                ensure_type_compatible(env, &annotated_ret, &body_ty, body.span(), "lambda body")?
                ()
                ()
                ()
                ()
            else:
                ensure_type_compatible(env, expected_ret, &body_ty, body.span(), "lambda body")?
                ()
                ()
                ()
                ()
            let resolved_ret = if (none):
                if (none):
                    body_ty.clone()
                else:
                    expected_ret.clone()
            else:
                annotated_ret
            return Result::Ok(ResolvedType::Function { params: param_types, ret: Box__new_(resolved_ret), effects: EffectSet__new_() })
        _ =>
            ()
            ()
    let inferred = infer_expr_type(env, expr, ctx)?
    match expected:
        Some(expected_ty) =>
            if types_compatible(expected_ty, &inferred):
                return Result::Ok(inferred)
            match expected_ty:
                ResolvedType::Ref { mutable_: false, inner: inner } =>
                    if types_compatible(inner, &inferred):
                        return Result::Ok(expected_ty.clone())
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    Result::Ok(inferred)

fn check_block_semantics(env: &mut TypeEnv, block: &Block, ctx: &SemanticContext) -> Result<(), KainError>:
    for stmt in &(*block).stmts:
        check_stmt_semantics(env, stmt, ctx)?
        ()
    ()
    Result::Ok(())

fn block_value_type(env: &mut TypeEnv, block: &Block, ctx: &SemanticContext) -> Result<ResolvedType, KainError>:
    env.push_scope()
    ()
    let result = (fn(): none)()
    env.pop_scope()
    ()
    result

fn check_stmt_semantics(env: &mut TypeEnv, stmt: &Stmt, ctx: &SemanticContext) -> Result<(), KainError>:
    match stmt:
        Stmt::Let { pattern: pattern, ty: ty, value: value, span: span } =>
            let inferred = (value.map(fn(expr): infer_expr_type(env, expr, Option::Some(ctx))).transpose()?).unwrap_or(ResolvedType__Unknown)
            let declared = ty.map(fn(decl): resolve_type_in_env(env, decl)).transpose()?
            match &declared:
                Some(declared) =>
                    ensure_type_compatible(env, declared, &inferred, (*span), "let binding")?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            let binding_ty = declared.unwrap_or(inferred)
            bind_pattern_types(env, pattern, &binding_ty)?
            ()
            ()
            ()
            ()
        Stmt::Expr(expr) =>
            let _ = infer_expr_type(env, expr, Option::Some(ctx))?
            ()
        Stmt::Return(Some(expr), span) =>
            let expr_ty = infer_expr_type(env, expr, Option::Some(ctx))?
            ensure_type_compatible(env, &(*ctx).return_type, &expr_ty, (*span), "return value")?
            ()
            ()
            ()
            ()
        Stmt::Return(None, span) =>
            ensure_type_compatible(env, &(*ctx).return_type, &ResolvedType__Unit, (*span), "return")?
            ()
            ()
            ()
            ()
        Stmt::While { condition: condition, body: body } =>
            let cond_ty = infer_expr_type(env, condition, Option::Some(ctx))?
            ensure_type_compatible(env, &ResolvedType__Bool, &cond_ty, condition.span(), "while condition")?
            ()
            env.push_scope()
            ()
            check_block_semantics(env, body, ctx)?
            ()
            env.pop_scope()
            ()
            ()
            ()
            ()
        Stmt::For { binding: binding, iter: iter, body: body, span: span } =>
            let iter_ty = infer_expr_type(env, iter, Option::Some(ctx))?
            let item_ty = match iter_ty:
                ResolvedType::Array(inner, _) => (*inner)
                ResolvedType::Slice(inner) => (*inner)
                ResolvedType::Ref { mutable_: mutable_, inner: inner } =>
                    match (*inner):
                        ResolvedType::Array(item, _) => ResolvedType::Ref { mutable_: mutable_, inner: item }
                        ResolvedType::Slice(item) => ResolvedType::Ref { mutable_: mutable_, inner: item }
                        ResolvedType::String => ResolvedType::Ref { mutable_: mutable_, inner: Box__new_(ResolvedType__String) }
                        other => return Result::Err(env.type_error(f"for loop expects an iterable reference, found &{describe_type(&other)}", (*span)))
                ResolvedType::String => ResolvedType__String
                ResolvedType::Unknown => ResolvedType__Unknown
                other => return Result::Err(env.type_error(f"for loop expects an iterable value, found {describe_type(&other)}", (*span)))
            env.push_scope()
            ()
            bind_pattern_types(env, binding, &item_ty)?
            ()
            check_block_semantics(env, body, ctx)?
            ()
            env.pop_scope()
            ()
            ()
            ()
            ()
        Stmt::Loop { body: body } =>
            env.push_scope()
            ()
            check_block_semantics(env, body, ctx)?
            ()
            env.pop_scope()
            ()
            ()
            ()
            ()
        Stmt::Item(item) =>
            let _ = check_item(env, item)?
            ()
        Stmt::Break(_, _) => ()
        Stmt::Continue(_) => ()
    Result::Ok(())

fn infer_expr_type(env: &mut TypeEnv, expr: &Expr, ctx: Option<&SemanticContext>) -> Result<ResolvedType, KainError>:
    match expr:
        Expr::Int(_, span) => Some(Type::Named { name: "Int".to_string(), generics: Vec__new_(), span: span.clone() })
        Expr::Float(_, span) => Some(Type::Named { name: "Float".to_string(), generics: Vec__new_(), span: span.clone() })
        Expr::Bool(_, span) => Some(Type::Named { name: "Bool".to_string(), generics: Vec__new_(), span: span.clone() })
        Expr::Ident(name, _) => ctx.local_types.get(name).cloned()
        Expr::Field { object: object, field: field } =>
            let object_ty = infer_expr_type(object, ctx)?
            field_type_from_object(&object_ty, field, ctx)
        Expr::Index { object: object } => infer_element_type(object, ctx)
        Expr::Cast { target: target } => Some(target.clone())
        _ => none

fn infer_else_branch_type(env: &mut TypeEnv, else_branch: &ElseBranch, ctx: &SemanticContext) -> Result<ResolvedType, KainError>:
    match else_branch:
        ElseBranch::Else(block) => block_value_type(env, block, ctx)
        ElseBranch::ElseIf(cond, block, next) =>
            let cond_ty = infer_expr_type(env, cond, Option::Some(ctx))?
            ensure_type_compatible(env, &ResolvedType__Bool, &cond_ty, cond.span(), "else-if condition")?
            ()
            let current_ty = block_value_type(env, block, ctx)?
            let next_ty = match next:
                Some(next) => infer_else_branch_type(env, next, ctx)?
                _ => ResolvedType__Unit
            unify_types(&current_ty, &next_ty).ok_or_else(fn(): env.type_error(f"else-if branches do not agree on a type: {describe_type(&current_ty)} vs {describe_type(&next_ty)}", cond.span()))

fn infer_match_type(env: &mut TypeEnv, scrutinee: &Expr, arms: &[MatchArm], span: Span, ctx: Option<&SemanticContext>) -> Result<ResolvedType, KainError>:
    let scrutinee_ty = infer_expr_type(env, scrutinee, ctx)?
    let mut seen_catch_all = false
    let mut seen_literal_patterns = HashSet__new_()
    let mut result_ty: Option<ResolvedType> = none
    for arm in arms:
        if seen_catch_all:
            return Result::Err(env.type_error("Unreachable match arm after a catch-all pattern", arm.span))
        let is_catch_all = (none || none)
        if is_catch_all:
            seen_catch_all = true
            ()
            ()
            ()
            ()
        match &arm.pattern:
            Pattern::Literal(Expr::Bool(value, _)) =>
                let key = f"bool:{value}"
                if (!seen_literal_patterns.insert(key)):
                    return Result::Err(env.type_error("Duplicate boolean match arm", arm.span))
                ()
            _ =>
                ()
                ()
        env.push_scope()
        ()
        check_pattern_compatibility(env, &arm.pattern, &scrutinee_ty)?
        ()
        bind_pattern_types(env, &arm.pattern, &scrutinee_ty)?
        ()
        match &arm.guard:
            Some(guard) =>
                let guard_ty = infer_expr_type(env, guard, ctx)?
                ensure_type_compatible(env, &ResolvedType__Bool, &guard_ty, guard.span(), "match guard")?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let arm_ty = infer_expr_type(env, &arm.body, ctx)?
        env.pop_scope()
        ()
        result_ty = Option::Some(none)
        ()
    ()
    if result_ty.is_none():
        return Result::Err(env.type_error("match expression must have at least one arm", span))
    Result::Ok(result_ty.unwrap_or(ResolvedType__Unit))

fn infer_assignment_target_type(env: &mut TypeEnv, expr: &Expr, ctx: Option<&SemanticContext>) -> Result<ResolvedType, KainError>:
    match expr:
        Expr::Ident(_, _) => infer_expr_type(env, expr, ctx)
        Expr::Field {  } => infer_expr_type(env, expr, ctx)
        Expr::Index {  } => infer_expr_type(env, expr, ctx)
        Expr::Deref(_, _) => infer_expr_type(env, expr, ctx)
        other => Result::Err(env.type_error(f"Invalid assignment target: {other}", other.span()))

fn infer_array_type(env: &mut TypeEnv, values: &[Expr], ctx: Option<&SemanticContext>) -> Result<ResolvedType, KainError>:
    let mut element_ty = ResolvedType__Unknown
    for value in values:
        let value_ty = infer_expr_type(env, value, ctx)?
        element_ty = if none: value_ty else: unify_types(&element_ty, &value_ty).ok_or_else(fn(): env.type_error(f"Array elements do not agree on a type: {describe_type(&element_ty)} vs {describe_type(&value_ty)}", value.span()))?
        ()
    ()
    Result::Ok(ResolvedType::Array(Box__new_(element_ty), values.len()))

fn infer_method_call_type(env: &mut TypeEnv, ctx: Option<&SemanticContext>, receiver_ty: &ResolvedType, method: String, args: &[CallArg], span: Span) -> Result<ResolvedType, KainError>:
    if (method == "clone"):
        if args.is_empty():
            return Result::Ok(peel_shared_refs(receiver_ty).clone())
        return Result::Err(env.type_error(("clone expects no arguments").to_string(), span))
    match receiver_ty:
        ResolvedType::Ref { mutable_: mutable_, inner: inner } =>
            match inner:
                ResolvedType::Array(item_ty, _) =>
                    if (method == "as_slice"):
                        if args.is_empty():
                            return Result::Ok(ResolvedType::Ref { mutable_: (*mutable_), inner: Box__new_(ResolvedType::Slice(Box__new_(item_ty.clone()))) })
                        return Result::Err(env.type_error(("Array.as_slice expects no arguments").to_string(), span))
                    ()
                _ =>
                    ()
                    ()
            if ((none && (method == "push")) && (!(*mutable_))):
                return Result::Err(env.type_error(("Array.push requires a mutable receiver").to_string(), span))
            if ((none && (method == "take")) && (!(*mutable_))):
                return Result::Err(env.type_error(("Option.take requires a mutable receiver").to_string(), span))
            match inner:
                ResolvedType::Struct(name, _) => return infer_named_method_call_type(env, ctx, name, receiver_ty, method, args, span)
                ResolvedType::Enum(name, _) => return infer_named_method_call_type(env, ctx, name, receiver_ty, method, args, span)
                _ =>
                    ()
                    ()
            infer_method_call_type(env, ctx, inner, method, args, span)
        ResolvedType::Struct(name, _) => infer_named_method_call_type(env, ctx, name, receiver_ty, method, args, span)
        ResolvedType::Enum(name, _) => infer_named_method_call_type(env, ctx, name, receiver_ty, method, args, span)
        ResolvedType::Array(inner, _) =>
            match method:
                "len" => Result::Ok(ResolvedType::Int(IntSize__I64))
                "is_empty" => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error("Array.is_empty expects no arguments", span))
                "iter" => if args.is_empty(): Result::Ok(dynamic_array_type(shared_ref_type(inner.clone()))) else: Result::Err(env.type_error("Array.iter expects no arguments", span))
                "into_iter" => if args.is_empty(): Result::Ok(dynamic_array_type(inner.clone())) else: Result::Err(env.type_error("Array.into_iter expects no arguments", span))
                "peekable" => if args.is_empty(): Result::Ok(dynamic_array_type(inner.clone())) else: Result::Err(env.type_error("Array.peekable expects no arguments", span))
                "next" => if args.is_empty(): Result::Ok(ResolvedType::Option(Box__new_(inner.clone()))) else: Result::Err(env.type_error("Array.next expects no arguments", span))
                "peek" => if args.is_empty(): Result::Ok(ResolvedType::Option(Box__new_(shared_ref_type(inner.clone())))) else: Result::Err(env.type_error("Array.peek expects no arguments", span))
                "enumerate" => if args.is_empty(): Result::Ok(dynamic_array_type(ResolvedType::Tuple([ResolvedType::Int(IntSize__I64), inner.clone()]))) else: Result::Err(env.type_error("Array.enumerate expects no arguments", span))
                "push" =>
                    if (args.len() == 1):
                        let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(inner))?
                        ensure_type_compatible(env, inner, &arg_ty, span, "array push")?
                        ()
                        Result::Ok(ResolvedType__Unit)
                    else:
                        Result::Err(env.type_error("Array.push expects exactly one argument", span))
                "contains" =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("Array.contains expects exactly one argument", span))
                    let expected_borrowed = ResolvedType::Ref { mutable_: false, inner: Box__new_(inner.clone()) }
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&expected_borrowed))?
                    let stripped_arg_ty = peel_shared_refs(&arg_ty)
                    if (((!types_compatible(inner, &arg_ty)) && (!types_compatible(&expected_borrowed, &arg_ty))) && (!types_compatible(inner, stripped_arg_ty))):
                        return Result::Err(env.type_error(f"array contains expected {describe_type(inner)} or {describe_type(&expected_borrowed)}, found {describe_type(&arg_ty)}", args[0].span))
                    Result::Ok(ResolvedType__Bool)
                "binary_search" =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("Array.binary_search expects exactly one argument", span))
                    let expected_borrowed = ResolvedType::Ref { mutable_: false, inner: Box__new_(inner.clone()) }
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&expected_borrowed))?
                    let stripped_arg_ty = peel_shared_refs(&arg_ty)
                    if (((!types_compatible(inner, &arg_ty)) && (!types_compatible(&expected_borrowed, &arg_ty))) && (!types_compatible(inner, stripped_arg_ty))):
                        return Result::Err(env.type_error(f"array binary_search expected {describe_type(inner)} or {describe_type(&expected_borrowed)}, found {describe_type(&arg_ty)}", args[0].span))
                    Result::Ok(ResolvedType::Result(Box__new_(ResolvedType::Int(IntSize__I64)), Box__new_(ResolvedType::Int(IntSize__I64))))
                "map" => infer_builtin_transform_method(env, ctx, inner, args, span, fn(mapped): dynamic_array_type(mapped))
                "any" => infer_builtin_predicate_method(env, ctx, inner, args, span, "Array.any")
                "all" => infer_builtin_predicate_method(env, ctx, inner, args, span, "Array.all")
                "find" => infer_builtin_find_method(env, ctx, inner, args, span, "Array.find")
                "find_map" => infer_builtin_find_map_method(env, ctx, inner, args, span, "Array.find_map")
                "collect" => infer_builtin_collect_method(inner, args, span, env, "Array.collect")
                "join" => infer_builtin_join_method(env, ctx, inner, args, span, "Array.join")
                "first" => infer_builtin_first_method(inner, args, span, env, "Array.first")
                "last" => infer_builtin_first_method(inner, args, span, env, "Array.last")
                "pop" => if args.is_empty(): Result::Ok(ResolvedType::Option(Box__new_(inner.clone()))) else: Result::Err(env.type_error("Array.pop expects no arguments", span))
                "cloned" => infer_builtin_clone_adapter(inner, args, span, env, method)
                "copied" => infer_builtin_clone_adapter(inner, args, span, env, method)
                "zip" => infer_builtin_zip_method(env, ctx, inner, args, span, "Array.zip")
                "sum" => infer_builtin_sum_method(inner, args, span, env, "Array.sum")
                "max" => infer_builtin_max_method(inner, args, span, env, "Array.max")
                "as_slice" => if args.is_empty(): Result::Ok(ResolvedType::Slice(Box__new_(inner.clone()))) else: Result::Err(env.type_error("Array.as_slice expects no arguments", span))
                "get" => infer_index_lookup_method(env, ctx, inner, args, span, "Array.get")
                _ => Result::Err(env.type_error(f"Unknown method '{method}' on Array", span))
        ResolvedType::Slice(inner) =>
            match method:
                "len" => Result::Ok(ResolvedType::Int(IntSize__I64))
                "is_empty" => if args.is_empty(): Result::Ok(ResolvedType__Bool) else: Result::Err(env.type_error("Slice.is_empty expects no arguments", span))
                "iter" => if args.is_empty(): Result::Ok(dynamic_array_type(shared_ref_type(inner.clone()))) else: Result::Err(env.type_error("Slice.iter expects no arguments", span))
                "into_iter" => if args.is_empty(): Result::Ok(dynamic_array_type(inner.clone())) else: Result::Err(env.type_error("Slice.into_iter expects no arguments", span))
                "peekable" => if args.is_empty(): Result::Ok(dynamic_array_type(inner.clone())) else: Result::Err(env.type_error("Slice.peekable expects no arguments", span))
                "next" => if args.is_empty(): Result::Ok(ResolvedType::Option(Box__new_(inner.clone()))) else: Result::Err(env.type_error("Slice.next expects no arguments", span))
                "peek" => if args.is_empty(): Result::Ok(ResolvedType::Option(Box__new_(shared_ref_type(inner.clone())))) else: Result::Err(env.type_error("Slice.peek expects no arguments", span))
                "enumerate" => if args.is_empty(): Result::Ok(dynamic_array_type(ResolvedType::Tuple([ResolvedType::Int(IntSize__I64), inner.clone()]))) else: Result::Err(env.type_error("Slice.enumerate expects no arguments", span))
                "contains" =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("Slice.contains expects exactly one argument", span))
                    let expected_borrowed = ResolvedType::Ref { mutable_: false, inner: Box__new_(inner.clone()) }
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&expected_borrowed))?
                    let stripped_arg_ty = peel_shared_refs(&arg_ty)
                    if (((!types_compatible(inner, &arg_ty)) && (!types_compatible(&expected_borrowed, &arg_ty))) && (!types_compatible(inner, stripped_arg_ty))):
                        return Result::Err(env.type_error(f"slice contains expected {describe_type(inner)} or {describe_type(&expected_borrowed)}, found {describe_type(&arg_ty)}", args[0].span))
                    Result::Ok(ResolvedType__Bool)
                "binary_search" =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("Slice.binary_search expects exactly one argument", span))
                    let expected_borrowed = ResolvedType::Ref { mutable_: false, inner: Box__new_(inner.clone()) }
                    let arg_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&expected_borrowed))?
                    let stripped_arg_ty = peel_shared_refs(&arg_ty)
                    if (((!types_compatible(inner, &arg_ty)) && (!types_compatible(&expected_borrowed, &arg_ty))) && (!types_compatible(inner, stripped_arg_ty))):
                        return Result::Err(env.type_error(f"slice binary_search expected {describe_type(inner)} or {describe_type(&expected_borrowed)}, found {describe_type(&arg_ty)}", args[0].span))
                    Result::Ok(ResolvedType::Result(Box__new_(ResolvedType::Int(IntSize__I64)), Box__new_(ResolvedType::Int(IntSize__I64))))
                "map" => infer_builtin_transform_method(env, ctx, inner, args, span, fn(mapped): dynamic_array_type(mapped))
                "any" => infer_builtin_predicate_method(env, ctx, inner, args, span, "Slice.any")
                "all" => infer_builtin_predicate_method(env, ctx, inner, args, span, "Slice.all")
                "find" => infer_builtin_find_method(env, ctx, inner, args, span, "Slice.find")
                "find_map" => infer_builtin_find_map_method(env, ctx, inner, args, span, "Slice.find_map")
                "collect" => infer_builtin_collect_method(inner, args, span, env, "Slice.collect")
                "join" => infer_builtin_join_method(env, ctx, inner, args, span, "Slice.join")
                "first" => infer_builtin_first_method(inner, args, span, env, "Slice.first")
                "last" => infer_builtin_first_method(inner, args, span, env, "Slice.last")
                "cloned" => infer_builtin_clone_adapter(inner, args, span, env, method)
                "copied" => infer_builtin_clone_adapter(inner, args, span, env, method)
                "zip" => infer_builtin_zip_method(env, ctx, inner, args, span, "Slice.zip")
                "sum" => infer_builtin_sum_method(inner, args, span, env, "Slice.sum")
                "max" => infer_builtin_max_method(inner, args, span, env, "Slice.max")
                "get" => infer_index_lookup_method(env, ctx, inner, args, span, "Slice.get")
                _ => Result::Err(env.type_error(f"Unknown method '{method}' on Slice", span))
        ResolvedType::Option(inner) =>
            match method:
                "map" => infer_builtin_transform_method(env, ctx, inner, args, span, fn(mapped): ResolvedType::Option(Box__new_(mapped)))
                "take" => if args.is_empty(): Result::Ok(ResolvedType::Option(inner.clone())) else: Result::Err(env.type_error("Option.take expects no arguments", span))
                "unwrap_or" =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("Option.unwrap_or expects exactly one argument", span))
                    let default_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(inner))?
                    ensure_type_compatible(env, inner, &default_ty, args[0].span, "option default")?
                    ()
                    Result::Ok(inner.clone())
                "and_then" => infer_builtin_option_chain_method(env, ctx, inner, args, span)
                "filter" => infer_builtin_option_filter_method(env, ctx, inner, args, span)
                "or_else" => infer_builtin_nullary_callback_method(env, ctx, args, span, "Option.or_else", fn(mapped): ensure_option_return_type(mapped, inner))
                "cloned" => infer_builtin_option_clone_adapter(inner, args, span, env, method)
                "copied" => infer_builtin_option_clone_adapter(inner, args, span, env, method)
                "or" =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("Option.or expects exactly one argument", span))
                    let fallback_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&ResolvedType::Option(inner.clone())))?
                    ensure_type_compatible(env, &ResolvedType::Option(inner.clone()), &fallback_ty, args[0].span, "option fallback")?
                    ()
                    Result::Ok(ResolvedType::Option(inner.clone()))
                "or_" =>
                    if (args.len() != 1):
                        return Result::Err(env.type_error("Option.or expects exactly one argument", span))
                    let fallback_ty = infer_expr_type_with_expected(env, &args[0].value, ctx, Option::Some(&ResolvedType::Option(inner.clone())))?
                    ensure_type_compatible(env, &ResolvedType::Option(inner.clone()), &fallback_ty, args[0].span, "option fallback")?
                    ()
                    Result::Ok(ResolvedType::Option(inner.clone()))
                "unwrap" =>
