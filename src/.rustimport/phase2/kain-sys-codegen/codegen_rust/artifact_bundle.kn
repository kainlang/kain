use crate::codegen_rust::gpu_artifacts::RustGpuArtifactOutput

use crate::codegen_rust::collect_gpu_artifacts

use crate::codegen_rust::collect_gpu_artifacts_json

use crate::codegen_rust::generate

use crate::codegen_rust::generate_gpu_host_wrappers

use kain_core::error::KainResult

use kain_core::types::TypedProgram

use serde::Deserialize

use serde::Serialize

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RustArtifactBundle:
    primary: RustTextArtifact
    supplemental: Array<RustTextArtifact>
    shader_metadata: Option<RustGpuArtifactOutput>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RustTextArtifact:
    logical_name: String
    suggested_file_name: String
    kind: RustArtifactKind
    contents: String

pub enum RustArtifactKind:
    PrimarySource
    ShaderHost
    ShaderReflection

pub fn generate_rust_artifact_bundle(program: &kain_core::types::TypedProgram) -> Result<RustArtifactBundle, KainError>:
    let primary_source = codegen_rust__generate(program)?
    let shader_metadata = codegen_rust__collect_gpu_artifacts(program)
    let shader_support = if shader_metadata.shaders.is_empty():
        none
    else:
        Option::Some(shader_metadata)
    let mut supplemental = Vec__new_()
    match &shader_support:
        Some(shader_metadata) =>
            let shader_host = codegen_rust__generate_gpu_host_wrappers(program)?
            let shader_reflection = codegen_rust__collect_gpu_artifacts_json(program).map_err(fn(err): KainError__runtime(f"Failed to serialize Rust shader reflection bundle: {err}"))?
            supplemental.push(RustTextArtifact { logical_name: ("shader_host").to_string(), suggested_file_name: ("kain_gpu.rs").to_string(), kind: RustArtifactKind__ShaderHost, contents: shader_host })
            ()
            supplemental.push(RustTextArtifact { logical_name: ("shader_reflection").to_string(), suggested_file_name: ("kain_gpu.reflect.json").to_string(), kind: RustArtifactKind__ShaderReflection, contents: shader_reflection })
            ()
            return Result::Ok(RustArtifactBundle { primary: RustTextArtifact { logical_name: ("rust_source").to_string(), suggested_file_name: ("lib.rs").to_string(), kind: RustArtifactKind__PrimarySource, contents: primary_source }, supplemental: supplemental, shader_metadata: Option::Some(shader_metadata.clone()) })
        _ =>
            ()
            ()
    Result::Ok(RustArtifactBundle { primary: RustTextArtifact { logical_name: ("rust_source").to_string(), suggested_file_name: ("lib.rs").to_string(), kind: RustArtifactKind__PrimarySource, contents: primary_source }, supplemental: supplemental, shader_metadata: none })

