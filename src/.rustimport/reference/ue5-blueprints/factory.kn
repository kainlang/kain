use crate::ir::BlueprintDef

use crate::ir::ComponentDef

use crate::ir::EventGraphNode

use crate::ir::KismetCall

use crate::ir::PropertyDef

use crate::ir::PropertyValue

pub struct BlueprintFactoryGenerator:
    __selfhost_placeholder: Bool = false

impl BlueprintFactoryGenerator:
    pub fn generate_header(bp: &BlueprintDef) -> String:
        let class_name = factory_class_name(&(*bp).name)
        "#pragma once\n\n#include \"CoreMinimal.h\"\n#include \"Modules/ModuleManager.h\"\n#include \"Kismet2/KismetEditorUtilities.h\"\n#include \"Kismet2/BlueprintEditorUtils.h\"\n#include \"Engine/SimpleConstructionScript.h\"\n#include \"Engine/SCS_Node.h\"\n\n/**\n * KAIN-generated Blueprint factory for {(*bp).name}\n * Parent class: {(*bp).parent_class}\n * Generated by: ue5-blueprints crate\n *\n * DO NOT EDIT — regenerate via `kain build --ue5`\n */\nclass {class_name}\n{\npublic:\n    /** Create and register the {(*bp).name} Blueprint asset. Call from module StartupModule(). */\n    static void Create(UObject* Outer = nullptr);\n\nprivate:\n    static void SetupComponents(UBlueprint* Blueprint);\n    static void SetupDefaults(UBlueprint* Blueprint);\n    static void SetupEventGraph(UBlueprint* Blueprint);\n};\n"

    pub fn generate_source(bp: &BlueprintDef) -> String:
        let class_name = factory_class_name(&(*bp).name)
        let package_path = &(*bp).package_path
        let bp_name = &(*bp).name
        let parent_class = parent_cpp_class(&(*bp).parent_class)
        let component_setup = BlueprintFactoryGenerator__generate_component_setup(&(*bp).components)
        let defaults_setup = BlueprintFactoryGenerator__generate_defaults_setup(&(*bp).defaults, "BlueprintCDO")
        let event_graph_setup = BlueprintFactoryGenerator__generate_event_graph(&(*bp).event_graph)
        "#include \"{class_name}.h\"\n#include \"AssetRegistry/AssetRegistryModule.h\"\n#include \"UObject/Package.h\"\n#include \"UObject/SavePackage.h\"\n#include \"EdGraph/EdGraph.h\"\n#include \"K2Node_Event.h\"\n#include \"K2Node_CallFunction.h\"\n#include \"EdGraphSchema_K2.h\"\n\nvoid {class_name}::Create(UObject* Outer)\n{\n    // ── Package ───────────────────────────────────────────────────────────────\n    const FString PackagePath = TEXT(\"{package_path}/{bp_name}\");\n    UPackage* Package = CreatePackage(*PackagePath);\n    Package->FullyLoad();\n\n    // Skip if already exists\n    if (UBlueprint* Existing = Cast<UBlueprint>(\n            StaticFindObject(UBlueprint::StaticClass(), Package, TEXT(\"{bp_name}\"))))\n    {\n        return;\n    }\n\n    // ── Blueprint ─────────────────────────────────────────────────────────────\n    UBlueprint* Blueprint = FKismetEditorUtilities::CreateBlueprint(\n        {parent_class}::StaticClass(),\n        Package,\n        FName(TEXT(\"{bp_name}\")),\n        BPTYPE_Normal,\n        UBlueprint::StaticClass(),\n        UBlueprintGeneratedClass::StaticClass()\n    );\n\n    if (!Blueprint)\n    {\n        UE_LOG(LogTemp, Error, TEXT(\"KAIN: Failed to create Blueprint {bp_name}\"));\n        return;\n    }\n\n    // ── Components, Defaults, Event Graph ────────────────────────────────────\n    SetupComponents(Blueprint);\n    SetupDefaults(Blueprint);\n    SetupEventGraph(Blueprint);\n\n    // ── Compile & Save ────────────────────────────────────────────────────────\n    FKismetEditorUtilities::CompileBlueprint(Blueprint);\n\n    Package->MarkPackageDirty();\n    FAssetRegistryModule::AssetCreated(Blueprint);\n\n    FSavePackageArgs SaveArgs;\n    SaveArgs.TopLevelFlags = RF_Public | RF_Standalone;\n    UPackage::SavePackage(Package, Blueprint,\n        *(PackagePath + TEXT(\".uasset\")), SaveArgs);\n\n    UE_LOG(LogTemp, Log, TEXT(\"KAIN: Created Blueprint %s\"), TEXT(\"{bp_name}\"));\n}\n\n{component_setup}\n\n{defaults_setup}\n\n{event_graph_setup}\n"

    fn generate_component_setup(components: &[ComponentDef]) -> String:
        if components.is_empty():
            return "void PLACEHOLDER::SetupComponents(UBlueprint* Blueprint) { /* no components */ }"
        let mut lines = Vec__new_()
        lines.push(("    USimpleConstructionScript* SCS = Blueprint->SimpleConstructionScript;").to_string())
        ()
        lines.push(("    if (!SCS) return;").to_string())
        ()
        lines.push(String__new_())
        ()
        for selfhost_for_item in components.iter().enumerate():
            let (i, comp) = selfhost_for_item
            let node_var = f"Node_{i}"
            let class_name = &comp.class_name
            let var_name = &comp.variable_name
            lines.push(f"    // Component: {var_name} ({class_name})")
            ()
            lines.push(f"    USCS_Node* {node_var} = SCS->CreateNodeWithoutOwner(U{class_name}::StaticClass(), FName(TEXT(\"{var_name}\")));")
            ()
            match &comp.attach_parent:
                Some(parent) =>
                    lines.push(f"    // Attach {var_name} to parent: {parent}")
                    ()
                    lines.push("    { USCS_Node* ParentNode = SCS->FindSCSNode(FName(TEXT(\"{parent}\"))); if (ParentNode) ParentNode->ChildNodes.Add({node_var}); }")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    lines.push(f"    SCS->AddNode({node_var});")
                    ()
                    ()
                    ()
                    ()
            if (!comp.defaults.is_empty()):
                lines.push(f"    U{class_name}* {node_var}_CDO = Cast<U{class_name}>({node_var}->ComponentTemplate);")
                ()
                lines.push(f"    if ({node_var}_CDO)")
                ()
                lines.push(("    {").to_string())
                ()
                for prop in &comp.defaults:
                    match property_setter(prop, &f"{node_var}_CDO"):
                        Some(setter) =>
                            lines.push(f"        {setter}")
                            ()
                        _ => ()
                ()
                lines.push(("    }").to_string())
                ()
                ()
                ()
                ()
            lines.push(String__new_())
            ()
        ()
        "void PLACEHOLDER::SetupComponents(UBlueprint* Blueprint)\n{\n{lines.join(\"\\n\")}\n}"

    fn generate_defaults_setup(defaults: &[PropertyDef], cdo_var: String) -> String:
        if defaults.is_empty():
            return "void PLACEHOLDER::SetupDefaults(UBlueprint* Blueprint) { /* no defaults */ }"
        let mut lines = Vec__new_()
        lines.push(f"    auto* {cdo_var} = Cast<AActor>(Blueprint->GeneratedClass->GetDefaultObject(true));")
        ()
        lines.push(f"    if (!{cdo_var}) return;")
        ()
        lines.push(String__new_())
        ()
        for prop in defaults:
            match property_setter(prop, cdo_var):
                Some(setter) =>
                    lines.push(f"    {setter}")
                    ()
                _ => ()
        ()
        "void PLACEHOLDER::SetupDefaults(UBlueprint* Blueprint)\n{\n{lines.join(\"\\n\")}\n}"

    fn generate_event_graph(events: &[EventGraphNode]) -> String:
        if events.is_empty():
            return "void PLACEHOLDER::SetupEventGraph(UBlueprint* Blueprint) { /* no event graph */ }"
        let mut lines = Vec__new_()
        lines.push(("    UEdGraph* EventGraph = FBlueprintEditorUtils::FindEventGraph(Blueprint);").to_string())
        ()
        lines.push(("    if (!EventGraph) return;").to_string())
        ()
        lines.push(String__new_())
        ()
        for selfhost_for_item in events.iter().enumerate():
            let (i, event) = selfhost_for_item
            match event:
                EventGraphNode::BeginPlay { calls: calls } =>
                    lines.push(f"    // Event BeginPlay (node group {i})")
                    ()
                    lines.push(("    {").to_string())
                    ()
                    lines.push(("        UK2Node_Event* EventNode = NewObject<UK2Node_Event>(EventGraph);").to_string())
                    ()
                    lines.push(("        EventNode->EventReference.SetExternalMember(FName(\"ReceiveBeginPlay\"), AActor::StaticClass());").to_string())
                    ()
                    lines.push(("        EventNode->bOverrideFunction = true;").to_string())
                    ()
                    lines.push(("        EventGraph->AddNode(EventNode, false, false);").to_string())
                    ()
                    lines.push(generate_call_chain(calls, "EventNode"))
                    ()
                    lines.push(("    }").to_string())
                    ()
                    ()
                    ()
                    ()
                EventGraphNode::Tick { calls: calls } =>
                    lines.push(f"    // Event Tick (node group {i})")
                    ()
                    lines.push(("    {").to_string())
                    ()
                    lines.push(("        UK2Node_Event* TickNode = NewObject<UK2Node_Event>(EventGraph);").to_string())
                    ()
                    lines.push(("        TickNode->EventReference.SetExternalMember(FName(\"ReceiveTick\"), AActor::StaticClass());").to_string())
                    ()
                    lines.push(("        TickNode->bOverrideFunction = true;").to_string())
                    ()
                    lines.push(("        EventGraph->AddNode(TickNode, false, false);").to_string())
                    ()
                    lines.push(generate_call_chain(calls, "TickNode"))
                    ()
                    lines.push(("    }").to_string())
                    ()
                    ()
                    ()
                    ()
                EventGraphNode::CustomEvent { event_name: event_name, calls: calls } =>
                    lines.push(f"    // Custom Event: {event_name} (node group {i})")
                    ()
                    lines.push(("    {").to_string())
                    ()
                    lines.push(("        UK2Node_CustomEvent* CustomNode = NewObject<UK2Node_CustomEvent>(EventGraph);").to_string())
                    ()
                    lines.push(f"        CustomNode->CustomFunctionName = FName(TEXT(\"{event_name}\"));")
                    ()
                    lines.push(("        EventGraph->AddNode(CustomNode, false, false);").to_string())
                    ()
                    lines.push(generate_call_chain(calls, "CustomNode"))
                    ()
                    lines.push(("    }").to_string())
                    ()
                    ()
                    ()
                    ()
            lines.push(String__new_())
            ()
        ()
        lines.push(("    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);").to_string())
        ()
        "void PLACEHOLDER::SetupEventGraph(UBlueprint* Blueprint)\n{\n{lines.join(\"\\n\")}\n}"


fn factory_class_name(bp_name: String) -> String:
    f"F{bp_name}Factory"

@doc(doc = " Extract the C++ class name from a script path like \"/Script/MyPlugin.APlayerBase\"")
fn parent_cpp_class(parent_class: String) -> String:
    parent_class.split(".").last().unwrap_or(parent_class)

@doc(doc = " Generate a C++ setter expression for a property")
fn property_setter(prop: &PropertyDef, obj: String) -> Option<String>:
    match &(*prop).value:
        PropertyValue::Bool(v) => Option::Some(f"{obj}->{(*prop).name}  = {v};")
        PropertyValue::Int(v) => Option::Some(f"{obj}->{(*prop).name}  = {v};")
        PropertyValue::Float(v) => Option::Some(f"{obj}->{(*prop).name}  = {v}f;")
        PropertyValue::Double(v) => Option::Some(f"{obj}->{(*prop).name}  = {v};")
        PropertyValue::Str(v) => Option::Some(f"{obj}->{(*prop).name}  = TEXT(\"{v}\");")
        PropertyValue::Name(v) => Option::Some(f"{obj}->{(*prop).name}  = FName(TEXT(\"{v}\"));")
        PropertyValue::SoftObject(path) => Option::Some(f"{obj}->{(*prop).name}  = FSoftObjectPath(TEXT(\"{path}\"));")
        PropertyValue::Vector { x: x, y: y, z: z } => Option::Some(f"{obj}->{(*prop).name}  = FVector({x}f, {y}f, {z}f);")
        PropertyValue::Rotator { pitch: pitch, yaw: yaw, roll: roll } => Option::Some(f"{obj}->{(*prop).name}  = FRotator({pitch}f, {yaw}f, {roll}f);")
        PropertyValue::LinearColor { r: r, g: g, b: b, a: a } => Option::Some(f"{obj}->{(*prop).name}  = FLinearColor({r}f, {g}f, {b}f, {a}f);")
        PropertyValue::Enum { enum_type: enum_type, value: value } => Option::Some(f"{obj}->{(*prop).name}  = {enum_type}::{value};")
        PropertyValue::Text(v) => Option::Some(f"{obj}->{(*prop).name}  = FText::FromString(TEXT(\"{v}\"));")
        _ => none

@doc(doc = " Generate a chain of UK2Node_CallFunction nodes connected by exec pins")
fn generate_call_chain(calls: &[KismetCall], entry_node: String) -> String:
    if calls.is_empty():
        return String__new_()
    let mut lines = Vec__new_()
    lines.push(f"        UEdGraphPin* PrevThen = {entry_node}->FindPin(UEdGraphSchema_K2::PN_Then);")
    ()
    for selfhost_for_item in calls.iter().enumerate():
        let (i, call) = selfhost_for_item
        let node_var = f"CallNode_{i}"
        lines.push(f"        UK2Node_CallFunction* {node_var} = NewObject<UK2Node_CallFunction>(EventGraph);")
        ()
        lines.push(f"        {node_var}->FunctionReference.SetExternalMember(FName(TEXT(\"{call.function_name}\")), Blueprint->GeneratedClass);")
        ()
        lines.push(f"        EventGraph->AddNode({node_var}, false, false);")
        ()
        lines.push(f"        if (PrevThen) PrevThen->MakeLinkTo({node_var}->FindPin(UEdGraphSchema_K2::PN_Execute));")
        ()
        lines.push(f"        PrevThen = {node_var}->FindPin(UEdGraphSchema_K2::PN_Then);")
        ()
    ()
    lines.join("\n")

