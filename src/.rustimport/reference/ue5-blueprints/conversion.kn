use crate::error::Result

use crate::ir::BlueprintDef

use crate::ir::ComponentDef

use crate::ir::EventGraphNode

use crate::ir::KismetCall

use crate::ir::PropertyDef

use crate::ir::PropertyValue

use kain_core::ast

const PARENT_CLASS_MAP: Array<(String, String)> = [("actor", "/Script/Engine.Actor"), ("pawn", "/Script/Engine.Pawn"), ("character", "/Script/Engine.Character"), ("gamemode", "/Script/Engine.GameModeBase"), ("gamestate", "/Script/Engine.GameStateBase"), ("playercontroller", "/Script/Engine.PlayerController"), ("hud", "/Script/Engine.HUD"), ("playerstate", "/Script/Engine.PlayerState")]

const DEFAULT_PARENT_CLASS: String = "/Script/Engine.Actor"

@doc(doc = " Convert a KAIN AST Actor to a BlueprintDef IR.")
pub fn from_ast(actor_: &kain_core::ast::Actor) -> Result<BlueprintDef, Error>:
    let name = f"BP_{actor_.name}"
    let package_path = f"/Game/Blueprints/{name}"
    let parent_class = resolve_parent_class(&actor_.attributes)
    let mut bp = BlueprintDef__new_(&name, &package_path, &parent_class)
    for state_ in &actor_.state_:
        let is_component = state_.attributes.iter().any(fn(attr): (attr.name == "component"))
        if is_component:
            let var_name = &state_.name
            let class_name = extract_type_name(&state_.ty).unwrap_or_else(fn(): ("SceneComponent").to_string())
            let mut comp_def = ComponentDef__new_(class_name, var_name)
            match extract_struct_defaults(&state_.initial):
                Some(defaults) =>
                    for prop in defaults:
                        comp_def = comp_def.with_default(prop)
                        ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match state_.attributes.iter().find(fn(a): (a.name == "attach")):
                Some(attach_attr) =>
                    match attach_attr.args.first():
                        Some(first_arg) =>
                            match first_arg:
                                kain_core__ast__Expr::String(parent_name, _) =>
                                    comp_def = comp_def.with_parent(parent_name)
                                    ()
                                    ()
                                    ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            bp = bp.add_component(comp_def)
            ()
        else:
            match convert_property(state_):
                Some(prop) =>
                    bp = bp.add_default(prop)
                    ()
                _ => ()
    ()
    for handler in &actor_.handlers:
        let calls = convert_block_to_calls(&handler.body)?
        let event = match handler.message_type.as_str():
            "init" => EventGraphNode__begin_play(calls)
            "begin_play" => EventGraphNode__begin_play(calls)
            "tick" => EventGraphNode__tick(calls)
            name => EventGraphNode__custom(name, calls)
        bp = bp.add_event(event)
        ()
    ()
    Result::Ok(bp)

@doc(doc = " Resolve parent class from actor attributes.")
@doc(doc = "")
@doc(doc = " Checks for `@parent(\"...\")` or `@extends(\"...\")`. The value can be:")
@doc(doc = "   - A full path: `\"/Script/Engine.Character\"` → used as-is")
@doc(doc = "   - A short name: `\"Character\"` → looked up in PARENT_CLASS_MAP")
@doc(doc = "   - Missing → defaults to AActor")
fn resolve_parent_class(attributes: &[kain_core::ast::Attribute]) -> String:
    for attr in attributes:
        if ((attr.name == "parent") || (attr.name == "extends")):
            match attr.args.first():
                Some(kain_core__ast__Expr::String(value, _)) =>
                    if value.contains("/"):
                        return value.clone()
                    let lower = value.to_lowercase()
                    match PARENT_CLASS_MAP.iter().find(fn(__kain_closure_arg0): ((*__kain_closure_arg0.__kain_tuple_0) == lower.as_str())):
                        Some((_, path)) => return path.to_string()
                        _ =>
                            ()
                            ()
                    return f"/Script/Engine.{value}"
                _ => ()
    ()
    DEFAULT_PARENT_CLASS.to_string()

fn extract_type_name(ty: &kain_core::ast::Type) -> Option<String>:
    match ty:
        kain_core__ast__Type::Named { name: name } => Option::Some(name.clone())
        _ => none

@doc(doc = " Convert a KAIN state declaration into a PropertyDef.")
@doc(doc = " Handles: Float, Int, Bool, String, Vec3, struct literals, and type-hinted enums.")
fn convert_property(state_: &kain_core::ast::StateDecl) -> Option<PropertyDef>:
    convert_expr_to_property(&(*state_).name, &(*state_).initial, Option::Some(&(*state_).ty))

@doc(doc = " Convert an AST expression to a PropertyDef with optional type hint.")
fn convert_expr_to_property(name: String, expr: &kain_core::ast::Expr, _ty_hint: Option<&kain_core::ast::Type>) -> Option<PropertyDef>:
    match expr:
        kain_core__ast__Expr::Float(v, _) => Option::Some(PropertyDef__float_(name, (*v) as f32))
        kain_core__ast__Expr::Int(v, _) => Option::Some(PropertyDef__int_(name, (*v) as i32))
        kain_core__ast__Expr::Bool(v, _) => Option::Some(PropertyDef__bool_(name, (*v)))
        kain_core__ast__Expr::String(v, _) => if (v.starts_with("/Game/") || v.starts_with("/Script/")): Option::Some(PropertyDef__soft_object(name, v)) else: Option::Some(PropertyDef__str(name, v))
        kain_core__ast__Expr::Call { callee: callee, args: args } =>
            match &(*(*callee)):
                kain_core__ast__Expr::Ident(func_name, _) =>
                    match func_name.as_str():
                        "vec3" if (args.len() == 3) =>
                            let x = eval_float(&args[0].value).unwrap_or(0)
                            let y = eval_float(&args[1].value).unwrap_or(0)
                            let z = eval_float(&args[2].value).unwrap_or(0)
                            Option::Some(PropertyDef__vector(name, x, y, z))
                        "rotator" if (args.len() == 3) =>
                            let p = eval_float(&args[0].value).unwrap_or(0)
                            let y = eval_float(&args[1].value).unwrap_or(0)
                            let r = eval_float(&args[2].value).unwrap_or(0)
                            Option::Some(PropertyDef__rotator(name, p, y, r))
                        "color" if (args.len() >= 3) =>
                            let r = eval_float(&args[0].value).unwrap_or(0)
                            let g = eval_float(&args[1].value).unwrap_or(0)
                            let b = eval_float(&args[2].value).unwrap_or(0)
                            let a = if (args.len() >= 4):
                                eval_float(&args[3].value).unwrap_or(1)
                            else:
                                1
                            Option::Some(PropertyDef__color(name, r, g, b, a))
                        "linear_color" if (args.len() >= 3) =>
                            let r = eval_float(&args[0].value).unwrap_or(0)
                            let g = eval_float(&args[1].value).unwrap_or(0)
                            let b = eval_float(&args[2].value).unwrap_or(0)
                            let a = if (args.len() >= 4):
                                eval_float(&args[3].value).unwrap_or(1)
                            else:
                                1
                            Option::Some(PropertyDef__color(name, r, g, b, a))
                        _ => none
                _ =>
                    none
        kain_core__ast__Expr::EnumVariant { enum_name: enum_name, variant: variant } => Option::Some(PropertyDef__enum_val(name, enum_name, variant))
        kain_core__ast__Expr::Struct { name: struct_name, fields: fields } =>
            let inner: Array<PropertyDef> = fields.iter().filter_map(fn(__kain_closure_arg1): convert_expr_to_property(__kain_closure_arg1.__kain_tuple_0, __kain_closure_arg1.__kain_tuple_1, none)).collect()
            Option::Some(PropertyDef { name: name.to_string(), value: PropertyValue::Struct { struct_type: struct_name.clone(), fields: inner } })
        _ => none

@doc(doc = " Extract struct-literal field defaults from an initializer expression.")
@doc(doc = " e.g. `{ static_mesh: \"/Game/...\", cast_shadow: true }` → Vec<PropertyDef>")
fn extract_struct_defaults(expr: &kain_core::ast::Expr) -> Option<Array<PropertyDef>>:
    match expr:
        kain_core__ast__Expr::Struct { fields: fields } =>
            let props: Array<PropertyDef> = fields.iter().filter_map(fn(__kain_closure_arg2): convert_expr_to_property(__kain_closure_arg2.__kain_tuple_0, __kain_closure_arg2.__kain_tuple_1, none)).collect()
            if props.is_empty():
                none
            else:
                Option::Some(props)
        _ => none

@doc(doc = " Check if a type hint matches a given name (case-insensitive).")
@allow(dead_code)
fn matches_type_name(ty: Option<&kain_core::ast::Type>, expected: String) -> Bool:
    match ty:
        Some(kain_core__ast__Type::Named { name: name }) => name.eq_ignore_ascii_case(expected)
        _ => false

@doc(doc = " Evaluate a simple numeric expression to f32.")
fn eval_float(expr: &kain_core::ast::Expr) -> Option<f32>:
    match expr:
        kain_core__ast__Expr::Float(v, _) => Option::Some((*v) as f32)
        kain_core__ast__Expr::Int(v, _) => Option::Some((*v) as f32)
        kain_core__ast__Expr::Unary { op: kain_core__ast__UnaryOp::Neg, operand: operand } => eval_float(operand).map(fn(v): (-v))
        _ => none

@doc(doc = " Convert a block of statements into a linear chain of Kismet calls.")
fn convert_block_to_calls(block: &kain_core::ast::Block) -> Result<Array<KismetCall>, Error>:
    let mut calls = Vec__new_()
    for stmt in &(*block).stmts:
        match stmt:
            kain_core__ast__Stmt::Expr(expr) =>
                match expr:
                    kain_core__ast__Expr::Call { callee: callee } =>
                        match &(*(*callee)):
                            kain_core__ast__Expr::Ident(func_name, _) =>
                                calls.push(KismetCall__function(func_name))
                                ()
                            _ => ()
                    _ =>
                        match expr:
                            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method } =>
                                match &(*(*receiver)):
                                    kain_core__ast__Expr::Ident(target_name, _) =>
                                        calls.push(KismetCall__function(method).on(target_name))
                                        ()
                                    _ => ()
                            _ => ()
            _ => ()
    ()
    Result::Ok(calls)

