pub struct BlueprintBinaryWriter:
    __selfhost_placeholder: Bool = false

impl BlueprintBinaryWriter:
    pub fn write(bp: &BlueprintDef) -> Result<Array<u8>, Error>:
        let engine_version = (*bp).engine_version.as_serializer_version()
        let mut ctx = BlueprintBuildContext__new_(&(*bp).name, &(*bp).parent_class, engine_version)?
        let mut comp_class_imports: Array<unreal_asset::types::PackageIndex> = Vec__new_()
        for comp in &(*bp).components:
            let idx = ctx.add_component_class_import(&comp.class_name)
            comp_class_imports.push(idx)
            ()
        ()
        if (!(*bp).components.is_empty()):
            ctx.add_scs_exports(&(*bp).components, &comp_class_imports)
            ()
            ()
            ()
            ()
        ctx.add_event_graph(&(*bp).name, &(*bp).event_graph)
        ()
        ctx.finalize_blueprint_export(bp)
        ()
        ctx.set_cdo_defaults(&(*bp).defaults)
        ()
        ctx.build()

    pub fn check_support(_bp: &BlueprintDef) -> Result<(), Error>:
        Result::Ok(())


struct BlueprintBuildContext:
    asset: unreal_asset::Asset<std::io::Cursor<Array<u8>>>
    engine_import: unreal_asset::types::PackageIndex
    coreuobject_import: unreal_asset::types::PackageIndex
    blueprint_class_import: unreal_asset::types::PackageIndex
    bp_gen_class_import: unreal_asset::types::PackageIndex
    scs_class_import: unreal_asset::types::PackageIndex
    scs_node_class_import: unreal_asset::types::PackageIndex
    parent_class_import: unreal_asset::types::PackageIndex
    function_class_import: unreal_asset::types::PackageIndex
    blueprint_export: unreal_asset::types::PackageIndex
    bp_gen_class_export: unreal_asset::types::PackageIndex
    cdo_export: unreal_asset::types::PackageIndex
    scs_export: Option<unreal_asset::types::PackageIndex>
    scs_node_exports: Array<unreal_asset::types::PackageIndex>
    comp_template_exports: Array<unreal_asset::types::PackageIndex>
    function_exports: Array<unreal_asset::types::PackageIndex>

impl BlueprintBuildContext:
    fn new_(name: String, parent_class: String, engine_version: unreal_asset::engine_version::EngineVersion) -> Result<BlueprintBuildContext, Error>:
        let mut asset = Asset__new_empty(engine_version)
        let coreuobject_pkg_name = asset.add_fname("/Script/CoreUObject")
        let package_fname = asset.add_fname("Package")
        asset.imports.push(unreal_asset::Import { class_package: coreuobject_pkg_name.clone(), class_name: package_fname.clone(), outer_index: PackageIndex__new_(0), object_name: coreuobject_pkg_name.clone(), optional: false })
        ()
        let coreuobject_import = PackageIndex__new_((-(asset.imports.len() as i32)))
        let engine_pkg_name = asset.add_fname("/Script/Engine")
        asset.imports.push(unreal_asset::Import { class_package: coreuobject_pkg_name.clone(), class_name: package_fname.clone(), outer_index: PackageIndex__new_(0), object_name: engine_pkg_name.clone(), optional: false })
        ()
        let engine_import = PackageIndex__new_((-(asset.imports.len() as i32)))
        let class_fname = asset.add_fname("Class")
        let add_class_import = fn(asset: &mut unreal_asset::Asset<std::io::Cursor<Array<u8>>>, class_name: String, outer: unreal_asset::types::PackageIndex) -> unreal_asset::types::PackageIndex: none
        let blueprint_class_import = add_class_import(&mut asset, "Blueprint", engine_import)
        let bp_gen_class_import = add_class_import(&mut asset, "BlueprintGeneratedClass", engine_import)
        let scs_class_import = add_class_import(&mut asset, "SimpleConstructionScript", engine_import)
        let scs_node_class_import = add_class_import(&mut asset, "SCS_Node", engine_import)
        let function_class_import = add_class_import(&mut asset, "Function", coreuobject_import)
        let (parent_pkg_path, parent_class_name) = ImportBuilder__parse_class_path(parent_class)
        let parent_pkg_import = if (parent_pkg_path == "/Script/Engine"):
            engine_import
        else:
            let ppkg = asset.add_fname(&parent_pkg_path)
            asset.imports.push(unreal_asset::Import { class_package: coreuobject_pkg_name.clone(), class_name: package_fname.clone(), outer_index: PackageIndex__new_(0), object_name: ppkg, optional: false })
            ()
            PackageIndex__new_((-(asset.imports.len() as i32)))
        let parent_class_import = add_class_import(&mut asset, &parent_class_name, parent_pkg_import)
        let bp_obj_name = asset.add_fname(name)
        let bp_export = unreal_asset::exports::normal_export::NormalExport { base_export: unreal_asset::exports::base_export::BaseExport { class_index: blueprint_class_import, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: PackageIndex__new_(0), object_name: bp_obj_name, object_flags: (unreal_asset__flags__EObjectFlags__RF_PUBLIC | unreal_asset__flags__EObjectFlags__RF_STANDALONE), ..Default__default_() }, extras: Vec__new_(), properties: Vec__new_() }
        asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(bp_export))
        ()
        let blueprint_export = PackageIndex__new_(asset.asset_data.exports.len() as i32)
        let gen_class_name = asset.add_fname(&f"{name}_C")
        let engine_fname = asset.add_fname("Engine")
        let gen_class_export_data = unreal_asset::exports::class_export::ClassExport { struct_export: unreal_asset::exports::struct_export::StructExport { normal_export: unreal_asset::exports::normal_export::NormalExport { base_export: unreal_asset::exports::base_export::BaseExport { class_index: bp_gen_class_import, super_index: parent_class_import, template_index: PackageIndex__new_(0), outer_index: PackageIndex__new_(0), object_name: gen_class_name, object_flags: (unreal_asset__flags__EObjectFlags__RF_PUBLIC | unreal_asset__flags__EObjectFlags__RF_STANDALONE), ..Default__default_() }, extras: Vec__new_(), properties: Vec__new_() }, field: Default__default_(), super_struct: parent_class_import, children: Vec__new_(), loaded_properties: Vec__new_(), script_bytecode: Option::Some(Vec__new_()), script_bytecode_size: 0, script_bytecode_raw: none }, func_map: IndexedMap__new_(), class_flags: unreal_asset__flags__EClassFlags__CLASS_NONE, class_within: PackageIndex__new_(0), class_config_name: engine_fname, interfaces: Vec__new_(), class_generated_by: PackageIndex__new_(0), deprecated_force_script_order: false, cooked: Option::Some(true), class_default_object: PackageIndex__new_(0) }
        asset.asset_data.exports.push(unreal_asset__exports__Export::ClassExport(gen_class_export_data))
        ()
        let bp_gen_class_export = PackageIndex__new_(asset.asset_data.exports.len() as i32)
        let cdo_name = asset.add_fname(&f"Default__{name}")
        let cdo_export_data = unreal_asset::exports::normal_export::NormalExport { base_export: unreal_asset::exports::base_export::BaseExport { class_index: bp_gen_class_export, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: PackageIndex__new_(0), object_name: cdo_name, object_flags: (((unreal_asset__flags__EObjectFlags__RF_PUBLIC | unreal_asset__flags__EObjectFlags__RF_STANDALONE) | unreal_asset__flags__EObjectFlags__RF_ARCHETYPE_OBJECT) | unreal_asset__flags__EObjectFlags__RF_DEFAULT_SUB_OBJECT), ..Default__default_() }, extras: Vec__new_(), properties: Vec__new_() }
        asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(cdo_export_data))
        ()
        let cdo_export = PackageIndex__new_(asset.asset_data.exports.len() as i32)
        Result::Ok(BlueprintBuildContext { asset: asset, engine_import: engine_import, coreuobject_import: coreuobject_import, blueprint_class_import: blueprint_class_import, bp_gen_class_import: bp_gen_class_import, scs_class_import: scs_class_import, scs_node_class_import: scs_node_class_import, parent_class_import: parent_class_import, function_class_import: function_class_import, blueprint_export: blueprint_export, bp_gen_class_export: bp_gen_class_export, cdo_export: cdo_export, scs_export: none, scs_node_exports: Vec__new_(), comp_template_exports: Vec__new_(), function_exports: Vec__new_() })

    fn add_component_class_import(_self: &mut BlueprintBuildContext, class_name: String) -> unreal_asset::types::PackageIndex:
        let coreuobject_pkg = (*_self).asset.add_fname("/Script/CoreUObject")
        let class_fname = (*_self).asset.add_fname("Class")
        let engine_pkg = (*_self).asset.add_fname("/Script/Engine")
        let package_fname = (*_self).asset.add_fname("Package")
        let engine_pkg_idx = ImportBuilder__find_import_by_name(&(*_self).asset, "/Script/Engine").unwrap_or_else(fn(): none)
        let comp_class_name = (*_self).asset.add_fname(class_name)
        (*_self).asset.imports.push(unreal_asset::Import { class_package: coreuobject_pkg, class_name: class_fname, outer_index: engine_pkg_idx, object_name: comp_class_name, optional: false })
        ()
        PackageIndex__new_((-((*_self).asset.imports.len() as i32)))

    fn add_scs_exports(_self: &mut BlueprintBuildContext, components: &[ComponentDef], comp_class_imports: &[unreal_asset::types::PackageIndex]):
        let scs_name = (*_self).asset.add_fname("SimpleConstructionScript")
        let scs_export_data = unreal_asset::exports::normal_export::NormalExport { base_export: unreal_asset::exports::base_export::BaseExport { class_index: (*_self).scs_class_import, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: (*_self).blueprint_export, object_name: scs_name, object_flags: unreal_asset__flags__EObjectFlags__RF_DEFAULT_SUB_OBJECT, ..Default__default_() }, extras: Vec__new_(), properties: Vec__new_() }
        (*_self).asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(scs_export_data))
        ()
        let scs_idx = PackageIndex__new_((*_self).asset.asset_data.exports.len() as i32)
        (*_self).scs_export = Option::Some(scs_idx)
        ()
        for selfhost_for_item in components.iter().enumerate():
            let (i, comp) = selfhost_for_item
            let node_name = (*_self).asset.add_fname(&f"SCS_Node_{i}")
            let scs_node_export = unreal_asset::exports::normal_export::NormalExport { base_export: unreal_asset::exports::base_export::BaseExport { class_index: (*_self).scs_node_class_import, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: scs_idx, object_name: node_name, object_flags: unreal_asset__flags__EObjectFlags__RF_DEFAULT_SUB_OBJECT, ..Default__default_() }, extras: Vec__new_(), properties: Vec__new_() }
            (*_self).asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(scs_node_export))
            ()
            let scs_node_idx = PackageIndex__new_((*_self).asset.asset_data.exports.len() as i32)
            (*_self).scs_node_exports.push(scs_node_idx)
            ()
            let template_name = (*_self).asset.add_fname(&comp.variable_name)
            let comp_template_export = unreal_asset::exports::normal_export::NormalExport { base_export: unreal_asset::exports::base_export::BaseExport { class_index: comp_class_imports[i], super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: (*_self).cdo_export, object_name: template_name, object_flags: unreal_asset__flags__EObjectFlags__RF_DEFAULT_SUB_OBJECT, ..Default__default_() }, extras: Vec__new_(), properties: Vec__new_() }
            (*_self).asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(comp_template_export))
            ()
            let comp_template_idx = PackageIndex__new_((*_self).asset.asset_data.exports.len() as i32)
            (*_self).comp_template_exports.push(comp_template_idx)
            ()
            let mut node_props: Array<unreal_asset_properties::Property> = Vec__new_()
            let cc_name = (*_self).asset.add_fname("ComponentClass")
            node_props.push((unreal_asset_properties::object_property::ObjectProperty { name: cc_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: comp_class_imports[i] }).into())
            ()
            let ct_name = (*_self).asset.add_fname("ComponentTemplate")
            node_props.push((unreal_asset_properties::object_property::ObjectProperty { name: ct_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: comp_template_idx }).into())
            ()
            let ivn_name = (*_self).asset.add_fname("InternalVariableName")
            let var_fname = (*_self).asset.add_fname(&comp.variable_name)
            node_props.push((unreal_asset_properties::str_property::NameProperty { name: ivn_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: var_fname }).into())
            ()
            let scs_node_export_idx = ((scs_node_idx.index - 1)) as usize
            match (*_self).asset.asset_data.exports[scs_node_export_idx].get_normal_export_mut():
                Some(normal) =>
                    normal.properties = node_props
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            if (!comp.defaults.is_empty()):
                let comp_props = ue5_asset_utils__property_converter__convert_property_defs(&mut (*_self).asset, &comp.defaults)
                let comp_export_idx = ((comp_template_idx.index - 1)) as usize
                match (*_self).asset.asset_data.exports[comp_export_idx].get_normal_export_mut():
                    Some(normal) =>
                        normal.properties = comp_props
                        ()
                    _ => ()
        ()
        let all_nodes_name = (*_self).asset.add_fname("AllNodes")
        let obj_prop_type = (*_self).asset.add_fname("ObjectProperty")
        let node_refs: Array<unreal_asset_properties::Property> = (*_self).scs_node_exports.iter().map(fn(__kain_closure_arg0): (unreal_asset_properties::object_property::ObjectProperty { name: all_nodes_name.clone(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: *__kain_closure_arg0 }).into()).collect()
        let all_nodes_prop = unreal_asset_properties::array_property::ArrayProperty { name: all_nodes_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, array_type: Option::Some(obj_prop_type), value: node_refs, dummy_property: none }
        let root_nodes_name = (*_self).asset.add_fname("RootNodes")
        let obj_prop_type2 = (*_self).asset.add_fname("ObjectProperty")
        let root_refs: Array<unreal_asset_properties::Property> = components.iter().enumerate().filter(fn(__kain_closure_arg1): __kain_closure_arg1.__kain_tuple_1.attach_parent.is_none()).map(fn(__kain_closure_arg2): (unreal_asset_properties::object_property::ObjectProperty { name: root_nodes_name.clone(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: (*_self).scs_node_exports[__kain_closure_arg2.__kain_tuple_0] }).into()).collect()
        let root_nodes_prop = unreal_asset_properties::array_property::ArrayProperty { name: root_nodes_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, array_type: Option::Some(obj_prop_type2), value: root_refs, dummy_property: none }
        let scs_export_idx = ((scs_idx.index - 1)) as usize
        match (*_self).asset.asset_data.exports[scs_export_idx].get_normal_export_mut():
            Some(normal) =>
                normal.properties = [all_nodes_prop.into(), root_nodes_prop.into()]
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        for selfhost_for_item in components.iter().enumerate():
            let (i, comp) = selfhost_for_item
            match comp.attach_parent:
                Some(parent_name) =>
                    match components.iter().position(fn(c): (c.variable_name == (*parent_name))):
                        Some(parent_idx) =>
                            let child_nodes_name = (*_self).asset.add_fname("ChildNodes")
                            let obj_type = (*_self).asset.add_fname("ObjectProperty")
                            let child_ref = unreal_asset_properties::object_property::ObjectProperty { name: child_nodes_name.clone(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: (*_self).scs_node_exports[i] }
                            let child_arr = unreal_asset_properties::array_property::ArrayProperty { name: child_nodes_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, array_type: Option::Some(obj_type), value: [child_ref.into()], dummy_property: none }
                            let parent_export_idx = (((*_self).scs_node_exports[parent_idx].index - 1)) as usize
                            match (*_self).asset.asset_data.exports[parent_export_idx].get_normal_export_mut():
                                Some(normal) =>
                                    normal.properties.push(child_arr.into())
                                    ()
                                _ => ()
                        _ => ()
                _ => ()

    fn add_event_graph(_self: &mut BlueprintBuildContext, bp_name: String, events: &[ir::EventGraphNode]):
        if events.is_empty():
            return
        let emit_result = match kismet__emit_event_graph(&mut (*_self).asset, bp_name, events, (*_self).bp_gen_class_export, (*_self).function_class_import):
            Some(r) => r
            None => return
        for func_export in emit_result.function_exports:
            (*_self).asset.asset_data.exports.push(func_export)
            ()
            let idx = PackageIndex__new_((*_self).asset.asset_data.exports.len() as i32)
            (*_self).function_exports.push(idx)
            ()

    fn finalize_blueprint_export(_self: &mut BlueprintBuildContext, _bp: &BlueprintDef):
        let mut props: Array<unreal_asset_properties::Property> = Vec__new_()
        let parent_name = (*_self).asset.add_fname("ParentClass")
        props.push((unreal_asset_properties::object_property::ObjectProperty { name: parent_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: (*_self).parent_class_import }).into())
        ()
        let gen_class_name = (*_self).asset.add_fname("GeneratedClass")
        props.push((unreal_asset_properties::object_property::ObjectProperty { name: gen_class_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: (*_self).bp_gen_class_export }).into())
        ()
        match (*_self).scs_export:
            Some(scs_idx) =>
                let scs_prop_name = (*_self).asset.add_fname("SimpleConstructionScript")
                props.push((unreal_asset_properties::object_property::ObjectProperty { name: scs_prop_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: scs_idx }).into())
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let bsv_name = (*_self).asset.add_fname("BlueprintSystemVersion")
        props.push((unreal_asset_properties::int_property::IntProperty { name: bsv_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: 2 }).into())
        ()
        let bp_idx = (((*_self).blueprint_export.index - 1)) as usize
        match (*_self).asset.asset_data.exports[bp_idx].get_normal_export_mut():
            Some(normal) =>
                normal.properties = props
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let gen_idx = (((*_self).bp_gen_class_export.index - 1)) as usize
        let mut func_map = IndexedMap__new_()
        let mut children: Array<unreal_asset::types::PackageIndex> = Vec__new_()
        for func_idx in &(*_self).function_exports:
            children.push(func_idx)
            ()
            let export_arr_idx = ((func_idx.index - 1)) as usize
            let fname = (*_self).asset.asset_data.exports[export_arr_idx].get_base_export().object_name.clone()
            func_map.insert(fname, func_idx)
            ()
        ()
        let mut gen_class_props: Array<unreal_asset_properties::Property> = Vec__new_()
        if (!(*_self).function_exports.is_empty()):
            let uber_name = (*_self).asset.add_fname("UberGraphFunction")
            gen_class_props.push((unreal_asset_properties::object_property::ObjectProperty { name: uber_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: (*_self).function_exports[0] }).into())
            ()
            ()
            ()
            ()
        match (*_self).asset.asset_data.exports[gen_idx]:
            unreal_asset__exports__Export::ClassExport(mut class_exp) =>
                class_exp.class_default_object = (*_self).cdo_export
                ()
                class_exp.func_map = func_map
                ()
                class_exp.struct_export.children = children
                ()
                class_exp.struct_export.normal_export.properties = gen_class_props
                ()
            _ => ()

    fn set_cdo_defaults(_self: &mut BlueprintBuildContext, defaults: &[ue5_asset_utils::PropertyDef]):
        if defaults.is_empty():
            return
        let props = ue5_asset_utils__property_converter__convert_property_defs(&mut (*_self).asset, defaults)
        let cdo_idx = (((*_self).cdo_export.index - 1)) as usize
        match (*_self).asset.asset_data.exports[cdo_idx].get_normal_export_mut():
            Some(normal) =>
                normal.properties = props
                ()
            _ => ()

    fn build(_self: BlueprintBuildContext) -> Result<Array<u8>, Error>:
        _self.asset.rebuild_name_map()
        ()
        let mut output = Cursor__new_(Vec__new_())
        _self.asset.write_data(&mut output, none).map_err(fn(e): BlueprintError::AssetWrite(f"Failed to write .uasset: {e}"))?
        ()
        Result::Ok(output.into_inner())


