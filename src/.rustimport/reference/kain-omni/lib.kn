pub enum OmniError:
    Io(io::Error)
    Toml(toml::de::Error)
    TomlSer(toml::ser::Error)
    Compiler(String)
    Config(String)
    ImportResolution(String)
    SourceGeneration(String)

pub type OmniResult<T> = Result<T, OmniError>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct OmniManifest:
    project: OmniProject
    imports: Array<OmniImportSource>
    targets: Array<OmniTarget>
    import_resolution: OmniImportResolution

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct OmniProject:
    entry: std::path::PathBuf
    build_dir: std::path::PathBuf

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, Default)
pub struct OmniImportResolution:
    search_roots: Array<std::path::PathBuf>
    inline_kain_imports: Bool

impl Default for OmniImportResolution:
    pub fn default_() -> OmniImportResolution:
        OmniImportResolution { search_roots: Vec__new_(), inline_kain_imports: false }


pub enum OmniSourceLanguage:
    Kain
    Rust
    TypeScript
    C
    Asm

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct OmniImportSource:
    path: std::path::PathBuf
    language: OmniSourceLanguage
    output: Option<std::path::PathBuf>
    flat: Bool
    recursive: Bool
    include_filters: Array<String>
    exclude_filters: Array<String>
    fail_fast: Bool
    include_paths: Array<String>
    defines: Array<String>
    asm_format: Option<String>

pub enum OmniTargetKind:
    Rust
    Js
    Ts
    Ks
    Cpp
    Hlsl
    Usf
    Spirv
    GpuArtifacts
    RustBundle
    Ue5
    Ue5Editor

pub enum OmniRustArtifact:
    Source
    ShaderHost
    ShaderReflection
    Spirv

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct OmniRustBundleConfig:
    output: Option<std::path::PathBuf>
    artifacts: Array<OmniRustArtifact>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct OmniTarget:
    kind: OmniTargetKind
    output: std::path::PathBuf
    rust_bundle: Option<OmniRustBundleConfig>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct OmniBuildResult:
    manifest_path: std::path::PathBuf
    staged_imports: Array<StagedImport>
    resolved_entry: std::path::PathBuf
    written_outputs: Array<std::path::PathBuf>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct StagedImport:
    source_path: std::path::PathBuf
    language: OmniSourceLanguage
    generated_kn_path: std::path::PathBuf

impl Default for OmniManifest:
    fn default_() -> OmniManifest:
        OmniManifest { project: OmniProject__default_(), imports: Vec__new_(), targets: [OmniTarget { kind: OmniTargetKind__Rust, output: PathBuf__from("omni_out/main.rs"), rust_bundle: none }], import_resolution: OmniImportResolution__default_() }


impl Default for OmniProject:
    fn default_() -> OmniProject:
        OmniProject { entry: PathBuf__from("src/main.kn"), build_dir: default_build_dir() }


impl Default for OmniRustBundleConfig:
    fn default_() -> OmniRustBundleConfig:
        OmniRustBundleConfig { output: none, artifacts: default_rust_bundle_artifacts() }


pub fn init_manifest(root: &std::path::Path) -> OmniResult<std::path::PathBuf>:
    std__fs__create_dir_all(root)?
    ()
    let manifest_path = root.join("KAIN.omni.toml")
    let manifest = OmniManifest__default_()
    std__fs__write(&manifest_path, toml__to_string_pretty(&manifest)?)?
    ()
    Result::Ok(manifest_path)

pub fn load_manifest(path: &std::path::Path) -> OmniResult<OmniManifest>:
    let content = std__fs__read_to_string(path)?
    Result::Ok(toml__from_str(&content)?)

pub fn build_manifest_path(path: &std::path::Path) -> OmniResult<OmniBuildResult>:
    let manifest = load_manifest(path)?
    let manifest_root = path.parent().map(Path__to_path_buf).unwrap_or_else(fn(): PathBuf__from("."))
    build(&manifest_root, &manifest, Option::Some(path))

pub fn build(project_root: &std::path::Path, manifest: &OmniManifest, manifest_path: Option<&std::path::Path>) -> OmniResult<OmniBuildResult>:
    let build_root = resolve_from_root(project_root, &(*manifest).project.build_dir)
    let staged_dir = build_root.join("staged_imports")
    let resolved_dir = build_root.join("resolved")
    std__fs__create_dir_all(&staged_dir)?
    ()
    std__fs__create_dir_all(&resolved_dir)?
    ()
    let staged_imports = stage_imports(project_root, &staged_dir, &(*manifest).imports)?
    let entry_path = resolve_from_root(project_root, &(*manifest).project.entry)
    let resolved_source = if (*manifest).import_resolution.inline_kain_imports:
        resolve_kain_program(&entry_path, &build_search_roots(project_root, &staged_imports, &(*manifest).import_resolution))?
    else:
        std__fs__read_to_string(&entry_path)?
    let resolved_entry = resolved_dir.join(entry_path.file_name().unwrap_or_else(fn(): OsStr__new_("entry.kn")))
    std__fs__write(&resolved_entry, &resolved_source)?
    ()
    let mut written_outputs = Vec__new_()
    for target in &(*manifest).targets:
        let output = resolve_from_root(project_root, &target.output)
        match output.parent():
            Some(parent) =>
                std__fs__create_dir_all(parent)?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let mut outputs = build_target(&resolved_source, &resolved_entry, &output, target)?
        written_outputs.append(&mut outputs)
        ()
    ()
    Result::Ok(OmniBuildResult { manifest_path: manifest_path.map(Path__to_path_buf).unwrap_or_else(fn(): project_root.join("KAIN.omni.toml")), staged_imports: staged_imports, resolved_entry: resolved_entry, written_outputs: written_outputs })

fn default_build_dir() -> std::path::PathBuf:
    PathBuf__from("omni_out")

fn default_inline_imports() -> Bool:
    true

fn default_rust_bundle_artifacts() -> Array<OmniRustArtifact>:
    [OmniRustArtifact__Source, OmniRustArtifact__ShaderHost, OmniRustArtifact__ShaderReflection, OmniRustArtifact__Spirv]

fn stage_imports(project_root: &std::path::Path, staged_dir: &std::path::Path, imports: &[OmniImportSource]) -> OmniResult<Array<StagedImport>>:
    let mut staged = Vec__new_()
    for import in imports:
        let source_path = resolve_from_root(project_root, &import.path)
        let generated_kn_path = import.output.map(fn(path): resolve_from_root(project_root, path)).unwrap_or_else(fn(): staged_dir.join(default_generated_name(&source_path)))
        match generated_kn_path.parent():
            Some(parent) =>
                std__fs__create_dir_all(parent)?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match import.language:
            OmniSourceLanguage::Kain =>
                std__fs__copy(&source_path, &generated_kn_path)?
                ()
                ()
                ()
                ()
            OmniSourceLanguage::Rust =>
                let program = import_rust_path(&source_path, import)?
                std__fs__write(&generated_kn_path, render_program(&program)?)?
                ()
                ()
                ()
                ()
            OmniSourceLanguage::TypeScript =>
                let program = import_typescript_path(&source_path, import)?
                std__fs__write(&generated_kn_path, render_program(&program)?)?
                ()
                ()
                ()
                ()
                return Result::Err(OmniError::Config(("TypeScript imports are disabled in this kain-omni build").to_string()))
            OmniSourceLanguage::C =>
                let program = import_c_path(&source_path, import)?
                std__fs__write(&generated_kn_path, render_program(&program)?)?
                ()
                ()
                ()
                ()
            OmniSourceLanguage::Asm =>
                kain_asm__import_asm(&source_path, import.asm_format.unwrap_or("6502-furby"), Option::Some(generated_kn_path.as_path()), false).map_err(fn(err): OmniError::Compiler(err.to_string()))?
                ()
                ()
                ()
                ()
        staged.push(StagedImport { source_path: source_path, language: import.language.clone(), generated_kn_path: generated_kn_path })
        ()
    ()
    Result::Ok(staged)

fn import_rust_path(path: &std::path::Path, config: &OmniImportSource) -> OmniResult<kain_core::ast::Program>:
    if path.is_file():
        return kain_import__rust__import_rust_file(path).map_err(fn(err): OmniError::Compiler(err.to_string()))
    let files = collect_language_files(path, config, &["rs"])?
    import_many_as_program(&files, (*config).flat, fn(file): kain_import__rust__import_rust_file(file).map_err(fn(err): OmniError::Compiler(err.to_string())))

@cfg(feature = "typescript-import")
fn import_typescript_path(path: &std::path::Path, config: &OmniImportSource) -> OmniResult<kain_core::ast::Program>:
    if path.is_file():
        return kain_import__typescript__import_typescript_file(path).map_err(fn(err): OmniError::Compiler(err.to_string()))
    let files = collect_language_files(path, config, &["ts", "tsx", "mts", "cts"])?
    import_many_as_program(&files, (*config).flat, fn(file): kain_import__typescript__import_typescript_file(file).map_err(fn(err): OmniError::Compiler(err.to_string())))

fn import_c_path(path: &std::path::Path, config: &OmniImportSource) -> OmniResult<kain_core::ast::Program>:
    let options = kain_import::c::CImportOptions { include_paths: (*config).include_paths.clone(), defines: (*config).defines.clone(), cpp_options: Vec__new_(), cpp_command: none }
    if path.is_file():
        return kain_import__c__import_c_file_with_options(path, &options).map_err(fn(err): OmniError::Compiler(err.to_string()))
    let files = collect_language_files(path, config, &["c", "h"])?
    import_many_as_program(&files, (*config).flat, fn(file): kain_import__c__import_c_file_with_options(file, &options).map_err(fn(err): OmniError::Compiler(err.to_string())))

fn collect_language_files(root: &std::path::Path, config: &OmniImportSource, allowed_extensions: &[String]) -> OmniResult<Array<std::path::PathBuf>>:
    let mut files = Vec__new_()
    collect_language_files_into(root, root, config, allowed_extensions, &mut files)?
    ()
    files.sort()
    ()
    Result::Ok(files)

fn collect_language_files_into(root: &std::path::Path, current: &std::path::Path, config: &OmniImportSource, allowed_extensions: &[String], files: &mut Array<std::path::PathBuf>) -> OmniResult<()>:
    for entry in (std__fs__read_dir(current)?):
        let entry = entry?
        let path = entry.path()
        if path.is_dir():
            if (*config).recursive:
                collect_language_files_into(root, &path, config, allowed_extensions, files)?
                ()
                ()
                ()
                ()
            continue
        let Some(ext) = path.extension().and_then(fn(value): value.to_str())
        if (!allowed_extensions.iter().any(fn(allowed): ext.eq_ignore_ascii_case(allowed))):
            continue
        let relative = path.strip_prefix(root).unwrap_or(&path).to_string_lossy().replace("\\", "/").to_ascii_lowercase()
        if ((!(*config).include_filters.is_empty()) && (!(*config).include_filters.iter().any(fn(filter): relative.contains(&filter.to_ascii_lowercase())))):
            continue
        if (*config).exclude_filters.iter().any(fn(filter): relative.contains(&filter.to_ascii_lowercase())):
            continue
        files.push(path)
        ()
    ()
    Result::Ok(())

fn import_many_as_program<F>(files: &[std::path::PathBuf], flat: Bool, importer: F) -> OmniResult<kain_core::ast::Program>:
    let span = Span__default_()
    let mut items = Vec__new_()
    for file in files:
        let program = importer(file)?
        if flat:
            items.extend(program.items)
            ()
        else:
            items.push(kain_core__ast__Item::Mod(kain_core::ast::Mod { name: sanitize_module_name(file), inline_: Option::Some(program.items), visibility: kain_core__ast__Visibility__Public, span: span }))
            ()
    ()
    Result::Ok(kain_core::ast::Program { items: items, span: span })

fn sanitize_module_name(path: &std::path::Path) -> String:
    let raw = path.file_stem().and_then(fn(value): value.to_str()).unwrap_or("module")
    let mut name = raw.chars().map(fn(ch): if (ch.is_ascii_alphanumeric() || (ch == "_")): ch else: "_").collect()
    if name.is_empty():
        name.push_str("module")
        ()
        ()
        ()
        ()
    if name.chars().next().is_some_and(fn(ch): ch.is_ascii_digit()):
        name.insert(0, "m")
        ()
        name.insert(1, "_")
        ()
        ()
        ()
        ()
    name

fn default_generated_name(path: &std::path::Path) -> std::path::PathBuf:
    let stem = path.file_stem().and_then(fn(value): value.to_str()).unwrap_or("imported")
    PathBuf__from(f"{stem}.kn")

fn render_program(program: &kain_core::ast::Program) -> OmniResult<String>:
    let mut output = String__new_()
    for item in &(*program).items:
        write_item(&mut output, item, 0)?
        ()
    ()
    Result::Ok(output)

fn write_item(output: String, item: &kain_core::ast::Item, indent: usize) -> OmniResult<()>:
    use std::fmt::Write

    match item:
        kain_core__ast__Item::Function(function) => write_function(output, function, indent)
        kain_core__ast__Item::Struct(value) => write_struct(output, value, indent)
        kain_core__ast__Item::Enum(value) => write_enum(output, value, indent)
        kain_core__ast__Item::Mod(value) =>
            write_line(output, indent, &f"mod {value.name}:")?
            ()
            match &value.inline_:
                Some(children) =>
                    if children.is_empty():
                        write_line(output, (indent + 1), "pass")?
                        ()
                        ()
                        ()
                        ()
                    else:
                        for child in children:
                            write_item(output, child, (indent + 1))?
                            ()
                        ()
                        ()
                    ()
                _ =>
                    write_line(output, (indent + 1), "pass")?
                    ()
                    ()
                    ()
                    ()
            __kain_writeln_fmt!(output, "").map_err(fn(err): OmniError::SourceGeneration(err.to_string()))?
            ()
            Result::Ok(())
        kain_core__ast__Item::TypeAlias(value) =>
            write_line(output, indent, &f"type {value.name} = {type_to_string(&value.target)}")?
            ()
            __kain_writeln_fmt!(output, "").map_err(fn(err): OmniError::SourceGeneration(err.to_string()))?
            ()
            Result::Ok(())
        kain_core__ast__Item::Const(value) =>
            write_line(output, indent, &f"const {value.name}: {type_to_string(&value.ty)} = {expr_to_string(&value.value)}")?
            ()
            __kain_writeln_fmt!(output, "").map_err(fn(err): OmniError::SourceGeneration(err.to_string()))?
            ()
            Result::Ok(())
        kain_core__ast__Item::Impl(value) => write_impl(output, value, indent)
        _ => Result::Ok(())

fn write_function(output: String, function: &kain_core::ast::Function, indent: usize) -> OmniResult<()>:
    use std::fmt::Write

    let mut signature = f"fn {(*function).name}("
    for selfhost_for_item in (*function).params.iter().enumerate():
        let (index, param) = selfhost_for_item
        if (index > 0):
            signature.push_str(", ")
            ()
            ()
            ()
            ()
        signature.push_str(&f"{param.name}: {type_to_string(&param.ty)}")
        ()
    ()
    signature.push(")")
    ()
    match &(*function).return_type:
        Some(return_type) =>
            signature.push_str(&f" -> {type_to_string(return_type)}")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    signature.push(":")
    ()
    write_line(output, indent, &signature)?
    ()
    write_block(output, &(*function).body, (indent + 1))?
    ()
    __kain_writeln_fmt!(output, "").map_err(fn(err): OmniError::SourceGeneration(err.to_string()))?
    ()
    Result::Ok(())

fn write_struct(output: String, value: &kain_core::ast::Struct, indent: usize) -> OmniResult<()>:
    use std::fmt::Write

    write_line(output, indent, &f"struct {(*value).name}:")?
    ()
    if (*value).fields.is_empty():
        write_line(output, (indent + 1), "pass")?
        ()
        ()
        ()
        ()
    else:
        for field in &(*value).fields:
            let mut line_ = f"{field.name}: {type_to_string(&field.ty)}"
            match &field.default_:
                Some(default_) =>
                    line_.push_str(&f" = {expr_to_string(default_)}")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            write_line(output, (indent + 1), &line_)?
            ()
        ()
        ()
    __kain_writeln_fmt!(output, "").map_err(fn(err): OmniError::SourceGeneration(err.to_string()))?
    ()
    Result::Ok(())

fn write_enum(output: String, value: &kain_core::ast::Enum, indent: usize) -> OmniResult<()>:
    use std::fmt::Write

    write_line(output, indent, &f"enum {(*value).name}:")?
    ()
    if (*value).variants.is_empty():
        write_line(output, (indent + 1), "pass")?
        ()
        ()
        ()
        ()
    else:
        for variant in &(*value).variants:
            let line_ = match &variant.fields:
                kain_core__ast__VariantFields::Unit => variant.name.clone()
                kain_core__ast__VariantFields::Tuple(types) =>
                    let values = types.iter().map(type_to_string).collect().join(", ")
                    f"{variant.name}({values})"
                kain_core__ast__VariantFields::Struct(fields) =>
                    let values = fields.iter().map(fn(field): f"{field.name}: {type_to_string(&field.ty)}").collect().join(", ")
                    "{variant.name} { {values} }"
            write_line(output, (indent + 1), &line_)?
            ()
        ()
        ()
    __kain_writeln_fmt!(output, "").map_err(fn(err): OmniError::SourceGeneration(err.to_string()))?
    ()
    Result::Ok(())

fn write_impl(output: String, value: &kain_core::ast::Impl, indent: usize) -> OmniResult<()>:
    use std::fmt::Write

    let header = match &(*value).trait_name:
        Some(trait_name) => f"impl {trait_name} for {type_to_string(&(*value).target_type)}:"
        None => f"impl {type_to_string(&(*value).target_type)}:"
    write_line(output, indent, &header)?
    ()
    if (*value).methods.is_empty():
        write_line(output, (indent + 1), "pass")?
        ()
        ()
        ()
        ()
    else:
        for method in &(*value).methods:
            write_function(output, method, (indent + 1))?
            ()
        ()
        ()
    __kain_writeln_fmt!(output, "").map_err(fn(err): OmniError::SourceGeneration(err.to_string()))?
    ()
    Result::Ok(())

fn write_block(output: String, block: &kain_core::ast::Block, indent: usize) -> OmniResult<()>:
    if (*block).stmts.is_empty():
        write_line(output, indent, "pass")?
        ()
        return Result::Ok(())
    for stmt in &(*block).stmts:
        write_stmt(output, stmt, indent)?
        ()
    ()
    Result::Ok(())

fn write_stmt(output: String, stmt: &kain_core::ast::Stmt, indent: usize) -> OmniResult<()>:
    match stmt:
        kain_core__ast__Stmt::Let { pattern: pattern, ty: ty, value: value } =>
            let mut line_ = f"let {pattern_to_string(pattern)}"
            match ty:
                Some(ty) =>
                    line_.push_str(&f": {type_to_string(ty)}")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match value:
                Some(value) =>
                    line_.push_str(&f" = {expr_to_string(value)}")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            write_line(output, indent, &line_)
        kain_core__ast__Stmt::Expr(expr) => write_line(output, indent, &expr_to_string(expr))
        kain_core__ast__Stmt::Return(value, _) =>
            match value:
                Some(value) => write_line(output, indent, &f"return {expr_to_string(value)}")
                _ => write_line(output, indent, "return")
        _ => write_line(output, indent, "pass")

fn write_line(output: String, indent: usize, line_: String) -> OmniResult<()>:
    use std::fmt::Write

    __kain_writeln_fmt!(output, "{(\"    \").repeat(indent)}{line_}").map_err(fn(err): OmniError::SourceGeneration(err.to_string()))

fn pattern_to_string(pattern: &kain_core::ast::Pattern) -> String:
    match pattern:
        kain_core__ast__Pattern::Wildcard(_) => ("_").to_string()
        kain_core__ast__Pattern::Binding { name: name, mutable_: mutable_ } => if (*mutable_): f"mut {name}" else: name.clone()
        _ => ("_").to_string()

fn expr_to_string(expr: &kain_core::ast::Expr) -> String:
    match expr:
        kain_core__ast__Expr::Int(value, _) => value.to_string()
        kain_core__ast__Expr::Float(value, _) => value.to_string()
        kain_core__ast__Expr::String(value, _) => value
        kain_core__ast__Expr::Bool(value, _) => value.to_string()
        kain_core__ast__Expr::None(_) => ("none").to_string()
        kain_core__ast__Expr::Ident(value, _) => value.clone()
        _ => ("none").to_string()

fn type_to_string(ty: &kain_core::ast::Type) -> String:
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } => if generics.is_empty(): name.clone() else: "{name}<{generics.iter().map(type_to_string).collect().join(\", \")}>"
        kain_core__ast__Type::Tuple(types, _) => "({types.iter().map(type_to_string).collect().join(\", \")})"
        kain_core__ast__Type::Array(inner, _, _) => f"Array<{type_to_string(inner)}>"
        kain_core__ast__Type::Option(inner, _) => f"Option<{type_to_string(inner)}>"
        _ => ("Any").to_string()

fn build_target(source: String, resolved_entry: &std::path::Path, output: &std::path::Path, target: &OmniTarget) -> OmniResult<Array<std::path::PathBuf>>:
    match (*target).kind:
        OmniTargetKind::GpuArtifacts =>
            let artifacts = compile_gpu_artifacts(source)?
            write_gpu_artifacts_bundle(output, &artifacts)
        OmniTargetKind::RustBundle =>
            let config = (*target).rust_bundle.clone().unwrap_or_default()
            let compiled = compile_rust_bundle(source, &config)?
            let output_root = config.output.map(fn(value): if value.is_absolute(): value.clone() else: output.parent().map(fn(parent): parent.join(value)).unwrap_or_else(fn(): value.clone())).unwrap_or_else(fn(): output.to_path_buf())
            let base_name = resolved_entry.file_stem().and_then(fn(value): value.to_str()).unwrap_or("kain")
            write_rust_bundle_outputs(&output_root, base_name, &config, &compiled)
        OmniTargetKind::Spirv =>
            let bytes = compile_spirv_binary(source)?
            std__fs__write(output, bytes)?
            ()
            Result::Ok([output.to_path_buf()])
        _ =>
            let compile_target = compile_target_for_kind(&(*target).kind).ok_or_else(fn(): OmniError::Config(f"Unsupported target: {(*target).kind}"))?
            let compiled = compile_to_text(source, compile_target)?
            let final_output = ensure_target_extension(output, compile_target)
            match final_output.parent():
                Some(parent) =>
                    std__fs__create_dir_all(parent)?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            std__fs__write(&final_output, compiled)?
            ()
            Result::Ok([final_output])

fn compile_target_for_kind(kind: &OmniTargetKind) -> Option<kain_core::CompileTarget>:
    match kind:
        OmniTargetKind::Rust => Option::Some(kain_core__CompileTarget__Rust)
        OmniTargetKind::Js => Option::Some(kain_core__CompileTarget__Js)
        OmniTargetKind::Ts => Option::Some(kain_core__CompileTarget__Ts)
        OmniTargetKind::Ks => Option::Some(kain_core__CompileTarget__Ks)
        OmniTargetKind::Cpp => Option::Some(kain_core__CompileTarget__Cpp)
        OmniTargetKind::Hlsl => Option::Some(kain_core__CompileTarget__Hlsl)
        OmniTargetKind::Usf => Option::Some(kain_core__CompileTarget__Usf)
        OmniTargetKind::Ue5 => Option::Some(kain_core__CompileTarget__Ue5)
        OmniTargetKind::Ue5Editor => Option::Some(kain_core__CompileTarget__Ue5Editor)
        OmniTargetKind::Spirv => none
        OmniTargetKind::GpuArtifacts => none
        OmniTargetKind::RustBundle => none

fn ensure_target_extension(path: &std::path::Path, target: kain_core::CompileTarget) -> std::path::PathBuf:
    let expected = target_extension(target)
    match path.extension().and_then(fn(value): value.to_str()):
        Some(ext) if ext.eq_ignore_ascii_case(expected) => path.to_path_buf()
        _ => path.with_extension(expected)

fn target_extension(target: kain_core::CompileTarget) -> String:
    kain_driver__self__target_extension(target)

fn compile_to_text(source: String, target: kain_core::CompileTarget) -> OmniResult<String>:
    kain_driver__self__compile_(source, target).map_err(to_compiler_error)

fn compile_spirv_binary(source: String) -> OmniResult<Array<u8>>:
    kain_driver__self__compile_spirv_binary(source).map_err(to_compiler_error)

fn compile_gpu_artifacts(source: String) -> OmniResult<kain_driver::GpuArtifactOutput>:
    kain_driver__self__compile_gpu_artifacts(source).map_err(to_compiler_error)

fn write_gpu_artifacts_bundle(output: &std::path::Path, artifacts: &kain_driver::GpuArtifactOutput) -> OmniResult<Array<std::path::PathBuf>>:
    let spirv_path = with_file_name_suffix(output, "", "spv")
    let rust_path = with_file_name_suffix(output, ".gpu", "rs")
    let json_path = with_file_name_suffix(output, ".reflect", "json")
    let bundle_path = with_file_name_suffix(output, ".shader_bundle", "json")
    let hlsl_path = with_file_name_suffix(output, ".derived", "hlsl")
    for path in [&spirv_path, &rust_path, &json_path, &bundle_path, &hlsl_path]:
        match path.parent():
            Some(parent) =>
                std__fs__create_dir_all(parent)?
                ()
            _ => ()
    ()
    std__fs__write(&spirv_path, &(*artifacts).spirv)?
    ()
    std__fs__write(&rust_path, (*artifacts).rust_host.as_bytes())?
    ()
    std__fs__write(&json_path, (*artifacts).reflection_json.as_bytes())?
    ()
    std__fs__write(&bundle_path, (*artifacts).bundle_json.as_bytes())?
    ()
    let mut written = [spirv_path, rust_path, json_path, bundle_path]
    match &(*artifacts).derived_hlsl:
        Some(hlsl) =>
            std__fs__write(&hlsl_path, hlsl.as_bytes())?
            ()
            written.push(hlsl_path)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    Result::Ok(written)

fn compile_rust_bundle(source: String, config: &OmniRustBundleConfig) -> OmniResult<kain_driver::RustBundleOutput>:
    kain_driver__self__compile_rust_artifact_bundle(source, (*config).artifacts.contains(&OmniRustArtifact__Spirv)).map_err(to_compiler_error)

fn write_rust_bundle_outputs(output_root: &std::path::Path, base_name: String, config: &OmniRustBundleConfig, compiled: &kain_driver::RustBundleOutput) -> OmniResult<Array<std::path::PathBuf>>:
    std__fs__create_dir_all(output_root)?
    ()
    let mut written = Vec__new_()
    if (*config).artifacts.contains(&OmniRustArtifact__Source):
        let path = output_root.join(f"{base_name}.rs")
        std__fs__write(&path, (*compiled).bundle.primary.contents.as_bytes())?
        ()
        written.push(path)
        ()
        ()
        ()
        ()
    for artifact in &(*compiled).bundle.supplemental:
        let should_write = match artifact.kind:
            kain_sys_codegen__RustArtifactKind::PrimarySource => (*config).artifacts.contains(&OmniRustArtifact__Source)
            kain_sys_codegen__RustArtifactKind::ShaderHost => (*config).artifacts.contains(&OmniRustArtifact__ShaderHost)
            kain_sys_codegen__RustArtifactKind::ShaderReflection => (*config).artifacts.contains(&OmniRustArtifact__ShaderReflection)
        if (!should_write):
            continue
        let path = match artifact.kind:
            kain_sys_codegen__RustArtifactKind::PrimarySource => output_root.join(f"{base_name}.rs")
            kain_sys_codegen__RustArtifactKind::ShaderHost => output_root.join(f"{base_name}.gpu.rs")
            kain_sys_codegen__RustArtifactKind::ShaderReflection => output_root.join(f"{base_name}.reflect.json")
        std__fs__write(&path, artifact.contents.as_bytes())?
        ()
        written.push(path)
        ()
    ()
    if (*config).artifacts.contains(&OmniRustArtifact__Spirv):
        match &(*compiled).spirv:
            Some(spirv) =>
                let path = output_root.join(f"{base_name}.spv")
                std__fs__write(&path, spirv)?
                ()
                written.push(path)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    Result::Ok(written)

fn with_file_name_suffix(base: &std::path::Path, suffix: String, extension: String) -> std::path::PathBuf:
    let parent = base.parent().map(Path__to_path_buf).unwrap_or_default()
    let stem = base.file_stem().and_then(fn(value): value.to_str()).unwrap_or("artifact")
    parent.join(f"{stem}{suffix}.{extension}")

fn to_compiler_error(error: kain_core::error::KainError) -> OmniError:
    OmniError::Compiler(error.to_string())

fn build_search_roots(project_root: &std::path::Path, staged_imports: &[StagedImport], config: &OmniImportResolution) -> Array<std::path::PathBuf>:
    let mut roots = BTreeSet__new_()
    roots.insert(project_root.to_path_buf())
    ()
    for root in &(*config).search_roots:
        roots.insert(resolve_from_root(project_root, root))
        ()
    ()
    for staged in staged_imports:
        match staged.generated_kn_path.parent():
            Some(parent) =>
                roots.insert(parent.to_path_buf())
                ()
            _ => ()
    ()
    roots.into_iter().collect()

fn resolve_kain_program(entry: &std::path::Path, search_roots: &[std::path::PathBuf]) -> OmniResult<String>:
    let mut visited = BTreeSet__new_()
    let mut ordered = Vec__new_()
    resolve_kain_file(entry, search_roots, &mut visited, &mut ordered)?
    ()
    let mut merged = String__new_()
    for selfhost_for_item in ordered.iter().enumerate():
        let (index, content) = selfhost_for_item
        if (index > 0):
            merged.push("\n")
            ()
            ()
            ()
            ()
        merged.push_str(content)
        ()
        if (!content.ends_with("\n")):
            merged.push("\n")
            ()
    ()
    Result::Ok(merged)

fn resolve_kain_file(path: &std::path::Path, search_roots: &[std::path::PathBuf], visited: &mut Set<std::path::PathBuf>, ordered: &mut Array<String>) -> OmniResult<()>:
    let canonical = std__fs__canonicalize(path).unwrap_or_else(fn(_): path.to_path_buf())
    if (!visited.insert(canonical.clone())):
        return Result::Ok(())
    let source = std__fs__read_to_string(&canonical)?
    let mut local_body = Vec__new_()
    for line_ in source.lines():
        match parse_quoted_import(line_):
            Some(import_spec) =>
                let resolved = resolve_quoted_import(&canonical, &import_spec, search_roots)?
                resolve_kain_file(&resolved, search_roots, visited, ordered)?
                ()
                continue
            _ =>
                ()
                ()
        local_body.push(line_)
        ()
    ()
    ordered.push(local_body.join("\n"))
    ()
    Result::Ok(())

fn parse_quoted_import(line_: String) -> Option<String>:
    let trimmed = line_.trim()
    if (!trimmed.starts_with("import ")):
        return none
    let first_quote = trimmed.find("\"")?
    let rest = &trimmed[(first_quote + 1)..]
    let second_quote = rest.find("\"")?
    Option::Some(rest[..second_quote].to_string())

fn resolve_quoted_import(current_file: &std::path::Path, import_spec: String, search_roots: &[std::path::PathBuf]) -> OmniResult<std::path::PathBuf>:
    let mut candidates = Vec__new_()
    let import_path = PathBuf__from(import_spec)
    let dotted = PathBuf__from(import_spec.replace(".", "/"))
    match current_file.parent():
        Some(parent) =>
            push_import_candidates(parent, &import_path, &dotted, &mut candidates)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    for root in search_roots:
        push_import_candidates(root, &import_path, &dotted, &mut candidates)
        ()
    ()
    for candidate in candidates:
        if candidate.exists():
            return Result::Ok(candidate)
    ()
    Result::Err(OmniError::ImportResolution(f"Failed to resolve quoted import '{import_spec}' from {current_file.display()}"))

fn push_import_candidates(base: &std::path::Path, import_path: &std::path::Path, dotted: &std::path::Path, out_: &mut Array<std::path::PathBuf>):
    for path in [import_path, dotted]:
        out_.push(base.join(path))
        ()
        out_.push(base.join(path).with_extension("kn"))
        ()
        out_.push(base.join(path).join("index.kn"))
        ()

fn resolve_from_root(root: &std::path::Path, path: &std::path::Path) -> std::path::PathBuf:
    if path.is_absolute():
        path.to_path_buf()
    else:
        root.join(path)

