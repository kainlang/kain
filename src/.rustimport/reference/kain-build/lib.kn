use std::env

use std::path::PathBuf

use kain_host::EngineModuleExport

use kain_host::EngineModuleExportConfig

use kain_host::HostResult

use kain_host::HostSession

use kain_host::HostType

use kain_host::KainError

use kain_host::KainReflect

use kain_host::NativeParam

use kain_host::TypeSchema

const ENV_OUTPUT_DIR: String = "KAIN_ENGINE_MODULE_DIR"

const ENV_MODULE_NAME: String = "KAIN_ENGINE_MODULE_NAME"

const ENV_MODULE_FILE: String = "KAIN_ENGINE_MODULE_FILE"

const ENV_IMPORT_SHIM_FILE: String = "KAIN_ENGINE_IMPORT_SHIM_FILE"

const ENV_DISABLE_IMPORT_SHIM: String = "KAIN_ENGINE_NO_IMPORT_SHIM"

const ENV_DISABLE_BANNER: String = "KAIN_ENGINE_NO_BANNER"

const ENV_EXPORTED_MODULE_PATH: String = "KAIN_ENGINE_MODULE_PATH"

const ENV_EXPORTED_IMPORT_PATH: String = "KAIN_ENGINE_IMPORT_SHIM_PATH"

@derive(Debug, Clone, PartialEq, Eq)
pub struct EngineModuleBuildConfig:
    export_: kain_host::EngineModuleExportConfig
    emit_rustc_env: Bool
    emit_rerun_if_env_changed: Bool

impl EngineModuleBuildConfig:
    pub fn from_env() -> EngineModuleBuildConfig:
        let module_name = std__env__var_(ENV_MODULE_NAME).unwrap_or_else(fn(_): ("engine").to_string())
        let mut export_ = EngineModuleExportConfig__for_module(module_name)
        match std__env__var_(ENV_OUTPUT_DIR):
            Ok(output_dir) =>
                export_.output_dir = PathBuf__from(output_dir)
                ()
                ()
                ()
                ()
            _ =>
                match std__env__var_("OUT_DIR"):
                    Ok(out_dir) =>
                        export_.output_dir = PathBuf__from(out_dir).join("kain")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
        match std__env__var_(ENV_MODULE_FILE):
            Ok(module_file) =>
                export_.module_file_name = module_file
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        if matches_env_true(ENV_DISABLE_IMPORT_SHIM):
            export_.import_shim_file_name = none
            ()
            ()
            ()
            ()
        else:
            match std__env__var_(ENV_IMPORT_SHIM_FILE):
                Ok(import_shim) =>
                    export_.import_shim_file_name = Option::Some(import_shim)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        if matches_env_true(ENV_DISABLE_BANNER):
            export_.include_banner = false
            ()
            ()
            ()
            ()
        EngineModuleBuildConfig { export_: export_, emit_rustc_env: true, emit_rerun_if_env_changed: true }

    pub fn with_export(_self: EngineModuleBuildConfig, export_: kain_host::EngineModuleExportConfig) -> EngineModuleBuildConfig:
        _self.export_ = export_
        ()
        _self

    pub fn with_rustc_env(_self: EngineModuleBuildConfig, emit_rustc_env: Bool) -> EngineModuleBuildConfig:
        _self.emit_rustc_env = emit_rustc_env
        ()
        _self

    pub fn with_rerun_if_env_changed(_self: EngineModuleBuildConfig, emit_rerun_if_env_changed: Bool) -> EngineModuleBuildConfig:
        _self.emit_rerun_if_env_changed = emit_rerun_if_env_changed
        ()
        _self


impl Default for EngineModuleBuildConfig:
    fn default_() -> EngineModuleBuildConfig:
        EngineModuleBuildConfig__from_env()


@derive(Debug, Clone, PartialEq, Eq)
pub struct EngineModuleBuildResult:
    export_: kain_host::EngineModuleExport

pub struct EngineModuleBuild:
    host: kain_host::HostSession
    config: EngineModuleBuildConfig

impl EngineModuleBuild:
    pub fn new_() -> EngineModuleBuild:
        EngineModuleBuild { host: HostSession__new_(), config: EngineModuleBuildConfig__default_() }

    pub fn with_config(config: EngineModuleBuildConfig) -> EngineModuleBuild:
        EngineModuleBuild { host: HostSession__new_(), config: config }

    pub fn config(_self: &EngineModuleBuild) -> &EngineModuleBuildConfig:
        &(*_self).config

    pub fn config_mut(_self: &mut EngineModuleBuild) -> &mut EngineModuleBuildConfig:
        &mut (*_self).config

    pub fn host(_self: &EngineModuleBuild) -> &kain_host::HostSession:
        &(*_self).host

    pub fn host_mut(_self: &mut EngineModuleBuild) -> &mut kain_host::HostSession:
        &mut (*_self).host

    pub fn register_type<T>(_self: &mut EngineModuleBuild) -> &mut EngineModuleBuild:
        (*_self).host.register_type()
        ()
        *_self

    pub fn register_schema(_self: &mut EngineModuleBuild, schema: kain_host::TypeSchema) -> &mut EngineModuleBuild:
        (*_self).host.register_schema(schema)
        ()
        *_self

    pub fn declare_native_fn(_self: &mut EngineModuleBuild, name: impl Into<String>, params: Array<kain_host::NativeParam>, return_type: kain_host::HostType) -> &mut EngineModuleBuild:
        (*_self).host.declare_native_fn(name, params, return_type)
        ()
        *_self

    pub fn build(_self: &EngineModuleBuild) -> kain_host::HostResult<EngineModuleBuildResult>:
        if (*_self).config.emit_rerun_if_env_changed:
            emit_rerun_env_directives()
            ()
            ()
            ()
            ()
        let export_ = (*_self).host.export_engine_module(&(*_self).config.export_)?
        println(f"cargo:warning=Exported KAIN engine module to {export_.module_path.display()}")
        if (*_self).config.emit_rustc_env:
            println(f"cargo:rustc-env={ENV_EXPORTED_MODULE_PATH}={export_.module_path.display()}")
            match &export_.import_shim_path:
                Some(import_path) =>
                    println(f"cargo:rustc-env={ENV_EXPORTED_IMPORT_PATH}={import_path.display()}")
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        Result::Ok(EngineModuleBuildResult { export_: export_ })


impl Default for EngineModuleBuild:
    fn default_() -> EngineModuleBuild:
        EngineModuleBuild__new_()


pub fn export_engine_module<F>(configure: F) -> kain_host::HostResult<EngineModuleBuildResult>:
    let mut build = EngineModuleBuild__new_()
    configure(&mut build)
    ()
    build.build()

fn emit_rerun_env_directives():
    for key in [ENV_OUTPUT_DIR, ENV_MODULE_NAME, ENV_MODULE_FILE, ENV_IMPORT_SHIM_FILE, ENV_DISABLE_IMPORT_SHIM, ENV_DISABLE_BANNER]:
        println(f"cargo:rerun-if-env-changed={key}")

fn matches_env_true(key: String) -> Bool:
    std__env__var_(key).map(fn(value): none).unwrap_or(false)

