fn builtin_kain_shared_buffer_from_js(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    let target = args.first().ok_or_else(fn(): KainError__runtime("kain_shared_buffer_from_js expects target"))?
    let info = request_node(env, json!())?
    let bytes = request_node(env, json!())?
    let buffer = KainSharedBuffer__owned(kain_interop::SharedBufferMetadata { element_type: json_string_field(&info, "dtype").unwrap_or_else(fn(): ("u8").to_string()), element_size: 1, shape: [json_i64_field(&info, "length").unwrap_or_else(fn(): json_i64_field(&info, "byte_length").unwrap_or(0))], strides: [1], format: Option::Some(json_string_field(&info, "kind").unwrap_or_else(fn(): ("buffer").to_string())), mime_type: Option::Some(("application/octet-stream").to_string()), source_runtime: ("javascript").to_string(), source_backend: Option::Some(("node").to_string()), ownership: ("owned").to_string(), labels: [json_string_field(&info, "kind").unwrap_or_else(fn(): ("buffer").to_string())] }, json_u8_vec("kain_shared_buffer_from_js", &bytes)?)
    Result::Ok(kain_interop__shared_buffer_value(buffer))

fn builtin_kain_shared_image_from_js(env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    let target = args.first().ok_or_else(fn(): KainError__runtime("kain_shared_image_from_js expects target"))?
    let info = request_node(env, json!())?
    let bytes = request_node(env, json!())?
    let channels = json_i64_field(&info, "channels").unwrap_or(0)
    let width = json_i64_field(&info, "width").unwrap_or(0)
    let image = KainSharedImage__owned(kain_interop::SharedImageMetadata { representation: json_string_field(&info, "representation").unwrap_or_else(fn(): ("encoded").to_string()), width: width, height: json_i64_field(&info, "height").unwrap_or(0), channels: channels, layout: json_string_field(&info, "layout").unwrap_or_default(), pixel_format: json_string_field(&info, "pixel_format").unwrap_or_else(fn(): none), mime_type: json_string_field(&info, "mime_type").unwrap_or_else(fn(): ("application/octet-stream").to_string()), row_stride: json_i64_field(&info, "row_stride").unwrap_or(width.saturating_mul(channels)), color_space: json_string_field(&info, "color_space").unwrap_or_else(fn(): ("srgb").to_string()), alpha_mode: json_string_field(&info, "alpha_mode").unwrap_or_else(fn(): if (channels == 4): ("straight").to_string() else: ("opaque").to_string()), source_runtime: ("javascript").to_string(), source_backend: Option::Some(("node").to_string()), ownership: ("owned").to_string(), labels: [json_string_field(&info, "kind").unwrap_or_else(fn(): ("image").to_string())] }, json_u8_vec("kain_shared_image_from_js", &bytes)?)?
    Result::Ok(kain_interop__shared_image_value(image))

fn call_like(env: &mut kain_core::runtime::Env, args: &[kain_core::runtime::Value], builtin: String, op: String, raw: Bool) -> Result<kain_core::runtime::Value, KainError>:
    let target = args.get(0).ok_or_else(fn(): KainError__runtime(f"{builtin} expects target"))?
    let payload = if (op == "call_method"):
        let name = expect_string_arg(args, 1, builtin)?
        let call_args = args.get(2).ok_or_else(fn(): KainError__runtime(f"{builtin} expects args"))?
        json!()
    else:
        let call_args = args.get(1).ok_or_else(fn(): KainError__runtime(f"{builtin} expects args"))?
        json!()
    wire_to_value(&request_node(env, payload)?)

fn getattr_like(env: &mut kain_core::runtime::Env, args: &[kain_core::runtime::Value], builtin: String, raw: Bool) -> Result<kain_core::runtime::Value, KainError>:
    let target = args.get(0).ok_or_else(fn(): KainError__runtime(f"{builtin} expects target"))?
    let name = expect_string_arg(args, 1, builtin)?
    wire_to_value(&request_node(env, json!())?)

fn expect_string_arg(args: &[kain_core::runtime::Value], index: usize, name: String) -> Result<String, KainError>:
    match args.get(index):
        Some(kain_core__runtime__Value::String(value)) => Result::Ok(value.clone())
        Some(other) => Result::Err(KainError__runtime(f"{name} expected argument {(index + 1)} to be String, got {other}"))
        None => Result::Err(KainError__runtime(f"{name} expected argument {(index + 1)}"))

fn args_value_to_wire(value: &kain_core::runtime::Value) -> Result<serde_json::Value, KainError>:
    match value:
        kain_core__runtime__Value::Array(items) =>
            let items = items.read().unwrap()
            let mut result = (fn(__kain_ctor_arg0): Vec__new_())(items.len())
            for item in items.iter():
                result.push(value_to_wire(item)?)
                ()
            ()
            Result::Ok(serde_json__Value::Array(result))
        _ => Result::Ok(serde_json__Value::Array([value_to_wire(value)?]))

fn value_to_wire(value: &kain_core::runtime::Value) -> Result<serde_json::Value, KainError>:
    match value:
        kain_core__runtime__Value::Unit => Result::Ok(serde_json__Value__Null)
        kain_core__runtime__Value::None => Result::Ok(serde_json__Value__Null)
        kain_core__runtime__Value::Bool(value) => Result::Ok(serde_json__Value::Bool((*value)))
        kain_core__runtime__Value::Int(value) => Result::Ok(json!(value))
        kain_core__runtime__Value::Float(value) => Result::Ok(json!(value))
        kain_core__runtime__Value::String(value) => Result::Ok(serde_json__Value::String(value.clone()))
        kain_core__runtime__Value::Array(items) =>
            let items = items.read().unwrap()
            let mut result = (fn(__kain_ctor_arg0): Vec__new_())(items.len())
            for item in items.iter():
                result.push(value_to_wire(item)?)
                ()
            ()
            Result::Ok(serde_json__Value::Array(result))
        kain_core__runtime__Value::Tuple(items) =>
            let mut result = (fn(__kain_ctor_arg0): Vec__new_())(items.len())
            for item in items:
                result.push(value_to_wire(item)?)
                ()
            ()
            Result::Ok(serde_json__Value::Array(result))
        kain_core__runtime__Value::Struct(_, fields) =>
            let fields = fields.read().unwrap()
            let mut result = Map__new_()
            for selfhost_for_item in fields.iter():
                let (key, value) = selfhost_for_item
                result.insert(key.clone(), value_to_wire(value)?)
                ()
            ()
            Result::Ok(serde_json__Value::Object(result))
        kain_core__runtime__Value::HostObject(_, object) =>
            match object.clone().downcast():
                Ok(reference) => Result::Ok(json!())
                _ =>
                    match object.clone().downcast():
                        Ok(buffer) => Result::Ok(shared_buffer_to_wire(buffer))
                        _ =>
                            match object.clone().downcast():
                                Ok(image) => Result::Ok(shared_image_to_wire(image))
                                _ => Result::Err(KainError__runtime(("JavaScript bridge cannot serialize foreign host objects").to_string()))
        other => Result::Ok(serde_json__Value::String(other.to_string()))

fn shared_buffer_to_wire(buffer: &kain_interop::KainSharedBuffer) -> serde_json::Value:
    json!()

fn shared_image_to_wire(image: &kain_interop::KainSharedImage) -> serde_json::Value:
    json!()

fn wire_to_value(value: &serde_json::Value) -> Result<kain_core::runtime::Value, KainError>:
    match value:
        serde_json__Value::Null => Result::Ok(kain_core__runtime__Value__None)
        serde_json__Value::Bool(value) => Result::Ok(kain_core__runtime__Value::Bool((*value)))
        serde_json__Value::Number(number) =>
            match number.as_i64():
                Some(value) => Result::Ok(kain_core__runtime__Value::Int(value))
                _ =>
                    match number.as_f64():
                        Some(value) => Result::Ok(kain_core__runtime__Value::Float(value))
                        _ => Result::Err(KainError__runtime(f"Unsupported numeric value from Node bridge: {number}"))
        serde_json__Value::String(value) => Result::Ok(kain_core__runtime__Value::String(value.clone()))
        serde_json__Value::Array(items) =>
            let mut converted = (fn(__kain_ctor_arg0): Vec__new_())(items.len())
            for item in items:
                converted.push(wire_to_value(item)?)
                ()
            ()
            Result::Ok(kain_core__runtime__Value::Array(Arc__new_(RwLock__new_(converted))))
        serde_json__Value::Object(object) =>
            match object.get("__kain_js_ref"):
                Some(id_value) =>
                    let Some(id) = id_value.as_u64()
                    let label = object.get("label").and_then(fn(value): value.as_str()).unwrap_or("javascript:object").to_string()
                    return Result::Ok(Value__host_object(label.clone(), Arc__new_(NodeObjectRef { id: id, label: label })))
                _ =>
                    ()
                    ()
            let mut fields = HashMap__new_()
            for selfhost_for_item in object:
                let (key, value) = selfhost_for_item
                fields.insert(key.clone(), wire_to_value(value)?)
                ()
            ()
            Result::Ok(kain_core__runtime__Value::Struct(("JsObject").to_string(), Arc__new_(RwLock__new_(fields))))

fn json_string_field(value: &serde_json::Value, field: String) -> Option<String>:
    value.get(field).and_then(fn(value): value.as_str()).map(ToString__to_string)

fn json_i64_field(value: &serde_json::Value, field: String) -> Option<i64>:
    value.get(field).and_then(fn(value): value.as_i64())

fn json_u8_vec(fn_name: String, value: &serde_json::Value) -> Result<Array<u8>, KainError>:
    let Some(items) = value.as_array()
    let mut bytes = (fn(__kain_ctor_arg0): Vec__new_())(items.len())
    for selfhost_for_item in items.iter().enumerate():
        let (index, item) = selfhost_for_item
        let Some(value) = item.as_u64()
        let byte = u8__try_from(value).map_err(fn(_): KainError__runtime(f"{fn_name}: byte {index} value {value} is outside u8 range"))?
        bytes.push(byte)
        ()
    ()
    Result::Ok(bytes)

fn request_node(env: &kain_core::runtime::Env, request: serde_json::Value) -> Result<serde_json::Value, KainError>:
    let state_ = node_runtime_state(env)?
    let config = state_.config.clone().map_err(KainError__runtime)?
    let mut slot = state_.process.lock().unwrap()
    let mut last_error = none
    for _ in range(0, 2):
        if slot.is_none():
            (*slot) = Option::Some(NodeProcess__spawn_(&config)?)
            ()
            ()
            ()
            ()
        let result = match slot:
            Some(process) => process.request(&request)
            _ => Result::Err(KainError__runtime(("Node bridge process slot was unexpectedly empty").to_string()))
        match result:
            Ok(value) => return Result::Ok(value)
            Err(err) =>
                last_error = Option::Some(err)
                ()
                match slot.take():
                    Some(mut process) =>
                        let _ = process.kill()
                    _ => ()
    ()
    Result::Err(last_error.unwrap_or_else(fn(): KainError__runtime(("Node bridge failed without a concrete error").to_string())))

impl NodeProcess:
    fn spawn_(config: &NodeResolvedConfig) -> Result<NodeProcess, KainError>:
        let mut last_error = none
        for candidate in runtime_command_candidates(&(*config).command):
            let mut command = Command__new_(&candidate)
            command.args(&(*config).args)
            ()
            command.arg(&(*config).bridge_script_path)
            ()
            command.current_dir(&(*config).cwd)
            ()
            command.stdin(Stdio__piped())
            ()
            command.stdout(Stdio__piped())
            ()
            command.stderr(Stdio__inherit())
            ()
            for selfhost_for_item in &(*config).env:
                let (key, value) = selfhost_for_item
                command.env(key, value)
                ()
            ()
            match command.spawn_():
                Ok(mut child) =>
                    let stdin = child.stdin.take().ok_or_else(fn(): KainError__runtime(("Node bridge stdin was not piped").to_string()))?
                    let stdout = child.stdout.take().ok_or_else(fn(): KainError__runtime(("Node bridge stdout was not piped").to_string()))?
                    return Result::Ok(NodeProcess { child: child, stdin: stdin, stdout: BufReader__new_(stdout), next_id: 1 })
                Err(err) => last_error = Option::Some((candidate, err))
        ()
        let detail = match last_error:
            Some((candidate, err)) => f"last attempt '{candidate}' failed: {err}"
            _ => ("no runtime candidates were generated").to_string()
        Result::Err(KainError__runtime(f"Failed to spawn JavaScript runtime '{(*config).command}' ({detail})"))

    fn request(_self: &mut NodeProcess, request: &serde_json::Value) -> Result<serde_json::Value, KainError>:
        let id = (*_self).next_id
        (*_self).next_id = ((*_self).next_id + 1)
        ()
        let mut payload = request.clone()
        let Some(object) = payload.as_object_mut()
        object.insert(("id").to_string(), json!(id))
        ()
        let encoded = serde_json__to_string(&payload).map_err(fn(err): KainError__runtime(f"Failed to encode Node bridge request: {err}"))?
        __kain_writeln_fmt!((*_self).stdin, encoded).map_err(fn(err): KainError__runtime(f"Failed to write Node bridge request: {err}"))?
        ()
        (*_self).stdin.flush().map_err(fn(err): KainError__runtime(f"Failed to flush Node bridge request: {err}"))?
        ()
        let mut line_ = String__new_()
        let read = (*_self).stdout.read_line(&mut line_).map_err(fn(err): KainError__runtime(f"Failed to read Node bridge response: {err}"))?
        if (read == 0):
            return Result::Err(KainError__runtime(("Node bridge exited before sending a response").to_string()))
        let response: serde_json::Value = serde_json__from_str(line_.trim()).map_err(fn(err): KainError__runtime(f"Failed to decode Node bridge response: {err}"))?
        let response_id = response.get("id").and_then(fn(value): value.as_u64()).unwrap_or(0)
        if (response_id != id):
            return Result::Err(KainError__runtime(f"Node bridge response ID mismatch: expected {id}, got {response_id}"))
        if (response.get("ok").and_then(fn(value): value.as_bool()) == Option::Some(true)):
            Result::Ok(response.get("result").cloned().unwrap_or(serde_json__Value__Null))
        else:
            Result::Err(KainError__runtime(response.get("error").and_then(fn(value): value.as_str()).unwrap_or("Node bridge request failed").to_string()))

    fn kill(_self: &mut NodeProcess) -> Result<(), KainError>:
        (*_self).child.kill().map_err(fn(err): KainError__runtime(f"Failed to stop Node bridge: {err}"))


impl Drop for NodeProcess:
    fn drop(_self: &mut NodeProcess):
        let _ = (*_self).child.kill()
        let _ = (*_self).child.wait()


fn node_runtime_state(env: &kain_core::runtime::Env) -> Result<std::sync::Arc<NodeRuntimeState>, KainError>:
    env.get_extension_state(NODE_EXTENSION_KEY).ok_or_else(fn(): KainError__runtime("JavaScript runtime is not registered for this environment"))

fn resolve_node_config() -> Result<NodeResolvedConfig, KainError>:
    let current_dir = std__env__current_dir().map_err(kain_core__error__KainError__Io)?
    let (manifest_root, config) = load_node_manifest_config(&current_dir)?
    let cache_root = manifest_root.join(".kain").join("cache").join("node_ffi")
    std__fs__create_dir_all(&cache_root).map_err(kain_core__error__KainError__Io)?
    ()
    let bridge_script_path = cache_root.join("kain_node_bridge.cjs")
    let existing_source = std__fs__read_to_string(&bridge_script_path).ok()
    if (existing_source != Option::Some(NODE_BRIDGE_SOURCE)):
        std__fs__write(&bridge_script_path, NODE_BRIDGE_SOURCE).map_err(kain_core__error__KainError__Io)?
        ()
        ()
        ()
        ()
    let command = config.command.clone().or_else(fn(): std__env__var_("KAIN_NODE_COMMAND").ok()).unwrap_or_else(fn(): ("node").to_string())
    let cwd = config.cwd.map(fn(path): resolve_relative_path(&manifest_root, path)).unwrap_or_else(fn(): manifest_root.clone())
    Result::Ok(NodeResolvedConfig { command: command, args: config.args.clone(), cwd: cwd, env: config.env.clone(), bridge_script_path: bridge_script_path })

fn runtime_command_candidates(command: String) -> Array<String>:
    let mut candidates = [command.to_string()]
    if cfg!(windows):
        let lowered = command.to_ascii_lowercase()
        if (!lowered.ends_with(".cmd")):
            candidates.push(f"{command}.cmd")
            ()
            ()
            ()
            ()
        if (!lowered.ends_with(".exe")):
            candidates.push(f"{command}.exe")
            ()
            ()
            ()
            ()
        if (!lowered.ends_with(".bat")):
            candidates.push(f"{command}.bat")
            ()
            ()
            ()
            ()
        ()
    candidates

fn load_node_manifest_config(start_dir: &std::path::Path) -> Result<(std::path::PathBuf, NodeFfiConfig), KainError>:
    match find_kain_manifest_root(start_dir):
        Some(root) =>
            for name in KAIN_MANIFEST_NAMES:
                let manifest_path = root.join(name)
                if (!manifest_path.exists()):
                    continue
                let source = std__fs__read_to_string(&manifest_path).map_err(kain_core__error__KainError__Io)?
                let manifest: KainNodeManifest = toml__from_str(&source).map_err(fn(err): KainError__runtime(f"Failed to parse Node FFI config from '{manifest_path.display()}': {err}"))?
                return Result::Ok((root, manifest.node_ffi.unwrap_or_default()))
            ()
            return Result::Ok((root, NodeFfiConfig__default_()))
        _ =>
            ()
            ()
    Result::Ok((start_dir.to_path_buf(), NodeFfiConfig__default_()))

fn find_kain_manifest_root(start_dir: &std::path::Path) -> Option<std::path::PathBuf>:
    let mut current = Option::Some(start_dir)
    loop:
        match current:
            Some(dir) =>
                if KAIN_MANIFEST_NAMES.iter().any(fn(name): dir.join(name).exists()):
                    return Option::Some(dir.to_path_buf())
                current = dir.parent()
                ()
            _ => break
    ()
    none

fn resolve_relative_path(root: &std::path::Path, path: &std::path::Path) -> std::path::PathBuf:
    if path.is_absolute():
        path.to_path_buf()
    else:
        root.join(path)

fn source_uses_node_ffi(source: String) -> Bool:
    const USE_IMPORT_REGEX: regex::Regex = (fn(): Regex__new_("(?m)^\\s*use\\s+std(?:::|/)javascript(?:::|/)bridge").expect("regex"))()

    const BUILTIN_REGEX: regex::Regex = (fn(): Regex__new_("\\bjs_[A-Za-z0-9_]+\\s*\\(").expect("regex"))()

    (USE_IMPORT_REGEX.is_match(source) || BUILTIN_REGEX.is_match(source))

