use kain_core::shader_artifact_bundle_from_json

use kain_interop::shared_buffer_gpu_binding_view

use kain_interop::GpuBindingAccess as InteropAccess

use kain_interop::GpuDescriptorKind as InteropDescriptorKind

use kain_interop::KainSharedBuffer

use kain_interop::SharedBufferMetadata

