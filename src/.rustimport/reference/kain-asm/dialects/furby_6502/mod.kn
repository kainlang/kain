use crate::error::AsmError

use crate::error::AsmResult

use kain_core::AsmBlock

use kain_core::AsmDataTable

use kain_core::AsmDirective

use kain_core::AsmInstr

use kain_core::AsmProgram

use kain_core::ParityTraceFrame

use kain_core::TranslitUnit

use serde::Serialize

use std::collections::BTreeMap

use std::collections::HashSet

use std::fs

use std::path::Path

use std::path::PathBuf

const SUPPORTED_FORMAT: String = "6502-furby"

@derive(Debug, serde__Serialize, Clone)
pub struct RecoveryIssue:
    line_: usize
    message: String

@derive(Debug, serde__Serialize, Clone)
pub struct RecoverySectionScore:
    section: String
    recognized: usize
    total: usize
    confidence: f64

@derive(Debug, serde__Serialize, Clone)
pub struct RecoveryReport:
    input: String
    canonical_output: String
    unresolved_tokens: Array<RecoveryIssue>
    ambiguous_labels: Array<RecoveryIssue>
    section_scores: Array<RecoverySectionScore>

@derive(Debug, serde__Serialize, Clone)
pub struct ImportAsmOutput:
    canonical_asm_path: std::path::PathBuf
    generated_kn_path: std::path::PathBuf
    map_json_path: std::path::PathBuf
    report_json_path: std::path::PathBuf
    parsed: kain_core::AsmProgram
    translit_units: Array<kain_core::TranslitUnit>

@derive(Debug, serde__Serialize)
struct FurbyMap:
    translit_units: Array<kain_core::TranslitUnit>
    parity_trace_schema: kain_core::ParityTraceFrame

pub fn import_asm(input: &std::path::Path, format: String, out_kn: Option<&std::path::Path>, validate_only: Bool) -> AsmResult<ImportAsmOutput>:
    if (format != SUPPORTED_FORMAT):
        return Result::Err(AsmError__runtime(f"Unsupported asm format '{format}'. Supported: {SUPPORTED_FORMAT}"))
    let raw = std__fs__read_to_string(input).map_err(AsmError__Io)?
    let canonical_text = canonicalize_asm(&raw)
    let parsed = parse_asm_program(&canonical_text)
    let translit_units = build_translit_units(&parsed)
    let report = build_recovery_report(input, &canonical_text, &parsed)
    let cwd = std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from("."))
    let project_root = resolve_project_root(&cwd)
    let research_dir = project_root.join("Research").join("furby")
    let generated_dir = project_root.join("generated")
    std__fs__create_dir_all(&research_dir).map_err(AsmError__Io)?
    ()
    std__fs__create_dir_all(&generated_dir).map_err(AsmError__Io)?
    ()
    let canonical_asm_path = research_dir.join("furby_canonical.asm")
    let generated_kn_path = out_kn.map(fn(v): v.to_path_buf()).unwrap_or_else(fn(): generated_dir.join("furby_firmware.kn"))
    let map_dir = generated_kn_path.parent().map(Path__to_path_buf).unwrap_or_else(fn(): generated_dir.clone())
    let map_json_path = map_dir.join("furby_map.json")
    let report_json_path = research_dir.join("furby_recovery_report.json")
    if (!validate_only):
        std__fs__write(&canonical_asm_path, canonical_text).map_err(AsmError__Io)?
        ()
        std__fs__write(&generated_kn_path, render_kain_firmware(&parsed, &translit_units)).map_err(AsmError__Io)?
        ()
        let furby_map = FurbyMap { translit_units: translit_units.clone(), parity_trace_schema: default_parity_trace_schema() }
        let map_json = serde_json__to_string_pretty(&furby_map).map_err(fn(e): AsmError__runtime(f"Failed to serialize furby map: {e}"))?
        std__fs__write(&map_json_path, map_json).map_err(AsmError__Io)?
        ()
        ()
        ()
        ()
    let report_json = serde_json__to_string_pretty(&report).map_err(fn(e): AsmError__runtime(f"Failed to serialize recovery report: {e}"))?
    std__fs__write(&report_json_path, report_json).map_err(AsmError__Io)?
    ()
    Result::Ok(ImportAsmOutput { canonical_asm_path: canonical_asm_path, generated_kn_path: generated_kn_path, map_json_path: map_json_path, report_json_path: report_json_path, parsed: parsed, translit_units: translit_units })

fn resolve_project_root(cwd: &std::path::Path) -> std::path::PathBuf:
    if cwd.join("crates").is_dir():
        return cwd.to_path_buf()
    if cwd.join("Kain").join("crates").is_dir():
        return cwd.join("Kain")
    cwd.to_path_buf()

fn canonicalize_asm(raw: String) -> String:
    let mut out_ = Vec__new_()
    for line_ in raw.lines():
        let trimmed = line_.trim().replace("\u{feff}", "")
        if trimmed.is_empty():
            continue
        if trimmed.starts_with("----------------------- Page "):
            continue
        if trimmed.chars().all(fn(c): (c == "-")):
            continue
        if (trimmed.starts_with("A") && trimmed.chars().skip(1).all(fn(c): (c.is_ascii_digit() || (c == "-")))):
            continue
        let sanitized = trimmed.chars().map(fn(c): none).collect()
        let squashed = sanitized.split_whitespace().collect().join(" ")
        if (!squashed.is_empty()):
            out_.push(squashed)
            ()
    ()
    out_.join("\n")

fn parse_asm_program(canonical: String) -> kain_core::AsmProgram:
    let mut blocks = Vec__new_()
    let mut directives = Vec__new_()
    let mut data_tables = Vec__new_()
    let mut current_label = String__new_()
    let mut current_instrs: Array<kain_core::AsmInstr> = Vec__new_()
    let mut current_start = 0
    let mut current_data: Option<kain_core::AsmDataTable> = none
    for selfhost_for_item in canonical.lines().enumerate():
        let (idx, original_line) = selfhost_for_item
        let line_no = (idx + 1)
        let expanded = expand_compound_line(original_line)
        for line_ in expanded:
            let upper = line_.to_ascii_uppercase()
            if is_label_line(&line_):
                flush_data_table(&mut data_tables, &mut current_data, line_no.saturating_sub(1))
                ()
                flush_block(&mut blocks, &mut current_label, &mut current_instrs, &mut current_start, line_no.saturating_sub(1))
                ()
                current_label = line_.trim_end_matches(":").to_string()
                ()
                current_start = line_no
                ()
                continue
            if (((upper.starts_with(".CODE") || upper.starts_with(".SYNTAX")) || upper.starts_with(".LINKLIST")) || upper.starts_with(".SYMBOLS")):
                directives.push(kain_core::AsmDirective { name: line_.split_whitespace().next().unwrap_or("").to_string(), args: line_.split_whitespace().skip(1).map(str__to_string).collect(), source_line: line_no })
                ()
                continue
            if is_equ_directive(&line_):
                let parts: Array<String> = line_.split_whitespace().collect()
                directives.push(kain_core::AsmDirective { name: ("EQU").to_string(), args: parts.into_iter().map(str__to_string).collect(), source_line: line_no })
                ()
                continue
            match parse_data_line(&line_):
                Some((label, bytes)) =>
                    if current_data.is_none():
                        current_data = Option::Some(kain_core::AsmDataTable { label: label, bytes: Vec__new_(), source_line_start: line_no, source_line_end: line_no })
                        ()
                        ()
                        ()
                        ()
                    match current_data:
                        Some(mut table) =>
                            table.bytes.extend(bytes)
                            ()
                            table.source_line_end = line_no
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    continue
                _ =>
                    ()
                    ()
            match parse_instruction(&line_, line_no):
                Some(instr) =>
                    if current_label.is_empty():
                        current_label = f"__entry_{line_no}"
                        ()
                        current_start = line_no
                        ()
                        ()
                        ()
                        ()
                    current_instrs.push(instr)
                    ()
                _ => ()
    ()
    flush_data_table(&mut data_tables, &mut current_data, canonical.lines().count())
    ()
    flush_block(&mut blocks, &mut current_label, &mut current_instrs, &mut current_start, canonical.lines().count())
    ()
    kain_core::AsmProgram { blocks: blocks, directives: directives, data_tables: data_tables }

fn is_label_line(line_: String) -> Bool:
    let t = line_.trim()
    if ((!t.ends_with(":")) || (t.len() < 2)):
        return false
    let name = t.trim_end_matches(":")
    name.chars().all(fn(c): ((c.is_ascii_alphanumeric() || (c == "_")) || (c == ".")))

fn is_equ_directive(line_: String) -> Bool:
    let upper = line_.to_ascii_uppercase()
    upper.contains(" EQU ")

fn parse_data_line(line_: String) -> Option<(String, Array<String>)>:
    let upper = line_.to_ascii_uppercase()
    let (marker, pos) = match upper.find(" DB "):
        Some(p) => ("DB", (p + 1))
        _ => if upper.starts_with("DB "): ("DB", 0) else: none
    let left = line_[..pos].trim()
    let right = line_[(pos + marker.len())..].trim()
    let label = if left.is_empty():
        ("__anonymous_table").to_string()
    else:
        left.trim_end_matches(":").to_string()
    let values = right.split(fn(c: Char): ((c == ",") || c.is_ascii_whitespace())).map(str__trim).take_while(fn(v): (!v.starts_with(";"))).filter(fn(v): (!v.is_empty())).map(str__to_string).collect()
    if values.is_empty():
        none
    else:
        Option::Some((label, values))

fn parse_instruction(line_: String, source_line: usize) -> Option<kain_core::AsmInstr>:
    let t = line_.trim()
    if (t.is_empty() || t.starts_with(";")):
        return none
    let mut parts = t.split_whitespace()
    let opcode = (parts.next()?).to_ascii_uppercase()
    if opcode.chars().any(fn(c): (!c.is_ascii_alphanumeric())):
        return none
    let operand = parts.collect().join(" ")
    Option::Some(kain_core::AsmInstr { opcode: opcode, operand: if operand.is_empty(): none else: Option::Some(operand), source_line: source_line })

fn flush_block(blocks: &mut Array<kain_core::AsmBlock>, current_label: String, current_instrs: &mut Array<kain_core::AsmInstr>, current_start: &mut usize, end_line: usize):
    if ((!current_label.is_empty()) && (!current_instrs.is_empty())):
        blocks.push(kain_core::AsmBlock { label: current_label.clone(), instructions: std__mem__take(current_instrs), source_line_start: (*current_start), source_line_end: end_line })
        ()
        ()
        ()
        ()
    current_label.clear()
    ()

fn flush_data_table(tables: &mut Array<kain_core::AsmDataTable>, current: &mut Option<kain_core::AsmDataTable>, end_line: usize):
    match current.take():
        Some(mut table) =>
            table.source_line_end = end_line.max(table.source_line_start)
            ()
            tables.push(table)
            ()
        _ => ()

fn build_translit_units(parsed: &kain_core::AsmProgram) -> Array<kain_core::TranslitUnit>:
    (*parsed).blocks.iter().map(fn(b): kain_core::TranslitUnit { source_label: b.label.clone(), target_item: f"fw_{normalize_ident(&b.label)}", source_line_start: b.source_line_start, source_line_end: b.source_line_end }).collect()

fn normalize_ident(src: String) -> String:
    let mut out_ = String__new_()
    for c in src.chars():
        if c.is_ascii_alphanumeric():
            out_.push(c.to_ascii_lowercase())
            ()
        else:
            out_.push("_")
            ()
    ()
    if out_.is_empty():
        ("__unnamed").to_string()
    else:
        out_

fn render_kain_firmware(parsed: &kain_core::AsmProgram, translit: &[kain_core::TranslitUnit]) -> String:
    let mut out_ = String__new_()
    out_.push_str("# Generated by kain import-asm --format 6502-furby\n")
    ()
    out_.push_str("# Furby firmware transliteration seed\n\n")
    ()
    out_.push_str("struct CpuState:\n")
    ()
    out_.push_str("    a: Int\n")
    ()
    out_.push_str("    x: Int\n")
    ()
    out_.push_str("    y: Int\n")
    ()
    out_.push_str("    sp: Int\n")
    ()
    out_.push_str("    pc: Int\n")
    ()
    out_.push_str("    flags: Int\n")
    ()
    out_.push_str("    bank: Int\n\n")
    ()
    out_.push_str("struct Memory:\n")
    ()
    out_.push_str("    ram: Array<Int>\n")
    ()
    out_.push_str("    io_ports: Array<Int>\n")
    ()
    out_.push_str("    timers: Array<Int>\n")
    ()
    out_.push_str("    rom_tables: Array<Array<Int>>\n\n")
    ()
    out_.push_str("fn read_port(port_id: Int) -> Int:\n")
    ()
    out_.push_str("    return 0\n\n")
    ()
    out_.push_str("fn write_port(port_id: Int, value: Int):\n")
    ()
    out_.push_str("    let _port = port_id\n")
    ()
    out_.push_str("    let _value = value\n\n")
    ()
    out_.push_str("fn step(cpu: CpuState, mem: Memory) -> (CpuState, Memory, Int):\n")
    ()
    out_.push_str("    return (cpu, mem, 0)\n\n")
    ()
    out_.push_str("const FURBY_TABLES: Array<Array<Int>> = [\n")
    ()
    for table in &(*parsed).data_tables:
        out_.push_str("    [")
        ()
        let table_values = table.bytes.iter().map(fn(b): normalize_byte_literal(b)).collect().join(", ")
        out_.push_str(&table_values)
        ()
        out_.push_str("],\n")
        ()
    ()
    out_.push_str("]\n\n")
    ()
    let unit_by_label = translit.iter().map(fn(u): (u.source_label.as_str(), u)).collect()
    for block in &(*parsed).blocks:
        let fn_name = unit_by_label.get(block.label.as_str()).map(fn(u): u.target_item.clone()).unwrap_or_else(fn(): f"fw_{normalize_ident(&block.label)}")
        out_.push_str(&f"fn {fn_name}(cpu: CpuState, mem: Memory) -> (CpuState, Memory):\n")
        ()
        out_.push_str("    let next_cpu = cpu\n")
        ()
        out_.push_str("    let next_mem = mem\n")
        ()
        for instr in &block.instructions:
            let operand = instr.operand.clone().unwrap_or_default()
            out_.push_str(&f"    # L{instr.source_line} {instr.opcode} {operand}\n")
            ()
        ()
        out_.push_str("    return (next_cpu, next_mem)\n\n")
        ()
    ()
    out_.push_str("@component\n")
    ()
    out_.push_str("struct FurbyFirmwareComponent:\n")
    ()
    out_.push_str("    cpu_a: Int\n")
    ()
    out_.push_str("    cpu_x: Int\n")
    ()
    out_.push_str("    cpu_y: Int\n")
    ()
    out_.push_str("    bank: Int\n\n")
    ()
    out_.push_str("actor FurbyActor:\n")
    ()
    out_.push_str("    state tick_count: Int = 0\n")
    ()
    out_.push_str("    on Tick():\n")
    ()
    out_.push_str("        tick_count = tick_count + 1\n\n")
    ()
    out_.push_str("@component\n")
    ()
    out_.push_str("struct FurbyDebugComponent:\n")
    ()
    out_.push_str("    last_trace_tick: Int\n")
    ()
    out_.push_str("    last_pc: Int\n")
    ()
    out_

fn normalize_byte_literal(raw: String) -> String:
    let t = raw.trim().trim_end_matches(";").to_ascii_uppercase()
    if t.ends_with("H"):
        let hex = t.trim_end_matches("H")
        if hex.chars().all(fn(c): c.is_ascii_hexdigit()):
            return f"0x{hex}"
        ()
    if t.chars().all(fn(c): c.is_ascii_digit()):
        return t
    ("0").to_string()

fn build_recovery_report(input: &std::path::Path, canonical: String, parsed: &kain_core::AsmProgram) -> RecoveryReport:
    let mut unresolved_tokens = Vec__new_()
    let mut ambiguous_labels = Vec__new_()
    let mut sections = BTreeMap__new_()
    let label_set = (*parsed).blocks.iter().map(fn(b): b.label.clone()).collect()
    for selfhost_for_item in canonical.lines().enumerate():
        let (idx, line_) = selfhost_for_item
        let line_no = (idx + 1)
        let section = if line_.to_ascii_uppercase().contains("TBL"):
            ("tables").to_string()
        elif line_.to_ascii_uppercase().contains("EQU"):
            ("equates").to_string()
        else:
            ("code").to_string()
        let entry = sections.entry(section).or_insert((0, 0))
        entry.field_1 = (entry.field_1 + 1)
        ()
        let has_known_token = (((is_label_line(line_) || is_equ_directive(line_)) || parse_data_line(line_).is_some()) || parse_instruction(line_, line_no).is_some())
        if has_known_token:
            entry.field_0 = (entry.field_0 + 1)
            ()
            ()
            ()
            ()
        else:
            unresolved_tokens.push(RecoveryIssue { line_: line_no, message: f"Unrecognized canonical line: {line_}" })
            ()
            ()
            ()
            ()
        if is_label_line(line_):
            let label = line_.trim_end_matches(":").to_string()
            if (!label_set.contains(&label)):
                ambiguous_labels.push(RecoveryIssue { line_: line_no, message: f"Label parsed but not emitted as executable block: {label}" })
                ()
    ()
    let section_scores = sections.into_iter().map(fn(__kain_closure_arg0): RecoverySectionScore { section: __kain_closure_arg0.__kain_tuple_0, recognized: __kain_closure_arg0.__kain_tuple_1.__kain_tuple_0, total: __kain_closure_arg0.__kain_tuple_1.__kain_tuple_1, confidence: if (__kain_closure_arg0.__kain_tuple_1.__kain_tuple_1 == 0): 1 else: (__kain_closure_arg0.__kain_tuple_1.__kain_tuple_0 as f64 / __kain_closure_arg0.__kain_tuple_1.__kain_tuple_1 as f64) }).collect()
    RecoveryReport { input: input.display().to_string(), canonical_output: ("Research/furby/furby_canonical.asm").to_string(), unresolved_tokens: unresolved_tokens, ambiguous_labels: ambiguous_labels, section_scores: section_scores }

fn default_parity_trace_schema() -> kain_core::ParityTraceFrame:
    let mut registers = BTreeMap__new_()
    registers.insert(("a").to_string(), 0)
    ()
    registers.insert(("x").to_string(), 0)
    ()
    registers.insert(("y").to_string(), 0)
    ()
    registers.insert(("sp").to_string(), 0)
    ()
    registers.insert(("pc").to_string(), 0)
    ()
    registers.insert(("bank").to_string(), 0)
    ()
    let mut flags = BTreeMap__new_()
    flags.insert(("carry").to_string(), false)
    ()
    flags.insert(("zero").to_string(), false)
    ()
    flags.insert(("negative").to_string(), false)
    ()
    flags.insert(("overflow").to_string(), false)
    ()
    kain_core::ParityTraceFrame { tick: 0, pc: 0, opcode: ("NOP").to_string(), registers: registers, flags: flags, notes: [("schema").to_string()] }

fn expand_compound_line(line_: String) -> Array<String>:
    let mut tokens = Vec__new_()
    let mut current = String__new_()
    for c in line_.chars():
        if c.is_whitespace():
            if (!current.is_empty()):
                tokens.push(std__mem__take(&mut current))
                ()
        elif (((c == ":") || (c == ",")) || (c == ";")):
            if (!current.is_empty()):
                tokens.push(std__mem__take(&mut current))
                ()
                ()
                ()
                ()
            tokens.push(c.to_string())
            ()
        else:
            current.push(c)
            ()
    ()
    if (!current.is_empty()):
        tokens.push(current)
        ()
        ()
        ()
        ()
    let mut out_ = Vec__new_()
    let mut i = 0
    while (i < tokens.len()):
        if (((i + 1) < tokens.len()) && (tokens[(i + 1)] == ":")):
            out_.push(f"{sanitize_token(&tokens[i])}:")
            ()
            i = (i + 2)
            ()
            continue
        let kw = normalize_keyword(&tokens[i])
        if (is_directive_keyword(&kw) || is_opcode_keyword(&kw)):
            let mut line_buf = [kw]
            i = (i + 1)
            ()
            while (i < tokens.len()):
                if (((i + 1) < tokens.len()) && (tokens[(i + 1)] == ":")):
                    break
                let next_kw = normalize_keyword(&tokens[i])
                if (is_opcode_keyword(&next_kw) || is_directive_keyword(&next_kw)):
                    break
                if ((tokens[i] != ",") && (tokens[i] != ";")):
                    line_buf.push(sanitize_token(&tokens[i]))
                    ()
                    ()
                    ()
                    ()
                i = (i + 1)
                ()
            ()
            out_.push(line_buf.join(" "))
            ()
            continue
        i = (i + 1)
        ()
    ()
    if out_.is_empty():
        [line_.to_string()]
    else:
        out_

fn sanitize_token(token: String) -> String:
    token.chars().filter(fn(c): c.is_ascii_graphic()).collect()

fn normalize_keyword(token: String) -> String:
    let cleaned = token.trim_matches(fn(c: Char): (((!c.is_ascii_alphanumeric()) && (c != ".")) && (c != "_"))).to_ascii_uppercase()
    cleaned

fn is_directive_keyword(kw: String) -> Bool:
    match kw:
        "EQU" => true
        "DB" => true
        "DW" => true
        ".CODE" => true
        ".SYNTAX" => true
        ".LINKLIST" => true
        ".SYMBOLS" => true
        _ => false

fn is_opcode_keyword(kw: String) -> Bool:
    match kw:
        "ADC" => true
        "AND" => true
        "ASL" => true
        "BCC" => true
        "BCS" => true
        "BEQ" => true
        "BIT" => true
        "BMI" => true
        "BNE" => true
        "BPL" => true
        "BRK" => true
        "BVC" => true
        "BVS" => true
        "CLC" => true
        "CLD" => true
        "CLI" => true
        "CLV" => true
        "CMP" => true
        "CPX" => true
        "CPY" => true
        "DEC" => true
        "DEX" => true
        "DEY" => true
        "EOR" => true
        "INC" => true
        "INX" => true
        "INY" => true
        "JMP" => true
        "JSR" => true
        "LDA" => true
        "LDX" => true
        "LDY" => true
        "LSR" => true
        "NOP" => true
        "ORA" => true
        "PHA" => true
        "PHP" => true
        "PLA" => true
        "PLP" => true
        "ROL" => true
        "ROR" => true
        "RTI" => true
        "RTS" => true
        "SBC" => true
        "SEC" => true
        "SED" => true
        "SEI" => true
        "STA" => true
        "STX" => true
        "STY" => true
        "TAX" => true
        "TAY" => true
        "TSX" => true
        "TXA" => true
        "TXS" => true
        "TYA" => true
        _ => false

