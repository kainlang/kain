    trait_generics: Array<Type>
    target_type: Type
    methods: Array<Function>
    span: Span

pub enum PointerProvenance:
    Raw
    ImportedC
    ImportedAsm
    LoweredRef

pub enum Type:
    Named { name: String, generics: Array<Type>, span: Span }
    Tuple(Array<Type>, Span)
    Array(Box<Type>, usize, Span)
    Slice(Box<Type>, Span)
    Ref { mutable_: Bool, inner: Box<Type>, lifetime: Option<String>, span: Span }
    Ptr { mutable_: Bool, inner: Box<Type>, provenance: PointerProvenance, span: Span }
    Function { params: Array<Type>, return_type: Box<Type>, effects: Array<Effect>, span: Span }
    Option(Box<Type>, Span)
    Result(Box<Type>, Box<Type>, Span)
    Infer(Span)
    Never(Span)
    Unit(Span)
    Impl { trait_name: String, generics: Array<Type>, span: Span }

impl Type:
    pub fn span(_self: &Type) -> Span:
        match _self:
            Type::Named { span: span } => span.clone()
            Type::Tuple(_, span) => span.clone()
            Type::Array(_, _, span) => span.clone()
            Type::Slice(_, span) => span.clone()
            Type::Ref { span: span } => span.clone()
            Type::Ptr { span: span } => span.clone()
            Type::Function { span: span } => span.clone()
            Type::Option(_, span) => span.clone()
            Type::Result(_, _, span) => span.clone()
            Type::Infer(span) => span.clone()
            Type::Never(span) => span.clone()
            Type::Unit(span) => span.clone()
            Type::Impl { span: span } => span.clone()

    pub fn contains_raw_ptr(_self: &Type) -> Bool:
        match *_self:
            Type::Ptr {  } => true
            Type::Named { generics: generics } => generics.iter().any(fn(ty): ty.contains_raw_ptr())
            Type::Tuple(types, _) => types.iter().any(fn(ty): ty.contains_raw_ptr())
            Type::Array(inner, _, _) => inner.contains_raw_ptr()
            Type::Slice(inner, _) => inner.contains_raw_ptr()
            Type::Ref { inner: inner } => inner.contains_raw_ptr()
            Type::Option(inner, _) => inner.contains_raw_ptr()
            Type::Function { params: params, return_type: return_type } => (params.iter().any(fn(ty): ty.contains_raw_ptr()) || return_type.contains_raw_ptr())
            Type::Result(ok, err, _) => (ok.contains_raw_ptr() || err.contains_raw_ptr())
            Type::Impl { generics: generics } => generics.iter().any(fn(ty): ty.contains_raw_ptr())
            Type::Infer(_) => false
            Type::Never(_) => false
            Type::Unit(_) => false


