    span: Span

pub enum Stmt:
    Let { pattern: Pattern, ty: Option<Type>, value: Option<Expr>, span: Span }
    Expr(Expr)
    Return(Option<Expr>, Span)
    Break(Option<Expr>, Span)
    Continue(Span)
    For { binding: Pattern, iter: Expr, body: Block, span: Span }
    While { condition: Expr, body: Block, span: Span }
    Loop { body: Block, span: Span }
    Item(Box<Item>)

pub enum Expr:
    Int(i64, Span)
    Float(f64, Span)
    String(String, Span)
    FString(Array<Expr>, Span)
    Bool(Bool, Span)
    None(Span)
    Ident(String, Span)
    MacroCall { name: String, args: Array<Expr>, span: Span }
    Binary { left: Box<Expr>, op: BinaryOp, right: Box<Expr>, span: Span }
    Unary { op: UnaryOp, operand: Box<Expr>, span: Span }
    Call { callee: Box<Expr>, args: Array<CallArg>, span: Span }
    StageCall { runtime: OrchestrateStageRuntime, function: String, args: Array<CallArg>, span: Span }
    MethodCall { receiver: Box<Expr>, method: String, args: Array<CallArg>, span: Span }
    Field { object: Box<Expr>, field: String, span: Span }
    Index { object: Box<Expr>, index: Box<Expr>, span: Span }
    Assign { target: Box<Expr>, value: Box<Expr>, span: Span }
    Struct { name: String, fields: Array<(String, Expr)>, rest: Option<Box<Expr>>, span: Span }
    AggregateInit { ty: Type, fields: Array<(String, Expr)>, zero_fill_rest: Bool, span: Span }
    EnumVariant { enum_name: String, variant: String, fields: EnumVariantFields, span: Span }
    Array(Array<Expr>, Span)
    Tuple(Array<Expr>, Span)
    Range { start: Option<Box<Expr>>, end: Option<Box<Expr>>, inclusive: Bool, span: Span }
    If { condition: Box<Expr>, then_branch: Block, else_branch: Option<Box<ElseBranch>>, span: Span }
    Match { scrutinee: Box<Expr>, arms: Array<MatchArm>, span: Span }
    Lambda { params: Array<Param>, return_type: Option<Type>, body: Box<Expr>, span: Span }
    Ref { mutable_: Bool, value: Box<Expr>, span: Span }
    AddrOf { value: Box<Expr>, pointee_ty: Option<Type>, span: Span }
    Deref(Box<Expr>, Span)
    PtrOffset { pointer: Box<Expr>, offset: Box<Expr>, element_ty: Option<Type>, span: Span }
    MemLoad { pointer: Box<Expr>, load_ty: Option<Type>, span: Span }
    MemStore { pointer: Box<Expr>, value: Box<Expr>, store_ty: Option<Type>, span: Span }
    SizeOfType { target: Type, span: Span }
    AlignOfType { target: Type, span: Span }
    Alloca { ty: Type, span: Span }
    Uninit { ty: Type, span: Span }
    Alloc { size: Box<Expr>, ty: Option<Type>, zeroed: Bool, span: Span }
    Realloc { pointer: Box<Expr>, size: Box<Expr>, ty: Option<Type>, zeroed_new: Bool, span: Span }
    Cast { value: Box<Expr>, target: Type, span: Span }
    Try(Box<Expr>, Span)
    Await(Box<Expr>, Span)
    AsyncBlock(Box<Expr>, Span)
    Spawn { actor_: String, init: Array<(String, Expr)>, span: Span }
    SendMsg { target: Box<Expr>, message: String, data: Array<(String, Expr)>, span: Span }
    Comptime(Box<Expr>, Span)
    Block(Block, Span)
    JSX(JSXNode, Span)
    Paren(Box<Expr>, Span)
    Return(Option<Box<Expr>>, Span)
    Break(Option<Box<Expr>>, Span)
    Continue(Span)

impl Expr:
    pub fn span(_self: &Expr) -> Span:
        match _self:
            Expr::Int(_, s) => s.clone()
            Expr::Float(_, s) => s.clone()
            Expr::String(_, s) => s.clone()
            Expr::FString(_, s) => s.clone()
            Expr::Bool(_, s) => s.clone()
            Expr::None(s) => s.clone()
            Expr::Ident(_, s) => s.clone()
            Expr::Binary { span: s } => s.clone()
            Expr::Unary { span: s } => s.clone()
            Expr::Call { span: s } => s.clone()
            Expr::MethodCall { span: s } => s.clone()
            Expr::Field { span: s } => s.clone()
            Expr::Index { span: s } => s.clone()
            Expr::Struct { span: s } => s.clone()
            Expr::AggregateInit { span: s } => s.clone()
            Expr::EnumVariant { span: s } => s.clone()
            Expr::Array(_, s) => s.clone()
            Expr::Tuple(_, s) => s.clone()
            Expr::Range { span: s } => s.clone()
            Expr::If { span: s } => s.clone()
            Expr::Match { span: s } => s.clone()
            Expr::Lambda { span: s } => s.clone()
            Expr::Ref { span: s } => s.clone()
            Expr::AddrOf { span: s } => s.clone()
            Expr::Deref(_, s) => s.clone()
            Expr::PtrOffset { span: s } => s.clone()
            Expr::MemLoad { span: s } => s.clone()
            Expr::MemStore { span: s } => s.clone()
            Expr::SizeOfType { span: s } => s.clone()
            Expr::AlignOfType { span: s } => s.clone()
            Expr::Alloca { span: s } => s.clone()
            Expr::Uninit { span: s } => s.clone()
            Expr::Alloc { span: s } => s.clone()
            Expr::Realloc { span: s } => s.clone()
            Expr::Cast { span: s } => s.clone()
            Expr::Try(_, s) => s.clone()
            Expr::Await(_, s) => s.clone()
            Expr::Spawn { span: s } => s.clone()
            Expr::SendMsg { span: s } => s.clone()
            Expr::Comptime(_, s) => s.clone()
            Expr::MacroCall { span: s } => s.clone()
            Expr::Block(_, s) => s.clone()
            Expr::JSX(_, s) => s.clone()
            Expr::Assign { span: s } => s.clone()
            Expr::Paren(_, s) => s.clone()
            Expr::Return(_, s) => s.clone()
            Expr::Break(_, s) => s.clone()
            Expr::Continue(s) => s.clone()


