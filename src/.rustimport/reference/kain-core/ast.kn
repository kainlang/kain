use crate::effects::Effect

use crate::span::Span

use std::fmt

pub const COMPUTE_PLAN_BINDING_NAMES: Array<String> = ["compute", "compute_plan"]

pub const COMPUTE_TENSOR_DEFAULT_CONTRACT: String = "kain.shared.buffer"

pub const COMPUTE_TENSOR_DEFAULT_ROLE: String = "state"

pub const COMPUTE_STREAM_DEFAULT_CONTRACT: String = "kain.shared.buffer"

pub const COMPUTE_STREAM_DEFAULT_CADENCE: String = "continuous"

pub const COMPUTE_PLAN_CAPABILITY_KEY: String = "gpu.compute-plan"

@doc(doc = " A complete KAIN program/module")
@derive(Debug, Clone, PartialEq)
pub struct Program:
    items: Array<Item>
    span: Span

pub enum Item:
    Function(Function)
    Patch(PatchDef)
    Law(LawDef)
    Converge(ConvergeDef)
    World(WorldDef)
    Orchestrate(OrchestrateDef)
    Component(Component)
    Shader(Shader)
    Actor(Actor)
    Struct(Struct)
    Enum(Enum)
    Trait(Trait)
    Impl(Impl)
    TypeAlias(TypeAlias)
    Use(Use)
    Mod(Mod)
    Const(Const)
    Comptime(ComptimeBlock)
    Macro(MacroDef)
    Test(TestDef)
    MaterialGraph(MaterialGraphDef)
    MaterialFunction(MaterialFunctionDef)
    GraphEditor(GraphEditorDef)
    GraphRuntime(GraphRuntimeDef)
    StateMachine(StateMachineDef)
    AsyncTask(AsyncTaskDef)
    EditorModule(EditorModuleDef)
    GameplayTags(GameplayTagsNamespace)
    GameplayAbility(GameplayAbilityDef)
    GameplayEffect(GameplayEffectDef)
    GameplayCue(GameplayCueDef)
    AbilityTask(AbilityTaskDef)
    TargetActor(TargetActorDef)

@derive(Debug, Clone, PartialEq)
pub struct TestDef:
    name: String
    body: Block
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct PatchDef:
    name: String
    params: Array<Param>
    return_type: Option<Type>
    body: Block
    visibility: Visibility
    attributes: Array<Attribute>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct LawDef:
    name: String
    params: Array<Param>
    return_type: Type
    body: Block
    visibility: Visibility
    attributes: Array<Attribute>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct ConvergeDef:
    name: String
    params: Array<Param>
    return_type: Option<Type>
    spec_lane: ConvergeLane
    fast_lanes: Array<ConvergeLane>
    verify_random_count: Option<u32>
    visibility: Visibility
    attributes: Array<Attribute>
    span: Span

pub enum ConvergeLaneKind:
    Spec
    Fast

pub enum ConvergeSelector:
    Target(String)
    Capability(String)

@derive(Debug, Clone, PartialEq)
pub struct ConvergeLane:
    kind: ConvergeLaneKind
    lane_name: String
    selector: Option<ConvergeSelector>
    body: Block
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct WorldDef:
    name: String
    states: Array<WorldStateSlot>
    surfaces: Array<WorldSurfaceProjection>
    visibility: Visibility
    attributes: Array<Attribute>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct WorldStateSlot:
    name: String
    ty: Type
    initial: Expr
    span: Span

pub enum WorldSurfaceKind:
    NativeUi
    Viewport3d
    Web
    Ue5

impl WorldSurfaceKind:
    pub fn as_str(_self: &WorldSurfaceKind) -> String:
        match *_self:
            WorldSurfaceKind::NativeUi => "native_ui"
            WorldSurfaceKind::Viewport3d => "viewport3d"
            WorldSurfaceKind::Web => "web"
            WorldSurfaceKind::Ue5 => "ue5"


@derive(Debug, Clone, PartialEq)
pub struct WorldSurfaceProjection:
    kind: WorldSurfaceKind
    expr: Expr
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct OrchestrateDef:
    name: String
    params: Array<Param>
    return_type: Option<Type>
    body: Block
    visibility: Visibility
    attributes: Array<Attribute>
    span: Span

pub enum OrchestrateStageRuntime:
    Kain
    Rust
    Python
    Node

impl OrchestrateStageRuntime:
    pub fn as_str(_self: &OrchestrateStageRuntime) -> String:
        match *_self:
            OrchestrateStageRuntime::Kain => "kain"
            OrchestrateStageRuntime::Rust => "rust"
            OrchestrateStageRuntime::Python => "python"
            OrchestrateStageRuntime::Node => "node"


@doc(doc = " Function attribute/decorator (e.g., @wasm, @js, @inline)")
@derive(Debug, Clone, PartialEq)
pub struct Attribute:
    name: String
    args: Array<Expr>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct Function:
    name: String
    generics: Array<Generic>
    params: Array<Param>
    return_type: Option<Type>
    effects: Array<Effect>
    body: Block
    visibility: Visibility
    attributes: Array<Attribute>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct Param:
    name: String
    ty: Type
    mutable_: Bool
    default_: Option<Expr>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct Generic:
    name: String
    bounds: Array<TypeBound>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct TypeBound:
    trait_name: String
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct Component:
    name: String
    props: Array<Param>
    state_: Array<StateDecl>
    methods: Array<Function>
    effects: Array<Effect>
    body: JSXNode
    visibility: Visibility
    attributes: Array<Attribute>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct StateDecl:
    name: String
    ty: Type
    initial: Expr
    weak_: Bool
    attributes: Array<Attribute>
    span: Span

pub enum JSXNode:
    Element { tag: String, attributes: Array<JSXAttribute>, children: Array<JSXNode>, span: Span }
    Expression(Box<Expr>)
    Text(String, Span)
    ComponentCall { name: String, props: Array<JSXAttribute>, children: Array<JSXNode>, span: Span }
    For { binding: String, iter: Box<Expr>, body: Box<JSXNode>, span: Span }
    If { condition: Box<Expr>, then_branch: Box<JSXNode>, else_branch: Option<Box<JSXNode>>, span: Span }
    Fragment(Array<JSXNode>, Span)

@derive(Debug, Clone, PartialEq)
pub struct JSXAttribute:
    name: String
    value: JSXAttrValue
    span: Span

pub enum JSXAttrValue:
    String(String)
    Expr(Expr)
    Bool(Bool)

@derive(Debug, Clone, PartialEq)
pub struct Shader:
    name: String
    stage: ShaderStage
    inputs: Array<Param>
    outputs: Type
    uniforms: Array<Uniform>
    body: Block
    span: Span

pub enum ShaderStage:
    Vertex
    Fragment
    Compute
    Surface

@derive(Debug, Clone, PartialEq)
pub struct Uniform:
    name: String
    ty: Type
    binding: u32
    span: Span

@doc(doc = " Explicit compute metadata authored in a compute shader's `comptime` block.")
@doc(doc = "")
@doc(doc = " Convention:")
@doc(doc = " Legacy form:")
@doc(doc = " `let compute = ([dispatch_x, dispatch_y, dispatch_z], [tensor_plans], [node_plans])`")
@doc(doc = "")
@doc(doc = " Extended form:")
@doc(doc = " `let compute = ([wg_x, wg_y, wg_z], [dispatch_x, dispatch_y, dispatch_z], [tensor_plans], [stream_plans], [node_plans])`")
@doc(doc = "")
@doc(doc = " Tensor plans are tuples of:")
@doc(doc = " `(\"binding\", \"element_type\", [\"shape\", \"dims\"], \"role\", \"contract\")`")
@doc(doc = " with `role` defaulting to `state` and `contract` defaulting to")
@doc(doc = " `kain.shared.buffer`.")
@doc(doc = "")
@doc(doc = " Stream plans are tuples of:")
@doc(doc = " `(\"binding\", \"direction\", \"cadence\", \"contract\")`")
@doc(doc = " with `cadence` defaulting to `continuous` and `contract` defaulting to")
@doc(doc = " `kain.shared.buffer`.")
@doc(doc = "")
@doc(doc = " Neural node plans are tuples of:")
@doc(doc = " `(\"node_key\", \"op\", [\"inputs\"], [\"outputs\"], stateful)`")
@doc(doc = " with `stateful` defaulting to `false`.")
@derive(Debug, Clone, PartialEq, Eq, Default)
pub struct ComputeMetadata:
    workgroup_size: Option<[u32; 3]>
    dispatch_size: [u32; 3]
    tensor_plans: Array<ComputeTensorPlan>
    stream_plans: Option<Array<ComputeStreamPlan>>
    neural_node_plans: Array<ComputeNeuralNodePlan>

impl Default for ComputeMetadata:
    pub fn default_() -> ComputeMetadata:
        ComputeMetadata { workgroup_size: none, dispatch_size: [], tensor_plans: Vec__new_(), stream_plans: none, neural_node_plans: Vec__new_() }


@derive(Debug, Clone, PartialEq, Eq)
pub struct ComputeTensorPlan:
    key: String
    element_type: String
    shape: Array<String>
    role: String
    contract: String

@derive(Debug, Clone, PartialEq, Eq)
pub struct ComputeStreamPlan:
    key: String
    direction: String
    cadence: String
    contract: String

@derive(Debug, Clone, PartialEq, Eq)
pub struct ComputeNeuralNodePlan:
    key: String
    op: String
    inputs: Array<String>
    outputs: Array<String>
    stateful: Bool

pub enum ComputeMetadataError:
    MissingDispatchPlan
    InvalidPlanShape(String)
    InvalidDispatchShape(String)
    InvalidTensorPlan(String)
    InvalidNeuralNodePlan(String)

impl std::fmt::Display for ComputeMetadataError:
    fn fmt(_self: &ComputeMetadataError, f: &mut std::fmt::Formatter<_>) -> Result<(), Error>:
        match *_self:
            ComputeMetadataError::MissingDispatchPlan => __kain_write_fmt!(f, "compute plan is missing a dispatch size")
            ComputeMetadataError::InvalidPlanShape(message) => __kain_write_fmt!(f, f"invalid compute plan structure: {message}")
            ComputeMetadataError::InvalidDispatchShape(message) => __kain_write_fmt!(f, f"invalid dispatch size: {message}")
            ComputeMetadataError::InvalidTensorPlan(message) => __kain_write_fmt!(f, f"invalid tensor plan: {message}")
            ComputeMetadataError::InvalidNeuralNodePlan(message) => __kain_write_fmt!(f, f"invalid neural node plan: {message}")


impl error::Error for ComputeMetadataError:
    fn __selfhost_empty_impl__():
        let __selfhost_empty = none

impl Shader:
    pub fn explicit_compute_metadata(_self: &Shader) -> Result<Option<ComputeMetadata>, ComputeMetadataError>:
        extract_compute_metadata_from_block(&(*_self).body)


fn extract_compute_metadata_from_block(block: &Block) -> Result<Option<ComputeMetadata>, ComputeMetadataError>:
    for stmt in &(*block).stmts:
        match stmt:
            Stmt::Item(item) =>
                match item:
                    Item::Comptime(comptime_) =>
                        match (extract_compute_metadata_from_comptime_block(&comptime_.body)?):
                            Some(metadata) => return Result::Ok(Option::Some(metadata))
                            _ => ()
                    _ => ()
            _ => ()
    ()
    Result::Ok(none)

fn extract_compute_metadata_from_comptime_block(block: &Block) -> Result<Option<ComputeMetadata>, ComputeMetadataError>:
    for stmt in &(*block).stmts:
        match stmt:
            Stmt::Let { pattern: Pattern::Binding { name: name }, value: Some(expr) } =>
                if is_compute_plan_binding(name):
                    return parse_compute_metadata_expr(expr).map(fn(metadata): Option::Some(metadata))
                else:
                    ()
            Stmt::Item(item) =>
                match item:
                    Item::Comptime(comptime_) =>
                        match (extract_compute_metadata_from_comptime_block(&comptime_.body)?):
                            Some(metadata) => return Result::Ok(Option::Some(metadata))
                            _ => ()
                    _ => ()
            _ => ()
    Result::Ok(none)

fn is_compute_plan_binding(name: String) -> Bool:
    match name:
        "compute" => true
        "compute_plan" => true
        _ => false

fn parse_compute_metadata_expr(expr: &Expr) -> Result<ComputeMetadata, ComputeMetadataError>:
    let tuple_items = match expr:
        Expr::Tuple(items, _) => items
        Expr::Array(items, _) => items
        Expr::Paren(inner, _) => return parse_compute_metadata_expr(inner)
        _ => return Result::Err(ComputeMetadataError::InvalidPlanShape(("expected a tuple or array with either (dispatch, tensors, nodes) or (workgroup, dispatch, tensors, streams, nodes)").to_string()))
    let (workgroup_size, dispatch_expr, tensor_expr, stream_expr, node_expr) = match tuple_items.as_slice():
        [dispatch_expr, tensor_expr, node_expr] => (none, dispatch_expr, tensor_expr, none, node_expr)
        [workgroup_expr, dispatch_expr, tensor_expr, stream_expr, node_expr] => (Option::Some(parse_workgroup_size_expr(workgroup_expr)?), dispatch_expr, tensor_expr, Option::Some(stream_expr), node_expr)
        _ => return Result::Err(ComputeMetadataError::InvalidPlanShape(f"expected 3 entries (dispatch, tensors, nodes) or 5 entries (workgroup, dispatch, tensors, streams, nodes), found {tuple_items.len()}"))
    let dispatch_size = parse_dispatch_size_expr(dispatch_expr)?
    let tensor_plans = parse_tensor_plan_list_expr(tensor_expr)?
    let stream_plans = match stream_expr:
        Some(expr) => Option::Some(parse_stream_plan_list_expr(expr)?)
        _ =>
            none
    let neural_node_plans = parse_neural_node_plan_list_expr(node_expr)?
    Result::Ok(ComputeMetadata { workgroup_size: workgroup_size, dispatch_size: dispatch_size, tensor_plans: tensor_plans, stream_plans: stream_plans, neural_node_plans: neural_node_plans })

fn parse_workgroup_size_expr(expr: &Expr) -> Result<[u32; 3], ComputeMetadataError>:
    parse_dimension_triplet_expr(expr, "workgroup").map_err(fn(__kain_closure_arg1): ComputeMetadataError::InvalidPlanShape(__kain_closure_arg1))

fn parse_dispatch_size_expr(expr: &Expr) -> Result<[u32; 3], ComputeMetadataError>:
    parse_dimension_triplet_expr(expr, "dispatch").map_err(fn(__kain_closure_arg2): ComputeMetadataError::InvalidDispatchShape(__kain_closure_arg2))

fn parse_dimension_triplet_expr(expr: &Expr, label: String) -> Result<[u32; 3], String>:
    let items = match expr:
        Expr::Array(items, _) => items
        Expr::Tuple(items, _) => items
        Expr::Paren(inner, _) => return parse_dimension_triplet_expr(inner, label)
        _ => return Result::Err(("expected an array or tuple of three integers").to_string())
    if (items.len() != 3):
        return Result::Err(f"expected exactly 3 dimensions, found {items.len()}")
    let mut dispatch = [0, 0, 0]
    for selfhost_for_item in items.iter().enumerate():
        let (index, item) = selfhost_for_item
        let value = match item:
            Expr::Int(n, _) if (((*n) >= 0) && ((*n) <= u32__MAX as i64)) => (*n) as u32
            Expr::Paren(inner, _) =>
                match &(*(*inner)):
                    Expr::Int(n, _) if (((*n) >= 0) && ((*n) <= u32__MAX as i64)) => (*n) as u32
                    _ => return Result::Err(f"{label} dimension {index} must be a non-negative integer literal")
            _ => return Result::Err(f"{label} dimension {index} must be a non-negative integer literal")
        dispatch[index] = value
        ()
    ()
    Result::Ok(dispatch)

fn parse_tensor_plan_list_expr(expr: &Expr) -> Result<Array<ComputeTensorPlan>, ComputeMetadataError>:
    let items = match expr:
        Expr::Array(items, _) => items
        Expr::Tuple(items, _) => items
        Expr::Paren(inner, _) => return parse_tensor_plan_list_expr(inner)
        _ => return Result::Err(ComputeMetadataError::InvalidTensorPlan(("expected an array or tuple of tensor plan entries").to_string()))
    let mut plans = (fn(__kain_ctor_arg0): Vec__new_())(items.len())
    for item in items:
        plans.push(parse_tensor_plan_expr(item)?)
        ()
    ()
    Result::Ok(plans)

fn parse_tensor_plan_expr(expr: &Expr) -> Result<ComputeTensorPlan, ComputeMetadataError>:
    let fields = match expr:
        Expr::Tuple(items, _) => items
        Expr::Array(items, _) => items
        Expr::Paren(inner, _) => return parse_tensor_plan_expr(inner)
        _ => return Result::Err(ComputeMetadataError::InvalidTensorPlan(("expected tensor plan to be a tuple or array").to_string()))
    if (fields.len() < 3):
        return Result::Err(ComputeMetadataError::InvalidTensorPlan(("tensor plan needs at least binding, element type, and shape").to_string()))
    let key = expr_to_plan_string(&fields[0]).map_err(fn(__kain_closure_arg3): ComputeMetadataError::InvalidTensorPlan(__kain_closure_arg3))?
    let element_type = expr_to_plan_string(&fields[1]).map_err(fn(__kain_closure_arg4): ComputeMetadataError::InvalidTensorPlan(__kain_closure_arg4))?
    let shape = parse_string_list_expr(&fields[2]).map_err(fn(__kain_closure_arg5): ComputeMetadataError::InvalidTensorPlan(__kain_closure_arg5))?
    let role = match fields.get(3):
        Some(expr) => expr_to_plan_string(expr).map_err(fn(__kain_closure_arg6): ComputeMetadataError::InvalidTensorPlan(__kain_closure_arg6))?
        _ => COMPUTE_TENSOR_DEFAULT_ROLE.to_string()
    let contract = match fields.get(4):
        Some(expr) => expr_to_plan_string(expr).map_err(fn(__kain_closure_arg7): ComputeMetadataError::InvalidTensorPlan(__kain_closure_arg7))?
        _ => COMPUTE_TENSOR_DEFAULT_CONTRACT.to_string()
    Result::Ok(ComputeTensorPlan { key: key, element_type: element_type, shape: shape, role: role, contract: contract })

fn parse_stream_plan_list_expr(expr: &Expr) -> Result<Array<ComputeStreamPlan>, ComputeMetadataError>:
    let items = match expr:
        Expr::Array(items, _) => items
        Expr::Tuple(items, _) => items
        Expr::Paren(inner, _) => return parse_stream_plan_list_expr(inner)
        _ => return Result::Err(ComputeMetadataError::InvalidPlanShape(("expected an array or tuple of stream plan entries").to_string()))
    let mut plans = (fn(__kain_ctor_arg0): Vec__new_())(items.len())
    for item in items:
        plans.push(parse_stream_plan_expr(item)?)
        ()
    ()
    Result::Ok(plans)

fn parse_stream_plan_expr(expr: &Expr) -> Result<ComputeStreamPlan, ComputeMetadataError>:
    let fields = match expr:
        Expr::Tuple(items, _) => items
        Expr::Array(items, _) => items
        Expr::Paren(inner, _) => return parse_stream_plan_expr(inner)
        _ => return Result::Err(ComputeMetadataError::InvalidPlanShape(("expected stream plan to be a tuple or array").to_string()))
    if (fields.len() < 2):
        return Result::Err(ComputeMetadataError::InvalidPlanShape(("stream plan needs at least binding and direction").to_string()))
    let key = expr_to_plan_string(&fields[0]).map_err(fn(__kain_closure_arg8): ComputeMetadataError::InvalidPlanShape(__kain_closure_arg8))?
    let direction = expr_to_plan_string(&fields[1]).map_err(fn(__kain_closure_arg9): ComputeMetadataError::InvalidPlanShape(__kain_closure_arg9))?
    let cadence = match fields.get(2):
        Some(expr) => expr_to_plan_string(expr).map_err(fn(__kain_closure_arg10): ComputeMetadataError::InvalidPlanShape(__kain_closure_arg10))?
        _ => COMPUTE_STREAM_DEFAULT_CADENCE.to_string()
    let contract = match fields.get(3):
        Some(expr) => expr_to_plan_string(expr).map_err(fn(__kain_closure_arg11): ComputeMetadataError::InvalidPlanShape(__kain_closure_arg11))?
        _ => COMPUTE_STREAM_DEFAULT_CONTRACT.to_string()
    Result::Ok(ComputeStreamPlan { key: key, direction: direction, cadence: cadence, contract: contract })

fn parse_neural_node_plan_list_expr(expr: &Expr) -> Result<Array<ComputeNeuralNodePlan>, ComputeMetadataError>:
    let items = match expr:
        Expr::Array(items, _) => items
        Expr::Tuple(items, _) => items
        Expr::Paren(inner, _) => return parse_neural_node_plan_list_expr(inner)
        _ => return Result::Err(ComputeMetadataError::InvalidNeuralNodePlan(("expected an array or tuple of neural node plan entries").to_string()))
    let mut plans = (fn(__kain_ctor_arg0): Vec__new_())(items.len())
    for item in items:
        plans.push(parse_neural_node_plan_expr(item)?)
        ()
    ()
    Result::Ok(plans)

fn parse_neural_node_plan_expr(expr: &Expr) -> Result<ComputeNeuralNodePlan, ComputeMetadataError>:
    let fields = match expr:
        Expr::Tuple(items, _) => items
        Expr::Array(items, _) => items
        Expr::Paren(inner, _) => return parse_neural_node_plan_expr(inner)
        _ => return Result::Err(ComputeMetadataError::InvalidNeuralNodePlan(("expected neural node plan to be a tuple or array").to_string()))
    if (fields.len() < 4):
        return Result::Err(ComputeMetadataError::InvalidNeuralNodePlan(("neural node plan needs at least key, op, inputs, and outputs").to_string()))
    let key = expr_to_plan_string(&fields[0]).map_err(fn(__kain_closure_arg12): ComputeMetadataError::InvalidNeuralNodePlan(__kain_closure_arg12))?
    let op = expr_to_plan_string(&fields[1]).map_err(fn(__kain_closure_arg13): ComputeMetadataError::InvalidNeuralNodePlan(__kain_closure_arg13))?
    let inputs = parse_string_list_expr(&fields[2]).map_err(fn(__kain_closure_arg14): ComputeMetadataError::InvalidNeuralNodePlan(__kain_closure_arg14))?
    let outputs = parse_string_list_expr(&fields[3]).map_err(fn(__kain_closure_arg15): ComputeMetadataError::InvalidNeuralNodePlan(__kain_closure_arg15))?
    let stateful = match fields.get(4):
        Some(expr) => parse_bool_expr(expr).map_err(fn(__kain_closure_arg16): ComputeMetadataError::InvalidNeuralNodePlan(__kain_closure_arg16))?
        _ => false
    Result::Ok(ComputeNeuralNodePlan { key: key, op: op, inputs: inputs, outputs: outputs, stateful: stateful })

fn parse_string_list_expr(expr: &Expr) -> Result<Array<String>, String>:
    let items = match expr:
        Expr::Array(items, _) => items
        Expr::Tuple(items, _) => items
        Expr::Paren(inner, _) => return parse_string_list_expr(inner)
        _ => return Result::Err(("expected an array or tuple of strings").to_string())
    let mut values = (fn(__kain_ctor_arg0): Vec__new_())(items.len())
    for item in items:
        values.push(expr_to_plan_string(item)?)
        ()
    ()
    Result::Ok(values)

fn parse_bool_expr(expr: &Expr) -> Result<Bool, String>:
    match expr:
        Expr::Bool(value, _) => Result::Ok((*value))
        Expr::Paren(inner, _) => parse_bool_expr(inner)
        _ => Result::Err(("expected a boolean literal").to_string())

fn expr_to_plan_string(expr: &Expr) -> Result<String, String>:
    match expr:
        Expr::String(value, _) => Result::Ok(value.clone())
        Expr::Ident(value, _) => Result::Ok(value.clone())
        Expr::Int(value, _) => Result::Ok(value.to_string())
        Expr::Float(value, _) => Result::Ok(value.to_string())
        Expr::Bool(value, _) => Result::Ok(value.to_string())
        Expr::None(_) => Result::Ok(("none").to_string())
        Expr::Field { object: object, field: field } => Result::Ok(f"{expr_to_plan_string(object)?}.{field}")
        Expr::Paren(inner, _) => expr_to_plan_string(inner)
        Expr::Array(items, _) =>
            let rendered = items.iter().map(expr_to_plan_string).collect()?
            Result::Ok(rendered.join(", "))
        Expr::Tuple(items, _) =>
            let rendered = items.iter().map(expr_to_plan_string).collect()?
            Result::Ok(rendered.join(", "))
        Expr::Call { callee: callee, args: args } =>
            let mut rendered_args = (fn(__kain_ctor_arg0): Vec__new_())(args.len())
            for arg in args:
                let rendered_value = expr_to_plan_string(&arg.value)?
                match &arg.name:
                    Some(name) =>
                        rendered_args.push(f"{name}={rendered_value}")
                        ()
                    _ =>
                        rendered_args.push(rendered_value)
                        ()
            ()
            Result::Ok("{expr_to_plan_string(callee)?}({rendered_args.join(\", \")})")
        other => Result::Err(f"unsupported expression shape: {other}")

@derive(Debug, Clone, PartialEq)
pub struct Actor:
    name: String
    state_: Array<StateDecl>
    handlers: Array<MessageHandler>
    methods: Array<Function>
    attributes: Array<Attribute>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct MessageHandler:
    message_type: String
    params: Array<Param>
    body: Block
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct Struct:
    name: String
    generics: Array<Generic>
    fields: Array<Field>
    methods: Array<Function>
    attributes: Array<Attribute>
    visibility: Visibility
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct Field:
    name: String
    ty: Type
    attributes: Array<Attribute>
    visibility: Visibility
    default_: Option<Expr>
    weak_: Bool
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct Enum:
    name: String
    generics: Array<Generic>
    variants: Array<Variant>
    visibility: Visibility
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct Variant:
    name: String
    fields: VariantFields
    span: Span

pub enum VariantFields:
    Unit
    Tuple(Array<Type>)
    Struct(Array<Field>)

@derive(Debug, Clone, PartialEq)
pub struct Trait:
    name: String
    generics: Array<Generic>
    supertraits: Array<Type>
