use std::collections::HashSet

@doc(doc = " Collect all type names referenced by an AST Item.")
@doc(doc = " Returns a set of raw type name strings (e.g. \"Vec3\", \"QuestStatus\", \"Actor\").")
pub fn collect_referenced_type_names(item: &Item) -> Set<String>:
    let mut names = HashSet__new_()
    collect_type_names_from_item(item, &mut names)
    ()
    names

@doc(doc = " Master dispatcher: walks all fields of an Item variant that may contain type references.")
fn collect_type_names_from_item(item: &Item, out_: &mut Set<String>):
    match item:
        Item::Function(f) =>
            for p in &f.params:
                collect_type_names_from_type(&p.ty, out_)
                ()
                match &p.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                        ()
                    _ => ()
            ()
            match &f.return_type:
                Some(ret) =>
                    collect_type_names_from_type(ret, out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            collect_type_names_from_block(&f.body, out_)
            ()
            for attr in &f.attributes:
                for arg in &attr.args:
                    collect_type_names_from_expr(arg, out_)
                    ()
        Item::Patch(patch) =>
            for param in &patch.params:
                collect_type_names_from_type(&param.ty, out_)
                ()
                match &param.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                        ()
                    _ => ()
            ()
            match &patch.return_type:
                Some(ret) =>
                    collect_type_names_from_type(ret, out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            collect_type_names_from_block(&patch.body, out_)
            ()
            for attr in &patch.attributes:
                for arg in &attr.args:
                    collect_type_names_from_expr(arg, out_)
                    ()
        Item::Law(law) =>
            for param in &law.params:
                collect_type_names_from_type(&param.ty, out_)
                ()
                match &param.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                        ()
                    _ => ()
            ()
            collect_type_names_from_type(&law.return_type, out_)
            ()
            collect_type_names_from_block(&law.body, out_)
            ()
            for attr in &law.attributes:
                for arg in &attr.args:
                    collect_type_names_from_expr(arg, out_)
                    ()
        Item::Converge(converge) =>
            for param in &converge.params:
                collect_type_names_from_type(&param.ty, out_)
                ()
                match &param.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                        ()
                    _ => ()
            ()
            match &converge.return_type:
                Some(ret) =>
                    collect_type_names_from_type(ret, out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            collect_type_names_from_block(&converge.spec_lane.body, out_)
            ()
            for lane in &converge.fast_lanes:
                collect_type_names_from_block(&lane.body, out_)
                ()
            ()
            for attr in &converge.attributes:
                for arg in &attr.args:
                    collect_type_names_from_expr(arg, out_)
                    ()
        Item::World(world) =>
            for state_ in &world.states:
                collect_type_names_from_type(&state_.ty, out_)
                ()
                collect_type_names_from_expr(&state_.initial, out_)
                ()
            ()
            for surface in &world.surfaces:
                collect_type_names_from_expr(&surface.expr, out_)
                ()
            ()
            for attr in &world.attributes:
                for arg in &attr.args:
                    collect_type_names_from_expr(arg, out_)
                    ()
        Item::Orchestrate(orchestrate) =>
            for param in &orchestrate.params:
                collect_type_names_from_type(&param.ty, out_)
                ()
                match &param.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                        ()
                    _ => ()
            ()
            match &orchestrate.return_type:
                Some(ret) =>
                    collect_type_names_from_type(ret, out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            collect_type_names_from_block(&orchestrate.body, out_)
            ()
            for attr in &orchestrate.attributes:
                for arg in &attr.args:
                    collect_type_names_from_expr(arg, out_)
                    ()
        Item::Struct(s) =>
            for f in &s.fields:
                collect_type_names_from_type(&f.ty, out_)
                ()
                match &f.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                        ()
                    _ => ()
            ()
            for method in &s.methods:
                collect_type_names_from_item(&Item::Function(method.clone()), out_)
                ()
        Item::Enum(e) =>
            for v in &e.variants:
                match &v.fields:
                    VariantFields::Unit => ()
                    VariantFields::Tuple(types) =>
                        for ty in types:
                            collect_type_names_from_type(ty, out_)
                            ()
                    VariantFields::Struct(fields) =>
                        for f in fields:
                            collect_type_names_from_type(&f.ty, out_)
                            ()
        Item::Actor(a) =>
            for s in &a.state_:
                collect_type_names_from_type(&s.ty, out_)
                ()
                collect_type_names_from_expr(&s.initial, out_)
                ()
            ()
            for handler in &a.handlers:
                out_.insert(handler.message_type.clone())
                ()
                for p in &handler.params:
                    collect_type_names_from_type(&p.ty, out_)
                    ()
                ()
                collect_type_names_from_block(&handler.body, out_)
                ()
            ()
            for method in &a.methods:
                collect_type_names_from_item(&Item::Function(method.clone()), out_)
                ()
        Item::Component(c) =>
            for p in &c.props:
                collect_type_names_from_type(&p.ty, out_)
                ()
            ()
            for s in &c.state_:
                collect_type_names_from_type(&s.ty, out_)
                ()
                collect_type_names_from_expr(&s.initial, out_)
                ()
            ()
            for method in &c.methods:
                collect_type_names_from_item(&Item::Function(method.clone()), out_)
                ()
            ()
            collect_type_names_from_jsx(&c.body, out_)
            ()
        Item::Shader(s) =>
            for p in &s.inputs:
                collect_type_names_from_type(&p.ty, out_)
                ()
            ()
            collect_type_names_from_type(&s.outputs, out_)
            ()
            for u in &s.uniforms:
                collect_type_names_from_type(&u.ty, out_)
                ()
            ()
            collect_type_names_from_block(&s.body, out_)
            ()
        Item::TypeAlias(ta) =>
            collect_type_names_from_type(&ta.target, out_)
            ()
        Item::Const(c) =>
            collect_type_names_from_type(&c.ty, out_)
            ()
            collect_type_names_from_expr(&c.value, out_)
            ()
        Item::Trait(t) =>
            for method in &t.methods:
                for p in &method.params:
                    collect_type_names_from_type(&p.ty, out_)
                    ()
                ()
                match &method.return_type:
                    Some(ret) =>
                        collect_type_names_from_type(ret, out_)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                match &method.default_impl:
                    Some(body) =>
                        collect_type_names_from_block(body, out_)
                        ()
                    _ => ()
        Item::Impl(i) =>
            match &i.trait_name:
                Some(trait_name) =>
                    out_.insert(trait_name.clone())
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            collect_type_names_from_type(&i.target_type, out_)
            ()
            for method in &i.methods:
                collect_type_names_from_item(&Item::Function(method.clone()), out_)
                ()
        Item::Comptime(b) =>
            collect_type_names_from_block(&b.body, out_)
            ()
        Item::Macro(m) =>
            match &m.body:
                MacroBody::Block(block) => collect_type_names_from_block(block, out_)
                MacroBody::Tokens(_) => ()
        Item::Test(t) =>
            collect_type_names_from_block(&t.body, out_)
            ()
        Item::MaterialGraph(mg) =>
            for input in &mg.inputs:
                collect_type_names_from_type(&input.ty, out_)
                ()
                match &input.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                        ()
                    _ => ()
            ()
            for stmt in &mg.body:
                match stmt:
                    MaterialStatement::Let { value: value } =>
                        collect_type_names_from_expr(value, out_)
                        ()
            ()
            for output in &mg.outputs:
                collect_type_names_from_expr(&output.value, out_)
                ()
        Item::MaterialFunction(mf) =>
            for input in &mf.inputs:
                collect_type_names_from_type(&input.ty, out_)
                ()
                match &input.default_:
                    Some(default_) =>
                        collect_type_names_from_expr(default_, out_)
                        ()
                    _ => ()
            ()
            for stmt in &mf.body:
                match stmt:
                    MaterialStatement::Let { value: value } =>
                        collect_type_names_from_expr(value, out_)
                        ()
            ()
            collect_type_names_from_expr(&mf.output, out_)
            ()
        Item::GraphEditor(ge) =>
            for nt in &ge.node_types:
                for pin in &nt.inputs:
                    collect_type_names_from_type(&pin.ty, out_)
                    ()
                    match &pin.default_:
                        Some(default_) =>
                            collect_type_names_from_expr(default_, out_)
                            ()
                        _ => ()
                ()
                for pin in &nt.outputs:
                    collect_type_names_from_type(&pin.ty, out_)
                    ()
                    match &pin.default_:
                        Some(default_) =>
                            collect_type_names_from_expr(default_, out_)
                            ()
                        _ => ()
                ()
                for prop in &nt.properties:
                    collect_type_names_from_type(&prop.ty, out_)
                    ()
                    match &prop.default_:
                        Some(default_) =>
                            collect_type_names_from_expr(default_, out_)
                            ()
                        _ => ()
            ()
            match &ge.schema:
                Some(schema) =>
                    for rule in &schema.rules:
                        collect_type_names_from_expr(&rule.condition, out_)
                        ()
                _ => ()
        Item::GraphRuntime(gr) =>
            match &gr.graph_data:
                Some(gd) =>
                    for f in &gd.properties:
                        collect_type_names_from_type(&f.ty, out_)
                        ()
                    ()
                    for method in &gd.methods:
                        collect_type_names_from_item(&Item::Function(method.clone()), out_)
                        ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            for nd in &gr.node_types:
                match &nd.base_class:
                    Some(base) =>
                        out_.insert(base.clone())
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                for pin in &nd.input_pins:
                    collect_type_names_from_type(&pin.ty, out_)
                    ()
                ()
                for pin in &nd.output_pins:
                    collect_type_names_from_type(&pin.ty, out_)
                    ()
                ()
                for f in &nd.properties:
                    collect_type_names_from_type(&f.ty, out_)
                    ()
                ()
                for method in &nd.methods:
                    collect_type_names_from_item(&Item::Function(method.clone()), out_)
                    ()
                ()
                match &nd.execute_logic:
                    Some(logic) =>
                        collect_type_names_from_block(logic, out_)
                        ()
                    _ => ()
            ()
            match &gr.instance:
                Some(inst) =>
                    for f in &inst.state_:
                        collect_type_names_from_type(&f.ty, out_)
                        ()
                    ()
                    for method in &inst.methods:
                        collect_type_names_from_item(&Item::Function(method.clone()), out_)
                        ()
                    ()
                    for delegate in &inst.delegates:
                        for p in &delegate.params:
                            collect_type_names_from_type(&p.ty, out_)
                            ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match &gr.pin_config:
                Some(pc) =>
                    for f in &pc.properties:
                        collect_type_names_from_type(&f.ty, out_)
                        ()
                    ()
                    for method in &pc.methods:
                        collect_type_names_from_item(&Item::Function(method.clone()), out_)
                        ()
                _ => ()
        Item::StateMachine(sm) =>
            for state_ in &sm.states:
                for f in &state_.properties:
                    collect_type_names_from_type(&f.ty, out_)
                    ()
                ()
                for transition in &state_.transitions:
                    match &transition.condition:
                        Some(cond) =>
                            collect_type_names_from_block(cond, out_)
                            ()
                        _ => ()
                ()
                match &state_.on_enter:
                    Some(on_enter) =>
                        collect_type_names_from_block(on_enter, out_)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                match &state_.on_exit:
                    Some(on_exit) =>
                        collect_type_names_from_block(on_exit, out_)
                        ()
                    _ => ()
        Item::AsyncTask(at) =>
            for f in &at.input_fields:
                collect_type_names_from_type(&f.ty, out_)
                ()
            ()
            for f in &at.output_fields:
                collect_type_names_from_type(&f.ty, out_)
                ()
            ()
            match &at.do_work:
                Some(do_work) =>
                    collect_type_names_from_block(do_work, out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match &at.callback:
                Some(callback) =>
                    for p in &callback.params:
                        collect_type_names_from_type(&p.ty, out_)
                        ()
                    ()
                    collect_type_names_from_block(&callback.body, out_)
                    ()
                _ => ()
        Item::EditorModule(em) =>
            for entry in &em.menu_entries:
                collect_type_names_from_item(&Item::Function(entry.method.clone()), out_)
                ()
            ()
            for btn in &em.toolbar_buttons:
                collect_type_names_from_item(&Item::Function(btn.method.clone()), out_)
                ()
        Item::GameplayTags(_) => ()
        Item::GameplayAbility(ability) =>
            for method in &ability.methods:
                collect_type_names_from_item(&Item::Function(method.clone()), out_)
                ()
        Item::GameplayEffect(_) => ()
        Item::GameplayCue(cue) =>
            for field in &cue.state_fields:
                collect_type_names_from_type(&field.ty, out_)
                ()
            ()
            match &cue.on_execute:
                Some(on_execute) =>
                    collect_type_names_from_item(&Item::Function(on_execute.clone()), out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match &cue.on_add:
                Some(on_add) =>
                    collect_type_names_from_item(&Item::Function(on_add.clone()), out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match &cue.on_remove:
                Some(on_remove) =>
                    collect_type_names_from_item(&Item::Function(on_remove.clone()), out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match &cue.while_active:
                Some(while_active) =>
                    collect_type_names_from_item(&Item::Function(while_active.clone()), out_)
                    ()
                _ => ()
        Item::AbilityTask(task) =>
            for field in &task.state_fields:
                collect_type_names_from_type(&field.ty, out_)
                ()
            ()
            match &task.activate_method:
                Some(activate) =>
                    collect_type_names_from_item(&Item::Function(activate.clone()), out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match &task.on_destroy_method:
                Some(on_destroy) =>
                    collect_type_names_from_item(&Item::Function(on_destroy.clone()), out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            for method in &task.custom_methods:
                collect_type_names_from_item(&Item::Function(method.clone()), out_)
                ()
        Item::TargetActor(target) =>
            match &target.filter:
                Some(filter) =>
                    match &filter.custom_filter_method:
                        Some(custom_filter) =>
                            collect_type_names_from_item(&Item::Function(custom_filter.clone()), out_)
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            for method in &target.custom_methods:
                collect_type_names_from_item(&Item::Function(method.clone()), out_)
                ()
        Item::Use(_) => ()
        Item::Mod(_) => ()

@doc(doc = " Recursively collect type names from a Type AST node.")
fn collect_type_names_from_type(ty: &Type, out_: &mut Set<String>):
    match ty:
        Type::Named { name: name, generics: generics } =>
            out_.insert(name.clone())
            ()
            for g in generics:
                collect_type_names_from_type(g, out_)
                ()
        Type::Tuple(types, _) =>
            for t in types:
                collect_type_names_from_type(t, out_)
                ()
        Type::Array(inner, _, _) =>
            collect_type_names_from_type(inner, out_)
            ()
        Type::Slice(inner, _) =>
            collect_type_names_from_type(inner, out_)
            ()
        Type::Ref { inner: inner } =>
            collect_type_names_from_type(inner, out_)
            ()
        Type::Ptr { inner: inner } =>
            collect_type_names_from_type(inner, out_)
            ()
        Type::Function { params: params, return_type: return_type } =>
            for p in params:
                collect_type_names_from_type(p, out_)
                ()
            ()
            collect_type_names_from_type(return_type, out_)
            ()
        Type::Option(inner, _) =>
            collect_type_names_from_type(inner, out_)
            ()
        Type::Result(ok, err, _) =>
            collect_type_names_from_type(ok, out_)
            ()
            collect_type_names_from_type(err, out_)
            ()
        Type::Impl { trait_name: trait_name, generics: generics } =>
            out_.insert(trait_name.clone())
            ()
            for g in generics:
                collect_type_names_from_type(g, out_)
                ()
        Type::Infer(_) => ()
        Type::Never(_) => ()
        Type::Unit(_) => ()

@doc(doc = " Recursively collect type names from an Expr AST node.")
fn collect_type_names_from_expr(expr: &Expr, out_: &mut Set<String>):
    match expr:
        Expr::Cast { value: value, target: target } =>
            collect_type_names_from_expr(value, out_)
            collect_type_names_from_type(target, out_)
        Expr::Struct { name: name, fields: fields, rest: rest } =>
            out_.insert(name.clone())
            for field in fields:
                let (_, field_expr) = field
                collect_type_names_from_expr(field_expr, out_)
            match rest:
                Some(rest_expr) => collect_type_names_from_expr(rest_expr, out_)
                _ =>
                    let __selfhost_empty = none
        Expr::AggregateInit { ty: ty, fields: fields } =>
            collect_type_names_from_type(ty, out_)
            for field in fields:
                let (_, field_expr) = field
                collect_type_names_from_expr(field_expr, out_)
        Expr::EnumVariant { enum_name: enum_name, fields: fields } =>
            out_.insert(enum_name.clone())
            match fields:
                EnumVariantFields::Unit =>
                    let __selfhost_empty = none
                EnumVariantFields::Tuple(exprs) =>
                    for e in exprs:
                        collect_type_names_from_expr(e, out_)
                EnumVariantFields::Struct(field_pairs) =>
                    for field_pair in field_pairs:
                        let (_, field_expr) = field_pair
                        collect_type_names_from_expr(field_expr, out_)
        Expr::Spawn { actor_: actor_, init: init } =>
            out_.insert(actor_.clone())
            for init_entry in init:
                let (_, init_expr) = init_entry
                collect_type_names_from_expr(init_expr, out_)
        Expr::Call { callee: callee, args: args } =>
            collect_type_names_from_expr(callee, out_)
            for arg in args:
                collect_type_names_from_expr(&arg.value, out_)
        Expr::MethodCall { receiver: receiver, args: args } =>
            collect_type_names_from_expr(receiver, out_)
            for arg in args:
                collect_type_names_from_expr(&arg.value, out_)
        Expr::Field { object: object } => collect_type_names_from_expr(object, out_)
        Expr::Index { object: object, index: index } =>
            collect_type_names_from_expr(object, out_)
            collect_type_names_from_expr(index, out_)
        Expr::Binary { left: left, right: right } =>
            collect_type_names_from_expr(left, out_)
            collect_type_names_from_expr(right, out_)
        Expr::Unary { operand: operand } => collect_type_names_from_expr(operand, out_)
        Expr::Assign { target: target, value: value } =>
            collect_type_names_from_expr(target, out_)
            collect_type_names_from_expr(value, out_)
        Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
            collect_type_names_from_expr(condition, out_)
            collect_type_names_from_block(then_branch, out_)
            match else_branch:
                Some(else_b) => collect_type_names_from_else_branch(else_b, out_)
                _ =>
                    let __selfhost_empty = none
        Expr::Match { scrutinee: scrutinee, arms: arms } =>
            collect_type_names_from_expr(scrutinee, out_)
            for arm in arms:
                collect_type_names_from_pattern(&arm.pattern, out_)
                match &arm.guard:
                    Some(guard) => collect_type_names_from_expr(guard, out_)
                    _ =>
                        let __selfhost_empty = none
                collect_type_names_from_expr(&arm.body, out_)
        Expr::Lambda { params: params, return_type: return_type, body: body } =>
            for p in params:
                collect_type_names_from_type(&p.ty, out_)
            match return_type:
                Some(ret) => collect_type_names_from_type(ret, out_)
                _ =>
                    let __selfhost_empty = none
            collect_type_names_from_expr(body, out_)
        Expr::Array(exprs, _) =>
            for e in exprs:
                collect_type_names_from_expr(e, out_)
        Expr::Tuple(exprs, _) =>
            for e in exprs:
                collect_type_names_from_expr(e, out_)
        Expr::FString(exprs, _) =>
            for e in exprs:
                collect_type_names_from_expr(e, out_)
        Expr::MacroCall { args: args } =>
            for arg in args:
                collect_type_names_from_expr(arg, out_)
        Expr::SendMsg { target: target, data: data } =>
            collect_type_names_from_expr(target, out_)
            for data_entry in data:
                let (_, data_expr) = data_entry
                collect_type_names_from_expr(data_expr, out_)
        Expr::Block(block, _) => collect_type_names_from_block(block, out_)
        Expr::Range { start: start, end: end } =>
            match start:
                Some(s) => collect_type_names_from_expr(s, out_)
                _ =>
                    let __selfhost_empty = none
            match end:
                Some(e) => collect_type_names_from_expr(e, out_)
                _ =>
                    let __selfhost_empty = none
        Expr::Ref { value: value } => collect_type_names_from_expr(value, out_)
        Expr::AddrOf { value: value } => collect_type_names_from_expr(value, out_)
        Expr::Deref(inner, _) => collect_type_names_from_expr(inner, out_)
        Expr::Try(inner, _) => collect_type_names_from_expr(inner, out_)
        Expr::Await(inner, _) => collect_type_names_from_expr(inner, out_)
        Expr::Comptime(inner, _) => collect_type_names_from_expr(inner, out_)
        Expr::Paren(inner, _) => collect_type_names_from_expr(inner, out_)
        Expr::PtrOffset { pointer: pointer, offset: offset, element_ty: element_ty } =>
            collect_type_names_from_expr(pointer, out_)
            collect_type_names_from_expr(offset, out_)
            match element_ty:
                Some(ty) => collect_type_names_from_type(ty, out_)
                _ =>
                    let __selfhost_empty = none
        Expr::MemLoad { pointer: pointer, load_ty: load_ty } =>
            collect_type_names_from_expr(pointer, out_)
            match load_ty:
                Some(ty) => collect_type_names_from_type(ty, out_)
                _ =>
                    let __selfhost_empty = none
        Expr::MemStore { pointer: pointer, value: value, store_ty: store_ty } =>
            collect_type_names_from_expr(pointer, out_)
            collect_type_names_from_expr(value, out_)
            match store_ty:
                Some(ty) => collect_type_names_from_type(ty, out_)
                _ =>
                    let __selfhost_empty = none
        Expr::SizeOfType { target: target } => collect_type_names_from_type(target, out_)
        Expr::AlignOfType { target: target } => collect_type_names_from_type(target, out_)
        Expr::Alloca { ty: target } => collect_type_names_from_type(target, out_)
        Expr::Uninit { ty: target } => collect_type_names_from_type(target, out_)
        Expr::Alloc { size: size, ty: ty } =>
            collect_type_names_from_expr(size, out_)
            match ty:
                Some(ty) => collect_type_names_from_type(ty, out_)
                _ =>
                    let __selfhost_empty = none
        Expr::Realloc { pointer: pointer, size: size, ty: ty } =>
            collect_type_names_from_expr(pointer, out_)
            collect_type_names_from_expr(size, out_)
            match ty:
                Some(ty) => collect_type_names_from_type(ty, out_)
                _ =>
                    let __selfhost_empty = none
        Expr::Return(Some(inner), _) => collect_type_names_from_expr(inner, out_)
        Expr::Break(Some(inner), _) => collect_type_names_from_expr(inner, out_)
        Expr::JSX(node, _) => collect_type_names_from_jsx(node, out_)
        _ =>
            let __selfhost_empty = none

@doc(doc = " Recursively collect type names from a Block.")
fn collect_type_names_from_block(block: &Block, out_: &mut Set<String>):
    for stmt in &(*block).stmts:
        collect_type_names_from_stmt(stmt, out_)
        ()

@doc(doc = " Recursively collect type names from a Stmt.")
fn collect_type_names_from_stmt(stmt: &Stmt, out_: &mut Set<String>):
    match stmt:
        Stmt::Let { ty: ty, value: value, pattern: pattern } =>
            match ty:
                Some(ty) =>
                    collect_type_names_from_type(ty, out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match value:
                Some(val) =>
                    collect_type_names_from_expr(val, out_)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            collect_type_names_from_pattern(pattern, out_)
            ()
        Stmt::Expr(expr) =>
            collect_type_names_from_expr(expr, out_)
            ()
        Stmt::Return(Some(expr), _) =>
            collect_type_names_from_expr(expr, out_)
            ()
        Stmt::For { iter: iter, body: body, binding: binding } =>
            collect_type_names_from_pattern(binding, out_)
            ()
            collect_type_names_from_expr(iter, out_)
            ()
            collect_type_names_from_block(body, out_)
            ()
        Stmt::While { condition: condition, body: body } =>
            collect_type_names_from_expr(condition, out_)
            ()
            collect_type_names_from_block(body, out_)
            ()
        Stmt::Loop { body: body } =>
            collect_type_names_from_block(body, out_)
            ()
        Stmt::Item(item) =>
            collect_type_names_from_item(item, out_)
            ()
        Stmt::Return(None, _) => ()
        Stmt::Break(_, _) => ()
        Stmt::Continue(_) => ()

@doc(doc = " Collect type names from else branches.")
fn collect_type_names_from_else_branch(branch: &ElseBranch, out_: &mut Set<String>):
    match branch:
        ElseBranch::Else(block) =>
            collect_type_names_from_block(block, out_)
            ()
        ElseBranch::ElseIf(cond, block, next) =>
            collect_type_names_from_expr(cond, out_)
            ()
            collect_type_names_from_block(block, out_)
            ()
            match next:
                Some(next_else) =>
                    collect_type_names_from_else_branch(next_else, out_)
                    ()
                _ => ()

@doc(doc = " Collect type names from patterns (destructuring may reference types).")
fn collect_type_names_from_pattern(pattern: &Pattern, out_: &mut Set<String>):
    match pattern:
        Pattern::Variant { enum_name: enum_name, fields: fields } =>
            match enum_name:
                Some(name) =>
                    let __selfhost_insert = out_.insert(name.clone())
                _ =>
                    let __selfhost_empty = none
            match fields:
                VariantPatternFields::Tuple(patterns) =>
                    for p in patterns:
                        collect_type_names_from_pattern(p, out_)
                _ =>
                    let __selfhost_empty = none
        Pattern::Tuple(patterns, _) =>
            for p in patterns:
                collect_type_names_from_pattern(p, out_)
        Pattern::Or(patterns, _) =>
            for p in patterns:
                collect_type_names_from_pattern(p, out_)
        Pattern::Slice { patterns: patterns } =>
            for p in patterns:
                collect_type_names_from_pattern(p, out_)
        Pattern::Literal(expr) => collect_type_names_from_expr(expr, out_)
        _ =>
            let __selfhost_empty = none

@doc(doc = " Collect type names from JSX nodes.")
fn collect_type_names_from_jsx(node: &JSXNode, out_: &mut Set<String>):
    match node:
        JSXNode::Element { children: children, attributes: attributes } =>
            for attr in attributes:
                match &attr.value:
                    JSXAttrValue::Expr(e) => collect_type_names_from_expr(e, out_)
                    _ => ()
            ()
            for child in children:
                collect_type_names_from_jsx(child, out_)
                ()
        JSXNode::ComponentCall { name: name, props: props, children: children } =>
            out_.insert(name.clone())
            ()
            for prop in props:
                match &prop.value:
                    JSXAttrValue::Expr(e) => collect_type_names_from_expr(e, out_)
                    _ => ()
            ()
            for child in children:
                collect_type_names_from_jsx(child, out_)
                ()
        JSXNode::Expression(expr) =>
            collect_type_names_from_expr(expr, out_)
            ()
        JSXNode::For { iter: iter, body: body } =>
            collect_type_names_from_expr(iter, out_)
            ()
            collect_type_names_from_jsx(body, out_)
            ()
        JSXNode::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
            collect_type_names_from_expr(condition, out_)
            ()
            collect_type_names_from_jsx(then_branch, out_)
            ()
            match else_branch:
                Some(else_b) =>
                    collect_type_names_from_jsx(else_b, out_)
                    ()
                _ => ()
        JSXNode::Fragment(children, _) =>
            for child in children:
                collect_type_names_from_jsx(child, out_)
                ()
        JSXNode::Text(_, _) => ()

@doc(doc = " GameplayTags namespace definition")
@doc(doc = " Syntax: @gameplay_tags namespace Name: tag_hierarchy")
@derive(Debug, Clone, PartialEq)
pub struct GameplayTagsNamespace:
    name: String
    children: Array<GameplayTagNode>
    span: Span

@doc(doc = " Individual tag node in the hierarchy")
@derive(Debug, Clone, PartialEq)
pub struct GameplayTagNode:
    name: String
    full_path: String
    comment: Option<String>
    children: Array<GameplayTagNode>
    span: Span

@doc(doc = " Gameplay Ability definition for UE5 Gameplay Ability System")
@doc(doc = " Syntax: @ability struct Name: policies, tags, lifecycle_hooks")
@derive(Debug, Clone, PartialEq)
pub struct GameplayAbilityDef:
    name: String
    instancing_policy: Option<String>
    replication_policy: Option<String>
    net_execution_policy: Option<String>
    ability_tags: Array<String>
    activation_required_tags: Array<String>
    activation_blocked_tags: Array<String>
    activation_owned_tags: Array<String>
    cancel_abilities_with_tag: Array<String>
    block_abilities_with_tag: Array<String>
    cost_effect: Option<String>
    cooldown_effect: Option<String>
    methods: Array<Function>
    attributes: Array<Attribute>
    span: Span

@doc(doc = " Gameplay Effect definition for UE5 Gameplay Ability System")
@doc(doc = " Syntax: @gameplay_effect struct Name: duration, modifiers, tags")
@derive(Debug, Clone, PartialEq)
pub struct GameplayEffectDef:
    name: String
    duration_policy: Option<String>
    duration_magnitude: Option<f32>
    period: Option<f32>
    execute_on_application: Bool
    modifiers: Array<GameplayEffectModifier>
    stacking_type: Option<String>
    stacking_limit: Option<i32>
    owned_tags: Array<String>
    granted_tags: Array<String>
    application_required_tags: Array<String>
    application_ignored_tags: Array<String>
    ongoing_required_tags: Array<String>
    ongoing_ignored_tags: Array<String>
    removal_required_tags: Array<String>
    removal_ignored_tags: Array<String>
    attributes: Array<Attribute>
    span: Span

@derive(Debug, Clone, PartialEq)
pub struct GameplayEffectModifier:
    attribute: String
    operation: String
    magnitude: f32
    span: Span

@doc(doc = " Gameplay cue definition (cosmetic events)")
@doc(doc = " Syntax: @gameplay_cue struct Name: tag, type, lifecycle_hooks")
@derive(Debug, Clone, PartialEq)
pub struct GameplayCueDef:
    name: String
    attributes: Array<Attribute>
    tag: String
    cue_type: CueType
    auto_destroy: Bool
    state_fields: Array<Field>
    on_execute: Option<Function>
    on_add: Option<Function>
    on_remove: Option<Function>
    while_active: Option<Function>
    span: Span

pub enum CueType:
    Static
    Actor

impl Default for CueType:
    fn default_() -> CueType:
        CueType__Static


@doc(doc = " Ability Task Definition")
@doc(doc = " Syntax: @ability_task struct Name: delegates, state, lifecycle_hooks")
@derive(Debug, Clone, PartialEq)
pub struct AbilityTaskDef:
    name: String
    attributes: Array<Attribute>
    delegates: Array<TaskDelegateDef>
    state_fields: Array<Field>
    activate_method: Option<Function>
    on_destroy_method: Option<Function>
    custom_methods: Array<Function>
    span: Span

@doc(doc = " Ability Task Delegate Definition")
@derive(Debug, Clone, PartialEq)
pub struct TaskDelegateDef:
    name: String
    delegate_type: String
    span: Span

@doc(doc = " Target Actor Definition")
@doc(doc = " Syntax: @target_actor struct Name: trace_type, filters, reticle")
@derive(Debug, Clone, PartialEq)
pub struct TargetActorDef:
    name: String
    attributes: Array<Attribute>
    trace_type: TraceType
    max_range: Option<f64>
    trace_channel: Option<String>
    filter: Option<TargetFilter>
    reticle_class: Option<String>
    custom_methods: Array<Function>
    span: Span

pub enum TraceType:
    Line
    Sphere
    Cone
    TraceBox
    Cylinder

impl Default for TraceType:
    fn default_() -> TraceType:
        TraceType__Line


@doc(doc = " Target Filter")
@derive(Debug, Clone, PartialEq)
pub struct TargetFilter:
    self_filter: Option<String>
    required_actor_class: Option<String>
    require_tags: Array<String>
    ignore_tags: Array<String>
    custom_filter_method: Option<Function>
    span: Span

