use serde::Deserialize

use serde::Serialize

use std::collections::HashMap

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct IntrinsicParam:
    param_type: String
    name: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct IntrinsicInfo:
    name: String
    category: String
    call_count: usize
    params: Array<IntrinsicParam>
    param_count: usize
    source: String
    is_macro: Bool

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct PermutationInfo:
    name: String
    usage_count: usize
    perm_type: String
    range: Option<usize>
    enum_class: Option<String>

@derive(Debug, Clone, Default, serde__Serialize, serde__Deserialize)
pub struct IncludeData:
    graph: Map<String, Array<String>>
    frequency: Map<String, usize>
    file_provides: Map<String, Array<String>>

impl Default for IncludeData:
    pub fn default_() -> IncludeData:
        IncludeData { graph: HashMap__new_(), frequency: HashMap__new_(), file_provides: HashMap__new_() }


@derive(Debug, Clone, Default, serde__Serialize, serde__Deserialize)
pub struct BindingPatterns:
    thread_groups: Map<String, usize>
    parameter_types: Map<String, String>
    common_textures: Map<String, usize>
    common_uavs: Map<String, usize>
    common_buffers: Map<String, usize>
    cbuffers: Array<String>

impl Default for BindingPatterns:
    pub fn default_() -> BindingPatterns:
        BindingPatterns { thread_groups: HashMap__new_(), parameter_types: HashMap__new_(), common_textures: HashMap__new_(), common_uavs: HashMap__new_(), common_buffers: HashMap__new_(), cbuffers: Vec__new_() }


@derive(Debug, Clone, Default, serde__Serialize, serde__Deserialize)
pub struct MaterialData:
    outputs: Map<String, usize>
    parameters: Map<String, usize>
    getters: Map<String, usize>
    types: Map<String, usize>

impl Default for MaterialData:
    pub fn default_() -> MaterialData:
        MaterialData { outputs: HashMap__new_(), parameters: HashMap__new_(), getters: HashMap__new_(), types: HashMap__new_() }


@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct ShaderKnowledgeData:
    engine_version: String
    intrinsics: Map<String, IntrinsicInfo>
    includes: IncludeData
    permutations: Map<String, PermutationInfo>
    bindings: BindingPatterns
    material: MaterialData

@derive(Debug, Clone)
pub struct ShaderKnowledge:
    intrinsics: Map<String, IntrinsicInfo>
    permutations: Map<String, PermutationInfo>
    bindings: BindingPatterns
    material: MaterialData
    function_to_include: Map<String, String>
    material_getter_set: Set<String>

impl Default for ShaderKnowledge:
    fn default_() -> ShaderKnowledge:
        ShaderKnowledge__new_()


impl ShaderKnowledge:
    pub fn new_() -> ShaderKnowledge:
        ShaderKnowledge { intrinsics: HashMap__new_(), permutations: HashMap__new_(), bindings: BindingPatterns { thread_groups: HashMap__new_(), parameter_types: HashMap__new_(), common_textures: HashMap__new_(), common_uavs: HashMap__new_(), common_buffers: HashMap__new_(), cbuffers: Vec__new_() }, material: MaterialData { outputs: HashMap__new_(), parameters: HashMap__new_(), getters: HashMap__new_(), types: HashMap__new_() }, function_to_include: HashMap__new_(), material_getter_set: HashSet__new_() }

    pub fn load(_self: &mut ShaderKnowledge, json_data: String) -> Result<(), String>:
        let data: ShaderKnowledgeData = serde_json__from_str(json_data).map_err(fn(e): f"Failed to parse shader knowledge: {e}")?
        (*_self).intrinsics = data.intrinsics
        ()
        (*_self).permutations = data.permutations
        ()
        (*_self).bindings = data.bindings
        ()
        (*_self).material = data.material
        ()
        (*_self).rebuild_indices()
        ()
        Result::Ok(())

    fn rebuild_indices(_self: &mut ShaderKnowledge):
        (*_self).function_to_include.clear()
        ()
        (*_self).material_getter_set.clear()
        ()
        for selfhost_for_item in &(*_self).intrinsics:
            let (name, info) = selfhost_for_item
            if (!info.source.is_empty()):
                (*_self).function_to_include.insert(name.clone(), info.source.clone())
                ()
        ()
        for name in (*_self).material.getters.keys():
            (*_self).material_getter_set.insert(name.clone())
            ()

    pub fn is_known_function(_self: &ShaderKnowledge, name: String) -> Bool:
        (*_self).intrinsics.contains_key(name)

    pub fn get_intrinsic(_self: &ShaderKnowledge, name: String) -> Option<&IntrinsicInfo>:
        (*_self).intrinsics.get(name)

    pub fn is_hlsl_intrinsic(_self: &ShaderKnowledge, name: String) -> Bool:
        (*_self).intrinsics.get(name).map_or(false, fn(i): (i.category == "hlsl"))

    pub fn is_ue5_function(_self: &ShaderKnowledge, name: String) -> Bool:
        (*_self).intrinsics.get(name).map_or(false, fn(i): ((i.category == "ue5") || (i.category == "macro")))

    pub fn get_param_count(_self: &ShaderKnowledge, name: String) -> Option<usize>:
        (*_self).intrinsics.get(name).map(fn(i): i.param_count)

    pub fn infer_return_type(_self: &ShaderKnowledge, name: String) -> String:
        if (none):
            return "passthrough"
        if (none):
            return "bool"
        if (none):
            return "void"
        if (((((((((name.starts_with("tex") || (name == "Sample")) || (name == "SampleLevel")) || (name == "SampleGrad")) || (name == "SampleBias")) || (name == "Load")) || (name == "GatherRed")) || (name == "GatherGreen")) || (name == "GatherBlue")) || (name == "GatherAlpha")):
            return "float4"
        if (((((name == "cross") || (name == "normalize")) || (name == "reflect")) || (name == "refract")) || (name == "faceforward")):
            return "passthrough"
        if (none):
            return "float"
        if (none):
            return "int"
        if (none):
            return "uint"
        if (none):
            return "float"
        if (none):
            return "uint"
        "unknown"

    pub fn get_function_include(_self: &ShaderKnowledge, func_name: String) -> Option<String>:
        (*_self).function_to_include.get(func_name).map(fn(s): s.as_str())

    pub fn is_known_permutation(_self: &ShaderKnowledge, name: String) -> Bool:
        (*_self).permutations.contains_key(name)

    pub fn get_permutation(_self: &ShaderKnowledge, name: String) -> Option<&PermutationInfo>:
        (*_self).permutations.get(name)

    pub fn default_thread_group(_self: &ShaderKnowledge) -> (u32, u32, u32):
        (8, 8, 1)

    pub fn thread_group_usage(_self: &ShaderKnowledge, key: String) -> usize:
        (*_self).bindings.thread_groups.get(key).copied().unwrap_or(0)

    pub fn is_material_getter(_self: &ShaderKnowledge, name: String) -> Bool:
        (*_self).material_getter_set.contains(name)

    pub fn material_outputs(_self: &ShaderKnowledge) -> &Map<String, usize>:
        &(*_self).material.outputs

    pub fn material_getters(_self: &ShaderKnowledge) -> &Map<String, usize>:
        &(*_self).material.getters

    pub fn stats(_self: &ShaderKnowledge) -> (usize, usize, usize):
        ((*_self).intrinsics.len(), (*_self).permutations.len(), (*_self).bindings.thread_groups.len())


