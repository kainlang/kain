use serde::Deserialize

use serde::Serialize

fn default_white_rgba() -> [u8; 4]:
    [255, 255, 255, 255]

@derive(Clone, Debug, serde__Deserialize, serde__Serialize)
pub struct Fast3dSmokeManifest:
    title: String
    root_display_list: String
    resolution: ResolutionConfig
    clear_color: [u8; 4]
    camera: CameraConfig
    auto_rotation_radians_per_second: f32
    segment_bindings: Array<SegmentBinding>
    light_groups: Array<LightGroupDefinition>
    scene_instances: Array<SceneInstanceDefinition>
    textures: Array<TextureDefinition>
    shader_overrides: Array<ShaderOverrideDefinition>
    display_lists: Array<DisplayListDefinition>

@derive(Clone, Copy, Debug, serde__Deserialize, serde__Serialize)
pub struct ResolutionConfig:
    width: usize
    height: usize

@derive(Clone, Copy, Debug, serde__Deserialize, serde__Serialize)
pub struct CameraConfig:
    controller_mode: CameraControllerMode
    target: [f32; 3]
    orbit_radius: f32
    orbit_height: f32
    initial_yaw_radians: f32
    initial_pitch_radians: f32
    fov_y_degrees: f32
    near_plane: f32
    far_plane: f32
    free_position: [f32; 3]
    move_speed: f32
    look_speed: f32

fn default_camera_position() -> [f32; 3]:
    [0, 1.8, 6]

fn default_camera_move_speed() -> f32:
    5.5

fn default_camera_look_speed() -> f32:
    1.35

pub enum CameraControllerMode:
    Orbit
    Fly

impl Default for CameraControllerMode:
    pub fn default_() -> CameraControllerMode:
        CameraControllerMode__Orbit


@derive(Clone, Debug, serde__Deserialize, serde__Serialize)
pub struct SegmentBinding:
    segment_id: u8
    kind: SegmentBindingKind
    target_id: String

pub enum SegmentBindingKind:
    Texture
    DisplayList

@derive(Clone, Debug, serde__Deserialize, serde__Serialize)
pub struct LightGroupDefinition:
    id: String
    ambient_color: [u8; 4]
    diffuse_color: [u8; 4]
    direction: [f32; 3]

@derive(Clone, Debug, serde__Deserialize, serde__Serialize)
pub struct SceneInstanceDefinition:
    id: String
    display_list_id: String
    transform: SceneTransformDefinition
    state_binding: Option<String>
    shader_override_id: Option<String>

@derive(Clone, Copy, Debug, Default, serde__Deserialize, serde__Serialize)
pub struct SceneTransformDefinition:
    translation: [f32; 3]
    rotation_degrees: [f32; 3]
    scale: [f32; 3]

impl Default for SceneTransformDefinition:
    pub fn default_() -> SceneTransformDefinition:
        SceneTransformDefinition { translation: [], rotation_degrees: [], scale: [] }


fn default_scene_scale() -> [f32; 3]:
    [1, 1, 1]

@derive(Clone, Debug, serde__Deserialize, serde__Serialize)
pub struct TextureDefinition:
    id: String
    source: TextureSource

pub enum TextureSource:
    Checkerboard { width: u32, height: u32, cell_size: u32, color_a: [u8; 4], color_b: [u8; 4] }
    Stripes { width: u32, height: u32, stripe_height: u32, color_a: [u8; 4], color_b: [u8; 4] }
    GeneratedSm64TitleCard { width: u32, height: u32 }
    GeneratedMarioEyesFront { width: u32, height: u32 }
    GeneratedMarioMustache { width: u32, height: u32 }
    GeneratedMarioSideburn { width: u32, height: u32 }
    GeneratedNamedTile { width: u32, height: u32, label: String, color_a: [u8; 4], color_b: [u8; 4] }

@derive(Clone, Debug, serde__Deserialize, serde__Serialize)
pub struct ShaderOverrideDefinition:
    id: String
    combine_mode: Option<CombineMode>
    primitive_color: Option<[u8; 4]>
    env_color: Option<[u8; 4]>
    color_multiplier: [f32; 4]
    emissive_add: [f32; 4]

fn default_shader_color_multiplier() -> [f32; 4]:
    [1, 1, 1, 1]

@derive(Clone, Debug, serde__Deserialize, serde__Serialize)
pub struct DisplayListDefinition:
    id: String
    commands: Array<DisplayListCommand>

pub enum DisplayListCommand:
    PushMatrix { matrix_: [[f32; 4]; 4] }
    PopMatrix
    LoadVertices { slot: u16, vertices: Array<Fast3dVertex> }
    DrawTriangles { triangles: Array<[u16; 3]> }
    BindTexture { texture_id: String }
    BindTextureSegment { segment_id: u8 }
    CallDisplayList { display_list_id: String }
    CallDisplayListSegment { segment_id: u8 }
    SetCombineMode { mode: CombineMode }
    SetPrimitiveColor { color: [u8; 4] }
    SetEnvColor { color: [u8; 4] }
    SetLightGroup { light_group_id: String }

@derive(Clone, Copy, Debug, serde__Deserialize, serde__Serialize)
pub struct Fast3dVertex:
    position: [f32; 3]
    uv: [f32; 2]
    color: [u8; 4]
    normal: Option<[f32; 3]>

pub enum CombineMode:
    Texture
    TextureVertex
    TexturePrimitive
    TextureVertexPrimitive
    TextureEnvMix
    Primitive
    Vertex

