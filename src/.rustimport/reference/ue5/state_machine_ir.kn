use crate::ue5::context::Ue5Context

use kain_core::ast::Block

use kain_core::ast::StateDef

use kain_core::ast::StateMachineDef

use kain_core::ast::TransitionDef

@doc(doc = " Animation state machine intermediate representation")
@doc(doc = " Represents a state machine with states, transitions, and animation references")
@derive(Debug, Clone)
pub struct StateMachineIR:
    name: String
    states: Array<StateIR>
    entry_state: String

@doc(doc = " A single state within a state machine")
@derive(Debug, Clone)
pub struct StateIR:
    name: String
    animation: Option<String>
    transitions: Array<TransitionIR>
    on_enter: Option<String>
    on_exit: Option<String>

@doc(doc = " Transition between states with condition and priority")
@derive(Debug, Clone)
pub struct TransitionIR:
    to_state: String
    condition: String
    priority: i32

@doc(doc = " Convert a state machine definition from AST to StateMachineIR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `state_machine` - The state machine definition from AST")
@doc(doc = " * `ctx` - UE5 compilation context for type mapping")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `Ok(StateMachineIR)` - Successfully converted IR")
@doc(doc = " * `Err(String)` - Conversion error with description")
pub fn convert_to_state_machine_ir(state_machine: &kain_core::ast::StateMachineDef, ctx: &Ue5Context) -> Result<StateMachineIR, String>:
    let entry_state = find_entry_state(&(*state_machine).states)?
    let mut states = Vec__new_()
    for state_def in &(*state_machine).states:
        let state_ir = convert_state(state_def, ctx)?
        states.push(state_ir)
        ()
    ()
    Result::Ok(StateMachineIR { name: (*state_machine).name.clone(), states: states, entry_state: entry_state })

@doc(doc = " Find the entry state in the state machine")
fn find_entry_state(states: &[kain_core::ast::StateDef]) -> Result<String, String>:
    let entry_states: Array<_> = states.iter().filter(fn(s): s.is_entry).collect()
    match entry_states.len():
        0 => Result::Err(("State machine must have at least one entry state (use is_entry: true)").to_string())
        1 => Result::Ok(entry_states[0].name.clone())
        _ => Result::Err("State machine has multiple entry states: {entry_states.iter().map(fn(s): s.name.as_str()).collect().join(\", \")}. Only one entry state is allowed.")

@doc(doc = " Convert a single state definition to StateIR")
fn convert_state(state_def: &kain_core::ast::StateDef, ctx: &Ue5Context) -> Result<StateIR, String>:
    let mut transitions = Vec__new_()
    for transition_def in &(*state_def).transitions:
        let transition_ir = convert_transition(transition_def, ctx)?
        transitions.push(transition_ir)
        ()
    ()
    transitions.sort_by(fn(a, b): b.priority.cmp(&a.priority))
    ()
    let on_enter = (*state_def).on_enter.map(fn(block): convert_block_to_cpp(block, ctx))
    let on_exit = (*state_def).on_exit.map(fn(block): convert_block_to_cpp(block, ctx))
    Result::Ok(StateIR { name: (*state_def).name.clone(), animation: (*state_def).animation.clone(), transitions: transitions, on_enter: on_enter, on_exit: on_exit })

@doc(doc = " Convert a transition definition to TransitionIR")
fn convert_transition(transition_def: &kain_core::ast::TransitionDef, ctx: &Ue5Context) -> Result<TransitionIR, String>:
    let condition = match &(*transition_def).condition:
        Some(block) => convert_block_to_cpp(block, ctx)
        _ => ("true").to_string()
    Result::Ok(TransitionIR { to_state: (*transition_def).to_state.clone(), condition: condition, priority: (*transition_def).priority })

@doc(doc = " Convert a KAIN block to C++ code")
@doc(doc = "")
@doc(doc = " This is a placeholder implementation that will be replaced with proper")
@doc(doc = " expression codegen when the full codegen pipeline is integrated.")
fn convert_block_to_cpp(block: &kain_core::ast::Block, _ctx: &Ue5Context) -> String:
    f"/* Block with {(*block).stmts.len()} statements */"

