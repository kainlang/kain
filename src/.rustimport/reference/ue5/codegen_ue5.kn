                    else:
                        let component_type_name = match &uniform_.ty:
                            kain_core__ast__Type::Named { name: name, generics: generics } => if (generics.is_empty() && (*_self).component_mirrors.contains_key(name.as_str())): Option::Some(name.clone()) else: none
                            _ =>
                                none
                        match component_type_name:
                            Some(comp_name) =>
                                let mirror = &(*_self).component_mirrors[&comp_name]
                                let pod_var = f"{uniform_.name}_pod"
                                let mut state_var = actor_.state_.iter().find(fn(s): s.name.eq_ignore_ascii_case(&uniform_.name)).map(fn(s): f"this->{s.name}")
                                if state_var.is_none():
                                    for st in &actor_.state_:
                                        match &st.ty:
                                            kain_core__ast__Type::Named { name: type_name } =>
                                                match (*_self).type_fields_map.get(type_name.as_str()):
                                                    Some(sub_fields) =>
