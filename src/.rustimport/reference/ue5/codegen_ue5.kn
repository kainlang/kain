            (*_self).source.push_line("\t\t\t\tFTexture2DRHIRef TextureRHI = RT->GetResource()->GetTexture2DRHI();")
            ()
            (*_self).source.push_line("\t\t\t\tFPooledRenderTargetDesc Desc = FPooledRenderTargetDesc::Create2DDesc(")
