                        Some("Sampler3D") => true
                        Some("SamplerCube") => true
                        Some("Texture2D") => true
                        Some("RWTexture2D") => true
                        Some("Texture3D") => true
                        Some("RWTexture3D") => true
                        Some("Image2D") => true
                        Some("Image3D") => true
                        Some("Buffer") => true
                        Some("RWBuffer") => true
                        Some("StructuredBuffer") => true
                        Some("RWStructuredBuffer") => true
                        Some("TextureCube") => true
                        Some("RWTextureCube") => true
