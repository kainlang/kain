                (*_self).source.push_line("\t\t\t\tTexCreate_ShaderResource | TexCreate_UAV | TexCreate_RenderTargetable")
                ()
                (*_self).source.push_line("\t\t\t);")
                ()
                (*_self).source.push_line("")
