                    (*_self).type_fields_map.insert(a.ast.name.clone(), fields)
                    ()
                kain_core__types__TypedItem::Function(f) =>
                    if f.ast.attributes.iter().any(fn(a): ((a.name == "blueprint") || (a.name == "blueprint_pure"))):
                        (*_self).blueprint_fn_names.insert(f.ast.name.clone())
                        ()
                        for param in &f.ast.params:
                            collect_type_names(&param.ty, &mut (*_self).blueprint_used_types)
                            ()
                        ()
                        match &f.ast.return_type:
                            Some(ret) =>
                                collect_type_names(ret, &mut (*_self).blueprint_used_types)
                                ()
                            _ => ()
                _ => ()
        ()
        (*_self).impl_methods.clear()
        ()
        for item in program.items():
            match item:
                kain_core__types__TypedItem::Impl(imp) =>
                    match &imp.ast.target_type:
                        kain_core__ast__Type::Named { name: name } =>
                            (*_self).impl_methods.entry(name.clone()).or_insert_with(Vec__new_).extend(imp.ast.methods.iter().cloned())
                            ()
                        _ => ()
                _ => ()
        ()
        let mut delegates = Vec__new_()
        let mut blueprint_funcs = Vec__new_()
        let mut other_items = Vec__new_()
        let mut delegate_indices: Map<(String, String), usize> = HashMap__new_()
        let mut blueprint_indices: Map<(String, String), usize> = HashMap__new_()
        let mut other_indices: Map<(String, String), usize> = HashMap__new_()
        let blueprint_library_only = (*_self).target_item.map(fn(t): (t == "__BLUEPRINT_LIBRARY_ONLY__")).unwrap_or(false)
        for item in program.items():
            let item_name = (*_self).item_symbol_name(item)
            let has_stdlib_optional = match item:
                kain_core__types__TypedItem::Struct(s) => s.ast.attributes.iter().any(fn(a): (a.name == "stdlib_optional"))
                _ => false
            if has_stdlib_optional:
                continue
            match &(*_self).target_item:
                Some(target) =>
                    if blueprint_library_only:
                        match item:
                            kain_core__types__TypedItem::Function(f) =>
                                if f.ast.attributes.iter().any(fn(a): (((a.name == "blueprint") || (a.name == "blueprint_pure")) || (a.name == "ue5"))):
                                    (*_self).push_unique_item(&mut blueprint_funcs, &mut blueprint_indices, item)
                                    ()
                                    ()
                                    ()
                                    ()
                                ()
                            _ =>
                                ()
                                ()
                        continue
                    if ((!item_name.is_empty()) && (item_name != target)):
                        continue
                    ()
                _ =>
                    ()
                    ()
            match item:
                kain_core__types__TypedItem::TypeAlias(alias) =>
                    match &alias.ast.target:
                        kain_core__ast__Type::Function {  } =>
                            (*_self).push_unique_item(&mut delegates, &mut delegate_indices, item)
                            ()
                        _ =>
                            (*_self).push_unique_item(&mut other_items, &mut other_indices, item)
                            ()
                kain_core__types__TypedItem::Function(f) => if f.ast.attributes.iter().any(fn(a): (((a.name == "blueprint") || (a.name == "blueprint_pure")) || (a.name == "ue5"))): none else: none
                _ => (*_self).push_unique_item(&mut other_items, &mut other_indices, item)
        ()
        if (!blueprint_library_only):
            for item in &delegates:
                (*_self).gen_item(item)
                ()
            ()
            if (!delegates.is_empty()):
                (*_self).write_blank_header()
                ()
                ()
                ()
                ()
            ()
        let actor_count = program.items().iter().filter(fn(i): none).count()
        if (!blueprint_library_only):
            for item in &other_items:
                match item:
                    kain_core__types__TypedItem::Actor(actor_typed) =>
                        let all_compute: Array<&kain_core::types::TypedShader> = shaders.iter().filter(fn(s): (s.ast.stage == kain_core__ast__ShaderStage__Compute)).copied().collect()
                        let dispatch_attr = actor_typed.ast.attributes.iter().find(fn(a): (a.name == "dispatch"))
                        let (actor_shaders, actor_shader_names): (Array<&kain_core::types::TypedShader>, Array<String>) = match dispatch_attr:
                            Some(attr) =>
                                let requested: Array<String> = attr.args.iter().filter_map(fn(arg): none).collect()
                                let filtered: Array<&kain_core::types::TypedShader> = all_compute.iter().filter(fn(s): requested.iter().any(fn(req): (req.eq_ignore_ascii_case(&s.ast.name) || req.replace("_", "").eq_ignore_ascii_case(&s.ast.name.replace("_", ""))))).copied().collect()
                                let names: Array<String> = filtered.iter().map(fn(s): requested.iter().find(fn(req): (req.eq_ignore_ascii_case(&s.ast.name) || req.replace("_", "").eq_ignore_ascii_case(&s.ast.name.replace("_", "")))).cloned().unwrap_or_else(fn(): s.ast.name.clone())).collect()
                                (filtered, names)
                            _ => (Vec__new_(), Vec__new_())
                        (*_self).gen_actor_with_shaders(&actor_typed.ast, &actor_shaders, &actor_shader_names)
                        ()
                        ()
                    kain_core__types__TypedItem::Struct(st) =>
                        let is_component = st.ast.attributes.iter().any(fn(a): (a.name == "component"))
                        let is_subsystem = st.ast.attributes.iter().any(fn(a): (a.name == "subsystem"))
                        if is_component:
                            (*_self).gen_ucomponent(&st.ast)
                            ()
                            ()
                            ()
                            ()
                        elif is_subsystem:
                            (*_self).gen_usubsystem(&st.ast)
                            ()
                            ()
                            ()
                            ()
                        else:
                            (*_self).gen_ustruct(&st.ast)
                            ()
                            ()
                            ()
                            ()
                        ()
                    kain_core__types__TypedItem::Enum(en) =>
                        (*_self).gen_uenum(&en.ast)
                        ()
                    kain_core__types__TypedItem::Function(fn_typed) =>
                        (*_self).gen_ufunction(&fn_typed.ast)
                        ()
                    kain_core__types__TypedItem::Impl(im) =>
                        (*_self).gen_impl(&im.ast)
                        ()
                    _ => ()
                (*_self).write_blank_header()
                ()
            ()
            ()
        if (!blueprint_funcs.is_empty()):
            (*_self).header.push_line("UCLASS()")
            ()
            let lib_class = f"U{(*_self).module_name}FunctionLibrary"
            (*_self).write_header(&f"class {(*_self).context.module_api} {lib_class} : public UBlueprintFunctionLibrary")
            ()
            (*_self).write_header("{")
            ()
            (*_self).push_indent()
            ()
            (*_self).write_header("GENERATED_BODY()")
            ()
            (*_self).write_blank_header()
            ()
            (*_self).write_header("public:")
            ()
            (*_self).push_indent()
            ()
            for item in &blueprint_funcs:
                (*_self).gen_item(item)
                ()
            ()
            (*_self).pop_indent()
            ()
            (*_self).pop_indent()
            ()
            (*_self).write_header("};")
            ()
            (*_self).write_blank_header()
            ()
            ()
            ()
            ()
        let is_modular_mode = (*_self).target_item.is_some()
        if ((!shaders.is_empty()) && (!is_modular_mode)):
            (*_self).write_blank_source()
            ()
            (*_self).write_source("// Module implementation")
            ()
            (*_self).write_source("// Shader directory registration is handled by static initializers in shader .cpp files")
            ()
            (*_self).write_blank_source()
            ()
            (*_self).write_source(&f"class F{(*_self).context.output_name}Module : public IModuleInterface")
            ()
            (*_self).write_source("{")
            ()
            (*_self).write_source("public:")
            ()
            (*_self).push_indent()
            ()
            (*_self).write_source("virtual void StartupModule() override")
            ()
            (*_self).write_source("{")
            ()
            (*_self).push_indent()
            ()
            (*_self).write_source("// Shader directory mapping is registered by static initializers")
            ()
            (*_self).write_source("// in each shader .cpp file before IMPLEMENT_GLOBAL_SHADER runs")
            ()
            (*_self).pop_indent()
            ()
            (*_self).write_source("}")
            ()
            (*_self).write_blank_source()
            ()
            (*_self).write_source("virtual void ShutdownModule() override")
            ()
            (*_self).write_source("{")
            ()
            (*_self).push_indent()
            ()
            (*_self).write_source("// Cleanup if needed")
            ()
            (*_self).pop_indent()
            ()
            (*_self).write_source("}")
            ()
            (*_self).pop_indent()
            ()
            (*_self).write_source("};")
            ()
            (*_self).write_blank_source()
            ()
            (*_self).write_source(&f"IMPLEMENT_MODULE(F{(*_self).context.output_name}Module, {(*_self).context.output_name})")
            ()
            ()
            ()
            ()
        let mut shader_files = Vec__new_()
        for item in program.items():
            match item:
                kain_core__types__TypedItem::StateMachine(state_machine_def) =>
                    match &(*_self).target_item:
                        Some(target) =>
                            if (&state_machine_def.name != target):
                                continue
                            ()
                        _ =>
                            ()
                            ()
                    match state_machine_ir__convert_to_state_machine_ir(state_machine_def, &(*_self).context):
                        Ok(ir) =>
                            let output = state_machine_codegen__generate_state_machine_code(&ir, &(*_self).module_name)
                            shader_files.push((f"{ir.name}.h", output.header))
                            ()
                            shader_files.push((f"{ir.name}.cpp", output.source))
                            ()
                        Err(e) => ()
                _ => ()
        ()
        for item in program.items():
            match item:
                kain_core__types__TypedItem::AsyncTask(async_task_def) =>
                    match &(*_self).target_item:
                        Some(target) =>
                            if (&async_task_def.name != target):
                                continue
                            ()
                        _ =>
                            ()
                            ()
                    match async_task_ir__convert_to_async_task_ir(async_task_def, &(*_self).context):
                        Ok(ir) =>
                            let task_name = ir.task_name.clone()
                            let output = async_task_codegen__generate_async_task_code(&ir, &(*_self).module_name)
                            shader_files.push((f"{task_name}.h", output.task_header))
                            ()
                            shader_files.push((f"{task_name}.cpp", output.task_source))
                            ()
                            shader_files.push((f"{task_name}TaskQueue.h", output.queue_header))
                            ()
                            shader_files.push((f"{task_name}TaskQueue.cpp", output.queue_source))
                            ()
                        Err(e) => ()
                _ => ()
        ()
        let typed_program = kain_core::types::TypedProgram { items: program.items().to_vec() }
        for shader_ in &shaders:
            let shader_name = &shader_.ast.name
            match ue5_shaders__generate_usf(&typed_program):
                Ok(usf_code) =>
                    shader_files.push((f"{shader_name}.usf", usf_code))
                    ()
                    ()
                    ()
                    ()
                Err(e) => ()
            let header_code = ue5_shaders__codegen_usf__generate_cpp_header(&typed_program, shader_name)
            shader_files.push((f"{shader_name}.h", header_code))
            ()
            let cpp_code = ue5_shaders__codegen_usf__generate_cpp_implementation(&typed_program, shader_name, "YourPlugin")
            shader_files.push((f"{shader_name}.cpp", cpp_code))
            ()
        ()
        Ue5Output { header: (*_self).header.build(), source: (*_self).source.build(), shader_files: shader_files }

    fn gen_item(_self: &mut Ue5Gen, item: &kain_core::types::TypedItem):
        match item:
            kain_core__types__TypedItem::Actor(actor_typed) => (*_self).gen_actor(&actor_typed.ast)
            kain_core__types__TypedItem::Struct(st) =>
                let is_component = st.ast.attributes.iter().any(fn(a): (a.name == "component"))
                if is_component:
                    (*_self).gen_ucomponent(&st.ast)
                    ()
                else:
                    (*_self).gen_ustruct(&st.ast)
                    ()
            kain_core__types__TypedItem::Enum(en) => (*_self).gen_uenum(&en.ast)
            kain_core__types__TypedItem::Function(fn_typed) => (*_self).gen_ufunction(&fn_typed.ast)
            kain_core__types__TypedItem::Impl(im) => (*_self).gen_impl(&im.ast)
            kain_core__types__TypedItem::TypeAlias(alias) =>
                match &alias.ast.target:
                    kain_core__ast__Type::Function {  } => if (alias.ast.name.starts_with("On") || alias.ast.name.ends_with("Delegate")): none else: none
                    _ => ()
            _ => ()

    fn gen_actor(_self: &mut Ue5Gen, actor_: &kain_core::ast::Actor):
        (*_self).gen_actor_with_shaders(actor_, &[], &[])
        ()

    fn gen_actor_with_shaders(_self: &mut Ue5Gen, actor_: &kain_core::ast::Actor, shaders: &[&kain_core::types::TypedShader], shader_file_names: &[String]):
        let class_name = ue5__to_actor_name(&actor_.name)
        if ((*_self).context.marker_config.style != ue5__MarkerStyle__None):
            let marker = ue5__kain_markers__actor_marker(actor_, &(*_self).context.marker_config)
            if (!marker.is_empty()):
                (*_self).write_header(&marker)
                ()
                ()
                ()
                ()
            ()
        let interface_list = (*_self).context.get_interface_list(&actor_.name)
        let mut uclass_specs = Vec__new_()
        match actor_.attributes.iter().find(fn(a): (a.name == "uclass")):
            Some(attr) =>
                for arg in &attr.args:
                    match arg:
                        kain_core__ast__Expr::String(s, _) =>
                            uclass_specs.push(s.clone())
                            ()
                        _ => ()
                ()
                ()
            _ =>
                ()
                ()
        if (!uclass_specs.iter().any(fn(s): s.contains("HideCategories"))):
            uclass_specs.push(("HideCategories=(Input, Collision, LOD)").to_string())
            ()
            ()
            ()
            ()
        if uclass_specs.is_empty():
            (*_self).header.push_line("UCLASS()")
            ()
            ()
            ()
            ()
        else:
            (*_self).header.push_line(&"UCLASS({uclass_specs.join(\", \")})")
            ()
            ()
            ()
            ()
        let base_class = actor_.attributes.iter().find(fn(a): (a.name == "base")).and_then(fn(a): a.args.first()).and_then(fn(arg): none).unwrap_or_else(fn(): ("AActor").to_string())
        (*_self).write_header(&f"class {(*_self).context.module_api} {class_name} : public {base_class}{interface_list}")
        ()
        (*_self).write_header("{")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_header("GENERATED_BODY()")
        ()
        (*_self).write_blank_header()
        ()
        (*_self).write_header("public:")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_header(&f"{class_name}();")
        ()
        (*_self).write_header("virtual void BeginPlay() override;")
        ()
        (*_self).write_header("virtual void Tick(float DeltaTime) override;")
        ()
        (*_self).write_blank_header()
        ()
        let has_replicated_state = actor_.state_.iter().any(fn(s): s.attributes.iter().any(fn(a): (a.name == "replicated")))
        for state_decl in &actor_.state_:
            let mut props: Array<String> = ["EditAnywhere", "BlueprintReadWrite"]
            let mut category = ("Simulation Settings").to_string()
            for attr in &state_decl.attributes:
                match attr.name.as_str():
                    "replicated" => props.push("Replicated")
                    "savegame" => props.push("SaveGame")
                    "transient" => props.push("Transient")
                    "editdefaults" =>
                        props.retain(fn(__kain_closure_arg0): (*__kain_closure_arg0 != "EditAnywhere"))
                        ()
                        props.push("EditDefaultsOnly")
                        ()
                    "visibleonly" =>
                        props.retain(fn(__kain_closure_arg1): (*__kain_closure_arg1 != "EditAnywhere"))
                        ()
                        props.push("VisibleAnywhere")
                        ()
                    "category" =>
                        match attr.args.first():
                            Some(kain_core__ast__Expr::String(cat, _)) =>
                                category = cat.clone()
                                ()
                            _ => ()
                    _ => ()
            ()
            (*_self).write_header(&"UPROPERTY({props.join(\", \")}, Category = \"{category}\")")
            ()
            let mut cpp_type = (*_self).map_type(&state_decl.ty)
            match &state_decl.ty:
                kain_core__ast__Type::Named { name: name } =>
                    if ((*_self).context.is_component(name) || name.ends_with("Component")):
                        cpp_type = f"{ue5__to_component_name(name)}*"
                        ()
                        ()
                        ()
                        ()
                    ()
                _ =>
                    ()
                    ()
            (*_self).write_header(&f"{cpp_type} {state_decl.name};")
            ()
            match &state_decl.ty:
                kain_core__ast__Type::Named { name: name } =>
                    (*_self).var_types.insert(state_decl.name.clone(), name.clone())
                    ()
                _ => ()
        ()
        if has_replicated_state:
            (*_self).write_blank_header()
            ()
            (*_self).write_header("virtual void GetLifetimeReplicatedProps(TArray<FLifetimeProperty>& OutLifetimeProps) const override;")
            ()
            ()
            ()
            ()
        if (!shaders.is_empty()):
            (*_self).write_blank_header()
            ()
            (*_self).write_header("// Double-buffered Simulation Resources")
            ()
            (*_self).write_header("UPROPERTY(Transient)")
            ()
            (*_self).write_header("UTextureRenderTarget2D* PositionRT_A;")
            ()
            (*_self).write_header("UPROPERTY(Transient)")
            ()
            (*_self).write_header("UTextureRenderTarget2D* PositionRT_B;")
            ()
            (*_self).write_header("UPROPERTY(Transient)")
            ()
            (*_self).write_header("UTextureRenderTarget2D* VelocityRT_A;")
            ()
            (*_self).write_header("UPROPERTY(Transient)")
            ()
            (*_self).write_header("UTextureRenderTarget2D* VelocityRT_B;")
            ()
            ()
            ()
            ()
        for handler in &actor_.handlers:
            if ((((handler.message_type != "begin_play") && (handler.message_type != "BeginPlay")) && (handler.message_type != "tick")) && (handler.message_type != "Tick")):
                (*_self).gen_message_handler_decl(handler)
                ()
        ()
        for method in &actor_.methods:
            (*_self).gen_actor_method_decl(method, &class_name)
            ()
        ()
        (*_self).pop_indent()
        ()
        if ((*_self).context.marker_config.style != ue5__MarkerStyle__None):
            let end_marker = ue5__kain_markers__actor_end_marker(actor_, &(*_self).context.marker_config)
            if (!end_marker.is_empty()):
                (*_self).write_header(&end_marker)
                ()
                ()
                ()
                ()
            ()
        (*_self).write_header("};")
        ()
        (*_self).write_blank_header()
        ()
        (*_self).source.push_line(&f"{class_name}::{class_name}()")
        ()
        (*_self).source.push_line("{")
        ()
        (*_self).source.push_line("\tPrimaryActorTick.bCanEverTick = true;")
        ()
        let component_fields: Array<_> = actor_.state_.iter().filter(fn(state_decl): none).collect()
        if (!component_fields.is_empty()):
            (*_self).source.push_line("")
            ()
            (*_self).source.push_line("\tRootComponent = CreateDefaultSubobject<USceneComponent>(TEXT(\"DefaultSceneRoot\"));")
            ()
            ()
            ()
            ()
        for state_decl in &actor_.state_:
            let cpp_type = (*_self).map_type(&state_decl.ty)
            let is_component_state = match &state_decl.ty:
                kain_core__ast__Type::Named { name: name } if ((*_self).context.is_component(name) || name.ends_with("Component")) => true
                _ => false
            if is_component_state:
                let component_class = cpp_type.trim_end_matches("*").trim()
                let component_name = &state_decl.name
                let text_name = ue5__to_pascal_case(component_name)
                (*_self).source.push_line(&f"\t{component_name} = CreateDefaultSubobject<{component_class}>(TEXT(\"{text_name}\"));")
                ()
        ()
        if has_replicated_state:
            (*_self).source.push_line("")
            ()
            (*_self).source.push_line("\tbReplicates = true;")
            ()
            ()
            ()
            ()
        (*_self).source.push_line("}")
        ()
        (*_self).write_blank_source()
        ()
        if has_replicated_state:
            (*_self).source.push_line(&f"void {class_name}::GetLifetimeReplicatedProps(TArray<FLifetimeProperty>& OutLifetimeProps) const")
            ()
            (*_self).source.push_line("{")
            ()
            (*_self).source.push_line("\tSuper::GetLifetimeReplicatedProps(OutLifetimeProps);")
            ()
            (*_self).source.push_line("")
            ()
            for s in &actor_.state_:
                if s.attributes.iter().any(fn(a): (a.name == "replicated")):
                    (*_self).source.push_line(&f"\tDOREPLIFETIME({class_name}, {s.name});")
                    ()
            ()
            (*_self).source.push_line("}")
            ()
            (*_self).write_blank_source()
            ()
            ()
            ()
            ()
        (*_self).source.push_line(&f"void {class_name}::BeginPlay()")
        ()
        (*_self).source.push_line("{")
        ()
        (*_self).source.push_line("\tSuper::BeginPlay();")
        ()
        if (!shaders.is_empty()):
            for rt_name in &["PositionRT_A", "PositionRT_B", "VelocityRT_A", "VelocityRT_B"]:
                (*_self).source.push_line(&f"\tif (!{rt_name})")
                ()
                (*_self).source.push_line("\t{")
                ()
                (*_self).source.push_line(&f"\t\t{rt_name} = NewObject<UTextureRenderTarget2D>(this);")
                ()
                (*_self).source.push_line(&f"\t\t{rt_name}->bAutoGenerateMips = false;")
                ()
                (*_self).source.push_line(&f"\t\t{rt_name}->RenderTargetFormat = RTF_RGBA32f;")
                ()
                (*_self).source.push_line(&f"\t\t{rt_name}->InitAutoFormat(512, 512);")
                ()
                (*_self).source.push_line(&f"\t\t{rt_name}->UpdateResourceImmediate(true);")
                ()
                (*_self).source.push_line("\t}")
                ()
            ()
            ()
        match actor_.handlers.iter().find(fn(h): ((h.message_type == "begin_play") || (h.message_type == "BeginPlay"))):
            Some(handler) =>
                (*_self).with_var_type_scope(fn(this_): none)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).source.push_line("}")
        ()
        (*_self).write_blank_source()
        ()
        (*_self).source.push_line(&f"void {class_name}::Tick(float DeltaTime)")
        ()
        (*_self).source.push_line("{")
        ()
        (*_self).source.push_line("\tSuper::Tick(DeltaTime);")
        ()
        match actor_.handlers.iter().find(fn(h): ((h.message_type == "tick") || (h.message_type == "Tick"))):
            Some(handler) =>
                for param in &handler.params:
                    if (((param.name == "delta_time") || (param.name == "dt")) || (param.name == "delta")):
                        (*_self).context.add_ident_remap(param.name.clone(), ("DeltaTime").to_string())
                        ()
                ()
                (*_self).with_var_type_scope(fn(this_): none)
                ()
                (*_self).context.clear_ident_remaps()
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        if (!shaders.is_empty()):
            (*_self).source.push_line("")
            ()
            (*_self).source.push_line("\t// Enqueue Simulation on Render Thread")
            ()
            (*_self).source.push_line("\tENQUEUE_RENDER_COMMAND(SimulationTick)(")
