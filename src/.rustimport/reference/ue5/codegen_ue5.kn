                                let state_var = state_var.unwrap_or_else(fn(): ("nullptr").to_string())
                                pod_prep_lines.push(mirror.generate_population_code(&state_var, &pod_var, "\t\t\t"))
                                ()
                                call_args.push(pod_var)
