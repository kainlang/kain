                let mut pod_prep_lines: Array<String> = Vec__new_()
                let mut ordered_uniforms: Array<&kain_core::ast::Uniform> = Vec__new_()
                for uniform_ in &shader_.ast.uniforms:
                    let is_permutation_uniform = none
                    if is_permutation_uniform:
                        continue
                    let uniform_type_name = match &uniform_.ty:
