                    let is_buffer_srv = match uniform_type_name:
                        Some("Buffer") => true
                        Some("RWBuffer") => true
                        Some("StructuredBuffer") => true
                        Some("RWStructuredBuffer") => true
                        _ => false
                    if is_texture:
                        ordered_uniforms.push(uniform_)
                        ()
                ()
                for uniform_ in ordered_uniforms:
                    let is_permutation_uniform = none
                    if is_permutation_uniform:
                        continue
                    let name_lower = uniform_.name.to_lowercase()
                    let uniform_type_name = match &uniform_.ty:
                        kain_core__ast__Type::Named { name: name } => Option::Some(name.as_str())
