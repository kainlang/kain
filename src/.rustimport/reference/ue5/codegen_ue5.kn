const DEFAULT_MODULE_API: String = "GAME_API"

@doc(doc = " Output from UE5 codegen - contains header, source, and optional shader files")
pub struct Ue5Output:
    header: String
    source: String
    shader_files: Array<(String, String)>

@doc(doc = " Generate UE5 C++ code from a typed program (legacy, for packager)")
@doc(doc = " Returns separate .h and .cpp file contents, plus any shader files")
@doc(doc = "")
@doc(doc = " # Note")
@doc(doc = " This is a compatibility function for the packager which still works with TypedProgram.")
@doc(doc = " New code should use `generate()` which accepts MonomorphizedProgram.")
pub fn generate_from_typed(program: &kain_core::TypedProgram, output_name: Option<String>, copyright: Option<String>) -> Result<Ue5Output, KainError>:
    let lowered = kain_core__lower_typed_program_memory_for_target(program, kain_core__CompileTarget__Ue5)?
    kain_core__validate_typed_program_memory_support(&lowered, kain_core__CompileTarget__Ue5)?
    ()
    let module_name = output_name.unwrap_or("Kain")
    generate_filtered_typed(&lowered, module_name, output_name, none, copyright, HashMap__new_(), none, false, false)

@doc(doc = " Generate UE5 C++ code from a monomorphized program")
@doc(doc = " Returns separate .h and .cpp file contents, plus any shader files")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `program` - Monomorphized program with all generic functions instantiated")
@doc(doc = " * `output_name` - Optional module name (defaults to \"Kain\")")
@doc(doc = " * `copyright` - Optional copyright header text")
@doc(doc = "")
@doc(doc = " # Note")
@doc(doc = " This function expects a `MonomorphizedProgram` where all generic types have been")
@doc(doc = " resolved to concrete types. Generic functions like `identity<T>` will have been")
@doc(doc = " instantiated as `identity_Int`, `identity_Float`, etc.")
pub fn generate(program: &kain_core::MonomorphizedProgram, output_name: Option<String>, copyright: Option<String>) -> Result<Ue5Output, KainError>:
    let lowered = kain_core__lower_monomorphized_program_memory_for_target(program, kain_core__CompileTarget__Ue5)?
    kain_core__validate_typed_program_memory_support(&kain_core::TypedProgram { items: lowered.items.clone() }, kain_core__CompileTarget__Ue5)?
    ()
    let module_name = output_name.unwrap_or("Kain")
    generate_filtered(&lowered, module_name, output_name, none, copyright, HashMap__new_(), none)

@doc(doc = " Generate UE5 C++ code with a pre-configured context (includes metadata)")
@doc(doc = " This is used by the CLI when compiling with `-t ue5` to enable full pipeline features")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `program` - Monomorphized program with all generic functions instantiated")
@doc(doc = " * `output_name` - Optional module name")
@doc(doc = " * `copyright` - Optional copyright header text")
@doc(doc = " * `context` - Pre-configured Ue5Context with EngineKnowledge and type registry")
@doc(doc = "")
@doc(doc = " # Note")
@doc(doc = " This is the preferred entry point when you have a pre-built Ue5Context with")
@doc(doc = " metadata loaded. The context includes EngineKnowledge for type resolution.")
pub fn generate_with_context(program: &kain_core::MonomorphizedProgram, output_name: Option<String>, copyright: Option<String>, context: &Ue5Context) -> Result<Ue5Output, KainError>:
    let lowered = kain_core__lower_monomorphized_program_memory_for_target(program, kain_core__CompileTarget__Ue5)?
    kain_core__validate_typed_program_memory_support(&kain_core::TypedProgram { items: lowered.items.clone() }, kain_core__CompileTarget__Ue5)?
    ()
    let module_name = output_name.unwrap_or("Kain")
    let mut gen = Ue5Gen__new_(module_name, output_name, copyright, none, HashMap__new_())
    gen.context = context.clone()
    ()
    for item in lowered.items():
        match item:
            kain_core__types__TypedItem::Enum(en) =>
                let prefixed_name = ue5__to_enum_name(&en.ast.name)
                let header = f"{prefixed_name}.h"
                gen.context.register_enum(en.ast.name.clone(), header)
                ()
                gen.type_mapper.register_enum(en.ast.name.clone())
                ()
            kain_core__types__TypedItem::Struct(st) =>
                let is_component = st.ast.attributes.iter().any(fn(a): (a.name == "component"))
                let is_subsystem = st.ast.attributes.iter().any(fn(a): (a.name == "subsystem"))
                if is_component:
                    let prefixed_name = ue5__to_component_name(&st.ast.name)
                    let header = f"{prefixed_name}.h"
                    gen.context.register_struct(st.ast.name.clone(), header.clone())
                    ()
                    gen.context.register_component(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_component(st.ast.name.clone())
                    ()
                elif is_subsystem:
                    let prefixed_name = ue5__to_subsystem_name(&st.ast.name)
                    let header = f"{prefixed_name}.h"
                    gen.context.register_struct(st.ast.name.clone(), header.clone())
                    ()
                    gen.context.register_subsystem(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_subsystem(st.ast.name.clone())
                    ()
                else:
                    let prefixed_name = ue5__to_struct_name(&st.ast.name)
                    let header = f"{prefixed_name}.h"
                    gen.context.register_struct(st.ast.name.clone(), header.clone())
                    ()
                    gen.type_mapper.register_struct(st.ast.name.clone())
                    ()
            kain_core__types__TypedItem::Actor(a) =>
                let prefixed_name = ue5__to_actor_name(&a.ast.name)
                let header = f"{prefixed_name}.h"
                gen.context.register_actor(a.ast.name.clone(), header)
                ()
                gen.type_mapper.register_actor(a.ast.name.clone())
                ()
            kain_core__types__TypedItem::Component(c) =>
                let prefixed_name = ue5__to_component_name(&c.ast.name)
                let header = f"{prefixed_name}.h"
                gen.context.register_component(c.ast.name.clone(), header)
                ()
                gen.type_mapper.register_component(c.ast.name.clone())
                ()
            _ => ()
    ()
    Result::Ok(gen.gen_program(&lowered))

@doc(doc = " Legacy version for TypedProgram (packager compatibility)")
pub fn generate_with_context_typed(program: &kain_core::TypedProgram, output_name: Option<String>, copyright: Option<String>, context: &Ue5Context) -> Result<Ue5Output, KainError>:
    let lowered = kain_core__lower_typed_program_memory_for_target(program, kain_core__CompileTarget__Ue5)?
    let module_name = output_name.unwrap_or("Kain")
    let mut gen = Ue5Gen__new_(module_name, output_name, copyright, none, HashMap__new_())
    gen.context = context.clone()
    ()
    for item in &lowered.items:
        match item:
            kain_core__types__TypedItem::Enum(en) =>
                let prefixed_name = ue5__to_enum_name(&en.ast.name)
                let header = f"{prefixed_name}.h"
                gen.context.register_enum(en.ast.name.clone(), header)
                ()
                gen.type_mapper.register_enum(en.ast.name.clone())
                ()
            kain_core__types__TypedItem::Struct(st) =>
                let is_component = st.ast.attributes.iter().any(fn(a): (a.name == "component"))
                let is_subsystem = st.ast.attributes.iter().any(fn(a): (a.name == "subsystem"))
                if is_component:
                    let prefixed_name = ue5__to_component_name(&st.ast.name)
                    let header = f"{prefixed_name}.h"
                    gen.context.register_struct(st.ast.name.clone(), header.clone())
                    ()
                    gen.context.register_component(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_component(st.ast.name.clone())
                    ()
                elif is_subsystem:
                    let prefixed_name = ue5__to_subsystem_name(&st.ast.name)
                    let header = f"{prefixed_name}.h"
                    gen.context.register_struct(st.ast.name.clone(), header.clone())
                    ()
                    gen.context.register_subsystem(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_subsystem(st.ast.name.clone())
                    ()
                else:
                    let prefixed_name = ue5__to_struct_name(&st.ast.name)
                    let header = f"{prefixed_name}.h"
                    gen.context.register_struct(st.ast.name.clone(), header.clone())
                    ()
                    gen.type_mapper.register_struct(st.ast.name.clone())
                    ()
            kain_core__types__TypedItem::Actor(a) =>
                let prefixed_name = ue5__to_actor_name(&a.ast.name)
                let header = f"{prefixed_name}.h"
                gen.context.register_actor(a.ast.name.clone(), header)
                ()
                gen.type_mapper.register_actor(a.ast.name.clone())
                ()
            kain_core__types__TypedItem::Component(c) =>
                let prefixed_name = ue5__to_component_name(&c.ast.name)
                let header = f"{prefixed_name}.h"
                gen.context.register_component(c.ast.name.clone(), header)
                ()
                gen.type_mapper.register_component(c.ast.name.clone())
                ()
            kain_core__types__TypedItem::TypeAlias(a) =>
                let prefixed_name = ue5__to_struct_name(&a.ast.name)
                let header = f"{prefixed_name}.h"
                gen.context.register_delegate(a.ast.name.clone(), header)
                ()
                gen.type_mapper.register_delegate(a.ast.name.clone())
                ()
            _ => ()
    ()
    Result::Ok(gen.gen_program(&lowered))

@doc(doc = " Generate UE5 C++ code limited to a specific item")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `program` - Monomorphized program with concrete types only")
@doc(doc = " * `module_name` - Plugin name for API macro (e.g., \"UltimateTest\")")
@doc(doc = " * `output_name` - Optional output file name")
@doc(doc = " * `filter_item` - Optional item name to generate (None = all items)")
@doc(doc = " * `copyright` - Optional copyright header")
@doc(doc = " * `type_to_header` - Map of type names to their header files")
@doc(doc = " * `context` - Optional pre-configured Ue5Context")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " Ue5Output with header, source, and shader files")
@doc(doc = "")
@doc(doc = " # Note")
@doc(doc = " This is the main internal codegen function. It receives a MonomorphizedProgram")
@doc(doc = " where all generic functions have been instantiated with concrete types.")
pub fn generate_filtered(program: &kain_core::MonomorphizedProgram, module_name: String, output_name: Option<String>, target_item: Option<String>, copyright: Option<String>, type_to_header: Map<String, String>, shader_file_names: Option<Array<String>>) -> Result<Ue5Output, KainError>:
    let mut gen = Ue5Gen__new_(module_name, output_name, copyright, target_item, type_to_header.clone())
    gen.shader_file_names = shader_file_names.unwrap_or_default()
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Enum(en) =>
                let prefixed_name = ue5__to_enum_name(&en.ast.name)
                let header = type_to_header.get(&en.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_enum(en.ast.name.clone(), header)
                ()
                gen.type_mapper.register_enum(en.ast.name.clone())
                ()
            kain_core__types__TypedItem::Struct(st) =>
                let is_component = st.ast.attributes.iter().any(fn(a): (a.name == "component"))
                let is_subsystem = st.ast.attributes.iter().any(fn(a): (a.name == "subsystem"))
                let prefixed_name = if is_subsystem:
                    ue5__to_subsystem_name(&st.ast.name)
                else:
                    ue5__to_struct_name(&st.ast.name)
                let header = type_to_header.get(&st.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_struct(st.ast.name.clone(), header.clone())
                ()
                if is_component:
                    gen.context.register_component(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_component(st.ast.name.clone())
                    ()
                elif is_subsystem:
                    gen.context.register_subsystem(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_subsystem(st.ast.name.clone())
                    ()
                else:
                    gen.type_mapper.register_struct(st.ast.name.clone())
                    ()
            kain_core__types__TypedItem::Actor(a) =>
                let prefixed_name = ue5__to_actor_name(&a.ast.name)
                let header = type_to_header.get(&a.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_actor(a.ast.name.clone(), header)
                ()
                gen.type_mapper.register_actor(a.ast.name.clone())
                ()
            kain_core__types__TypedItem::Component(c) =>
                let prefixed_name = ue5__to_component_name(&c.ast.name)
                let header = type_to_header.get(&c.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_component(c.ast.name.clone(), header)
                ()
                gen.type_mapper.register_component(c.ast.name.clone())
                ()
            kain_core__types__TypedItem::TypeAlias(a) =>
                let prefixed_name = ue5__to_struct_name(&a.ast.name)
                let header = type_to_header.get(&a.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_delegate(a.ast.name.clone(), header)
                ()
                gen.type_mapper.register_delegate(a.ast.name.clone())
                ()
            kain_core__types__TypedItem::Impl(impl_block) =>
                match impl_block.ast.trait_name:
                    Some(trait_name) =>
                        match &impl_block.ast.target_type:
                            kain_core__ast__Type::Named { name: class_name } =>
                                gen.context.register_trait_impl(class_name, trait_name)
                                ()
                            _ => ()
                    _ => ()
            _ => ()
    ()
    Result::Ok(gen.gen_program(program))

@doc(doc = " Legacy function for compatibility with TypedProgram (packager)")
@doc(doc = "")
@doc(doc = " # Note")
@doc(doc = " Generate UE5 C++ code from a typed program with optional filtering and KAIN source markers.")
@doc(doc = "")
@doc(doc = " This is for the packager which still works with TypedProgram.")
@doc(doc = " The packager converts MonomorphizedProgram back to TypedProgram after monomorphization.")
@doc(doc = "")
@doc(doc = " # Parameters")
@doc(doc = " * `program` - The typed program to generate code from")
@doc(doc = " * `module_name` - Name of the UE5 module")
@doc(doc = " * `output_name` - Optional output name override")
@doc(doc = " * `target_item` - Optional specific item to generate (for modular output)")
@doc(doc = " * `copyright` - Optional copyright header")
@doc(doc = " * `type_to_header` - Map of type names to their header files")
@doc(doc = " * `shader_file_names` - Optional list of shader file names")
@doc(doc = " * `embed_kain` - If true, embeds original KAIN source as comments in generated C++ for round-trip compilation")
@doc(doc = "")
@doc(doc = " # Round-Trip Compilation")
@doc(doc = " When `embed_kain` is true, the generated C++ includes KAIN source markers:")
@doc(doc = " ```cpp")
@doc(doc = " // KAIN_BEGIN: actor Player")
@doc(doc = " // KAIN: actor Player:")
@doc(doc = " // KAIN:     state health: Float = 100.0")
@doc(doc = " class APlayer : public AActor { ... }")
@doc(doc = " // KAIN_END: actor Player")
@doc(doc = " ```")
@doc(doc = "")
@doc(doc = " These markers enable:")
@doc(doc = " - Extracting KAIN source from compiled plugins (`cpp_to_kain.py`)")
@doc(doc = " - Validating codegen determinism (round-trip testing)")
@doc(doc = " - Generating LLM training examples from working plugins")
@doc(doc = " - Debugging what KAIN generated for specific C++ patterns")
@doc(doc = "")
@doc(doc = " See `Kain/scripts/docs/ROUND_TRIP_README.md` for usage details.")
pub fn generate_filtered_typed(program: &kain_core::TypedProgram, module_name: String, output_name: Option<String>, target_item: Option<String>, copyright: Option<String>, type_to_header: Map<String, String>, shader_file_names: Option<Array<String>>, embed_kain: Bool, has_gas_features: Bool) -> Result<Ue5Output, KainError>:
    let mut gen = Ue5Gen__new_(module_name, output_name, copyright, target_item, type_to_header.clone())
    gen.shader_file_names = shader_file_names.unwrap_or_default()
    ()
    gen.has_gas_features = has_gas_features
    ()
    if embed_kain:
        gen.context.enable_markers(ue5__MarkerStyle__Block)
        ()
        ()
        ()
        ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Enum(en) =>
                let prefixed_name = ue5__to_enum_name(&en.ast.name)
                let header = type_to_header.get(&en.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_enum(en.ast.name.clone(), header)
                ()
                gen.type_mapper.register_enum(en.ast.name.clone())
                ()
            kain_core__types__TypedItem::Struct(st) =>
                let is_component = st.ast.attributes.iter().any(fn(a): (a.name == "component"))
                let is_subsystem = st.ast.attributes.iter().any(fn(a): (a.name == "subsystem"))
                let prefixed_name = if is_subsystem:
                    ue5__to_subsystem_name(&st.ast.name)
                else:
                    ue5__to_struct_name(&st.ast.name)
                let header = type_to_header.get(&st.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_struct(st.ast.name.clone(), header.clone())
                ()
                if is_component:
                    gen.context.register_component(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_component(st.ast.name.clone())
                    ()
                elif is_subsystem:
                    gen.context.register_subsystem(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_subsystem(st.ast.name.clone())
                    ()
                else:
                    gen.type_mapper.register_struct(st.ast.name.clone())
                    ()
            kain_core__types__TypedItem::Actor(a) =>
                let prefixed_name = ue5__to_actor_name(&a.ast.name)
                let header = type_to_header.get(&a.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_actor(a.ast.name.clone(), header)
                ()
                gen.type_mapper.register_actor(a.ast.name.clone())
                ()
            kain_core__types__TypedItem::Component(c) =>
                let prefixed_name = ue5__to_component_name(&c.ast.name)
                let header = type_to_header.get(&c.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_component(c.ast.name.clone(), header)
                ()
                gen.type_mapper.register_component(c.ast.name.clone())
                ()
            kain_core__types__TypedItem::TypeAlias(a) =>
                let prefixed_name = ue5__to_struct_name(&a.ast.name)
                let header = type_to_header.get(&a.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_delegate(a.ast.name.clone(), header)
                ()
                gen.type_mapper.register_delegate(a.ast.name.clone())
                ()
            _ => ()
    ()
    Result::Ok(gen.gen_program(&kain_core::monomorphize::MonomorphizedProgram { items: (*program).items.clone() }))

@doc(doc = "")
@doc(doc = " # Deprecated")
@doc(doc = " This function still accepts `TypedProgram` for backward compatibility.")
@doc(doc = " New code should use `generate()` with a `MonomorphizedProgram` instead.")
@doc(doc = "")
@doc(doc = " # Note")
@doc(doc = " This function internally monomorphizes the program before codegen.")
@doc(doc = " Generic functions will be instantiated automatically.")
pub fn generate_combined(program: &kain_core::TypedProgram, copyright: Option<String>) -> Result<String, KainError>:
    use kain_core::monomorphize

    let mono_program = kain_core__monomorphize__monomorphize(program)?
    let output = generate_filtered(&mono_program, "Kain", none, none, copyright, HashMap__new_(), none)?
    let mut combined = output.header
    combined.push_str("\n// === IMPLEMENTATION (.cpp) ===\n\n")
    ()
    combined.push_str(&output.source)
    ()
    Result::Ok(combined)

@doc(doc = " Generate a standalone header containing ALL stdlib utility functions as static inline implementations.")
@doc(doc = " This is used in modular output mode to create a shared KainStdlib.h that all actor modules include.")
@doc(doc = "")
@doc(doc = " # Deprecated")
@doc(doc = " This function still accepts `TypedProgram` for backward compatibility.")
@doc(doc = " New code should ensure monomorphization happens before calling this.")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `program` - TypedProgram (should be monomorphized first for generic stdlib functions)")
@doc(doc = " * `module_name` - Module name for API macros")
@doc(doc = " * `copyright` - Optional copyright header")
@doc(doc = " * `type_to_header` - Map of type names to header files")
pub fn generate_stdlib_functions(program: &kain_core::TypedProgram, module_name: String, copyright: Option<String>, type_to_header: Map<String, String>, has_gas_features: Bool) -> Result<Ue5Output, KainError>:
    use kain_core::types::TypedItem

    let mut gen = Ue5Gen__new_(module_name, Option::Some("KainStdlib"), copyright, none, type_to_header.clone())
    gen.has_gas_features = has_gas_features
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Enum(en) =>
                let prefixed_name = ue5__to_enum_name(&en.ast.name)
                let header = type_to_header.get(&en.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_enum(en.ast.name.clone(), header)
                ()
                gen.type_mapper.register_enum(en.ast.name.clone())
                ()
            kain_core__types__TypedItem::Struct(st) =>
                let is_component = st.ast.attributes.iter().any(fn(a): (a.name == "component"))
                let is_subsystem = st.ast.attributes.iter().any(fn(a): (a.name == "subsystem"))
                let prefixed_name = if is_subsystem:
                    ue5__to_subsystem_name(&st.ast.name)
                else:
                    ue5__to_struct_name(&st.ast.name)
                let header = type_to_header.get(&st.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_struct(st.ast.name.clone(), header.clone())
                ()
                if is_component:
                    gen.context.register_component(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_component(st.ast.name.clone())
                    ()
                elif is_subsystem:
                    gen.context.register_subsystem(st.ast.name.clone(), header)
                    ()
                    gen.type_mapper.register_subsystem(st.ast.name.clone())
                    ()
                else:
                    gen.type_mapper.register_struct(st.ast.name.clone())
                    ()
            kain_core__types__TypedItem::Actor(a) =>
                let prefixed_name = ue5__to_actor_name(&a.ast.name)
                let header = type_to_header.get(&a.ast.name).cloned().unwrap_or(f"{prefixed_name}.h")
                gen.context.register_actor(a.ast.name.clone(), header)
                ()
                gen.type_mapper.register_actor(a.ast.name.clone())
                ()
            _ => ()
    ()
    let mut output = String__new_()
    output.push_str("// Generated by KAIN Compiler - Stdlib Function Definitions\n")
    ()
    output.push_str("// Do not edit - regenerate from .kn source\n\n")
    ()
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"Kismet/KismetMathLibrary.h\"\n")
    ()
    let mut stdlib_used_types: Set<String> = HashSet__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Function(f) =>
                let is_blueprint = f.ast.attributes.iter().any(fn(a): (((a.name == "blueprint") || (a.name == "blueprint_pure")) || (a.name == "ue5")))
                if (is_blueprint || f.ast.body.stmts.is_empty()):
                    continue
                for param in &f.ast.params:
                    collect_type_names(&param.ty, &mut stdlib_used_types)
                    ()
                ()
                match &f.ast.return_type:
                    Some(ret) =>
                        collect_type_names(ret, &mut stdlib_used_types)
                        ()
                    _ => ()
            _ => ()
    ()
    let mut type_headers: Array<String> = stdlib_used_types.iter().filter_map(fn(t): gen.context.type_to_header.get(t).cloned()).collect()
    type_headers.sort()
    ()
    type_headers.dedup()
    ()
    for type_header in &type_headers:
        output.push_str(&f"#include \"{type_header}\"\n")
        ()
    ()
    output.push_str("\n")
    ()
    let mut func_count = 0
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Function(f) =>
                let is_blueprint = f.ast.attributes.iter().any(fn(a): (((a.name == "blueprint") || (a.name == "blueprint_pure")) || (a.name == "ue5")))
                if is_blueprint:
                    continue
                if (!f.ast.body.stmts.is_empty()):
                    let mut free_func = f.ast.clone()
                    free_func.attributes.retain(fn(a): (((a.name != "blueprint") && (a.name != "blueprint_pure")) && (a.name != "ue5")))
                    ()
                    gen.gen_ufunction(&free_func)
                    ()
                    func_count = (func_count + 1)
                    ()
            _ => ()
    ()
    let implementations = gen.source.build()
    let mut processed = String__new_()
    for line_ in implementations.lines():
        let trimmed = line_.trim()
        if ((((((((!trimmed.is_empty()) && (!trimmed.starts_with("//"))) && (!trimmed.starts_with("#"))) && (!trimmed.starts_with("{"))) && (!trimmed.starts_with("}"))) && line_.chars().next().map_or(false, fn(c): (!c.is_whitespace()))) && trimmed.contains("(")) && (!trimmed.starts_with("static "))):
            processed.push_str(&f"static inline {line_}\n")
            ()
        else:
            processed.push_str(line_)
            ()
            processed.push("\n")
            ()
    ()
    output.push_str(&processed)
    ()
    Result::Ok(Ue5Output { header: output, source: String__new_(), shader_files: Vec__new_() })

struct StringBuilder:
    lines: Array<String>

impl StringBuilder:
    fn new_() -> StringBuilder:
        StringBuilder { lines: Vec__new_() }

    fn push_line(_self: &mut StringBuilder, text: String):
        (*_self).lines.push(f"{text}\n")
        ()

    fn build(_self: &StringBuilder) -> String:
        (*_self).lines.join("")


struct Ue5Gen:
    header: StringBuilder
    source: StringBuilder
    indent: usize
    context: Ue5Context
    target_item: Option<String>
    var_types: Map<String, String>
    shader_file_names: Array<String>
    component_mirrors: Map<String, ue5_shaders::PodMirrorStruct>
    type_fields_map: Map<String, Array<(String, kain_core::ast::Type)>>
    blueprint_fn_names: Set<String>
    blueprint_used_types: Set<String>
    module_name: String
    type_mapper: ue5::types::TypeMapper
    stdlib_resolver: ue5::stdlib_resolver::StdLibResolver
    impl_methods: Map<String, Array<kain_core::ast::Function>>
    has_gas_features: Bool

impl Ue5Gen:
    fn item_symbol_name<a>(_self: &Ue5Gen, item: &a kain_core::types::TypedItem) -> String:
        match item:
            kain_core__types__TypedItem::Actor(a) => &a.ast.name
            kain_core__types__TypedItem::Struct(s) => &s.ast.name
            kain_core__types__TypedItem::Enum(e) => &e.ast.name
            kain_core__types__TypedItem::Function(f) => &f.ast.name
            kain_core__types__TypedItem::Component(c) => &c.ast.name
            kain_core__types__TypedItem::TypeAlias(a) => &a.ast.name
            _ => ""

    fn item_symbol_kind(_self: &Ue5Gen, item: &kain_core::types::TypedItem) -> String:
        match item:
            kain_core__types__TypedItem::Actor(_) => "actor"
            kain_core__types__TypedItem::Struct(_) => "struct"
            kain_core__types__TypedItem::Enum(_) => "enum"
            kain_core__types__TypedItem::Function(_) => "function"
            kain_core__types__TypedItem::Component(_) => "component"
            kain_core__types__TypedItem::TypeAlias(_) => "type_alias"
            kain_core__types__TypedItem::Impl(_) => "impl"
            kain_core__types__TypedItem::Shader(_) => "shader"
            _ => "other"

    fn item_specificity_score(_self: &Ue5Gen, item: &kain_core::types::TypedItem) -> usize:
        match item:
            kain_core__types__TypedItem::Struct(st) => (((st.ast.fields.len() * 16) + (st.ast.methods.len() * 8)) + (st.ast.attributes.len() * 4))
            kain_core__types__TypedItem::Enum(en) => (en.ast.variants.len() * 16)
            kain_core__types__TypedItem::Actor(a) => ((((a.ast.state_.len() * 16) + (a.ast.handlers.len() * 8)) + (a.ast.methods.len() * 8)) + (a.ast.attributes.len() * 4))
            kain_core__types__TypedItem::Component(c) => ((c.ast.state_.len() * 16) + (c.ast.attributes.len() * 4))
            kain_core__types__TypedItem::TypeAlias(alias) => ((alias.ast.generics.len() * 4) + 1)
            kain_core__types__TypedItem::Function(f) => (((f.ast.params.len() * 4) + (usize__from((!f.ast.body.stmts.is_empty())) * 8)) + (f.ast.attributes.len() * 2))
            _ => 0

    fn push_unique_item<a>(_self: &Ue5Gen, items: &mut Array<&a kain_core::types::TypedItem>, indices: &mut Map<(String, String), usize>, item: &a kain_core::types::TypedItem):
        let name = (*_self).item_symbol_name(item)
        if name.is_empty():
            items.push(item)
            ()
            return
        let key = (name.to_string(), (*_self).item_symbol_kind(item))
        let score = (*_self).item_specificity_score(item)
        match indices.entry(key):
            collections__hash_map__Entry::Vacant(vacant) =>
                let idx = items.len()
                items.push(item)
                ()
                vacant.insert(idx)
                ()
            collections__hash_map__Entry::Occupied(occupied) =>
                let idx = (*occupied.get())
                if (score > (*_self).item_specificity_score(items[idx])):
                    items[idx] = item
                    ()

    fn should_emit_kain_runtime_helpers<P>(_self: &Ue5Gen, program: &P) -> Bool:
        let blueprint_library_only = (*_self).target_item.map(fn(t): (t == "__BLUEPRINT_LIBRARY_ONLY__")).unwrap_or(false)
        for item in program.items():
            match &(*_self).target_item:
                Some(target) =>
                    if blueprint_library_only:
                        match item:
                            kain_core__types__TypedItem::Function(f) =>
                                let is_blueprint_fn = f.ast.attributes.iter().any(fn(a): (((a.name == "blueprint") || (a.name == "blueprint_pure")) || (a.name == "ue5")))
                                if (is_blueprint_fn && item_uses_kain_runtime(item)):
                                    return true
                                ()
                            _ =>
                                ()
                                ()
                        continue
                    let item_name = (*_self).item_symbol_name(item)
                    if ((!item_name.is_empty()) && (item_name != target)):
                        continue
                    ()
                _ =>
                    ()
                    ()
            if item_uses_kain_runtime(item):
                return true
        ()
        false

    fn new_(module_name: String, output_name: Option<String>, copyright: Option<String>, target_item: Option<String>, type_to_header: Map<String, String>) -> Ue5Gen:
        let name = output_name.unwrap_or(module_name)
        let mut context = Ue5Context__new_(module_name, copyright)
        context.output_name = name.to_string()
        ()
        context.set_type_to_header(type_to_header)
        ()
        let type_mapper = TypeMapper__with_knowledge(context.knowledge.clone())
        let stdlib_resolver = StdLibResolver__new_()
        Ue5Gen { header: StringBuilder__new_(), source: StringBuilder__new_(), indent: 0, context: context, target_item: target_item, var_types: HashMap__new_(), shader_file_names: Vec__new_(), component_mirrors: HashMap__new_(), type_fields_map: HashMap__new_(), blueprint_fn_names: HashSet__new_(), blueprint_used_types: HashSet__new_(), module_name: module_name.to_string(), type_mapper: type_mapper, stdlib_resolver: stdlib_resolver, impl_methods: HashMap__new_(), has_gas_features: false }

    fn push_indent(_self: &mut Ue5Gen):
        (*_self).indent = ((*_self).indent + 1)
        ()

    fn pop_indent(_self: &mut Ue5Gen):
        if ((*_self).indent > 0):
            (*_self).indent = ((*_self).indent - 1)
            ()

    fn indent_str(_self: &Ue5Gen) -> String:
        ("\t").repeat((*_self).indent)

    fn write_header(_self: &mut Ue5Gen, line_: String):
        let indented = f"{(*_self).indent_str()}{line_}"
        (*_self).header.push_line(&indented)
        ()

    fn write_source(_self: &mut Ue5Gen, line_: String):
        let indented = f"{(*_self).indent_str()}{line_}"
        (*_self).source.push_line(&indented)
        ()

    fn write_blank_header(_self: &mut Ue5Gen):
        (*_self).header.push_line("")
        ()

    fn write_blank_source(_self: &mut Ue5Gen):
        (*_self).source.push_line("")
        ()

    fn interpolate_raw_string(_self: &Ue5Gen, s: String) -> (String, Array<String>):
        let mut fmt = String__new_()
        let mut args = Vec__new_()
        let mut current = s
        loop:
            match current.find("{"):
                Some(start) =>
                    fmt.push_str(&current[..start].replace("%", "%%"))
                    ()
                    current = &current[(start + 1)..]
                    ()
                    match current.find("}"):
                        Some(end) =>
                            let ident = &current[..end]
                            let remapped = (*_self).remap_collection_length_access(&(*_self).remap_pointer_member_access(&(*_self).remap_ident(ident)))
                            if (*_self).is_enum_ident_name(ident):
                                fmt.push_str("%d")
                                ()
                                args.push(f"static_cast<int32>({remapped})")
                                ()
                                ()
                                ()
                                ()
                            else:
                                fmt.push_str("%s")
                                ()
                                if (*_self).is_pointer_type_by_name(ident):
                                    args.push(f"*GetNameSafe({remapped})")
                                    ()
                                    ()
                                    ()
                                    ()
                                else:
                                    args.push(f"*LexToString({remapped})")
                                    ()
                                    ()
                                    ()
                                    ()
                                ()
                            current = &current[(end + 1)..]
                            ()
                        _ =>
                            fmt.push("{")
                            ()
                _ => break
        ()
        fmt.push_str(&current.replace("%", "%%"))
        ()
        (fmt, args)

    fn remap_ident(_self: &Ue5Gen, name: String) -> String:
        (*_self).context.remap_ident(name)

    fn remap_pointer_member_access(_self: &Ue5Gen, expr: String) -> String:
        match expr.split_once("."):
            Some((head, tail)) =>
                if (*_self).is_pointer_type_by_name(head):
                    return f"{head}->{tail}"
                ()
            _ =>
                ()
                ()
        expr.to_string()

    fn remap_collection_length_access(_self: &Ue5Gen, expr: String) -> String:
        for suffix in [".length()", ".len()", ".count()", ".size()"]:
            match expr.strip_suffix(suffix):
                Some(base) => return f"{base}.Num()"
                _ => ()
        ()
        for suffix in [".length", ".len", ".count", ".size"]:
            match expr.strip_suffix(suffix):
                Some(base) => return f"{base}.Num()"
                _ => ()
        ()
        expr.to_string()

    fn is_enum_ident_name(_self: &Ue5Gen, name: String) -> Bool:
        match (*_self).var_types.get(name):
            Some(type_name) => (*_self).context.is_enum(type_name)
            _ => (*_self).context.is_enum(name)

    fn is_pointer_receiver(_self: &Ue5Gen, expr: &kain_core::ast::Expr) -> Bool:
        match expr:
            kain_core__ast__Expr::Ident(name, _) => (*_self).is_pointer_type_by_name(name)
            kain_core__ast__Expr::Field { object: object, field: field } =>
                match (*_self).infer_expr_type(object):
                    Some(obj_type) =>
                        match (*_self).type_fields_map.get(&obj_type):
                            Some(fields) =>
                                for selfhost_for_item in fields:
                                    let (field_name, field_type) = selfhost_for_item
                                    if (field_name == field):
                                        match field_type:
                                            kain_core__ast__Type::Named { name: name } => return (*_self).is_pointer_type_by_name(name)
                                            _ => ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                match object:
                    kain_core__ast__Expr::Ident(obj_name, _) =>
                        if (obj_name == "self"):
                            return (*_self).is_pointer_type_by_name(field)
                        ()
                    _ =>
                        ()
                        ()
                false
            _ => false

    fn infer_expr_type(_self: &Ue5Gen, expr: &kain_core::ast::Expr) -> Option<String>:
        match expr:
            Expr::Int(_, span) => Some(Type::Named { name: "Int".to_string(), generics: Vec__new_(), span: span.clone() })
            Expr::Float(_, span) => Some(Type::Named { name: "Float".to_string(), generics: Vec__new_(), span: span.clone() })
            Expr::Bool(_, span) => Some(Type::Named { name: "Bool".to_string(), generics: Vec__new_(), span: span.clone() })
            Expr::Ident(name, _) => ctx.local_types.get(name).cloned()
            Expr::Field { object: object, field: field } =>
                let object_ty = infer_expr_type(object, ctx)?
                field_type_from_object(&object_ty, field, ctx)
            Expr::Index { object: object } => infer_element_type(object, ctx)
            Expr::Cast { target: target } => Some(target.clone())
            _ => none

    fn register_param_types(_self: &mut Ue5Gen, params: &[kain_core::ast::Param]):
        for p in params:
            match &p.ty:
                kain_core__ast__Type::Named { name: name } =>
                    (*_self).var_types.insert(p.name.clone(), name.clone())
                    ()
                kain_core__ast__Type::Ref { inner: inner } =>
                    match inner:
                        kain_core__ast__Type::Named { name: name } =>
                            (*_self).var_types.insert(p.name.clone(), name.clone())
                            ()
                        _ => ()
                _ => ()

    fn register_field_types(_self: &mut Ue5Gen, fields: &[kain_core::ast::Field]):
        for f in fields:
            match &f.ty:
                kain_core__ast__Type::Named { name: name } =>
                    (*_self).var_types.insert(f.name.clone(), name.clone())
                    ()
                kain_core__ast__Type::Ref { inner: inner } =>
                    match inner:
                        kain_core__ast__Type::Named { name: name } =>
                            (*_self).var_types.insert(f.name.clone(), name.clone())
                            ()
                        _ => ()
                _ => ()

    fn with_var_type_scope<F>(_self: &mut Ue5Gen, f: F):
        let saved = (*_self).var_types.clone()
        f(*_self)
        ()
        (*_self).var_types = saved
        ()

    fn is_pointer_type_by_name(_self: &Ue5Gen, name: String) -> Bool:
        match (*_self).var_types.get(name):
            Some(type_name) => return (*_self).type_mapper.is_pointer_type_by_name(type_name)
            _ =>
                ()
                ()
        if ((*_self).context.is_component(name) || (*_self).context.is_actor(name)):
            return true
        (*_self).type_mapper.is_pointer_type_by_name(name)

    fn is_enum_expr(_self: &Ue5Gen, expr: &kain_core::ast::Expr) -> Bool:
        match expr:
            kain_core__ast__Expr::EnumVariant {  } => true
            kain_core__ast__Expr::Ident(name, _) =>
                match (*_self).var_types.get(name):
                    Some(type_name) => (*_self).context.is_enum(type_name)
                    _ => (*_self).context.is_enum(name)
            kain_core__ast__Expr::Field { object: object, field: field } =>
                match object:
                    kain_core__ast__Expr::Ident(obj, _) =>
                        if (obj == "self"):
                            match (*_self).var_types.get(field):
                                Some(type_name) => return (*_self).context.is_enum(type_name)
                                _ =>
                                    ()
                                    ()
                            ()
                        ()
                    _ =>
                        ()
                        ()
                false
            _ => false

    fn is_likely_float_expr(_self: &Ue5Gen, expr: &kain_core::ast::Expr) -> Bool:
        match expr:
            kain_core__ast__Expr::Float(_, _) => true
            kain_core__ast__Expr::Ident(name, _) =>
                match (*_self).var_types.get(name):
                    Some(type_name) => (type_name == "Float")
                    _ => false
            kain_core__ast__Expr::Field { object: object, field: field } =>
                match object:
                    kain_core__ast__Expr::Ident(obj, _) =>
                        if (obj == "self"):
                            match (*_self).var_types.get(field):
                                Some(type_name) => return (type_name == "Float")
                                _ =>
                                    ()
                                    ()
                            ()
                        ()
                    _ =>
                        ()
                        ()
                false
            _ => false

    fn gen_program<P>(_self: &mut Ue5Gen, program: &P) -> Ue5Output:
        let needs_replication = program.items().iter().any(fn(item): none)
        if needs_replication:
            (*_self).context.use_feature("Replication")
            ()
            ()
            ()
            ()
        let shaders: Array<&kain_core::types::TypedShader> = program.items().iter().filter_map(fn(item): none).collect()
        (*_self).blueprint_used_types.clear()
        ()
        for item in program.items():
            match item:
                kain_core__types__TypedItem::Function(f) =>
                    if f.ast.attributes.iter().any(fn(a): ((a.name == "blueprint") || (a.name == "blueprint_pure"))):
                        for param in &f.ast.params:
                            collect_type_names(&param.ty, &mut (*_self).blueprint_used_types)
                            ()
                        ()
                        match &f.ast.return_type:
                            Some(ret) =>
                                collect_type_names(ret, &mut (*_self).blueprint_used_types)
                                ()
                            _ => ()
                _ => ()
        ()
        let blueprint_library_only = (*_self).target_item.map(fn(t): (t == "__BLUEPRINT_LIBRARY_ONLY__")).unwrap_or(false)
        let target_dispatches_shaders = match &(*_self).target_item:
            Some(target) => program.items().iter().any(fn(item): none)
            _ => (!shaders.is_empty())
        let normalize_shader_name = fn(name: String): name.replace("_", "").to_ascii_lowercase()
        let available_shader_bases: Array<String> = (*_self).shader_file_names.iter().map(fn(shader_file_name): shader_file_name.rsplit(["/", "\\"]).next().unwrap_or(shader_file_name).strip_suffix(".usf").unwrap_or_else(fn(): shader_file_name.rsplit(["/", "\\"]).next().unwrap_or(shader_file_name)).to_string()).collect()
        let mut selected_shader_bases: Array<String> = match &(*_self).target_item:
            Some(target) =>
                match program.items().iter().find_map(fn(item): none):
                    Some(actor_) =>
                        let requested: Array<String> = actor_.ast.attributes.iter().find(fn(a): (a.name == "dispatch")).map(fn(attr): attr.args.iter().filter_map(fn(arg): none).collect()).unwrap_or_default()
                        if requested.is_empty():
                            Vec__new_()
                        else:
                            requested.into_iter().map(fn(req): available_shader_bases.iter().find(fn(base): (normalize_shader_name(base) == normalize_shader_name(&req))).cloned().unwrap_or(req)).collect()
                    _ => Vec__new_()
            _ => available_shader_bases
        let mut deduped_shader_bases: Array<String> = Vec__new_()
        let mut seen_shader_bases: Set<String> = HashSet__new_()
        for shader_base in selected_shader_bases.drain(range(0, 0)):
            if seen_shader_bases.insert(shader_base.clone()):
                deduped_shader_bases.push(shader_base)
                ()
        ()
        let target_item_kind = match &(*_self).target_item:
            Some(target) => program.items().iter().find_map(fn(item): none).unwrap_or("unknown")
            _ => "all"
        let mut target_is_subsystem = false
        let mut target_is_tick_subsystem = false
        match &(*_self).target_item:
            Some(target) =>
                for item in program.items():
                    match item:
                        kain_core__types__TypedItem::Struct(s) =>
                            if (&s.ast.name == target):
                                target_is_subsystem = s.ast.attributes.iter().any(fn(a): (a.name == "subsystem"))
                                ()
                                target_is_tick_subsystem = (target_is_subsystem && s.ast.attributes.iter().any(fn(a): (a.name == "tick")))
                                ()
                                break
                        _ => ()
                ()
                ()
            _ =>
                ()
                ()
        let mut includes: Array<String> = Vec__new_()
        if blueprint_library_only:
            includes.push("Kismet/BlueprintFunctionLibrary.h")
            ()
            ()
            ()
            ()
        else:
            match target_item_kind:
                "actor" =>
                    includes.push("GameFramework/Actor.h")
                    ()
                    if needs_replication:
                        includes.push("Net/UnrealNetwork.h")
                        ()
                        ()
                        ()
                        ()
                    ()
                "component" =>
                    includes.push("Components/ActorComponent.h")
                    ()
                    if needs_replication:
                        includes.push("Net/UnrealNetwork.h")
                        ()
                        ()
                        ()
                        ()
                    ()
                "datatable" =>
                    includes.push("Engine/DataTable.h")
                    ()
                    ()
                    ()
                    ()
                "struct" =>
                    if target_is_subsystem:
                        includes.push("Subsystems/WorldSubsystem.h")
                        ()
                        ()
                        ()
                        ()
                    if target_is_tick_subsystem:
                        includes.push("Tickable.h")
                        ()
                        ()
                        ()
                        ()
                    ()
                "enum" =>
