            (*_self).source.push_line("\t\t\tauto CreateRenderTarget = [&](FRHICommandListImmediate& RHICmdList, UTextureRenderTarget2D* RT, const TCHAR* Name) -> TRefCountPtr<IPooledRenderTarget> {")
            ()
            (*_self).source.push_line("\t\t\t\tif (!RT || !RT->GetResource()) return nullptr;")
