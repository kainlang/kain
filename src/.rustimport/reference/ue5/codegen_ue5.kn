trait ProgramItems:
    fn items(_self: &Self_) -> &[kain_core::types::TypedItem]:
        let __selfhost_empty = none

impl ProgramItems for kain_core::TypedProgram:
    fn items(_self: &kain_core::TypedProgram) -> &[kain_core::types::TypedItem]:
        &(*_self).items


impl ProgramItems for kain_core::MonomorphizedProgram:
    fn items(_self: &kain_core::MonomorphizedProgram) -> &[kain_core::types::TypedItem]:
        &(*_self).items


