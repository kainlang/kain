            ()
            (*_self).source.push_line("\t\t\tFRDGTextureRef VelocityInput = GraphBuilder.RegisterExternalTexture(CreateRenderTarget(RHICmdList, bOddFrame ? VelocityRT_A : VelocityRT_B, TEXT(\"VelIn\")));")
            ()
            (*_self).source.push_line("\t\t\tFRDGTextureRef VelocityOutput = GraphBuilder.RegisterExternalTexture(CreateRenderTarget(RHICmdList, bOddFrame ? VelocityRT_B : VelocityRT_A, TEXT(\"VelOut\")));")
            ()
            (*_self).source.push_line("")
            ()
            let mut needed_intermediates = HashSet__new_()
