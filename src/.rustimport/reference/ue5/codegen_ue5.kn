                    if is_texture:
                        has_explicit_texture_uniform = true
                        ()
                        let mut matched_texture = false
                        if is_buffer_srv:
                            call_args.push(("nullptr").to_string())
                            ()
                            matched_texture = true
                            ()
                            ()
                            ()
