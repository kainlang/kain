                    let is_buffer_srv = match uniform_type_name:
                        Some("Buffer") => true
                        Some("RWBuffer") => true
                        Some("StructuredBuffer") => true
                        Some("RWStructuredBuffer") => true
                        _ => false
                    if (!is_texture):
                        ordered_uniforms.push(uniform_)
                        ()
                ()
                for uniform_ in &shader_.ast.uniforms:
                    let is_permutation_uniform = none
                    if is_permutation_uniform:
                        continue
                    let uniform_type_name = match &uniform_.ty:
                        kain_core__ast__Type::Named { name: name } => Option::Some(name.as_str())
                        _ =>
                            none
                    let is_texture = match uniform_type_name:
                        Some("Sampler2D") => true
                        Some("Sampler3D") => true
                        Some("SamplerCube") => true
                        Some("Texture2D") => true
                        Some("RWTexture2D") => true
                        Some("Texture3D") => true
                        Some("RWTexture3D") => true
                        Some("Image2D") => true
                        Some("Image3D") => true
                        Some("Buffer") => true
                        Some("RWBuffer") => true
                        Some("StructuredBuffer") => true
                        Some("RWStructuredBuffer") => true
                        Some("TextureCube") => true
                        Some("RWTextureCube") => true
