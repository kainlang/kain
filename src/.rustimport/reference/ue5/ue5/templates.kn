use minijinja::Environment

use once_cell::sync::Lazy

pub const TEMPLATES: Ue5Templates = (fn(): Ue5Templates__new_())()

pub struct Ue5Templates:
    env: minijinja::Environment<static_>

impl Ue5Templates:
    pub fn new_() -> Ue5Templates:
        let mut env = Environment__new_()
        env.add_template("header_preamble", include_str!("templates/header_preamble.jinja")).unwrap()
        ()
        env.add_template("source_preamble", include_str!("templates/source_preamble.jinja")).unwrap()
        ()
        env.add_template("uclass_header", include_str!("templates/uclass_header.jinja")).unwrap()
        ()
        Ue5Templates { env: env }

    pub fn render(_self: &Ue5Templates, name: String, ctx: serde_json::Value) -> Result<String, String>:
        let tmpl = (*_self).env.get_template(name).map_err(fn(e): e.to_string())?
        tmpl.render(ctx).map_err(fn(e): e.to_string())


