use crate::target_ir::TargetActorIR

use crate::target_ir::TraceTypeIR

use kain_core::error::KainResult

@derive(Debug, Clone)
pub struct TargetActorOutput:
    header: String
    source: String

pub fn generate(target_ir: &TargetActorIR, _plugin_name: String) -> Result<TargetActorOutput, KainError>:
    let class_name = f"A{(*target_ir).name}"
    let header = generate_header(target_ir, &class_name)?
    let source = generate_source(target_ir, &class_name)?
    Result::Ok(TargetActorOutput { header: header, source: source })

fn generate_header(target_ir: &TargetActorIR, class_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"Abilities/GameplayAbilityTargetActor.h\"\n")
    ()
    output.push_str(&f"#include \"{(*target_ir).name}.generated.h\"\n\n")
    ()
    output.push_str("UCLASS()\n")
    ()
    output.push_str(&f"class {class_name} : public AGameplayAbilityTargetActor\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("\tGENERATED_BODY()\n\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"\t{class_name}();\n\n")
    ()
    if (*target_ir).max_range.is_some():
        output.push_str("\tUPROPERTY(BlueprintReadWrite, EditAnywhere, Category = \"Targeting\")\n")
        ()
        output.push_str("\tfloat MaxRange;\n\n")
        ()
        ()
        ()
        ()
    if (*target_ir).trace_channel.is_some():
        output.push_str("\tUPROPERTY(BlueprintReadWrite, EditAnywhere, Category = \"Targeting\")\n")
        ()
        output.push_str("\tFName TraceChannel;\n\n")
        ()
        ()
        ()
        ()
    output.push_str("\tvirtual void StartTargeting(UGameplayAbility* Ability) override;\n")
    ()
    for method in &(*target_ir).custom_methods:
        output.push_str(&f"\tvoid {method.name}();\n")
        ()
    ()
    output.push_str("};\n")
    ()
    Result::Ok(output)

fn generate_source(target_ir: &TargetActorIR, class_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str(&f"#include \"Targeting/{(*target_ir).name}.h\"\n")
    ()
    output.push_str("#include \"AbilitySystemComponent.h\"\n\n")
    ()
    output.push_str(&f"{class_name}::{class_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("\tPrimaryActorTick.bCanEverTick = true;\n")
    ()
    match (*target_ir).max_range:
        Some(max_range) =>
            output.push_str(&f"\tMaxRange = {max_range}f;\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*target_ir).trace_channel:
        Some(channel) =>
            output.push_str(&f"\tTraceChannel = FName(\"{channel}\");\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {class_name}::StartTargeting(UGameplayAbility* Ability)\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("\tSuper::StartTargeting(Ability);\n")
    ()
    output.push_str("\t// TODO: Initialize targeting\n")
    ()
    output.push_str("}\n\n")
    ()
    for method in &(*target_ir).custom_methods:
        output.push_str(&f"void {class_name}::{method.name}()\n")
        ()
        output.push_str("{\n")
        ()
        output.push_str(&f"\t{method.body}\n")
        ()
        output.push_str("}\n\n")
        ()
    ()
    Result::Ok(output)

