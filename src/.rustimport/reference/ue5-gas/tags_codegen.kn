use crate::tags_ir::GameplayTagIR

use crate::tags_ir::GameplayTagsIR

use anyhow::Result

use std::collections::BTreeMap

@doc(doc = " Output from tag codegen")
@derive(Debug, Clone)
pub struct TagCodegenOutput:
    header: String
    implementation: String
    ini_file: String

@doc(doc = " Generate all tag files from IR")
pub fn generate(ir: &GameplayTagsIR, plugin_name: String) -> Result<TagCodegenOutput, Error>:
    let header = generate_header(ir, plugin_name)?
    let implementation = generate_implementation(ir, plugin_name)?
    let ini_file = generate_ini_file(ir)?
    Result::Ok(TagCodegenOutput { header: header, implementation: implementation, ini_file: ini_file })

@doc(doc = " Generate GameplayTags.h with native tag declarations")
fn generate_header(ir: &GameplayTagsIR, plugin_name: String) -> Result<String, Error>:
    let mut output = String__new_()
    output.push_str("#pragma once\n")
    ()
    output.push_str("#include \"NativeGameplayTags.h\"\n\n")
    ()
    let api_macro = f"{plugin_name.to_uppercase()}_API"
    output.push_str(&f"namespace {plugin_name}Tags\n")
    ()
    output.push_str("{\n")
    ()
    let all_tags: Array<&GameplayTagIR> = ir.all_tags()
    generate_namespace_hierarchy(&mut output, &all_tags, &api_macro, 1, true)?
    ()
    output.push_str("}\n")
    ()
    Result::Ok(output)

@doc(doc = " Generate GameplayTags.cpp with native tag definitions")
fn generate_implementation(ir: &GameplayTagsIR, plugin_name: String) -> Result<String, Error>:
    let mut output = String__new_()
    output.push_str("#include \"GameplayTags.h\"\n\n")
    ()
    output.push_str(&f"namespace {plugin_name}Tags\n")
    ()
    output.push_str("{\n")
    ()
    let all_tags: Array<&GameplayTagIR> = ir.all_tags()
    generate_namespace_hierarchy(&mut output, &all_tags, "", 1, false)?
    ()
    output.push_str("}\n")
    ()
    Result::Ok(output)

@doc(doc = " Generate hierarchical namespace structure recursively")
@doc(doc = " depth: current depth in the tag hierarchy (1-indexed)")
@doc(doc = " is_header: true for declarations, false for definitions")
fn generate_namespace_hierarchy(output: String, tags: &[&GameplayTagIR], api_macro: String, depth: usize, is_header: Bool) -> Result<(), Error>:
    let indent = ("    ").repeat(depth)
    fn emitted_leaf_symbol_name(tag: &GameplayTagIR, has_same_named_child_namespace: Bool) -> String:
        let leaf = tag.leaf_name()
        if has_same_named_child_namespace:
            f"{leaf}Tag"
        else:
            leaf.to_string()

    let mut groups: Map<String, Array<&GameplayTagIR>> = BTreeMap__new_()
    for tag in tags:
        let parts = tag.namespace_parts()
        if (parts.len() == depth):
            groups.entry(("").to_string()).or_insert_with(Vec__new_).push(tag)
            ()
        elif (parts.len() > depth):
            let ns_key = parts[(depth - 1)].clone()
            groups.entry(ns_key).or_insert_with(Vec__new_).push(tag)
            ()
    ()
    let child_namespace_names: Set<String> = groups.keys().filter(fn(k): (!k.is_empty())).cloned().collect()
    for selfhost_for_item in groups:
        let (ns_name, group_tags) = selfhost_for_item
        if ns_name.is_empty():
            for tag in group_tags:
                let symbol_name = emitted_leaf_symbol_name(tag, child_namespace_names.contains(&tag.leaf_name().to_string()))
                if is_header:
                    output.push_str(&f"{indent}{api_macro} UE_DECLARE_GAMEPLAY_TAG_EXTERN({symbol_name});\n")
                    ()
                else:
                    match &tag.comment:
                        Some(comment) =>
                            output.push_str(&f"{indent}UE_DEFINE_GAMEPLAY_TAG_COMMENT(\n")
                            ()
                            output.push_str(&f"{indent}    {symbol_name},\n")
                            ()
                            output.push_str(&f"{indent}    \"{tag.tag}\",\n")
                            ()
                            output.push_str(&f"{indent}    \"{comment}\"\n")
                            ()
                            output.push_str(&f"{indent});\n")
                            ()
                        _ =>
                            output.push_str(&f"{indent}UE_DEFINE_GAMEPLAY_TAG({symbol_name}, \"{tag.tag}\");\n")
                            ()
        else:
            output.push_str(&f"{indent}namespace {ns_name}\n")
            ()
            output.push_str(&"{indent}{\n")
            ()
            generate_namespace_hierarchy(output, &group_tags, api_macro, (depth + 1), is_header)?
            ()
            output.push_str(&"{indent}}\n")
            ()
    ()
    Result::Ok(())

@doc(doc = " Generate DefaultGameplayTags.ini file")
fn generate_ini_file(ir: &GameplayTagsIR) -> Result<String, Error>:
    let mut output = String__new_()
    output.push_str("[/Script/GameplayTags.GameplayTagsList]\n")
    ()
    for namespace_ in &(*ir).namespaces:
        output.push_str(&f"; {namespace_.name} Tags\n")
        ()
        for tag in &namespace_.tags:
            match &tag.comment:
                Some(comment) =>
                    output.push_str(&f"GameplayTagList=(Tag=\"{tag.tag}\",DevComment=\"{comment}\")\n")
                    ()
                _ =>
                    output.push_str(&f"GameplayTagList=(Tag=\"{tag.tag}\")\n")
                    ()
        ()
        output.push_str("\n")
        ()
    ()
    Result::Ok(output)

