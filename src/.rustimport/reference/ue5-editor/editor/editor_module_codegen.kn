use crate::editor::editor_module_ir::EditorModuleIR

use crate::editor::editor_module_ir::MenuEntryIR

use crate::editor::editor_module_ir::ToolbarButtonIR

@doc(doc = " Output from editor module code generation")
@derive(Debug, Clone)
pub struct EditorModuleCodegenOutput:
    header: String
    source: String
    includes: Array<String>

@doc(doc = " Generate editor module code from IR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `ir` - The editor module intermediate representation")
@doc(doc = " * `plugin_name` - Name of the plugin (for API macro)")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `EditorModuleCodegenOutput` - Generated header and source files")
pub fn generate_editor_module_code(ir: &EditorModuleIR, plugin_name: String) -> EditorModuleCodegenOutput:
    let class_name = f"F{(*ir).name}"
    let api_macro = f"{plugin_name.to_uppercase()}_API"
    let mut header = String__new_()
    let mut source = String__new_()
    generate_header(ir, &class_name, &api_macro, &mut header)
    ()
    generate_source(ir, &class_name, plugin_name, &mut source)
    ()
    EditorModuleCodegenOutput { header: header, source: source, includes: [("CoreMinimal.h").to_string(), ("Modules/ModuleManager.h").to_string(), ("LevelEditor.h").to_string(), ("Framework/Commands/Commands.h").to_string(), ("Framework/MultiBox/MultiBoxBuilder.h").to_string()] }

@doc(doc = " Generate header file content")
fn generate_header(ir: &EditorModuleIR, class_name: String, api_macro: String, output: String):
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"Modules/ModuleManager.h\"\n\n")
    ()
    if (!(*ir).menu_entries.is_empty()):
        generate_commands_class(ir, output)
        ()
        ()
        ()
        ()
    output.push_str(&f"class {api_macro} {class_name} : public IModuleInterface\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str("    /** IModuleInterface implementation */\n")
    ()
    output.push_str("    virtual void StartupModule() override;\n")
    ()
    output.push_str("    virtual void ShutdownModule() override;\n\n")
    ()
    if (!(*ir).menu_entries.is_empty()):
        output.push_str("    /** Menu entry callbacks */\n")
        ()
        for menu_entry in &(*ir).menu_entries:
            output.push_str(&f"    void {menu_entry.method_name}();\n")
            ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    if (!(*ir).toolbar_buttons.is_empty()):
        output.push_str("    /** Toolbar button callbacks */\n")
        ()
        for toolbar_button in &(*ir).toolbar_buttons:
            output.push_str(&f"    void {toolbar_button.method_name}();\n")
            ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    output.push_str("private:\n")
    ()
    if (!(*ir).menu_entries.is_empty()):
        output.push_str("    /** Register menu extensions */\n")
        ()
        output.push_str("    void RegisterMenuExtensions();\n\n")
        ()
        ()
        ()
        ()
    if (!(*ir).toolbar_buttons.is_empty()):
        output.push_str("    /** Register toolbar extensions */\n")
        ()
        output.push_str("    void RegisterToolbarExtensions();\n\n")
        ()
        ()
        ()
        ()
    if (!(*ir).menu_entries.is_empty()):
        output.push_str("    /** Menu extender */\n")
        ()
        output.push_str("    TSharedPtr<FExtender> MenuExtender;\n\n")
        ()
        ()
        ()
        ()
    if (!(*ir).toolbar_buttons.is_empty()):
        output.push_str("    /** Toolbar extender */\n")
        ()
        output.push_str("    TSharedPtr<FExtender> ToolbarExtender;\n\n")
        ()
        ()
        ()
        ()
    output.push_str("};\n")
    ()

@doc(doc = " Generate commands class for menu entries")
fn generate_commands_class(ir: &EditorModuleIR, output: String):
    let commands_class_name = f"F{(*ir).name}Commands"
    output.push_str(&f"class {commands_class_name} : public TCommands<{commands_class_name}>\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"    {commands_class_name}()\n")
    ()
    output.push_str(&f"        : TCommands<{commands_class_name}>(TEXT(\"{(*ir).name}\"),\n")
    ()
    output.push_str(&f"            NSLOCTEXT(\"{(*ir).name}\", \"ContextDescription\", \"{(*ir).name} commands\"),\n")
    ()
    output.push_str("            NAME_None,\n")
    ()
    output.push_str("            FEditorStyle::GetStyleSetName())\n")
    ()
    output.push_str("    {}\n\n")
    ()
    output.push_str("    virtual void RegisterCommands() override;\n\n")
    ()
    for menu_entry in &(*ir).menu_entries:
        let command_name = f"{menu_entry.method_name}Command"
        output.push_str(&f"    TSharedPtr<FUICommandInfo> {command_name};\n")
        ()
    ()
    output.push_str("};\n\n")
    ()

@doc(doc = " Generate source file content")
fn generate_source(ir: &EditorModuleIR, class_name: String, plugin_name: String, output: String):
    output.push_str(&f"#include \"{(*ir).name}.h\"\n")
    ()
    output.push_str("#include \"LevelEditor.h\"\n")
    ()
    output.push_str("#include \"Framework/Commands/Commands.h\"\n")
    ()
    output.push_str("#include \"Framework/MultiBox/MultiBoxBuilder.h\"\n\n")
    ()
    if (!(*ir).menu_entries.is_empty()):
        generate_commands_implementation(ir, output)
        ()
        ()
        ()
        ()
    generate_startup_module(ir, class_name, output)
    ()
    generate_shutdown_module(ir, class_name, output)
    ()
    for menu_entry in &(*ir).menu_entries:
        generate_menu_entry_callback(ir, class_name, menu_entry, output)
        ()
    ()
    for toolbar_button in &(*ir).toolbar_buttons:
        generate_toolbar_button_callback(ir, class_name, toolbar_button, output)
        ()
    ()
    if (!(*ir).menu_entries.is_empty()):
        generate_menu_extension_registration(ir, class_name, output)
        ()
        ()
        ()
        ()
    if (!(*ir).toolbar_buttons.is_empty()):
        generate_toolbar_extension_registration(ir, class_name, output)
        ()
        ()
        ()
        ()
    output.push_str(&f"\nIMPLEMENT_MODULE({class_name}, {plugin_name})\n")
    ()

@doc(doc = " Generate commands class RegisterCommands implementation")
fn generate_commands_implementation(ir: &EditorModuleIR, output: String):
    let commands_class_name = f"F{(*ir).name}Commands"
    output.push_str(&f"void {commands_class_name}::RegisterCommands()\n")
    ()
    output.push_str("{\n")
    ()
    for menu_entry in &(*ir).menu_entries:
        let command_name = f"{menu_entry.method_name}Command"
        output.push_str(&f"    UI_COMMAND({command_name}, \"{menu_entry.label}\", \"{menu_entry.tooltip.unwrap_or(&menu_entry.label)}\", EUserInterfaceActionType::Button, FInputChord());\n")
        ()
    ()
    output.push_str("}\n\n")
    ()

@doc(doc = " Generate StartupModule implementation")
fn generate_startup_module(ir: &EditorModuleIR, class_name: String, output: String):
    output.push_str(&f"void {class_name}::StartupModule()\n")
    ()
    output.push_str("{\n")
    ()
    if (!(*ir).menu_entries.is_empty()):
        let commands_class_name = f"F{(*ir).name}Commands"
        output.push_str(&f"    {commands_class_name}::Register();\n\n")
        ()
        ()
        ()
        ()
    if (!(*ir).menu_entries.is_empty()):
        output.push_str("    RegisterMenuExtensions();\n")
        ()
        ()
        ()
        ()
    if (!(*ir).toolbar_buttons.is_empty()):
        output.push_str("    RegisterToolbarExtensions();\n")
        ()
        ()
        ()
        ()
    output.push_str("}\n\n")
    ()

@doc(doc = " Generate ShutdownModule implementation")
fn generate_shutdown_module(ir: &EditorModuleIR, class_name: String, output: String):
    output.push_str(&f"void {class_name}::ShutdownModule()\n")
    ()
    output.push_str("{\n")
    ()
    if (!(*ir).menu_entries.is_empty()):
        let commands_class_name = f"F{(*ir).name}Commands"
        output.push_str(&f"    {commands_class_name}::Unregister();\n\n")
        ()
        ()
        ()
        ()
    if (!(*ir).menu_entries.is_empty()):
        output.push_str("    if (MenuExtender.IsValid())\n")
        ()
        output.push_str("    {\n")
        ()
        output.push_str("        FLevelEditorModule& LevelEditorModule = FModuleManager::LoadModuleChecked<FLevelEditorModule>(\"LevelEditor\");\n")
        ()
        output.push_str("        LevelEditorModule.GetMenuExtensibilityManager()->RemoveExtender(MenuExtender);\n")
        ()
        output.push_str("    }\n\n")
        ()
        ()
        ()
        ()
    if (!(*ir).toolbar_buttons.is_empty()):
        output.push_str("    if (ToolbarExtender.IsValid())\n")
        ()
        output.push_str("    {\n")
        ()
        output.push_str("        FLevelEditorModule& LevelEditorModule = FModuleManager::LoadModuleChecked<FLevelEditorModule>(\"LevelEditor\");\n")
        ()
        output.push_str("        LevelEditorModule.GetToolBarExtensibilityManager()->RemoveExtender(ToolbarExtender);\n")
        ()
        output.push_str("    }\n")
        ()
        ()
        ()
        ()
    output.push_str("}\n\n")
    ()

@doc(doc = " Generate menu entry callback implementation")
fn generate_menu_entry_callback(_ir: &EditorModuleIR, class_name: String, menu_entry: &MenuEntryIR, output: String):
    output.push_str(&f"void {class_name}::{(*menu_entry).method_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str(&f"    // TODO: Implement {(*menu_entry).label} callback\n")
    ()
    output.push_str(&f"    UE_LOG(LogTemp, Log, TEXT(\"Menu entry clicked: {(*menu_entry).label}\"));\n")
    ()
    output.push_str("}\n\n")
    ()

@doc(doc = " Generate toolbar button callback implementation")
fn generate_toolbar_button_callback(_ir: &EditorModuleIR, class_name: String, toolbar_button: &ToolbarButtonIR, output: String):
    output.push_str(&f"void {class_name}::{(*toolbar_button).method_name}()\n")
    ()
    output.push_str("{\n")
    ()
    let label = (*toolbar_button).label.unwrap_or("Toolbar button")
    output.push_str(&f"    // TODO: Implement {label} callback\n")
    ()
    output.push_str(&f"    UE_LOG(LogTemp, Log, TEXT(\"Toolbar button clicked: {label}\"));\n")
    ()
    output.push_str("}\n\n")
    ()

@doc(doc = " Generate menu extension registration")
fn generate_menu_extension_registration(ir: &EditorModuleIR, class_name: String, output: String):
    let commands_class_name = f"F{(*ir).name}Commands"
    output.push_str(&f"void {class_name}::RegisterMenuExtensions()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    MenuExtender = MakeShareable(new FExtender);\n\n")
    ()
    let mut paths: Array<String> = (*ir).menu_entries.iter().map(fn(e): e.path.clone()).collect()
    paths.sort()
    ()
    paths.dedup()
    ()
    for path in &paths:
        output.push_str(&f"    // Menu entries for {path}\n")
        ()
        output.push_str("    MenuExtender->AddMenuExtension(\n")
        ()
        output.push_str(&f"        \"{path}\",\n")
        ()
        output.push_str("        EExtensionHook::After,\n")
        ()
        output.push_str(&f"        {commands_class_name}::Get().GetCommandList(),\n")
        ()
        output.push_str(&"        FMenuExtensionDelegate::CreateRaw(this, &{class_name}::Extend{path.replace(\"/\", \"\")}Menu));\n\n")
        ()
    ()
    output.push_str("    FLevelEditorModule& LevelEditorModule = FModuleManager::LoadModuleChecked<FLevelEditorModule>(\"LevelEditor\");\n")
    ()
    output.push_str("    LevelEditorModule.GetMenuExtensibilityManager()->AddExtender(MenuExtender);\n")
    ()
    output.push_str("}\n\n")
    ()
    for path in &paths:
        let entries: Array<&MenuEntryIR> = (*ir).menu_entries.iter().filter(fn(e): (&e.path == path)).collect()
        let method_name = "Extend{path.replace(\"/\", \"\")}Menu"
        output.push_str(&f"void {class_name}::{method_name}(FMenuBuilder& MenuBuilder)\n")
        ()
        output.push_str("{\n")
        ()
        for entry in entries:
            let command_name = f"{entry.method_name}Command"
            output.push_str(&f"    MenuBuilder.AddMenuEntry(F{(*ir).name}Commands::Get().{command_name});\n")
            ()
        ()
        output.push_str("}\n\n")
        ()

@doc(doc = " Generate toolbar extension registration")
fn generate_toolbar_extension_registration(ir: &EditorModuleIR, class_name: String, output: String):
    output.push_str(&f"void {class_name}::RegisterToolbarExtensions()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    ToolbarExtender = MakeShareable(new FExtender);\n\n")
    ()
    let mut sections: Array<String> = (*ir).toolbar_buttons.iter().map(fn(b): b.section.clone()).collect()
    sections.sort()
    ()
    sections.dedup()
    ()
    for section in &sections:
        output.push_str(&f"    // Toolbar buttons for {section} section\n")
        ()
        output.push_str("    ToolbarExtender->AddToolBarExtension(\n")
        ()
        output.push_str(&f"        \"{section}\",\n")
        ()
        output.push_str("        EExtensionHook::After,\n")
        ()
        output.push_str("        nullptr,\n")
        ()
        output.push_str(&f"        FToolBarExtensionDelegate::CreateRaw(this, &{class_name}::Extend{section}Toolbar));\n\n")
        ()
    ()
    output.push_str("    FLevelEditorModule& LevelEditorModule = FModuleManager::LoadModuleChecked<FLevelEditorModule>(\"LevelEditor\");\n")
    ()
    output.push_str("    LevelEditorModule.GetToolBarExtensibilityManager()->AddExtender(ToolbarExtender);\n")
    ()
    output.push_str("}\n\n")
    ()
    for section in &sections:
        let buttons: Array<&ToolbarButtonIR> = (*ir).toolbar_buttons.iter().filter(fn(b): (&b.section == section)).collect()
        let method_name = f"Extend{section}Toolbar"
        output.push_str(&f"void {class_name}::{method_name}(FToolBarBuilder& ToolbarBuilder)\n")
        ()
        output.push_str("{\n")
        ()
        for button in buttons:
            let label = button.label.unwrap_or("")
            let tooltip = button.tooltip.unwrap_or(label)
            output.push_str("    ToolbarBuilder.AddToolBarButton(\n")
            ()
            output.push_str(&f"        FUIAction(FExecuteAction::CreateRaw(this, &{class_name}::{button.method_name})),\n")
            ()
            output.push_str(&"        NAME_None,\n")
            ()
            output.push_str(&f"        LOCTEXT(\"{button.method_name}_Label\", \"{label}\"),\n")
            ()
            output.push_str(&f"        LOCTEXT(\"{button.method_name}_Tooltip\", \"{tooltip}\"),\n")
            ()
            output.push_str(&f"        FSlateIcon(FEditorStyle::GetStyleSetName(), TEXT(\"{button.icon}\")));\n")
            ()
        ()
        output.push_str("}\n\n")
        ()

