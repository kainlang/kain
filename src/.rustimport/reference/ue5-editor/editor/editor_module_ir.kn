use kain_core::ast::EditorModuleDef

use kain_core::ast::MenuEntryDef

use kain_core::ast::ToolbarButtonDef

use kain_core::ast::ToolbarPosition

use kain_core::ast::ToolbarWidgetDef

@doc(doc = " Editor module intermediate representation")
@doc(doc = " Represents an editor module with menu entries, toolbar buttons, and widgets")
@derive(Debug, Clone)
pub struct EditorModuleIR:
    name: String
    menu_entries: Array<MenuEntryIR>
    toolbar_buttons: Array<ToolbarButtonIR>
    toolbar_widgets: Array<ToolbarWidgetIR>

@doc(doc = " A single menu entry in the editor")
@derive(Debug, Clone)
pub struct MenuEntryIR:
    path: String
    label: String
    method_name: String
    icon: Option<String>
    tooltip: Option<String>

@doc(doc = " A toolbar button in the editor")
@derive(Debug, Clone)
pub struct ToolbarButtonIR:
    section: String
    label: Option<String>
    icon: String
    method_name: String
    tooltip: Option<String>

@doc(doc = " A toolbar widget in the editor")
@derive(Debug, Clone)
pub struct ToolbarWidgetIR:
    section: String
    position: ToolbarPositionIR
    widget_type: String

pub enum ToolbarPositionIR:
    Before
    After
    Start
    End

@doc(doc = " Convert an editor module definition from AST to EditorModuleIR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `editor_module` - The editor module definition from AST")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `Ok(EditorModuleIR)` - Successfully converted IR")
@doc(doc = " * `Err(String)` - Conversion error with description")
pub fn convert_to_editor_module_ir(editor_module: &kain_core::ast::EditorModuleDef) -> Result<EditorModuleIR, String>:
    let mut menu_entries = Vec__new_()
    for menu_entry_def in &(*editor_module).menu_entries:
        let menu_entry_ir = convert_menu_entry(menu_entry_def)?
        menu_entries.push(menu_entry_ir)
        ()
    ()
    let mut toolbar_buttons = Vec__new_()
    for toolbar_button_def in &(*editor_module).toolbar_buttons:
        let toolbar_button_ir = convert_toolbar_button(toolbar_button_def)?
        toolbar_buttons.push(toolbar_button_ir)
        ()
    ()
    let mut toolbar_widgets = Vec__new_()
    for toolbar_widget_def in &(*editor_module).toolbar_widgets:
        let toolbar_widget_ir = convert_toolbar_widget(toolbar_widget_def)?
        toolbar_widgets.push(toolbar_widget_ir)
        ()
    ()
    Result::Ok(EditorModuleIR { name: (*editor_module).name.clone(), menu_entries: menu_entries, toolbar_buttons: toolbar_buttons, toolbar_widgets: toolbar_widgets })

@doc(doc = " Convert a menu entry definition to MenuEntryIR")
fn convert_menu_entry(menu_entry_def: &kain_core::ast::MenuEntryDef) -> Result<MenuEntryIR, String>:
    Result::Ok(MenuEntryIR { path: (*menu_entry_def).path.clone(), label: (*menu_entry_def).label.clone(), method_name: (*menu_entry_def).method.name.clone(), icon: (*menu_entry_def).icon.clone(), tooltip: (*menu_entry_def).tooltip.clone() })

@doc(doc = " Convert a toolbar button definition to ToolbarButtonIR")
fn convert_toolbar_button(toolbar_button_def: &kain_core::ast::ToolbarButtonDef) -> Result<ToolbarButtonIR, String>:
    Result::Ok(ToolbarButtonIR { section: (*toolbar_button_def).section.clone(), label: (*toolbar_button_def).label.clone(), icon: (*toolbar_button_def).icon.clone(), method_name: (*toolbar_button_def).method.name.clone(), tooltip: (*toolbar_button_def).tooltip.clone() })

@doc(doc = " Convert a toolbar widget definition to ToolbarWidgetIR")
fn convert_toolbar_widget(toolbar_widget_def: &kain_core::ast::ToolbarWidgetDef) -> Result<ToolbarWidgetIR, String>:
    let position = match (*toolbar_widget_def).position:
        kain_core__ast__ToolbarPosition::Before => ToolbarPositionIR__Before
        kain_core__ast__ToolbarPosition::After => ToolbarPositionIR__After
        kain_core__ast__ToolbarPosition::Start => ToolbarPositionIR__Start
        kain_core__ast__ToolbarPosition::End => ToolbarPositionIR__End
    Result::Ok(ToolbarWidgetIR { section: (*toolbar_widget_def).section.clone(), position: position, widget_type: (*toolbar_widget_def).widget_type.clone() })

