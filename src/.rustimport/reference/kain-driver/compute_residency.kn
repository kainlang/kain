use std::fs

use std::path::Path

use std::path::PathBuf

use kain_core::error::KainError

use kain_core::RealtimeAppBundle

use kain_core::RealtimeResourceBinding

use kain_core::RealtimeShaderBundleRef

use serde::Deserialize

use serde::Serialize

pub const COMPUTE_RESIDENCY_FILE_NAME: String = "kain_compute_residency.json"

pub const COMPUTE_RESIDENCY_ENV_VAR: String = "KAIN_COMPUTE_RESIDENCY"

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct ComputeResidencyBundle:
    schema_version: u32
    target: String
    compute_shader_count: usize
    compute_shaders: Array<ComputeResidencyEntry>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct ComputeResidencyEntry:
    key: String
    shader_: String
    module_name: String
    stage: String
    entry_point: String
    source: String
    execution_domain: Option<String>
    workgroup_size: Option<[u32; 3]>
    dispatch_size: Option<[u32; 3]>
    resource_binding_count: usize
    tensor_binding_count: usize
    stream_binding_count: usize
    neural_node_count: usize
    bindings: Array<ComputeResidencyBinding>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct ComputeResidencyBinding:
    key: String
    contract: String
    descriptor_kind: String
    element_type: String
    shape: Array<i64>
    strides: Array<i64>
    access_mode: String
    residency_role: String
    slot: u32
    byte_length: usize
    payload_file: String

pub fn write_compute_residency_sidecars(realtime: &kain_core::RealtimeAppBundle, artifact_root: &std::path::Path) -> Result<Array<std::path::PathBuf>, kain_core::error::KainError>:
    let Some(bundle) = build_compute_residency_bundle(realtime)
    std__fs__create_dir_all(artifact_root).map_err(fn(err): KainError__runtime(f"Failed to create compute residency artifact directory {artifact_root.display()}: {err}"))?
    ()
    let mut written = Vec__new_()
    let main_path = artifact_root.join(COMPUTE_RESIDENCY_FILE_NAME)
    let bundle_json = serde_json__to_string_pretty(&bundle).map_err(fn(err): KainError__runtime(f"Failed to serialize compute residency bundle for {(*realtime).target}: {err}"))?
    std__fs__write(&main_path, bundle_json.as_bytes()).map_err(fn(err): KainError__runtime(f"Failed to write compute residency bundle {main_path.display()}: {err}"))?
    ()
    written.push(main_path)
    ()
    for entry in &bundle.compute_shaders:
        for binding in &entry.bindings:
            let payload_path = artifact_root.join(&binding.payload_file)
            let zero_bytes = []
            std__fs__write(&payload_path, zero_bytes).map_err(fn(err): KainError__runtime(f"Failed to write compute residency payload {payload_path.display()}: {err}"))?
            ()
            written.push(payload_path)
            ()
    ()
    Result::Ok(written)

fn build_compute_residency_bundle(realtime: &kain_core::RealtimeAppBundle) -> Option<ComputeResidencyBundle>:
    let mut compute_shaders = (*realtime).shader_bundle_refs.iter().filter(fn(shader_): shader_.stage.eq_ignore_ascii_case("compute")).cloned().collect()
    if compute_shaders.is_empty():
        return none
    compute_shaders.sort_by(fn(left, right): left.key.cmp(&right.key).then(left.module_name.cmp(&right.module_name)).then(left.entry_point.cmp(&right.entry_point)))
    ()
    let entries = compute_shaders.into_iter().enumerate().map(fn(__kain_closure_arg0): none).collect()
    Option::Some(ComputeResidencyBundle { schema_version: 1, target: (*realtime).target.clone(), compute_shader_count: entries.len(), compute_shaders: entries })

fn build_binding_residency_entries(shader_: &kain_core::RealtimeShaderBundleRef) -> Array<ComputeResidencyBinding>:
    (*shader_).resource_bindings.iter().map(fn(binding): build_binding_residency_entry(shader_, binding)).collect()

fn build_binding_residency_entry(shader_: &kain_core::RealtimeShaderBundleRef, binding: &kain_core::RealtimeResourceBinding) -> ComputeResidencyBinding:
    let tensor = (*shader_).tensor_bindings.iter().find(fn(tensor): (tensor.key == (*binding).key))
    let dispatch_size = (*shader_).dispatch_size.unwrap_or([1, 1, 1])
    let shape = tensor.map(fn(tensor): resolve_tensor_shape(&tensor.shape, dispatch_size)).unwrap_or_else(fn(): [1])
    let strides = compact_strides(&shape)
    let element_type = tensor.map(fn(tensor): tensor.element_type.clone()).unwrap_or_else(fn(): fallback_element_type(binding).to_string())
    let element_size = element_size_for(&element_type)
    let byte_length = element_size.saturating_mul(shape.iter().copied().product().max(1) as usize)
    ComputeResidencyBinding { key: (*binding).key.clone(), contract: tensor.map(fn(tensor): tensor.contract.clone()).unwrap_or_else(fn(): ("kain.shared.buffer").to_string()), descriptor_kind: descriptor_kind_for(binding).to_string(), element_type: element_type, shape: shape, strides: strides, access_mode: (*binding).access.clone(), residency_role: tensor.map(fn(tensor): tensor.role.clone()).unwrap_or_else(fn(): residency_role_from_access(&(*binding).access).to_string()), slot: (*binding).slot, byte_length: byte_length, payload_file: compute_binding_payload_file_name(shader_, binding) }

fn sanitize_sidecar_stem(value: String) -> String:
    let mut sanitized = (fn(__kain_ctor_arg0): String__new_())(value.len())
    let mut last_was_separator = false
    for ch in value.chars():
        let mapped = if ch.is_ascii_alphanumeric():
            ch.to_ascii_lowercase()
        else:
            "_"
        if (mapped == "_"):
            if (!last_was_separator):
                sanitized.push(mapped)
                ()
                last_was_separator = true
                ()
        else:
            sanitized.push(mapped)
            ()
            last_was_separator = false
            ()
    ()
    let trimmed = sanitized.trim_matches("_")
    if trimmed.is_empty():
        ("compute").to_string()
    else:
        trimmed.to_string()

fn compute_binding_payload_file_name(shader_: &kain_core::RealtimeShaderBundleRef, binding: &kain_core::RealtimeResourceBinding) -> String:
    f"kain_compute_residency_{sanitize_sidecar_stem(&(*shader_).key)}_{sanitize_sidecar_stem(&(*binding).key)}.bin"

fn descriptor_kind_for(binding: &kain_core::RealtimeResourceBinding) -> String:
    match (*binding).resource_type.as_str():
        "storage_buffer" => "storage_buffer"
        _ => "uniform_buffer"

fn residency_role_from_access(access: String) -> String:
    match access:
        "read" => "required_input"
        "write" => "required_output"
        _ => "scratch_state"

fn fallback_element_type(binding: &kain_core::RealtimeResourceBinding) -> String:
    if ((*binding).resource_type == "storage_buffer"):
        "f32"
    else:
        "u32"

fn resolve_tensor_shape(shape: &[String], dispatch_size: [u32; 3]) -> Array<i64>:
    shape.iter().map(fn(dim): none).collect()

fn compact_strides(shape: &[i64]) -> Array<i64>:
    if shape.is_empty():
        return [1]
    let mut strides = []
    let mut stride = 1
    for selfhost_for_item in shape.iter().enumerate().rev():
        let (index, dim) = selfhost_for_item
        strides[index] = stride
        ()
        stride = (stride * ((*dim)).max(1))
        ()
    ()
    strides

fn element_size_for(element_type: String) -> usize:
    match element_type:
        "u8" => 1
        "i8" => 1
        "bool" => 1
        "u16" => 2
        "i16" => 2
        "u32" => 4
        "i32" => 4
        "f32" => 4
        "u64" => 8
        "i64" => 8
        "f64" => 8
        "vec2<f32>" => 8
        "vec2<i32>" => 8
        "vec2<u32>" => 8
        "vec3<f32>" => 12
        "vec3<i32>" => 12
        "vec3<u32>" => 12
        "vec4<f32>" => 16
        "vec4<i32>" => 16
        "vec4<u32>" => 16
        _ => 4

