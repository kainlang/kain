@derive(Debug, Clone)
pub struct NativeAppBundleConfig:
    app_name: Option<String>
    window_title: Option<String>
    root_component: Option<String>
    source_file_name: Option<String>
    source_root: Option<std::path::PathBuf>
    initial_window_size: [f32; 2]
    include_spirv: Bool

impl Default for NativeAppBundleConfig:
    fn default_() -> NativeAppBundleConfig:
        NativeAppBundleConfig { app_name: none, window_title: none, root_component: none, source_file_name: Option::Some(("app.kn").to_string()), source_root: none, initial_window_size: [1440, 920], include_spirv: true }


@doc(doc = " Runtime version metadata loaded from native_runtime.toml")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RuntimeVersionMetadata:
    runtime_major: u32
    runtime_minor: u32
    runtime_patch: u32
    abi_major: u32
    abi_minor: u32
    abi_patch: u32
    runtime_version_string: String
    abi_version_string: String
    compatibility_class: String
    runtime_lane: String
    target_platforms: Array<String>
    active_platforms: Array<String>

impl RuntimeVersionMetadata:
    pub fn load_from_runtime_manifest() -> Result<RuntimeVersionMetadata, kain_core::error::KainError>:
        let manifest_path = find_native_runtime_manifest().ok_or_else(fn(): KainError__runtime("Could not locate runtime/native_runtime.toml"))?
        let manifest_source = std__fs__read_to_string(&manifest_path).map_err(fn(err): KainError__runtime(f"Failed to read runtime manifest {manifest_path.display()}: {err}"))?
        @derive(serde__Deserialize)
        struct VersionSection:
            runtime_major: u32
            runtime_minor: u32
            runtime_patch: u32
            abi_major: u32
            abi_minor: u32
            abi_patch: u32

        @derive(serde__Deserialize)
        struct MetadataSection:
            compatibility_class: String
            runtime_lane: String
            target_platforms: Array<String>
            active_platforms: Array<String>

        @derive(serde__Deserialize)
        struct RuntimeManifest:
            version: VersionSection
            metadata: MetadataSection

        let manifest: RuntimeManifest = toml__from_str(&manifest_source).map_err(fn(err): KainError__runtime(f"Failed to parse runtime manifest {manifest_path.display()}: {err}"))?
        let runtime_version_string = f"{manifest.version.runtime_major}.{manifest.version.runtime_minor}.{manifest.version.runtime_patch}"
        let abi_version_string = f"{manifest.version.abi_major}.{manifest.version.abi_minor}.{manifest.version.abi_patch}"
        Result::Ok(RuntimeVersionMetadata { runtime_major: manifest.version.runtime_major, runtime_minor: manifest.version.runtime_minor, runtime_patch: manifest.version.runtime_patch, abi_major: manifest.version.abi_major, abi_minor: manifest.version.abi_minor, abi_patch: manifest.version.abi_patch, runtime_version_string: runtime_version_string, abi_version_string: abi_version_string, compatibility_class: manifest.metadata.compatibility_class, runtime_lane: manifest.metadata.runtime_lane, target_platforms: manifest.metadata.target_platforms, active_platforms: manifest.metadata.active_platforms })


fn find_native_runtime_manifest() -> Option<std::path::PathBuf>:
    for env_var in ["KAIN_RUNTIME_MANIFEST_PATH", "KAIN_RUNTIME_MANIFEST"]:
        match std__env__var_(env_var):
            Ok(explicit_) =>
                let candidate = PathBuf__from(explicit_)
                if candidate.exists():
                    return Option::Some(candidate)
            _ => ()
    ()
    match std__env__current_dir():
        Ok(mut dir) =>
            for _ in range(0, 10):
                let candidate = dir.join("runtime").join("native_runtime.toml")
                if candidate.exists():
                    return Option::Some(candidate)
                match dir.parent():
                    Some(parent) => dir = parent.to_path_buf()
                    None => break
            ()
            ()
        _ =>
            ()
            ()
    match std__env__current_exe():
        Ok(exe_path) =>
            match exe_path.parent().map(fn(p): p.to_path_buf()):
                Some(mut dir) =>
                    loop:
                        let candidate = dir.join("runtime").join("native_runtime.toml")
                        if candidate.exists():
                            return Option::Some(candidate)
                        if (!dir.pop()):
                            break
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    none

