use super::config::Ue5ModuleConfig

@doc(doc = " Generate a .uplugin file with correct module type(s) and loading phase(s)")
@doc(doc = "")
@doc(doc = " # Parameters")
@doc(doc = " - `plugin_name`: Name of the plugin")
@doc(doc = " - `description`: Optional description text")
@doc(doc = " - `has_editor_items`: Whether the plugin contains editor-only items")
@doc(doc = " - `needs_split`: Whether to generate two modules (Runtime + Editor)")
@doc(doc = " - `has_shaders`: Whether the plugin contains shaders (requires CanContainContent: true)")
pub fn generate_uplugin_file(plugin_name: String, description: &Option<String>, has_editor_items: Bool, needs_split: Bool, has_shaders: Bool, plugin_dependencies: &[String]) -> String:
    let desc = (none).map(fn(s): s.as_str()).unwrap_or("Generated by KAIN-PRO")
    let modules_json = if needs_split:
        "    {\n      \"Name\": \"{plugin_name}\",\n      \"Type\": \"Runtime\",\n      \"LoadingPhase\": \"PostConfigInit\"\n    },\n    {\n      \"Name\": \"{plugin_name}Editor\",\n      \"Type\": \"Editor\",\n      \"LoadingPhase\": \"PostEngineInit\"\n    }"
    else:
        let (module_type, loading_phase) = if has_editor_items:
            ("Editor", "PostEngineInit")
        else:
            ("Runtime", "PostConfigInit")
        "    {\n      \"Name\": \"{plugin_name}\",\n      \"Type\": \"{module_type}\",\n      \"LoadingPhase\": \"{loading_phase}\"\n    }"
    let can_contain_content = if has_shaders:
        "true"
    else:
        "false"
    let plugins_json = format_plugin_dependencies_json(plugin_dependencies)
    "{\n  \"FileVersion\": 3,\n  \"Version\": 1,\n  \"VersionName\": \"1.0.0\",\n  \"FriendlyName\": \"{plugin_name}\",\n  \"Description\": \"{desc}\",\n  \"Category\": \"KAIN-PRO\",\n  \"CreatedBy\": \"KAIN-PRO Compiler\",\n  \"CreatedByURL\": \"\",\n  \"DocsURL\": \"\",\n  \"MarketplaceURL\": \"\",\n  \"SupportURL\": \"\",\n  \"CanContainContent\": {can_contain_content},\n  \"IsBetaVersion\": false,\n  \"IsExperimentalVersion\": false,\n  \"Installed\": false,\n  \"Modules\": [\n{modules_json}\n  ],\n  \"Plugins\": [\n{plugins_json}\n  ]\n}\n"

@doc(doc = " Generate a .uplugin file from an explicit, data-driven module list.")
pub fn generate_uplugin_file_from_modules(plugin_name: String, description: &Option<String>, has_shaders: Bool, modules: &[Ue5ModuleConfig], plugin_dependencies: &[String]) -> String:
    let desc = (none).map(fn(s): s.as_str()).unwrap_or("Generated by KAIN-PRO")
    let modules_json = modules.iter().map(fn(m): "    {\n      \"Name\": \"{m.name}\",\n      \"Type\": \"{m.module_type.as_uplugin_type()}\",\n      \"LoadingPhase\": \"{m.loading_phase}\"\n    }").collect().join(",\n")
    let can_contain_content = if has_shaders:
        "true"
    else:
        "false"
    let plugins_json = format_plugin_dependencies_json(plugin_dependencies)
    "{\n  \"FileVersion\": 3,\n  \"Version\": 1,\n  \"VersionName\": \"1.0.0\",\n  \"FriendlyName\": \"{plugin_name}\",\n  \"Description\": \"{desc}\",\n  \"Category\": \"KAIN-PRO\",\n  \"CreatedBy\": \"KAIN-PRO Compiler\",\n  \"CreatedByURL\": \"\",\n  \"DocsURL\": \"\",\n  \"MarketplaceURL\": \"\",\n  \"SupportURL\": \"\",\n  \"CanContainContent\": {can_contain_content},\n  \"IsBetaVersion\": false,\n  \"IsExperimentalVersion\": false,\n  \"Installed\": false,\n  \"Modules\": [\n{modules_json}\n  ],\n  \"Plugins\": [\n{plugins_json}\n  ]\n}\n"

fn format_plugin_dependencies_json(plugin_dependencies: &[String]) -> String:
    plugin_dependencies.iter().map(fn(name): "    {\n      \"Name\": \"{name}\",\n      \"Enabled\": true\n    }").collect().join(",\n")

