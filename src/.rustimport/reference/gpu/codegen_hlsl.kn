use kain_core::ast::BinaryOp

use kain_core::ast::Block

use kain_core::ast::Expr

use kain_core::ast::Pattern

use kain_core::ast::ShaderStage

use kain_core::ast::Stmt

use kain_core::ast::Type

use kain_core::error::KainError

use kain_core::error::KainResult

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

use kain_core::types::TypedShader

use std::collections::HashMap

pub fn generate(program: &kain_core::types::TypedProgram) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str("// Generated by KAIN Compiler\n")
    ()
    output.push_str("// Derived HLSL output from the KAIN shader artifact pipeline\n\n")
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Shader(shader_) =>
                output.push_str(&emit_shader(shader_)?)
                ()
            _ => ()
    ()
    Result::Ok(output)

struct HLSLContext:
    vars: Map<String, String>
    indent_level: usize
    uniform_bindings: Array<(String, String, u32)>

impl HLSLContext:
    fn new_() -> HLSLContext:
        HLSLContext { vars: HashMap__new_(), indent_level: 0, uniform_bindings: Vec__new_() }

    fn indent(_self: &HLSLContext) -> String:
        ("    ").repeat((*_self).indent_level)

    fn push_indent(_self: &mut HLSLContext):
        (*_self).indent_level = ((*_self).indent_level + 1)
        ()

    fn pop_indent(_self: &mut HLSLContext):
        if ((*_self).indent_level > 0):
            (*_self).indent_level = ((*_self).indent_level - 1)
            ()


fn emit_shader(shader_: &kain_core::types::TypedShader) -> Result<String, KainError>:
    let mut output = String__new_()
    let mut ctx = HLSLContext__new_()
    for uniform_ in &(*shader_).ast.uniforms:
        let hlsl_type = map_type_to_hlsl(&uniform_.ty)
        ctx.uniform_bindings.push((uniform_.name.clone(), hlsl_type, uniform_.binding))
        ()
    ()
    let mut cbuffer_uniforms = Vec__new_()
    let mut texture_uniforms = Vec__new_()
    let mut buffer_uniforms = Vec__new_()
    for selfhost_for_item in &ctx.uniform_bindings:
        let (name, ty, binding) = selfhost_for_item
        if (ty.contains("Texture") || ty.contains("Sampler")):
            texture_uniforms.push((name.clone(), ty.clone(), (*binding)))
            ()
        elif ((ty.contains("Buffer") || ty.contains("RWBuffer")) || ty.contains("StructuredBuffer")):
            buffer_uniforms.push((name.clone(), ty.clone(), (*binding)))
            ()
        else:
            cbuffer_uniforms.push((name.clone(), ty.clone(), (*binding)))
            ()
    ()
    if (!cbuffer_uniforms.is_empty()):
        output.push_str("cbuffer ShaderParams : register(b0)\n{\n")
        ()
        for selfhost_for_item in &cbuffer_uniforms:
            let (name, ty, _) = selfhost_for_item
            output.push_str(&f"    {ty} {name};\n")
            ()
        ()
        output.push_str("};\n\n")
        ()
        ()
        ()
        ()
    for selfhost_for_item in &texture_uniforms:
        let (name, ty, binding) = selfhost_for_item
        output.push_str(&f"{ty} {name} : register(t{binding});\n")
        ()
        output.push_str(&f"SamplerState {name}_sampler : register(s{binding});\n")
        ()
    ()
    if (!texture_uniforms.is_empty()):
        output.push_str("\n")
        ()
        ()
        ()
        ()
    for selfhost_for_item in &buffer_uniforms:
        let (name, ty, binding) = selfhost_for_item
        output.push_str(&f"{ty} {name} : register(u{binding});\n")
        ()
    ()
    if (!buffer_uniforms.is_empty()):
        output.push_str("\n")
        ()
        ()
        ()
        ()
    match (*shader_).ast.stage:
        kain_core__ast__ShaderStage::Compute =>
            output.push_str("[numthreads(8, 8, 1)]\n")
            ()
            output.push_str("void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID,\n")
            ()
            output.push_str("            uint3 groupThreadID : SV_GroupThreadID,\n")
            ()
            output.push_str("            uint3 groupID : SV_GroupID,\n")
            ()
            output.push_str("            uint groupIndex : SV_GroupIndex)\n{\n")
            ()
            ctx.push_indent()
            ()
            ctx.vars.insert(("dispatch_thread_id").to_string(), ("dispatchThreadID").to_string())
            ()
            ctx.vars.insert(("group_thread_id").to_string(), ("groupThreadID").to_string())
            ()
            ctx.vars.insert(("group_id").to_string(), ("groupID").to_string())
            ()
            ctx.vars.insert(("group_index").to_string(), ("groupIndex").to_string())
            ()
            let body_code = emit_block(&mut ctx, &(*shader_).ast.body)?
            output.push_str(&body_code)
            ()
            ctx.pop_indent()
            ()
            output.push_str("}\n")
            ()
            ()
            ()
            ()
        kain_core__ast__ShaderStage::Vertex =>
            output.push_str("struct VSInput\n{\n")
            ()
            for selfhost_for_item in (*shader_).ast.inputs.iter().enumerate():
                let (i, param) = selfhost_for_item
                let hlsl_type = map_type_to_hlsl(&param.ty)
                let semantic = match param.name.as_str():
                    "position" => "POSITION"
                    "normal" => "NORMAL"
                    "tangent" => "TANGENT"
                    "color" => "COLOR"
                    _ => "TEXCOORD"
                output.push_str(&"    {hlsl_type} {param.name} : {semantic}{if (semantic == \"TEXCOORD\"): i.to_string() else: (\"\").to_string()};\n")
                ()
            ()
            output.push_str("};\n\n")
            ()
            output.push_str("struct VSOutput\n{\n")
            ()
            output.push_str("    float4 position : SV_Position;\n")
            ()
            output.push_str("};\n\n")
            ()
            output.push_str("VSOutput VSMain(VSInput input)\n{\n")
            ()
            ctx.push_indent()
            ()
            for param in &(*shader_).ast.inputs:
                ctx.vars.insert(param.name.clone(), f"input.{param.name}")
                ()
            ()
            let body_code = emit_block(&mut ctx, &(*shader_).ast.body)?
            output.push_str(&body_code)
            ()
            ctx.pop_indent()
            ()
            output.push_str("}\n")
            ()
            ()
            ()
            ()
        kain_core__ast__ShaderStage::Fragment =>
            output.push_str("struct VSInput\n{\n")
            ()
            for selfhost_for_item in (*shader_).ast.inputs.iter().enumerate():
                let (i, param) = selfhost_for_item
                let hlsl_type = map_type_to_hlsl(&param.ty)
                output.push_str(&f"    {hlsl_type} {param.name} : TEXCOORD{i};\n")
                ()
            ()
            output.push_str("};\n\n")
            ()
            output.push_str("struct PSOutput\n{\n")
            ()
            let out_type = map_type_to_hlsl(&(*shader_).ast.outputs)
            output.push_str(&f"    {out_type} color : SV_Target0;\n")
            ()
            output.push_str("};\n\n")
            ()
            output.push_str("PSOutput PSMain(VSInput input)\n{\n")
            ()
            ctx.push_indent()
            ()
            for param in &(*shader_).ast.inputs:
                ctx.vars.insert(param.name.clone(), f"input.{param.name}")
                ()
            ()
            let body_code = emit_block(&mut ctx, &(*shader_).ast.body)?
            output.push_str(&body_code)
            ()
            ctx.pop_indent()
            ()
            output.push_str("}\n")
            ()
            ()
            ()
            ()
        kain_core__ast__ShaderStage::Surface =>
            output.push_str("struct VSInput\n{\n")
            ()
            for selfhost_for_item in (*shader_).ast.inputs.iter().enumerate():
                let (i, param) = selfhost_for_item
                let hlsl_type = map_type_to_hlsl(&param.ty)
                output.push_str(&f"    {hlsl_type} {param.name} : TEXCOORD{i};\n")
                ()
            ()
            output.push_str("};\n\n")
            ()
            output.push_str("struct PSOutput\n{\n")
            ()
            let out_type = map_type_to_hlsl(&(*shader_).ast.outputs)
            output.push_str(&f"    {out_type} color : SV_Target0;\n")
            ()
            output.push_str("};\n\n")
            ()
            output.push_str("PSOutput PSMain(VSInput input)\n{\n")
            ()
            ctx.push_indent()
            ()
            for param in &(*shader_).ast.inputs:
                ctx.vars.insert(param.name.clone(), f"input.{param.name}")
                ()
            ()
            let body_code = emit_block(&mut ctx, &(*shader_).ast.body)?
            output.push_str(&body_code)
            ()
            ctx.pop_indent()
            ()
            output.push_str("}\n")
            ()
            ()
            ()
            ()
    Result::Ok(output)

fn emit_block(ctx: &mut HLSLContext, block: &kain_core::ast::Block) -> Result<String, KainError>:
    let mut output = String__new_()
    for stmt in &(*block).stmts:
        output.push_str(&emit_stmt(ctx, stmt)?)
        ()
    ()
    Result::Ok(output)

fn emit_stmt(ctx: &mut HLSLContext, stmt: &kain_core::ast::Stmt) -> Result<String, KainError>:
    let mut output = String__new_()
    match stmt:
        kain_core__ast__Stmt::Let { pattern: pattern, value: value } =>
            match value:
                Some(value) =>
                    match pattern:
                        kain_core__ast__Pattern::Binding { name: name } =>
                            let (expr_code, expr_type) = emit_expr(ctx, value)?
                            output.push_str(&f"{ctx.indent()}{expr_type} {name} = {expr_code};\n")
                            ()
                            (*ctx).vars.insert(name.clone(), name.clone())
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            ()
        kain_core__ast__Stmt::Return(Some(expr), _) =>
            let (expr_code, _) = emit_expr(ctx, expr)?
            output.push_str(&f"{ctx.indent()}PSOutput _result;\n")
            ()
            output.push_str(&f"{ctx.indent()}_result.color = {expr_code};\n")
            ()
            output.push_str(&f"{ctx.indent()}return _result;\n")
            ()
            ()
            ()
            ()
        kain_core__ast__Stmt::Return(None, _) =>
            output.push_str(&f"{ctx.indent()}return;\n")
            ()
            ()
            ()
            ()
        kain_core__ast__Stmt::Expr(expr) =>
            let (expr_code, _) = emit_expr(ctx, expr)?
            output.push_str(&f"{ctx.indent()}{expr_code};\n")
            ()
            ()
            ()
            ()
        kain_core__ast__Stmt::While { condition: condition, body: body } =>
            let (cond_code, _) = emit_expr(ctx, condition)?
            output.push_str(&f"{ctx.indent()}while ({cond_code})\n")
            ()
            output.push_str(&"{ctx.indent()}{\n")
            ()
            ctx.push_indent()
            ()
            output.push_str(&emit_block(ctx, body)?)
            ()
            ctx.pop_indent()
            ()
            output.push_str(&"{ctx.indent()}}\n")
            ()
            ()
            ()
            ()
        kain_core__ast__Stmt::For { binding: binding, iter: _, body: body } =>
            match binding:
                kain_core__ast__Pattern::Binding { name: name } =>
                    output.push_str(&f"{ctx.indent()}for (int {name} = 0; {name} < 10; {name}++)\n")
                    ()
                    output.push_str(&"{ctx.indent()}{\n")
                    ()
                    ctx.push_indent()
                    ()
                    (*ctx).vars.insert(name.clone(), name.clone())
                    ()
                    output.push_str(&emit_block(ctx, body)?)
                    ()
                    ctx.pop_indent()
                    ()
                    output.push_str(&"{ctx.indent()}}\n")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        kain_core__ast__Stmt::Break(_, _) =>
            output.push_str(&f"{ctx.indent()}break;\n")
            ()
            ()
            ()
            ()
        kain_core__ast__Stmt::Continue(_) =>
            output.push_str(&f"{ctx.indent()}continue;\n")
            ()
            ()
            ()
            ()
        _ => ()
    Result::Ok(output)

fn emit_expr(ctx: &mut HLSLContext, expr: &kain_core::ast::Expr) -> Result<(String, String), KainError>:
    match expr:
        kain_core__ast__Expr::Ident(name, _) =>
            match (*ctx).vars.get(name):
                Some(mapped) => Result::Ok((mapped.clone(), ("float4").to_string()))
                _ => Result::Ok((name.clone(), ("float4").to_string()))
        kain_core__ast__Expr::Float(f, _) => Result::Ok((f, ("float").to_string()))
        kain_core__ast__Expr::Int(i, _) => Result::Ok((i, ("int").to_string()))
        kain_core__ast__Expr::Bool(b, _) => Result::Ok((b, ("bool").to_string()))
        kain_core__ast__Expr::String(s, _) => Result::Ok((f"\"{s}\"", ("string").to_string()))
        kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
            let (left_code, left_ty) = emit_expr(ctx, left)?
            let (right_code, _) = emit_expr(ctx, right)?
            let op_str = match op:
                kain_core__ast__BinaryOp::Add => "+"
                kain_core__ast__BinaryOp::Sub => "-"
                kain_core__ast__BinaryOp::Mul => "*"
                kain_core__ast__BinaryOp::Div => "/"
                kain_core__ast__BinaryOp::Mod => "%"
                kain_core__ast__BinaryOp::Eq => "=="
                kain_core__ast__BinaryOp::Ne => "!="
                kain_core__ast__BinaryOp::Lt => "<"
                kain_core__ast__BinaryOp::Le => "<="
                kain_core__ast__BinaryOp::Gt => ">"
                kain_core__ast__BinaryOp::Ge => ">="
                kain_core__ast__BinaryOp::And => "&&"
                kain_core__ast__BinaryOp::Or => "||"
                kain_core__ast__BinaryOp::BitAnd => "&"
                kain_core__ast__BinaryOp::BitOr => "|"
                kain_core__ast__BinaryOp::BitXor => "^"
                kain_core__ast__BinaryOp::Shl => "<<"
                kain_core__ast__BinaryOp::Shr => ">>"
                _ => return Result::Err(KainError__codegen("Unsupported binary op", expr.span()))
            let result_ty = match op:
                kain_core__ast__BinaryOp::Eq => ("bool").to_string()
                kain_core__ast__BinaryOp::Ne => ("bool").to_string()
                kain_core__ast__BinaryOp::Lt => ("bool").to_string()
                kain_core__ast__BinaryOp::Le => ("bool").to_string()
                kain_core__ast__BinaryOp::Gt => ("bool").to_string()
                kain_core__ast__BinaryOp::Ge => ("bool").to_string()
                kain_core__ast__BinaryOp::And => ("bool").to_string()
                kain_core__ast__BinaryOp::Or => ("bool").to_string()
                _ => left_ty
            Result::Ok((f"({left_code} {op_str} {right_code})", result_ty))
        kain_core__ast__Expr::Unary { op: op, operand: operand } =>
            let (operand_code, ty) = emit_expr(ctx, operand)?
            let op_str = match op:
                kain_core__ast__UnaryOp::Neg => "-"
                kain_core__ast__UnaryOp::Not => "!"
                kain_core__ast__UnaryOp::BitNot => "~"
                kain_core__ast__UnaryOp::Ref => return Result::Ok((operand_code, ty))
                kain_core__ast__UnaryOp::RefMut => return Result::Ok((operand_code, ty))
                kain_core__ast__UnaryOp::Deref => return Result::Ok((operand_code, ty))
            Result::Ok((f"({op_str}{operand_code})", ty))
        kain_core__ast__Expr::Call { callee: callee, args: args } =>
            match &(*(*callee)):
                kain_core__ast__Expr::Ident(name, _) => emit_function_call(ctx, name, args)
                _ => Result::Err(KainError__codegen("Complex callee not supported", expr.span()))
        kain_core__ast__Expr::Assign { target: target, value: value } =>
            let (target_code, target_ty) = emit_expr(ctx, target)?
            let (value_code, _) = emit_expr(ctx, value)?
            Result::Ok((f"{target_code} = {value_code}", target_ty))
        kain_core__ast__Expr::Field { object: object, field: field } =>
            let (obj_code, _) = emit_expr(ctx, object)?
            Result::Ok((f"{obj_code}.{field}", infer_swizzle_type(field)))
        kain_core__ast__Expr::Index { object: object, index: index } =>
            let (obj_code, obj_ty) = emit_expr(ctx, object)?
            let (idx_code, _) = emit_expr(ctx, index)?
            let elem_ty = if obj_ty.starts_with("float"):
                ("float").to_string()
            else:
                obj_ty
            Result::Ok((f"{obj_code}[{idx_code}]", elem_ty))
        kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
            let (cond_code, _) = emit_expr(ctx, condition)?
            if ((then_branch.stmts.len() == 1) && else_branch.is_some()):
                match &then_branch.stmts[0]:
                    kain_core__ast__Stmt::Expr(then_expr) =>
                        let (then_code, then_ty) = emit_expr(ctx, then_expr)?
                        match else_branch.map(fn(b): b):
                            Some(kain_core__ast__ElseBranch::Else(else_block)) =>
                                if (else_block.stmts.len() == 1):
                                    match &else_block.stmts[0]:
                                        kain_core__ast__Stmt::Expr(else_expr) =>
                                            let (else_code, _) = emit_expr(ctx, else_expr)?
                                            return Result::Ok((f"({cond_code} ? {then_code} : {else_code})", then_ty))
                                        _ =>
                                            ()
                                            ()
                                    ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            Result::Err(KainError__codegen("Complex if expressions not yet supported in HLSL backend", expr.span()))
        kain_core__ast__Expr::Paren(inner, _) =>
            let (inner_code, ty) = emit_expr(ctx, inner)?
            Result::Ok((f"({inner_code})", ty))
        _ => Result::Err(KainError__codegen("Unsupported expression", expr.span()))

fn emit_function_call(ctx: &mut HLSLContext, name: String, args: &[kain_core::ast::CallArg]) -> Result<(String, String), KainError>:
    match name:
        "float" if (args.len() == 1) =>
            let (code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"float({code})", ("float").to_string()))
        "Float" if (args.len() == 1) =>
            let (code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"float({code})", ("float").to_string()))
        "int" if (args.len() == 1) =>
            let (code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"int({code})", ("int").to_string()))
        "Int" if (args.len() == 1) =>
            let (code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"int({code})", ("int").to_string()))
        "uint" if (args.len() == 1) =>
            let (code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"uint({code})", ("uint").to_string()))
        "UInt" if (args.len() == 1) =>
            let (code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"uint({code})", ("uint").to_string()))
        "bool" if (args.len() == 1) =>
            let (code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"bool({code})", ("bool").to_string()))
        "Bool" if (args.len() == 1) =>
            let (code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"bool({code})", ("bool").to_string()))
        "vec2" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("float2({arg_codes.join(\", \")})", ("float2").to_string()))
        "Vec2" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("float2({arg_codes.join(\", \")})", ("float2").to_string()))
        "vec3" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("float3({arg_codes.join(\", \")})", ("float3").to_string()))
        "Vec3" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("float3({arg_codes.join(\", \")})", ("float3").to_string()))
        "vec4" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("float4({arg_codes.join(\", \")})", ("float4").to_string()))
        "Vec4" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("float4({arg_codes.join(\", \")})", ("float4").to_string()))
        "sin" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "cos" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "tan" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "asin" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "acos" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "atan" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "atan2" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            Result::Ok((f"atan2({arg1}, {arg2})", ty))
        "abs" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            let hlsl_name = if (name == "fract"):
                "frac"
            else:
                name
            Result::Ok((f"{hlsl_name}({arg_code})", ty))
        "floor" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            let hlsl_name = if (name == "fract"):
                "frac"
            else:
                name
            Result::Ok((f"{hlsl_name}({arg_code})", ty))
        "ceil" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            let hlsl_name = if (name == "fract"):
                "frac"
            else:
                name
            Result::Ok((f"{hlsl_name}({arg_code})", ty))
        "round" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            let hlsl_name = if (name == "fract"):
                "frac"
            else:
                name
            Result::Ok((f"{hlsl_name}({arg_code})", ty))
        "trunc" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            let hlsl_name = if (name == "fract"):
                "frac"
            else:
                name
            Result::Ok((f"{hlsl_name}({arg_code})", ty))
        "fract" =>
