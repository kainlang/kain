use crate::error::GraphError

use crate::error::Result

use crate::runtime_ir::*

use kain_core::ast

@doc(doc = " Convert a KAIN AST GraphRuntimeDef to RuntimeGraph IR")
@doc(doc = "")
@doc(doc = " This is the main entry point for converting @graph_runtime definitions")
@doc(doc = " from the KAIN AST into the intermediate representation used for code generation.")
pub fn convert_graph_runtime_to_ir(ast: &kain_core::ast::GraphRuntimeDef) -> Result<RuntimeGraph, Error>:
    let mut graph = RuntimeGraph__new_(&kain_core__ast.name)
    for node_data_ast in &kain_core__ast.node_types:
        let node_data = convert_node_data_def(node_data_ast)?
        graph.add_node_type(node_data)
        ()
    ()
    match &kain_core__ast.instance:
        Some(instance_ast) =>
            graph.instance_def = convert_instance_def(instance_ast, &kain_core__ast.name)?
            ()
            ()
            ()
            ()
        _ =>
            graph.instance_def = RuntimeInstance__new_(f"{kain_core__ast.name}Instance")
            ()
            ()
            ()
            ()
    graph.properties = extract_graph_properties(&kain_core__ast.attributes)
    ()
    Result::Ok(graph)

@doc(doc = " Convert a NodeDataDef to RuntimeNodeData")
fn convert_node_data_def(ast: &kain_core::ast::NodeDataDef) -> Result<RuntimeNodeData, Error>:
    let category = extract_category(&kain_core__ast.attributes).unwrap_or_else(fn(): ("Default").to_string())
    let mut node = RuntimeNodeData__new_(&kain_core__ast.name, category)
    for input_ast in &kain_core__ast.input_pins:
        let pin = convert_pin_def(input_ast, PinDirection__Input)?
        node.add_input_pin(pin)
        ()
    ()
    for output_ast in &kain_core__ast.output_pins:
        let pin = convert_pin_def(output_ast, PinDirection__Output)?
        node.add_output_pin(pin)
        ()
    ()
    for field_ast in &kain_core__ast.properties:
        let property = convert_field_to_property(field_ast)?
        node.add_property(property)
        ()
    ()
    match &kain_core__ast.execute_logic:
        Some(execute_block) =>
            node.execute_logic = Option::Some(ExecuteLogic::KainExpr(block_to_string(execute_block)))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    for attr in &kain_core__ast.attributes:
        match attr.name.as_str():
            "color" =>
                match parse_color_attribute(attr):
                    Some(color) =>
                        node.color = Option::Some(color)
                        ()
                    _ => ()
            "icon" =>
                match parse_string_attribute(attr):
                    Some(icon) =>
                        node.icon = Option::Some(icon)
                        ()
                    _ => ()
            "tooltip" =>
                match parse_string_attribute(attr):
                    Some(tooltip) =>
                        node.tooltip = Option::Some(tooltip)
                        ()
                    _ => ()
            _ => ()
    ()
    Result::Ok(node)

@doc(doc = " Convert a GraphInstanceDef to RuntimeInstance")
fn convert_instance_def(ast: &kain_core::ast::GraphInstanceDef, graph_name: String) -> Result<RuntimeInstance, Error>:
    let mut instance = RuntimeInstance__new_(f"{graph_name}Instance")
    for field_ast in &kain_core__ast.state_:
        let property = convert_field_to_property(field_ast)?
        instance.add_state_field(property)
        ()
    ()
    for func_ast in &kain_core__ast.methods:
        let method = convert_function_to_method(func_ast)?
        instance.add_method(method)
        ()
    ()
    for attr in &kain_core__ast.attributes:
        match attr.name.as_str():
            "replicated" => instance.is_replicated = true
            "savegame" => instance.is_savegame = true
            _ => ()
    ()
    Result::Ok(instance)

@doc(doc = " Convert a PinDef to RuntimePin")
fn convert_pin_def(ast: &kain_core::ast::PinDef, direction: PinDirection) -> Result<RuntimePin, Error>:
    let pin_type = convert_type_to_pin_type(&kain_core__ast.ty)?
    let mut pin = match direction:
        PinDirection::Input => RuntimePin__input(&kain_core__ast.name, pin_type)
        PinDirection::Output => RuntimePin__output(&kain_core__ast.name, pin_type)
    pin.is_array = kain_core__ast.is_array
    ()
    match &kain_core__ast.default_:
        Some(default_expr) =>
            pin.default_value = Option::Some(expr_to_string(default_expr))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    for attr in &kain_core__ast.attributes:
        if (attr.name == "tooltip"):
            match parse_string_attribute(attr):
                Some(tooltip) =>
                    pin.tooltip = Option::Some(tooltip)
                    ()
                _ => ()
    ()
    Result::Ok(pin)

@doc(doc = " Convert a Field to RuntimeProperty")
fn convert_field_to_property(ast: &kain_core::ast::Field) -> Result<RuntimeProperty, Error>:
    let property_type = convert_type_to_pin_type(&kain_core__ast.ty)?
    let mut specifiers = Vec__new_()
    for attr in &kain_core__ast.attributes:
        match attr.name.as_str():
            "edit_anywhere" => specifiers.push(PropertySpecifier__EditAnywhere)
            "editanywhere" => specifiers.push(PropertySpecifier__EditAnywhere)
            "edit_defaults" => specifiers.push(PropertySpecifier__EditDefaultsOnly)
            "editdefaults" => specifiers.push(PropertySpecifier__EditDefaultsOnly)
            "visible" => specifiers.push(PropertySpecifier__VisibleAnywhere)
            "visibleanywhere" => specifiers.push(PropertySpecifier__VisibleAnywhere)
            "blueprint_readonly" => specifiers.push(PropertySpecifier__BlueprintReadOnly)
            "blueprint_readwrite" => specifiers.push(PropertySpecifier__BlueprintReadWrite)
            "replicated" => specifiers.push(PropertySpecifier__Replicated)
            "savegame" => specifiers.push(PropertySpecifier__SaveGame)
            "transient" => specifiers.push(PropertySpecifier__Transient)
            "category" =>
                match parse_string_attribute(attr):
                    Some(cat) =>
                        specifiers.push(PropertySpecifier::Category(cat))
                        ()
                    _ => ()
            _ => ()
    ()
    let default_value = kain_core__ast.default_.map(expr_to_string)
    let tooltip = kain_core__ast.attributes.iter().find(fn(attr): (attr.name == "tooltip")).and_then(parse_string_attribute)
    Result::Ok(RuntimeProperty { name: kain_core__ast.name.clone(), property_type: property_type, is_array: false, default_value: default_value, specifiers: specifiers, tooltip: tooltip })

@doc(doc = " Convert a Function to RuntimeMethod")
fn convert_function_to_method(ast: &kain_core::ast::Function) -> Result<RuntimeMethod, Error>:
    let params = kain_core__ast.params.iter().map(fn(param): RuntimeParam { name: param.name.clone(), param_type: convert_type_to_pin_type(&param.ty).unwrap_or(RuntimePinType__Wildcard), is_array: false }).collect()
    let return_type = kain_core__ast.return_type.and_then(fn(ty): convert_type_to_pin_type(ty).ok())
    let body = block_to_string(&kain_core__ast.body)
    let mut specifiers = Vec__new_()
    for attr in &kain_core__ast.attributes:
        match attr.name.as_str():
            "blueprint" =>
                specifiers.push(FunctionSpecifier__BlueprintCallable)
                ()
            "blueprint_callable" =>
                specifiers.push(FunctionSpecifier__BlueprintCallable)
                ()
            "blueprint_pure" =>
                specifiers.push(FunctionSpecifier__BlueprintPure)
                ()
            "blueprint_event" =>
                specifiers.push(FunctionSpecifier__BlueprintNativeEvent)
                ()
            "category" =>
                match parse_string_attribute(attr):
                    Some(cat) =>
                        specifiers.push(FunctionSpecifier::Category(cat))
                        ()
                    _ => ()
            _ => ()
    ()
    Result::Ok(RuntimeMethod { name: kain_core__ast.name.clone(), params: params, return_type: return_type, body: body, specifiers: specifiers })

@doc(doc = " Convert KAIN Type to RuntimePinType")
fn convert_type_to_pin_type(ty: &kain_core::ast::Type) -> Result<RuntimePinType, Error>:
    match ty:
        kain_core__ast__Type::Named { name: name } =>
            match name.as_str():
                "Bool" => Result::Ok(RuntimePinType__Bool)
                "Int" => Result::Ok(RuntimePinType__Int)
                "Int64" => Result::Ok(RuntimePinType__Int64)
                "Float" => Result::Ok(RuntimePinType__Float)
                "String" => Result::Ok(RuntimePinType__String)
                "Name" => Result::Ok(RuntimePinType__Name)
                "Text" => Result::Ok(RuntimePinType__Text)
                "Vec3" => Result::Ok(RuntimePinType__Vector)
                "Vector" => Result::Ok(RuntimePinType__Vector)
                "Rotator" => Result::Ok(RuntimePinType__Rotator)
                "Transform" => Result::Ok(RuntimePinType__Transform)
                "Color" => Result::Ok(RuntimePinType__Color)
                "LinearColor" => Result::Ok(RuntimePinType__Color)
                "Exec" => Result::Ok(RuntimePinType__Exec)
                "Class" => Result::Ok(RuntimePinType::Object(("UClass").to_string()))
                "NodeData" => Result::Ok(RuntimePinType::Object(("UNodeData").to_string()))
                "GraphInstance" => Result::Ok(RuntimePinType::Object(("UGraphInstance").to_string()))
                _ =>
                    if (name.starts_with("U") || name.starts_with("A")):
                        Result::Ok(RuntimePinType::Object(name.clone()))
                    elif name.starts_with("F"):
                        Result::Ok(RuntimePinType::Struct(name.clone()))
                    elif name.starts_with("E"):
                        Result::Ok(RuntimePinType::Enum(name.clone()))
                    else:
                        Result::Ok(RuntimePinType::Struct(f"F{name}"))
        kain_core__ast__Type::Array(element, _, _) => convert_type_to_pin_type(element)
        kain_core__ast__Type::Slice(element, _) => convert_type_to_pin_type(element)
        kain_core__ast__Type::Ref { inner: inner } => convert_type_to_pin_type(inner)
        kain_core__ast__Type::Option(inner, _) => convert_type_to_pin_type(inner)
        _ =>
            let type_desc = match ty:
                kain_core__ast__Type::Function {  } => "function type"
                kain_core__ast__Type::Tuple {  } => "tuple type"
                kain_core__ast__Type::Result {  } => "Result type"
                _ => "complex type"
            Result::Err(GraphError::ASTConversion(f"Unsupported type for runtime pin: {type_desc}"))

@doc(doc = " Extract category from attributes")
fn extract_category(attributes: &[kain_core::ast::Attribute]) -> Option<String>:
    attributes.iter().find(fn(attr): (attr.name == "category")).and_then(parse_string_attribute)

@doc(doc = " Legacy function for backward compatibility")
@deprecated(note = "Use convert_graph_runtime_to_ir instead")
pub fn convert_runtime_graph(ast: &kain_core::ast::GraphEditorDef) -> Result<RuntimeGraph, Error>:
    let mut graph = RuntimeGraph__new_(&kain_core__ast.name)
    let is_runtime = kain_core__ast.attributes.iter().any(fn(attr): (attr.name == "runtime_graph"))
    if (!is_runtime):
        return Result::Err(GraphError::ASTConversion(f"Graph '{kain_core__ast.name}' is not marked with @runtime_graph attribute"))
    for node_type_ast in &kain_core__ast.node_types:
        let node_data = convert_node_type_legacy(node_type_ast)?
        graph.add_node_type(node_data)
        ()
    ()
    graph.instance_def = RuntimeInstance__new_(f"{kain_core__ast.name}Instance")
    ()
    graph.properties = extract_graph_properties(&kain_core__ast.attributes)
    ()
    Result::Ok(graph)

@doc(doc = " Legacy node type converter")
fn convert_node_type_legacy(ast: &kain_core::ast::NodeTypeDef) -> Result<RuntimeNodeData, Error>:
    let category = kain_core__ast.category.clone().unwrap_or_else(fn(): ("Default").to_string())
    let mut node = RuntimeNodeData__new_(&kain_core__ast.name, category)
    for input_ast in &kain_core__ast.inputs:
        let pin = convert_pin(input_ast, PinDirection__Input)?
        node.add_input_pin(pin)
        ()
    ()
    for output_ast in &kain_core__ast.outputs:
        let pin = convert_pin(output_ast, PinDirection__Output)?
        node.add_output_pin(pin)
        ()
    ()
    for prop_ast in &kain_core__ast.properties:
        let property = convert_property(prop_ast)?
        node.add_property(property)
        ()
    ()
    for attr in &kain_core__ast.attributes:
        match attr.name.as_str():
            "color" =>
                match parse_color_attribute(attr):
                    Some(color) =>
                        node.color = Option::Some(color)
                        ()
                    _ => ()
            "icon" =>
                match parse_string_attribute(attr):
                    Some(icon) =>
                        node.icon = Option::Some(icon)
                        ()
                    _ => ()
            "tooltip" =>
                match parse_string_attribute(attr):
                    Some(tooltip) =>
                        node.tooltip = Option::Some(tooltip)
                        ()
                    _ => ()
            _ => ()
    ()
    Result::Ok(node)

@doc(doc = " Legacy pin converter")
fn convert_pin(ast: &kain_core::ast::PinDef, direction: PinDirection) -> Result<RuntimePin, Error>:
    let pin_type = convert_type_to_pin_type(&kain_core__ast.ty)?
    let mut pin = match direction:
        PinDirection::Input => RuntimePin__input(&kain_core__ast.name, pin_type)
        PinDirection::Output => RuntimePin__output(&kain_core__ast.name, pin_type)
    pin.is_array = kain_core__ast.is_array
    ()
    match &kain_core__ast.default_:
        Some(default_expr) =>
            pin.default_value = Option::Some(expr_to_string(default_expr))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    for attr in &kain_core__ast.attributes:
        if (attr.name == "tooltip"):
            match parse_string_attribute(attr):
                Some(tooltip) =>
                    pin.tooltip = Option::Some(tooltip)
                    ()
                _ => ()
    ()
    Result::Ok(pin)

@doc(doc = " Legacy property converter")
fn convert_property(ast: &kain_core::ast::PropertyDef) -> Result<RuntimeProperty, Error>:
    let property_type = convert_type_to_pin_type(&kain_core__ast.ty)?
    let mut specifiers = Vec__new_()
    for attr in &kain_core__ast.attributes:
        match attr.name.as_str():
            "edit_anywhere" => specifiers.push(PropertySpecifier__EditAnywhere)
            "edit_defaults" => specifiers.push(PropertySpecifier__EditDefaultsOnly)
            "visible" => specifiers.push(PropertySpecifier__VisibleAnywhere)
            "blueprint_readonly" => specifiers.push(PropertySpecifier__BlueprintReadOnly)
            "blueprint_readwrite" => specifiers.push(PropertySpecifier__BlueprintReadWrite)
            "replicated" => specifiers.push(PropertySpecifier__Replicated)
            "savegame" => specifiers.push(PropertySpecifier__SaveGame)
            "transient" => specifiers.push(PropertySpecifier__Transient)
            "category" =>
                match parse_string_attribute(attr):
                    Some(cat) =>
                        specifiers.push(PropertySpecifier::Category(cat))
                        ()
                    _ => ()
            _ => ()
    ()
    let default_value = kain_core__ast.default_.map(expr_to_string)
    Result::Ok(RuntimeProperty { name: kain_core__ast.name.clone(), property_type: property_type, is_array: false, default_value: default_value, specifiers: specifiers, tooltip: none })

@doc(doc = " Extract graph properties from attributes")
fn extract_graph_properties(attributes: &[kain_core::ast::Attribute]) -> RuntimeGraphProperties:
    let mut props = RuntimeGraphProperties__default_()
    for attr in attributes:
        match attr.name.as_str():
            "parallel_execution" =>
                props.allow_parallel_execution = true
                ()
                props.execution_mode = ExecutionMode__Parallel
                ()
            "event_driven" =>
                props.execution_mode = ExecutionMode__EventDriven
                ()
            "max_depth" =>
                match parse_int_attribute(attr):
                    Some(depth) =>
                        props.max_execution_depth = depth
                        ()
                    _ => ()
            "debug_logging" =>
                props.enable_debug_logging = true
                ()
            _ => ()
    ()
    props

@doc(doc = " Parse a color attribute (e.g., @color(1.0, 0.5, 0.0, 1.0))")
fn parse_color_attribute(attr: &kain_core::ast::Attribute) -> Option<[f32; 4]>:
    if ((*attr).args.len() >= 3):
        let r = extract_float_from_expr(&(*attr).args[0])?
        let g = extract_float_from_expr(&(*attr).args[1])?
        let b = extract_float_from_expr(&(*attr).args[2])?
        let a = if ((*attr).args.len() >= 4):
            extract_float_from_expr(&(*attr).args[3])?
        else:
            1
        Option::Some([r, g, b, a])
    else:
        Option::Some([0.8, 0.8, 0.8, 1])

@doc(doc = " Parse a string attribute (e.g., @tooltip(\"This is a tooltip\"))")
fn parse_string_attribute(attr: &kain_core::ast::Attribute) -> Option<String>:
    if (!(*attr).args.is_empty()):
        extract_string_from_expr(&(*attr).args[0])
    else:
        none

@doc(doc = " Parse an integer attribute (e.g., @max_depth(100))")
fn parse_int_attribute(attr: &kain_core::ast::Attribute) -> Option<i32>:
    if (!(*attr).args.is_empty()):
        extract_int_from_expr(&(*attr).args[0])
    else:
        none

@doc(doc = " Extract float value from expression")
fn extract_float_from_expr(expr: &kain_core::ast::Expr) -> Option<f32>:
    match expr:
        kain_core__ast__Expr::Float(val, _) => Option::Some((*val) as f32)
        kain_core__ast__Expr::Int(val, _) => Option::Some((*val) as f32)
        _ => none

@doc(doc = " Extract string value from expression")
fn extract_string_from_expr(expr: &kain_core::ast::Expr) -> Option<String>:
    match expr:
        kain_core__ast__Expr::String(s, _) => Option::Some(s.clone())
        _ => none

@doc(doc = " Extract integer value from expression")
fn extract_int_from_expr(expr: &kain_core::ast::Expr) -> Option<i32>:
    match expr:
        kain_core__ast__Expr::Int(val, _) => Option::Some((*val) as i32)
        _ => none

@doc(doc = " Convert an expression to a string representation")
fn expr_to_string(expr: &kain_core::ast::Expr) -> String:
    match expr:
        kain_core__ast__Expr::Int(val, _) => val.to_string()
        kain_core__ast__Expr::Float(val, _) => val.to_string()
        kain_core__ast__Expr::String(s, _) => f"\"{s}\""
        kain_core__ast__Expr::Bool(b, _) => b.to_string()
        kain_core__ast__Expr::Ident(name, _) => name.clone()
        kain_core__ast__Expr::None(_) => ("nullptr").to_string()
        _ => ("/* <complex_expression> */").to_string()

@doc(doc = " Convert a block to a string representation")
fn block_to_string(block: &kain_core::ast::Block) -> String:
    let mut result = String__new_()
    for stmt in &(*block).stmts:
        result.push_str("    // <statement>\n")
        ()
    ()
    result

