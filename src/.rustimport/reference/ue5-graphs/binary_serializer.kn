use std::collections::HashMap

use std::io::Cursor

use unreal_asset::exports::BaseExport

use unreal_asset::exports::Export

use unreal_asset::exports::ExportBaseTrait

use unreal_asset::exports::NormalExport

use unreal_asset::flags::EObjectFlags

use unreal_asset::types::PackageIndex

use unreal_asset::Asset

use unreal_asset::Import

use unreal_asset_properties::array_property::ArrayProperty

use unreal_asset_properties::int_property::BoolProperty

use unreal_asset_properties::int_property::IntProperty

use unreal_asset_properties::object_property::ObjectProperty

use unreal_asset_properties::str_property::StrProperty

use unreal_asset_properties::Property

use crate::GraphEditor

use crate::GraphError

use crate::NodeType

use crate::PinDefinition

use crate::PinType

use crate::Result

@doc(doc = " Builds a UE5 Graph Editor .uasset file programmatically using the unreal_asset library.")
@doc(doc = "")
@doc(doc = " Usage:")
@doc(doc = " ```ignore")
@doc(doc = " let mut builder = GraphAssetBuilder::new(\"CombatGraph\");")
@doc(doc = " builder.add_node_type(&node_type);")
@doc(doc = " let bytes = builder.build()?;")
@doc(doc = " std::fs::write(\"CombatGraph.uasset\", bytes)?;")
@doc(doc = " ```")
pub struct GraphAssetBuilder:
    asset: unreal_asset::Asset<std::io::Cursor<Array<u8>>>
    graph_name: String
    engine_import: unreal_asset::types::PackageIndex
    core_uobject_import: unreal_asset::types::PackageIndex
    graph_class_import: unreal_asset::types::PackageIndex
    node_class_import: unreal_asset::types::PackageIndex
    pin_class_import: unreal_asset::types::PackageIndex
    schema_class_import: unreal_asset::types::PackageIndex
    class_imports: Map<String, unreal_asset::types::PackageIndex>
    graph_export_index: unreal_asset::types::PackageIndex
    node_type_exports: Array<unreal_asset::types::PackageIndex>
    schema_export_index: Option<unreal_asset::types::PackageIndex>
    next_node_x: i32
    next_node_y: i32

impl GraphAssetBuilder:
    pub fn new_(graph_name: String) -> GraphAssetBuilder:
        let mut asset = Asset__new_empty(unreal_asset__engine_version__EngineVersion__VER_UE5_2)
        let core_uobject_import = GraphAssetBuilder__get_or_add_package(&mut asset, "/Script/CoreUObject")
        let engine_import = GraphAssetBuilder__get_or_add_package(&mut asset, "/Script/Engine")
        let graph_class_import = GraphAssetBuilder__get_or_add_class(&mut asset, "EdGraph", engine_import)
        let node_class_import = GraphAssetBuilder__get_or_add_class(&mut asset, "EdGraphNode", engine_import)
        let pin_class_import = GraphAssetBuilder__get_or_add_class(&mut asset, "EdGraphPin", engine_import)
        let schema_class_import = GraphAssetBuilder__get_or_add_class(&mut asset, "EdGraphSchema", engine_import)
        let mut builder = GraphAssetBuilder { asset: asset, graph_name: graph_name.to_string(), engine_import: engine_import, core_uobject_import: core_uobject_import, graph_class_import: graph_class_import, node_class_import: node_class_import, pin_class_import: pin_class_import, schema_class_import: schema_class_import, class_imports: HashMap__new_(), graph_export_index: PackageIndex__new_(1), node_type_exports: Vec__new_(), schema_export_index: none, next_node_x: (-400), next_node_y: 0 }
        builder.create_graph_export()
        ()
        builder

    fn get_or_add_package(asset: &mut unreal_asset::Asset<std::io::Cursor<Array<u8>>>, package_path: String) -> unreal_asset::types::PackageIndex:
        for selfhost_for_item in (*asset).imports.iter().enumerate():
            let (idx, import) = selfhost_for_item
            if import.object_name.get_content(fn(s): (s == package_path)):
                return PackageIndex__new_((-(((idx + 1)) as i32)))
        ()
        let package_name = asset.add_fname(package_path)
        let class_package = asset.add_fname("Package")
        let import = unreal_asset::Import { class_package: class_package.clone(), class_name: class_package, outer_index: PackageIndex__new_(0), object_name: package_name, optional: false }
        (*asset).imports.push(import)
        ()
        PackageIndex__new_((-((*asset).imports.len() as i32)))

    fn get_or_add_class(asset: &mut unreal_asset::Asset<std::io::Cursor<Array<u8>>>, class_name: String, package_index: unreal_asset::types::PackageIndex) -> unreal_asset::types::PackageIndex:
        for selfhost_for_item in (*asset).imports.iter().enumerate():
            let (idx, import) = selfhost_for_item
            if (import.object_name.get_content(fn(s): (s == class_name)) && (import.outer_index == package_index)):
                return PackageIndex__new_((-(((idx + 1)) as i32)))
        ()
        let class_fname = asset.add_fname(class_name)
        let class_type = asset.add_fname("Class")
        let core_uobject = asset.add_fname("/Script/CoreUObject")
        let import = unreal_asset::Import { class_package: core_uobject, class_name: class_type, outer_index: package_index, object_name: class_fname, optional: false }
        (*asset).imports.push(import)
        ()
        PackageIndex__new_((-((*asset).imports.len() as i32)))

    fn get_node_type_class_import(_self: &mut GraphAssetBuilder, class_name: String) -> unreal_asset::types::PackageIndex:
        match (*_self).class_imports.get(class_name):
            Some(idx) => return idx
            _ =>
                ()
                ()
        let idx = GraphAssetBuilder__get_or_add_class(&mut (*_self).asset, class_name, (*_self).engine_import)
        (*_self).class_imports.insert(class_name.to_string(), idx)
        ()
        idx

    fn create_graph_export(_self: &mut GraphAssetBuilder):
        let graph_name = (*_self).asset.add_fname(&(*_self).graph_name)
        let base = unreal_asset::exports::BaseExport { class_index: (*_self).graph_class_import, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: PackageIndex__new_(0), object_name: graph_name, object_flags: (unreal_asset__flags__EObjectFlags__RF_PUBLIC | unreal_asset__flags__EObjectFlags__RF_STANDALONE), is_asset: true, ..Default__default_() }
        let normal = unreal_asset::exports::NormalExport { base_export: base, extras: Vec__new_(), properties: Vec__new_() }
        (*_self).asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(normal))
        ()

    fn next_position(_self: &mut GraphAssetBuilder) -> (i32, i32):
        let pos = ((*_self).next_node_x, (*_self).next_node_y)
        (*_self).next_node_y = ((*_self).next_node_y + 150)
        ()
        if ((*_self).next_node_y > 1500):
            (*_self).next_node_y = 0
            ()
            (*_self).next_node_x = ((*_self).next_node_x - 300)
            ()
            ()
            ()
            ()
        pos

    pub fn add_node_type_export(_self: &mut GraphAssetBuilder, node_type: &NodeType) -> unreal_asset::types::PackageIndex:
        let class_import = (*_self).get_node_type_class_import("EdGraphNode")
        let obj_name = (*_self).asset.add_fname(&f"{(*node_type).name}_{(*_self).node_type_exports.len()}")
        let (pos_x, pos_y) = (*_self).next_position()
        let mut props: Array<unreal_asset_properties::Property> = Vec__new_()
        let node_pos_x_name = (*_self).asset.add_fname("NodePosX")
        props.push((unreal_asset_properties::int_property::IntProperty { name: node_pos_x_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: pos_x }).into())
        ()
        let node_pos_y_name = (*_self).asset.add_fname("NodePosY")
        props.push((unreal_asset_properties::int_property::IntProperty { name: node_pos_y_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: pos_y }).into())
        ()
        let node_title_name = (*_self).asset.add_fname("NodeTitle")
        props.push((unreal_asset_properties::str_property::StrProperty { name: node_title_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: Option::Some((*node_type).name.clone()) }).into())
        ()
        let node_category_name = (*_self).asset.add_fname("NodeCategory")
        props.push((unreal_asset_properties::str_property::StrProperty { name: node_category_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: Option::Some((*node_type).category.clone()) }).into())
        ()
        match (*node_type).tooltip:
            Some(tooltip) =>
                let tooltip_name = (*_self).asset.add_fname("NodeTooltip")
                props.push((unreal_asset_properties::str_property::StrProperty { name: tooltip_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: Option::Some(tooltip.clone()) }).into())
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let graph_ref_name = (*_self).asset.add_fname("Graph")
        props.push((unreal_asset_properties::object_property::ObjectProperty { name: graph_ref_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: (*_self).graph_export_index }).into())
        ()
        let base = unreal_asset::exports::BaseExport { class_index: class_import, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: (*_self).graph_export_index, object_name: obj_name, object_flags: unreal_asset__flags__EObjectFlags__RF_PUBLIC, ..Default__default_() }
        let normal = unreal_asset::exports::NormalExport { base_export: base, extras: Vec__new_(), properties: props }
        (*_self).asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(normal))
        ()
        let export_index = PackageIndex__new_((*_self).asset.asset_data.exports.len() as i32)
        (*_self).node_type_exports.push(export_index)
        ()
        export_index

    pub fn create_schema_export(_self: &mut GraphAssetBuilder):
        let schema_name = (*_self).asset.add_fname(&f"{(*_self).graph_name}_Schema")
        let mut props: Array<unreal_asset_properties::Property> = Vec__new_()
        let graph_ref_name = (*_self).asset.add_fname("Graph")
        props.push((unreal_asset_properties::object_property::ObjectProperty { name: graph_ref_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: (*_self).graph_export_index }).into())
        ()
        let base = unreal_asset::exports::BaseExport { class_index: (*_self).schema_class_import, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: (*_self).graph_export_index, object_name: schema_name, object_flags: unreal_asset__flags__EObjectFlags__RF_PUBLIC, ..Default__default_() }
        let normal = unreal_asset::exports::NormalExport { base_export: base, extras: Vec__new_(), properties: props }
        (*_self).asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(normal))
        ()
        let export_index = PackageIndex__new_((*_self).asset.asset_data.exports.len() as i32)
        (*_self).schema_export_index = Option::Some(export_index)
        ()

    pub fn build(_self: GraphAssetBuilder) -> Result<Array<u8>, Error>:
        _self.finalize_graph_export()
        ()
        _self.asset.rebuild_name_map()
        ()
        let mut output = Cursor__new_(Vec__new_())
        _self.asset.write_data(&mut output, none).map_err(fn(e): GraphError::BinarySerialization(f"Failed to write .uasset: {e}"))?
        ()
        Result::Ok(output.into_inner())

    fn finalize_graph_export(_self: &mut GraphAssetBuilder):
        let mut graph_props: Array<unreal_asset_properties::Property> = Vec__new_()
        if (!(*_self).node_type_exports.is_empty()):
            let nodes_name = (*_self).asset.add_fname("Nodes")
            let inner_type = (*_self).asset.add_fname("ObjectProperty")
            let node_values: Array<unreal_asset_properties::Property> = (*_self).node_type_exports.iter().map(fn(__kain_closure_arg0): (unreal_asset_properties::object_property::ObjectProperty { name: nodes_name.clone(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: *__kain_closure_arg0 }).into()).collect()
            let arr_prop = unreal_asset_properties::array_property::ArrayProperty { name: nodes_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, array_type: Option::Some(inner_type), value: node_values, dummy_property: none }
            graph_props.push(arr_prop.into())
            ()
            ()
            ()
            ()
        match (*_self).schema_export_index:
            Some(schema_idx) =>
                let schema_name = (*_self).asset.add_fname("Schema")
                graph_props.push((unreal_asset_properties::object_property::ObjectProperty { name: schema_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: schema_idx }).into())
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*_self).asset.asset_data.exports.first_mut():
            Some(unreal_asset__exports__Export::NormalExport(mut normal)) =>
                normal.properties = graph_props
                ()
            _ => ()


@doc(doc = " Convert a GraphEditor IR to .uasset bytes.")
pub fn serialize_graph_editor(graph: &GraphEditor) -> Result<Array<u8>, Error>:
    let mut builder = GraphAssetBuilder__new_(&(*graph).name)
    for node_type in &(*graph).node_types:
        builder.add_node_type_export(node_type)
        ()
    ()
    builder.create_schema_export()
    ()
    builder.build()

@doc(doc = " Serialize a graph editor to binary .uasset format")
pub fn serialize(graph: &GraphEditor) -> Result<Array<u8>, Error>:
    serialize_graph_editor(graph)

