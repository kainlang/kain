use crate::error::Result

use crate::graph_ir::GraphEditor

@doc(doc = " Generate GraphData header file")
pub fn generate_graph_data_header(graph: &GraphEditor, plugin_name: String) -> Result<String, Error>:
    let graph_name = &(*graph).name
    let api_macro = f"{plugin_name.to_uppercase()}_API"
    let mut output = String__new_()
    output.push_str(&f"// Generated by KAIN compiler\n// Graph: {graph_name}\n\n#pragma once\n\n#include \"CoreMinimal.h\"\n#include \"{graph_name}PinData.h\"\n#include \"{graph_name}GraphNodeData.h\"\n#include \"{graph_name}GraphData.generated.h\"\n\nclass U{graph_name}PinData;\nclass U{graph_name}GraphNodeData;\n\n")
    ()
    output.push_str(&"/**\n * Container for {graph_name} graph runtime data\n */\nUCLASS()\nclass {api_macro} U{graph_name}GraphData : public UObject\n{\n    GENERATED_BODY()\n\npublic:\n    /** Find pin by unique identifier */\n    U{graph_name}PinData* FindPinById(FGuid PinId);\n    \n    /**\n     * Get first node of specific type\n     * @return First node of type T, or nullptr if not found\n     */\n    template <typename T>\n    T* GetNodeData()\n    {\n        static_assert(TIsDerivedFrom<T, U{graph_name}GraphNodeData>::IsDerived, \n                      \"T must be derived from U{graph_name}GraphNodeData\");\n\n        for (int i = 0; i < Nodes.Num(); i++)\n        {\n            if (!IsValid(Nodes[i]))\n            {\n                continue;\n            }\n            if (Nodes[i]->IsA<T>())\n            {\n                return Cast<T>(Nodes[i]);\n            }\n        }\n\n        return nullptr;\n    }\n    \n    /**\n     * Get all nodes of specific type\n     * @return Array of nodes of type T\n     */\n    template <typename T>\n    TArray<T*> GetListNodeData()\n    {\n        static_assert(TIsDerivedFrom<T, U{graph_name}GraphNodeData>::IsDerived, \n                      \"T must be derived from U{graph_name}GraphNodeData\");\n\n        TArray<T*> Result;\n        for (int i = 0; i < Nodes.Num(); i++)\n        {\n            if (!IsValid(Nodes[i]))\n            {\n                continue;\n            }\n            if (Nodes[i]->IsA<T>())\n            {\n                Result.Add(Cast<T>(Nodes[i]));\n            }\n        }\n\n        return Result;\n    }\n\npublic:\n    /** All nodes in the graph */\n    UPROPERTY()\n    TArray<U{graph_name}GraphNodeData*> Nodes;\n};\n")
    ()
    Result::Ok(output)

@doc(doc = " Generate GraphData source file")
pub fn generate_graph_data_source(graph: &GraphEditor, _plugin_name: String) -> Result<String, Error>:
    let graph_name = &(*graph).name
    let mut output = String__new_()
    output.push_str(&f"// Generated by KAIN compiler\n// Graph: {graph_name}\n\n#include \"{graph_name}GraphData.h\"\n\n")
    ()
    output.push_str(&"U{graph_name}PinData* U{graph_name}GraphData::FindPinById(FGuid PinId)\n{\n    for (U{graph_name}GraphNodeData* Node : Nodes)\n    {\n        for (U{graph_name}PinData* Pin : Node->InputPins)\n        {\n            if (Pin->PinId == PinId)\n            {\n                return Pin;\n            }\n        }\n\n        for (U{graph_name}PinData* Pin : Node->OutputPins)\n        {\n            if (Pin->PinId == PinId)\n            {\n                return Pin;\n            }\n        }\n    }\n\n    return nullptr;\n}\n\n")
    ()
    Result::Ok(output)

