use kain_core::ast::BinaryOp

use kain_core::ast::Block

use kain_core::ast::Component

use kain_core::ast::ElseBranch

use kain_core::ast::Enum

use kain_core::ast::EnumVariantFields

use kain_core::ast::Expr

use kain_core::ast::Function

use kain_core::ast::Impl

use kain_core::ast::JSXAttrValue

use kain_core::ast::JSXNode

use kain_core::ast::Pattern

use kain_core::ast::Stmt

use kain_core::ast::Struct

use kain_core::ast::Type

use kain_core::ast::UnaryOp

use kain_core::ast::VariantFields

use kain_core::ast::VariantPatternFields

use kain_core::error::KainResult

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

use kain_core::lower_typed_program_memory_for_target

use kain_core::validate_typed_program_memory_support

use kain_core::CompileTarget

@doc(doc = " Generate JavaScript source code from a typed program")
pub fn generate(program: &kain_core::types::TypedProgram) -> Result<String, KainError>:
    let lowered = kain_core__lower_typed_program_memory_for_target(program, kain_core__CompileTarget__Js)?
    kain_core__validate_typed_program_memory_support(&lowered, kain_core__CompileTarget__Js)?
    ()
    let mut gen = JSGen__new_()
    Result::Ok(gen.gen_program(&lowered))

struct StringBuilder:
    lines: Array<String>

impl StringBuilder:
    fn new_() -> StringBuilder:
        StringBuilder { lines: Vec__new_() }

    fn push(_self: &mut StringBuilder, text: String):
        (*_self).lines.push(text.to_string())
        ()

    fn push_line(_self: &mut StringBuilder, text: String):
        (*_self).lines.push(f"{text}\n")
        ()

    fn build(_self: &StringBuilder) -> String:
        (*_self).lines.join("")


struct JSGen:
    output: StringBuilder
    indent: usize

impl JSGen:
    fn new_() -> JSGen:
        JSGen { output: StringBuilder__new_(), indent: 0 }

    fn indent(_self: &mut JSGen):
        (*_self).indent = ((*_self).indent + 1)
        ()

    fn dedent(_self: &mut JSGen):
        if ((*_self).indent > 0):
            (*_self).indent = ((*_self).indent - 1)
            ()

    fn write(_self: &mut JSGen, text: String):
        (*_self).output.push(text)
        ()

    fn writeln(_self: &mut JSGen, text: String):
        let indent_str = ("  ").repeat((*_self).indent)
        (*_self).output.push_line(&f"{indent_str}{text}")
        ()

    fn gen_program(_self: &mut JSGen, program: &kain_core::types::TypedProgram) -> String:
        (*_self).writeln("// Generated by KAIN compiler")
        ()
        (*_self).writeln("// Target: JavaScript (ES6+)")
        ()
        (*_self).writeln("")
        ()
        (*_self).writeln("// Low-level memory emulation runtime")
        ()
        (*_self).writeln("const __kainMem = new Map();")
        ()
        (*_self).writeln("const __kainPtrMeta = new Map();")
        ()
        (*_self).writeln("let __kainNextPtr = 1;")
        ()
        (*_self).writeln("function __kain_new_ptr(meta) { const ptr = __kainNextPtr++; __kainPtrMeta.set(ptr, meta); return ptr; }")
        ()
        (*_self).writeln("function __kain_clone_value(value) { if (Array.isArray(value)) { return value.map((item) => __kain_clone_value(item)); } if (value && typeof value === 'object') { return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, __kain_clone_value(v)])); } return value; }")
        ()
        (*_self).writeln("function __kain_addr_of(value) { const ptr = __kain_new_ptr({ kind: 'value' }); __kainMem.set(ptr, value); return ptr; }")
        ()
        (*_self).writeln("function __kain_bind_local(value) { return __kain_addr_of(value); }")
        ()
        (*_self).writeln("function __kain_field_ptr(ptr, field, _offset) { return __kain_new_ptr({ kind: 'field', base: ptr, field }); }")
        ()
        (*_self).writeln("function __kain_index_ptr(ptr, index, _stride) { return __kain_new_ptr({ kind: 'index', base: ptr, index }); }")
        ()
        (*_self).writeln("function __kain_ptr_offset(ptr, offset, stride) { return ptr + (offset * Math.max(stride, 1)); }")
        ()
        (*_self).writeln("function __kain_mem_load(ptr) { const meta = __kainPtrMeta.get(ptr); if (!meta || meta.kind === 'value') { return __kainMem.get(ptr); } if (meta.kind === 'field') { const base = __kain_mem_load(meta.base); return base == null ? undefined : base[meta.field]; } const base = __kain_mem_load(meta.base); return base == null ? undefined : base[meta.index]; }")
        ()
        (*_self).writeln("function __kain_mem_store(ptr, value) { const meta = __kainPtrMeta.get(ptr); if (!meta || meta.kind === 'value') { __kainMem.set(ptr, value); return value; } if (meta.kind === 'field') { const base = __kain_mem_load(meta.base); if (base != null) { base[meta.field] = value; } return value; } const base = __kain_mem_load(meta.base); if (base != null) { base[meta.index] = value; } return value; }")
        ()
        (*_self).writeln("function __kain_union_buffer(value, size) { if (!value || typeof value !== 'object') { return new ArrayBuffer(Math.max(size, 1)); } if (!Object.prototype.hasOwnProperty.call(value, '__kain_union_buffer')) { Object.defineProperty(value, '__kain_union_buffer', { value: new ArrayBuffer(Math.max(size, 1)), writable: true, enumerable: false, configurable: true }); } const existing = value.__kain_union_buffer; if (existing.byteLength < Math.max(size, 1)) { const next = new ArrayBuffer(Math.max(size, 1)); new Uint8Array(next).set(new Uint8Array(existing.slice(0))); Object.defineProperty(value, '__kain_union_buffer', { value: next, writable: true, enumerable: false, configurable: true }); return next; } return existing; }")
        ()
        (*_self).writeln("function __kain_union_encode(view, typeKey, byteSize, value) { switch (typeKey) { case 'Float': if (byteSize >= 8) { view.setFloat64(0, Number(value ?? 0), true); } else { view.setFloat32(0, Number(value ?? 0), true); } break; case 'Bool': view.setUint8(0, value ? 1 : 0); break; case 'Char': view.setUint8(0, typeof value === 'string' && value.length > 0 ? value.charCodeAt(0) & 0xFF : 0); break; default: if (byteSize >= 8) { view.setBigInt64(0, BigInt(Math.trunc(Number(value ?? 0))), true); } else if (byteSize >= 4) { view.setInt32(0, Number(value ?? 0), true); } else if (byteSize >= 2) { view.setInt16(0, Number(value ?? 0), true); } else { view.setInt8(0, Number(value ?? 0)); } break; } }")
        ()
        (*_self).writeln("function __kain_union_decode(typeKey, byteSize, fallback, view) { switch (typeKey) { case 'Float': return byteSize >= 8 ? view.getFloat64(0, true) : view.getFloat32(0, true); case 'Bool': return view.getUint8(0) !== 0; case 'Char': return String.fromCharCode(view.getUint8(0)); default: if (byteSize >= 8) { return Number(view.getBigInt64(0, true)); } if (byteSize >= 4) { return view.getInt32(0, true); } if (byteSize >= 2) { return view.getInt16(0, true); } if (byteSize >= 1) { return view.getInt8(0); } return fallback; } }")
        ()
        (*_self).writeln("function __kain_union_wrap(value, active, typeKey, byteSize, unionSize, activeValue) { Object.defineProperty(value, '__kain_union_active', { value: active, writable: true, enumerable: false, configurable: true }); const buffer = __kain_union_buffer(value, unionSize); __kain_union_encode(new DataView(buffer), typeKey, byteSize, activeValue); return value; }")
        ()
        (*_self).writeln("function __kain_union_get(value, field, typeKey, byteSize, unionSize, fallback) { if (value == null) { return fallback; } if (value.__kain_union_active === field) { return value[field]; } const buffer = __kain_union_buffer(value, unionSize); const next = __kain_union_decode(typeKey, byteSize, fallback, new DataView(buffer)); value[field] = next; return next; }")
        ()
        (*_self).writeln("function __kain_union_set(value, field, typeKey, byteSize, unionSize, next) { if (value != null) { const buffer = __kain_union_buffer(value, unionSize); __kain_union_encode(new DataView(buffer), typeKey, byteSize, next); value[field] = next; Object.defineProperty(value, '__kain_union_active', { value: field, writable: true, enumerable: false, configurable: true }); } return next; }")
        ()
        (*_self).writeln("function __kain_bitfield_units(value) { if (value == null) { return {}; } if (!Object.prototype.hasOwnProperty.call(value, '__kain_bitfield_units')) { Object.defineProperty(value, '__kain_bitfield_units', { value: {}, writable: true, enumerable: false, configurable: true }); } return value.__kain_bitfield_units; }")
        ()
        (*_self).writeln("function __kain_bitfield_get(value, field, unitOffset, bitOffset, width, signed) { if (value == null) { return 0; } const units = __kain_bitfield_units(value); const key = String(unitOffset); const unit = BigInt(units[key] ?? 0n); const safeWidth = BigInt(Math.max(width, 0)); const shift = BigInt(Math.max(bitOffset, 0)); const mask = safeWidth === 0n ? 0n : ((1n << safeWidth) - 1n); let next = Number((unit >> shift) & mask); if (signed && width > 0) { const signBit = 1n << BigInt(width - 1); let signedValue = (unit >> shift) & mask; if ((signedValue & signBit) !== 0n) { signedValue -= (1n << BigInt(width)); } next = Number(signedValue); } value[field] = next; return next; }")
        ()
        (*_self).writeln("function __kain_bitfield_set(value, field, unitOffset, bitOffset, width, signed, next) { if (value == null) { return next; } const units = __kain_bitfield_units(value); const key = String(unitOffset); const unit = BigInt(units[key] ?? 0n); const safeWidth = BigInt(Math.max(width, 0)); const shift = BigInt(Math.max(bitOffset, 0)); const mask = safeWidth === 0n ? 0n : ((1n << safeWidth) - 1n); let encoded = BigInt(Math.trunc(Number(next))); if (safeWidth > 0n) { encoded &= mask; } const cleared = unit & ~(mask << shift); units[key] = cleared | ((encoded & mask) << shift); const normalized = __kain_bitfield_get(value, field, unitOffset, bitOffset, width, signed); return normalized; }")
        ()
        (*_self).writeln("function __kain_alloc(size, stride, _zeroed, seed) { const step = Math.max(stride, 1); const count = Math.max(1, Math.ceil(Math.max(size, step) / step)); const base = __kainNextPtr; for (let i = 0; i < count; i++) { __kainMem.set(base + (i * step), __kain_clone_value(seed)); } __kainNextPtr = base + (count * step); return base; }")
        ()
        (*_self).writeln("function __kain_realloc(ptr, size, stride, seed) { if (!ptr) { return __kain_alloc(size, stride, false, seed); } const step = Math.max(stride, 1); const count = Math.max(1, Math.ceil(Math.max(size, step) / step)); for (let i = 0; i < count; i++) { const nextPtr = ptr + (i * step); if (!__kainMem.has(nextPtr)) { __kainMem.set(nextPtr, __kain_clone_value(seed)); } } return ptr; }")
        ()
        (*_self).writeln("")
        ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Function(f) =>
                    (*_self).gen_function(&f.ast)
                    ()
                kain_core__types__TypedItem::Struct(s) =>
                    (*_self).gen_struct(&s.ast)
                    ()
                kain_core__types__TypedItem::Enum(e) =>
                    (*_self).gen_enum(&e.ast)
                    ()
                kain_core__types__TypedItem::Component(c) =>
                    (*_self).gen_component(&c.ast)
                    ()
                kain_core__types__TypedItem::Const(c) =>
                    (*_self).gen_const(&c.ast.name, &c.ast.value)
                    ()
                kain_core__types__TypedItem::Impl(i) =>
                    (*_self).gen_impl(&i.ast)
                    ()
                _ => ()
            (*_self).writeln("")
            ()
        ()
        (*_self).output.build()

    fn gen_function(_self: &mut JSGen, func: &kain_core::ast::Function):
        let params = (*func).params.iter().map(fn(p): p.name.clone()).collect().join(", ")
        (*_self).writeln(&"function {(*func).name}({params}) {")
        ()
        (*_self).indent()
        ()
        (*_self).gen_block(&(*func).body)
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()

    fn gen_struct(_self: &mut JSGen, s: &kain_core::ast::Struct):
        (*_self).writeln(&"class {(*s).name} {")
        ()
        (*_self).indent()
        ()
        let params = (*s).fields.iter().map(fn(f): f.name.clone()).collect().join(", ")
        (*_self).writeln(&"constructor({params}) {")
        ()
        (*_self).indent()
        ()
        for field in &(*s).fields:
            (*_self).writeln(&f"this.{field.name} = {field.name};")
            ()
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()

    fn gen_enum(_self: &mut JSGen, e: &kain_core::ast::Enum):
        (*_self).writeln(&"const {(*e).name} = {")
        ()
        (*_self).indent()
        ()
        for variant in &(*e).variants:
            match &variant.fields:
                kain_core__ast__VariantFields::Unit =>
                    (*_self).writeln(&"{variant.name}: { type: '{(*e).name}', tag: '{variant.name}' },")
                    ()
                kain_core__ast__VariantFields::Tuple(types) =>
                    let params = (range(0, types.len())).map(fn(i): f"_{i}").collect().join(", ")
                    (*_self).writeln(&"{variant.name}: ({params}) => ({")
                    ()
                    (*_self).indent()
                    ()
                    (*_self).writeln(&f"type: '{(*e).name}',")
                    ()
                    (*_self).writeln(&f"tag: '{variant.name}',")
                    ()
                    for i in range(0, types.len()):
                        (*_self).writeln(&f"_{i}: _{i},")
                        ()
                    ()
                    (*_self).dedent()
                    ()
                    (*_self).writeln("}),")
                    ()
                kain_core__ast__VariantFields::Struct(fields) =>
                    let params = fields.iter().map(fn(f): f.name.clone()).collect().join(", ")
                    (*_self).writeln(&"{variant.name}: ({params}) => ({")
                    ()
                    (*_self).indent()
                    ()
                    (*_self).writeln(&f"type: '{(*e).name}',")
                    ()
                    (*_self).writeln(&f"tag: '{variant.name}',")
                    ()
                    for field in fields:
                        (*_self).writeln(&f"{field.name},")
                        ()
                    ()
                    (*_self).dedent()
                    ()
                    (*_self).writeln("}),")
                    ()
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("};")
        ()

    fn gen_component(_self: &mut JSGen, comp: &kain_core::ast::Component):
        let params = (*comp).props.iter().map(fn(p): p.name.clone()).collect().join(", ")
        (*_self).writeln(&"function {(*comp).name}({params}) {")
        ()
        (*_self).indent()
        ()
        for state_ in &(*comp).state_:
            (*_self).write(&f"let {state_.name} = ")
            ()
            (*_self).gen_expr(&state_.initial)
            ()
            (*_self).writeln(";")
            ()
        ()
        for method in &(*comp).methods:
            (*_self).gen_function(method)
            ()
        ()
        (*_self).write("return ")
        ()
        (*_self).gen_jsx(&(*comp).body)
        ()
        (*_self).writeln(";")
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()

    fn gen_const(_self: &mut JSGen, name: String, value: &kain_core::ast::Expr):
        (*_self).write(&f"const {name} = ")
        ()
        (*_self).gen_expr(value)
        ()
        (*_self).writeln(";")
        ()

    fn gen_impl(_self: &mut JSGen, impl_block: &kain_core::ast::Impl):
        match &(*impl_block).target_type:
            kain_core__ast__Type::Named { name: name } =>
                for method in &(*impl_block).methods:
                    let params = method.params.iter().skip(if method.params.first().map(fn(p): (p.name == "self")).unwrap_or(false): 1 else: 0).map(fn(p): p.name.clone()).collect().join(", ")
                    let has_self = method.params.first().map(fn(p): (p.name == "self")).unwrap_or(false)
                    if has_self:
                        (*_self).writeln(&"{name}.prototype.{method.name} = function({params}) {")
                        ()
                        ()
                        ()
                        ()
                    else:
                        (*_self).writeln(&"{name}.{method.name} = function({params}) {")
                        ()
                        ()
                        ()
                        ()
                    (*_self).indent()
                    ()
                    (*_self).gen_block(&method.body)
                    ()
                    (*_self).dedent()
                    ()
                    (*_self).writeln("};")
                    ()
            _ => ()

    fn gen_block(_self: &mut JSGen, block: &kain_core::ast::Block):
        for stmt in &(*block).stmts:
            (*_self).gen_stmt(stmt)
            ()

    fn gen_stmt(_self: &mut JSGen, stmt: &kain_core::ast::Stmt):
        match stmt:
            kain_core__ast__Stmt::Expr(expr) =>
                (*_self).gen_expr(expr)
                ()
                (*_self).writeln(";")
                ()
            kain_core__ast__Stmt::Let { pattern: pattern, value: value } =>
                match pattern:
                    kain_core__ast__Pattern::Binding { name: name } =>
                        (*_self).write(&f"let {name} = ")
                        ()
                        match value:
                            Some(val) =>
                                (*_self).gen_expr(val)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                (*_self).write("null")
                                ()
                                ()
                                ()
                                ()
                        (*_self).writeln(";")
                        ()
                    _ => ()
            kain_core__ast__Stmt::Return(expr, _) =>
                (*_self).write("return")
                ()
                match expr:
                    Some(e) =>
                        (*_self).write(" ")
                        ()
                        (*_self).gen_expr(e)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).writeln(";")
                ()
            kain_core__ast__Stmt::For { binding: binding, iter: iter, body: body } =>
                match binding:
                    kain_core__ast__Pattern::Binding { name: name } =>
                        (*_self).write(&f"for (const {name} of ")
                        ()
                        (*_self).gen_expr(iter)
                        ()
                        (*_self).writeln(") {")
                        ()
                        (*_self).indent()
                        ()
                        (*_self).gen_block(body)
                        ()
                        (*_self).dedent()
                        ()
                        (*_self).writeln("}")
                        ()
                    _ => ()
            kain_core__ast__Stmt::While { condition: condition, body: body } =>
                (*_self).write("while (")
                ()
                (*_self).gen_expr(condition)
                ()
                (*_self).writeln(") {")
                ()
                (*_self).indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).dedent()
                ()
                (*_self).writeln("}")
                ()
            kain_core__ast__Stmt::Loop { body: body } =>
                (*_self).writeln("while (true) {")
                ()
                (*_self).indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).dedent()
                ()
                (*_self).writeln("}")
                ()
            kain_core__ast__Stmt::Break(expr, _) =>
                if expr.is_some():
                    (*_self).writeln("// Note: break with value not supported in JS")
                    ()
                    ()
                    ()
                    ()
                (*_self).writeln("break;")
                ()
            kain_core__ast__Stmt::Continue(_) =>
                (*_self).writeln("continue;")
                ()
            _ =>
                (*_self).writeln("// Unsupported statement")
                ()

    fn gen_expr(_self: &mut JSGen, expr: &kain_core::ast::Expr):
        match expr:
            kain_core__ast__Expr::Int(n, _) => (*_self).write(&n.to_string())
            kain_core__ast__Expr::Float(f, _) => (*_self).write(&f.to_string())
            kain_core__ast__Expr::String(s, _) => (*_self).write(&f"\"{s.escape_default()}\"")
            kain_core__ast__Expr::Bool(b, _) => (*_self).write(if (*b): "true" else: "false")
            kain_core__ast__Expr::None(_) => (*_self).write("null")
            kain_core__ast__Expr::Ident(name, _) => (*_self).write(name)
            kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
                (*_self).write("(")
                ()
                (*_self).gen_expr(left)
                ()
                (*_self).write(&f" {(*_self).gen_binop((*op))} ")
                ()
                (*_self).gen_expr(right)
                ()
                (*_self).write(")")
                ()
            kain_core__ast__Expr::Unary { op: op, operand: operand } =>
                (*_self).write(&f"({(*_self).gen_unop((*op))}")
                ()
                (*_self).gen_expr(operand)
                ()
                (*_self).write(")")
                ()
            kain_core__ast__Expr::Cast { value: value } =>
                (*_self).gen_expr(value)
                ()
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                (*_self).gen_expr(callee)
                ()
                (*_self).write("(")
                ()
                for selfhost_for_item in args.iter().enumerate():
                    let (i, arg) = selfhost_for_item
                    if (i > 0):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).gen_expr(&arg.value)
                    ()
                ()
                (*_self).write(")")
                ()
            kain_core__ast__Expr::Array(elements, _) =>
                (*_self).write("[")
                ()
                for selfhost_for_item in elements.iter().enumerate():
                    let (i, elem) = selfhost_for_item
                    if (i > 0):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).gen_expr(elem)
                    ()
                ()
                (*_self).write("]")
                ()
            kain_core__ast__Expr::Tuple(elements, _) =>
                (*_self).write("[")
                ()
                for selfhost_for_item in elements.iter().enumerate():
                    let (i, elem) = selfhost_for_item
                    if (i > 0):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).gen_expr(elem)
                    ()
                ()
                (*_self).write("]")
                ()
            kain_core__ast__Expr::Index { object: object, index: index } =>
                (*_self).gen_expr(object)
                ()
                (*_self).write("[")
                ()
                (*_self).gen_expr(index)
                ()
                (*_self).write("]")
                ()
            kain_core__ast__Expr::Field { object: object, field: field } =>
                (*_self).gen_expr(object)
                ()
                (*_self).write(&f".{field}")
                ()
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                (*_self).gen_expr(receiver)
                ()
                (*_self).write(&f".{method}(")
                ()
                for selfhost_for_item in args.iter().enumerate():
                    let (i, arg) = selfhost_for_item
                    if (i > 0):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).gen_expr(&arg.value)
                    ()
                ()
                (*_self).write(")")
                ()
            kain_core__ast__Expr::Struct { name: name, fields: fields } =>
                (*_self).write(&f"new {name}(")
                ()
                for selfhost_for_item in fields.iter().enumerate():
                    let (i, (_, expr)) = selfhost_for_item
                    if (i > 0):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).gen_expr(expr)
                    ()
                ()
                (*_self).write(")")
                ()
            kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                (*_self).write("(")
                ()
                (*_self).gen_expr(condition)
                ()
                (*_self).write(" ? ")
                ()
                (*_self).gen_block_as_expr(then_branch)
                ()
                (*_self).write(" : ")
                ()
                match else_branch:
                    Some(else_br) =>
                        match else_br:
                            kain_core__ast__ElseBranch::Else(else_block) =>
                                (*_self).gen_block_as_expr(else_block)
                                ()
                            kain_core__ast__ElseBranch::ElseIf {  } =>
                                (*_self).write("/* else-if */null")
                                ()
                                ()
                                ()
                                ()
                        ()
                    _ =>
                        (*_self).write("null")
                        ()
                        ()
                        ()
                        ()
                (*_self).write(")")
                ()
            kain_core__ast__Expr::Match { scrutinee: scrutinee, arms: arms } =>
                (*_self).write("(() => {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).write("const __match = ")
                ()
                (*_self).gen_expr(scrutinee)
                ()
                (*_self).writeln(";")
                ()
                for selfhost_for_item in arms.iter().enumerate():
                    let (i, arm) = selfhost_for_item
                    if (i == 0):
                        (*_self).write("if (")
                        ()
                        ()
                        ()
                        ()
                    else:
                        (*_self).write("else if (")
                        ()
                        ()
                        ()
                        ()
                    (*_self).gen_pattern_match("__match", &arm.pattern)
                    ()
                    (*_self).writeln(") {")
                    ()
                    (*_self).indent()
                    ()
                    (*_self).write("return ")
                    ()
                    (*_self).gen_expr(&arm.body)
                    ()
                    (*_self).writeln(";")
                    ()
                    (*_self).dedent()
                    ()
                    (*_self).write("} ")
                    ()
                ()
                (*_self).writeln("")
                ()
                (*_self).writeln("throw new Error('Non-exhaustive match');")
                ()
                (*_self).dedent()
                ()
                (*_self).write("})()")
                ()
            kain_core__ast__Expr::Lambda { params: params, body: body } =>
                let param_names = params.iter().map(fn(p): p.name.clone()).collect().join(", ")
                (*_self).write(&f"({param_names}) => ")
                ()
                (*_self).gen_expr(body)
                ()
            kain_core__ast__Expr::Block(block, _) =>
                (*_self).write("(() => {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).gen_block(block)
                ()
                (*_self).dedent()
                ()
                (*_self).write("})()")
                ()
            kain_core__ast__Expr::Assign { target: target, value: value } =>
                (*_self).gen_expr(target)
                ()
                (*_self).write(" = ")
                ()
                (*_self).gen_expr(value)
                ()
            kain_core__ast__Expr::FString(parts, _) =>
                (*_self).write("`")
                ()
                for part in parts:
                    match part:
                        kain_core__ast__Expr::String(s, _) => (*_self).write(s)
                        _ =>
                            (*_self).write("${")
                            ()
                            (*_self).gen_expr(part)
                            ()
                            (*_self).write("}")
                            ()
                ()
                (*_self).write("`")
                ()
            kain_core__ast__Expr::JSX(node, _) =>
                (*_self).gen_jsx(node)
                ()
            kain_core__ast__Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: fields } =>
                (*_self).write(&f"{enum_name}.{variant}(")
                ()
                match fields:
                    kain_core__ast__EnumVariantFields::Unit => ()
                    kain_core__ast__EnumVariantFields::Tuple(exprs) =>
                        for selfhost_for_item in exprs.iter().enumerate():
                            let (i, expr) = selfhost_for_item
                            if (i > 0):
                                (*_self).write(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).gen_expr(expr)
                            ()
                        ()
                        ()
                    kain_core__ast__EnumVariantFields::Struct(named) =>
                        for selfhost_for_item in named.iter().enumerate():
                            let (i, (_, expr)) = selfhost_for_item
                            if (i > 0):
                                (*_self).write(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).gen_expr(expr)
                            ()
                        ()
                        ()
                (*_self).write(")")
                ()
            _ =>
                (*_self).write("/* unsupported expr */")
                ()

    fn gen_jsx(_self: &mut JSGen, node: &kain_core::ast::JSXNode):
        match node:
            kain_core__ast__JSXNode::Element { tag: tag, attributes: attributes, children: children } =>
                (*_self).write(&"(() => {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).writeln(&f"const __el = document.createElement('{tag}');")
                ()
                for attr in attributes:
                    match &attr.value:
                        kain_core__ast__JSXAttrValue::String(s) => if (attr.name == "class"): none else: none
                        kain_core__ast__JSXAttrValue::Bool(b) =>
                            if (*b):
                                (*_self).writeln(&f"__el.setAttribute('{attr.name}', '');")
                                ()
                        kain_core__ast__JSXAttrValue::Expr(expr) =>
                            if attr.name.starts_with("on_"):
                                let event = attr.name.trim_start_matches("on_")
                                (*_self).write(&f"__el.addEventListener('{event}', ")
                                ()
                                (*_self).gen_expr(expr)
                                ()
                                (*_self).writeln(");")
                                ()
                            elif (attr.name == "class"):
                                (*_self).write("__el.className = ")
                                ()
                                (*_self).gen_expr(expr)
                                ()
                                (*_self).writeln(";")
                                ()
                            else:
                                (*_self).write(&f"__el.setAttribute('{attr.name}', ")
                                ()
                                (*_self).gen_expr(expr)
                                ()
                                (*_self).writeln(");")
                                ()
                ()
                for child in children:
                    (*_self).write("__el.appendChild(")
                    ()
                    (*_self).gen_jsx(child)
                    ()
                    (*_self).writeln(");")
                    ()
                ()
                (*_self).writeln("return __el;")
                ()
                (*_self).dedent()
                ()
                (*_self).write("})()")
                ()
            kain_core__ast__JSXNode::Text(text, _) =>
                (*_self).write(&f"document.createTextNode('{text.escape_default()}')")
                ()
            kain_core__ast__JSXNode::Expression(expr) =>
                (*_self).write("(() => {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).write("const __val = ")
                ()
                (*_self).gen_expr(expr)
                ()
                (*_self).writeln(";")
                ()
                (*_self).writeln("if (typeof __val === 'string' || typeof __val === 'number') {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("return document.createTextNode(String(__val));")
                ()
                (*_self).dedent()
                ()
                (*_self).writeln("} else if (__val instanceof Node) {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("return __val;")
                ()
                (*_self).dedent()
                ()
                (*_self).writeln("} else {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("return document.createTextNode('');")
                ()
                (*_self).dedent()
                ()
                (*_self).writeln("}")
                ()
                (*_self).dedent()
                ()
                (*_self).write("})()")
                ()
            kain_core__ast__JSXNode::ComponentCall { name: name, props: props, children: children } =>
                (*_self).write(&"{name}({")
                ()
                for selfhost_for_item in props.iter().enumerate():
                    let (i, prop) = selfhost_for_item
                    if (i > 0):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).write(&f"{prop.name}: ")
                    ()
                    match &prop.value:
                        kain_core__ast__JSXAttrValue::String(s) => (*_self).write(&f"'{s}'")
                        kain_core__ast__JSXAttrValue::Bool(b) => (*_self).write(&b.to_string())
                        kain_core__ast__JSXAttrValue::Expr(e) => (*_self).gen_expr(e)
                ()
                if (!children.is_empty()):
                    if (!props.is_empty()):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).write("children: [")
                    ()
                    for selfhost_for_item in children.iter().enumerate():
                        let (i, child) = selfhost_for_item
                        if (i > 0):
                            (*_self).write(", ")
                            ()
                            ()
                            ()
                            ()
                        (*_self).gen_jsx(child)
                        ()
                    ()
                    (*_self).write("]")
                    ()
                    ()
                    ()
                    ()
                (*_self).write("})")
                ()
            kain_core__ast__JSXNode::Fragment(children, _) =>
                (*_self).write("(() => {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).writeln("const __frag = document.createDocumentFragment();")
                ()
                for child in children:
                    (*_self).write("__frag.appendChild(")
                    ()
                    (*_self).gen_jsx(child)
                    ()
                    (*_self).writeln(");")
                    ()
                ()
                (*_self).writeln("return __frag;")
                ()
                (*_self).dedent()
                ()
                (*_self).write("})()")
                ()
            kain_core__ast__JSXNode::For { binding: binding, iter: iter, body: body } =>
                (*_self).write("(() => {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).writeln("const __frag = document.createDocumentFragment();")
                ()
                (*_self).write(&f"for (const {binding} of ")
                ()
                (*_self).gen_expr(iter)
                ()
                (*_self).writeln(") {")
                ()
                (*_self).indent()
                ()
                (*_self).write("__frag.appendChild(")
                ()
                (*_self).gen_jsx(body)
                ()
                (*_self).writeln(");")
                ()
                (*_self).dedent()
                ()
                (*_self).writeln("}")
                ()
                (*_self).writeln("return __frag;")
                ()
                (*_self).dedent()
                ()
                (*_self).write("})()")
                ()
            kain_core__ast__JSXNode::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                (*_self).write("(() => {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).write("if (")
                ()
                (*_self).gen_expr(condition)
                ()
                (*_self).writeln(") {")
                ()
                (*_self).indent()
                ()
                (*_self).write("return ")
                ()
                (*_self).gen_jsx(then_branch)
                ()
                (*_self).writeln(";")
                ()
                (*_self).dedent()
                ()
                match else_branch:
                    Some(else_node) =>
                        (*_self).writeln("} else {")
                        ()
                        (*_self).indent()
                        ()
                        (*_self).write("return ")
                        ()
                        (*_self).gen_jsx(else_node)
                        ()
                        (*_self).writeln(";")
                        ()
                        (*_self).dedent()
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).writeln("}")
                ()
                (*_self).writeln("return document.createTextNode('');")
                ()
                (*_self).dedent()
                ()
                (*_self).write("})()")
                ()

    fn gen_block_as_expr(_self: &mut JSGen, block: &kain_core::ast::Block):
        (*_self).write("(() => {")
        ()
        (*_self).indent()
        ()
        (*_self).writeln("")
        ()
        (*_self).gen_block(block)
        ()
        (*_self).dedent()
        ()
        (*_self).write("})()")
        ()

    fn gen_pattern_match(_self: &mut JSGen, scrutinee: String, pattern: &kain_core::ast::Pattern):
        match pattern:
            kain_core__ast__Pattern::Wildcard(_) => (*_self).write("true")
            kain_core__ast__Pattern::Binding {  } => (*_self).write("true")
            kain_core__ast__Pattern::Literal(expr) =>
                (*_self).write(&f"{scrutinee} === ")
                ()
                (*_self).gen_expr(expr)
                ()
            kain_core__ast__Pattern::Variant { enum_name: enum_name, variant: variant, fields: fields } =>
                match enum_name:
                    Some(enum_name) =>
                        (*_self).write(&f"{scrutinee}.type === '{enum_name}' && {scrutinee}.tag === '{variant}'")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        (*_self).write(&f"{scrutinee}.tag === '{variant}'")
                        ()
                        ()
                        ()
                        ()
                match fields:
                    kain_core__ast__VariantPatternFields::Tuple(patterns) =>
                        for selfhost_for_item in patterns.iter().enumerate():
                            let (i, _) = selfhost_for_item
                            (*_self).write(&f" && typeof {scrutinee}._{i} !== 'undefined'")
                            ()
                    _ => ()
            _ => (*_self).write("false")

    fn gen_binop(_self: &JSGen, op: kain_core::ast::BinaryOp) -> String:
        match op:
            kain_core__ast__BinaryOp::Add => "+"
            kain_core__ast__BinaryOp::Sub => "-"
            kain_core__ast__BinaryOp::Mul => "*"
            kain_core__ast__BinaryOp::Div => "/"
            kain_core__ast__BinaryOp::Mod => "%"
            kain_core__ast__BinaryOp::Pow => "**"
            kain_core__ast__BinaryOp::Eq => "==="
            kain_core__ast__BinaryOp::Ne => "!=="
            kain_core__ast__BinaryOp::Lt => "<"
            kain_core__ast__BinaryOp::Le => "<="
            kain_core__ast__BinaryOp::Gt => ">"
            kain_core__ast__BinaryOp::Ge => ">="
            kain_core__ast__BinaryOp::And => "&&"
            kain_core__ast__BinaryOp::Or => "||"
            kain_core__ast__BinaryOp::BitAnd => "&"
            kain_core__ast__BinaryOp::BitOr => "|"
            kain_core__ast__BinaryOp::BitXor => "^"
            kain_core__ast__BinaryOp::Shl => "<<"
            kain_core__ast__BinaryOp::Shr => ">>"
            kain_core__ast__BinaryOp::Assign => "="
            kain_core__ast__BinaryOp::AddAssign => "+="
            kain_core__ast__BinaryOp::SubAssign => "-="
            kain_core__ast__BinaryOp::MulAssign => "*="
            kain_core__ast__BinaryOp::DivAssign => "/="
            kain_core__ast__BinaryOp::Range => "/* range */"
            kain_core__ast__BinaryOp::RangeInclusive => "/* range */"

    fn gen_unop(_self: &JSGen, op: kain_core::ast::UnaryOp) -> String:
        match op:
            kain_core__ast__UnaryOp::Neg => "-"
            kain_core__ast__UnaryOp::Not => "!"
            kain_core__ast__UnaryOp::BitNot => "~"
            kain_core__ast__UnaryOp::Ref => ""
            kain_core__ast__UnaryOp::RefMut => ""
            kain_core__ast__UnaryOp::Deref => ""


