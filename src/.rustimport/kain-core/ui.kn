const UI_AUTHORING_CONTRACT_VERSION: String = "ui_slate_x100.authoring_contract.v1"

pub enum UIBackendKind:
    Runtime
    ReactDom
    BrowserDom
    Slate

@doc(doc = " Declarative backend capabilities for UI lowering and rendering.")
@derive(Clone, Copy, Debug, PartialEq, Eq)
pub struct UIBackendProfile:
    kind: UIBackendKind
    event_prefix: String
    supports_fragments: Bool
    supports_component_instances: Bool
    supports_keyed_children: Bool
    bool_attr_true_is_bare: Bool
    fragment_tag: String

pub const UI_BACKEND_PROFILES: Array<UIBackendProfile> = [UIBackendProfile { kind: UIBackendKind__Runtime, event_prefix: "on_", supports_fragments: true, supports_component_instances: true, supports_keyed_children: true, bool_attr_true_is_bare: true, fragment_tag: "Fragment" }, UIBackendProfile { kind: UIBackendKind__ReactDom, event_prefix: "on", supports_fragments: true, supports_component_instances: true, supports_keyed_children: true, bool_attr_true_is_bare: false, fragment_tag: "React.Fragment" }, UIBackendProfile { kind: UIBackendKind__BrowserDom, event_prefix: "on_", supports_fragments: true, supports_component_instances: false, supports_keyed_children: true, bool_attr_true_is_bare: true, fragment_tag: "DocumentFragment" }, UIBackendProfile { kind: UIBackendKind__Slate, event_prefix: "on_", supports_fragments: true, supports_component_instances: true, supports_keyed_children: false, bool_attr_true_is_bare: false, fragment_tag: "SFragment" }]

pub fn ui_backend_profile(kind: UIBackendKind) -> &static UIBackendProfile:
    UI_BACKEND_PROFILES.iter().find(fn(profile): (profile.kind == kind)).unwrap_or(&UI_BACKEND_PROFILES[0])

pub enum UIAttr:
    Property { name: String, value: Value, expr: Option<Expr> }
    Bool { name: String, value: Bool }
    Event { name: String, event: UIEvent, handler: Value, expr: Option<Expr> }

pub enum UIEvent:
    Click
    Input
    Change
    Submit
    Focus
    Blur
    KeyDown
    KeyUp
    PointerDown
    PointerUp
    PointerMove
    Custom(String)

@doc(doc = " Runtime component instance snapshot.")
@derive(Clone, Debug)
pub struct ComponentInstance:
    name: String
    props: Map<String, Value>
    children: Array<VNode>
    state_: Map<String, Value>

pub enum VNode:
    Element { tag: String, attrs: Array<UIAttr>, children: Array<VNode>, key: Option<String> }
    Text(String)
    Fragment(Array<VNode>)
    Component { instance: ComponentInstance, rendered: Box<VNode> }

impl std::fmt::Display for VNode:
    fn fmt(_self: &VNode, f: &mut std::fmt::Formatter<_>) -> Result<(), Error>:
        __kain_write_fmt!(f, render_to_string(*_self))


@doc(doc = " Render a runtime UI node into an HTML-like debug string.")
pub fn render_to_string(node: &VNode) -> String:
    match node:
        VNode::Element { tag: tag, attrs: attrs, children: children } =>
            let attrs = attrs.iter().map(render_attr_to_string).filter(fn(part): (!part.is_empty())).collect().join(" ")
            let attr_suffix = if attrs.is_empty():
                String__new_()
            else:
                f" {attrs}"
            if children.is_empty():
                f"<{tag}{attr_suffix}/>"
            else:
                let children = children.iter().map(render_to_string).collect().join("")
                f"<{tag}{attr_suffix}>{children}</{tag}>"
        VNode::Text(text) => text.clone()
        VNode::Fragment(children) => children.iter().map(render_to_string).collect().join("")
        VNode::Component { rendered: rendered } => render_to_string(rendered)

@doc(doc = " Lightweight reconciliation hook for future diff-based rendering.")
@doc(doc = "")
@doc(doc = " The current implementation is intentionally conservative: if the roots are")
@doc(doc = " obviously compatible it preserves the new tree shape directly, otherwise it")
@doc(doc = " replaces the old node. This gives the rest of the runtime a stable entry")
@doc(doc = " point without pretending to be a full DOM reconciler yet.")
pub fn reconcile(current: Option<&VNode>, next: &VNode) -> VNode:
    match (current, next):
        (Some(VNode::Element { tag: old_tag }), VNode::Element { tag: new_tag, attrs: attrs, children: children, key: key }) if (old_tag == new_tag) => VNode::Element { tag: new_tag.clone(), attrs: attrs.clone(), children: children.clone(), key: key.clone() }
        (Some(VNode::Text(_)), VNode::Text(text)) => VNode::Text(text.clone())
        (Some(VNode::Fragment(_)), VNode::Fragment(children)) => VNode::Fragment(children.clone())
        (Some(VNode::Component { instance: old_instance }), VNode::Component { instance: instance, rendered: rendered }) if (old_instance.name == instance.name) => VNode::Component { instance: instance.clone(), rendered: Box__new_(reconcile(none, rendered)) }
        _ => next.clone()

@doc(doc = " Evaluate a KAIN JSX node into a runtime UI value.")
pub fn eval_jsx(env: &mut Env, node: &JSXNode) -> Result<Value, KainError>:
    match node:
        JSXNode::Element { tag: tag, attributes: attributes, children: children } =>
            let attrs = eval_attrs(env, attributes)?
            let children = eval_children(env, children)?
            let key = find_attr_key(&attrs, "key")
            Result::Ok(Value::JSX(VNode::Element { tag: tag.clone(), attrs: attrs, children: children, key: key }))
        JSXNode::Text(s, _) => Result::Ok(Value::String(s.clone()))
        JSXNode::Expression(expr) => runtime__eval_expr(env, expr)
        JSXNode::Fragment(children, _) => Result::Ok(Value::JSX(VNode::Fragment(eval_children(env, children)?)))
        JSXNode::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
            let cond = runtime__eval_expr(env, condition)?
            if value_is_truthy(&cond):
                eval_jsx(env, then_branch)
            else:
                match else_branch:
                    Some(else_branch) => eval_jsx(env, else_branch)
                    _ => Result::Ok(Value::JSX(VNode::Fragment(Vec__new_())))
        JSXNode::For { binding: binding, iter: iter, body: body } =>
            let iter_value = runtime__eval_expr(env, iter)?
            let items = match iter_value:
                Value::Array(items) => items.read().unwrap().clone()
                Value::Tuple(items) => items
                _ => Vec__new_()
            let mut children = Vec__new_()
            for item in items:
                env.push_scope()
                ()
                env.define(binding.clone(), item)
                ()
                let rendered = eval_jsx(env, body)?
                env.pop_scope()
                ()
                flatten_value_into_children(rendered, &mut children)
                ()
            ()
            Result::Ok(Value::JSX(VNode::Fragment(children)))
        JSXNode::ComponentCall { name: name, props: props, children: children } => eval_component_call(env, name, props, children)

@doc(doc = " Parse KAIN source, register its items, and render a root component into a")
@doc(doc = " semantic `UiTree`.")
pub fn build_ui_output_from_source(source: String, root_component: String) -> Result<kain_ui::UiBuildOutput, KainError>:
    let tokens = Lexer__new_(source).tokenize()?
    let span_mapper = SpanMapper__new_(source)
    let mut parser = Parser__new_(&tokens, &span_mapper, "<ui-source>")
    let mut program = parser.parse()?
    comptime__eval_program(&mut program)?
    ()
    build_ui_output_from_program(&program, root_component)

@doc(doc = " Render a registered root component from an already-parsed program into a")
@doc(doc = " semantic `UiTree`.")
pub fn build_ui_output_from_program(program: &Program, root_component: String) -> Result<kain_ui::UiBuildOutput, KainError>:
    let mut env = Env__new_()
    env.register_program_items(program)?
    ()
    let root = JSXNode::ComponentCall { name: root_component.to_string(), props: Vec__new_(), children: Vec__new_(), span: Span__default_() }
    let rendered = eval_jsx(&mut env, &root)?
    let mut output = lower_value_to_ui_tree(rendered)
    append_global_ui_authoring_contracts(&mut output, &env)
    ()
    Result::Ok(output)

@doc(doc = " Lower any interpreter value into a semantic `UiTree`.")
pub fn lower_value_to_ui_tree(value: Value) -> kain_ui::UiBuildOutput:
    let root = coerce_value_to_vnode(value)
    lower_vnode_to_ui_tree(&root)

@doc(doc = " Lower a runtime VNode tree into the semantic `kain-ui` tree.")
pub fn lower_vnode_to_ui_tree(root: &VNode) -> kain_ui::UiBuildOutput:
    let mut lowering = UiLowering__default_()
    let root_id = lower_vnode_into_tree(&mut lowering, root).unwrap_or_else(fn(): allocate_empty_root(&mut lowering.builder))
    lowering.builder.set_root(root_id)
    ()
    let mut output = lowering.builder.finish()
    if (!theme_registry_is_empty(&lowering.authored_theme)):
        output.systems.theme_registry = merge_authored_theme_registry(&output.systems.theme_registry, lowering.authored_theme)
        ()
        ()
        ()
        ()
    lowering.authored_systems.apply_to_output(&mut output)
    ()
    output

@doc(doc = " Render the semantic tree into a text debug view.")
pub fn render_ui_output_debug(output: &kain_ui::UiBuildOutput) -> String:
    kain_ui__render_debug_tree(&(*output).tree)

fn eval_component_call(env: &mut Env, name: String, props: &[ast::JSXAttribute], children: &[JSXNode]) -> Result<Value, KainError>:
    let attrs = eval_attrs(env, props)?
    let rendered_children = eval_children(env, children)?
    let props_map = attrs_to_props_map(&attrs)
    match env.lookup_component(name).cloned():
        Some(component_) =>
            let (rendered, state_) = render_component_definition(env, &component_, &props_map, &rendered_children)?
            let instance = ComponentInstance { name: name.to_string(), props: props_map, children: rendered_children, state_: state_ }
            Result::Ok(Value::JSX(VNode::Component { instance: instance, rendered: Box__new_(rendered) }))
        _ =>
            let instance = ComponentInstance { name: name.to_string(), props: props_map, children: rendered_children.clone(), state_: HashMap__new_() }
            Result::Ok(Value::JSX(VNode::Component { instance: instance, rendered: Box__new_(VNode::Fragment(rendered_children)) }))

fn render_component_definition(env: &mut Env, component_: &Component, props: &Map<String, Value>, rendered_children: &[VNode]) -> Result<(VNode, Map<String, Value>), KainError>:
    env.push_scope()
    ()
    let result = (fn(): none)()
    env.pop_scope()
    ()
    result

fn coerce_value_to_vnode(value: Value) -> VNode:
    match value:
        Value::JSX(node) => node
        other =>
            let mut children = Vec__new_()
            flatten_value_into_children(other, &mut children)
            ()
            match children.len():
                0 => VNode::Fragment(Vec__new_())
                1 => children.into_iter().next().unwrap()
                _ => VNode::Fragment(children)

struct UiLowering:
    builder: kain_ui::UiTreeBuilder
    authored_theme: kain_ui::UiThemeRegistry
    authored_systems: AuthoredUiSystemsAccumulator

impl Default for UiLowering:
    fn default_() -> UiLowering:
        UiLowering { builder: UiTreeBuilder__new_(), authored_theme: kain_ui::UiThemeRegistry { active_theme: none, ..UiThemeRegistry__default_() }, authored_systems: AuthoredUiSystemsAccumulator__default_() }


@derive(Debug, Clone)
struct AuthoredComputedSpec:
    id: String
    label: String
    depends_on: Array<String>
    writes_signal: Option<String>
    expr: Option<Expr>
    invalidates: Array<String>
    scheduler_phase: kain_ui::UiSchedulerPhase

@derive(Default)
struct AuthoredUiSystemsAccumulator:
    focus_scopes: Set<String>
    focus_default_scope: Option<String>
    selection_scopes: Set<String>
    selection_default_scope: Option<String>
    event_routes: Array<kain_ui::UiEventRoute>
    animation_tracks: Array<kain_ui::UiAnimationTrack>
    surfaces: Array<kain_ui::UiSurface>
    computed_specs: Array<AuthoredComputedSpec>
    signal_values: Map<kain_ui::UiSignalId, kain_ui::UiValue>
    session_state: Map<String, kain_ui::UiValue>
    workspace_persistence_key: Option<String>
    workspace_virtualization_enabled: Option<Bool>

impl Default for AuthoredUiSystemsAccumulator:
    pub fn default_() -> AuthoredUiSystemsAccumulator:
        AuthoredUiSystemsAccumulator { focus_scopes: HashSet__new_(), focus_default_scope: none, selection_scopes: HashSet__new_(), selection_default_scope: none, event_routes: Vec__new_(), animation_tracks: Vec__new_(), surfaces: Vec__new_(), computed_specs: Vec__new_(), signal_values: HashMap__new_(), session_state: HashMap__new_(), workspace_persistence_key: none, workspace_virtualization_enabled: none }


impl AuthoredUiSystemsAccumulator:
    fn apply_to_output(_self: &mut AuthoredUiSystemsAccumulator, output: &mut kain_ui::UiBuildOutput):
        for scope in (*_self).focus_scopes.iter().cloned():
            if (!(*output).systems.focus_graph.scopes.contains(&scope)):
                (*output).systems.focus_graph.scopes.push(scope)
                ()
        ()
        if (*output).systems.focus_graph.default_scope.is_none():
            (*output).systems.focus_graph.default_scope = (*_self).focus_default_scope.clone()
            ()
            ()
            ()
            ()
        for scope in (*_self).selection_scopes.iter().cloned():
            if (!(*output).systems.selection_model.scopes.contains(&scope)):
                (*output).systems.selection_model.scopes.push(scope)
                ()
        ()
        if (*output).systems.selection_model.active_scope.is_none():
            (*output).systems.selection_model.active_scope = (*_self).selection_default_scope.clone()
            ()
            ()
            ()
            ()
        for route in (*_self).event_routes.drain(range(0, 0)):
            (*output).systems.event_routes.push(route)
            ()
        ()
        for track in (*_self).animation_tracks.drain(range(0, 0)):
            (*output).systems.animation_tracks.push(track)
            ()
        ()
        for surface in (*_self).surfaces.drain(range(0, 0)):
            (*output).systems.surfaces.push(surface)
            ()
        ()
        for selfhost_for_item in std__mem__take(&mut (*_self).signal_values):
            let (id, value) = selfhost_for_item
            (*output).systems.signal_values.insert(id, value)
            ()
        ()
        for selfhost_for_item in std__mem__take(&mut (*_self).session_state):
            let (key, value) = selfhost_for_item
            (*output).systems.session_state.insert(key, value)
            ()
        ()
        let computed_specs = std__mem__take(&mut (*_self).computed_specs)
        if (!computed_specs.is_empty()):
            let node_ref_index = build_node_ref_index(output)
            let node_contract_index = build_node_contract_index(output)
            let mut computed_registry = Vec__new_()
            for spec in computed_specs:
                let resolved = resolve_authored_computed_spec(&spec, &node_ref_index)
                computed_registry.push(build_computed_contract_entry(&spec, &resolved, output, &node_contract_index))
                ()
                (*output).systems.computed.push(resolved)
                ()
            ()
            match serialize_contract_json(&computed_registry):
                Some(json) =>
                    (*output).systems.session_state.insert(("ui.contract.computed_registry.json").to_string(), kain_ui__UiValue::String(json))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        if (!(*output).systems.event_routes.is_empty()):
            let node_contract_index = build_node_contract_index(output)
            let event_routes = build_event_route_contracts(&(*output).systems.event_routes, output, &node_contract_index)
            match serialize_contract_json(&event_routes):
                Some(json) =>
                    (*output).systems.session_state.insert(("ui.contract.event_routes.json").to_string(), kain_ui__UiValue::String(json))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        match serialize_workspace_layout_contract(&(*output).systems.workspace_layout):
            Some(json) =>
                (*output).systems.session_state.insert(("ui.contract.workspace_layout.json").to_string(), kain_ui__UiValue::String(json))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).apply_workspace_contract(output)
        ()
        ensure_compiler_owned_ui_contract_version(output)
        ()
        (*_self).apply_compat_backfill(output)
        ()

    fn apply_workspace_contract(_self: &AuthoredUiSystemsAccumulator, output: &mut kain_ui::UiBuildOutput):
        if (*output).systems.workspace_layout.persistence_key.is_none():
            (*output).systems.workspace_layout.persistence_key = (*_self).workspace_persistence_key.clone()
            ()
            ()
            ()
            ()
        if (!(*output).systems.workspace_layout.virtualization_enabled):
            match (*_self).workspace_virtualization_enabled:
                Some(enabled) =>
                    (*output).systems.workspace_layout.virtualization_enabled = enabled
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        if (*output).systems.workspace_layout.roots.is_empty():
            let mut roots = Vec__new_()
            for node in (*output).tree.nodes.values():
                let Some(placement) = node.layout.dock
                roots.push(kain_ui::UiDockNode { id: node_layout_id(node), node: node.id, placement: placement, split_ratio: node.layout.split_ratio, children: node.children.clone(), persistent_layout_id: node.layout.persistent_layout_id.clone() })
                ()
            ()
            if (!roots.is_empty()):
                (*output).systems.workspace_layout.roots = roots
                ()
                ()
                ()
                ()
            ()
        if (*output).systems.workspace_layout.active_tabs.is_empty():
            (*output).systems.workspace_layout.active_tabs = resolve_active_tabs_from_tree(&(*output).tree)
            ()

    fn apply_compat_backfill(_self: &AuthoredUiSystemsAccumulator, output: &mut kain_ui::UiBuildOutput):
        let force_legacy_backfill = match (*output).systems.session_state.get("ui.runtime.force_compatibility_backfill"):
            Some(kain_ui__UiValue::Bool(true)) => true
            _ => false
        let has_authored_contract = (*output).systems.session_state.contains_key("ui.contract.version")
        let needs_legacy_backfill = (force_legacy_backfill || (((!has_authored_contract) && (!compiler_emitted_runtime_truth_exists(output)))))
        if (!needs_legacy_backfill):
            return
        (*output).systems.session_state.insert(("ui.runtime.compatibility_fallback").to_string(), kain_ui__UiValue::Bool(true))
        ()
        (*output).systems.session_state.insert(("ui.runtime.compatibility_mode").to_string(), kain_ui__UiValue::String(("legacy_tree_inference").to_string()))
        ()
        let inferred = kain_ui__ui_runtime_systems_from_tree(&(*output).tree)
        if (*output).systems.workspace_layout.roots.is_empty():
            (*output).systems.workspace_layout.roots = inferred.workspace_layout.roots
            ()
            ()
            ()
            ()
        if (*output).systems.workspace_layout.persistence_key.is_none():
            (*output).systems.workspace_layout.persistence_key = inferred.workspace_layout.persistence_key
            ()
            ()
            ()
            ()
        if (*output).systems.workspace_layout.active_tabs.is_empty():
            (*output).systems.workspace_layout.active_tabs = inferred.workspace_layout.active_tabs
            ()
            ()
            ()
            ()
        if ((*output).systems.focus_graph.scopes.is_empty() && (!inferred.focus_graph.scopes.is_empty())):
            (*output).systems.focus_graph = inferred.focus_graph
            ()
            ()
            ()
            ()
        if ((*output).systems.selection_model.scopes.is_empty() && (!inferred.selection_model.scopes.is_empty())):
            (*output).systems.selection_model = inferred.selection_model
            ()
            ()
            ()
            ()
        if ((*output).systems.surfaces.is_empty() && (!inferred.surfaces.is_empty())):
            (*output).systems.surfaces = inferred.surfaces
            ()
            ()
            ()
            ()
        if ((*output).systems.animation_tracks.is_empty() && (!inferred.animation_tracks.is_empty())):
            (*output).systems.animation_tracks = inferred.animation_tracks
            ()
            ()
            ()
            ()
        if ((*output).systems.theme_registry.scopes.is_empty() && (!inferred.theme_registry.scopes.is_empty())):
            (*output).systems.theme_registry = inferred.theme_registry
            ()


fn build_node_ref_index(output: &kain_ui::UiBuildOutput) -> Map<String, kain_ui::UiNodeId>:
    let mut index = HashMap__new_()
    for selfhost_for_item in &(*output).tree.nodes:
        let (id, node) = selfhost_for_item
        match node.identity_key:
            Some(key) =>
                let canonical = canonical_node_contract_key(key)
                index.insert(key.to_string(), (*id))
                ()
                index.insert(canonical.clone(), (*id))
                ()
                index.insert(f"ui.node::{canonical}", (*id))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match node.layout.persistent_layout_id:
            Some(persistent_layout_id) =>
                let canonical = canonical_node_contract_key(persistent_layout_id)
                index.insert(persistent_layout_id.to_string(), (*id))
                ()
                index.insert(canonical.clone(), (*id))
                ()
                index.insert(f"ui.node::{canonical}", (*id))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        let layout_id = node_layout_id(node)
        let canonical = canonical_node_contract_key(&layout_id)
        index.insert(layout_id.clone(), (*id))
        ()
        index.insert(canonical.clone(), (*id))
        ()
        index.insert(f"ui.node::{canonical}", (*id))
        ()
    ()
    index

fn resolve_authored_computed_spec(spec: &AuthoredComputedSpec, node_ref_index: &Map<String, kain_ui::UiNodeId>) -> kain_ui::UiComputed:
    let signal_index = resolve_signal_index_from_spec(spec)
    let depends_on = (*spec).depends_on.iter().map(fn(entry): resolve_signal_ref(entry)).collect()
    let writes_signal = (*spec).writes_signal.map(resolve_signal_ref).or_else(fn(): (*spec).expr.map(fn(_): resolve_signal_ref(&(*spec).id)))
    let expr = (*spec).expr.and_then(fn(expr): lower_authored_derived_expr(expr, &signal_index))
    let invalidates_nodes = (*spec).invalidates.iter().filter_map(fn(entry): parse_node_ref(entry, node_ref_index)).collect()
    kain_ui::UiComputed { id: (*spec).id.clone(), label: (*spec).label.clone(), depends_on: depends_on, writes_signal: writes_signal, expr: expr, invalidates_nodes: invalidates_nodes, scheduler_phase: (*spec).scheduler_phase }

fn resolve_signal_index_from_spec(spec: &AuthoredComputedSpec) -> Map<String, kain_ui::UiSignalId>:
    let mut index = HashMap__new_()
    for entry in &(*spec).depends_on:
        index.insert(canonical_signal_contract_key(entry), resolve_signal_ref(entry))
        ()
    ()
    match (*spec).writes_signal:
        Some(writes_signal) =>
            index.insert(canonical_signal_contract_key(writes_signal), resolve_signal_ref(writes_signal))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    index.insert(canonical_signal_contract_key(&(*spec).id), resolve_signal_ref(&(*spec).id))
    ()
    index

fn parse_node_ref(entry: String, identity_index: &Map<String, kain_ui::UiNodeId>) -> Option<kain_ui::UiNodeId>:
    let trimmed = entry.trim()
    match trimmed.parse():
        Ok(parsed) => return Option::Some(kain_ui__UiNodeId(parsed))
        _ =>
            ()
            ()
    let canonical = canonical_node_contract_key(trimmed)
    identity_index.get(trimmed).cloned().or_else(fn(): identity_index.get(&canonical).cloned()).or_else(fn(): identity_index.get(&f"ui.node::{canonical}").cloned())

fn resolve_signal_ref(entry: String) -> kain_ui::UiSignalId:
    let trimmed = entry.trim()
    match trimmed.parse():
        Ok(parsed) => return kain_ui__UiSignalId(parsed)
        _ =>
            ()
            ()
    kain_ui__UiSignalId(stable_hash_u64(&canonical_signal_contract_key(trimmed)))

fn canonical_signal_contract_key(entry: String) -> String:
    let trimmed = entry.trim()
    if trimmed.starts_with("ui.signal::"):
        trimmed.to_string()
    else:
        match trimmed.strip_prefix("ui.signal."):
            Some(rest) => f"ui.signal::{rest}"
            _ => f"ui.signal::{trimmed}"

fn canonical_node_contract_key(entry: String) -> String:
    let trimmed = entry.trim()
    if trimmed.starts_with("ui.node::"):
        trimmed.strip_prefix("ui.node::").unwrap_or(trimmed).to_string()
    else:
        match trimmed.strip_prefix("ui.node."):
            Some(rest) => rest.to_string()
            _ => trimmed.to_string()

fn build_node_contract_index(output: &kain_ui::UiBuildOutput) -> Map<kain_ui::UiNodeId, String>:
    let mut index = HashMap__new_()
    for node in (*output).tree.nodes.values():
        index.insert(node.id, stable_node_contract_key(node))
        ()
    ()
    index

fn stable_node_contract_key(node: &kain_ui::UiNode) -> String:
    f"ui.node::{canonical_node_contract_key(&node_layout_id(node))}"

fn ui_signal_contract_key(output: &kain_ui::UiBuildOutput, signal: kain_ui::UiSignalId) -> String:
    realtime_app_bundle__ui_session_state_string(output, &f"ui.signal.key.{signal.field_0}").unwrap_or_else(fn(): f"ui.signal::{signal.field_0}")

fn ui_node_contract_key(output: &kain_ui::UiBuildOutput, node_contract_index: &Map<kain_ui::UiNodeId, String>, node: kain_ui::UiNodeId) -> String:
    node_contract_index.get(&node).cloned().or_else(fn(): (*output).tree.nodes.get(&node).map(stable_node_contract_key)).unwrap_or_else(fn(): f"ui.node::node-{node.field_0}")

fn build_computed_contract_entry(spec: &AuthoredComputedSpec, resolved: &kain_ui::UiComputed, output: &kain_ui::UiBuildOutput, node_contract_index: &Map<kain_ui::UiNodeId, String>) -> serde_json::Value:
    let depends_on = (*resolved).depends_on.iter().map(fn(signal): ui_signal_contract_key(output, (*signal))).collect()
    let invalidates_nodes = (*resolved).invalidates_nodes.iter().map(fn(node): ui_node_contract_key(output, node_contract_index, (*node))).collect()
    let expr = (*spec).expr.map(render_authored_expr_contract)
    let runtime_expr = (*resolved).expr.map(fn(expr): render_runtime_derived_expr_contract(expr, output))
    serde_json::json!()

fn build_event_route_contracts(routes: &[kain_ui::UiEventRoute], output: &kain_ui::UiBuildOutput, node_contract_index: &Map<kain_ui::UiNodeId, String>) -> Array<serde_json::Value>:
    routes.iter().map(fn(route): none).collect()

fn serialize_contract_json(value: &[serde_json::Value]) -> Option<String>:
    serde_json__to_string_pretty(value).ok()

fn serialize_workspace_layout_contract(layout: &kain_ui::UiWorkspaceLayout) -> Option<String>:
    serde_json__to_string_pretty(layout).ok()

fn ensure_compiler_owned_ui_contract_version(output: &mut kain_ui::UiBuildOutput):
    if (*output).systems.session_state.contains_key("ui.contract.version"):
        return
    if (!compiler_emitted_runtime_truth_exists(output)):
        return
    (*output).systems.session_state.insert(("ui.contract.version").to_string(), kain_ui__UiValue::String(UI_AUTHORING_CONTRACT_VERSION.to_string()))
    ()

fn compiler_emitted_runtime_truth_exists(output: &kain_ui::UiBuildOutput) -> Bool:
    ((((((((((((((!(*output).systems.computed.is_empty()) || (!(*output).systems.event_routes.is_empty())) || (!(*output).systems.focus_graph.scopes.is_empty())) || (*output).systems.focus_graph.default_scope.is_some()) || (!(*output).systems.selection_model.scopes.is_empty())) || (*output).systems.selection_model.active_scope.is_some()) || (!(*output).systems.animation_tracks.is_empty())) || (!(*output).systems.surfaces.is_empty())) || (!theme_registry_is_empty(&(*output).systems.theme_registry))) || (!(*output).systems.workspace_layout.roots.is_empty())) || (*output).systems.workspace_layout.persistence_key.is_some()) || (*output).systems.workspace_layout.virtualization_enabled) || (!(*output).systems.workspace_layout.active_tabs.is_empty())) || (*output).systems.session_state.keys().any(fn(key): (key.starts_with("ui.contract.") || key.starts_with("ui.event.route."))))

pub fn render_authored_expr_contract(expr: &Expr) -> String:
    match expr:
        Expr::Int(value, _) => value.to_string()
        Expr::Float(value, _) => value.to_string()
        Expr::String(value, _) => serde_json__to_string(value).unwrap_or_else(fn(_): f"\"{value}\"")
        Expr::Bool(value, _) => value.to_string()
        Expr::None(_) => ("null").to_string()
        Expr::Ident(name, _) => name.clone()
        Expr::Paren(inner, _) => f"({render_authored_expr_contract(inner)})"
        Expr::Unary { op: UnaryOp::Not, operand: operand } => f"!{render_authored_expr_contract(operand)}"
        Expr::Binary { left: left, op: BinaryOp::Add, right: right } => f"({render_authored_expr_contract(left)} + {render_authored_expr_contract(right)})"
        Expr::Binary { left: left, op: BinaryOp::Sub, right: right } => f"({render_authored_expr_contract(left)} - {render_authored_expr_contract(right)})"
        Expr::Binary { left: left, op: BinaryOp::Mul, right: right } => f"({render_authored_expr_contract(left)} * {render_authored_expr_contract(right)})"
        Expr::Binary { left: left, op: BinaryOp::Div, right: right } => f"({render_authored_expr_contract(left)} / {render_authored_expr_contract(right)})"
        Expr::Binary { left: left, op: BinaryOp::Eq, right: right } => f"({render_authored_expr_contract(left)} == {render_authored_expr_contract(right)})"
        Expr::Binary { left: left, op: BinaryOp::Ne, right: right } => f"({render_authored_expr_contract(left)} != {render_authored_expr_contract(right)})"
        Expr::Binary { left: left, op: BinaryOp::And, right: right } => f"({render_authored_expr_contract(left)} && {render_authored_expr_contract(right)})"
        Expr::Binary { left: left, op: BinaryOp::Or, right: right } => f"({render_authored_expr_contract(left)} || {render_authored_expr_contract(right)})"
        Expr::Call { callee: callee, args: args } =>
            let callee_text = render_authored_expr_contract(callee)
            let rendered_args = args.iter().map(render_authored_call_arg_contract).collect().join(", ")
            f"{callee_text}({rendered_args})"
        Expr::StageCall { runtime: runtime, function: function, args: args } =>
            let rendered_args = args.iter().map(render_authored_call_arg_contract).collect().join(", ")
            f"{runtime.as_str()} {function}({rendered_args})"
        Expr::MethodCall { receiver: receiver, method: method, args: args } =>
            let rendered_args = args.iter().map(render_authored_call_arg_contract).collect().join(", ")
            f"{render_authored_expr_contract(receiver)}.{method}({rendered_args})"
        Expr::Field { object: object, field: field } => f"{render_authored_expr_contract(object)}.{field}"
        Expr::Index { object: object, index: index } => f"{render_authored_expr_contract(object)}[{render_authored_expr_contract(index)}]"
        Expr::Lambda { params: params, body: body } =>
            let rendered_params = params.iter().map(fn(param): param.name.clone()).collect().join(", ")
            f"|{rendered_params}| {render_authored_expr_contract(body)}"
        Expr::Unary {  } => expr
        Expr::Binary {  } => expr
        Expr::FString(_, _) => expr
        Expr::MacroCall {  } => expr
        Expr::Assign {  } => expr
        Expr::Struct {  } => expr
        Expr::AggregateInit {  } => expr
        Expr::EnumVariant {  } => expr
        Expr::Array(_, _) => expr
        Expr::Tuple(_, _) => expr
        Expr::Range {  } => expr
        Expr::If {  } => expr
        Expr::Match {  } => expr
        Expr::Ref {  } => expr
        Expr::AddrOf {  } => expr
        Expr::Deref(_, _) => expr
        Expr::PtrOffset {  } => expr
        Expr::MemLoad {  } => expr
        Expr::MemStore {  } => expr
        Expr::SizeOfType {  } => expr
        Expr::AlignOfType {  } => expr
        Expr::Alloca {  } => expr
        Expr::Uninit {  } => expr
        Expr::Alloc {  } => expr
        Expr::Realloc {  } => expr
        Expr::Cast {  } => expr
        Expr::Try(_, _) => expr
        Expr::Await(_, _) => expr
        Expr::AsyncBlock(_, _) => expr
        Expr::Spawn {  } => expr
        Expr::SendMsg {  } => expr
        Expr::Comptime(_, _) => expr
        Expr::Block(_, _) => expr
        Expr::JSX(_, _) => expr
        Expr::Return(_, _) => expr
        Expr::Break(_, _) => expr
        Expr::Continue(_) => expr

fn render_authored_call_arg_contract(arg: &CallArg) -> String:
    match (*arg).name:
        Some(name) => f"{name}: {render_authored_expr_contract(&(*arg).value)}"
        None => render_authored_expr_contract(&(*arg).value)

fn authored_signal_contract_path(expr: &Expr) -> Option<String>:
    match expr:
        Expr::Ident(name, _) => Option::Some(name.clone())
        Expr::Field { object: object, field: field } => authored_signal_contract_path(object).map(fn(prefix): f"{prefix}.{field}")
        Expr::Index { object: object, index: index } => authored_signal_contract_path(object).and_then(fn(prefix): none)
        Expr::Paren(inner, _) => authored_signal_contract_path(inner)
        _ => none

fn render_runtime_derived_expr_contract(expr: &kain_ui::UiDerivedExpr, output: &kain_ui::UiBuildOutput) -> String:
    match expr:
        kain_ui__UiDerivedExpr::Literal(value) => render_ui_value_contract(value)
        kain_ui__UiDerivedExpr::Signal(signal) => ui_signal_contract_key(output, (*signal))
        kain_ui__UiDerivedExpr::Not(inner) => f"!{render_runtime_derived_expr_contract(inner, output)}"
        kain_ui__UiDerivedExpr::And(left, right) => f"({render_runtime_derived_expr_contract(left, output)} && {render_runtime_derived_expr_contract(right, output)})"
        kain_ui__UiDerivedExpr::Or(left, right) => f"({render_runtime_derived_expr_contract(left, output)} || {render_runtime_derived_expr_contract(right, output)})"
        kain_ui__UiDerivedExpr::Eq(left, right) => f"({render_runtime_derived_expr_contract(left, output)} == {render_runtime_derived_expr_contract(right, output)})"
        kain_ui__UiDerivedExpr::Add(left, right) => f"({render_runtime_derived_expr_contract(left, output)} + {render_runtime_derived_expr_contract(right, output)})"
        kain_ui__UiDerivedExpr::Sub(left, right) => f"({render_runtime_derived_expr_contract(left, output)} - {render_runtime_derived_expr_contract(right, output)})"
        kain_ui__UiDerivedExpr::Mul(left, right) => f"({render_runtime_derived_expr_contract(left, output)} * {render_runtime_derived_expr_contract(right, output)})"
        kain_ui__UiDerivedExpr::Div(left, right) => f"({render_runtime_derived_expr_contract(left, output)} / {render_runtime_derived_expr_contract(right, output)})"
        kain_ui__UiDerivedExpr::ToString(inner) => f"to_string({render_runtime_derived_expr_contract(inner, output)})"

fn render_ui_value_contract(value: &kain_ui::UiValue) -> String:
    match value:
        kain_ui__UiValue::Null => ("null").to_string()
        kain_ui__UiValue::Bool(value) => value.to_string()
        kain_ui__UiValue::Int(value) => value.to_string()
        kain_ui__UiValue::Float(value) => value.to_string()
        kain_ui__UiValue::String(value) => serde_json__to_string(value).unwrap_or_else(fn(_): f"\"{value}\"")

fn lower_authored_derived_expr(expr: &Expr, signal_index: &Map<String, kain_ui::UiSignalId>) -> Option<kain_ui::UiDerivedExpr>:
    match expr:
        Expr::Int(value, _) => Option::Some(kain_ui__UiDerivedExpr::Literal(kain_ui__UiValue::Int((*value))))
        Expr::Float(value, _) => Option::Some(kain_ui__UiDerivedExpr::Literal(kain_ui__UiValue::Float((*value))))
        Expr::String(value, _) => Option::Some(kain_ui__UiDerivedExpr::Literal(kain_ui__UiValue::String(value.clone())))
        Expr::Bool(value, _) => Option::Some(kain_ui__UiDerivedExpr::Literal(kain_ui__UiValue::Bool((*value))))
        Expr::None(_) => Option::Some(kain_ui__UiDerivedExpr::Literal(kain_ui__UiValue__Null))
        Expr::Ident(_) => authored_signal_contract_path(expr).and_then(fn(signal_name): signal_index.get(&canonical_signal_contract_key(&signal_name)).cloned().map(kain_ui__UiDerivedExpr__Signal))
        Expr::Field {  } => authored_signal_contract_path(expr).and_then(fn(signal_name): signal_index.get(&canonical_signal_contract_key(&signal_name)).cloned().map(kain_ui__UiDerivedExpr__Signal))
        Expr::Index {  } => authored_signal_contract_path(expr).and_then(fn(signal_name): signal_index.get(&canonical_signal_contract_key(&signal_name)).cloned().map(kain_ui__UiDerivedExpr__Signal))
        Expr::Paren(inner, _) => lower_authored_derived_expr(inner, signal_index)
        Expr::Unary { op: UnaryOp::Not, operand: operand } => lower_authored_derived_expr(operand, signal_index).map(fn(expr): kain_ui__UiDerivedExpr::Not(Box__new_(expr)))
        Expr::Binary { left: left, op: BinaryOp::And, right: right } => Option::Some(kain_ui__UiDerivedExpr::And(Box__new_(lower_authored_derived_expr(left, signal_index)?), Box__new_(lower_authored_derived_expr(right, signal_index)?)))
        Expr::Binary { left: left, op: BinaryOp::Or, right: right } => Option::Some(kain_ui__UiDerivedExpr::Or(Box__new_(lower_authored_derived_expr(left, signal_index)?), Box__new_(lower_authored_derived_expr(right, signal_index)?)))
        Expr::Binary { left: left, op: BinaryOp::Eq, right: right } => Option::Some(kain_ui__UiDerivedExpr::Eq(Box__new_(lower_authored_derived_expr(left, signal_index)?), Box__new_(lower_authored_derived_expr(right, signal_index)?)))
        Expr::Binary { left: left, op: BinaryOp::Ne, right: right } => Option::Some(kain_ui__UiDerivedExpr::Not(Box__new_(kain_ui__UiDerivedExpr::Eq(Box__new_(lower_authored_derived_expr(left, signal_index)?), Box__new_(lower_authored_derived_expr(right, signal_index)?)))))
        Expr::Binary { left: left, op: BinaryOp::Add, right: right } => Option::Some(kain_ui__UiDerivedExpr::Add(Box__new_(lower_authored_derived_expr(left, signal_index)?), Box__new_(lower_authored_derived_expr(right, signal_index)?)))
        Expr::Binary { left: left, op: BinaryOp::Sub, right: right } => Option::Some(kain_ui__UiDerivedExpr::Sub(Box__new_(lower_authored_derived_expr(left, signal_index)?), Box__new_(lower_authored_derived_expr(right, signal_index)?)))
        Expr::Binary { left: left, op: BinaryOp::Mul, right: right } => Option::Some(kain_ui__UiDerivedExpr::Mul(Box__new_(lower_authored_derived_expr(left, signal_index)?), Box__new_(lower_authored_derived_expr(right, signal_index)?)))
        Expr::Binary { left: left, op: BinaryOp::Div, right: right } => Option::Some(kain_ui__UiDerivedExpr::Div(Box__new_(lower_authored_derived_expr(left, signal_index)?), Box__new_(lower_authored_derived_expr(right, signal_index)?)))
        Expr::Call { callee: callee, args: args } =>
            match callee:
                Expr::Ident(name, _) =>
                    if ((((name == "to_string") || (name == "string"))) && (args.len() == 1)):
                        return lower_authored_derived_expr(&args[0].value, signal_index).map(fn(expr): kain_ui__UiDerivedExpr::ToString(Box__new_(expr)))
                    if ((name == "signal") && (args.len() == 1)):
                        match &args[0].value:
                            Expr::String(signal_name, _) => return signal_index.get(&canonical_signal_contract_key(signal_name)).cloned().map(kain_ui__UiDerivedExpr__Signal)
                            _ =>
                                ()
                                ()
                        ()
                    ()
                _ =>
                    ()
                    ()
            none
        Expr::MethodCall { receiver: receiver, method: method, args: args } if (args.is_empty() && (((method == "to_string") || (method == "toString")))) => lower_authored_derived_expr(receiver, signal_index).map(fn(expr): kain_ui__UiDerivedExpr::ToString(Box__new_(expr)))
        _ => none

fn stable_hash_u64(input: String) -> u64:
    const OFFSET_BASIS: u64 = 0

    const PRIME: u64 = 1099511628211

    let mut hash = OFFSET_BASIS
    for byte in input.as_bytes():
        hash = (hash ^ u64__from((*byte)))
        ()
        hash = hash.wrapping_mul(PRIME)
        ()
    ()
    hash

fn lower_vnode_into_tree(lowering: &mut UiLowering, node: &VNode) -> Option<kain_ui::UiNodeId>:
    match node:
        VNode::Text(text) =>
            let id = (*lowering).builder.alloc_id()
            let mut ui_node = UiNode__new_(id, kain_ui__UiWidgetKind__Text)
            ui_node.props.insert(("text").to_string(), kain_ui__UiValue::String(text.clone()))
            ()
            (*lowering).builder.add_node(ui_node)
            ()
            Option::Some(id)
        VNode::Fragment(children) =>
            let child_ids = children.iter().filter_map(fn(child): lower_vnode_into_tree(lowering, child)).collect()
            let id = (*lowering).builder.alloc_id()
            let mut ui_node = UiNode__new_(id, kain_ui__UiWidgetKind__Slot)
            ui_node.layout = kain_ui__default_layout_for_tag("slot")
            ()
            ui_node.children = child_ids.clone()
            ()
            (*lowering).builder.add_node(ui_node)
            ()
            if (!child_ids.is_empty()):
                (*lowering).builder.replace_children(id, child_ids)
                ()
                ()
                ()
                ()
            Option::Some(id)
        VNode::Element { tag: tag, attrs: attrs, children: children, key: key } =>
            if tag.eq_ignore_ascii_case("theme"):
                extract_theme_block(&mut (*lowering).authored_theme, attrs, children)
                ()
                return none
            if tag.eq_ignore_ascii_case("signal"):
                extract_signal_decl(&mut (*lowering).authored_systems, attrs)
                ()
                return none
            if tag.eq_ignore_ascii_case("computed"):
                extract_computed_decl(&mut (*lowering).authored_systems, attrs)
                ()
                return none
            if tag.eq_ignore_ascii_case("workspace"):
                extract_workspace_decl(&mut (*lowering).authored_systems, attrs)
                ()
                return none
            if tag.eq_ignore_ascii_case("focus_scope"):
                extract_focus_scope_decl(&mut (*lowering).authored_systems, attrs)
                ()
                return none
            if tag.eq_ignore_ascii_case("selection_scope"):
                extract_selection_scope_decl(&mut (*lowering).authored_systems, attrs)
                ()
                return none
            if tag.eq_ignore_ascii_case("text"):
                return Option::Some(lower_text_element(lowering, attrs, children, key))
            let child_ids = children.iter().filter_map(fn(child): lower_vnode_into_tree(lowering, child)).collect()
            let id = (*lowering).builder.alloc_id()
            let mut ui_node = UiNode__new_(id, kain_ui__widget_kind_for_tag(tag))
            ui_node.layout = layout_from_attrs(tag, attrs)
            ()
            ui_node.children = child_ids.clone()
            ()
            ui_node.props.insert(("tag").to_string(), kain_ui__UiValue::String(tag.clone()))
            ()
            match key:
                Some(key) =>
                    ui_node.identity_key = Option::Some(key.clone())
                    ()
                    ui_node.props.insert(("key").to_string(), kain_ui__UiValue::String(key.clone()))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            apply_canonical_attrs_to_ui_node(&mut ui_node, tag, attrs)
            ()
            (*lowering).authored_systems.record_authored_semantics_for_node(id, &ui_node, attrs)
            ()
            apply_attrs_to_ui_props(&mut ui_node.props, attrs)
            ()
            (*lowering).builder.add_node(ui_node)
            ()
            if (!child_ids.is_empty()):
                (*lowering).builder.replace_children(id, child_ids)
                ()
                ()
                ()
                ()
            Option::Some(id)
        VNode::Component { instance: instance, rendered: rendered } =>
            let rendered_id = lower_vnode_into_tree(lowering, rendered)
            let id = (*lowering).builder.alloc_id()
            let mut ui_node = UiNode__new_(id, kain_ui__UiWidgetKind::ComponentRef(instance.name.clone()))
            match rendered_id:
                Some(rendered_id) =>
                    ui_node.children = [rendered_id]
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            for selfhost_for_item in &instance.props:
                let (name, value) = selfhost_for_item
                ui_node.props.insert(name.clone(), runtime_value_to_ui_value(value))
                ()
            ()
            (*lowering).authored_systems.record_component_state_signals(id, &instance.name, &instance.props, &instance.state_, &mut ui_node)
            ()
            (*lowering).builder.add_node(ui_node)
            ()
            match rendered_id:
                Some(rendered_id) =>
                    (*lowering).builder.replace_children(id, [rendered_id])
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            Option::Some(id)

fn apply_attrs_to_ui_props(props: &mut Map<String, kain_ui::UiValue>, attrs: &[UIAttr]):
    for attr in attrs:
        match attr:
            UIAttr::Property { name: name, value: value } =>
                if should_skip_prop_attr(name):
                    continue
                props.insert(name.clone(), runtime_value_to_ui_value(value))
                ()
            UIAttr::Bool { name: name, value: value } =>
                if should_skip_prop_attr(name):
                    continue
                props.insert(name.clone(), kain_ui__UiValue::Bool((*value)))
                ()
            UIAttr::Event {  } => ()

fn lower_text_element(lowering: &mut UiLowering, attrs: &[UIAttr], children: &[VNode], key: &Option<String>) -> kain_ui::UiNodeId:
    let id = (*lowering).builder.alloc_id()
    let mut ui_node = UiNode__new_(id, kain_ui__UiWidgetKind__Text)
    ui_node.layout = layout_from_attrs("text", attrs)
    ()
    match key:
        Some(key) =>
            ui_node.props.insert(("key").to_string(), kain_ui__UiValue::String(key.clone()))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    ui_node.props.insert(("text").to_string(), kain_ui__UiValue::String(render_text_children(children)))
    ()
    apply_canonical_attrs_to_ui_node(&mut ui_node, "text", attrs)
    ()
    apply_attrs_to_ui_props(&mut ui_node.props, attrs)
    ()
    (*lowering).builder.add_node(ui_node)
    ()
    id

fn allocate_empty_root(builder: &mut kain_ui::UiTreeBuilder) -> kain_ui::UiNodeId:
    let id = builder.alloc_id()
    let mut ui_node = UiNode__new_(id, kain_ui__UiWidgetKind__Slot)
    ui_node.layout = kain_ui__default_layout_for_tag("slot")
    ()
    builder.add_node(ui_node)
    ()
    id

fn layout_from_attrs(tag: String, attrs: &[UIAttr]) -> kain_ui::UiLayoutSpec:
    let mut layout = kain_ui__default_layout_for_tag(tag)
    for attr in attrs:
        match attr:
            UIAttr::Property { name: name, value: value } if (name == "layout") =>
                match value:
                    Value::String(name) =>
                        match parse_layout_kind(name):
                            Some(kind) =>
                                layout.kind = kind
                                ()
                            _ => ()
                    _ => ()
            UIAttr::Property { name: name, value: value } if (name == "gap") =>
                layout.gap = runtime_value_to_f32(value).unwrap_or(layout.gap)
                ()
            UIAttr::Property { name: name, value: value } if (name == "padding") =>
                layout.padding = runtime_value_to_f32(value).unwrap_or(layout.padding)
                ()
            UIAttr::Property { name: name, value: value } if (name == "min_width") =>
                layout.min_width = runtime_value_to_f32(value).or_(layout.min_width)
                ()
            UIAttr::Property { name: name, value: value } if (name == "min_height") =>
                layout.min_height = runtime_value_to_f32(value).or_(layout.min_height)
                ()
            UIAttr::Property { name: name, value: value } if (name == "max_width") =>
                layout.max_width = runtime_value_to_f32(value).or_(layout.max_width)
                ()
            UIAttr::Property { name: name, value: value } if (name == "max_height") =>
                layout.max_height = runtime_value_to_f32(value).or_(layout.max_height)
                ()
            UIAttr::Property { name: name, value: value } if (name == "width") =>
                layout.width = parse_ui_length_value(value).or_(layout.width)
                ()
            UIAttr::Property { name: name, value: value } if (name == "height") =>
                layout.height = parse_ui_length_value(value).or_(layout.height)
                ()
            UIAttr::Property { name: name, value: value } if (name == "flex_grow") =>
                layout.flex_grow = runtime_value_to_f32(value).unwrap_or(layout.flex_grow)
                ()
            UIAttr::Property { name: name, value: value } if (name == "flex_shrink") =>
                layout.flex_shrink = runtime_value_to_f32(value).unwrap_or(layout.flex_shrink)
                ()
            UIAttr::Property { name: name, value: value } if ((name == "align") || (name == "align_items")) =>
                match value_as_str(value).and_then(parse_layout_alignment):
                    Some(alignment) =>
                        layout.align_items = alignment
                        ()
                    _ => ()
            UIAttr::Property { name: name, value: value } if ((name == "justify") || (name == "justify_content")) =>
                match value_as_str(value).and_then(parse_layout_alignment):
                    Some(alignment) =>
                        layout.justify_content = alignment
                        ()
                    _ => ()
            UIAttr::Property { name: name, value: value } if (name == "overflow") =>
                match value_as_str(value).and_then(parse_overflow_behavior):
                    Some(behavior) =>
                        layout.overflow_x = behavior
                        ()
                        layout.overflow_y = behavior
                        ()
                    _ => ()
            UIAttr::Property { name: name, value: value } if (name == "overflow_x") =>
                match value_as_str(value).and_then(parse_overflow_behavior):
                    Some(behavior) =>
                        layout.overflow_x = behavior
                        ()
                    _ => ()
            UIAttr::Property { name: name, value: value } if (name == "overflow_y") =>
                match value_as_str(value).and_then(parse_overflow_behavior):
                    Some(behavior) =>
                        layout.overflow_y = behavior
                        ()
                    _ => ()
            UIAttr::Property { name: name, value: value } if (name == "dock") =>
                layout.dock = value_as_str(value).and_then(parse_dock_placement).or_(layout.dock)
                ()
            UIAttr::Property { name: name, value: value } if (name == "split_ratio") =>
                layout.split_ratio = runtime_value_to_f32(value).or_(layout.split_ratio)
                ()
            UIAttr::Property { name: name, value: value } if (name == "persistent_layout_id") =>
                layout.persistent_layout_id = value_as_str(value).map(ToString__to_string)
                ()
            UIAttr::Property { name: name, value: value } if (name == "tab_group_id") =>
                layout.tab_group_id = value_as_str(value).map(ToString__to_string)
                ()
            UIAttr::Property { name: name, value: value } if (name == "tab_label") =>
                layout.tab_label = value_as_str(value).map(ToString__to_string)
                ()
            UIAttr::Property { name: name, value: value } if (name == "tab_order") =>
                layout.tab_order = runtime_value_to_i32(value).or_(layout.tab_order)
                ()
            UIAttr::Bool { name: name, value: value } if (name == "tab_default_active") =>
                layout.tab_default_active = (*value)
                ()
            UIAttr::Property { name: name, value: value } if (name == "tab_default_active") =>
                match value_as_bool(value):
                    Some(value) =>
                        layout.tab_default_active = value
                        ()
                    _ => ()
            UIAttr::Bool { name: name, value: value } if (name == "tab_closable") =>
                layout.tab_closable = (*value)
                ()
            UIAttr::Property { name: name, value: value } if (name == "tab_closable") =>
                match value_as_bool(value):
                    Some(value) =>
                        layout.tab_closable = value
                        ()
                    _ => ()
            UIAttr::Bool { name: name, value: value } if (name == "resizable") =>
                layout.resizable = (*value)
                ()
            UIAttr::Property { name: name, value: value } if (name == "resizable") =>
                match value_as_bool(value):
                    Some(value) =>
                        layout.resizable = value
                        ()
                    _ => ()
            _ => ()
    ()
    layout

fn apply_canonical_attrs_to_ui_node(node: &mut kain_ui::UiNode, tag: String, attrs: &[UIAttr]):
    match attr_string(attrs, "identity_key").or_else(fn(): attr_string(attrs, "identity")).or_else(fn(): attr_string(attrs, "id")):
        Some(identity) =>
            (*node).identity_key = Option::Some(identity)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match attr_string(attrs, "focus_scope"):
        Some(scope) =>
            (*node).focus_scope = Option::Some(scope)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match attr_string(attrs, "selection_scope"):
        Some(scope) =>
            (*node).selection_scope = Option::Some(scope)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match attr_string(attrs, "chrome_role"):
        Some(role) =>
            (*node).props.insert(("ui.chrome_role").to_string(), kain_ui__UiValue::String(role))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match attr_string(attrs, "anchor_zone").or_else(fn(): attr_string(attrs, "anchor")):
        Some(zone) =>
            (*node).props.insert(("ui.anchor_zone").to_string(), kain_ui__UiValue::String(zone))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match attr_string(attrs, "anchor_target"):
        Some(target) =>
            (*node).props.insert(("ui.anchor_target").to_string(), kain_ui__UiValue::String(target))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match attr_string(attrs, "scope").or_else(fn(): attr_string(attrs, "theme_scope")):
        Some(scope) =>
            (*node).style.theme_scope = Option::Some(scope)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match attr_string(attrs, "variant"):
        Some(variant) =>
            (*node).style.variant = Option::Some(variant)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    (*node).style.classes.extend(attr_list(attrs, &["class", "classes"]))
    ()
    (*node).style.tokens.extend(attr_list(attrs, &["tokens"]))
    ()
    for state_ in attr_list(attrs, &["states"]):
        match parse_style_state(&state_):
            Some(parsed) =>
                if (!(*node).style.states.contains(&parsed)):
                    (*node).style.states.push(parsed)
                    ()
            _ => ()
    ()
    match attr_string(attrs, "role"):
        Some(role) =>
            (*node).props.insert(("role").to_string(), kain_ui__UiValue::String(role.clone()))
            ()
            if (tag.eq_ignore_ascii_case("text") && (*node).style.variant.is_none()):
                (*node).style.variant = Option::Some(role)
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    for attr in attrs:
        let UIAttr::Property { name: name, value: value } = attr
        match name.strip_prefix("style_"):
            Some(key) =>
                (*node).style.values.insert(normalize_style_key(key), runtime_value_to_ui_value(value))
                ()
                continue
            _ =>
                ()
                ()
        match name.strip_prefix("paint_"):
            Some(key) =>
                (*node).style.values.insert(f"paint.{normalize_style_key(key)}", runtime_value_to_ui_value(value))
                ()
                continue
            _ => ()

fn normalize_style_key(input: String) -> String:
    input.replace("_", ".")

fn should_skip_prop_attr(name: String) -> Bool:
    if ((name.starts_with("style_") || name.starts_with("paint_")) || name.starts_with("motion_")):
        return true
    match name:
        "layout" => true
        "gap" => true
        "padding" => true
        "min_width" => true
        "min_height" => true
        "max_width" => true
        "max_height" => true
        "width" => true
        "height" => true
        "flex_grow" => true
        "flex_shrink" => true
        "align" => true
        "align_items" => true
        "justify" => true
        "justify_content" => true
        "overflow" => true
        "overflow_x" => true
        "overflow_y" => true
        "dock" => true
        "split_ratio" => true
        "resizable" => true
        "persistent_layout_id" => true
        "tab_group_id" => true
        "tab_label" => true
        "tab_order" => true
        "tab_default_active" => true
        "tab_closable" => true
        "scope" => true
        "theme_scope" => true
        "variant" => true
        "class" => true
        "classes" => true
        "tokens" => true
        "states" => true
        "role" => true
        "id" => true
        "identity" => true
        "identity_key" => true
        "key" => true
        "focus_scope" => true
        "selection_scope" => true
        "focus_scope_default" => true
        "selection_scope_default" => true
        "event_phase" => true
        "command" => true
        "transaction" => true
        "chrome_role" => true
        "anchor_zone" => true
        "anchor" => true
        "anchor_target" => true
        _ => false

fn extract_signal_decl(systems: &mut AuthoredUiSystemsAccumulator, attrs: &[UIAttr]):
    let Some(id) = attr_string(attrs, "id").or_else(fn(): attr_string(attrs, "name"))
    let initial = attr_value(attrs, "initial").or_else(fn(): attr_value(attrs, "value")).map(runtime_value_to_ui_value).unwrap_or(kain_ui__UiValue__Null)
    let signal_key = f"ui.signal::{id}"
    let signal_id = kain_ui__UiSignalId(stable_hash_u64(&signal_key))
    (*systems).signal_values.insert(signal_id, initial)
    ()
    (*systems).session_state.insert(f"ui.signal.key.{signal_id.field_0}", kain_ui__UiValue::String(signal_key))
    ()

fn extract_computed_decl(systems: &mut AuthoredUiSystemsAccumulator, attrs: &[UIAttr]):
    let Some(id) = attr_string(attrs, "id")
    let label = attr_string(attrs, "label").unwrap_or_else(fn(): id.clone())
    let depends_on = attr_list(attrs, &["depends_on", "depends", "signals"])
    let writes_signal = attr_string_any(attrs, &["writes_signal", "signal", "target_signal", "output_signal", "output"])
    let expr = attr_expr(attrs, &["expr", "value", "derived", "expression"]).cloned()
    let invalidates = attr_list(attrs, &["invalidates_nodes", "invalidates", "nodes"])
    let scheduler_phase = attr_string(attrs, "phase").and_then(parse_scheduler_phase).unwrap_or(kain_ui__UiSchedulerPhase__Signals)
    (*systems).computed_specs.push(AuthoredComputedSpec { id: id, label: label, depends_on: depends_on, writes_signal: writes_signal, expr: expr, invalidates: invalidates, scheduler_phase: scheduler_phase })
    ()

fn extract_workspace_decl(systems: &mut AuthoredUiSystemsAccumulator, attrs: &[UIAttr]):
    match attr_string(attrs, "persistence_key").or_else(fn(): attr_string(attrs, "layout_key")).or_else(fn(): attr_string(attrs, "workspace_key")):
        Some(key) =>
            (*systems).workspace_persistence_key = Option::Some(key)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match attr_value(attrs, "virtualization_enabled").and_then(value_as_bool).or_else(fn(): attr_value(attrs, "virtualize").and_then(value_as_bool)):
        Some(enabled) =>
            (*systems).workspace_virtualization_enabled = Option::Some(enabled)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match attr_string(attrs, "preset"):
        Some(preset) =>
            (*systems).session_state.insert(("ui.workspace.preset").to_string(), kain_ui__UiValue::String(preset))
            ()
        _ => ()

fn parse_scheduler_phase(input: String) -> Option<kain_ui::UiSchedulerPhase>:
    match input.trim().to_ascii_lowercase().as_str():
        "signals" => Option::Some(kain_ui__UiSchedulerPhase__Signals)
        "resources" => Option::Some(kain_ui__UiSchedulerPhase__Resources)
        "layout" => Option::Some(kain_ui__UiSchedulerPhase__Layout)
        "animation" => Option::Some(kain_ui__UiSchedulerPhase__Animation)
        "patches" => Option::Some(kain_ui__UiSchedulerPhase__Patches)
        "effects" => Option::Some(kain_ui__UiSchedulerPhase__Effects)
        _ => none

fn node_layout_id(node: &kain_ui::UiNode) -> String:
    (*node).layout.persistent_layout_id.clone().or_else(fn(): (*node).identity_key.clone()).unwrap_or_else(fn(): f"node-{(*node).id.field_0}")

fn resolve_active_tabs_from_tree(tree: &kain_ui::UiTree) -> Map<String, String>:
    let mut grouped_tabs = BTreeMap__new_()
    let mut resolved = BTreeMap__new_()
    for node in (*tree).nodes.values():
        let Some(group_id) = node.layout.tab_group_id.clone()
        grouped_tabs.entry(group_id).or_default().push((node, node_layout_id(node)))
        ()
    ()
    for selfhost_for_item in grouped_tabs:
        let (group_id, mut tabs) = selfhost_for_item
        tabs.sort_by_key(fn(__kain_closure_arg0): (__kain_closure_arg0.__kain_tuple_0.layout.tab_order.unwrap_or(i32__MAX), __kain_closure_arg0.__kain_tuple_0.id.field_0))
        ()
        match tabs.iter().find(fn(__kain_closure_arg1): __kain_closure_arg1.__kain_tuple_0.layout.tab_default_active).or_else(fn(): tabs.first()).map(fn(__kain_closure_arg2): __kain_closure_arg2.__kain_tuple_1.clone()):
            Some(layout_id) =>
                resolved.insert(group_id, layout_id)
                ()
            _ => ()
    ()
    resolved

fn extract_focus_scope_decl(systems: &mut AuthoredUiSystemsAccumulator, attrs: &[UIAttr]):
    let Some(name) = attr_string(attrs, "name")
    (*systems).focus_scopes.insert(name.clone())
    ()
    let is_default = attr_string(attrs, "default").and_then(fn(value): value.parse().ok()).unwrap_or(false)
    if is_default:
        (*systems).focus_default_scope = Option::Some(name)
        ()

fn extract_selection_scope_decl(systems: &mut AuthoredUiSystemsAccumulator, attrs: &[UIAttr]):
    let Some(name) = attr_string(attrs, "name")
    (*systems).selection_scopes.insert(name.clone())
    ()
    let is_default = attr_string(attrs, "default").and_then(fn(value): value.parse().ok()).unwrap_or(false)
    if is_default:
        (*systems).selection_default_scope = Option::Some(name)
        ()

impl AuthoredUiSystemsAccumulator:
    fn record_authored_semantics_for_node(_self: &mut AuthoredUiSystemsAccumulator, id: kain_ui::UiNodeId, node: &kain_ui::UiNode, attrs: &[UIAttr]):
        match (*node).focus_scope:
            Some(scope) =>
                (*_self).focus_scopes.insert(scope.to_string())
                ()
                if attr_string(attrs, "focus_scope_default").and_then(fn(value): value.parse().ok()).unwrap_or(false):
                    (*_self).focus_default_scope = Option::Some(scope.to_string())
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                ()
                ()
        match (*node).selection_scope:
            Some(scope) =>
                (*_self).selection_scopes.insert(scope.to_string())
                ()
                if attr_string(attrs, "selection_scope_default").and_then(fn(value): value.parse().ok()).unwrap_or(false):
                    (*_self).selection_default_scope = Option::Some(scope.to_string())
                    ()
                    ()
                    ()
                    ()
                ()
            _ =>
                ()
                ()
        (*_self).record_event_routes_and_handlers(id, node, attrs)
        ()
        (*_self).record_motion_tracks(id, node, attrs)
        ()
        (*_self).record_surface_decl(id, node, attrs)
        ()

    fn record_event_routes_and_handlers(_self: &mut AuthoredUiSystemsAccumulator, id: kain_ui::UiNodeId, node: &kain_ui::UiNode, attrs: &[UIAttr]):
        let phase = match attr_string(attrs, "event_phase").unwrap_or_else(fn(): ("bubble").to_string()).as_str():
            "bubble" => kain_ui__UiEventPhase__Bubble
            "capture" => kain_ui__UiEventPhase__Capture
            "direct" => kain_ui__UiEventPhase__Direct
            _ => kain_ui__UiEventPhase__Bubble
        let command = attr_string(attrs, "command")
        let transaction = attr_string(attrs, "transaction")
        let target_key = stable_node_contract_key(node)
        let phase_key = match phase:
            kain_ui__UiEventPhase::Bubble => "bubble"
            kain_ui__UiEventPhase::Capture => "capture"
            kain_ui__UiEventPhase::Direct => "direct"
        for attr in attrs:
            let UIAttr::Event { event: event, handler: handler, expr: expr } = attr
            let event_name = event_name(event).to_string()
            let handler_id = expr.map(render_authored_expr_contract).unwrap_or_else(fn(): handler_ref_string(handler))
            let route_id = f"{target_key}::{event_name}::{phase_key}"
            let route_prefix = f"ui.event.route.{route_id}"
            (*_self).event_routes.push(kain_ui::UiEventRoute { route_id: route_id.clone(), event: event_name.clone(), target: id, phase: phase, handler_id: Option::Some(handler_id.clone()), dispatch_command: command.clone(), transaction_label: transaction.clone() })
            ()
            (*_self).session_state.insert(f"{route_prefix}.target", kain_ui__UiValue::String(target_key.clone()))
            ()
            (*_self).session_state.insert(f"{route_prefix}.event", kain_ui__UiValue::String(event_name.clone()))
            ()
            (*_self).session_state.insert(f"{route_prefix}.phase", kain_ui__UiValue::String(phase_key.to_string()))
            ()
            (*_self).session_state.insert(f"{route_prefix}.handler", kain_ui__UiValue::String(handler_id))
            ()
            match command:
                Some(command) =>
                    (*_self).session_state.insert(f"{route_prefix}.command", kain_ui__UiValue::String(command.to_string()))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            match transaction:
                Some(label) =>
                    let label = label.to_string()
                    (*_self).session_state.insert(f"{route_prefix}.transaction", kain_ui__UiValue::String(label.clone()))
                    ()
                    (*_self).session_state.insert(f"{route_prefix}.transaction_label", kain_ui__UiValue::String(label))
                    ()
                _ => ()

    fn record_motion_tracks(_self: &mut AuthoredUiSystemsAccumulator, id: kain_ui::UiNodeId, node: &kain_ui::UiNode, attrs: &[UIAttr]):
        let Some(property) = attr_string(attrs, "motion_property").or_else(fn(): attr_string(attrs, "motion_prop"))
        let track_id = attr_string(attrs, "motion_id").unwrap_or_else(fn(): none)
        let duration_ms = attr_value(attrs, "motion_duration_ms").and_then(runtime_value_to_u32).unwrap_or(250)
        let trigger = attr_string(attrs, "motion_trigger").and_then(parse_animation_trigger).unwrap_or(kain_ui__UiAnimationTrigger__Mount)
        let easing = attr_string(attrs, "motion_easing").and_then(parse_easing_kind).unwrap_or(kain_ui__UiEasingKind__EaseInOut)
        let preserve_on_reload = attr_value(attrs, "motion_preserve_on_reload").and_then(value_as_bool).unwrap_or(true)
        (*_self).animation_tracks.push(kain_ui::UiAnimationTrack { id: track_id, target: id, property: property, duration_ms: duration_ms, trigger: trigger, easing: easing, preserve_on_reload: preserve_on_reload })
        ()

    fn record_surface_decl(_self: &mut AuthoredUiSystemsAccumulator, id: kain_ui::UiNodeId, node: &kain_ui::UiNode, attrs: &[UIAttr]):
        let kind = match (*node).kind:
            kain_ui__UiWidgetKind::Graph => kain_ui__UiSurfaceKind__Graph
            kain_ui__UiWidgetKind::Timeline => kain_ui__UiSurfaceKind__Timeline
            kain_ui__UiWidgetKind::Table => kain_ui__UiSurfaceKind__Table
            kain_ui__UiWidgetKind::Tree => kain_ui__UiSurfaceKind__Tree
            kain_ui__UiWidgetKind::Viewport2D => kain_ui__UiSurfaceKind__Viewport2D
            kain_ui__UiWidgetKind::Viewport3D => kain_ui__UiSurfaceKind__Viewport3D
            kain_ui__UiWidgetKind::Overlay => kain_ui__UiSurfaceKind__Overlay
            _ => return
        let surface_id = attr_string(attrs, "surface_id").or_else(fn(): (*node).identity_key.clone()).unwrap_or_else(fn(): f"surface.{id.field_0}")
        let renderer_preference = attr_string(attrs, "surface_renderer").and_then(parse_surface_renderer_preference).unwrap_or_default()
        let composition_mode = attr_string(attrs, "surface_composition").and_then(parse_surface_composition_mode).unwrap_or_default()
        let gpu_backing_required = attr_value(attrs, "gpu_backing_required").and_then(value_as_bool).unwrap_or(false)
        let title = attr_string(attrs, "title")
        let shader_ref = attr_string(attrs, "shader_ref")
        let shader_ = shader_ref.map(fn(shader_ref): kain_ui::UiSurfaceShaderBinding { shader_ref: shader_ref, entry_point: attr_string(attrs, "shader_entry_point"), stage: attr_string(attrs, "shader_stage"), derived_format: attr_string(attrs, "shader_derived_format") })
        let preferred_host_backend = attr_string(attrs, "host_backend").or_else(fn(): attr_string(attrs, "surface_backend")).and_then(parse_surface_host_backend).unwrap_or_else(fn(): none)
        let preferred_layout_engine = attr_string(attrs, "layout_engine").or_else(fn(): attr_string(attrs, "surface_layout_engine")).and_then(parse_surface_layout_engine).unwrap_or(kain_ui__UiLayoutEngineKind__Yoga)
        let preferred_render_engine = attr_string(attrs, "render_engine").or_else(fn(): attr_string(attrs, "surface_render_engine")).and_then(parse_surface_render_engine).unwrap_or_else(fn(): none)
        (*_self).surfaces.push(kain_ui::UiSurface { id: surface_id, kind: kind, node: id, title: title, renderer_preference: renderer_preference, composition_mode: composition_mode, preferred_host_backend: preferred_host_backend, preferred_layout_engine: preferred_layout_engine, preferred_render_engine: preferred_render_engine, gpu_backing_required: gpu_backing_required, shader_: shader_ })
        ()

    fn record_component_state_signals(_self: &mut AuthoredUiSystemsAccumulator, component_node_id: kain_ui::UiNodeId, component_name: String, props: &Map<String, Value>, state_: &Map<String, Value>, ui_node: &mut kain_ui::UiNode):
        let identity = props.get("key").and_then(value_as_str).or_else(fn(): props.get("id").and_then(value_as_str)).map(ToString__to_string).unwrap_or_else(fn(): component_node_id.field_0)
        (*ui_node).identity_key.get_or_insert(identity.clone())
        ()
        for selfhost_for_item in state_:
            let (state_name, initial_value) = selfhost_for_item
            let signal_key = f"ui.signal.component_state::{component_name}::{identity}::{state_name}"
            let signal_id = kain_ui__UiSignalId(stable_hash_u64(&signal_key))
            (*ui_node).watches.push(signal_id)
            ()
            (*_self).signal_values.insert(signal_id, runtime_value_to_ui_value(initial_value))
            ()
            (*ui_node).props.insert(f"ui.state_signal.{state_name}", kain_ui__UiValue::String(signal_id.field_0.to_string()))
            ()
            (*_self).session_state.insert(f"ui.signal.key.{signal_id.field_0}", kain_ui__UiValue::String(signal_key))
            ()
            (*_self).session_state.insert(f"ui.signal.owner.{signal_id.field_0}", kain_ui__UiValue::String(f"component:{component_name}"))
            ()


