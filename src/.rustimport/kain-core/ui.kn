fn runtime_value_to_json_string(value: &Value) -> Option<String>:
    fn to_json(v: &Value) -> serde_json::Value:
        match v:
            Value::Unit => serde_json__Value__Null
            Value::None => serde_json__Value__Null
            Value::Bool(b) => serde_json__Value::Bool((*b))
            Value::Int(i) => serde_json::json!(i)
            Value::Float(f) => serde_json::json!(f)
            Value::String(s) => serde_json__Value::String(s.clone())
            Value::Array(arr) =>
                let arr = arr.read().unwrap()
                serde_json__Value::Array(arr.iter().map(to_json).collect())
            Value::Tuple(items) => serde_json__Value::Array(items.iter().map(to_json).collect())
            Value::Struct(_, fields) =>
                let fields = fields.read().unwrap()
                let mut map = Map__new_()
                for selfhost_for_item in fields.iter():
                    let (k, v) = selfhost_for_item
                    map.insert(k.clone(), to_json(v))
                    ()
                ()
                serde_json__Value::Object(map)
            other => serde_json__Value::String(other)

    serde_json__to_string_pretty(&to_json(value)).ok()

fn parse_layout_kind(name: String) -> Option<kain_ui::UiLayoutKind>:
    const LAYOUT_KIND_PROFILES: Array<(String, kain_ui::UiLayoutKind)> = [("flow", kain_ui__UiLayoutKind__Flow), ("row", kain_ui__UiLayoutKind__FlexRow), ("flex-row", kain_ui__UiLayoutKind__FlexRow), ("column", kain_ui__UiLayoutKind__FlexColumn), ("flex-column", kain_ui__UiLayoutKind__FlexColumn), ("grid", kain_ui__UiLayoutKind__Grid), ("dock", kain_ui__UiLayoutKind__Dock), ("stack", kain_ui__UiLayoutKind__Stack), ("absolute", kain_ui__UiLayoutKind__Absolute)]

    LAYOUT_KIND_PROFILES.iter().find(fn(__kain_closure_arg3): __kain_closure_arg3.__kain_tuple_0.eq_ignore_ascii_case(name)).map(fn(__kain_closure_arg4): (*__kain_closure_arg4.__kain_tuple_1))

fn parse_layout_alignment(value: String) -> Option<kain_ui::UiLayoutAlignment>:
    const ALIGNMENTS: Array<(String, kain_ui::UiLayoutAlignment)> = [("start", kain_ui__UiLayoutAlignment__Start), ("center", kain_ui__UiLayoutAlignment__Center), ("end", kain_ui__UiLayoutAlignment__End), ("stretch", kain_ui__UiLayoutAlignment__Stretch), ("space-between", kain_ui__UiLayoutAlignment__SpaceBetween), ("space_between", kain_ui__UiLayoutAlignment__SpaceBetween), ("between", kain_ui__UiLayoutAlignment__SpaceBetween)]

    ALIGNMENTS.iter().find(fn(__kain_closure_arg5): __kain_closure_arg5.__kain_tuple_0.eq_ignore_ascii_case(value)).map(fn(__kain_closure_arg6): (*__kain_closure_arg6.__kain_tuple_1))

fn parse_overflow_behavior(value: String) -> Option<kain_ui::UiOverflowBehavior>:
    const BEHAVIORS: Array<(String, kain_ui::UiOverflowBehavior)> = [("visible", kain_ui__UiOverflowBehavior__Visible), ("hidden", kain_ui__UiOverflowBehavior__Hidden), ("scroll", kain_ui__UiOverflowBehavior__Scroll), ("auto", kain_ui__UiOverflowBehavior__Auto)]

    BEHAVIORS.iter().find(fn(__kain_closure_arg7): __kain_closure_arg7.__kain_tuple_0.eq_ignore_ascii_case(value)).map(fn(__kain_closure_arg8): (*__kain_closure_arg8.__kain_tuple_1))

fn parse_dock_placement(value: String) -> Option<kain_ui::UiDockPlacement>:
    const PLACEMENTS: Array<(String, kain_ui::UiDockPlacement)> = [("center", kain_ui__UiDockPlacement__Center), ("left", kain_ui__UiDockPlacement__Left), ("right", kain_ui__UiDockPlacement__Right), ("top", kain_ui__UiDockPlacement__Top), ("bottom", kain_ui__UiDockPlacement__Bottom), ("tab", kain_ui__UiDockPlacement__Tab)]

    PLACEMENTS.iter().find(fn(__kain_closure_arg9): __kain_closure_arg9.__kain_tuple_0.eq_ignore_ascii_case(value)).map(fn(__kain_closure_arg10): (*__kain_closure_arg10.__kain_tuple_1))

fn parse_style_state(value: String) -> Option<kain_ui::UiStyleState>:
    const STATES: Array<(String, kain_ui::UiStyleState)> = [("hovered", kain_ui__UiStyleState__Hovered), ("active", kain_ui__UiStyleState__Active), ("focused", kain_ui__UiStyleState__Focused), ("disabled", kain_ui__UiStyleState__Disabled), ("selected", kain_ui__UiStyleState__Selected), ("dragging", kain_ui__UiStyleState__Dragging)]

    STATES.iter().find(fn(__kain_closure_arg11): __kain_closure_arg11.__kain_tuple_0.eq_ignore_ascii_case(value)).map(fn(__kain_closure_arg12): (*__kain_closure_arg12.__kain_tuple_1))

fn parse_ui_length_value(value: &Value) -> Option<kain_ui::UiLength>:
    match value:
        Value::Int(value) => Option::Some(kain_ui::UiLength { value: (*value) as f32, unit: kain_ui__UiLengthUnit__Px })
        Value::Float(value) => Option::Some(kain_ui::UiLength { value: (*value) as f32, unit: kain_ui__UiLengthUnit__Px })
        Value::String(value) => parse_ui_length(value)
        _ => none

fn parse_ui_length(value: String) -> Option<kain_ui::UiLength>:
    let trimmed = value.trim()
    if trimmed.is_empty():
        return none
    if trimmed.eq_ignore_ascii_case("auto"):
        return Option::Some(kain_ui::UiLength { value: 0, unit: kain_ui__UiLengthUnit__Auto })
    for selfhost_for_item in [("px", kain_ui__UiLengthUnit__Px), ("%", kain_ui__UiLengthUnit__Percent), ("fr", kain_ui__UiLengthUnit__Fr)]:
        let (suffix, unit) = selfhost_for_item
        match trimmed.strip_suffix(suffix):
            Some(raw) =>
                let value = raw.trim().parse().ok()?
                return Option::Some(kain_ui::UiLength { value: value, unit: unit })
            _ => ()
    ()
    trimmed.parse().ok().map(fn(value): kain_ui::UiLength { value: value, unit: kain_ui__UiLengthUnit__Px })

fn runtime_value_to_f32(value: &Value) -> Option<f32>:
    match value:
        Value::Int(value) => Option::Some((*value) as f32)
        Value::Float(value) => Option::Some((*value) as f32)
        Value::String(value) => value.trim().parse().ok()
        _ => none

fn runtime_value_to_i32(value: &Value) -> Option<i32>:
    match value:
        Value::Int(value) => i32__try_from((*value)).ok()
        Value::Float(value) => if ((value.is_finite() && ((*value) >= i32__MIN as f64)) && ((*value) <= i32__MAX as f64)): Option::Some((*value) as i32) else: none
        Value::String(value) => value.trim().parse().ok()
        _ => none

fn runtime_value_to_ui_value(value: &Value) -> kain_ui::UiValue:
    match value:
        Value::Unit => kain_ui__UiValue__Null
        Value::None => kain_ui__UiValue__Null
        Value::Bool(value) => kain_ui__UiValue::Bool((*value))
        Value::Int(value) => kain_ui__UiValue::Int((*value))
        Value::Float(value) => kain_ui__UiValue::Float((*value))
        Value::String(value) => kain_ui__UiValue::String(value.clone())
        Value::JSX(node) => kain_ui__UiValue::String(render_to_string(node))
        _ => kain_ui__UiValue::String(value.to_string())

fn extract_theme_block(registry: &mut kain_ui::UiThemeRegistry, attrs: &[UIAttr], children: &[VNode]):
    if (*registry).active_theme.is_none():
        (*registry).active_theme = theme_block_name(attrs)
        ()
        ()
        ()
        ()
    for child in children:
        extract_theme_directive(registry, child, none)
        ()

fn extract_theme_directive(registry: &mut kain_ui::UiThemeRegistry, node: &VNode, inherited_scope: Option<String>):
    match node:
        VNode::Element { tag: tag, attrs: attrs, children: children } if tag.eq_ignore_ascii_case("scope") =>
            let Some(name) = attr_string(attrs, "name")
            push_theme_scope(registry, kain_ui::UiThemeScope { selector: attr_string(attrs, "selector").unwrap_or_else(fn(): f"scope:{name}"), parent: attr_string(attrs, "parent"), name: name.clone() })
            ()
            push_theme_diff_key(registry, name.clone())
            ()
            for child in children:
                extract_theme_directive(registry, child, Option::Some(name.as_str()))
                ()
        VNode::Element { tag: tag, attrs: attrs, children: children } if tag.eq_ignore_ascii_case("token") =>
            match theme_token_from_attrs(attrs, none):
                Some(token) =>
                    push_theme_token(registry, token)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            for child in children:
                extract_theme_directive(registry, child, inherited_scope)
                ()
        VNode::Element { tag: tag, attrs: attrs, children: children } if tag.eq_ignore_ascii_case("variant") =>
            let Some(name) = attr_string(attrs, "name")
            let scope = attr_string(attrs, "scope").or_else(fn(): inherited_scope.map(ToString__to_string)).unwrap_or_else(fn(): ("default").to_string())
            let mut tokens = attr_list(attrs, &["tokens"])
            for child in children:
                match theme_token_from_vnode(child, Option::Some(&f"variant.{name}.")):
                    Some(token) =>
                        tokens.push(token.name.clone())
                        ()
                        push_theme_token(registry, token)
                        ()
                    _ =>
                        extract_theme_directive(registry, child, Option::Some(scope.as_str()))
                        ()
            ()
            push_theme_variant(registry, kain_ui::UiThemeVariant { scope: scope, name: name, tokens: tokens })
            ()
        VNode::Element { tag: tag, attrs: attrs, children: children } if tag.eq_ignore_ascii_case("widget") =>
            let Some(kind) = attr_string(attrs, "kind")
            let scope = attr_string(attrs, "scope").or_else(fn(): inherited_scope.map(ToString__to_string)).unwrap_or_else(fn(): ("default").to_string())
            let variant = attr_string(attrs, "variant")
            let prefix = match variant:
                Some(variant) => f"widget.{kind}.variant.{variant}."
                _ => f"widget.{kind}."
            let mut tokens = attr_list(attrs, &["tokens"])
            for child in children:
                match theme_token_from_vnode(child, Option::Some(prefix.as_str())):
                    Some(token) =>
                        tokens.push(token.name.clone())
                        ()
                        push_theme_token(registry, token)
                        ()
                    _ =>
                        extract_theme_directive(registry, child, Option::Some(scope.as_str()))
                        ()
            ()
            match variant:
                Some(variant) =>
                    push_theme_variant(registry, kain_ui::UiThemeVariant { scope: scope, name: variant, tokens: tokens })
                    ()
                _ => ()
        VNode::Element { tag: tag, attrs: attrs, children: children } if tag.eq_ignore_ascii_case("textvariant") =>
            let mut widget_attrs = attrs.to_vec()
            if attr_string(attrs, "kind").is_none():
                widget_attrs.push(UIAttr::Property { name: ("kind").to_string(), value: Value::String(("text").to_string()), expr: none })
                ()
                ()
                ()
                ()
            if attr_string(attrs, "variant").is_none():
                match attr_string(attrs, "name"):
                    Some(name) =>
                        widget_attrs.push(UIAttr::Property { name: ("variant").to_string(), value: Value::String(name), expr: none })
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            extract_theme_directive(registry, &VNode::Element { tag: ("widget").to_string(), attrs: widget_attrs, children: children.to_vec(), key: none }, inherited_scope)
            ()
        VNode::Element { children: children } =>
            for child in children:
                extract_theme_directive(registry, child, inherited_scope)
                ()
        VNode::Fragment(children) =>
            for child in children:
                extract_theme_directive(registry, child, inherited_scope)
                ()
        VNode::Component { rendered: rendered } =>
            extract_theme_directive(registry, rendered, inherited_scope)
            ()
        VNode::Text(_) => ()

fn theme_block_name(attrs: &[UIAttr]) -> Option<String>:
    match attr_value(attrs, "active"):
        Some(Value::String(name)) if (!name.trim().is_empty()) => Option::Some(name.clone())
        Some(value) if (value_as_bool(value) == Option::Some(true)) => attr_string(attrs, "name")
        Some(_) => none
        None => attr_string(attrs, "name")

fn theme_token_from_vnode(node: &VNode, prefix: Option<String>) -> Option<kain_ui::UiThemeToken>:
    match node:
        VNode::Element { tag: tag, attrs: attrs, children: _ } if tag.eq_ignore_ascii_case("token") => theme_token_from_attrs(attrs, prefix)
        VNode::Component { rendered: rendered } => theme_token_from_vnode(rendered, prefix)
        _ => none

fn theme_token_from_attrs(attrs: &[UIAttr], prefix: Option<String>) -> Option<kain_ui::UiThemeToken>:
    let name = attr_string(attrs, "name")?
    let value = attr_value(attrs, "value")?
    let full_name = f"{prefix.unwrap_or_default()}{name}"
    Option::Some(kain_ui::UiThemeToken { category: attr_string(attrs, "category").unwrap_or_else(fn(): infer_theme_token_category(&full_name)), name: full_name, value: runtime_value_to_ui_value(value) })

fn infer_theme_token_category(name: String) -> String:
    let category = name.split(".").find(fn(segment): ((!segment.eq_ignore_ascii_case("widget")) && (!segment.eq_ignore_ascii_case("variant")))).unwrap_or("generic")
    category.to_string()

fn merge_authored_theme_registry(derived: &kain_ui::UiThemeRegistry, authored: kain_ui::UiThemeRegistry) -> kain_ui::UiThemeRegistry:
    let mut merged = kain_ui::UiThemeRegistry { active_theme: authored.active_theme.or_else(fn(): (*derived).active_theme.clone()), ..UiThemeRegistry__default_() }
    for scope in &(*derived).scopes:
        push_theme_scope(&mut merged, scope.clone())
        ()
    ()
    for key in &(*derived).diff_keys:
        push_theme_diff_key(&mut merged, key.clone())
        ()
    ()
    for scope in authored.scopes:
        push_theme_scope(&mut merged, scope)
        ()
    ()
    for token in authored.semantic_tokens:
        push_theme_token(&mut merged, token)
        ()
    ()
    for variant in authored.variants:
        push_theme_variant(&mut merged, variant)
        ()
    ()
    for key in authored.diff_keys:
        push_theme_diff_key(&mut merged, key)
        ()
    ()
    merged

fn theme_registry_is_empty(registry: &kain_ui::UiThemeRegistry) -> Bool:
    (((((*registry).active_theme.is_none() && (*registry).scopes.is_empty()) && (*registry).semantic_tokens.is_empty()) && (*registry).variants.is_empty()) && (*registry).diff_keys.is_empty())

fn push_theme_scope(registry: &mut kain_ui::UiThemeRegistry, scope: kain_ui::UiThemeScope):
    match (*registry).scopes.iter_mut().find(fn(entry): (entry.name == scope.name)):
        Some(existing) =>
            (*existing) = scope
            ()
        _ =>
            (*registry).scopes.push(scope)
            ()

fn push_theme_token(registry: &mut kain_ui::UiThemeRegistry, token: kain_ui::UiThemeToken):
    match (*registry).semantic_tokens.iter_mut().find(fn(entry): (entry.name == token.name)):
        Some(existing) =>
            (*existing) = token
            ()
        _ =>
            (*registry).semantic_tokens.push(token)
            ()

fn push_theme_variant(registry: &mut kain_ui::UiThemeRegistry, variant: kain_ui::UiThemeVariant):
    match (*registry).variants.iter_mut().find(fn(entry): ((entry.scope == variant.scope) && (entry.name == variant.name))):
        Some(existing) =>
            for token in variant.tokens:
                if (!existing.tokens.contains(&token)):
                    existing.tokens.push(token)
                    ()
        _ =>
            (*registry).variants.push(variant)
            ()

fn push_theme_diff_key(registry: &mut kain_ui::UiThemeRegistry, key: String):
    if (!(*registry).diff_keys.contains(&key)):
        (*registry).diff_keys.push(key)
        ()

fn render_text_children(children: &[VNode]) -> String:
    children.iter().map(render_to_string).collect().join("")

fn attr_value<a>(attrs: &a [UIAttr], name: String) -> Option<&a Value>:
    attrs.iter().find_map(fn(attr): none)

fn attr_expr<a>(attrs: &a [UIAttr], names: &[String]) -> Option<&a Expr>:
    for name in names:
        match attrs.iter().find_map(fn(attr): none):
            Some(expr) => return Option::Some(expr)
            _ => ()
    ()
    none

fn attr_string_any(attrs: &[UIAttr], names: &[String]) -> Option<String>:
    for name in names:
        match attr_string(attrs, name):
            Some(value) => return Option::Some(value)
            _ => ()
    ()
    none

fn attr_string(attrs: &[UIAttr], name: String) -> Option<String>:
    match attrs.iter().find(fn(attr): none):
        Some(UIAttr::Property { value: value }) => value_as_str(value).map(ToString__to_string)
        Some(UIAttr::Bool { value: value }) => Option::Some(value.to_string())
        _ => none

fn attr_list(attrs: &[UIAttr], names: &[String]) -> Array<String>:
    let mut values = Vec__new_()
    for name in names:
        match attr_string(attrs, name):
            Some(value) =>
                for entry in value.split(fn(c: Char): (((c == ",") || (c == "|")) || c.is_whitespace())).map(str__trim).filter(fn(entry): (!entry.is_empty())):
                    let entry = entry.to_string()
                    if (!values.contains(&entry)):
                        values.push(entry)
                        ()
            _ => ()
    ()
    values

fn value_as_str(value: &Value) -> Option<String>:
    match value:
        Value::String(value) => Option::Some(value.as_str())
        _ => none

fn value_as_bool(value: &Value) -> Option<Bool>:
    match value:
        Value::Bool(value) => Option::Some((*value))
        Value::String(value) =>
            match value.trim().to_ascii_lowercase().as_str():
                "true" => Option::Some(true)
                "yes" => Option::Some(true)
                "on" => Option::Some(true)
                "false" => Option::Some(false)
                "no" => Option::Some(false)
                "off" => Option::Some(false)
                _ => none
        _ => none

fn eval_attrs(env: &mut Env, attributes: &[ast::JSXAttribute]) -> Result<Array<UIAttr>, KainError>:
    let mut attrs = Vec__new_()
    for attr in attributes:
        let lowered = match &attr.value:
            JSXAttrValue::String(s) => UIAttr::Property { name: attr.name.clone(), value: Value::String(s.clone()), expr: none }
            JSXAttrValue::Bool(b) => UIAttr::Bool { name: attr.name.clone(), value: (*b) }
            JSXAttrValue::Expr(expr) =>
                let value = runtime__eval_expr(env, expr)?
                match parse_event_name(&attr.name):
                    Some(event) => UIAttr::Event { name: attr.name.clone(), event: event, handler: value, expr: Option::Some(expr.clone()) }
                    _ => UIAttr::Property { name: attr.name.clone(), value: value, expr: Option::Some(expr.clone()) }
        attrs.push(lowered)
        ()
    ()
    Result::Ok(attrs)

fn eval_children(env: &mut Env, children: &[JSXNode]) -> Result<Array<VNode>, KainError>:
    let mut out_ = Vec__new_()
    for child in children:
        let rendered = eval_jsx(env, child)?
        flatten_value_into_children(rendered, &mut out_)
        ()
    ()
    Result::Ok(out_)

fn flatten_value_into_children(value: Value, out_: &mut Array<VNode>):
    match value:
        Value::JSX(node) => out_.push(node)
        Value::String(s) => out_.push(VNode::Text(s))
        Value::Int(n) => out_.push(VNode::Text(n.to_string()))
        Value::Float(n) => out_.push(VNode::Text(n.to_string()))
        Value::Bool(b) => out_.push(VNode::Text(b.to_string()))
        Value::Array(items) =>
            for item in items.read().unwrap().iter().cloned():
                flatten_value_into_children(item, out_)
                ()
        Value::Tuple(items) =>
            for item in items:
                flatten_value_into_children(item, out_)
                ()
        _ => ()

fn attrs_to_props_map(attrs: &[UIAttr]) -> Map<String, Value>:
    let mut props = HashMap__new_()
    for attr in attrs:
        match attr:
            UIAttr::Property { name: name, value: value } =>
                props.insert(name.clone(), value.clone())
                ()
            UIAttr::Bool { name: name, value: value } =>
                props.insert(name.clone(), Value::Bool((*value)))
                ()
            UIAttr::Event {  } => ()
    ()
    props

fn render_attr_to_string(attr: &UIAttr) -> String:
    match attr:
        UIAttr::Property { name: name, value: value } => f"{name}=\"{value}\""
        UIAttr::Bool { name: name, value: value } => if (*value): name.clone() else: String__new_()
        UIAttr::Event { name: name } => f"{name}=\"[event-route]\""

fn parse_event_name(name: String) -> Option<UIEvent>:
    let normalized = name.strip_prefix("on_").or_else(fn(): name.strip_prefix("on")).unwrap_or(name).to_ascii_lowercase()
    Option::Some(none)

fn event_name(event: &UIEvent) -> String:
    match event:
        UIEvent::Click => "click"
        UIEvent::Input => "input"
        UIEvent::Change => "change"
        UIEvent::Submit => "submit"
        UIEvent::Focus => "focus"
        UIEvent::Blur => "blur"
        UIEvent::KeyDown => "keydown"
        UIEvent::KeyUp => "keyup"
        UIEvent::PointerDown => "pointerdown"
        UIEvent::PointerUp => "pointerup"
        UIEvent::PointerMove => "pointermove"
        UIEvent::Custom(name) => name.as_str()

fn value_is_truthy(value: &Value) -> Bool:
    match value:
        Value::Unit => false
        Value::None => false
        Value::Bool(v) => (*v)
        Value::Int(v) => ((*v) != 0)
        Value::Float(v) => ((*v) != 0)
        Value::String(v) => (!v.is_empty())
        Value::Array(items) => (!items.read().unwrap().is_empty())
        Value::Tuple(items) => (!items.is_empty())
        Value::JSX(_) => true
        _ => true

fn find_attr_key(attrs: &[UIAttr], name: String) -> Option<String>:
    for attr in attrs:
        match attr:
            UIAttr::Property { name: attr_name, value: value } if (attr_name == name) => return Option::Some(value_to_key_string(value))
            UIAttr::Bool { name: attr_name, value: value } if (attr_name == name) => return Option::Some(value.to_string())
            _ => ()
    ()
    none

fn value_to_key_string(value: &Value) -> String:
    match value:
        Value::String(v) => v.clone()
        Value::Int(v) => v.to_string()
        Value::Float(v) => v.to_string()
        Value::Bool(v) => v.to_string()
        _ => value

