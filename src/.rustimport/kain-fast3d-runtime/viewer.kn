use std::path::Path

use std::path::PathBuf

use std::time::Instant

use eframe::egui

use crate::host_documents::Fast3dGameplayStateDocument

use crate::host_documents::Fast3dShaderOverrideDocument

use crate::model::CombineMode

use crate::rasterizer::RenderFrame

use crate::runtime::Fast3dRuntime

use crate::runtime::FreeCameraPose

use crate::runtime::OrbitControls

use crate::runtime::OrbitControls as OrbitControlsExport

pub fn launch_viewer(manifest_path: std::path::PathBuf, runtime: Fast3dRuntime, gameplay_state: Option<Fast3dGameplayStateDocument>, shader_overrides: Option<Fast3dShaderOverrideDocument>) -> Result<(), Box<impl Error>>:
    let options = eframe::NativeOptions { viewport: ViewportBuilder__default_().with_inner_size([1280, 768]).with_min_inner_size([820, 620]), ..Default__default_() }
    let title = runtime.manifest.title.clone()
    eframe__run_native(&title, options, Box__new_(fn(_creation_context): Result::Ok(Box__new_(Fast3dViewerApp__new_(manifest_path, runtime, gameplay_state, shader_overrides)))))?
    ()
    Result::Ok(())

pub fn write_snapshot_png(path: &std::path::Path, frame: &RenderFrame) -> Result<(), Box<impl Error>>:
    let file = File__create(path)?
    let mut encoder = Encoder__new_(file, (*frame).width as u32, (*frame).height as u32)
    encoder.set_color(png__ColorType__Rgba)
    ()
    encoder.set_depth(png__BitDepth__Eight)
    ()
    let mut writer = encoder.write_header()?
    writer.write_image_data(&(*frame).rgba)?
    ()
    Result::Ok(())

enum CameraMode:
    Orbit
    FreeFly

@doc(doc = " Free-fly / first-person camera controller state.")
@doc(doc = " `F` key in the viewer toggles between orbit and free-fly mode.")
@derive(Clone, Copy, Debug)
pub struct FreeFlyControls:
    position: [f32; 3]
    yaw_radians: f32
    pitch_radians: f32
    speed: f32

impl Default for FreeFlyControls:
    fn default_() -> FreeFlyControls:
        FreeFlyControls { position: [0, 20, 80], yaw_radians: std__f32__consts__PI, pitch_radians: (-0.2), speed: 30 }


struct Fast3dViewerApp:
    manifest_path: std::path::PathBuf
    runtime: Fast3dRuntime
    orbit_controls: OrbitControls
    free_fly: FreeFlyControls
    camera_mode: CameraMode
    frame_texture: Option<eframe::egui::TextureHandle>
    last_frame_started_at: std::time::Instant
    elapsed_seconds: f32
    auto_rotate: Bool
    combine_override: Option<CombineMode>
    latest_frame: Option<RenderFrame>
    gameplay_state: Option<Fast3dGameplayStateDocument>
    shader_overrides: Option<Fast3dShaderOverrideDocument>
    drag_delta: eframe::egui::Vec2

impl Fast3dViewerApp:
    fn new_(manifest_path: std::path::PathBuf, runtime: Fast3dRuntime, gameplay_state: Option<Fast3dGameplayStateDocument>, shader_overrides: Option<Fast3dShaderOverrideDocument>) -> Fast3dViewerApp:
        let camera = &runtime.manifest.camera
        let start_position = [camera.target[0], (camera.target[1] + camera.orbit_height), (camera.target[2] + camera.orbit_radius)]
        match (none):
            Some(shader_overrides_document) =>
                runtime.apply_shader_overrides(shader_overrides_document)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        Fast3dViewerApp { manifest_path: manifest_path, runtime: runtime, orbit_controls: OrbitControls__default_(), free_fly: FreeFlyControls { position: start_position, ..FreeFlyControls__default_() }, camera_mode: CameraMode__Orbit, frame_texture: none, last_frame_started_at: Instant__now(), elapsed_seconds: 1.8, auto_rotate: true, combine_override: none, latest_frame: none, gameplay_state: gameplay_state, shader_overrides: shader_overrides, drag_delta: eframe__egui__Vec2__ZERO }

    fn cycle_combine_override(_self: &mut Fast3dViewerApp):
        (*_self).combine_override = none
        ()

    fn apply_keyboard_controls(_self: &mut Fast3dViewerApp, ctx: &eframe::egui::Context, delta_seconds: f32):
        ctx.input(fn(input): none)
        ()
        (*_self).drag_delta = eframe__egui__Vec2__ZERO
        ()
        if ((*_self).auto_rotate && ((*_self).camera_mode == CameraMode__Orbit)):
            (*_self).elapsed_seconds = ((*_self).elapsed_seconds + delta_seconds)
            ()

    fn render_current_frame(_self: &mut Fast3dViewerApp) -> Result<RenderFrame, String>:
        match (*_self).gameplay_state:
            Some(gameplay_state) =>
                (*_self).runtime.apply_gameplay_state((*_self).elapsed_seconds, gameplay_state)
                ()
                ()
                ()
                ()
            _ =>
                (*_self).runtime.clear_actor_transforms()
                ()
                ()
                ()
                ()
        match (*_self).shader_overrides:
            Some(shader_overrides) =>
                (*_self).runtime.apply_shader_overrides(shader_overrides)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match (*_self).camera_mode:
            CameraMode::Orbit => (*_self).runtime.render_frame((*_self).elapsed_seconds, &(*_self).orbit_controls, (*_self).combine_override)
            CameraMode::FreeFly =>
                let camera = &(*_self).runtime.manifest.camera
                (*_self).runtime.render_frame_with_pose(&FreeCameraPose { position: (*_self).free_fly.position, yaw_radians: (*_self).free_fly.yaw_radians, pitch_radians: (*_self).free_fly.pitch_radians, fov_y_degrees: camera.fov_y_degrees, near_plane: camera.near_plane, far_plane: camera.far_plane }, (*_self).combine_override)

    fn update_frame_texture(_self: &mut Fast3dViewerApp, ctx: &eframe::egui::Context, frame: &RenderFrame):
        let image = ColorImage__from_rgba_unmultiplied([(*frame).width, (*frame).height], &(*frame).rgba)
        match (*_self).frame_texture:
            Some(texture) =>
                texture.set(image, eframe__egui__TextureOptions__NEAREST)
                ()
            _ =>
                (*_self).frame_texture = Option::Some(ctx.load_texture("sm64_fast3d_frame", image, eframe__egui__TextureOptions__NEAREST))
                ()


impl eframe::App for Fast3dViewerApp:
    fn update(_self: &mut Fast3dViewerApp, ctx: &eframe::egui::Context, _frame: &mut eframe::Frame):
        let now = Instant__now()
        let delta_seconds = ((now - (*_self).last_frame_started_at)).as_secs_f32().min(0.05)
        (*_self).last_frame_started_at = now
        ()
        ctx.input(fn(input): none)
        ()
        (*_self).apply_keyboard_controls(ctx, delta_seconds)
        ()
        match (*_self).render_current_frame():
            Ok(frame) =>
                (*_self).update_frame_texture(ctx, &frame)
                ()
                (*_self).latest_frame = Option::Some(frame)
                ()
                ()
                ()
                ()
            Err(error) =>
                CentralPanel__default_().show(ctx, fn(ui): none)
                ()
                ctx.request_repaint()
                ()
                return
        SidePanel__left("sm64_fast3d_controls").default_width(260).show(ctx, fn(ui): none)
        ()
        CentralPanel__default_().show(ctx, fn(ui): none)
        ()
        ctx.request_repaint()
        ()


