use std::collections::BTreeMap

use std::collections::HashMap

use std::collections::HashSet

use std::fs

use std::path::Path

use glam::Mat4

use glam::Vec3

use regex::Regex

use crate::model::CameraConfig

use crate::model::CombineMode

use crate::model::DisplayListCommand

use crate::model::DisplayListDefinition

use crate::model::Fast3dSmokeManifest

use crate::model::Fast3dVertex

use crate::model::LightGroupDefinition

use crate::model::ResolutionConfig

use crate::model::TextureDefinition

use crate::model::TextureSource

const MARIO_FACE_MODEL_PATH: String = "actors/mario/model.inc.c"

const TITLE_FACE_ROTATION_Y_RADIANS: f32 = (-std__f32__consts__FRAC_PI_2)

const TITLE_FACE_TARGET_WIDTH: f32 = 2.35

const TITLE_FACE_TARGET_HEIGHT: f32 = 2.1

const TITLE_FACE_TARGET_CENTER: [f32; 3] = [1.8, (-0.05), 0.3]

const LEVEL_N64_UNIT_SCALE: f32 = (1 / 500)

@doc(doc = " Extract a full SM64 level chunk from the decompiled source tree.")
@doc(doc = "")
@doc(doc = " Reads all `model.inc.c` files under `levels/{level_name}/areas/{area_id}/{sub_id}/`")
@doc(doc = " for the given area, merges them into a single manifest, and writes it to `manifest_out`.")
@doc(doc = "")
@doc(doc = " Positions are normalized from N64 integer units to world units via `LEVEL_N64_UNIT_SCALE`.")
@doc(doc = "")
@doc(doc = " Textures are placeholder checkerboards since real textures require ROM extraction.")
@doc(doc = " UV scale is set to render-reasonable values across the geometry.")
pub fn extract_sm64_level_chunk_scene(sm64_root: &std::path::Path, level_name: String, area_id: u32, manifest_out: &std::path::Path) -> Result<(), Box<impl Error>>:
    let level_dir = sm64_root.join("levels").join(level_name)
    if (!level_dir.exists()):
        return Result::Err((f"SM64 level directory not found: {level_dir.display()}").into())
    let area_dir = level_dir.join("areas").join(area_id.to_string())
    if (!area_dir.exists()):
        return Result::Err((f"SM64 level area directory not found: {area_dir.display()}").into())
    let mut model_paths: Array<path::PathBuf> = Vec__new_()
    let mut sub_id = 1
    loop:
        let candidate = area_dir.join(sub_id.to_string()).join("model.inc.c")
        if candidate.exists():
            model_paths.push(candidate)
            ()
            sub_id = (sub_id + 1)
            ()
        else:
            break
    ()
    if model_paths.is_empty():
        return Result::Err(("No model.inc.c files found under {area_dir.display()}: expected files at {area_dir.join(\"1/model.inc.c\").display()}").into())
    let mut all_vertex_arrays: Map<String, Array<ParsedVertex>> = HashMap__new_()
    let mut all_display_lists: Map<String, Array<ParsedGfxCommand>> = HashMap__new_()
    let mut all_light_groups: Map<String, ParsedLightGroup> = HashMap__new_()
    let mut root_display_list_names: Array<String> = Vec__new_()
    for selfhost_for_item in model_paths.iter().enumerate():
        let (model_index, model_path) = selfhost_for_item
        let model_text = std__fs__read_to_string(model_path).map_err(fn(err): f"Failed to read {model_path.display()}: {err}")?
        let vertex_arrays = parse_vertex_arrays(&model_text)?
        let display_lists = parse_display_lists(&model_text)?
        let light_groups = parse_light_groups(&model_text)?
        all_vertex_arrays.extend(vertex_arrays)
        ()
        all_light_groups.extend(light_groups)
        ()
        let called_in_this_file: Set<String> = display_lists.values().flat_map(fn(cmds): cmds.iter().filter_map(fn(cmd): none)).collect()
        let mut local_roots: Array<String> = display_lists.keys().filter(fn(name): (!called_in_this_file.contains((*name)))).cloned().collect()
        local_roots.sort()
        ()
        all_display_lists.extend(display_lists)
        ()
        if local_roots.is_empty():
            match all_display_lists.keys().filter(fn(k): k.contains(&"seg7")).cloned().next():
                Some(first_key) =>
                    root_display_list_names.push(first_key)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        else:
            root_display_list_names.push(local_roots[0].clone())
            ()
            ()
            ()
            ()
        let _ = model_index
    ()
    let mut extracted_display_lists: Array<DisplayListDefinition> = Vec__new_()
    for selfhost_for_item in &all_display_lists:
        let (dl_name, parsed_commands) = selfhost_for_item
        let commands = convert_display_list_commands_scaled(parsed_commands, &all_display_lists, &all_vertex_arrays)?
        extracted_display_lists.push(DisplayListDefinition { id: dl_name.clone(), commands: commands })
        ()
    ()
    extracted_display_lists.sort_by(fn(a, b): a.id.cmp(&b.id))
    ()
    let root_id = f"{level_name}_area{area_id}_root"
    let mut root_commands: Array<DisplayListCommand> = Vec__new_()
    for sub_root in &root_display_list_names:
        if all_display_lists.contains_key(sub_root):
            root_commands.push(DisplayListCommand::CallDisplayList { display_list_id: sub_root.clone() })
            ()
    ()
    extracted_display_lists.insert(0, DisplayListDefinition { id: root_id.clone(), commands: root_commands })
    ()
    let light_groups: Array<LightGroupDefinition> = all_light_groups.iter().map(fn(__kain_closure_arg0): LightGroupDefinition { id: __kain_closure_arg0.__kain_tuple_0.clone(), ambient_color: __kain_closure_arg0.__kain_tuple_1.ambient_color, diffuse_color: __kain_closure_arg0.__kain_tuple_1.diffuse_color, direction: __kain_closure_arg0.__kain_tuple_1.direction }).collect()
    let textures: Array<TextureDefinition> = [TextureDefinition { id: ("level_ground").to_string(), source: TextureSource::Checkerboard { width: 64, height: 64, cell_size: 8, color_a: [100, 160, 70, 255], color_b: [80, 135, 55, 255] } }, TextureDefinition { id: ("level_rock").to_string(), source: TextureSource::Checkerboard { width: 64, height: 64, cell_size: 16, color_a: [160, 140, 110, 255], color_b: [130, 115, 85, 255] } }]
    let manifest = Fast3dSmokeManifest { title: f"SM64 {level_name.to_uppercase()} Area {area_id} Level Chunk", root_display_list: root_id, resolution: ResolutionConfig { width: 1280, height: 720 }, clear_color: [100, 160, 220, 255], camera: CameraConfig { controller_mode: model__CameraControllerMode__Orbit, target: [0, 5, 0], orbit_radius: 80, orbit_height: 30, initial_yaw_radians: 0, initial_pitch_radians: (-0.3), fov_y_degrees: 60, near_plane: 0.5, far_plane: 2000, free_position: [0, 20, 80], move_speed: 40, look_speed: 1.5 }, auto_rotation_radians_per_second: 0.08, segment_bindings: Vec__new_(), light_groups: light_groups, scene_instances: Vec__new_(), shader_overrides: Vec__new_(), textures: textures, display_lists: extracted_display_lists }
    match manifest_out.parent():
        Some(parent) =>
            if (!parent.as_os_str().is_empty()):
                std__fs__create_dir_all(parent)?
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    std__fs__write(manifest_out, serde_json__to_string_pretty(&manifest)?)?
    ()
    Result::Ok(())

@doc(doc = " Convert parsed GFX commands to manifest format, scaling all vertex positions")
@doc(doc = " from N64 integer units to world units via `LEVEL_N64_UNIT_SCALE`.")
fn convert_display_list_commands_scaled(parsed_commands: &[ParsedGfxCommand], parsed_display_lists: &Map<String, Array<ParsedGfxCommand>>, parsed_vertex_arrays: &Map<String, Array<ParsedVertex>>) -> Result<Array<DisplayListCommand>, String>:
    let mut commands = Vec__new_()
    for parsed_command in parsed_commands:
        match parsed_command:
            ParsedGfxCommand::Vertex { vertex_array_name: vertex_array_name, count: count, slot: slot } =>
                let parsed_vertices = parsed_vertex_arrays.get(vertex_array_name).ok_or_else(fn(): f"missing vertex array `{vertex_array_name}`")?
                let vertices = parsed_vertices.iter().take((*count)).map(fn(vertex_): Fast3dVertex { position: [(vertex_.position[0] * LEVEL_N64_UNIT_SCALE), (vertex_.position[1] * LEVEL_N64_UNIT_SCALE), (vertex_.position[2] * LEVEL_N64_UNIT_SCALE)], uv: [(vertex_.uv_raw[0] / ((32 * 64))), (vertex_.uv_raw[1] / ((32 * 64)))], color: [255, 255, 255, 255], normal: Option::Some(vertex_.normal) }).collect()
                commands.push(DisplayListCommand::LoadVertices { slot: (*slot), vertices: vertices })
                ()
            ParsedGfxCommand::TwoTriangles(left, right) =>
                commands.push(DisplayListCommand::DrawTriangles { triangles: [(*left), (*right)] })
                ()
            ParsedGfxCommand::OneTriangle(triangle) =>
                commands.push(DisplayListCommand::DrawTriangles { triangles: [(*triangle)] })
                ()
            ParsedGfxCommand::DisplayList(display_list_name) =>
                if (!parsed_display_lists.contains_key(display_list_name)):
                    continue
                commands.push(DisplayListCommand::CallDisplayList { display_list_id: display_list_name.clone() })
                ()
            ParsedGfxCommand::SetTexture(texture_name) =>
                commands.push(DisplayListCommand::BindTexture { texture_id: texture_name.clone() })
                ()
            ParsedGfxCommand::SetCombineMode(mode) =>
                commands.push(DisplayListCommand::SetCombineMode { mode: (*mode) })
                ()
            ParsedGfxCommand::SetLightGroup(light_group_name) =>
                commands.push(DisplayListCommand::SetLightGroup { light_group_id: light_group_name.clone() })
                ()
    ()
    Result::Ok(commands)

@derive(Clone, Copy, Debug)
struct ParsedVertex:
    position: [f32; 3]
    uv_raw: [f32; 2]
    normal: [f32; 3]

enum ParsedGfxCommand:
    Vertex { vertex_array_name: String, count: usize, slot: u16 }
    TwoTriangles([u16; 3], [u16; 3])
    OneTriangle([u16; 3])
    DisplayList(String)
    SetTexture(String)
    SetCombineMode(CombineMode)
    SetLightGroup(String)

@derive(Clone, Copy, Debug)
struct ParsedLightGroup:
    ambient_color: [u8; 4]
    diffuse_color: [u8; 4]
    direction: [f32; 3]

pub fn extract_sm64_title_face_scene(sm64_root: &std::path::Path, manifest_out: &std::path::Path) -> Result<(), Box<impl Error>>:
    let mario_model_text = std__fs__read_to_string(sm64_root.join(MARIO_FACE_MODEL_PATH))?
    let parsed_light_groups = parse_light_groups(&mario_model_text)?
    let parsed_vertex_arrays = parse_vertex_arrays(&mario_model_text)?
    let parsed_display_lists = parse_display_lists(&mario_model_text)?
    let root_display_list_name = "mario_cap_off_eyes_front"
    let title_face_matrix = build_title_face_matrix(root_display_list_name, &parsed_display_lists, &parsed_vertex_arrays)?
    let mut visited_display_lists = HashSet__new_()
    collect_display_list_closure(root_display_list_name, &parsed_display_lists, &mut visited_display_lists)?
    ()
    let mut extracted_display_lists = Vec__new_()
    for display_list_name in visited_display_lists.iter():
        let parsed_commands = parsed_display_lists.get(display_list_name).ok_or_else(fn(): f"missing parsed display list `{display_list_name}`")?
        extracted_display_lists.push(DisplayListDefinition { id: display_list_name.clone(), commands: convert_display_list_commands(parsed_commands, &parsed_display_lists, &parsed_vertex_arrays)? })
        ()
    ()
    extracted_display_lists.sort_by(fn(left, right): left.id.cmp(&right.id))
    ()
    match extracted_display_lists.iter_mut().find(fn(display_list): (display_list.id == root_display_list_name)):
        Some(root_display_list) =>
            root_display_list.commands = retarget_title_face_root_commands(&root_display_list.commands)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let mut required_light_groups = BTreeMap__new_()
    for display_list in &extracted_display_lists:
        for command in &display_list.commands:
            match command:
                DisplayListCommand::SetLightGroup { light_group_id: light_group_id } =>
                    required_light_groups.insert(light_group_id.clone(), ())
                    ()
                _ => ()
    ()
    let light_groups = required_light_groups.keys().map(fn(light_group_id): none).collect()?
    let mut display_lists = [DisplayListDefinition { id: ("title_backdrop_quad").to_string(), commands: [DisplayListCommand::LoadVertices { slot: 0, vertices: [Fast3dVertex { position: [(-5.6), (-3.2), (-8)], uv: [0, 1], color: [255, 255, 255, 255], normal: none }, Fast3dVertex { position: [5.6, (-3.2), (-8)], uv: [1, 1], color: [255, 255, 255, 255], normal: none }, Fast3dVertex { position: [5.6, 3.2, (-8)], uv: [1, 0], color: [255, 255, 255, 255], normal: none }, Fast3dVertex { position: [(-5.6), 3.2, (-8)], uv: [0, 0], color: [255, 255, 255, 255], normal: none }] }, DisplayListCommand::DrawTriangles { triangles: [[0, 1, 2], [0, 2, 3]] }] }, DisplayListDefinition { id: ("title_root").to_string(), commands: [DisplayListCommand::BindTexture { texture_id: ("sm64_title_card").to_string() }, DisplayListCommand::SetCombineMode { mode: CombineMode__Texture }, DisplayListCommand::CallDisplayList { display_list_id: ("title_backdrop_quad").to_string() }, DisplayListCommand::SetCombineMode { mode: CombineMode__TextureVertex }, DisplayListCommand::PushMatrix { matrix_: title_face_matrix }, DisplayListCommand::CallDisplayList { display_list_id: root_display_list_name.to_string() }, DisplayListCommand__PopMatrix] }]
    display_lists.extend(extracted_display_lists)
    ()
    let manifest = Fast3dSmokeManifest { title: ("SM64 Title Face Extraction Smoke").to_string(), root_display_list: ("title_root").to_string(), resolution: ResolutionConfig { width: 960, height: 720 }, clear_color: [8, 12, 24, 255], camera: CameraConfig { controller_mode: model__CameraControllerMode__Orbit, target: [0.9, (-0.05), 0], orbit_radius: 5, orbit_height: 0.45, initial_yaw_radians: std__f32__consts__FRAC_PI_2, initial_pitch_radians: (-0.06), fov_y_degrees: 34, near_plane: 0.1, far_plane: 80, free_position: [0, 2, 5], move_speed: 5.5, look_speed: 1.35 }, auto_rotation_radians_per_second: 0, segment_bindings: Vec__new_(), light_groups: light_groups, scene_instances: Vec__new_(), shader_overrides: Vec__new_(), textures: [TextureDefinition { id: ("sm64_title_card").to_string(), source: TextureSource::GeneratedSm64TitleCard { width: 1024, height: 512 } }, TextureDefinition { id: ("mario_eyes_front").to_string(), source: TextureSource::GeneratedMarioEyesFront { width: 32, height: 32 } }, TextureDefinition { id: ("mario_mustache").to_string(), source: TextureSource::GeneratedMarioMustache { width: 32, height: 32 } }, TextureDefinition { id: ("mario_sideburn").to_string(), source: TextureSource::GeneratedMarioSideburn { width: 32, height: 32 } }], display_lists: display_lists }
    match manifest_out.parent():
        Some(parent) =>
            if (!parent.as_os_str().is_empty()):
                std__fs__create_dir_all(parent)?
                ()
                ()
                ()
                ()
            ()
        _ =>
            ()
            ()
    std__fs__write(manifest_out, serde_json__to_string_pretty(&manifest)?)?
    ()
    Result::Ok(())

fn build_title_face_matrix(root_display_list_name: String, parsed_display_lists: &Map<String, Array<ParsedGfxCommand>>, parsed_vertex_arrays: &Map<String, Array<ParsedVertex>>) -> Result<[[f32; 4]; 4], String>:
    let face_positions = collect_display_list_positions(root_display_list_name, parsed_display_lists, parsed_vertex_arrays)?
    let rotation = Mat4__from_rotation_y(TITLE_FACE_ROTATION_Y_RADIANS)
    let mut minimum = Vec3__splat(f32__INFINITY)
    let mut maximum = Vec3__splat(f32__NEG_INFINITY)
    for position in face_positions:
        let rotated = rotation.transform_point3(position)
        minimum = minimum.min(rotated)
        ()
        maximum = maximum.max(rotated)
        ()
    ()
    let extents = ((maximum - minimum)).max(Vec3__splat(1))
    let center = (((minimum + maximum)) * 0.5)
    let uniform_scale = ((TITLE_FACE_TARGET_WIDTH / extents.x)).min((TITLE_FACE_TARGET_HEIGHT / extents.y))
    let desired_center = Vec3__from_array(TITLE_FACE_TARGET_CENTER)
    let translation = (desired_center - (center * uniform_scale))
    let transform = ((Mat4__from_translation(translation) * Mat4__from_scale(Vec3__splat(uniform_scale))) * rotation)
    Result::Ok(rows_from_glam_matrix(transform))

fn collect_display_list_positions(display_list_name: String, parsed_display_lists: &Map<String, Array<ParsedGfxCommand>>, parsed_vertex_arrays: &Map<String, Array<ParsedVertex>>) -> Result<Array<glam::Vec3>, String>:
    let mut visited = HashSet__new_()
    let mut positions = Vec__new_()
    collect_display_list_positions_recursive(display_list_name, parsed_display_lists, parsed_vertex_arrays, &mut visited, &mut positions)?
    ()
    if positions.is_empty():
        return Result::Err(f"display list `{display_list_name}` did not reference any vertex positions")
    Result::Ok(positions)

fn collect_display_list_positions_recursive(display_list_name: String, parsed_display_lists: &Map<String, Array<ParsedGfxCommand>>, parsed_vertex_arrays: &Map<String, Array<ParsedVertex>>, visited: &mut Set<String>, positions: &mut Array<glam::Vec3>) -> Result<(), String>:
    if (!visited.insert(display_list_name.to_string())):
        return Result::Ok(())
    let commands = parsed_display_lists.get(display_list_name).ok_or_else(fn(): f"missing display list `{display_list_name}`")?
    for command in commands:
        match command:
            ParsedGfxCommand::Vertex { vertex_array_name: vertex_array_name, count: count } =>
                let vertices = parsed_vertex_arrays.get(vertex_array_name).ok_or_else(fn(): f"missing vertex array `{vertex_array_name}`")?
                for vertex_ in vertices.iter().take((*count)):
                    positions.push(Vec3__from_array(vertex_.position))
                    ()
            ParsedGfxCommand::DisplayList(child_name) =>
                collect_display_list_positions_recursive(child_name, parsed_display_lists, parsed_vertex_arrays, visited, positions)?
                ()
            ParsedGfxCommand::TwoTriangles(_, _) => ()
            ParsedGfxCommand::OneTriangle(_) => ()
            ParsedGfxCommand::SetTexture(_) => ()
            ParsedGfxCommand::SetCombineMode(_) => ()
            ParsedGfxCommand::SetLightGroup(_) => ()
    ()
    Result::Ok(())

fn rows_from_glam_matrix(matrix_: glam::Mat4) -> [[f32; 4]; 4]:
    matrix_.transpose().to_cols_array_2d()

fn retarget_title_face_root_commands(commands: &[DisplayListCommand]) -> Array<DisplayListCommand>:
    let mut rewritten = (fn(__kain_ctor_arg0): Vec__new_())((commands.len() + 2))
    for command in commands:
        match command:
            DisplayListCommand::CallDisplayList { display_list_id: display_list_id } if (display_list_id == "mario_face_cap_off_dl") =>
                rewritten.push(DisplayListCommand::SetCombineMode { mode: CombineMode__Vertex })
                ()
                rewritten.push(DisplayListCommand::CallDisplayList { display_list_id: ("mario_face_part_cap_off_dl").to_string() })
                ()
            _ => rewritten.push(command.clone())
    ()
    rewritten

fn collect_display_list_closure(display_list_name: String, parsed_display_lists: &Map<String, Array<ParsedGfxCommand>>, visited: &mut Set<String>) -> Result<(), String>:
    if (!visited.insert(display_list_name.to_string())):
        return Result::Ok(())
    let commands = parsed_display_lists.get(display_list_name).ok_or_else(fn(): f"missing display list `{display_list_name}`")?
    for command in commands:
        match command:
            ParsedGfxCommand::DisplayList(child_name) =>
                collect_display_list_closure(child_name, parsed_display_lists, visited)?
                ()
            _ => ()
    ()
    Result::Ok(())

fn convert_display_list_commands(parsed_commands: &[ParsedGfxCommand], parsed_display_lists: &Map<String, Array<ParsedGfxCommand>>, parsed_vertex_arrays: &Map<String, Array<ParsedVertex>>) -> Result<Array<DisplayListCommand>, String>:
    let mut commands = Vec__new_()
    for parsed_command in parsed_commands:
        match parsed_command:
            ParsedGfxCommand::Vertex { vertex_array_name: vertex_array_name, count: count, slot: slot } =>
                let parsed_vertices = parsed_vertex_arrays.get(vertex_array_name).ok_or_else(fn(): f"missing vertex array `{vertex_array_name}`")?
                let vertices = parsed_vertices.iter().take((*count)).map(fn(vertex_): Fast3dVertex { position: vertex_.position, uv: [(vertex_.uv_raw[0] / ((32 * 32))), (vertex_.uv_raw[1] / ((32 * 32)))], color: [255, 255, 255, 255], normal: Option::Some(vertex_.normal) }).collect()
                commands.push(DisplayListCommand::LoadVertices { slot: (*slot), vertices: vertices })
                ()
            ParsedGfxCommand::TwoTriangles(left, right) =>
                commands.push(DisplayListCommand::DrawTriangles { triangles: [(*left), (*right)] })
                ()
            ParsedGfxCommand::OneTriangle(triangle) =>
                commands.push(DisplayListCommand::DrawTriangles { triangles: [(*triangle)] })
                ()
            ParsedGfxCommand::DisplayList(display_list_name) =>
                if (!parsed_display_lists.contains_key(display_list_name)):
                    return Result::Err(f"display list `{display_list_name}` missing")
                commands.push(DisplayListCommand::CallDisplayList { display_list_id: display_list_name.clone() })
                ()
            ParsedGfxCommand::SetTexture(texture_name) =>
                commands.push(DisplayListCommand::BindTexture { texture_id: texture_name.clone() })
                ()
            ParsedGfxCommand::SetCombineMode(mode) =>
                commands.push(DisplayListCommand::SetCombineMode { mode: (*mode) })
                ()
            ParsedGfxCommand::SetLightGroup(light_group_name) =>
                commands.push(DisplayListCommand::SetLightGroup { light_group_id: light_group_name.clone() })
                ()
    ()
    Result::Ok(commands)

fn parse_light_groups(input: String) -> Result<Map<String, ParsedLightGroup>, String>:
    let light_regex = Regex__new_("static const Lights1 (?P<name>[A-Za-z0-9_]+)\\s*=\\s*gdSPDefLights1\\(\\s*(?P<a0>0x[0-9a-fA-F]+|\\d+),\\s*(?P<a1>0x[0-9a-fA-F]+|\\d+),\\s*(?P<a2>0x[0-9a-fA-F]+|\\d+),\\s*(?P<d0>0x[0-9a-fA-F]+|\\d+),\\s*(?P<d1>0x[0-9a-fA-F]+|\\d+),\\s*(?P<d2>0x[0-9a-fA-F]+|\\d+),\\s*(?P<x>0x[0-9a-fA-F]+|\\d+),\\s*(?P<y>0x[0-9a-fA-F]+|\\d+),\\s*(?P<z>0x[0-9a-fA-F]+|\\d+)\\s*\\);").map_err(fn(error): f"failed to compile light regex: {error}")?
    let mut lights = HashMap__new_()
    for capture in light_regex.captures_iter(input):
        lights.insert(capture["name"].to_string(), ParsedLightGroup { ambient_color: [parse_u8_literal(&capture["a0"])?, parse_u8_literal(&capture["a1"])?, parse_u8_literal(&capture["a2"])?, 255], diffuse_color: [parse_u8_literal(&capture["d0"])?, parse_u8_literal(&capture["d1"])?, parse_u8_literal(&capture["d2"])?, 255], direction: [parse_signed_component(&capture["x"])?, parse_signed_component(&capture["y"])?, parse_signed_component(&capture["z"])?] })
        ()
    ()
    Result::Ok(lights)

fn parse_vertex_arrays(input: String) -> Result<Map<String, Array<ParsedVertex>>, String>:
    let array_start_regex = Regex__new_("static const Vtx (?P<name>[A-Za-z0-9_]+)\\[\\]\\s*=\\s*\\{").map_err(fn(error): f"failed to compile vertex start regex: {error}")?
    let vertex_line_regex = Regex__new_("\\{\\{\\{\\s*(?P<x>-?\\d+),\\s*(?P<y>-?\\d+),\\s*(?P<z>-?\\d+)\\},\\s*0,\\s*\\{\\s*(?P<u>-?\\d+),\\s*(?P<v>-?\\d+)\\},\\s*\\{(?P<nx>0x[0-9a-fA-F]+|-?\\d+),\\s*(?P<ny>0x[0-9a-fA-F]+|-?\\d+),\\s*(?P<nz>0x[0-9a-fA-F]+|-?\\d+),\\s*(?P<na>0x[0-9a-fA-F]+|-?\\d+)\\}\\}\\}").map_err(fn(error): f"failed to compile vertex regex: {error}")?
    let mut arrays = HashMap__new_()
    let mut current_name: Option<String> = none
    let mut current_vertices = Vec__new_()
    for line_ in input.lines():
        if current_name.is_none():
            match array_start_regex.captures(line_):
                Some(capture) =>
                    current_name = Option::Some(capture["name"].to_string())
                    ()
                    current_vertices.clear()
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            continue
        if line_.trim_start().starts_with("};"):
            match current_name.take():
                Some(name) =>
                    arrays.insert(name, current_vertices.clone())
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            current_vertices.clear()
            ()
            continue
        match vertex_line_regex.captures(line_):
            Some(capture) =>
                current_vertices.push(ParsedVertex { position: [capture["x"].parse().unwrap_or(0), capture["y"].parse().unwrap_or(0), capture["z"].parse().unwrap_or(0)], uv_raw: [capture["u"].parse().unwrap_or(0), capture["v"].parse().unwrap_or(0)], normal: [parse_signed_component(&capture["nx"])?, parse_signed_component(&capture["ny"])?, parse_signed_component(&capture["nz"])?] })
                ()
            _ => ()
    ()
    Result::Ok(arrays)

fn parse_display_lists(input: String) -> Result<Map<String, Array<ParsedGfxCommand>>, String>:
    let display_list_start_regex = Regex__new_("const Gfx (?P<name>[A-Za-z0-9_]+)\\[\\]\\s*=\\s*\\{").map_err(fn(error): f"failed to compile display-list start regex: {error}")?
    let vertex_regex = Regex__new_("gsSPVertex\\((?P<name>[A-Za-z0-9_]+),\\s*(?P<count>\\d+),\\s*(?P<slot>\\d+)\\)").map_err(fn(error): f"failed to compile gsSPVertex regex: {error}")?
    let tri2_regex = Regex__new_("gsSP2Triangles\\(\\s*(?P<a0>\\d+),\\s*(?P<a1>\\d+),\\s*(?P<a2>\\d+),\\s*0x0,\\s*(?P<b0>\\d+),\\s*(?P<b1>\\d+),\\s*(?P<b2>\\d+),\\s*0x0\\)").map_err(fn(error): f"failed to compile gsSP2Triangles regex: {error}")?
    let tri1_regex = Regex__new_("gsSP1Triangle\\(\\s*(?P<a0>\\d+),\\s*(?P<a1>\\d+),\\s*(?P<a2>\\d+),\\s*0x0\\)").map_err(fn(error): f"failed to compile gsSP1Triangle regex: {error}")?
    let call_regex = Regex__new_("gsSPDisplayList\\((?P<name>[A-Za-z0-9_]+)\\)").map_err(fn(error): f"failed to compile gsSPDisplayList regex: {error}")?
    let texture_regex = Regex__new_("gsDPSetTextureImage\\([^,]+,\\s*[^,]+,\\s*[^,]+,\\s*(?P<name>[A-Za-z0-9_]+)\\)").map_err(fn(error): f"failed to compile texture regex: {error}")?
    let combine_mode_regex = Regex__new_("gsDPSetCombineMode\\((?P<name>[A-Za-z0-9_]+),\\s*[A-Za-z0-9_]+\\)").map_err(fn(error): f"failed to compile combine regex: {error}")?
    let light_regex = Regex__new_("gsSPLight\\(&(?P<name>[A-Za-z0-9_]+)\\.(?:l|a),\\s*[12]\\)").map_err(fn(error): f"failed to compile light regex: {error}")?
    let mut display_lists = HashMap__new_()
    let mut current_name: Option<String> = none
    let mut current_commands = Vec__new_()
    for line_ in input.lines():
        if current_name.is_none():
            match display_list_start_regex.captures(line_):
                Some(capture) =>
                    current_name = Option::Some(capture["name"].to_string())
                    ()
                    current_commands.clear()
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            continue
        if line_.trim_start().starts_with("};"):
            match current_name.take():
                Some(name) =>
                    display_lists.insert(name, current_commands.clone())
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            current_commands.clear()
            ()
            continue
        match vertex_regex.captures(line_):
            Some(capture) =>
                current_commands.push(ParsedGfxCommand::Vertex { vertex_array_name: capture["name"].to_string(), count: capture["count"].parse().unwrap_or(0), slot: capture["slot"].parse().unwrap_or(0) })
                ()
                continue
            _ =>
                ()
                ()
        match tri2_regex.captures(line_):
            Some(capture) =>
                current_commands.push(ParsedGfxCommand::TwoTriangles([capture["a0"].parse().unwrap_or(0), capture["a1"].parse().unwrap_or(0), capture["a2"].parse().unwrap_or(0)], [capture["b0"].parse().unwrap_or(0), capture["b1"].parse().unwrap_or(0), capture["b2"].parse().unwrap_or(0)]))
                ()
                continue
            _ =>
                ()
                ()
        match tri1_regex.captures(line_):
            Some(capture) =>
                current_commands.push(ParsedGfxCommand::OneTriangle([capture["a0"].parse().unwrap_or(0), capture["a1"].parse().unwrap_or(0), capture["a2"].parse().unwrap_or(0)]))
                ()
                continue
            _ =>
                ()
                ()
        match call_regex.captures(line_):
            Some(capture) =>
                current_commands.push(ParsedGfxCommand::DisplayList(capture["name"].to_string()))
                ()
                continue
            _ =>
                ()
                ()
        match texture_regex.captures(line_):
            Some(capture) =>
                match map_mario_texture_name(&capture["name"]):
                    Some(texture_name) =>
                        current_commands.push(ParsedGfxCommand::SetTexture(texture_name.to_string()))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                continue
            _ =>
                ()
                ()
        match combine_mode_regex.captures(line_):
            Some(capture) =>
                match map_sm64_combine_mode(&capture["name"]):
                    Some(mode) =>
                        current_commands.push(ParsedGfxCommand::SetCombineMode(mode))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                continue
            _ =>
                ()
                ()
        match light_regex.captures(line_):
            Some(capture) =>
                current_commands.push(ParsedGfxCommand::SetLightGroup(capture["name"].to_string()))
                ()
            _ => ()
    ()
    Result::Ok(display_lists)

fn map_mario_texture_name(name: String) -> Option<String>:
    match name:
        "mario_texture_eyes_front" => Option::Some("mario_eyes_front")
        "mario_texture_mustache" => Option::Some("mario_mustache")
        "mario_texture_hair_sideburn" => Option::Some("mario_sideburn")
        _ => none

fn map_sm64_combine_mode(name: String) -> Option<CombineMode>:
    match name:
        "G_CC_BLENDRGBFADEA" => Option::Some(CombineMode__TextureVertex)
        "G_CC_DECALFADE" => Option::Some(CombineMode__Texture)
        "G_CC_SHADEFADEA" => Option::Some(CombineMode__Vertex)
        "G_CC_SHADE" => Option::Some(CombineMode__Vertex)
        _ => none

fn parse_u8_literal(value: String) -> Result<u8, String>:
    let parsed = match value.strip_prefix("0x"):
        Some(stripped) => u16__from_str_radix(stripped, 16).map_err(fn(error): f"invalid hex literal: {error}")?
        _ => value.parse().map_err(fn(error): f"invalid decimal literal: {error}")?
    Result::Ok(parsed as u8)

fn parse_signed_component(value: String) -> Result<f32, String>:
    let raw = parse_u8_literal(value)?
    Result::Ok(((raw as i8) as f32 / 127))

