use kain_core::ast::Block

use kain_core::ast::ElseBranch

use kain_core::ast::Expr

use kain_core::ast::Stmt

use kain_core::ast::Type

use kain_core::error::KainResult

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

use std::collections::HashSet

use ue5::ue5::Ue5Context

use crate::editor::details::DetailsGenerator

use crate::editor::slate::SlateGenerator

use crate::editor::viewport::ViewportGenerator

@doc(doc = " Output from UE5 Editor codegen")
pub struct Ue5EditorOutput:
    header: String
    source: String

@doc(doc = " Generate UE5 Editor C++ code")
@doc(doc = " Takes an optional Ue5Context from the runtime pass to access actors/components")
pub fn generate(program: &kain_core::types::TypedProgram, plugin_name: String, copyright: Option<String>) -> Result<Ue5EditorOutput, KainError>:
    generate_with_context(program, plugin_name, none, copyright)

@doc(doc = " Generate UE5 Editor C++ code with a shared context from runtime codegen")
pub fn generate_with_context(program: &kain_core::types::TypedProgram, plugin_name: String, runtime_context: Option<ue5::ue5::Ue5Context>, copyright: Option<String>) -> Result<Ue5EditorOutput, KainError>:
    let mut gen = Ue5EditorGen__new_(plugin_name, runtime_context, copyright)
    Result::Ok(gen.gen_program(program))

@doc(doc = " A single editor item's generated output (for modular file output)")
pub struct EditorItem:
    name: String
    kind: String
    header: String
    source: String

@doc(doc = " Check if an attribute name is an editor attribute.")
@doc(doc = " Uses EditorAttributesRegistry when available, with a hardcoded fallback")
@doc(doc = " to ensure detection works regardless of CWD (e.g., running from testing/CorpusTest/).")
pub fn is_editor_attribute(name: String) -> Bool:
    const BUILTIN_EDITOR_ATTRS: Array<String> = ["slate", "details", "property_customization", "viewport", "asset_editor", "editor_module", "commands", "toolbar", "menu"]

    if BUILTIN_EDITOR_ATTRS.contains(&name):
        return true
    let ctx = Ue5Context__new_("temp", none)
    ctx.editor_attributes.is_editor_attribute(name)

@doc(doc = " Get all known editor attribute names from the registry")
pub fn get_editor_attributes() -> Array<String>:
    let ctx = Ue5Context__new_("temp", none)
    ctx.editor_attributes.attribute_names().into_iter().map(fn(s): s.to_string()).collect()

@doc(doc = " Generate per-item editor files for modular output.")
@doc(doc = " Returns a Vec of EditorItem, one per @slate/@details/@viewport/etc struct.")
pub fn generate_per_item(program: &kain_core::types::TypedProgram, plugin_name: String, copyright: Option<String>) -> Result<Array<EditorItem>, KainError>:
    let mut items = Vec__new_()
    let mut detail_registrations = Vec__new_()
    let mut shared_context = Ue5Context__new_(plugin_name, copyright)
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Enum(e) =>
                shared_context.register_enum(e.ast.name.clone(), f"E{e.ast.name}.h")
                ()
            kain_core__types__TypedItem::Struct(s) =>
                let is_component = s.ast.attributes.iter().any(fn(a): (a.name == "component"))
                if is_component:
                    shared_context.register_component(s.ast.name.clone(), f"U{s.ast.name}.h")
                    ()
                else:
                    shared_context.register_struct(s.ast.name.clone(), f"F{s.ast.name}.h")
                    ()
            kain_core__types__TypedItem::Actor(a) =>
                shared_context.register_actor(a.ast.name.clone(), f"A{a.ast.name}.h")
                ()
            kain_core__types__TypedItem::Component(c) =>
                shared_context.register_component(c.ast.name.clone(), f"U{c.ast.name}.h")
                ()
            kain_core__types__TypedItem::TypeAlias(alias) =>
                if (none):
                    shared_context.register_delegate(alias.ast.name.clone(), f"{plugin_name}Delegates.h")
                    ()
            _ => ()
    ()
    let mut slate_widget_map: Map<String, String> = HashMap__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(st) =>
                if st.ast.attributes.iter().any(fn(a): (a.name == "slate")):
                    let output_name = f"S{st.ast.name}"
                    slate_widget_map.insert(st.ast.name.clone(), output_name.clone())
                    ()
                    slate_widget_map.insert(output_name.clone(), output_name.clone())
                    ()
                elif st.ast.attributes.iter().any(fn(a): (a.name == "viewport")):
                    let base_name = st.ast.name.strip_suffix("Viewport").unwrap_or(&st.ast.name)
                    let output_name = f"S{base_name}Viewport"
                    slate_widget_map.insert(st.ast.name.clone(), output_name.clone())
                    ()
                    slate_widget_map.insert(output_name.clone(), output_name.clone())
                    ()
            _ => ()
    ()
    let program_has_shaders = (*program).items.iter().any(fn(item): none)
    let toolbar_names: Array<String> = (*program).items.iter().filter_map(fn(item): none).collect()
    let mut delegate_param_types: Map<String, Array<String>> = HashMap__new_()
    let mut tmp_gen = Ue5EditorGen__new_(plugin_name, Option::Some(shared_context.clone()), copyright)
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Enum(e) =>
                tmp_gen.type_mapper.register_enum(e.ast.name.clone())
                ()
            kain_core__types__TypedItem::Struct(s) => if s.ast.attributes.iter().any(fn(a): (a.name == "component")): none else: none
            kain_core__types__TypedItem::Actor(a) =>
                tmp_gen.type_mapper.register_actor(a.ast.name.clone())
                ()
            kain_core__types__TypedItem::Component(c) =>
                tmp_gen.type_mapper.register_component(c.ast.name.clone())
                ()
            kain_core__types__TypedItem::TypeAlias(alias) =>
                if (none):
                    tmp_gen.type_mapper.register_delegate(alias.ast.name.clone())
                    ()
            _ => ()
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::TypeAlias(alias) =>
                match &alias.ast.target:
                    kain_core__ast__Type::Function { params: params } =>
                        let cpp_params: Array<String> = params.iter().map(fn(p): tmp_gen.map_type(p)).collect()
                        delegate_param_types.insert(alias.ast.name.clone(), cpp_params)
                        ()
                    _ => ()
            _ => ()
    ()
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(st) =>
                let attrs: Array<String> = st.ast.attributes.iter().map(fn(a): a.name.as_str()).collect()
                let (kind, output_name) = if attrs.contains(&"slate"):
                    ("Slate", f"S{st.ast.name}")
                elif attrs.contains(&"details"):
                    let base_name = st.ast.name.strip_suffix("Details").unwrap_or(&st.ast.name)
                    ("Details", f"F{base_name}DetailsCustomization")
                elif attrs.contains(&"viewport"):
                    let base_name = st.ast.name.strip_suffix("Viewport").unwrap_or(&st.ast.name)
                    ("Viewport", f"S{base_name}Viewport")
                elif attrs.contains(&"toolbar"):
                    ("Toolbar", f"F{st.ast.name}Extension")
                elif attrs.contains(&"asset_editor"):
                    ("AssetEditor", f"F{st.ast.name}Toolkit")
                elif attrs.contains(&"editor_module"):
                    let base_name = st.ast.name.strip_suffix("Module").unwrap_or(&st.ast.name)
                    ("EditorModule", f"F{base_name}Module")
                elif attrs.contains(&"asset_type"):
                    ("AssetType", f"U{st.ast.name}")
                else:
                    continue
                let mut gen = Ue5EditorGen__new_(plugin_name, Option::Some(shared_context.clone()), copyright)
                gen.has_shaders = program_has_shaders
                ()
                gen.delegate_param_types = delegate_param_types.clone()
                ()
                gen.toolbar_names = toolbar_names.clone()
                ()
                for item in &(*program).items:
                    match item:
                        kain_core__types__TypedItem::Enum(e) =>
                            gen.type_mapper.register_enum(e.ast.name.clone())
                            ()
                        kain_core__types__TypedItem::Struct(s) => if s.ast.attributes.iter().any(fn(a): (a.name == "component")): none else: none
                        kain_core__types__TypedItem::Actor(a) =>
                            gen.type_mapper.register_actor(a.ast.name.clone())
                            ()
                        kain_core__types__TypedItem::Component(c) =>
                            gen.type_mapper.register_component(c.ast.name.clone())
                            ()
                        kain_core__types__TypedItem::TypeAlias(alias) =>
                            if (none):
                                gen.type_mapper.register_delegate(alias.ast.name.clone())
                                ()
                        _ => ()
                ()
                let used_widgets: Set<String> = if (kind == "Slate"):
                    collect_widget_names_from_struct(&st.ast)
                else:
                    HashSet__new_()
                gen.write_item_header_preamble(kind, plugin_name, &used_widgets)
                ()
                gen.source.push_line("// Generated by KAIN - UE5 Editor Tools")
                ()
                gen.source.push_line(&f"#include \"{output_name}.h\"")
                ()
                if ((kind == "Slate") || (kind == "Details")):
                    gen.source.push_line("#include \"SlateOptMacros.h\"")
                    ()
                    ()
                    ()
                    ()
                if (kind == "Slate"):
                    let mut sibling_includes: Array<String> = Vec__new_()
                    for field in &st.ast.fields:
                        match &field.ty:
                            kain_core__ast__Type::Named { name: name } =>
                                match slate_widget_map.get(name.as_str()):
                                    Some(header_name) =>
                                        if ((*header_name) != output_name):
                                            sibling_includes.push(header_name.clone())
                                            ()
                                    _ => ()
                            _ => ()
                    ()
                    match st.ast.methods.iter().find(fn(m): (m.name == "Compose")):
                        Some(compose_fn) =>
                            collect_widget_refs_from_block(&compose_fn.body, &slate_widget_map, &output_name, &mut sibling_includes)
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    sibling_includes.sort()
                    ()
                    sibling_includes.dedup()
                    ()
                    for sibling in &sibling_includes:
                        gen.source.push_line(&f"#include \"{sibling}.h\"")
                        ()
                    ()
                    ()
                elif (kind == "AssetEditor"):
                    let mut widget_includes: Array<String> = Vec__new_()
                    for field in &st.ast.fields:
                        match &field.ty:
                            kain_core__ast__Type::Named { name: name } =>
                                match slate_widget_map.get(name.as_str()):
                                    Some(header_name) =>
                                        widget_includes.push(header_name.clone())
                                        ()
                                    _ => ()
                            _ => ()
                    ()
                    widget_includes.sort()
                    ()
                    widget_includes.dedup()
                    ()
                    for widget in &widget_includes:
                        gen.source.push_line(&f"#include \"{widget}.h\"")
                        ()
                    ()
                    ()
                gen.write_blank_source()
                ()
                gen.gen_item(item)
                ()
                detail_registrations.extend(gen.detail_registrations.clone())
                ()
                items.push(EditorItem { name: output_name, kind: kind.to_string(), header: gen.header.build(), source: gen.source.build() })
                ()
            _ => ()
    ()
    Result::Ok(items)

@doc(doc = " Recursively scan a block for references to other Slate widgets (by constructor call name)")
fn collect_widget_refs_from_block(block: &kain_core::ast::Block, widget_map: &Map<String, String>, self_name: String, out_: &mut Array<String>):
    for stmt in &(*block).stmts:
        match stmt:
            kain_core__ast__Stmt::Let { value: Some(expr) } =>
                collect_widget_refs_from_expr(expr, widget_map, self_name, out_)
                ()
            kain_core__ast__Stmt::Expr(expr) =>
                collect_widget_refs_from_expr(expr, widget_map, self_name, out_)
                ()
            kain_core__ast__Stmt::Return(Some(expr), _) =>
                collect_widget_refs_from_expr(expr, widget_map, self_name, out_)
                ()
            _ => ()

@doc(doc = " Recursively scan an expression for references to other Slate widgets")
fn collect_widget_refs_from_expr(expr: &kain_core::ast::Expr, widget_map: &Map<String, String>, self_name: String, out_: &mut Array<String>):
    match expr:
        kain_core__ast__Expr::Call { callee: callee, args: args } =>
            match &(*(*callee)):
                kain_core__ast__Expr::Ident(name, _) =>
                    match widget_map.get(name.as_str()):
                        Some(header_name) =>
                            if ((*header_name) != self_name):
                                out_.push(header_name.clone())
                                ()
                                ()
                                ()
                                ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            for arg in args:
                collect_widget_refs_from_expr(&arg.value, widget_map, self_name, out_)
                ()
        kain_core__ast__Expr::MethodCall { receiver: receiver, args: args } =>
            collect_widget_refs_from_expr(receiver, widget_map, self_name, out_)
            ()
            for arg in args:
                collect_widget_refs_from_expr(&arg.value, widget_map, self_name, out_)
                ()
        kain_core__ast__Expr::Ident(name, _) =>
            match widget_map.get(name.as_str()):
                Some(header_name) =>
                    if ((*header_name) != self_name):
                        out_.push(header_name.clone())
                        ()
                _ => ()
        _ => ()

struct StringBuilder:
    lines: Array<String>

impl StringBuilder:
    fn new_() -> StringBuilder:
        StringBuilder { lines: Vec__new_() }

    fn push_line(_self: &mut StringBuilder, text: String):
        (*_self).lines.push(f"{text}\n")
        ()

    fn build(_self: &StringBuilder) -> String:
        (*_self).lines.join("")


struct Ue5EditorGen:
    header: StringBuilder
    source: StringBuilder
    indent: usize
    context: ue5::ue5::Ue5Context
    plugin_name: String
    detail_registrations: Array<String>
    has_shaders: Bool
    delegate_param_types: Map<String, Array<String>>
    toolbar_names: Array<String>
    type_mapper: ue5::ue5::types::TypeMapper

impl Ue5EditorGen:
    fn new_(plugin_name: String, runtime_context: Option<ue5::ue5::Ue5Context>, copyright: Option<String>) -> Ue5EditorGen:
        let context = runtime_context.unwrap_or_else(fn(): Ue5Context__new_("EditorTools", copyright))
        let type_mapper = TypeMapper__with_knowledge(context.knowledge.clone())
        Ue5EditorGen { header: StringBuilder__new_(), source: StringBuilder__new_(), indent: 0, context: context, plugin_name: plugin_name.to_string(), detail_registrations: Vec__new_(), has_shaders: false, delegate_param_types: HashMap__new_(), toolbar_names: Vec__new_(), type_mapper: type_mapper }

    fn write_item_header_preamble(_self: &mut Ue5EditorGen, kind: String, plugin_name: String, used_widgets: &Set<String>):
        (*_self).header.push_line("// Generated by KAIN - UE5 Editor Tools")
        ()
        (*_self).header.push_line("#pragma once")
        ()
        (*_self).header.push_line("#include \"CoreMinimal.h\"")
        ()
        if ((((kind == "Slate") || (kind == "Details")) || (kind == "Viewport")) || (kind == "AssetEditor")):
            (*_self).header.push_line(&f"#include \"{plugin_name}EditorTypes.h\"")
            ()
            (*_self).header.push_line(&f"#include \"{plugin_name}.h\"")
            ()
            (*_self).header.push_line(&f"#if __has_include(\"{plugin_name}Delegates.h\")")
            ()
            (*_self).header.push_line(&f"#include \"{plugin_name}Delegates.h\"")
            ()
            (*_self).header.push_line("#endif")
            ()
            ()
            ()
            ()
        else:
            (*_self).header.push_line(&f"#include \"{plugin_name}.h\"")
            ()
            ()
            ()
            ()
        match kind:
            "Slate" =>
                (*_self).header.push_line("#include \"Widgets/SCompoundWidget.h\"")
                ()
                (*_self).header.push_line("#include \"Widgets/DeclarativeSyntaxSupport.h\"")
                ()
                (*_self).header.push_line("#include \"Widgets/Input/SComboBox.h\"")
                ()
                let emit_all = used_widgets.is_empty()
                cond_include!("Widgets/Views/SListView.h", "ListView", "SListView", "TreeView", "STreeView", "TileView", "STileView")
                cond_include!("Widgets/Input/SButton.h", "Button", "SButton")
                cond_include!("Widgets/Input/SCheckBox.h", "CheckBox", "SCheckBox")
                cond_include!("Widgets/Input/SComboBox.h", "ComboBox", "SComboBox", "ComboButton", "SComboButton")
                cond_include!("Widgets/Input/SEditableTextBox.h", "EditableTextBox", "SEditableTextBox", "EditableText", "SEditableText")
                cond_include!("Widgets/Input/SSlider.h", "Slider", "SSlider")
                cond_include!("Widgets/Input/SSpinBox.h", "SpinBox", "SSpinBox")
                cond_include!("Widgets/Text/STextBlock.h", "TextBlock", "STextBlock", "Text", "Label")
                cond_include!("Widgets/Images/SImage.h", "Image", "SImage", "shader_image")
                cond_include!("Widgets/SNullWidget.h", "SNullWidget", "NullWidget", "SMultiColumnTableRow", "table_row", "multi_column_row")
                cond_include!("Widgets/Layout/SScrollBox.h", "ScrollBox", "SScrollBox")
                cond_include!("Widgets/Layout/SSplitter.h", "Splitter", "SSplitter", "HSplitter", "VSplitter")
                cond_include!("Widgets/Layout/SBorder.h", "Border", "SBorder")
                cond_include!("Widgets/SToolTip.h", "ToolTip", "SToolTip")
                cond_include!("Widgets/Views/STableRow.h", "TableRow", "STableRow")
                cond_include!("Widgets/Views/SMultiColumnTableRow.h", "SMultiColumnTableRow", "MultiColumnTableRow", "table_row", "multi_column_row")
                cond_include!("Widgets/Views/SHeaderRow.h", "SHeaderRow", "HeaderRow")
                cond_include!("Widgets/Colors/SColorBlock.h", "ColorBlock", "SColorBlock", "Color", "ColorPicker", "SColorPicker")
                cond_include!("Widgets/Layout/SBox.h", "Box", "SBox")
                cond_include!("Widgets/Layout/SGridPanel.h", "GridPanel", "SGridPanel")
                cond_include!("Widgets/Layout/SWrapBox.h", "WrapBox", "SWrapBox")
                ()
                ()
            "Details" =>
                (*_self).header.push_line("#include \"IDetailCustomization.h\"")
                ()
                (*_self).header.push_line("#include \"DetailLayoutBuilder.h\"")
                ()
                (*_self).header.push_line("#include \"DetailCategoryBuilder.h\"")
                ()
                (*_self).header.push_line("#include \"DetailWidgetRow.h\"")
                ()
                (*_self).header.push_line("#include \"PropertyEditorModule.h\"")
                ()
                (*_self).header.push_line("#include \"PropertyCustomizationHelpers.h\"")
                ()
                (*_self).header.push_line("#include \"Widgets/Input/SSpinBox.h\"")
                ()
                (*_self).header.push_line("#include \"Widgets/Input/SButton.h\"")
                ()
                (*_self).header.push_line("#include \"Widgets/Input/SCheckBox.h\"")
                ()
                (*_self).header.push_line("#include \"Widgets/Input/SEditableTextBox.h\"")
                ()
                (*_self).header.push_line("#include \"Widgets/Input/SMultiLineEditableTextBox.h\"")
                ()
                (*_self).header.push_line("#include \"Widgets/Colors/SColorBlock.h\"")
                ()
                ()
                ()
                ()
            "Viewport" =>
                (*_self).header.push_line("#include \"SEditorViewport.h\"")
                ()
                (*_self).header.push_line("#include \"EditorViewportClient.h\"")
                ()
                (*_self).header.push_line("#include \"PreviewScene.h\"")
                ()
                ()
                ()
                ()
            "Toolbar" =>
                (*_self).header.push_line("#include \"Framework/MultiBox/MultiBoxBuilder.h\"")
                ()
                (*_self).header.push_line("#include \"Styling/AppStyle.h\"")
                ()
                ()
                ()
                ()
            "AssetEditor" =>
                (*_self).header.push_line("#include \"Toolkits/AssetEditorToolkit.h\"")
                ()
                ()
                ()
                ()
            "EditorModule" =>
                (*_self).header.push_line("#include \"Modules/ModuleInterface.h\"")
                ()
                (*_self).header.push_line("#include \"Modules/ModuleManager.h\"")
                ()
                (*_self).header.push_line("#include \"LevelEditor.h\"")
                ()
                (*_self).header.push_line("#include \"Framework/MultiBox/MultiBoxExtender.h\"")
                ()
                if (*_self).has_shaders:
                    (*_self).header.push_line("#include \"Interfaces/IPluginManager.h\"")
                    ()
                    (*_self).header.push_line("#include \"ShaderCore.h\"")
                    ()
                    ()
                    ()
                    ()
                ()
            "AssetType" =>
                (*_self).header.push_line("#include \"Engine/DataAsset.h\"")
                ()
                (*_self).header.push_line("#include \"AssetTypeActions_Base.h\"")
                ()
                (*_self).header.push_line("#include \"AssetTypeCategories.h\"")
                ()
                ()
                ()
                ()
            _ => ()
        (*_self).write_blank_header()
        ()

    fn push_indent(_self: &mut Ue5EditorGen):
        (*_self).indent = ((*_self).indent + 1)
        ()

    fn pop_indent(_self: &mut Ue5EditorGen):
        if ((*_self).indent > 0):
            (*_self).indent = ((*_self).indent - 1)
            ()

    fn indent_str(_self: &Ue5EditorGen) -> String:
        ("\t").repeat((*_self).indent)

    fn write_header(_self: &mut Ue5EditorGen, line_: String):
        let indented = f"{(*_self).indent_str()}{line_}"
        (*_self).header.push_line(&indented)
        ()

    fn write_source(_self: &mut Ue5EditorGen, line_: String):
        let indented = f"{(*_self).indent_str()}{line_}"
        (*_self).source.push_line(&indented)
        ()

    fn write_blank_header(_self: &mut Ue5EditorGen):
        (*_self).header.push_line("")
        ()

    fn write_blank_source(_self: &mut Ue5EditorGen):
        (*_self).source.push_line("")
        ()

    fn gen_program(_self: &mut Ue5EditorGen, program: &kain_core::types::TypedProgram) -> Ue5EditorOutput:
        let has_asset_types = (*program).items.iter().any(fn(item): none)
        let has_slate = (*program).items.iter().any(fn(item): none)
        let has_modules = (*program).items.iter().any(fn(item): none)
        let has_details = (*program).items.iter().any(fn(item): none)
        let has_viewports = (*program).items.iter().any(fn(item): none)
        let has_toolbars = (*program).items.iter().any(fn(item): none)
        (*_self).toolbar_names = (*program).items.iter().filter_map(fn(item): none).collect()
        ()
        if ((has_slate || has_details) || has_viewports):
            (*_self).context.use_feature("Slate")
            ()
            ()
            ()
            ()
        if has_asset_types:
            (*_self).context.use_feature("Projects")
            ()
            ()
            ()
            ()
        if has_details:
            (*_self).context.use_feature("PropertyEditor")
            ()
            ()
            ()
            ()
        if has_viewports:
            (*_self).context.use_feature("AdvancedPreviewScene")
            ()
            ()
            ()
            ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::TypeAlias(alias) =>
                    match &alias.ast.target:
                        kain_core__ast__Type::Function { params: params } =>
                            let cpp_params: Array<String> = params.iter().map(fn(p): (*_self).map_type(p)).collect()
                            (*_self).delegate_param_types.insert(alias.ast.name.clone(), cpp_params)
                            ()
                        _ => ()
                _ => ()
        ()
        (*_self).header.push_line("// Generated by KAIN - UE5 Editor Tools")
        ()
        (*_self).header.push_line("#pragma once")
        ()
        (*_self).header.push_line("#include \"CoreMinimal.h\"")
        ()
        (*_self).header.push_line(&f"#include \"{(*_self).plugin_name}.h\"")
        ()
        if has_asset_types:
            (*_self).header.push_line("#include \"Engine/DataAsset.h\"")
            ()
            ()
            ()
            ()
        if has_slate:
            (*_self).header.push_line("#include \"Widgets/SCompoundWidget.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/DeclarativeSyntaxSupport.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Views/SListView.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Views/STreeView.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Input/SButton.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Input/SCheckBox.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Input/SComboBox.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Input/SEditableTextBox.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Input/SSlider.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Input/SSpinBox.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Text/STextBlock.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Images/SImage.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Layout/SScrollBox.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Layout/SSplitter.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Layout/SBorder.h\"")
            ()
            ()
            ()
            ()
        if has_details:
            (*_self).header.push_line("#include \"IDetailCustomization.h\"")
            ()
            (*_self).header.push_line("#include \"DetailLayoutBuilder.h\"")
            ()
            (*_self).header.push_line("#include \"DetailCategoryBuilder.h\"")
            ()
            (*_self).header.push_line("#include \"DetailWidgetRow.h\"")
            ()
            (*_self).header.push_line("#include \"PropertyEditorModule.h\"")
            ()
            (*_self).header.push_line("#include \"PropertyCustomizationHelpers.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Input/SCheckBox.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Input/SEditableTextBox.h\"")
            ()
            (*_self).header.push_line("#include \"Widgets/Input/SMultiLineEditableTextBox.h\"")
            ()
            ()
            ()
            ()
        if has_viewports:
            (*_self).header.push_line("#include \"SEditorViewport.h\"")
            ()
            (*_self).header.push_line("#include \"EditorViewportClient.h\"")
            ()
            (*_self).header.push_line("#include \"PreviewScene.h\"")
            ()
            ()
            ()
            ()
        if has_asset_types:
            (*_self).header.push_line("#include \"AssetTypeActions_Base.h\"")
            ()
            (*_self).header.push_line("#include \"AssetTypeCategories.h\"")
            ()
            ()
            ()
            ()
        if has_modules:
            (*_self).header.push_line("#include \"Modules/ModuleInterface.h\"")
            ()
            (*_self).header.push_line("#include \"Modules/ModuleManager.h\"")
            ()
            ()
            ()
            ()
        (*_self).write_blank_header()
        ()
        (*_self).source.push_line("// Generated by KAIN - UE5 Editor Tools")
        ()
        (*_self).source.push_line(&f"#include \"{(*_self).plugin_name}Editor.h\"")
        ()
        if (has_slate || has_details):
            (*_self).source.push_line("#include \"SlateOptMacros.h\"")
            ()
            ()
            ()
            ()
        (*_self).write_blank_source()
        ()
        for item in &(*program).items:
            (*_self).gen_item(item)
            ()
        ()
        Ue5EditorOutput { header: (*_self).header.build(), source: (*_self).source.build() }

    fn gen_item(_self: &mut Ue5EditorGen, item: &kain_core::types::TypedItem):
        match item:
            kain_core__types__TypedItem::Struct(st) =>
                let attrs: Array<String> = st.ast.attributes.iter().map(fn(a): a.name.as_str()).collect()
                if attrs.contains(&"slate"):
                    (*_self).gen_slate_widget(st)
                    ()
                elif attrs.contains(&"details"):
                    (*_self).gen_details_customization(st)
                    ()
                elif attrs.contains(&"viewport"):
                    (*_self).gen_viewport(st)
                    ()
                elif attrs.contains(&"toolbar"):
                    (*_self).gen_toolbar(st)
                    ()
                elif attrs.contains(&"asset_editor"):
                    (*_self).gen_asset_editor(st)
                    ()
                elif attrs.contains(&"editor_module"):
                    (*_self).gen_editor_module(st)
                    ()
                elif attrs.contains(&"asset_type"):
                    (*_self).gen_asset_type(st)
                    ()
            _ => ()

    fn gen_slate_widget(_self: &mut Ue5EditorGen, st: &kain_core::types::TypedStruct):
        let mut slate_gen = SlateGenerator__new_().with_context((*_self).context.clone())
        for field in &(*st).ast.fields:
            let is_event = ((field.attributes.iter().any(fn(a): (a.name == "event")) || field.name.starts_with("on_")) || field.name.starts_with("On"))
            if is_event:
                match &field.ty:
                    kain_core__ast__Type::Named { name: name } =>
                        match (*_self).delegate_param_types.get(name):
                            Some(params) =>
                                slate_gen.register_delegate_params(&field.name, params.clone())
                                ()
                            _ => ()
                    _ => ()
        ()
        let header_code = slate_gen.generate_widget(st)
        (*_self).header.push_line(&header_code)
        ()
        (*_self).write_blank_header()
        ()
        let widget_name = f"S{(*st).ast.name}"
        let source_code = slate_gen.generate_construct_impl(st, &widget_name)
        (*_self).source.push_line(&source_code)
        ()
        (*_self).write_blank_source()
        ()

    fn gen_details_customization(_self: &mut Ue5EditorGen, st: &kain_core::types::TypedStruct):
        let mut details_gen = DetailsGenerator__new_()
        let (header_code, source_code) = details_gen.generate_customization(st)
        (*_self).header.push_line(&header_code)
        ()
        (*_self).write_blank_header()
        ()
        (*_self).source.push_line(&source_code)
        ()
        (*_self).write_blank_source()
        ()
        let registration = details_gen.generate_registration(st)
        (*_self).detail_registrations.push(registration)
        ()

    fn gen_viewport(_self: &mut Ue5EditorGen, st: &kain_core::types::TypedStruct):
        let mut viewport_gen = ViewportGenerator__new_()
        let (header_code, source_code) = viewport_gen.generate_viewport(st)
        (*_self).header.push_line(&header_code)
        ()
        (*_self).write_blank_header()
        ()
        (*_self).source.push_line(&source_code)
        ()
        (*_self).write_blank_source()
        ()

    fn gen_toolbar(_self: &mut Ue5EditorGen, st: &kain_core::types::TypedStruct):
        let toolbar_name = &(*st).ast.name
        (*_self).write_header(&f"class F{toolbar_name}Extension")
        ()
        (*_self).write_header("{")
        ()
        (*_self).write_header("public:")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_header("static void RegisterToolbar(FToolBarBuilder& Builder);")
        ()
        (*_self).write_header("")
        ()
        for field in &(*st).ast.fields:
            if field.attributes.iter().any(fn(a): (a.name == "button")):
                (*_self).write_header(&f"static void On{field.name}();")
                ()
        ()
        for method in &(*st).ast.methods:
            if method.attributes.iter().any(fn(a): (a.name == "button")):
                (*_self).write_header(&f"static void {method.name}();")
                ()
        ()
        for field in &(*st).ast.fields:
            if field.attributes.iter().any(fn(a): (a.name == "toggle")):
                (*_self).write_header(&f"static bool {field.name};\n")
                ()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_header("};")
        ()
        (*_self).write_blank_header()
        ()
        (*_self).write_source(&f"void F{toolbar_name}Extension::RegisterToolbar(FToolBarBuilder& Builder)")
        ()
        (*_self).write_source("{")
        ()
        (*_self).push_indent()
        ()
        for field in &(*st).ast.fields:
            match field.attributes.iter().find(fn(a): (a.name == "button")):
                Some(btn_attr) =>
                    let label = btn_attr.args.first().and_then(fn(a): none).unwrap_or_else(fn(): field.name.clone())
                    let icon = field.attributes.iter().find(fn(a): ((a.name == "icon") || (a.name == "button"))).and_then(fn(a): a.args.get(1)).and_then(fn(a): none)
                    (*_self).write_source(&f"Builder.AddToolBarButton(FUIAction(FExecuteAction::CreateStatic(&F{toolbar_name}Extension::On{field.name})),")
                    ()
                    (*_self).push_indent()
                    ()
                    (*_self).write_source("NAME_None,")
                    ()
                    (*_self).write_source(&f"FText::FromString(TEXT(\"{label}\")),")
                    ()
                    (*_self).write_source(&f"FText::FromString(TEXT(\"{label}\")),")
                    ()
                    match icon:
                        Some(icon_name) =>
                            (*_self).write_source(&f"FSlateIcon(FAppStyle::GetAppStyleSetName(), \"{icon_name}\"));")
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            (*_self).write_source("FSlateIcon());")
                            ()
                            ()
                            ()
                            ()
                    (*_self).pop_indent()
                    ()
                    (*_self).write_source("")
                    ()
                _ => ()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_source("}")
        ()
        (*_self).write_blank_source()
        ()
        for field in &(*st).ast.fields:
            if field.attributes.iter().any(fn(a): (a.name == "button")):
                (*_self).write_source(&f"void F{toolbar_name}Extension::On{field.name}()")
                ()
                (*_self).write_source("{")
                ()
                (*_self).push_indent()
                ()
                (*_self).write_source("// Execute toolbar button action")
                ()
                (*_self).write_source(&f"UE_LOG(LogTemp, Log, TEXT(\"Toolbar button '{field.name}' clicked\"));")
                ()
                (*_self).pop_indent()
                ()
                (*_self).write_source("}")
                ()
                (*_self).write_blank_source()
                ()
        ()
        for method in &(*st).ast.methods:
            if method.attributes.iter().any(fn(a): (a.name == "button")):
                (*_self).write_source(&f"void F{toolbar_name}Extension::{method.name}()")
                ()
                (*_self).write_source("{")
                ()
                (*_self).push_indent()
                ()
                (*_self).write_source("// Execute toolbar action")
                ()
                (*_self).write_source(&f"UE_LOG(LogTemp, Log, TEXT(\"Toolbar action '{method.name}' executed\"));")
                ()
                (*_self).pop_indent()
                ()
                (*_self).write_source("}")
                ()
                (*_self).write_blank_source()
                ()
        ()
        for field in &(*st).ast.fields:
            if field.attributes.iter().any(fn(a): (a.name == "toggle")):
                (*_self).write_source(&f"bool F{toolbar_name}Extension::{field.name} = false;")
                ()
                (*_self).write_blank_source()
                ()

    fn gen_asset_editor(_self: &mut Ue5EditorGen, st: &kain_core::types::TypedStruct):
        use crate::editor::assets::AssetEditorGenerator

        let mut asset_gen = AssetEditorGenerator__new_((*_self).context.clone())
        match asset_gen.generate_asset_editor(st):
            Ok((header, source)) =>
                (*_self).header.push_line(&header)
                ()
                (*_self).write_blank_header()
                ()
                (*_self).source.push_line(&source)
                ()
                (*_self).write_blank_source()
                ()
            Err(e_2) => ()

    fn map_type(_self: &Ue5EditorGen, ty: &kain_core::ast::Type) -> String:
        (*_self).type_mapper.map_type_string(ty)

    fn gen_editor_module(_self: &mut Ue5EditorGen, st: &kain_core::types::TypedStruct):
        let module_name = &(*st).ast.name
        let base_name = module_name.strip_suffix("Module").unwrap_or(module_name)
        let class_name = f"F{base_name}Module"
        let toolbar_names = (*_self).toolbar_names.clone()
        for toolbar_name in &toolbar_names:
            (*_self).write_header(&f"#include \"F{toolbar_name}Extension.h\"")
            ()
        ()
        if (!toolbar_names.is_empty()):
            (*_self).write_blank_header()
            ()
            ()
            ()
            ()
        (*_self).write_header(&f"class {class_name} : public IModuleInterface")
        ()
        (*_self).write_header("{")
        ()
        (*_self).write_header("public:")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_header("virtual void StartupModule() override;")
        ()
        (*_self).write_header("virtual void ShutdownModule() override;")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_header("};")
        ()
        (*_self).write_blank_header()
        ()
        (*_self).write_source(&f"void {class_name}::StartupModule()")
        ()
        (*_self).write_source("{")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_source(&f"UE_LOG(LogTemp, Log, TEXT(\"{module_name} has started!\"));")
        ()
        if (*_self).has_shaders:
            (*_self).write_source("")
            ()
            (*_self).write_source("// Register shader directory (guarded against duplicate auto-registration)")
            ()
            (*_self).write_source(&f"if (!AllShaderSourceDirectoryMappings().Contains(TEXT(\"/Plugin/{(*_self).plugin_name}\")))")
            ()
            (*_self).write_source("{")
            ()
            (*_self).push_indent()
            ()
            (*_self).write_source(&f"FString PluginShaderDir = FPaths::Combine(IPluginManager::Get().FindPlugin(TEXT(\"{(*_self).plugin_name}\"))->GetBaseDir(), TEXT(\"Shaders\"));")
            ()
            (*_self).write_source(&f"AddShaderSourceDirectoryMapping(TEXT(\"/Plugin/{(*_self).plugin_name}\"), PluginShaderDir);")
            ()
            (*_self).pop_indent()
            ()
            (*_self).write_source("}")
            ()
            ()
            ()
            ()
        for registration in &(*_self).detail_registrations.clone():
            (*_self).write_source("")
            ()
            (*_self).write_source("// Register detail customization")
            ()
            (*_self).source.push_line(registration)
            ()
        ()
        for toolbar_name in &toolbar_names:
            (*_self).write_source("")
            ()
            (*_self).write_source("if (FModuleManager::Get().IsModuleLoaded(\"LevelEditor\"))")
            ()
            (*_self).write_source("{")
            ()
            (*_self).push_indent()
            ()
            (*_self).write_source("FLevelEditorModule& LevelEditorModule = FModuleManager::LoadModuleChecked<FLevelEditorModule>(\"LevelEditor\");")
            ()
            (*_self).write_source("TSharedPtr<FExtender> ToolbarExtender = MakeShared<FExtender>();")
            ()
            (*_self).write_source(&f"ToolbarExtender->AddToolBarExtension(\"Settings\", EExtensionHook::After, nullptr, FToolBarExtensionDelegate::CreateStatic(&F{toolbar_name}Extension::RegisterToolbar));")
            ()
            (*_self).write_source("LevelEditorModule.GetToolBarExtensibilityManager()->AddExtender(ToolbarExtender);")
            ()
            (*_self).pop_indent()
            ()
            (*_self).write_source("}")
            ()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_source("}")
        ()
        (*_self).write_blank_source()
        ()
        (*_self).write_source(&f"void {class_name}::ShutdownModule()")
        ()
        (*_self).write_source("{")
        ()
        (*_self).push_indent()
        ()
        if (!(*_self).detail_registrations.is_empty()):
            (*_self).write_source("// Unregister detail customizations")
            ()
            (*_self).write_source("if (FModuleManager::Get().IsModuleLoaded(\"PropertyEditor\"))")
            ()
            (*_self).write_source("{")
            ()
            (*_self).push_indent()
            ()
            (*_self).write_source("FPropertyEditorModule& PropertyModule = FModuleManager::GetModuleChecked<FPropertyEditorModule>(\"PropertyEditor\");")
            ()
            (*_self).write_source("PropertyModule.UnregisterCustomClassLayout(FName(TEXT(\"CustomClass\")));")
            ()
            (*_self).pop_indent()
            ()
            (*_self).write_source("}")
            ()
            (*_self).write_source("")
            ()
            ()
            ()
            ()
        (*_self).write_source(&f"UE_LOG(LogTemp, Log, TEXT(\"{module_name} has shut down!\"));")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_source("}")
        ()
        (*_self).write_blank_source()
        ()
        (*_self).write_source(&f"IMPLEMENT_MODULE({class_name}, {(*_self).plugin_name})")
        ()
        (*_self).write_blank_source()
        ()

    fn gen_asset_type(_self: &mut Ue5EditorGen, st: &kain_core::types::TypedStruct):
        let asset_name = &(*st).ast.name
        let module_api = "GENERATED_API"
        (*_self).write_header("UCLASS(BlueprintType)")
        ()
        (*_self).write_header(&f"class {module_api} U{asset_name} : public UDataAsset")
        ()
        (*_self).write_header("{")
        ()
        (*_self).write_header("GENERATED_BODY()")
        ()
        (*_self).write_header("public:")
        ()
        (*_self).push_indent()
        ()
        for field in &(*st).ast.fields:
            (*_self).write_header("UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = \"Asset\")")
            ()
            (*_self).write_header(&f"{(*_self).map_type(&field.ty)} {field.name};")
            ()
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_header("};")
        ()
        (*_self).write_blank_header()
        ()
        let actions_name = f"FAssetTypeActions_{asset_name}"
        (*_self).write_source(&f"class {actions_name} : public FAssetTypeActions_Base")
        ()
        (*_self).write_source("{")
        ()
        (*_self).write_source("public:")
        ()
        (*_self).push_indent()
        ()
        (*_self).write_source(&"virtual FText GetName() const override { return NSLOCTEXT(\"AssetTypeActions\", \"AssetTypeActions_{asset_name}\", \"{asset_name}\"); }")
        ()
        (*_self).write_source("virtual FColor GetTypeColor() const override { return FColor::White; }")
        ()
        (*_self).write_source(&"virtual UClass* GetSupportedClass() const override { return U{asset_name}::StaticClass(); }")
        ()
        (*_self).write_source("virtual uint32 GetCategories() override { return EAssetTypeCategories::Misc; }")
        ()
        (*_self).pop_indent()
        ()
        (*_self).write_source("};")
        ()
        (*_self).write_blank_source()
        ()


@doc(doc = " Recursively collect every function-call callee name that appears in an")
@doc(doc = " expression tree.  These names map 1-to-1 with Slate widget type names")
@doc(doc = " (e.g. \"Button\", \"SButton\", \"ListView\", \"SListView\").")
fn collect_callee_names(expr: &kain_core::ast::Expr, out_: &mut Set<String>):
    match expr:
        kain_core__ast__Expr::Call { callee: callee, args: args } =>
            match callee:
                kain_core__ast__Expr::Ident(name, _) =>
                    out_.insert(name.clone())
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            collect_callee_names(callee, out_)
            ()
            for a in args:
                collect_callee_names(&a.value, out_)
                ()
        kain_core__ast__Expr::MethodCall { receiver: receiver, args: args } =>
            collect_callee_names(receiver, out_)
            ()
            for a in args:
                collect_callee_names(&a.value, out_)
                ()
        kain_core__ast__Expr::Binary { left: left, right: right } =>
            collect_callee_names(left, out_)
            ()
            collect_callee_names(right, out_)
            ()
        kain_core__ast__Expr::Unary { operand: operand } => collect_callee_names(operand, out_)
        kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
            collect_callee_names(condition, out_)
            ()
            collect_callee_names_from_block(then_branch, out_)
            ()
            match else_branch:
                Some(eb) =>
                    match eb:
                        kain_core__ast__ElseBranch::Else(b) => collect_callee_names_from_block(b, out_)
                        kain_core__ast__ElseBranch::ElseIf(cond, b, _) =>
                            collect_callee_names(cond, out_)
                            ()
                            collect_callee_names_from_block(b, out_)
                            ()
                _ => ()
        kain_core__ast__Expr::Array(items, _) =>
            for item in items:
                collect_callee_names(item, out_)
                ()
        kain_core__ast__Expr::Tuple(items, _) =>
            for item in items:
                collect_callee_names(item, out_)
                ()
        _ => ()

fn collect_callee_names_from_block(block: &kain_core::ast::Block, out_: &mut Set<String>):
    for stmt in &(*block).stmts:
        match stmt:
            kain_core__ast__Stmt::Expr(e) => collect_callee_names(e, out_)
            kain_core__ast__Stmt::Return(Some(e), _) => collect_callee_names(e, out_)
            kain_core__ast__Stmt::Let { value: Some(e) } => collect_callee_names(e, out_)
            kain_core__ast__Stmt::For { body: body } =>
                collect_callee_names_from_block(body, out_)
                ()
            kain_core__ast__Stmt::While { body: body } =>
                collect_callee_names_from_block(body, out_)
                ()
            kain_core__ast__Stmt::Loop { body: body } =>
                collect_callee_names_from_block(body, out_)
                ()
            _ => ()

@doc(doc = " Walk every method of `st` and collect all Call callee names.")
@doc(doc = " The result is used to decide which Slate widget headers to include.")
fn collect_widget_names_from_struct(st: &kain_core::ast::Struct) -> Set<String>:
    let mut names = HashSet__new_()
    for attr in &(*st).attributes:
        match attr.name.as_str():
            "table_row" =>
                names.insert(("SMultiColumnTableRow").to_string())
                ()
                names.insert(("table_row").to_string())
                ()
            "multi_column_row" =>
                names.insert(("SMultiColumnTableRow").to_string())
                ()
                names.insert(("table_row").to_string())
                ()
            "tooltip_widget" =>
                names.insert(("SToolTip").to_string())
                ()
            "slate_tooltip" =>
                names.insert(("SToolTip").to_string())
                ()
            "base" =>
                match attr.args.first():
                    Some(first_arg) =>
                        match first_arg:
                            kain_core__ast__Expr::String(s, _) =>
                                if s.contains("SMultiColumnTableRow"):
                                    names.insert(("SMultiColumnTableRow").to_string())
                                    ()
                                    names.insert(("table_row").to_string())
                                    ()
                                    ()
                                    ()
                                    ()
                                if s.contains("SToolTip"):
                                    names.insert(("SToolTip").to_string())
                                    ()
                            kain_core__ast__Expr::Ident(s, _) =>
                                if s.contains("SMultiColumnTableRow"):
                                    names.insert(("SMultiColumnTableRow").to_string())
                                    ()
                                    names.insert(("table_row").to_string())
                                    ()
                                    ()
                                    ()
                                    ()
                                if s.contains("SToolTip"):
                                    names.insert(("SToolTip").to_string())
                                    ()
                            _ => ()
                    _ => ()
            "slate_base" =>
                match attr.args.first():
                    Some(first_arg) =>
                        match first_arg:
                            kain_core__ast__Expr::String(s, _) =>
                                if s.contains("SMultiColumnTableRow"):
                                    names.insert(("SMultiColumnTableRow").to_string())
                                    ()
                                    names.insert(("table_row").to_string())
                                    ()
                                    ()
                                    ()
                                    ()
                                if s.contains("SToolTip"):
                                    names.insert(("SToolTip").to_string())
                                    ()
                            kain_core__ast__Expr::Ident(s, _) =>
                                if s.contains("SMultiColumnTableRow"):
                                    names.insert(("SMultiColumnTableRow").to_string())
                                    ()
                                    names.insert(("table_row").to_string())
                                    ()
                                    ()
                                    ()
                                    ()
                                if s.contains("SToolTip"):
