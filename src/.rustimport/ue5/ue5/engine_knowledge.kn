        let aliases = [("Bool", "bool"), ("Int", "int32"), ("Int64", "int64"), ("Float", "float"), ("Double", "double"), ("Byte", "uint8"), ("String", "FString"), ("Name", "FName"), ("Text", "FText"), ("Vec", "FVector"), ("Vec2", "FVector2D"), ("Vec3", "FVector"), ("Vec4", "FVector4"), ("Vector", "FVector"), ("Vector2D", "FVector2D"), ("Rot", "FRotator"), ("Rotator", "FRotator"), ("Rotation", "FRotator"), ("Transform", "FTransform"), ("Quat", "FQuat"), ("Color", "FLinearColor"), ("LinearColor", "FLinearColor"), ("Actor", "AActor"), ("Pawn", "APawn"), ("Character", "ACharacter"), ("PlayerController", "APlayerController"), ("GameMode", "AGameModeBase"), ("GameState", "AGameStateBase"), ("PlayerState", "APlayerState"), ("SceneComponent", "USceneComponent"), ("StaticMeshComponent", "UStaticMeshComponent"), ("SkeletalMeshComponent", "USkeletalMeshComponent"), ("CameraComponent", "UCameraComponent"), ("SpringArmComponent", "USpringArmComponent"), ("AudioComponent", "UAudioComponent"), ("LightComponent", "ULightComponent"), ("SplineComponent", "USplineComponent"), ("WidgetComponent", "UWidgetComponent"), ("NiagaraComponent", "UNiagaraComponent"), ("CapsuleComponent", "UCapsuleComponent"), ("SphereComponent", "USphereComponent"), ("BoxComponent", "UBoxComponent"), ("StaticMesh", "UStaticMesh"), ("SkeletalMesh", "USkeletalMesh"), ("AnimMontage", "UAnimMontage"), ("AnimSequence", "UAnimSequence"), ("Texture2D", "UTexture2D"), ("Material", "UMaterial"), ("MaterialInstance", "UMaterialInstance"), ("MaterialInstanceDynamic", "UMaterialInstanceDynamic"), ("SoundBase", "USoundBase"), ("SoundWave", "USoundWave"), ("SoundCue", "USoundCue"), ("ParticleSystem", "UParticleSystem"), ("NiagaraSystem", "UNiagaraSystem"), ("DataTable", "UDataTable"), ("CurveFloat", "UCurveFloat"), ("CurveVector", "UCurveVector"), ("CurveLinearColor", "UCurveLinearColor"), ("WorldSubsystem", "UWorldSubsystem"), ("GameInstanceSubsystem", "UGameInstanceSubsystem"), ("LocalPlayerSubsystem", "ULocalPlayerSubsystem")]
        for selfhost_for_item in &aliases:
            let (k, u) = selfhost_for_item
            (*_self).type_aliases.insert(k.to_string(), u.to_string())
            ()

