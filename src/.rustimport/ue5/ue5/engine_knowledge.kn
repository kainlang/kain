use serde::Deserialize

use serde::Serialize

use std::collections::HashMap

use std::collections::HashSet

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct EngineClass:
    name: String
    parent: String
    header: String
    module: String
    prefix: String
    specifiers: Array<String>
    functions: Array<EngineFunction>
    properties: Array<EngineProperty>
    is_abstract: Bool
    category: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct EngineStruct:
    name: String
    header: String
    module: String
    fields: Array<EngineProperty>
    is_table_row: Bool

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct EngineEnum:
    name: String
    header: String
    module: String
    values: Array<String>
    is_flags: Bool

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct EngineFunction:
    name: String
    return_type: String
    params: Array<EngineFuncParam>
    specifiers: Array<String>
    is_const: Bool
    is_virtual: Bool
    is_static: Bool

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct EngineFuncParam:
    name: String
    param_type: String
    default_value: Option<String>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct EngineProperty:
    name: String
    prop_type: String
    specifiers: Array<String>
    category: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct TypeAlias:
    kain_name: String
    ue5_name: String
    header: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct EngineMetadata:
    engine_version: String
    classes: Array<EngineClass>
    structs: Array<EngineStruct>
    enums: Array<EngineEnum>
    type_aliases: Array<TypeAlias>
    include_map: Map<String, String>

@derive(Debug, Clone)
pub struct EngineKnowledge:
    classes: Map<String, EngineClass>
    structs: Map<String, EngineStruct>
    enums: Map<String, EngineEnum>
    type_aliases: Map<String, String>
    include_map: Map<String, String>
    class_hierarchy: Map<String, Set<String>>
    component_names: Set<String>
    actor_class_names: Set<String>
    module_types: Map<String, Set<String>>
    call_templates: Map<String, String>
    function_map: Map<String, String>
    named_colors: Map<String, [f32; 4]>
    constructor_formats: Map<(String, usize), String>
    property_string_formats: Map<String, String>

impl Default for EngineKnowledge:
    fn default_() -> EngineKnowledge:
        EngineKnowledge__new_()


impl EngineKnowledge:
    pub fn new_() -> EngineKnowledge:
        let mut kb = EngineKnowledge { classes: HashMap__new_(), structs: HashMap__new_(), enums: HashMap__new_(), type_aliases: HashMap__new_(), include_map: HashMap__new_(), class_hierarchy: HashMap__new_(), component_names: HashSet__new_(), actor_class_names: HashSet__new_(), module_types: HashMap__new_(), call_templates: HashMap__new_(), function_map: HashMap__new_(), named_colors: HashMap__new_(), constructor_formats: HashMap__new_(), property_string_formats: HashMap__new_() }
        kb.seed_builtin_aliases()
        ()
        kb.seed_builtin_includes()
        ()
        kb.seed_named_colors()
        ()
        kb.seed_constructor_formats()
        ()
        kb

    pub fn load_metadata(_self: &mut EngineKnowledge, json_data: String) -> Result<(), String>:
        match serde_json__from_str(json_data):
            Ok(meta) =>
                (*_self).ingest_metadata(meta)
                ()
                return Result::Ok(())
            _ =>
                ()
                ()
        match serde_json__from_str(json_data):
            Ok(legacy) =>
                (*_self).load_legacy_metadata(&legacy)?
                ()
                return Result::Ok(())
            _ =>
                ()
                ()
        Result::Err(("Failed to parse metadata as either new or legacy format").to_string())

    pub fn load_metadata_validated(_self: &mut EngineKnowledge, file_path: &path::Path, json_data: String) -> Result<(), String>:
        use crate::ue5::metadata_validation::MetadataValidator

        let validator = MetadataValidator__new_()
        let validated_json = validator.validate_file(file_path, json_data).map_err(fn(e): e.to_string())?
        (*_self).load_metadata(json_data)

    pub fn load_extensions(_self: &mut EngineKnowledge, extensions_dir: &path::Path) -> Result<usize, String>:
        use std::fs

        if (!extensions_dir.exists()):
            return Result::Ok(0)
        let mut loaded_count = 0
        let entries = std__fs__read_dir(extensions_dir).map_err(fn(e): f"Failed to read extensions directory: {e}")?
        for entry in entries:
            let entry = entry.map_err(fn(e): f"Failed to read directory entry: {e}")?
            let path = entry.path()
            if (path.extension().and_then(fn(s): s.to_str()) != Option::Some("json")):
                continue
            let json_data = std__fs__read_to_string(&path).map_err(fn(e): f"Failed to read extension file {path}: {e}")?
            match (*_self).load_metadata(&json_data):
                Ok(_) =>
                    loaded_count = (loaded_count + 1)
                    ()
                Err(e_2) => ()
        ()
        Result::Ok(loaded_count)

    fn ingest_metadata(_self: &mut EngineKnowledge, meta: EngineMetadata):
        for class_ in meta.classes:
            let name = class_.name.clone()
            if (!class_.header.is_empty()):
                (*_self).include_map.insert(name.clone(), class_.header.clone())
                ()
                ()
                ()
                ()
            if (!class_.module.is_empty()):
                (*_self).module_types.entry(class_.module.clone()).or_default().insert(name.clone())
                ()
                ()
                ()
                ()
            for func in &class_.functions:
                let key = f"{name}::{func.name}"
                let pp: Array<String> = (range(1, (func.params.len() + 1))).map(fn(i): f"${i}").collect()
                let tmpl = if func.is_static:
                    "{name}::{func.name}({pp.join(\", \")})"
                else:
                    "$0->{func.name}({pp.join(\", \")})"
                (*_self).call_templates.insert(key, tmpl.clone())
                ()
                (*_self).function_map.insert(func.name.clone(), tmpl)
                ()
            ()
            match (*_self).classes.get(&name):
                Some(existing) =>
                    let existing_detail = (existing.functions.len() + existing.properties.len())
                    let new_detail = (class_.functions.len() + class_.properties.len())
                    if (new_detail > existing_detail):
                        (*_self).classes.insert(name, class_)
                        ()
                _ =>
                    (*_self).classes.insert(name, class_)
                    ()
        ()
        for st in meta.structs:
            if (!st.header.is_empty()):
                (*_self).include_map.insert(st.name.clone(), st.header.clone())
                ()
                ()
                ()
                ()
            if (!st.module.is_empty()):
                (*_self).module_types.entry(st.module.clone()).or_default().insert(st.name.clone())
                ()
                ()
                ()
                ()
            match (*_self).structs.get(&st.name):
                Some(existing) =>
                    if (st.fields.len() > existing.fields.len()):
                        (*_self).structs.insert(st.name.clone(), st)
                        ()
                _ =>
                    (*_self).structs.insert(st.name.clone(), st)
                    ()
        ()
        for en in meta.enums:
            if (!en.header.is_empty()):
                (*_self).include_map.insert(en.name.clone(), en.header.clone())
                ()
                ()
                ()
                ()
            if (!en.module.is_empty()):
                (*_self).module_types.entry(en.module.clone()).or_default().insert(en.name.clone())
                ()
                ()
                ()
                ()
            match (*_self).enums.get(&en.name):
                Some(existing) =>
                    if (en.values.len() > existing.values.len()):
                        (*_self).enums.insert(en.name.clone(), en)
                        ()
                _ =>
                    (*_self).enums.insert(en.name.clone(), en)
                    ()
        ()
        for alias in meta.type_aliases:
            (*_self).type_aliases.insert(alias.kain_name.clone(), alias.ue5_name.clone())
            ()
            if (!alias.header.is_empty()):
                (*_self).include_map.insert(alias.ue5_name, alias.header)
                ()
        ()
        for selfhost_for_item in meta.include_map:
            let (k, v) = selfhost_for_item
            (*_self).include_map.insert(k, v)
            ()
        ()
        (*_self).rebuild_hierarchy()
        ()

    fn load_legacy_metadata(_self: &mut EngineKnowledge, v: &serde_json::Value) -> Result<(), String>:
        match v.as_array():
            Some(files) =>
                for file in files:
                    match file.get("content"):
                        Some(content) =>
                            match content.get("functions").and_then(fn(f): f.as_array()):
                                Some(funcs) =>
                                    for func in funcs:
                                        let name = func.get("name").and_then(fn(n): n.as_str()).unwrap_or("")
                                        if name.is_empty():
                                            continue
                                        let mut template_ = f"$0->{name}()"
                                        match func.get("params").and_then(fn(p): p.as_array()):
                                            Some(params) =>
                                                if (!params.is_empty()):
                                                    let pp: Array<String> = (range(1, (params.len() + 1))).map(fn(i): f"${i}").collect()
                                                    template_ = "$0->{name}({pp.join(\", \")})"
                                                    ()
                                                    ()
                                                    ()
                                                    ()
                                                ()
                                            _ =>
                                                ()
                                                ()
                                        (*_self).function_map.insert(name.to_string(), template_)
                                        ()
                                    ()
                                    ()
                                _ =>
                                    ()
                                    ()
                            match content.get("properties").and_then(fn(p): p.as_array()):
                                Some(props) =>
                                    for prop in props:
                                        let name = prop.get("name").and_then(fn(n): n.as_str()).unwrap_or("")
                                        if name.is_empty():
                                            continue
                                        (*_self).function_map.insert(f"get_{name}", f"$0->{name}")
                                        ()
                                        (*_self).function_map.insert(f"set_{name}", f"$0->{name} = $1")
                                        ()
                                _ => ()
                        _ => ()
                ()
                ()
            _ =>
                ()
                ()
        Result::Ok(())

    fn rebuild_hierarchy(_self: &mut EngineKnowledge):
        let class_parents: Map<String, String> = (*_self).classes.iter().filter(fn(__kain_closure_arg0): (!__kain_closure_arg0.__kain_tuple_1.parent.is_empty())).map(fn(__kain_closure_arg1): (__kain_closure_arg1.__kain_tuple_0.clone(), __kain_closure_arg1.__kain_tuple_1.parent.clone())).collect()
        for name in (*_self).classes.keys():
            let mut ancestors = HashSet__new_()
            let mut current = name.clone()
            loop:
                match class_parents.get(&current):
                    Some(parent) =>
                        ancestors.insert(parent.clone())
                        ()
                        current = parent.clone()
                        ()
                    _ => break
            ()
            (*_self).class_hierarchy.insert(name.clone(), ancestors)
            ()
        ()
        (*_self).component_names.clear()
        ()
        (*_self).actor_class_names.clear()
        ()
        for selfhost_for_item in &(*_self).class_hierarchy:
            let (name, ancestors) = selfhost_for_item
            if (((ancestors.contains("UActorComponent") || ancestors.contains("USceneComponent")) || (name == "UActorComponent")) || (name == "USceneComponent")):
                (*_self).component_names.insert(name.clone())
                ()
                ()
                ()
                ()
            if (ancestors.contains("AActor") || (name == "AActor")):
                (*_self).actor_class_names.insert(name.clone())
                ()

    pub fn is_known_type(_self: &EngineKnowledge, name: String) -> Bool:
        ((((*_self).classes.contains_key(name) || (*_self).structs.contains_key(name)) || (*_self).enums.contains_key(name)) || (*_self).type_aliases.contains_key(name))

    pub fn resolve_type_alias(_self: &EngineKnowledge, kain_name: String) -> Option<String>:
        (*_self).type_aliases.get(kain_name).map(fn(s): s.as_str())

    pub fn get_include(_self: &EngineKnowledge, type_name: String) -> Option<String>:
        match (*_self).include_map.get(type_name):
            Some(inc) => return Option::Some(inc.as_str())
            _ =>
                ()
                ()
        for prefix in &["A", "U", "F", "E"]:
            let prefixed = f"{prefix}{type_name}"
            match (*_self).include_map.get(&prefixed):
                Some(inc) => return Option::Some(inc.as_str())
                _ => ()
        ()
        none

    pub fn is_child_of(_self: &EngineKnowledge, class_name: String, parent_name: String) -> Bool:
        if (class_name == parent_name):
            return true
        (*_self).class_hierarchy.get(class_name).map_or(false, fn(a): a.contains(parent_name))

    pub fn is_engine_component(_self: &EngineKnowledge, name: String) -> Bool:
        ((*_self).component_names.contains(name) || (*_self).component_names.contains(&f"U{name}"))

    pub fn is_engine_actor(_self: &EngineKnowledge, name: String) -> Bool:
        ((*_self).actor_class_names.contains(name) || (*_self).actor_class_names.contains(&f"A{name}"))

    pub fn is_uobject_derived(_self: &EngineKnowledge, name: String) -> Bool:
        let names_to_check = [name, &f"U{name}", &f"A{name}"]
        for check_name in &names_to_check:
            match (*_self).classes.get((*check_name)):
                Some(class_) =>
                    if (((*check_name) == "UObject") || (*_self).is_child_of(check_name, "UObject")):
                        return true
                    if ((class_.prefix == "U") || (class_.prefix == "A")):
                        return true
                _ => ()
        ()
        if ((*_self).is_engine_component(name) || (*_self).is_engine_actor(name)):
            return true
        false

    pub fn get_cpp_type(_self: &EngineKnowledge, kain_name: String) -> Option<String>:
        match (*_self).resolve_type_alias(kain_name):
            Some(ue_type) =>
                use std::io::Write

                let mut file = OpenOptions__new_().create(true).append(true).open("C:/temp/kain_debug.txt").ok()?
                let _ = __kain_writeln_fmt!(file, f"[DEBUG get_cpp_type] {kain_name} -> {ue_type} (from alias)")
                if (*_self).is_uobject_derived(ue_type):
                    let _ = __kain_writeln_fmt!(file, f"[DEBUG get_cpp_type] {ue_type} is UObject-derived, adding pointer")
                    return Option::Some(f"{ue_type}*")
                if (ue_type.starts_with("U") || ue_type.starts_with("A")):
                    let _ = __kain_writeln_fmt!(file, f"[DEBUG get_cpp_type] {ue_type} starts with U/A, adding pointer (fallback)")
                    return Option::Some(f"{ue_type}*")
                let _ = __kain_writeln_fmt!(file, f"[DEBUG get_cpp_type] {ue_type} is NOT UObject-derived")
                return Option::Some(ue_type.to_string())
            _ =>
                ()
                ()
        match (*_self).classes.get(kain_name):
            Some(class_) =>
                let cpp_name = &class_.name
                if (*_self).is_uobject_derived(cpp_name):
                    return Option::Some(f"{cpp_name}*")
                return Option::Some(cpp_name.clone())
            _ =>
                ()
                ()
        for prefix in &["U", "A", "F", "E"]:
            let prefixed = f"{prefix}{kain_name}"
            match (*_self).classes.get(&prefixed):
                Some(class__2) =>
                    if (*_self).is_uobject_derived(&prefixed):
                        return Option::Some(f"{prefixed}*")
                    return Option::Some(prefixed)
                _ =>
                    ()
                    ()
            match (*_self).structs.get(&prefixed):
                Some(st) => return Option::Some(st.name.clone())
                _ =>
                    ()
                    ()
            match (*_self).enums.get(&prefixed):
                Some(en) => return Option::Some(en.name.clone())
                _ => ()
        ()
        none

    pub fn is_engine_enum(_self: &EngineKnowledge, name: String) -> Bool:
        ((*_self).enums.contains_key(name) || (*_self).enums.contains_key(&f"E{name}"))

    pub fn is_engine_struct(_self: &EngineKnowledge, name: String) -> Bool:
        ((*_self).structs.contains_key(name) || (*_self).structs.contains_key(&f"F{name}"))

    pub fn get_class_functions(_self: &EngineKnowledge, class_name: String) -> Array<&EngineFunction>:
        let mut funcs = Vec__new_()
        match (*_self).classes.get(class_name):
            Some(class_) =>
                funcs.extend(class_.functions.iter())
                ()
                let mut parent = class_.parent.clone()
                while (!parent.is_empty()):
                    match (*_self).classes.get(&parent):
                        Some(pc) =>
                            funcs.extend(pc.functions.iter())
                            ()
                            parent = pc.parent.clone()
                            ()
                        _ => break
                ()
                ()
            _ =>
                ()
                ()
        funcs

    pub fn get_class_properties(_self: &EngineKnowledge, class_name: String) -> Array<&EngineProperty>:
        let mut props = Vec__new_()
        match (*_self).classes.get(class_name):
            Some(class_) =>
                props.extend(class_.properties.iter())
                ()
                let mut parent = class_.parent.clone()
                while (!parent.is_empty()):
                    match (*_self).classes.get(&parent):
                        Some(pc) =>
                            props.extend(pc.properties.iter())
                            ()
                            parent = pc.parent.clone()
                            ()
                        _ => break
                ()
                ()
            _ =>
                ()
                ()
        props

    pub fn get_module_for_type(_self: &EngineKnowledge, type_name: String) -> Option<String>:
        for selfhost_for_item in &(*_self).module_types:
            let (module, types) = selfhost_for_item
            if types.contains(type_name):
                return Option::Some(module.as_str())
        ()
        for prefix in &["A", "U", "F", "E"]:
            let prefixed = f"{prefix}{type_name}"
            for selfhost_for_item in &(*_self).module_types:
                let (module, types) = selfhost_for_item
                if types.contains(&prefixed):
                    return Option::Some(module.as_str())
        ()
        none

    pub fn resolve_call(_self: &EngineKnowledge, name: String, args: &[String]) -> Option<String>:
        let template_ = (*_self).function_map.get(name)?
        let mut result = template_.clone()
        for selfhost_for_item in args.iter().enumerate():
            let (i, arg) = selfhost_for_item
            result = result.replace(&f"${i}", arg)
            ()
        ()
        Option::Some(result)

    pub fn resolve_named_color(_self: &EngineKnowledge, name: String) -> Option<String>:
        let lower = name.to_lowercase()
        let rgba = (*_self).named_colors.get(&lower)?
        Option::Some(f"FLinearColor({rgba[0]}f, {rgba[1]}f, {rgba[2]}f, {rgba[3]}f)")

    pub fn is_named_color(_self: &EngineKnowledge, name: String) -> Bool:
        (*_self).named_colors.contains_key(&name.to_lowercase())

    pub fn get_named_color_rgba(_self: &EngineKnowledge, name: String) -> Option<[f32; 4]>:
        (*_self).named_colors.get(&name.to_lowercase()).copied()

    pub fn resolve_constructor(_self: &EngineKnowledge, ue5_type: String, args: &[String]) -> Option<String>:
        let key = (ue5_type.to_string(), args.len())
        let fmt = (*_self).constructor_formats.get(&key)?
        let mut result = fmt.clone()
        for selfhost_for_item in args.iter().enumerate():
            let (i, arg) = selfhost_for_item
            result = result.replace(&"{{i}}", arg)
            ()
        ()
        Option::Some(result)

    pub fn get_property_format(_self: &EngineKnowledge, ue5_type: String) -> Option<String>:
        (*_self).property_string_formats.get(ue5_type).map(fn(s): s.as_str())

    pub fn format_property_string(_self: &EngineKnowledge, ue5_type: String, values: &[String]) -> Option<String>:
        let fmt = (*_self).property_string_formats.get(ue5_type)?
        let mut result = fmt.clone()
        for selfhost_for_item in values.iter().enumerate():
            let (i, val) = selfhost_for_item
            result = result.replace(&"{{i}}", val)
            ()
        ()
        Option::Some(result)

    pub fn validate_property_type(_self: &EngineKnowledge, cpp_type: String) -> Result<(), String>:
        let base = cpp_type.trim_end_matches("*").trim_end_matches("&").trim_start_matches("const ").trim()
        if (((base.starts_with("TArray<") || base.starts_with("TMap<")) || base.starts_with("TSet<")) || base.starts_with("TOptional<")):
            return Result::Ok(())
        let primitives = ["bool", "int8", "uint8", "int16", "uint16", "int32", "uint32", "int64", "uint64", "float", "double", "FString", "FName", "FText", "void", "auto"]
        if primitives.contains(&base):
            return Result::Ok(())
        Result::Ok(())

