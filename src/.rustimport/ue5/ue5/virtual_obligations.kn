use serde::Deserialize

use serde::Serialize

use std::collections::HashMap

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct VirtualObligationsData:
    meta: ObligationsMeta
    kain_focus: Map<String, ClassObligations>
    obligations: Map<String, ClassObligations>

@derive(Debug, Clone, Default, serde__Serialize, serde__Deserialize)
pub struct ObligationsMeta:
    generator: String
    total_classes_scanned: usize
    total_pure_virtual_declarations: usize
    total_classes_with_obligations: usize
    compact_classes_included: usize
    kain_focus_classes: usize

impl Default for ObligationsMeta:
    pub fn default_() -> ObligationsMeta:
        ObligationsMeta { generator: String__new_(), total_classes_scanned: 0, total_pure_virtual_declarations: 0, total_classes_with_obligations: 0, compact_classes_included: 0, kain_focus_classes: 0 }


@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct ClassObligations:
    class_name: String
    parents: Array<String>
    header: String
    module_name: String
    category: String
    obligation_count: usize
    obligations: Array<MethodObligation>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct MethodObligation:
    name: String
    return_type: String
    params: Array<ObligationParam>
    is_const: Bool
    declared_in: String
    default_body: String
    raw_signature: String
    override_declaration: String
    override_definition: String

@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct ObligationParam:
    name: String
    param_type: String
    default_value: Option<String>

@derive(Debug, Default, Clone)
pub struct VirtualObligations:
    kain_focus: Map<String, ClassObligations>
    all_obligations: Map<String, ClassObligations>
    total_classes: usize
    total_obligations: usize

impl Default for VirtualObligations:
    pub fn default_() -> VirtualObligations:
        VirtualObligations { kain_focus: HashMap__new_(), all_obligations: HashMap__new_(), total_classes: 0, total_obligations: 0 }


impl VirtualObligations:
    pub fn new_() -> VirtualObligations:
        VirtualObligations__default_()

    pub fn load(_self: &mut VirtualObligations, json_data: String) -> Result<(), String>:
        let data: VirtualObligationsData = serde_json__from_str(json_data).map_err(fn(e): f"Failed to parse virtual_obligations.json: {e}")?
        (*_self).kain_focus = data.kain_focus
        ()
        (*_self).all_obligations = data.obligations
        ()
        (*_self).total_classes = ((*_self).kain_focus.len() + (*_self).all_obligations.len())
        ()
        (*_self).total_obligations = (*_self).kain_focus.values().chain((*_self).all_obligations.values()).map(fn(c): c.obligation_count).sum()
        ()
        Result::Ok(())

    pub fn is_loaded(_self: &VirtualObligations) -> Bool:
        ((*_self).total_classes > 0)

    pub fn get_obligations(_self: &VirtualObligations, class_name: String) -> Option<&ClassObligations>:
        (*_self).kain_focus.get(class_name).or_else(fn(): (*_self).all_obligations.get(class_name))

    pub fn has_obligations(_self: &VirtualObligations, class_name: String) -> Bool:
        (*_self).get_obligations(class_name).map(fn(o): (o.obligation_count > 0)).unwrap_or(false)

    pub fn obligation_count(_self: &VirtualObligations, class_name: String) -> usize:
        (*_self).get_obligations(class_name).map(fn(o): o.obligation_count).unwrap_or(0)

    pub fn required_method_names(_self: &VirtualObligations, class_name: String) -> Array<String>:
        (*_self).get_obligations(class_name).map(fn(o): o.obligations.iter().map(fn(m): m.name.as_str()).collect()).unwrap_or_default()

    pub fn is_required_override(_self: &VirtualObligations, class_name: String, method_name: String) -> Bool:
        (*_self).get_obligations(class_name).map(fn(o): o.obligations.iter().any(fn(m): (m.name == method_name))).unwrap_or(false)

    pub fn generate_override_declaration(_self: &VirtualObligations, class_name: String, method_name: String) -> Option<String>:
        let obs = (*_self).get_obligations(class_name)?
        let method = obs.obligations.iter().find(fn(m): (m.name == method_name))?
        if (!method.override_declaration.is_empty()):
            return Option::Some(f"{method.override_declaration};")
        let params = method.params.iter().map(fn(p): if p.name.is_empty(): p.param_type.clone() else: f"{p.param_type} {p.name}").collect().join(", ")
        let const_str = if method.is_const:
            " const"
        else:
            ""
        Option::Some(f"virtual {method.return_type} {method.name}({params}){const_str} override;")

    pub fn generate_override_definition(_self: &VirtualObligations, class_name: String, concrete_class: String, method_name: String) -> Option<String>:
        let obs = (*_self).get_obligations(class_name)?
        let method = obs.obligations.iter().find(fn(m): (m.name == method_name))?
        if (!method.override_definition.is_empty()):
            return Option::Some(method.override_definition.replace("{CLASS}", concrete_class))
        let params = method.params.iter().map(fn(p): if p.name.is_empty(): p.param_type.clone() else: f"{p.param_type} {p.name}").collect().join(", ")
        let const_str = if method.is_const:
            " const"
        else:
            ""
        let body = if method.default_body.is_empty():
            VirtualObligations__generate_default_body(&method.return_type)
        else:
            method.default_body.clone()
        Option::Some(f"{method.return_type} {concrete_class}::{method.name}({params}){const_str}\n{body}")

    pub fn generate_all_declarations(_self: &VirtualObligations, class_name: String) -> Array<String>:
        (*_self).get_obligations(class_name).map(fn(obs): obs.obligations.iter().filter_map(fn(m): (*_self).generate_override_declaration(class_name, &m.name)).collect()).unwrap_or_default()

    pub fn generate_all_definitions(_self: &VirtualObligations, class_name: String, concrete_class: String) -> Array<String>:
        (*_self).get_obligations(class_name).map(fn(obs): obs.obligations.iter().filter_map(fn(m): (*_self).generate_override_definition(class_name, concrete_class, &m.name)).collect()).unwrap_or_default()

    fn generate_default_body(return_type: String) -> String:
        match return_type:
            "void" => ("{ }").to_string()
            "bool" => ("{ return false; }").to_string()
            "int" => ("{ return 0; }").to_string()
            "int32" => ("{ return 0; }").to_string()
            "int64" => ("{ return 0; }").to_string()
            "uint32" => ("{ return 0; }").to_string()
            "uint64" => ("{ return 0; }").to_string()
            "float" => ("{ return 0; }").to_string()
            "double" => ("{ return 0; }").to_string()
            "FName" => ("{ return FName(); }").to_string()
            "FString" => ("{ return FString(); }").to_string()
            "FText" => ("{ return FText::GetEmpty(); }").to_string()
            "FLinearColor" => ("{ return FLinearColor::White; }").to_string()
            t if t.starts_with("TSharedRef") => ("{ return SNullWidget::NullWidget; }").to_string()
            t if t.starts_with("TSharedPtr") => ("{ return nullptr; }").to_string()
            t if t.ends_with("*") => ("{ return nullptr; }").to_string()
            t if t.ends_with("&") =>
                let base = t.trim_end_matches("&").trim()
                "{ static {base} Default; return Default; }"
            t => "{ return {t}(); }"

    pub fn stats(_self: &VirtualObligations) -> (usize, usize, usize):
        ((*_self).kain_focus.len(), (*_self).all_obligations.len(), (*_self).total_obligations)

    pub fn kain_focus_classes(_self: &VirtualObligations) -> Array<String>:
        (*_self).kain_focus.keys().map(fn(s): s.as_str()).collect()


