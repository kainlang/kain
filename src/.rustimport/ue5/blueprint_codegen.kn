use crate::blueprint_ir::AsyncBlueprintIR

use crate::blueprint_ir::AsyncOutputPinIR

use crate::blueprint_ir::BlueprintEventIR

use crate::blueprint_ir::BlueprintParamIR

use crate::blueprint_ir::K2NodeIR

use crate::blueprint_ir::K2PinIR

use crate::blueprint_ir::K2PinType

@doc(doc = " Output from Blueprint event code generation")
@derive(Debug, Clone)
pub struct BlueprintEventCodegenOutput:
    header_declaration: String
    source_implementation: String

@doc(doc = " Output from K2Node code generation")
@derive(Debug, Clone)
pub struct K2NodeCodegenOutput:
    header: String
    source: String
    includes: Array<String>

@doc(doc = " Output from async Blueprint node code generation")
@derive(Debug, Clone)
pub struct AsyncBlueprintCodegenOutput:
    header: String
    source: String
    includes: Array<String>

@doc(doc = " Generate Blueprint event code from IR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `ir` - The Blueprint event intermediate representation")
@doc(doc = " * `class_name` - Name of the containing class (Actor/Component)")
@doc(doc = " * `api_macro` - API macro for the plugin (e.g., \"MYPLUGIN_API\")")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `BlueprintEventCodegenOutput` - Generated header and source code")
pub fn generate_blueprint_event_code(ir: &BlueprintEventIR, class_name: String, _api_macro: String) -> BlueprintEventCodegenOutput:
    let mut header_declaration = String__new_()
    let mut source_implementation = String__new_()
    generate_event_header_declaration(ir, class_name, &mut header_declaration)
    ()
    generate_event_source_implementation(ir, class_name, &mut source_implementation)
    ()
    BlueprintEventCodegenOutput { header_declaration: header_declaration, source_implementation: source_implementation }

@doc(doc = " Generate Blueprint event header declaration")
fn generate_event_header_declaration(ir: &BlueprintEventIR, _class_name: String, output: String):
    output.push_str("    UFUNCTION(BlueprintNativeEvent, Category = \"")
    ()
    output.push_str(&(*ir).category)
    ()
    output.push_str("\")\n")
    ()
    output.push_str("    ")
    ()
    match &(*ir).return_type:
        Some(return_type) =>
            output.push_str(return_type)
            ()
            ()
            ()
            ()
        _ =>
            output.push_str("void")
            ()
            ()
            ()
            ()
    output.push_str(" ")
    ()
    output.push_str(&(*ir).event_name)
    ()
    output.push_str("(")
    ()
    let params: Array<String> = (*ir).params.iter().map(fn(param): format_param(param)).collect()
    output.push_str(&params.join(", "))
    ()
    output.push_str(");\n\n")
    ()
    output.push_str("    virtual ")
    ()
    match &(*ir).return_type:
        Some(return_type) =>
            output.push_str(return_type)
            ()
            ()
            ()
            ()
        _ =>
            output.push_str("void")
            ()
            ()
            ()
            ()
    output.push_str(" ")
    ()
    output.push_str(&(*ir).event_name)
    ()
    output.push_str("_Implementation(")
    ()
    output.push_str(&params.join(", "))
    ()
    output.push_str(");\n")
    ()

@doc(doc = " Generate Blueprint event source implementation")
fn generate_event_source_implementation(ir: &BlueprintEventIR, class_name: String, output: String):
    match &(*ir).return_type:
        Some(return_type) =>
            output.push_str(return_type)
            ()
            ()
            ()
            ()
        _ =>
            output.push_str("void")
            ()
            ()
            ()
            ()
    output.push_str(" ")
    ()
    output.push_str(class_name)
    ()
    output.push_str("::")
    ()
    output.push_str(&(*ir).event_name)
    ()
    output.push_str("_Implementation(")
    ()
    let params: Array<String> = (*ir).params.iter().map(fn(param): format_param(param)).collect()
    output.push_str(&params.join(", "))
    ()
    output.push_str(")\n")
    ()
    output.push_str("{\n")
    ()
    match &(*ir).implementation_body:
        Some(body) =>
            output.push_str("    ")
            ()
            output.push_str(body)
            ()
            output.push_str("\n")
            ()
            ()
            ()
            ()
        _ =>
            output.push_str("    // Default implementation\n")
            ()
            if (*ir).return_type.is_some():
                output.push_str("    return {};\n")
                ()
                ()
                ()
                ()
            ()
    output.push_str("}\n")
    ()

@doc(doc = " Format a parameter for C++ function signature")
fn format_param(param: &BlueprintParamIR) -> String:
    f"{(*param).cpp_type} {(*param).name}"

@doc(doc = " Generate K2Node code from IR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `ir` - The K2Node intermediate representation")
@doc(doc = " * `plugin_name` - Name of the plugin (for API macro)")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `K2NodeCodegenOutput` - Generated header and source files")
pub fn generate_k2node_code(ir: &K2NodeIR, plugin_name: String) -> K2NodeCodegenOutput:
    let node_class_name = f"UK2Node_{(*ir).node_name}"
    let api_macro = f"{plugin_name.to_uppercase()}_API"
    let mut header = String__new_()
    let mut source = String__new_()
    generate_k2node_header(ir, &node_class_name, &api_macro, &mut header)
    ()
    generate_k2node_source(ir, &node_class_name, &mut source)
    ()
    K2NodeCodegenOutput { header: header, source: source, includes: [("CoreMinimal.h").to_string(), ("K2Node.h").to_string(), ("EdGraph/EdGraphPin.h").to_string(), ("KismetCompiler.h").to_string()] }

@doc(doc = " Generate K2Node class header")
fn generate_k2node_header(ir: &K2NodeIR, node_class_name: String, api_macro: String, output: String):
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"K2Node.h\"\n")
    ()
    output.push_str("#include \"EdGraph/EdGraphPin.h\"\n")
    ()
    output.push_str(&f"#include \"{(*ir).node_name}.generated.h\"\n\n")
    ()
    output.push_str("/**\n")
    ()
    output.push_str(&f" * Custom Blueprint node: {(*ir).node_title}\n")
    ()
    output.push_str(&f" * Category: {(*ir).category}\n")
    ()
    output.push_str(" */\n")
    ()
    output.push_str("UCLASS()\n")
    ()
    output.push_str(&f"class {api_macro} {node_class_name} : public UK2Node\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    GENERATED_BODY()\n\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"    {node_class_name}();\n\n")
    ()
    output.push_str("    // UK2Node interface\n")
    ()
    output.push_str("    virtual void AllocateDefaultPins() override;\n")
    ()
    output.push_str("    virtual FText GetNodeTitle(ENodeTitleType::Type TitleType) const override;\n")
    ()
    output.push_str("    virtual FText GetTooltipText() const override;\n")
    ()
    output.push_str("    virtual FLinearColor GetNodeTitleColor() const override;\n")
    ()
    output.push_str("    virtual void ExpandNode(class FKismetCompilerContext& CompilerContext, UEdGraph* SourceGraph) override;\n")
    ()
    output.push_str("    virtual FSlateIcon GetIconAndTint(FLinearColor& OutColor) const override;\n\n")
    ()
    output.push_str("private:\n")
    ()
    output.push_str("    // Pin names\n")
    ()
    for pin in &(*ir).input_pins:
        output.push_str(&f"    static const FName {pin.name}PinName;\n")
        ()
    ()
    for pin in &(*ir).output_pins:
        output.push_str(&f"    static const FName {pin.name}PinName;\n")
        ()
    ()
    output.push_str("};\n")
    ()

@doc(doc = " Generate K2Node class source")
fn generate_k2node_source(ir: &K2NodeIR, node_class_name: String, output: String):
    output.push_str(&f"#include \"{(*ir).node_name}.h\"\n")
    ()
    output.push_str("#include \"BlueprintActionDatabaseRegistrar.h\"\n")
    ()
    output.push_str("#include \"BlueprintNodeSpawner.h\"\n")
    ()
    output.push_str("#include \"K2Node_CallFunction.h\"\n\n")
    ()
    for pin in &(*ir).input_pins:
        output.push_str(&f"const FName {node_class_name}::{pin.name}PinName(TEXT(\"{pin.name}\"));\n")
        ()
    ()
    for pin in &(*ir).output_pins:
        output.push_str(&f"const FName {node_class_name}::{pin.name}PinName(TEXT(\"{pin.name}\"));\n")
        ()
    ()
    output.push_str("\n")
    ()
    output.push_str(&f"{node_class_name}::{node_class_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {node_class_name}::AllocateDefaultPins()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    Super::AllocateDefaultPins();\n\n")
    ()
    for pin in &(*ir).input_pins:
        generate_pin_creation(pin, true, output)
        ()
    ()
    for pin in &(*ir).output_pins:
        generate_pin_creation(pin, false, output)
        ()
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"FText {node_class_name}::GetNodeTitle(ENodeTitleType::Type TitleType) const\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str(&f"    return FText::FromString(TEXT(\"{(*ir).node_title}\"));\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"FText {node_class_name}::GetTooltipText() const\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str(&f"    return FText::FromString(TEXT(\"{(*ir).node_title}\"));\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"FLinearColor {node_class_name}::GetNodeTitleColor() const\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    return FLinearColor(0.2f, 0.6f, 1.0f);\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {node_class_name}::ExpandNode(class FKismetCompilerContext& CompilerContext, UEdGraph* SourceGraph)\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    Super::ExpandNode(CompilerContext, SourceGraph);\n\n")
    ()
    match &(*ir).expand_logic:
        Some(expand_logic) =>
            output.push_str("    // Custom expansion logic\n")
            ()
            output.push_str(&f"    {expand_logic}\n")
            ()
            ()
            ()
            ()
        _ =>
            output.push_str("    // TODO: Implement node expansion logic\n")
            ()
            ()
            ()
            ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"FSlateIcon {node_class_name}::GetIconAndTint(FLinearColor& OutColor) const\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    OutColor = GetNodeTitleColor();\n")
    ()
    output.push_str("    return FSlateIcon(\"EditorStyle\", \"Kismet.AllClasses.FunctionIcon\");\n")
    ()
    output.push_str("}\n")
    ()

@doc(doc = " Generate pin creation code")
fn generate_pin_creation(pin: &K2PinIR, is_input: Bool, output: String):
    let direction = if is_input:
        "EGPD_Input"
    else:
        "EGPD_Output"
    let pin_category = map_pin_type_to_category(&(*pin).pin_type)
    output.push_str(&f"    CreatePin({direction}, {pin_category}, {(*pin).name}PinName);\n")
    ()

@doc(doc = " Map K2PinType to UE5 pin category")
fn map_pin_type_to_category(pin_type: &K2PinType) -> String:
    match pin_type:
        K2PinType::Exec => ("UEdGraphSchema_K2::PC_Exec").to_string()
        K2PinType::Bool => ("UEdGraphSchema_K2::PC_Boolean").to_string()
        K2PinType::Int => ("UEdGraphSchema_K2::PC_Int").to_string()
        K2PinType::Int64 => ("UEdGraphSchema_K2::PC_Int").to_string()
        K2PinType::Float => ("UEdGraphSchema_K2::PC_Real").to_string()
        K2PinType::String => ("UEdGraphSchema_K2::PC_String").to_string()
        K2PinType::Name => ("UEdGraphSchema_K2::PC_Name").to_string()
        K2PinType::Text => ("UEdGraphSchema_K2::PC_Text").to_string()
        K2PinType::Vector => ("UEdGraphSchema_K2::PC_Struct").to_string()
        K2PinType::Rotator => ("UEdGraphSchema_K2::PC_Struct").to_string()
        K2PinType::Transform => ("UEdGraphSchema_K2::PC_Struct").to_string()
        K2PinType::Object(_) => ("UEdGraphSchema_K2::PC_Object").to_string()
        K2PinType::Struct(_) => ("UEdGraphSchema_K2::PC_Struct").to_string()
        K2PinType::Wildcard => ("UEdGraphSchema_K2::PC_Wildcard").to_string()

@doc(doc = " Generate async Blueprint node code from IR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `ir` - The async Blueprint node intermediate representation")
@doc(doc = " * `plugin_name` - Name of the plugin (for API macro)")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `AsyncBlueprintCodegenOutput` - Generated header and source files")
pub fn generate_async_blueprint_code(ir: &AsyncBlueprintIR, plugin_name: String) -> AsyncBlueprintCodegenOutput:
    let action_class_name = f"U{(*ir).action_name}"
    let api_macro = f"{plugin_name.to_uppercase()}_API"
    let mut header = String__new_()
    let mut source = String__new_()
    generate_async_action_header(ir, &action_class_name, &api_macro, &mut header)
    ()
    generate_async_action_source(ir, &action_class_name, &mut source)
    ()
    AsyncBlueprintCodegenOutput { header: header, source: source, includes: [("CoreMinimal.h").to_string(), ("Kismet/BlueprintAsyncActionBase.h").to_string(), ("Engine/LatentActionManager.h").to_string()] }

@doc(doc = " Generate async action class header")
fn generate_async_action_header(ir: &AsyncBlueprintIR, action_class_name: String, api_macro: String, output: String):
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"Kismet/BlueprintAsyncActionBase.h\"\n")
    ()
    output.push_str(&f"#include \"{(*ir).action_name}.generated.h\"\n\n")
    ()
    for pin in &(*ir).output_pins:
        generate_output_delegate_declaration(pin, output)
        ()
    ()
    output.push_str("/**\n")
    ()
    output.push_str(&f" * Async Blueprint action: {(*ir).action_name}\n")
    ()
    output.push_str(&f" * Category: {(*ir).category}\n")
    ()
    output.push_str(" */\n")
    ()
    output.push_str("UCLASS()\n")
    ()
    output.push_str(&f"class {api_macro} {action_class_name} : public UBlueprintAsyncActionBase\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    GENERATED_BODY()\n\n")
    ()
    output.push_str("public:\n")
    ()
    for pin in &(*ir).output_pins:
        output.push_str("    UPROPERTY(BlueprintAssignable)\n")
        ()
        output.push_str(&f"    F{pin.name}Delegate {pin.name};\n\n")
        ()
    ()
    output.push_str("    UFUNCTION(BlueprintCallable, meta = (BlueprintInternalUseOnly = \"true\", WorldContext = \"WorldContextObject\"), Category = \"")
    ()
    output.push_str(&(*ir).category)
    ()
    output.push_str("\")\n")
    ()
    output.push_str(&f"    static {action_class_name}* {(*ir).action_name}(UObject* WorldContextObject")
    ()
    for param in &(*ir).input_params:
        output.push_str(", ")
        ()
        output.push_str(&format_param(param))
        ()
    ()
    output.push_str(");\n\n")
    ()
    output.push_str("    virtual void Activate() override;\n\n")
    ()
    output.push_str("private:\n")
    ()
    for param in &(*ir).input_params:
        output.push_str(&f"    {param.cpp_type} {param.name};\n")
        ()
    ()
    output.push_str("};\n")
    ()

@doc(doc = " Generate output delegate declaration")
fn generate_output_delegate_declaration(pin: &AsyncOutputPinIR, output: String):
    output.push_str(&"DECLARE_DYNAMIC_MULTICAST_DELEGATE")
    ()
    if (!(*pin).params.is_empty()):
        output.push_str(&f"_{(*pin).params.len()}")
        ()
        output.push_str("Params")
        ()
        ()
        ()
        ()
    output.push_str(&f"(F{(*pin).name}Delegate")
    ()
    for selfhost_for_item in (*pin).params.iter().enumerate():
        let (i, param) = selfhost_for_item
        output.push_str(", ")
        ()
        output.push_str(&param.cpp_type)
        ()
        output.push_str(", ")
        ()
        output.push_str(&capitalize(&param.name))
        ()
    ()
    output.push_str(");\n\n")
    ()

@doc(doc = " Generate async action class source")
fn generate_async_action_source(ir: &AsyncBlueprintIR, action_class_name: String, output: String):
    output.push_str(&f"#include \"{(*ir).action_name}.h\"\n\n")
    ()
    output.push_str(&f"{action_class_name}* {action_class_name}::{(*ir).action_name}(UObject* WorldContextObject")
    ()
    for param in &(*ir).input_params:
        output.push_str(", ")
        ()
        output.push_str(&format_param(param))
        ()
    ()
    output.push_str(")\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str(&f"    {action_class_name}* Action = NewObject<{action_class_name}>();\n")
    ()
    for param in &(*ir).input_params:
        output.push_str(&f"    Action->{param.name} = {param.name};\n")
        ()
    ()
    output.push_str("    return Action;\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {action_class_name}::Activate()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    Super::Activate();\n\n")
    ()
    match &(*ir).activate_body:
        Some(body) =>
            output.push_str("    // Custom activation logic\n")
            ()
            output.push_str(&f"    {body}\n")
            ()
            ()
            ()
            ()
        _ =>
            output.push_str("    // TODO: Implement activation logic\n")
            ()
            output.push_str("    // Call appropriate output delegate when complete\n")
            ()
            ()
            ()
            ()
    output.push_str("}\n")
    ()

@doc(doc = " Capitalize first letter of a string")
fn capitalize(s: String) -> String:
    let mut chars = s.chars()
    match chars.next():
        None => String__new_()
        Some(first) => (first.to_uppercase().collect() + chars.as_str())

