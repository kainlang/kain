use crate::ue5::context::Ue5Context

use crate::ue5::types::TypeMapper

use kain_core::ast::AsyncTaskCallback

use kain_core::ast::AsyncTaskDef

use kain_core::ast::AsyncTaskThread

use kain_core::ast::Block

use kain_core::ast::Field

@doc(doc = " Async task intermediate representation")
@doc(doc = " Represents a task that can be executed on worker threads with completion callbacks")
@derive(Debug, Clone)
pub struct AsyncTaskIR:
    task_name: String
    input_fields: Array<AsyncTaskFieldIR>
    output_fields: Array<AsyncTaskFieldIR>
    callback: Option<AsyncTaskCallbackIR>
    do_work_body: Option<String>
    priority: i32

@doc(doc = " A single input or output field for the task")
@derive(Debug, Clone)
pub struct AsyncTaskFieldIR:
    name: String
    cpp_type: String
    is_array: Bool

@doc(doc = " Completion callback for async task")
@derive(Debug, Clone)
pub struct AsyncTaskCallbackIR:
    name: String
    thread: AsyncTaskThreadIR
    params: Array<AsyncTaskFieldIR>
    body: String

pub enum AsyncTaskThreadIR:
    Main
    Worker

impl Default for AsyncTaskIR:
    fn default_() -> AsyncTaskIR:
        AsyncTaskIR { task_name: String__new_(), input_fields: Vec__new_(), output_fields: Vec__new_(), callback: none, do_work_body: none, priority: 0 }


@doc(doc = " Convert an async task definition from AST to AsyncTaskIR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `task_def` - The async task definition from AST")
@doc(doc = " * `ctx` - UE5 compilation context for type mapping")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `Ok(AsyncTaskIR)` - Successfully converted IR")
@doc(doc = " * `Err(String)` - Conversion error with description")
pub fn convert_to_async_task_ir(task_def: &kain_core::ast::AsyncTaskDef, ctx: &Ue5Context) -> Result<AsyncTaskIR, String>:
    let mut type_mapper = TypeMapper__with_knowledge((*ctx).knowledge.clone())
    for enum_name in &(*ctx).enum_names:
        type_mapper.register_enum(enum_name.clone())
        ()
    ()
    for struct_name in &(*ctx).struct_names:
        type_mapper.register_struct(struct_name.clone())
        ()
    ()
    for component_name in &(*ctx).component_names:
        type_mapper.register_component(component_name.clone())
        ()
    ()
    for actor_name in &(*ctx).actor_names:
        type_mapper.register_actor(actor_name.clone())
        ()
    ()
    for delegate_name in &(*ctx).delegate_names:
        type_mapper.register_delegate(delegate_name.clone())
        ()
    ()
    let input_fields = (*task_def).input_fields.iter().map(fn(field): convert_field(field, &type_mapper)).collect()?
    let output_fields = (*task_def).output_fields.iter().map(fn(field): convert_field(field, &type_mapper)).collect()?
    let callback = match &(*task_def).callback:
        Some(cb) => Option::Some(convert_callback(cb, &type_mapper, ctx)?)
        _ =>
            none
    let do_work_body = match &(*task_def).do_work:
        Some(block) => Option::Some(convert_block_to_cpp(block, ctx))
        _ =>
            none
    let priority = (*task_def).priority.unwrap_or(0)
    Result::Ok(AsyncTaskIR { task_name: (*task_def).name.clone(), input_fields: input_fields, output_fields: output_fields, callback: callback, do_work_body: do_work_body, priority: priority })

@doc(doc = " Convert a field to AsyncTaskFieldIR")
fn convert_field(field: &kain_core::ast::Field, type_mapper: &TypeMapper) -> Result<AsyncTaskFieldIR, String>:
    let cpp_type = type_mapper.map_type_string(&(*field).ty)
    let is_array = cpp_type.starts_with("TArray<")
    Result::Ok(AsyncTaskFieldIR { name: (*field).name.clone(), cpp_type: cpp_type, is_array: is_array })

@doc(doc = " Convert callback definition to AsyncTaskCallbackIR")
fn convert_callback(callback: &kain_core::ast::AsyncTaskCallback, type_mapper: &TypeMapper, ctx: &Ue5Context) -> Result<AsyncTaskCallbackIR, String>:
    let thread = match (*callback).thread:
        kain_core__ast__AsyncTaskThread::Main => AsyncTaskThreadIR__Main
        kain_core__ast__AsyncTaskThread::Worker => AsyncTaskThreadIR__Worker
    let params = (*callback).params.iter().map(fn(param): none).collect()?
    let body = convert_block_to_cpp(&(*callback).body, ctx)
    Result::Ok(AsyncTaskCallbackIR { name: (*callback).name.clone(), thread: thread, params: params, body: body })

@doc(doc = " Convert a KAIN block to C++ code")
@doc(doc = "")
@doc(doc = " This is a placeholder implementation that will be replaced with proper")
@doc(doc = " expression codegen when the full codegen pipeline is integrated.")
fn convert_block_to_cpp(block: &kain_core::ast::Block, _ctx: &Ue5Context) -> String:
    f"/* Block with {(*block).stmts.len()} statements */"

