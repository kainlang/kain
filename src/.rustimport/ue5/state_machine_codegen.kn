use crate::state_machine_ir::StateMachineIR

@doc(doc = " Output from state machine code generation")
@derive(Debug, Clone)
pub struct StateMachineCodegenOutput:
    header: String
    source: String
    includes: Array<String>

@doc(doc = " Generate state machine code from IR")
@doc(doc = "")
@doc(doc = " # Arguments")
@doc(doc = " * `ir` - The state machine intermediate representation")
@doc(doc = " * `plugin_name` - Name of the plugin (for API macro)")
@doc(doc = "")
@doc(doc = " # Returns")
@doc(doc = " * `StateMachineCodegenOutput` - Generated header and source files")
pub fn generate_state_machine_code(ir: &StateMachineIR, plugin_name: String) -> StateMachineCodegenOutput:
    let class_name = f"U{(*ir).name}StateMachine"
    let api_macro = f"{plugin_name.to_uppercase()}_API"
    let mut header = String__new_()
    let mut source = String__new_()
    generate_header(ir, &class_name, &api_macro, &mut header)
    ()
    generate_source(ir, &class_name, &mut source)
    ()
    StateMachineCodegenOutput { header: header, source: source, includes: [("CoreMinimal.h").to_string(), ("UObject/NoExportTypes.h").to_string(), ("Animation/AnimSequence.h").to_string()] }

@doc(doc = " Generate header file content")
fn generate_header(ir: &StateMachineIR, class_name: String, api_macro: String, output: String):
    let guard = f"{class_name.to_uppercase()}_GENERATED_H"
    output.push_str(&"#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"UObject/NoExportTypes.h\"\n")
    ()
    output.push_str("#include \"Animation/AnimSequence.h\"\n")
    ()
    output.push_str(&f"#include \"{(*ir).name}.generated.h\"\n\n")
    ()
    generate_state_enum(ir, output)
    ()
    output.push_str(&"UCLASS(BlueprintType)\n")
    ()
    output.push_str(&f"class {api_macro} {class_name} : public UObject\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    GENERATED_BODY()\n\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"    {class_name}();\n\n")
    ()
    output.push_str("    /** Current active state */\n")
    ()
    output.push_str("    UPROPERTY(BlueprintReadOnly, Category = \"State Machine\")\n")
    ()
    output.push_str(&f"    E{(*ir).name}State CurrentState;\n\n")
    ()
    generate_animation_properties(ir, output)
    ()
    output.push_str("    /** Update state machine and evaluate transitions */\n")
    ()
    output.push_str("    UFUNCTION(BlueprintCallable, Category = \"State Machine\")\n")
    ()
    output.push_str("    void UpdateStateMachine(float DeltaTime);\n\n")
    ()
    output.push_str("    /** Get animation for current state */\n")
    ()
    output.push_str("    UFUNCTION(BlueprintPure, Category = \"State Machine\")\n")
    ()
    output.push_str("    UAnimSequence* GetCurrentAnimation() const;\n\n")
    ()
    generate_transition_method_declarations(ir, output)
    ()
    generate_state_callback_declarations(ir, output)
    ()
    output.push_str("private:\n")
    ()
    output.push_str("    /** Internal method to transition to a new state */\n")
    ()
    output.push_str(&f"    void TransitionToState(E{(*ir).name}State NewState);\n\n")
    ()
    output.push_str("};\n")
    ()

@doc(doc = " Generate state enum")
fn generate_state_enum(ir: &StateMachineIR, output: String):
    output.push_str("/** State enum for state machine */\n")
    ()
    output.push_str("UENUM(BlueprintType)\n")
    ()
    output.push_str(&f"enum class E{(*ir).name}State : uint8\n")
    ()
    output.push_str("{\n")
    ()
    for selfhost_for_item in (*ir).states.iter().enumerate():
        let (i, state_) = selfhost_for_item
        output.push_str(&f"    {state_.name} UMETA(DisplayName = \"{state_.name}\")")
        ()
        if (i < ((*ir).states.len() - 1)):
            output.push_str(",\n")
            ()
        else:
            output.push_str("\n")
            ()
    ()
    output.push_str("};\n\n")
    ()

@doc(doc = " Generate animation properties for each state")
fn generate_animation_properties(ir: &StateMachineIR, output: String):
    output.push_str("    /** Animation references for each state */\n")
    ()
    for state_ in &(*ir).states:
        if state_.animation.is_some():
            output.push_str(&"    UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = \"State Machine|Animations\")\n")
            ()
            output.push_str(&f"    UAnimSequence* {state_.name}Animation;\n\n")
            ()

@doc(doc = " Generate transition evaluation method declarations")
fn generate_transition_method_declarations(ir: &StateMachineIR, output: String):
    output.push_str("    /** Transition evaluation methods */\n")
    ()
    for state_ in &(*ir).states:
        for transition in &state_.transitions:
            let method_name = f"CanTransitionTo{transition.to_state}"
            output.push_str(&f"    bool {method_name}() const;\n")
            ()
    ()
    if ((!(*ir).states.is_empty()) && (*ir).states.iter().any(fn(s): (!s.transitions.is_empty()))):
        output.push_str("\n")
        ()

@doc(doc = " Generate state callback method declarations")
fn generate_state_callback_declarations(ir: &StateMachineIR, output: String):
    let mut has_callbacks = false
    for state_ in &(*ir).states:
        if (state_.on_enter.is_some() || state_.on_exit.is_some()):
            has_callbacks = true
            ()
            break
    ()
    if (!has_callbacks):
        return
    output.push_str("    /** State lifecycle callbacks */\n")
    ()
    for state_ in &(*ir).states:
        if state_.on_enter.is_some():
            output.push_str(&f"    void OnEnter{state_.name}();\n")
            ()
            ()
            ()
            ()
        if state_.on_exit.is_some():
            output.push_str(&f"    void OnExit{state_.name}();\n")
            ()
    ()
    output.push_str("\n")
    ()

@doc(doc = " Generate source file content")
fn generate_source(ir: &StateMachineIR, class_name: String, output: String):
    output.push_str(&f"#include \"{(*ir).name}.h\"\n\n")
    ()
    generate_constructor(ir, class_name, output)
    ()
    generate_update_method(ir, class_name, output)
    ()
    generate_get_current_animation(ir, class_name, output)
    ()
    generate_transition_method_implementations(ir, class_name, output)
    ()
    generate_state_callback_implementations(ir, class_name, output)
    ()
    generate_transition_to_state_method(ir, class_name, output)
    ()

@doc(doc = " Generate constructor implementation")
fn generate_constructor(ir: &StateMachineIR, class_name: String, output: String):
    output.push_str(&f"{class_name}::{class_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str(&"    // Initialize to entry state\n")
    ()
    output.push_str(&f"    CurrentState = E{(*ir).name}State::{(*ir).entry_state};\n")
    ()
    for state_ in &(*ir).states:
        if state_.animation.is_some():
            output.push_str(&f"    {state_.name}Animation = nullptr;\n")
            ()
    ()
    output.push_str("}\n\n")
    ()

@doc(doc = " Generate UpdateStateMachine method implementation")
fn generate_update_method(ir: &StateMachineIR, class_name: String, output: String):
    output.push_str(&f"void {class_name}::UpdateStateMachine(float DeltaTime)\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    // Evaluate transitions based on current state\n")
    ()
    output.push_str("    switch (CurrentState)\n")
    ()
    output.push_str("    {\n")
    ()
    for state_ in &(*ir).states:
        output.push_str(&f"    case E{(*ir).name}State::{state_.name}:\n")
        ()
        output.push_str("    {\n")
        ()
        if state_.transitions.is_empty():
            output.push_str("        // No transitions from this state\n")
            ()
            ()
            ()
            ()
        else:
            output.push_str("        // Evaluate transitions in priority order\n")
            ()
            for transition in &state_.transitions:
                let method_name = f"CanTransitionTo{transition.to_state}"
                output.push_str(&f"        if ({method_name}())\n")
                ()
                output.push_str("        {\n")
                ()
                output.push_str(&f"            TransitionToState(E{(*ir).name}State::{transition.to_state});\n")
                ()
                output.push_str("            return;\n")
                ()
                output.push_str("        }\n")
                ()
            ()
            ()
        output.push_str("        break;\n")
        ()
        output.push_str("    }\n")
        ()
    ()
    output.push_str("    default:\n")
    ()
    output.push_str("        break;\n")
    ()
    output.push_str("    }\n")
    ()
    output.push_str("}\n\n")
    ()

@doc(doc = " Generate GetCurrentAnimation method implementation")
fn generate_get_current_animation(ir: &StateMachineIR, class_name: String, output: String):
    output.push_str(&f"UAnimSequence* {class_name}::GetCurrentAnimation() const\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    switch (CurrentState)\n")
    ()
    output.push_str("    {\n")
    ()
    for state_ in &(*ir).states:
        if state_.animation.is_some():
            output.push_str(&f"    case E{(*ir).name}State::{state_.name}:\n")
            ()
            output.push_str(&f"        return {state_.name}Animation;\n")
            ()
    ()
    output.push_str("    default:\n")
    ()
    output.push_str("        return nullptr;\n")
    ()
    output.push_str("    }\n")
    ()
    output.push_str("}\n\n")
    ()

@doc(doc = " Generate transition evaluation method implementations")
fn generate_transition_method_implementations(ir: &StateMachineIR, class_name: String, output: String):
    for state_ in &(*ir).states:
        for transition in &state_.transitions:
            let method_name = f"CanTransitionTo{transition.to_state}"
            output.push_str(&f"bool {class_name}::{method_name}() const\n")
            ()
            output.push_str("{\n")
            ()
            if (transition.condition == "true"):
                output.push_str("    // Always transition (no condition)\n")
                ()
                output.push_str("    return true;\n")
                ()
                ()
                ()
                ()
            else:
                output.push_str(&"    // Transition condition\n")
                ()
                output.push_str(&f"    return {transition.condition};\n")
                ()
                ()
                ()
                ()
            output.push_str("}\n\n")
            ()

@doc(doc = " Generate state callback implementations")
fn generate_state_callback_implementations(ir: &StateMachineIR, class_name: String, output: String):
    for state_ in &(*ir).states:
        match &state_.on_enter:
            Some(on_enter) =>
                output.push_str(&f"void {class_name}::OnEnter{state_.name}()\n")
                ()
                output.push_str("{\n")
                ()
                output.push_str(&f"    // Entry callback for {state_.name} state\n")
                ()
                output.push_str(&f"    {on_enter}\n")
                ()
                output.push_str("}\n\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &state_.on_exit:
            Some(on_exit) =>
                output.push_str(&f"void {class_name}::OnExit{state_.name}()\n")
                ()
                output.push_str("{\n")
                ()
                output.push_str(&f"    // Exit callback for {state_.name} state\n")
                ()
                output.push_str(&f"    {on_exit}\n")
                ()
                output.push_str("}\n\n")
                ()
            _ => ()

@doc(doc = " Generate TransitionToState method implementation")
fn generate_transition_to_state_method(ir: &StateMachineIR, class_name: String, output: String):
    output.push_str(&f"void {class_name}::TransitionToState(E{(*ir).name}State NewState)\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("    if (CurrentState == NewState)\n")
    ()
    output.push_str("    {\n")
    ()
    output.push_str("        return; // Already in this state\n")
    ()
    output.push_str("    }\n\n")
    ()
    output.push_str("    // Call exit callback for current state\n")
    ()
    output.push_str("    switch (CurrentState)\n")
    ()
    output.push_str("    {\n")
    ()
    for state_ in &(*ir).states:
        if state_.on_exit.is_some():
            output.push_str(&f"    case E{(*ir).name}State::{state_.name}:\n")
            ()
            output.push_str(&f"        OnExit{state_.name}();\n")
            ()
            output.push_str("        break;\n")
            ()
    ()
    output.push_str("    default:\n")
    ()
    output.push_str("        break;\n")
    ()
    output.push_str("    }\n\n")
    ()
    output.push_str("    // Update current state\n")
    ()
    output.push_str("    CurrentState = NewState;\n\n")
    ()
    output.push_str("    // Call entry callback for new state\n")
    ()
    output.push_str("    switch (NewState)\n")
    ()
    output.push_str("    {\n")
    ()
    for state_ in &(*ir).states:
        if state_.on_enter.is_some():
            output.push_str(&f"    case E{(*ir).name}State::{state_.name}:\n")
            ()
            output.push_str(&f"        OnEnter{state_.name}();\n")
            ()
            output.push_str("        break;\n")
            ()
    ()
    output.push_str("    default:\n")
    ()
    output.push_str("        break;\n")
    ()
    output.push_str("    }\n")
    ()
    output.push_str("}\n")
    ()

