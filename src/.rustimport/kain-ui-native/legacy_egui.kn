fn render_children_content(app: &mut KainUiNativeApp, ui: &mut eframe::egui::Ui, ctx: &eframe::egui::Context, tree: &kain_ui::UiTree, theme_registry: &kain_ui::UiThemeRegistry, app_theme: &NativeAppTheme, node: &kain_ui::UiNode, layout_gap: f32):
    let cross_align = layout_align((*node).layout.align_items)
    let child_entries = collect_child_render_entries(tree, node)
    match (*node).layout.kind:
        kain_ui__UiLayoutKind::FlexRow =>
            ui.with_layout(Layout__left_to_right(cross_align), fn(ui): none)
            ()
        kain_ui__UiLayoutKind::FlexColumn =>
            ui.with_layout(Layout__top_down(cross_align), fn(ui): none)
            ()
        kain_ui__UiLayoutKind::Grid =>
            let columns = (*node).props.get("columns").and_then(ui_value_as_i64).unwrap_or(2).max(1) as usize
            Grid__new_(f"kain_ui_native_grid_{node_layout_identity(node)}").num_columns(columns).spacing(eframe__egui__vec2(layout_gap, layout_gap)).show(ui, fn(ui): none)
            ()
        kain_ui__UiLayoutKind::Stack =>
            let overlay_theme = resolve_widget_theme(node, theme_registry, app_theme)
            for selfhost_for_item in child_entries.iter().enumerate():
                let (index, entry) = selfhost_for_item
                if (index > 0):
                    ui.add_space(((-overlay_theme.gap) * 0.35))
                    ()
                    ()
                    ()
                    ()
                ui.scope(fn(ui): none)
                ()
        kain_ui__UiLayoutKind::Absolute =>
            let overlay_theme = resolve_widget_theme(node, theme_registry, app_theme)
            for selfhost_for_item in child_entries.iter().enumerate():
                let (index, entry) = selfhost_for_item
                if (index > 0):
                    ui.add_space(((-overlay_theme.gap) * 0.35))
                    ()
                    ()
                    ()
                    ()
                ui.scope(fn(ui): none)
                ()
        kain_ui__UiLayoutKind::Dock =>
            let split = (*node).layout.split_ratio.unwrap_or(0.28).clamp(0.15, 0.65)
            let mut left = Vec__new_()
            let mut right = Vec__new_()
            let mut top = Vec__new_()
            let mut bottom = Vec__new_()
            let mut center = Vec__new_()
            for entry in child_entries:
                let placement = child_entry_dock_placement(tree, &entry)
                match placement:
                    kain_ui__UiDockPlacement::Left => left.push(entry)
                    kain_ui__UiDockPlacement::Right => right.push(entry)
                    kain_ui__UiDockPlacement::Top => top.push(entry)
                    kain_ui__UiDockPlacement::Bottom => bottom.push(entry)
                    _ => center.push(entry)
            ()
            if (!top.is_empty()):
                ui.scope(fn(ui): none)
                ()
                ui.add_space(layout_gap)
                ()
                ()
                ()
                ()
            ui.horizontal_top(fn(ui): none)
            ()
            if (!bottom.is_empty()):
                ui.add_space(layout_gap)
                ()
                ui.scope(fn(ui): none)
                ()
        _ =>
            for entry in &child_entries:
                render_child_entry(app, ui, ctx, tree, theme_registry, app_theme, entry)
                ()

