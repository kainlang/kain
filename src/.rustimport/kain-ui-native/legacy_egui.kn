const SHADER_CANVAS_BITMAP_FONT_FAMILY: String = "kain.builtin.bitmap_5x7"

const SHADER_CANVAS_DEFAULT_FONT_FAMILY: String = "kain.default-ui-sans"

const UI_SHADER_SURFACE_FULLSCREEN_VERTEX_WGSL: String = "\n\nstruct KainUiSurfaceVertexOut {\n    @builtin(position) position: vec4<f32>,\n    @location(0) uv: vec2<f32>,\n};\n\n@vertex\nfn kain_ui_surface_vs_main(@builtin(vertex_index) vertex_index: u32) -> KainUiSurfaceVertexOut {\n    var positions = array<vec2<f32>, 3>(\n        vec2<f32>(-1.0, -3.0),\n        vec2<f32>(-1.0, 1.0),\n        vec2<f32>(3.0, 1.0),\n    );\n    var uvs = array<vec2<f32>, 3>(\n        vec2<f32>(0.0, 2.0),\n        vec2<f32>(0.0, 0.0),\n        vec2<f32>(2.0, 0.0),\n    );\n    var output: KainUiSurfaceVertexOut;\n    output.position = vec4<f32>(positions[vertex_index], 0.0, 1.0);\n    output.uv = uvs[vertex_index];\n    return output;\n}\n"

struct ShaderCanvasFontFamilySpec:
