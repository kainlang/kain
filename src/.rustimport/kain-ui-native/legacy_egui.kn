fn sync_viewport_input(input: &ViewportInputSnapshot, response: &eframe::egui::Response, reference_pose: &kain_3d::CameraPose, controller: &mut ViewportCameraController, drag_trigger: ViewportManipulatorDragTrigger, dt_seconds: f32):
