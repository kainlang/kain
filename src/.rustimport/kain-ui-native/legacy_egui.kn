fn resolve_viewport_binding(app: &KainUiNativeApp, node: &kain_ui::UiNode) -> ResolvedViewportBinding:
    let viewport_node = f"surface.node.{(*node).id.field_0}"
    match (*app).realtime_catalog.scenes_by_viewport.get(&viewport_node):
        Some(binding) =>
            let mut warnings = Vec__new_()
            for material_ref in &binding.material_refs:
                if (!(*app).realtime_catalog.materials_by_id.contains_key(material_ref)):
                    warnings.push(f"missing material `{material_ref}`")
                    ()
            ()
            for shader_ref_key in &binding.shader_bundle_ref_keys:
                if (!(*app).realtime_catalog.shader_refs_by_key.contains_key(shader_ref_key)):
                    warnings.push(f"missing shader ref `{shader_ref_key}`")
                    ()
            ()
            return ResolvedViewportBinding { viewport_node: Option::Some(viewport_node), scene_name: binding.scene.clone(), material_refs: binding.material_refs.clone(), shader_ref_keys: binding.shader_bundle_ref_keys.clone(), camera: binding.camera.clone(), presentation: binding.presentation.clone(), warning: ((!warnings.is_empty())).then(fn(): warnings.join(" | ")) }
        _ =>
            ()
            ()
    ResolvedViewportBinding { viewport_node: none, scene_name: prop_text(node, "scene").unwrap_or((*app).scene_catalog.default_scene.as_str()).to_string(), material_refs: prop_text(node, "material").map(fn(value): [value.to_string()]).unwrap_or_default(), shader_ref_keys: Vec__new_(), camera: resolve_viewport_camera_binding_from_node(node), presentation: resolve_viewport_presentation_binding_from_node(node), warning: none }

fn render_surface_frame(ui: &mut eframe::egui::Ui, node: &kain_ui::UiNode, theme_registry: &kain_ui::UiThemeRegistry, app_theme: &NativeAppTheme, presentation: NativeNodePresentation, fallback_title: String, desired_size: eframe::egui::Vec2, sense: eframe::egui::Sense, paint: impl FnOnce):
