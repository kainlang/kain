    let theme = apply_node_presentation_to_theme(resolve_widget_theme(node, theme_registry, app_theme), presentation)
    themed_frame(&theme).show(ui, fn(ui): none)
    ()

fn widget_surface_title(node: &kain_ui::UiNode) -> String:
