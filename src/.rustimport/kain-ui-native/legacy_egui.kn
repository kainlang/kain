pub const KAIN_UI_NATIVE_DEMO_SOURCE: String = "\ncomponent App():\n    render <panel title=\"Kain UI Retirement Demo\" layout=\"dock\" gap={12} padding={12}>\n        <panel title=\"Workspace Shell\" layout=\"row\" gap={12}>\n            <inspector title=\"Selection\">\n                Active document: kain-ui\n            </inspector>\n            <tree title=\"Project Tree\">\n                crates/\n                kain-core/\n                kain-ui/\n                kain-ui-native/\n            </tree>\n        </panel>\n        <graph title=\"Material Graph\" />\n        <timeline title=\"Sequencer\" />\n        <viewport3d title=\"Luminous Port Viewport\" scene=\"luminous_port\" />\n    </panel>\n"

@derive(Clone, Debug)
pub struct KainUiNativeBackendPlan:
    shell_host_backend: kain_ui::UiHostBackendKind
    document_host_backend: kain_ui::UiHostBackendKind
    devtools_host_backend: kain_ui::UiHostBackendKind
    layout_engine: kain_ui::UiLayoutEngineKind
    render_engine: kain_ui::UiRenderEngineKind
    compatibility_host_backend: kain_ui::UiHostBackendKind
    mixed_backend_session: Bool

impl Default for KainUiNativeBackendPlan:
    fn default_() -> KainUiNativeBackendPlan:
        KainUiNativeBackendPlan { shell_host_backend: kain_ui__UiHostBackendKind__Qt, document_host_backend: kain_ui__UiHostBackendKind__RmlUi, devtools_host_backend: kain_ui__UiHostBackendKind__Imgui, layout_engine: kain_ui__UiLayoutEngineKind__Yoga, render_engine: kain_ui__UiRenderEngineKind__Wgpu, compatibility_host_backend: kain_ui__UiHostBackendKind__LegacyEgui, mixed_backend_session: true }


impl KainUiNativeBackendPlan:
    fn from_runtime_metadata(metadata: &kain_ui::UiRuntimeMetadata) -> KainUiNativeBackendPlan:
        KainUiNativeBackendPlan { shell_host_backend: (*metadata).preferred_shell_host_backend, document_host_backend: (*metadata).preferred_document_host_backend, devtools_host_backend: (*metadata).preferred_devtools_host_backend, layout_engine: (*metadata).preferred_layout_engine, render_engine: (*metadata).preferred_render_engine, compatibility_host_backend: (*metadata).compatibility_host_backend, mixed_backend_session: (*metadata).mixed_backend_session }

    fn shell_label(_self: &KainUiNativeBackendPlan) -> String:
        host_backend_label((*_self).shell_host_backend)

    fn devtools_label(_self: &KainUiNativeBackendPlan) -> String:
        host_backend_label((*_self).devtools_host_backend)


@derive(Clone, Debug)
pub struct KainUiNativeAppConfig:
    window_title: String
    root_component: String
    source: String
    initial_window_size: [f32; 2]
    backend_plan: KainUiNativeBackendPlan

pub type KainUiNativeDemoConfig = KainUiNativeAppConfig

fn trace_enabled() -> Bool:
    std__env__var_("KAIN_UI_NATIVE_TRACE").map(fn(value): ((value == "1") || value.eq_ignore_ascii_case("true"))).unwrap_or(false)

fn trace_path() -> std::path::PathBuf:
    std__env__temp_dir().join("kain-ui-native-trace.log")

fn trace_runtime(message: impl AsRef<String>):
    if (!trace_enabled()):
        return
    let line_ = f"{message}\n"
    match OpenOptions__new_().create(true).append(true).open(trace_path()):
        Ok(mut file) =>
            let _ = file.write_all(line_.as_bytes())
        _ => ()

enum NativeRendererPreference:
    Glow
    Wgpu

@derive(Clone, Copy, Debug, PartialEq, Eq)
struct KainUiNativeRuntimeSettings:
    renderer: NativeRendererPreference
    show_runtime_inspector: Bool
    enable_viewports: Bool
    repaint_interval_ms: u64
    viewport_render_interval_idle_ms: u64
    viewport_render_interval_interactive_ms: u64
    viewport_startup_delay_ms: u64
    viewport_max_axis_px: u64

impl Default for KainUiNativeRuntimeSettings:
    fn default_() -> KainUiNativeRuntimeSettings:
        KainUiNativeRuntimeSettings { renderer: NativeRendererPreference__Wgpu, show_runtime_inspector: false, enable_viewports: true, repaint_interval_ms: DEFAULT_REPAINT_INTERVAL_MS, viewport_render_interval_idle_ms: DEFAULT_VIEWPORT_RENDER_INTERVAL_IDLE_MS, viewport_render_interval_interactive_ms: DEFAULT_VIEWPORT_RENDER_INTERVAL_INTERACTIVE_MS, viewport_startup_delay_ms: DEFAULT_VIEWPORT_STARTUP_DELAY_MS, viewport_max_axis_px: DEFAULT_VIEWPORT_MAX_AXIS_PX }


impl KainUiNativeRuntimeSettings:
    fn from_env() -> KainUiNativeRuntimeSettings:
        let mut settings = KainUiNativeRuntimeSettings__default_()
        match env_var_trimmed("KAIN_UI_NATIVE_VIEWPORT_RENDERER").or_else(fn(): env_var_trimmed("KAIN_UI_NATIVE_RENDERER")):
            Some(renderer) =>
                settings.renderer = parse_renderer_preference(&renderer)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match env_bool("KAIN_UI_NATIVE_SHOW_INSPECTOR"):
            Some(value) =>
                settings.show_runtime_inspector = value
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match env_bool("KAIN_UI_NATIVE_ENABLE_VIEWPORTS"):
            Some(value) =>
                settings.enable_viewports = value
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match env_u64("KAIN_UI_NATIVE_REPAINT_MS"):
            Some(value) =>
                settings.repaint_interval_ms = value.max(1)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match env_u64("KAIN_UI_NATIVE_VIEWPORT_IDLE_MS"):
            Some(value) =>
                settings.viewport_render_interval_idle_ms = value.max(1)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match env_u64("KAIN_UI_NATIVE_VIEWPORT_INTERACTIVE_MS"):
            Some(value) =>
                settings.viewport_render_interval_interactive_ms = value.max(1)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match env_u64("KAIN_UI_NATIVE_VIEWPORT_STARTUP_MS"):
            Some(value) =>
                settings.viewport_startup_delay_ms = value
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match env_u64("KAIN_UI_NATIVE_VIEWPORT_MAX_AXIS"):
            Some(value) =>
                settings.viewport_max_axis_px = value.max(128)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        settings

    fn eframe_renderer(_self: KainUiNativeRuntimeSettings) -> eframe::Renderer:
        match _self.renderer:
            NativeRendererPreference::Glow => eframe__Renderer__Glow
            NativeRendererPreference::Wgpu => eframe__Renderer__Wgpu

    fn renderer_label(_self: KainUiNativeRuntimeSettings) -> String:
        match _self.renderer:
            NativeRendererPreference::Glow => "software"
            NativeRendererPreference::Wgpu => "wgpu-readback"

    fn effective_renderer_label(_self: KainUiNativeRuntimeSettings) -> String:
        match _self.renderer:
            NativeRendererPreference::Glow => "software"
            NativeRendererPreference::Wgpu => "wgpu-readback-pending-app-init"


fn parse_renderer_preference(value: String) -> NativeRendererPreference:
    match value.to_ascii_lowercase().as_str():
        "wgpu" => NativeRendererPreference__Wgpu
        "wgpu-readback" => NativeRendererPreference__Wgpu
        "wgpu-surface" => NativeRendererPreference__Wgpu
        _ => NativeRendererPreference__Glow

fn host_backend_label(backend: kain_ui::UiHostBackendKind) -> String:
    match backend:
        kain_ui__UiHostBackendKind::Auto => "auto"
        kain_ui__UiHostBackendKind::Native => "native"
        kain_ui__UiHostBackendKind::LegacyEgui => "legacy-egui"
        kain_ui__UiHostBackendKind::Imgui => "imgui"
        kain_ui__UiHostBackendKind::RmlUi => "rmlui"
        kain_ui__UiHostBackendKind::Slint => "slint"
        kain_ui__UiHostBackendKind::Qt => "qt"
        kain_ui__UiHostBackendKind::Cef => "cef"

fn env_var_trimmed(key: String) -> Option<String>:
    std__env__var_(key).ok().map(fn(value): value.trim().to_string()).filter(fn(value): (!value.is_empty()))

fn env_bool(key: String) -> Option<Bool>:
    env_var_trimmed(key).and_then(fn(value): none)

fn env_u64(key: String) -> Option<u64>:
    env_var_trimmed(key).and_then(fn(value): value.parse().ok())

fn load_json_string_from_env(key: String) -> Option<(String, String)>:
    let path = env_var_trimmed(key)?
    let json = std__fs__read_to_string(&path).ok()?
    Option::Some((json, path))

fn load_runtime_bundle_from_env() -> Option<(kain_ui::UiRuntimeBundle, String)>:
    let (json, path) = load_json_string_from_env(KAIN_UI_NATIVE_RUNTIME_BUNDLE_ENV)?
    kain_ui__ui_runtime_bundle_from_json(&json).ok().map(fn(bundle): (bundle, path))

fn load_realtime_bundle_from_env() -> Option<(kain_core::RealtimeAppBundle, String)>:
    let (json, path) = load_json_string_from_env(KAIN_UI_NATIVE_REALTIME_BUNDLE_ENV)?
    kain_core__realtime_app_bundle_from_json(&json).ok().map(fn(bundle): (bundle, path))

fn load_shader_bundle_from_env() -> Option<(kain_core::ShaderArtifactBundle, String)>:
    let (json, path) = load_json_string_from_env(KAIN_UI_NATIVE_SHADER_BUNDLE_ENV)?
    kain_core__shader_artifact_bundle_from_json(&json).ok().map(fn(bundle): (bundle, path))

fn load_runtime_snapshot_from_env() -> Option<(NativeAppRuntimeSnapshot, String)>:
    let (json, path) = load_json_string_from_env(KAIN_UI_NATIVE_APP_SNAPSHOT_ENV)?
    serde_json__from_str(&json).ok().map(fn(snapshot): (snapshot, path))

fn bridge_timestamp_string() -> String:
    SystemTime__now().duration_since(std__time__UNIX_EPOCH).unwrap_or_default().as_millis().to_string()

fn emit_runtime_command_to_bridge(bridge_path: String, command: &NativeAppRuntimeCommand) -> Result<(), String>:
    let payload = serde_json::json!()
    let line_ = serde_json__to_string(&payload).map_err(fn(err): err.to_string())?
    let mut file = OpenOptions__new_().create(true).append(true).open(bridge_path).map_err(fn(err): err.to_string())?
    __kain_writeln_fmt!(file, line_).map_err(fn(err): err.to_string())

fn file_modified_at(path: String) -> Option<std::time::SystemTime>:
    (std__fs__metadata(path).ok()?).modified().ok()

impl WatchedRuntimeFile:
    fn new_(path: String) -> WatchedRuntimeFile:
        WatchedRuntimeFile { last_modified: file_modified_at(&path), path: path }

    fn take_if_changed(_self: &mut WatchedRuntimeFile) -> Option<String>:
        let modified = file_modified_at(&(*_self).path)?
        if (*_self).last_modified.is_some_and(fn(previous): (previous >= modified)):
            return none
        (*_self).last_modified = Option::Some(modified)
        ()
        Option::Some((*_self).path.clone())


impl RuntimeArtifactWatch:
    fn with_runtime_bundle_path(_self: RuntimeArtifactWatch, path: Option<String>) -> RuntimeArtifactWatch:
        _self.runtime_bundle = path.map(WatchedRuntimeFile__new_)
        ()
        _self

    fn with_realtime_bundle_path(_self: RuntimeArtifactWatch, path: Option<String>) -> RuntimeArtifactWatch:
        _self.realtime_bundle = path.map(WatchedRuntimeFile__new_)
        ()
        _self

    fn with_shader_bundle_path(_self: RuntimeArtifactWatch, path: Option<String>) -> RuntimeArtifactWatch:
        _self.shader_bundle = path.map(WatchedRuntimeFile__new_)
        ()
        _self

    fn with_runtime_snapshot_path(_self: RuntimeArtifactWatch, path: Option<String>) -> RuntimeArtifactWatch:
        _self.runtime_snapshot = path.map(WatchedRuntimeFile__new_)
        ()
        _self


impl RealtimeBundleCatalog:
    fn from_bundle(bundle: &kain_core::RealtimeAppBundle, bundle_path: Option<String>) -> RealtimeBundleCatalog:
        RealtimeBundleCatalog { scenes_by_viewport: (*bundle).render.scenes.iter().cloned().map(fn(scene): (scene.viewport_node.clone(), scene)).collect(), materials_by_id: (*bundle).render.materials.iter().cloned().map(fn(material): (material.id.clone(), material)).collect(), shader_refs_by_key: (*bundle).shader_bundle_refs.iter().cloned().map(fn(shader_ref): (shader_ref.key.clone(), shader_ref)).collect(), shader_canvases_by_surface: (*bundle).shader_canvases.iter().cloned().map(fn(binding): (binding.surface_id.clone(), binding)).collect(), assets_by_key: (*bundle).assets.iter().cloned().map(fn(asset): (asset.key.clone(), asset)).collect(), asset_base_dir: bundle_path.map(PathBuf__from).and_then(fn(path): path.parent().map(Path__to_path_buf)) }


fn color_bg_top() -> eframe::egui::Color32:
    Color32__from_rgb(8, 12, 18)

fn color_bg_bottom() -> eframe::egui::Color32:
    Color32__from_rgb(16, 22, 31)

fn color_surface() -> eframe::egui::Color32:
    Color32__from_rgb(18, 24, 32)

fn color_surface_alt() -> eframe::egui::Color32:
    Color32__from_rgb(24, 31, 41)

fn color_surface_raised() -> eframe::egui::Color32:
    Color32__from_rgb(31, 39, 51)

fn color_surface_overlay() -> eframe::egui::Color32:
    Color32__from_rgba_unmultiplied(7, 11, 17, 208)

fn color_outline_soft() -> eframe::egui::Color32:
    Color32__from_rgb(68, 89, 110)

fn color_outline_bright() -> eframe::egui::Color32:
    Color32__from_rgb(75, 198, 255)

fn color_accent() -> eframe::egui::Color32:
    Color32__from_rgb(81, 198, 255)

fn color_accent_soft() -> eframe::egui::Color32:
    Color32__from_rgb(143, 224, 255)

fn color_highlight() -> eframe::egui::Color32:
    Color32__from_rgb(255, 209, 102)

fn color_success() -> eframe::egui::Color32:
    Color32__from_rgb(135, 223, 153)

fn color_muted_text() -> eframe::egui::Color32:
    Color32__from_rgb(160, 171, 186)

enum NativeSurfaceMode:
    Flat
    Layered
    Glass
    Canvas
    Accent
    Ghost

impl NativeSurfaceMode:
    fn from_str(value: String) -> Option<NativeSurfaceMode>:
        match value.trim().to_ascii_lowercase().as_str():
            "flat" => Option::Some(NativeSurfaceMode__Flat)
            "layered" => Option::Some(NativeSurfaceMode__Layered)
            "elevated" => Option::Some(NativeSurfaceMode__Layered)
            "glass" => Option::Some(NativeSurfaceMode__Glass)
            "frosted" => Option::Some(NativeSurfaceMode__Glass)
            "canvas" => Option::Some(NativeSurfaceMode__Canvas)
            "viewport" => Option::Some(NativeSurfaceMode__Canvas)
            "accent" => Option::Some(NativeSurfaceMode__Accent)
            "hero" => Option::Some(NativeSurfaceMode__Accent)
            "ghost" => Option::Some(NativeSurfaceMode__Ghost)
            "outline" => Option::Some(NativeSurfaceMode__Ghost)
            "minimal" => Option::Some(NativeSurfaceMode__Ghost)
            _ => none


enum NativeDensity:
    Compact
    Cozy
    Spacious

impl NativeDensity:
    fn from_str(value: String) -> Option<NativeDensity>:
        match value.trim().to_ascii_lowercase().as_str():
            "compact" => Option::Some(NativeDensity__Compact)
            "dense" => Option::Some(NativeDensity__Compact)
            "tight" => Option::Some(NativeDensity__Compact)
            "spacious" => Option::Some(NativeDensity__Spacious)
            "airy" => Option::Some(NativeDensity__Spacious)
            "loose" => Option::Some(NativeDensity__Spacious)
            "cozy" => Option::Some(NativeDensity__Cozy)
            "comfortable" => Option::Some(NativeDensity__Cozy)
            "default" => Option::Some(NativeDensity__Cozy)
            _ => none


@derive(Clone, Copy, Debug)
struct NativeThemePalette:
    bg_top: eframe::egui::Color32
    bg_bottom: eframe::egui::Color32
    surface_base: eframe::egui::Color32
    surface_alt: eframe::egui::Color32
    surface_raised: eframe::egui::Color32
    surface_overlay: eframe::egui::Color32
    outline_soft: eframe::egui::Color32
    outline_bright: eframe::egui::Color32
    accent: eframe::egui::Color32
    accent_soft: eframe::egui::Color32
    highlight: eframe::egui::Color32
    success: eframe::egui::Color32
    text: eframe::egui::Color32
    text_muted: eframe::egui::Color32

impl Default for NativeThemePalette:
    fn default_() -> NativeThemePalette:
        NativeThemePalette { bg_top: color_bg_top(), bg_bottom: color_bg_bottom(), surface_base: color_surface(), surface_alt: color_surface_alt(), surface_raised: color_surface_raised(), surface_overlay: color_surface_overlay(), outline_soft: color_outline_soft(), outline_bright: color_outline_bright(), accent: color_accent(), accent_soft: color_accent_soft(), highlight: color_highlight(), success: color_success(), text: Color32__from_rgb(239, 243, 248), text_muted: color_muted_text() }


@derive(Clone, Copy, Debug)
struct NativeThemeMetrics:
    frame_padding: f32
    tight_padding: f32
    section_gap: f32
    content_gap: f32
    radius_small: f32
    radius_medium: f32
    radius_large: f32

impl NativeThemeMetrics:
    fn from_density(density: NativeDensity, spacing_scale: f32, radius_scale: f32) -> NativeThemeMetrics:
        let spacing_scale = spacing_scale.clamp(0.6, 1.8)
        let radius_scale = radius_scale.clamp(0.5, 1.8)
        let (frame_padding, tight_padding, section_gap, content_gap) = match density:
            NativeDensity::Compact => (10, 8, 6, 8)
            NativeDensity::Cozy => (14, 10, 8, 12)
            NativeDensity::Spacious => (18, 14, 10, 16)
        let (radius_small, radius_medium, radius_large) = match density:
            NativeDensity::Compact => (7, 11, 15)
            NativeDensity::Cozy => (9, 14, 18)
            NativeDensity::Spacious => (12, 18, 24)
        NativeThemeMetrics { frame_padding: (frame_padding * spacing_scale), tight_padding: (tight_padding * spacing_scale), section_gap: (section_gap * spacing_scale), content_gap: (content_gap * spacing_scale), radius_small: (radius_small * radius_scale), radius_medium: (radius_medium * radius_scale), radius_large: (radius_large * radius_scale) }


@derive(Clone, Copy, Debug)
struct NativeTypography:
    heading: f32
    section: f32
    body: f32
    small: f32
    code: f32

impl NativeTypography:
    fn from_density(density: NativeDensity, type_scale: f32) -> NativeTypography:
        let type_scale = type_scale.clamp(0.75, 1.7)
        let (heading, section, body, small, code) = match density:
            NativeDensity::Compact => (20, 16, 13.5, 11, 10.5)
            NativeDensity::Cozy => (22, 17.5, 14.5, 11.5, 11)
            NativeDensity::Spacious => (25, 19.5, 15.5, 12.5, 11.5)
        NativeTypography { heading: (heading * type_scale), section: (section * type_scale), body: (body * type_scale), small: (small * type_scale), code: (code * type_scale) }


@derive(Clone, Debug)
struct NativeAppTheme:
    name: String
    density: NativeDensity
    palette: NativeThemePalette
    metrics: NativeThemeMetrics
    typography: NativeTypography
    chrome_mode: NativeSurfaceMode
    panel_mode: NativeSurfaceMode
    inspector_mode: NativeSurfaceMode
    tree_mode: NativeSurfaceMode
    graph_mode: NativeSurfaceMode
    timeline_mode: NativeSurfaceMode
    viewport_mode: NativeSurfaceMode
    element_mode: NativeSurfaceMode
    global_values: Map<String, kain_ui::UiValue>

impl Default for NativeAppTheme:
    fn default_() -> NativeAppTheme:
        let density = NativeDensity__Cozy
        NativeAppTheme { name: ("default").to_string(), density: density, palette: NativeThemePalette__default_(), metrics: NativeThemeMetrics__from_density(density, 1, 1), typography: NativeTypography__from_density(density, 1), chrome_mode: NativeSurfaceMode__Glass, panel_mode: NativeSurfaceMode__Layered, inspector_mode: NativeSurfaceMode__Glass, tree_mode: NativeSurfaceMode__Ghost, graph_mode: NativeSurfaceMode__Canvas, timeline_mode: NativeSurfaceMode__Accent, viewport_mode: NativeSurfaceMode__Canvas, element_mode: NativeSurfaceMode__Ghost, global_values: BTreeMap__new_() }


@derive(Clone, Copy, Debug)
struct NativeWidgetTheme:
    mode: NativeSurfaceMode
    fill: eframe::egui::Color32
    stroke: eframe::egui::Color32
    canvas_fill: eframe::egui::Color32
    overlay_fill: eframe::egui::Color32
    header_fill: eframe::egui::Color32
    header_stroke: eframe::egui::Color32
    badge_fill: eframe::egui::Color32
    accent: eframe::egui::Color32
    title_color: eframe::egui::Color32
    body_color: eframe::egui::Color32
    muted_color: eframe::egui::Color32
    tag_color: eframe::egui::Color32
    radius: f32
    padding: f32
    gap: f32
    title_size: f32
    body_size: f32
    tag_size: f32

enum NativeTextRole:
    Body
    Hero
    Title
    Eyebrow
    Caption
    Muted
    Code
    Metric

impl NativeWidgetTheme:
    fn from_kind(kind: &kain_ui::UiWidgetKind, app_theme: &NativeAppTheme) -> NativeWidgetTheme:
        let mode = match kind:
            kain_ui__UiWidgetKind::Panel => (*app_theme).panel_mode
            kain_ui__UiWidgetKind::Inspector => (*app_theme).inspector_mode
            kain_ui__UiWidgetKind::Tree => (*app_theme).tree_mode
            kain_ui__UiWidgetKind::Graph => (*app_theme).graph_mode
            kain_ui__UiWidgetKind::Timeline => (*app_theme).timeline_mode
            kain_ui__UiWidgetKind::Viewport2D => (*app_theme).viewport_mode
            kain_ui__UiWidgetKind::Viewport3D => (*app_theme).viewport_mode
            kain_ui__UiWidgetKind::Element(_) => (*app_theme).element_mode
            _ => NativeSurfaceMode__Flat
        let (fill, stroke, canvas_fill, overlay_fill) = surface_colors_for_mode(mode, &(*app_theme).palette)
        let (radius, padding) = match kind:
            kain_ui__UiWidgetKind::Panel => ((*app_theme).metrics.radius_large, (*app_theme).metrics.frame_padding)
            kain_ui__UiWidgetKind::Graph => ((*app_theme).metrics.radius_large, (*app_theme).metrics.tight_padding)
            kain_ui__UiWidgetKind::Viewport2D => ((*app_theme).metrics.radius_large, (*app_theme).metrics.tight_padding)
            kain_ui__UiWidgetKind::Viewport3D => ((*app_theme).metrics.radius_large, (*app_theme).metrics.tight_padding)
            kain_ui__UiWidgetKind::Timeline => ((*app_theme).metrics.radius_medium, (*app_theme).metrics.tight_padding)
            kain_ui__UiWidgetKind::Inspector => ((*app_theme).metrics.radius_medium, (*app_theme).metrics.tight_padding)
            kain_ui__UiWidgetKind::Tree => ((*app_theme).metrics.radius_medium, (*app_theme).metrics.tight_padding)
            _ => ((*app_theme).metrics.radius_small, (*app_theme).metrics.tight_padding)
        let title_color = match kind:
            kain_ui__UiWidgetKind::Timeline => (*app_theme).palette.highlight
            kain_ui__UiWidgetKind::Graph => (*app_theme).palette.accent_soft
            kain_ui__UiWidgetKind::Tree => (*app_theme).palette.accent_soft
            _ => (*app_theme).palette.text
        NativeWidgetTheme { mode: mode, fill: fill, stroke: stroke, canvas_fill: canvas_fill, overlay_fill: overlay_fill, header_fill: alpha_tint(overlay_fill, 0.94), header_stroke: alpha_tint(stroke, 0.86), badge_fill: alpha_tint(fill, 0.76), accent: (*app_theme).palette.accent, title_color: title_color, body_color: (*app_theme).palette.text, muted_color: (*app_theme).palette.text_muted, tag_color: (*app_theme).palette.accent_soft, radius: radius, padding: padding, gap: (*app_theme).metrics.content_gap, title_size: (*app_theme).typography.section, body_size: (*app_theme).typography.body, tag_size: (*app_theme).typography.small }

    fn chrome(app_theme: &NativeAppTheme) -> NativeWidgetTheme:
        let (fill, stroke, canvas_fill, overlay_fill) = surface_colors_for_mode((*app_theme).chrome_mode, &(*app_theme).palette)
        NativeWidgetTheme { mode: (*app_theme).chrome_mode, fill: fill, stroke: stroke, canvas_fill: canvas_fill, overlay_fill: overlay_fill, header_fill: alpha_tint(overlay_fill, 0.98), header_stroke: alpha_tint(stroke, 0.9), badge_fill: alpha_tint(fill, 0.72), accent: (*app_theme).palette.accent, title_color: (*app_theme).palette.text, body_color: (*app_theme).palette.text, muted_color: (*app_theme).palette.text_muted, tag_color: (*app_theme).palette.accent_soft, radius: (*app_theme).metrics.radius_medium, padding: (*app_theme).metrics.tight_padding, gap: (*app_theme).metrics.section_gap, title_size: (*app_theme).typography.section, body_size: (*app_theme).typography.body, tag_size: (*app_theme).typography.small }


fn alpha_tint(color: eframe::egui::Color32, alpha_factor: f32) -> eframe::egui::Color32:
    let alpha = (((color.a() as f32) * alpha_factor.clamp(0, 1))).round() as u8
    Color32__from_rgba_unmultiplied(color.r(), color.g(), color.b(), alpha)

fn surface_colors_for_mode(mode: NativeSurfaceMode, palette: &NativeThemePalette) -> (eframe::egui::Color32, eframe::egui::Color32, eframe::egui::Color32, eframe::egui::Color32):
    match mode:
        NativeSurfaceMode::Flat => ((*palette).surface_base, (*palette).outline_soft, (*palette).bg_top, (*palette).surface_overlay)
        NativeSurfaceMode::Layered => ((*palette).surface_alt, (*palette).outline_soft, (*palette).bg_top, (*palette).surface_overlay)
        NativeSurfaceMode::Glass => (alpha_tint((*palette).surface_raised, 0.82), alpha_tint((*palette).accent_soft, 0.68), alpha_tint((*palette).bg_top, 0.92), alpha_tint((*palette).surface_overlay, 0.86))
        NativeSurfaceMode::Canvas => ((*palette).surface_base, (*palette).outline_bright, (*palette).bg_top, alpha_tint((*palette).surface_overlay, 0.92))
        NativeSurfaceMode::Accent => (alpha_tint((*palette).accent, 0.18), (*palette).accent_soft, alpha_tint((*palette).bg_top, 0.94), alpha_tint((*palette).surface_overlay, 0.88))
        NativeSurfaceMode::Ghost => (Color32__from_rgba_unmultiplied(0, 0, 0, 0), alpha_tint((*palette).outline_soft, 0.8), alpha_tint((*palette).bg_top, 0.88), alpha_tint((*palette).surface_overlay, 0.72))

fn native_theme_preset(name: String) -> NativeAppTheme:
    let mut theme = NativeAppTheme__default_()
    theme.name = name.to_string()
    ()
    match name.trim().to_ascii_lowercase().as_str():
        "forge" =>
            theme.density = NativeDensity__Compact
            ()
            theme.palette = NativeThemePalette { bg_top: Color32__from_rgb(18, 14, 12), bg_bottom: Color32__from_rgb(31, 24, 20), surface_base: Color32__from_rgb(39, 30, 25), surface_alt: Color32__from_rgb(53, 39, 31), surface_raised: Color32__from_rgb(68, 48, 35), surface_overlay: Color32__from_rgba_unmultiplied(13, 9, 7, 214), outline_soft: Color32__from_rgb(120, 89, 70), outline_bright: Color32__from_rgb(231, 154, 83), accent: Color32__from_rgb(233, 119, 51), accent_soft: Color32__from_rgb(255, 184, 123), highlight: Color32__from_rgb(255, 216, 137), success: Color32__from_rgb(162, 223, 141), text: Color32__from_rgb(247, 240, 233), text_muted: Color32__from_rgb(193, 175, 161) }
            ()
            theme.chrome_mode = NativeSurfaceMode__Accent
            ()
            theme.panel_mode = NativeSurfaceMode__Layered
            ()
            theme.inspector_mode = NativeSurfaceMode__Flat
            ()
            theme.tree_mode = NativeSurfaceMode__Ghost
            ()
            theme.graph_mode = NativeSurfaceMode__Canvas
            ()
            theme.timeline_mode = NativeSurfaceMode__Accent
            ()
            theme.viewport_mode = NativeSurfaceMode__Glass
            ()
            ()
            ()
            ()
        "signal" =>
            theme.density = NativeDensity__Cozy
            ()
            theme.palette = NativeThemePalette { bg_top: Color32__from_rgb(10, 12, 24), bg_bottom: Color32__from_rgb(14, 18, 37), surface_base: Color32__from_rgb(18, 24, 43), surface_alt: Color32__from_rgb(24, 32, 56), surface_raised: Color32__from_rgb(33, 43, 72), surface_overlay: Color32__from_rgba_unmultiplied(8, 10, 24, 214), outline_soft: Color32__from_rgb(87, 99, 142), outline_bright: Color32__from_rgb(255, 118, 181), accent: Color32__from_rgb(255, 91, 168), accent_soft: Color32__from_rgb(255, 172, 214), highlight: Color32__from_rgb(255, 214, 120), success: Color32__from_rgb(130, 233, 201), text: Color32__from_rgb(244, 245, 253), text_muted: Color32__from_rgb(176, 184, 211) }
            ()
            theme.chrome_mode = NativeSurfaceMode__Glass
            ()
            theme.panel_mode = NativeSurfaceMode__Glass
            ()
            theme.inspector_mode = NativeSurfaceMode__Layered
            ()
            theme.tree_mode = NativeSurfaceMode__Ghost
            ()
            theme.graph_mode = NativeSurfaceMode__Accent
            ()
            theme.timeline_mode = NativeSurfaceMode__Canvas
            ()
            theme.viewport_mode = NativeSurfaceMode__Canvas
            ()
            ()
            ()
            ()
