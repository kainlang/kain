fn sync_viewport_manipulation(scene: &kain_3d::SceneDescription, response: &eframe::egui::Response, inner_rect: eframe::egui::Rect, resolution: kain_3d::RenderResolution, input: &ViewportInputSnapshot, scene_time_seconds: f32, camera: &kain_3d::CameraPose, gizmo_binding: &kain_core::RealtimeViewportGizmoBinding, surface: &mut ViewportSurfaceState):
