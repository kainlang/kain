fn resolve_app_theme(output: &kain_ui::UiBuildOutput) -> NativeAppTheme:
    let root_resolved = (*output).tree.root.and_then(fn(root_id): (*output).tree.node(root_id)).map(fn(node): kain_ui__ui_resolve_theme_for_node(node, &(*output).systems.theme_registry)).unwrap_or_default()
    let theme_name = theme_lookup_string(none, &root_resolved.values, &["theme.name", "app.theme", "theme.active"]).or_else(fn(): (*output).systems.theme_registry.active_theme.clone()).unwrap_or_else(fn(): ("default").to_string())
    let mut theme = native_theme_preset(&theme_name)
    theme.global_values = root_resolved.values.clone()
    ()
    match theme_lookup_string(none, &theme.global_values, &["theme.density", "layout.density", "density"]).and_then(fn(value): NativeDensity__from_str(&value)):
        Some(density) =>
            theme.density = density
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let spacing_scale = theme_lookup_f32(none, &theme.global_values, &["theme.spacing.scale", "spacing.scale"]).unwrap_or(1)
    let radius_scale = theme_lookup_f32(none, &theme.global_values, &["theme.radius.scale", "radius.scale", "corner.scale"]).unwrap_or(1)
    let type_scale = theme_lookup_f32(none, &theme.global_values, &["theme.typography.scale", "typography.scale", "font.scale"]).unwrap_or(1)
    theme.metrics = NativeThemeMetrics__from_density(theme.density, spacing_scale, radius_scale)
    ()
    theme.typography = NativeTypography__from_density(theme.density, type_scale)
    ()
    theme.palette.bg_top = theme_lookup_color(none, &theme.global_values, &["theme.background.top", "theme.bg.top", "theme.surface.background", "surface.background"], theme.palette.bg_top)
    ()
    theme.palette.bg_bottom = theme_lookup_color(none, &theme.global_values, &["theme.background.bottom", "theme.bg.bottom"], theme.palette.bg_bottom)
    ()
    theme.palette.surface_base = theme_lookup_color(none, &theme.global_values, &["theme.surface.base", "theme.surface.default", "surface.fill"], theme.palette.surface_base)
    ()
    theme.palette.surface_alt = theme_lookup_color(none, &theme.global_values, &["theme.surface.alt", "theme.surface.secondary"], theme.palette.surface_alt)
    ()
    theme.palette.surface_raised = theme_lookup_color(none, &theme.global_values, &["theme.surface.raised", "theme.surface.elevated"], theme.palette.surface_raised)
    ()
    theme.palette.surface_overlay = theme_lookup_color(none, &theme.global_values, &["theme.surface.overlay", "surface.overlay"], theme.palette.surface_overlay)
    ()
    theme.palette.outline_soft = theme_lookup_color(none, &theme.global_values, &["theme.outline.soft", "outline.soft"], theme.palette.outline_soft)
    ()
    theme.palette.outline_bright = theme_lookup_color(none, &theme.global_values, &["theme.outline.bright", "outline.bright"], theme.palette.outline_bright)
    ()
    theme.palette.accent = theme_lookup_color(none, &theme.global_values, &["theme.accent.primary", "theme.accent", "accent.color"], theme.palette.accent)
    ()
    theme.palette.accent_soft = theme_lookup_color(none, &theme.global_values, &["theme.accent.soft", "accent.soft"], theme.palette.accent_soft)
    ()
    theme.palette.highlight = theme_lookup_color(none, &theme.global_values, &["theme.highlight", "highlight.color"], theme.palette.highlight)
    ()
    theme.palette.success = theme_lookup_color(none, &theme.global_values, &["theme.success", "success.color"], theme.palette.success)
    ()
    theme.palette.text = theme_lookup_color(none, &theme.global_values, &["theme.text.default", "text.default", "text.color"], theme.palette.text)
    ()
    theme.palette.text_muted = theme_lookup_color(none, &theme.global_values, &["theme.text.muted", "text.muted"], theme.palette.text_muted)
    ()
    match theme_lookup_string(none, &theme.global_values, &["theme.chrome.mode", "chrome.surface.mode"]).and_then(fn(value): NativeSurfaceMode__from_str(&value)):
        Some(mode) =>
            theme.chrome_mode = mode
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_string(none, &theme.global_values, &["widget.panel.surface.mode", "panel.surface.mode"]).and_then(fn(value): NativeSurfaceMode__from_str(&value)):
        Some(mode) =>
            theme.panel_mode = mode
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_string(none, &theme.global_values, &["widget.inspector.surface.mode", "inspector.surface.mode"]).and_then(fn(value): NativeSurfaceMode__from_str(&value)):
        Some(mode) =>
            theme.inspector_mode = mode
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_string(none, &theme.global_values, &["widget.tree.surface.mode", "tree.surface.mode"]).and_then(fn(value): NativeSurfaceMode__from_str(&value)):
        Some(mode) =>
            theme.tree_mode = mode
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_string(none, &theme.global_values, &["widget.graph.surface.mode", "graph.surface.mode"]).and_then(fn(value): NativeSurfaceMode__from_str(&value)):
        Some(mode) =>
            theme.graph_mode = mode
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_string(none, &theme.global_values, &["widget.timeline.surface.mode", "timeline.surface.mode"]).and_then(fn(value): NativeSurfaceMode__from_str(&value)):
        Some(mode) =>
            theme.timeline_mode = mode
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_string(none, &theme.global_values, &["widget.viewport3d.surface.mode", "widget.viewport2d.surface.mode", "viewport.surface.mode"]).and_then(fn(value): NativeSurfaceMode__from_str(&value)):
        Some(mode) =>
            theme.viewport_mode = mode
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    theme

fn show_runtime_topbar(app_theme: &NativeAppTheme, default_visible: Bool) -> Bool:
    theme_lookup_bool(none, &(*app_theme).global_values, &["theme.chrome.topbar.visible", "chrome.topbar.visible", "host.topbar.visible"]).unwrap_or(default_visible)

fn show_runtime_inspector(app_theme: &NativeAppTheme, default_visible: Bool) -> Bool:
    theme_lookup_bool(none, &(*app_theme).global_values, &["theme.chrome.inspector.visible", "chrome.inspector.visible", "host.inspector.visible"]).unwrap_or(default_visible)

fn resolve_widget_theme(node: &kain_ui::UiNode, theme_registry: &kain_ui::UiThemeRegistry, app_theme: &NativeAppTheme) -> NativeWidgetTheme:
    let local = kain_ui__ui_resolve_theme_for_node(node, theme_registry)
    let widget_key = widget_kind_key(&(*node).kind)
    let variant = (*node).style.variant
    let mut theme = NativeWidgetTheme__from_kind(&(*node).kind, app_theme)
    match theme_lookup_widget_string(&local, &(*app_theme).global_values, widget_key, variant, "surface.mode").and_then(fn(value): NativeSurfaceMode__from_str(&value)):
        Some(mode) =>
            theme.mode = mode
            ()
            let (fill, stroke, canvas_fill, overlay_fill) = surface_colors_for_mode(mode, &(*app_theme).palette)
            theme.fill = fill
            ()
            theme.stroke = stroke
            ()
            theme.canvas_fill = canvas_fill
            ()
            theme.overlay_fill = overlay_fill
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    theme.fill = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "surface.fill", theme.fill)
    ()
    theme.stroke = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "surface.stroke", theme.stroke)
    ()
    theme.canvas_fill = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "surface.canvas", theme.canvas_fill)
    ()
    theme.overlay_fill = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "surface.overlay", theme.overlay_fill)
    ()
    theme.header_fill = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "surface.header", theme.header_fill)
    ()
    theme.header_stroke = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "surface.header.stroke", theme.header_stroke)
    ()
    theme.badge_fill = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "surface.badge", theme.badge_fill)
    ()
    theme.accent = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "accent.color", theme.accent)
    ()
    theme.title_color = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "title.color", theme.title_color)
    ()
    theme.body_color = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "text.color", theme.body_color)
    ()
    theme.muted_color = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "text.muted", theme.muted_color)
    ()
    theme.tag_color = theme_lookup_widget_color(&local, &(*app_theme).global_values, widget_key, variant, "tag.color", theme.tag_color)
    ()
    match theme_lookup_widget_f32(&local, &(*app_theme).global_values, widget_key, variant, "surface.radius"):
        Some(radius) =>
            theme.radius = radius.max(0)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_widget_f32(&local, &(*app_theme).global_values, widget_key, variant, "surface.padding"):
        Some(padding) =>
            theme.padding = padding.max(0)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_widget_f32(&local, &(*app_theme).global_values, widget_key, variant, "layout.gap"):
        Some(gap) =>
            theme.gap = gap.max(0)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_widget_f32(&local, &(*app_theme).global_values, widget_key, variant, "title.size"):
        Some(title_size) =>
            theme.title_size = title_size.max(10)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_widget_f32(&local, &(*app_theme).global_values, widget_key, variant, "body.size"):
        Some(body_size) =>
            theme.body_size = body_size.max(8)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_widget_f32(&local, &(*app_theme).global_values, widget_key, variant, "tag.size"):
        Some(tag_size) =>
            theme.tag_size = tag_size.max(8)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_widget_f32(&local, &(*app_theme).global_values, widget_key, variant, "surface.alpha"):
        Some(alpha) =>
            theme.fill = alpha_tint(theme.fill, alpha)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match theme_lookup_widget_string(&local, &(*app_theme).global_values, widget_key, variant, "density").and_then(fn(value): NativeDensity__from_str(&value)):
        Some(density) =>
            let metrics = NativeThemeMetrics__from_density(density, 1, 1)
            theme.padding = metrics.tight_padding
            ()
            theme.gap = metrics.content_gap
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    for class_name in &(*node).style.classes:
        match class_name.trim().to_ascii_lowercase().as_str():
            "hero" =>
                theme.mode = NativeSurfaceMode__Accent
                ()
                let (fill, stroke, canvas_fill, overlay_fill) = surface_colors_for_mode(theme.mode, &(*app_theme).palette)
                theme.fill = fill
                ()
                theme.stroke = stroke
                ()
                theme.canvas_fill = canvas_fill
                ()
                theme.overlay_fill = overlay_fill
                ()
                theme.title_size = (theme.title_size * 1.08)
                ()
            "accent" =>
                theme.mode = NativeSurfaceMode__Accent
                ()
                let (fill, stroke, canvas_fill, overlay_fill) = surface_colors_for_mode(theme.mode, &(*app_theme).palette)
                theme.fill = fill
                ()
                theme.stroke = stroke
                ()
                theme.canvas_fill = canvas_fill
                ()
                theme.overlay_fill = overlay_fill
                ()
                theme.title_size = (theme.title_size * 1.08)
                ()
            "glass" =>
                theme.mode = NativeSurfaceMode__Glass
                ()
                let (fill, stroke, canvas_fill, overlay_fill) = surface_colors_for_mode(theme.mode, &(*app_theme).palette)
                theme.fill = fill
                ()
                theme.stroke = stroke
                ()
                theme.canvas_fill = canvas_fill
                ()
                theme.overlay_fill = overlay_fill
                ()
            "frosted" =>
                theme.mode = NativeSurfaceMode__Glass
                ()
                let (fill, stroke, canvas_fill, overlay_fill) = surface_colors_for_mode(theme.mode, &(*app_theme).palette)
                theme.fill = fill
                ()
                theme.stroke = stroke
                ()
                theme.canvas_fill = canvas_fill
                ()
                theme.overlay_fill = overlay_fill
                ()
            "ghost" =>
                theme.mode = NativeSurfaceMode__Ghost
                ()
                let (fill, stroke, canvas_fill, overlay_fill) = surface_colors_for_mode(theme.mode, &(*app_theme).palette)
                theme.fill = fill
                ()
                theme.stroke = stroke
                ()
                theme.canvas_fill = canvas_fill
                ()
                theme.overlay_fill = overlay_fill
                ()
            "minimal" =>
                theme.mode = NativeSurfaceMode__Ghost
                ()
                let (fill, stroke, canvas_fill, overlay_fill) = surface_colors_for_mode(theme.mode, &(*app_theme).palette)
                theme.fill = fill
                ()
                theme.stroke = stroke
                ()
                theme.canvas_fill = canvas_fill
                ()
                theme.overlay_fill = overlay_fill
                ()
            "compact" =>
                theme.padding = (theme.padding * 0.78)
                ()
                theme.gap = (theme.gap * 0.78)
                ()
                theme.title_size = (theme.title_size * 0.95)
                ()
                theme.body_size = (theme.body_size * 0.95)
                ()
            "dense" =>
                theme.padding = (theme.padding * 0.78)
                ()
                theme.gap = (theme.gap * 0.78)
                ()
                theme.title_size = (theme.title_size * 0.95)
                ()
                theme.body_size = (theme.body_size * 0.95)
                ()
            "tight" =>
                theme.padding = (theme.padding * 0.78)
                ()
                theme.gap = (theme.gap * 0.78)
                ()
                theme.title_size = (theme.title_size * 0.95)
                ()
                theme.body_size = (theme.body_size * 0.95)
                ()
            "spacious" =>
                theme.padding = (theme.padding * 1.18)
                ()
                theme.gap = (theme.gap * 1.18)
                ()
                theme.title_size = (theme.title_size * 1.05)
                ()
            "airy" =>
                theme.padding = (theme.padding * 1.18)
                ()
                theme.gap = (theme.gap * 1.18)
                ()
                theme.title_size = (theme.title_size * 1.05)
                ()
            "muted" =>
                theme.title_color = (*app_theme).palette.text_muted
                ()
                theme.body_color = (*app_theme).palette.text_muted
                ()
                theme.fill = alpha_tint(theme.fill, 0.78)
                ()
            "selected" =>
                theme.stroke = (*app_theme).palette.accent_soft
                ()
                theme.fill = alpha_tint(theme.fill, 0.95)
                ()
            _ => ()
    ()
    for state_ in &(*node).style.states:
        match state_:
            kain_ui__UiStyleState::Hovered =>
                theme.stroke = (*app_theme).palette.accent
                ()
            kain_ui__UiStyleState::Active =>
                theme.stroke = (*app_theme).palette.outline_bright
                ()
                theme.title_color = (*app_theme).palette.highlight
                ()
            kain_ui__UiStyleState::Focused =>
                theme.stroke = (*app_theme).palette.outline_bright
                ()
                theme.title_color = (*app_theme).palette.highlight
                ()
            kain_ui__UiStyleState::Selected =>
                theme.stroke = (*app_theme).palette.highlight
                ()
                theme.fill = alpha_tint(theme.fill, 0.98)
                ()
            kain_ui__UiStyleState::Disabled =>
                theme.fill = alpha_tint(theme.fill, 0.55)
                ()
                theme.body_color = alpha_tint(theme.body_color, 0.65)
                ()
                theme.title_color = alpha_tint(theme.title_color, 0.75)
                ()
            kain_ui__UiStyleState::Dragging =>
                theme.stroke = (*app_theme).palette.success
                ()
    ()
    if ((*node).layout.padding > 0):
        theme.padding = (*node).layout.padding
        ()
        ()
        ()
        ()
    if ((*node).layout.gap > 0):
        theme.gap = (*node).layout.gap
        ()
        ()
        ()
        ()
    theme

fn widget_kind_key(kind: &kain_ui::UiWidgetKind) -> String:
    match kind:
        kain_ui__UiWidgetKind::Panel => "panel"
        kain_ui__UiWidgetKind::Inspector => "inspector"
        kain_ui__UiWidgetKind::Graph => "graph"
        kain_ui__UiWidgetKind::Timeline => "timeline"
        kain_ui__UiWidgetKind::Table => "table"
        kain_ui__UiWidgetKind::Tree => "tree"
        kain_ui__UiWidgetKind::Viewport2D => "viewport2d"
        kain_ui__UiWidgetKind::Viewport3D => "viewport3d"
        kain_ui__UiWidgetKind::Overlay => "overlay"
        kain_ui__UiWidgetKind::Slot => "slot"
        kain_ui__UiWidgetKind::Text => "text"
        kain_ui__UiWidgetKind::ComponentRef(_) => "component"
        kain_ui__UiWidgetKind::Element(_) => "element"

fn widget_display_label(kind: &kain_ui::UiWidgetKind) -> String:
    match kind:
        kain_ui__UiWidgetKind::Panel => "Workspace Panel"
        kain_ui__UiWidgetKind::Inspector => "Inspector"
        kain_ui__UiWidgetKind::Graph => "Graph"
        kain_ui__UiWidgetKind::Timeline => "Timeline"
        kain_ui__UiWidgetKind::Table => "Table"
        kain_ui__UiWidgetKind::Tree => "Tree"
        kain_ui__UiWidgetKind::Viewport2D => "Viewport 2D"
        kain_ui__UiWidgetKind::Viewport3D => "Viewport 3D"
        kain_ui__UiWidgetKind::Overlay => "Overlay"
        kain_ui__UiWidgetKind::Slot => "Slot"
        kain_ui__UiWidgetKind::Text => "Text"
        kain_ui__UiWidgetKind::ComponentRef(_) => "Component"
        kain_ui__UiWidgetKind::Element(_) => "Element"

fn candidate_theme_keys(widget_key: String, variant: Option<String>, property: String) -> Array<String>:
    let mut keys = (fn(__kain_ctor_arg0): Vec__new_())(4)
    match variant:
        Some(variant) =>
            keys.push(f"widget.{widget_key}.variant.{variant}.{property}")
            ()
            keys.push(f"variant.{variant}.{property}")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    keys.push(f"widget.{widget_key}.{property}")
    ()
    keys.push(property.to_string())
    ()
    keys

fn theme_lookup_widget_string(local: &kain_ui::UiResolvedTheme, global: &Map<String, kain_ui::UiValue>, widget_key: String, variant: Option<String>, property: String) -> Option<String>:
    let keys = candidate_theme_keys(widget_key, variant, property)
    let refs = keys.iter().map(String__as_str).collect()
    let empty = BTreeMap__new_()
    theme_lookup_string(Option::Some(&(*local).values), &empty, &refs).or_else(fn(): theme_lookup_string(none, global, &refs))

fn theme_lookup_widget_f32(local: &kain_ui::UiResolvedTheme, global: &Map<String, kain_ui::UiValue>, widget_key: String, variant: Option<String>, property: String) -> Option<f32>:
    let keys = candidate_theme_keys(widget_key, variant, property)
    let refs = keys.iter().map(String__as_str).collect()
    let empty = BTreeMap__new_()
    theme_lookup_f32(Option::Some(&(*local).values), &empty, &refs).or_else(fn(): theme_lookup_f32(none, global, &refs))

fn theme_lookup_widget_bool(local: &kain_ui::UiResolvedTheme, global: &Map<String, kain_ui::UiValue>, widget_key: String, variant: Option<String>, property: String) -> Option<Bool>:
    let keys = candidate_theme_keys(widget_key, variant, property)
    let refs = keys.iter().map(String__as_str).collect()
    let empty = BTreeMap__new_()
    theme_lookup_bool(Option::Some(&(*local).values), &empty, &refs).or_else(fn(): theme_lookup_bool(none, global, &refs))

fn theme_lookup_widget_color(local: &kain_ui::UiResolvedTheme, global: &Map<String, kain_ui::UiValue>, widget_key: String, variant: Option<String>, property: String, fallback: eframe::egui::Color32) -> eframe::egui::Color32:
    let keys = candidate_theme_keys(widget_key, variant, property)
    let refs = keys.iter().map(String__as_str).collect()
    let empty = BTreeMap__new_()
    theme_lookup_color_option(Option::Some(&(*local).values), &empty, &refs).or_else(fn(): theme_lookup_color_option(none, global, &refs)).unwrap_or(fallback)

fn theme_lookup_string(local: Option<&Map<String, kain_ui::UiValue>>, global: &Map<String, kain_ui::UiValue>, keys: &[String]) -> Option<String>:
    keys.iter().find_map(fn(key): theme_lookup_value(local, global, key, 0).and_then(fn(value): none))

fn theme_lookup_f32(local: Option<&Map<String, kain_ui::UiValue>>, global: &Map<String, kain_ui::UiValue>, keys: &[String]) -> Option<f32>:
    keys.iter().find_map(fn(key): theme_lookup_value(local, global, key, 0).and_then(ui_value_as_f32))

fn theme_lookup_bool(local: Option<&Map<String, kain_ui::UiValue>>, global: &Map<String, kain_ui::UiValue>, keys: &[String]) -> Option<Bool>:
    keys.iter().find_map(fn(key): theme_lookup_value(local, global, key, 0).and_then(ui_value_as_bool))

fn theme_lookup_color(local: Option<&Map<String, kain_ui::UiValue>>, global: &Map<String, kain_ui::UiValue>, keys: &[String], fallback: eframe::egui::Color32) -> eframe::egui::Color32:
    theme_lookup_color_option(local, global, keys).unwrap_or(fallback)

fn theme_lookup_color_option(local: Option<&Map<String, kain_ui::UiValue>>, global: &Map<String, kain_ui::UiValue>, keys: &[String]) -> Option<eframe::egui::Color32>:
    keys.iter().find_map(fn(key): theme_lookup_value(local, global, key, 0).and_then(ui_value_as_color))

fn theme_lookup_value<a>(local: Option<&a Map<String, kain_ui::UiValue>>, global: &a Map<String, kain_ui::UiValue>, key: String, depth: usize) -> Option<&a kain_ui::UiValue>:
    if (depth > 8):
        return none
    let value = local.and_then(fn(values): values.get(key)).or_else(fn(): global.get(key))?
    match value:
        kain_ui__UiValue::String(alias) =>
            let alias = alias.trim()
            if ((alias != key) && ((local.is_some_and(fn(values): values.contains_key(alias)) || global.contains_key(alias)))):
                return theme_lookup_value(local, global, alias, (depth + 1)).or_(Option::Some(value))
            ()
        _ =>
            ()
            ()
    Option::Some(value)

fn ui_value_as_f32(value: &kain_ui::UiValue) -> Option<f32>:
    match value:
        kain_ui__UiValue::Float(value) => Option::Some((*value) as f32)
        kain_ui__UiValue::Int(value) => Option::Some((*value) as f32)
        kain_ui__UiValue::String(value) => value.parse().ok()
        _ => none

fn ui_value_as_bool(value: &kain_ui::UiValue) -> Option<Bool>:
    match value:
        kain_ui__UiValue::Bool(value) => Option::Some((*value))
        kain_ui__UiValue::Int(value) => Option::Some(((*value) != 0))
        kain_ui__UiValue::Float(value) => Option::Some((value.abs() > f64__EPSILON))
        kain_ui__UiValue::String(value) =>
            match value.trim().to_ascii_lowercase().as_str():
                "1" => Option::Some(true)
                "true" => Option::Some(true)
                "yes" => Option::Some(true)
                "on" => Option::Some(true)
                "0" => Option::Some(false)
                "false" => Option::Some(false)
                "no" => Option::Some(false)
                "off" => Option::Some(false)
                _ => none
        _ => none

fn ui_value_as_i64(value: &kain_ui::UiValue) -> Option<i64>:
    match value:
        kain_ui__UiValue::Int(value) => Option::Some((*value))
        kain_ui__UiValue::Float(value) => Option::Some((*value) as i64)
        kain_ui__UiValue::String(value) => value.parse().ok()
        _ => none

fn ui_value_as_color(value: &kain_ui::UiValue) -> Option<eframe::egui::Color32>:
    match value:
        kain_ui__UiValue::String(value) => parse_theme_color(value)
        _ => none

fn parse_theme_color(value: String) -> Option<eframe::egui::Color32>:
    let trimmed = value.trim()
    match trimmed.strip_prefix("#"):
        Some(hex) => return none
        _ =>
            ()
            ()
    match trimmed.to_ascii_lowercase().as_str():
        "white" => Option::Some(eframe__egui__Color32__WHITE)
        "black" => Option::Some(eframe__egui__Color32__BLACK)
        "transparent" => Option::Some(Color32__from_rgba_unmultiplied(0, 0, 0, 0))
        _ => none

fn themed_frame(theme: &NativeWidgetTheme) -> eframe::egui::Frame:
    let stroke_width = match (*theme).mode:
        NativeSurfaceMode::Ghost => 0
        NativeSurfaceMode::Flat => 0.7
        NativeSurfaceMode::Layered => 0.8
        NativeSurfaceMode::Glass => 0.9
        NativeSurfaceMode::Canvas => 1
        NativeSurfaceMode::Accent => 1
    Frame__new_().fill((*theme).fill).stroke(Stroke__new_(stroke_width, (*theme).stroke)).corner_radius((*theme).radius).inner_margin((*theme).padding)

fn dock_placement_label(placement: kain_ui::UiDockPlacement) -> String:
    match placement:
        kain_ui__UiDockPlacement::Left => "dock-left"
        kain_ui__UiDockPlacement::Right => "dock-right"
        kain_ui__UiDockPlacement::Top => "dock-top"
        kain_ui__UiDockPlacement::Bottom => "dock-bottom"
        kain_ui__UiDockPlacement::Center => "dock-center"
        kain_ui__UiDockPlacement::Tab => "dock-tab"

fn widget_chrome_tags(node: &kain_ui::UiNode) -> Array<String>:
    let mut tags = Vec__new_()
    tags.push(widget_kind_key(&(*node).kind).to_string())
    ()
    match (*node).style.variant:
        Some(variant) =>
            tags.push(f"#{variant}")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    for class_name in (*node).style.classes.iter().take(2):
        tags.push(f".{class_name}")
        ()
    ()
    match (*node).layout.dock:
        Some(dock) =>
            tags.push(dock_placement_label(dock).to_string())
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*node).layout.tab_group_id:
        Some(group_id) =>
            tags.push(f"tab:{group_id}")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*node).layout.persistent_layout_id:
        Some(layout_id) =>
            tags.push(f"id:{layout_id}")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    tags

fn render_tag_chip(ui: &mut eframe::egui::Ui, theme: &NativeWidgetTheme, label: String, emphasized: Bool):
    let (fill, stroke, text_color) = if emphasized:
        (alpha_tint((*theme).accent, 0.24), (*theme).accent, (*theme).title_color)
    else:
        (alpha_tint((*theme).badge_fill, 0.92), alpha_tint((*theme).header_stroke, 0.92), (*theme).tag_color)
    Frame__new_().fill(fill).stroke(Stroke__new_(1, stroke)).corner_radius(((*theme).radius * 0.45)).inner_margin(((*theme).padding * 0.22)).show(ui, fn(ui): none)
    ()

fn render_widget_header(ui: &mut eframe::egui::Ui, theme: &NativeWidgetTheme, title: String):
    Frame__new_().fill((*theme).header_fill).stroke(Stroke__new_(1, (*theme).header_stroke)).corner_radius(((*theme).radius * 0.72)).inner_margin(((*theme).padding * 0.48)).show(ui, fn(ui): none)
    ()

fn render_widget_body_frame<R>(ui: &mut eframe::egui::Ui, theme: &NativeWidgetTheme, body: impl FnOnce) -> R:
    Frame__new_().fill(alpha_tint((*theme).canvas_fill, 0.88)).stroke(Stroke__new_(1, alpha_tint((*theme).stroke, 0.84))).corner_radius(((*theme).radius * 0.58)).inner_margin(((*theme).padding * 0.62)).show(ui, body).inner

fn is_product_desktop_theme(app_theme: &NativeAppTheme, snapshot: Option<&NativeAppRuntimeSnapshot>) -> Bool:
    let theme_name = (*app_theme).name.trim().to_ascii_lowercase()
    let known_product_theme = match theme_name.as_str():
        "kade_desktop" => true
        "kade-desktop" => true
        "kain_fabric_universal_studio" => true
        "kain-fabric-universal-studio" => true
        _ => false
    let snapshot_presentation = snapshot.and_then(fn(value): value.dcc_suite_state).map(fn(state_): &state_.presentation)
    let canonical_product_frame = snapshot_presentation.is_some_and(fn(presentation): (((presentation.fixed_workspace_frame || presentation.viewport_centered_layout) || presentation.layout.eq_ignore_ascii_case("dock")) || presentation.dock_regions.iter().any(fn(region): none)))
    let known_product_app = snapshot.is_some_and(fn(value): (value.app_id.eq_ignore_ascii_case("kade.desktop") || value.app_id.eq_ignore_ascii_case("kain.fabric.dcc-suite")))
    ((known_product_theme || canonical_product_frame) || known_product_app)

fn runtime_shell_presentation<a>(snapshot: Option<&a NativeAppRuntimeSnapshot>) -> Option<&a NativeAppRuntimeDccSuitePresentation>:
    (snapshot?).dcc_suite_state.map(fn(state_): &state_.presentation)

fn widget_title_visible(node: &kain_ui::UiNode, theme_registry: &kain_ui::UiThemeRegistry, app_theme: &NativeAppTheme) -> Bool:
    let local = kain_ui__ui_resolve_theme_for_node(node, theme_registry)
    let widget_key = widget_kind_key(&(*node).kind)
    let variant = (*node).style.variant
    theme_lookup_widget_bool(&local, &(*app_theme).global_values, widget_key, variant, "title.visible").unwrap_or(true)

fn apply_runtime_visuals(ctx: &eframe::egui::Context, app_theme: &NativeAppTheme):
    let mut visuals = Visuals__dark()
    visuals.override_text_color = Option::Some((*app_theme).palette.text)
    ()
    visuals.panel_fill = (*app_theme).palette.bg_bottom
    ()
    visuals.window_fill = (*app_theme).palette.bg_bottom
    ()
    visuals.faint_bg_color = (*app_theme).palette.surface_base
    ()
    visuals.extreme_bg_color = (*app_theme).palette.bg_top
    ()
    visuals.widgets.noninteractive.bg_fill = (*app_theme).palette.surface_base
    ()
    visuals.widgets.noninteractive.fg_stroke.color = (*app_theme).palette.text_muted
    ()
    visuals.widgets.noninteractive.bg_stroke = Stroke__new_(1, (*app_theme).palette.outline_soft)
    ()
    visuals.widgets.inactive.bg_fill = (*app_theme).palette.surface_alt
    ()
    visuals.widgets.inactive.fg_stroke.color = (*app_theme).palette.accent_soft
    ()
    visuals.widgets.inactive.bg_stroke = Stroke__new_(1, (*app_theme).palette.outline_soft)
    ()
    visuals.widgets.hovered.bg_fill = (*app_theme).palette.surface_raised
    ()
    visuals.widgets.hovered.fg_stroke.color = (*app_theme).palette.text
    ()
    visuals.widgets.hovered.bg_stroke = Stroke__new_(1, (*app_theme).palette.accent)
    ()
    visuals.widgets.active.bg_fill = alpha_tint((*app_theme).palette.accent, 0.22)
    ()
    visuals.widgets.active.fg_stroke.color = (*app_theme).palette.text
    ()
    visuals.widgets.active.bg_stroke = Stroke__new_(1, (*app_theme).palette.accent_soft)
    ()
    visuals.widgets.open.bg_fill = (*app_theme).palette.surface_raised
    ()
    visuals.selection.bg_fill = alpha_tint((*app_theme).palette.accent, 0.36)
    ()
    visuals.selection.stroke.color = (*app_theme).palette.accent_soft
    ()
    visuals.hyperlink_color = (*app_theme).palette.highlight
    ()
    visuals.window_stroke = Stroke__new_(1, (*app_theme).palette.outline_soft)
    ()
    ctx.set_visuals(visuals)
    ()
    let mut style = ((*ctx.style())).clone()
    style.spacing.item_spacing = eframe__egui__vec2((*app_theme).metrics.content_gap, (*app_theme).metrics.section_gap)
    ()
    style.spacing.button_padding = eframe__egui__vec2((*app_theme).metrics.tight_padding, ((*app_theme).metrics.tight_padding * 0.7))
    ()
    style.spacing.indent = ((*app_theme).metrics.content_gap + 4)
    ()
    style.text_styles.insert(eframe__egui__TextStyle__Heading, FontId__proportional((*app_theme).typography.heading))
    ()
    style.text_styles.insert(eframe__egui__TextStyle__Body, FontId__proportional((*app_theme).typography.body))
    ()
    style.text_styles.insert(eframe__egui__TextStyle__Button, FontId__proportional((*app_theme).typography.body))
    ()
    style.text_styles.insert(eframe__egui__TextStyle__Small, FontId__proportional((*app_theme).typography.small))
    ()
    style.text_styles.insert(eframe__egui__TextStyle__Monospace, FontId__monospace((*app_theme).typography.code))
    ()
    ctx.set_style(style)
    ()

fn resolve_text_role(node: &kain_ui::UiNode) -> NativeTextRole:
    match prop_text(node, "role").or_else(fn(): prop_text(node, "text.role")):
        Some(role) => return parse_text_role(role)
        _ =>
            ()
            ()
    match (*node).style.variant:
        Some(variant) => return parse_text_role(variant)
        _ =>
            ()
            ()
    for class_name in &(*node).style.classes:
        let role = parse_text_role(class_name)
        if (role != NativeTextRole__Body):
            return role
    ()
    NativeTextRole__Body

fn parse_text_role(value: String) -> NativeTextRole:
    match value.trim().to_ascii_lowercase().as_str():
        "hero" => NativeTextRole__Hero
        "display" => NativeTextRole__Hero
        "title" => NativeTextRole__Title
        "heading" => NativeTextRole__Title
        "section" => NativeTextRole__Title
        "eyebrow" => NativeTextRole__Eyebrow
        "kicker" => NativeTextRole__Eyebrow
        "label" => NativeTextRole__Eyebrow
        "caption" => NativeTextRole__Caption
        "small" => NativeTextRole__Caption
        "muted" => NativeTextRole__Muted
        "secondary" => NativeTextRole__Muted
        "code" => NativeTextRole__Code
        "mono" => NativeTextRole__Code
        "monospace" => NativeTextRole__Code
        "metric" => NativeTextRole__Metric
        "stat" => NativeTextRole__Metric
        "numeric" => NativeTextRole__Metric
        _ => NativeTextRole__Body

fn render_text_node(ui: &mut eframe::egui::Ui, node: &kain_ui::UiNode, app_theme: &NativeAppTheme, presentation: NativeNodePresentation):
    let role = resolve_text_role(node)
    let text = prop_text(node, "text").unwrap_or_default()
    let (size, color, monospace, strong) = match role:
        NativeTextRole::Hero => (((*app_theme).typography.heading * 1.3), (*app_theme).palette.text, false, true)
        NativeTextRole::Title => (((*app_theme).typography.section * 1.1), (*app_theme).palette.text, false, true)
        NativeTextRole::Eyebrow => ((*app_theme).typography.small, (*app_theme).palette.accent_soft, true, false)
        NativeTextRole::Caption => ((*app_theme).typography.small, (*app_theme).palette.text_muted, false, false)
        NativeTextRole::Muted => ((*app_theme).typography.body, (*app_theme).palette.text_muted, false, false)
        NativeTextRole::Code => ((*app_theme).typography.code, (*app_theme).palette.highlight, true, false)
        NativeTextRole::Metric => (((*app_theme).typography.heading * 1.15), (*app_theme).palette.highlight, true, true)
        NativeTextRole::Body => ((*app_theme).typography.body, (*app_theme).palette.text, false, false)
    let mut rich = RichText__new_(text).size(size).color(apply_node_presentation_to_color(color, presentation))
    if monospace:
        rich = rich.monospace()
        ()
        ()
        ()
        ()
    if strong:
        rich = rich.strong()
        ()
        ()
        ()
        ()
    ui.label(rich)
    ()

fn layout_align(align: kain_ui::UiLayoutAlignment) -> eframe::egui::Align:
    match align:
        kain_ui__UiLayoutAlignment::Start => eframe__egui__Align__Min
        kain_ui__UiLayoutAlignment::Stretch => eframe__egui__Align__Min
        kain_ui__UiLayoutAlignment::SpaceBetween => eframe__egui__Align__Min
        kain_ui__UiLayoutAlignment::Center => eframe__egui__Align__Center
        kain_ui__UiLayoutAlignment::End => eframe__egui__Align__Max

fn resolve_ui_length(length: Option<kain_ui::UiLength>, available: f32) -> Option<f32>:
    let length = length?
    match length.unit:
        kain_ui__UiLengthUnit::Px => Option::Some(length.value.max(0))
        kain_ui__UiLengthUnit::Percent => Option::Some(((available * ((length.value / 100)))).max(0))
        kain_ui__UiLengthUnit::Fr => Option::Some(((available * length.value.max(0))).max(0))
        kain_ui__UiLengthUnit::Auto => none

fn apply_node_layout_constraints(ui: &mut eframe::egui::Ui, node: &kain_ui::UiNode):
    match (*node).layout.min_width:
        Some(min_width) =>
            ui.set_min_width(min_width.max(0))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*node).layout.min_height:
        Some(min_height) =>
            ui.set_min_height(min_height.max(0))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*node).layout.max_width:
        Some(max_width) =>
            ui.set_max_width(max_width.max(0))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match (*node).layout.max_height:
        Some(max_height) =>
            ui.set_max_height(max_height.max(0))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let available = ui.available_size_before_wrap()
    match resolve_ui_length((*node).layout.width, available.x):
        Some(width) =>
            ui.set_width(width)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match resolve_ui_length((*node).layout.height, available.y):
        Some(height) =>
            ui.set_height(height)
            ()
        _ => ()

impl Default for KainUiNativeAppConfig:
    fn default_() -> KainUiNativeAppConfig:
        KainUiNativeAppConfig { window_title: ("KAIN UI Native Demo").to_string(), root_component: ("App").to_string(), source: KAIN_UI_NATIVE_DEMO_SOURCE.to_string(), initial_window_size: [1440, 920], backend_plan: KainUiNativeBackendPlan__default_() }


pub fn build_output(config: &KainUiNativeAppConfig) -> Result<kain_ui::UiBuildOutput, kain_core::KainError>:
    kain_core__build_ui_output_from_source(&(*config).source, &(*config).root_component)

pub fn build_runtime_bundle(config: &KainUiNativeAppConfig) -> Result<KainUiNativeRuntimeBundle, kain_core::KainError>:
    let output = build_output(config)?
    Result::Ok(runtime_bundle_from_output(config, output))

pub fn runtime_bundle_from_output(config: &KainUiNativeAppConfig, output: kain_ui::UiBuildOutput) -> KainUiNativeRuntimeBundle:
    kain_ui__ui_runtime_bundle_from_output(KainUiNativeRuntimeMetadata { app_name: none, window_title: (*config).window_title.clone(), root_component: (*config).root_component.clone(), source_file_name: none, initial_window_size: (*config).initial_window_size, preferred_shell_host_backend: (*config).backend_plan.shell_host_backend, preferred_document_host_backend: (*config).backend_plan.document_host_backend, preferred_devtools_host_backend: (*config).backend_plan.devtools_host_backend, preferred_layout_engine: (*config).backend_plan.layout_engine, preferred_render_engine: (*config).backend_plan.render_engine, compatibility_host_backend: (*config).backend_plan.compatibility_host_backend, mixed_backend_session: (*config).backend_plan.mixed_backend_session }, output)

pub fn runtime_bundle_to_json(bundle: &KainUiNativeRuntimeBundle) -> Result<String, serde_json::Error>:
    kain_ui__ui_runtime_bundle_to_json(bundle)

pub fn runtime_bundle_from_json(json: String) -> Result<KainUiNativeRuntimeBundle, serde_json::Error>:
    kain_ui__ui_runtime_bundle_from_json(json)

pub fn build_demo_output(config: &KainUiNativeDemoConfig) -> Result<kain_ui::UiBuildOutput, kain_core::KainError>:
    build_output(config)

pub fn run_app(config: KainUiNativeAppConfig) -> Result<(), Box<impl Error>>:
    let output = build_output(&config)?
    run_output(config, output, AppBootMode__Source)

pub fn run_bundled_app(bundle: KainUiNativeRuntimeBundle) -> Result<(), Box<impl Error>>:
    validate_runtime_bundle(&bundle)?
    ()
    let config = KainUiNativeAppConfig { window_title: bundle.metadata.window_title.clone(), root_component: bundle.metadata.root_component.clone(), source: String__new_(), initial_window_size: bundle.metadata.initial_window_size, backend_plan: KainUiNativeBackendPlan__from_runtime_metadata(&bundle.metadata) }
    run_output(config, bundle.output, AppBootMode__CompiledBundle)

pub fn run_bundled_app_json(json: String) -> Result<(), Box<impl Error>>:
    let bundle = runtime_bundle_from_json(json)?
    run_bundled_app(bundle)

pub fn run_demo(config: KainUiNativeDemoConfig) -> Result<(), Box<impl Error>>:
    run_app(config)

fn validate_runtime_bundle(bundle: &KainUiNativeRuntimeBundle) -> Result<(), Box<impl Error>>:
    kain_ui__validate_ui_runtime_bundle(bundle).map_err(fn(err): Box__new_(err) as Box<impl Error>)

fn run_output(config: KainUiNativeAppConfig, output: kain_ui::UiBuildOutput, boot_mode: AppBootMode) -> Result<(), Box<impl Error>>:
    let runtime_settings = KainUiNativeRuntimeSettings__from_env()
    trace_runtime(f"run_output: window_title={config.window_title} boot_mode={boot_mode.label()} renderer={runtime_settings.renderer_label()} effective_renderer={runtime_settings.effective_renderer_label()} inspector={runtime_settings.show_runtime_inspector} viewports={runtime_settings.enable_viewports}")
    ()
    let window_title = config.window_title.clone()
    let initial_window_size = config.initial_window_size
    let options = eframe::NativeOptions { renderer: runtime_settings.eframe_renderer(), viewport: ViewportBuilder__default_().with_inner_size(initial_window_size).with_min_inner_size([960, 640]), ..Default__default_() }
    eframe__run_native(&window_title, options, Box__new_(fn(cc): none))?
    ()
    Result::Ok(())

enum AppBootMode:
    Source
    CompiledBundle

impl AppBootMode:
    fn label(_self: AppBootMode) -> String:
        match _self:
            AppBootMode::Source => "source"
            AppBootMode::CompiledBundle => "compiled bundle"


struct ViewportSurfaceState:
    texture: Option<eframe::egui::TextureHandle>
    scene_name: String
    bundle_viewport_node: Option<String>
    bundle_material_refs: Array<String>
    bundle_shader_ref_keys: Array<String>
    bundle_camera: Option<kain_core::RealtimeViewportCameraBinding>
    bundle_presentation: Option<kain_core::RealtimeViewportPresentationBinding>
    bundle_warning: Option<String>
    controller: ViewportCameraController
    last_render_at: Option<std::time::Instant>
    last_stats: kain_3d::RenderStats
    selected_instance_id: Option<String>
    manipulator_mode: kain_3d::ManipulatorMode
    manipulator_space: kain_3d::ManipulatorSpace
    snap_enabled: Bool
    last_pick: Option<kain_3d::PickingHit>
    instance_transform_overrides: Map<String, kain_3d::Transform>
    active_manipulation: Option<ViewportManipulatorState>
    presented_state: Option<std::sync::Arc<std::sync::Mutex<PresentedViewportGpuState>>>

@derive(Clone, Debug)
