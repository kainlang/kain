        (*surface).active_manipulation = none
        ()
        return
    let drag_trigger = viewport_drag_trigger_from_binding_value((*gizmo_binding).drag_trigger)
    if (!viewport_drag_trigger_active(input, drag_trigger)):
        (*surface).active_manipulation = none
        ()
        return
