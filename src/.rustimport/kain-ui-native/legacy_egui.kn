fn vec3_from_triplet(value: [f32; 3]) -> kain_3d::Vec3:
    Vec3__new_(value[0], value[1], value[2])

fn resolve_viewport_reference_pose(scene: &kain_3d::SceneDescription, camera_binding: Option<&kain_core::RealtimeViewportCameraBinding>) -> kain_3d::CameraPose:
    let mut pose = (*scene).camera.pose_at(0)
    let Some(camera_binding) = camera_binding
    match camera_binding.position:
        Some(position) =>
            pose.position = vec3_from_triplet(position)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match camera_binding.target:
        Some(target) =>
            pose.target = vec3_from_triplet(target)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match camera_binding.fov_y_degrees:
        Some(fov_y_degrees) =>
            pose.fov_y_degrees = fov_y_degrees.clamp(1, 175)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match camera_binding.near_plane:
        Some(near_plane) =>
            pose.near_plane = near_plane.max(0.001)
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match camera_binding.far_plane:
        Some(far_plane) =>
            pose.far_plane = far_plane.max((pose.near_plane + 0.1))
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    if (pose.far_plane <= pose.near_plane):
        pose.far_plane = (pose.near_plane + 0.1)
        ()
        ()
        ()
        ()
    pose

