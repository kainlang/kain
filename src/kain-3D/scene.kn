@derive(Clone, Debug, PartialEq)
pub struct Camera:
    target: Vec3
    up: Vec3
    orbit_radius: f32
    orbit_height: f32
    orbit_speed_radians_per_second: f32
    fov_y_degrees: f32
    near_plane: f32
    far_plane: f32

@derive(Clone, Debug, PartialEq)
pub struct CameraPose:
    position: Vec3
    target: Vec3
    up: Vec3
    fov_y_degrees: f32
    near_plane: f32
    far_plane: f32

impl CameraPose:
    pub fn forward(_self: &CameraPose) -> Vec3:
        (((*_self).target - (*_self).position)).normalize()

    pub fn right(_self: &CameraPose) -> Vec3:
        (*_self).forward().cross((*_self).up).normalize()


impl Camera:
    pub fn position_at(_self: &Camera, time_seconds: f32) -> Vec3:
        let angle = (time_seconds * (*_self).orbit_speed_radians_per_second)
        Vec3__new_(((*_self).target.x + (angle.cos() * (*_self).orbit_radius)), ((*_self).target.y + (*_self).orbit_height), ((*_self).target.z + (angle.sin() * (*_self).orbit_radius)))

    pub fn pose_at(_self: &Camera, time_seconds: f32) -> CameraPose:
        CameraPose { position: (*_self).position_at(time_seconds), target: (*_self).target, up: (*_self).up, fov_y_degrees: (*_self).fov_y_degrees, near_plane: (*_self).near_plane, far_plane: (*_self).far_plane }


@derive(Clone, Debug, PartialEq)
pub struct Material:
    base_color: ColorRgb
    specular_color: ColorRgb
    ambient_strength: f32
    diffuse_strength: f32
    specular_strength: f32
    shininess: f32

@derive(Clone, Debug, PartialEq)
pub struct DirectionalLight:
    direction: Vec3
    color: ColorRgb
    intensity: f32

@derive(Clone, Debug, PartialEq)
pub struct PointLight:
    position: Vec3
    color: ColorRgb
    intensity: f32
    range: f32

@derive(Clone, Debug, PartialEq)
pub struct LightingRig:
    ambient_color: ColorRgb
    ambient_intensity: f32
    directional_lights: Array<DirectionalLight>
    point_lights: Array<PointLight>

@derive(Clone, Debug, PartialEq)
pub struct BackgroundGradient:
    top: ColorRgb
    bottom: ColorRgb

@derive(Clone, Debug, PartialEq)
pub struct Vertex:
    position: Vec3
    normal: Vec3

@derive(Clone, Debug, PartialEq)
pub struct Mesh:
    vertices: Array<Vertex>
    triangles: Array<[usize; 3]>

@derive(Clone, Debug, PartialEq)
pub struct SceneInstance:
    id: String
    mesh: String
    material: String
    transform: Transform

pub enum SceneAnimation:
    Spin { instance_id: String, axis_radians_per_second: Vec3 }
    Bob { instance_id: String, amplitude: f32, speed_radians_per_second: f32 }

@derive(Clone, Debug, PartialEq)
pub struct ParticleEmitter:
    id: String
    center: Vec3
    axis: Vec3
    radial_range: [f32; 2]
    vertical_range: [f32; 2]
    particle_size_range: [f32; 2]
    particle_count: usize
    orbit_radians_per_second: f32
    swirl: f32
    drift: Vec3
    color_start: ColorRgb
    color_end: ColorRgb
    emissive_strength: f32
    softness: f32
    depth_test: Bool

impl ParticleEmitter:
    pub fn axis_or_up(_self: &ParticleEmitter) -> Vec3:
        let axis = (*_self).axis.normalize()
        if (axis.length() <= f32__EPSILON):
            Vec3__UP
        else:
            axis


@derive(Clone, Debug, PartialEq)
pub struct BlackHole:
    center: Vec3
    radius: f32
    lens_radius: f32
    spin_axis: Vec3
    inner_color: ColorRgb
    lens_color: ColorRgb
    disk_color: ColorRgb

@derive(Clone, Debug, PartialEq)
pub struct TerrainSurface:
    id: String
    mesh_id: String
    center: Vec3
    half_extents: Vec3
    resolution: [usize; 2]
    base_height: f32
    height_amplitude: f32
    terrace_step: f32
    rim_strength: f32
    ripple_amplitude: f32
    ripple_frequency: f32
    flow_speed: f32
    caldera_radius: f32
    caldera_depth: f32

@derive(Clone, Debug, PartialEq)
pub struct SceneDescription:
    name: String
    viewport_summary: String
    background: BackgroundGradient
    camera: Camera
    lighting: LightingRig
    meshes: Map<String, Mesh>
    materials: Map<String, Material>
    instances: Array<SceneInstance>
    animations: Array<SceneAnimation>
    particle_emitters: Array<ParticleEmitter>
    black_hole: Option<BlackHole>
    terrain_surfaces: Array<TerrainSurface>

impl SceneDescription:
    pub fn animated_instances(_self: &SceneDescription, time_seconds: f32) -> Array<SceneInstance>:
        let mut instances = (*_self).instances.clone()
        for animation in &(*_self).animations:
            match animation:
                SceneAnimation::Spin { instance_id: instance_id, axis_radians_per_second: axis_radians_per_second } =>
                    match instances.iter_mut().find(fn(candidate): (candidate.id == (*instance_id))):
                        Some(instance) =>
                            instance.transform.rotation_radians = (instance.transform.rotation_radians + ((*axis_radians_per_second) * time_seconds))
                            ()
                        _ => ()
                SceneAnimation::Bob { instance_id: instance_id, amplitude: amplitude, speed_radians_per_second: speed_radians_per_second } =>
                    match instances.iter_mut().find(fn(candidate): (candidate.id == (*instance_id))):
                        Some(instance) =>
                            instance.transform.translation.y = (instance.transform.translation.y + (amplitude * ((time_seconds * speed_radians_per_second)).sin()))
                            ()
                        _ => ()
        ()
        instances

    pub fn animated_instances_with_overrides(_self: &SceneDescription, time_seconds: f32, instance_transform_overrides: &Map<String, Transform>) -> Array<SceneInstance>:
        let mut instances = (*_self).animated_instances(time_seconds)
        if instance_transform_overrides.is_empty():
            return instances
        for instance in &mut instances:
            match instance_transform_overrides.get(&instance.id):
                Some(override_transform) =>
                    instance.transform = override_transform.clone()
                    ()
                _ => ()
        ()
        instances

    pub fn resolved_mesh(_self: &SceneDescription, mesh_id: String, time_seconds: f32) -> Option<std::borrow::Cow<_, Mesh>>:
        match (*_self).meshes.get(mesh_id):
            Some(mesh) => return Option::Some(std__borrow__Cow::Borrowed(mesh))
            _ =>
                ()
                ()
        (*_self).terrain_surfaces.iter().find(fn(surface): (surface.mesh_id == mesh_id)).map(fn(surface): std__borrow__Cow::Owned(surface.generate_mesh(time_seconds)))

    pub fn ground_height_at(_self: &SceneDescription, world_position: Vec3, time_seconds: f32) -> Option<f32>:
        (*_self).terrain_surfaces.iter().filter_map(fn(surface): surface.height_at_world_position(world_position, time_seconds)).max_by(fn(left, right): left.partial_cmp(right).unwrap_or(cmp__Ordering__Equal))


impl TerrainSurface:
    pub fn height_at_world_position(_self: &TerrainSurface, world_position: Vec3, time_seconds: f32) -> Option<f32>:
        let half_extent_x = (*_self).half_extents.x.max(0.001)
        let half_extent_z = (*_self).half_extents.z.max(0.001)
        let local_x = (((world_position.x - (*_self).center.x)) / half_extent_x)
        let local_z = (((world_position.z - (*_self).center.z)) / half_extent_z)
        if ((local_x.abs() > 1) || (local_z.abs() > 1)):
            return none
        Option::Some(((*_self).center.y + sample_terrain_height(*_self, local_x, local_z, time_seconds)))

    pub fn generate_mesh(_self: &TerrainSurface, time_seconds: f32) -> Mesh:
        let segments_x = (*_self).resolution[0].max(2)
        let segments_z = (*_self).resolution[1].max(2)
        let mut heights = []
        let index_of = fn(x: usize, z: usize) -> usize: ((z * segments_x) + x)
        for z in range(0, segments_z):
            let tz = (z as f32 / ((segments_z - 1)) as f32)
            let local_z = ((tz * 2) - 1)
            for x in range(0, segments_x):
                let tx = (x as f32 / ((segments_x - 1)) as f32)
                let local_x = ((tx * 2) - 1)
                heights[index_of(x, z)] = sample_terrain_height(*_self, local_x, local_z, time_seconds)
                ()
        ()
        let mut vertices = (fn(__kain_ctor_arg0): Vec__new_())((segments_x * segments_z))
        for z in range(0, segments_z):
            let tz = (z as f32 / ((segments_z - 1)) as f32)
            let local_z = ((tz * 2) - 1)
            for x in range(0, segments_x):
                let tx = (x as f32 / ((segments_x - 1)) as f32)
                let local_x = ((tx * 2) - 1)
                let world_x = ((*_self).center.x + (local_x * (*_self).half_extents.x))
                let world_z = ((*_self).center.z + (local_z * (*_self).half_extents.z))
                let world_y = ((*_self).center.y + heights[index_of(x, z)])
                let left = heights[index_of(x.saturating_sub(1), z)]
                let right = heights[index_of(((x + 1)).min((segments_x - 1)), z)]
                let down = heights[index_of(x, z.saturating_sub(1))]
                let up = heights[index_of(x, ((z + 1)).min((segments_z - 1)))]
                let tangent_x = Vec3__new_(((2 * (*_self).half_extents.x) / ((segments_x - 1)) as f32), (right - left), 0)
                let tangent_z = Vec3__new_(0, (up - down), ((2 * (*_self).half_extents.z) / ((segments_z - 1)) as f32))
                let normal = tangent_z.cross(tangent_x).normalize()
                vertices.push(Vertex { position: Vec3__new_(world_x, world_y, world_z), normal: normal })
                ()
        ()
        let mut triangles = (fn(__kain_ctor_arg0): Vec__new_())(((((segments_x - 1)) * ((segments_z - 1))) * 2))
        for z in range(0, (segments_z - 1)):
            for x in range(0, (segments_x - 1)):
                let a = index_of(x, z)
                let b = index_of((x + 1), z)
                let c = index_of((x + 1), (z + 1))
                let d = index_of(x, (z + 1))
                triangles.push([a, b, c])
                ()
                triangles.push([a, c, d])
                ()
        ()
        Mesh { vertices: vertices, triangles: triangles }


@derive(Clone, Debug, PartialEq)
pub struct SceneCatalog:
    default_scene: String
    scenes: Map<String, SceneDescription>
    scene_aliases: Map<String, String>

impl Default for SceneCatalog:
    fn default_() -> SceneCatalog:
        let dcc_suite_scene = build_dcc_suite_scene()
        let tensor_stream_probe = build_tensor_stream_probe_scene()
        let luminous_port = build_luminous_port_scene()
        let magma_terraces = build_magma_terraces_scene()
        let material_atrium = build_material_atrium_scene()
        let retirement_demo = build_retirement_demo_scene()
        let kerr_black_hole = build_kerr_black_hole_scene()
        let mut scenes = BTreeMap__new_()
        scenes.insert(dcc_suite_scene.name.clone(), dcc_suite_scene)
        ()
        scenes.insert(tensor_stream_probe.name.clone(), tensor_stream_probe)
        ()
        scenes.insert(luminous_port.name.clone(), luminous_port)
        ()
        scenes.insert(magma_terraces.name.clone(), magma_terraces)
        ()
        scenes.insert(material_atrium.name.clone(), material_atrium)
        ()
        scenes.insert(retirement_demo.name.clone(), retirement_demo)
        ()
        scenes.insert(kerr_black_hole.name.clone(), kerr_black_hole)
        ()
        let scene_aliases = BTreeMap__from([(("gpu_compute_surface_probe").to_string(), ("tensor_stream_probe").to_string()), (("spv_ui_surface_probe").to_string(), ("tensor_stream_probe").to_string()), (("starforge").to_string(), ("luminous_port").to_string()), (("emberfall").to_string(), ("magma_terraces").to_string()), (("renderer_atrium").to_string(), ("material_atrium").to_string()), (("material_gallery").to_string(), ("material_atrium").to_string()), (("dcc_authoring_startup").to_string(), ("dcc_suite_scene").to_string()), (("ui_surface_probe").to_string(), ("tensor_stream_probe").to_string())])
        SceneCatalog { default_scene: ("luminous_port").to_string(), scenes: scenes, scene_aliases: scene_aliases }


impl SceneCatalog:
    pub fn scene(_self: &SceneCatalog, name: String) -> Option<&SceneDescription>:
        (*_self).scenes.get(name).or_else(fn(): (*_self).scene_aliases.get(name).and_then(fn(canonical): (*_self).scenes.get(canonical))).or_else(fn(): (*_self).scenes.get(&(*_self).default_scene))


