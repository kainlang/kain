fn build_material_atrium_scene() -> SceneDescription:
    let mut scene = Scene__new_("material_atrium")
    scene.viewport_summary = ("material atrium | primitive-backed renderer showcase | native runtime shell").to_string()
    ()
    scene.background = BackgroundGradient { top: ColorRgb__new_(0.04, 0.08, 0.13), bottom: ColorRgb__new_(0.1, 0.07, 0.11) }
    ()
