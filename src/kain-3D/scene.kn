fn build_magma_terraces_scene() -> SceneDescription:
    let mut meshes = BTreeMap__new_()
    meshes.insert(("cube").to_string(), mesh_cube())
    ()
    meshes.insert(("floor").to_string(), mesh_plane())
    ()
    meshes.insert(("pyramid").to_string(), mesh_pyramid())
    ()
    meshes.insert(("orb").to_string(), mesh_uv_sphere(8, 16))
    ()
    let mut materials = BTreeMap__new_()
    materials.insert(("basalt").to_string(), Material { base_color: ColorRgb__new_(0.1, 0.1, 0.12), specular_color: ColorRgb__new_(0.42, 0.38, 0.44), ambient_strength: 0.34, diffuse_strength: 0.92, specular_strength: 0.14, shininess: 10 })
    ()
    materials.insert(("ash").to_string(), Material { base_color: ColorRgb__new_(0.25, 0.23, 0.22), specular_color: ColorRgb__new_(0.52, 0.48, 0.42), ambient_strength: 0.3, diffuse_strength: 0.86, specular_strength: 0.14, shininess: 12 })
    ()
