    ()
    SceneDescription { name: ("retirement_demo").to_string(), viewport_summary: ("studio demo | depth | lighting | orbit camera").to_string(), background: BackgroundGradient { top: ColorRgb__new_(0.03, 0.05, 0.08), bottom: ColorRgb__new_(0.13, 0.17, 0.22) }, camera: Camera { target: Vec3__new_(0, 0.3, 0), up: Vec3__UP, orbit_radius: 6.8, orbit_height: 2.9, orbit_speed_radians_per_second: 0.35, fov_y_degrees: 52, near_plane: 0.1, far_plane: 100 }, lighting: LightingRig { ambient_color: ColorRgb__new_(0.75, 0.8, 0.95), ambient_intensity: 0.32, directional_lights: [DirectionalLight { direction: Vec3__new_((-0.55), (-1), (-0.4)).normalize(), color: ColorRgb__new_(0.95, 0.96, 1), intensity: 1.25 }, DirectionalLight { direction: Vec3__new_(0.55, (-0.6), 0.3).normalize(), color: ColorRgb__new_(0.25, 0.4, 0.8), intensity: 0.28 }], point_lights: [PointLight { position: Vec3__new_(1.8, 2.2, 1.4), color: ColorRgb__new_(1, 0.75, 0.5), intensity: 1.2, range: 8 }, PointLight { position: Vec3__new_((-2.2), 1.5, (-1.4)), color: ColorRgb__new_(0.35, 0.8, 1), intensity: 0.85, range: 7 }] }, meshes: meshes, materials: materials, instances: [SceneInstance { id: ("hero_cube").to_string(), mesh: ("cube").to_string(), material: ("hero").to_string(), transform: Transform__identity().with_translation(Vec3__new_(0, 0.35, 0)).with_scale(Vec3__new_(1.35, 1.35, 1.35)) }, SceneInstance { id: ("accent_cube").to_string(), mesh: ("cube").to_string(), material: ("accent").to_string(), transform: Transform__identity().with_translation(Vec3__new_((-2.2), 0.55, 1.15)).with_rotation(Vec3__new_(0.1, 0.3, 0)).with_scale(Vec3__new_(0.65, 0.65, 0.65)) }, SceneInstance { id: ("spire").to_string(), mesh: ("pyramid").to_string(), material: ("accent").to_string(), transform: Transform__identity().with_translation(Vec3__new_(2.15, 0.35, (-1.25))).with_scale(Vec3__new_(0.95, 1.4, 0.95)) }, SceneInstance { id: ("floor").to_string(), mesh: ("floor").to_string(), material: ("floor").to_string(), transform: Transform__identity().with_translation(Vec3__new_(0, (-1), 0)).with_scale(Vec3__new_(5.5, 1, 5.5)) }], animations: [SceneAnimation::Spin { instance_id: ("hero_cube").to_string(), axis_radians_per_second: Vec3__new_(0.25, 0.9, 0.1) }, SceneAnimation::Spin { instance_id: ("accent_cube").to_string(), axis_radians_per_second: Vec3__new_(0, (-1.35), 0.15) }, SceneAnimation::Bob { instance_id: ("accent_cube").to_string(), amplitude: 0.18, speed_radians_per_second: 1.9 }, SceneAnimation::Spin { instance_id: ("spire").to_string(), axis_radians_per_second: Vec3__new_(0, 0.5, 0) }], particle_emitters: Vec__new_(), black_hole: none, terrain_surfaces: Vec__new_() }

fn build_kerr_black_hole_scene() -> SceneDescription:
    let spin_axis = Vec3__new_(0.35, 1, 0.18).normalize()
    SceneDescription { name: ("kerr_black_hole").to_string(), viewport_summary: ("kerr singularity | accretion particles | lens shell").to_string(), background: BackgroundGradient { top: ColorRgb__new_(0.01, 0.02, 0.05), bottom: ColorRgb__new_(0, 0, 0.01) }, camera: Camera { target: Vec3__new_(0, 0.2, 0), up: Vec3__UP, orbit_radius: 10, orbit_height: 2.8, orbit_speed_radians_per_second: 0.18, fov_y_degrees: 58, near_plane: 0.05, far_plane: 220 }, lighting: LightingRig { ambient_color: ColorRgb__new_(0.55, 0.58, 0.82), ambient_intensity: 0.12, directional_lights: [DirectionalLight { direction: Vec3__new_((-0.15), (-1), (-0.35)).normalize(), color: ColorRgb__new_(0.28, 0.42, 0.95), intensity: 0.42 }, DirectionalLight { direction: Vec3__new_(0.45, (-0.25), 0.05).normalize(), color: ColorRgb__new_(0.98, 0.62, 0.2), intensity: 0.26 }], point_lights: [PointLight { position: Vec3__new_(2.5, 0.7, 0), color: ColorRgb__new_(1, 0.62, 0.22), intensity: 1.85, range: 10 }, PointLight { position: Vec3__new_((-2), 1.3, (-1.4)), color: ColorRgb__new_(0.48, 0.72, 1), intensity: 1.15, range: 12 }] }, meshes: BTreeMap__new_(), materials: BTreeMap__new_(), instances: Vec__new_(), animations: Vec__new_(), particle_emitters: [ParticleEmitter { id: ("accretion_inner").to_string(), center: Vec3__new_(0, 0, 0), axis: spin_axis, radial_range: [1.55, 2.75], vertical_range: [(-0.18), 0.18], particle_size_range: [0.1, 0.28], particle_count: 60, orbit_radians_per_second: 1.9, swirl: 0.55, drift: Vec3__new_(0, 0.16, 0), color_start: ColorRgb__new_(1, 0.62, 0.18), color_end: ColorRgb__new_(1, 0.92, 0.58), emissive_strength: 0.78, softness: 1.8, depth_test: true }, ParticleEmitter { id: ("accretion_outer").to_string(), center: Vec3__new_(0, 0, 0), axis: spin_axis, radial_range: [2.6, 4.8], vertical_range: [(-0.34), 0.34], particle_size_range: [0.08, 0.22], particle_count: 72, orbit_radians_per_second: 1.05, swirl: 0.35, drift: Vec3__new_(0, 0.22, 0), color_start: ColorRgb__new_(0.34, 0.56, 1), color_end: ColorRgb__new_(1, 0.52, 0.15), emissive_strength: 0.62, softness: 2, depth_test: true }, ParticleEmitter { id: ("north_jet").to_string(), center: (spin_axis * 0.9), axis: spin_axis, radial_range: [0.08, 0.46], vertical_range: [(-0.05), 0.05], particle_size_range: [0.06, 0.18], particle_count: 24, orbit_radians_per_second: 3.5, swirl: 0.9, drift: (spin_axis * 11.5), color_start: ColorRgb__new_(0.72, 0.88, 1), color_end: ColorRgb__new_(0.34, 0.72, 1), emissive_strength: 0.85, softness: 1.4, depth_test: false }, ParticleEmitter { id: ("south_jet").to_string(), center: (spin_axis * (-0.9)), axis: spin_axis, radial_range: [0.08, 0.42], vertical_range: [(-0.05), 0.05], particle_size_range: [0.06, 0.18], particle_count: 24, orbit_radians_per_second: (-3.5), swirl: 0.9, drift: (spin_axis * (-11.5)), color_start: ColorRgb__new_(0.55, 0.78, 1), color_end: ColorRgb__new_(0.92, 0.98, 1), emissive_strength: 0.8, softness: 1.35, depth_test: false }, ParticleEmitter { id: ("star_halo").to_string(), center: Vec3__new_(0, 0, 0), axis: Vec3__UP, radial_range: [8, 18], vertical_range: [(-7.5), 7.5], particle_size_range: [0.03, 0.1], particle_count: 64, orbit_radians_per_second: 0.08, swirl: 0.05, drift: Vec3__ZERO, color_start: ColorRgb__new_(0.55, 0.7, 1), color_end: ColorRgb__new_(1, 1, 1), emissive_strength: 0.28, softness: 1.1, depth_test: false }], black_hole: Option::Some(BlackHole { center: Vec3__ZERO, radius: 1.28, lens_radius: 2.15, spin_axis: spin_axis, inner_color: ColorRgb__new_(0.01, 0.01, 0.02), lens_color: ColorRgb__new_(0.25, 0.55, 1), disk_color: ColorRgb__new_(1, 0.64, 0.18) }), terrain_surfaces: Vec__new_() }

fn sample_terrain_height(surface: &TerrainSurface, local_x: f32, local_z: f32, time_seconds: f32) -> f32:
    let radius = (((local_x * local_x) + (local_z * local_z))).sqrt()
    let basin_t = (1 - smoothstep(((*surface).caldera_radius * 0.2), (*surface).caldera_radius.max(((*surface).caldera_radius * 0.95)), radius.min(1)))
    let rim_t = smoothstep(((*surface).caldera_radius * 0.72), 1, radius.min(1))
    let ridge_noise = (((((((local_x * 4.4) + (time_seconds * 0.22))).sin() * (((local_z * 3.8) - (time_seconds * 0.16))).cos())) * (*surface).height_amplitude) * 0.14)
    let flow_wave = (((((((local_x + local_z)) * (*surface).ripple_frequency)) + (time_seconds * (*surface).flow_speed))).sin() * (*surface).ripple_amplitude)
    let counter_wave = ((((((((local_x - local_z)) * (((*surface).ripple_frequency * 0.72)))) - (time_seconds * (((*surface).flow_speed * 0.58))))).cos() * (*surface).ripple_amplitude) * 0.55)
    let core_heat = (((((1 - smoothstep(0, ((*surface).caldera_radius * 0.88), radius.min(1)))) * (*surface).height_amplitude) * 0.34) * ((((time_seconds * (((*surface).flow_speed * 1.85)))) + (radius * 11))).sin())
    let raw_height = (((((((*surface).base_height + (rim_t * (*surface).rim_strength)) - (basin_t * (*surface).caldera_depth)) + ridge_noise) + flow_wave) + counter_wave) + core_heat)
    if ((*surface).terrace_step <= f32__EPSILON):
        raw_height
    else:
        let terraced = (((raw_height / (*surface).terrace_step)).round() * (*surface).terrace_step)
        ((terraced + (flow_wave * 0.22)) + (core_heat * 0.35))

fn smoothstep(edge0: f32, edge1: f32, value: f32) -> f32:
    if (((edge1 - edge0)).abs() <= f32__EPSILON):
        return if (value >= edge1): 1 else: 0
    let t = ((((value - edge0)) / ((edge1 - edge0)))).clamp(0, 1)
    ((t * t) * ((3 - (2 * t))))

fn mesh_cube() -> Mesh:
    primitive_mesh(PrimitiveShape::Box { size: Vec3__new_(2, 2, 2), width_segments: 1, height_segments: 1, depth_segments: 1 })

fn mesh_plane() -> Mesh:
    primitive_mesh(PrimitiveShape::Plane { size: Vec2__new_(2, 2), width_segments: 1, depth_segments: 1 })

fn mesh_pyramid() -> Mesh:
    let apex = Vec3__new_(0, 1, 0)
    let base = [Vec3__new_((-1), (-1), 1), Vec3__new_(1, (-1), 1), Vec3__new_(1, (-1), (-1)), Vec3__new_((-1), (-1), (-1))]
    let mut vertices = Vec__new_()
    let mut triangles = Vec__new_()
    for face in range(0, 4):
        let next = (((face + 1)) % 4)
        let p0 = base[face]
        let p1 = base[next]
        let normal = ((p1 - p0)).cross((apex - p0)).normalize()
        let base_index = vertices.len()
        vertices.push(Vertex { position: p0, normal: normal })
        ()
        vertices.push(Vertex { position: p1, normal: normal })
        ()
        vertices.push(Vertex { position: apex, normal: normal })
        ()
        triangles.push([base_index, (base_index + 1), (base_index + 2)])
        ()
    ()
    let base_index = vertices.len()
    vertices.extend(base.map(fn(position): Vertex { position: position, normal: Vec3__new_(0, (-1), 0) }))
    ()
    triangles.push([base_index, (base_index + 2), (base_index + 1)])
    ()
    triangles.push([base_index, (base_index + 3), (base_index + 2)])
    ()
    Mesh { vertices: vertices, triangles: triangles }

fn mesh_uv_sphere(latitude_segments: usize, longitude_segments: usize) -> Mesh:
    primitive_mesh(PrimitiveShape::UvSphere { radius: 1, latitude_segments: latitude_segments, longitude_segments: longitude_segments })

fn primitive_mesh(shape: PrimitiveShape) -> Mesh:
    shape.build_mesh().expect("scene primitive should always convert into a render mesh")

