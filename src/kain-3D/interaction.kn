use std::collections::BTreeMap

use crate::CameraPose

use crate::Mat4

use crate::RenderResolution

use crate::SceneCatalog

use crate::SceneDescription

use crate::Transform

use crate::Vec2

use crate::Vec3

@derive(Clone, Debug, PartialEq, Eq)
pub struct PickTargetId:
    instance_id: String
    mesh_id: String

@derive(Clone, Copy, Debug, PartialEq)
pub struct PickingRay:
    origin: Vec3
    direction: Vec3

impl PickingRay:
    pub fn new_(origin: Vec3, direction: Vec3) -> PickingRay:
        PickingRay { origin: origin, direction: direction.normalize() }

    pub fn from_viewport_pixel(pixel_x: f32, pixel_y: f32, resolution: RenderResolution, camera: &CameraPose) -> PickingRay:
        let width = resolution.width.max(1) as f32
        let height = resolution.height.max(1) as f32
        let ndc_x = (((((pixel_x / width)) * 2)) - 1)
        let ndc_y = (1 - ((((pixel_y / height)) * 2)))
        let aspect_ratio = (width / height)
        let tan_half_fov = (((*camera).fov_y_degrees.to_radians() * 0.5)).tan()
        let forward = camera.forward()
        let right = forward.cross((*camera).up).normalize()
        let up = right.cross(forward).normalize()
        let direction = (((forward + (right * (((ndc_x * aspect_ratio) * tan_half_fov)))) + (up * ((ndc_y * tan_half_fov))))).normalize()
        PickingRay__new_((*camera).position, direction)


@derive(Clone, Copy, Debug, PartialEq)
pub struct PickingQuery:
    ray: PickingRay
    scene_time_seconds: f32
    max_distance: f32

impl PickingQuery:
    pub fn new_(ray: PickingRay, scene_time_seconds: f32) -> PickingQuery:
        PickingQuery { ray: ray, scene_time_seconds: scene_time_seconds, max_distance: f32__INFINITY }

    pub fn with_max_distance(_self: PickingQuery, max_distance: f32) -> PickingQuery:
        _self.max_distance = max_distance.max(0)
        ()
        _self


@derive(Clone, Debug, PartialEq)
pub struct PickingHit:
    target: PickTargetId
    distance: f32
    position: Vec3
    normal: Vec3

pub enum ManipulatorMode:
    Translate
    Rotate
    Scale

pub enum ManipulatorSpace:
    World
    Local

pub enum ManipulatorAxis:
    X
    Y
    Z
    PlaneXY
    PlaneXZ
    PlaneYZ
    Screen

pub enum ManipulatorState:
    Idle
    Hover(ManipulatorAxis)
    Active(ManipulatorAxis)

@derive(Clone, Copy, Debug, PartialEq)
pub struct ManipulatorDelta:
    translation: Vec3
    rotation_radians: Vec3
    scale: Vec3

impl Default for ManipulatorDelta:
    fn default_() -> ManipulatorDelta:
        ManipulatorDelta { translation: Vec3__ZERO, rotation_radians: Vec3__ZERO, scale: Vec3__new_(1, 1, 1) }


@derive(Clone, Copy, Debug, Default, PartialEq)
pub struct ManipulatorSnapSettings:
    translation_step: Option<f32>
    rotation_step_radians: Option<f32>
    scale_step: Option<f32>

impl Default for ManipulatorSnapSettings:
    pub fn default_() -> ManipulatorSnapSettings:
        ManipulatorSnapSettings { translation_step: none, rotation_step_radians: none, scale_step: none }


pub fn apply_manipulator_drag(camera: &CameraPose, resolution: RenderResolution, drag_origin_transform: &Transform, pointer_delta: Vec2, manipulator_mode: ManipulatorMode, manipulator_space: ManipulatorSpace, manipulator_axis: ManipulatorAxis, snap_enabled: Bool, snap_settings: ManipulatorSnapSettings) -> Transform:
    let viewport_scale = (resolution.width.min(resolution.height) as f32).max(1)
    let depth_scale = ((((*camera).position.distance((*drag_origin_transform).translation) * 2.4) / viewport_scale)).clamp(0.006, 0.18)
    let camera_right = camera.right()
    let camera_up = camera.right().cross(camera.forward()).normalize()
    let mut updated_transform = drag_origin_transform.clone()
    match manipulator_mode:
        ManipulatorMode::Translate =>
            let translation_delta = match manipulator_axis:
                ManipulatorAxis::Screen => ((camera_right * ((pointer_delta.x * depth_scale))) + (camera_up * (((-pointer_delta.y) * depth_scale))))
                ManipulatorAxis::X =>
                    let axis = manipulator_direction(drag_origin_transform, manipulator_space, manipulator_axis)
                    ((axis * projected_drag_amount(pointer_delta, axis, camera_right, camera_up)) * depth_scale)
                ManipulatorAxis::Y =>
                    let axis = manipulator_direction(drag_origin_transform, manipulator_space, manipulator_axis)
                    ((axis * projected_drag_amount(pointer_delta, axis, camera_right, camera_up)) * depth_scale)
                ManipulatorAxis::Z =>
                    let axis = manipulator_direction(drag_origin_transform, manipulator_space, manipulator_axis)
                    ((axis * projected_drag_amount(pointer_delta, axis, camera_right, camera_up)) * depth_scale)
                ManipulatorAxis::PlaneXY =>
                    let (basis_u, basis_v) = manipulator_plane_basis(drag_origin_transform, manipulator_space, manipulator_axis)
                    ((basis_u * ((pointer_delta.x * depth_scale))) + (basis_v * (((-pointer_delta.y) * depth_scale))))
                ManipulatorAxis::PlaneXZ =>
                    let (basis_u, basis_v) = manipulator_plane_basis(drag_origin_transform, manipulator_space, manipulator_axis)
                    ((basis_u * ((pointer_delta.x * depth_scale))) + (basis_v * (((-pointer_delta.y) * depth_scale))))
                ManipulatorAxis::PlaneYZ =>
                    let (basis_u, basis_v) = manipulator_plane_basis(drag_origin_transform, manipulator_space, manipulator_axis)
                    ((basis_u * ((pointer_delta.x * depth_scale))) + (basis_v * (((-pointer_delta.y) * depth_scale))))
            updated_transform.translation = ((*drag_origin_transform).translation + translation_delta)
            ()
            if snap_enabled:
                match snap_settings.translation_step:
                    Some(step) =>
                        updated_transform.translation = snap_vec3(updated_transform.translation, step)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            ()
        ManipulatorMode::Rotate =>
            match manipulator_axis:
                ManipulatorAxis::Screen =>
                    updated_transform.rotation_radians = ((*drag_origin_transform).rotation_radians + Vec3__new_((pointer_delta.y * (-0.008)), (pointer_delta.x * 0.008), 0))
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::X =>
                    let amount = (projected_drag_amount(pointer_delta, manipulator_direction(drag_origin_transform, manipulator_space, manipulator_axis), camera_right, camera_up) * 0.008)
                    let rotation_delta = match manipulator_axis:
                        ManipulatorAxis::X => Vec3__new_(amount, 0, 0)
                        ManipulatorAxis::Y => Vec3__new_(0, amount, 0)
                        ManipulatorAxis::Z => Vec3__new_(0, 0, amount)
                        _ => Vec3__ZERO
                    updated_transform.rotation_radians = ((*drag_origin_transform).rotation_radians + rotation_delta)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::Y =>
                    let amount = (projected_drag_amount(pointer_delta, manipulator_direction(drag_origin_transform, manipulator_space, manipulator_axis), camera_right, camera_up) * 0.008)
                    let rotation_delta = match manipulator_axis:
                        ManipulatorAxis::X => Vec3__new_(amount, 0, 0)
                        ManipulatorAxis::Y => Vec3__new_(0, amount, 0)
                        ManipulatorAxis::Z => Vec3__new_(0, 0, amount)
                        _ => Vec3__ZERO
                    updated_transform.rotation_radians = ((*drag_origin_transform).rotation_radians + rotation_delta)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::Z =>
                    let amount = (projected_drag_amount(pointer_delta, manipulator_direction(drag_origin_transform, manipulator_space, manipulator_axis), camera_right, camera_up) * 0.008)
                    let rotation_delta = match manipulator_axis:
                        ManipulatorAxis::X => Vec3__new_(amount, 0, 0)
                        ManipulatorAxis::Y => Vec3__new_(0, amount, 0)
                        ManipulatorAxis::Z => Vec3__new_(0, 0, amount)
                        _ => Vec3__ZERO
                    updated_transform.rotation_radians = ((*drag_origin_transform).rotation_radians + rotation_delta)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::PlaneXY =>
                    let amount = (((pointer_delta.x - pointer_delta.y)) * 0.006)
                    let rotation_delta = match manipulator_axis:
                        ManipulatorAxis::PlaneXY => Vec3__new_(0, 0, amount)
                        ManipulatorAxis::PlaneXZ => Vec3__new_(0, amount, 0)
                        ManipulatorAxis::PlaneYZ => Vec3__new_(amount, 0, 0)
                        _ => Vec3__ZERO
                    updated_transform.rotation_radians = ((*drag_origin_transform).rotation_radians + rotation_delta)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::PlaneXZ =>
                    let amount = (((pointer_delta.x - pointer_delta.y)) * 0.006)
                    let rotation_delta = match manipulator_axis:
                        ManipulatorAxis::PlaneXY => Vec3__new_(0, 0, amount)
                        ManipulatorAxis::PlaneXZ => Vec3__new_(0, amount, 0)
                        ManipulatorAxis::PlaneYZ => Vec3__new_(amount, 0, 0)
                        _ => Vec3__ZERO
                    updated_transform.rotation_radians = ((*drag_origin_transform).rotation_radians + rotation_delta)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::PlaneYZ =>
                    let amount = (((pointer_delta.x - pointer_delta.y)) * 0.006)
                    let rotation_delta = match manipulator_axis:
                        ManipulatorAxis::PlaneXY => Vec3__new_(0, 0, amount)
                        ManipulatorAxis::PlaneXZ => Vec3__new_(0, amount, 0)
                        ManipulatorAxis::PlaneYZ => Vec3__new_(amount, 0, 0)
                        _ => Vec3__ZERO
                    updated_transform.rotation_radians = ((*drag_origin_transform).rotation_radians + rotation_delta)
                    ()
                    ()
                    ()
                    ()
            if snap_enabled:
                match snap_settings.rotation_step_radians:
                    Some(step) =>
                        updated_transform.rotation_radians = snap_vec3(updated_transform.rotation_radians, step)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            ()
        ManipulatorMode::Scale =>
            let base_scale = (*drag_origin_transform).scale
            match manipulator_axis:
                ManipulatorAxis::Screen =>
                    let scale_factor = ((1 + (((pointer_delta.x - pointer_delta.y)) * 0.004))).clamp(0.25, 5)
                    updated_transform.scale = (base_scale * scale_factor)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::X =>
                    let amount = (projected_drag_amount(pointer_delta, manipulator_direction(drag_origin_transform, manipulator_space, manipulator_axis), camera_right, camera_up) * 0.004)
                    let scale_factor = ((1 + amount)).clamp(0.25, 5)
                    let axis_scale = match manipulator_axis:
                        ManipulatorAxis::X => Vec3__new_(scale_factor, 1, 1)
                        ManipulatorAxis::Y => Vec3__new_(1, scale_factor, 1)
                        ManipulatorAxis::Z => Vec3__new_(1, 1, scale_factor)
                        _ => Vec3__new_(1, 1, 1)
                    updated_transform.scale = base_scale.component_mul(axis_scale)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::Y =>
                    let amount = (projected_drag_amount(pointer_delta, manipulator_direction(drag_origin_transform, manipulator_space, manipulator_axis), camera_right, camera_up) * 0.004)
                    let scale_factor = ((1 + amount)).clamp(0.25, 5)
                    let axis_scale = match manipulator_axis:
                        ManipulatorAxis::X => Vec3__new_(scale_factor, 1, 1)
                        ManipulatorAxis::Y => Vec3__new_(1, scale_factor, 1)
                        ManipulatorAxis::Z => Vec3__new_(1, 1, scale_factor)
                        _ => Vec3__new_(1, 1, 1)
                    updated_transform.scale = base_scale.component_mul(axis_scale)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::Z =>
                    let amount = (projected_drag_amount(pointer_delta, manipulator_direction(drag_origin_transform, manipulator_space, manipulator_axis), camera_right, camera_up) * 0.004)
                    let scale_factor = ((1 + amount)).clamp(0.25, 5)
                    let axis_scale = match manipulator_axis:
                        ManipulatorAxis::X => Vec3__new_(scale_factor, 1, 1)
                        ManipulatorAxis::Y => Vec3__new_(1, scale_factor, 1)
                        ManipulatorAxis::Z => Vec3__new_(1, 1, scale_factor)
                        _ => Vec3__new_(1, 1, 1)
                    updated_transform.scale = base_scale.component_mul(axis_scale)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::PlaneXY =>
                    let scale_factor = ((1 + (((pointer_delta.x - pointer_delta.y)) * 0.0035))).clamp(0.25, 5)
                    let plane_scale = match manipulator_axis:
                        ManipulatorAxis::PlaneXY => Vec3__new_(scale_factor, scale_factor, 1)
                        ManipulatorAxis::PlaneXZ => Vec3__new_(scale_factor, 1, scale_factor)
                        ManipulatorAxis::PlaneYZ => Vec3__new_(1, scale_factor, scale_factor)
                        _ => Vec3__new_(1, 1, 1)
                    updated_transform.scale = base_scale.component_mul(plane_scale)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::PlaneXZ =>
                    let scale_factor = ((1 + (((pointer_delta.x - pointer_delta.y)) * 0.0035))).clamp(0.25, 5)
                    let plane_scale = match manipulator_axis:
                        ManipulatorAxis::PlaneXY => Vec3__new_(scale_factor, scale_factor, 1)
                        ManipulatorAxis::PlaneXZ => Vec3__new_(scale_factor, 1, scale_factor)
                        ManipulatorAxis::PlaneYZ => Vec3__new_(1, scale_factor, scale_factor)
                        _ => Vec3__new_(1, 1, 1)
                    updated_transform.scale = base_scale.component_mul(plane_scale)
                    ()
                    ()
                    ()
                    ()
                ManipulatorAxis::PlaneYZ =>
                    let scale_factor = ((1 + (((pointer_delta.x - pointer_delta.y)) * 0.0035))).clamp(0.25, 5)
                    let plane_scale = match manipulator_axis:
                        ManipulatorAxis::PlaneXY => Vec3__new_(scale_factor, scale_factor, 1)
                        ManipulatorAxis::PlaneXZ => Vec3__new_(scale_factor, 1, scale_factor)
                        ManipulatorAxis::PlaneYZ => Vec3__new_(1, scale_factor, scale_factor)
                        _ => Vec3__new_(1, 1, 1)
                    updated_transform.scale = base_scale.component_mul(plane_scale)
                    ()
                    ()
                    ()
                    ()
            if snap_enabled:
                match snap_settings.scale_step:
                    Some(step) =>
                        updated_transform.scale = Vec3__new_(round_to_step(updated_transform.scale.x, step).max(step), round_to_step(updated_transform.scale.y, step).max(step), round_to_step(updated_transform.scale.z, step).max(step))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            ()
    updated_transform

pub enum SceneCommand:
    Select { target: Option<PickTargetId> }
    SetTransform { target: PickTargetId, translation: Option<Vec3>, rotation_radians: Option<Vec3>, scale: Option<Vec3> }
    SetVisibility { target: PickTargetId, visible: Bool }

@derive(Clone, Debug, PartialEq)
pub struct SceneTransaction:
    label: String
    commands: Array<SceneCommand>

pub trait PickingService:
    fn pick_scene(_self: &Self_, scene: &SceneDescription, query: &PickingQuery) -> Option<PickingHit>:
        let __selfhost_empty = none
    fn pick_catalog_scene(_self: &Self_, catalog: &SceneCatalog, scene_name: String, query: &PickingQuery) -> Option<PickingHit>:
        let scene = catalog.scene(scene_name)?
        _self.pick_scene(scene, query)

@derive(Clone, Copy, Debug, Default)
pub struct CpuPickingService:
    __selfhost_placeholder: Bool = false

impl Default for CpuPickingService:
    pub fn default_() -> CpuPickingService:
        CpuPickingService {}


impl PickingService for CpuPickingService:
    fn pick_scene(_self: &CpuPickingService, scene: &SceneDescription, query: &PickingQuery) -> Option<PickingHit>:
        (*_self).pick_scene_filtered(scene, query, none)


impl CpuPickingService:
    pub fn pick_scene_with_overrides(_self: &CpuPickingService, scene: &SceneDescription, query: &PickingQuery, instance_transform_overrides: &Map<String, Transform>) -> Option<PickingHit>:
        (*_self).pick_scene_filtered_with_overrides(scene, query, none, instance_transform_overrides)

    pub fn pick_catalog_scene_with_overrides(_self: &CpuPickingService, catalog: &SceneCatalog, scene_name: String, query: &PickingQuery, instance_transform_overrides: &Map<String, Transform>) -> Option<PickingHit>:
        let scene = catalog.scene(scene_name)?
        (*_self).pick_scene_with_overrides(scene, query, instance_transform_overrides)

    pub fn pick_scene_instance(_self: &CpuPickingService, scene: &SceneDescription, query: &PickingQuery, instance_id: String) -> Option<PickingHit>:
        (*_self).pick_scene_filtered(scene, query, Option::Some(instance_id))

    pub fn pick_catalog_scene_instance(_self: &CpuPickingService, catalog: &SceneCatalog, scene_name: String, query: &PickingQuery, instance_id: String) -> Option<PickingHit>:
        let scene = catalog.scene(scene_name)?
        (*_self).pick_scene_instance(scene, query, instance_id)

    pub fn pick_scene_instance_with_overrides(_self: &CpuPickingService, scene: &SceneDescription, query: &PickingQuery, instance_id: String, instance_transform_overrides: &Map<String, Transform>) -> Option<PickingHit>:
        (*_self).pick_scene_filtered_with_overrides(scene, query, Option::Some(instance_id), instance_transform_overrides)

    pub fn pick_catalog_scene_instance_with_overrides(_self: &CpuPickingService, catalog: &SceneCatalog, scene_name: String, query: &PickingQuery, instance_id: String, instance_transform_overrides: &Map<String, Transform>) -> Option<PickingHit>:
        let scene = catalog.scene(scene_name)?
        (*_self).pick_scene_instance_with_overrides(scene, query, instance_id, instance_transform_overrides)

    fn pick_scene_filtered(_self: &CpuPickingService, scene: &SceneDescription, query: &PickingQuery, instance_filter: Option<String>) -> Option<PickingHit>:
        (*_self).pick_scene_filtered_with_overrides(scene, query, instance_filter, &BTreeMap__new_())

    fn pick_scene_filtered_with_overrides(_self: &CpuPickingService, scene: &SceneDescription, query: &PickingQuery, instance_filter: Option<String>, instance_transform_overrides: &Map<String, Transform>) -> Option<PickingHit>:
        let mut closest_hit: Option<PickingHit> = none
        for instance in scene.animated_instances_with_overrides((*query).scene_time_seconds, instance_transform_overrides):
            match instance_filter:
                Some(instance_filter) =>
                    if (instance.id != instance_filter):
                        continue
                    ()
                _ =>
                    ()
                    ()
            let mesh = scene.resolved_mesh(&instance.mesh, (*query).scene_time_seconds)?
            let mesh = mesh
            let model = instance.transform.matrix_()
            for triangle in &mesh.triangles:
                let [ia, ib, ic] = (*triangle)
                let a = to_vec3(model.transform_point(mesh.vertices[ia].position))
                let b = to_vec3(model.transform_point(mesh.vertices[ib].position))
                let c = to_vec3(model.transform_point(mesh.vertices[ic].position))
                match intersect_ray_triangle((*query).ray, a, b, c, (*query).max_distance):
                    Some((distance, position, normal)) =>
                        let replace = (none).is_none_or(fn(current): (distance < current.distance))
                        if replace:
                            closest_hit = Option::Some(PickingHit { target: PickTargetId { instance_id: instance.id.clone(), mesh_id: instance.mesh.clone() }, distance: distance, position: position, normal: normal })
                            ()
                    _ => ()
        ()
        closest_hit


fn intersect_ray_triangle(ray: PickingRay, a: Vec3, b: Vec3, c: Vec3, max_distance: f32) -> Option<(f32, Vec3, Vec3)>:
    let edge_ab = (b - a)
    let edge_ac = (c - a)
    let pvec = ray.direction.cross(edge_ac)
    let determinant = edge_ab.dot(pvec)
    if (determinant.abs() <= 0.000001):
        return none
    let inv_det = (1 / determinant)
    let tvec = (ray.origin - a)
    let u = (tvec.dot(pvec) * inv_det)
    if (!(range(0, (1 + 1))).contains(&u)):
        return none
    let qvec = tvec.cross(edge_ab)
    let v = (ray.direction.dot(qvec) * inv_det)
    if ((v < 0) || ((u + v) > 1)):
        return none
    let distance = (edge_ac.dot(qvec) * inv_det)
    if ((distance <= 0.0001) || (distance > max_distance)):
        return none
    let position = (ray.origin + (ray.direction * distance))
    let normal = edge_ab.cross(edge_ac).normalize()
    Option::Some((distance, position, normal))

fn to_vec3(position: [f32; 4]) -> Vec3:
    let w = if (position[3].abs() <= f32__EPSILON):
        1
    else:
        position[3]
    Vec3__new_((position[0] / w), (position[1] / w), (position[2] / w))

fn manipulator_direction(drag_origin_transform: &Transform, manipulator_space: ManipulatorSpace, manipulator_axis: ManipulatorAxis) -> Vec3:
    let axis = match manipulator_axis:
        ManipulatorAxis::X => Vec3__new_(1, 0, 0)
        ManipulatorAxis::Y => Vec3__new_(0, 1, 0)
        ManipulatorAxis::Z => Vec3__new_(0, 0, 1)
        _ => return Vec3__ZERO
    match manipulator_space:
        ManipulatorSpace::World => axis
        ManipulatorSpace::Local => Mat4__rotation_xyz((*drag_origin_transform).rotation_radians).transform_vector(axis).normalize()

fn manipulator_plane_basis(drag_origin_transform: &Transform, manipulator_space: ManipulatorSpace, manipulator_axis: ManipulatorAxis) -> (Vec3, Vec3):
    let (axis_u, axis_v) = match manipulator_axis:
        ManipulatorAxis::PlaneXY => (ManipulatorAxis__X, ManipulatorAxis__Y)
        ManipulatorAxis::PlaneXZ => (ManipulatorAxis__X, ManipulatorAxis__Z)
        ManipulatorAxis::PlaneYZ => (ManipulatorAxis__Y, ManipulatorAxis__Z)
        _ => return (Vec3__ZERO, Vec3__ZERO)
    (manipulator_direction(drag_origin_transform, manipulator_space, axis_u), manipulator_direction(drag_origin_transform, manipulator_space, axis_v))

fn projected_drag_amount(pointer_delta: Vec2, world_axis: Vec3, camera_right: Vec3, camera_up: Vec3) -> f32:
    let projected = Vec2__new_(world_axis.dot(camera_right), (-world_axis.dot(camera_up)))
    let fallback = if (projected.length() <= f32__EPSILON):
        Vec2__new_(1, 0)
    else:
        projected.normalize()
    pointer_delta.dot(fallback)

fn round_to_step(value: f32, step: f32) -> f32:
    if (step.abs() <= f32__EPSILON):
        value
    else:
        (((value / step)).round() * step)

fn snap_vec3(value: Vec3, step: f32) -> Vec3:
    Vec3__new_(round_to_step(value.x, step), round_to_step(value.y, step), round_to_step(value.z, step))

