pub enum AttributeDomain:
    Vertex
    Face
    Instance

pub enum AttributeValues:
    Scalar(Array<f32>)
    Vec2(Array<Vec2>)
    Vec3(Array<Vec3>)
    Color(Array<ColorRgb>)

impl AttributeValues:
    pub fn len(_self: &AttributeValues) -> usize:
        match *_self:
            AttributeValues::Scalar(values) => values.len()
            AttributeValues::Vec2(values) => values.len()
            AttributeValues::Vec3(values) => values.len()
            AttributeValues::Color(values) => values.len()

    pub fn is_empty(_self: &AttributeValues) -> Bool:
        ((*_self).len() == 0)


@derive(Clone, Debug, PartialEq)
pub struct GeometryAttribute:
    name: String
    domain: AttributeDomain
    values: AttributeValues

impl GeometryAttribute:
    pub fn new_(name: impl Into<String>, domain: AttributeDomain, values: AttributeValues) -> GeometryAttribute:
        GeometryAttribute { name: name.into(), domain: domain, values: values }


pub enum GeometryTopology:
    Triangles
    Lines
    Points

pub enum GeometryError:
    MissingPositions
    InvalidAttributeLength { attribute: String, expected: usize, actual: usize }
    InvalidIndex(u32)
    InvalidTriangleIndexCount(usize)
    UnsupportedTopology(GeometryTopology)

impl fmt::Display for GeometryError:
    fn fmt(_self: &GeometryError, f: &mut fmt::Formatter<_>) -> Result<(), Error>:
        match *_self:
            GeometryError::MissingPositions => __kain_write_fmt!(f, "geometry is missing a `position` attribute")
            GeometryError::InvalidAttributeLength { attribute: attribute, expected: expected, actual: actual } => __kain_write_fmt!(f, f"attribute `{attribute}` expected {expected} values but found {actual}")
            GeometryError::InvalidIndex(index) => __kain_write_fmt!(f, f"geometry references invalid vertex index `{index}`")
            GeometryError::InvalidTriangleIndexCount(count) => __kain_write_fmt!(f, f"triangle geometry requires an index count divisible by 3, found {count}")
            GeometryError::UnsupportedTopology(topology) => __kain_write_fmt!(f, f"operation does not support topology `{topology}`")


impl error::Error for GeometryError:
    fn __selfhost_empty_impl__():
        let __selfhost_empty = none

@derive(Clone, Debug, PartialEq)
pub struct Geometry:
    topology: GeometryTopology
    attributes: Map<String, GeometryAttribute>
    indices: Array<u32>

impl Geometry:
    pub fn new_(topology: GeometryTopology) -> Geometry:
        Geometry { topology: topology, attributes: BTreeMap__new_(), indices: Vec__new_() }

    pub fn triangle_mesh() -> Geometry:
        Geometry__new_(GeometryTopology__Triangles)

    pub fn plane(size: Vec2) -> Geometry:
        PrimitiveShape::Plane { size: size, width_segments: 1, depth_segments: 1 }.build_geometry()

    pub fn box_mesh(size: Vec3) -> Geometry:
        PrimitiveShape::Box { size: size, width_segments: 1, height_segments: 1, depth_segments: 1 }.build_geometry()

    pub fn uv_sphere(radius: f32, latitude_segments: usize, longitude_segments: usize) -> Geometry:
        PrimitiveShape::UvSphere { radius: radius, latitude_segments: latitude_segments, longitude_segments: longitude_segments }.build_geometry()

    pub fn cylinder(radius: f32, height: f32, radial_segments: usize, height_segments: usize) -> Geometry:
        PrimitiveShape::Cylinder { radius: radius, height: height, radial_segments: radial_segments, height_segments: height_segments, cap_segments: 1 }.build_geometry()

    pub fn cone(radius: f32, height: f32, radial_segments: usize, height_segments: usize) -> Geometry:
        PrimitiveShape::Cone { radius: radius, height: height, radial_segments: radial_segments, height_segments: height_segments, cap_segments: 1 }.build_geometry()

    pub fn capsule(radius: f32, height: f32, radial_segments: usize, hemisphere_segments: usize, body_segments: usize) -> Geometry:
        PrimitiveShape::Capsule { radius: radius, height: height, radial_segments: radial_segments, hemisphere_segments: hemisphere_segments, body_segments: body_segments }.build_geometry()

    pub fn torus(major_radius: f32, minor_radius: f32, major_segments: usize, minor_segments: usize) -> Geometry:
        PrimitiveShape::Torus { major_radius: major_radius, minor_radius: minor_radius, major_segments: major_segments, minor_segments: minor_segments }.build_geometry()

    pub fn quad_sphere(radius: f32, resolution: usize) -> Geometry:
        PrimitiveShape::QuadSphere { radius: radius, resolution: resolution }.build_geometry()

    pub fn from_mesh(mesh: &Mesh) -> Geometry:
        Geometry__triangle_mesh().with_positions((*mesh).vertices.iter().map(fn(vertex_): vertex_.position).collect()).with_normals((*mesh).vertices.iter().map(fn(vertex_): vertex_.normal).collect()).with_indices((*mesh).triangles.iter().flat_map(fn(triangle): triangle.map(fn(index): index as u32)).collect())

    pub fn with_positions(_self: Geometry, values: Array<Vec3>) -> Geometry:
        _self.attributes.insert(("position").to_string(), GeometryAttribute__new_("position", AttributeDomain__Vertex, AttributeValues::Vec3(values)))
        ()
        _self

    pub fn with_normals(_self: Geometry, values: Array<Vec3>) -> Geometry:
        _self.attributes.insert(("normal").to_string(), GeometryAttribute__new_("normal", AttributeDomain__Vertex, AttributeValues::Vec3(values)))
        ()
        _self

    pub fn with_uvs(_self: Geometry, values: Array<Vec2>) -> Geometry:
        _self.attributes.insert(("uv").to_string(), GeometryAttribute__new_("uv", AttributeDomain__Vertex, AttributeValues::Vec2(values)))
        ()
        _self

    pub fn with_colors(_self: Geometry, values: Array<ColorRgb>) -> Geometry:
        _self.attributes.insert(("color").to_string(), GeometryAttribute__new_("color", AttributeDomain__Vertex, AttributeValues::Color(values)))
        ()
        _self

    pub fn with_indices(_self: Geometry, indices: Array<u32>) -> Geometry:
        _self.indices = indices
        ()
        _self

    pub fn set_attribute(_self: &mut Geometry, attribute: GeometryAttribute) -> &mut Geometry:
        (*_self).attributes.insert(attribute.name.clone(), attribute)
        ()
        *_self

    pub fn vertex_count(_self: &Geometry) -> usize:
        (*_self).positions().map_or(0, len)

    pub fn positions(_self: &Geometry) -> Option<&[Vec3]>:
        match (*_self).attributes.get("position"):
            Some(GeometryAttribute { values: AttributeValues::Vec3(values) }) => Option::Some(values)
            _ => none

    pub fn normals(_self: &Geometry) -> Option<&[Vec3]>:
        match (*_self).attributes.get("normal"):
            Some(GeometryAttribute { values: AttributeValues::Vec3(values) }) => Option::Some(values)
            _ => none

    pub fn uvs(_self: &Geometry) -> Option<&[Vec2]>:
        match (*_self).attributes.get("uv"):
            Some(GeometryAttribute { values: AttributeValues::Vec2(values) }) => Option::Some(values)
            _ => none

    fn set_positions(_self: &mut Geometry, values: Array<Vec3>):
        (*_self).attributes.insert(("position").to_string(), GeometryAttribute__new_("position", AttributeDomain__Vertex, AttributeValues::Vec3(values)))
        ()

    fn set_normals(_self: &mut Geometry, values: Array<Vec3>):
        (*_self).attributes.insert(("normal").to_string(), GeometryAttribute__new_("normal", AttributeDomain__Vertex, AttributeValues::Vec3(values)))
        ()

    pub fn validate(_self: &Geometry) -> Result<(), GeometryError>:
        let positions = (*_self).positions().ok_or(GeometryError__MissingPositions)?
        let vertex_count = positions.len()
        for selfhost_for_item in &(*_self).attributes:
            let (name, attribute) = selfhost_for_item
            if ((attribute.domain == AttributeDomain__Vertex) && (attribute.values.len() != vertex_count)):
                return Result::Err(GeometryError::InvalidAttributeLength { attribute: name.clone(), expected: vertex_count, actual: attribute.values.len() })
        ()
        if ((((*_self).topology == GeometryTopology__Triangles) && (!(*_self).indices.is_empty())) && (((*_self).indices.len() % 3) != 0)):
            return Result::Err(GeometryError::InvalidTriangleIndexCount((*_self).indices.len()))
        for index in &(*_self).indices:
            if ((*index) as usize >= vertex_count):
                return Result::Err(GeometryError::InvalidIndex((*index)))
        ()
        Result::Ok(())

    pub fn compute_vertex_normals(_self: &mut Geometry) -> Result<&mut Geometry, GeometryError>:
        (*_self).validate()?
        ()
        if ((*_self).topology != GeometryTopology__Triangles):
            return Result::Err(GeometryError::UnsupportedTopology((*_self).topology))
        let positions = (*_self).positions().ok_or(GeometryError__MissingPositions)?
        let normals = generate_vertex_normals(positions, &(*_self).indices)?
        (*_self).set_normals(normals)
        ()
        Result::Ok(*_self)

    pub fn transformed(_self: &Geometry, transform: &Transform) -> Result<Geometry, GeometryError>:
        (*_self).validate()?
        ()
        let mut output = (*_self).clone()
        let positions = ((*_self).positions().ok_or(GeometryError__MissingPositions)?).iter().copied().map(fn(position): transform.transform_point(position)).collect()
        output.set_positions(positions)
        ()
        match (*_self).normals():
            Some(normals) =>
                let rotation = Mat4__rotation_xyz((*transform).rotation_radians)
                output.set_normals(normals.iter().copied().map(fn(normal): rotation.transform_vector(normal).normalize()).collect())
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        Result::Ok(output)

    pub fn apply_modifiers(_self: &Geometry, modifiers: &[Modifier]) -> Result<Geometry, GeometryError>:
        let mut output = (*_self).clone()
        for modifier in modifiers:
            modifier.apply(&mut output)?
            ()
        ()
        Result::Ok(output)

    pub fn to_mesh(_self: &Geometry) -> Result<Mesh, GeometryError>:
        (*_self).validate()?
        ()
        if ((*_self).topology != GeometryTopology__Triangles):
            return Result::Err(GeometryError::UnsupportedTopology((*_self).topology))
        let positions = (*_self).positions().ok_or(GeometryError__MissingPositions)?
        let normals = match (*_self).normals():
            Some(values) => values.to_vec()
            None => generate_vertex_normals(positions, &(*_self).indices)?
        let vertices = positions.iter().zip(normals.iter()).map(fn(__kain_closure_arg0): Vertex { position: (*__kain_closure_arg0.__kain_tuple_0), normal: (*__kain_closure_arg0.__kain_tuple_1) }).collect()
        let triangles = if (*_self).indices.is_empty():
            (range(0, positions.len())).step_by(3).map(fn(index): [index, (index + 1), (index + 2)]).collect()
        else:
            (*_self).indices.chunks_exact(3).map(fn(chunk): [chunk[0] as usize, chunk[1] as usize, chunk[2] as usize]).collect()
        Result::Ok(Mesh { vertices: vertices, triangles: triangles })


pub enum Field:
    Constant(f32)
    Linear { axis: Vec3, start: f32, end: f32 }
    Radial { center: Vec3, inner_radius: f32, outer_radius: f32 }
    Noise { frequency: f32, offset: Vec3 }
    VolumeMask { volume: Volume, feather: f32 }

impl Field:
    pub fn sample(_self: &Field, point: Vec3) -> f32:
        match *_self:
            Field::Constant(value) => value.clamp(0, 1)
            Field::Linear { axis: axis, start: start, end: end } =>
                let axis = axis.normalize()
                let projected = point.dot(axis)
                smoothstep((*start), (*end), projected)
            Field::Radial { center: center, inner_radius: inner_radius, outer_radius: outer_radius } =>
                let distance = point.distance((*center))
                if (distance <= (*inner_radius)):
                    1
                elif (distance >= (*outer_radius)):
                    0
                else:
                    (1 - smoothstep((*inner_radius), (*outer_radius), distance))
            Field::Noise { frequency: frequency, offset: offset } =>
                let sample = pseudo_noise(((point * (*frequency)) + (*offset)))
                (((sample * 0.5) + 0.5)).clamp(0, 1)
            Field::VolumeMask { volume: volume, feather: feather } =>
                let distance = volume.sample_sdf(point)
                if (distance <= 0):
                    1
                elif ((*feather) <= f32__EPSILON):
                    0
                else:
                    ((1 - (distance / (*feather)))).clamp(0, 1)


pub enum Modifier:
    Translate(Vec3)
    Scale(Vec3)
    Inflate { amount: f32 }
    Twist { axis: Vec3, angle_radians: f32, field: Option<Field> }
    NoiseDisplace { amplitude: f32, frequency: f32, along_normal: Bool, field: Option<Field> }
    Spherify { factor: f32 }

impl Modifier:
    pub fn apply(_self: &Modifier, geometry: &mut Geometry) -> Result<(), GeometryError>:
        geometry.validate()?
        ()
        let positions = (geometry.positions().ok_or(GeometryError__MissingPositions)?).to_vec()
        let normals = geometry.normals().map(ToOwned__to_owned)
        let mut next_positions = positions.clone()
        match *_self:
            Modifier::Translate(offset) =>
                for position in &mut next_positions:
                    (*position) = ((*position) + (*offset))
                    ()
                ()
                ()
            Modifier::Scale(scale) =>
                for position in &mut next_positions:
                    (*position) = position.component_mul((*scale))
                    ()
                ()
                ()
            Modifier::Inflate { amount: amount } =>
                for selfhost_for_item in next_positions.iter_mut().enumerate():
                    let (index, position) = selfhost_for_item
                    let normal = normals.and_then(fn(values): values.get(index)).copied().unwrap_or_else(fn(): positions[index].normalize())
                    (*position) = ((*position) + (normal * (*amount)))
                    ()
                ()
                ()
            Modifier::Twist { axis: axis, angle_radians: angle_radians, field: field } =>
                let axis = axis.normalize()
                for selfhost_for_item in next_positions.iter_mut().enumerate():
                    let (index, position) = selfhost_for_item
                    let weight = field.map(fn(value): value.sample(positions[index])).unwrap_or(1)
                    let distance_along_axis = positions[index].dot(axis)
                    let angle = ((angle_radians * distance_along_axis) * weight)
                    (*position) = rotate_around_axis(positions[index], axis, angle)
                    ()
                ()
                ()
            Modifier::NoiseDisplace { amplitude: amplitude, frequency: frequency, along_normal: along_normal, field: field } =>
                for selfhost_for_item in next_positions.iter_mut().enumerate():
                    let (index, position) = selfhost_for_item
                    let weight = field.map(fn(value): value.sample(positions[index])).unwrap_or(1)
                    let noise = ((pseudo_noise((positions[index] * (*frequency))) * amplitude) * weight)
                    let direction = if (*along_normal):
                        normals.and_then(fn(values): values.get(index)).copied().unwrap_or_else(fn(): positions[index].normalize())
                    else:
                        Vec3__new_(pseudo_noise(((positions[index] * (((*frequency) * 0.73))) + Vec3__new_(17, 0, 0))), pseudo_noise(((positions[index] * (((*frequency) * 0.89))) + Vec3__new_(0, 23, 0))), pseudo_noise(((positions[index] * (((*frequency) * 1.11))) + Vec3__new_(0, 0, 29)))).normalize()
                    (*position) = ((*position) + (direction * noise))
                    ()
                ()
                ()
            Modifier::Spherify { factor: factor } =>
                let average_radius = if positions.is_empty():
                    0
                else:
                    (positions.iter().map(fn(position): position.length()).sum() / positions.len() as f32)
                for selfhost_for_item in next_positions.iter_mut().enumerate():
                    let (index, position) = selfhost_for_item
                    let target = (positions[index].normalize() * average_radius)
                    (*position) = positions[index].lerp(target, factor.clamp(0, 1))
                    ()
                ()
                ()
        geometry.set_positions(next_positions)
        ()
        if (normals.is_some() && (!none)):
            geometry.compute_vertex_normals()?
            ()
            ()
            ()
            ()
        Result::Ok(())


pub enum Effector:
    Translate { offset: Vec3, field: Field }
    Rotate { rotation_radians: Vec3, field: Field }
    Scale { factor: Vec3, field: Field }

impl Effector:
    pub fn apply(_self: &Effector, sample_position: Vec3, transform: &mut Transform):
        let weight = match *_self:
            Effector::Translate { field: field } => field.sample(sample_position)
            Effector::Rotate { field: field } => field.sample(sample_position)
            Effector::Scale { field: field } => field.sample(sample_position)
        match *_self:
            Effector::Translate { offset: offset } =>
                (*transform).translation = ((*transform).translation + ((*offset) * weight))
                ()
            Effector::Rotate { rotation_radians: rotation_radians } =>
                (*transform).rotation_radians = ((*transform).rotation_radians + ((*rotation_radians) * weight))
                ()
            Effector::Scale { factor: factor } =>
                let weighted = Vec3__new_((1 + (((factor.x - 1)) * weight)), (1 + (((factor.y - 1)) * weight)), (1 + (((factor.z - 1)) * weight)))
                (*transform).scale = (*transform).scale.component_mul(weighted)
                ()


pub enum SplineType:
    Linear
    CatmullRom

@derive(Clone, Debug, PartialEq)
pub struct Spline:
    points: Array<Vec3>
    spline_type: SplineType
    closed: Bool

impl Spline:
    pub fn line_(points: Array<Vec3>) -> Spline:
        Spline { points: points, spline_type: SplineType__Linear, closed: false }

    pub fn catmull_rom(points: Array<Vec3>, closed: Bool) -> Spline:
        Spline { points: points, spline_type: SplineType__CatmullRom, closed: closed }

    pub fn sample(_self: &Spline, t: f32) -> Vec3:
        if (*_self).points.is_empty():
            return Vec3__ZERO
        if ((*_self).points.len() == 1):
            return (*_self).points[0]
        let point_count = if (*_self).closed:
            (*_self).points.len()
        else:
            ((*_self).points.len() - 1)
        let scaled = (t.clamp(0, 1) * point_count as f32)
        let segment = scaled.floor() as usize
        let local_t = (scaled - segment as f32)
        match (*_self).spline_type:
            SplineType::Linear =>
                let a = (*_self).points[segment.min(((*_self).points.len() - 1))]
                let b = (*_self).points[(*_self).wrap_index((segment + 1))]
                a.lerp(b, local_t)
            SplineType::CatmullRom =>
                let p0 = (*_self).points[(*_self).wrap_index(segment.saturating_sub(1))]
                let p1 = (*_self).points[(*_self).wrap_index(segment)]
                let p2 = (*_self).points[(*_self).wrap_index((segment + 1))]
                let p3 = (*_self).points[(*_self).wrap_index((segment + 2))]
                catmull_rom(p0, p1, p2, p3, local_t)

    pub fn tangent(_self: &Spline, t: f32) -> Vec3:
        let delta = 0.001
        let a = (*_self).sample(((t - delta)).clamp(0, 1))
        let b = (*_self).sample(((t + delta)).clamp(0, 1))
        ((b - a)).normalize()

    fn wrap_index(_self: &Spline, index: usize) -> usize:
        if (*_self).closed:
            (index % (*_self).points.len())
        else:
            index.min(((*_self).points.len() - 1))


pub enum Volume:
    Sphere { radius: f32 }
    Box { half_extents: Vec3 }
    Capsule { radius: f32, half_height: f32 }
    Union(Array<Volume>)
    Difference { base: Box<Volume>, subtract: Box<Volume> }

impl Volume:
    pub fn sample_sdf(_self: &Volume, point: Vec3) -> f32:
        match *_self:
            Volume::Sphere { radius: radius } => (point.length() - radius)
            Volume::Box { half_extents: half_extents } =>
                let delta = (abs_vec3(point) - (*half_extents))
                let outside = Vec3__new_(delta.x.max(0), delta.y.max(0), delta.z.max(0))
                (outside.length() + delta.x.max(delta.y.max(delta.z)).min(0))
            Volume::Capsule { radius: radius, half_height: half_height } =>
                let clamped_y = point.y.clamp((-(*half_height)), (*half_height))
                let closest = Vec3__new_(0, clamped_y, 0)
                (((point - closest)).length() - radius)
            Volume::Union(volumes) => volumes.iter().map(fn(volume): volume.sample_sdf(point)).fold(f32__INFINITY, f32__min)
            Volume::Difference { base: base, subtract: subtract } => base.sample_sdf(point).max((-subtract.sample_sdf(point)))


pub enum InstancePattern:
    Grid { counts: [usize; 3], spacing: Vec3, centered: Bool }
    AlongSpline { spline: Spline, count: usize, align_to_tangent: Bool }
    Points { points: Array<Vec3> }

@derive(Clone, Debug, PartialEq)
pub struct Instancer:
    geometry: String
    material: String
    pattern: InstancePattern
    effectors: Array<Effector>

impl Instancer:
    pub fn grid(geometry: impl Into<String>, material: impl Into<String>, counts: [usize; 3], spacing: Vec3) -> Instancer:
        Instancer { geometry: geometry.into(), material: material.into(), pattern: InstancePattern::Grid { counts: counts, spacing: spacing, centered: true }, effectors: Vec__new_() }

    pub fn generate_transforms(_self: &Instancer) -> Array<Transform>:
        let mut transforms = match &(*_self).pattern:
            InstancePattern::Grid { counts: counts, spacing: spacing, centered: centered } => generate_grid_transforms((*counts), (*spacing), (*centered))
            InstancePattern::AlongSpline { spline: spline, count: count, align_to_tangent: align_to_tangent } =>
                let count = ((*count)).max(1)
                (range(0, count)).map(fn(index): none).collect()
            InstancePattern::Points { points: points } => points.iter().copied().map(fn(position): Transform__identity().with_translation(position)).collect()
        for transform in &mut transforms:
            let sample_position = transform.translation
            for effector in &(*_self).effectors:
                effector.apply(sample_position, transform)
                ()
        ()
        transforms


pub enum BrushFalloff:
    Constant
    Linear
    Smooth
    Sphere

@derive(Clone, Debug, PartialEq)
pub struct Brush:
    radius: f32
    strength: f32
    spacing: f32
    falloff: BrushFalloff

impl Brush:
    pub fn sample_weight(_self: &Brush, distance: f32, pressure: f32) -> f32:
        if ((*_self).radius <= f32__EPSILON):
            return 0
        let normalized = ((distance / (*_self).radius)).clamp(0, 1)
        let falloff = match (*_self).falloff:
            BrushFalloff::Constant => 1
            BrushFalloff::Linear => (1 - normalized)
            BrushFalloff::Smooth => (1 - smoothstep(0, 1, normalized))
            BrushFalloff::Sphere => ((1 - (normalized * normalized))).max(0).sqrt()
        ((((*_self).strength * pressure) * falloff)).clamp(0, 1)


@derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)
pub struct NodeId:
    field_0: usize

@derive(Clone, Debug, PartialEq)
pub struct ToolContext:
    active_scene: String
    cursor_world: Vec3
    cursor_normal: Vec3
    pressure: f32
    time_seconds: f32
    brush: Brush
    selected_nodes: Set<NodeId>

impl ToolContext:
    pub fn stroke_weight(_self: &ToolContext, point: Vec3) -> f32:
        (*_self).brush.sample_weight(point.distance((*_self).cursor_world), (*_self).pressure)


@derive(Clone, Debug, PartialEq)
pub struct MeshNode:
    geometry: String
    material: String
    modifiers: Array<Modifier>

pub enum Light:
    Directional(DirectionalLight)
    Point(PointLight)

impl Light:
    pub fn directional(direction: Vec3, color: ColorRgb, intensity: f32) -> Light:
        Light::Directional(DirectionalLight { direction: direction.normalize(), color: color, intensity: intensity })

    pub fn point(color: ColorRgb, intensity: f32, range: f32) -> Light:
        Light::Point(PointLight { position: Vec3__ZERO, color: color, intensity: intensity, range: range })


pub enum NodeKind:
    Empty
    Mesh(MeshNode)
    Camera(Camera)
    Light(Light)
    Spline(Spline)
    Volume(Volume)
    Instancer(Instancer)
    Brush(Brush)
    ToolContext(ToolContext)

@derive(Clone, Debug, PartialEq)
pub struct Node:
    id: NodeId
    name: String
    transform: Transform
    kind: NodeKind
    children: Array<NodeId>

impl Node:
    pub fn new_(id: NodeId, name: impl Into<String>, kind: NodeKind) -> Node:
        Node { id: id, name: name.into(), transform: Transform__identity(), kind: kind, children: Vec__new_() }


pub enum SceneBuildError:
    MissingNode(NodeId)
    MissingGeometry(String)
    MissingMaterial(String)
    Geometry(GeometryError)

impl fmt::Display for SceneBuildError:
    fn fmt(_self: &SceneBuildError, f: &mut fmt::Formatter<_>) -> Result<(), Error>:
        match *_self:
            SceneBuildError::MissingNode(node) => __kain_write_fmt!(f, f"scene references missing node `{node.field_0}`")
            SceneBuildError::MissingGeometry(name) => __kain_write_fmt!(f, f"scene references missing geometry `{name}`")
            SceneBuildError::MissingMaterial(name) => __kain_write_fmt!(f, f"scene references missing material `{name}`")
            SceneBuildError::Geometry(error) => __kain_write_fmt!(f, error)


impl error::Error for SceneBuildError:
    fn __selfhost_empty_impl__():
        let __selfhost_empty = none

impl From<GeometryError> for SceneBuildError:
    fn from(value: GeometryError) -> SceneBuildError:
        SceneBuildError::Geometry(value)


@derive(Clone, Debug, PartialEq)
pub struct Scene:
    name: String
    viewport_summary: String
    background: BackgroundGradient
    base_camera: Camera
    base_lighting: LightingRig
    geometries: Map<String, Geometry>
    materials: Map<String, Material>
    metadata: Map<String, String>
    nodes: Map<NodeId, Node>
    root_nodes: Array<NodeId>
    next_node_id: usize

impl Scene:
    pub fn new_(name: impl Into<String>) -> Scene:
        Scene { name: name.into(), viewport_summary: ("authoring scene").to_string(), background: BackgroundGradient__solid(ColorRgb__new_(0.08, 0.1, 0.14)), base_camera: Camera__orbit(Vec3__ZERO, 8, 2.5), base_lighting: LightingRig__studio(), geometries: BTreeMap__new_(), materials: BTreeMap__new_(), metadata: BTreeMap__new_(), nodes: BTreeMap__new_(), root_nodes: Vec__new_(), next_node_id: 0 }

    pub fn add_geometry(_self: &mut Scene, name: impl Into<String>, geometry: Geometry) -> &mut Scene:
        (*_self).geometries.insert(name.into(), geometry)
        ()
        *_self

    pub fn add_primitive_definition(_self: &mut Scene, definition: &PrimitiveDefinition) -> &mut Scene:
        (*_self).geometries.insert((*definition).id.clone(), definition.build_geometry())
        ()
        (*_self).metadata.insert(f"primitive_definition.{(*definition).id}.resource_uri", (*definition).resource_uri.clone())
        ()
        (*_self).metadata.insert(f"primitive_definition.{(*definition).id}.display_name", (*definition).display_name.clone())
        ()
        (*_self).metadata.insert(f"primitive_definition.{(*definition).id}.subdivision_ready", (*definition).subdivision_ready.to_string())
        ()
        (*_self).metadata.insert(f"primitive_definition.{(*definition).id}.authored_intent", (*definition).authored_intent.clone())
        ()
        *_self

    pub fn add_primitive_library(_self: &mut Scene, library: &PrimitiveLibrary) -> &mut Scene:
        (*_self).metadata.insert(("primitive_library.resource_document_uri").to_string(), (*library).resource_document_uri.clone())
        ()
        (*_self).metadata.insert(("primitive_library.startup_primitive_id").to_string(), (*library).startup_primitive_id.clone())
        ()
        (*_self).metadata.insert(("primitive_library.authored_policy").to_string(), (*library).authored_policy.clone())
        ()
        for definition in (*library).definitions.values():
            (*_self).add_primitive_definition(definition)
            ()
        ()
        *_self

    pub fn add_material(_self: &mut Scene, name: impl Into<String>, material: Material) -> &mut Scene:
        (*_self).materials.insert(name.into(), material)
        ()
        *_self

    pub fn spawn_node(_self: &mut Scene, name: impl Into<String>, kind: NodeKind) -> NodeId:
        let id = NodeId((*_self).next_node_id)
        (*_self).next_node_id = ((*_self).next_node_id + 1)
        ()
        let node = Node__new_(id, name, kind)
        (*_self).nodes.insert(id, node)
        ()
        (*_self).root_nodes.push(id)
        ()
        id

    pub fn spawn_mesh(_self: &mut Scene, name: impl Into<String>, geometry: impl Into<String>, material: impl Into<String>) -> NodeId:
        (*_self).spawn_node(name, NodeKind::Mesh(MeshNode { geometry: geometry.into(), material: material.into(), modifiers: Vec__new_() }))

    pub fn spawn_instancer(_self: &mut Scene, name: impl Into<String>, instancer: Instancer) -> NodeId:
        (*_self).spawn_node(name, NodeKind::Instancer(instancer))

    pub fn node(_self: &Scene, id: NodeId) -> Option<&Node>:
        (*_self).nodes.get(&id)

    pub fn node_mut(_self: &mut Scene, id: NodeId) -> Option<&mut Node>:
        (*_self).nodes.get_mut(&id)

    pub fn attach(_self: &mut Scene, parent: NodeId, child: NodeId) -> Result<&mut Scene, SceneBuildError>:
        if (!(*_self).nodes.contains_key(&child)):
            return Result::Err(SceneBuildError::MissingNode(child))
        let parent_node = (*_self).nodes.get_mut(&parent).ok_or(SceneBuildError::MissingNode(parent))?
        if (!parent_node.children.contains(&child)):
            parent_node.children.push(child)
            ()
            ()
            ()
            ()
        (*_self).root_nodes.retain(fn(candidate): ((*candidate) != child))
        ()
        Result::Ok(*_self)

    pub fn flatten(_self: &Scene) -> Result<SceneDescription, SceneBuildError>:
        let mut description = SceneDescription { name: (*_self).name.clone(), viewport_summary: (*_self).viewport_summary.clone(), background: (*_self).background.clone(), camera: (*_self).base_camera.clone(), lighting: (*_self).base_lighting.clone(), meshes: BTreeMap__new_(), materials: (*_self).materials.clone(), instances: Vec__new_(), animations: Vec__new_(), particle_emitters: Vec__new_(), black_hole: none, terrain_surfaces: Vec__new_() }
        for root in &(*_self).root_nodes:
            (*_self).collect_node((*root), &Transform__identity(), &mut description)?
            ()
        ()
        Result::Ok(description)

    fn collect_node(_self: &Scene, node_id: NodeId, parent_world: &Transform, description: &mut SceneDescription) -> Result<(), SceneBuildError>:
        let node = (*_self).nodes.get(&node_id).ok_or(SceneBuildError::MissingNode(node_id))?
        let world = parent_world.combine(&node.transform)
        match &node.kind:
            NodeKind::Empty => ()
            NodeKind::Spline(_) => ()
            NodeKind::Volume(_) => ()
            NodeKind::Brush(_) => ()
            NodeKind::ToolContext(_) => ()
            NodeKind::Camera(camera) =>
                (*description).camera = camera.clone()
                ()
                ()
                ()
                ()
            NodeKind::Light(light) =>
                match light:
                    Light::Directional(light) =>
                        let rotation = Mat4__rotation_xyz(world.rotation_radians)
                        let mut copy = light.clone()
                        copy.direction = rotation.transform_vector(copy.direction).normalize()
                        ()
                        (*description).lighting.directional_lights.push(copy)
                        ()
                        ()
                        ()
                        ()
                    Light::Point(light) =>
                        let mut copy = light.clone()
                        copy.position = world.transform_point(copy.position)
                        ()
                        (*description).lighting.point_lights.push(copy)
                        ()
                        ()
                        ()
                        ()
            NodeKind::Mesh(mesh_node) =>
                let geometry = (*_self).geometries.get(&mesh_node.geometry).ok_or_else(fn(): SceneBuildError::MissingGeometry(mesh_node.geometry.clone()))?
                if (!(*description).materials.contains_key(&mesh_node.material)):
                    return Result::Err(SceneBuildError::MissingMaterial(mesh_node.material.clone()))
                let final_geometry = geometry.apply_modifiers(&mesh_node.modifiers)?
                let mesh_name = if mesh_node.modifiers.is_empty():
                    mesh_node.geometry.clone()
                else:
                    f"{mesh_node.geometry}__node_{node.id.field_0}"
                (*description).meshes.entry(mesh_name.clone()).or_insert(final_geometry.to_mesh()?)
                ()
                (*description).instances.push(SceneInstance { id: node.name.clone(), mesh: mesh_name, material: mesh_node.material.clone(), transform: world.clone() })
                ()
                ()
                ()
                ()
            NodeKind::Instancer(instancer) =>
                let geometry = (*_self).geometries.get(&instancer.geometry).ok_or_else(fn(): SceneBuildError::MissingGeometry(instancer.geometry.clone()))?
                if (!(*description).materials.contains_key(&instancer.material)):
                    return Result::Err(SceneBuildError::MissingMaterial(instancer.material.clone()))
                (*description).meshes.entry(instancer.geometry.clone()).or_insert(geometry.to_mesh()?)
                ()
                for selfhost_for_item in instancer.generate_transforms().into_iter().enumerate():
                    let (instance_index, local) = selfhost_for_item
                    (*description).instances.push(SceneInstance { id: f"{node.name}_{instance_index}", mesh: instancer.geometry.clone(), material: instancer.material.clone(), transform: world.combine(&local) })
                    ()
                ()
                ()
        for child in &node.children:
            (*_self).collect_node((*child), &world, description)?
            ()
        ()
        Result::Ok(())


impl Material:
    pub fn standard(base_color: ColorRgb) -> Material:
        Material { base_color: base_color, specular_color: ColorRgb__WHITE, ambient_strength: 0.2, diffuse_strength: 1, specular_strength: 0.28, shininess: 18 }

    pub fn matte(base_color: ColorRgb) -> Material:
        Material { specular_strength: 0.06, shininess: 6, ..Material__standard(base_color) }

    pub fn glossy(base_color: ColorRgb) -> Material:
        Material { specular_strength: 0.52, shininess: 36, ..Material__standard(base_color) }


impl Camera:
    pub fn orbit(target: Vec3, orbit_radius: f32, orbit_height: f32) -> Camera:
        Camera { target: target, up: Vec3__UP, orbit_radius: orbit_radius, orbit_height: orbit_height, orbit_speed_radians_per_second: 0, fov_y_degrees: 55, near_plane: 0.1, far_plane: 250 }


impl LightingRig:
    pub fn studio() -> LightingRig:
        LightingRig { ambient_color: ColorRgb__new_(0.72, 0.76, 0.84), ambient_intensity: 0.28, directional_lights: [DirectionalLight { direction: Vec3__new_((-0.55), (-1), (-0.35)).normalize(), color: ColorRgb__WHITE, intensity: 1.1 }, DirectionalLight { direction: Vec3__new_(0.45, (-0.5), 0.25).normalize(), color: ColorRgb__new_(0.34, 0.48, 0.92), intensity: 0.26 }], point_lights: [PointLight { position: Vec3__new_(2, 2.8, 1.8), color: ColorRgb__new_(1, 0.82, 0.68), intensity: 0.88, range: 10 }] }


impl BackgroundGradient:
    pub fn solid(color: ColorRgb) -> BackgroundGradient:
        BackgroundGradient { top: color, bottom: color }


fn generate_vertex_normals(positions: &[Vec3], indices: &[u32]) -> Result<Array<Vec3>, GeometryError>:
    let mut normals = []
    let triangle_source = if indices.is_empty():
        if ((positions.len() % 3) != 0):
            return Result::Err(GeometryError::InvalidTriangleIndexCount(positions.len()))
        (range(0, positions.len())).step_by(3).map(fn(index): [index as u32, (index as u32 + 1), (index as u32 + 2)]).collect()
    else:
        if ((indices.len() % 3) != 0):
            return Result::Err(GeometryError::InvalidTriangleIndexCount(indices.len()))
        indices.chunks_exact(3).map(fn(chunk): [chunk[0], chunk[1], chunk[2]]).collect()
    for triangle in triangle_source:
        let a = positions[triangle[0] as usize]
        let b = positions[triangle[1] as usize]
        let c = positions[triangle[2] as usize]
        let normal = ((b - a)).cross((c - a)).normalize()
        normals[triangle[0] as usize] = (normals[triangle[0] as usize] + normal)
        ()
        normals[triangle[1] as usize] = (normals[triangle[1] as usize] + normal)
        ()
        normals[triangle[2] as usize] = (normals[triangle[2] as usize] + normal)
        ()
    ()
    for normal in &mut normals:
        (*normal) = normal.normalize()
        ()
    ()
    Result::Ok(normals)

fn rotate_around_axis(point: Vec3, axis: Vec3, angle: f32) -> Vec3:
    let axis = axis.normalize()
    let cos_theta = angle.cos()
    let sin_theta = angle.sin()
    (((point * cos_theta) + (axis.cross(point) * sin_theta)) + ((axis * axis.dot(point)) * ((1 - cos_theta))))

fn pseudo_noise(point: Vec3) -> f32:
    let value = (((((point.x * 12.9898) + (point.y * 78.233)) + (point.z * 37.719))).sin() * 43758.547)
    ((value.fract() * 2) - 1)

fn smoothstep(edge0: f32, edge1: f32, value: f32) -> f32:
    if (((edge1 - edge0)).abs() <= f32__EPSILON):
        return 1
    let t = ((((value - edge0)) / ((edge1 - edge0)))).clamp(0, 1)
    ((t * t) * ((3 - (2 * t))))

fn catmull_rom(p0: Vec3, p1: Vec3, p2: Vec3, p3: Vec3, t: f32) -> Vec3:
    let t2 = (t * t)
    let t3 = (t2 * t)
    ((((((p1 * 2) + (((p2 - p0)) * t)) + ((((((p0 * 2) - (p1 * 5)) + (p2 * 4)) - p3)) * t2)) + ((((p3 - p0) + (((p1 - p2)) * 3))) * t3))) * 0.5)

fn abs_vec3(value: Vec3) -> Vec3:
    Vec3__new_(value.x.abs(), value.y.abs(), value.z.abs())

fn generate_grid_transforms(counts: [usize; 3], spacing: Vec3, centered: Bool) -> Array<Transform>:
    let counts = [counts[0].max(1), counts[1].max(1), counts[2].max(1)]
    let extent = Vec3__new_((((counts[0] - 1)) as f32 * spacing.x), (((counts[1] - 1)) as f32 * spacing.y), (((counts[2] - 1)) as f32 * spacing.z))
    let offset = if centered:
        (extent * (-0.5))
    else:
        Vec3__ZERO
    let mut transforms = Vec__new_()
    for z in range(0, counts[2]):
        for y in range(0, counts[1]):
            for x in range(0, counts[0]):
                transforms.push(Transform__identity().with_translation((offset + Vec3__new_((x as f32 * spacing.x), (y as f32 * spacing.y), (z as f32 * spacing.z)))))
                ()
    ()
    transforms

