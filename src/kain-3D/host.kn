impl kain_host::ToKainValue for GeometryTopology:
    fn to_kain_value(_self: GeometryTopology) -> kain_host::Value:
        match _self:
            GeometryTopology::Triangles => kain_host__bridge__enum_variant_value("GeometryTopology", "Triangles", [])
            GeometryTopology::Lines => kain_host__bridge__enum_variant_value("GeometryTopology", "Lines", [])
            GeometryTopology::Points => kain_host__bridge__enum_variant_value("GeometryTopology", "Points", [])


impl kain_host::FromKainValue for GeometryTopology:
    fn from_kain_value(value: kain_host::Value) -> kain_host::HostResult<GeometryTopology>:
        let (variant, fields) = kain_host__bridge__expect_enum(value, "GeometryTopology")?
        let fields = kain_host__bridge__expect_variant_len(fields, 0, "GeometryTopology", &variant)?
        let _ = fields
        match variant.as_str():
            "Triangles" => Result::Ok(GeometryTopology__Triangles)
            "Lines" => Result::Ok(GeometryTopology__Lines)
            "Points" => Result::Ok(GeometryTopology__Points)
            _ => Result::Err(KainError__runtime(f"Unknown GeometryTopology variant `{variant}`"))


impl kain_host::ToKainValue for Geometry:
    fn to_kain_value(_self: Geometry) -> kain_host::Value:
        kain_host__bridge__struct_value("Geometry", [("positions", _self.positions().unwrap_or(&[]).to_vec().to_kain_value()), ("normals", _self.normals().unwrap_or(&[]).to_vec().to_kain_value()), ("uvs", _self.uvs().unwrap_or(&[]).to_vec().to_kain_value()), ("colors", Vec__new_().to_kain_value()), ("indices", _self.indices.iter().map(fn(value): (*value) as i64).collect().to_kain_value()), ("topology", _self.topology.to_kain_value())])


impl kain_host::FromKainValue for Geometry:
    fn from_kain_value(value: kain_host::Value) -> kain_host::HostResult<Geometry>:
        let mut fields = kain_host__bridge__expect_struct(value, "Geometry")?
        let positions = kain_host__bridge__take_struct_field(&mut fields, "positions")?
        let normals = kain_host__bridge__take_struct_field(&mut fields, "normals")?
        let uvs = kain_host__bridge__take_struct_field(&mut fields, "uvs")?
        let colors = kain_host__bridge__take_struct_field(&mut fields, "colors")?
        let indices = kain_host__bridge__take_struct_field(&mut fields, "indices")?
        let topology = kain_host__bridge__take_struct_field(&mut fields, "topology")?
        let mut geometry = Geometry__new_(topology).with_positions(positions).with_normals(normals).with_uvs(uvs).with_colors(colors).with_indices(indices.into_iter().map(fn(value): u32__try_from(value).map_err(fn(_): KainError__runtime("index out of range"))).collect()?)
        if (geometry.normals().is_none() || geometry.normals().is_some_and(fn(values): values.is_empty())):
            let _ = geometry.compute_vertex_normals()
            ()
        Result::Ok(geometry)


