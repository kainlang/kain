impl kain_host::ToKainValue for Field:
    fn to_kain_value(_self: Field) -> kain_host::Value:
        match _self:
            Field::Constant(value) => kain_host__bridge__enum_variant_value("Field", "Constant", [value.to_kain_value()])
            Field::Linear { axis: axis, start: start, end: end } => kain_host__bridge__enum_variant_value("Field", "Linear", [axis.to_kain_value(), start.to_kain_value(), end.to_kain_value()])
            Field::Radial { center: center, inner_radius: inner_radius, outer_radius: outer_radius } => kain_host__bridge__enum_variant_value("Field", "Radial", [center.to_kain_value(), inner_radius.to_kain_value(), outer_radius.to_kain_value()])
            Field::Noise { frequency: frequency, offset: offset } => kain_host__bridge__enum_variant_value("Field", "Noise", [frequency.to_kain_value(), offset.to_kain_value()])
            Field::VolumeMask {  } => KainError__runtime("VolumeMask bridge is not implemented").to_string().to_kain_value()


impl kain_host::FromKainValue for Field:
    fn from_kain_value(value: kain_host::Value) -> kain_host::HostResult<Field>:
        let (variant, fields) = kain_host__bridge__expect_enum(value, "Field")?
        match variant.as_str():
            "Constant" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 1, "Field", "Constant")?
                Result::Ok(Field::Constant(f32__from_kain_value(fields.remove(0))?))
            "Linear" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 3, "Field", "Linear")?
                Result::Ok(Field::Linear { axis: Vec3__from_kain_value(fields.remove(0))?, start: f32__from_kain_value(fields.remove(0))?, end: f32__from_kain_value(fields.remove(0))? })
            "Radial" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 3, "Field", "Radial")?
                Result::Ok(Field::Radial { center: Vec3__from_kain_value(fields.remove(0))?, inner_radius: f32__from_kain_value(fields.remove(0))?, outer_radius: f32__from_kain_value(fields.remove(0))? })
            "Noise" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 2, "Field", "Noise")?
                Result::Ok(Field::Noise { frequency: f32__from_kain_value(fields.remove(0))?, offset: Vec3__from_kain_value(fields.remove(0))? })
            _ => Result::Err(KainError__runtime(f"Unknown Field variant `{variant}`"))


impl kain_host::ToKainValue for Modifier:
    fn to_kain_value(_self: Modifier) -> kain_host::Value:
        match _self:
            Modifier::Translate(offset) => kain_host__bridge__enum_variant_value("Modifier", "Translate", [offset.to_kain_value()])
            Modifier::Scale(factor) => kain_host__bridge__enum_variant_value("Modifier", "Scale", [factor.to_kain_value()])
            Modifier::Inflate { amount: amount } => kain_host__bridge__enum_variant_value("Modifier", "Inflate", [amount.to_kain_value()])
            Modifier::Twist { axis: axis, angle_radians: angle_radians } => kain_host__bridge__enum_variant_value("Modifier", "Twist", [axis.to_kain_value(), angle_radians.to_kain_value()])
            Modifier::NoiseDisplace { amplitude: amplitude, frequency: frequency } => kain_host__bridge__enum_variant_value("Modifier", "NoiseDisplace", [amplitude.to_kain_value(), frequency.to_kain_value()])
            Modifier::Spherify { factor: factor } => kain_host__bridge__enum_variant_value("Modifier", "Spherify", [factor.to_kain_value()])


impl kain_host::FromKainValue for Modifier:
    fn from_kain_value(value: kain_host::Value) -> kain_host::HostResult<Modifier>:
        let (variant, fields) = kain_host__bridge__expect_enum(value, "Modifier")?
        match variant.as_str():
            "Translate" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 1, "Modifier", "Translate")?
                Result::Ok(Modifier::Translate(Vec3__from_kain_value(fields.remove(0))?))
            "Scale" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 1, "Modifier", "Scale")?
                Result::Ok(Modifier::Scale(Vec3__from_kain_value(fields.remove(0))?))
            "Inflate" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 1, "Modifier", "Inflate")?
                Result::Ok(Modifier::Inflate { amount: f32__from_kain_value(fields.remove(0))? })
            "Twist" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 2, "Modifier", "Twist")?
                Result::Ok(Modifier::Twist { axis: Vec3__from_kain_value(fields.remove(0))?, angle_radians: f32__from_kain_value(fields.remove(0))?, field: none })
            "NoiseDisplace" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 2, "Modifier", "NoiseDisplace")?
                Result::Ok(Modifier::NoiseDisplace { amplitude: f32__from_kain_value(fields.remove(0))?, frequency: f32__from_kain_value(fields.remove(0))?, along_normal: true, field: none })
            "Spherify" =>
                let mut fields = kain_host__bridge__expect_variant_len(fields, 1, "Modifier", "Spherify")?
                Result::Ok(Modifier::Spherify { factor: f32__from_kain_value(fields.remove(0))? })
            _ => Result::Err(KainError__runtime(f"Unknown Modifier variant `{variant}`"))


impl kain_host::ToKainValue for BrushFalloff:
    fn to_kain_value(_self: BrushFalloff) -> kain_host::Value:
        let variant = match _self:
            BrushFalloff::Constant => "Constant"
            BrushFalloff::Linear => "Linear"
            BrushFalloff::Smooth => "Smooth"
            BrushFalloff::Sphere => "Sphere"
        kain_host__bridge__enum_variant_value("BrushFalloff", variant, [])


impl kain_host::FromKainValue for BrushFalloff:
    fn from_kain_value(value: kain_host::Value) -> kain_host::HostResult<BrushFalloff>:
        let (variant, fields) = kain_host__bridge__expect_enum(value, "BrushFalloff")?
        let fields = kain_host__bridge__expect_variant_len(fields, 0, "BrushFalloff", &variant)?
        let _ = fields
        match variant.as_str():
            "Constant" => Result::Ok(BrushFalloff__Constant)
            "Linear" => Result::Ok(BrushFalloff__Linear)
            "Smooth" => Result::Ok(BrushFalloff__Smooth)
            "Sphere" => Result::Ok(BrushFalloff__Sphere)
            _ => Result::Err(KainError__runtime(f"Unknown BrushFalloff variant `{variant}`"))


