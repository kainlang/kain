fn native_uv_sphere(_env: &mut kain_host::Env, args: Array<kain_host::Value>) -> kain_host::HostResult<kain_host::Value>:
    match args.as_slice():
        [radius, lat, lon] => Result::Ok(Geometry__uv_sphere(f32__from_kain_value(radius.clone())?, usize__from_kain_value(lat.clone())?, usize__from_kain_value(lon.clone())?).to_kain_value())
        _ => Result::Err(KainError__runtime("__zen3d_uv_sphere expects (Float, Int, Int)"))

fn native_quad_sphere(_env: &mut kain_host::Env, args: Array<kain_host::Value>) -> kain_host::HostResult<kain_host::Value>:
    match args.as_slice():
        [radius, resolution] => Result::Ok(Geometry__quad_sphere(f32__from_kain_value(radius.clone())?, usize__from_kain_value(resolution.clone())?).to_kain_value())
        _ => Result::Err(KainError__runtime("__zen3d_quad_sphere expects (Float, Int)"))

