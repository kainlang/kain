fn native_box_geometry(_env: &mut kain_host::Env, args: Array<kain_host::Value>) -> kain_host::HostResult<kain_host::Value>:
    let size = expect_single("__zen3d_box_geometry", args)?
    Result::Ok(Geometry__box_mesh(size).to_kain_value())

fn native_plane_geometry(_env: &mut kain_host::Env, args: Array<kain_host::Value>) -> kain_host::HostResult<kain_host::Value>:
