pub const KAIN_3D_MODULE_NAME: String = "zen3d"

pub struct Kain3dSession:
    host: kain_host::HostSession

impl Kain3dSession:
    pub fn new_() -> Kain3dSession:
        Kain3dSession { host: HostSession__new_() }

    pub fn host(_self: &Kain3dSession) -> &kain_host::HostSession:
        &(*_self).host

    pub fn host_mut(_self: &mut Kain3dSession) -> &mut kain_host::HostSession:
        &mut (*_self).host

    pub fn prelude_source(_self: &Kain3dSession) -> String:
        emit_kain_prelude()

    pub fn load_source(_self: &mut Kain3dSession, source: String) -> kain_host::HostResult<&mut Kain3dSession>:
        let full_source = f"{emit_kain_prelude()}\n{source}"
        (*_self).host.load_source(&full_source)?
        ()
        install_runtime_natives((*_self).host.env_mut())
        ()
        Result::Ok(*_self)

    pub fn call<R>(_self: &mut Kain3dSession, function_name: String, args: Array<kain_host::Value>) -> kain_host::HostResult<R>:
        (*_self).host.call(function_name, args)


impl Default for Kain3dSession:
    fn default_() -> Kain3dSession:
        Kain3dSession__new_()


pub fn install_runtime_natives(env: &mut kain_host::Env):
    env.register_native_fn("__zen3d_box_geometry", native_box_geometry)
    ()
    env.register_native_fn("__zen3d_plane_geometry", native_plane_geometry)
    ()
    env.register_native_fn("__zen3d_uv_sphere", native_uv_sphere)
    ()
    env.register_native_fn("__zen3d_quad_sphere", native_quad_sphere)
    ()
    env.register_native_fn("__zen3d_cylinder", native_cylinder)
    ()
    env.register_native_fn("__zen3d_cone", native_cone)
    ()
    env.register_native_fn("__zen3d_capsule", native_capsule)
    ()
    env.register_native_fn("__zen3d_torus", native_torus)
    ()
    env.register_native_fn("__zen3d_standard_material", native_standard_material)
    ()
    env.register_native_fn("__zen3d_matte_material", native_matte_material)
    ()
    env.register_native_fn("__zen3d_glossy_material", native_glossy_material)
    ()
    env.register_native_fn("__zen3d_orbit_camera", native_orbit_camera)
    ()
    env.register_native_fn("__zen3d_radial_field", native_radial_field)
    ()
    env.register_native_fn("__zen3d_twist", native_twist)
    ()
    env.register_native_fn("__zen3d_noise_displace", native_noise_displace)
    ()
    env.register_native_fn("__zen3d_brush", native_brush)
    ()

impl kain_host::ToKainValue for Vec2:
    fn to_kain_value(_self: Vec2) -> kain_host::Value:
        kain_host__bridge__struct_value("Vec2", [("x", _self.x.to_kain_value()), ("y", _self.y.to_kain_value())])


impl kain_host::FromKainValue for Vec2:
    fn from_kain_value(value: kain_host::Value) -> kain_host::HostResult<Vec2>:
        let mut fields = kain_host__bridge__expect_struct(value, "Vec2")?
        Result::Ok(Vec2 { x: kain_host__bridge__take_struct_field(&mut fields, "x")?, y: kain_host__bridge__take_struct_field(&mut fields, "y")? })


