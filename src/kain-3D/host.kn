fn native_twist(_env: &mut kain_host::Env, args: Array<kain_host::Value>) -> kain_host::HostResult<kain_host::Value>:
    match args.as_slice():
        [axis, angle] => Result::Ok(Modifier::Twist { axis: Vec3__from_kain_value(axis.clone())?, angle_radians: f32__from_kain_value(angle.clone())?, field: none }.to_kain_value())
        _ => Result::Err(KainError__runtime("__zen3d_twist expects (Vec3, Float)"))

fn native_noise_displace(_env: &mut kain_host::Env, args: Array<kain_host::Value>) -> kain_host::HostResult<kain_host::Value>:
    match args.as_slice():
        [amplitude, frequency] => Result::Ok(Modifier::NoiseDisplace { amplitude: f32__from_kain_value(amplitude.clone())?, frequency: f32__from_kain_value(frequency.clone())?, along_normal: true, field: none }.to_kain_value())
        _ => Result::Err(KainError__runtime("__zen3d_noise_displace expects (Float, Float)"))

fn native_brush(_env: &mut kain_host::Env, args: Array<kain_host::Value>) -> kain_host::HostResult<kain_host::Value>:
    match args.as_slice():
        [radius, strength] => Result::Ok((Brush { radius: f32__from_kain_value(radius.clone())?, strength: f32__from_kain_value(strength.clone())?, spacing: 0.15, falloff: BrushFalloff__Smooth }).to_kain_value())
        _ => Result::Err(KainError__runtime("__zen3d_brush expects (Float, Float)"))

fn expect_single<T>(name: String, args: Array<kain_host::Value>) -> kain_host::HostResult<T>:
    match args.as_slice():
        [value] => T__from_kain_value(value.clone())
        _ => Result::Err(KainError__runtime(f"{name} expects a single argument"))

