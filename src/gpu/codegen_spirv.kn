use kain_core::ast::BinaryOp

use kain_core::ast::Block

use kain_core::ast::CallArg

use kain_core::ast::ElseBranch

use kain_core::ast::Expr

use kain_core::ast::Pattern

use kain_core::ast::ShaderStage

use kain_core::ast::Stmt

use kain_core::ast::Type

use kain_core::ast::UnaryOp

use kain_core::error::KainError

use kain_core::error::KainResult

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

use kain_core::types::TypedShader

use rspirv::binary::Assemble

use rspirv::dr::Builder

use rspirv::dr::Operand

use rspirv::spirv::AddressingModel

use rspirv::spirv::Capability

use rspirv::spirv::Decoration

use rspirv::spirv::ExecutionMode

use rspirv::spirv::ExecutionModel

use rspirv::spirv::MemoryModel

use rspirv::spirv::StorageClass

use std::collections::HashMap

use std::collections::HashSet

pub fn generate(program: &kain_core::types::TypedProgram) -> Result<Array<u8>, KainError>:
    let mut builder = Builder__new_()
    let mut emitted_shaders = 0
    builder.capability(rspirv__spirv__Capability__Shader)
    ()
    builder.memory_model(rspirv__spirv__AddressingModel__Logical, rspirv__spirv__MemoryModel__GLSL450)
    ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Shader(shader_) =>
                emit_shader(&mut builder, shader_)?
                ()
                emitted_shaders = (emitted_shaders + 1)
                ()
            _ => ()
    ()
    let module = builder.module()
    if ((emitted_shaders == 0) || module.entry_points.is_empty()):
        return Result::Err(KainError__codegen(f"SPIR-V backend emitted no entry points for {emitted_shaders} typed shader item(s)", Span__default_()))
    let bytes: Array<u8> = module.assemble().iter().flat_map(fn(w): w.to_le_bytes()).collect()
    Result::Ok(bytes)

struct ShaderContext<a>:
    b: &mut a rspirv::dr::Builder
    vars: Map<String, VarBinding>
    output_var: Option<u32>
    struct_uniforms: Set<String>
    storage_buffers: Set<String>
    glsl_ext: Option<u32>
    loop_continue_targets: Array<u32>
    loop_break_targets: Array<u32>
    hoisted_vars: Map<String, Array<(u32, u32)>>

@derive(Clone)
struct VarBinding:
    id: u32
    ty: kain_core::ast::Type
    is_ptr: Bool

fn emit_shader(b: &mut rspirv::dr::Builder, shader_: &kain_core::types::TypedShader) -> Result<(), KainError>:
    let exec_model = match (*shader_).ast.stage:
        kain_core__ast__ShaderStage::Vertex => rspirv__spirv__ExecutionModel__Vertex
        kain_core__ast__ShaderStage::Fragment => rspirv__spirv__ExecutionModel__Fragment
        kain_core__ast__ShaderStage::Compute => rspirv__spirv__ExecutionModel__GLCompute
        kain_core__ast__ShaderStage::Surface => rspirv__spirv__ExecutionModel__Fragment
    let void_ = b.type_void()
    let fn_void_void = b.type_function(void_, [])
    let mut interface_vars = []
    let mut ctx_vars = HashMap__new_()
    let mut struct_uniforms = HashSet__new_()
    let mut storage_buffers = HashSet__new_()
    let mut storage_buffer_type_cache: Map<String, u32> = HashMap__new_()
    let mut uniform_wrapper_type_cache: Map<String, u32> = HashMap__new_()
    let mut compute_input_params: Array<(String, kain_core::ast::Type)> = Vec__new_()
    let mut local_size_values: [u32; 3] = [8, 8, 1]
    for selfhost_for_item in (*shader_).ast.inputs.iter().enumerate():
        let (i, param) = selfhost_for_item
        if (exec_model == rspirv__spirv__ExecutionModel__GLCompute):
            compute_input_params.push((param.name.clone(), param.ty.clone()))
            ()
            continue
        let ty = map_ast_type(b, &param.ty)
        let ptr_ty = b.type_pointer(none, rspirv__spirv__StorageClass__Input, ty)
        let var_ = b.variable(ptr_ty, none, rspirv__spirv__StorageClass__Input, none)
        b.decorate(var_, rspirv__spirv__Decoration__Location, [rspirv__dr__Operand::LiteralBit32(i as u32)])
        ()
        interface_vars.push(var_)
        ()
        ctx_vars.insert(param.name.clone(), VarBinding { id: var_, ty: param.ty.clone(), is_ptr: true })
        ()
    ()
    let output_var = if ((exec_model != rspirv__spirv__ExecutionModel__GLCompute) && (!is_void(&(*shader_).ast.outputs))):
        let output_ty = map_ast_type(b, &(*shader_).ast.outputs)
        let ptr_ty = b.type_pointer(none, rspirv__spirv__StorageClass__Output, output_ty)
        let var_ = b.variable(ptr_ty, none, rspirv__spirv__StorageClass__Output, none)
        if ((exec_model == rspirv__spirv__ExecutionModel__Vertex) && is_vec4(&(*shader_).ast.outputs)):
            b.decorate(var_, rspirv__spirv__Decoration__BuiltIn, [rspirv__dr__Operand::BuiltIn(rspirv__spirv__BuiltIn__Position)])
            ()
            ()
            ()
            ()
        else:
            b.decorate(var_, rspirv__spirv__Decoration__Location, [rspirv__dr__Operand::LiteralBit32(0)])
            ()
            ()
            ()
            ()
        interface_vars.push(var_)
        ()
        Option::Some(var_)
    else:
        none
    for uniform_ in &(*shader_).ast.uniforms:
        if (none && is_local_size_param(&uniform_.name)):
            let slot = match uniform_.name.as_str():
                "LOCAL_SIZE_X" => 0
                "LOCAL_SIZE_Y" => 1
                "LOCAL_SIZE_Z" => 2
                _ => 0
            let default_value = match slot:
                0 => 8
                1 => 8
                _ => 1
            local_size_values[slot] = default_value
            ()
            let uint_ty = b.type_int(32, 0)
            let const_id = b.constant_bit32(uint_ty, default_value)
            ctx_vars.insert(uniform_.name.clone(), VarBinding { id: const_id, ty: kain_core__ast__Type::Named { name: ("UInt").into(), generics: [], span: uniform_.span }, is_ptr: false })
            ()
            continue
        if is_permutation_param(&uniform_.name):
            match emit_permutation_spec_constant(b, &uniform_.ty, uniform_.binding):
                Some(spec_id) =>
                    ctx_vars.insert(uniform_.name.clone(), VarBinding { id: spec_id, ty: uniform_.ty.clone(), is_ptr: false })
                    ()
                    continue
                _ =>
                    ()
                    ()
            ()
        let is_sampler = match &uniform_.ty:
            kain_core__ast__Type::Named { name: name } if (name == "Sampler2D") => true
            _ => false
        if is_sampler:
            let inner_ty = map_ast_type(b, &uniform_.ty)
            let ptr_ty = b.type_pointer(none, rspirv__spirv__StorageClass__UniformConstant, inner_ty)
            let var_ = b.variable(ptr_ty, none, rspirv__spirv__StorageClass__UniformConstant, none)
            b.decorate(var_, rspirv__spirv__Decoration__DescriptorSet, [rspirv__dr__Operand::LiteralBit32(0)])
            ()
            b.decorate(var_, rspirv__spirv__Decoration__Binding, [rspirv__dr__Operand::LiteralBit32(uniform_.binding)])
            ()
            interface_vars.push(var_)
            ()
            ctx_vars.insert(uniform_.name.clone(), VarBinding { id: var_, ty: uniform_.ty.clone(), is_ptr: true })
            ()
        else:
            let is_storage_buffer = is_storage_buffer(&uniform_.ty)
            let (storage_class, pointee_ty) = if is_storage_buffer:
                (rspirv__spirv__StorageClass__StorageBuffer, get_or_create_storage_buffer_type(b, &uniform_.ty, &mut storage_buffer_type_cache))
            else:
                (rspirv__spirv__StorageClass__Uniform, get_or_create_uniform_wrapper_type(b, &uniform_.ty, &mut uniform_wrapper_type_cache))
            let ptr_ty = b.type_pointer(none, storage_class, pointee_ty)
            let var_ = b.variable(ptr_ty, none, storage_class, none)
            b.decorate(var_, rspirv__spirv__Decoration__DescriptorSet, [rspirv__dr__Operand::LiteralBit32(0)])
            ()
            b.decorate(var_, rspirv__spirv__Decoration__Binding, [rspirv__dr__Operand::LiteralBit32(uniform_.binding)])
            ()
            interface_vars.push(var_)
            ()
            ctx_vars.insert(uniform_.name.clone(), VarBinding { id: var_, ty: uniform_.ty.clone(), is_ptr: true })
            ()
            if is_storage_buffer:
                storage_buffers.insert(uniform_.name.clone())
                ()
            else:
                struct_uniforms.insert(uniform_.name.clone())
                ()
    ()
    if (exec_model == rspirv__spirv__ExecutionModel__GLCompute):
        let uint_ = b.type_int(32, 0)
        let uvec3 = b.type_vector(uint_, 3)
        let uvec3_ptr = b.type_pointer(none, rspirv__spirv__StorageClass__Input, uvec3)
        let uint_ptr = b.type_pointer(none, rspirv__spirv__StorageClass__Input, uint_)
        let gid = b.variable(uvec3_ptr, none, rspirv__spirv__StorageClass__Input, none)
        b.decorate(gid, rspirv__spirv__Decoration__BuiltIn, [rspirv__dr__Operand::BuiltIn(rspirv__spirv__BuiltIn__GlobalInvocationId)])
        ()
        interface_vars.push(gid)
        ()
        let lid = b.variable(uvec3_ptr, none, rspirv__spirv__StorageClass__Input, none)
        b.decorate(lid, rspirv__spirv__Decoration__BuiltIn, [rspirv__dr__Operand::BuiltIn(rspirv__spirv__BuiltIn__LocalInvocationId)])
        ()
        interface_vars.push(lid)
        ()
        let wid = b.variable(uvec3_ptr, none, rspirv__spirv__StorageClass__Input, none)
        b.decorate(wid, rspirv__spirv__Decoration__BuiltIn, [rspirv__dr__Operand::BuiltIn(rspirv__spirv__BuiltIn__WorkgroupId)])
        ()
        interface_vars.push(wid)
        ()
        let lindex = b.variable(uint_ptr, none, rspirv__spirv__StorageClass__Input, none)
        b.decorate(lindex, rspirv__spirv__Decoration__BuiltIn, [rspirv__dr__Operand::BuiltIn(rspirv__spirv__BuiltIn__LocalInvocationIndex)])
        ()
        interface_vars.push(lindex)
        ()
        let uvec3_ty = kain_core__ast__Type::Named { name: ("UVec3").into(), generics: [], span: (*shader_).ast.span }
        let uint_ty = kain_core__ast__Type::Named { name: ("UInt").into(), generics: [], span: (*shader_).ast.span }
        ctx_vars.insert(("global_invocation_id").into(), VarBinding { id: gid, ty: uvec3_ty.clone(), is_ptr: true })
        ()
        ctx_vars.insert(("local_invocation_id").into(), VarBinding { id: lid, ty: uvec3_ty.clone(), is_ptr: true })
        ()
        ctx_vars.insert(("workgroup_id").into(), VarBinding { id: wid, ty: uvec3_ty, is_ptr: true })
        ()
        ctx_vars.insert(("local_invocation_index").into(), VarBinding { id: lindex, ty: uint_ty.clone(), is_ptr: true })
        ()
        ctx_vars.insert(("dispatch_thread_id").into(), VarBinding { id: gid, ty: kain_core__ast__Type::Named { name: ("UVec3").into(), generics: [], span: (*shader_).ast.span }, is_ptr: true })
        ()
        ctx_vars.insert(("group_thread_id").into(), VarBinding { id: lid, ty: kain_core__ast__Type::Named { name: ("UVec3").into(), generics: [], span: (*shader_).ast.span }, is_ptr: true })
        ()
        ctx_vars.insert(("group_id").into(), VarBinding { id: wid, ty: kain_core__ast__Type::Named { name: ("UVec3").into(), generics: [], span: (*shader_).ast.span }, is_ptr: true })
        ()
        ctx_vars.insert(("group_index").into(), VarBinding { id: lindex, ty: uint_ty, is_ptr: true })
        ()
        for selfhost_for_item in compute_input_params.iter():
            let (name, ty) = selfhost_for_item
            let lowered = if (none):
                VarBinding { id: lindex, ty: ty.clone(), is_ptr: true }
            else:
                VarBinding { id: gid, ty: ty.clone(), is_ptr: true }
            ctx_vars.insert(name.clone(), lowered)
            ()
        ()
        ()
    let mut binding_types: Array<(String, kain_core::ast::Type)> = Vec__new_()
    let mut seed_known: Map<String, kain_core::ast::Type> = (*shader_).ast.inputs.iter().map(fn(p): (p.name.clone(), p.ty.clone())).collect()
    seed_known.extend((*shader_).ast.uniforms.iter().map(fn(u): (u.name.clone(), u.ty.clone())))
    ()
    if (exec_model == rspirv__spirv__ExecutionModel__GLCompute):
        let uvec3_ty = kain_core__ast__Type::Named { name: ("UVec3").into(), generics: [], span: (*shader_).ast.span }
        let uint_ty = kain_core__ast__Type::Named { name: ("UInt").into(), generics: [], span: (*shader_).ast.span }
        seed_known.insert(("global_invocation_id").into(), uvec3_ty.clone())
        ()
        seed_known.insert(("local_invocation_id").into(), uvec3_ty.clone())
        ()
        seed_known.insert(("workgroup_id").into(), uvec3_ty.clone())
        ()
        seed_known.insert(("dispatch_thread_id").into(), uvec3_ty.clone())
        ()
        seed_known.insert(("group_thread_id").into(), uvec3_ty.clone())
        ()
        seed_known.insert(("group_id").into(), uvec3_ty)
        ()
        seed_known.insert(("local_invocation_index").into(), uint_ty.clone())
        ()
        seed_known.insert(("group_index").into(), uint_ty)
        ()
        ()
        ()
        ()
    collect_binding_types_seeded(&(*shader_).ast.body, seed_known, &mut binding_types)
    ()
    let mut hoisted_vars: Map<String, Array<(u32, u32)>> = HashMap__new_()
    for selfhost_for_item in &binding_types:
        let (name, kain_ty) = selfhost_for_item
        let type_id = map_ast_type(b, kain_ty)
        let ptr_ty = b.type_pointer(none, rspirv__spirv__StorageClass__Function, type_id)
        hoisted_vars.entry(name.clone()).or_default().push((0, ptr_ty))
        ()
    ()
    let main_fn = b.begin_function(void_, none, rspirv__spirv__FunctionControl__NONE, fn_void_void).unwrap()
    b.begin_block(none).unwrap()
    ()
    for selfhost_for_item in hoisted_vars.iter_mut():
        let (name_2, slots) = selfhost_for_item
        for slot in slots.iter_mut():
            let var_id = b.variable(slot.field_1, none, rspirv__spirv__StorageClass__Function, none)
            slot.field_0 = var_id
            ()
    ()
    let mut ctx = ShaderContext { b: b, vars: ctx_vars, output_var: output_var, struct_uniforms: struct_uniforms, storage_buffers: storage_buffers, glsl_ext: none, loop_continue_targets: [], loop_break_targets: [], hoisted_vars: hoisted_vars }
    emit_block(&mut ctx, &(*shader_).ast.body)?
    ()
    if (*shader_).ast.body.stmts.last().map_or(true, fn(s): (!none)):
        ctx.b.ret().unwrap()
        ()
        ()
        ()
        ()
    ctx.b.end_function().unwrap()
    ()
    b.entry_point(exec_model, main_fn, &(*shader_).ast.name, interface_vars)
    ()
    if (exec_model == rspirv__spirv__ExecutionModel__Fragment):
        b.execution_mode(main_fn, rspirv__spirv__ExecutionMode__OriginUpperLeft, [])
        ()
        ()
        ()
        ()
    elif (exec_model == rspirv__spirv__ExecutionModel__GLCompute):
        b.execution_mode(main_fn, rspirv__spirv__ExecutionMode__LocalSize, local_size_values.to_vec())
        ()
        ()
        ()
        ()
    Result::Ok(())

fn get_or_create_storage_buffer_type(b: &mut rspirv::dr::Builder, buffer_ty: &kain_core::ast::Type, cache: &mut Map<String, u32>) -> u32:
    let key = f"storage:{type_cache_key(&storage_buffer_elem_type(buffer_ty, Span__default_()))}"
    match cache.get(&key):
        Some(existing) => return (*existing)
        _ =>
            ()
            ()
    let elem_type_ast = storage_buffer_elem_type(buffer_ty, Span__default_())
    let elem_ty = map_ast_type(b, &elem_type_ast)
    let rt_array = b.type_runtime_array(elem_ty)
    b.decorate(rt_array, rspirv__spirv__Decoration__ArrayStride, [rspirv__dr__Operand::LiteralBit32(storage_buffer_stride(buffer_ty))])
    ()
    let struct_ty = b.type_struct([rt_array])
    b.decorate(struct_ty, rspirv__spirv__Decoration__Block, [])
    ()
    b.member_decorate(struct_ty, 0, rspirv__spirv__Decoration__Offset, [rspirv__dr__Operand::LiteralBit32(0)])
    ()
    cache.insert(key, struct_ty)
    ()
    struct_ty

fn get_or_create_uniform_wrapper_type(b: &mut rspirv::dr::Builder, uniform_ty: &kain_core::ast::Type, cache: &mut Map<String, u32>) -> u32:
    let key = f"uniform:{type_cache_key(uniform_ty)}"
    match cache.get(&key):
        Some(existing) => return (*existing)
        _ =>
            ()
            ()
    let inner_ty = map_ast_type(b, uniform_ty)
    let struct_ty = b.type_struct([inner_ty])
    b.decorate(struct_ty, rspirv__spirv__Decoration__Block, [])
    ()
    b.member_decorate(struct_ty, 0, rspirv__spirv__Decoration__Offset, [rspirv__dr__Operand::LiteralBit32(0)])
    ()
    if (none):
        b.member_decorate(struct_ty, 0, rspirv__spirv__Decoration__ColMajor, [])
        ()
        b.member_decorate(struct_ty, 0, rspirv__spirv__Decoration__MatrixStride, [rspirv__dr__Operand::LiteralBit32(16)])
        ()
        ()
        ()
        ()
    cache.insert(key, struct_ty)
    ()
    struct_ty

fn type_cache_key(ty: &kain_core::ast::Type) -> String:
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } =>
            if generics.is_empty():
                name.clone()
            else:
                let inner = generics.iter().map(type_cache_key).collect().join(",")
                f"{name}<{inner}>"
        kain_core__ast__Type::Ref { inner: inner } => f"ref:{type_cache_key(inner)}"
        kain_core__ast__Type::Array(inner, size, _) => f"array:{type_cache_key(inner)}:{size}"
        kain_core__ast__Type::Slice(inner, _) => f"slice:{type_cache_key(inner)}"
        other => other

fn infer_numeric_result_type(left: Option<&kain_core::ast::Type>, right: Option<&kain_core::ast::Type>, span: kain_core::span::Span) -> Option<kain_core::ast::Type>:
    let left = left?
    let right = right?
    let left_dim = infer_numeric_dim(left)
    let right_dim = infer_numeric_dim(right)
    if ((left_dim == 0) && (right_dim == 0)):
        return none
    let out_dim = left_dim.max(right_dim).max(1)
    let scalar_name = if (is_uint_family_name(left) || is_uint_family_name(right)):
        "UInt"
    elif (is_int_family_name(left) || is_int_family_name(right)):
        "Int"
    else:
        "Float"
    Option::Some(if (out_dim == 1): kain_core__ast__Type::Named { name: scalar_name.into(), generics: [], span: span } else: infer_vec_type_from_scalar_name(scalar_name, out_dim, span))

fn infer_numeric_dim(ty: &kain_core::ast::Type) -> usize:
    match ty:
        kain_core__ast__Type::Named { name: name } =>
            match name.as_str():
                "Float" => 1
                "f32" => 1
                "Int" => 1
                "i32" => 1
                "UInt" => 1
                "u32" => 1
                "Bool" => 1
                "Vec2" => 2
                "IVec2" => 2
                "UVec2" => 2
                "Vec3" => 3
                "IVec3" => 3
                "UVec3" => 3
                "Vec4" => 4
                "IVec4" => 4
                "UVec4" => 4
                _ => 0
        _ => 0

fn is_uint_family_name(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if none => true
        _ => false

fn is_int_family_name(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if none => true
        _ => false

fn infer_vec_type_from_scalar_name(scalar_name: String, width: usize, span: kain_core::span::Span) -> kain_core::ast::Type:
    let name = match (scalar_name, width):
        ("UInt", 2) => "UVec2"
        ("UInt", 3) => "UVec3"
        ("UInt", _) => "UVec4"
        ("Int", 2) => "IVec2"
        ("Int", 3) => "IVec3"
        ("Int", _) => "IVec4"
        ("Float", 2) => "Vec2"
        ("Float", 3) => "Vec3"
        _ => "Vec4"
    kain_core__ast__Type::Named { name: name.into(), generics: [], span: span }

fn infer_single_expr_block_type(block: &kain_core::ast::Block, known: &Map<String, kain_core::ast::Type>) -> Option<kain_core::ast::Type>:
    if ((*block).stmts.len() != 1):
        return none
    match &(*block).stmts[0]:
        kain_core__ast__Stmt::Expr(expr) => infer_kain_type(expr, known)
        _ => none

fn infer_else_branch_type(else_branch: &kain_core::ast::ElseBranch, known: &Map<String, kain_core::ast::Type>) -> Option<kain_core::ast::Type>:
    match else_branch:
        kain_core__ast__ElseBranch::Else(block) => infer_single_expr_block_type(block, known)
        kain_core__ast__ElseBranch::ElseIf(_, then_block, nested) =>
            let then_ty = infer_single_expr_block_type(then_block, known)
            let nested_ty = nested.and_then(fn(next): infer_else_branch_type(next, known))
            infer_numeric_result_type(then_ty, nested_ty, then_block.span).or_(then_ty).or_(nested_ty)

impl<a> ShaderContext<a>:
    fn get_glsl_ext(_self: &mut ShaderContext<a>) -> u32:
        match (*_self).glsl_ext:
            Some(ext) => ext
            _ =>
                let ext = (*_self).b.ext_inst_import("GLSL.std.450")
                (*_self).glsl_ext = Option::Some(ext)
                ()
                ext


@doc(doc = " Pure AST type inference — no Builder calls. Returns KAIN Type for a let-binding RHS.")
@doc(doc = " Uses a known-names map to resolve Ident references from previously seen let-bindings.")
fn infer_kain_type(expr: &kain_core::ast::Expr, known: &Map<String, kain_core::ast::Type>) -> Option<kain_core::ast::Type>:
    let span = expr.span()
    let named = fn(n: String) -> kain_core::ast::Type: kain_core__ast__Type::Named { name: n.into(), generics: [], span: span }
    match expr:
        kain_core__ast__Expr::Float(_, _) => Option::Some(named("Float"))
        kain_core__ast__Expr::Int(_, _) => Option::Some(named("Int"))
        kain_core__ast__Expr::Bool(_, _) => Option::Some(named("Bool"))
        kain_core__ast__Expr::Ident(name, _) => known.get(name.as_str()).cloned()
        kain_core__ast__Expr::Unary { operand: operand } => infer_kain_type(operand, known)
        kain_core__ast__Expr::Paren(inner, _) => infer_kain_type(inner, known)
        kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
            match op:
                kain_core__ast__BinaryOp::Eq => Option::Some(named("Bool"))
                kain_core__ast__BinaryOp::Ne => Option::Some(named("Bool"))
                kain_core__ast__BinaryOp::Lt => Option::Some(named("Bool"))
                kain_core__ast__BinaryOp::Le => Option::Some(named("Bool"))
                kain_core__ast__BinaryOp::Gt => Option::Some(named("Bool"))
                kain_core__ast__BinaryOp::Ge => Option::Some(named("Bool"))
                kain_core__ast__BinaryOp::And => Option::Some(named("Bool"))
                kain_core__ast__BinaryOp::Or => Option::Some(named("Bool"))
                _ =>
                    let left_ty = infer_kain_type(left, known)
                    let right_ty = infer_kain_type(right, known)
                    infer_numeric_result_type(left_ty, right_ty, span).or_(left_ty).or_(right_ty)
        kain_core__ast__Expr::If { then_branch: then_branch, else_branch: else_branch } =>
            let then_ty = infer_single_expr_block_type(then_branch, known)
            let else_ty = else_branch.and_then(fn(eb): infer_else_branch_type(eb, known))
            infer_numeric_result_type(then_ty, else_ty, span).or_(then_ty).or_(else_ty)
        kain_core__ast__Expr::Cast { target: target } => Option::Some(target.clone())
        kain_core__ast__Expr::Field { object: object, field: field } =>
            let parent_ty = infer_kain_type(object, known)
            let elem_scalar = match parent_ty.and_then(fn(t): none):
                Some("IVec2") => "Int"
                Some("IVec3") => "Int"
                Some("IVec4") => "Int"
                Some("UVec2") => "UInt"
                Some("UVec3") => "UInt"
                Some("UVec4") => "UInt"
                _ => "Float"
            let elem_vec2 = match elem_scalar:
                "Int" => "IVec2"
                "UInt" => "UVec2"
                _ => "Vec2"
            let elem_vec3 = match elem_scalar:
                "Int" => "IVec3"
                "UInt" => "UVec3"
                _ => "Vec3"
            let elem_vec4 = match elem_scalar:
                "Int" => "IVec4"
                "UInt" => "UVec4"
                _ => "Vec4"
            match field.len():
                1 => Option::Some(named(elem_scalar))
                2 => Option::Some(named(elem_vec2))
                3 => Option::Some(named(elem_vec3))
                4 => Option::Some(named(elem_vec4))
                _ => parent_ty
        kain_core__ast__Expr::Call { callee: callee, args: args } =>
            match callee:
                kain_core__ast__Expr::Ident(fn_name, _) =>
                    match (fn_name.as_str(), args.len()):
                        ("vec2", n) if (n > 0) => Option::Some(named("Vec2"))
                        ("Vec2", n) if (n > 0) => Option::Some(named("Vec2"))
                        ("vec3", n) if (n > 0) => Option::Some(named("Vec3"))
                        ("Vec3", n) if (n > 0) => Option::Some(named("Vec3"))
                        ("vec4", n) if (n > 0) => Option::Some(named("Vec4"))
                        ("Vec4", n) if (n > 0) => Option::Some(named("Vec4"))
                        ("ivec2", n) if (n > 0) => Option::Some(named("IVec2"))
                        ("IVec2", n) if (n > 0) => Option::Some(named("IVec2"))
                        ("ivec3", n) if (n > 0) => Option::Some(named("IVec3"))
                        ("IVec3", n) if (n > 0) => Option::Some(named("IVec3"))
                        ("ivec4", n) if (n > 0) => Option::Some(named("IVec4"))
                        ("IVec4", n) if (n > 0) => Option::Some(named("IVec4"))
                        ("uvec2", n) if (n > 0) => Option::Some(named("UVec2"))
                        ("UVec2", n) if (n > 0) => Option::Some(named("UVec2"))
                        ("uvec3", n) if (n > 0) => Option::Some(named("UVec3"))
                        ("UVec3", n) if (n > 0) => Option::Some(named("UVec3"))
                        ("uvec4", n) if (n > 0) => Option::Some(named("UVec4"))
                        ("UVec4", n) if (n > 0) => Option::Some(named("UVec4"))
                        ("Float", 1) => Option::Some(named("Float"))
                        ("Int", 1) => Option::Some(named("Int"))
                        ("UInt", 1) => Option::Some(named("UInt"))
                        ("Bool", 1) => Option::Some(named("Bool"))
                        ("sin", 1) => infer_kain_type(&args[0].value, known)
                        ("cos", 1) => infer_kain_type(&args[0].value, known)
                        ("tan", 1) => infer_kain_type(&args[0].value, known)
                        ("asin", 1) => infer_kain_type(&args[0].value, known)
                        ("acos", 1) => infer_kain_type(&args[0].value, known)
                        ("atan", 1) => infer_kain_type(&args[0].value, known)
                        ("sqrt", 1) => infer_kain_type(&args[0].value, known)
                        ("abs", 1) => infer_kain_type(&args[0].value, known)
                        ("floor", 1) => infer_kain_type(&args[0].value, known)
                        ("ceil", 1) => infer_kain_type(&args[0].value, known)
                        ("fract", 1) => infer_kain_type(&args[0].value, known)
                        ("round", 1) => infer_kain_type(&args[0].value, known)
                        ("trunc", 1) => infer_kain_type(&args[0].value, known)
                        ("sign", 1) => infer_kain_type(&args[0].value, known)
                        ("exp", 1) => infer_kain_type(&args[0].value, known)
                        ("log", 1) => infer_kain_type(&args[0].value, known)
                        ("exp2", 1) => infer_kain_type(&args[0].value, known)
                        ("log2", 1) => infer_kain_type(&args[0].value, known)
                        ("inversesqrt", 1) => infer_kain_type(&args[0].value, known)
                        ("radians", 1) => infer_kain_type(&args[0].value, known)
                        ("degrees", 1) => infer_kain_type(&args[0].value, known)
                        ("pow", 2) => infer_kain_type(&args[0].value, known)
                        ("atan2", 2) => infer_kain_type(&args[0].value, known)
                        ("min", 2) => infer_kain_type(&args[0].value, known)
                        ("max", 2) => infer_kain_type(&args[0].value, known)
                        ("step", 2) => infer_kain_type(&args[0].value, known)
                        ("clamp", 3) => infer_kain_type(&args[0].value, known)
                        ("mix", 3) => infer_kain_type(&args[0].value, known)
                        ("smoothstep", 3) => infer_kain_type(&args[0].value, known)
                        ("length", _) => Option::Some(named("Float"))
                        ("distance", _) => Option::Some(named("Float"))
                        ("dot", _) => Option::Some(named("Float"))
                        ("normalize", _) => infer_kain_type(&args[0].value, known)
                        ("cross", _) => infer_kain_type(&args[0].value, known)
                        ("reflect", _) => infer_kain_type(&args[0].value, known)
                        ("refract", 3) => infer_kain_type(&args[0].value, known)
                        ("sample", _) => Option::Some(named("Vec4"))
                        ("sample_lod", _) => Option::Some(named("Vec4"))
                        _ => none
                _ =>
                    none
        kain_core__ast__Expr::Index { object: object } =>
            let object_ty = infer_kain_type(object, known)?
            match object_ty:
                kain_core__ast__Type::Named { name: name, generics: generics } if (name == "StorageBuffer") => generics.first().cloned().or_else(fn(): Option::Some(named("Float")))
                kain_core__ast__Type::Array(inner, _, _) => Option::Some(((*inner)).clone())
                kain_core__ast__Type::Slice(inner, _) => Option::Some(((*inner)).clone())
                _ => none
        _ => none

@doc(doc = " Pure AST walk — collects (binding_name, inferred_KainType) for every let in the block tree.")
@doc(doc = " No Builder interaction at all. Unknown types are mapped to Float as safe fallback.")
fn collect_binding_types(block: &kain_core::ast::Block, out_: &mut Array<(String, kain_core::ast::Type)>):
    let known: Map<String, kain_core::ast::Type> = HashMap__new_()
    collect_block_types(block, &mut known, out_)
    ()

fn collect_binding_types_seeded(block: &kain_core::ast::Block, seed: Map<String, kain_core::ast::Type>, out_: &mut Array<(String, kain_core::ast::Type)>):
    collect_block_types(block, &mut seed, out_)
    ()

enum VectorScalarKind:
    Float
    Int
    UInt

fn vector_ctor_spec(name: String) -> Option<(VectorScalarKind, usize, String)>:
    match name:
        "vec2" => Option::Some((VectorScalarKind__Float, 2, "Vec2"))
        "Vec2" => Option::Some((VectorScalarKind__Float, 2, "Vec2"))
        "vec3" => Option::Some((VectorScalarKind__Float, 3, "Vec3"))
        "Vec3" => Option::Some((VectorScalarKind__Float, 3, "Vec3"))
        "vec4" => Option::Some((VectorScalarKind__Float, 4, "Vec4"))
        "Vec4" => Option::Some((VectorScalarKind__Float, 4, "Vec4"))
        "ivec2" => Option::Some((VectorScalarKind__Int, 2, "IVec2"))
        "IVec2" => Option::Some((VectorScalarKind__Int, 2, "IVec2"))
        "ivec3" => Option::Some((VectorScalarKind__Int, 3, "IVec3"))
        "IVec3" => Option::Some((VectorScalarKind__Int, 3, "IVec3"))
        "ivec4" => Option::Some((VectorScalarKind__Int, 4, "IVec4"))
        "IVec4" => Option::Some((VectorScalarKind__Int, 4, "IVec4"))
        "uvec2" => Option::Some((VectorScalarKind__UInt, 2, "UVec2"))
        "UVec2" => Option::Some((VectorScalarKind__UInt, 2, "UVec2"))
        "uvec3" => Option::Some((VectorScalarKind__UInt, 3, "UVec3"))
        "UVec3" => Option::Some((VectorScalarKind__UInt, 3, "UVec3"))
        "uvec4" => Option::Some((VectorScalarKind__UInt, 4, "UVec4"))
        "UVec4" => Option::Some((VectorScalarKind__UInt, 4, "UVec4"))
        _ => none

fn cast_to_vector_scalar(ctx: &mut ShaderContext, value_id: u32, value_ty: &kain_core::ast::Type, scalar_kind: VectorScalarKind) -> u32:
    match scalar_kind:
        VectorScalarKind::Float => cast_to_f32(ctx, value_id, value_ty)
        VectorScalarKind::Int => cast_to_i32(ctx, value_id, value_ty)
        VectorScalarKind::UInt => cast_to_u32(ctx, value_id, value_ty)

fn scalar_spv_for_vector_kind(ctx: &mut ShaderContext, scalar_kind: VectorScalarKind) -> u32:
    match scalar_kind:
        VectorScalarKind::Float => (*ctx).b.type_float(32)
        VectorScalarKind::Int => (*ctx).b.type_int(32, 1)
        VectorScalarKind::UInt => (*ctx).b.type_int(32, 0)

fn emit_vector_constructor(ctx: &mut ShaderContext, expr: &kain_core::ast::Expr, scalar_kind: VectorScalarKind, width: usize, result_type_name: String, args: &[kain_core::ast::CallArg]) -> Result<(u32, kain_core::ast::Type), KainError>:
    let scalar_spv = scalar_spv_for_vector_kind(ctx, scalar_kind)
    let vector_spv = (*ctx).b.type_vector(scalar_spv, width as u32)
    let mut components = (fn(__kain_ctor_arg0): Vec__new_())(width)
    for arg in args:
        let (value_id, value_ty) = emit_expr(ctx, &arg.value)?
        let coerced = cast_to_vector_scalar(ctx, value_id, &value_ty, scalar_kind)
        let dim = numeric_dim(&value_ty)
        if (dim == 0):
            return Result::Err(KainError__codegen(f"Unsupported argument type '{value_ty}' for {result_type_name} constructor", expr.span()))
        if (dim == 1):
            components.push(coerced)
            ()
            continue
        for i in range(0, dim):
            let component_ = (*ctx).b.composite_extract(scalar_spv, none, coerced, [i as u32]).unwrap()
            components.push(component_)
            ()
    ()
    if (components.len() != width):
        return Result::Err(KainError__codegen(f"{result_type_name} constructor expects {width} scalar component(s), got {components.len()}", expr.span()))
    let res_id = (*ctx).b.composite_construct(vector_spv, none, components).unwrap()
    Result::Ok((res_id, kain_core__ast__Type::Named { name: result_type_name.into(), generics: [], span: expr.span() }))

fn internal_hoist_name(prefix: String, span: kain_core::span::Span) -> String:
    f"__{prefix}_{span.start}_{span.end}"

fn collect_block_types(block: &kain_core::ast::Block, known: &mut Map<String, kain_core::ast::Type>, out_: &mut Array<(String, kain_core::ast::Type)>):
    let float_ty = fn(span: kain_core::span::Span): kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: span }
    let int_ty = fn(span: kain_core::span::Span): kain_core__ast__Type::Named { name: ("Int").into(), generics: [], span: span }
    for stmt in &(*block).stmts:
        match stmt:
            kain_core__ast__Stmt::Let { pattern: pattern, value: value } =>
                match (pattern, value):
                    (kain_core__ast__Pattern::Binding { name: name }, Some(value)) =>
                        let span = value.span()
                        let ty = infer_kain_type(value, known).unwrap_or_else(fn(): float_ty(span))
                        known.insert(name.clone(), ty.clone())
                        ()
                        out_.push((name.clone(), ty))
                        ()
                    _ => ()
            kain_core__ast__Stmt::Expr(kain_core__ast__Expr::If { then_branch: then_branch, else_branch: else_branch }) =>
                collect_block_types(then_branch, known, out_)
                ()
                match else_branch:
                    Some(eb) =>
                        match eb:
                            kain_core__ast__ElseBranch::Else(blk) => collect_block_types(blk, known, out_)
                            kain_core__ast__ElseBranch::ElseIf(_, blk, next) =>
                                collect_block_types(blk, known, out_)
                                ()
                                match next:
                                    Some(nb) =>
                                        match nb:
                                            kain_core__ast__ElseBranch::Else(b2) =>
                                                collect_block_types(b2, known, out_)
                                                ()
                                            _ => ()
                                    _ => ()
                    _ => ()
            kain_core__ast__Stmt::While { body: body } => collect_block_types(body, known, out_)
            kain_core__ast__Stmt::For { body: body, span: span } =>
                out_.push((internal_hoist_name("for_iter", (*span)), int_ty((*span))))
                ()
                out_.push((internal_hoist_name("for_end", (*span)), int_ty((*span))))
                ()
                collect_block_types(body, known, out_)
            kain_core__ast__Stmt::Loop { body: body } => collect_block_types(body, known, out_)
            _ => ()

fn take_hoisted_slot(ctx: &mut ShaderContext, name: String, ptr_ty: u32) -> Option<u32>:
    (*ctx).hoisted_vars.get_mut(name).and_then(fn(slots): none)

fn emit_block(ctx: &mut ShaderContext, block: &kain_core::ast::Block) -> Result<(), KainError>:
    for stmt in &(*block).stmts:
        match stmt:
            kain_core__ast__Stmt::Return(expr, _) =>
                match expr:
                    Some(expr) =>
                        match (*ctx).output_var:
                            Some(out_var) =>
                                let (val, _) = emit_expr(ctx, expr)?
                                (*ctx).b.store(out_var, val, none, []).unwrap()
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                (*ctx).b.ret().unwrap()
                ()
            kain_core__ast__Stmt::Let { pattern: pattern, value: value } =>
                match value:
                    Some(value) =>
                        let (val, ty) = emit_expr(ctx, value)?
                        match pattern:
                            kain_core__ast__Pattern::Binding { name: name } =>
                                let type_id = map_ast_type((*ctx).b, &ty)
                                let ptr_ty = (*ctx).b.type_pointer(none, rspirv__spirv__StorageClass__Function, type_id)
                                let local_var = take_hoisted_slot(ctx, name, ptr_ty).unwrap_or_else(fn(): (*ctx).b.variable(ptr_ty, none, rspirv__spirv__StorageClass__Function, none))
                                (*ctx).b.store(local_var, val, none, std__iter__empty()).unwrap()
                                ()
                                (*ctx).vars.insert(name.clone(), VarBinding { id: local_var, ty: ty, is_ptr: true })
                                ()
                            _ => ()
                    _ => ()
            kain_core__ast__Stmt::Expr(expr) =>
                match expr:
                    kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                        emit_if_statement(ctx, condition, then_branch, else_branch)?
                        ()
                    _ =>
                        emit_expr(ctx, expr)?
                        ()
            kain_core__ast__Stmt::While { condition: condition, body: body } =>
                emit_while_statement(ctx, condition, body)?
                ()
            kain_core__ast__Stmt::For { binding: binding, iter: iter, body: body, span: span } =>
                emit_for_statement(ctx, binding, iter, body, (*span))?
                ()
            kain_core__ast__Stmt::Break(_, span) =>
                let break_target = (*ctx).loop_break_targets.last().copied().ok_or_else(fn(): KainError__codegen("break outside loop", (*span)))?
                terminate_with_branch(ctx, break_target)?
                ()
                let cont_label = (*ctx).b.id()
                (*ctx).b.begin_block(Option::Some(cont_label)).unwrap()
                ()
            kain_core__ast__Stmt::Continue(span) =>
                let continue_target = (*ctx).loop_continue_targets.last().copied().ok_or_else(fn(): KainError__codegen("continue outside loop", (*span)))?
                terminate_with_branch(ctx, continue_target)?
                ()
                let cont_label = (*ctx).b.id()
                (*ctx).b.begin_block(Option::Some(cont_label)).unwrap()
                ()
            _ => ()
    ()
    Result::Ok(())

fn emit_expr(ctx: &mut ShaderContext, expr: &kain_core::ast::Expr) -> Result<(u32, kain_core::ast::Type), KainError>:
    match expr:
        kain_core__ast__Expr::Ident(name, span) =>
            match (*ctx).vars.get(name).cloned():
                Some(binding) =>
                    if binding.is_ptr:
                        if is_storage_buffer(&binding.ty):
                            return Result::Ok((binding.id, binding.ty))
                        let type_id = map_ast_type((*ctx).b, &binding.ty)
                        if (*ctx).struct_uniforms.contains(name):
                            let ptr_ty = (*ctx).b.type_pointer(none, rspirv__spirv__StorageClass__Uniform, type_id)
                            let int_ty = (*ctx).b.type_int(32, 0)
                            let zero = (*ctx).b.constant_bit32(int_ty, 0)
                            let member_ptr = (*ctx).b.access_chain(ptr_ty, none, binding.id, [zero]).unwrap()
                            let val_id = (*ctx).b.load(type_id, none, member_ptr, none, std__iter__empty()).unwrap()
                            Result::Ok((val_id, binding.ty))
                        else:
                            let val_id = (*ctx).b.load(type_id, none, binding.id, none, std__iter__empty()).unwrap()
                            Result::Ok((val_id, binding.ty))
                    else:
                        Result::Ok((binding.id, binding.ty))
                _ => Result::Err(KainError__codegen(f"Unknown variable: {name}", (*span)))
        kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
            let (lhs, lhs_ty) = emit_expr(ctx, left)?
            let (rhs, rhs_ty) = emit_expr(ctx, right)?
            let res_ty_id = map_ast_type((*ctx).b, &lhs_ty)
            let mut result_ty_override: Option<kain_core::ast::Type> = none
            let res_id = match op:
                kain_core__ast__BinaryOp::Mul =>
                    if (is_mat4(&lhs_ty) && is_mat4(&rhs_ty)):
                        (*ctx).b.matrix_times_matrix(res_ty_id, none, lhs, rhs).unwrap()
                    elif (is_mat4(&lhs_ty) && is_vec4(&rhs_ty)):
                        let vec4_ty = map_ast_type((*ctx).b, &rhs_ty)
                        (*ctx).b.matrix_times_vector(vec4_ty, none, lhs, rhs).unwrap()
                    elif (is_vec4(&lhs_ty) && is_mat4(&rhs_ty)):
                        let vec4_ty = map_ast_type((*ctx).b, &lhs_ty)
                        (*ctx).b.vector_times_matrix(vec4_ty, none, lhs, rhs).unwrap()
                    elif (is_float(&lhs_ty) && is_float(&rhs_ty)):
                        (*ctx).b.f_mul(res_ty_id, none, lhs, rhs).unwrap()
                    elif (is_uint(&lhs_ty) || is_uint(&rhs_ty)):
                        let uint_ty = (*ctx).b.type_int(32, 0)
                        let lhs_u = cast_to_u32(ctx, lhs, &lhs_ty)
                        let rhs_u = cast_to_u32(ctx, rhs, &rhs_ty)
                        result_ty_override = Option::Some(kain_core__ast__Type::Named { name: ("UInt").into(), generics: [], span: expr.span() })
                        ()
                        (*ctx).b.i_mul(uint_ty, none, lhs_u, rhs_u).unwrap()
                    elif (is_int(&lhs_ty) || is_int(&rhs_ty)):
                        let int_ty = (*ctx).b.type_int(32, 1)
                        let lhs_i = cast_to_i32(ctx, lhs, &lhs_ty)
                        let rhs_i = cast_to_i32(ctx, rhs, &rhs_ty)
                        result_ty_override = Option::Some(kain_core__ast__Type::Named { name: ("Int").into(), generics: [], span: expr.span() })
                        ()
                        (*ctx).b.i_mul(int_ty, none, lhs_i, rhs_i).unwrap()
                    else:
                        let (lhs_f, rhs_f, out_ty) = coerce_float_binary_operands(ctx, lhs, &lhs_ty, rhs, &rhs_ty)
                        result_ty_override = Option::Some(out_ty.clone())
                        ()
                        let out_ty_id = map_ast_type((*ctx).b, &out_ty)
                        (*ctx).b.f_mul(out_ty_id, none, lhs_f, rhs_f).unwrap()
                kain_core__ast__BinaryOp::Add =>
                    if (is_uint(&lhs_ty) || is_uint(&rhs_ty)):
                        let uint_ty = (*ctx).b.type_int(32, 0)
                        let lhs_u = cast_to_u32(ctx, lhs, &lhs_ty)
                        let rhs_u = cast_to_u32(ctx, rhs, &rhs_ty)
                        result_ty_override = Option::Some(kain_core__ast__Type::Named { name: ("UInt").into(), generics: [], span: expr.span() })
                        ()
                        (*ctx).b.i_add(uint_ty, none, lhs_u, rhs_u).unwrap()
                    elif (is_int(&lhs_ty) || is_int(&rhs_ty)):
                        let int_ty = (*ctx).b.type_int(32, 1)
                        let lhs_i = cast_to_i32(ctx, lhs, &lhs_ty)
                        let rhs_i = cast_to_i32(ctx, rhs, &rhs_ty)
                        result_ty_override = Option::Some(kain_core__ast__Type::Named { name: ("Int").into(), generics: [], span: expr.span() })
                        ()
                        (*ctx).b.i_add(int_ty, none, lhs_i, rhs_i).unwrap()
                    else:
                        let (lhs_f, rhs_f, out_ty) = coerce_float_binary_operands(ctx, lhs, &lhs_ty, rhs, &rhs_ty)
                        result_ty_override = Option::Some(out_ty.clone())
                        ()
                        let out_ty_id = map_ast_type((*ctx).b, &out_ty)
                        (*ctx).b.f_add(out_ty_id, none, lhs_f, rhs_f).unwrap()
                kain_core__ast__BinaryOp::Sub =>
                    if (is_uint(&lhs_ty) || is_uint(&rhs_ty)):
                        let uint_ty = (*ctx).b.type_int(32, 0)
                        let lhs_u = cast_to_u32(ctx, lhs, &lhs_ty)
                        let rhs_u = cast_to_u32(ctx, rhs, &rhs_ty)
                        result_ty_override = Option::Some(kain_core__ast__Type::Named { name: ("UInt").into(), generics: [], span: expr.span() })
                        ()
                        (*ctx).b.i_sub(uint_ty, none, lhs_u, rhs_u).unwrap()
                    elif (is_int(&lhs_ty) || is_int(&rhs_ty)):
                        let int_ty = (*ctx).b.type_int(32, 1)
                        let lhs_i = cast_to_i32(ctx, lhs, &lhs_ty)
                        let rhs_i = cast_to_i32(ctx, rhs, &rhs_ty)
                        result_ty_override = Option::Some(kain_core__ast__Type::Named { name: ("Int").into(), generics: [], span: expr.span() })
                        ()
                        (*ctx).b.i_sub(int_ty, none, lhs_i, rhs_i).unwrap()
                    else:
                        let (lhs_f, rhs_f, out_ty) = coerce_float_binary_operands(ctx, lhs, &lhs_ty, rhs, &rhs_ty)
                        result_ty_override = Option::Some(out_ty.clone())
                        ()
                        let out_ty_id = map_ast_type((*ctx).b, &out_ty)
                        (*ctx).b.f_sub(out_ty_id, none, lhs_f, rhs_f).unwrap()
                kain_core__ast__BinaryOp::Div =>
                    if (is_uint(&lhs_ty) || is_uint(&rhs_ty)):
                        let uint_ty = (*ctx).b.type_int(32, 0)
                        let lhs_u = cast_to_u32(ctx, lhs, &lhs_ty)
                        let rhs_u = cast_to_u32(ctx, rhs, &rhs_ty)
                        result_ty_override = Option::Some(kain_core__ast__Type::Named { name: ("UInt").into(), generics: [], span: expr.span() })
                        ()
                        (*ctx).b.u_div(uint_ty, none, lhs_u, rhs_u).unwrap()
                    elif (is_int(&lhs_ty) || is_int(&rhs_ty)):
                        let int_ty = (*ctx).b.type_int(32, 1)
                        let lhs_i = cast_to_i32(ctx, lhs, &lhs_ty)
                        let rhs_i = cast_to_i32(ctx, rhs, &rhs_ty)
