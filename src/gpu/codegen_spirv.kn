                            return Result::Ok((res_id, ty))
                        "degrees" if (args.len() == 1) =>
                            let (val, ty) = emit_expr(ctx, &args[0].value)?
                            let res_ty = map_ast_type((*ctx).b, &ty)
                            let glsl = ctx.get_glsl_ext()
                            let res_id = (*ctx).b.ext_inst(res_ty, none, glsl, 12, [rspirv__dr__Operand::IdRef(val)]).unwrap()
                            return Result::Ok((res_id, ty))
                        "exp" if (args.len() == 1) =>
                            let (val, ty) = emit_expr(ctx, &args[0].value)?
                            let res_ty = map_ast_type((*ctx).b, &ty)
                            let glsl = ctx.get_glsl_ext()
                            let res_id = (*ctx).b.ext_inst(res_ty, none, glsl, 27, [rspirv__dr__Operand::IdRef(val)]).unwrap()
                            return Result::Ok((res_id, ty))
                        "log" if (args.len() == 1) =>
                            let (val, ty) = emit_expr(ctx, &args[0].value)?
                            let res_ty = map_ast_type((*ctx).b, &ty)
                            let glsl = ctx.get_glsl_ext()
                            let res_id = (*ctx).b.ext_inst(res_ty, none, glsl, 28, [rspirv__dr__Operand::IdRef(val)]).unwrap()
                            return Result::Ok((res_id, ty))
                        "exp2" if (args.len() == 1) =>
                            let (val, ty) = emit_expr(ctx, &args[0].value)?
                            let res_ty = map_ast_type((*ctx).b, &ty)
                            let glsl = ctx.get_glsl_ext()
                            let res_id = (*ctx).b.ext_inst(res_ty, none, glsl, 29, [rspirv__dr__Operand::IdRef(val)]).unwrap()
                            return Result::Ok((res_id, ty))
                        "log2" if (args.len() == 1) =>
                            let (val, ty) = emit_expr(ctx, &args[0].value)?
                            let res_ty = map_ast_type((*ctx).b, &ty)
                            let glsl = ctx.get_glsl_ext()
                            let res_id = (*ctx).b.ext_inst(res_ty, none, glsl, 30, [rspirv__dr__Operand::IdRef(val)]).unwrap()
                            return Result::Ok((res_id, ty))
                        "inversesqrt" if (args.len() == 1) =>
                            let (val, ty) = emit_expr(ctx, &args[0].value)?
                            let res_ty = map_ast_type((*ctx).b, &ty)
                            let glsl = ctx.get_glsl_ext()
                            let res_id = (*ctx).b.ext_inst(res_ty, none, glsl, 32, [rspirv__dr__Operand::IdRef(val)]).unwrap()
                            return Result::Ok((res_id, ty))
                        "mod" if (args.len() == 2) =>
                            let (x, ty) = emit_expr(ctx, &args[0].value)?
                            let (y, _) = emit_expr(ctx, &args[1].value)?
                            let res_ty = map_ast_type((*ctx).b, &ty)
                            let res_id = (*ctx).b.f_mod(res_ty, none, x, y).unwrap()
                            return Result::Ok((res_id, ty))
                        "distance" if (args.len() == 2) =>
                            let (a, _) = emit_expr(ctx, &args[0].value)?
                            let (b, _) = emit_expr(ctx, &args[1].value)?
                            let glsl = ctx.get_glsl_ext()
                            let res_id = (*ctx).b.ext_inst(float_, none, glsl, 67, [rspirv__dr__Operand::IdRef(a), rspirv__dr__Operand::IdRef(b)]).unwrap()
                            return Result::Ok((res_id, kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: expr.span() }))
                        "refract" if (args.len() == 3) =>
                            let (i, ty) = emit_expr(ctx, &args[0].value)?
                            let (n, _) = emit_expr(ctx, &args[1].value)?
                            let (eta, _) = emit_expr(ctx, &args[2].value)?
                            let res_ty = map_ast_type((*ctx).b, &ty)
                            let glsl = ctx.get_glsl_ext()
                            let res_id = (*ctx).b.ext_inst(res_ty, none, glsl, 72, [rspirv__dr__Operand::IdRef(i), rspirv__dr__Operand::IdRef(n), rspirv__dr__Operand::IdRef(eta)]).unwrap()
                            return Result::Ok((res_id, ty))
                        "sample" if (args.len() == 2) =>
                            let (sampler_, _) = emit_expr(ctx, &args[0].value)?
                            let (coords, _) = emit_expr(ctx, &args[1].value)?
                            let vec4 = (*ctx).b.type_vector(float_, 4)
                            let res_id = (*ctx).b.image_sample_implicit_lod(vec4, none, sampler_, coords, none, std__iter__empty()).unwrap()
                            return Result::Ok((res_id, kain_core__ast__Type::Named { name: ("Vec4").into(), generics: [], span: expr.span() }))
                        "sample_lod" if (args.len() == 3) =>
                            let (sampler_, _) = emit_expr(ctx, &args[0].value)?
                            let (coords, _) = emit_expr(ctx, &args[1].value)?
                            let (lod, _) = emit_expr(ctx, &args[2].value)?
                            let vec4 = (*ctx).b.type_vector(float_, 4)
                            let res_id = (*ctx).b.image_sample_explicit_lod(vec4, none, sampler_, coords, rspirv__spirv__ImageOperands__LOD, [rspirv__dr__Operand::IdRef(lod)]).unwrap()
                            return Result::Ok((res_id, kain_core__ast__Type::Named { name: ("Vec4").into(), generics: [], span: expr.span() }))
                        _ => ()
                    ()
                _ =>
                    ()
                    ()
            let callee_name = match &(*(*callee)):
                kain_core__ast__Expr::Ident(name, _) => name.clone()
                _ => ("<complex expression>").to_string()
            Result::Err(KainError__codegen(f"Unsupported function call in shader: '{callee_name}'", expr.span()))
        kain_core__ast__Expr::Float(f, span) =>
            let float_ = (*ctx).b.type_float(32)
            let val = (*ctx).b.constant_bit32(float_, ((*f) as f32).to_bits())
            Result::Ok((val, kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: (*span) }))
        kain_core__ast__Expr::Int(i, span) =>
            let int_ = (*ctx).b.type_int(32, 1)
            let val = (*ctx).b.constant_bit32(int_, (*i) as u32)
            Result::Ok((val, kain_core__ast__Type::Named { name: ("Int").into(), generics: [], span: (*span) }))
        kain_core__ast__Expr::Bool(v, span) =>
            let bool_ty = (*ctx).b.type_bool()
            let bool_id = if (*v):
                (*ctx).b.constant_true(bool_ty)
            else:
                (*ctx).b.constant_false(bool_ty)
            Result::Ok((bool_id, kain_core__ast__Type::Named { name: ("Bool").into(), generics: [], span: (*span) }))
        kain_core__ast__Expr::Paren(inner, _) => emit_expr(ctx, inner)
        kain_core__ast__Expr::Cast { value: value, target: target, span: span } =>
            let (src_val, src_ty) = emit_expr(ctx, value)?
            let dst_ty = target.clone()
            let dst_ty_id = map_ast_type((*ctx).b, &dst_ty)
            if is_same_type_family(&src_ty, &dst_ty):
                return Result::Ok((src_val, dst_ty))
            if is_bool(&dst_ty):
                let as_b = as_bool(ctx, src_val, &src_ty)
                return Result::Ok((as_b, dst_ty))
            if is_bool(&src_ty):
                let src_b = as_bool(ctx, src_val, &src_ty)
                let out_ = if (is_float(&dst_ty) || is_float_vector(&dst_ty)):
                    let one = float_one((*ctx).b, &dst_ty)
                    let zero = float_zero((*ctx).b, &dst_ty)
                    (*ctx).b.select(dst_ty_id, none, src_b, one, zero).unwrap()
                elif is_uint_like(&dst_ty):
                    let one = uint_one((*ctx).b, &dst_ty)
                    let zero = uint_zero((*ctx).b, &dst_ty)
                    (*ctx).b.select(dst_ty_id, none, src_b, one, zero).unwrap()
                elif is_int_like(&dst_ty):
                    let one = int_one((*ctx).b, &dst_ty)
                    let zero = int_zero((*ctx).b, &dst_ty)
                    (*ctx).b.select(dst_ty_id, none, src_b, one, zero).unwrap()
                else:
                    return Result::Err(KainError__codegen("Unsupported bool cast target in shader", (*span)))
                return Result::Ok((out_, dst_ty))
            let src_dim = numeric_dim(&src_ty)
            let dst_dim = numeric_dim(&dst_ty)
            if (((src_dim == 0) || (dst_dim == 0)) || (src_dim != dst_dim)):
                return Result::Err(KainError__codegen("Invalid cast in shader: source/target dimensions or categories are incompatible", (*span)))
            let converted = if (is_float_like(&src_ty) && is_int_like(&dst_ty)):
                (*ctx).b.convert_f_to_s(dst_ty_id, none, src_val).unwrap()
            elif (is_float_like(&src_ty) && is_uint_like(&dst_ty)):
                (*ctx).b.convert_f_to_u(dst_ty_id, none, src_val).unwrap()
            elif (is_int_like(&src_ty) && is_float_like(&dst_ty)):
                (*ctx).b.convert_s_to_f(dst_ty_id, none, src_val).unwrap()
            elif (is_uint_like(&src_ty) && is_float_like(&dst_ty)):
                (*ctx).b.convert_u_to_f(dst_ty_id, none, src_val).unwrap()
            elif (is_int_like(&src_ty) && is_uint_like(&dst_ty)):
                (*ctx).b.bitcast(dst_ty_id, none, src_val).unwrap()
            elif (is_uint_like(&src_ty) && is_int_like(&dst_ty)):
                (*ctx).b.bitcast(dst_ty_id, none, src_val).unwrap()
            elif (is_int_like(&src_ty) && is_int_like(&dst_ty)):
                (*ctx).b.s_convert(dst_ty_id, none, src_val).unwrap()
            elif (is_uint_like(&src_ty) && is_uint_like(&dst_ty)):
                (*ctx).b.u_convert(dst_ty_id, none, src_val).unwrap()
            else:
                return Result::Err(KainError__codegen("Unsupported numeric cast in shader", (*span)))
            Result::Ok((converted, dst_ty))
        kain_core__ast__Expr::Assign { target: target, value: value } =>
            let (next_val, next_ty) = emit_expr(ctx, value)?
            match target:
                kain_core__ast__Expr::Ident(name, span) =>
                    match (*ctx).vars.get(name).cloned():
                        Some(binding) =>
                            if (!binding.is_ptr):
                                return Result::Err(KainError__codegen(f"Cannot assign to immutable value '{name}'", (*span)))
                            if is_storage_buffer(&binding.ty):
                                return Result::Err(KainError__codegen(f"Assigning a whole storage buffer '{name}' is not supported", (*span)))
                            (*ctx).b.store(binding.id, next_val, none, std__iter__empty()).unwrap()
                            ()
                            Result::Ok((next_val, next_ty))
                        _ => Result::Err(KainError__codegen(f"Unknown assignment target: {name}", (*span)))
                kain_core__ast__Expr::Index { object: object, index: index } =>
                    let elem_ptr = emit_index_lvalue_ptr(ctx, object, index, &next_ty, target.span())?
                    (*ctx).b.store(elem_ptr, next_val, none, std__iter__empty()).unwrap()
                    ()
                    Result::Ok((next_val, next_ty))
                _ => Result::Err(KainError__codegen("Unsupported assignment target in shader", target.span()))
        kain_core__ast__Expr::Index { object: object, index: index } =>
            match object:
                kain_core__ast__Expr::Ident(buffer_name, span) =>
                    if (*ctx).storage_buffers.contains(buffer_name):
                        let binding = (*ctx).vars.get(buffer_name).cloned().ok_or_else(fn(): KainError__codegen(f"Unknown storage buffer: {buffer_name}", (*span)))?
                        let (index_raw_id, index_raw_ty) = emit_expr(ctx, index)?
                        let index_id = coerce_to_u32_index(ctx, index_raw_id, &index_raw_ty, expr.span())?
                        let elem_ty = storage_buffer_elem_type(&binding.ty, expr.span())
                        let elem_ty_id = map_ast_type((*ctx).b, &elem_ty)
                        let elem_ptr_ty = (*ctx).b.type_pointer(none, rspirv__spirv__StorageClass__StorageBuffer, elem_ty_id)
                        let uint_ty = (*ctx).b.type_int(32, 0)
                        let zero = (*ctx).b.constant_bit32(uint_ty, 0)
                        let elem_ptr = (*ctx).b.access_chain(elem_ptr_ty, none, binding.id, [zero, index_id]).unwrap()
                        let loaded = (*ctx).b.load(elem_ty_id, none, elem_ptr, none, std__iter__empty()).unwrap()
                        return Result::Ok((loaded, elem_ty))
                    ()
                _ =>
                    ()
                    ()
            Result::Err(KainError__codegen("Unsupported index expression in shader", expr.span()))
        kain_core__ast__Expr::Field { object: object, field: field, span: span } =>
            let (obj_id, obj_ty) = emit_expr(ctx, object)?
            match swizzle_indices(field):
                Some(indices) =>
                    let scalar_ty = vector_scalar_type(ctx, &obj_ty)
                    let scalar_spv = map_ast_type((*ctx).b, &scalar_ty)
                    if (indices.len() == 1):
                        let res_id = (*ctx).b.composite_extract(scalar_spv, none, obj_id, [indices[0]]).unwrap()
                        return Result::Ok((res_id, scalar_ty))
                    let swizzle_len = indices.len()
                    let out_vec = (*ctx).b.type_vector(scalar_spv, swizzle_len as u32)
                    let res_id = (*ctx).b.vector_shuffle(out_vec, none, obj_id, obj_id, indices).unwrap()
                    return Result::Ok((res_id, vec_type_from_scalar(&scalar_ty, swizzle_len, (*span))))
                _ =>
                    ()
                    ()
            Result::Err(KainError__codegen(f"Unsupported field access: {field}", (*span)))
        kain_core__ast__Expr::Unary { op: op, operand: operand } =>
            let (val, ty) = emit_expr(ctx, operand)?
            let ty_id = map_ast_type((*ctx).b, &ty)
            let out_ = match op:
                kain_core__ast__UnaryOp::Neg => if is_float_like(&ty): (*ctx).b.f_negate(ty_id, none, val).unwrap() else: (*ctx).b.s_negate(ty_id, none, val).unwrap()
                kain_core__ast__UnaryOp::Not =>
                    let bool_ty = (*ctx).b.type_bool()
                    let b = as_bool(ctx, val, &ty)
                    return Result::Ok(((*ctx).b.logical_not(bool_ty, none, b).unwrap(), kain_core__ast__Type::Named { name: ("Bool").into(), generics: [], span: expr.span() }))
                kain_core__ast__UnaryOp::BitNot => (*ctx).b.not(ty_id, none, val).unwrap()
                kain_core__ast__UnaryOp::Ref => val
                kain_core__ast__UnaryOp::RefMut => val
                kain_core__ast__UnaryOp::Deref => val
            Result::Ok((out_, ty))
        kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args, span: span } =>
            let (recv_val, recv_ty) = emit_expr(ctx, receiver)?
            let float_ = (*ctx).b.type_float(32)
            match method.as_str():
                "length" if args.is_empty() =>
                    let glsl = ctx.get_glsl_ext()
                    let id = (*ctx).b.ext_inst(float_, none, glsl, 66, [rspirv__dr__Operand::IdRef(recv_val)]).unwrap()
                    Result::Ok((id, kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: (*span) }))
                "normalize" if args.is_empty() =>
                    let res_ty = map_ast_type((*ctx).b, &recv_ty)
                    let glsl = ctx.get_glsl_ext()
                    let id = (*ctx).b.ext_inst(res_ty, none, glsl, 69, [rspirv__dr__Operand::IdRef(recv_val)]).unwrap()
                    Result::Ok((id, recv_ty))
                "dot" if (args.len() == 1) =>
                    let (rhs, _) = emit_expr(ctx, &args[0].value)?
                    let id = (*ctx).b.dot(float_, none, recv_val, rhs).unwrap()
                    Result::Ok((id, kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: (*span) }))
                "cross" if (args.len() == 1) =>
                    let (rhs, _) = emit_expr(ctx, &args[0].value)?
                    let res_ty = map_ast_type((*ctx).b, &recv_ty)
                    let glsl = ctx.get_glsl_ext()
                    let id = (*ctx).b.ext_inst(res_ty, none, glsl, 68, [rspirv__dr__Operand::IdRef(recv_val), rspirv__dr__Operand::IdRef(rhs)]).unwrap()
                    Result::Ok((id, recv_ty))
                "reflect" if (args.len() == 1) =>
                    let (rhs, _) = emit_expr(ctx, &args[0].value)?
                    let res_ty = map_ast_type((*ctx).b, &recv_ty)
                    let glsl = ctx.get_glsl_ext()
                    let id = (*ctx).b.ext_inst(res_ty, none, glsl, 71, [rspirv__dr__Operand::IdRef(recv_val), rspirv__dr__Operand::IdRef(rhs)]).unwrap()
                    Result::Ok((id, recv_ty))
                _ => Result::Err(KainError__codegen(f"Unsupported method call in shader: {method}", (*span)))
        kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch, span: span } =>
            let (cond_raw, cond_ty) = emit_expr(ctx, condition)?
            let cond = as_bool(ctx, cond_raw, &cond_ty)
            let then_expr = single_expr_from_block(then_branch, (*span))?
            let (then_val, then_ty) = emit_expr(ctx, then_expr)?
            let else_expr = match else_branch:
                Some(kain_core__ast__ElseBranch::Else(block)) => single_expr_from_block(block, (*span))?
                Some(kain_core__ast__ElseBranch::ElseIf(_, _, _)) => return Result::Err(KainError__codegen("Else-if expression chains are not yet supported in SPIR-V value expressions", (*span)))
                None => return Result::Err(KainError__codegen("If expression requires an else branch in SPIR-V backend", (*span)))
            let (else_val, else_ty) = emit_expr(ctx, else_expr)?
            if (std__mem__discriminant(&then_ty) != std__mem__discriminant(&else_ty)):
                return Result::Err(KainError__codegen("If expression branches must return compatible types", (*span)))
            let res_ty = map_ast_type((*ctx).b, &then_ty)
            let selected = (*ctx).b.select(res_ty, none, cond, then_val, else_val).unwrap()
            Result::Ok((selected, then_ty))
        _ => Result::Err(KainError__codegen(f"Unsupported expression in shader: {expr_kind_name(expr)}", expr.span()))

fn expr_kind_name(expr: &kain_core::ast::Expr) -> String:
    match expr:
        kain_core__ast__Expr::Int(_) => "Int"
        kain_core__ast__Expr::Float(_) => "Float"
        kain_core__ast__Expr::Bool(_) => "Bool"
        kain_core__ast__Expr::None(_) => "None"
        kain_core__ast__Expr::String(_) => "String"
        kain_core__ast__Expr::FString(_) => "FString"
        kain_core__ast__Expr::Ident(_) => "Ident"
        kain_core__ast__Expr::MacroCall {  } => "MacroCall"
        kain_core__ast__Expr::Binary {  } => "Binary"
        kain_core__ast__Expr::Unary {  } => "Unary"
        kain_core__ast__Expr::Call {  } => "Call"
        kain_core__ast__Expr::StageCall {  } => "StageCall"
        kain_core__ast__Expr::MethodCall {  } => "MethodCall"
        kain_core__ast__Expr::Field {  } => "Field"
        kain_core__ast__Expr::Index {  } => "Index"
        kain_core__ast__Expr::Assign {  } => "Assign"
        kain_core__ast__Expr::Struct {  } => "Struct"
        kain_core__ast__Expr::AggregateInit {  } => "AggregateInit"
        kain_core__ast__Expr::EnumVariant {  } => "EnumVariant"
        kain_core__ast__Expr::Tuple(_) => "Tuple"
        kain_core__ast__Expr::Array(_) => "Array"
        kain_core__ast__Expr::Range {  } => "Range"
        kain_core__ast__Expr::If {  } => "If"
        kain_core__ast__Expr::Match {  } => "Match"
        kain_core__ast__Expr::Lambda {  } => "Lambda"
        kain_core__ast__Expr::Ref {  } => "Ref"
        kain_core__ast__Expr::AddrOf {  } => "AddrOf"
        kain_core__ast__Expr::Deref(_) => "Deref"
        kain_core__ast__Expr::PtrOffset {  } => "PtrOffset"
        kain_core__ast__Expr::MemLoad {  } => "MemLoad"
        kain_core__ast__Expr::MemStore {  } => "MemStore"
        kain_core__ast__Expr::SizeOfType {  } => "SizeOfType"
        kain_core__ast__Expr::AlignOfType {  } => "AlignOfType"
        kain_core__ast__Expr::Alloca {  } => "Alloca"
        kain_core__ast__Expr::Uninit {  } => "Uninit"
        kain_core__ast__Expr::Alloc {  } => "Alloc"
        kain_core__ast__Expr::Realloc {  } => "Realloc"
        kain_core__ast__Expr::Cast {  } => "Cast"
        kain_core__ast__Expr::Try(_) => "Try"
        kain_core__ast__Expr::Await(_) => "Await"
        kain_core__ast__Expr::AsyncBlock(_) => "AsyncBlock"
        kain_core__ast__Expr::Spawn {  } => "Spawn"
        kain_core__ast__Expr::SendMsg {  } => "SendMsg"
        kain_core__ast__Expr::Comptime(_) => "Comptime"
        kain_core__ast__Expr::Block(_) => "Block"
        kain_core__ast__Expr::JSX(_) => "JSX"
        kain_core__ast__Expr::Paren(_) => "Paren"
        kain_core__ast__Expr::Return(_) => "Return"
        kain_core__ast__Expr::Break(_) => "Break"
        kain_core__ast__Expr::Continue(_) => "Continue"

fn single_expr_from_block<a>(block: &a kain_core::ast::Block, span: kain_core::span::Span) -> Result<&a kain_core::ast::Expr, KainError>:
    if ((*block).stmts.len() != 1):
        return Result::Err(KainError__codegen("Expected single-expression block", span))
    match &(*block).stmts[0]:
        kain_core__ast__Stmt::Expr(expr) => Result::Ok(expr)
        _ => Result::Err(KainError__codegen("Expected expression statement in block", span))

fn as_bool(ctx: &mut ShaderContext, value: u32, ty: &kain_core::ast::Type) -> u32:
    if (none):
        return value
    let bool_ty = (*ctx).b.type_bool()
    if is_uint(ty):
        let uint_ty = map_ast_type((*ctx).b, ty)
        let zero = (*ctx).b.constant_bit32(uint_ty, 0)
        return (*ctx).b.i_not_equal(bool_ty, none, value, zero).unwrap()
    if is_int(ty):
        let int_ty = map_ast_type((*ctx).b, ty)
        let zero = (*ctx).b.constant_bit32(int_ty, 0)
        return (*ctx).b.i_not_equal(bool_ty, none, value, zero).unwrap()
    let float_ty = (*ctx).b.type_float(32)
    let zero = (*ctx).b.constant_bit32(float_ty, (0).to_bits())
    (*ctx).b.f_ord_not_equal(bool_ty, none, value, zero).unwrap()

fn terminate_with_branch(ctx: &mut ShaderContext, target: u32) -> Result<(), KainError>:
    if (*ctx).b.selected_block().is_some():
        (*ctx).b.branch(target).unwrap()
        ()
        ()
        ()
        ()
    Result::Ok(())

fn emit_if_statement(ctx: &mut ShaderContext, condition: &kain_core::ast::Expr, then_branch: &kain_core::ast::Block, else_branch: Option<&kain_core::ast::ElseBranch>) -> Result<(), KainError>:
    let (cond_raw, cond_ty) = emit_expr(ctx, condition)?
    let cond = as_bool(ctx, cond_raw, &cond_ty)
    let then_label = (*ctx).b.id()
    let else_label = (*ctx).b.id()
    let merge_label = (*ctx).b.id()
    (*ctx).b.selection_merge(merge_label, rspirv__spirv__SelectionControl__NONE).unwrap()
    ()
    (*ctx).b.branch_conditional(cond, then_label, else_label, std__iter__empty()).unwrap()
    ()
    (*ctx).b.begin_block(Option::Some(then_label)).unwrap()
    ()
    emit_block(ctx, then_branch)?
    ()
    terminate_with_branch(ctx, merge_label)?
    ()
    (*ctx).b.begin_block(Option::Some(else_label)).unwrap()
    ()
    match else_branch:
        Some(else_branch) =>
            emit_else_branch(ctx, else_branch)?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    terminate_with_branch(ctx, merge_label)?
    ()
    (*ctx).b.begin_block(Option::Some(merge_label)).unwrap()
    ()
    Result::Ok(())

fn emit_else_branch(ctx: &mut ShaderContext, else_branch: &kain_core::ast::ElseBranch) -> Result<(), KainError>:
    match else_branch:
        kain_core__ast__ElseBranch::Else(block) => emit_block(ctx, block)
        kain_core__ast__ElseBranch::ElseIf(cond, then_block, nested) => emit_if_statement(ctx, cond, then_block, nested)

fn emit_while_statement(ctx: &mut ShaderContext, condition: &kain_core::ast::Expr, body: &kain_core::ast::Block) -> Result<(), KainError>:
    let header_label = (*ctx).b.id()
    let condition_label = (*ctx).b.id()
    let loop_body_label = (*ctx).b.id()
    let continue_label = (*ctx).b.id()
    let merge_label = (*ctx).b.id()
    terminate_with_branch(ctx, header_label)?
    ()
    (*ctx).b.begin_block(Option::Some(header_label)).unwrap()
    ()
    (*ctx).b.loop_merge(merge_label, continue_label, rspirv__spirv__LoopControl__NONE, std__iter__empty()).unwrap()
    ()
    (*ctx).b.branch(condition_label).unwrap()
    ()
    (*ctx).b.begin_block(Option::Some(condition_label)).unwrap()
    ()
    let (cond_raw, cond_ty) = emit_expr(ctx, condition)?
    let cond = as_bool(ctx, cond_raw, &cond_ty)
    (*ctx).b.branch_conditional(cond, loop_body_label, merge_label, std__iter__empty()).unwrap()
    ()
    (*ctx).loop_continue_targets.push(continue_label)
    ()
    (*ctx).loop_break_targets.push(merge_label)
    ()
    (*ctx).b.begin_block(Option::Some(loop_body_label)).unwrap()
    ()
    emit_block(ctx, body)?
    ()
    terminate_with_branch(ctx, continue_label)?
    ()
    (*ctx).loop_continue_targets.pop()
    ()
    (*ctx).loop_break_targets.pop()
    ()
    (*ctx).b.begin_block(Option::Some(continue_label)).unwrap()
    ()
    terminate_with_branch(ctx, header_label)?
    ()
    (*ctx).b.begin_block(Option::Some(merge_label)).unwrap()
    ()
    Result::Ok(())

fn emit_for_statement(ctx: &mut ShaderContext, binding: &kain_core::ast::Pattern, iter: &kain_core::ast::Expr, body: &kain_core::ast::Block, span: kain_core::span::Span) -> Result<(), KainError>:
    let (name, bind_span) = match binding:
        kain_core__ast__Pattern::Binding { name: name, span: span } => (name.clone(), (*span))
        _ => return Result::Err(KainError__codegen("for loop requires binding pattern", span))
    let (start_expr, end_expr, inclusive) = match iter:
        kain_core__ast__Expr::Range { start: start, end: end, inclusive: inclusive } => (start, end, (*inclusive))
        kain_core__ast__Expr::Call { callee: callee, args: args } =>
            match callee:
                kain_core__ast__Expr::Ident(fn_name, _) => if (fn_name == "range"): none else: return Result::Err(KainError__codegen("SPIR-V for loops currently require range iteration", span))
                _ => return Result::Err(KainError__codegen("SPIR-V for loops currently require range iteration", span))
        _ => return Result::Err(KainError__codegen("SPIR-V for loops currently require range iteration", span))
    let end_expr = end_expr.ok_or_else(fn(): KainError__codegen("for range requires an end bound", span))?
    let int_ty_ast = kain_core__ast__Type::Named { name: ("Int").into(), generics: [], span: bind_span }
    let int_ty = map_ast_type((*ctx).b, &int_ty_ast)
    let int_ptr_ty = (*ctx).b.type_pointer(none, rspirv__spirv__StorageClass__Function, int_ty)
    let loop_var_name = internal_hoist_name("for_iter", span)
    let loop_var = take_hoisted_slot(ctx, &loop_var_name, int_ptr_ty).unwrap_or_else(fn(): (*ctx).b.variable(int_ptr_ty, none, rspirv__spirv__StorageClass__Function, none))
    let init_val = match start_expr:
        Some(start_expr) =>
            let (v, _) = emit_expr(ctx, start_expr)?
            v
        _ => (*ctx).b.constant_bit32(int_ty, 0)
    (*ctx).b.store(loop_var, init_val, none, std__iter__empty()).unwrap()
    ()
    let range_end_name = internal_hoist_name("for_end", span)
    let range_end_var = take_hoisted_slot(ctx, &range_end_name, int_ptr_ty).unwrap_or_else(fn(): (*ctx).b.variable(int_ptr_ty, none, rspirv__spirv__StorageClass__Function, none))
    let (end_val, _) = emit_expr(ctx, end_expr)?
    (*ctx).b.store(range_end_var, end_val, none, std__iter__empty()).unwrap()
    ()
    let previous = (*ctx).vars.insert(name.clone(), VarBinding { id: loop_var, ty: int_ty_ast.clone(), is_ptr: true })
    let header_label = (*ctx).b.id()
    let condition_label = (*ctx).b.id()
    let loop_body_label = (*ctx).b.id()
    let continue_label = (*ctx).b.id()
    let merge_label = (*ctx).b.id()
    terminate_with_branch(ctx, header_label)?
    ()
    (*ctx).b.begin_block(Option::Some(header_label)).unwrap()
    ()
    (*ctx).b.loop_merge(merge_label, continue_label, rspirv__spirv__LoopControl__NONE, std__iter__empty()).unwrap()
    ()
    (*ctx).b.branch(condition_label).unwrap()
    ()
    (*ctx).b.begin_block(Option::Some(condition_label)).unwrap()
    ()
    let i_val = (*ctx).b.load(int_ty, none, loop_var, none, std__iter__empty()).unwrap()
    let end_loaded = (*ctx).b.load(int_ty, none, range_end_var, none, std__iter__empty()).unwrap()
    let bool_ty = (*ctx).b.type_bool()
    let cond = if inclusive:
        (*ctx).b.s_less_than_equal(bool_ty, none, i_val, end_loaded).unwrap()
    else:
        (*ctx).b.s_less_than(bool_ty, none, i_val, end_loaded).unwrap()
    (*ctx).b.branch_conditional(cond, loop_body_label, merge_label, std__iter__empty()).unwrap()
    ()
    (*ctx).loop_continue_targets.push(continue_label)
    ()
    (*ctx).loop_break_targets.push(merge_label)
    ()
    (*ctx).b.begin_block(Option::Some(loop_body_label)).unwrap()
    ()
    emit_block(ctx, body)?
    ()
    terminate_with_branch(ctx, continue_label)?
    ()
    (*ctx).loop_continue_targets.pop()
    ()
    (*ctx).loop_break_targets.pop()
    ()
    (*ctx).b.begin_block(Option::Some(continue_label)).unwrap()
    ()
    let cur_i = (*ctx).b.load(int_ty, none, loop_var, none, std__iter__empty()).unwrap()
    let one = (*ctx).b.constant_bit32(int_ty, 1)
    let next_i = (*ctx).b.i_add(int_ty, none, cur_i, one).unwrap()
    (*ctx).b.store(loop_var, next_i, none, std__iter__empty()).unwrap()
    ()
    terminate_with_branch(ctx, header_label)?
    ()
    (*ctx).b.begin_block(Option::Some(merge_label)).unwrap()
    ()
    match previous:
        Some(prev) =>
            (*ctx).vars.insert(name, prev)
            ()
            ()
            ()
            ()
        _ =>
            (*ctx).vars.remove(&name)
            ()
            ()
            ()
            ()
    Result::Ok(())

fn map_ast_type(b: &mut rspirv::dr::Builder, ty: &kain_core::ast::Type) -> u32:
    let float_ = b.type_float(32)
    let int_ = b.type_int(32, 1)
    let uint_ = b.type_int(32, 0)
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } =>
            match name.as_str():
                "Float" => float_
                "f32" => float_
                "Int" => int_
                "i32" => int_
                "UInt" => uint_
                "u32" => uint_
                "Bool" => b.type_bool()
                "Vec2" => b.type_vector(float_, 2)
                "Vec3" => b.type_vector(float_, 3)
                "Vec4" => b.type_vector(float_, 4)
                "IVec2" => b.type_vector(int_, 2)
                "IVec3" => b.type_vector(int_, 3)
                "IVec4" => b.type_vector(int_, 4)
                "UVec2" => b.type_vector(uint_, 2)
                "UVec3" => b.type_vector(uint_, 3)
                "UVec4" => b.type_vector(uint_, 4)
                "Mat4" =>
                    let v4 = b.type_vector(float_, 4)
                    b.type_matrix(v4, 4)
                "Sampler2D" =>
                    let image = b.type_image(float_, rspirv__spirv__Dim__Dim2D, 0, 0, 0, 1, rspirv__spirv__ImageFormat__Unknown, none)
                    b.type_sampled_image(image)
                "StorageBuffer" =>
                    let elem_type_ast = match generics.first():
                        Some(first) => first.clone()
                        _ => kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: Span__default_() }
                    let elem_ty = map_ast_type(b, &elem_type_ast)
                    let rt_array = b.type_runtime_array(elem_ty)
                    let struct_ty = b.type_struct([rt_array])
                    struct_ty
                "Void" => b.type_void()
                _ => b.type_void()
        kain_core__ast__Type::Ref { inner: inner } => map_ast_type(b, inner)
        kain_core__ast__Type::Array(inner, _, _) => map_ast_type(b, inner)
        kain_core__ast__Type::Slice(inner, _) => map_ast_type(b, inner)
        _ => b.type_void()

fn is_void(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if (name == "Void") => true
        _ => false

fn is_vec4(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if (name == "Vec4") => true
        _ => false

fn is_mat4(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if (name == "Mat4") => true
        _ => false

fn is_float(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if ((name == "Float") || (name == "f32")) => true
        _ => false

fn is_bool(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if (name == "Bool") => true
        _ => false

fn is_uint(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if ((name == "UInt") || (name == "u32")) => true
        _ => false

fn is_int(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if ((name == "Int") || (name == "i32")) => true
        _ => false

fn type_name(ty: &kain_core::ast::Type) -> Option<String>:
    match ty:
        kain_core__ast__Type::Named { name: name } => Option::Some(name.as_str())
        _ =>
            none

fn numeric_dim(ty: &kain_core::ast::Type) -> usize:
    match type_name(ty):
        Some("Float") => 1
        Some("f32") => 1
        Some("Int") => 1
        Some("i32") => 1
        Some("UInt") => 1
        Some("u32") => 1
        Some("Bool") => 1
        Some("Vec2") => 2
        Some("IVec2") => 2
        Some("UVec2") => 2
        Some("Vec3") => 3
        Some("IVec3") => 3
        Some("UVec3") => 3
        Some("Vec4") => 4
        Some("IVec4") => 4
        Some("UVec4") => 4
        _ => 0

fn is_float_vector(ty: &kain_core::ast::Type) -> Bool:
    match type_name(ty):
        Some("Vec2") => true
        Some("Vec3") => true
        Some("Vec4") => true
        _ => false

fn is_int_vector(ty: &kain_core::ast::Type) -> Bool:
    match type_name(ty):
        Some("IVec2") => true
        Some("IVec3") => true
        Some("IVec4") => true
        _ => false

fn is_uint_vector(ty: &kain_core::ast::Type) -> Bool:
    match type_name(ty):
        Some("UVec2") => true
        Some("UVec3") => true
        Some("UVec4") => true
        _ => false

fn is_float_like(ty: &kain_core::ast::Type) -> Bool:
    (is_float(ty) || is_float_vector(ty))

fn is_int_like(ty: &kain_core::ast::Type) -> Bool:
    (is_int(ty) || is_int_vector(ty))

fn is_uint_like(ty: &kain_core::ast::Type) -> Bool:
    (is_uint(ty) || is_uint_vector(ty))

fn is_same_type_family(a: &kain_core::ast::Type, b: &kain_core::ast::Type) -> Bool:
    (type_name(a) == type_name(b))

fn float_zero(b: &mut rspirv::dr::Builder, ty: &kain_core::ast::Type) -> u32:
    let float_ = b.type_float(32)
    match numeric_dim(ty):
        2 =>
            let vec = b.type_vector(float_, 2)
            let z = b.constant_bit32(float_, (0).to_bits())
            b.constant_composite(vec, [z, z])
        3 =>
            let vec = b.type_vector(float_, 3)
            let z = b.constant_bit32(float_, (0).to_bits())
            b.constant_composite(vec, [z, z, z])
        4 =>
            let vec = b.type_vector(float_, 4)
            let z = b.constant_bit32(float_, (0).to_bits())
            b.constant_composite(vec, [z, z, z, z])
        _ => b.constant_bit32(float_, (0).to_bits())

fn float_one(b: &mut rspirv::dr::Builder, ty: &kain_core::ast::Type) -> u32:
    let float_ = b.type_float(32)
    match numeric_dim(ty):
        2 =>
            let vec = b.type_vector(float_, 2)
            let o = b.constant_bit32(float_, (1).to_bits())
            b.constant_composite(vec, [o, o])
        3 =>
            let vec = b.type_vector(float_, 3)
            let o = b.constant_bit32(float_, (1).to_bits())
            b.constant_composite(vec, [o, o, o])
        4 =>
            let vec = b.type_vector(float_, 4)
            let o = b.constant_bit32(float_, (1).to_bits())
            b.constant_composite(vec, [o, o, o, o])
        _ => b.constant_bit32(float_, (1).to_bits())

fn int_zero(b: &mut rspirv::dr::Builder, ty: &kain_core::ast::Type) -> u32:
    let int_ = b.type_int(32, 1)
    match numeric_dim(ty):
        2 =>
            let vec = b.type_vector(int_, 2)
            let z = b.constant_bit32(int_, 0)
            b.constant_composite(vec, [z, z])
        3 =>
            let vec = b.type_vector(int_, 3)
            let z = b.constant_bit32(int_, 0)
            b.constant_composite(vec, [z, z, z])
        4 =>
            let vec = b.type_vector(int_, 4)
            let z = b.constant_bit32(int_, 0)
            b.constant_composite(vec, [z, z, z, z])
        _ => b.constant_bit32(int_, 0)

fn int_one(b: &mut rspirv::dr::Builder, ty: &kain_core::ast::Type) -> u32:
    let int_ = b.type_int(32, 1)
    match numeric_dim(ty):
        2 =>
            let vec = b.type_vector(int_, 2)
            let o = b.constant_bit32(int_, 1)
            b.constant_composite(vec, [o, o])
        3 =>
            let vec = b.type_vector(int_, 3)
            let o = b.constant_bit32(int_, 1)
            b.constant_composite(vec, [o, o, o])
        4 =>
            let vec = b.type_vector(int_, 4)
            let o = b.constant_bit32(int_, 1)
            b.constant_composite(vec, [o, o, o, o])
        _ => b.constant_bit32(int_, 1)

fn uint_zero(b: &mut rspirv::dr::Builder, ty: &kain_core::ast::Type) -> u32:
    let uint_ = b.type_int(32, 0)
    match numeric_dim(ty):
        2 =>
            let vec = b.type_vector(uint_, 2)
            let z = b.constant_bit32(uint_, 0)
            b.constant_composite(vec, [z, z])
        3 =>
            let vec = b.type_vector(uint_, 3)
            let z = b.constant_bit32(uint_, 0)
            b.constant_composite(vec, [z, z, z])
        4 =>
            let vec = b.type_vector(uint_, 4)
            let z = b.constant_bit32(uint_, 0)
            b.constant_composite(vec, [z, z, z, z])
        _ => b.constant_bit32(uint_, 0)

fn uint_one(b: &mut rspirv::dr::Builder, ty: &kain_core::ast::Type) -> u32:
    let uint_ = b.type_int(32, 0)
    match numeric_dim(ty):
        2 =>
            let vec = b.type_vector(uint_, 2)
            let o = b.constant_bit32(uint_, 1)
            b.constant_composite(vec, [o, o])
        3 =>
            let vec = b.type_vector(uint_, 3)
            let o = b.constant_bit32(uint_, 1)
            b.constant_composite(vec, [o, o, o])
        4 =>
            let vec = b.type_vector(uint_, 4)
            let o = b.constant_bit32(uint_, 1)
            b.constant_composite(vec, [o, o, o, o])
        _ => b.constant_bit32(uint_, 1)

fn is_storage_buffer(ty: &kain_core::ast::Type) -> Bool:
    match ty:
        kain_core__ast__Type::Named { name: name } if (name == "StorageBuffer") => true
        _ => false

fn is_local_size_param(name: String) -> Bool:
    match name:
        "LOCAL_SIZE_X" => true
        "LOCAL_SIZE_Y" => true
        "LOCAL_SIZE_Z" => true
        _ => false

fn is_permutation_param(name: String) -> Bool:
    if ((((((name.starts_with("CFG_") || name.starts_with("ENABLE_")) || name.starts_with("USE_")) || name.starts_with("WITH_")) || name.starts_with("HAS_")) || name.starts_with("ALLOW_")) || name.starts_with("SUPPORT_")):
        return true
    (((name.len() >= 4) && name.contains("_")) && name.chars().all(fn(c): ((c.is_uppercase() || (c == "_")) || c.is_ascii_digit())))

fn emit_permutation_spec_constant(b: &mut rspirv::dr::Builder, ty: &kain_core::ast::Type, spec_id: u32) -> Option<u32>:
    let id = match ty:
        kain_core__ast__Type::Named { name: name } if (name == "Bool") =>
            let bool_ty = b.type_bool()
            b.spec_constant_false(bool_ty)
        kain_core__ast__Type::Named { name: name } if ((name == "UInt") || (name == "u32")) =>
            let uint_ty = b.type_int(32, 0)
            b.spec_constant_bit32(uint_ty, 0)
        kain_core__ast__Type::Named { name: name } if ((name == "Int") || (name == "i32")) =>
            let int_ty = b.type_int(32, 1)
            b.spec_constant_bit32(int_ty, 0)
        kain_core__ast__Type::Named { name: name } if ((name == "Float") || (name == "f32")) =>
            let float_ty = b.type_float(32)
            b.spec_constant_bit32(float_ty, (0).to_bits())
        _ => return none
    b.decorate(id, rspirv__spirv__Decoration__SpecId, [rspirv__dr__Operand::LiteralBit32(spec_id)])
    ()
    Option::Some(id)

fn emit_u32_spec_constant(b: &mut rspirv::dr::Builder, value: u32, spec_id: u32) -> u32:
    let uint_ty = b.type_int(32, 0)
    let id = b.spec_constant_bit32(uint_ty, value)
    b.decorate(id, rspirv__spirv__Decoration__SpecId, [rspirv__dr__Operand::LiteralBit32(spec_id)])
    ()
    id

fn storage_buffer_elem_type(buffer_ty: &kain_core::ast::Type, span: kain_core::span::Span) -> kain_core::ast::Type:
    match buffer_ty:
        kain_core__ast__Type::Named { name: name, generics: generics } if (name == "StorageBuffer") => generics.first().cloned().unwrap_or(kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: span })
        _ => kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: span }

fn storage_buffer_stride(buffer_ty: &kain_core::ast::Type) -> u32:
    let elem_ty = storage_buffer_elem_type(buffer_ty, Span__default_())
    match elem_ty:
        kain_core__ast__Type::Named { name: name } if ((name == "Vec4") || (name == "UVec4")) => 16
        kain_core__ast__Type::Named { name: name } if ((name == "Vec3") || (name == "UVec3")) => 12
        kain_core__ast__Type::Named { name: name } if ((name == "Vec2") || (name == "UVec2")) => 8
        _ => 4

fn coerce_to_u32_index(ctx: &mut ShaderContext, value_id: u32, value_ty: &kain_core::ast::Type, span: kain_core::span::Span) -> Result<u32, KainError>:
    let uint_ty = (*ctx).b.type_int(32, 0)
    if is_uint(value_ty):
        return Result::Ok(value_id)
    if is_int(value_ty):
        return Result::Ok((*ctx).b.bitcast(uint_ty, none, value_id).unwrap())
    if is_float(value_ty):
        return Result::Ok((*ctx).b.convert_f_to_u(uint_ty, none, value_id).unwrap())
    if is_bool(value_ty):
        let one = (*ctx).b.constant_bit32(uint_ty, 1)
        let zero = (*ctx).b.constant_bit32(uint_ty, 0)
        return Result::Ok((*ctx).b.select(uint_ty, none, value_id, one, zero).unwrap())
    Result::Err(KainError__codegen("Shader index expression must be scalar Int/UInt/Float/Bool", span))

fn cast_to_u32(ctx: &mut ShaderContext, value_id: u32, value_ty: &kain_core::ast::Type) -> u32:
    if is_uint_like(value_ty):
        return value_id
    let dim = numeric_dim(value_ty)
    let scalar_u32 = (*ctx).b.type_int(32, 0)
    let target_ty = if (dim > 1):
        (*ctx).b.type_vector(scalar_u32, dim as u32)
    else:
        scalar_u32
    if is_int_like(value_ty):
        return (*ctx).b.bitcast(target_ty, none, value_id).unwrap()
    if is_float_like(value_ty):
        return (*ctx).b.convert_f_to_u(target_ty, none, value_id).unwrap()
    if is_bool(value_ty):
        let one = (*ctx).b.constant_bit32(scalar_u32, 1)
        let zero = (*ctx).b.constant_bit32(scalar_u32, 0)
        return (*ctx).b.select(target_ty, none, value_id, one, zero).unwrap()
    value_id

fn cast_to_i32(ctx: &mut ShaderContext, value_id: u32, value_ty: &kain_core::ast::Type) -> u32:
    if is_int_like(value_ty):
        return value_id
    let dim = numeric_dim(value_ty)
    let scalar_i32 = (*ctx).b.type_int(32, 1)
    let target_ty = if (dim > 1):
        (*ctx).b.type_vector(scalar_i32, dim as u32)
    else:
        scalar_i32
    if is_uint_like(value_ty):
        return (*ctx).b.bitcast(target_ty, none, value_id).unwrap()
    if is_float_like(value_ty):
        return (*ctx).b.convert_f_to_s(target_ty, none, value_id).unwrap()
    if is_bool(value_ty):
        let one = (*ctx).b.constant_bit32(scalar_i32, 1)
        let zero = (*ctx).b.constant_bit32(scalar_i32, 0)
        return (*ctx).b.select(target_ty, none, value_id, one, zero).unwrap()
    value_id

fn cast_to_f32(ctx: &mut ShaderContext, value_id: u32, value_ty: &kain_core::ast::Type) -> u32:
    if is_float_like(value_ty):
        return value_id
    let dim = numeric_dim(value_ty)
    let scalar_f32 = (*ctx).b.type_float(32)
    let target_ty = if (dim > 1):
        (*ctx).b.type_vector(scalar_f32, dim as u32)
    else:
        scalar_f32
    if is_int_like(value_ty):
        return (*ctx).b.convert_s_to_f(target_ty, none, value_id).unwrap()
    if is_uint_like(value_ty):
        return (*ctx).b.convert_u_to_f(target_ty, none, value_id).unwrap()
    if is_bool(value_ty):
        let one = float_one((*ctx).b, value_ty)
        let zero = float_zero((*ctx).b, value_ty)
        return (*ctx).b.select(target_ty, none, value_id, one, zero).unwrap()
    value_id

fn splat_to_vec(ctx: &mut ShaderContext, scalar_id: u32, scalar_ty: &kain_core::ast::Type, width: usize) -> u32:
    if (width <= 1):
        return scalar_id
    let scalar_spv = map_ast_type((*ctx).b, scalar_ty)
    let vec_spv = (*ctx).b.type_vector(scalar_spv, width as u32)
    let mut comps = (fn(__kain_ctor_arg0): Vec__new_())(width)
    for _ in range(0, width):
        comps.push(scalar_id)
        ()
    ()
    (*ctx).b.composite_construct(vec_spv, none, comps).unwrap()

fn coerce_float_binary_operands(ctx: &mut ShaderContext, lhs_id: u32, lhs_ty: &kain_core::ast::Type, rhs_id: u32, rhs_ty: &kain_core::ast::Type) -> (u32, u32, kain_core::ast::Type):
    let lhs_f = cast_to_f32(ctx, lhs_id, lhs_ty)
    let rhs_f = cast_to_f32(ctx, rhs_id, rhs_ty)
    let lhs_dim = numeric_dim(lhs_ty)
    let rhs_dim = numeric_dim(rhs_ty)
    if ((lhs_dim > 1) && (rhs_dim == 1)):
        let rhs_scalar_ty = kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: rhs_ty.span() }
        let rhs_splat = splat_to_vec(ctx, rhs_f, &rhs_scalar_ty, lhs_dim)
        let out_ty = vec_type_from_scalar(&kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: lhs_ty.span() }, lhs_dim, lhs_ty.span())
        return (lhs_f, rhs_splat, out_ty)
    if ((rhs_dim > 1) && (lhs_dim == 1)):
        let lhs_scalar_ty = kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: lhs_ty.span() }
        let lhs_splat = splat_to_vec(ctx, lhs_f, &lhs_scalar_ty, rhs_dim)
        let out_ty = vec_type_from_scalar(&kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: rhs_ty.span() }, rhs_dim, rhs_ty.span())
        return (lhs_splat, rhs_f, out_ty)
    if (lhs_dim > 1):
        let out_ty = vec_type_from_scalar(&kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: lhs_ty.span() }, lhs_dim, lhs_ty.span())
        return (lhs_f, rhs_f, out_ty)
    (lhs_f, rhs_f, kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: lhs_ty.span() })

fn coerce_float_ternary_operands(ctx: &mut ShaderContext, a_id: u32, a_ty: &kain_core::ast::Type, b_id: u32, b_ty: &kain_core::ast::Type, c_id: u32, c_ty: &kain_core::ast::Type) -> (u32, u32, u32, kain_core::ast::Type):
    let a_f = cast_to_f32(ctx, a_id, a_ty)
    let b_f = cast_to_f32(ctx, b_id, b_ty)
    let c_f = cast_to_f32(ctx, c_id, c_ty)
    let out_dim = numeric_dim(a_ty).max(numeric_dim(b_ty)).max(numeric_dim(c_ty))
    if (out_dim <= 1):
        return (a_f, b_f, c_f, kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: a_ty.span() })
    let scalar_ty = kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: a_ty.span() }
    let a_out = if (numeric_dim(a_ty) == 1):
        splat_to_vec(ctx, a_f, &scalar_ty, out_dim)
    else:
        a_f
    let b_out = if (numeric_dim(b_ty) == 1):
        splat_to_vec(ctx, b_f, &scalar_ty, out_dim)
    else:
        b_f
    let c_out = if (numeric_dim(c_ty) == 1):
        splat_to_vec(ctx, c_f, &scalar_ty, out_dim)
    else:
        c_f
    let out_ty = vec_type_from_scalar(&scalar_ty, out_dim, a_ty.span())
    (a_out, b_out, c_out, out_ty)

fn vector_scalar_type(ctx: &mut ShaderContext, vec_ty: &kain_core::ast::Type) -> kain_core::ast::Type:
    if (none):
        kain_core__ast__Type::Named { name: ("UInt").into(), generics: [], span: Span__default_() }
    elif (none):
        kain_core__ast__Type::Named { name: ("Int").into(), generics: [], span: Span__default_() }
    elif is_uint(vec_ty):
        kain_core__ast__Type::Named { name: ("UInt").into(), generics: [], span: Span__default_() }
    elif is_int(vec_ty):
        kain_core__ast__Type::Named { name: ("Int").into(), generics: [], span: Span__default_() }
    else:
        let _ = ctx
        kain_core__ast__Type::Named { name: ("Float").into(), generics: [], span: Span__default_() }

fn vec_type_from_scalar(scalar_ty: &kain_core::ast::Type, width: usize, span: kain_core::span::Span) -> kain_core::ast::Type:
    let is_u = match scalar_ty:
        kain_core__ast__Type::Named { name: name } if ((name == "UInt") || (name == "u32")) => true
        _ => false
    let is_i = match scalar_ty:
        kain_core__ast__Type::Named { name: name } if ((name == "Int") || (name == "i32")) => true
        _ => false
    let name = if is_u:
        match width:
            2 => "UVec2"
            3 => "UVec3"
            _ => "UVec4"
    elif is_i:
        match width:
            2 => "IVec2"
            3 => "IVec3"
            _ => "IVec4"
    else:
        match width:
            2 => "Vec2"
            3 => "Vec3"
            _ => "Vec4"
    kain_core__ast__Type::Named { name: name.into(), generics: [], span: span }

fn swizzle_indices(field: String) -> Option<Array<u32>>:
    if (field.is_empty() || (field.len() > 4)):
        return none
    let mut out_ = (fn(__kain_ctor_arg0): Vec__new_())(field.len())
    for ch in field.chars():
        let idx = match ch:
            "x" => 0
            "r" => 0
            "y" => 1
            "g" => 1
            "z" => 2
            "b" => 2
            "w" => 3
            "a" => 3
            _ => return none
        out_.push(idx)
        ()
    ()
    Option::Some(out_)

fn emit_index_lvalue_ptr(ctx: &mut ShaderContext, object: &kain_core::ast::Expr, index: &kain_core::ast::Expr, elem_ty: &kain_core::ast::Type, span: kain_core::span::Span) -> Result<u32, KainError>:
    match object:
        kain_core__ast__Expr::Ident(buffer_name, _) =>
            if (*ctx).storage_buffers.contains(buffer_name):
                let binding = (*ctx).vars.get(buffer_name).cloned().ok_or_else(fn(): KainError__codegen(f"Unknown storage buffer: {buffer_name}", span))?
                let (index_raw_id, index_raw_ty) = emit_expr(ctx, index)?
                let index_id = coerce_to_u32_index(ctx, index_raw_id, &index_raw_ty, span)?
                let elem_ty_id = map_ast_type((*ctx).b, elem_ty)
                let elem_ptr_ty = (*ctx).b.type_pointer(none, rspirv__spirv__StorageClass__StorageBuffer, elem_ty_id)
                let uint_ty = (*ctx).b.type_int(32, 0)
                let zero = (*ctx).b.constant_bit32(uint_ty, 0)
                let elem_ptr = (*ctx).b.access_chain(elem_ptr_ty, none, binding.id, [zero, index_id]).unwrap()
                return Result::Ok(elem_ptr)
            ()
        _ =>
            ()
            ()
    Result::Err(KainError__codegen("Unsupported lvalue index target in shader", span))

