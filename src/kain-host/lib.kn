pub type HostResult<T> = Result<T, kain_core::error::KainError>

pub enum HostType:
    Unit
    Bool
    Int
    Float
    String
    Option(Box<HostType>)
    Array(Box<HostType>)

impl HostType:
    fn render(_self: &HostType) -> String:
        match *_self:
            HostType::Unit => ("Unit").to_string()
            HostType::Bool => ("Bool").to_string()
            HostType::Int => ("Int").to_string()
            HostType::Float => ("Float").to_string()
            HostType::String => ("String").to_string()
            HostType::Option(inner) => f"Option<{inner.render()}>"
            HostType::Array(inner) => f"Array<{inner.render()}>"

    fn default_literal(_self: &HostType) -> String:
        match *_self:
            HostType::Unit => "()"
            HostType::Bool => "false"
            HostType::Int => "0"
            HostType::Float => "0.0"
            HostType::String => "\"\""
            HostType::Option(_) => "none"
            HostType::Array(_) => "[]"


@derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)
pub struct NativeParam:
    name: String
    ty: HostType

impl NativeParam:
    pub fn new_(name: impl Into<String>, ty: HostType) -> NativeParam:
        NativeParam { name: name.into(), ty: ty }


@derive(Clone)
pub struct NativeFunction:
    name: String
    params: Array<NativeParam>
    return_type: HostType
    func: kain_core::runtime::NativeFn

impl NativeFunction:
    pub fn new_(name: impl Into<String>, params: Array<NativeParam>, return_type: HostType, func: kain_core::runtime::NativeFn) -> NativeFunction:
        NativeFunction { name: name.into(), params: params, return_type: return_type, func: func }


@derive(Debug, Clone, PartialEq, Eq)
pub struct HostPreludeConfig:
    module_name: String
    auto_use_glob: Bool

impl Default for HostPreludeConfig:
    fn default_() -> HostPreludeConfig:
        HostPreludeConfig { module_name: ("engine").to_string(), auto_use_glob: true }


@derive(Debug, Clone, PartialEq, Eq)
pub struct EngineModuleExportConfig:
    output_dir: std::path::PathBuf
    module_name: String
    module_file_name: String
    import_shim_file_name: Option<String>
    include_banner: Bool

impl EngineModuleExportConfig:
    pub fn for_module(module_name: impl Into<String>) -> EngineModuleExportConfig:
        let module_name = module_name.into()
        EngineModuleExportConfig { output_dir: PathBuf__from("."), module_file_name: f"{module_name}.kn", import_shim_file_name: Option::Some(f"{module_name}_prelude.kn"), module_name: module_name, include_banner: true }

    pub fn with_output_dir(_self: EngineModuleExportConfig, output_dir: impl Into<std::path::PathBuf>) -> EngineModuleExportConfig:
        _self.output_dir = output_dir.into()
        ()
        _self

    pub fn with_module_file_name(_self: EngineModuleExportConfig, file_name: impl Into<String>) -> EngineModuleExportConfig:
        _self.module_file_name = file_name.into()
        ()
        _self

    pub fn with_import_shim_file_name(_self: EngineModuleExportConfig, file_name: impl Into<String>) -> EngineModuleExportConfig:
        _self.import_shim_file_name = Option::Some(file_name.into())
        ()
        _self

    pub fn without_import_shim(_self: EngineModuleExportConfig) -> EngineModuleExportConfig:
        _self.import_shim_file_name = none
        ()
        _self

    pub fn with_banner(_self: EngineModuleExportConfig, include_banner: Bool) -> EngineModuleExportConfig:
        _self.include_banner = include_banner
        ()
        _self

    pub fn module_path(_self: &EngineModuleExportConfig) -> std::path::PathBuf:
        (*_self).output_dir.join(&(*_self).module_file_name)

    pub fn import_shim_path(_self: &EngineModuleExportConfig) -> Option<std::path::PathBuf>:
        (*_self).import_shim_file_name.map(fn(file_name): (*_self).output_dir.join(file_name))


impl Default for EngineModuleExportConfig:
    fn default_() -> EngineModuleExportConfig:
        EngineModuleExportConfig__for_module("engine")


@derive(Debug, Clone, PartialEq, Eq)
pub struct EngineModuleExport:
    module_name: String
    module_path: std::path::PathBuf
    module_source: String
    import_shim_path: Option<std::path::PathBuf>
    import_shim_source: Option<String>

pub mod bridge:
    use super::*

    pub fn struct_value<K, I>(name: impl Into<String>, fields: I) -> kain_core::runtime::Value:
        let fields = fields.into_iter().map(fn(__kain_closure_arg0): (__kain_closure_arg0.__kain_tuple_0.into(), __kain_closure_arg0.__kain_tuple_1)).collect()
        kain_core__runtime__Value::Struct(name.into(), Arc__new_(RwLock__new_(fields)))

    pub fn expect_struct(value: kain_core::runtime::Value, expected_name: String) -> HostResult<Map<String, kain_core::runtime::Value>>:
        match value:
            kain_core__runtime__Value::Struct(name, fields) =>
                if (name != expected_name):
                    return Result::Err(KainError__runtime(f"Expected struct {expected_name}, got struct {name}"))
                let fields = (fields.read().map_err(fn(_): KainError__runtime("Failed to read struct fields"))?).clone()
                Result::Ok(fields)
            other => Result::Err(type_mismatch(expected_name, &other))

    pub fn take_struct_field<T>(fields: &mut Map<String, kain_core::runtime::Value>, field_name: String) -> HostResult<T>:
        let value = fields.remove(field_name).ok_or_else(fn(): KainError__runtime(f"Missing struct field '{field_name}'"))?
        T__from_kain_value(value)

    pub fn enum_variant_value(enum_name: impl Into<String>, variant_name: impl Into<String>, fields: Array<kain_core::runtime::Value>) -> kain_core::runtime::Value:
        kain_core__runtime__Value::EnumVariant(enum_name.into(), variant_name.into(), fields)

    pub fn expect_enum(value: kain_core::runtime::Value, expected_name: String) -> HostResult<(String, Array<kain_core::runtime::Value>)>:
        match value:
            kain_core__runtime__Value::EnumVariant(enum_name, variant, fields) =>
                if (enum_name != expected_name):
                    return Result::Err(KainError__runtime(f"Expected enum {expected_name}, got enum {enum_name}"))
                Result::Ok((variant, fields))
            other => Result::Err(type_mismatch(expected_name, &other))

    pub fn expect_variant_len(fields: Array<kain_core::runtime::Value>, expected_len: usize, enum_name: String, variant_name: String) -> HostResult<Array<kain_core::runtime::Value>>:
        if (fields.len() == expected_len):
            Result::Ok(fields)
        else:
            Result::Err(KainError__runtime(f"Enum variant {enum_name}::{variant_name} expected {expected_len} field(s), got {fields.len()}"))


pub trait ToKainValue:
    fn to_kain_value(_self: Self_) -> kain_core::runtime::Value:
        let __selfhost_empty = none

pub trait FromKainValue:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<Self_>:
        let __selfhost_empty = none

impl kain_host_derive::ToKainValue for kain_core::runtime::Value:
    fn to_kain_value(_self: kain_core::runtime::Value) -> kain_core::runtime::Value:
        _self


impl kain_host_derive::ToKainValue for ():
    fn to_kain_value(_self: ()) -> kain_core::runtime::Value:
        kain_core__runtime__Value__Unit


impl kain_host_derive::ToKainValue for Bool:
    fn to_kain_value(_self: Bool) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Bool(_self)


impl kain_host_derive::ToKainValue for i64:
    fn to_kain_value(_self: i64) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Int(_self)


impl kain_host_derive::ToKainValue for i32:
    fn to_kain_value(_self: i32) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Int(_self as i64)


impl kain_host_derive::ToKainValue for i16:
    fn to_kain_value(_self: i16) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Int(_self as i64)


impl kain_host_derive::ToKainValue for i8:
    fn to_kain_value(_self: i8) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Int(_self as i64)


impl kain_host_derive::ToKainValue for u32:
    fn to_kain_value(_self: u32) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Int(_self as i64)


impl kain_host_derive::ToKainValue for u64:
    fn to_kain_value(_self: u64) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Int(_self as i64)


impl kain_host_derive::ToKainValue for u16:
    fn to_kain_value(_self: u16) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Int(_self as i64)


impl kain_host_derive::ToKainValue for u8:
    fn to_kain_value(_self: u8) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Int(_self as i64)


impl kain_host_derive::ToKainValue for usize:
    fn to_kain_value(_self: usize) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Int(_self as i64)


impl kain_host_derive::ToKainValue for f64:
    fn to_kain_value(_self: f64) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Float(_self)


impl kain_host_derive::ToKainValue for f32:
    fn to_kain_value(_self: f32) -> kain_core::runtime::Value:
        kain_core__runtime__Value::Float(_self as f64)


impl kain_host_derive::ToKainValue for String:
    fn to_kain_value(_self: String) -> kain_core::runtime::Value:
        kain_core__runtime__Value::String(_self)


impl kain_host_derive::ToKainValue for String:
    fn to_kain_value(_self: String) -> kain_core::runtime::Value:
        kain_core__runtime__Value::String(_self.to_string())


impl<T> kain_host_derive::ToKainValue for Option<T>:
    fn to_kain_value(_self: Option<T>) -> kain_core::runtime::Value:
        match _self:
            Some(value) => kain_core__runtime__Value::Result(true, Box__new_(value.to_kain_value()))
            None => kain_core__runtime__Value__None


impl<T> kain_host_derive::ToKainValue for Array<T>:
    fn to_kain_value(_self: Array<T>) -> kain_core::runtime::Value:
        let values = _self.into_iter().map(ToKainValue__to_kain_value).collect()
        kain_core__runtime__Value::Array(Arc__new_(RwLock__new_(values)))


impl kain_host_derive::FromKainValue for kain_core::runtime::Value:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<kain_core::runtime::Value>:
        Result::Ok(value)


impl kain_host_derive::FromKainValue for ():
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<()>:
        match value:
            kain_core__runtime__Value::Unit => Result::Ok(())
            other => Result::Err(type_mismatch("Unit", &other))


impl kain_host_derive::FromKainValue for Bool:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<Bool>:
        match value:
            kain_core__runtime__Value::Bool(value) => Result::Ok(value)
            other => Result::Err(type_mismatch("Bool", &other))


impl kain_host_derive::FromKainValue for i64:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<i64>:
        match value:
            kain_core__runtime__Value::Int(value) => Result::Ok(value)
            other => Result::Err(type_mismatch("Int", &other))


impl kain_host_derive::FromKainValue for i32:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<i32>:
        let value = i64__from_kain_value(value)?
        i32__try_from(value).map_err(fn(_): KainError__runtime("Int value did not fit into i32"))


impl kain_host_derive::FromKainValue for i16:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<i16>:
        let value = i64__from_kain_value(value)?
        i16__try_from(value).map_err(fn(_): KainError__runtime("Int value did not fit into i16"))


impl kain_host_derive::FromKainValue for i8:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<i8>:
        let value = i64__from_kain_value(value)?
        i8__try_from(value).map_err(fn(_): KainError__runtime("Int value did not fit into i8"))


impl kain_host_derive::FromKainValue for u32:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<u32>:
        let value = i64__from_kain_value(value)?
        u32__try_from(value).map_err(fn(_): KainError__runtime("Int value did not fit into u32"))


impl kain_host_derive::FromKainValue for u64:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<u64>:
        let value = i64__from_kain_value(value)?
        u64__try_from(value).map_err(fn(_): KainError__runtime("Int value did not fit into u64"))


impl kain_host_derive::FromKainValue for u16:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<u16>:
        let value = i64__from_kain_value(value)?
        u16__try_from(value).map_err(fn(_): KainError__runtime("Int value did not fit into u16"))


impl kain_host_derive::FromKainValue for u8:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<u8>:
        let value = i64__from_kain_value(value)?
        u8__try_from(value).map_err(fn(_): KainError__runtime("Int value did not fit into u8"))


impl kain_host_derive::FromKainValue for usize:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<usize>:
        let value = i64__from_kain_value(value)?
        usize__try_from(value).map_err(fn(_): KainError__runtime("Int value did not fit into usize"))


impl kain_host_derive::FromKainValue for f64:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<f64>:
        match value:
            kain_core__runtime__Value::Float(value) => Result::Ok(value)
            kain_core__runtime__Value::Int(value) => Result::Ok(value as f64)
            other => Result::Err(type_mismatch("Float", &other))


impl kain_host_derive::FromKainValue for f32:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<f32>:
        Result::Ok(f64__from_kain_value(value)? as f32)


impl kain_host_derive::FromKainValue for String:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<String>:
        match value:
            kain_core__runtime__Value::String(value) => Result::Ok(value)
            other => Result::Err(type_mismatch("String", &other))


impl<T> kain_host_derive::FromKainValue for Option<T>:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<Option<T>>:
        match value:
            kain_core__runtime__Value::None => Result::Ok(none)
            kain_core__runtime__Value::Result(true, inner) => Result::Ok(Option::Some(T__from_kain_value((*inner))?))
            other => Result::Err(type_mismatch("Option", &other))


impl<T> kain_host_derive::FromKainValue for Array<T>:
    fn from_kain_value(value: kain_core::runtime::Value) -> HostResult<Array<T>>:
        match value:
            kain_core__runtime__Value::Array(values) =>
                let values = (values.read().map_err(fn(_): KainError__runtime("Failed to read array value"))?).clone()
                values.into_iter().map(T__from_kain_value).collect()
            other => Result::Err(type_mismatch("Array", &other))


pub struct HostSession:
    env: kain_core::runtime::Env
    native_functions: Map<String, NativeFunction>
    type_registry: kain_reflect::TypeRegistry
    prelude_config: HostPreludeConfig

impl HostSession:
    pub fn new_() -> HostSession:
        HostSession { env: Env__new_(), native_functions: BTreeMap__new_(), type_registry: TypeRegistry__new_(), prelude_config: HostPreludeConfig__default_() }

    pub fn env(_self: &HostSession) -> &kain_core::runtime::Env:
        &(*_self).env

    pub fn env_mut(_self: &mut HostSession) -> &mut kain_core::runtime::Env:
        &mut (*_self).env

    pub fn register_native_function(_self: &mut HostSession, native: NativeFunction) -> &mut HostSession:
        (*_self).env.register_native_fn(native.name.clone(), native.func)
        ()
        (*_self).native_functions.insert(native.name.clone(), native)
        ()
        *_self

    pub fn register_native_fn(_self: &mut HostSession, name: impl Into<String>, params: Array<NativeParam>, return_type: HostType, func: kain_core::runtime::NativeFn) -> &mut HostSession:
        (*_self).register_native_function(NativeFunction__new_(name, params, return_type, func))

    pub fn declare_native_fn(_self: &mut HostSession, name: impl Into<String>, params: Array<NativeParam>, return_type: HostType) -> &mut HostSession:
        let native = NativeFunction__new_(name, params, return_type, unresolved_native_stub)
        (*_self).native_functions.insert(native.name.clone(), native)
        ()
        *_self

    pub fn prelude_config(_self: &HostSession) -> &HostPreludeConfig:
        &(*_self).prelude_config

    pub fn prelude_config_mut(_self: &mut HostSession) -> &mut HostPreludeConfig:
        &mut (*_self).prelude_config

    pub fn set_prelude_module_name(_self: &mut HostSession, module_name: impl Into<String>) -> &mut HostSession:
        (*_self).prelude_config.module_name = module_name.into()
        ()
        *_self

    pub fn set_auto_use_prelude(_self: &mut HostSession, enabled: Bool) -> &mut HostSession:
        (*_self).prelude_config.auto_use_glob = enabled
        ()
        *_self

    pub fn type_registry(_self: &HostSession) -> &kain_reflect::TypeRegistry:
        &(*_self).type_registry

    pub fn type_registry_mut(_self: &mut HostSession) -> &mut kain_reflect::TypeRegistry:
        &mut (*_self).type_registry

    pub fn register_type<T>(_self: &mut HostSession) -> &mut HostSession:
        (*_self).type_registry.register_()
        ()
        *_self

    pub fn register_schema(_self: &mut HostSession, schema: kain_reflect::TypeSchema) -> &mut HostSession:
        (*_self).type_registry.register_schema(schema)
        ()
        *_self

    pub fn emit_type_prelude(_self: &HostSession) -> String:
        (*_self).type_registry.render_kain_prelude()

    pub fn emit_engine_module_source(_self: &HostSession) -> String:
        let mut body_sections = Vec__new_()
        let type_prelude = (*_self).emit_type_prelude()
        if (!type_prelude.trim().is_empty()):
            body_sections.push(type_prelude.trim().to_string())
            ()
            ()
            ()
            ()
        let native_prelude = (*_self).emit_native_prelude()
        if (!native_prelude.trim().is_empty()):
            body_sections.push(native_prelude.trim().to_string())
            ()
            ()
            ()
            ()
        if body_sections.is_empty():
            return String__new_()
        let mut output = body_sections.join("\n\n")
        if (!output.ends_with("\n")):
            output.push("\n")
            ()
            ()
            ()
            ()
        output

    pub fn emit_engine_import_source(_self: &HostSession) -> String:
        f"use {(*_self).prelude_config.module_name}::*\n"

    pub fn emit_engine_prelude(_self: &HostSession) -> String:
        let module_source = (*_self).emit_engine_module_source()
        if module_source.trim().is_empty():
            return String__new_()
        let body = indent_block(module_source.trim_end(), 4)
        let mut output = f"mod {(*_self).prelude_config.module_name}:\n{body}\n"
        if (*_self).prelude_config.auto_use_glob:
            output.push_str(&(*_self).emit_engine_import_source())
            ()
            ()
            ()
            ()
        output

    pub fn export_engine_module(_self: &HostSession, config: &EngineModuleExportConfig) -> HostResult<EngineModuleExport>:
        std__fs__create_dir_all(&(*config).output_dir).map_err(io_to_host_error)?
        ()
        let mut module_source = (*_self).emit_engine_module_source()
        if (*config).include_banner:
            module_source = f"# Generated by kain-host for module {(*config).module_name}\n# Regenerate from Rust reflection/native registrations.\n\n{module_source}"
            ()
            ()
            ()
            ()
        let module_path = config.module_path()
        std__fs__write(&module_path, &module_source).map_err(io_to_host_error)?
        ()
        let import_shim = config.import_shim_path().map(fn(path): none)
        match &import_shim:
            Some((path, source)) =>
                std__fs__write(path, source).map_err(io_to_host_error)?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        Result::Ok(EngineModuleExport { module_name: (*config).module_name.clone(), module_path: module_path, module_source: module_source, import_shim_path: import_shim.map(fn(__kain_closure_arg1): __kain_closure_arg1.__kain_tuple_0.clone()), import_shim_source: import_shim.map(fn(__kain_closure_arg2): __kain_closure_arg2.__kain_tuple_1) })

    pub fn set_global<V>(_self: &mut HostSession, name: impl Into<String>, value: V) -> &mut HostSession:
        (*_self).env.define_global(name, value.to_kain_value())
        ()
        *_self

    pub fn compile_source(_self: &HostSession, source: String) -> HostResult<kain_core::TypedProgram>:
        Result::Ok(((*_self).compile_checked_source(source)?).typed)

    pub fn compile_checked_source(_self: &HostSession, source: String) -> HostResult<kain_driver::CheckedFrontend>:
        let mut sections = Vec__new_()
        let engine_prelude = (*_self).emit_engine_prelude()
        if (!engine_prelude.trim().is_empty()):
            sections.push(engine_prelude)
            ()
            ()
            ()
            ()
        sections.push(source.to_string())
        ()
        let augmented = sections.join("\n")
        kain_driver__frontend_to_checked_program(&augmented, kain_core__CompileTarget__Interpret)

    pub fn load_program(_self: &mut HostSession, program: &kain_core::ast::Program) -> HostResult<&mut HostSession>:
        (*_self).env.register_program_items(program)?
        ()
        (*_self).rebind_natives()
        ()
        Result::Ok(*_self)

    pub fn load_typed_program(_self: &mut HostSession, program: &kain_core::TypedProgram) -> HostResult<&mut HostSession>:
        (*_self).env.register_typed_program(program)?
        ()
        (*_self).rebind_natives()
        ()
        Result::Ok(*_self)

    pub fn load_source(_self: &mut HostSession, source: String) -> HostResult<&mut HostSession>:
        let checked = (*_self).compile_checked_source(source)?
        (*_self).load_program(&checked.ast)

    pub fn run_main_value(_self: &mut HostSession) -> HostResult<kain_core::runtime::Value>:
        (*_self).call_value("main", Vec__new_())

    pub fn run_main<R>(_self: &mut HostSession) -> HostResult<R>:
        R__from_kain_value((*_self).run_main_value()?)

    pub fn call_value(_self: &mut HostSession, function_name: String, args: Array<kain_core::runtime::Value>) -> HostResult<kain_core::runtime::Value>:
        (*_self).env.call_named_function(function_name, args)

    pub fn call<R>(_self: &mut HostSession, function_name: String, args: Array<kain_core::runtime::Value>) -> HostResult<R>:
        R__from_kain_value((*_self).call_value(function_name, args)?)

    fn rebind_natives(_self: &mut HostSession):
        for native in (*_self).native_functions.values():
            (*_self).env.register_native_fn(native.name.clone(), native.func)
            ()

    fn emit_native_prelude(_self: &HostSession) -> String:
        let mut output = String__new_()
        for native in (*_self).native_functions.values():
            let params = native.params.iter().map(fn(param): f"{param.name}: {param.ty.render()}").collect().join(", ")
            output.push_str(&f"fn {native.name}({params}) -> {native.return_type.render()}:\n    return {native.return_type.default_literal()}\n\n")
            ()
        ()
        output


impl Default for HostSession:
    fn default_() -> HostSession:
        HostSession__new_()


fn type_mismatch(expected: String, value: &kain_core::runtime::Value) -> kain_core::error::KainError:
    KainError__runtime(f"Expected {expected}, got {value_kind(value)}")

fn indent_block(input: String, spaces: usize) -> String:
    let prefix = (" ").repeat(spaces)
    input.lines().map(fn(line_): if line_.trim().is_empty(): String__new_() else: f"{prefix}{line_}").collect().join("\n")

fn io_to_host_error(error: io::Error) -> kain_core::error::KainError:
    KainError__runtime(f"I/O error: {error}")

fn unresolved_native_stub(_env: &mut kain_core::runtime::Env, _args: Array<kain_core::runtime::Value>) -> HostResult<kain_core::runtime::Value>:
    Result::Err(KainError__runtime("Native function was declared for Kain export but not bound to a Rust implementation"))

fn value_kind(value: &kain_core::runtime::Value) -> String:
    match value:
        kain_core__runtime__Value::Unit => "Unit"
        kain_core__runtime__Value::Bool(_) => "Bool"
        kain_core__runtime__Value::Int(_) => "Int"
        kain_core__runtime__Value::Float(_) => "Float"
        kain_core__runtime__Value::String(_) => "String"
        kain_core__runtime__Value::Array(_) => "Array"
        kain_core__runtime__Value::Tuple(_) => "Tuple"
        kain_core__runtime__Value::Struct(_, _) => "Struct"
        kain_core__runtime__Value::HostObject(_, _) => "HostObject"
        kain_core__runtime__Value::Function(_) => "Function"
        kain_core__runtime__Value::Patch(_) => "Patch"
        kain_core__runtime__Value::Law(_) => "Law"
        kain_core__runtime__Value::Converge(_) => "Converge"
        kain_core__runtime__Value::Orchestrate(_) => "Orchestrate"
        kain_core__runtime__Value::NativeFn(_, _) => "NativeFn"
        kain_core__runtime__Value::ActorRef(_) => "ActorRef"
        kain_core__runtime__Value::None => "None"
        kain_core__runtime__Value::Return(_) => "Return"
        kain_core__runtime__Value::Break(_) => "Break"
        kain_core__runtime__Value::Continue => "Continue"
        kain_core__runtime__Value::Result(_, _) => "Result"
        kain_core__runtime__Value::Closure(_, _, _) => "Closure"
        kain_core__runtime__Value::StructConstructor(_, _) => "StructConstructor"
        kain_core__runtime__Value::JSX(_) => "JSX"
        kain_core__runtime__Value::EnumVariant(_, _, _) => "EnumVariant"
        kain_core__runtime__Value::Poll(_, _) => "Poll"
        kain_core__runtime__Value::Future(_, _) => "Future"

