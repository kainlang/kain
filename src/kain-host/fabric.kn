pub struct RustCrateAdapter:
    __selfhost_placeholder: Bool = false

impl FabricRuntimeAdapter for RustCrateAdapter:
    fn label(_self: &RustCrateAdapter) -> String:
        "rust-crate-ffi"

    fn supports(_self: &RustCrateAdapter, kind: &kain_omni::fabric::FabricRuntimeKind) -> Bool:
        match kind:
            kain_omni__fabric__FabricRuntimeKind::RustCrate => true
            _ => false

    fn execute(_self: &RustCrateAdapter, context: &FabricAdapterContext) -> Result<kain_core::runtime::Value, kain_omni::fabric::FabricFailureReason>:
        let crate_name = (*context).step.crate_name.ok_or_else(fn(): fabric_failure("missing_crate_name", f"Fabric step '{(*context).step.id}' is missing crate_name for runtime 'rust_crate'"))?
        let entry_path = (*context).step.entry.ok_or_else(fn(): fabric_failure("missing_entry", f"Fabric step '{(*context).step.id}' must declare entry for runtime 'rust_crate'"))?
        let resolved_entry = kain_omni__fabric__resolve_fabric_path((*context).workspace_root, entry_path)
        let entry_source = read_step_source(&resolved_entry, (*context).step, "Rust crate glue")?
        let resolved_manifest_path = resolve_runtime_manifest_path((*context).manifest_root, (*context).step).ok_or_else(fn(): fabric_failure("missing_manifest_path", f"Fabric step '{(*context).step.id}' with runtime 'rust_crate' requires manifest_path or a Cargo.toml beside the Fabric manifest"))?
        let imported = kain_crate_ffi__import_crate(crate_name, &kain_crate_ffi::ImportCrateOptions { manifest_path: Option::Some(resolved_manifest_path.clone()), mode: kain_crate_ffi__ArtifactMode__Both, ..ImportCrateOptions__default_() }, &kain_crate_ffi::PrepareContext { current_dir: Option::Some((*context).workspace_root.to_path_buf()), manifest_path: Option::Some(resolved_manifest_path) }).map_err(fn(err): runtime_bridge_failure((*context).step, "rust_crate_import_failed", err))?
        let fabric_entry_source = strip_runtime_module_import(&entry_source, "rust", crate_name.as_str())
        let source = f"{imported.canonical_module_source}\n{fabric_entry_source}"
        interpret_fabric_kain_source(context, &source)


pub struct CAbiAdapter:
    __selfhost_placeholder: Bool = false

impl FabricRuntimeAdapter for CAbiAdapter:
    fn label(_self: &CAbiAdapter) -> String:
        "c-abi-ffi"

    fn supports(_self: &CAbiAdapter, kind: &kain_omni::fabric::FabricRuntimeKind) -> Bool:
        match kind:
            kain_omni__fabric__FabricRuntimeKind::CAbi => true
            _ => false

    fn execute(_self: &CAbiAdapter, context: &FabricAdapterContext) -> Result<kain_core::runtime::Value, kain_omni::fabric::FabricFailureReason>:
        let entry_path = (*context).step.entry.ok_or_else(fn(): fabric_failure("missing_entry", f"Fabric step '{(*context).step.id}' must declare entry for runtime 'c_abi'"))?
        let resolved_entry = kain_omni__fabric__resolve_fabric_path((*context).workspace_root, entry_path)
        let entry_source = read_step_source(&resolved_entry, (*context).step, "C ABI glue")?
        let resolved_manifest_path = resolve_runtime_manifest_path((*context).manifest_root, (*context).step).ok_or_else(fn(): fabric_failure("missing_manifest_path", f"Fabric step '{(*context).step.id}' with runtime 'c_abi' requires manifest_path or a KAIN.toml beside the Fabric manifest"))?
        let import_name = (*context).step.module.clone().or_else(fn(): (*context).step.library.and_then(fn(library): library.file_stem()).and_then(fn(value): value.to_str()).map(str__to_string)).ok_or_else(fn(): fabric_failure("missing_import_name", f"Fabric step '{(*context).step.id}' with runtime 'c_abi' needs module or a library file stem so kain-host can resolve the C import name"))?
        let imported = kain_c_ffi__import_library(&import_name, &kain_c_ffi::ImportCOptions { mode: kain_c_ffi__ArtifactMode__Both, ..ImportCOptions__default_() }, &kain_c_ffi::PrepareContext { current_dir: Option::Some((*context).workspace_root.to_path_buf()), manifest_path: Option::Some(resolved_manifest_path) }).map_err(fn(err): runtime_bridge_failure((*context).step, "c_abi_import_failed", err))?
        validate_c_library_alignment((*context).step, &imported.resolved.shared_lib_path)?
        ()
        let fabric_entry_source = strip_runtime_module_import(&entry_source, "c", &import_name)
        let source = f"{imported.canonical_module_source}\n{fabric_entry_source}"
        interpret_fabric_kain_source(context, &source)


