pub struct FabricSession:
    manifest_path: std::path::PathBuf
    manifest_root: std::path::PathBuf
    manifest: kain_omni::fabric::FabricManifest
    validation: kain_omni::fabric::FabricValidationResult
    session_id: String
    workspace_root: std::path::PathBuf
    session_directory: std::path::PathBuf
    report_path: std::path::PathBuf
    lock_path: std::path::PathBuf
    events_path: Option<std::path::PathBuf>
    started_unix_ms: u128
    event_writer: FabricEventWriter

impl FabricSession:
    pub fn new_(manifest_path: &std::path::Path, manifest: kain_omni::fabric::FabricManifest) -> kain_omni::OmniResult<FabricSession>:
        let validation = kain_omni__fabric__validate_fabric_manifest(manifest_path, &manifest)?
        let manifest_root = manifest_path.parent().map(Path__to_path_buf).unwrap_or_else(fn(): PathBuf__from("."))
        let workspace_root = kain_omni__fabric__resolve_fabric_path(&manifest_root, &manifest.workspace.root)
        let report_root = kain_omni__fabric__resolve_fabric_path(&workspace_root, &manifest.reports.directory)
        std__fs__create_dir_all(&report_root)?
        ()
        let started_unix_ms = kain_omni__fabric__unix_timestamp_ms()
        let session_id = f"session-{started_unix_ms}-{std__process__id()}"
        let session_directory = report_root.join(&session_id)
        std__fs__create_dir_all(&session_directory)?
        ()
        let report_path = session_directory.join("report.json")
        let lock_path = session_directory.join("session.lock.json")
        let events_path = manifest.reports.emit_jsonl_events.then(fn(): session_directory.join("events.jsonl"))
        let mut event_writer = FabricEventWriter__new_(events_path)?
        event_writer.write(&kain_omni::fabric::FabricEventRecord { timestamp_unix_ms: started_unix_ms, kind: ("session_started").to_string(), step_id: none, runtime: none, status: none, message: f"Executing Fabric manifest {manifest_path.display()}", details: Option::Some(json!()) })?
        ()
        Result::Ok(FabricSession { manifest_path: manifest_path.to_path_buf(), manifest_root: manifest_root, manifest: manifest, validation: validation, session_id: session_id, workspace_root: workspace_root, session_directory: session_directory, report_path: report_path, lock_path: lock_path, events_path: events_path, started_unix_ms: started_unix_ms, event_writer: event_writer })

    pub fn log_event(_self: &mut FabricSession, kind: String, step: Option<&kain_omni::fabric::FabricStep>, message: impl Into<String>, details: Option<serde_json::Value>) -> kain_omni::OmniResult<()>:
        let timestamp_unix_ms = kain_omni__fabric__unix_timestamp_ms()
        (*_self).event_writer.write(&kain_omni::fabric::FabricEventRecord { timestamp_unix_ms: timestamp_unix_ms, kind: kind.to_string(), step_id: step.map(fn(s): s.id.clone()), runtime: step.map(fn(s): s.runtime.clone()), status: none, message: message.into(), details: details })

    pub fn log_step_event(_self: &mut FabricSession, kind: String, step: &kain_omni::fabric::FabricStep, status: kain_omni::fabric::FabricStepStatus, message: impl Into<String>, details: Option<serde_json::Value>) -> kain_omni::OmniResult<()>:
        let timestamp_unix_ms = kain_omni__fabric__unix_timestamp_ms()
        (*_self).event_writer.write(&kain_omni::fabric::FabricEventRecord { timestamp_unix_ms: timestamp_unix_ms, kind: kind.to_string(), step_id: Option::Some((*step).id.clone()), runtime: Option::Some((*step).runtime.clone()), status: Option::Some(status), message: message.into(), details: details })

    pub fn finish(_self: FabricSession, step_results: Array<kain_omni::fabric::FabricStepExecution>) -> kain_omni::OmniResult<kain_omni::fabric::FabricExecutionResult>:
        let finished_unix_ms = kain_omni__fabric__unix_timestamp_ms()
        let status = if step_results.iter().all(fn(result): (result.status == kain_omni__fabric__FabricStepStatus__Succeeded)):
            kain_omni__fabric__FabricSessionStatus__Succeeded
        else:
            kain_omni__fabric__FabricSessionStatus__Failed
        let result = kain_omni::fabric::FabricExecutionResult { manifest_path: _self.manifest_path.clone(), validation: _self.validation.clone(), session_id: _self.session_id.clone(), workspace_root: _self.workspace_root.clone(), session_directory: _self.session_directory.clone(), report_path: _self.report_path.clone(), lock_path: _self.lock_path.clone(), events_path: _self.events_path.clone(), status: status, started_unix_ms: _self.started_unix_ms, finished_unix_ms: finished_unix_ms, step_results: step_results }
        _self.log_event("session_finished", none, f"Fabric session finished with status {result.status}", Option::Some(json!()))?
        ()
        kain_omni__fabric__write_fabric_json(&_self.report_path, &result)?
        ()
        kain_omni__fabric__write_fabric_json(&_self.lock_path, &result)?
        ()
        Result::Ok(result)


pub struct FabricExecutor:
    adapters: Array<Box<impl FabricRuntimeAdapter>>

impl FabricExecutor:
    pub fn new_() -> FabricExecutor:
        FabricExecutor { adapters: [Box__new_(KainAdapter), Box__new_(PythonAdapter), Box__new_(RustCrateAdapter), Box__new_(CAbiAdapter), Box__new_(NodeAdapter), Box__new_(GpuComputeAdapter)] }

    pub fn execute(_self: &FabricExecutor, session: FabricSession) -> kain_omni::OmniResult<kain_omni::fabric::FabricExecutionResult>:
        let execution_order = kain_omni__fabric__topological_step_order(&session.manifest.steps)?
        let steps_by_id = session.manifest.steps.iter().cloned().map(fn(step): (step.id.clone(), step)).collect()
        let mut step_results = session.manifest.steps.iter().map(fn(step): none).collect()
        let mut produced_outputs = BTreeMap__new_()
        for step_id in &execution_order:
            let step = steps_by_id.get(step_id).ok_or_else(fn(): kain_omni__OmniError::Config(f"Fabric execution lost step definition for '{step_id}'"))?
            let blocked_by = step.depends_on.iter().filter(fn(dep): step_results.get((*dep)).is_some_and(fn(res): (res.status != kain_omni__fabric__FabricStepStatus__Succeeded))).cloned().collect()
            let step_result = step_results.get_mut(step_id).ok_or_else(fn(): kain_omni__OmniError::Config(f"Fabric execution lost step state for '{step_id}'"))?
            if (!blocked_by.is_empty()):
                let finished_unix_ms = kain_omni__fabric__unix_timestamp_ms()
                let failure = fabric_failure("blocked_dependencies", "Blocked by incomplete dependencies: {blocked_by.join(\", \")}")
                step_result.status = kain_omni__fabric__FabricStepStatus__Blocked
                ()
                step_result.finished_unix_ms = Option::Some(finished_unix_ms)
                ()
                step_result.error = Option::Some(failure.clone())
                ()
                session.log_step_event("step_blocked", step, kain_omni__fabric__FabricStepStatus__Blocked, failure.message, failure.details)?
                ()
                continue
            let (fabric_inputs, resolved_inputs) = match resolve_dependency_inputs(step, &steps_by_id, &produced_outputs):
                Ok(value) => value
                Err(failure) =>
                    let finished_unix_ms = kain_omni__fabric__unix_timestamp_ms()
                    step_result.status = kain_omni__fabric__FabricStepStatus__Failed
                    ()
                    step_result.finished_unix_ms = Option::Some(finished_unix_ms)
                    ()
                    step_result.error = Option::Some(failure.clone())
                    ()
                    session.log_step_event("step_failed", step, kain_omni__fabric__FabricStepStatus__Failed, failure.message, failure.details)?
                    ()
                    continue
            step_result.resolved_inputs = resolved_inputs.clone()
            ()
            let step_started_unix_ms = kain_omni__fabric__unix_timestamp_ms()
            step_result.started_unix_ms = Option::Some(step_started_unix_ms)
            ()
            session.log_step_event("step_started", step, kain_omni__fabric__FabricStepStatus__Pending, f"Executing Fabric step '{step.id}'", Option::Some(json!()))?
            ()
            let adapter = (*_self).adapters.iter().find(fn(a): a.supports(&step.runtime))
            match adapter:
                Some(adapter) =>
                    step_result.adapter = Option::Some(adapter.label().to_string())
                    ()
                    let context = FabricAdapterContext { manifest_path: &session.manifest_path, manifest_root: &session.manifest_root, workspace_root: &session.workspace_root, session_directory: &session.session_directory, step: step, fabric_inputs: fabric_inputs, resolved_inputs: &resolved_inputs }
                    match adapter.execute(&context):
                        Ok(raw_value) =>
                            match map_declared_outputs(step, raw_value):
                                Ok(mapped_outputs) =>
                                    let finished_unix_ms = kain_omni__fabric__unix_timestamp_ms()
                                    let public_outputs = mapped_outputs.iter().map(fn(output): output.public_()).collect()
                                    step_result.status = kain_omni__fabric__FabricStepStatus__Succeeded
                                    ()
                                    step_result.finished_unix_ms = Option::Some(finished_unix_ms)
                                    ()
                                    step_result.outputs = public_outputs
                                    ()
                                    produced_outputs.insert(step.id.clone(), mapped_outputs.into_iter().map(fn(output): (output.name.clone(), output)).collect())
                                    ()
                                    session.log_step_event("step_succeeded", step, kain_omni__fabric__FabricStepStatus__Succeeded, f"Step '{step.id}' completed", Option::Some(json!()))?
                                    ()
                                Err(failure) =>
                                    let finished_unix_ms = kain_omni__fabric__unix_timestamp_ms()
                                    step_result.status = kain_omni__fabric__FabricStepStatus__Failed
                                    ()
                                    step_result.finished_unix_ms = Option::Some(finished_unix_ms)
                                    ()
                                    step_result.error = Option::Some(failure.clone())
                                    ()
                                    session.log_step_event("step_failed", step, kain_omni__fabric__FabricStepStatus__Failed, failure.message, failure.details)?
                                    ()
                        Err(failure) =>
                            let finished_unix_ms = kain_omni__fabric__unix_timestamp_ms()
                            step_result.status = kain_omni__fabric__FabricStepStatus__Failed
                            ()
                            step_result.finished_unix_ms = Option::Some(finished_unix_ms)
                            ()
                            step_result.error = Option::Some(failure.clone())
                            ()
                            session.log_step_event("step_failed", step, kain_omni__fabric__FabricStepStatus__Failed, failure.message, failure.details)?
                            ()
                None =>
                    let finished_unix_ms = kain_omni__fabric__unix_timestamp_ms()
                    let failure = fabric_failure("unsupported_runtime", f"No adapter found for runtime '{step.runtime.display_name()}'")
                    step_result.status = kain_omni__fabric__FabricStepStatus__Failed
                    ()
                    step_result.finished_unix_ms = Option::Some(finished_unix_ms)
                    ()
                    step_result.error = Option::Some(failure.clone())
                    ()
                    session.log_step_event("step_failed", step, kain_omni__fabric__FabricStepStatus__Failed, failure.message, failure.details)?
                    ()
        ()
        let ordered_step_results = execution_order.into_iter().map(fn(id): step_results.remove(&id).unwrap()).collect()
        session.finish(ordered_step_results)


trait FabricRuntimeAdapter:
    fn label(_self: &Self_) -> String:
        let __selfhost_empty = none
    fn supports(_self: &Self_, kind: &kain_omni::fabric::FabricRuntimeKind) -> Bool:
        let __selfhost_empty = none
    fn execute(_self: &Self_, context: &FabricAdapterContext) -> Result<kain_core::runtime::Value, kain_omni::fabric::FabricFailureReason>:
        let __selfhost_empty = none

struct FabricAdapterContext<a>:
    manifest_path: &a std::path::Path
    manifest_root: &a std::path::Path
    workspace_root: &a std::path::Path
    session_directory: &a std::path::Path
    step: &a kain_omni::fabric::FabricStep
    fabric_inputs: kain_core::runtime::Value
    resolved_inputs: &a [kain_omni::fabric::FabricResolvedInputRecord]

@derive(Clone)
struct FabricStoredOutput:
    name: String
    declared_kind: kain_omni::fabric::FabricContractKind
    runtime_value: kain_core::runtime::Value
    payload: kain_omni::fabric::FabricOutputPayloadSnapshot

impl FabricStoredOutput:
    fn public_(_self: &FabricStoredOutput) -> kain_omni::fabric::FabricProducedOutput:
        kain_omni::fabric::FabricProducedOutput { name: (*_self).name.clone(), declared_kind: (*_self).declared_kind, payload: (*_self).payload.clone() }


struct FabricEventWriter:
    file: Option<std::fs::File>

impl FabricEventWriter:
    fn new_(path: Option<&std::path::Path>) -> kain_omni::OmniResult<FabricEventWriter>:
        let file = match path:
            Some(path) => Option::Some(File__create(path)?)
            None => none
        Result::Ok(FabricEventWriter { file: file })

    fn write(_self: &mut FabricEventWriter, event: &kain_omni::fabric::FabricEventRecord) -> kain_omni::OmniResult<()>:
        match &mut (*_self).file:
            Some(file) =>
                let encoded = serde_json__to_string(event).map_err(fn(err): kain_omni__OmniError::Config(f"Failed to serialize Fabric event: {err}"))?
                __kain_writeln_fmt!(file, encoded)?
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        Result::Ok(())


pub fn execute_fabric_manifest_path(path: &std::path::Path) -> kain_omni::OmniResult<kain_omni::fabric::FabricExecutionResult>:
    let manifest = kain_omni__fabric__load_fabric_manifest(path)?
    let session = FabricSession__new_(path, manifest)?
    let executor = FabricExecutor__new_()
    executor.execute(session)

pub struct KainAdapter:
    __selfhost_placeholder: Bool = false

impl FabricRuntimeAdapter for KainAdapter:
    fn label(_self: &KainAdapter) -> String:
        "kain-host"

    fn supports(_self: &KainAdapter, kind: &kain_omni::fabric::FabricRuntimeKind) -> Bool:
        match kind:
            kain_omni__fabric__FabricRuntimeKind::Kain => true
            _ => false

    fn execute(_self: &KainAdapter, context: &FabricAdapterContext) -> Result<kain_core::runtime::Value, kain_omni::fabric::FabricFailureReason>:
        let entry = (*context).step.entry.ok_or_else(fn(): fabric_failure("missing_entry", f"Fabric step '{(*context).step.id}' is missing an entry path for runtime 'kain'"))?
        let resolved_entry = kain_omni__fabric__resolve_fabric_path((*context).workspace_root, entry)
        let source = read_step_source(&resolved_entry, (*context).step, "Kain")?
        interpret_fabric_kain_source(context, &source)


