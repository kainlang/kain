use serde::Deserialize

use serde::Serialize

pub enum MatchType:
    Literal
    Regex
    Structured

@derive(Debug, Clone, PartialEq, Eq, serde__Serialize, serde__Deserialize, Default)
pub struct RuleScope:
    globs: Array<String>
    crate_names: Array<String>

impl Default for RuleScope:
    pub fn default_() -> RuleScope:
        RuleScope { globs: Vec__new_(), crate_names: Vec__new_() }


@derive(Debug, Clone, PartialEq, serde__Serialize, serde__Deserialize)
pub struct RepairRule:
    id: String
    description: String
    target_kind: String
    match_type: MatchType
    pattern: String
    replacement: String
    scope: RuleScope
    phase: Array<String>
    severity: String
    enabled: Bool
    confidence: Option<f64>
    notes: String

