use crate::material_graph::*

@doc(doc = " Builds a UE5 Material .uasset file programmatically using the unreal_asset library.")
@doc(doc = "")
@doc(doc = " Usage:")
@doc(doc = " ```ignore")
@doc(doc = " let mut b = MaterialAssetBuilder::new(\"M_Test\");")
@doc(doc = " let c1 = b.add_constant_node(0.5);")
@doc(doc = " let c2 = b.add_constant_node(0.3);")
@doc(doc = " let add = b.add_add_node(c1, c2);")
@doc(doc = " b.connect_to_base_color(add);")
@doc(doc = " let bytes = b.build()?;")
@doc(doc = " std::fs::write(\"M_Test.uasset\", bytes)?;")
@doc(doc = " ```")
pub struct MaterialAssetBuilder:
    asset: unreal_asset::Asset<std::io::Cursor<Array<u8>>>
    material_name: String
    engine_import: unreal_asset::types::PackageIndex
    core_uobject_import: unreal_asset::types::PackageIndex
    material_class_import: unreal_asset::types::PackageIndex
    class_imports: Map<String, unreal_asset::types::PackageIndex>
    material_export_index: unreal_asset::types::PackageIndex
    node_exports: Array<unreal_asset::types::PackageIndex>
    output_connections: Map<String, usize>
    blend_mode: u8
    shading_model: u8
    two_sided: Bool
    next_node_x: i32
    next_node_y: i32

impl MaterialAssetBuilder:
    pub fn new_(material_name: String, engine_target: ue5_asset_utils::KainEngineTarget) -> MaterialAssetBuilder:
        let mut asset = Asset__new_empty(engine_target.as_serializer_version())
        if engine_target.is_above_serializer_ceiling():
            log::debug!("MaterialAssetBuilder: targeting UE {engine_target} but serializing at {} format (highest known; UE{} will accept this file)", engine_target.serializer_ceiling(), engine_target)
            ()
            ()
        let core_uobject_import = ImportBuilder__get_or_add_package(&mut asset, "/Script/CoreUObject")
        let engine_import = ImportBuilder__get_or_add_package(&mut asset, "/Script/Engine")
        let material_class_import = ImportBuilder__get_or_add_class(&mut asset, "Material", engine_import)
        let mut builder = MaterialAssetBuilder { asset: asset, material_name: material_name.to_string(), engine_import: engine_import, core_uobject_import: core_uobject_import, material_class_import: material_class_import, class_imports: HashMap__new_(), material_export_index: PackageIndex__new_(1), node_exports: Vec__new_(), output_connections: HashMap__new_(), blend_mode: 0, shading_model: 1, two_sided: false, next_node_x: (-400), next_node_y: 0 }
        builder.create_material_export()
        ()
        builder

    fn get_expression_class_import(_self: &mut MaterialAssetBuilder, class_name: String) -> unreal_asset::types::PackageIndex:
        match (*_self).class_imports.get(class_name):
            Some(idx) => return idx
            _ =>
                ()
                ()
        let idx = ImportBuilder__get_or_add_class(&mut (*_self).asset, class_name, (*_self).engine_import)
        (*_self).class_imports.insert(class_name.to_string(), idx)
        ()
        idx

    fn create_material_export(_self: &mut MaterialAssetBuilder):
        let mat_name = (*_self).asset.add_fname(&(*_self).material_name)
        let base = unreal_asset::exports::BaseExport { class_index: (*_self).material_class_import, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: PackageIndex__new_(0), object_name: mat_name, object_flags: (unreal_asset__flags__EObjectFlags__RF_PUBLIC | unreal_asset__flags__EObjectFlags__RF_STANDALONE), is_asset: true, ..Default__default_() }
        let normal = unreal_asset::exports::NormalExport { base_export: base, extras: Vec__new_(), properties: Vec__new_() }
        (*_self).asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(normal))
        ()

    fn next_position(_self: &mut MaterialAssetBuilder) -> (i32, i32):
        let pos = ((*_self).next_node_x, (*_self).next_node_y)
        (*_self).next_node_y = ((*_self).next_node_y + 150)
        ()
        if ((*_self).next_node_y > 1500):
            (*_self).next_node_y = 0
            ()
            (*_self).next_node_x = ((*_self).next_node_x - 300)
            ()
            ()
            ()
            ()
        pos

    fn add_expression_export(_self: &mut MaterialAssetBuilder, ue_class: String, properties: Array<unreal_asset_properties::Property>) -> usize:
        let node_id = (*_self).node_exports.len()
        let class_import = (*_self).get_expression_class_import(ue_class)
        let obj_name = (*_self).asset.add_fname(&f"{ue_class}_{node_id}")
        let (pos_x, pos_y) = (*_self).next_position()
        let mut all_props = properties
        let ed_x_name = (*_self).asset.add_fname("MaterialExpressionEditorX")
        all_props.push((unreal_asset_properties::int_property::IntProperty { name: ed_x_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: pos_x }).into())
        ()
        let ed_y_name = (*_self).asset.add_fname("MaterialExpressionEditorY")
        all_props.push((unreal_asset_properties::int_property::IntProperty { name: ed_y_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: pos_y }).into())
        ()
        let mat_ref_name = (*_self).asset.add_fname("Material")
        all_props.push((unreal_asset_properties::object_property::ObjectProperty { name: mat_ref_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: (*_self).material_export_index }).into())
        ()
        let base = unreal_asset::exports::BaseExport { class_index: class_import, super_index: PackageIndex__new_(0), template_index: PackageIndex__new_(0), outer_index: (*_self).material_export_index, object_name: obj_name, object_flags: unreal_asset__flags__EObjectFlags__RF_PUBLIC, ..Default__default_() }
        let normal = unreal_asset::exports::NormalExport { base_export: base, extras: Vec__new_(), properties: all_props }
        (*_self).asset.asset_data.exports.push(unreal_asset__exports__Export::NormalExport(normal))
        ()
        let export_index = PackageIndex__new_((*_self).asset.asset_data.exports.len() as i32)
        (*_self).node_exports.push(export_index)
        ()
        node_id

    fn make_expression_ref(_self: &mut MaterialAssetBuilder, node_id: usize, output_index: i32) -> unreal_asset_properties::material_input_property::MaterialExpression:
        let export_idx = (*_self).node_exports[node_id]
        let export_ = &(*_self).asset.asset_data.exports[((export_idx.index - 1)) as usize]
        let expr_name = export_.get_base_export().object_name.clone()
        let empty_name = (*_self).asset.add_fname("None")
        let input_name = (*_self).asset.add_fname("None")
        unreal_asset_properties::material_input_property::MaterialExpression { name: empty_name, extras: [], output_index: output_index, input_name: input_name, expression_name: expr_name }

    fn make_input_property(_self: &mut MaterialAssetBuilder, prop_name: String, source_node: usize, output_index: i32) -> unreal_asset_properties::Property:
        let name = (*_self).asset.add_fname(prop_name)
        let expr = (*_self).make_expression_ref(source_node, output_index)
        (unreal_asset_properties::material_input_property::ExpressionInputProperty { name: name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, material_expression: expr }).into()

    pub fn add_constant_node(_self: &mut MaterialAssetBuilder, value: f32) -> usize:
        let r_name = (*_self).asset.add_fname("R")
        let props = [(unreal_asset_properties::int_property::FloatProperty { name: r_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: ordered_float__OrderedFloat(value) }).into()]
        (*_self).add_expression_export("MaterialExpressionConstant", props)

    pub fn add_constant3_node(_self: &mut MaterialAssetBuilder, r: f32, g: f32, b: f32) -> usize:
        let name = (*_self).asset.add_fname("Constant")
        let struct_type = (*_self).asset.add_fname("LinearColor")
        let color_struct = unreal_asset_properties::struct_property::StructProperty { name: name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, struct_type: Option::Some(struct_type), struct_guid: Option::Some(Default__default_()), serialize_none: true, value: [(unreal_asset_properties::color_property::LinearColorProperty { name: Default__default_(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, color: Color__new_(ordered_float__OrderedFloat(r), ordered_float__OrderedFloat(g), ordered_float__OrderedFloat(b), ordered_float__OrderedFloat(1)) }).into()] }
        (*_self).add_expression_export("MaterialExpressionConstant3Vector", [color_struct.into()])

    pub fn add_constant4_node(_self: &mut MaterialAssetBuilder, r: f32, g: f32, b: f32, a: f32) -> usize:
        let name = (*_self).asset.add_fname("Constant")
        let struct_type = (*_self).asset.add_fname("LinearColor")
        let color_struct = unreal_asset_properties::struct_property::StructProperty { name: name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, struct_type: Option::Some(struct_type), struct_guid: Option::Some(Default__default_()), serialize_none: true, value: [(unreal_asset_properties::color_property::LinearColorProperty { name: Default__default_(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, color: Color__new_(ordered_float__OrderedFloat(r), ordered_float__OrderedFloat(g), ordered_float__OrderedFloat(b), ordered_float__OrderedFloat(a)) }).into()] }
        (*_self).add_expression_export("MaterialExpressionConstant4Vector", [color_struct.into()])

    fn add_binary_op_node(_self: &mut MaterialAssetBuilder, ue_class: String, a: usize, b: usize) -> usize:
        let a_prop = (*_self).make_input_property("A", a, 0)
        let b_prop = (*_self).make_input_property("B", b, 0)
        (*_self).add_expression_export(ue_class, [a_prop, b_prop])

    pub fn add_add_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionAdd", a, b)

    pub fn add_subtract_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionSubtract", a, b)

    pub fn add_multiply_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionMultiply", a, b)

    pub fn add_divide_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionDivide", a, b)

    pub fn add_dot_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionDotProduct", a, b)

    pub fn add_cross_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionCrossProduct", a, b)

    pub fn add_min_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionMin", a, b)

    pub fn add_max_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionMax", a, b)

    pub fn add_power_node(_self: &mut MaterialAssetBuilder, base: usize, exponent: usize) -> usize:
        let base_prop = (*_self).make_input_property("Base", base, 0)
        let exp_prop = (*_self).make_input_property("Exponent", exponent, 0)
        (*_self).add_expression_export("MaterialExpressionPower", [base_prop, exp_prop])

    pub fn add_distance_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionDistance", a, b)

    pub fn add_append_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize) -> usize:
        (*_self).add_binary_op_node("MaterialExpressionAppendVector", a, b)

    fn add_unary_op_node(_self: &mut MaterialAssetBuilder, ue_class: String, input: usize) -> usize:
        let input_prop = (*_self).make_input_property("Input", input, 0)
        (*_self).add_expression_export(ue_class, [input_prop])

    pub fn add_normalize_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        let prop = (*_self).make_input_property("VectorInput", input, 0)
        (*_self).add_expression_export("MaterialExpressionNormalize", [prop])

    pub fn add_length_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionLength", input)

    pub fn add_abs_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionAbs", input)

    pub fn add_saturate_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionSaturate", input)

    pub fn add_frac_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionFrac", input)

    pub fn add_floor_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionFloor", input)

    pub fn add_ceil_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionCeil", input)

    pub fn add_round_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionRound", input)

    pub fn add_sqrt_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionSquareRoot", input)

    pub fn add_sine_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionSine", input)

    pub fn add_cosine_node(_self: &mut MaterialAssetBuilder, input: usize) -> usize:
        (*_self).add_unary_op_node("MaterialExpressionCosine", input)

    pub fn add_lerp_node(_self: &mut MaterialAssetBuilder, a: usize, b: usize, alpha: usize) -> usize:
        let a_prop = (*_self).make_input_property("A", a, 0)
        let b_prop = (*_self).make_input_property("B", b, 0)
        let alpha_prop = (*_self).make_input_property("Alpha", alpha, 0)
        (*_self).add_expression_export("MaterialExpressionLinearInterpolate", [a_prop, b_prop, alpha_prop])

    pub fn add_clamp_node(_self: &mut MaterialAssetBuilder, input: usize, min: usize, max: usize) -> usize:
        let input_prop = (*_self).make_input_property("Input", input, 0)
        let min_prop = (*_self).make_input_property("Min", min, 0)
        let max_prop = (*_self).make_input_property("Max", max, 0)
        (*_self).add_expression_export("MaterialExpressionClamp", [input_prop, min_prop, max_prop])

    pub fn add_texture_sample_node(_self: &mut MaterialAssetBuilder, uv: Option<usize>) -> usize:
        let mut props: Array<unreal_asset_properties::Property> = Vec__new_()
        match uv:
            Some(uv_node) =>
                props.push((*_self).make_input_property("Coordinates", uv_node, 0))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).add_expression_export("MaterialExpressionTextureSample", props)

    pub fn add_texture_sample_parameter(_self: &mut MaterialAssetBuilder, param_name: String, uv: Option<usize>) -> usize:
        let pname = (*_self).asset.add_fname("ParameterName")
        let mut props: Array<unreal_asset_properties::Property> = [(unreal_asset_properties::str_property::StrProperty { name: pname, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: Option::Some(param_name.to_string()) }).into()]
        match uv:
            Some(uv_node) =>
                props.push((*_self).make_input_property("Coordinates", uv_node, 0))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).add_expression_export("MaterialExpressionTextureSampleParameter2D", props)

    pub fn add_texture_coordinate_node(_self: &mut MaterialAssetBuilder, index: u32) -> usize:
        let idx_name = (*_self).asset.add_fname("CoordinateIndex")
        let props = [(unreal_asset_properties::int_property::IntProperty { name: idx_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: index as i32 }).into()]
        (*_self).add_expression_export("MaterialExpressionTextureCoordinate", props)

    pub fn add_component_mask_node(_self: &mut MaterialAssetBuilder, input: usize, r: Bool, g: Bool, b: Bool, a: Bool) -> usize:
        let input_prop = (*_self).make_input_property("Input", input, 0)
        let r_name = (*_self).asset.add_fname("R")
        let g_name = (*_self).asset.add_fname("G")
        let b_name = (*_self).asset.add_fname("B")
        let a_name = (*_self).asset.add_fname("A")
        let mut props = [input_prop]
        props.push((unreal_asset_properties::int_property::BoolProperty { name: r_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: r }).into())
        ()
        props.push((unreal_asset_properties::int_property::BoolProperty { name: g_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: g }).into())
        ()
        props.push((unreal_asset_properties::int_property::BoolProperty { name: b_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: b }).into())
        ()
        props.push((unreal_asset_properties::int_property::BoolProperty { name: a_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: a }).into())
        ()
        (*_self).add_expression_export("MaterialExpressionComponentMask", props)

    pub fn add_scalar_parameter_node(_self: &mut MaterialAssetBuilder, param_name: String, default_: f32) -> usize:
        let pname = (*_self).asset.add_fname("ParameterName")
        let default_name = (*_self).asset.add_fname("DefaultValue")
        let props = [Property__from(unreal_asset_properties::str_property::StrProperty { name: pname, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: Option::Some(param_name.to_string()) }), Property__from(unreal_asset_properties::int_property::FloatProperty { name: default_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: ordered_float__OrderedFloat(default_) })]
        (*_self).add_expression_export("MaterialExpressionScalarParameter", props)

    pub fn add_color_parameter_node(_self: &mut MaterialAssetBuilder, param_name: String, default_: [f32; 4]) -> usize:
        let pname = (*_self).asset.add_fname("ParameterName")
        let default_name = (*_self).asset.add_fname("DefaultValue")
        let struct_type = (*_self).asset.add_fname("LinearColor")
        let color_struct = unreal_asset_properties::struct_property::StructProperty { name: default_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, struct_type: Option::Some(struct_type), struct_guid: Option::Some(Default__default_()), serialize_none: true, value: [(unreal_asset_properties::color_property::LinearColorProperty { name: Default__default_(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, color: Color__new_(ordered_float__OrderedFloat(default_[0]), ordered_float__OrderedFloat(default_[1]), ordered_float__OrderedFloat(default_[2]), ordered_float__OrderedFloat(default_[3])) }).into()] }
        let props = [Property__from(unreal_asset_properties::str_property::StrProperty { name: pname, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: Option::Some(param_name.to_string()) }), color_struct.into()]
        (*_self).add_expression_export("MaterialExpressionVectorParameter", props)

    pub fn add_vector_parameter_node(_self: &mut MaterialAssetBuilder, param_name: String, default_: [f32; 3]) -> usize:
        let pname = (*_self).asset.add_fname("ParameterName")
        let default_name = (*_self).asset.add_fname("DefaultValue")
        let struct_type = (*_self).asset.add_fname("LinearColor")
        let color_struct = unreal_asset_properties::struct_property::StructProperty { name: default_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, struct_type: Option::Some(struct_type), struct_guid: Option::Some(Default__default_()), serialize_none: true, value: [(unreal_asset_properties::color_property::LinearColorProperty { name: Default__default_(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, color: Color__new_(ordered_float__OrderedFloat(default_[0]), ordered_float__OrderedFloat(default_[1]), ordered_float__OrderedFloat(default_[2]), ordered_float__OrderedFloat(1)) }).into()] }
        let props = [Property__from(unreal_asset_properties::str_property::StrProperty { name: pname, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: Option::Some(param_name.to_string()) }), color_struct.into()]
        (*_self).add_expression_export("MaterialExpressionVectorParameter", props)

    pub fn add_time_node(_self: &mut MaterialAssetBuilder) -> usize:
        (*_self).add_expression_export("MaterialExpressionTime", Vec__new_())

    pub fn add_fresnel_node(_self: &mut MaterialAssetBuilder, exponent: usize, base_reflect: usize) -> usize:
        let exp_prop = (*_self).make_input_property("ExponentIn", exponent, 0)
        let base_prop = (*_self).make_input_property("BaseReflectFractionIn", base_reflect, 0)
        (*_self).add_expression_export("MaterialExpressionFresnel", [exp_prop, base_prop])

    pub fn add_panner_node(_self: &mut MaterialAssetBuilder, coordinate: usize, speed_x: f32, speed_y: f32) -> usize:
        let coord_prop = (*_self).make_input_property("Coordinate", coordinate, 0)
        let sx_name = (*_self).asset.add_fname("SpeedX")
        let sy_name = (*_self).asset.add_fname("SpeedY")
        let props = [coord_prop, (unreal_asset_properties::int_property::FloatProperty { name: sx_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: ordered_float__OrderedFloat(speed_x) }).into(), (unreal_asset_properties::int_property::FloatProperty { name: sy_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: ordered_float__OrderedFloat(speed_y) }).into()]
        (*_self).add_expression_export("MaterialExpressionPanner", props)

    pub fn add_rotator_node(_self: &mut MaterialAssetBuilder, coordinate: usize, center: Option<usize>, angle: Option<usize>) -> usize:
        let mut props = [(*_self).make_input_property("Coordinate", coordinate, 0)]
        match center:
            Some(c) =>
                props.push((*_self).make_input_property("CenterPoint", c, 0))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match angle:
            Some(a) =>
                props.push((*_self).make_input_property("Time", a, 0))
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        (*_self).add_expression_export("MaterialExpressionRotator", props)

    pub fn add_material_function_call(_self: &mut MaterialAssetBuilder, function_path: String, inputs: &[(String, usize)]) -> usize:
        let mut props = Vec__new_()
        let func_import = ImportBuilder__resolve_object_import(&mut (*_self).asset, function_path)
        let func_name = (*_self).asset.add_fname("MaterialFunction")
        props.push((unreal_asset_properties::object_property::ObjectProperty { name: func_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: func_import }).into())
        ()
        for selfhost_for_item in inputs:
            let (input_name, node_id) = selfhost_for_item
            props.push((*_self).make_input_property(input_name, (*node_id), 0))
            ()
        ()
        (*_self).add_expression_export("MaterialExpressionMaterialFunctionCall", props)

    pub fn add_custom_hlsl_node(_self: &mut MaterialAssetBuilder, code: String, output_type: &CustomOutputType, inputs: &[(String, usize)]) -> usize:
        let code_name = (*_self).asset.add_fname("Code")
        let output_type_name = (*_self).asset.add_fname("OutputType")
        let cmot_value_str = match output_type:
            CustomOutputType::Float1 => "CMOT_Float1"
            CustomOutputType::Float2 => "CMOT_Float2"
            CustomOutputType::Float3 => "CMOT_Float3"
            CustomOutputType::Float4 => "CMOT_Float4"
        let output_enum_type = (*_self).asset.add_fname("ECustomMaterialOutputType")
        let output_value = (*_self).asset.add_fname(cmot_value_str)
        let mut props: Array<unreal_asset_properties::Property> = [(unreal_asset_properties::str_property::StrProperty { name: code_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: Option::Some(code.to_string()) }).into(), (unreal_asset_properties::enum_property::EnumProperty { name: output_type_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, enum_type: Option::Some(output_enum_type), inner_type: none, value: Option::Some(output_value) }).into()]
        for selfhost_for_item in inputs:
            let (input_name, node_id) = selfhost_for_item
            props.push((*_self).make_input_property(input_name, (*node_id), 0))
            ()
        ()
        (*_self).add_expression_export("MaterialExpressionCustom", props)

    pub fn add_material_layer_node(_self: &mut MaterialAssetBuilder, base: usize, blend: usize, mode: &LayerBlendMode, alpha: usize) -> usize:
        match mode:
            LayerBlendMode::Lerp => (*_self).add_lerp_node(base, blend, alpha)
            LayerBlendMode::Add =>
                let scaled_blend = (*_self).add_multiply_node(blend, alpha)
                (*_self).add_add_node(base, scaled_blend)
            LayerBlendMode::Multiply =>
                let multiplied = (*_self).add_multiply_node(base, blend)
                (*_self).add_lerp_node(base, multiplied, alpha)
            LayerBlendMode::Overlay =>
                let two = (*_self).add_constant_node(2)
                let one = (*_self).add_constant_node(1)
                let mul_part = (*_self).add_multiply_node(base, blend)
                let mul_doubled = (*_self).add_multiply_node(mul_part, two)
                let inv_base = (*_self).add_subtract_node(one, base)
                let inv_blend = (*_self).add_subtract_node(one, blend)
                let screen_inner = (*_self).add_multiply_node(inv_base, inv_blend)
                let screen_doubled = (*_self).add_multiply_node(screen_inner, two)
                let screen_part = (*_self).add_subtract_node(one, screen_doubled)
                let overlay = (*_self).add_lerp_node(mul_doubled, screen_part, base)
                (*_self).add_lerp_node(base, overlay, alpha)
            LayerBlendMode::Screen =>
                let one = (*_self).add_constant_node(1)
                let inv_base = (*_self).add_subtract_node(one, base)
                let inv_blend = (*_self).add_subtract_node(one, blend)
                let multiplied = (*_self).add_multiply_node(inv_base, inv_blend)
                let screen = (*_self).add_subtract_node(one, multiplied)
                (*_self).add_lerp_node(base, screen, alpha)

    pub fn add_material_layer_blend_node(_self: &mut MaterialAssetBuilder, layers: &[usize], modes: &[LayerBlendMode], alphas: &[usize]) -> usize:
        if layers.is_empty():
            panic("MaterialLayerBlend requires at least one layer")
            ()
            ()
        if (layers.len() == 1):
            return layers[0]
        if ((modes.len() != (layers.len() - 1)) || (alphas.len() != (layers.len() - 1))):
            panic(f"MaterialLayerBlend: modes and alphas must have length = layers.len() - 1. Got {layers.len()} layers, {modes.len()} modes, {alphas.len()} alphas")
            ()
            ()
        let mut result = layers[0]
        for i in range(1, layers.len()):
            result = (*_self).add_material_layer_node(result, layers[i], &modes[(i - 1)], alphas[(i - 1)])
            ()
        ()
        result

    pub fn add_world_position_node(_self: &mut MaterialAssetBuilder) -> usize:
        (*_self).add_expression_export("MaterialExpressionWorldPosition", Vec__new_())

    pub fn add_world_normal_node(_self: &mut MaterialAssetBuilder) -> usize:
        (*_self).add_expression_export("MaterialExpressionVertexNormalWS", Vec__new_())

    pub fn add_absolute_world_position_node(_self: &mut MaterialAssetBuilder) -> usize:
        (*_self).add_expression_export("MaterialExpressionAbsoluteWorldPosition", Vec__new_())

    pub fn add_camera_position_node(_self: &mut MaterialAssetBuilder) -> usize:
        (*_self).add_expression_export("MaterialExpressionCameraPositionWS", Vec__new_())

    pub fn add_object_position_node(_self: &mut MaterialAssetBuilder) -> usize:
        (*_self).add_expression_export("MaterialExpressionObjectPositionWS", Vec__new_())

    pub fn add_object_orientation_node(_self: &mut MaterialAssetBuilder) -> usize:
        (*_self).add_expression_export("MaterialExpressionObjectOrientation", Vec__new_())

    pub fn add_triplanar_sample_node(_self: &mut MaterialAssetBuilder, texture: usize, world_position: Option<usize>, blend_sharpness: f32) -> usize:
        let world_pos = match world_position:
            Some(pos) => pos
            None => (*_self).add_world_position_node()
        let world_normal = (*_self).add_world_normal_node()
        let code = f"// Triplanar texture sampling\n// Calculate blend weights based on world normal\nfloat3 blendWeights = abs(WorldNormal);\nblendWeights = pow(blendWeights, {blend_sharpness});\nblendWeights /= (blendWeights.x + blendWeights.y + blendWeights.z);\n\n// Sample texture from each axis\nfloat2 uvX = WorldPosition.zy;\nfloat2 uvY = WorldPosition.xz;\nfloat2 uvZ = WorldPosition.xy;\n\nfloat4 texX = Texture2DSample(Tex, TexSampler, uvX);\nfloat4 texY = Texture2DSample(Tex, TexSampler, uvY);\nfloat4 texZ = Texture2DSample(Tex, TexSampler, uvZ);\n\n// Blend samples\nreturn texX * blendWeights.x + texY * blendWeights.y + texZ * blendWeights.z;"
        let inputs = [(("Tex").to_string(), texture), (("WorldPosition").to_string(), world_pos), (("WorldNormal").to_string(), world_normal)]
        (*_self).add_custom_hlsl_node(&code, &CustomOutputType__Float4, &inputs)

    pub fn connect_to_base_color(_self: &mut MaterialAssetBuilder, node_id: usize):
        (*_self).output_connections.insert(("BaseColor").to_string(), node_id)
        ()

    pub fn connect_to_metallic(_self: &mut MaterialAssetBuilder, node_id: usize):
        (*_self).output_connections.insert(("Metallic").to_string(), node_id)
        ()

    pub fn connect_to_specular(_self: &mut MaterialAssetBuilder, node_id: usize):
        (*_self).output_connections.insert(("Specular").to_string(), node_id)
        ()

    pub fn connect_to_roughness(_self: &mut MaterialAssetBuilder, node_id: usize):
        (*_self).output_connections.insert(("Roughness").to_string(), node_id)
        ()

    pub fn connect_to_emissive(_self: &mut MaterialAssetBuilder, node_id: usize):
        (*_self).output_connections.insert(("EmissiveColor").to_string(), node_id)
        ()

    pub fn connect_to_opacity(_self: &mut MaterialAssetBuilder, node_id: usize):
        (*_self).output_connections.insert(("Opacity").to_string(), node_id)
        ()

    pub fn connect_to_normal(_self: &mut MaterialAssetBuilder, node_id: usize):
        (*_self).output_connections.insert(("Normal").to_string(), node_id)
        ()

    pub fn connect_to_ambient_occlusion(_self: &mut MaterialAssetBuilder, node_id: usize):
        (*_self).output_connections.insert(("AmbientOcclusion").to_string(), node_id)
        ()

    pub fn connect_to_world_position_offset(_self: &mut MaterialAssetBuilder, node_id: usize):
        (*_self).output_connections.insert(("WorldPositionOffset").to_string(), node_id)
        ()

    pub fn set_blend_mode(_self: &mut MaterialAssetBuilder, mode: &BlendMode):
        (*_self).blend_mode = none
        ()

    pub fn set_shading_model(_self: &mut MaterialAssetBuilder, model: &ShadingModel):
        (*_self).shading_model = none
        ()

    pub fn set_two_sided(_self: &mut MaterialAssetBuilder, two_sided: Bool):
        (*_self).two_sided = two_sided
        ()

    pub fn mark_parameter_dynamic(_self: &mut MaterialAssetBuilder, _param_name: String):
        let __selfhost_empty = none

    pub fn build(_self: MaterialAssetBuilder) -> Result<Array<u8>, String>:
        _self.finalize_material_export()
        ()
        _self.asset.rebuild_name_map()
        ()
        let mut output = Cursor__new_(Vec__new_())
        _self.asset.write_data(&mut output, none).map_err(fn(e): f"Failed to write .uasset: {e}")?
        ()
        Result::Ok(output.into_inner())

    fn finalize_material_export(_self: &mut MaterialAssetBuilder):
        let mut mat_props: Array<unreal_asset_properties::Property> = Vec__new_()
        let connections: Array<(String, usize)> = (*_self).output_connections.iter().map(fn(__kain_closure_arg0): (__kain_closure_arg0.__kain_tuple_0.clone(), (*__kain_closure_arg0.__kain_tuple_1))).collect()
        for selfhost_for_item in &connections:
            let (output_name, node_id) = selfhost_for_item
            let expr = (*_self).make_expression_ref((*node_id), 0)
            let prop_name = (*_self).asset.add_fname(output_name)
            let struct_type = (*_self).asset.add_fname("ColorMaterialInput")
            let inner = unreal_asset_properties::material_input_property::ColorMaterialInputProperty { name: prop_name.clone(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, material_expression: expr, value: Default__default_() }
            let wrapper = unreal_asset_properties::struct_property::StructProperty { name: prop_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, struct_type: Option::Some(struct_type), struct_guid: Option::Some(Default__default_()), serialize_none: true, value: [inner.into()] }
            mat_props.push(wrapper.into())
            ()
        ()
        if (!(*_self).node_exports.is_empty()):
            let expr_name = (*_self).asset.add_fname("Expressions")
            let inner_type = (*_self).asset.add_fname("ObjectProperty")
            let expr_values: Array<unreal_asset_properties::Property> = (*_self).node_exports.iter().map(fn(__kain_closure_arg1): (unreal_asset_properties::object_property::ObjectProperty { name: expr_name.clone(), ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: *__kain_closure_arg1 }).into()).collect()
            let arr_prop = unreal_asset_properties::array_property::ArrayProperty { name: expr_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, array_type: Option::Some(inner_type), value: expr_values, dummy_property: none }
            mat_props.push(arr_prop.into())
            ()
            ()
            ()
            ()
        if ((*_self).blend_mode != 0):
            let bm_name = (*_self).asset.add_fname("BlendMode")
            let bm_enum_type = (*_self).asset.add_fname("EBlendMode")
            let bm_value_str = blend_mode_fname((*_self).blend_mode)
            let bm_value = (*_self).asset.add_fname(bm_value_str)
            mat_props.push((unreal_asset_properties::enum_property::EnumProperty { name: bm_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, enum_type: Option::Some(bm_enum_type), inner_type: none, value: Option::Some(bm_value) }).into())
            ()
            ()
            ()
            ()
        if ((*_self).shading_model != 1):
            let sm_name = (*_self).asset.add_fname("ShadingModel")
            let sm_enum_type = (*_self).asset.add_fname("EMaterialShadingModel")
            let sm_value_str = shading_model_fname((*_self).shading_model)
            let sm_value = (*_self).asset.add_fname(sm_value_str)
            mat_props.push((unreal_asset_properties::enum_property::EnumProperty { name: sm_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, enum_type: Option::Some(sm_enum_type), inner_type: none, value: Option::Some(sm_value) }).into())
            ()
            ()
            ()
            ()
        if (*_self).two_sided:
            let ts_name = (*_self).asset.add_fname("TwoSided")
            mat_props.push((unreal_asset_properties::int_property::BoolProperty { name: ts_name, ancestry: Default__default_(), property_guid: none, duplication_index: 0, value: true }).into())
            ()
            ()
            ()
            ()
        match (*_self).asset.asset_data.exports.first_mut():
            Some(unreal_asset__exports__Export::NormalExport(mut normal)) =>
                normal.properties = mat_props
                ()
            _ => ()


@doc(doc = " Convert a MaterialGraph IR to .uasset bytes.")
@doc(doc = "")
@doc(doc = " `engine_target` controls the UE version the asset is built for.")
@doc(doc = " Pass `KainEngineTarget::default()` if you don't need to target a specific version.")
pub fn serialize_material_graph(graph: &MaterialGraph, engine_target: ue5_asset_utils::KainEngineTarget) -> Result<Array<u8>, String>:
    let mut builder = MaterialAssetBuilder__new_(&f"M_{(*graph).name}", engine_target)
    builder.set_blend_mode(&(*graph).properties.blend_mode)
    ()
    builder.set_shading_model(&(*graph).properties.shading_model)
    ()
    builder.set_two_sided((*graph).properties.two_sided)
    ()
    let mut node_map: Map<String, usize> = HashMap__new_()
    for node in &(*graph).nodes:
        let builder_id = convert_node(&mut builder, &node.node_type, &node_map)?
        node_map.insert(node.id.clone(), builder_id)
        ()
    ()
    match (*graph).outputs.base_color:
        Some(id) =>
            match node_map.get(id):
                Some(nid) =>
                    builder.connect_to_base_color(nid)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match (*graph).outputs.metallic:
        Some(id) =>
            match node_map.get(id):
                Some(nid) =>
                    builder.connect_to_metallic(nid)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match (*graph).outputs.specular:
        Some(id) =>
            match node_map.get(id):
                Some(nid) =>
                    builder.connect_to_specular(nid)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match (*graph).outputs.roughness:
        Some(id) =>
            match node_map.get(id):
                Some(nid) =>
                    builder.connect_to_roughness(nid)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match (*graph).outputs.emissive:
        Some(id) =>
            match node_map.get(id):
                Some(nid) =>
                    builder.connect_to_emissive(nid)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match (*graph).outputs.opacity:
        Some(id) =>
            match node_map.get(id):
                Some(nid) =>
                    builder.connect_to_opacity(nid)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match (*graph).outputs.normal:
        Some(id) =>
            match node_map.get(id):
                Some(nid) =>
                    builder.connect_to_normal(nid)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match (*graph).outputs.ambient_occlusion:
        Some(id) =>
            match node_map.get(id):
                Some(nid) =>
                    builder.connect_to_ambient_occlusion(nid)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match (*graph).outputs.world_position_offset:
        Some(id) =>
            match node_map.get(id):
                Some(nid) =>
                    builder.connect_to_world_position_offset(nid)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    builder.build()

@doc(doc = " Resolve a node ID reference to a builder node ID.")
fn resolve(node_map: &Map<String, usize>, id: String) -> Result<usize, String>:
    node_map.get(id).copied().ok_or_else(fn(): none)

@doc(doc = " Convert a single MaterialNodeType into builder calls.")
fn convert_node(builder: &mut MaterialAssetBuilder, node_type: &MaterialNodeType, node_map: &Map<String, usize>) -> Result<usize, String>:
    match node_type:
        MaterialNodeType::ConstantFloat { value: value } => Result::Ok(builder.add_constant_node((*value)))
        MaterialNodeType::ConstantVec3 { value: value } => Result::Ok(builder.add_constant3_node(value[0], value[1], value[2]))
        MaterialNodeType::ConstantVector3 { value: value } => Result::Ok(builder.add_constant3_node(value[0], value[1], value[2]))
        MaterialNodeType::ConstantVec4 { value: value } => Result::Ok(builder.add_constant4_node(value[0], value[1], value[2], value[3]))
        MaterialNodeType::ConstantVector4 { value: value } => Result::Ok(builder.add_constant4_node(value[0], value[1], value[2], value[3]))
        MaterialNodeType::ScalarParameter { name: name, default_: default_ } => Result::Ok(builder.add_scalar_parameter_node(name, (*default_)))
        MaterialNodeType::VectorParameter { name: name, default_: default_ } => Result::Ok(builder.add_vector_parameter_node(name, (*default_)))
        MaterialNodeType::ColorParameter { name: name, default_: default_ } => Result::Ok(builder.add_color_parameter_node(name, (*default_)))
        MaterialNodeType::Add { a: a, b: b } => Result::Ok(builder.add_add_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Subtract { a: a, b: b } => Result::Ok(builder.add_subtract_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Multiply { a: a, b: b } => Result::Ok(builder.add_multiply_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Divide { a: a, b: b } => Result::Ok(builder.add_divide_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Dot { a: a, b: b } => Result::Ok(builder.add_dot_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::DotProduct { a: a, b: b } => Result::Ok(builder.add_dot_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Cross { a: a, b: b } => Result::Ok(builder.add_cross_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Min { a: a, b: b } => Result::Ok(builder.add_min_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Max { a: a, b: b } => Result::Ok(builder.add_max_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Power { base: base, exponent: exponent } => Result::Ok(builder.add_power_node(resolve(node_map, base)?, resolve(node_map, exponent)?))
        MaterialNodeType::Distance { a: a, b: b } => Result::Ok(builder.add_distance_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Append { a: a, b: b } => Result::Ok(builder.add_append_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::AppendVector { a: a, b: b } => Result::Ok(builder.add_append_node(resolve(node_map, a)?, resolve(node_map, b)?))
        MaterialNodeType::Normalize { input: input } => Result::Ok(builder.add_normalize_node(resolve(node_map, input)?))
        MaterialNodeType::Length { input: input } => Result::Ok(builder.add_length_node(resolve(node_map, input)?))
        MaterialNodeType::Abs { input: input } => Result::Ok(builder.add_abs_node(resolve(node_map, input)?))
        MaterialNodeType::Saturate { input: input } => Result::Ok(builder.add_saturate_node(resolve(node_map, input)?))
        MaterialNodeType::Frac { input: input } => Result::Ok(builder.add_frac_node(resolve(node_map, input)?))
        MaterialNodeType::Floor { input: input } => Result::Ok(builder.add_floor_node(resolve(node_map, input)?))
        MaterialNodeType::Ceil { input: input } => Result::Ok(builder.add_ceil_node(resolve(node_map, input)?))
        MaterialNodeType::Round { input: input } => Result::Ok(builder.add_round_node(resolve(node_map, input)?))
        MaterialNodeType::Sqrt { input: input } => Result::Ok(builder.add_sqrt_node(resolve(node_map, input)?))
        MaterialNodeType::Exp { input: input } =>
            let node = resolve(node_map, input)?
            Result::Ok(builder.add_custom_hlsl_node("return exp(Input);", &CustomOutputType__Float1, &[(("Input").to_string(), node)]))
        MaterialNodeType::Log { input: input } =>
            let node = resolve(node_map, input)?
            Result::Ok(builder.add_custom_hlsl_node("return log(Input);", &CustomOutputType__Float1, &[(("Input").to_string(), node)]))
        MaterialNodeType::Sine { input: input } => Result::Ok(builder.add_sine_node(resolve(node_map, input)?))
        MaterialNodeType::Cosine { input: input } => Result::Ok(builder.add_cosine_node(resolve(node_map, input)?))
        MaterialNodeType::Lerp { a: a, b: b, alpha: alpha } => Result::Ok(builder.add_lerp_node(resolve(node_map, a)?, resolve(node_map, b)?, resolve(node_map, alpha)?))
        MaterialNodeType::Clamp { input: input, min: min, max: max } => Result::Ok(builder.add_clamp_node(resolve(node_map, input)?, resolve(node_map, min)?, resolve(node_map, max)?))
        MaterialNodeType::TextureSample { texture_input: texture_input, uv_input: uv_input } =>
            let uv = uv_input.and_then(fn(id): node_map.get(id)).copied()
            let node_id = builder.add_texture_sample_node(uv)
            match texture_input:
                Some(tex_id) =>
                    match node_map.get(tex_id):
                        Some(tex_node) =>
                            let _ = tex_node
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            Result::Ok(node_id)
        MaterialNodeType::TextureSampleParameter2D { param_name: param_name, uv_input: uv_input } =>
            let uv = uv_input.and_then(fn(id): node_map.get(id)).copied()
            Result::Ok(builder.add_texture_sample_parameter(param_name, uv))
        MaterialNodeType::TextureCoordinate { index: index } => Result::Ok(builder.add_texture_coordinate_node((*index)))
        MaterialNodeType::ComponentMask { input: input, mask: mask } =>
            let node = resolve(node_map, input)?
            let (r, g, b, a) = parse_mask(mask)
            Result::Ok(builder.add_component_mask_node(node, r, g, b, a))
        MaterialNodeType::Fresnel { exponent: exponent, base_reflect_fraction: base_reflect_fraction } => Result::Ok(builder.add_fresnel_node(resolve(node_map, exponent)?, resolve(node_map, base_reflect_fraction)?))
        MaterialNodeType::Time => Result::Ok(builder.add_time_node())
        MaterialNodeType::UVScroll { uv_input: uv_input, offset_x: offset_x, offset_y: offset_y } =>
            let uv = resolve(node_map, uv_input)?
            let ox = resolve(node_map, offset_x)?
            let oy = resolve(node_map, offset_y)?
            let time = builder.add_time_node()
            let scroll_x = builder.add_multiply_node(ox, time)
            let scroll_y = builder.add_multiply_node(oy, time)
            let scroll_vec = builder.add_append_node(scroll_x, scroll_y)
            Result::Ok(builder.add_add_node(uv, scroll_vec))
        MaterialNodeType::UVScale { uv_input: uv_input, scale_x: scale_x, scale_y: scale_y } =>
            let uv = resolve(node_map, uv_input)?
            let sx = resolve(node_map, scale_x)?
            let sy = resolve(node_map, scale_y)?
            let scale_vec = builder.add_append_node(sx, sy)
            Result::Ok(builder.add_multiply_node(uv, scale_vec))
        MaterialNodeType::UVRotate { uv_input: uv_input, angle: angle, center: center } =>
            let uv = resolve(node_map, uv_input)?
            let angle_node = node_map.get(angle.as_str()).copied()
            let center_node = center.and_then(fn(__kain_closure_arg2): node_map.get(__kain_closure_arg2.__kain_tuple_0.as_str()).copied())
            Result::Ok(builder.add_rotator_node(uv, center_node, angle_node))
        MaterialNodeType::MaterialFunctionCall { function_path: function_path, inputs: inputs } =>
            let resolved_inputs: Array<(String, usize)> = inputs.iter().enumerate().map(fn(__kain_closure_arg3): Result::Ok((f"Input_{__kain_closure_arg3.__kain_tuple_0}", resolve(node_map, __kain_closure_arg3.__kain_tuple_1)?))).collect()?
            Result::Ok(builder.add_material_function_call(function_path, &resolved_inputs))
        MaterialNodeType::CustomHLSL { code: code, output_type: output_type, inputs: inputs } =>
            let resolved: Array<(String, usize)> = inputs.iter().map(fn(ci): none).collect()?
            Result::Ok(builder.add_custom_hlsl_node(code, output_type, &resolved))
        MaterialNodeType::WorldPosition => Result::Ok(builder.add_world_position_node())
        MaterialNodeType::WorldNormal => Result::Ok(builder.add_world_normal_node())
        MaterialNodeType::AbsoluteWorldPosition => Result::Ok(builder.add_absolute_world_position_node())
        MaterialNodeType::CameraPosition => Result::Ok(builder.add_camera_position_node())
        MaterialNodeType::ObjectPosition => Result::Ok(builder.add_object_position_node())
        MaterialNodeType::ObjectOrientation => Result::Ok(builder.add_object_orientation_node())
        MaterialNodeType::TriplanarSample { texture: texture, world_position: world_position, blend_sharpness: blend_sharpness } =>
            let tex_node = resolve(node_map, texture)?
            let world_pos = world_position.map(fn(id): resolve(node_map, id)).transpose()?
            Result::Ok(builder.add_triplanar_sample_node(tex_node, world_pos, (*blend_sharpness)))
        MaterialNodeType::MaterialLayer { base_layer: base_layer, blend_layer: blend_layer, blend_mode: blend_mode, alpha: alpha } =>
            let base = resolve(node_map, base_layer)?
            let blend = resolve(node_map, blend_layer)?
            let alpha_node = resolve(node_map, alpha)?
            Result::Ok(builder.add_material_layer_node(base, blend, blend_mode, alpha_node))
        MaterialNodeType::MaterialLayerBlend { layers: layers, blend_modes: blend_modes, alphas: alphas } =>
            let layer_nodes: Result<Array<usize>, String> = layers.iter().map(fn(id): resolve(node_map, id)).collect()
            let alpha_nodes: Result<Array<usize>, String> = alphas.iter().map(fn(id): resolve(node_map, id)).collect()
            Result::Ok(builder.add_material_layer_blend_node(&layer_nodes?, blend_modes, &alpha_nodes?))

@doc(doc = " Map a BlendMode integer to the exact UE5 EBlendMode FName string.")
@doc(doc = " Values confirmed from UE5.4/5.7 EngineTypes.h.")
fn blend_mode_fname(mode: u8) -> String:
    match mode:
        0 => "BLEND_Opaque"
        1 => "BLEND_Masked"
        2 => "BLEND_Translucent"
        3 => "BLEND_Additive"
        4 => "BLEND_Modulate"
        5 => "BLEND_AlphaComposite"
        6 => "BLEND_AlphaHoldout"
        _ => "BLEND_Opaque"

@doc(doc = " Map a ShadingModel integer to the exact UE5 EMaterialShadingModel FName string.")
@doc(doc = " Values confirmed from UE5.4/5.7 EngineTypes.h.")
fn shading_model_fname(model: u8) -> String:
    match model:
        0 => "MSM_Unlit"
        1 => "MSM_DefaultLit"
        2 => "MSM_Subsurface"
        3 => "MSM_PreintegratedSkin"
        4 => "MSM_ClearCoat"
        5 => "MSM_SubsurfaceProfile"
        6 => "MSM_TwoSidedFoliage"
        7 => "MSM_Hair"
        8 => "MSM_Cloth"
        9 => "MSM_Eye"
        10 => "MSM_SingleLayerWater"
        11 => "MSM_ThinTranslucent"
        _ => "MSM_DefaultLit"

@doc(doc = " Parse a mask string like \"rgb\", \"r\", \"rg\", \"rgba\" into boolean flags.")
fn parse_mask(mask: String) -> (Bool, Bool, Bool, Bool):
    let m = mask.to_lowercase()
    (m.contains("r"), m.contains("g"), m.contains("b"), m.contains("a"))

