use crate::material_graph::*

@doc(doc = " Format an f32 as a valid C++ float literal (always includes decimal point + f suffix).")
@doc(doc = " e.g. 1.0 → \"1.0f\", 0.5 → \"0.5f\", 1 → \"1.0f\"")
fn cpp_float(v: f32) -> String:
    let s = v
    if s.contains("."):
        f"{s}f"
    else:
        f"{s}.0f"

pub struct MaterialFactoryGenerator:
    plugin_name: String

impl MaterialFactoryGenerator:
    pub fn new_(plugin_name: String) -> MaterialFactoryGenerator:
        MaterialFactoryGenerator { plugin_name: plugin_name }

    pub fn generate_factory_header(_self: &MaterialFactoryGenerator, graphs: &[MaterialGraph]) -> String:
        let mut header = "// Generated by KAIN - DO NOT EDIT\n#pragma once\n\n#include \"CoreMinimal.h\"\n#include \"Modules/ModuleManager.h\"\n\nclass F{(*_self).plugin_name}MaterialFactory\n{\npublic:\n    static void GenerateMaterials();\nprivate:\n"
        for graph in graphs:
            header.push_str(&f"    static void Generate_{graph.name}();\n")
            ()
        ()
        header.push_str("};\n\n")
        ()
        for graph in graphs:
            header.push_str(&(*_self).generate_parameter_struct(graph))
            ()
        ()
        for graph in graphs:
            if graph.properties.expose_parameters:
                header.push_str(&f"// Material Instance Dynamic helper for {graph.name}\nUFUNCTION(BlueprintCallable, Category=\"Material\")\nstatic UMaterialInstanceDynamic* Create{graph.name}MaterialInstance(UObject* Outer, const F{graph.name}MaterialParams& Params);\n\n")
                ()
        ()
        header

    pub fn generate_factory_cpp(_self: &MaterialFactoryGenerator, graphs: &[MaterialGraph]) -> String:
        let mut cpp = "// Generated by KAIN - DO NOT EDIT\n#include \"Generated/MaterialFactories.h\"\n#include \"AssetRegistry/AssetRegistryModule.h\"\n#include \"Materials/Material.h\"\n#include \"Materials/MaterialExpressionTextureSample.h\"\n#include \"Materials/MaterialExpressionTextureSampleParameter2D.h\"\n#include \"Materials/MaterialExpressionTextureCoordinate.h\"\n#include \"Materials/MaterialExpressionScalarParameter.h\"\n#include \"Materials/MaterialExpressionVectorParameter.h\"\n#include \"Materials/MaterialExpressionMultiply.h\"\n#include \"Materials/MaterialExpressionAdd.h\"\n#include \"Materials/MaterialExpressionSubtract.h\"\n#include \"Materials/MaterialExpressionDivide.h\"\n#include \"Materials/MaterialExpressionLinearInterpolate.h\"\n#include \"Materials/MaterialExpressionDotProduct.h\"\n#include \"Materials/MaterialExpressionComponentMask.h\"\n#include \"Materials/MaterialExpressionAppendVector.h\"\n#include \"Materials/MaterialExpressionConstant.h\"\n#include \"Materials/MaterialExpressionConstant3Vector.h\"\n#include \"Materials/MaterialExpressionConstant4Vector.h\"\n#include \"Materials/MaterialExpressionPower.h\"\n#include \"Materials/MaterialExpressionClamp.h\"\n#include \"Materials/MaterialExpressionFresnel.h\"\n#include \"Materials/MaterialExpressionMaterialFunctionCall.h\"\n#include \"Materials/MaterialFunction.h\"\n#include \"Materials/MaterialExpressionTime.h\"\n#include \"Materials/MaterialExpressionSine.h\"\n#include \"Materials/MaterialExpressionCosine.h\"\n#include \"Materials/MaterialExpressionWorldPosition.h\"\n#include \"Materials/MaterialExpressionVertexNormalWS.h\"\n#include \"Materials/MaterialInstanceDynamic.h\"\n#include \"UObject/SavePackage.h\"\n#include \"Misc/PackageName.h\"\n#include \"Misc/Paths.h\"\n#include \"HAL/FileManager.h\"\n\nvoid F{(*_self).plugin_name}MaterialFactory::GenerateMaterials()\n{\n#if WITH_EDITOR\n    // Create Content/Materials directory\n    FString ContentPath = FPaths::ProjectPluginsDir() / TEXT(\"{(*_self).plugin_name}/Content/Materials\");\n    IFileManager::Get().MakeDirectory(*ContentPath, true);\n    \n"
        for graph in graphs:
            cpp.push_str(&f"    Generate_{graph.name}();\n")
            ()
        ()
        cpp.push_str("#else\n    // Material graph construction is editor-only.\n#endif\n}\n\n")
        ()
        for graph in graphs:
            cpp.push_str(&(*_self).generate_material_function(graph))
            ()
        ()
        for graph in graphs:
            cpp.push_str(&(*_self).generate_mid_helper(graph))
            ()
        ()
        cpp

    fn generate_material_function(_self: &MaterialFactoryGenerator, graph: &MaterialGraph) -> String:
        let bare_name = (*graph).name.strip_prefix("M_").unwrap_or(&(*graph).name)
        let asset_name = f"M_{bare_name}"
        let mut code = "void F{(*_self).plugin_name}MaterialFactory::Generate_{(*graph).name}()\n{\n#if WITH_EDITOR\n    FString PackageName = TEXT(\"/{(*_self).plugin_name}/Materials/{asset_name}\");\n    UPackage* Package = CreatePackage(*PackageName);\n    Package->FullyLoad();\n    \n    UMaterial* Material = NewObject<UMaterial>(Package, TEXT(\"{asset_name}\"), RF_Public | RF_Standalone);\n    \n"
        for node in &(*graph).nodes:
            code.push_str(&(*_self).generate_node_code(node))
            ()
        ()
        code.push_str(&(*_self).generate_connections(graph))
        ()
        code.push_str(&(*_self).generate_material_properties(&(*graph).properties))
        ()
        code.push_str(&"    \n    // Compile material\n    Material->PreEditChange(nullptr);\n    Material->PostEditChange();\n    \n    // Save package\n    FSavePackageArgs SaveArgs;\n    SaveArgs.TopLevelFlags = RF_Public | RF_Standalone;\n    SaveArgs.SaveFlags = SAVE_NoError;\n    \n    FString PackageFileName = FPackageName::LongPackageNameToFilename(PackageName, FPackageName::GetAssetPackageExtension());\n    UPackage::SavePackage(Package, Material, *PackageFileName, SaveArgs);\n    \n    // Register with asset registry\n    FAssetRegistryModule::AssetCreated(Material);\n#endif\n}\n\n")
        ()
        code

    fn generate_node_code(_self: &MaterialFactoryGenerator, node: &MaterialNode) -> String:
        let (x, y) = (*node).position
        match &(*node).node_type:
            MaterialNodeType::TextureSample { texture_input: texture_input, uv_input: uv_input } => f"    UMaterialExpressionTextureSample* {(*node).id} = NewObject<UMaterialExpressionTextureSample>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::TextureSampleParameter2D { param_name: param_name, default_texture: default_texture, uv_input: uv_input } => f"    UMaterialExpressionTextureSampleParameter2D* {(*node).id} = NewObject<UMaterialExpressionTextureSampleParameter2D>(Material);\n    {(*node).id}->ParameterName = TEXT(\"{param_name}\");\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::ScalarParameter { name: name, default_: default_ } => f"    UMaterialExpressionScalarParameter* {(*node).id} = NewObject<UMaterialExpressionScalarParameter>(Material);\n    {(*node).id}->ParameterName = TEXT(\"{name}\");\n    {(*node).id}->DefaultValue = {cpp_float((*default_))};\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::VectorParameter { name: name, default_: default_ } => f"    UMaterialExpressionVectorParameter* {(*node).id} = NewObject<UMaterialExpressionVectorParameter>(Material);\n    {(*node).id}->ParameterName = TEXT(\"{name}\");\n    {(*node).id}->DefaultValue = FLinearColor({cpp_float(default_[0])}, {cpp_float(default_[1])}, {cpp_float(default_[2])}, 1.0f);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Multiply { a: a, b: b } => f"    UMaterialExpressionMultiply* {(*node).id} = NewObject<UMaterialExpressionMultiply>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Add { a: a, b: b } => f"    UMaterialExpressionAdd* {(*node).id} = NewObject<UMaterialExpressionAdd>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Subtract { a: a, b: b } => f"    UMaterialExpressionSubtract* {(*node).id} = NewObject<UMaterialExpressionSubtract>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Divide { a: a, b: b } => f"    UMaterialExpressionDivide* {(*node).id} = NewObject<UMaterialExpressionDivide>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Lerp { a: a, b: b, alpha: alpha } => f"    UMaterialExpressionLinearInterpolate* {(*node).id} = NewObject<UMaterialExpressionLinearInterpolate>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Power { base: base, exponent: exponent } => f"    UMaterialExpressionPower* {(*node).id} = NewObject<UMaterialExpressionPower>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Clamp { input: input, min: min, max: max } => f"    UMaterialExpressionClamp* {(*node).id} = NewObject<UMaterialExpressionClamp>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Fresnel { exponent: exponent, base_reflect_fraction: base_reflect_fraction } => f"    UMaterialExpressionFresnel* {(*node).id} = NewObject<UMaterialExpressionFresnel>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::ComponentMask { input: input, mask: mask } =>
                let (r, g, b, a) = match mask.as_str():
                    "R" => (true, false, false, false)
                    "G" => (false, true, false, false)
                    "B" => (false, false, true, false)
                    "A" => (false, false, false, true)
                    "RG" => (true, true, false, false)
                    "RGB" => (true, true, true, false)
                    "RGBA" => (true, true, true, true)
                    _ => (true, true, true, true)
                "    UMaterialExpressionComponentMask* {(*node).id} = NewObject<UMaterialExpressionComponentMask>(Material);\n    {(*node).id}->R = {if r: \"true\" else: \"false\"};\n    {(*node).id}->G = {if g: \"true\" else: \"false\"};\n    {(*node).id}->B = {if b: \"true\" else: \"false\"};\n    {(*node).id}->A = {if a: \"true\" else: \"false\"};\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::ConstantFloat { value: value } => f"    UMaterialExpressionConstant* {(*node).id} = NewObject<UMaterialExpressionConstant>(Material);\n    {(*node).id}->R = {cpp_float((*value))};\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::DotProduct {  } => (*_self).generate_node_code(&MaterialNode { id: (*node).id.clone(), node_type: MaterialNodeType::Dot { a: none, b: none }, position: (*node).position })
            MaterialNodeType::AppendVector {  } => (*_self).generate_node_code(&MaterialNode { id: (*node).id.clone(), node_type: MaterialNodeType::Append { a: none, b: none }, position: (*node).position })
            MaterialNodeType::ConstantVector3 { value: value } => (*_self).generate_node_code(&MaterialNode { id: (*node).id.clone(), node_type: MaterialNodeType::ConstantVec3 { value: (*value) }, position: (*node).position })
            MaterialNodeType::ConstantVector4 { value: value } => (*_self).generate_node_code(&MaterialNode { id: (*node).id.clone(), node_type: MaterialNodeType::ConstantVec4 { value: (*value) }, position: (*node).position })
            MaterialNodeType::ColorParameter { name: name, default_: default_ } => f"    UMaterialExpressionVectorParameter* {(*node).id} = NewObject<UMaterialExpressionVectorParameter>(Material);\n    {(*node).id}->ParameterName = TEXT(\"{name}\");\n    {(*node).id}->DefaultValue = FLinearColor({cpp_float(default_[0])}, {cpp_float(default_[1])}, {cpp_float(default_[2])}, {cpp_float(default_[3])});\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Dot { a: a, b: b } => f"    UMaterialExpressionDotProduct* {(*node).id} = NewObject<UMaterialExpressionDotProduct>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Append { a: a, b: b } => f"    UMaterialExpressionAppendVector* {(*node).id} = NewObject<UMaterialExpressionAppendVector>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::ConstantVec3 { value: value } => f"    UMaterialExpressionConstant3Vector* {(*node).id} = NewObject<UMaterialExpressionConstant3Vector>(Material);\n    {(*node).id}->Constant = FLinearColor({cpp_float(value[0])}, {cpp_float(value[1])}, {cpp_float(value[2])}, 1.0f);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::ConstantVec4 { value: value } => f"    UMaterialExpressionConstant4Vector* {(*node).id} = NewObject<UMaterialExpressionConstant4Vector>(Material);\n    {(*node).id}->Constant = FLinearColor({cpp_float(value[0])}, {cpp_float(value[1])}, {cpp_float(value[2])}, {cpp_float(value[3])});\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::TextureCoordinate { index: index, tiling: tiling } => f"    UMaterialExpressionTextureCoordinate* {(*node).id} = NewObject<UMaterialExpressionTextureCoordinate>(Material);\n    {(*node).id}->CoordinateIndex = {index};\n    {(*node).id}->UTiling = {cpp_float(tiling[0])};\n    {(*node).id}->VTiling = {cpp_float(tiling[1])};\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Cross { a: a, b: b } => f"    UMaterialExpressionCrossProduct* {(*node).id} = NewObject<UMaterialExpressionCrossProduct>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Normalize { input: input } => f"    UMaterialExpressionNormalize* {(*node).id} = NewObject<UMaterialExpressionNormalize>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Length { input: input } => f"    UMaterialExpressionLength* {(*node).id} = NewObject<UMaterialExpressionLength>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Distance { a: a, b: b } => f"    UMaterialExpressionDistance* {(*node).id} = NewObject<UMaterialExpressionDistance>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Abs { input: input } => f"    UMaterialExpressionAbs* {(*node).id} = NewObject<UMaterialExpressionAbs>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Min { a: a, b: b } => f"    UMaterialExpressionMin* {(*node).id} = NewObject<UMaterialExpressionMin>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Max { a: a, b: b } => f"    UMaterialExpressionMax* {(*node).id} = NewObject<UMaterialExpressionMax>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Saturate { input: input } => f"    UMaterialExpressionSaturate* {(*node).id} = NewObject<UMaterialExpressionSaturate>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Frac { input: input } => f"    UMaterialExpressionFrac* {(*node).id} = NewObject<UMaterialExpressionFrac>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Floor { input: input } => f"    UMaterialExpressionFloor* {(*node).id} = NewObject<UMaterialExpressionFloor>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Ceil { input: input } => f"    UMaterialExpressionCeil* {(*node).id} = NewObject<UMaterialExpressionCeil>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Round { input: input } => f"    UMaterialExpressionRound* {(*node).id} = NewObject<UMaterialExpressionRound>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Sqrt { input: input } => f"    UMaterialExpressionSquareRoot* {(*node).id} = NewObject<UMaterialExpressionSquareRoot>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Exp { input: input } => f"    UMaterialExpressionExponential* {(*node).id} = NewObject<UMaterialExpressionExponential>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Log { input: input } => f"    UMaterialExpressionLogarithm* {(*node).id} = NewObject<UMaterialExpressionLogarithm>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Sine { input: input } => f"    UMaterialExpressionSine* {(*node).id} = NewObject<UMaterialExpressionSine>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::Cosine { input: input } => f"    UMaterialExpressionCosine* {(*node).id} = NewObject<UMaterialExpressionCosine>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::CustomHLSL { code: code, output_type: output_type, inputs: inputs } =>
                let output_type_enum = match output_type:
                    material_graph__CustomOutputType::Float1 => "CMOT_Float1"
                    material_graph__CustomOutputType::Float2 => "CMOT_Float2"
                    material_graph__CustomOutputType::Float3 => "CMOT_Float3"
                    material_graph__CustomOutputType::Float4 => "CMOT_Float4"
                let mut result = "    UMaterialExpressionCustom* {(*node).id} = NewObject<UMaterialExpressionCustom>(Material);\n    {(*node).id}->Code = TEXT(\"{code.replace(\"\\\"\", \"\\\\\\\"\").replace(\"\\n\", \"\\\\n\")}\");\n    {(*node).id}->OutputType = {output_type_enum};\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n"
                for input in inputs:
                    let input_type_enum = match input.input_type:
                        material_graph__CustomOutputType::Float1 => "CMOT_Float1"
                        material_graph__CustomOutputType::Float2 => "CMOT_Float2"
                        material_graph__CustomOutputType::Float3 => "CMOT_Float3"
                        material_graph__CustomOutputType::Float4 => "CMOT_Float4"
                    result.push_str(&"    {\n        FCustomInput CustomInput;\n        CustomInput.InputName = TEXT(\"{input.name}\");\n        {(*node).id}->Inputs.Add(CustomInput);\n    }\n")
                    ()
                ()
                result.push_str(&f"    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n")
                ()
                result
            MaterialNodeType::UVScroll { uv_input: uv_input, offset_x: offset_x, offset_y: offset_y } => f"    // UVScroll node - splits UV, adds offsets, recombines\n    // Note: This is a placeholder - actual implementation will be wired in generate_connections\n    UMaterialExpressionAdd* {(*node).id} = NewObject<UMaterialExpressionAdd>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::UVScale { uv_input: uv_input, scale_x: scale_x, scale_y: scale_y } => f"    // UVScale node - multiplies UV by scale factors\n    // Note: This is a placeholder - actual implementation will be wired in generate_connections\n    UMaterialExpressionMultiply* {(*node).id} = NewObject<UMaterialExpressionMultiply>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::UVRotate { uv_input: uv_input, angle: angle, center: center } => f"    // UVRotate node - rotates UV around center point\n    // Note: This is a placeholder - actual rotation matrix will be wired in generate_connections\n    UMaterialExpressionAdd* {(*node).id} = NewObject<UMaterialExpressionAdd>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::MaterialFunctionCall { function_path: function_path, inputs: inputs } =>
                let mut result = "    UMaterialExpressionMaterialFunctionCall* {(*node).id} = NewObject<UMaterialExpressionMaterialFunctionCall>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    \n    // Load the material function asset\n    UMaterialFunction* Function_{(*node).id} = LoadObject<UMaterialFunction>(nullptr, TEXT(\"{function_path}\"));\n    if (Function_{(*node).id})\n    {\n        {(*node).id}->SetMaterialFunction(Function_{(*node).id});\n    }\n    else\n    {\n        UE_LOG(LogTemp, Warning, TEXT(\"Failed to load material function: {function_path}\"));\n    }\n    \n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
                result
            MaterialNodeType::WorldPosition => f"    UMaterialExpressionWorldPosition* {(*node).id} = NewObject<UMaterialExpressionWorldPosition>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::WorldNormal => f"    UMaterialExpressionVertexNormalWS* {(*node).id} = NewObject<UMaterialExpressionVertexNormalWS>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::AbsoluteWorldPosition => f"    UMaterialExpressionAbsoluteWorldPosition* {(*node).id} = NewObject<UMaterialExpressionAbsoluteWorldPosition>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::CameraPosition => f"    UMaterialExpressionCameraPositionWS* {(*node).id} = NewObject<UMaterialExpressionCameraPositionWS>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::ObjectPosition => f"    UMaterialExpressionObjectPositionWS* {(*node).id} = NewObject<UMaterialExpressionObjectPositionWS>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::ObjectOrientation => f"    UMaterialExpressionObjectOrientation* {(*node).id} = NewObject<UMaterialExpressionObjectOrientation>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::TriplanarSample {  } => f"    // Triplanar sample node {(*node).id} (implemented via CustomHLSL)\n    \n"
            MaterialNodeType::Time => f"    UMaterialExpressionTime* {(*node).id} = NewObject<UMaterialExpressionTime>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::MaterialLayer { base_layer: base_layer, blend_layer: blend_layer, blend_mode: blend_mode, alpha: alpha } =>
                let blend_fn = match blend_mode:
                    LayerBlendMode::Lerp => "LinearInterpolate"
                    LayerBlendMode::Add => "Add"
                    LayerBlendMode::Multiply => "Multiply"
                    LayerBlendMode::Overlay => "LinearInterpolate"
                    LayerBlendMode::Screen => "LinearInterpolate"
                f"    UMaterialExpression{blend_fn}* {(*node).id} = NewObject<UMaterialExpression{blend_fn}>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"
            MaterialNodeType::MaterialLayerBlend { layers: layers, blend_modes: blend_modes, alphas: alphas } => f"    UMaterialExpressionLinearInterpolate* {(*node).id} = NewObject<UMaterialExpressionLinearInterpolate>(Material);\n    {(*node).id}->MaterialExpressionEditorX = {x};\n    {(*node).id}->MaterialExpressionEditorY = {y};\n    Material->GetExpressionCollection().AddExpression({(*node).id});\n    \n"

    fn generate_connections(_self: &MaterialFactoryGenerator, graph: &MaterialGraph) -> String:
        let mut code = String__new_()
        for node in &(*graph).nodes:
            match &node.node_type:
                MaterialNodeType::Multiply { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Add { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Subtract { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Divide { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Lerp { a: a, b: b, alpha: alpha } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                    code.push_str(&f"    {node.id}->Alpha.Expression = {alpha};\n")
                    ()
                MaterialNodeType::Dot { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::DotProduct { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Append { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::AppendVector { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Power { base: base, exponent: exponent } =>
                    code.push_str(&f"    {node.id}->Base.Expression = {base};\n")
                    ()
                    code.push_str(&f"    {node.id}->Exponent.Expression = {exponent};\n")
                    ()
                MaterialNodeType::Clamp { input: input, min: min, max: max } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                    code.push_str(&f"    {node.id}->Min.Expression = {min};\n")
                    ()
                    code.push_str(&f"    {node.id}->Max.Expression = {max};\n")
                    ()
                MaterialNodeType::Fresnel { exponent: exponent, base_reflect_fraction: base_reflect_fraction } =>
                    code.push_str(&f"    {node.id}->ExponentIn.Expression = {exponent};\n")
                    ()
                    code.push_str(&f"    {node.id}->BaseReflectFractionIn.Expression = {base_reflect_fraction};\n")
                    ()
                MaterialNodeType::ComponentMask { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::TextureSample { texture_input: texture_input, uv_input: uv_input } =>
                    match texture_input:
                        Some(tex) =>
                            code.push_str(&f"    {node.id}->Texture = {tex};\n")
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    match uv_input:
                        Some(uv) =>
                            code.push_str(&f"    {node.id}->Coordinates.Expression = {uv};\n")
                            ()
                        _ => ()
                MaterialNodeType::TextureSampleParameter2D { uv_input: uv_input } =>
                    match uv_input:
                        Some(uv) =>
                            code.push_str(&f"    {node.id}->Coordinates.Expression = {uv};\n")
                            ()
                        _ => ()
                MaterialNodeType::Cross { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Normalize { input: input } =>
                    code.push_str(&f"    {node.id}->VectorInput.Expression = {input};\n")
                    ()
                MaterialNodeType::Length { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Distance { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Abs { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Min { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Max { a: a, b: b } =>
                    code.push_str(&f"    {node.id}->A.Expression = {a};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {b};\n")
                    ()
                MaterialNodeType::Saturate { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Frac { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Floor { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Ceil { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Round { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Sqrt { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Exp { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Log { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Sine { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::Cosine { input: input } =>
                    code.push_str(&f"    {node.id}->Input.Expression = {input};\n")
                    ()
                MaterialNodeType::UVScroll { uv_input: uv_input, offset_x: offset_x, offset_y: offset_y } =>
                    code.push_str(&f"    {node.id}->A.Expression = {uv_input};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {offset_x};\n")
                    ()
                MaterialNodeType::UVScale { uv_input: uv_input, scale_x: scale_x, scale_y: scale_y } =>
                    code.push_str(&f"    {node.id}->A.Expression = {uv_input};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {scale_x};\n")
                    ()
                MaterialNodeType::UVRotate { uv_input: uv_input, angle: angle, center: center } =>
                    code.push_str(&f"    {node.id}->A.Expression = {uv_input};\n")
                    ()
                    code.push_str(&f"    {node.id}->B.Expression = {angle};\n")
                    ()
                MaterialNodeType::MaterialFunctionCall { inputs: inputs } =>
                    for selfhost_for_item in inputs.iter().enumerate():
                        let (i, input_id) = selfhost_for_item
                        code.push_str(&f"    if ({node.id}->FunctionInputs.IsValidIndex({i}))\n")
                        ()
                        code.push_str(&f"        {node.id}->FunctionInputs[{i}].Input.Expression = {input_id};\n")
                        ()
                MaterialNodeType::TriplanarSample { texture: texture, world_position: world_position } =>
                    code.push_str(&f"    // Triplanar sample connections for {node.id}\n")
                    ()
                    code.push_str(&f"    // Texture: {texture}\n")
                    ()
                    match world_position:
                        Some(pos) =>
                            code.push_str(&f"    // World Position: {pos}\n")
                            ()
                        _ => ()
                _ => ()
        ()
        code.push_str("\n")
        ()
        match &(*graph).outputs.base_color:
            Some(base_color) =>
                code.push_str(&f"    Material->GetEditorOnlyData()->BaseColor.Expression = {base_color};\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &(*graph).outputs.emissive:
            Some(emissive) =>
                code.push_str(&f"    Material->GetEditorOnlyData()->EmissiveColor.Expression = {emissive};\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &(*graph).outputs.roughness:
            Some(roughness) =>
                code.push_str(&f"    Material->GetEditorOnlyData()->Roughness.Expression = {roughness};\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &(*graph).outputs.metallic:
            Some(metallic) =>
                code.push_str(&f"    Material->GetEditorOnlyData()->Metallic.Expression = {metallic};\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &(*graph).outputs.normal:
            Some(normal) =>
                code.push_str(&f"    Material->GetEditorOnlyData()->Normal.Expression = {normal};\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &(*graph).outputs.opacity:
            Some(opacity) =>
                code.push_str(&f"    Material->GetEditorOnlyData()->Opacity.Expression = {opacity};\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &(*graph).outputs.ambient_occlusion:
            Some(ao) =>
                code.push_str(&f"    Material->GetEditorOnlyData()->AmbientOcclusion.Expression = {ao};\n")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        match &(*graph).outputs.world_position_offset:
            Some(wpo) =>
                code.push_str(&f"    Material->GetEditorOnlyData()->WorldPositionOffset.Expression = {wpo};\n")
                ()
                code.push_str("    // WorldPositionOffset enables vertex displacement in the vertex shader stage\n")
                ()
                match (*graph).vertex_displacement_scale:
                    Some(scale) =>
                        code.push_str(&f"    // Displacement scale: {scale}x\n")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        code

    fn generate_material_properties(_self: &MaterialFactoryGenerator, props: &MaterialProperties) -> String:
        let blend_mode = match (*props).blend_mode:
            BlendMode::Opaque => "BLEND_Opaque"
            BlendMode::Masked => "BLEND_Masked"
            BlendMode::Translucent => "BLEND_Translucent"
            BlendMode::Additive => "BLEND_Additive"
            BlendMode::Modulate => "BLEND_Modulate"
        let shading_model = match (*props).shading_model:
            ShadingModel::DefaultLit => "MSM_DefaultLit"
            ShadingModel::Unlit => "MSM_Unlit"
            ShadingModel::Subsurface => "MSM_Subsurface"
            ShadingModel::PreintegratedSkin => "MSM_PreintegratedSkin"
            ShadingModel::ClearCoat => "MSM_ClearCoat"
            ShadingModel::SubsurfaceProfile => "MSM_SubsurfaceProfile"
            ShadingModel::TwoSidedFoliage => "MSM_TwoSidedFoliage"
            ShadingModel::Hair => "MSM_Hair"
            ShadingModel::Cloth => "MSM_Cloth"
            ShadingModel::Eye => "MSM_Eye"
        "    Material->BlendMode = {blend_mode};\n    Material->SetShadingModel({shading_model});\n    Material->TwoSided = {if (*props).two_sided: \"true\" else: \"false\"};\n    \n"

    fn generate_parameter_struct(_self: &MaterialFactoryGenerator, graph: &MaterialGraph) -> String:
        if ((!(*graph).properties.expose_parameters) || (*graph).dynamic_parameters.is_empty()):
            return String__new_()
        let mut code = "// Parameter struct for dynamic material: {(*graph).name}\nUSTRUCT(BlueprintType)\nstruct F{(*graph).name}MaterialParams\n{\n    GENERATED_BODY()\n\n"
        for param in &(*graph).dynamic_parameters:
            match param.param_type:
                DynamicParameterType::Scalar =>
                    let default_ = match param.default_value:
                        DynamicParameterValue::Scalar(v) => v
                        _ => 0
                    code.push_str(&f"    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category=\"Material Parameters\")\n    float {param.name} = {cpp_float(default_)};\n\n")
                    ()
                DynamicParameterType::Vector =>
                    let default_ = match param.default_value:
                        DynamicParameterValue::Vector(v) => v
                        _ => [0, 0, 0]
                    code.push_str(&f"    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category=\"Material Parameters\")\n    FLinearColor {param.name} = FLinearColor({cpp_float(default_[0])}, {cpp_float(default_[1])}, {cpp_float(default_[2])}, 1.0f);\n\n")
                    ()
                DynamicParameterType::Color =>
                    let default_ = match param.default_value:
                        DynamicParameterValue::Color(v) => v
                        _ => [1, 1, 1, 1]
                    code.push_str(&f"    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category=\"Material Parameters\")\n    FLinearColor {param.name} = FLinearColor({cpp_float(default_[0])}, {cpp_float(default_[1])}, {cpp_float(default_[2])}, {cpp_float(default_[3])});\n\n")
                    ()
        ()
        code.push_str("};\n\n")
        ()
        code

    fn generate_mid_helper(_self: &MaterialFactoryGenerator, graph: &MaterialGraph) -> String:
        if ((!(*graph).properties.expose_parameters) || (*graph).dynamic_parameters.is_empty()):
            return String__new_()
        let mut setter_code = String__new_()
        for param in &(*graph).dynamic_parameters:
            match param.param_type:
                DynamicParameterType::Scalar =>
                    setter_code.push_str(&f"    MID->SetScalarParameterValue(TEXT(\"{param.name}\"), Params.{param.name});\n")
                    ()
                DynamicParameterType::Vector =>
                    setter_code.push_str(&f"    MID->SetVectorParameterValue(TEXT(\"{param.name}\"), Params.{param.name});\n")
                    ()
                DynamicParameterType::Color =>
                    setter_code.push_str(&f"    MID->SetVectorParameterValue(TEXT(\"{param.name}\"), Params.{param.name});\n")
                    ()
        ()
        "\nUMaterialInstanceDynamic* Create{(*graph).name}MaterialInstance(UObject* Outer, const F{(*graph).name}MaterialParams& Params)\n{\n    UMaterial* BaseMaterial = LoadObject<UMaterial>(nullptr, TEXT(\"/{(*_self).plugin_name}/Materials/M_{(*graph).name}\"));\n    if (!BaseMaterial)\n    {\n        UE_LOG(LogTemp, Error, TEXT(\"Failed to load base material: /{(*_self).plugin_name}/Materials/M_{(*graph).name}\"));\n        return nullptr;\n    }\n    \n    UMaterialInstanceDynamic* MID = UMaterialInstanceDynamic::Create(BaseMaterial, Outer);\n    if (!MID)\n    {\n        UE_LOG(LogTemp, Error, TEXT(\"Failed to create Material Instance Dynamic\"));\n        return nullptr;\n    }\n    \n    // Apply parameters\n{setter_code}\n    \n    return MID;\n}\n\n"


