use crate::material_graph::*

pub struct MaterialNodeBuilder:
    next_id: usize
    nodes: Array<MaterialNode>

impl MaterialNodeBuilder:
    pub fn new_() -> MaterialNodeBuilder:
        MaterialNodeBuilder { next_id: 0, nodes: Vec__new_() }

    fn next_id(_self: &mut MaterialNodeBuilder) -> String:
        let id = f"node_{(*_self).next_id}"
        (*_self).next_id = ((*_self).next_id + 1)
        ()
        id

    pub fn texture_sample_param2d(_self: &mut MaterialNodeBuilder, param_name: String, default_texture: Option<String>, uv: Option<String>, x: i32, y: i32) -> String:
        let id = (*_self).next_id()
        (*_self).nodes.push(MaterialNode { id: id.clone(), node_type: MaterialNodeType::TextureSampleParameter2D { param_name: param_name.to_string(), default_texture: default_texture.map(fn(s): s.to_string()), uv_input: uv.map(fn(s): s.to_string()) }, position: (x, y) })
        ()
        id

    pub fn texture_sample(_self: &mut MaterialNodeBuilder, texture: Option<String>, uv: Option<String>, x: i32, y: i32) -> String:
        let id = (*_self).next_id()
        (*_self).nodes.push(MaterialNode { id: id.clone(), node_type: MaterialNodeType::TextureSample { texture_input: texture.map(fn(s): s.to_string()), uv_input: uv.map(fn(s): s.to_string()) }, position: (x, y) })
        ()
        id

    pub fn scalar_param(_self: &mut MaterialNodeBuilder, name: String, default_: f32, x: i32, y: i32) -> String:
        let id = (*_self).next_id()
        (*_self).nodes.push(MaterialNode { id: id.clone(), node_type: MaterialNodeType::ScalarParameter { name: name.to_string(), default_: default_ }, position: (x, y) })
        ()
        id

    pub fn vector_param(_self: &mut MaterialNodeBuilder, name: String, default_: [f32; 3], x: i32, y: i32) -> String:
        let id = (*_self).next_id()
        (*_self).nodes.push(MaterialNode { id: id.clone(), node_type: MaterialNodeType::VectorParameter { name: name.to_string(), default_: default_ }, position: (x, y) })
        ()
        id

    pub fn multiply(_self: &mut MaterialNodeBuilder, a: String, b: String, x: i32, y: i32) -> String:
        let id = (*_self).next_id()
        (*_self).nodes.push(MaterialNode { id: id.clone(), node_type: MaterialNodeType::Multiply { a: a.to_string(), b: b.to_string() }, position: (x, y) })
        ()
        id

    pub fn add(_self: &mut MaterialNodeBuilder, a: String, b: String, x: i32, y: i32) -> String:
        let id = (*_self).next_id()
        (*_self).nodes.push(MaterialNode { id: id.clone(), node_type: MaterialNodeType::Add { a: a.to_string(), b: b.to_string() }, position: (x, y) })
        ()
        id

    pub fn lerp(_self: &mut MaterialNodeBuilder, a: String, b: String, alpha: String, x: i32, y: i32) -> String:
        let id = (*_self).next_id()
        (*_self).nodes.push(MaterialNode { id: id.clone(), node_type: MaterialNodeType::Lerp { a: a.to_string(), b: b.to_string(), alpha: alpha.to_string() }, position: (x, y) })
        ()
        id

    pub fn constant_float(_self: &mut MaterialNodeBuilder, value: f32, x: i32, y: i32) -> String:
        let id = (*_self).next_id()
        (*_self).nodes.push(MaterialNode { id: id.clone(), node_type: MaterialNodeType::ConstantFloat { value: value }, position: (x, y) })
        ()
        id

    pub fn build(_self: MaterialNodeBuilder) -> Array<MaterialNode>:
        _self.nodes


