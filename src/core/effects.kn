// ============================================================================
// Kain Effect System - bootstrap-safe data declarations
// ============================================================================
// The owned bootstrap lane does not currently consume the effect helper APIs.
// Keep only the declaration surface until the parser/typechecker subset is
// ready for the richer method and utility layer again.
// ============================================================================

use error
use span

pub enum Effect:
    PureEffect
    IoEffect
    AsyncEffect
    GpuEffect
    ReactiveEffect
    UnsafeEffect
    AllocEffect
    PanicEffect

pub struct EffectSet:
    effect_items: Array<Effect>
