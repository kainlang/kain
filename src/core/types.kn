use ast::Block
use ast::ConstDef
use ast::EnumDef
use ast::Expr
use ast::FnDef
use ast::ImplDef
use ast::Literal
use ast::Param
use ast::Program
use ast::Stmt
use ast::StructDef
use ast::TopLevelItem
use ast::TypeExpr
use ast::UseDecl
use error::KainError
use span::Span

# Kain Type System - Single-pass typechecker
# Resolves names, infers basic types, and produces a TypedProgram
# suitable for consumption by codegen_llvm.kn.

# - Resolved types -

pub enum ResolvedType:
    Unit
    Bool
    Int
    Float
    String_
    Char
    Never
    ArrayOf(Box<ResolvedType>)
    SliceOf(Box<ResolvedType>)
    OptionOf(Box<ResolvedType>)
    ResultOf(Box<ResolvedType>, Box<ResolvedType>)
    TupleOf(Array<ResolvedType>)
    FunctionType(Array<ResolvedType>, Box<ResolvedType>)
    Struct_(String)
    Enum_(String)
    Named(String)
    Unknown

impl ResolvedType:
    pub fn to_llvm_type(self) -> String:
        match self:
            ResolvedType::Unit =>
                return "void"
            ResolvedType::Bool =>
                return "i1"
            ResolvedType::Int =>
                return "i64"
            ResolvedType::Float =>
                return "double"
            ResolvedType::String_ =>
                return "i8*"
            ResolvedType::Char =>
                return "i8"
            ResolvedType::Never =>
                return "void"
            ResolvedType::ArrayOf(_) =>
                return "i8*"
            ResolvedType::SliceOf(_) =>
                return "i8*"
            ResolvedType::OptionOf(inner) =>
                return inner.to_llvm_type()
            ResolvedType::ResultOf(ok, _) =>
                return ok.to_llvm_type()
            ResolvedType::TupleOf(_) =>
                return "i8*"
            ResolvedType::FunctionType(_, _) =>
                return "i8*"
            ResolvedType::Struct_(name) =>
                return "%" + name + "*"
            ResolvedType::Enum_(name) =>
                return "%" + name + "*"
            ResolvedType::Named(name) =>
                return resolved_type_from_name(name).to_llvm_type()
            ResolvedType::Unknown =>
                return "i64"

    pub fn is_void(self) -> Bool:
        match self:
            ResolvedType::Unit =>
                return true
            ResolvedType::Never =>
                return true
            _ =>
                return false

    pub fn display_name(self) -> String:
        match self:
            ResolvedType::Unit =>
                return "Unit"
            ResolvedType::Bool =>
                return "Bool"
            ResolvedType::Int =>
                return "Int"
            ResolvedType::Float =>
                return "Float"
            ResolvedType::String_ =>
                return "String"
            ResolvedType::Char =>
                return "Char"
            ResolvedType::Never =>
                return "Never"
            ResolvedType::ArrayOf(_) =>
                return "Array"
            ResolvedType::SliceOf(_) =>
                return "Slice"
            ResolvedType::OptionOf(_) =>
                return "Option"
            ResolvedType::ResultOf(_, _) =>
                return "Result"
            ResolvedType::TupleOf(_) =>
                return "Tuple"
            ResolvedType::FunctionType(_, _) =>
                return "Function"
            ResolvedType::Struct_(name) =>
                return name
            ResolvedType::Enum_(name) =>
                return name
            ResolvedType::Named(name) =>
                return name
            ResolvedType::Unknown =>
                return "?"

fn resolved_type_from_name(name: String) -> ResolvedType:
    if name == "Unit" || name == "()" || name == "void": return ResolvedType::Unit
    if name == "Bool" || name == "bool": return ResolvedType::Bool
    if name == "Int" || name == "i64" || name == "i32" || name == "i8" || name == "usize" || name == "isize": return ResolvedType::Int
    if name == "Float" || name == "f64" || name == "f32" || name == "double": return ResolvedType::Float
    if name == "String" || name == "str": return ResolvedType::String_
    if name == "Char" || name == "char": return ResolvedType::Char
    if name == "Never": return ResolvedType::Never
    return ResolvedType::Named(name)

# - Typed AST wrappers -

pub struct TypedFn:
    ast: FnDef
    resolved_type: ResolvedType
    param_types: Array<ResolvedType>

pub struct TypedStruct:
    struct_def: StructDef
    field_types: Array<ResolvedType>
    field_names: Array<String>

pub struct TypedEnum:
    enum_def: EnumDef
    variant_names: Array<String>

pub enum TypedItem:
    Function(TypedFn)
    Struct_(TypedStruct)
    Enum_(TypedEnum)
    Other

pub struct TypedProgram:
    ast: Program
    items: Array<TypedItem>
    struct_names: Array<String>
    enum_names: Array<String>
    fn_names: Array<String>
    fn_return_types: Array<ResolvedType>

# - Type environment (scope chain) -

struct TypeBinding:
    name: String
    ty: ResolvedType

struct TypeScope:
    bindings: Array<TypeBinding>

struct TypeEnv:
    scopes: Array<TypeScope>
    struct_names: Array<String>
    struct_field_names: Array<Array<String>>
    struct_field_types: Array<Array<ResolvedType>>
    enum_names: Array<String>
    fn_names: Array<String>
    fn_return_types: Array<ResolvedType>
    errors: Array<String>

fn typeenv_new() -> TypeEnv:
    let root_scope = TypeScope { bindings: [] }
    let env = TypeEnv {
        scopes: [root_scope],
        struct_names: [],
        struct_field_names: [],
        struct_field_types: [],
        enum_names: [],
        fn_names: [],
        fn_return_types: [],
        errors: []
    }
    # Register built-in functions
    typeenv_register_fn(env, "println", ResolvedType::Unit)
    typeenv_register_fn(env, "print", ResolvedType::Unit)
    typeenv_register_fn(env, "panic", ResolvedType::Never)
    typeenv_register_fn(env, "len", ResolvedType::Int)
    typeenv_register_fn(env, "push", ResolvedType::Unit)
    typeenv_register_fn(env, "str", ResolvedType::String_)
    typeenv_register_fn(env, "char_at", ResolvedType::String_)
    typeenv_register_fn(env, "read_file", ResolvedType::String_)
    typeenv_register_fn(env, "write_file", ResolvedType::Unit)
    typeenv_register_fn(env, "file_exists", ResolvedType::Bool)
    typeenv_register_fn(env, "env", ResolvedType::String_)
    typeenv_register_fn(env, "args", ResolvedType::ArrayOf(ResolvedType::String_))
    typeenv_register_fn(env, "exit", ResolvedType::Never)
    return env

fn typeenv_register_fn(env: TypeEnv, name: String, ret: ResolvedType) -> Unit:
    push(env.fn_names, name)
    push(env.fn_return_types, ret)

fn typeenv_push_scope(env: TypeEnv) -> Unit:
    push(env.scopes, TypeScope { bindings: [] })

fn typeenv_pop_scope(env: TypeEnv) -> Unit:
    if len(env.scopes) > 1:
        env.scopes = scope_arr_slice(env.scopes, len(env.scopes) - 1)

fn scope_arr_slice(arr: Array<TypeScope>, new_len: Int) -> Array<TypeScope>:
    let result = []
    let i = 0
    while i < new_len && i < len(arr):
        push(result, arr[i])
        i = i + 1
    return result

fn typeenv_define(env: TypeEnv, name: String, ty: ResolvedType) -> Unit:
    if len(env.scopes) == 0:
        return
    let top = env.scopes[len(env.scopes) - 1]
    push(top.bindings, TypeBinding { name: name, ty: ty })

fn typeenv_lookup(env: TypeEnv, name: String) -> ResolvedType:
    let si = len(env.scopes) - 1
    while si >= 0:
        let scope = env.scopes[si]
        let bi = 0
        while bi < len(scope.bindings):
            if scope.bindings[bi].name == name:
                return scope.bindings[bi].ty
            bi = bi + 1
        si = si - 1
    # Check function table
    let fi = 0
    while fi < len(env.fn_names):
        if env.fn_names[fi] == name:
            return env.fn_return_types[fi]
        fi = fi + 1
    # Check struct names
    for sname in env.struct_names:
        if sname == name:
            return ResolvedType::Struct_(name)
    # Check enum names
    for ename in env.enum_names:
        if ename == name:
            return ResolvedType::Enum_(name)
    return ResolvedType::Unknown

fn typeenv_lookup_fn_return(env: TypeEnv, name: String) -> ResolvedType:
    let i = 0
    while i < len(env.fn_names):
        if env.fn_names[i] == name:
            return env.fn_return_types[i]
        i = i + 1
    return ResolvedType::Unknown

fn typeenv_is_struct(env: TypeEnv, name: String) -> Bool:
    for sname in env.struct_names:
        if sname == name:
            return true
    return false

fn typeenv_is_enum(env: TypeEnv, name: String) -> Bool:
    for ename in env.enum_names:
        if ename == name:
            return true
    return false

fn typeenv_register_struct(env: TypeEnv, name: String, fnames: Array<String>, ftypes: Array<ResolvedType>) -> Unit:
    push(env.struct_names, name)
    push(env.struct_field_names, fnames)
    push(env.struct_field_types, ftypes)

fn typeenv_register_enum(env: TypeEnv, name: String) -> Unit:
    push(env.enum_names, name)

# - Type expression resolution -

fn resolve_type_expr(env: TypeEnv, ty: TypeExpr) -> ResolvedType:
    match ty:
        TypeExpr::Unit =>
            return ResolvedType::Unit
        TypeExpr::Never =>
            return ResolvedType::Never
        TypeExpr::Infer =>
            return ResolvedType::Unknown
        TypeExpr::Bool =>
            return ResolvedType::Bool
        TypeExpr::Int =>
            return ResolvedType::Int
        TypeExpr::Float =>
            return ResolvedType::Float
        TypeExpr::String_ =>
            return ResolvedType::String_
        TypeExpr::Char =>
            return ResolvedType::Char
        TypeExpr::Array(inner) =>
            return ResolvedType::ArrayOf(resolve_type_expr(env, inner))
        TypeExpr::Slice(inner) =>
            return ResolvedType::SliceOf(resolve_type_expr(env, inner))
        TypeExpr::Option(inner) =>
            return ResolvedType::OptionOf(resolve_type_expr(env, inner))
        TypeExpr::Result(ok, err) =>
            return ResolvedType::ResultOf(resolve_type_expr(env, ok), resolve_type_expr(env, err))
        TypeExpr::Tuple(items) =>
            let resolved = []
            for item in items:
                push(resolved, resolve_type_expr(env, item))
            return ResolvedType::TupleOf(resolved)
        TypeExpr::Function(params, ret) =>
            let param_types = []
            for p in params:
                push(param_types, resolve_type_expr(env, p))
            return ResolvedType::FunctionType(param_types, resolve_type_expr(env, ret))
        TypeExpr::Path(path) =>
            if len(path.segments) > 0:
                let name = path.segments[0].name
                if typeenv_is_struct(env, name):
                    return ResolvedType::Struct_(name)
                if typeenv_is_enum(env, name):
                    return ResolvedType::Enum_(name)
                return resolved_type_from_name(name)
            return ResolvedType::Unknown
        _ =>
            return ResolvedType::Unknown

# - Expression type inference -

fn infer_call_type(env: TypeEnv, call: CallExpr) -> ResolvedType:
    return ResolvedType::Unknown

fn infer_expr(env: TypeEnv, expr: Expr) -> ResolvedType:
    return ResolvedType::Unknown

fn infer_literal(lit: Literal) -> ResolvedType:
    return ResolvedType::Unknown

fn infer_binary_result(op: BinaryOp, lt: ResolvedType, rt: ResolvedType) -> ResolvedType:
    return ResolvedType::Int

fn infer_unary_result(op: UnaryOp, vt: ResolvedType) -> ResolvedType:
    return vt

# - Declaration pre-scan (collect names before type-checking bodies) -

fn prescan_program(env: TypeEnv, program: Program) -> Unit:
    return ()

# - Function typechecking -

fn check_fn(env: TypeEnv, fndef: FnDef) -> TypedFn:
    return TypedFn {
        ast: fndef,
        resolved_type: ResolvedType::Unknown,
        param_types: []
    }

fn check_stmt(env: TypeEnv, stmt: Stmt) -> Unit:
    return ()

# - Program typechecking -

pub fn check(program: Program) -> Result<TypedProgram, KainError>:
    return Result::Ok(TypedProgram {
        ast: program,
        items: [],
        struct_names: [],
        enum_names: [],
        fn_names: [],
        fn_return_types: []
    })
