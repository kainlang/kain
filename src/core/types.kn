use ast::Expr
use ast::Program
use error::KainError

# Kain Type System Seed

enum ResolvedType:
    Unit
    Bool
    Int
    Float
    String
    Never
    Path(String)
    Unknown

struct TypedProgram:
    ast: Program
    exported_names: Array<String>

pub fn check(program: Program) -> Result<TypedProgram, KainError>:
    return Result::Ok(TypedProgram {
        ast: program,
        exported_names: []
    })

pub fn infer_expr_type(_expr: Expr) -> ResolvedType:
    return ResolvedType::Unknown
