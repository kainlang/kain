use ast::Stmt
use ast::StructDef
use ast::StructInit
use ast::TopLevelItem
use ast::TraitDef
use ast::TraitMethod
use ast::TypeAliasDef
use ast::TypeExpr
use ast::UnaryExpr
use ast::UnaryOp
use ast::BinaryExpr
use ast::BinaryOp
use ast::UseDecl
use ast::VariantFields
use ast::WhileStmt
use error::KainError
use lexer::Token
use lexer::TokenKind
use lexer::tok_is_eof
use lexer::tok_is_indent
use lexer::tok_is_dedent
use lexer::tok_is_newline
use lexer::tok_is_keyword
use lexer::tok_is_symbol
use lexer::tok_is_ident
use lexer::tok_ident_name
use lexer::tok_string_val
use lexer::tok_int_val
use lexer::tok_float_val
use lexer::tok_char_val

# Kain Parser - Real recursive-descent parser
# Consumes the token stream from lexer.kn and produces a full ast::Program.
# Error recovery: when a parsing rule fails, a diagnostic is pushed and the
# parser advances past the problematic token rather than aborting.

# ─── Parser ps ─────────────────────────────────────────────────────────────

struct ParseState:
    tokens: Array<Token>
    cursor: Int
    file_name: String
    errors: Array<String>

fn ps_new(tokens: Array<Token>, file_name: String) -> ParseState:
    return ParseState { tokens: tokens, cursor: 0, file_name: file_name, errors: [] }

fn ps_peek(ps: ParseState) -> Token:
    if ps.cursor >= len(ps.tokens):
        let last = ps.tokens[len(ps.tokens) - 1]
        return last
    return ps.tokens[ps.cursor]

fn ps_peek2(ps: ParseState) -> Token:
    let pos = ps.cursor + 1
    if pos >= len(ps.tokens):
        return ps.tokens[len(ps.tokens) - 1]
    return ps.tokens[pos]

fn ps_advance(ps: ParseState) -> Token:
    let tok = ps_peek(ps)
    if ps.cursor < len(ps.tokens):
        ps.cursor = ps.cursor + 1
    return tok

fn ps_skip_newlines(ps: ParseState) -> Unit:
    let running = true
    while running:
        let tok = ps_peek(ps)
        if tok_is_newline(tok) || tok_is_indent(tok) || tok_is_dedent(tok):
            ps_advance(ps)
        else:
            running = false

fn ps_at_kw(ps: ParseState, kw: String) -> Bool:
    return tok_is_keyword(ps_peek(ps), kw)

fn ps_at_sym(ps: ParseState, sym: String) -> Bool:
    return tok_is_symbol(ps_peek(ps), sym)

fn ps_at_ident(ps: ParseState) -> Bool:
    return tok_is_ident(ps_peek(ps))

fn ps_at_eof(ps: ParseState) -> Bool:
    return tok_is_eof(ps_peek(ps))

fn ps_expect_kw(ps: ParseState, kw: String) -> Bool:
    if ps_at_kw(ps, kw):
        ps_advance(ps)
        return true
    push(ps.errors, "expected keyword '" + kw + "' at line " + str(ps_peek(ps).row))
    return false

fn ps_expect_sym(ps: ParseState, sym: String) -> Bool:
    if ps_at_sym(ps, sym):
        ps_advance(ps)
        return true
    push(ps.errors, "expected '" + sym + "' at line " + str(ps_peek(ps).row))
    return false

fn ps_consume_ident(ps: ParseState) -> String:
    let tok = ps_peek(ps)
    if tok_is_ident(tok):
        ps_advance(ps)
        return tok_ident_name(tok)
    push(ps.errors, "expected identifier at line " + str(tok.row))
    return "_error_"

fn make_span(ps: ParseState, start_tok: Token) -> Span:
    let end_tok = ps_peek(ps)
    return Span {
        file: ps.file_name,
        start_row: start_tok.row,
        start_column: start_tok.col,
        end_row: end_tok.row,
        end_column: end_tok.col
    }

fn tok_span(tok: Token, file_name: String) -> Span:
    return Span {
        file: file_name,
        start_row: tok.row,
        start_column: tok.col,
        end_row: tok.row,
        end_column: tok.col + len(tok.lexeme)
    }

fn empty_span(file_name: String) -> Span:
    return Span { file: file_name, start_row: 1, start_column: 1, end_row: 1, end_column: 1 }

fn empty_path(file_name: String) -> Path:
    return Path { segments: [], span: empty_span(file_name) }

# ─── Type expressions ──────────────────────────────────────────────────────────

fn parse_type_expr(ps: ParseState) -> TypeExpr:
    # Unit type  ()
    if ps_at_sym(ps, "("):
        let start = ps_peek(ps)
        ps_advance(ps)
        if ps_at_sym(ps, ")"):
            ps_advance(ps)
            return TypeExpr::Unit
        # Tuple type  (A, B, ...)
        let items = []
        push(items, parse_type_expr(ps))
        while ps_at_sym(ps, ","):
            ps_advance(ps)
            push(items, parse_type_expr(ps))
        ps_expect_sym(ps, ")")
        return TypeExpr::Tuple(items)

    # Never type
    if ps_at_sym(ps, "!"):
        ps_advance(ps)
        return TypeExpr::Never

    # Reference or pointer  &T
    if ps_at_sym(ps, "&"):
        ps_advance(ps)
        let is_mut = ps_at_kw(ps, "mut")
        if is_mut:
            ps_advance(ps)
        let inner = parse_type_expr(ps)
        return TypeExpr::Ref(is_mut, inner)

    # Named path types  Foo, Foo::Bar, Array<T>, Option<T>, etc.
    if ps_at_ident(ps) || ps_at_kw(ps, "Self") || ps_at_kw(ps, "self"):
        let start = ps_peek(ps)
        let path = parse_path(ps)
        # Check for generic parameters <T, U>
        if ps_at_sym(ps, "<"):
            ps_advance(ps)
            let type_args = []
            push(type_args, parse_type_expr(ps))
            while ps_at_sym(ps, ","):
                ps_advance(ps)
                if !ps_at_sym(ps, ">"):
                    push(type_args, parse_type_expr(ps))
            ps_expect_sym(ps, ">")
            # Map known generic types to TypeExpr variants
            let type_name = ""
            if len(path.segments) > 0:
                type_name = path.segments[0].name
            if type_name == "Array" && len(type_args) == 1:
                return TypeExpr::Array(type_args[0])
            if type_name == "Slice" && len(type_args) == 1:
                return TypeExpr::Slice(type_args[0])
            if type_name == "Option" && len(type_args) == 1:
                return TypeExpr::Option(type_args[0])
            if type_name == "Result" && len(type_args) == 2:
                return TypeExpr::Result(type_args[0], type_args[1])
            if type_name == "Box" && len(type_args) == 1:
                return type_args[0]
            if type_name == "Function" && len(type_args) >= 1:
                let params = []
                let i = 0
                while i < len(type_args) - 1:
                    push(params, type_args[i])
                    i = i + 1
                return TypeExpr::Function(params, type_args[len(type_args) - 1])
        return TypeExpr::Path(path)

    # Infer  _
    if ps_at_sym(ps, "_"):
        ps_advance(ps)
        return TypeExpr::Infer

    # Fallback
    return TypeExpr::Infer

# ─── Paths ─────────────────────────────────────────────────────────────────────

fn parse_path(ps: ParseState) -> Path:
    let start = ps_peek(ps)
    let segments = []

    let seg_name = ""
    if ps_at_ident(ps):
        seg_name = tok_ident_name(ps_advance(ps))
    else if ps_at_kw(ps, "Self") || ps_at_kw(ps, "self"):
        seg_name = ps_advance(ps).lexeme
    else:
        seg_name = "_error_"

    push(segments, PathSegment { name: seg_name, span: tok_span(start, ps.file_name) })

    while ps_at_sym(ps, "::"):
        ps_advance(ps)
        let seg_tok = ps_peek(ps)
        let seg = ""
        if ps_at_ident(ps):
            seg = tok_ident_name(ps_advance(ps))
        else if ps_at_kw(ps, "Self") || ps_at_kw(ps, "self"):
            seg = ps_advance(ps).lexeme
        else:
            seg = "_error_"
        push(segments, PathSegment { name: seg, span: tok_span(seg_tok, ps.file_name) })

    let span = make_span(ps, start)
    return Path { segments: segments, span: span }

# ─── Generics ──────────────────────────────────────────────────────────────────

fn parse_generic_params(ps: ParseState) -> Array<GenericParam>:
    let params = []
    if !ps_at_sym(ps, "<"):
        return params
    ps_advance(ps)
    while !ps_at_sym(ps, ">") && !ps_at_eof(ps):
        let start = ps_peek(ps)
        let name = ps_consume_ident(ps)
        let bounds = []
        if ps_at_sym(ps, ":"):
            ps_advance(ps)
            push(bounds, parse_type_expr(ps))
            while ps_at_sym(ps, "+"):
                ps_advance(ps)
                push(bounds, parse_type_expr(ps))
        push(params, GenericParam { name: name, bounds: bounds, span: tok_span(start, ps.file_name) })
        if ps_at_sym(ps, ","):
            ps_advance(ps)
    ps_expect_sym(ps, ">")
    return params

# ─── Parameters ───────────────────────────────────────────────────────────────

fn parse_params(ps: ParseState) -> Array<Param>:
    let params = []
    ps_expect_sym(ps, "(")
    while !ps_at_sym(ps, ")") && !ps_at_eof(ps):
        let start = ps_peek(ps)
        let is_mut = false
        if ps_at_kw(ps, "mut"):
            ps_advance(ps)
            is_mut = true
        # self parameter
        if ps_at_kw(ps, "self"):
            let self_tok = ps_advance(ps)
            let self_ty = TypeExpr::Path(Path {
                segments: [PathSegment { name: "Self", span: tok_span(self_tok, ps.file_name) }],
                span: tok_span(self_tok, ps.file_name)
            })
            push(params, Param { name: "self", ty: self_ty, default_value: none, is_mut: is_mut, span: tok_span(start, ps.file_name) })
        else:
            let name = ps_consume_ident(ps)
            ps_expect_sym(ps, ":")
            let ty = parse_type_expr(ps)
            let default_value = none
            if ps_at_sym(ps, "="):
                ps_advance(ps)
                default_value = Option::Some(parse_expr(ps))
            push(params, Param { name: name, ty: ty, default_value: default_value, is_mut: is_mut, span: tok_span(start, ps.file_name) })
        if ps_at_sym(ps, ","):
            ps_advance(ps)
    ps_expect_sym(ps, ")")
    return params

# ─── Blocks and statements ─────────────────────────────────────────────────────

fn parse_block(ps: ParseState) -> Block:
    let start = ps_peek(ps)
    let stmts = []
    ps_skip_newlines(ps)
    # Consume the INDENT that follows a colon
    if tok_is_indent(ps_peek(ps)):
        ps_advance(ps)
    while !tok_is_dedent(ps_peek(ps)) && !ps_at_eof(ps):
        ps_skip_newlines(ps)
        if tok_is_dedent(ps_peek(ps)) || ps_at_eof(ps):
            let _done = 0
        else:
            let stmt = parse_stmt(ps)
            push(stmts, stmt)
        ps_skip_newlines(ps)
    # consume the matching DEDENT
    if tok_is_dedent(ps_peek(ps)):
        ps_advance(ps)
    return Block { statements: stmts, span: make_span(ps, start) }

fn parse_stmt(ps: ParseState) -> Stmt:
    let start = ps_peek(ps)

    # let statement
    if ps_at_kw(ps, "let"):
        ps_advance(ps)
        let is_mut = ps_at_kw(ps, "mut")
        if is_mut:
            ps_advance(ps)
        let pat = parse_pattern(ps)
        let ty = none
        if ps_at_sym(ps, ":"):
            ps_advance(ps)
            ty = Option::Some(parse_type_expr(ps))
        let value = none
        if ps_at_sym(ps, "="):
            ps_advance(ps)
            value = Option::Some(parse_expr(ps))
        return Stmt::Let(LetStmt { pattern: pat, ty: ty, value: value, is_mut: is_mut, span: make_span(ps, start) })

    # return statement
    if ps_at_kw(ps, "return"):
        ps_advance(ps)
        let value = none
        if !ps_at_eof(ps) && !tok_is_newline(ps_peek(ps)) && !tok_is_dedent(ps_peek(ps)):
            value = Option::Some(parse_expr(ps))
        return Stmt::Return(ReturnStmt { value: value, span: make_span(ps, start) })

    # break statement
    if ps_at_kw(ps, "break"):
        ps_advance(ps)
        let value = none
        if !tok_is_newline(ps_peek(ps)) && !tok_is_dedent(ps_peek(ps)) && !ps_at_eof(ps):
            value = Option::Some(parse_expr(ps))
        return Stmt::Break(BreakStmt { value: value, span: make_span(ps, start) })

    # continue statement
    if ps_at_kw(ps, "continue"):
        ps_advance(ps)
        return Stmt::Continue(ContinueStmt { span: make_span(ps, start) })

    # if statement
    if ps_at_kw(ps, "if"):
        return parse_if_stmt(ps)

    # while statement
    if ps_at_kw(ps, "while"):
        ps_advance(ps)
        let cond = parse_expr(ps)
        ps_expect_sym(ps, ":")
        let body = parse_block(ps)
        return Stmt::While(WhileStmt { condition: cond, body: body, span: make_span(ps, start) })

    # for statement
    if ps_at_kw(ps, "for"):
        ps_advance(ps)
        let pat = parse_pattern(ps)
        ps_expect_kw(ps, "in")
        let iter = parse_expr(ps)
        ps_expect_sym(ps, ":")
        let body = parse_block(ps)
        return Stmt::For(ForStmt { pattern: pat, iter: iter, body: body, span: make_span(ps, start) })

    # match statement
    if ps_at_kw(ps, "match"):
        ps_advance(ps)
        let val = parse_expr(ps)
        ps_expect_sym(ps, ":")
        let arms = parse_match_arms_stmt(ps)
        return Stmt::Match(MatchStmt { value: val, arms: arms, span: make_span(ps, start) })

    # Otherwise: expression statement, possibly assignment
    let expr = parse_expr(ps)

    # Assignment: lhs = rhs (but not ==)
    if ps_at_sym(ps, "="):
        ps_advance(ps)
        let rhs = parse_expr(ps)
        return Stmt::Assign(AssignStmt { target: expr, value: rhs, span: make_span(ps, start) })
    # Compound assignment (+=, -=, etc.) - lower to Assign with binary expr
    if ps_at_sym(ps, "+=") || ps_at_sym(ps, "-=") || ps_at_sym(ps, "*=") || ps_at_sym(ps, "/=") || ps_at_sym(ps, "%="):
        let op_sym = ps_advance(ps)
        let rhs = parse_expr(ps)
        let bin_op = compound_assign_to_binop(op_sym.lexeme)
        let rhs_expr = Expr::Binary(BinaryExpr { left: expr, op: bin_op, right: rhs, span: make_span(ps, start) })
        return Stmt::Assign(AssignStmt { target: expr, value: rhs_expr, span: make_span(ps, start) })

    return Stmt::Expr(ExprStmt { expr: expr, span: make_span(ps, start) })

fn compound_assign_to_binop(sym: String) -> BinaryOp:
    if sym == "+=": return BinaryOp::Add
    if sym == "-=": return BinaryOp::Sub
    if sym == "*=": return BinaryOp::Mul
    if sym == "/=": return BinaryOp::Div
    if sym == "%=": return BinaryOp::Mod
    return BinaryOp::Add

fn parse_if_stmt(ps: ParseState) -> Stmt:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "if")
    let cond = parse_expr(ps)
    ps_expect_sym(ps, ":")
    let then_block = parse_block(ps)
    ps_skip_newlines(ps)
    let else_block = none
    if ps_at_kw(ps, "else"):
        ps_advance(ps)
        if ps_at_kw(ps, "if"):
            let nested = parse_if_stmt(ps)
            let nested_block = Block { statements: [nested], span: make_span(ps, start) }
            else_block = Option::Some(nested_block)
        else:
            ps_expect_sym(ps, ":")
            else_block = Option::Some(parse_block(ps))
    return Stmt::If(IfStmt { condition: cond, then_branch: then_block, else_branch: else_block, span: make_span(ps, start) })

fn parse_match_arms_stmt(ps: ParseState) -> Array<MatchArm>:
    let arms = []
    ps_skip_newlines(ps)
    if tok_is_indent(ps_peek(ps)):
        ps_advance(ps)
    while !tok_is_dedent(ps_peek(ps)) && !ps_at_eof(ps):
        ps_skip_newlines(ps)
        if tok_is_dedent(ps_peek(ps)) || ps_at_eof(ps):
            let _done = 0
        else:
            let arm_start = ps_peek(ps)
            let pat = parse_pattern(ps)
            let guard = none
            if ps_at_kw(ps, "if"):
                ps_advance(ps)
                guard = Option::Some(parse_expr(ps))
            ps_expect_sym(ps, "=>")
            let body = parse_match_arm_body(ps)
            push(arms, MatchArm { pattern: pat, guard: guard, body: body, span: make_span(ps, arm_start) })
        ps_skip_newlines(ps)
    if tok_is_dedent(ps_peek(ps)):
        ps_advance(ps)
    return arms

fn parse_match_arm_body(ps: ParseState) -> Block:
    let start = ps_peek(ps)
    # Indented block after =>
    if ps_at_sym(ps, ":"):
        ps_advance(ps)
        return parse_block(ps)
    # Single expression arm
    let expr = parse_expr(ps)
    return Block { statements: [Stmt::Expr(ExprStmt { expr: expr, span: make_span(ps, start) })], span: make_span(ps, start) }

# ─── Expressions ───────────────────────────────────────────────────────────────

fn parse_expr(ps: ParseState) -> Expr:
    return parse_or_expr(ps)

fn parse_or_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    let left = parse_and_expr(ps)
    while ps_at_sym(ps, "||") || ps_at_kw(ps, "or"):
        ps_advance(ps)
        let right = parse_and_expr(ps)
        left = Expr::Binary(BinaryExpr { left: left, op: BinaryOp::Or, right: right, span: make_span(ps, start) })
    return left

fn parse_and_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    let left = parse_cmp_expr(ps)
    while ps_at_sym(ps, "&&") || ps_at_kw(ps, "and"):
        ps_advance(ps)
        let right = parse_cmp_expr(ps)
        left = Expr::Binary(BinaryExpr { left: left, op: BinaryOp::And, right: right, span: make_span(ps, start) })
    return left

fn parse_cmp_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    let left = parse_add_expr(ps)
    if ps_at_sym(ps, "=="):
        ps_advance(ps)
        let right = parse_add_expr(ps)
        return Expr::Binary(BinaryExpr { left: left, op: BinaryOp::Eq, right: right, span: make_span(ps, start) })
    if ps_at_sym(ps, "!="):
        ps_advance(ps)
        let right = parse_add_expr(ps)
        return Expr::Binary(BinaryExpr { left: left, op: BinaryOp::Ne, right: right, span: make_span(ps, start) })
    if ps_at_sym(ps, "<="):
        ps_advance(ps)
        let right = parse_add_expr(ps)
        return Expr::Binary(BinaryExpr { left: left, op: BinaryOp::Le, right: right, span: make_span(ps, start) })
    if ps_at_sym(ps, ">="):
        ps_advance(ps)
        let right = parse_add_expr(ps)
        return Expr::Binary(BinaryExpr { left: left, op: BinaryOp::Ge, right: right, span: make_span(ps, start) })
    if ps_at_sym(ps, "<"):
        ps_advance(ps)
        let right = parse_add_expr(ps)
        return Expr::Binary(BinaryExpr { left: left, op: BinaryOp::Lt, right: right, span: make_span(ps, start) })
    if ps_at_sym(ps, ">"):
        ps_advance(ps)
        let right = parse_add_expr(ps)
        return Expr::Binary(BinaryExpr { left: left, op: BinaryOp::Gt, right: right, span: make_span(ps, start) })
    return left

fn parse_add_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    let left = parse_mul_expr(ps)
    while ps_at_sym(ps, "+") || ps_at_sym(ps, "-"):
        let op_tok = ps_advance(ps)
        let right = parse_mul_expr(ps)
        let op = BinaryOp::Add
        if op_tok.lexeme == "-":
            op = BinaryOp::Sub
        left = Expr::Binary(BinaryExpr { left: left, op: op, right: right, span: make_span(ps, start) })
    return left

fn parse_mul_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    let left = parse_unary_expr(ps)
    while ps_at_sym(ps, "*") || ps_at_sym(ps, "/") || ps_at_sym(ps, "%"):
        let op_tok = ps_advance(ps)
        let right = parse_unary_expr(ps)
        let op = BinaryOp::Mul
        if op_tok.lexeme == "/":
            op = BinaryOp::Div
        if op_tok.lexeme == "%":
            op = BinaryOp::Mod
        left = Expr::Binary(BinaryExpr { left: left, op: op, right: right, span: make_span(ps, start) })
    return left

fn parse_unary_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    if ps_at_sym(ps, "!") || ps_at_kw(ps, "not"):
        ps_advance(ps)
        let val = parse_unary_expr(ps)
        return Expr::Unary(UnaryExpr { op: UnaryOp::Not, value: val, span: make_span(ps, start) })
    if ps_at_sym(ps, "-"):
        ps_advance(ps)
        let val = parse_unary_expr(ps)
        return Expr::Unary(UnaryExpr { op: UnaryOp::Negate, value: val, span: make_span(ps, start) })
    if ps_at_sym(ps, "&"):
        ps_advance(ps)
        let val = parse_unary_expr(ps)
        return Expr::Unary(UnaryExpr { op: UnaryOp::Borrow, value: val, span: make_span(ps, start) })
    if ps_at_sym(ps, "*"):
        ps_advance(ps)
        let val = parse_unary_expr(ps)
        return Expr::Unary(UnaryExpr { op: UnaryOp::Deref, value: val, span: make_span(ps, start) })
    return parse_postfix_expr(ps)

fn parse_postfix_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    let base = parse_primary_expr(ps)

    let running = true
    while running:
        # Field access  expr.field
        if ps_at_sym(ps, "."):
            ps_advance(ps)
            let field_tok = ps_peek(ps)
            let field_name = ""
            if ps_at_ident(ps):
                field_name = tok_ident_name(ps_advance(ps))
            else if ps_at_kw(ps, "await"):
                ps_advance(ps)
                field_name = "await"
            else:
                field_name = ps_advance(ps).lexeme
            # Method call  expr.method(args)
            if ps_at_sym(ps, "("):
                let args = parse_call_args(ps)
                base = Expr::MethodCall(MethodCallExpr { receiver: base, method: field_name, args: args, span: make_span(ps, start) })
            else:
                base = Expr::Field(FieldExpr { target: base, field: field_name, span: make_span(ps, start) })
        # Indexing  expr[idx]
        else if ps_at_sym(ps, "["):
            ps_advance(ps)
            let idx = parse_expr(ps)
            ps_expect_sym(ps, "]")
            base = Expr::Index(IndexExpr { target: base, index: idx, span: make_span(ps, start) })
        # Plain call  expr(args) - for function value expressions
        else if ps_at_sym(ps, "("):
            let args = parse_call_args(ps)
            base = Expr::Call(CallExpr { callee: base, args: args, span: make_span(ps, start) })
        else:
            running = false
    return base

fn parse_call_args(ps: ParseState) -> Array<Expr>:
    let args = []
    ps_expect_sym(ps, "(")
    while !ps_at_sym(ps, ")") && !ps_at_eof(ps):
        push(args, parse_expr(ps))
        if ps_at_sym(ps, ","):
            ps_advance(ps)
    ps_expect_sym(ps, ")")
    return args

fn parse_primary_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)

    # Integer literal
    match start.kind:
        TokenKind::IntLiteral(n) =>
            ps_advance(ps)
            return Expr::Literal(Literal::Int(n))
        TokenKind::FloatLiteral(f) =>
            ps_advance(ps)
            return Expr::Literal(Literal::Float(f))
        TokenKind::StringLiteral(s) =>
            ps_advance(ps)
            return Expr::Literal(Literal::String(s))
        TokenKind::FStringLiteral(s) =>
            ps_advance(ps)
            return Expr::Literal(Literal::String(s))
        TokenKind::CharLiteral(c) =>
            ps_advance(ps)
            return Expr::Literal(Literal::Char(c))
        _ => ()

    # bool literals
    if ps_at_kw(ps, "true"):
        ps_advance(ps)
        return Expr::Literal(Literal::Bool(true))
    if ps_at_kw(ps, "false"):
        ps_advance(ps)
        return Expr::Literal(Literal::Bool(false))

    # none literal
    if ps_at_kw(ps, "none"):
        ps_advance(ps)
        return Expr::Literal(Literal::Unit)

    # Grouped expression or tuple  (expr)
    if ps_at_sym(ps, "("):
        ps_advance(ps)
        if ps_at_sym(ps, ")"):
            ps_advance(ps)
            return Expr::Literal(Literal::Unit)
        let first = parse_expr(ps)
        if ps_at_sym(ps, ","):
            let items = [first]
            while ps_at_sym(ps, ","):
                ps_advance(ps)
                if !ps_at_sym(ps, ")"):
                    push(items, parse_expr(ps))
            ps_expect_sym(ps, ")")
            return Expr::Tuple(items)
        ps_expect_sym(ps, ")")
        return first

    # Array literal  [a, b, c]
    if ps_at_sym(ps, "["):
        ps_advance(ps)
        let items = []
        while !ps_at_sym(ps, "]") && !ps_at_eof(ps):
            push(items, parse_expr(ps))
            if ps_at_sym(ps, ","):
                ps_advance(ps)
        ps_expect_sym(ps, "]")
        return Expr::Array(items)

    # if-expression
    if ps_at_kw(ps, "if"):
        return parse_if_expr(ps)

    # match expression
    if ps_at_kw(ps, "match"):
        return parse_match_expr(ps)

    # comptime block
    if ps_at_kw(ps, "comptime"):
        ps_advance(ps)
        ps_expect_sym(ps, ":")
        let block = parse_block(ps)
        return Expr::Comptime(ComptimeExpr { block: block, span: make_span(ps, start) })

    # Lambda  |params| expr  or  fn(params) -> ret: block
    if ps_at_sym(ps, "|"):
        return parse_lambda_pipe(ps)

    # Identifier, path, struct init, call, enum variant
    if ps_at_ident(ps) || ps_at_kw(ps, "Self") || ps_at_kw(ps, "self"):
        let path = parse_path(ps)

        # Struct init  Path { field: val, ... }
        if ps_at_sym(ps, "{"):
            ps_advance(ps)
            let fields = []
            while !ps_at_sym(ps, "}") && !ps_at_eof(ps):
                let field_start = ps_peek(ps)
                let fname = ps_consume_ident(ps)
                ps_expect_sym(ps, ":")
                let fval = parse_expr(ps)
                push(fields, InitField { name: fname, value: fval, span: make_span(ps, field_start) })
                if ps_at_sym(ps, ","):
                    ps_advance(ps)
            ps_expect_sym(ps, "}")
            return Expr::StructInit(StructInit { name: path, fields: fields, span: make_span(ps, start) })

        # Regular function call  path(args)
        if ps_at_sym(ps, "("):
            let args = parse_call_args(ps)
            let callee = Expr::Path(path)
            return Expr::Call(CallExpr { callee: callee, args: args, span: make_span(ps, start) })

        return Expr::Path(path)

    # Error recovery
    push(ps.errors, "unexpected token '" + ps_peek(ps).lexeme + "' at line " + str(ps_peek(ps).row))
    ps_advance(ps)
    return Expr::Literal(Literal::Unit)

fn parse_if_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "if")
    let cond = parse_expr(ps)
    ps_expect_sym(ps, ":")
    let then_block = parse_block(ps)
    ps_skip_newlines(ps)
    let else_block = none
    if ps_at_kw(ps, "else"):
        ps_advance(ps)
        ps_expect_sym(ps, ":")
        else_block = Option::Some(parse_block(ps))
    return Expr::If(IfExpr { condition: cond, then_branch: then_block, else_branch: else_block, span: make_span(ps, start) })

fn parse_match_expr(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "match")
    let val = parse_expr(ps)
    ps_expect_sym(ps, ":")
    let arms = parse_match_arms_expr(ps)
    return Expr::Match(MatchExpr { value: val, arms: arms, span: make_span(ps, start) })

fn parse_match_arms_expr(ps: ParseState) -> Array<MatchArmExpr>:
    let arms = []
    ps_skip_newlines(ps)
    if tok_is_indent(ps_peek(ps)):
        ps_advance(ps)
    while !tok_is_dedent(ps_peek(ps)) && !ps_at_eof(ps):
        ps_skip_newlines(ps)
        if tok_is_dedent(ps_peek(ps)) || ps_at_eof(ps):
            let _done = 0
        else:
            let arm_start = ps_peek(ps)
            let pat = parse_pattern(ps)
            let guard = none
            if ps_at_kw(ps, "if"):
                ps_advance(ps)
                guard = Option::Some(parse_expr(ps))
            ps_expect_sym(ps, "=>")
            let val = parse_expr(ps)
            push(arms, MatchArmExpr { pattern: pat, guard: guard, value: val, span: make_span(ps, arm_start) })
        ps_skip_newlines(ps)
    if tok_is_dedent(ps_peek(ps)):
        ps_advance(ps)
    return arms

fn parse_lambda_pipe(ps: ParseState) -> Expr:
    let start = ps_peek(ps)
    ps_expect_sym(ps, "|")
    let params = []
    while !ps_at_sym(ps, "|") && !ps_at_eof(ps):
        let p_start = ps_peek(ps)
        let p_name = ps_consume_ident(ps)
        let p_ty = TypeExpr::Infer
        if ps_at_sym(ps, ":"):
            ps_advance(ps)
            p_ty = parse_type_expr(ps)
        push(params, Param { name: p_name, ty: p_ty, default_value: none, is_mut: false, span: tok_span(p_start, ps.file_name) })
        if ps_at_sym(ps, ","):
            ps_advance(ps)
    ps_expect_sym(ps, "|")
    let body = parse_expr(ps)
    return Expr::Lambda(LambdaExpr { params: params, body: body, span: make_span(ps, start) })

# ─── Patterns ─────────────────────────────────────────────────────────────────

fn parse_pattern(ps: ParseState) -> Pattern:
    let start = ps_peek(ps)

    # Wildcard  _
    if ps_at_sym(ps, "_"):
        ps_advance(ps)
        return Pattern::Wildcard

    # Literal patterns
    match start.kind:
        TokenKind::IntLiteral(n) =>
            ps_advance(ps)
            return Pattern::Literal(Literal::Int(n))
        TokenKind::StringLiteral(s) =>
            ps_advance(ps)
            return Pattern::Literal(Literal::String(s))
        _ => ()

    if ps_at_kw(ps, "true"):
        ps_advance(ps)
        return Pattern::Literal(Literal::Bool(true))
    if ps_at_kw(ps, "false"):
        ps_advance(ps)
        return Pattern::Literal(Literal::Bool(false))
    if ps_at_kw(ps, "none"):
        ps_advance(ps)
        return Pattern::Literal(Literal::Unit)

    # Tuple pattern  (a, b)
    if ps_at_sym(ps, "("):
        ps_advance(ps)
        let items = []
        while !ps_at_sym(ps, ")") && !ps_at_eof(ps):
            push(items, parse_pattern(ps))
            if ps_at_sym(ps, ","):
                ps_advance(ps)
        ps_expect_sym(ps, ")")
        return Pattern::Tuple(items)

    # Named (binding or enum variant)
    if ps_at_ident(ps) || ps_at_kw(ps, "Self"):
        let first_tok = ps_peek(ps)
        let name = ps_consume_ident(ps)
        # Check for  Path::Variant(...)  or  Path::Variant { ... }
        if ps_at_sym(ps, "::"):
            let path_segs = [PathSegment { name: name, span: tok_span(first_tok, ps.file_name) }]
            while ps_at_sym(ps, "::"):
                ps_advance(ps)
                let seg_tok = ps_peek(ps)
                let seg = ps_consume_ident(ps)
                push(path_segs, PathSegment { name: seg, span: tok_span(seg_tok, ps.file_name) })
            let path = Path { segments: path_segs, span: make_span(ps, first_tok) }
            # variant with tuple payload
            if ps_at_sym(ps, "("):
                ps_advance(ps)
                let payloads = []
                while !ps_at_sym(ps, ")") && !ps_at_eof(ps):
                    push(payloads, parse_pattern(ps))
                    if ps_at_sym(ps, ","):
                        ps_advance(ps)
                ps_expect_sym(ps, ")")
                let variant_name = path_segs[len(path_segs) - 1].name
                return Pattern::Enum(path, variant_name, payloads)
            # unit variant
            let variant_name = path_segs[len(path_segs) - 1].name
            return Pattern::Enum(path, variant_name, [])
        # Simple binding
        if ps_at_kw(ps, "mut"):
            ps_advance(ps)
            return Pattern::BindingMut(name)
        return Pattern::Binding(name)

    # Or-pattern fallback
    return Pattern::Wildcard

# ─── Top-level declarations ────────────────────────────────────────────────────

fn parse_fn_def(ps: ParseState, is_pub: Bool) -> FnDef:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "fn")
    let name = ps_consume_ident(ps)
    let generics = parse_generic_params(ps)
    let params = parse_params(ps)
    let return_type = none
    if ps_at_sym(ps, "->"):
        ps_advance(ps)
        return_type = Option::Some(parse_type_expr(ps))
    let effects = []
    if ps_at_kw(ps, "with"):
        ps_advance(ps)
        push(effects, parse_path(ps))
        while ps_at_sym(ps, ","):
            ps_advance(ps)
            push(effects, parse_path(ps))
    ps_expect_sym(ps, ":")
    let body = parse_block(ps)
    return FnDef {
        name: name,
        params: params,
        generics: generics,
        return_type: return_type,
        effects: effects,
        body: body.statements,
        span: make_span(ps, start),
        is_pub: is_pub,
        is_async: false
    }

fn parse_struct_def(ps: ParseState, is_pub: Bool) -> StructDef:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "struct")
    let name = ps_consume_ident(ps)
    let generics = parse_generic_params(ps)
    ps_expect_sym(ps, ":")
    let fields = []
    ps_skip_newlines(ps)
    if tok_is_indent(ps_peek(ps)):
        ps_advance(ps)
        while !tok_is_dedent(ps_peek(ps)) && !ps_at_eof(ps):
            ps_skip_newlines(ps)
            if tok_is_dedent(ps_peek(ps)) || ps_at_eof(ps):
                let _done = 0
            else:
                let f_start = ps_peek(ps)
                let f_pub = false
                if ps_at_kw(ps, "pub"):
                    ps_advance(ps)
                    f_pub = true
                let f_name = ps_consume_ident(ps)
                ps_expect_sym(ps, ":")
                let f_ty = parse_type_expr(ps)
                let f_default = none
                if ps_at_sym(ps, "="):
                    ps_advance(ps)
                    f_default = Option::Some(parse_expr(ps))
                push(fields, FieldDef { name: f_name, ty: f_ty, default_value: f_default, is_pub: f_pub, span: make_span(ps, f_start) })
            ps_skip_newlines(ps)
        if tok_is_dedent(ps_peek(ps)):
            ps_advance(ps)
    return StructDef { name: name, generics: generics, fields: fields, span: make_span(ps, start), is_pub: is_pub }

fn parse_enum_def(ps: ParseState, is_pub: Bool) -> EnumDef:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "enum")
    let name = ps_consume_ident(ps)
    let generics = parse_generic_params(ps)
    ps_expect_sym(ps, ":")
    let variants = []
    ps_skip_newlines(ps)
    if tok_is_indent(ps_peek(ps)):
        ps_advance(ps)
        while !tok_is_dedent(ps_peek(ps)) && !ps_at_eof(ps):
            ps_skip_newlines(ps)
            if tok_is_dedent(ps_peek(ps)) || ps_at_eof(ps):
                let _done = 0
            else:
                let v_start = ps_peek(ps)
                let v_name = ps_consume_ident(ps)
                let v_fields = VariantFields::Unit
                if ps_at_sym(ps, "("):
                    ps_advance(ps)
                    let types = []
                    while !ps_at_sym(ps, ")") && !ps_at_eof(ps):
                        push(types, parse_type_expr(ps))
                        if ps_at_sym(ps, ","):
                            ps_advance(ps)
                    ps_expect_sym(ps, ")")
                    v_fields = VariantFields::Tuple(types)
                push(variants, EnumVariant { name: v_name, fields: v_fields, span: make_span(ps, v_start) })
            ps_skip_newlines(ps)
        if tok_is_dedent(ps_peek(ps)):
            ps_advance(ps)
    return EnumDef { name: name, generics: generics, variants: variants, span: make_span(ps, start), is_pub: is_pub }

fn parse_trait_def(ps: ParseState, is_pub: Bool) -> TraitDef:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "trait")
    let name = ps_consume_ident(ps)
    let generics = parse_generic_params(ps)
    ps_expect_sym(ps, ":")
    let methods = []
    ps_skip_newlines(ps)
    if tok_is_indent(ps_peek(ps)):
        ps_advance(ps)
        while !tok_is_dedent(ps_peek(ps)) && !ps_at_eof(ps):
            ps_skip_newlines(ps)
            if tok_is_dedent(ps_peek(ps)):
                let _done = 0
            else:
                let m_start = ps_peek(ps)
                ps_expect_kw(ps, "fn")
                let m_name = ps_consume_ident(ps)
                let m_params = parse_params(ps)
                let m_ret = none
                if ps_at_sym(ps, "->"):
                    ps_advance(ps)
                    m_ret = Option::Some(parse_type_expr(ps))
                let m_default = none
                if ps_at_sym(ps, ":"):
                    ps_advance(ps)
                    let body = parse_block(ps)
                    m_default = Option::Some(body.statements)
                push(methods, TraitMethod { name: m_name, params: m_params, return_type: m_ret, default_impl: m_default, span: make_span(ps, m_start) })
            ps_skip_newlines(ps)
        if tok_is_dedent(ps_peek(ps)):
            ps_advance(ps)
    return TraitDef { name: name, generics: generics, methods: methods, span: make_span(ps, start), is_pub: is_pub }

fn parse_impl_def(ps: ParseState) -> ImplDef:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "impl")
    let generics = parse_generic_params(ps)
    let target_ty = parse_type_expr(ps)
    let trait_name = none
    if ps_at_sym(ps, ":") && ps_at_ident(ps_peek2(ps)):
        # could be impl Trait for Type: - simplified, skip trait_name detection
        let _skip = 0
    ps_expect_sym(ps, ":")
    let methods = []
    ps_skip_newlines(ps)
    if tok_is_indent(ps_peek(ps)):
        ps_advance(ps)
        while !tok_is_dedent(ps_peek(ps)) && !ps_at_eof(ps):
            ps_skip_newlines(ps)
            if tok_is_dedent(ps_peek(ps)):
                let _done = 0
            else:
                let m_pub = false
                if ps_at_kw(ps, "pub"):
                    ps_advance(ps)
                    m_pub = true
                let m_def = parse_fn_def(ps, m_pub)
                push(methods, m_def)
            ps_skip_newlines(ps)
        if tok_is_dedent(ps_peek(ps)):
            ps_advance(ps)
    return ImplDef { target: target_ty, generics: generics, trait_name: trait_name, methods: methods, span: make_span(ps, start) }

fn parse_use_decl(ps: ParseState, is_pub: Bool) -> UseDecl:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "use")
    let path = parse_path(ps)
    let alias = none
    if ps_at_kw(ps, "as"):
        ps_advance(ps)
        alias = Option::Some(ps_consume_ident(ps))
    return UseDecl { path: path, alias: alias, span: make_span(ps, start), is_pub: is_pub }

fn parse_const_def(ps: ParseState, is_pub: Bool) -> ConstDef:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "const")
    let name = ps_consume_ident(ps)
    ps_expect_sym(ps, ":")
    let ty = parse_type_expr(ps)
    ps_expect_sym(ps, "=")
    let value = parse_expr(ps)
    return ConstDef { name: name, ty: ty, value: value, span: make_span(ps, start), is_pub: is_pub }

fn parse_type_alias(ps: ParseState, is_pub: Bool) -> TypeAliasDef:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "type")
    let name = ps_consume_ident(ps)
    let generics = parse_generic_params(ps)
    ps_expect_sym(ps, "=")
    let target = parse_type_expr(ps)
    return TypeAliasDef { name: name, generics: generics, target: target, span: make_span(ps, start), is_pub: is_pub }

fn parse_extern_fn(ps: ParseState, is_pub: Bool) -> ExternFnDef:
    let start = ps_peek(ps)
    ps_expect_kw(ps, "extern")
    ps_expect_kw(ps, "fn")
    let name = ps_consume_ident(ps)
    let params = parse_params(ps)
    let ret = none
    if ps_at_sym(ps, "->"):
        ps_advance(ps)
        ret = Option::Some(parse_type_expr(ps))
    return ExternFnDef { name: name, params: params, return_type: ret, span: make_span(ps, start), is_pub: is_pub }

fn parse_top_level_item(ps: ParseState) -> Option<TopLevelItem>:
    ps_skip_newlines(ps)
    if ps_at_eof(ps):
        return none

    let is_pub = false
    if ps_at_kw(ps, "pub"):
        ps_advance(ps)
        is_pub = true

    if ps_at_kw(ps, "fn") || (ps_at_kw(ps, "async") && tok_is_keyword(ps_peek2(ps), "fn")):
        let is_async = false
        if ps_at_kw(ps, "async"):
            ps_advance(ps)
            is_async = true
        let fndef = parse_fn_def(ps, is_pub)
        return Option::Some(TopLevelItem::Function(fndef))

    if ps_at_kw(ps, "struct"):
        return Option::Some(TopLevelItem::Struct(parse_struct_def(ps, is_pub)))

    if ps_at_kw(ps, "enum"):
        return Option::Some(TopLevelItem::Enum(parse_enum_def(ps, is_pub)))

    if ps_at_kw(ps, "trait"):
        return Option::Some(TopLevelItem::Trait(parse_trait_def(ps, is_pub)))

    if ps_at_kw(ps, "impl"):
        return Option::Some(TopLevelItem::Impl(parse_impl_def(ps)))

    if ps_at_kw(ps, "use"):
        return Option::Some(TopLevelItem::Use(parse_use_decl(ps, is_pub)))

    if ps_at_kw(ps, "const"):
        return Option::Some(TopLevelItem::Const(parse_const_def(ps, is_pub)))

    if ps_at_kw(ps, "type"):
        return Option::Some(TopLevelItem::TypeAlias(parse_type_alias(ps, is_pub)))

    if ps_at_kw(ps, "extern"):
        return Option::Some(TopLevelItem::ExternFn(parse_extern_fn(ps, is_pub)))

    if ps_at_kw(ps, "effect"):
        ps_advance(ps)
        let start = ps_peek(ps)
        let ename = ps_consume_ident(ps)
        ps_expect_sym(ps, ":")
        let effect_def = EffectDef { name: ename, methods: [], span: empty_span(ps.file_name), is_pub: is_pub }
        return Option::Some(TopLevelItem::Effect(effect_def))

    if ps_at_kw(ps, "mod"):
        ps_advance(ps)
        let start = ps_peek(ps)
        let mod_name = ps_consume_ident(ps)
        let mod_items = []
        if ps_at_sym(ps, ":"):
            ps_advance(ps)
            ps_skip_newlines(ps)
            if tok_is_indent(ps_peek(ps)):
                ps_advance(ps)
                while !tok_is_dedent(ps_peek(ps)) && !ps_at_eof(ps):
                    let nested = parse_top_level_item(ps)
                    match nested:
                        Option::Some(item) => push(mod_items, item)
                        _ => ()
                if tok_is_dedent(ps_peek(ps)):
                    ps_advance(ps)
        return Option::Some(TopLevelItem::Module(ModuleDecl { name: mod_name, items: mod_items, span: make_span(ps, start) }))

    # Unknown token - skip and report error
    let bad_tok = ps_advance(ps)
    push(ps.errors, "unexpected top-level token '" + bad_tok.lexeme + "' at line " + str(bad_tok.row))
    return none

# ─── Public parse entry point ──────────────────────────────────────────────────

pub fn parse_source(source_tokens: Array<Token>, file_name: String) -> Result<Program, KainError>:
    let ps = ps_new(source_tokens, file_name)
    let items = []

    let running = true
    while running:
        ps_skip_newlines(ps)
        if ps_at_eof(ps):
            running = false
        else:
            let item_opt = parse_top_level_item(ps)
            match item_opt:
                Option::Some(item) => push(items, item)
                _ => ()

    let prog_span = Span { file: file_name, start_row: 1, start_column: 1, end_row: 9999, end_column: 1 }
    return Result::Ok(Program { items: items, span: prog_span })
