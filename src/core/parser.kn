use ast::Program
use ast::Span
use error::KainError

# Kain Parser Seed

pub fn parse_source(source: String, file_name: String) -> Result<Program, KainError>:
    let _unused_source = source
    return Result::Ok(Program {
        items: [],
        span: Span {
            file: file_name,
            start_line: 1,
            start_column: 1,
            end_line: 1,
            end_column: 1
        }
    })
