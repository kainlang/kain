use ast::Program
use error::KainError
use low_level_memory_metadata::MemoryTypeLayout

# Kain Low-Level Memory Lowering Seed

struct MemoryLoweringOutput:
    program: Program
    layouts: Array<MemoryTypeLayout>

pub fn lower_program_memory(program: Program) -> Result<MemoryLoweringOutput, KainError>:
    return Result::Ok(MemoryLoweringOutput {
        program: program,
        layouts: []
    })
