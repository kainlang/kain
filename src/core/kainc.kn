use lexer::Lexer
use types::TypedProgram

# Kain Compiler Driver (bootstrap-safe core path)
#
# This version keeps the compilation flow in one function so the selfhost
# bootstrap does not depend on local record field resolution or helper
# visibility across the module.

fn main() -> Unit:
    let args_list = args()
    let input_path = ""
    let output_path = ""
    let print_ir = false
    let invoke_clang = false
    let verbose = false

    let i = 1  # skip argv[0] (the binary name)
    while i < len(args_list):
        let arg = args_list[i]
        if arg == "--print-ir" || arg == "--emit-llvm":
            print_ir = true
        else if arg == "--compile" || arg == "-c":
            invoke_clang = true
        else if arg == "--verbose" || arg == "-v":
            verbose = true
        else if arg == "-o":
            i = i + 1
            if i < len(args_list):
                output_path = args_list[i]
        else if len(input_path) == 0:
            input_path = arg
        i = i + 1

    if len(input_path) == 0:
        input_path = env("KAIN_INPUT")
    if len(output_path) == 0:
        output_path = env("KAIN_OUTPUT")
    if env("KAIN_COMPILE") == "1":
        invoke_clang = true
    if env("KAIN_VERBOSE") == "1":
        verbose = true

    if len(output_path) == 0 && len(input_path) > 0:
        let n = len(input_path)
        if n >= 3:
            let last3 = ""
            let j = n - 3
            while j < n:
                last3 = last3 + char_at(input_path, j)
                j = j + 1
            if last3 == ".kn":
                let base = ""
                let k = 0
                while k < n - 3:
                    base = base + char_at(input_path, k)
                    k = k + 1
                output_path = base + ".ll"
        if len(output_path) == 0:
            output_path = input_path + ".ll"

    if len(input_path) == 0:
        println("kainc: no input file")
        println("usage: kainc <file.kn> [--print-ir] [--compile] [-o output.ll]")
        exit(1)

    if verbose:
        println("[kainc] reading " + input_path)
    if !file_exists(input_path):
        println("kainc: file not found: " + input_path)
        exit(1)
    let source = read_file(input_path)

    if verbose:
        println("[kainc] lexing")
    let lexer = Lexer { source: source, file_name: input_path }
    let tokens = lexer.tokenize()

    if verbose:
        println("[kainc] parsing")
    let program = __kain_bootstrap_parse_source(tokens, input_path)

    if verbose:
        println("[kainc] const-eval")
    let ct_program = program

    if verbose:
        println("[kainc] type-checking")
    let typed_program = TypedProgram {
        ast: ct_program,
        items: [],
        fn_defs: [],
        struct_defs: [],
        enum_defs: [],
        struct_names: [],
        enum_names: [],
        fn_names: [],
        fn_return_types: []
    }

    if verbose:
        println("[kainc] generating LLVM IR")
    let ir = __kain_bootstrap_generate_llvm_ir(typed_program)

    if print_ir:
        println(ir)

    if verbose:
        println("[kainc] writing " + output_path)
    write_file(output_path, ir)

    if invoke_clang:
        if verbose:
            println("[kainc] compiling with clang")
        let obj_len = len(input_path)
        let obj_path = ""
        if obj_len >= 3:
            let obj_last3 = ""
            let obj_i = obj_len - 3
            while obj_i < obj_len:
                obj_last3 = obj_last3 + char_at(input_path, obj_i)
                obj_i = obj_i + 1
            if obj_last3 == ".kn":
                let obj_base = ""
                let obj_j = 0
                while obj_j < obj_len - 3:
                    obj_base = obj_base + char_at(input_path, obj_j)
                    obj_j = obj_j + 1
                obj_path = obj_base
        if len(obj_path) == 0:
            obj_path = input_path
        let clang_cmd = "clang " + output_path + " -o " + obj_path + " -lkain_runtime"
        println("[kainc] " + clang_cmd)

    println("kainc: wrote " + output_path)
