# Kain Foundational AST

// This file models the owned Kain syntax surface before UE5 and pipeline-era
// expansion. It is intentionally bounded: core declarations, expressions,
// statements, patterns, and type expressions only.

struct Span:
    file: String
    start_line: Int
    start_column: Int
    end_line: Int
    end_column: Int

struct Program:
    items: Array<TopLevelItem>
    span: Span

enum TopLevelItem:
    Function(FnDef)
    Struct(StructDef)
    Enum(EnumDef)
    Trait(TraitDef)
    Impl(ImplDef)
    Const(ConstDef)
    TypeAlias(TypeAliasDef)
    Use(UseDecl)
    ExternFn(ExternFnDef)
    Effect(EffectDef)
    Module(ModuleDecl)

struct ModuleDecl:
    name: String
    items: Array<TopLevelItem>
    span: Span

struct FnDef:
    name: String
    params: Array<Param>
    generics: Array<GenericParam>
    return_type: Option<TypeExpr>
    effects: Array<Path>
    body: Array<Stmt>
    span: Span
    is_pub: Bool
    is_async: Bool

struct Param:
    name: String
    ty: TypeExpr
    default_value: Option<Expr>
    is_mut: Bool
    span: Span

struct GenericParam:
    name: String
    bounds: Array<TypeExpr>
    span: Span

struct StructDef:
    name: String
    generics: Array<GenericParam>
    fields: Array<FieldDef>
    span: Span
    is_pub: Bool

struct FieldDef:
    name: String
    ty: TypeExpr
    default_value: Option<Expr>
    is_pub: Bool
    span: Span

struct EnumDef:
    name: String
    generics: Array<GenericParam>
    variants: Array<EnumVariant>
    span: Span
    is_pub: Bool

struct EnumVariant:
    name: String
    fields: VariantFields
    span: Span

enum VariantFields:
    Unit
    Tuple(Array<TypeExpr>)
    Struct(Array<FieldDef>)

struct TraitDef:
    name: String
    generics: Array<GenericParam>
    methods: Array<TraitMethod>
    span: Span
    is_pub: Bool

struct TraitMethod:
    name: String
    params: Array<Param>
    return_type: Option<TypeExpr>
    default_impl: Option<Array<Stmt>>
    span: Span

struct ImplDef:
    target: TypeExpr
    generics: Array<GenericParam>
    trait_name: Option<Path>
    methods: Array<FnDef>
    span: Span

struct ConstDef:
    name: String
    ty: TypeExpr
    value: Expr
    span: Span
    is_pub: Bool

struct TypeAliasDef:
    name: String
    generics: Array<GenericParam>
    target: TypeExpr
    span: Span
    is_pub: Bool

struct UseDecl:
    path: Path
    alias: Option<String>
    span: Span
    is_pub: Bool

struct ExternFnDef:
    name: String
    params: Array<Param>
    return_type: Option<TypeExpr>
    span: Span
    is_pub: Bool

struct EffectDef:
    name: String
    methods: Array<TraitMethod>
    span: Span
    is_pub: Bool

struct Block:
    statements: Array<Stmt>
    span: Span

enum Stmt:
    Let(LetStmt)
    Expr(ExprStmt)
    Return(ReturnStmt)
    Break(BreakStmt)
    Continue(ContinueStmt)
    If(IfStmt)
    While(WhileStmt)
    For(ForStmt)
    Match(MatchStmt)
    Assign(AssignStmt)
    Block(Block)

struct LetStmt:
    pattern: Pattern
    ty: Option<TypeExpr>
    value: Option<Expr>
    is_mut: Bool
    span: Span

struct ExprStmt:
    expr: Expr
    span: Span

struct ReturnStmt:
    value: Option<Expr>
    span: Span

struct BreakStmt:
    value: Option<Expr>
    span: Span

struct ContinueStmt:
    span: Span

struct IfStmt:
    condition: Expr
    then_branch: Block
    else_branch: Option<Block>
    span: Span

struct WhileStmt:
    condition: Expr
    body: Block
    span: Span

struct ForStmt:
    pattern: Pattern
    iter: Expr
    body: Block
    span: Span

struct MatchStmt:
    value: Expr
    arms: Array<MatchArm>
    span: Span

struct MatchArm:
    pattern: Pattern
    guard: Option<Expr>
    body: Block
    span: Span

struct AssignStmt:
    target: Expr
    value: Expr
    span: Span

enum Expr:
    Literal(Literal)
    Path(Path)
    Tuple(Array<Expr>)
    Array(Array<Expr>)
    StructInit(StructInit)
    EnumInit(EnumInit)
    Call(CallExpr)
    MethodCall(MethodCallExpr)
    Field(FieldExpr)
    Index(IndexExpr)
    Unary(UnaryExpr)
    Binary(BinaryExpr)
    Block(Block)
    If(IfExpr)
    Match(MatchExpr)
    Lambda(LambdaExpr)
    Comptime(ComptimeExpr)

struct StructInit:
    name: Path
    fields: Array<InitField>
    span: Span

struct InitField:
    name: String
    value: Expr
    span: Span

struct EnumInit:
    name: Path
    variant: String
    values: Array<Expr>
    span: Span

struct CallExpr:
    callee: Box<Expr>
    args: Array<Expr>
    span: Span

struct MethodCallExpr:
    receiver: Box<Expr>
    method: String
    args: Array<Expr>
    span: Span

struct FieldExpr:
    target: Box<Expr>
    field: String
    span: Span

struct IndexExpr:
    target: Box<Expr>
    index: Box<Expr>
    span: Span

struct UnaryExpr:
    op: UnaryOp
    value: Box<Expr>
    span: Span

struct BinaryExpr:
    left: Box<Expr>
    op: BinaryOp
    right: Box<Expr>
    span: Span

struct IfExpr:
    condition: Box<Expr>
    then_branch: Block
    else_branch: Option<Block>
    span: Span

struct MatchExpr:
    value: Box<Expr>
    arms: Array<MatchArmExpr>
    span: Span

struct MatchArmExpr:
    pattern: Pattern
    guard: Option<Expr>
    value: Expr
    span: Span

struct LambdaExpr:
    params: Array<Param>
    body: Box<Expr>
    span: Span

struct ComptimeExpr:
    block: Block
    span: Span

enum Pattern:
    Wildcard
    Binding(String)
    BindingMut(String)
    Literal(Literal)
    Tuple(Array<Pattern>)
    Struct(Path, Array<PatternField>)
    Enum(Path, String, Array<Pattern>)
    Or(Array<Pattern>)

struct PatternField:
    name: String
    pattern: Pattern
    span: Span

enum Literal:
    Unit
    Bool(Bool)
    Int(Int)
    Float(Float)
    String(String)
    Char(Char)

enum TypeExpr:
    Unit
    Never
    Path(Path)
    Tuple(Array<TypeExpr>)
    Array(Box<TypeExpr>)
    Slice(Box<TypeExpr>)
    Ref(Bool, Box<TypeExpr>)
    Option(Box<TypeExpr>)
    Result(Box<TypeExpr>, Box<TypeExpr>)
    Function(Array<TypeExpr>, Box<TypeExpr>)
    Generic(String)
    Infer

struct Path:
    segments: Array<PathSegment>
    span: Span

struct PathSegment:
    name: String
    span: Span

enum UnaryOp:
    Negate
    Not
    Deref
    Borrow

enum BinaryOp:
    Add
    Sub
    Mul
    Div
    Mod
    And
    Or
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
    Assign
    AddAssign
    SubAssign
    MulAssign
    DivAssign

struct Attribute:
    name: String
    value: Option<String>
    span: Span

enum Visibility:
    Private
    Public
