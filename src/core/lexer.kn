use span::SourceSpan

# Kain lexer contract
# Bootstrap rendering swaps the Lexer.tokenize body to the host lexer bridge,
# so this file only needs to provide the token model, predicates, and a
# structurally valid indentation wrapper for the self-host source set.

pub enum TokenKind:
    Ident(String)
    Keyword(String)
    IntLiteral(Int)
    FloatLiteral(Float)
    StringLiteral(String)
    FStringLiteral(String)
    CharLiteral(String)
    Symbol(String)
    Indent
    Dedent
    Newline
    Eof
    Error(String)

pub struct Token:
    kind: TokenKind
    lexeme: String
    span: SourceSpan
    row: Int
    col: Int

pub struct Lexer:
    source: String
    file_name: String

impl Lexer:
    pub fn tokenize(self) -> Array<Token>:
        let _ = self.source
        let raw = []
        return process_indentation(raw, self.file_name)

fn is_keyword(word: String) -> Bool:
    if word == "fn" || word == "let" || word == "mut" || word == "var": return true
    if word == "const" || word == "if" || word == "else" || word == "elif": return true
    if word == "match" || word == "for" || word == "while" || word == "loop": return true
    if word == "break" || word == "continue" || word == "return": return true
    if word == "await" || word == "in" || word == "with" || word == "as": return true
    if word == "type" || word == "struct" || word == "enum" || word == "trait": return true
    if word == "impl" || word == "pub" || word == "mod" || word == "use": return true
    if word == "self" || word == "Self" || word == "true" || word == "false": return true
    if word == "none" || word == "extern" || word == "async" || word == "effect": return true
    if word == "component" || word == "shader" || word == "actor" || word == "sc": return true
    if word == "spawn" || word == "send" || word == "receive" || word == "emit": return true
    if word == "comptime" || word == "macro" || word == "vertex" || word == "fragment": return true
    if word == "test" || word == "law" || word == "patch" || word == "converge": return true
    if word == "world" || word == "orchestrate": return true
    if word == "Pure" || word == "IO" || word == "Async" || word == "GPU": return true
    if word == "Reactive" || word == "Unsafe" || word == "Alloc" || word == "Panic": return true
    return false

fn process_indentation(raw: Array<Token>, file_name: String) -> Array<Token>:
    let result = []
    let i = 0
    while i < len(raw):
        push(result, raw[i])
        i = i + 1

    let eof_span = SourceSpan { start: 0, end: 0, file: file_name }
    push(result, Token { kind: TokenKind::Eof, lexeme: "", span: eof_span, row: 0, col: 0 })
    return result

pub fn tokenize_source(source: String, file_name: String) -> Array<Token>:
    let _ = source
    let raw = []
    return process_indentation(raw, file_name)

pub fn tok_is_eof(tok: Token) -> Bool:
    return tok.kind == TokenKind::Eof

pub fn tok_is_newline(tok: Token) -> Bool:
    return tok.kind == TokenKind::Newline

pub fn tok_is_indent(tok: Token) -> Bool:
    return tok.kind == TokenKind::Indent

pub fn tok_is_dedent(tok: Token) -> Bool:
    return tok.kind == TokenKind::Dedent

pub fn tok_is_keyword(tok: Token, kw: String) -> Bool:
    return is_keyword(tok.lexeme) && tok.lexeme == kw

pub fn tok_is_symbol(tok: Token, sym: String) -> Bool:
    match tok.kind:
        TokenKind::Symbol(s) => s == sym
        _ => false

pub fn tok_ident_name(tok: Token) -> String:
    return tok.lexeme

pub fn tok_string_val(tok: Token) -> String:
    match tok.kind:
        TokenKind::StringLiteral(s) => s
        TokenKind::FStringLiteral(s) => s
        _ => ""

pub fn tok_int_val(tok: Token) -> Int:
    match tok.kind:
        TokenKind::IntLiteral(n) => n
        _ => 0

pub fn tok_float_val(tok: Token) -> Float:
    match tok.kind:
        TokenKind::FloatLiteral(f) => f
        _ => 0.0

pub fn tok_char_val(tok: Token) -> String:
    match tok.kind:
        TokenKind::CharLiteral(c) => c
        _ => ""

pub fn tok_is_ident(tok: Token) -> Bool:
    return !is_keyword(tok.lexeme)
