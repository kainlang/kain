use span::Span

# Kain Lexer - Real character-level scanner
# Mirrors crates/kain-core/src/lexer.rs semantics in pure Kain.
# Produces a token stream with INDENT/DEDENT injection from significant whitespace.
#
# Token.lexeme for Newline tokens contains the raw indent whitespace (after the \n)
# so process_indentation can compute the indent level without re-scanning.

pub enum TokenKind:
    Ident(String)
    Keyword(String)
    IntLiteral(Int)
    FloatLiteral(Float)
    StringLiteral(String)
    FStringLiteral(String)
    CharLiteral(String)
    Symbol(String)
    Indent
    Dedent
    Newline
    Eof
    Error(String)

pub struct Token:
    kind: TokenKind
    lexeme: String
    span: Span
    row: Int
    col: Int

pub struct Lexer:
    source: String
    file_name: String

impl Lexer:
    pub fn tokenize(self) -> Array<Token>:
        return tokenize_source(self.source, self.file_name)

# - Internal scanner sc -

struct ScanState:
    source: String
    file_name: String
    pos: Int
    row: Int
    col: Int

fn scan_peek(sc: ScanState) -> String:
    if sc.pos >= len(sc.source):
        return ""
    return char_at(sc.source, sc.pos)

fn scan_peek_at(sc: ScanState, offset: Int) -> String:
    let p = sc.pos + offset
    if p >= len(sc.source):
        return ""
    return char_at(sc.source, p)

fn scan_advance(sc: ScanState) -> String:
    let ch = scan_peek(sc)
    if ch != "":
        sc.pos = sc.pos + 1
        if ch == "\n":
            sc.row = sc.row + 1
            sc.col = 1
        else:
            sc.col = sc.col + 1
    return ch

# - Character class helpers -

fn is_alpha_char(ch: String) -> Bool:
    if ch == "_": return true
    if ch == "a" || ch == "b" || ch == "c" || ch == "d" || ch == "e": return true
    if ch == "f" || ch == "g" || ch == "h" || ch == "i" || ch == "j": return true
    if ch == "k" || ch == "l" || ch == "m" || ch == "n" || ch == "o": return true
    if ch == "p" || ch == "q" || ch == "r" || ch == "s" || ch == "t": return true
    if ch == "u" || ch == "v" || ch == "w" || ch == "x" || ch == "y" || ch == "z": return true
    if ch == "A" || ch == "B" || ch == "C" || ch == "D" || ch == "E": return true
    if ch == "F" || ch == "G" || ch == "H" || ch == "I" || ch == "J": return true
    if ch == "K" || ch == "L" || ch == "M" || ch == "N" || ch == "O": return true
    if ch == "P" || ch == "Q" || ch == "R" || ch == "S" || ch == "T": return true
    if ch == "U" || ch == "V" || ch == "W" || ch == "X" || ch == "Y" || ch == "Z": return true
    return false

fn is_digit_char(ch: String) -> Bool:
    if ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4": return true
    if ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9": return true
    return false

fn is_alnum_char(ch: String) -> Bool:
    return is_alpha_char(ch) || is_digit_char(ch)

fn digit_val(ch: String) -> Int:
    if ch == "0": return 0
    if ch == "1": return 1
    if ch == "2": return 2
    if ch == "3": return 3
    if ch == "4": return 4
    if ch == "5": return 5
    if ch == "6": return 6
    if ch == "7": return 7
    if ch == "8": return 8
    if ch == "9": return 9
    return 0

# - Keyword detection -

fn is_keyword(word: String) -> Bool:
    # Core control-flow and declaration keywords
    if word == "fn" || word == "let" || word == "mut" || word == "var": return true
    if word == "const" || word == "if" || word == "else" || word == "elif": return true
    if word == "match" || word == "for" || word == "while" || word == "loop": return true
    if word == "break" || word == "continue" || word == "return": return true
    if word == "await" || word == "in" || word == "with" || word == "as": return true
    if word == "type" || word == "struct" || word == "enum" || word == "trait": return true
    if word == "impl" || word == "pub" || word == "mod" || word == "use": return true
    if word == "self" || word == "Self" || word == "true" || word == "false": return true
    if word == "none" || word == "extern" || word == "async" || word == "effect": return true
    # Extended / Kain-specific keywords
    if word == "component" || word == "shader" || word == "actor" || word == "sc": return true
    if word == "spawn" || word == "send" || word == "receive" || word == "emit": return true
    if word == "comptime" || word == "macro" || word == "vertex" || word == "fragment": return true
    if word == "test" || word == "law" || word == "patch" || word == "converge": return true
    if word == "world" || word == "orchestrate": return true
    # Effect annotations (capital first letter)
    if word == "Pure" || word == "IO" || word == "Async" || word == "GPU": return true
    if word == "Reactive" || word == "Unsafe" || word == "Alloc" || word == "Panic": return true
    return false

# - Token-emitting helpers -

fn push_symbol(tok_buf: Array<Token>, sc: ScanState, start_pos: Int, start_row: Int, start_col: Int, sym: String) -> Unit:
    let span = Span { start: start_pos, end: sc.pos, file: sc.file_name }
    push(tok_buf, Token { kind: TokenKind::Symbol(sym), lexeme: sym, span: span, row: start_row, col: start_col })

# - Escape-sequence decoder -

fn decode_escape(sc: ScanState) -> String:
    let next = scan_advance(sc)
    if next == "n": return "\n"
    if next == "r": return "\r"
    if next == "t": return "\t"
    if next == "0": return "\0"
    if next == "\\": return "\\"
    if next == "\"": return "\""
    if next == "'": return "'"
    # Unknown escape - keep both characters
    return "\\" + next

# - Compound token scanners -

fn do_scan_string(sc: ScanState, start_pos: Int, start_row: Int, start_col: Int, is_fstring: Bool) -> Token:
    scan_advance(sc)  # consume opening '"'
    let value = ""
    while scan_peek(sc) != "\"" && scan_peek(sc) != "":
        let ch = scan_peek(sc)
        if ch == "\\":
            scan_advance(sc)
            value = value + decode_escape(sc)
        else:
            value = value + scan_advance(sc)
    if scan_peek(sc) == "\"":
        scan_advance(sc)  # consume closing '"'
    let span = Span { start: start_pos, end: sc.pos, file: sc.file_name }
    if is_fstring:
        return Token { kind: TokenKind::FStringLiteral(value), lexeme: value, span: span, row: start_row, col: start_col }
    return Token { kind: TokenKind::StringLiteral(value), lexeme: value, span: span, row: start_row, col: start_col }

fn do_scan_char(sc: ScanState, start_pos: Int, start_row: Int, start_col: Int) -> Token:
    scan_advance(sc)  # consume "'"
    let value = ""
    if scan_peek(sc) == "\\":
        scan_advance(sc)
        value = decode_escape(sc)
    else:
        value = scan_advance(sc)
    if scan_peek(sc) == "'":
        scan_advance(sc)  # consume closing "'"
    let span = Span { start: start_pos, end: sc.pos, file: sc.file_name }
    return Token { kind: TokenKind::CharLiteral(value), lexeme: value, span: span, row: start_row, col: start_col }

fn do_scan_word(sc: ScanState, start_pos: Int, start_row: Int, start_col: Int) -> Token:
    let lexeme = ""
    while is_alnum_char(scan_peek(sc)):
        lexeme = lexeme + scan_advance(sc)
    let span = Span { start: start_pos, end: sc.pos, file: sc.file_name }
    if is_keyword(lexeme):
        return Token { kind: TokenKind::Keyword(lexeme), lexeme: lexeme, span: span, row: start_row, col: start_col }
    return Token { kind: TokenKind::Ident(lexeme), lexeme: lexeme, span: span, row: start_row, col: start_col }

fn do_scan_number(sc: ScanState, start_pos: Int, start_row: Int, start_col: Int) -> Token:
    let lexeme = ""
    let int_val = 0
    while is_digit_char(scan_peek(sc)) || scan_peek(sc) == "_":
        let ch = scan_advance(sc)
        lexeme = lexeme + ch
        if ch != "_":
            int_val = int_val * 10 + digit_val(ch)
    # Check for float (digit . digit)
    if scan_peek(sc) == "." && is_digit_char(scan_peek_at(sc, 1)):
        lexeme = lexeme + scan_advance(sc)  # consume "."
        let frac = 0.0
        let divisor = 10.0
        while is_digit_char(scan_peek(sc)) || scan_peek(sc) == "_":
            let ch = scan_advance(sc)
            lexeme = lexeme + ch
            if ch != "_":
                frac = frac + digit_val(ch) * 1.0 / divisor
                divisor = divisor * 10.0
        let float_val = int_val * 1.0 + frac
        let span = Span { start: start_pos, end: sc.pos, file: sc.file_name }
        return Token { kind: TokenKind::FloatLiteral(float_val), lexeme: lexeme, span: span, row: start_row, col: start_col }
    let span = Span { start: start_pos, end: sc.pos, file: sc.file_name }
    return Token { kind: TokenKind::IntLiteral(int_val), lexeme: lexeme, span: span, row: start_row, col: start_col }

# - Main scan-one-token dispatch -

fn collect_one_token(sc: ScanState, tokens_out: Array<Token>) -> Unit:
    let ch = scan_peek(sc)
    if ch == "":
        return

    let start_pos = sc.pos
    let s_row = sc.row
    let start_col = sc.col

    # Horizontal whitespace (skip silently)
    if ch == " " || ch == "\t":
        while scan_peek(sc) == " " || scan_peek(sc) == "\t":
            scan_advance(sc)
        return

    # Significant newline with trailing indent whitespace
    if ch == "\n":
        scan_advance(sc)  # consume '\n'
        let indent_ws = ""
        while scan_peek(sc) == " " || scan_peek(sc) == "\t":
            indent_ws = indent_ws + scan_advance(sc)
        let span = Span { start: start_pos, end: sc.pos, file: sc.file_name }
        push(tok_buf, Token { kind: TokenKind::Newline, lexeme: indent_ws, span: span, row: start_row, col: start_col })
        return

    # Line comments  (#  and  //)
    if ch == "#":
        while scan_peek(sc) != "\n" && scan_peek(sc) != "":
            scan_advance(sc)
        return
    if ch == "/" && scan_peek_at(sc, 1) == "/":
        while scan_peek(sc) != "\n" && scan_peek(sc) != "":
            scan_advance(sc)
        return

    # f-strings  f"..."
    if ch == "f" && scan_peek_at(sc, 1) == "\"":
        scan_advance(sc)  # skip 'f'
        push(tok_buf, do_scan_string(sc, start_pos, s_row, start_col, true))
        return

    # r-strings  r"..."  (raw - no escape processing, stored as-is)
    if ch == "r" && scan_peek_at(sc, 1) == "\"":
        scan_advance(sc)  # skip 'r'
        push(tok_buf, do_scan_string(sc, start_pos, s_row, start_col, false))
        return

    # Regular strings
    if ch == "\"":
        push(tok_buf, do_scan_string(sc, start_pos, s_row, start_col, false))
        return

    # Char literals
    if ch == "'":
        push(tok_buf, do_scan_char(sc, start_pos, s_row, start_col))
        return

    # Identifiers and keywords  (f and r fall through if not followed by a quote)
    if is_alpha_char(ch):
        push(tok_buf, do_scan_word(sc, start_pos, s_row, start_col))
        return

    # Numbers
    if is_digit_char(ch):
        push(tok_buf, do_scan_number(sc, start_pos, s_row, start_col))
        return

    # Symbols - consume the first character, then look ahead for multi-char forms
    scan_advance(sc)
    let ch2 = scan_peek(sc)
    let ch3 = scan_peek_at(sc, 1)

    # Three-character operators
    if ch == "." && ch2 == "." && ch3 == ".":
        scan_advance(sc)
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "...")
        return
    if ch == "<" && ch2 == "<" && ch3 == "=":
        scan_advance(sc)
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "<<=")
        return
    if ch == ">" && ch2 == ">" && ch3 == "=":
        scan_advance(sc)
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, ">>=")
        return

    # Two-character operators
    if ch == "-" && ch2 == ">":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "->")
        return
    if ch == "=" && ch2 == ">":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "=>")
        return
    if ch == "=" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "==")
        return
    if ch == "!" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "!=")
        return
    if ch == "<" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "<=")
        return
    if ch == ">" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, ">=")
        return
    if ch == "+" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "+=")
        return
    if ch == "-" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "-=")
        return
    if ch == "*" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "*=")
        return
    if ch == "/" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "/=")
        return
    if ch == "%" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "%=")
        return
    if ch == "&" && ch2 == "&":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "&&")
        return
    if ch == "|" && ch2 == "|":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "||")
        return
    if ch == ":" && ch2 == ":":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "::")
        return
    if ch == "." && ch2 == ".":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "..")
        return
    if ch == "<" && ch2 == "<":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "<<")
        return
    if ch == ">" && ch2 == ">":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, ">>")
        return
    if ch == "*" && ch2 == "*":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "**")
        return
    if ch == "<" && ch2 == "/":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "</")
        return
    if ch == "+" && ch2 == "+":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "++")
        return
    if ch == "-" && ch2 == "-":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "--")
        return
    if ch == "?" && ch2 == "?":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "??")
        return
    if ch == "?" && ch2 == ".":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "?.")
        return
    if ch == "&" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "&=")
        return
    if ch == "|" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "|=")
        return
    if ch == "^" && ch2 == "=":
        scan_advance(sc)
        push_symbol(tok_buf, sc, start_pos, s_row, start_col, "^=")
        return

    # Single-character symbol
    push_symbol(tok_buf, sc, start_pos, s_row, start_col, ch)

# - Indentation processing -

fn count_indent_ws(ws: String) -> Int:
    let count = 0
    let i = 0
    while i < len(ws):
        let c = char_at(ws, i)
        if c == "\t":
            count = count + 4
        else:
            count = count + 1
        i = i + 1
    return count

fn int_arr_slice(arr: Array<Int>, new_len: Int) -> Array<Int>:
    let result = []
    let i = 0
    while i < new_len && i < len(arr):
        push(result, arr[i])
        i = i + 1
    return result

fn int_arr_push(arr: Array<Int>, val: Int) -> Array<Int>:
    let result = []
    let i = 0
    while i < len(arr):
        push(result, arr[i])
        i = i + 1
    push(result, val)
    return result

fn process_indentation(raw: Array<Token>, file_name: String) -> Array<Token>:
    let result = []
    let indent_stack = [0]
    let n = len(raw)
    let i = 0

    while i < n:
        let tok = raw[i]
        i = i + 1

        if tok.kind != TokenKind::Newline:
            push(result, tok)
        else:
            # Skip consecutive newlines (blank lines)
            if i < n && raw[i].kind == TokenKind::Newline:
                # blank line - skip this newline silently
                let _skip = 0
            else:
                let indent = count_indent_ws(tok.lexeme)
                let current = indent_stack[len(indent_stack) - 1]
                push(result, tok)  # always emit the Newline token

                if indent > current:
                    indent_stack = int_arr_push(indent_stack, indent)
                    let itok = Token { kind: TokenKind::Indent, lexeme: "", span: tok.span, row: tok.row, col: tok.col }
                    push(result, itok)
                else if indent < current:
                    while len(indent_stack) > 1 && indent_stack[len(indent_stack) - 1] > indent:
                        indent_stack = int_arr_slice(indent_stack, len(indent_stack) - 1)
                        let dtok = Token { kind: TokenKind::Dedent, lexeme: "", span: tok.span, row: tok.row, col: tok.col }
                        push(result, dtok)

    # Close any open indent levels at EOF
    let eof_span = Span { start: 0, end: 0, file: file_name }
    if len(result) > 0:
        eof_span = result[len(result) - 1].span

    while len(indent_stack) > 1:
        indent_stack = int_arr_slice(indent_stack, len(indent_stack) - 1)
        let dtok = Token { kind: TokenKind::Dedent, lexeme: "", span: eof_span, row: 0, col: 0 }
        push(result, dtok)

    push(result, Token { kind: TokenKind::Eof, lexeme: "", span: eof_span, row: 0, col: 0 })
    return result

# - Public entry point -

pub fn tokenize_source(source: String, file_name: String) -> Array<Token>:
    let sc = ScanState {
        source: source,
        file_name: file_name,
        pos: 0,
        row: 1,
        col: 1
    }
    let raw = []

    while sc.pos < len(sc.source):
        collect_one_token(sc, raw)

    return process_indentation(raw, file_name)

# Token predicate helpers used by external callers (parser, diagnostics, etc.)

pub fn tok_is_eof(tok: Token) -> Bool:
    return tok.kind == TokenKind::Eof

pub fn tok_is_newline(tok: Token) -> Bool:
    return tok.kind == TokenKind::Newline

pub fn tok_is_indent(tok: Token) -> Bool:
    return tok.kind == TokenKind::Indent

pub fn tok_is_dedent(tok: Token) -> Bool:
    return tok.kind == TokenKind::Dedent

pub fn tok_is_keyword(tok: Token, kw: String) -> Bool:
    match tok.kind:
        TokenKind::Keyword(k) => return k == kw
        _ => return false

pub fn tok_is_symbol(tok: Token, sym: String) -> Bool:
    match tok.kind:
        TokenKind::Symbol(s) => return s == sym
        _ => return false

pub fn tok_ident_name(tok: Token) -> String:
    match tok.kind:
        TokenKind::Ident(name) => return name
        _ => return ""

pub fn tok_string_val(tok: Token) -> String:
    match tok.kind:
        TokenKind::StringLiteral(s) => return s
        TokenKind::FStringLiteral(s) => return s
        _ => return ""

pub fn tok_int_val(tok: Token) -> Int:
    match tok.kind:
        TokenKind::IntLiteral(n) => return n
        _ => return 0

pub fn tok_float_val(tok: Token) -> Float:
    match tok.kind:
        TokenKind::FloatLiteral(f) => return f
        _ => return 0.0

pub fn tok_char_val(tok: Token) -> String:
    match tok.kind:
        TokenKind::CharLiteral(c) => return c
        _ => return ""

pub fn tok_is_ident(tok: Token) -> Bool:
    match tok.kind:
        TokenKind::Ident(_) => return true
        _ => return false
