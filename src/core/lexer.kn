use span::Span

# Kain Lexer Seed

pub enum TokenKind:
    Ident(String)
    Keyword(String)
    IntLiteral(Int)
    StringLiteral(String)
    Symbol(String)
    Newline
    Eof
    Error(String)

pub struct Token:
    kind: TokenKind
    lexeme: String
    span: Span

pub struct Lexer:
    source: String
    file_name: String

impl Lexer:
    pub fn tokenize(self) -> Array<Token>:
        return tokenize_source(self.source, self.file_name)

pub fn tokenize_source(source: String, file_name: String) -> Array<Token>:
    let _unused_source = source
    let tokens = []
    push(tokens, Token {
        kind: TokenKind::Eof,
        lexeme: "",
        span: Span { start: 0, end: 0, file: file_name }
    })
    return tokens
