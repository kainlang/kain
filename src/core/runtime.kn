use ast::Program
use error::KainError

# Kain runtime bootstrap stub
#
# The owned interpreter is not on the current `kain selfhost bootstrap
# --emit-llvm-only` critical path. Keep this file parser-safe until the owned
# frontend and LLVM/native lane are green enough to support the richer runtime
# surface again.

pub enum Value:
    Unit

pub enum Signal:
    Normal

pub struct RuntimeContext:
    placeholder: Bool

pub fn run_program(program: Program) -> Result<Value, KainError>:
    let _ = program
    return Result::Ok(Value::Unit)
