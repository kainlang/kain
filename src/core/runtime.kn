use ast::Block
use ast::BinaryOp
use ast::Expr
use ast::ExprStmt
use ast::FnDef
use ast::Literal
use ast::MatchArmExpr
use ast::Param
use ast::Pattern
use ast::Program
use ast::ReturnStmt
use ast::Stmt
use ast::TopLevelItem
use ast::UnaryOp
use error::ErrorKind
use error::KainError
use span::Span

# Kain Runtime - tree-walking interpreter
# Expanded from the seed to cover all core expression and statement forms.
# Used by `kain run` and `kain test` for interpret-mode execution.
#
# NOTE: All complex multi-statement match arm bodies have been extracted
# into helper functions to work around Kain's indentation-sensitive parser.

pub enum Value:
    Unit
    Bool(Bool)
    Int(Int)
    Float(Float)
    String_(String)
    Char(String)
    Array(Array<Value>)
    Struct_(String, Array<String>, Array<Value>)
    Enum_(String, String, Array<Value>)
    Function(String)
    Null

impl Value:
    pub fn to_repr(self) -> String:
        match self:
            Value::Unit =>
                return "()"
            Value::Bool(b) =>
                if b: return "true"
                return "false"
            Value::Int(n) =>
                return str(n)
            Value::Float(f) =>
                return str(f)
            Value::String_(s) =>
                return s
            Value::Char(c) =>
                return c
            Value::Array(items) =>
                let parts = "["
                let is_first = true
                for item in items:
                    if !is_first: parts = parts + ", "
                    parts = parts + item.to_repr()
                    is_first = false
                return parts + "]"
            Value::Null =>
                return "null"
            _ =>
                return "<value>"

    pub fn is_truthy(self) -> Bool:
        match self:
            Value::Bool(b) =>
                return b
            Value::Int(n) =>
                return n != 0
            Value::String_(s) =>
                return len(s) > 0
            Value::Null =>
                return false
            Value::Unit =>
                return false
            _ =>
                return true

    pub fn as_int(self) -> Int:
        match self:
            Value::Int(n) =>
                return n
            Value::Bool(b) =>
                if b: return 1
                return 0
            _ =>
                return 0

    pub fn as_float(self) -> Float:
        match self:
            Value::Float(f) =>
                return f
            Value::Int(n) =>
                return n * 1.0
            _ =>
                return 0.0

    pub fn as_string(self) -> String:
        return self.to_repr()

# - Bindings and environment -

struct Binding:
    name: String
    value: Value
    is_mut: Bool

struct Environment:
    scopes: Array<Array<Binding>>

fn env_new() -> Environment:
    return Environment { scopes: [[]] }

fn env_push_scope(e: Environment) -> Unit:
    push(e.scopes, [])

fn env_pop_scope(e: Environment) -> Unit:
    if len(e.scopes) > 1:
        let new_scopes = []
        let i = 0
        while i < len(e.scopes) - 1:
            push(new_scopes, e.scopes[i])
            i = i + 1
        e.scopes = new_scopes

fn env_define(e: Environment, name: String, value: Value, is_mut: Bool) -> Unit:
    if len(e.scopes) == 0:
        return
    let top = e.scopes[len(e.scopes) - 1]
    push(top, Binding { name: name, value: value, is_mut: is_mut })

fn env_set(e: Environment, name: String, value: Value) -> Bool:
    let si = len(e.scopes) - 1
    while si >= 0:
        let scope = e.scopes[si]
        let bi = len(scope) - 1
        while bi >= 0:
            if scope[bi].name == name:
                scope[bi] = Binding { name: name, value: value, is_mut: scope[bi].is_mut }
                return true
            bi = bi - 1
        si = si - 1
    return false

fn env_get(e: Environment, name: String) -> Option<Value>:
    let si = len(e.scopes) - 1
    while si >= 0:
        let scope = e.scopes[si]
        let bi = len(scope) - 1
        while bi >= 0:
            if scope[bi].name == name:
                return Option::Some(scope[bi].value)
            bi = bi - 1
        si = si - 1
    return none

# - Control flow signals -

pub enum Signal:
    Normal
    Return_(Value)
    Break_(Value)
    Continue_

# - Runtime context -

pub struct RuntimeContext:
    env: Environment
    functions: Array<FnDef>
    errors: Array<String>

fn ctx_new() -> RuntimeContext:
    return RuntimeContext {
        env: env_new(),
        functions: [],
        errors: []
    }

fn ctx_find_fn(ctx: RuntimeContext, name: String) -> Option<FnDef>:
    for fndef in ctx.functions:
        if fndef.name == name:
            return Option::Some(fndef)
    return none

fn ctx_register_fns(ctx: RuntimeContext, program: Program) -> Unit:
    for item in program.items:
        match item:
            TopLevelItem::Function(f) =>
                push(ctx.functions, f)
            _ =>
                ()

# - Builtin dispatch -

fn call_builtin(ctx: RuntimeContext, name: String, arg_vals: Array<Value>) -> Option<Value>:
    if name == "println":
        if len(arg_vals) > 0:
            println(arg_vals[0].to_repr())
        else:
            println("")
        return Option::Some(Value::Unit)
    if name == "print":
        if len(arg_vals) > 0:
            print(arg_vals[0].to_repr())
        return Option::Some(Value::Unit)
    if name == "panic":
        let msg = ""
        if len(arg_vals) > 0:
            msg = arg_vals[0].as_string()
        println("panic: " + msg)
        return Option::Some(Value::Unit)
    if name == "len":
        if len(arg_vals) > 0:
            return Option::Some(value_len(arg_vals[0]))
        return Option::Some(Value::Int(0))
    if name == "push":
        if len(arg_vals) >= 2:
            match arg_vals[0]:
                Value::Array(items) =>
                    push(items, arg_vals[1])
                _ =>
                    ()
        return Option::Some(Value::Unit)
    if name == "str":
        if len(arg_vals) > 0:
            return Option::Some(Value::String_(arg_vals[0].to_repr()))
        return Option::Some(Value::String_(""))
    if name == "char_at":
        if len(arg_vals) >= 2:
            return Option::Some(value_char_at(arg_vals[0], arg_vals[1]))
        return Option::Some(Value::String_(""))
    if name == "read_file":
        if len(arg_vals) > 0:
            let p = arg_vals[0].as_string()
            return Option::Some(Value::String_(read_file(p)))
        return Option::Some(Value::String_(""))
    if name == "write_file":
        if len(arg_vals) >= 2:
            let p = arg_vals[0].as_string()
            let c = arg_vals[1].as_string()
            write_file(p, c)
        return Option::Some(Value::Unit)
    if name == "read_line":
        return Option::Some(Value::String_(read_line()))
    if name == "stdout_write":
        if len(arg_vals) > 0:
            stdout_write(arg_vals[0].as_string())
        return Option::Some(Value::Unit)
    if name == "stdin_read_exact":
        if len(arg_vals) > 0:
            let length = arg_vals[0].as_int()
            return Option::Some(Value::String_(stdin_read_exact(length)))
        return Option::Some(Value::String_(""))
    if name == "env":
        if len(arg_vals) > 0:
            let k = arg_vals[0].as_string()
            return Option::Some(Value::String_(env(k)))
        return Option::Some(Value::String_(""))
    if name == "file_exists":
        if len(arg_vals) > 0:
            let p = arg_vals[0].as_string()
            return Option::Some(Value::Bool(file_exists(p)))
        return Option::Some(Value::Bool(false))
    if name == "args":
        let raw = args()
        let result = []
        for a in raw:
            push(result, Value::String_(a))
        return Option::Some(Value::Array(result))
    if name == "exit":
        let code = 0
        if len(arg_vals) > 0:
            code = arg_vals[0].as_int()
        exit(code)
        return Option::Some(Value::Unit)
    if name == "int":
        if len(arg_vals) > 0:
            return Option::Some(Value::Int(arg_vals[0].as_int()))
        return Option::Some(Value::Int(0))
    return none

fn value_len(v: Value) -> Value:
    match v:
        Value::Array(items) =>
            return Value::Int(len(items))
        Value::String_(s) =>
            return Value::Int(len(s))
        _ =>
            return Value::Int(0)

fn value_char_at(sv: Value, iv: Value) -> Value:
    match sv:
        Value::String_(s) =>
            let idx = iv.as_int()
            if idx >= 0 && idx < len(s):
                return Value::String_(char_at(s, idx))
        _ =>
            ()
    return Value::String_("")

# - Pattern matching -

fn match_pattern(ctx: RuntimeContext, pat: Pattern, val: Value) -> Bool:
    match pat:
        Pattern::Wildcard =>
            return true
        Pattern::Binding(name) =>
            env_define(ctx.env, name, val, true)
            return true
        Pattern::BindingMut(name) =>
            env_define(ctx.env, name, val, true)
            return true
        Pattern::Literal(lit) =>
            let lit_val = eval_literal(lit)
            return values_equal(lit_val, val)
        Pattern::Enum(path, variant_name, pats) =>
            return match_enum_pattern(ctx, variant_name, pats, val)
        _ =>
            return false

fn match_enum_pattern(ctx: RuntimeContext, variant_name: String, pats: Array<Pattern>, val: Value) -> Bool:
    match val:
        Value::Enum_(_, vname, payloads) =>
            if vname != variant_name:
                return false
            let i = 0
            while i < len(pats) && i < len(payloads):
                if !match_pattern(ctx, pats[i], payloads[i]):
                    return false
                i = i + 1
            return true
        _ =>
            return false

fn values_equal(a: Value, b: Value) -> Bool:
    match a:
        Value::Int(n1) =>
            match b:
                Value::Int(n2) =>
                    return n1 == n2
                _ =>
                    return false
        Value::Bool(b1) =>
            match b:
                Value::Bool(b2) =>
                    return b1 == b2
                _ =>
                    return false
        Value::String_(s1) =>
            match b:
                Value::String_(s2) =>
                    return s1 == s2
                _ =>
                    return false
        Value::Unit =>
            match b:
                Value::Unit =>
                    return true
                _ =>
                    return false
        Value::Null =>
            match b:
                Value::Null =>
                    return true
                _ =>
                    return false
        _ =>
            return false

fn eval_literal(lit: Literal) -> Value:
    match lit:
        Literal::Int(n) =>
            return Value::Int(n)
        Literal::Float(f) =>
            return Value::Float(f)
        Literal::String(s) =>
            return Value::String_(s)
        Literal::Char(c) =>
            return Value::Char(c)
        Literal::Bool(b) =>
            return Value::Bool(b)
        Literal::Unit =>
            return Value::Unit

# - Expression evaluation helpers -
# These helpers exist to avoid deeply-nested match arms in eval_expr which
# can confuse the Kain indentation parser.

fn eval_path_expr(ctx: RuntimeContext, path: Path) -> Value:
    if len(path.segments) == 0:
        return Value::Null
    let name = path.segments[0].name
    if name == "true": return Value::Bool(true)
    if name == "false": return Value::Bool(false)
    if name == "none": return Value::Null
    let found = env_get(ctx.env, name)
    match found:
        Option::Some(v) =>
            return v
        _ =>
            return Value::Null

fn eval_call_expr(ctx: RuntimeContext, call: CallExpr) -> Value:
    let callee_name = ""
    match call.callee:
        Expr::Path(p) =>
            if len(p.segments) > 0:
                callee_name = p.segments[0].name
        _ =>
            ()
    let arg_vals = []
    for arg in call.args:
        push(arg_vals, eval_expr(ctx, arg))
    let builtin_result = call_builtin(ctx, callee_name, arg_vals)
    match builtin_result:
        Option::Some(v) =>
            return v
        _ =>
            ()
    let user_fn_opt = ctx_find_fn(ctx, callee_name)
    match user_fn_opt:
        Option::Some(f) =>
            return call_user_fn(ctx, f, arg_vals)
        _ =>
            return Value::Null

fn eval_method_call(ctx: RuntimeContext, mc: MethodCallExpr) -> Value:
    let recv_val = eval_expr(ctx, mc.receiver)
    let arg_vals = [recv_val]
    for arg in mc.args:
        push(arg_vals, eval_expr(ctx, arg))
    if mc.method == "to_repr" || mc.method == "to_string" || mc.method == "display":
        return Value::String_(recv_val.to_repr())
    if mc.method == "is_truthy":
        return Value::Bool(recv_val.is_truthy())
    if mc.method == "as_int":
        return Value::Int(recv_val.as_int())
    if mc.method == "len":
        return value_len(recv_val)
    let user_fn_opt2 = ctx_find_fn(ctx, mc.method)
    match user_fn_opt2:
        Option::Some(f) =>
            return call_user_fn(ctx, f, arg_vals)
        _ =>
            return Value::Null

fn eval_if_expr(ctx: RuntimeContext, ife: IfExpr) -> Value:
    let cond = eval_expr(ctx, ife.condition)
    if cond.is_truthy():
        let sig = eval_block(ctx, ife.then_branch)
        return signal_to_value(sig)
    let else_result = eval_if_else_branch(ctx, ife.else_branch)
    return else_result

fn eval_if_else_branch(ctx: RuntimeContext, else_branch: Option<Block>) -> Value:
    match else_branch:
        Option::Some(else_block) =>
            let sig = eval_block(ctx, else_block)
            return signal_to_value(sig)
        _ =>
            return Value::Unit

fn signal_to_value(sig: Signal) -> Value:
    match sig:
        Signal::Return_(v) =>
            return v
        Signal::Break_(v) =>
            return v
        _ =>
            return Value::Unit

fn eval_match_expr(ctx: RuntimeContext, me: MatchExpr) -> Value:
    let val = eval_expr(ctx, me.value)
    for arm in me.arms:
        env_push_scope(ctx.env)
        if match_pattern(ctx, arm.pattern, val):
            let arm_val = eval_expr(ctx, arm.value)
            env_pop_scope(ctx.env)
            return arm_val
        env_pop_scope(ctx.env)
    return Value::Unit

fn eval_array_expr(ctx: RuntimeContext, items: Array<Expr>) -> Value:
    let result = []
    for item in items:
        push(result, eval_expr(ctx, item))
    return Value::Array(result)

fn eval_struct_init(ctx: RuntimeContext, si: StructInit) -> Value:
    let sname = ""
    if len(si.name.segments) > 0:
        sname = si.name.segments[0].name
    let field_names = []
    let field_vals = []
    for field in si.fields:
        push(field_names, field.name)
        push(field_vals, eval_expr(ctx, field.value))
    return Value::Struct_(sname, field_names, field_vals)

fn eval_field_expr(ctx: RuntimeContext, fe: FieldExpr) -> Value:
    let base = eval_expr(ctx, fe.target)
    match base:
        Value::Struct_(_, field_names, field_vals) =>
            return find_field_val(field_names, field_vals, fe.field)
        _ =>
            return Value::Null

fn find_field_val(field_names: Array<String>, field_vals: Array<Value>, field: String) -> Value:
    let i = 0
    while i < len(field_names):
        if field_names[i] == field:
            return field_vals[i]
        i = i + 1
    return Value::Null

fn eval_index_expr(ctx: RuntimeContext, ie: IndexExpr) -> Value:
    let base = eval_expr(ctx, ie.target)
    let idx = eval_expr(ctx, ie.index)
    let n = idx.as_int()
    match base:
        Value::Array(items) =>
            if n >= 0 && n < len(items):
                return items[n]
        Value::String_(s) =>
            if n >= 0 && n < len(s):
                return Value::String_(char_at(s, n))
        _ =>
            ()
    return Value::Null

# - Expression evaluation -

fn eval_expr(ctx: RuntimeContext, expr: Expr) -> Value:
    match expr:
        Expr::Literal(lit) =>
            return eval_literal(lit)
        Expr::Path(path) =>
            return eval_path_expr(ctx, path)
        Expr::Binary(bin) =>
            return eval_binary(ctx, bin.left, bin.op, bin.right)
        Expr::Unary(un) =>
            return eval_unary(ctx, un.op, un.value)
        Expr::Call(call) =>
            return eval_call_expr(ctx, call)
        Expr::MethodCall(mc) =>
            return eval_method_call(ctx, mc)
        Expr::If(ife) =>
            return eval_if_expr(ctx, ife)
        Expr::Match(me) =>
            return eval_match_expr(ctx, me)
        Expr::Array(items) =>
            return eval_array_expr(ctx, items)
        Expr::Tuple(items) =>
            return eval_array_expr(ctx, items)
        Expr::Field(fe) =>
            return eval_field_expr(ctx, fe)
        Expr::Index(ie) =>
            return eval_index_expr(ctx, ie)
        Expr::StructInit(si) =>
            return eval_struct_init(ctx, si)
        _ =>
            return Value::Null

fn eval_binary(ctx: RuntimeContext, left: Expr, op: BinaryOp, right: Expr) -> Value:
    match op:
        BinaryOp::And =>
            let lv = eval_expr(ctx, left)
            if !lv.is_truthy(): return Value::Bool(false)
            return Value::Bool(eval_expr(ctx, right).is_truthy())
        BinaryOp::Or =>
            let lv = eval_expr(ctx, left)
            if lv.is_truthy(): return Value::Bool(true)
            return Value::Bool(eval_expr(ctx, right).is_truthy())
        _ =>
            ()
    let lv = eval_expr(ctx, left)
    let rv = eval_expr(ctx, right)
    return eval_binary_values(op, lv, rv)

fn eval_binary_values(op: BinaryOp, lv: Value, rv: Value) -> Value:
    match op:
        BinaryOp::Add =>
            return value_add(lv, rv)
        BinaryOp::Sub =>
            return Value::Int(lv.as_int() - rv.as_int())
        BinaryOp::Mul =>
            return value_mul(lv, rv)
        BinaryOp::Div =>
            return value_div(lv, rv)
        BinaryOp::Mod =>
            let d2 = rv.as_int()
            if d2 == 0: return Value::Int(0)
            return Value::Int(lv.as_int() % d2)
        BinaryOp::Eq =>
            return Value::Bool(values_equal(lv, rv))
        BinaryOp::Ne =>
            return Value::Bool(!values_equal(lv, rv))
        BinaryOp::Lt =>
            return Value::Bool(lv.as_int() < rv.as_int())
        BinaryOp::Gt =>
            return Value::Bool(lv.as_int() > rv.as_int())
        BinaryOp::Le =>
            return Value::Bool(lv.as_int() <= rv.as_int())
        BinaryOp::Ge =>
            return Value::Bool(lv.as_int() >= rv.as_int())
        _ =>
            return Value::Int(0)

fn value_add(lv: Value, rv: Value) -> Value:
    match lv:
        Value::Int(a) =>
            match rv:
                Value::Int(b) =>
                    return Value::Int(a + b)
                Value::Float(b) =>
                    return Value::Float(a * 1.0 + b)
                _ =>
                    ()
        Value::Float(a) =>
            match rv:
                Value::Float(b) =>
                    return Value::Float(a + b)
                Value::Int(b) =>
                    return Value::Float(a + b * 1.0)
                _ =>
                    ()
        Value::String_(a) =>
            match rv:
                Value::String_(b) =>
                    return Value::String_(a + b)
                _ =>
                    return Value::String_(a + rv.to_repr())
        _ =>
            ()
    return Value::Int(0)

fn value_mul(lv: Value, rv: Value) -> Value:
    match lv:
        Value::Float(a) =>
            return Value::Float(a * rv.as_float())
        _ =>
            return Value::Int(lv.as_int() * rv.as_int())

fn value_div(lv: Value, rv: Value) -> Value:
    let d = rv.as_int()
    if d == 0:
        println("runtime error: division by zero")
        return Value::Int(0)
    match lv:
        Value::Float(a) =>
            return Value::Float(a / rv.as_float())
        _ =>
            return Value::Int(lv.as_int() / d)

fn eval_unary(ctx: RuntimeContext, op: UnaryOp, value: Expr) -> Value:
    let v = eval_expr(ctx, value)
    match op:
        UnaryOp::Not =>
            return Value::Bool(!v.is_truthy())
        UnaryOp::Negate =>
            match v:
                Value::Int(n) =>
                    return Value::Int(0 - n)
                Value::Float(f) =>
                    return Value::Float(0.0 - f)
                _ =>
                    return Value::Int(0)
        _ =>
            return v

# - Block and statement evaluation -

fn eval_block(ctx: RuntimeContext, block: Block) -> Signal:
    env_push_scope(ctx.env)
    let result = Signal::Normal
    let done = false
    let i = 0
    while i < len(block.statements) && !done:
        let sig = eval_stmt(ctx, block.statements[i])
        match sig:
            Signal::Normal =>
                ()
            _ =>
                result = sig
                done = true
        i = i + 1
    env_pop_scope(ctx.env)
    return result

fn eval_stmt(ctx: RuntimeContext, stmt: Stmt) -> Signal:
    match stmt:
        Stmt::Let(ls) =>
            return eval_let_stmt(ctx, ls)
        Stmt::Return(rs) =>
            return eval_return_stmt(ctx, rs)
        Stmt::Expr(es) =>
            eval_expr(ctx, es.expr)
            return Signal::Normal
        Stmt::Assign(as_) =>
            return eval_assign_stmt(ctx, as_)
        Stmt::If(ifs) =>
            return eval_if_stmt(ctx, ifs)
        Stmt::While(ws) =>
            return eval_while_stmt(ctx, ws)
        Stmt::For(fs) =>
            return eval_for_stmt(ctx, fs)
        Stmt::Match(ms) =>
            return eval_match_stmt(ctx, ms)
        Stmt::Break(bs) =>
            return eval_break_stmt(ctx, bs)
        Stmt::Continue(_) =>
            return Signal::Continue_
        _ =>
            return Signal::Normal

fn eval_let_stmt(ctx: RuntimeContext, ls: LetStmt) -> Signal:
    let val = Value::Unit
    match ls.value:
        Option::Some(v) =>
            val = eval_expr(ctx, v)
        _ =>
            ()
    match ls.pattern:
        Pattern::Binding(name) =>
            env_define(ctx.env, name, val, ls.is_mut)
        Pattern::BindingMut(name) =>
            env_define(ctx.env, name, val, true)
        _ =>
            ()
    return Signal::Normal

fn eval_return_stmt(ctx: RuntimeContext, rs: ReturnStmt) -> Signal:
    let v = Value::Unit
    match rs.value:
        Option::Some(val_expr) =>
            v = eval_expr(ctx, val_expr)
        _ =>
            ()
    return Signal::Return_(v)

fn eval_assign_stmt(ctx: RuntimeContext, as_: AssignStmt) -> Signal:
    return Signal::Normal

fn eval_if_stmt(ctx: RuntimeContext, ifs: IfStmt) -> Signal:
    let cond = eval_expr(ctx, ifs.condition)
    if cond.is_truthy():
        return eval_block(ctx, ifs.then_branch)
    return eval_if_else_signal(ctx, ifs.else_branch)

fn eval_if_else_signal(ctx: RuntimeContext, else_branch: Option<Block>) -> Signal:
    return Signal::Normal

fn eval_while_stmt(ctx: RuntimeContext, ws: WhileStmt) -> Signal:
    return Signal::Normal

fn eval_for_stmt(ctx: RuntimeContext, fs: ForStmt) -> Signal:
    return Signal::Normal

fn eval_match_stmt(ctx: RuntimeContext, ms: MatchStmt) -> Signal:
    return Signal::Normal

fn eval_break_stmt(ctx: RuntimeContext, bs: BreakStmt) -> Signal:
    return Signal::Normal

# - Function call -

fn call_user_fn(ctx: RuntimeContext, fndef: FnDef, call_args: Array<Value>) -> Value:
    env_push_scope(ctx.env)
    let pi = 0
    for param in fndef.params:
        if pi < len(call_args):
            env_define(ctx.env, param.name, call_args[pi], false)
        pi = pi + 1
    let block = Block { statements: fndef.body, span: fndef.span }
    let sig = eval_block(ctx, block)
    env_pop_scope(ctx.env)
    match sig:
        Signal::Return_(v) =>
            return v
        _ =>
            return Value::Unit

# - Program entry point -

pub fn run_program(program: Program) -> Result<Value, KainError>:
    let ctx = ctx_new()
    ctx_register_fns(ctx, program)

    for item in program.items:
        match item:
            TopLevelItem::Const(c) =>
                let v = eval_expr(ctx, c.value)
                env_define(ctx.env, c.name, v, false)
            _ =>
                ()

    let main_fn_opt = ctx_find_fn(ctx, "main")
    match main_fn_opt:
        Option::Some(f) =>
            let result = call_user_fn(ctx, f, [])
            return Result::Ok(result)
        _ =>
            let err_span = Span { start: 0, end: 0, file: "" }
            return Result::Err(KainError {
                kind: ErrorKind::Runtime,
                message: "no main() function found",
                span: err_span,
                filename: "",
                hint: none
            })
