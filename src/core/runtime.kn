use ast::Expr
use ast::Literal
use ast::Path
use ast::Program
use error::ErrorKind
use error::KainError
use span::Span

# Kain Runtime Seed

enum Value:
    Unit
    Bool(Bool)
    Int(Int)
    Float(Float)
    String(String)

struct Binding:
    name: String
    value: Value

struct Env:
    bindings: Array<Binding>

pub fn new_env() -> Env:
    return Env { bindings: [] }

pub fn env_insert(env: Env, name: String, value: Value) -> Env:
    push(env.bindings, Binding { name: name, value: value })
    return env

fn env_lookup(env: Env, name: String) -> Option<Value>:
    for binding in env.bindings:
        if binding.name == name:
            return Option::Some(binding.value)
    return none

fn runtime_error(message: String) -> KainError:
    return KainError {
        kind: ErrorKind::Runtime,
        message: message,
        span: Span { start: 0, end: 0, file: "" },
        filename: "",
        hint: none
    }

fn interpret_literal(literal: Literal) -> Result<Value, KainError>:
    match literal:
        Literal::Unit => return Result::Ok(Value::Unit)
        Literal::Bool(_) => return Result::Ok(Value::Bool(false))
        Literal::Int(_) => return Result::Ok(Value::Int(0))
        Literal::Float(_) => return Result::Ok(Value::Float(0.0))
        Literal::String(_) => return Result::Ok(Value::String(""))
        Literal::Char(_) => return Result::Ok(Value::String(""))

fn interpret_path(path: Path, env: Env) -> Result<Value, KainError>:
    let _unused_path = path
    let _unused_env = env
    return Result::Err(runtime_error(
        "path lookup is not implemented in the runtime seed yet"
    ))

pub fn interpret_program(program: Program) -> Result<Value, KainError>:
    let _unused_program = program
    return Result::Ok(Value::Unit)

pub fn interpret_expr(expr: Expr, env: Env) -> Result<Value, KainError>:
    let _unused_expr = expr
    let _unused_env = env
    return Result::Err(runtime_error(
        "kain runtime seed cannot interpret this expression form yet"
    ))
