@doc(doc = " Pre-computed component mirror structs.")
@doc(doc = " Compute once from a [`TypedProgram`] and reuse across the `_cached` generation")
@doc(doc = " functions to avoid redundant AST traversals when building all three shader")
@doc(doc = " artifacts (header, implementation, USF) for the same program.")
pub struct CachedMirrors:
    field_0: Map<String, pod_mirror::PodMirrorStruct>

impl CachedMirrors:
    pub fn from_program(program: &kain_core::types::TypedProgram) -> CachedMirrors:
        CachedMirrors(pod_mirror__collect_component_mirrors(program).unwrap_or_default())


@doc(doc = " Best-effort type mapping used when building broad program metadata (e.g. struct maps)")
@doc(doc = " that may include many non-shader types. Unlike `map_type_to_usf`, this never emits")
@doc(doc = " warnings for unknown types.")
fn try_map_type_to_usf_silent(ty: &kain_core::ast::Type) -> Option<String>:
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } =>
            let inner_hlsl = if (!generics.is_empty()):
                try_map_type_to_usf_silent(&generics[0])
            else:
                none
            match type_mapping__TYPE_MAPPER.map_to_hlsl(name.as_str()):
                Some(hlsl_type) => return Option::Some(hlsl_type)
                _ =>
                    ()
                    ()
            match name.as_str():
                "Image2D" => Option::Some(("RWTexture2D<float4>").to_string())
                "Image3D" => Option::Some(("RWTexture3D<float4>").to_string())
                "Buffer" => Option::Some("StructuredBuffer<{inner_hlsl.unwrap_or_else(fn(): (\"float4\").to_string())}>")
                "RWBuffer" => Option::Some("RWStructuredBuffer<{inner_hlsl.unwrap_or_else(fn(): (\"float4\").to_string())}>")
                "RWTexture2D" => Option::Some("RWTexture2D<{inner_hlsl.unwrap_or_else(fn(): (\"float4\").to_string())}>")
                "RWTexture3D" => Option::Some("RWTexture3D<{inner_hlsl.unwrap_or_else(fn(): (\"float4\").to_string())}>")
                "Texture2D" => Option::Some("Texture2D<{inner_hlsl.unwrap_or_else(fn(): (\"float4\").to_string())}>")
                "Texture3D" => Option::Some("Texture3D<{inner_hlsl.unwrap_or_else(fn(): (\"float4\").to_string())}>")
                "RWTexture2D_Float" => Option::Some(("RWTexture2D<float>").to_string())
                "RWTexture2D_Float2" => Option::Some(("RWTexture2D<float2>").to_string())
                "RWTexture2D_Float3" => Option::Some(("RWTexture2D<float3>").to_string())
                "RWTexture2D_Int" => Option::Some(("RWTexture2D<int>").to_string())
                "RWTexture2D_UInt" => Option::Some(("RWTexture2D<uint>").to_string())
                "StructuredBuffer" => Option::Some("StructuredBuffer<{inner_hlsl.unwrap_or_else(fn(): (\"float4\").to_string())}>")
                "RWStructuredBuffer" => Option::Some("RWStructuredBuffer<{inner_hlsl.unwrap_or_else(fn(): (\"float4\").to_string())}>")
                "f32" => Option::Some(("float").to_string())
                "f64" => Option::Some(("double").to_string())
                "i32" => Option::Some(("int").to_string())
                "u32" => Option::Some(("uint").to_string())
                _ => none
        _ => none

@doc(doc = " Generate C++ reflection header for UE5 shader parameter binding.")
@doc(doc = " Creates a .h file with SHADER_PARAMETER_STRUCT compatible bindings.")
pub fn generate_cpp_header(program: &kain_core::types::TypedProgram, shader_name: String) -> String:
    generate_cpp_header_cached(program, shader_name, "", &CachedMirrors__from_program(program))

fn generate_cpp_header_cached(program: &kain_core::types::TypedProgram, shader_name: String, plugin_name: String, mirrors: &CachedMirrors) -> String:
    let mut output = String__new_()
    output.push_str("// Generated by KAIN Compiler - UE5 Shader Parameter Reflection\n")
    ()
    output.push_str("// This file provides C++ bindings for shader parameters\n\n")
    ()
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"GlobalShader.h\"\n")
    ()
    output.push_str("#include \"ShaderParameters.h\"\n")
    ()
    output.push_str("#include \"ShaderParameterStruct.h\"\n")
    ()
    output.push_str("#include \"ShaderParameterUtils.h\"\n")
    ()
    output.push_str("#include \"RenderGraphResources.h\"\n")
    ()
    output.push_str("#include \"RenderGraphBuilder.h\"\n")
    ()
    output.push_str("#include \"RenderGraphUtils.h\"\n")
    ()
    output.push_str("#include \"ShaderCompilerCore.h\"\n")
    ()
    output.push_str("#include \"RHIStaticStates.h\"\n\n")
    ()
    let (is_compute, is_vertex) = (*program).items.iter().find_map(fn(item): none).unwrap_or((false, false))
    let mut all_scalar_params: Array<(String, String, u32)> = Vec__new_()
    let mut all_texture_inputs: Array<(String, String, u32)> = Vec__new_()
    let mut all_uav_outputs: Array<(String, String, u32)> = Vec__new_()
    let mut permissions: Array<String> = Vec__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Shader(shader_) =>
                let normalized_ast_name = shader_.ast.name.replace("_", "")
                let normalized_shader_name = shader_name.replace("_", "")
                if (!normalized_ast_name.eq_ignore_ascii_case(&normalized_shader_name)):
                    continue
                for uniform_ in &shader_.ast.uniforms:
                    if is_permutation_param(&uniform_.name):
                        if (!permissions.contains(&uniform_.name)):
                            permissions.push(uniform_.name.clone())
                            ()
                            ()
                            ()
                            ()
                        continue
                    let usf_type = map_type_to_usf(&uniform_.ty)
                    let entry = (uniform_.name.clone(), usf_type.clone(), uniform_.binding)
                    if ((usf_type.starts_with("RWTexture") || usf_type.starts_with("RWBuffer")) || usf_type.starts_with("RWStructuredBuffer")):
                        all_uav_outputs.push(entry)
                        ()
                    elif (usf_type.contains("Texture") || usf_type.starts_with("StructuredBuffer")):
                        all_texture_inputs.push(entry)
                        ()
                    else:
                        all_scalar_params.push(entry)
                        ()
                ()
                if (is_compute && all_uav_outputs.is_empty()):
                    let is_3d = is_3d_compute_shader(shader_)
                    let uav_ty = if is_3d:
                        "RWTexture3D<float4>"
                    else:
                        "RWTexture2D<float4>"
                    all_uav_outputs.push((("OutputTexture").to_string(), uav_ty.to_string(), 0))
                    ()
                    ()
                    ()
                    ()
                break
            _ => ()
    ()
    let type_db = build_struct_map(program)
    let component_mirrors = &(*mirrors).field_0
    let mut used_mirror_names: Array<String> = Vec__new_()
    for selfhost_for_item in &all_scalar_params:
        let (_, usf_type, _) = selfhost_for_item
        if (component_mirrors.contains_key(usf_type.as_str()) && (!used_mirror_names.contains(usf_type))):
            used_mirror_names.push(usf_type.clone())
            ()
    ()
    if (!used_mirror_names.is_empty()):
        let types_header = if (!plugin_name.is_empty()):
            f"{plugin_name}ShaderTypes.h"
        else:
            ("ShaderTypes.h").to_string()
        output.push_str(&f"#include \"{types_header}\"\n\n")
        ()
        ()
        ()
        ()
    let mut custom_shader_struct_defs: Map<String, Array<(String, String)>> = BTreeMap__new_()
    for selfhost_for_item in &all_scalar_params:
        let (_, ty, _) = selfhost_for_item
        if component_mirrors.contains_key(ty.as_str()):
            continue
        let cpp_type = map_usf_type_to_cpp(ty)
        if (!is_shader_params_cpp_struct_name(&cpp_type)):
            continue
        if custom_shader_struct_defs.contains_key(&cpp_type):
            continue
        let base_name = cpp_type.strip_prefix("F").unwrap_or(&cpp_type)
        match type_db.get(base_name).or_else(fn(): type_db.get(&cpp_type)):
            Some(fields) =>
                let mut ordered_fields: Array<(String, String)> = fields.iter().map(fn(__kain_closure_arg0): (__kain_closure_arg0.__kain_tuple_0.clone(), __kain_closure_arg0.__kain_tuple_1.clone())).collect()
                ordered_fields.sort_by(fn(a, b): a.field_0.cmp(&b.field_0))
                ()
                custom_shader_struct_defs.insert(cpp_type, ordered_fields)
                ()
            _ => ()
    ()
    for selfhost_for_item in &custom_shader_struct_defs:
        let (struct_name, fields) = selfhost_for_item
        output.push_str(&f"BEGIN_SHADER_PARAMETER_STRUCT({struct_name}, )\n")
        ()
        for selfhost_for_item in fields:
            let (field_name, field_ty) = selfhost_for_item
            let field_cpp_type = map_usf_type_to_cpp(field_ty)
            if is_shader_params_cpp_struct_name(&field_cpp_type):
                output.push_str(&f"    SHADER_PARAMETER_STRUCT({field_cpp_type}, {field_name})\n")
                ()
            else:
                output.push_str(&f"    SHADER_PARAMETER({field_cpp_type}, {field_name})\n")
                ()
        ()
        output.push_str("END_SHADER_PARAMETER_STRUCT()\n\n")
        ()
    ()
    let class_name = if is_vertex:
        f"F{capitalize_first(shader_name)}VS"
    else:
        f"F{capitalize_first(shader_name)}Shader"
    output.push_str(&"class {class_name} : public FGlobalShader\n{\n")
    ()
    output.push_str(&f"    DECLARE_GLOBAL_SHADER({class_name});\n")
    ()
    output.push_str(&f"    SHADER_USE_PARAMETER_STRUCT({class_name}, FGlobalShader);\n\n")
    ()
    if (!permissions.is_empty()):
        output.push_str("    // Permutation Domain\n")
        ()
        for perm in &permissions:
            output.push_str(&f"    class {perm} : SHADER_PERMUTATION_BOOL(\"{perm}\");\n")
            ()
        ()
        output.push_str("    using FPermutationDomain = TShaderPermutationDomain<")
        ()
        for selfhost_for_item in permissions.iter().enumerate():
            let (i, perm) = selfhost_for_item
            if (i > 0):
                output.push_str(", ")
                ()
                ()
                ()
                ()
            output.push_str(perm)
            ()
        ()
        output.push_str(">;\n\n")
        ()
        ()
        ()
        ()
    output.push_str("    BEGIN_SHADER_PARAMETER_STRUCT(FParameters, )\n")
    ()
    for selfhost_for_item in &all_scalar_params:
        let (name, ty, _) = selfhost_for_item
        if is_permutation_param(name):
            continue
        match component_mirrors.get(ty.as_str()):
            Some(mirror) =>
                output.push_str(&f"        SHADER_PARAMETER_STRUCT({mirror.pod_struct_name}, {name})\n")
                ()
            _ =>
                let cpp_type = map_usf_type_to_cpp(ty)
                if is_shader_params_cpp_struct_name(&cpp_type):
                    output.push_str(&f"        SHADER_PARAMETER_STRUCT({cpp_type}, {name})\n")
                    ()
                else:
                    output.push_str(&f"        SHADER_PARAMETER({cpp_type}, {name})\n")
                    ()
    ()
    for selfhost_for_item in &all_texture_inputs:
        let (name, ty, _) = selfhost_for_item
        if ty.starts_with("StructuredBuffer"):
            output.push_str(&f"        SHADER_PARAMETER_SRV(FRHIShaderResourceView*, {name})\n")
            ()
        else:
            let texture_type = if ty.contains("Texture2D"):
                "Texture2D"
            elif ty.contains("Texture3D"):
                "Texture3D"
            elif ty.contains("TextureCube"):
                "TextureCube"
            else:
                "Texture2D"
            output.push_str(&f"        SHADER_PARAMETER_RDG_TEXTURE({texture_type}, {name})\n")
            ()
            output.push_str(&f"        SHADER_PARAMETER_SAMPLER(SamplerState, {name}Sampler)\n")
            ()
    ()
    for selfhost_for_item in &all_uav_outputs:
        let (name, ty, _) = selfhost_for_item
        let uav_type = if ty.contains("RWTexture2D"):
            "RWTexture2D<float4>"
        elif ty.contains("RWTexture3D"):
            "RWTexture3D<float4>"
        elif ty.contains("RWStructuredBuffer"):
            "RWStructuredBuffer<float4>"
        else:
            "RWTexture2D<float4>"
        output.push_str(&f"        SHADER_PARAMETER_RDG_TEXTURE_UAV({uav_type}, {name})\n")
        ()
    ()
    output.push_str("    END_SHADER_PARAMETER_STRUCT()\n\n")
    ()
    if is_compute:
        output.push_str("    // Automatically generates RDG compute pass\n")
        ()
        output.push_str("    static void Exec(FRDGBuilder& GraphBuilder, const FParameters& Parameters, FIntVector GroupCount")
        ()
        ()
        ()
        ()
    elif is_vertex:
        output.push_str("    // Vertex shader: bind with a mesh draw call (NOT AddFullscreenPass)\n")
        ()
        output.push_str("    static void Exec(FRDGBuilder& GraphBuilder, const FParameters& Parameters")
        ()
        ()
        ()
        ()
    else:
        output.push_str("    // Automatically generates RDG pixel shader pass\n")
        ()
        output.push_str("    static void Exec(FRDGBuilder& GraphBuilder, const FParameters& Parameters")
        ()
        ()
        ()
        ()
    for perm in &permissions:
        output.push_str(&f", bool b{perm}")
        ()
    ()
    output.push_str(")\n    {\n")
    ()
    if (!permissions.is_empty()):
        output.push_str("        FPermutationDomain PermutationVector;\n")
        ()
        for perm in &permissions:
            output.push_str(&f"        PermutationVector.Set<{perm}>(b{perm});\n")
            ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    if is_compute:
        if permissions.is_empty():
            output.push_str(&f"        TShaderMapRef<{class_name}> ComputeShader(GetGlobalShaderMap(GMaxRHIFeatureLevel));\n\n")
            ()
            ()
            ()
            ()
        else:
            output.push_str(&f"        TShaderMapRef<{class_name}> ComputeShader(GetGlobalShaderMap(GMaxRHIFeatureLevel), PermutationVector);\n\n")
            ()
            ()
            ()
            ()
        ()
    elif is_vertex:
        if permissions.is_empty():
            output.push_str(&f"        TShaderMapRef<{class_name}> VertexShader(GetGlobalShaderMap(GMaxRHIFeatureLevel));\n\n")
            ()
            ()
            ()
            ()
        else:
            output.push_str(&f"        TShaderMapRef<{class_name}> VertexShader(GetGlobalShaderMap(GMaxRHIFeatureLevel), PermutationVector);\n\n")
            ()
            ()
            ()
            ()
        ()
    else:
        if permissions.is_empty():
            output.push_str(&f"        TShaderMapRef<{class_name}> PixelShader(GetGlobalShaderMap(GMaxRHIFeatureLevel));\n\n")
            ()
            ()
            ()
            ()
        else:
            output.push_str(&f"        TShaderMapRef<{class_name}> PixelShader(GetGlobalShaderMap(GMaxRHIFeatureLevel), PermutationVector);\n\n")
            ()
            ()
            ()
            ()
        ()
    output.push_str("        FParameters* PassParameters = GraphBuilder.AllocParameters<FParameters>();\n")
    ()
    output.push_str("        *PassParameters = Parameters;\n\n")
    ()
    if is_compute:
        output.push_str(&"        FComputeShaderUtils::AddPass(\n")
        ()
        output.push_str(&"            GraphBuilder,\n")
        ()
        output.push_str(&f"            RDG_EVENT_NAME(\"{shader_name} Dispatch\"),\n")
        ()
        output.push_str("            ComputeShader,\n")
        ()
        output.push_str("            PassParameters,\n")
        ()
        output.push_str("            GroupCount\n")
        ()
        output.push_str("        );\n")
        ()
        ()
        ()
        ()
    elif is_vertex:
        output.push_str("        // Vertex shaders require geometry submission via FMeshPassProcessor\n")
        ()
        output.push_str("        // or a custom FRenderPass — AddFullscreenPass is not valid here.\n")
        ()
        output.push_str(&f"        // Bind VertexShader in your draw call setup for {shader_name}.\n")
        ()
        ()
        ()
        ()
    else:
        output.push_str("        // For pixel shaders, you'll need to set up a full-screen quad or custom geometry\n")
        ()
        output.push_str("        // This is a simplified example - adapt to your rendering pipeline\n")
        ()
        output.push_str(&"        // Use AddDrawPass or integrate with your post-process pipeline\n")
        ()
        ()
        ()
        ()
    output.push_str("    }\n")
    ()
    output.push_str("};\n\n")
    ()
    let effective_plugin = if plugin_name.is_empty():
        "YourPlugin"
    else:
        plugin_name
    output.push_str(&"// In your .cpp file, add:\n")
    ()
    if is_compute:
        output.push_str(&f"// IMPLEMENT_GLOBAL_SHADER({class_name}, \"/Plugin/{effective_plugin}/{shader_name}.usf\", \"{capitalize_first(shader_name)}CS\", SF_Compute);\n")
        ()
        ()
        ()
        ()
    elif is_vertex:
        output.push_str(&f"// IMPLEMENT_GLOBAL_SHADER({class_name}, \"/Plugin/{effective_plugin}/{shader_name}.usf\", \"{capitalize_first(shader_name)}VS\", SF_Vertex);\n")
        ()
        ()
        ()
        ()
    else:
        output.push_str(&f"// IMPLEMENT_GLOBAL_SHADER({class_name}, \"/Plugin/{effective_plugin}/{shader_name}.usf\", \"{capitalize_first(shader_name)}PS\", SF_Pixel);\n")
        ()
        ()
        ()
        ()
    output.push_str(&"\n// Helper function to add pass to render graph\n")
    ()
    output.push_str(&f"void AddPass_{capitalize_first(shader_name)}(\n")
    ()
    output.push_str("    FRDGBuilder& GraphBuilder")
    ()
    let mut args = Vec__new_()
    for selfhost_for_item in &all_scalar_params:
        let (name, ty, _) = selfhost_for_item
        let cpp_type = match component_mirrors.get(ty.as_str()):
            Some(mirror) => mirror.pod_struct_name.clone()
            _ => map_usf_type_to_cpp(ty)
        args.push(f"    {cpp_type} {name}")
        ()
    ()
    for selfhost_for_item in &all_texture_inputs:
        let (name, ty, _) = selfhost_for_item
        if ty.starts_with("StructuredBuffer"):
            args.push(f"    FRHIShaderResourceView* {name}")
            ()
        else:
            args.push(f"    FRDGTextureRef {name}")
            ()
    ()
    for selfhost_for_item in &all_uav_outputs:
        let (name, _, _) = selfhost_for_item
        args.push(f"    FRDGTextureRef {name}")
        ()
    ()
    if is_compute:
        args.push(("    FIntVector GroupCount = FIntVector(32, 32, 1)").to_string())
        ()
        ()
        ()
        ()
    for perm in &permissions:
        args.push(f"    bool b{perm} = false")
        ()
    ()
    if (!args.is_empty()):
        output.push_str(",\n")
        ()
        output.push_str(&args.join(",\n"))
        ()
        ()
        ()
        ()
    output.push_str("\n);\n")
    ()
    output

@doc(doc = " Generate C++ implementation file for shader registration and dispatch.")
@doc(doc = " Creates a .cpp file with IMPLEMENT_GLOBAL_SHADER and helper functions.")
pub fn generate_cpp_implementation(program: &kain_core::types::TypedProgram, shader_name: String, plugin_name: String) -> String:
    generate_cpp_implementation_cached(program, shader_name, plugin_name, &CachedMirrors__from_program(program))

fn generate_cpp_implementation_cached(program: &kain_core::types::TypedProgram, shader_name: String, plugin_name: String, mirrors: &CachedMirrors) -> String:
    let mut output = String__new_()
    output.push_str("// Generated by KAIN Compiler - UE5 Shader Implementation\n")
    ()
    output.push_str("// Shader registration and dispatch helpers\n\n")
    ()
    output.push_str(&f"#include \"{shader_name}.h\"\n")
    ()
    output.push_str("#include \"RenderGraphBuilder.h\"\n")
    ()
    output.push_str("#include \"RenderGraphUtils.h\"\n")
    ()
    output.push_str("#include \"ShaderParameterUtils.h\"\n")
    ()
    output.push_str("#include \"GlobalShader.h\"\n")
    ()
    output.push_str("\n")
    ()
    let (is_compute, is_vertex) = (*program).items.iter().find_map(fn(item): none).unwrap_or((false, false))
    let class_name = if is_vertex:
        f"F{capitalize_first(shader_name)}VS"
    else:
        f"F{capitalize_first(shader_name)}Shader"
    output.push_str(&"// Register shader with UE5\n")
    ()
    if is_compute:
        output.push_str(&f"IMPLEMENT_GLOBAL_SHADER({class_name}, \"/Plugin/{plugin_name}/{shader_name}.usf\", \"{capitalize_first(shader_name)}CS\", SF_Compute);\n\n")
        ()
        ()
        ()
        ()
    elif is_vertex:
        output.push_str(&f"IMPLEMENT_GLOBAL_SHADER({class_name}, \"/Plugin/{plugin_name}/{shader_name}.usf\", \"{capitalize_first(shader_name)}VS\", SF_Vertex);\n\n")
        ()
        ()
        ()
        ()
    else:
        output.push_str(&f"IMPLEMENT_GLOBAL_SHADER({class_name}, \"/Plugin/{plugin_name}/{shader_name}.usf\", \"{capitalize_first(shader_name)}PS\", SF_Pixel);\n\n")
        ()
        ()
        ()
        ()
    let mut all_scalar_params: Array<(String, String, u32)> = Vec__new_()
    let mut all_texture_inputs: Array<(String, String, u32)> = Vec__new_()
    let mut all_uav_outputs: Array<(String, String, u32)> = Vec__new_()
    let mut permutations: Array<String> = Vec__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Shader(shader_) =>
                let normalized_ast_name = shader_.ast.name.replace("_", "")
                let normalized_shader_name = shader_name.replace("_", "")
                if (!normalized_ast_name.eq_ignore_ascii_case(&normalized_shader_name)):
                    continue
                for uniform_ in &shader_.ast.uniforms:
                    if is_permutation_param(&uniform_.name):
                        permutations.push(uniform_.name.clone())
                        ()
                        continue
                    let usf_type = map_type_to_usf(&uniform_.ty)
                    let entry = (uniform_.name.clone(), usf_type.clone(), uniform_.binding)
                    if ((usf_type.starts_with("RWTexture") || usf_type.starts_with("RWBuffer")) || usf_type.starts_with("RWStructuredBuffer")):
                        all_uav_outputs.push(entry)
                        ()
                    elif ((usf_type.contains("Texture") || usf_type.contains("Sampler")) || usf_type.starts_with("StructuredBuffer")):
                        all_texture_inputs.push(entry)
                        ()
                    else:
                        all_scalar_params.push(entry)
                        ()
                ()
                if (is_compute && all_uav_outputs.is_empty()):
                    let is_3d = is_3d_compute_shader(shader_)
                    let uav_ty = if is_3d:
                        "RWTexture3D<float4>"
                    else:
                        "RWTexture2D<float4>"
                    all_uav_outputs.push((("OutputTexture").to_string(), uav_ty.to_string(), 0))
                    ()
                    ()
                    ()
                    ()
                break
            _ => ()
    ()
    let component_mirrors_impl = &(*mirrors).field_0
    output.push_str(&"// Helper function to add pass to render graph\n")
    ()
    output.push_str(&f"void AddPass_{capitalize_first(shader_name)}(\n")
    ()
    output.push_str("    FRDGBuilder& GraphBuilder")
    ()
    let mut args = Vec__new_()
    for selfhost_for_item in &all_scalar_params:
        let (name, ty, _) = selfhost_for_item
        let cpp_type = match component_mirrors_impl.get(ty.as_str()):
            Some(mirror) => mirror.pod_struct_name.clone()
            _ => map_usf_type_to_cpp(ty)
        args.push(f"    {cpp_type} {name}")
        ()
    ()
    for selfhost_for_item in &all_texture_inputs:
        let (name, ty, _) = selfhost_for_item
        if ty.starts_with("StructuredBuffer"):
            args.push(f"    FRHIShaderResourceView* {name}")
            ()
        else:
            args.push(f"    FRDGTextureRef {name}")
            ()
    ()
    for selfhost_for_item in &all_uav_outputs:
        let (name, _, _) = selfhost_for_item
        args.push(f"    FRDGTextureRef {name}")
        ()
    ()
    if is_compute:
        args.push(("    FIntVector GroupCount").to_string())
        ()
        ()
        ()
        ()
    for perm in &permutations:
        args.push(f"    bool b{perm}")
        ()
    ()
    if (!args.is_empty()):
        output.push_str(",\n")
        ()
        output.push_str(&args.join(",\n"))
        ()
        ()
        ()
        ()
    output.push_str("\n)\n{\n")
    ()
    output.push_str(&f"    {class_name}::FParameters* Params = GraphBuilder.AllocParameters<{class_name}::FParameters>();\n")
    ()
    if (!all_scalar_params.is_empty()):
        output.push_str("    // Bind Scalars\n")
        ()
        for selfhost_for_item in &all_scalar_params:
            let (name, _, _) = selfhost_for_item
            output.push_str(&f"    Params->{name} = {name};\n")
            ()
        ()
        ()
    if (!all_texture_inputs.is_empty()):
        output.push_str("    // Bind Textures / SRVs\n")
        ()
        for selfhost_for_item in &all_texture_inputs:
            let (name, ty, _) = selfhost_for_item
            output.push_str(&f"    Params->{name} = {name};\n")
            ()
            if (!ty.starts_with("StructuredBuffer")):
                output.push_str(&f"    Params->{name}Sampler = TStaticSamplerState<SF_Bilinear, AM_Clamp, AM_Clamp, AM_Clamp>::GetRHI();\n")
                ()
        ()
        ()
    if (!all_uav_outputs.is_empty()):
        output.push_str("    // Bind UAVs\n")
        ()
        for selfhost_for_item in &all_uav_outputs:
            let (name, ty_2, _) = selfhost_for_item
            output.push_str(&f"    Params->{name} = GraphBuilder.CreateUAV({name});\n")
            ()
        ()
        ()
    output.push_str("\n")
    ()
    let perm_args: String = permutations.iter().map(fn(p): f", b{p}").collect()
    if is_compute:
        output.push_str(&f"    {class_name}::Exec(GraphBuilder, *Params, GroupCount{perm_args});\n")
        ()
        ()
        ()
        ()
    else:
        output.push_str(&f"    {class_name}::Exec(GraphBuilder, *Params{perm_args});\n")
        ()
        ()
        ()
        ()
    output.push_str("}\n")
    ()
    output

@doc(doc = " Map USF/HLSL types to UE5 C++ types")
fn map_usf_type_to_cpp(usf_type: String) -> String:
    match usf_type:
        "float" => ("float").to_string()
        "float2" => ("FVector2f").to_string()
        "float3" => ("FVector3f").to_string()
        "float4" => ("FVector4f").to_string()
        "int" => ("int32").to_string()
        "int2" => ("FIntPoint").to_string()
        "int3" => ("FIntVector").to_string()
        "int4" => ("FIntVector4").to_string()
        "uint" => ("uint32").to_string()
        "uint2" => ("FUintVector2").to_string()
        "uint3" => ("FUintVector").to_string()
        "uint4" => ("FUintVector4").to_string()
        "float4x4" => ("FMatrix44f").to_string()
        "float3x3" => ("FMatrix33f").to_string()
        _ => normalize_shader_params_struct_name(usf_type)

fn is_shader_params_cpp_struct_name(type_name: String) -> Bool:
    (type_name.starts_with("F") && type_name.ends_with("ShaderParams"))

fn normalize_shader_params_struct_name(type_name: String) -> String:
    if (type_name.ends_with("ShaderParams") && (!type_name.starts_with("F"))):
        f"F{type_name}"
    else:
        type_name.to_string()

@doc(doc = " Generate USF code from typed KAIN program.")
@doc(doc = " Uses two-pass generation: first collect all uniforms, then emit code.")
pub fn generate(program: &kain_core::types::TypedProgram) -> Result<String, KainError>:
    generate_cached(program, &CachedMirrors__from_program(program))

fn generate_cached(program: &kain_core::types::TypedProgram, mirrors: &CachedMirrors) -> Result<String, KainError>:
    let mut output = String__new_()
    let type_db = build_struct_map(program)
    let mut all_texture_inputs: Array<(String, String, u32)> = Vec__new_()
    let mut all_uav_outputs: Array<(String, String, u32)> = Vec__new_()
    let mut all_scalar_params: Array<(String, String, u32)> = Vec__new_()
    let has_compute = (*program).items.iter().any(fn(item): none)
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Shader(shader_) =>
                for uniform_ in &shader_.ast.uniforms:
                    if is_permutation_param(&uniform_.name):
                        continue
                    let usf_type = map_type_to_usf(&uniform_.ty)
                    let entry = (uniform_.name.clone(), usf_type.clone(), uniform_.binding)
                    if ((usf_type.starts_with("RWTexture") || usf_type.starts_with("RWBuffer")) || usf_type.starts_with("RWStructuredBuffer")):
                        if (!all_uav_outputs.iter().any(fn(__kain_closure_arg1): (__kain_closure_arg1.__kain_tuple_0 == &uniform_.name))):
                            all_uav_outputs.push(entry)
                            ()
                    elif usf_type.contains("Texture"):
                        if (!all_texture_inputs.iter().any(fn(__kain_closure_arg2): (__kain_closure_arg2.__kain_tuple_0 == &uniform_.name))):
                            all_texture_inputs.push(entry)
                            ()
                    else:
                        if (!all_scalar_params.iter().any(fn(__kain_closure_arg3): (__kain_closure_arg3.__kain_tuple_0 == &uniform_.name))):
                            all_scalar_params.push(entry)
                            ()
            _ => ()
    ()
    if (has_compute && all_uav_outputs.is_empty()):
        let is_3d = (*program).items.iter().find_map(fn(item): none).unwrap_or(false)
        if is_3d:
            all_uav_outputs.push((("OutputTexture").to_string(), ("RWTexture3D<float4>").to_string(), 0))
            ()
            ()
            ()
            ()
        else:
            all_uav_outputs.push((("OutputTexture").to_string(), ("RWTexture2D<float4>").to_string(), 0))
            ()
            ()
            ()
            ()
        ()
    output.push_str("// Generated by KAIN Compiler - Unreal Shader Format\n")
    ()
    output.push_str("// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings\n\n")
    ()
    output.push_str("#include \"/Engine/Public/Platform.ush\"\n\n")
    ()
    let usf_mirrors = &(*mirrors).field_0
    let mut emitted_structs: Set<String> = HashSet__new_()
    for selfhost_for_item in &all_scalar_params:
        let (_, usf_type, _) = selfhost_for_item
        match usf_mirrors.get(usf_type.as_str()):
            Some(mirror) =>
                if emitted_structs.insert(mirror.pod_struct_name.clone()):
                    output.push_str(&mirror.generate_hlsl_struct())
                    ()
            _ => ()
    ()
    let mut emitted_custom_structs: Set<String> = HashSet__new_()
    for selfhost_for_item in &all_scalar_params:
        let (_, usf_type, _) = selfhost_for_item
        if usf_mirrors.contains_key(usf_type.as_str()):
            continue
        let hlsl_struct_name = normalize_shader_params_struct_name(usf_type)
        if (!is_shader_params_cpp_struct_name(&hlsl_struct_name)):
            continue
        if (!emitted_custom_structs.insert(hlsl_struct_name.clone())):
            continue
        let base_name = hlsl_struct_name.strip_prefix("F").unwrap_or(&hlsl_struct_name)
        let fields_opt = type_db.get(base_name).or_else(fn(): type_db.get(&hlsl_struct_name))
        match fields_opt:
            Some(fields) =>
                output.push_str(&"struct {hlsl_struct_name} {\n")
                ()
                let mut ordered_fields: Array<(String, String)> = fields.iter().collect()
                ordered_fields.sort_by(fn(a, b): a.field_0.cmp(b.field_0))
                ()
                for selfhost_for_item in ordered_fields:
                    let (field_name, field_ty) = selfhost_for_item
                    let mapped_field_ty = normalize_shader_params_struct_name(field_ty)
                    output.push_str(&f"    {mapped_field_ty} {field_name};\n")
                    ()
                ()
                output.push_str("};\n\n")
                ()
            _ => ()
    ()
    ()
    if (!all_scalar_params.is_empty()):
        output.push_str("// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT\n")
        ()
        output.push_str("// @N is ordering index, not register binding\n")
        ()
        let mut sorted_scalar_params = all_scalar_params.clone()
        sorted_scalar_params.sort_by_key(fn(__kain_closure_arg4): (*__kain_closure_arg4.__kain_tuple_2))
        ()
        for selfhost_for_item in &sorted_scalar_params:
            let (name, ty, binding) = selfhost_for_item
            let hlsl_type = match usf_mirrors.get(ty.as_str()):
                Some(mirror) => mirror.pod_struct_name.clone()
                _ => normalize_shader_params_struct_name(ty)
            output.push_str(&f"{hlsl_type} {name};  // @{binding}\n")
            ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    if (!all_texture_inputs.is_empty()):
        output.push_str("// Texture Inputs\n")
        ()
        for selfhost_for_item in &all_texture_inputs:
            let (name, ty, binding) = selfhost_for_item
            output.push_str(&f"{ty} {name} : register(t{binding});  // @{binding} -> t{binding} register\n")
            ()
            if (!ty.starts_with("StructuredBuffer")):
                output.push_str(&f"SamplerState {name}Sampler : register(s{binding});\n")
                ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    if (!all_uav_outputs.is_empty()):
        output.push_str("// UAV Outputs\n")
        ()
        for selfhost_for_item in &all_uav_outputs:
            let (name, ty, binding) = selfhost_for_item
            output.push_str(&f"{ty} {name} : register(u{binding});  // @{binding} -> u{binding} register\n")
            ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Shader(shader_) =>
                output.push_str(&emit_shader_body(shader_, mirrors, type_db.clone())?)
                ()
            _ => ()
    ()
    Result::Ok(output)

struct USFContext:
    vars: Map<String, (String, String)>
    indent_level: usize
    uniform_bindings: Array<(String, String, u32)>
    packer: Option<InterpolatorPacker>
    is_vertex_shader: Bool
    is_compute_shader: Bool
    is_compute_3d: Bool
    struct_map: Map<String, Map<String, String>>
    shader_knowledge: Option<ShaderKnowledge>
    array_decls: Array<String>
    temp_id_counter: usize

@doc(doc = " Tracks interpolator packing allocations for optimal GPU bandwidth usage")
@derive(Debug, Clone)
struct InterpolatorPacker:
    allocations: Map<String, (usize, String)>
    registers: Array<PackedRegister>

@derive(Debug, Clone)
struct PackedRegister:
    index: usize
    components_used: usize
    variables: Array<PackedVar>

@derive(Debug, Clone)
struct PackedVar:
    name: String
    ty: String
    swizzle: String

impl USFContext:
    fn new_() -> USFContext:
        USFContext { vars: HashMap__new_(), indent_level: 0, uniform_bindings: Vec__new_(), packer: none, is_vertex_shader: false, is_compute_shader: false, is_compute_3d: false, struct_map: HashMap__new_(), shader_knowledge: none, array_decls: Vec__new_(), temp_id_counter: 0 }

    fn with_knowledge(_self: USFContext, sk: ShaderKnowledge) -> USFContext:
        _self.shader_knowledge = Option::Some(sk)
        ()
        _self

    fn indent(_self: &USFContext) -> String:
        ("    ").repeat((*_self).indent_level)

    fn push_indent(_self: &mut USFContext):
        (*_self).indent_level = ((*_self).indent_level + 1)
        ()

    fn pop_indent(_self: &mut USFContext):
        if ((*_self).indent_level > 0):
            (*_self).indent_level = ((*_self).indent_level - 1)
            ()

    fn next_temp_id(_self: &mut USFContext) -> usize:
        let id = (*_self).temp_id_counter
        (*_self).temp_id_counter = ((*_self).temp_id_counter + 1)
        ()
        id

    fn validate_cast(_self: &USFContext, source_expr: &kain_core::ast::Expr, target_type: &kain_core::ast::Type) -> Result<(), KainError>:
        let source_type = infer_expr_type(*_self, source_expr)?
        let target_type_name = match target_type:
            kain_core__ast__Type::Named { name: name } => name.as_str()
            _ => return Result::Err(KainError__codegen("Cast target must be a named type", source_expr.span()))
        let scalar_types = ["Int", "UInt", "Float", "Bool"]
        let vec2_types = ["Vec2", "IVec2", "UVec2"]
        let vec3_types = ["Vec3", "IVec3", "UVec3"]
        let vec4_types = ["Vec4", "IVec4", "UVec4"]
        let is_valid = (((((scalar_types.contains(&source_type.as_str()) && scalar_types.contains(&target_type_name))) || ((vec2_types.contains(&source_type.as_str()) && vec2_types.contains(&target_type_name)))) || ((vec3_types.contains(&source_type.as_str()) && vec3_types.contains(&target_type_name)))) || ((vec4_types.contains(&source_type.as_str()) && vec4_types.contains(&target_type_name))))
        if (!is_valid):
            let suggestion = match (source_type.as_str(), target_type_name):
                (s, t) if (scalar_types.contains(&s) && (((vec2_types.contains(&t) || vec3_types.contains(&t)) || vec4_types.contains(&t)))) => f"Use constructor syntax: {t}({s}, {s}, ...) to build vector from scalars"
                (s, t) if ((((vec2_types.contains(&s) || vec3_types.contains(&s)) || vec4_types.contains(&s))) && (((vec2_types.contains(&t) || vec3_types.contains(&t)) || vec4_types.contains(&t)))) => f"Use swizzling: my_vec.xy or my_vec.xyz, or constructor: {t}(my_vec.x, my_vec.y, ...)"
                (s, t) if ((((vec2_types.contains(&s) || vec3_types.contains(&s)) || vec4_types.contains(&s))) && scalar_types.contains(&t)) => ("Use component access: my_vec.x or my_vec.y").to_string()
                _ => ("Check HLSL type compatibility rules").to_string()
            return Result::Err(KainError__codegen(&f"Invalid cast from '{source_type}' to '{target_type_name}' in shader.\n\nCast Rules:\n  • Casts must be within same dimension category\n  • Scalars: Int, UInt, Float, Bool (can cast between these)\n  • 2D vectors: Vec2, IVec2, UVec2 (can cast between these)\n  • 3D vectors: Vec3, IVec3, UVec3 (can cast between these)\n  • 4D vectors: Vec4, IVec4, UVec4 (can cast between these)\n\nWhat you tried: {source_type} as {target_type_name}\nProblem: Dimension mismatch - cannot cast between different dimensions\n\nHow to fix: {suggestion}\n\nValid cast examples:\n  • let x: Float = 3.14\n    let y = x as Int              # OK: scalar to scalar\n  \n  • let v: Vec3 = vec3(1.0, 2.0, 3.0)\n    let u = v as IVec3            # OK: Vec3 to IVec3 (same dimension)\n  \n  • let v2: Vec2 = vec2(1.0, 2.0)\n    let v3 = Vec3(v2.x, v2.y, 0.0) # OK: use constructor for dimension change\n    # NOT: let v3 = v2 as Vec3    # ERROR: dimension mismatch\n\nDocumentation: https://kain.dev/docs/shaders/types", source_expr.span()))
        Result::Ok(())


impl InterpolatorPacker:
    fn new_() -> InterpolatorPacker:
        InterpolatorPacker { allocations: HashMap__new_(), registers: Vec__new_() }

    fn allocate(_self: &mut InterpolatorPacker, name: String, ty: String) -> (usize, String):
        let components_needed = type_component_count(&ty)
        for reg in &mut (*_self).registers:
            if ((reg.components_used + components_needed) <= 4):
                let swizzle = generate_swizzle(reg.components_used, components_needed)
                reg.variables.push(PackedVar { name: name.clone(), ty: ty.clone(), swizzle: swizzle.clone() })
                ()
                reg.components_used = (reg.components_used + components_needed)
                ()
                (*_self).allocations.insert(name, (reg.index, swizzle.clone()))
                ()
                return (reg.index, swizzle)
        ()
        let new_index = (*_self).registers.len()
        let swizzle = generate_swizzle(0, components_needed)
        (*_self).registers.push(PackedRegister { index: new_index, components_used: components_needed, variables: [PackedVar { name: name.clone(), ty: ty, swizzle: swizzle.clone() }] })
        ()
        (*_self).allocations.insert(name, (new_index, swizzle.clone()))
        ()
        (new_index, swizzle)

    fn get_allocation(_self: &InterpolatorPacker, name: String) -> Option<(usize, String)>:
        (*_self).allocations.get(name).cloned()


@doc(doc = " Count components needed for a type")
fn type_component_count(ty: String) -> usize:
    match ty:
        "float" => 1
        "int" => 1
        "uint" => 1
        "bool" => 1
        "float2" => 2
        "int2" => 2
        "uint2" => 2
        "float3" => 3
        "int3" => 3
        "uint3" => 3
        "float4" => 4
        "int4" => 4
        "uint4" => 4
        _ => 4

@doc(doc = " Generate swizzle mask for component range")
fn generate_swizzle(start: usize, count: usize) -> String:
    let components = ["x", "y", "z", "w"]
    if ((start + count) > 4):
        return components[start..4].iter().collect()
    components[start..(start + count)].iter().collect()

@doc(doc = " Emit just the shader entry point function (no declarations - those are now global)")
pub fn emit_shader_body(shader_: &kain_core::types::TypedShader, _mirrors: &CachedMirrors, type_db: Map<String, Map<String, String>>) -> Result<String, KainError>:
    let mut output = String__new_()
    let mut ctx = USFContext__new_()
    ctx.struct_map = type_db
    ()
    let metadata_dir = Path__new_("unreal/metadata")
    if metadata_dir.exists():
        let sk_path = metadata_dir.join("shader_knowledge.json")
        if sk_path.exists():
            match std__fs__read_to_string(&sk_path):
                Ok(data) =>
                    let mut sk = ShaderKnowledge__new_()
                    if sk.load(&data).is_ok():
                        ctx.shader_knowledge = Option::Some(sk)
                        ()
                        ()
                        ()
                        ()
                    ()
                _ =>
                    ()
                    ()
            ()
        ()
    for uniform_ in &(*shader_).ast.uniforms:
        if is_permutation_param(&uniform_.name):
            continue
        let usf_type = map_type_to_usf(&uniform_.ty)
        ctx.vars.insert(uniform_.name.clone(), (uniform_.name.clone(), usf_type))
        ()
    ()
    match (*shader_).ast.stage:
        kain_core__ast__ShaderStage::Compute =>
            let is_3d = is_3d_compute_shader(shader_)
            ctx.is_compute_3d = is_3d
            ()
            let threads = if is_3d:
                (8, 8, 8)
            else:
                (8, 8, 1)
            output.push_str(&f"[numthreads({threads.field_0}, {threads.field_1}, {threads.field_2})]\n")
            ()
            output.push_str(&"void {capitalize_first(&(*shader_).ast.name)}CS(uint3 ThreadId : SV_DispatchThreadID)\n{\n")
            ()
            ctx.push_indent()
            ()
            output.push_str(&f"{ctx.indent()}// Safe Texture Load Pattern\n")
            ()
            if is_3d:
                output.push_str(&f"{ctx.indent()}int3 TexCoord = int3(ThreadId.xyz);\n")
                ()
                ()
                ()
                ()
            else:
                output.push_str(&f"{ctx.indent()}int3 TexCoord = int3(ThreadId.xy, 0);\n")
                ()
                ()
                ()
                ()
            match (*shader_).ast.inputs.get(0):
                Some(param) =>
                    ctx.vars.insert(param.name.clone(), (("ThreadId").to_string(), ("uint3").to_string()))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ctx.vars.insert(("thread_id").to_string(), (("ThreadId").to_string(), ("uint3").to_string()))
            ()
            ctx.vars.insert(("dispatch_thread_id").to_string(), (("ThreadId").to_string(), ("uint3").to_string()))
            ()
            ctx.vars.insert(("id").to_string(), (("ThreadId").to_string(), ("uint3").to_string()))
            ()
            ctx.is_compute_shader = true
            ()
            let body_code = emit_block(&mut ctx, &(*shader_).ast.body)?
            if (!ctx.array_decls.is_empty()):
                output.push_str(&f"{ctx.indent()}// Array literal declarations\n")
                ()
                for decl in &ctx.array_decls:
                    output.push_str(&f"{ctx.indent()}{decl}\n")
                    ()
                ()
                output.push_str("\n")
                ()
                ()
                ()
                ()
            let mut body_fixed = body_code
            for param in &(*shader_).ast.inputs:
                match &param.ty:
                    kain_core__ast__Type::Named { name: name } =>
                        if ((name == "Texture2D") || (name == "Sampler2D")):
                            let sampler_name = f"{param.name}_textureSampler"
                            let search = f"{param.name}.Sample({sampler_name}, uv)"
                            let search2 = "{param.name}.Sample({f\"{param.name}Sampler\"}, uv)"
                            body_fixed = body_fixed.replace(&search, &f"{param.name}.Load(TexCoord)")
                            ()
                            body_fixed = body_fixed.replace(&search2, &f"{param.name}.Load(TexCoord)")
                            ()
                    _ => ()
            ()
            for uniform_ in &(*shader_).ast.uniforms:
                match &uniform_.ty:
                    kain_core__ast__Type::Named { name: name } =>
                        if ((name == "Texture2D") || (name == "Sampler2D")):
                            let sampler_name = f"{uniform_.name}_textureSampler"
                            let search = f"{uniform_.name}.Sample({sampler_name}, uv)"
                            let search2 = "{uniform_.name}.Sample({f\"{uniform_.name}Sampler\"}, uv)"
                            body_fixed = body_fixed.replace(&search, &f"{uniform_.name}.Load(TexCoord)")
                            ()
                            body_fixed = body_fixed.replace(&search2, &f"{uniform_.name}.Load(TexCoord)")
                            ()
                    _ => ()
            ()
            output.push_str(&body_fixed)
            ()
            ctx.pop_indent()
            ()
            output.push_str("}\n")
            ()
            ()
            ()
            ()
        kain_core__ast__ShaderStage::Surface =>
            output.push_str("// --- UE5 Material Interface ---\n")
            ()
            output.push_str("#define NUM_MATERIAL_TEXCOORDS_VERTEX 0\n")
            ()
            output.push_str("#define NUM_CUSTOM_VERTEX_INTERPOLATORS 0\n")
            ()
            output.push_str("#include \"/Engine/Generated/Material.ush\"\n\n")
            ()
            output.push_str("void CalcPixelMaterialInputs(in out FMaterialPixelParameters Parameters, in out FPixelMaterialInputs PixelMaterialInputs)\n{\n")
            ()
            ctx.push_indent()
            ()
            output.push_str(&f"{ctx.indent()}// Initialize default material values\n")
            ()
            output.push_str(&f"{ctx.indent()}PixelMaterialInputs.BaseColor = float3(0,0,0);\n")
            ()
            output.push_str(&f"{ctx.indent()}PixelMaterialInputs.Roughness = 0.5;\n")
            ()
            output.push_str(&f"{ctx.indent()}PixelMaterialInputs.Metallic = 0.0;\n")
            ()
            output.push_str(&f"{ctx.indent()}PixelMaterialInputs.Normal = float3(0,0,1);\n\n")
            ()
            output.push_str(&f"{ctx.indent()}// Map UE5 material parameters to shader inputs\n")
            ()
            ctx.vars.insert(("uv").to_string(), (("Parameters.TexCoords[0]").to_string(), ("float2").to_string()))
            ()
            ctx.vars.insert(("world_pos").to_string(), (("Parameters.AbsoluteWorldPosition").to_string(), ("float3").to_string()))
            ()
            ctx.vars.insert(("view_dir").to_string(), (("Parameters.CameraVector").to_string(), ("float3").to_string()))
            ()
            ctx.vars.insert(("world_normal").to_string(), (("Parameters.WorldNormal").to_string(), ("float3").to_string()))
            ()
            ctx.vars.insert(("world_tangent").to_string(), (("Parameters.TangentToWorld[2]").to_string(), ("float3").to_string()))
            ()
            let body_code = emit_block(&mut ctx, &(*shader_).ast.body)?
            if (!ctx.array_decls.is_empty()):
                output.push_str(&f"{ctx.indent()}// Array literal declarations\n")
                ()
                for decl in &ctx.array_decls:
                    output.push_str(&f"{ctx.indent()}{decl}\n")
                    ()
                ()
                output.push_str("\n")
                ()
                ()
                ()
                ()
            output.push_str(&body_code)
            ()
            ctx.pop_indent()
            ()
            output.push_str("}\n")
            ()
            ()
            ()
            ()
        kain_core__ast__ShaderStage::Fragment =>
            let mut packer = InterpolatorPacker__new_()
            for param in &(*shader_).ast.inputs:
                let usf_type = map_type_to_usf(&param.ty)
                packer.allocate(param.name.clone(), usf_type)
                ()
            ()
            output.push_str("struct FPSInput\n{\n")
            ()
            for reg in &packer.registers:
                output.push_str(&f"    float4 TexCoord{reg.index} : TEXCOORD{reg.index};\n")
                ()
            ()
            output.push_str("};\n\n")
            ()
            let out_type = map_type_to_usf(&(*shader_).ast.outputs)
            output.push_str("struct FPSOutput\n{\n")
            ()
            output.push_str(&f"    {out_type} Color : SV_Target0;\n")
            ()
            output.push_str("};\n\n")
            ()
            output.push_str(&"FPSOutput {capitalize_first(&(*shader_).ast.name)}PS(FPSInput Input)\n{\n")
            ()
            ctx.push_indent()
            ()
            output.push_str(&f"{ctx.indent()}// Unpack interpolators\n")
            ()
            for param in &(*shader_).ast.inputs:
                match packer.get_allocation(&param.name):
                    Some((reg_idx, swizzle)) =>
                        let param_type = map_type_to_usf(&param.ty)
                        let packed_access = f"Input.TexCoord{reg_idx}.{swizzle}"
                        output.push_str(&f"{ctx.indent()}{param_type} {param.name} = {packed_access};\n")
                        ()
                        ctx.vars.insert(param.name.clone(), (param.name.clone(), param_type))
                        ()
                    _ => ()
            ()
            output.push_str("\n")
            ()
            let body_code = emit_block(&mut ctx, &(*shader_).ast.body)?
            if (!ctx.array_decls.is_empty()):
                output.push_str(&f"{ctx.indent()}// Array literal declarations\n")
                ()
                for decl in &ctx.array_decls:
                    output.push_str(&f"{ctx.indent()}{decl}\n")
                    ()
                ()
                output.push_str("\n")
                ()
                ()
                ()
                ()
            output.push_str(&body_code)
            ()
            ctx.pop_indent()
            ()
            output.push_str("}\n")
            ()
            ()
            ()
            ()
        kain_core__ast__ShaderStage::Vertex =>
            let mut packer = InterpolatorPacker__new_()
            for param in &(*shader_).ast.inputs:
                let usf_type = map_type_to_usf(&param.ty)
                packer.allocate(param.name.clone(), usf_type)
                ()
            ()
            output.push_str("struct FVSInput\n{\n")
            ()
            for selfhost_for_item in (*shader_).ast.inputs.iter().enumerate():
                let (i, param) = selfhost_for_item
                let usf_type = map_type_to_usf(&param.ty)
                let semantic = match param.name.as_str():
                    "position" => "POSITION"
                    "normal" => "NORMAL"
                    "tangent" => "TANGENT"
                    "color" => "COLOR"
                    _ => "TEXCOORD"
                let idx = if (semantic == "TEXCOORD"):
                    i.to_string()
                else:
                    String__new_()
                output.push_str(&f"    {usf_type} {param.name} : {semantic}{idx};\n")
                ()
            ()
            output.push_str("};\n\n")
            ()
            output.push_str("struct FVSOutput\n{\n")
            ()
            output.push_str("    float4 Position : SV_Position;\n")
            ()
            for reg in &packer.registers:
                output.push_str(&f"    float4 TexCoord{reg.index} : TEXCOORD{reg.index};\n")
                ()
            ()
            output.push_str("};\n\n")
            ()
            output.push_str(&"FVSOutput {capitalize_first(&(*shader_).ast.name)}VS(FVSInput Input)\n{\n")
            ()
            ctx.push_indent()
            ()
            output.push_str(&f"{ctx.indent()}FVSOutput Output;\n")
            ()
            ctx.packer = Option::Some(packer.clone())
            ()
            ctx.is_vertex_shader = true
            ()
            for param in &(*shader_).ast.inputs:
                let param_type = map_type_to_usf(&param.ty)
                ctx.vars.insert(param.name.clone(), (f"Input.{param.name}", param_type))
                ()
            ()
            let body_code = emit_block(&mut ctx, &(*shader_).ast.body)?
            if (!ctx.array_decls.is_empty()):
                output.push_str(&f"{ctx.indent()}// Array literal declarations\n")
                ()
                for decl in &ctx.array_decls:
                    output.push_str(&f"{ctx.indent()}{decl}\n")
                    ()
                ()
                output.push_str("\n")
                ()
                ()
                ()
                ()
            output.push_str(&body_code)
            ()
            output.push_str(&f"\n{ctx.indent()}// Pack interpolators\n")
            ()
            for param in &(*shader_).ast.inputs:
                match packer.get_allocation(&param.name):
                    Some((reg_idx, swizzle)) =>
                        output.push_str(&f"{ctx.indent()}Output.TexCoord{reg_idx}.{swizzle} = Input.{param.name};\n")
                        ()
                    _ => ()
            ()
            output.push_str(&f"\n{ctx.indent()}return Output;\n")
            ()
            ctx.pop_indent()
            ()
            output.push_str("}\n")
            ()
            ()
            ()
            ()
    Result::Ok(output)

fn emit_block(ctx: &mut USFContext, block: &kain_core::ast::Block) -> Result<String, KainError>:
    let mut output = String__new_()
    for stmt in &(*block).stmts:
        output.push_str(&emit_stmt(ctx, stmt)?)
        ()
    ()
    Result::Ok(output)

const HLSL_RESERVED: Array<String> = ["line", "compile", "pass", "technique", "register", "packoffset", "typedef", "sampler", "texture", "vs", "ps", "gs", "hs", "ds", "cs", "row_major", "column_major", "in", "out", "inout", "inline", "cbuffer", "tbuffer", "uniform", "precise", "volatile", "extern", "shared", "groupshared", "half", "min16float", "min10float", "min16int", "min12int", "min16uint", "interface", "namespace"]

@doc(doc = " Rename a variable that collides with an HLSL reserved keyword by prefixing `v_`.")
@doc(doc = " All other names are returned unchanged (as owned String).")
fn sanitize_hlsl_identifier(name: String) -> String:
    if HLSL_RESERVED.contains(&name):
        f"v_{name}"
    else:
        name.to_string()

@doc(doc = " Returns `true` for single-component HLSL numeric types (float, int, uint, bool, double, half).")
@doc(doc = " Used to decide whether a single-arg vector constructor can be elided (Bug-10).")
fn is_scalar_type(ty: String) -> Bool:
    match ty:
        "float" => true
        "int" => true
        "uint" => true
        "bool" => true
        "double" => true
        "half" => true
        "min16float" => true
        "min10float" => true
        "min16int" => true
        "min12int" => true
        "min16uint" => true
        _ => false

fn emit_stmt(ctx: &mut USFContext, stmt: &kain_core::ast::Stmt) -> Result<String, KainError>:
    let mut output = String__new_()
    match stmt:
        kain_core__ast__Stmt::Let { pattern: pattern, value: value } =>
            match value:
                Some(value) =>
                    match pattern:
                        kain_core__ast__Pattern::Binding { name: name, mutable_: mutable_ } =>
                            let (expr_code, expr_type) = emit_expr(ctx, value)?
                            let safe_name = sanitize_hlsl_identifier(name)
                            output.push_str(&f"{ctx.indent()}{expr_type} {safe_name} = {expr_code};\n")
                            ()
                            (*ctx).vars.insert(name.clone(), (safe_name.clone(), expr_type.clone()))
                            ()
                            if (*mutable_):
                                (*ctx).vars.insert(f"__mutable_{name}", (("true").to_string(), ("bool").to_string()))
                                ()
                                ()
                                ()
                                ()
                            ()
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            ()
        kain_core__ast__Stmt::Return(Some(expr), _) =>
            let (expr_code, _) = emit_expr(ctx, expr)?
            if (*ctx).is_vertex_shader:
                output.push_str(&f"{ctx.indent()}Output.Position = mul({expr_code}, View.WorldToClip);\n")
                ()
                ()
                ()
                ()
            elif (*ctx).is_compute_shader:
                let coord = if (*ctx).is_compute_3d:
                    "ThreadId.xyz"
                else:
                    "ThreadId.xy"
                output.push_str(&f"{ctx.indent()}OutputTexture[{coord}] = {expr_code};\n")
                ()
                output.push_str(&f"{ctx.indent()}return;\n")
                ()
                ()
                ()
                ()
            else:
                output.push_str(&f"{ctx.indent()}FPSOutput _Result;\n")
                ()
                output.push_str(&f"{ctx.indent()}_Result.Color = {expr_code};\n")
                ()
                output.push_str(&f"{ctx.indent()}return _Result;\n")
                ()
                ()
                ()
                ()
            ()
        kain_core__ast__Stmt::Return(None, _) =>
            if (!(*ctx).is_vertex_shader):
                output.push_str(&f"{ctx.indent()}return;\n")
                ()
                ()
                ()
                ()
            ()
        kain_core__ast__Stmt::Expr(expr) =>
            match expr:
                kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                    output.push_str(&emit_if_statement(ctx, condition, then_branch, else_branch)?)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    let (expr_code, _) = emit_expr(ctx, expr)?
                    if (!expr_code.is_empty()):
                        output.push_str(&f"{ctx.indent()}{expr_code};\n")
                        ()
                        ()
                        ()
                        ()
                    ()
            ()
        kain_core__ast__Stmt::While { condition: condition, body: body } =>
            let (cond_code, _) = emit_expr(ctx, condition)?
            output.push_str(&f"{ctx.indent()}while ({cond_code})\n")
            ()
            output.push_str(&"{ctx.indent()}{\n")
            ()
            ctx.push_indent()
            ()
            output.push_str(&emit_block(ctx, body)?)
            ()
            ctx.pop_indent()
            ()
            output.push_str(&"{ctx.indent()}}\n")
            ()
            ()
            ()
            ()
        kain_core__ast__Stmt::For { binding: binding, iter: iter, body: body } =>
            match binding:
                kain_core__ast__Pattern::Binding { name: name } =>
                    let bound = match iter:
                        kain_core__ast__Expr::Call { callee: callee, args: args } =>
                            match callee:
                                kain_core__ast__Expr::Ident(fn_name, _) =>
                                    if ((fn_name == "range") && (!args.is_empty())):
                                        let (code, _) = emit_expr(ctx, &args[0].value)?
                                        code
                                    else:
                                        let (code, _) = emit_expr(ctx, iter)?
                                        code
                                _ =>
                                    let (code, _) = emit_expr(ctx, iter)?
                                    code
                        _ =>
                            let (code, _) = emit_expr(ctx, iter)?
                            code
                    output.push_str(&f"{ctx.indent()}for (int {name} = 0; {name} < {bound}; {name}++)\n")
                    ()
                    output.push_str(&"{ctx.indent()}{\n")
                    ()
                    ctx.push_indent()
                    ()
                    (*ctx).vars.insert(name.clone(), (name.clone(), ("int").to_string()))
                    ()
                    output.push_str(&emit_block(ctx, body)?)
                    ()
                    ctx.pop_indent()
                    ()
                    output.push_str(&"{ctx.indent()}}\n")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        kain_core__ast__Stmt::Loop { body: body } =>
            output.push_str(&f"{ctx.indent()}while (true)\n")
            ()
            output.push_str(&"{ctx.indent()}{\n")
            ()
            ctx.push_indent()
            ()
            output.push_str(&emit_block(ctx, body)?)
            ()
            ctx.pop_indent()
            ()
            output.push_str(&"{ctx.indent()}}\n")
            ()
            ()
            ()
            ()
        kain_core__ast__Stmt::Break(_, _) =>
            output.push_str(&f"{ctx.indent()}break;\n")
            ()
            ()
            ()
            ()
        kain_core__ast__Stmt::Continue(_) =>
            output.push_str(&f"{ctx.indent()}continue;\n")
            ()
            ()
            ()
            ()
        kain_core__ast__Stmt::Item(_) => ()
    Result::Ok(output)

fn is_permutation_param(name: String) -> Bool:
    if ((((((name.starts_with("CFG_") || name.starts_with("ENABLE_")) || name.starts_with("USE_")) || name.starts_with("WITH_")) || name.starts_with("HAS_")) || name.starts_with("ALLOW_")) || name.starts_with("SUPPORT_")):
        return true
    if (((name.len() >= 4) && name.contains("_")) && name.chars().all(fn(c): ((c.is_uppercase() || (c == "_")) || c.is_numeric()))):
        return true
    false

fn emit_if_statement(ctx: &mut USFContext, condition: &kain_core::ast::Expr, then_branch: &kain_core::ast::Block, else_branch: &Option<Box<kain_core::ast::ElseBranch>>) -> Result<String, KainError>:
    let mut output = String__new_()
    match condition:
        kain_core__ast__Expr::Ident(name, _) =>
            if is_permutation_param(name):
                output.push_str(&f"{ctx.indent()}#ifdef {name}\n")
                ()
                output.push_str(&emit_block(ctx, then_branch)?)
                ()
                match else_branch:
                    Some(else_br) =>
                        match else_br:
                            kain_core__ast__ElseBranch::Else(block) =>
                                output.push_str(&f"{ctx.indent()}#else\n")
                                ()
                                output.push_str(&emit_block(ctx, block)?)
                                ()
                                ()
                                ()
                                ()
                            kain_core__ast__ElseBranch::ElseIf(cond, block, next_else) =>
                                match cond:
                                    kain_core__ast__Expr::Ident(elif_name, _) =>
                                        if is_permutation_param(elif_name):
                                            output.push_str(&f"{ctx.indent()}#elif defined({elif_name})\n")
                                            ()
                                            output.push_str(&emit_block(ctx, block)?)
                                            ()
                                            match next_else:
                                                Some(next) =>
                                                    output.push_str(&emit_else_branch_preprocessor(ctx, next)?)
                                                    ()
                                                    ()
                                                    ()
                                                    ()
                                                _ =>
                                                    ()
                                                    ()
                                            ()
                                        else:
                                            output.push_str(&f"{ctx.indent()}#else\n")
                                            ()
                                            output.push_str(&emit_if_statement(ctx, cond, block, next_else)?)
                                            ()
                                            ()
                                            ()
                                            ()
                                        ()
                                    _ =>
                                        output.push_str(&f"{ctx.indent()}#else\n")
                                        ()
                                        output.push_str(&emit_if_statement(ctx, cond, block, next_else)?)
                                        ()
                                        ()
                                        ()
                                        ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                output.push_str(&f"{ctx.indent()}#endif\n")
                ()
                return Result::Ok(output)
            ()
        _ =>
            ()
            ()
    let (cond_code, _) = emit_expr(ctx, condition)?
    output.push_str(&f"{ctx.indent()}if ({cond_code})\n")
    ()
    output.push_str(&"{ctx.indent()}{\n")
    ()
    ctx.push_indent()
    ()
    output.push_str(&emit_block(ctx, then_branch)?)
    ()
    ctx.pop_indent()
    ()
    output.push_str(&"{ctx.indent()}}")
    ()
    match else_branch:
        Some(else_br) =>
            match else_br:
                kain_core__ast__ElseBranch::Else(block) =>
                    output.push_str("\n")
                    ()
                    output.push_str(&f"{ctx.indent()}else\n")
                    ()
                    output.push_str(&"{ctx.indent()}{\n")
                    ()
                    ctx.push_indent()
                    ()
                    output.push_str(&emit_block(ctx, block)?)
                    ()
                    ctx.pop_indent()
                    ()
                    output.push_str(&"{ctx.indent()}}\n")
                    ()
                    ()
                    ()
                    ()
                kain_core__ast__ElseBranch::ElseIf(cond, block, next_else) =>
                    output.push_str("\n")
                    ()
                    output.push_str(&f"{ctx.indent()}else ")
                    ()
                    output.push_str(&emit_if_statement(ctx, cond, block, next_else)?)
                    ()
                    ()
                    ()
                    ()
            ()
        _ =>
            output.push_str("\n")
            ()
            ()
            ()
            ()
    Result::Ok(output)

fn emit_else_branch_preprocessor(ctx: &mut USFContext, else_branch: &kain_core::ast::ElseBranch) -> Result<String, KainError>:
    let mut output = String__new_()
    match else_branch:
        kain_core__ast__ElseBranch::Else(block) =>
            output.push_str(&f"{ctx.indent()}#else\n")
            ()
            output.push_str(&emit_block(ctx, block)?)
            ()
            ()
            ()
            ()
        kain_core__ast__ElseBranch::ElseIf(cond, block, next_else) =>
            match cond:
                kain_core__ast__Expr::Ident(name, _) =>
                    if is_permutation_param(name):
                        output.push_str(&f"{ctx.indent()}#elif defined({name})\n")
                        ()
                        output.push_str(&emit_block(ctx, block)?)
                        ()
                        match next_else:
                            Some(next) =>
                                output.push_str(&emit_else_branch_preprocessor(ctx, next)?)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    else:
                        output.push_str(&f"{ctx.indent()}#else\n")
                        ()
                        output.push_str(&emit_if_statement(ctx, cond, block, next_else)?)
                        ()
                        ()
                        ()
                        ()
                    ()
                _ =>
                    output.push_str(&f"{ctx.indent()}#else\n")
                    ()
                    output.push_str(&emit_if_statement(ctx, cond, block, next_else)?)
                    ()
                    ()
                    ()
                    ()
            ()
    Result::Ok(output)

@doc(doc = " Infer the KAIN type of an expression for array literal type checking")
fn infer_expr_type(ctx: &USFContext, expr: &kain_core::ast::Expr) -> Result<String, KainError>:
    match expr:
        Expr::Int(_, span) => Some(Type::Named { name: "Int".to_string(), generics: Vec__new_(), span: span.clone() })
        Expr::Float(_, span) => Some(Type::Named { name: "Float".to_string(), generics: Vec__new_(), span: span.clone() })
        Expr::Bool(_, span) => Some(Type::Named { name: "Bool".to_string(), generics: Vec__new_(), span: span.clone() })
        Expr::Ident(name, _) => ctx.local_types.get(name).cloned()
        Expr::Field { object: object, field: field } =>
            let object_ty = infer_expr_type(object, ctx)?
            field_type_from_object(&object_ty, field, ctx)
        Expr::Index { object: object } => infer_element_type(object, ctx)
        Expr::Cast { target: target } => Some(target.clone())
        _ => none

fn emit_expr(ctx: &mut USFContext, expr: &kain_core::ast::Expr) -> Result<(String, String), KainError>:
    match expr:
        kain_core__ast__Expr::Cast { value: value, target: target } =>
            ctx.validate_cast(value, target)?
            ()
            let (expr_code, _) = emit_expr(ctx, value)?
            let hlsl_type = map_type_to_usf(target)
            Result::Ok((f"({hlsl_type}){expr_code}", hlsl_type))
        kain_core__ast__Expr::Ident(name, _) =>
            match (*ctx).vars.get(name):
                Some((code, ty)) => Result::Ok((code.clone(), ty.clone()))
                _ => Result::Ok((name.clone(), ("float4").to_string()))
        kain_core__ast__Expr::Float(f, _) => Result::Ok((f, ("float").to_string()))
        kain_core__ast__Expr::Int(i, _) => Result::Ok((i, ("int").to_string()))
        kain_core__ast__Expr::Bool(b, _) => Result::Ok((b, ("bool").to_string()))
        kain_core__ast__Expr::String(s, _) => Result::Ok((f"\"{s}\"", ("string").to_string()))
        kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
            let (left_code, left_ty) = emit_expr(ctx, left)?
            let (right_code, _) = emit_expr(ctx, right)?
            let op_str = match op:
                kain_core__ast__BinaryOp::Add => "+"
                kain_core__ast__BinaryOp::Sub => "-"
                kain_core__ast__BinaryOp::Mul => "*"
                kain_core__ast__BinaryOp::Div => "/"
                kain_core__ast__BinaryOp::Mod => "%"
                kain_core__ast__BinaryOp::Eq => "=="
                kain_core__ast__BinaryOp::Ne => "!="
                kain_core__ast__BinaryOp::Lt => "<"
                kain_core__ast__BinaryOp::Le => "<="
                kain_core__ast__BinaryOp::Gt => ">"
                kain_core__ast__BinaryOp::Ge => ">="
                kain_core__ast__BinaryOp::And => "&&"
                kain_core__ast__BinaryOp::Or => "||"
                kain_core__ast__BinaryOp::BitAnd => "&"
                kain_core__ast__BinaryOp::BitOr => "|"
                kain_core__ast__BinaryOp::BitXor => "^"
                kain_core__ast__BinaryOp::Shl => "<<"
                kain_core__ast__BinaryOp::Shr => ">>"
                _ =>
                    let op_name = match op:
                        kain_core__ast__BinaryOp::Add => "+"
                        kain_core__ast__BinaryOp::Sub => "-"
                        kain_core__ast__BinaryOp::Mul => "*"
                        kain_core__ast__BinaryOp::Div => "/"
                        kain_core__ast__BinaryOp::Mod => "%"
                        kain_core__ast__BinaryOp::Eq => "=="
                        kain_core__ast__BinaryOp::Ne => "!="
                        kain_core__ast__BinaryOp::Lt => "<"
                        kain_core__ast__BinaryOp::Le => "<="
                        kain_core__ast__BinaryOp::Gt => ">"
                        kain_core__ast__BinaryOp::Ge => ">="
                        kain_core__ast__BinaryOp::And => "&&"
                        kain_core__ast__BinaryOp::Or => "||"
                        kain_core__ast__BinaryOp::BitAnd => "&"
                        kain_core__ast__BinaryOp::BitOr => "|"
                        kain_core__ast__BinaryOp::BitXor => "^"
                        kain_core__ast__BinaryOp::Shl => "<<"
                        kain_core__ast__BinaryOp::Shr => ">>"
                        _ => "unknown"
                    return Result::Err(KainError__codegen(&f"Unsupported operation '{op_name}' in shader.\n\nSupported shader operations:\n  Arithmetic: +, -, *, / (all types), % (integers only)\n  Comparison: ==, !=, <, >, <=, >= (scalars and vectors)\n  Logical: &&, ||, ! (booleans only)\n  Bitwise: &, |, ^, <<, >> (integers only)\n  \nVector operations:\n  • Component-wise: +, -, *, / work on Vec2/Vec3/Vec4\n    Example: vec3(1,2,3) + vec3(4,5,6) = vec3(5,7,9)\n  \n  • Dot product: dot(a, b) → scalar\n  • Cross product: cross(a, b) → Vec3 (3D only)\n  • Length: length(v) → scalar\n  • Normalize: normalize(v) → same type as v\n  \nMatrix operations:\n  • Matrix multiply: mat * mat, mat * vec\n  • Component-wise: use mul() function\n  \nCommon restrictions:\n  • Modulo (%) requires integer types (Int, UInt, IVec2, etc.)\n  • Bitwise ops require integer types\n  • Logical ops require Bool type\n  • Some ops may require specific HLSL shader model (SM 5.0+)\n\nWhat you tried: <expr> {op_name} <expr>\nProblem: This operation is not supported in HLSL shaders\n\nSuggestions:\n  • For modulo on floats: use fmod(a, b) function\n  • For integer division: ensure both operands are Int/UInt\n  • For vector operations: use built-in functions (dot, cross, length)\n  • For custom ops: write a helper function\n\nDocumentation: https://kain.dev/docs/shaders/operations", expr.span()))
            let result_ty = match op:
                kain_core__ast__BinaryOp::Eq => ("bool").to_string()
                kain_core__ast__BinaryOp::Ne => ("bool").to_string()
                kain_core__ast__BinaryOp::Lt => ("bool").to_string()
                kain_core__ast__BinaryOp::Le => ("bool").to_string()
                kain_core__ast__BinaryOp::Gt => ("bool").to_string()
                kain_core__ast__BinaryOp::Ge => ("bool").to_string()
                kain_core__ast__BinaryOp::And => ("bool").to_string()
                kain_core__ast__BinaryOp::Or => ("bool").to_string()
                _ => left_ty
            Result::Ok((f"({left_code} {op_str} {right_code})", result_ty))
        kain_core__ast__Expr::Unary { op: op, operand: operand } =>
            let (operand_code, ty) = emit_expr(ctx, operand)?
            let op_str = match op:
                kain_core__ast__UnaryOp::Neg => "-"
                kain_core__ast__UnaryOp::Not => "!"
                kain_core__ast__UnaryOp::BitNot => "~"
                kain_core__ast__UnaryOp::Ref => return Result::Ok((operand_code, ty))
                kain_core__ast__UnaryOp::RefMut => return Result::Ok((operand_code, ty))
                kain_core__ast__UnaryOp::Deref => return Result::Ok((operand_code, ty))
            Result::Ok((f"({op_str}{operand_code})", ty))
        kain_core__ast__Expr::Call { callee: callee, args: args } =>
            match &(*(*callee)):
                kain_core__ast__Expr::Ident(name, _) => emit_function_call(ctx, name, args)
                _ => Result::Err(KainError__codegen("Complex function call expression not supported in shaders.\n\nProblem: Shaders only support direct function calls, not computed function pointers or closures.\n\nWhat you tried: A function call where the callee is not a simple identifier.\n\nSupported:\n  ✅ my_function(arg1, arg2)           # Direct function call\n  ✅ dot(vec_a, vec_b)                 # Built-in function\n  ✅ MyStruct::static_method(arg)      # Static method call\n\nNot supported:\n  ❌ let func = my_function            # Function pointers\n  ❌ func(arg1, arg2)                  # Indirect call\n  ❌ callbacks[index](arg)             # Function arrays\n  ❌ obj.method_ptr()(arg)             # Method pointers\n  ❌ (condition ? func_a : func_b)(x)  # Computed function selection\n\nHow to fix:\n  • Use direct function calls with explicit names\n  • Replace function pointers with if/else or match statements\n  • Inline lambda logic directly into shader code\n\nExample (before):\n  let operation = if use_sqrt { sqrt } else { abs }\n  let result = operation(value)\n\nExample (after):\n  let result = if use_sqrt { sqrt(value) } else { abs(value) }\n\nDocumentation: https://kain.dev/docs/shaders/functions", expr.span()))
        kain_core__ast__Expr::Field { object: object, field: field } =>
            let (obj_code, obj_ty) = emit_expr(ctx, object)?
            let field_ty = infer_field_type(ctx, &obj_ty, field)
            Result::Ok((f"{obj_code}.{field}", field_ty))
        kain_core__ast__Expr::Index { object: object, index: index } =>
            let (obj_code, obj_ty) = emit_expr(ctx, object)?
            let (idx_code, _) = emit_expr(ctx, index)?
            let elem_ty = if obj_ty.starts_with("float"):
                ("float").to_string()
            else:
                obj_ty
            Result::Ok((f"{obj_code}[{idx_code}]", elem_ty))
        kain_core__ast__Expr::Assign { target: target, value: value } =>
            let (target_code, _) = emit_expr(ctx, target)?
            let (value_code, ty) = emit_expr(ctx, value)?
            Result::Ok((f"{target_code} = {value_code}", ty))
        kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
            let (cond_code, _) = emit_expr(ctx, condition)?
            if ((then_branch.stmts.len() == 1) && else_branch.is_some()):
                match &then_branch.stmts[0]:
                    kain_core__ast__Stmt::Expr(then_expr) =>
                        let (then_code, then_ty) = emit_expr(ctx, then_expr)?
                        match else_branch.map(fn(b): b):
                            Some(kain_core__ast__ElseBranch::Else(else_block)) =>
                                if (else_block.stmts.len() == 1):
                                    match &else_block.stmts[0]:
                                        kain_core__ast__Stmt::Expr(else_expr) =>
                                            let (else_code, _) = emit_expr(ctx, else_expr)?
                                            return Result::Ok((f"({cond_code} ? {then_code} : {else_code})", then_ty))
                                        _ =>
                                            ()
                                            ()
                                    ()
                                ()
                            _ =>
                                ()
                                ()
                        ()
                    _ =>
                        ()
                        ()
                ()
            Result::Ok((("").to_string(), ("void").to_string()))
        kain_core__ast__Expr::Paren(inner, _) =>
            let (inner_code, ty) = emit_expr(ctx, inner)?
            Result::Ok((f"({inner_code})", ty))
        kain_core__ast__Expr::Array(elements, span) =>
            if elements.is_empty():
                return Result::Err(KainError__codegen("Empty array literals not supported in shaders.\n\nProblem: HLSL requires arrays to have known size and initial values at compile time.\n\nHow to fix:\n  1. Provide at least one element: [0.0] or [vec3(0.0, 0.0, 0.0)]\n  2. Use a buffer instead: uniform my_data: RWBuffer<Float> @0\n  3. Use a fixed-size array with explicit initialization\n\nExamples:\n  ❌ let arr = []                           # ERROR: empty array\n  ✅ let arr = [0.0]                        # OK: single element\n  ✅ let arr = [1.0, 2.0, 3.0]              # OK: multiple elements\n  ✅ uniform data: RWBuffer<Float> @0       # OK: dynamic buffer\n\nNote: Shader arrays are compiled to static const arrays in HLSL.\nFor dynamic data, use StructuredBuffer or RWBuffer uniforms.\n\nDocumentation: https://kain.dev/docs/shaders/arrays", (*span)))
            let elem_type = infer_expr_type(ctx, &elements[0])?
            for selfhost_for_item in elements.iter().enumerate().skip(1):
                let (idx, elem) = selfhost_for_item
                let elem_ty = infer_expr_type(ctx, elem)?
                if (elem_ty != elem_type):
                    return Result::Err(KainError__codegen(&f"Array element {idx} has type '{elem_ty}', expected '{elem_type}'", elem.span()))
            ()
            use crate::type_mapping::TYPE_MAPPER

            let hlsl_type = type_mapping__TYPE_MAPPER.map_to_hlsl(&elem_type).ok_or_else(fn(): KainError__codegen(&f"Cannot map type '{elem_type}' to HLSL for array literal", (*span)))?
            let array_name = f"arr_{ctx.next_temp_id()}"
            let mut decl = "static const {hlsl_type} {array_name}[{elements.len()}] = { "
            for selfhost_for_item in elements.iter().enumerate():
                let (idx, elem) = selfhost_for_item
                let (elem_code, _) = emit_expr(ctx, elem)?
                decl.push_str(&elem_code)
                ()
                if (idx < (elements.len() - 1)):
                    decl.push_str(", ")
                    ()
            ()
            decl.push_str(" };")
            ()
            (*ctx).array_decls.push(decl)
            ()
            Result::Ok((array_name, f"{hlsl_type}[{elements.len()}]"))
        _ => Result::Err(KainError__codegen("Unsupported expression in USF", expr.span()))

fn emit_function_call(ctx: &mut USFContext, name: String, args: &[kain_core::ast::CallArg]) -> Result<(String, String), KainError>:
    match name:
        "vec2" =>
            let mut typed_args: Array<(String, String)> = Vec__new_()
            for arg in args:
                typed_args.push(emit_expr(ctx, &arg.value)?)
                ()
            ()
            if ((typed_args.len() == 1) && is_scalar_type(&typed_args[0].field_1)):
                Result::Ok((typed_args.remove(0).field_0, ("float2").to_string()))
            else:
                Result::Ok(("float2({typed_args.iter().map(fn(__kain_closure_arg5): __kain_closure_arg5.__kain_tuple_0.as_str()).collect().join(\", \")})", ("float2").to_string()))
        "Vec2" =>
            let mut typed_args: Array<(String, String)> = Vec__new_()
            for arg in args:
                typed_args.push(emit_expr(ctx, &arg.value)?)
                ()
            ()
            if ((typed_args.len() == 1) && is_scalar_type(&typed_args[0].field_1)):
                Result::Ok((typed_args.remove(0).field_0, ("float2").to_string()))
            else:
                Result::Ok(("float2({typed_args.iter().map(fn(__kain_closure_arg5): __kain_closure_arg5.__kain_tuple_0.as_str()).collect().join(\", \")})", ("float2").to_string()))
        "vec3" =>
            let mut typed_args: Array<(String, String)> = Vec__new_()
            for arg in args:
                typed_args.push(emit_expr(ctx, &arg.value)?)
                ()
            ()
            if ((typed_args.len() == 1) && is_scalar_type(&typed_args[0].field_1)):
                Result::Ok((typed_args.remove(0).field_0, ("float3").to_string()))
            else:
                Result::Ok(("float3({typed_args.iter().map(fn(__kain_closure_arg6): __kain_closure_arg6.__kain_tuple_0.as_str()).collect().join(\", \")})", ("float3").to_string()))
        "Vec3" =>
            let mut typed_args: Array<(String, String)> = Vec__new_()
            for arg in args:
                typed_args.push(emit_expr(ctx, &arg.value)?)
                ()
            ()
            if ((typed_args.len() == 1) && is_scalar_type(&typed_args[0].field_1)):
                Result::Ok((typed_args.remove(0).field_0, ("float3").to_string()))
            else:
                Result::Ok(("float3({typed_args.iter().map(fn(__kain_closure_arg6): __kain_closure_arg6.__kain_tuple_0.as_str()).collect().join(\", \")})", ("float3").to_string()))
        "vec4" =>
            let mut typed_args: Array<(String, String)> = Vec__new_()
            for arg in args:
                typed_args.push(emit_expr(ctx, &arg.value)?)
                ()
            ()
            if ((typed_args.len() == 1) && is_scalar_type(&typed_args[0].field_1)):
                Result::Ok((typed_args.remove(0).field_0, ("float4").to_string()))
            else:
                Result::Ok(("float4({typed_args.iter().map(fn(__kain_closure_arg7): __kain_closure_arg7.__kain_tuple_0.as_str()).collect().join(\", \")})", ("float4").to_string()))
        "Vec4" =>
            let mut typed_args: Array<(String, String)> = Vec__new_()
            for arg in args:
                typed_args.push(emit_expr(ctx, &arg.value)?)
                ()
            ()
            if ((typed_args.len() == 1) && is_scalar_type(&typed_args[0].field_1)):
                Result::Ok((typed_args.remove(0).field_0, ("float4").to_string()))
            else:
                Result::Ok(("float4({typed_args.iter().map(fn(__kain_closure_arg7): __kain_closure_arg7.__kain_tuple_0.as_str()).collect().join(\", \")})", ("float4").to_string()))
        "sin" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "cos" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "tan" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "asin" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "acos" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "atan" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "abs" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "floor" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "ceil" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "round" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "trunc" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "sqrt" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "rsqrt" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "exp" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "exp2" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "log" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "log2" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "log10" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "sign" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "saturate" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"{name}({arg_code})", ty))
        "fract" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"frac({arg_code})", ty))
        "pow" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let ret_ty = if (name == "distance"):
                ("float").to_string()
            else:
                ty
            Result::Ok((f"{name}({arg1}, {arg2})", ret_ty))
        "min" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let ret_ty = if (name == "distance"):
                ("float").to_string()
            else:
                ty
            Result::Ok((f"{name}({arg1}, {arg2})", ret_ty))
        "max" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let ret_ty = if (name == "distance"):
                ("float").to_string()
            else:
                ty
            Result::Ok((f"{name}({arg1}, {arg2})", ret_ty))
        "fmod" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let ret_ty = if (name == "distance"):
                ("float").to_string()
            else:
                ty
            Result::Ok((f"{name}({arg1}, {arg2})", ret_ty))
        "step" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let ret_ty = if (name == "distance"):
                ("float").to_string()
            else:
                ty
            Result::Ok((f"{name}({arg1}, {arg2})", ret_ty))
        "atan2" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let ret_ty = if (name == "distance"):
                ("float").to_string()
            else:
                ty
            Result::Ok((f"{name}({arg1}, {arg2})", ret_ty))
        "distance" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let ret_ty = if (name == "distance"):
                ("float").to_string()
            else:
                ty
            Result::Ok((f"{name}({arg1}, {arg2})", ret_ty))
        "clamp" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let (arg3, _) = emit_expr(ctx, &args[2].value)?
            Result::Ok((f"{name}({arg1}, {arg2}, {arg3})", ty))
        "smoothstep" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let (arg3, _) = emit_expr(ctx, &args[2].value)?
            Result::Ok((f"{name}({arg1}, {arg2}, {arg3})", ty))
        "mad" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let (arg3, _) = emit_expr(ctx, &args[2].value)?
            Result::Ok((f"{name}({arg1}, {arg2}, {arg3})", ty))
        "mix" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let (arg3, _) = emit_expr(ctx, &args[2].value)?
            Result::Ok((f"lerp({arg1}, {arg2}, {arg3})", ty))
        "lerp" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            let (arg3, _) = emit_expr(ctx, &args[2].value)?
            Result::Ok((f"lerp({arg1}, {arg2}, {arg3})", ty))
        "length" =>
            let (arg_code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"length({arg_code})", ("float").to_string()))
        "normalize" =>
            let (arg_code, ty) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"normalize({arg_code})", ty))
        "dot" =>
            let (arg1, _) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            Result::Ok((f"dot({arg1}, {arg2})", ("float").to_string()))
        "cross" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            Result::Ok((f"cross({arg1}, {arg2})", ty))
        "reflect" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            if ((name == "refract") && (args.len() > 2)):
                let (arg3, _) = emit_expr(ctx, &args[2].value)?
                Result::Ok((f"refract({arg1}, {arg2}, {arg3})", ty))
            else:
                Result::Ok((f"{name}({arg1}, {arg2})", ty))
        "refract" =>
            let (arg1, ty) = emit_expr(ctx, &args[0].value)?
            let (arg2, _) = emit_expr(ctx, &args[1].value)?
            if ((name == "refract") && (args.len() > 2)):
                let (arg3, _) = emit_expr(ctx, &args[2].value)?
                Result::Ok((f"refract({arg1}, {arg2}, {arg3})", ty))
            else:
                Result::Ok((f"{name}({arg1}, {arg2})", ty))
        "sample" =>
            let (texture, _) = emit_expr(ctx, &args[0].value)?
            let (coords, _) = emit_expr(ctx, &args[1].value)?
            Result::Ok((f"{texture}.Sample({texture}Sampler, {coords})", ("float4").to_string()))
        "sample_lod" =>
            let (texture, _) = emit_expr(ctx, &args[0].value)?
            let (coords, _) = emit_expr(ctx, &args[1].value)?
            let (lod, _) = emit_expr(ctx, &args[2].value)?
            Result::Ok((f"{texture}.SampleLevel({texture}Sampler, {coords}, {lod})", ("float4").to_string()))
        "SampleLevel" =>
            let (texture, _) = emit_expr(ctx, &args[0].value)?
            let (coords, _) = emit_expr(ctx, &args[1].value)?
            let (lod, _) = emit_expr(ctx, &args[2].value)?
            Result::Ok((f"{texture}.SampleLevel({texture}Sampler, {coords}, {lod})", ("float4").to_string()))
        "load" =>
            let (texture, _) = emit_expr(ctx, &args[0].value)?
            let (location, _) = emit_expr(ctx, &args[1].value)?
            if (*ctx).is_compute_3d:
                Result::Ok((f"{texture}.Load(int4({location}, 0))", ("float4").to_string()))
            else:
                Result::Ok((f"{texture}.Load(int3({location}, 0))", ("float4").to_string()))
        "Load" =>
            let (texture, _) = emit_expr(ctx, &args[0].value)?
            let (location, _) = emit_expr(ctx, &args[1].value)?
            if (*ctx).is_compute_3d:
                Result::Ok((f"{texture}.Load(int4({location}, 0))", ("float4").to_string()))
            else:
                Result::Ok((f"{texture}.Load(int3({location}, 0))", ("float4").to_string()))
        "store" =>
            let (uav, _) = emit_expr(ctx, &args[0].value)?
            let (coord, _) = emit_expr(ctx, &args[1].value)?
            let (value, _) = emit_expr(ctx, &args[2].value)?
            Result::Ok((f"{uav}[{coord}] = {value}", ("void").to_string()))
        "atomic_add" =>
            let (uav, _) = emit_expr(ctx, &args[0].value)?
            let (value, _) = emit_expr(ctx, &args[1].value)?
            Result::Ok((f"InterlockedAdd({uav}, {value})", ("void").to_string()))
        "atomic_min" =>
            let hlsl_name = if (name == "atomic_min"):
                "InterlockedMin"
            else:
                "InterlockedMax"
            let (uav, _) = emit_expr(ctx, &args[0].value)?
            let (value, _) = emit_expr(ctx, &args[1].value)?
            Result::Ok((f"{hlsl_name}({uav}, {value})", ("void").to_string()))
        "atomic_max" =>
            let hlsl_name = if (name == "atomic_min"):
                "InterlockedMin"
            else:
                "InterlockedMax"
            let (uav, _) = emit_expr(ctx, &args[0].value)?
            let (value, _) = emit_expr(ctx, &args[1].value)?
            Result::Ok((f"{hlsl_name}({uav}, {value})", ("void").to_string()))
        "barrier" => Result::Ok((("GroupMemoryBarrierWithGroupSync()").to_string(), ("void").to_string()))
        "GroupMemoryBarrierWithGroupSync" => Result::Ok((("GroupMemoryBarrierWithGroupSync()").to_string(), ("void").to_string()))
        "device_barrier" => Result::Ok((("DeviceMemoryBarrier()").to_string(), ("void").to_string()))
        "DeviceMemoryBarrier" => Result::Ok((("DeviceMemoryBarrier()").to_string(), ("void").to_string()))
        "GetLuminance" =>
            let (arg_code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"dot({arg_code}, float3(0.299, 0.587, 0.114))", ("float").to_string()))
        "luminance" =>
            let (arg_code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"dot({arg_code}, float3(0.299, 0.587, 0.114))", ("float").to_string()))
        "int" =>
            let (arg_code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"int({arg_code})", ("int").to_string()))
        "float" =>
            let (arg_code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"float({arg_code})", ("float").to_string()))
        "uint" =>
            let (arg_code, _) = emit_expr(ctx, &args[0].value)?
            Result::Ok((f"uint({arg_code})", ("uint").to_string()))
        "int2" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("int2({arg_codes.join(\", \")})", ("int2").to_string()))
        "int3" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("int3({arg_codes.join(\", \")})", ("int3").to_string()))
        "int4" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("int4({arg_codes.join(\", \")})", ("int4").to_string()))
        "uint2" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("uint2({arg_codes.join(\", \")})", ("uint2").to_string()))
        "uint3" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("uint3({arg_codes.join(\", \")})", ("uint3").to_string()))
        "uint4" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("uint4({arg_codes.join(\", \")})", ("uint4").to_string()))
        "float2" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("float2({arg_codes.join(\", \")})", ("float2").to_string()))
        "float3" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("float3({arg_codes.join(\", \")})", ("float3").to_string()))
        "float4" =>
            let mut arg_codes = Vec__new_()
            for arg in args:
                let (code, _) = emit_expr(ctx, &arg.value)?
                arg_codes.push(code)
                ()
            ()
            Result::Ok(("float4({arg_codes.join(\", \")})", ("float4").to_string()))
        _ =>
            let mut arg_codes = Vec__new_()
            let mut first_arg_type = ("float4").to_string()
            for selfhost_for_item in args.iter().enumerate():
                let (i, arg) = selfhost_for_item
                let (code, ty) = emit_expr(ctx, &arg.value)?
                if (i == 0):
                    first_arg_type = ty
                    ()
                    ()
                    ()
                    ()
                arg_codes.push(code)
                ()
            ()
            let return_type = match (*ctx).shader_knowledge:
                Some(sk) =>
                    let inferred = sk.infer_return_type(name)
                    match inferred:
                        "passthrough" => first_arg_type.clone()
                        "unknown" => if sk.is_known_function(name): first_arg_type.clone() else: ("float4").to_string()
                        other => other.to_string()
                _ => ("float4").to_string()
            Result::Ok(("{name}({arg_codes.join(\", \")})", return_type))

fn map_type_to_usf(ty: &kain_core::ast::Type) -> String:
    match ty:
        kain_core__ast__Type::Named { name: name, generics: generics } =>
            let inner_hlsl = if (!generics.is_empty()):
                Option::Some(map_type_to_usf(&generics[0]))
            else:
                none
            match type_mapping__TYPE_MAPPER.map_to_hlsl(name.as_str()):
                Some(hlsl_type) => return hlsl_type
                _ =>
                    ()
                    ()
            match name.as_str():
                "Image2D" => ("RWTexture2D<float4>").to_string()
                "Image3D" => ("RWTexture3D<float4>").to_string()
                "Buffer" =>
                    let inner = inner_hlsl.unwrap_or_else(fn(): ("float4").to_string())
                    f"StructuredBuffer<{inner}>"
                "RWBuffer" =>
                    let inner = inner_hlsl.unwrap_or_else(fn(): ("float4").to_string())
                    f"RWStructuredBuffer<{inner}>"
                "RWTexture2D" =>
                    let inner = inner_hlsl.unwrap_or_else(fn(): ("float4").to_string())
                    f"RWTexture2D<{inner}>"
                "RWTexture3D" =>
                    let inner = inner_hlsl.unwrap_or_else(fn(): ("float4").to_string())
                    f"RWTexture3D<{inner}>"
                "Texture2D" =>
                    let inner = inner_hlsl.unwrap_or_else(fn(): ("float4").to_string())
                    f"Texture2D<{inner}>"
                "Texture3D" =>
                    let inner = inner_hlsl.unwrap_or_else(fn(): ("float4").to_string())
                    f"Texture3D<{inner}>"
                "RWTexture2D_Float" => ("RWTexture2D<float>").to_string()
                "RWTexture2D_Float2" => ("RWTexture2D<float2>").to_string()
                "RWTexture2D_Float3" => ("RWTexture2D<float3>").to_string()
                "RWTexture2D_Int" => ("RWTexture2D<int>").to_string()
                "RWTexture2D_UInt" => ("RWTexture2D<uint>").to_string()
                "StructuredBuffer" =>
                    let inner = inner_hlsl.unwrap_or_else(fn(): ("float4").to_string())
                    f"StructuredBuffer<{inner}>"
                "RWStructuredBuffer" =>
                    let inner = inner_hlsl.unwrap_or_else(fn(): ("float4").to_string())
                    f"RWStructuredBuffer<{inner}>"
                "f32" => ("float").to_string()
                "f64" => ("double").to_string()
                "i32" => ("int").to_string()
                "u32" => ("uint").to_string()
                _ => normalize_shader_params_struct_name(name)
        _ => panic(f"Non-named type {ty} should have been rejected by validator. This indicates a validator-codegen synchronization bug.")

fn infer_swizzle_type(swizzle: String) -> String:
    match swizzle.len():
        1 => ("float").to_string()
        2 => ("float2").to_string()
        3 => ("float3").to_string()
        4 => ("float4").to_string()
        _ => ("float").to_string()

fn capitalize_first(s: String) -> String:
    let mut chars = s.chars()
    match chars.next():
        None => String__new_()
        Some(c) => (c.to_uppercase().collect() + chars.as_str())

@doc(doc = " Format validation errors with file:line:col context and suggestions")
@doc(doc = " Converts a list of validation error messages into a formatted error string")
@doc(doc = " with helpful suggestions for common errors")
fn format_validation_errors(shader_name: String, errors: &[String]) -> String:
    let mut formatted = f"❌ Shader validation failed for '{shader_name}'\n\n"
    for selfhost_for_item in errors.iter().enumerate():
        let (i, error) = selfhost_for_item
        formatted.push_str(&f"{(i + 1)}. {error}\n")
        ()
        if (error.contains("binding @0") && error.contains("reserved for UE5 View")):
            formatted.push_str("   💡 Suggestion: Use @1 or higher for your shader parameters. UE5 reserves b0 for the View uniform buffer.\n")
            ()
            ()
            ()
            ()
        elif error.contains("conflicts with HLSL reserved keyword"):
            formatted.push_str("   💡 Suggestion: Rename the identifier to avoid HLSL keyword conflicts (e.g., add '_param' suffix).\n")
            ()
            ()
            ()
            ()
        elif error.contains("conflicts with C++ keyword"):
            formatted.push_str("   💡 Suggestion: Rename to avoid C++ keyword conflicts in generated code (e.g., add '_shader' suffix).\n")
            ()
            ()
            ()
            ()
        elif error.contains("exceeds maximum"):
            formatted.push_str("   💡 Suggestion: Use a lower binding number within the valid range for this resource type.\n")
            ()
            ()
            ()
            ()
        elif error.contains("not 16-byte aligned"):
            formatted.push_str("   💡 Suggestion: Add padding fields to align the struct to 16 bytes (required for constant buffers).\n")
            ()
            ()
            ()
            ()
        elif (error.contains("permutation") && error.contains("naming convention")):
            formatted.push_str("   💡 Suggestion: Use CFG_* or ENABLE_* prefix for permutation uniforms (e.g., CFG_HIGH_QUALITY).\n")
            ()
            ()
            ()
            ()
        elif error.contains("String type"):
            formatted.push_str("   💡 Suggestion: Strings are not supported in shaders. Use numeric types or texture indices instead.\n")
            ()
            ()
            ()
            ()
        elif error.contains("array type"):
            formatted.push_str("   💡 Suggestion: Use StructuredBuffer or explicit array size for shader arrays.\n")
            ()
            ()
            ()
            ()
        elif error.contains("multiple resource types"):
            formatted.push_str("   💡 Suggestion: Use different binding numbers for different resource types to avoid confusion.\n")
            ()
            ()
            ()
            ()
        formatted.push("\n")
        ()
    ()
    formatted.push_str("Shader validation catches errors before UE5 compilation, saving time.\n")
    ()
    formatted.push_str("Fix these issues and rebuild.\n")
    ()
    formatted

@doc(doc = " Generate a single USF string from a program (public API).")
@doc(doc = " This generates ONLY the shader specified by shader_name, not all shaders.")
pub fn generate_single_usf_from_program(program: &kain_core::types::TypedProgram, shader_name: String) -> Result<String, KainError>:
    generate_single_usf_cached(program, shader_name, &CachedMirrors__from_program(program))

fn generate_single_usf_cached(program: &kain_core::types::TypedProgram, shader_name: String, mirrors: &CachedMirrors) -> Result<String, KainError>:
    let mut validator = ShaderValidator__new_()
    let mut filtered_program = kain_core::types::TypedProgram { items: Vec__new_() }
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(_) =>
                filtered_program.items.push(item.clone())
                ()
            kain_core__types__TypedItem::Enum(_) =>
                filtered_program.items.push(item.clone())
                ()
            _ => ()
    ()
    let mut shader_to_validate: Option<&kain_core::types::TypedShader> = none
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Shader(shader_) =>
                let normalized_ast_name = shader_.ast.name.replace("_", "").to_lowercase()
                let normalized_shader_name = shader_name.replace("_", "").to_lowercase()
                if (normalized_ast_name == normalized_shader_name):
                    filtered_program.items.push(item.clone())
                    ()
                    shader_to_validate = Option::Some(shader_)
                    ()
                    break
            _ => ()
    ()
    if filtered_program.items.is_empty():
        return Result::Err(KainError__codegen(&f"Shader '{shader_name}' not found in program", Span__default_()))
    match shader_to_validate:
        Some(shader_) =>
            match validator.validate_shader(shader_, Option::Some(program)):
                Err(validation_errors) =>
                    let error_message = format_validation_errors(shader_name, &validation_errors)
                    return Result::Err(KainError__codegen(&error_message, shader_.ast.span))
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    generate_cached(&filtered_program, mirrors)

@doc(doc = " All three shader artifacts (header, implementation, USF) generated in a single")
@doc(doc = " pass — mirrors are computed once from the program and reused across all three.")
@derive(Debug)
pub struct ShaderArtifacts:
    header: String
    cpp: String
    usf: String

@doc(doc = " Filter out functions with String parameters from the typed program.")
@doc(doc = " This prevents shader codegen from encountering String types which are not valid in HLSL.")
@doc(doc = "")
@doc(doc = " The validator checks shader signatures, but when stdlib functions are included in the program,")
@doc(doc = " their signatures (which may contain String parameters) can cause panics in the type mapper.")
@doc(doc = " This function removes such functions and structs before codegen processes the program.")
fn filter_shader_compatible_program(program: &kain_core::types::TypedProgram) -> kain_core::types::TypedProgram:
    use kain_core::types::TypedFunction

    @doc(doc = " Check if a type contains String or Array (both invalid in shaders)")
    fn has_invalid_shader_type(ty: &kain_core::ast::Type) -> Bool:
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                if (((name == "String") || (name == "string")) || (name == "Array")):
                    return true
                generics.iter().any(has_invalid_shader_type)
            kain_core__ast__Type::Array(_, _, _) => true
            kain_core__ast__Type::Ref { inner: inner } => has_invalid_shader_type(inner)
            _ => false

    @doc(doc = " Check if a function has invalid types in its signature")
    fn function_has_invalid_types(func: &kain_core::types::TypedFunction) -> Bool:
        for param in &(*func).ast.params:
            if has_invalid_shader_type(&param.ty):
                return true
        ()
        match (*func).ast.return_type:
            Some(return_type) =>
                if has_invalid_shader_type(return_type):
                    return true
                ()
            _ =>
                ()
                ()
        false

    @doc(doc = " Check if a struct has invalid types in its fields")
    fn struct_has_invalid_types(typed_struct: &kain_core::types::TypedStruct) -> Bool:
        for field in &(*typed_struct).ast.fields:
            if has_invalid_shader_type(&field.ty):
                return true
        ()
        false

    let filtered_items: Array<kain_core::types::TypedItem> = (*program).items.iter().filter(fn(item): none).cloned().collect()
    kain_core::types::TypedProgram { items: filtered_items }

@doc(doc = " Compile all shader artifacts for a single shader in one call.")
@doc(doc = " This computes component mirrors **once** from the full program and passes the")
@doc(doc = " result to each generator, avoiding the 3× per-shader mirror traversal that")
@doc(doc = " occurs when calling the individual functions separately.")
pub fn compile_shader_artifacts(program: &kain_core::types::TypedProgram, shader_name: String, plugin_name: String) -> Result<ShaderArtifacts, KainError>:
    let mut validator = ShaderValidator__new_()
    let shader_to_validate = (*program).items.iter().find_map(fn(item): none)
    match shader_to_validate:
        Some(shader_) =>
            match validator.validate_shader(shader_, Option::Some(program)):
                Err(validation_errors) =>
                    let error_message = format_validation_errors(shader_name, &validation_errors)
                    return Result::Err(KainError__codegen(&error_message, shader_.ast.span))
                _ =>
                    ()
                    ()
            ()
        _ => return Result::Err(KainError__codegen(&f"Shader '{shader_name}' not found in program", Span__default_()))
    let filtered_program = filter_shader_compatible_program(program)
    let mirrors = CachedMirrors__from_program(&filtered_program)
    Result::Ok(ShaderArtifacts { header: generate_cpp_header_cached(&filtered_program, shader_name, plugin_name, &mirrors), cpp: generate_cpp_implementation_cached(&filtered_program, shader_name, plugin_name, &mirrors), usf: generate_single_usf_cached(&filtered_program, shader_name, &mirrors)? })

@doc(doc = " Generate a single shared `{Plugin}ShaderTypes.h` containing all POD mirror")
@doc(doc = " struct definitions for every `@component` type used as a shader uniform.")
@doc(doc = "")
@doc(doc = " Returns `None` when no component mirrors exist (nothing to write).")
@doc(doc = " Call once per plugin build and write to `Public/{plugin_name}ShaderTypes.h`.")
pub fn generate_shared_types_header(program: &kain_core::types::TypedProgram, _plugin_name: String) -> Option<String>:
    let mirrors = CachedMirrors__from_program(program)
    if mirrors.field_0.is_empty():
        return none
    let mut out_ = String__new_()
    out_.push_str("// Generated by KAIN Compiler - Shared Shader POD Types\n")
    ()
    out_.push_str("// Included by per-shader headers that use @component uniforms.\n")
    ()
    out_.push_str("// DO NOT define POD structs in individual shader headers.\n\n")
    ()
    out_.push_str("#pragma once\n\n")
    ()
    out_.push_str("#include \"CoreMinimal.h\"\n\n")
    ()
    let mut names: Array<String> = mirrors.field_0.keys().map(fn(s): s.as_str()).collect()
    names.sort()
    ()
    for name in names:
        match mirrors.field_0.get(name):
            Some(mirror) =>
                out_.push_str(&mirror.generate_cpp_struct())
                ()
            _ => ()
    ()
    Option::Some(out_)

@doc(doc = " Shared helper function definitions for `.ush` generation.")
@doc(doc = " Each entry: (function_name, hlsl_code, detection_fn).")
@doc(doc = " Detection functions check if a shader's uniforms/body suggest it needs this helper.")
struct SharedHelper:
    name: String
    code: String
    min_users: usize

const SHARED_HELPERS: Array<SharedHelper> = [SharedHelper { name: "ComputeBoundsCheck", code: "// Returns true if the pixel is within texture bounds\nbool IsInBounds(uint2 Pixel, uint2 TextureSize)\n{\n    return Pixel.x < TextureSize.x && Pixel.y < TextureSize.y;\n}\n", min_users: 2 }, SharedHelper { name: "ComputeUV", code: "// Compute normalized UV from pixel coordinates (center-of-pixel sampling)\nfloat2 PixelToUV(uint2 Pixel, uint2 TextureSize)\n{\n    return (float2(Pixel) + 0.5f) / float2(TextureSize);\n}\n", min_users: 2 }, SharedHelper { name: "HashNoise", code: "// Fast hash-based pseudo-random noise\nfloat HashNoise(float2 UV)\n{\n    return frac(sin(dot(UV, float2(12.9898f, 78.233f))) * 43758.5453f);\n}\n", min_users: 2 }, SharedHelper { name: "GrayscaleOutput", code: "// Pack a scalar value into a grayscale float4 with full alpha\nfloat4 Grayscale(float Value)\n{\n    return float4(Value, Value, Value, 1.0f);\n}\n", min_users: 2 }]

@doc(doc = " Detect which shared helpers a shader needs based on its uniforms and body.")
fn detect_needed_helpers(shader_: &kain_core::types::TypedShader) -> Array<String>:
    let mut needed = Vec__new_()
    let has_texture_size = (*shader_).ast.uniforms.iter().any(fn(u): (u.name == "texture_size"))
    let is_compute = match (*shader_).ast.stage:
        kain_core__ast__ShaderStage::Compute => true
        _ => false
    if (is_compute && has_texture_size):
        needed.push("ComputeBoundsCheck")
        ()
        needed.push("ComputeUV")
        ()
        ()
        ()
        ()
    let has_seed = (*shader_).ast.uniforms.iter().any(fn(u): (u.name == "seed"))
    let has_scale = (*shader_).ast.uniforms.iter().any(fn(u): (u.name == "scale"))
    if (has_seed && has_scale):
        needed.push("HashNoise")
        ()
        ()
        ()
        ()
    let has_input_texture = (*shader_).ast.uniforms.iter().any(fn(u): none)
    if ((is_compute && has_texture_size) && (!has_input_texture)):
        needed.push("GrayscaleOutput")
        ()
        ()
        ()
        ()
    needed

@doc(doc = " Analyze all shaders in a program and generate a `{Plugin}Common.ush` shared")
@doc(doc = " library containing reusable HLSL helper functions.")
@doc(doc = "")
@doc(doc = " Returns `None` if the program has fewer than 2 shaders (no sharing benefit)")
@doc(doc = " or if no helpers meet the minimum usage threshold.")
pub fn generate_shared_shader_library(program: &kain_core::types::TypedProgram, plugin_name: String) -> Option<String>:
    let shaders: Array<&kain_core::types::TypedShader> = (*program).items.iter().filter_map(fn(item): none).collect()
    if (shaders.len() < 2):
        return none
    let mut helper_usage: Map<String, usize> = HashMap__new_()
    for shader_ in &shaders:
        let needed = detect_needed_helpers(shader_)
        for name in needed:
            (*helper_usage.entry(name).or_insert(0)) = ((*helper_usage.entry(name).or_insert(0)) + 1)
            ()
    ()
    let emitted_helpers: Array<&SharedHelper> = SHARED_HELPERS.iter().filter(fn(h): (helper_usage.get(h.name).copied().unwrap_or(0) >= h.min_users)).collect()
    if emitted_helpers.is_empty():
        return none
    let mut out_ = String__new_()
    out_.push_str("// Generated by KAIN Compiler - Shared Shader Library\n")
    ()
    out_.push_str(&f"// Common helpers for {shaders.len()} shaders in {plugin_name}\n")
    ()
    out_.push_str("// DO NOT EDIT - Regenerate with `kain build`\n\n")
    ()
    out_.push_str("#pragma once\n\n")
    ()
    out_.push_str("#include \"/Engine/Public/Platform.ush\"\n\n")
    ()
    for helper in &emitted_helpers:
        let usage = helper_usage.get(helper.name).unwrap_or(&0)
        out_.push_str(&f"// Used by {usage} shaders\n")
        ()
        out_.push_str(helper.code)
        ()
        out_.push_str("\n")
        ()
    ()
    Option::Some(out_)

@doc(doc = " Check if a specific shader needs the shared library include.")
@doc(doc = " Returns true if the shader uses any helper that was emitted to the shared library.")
pub fn shader_needs_shared_library(shader_: &kain_core::types::TypedShader, program: &kain_core::types::TypedProgram) -> Bool:
    let shader_count = (*program).items.iter().filter(fn(i): none).count()
    if (shader_count < 2):
        return false
    (!detect_needed_helpers(shader_).is_empty())

@doc(doc = " Public wrapper around the internal struct-to-HLSL-type map builder.")
@doc(doc = " Used by the material graph converter to seed the type database for")
@doc(doc = " [`emit_shader_body`] when performing the shader→CustomHLSL bridge.")
pub fn build_struct_map_pub(program: &kain_core::types::TypedProgram) -> Map<String, Map<String, String>>:
    build_struct_map(program)

fn build_struct_map(program: &kain_core::types::TypedProgram) -> Map<String, Map<String, String>>:
    let mut type_db: Map<String, Map<String, String>> = HashMap__new_()
    for item in &(*program).items:
        match item:
            kain_core__types__TypedItem::Struct(s) =>
                let mut fields = HashMap__new_()
                for f in &s.ast.fields:
                    match try_map_type_to_usf_silent(&f.ty):
                        Some(mapped) =>
                            fields.insert(f.name.clone(), mapped)
                            ()
                        _ => ()
                ()
                type_db.insert(s.ast.name.clone(), fields)
                ()
            kain_core__types__TypedItem::Component(c) =>
                let mut props = HashMap__new_()
                for p in &c.ast.props:
                    match try_map_type_to_usf_silent(&p.ty):
                        Some(mapped) =>
                            props.insert(p.name.clone(), mapped)
                            ()
                        _ => ()
                ()
                type_db.insert(c.ast.name.clone(), props.clone())
                ()
                type_db.insert(f"F{c.ast.name}ComponentData", props)
                ()
            kain_core__types__TypedItem::Actor(a) =>
                let mut state_ = HashMap__new_()
                for s in &a.ast.state_:
                    match try_map_type_to_usf_silent(&s.ty):
                        Some(mapped) =>
                            state_.insert(s.name.clone(), mapped)
                            ()
                        _ => ()
                ()
                type_db.insert(a.ast.name.clone(), state_)
                ()
            _ => ()
    ()
    type_db

fn is_hlsl_swizzle(s: String) -> Bool:
    if (s.is_empty() || (s.len() > 4)):
        return false
    let valid_xyzw = s.chars().all(fn(c): ("xyzw").contains(c))
    let valid_rgba = s.chars().all(fn(c): ("rgba").contains(c))
    (valid_xyzw || valid_rgba)

fn infer_field_type(ctx: &USFContext, obj_type: String, field_name: String) -> String:
    if is_hlsl_swizzle(field_name):
        return infer_swizzle_type(field_name)
    match (*ctx).struct_map.get(obj_type):
        Some(fields) =>
            match fields.get(field_name):
                Some(ty) => return ty.clone()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    ("float").to_string()

@doc(doc = " Determine whether a compute shader operates on 3D volume data.")
@doc(doc = "")
@doc(doc = " The heuristic checks for explicit `Image3D` or `RWTexture3D` uniforms — if")
@doc(doc = " the shader writes to a 3D texture it is a 3D compute shader.  The dispatch")
@doc(doc = " ID type (always `uint3` / `Vec3` regardless of dimensionality) is")
@doc(doc = " intentionally **not** used as the signal.")
fn is_3d_compute_shader(shader_: &kain_core::types::TypedShader) -> Bool:
    (*shader_).ast.uniforms.iter().any(fn(u): none)

