    fn gen_jsx(_self: &mut TSGen, node: &kain_core::ast::JSXNode):
        match node:
            kain_core__ast__JSXNode::Element { tag: tag, attributes: attributes, children: children } =>
                (*_self).write("(() => {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).writeln(&f"const __el = document.createElement('{tag}');")
                ()
                for attr in attributes:
                    match &attr.value:
                        kain_core__ast__JSXAttrValue::String(s) => if (attr.name == "class"): none else: none
                        kain_core__ast__JSXAttrValue::Bool(b) =>
                            if (*b):
                                (*_self).writeln(&f"__el.setAttribute('{attr.name}', '');")
                                ()
                        kain_core__ast__JSXAttrValue::Expr(expr) =>
                            if attr.name.starts_with("on_"):
                                let event = attr.name.trim_start_matches("on_")
                                (*_self).write(&f"__el.addEventListener('{event}', ")
                                ()
                                (*_self).gen_expr(expr)
                                ()
                                (*_self).writeln(" as EventListener);")
                                ()
                            elif (attr.name == "class"):
                                (*_self).write("__el.className = String(")
                                ()
                                (*_self).gen_expr(expr)
                                ()
                                (*_self).writeln(");")
                                ()
                            else:
                                (*_self).write(&f"__el.setAttribute('{attr.name}', String(")
                                ()
                                (*_self).gen_expr(expr)
                                ()
                                (*_self).writeln("));")
                                ()
                ()
                for child in children:
                    (*_self).write("__el.appendChild(")
                    ()
                    (*_self).gen_jsx(child)
                    ()
                    (*_self).writeln(");")
                    ()
