use kain_core::ast::BinaryOp

use kain_core::ast::Block

use kain_core::ast::ElseBranch

use kain_core::ast::EnumVariantFields

use kain_core::ast::Expr

use kain_core::ast::Function

use kain_core::ast::Impl

use kain_core::ast::JSXAttrValue

use kain_core::ast::JSXNode

use kain_core::ast::Pattern

use kain_core::ast::Stmt

use kain_core::ast::Type

use kain_core::ast::UnaryOp

use kain_core::ast::VariantFields

use kain_core::ast::VariantPatternFields

use kain_core::error::KainResult

use kain_core::types::FloatSize

use kain_core::types::IntSize

use kain_core::types::ResolvedType

use kain_core::types::TypedComponent

use kain_core::types::TypedEnum

use kain_core::types::TypedFunction

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

use kain_core::types::TypedStruct

use kain_core::lower_typed_program_memory_for_target

use kain_core::validate_typed_program_memory_support

use kain_core::CompileTarget

use std::collections::HashSet

@doc(doc = " Generate TypeScript source code from a typed program.")
pub fn generate(program: &kain_core::types::TypedProgram) -> Result<String, KainError>:
    let lowered = kain_core__lower_typed_program_memory_for_target(program, kain_core__CompileTarget__Ts)?
    kain_core__validate_typed_program_memory_support(&lowered, kain_core__CompileTarget__Ts)?
    ()
    let mut gen = TSGen__new_()
    Result::Ok(gen.gen_program(&lowered))

@derive(Default)
struct StringBuilder:
    lines: Array<String>

impl Default for StringBuilder:
    pub fn default_() -> StringBuilder:
        StringBuilder { lines: Vec__new_() }


impl StringBuilder:
    fn push(_self: &mut StringBuilder, text: String):
        (*_self).lines.push(text.to_string())
        ()

    fn push_line(_self: &mut StringBuilder, text: String):
        (*_self).lines.push(f"{text}\n")
        ()

    fn build(_self: StringBuilder) -> String:
        _self.lines.join("")


struct TSGen:
    output: StringBuilder
    indent: usize
    seen_types: Set<String>
    needs_dom_types: Bool

impl TSGen:
    fn new_() -> TSGen:
        TSGen { output: StringBuilder__default_(), indent: 0, seen_types: HashSet__new_(), needs_dom_types: false }

    fn indent(_self: &mut TSGen):
        (*_self).indent = ((*_self).indent + 1)
        ()

    fn dedent(_self: &mut TSGen):
        if ((*_self).indent > 0):
            (*_self).indent = ((*_self).indent - 1)
            ()

    fn write(_self: &mut TSGen, text: String):
        (*_self).output.push(text)
        ()

    fn writeln(_self: &mut TSGen, text: String):
        let indent = ("  ").repeat((*_self).indent)
        (*_self).output.push_line(&f"{indent}{text}")
        ()

    fn gen_program(_self: &mut TSGen, program: &kain_core::types::TypedProgram) -> String:
        for item in &(*program).items:
            if (none):
                (*_self).needs_dom_types = true
                ()
                break
        ()
        (*_self).writeln("// Generated by KAIN compiler")
        ()
        (*_self).writeln("// Target: TypeScript (strict)")
        ()
        (*_self).writeln("/* eslint-disable @typescript-eslint/no-explicit-any */")
        ()
        (*_self).writeln("")
        ()
        (*_self).writeln("// Numeric type helpers")
        ()
        (*_self).writeln("function u8(n: number): number { return n & 0xFF; }")
        ()
        (*_self).writeln("function u16(n: number): number { return n & 0xFFFF; }")
        ()
        (*_self).writeln("function u32(n: number): number { return n >>> 0; }")
        ()
        (*_self).writeln("function i8(n: number): number { return (n << 24) >> 24; }")
        ()
        (*_self).writeln("function i16(n: number): number { return (n << 16) >> 16; }")
        ()
        (*_self).writeln("function i32(n: number): number { return n | 0; }")
        ()
        (*_self).writeln("function f32(n: number): number { return Math.fround(n); }")
        ()
        (*_self).writeln("")
        ()
        (*_self).writeln("// Low-level memory emulation runtime")
        ()
        (*_self).writeln("type __KainPtrMeta = { kind: \"value\" } | { kind: \"field\"; base: number; field: string } | { kind: \"index\"; base: number; index: number };")
        ()
        (*_self).writeln("const __kainMem = new Map<number, any>();")
        ()
        (*_self).writeln("const __kainPtrMeta = new Map<number, __KainPtrMeta>();")
        ()
        (*_self).writeln("let __kainNextPtr = 1;")
        ()
        (*_self).writeln("function __kain_new_ptr(meta: __KainPtrMeta): number { const ptr = __kainNextPtr++; __kainPtrMeta.set(ptr, meta); return ptr; }")
        ()
        (*_self).writeln("function __kain_clone_value<T>(value: T): T { if (Array.isArray(value)) { return value.map((item) => __kain_clone_value(item)) as T; } if (value && typeof value === \"object\") { return Object.fromEntries(Object.entries(value as Record<string, unknown>).map(([k, v]) => [k, __kain_clone_value(v)])) as T; } return value; }")
        ()
        (*_self).writeln("function __kain_addr_of<T>(value: T): number { const ptr = __kain_new_ptr({ kind: \"value\" }); __kainMem.set(ptr, value); return ptr; }")
        ()
        (*_self).writeln("function __kain_bind_local<T>(value: T): number { return __kain_addr_of(value); }")
        ()
        (*_self).writeln("function __kain_field_ptr(ptr: number, field: string, _offset: number): number { return __kain_new_ptr({ kind: \"field\", base: ptr, field }); }")
        ()
        (*_self).writeln("function __kain_index_ptr(ptr: number, index: number, _stride: number): number { return __kain_new_ptr({ kind: \"index\", base: ptr, index }); }")
        ()
        (*_self).writeln("function __kain_ptr_offset(ptr: number, offset: number, stride: number): number { return ptr + (offset * Math.max(stride, 1)); }")
        ()
        (*_self).writeln("function __kain_mem_load<T>(ptr: number): T { const meta = __kainPtrMeta.get(ptr); if (!meta || meta.kind === \"value\") { return __kainMem.get(ptr) as T; } if (meta.kind === \"field\") { const base = __kain_mem_load<any>(meta.base); return base?.[meta.field] as T; } const base = __kain_mem_load<any>(meta.base); return base?.[meta.index] as T; }")
        ()
        (*_self).writeln("function __kain_mem_store<T>(ptr: number, value: T): T { const meta = __kainPtrMeta.get(ptr); if (!meta || meta.kind === \"value\") { __kainMem.set(ptr, value); return value; } if (meta.kind === \"field\") { const base = __kain_mem_load<any>(meta.base); if (base != null) { base[meta.field] = value; } return value; } const base = __kain_mem_load<any>(meta.base); if (base != null) { base[meta.index] = value; } return value; }")
        ()
        (*_self).writeln("function __kain_union_buffer(value: any, size: number): ArrayBuffer { if (!value || typeof value !== \"object\") { return new ArrayBuffer(Math.max(size, 1)); } if (!Object.prototype.hasOwnProperty.call(value, \"__kain_union_buffer\")) { Object.defineProperty(value, \"__kain_union_buffer\", { value: new ArrayBuffer(Math.max(size, 1)), writable: true, enumerable: false, configurable: true }); } const existing = value.__kain_union_buffer as ArrayBuffer; if (existing.byteLength < Math.max(size, 1)) { const next = new ArrayBuffer(Math.max(size, 1)); new Uint8Array(next).set(new Uint8Array(existing.slice(0))); Object.defineProperty(value, \"__kain_union_buffer\", { value: next, writable: true, enumerable: false, configurable: true }); return next; } return existing; }")
        ()
        (*_self).writeln("function __kain_union_encode(view: DataView, typeKey: string, byteSize: number, value: any): void { switch (typeKey) { case \"Float\": if (byteSize >= 8) { view.setFloat64(0, Number(value ?? 0), true); } else { view.setFloat32(0, Number(value ?? 0), true); } break; case \"Bool\": view.setUint8(0, value ? 1 : 0); break; case \"Char\": view.setUint8(0, typeof value === \"string\" && value.length > 0 ? value.charCodeAt(0) & 0xFF : 0); break; default: if (byteSize >= 8) { view.setBigInt64(0, BigInt(Math.trunc(Number(value ?? 0))), true); } else if (byteSize >= 4) { view.setInt32(0, Number(value ?? 0), true); } else if (byteSize >= 2) { view.setInt16(0, Number(value ?? 0), true); } else { view.setInt8(0, Number(value ?? 0)); } break; } }")
        ()
        (*_self).writeln("function __kain_union_decode(typeKey: string, byteSize: number, fallback: any, view: DataView): any { switch (typeKey) { case \"Float\": return byteSize >= 8 ? view.getFloat64(0, true) : view.getFloat32(0, true); case \"Bool\": return view.getUint8(0) !== 0; case \"Char\": return String.fromCharCode(view.getUint8(0)); default: if (byteSize >= 8) { return Number(view.getBigInt64(0, true)); } if (byteSize >= 4) { return view.getInt32(0, true); } if (byteSize >= 2) { return view.getInt16(0, true); } if (byteSize >= 1) { return view.getInt8(0); } return fallback; } }")
        ()
        (*_self).writeln("function __kain_union_wrap<T extends object>(value: T, active: string, typeKey: string, byteSize: number, unionSize: number, activeValue: any): T { Object.defineProperty(value, \"__kain_union_active\", { value: active, writable: true, enumerable: false, configurable: true }); const buffer = __kain_union_buffer(value, unionSize); const view = new DataView(buffer); __kain_union_encode(view, typeKey, byteSize, activeValue); return value; }")
        ()
        (*_self).writeln("function __kain_union_get<T>(value: any, field: string, typeKey: string, byteSize: number, unionSize: number, fallback: T): T { if (value == null) { return fallback; } if (value.__kain_union_active === field) { return value[field] as T; } const buffer = __kain_union_buffer(value, unionSize); const next = __kain_union_decode(typeKey, byteSize, fallback, new DataView(buffer)) as T; value[field] = next; return next; }")
        ()
        (*_self).writeln("function __kain_union_set<T>(value: any, field: string, typeKey: string, byteSize: number, unionSize: number, next: T): T { if (value != null) { const buffer = __kain_union_buffer(value, unionSize); __kain_union_encode(new DataView(buffer), typeKey, byteSize, next); value[field] = next; Object.defineProperty(value, \"__kain_union_active\", { value: field, writable: true, enumerable: false, configurable: true }); } return next; }")
        ()
        (*_self).writeln("function __kain_bitfield_units(value: any): Record<string, number> { if (value == null) { return {}; } if (!Object.prototype.hasOwnProperty.call(value, \"__kain_bitfield_units\")) { Object.defineProperty(value, \"__kain_bitfield_units\", { value: {}, writable: true, enumerable: false, configurable: true }); } return value.__kain_bitfield_units as Record<string, number>; }")
        ()
        (*_self).writeln("function __kain_bitfield_get(value: any, field: string, unitOffset: number, bitOffset: number, width: number, signed: boolean): number { if (value == null) { return 0; } const units = __kain_bitfield_units(value) as Record<string, bigint>; const key = String(unitOffset); const unit = BigInt(units[key] ?? 0n); const safeWidth = BigInt(Math.max(width, 0)); const shift = BigInt(Math.max(bitOffset, 0)); const mask = safeWidth === 0n ? 0n : ((1n << safeWidth) - 1n); let next = Number((unit >> shift) & mask); if (signed && width > 0) { const signBit = 1n << BigInt(width - 1); let signedValue = (unit >> shift) & mask; if ((signedValue & signBit) !== 0n) { signedValue -= (1n << BigInt(width)); } next = Number(signedValue); } value[field] = next; return next; }")
        ()
        (*_self).writeln("function __kain_bitfield_set(value: any, field: string, unitOffset: number, bitOffset: number, width: number, signed: boolean, next: number): number { if (value == null) { return next; } const units = __kain_bitfield_units(value) as Record<string, bigint>; const key = String(unitOffset); const unit = BigInt(units[key] ?? 0n); const safeWidth = BigInt(Math.max(width, 0)); const shift = BigInt(Math.max(bitOffset, 0)); const mask = safeWidth === 0n ? 0n : ((1n << safeWidth) - 1n); let encoded = BigInt(Math.trunc(Number(next))); if (safeWidth > 0n) { encoded &= mask; } const cleared = unit & ~(mask << shift); units[key] = cleared | ((encoded & mask) << shift); const normalized = __kain_bitfield_get(value, field, unitOffset, bitOffset, width, signed); return normalized; }")
        ()
        (*_self).writeln("function __kain_alloc(size: number, stride: number, _zeroed: boolean, seed: any): number { const step = Math.max(stride, 1); const count = Math.max(1, Math.ceil(Math.max(size, step) / step)); const base = __kainNextPtr; for (let i = 0; i < count; i++) { __kainMem.set(base + (i * step), __kain_clone_value(seed)); } __kainNextPtr = base + (count * step); return base; }")
        ()
        (*_self).writeln("function __kain_realloc(ptr: number, size: number, stride: number, seed: any): number { if (!ptr) { return __kain_alloc(size, stride, false, seed); } const step = Math.max(stride, 1); const count = Math.max(1, Math.ceil(Math.max(size, step) / step)); for (let i = 0; i < count; i++) { const nextPtr = ptr + (i * step); if (!__kainMem.has(nextPtr)) { __kainMem.set(nextPtr, __kain_clone_value(seed)); } } return ptr; }")
        ()
        (*_self).writeln("")
        ()
        if (*_self).needs_dom_types:
            (*_self).writeln("type KainNode = Node | DocumentFragment;")
            ()
            (*_self).writeln("")
            ()
            ()
            ()
            ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Function(f) =>
                    (*_self).gen_typed_function(f)
                    ()
                kain_core__types__TypedItem::Struct(s) =>
                    (*_self).gen_typed_struct(s)
                    ()
                kain_core__types__TypedItem::Enum(e) =>
                    (*_self).gen_typed_enum(e)
                    ()
                kain_core__types__TypedItem::Component(c) =>
                    (*_self).needs_dom_types = true
                    ()
                    (*_self).gen_typed_component(c)
                    ()
                    ()
                    ()
                    ()
                kain_core__types__TypedItem::Const(c) =>
                    (*_self).gen_const(&c.ast.name, Option::Some(&c.ast.ty), &c.ast.value)
                    ()
                kain_core__types__TypedItem::Impl(i) =>
                    (*_self).gen_impl(&i.ast)
                    ()
                _ => ()
            (*_self).writeln("")
            ()
        ()
        std__mem__take(&mut (*_self).output).build()

    fn gen_typed_function(_self: &mut TSGen, func: &kain_core::types::TypedFunction):
        let params = (*func).ast.params.iter().map(fn(p): f"{p.name}: {(*_self).type_to_ts(&p.ty)}").collect().join(", ")
        let ret = (*_self).function_return_ts(func)
        (*_self).writeln(&"export function {(*func).ast.name}({params}): {ret} {")
        ()
        (*_self).indent()
        ()
        (*_self).gen_block(&(*func).ast.body)
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()

    fn gen_typed_struct(_self: &mut TSGen, s: &kain_core::types::TypedStruct):
        if (*_self).seen_types.contains(&(*s).ast.name):
            return
        (*_self).seen_types.insert((*s).ast.name.clone())
        ()
        if (*s).ast.fields.is_empty():
            (*_self).writeln(&f"export type {(*s).ast.name} = Record<string, unknown>;")
            ()
            return
        (*_self).writeln(&"export interface {(*s).ast.name}Shape {")
        ()
        (*_self).indent()
        ()
        for field in &(*s).ast.fields:
            let ty = (*_self).type_to_ts(&field.ty)
            (*_self).writeln(&f"{field.name}: {ty};")
            ()
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()
        (*_self).writeln(&"export class {(*s).ast.name} implements {(*s).ast.name}Shape {")
        ()
        (*_self).indent()
        ()
        for field in &(*s).ast.fields:
            let ty = (*_self).type_to_ts(&field.ty)
            (*_self).writeln(&f"{field.name}: {ty};")
            ()
        ()
        (*_self).writeln("")
        ()
        let ctor_params = (*s).ast.fields.iter().map(fn(f): f"{f.name}: {(*_self).type_to_ts(&f.ty)}").collect().join(", ")
        let ctor_defaults = (*s).ast.fields.iter().map(fn(f): none).collect().join(", ")
        let _ = ctor_params
        (*_self).writeln(&"constructor({ctor_defaults}) {")
        ()
        (*_self).indent()
        ()
        for field in &(*s).ast.fields:
            (*_self).writeln(&f"this.{field.name} = {field.name};")
            ()
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()

    fn gen_typed_enum(_self: &mut TSGen, e: &kain_core::types::TypedEnum):
        if (*_self).seen_types.contains(&(*e).ast.name):
            return
        (*_self).seen_types.insert((*e).ast.name.clone())
        ()
        let mut union_members = Vec__new_()
        for variant in &(*e).ast.variants:
            match &variant.fields:
                kain_core__ast__VariantFields::Unit =>
                    union_members.push("{ type: '{(*e).ast.name}'; tag: '{variant.name}' }")
                    ()
                kain_core__ast__VariantFields::Tuple(types) =>
                    let fields = types.iter().enumerate().map(fn(__kain_closure_arg0): f"_{__kain_closure_arg0.__kain_tuple_0}: {(*_self).type_to_ts(__kain_closure_arg0.__kain_tuple_1)}").collect().join("; ")
                    union_members.push("{ type: '{(*e).ast.name}'; tag: '{variant.name}'; {fields} }")
                    ()
                kain_core__ast__VariantFields::Struct(fields) =>
                    let payload = fields.iter().map(fn(f): f"{f.name}: {(*_self).type_to_ts(&f.ty)}").collect().join("; ")
                    union_members.push("{ type: '{(*e).ast.name}'; tag: '{variant.name}'; {payload} }")
                    ()
        ()
        if union_members.is_empty():
            (*_self).writeln(&f"export type {(*e).ast.name} = never;")
            ()
            ()
            ()
            ()
        else:
            (*_self).writeln(&f"export type {(*e).ast.name} =")
            ()
            (*_self).indent()
            ()
            for selfhost_for_item in union_members.iter().enumerate():
                let (i, member) = selfhost_for_item
                if ((i + 1) == union_members.len()):
                    (*_self).writeln(&f"| {member};")
                    ()
                else:
                    (*_self).writeln(&f"| {member}")
                    ()
            ()
            (*_self).dedent()
            ()
            ()
            ()
            ()
        (*_self).writeln(&"export const {(*e).ast.name} = {")
        ()
        (*_self).indent()
        ()
        for variant in &(*e).ast.variants:
            match &variant.fields:
                kain_core__ast__VariantFields::Unit =>
                    (*_self).writeln(&"{variant.name}: (): {(*e).ast.name} => ({ type: '{(*e).ast.name}', tag: '{variant.name}' }),")
                    ()
                kain_core__ast__VariantFields::Tuple(types) =>
                    let params = types.iter().enumerate().map(fn(__kain_closure_arg1): f"_{__kain_closure_arg1.__kain_tuple_0}: {(*_self).type_to_ts(__kain_closure_arg1.__kain_tuple_1)}").collect().join(", ")
                    (*_self).writeln(&"{variant.name}: ({params}) : {(*e).ast.name} => ({")
                    ()
                    (*_self).indent()
                    ()
                    (*_self).writeln(&f"type: '{(*e).ast.name}',")
                    ()
                    (*_self).writeln(&f"tag: '{variant.name}',")
                    ()
                    for i in range(0, types.len()):
                        (*_self).writeln(&f"_{i}: _{i},")
                        ()
                    ()
                    (*_self).dedent()
                    ()
                    (*_self).writeln("}),")
                    ()
                kain_core__ast__VariantFields::Struct(fields) =>
                    let params = fields.iter().map(fn(f): f"{f.name}: {(*_self).type_to_ts(&f.ty)}").collect().join(", ")
                    (*_self).writeln(&"{variant.name}: ({params}) : {(*e).ast.name} => ({")
                    ()
                    (*_self).indent()
                    ()
                    (*_self).writeln(&f"type: '{(*e).ast.name}',")
                    ()
                    (*_self).writeln(&f"tag: '{variant.name}',")
                    ()
                    for field in fields:
                        (*_self).writeln(&f"{field.name}: {field.name},")
                        ()
                    ()
                    (*_self).dedent()
                    ()
                    (*_self).writeln("}),")
                    ()
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("} as const;")
        ()

    fn gen_typed_component(_self: &mut TSGen, comp: &kain_core::types::TypedComponent):
        let props_name = f"{(*comp).ast.name}Props"
        (*_self).writeln(&"export interface {props_name} {")
        ()
        (*_self).indent()
        ()
        for prop in &(*comp).ast.props:
            (*_self).writeln(&f"{prop.name}: {(*_self).type_to_ts(&prop.ty)};")
            ()
        ()
        (*_self).writeln("children?: KainNode[];")
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()
        (*_self).writeln(&"export function {(*comp).ast.name}(props: {props_name}): KainNode {")
        ()
        (*_self).indent()
        ()
        if (!(*comp).ast.props.is_empty()):
            let names = (*comp).ast.props.iter().map(fn(p): p.name.clone()).collect().join(", ")
            (*_self).writeln(&"const { {names}, children = [] } = props;")
            ()
            ()
            ()
            ()
        else:
            (*_self).writeln("const { children = [] } = props;")
            ()
            ()
            ()
            ()
        for state_ in &(*comp).ast.state_:
            (*_self).write(&f"let {state_.name}: {(*_self).type_to_ts(&state_.ty)} = ")
            ()
            (*_self).gen_expr(&state_.initial)
            ()
            (*_self).writeln(";")
            ()
        ()
        for method in &(*comp).ast.methods:
            (*_self).gen_function(method)
            ()
        ()
        (*_self).write("return ")
        ()
        (*_self).gen_jsx(&(*comp).ast.body)
        ()
        (*_self).writeln(";")
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()

    fn gen_function(_self: &mut TSGen, func: &kain_core::ast::Function):
        let params = (*func).params.iter().map(fn(p): f"{p.name}: {(*_self).type_to_ts(&p.ty)}").collect().join(", ")
        let ret = (*func).return_type.map(fn(t): (*_self).type_to_ts(t)).unwrap_or_else(fn(): ("void").to_string())
        (*_self).writeln(&"function {(*func).name}({params}): {ret} {")
        ()
        (*_self).indent()
        ()
        (*_self).gen_block(&(*func).body)
        ()
        (*_self).dedent()
        ()
        (*_self).writeln("}")
        ()

    fn gen_const(_self: &mut TSGen, name: String, ty: Option<&kain_core::ast::Type>, value: &kain_core::ast::Expr):
        match ty:
            Some(ty) =>
                (*_self).write(&f"export const {name}: {(*_self).type_to_ts(ty)} = ")
                ()
                ()
                ()
                ()
            _ =>
                (*_self).write(&f"export const {name} = ")
                ()
                ()
                ()
                ()
        (*_self).gen_expr(value)
        ()
        (*_self).writeln(";")
        ()

    fn gen_impl(_self: &mut TSGen, impl_block: &kain_core::ast::Impl):
        match &(*impl_block).target_type:
            kain_core__ast__Type::Named { name: name } =>
                for method in &(*impl_block).methods:
                    let has_self = method.params.first().map(fn(p): (p.name == "self")).unwrap_or(false)
                    let params = method.params.iter().skip(if has_self: 1 else: 0).map(fn(p): f"{p.name}: {(*_self).type_to_ts(&p.ty)}").collect().join(", ")
                    let ret = method.return_type.map(fn(t): (*_self).type_to_ts(t)).unwrap_or_else(fn(): ("void").to_string())
                    if has_self:
                        (*_self).writeln(&"{name}.prototype.{method.name} = function({params}): {ret} {")
                        ()
                        ()
                        ()
                        ()
                    else:
                        (*_self).writeln(&"{name}.{method.name} = function({params}): {ret} {")
                        ()
                        ()
                        ()
                        ()
                    (*_self).indent()
                    ()
                    (*_self).gen_block(&method.body)
                    ()
                    (*_self).dedent()
                    ()
                    (*_self).writeln("};")
                    ()
            _ => ()

    fn gen_block(_self: &mut TSGen, block: &kain_core::ast::Block):
        for stmt in &(*block).stmts:
            (*_self).gen_stmt(stmt)
            ()

    fn gen_stmt(_self: &mut TSGen, stmt: &kain_core::ast::Stmt):
        match stmt:
            kain_core__ast__Stmt::Expr(expr) =>
                (*_self).gen_expr(expr)
                ()
                (*_self).writeln(";")
                ()
            kain_core__ast__Stmt::Let { pattern: pattern, ty: ty, value: value } =>
                match pattern:
                    kain_core__ast__Pattern::Binding { name: name } =>
                        (*_self).write(&f"let {name}")
                        ()
                        match ty:
                            Some(t) =>
                                (*_self).write(&f": {(*_self).type_to_ts(t)}")
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(" = ")
                        ()
                        match value:
                            Some(v) =>
                                (*_self).gen_expr(v)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                (*_self).write("null")
                                ()
                                ()
                                ()
                                ()
                        (*_self).writeln(";")
                        ()
                    _ => ()
            kain_core__ast__Stmt::Return(expr, _) =>
                (*_self).write("return")
                ()
                match expr:
                    Some(e) =>
                        (*_self).write(" ")
                        ()
                        (*_self).gen_expr(e)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).writeln(";")
                ()
            kain_core__ast__Stmt::For { binding: binding, iter: iter, body: body } =>
                match binding:
                    kain_core__ast__Pattern::Binding { name: name } =>
                        (*_self).write(&f"for (const {name} of ")
                        ()
                        (*_self).gen_expr(iter)
                        ()
                        (*_self).writeln(") {")
                        ()
                        (*_self).indent()
                        ()
                        (*_self).gen_block(body)
                        ()
                        (*_self).dedent()
                        ()
                        (*_self).writeln("}")
                        ()
                    _ => ()
            kain_core__ast__Stmt::While { condition: condition, body: body } =>
                (*_self).write("while (")
                ()
                (*_self).gen_expr(condition)
                ()
                (*_self).writeln(") {")
                ()
                (*_self).indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).dedent()
                ()
                (*_self).writeln("}")
                ()
            kain_core__ast__Stmt::Loop { body: body } =>
                (*_self).writeln("while (true) {")
                ()
                (*_self).indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).dedent()
                ()
                (*_self).writeln("}")
                ()
            kain_core__ast__Stmt::Break(expr, _) =>
                if expr.is_some():
                    (*_self).writeln("// break with value is not representable in TypeScript")
                    ()
                    ()
                    ()
                    ()
                (*_self).writeln("break;")
                ()
            kain_core__ast__Stmt::Continue(_) =>
                (*_self).writeln("continue;")
                ()
            kain_core__ast__Stmt::Expr(kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch }) if false =>
                (*_self).write("if (")
                ()
                (*_self).gen_expr(condition)
                ()
                (*_self).writeln(") {")
                ()
                (*_self).indent()
                ()
                (*_self).gen_block(then_branch)
                ()
                (*_self).dedent()
                ()
                let mut cur = else_branch
                loop:
                    match cur:
                        Some(branch) =>
                            match branch:
                                kain_core__ast__ElseBranch::Else(b) =>
                                    (*_self).writeln("} else {")
                                    ()
                                    (*_self).indent()
                                    ()
                                    (*_self).gen_block(b)
                                    ()
                                    (*_self).dedent()
                                    ()
                                    cur = none
                                    ()
                                kain_core__ast__ElseBranch::ElseIf(cond, body, next) =>
                                    (*_self).write("} else if (")
                                    ()
                                    (*_self).gen_expr(cond)
                                    ()
                                    (*_self).writeln(") {")
                                    ()
                                    (*_self).indent()
                                    ()
                                    (*_self).gen_block(body)
                                    ()
                                    (*_self).dedent()
                                    ()
                                    cur = next
                                    ()
                        _ => break
                ()
                (*_self).writeln("}")
                ()
            kain_core__ast__Stmt::Item(_) => ()
            _ =>
                (*_self).writeln("// Unsupported statement")
                ()

    fn gen_expr(_self: &mut TSGen, expr: &kain_core::ast::Expr):
        match expr:
            kain_core__ast__Expr::Int(n, _) => (*_self).write(&n.to_string())
            kain_core__ast__Expr::Float(f, _) => (*_self).write(&f.to_string())
            kain_core__ast__Expr::String(s, _) =>
                let escaped = s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
                (*_self).write(&f"\"{escaped}\"")
            kain_core__ast__Expr::Bool(b, _) => (*_self).write(if (*b): "true" else: "false")
            kain_core__ast__Expr::None(_) => (*_self).write("null")
            kain_core__ast__Expr::Ident(name, _) => (*_self).write(name)
            kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
                (*_self).write("(")
                ()
                (*_self).gen_expr(left)
                ()
                (*_self).write(&f" {(*_self).gen_binop((*op))} ")
                ()
                (*_self).gen_expr(right)
                ()
                (*_self).write(")")
                ()
            kain_core__ast__Expr::Unary { op: op, operand: operand } =>
                (*_self).write(&f"({(*_self).gen_unop((*op))}")
                ()
                (*_self).gen_expr(operand)
                ()
                (*_self).write(")")
                ()
            kain_core__ast__Expr::Ref { value: value } =>
                (*_self).gen_expr(value)
                ()
            kain_core__ast__Expr::Deref(inner, _) =>
                (*_self).gen_expr(inner)
                ()
            kain_core__ast__Expr::PtrOffset { pointer: pointer } =>
                (*_self).gen_expr(pointer)
                ()
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                (*_self).gen_expr(callee)
                ()
                (*_self).write("(")
                ()
                for selfhost_for_item in args.iter().enumerate():
                    let (i, arg) = selfhost_for_item
                    if (i > 0):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).gen_expr(&arg.value)
                    ()
                ()
                (*_self).write(")")
                ()
            kain_core__ast__Expr::Array(elements, _) =>
                (*_self).write("[")
                ()
                for selfhost_for_item in elements.iter().enumerate():
                    let (i, elem) = selfhost_for_item
                    if (i > 0):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).gen_expr(elem)
                    ()
                ()
                (*_self).write("]")
                ()
            kain_core__ast__Expr::Tuple(elements, _) =>
                (*_self).write("[")
                ()
                for selfhost_for_item in elements.iter().enumerate():
                    let (i, elem) = selfhost_for_item
                    if (i > 0):
                        (*_self).write(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).gen_expr(elem)
                    ()
                ()
                (*_self).write("]")
                ()
            kain_core__ast__Expr::Index { object: object, index: index } =>
                (*_self).gen_expr(object)
                ()
                (*_self).write("[")
                ()
                (*_self).gen_expr(index)
                ()
                (*_self).write("]")
                ()
            kain_core__ast__Expr::Field { object: object, field: field } =>
                (*_self).gen_expr(object)
                ()
                (*_self).write(&f".{field}")
                ()
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                match method.as_str():
                    "len" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".length")
                        ()
                        return
                    "is_empty" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".length === 0")
                        ()
                        return
                    "first" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write("[0]")
                        ()
                        return
                    "last" =>
                        (*_self).write("(() => { const __arr = ")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write("; return __arr[__arr.length - 1]; })()")
                        ()
                        return
                    "contains" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".includes(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "push" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".push(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, arg) = selfhost_for_item
                            if (i > 0):
                                (*_self).write(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).gen_expr(&arg.value)
                            ()
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "pop" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".pop()")
                        ()
                        return
                    "clear" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".length = 0")
                        ()
                        return
                    "to_string" =>
                        (*_self).write("String(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "to_owned" =>
                        (*_self).write("String(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "to_uppercase" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".toUpperCase()")
                        ()
                        return
                    "to_lowercase" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".toLowerCase()")
                        ()
                        return
                    "trim" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".trim()")
                        ()
                        return
                    "split" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".split(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "join" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".join(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "starts_with" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".startsWith(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "ends_with" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".endsWith(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "replace" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".replaceAll(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, arg) = selfhost_for_item
                            if (i > 0):
                                (*_self).write(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).gen_expr(&arg.value)
                            ()
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "chars" =>
                        (*_self).write("Array.from(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "bytes" =>
                        (*_self).write("Array.from(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "map" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".map(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "filter" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".filter(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "filter_map" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".flatMap(__x => { const __v = (")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")(__x); return __v != null ? [__v] : []; })")
                        ()
                        return
                    "reduce" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".reduce(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, arg) = selfhost_for_item
                            if (i > 0):
                                (*_self).write(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).gen_expr(&arg.value)
                            ()
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "fold" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".reduce(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, arg) = selfhost_for_item
                            if (i > 0):
                                (*_self).write(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).gen_expr(&arg.value)
                            ()
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "find" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".find(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(") ?? null")
                        ()
                        return
                    "any" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".some(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "all" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".every(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "enumerate" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".map((__v, __i) => [__i, __v] as [number, typeof __v])")
                        ()
                        return
                    "zip" =>
                        (*_self).write("(() => { const __a = ")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write("; const __b = ")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write("; return __a.map((__v, __i) => [__v, __b[__i]]); })()")
                        ()
                        return
                    "flat_map" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".flat()")
                        ()
                        return
                    "flatten" =>
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(".flat()")
                        ()
                        return
                    "clamp" =>
                        (*_self).write("Math.min(Math.max(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        match args.first():
                            Some(min_arg) =>
                                (*_self).write(", ")
                                ()
                                (*_self).gen_expr(&min_arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write("), ")
                        ()
                        match args.get(1):
                            Some(max_arg) =>
                                (*_self).gen_expr(&max_arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "abs" =>
                        (*_self).write("Math.abs(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "sqrt" =>
                        (*_self).write("Math.sqrt(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "floor" =>
                        (*_self).write("Math.floor(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "ceil" =>
                        (*_self).write("Math.ceil(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "round" =>
                        (*_self).write("Math.round(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "min" =>
                        (*_self).write("Math.min(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).write(", ")
                                ()
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "max" =>
                        (*_self).write("Math.max(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).write(", ")
                                ()
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "unwrap" =>
                        (*_self).write("((")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(") ?? (() => { throw new Error('KAIN: unwrap on null/None'); })())")
                        ()
                        return
                    "unwrap_or_default" =>
                        (*_self).write("((")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(") ?? (() => { throw new Error('KAIN: unwrap on null/None'); })())")
                        ()
                        return
                    "unwrap_or" =>
                        (*_self).write("((")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(") ?? ")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "ok" =>
                        (*_self).write("(({ ok: true, value: ")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(" }))")
                        ()
                        return
                    "is_some" =>
                        (*_self).write("((")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(") != null)")
                        ()
                        return
                    "is_ok" =>
                        (*_self).write("((")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(") != null)")
                        ()
                        return
                    "is_none" =>
                        (*_self).write("((")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(") == null)")
                        ()
                        return
                    "is_err" =>
                        (*_self).write("((")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(") == null)")
                        ()
                        return
                    "sort" =>
                        (*_self).write("[...")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write("].sort()")
                        ()
                        return
                    "sort_by" =>
                        (*_self).write("[...")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write("].sort(")
                        ()
                        match args.first():
                            Some(arg) =>
                                (*_self).gen_expr(&arg.value)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        (*_self).write(")")
                        ()
                        return
                    "reverse" =>
                        (*_self).write("[...")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write("].reverse()")
                        ()
                        return
                    "collect" =>
                        (*_self).write("Array.from(")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write(")")
                        ()
                        return
                    "iter" =>
                        (*_self).gen_expr(receiver)
                        ()
                        return
                    "into_iter" =>
                        (*_self).gen_expr(receiver)
                        ()
                        return
                    "iter_mut" =>
                        (*_self).gen_expr(receiver)
                        ()
                        return
                    "clone" =>
                        (*_self).write("[...")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write("]")
                        ()
                        return
                    "to_vec" =>
                        (*_self).write("[...")
                        ()
                        (*_self).gen_expr(receiver)
                        ()
                        (*_self).write("]")
                        ()
                        return
                    "get" =>
