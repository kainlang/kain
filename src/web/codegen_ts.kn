                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).writeln("const __frag = document.createDocumentFragment();")
                ()
                (*_self).write(&f"for (const {binding} of ")
                ()
                (*_self).gen_expr(iter)
                ()
                (*_self).writeln(") {")
                ()
                (*_self).indent()
                ()
                (*_self).write("__frag.appendChild(")
                ()
                (*_self).gen_jsx(body)
                ()
                (*_self).writeln(");")
                ()
                (*_self).dedent()
                ()
                (*_self).writeln("}")
                ()
                (*_self).writeln("return __frag;")
                ()
                (*_self).dedent()
                ()
                (*_self).write("})()")
                ()
            kain_core__ast__JSXNode::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                (*_self).write("(() => {")
                ()
                (*_self).indent()
                ()
                (*_self).writeln("")
                ()
                (*_self).write("if (")
                ()
                (*_self).gen_expr(condition)
                ()
                (*_self).writeln(") {")
                ()
                (*_self).indent()
                ()
                (*_self).write("return ")
                ()
                (*_self).gen_jsx(then_branch)
                ()
                (*_self).writeln(";")
                ()
                (*_self).dedent()
                ()
                match else_branch:
                    Some(else_node) =>
                        (*_self).writeln("} else {")
                        ()
                        (*_self).indent()
                        ()
                        (*_self).write("return ")
                        ()
                        (*_self).gen_jsx(else_node)
                        ()
                        (*_self).writeln(";")
                        ()
                        (*_self).dedent()
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                (*_self).writeln("}")
                ()
                (*_self).writeln("return document.createTextNode('');")
                ()
                (*_self).dedent()
                ()
                (*_self).write("})()")
                ()

    fn gen_block_as_expr(_self: &mut TSGen, block: &kain_core::ast::Block):
        (*_self).write("(() => {")
        ()
        (*_self).indent()
        ()
        (*_self).writeln("")
        ()
        (*_self).gen_block(block)
        ()
        (*_self).dedent()
        ()
        (*_self).write("})()")
        ()

    fn gen_pattern_match(_self: &mut TSGen, scrutinee: String, pattern: &kain_core::ast::Pattern):
        match pattern:
            kain_core__ast__Pattern::Wildcard(_) => (*_self).write("true")
            kain_core__ast__Pattern::Binding {  } => (*_self).write("true")
            kain_core__ast__Pattern::Literal(expr) =>
                (*_self).write(&f"{scrutinee} === ")
                ()
                (*_self).gen_expr(expr)
                ()
            kain_core__ast__Pattern::Variant { enum_name: enum_name, variant: variant, fields: fields } =>
                match enum_name:
                    Some(enum_name) =>
                        (*_self).write(&f"{scrutinee}.type === '{enum_name}' && {scrutinee}.tag === '{variant}'")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        (*_self).write(&f"{scrutinee}.tag === '{variant}'")
                        ()
                        ()
                        ()
                        ()
                match fields:
                    kain_core__ast__VariantPatternFields::Tuple(patterns) =>
                        for selfhost_for_item in patterns.iter().enumerate():
                            let (i, _) = selfhost_for_item
                            (*_self).write(&f" && typeof {scrutinee}._{i} !== 'undefined'")
                            ()
                    _ => ()
            _ => (*_self).write("false")

    fn gen_pattern_bindings(_self: &mut TSGen, scrutinee: String, pattern: &kain_core::ast::Pattern):
        match pattern:
            kain_core__ast__Pattern::Binding { name: name } =>
                (*_self).writeln(&f"const {name} = {scrutinee};")
                ()
            _ => ()

    fn gen_binop(_self: &TSGen, op: kain_core::ast::BinaryOp) -> String:
        match op:
            kain_core__ast__BinaryOp::Add => "+"
            kain_core__ast__BinaryOp::Sub => "-"
            kain_core__ast__BinaryOp::Mul => "*"
            kain_core__ast__BinaryOp::Div => "/"
            kain_core__ast__BinaryOp::Mod => "%"
            kain_core__ast__BinaryOp::Pow => "**"
            kain_core__ast__BinaryOp::Eq => "==="
            kain_core__ast__BinaryOp::Ne => "!=="
            kain_core__ast__BinaryOp::Lt => "<"
            kain_core__ast__BinaryOp::Le => "<="
            kain_core__ast__BinaryOp::Gt => ">"
            kain_core__ast__BinaryOp::Ge => ">="
            kain_core__ast__BinaryOp::And => "&&"
            kain_core__ast__BinaryOp::Or => "||"
            kain_core__ast__BinaryOp::BitAnd => "&"
            kain_core__ast__BinaryOp::BitOr => "|"
            kain_core__ast__BinaryOp::BitXor => "^"
            kain_core__ast__BinaryOp::Shl => "<<"
            kain_core__ast__BinaryOp::Shr => ">>"
            kain_core__ast__BinaryOp::Assign => "="
            kain_core__ast__BinaryOp::AddAssign => "+="
            kain_core__ast__BinaryOp::SubAssign => "-="
            kain_core__ast__BinaryOp::MulAssign => "*="
            kain_core__ast__BinaryOp::DivAssign => "/="
            kain_core__ast__BinaryOp::Range => "/* range */"
            kain_core__ast__BinaryOp::RangeInclusive => "/* range */"

    fn gen_unop(_self: &TSGen, op: kain_core::ast::UnaryOp) -> String:
        match op:
            kain_core__ast__UnaryOp::Neg => "-"
            kain_core__ast__UnaryOp::Not => "!"
            kain_core__ast__UnaryOp::BitNot => "~"
            kain_core__ast__UnaryOp::Ref => ""
            kain_core__ast__UnaryOp::RefMut => ""
            kain_core__ast__UnaryOp::Deref => ""

    fn function_return_ts(_self: &TSGen, func: &kain_core::types::TypedFunction) -> String:
        match &(*func).ast.return_type:
            Some(ret) => return (*_self).type_to_ts(ret)
            _ =>
                ()
                ()
        match &(*func).resolved_type:
            kain_core__types__ResolvedType::Function { ret: ret } => return (*_self).resolved_type_to_ts(ret)
            _ =>
                ()
                ()
        ("void").to_string()

    fn type_to_ts(_self: &TSGen, ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                let base = match name.as_str():
                    "Int" => ("number").to_string()
                    "Float" => ("number").to_string()
                    "i8" => ("number").to_string()
                    "i16" => ("number").to_string()
                    "i32" => ("number").to_string()
                    "i64" => ("number").to_string()
                    "i128" => ("number").to_string()
                    "isize" => ("number").to_string()
                    "u8" => ("number").to_string()
                    "u16" => ("number").to_string()
                    "u32" => ("number").to_string()
                    "u64" => ("number").to_string()
                    "u128" => ("number").to_string()
                    "usize" => ("number").to_string()
                    "f32" => ("number").to_string()
                    "f64" => ("number").to_string()
                    "Bool" => ("boolean").to_string()
                    "String" => ("string").to_string()
                    "str" => ("string").to_string()
                    "Char" => ("string").to_string()
                    "Unit" => ("void").to_string()
                    "Vec2" => ("[number, number]").to_string()
                    "Vec3" => ("[number, number, number]").to_string()
                    _ => name.clone()
                if generics.is_empty():
                    base
                else:
                    let gs = generics.iter().map(fn(g): (*_self).type_to_ts(g)).collect().join(", ")
                    f"{base}<{gs}>"
            kain_core__ast__Type::Tuple(types, _) =>
                let inner = types.iter().map(fn(t): (*_self).type_to_ts(t)).collect().join(", ")
                f"[{inner}]"
            kain_core__ast__Type::Array(inner, _, _) => f"Array<{(*_self).type_to_ts(inner)}>"
            kain_core__ast__Type::Slice(inner, _) => f"Array<{(*_self).type_to_ts(inner)}>"
            kain_core__ast__Type::Ref { inner: inner } => (*_self).type_to_ts(inner)
            kain_core__ast__Type::Ptr { inner: inner } => (*_self).type_to_ts(inner)
            kain_core__ast__Type::Function { params: params, return_type: return_type } =>
                let params = params.iter().enumerate().map(fn(__kain_closure_arg2): f"arg{__kain_closure_arg2.__kain_tuple_0}: {(*_self).type_to_ts(__kain_closure_arg2.__kain_tuple_1)}").collect().join(", ")
                f"({params}) => {(*_self).type_to_ts(return_type)}"
            kain_core__ast__Type::Option(inner, _) => f"{(*_self).type_to_ts(inner)} | null"
            kain_core__ast__Type::Result(ok, err, _) =>
                let ok_t = (*_self).type_to_ts(ok)
                let err_t = (*_self).type_to_ts(err)
                "{ ok: true; value: {ok_t} } | { ok: false; error: {err_t} }"
            kain_core__ast__Type::Infer(_) => ("unknown").to_string()
            kain_core__ast__Type::Impl {  } => ("unknown").to_string()
            kain_core__ast__Type::Never(_) => ("never").to_string()
            kain_core__ast__Type::Unit(_) => ("void").to_string()

    fn resolved_type_to_ts(_self: &TSGen, ty: &kain_core::types::ResolvedType) -> String:
        match ty:
            kain_core__types__ResolvedType::Unit => ("void").to_string()
            kain_core__types__ResolvedType::Bool => ("boolean").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::I64) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::I32) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::I16) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::I8) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::I128) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::Isize) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::U64) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::U32) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::U16) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::U8) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::U128) => ("number").to_string()
            kain_core__types__ResolvedType::Int(kain_core__types__IntSize::Usize) => ("number").to_string()
            kain_core__types__ResolvedType::Float(kain_core__types__FloatSize::F32) => ("number").to_string()
            kain_core__types__ResolvedType::Float(kain_core__types__FloatSize::F64) => ("number").to_string()
            kain_core__types__ResolvedType::String => ("string").to_string()
            kain_core__types__ResolvedType::Char => ("string").to_string()
            kain_core__types__ResolvedType::Array(inner, _) => f"Array<{(*_self).resolved_type_to_ts(inner)}>"
            kain_core__types__ResolvedType::Slice(inner) => f"Array<{(*_self).resolved_type_to_ts(inner)}>"
            kain_core__types__ResolvedType::Tuple(inner) =>
                let s = inner.iter().map(fn(t): (*_self).resolved_type_to_ts(t)).collect().join(", ")
                f"[{s}]"
            kain_core__types__ResolvedType::Option(inner) => f"{(*_self).resolved_type_to_ts(inner)} | null"
            kain_core__types__ResolvedType::Result(ok, err) =>
                let ok_t = (*_self).resolved_type_to_ts(ok)
                let err_t = (*_self).resolved_type_to_ts(err)
                "{ ok: true; value: {ok_t} } | { ok: false; error: {err_t} }"
            kain_core__types__ResolvedType::Future(inner) => f"Promise<{(*_self).resolved_type_to_ts(inner)}>"
            kain_core__types__ResolvedType::Ref { inner: inner } => (*_self).resolved_type_to_ts(inner)
            kain_core__types__ResolvedType::Ptr { inner: inner } => (*_self).resolved_type_to_ts(inner)
            kain_core__types__ResolvedType::Function { params: params, ret: ret } =>
                let ps = params.iter().enumerate().map(fn(__kain_closure_arg3): f"arg{__kain_closure_arg3.__kain_tuple_0}: {(*_self).resolved_type_to_ts(__kain_closure_arg3.__kain_tuple_1)}").collect().join(", ")
                f"({ps}) => {(*_self).resolved_type_to_ts(ret)}"
            kain_core__types__ResolvedType::Struct(name, _) => name.clone()
            kain_core__types__ResolvedType::Enum(name, _) => name.clone()
            kain_core__types__ResolvedType::Generic(name) => name.clone()
            kain_core__types__ResolvedType::Never => ("never").to_string()
            kain_core__types__ResolvedType::Unknown => ("unknown").to_string()


