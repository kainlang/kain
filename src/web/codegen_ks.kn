use kain_core::ast::BinaryOp

use kain_core::ast::Block

use kain_core::ast::ElseBranch

use kain_core::ast::EnumVariantFields

use kain_core::ast::Expr

use kain_core::ast::JSXAttrValue

use kain_core::ast::JSXNode

use kain_core::ast::Pattern

use kain_core::ast::Stmt

use kain_core::ast::Type

use kain_core::ast::UnaryOp

use kain_core::ast::VariantFields

use kain_core::error::KainResult

use kain_core::types::ResolvedType

use kain_core::types::TypedComponent

use kain_core::types::TypedEnum

use kain_core::types::TypedFunction

use kain_core::types::TypedItem

use kain_core::types::TypedProgram

use kain_core::types::TypedStruct

use std::collections::HashSet

@doc(doc = " Generate KainScript source from a typed program.")
pub fn generate(program: &kain_core::types::TypedProgram) -> Result<String, KainError>:
    let mut gen = KsGen__new_()
    Result::Ok(gen.gen_program(program))

@derive(Default)
struct Lines:
    field_0: Array<String>

impl Default for Lines:
    pub fn default_() -> Lines:
        Lines { field_0: Vec__new_() }


impl Lines:
    fn push(_self: &mut Lines, s: impl Into<String>):
        (*_self).field_0.push(s.into())
        ()

    fn build(_self: Lines) -> String:
        _self.field_0.join("\n")


struct KsGen:
    out_: Lines
    indent: usize
    seen_types: Set<String>
    needs_dom: Bool

impl KsGen:
    fn new_() -> KsGen:
        KsGen { out_: Lines__default_(), indent: 0, seen_types: HashSet__new_(), needs_dom: false }

    fn line_(_self: &mut KsGen, s: impl Into<String>):
        let prefix = ("  ").repeat((*_self).indent)
        (*_self).out_.push(f"{prefix}{s.into()}")
        ()

    fn blank(_self: &mut KsGen):
        (*_self).out_.push(String__new_())
        ()

    fn indent(_self: &mut KsGen):
        (*_self).indent = ((*_self).indent + 1)
        ()

    fn dedent(_self: &mut KsGen):
        if ((*_self).indent > 0):
            (*_self).indent = ((*_self).indent - 1)
            ()

    fn type_jsdoc(_self: &KsGen, ty: &kain_core::ast::Type) -> String:
        match ty:
            kain_core__ast__Type::Named { name: name, generics: generics } =>
                let base = match name.as_str():
                    "Int" => ("number").to_string()
                    "i8" => ("number").to_string()
                    "i16" => ("number").to_string()
                    "i32" => ("number").to_string()
                    "i64" => ("number").to_string()
                    "i128" => ("number").to_string()
                    "isize" => ("number").to_string()
                    "u8" => ("number").to_string()
                    "u16" => ("number").to_string()
                    "u32" => ("number").to_string()
                    "u64" => ("number").to_string()
                    "u128" => ("number").to_string()
                    "usize" => ("number").to_string()
                    "f32" => ("number").to_string()
                    "f64" => ("number").to_string()
                    "Float" => ("number").to_string()
                    "Bool" => ("boolean").to_string()
                    "String" => ("string").to_string()
                    "str" => ("string").to_string()
                    "Char" => ("string").to_string()
                    "Unit" => ("void").to_string()
                    "Vec2" => ("[number, number]").to_string()
                    "Vec3" => ("[number, number, number]").to_string()
                    "Vec4" => ("[number, number, number, number]").to_string()
                    other => other.to_string()
                if generics.is_empty():
                    base
                else:
                    let gs = generics.iter().map(fn(g): (*_self).type_jsdoc(g)).collect().join(", ")
                    match base.as_str():
                        "Array" => f"{(*_self).type_jsdoc(&generics[0])}[]"
                        "Vec" => f"{(*_self).type_jsdoc(&generics[0])}[]"
                        "Map" if (generics.len() == 2) => f"Map<{(*_self).type_jsdoc(&generics[0])}, {(*_self).type_jsdoc(&generics[1])}>"
                        "HashMap" if (generics.len() == 2) => f"Map<{(*_self).type_jsdoc(&generics[0])}, {(*_self).type_jsdoc(&generics[1])}>"
                        "Set" if (!generics.is_empty()) => f"Set<{(*_self).type_jsdoc(&generics[0])}>"
                        "HashSet" if (!generics.is_empty()) => f"Set<{(*_self).type_jsdoc(&generics[0])}>"
                        _ => f"{base}<{gs}>"
            kain_core__ast__Type::Array(inner, _, _) => f"{(*_self).type_jsdoc(inner)}[]"
            kain_core__ast__Type::Slice(inner, _) => f"{(*_self).type_jsdoc(inner)}[]"
            kain_core__ast__Type::Tuple(types, _) =>
                let inner = types.iter().map(fn(t): (*_self).type_jsdoc(t)).collect().join(", ")
                f"[{inner}]"
            kain_core__ast__Type::Ref { inner: inner } => (*_self).type_jsdoc(inner)
            kain_core__ast__Type::Function { params: params, return_type: return_type } =>
                let ps = params.iter().enumerate().map(fn(__kain_closure_arg0): f"arg{__kain_closure_arg0.__kain_tuple_0}: {(*_self).type_jsdoc(__kain_closure_arg0.__kain_tuple_1)}").collect().join(", ")
                f"function({ps}): {(*_self).type_jsdoc(return_type)}"
            kain_core__ast__Type::Option(inner, _) => f"{(*_self).type_jsdoc(inner)} | null | undefined"
            kain_core__ast__Type::Result(ok, err, _) => "{ ok: true, value: {(*_self).type_jsdoc(ok)} } | { ok: false, error: {(*_self).type_jsdoc(err)} }"
            kain_core__ast__Type::Never(_) => ("never").to_string()
            kain_core__ast__Type::Unit(_) => ("void").to_string()
            kain_core__ast__Type::Infer(_) => ("*").to_string()
            kain_core__ast__Type::Impl {  } => ("*").to_string()
            kain_core__ast__Type::Ptr { inner: inner } => (*_self).type_jsdoc(inner)

    fn resolved_jsdoc(_self: &KsGen, ty: &kain_core::types::ResolvedType) -> String:
        match ty:
            kain_core__types__ResolvedType::Unit => ("void").to_string()
            kain_core__types__ResolvedType::Bool => ("boolean").to_string()
            kain_core__types__ResolvedType::Int(_) => ("number").to_string()
            kain_core__types__ResolvedType::Float(_) => ("number").to_string()
            kain_core__types__ResolvedType::String => ("string").to_string()
            kain_core__types__ResolvedType::Char => ("string").to_string()
            kain_core__types__ResolvedType::Array(inner, _) => f"{(*_self).resolved_jsdoc(inner)}[]"
            kain_core__types__ResolvedType::Slice(inner) => f"{(*_self).resolved_jsdoc(inner)}[]"
            kain_core__types__ResolvedType::Tuple(inner) =>
                let s = inner.iter().map(fn(t): (*_self).resolved_jsdoc(t)).collect().join(", ")
                f"[{s}]"
            kain_core__types__ResolvedType::Option(inner) => f"{(*_self).resolved_jsdoc(inner)} | null | undefined"
            kain_core__types__ResolvedType::Result(ok, err) => "{ ok: true, value: {(*_self).resolved_jsdoc(ok)} } | { ok: false, error: {(*_self).resolved_jsdoc(err)} }"
            kain_core__types__ResolvedType::Future(inner) => f"Promise<{(*_self).resolved_jsdoc(inner)}>"
            kain_core__types__ResolvedType::Ref { inner: inner } => (*_self).resolved_jsdoc(inner)
            kain_core__types__ResolvedType::Struct(name, _) => name.clone()
            kain_core__types__ResolvedType::Enum(name, _) => name.clone()
            kain_core__types__ResolvedType::Generic(name) => name.clone()
            kain_core__types__ResolvedType::Function { params: params, ret: ret } =>
                let ps = params.iter().enumerate().map(fn(__kain_closure_arg1): f"arg{__kain_closure_arg1.__kain_tuple_0}: {(*_self).resolved_jsdoc(__kain_closure_arg1.__kain_tuple_1)}").collect().join(", ")
                f"function({ps}): {(*_self).resolved_jsdoc(ret)}"
            kain_core__types__ResolvedType::Never => ("never").to_string()
            kain_core__types__ResolvedType::Unknown => ("*").to_string()
            kain_core__types__ResolvedType::Ptr { inner: inner } => (*_self).resolved_jsdoc(inner)

    fn gen_program(_self: &mut KsGen, program: &kain_core::types::TypedProgram) -> String:
        for item in &(*program).items:
            if (none):
                (*_self).needs_dom = true
                ()
                break
        ()
        (*_self).out_.push(("// @ts-check").to_string())
        ()
        (*_self).out_.push(("// Generated by KAIN compiler — KainScript target (.ks)").to_string())
        ()
        (*_self).out_.push(("// Runs natively in Node.js, Deno, Bun, and browsers. No compilation needed.").to_string())
        ()
        (*_self).out_.push(("// Full type checking: tsc --checkJs --noEmit file.ks").to_string())
        ()
        (*_self).out_.push(("/* eslint-disable */").to_string())
        ()
        (*_self).blank()
        ()
        (*_self).out_.push(("// ── Numeric type coercion helpers ─────────────────────────────────────────").to_string())
        ()
        (*_self).out_.push(("/** @param {number} n @returns {number} */ function u8(n)  { return n & 0xFF; }").to_string())
        ()
        (*_self).out_.push(("/** @param {number} n @returns {number} */ function u16(n) { return n & 0xFFFF; }").to_string())
        ()
        (*_self).out_.push(("/** @param {number} n @returns {number} */ function u32(n) { return n >>> 0; }").to_string())
        ()
        (*_self).out_.push(("/** @param {number} n @returns {number} */ function i8(n)  { return (n << 24) >> 24; }").to_string())
        ()
        (*_self).out_.push(("/** @param {number} n @returns {number} */ function i16(n) { return (n << 16) >> 16; }").to_string())
        ()
        (*_self).out_.push(("/** @param {number} n @returns {number} */ function i32(n) { return n | 0; }").to_string())
        ()
        (*_self).out_.push(("/** @param {number} n @returns {number} */ function f32(n) { return Math.fround(n); }").to_string())
        ()
        (*_self).blank()
        ()
        (*_self).out_.push(("// ── KAIN stdlib bridge (auto-generated) ───────────────────────────────────").to_string())
        ()
        (*_self).out_.push(("function __kain_clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }").to_string())
        ()
        (*_self).out_.push(("function println(...a) { console.log(...a); }").to_string())
        ()
        (*_self).out_.push(("function print(...a) { process?.stdout?.write(String(a[0])) ?? console.log(...a); }").to_string())
        ()
        (*_self).out_.push(("function push(arr, v) { arr.push(v); return arr; }").to_string())
        ()
        (*_self).out_.push(("function pop(arr) { return arr.pop(); }").to_string())
        ()
        (*_self).out_.push(("function len(v) { return v?.length ?? 0; }").to_string())
        ()
        (*_self).out_.push(("function is_empty(v) { return (v?.length ?? 0) === 0; }").to_string())
        ()
        (*_self).out_.push(("function map(arr, f) { return arr.map(f); }").to_string())
        ()
        (*_self).out_.push(("function filter(arr, f) { return arr.filter(f); }").to_string())
        ()
        (*_self).out_.push(("function reduce(arr, f, init) { return arr.reduce(f, init); }").to_string())
        ()
        (*_self).out_.push(("function to_string(v) { return String(v); }").to_string())
        ()
        (*_self).out_.push(("function parse_int(s) { return parseInt(s, 10); }").to_string())
        ()
        (*_self).out_.push(("function parse_float(s) { return parseFloat(s); }").to_string())
        ()
        (*_self).out_.push(("function http_get(url) { return fetch(url).then(r => r.text()); }").to_string())
        ()
        (*_self).out_.push(("function http_post(url, body) { return fetch(url, { method: 'POST', body: JSON.stringify(body) }).then(r => r.text()); }").to_string())
        ()
        (*_self).out_.push(("function json_parse(s) { return JSON.parse(s); }").to_string())
        ()
        (*_self).out_.push(("function json_stringify(v) { return JSON.stringify(v); }").to_string())
        ()
        (*_self).blank()
        ()
        if (*_self).needs_dom:
            (*_self).out_.push(("// DOM type hints for JSX components").to_string())
            ()
            (*_self).out_.push(("/** @typedef {Node | DocumentFragment} KainNode */").to_string())
            ()
            (*_self).blank()
            ()
            ()
            ()
            ()
        for item in &(*program).items:
            match item:
                kain_core__types__TypedItem::Struct(s) => (*_self).gen_struct(s)
                kain_core__types__TypedItem::Enum(e) => (*_self).gen_enum(e)
                kain_core__types__TypedItem::Function(f) => (*_self).gen_function(f)
                kain_core__types__TypedItem::Component(c) =>
                    (*_self).needs_dom = true
                    ()
                    (*_self).gen_component(c)
                    ()
                kain_core__types__TypedItem::Const(c) =>
                    let ty = (*_self).type_jsdoc(&c.ast.ty)
                    (*_self).out_.push("/** @type {{ty}} */")
                    ()
                    let mut val = String__new_()
                    (*_self).expr_to_str(&c.ast.value, &mut val)
                    ()
                    (*_self).out_.push(f"const {c.ast.name} = {val};")
                    ()
                    (*_self).blank()
                    ()
                kain_core__types__TypedItem::Impl(i) => (*_self).gen_impl(&i.ast)
                _ => ()
        ()
        let has_main = (*program).items.iter().any(fn(item): none)
        if has_main:
            (*_self).blank()
            ()
            (*_self).out_.push(("// Auto-entry: call main() if defined (node file.ks just works)").to_string())
            ()
            (*_self).out_.push(("if (typeof main === 'function') main();").to_string())
            ()
            ()
            ()
            ()
        std__mem__take(&mut (*_self).out_).build()

    fn gen_struct(_self: &mut KsGen, s: &kain_core::types::TypedStruct):
        if (*_self).seen_types.contains(&(*s).ast.name):
            return
        (*_self).seen_types.insert((*s).ast.name.clone())
        ()
        if (*s).ast.fields.is_empty():
            (*_self).out_.push("/** @typedef {Record<string, *>} {(*s).ast.name} */")
            ()
            (*_self).blank()
            ()
            return
        let mut typedef_ = "/**\n * @typedef {{"
        for selfhost_for_item in (*s).ast.fields.iter().enumerate():
            let (i, f) = selfhost_for_item
            let ty = (*_self).type_jsdoc(&f.ty)
            let sep = if (i == 0):
                ""
            else:
                ","
            typedef_.push_str(&f"{sep} {f.name}: {ty}")
            ()
        ()
        typedef_.push_str(&"}} {(*s).ast.name}")
        ()
        typedef_.push_str("\n */")
        ()
        (*_self).out_.push(typedef_)
        ()
        let ctor_params = (*s).ast.fields.iter().map(fn(f): none).collect().join(", ")
        (*_self).out_.push("class {(*s).ast.name} {")
        ()
        for f in &(*s).ast.fields:
            let ty = (*_self).type_jsdoc(&f.ty)
            (*_self).out_.push("  /** @type {{ty}} */ {f.name};")
            ()
        ()
        (*_self).out_.push("  /** @param {{(*s).ast.name}} _ */")
        ()
        (*_self).out_.push("  constructor({ctor_params}) {")
        ()
        for f in &(*s).ast.fields:
            (*_self).out_.push(f"    this.{f.name} = {f.name};")
            ()
        ()
        (*_self).out_.push(("  }").to_string())
        ()
        (*_self).out_.push(("}").to_string())
        ()
        (*_self).blank()
        ()

    fn gen_enum(_self: &mut KsGen, e: &kain_core::types::TypedEnum):
        if (*_self).seen_types.contains(&(*e).ast.name):
            return
        (*_self).seen_types.insert((*e).ast.name.clone())
        ()
        let mut variants_doc = []
        let mut const_parts = []
        for v in &(*e).ast.variants:
            match &v.fields:
                kain_core__ast__VariantFields::Unit =>
                    variants_doc.push("{{ tag: '{v.name}' }}")
                    ()
                    const_parts.push("  /** @type {{tag: '{v.name}'}} */\n  {v.name}: Object.freeze({ tag: '{v.name}' }),")
                    ()
                kain_core__ast__VariantFields::Tuple(types) =>
                    let fields: String = types.iter().enumerate().map(fn(__kain_closure_arg2): f"_{__kain_closure_arg2.__kain_tuple_0}: {(*_self).type_jsdoc(__kain_closure_arg2.__kain_tuple_1)}").collect().join(", ")
                    variants_doc.push("{{ tag: '{v.name}', {fields} }}")
                    ()
                    let param_list = types.iter().enumerate().map(fn(__kain_closure_arg3): f"_{__kain_closure_arg3.__kain_tuple_0}").collect().join(", ")
                    let obj_fields = types.iter().enumerate().map(fn(__kain_closure_arg4): f"_{__kain_closure_arg4.__kain_tuple_0}").collect().join(", ")
                    const_parts.push("  {v.name}({param_list}) { return { tag: '{v.name}', {obj_fields} }; },")
                    ()
                kain_core__ast__VariantFields::Struct(fields) =>
                    let fstr: String = fields.iter().map(fn(f): f"{f.name}: {(*_self).type_jsdoc(&f.ty)}").collect().join(", ")
                    variants_doc.push("{{ tag: '{v.name}', {fstr} }}")
                    ()
                    let param_list = fields.iter().map(fn(f): f.name.as_str()).collect().join(", ")
                    let obj_fields: String = fields.iter().map(fn(f): f.name.as_str()).collect().join(", ")
                    const_parts.push("  {v.name}({{param_list}}) { return { tag: '{v.name}', {obj_fields} }; },")
                    ()
        ()
        (*_self).out_.push("/** @typedef {{variants_doc.join(\" | \")}} {(*e).ast.name} */")
        ()
        (*_self).out_.push("const {(*e).ast.name} = {")
        ()
        for p in const_parts:
            (*_self).out_.push(f"  {p}")
            ()
        ()
        (*_self).out_.push(("};").to_string())
        ()
        (*_self).blank()
        ()

    fn gen_function(_self: &mut KsGen, f: &kain_core::types::TypedFunction):
        let mut doc_lines = [("/**").to_string()]
        for param in &(*f).ast.params:
            let ty = (*_self).type_jsdoc(&param.ty)
            doc_lines.push(" * @param {{ty}} {param.name}")
            ()
        ()
        let ret = match &(*f).ast.return_type:
            Some(ret_ty) => (*_self).type_jsdoc(ret_ty)
            _ =>
                match &(*f).resolved_type:
                    kain_core__types__ResolvedType::Function { ret: ret } => (*_self).resolved_jsdoc(ret)
                    _ => ("void").to_string()
        if (!(*f).ast.effects.is_empty()):
            let effects: String = (*f).ast.effects.iter().map(fn(e): e).collect().join(", ")
            doc_lines.push(f" * @kain-effects {effects}")
            ()
            ()
            ()
            ()
        doc_lines.push(" * @returns {{ret}}")
        ()
        doc_lines.push((" */").to_string())
        ()
        for dl in doc_lines:
            (*_self).out_.push(dl)
            ()
        ()
        let params = (*f).ast.params.iter().map(fn(p): p.name.as_str()).collect().join(", ")
        (*_self).out_.push("function {(*f).ast.name}({params}) {")
        ()
        (*_self).indent()
        ()
        (*_self).gen_block(&(*f).ast.body)
        ()
        (*_self).dedent()
        ()
        (*_self).out_.push(("}").to_string())
        ()
        (*_self).blank()
        ()

    fn gen_component(_self: &mut KsGen, c: &kain_core::types::TypedComponent):
        let mut doc_lines = [("/**").to_string()]
        for prop in &(*c).ast.props:
            let ty = (*_self).type_jsdoc(&prop.ty)
            doc_lines.push(" * @param {{{prop.name}:{ty}, children?:KainNode[]}} props")
            ()
        ()
        if (*c).ast.props.is_empty():
            doc_lines.push((" * @param {{children?: KainNode[]}} props").to_string())
            ()
            ()
            ()
            ()
        doc_lines.push((" * @returns {KainNode}").to_string())
        ()
        doc_lines.push((" */").to_string())
        ()
        for dl in doc_lines:
            (*_self).out_.push(dl)
            ()
        ()
        (*_self).out_.push("function {(*c).ast.name}(props) {")
        ()
        let prop_names: Array<_> = (*c).ast.props.iter().map(fn(p): p.name.as_str()).collect()
        if prop_names.is_empty():
            (*_self).out_.push(("  const { children = [] } = props;").to_string())
            ()
            ()
            ()
            ()
        else:
            (*_self).out_.push("  const { {prop_names.join(\", \")}, children = [] } = props;")
            ()
            ()
            ()
            ()
        for s in &(*c).ast.state_:
            let mut val = String__new_()
            (*_self).expr_to_str(&s.initial, &mut val)
            ()
            (*_self).out_.push(f"  let {s.name} = {val};")
            ()
        ()
        (*_self).out_.push(("  return ").to_string())
        ()
        let mut jsx_out = String__new_()
        (*_self).jsx_to_str(&(*c).ast.body, &mut jsx_out)
        ()
        (*_self).out_.push(f"  {jsx_out};")
        ()
        (*_self).out_.push(("}").to_string())
        ()
        (*_self).blank()
        ()

    fn gen_impl(_self: &mut KsGen, i: &kain_core::ast::Impl):
        let type_name = match &(*i).target_type:
            kain_core__ast__Type::Named { name: name } => name.clone()
            _ => return
        for method in &(*i).methods:
            (*_self).out_.push(("/**").to_string())
            ()
            for p in &method.params:
                let ty = (*_self).type_jsdoc(&p.ty)
                (*_self).out_.push(" * @param {{ty}} {p.name}")
                ()
            ()
            let ret = method.return_type.map(fn(t): (*_self).type_jsdoc(t)).unwrap_or(("void").to_string())
            (*_self).out_.push(" * @returns {{ret}}")
            ()
            (*_self).out_.push((" */").to_string())
            ()
            let params: Array<_> = method.params.iter().map(fn(p): p.name.as_str()).collect()
            (*_self).out_.push("{type_name}.prototype.{method.name} = function({params.join(\", \")}) {")
            ()
            (*_self).indent()
            ()
            (*_self).gen_block(&method.body)
            ()
            (*_self).dedent()
            ()
            (*_self).out_.push(("};").to_string())
            ()
            (*_self).blank()
            ()

    fn gen_block(_self: &mut KsGen, block: &kain_core::ast::Block):
        for stmt in &(*block).stmts:
            (*_self).gen_stmt(stmt)
            ()

    fn gen_stmt(_self: &mut KsGen, stmt: &kain_core::ast::Stmt):
        match stmt:
            kain_core__ast__Stmt::Let { pattern: pattern, ty: ty, value: value } =>
                let name = match pattern:
                    kain_core__ast__Pattern::Binding { name: name, mutable_: mutable_ } =>
                        let kw = if (*mutable_):
                            "let"
                        else:
                            "let"
                        (kw, name.clone())
                    kain_core__ast__Pattern::Wildcard(_) => ("let", ("_").to_string())
                    _ => ("let", ("/* complex pattern */").to_string())
                match ty:
                    Some(ty_ann) =>
                        (*_self).line_("/** @type {{(*_self).type_jsdoc(ty_ann)}} */")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                match value:
                    Some(val) =>
                        let mut vs = String__new_()
                        (*_self).expr_to_str(val, &mut vs)
                        ()
                        (*_self).line_(f"{name.field_0} {name.field_1} = {vs};")
                        ()
                    _ =>
                        (*_self).line_(f"{name.field_0} {name.field_1};")
                        ()
            kain_core__ast__Stmt::Expr(expr) =>
                match expr:
                    kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                        let mut cond_s = String__new_()
                        (*_self).expr_to_str(condition, &mut cond_s)
                        ()
                        (*_self).line_("if ({cond_s}) {")
                        ()
                        (*_self).indent()
                        ()
                        (*_self).gen_block(then_branch)
                        ()
                        (*_self).dedent()
                        ()
                        let mut cur = else_branch
                        loop:
                            match cur:
                                Some(b) =>
                                    match b:
                                        kain_core__ast__ElseBranch::Else(blk) =>
                                            (*_self).line_("} else {")
                                            ()
                                            (*_self).indent()
                                            ()
                                            (*_self).gen_block(blk)
                                            ()
                                            (*_self).dedent()
                                            ()
                                            cur = none
                                            ()
                                        kain_core__ast__ElseBranch::ElseIf(cond, blk, next) =>
                                            let mut cs = String__new_()
                                            (*_self).expr_to_str(cond, &mut cs)
                                            ()
                                            (*_self).line_("} else if ({cs}) {")
                                            ()
                                            (*_self).indent()
                                            ()
                                            (*_self).gen_block(blk)
                                            ()
                                            (*_self).dedent()
                                            ()
                                            cur = next
                                            ()
                                _ => break
                        ()
                        (*_self).line_("}")
                        ()
                    _ =>
                        let mut vs = String__new_()
                        (*_self).expr_to_str(expr, &mut vs)
                        ()
                        (*_self).line_(f"{vs};")
                        ()
            kain_core__ast__Stmt::Return(Some(expr), _) =>
                let mut vs = String__new_()
                (*_self).expr_to_str(expr, &mut vs)
                ()
                (*_self).line_(f"return {vs};")
                ()
            kain_core__ast__Stmt::Return(None, _) => (*_self).line_("return;")
            kain_core__ast__Stmt::Break(Some(expr), _) =>
                let mut vs = String__new_()
                (*_self).expr_to_str(expr, &mut vs)
                ()
                (*_self).line_(f"/* break {vs} */")
                ()
            kain_core__ast__Stmt::Break(None, _) => (*_self).line_("break;")
            kain_core__ast__Stmt::Continue(_) => (*_self).line_("continue;")
            kain_core__ast__Stmt::For { binding: binding, iter: iter, body: body } =>
                let b = match binding:
                    kain_core__ast__Pattern::Binding { name: name } => name.clone()
                    kain_core__ast__Pattern::Tuple(pats, _) =>
                        let ns: Array<_> = pats.iter().filter_map(fn(p): none).collect()
                        "[{ns.join(\", \")}]"
                    _ => ("_").to_string()
                let mut is = String__new_()
                (*_self).expr_to_str(iter, &mut is)
                ()
                (*_self).line_("for (const {b} of {is}) {")
                ()
                (*_self).indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).dedent()
                ()
                (*_self).line_("}")
                ()
            kain_core__ast__Stmt::While { condition: condition, body: body } =>
                let mut cs = String__new_()
                (*_self).expr_to_str(condition, &mut cs)
                ()
                (*_self).line_("while ({cs}) {")
                ()
                (*_self).indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).dedent()
                ()
                (*_self).line_("}")
                ()
            kain_core__ast__Stmt::Loop { body: body } =>
                (*_self).line_("while (true) {")
                ()
                (*_self).indent()
                ()
                (*_self).gen_block(body)
                ()
                (*_self).dedent()
                ()
                (*_self).line_("}")
                ()
            kain_core__ast__Stmt::Item(_) => ()

    fn expr_to_str(_self: &KsGen, expr: &kain_core::ast::Expr, out_: String):
        match expr:
            kain_core__ast__Expr::Int(n, _) => out_.push_str(&n.to_string())
            kain_core__ast__Expr::Float(f, _) => out_.push_str(&f.to_string())
            kain_core__ast__Expr::Bool(b, _) => out_.push_str(&b.to_string())
            kain_core__ast__Expr::None(_) => out_.push_str("null")
            kain_core__ast__Expr::String(s, _) =>
                out_.push("\"")
                ()
                out_.push_str(&s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t"))
                ()
                out_.push("\"")
                ()
            kain_core__ast__Expr::FString(parts, _) =>
                out_.push("`")
                ()
                for p in parts:
                    match p:
                        kain_core__ast__Expr::String(s, _) => out_.push_str(s)
                        other =>
                            out_.push_str("${")
                            ()
                            (*_self).expr_to_str(other, out_)
                            ()
                            out_.push("}")
                            ()
                ()
                out_.push("`")
                ()
            kain_core__ast__Expr::Ident(n, _) =>
                let mapped = match n.as_str():
                    "sqrt" => "Math.sqrt"
                    "sin" => "Math.sin"
                    "cos" => "Math.cos"
                    "tan" => "Math.tan"
                    "atan" => "Math.atan"
                    "atan2" => "Math.atan2"
                    "asin" => "Math.asin"
                    "acos" => "Math.acos"
                    "floor" => "Math.floor"
                    "ceil" => "Math.ceil"
                    "round" => "Math.round"
                    "abs" => "Math.abs"
                    "pow" => "Math.pow"
                    "exp" => "Math.exp"
                    "log" => "Math.log"
                    "log2" => "Math.log2"
                    "log10" => "Math.log10"
                    "min" => "Math.min"
                    "max" => "Math.max"
                    "fmin" => "Math.min"
                    "fmax" => "Math.max"
                    "clamp" => "__kain_clamp"
                    other => other
                out_.push_str(mapped)
                ()
            kain_core__ast__Expr::Paren(inner, _) =>
                out_.push("(")
                ()
                (*_self).expr_to_str(inner, out_)
                ()
                out_.push(")")
                ()
            kain_core__ast__Expr::Unary { op: op, operand: operand } =>
                let op_str = match op:
                    kain_core__ast__UnaryOp::Neg => "-"
                    kain_core__ast__UnaryOp::Not => "!"
                    kain_core__ast__UnaryOp::BitNot => "~"
                    kain_core__ast__UnaryOp::Ref => ""
                    kain_core__ast__UnaryOp::RefMut => ""
                    kain_core__ast__UnaryOp::Deref => ""
                out_.push_str(op_str)
                ()
                (*_self).expr_to_str(operand, out_)
                ()
            kain_core__ast__Expr::Binary { left: left, op: op, right: right } =>
                (*_self).expr_to_str(left, out_)
                ()
                out_.push(" ")
                ()
                out_.push_str((*_self).binop_str((*op)))
                ()
                out_.push(" ")
                ()
                (*_self).expr_to_str(right, out_)
                ()
            kain_core__ast__Expr::Assign { target: target, value: value } =>
                (*_self).expr_to_str(target, out_)
                ()
                out_.push_str(" = ")
                ()
                (*_self).expr_to_str(value, out_)
                ()
            kain_core__ast__Expr::Field { object: object, field: field } =>
                (*_self).expr_to_str(object, out_)
                ()
                out_.push(".")
                ()
                out_.push_str(field)
                ()
            kain_core__ast__Expr::Index { object: object, index: index } =>
                (*_self).expr_to_str(object, out_)
                ()
                out_.push("[")
                ()
                (*_self).expr_to_str(index, out_)
                ()
                out_.push("]")
                ()
            kain_core__ast__Expr::Call { callee: callee, args: args } =>
                (*_self).expr_to_str(callee, out_)
                ()
                out_.push("(")
                ()
                for selfhost_for_item in args.iter().enumerate():
                    let (i, arg) = selfhost_for_item
                    if (i > 0):
                        out_.push_str(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).expr_to_str(&arg.value, out_)
                    ()
                ()
                out_.push(")")
                ()
            kain_core__ast__Expr::MethodCall { receiver: receiver, method: method, args: args } =>
                match method.as_str():
                    "len" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".length")
                        ()
                        return
                    "count" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".length")
                        ()
                        return
                    "is_empty" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".length === 0")
                        ()
                        return
                    "push" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".push(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, a) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).expr_to_str(&a.value, out_)
                            ()
                        ()
                        out_.push(")")
                        ()
                        return
                    "append" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".push(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, a) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).expr_to_str(&a.value, out_)
                            ()
                        ()
                        out_.push(")")
                        ()
                        return
                    "pop" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".pop()")
                        ()
                        return
                    "first" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str("[0]")
                        ()
                        return
                    "last" =>
                        out_.push_str("(() => { const __r = ")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str("; return __r[__r.length - 1]; })()")
                        ()
                        return
                    "contains" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".includes(")
                        ()
                        match args.first():
                            Some(a) =>
                                (*_self).expr_to_str(&a.value, out_)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        out_.push(")")
                        ()
                        return
                    "includes" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".includes(")
                        ()
                        match args.first():
                            Some(a) =>
                                (*_self).expr_to_str(&a.value, out_)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        out_.push(")")
                        ()
                        return
                    "map" =>
                        (*_self).method_higher_order(receiver, ".map(", args, out_)
                        ()
                        return
                    "filter" =>
                        (*_self).method_higher_order(receiver, ".filter(", args, out_)
                        ()
                        return
                    "find" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".find(")
                        ()
                        match args.first():
                            Some(a) =>
                                (*_self).expr_to_str(&a.value, out_)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        out_.push_str(") ?? null")
                        ()
                        return
                    "any" =>
                        (*_self).method_higher_order(receiver, ".some(", args, out_)
                        ()
                        return
                    "all" =>
                        (*_self).method_higher_order(receiver, ".every(", args, out_)
                        ()
                        return
                    "enumerate" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".map((__v, __i) => [__i, __v])")
                        ()
                        return
                    "collect" =>
                        out_.push_str("Array.from(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push(")")
                        ()
                        return
                    "iter" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        return
                    "into_iter" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        return
                    "iter_mut" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        return
                    "clone" =>
                        out_.push_str("[...")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push("]")
                        ()
                        return
                    "to_vec" =>
                        out_.push_str("[...")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push("]")
                        ()
                        return
                    "to_string" =>
                        out_.push_str("String(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push(")")
                        ()
                        return
                    "to_owned" =>
                        out_.push_str("String(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push(")")
                        ()
                        return
                    "to_uppercase" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".toUpperCase()")
                        ()
                        return
                    "to_lowercase" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".toLowerCase()")
                        ()
                        return
                    "trim" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".trim()")
                        ()
                        return
                    "split" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".split(")
                        ()
                        match args.first():
                            Some(a) =>
                                (*_self).expr_to_str(&a.value, out_)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        out_.push(")")
                        ()
                        return
                    "join" =>
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(".join(")
                        ()
                        match args.first():
                            Some(a) =>
                                (*_self).expr_to_str(&a.value, out_)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        out_.push(")")
                        ()
                        return
                    "unwrap" =>
                        out_.push_str("(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(" ?? (() => { throw new Error('KAIN: unwrap on null'); })())")
                        ()
                        return
                    "unwrap_or" =>
                        out_.push_str("(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(" ?? ")
                        ()
                        match args.first():
                            Some(a) =>
                                (*_self).expr_to_str(&a.value, out_)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                ()
                                ()
                        out_.push(")")
                        ()
                        return
                    "is_some" =>
                        out_.push_str("((")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(") != null)")
                        ()
                        return
                    "is_ok" =>
                        out_.push_str("((")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(") != null)")
                        ()
                        return
                    "is_none" =>
                        out_.push_str("((")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(") == null)")
                        ()
                        return
                    "is_err" =>
                        out_.push_str("((")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str(") == null)")
                        ()
                        return
                    "abs" =>
                        out_.push_str("Math.abs(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push(")")
                        ()
                        return
                    "sqrt" =>
                        out_.push_str("Math.sqrt(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push(")")
                        ()
                        return
                    "floor" =>
                        out_.push_str("Math.floor(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push(")")
                        ()
                        return
                    "ceil" =>
                        out_.push_str("Math.ceil(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push(")")
                        ()
                        return
                    "round" =>
                        out_.push_str("Math.round(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push(")")
                        ()
                        return
                    "parse" =>
                        out_.push_str("Number(")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push(")")
                        ()
                        return
                    "sort" =>
                        out_.push_str("[...")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str("].sort()")
                        ()
                        return
                    "reverse" =>
                        out_.push_str("[...")
                        ()
                        (*_self).expr_to_str(receiver, out_)
                        ()
                        out_.push_str("].reverse()")
                        ()
                        return
                    _ => ()
                (*_self).expr_to_str(receiver, out_)
                ()
                out_.push(".")
                ()
                out_.push_str(method)
                ()
                out_.push("(")
                ()
                for selfhost_for_item in args.iter().enumerate():
                    let (i, a) = selfhost_for_item
                    if (i > 0):
                        out_.push_str(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).expr_to_str(&a.value, out_)
                    ()
                ()
                out_.push(")")
                ()
            kain_core__ast__Expr::Struct { name: name, fields: fields } =>
                out_.push_str(&f"new {name}(")
                ()
                for selfhost_for_item in fields.iter().enumerate():
                    let (i, (_, v)) = selfhost_for_item
                    if (i > 0):
                        out_.push_str(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).expr_to_str(v, out_)
                    ()
                ()
                out_.push(")")
                ()
            kain_core__ast__Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: fields } =>
                match fields:
                    kain_core__ast__EnumVariantFields::Unit => out_.push_str(&f"{enum_name}.{variant}")
                    kain_core__ast__EnumVariantFields::Tuple(exprs) =>
                        out_.push_str(&f"{enum_name}.{variant}(")
                        ()
                        for selfhost_for_item in exprs.iter().enumerate():
                            let (i, e) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).expr_to_str(e, out_)
                            ()
                        ()
                        out_.push(")")
                        ()
                    kain_core__ast__EnumVariantFields::Struct(fields) =>
                        out_.push_str(&"{enum_name}.{variant}({")
                        ()
                        for selfhost_for_item in fields.iter().enumerate():
                            let (i, (name, val)) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            out_.push_str(name)
                            ()
                            out_.push_str(": ")
                            ()
                            (*_self).expr_to_str(val, out_)
                            ()
                        ()
                        out_.push_str("})")
                        ()
            kain_core__ast__Expr::Array(exprs, _) =>
                out_.push("[")
                ()
                for selfhost_for_item in exprs.iter().enumerate():
                    let (i, e) = selfhost_for_item
                    if (i > 0):
                        out_.push_str(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).expr_to_str(e, out_)
                    ()
                ()
                out_.push("]")
                ()
            kain_core__ast__Expr::Tuple(exprs, _) =>
                out_.push("[")
                ()
                for selfhost_for_item in exprs.iter().enumerate():
                    let (i, e) = selfhost_for_item
                    if (i > 0):
                        out_.push_str(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).expr_to_str(e, out_)
                    ()
                ()
                out_.push("]")
                ()
            kain_core__ast__Expr::Range { start: start, end: end, inclusive: inclusive } =>
                out_.push_str("((__s, __e) => { const __a = []; for (let __i = __s; __i ")
                ()
                out_.push_str(if (*inclusive): "<= __e" else: "< __e")
                ()
                out_.push_str("; __i++) __a.push(__i); return __a; })(")
                ()
                match start:
                    Some(s) =>
                        (*_self).expr_to_str(s, out_)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        out_.push("0")
                        ()
                        ()
                        ()
                        ()
                out_.push_str(", ")
                ()
                match end:
                    Some(e) =>
                        (*_self).expr_to_str(e, out_)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        out_.push("0")
                        ()
                        ()
                        ()
                        ()
                out_.push(")")
                ()
            kain_core__ast__Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                out_.push_str("(() => { if (")
                ()
                (*_self).expr_to_str(condition, out_)
                ()
                out_.push_str(") { return ")
                ()
                (*_self).block_to_str(then_branch, out_)
                ()
                out_.push_str("; }")
                ()
                let mut cur = else_branch
                loop:
                    match cur:
                        Some(b) =>
                            match b:
                                kain_core__ast__ElseBranch::Else(blk) =>
                                    out_.push_str(" else { return ")
                                    ()
                                    (*_self).block_to_str(blk, out_)
                                    ()
                                    out_.push_str("; }")
                                    ()
                                    cur = none
                                    ()
                                kain_core__ast__ElseBranch::ElseIf(cond, blk, next) =>
                                    out_.push_str(" else if (")
                                    ()
                                    (*_self).expr_to_str(cond, out_)
                                    ()
                                    out_.push_str(") { return ")
                                    ()
                                    (*_self).block_to_str(blk, out_)
                                    ()
                                    out_.push_str("; }")
                                    ()
                                    cur = next
                                    ()
                        _ => break
                ()
                out_.push_str(" return undefined; })()")
                ()
            kain_core__ast__Expr::Match { scrutinee: scrutinee, arms: arms } =>
                out_.push_str("(() => { const __s = ")
                ()
                (*_self).expr_to_str(scrutinee, out_)
                ()
                out_.push_str("; ")
                ()
                for arm in arms:
                    let cond = (*_self).pattern_cond("__s", &arm.pattern)
                    out_.push_str(&"if ({cond}) { ")
                    ()
                    (*_self).pattern_bindings_inline("__s", &arm.pattern, out_)
                    ()
                    out_.push_str("return ")
                    ()
                    (*_self).expr_to_str(&arm.body, out_)
                    ()
                    out_.push_str("; } ")
                    ()
                ()
                out_.push_str("return undefined; })()")
                ()
            kain_core__ast__Expr::Lambda { params: params, body: body } =>
                let ps: Array<_> = params.iter().map(fn(p): p.name.as_str()).collect()
                out_.push("(")
                ()
                out_.push_str(&ps.join(", "))
                ()
                out_.push_str(") => ")
                ()
                (*_self).expr_to_str(body, out_)
                ()
            kain_core__ast__Expr::Block(block, _) =>
                out_.push_str("(() => { ")
                ()
                (*_self).block_to_str(block, out_)
                ()
                out_.push_str(" })()")
                ()
            kain_core__ast__Expr::Cast { value: value } =>
                out_.push("(")
                ()
                (*_self).expr_to_str(value, out_)
                ()
                out_.push(")")
                ()
            kain_core__ast__Expr::Try(inner, _) =>
                out_.push_str("(() => { const __r = ")
                ()
                (*_self).expr_to_str(inner, out_)
                ()
                out_.push_str("; if (__r && __r.ok === false) throw __r.error; return __r?.value ?? __r; })()")
                ()
            kain_core__ast__Expr::Await(inner, _) =>
                out_.push_str("(await ")
                ()
                (*_self).expr_to_str(inner, out_)
                ()
                out_.push(")")
                ()
            kain_core__ast__Expr::Deref(inner, _) =>
                (*_self).expr_to_str(inner, out_)
                ()
            kain_core__ast__Expr::Ref { value: inner } =>
                (*_self).expr_to_str(inner, out_)
                ()
            kain_core__ast__Expr::Comptime(inner, _) => (*_self).expr_to_str(inner, out_)
            kain_core__ast__Expr::Return(Some(v), _) =>
                out_.push_str("(() => { return ")
                ()
                (*_self).expr_to_str(v, out_)
                ()
                out_.push_str("; })()")
                ()
            kain_core__ast__Expr::Return(None, _) => out_.push_str("(() => {})()")
            kain_core__ast__Expr::Break(Some(v), _) =>
                (*_self).expr_to_str(v, out_)
                ()
            kain_core__ast__Expr::Break(None, _) => out_.push_str("undefined")
            kain_core__ast__Expr::Continue(_) => out_.push_str("undefined")
            kain_core__ast__Expr::Spawn { actor_: actor_, init: init } =>
                out_.push_str(&f"new {actor_}(")
                ()
                for selfhost_for_item in init.iter().enumerate():
                    let (i, (_, v)) = selfhost_for_item
                    if (i > 0):
                        out_.push_str(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).expr_to_str(v, out_)
                    ()
                ()
                out_.push(")")
                ()
            kain_core__ast__Expr::SendMsg { target: target, message: message, data: data } =>
                (*_self).expr_to_str(target, out_)
                ()
                out_.push_str(&f".{message}(")
                ()
                for selfhost_for_item in data.iter().enumerate():
                    let (i, (_, v)) = selfhost_for_item
                    if (i > 0):
                        out_.push_str(", ")
                        ()
                        ()
                        ()
                        ()
                    (*_self).expr_to_str(v, out_)
                    ()
                ()
                out_.push(")")
                ()
            kain_core__ast__Expr::MacroCall { name: name, args: args } =>
                match name.as_str():
                    "print" =>
                        out_.push_str("console.log(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, a) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).expr_to_str(a, out_)
                            ()
                        ()
                        out_.push(")")
                        ()
                    "println" =>
                        out_.push_str("console.log(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, a) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).expr_to_str(a, out_)
                            ()
                        ()
                        out_.push(")")
                        ()
                    "eprintln" =>
                        out_.push_str("console.log(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, a) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).expr_to_str(a, out_)
                            ()
                        ()
                        out_.push(")")
                        ()
                    "assert" =>
                        out_.push_str("(() => { const __ok = ")
                        ()
                        match args.first():
                            Some(e) =>
                                (*_self).expr_to_str(e, out_)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                out_.push_str("true")
                                ()
                                ()
                                ()
                                ()
                        out_.push_str("; if (!__ok) throw new Error('KAIN assert failed'); })()")
                        ()
                    "vec" =>
                        out_.push("[")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, a) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).expr_to_str(a, out_)
                            ()
                        ()
                        out_.push("]")
                        ()
                    "array" =>
                        out_.push("[")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, a) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).expr_to_str(a, out_)
                            ()
                        ()
                        out_.push("]")
                        ()
                    "format" =>
                        out_.push("`")
                        ()
                        for a in args:
                            out_.push_str("${")
                            ()
                            (*_self).expr_to_str(a, out_)
                            ()
                            out_.push("}")
                            ()
                        ()
                        out_.push("`")
                        ()
                    "concat" =>
                        out_.push("`")
                        ()
                        for a in args:
                            out_.push_str("${")
                            ()
                            (*_self).expr_to_str(a, out_)
                            ()
                            out_.push("}")
                            ()
                        ()
                        out_.push("`")
                        ()
                    "todo" => out_.push_str("(() => { throw new Error('TODO: not yet implemented'); })()")
                    "unreachable" => out_.push_str("(() => { throw new Error('KAIN: unreachable'); })()")
                    "panic" =>
                        out_.push_str("(() => { throw new Error(")
                        ()
                        match args.first():
                            Some(e) =>
                                (*_self).expr_to_str(e, out_)
                                ()
                                ()
                                ()
                                ()
                            _ =>
                                out_.push_str("'panic'")
                                ()
                                ()
                                ()
                                ()
                        out_.push_str("); })()")
                        ()
                    _ =>
                        out_.push_str(&f"{name}__macro(")
                        ()
                        for selfhost_for_item in args.iter().enumerate():
                            let (i, a) = selfhost_for_item
                            if (i > 0):
                                out_.push_str(", ")
                                ()
                                ()
                                ()
                                ()
                            (*_self).expr_to_str(a, out_)
                            ()
                        ()
                        out_.push(")")
                        ()
            kain_core__ast__Expr::JSX(node, _) => (*_self).jsx_to_str(node, out_)
            _ => out_.push_str("/* unsupported */")

    fn block_to_str(_self: &KsGen, block: &kain_core::ast::Block, out_: String):
        match (*block).stmts.last():
            Some(last) =>
                match last:
                    kain_core__ast__Stmt::Expr(e) =>
                        (*_self).expr_to_str(e, out_)
                        ()
                        return
                    kain_core__ast__Stmt::Return(Some(e), _) =>
                        (*_self).expr_to_str(e, out_)
                        ()
                        return
                    _ => ()
                ()
            _ =>
                ()
                ()
        out_.push_str("undefined")
        ()

    fn pattern_cond(_self: &KsGen, scrutinee: String, pattern: &kain_core::ast::Pattern) -> String:
        match pattern:
            kain_core__ast__Pattern::Wildcard(_) => ("true").to_string()
            kain_core__ast__Pattern::Binding {  } => ("true").to_string()
            kain_core__ast__Pattern::Literal(e) =>
                let mut s = scrutinee.to_string()
                s.push_str(" === ")
                ()
                let mut vs = String__new_()
                (*_self).expr_to_str(e, &mut vs)
                ()
                s.push_str(&vs)
                ()
                s
            kain_core__ast__Pattern::Variant { enum_name: enum_name, variant: variant } =>
                match enum_name:
                    Some(en) => f"{scrutinee}.type === '{en}' && {scrutinee}.tag === '{variant}'"
                    _ => f"{scrutinee}.tag === '{variant}'"
            kain_core__ast__Pattern::Range { start: start, end: end, inclusive: inclusive } =>
                let mut s = String__new_()
                match start:
                    Some(st) =>
                        (*_self).expr_to_str(st, &mut s)
                        ()
                        s.push_str(&f" <= {scrutinee}")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                match end:
                    Some(en) =>
                        if (!s.is_empty()):
                            s.push_str(" && ")
                            ()
                            ()
                            ()
                            ()
                        s.push_str(&f"{scrutinee} ")
                        ()
                        if (*inclusive):
                            s.push_str("<=")
                            ()
                            ()
                            ()
                            ()
                        else:
                            s.push("<")
                            ()
                            ()
                            ()
                            ()
                        let mut es = String__new_()
                        (*_self).expr_to_str(en, &mut es)
                        ()
                        s.push(" ")
                        ()
                        s.push_str(&es)
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                if s.is_empty():
                    ("true").to_string()
                else:
                    s
            kain_core__ast__Pattern::Or(patterns, _) => patterns.iter().map(fn(p): (*_self).pattern_cond(scrutinee, p)).collect().join(" || ")
            _ => ("false").to_string()

    fn pattern_bindings_inline(_self: &KsGen, scrutinee: String, pattern: &kain_core::ast::Pattern, out_: String):
        match pattern:
            kain_core__ast__Pattern::Binding { name: name } =>
                out_.push_str(&f"const {name} = {scrutinee}; ")
                ()
            _ => ()

    fn jsx_to_str(_self: &KsGen, node: &kain_core::ast::JSXNode, out_: String):
        match node:
            kain_core__ast__JSXNode::Text(s, _) =>
                out_.push_str(&"document.createTextNode('{s.replace(\"'\", \"\\\\'\").replace(\"\\\\\", \"\\\\\\\\\")}')")
                ()
            kain_core__ast__JSXNode::Element { tag: tag, attributes: attributes, children: children } =>
                out_.push_str(&"(() => { const __el = document.createElement('{tag}'); ")
                ()
                for attr in attributes:
                    let val = match &attr.value:
                        kain_core__ast__JSXAttrValue::String(s) => f"'{s}'"
                        kain_core__ast__JSXAttrValue::Bool(b) => b.to_string()
                        kain_core__ast__JSXAttrValue::Expr(e) =>
                            let mut vs = String__new_()
                            (*_self).expr_to_str(e, &mut vs)
                            ()
                            vs
                    if attr.name.starts_with("on"):
                        out_.push_str(&f"__el.addEventListener('{&attr.name[2..].to_lowercase()}', {val}); ")
                        ()
                    else:
                        out_.push_str(&f"__el.setAttribute('{attr.name}', {val}); ")
                        ()
                ()
                for child in children:
                    out_.push_str("__el.appendChild(")
                    ()
                    (*_self).jsx_to_str(child, out_)
                    ()
                    out_.push_str("); ")
                    ()
                ()
                out_.push_str("return __el; })()")
                ()
            kain_core__ast__JSXNode::Expression(e) => (*_self).expr_to_str(e, out_)
            kain_core__ast__JSXNode::Fragment(children, _) =>
                out_.push_str("(() => { const __f = document.createDocumentFragment(); ")
                ()
                for c in children:
                    out_.push_str("__f.appendChild(")
                    ()
                    (*_self).jsx_to_str(c, out_)
                    ()
                    out_.push_str("); ")
                    ()
                ()
                out_.push_str("return __f; })()")
                ()
            kain_core__ast__JSXNode::ComponentCall { name: name, props: props, children: children } =>
                out_.push_str(&"{name}({")
                ()
                for selfhost_for_item in props.iter().enumerate():
                    let (i, p) = selfhost_for_item
                    if (i > 0):
                        out_.push_str(", ")
                        ()
                        ()
                        ()
                        ()
                    let val = match &p.value:
                        kain_core__ast__JSXAttrValue::String(s) => f"'{s}'"
                        kain_core__ast__JSXAttrValue::Bool(b) => b.to_string()
                        kain_core__ast__JSXAttrValue::Expr(e) =>
                            let mut vs = String__new_()
                            (*_self).expr_to_str(e, &mut vs)
                            ()
                            vs
                    out_.push_str(&f"{p.name}: {val}")
                    ()
                ()
                if (!children.is_empty()):
                    if (!props.is_empty()):
                        out_.push_str(", ")
                        ()
                        ()
                        ()
                        ()
                    out_.push_str("children: [")
                    ()
                    for selfhost_for_item in children.iter().enumerate():
                        let (i, c) = selfhost_for_item
                        if (i > 0):
                            out_.push_str(", ")
                            ()
                            ()
                            ()
                            ()
                        (*_self).jsx_to_str(c, out_)
                        ()
                    ()
                    out_.push("]")
                    ()
                    ()
                    ()
                    ()
                out_.push_str("})")
                ()
            kain_core__ast__JSXNode::For { binding: binding, iter: iter, body: body } =>
                out_.push_str(&"(() => { const __f = document.createDocumentFragment(); for (const {binding} of ")
                ()
                (*_self).expr_to_str(iter, out_)
                ()
                out_.push_str(") { __f.appendChild(")
                ()
                (*_self).jsx_to_str(body, out_)
                ()
                out_.push_str("); } return __f; })()")
                ()
            kain_core__ast__JSXNode::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
                out_.push_str("(() => { if (")
                ()
                (*_self).expr_to_str(condition, out_)
                ()
                out_.push_str(") { return ")
                ()
                (*_self).jsx_to_str(then_branch, out_)
                ()
                out_.push_str("; }")
                ()
                match else_branch:
                    Some(eb) =>
                        out_.push_str(" return ")
                        ()
                        (*_self).jsx_to_str(eb, out_)
                        ()
                        out_.push(";")
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                out_.push_str(" return document.createTextNode(''); })()")
                ()

    fn binop_str(_self: &KsGen, op: kain_core::ast::BinaryOp) -> String:
        match op:
            kain_core__ast__BinaryOp::Add => "+"
            kain_core__ast__BinaryOp::Sub => "-"
            kain_core__ast__BinaryOp::Mul => "*"
            kain_core__ast__BinaryOp::Div => "/"
            kain_core__ast__BinaryOp::Mod => "%"
            kain_core__ast__BinaryOp::Pow => "**"
            kain_core__ast__BinaryOp::Eq => "==="
            kain_core__ast__BinaryOp::Ne => "!=="
            kain_core__ast__BinaryOp::Lt => "<"
            kain_core__ast__BinaryOp::Le => "<="
            kain_core__ast__BinaryOp::Gt => ">"
            kain_core__ast__BinaryOp::Ge => ">="
            kain_core__ast__BinaryOp::And => "&&"
            kain_core__ast__BinaryOp::Or => "||"
            kain_core__ast__BinaryOp::BitAnd => "&"
            kain_core__ast__BinaryOp::BitOr => "|"
            kain_core__ast__BinaryOp::BitXor => "^"
            kain_core__ast__BinaryOp::Shl => "<<"
            kain_core__ast__BinaryOp::Shr => ">>"
            kain_core__ast__BinaryOp::Assign => "="
            kain_core__ast__BinaryOp::AddAssign => "+="
            kain_core__ast__BinaryOp::SubAssign => "-="
            kain_core__ast__BinaryOp::MulAssign => "*="
            kain_core__ast__BinaryOp::DivAssign => "/="
            kain_core__ast__BinaryOp::Range => "/* .. */"
            kain_core__ast__BinaryOp::RangeInclusive => "/* .. */"

    fn method_higher_order(_self: &KsGen, receiver: &kain_core::ast::Expr, method_js: String, args: &[kain_core::ast::CallArg], out_: String):
        (*_self).expr_to_str(receiver, out_)
        ()
        out_.push_str(method_js)
        ()
        match args.first():
            Some(a) =>
                (*_self).expr_to_str(&a.value, out_)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        out_.push(")")
        ()


