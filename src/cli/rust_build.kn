use std::fs

use std::path::Component

use std::path::Path

use std::path::PathBuf

use crate::packager::config::RustBuildArtifact

use crate::packager::config::RustBuildConfig

use crate::frontend_to_typed_program

use crate::CompileTarget

use kain_core::error::KainError

use kain_driver::compile_native_app_bundle

use kain_driver::discover_native_app_root_component

use kain_driver::materialize_native_app_bundle

use kain_driver::NativeAppBundle

use kain_driver::NativeAppBundleConfig

use kain_driver::NativeAppLauncherEntrypoint

use kain_driver::NativeAppMaterializationConfig

use kain_driver::NativeAppRuntimeDependency

use kain_sys_codegen::generate_rust_artifact_bundle

use kain_sys_codegen::RustArtifactBundle

use kain_sys_codegen::RustArtifactKind

@derive(Debug, Clone)
pub struct RustBuildOutput:
    bundle: kain_sys_codegen::RustArtifactBundle
    spirv: Option<Array<u8>>

@cfg(feature = "sys")
pub fn compile_rust_build(source: String, config: &RustBuildConfig) -> Result<RustBuildOutput, kain_core::error::KainError>:
    let typed_program = frontend_to_typed_program(source, CompileTarget__Rust)?
    let bundle = kain_sys_codegen__generate_rust_artifact_bundle(&typed_program)?
    let spirv = if ((*config).artifacts.contains(&RustBuildArtifact__Spirv) && bundle.shader_metadata.is_some_and(fn(metadata): (!metadata.shaders.is_empty()))):
        Option::Some(compile_spirv_binary(source)?)
        ()
        ()
        return Result::Err(KainError__runtime("Rust shader bundle requested SPIR-V output but gpu feature is disabled"))
    else:
        none
    Result::Ok(RustBuildOutput { bundle: bundle, spirv: spirv })

@cfg(not(feature = "sys"))
pub fn compile_rust_build(_source: String, _config: &RustBuildConfig) -> Result<RustBuildOutput, kain_core::error::KainError>:
    Result::Err(KainError__runtime("Rust build bundling requires the sys feature"))

pub fn run_rust_build_pipeline(input: &std::path::Path, output: Option<&std::path::PathBuf>, config: Option<&RustBuildConfig>) -> Result<Array<std::path::PathBuf>, kain_core::error::KainError>:
    let should_auto_configure_native_ui = config.is_none()
    let native_ui_was_explicit = config.and_then(fn(config): config.native_ui).is_some()
    let mut config = config.cloned().unwrap_or_default()
    let source = std__fs__read_to_string(input).map_err(fn(err): KainError__runtime(f"Failed to read {input.display()}: {err}"))?
    let base_name = input.file_stem().and_then(fn(stem): stem.to_str()).unwrap_or("kain").to_string()
    let output_root = resolve_file_mode_output_root(input, output, config.output)
    if (config.native_ui.is_none() && should_auto_configure_native_ui):
        config.native_ui = Option::Some(default_file_build_native_ui_config(&base_name))
        ()
        ()
        ()
        ()
    let native_app_bundle = match &config.native_ui:
        Some(native_ui) =>
            let bundle_config = native_app_bundle_config_from_cli(input, &base_name, native_ui, config.artifacts.contains(&RustBuildArtifact__Spirv))?
            match (kain_driver__discover_native_app_root_component(&source, bundle_config.root_component, &bundle_config.source_file_name.clone().unwrap_or_else(fn(): ("app.kn").to_string()))?):
                Some(_) => Option::Some(kain_driver__compile_native_app_bundle(&source, &bundle_config)?)
                None if native_ui_was_explicit => return Result::Err(KainError__runtime(f"Rust native UI build was requested for {input.display()} but no components were found"))
                None => none
        _ =>
            none
    let compiled = (native_app_bundle.map(rust_build_output_from_native_app_bundle).transpose()?).unwrap_or(compile_rust_build(&source, &config)?)
    let mut written = write_rust_build_outputs(&output_root, &base_name, &config, &compiled)?
    match (&config.native_ui, &native_app_bundle):
        (Some(native_ui), Some(bundle)) =>
            let project_dir = resolve_project_dir(&output_root, &bundle.metadata.app_name, native_ui.output)
            let workspace_root = resolve_workspace_root()?
            let dependency_root = workspace_root.join("crates").join("kain-ui-native")
            let dependency_path = diff_paths(&dependency_root, &project_dir).unwrap_or_else(fn(): dependency_root.clone())
            let generated = kain_driver__materialize_native_app_bundle(&source, bundle, &kain_driver::NativeAppMaterializationConfig { project_dir: project_dir, runtime_crate_name: ("kain-ui-native").to_string(), runtime_dependency: kain_driver__NativeAppRuntimeDependency::Path(dependency_path), artifact_output_dir: PathBuf__from("generated"), build_executable: native_ui.build_executable, release: native_ui.release, executable_output_dir: native_ui.build_executable.then(fn(): output_root.clone()), launcher_entrypoint: NativeAppLauncherEntrypoint__default_(), host_sidecars: Vec__new_() })?
            written.push(generated.project_dir)
            ()
            written.push(generated.manifest_path)
            ()
            written.push(generated.main_rs_path)
            ()
            written.push(generated.source_copy_path)
            ()
            written.extend(generated.artifact_paths)
            ()
            match generated.executable_path:
                Some(executable_path) =>
                    written.push(executable_path)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    Result::Ok(written)

pub fn write_rust_build_outputs(output_root: &std::path::Path, base_name: String, config: &RustBuildConfig, compiled: &RustBuildOutput) -> Result<Array<std::path::PathBuf>, kain_core::error::KainError>:
    std__fs__create_dir_all(output_root).map_err(fn(err): KainError__runtime(f"Failed to create Rust output directory {output_root.display()}: {err}"))?
    ()
    let mut written = Vec__new_()
    if (*config).artifacts.contains(&RustBuildArtifact__Source):
        let path = output_root.join(f"{base_name}.rs")
        std__fs__write(&path, (*compiled).bundle.primary.contents.as_bytes()).map_err(fn(err): KainError__runtime(f"Failed to write Rust source output {path.display()}: {err}"))?
        ()
        written.push(path)
        ()
        ()
        ()
        ()
    for artifact in &(*compiled).bundle.supplemental:
        let should_write = match artifact.kind:
            kain_sys_codegen__RustArtifactKind::PrimarySource => (*config).artifacts.contains(&RustBuildArtifact__Source)
            kain_sys_codegen__RustArtifactKind::ShaderHost => (*config).artifacts.contains(&RustBuildArtifact__ShaderHost)
            kain_sys_codegen__RustArtifactKind::ShaderReflection => (*config).artifacts.contains(&RustBuildArtifact__ShaderReflection)
        if (!should_write):
            continue
        let path = match artifact.kind:
            kain_sys_codegen__RustArtifactKind::PrimarySource => output_root.join(f"{base_name}.rs")
            kain_sys_codegen__RustArtifactKind::ShaderHost => output_root.join(f"{base_name}.gpu.rs")
            kain_sys_codegen__RustArtifactKind::ShaderReflection => output_root.join(f"{base_name}.reflect.json")
        std__fs__write(&path, artifact.contents.as_bytes()).map_err(fn(err): KainError__runtime(f"Failed to write Rust artifact output {path.display()}: {err}"))?
        ()
        written.push(path)
        ()
    ()
    ()
    if (*config).artifacts.contains(&RustBuildArtifact__Spirv):
        match &(*compiled).spirv:
            Some(spirv) =>
                let path = output_root.join(f"{base_name}.spv")
                std__fs__write(&path, spirv).map_err(fn(err): KainError__runtime(f"Failed to write SPIR-V output {path.display()}: {err}"))?
                ()
                written.push(path)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        ()
    Result::Ok(written)

fn resolve_file_mode_output_root(input: &std::path::Path, output: Option<&std::path::PathBuf>, configured_output: Option<&std::path::PathBuf>) -> std::path::PathBuf:
    match output:
        Some(output) =>
            if output.extension().is_some():
                return output.parent().map(Path__to_path_buf).unwrap_or_else(fn(): PathBuf__from("."))
            return output.clone()
        _ =>
            ()
            ()
    match configured_output:
        Some(configured_output) =>
            if configured_output.is_absolute():
                return configured_output.clone()
            return input.parent().map(fn(parent): parent.join(configured_output)).unwrap_or_else(fn(): configured_output.clone())
        _ =>
            ()
            ()
    input.parent().map(Path__to_path_buf).unwrap_or_else(fn(): PathBuf__from("."))

fn default_file_build_native_ui_config(base_name: String) -> packager::config::RustNativeUiAppConfig:
    packager::config::RustNativeUiAppConfig { root_component: none, window_title: Option::Some(base_name.to_string()), app_name: Option::Some(base_name.to_string()), output: none, initial_window_size: [1440, 920], build_executable: true, release: false }

fn native_app_bundle_config_from_cli(input: &std::path::Path, base_name: String, config: &packager::config::RustNativeUiAppConfig, include_spirv: Bool) -> Result<kain_driver::NativeAppBundleConfig, kain_core::error::KainError>:
    Result::Ok(kain_driver::NativeAppBundleConfig { app_name: (*config).app_name.clone().filter(fn(value): (!value.trim().is_empty())).or_else(fn(): Option::Some(base_name.to_string())), window_title: (*config).window_title.clone().filter(fn(value): (!value.trim().is_empty())).or_else(fn(): Option::Some(base_name.to_string())), root_component: (*config).root_component.clone(), source_file_name: input.file_name().and_then(fn(value): value.to_str()).map(fn(value): value.to_string()), source_root: (absolute_path(input)?).parent().map(Path__to_path_buf), initial_window_size: (*config).initial_window_size, include_spirv: include_spirv })

fn rust_build_output_from_native_app_bundle(bundle: &kain_driver::NativeAppBundle) -> Result<RustBuildOutput, kain_core::error::KainError>:
    Result::Ok(RustBuildOutput { bundle: (*bundle).rust.bundle.clone(), spirv: (*bundle).rust.spirv.clone() })

fn resolve_project_dir(output_root: &std::path::Path, app_name: String, configured_output: Option<&std::path::PathBuf>) -> std::path::PathBuf:
    match configured_output:
        Some(path) if path.is_absolute() => path.clone()
        Some(path) => output_root.join(path)
        None => output_root.join(f"{app_name}-native-ui")

fn absolute_path(path: &std::path::Path) -> Result<std::path::PathBuf, kain_core::error::KainError>:
    if path.is_absolute():
        return Result::Ok(path.to_path_buf())
    let cwd = std__env__current_dir().map_err(fn(err): KainError__runtime(f"Failed to resolve current directory: {err}"))?
    Result::Ok(cwd.join(path))

fn resolve_workspace_root() -> Result<std::path::PathBuf, kain_core::error::KainError>:
    let cli_manifest_dir = PathBuf__from(env!("CARGO_MANIFEST_DIR"))
    let Some(workspace_root) = cli_manifest_dir.parent().and_then(Path__parent)
    Result::Ok(workspace_root.to_path_buf())

fn diff_paths(path: &std::path::Path, base: &std::path::Path) -> Option<std::path::PathBuf>:
    let path_components: Array<_> = path.components().collect()
    let base_components: Array<_> = base.components().collect()
    let shared_ = shared_path_prefix_len(&path_components, &base_components)
    if (shared_ == 0):
        return none
    let mut result = PathBuf__new_()
    for _ in range(shared_, base_components.len()):
        result.push("..")
        ()
    ()
    for component_ in &path_components[shared_..]:
        match component_:
            std__path__Component::Normal(part) => result.push(part)
            std__path__Component::CurDir => result.push(".")
            std__path__Component::ParentDir => result.push("..")
            std__path__Component::RootDir => ()
            std__path__Component::Prefix(prefix) => result.push(prefix.as_os_str())
    ()
    if result.as_os_str().is_empty():
        result.push(".")
        ()
        ()
        ()
        ()
    Option::Some(result)

fn shared_path_prefix_len(path: &[std::path::Component<_>], base: &[std::path::Component<_>]) -> usize:
    let mut shared_ = 0
    while (((shared_ < path.len()) && (shared_ < base.len())) && (path[shared_] == base[shared_])):
        shared_ = (shared_ + 1)
        ()
    ()
    shared_

