use crate::error::KainError

use crate::error::KainResult

use kain_asm::ImportAsmOutput

use std::path::Path

pub fn import_asm(input: &std::path::Path, format: String, out_kn: Option<&std::path::Path>, validate_only: Bool) -> Result<kain_asm::ImportAsmOutput, KainError>:
    kain_asm__import_asm(input, format, out_kn, validate_only).map_err(fn(e): KainError__runtime(e.to_string()))

