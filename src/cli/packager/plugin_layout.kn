use super::config::Ue5Config

use crate::error::KainError

use crate::error::KainResult

use std::collections::HashMap

use std::fs

use std::path::Path

use std::path::PathBuf

@doc(doc = " Holds all resolved directory paths and split-mode flags for the plugin build.")
pub struct PluginLayout:
    plugin_root: std::path::PathBuf
    source_dir: std::path::PathBuf
    shaders_dir: std::path::PathBuf
    public_dir: std::path::PathBuf
    private_dir: std::path::PathBuf
    editor_public_dir: Option<std::path::PathBuf>
    editor_private_dir: Option<std::path::PathBuf>
    needs_split: Bool
    has_editor_items: Bool
    has_runtime_items: Bool
    module_dirs: Map<String, (std::path::PathBuf, std::path::PathBuf)>

@doc(doc = " Detect whether the program has editor-specific items (Slate, Details, Viewport, etc.)")
@doc(doc = " Note: Graph editors are detected separately in the pipeline since they're extracted from AST before type checking")
pub fn detect_editor_items(program: &kain_core::types::TypedProgram) -> Bool:
    (*program).items.iter().any(fn(item): none)

@doc(doc = " Detect whether the program has runtime items (actors, components, enums, structs, shaders, etc.)")
pub fn detect_runtime_items(program: &kain_core::types::TypedProgram, has_shaders: Bool) -> Bool:
    ((*program).items.iter().any(fn(item): none) || has_shaders)

@doc(doc = " Set up the plugin directory structure, handling two-module split when needed.")
pub fn setup(config: &Ue5Config, cwd: &std::path::Path, program: &kain_core::types::TypedProgram, has_shaders: Bool, has_graph_editors: Bool) -> Result<PluginLayout, KainError>:
    let plugin_root = if ((*config).plugin_dir == PathBuf__from(".")):
        cwd.to_path_buf()
    else:
        cwd.join(&(*config).plugin_dir).join(&(*config).plugin_name)
    let source_dir = plugin_root.join("Source")
    let shaders_dir = plugin_root.join("Shaders")
    if config.has_module_plan():
        let mut module_dirs: Map<String, (std::path::PathBuf, std::path::PathBuf)> = HashMap__new_()
        for module in &(*config).modules:
            let base_dir = source_dir.join(&module.name)
            let public_dir = module.output.public_.clone().map(fn(p): if p.is_absolute(): p else: plugin_root.join(p)).unwrap_or_else(fn(): base_dir.join("Public"))
            let private_dir = module.output.private_.clone().map(fn(p): if p.is_absolute(): p else: plugin_root.join(p)).unwrap_or_else(fn(): base_dir.join("Private"))
            std__fs__create_dir_all(&public_dir).map_err(fn(e): KainError::Io(e))?
            ()
            std__fs__create_dir_all(&private_dir).map_err(fn(e): KainError::Io(e))?
            ()
            module_dirs.insert(module.name.clone(), (public_dir, private_dir))
            ()
        ()
        std__fs__create_dir_all(&shaders_dir).map_err(fn(e): KainError::Io(e))?
        ()
        let has_runtime_items = (*config).modules.iter().any(fn(m): none)
        let has_editor_items = (*config).modules.iter().any(fn(m): m.module_type.is_editorish())
        let needs_split = (has_runtime_items && has_editor_items)
        let runtime_module_name = (*config).modules.iter().find(fn(m): (none && (m.name == (*config).plugin_name))).or_else(fn(): (*config).modules.iter().find(fn(m): none)).map(fn(m): m.name.clone()).or_else(fn(): (*config).modules.first().map(fn(m): m.name.clone())).ok_or_else(fn(): KainError__runtime(("ue5.modules is configured but empty").to_string()))?
        let (public_dir, private_dir) = module_dirs.get(&runtime_module_name).cloned().ok_or_else(fn(): KainError__runtime(f"Primary module '{runtime_module_name}' has no resolved directories"))?
        let editor_module_name = (*config).modules.iter().find(fn(m): (m.module_type.is_editorish() && (m.name == f"{(*config).plugin_name}Editor"))).or_else(fn(): (*config).modules.iter().find(fn(m): m.module_type.is_editorish())).map(fn(m): m.name.clone())
        let (editor_public_dir, editor_private_dir) = match editor_module_name:
            Some(name) =>
                match module_dirs.get(&name):
                    Some((ed_pub, ed_priv)) => (Option::Some(ed_pub.clone()), Option::Some(ed_priv.clone()))
                    _ => (none, none)
            _ => (none, none)
        println(f"📦 Multi-module layout: {(*config).modules.len()} module(s)")
        return Result::Ok(PluginLayout { plugin_root: plugin_root, source_dir: source_dir, shaders_dir: shaders_dir, public_dir: public_dir, private_dir: private_dir, editor_public_dir: editor_public_dir, editor_private_dir: editor_private_dir, needs_split: needs_split, has_editor_items: has_editor_items, has_runtime_items: has_runtime_items, module_dirs: module_dirs })
    let has_editor_items = (detect_editor_items(program) || has_graph_editors)
    let has_runtime_items = detect_runtime_items(program, has_shaders)
    let needs_split = (has_runtime_items && has_editor_items)
    let (public_dir, private_dir, editor_public_dir, editor_private_dir) = if needs_split:
        let rt_dir = source_dir.join(&(*config).plugin_name)
        let ed_dir = source_dir.join(f"{(*config).plugin_name}Editor")
        let rt_pub = rt_dir.join("Public")
        let rt_priv = rt_dir.join("Private")
        let ed_pub = ed_dir.join("Public")
        let ed_priv = ed_dir.join("Private")
        std__fs__create_dir_all(&rt_pub).map_err(fn(e): KainError::Io(e))?
        ()
        std__fs__create_dir_all(&rt_priv).map_err(fn(e): KainError::Io(e))?
        ()
        std__fs__create_dir_all(&ed_pub).map_err(fn(e): KainError::Io(e))?
        ()
        std__fs__create_dir_all(&ed_priv).map_err(fn(e): KainError::Io(e))?
        ()
        println(f"📦 Two-module split: {(*config).plugin_name} (Runtime) + {(*config).plugin_name}Editor (Editor)")
        let stale_pub = source_dir.join("Public")
        let stale_priv = source_dir.join("Private")
        let stale_build_cs = source_dir.join(f"{(*config).plugin_name}.Build.cs")
        if stale_pub.exists():
            let _ = std__fs__remove_dir_all(&stale_pub)
            println("   🧹 Removed stale Source/Public (old single-module layout)")
            ()
            ()
        if stale_priv.exists():
            let _ = std__fs__remove_dir_all(&stale_priv)
            println("   🧹 Removed stale Source/Private (old single-module layout)")
            ()
            ()
        if stale_build_cs.exists():
            let _ = std__fs__remove_file(&stale_build_cs)
            println(f"   🧹 Removed stale Source/{(*config).plugin_name}.Build.cs (old single-module layout)")
            ()
            ()
        (rt_pub, rt_priv, Option::Some(ed_pub), Option::Some(ed_priv))
    else:
        let pub_dir = source_dir.join("Public")
        let priv_dir = source_dir.join("Private")
        std__fs__create_dir_all(&pub_dir).map_err(fn(e): KainError::Io(e))?
        ()
        std__fs__create_dir_all(&priv_dir).map_err(fn(e): KainError::Io(e))?
        ()
        if has_editor_items:
            let ed_pub = pub_dir.join("Editor")
            let ed_priv = priv_dir.join("Editor")
            std__fs__create_dir_all(&ed_pub).map_err(fn(e): KainError::Io(e))?
            ()
            std__fs__create_dir_all(&ed_priv).map_err(fn(e): KainError::Io(e))?
            ()
            ()
            ()
            ()
        (pub_dir, priv_dir, none, none)
    std__fs__create_dir_all(&shaders_dir).map_err(fn(e): KainError::Io(e))?
    ()
    Result::Ok(PluginLayout { plugin_root: plugin_root, source_dir: source_dir, shaders_dir: shaders_dir, public_dir: public_dir, private_dir: private_dir, editor_public_dir: editor_public_dir, editor_private_dir: editor_private_dir, needs_split: needs_split, has_editor_items: has_editor_items, has_runtime_items: has_runtime_items, module_dirs: HashMap__new_() })

@doc(doc = " Detect existing plugin layout without modifying it")
pub fn detect_existing(plugin_root: &std::path::Path, plugin_name: String) -> Result<PluginLayout, KainError>:
    let source_dir = plugin_root.join("Source")
    let shaders_dir = plugin_root.join("Shaders")
    if (!source_dir.exists()):
        return Result::Err(KainError__runtime(f"Plugin Source directory not found: {source_dir.display()}"))
    let runtime_module_dir = source_dir.join(plugin_name)
    let editor_module_dir = source_dir.join(f"{plugin_name}Editor")
    let needs_split = (runtime_module_dir.exists() && editor_module_dir.exists())
    let (public_dir, private_dir, editor_public_dir, editor_private_dir) = if needs_split:
        let rt_pub = runtime_module_dir.join("Public")
        let rt_priv = runtime_module_dir.join("Private")
        let ed_pub = editor_module_dir.join("Public")
        let ed_priv = editor_module_dir.join("Private")
        (rt_pub, rt_priv, Option::Some(ed_pub), Option::Some(ed_priv))
    else:
        let pub_dir = source_dir.join("Public")
        let priv_dir = source_dir.join("Private")
        if ((!pub_dir.exists()) || (!priv_dir.exists())):
            return Result::Err(KainError__runtime(f"Invalid plugin layout. Expected Public and Private directories in {source_dir.display()}"))
        (pub_dir, priv_dir, none, none)
    let has_editor_items = (editor_public_dir.is_some() || public_dir.join("Editor").exists())
    let has_runtime_items = true
    Result::Ok(PluginLayout { plugin_root: plugin_root.to_path_buf(), source_dir: source_dir, shaders_dir: shaders_dir, public_dir: public_dir, private_dir: private_dir, editor_public_dir: editor_public_dir, editor_private_dir: editor_private_dir, needs_split: needs_split, has_editor_items: has_editor_items, has_runtime_items: has_runtime_items, module_dirs: HashMap__new_() })

