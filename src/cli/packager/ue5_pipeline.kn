                                    ()
                                    ()
                            let source_path = effects_private_dir.join(f"{effect_def.name}.cpp")
                            match std__fs__write(&source_path, &output.source):
                                Err(e) => eprintln(f"   ⚠️  Failed to write {effect_def.name}.cpp: {e}")
                                _ => println(f"   ✓ {effect_def.name}.cpp ({output.source.lines().count()} lines)")
                        Err(e) => eprintln(f"   ⚠️  Failed to generate effect {effect_def.name}: {e}")
                Err(e) => eprintln(f"   ⚠️  Failed to convert effect {effect_def.name} to IR: {e}")
        ()
        println()
        ()
        ()
    if (!gameplay_cues.is_empty()):
        println()
        println(f"🎬 Generating {gameplay_cues.len()} GameplayCue(s)...")
        let cues_public_dir = layout.public_dir.join("Cues")
        let cues_private_dir = layout.private_dir.join("Cues")
        match std__fs__create_dir_all(&cues_public_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create Cues public dir: {e}")
                ()
                ()
            _ =>
                ()
