        for effect_def in &gameplay_effects:
            match GameplayEffectIR__from_ast(effect_def):
                Ok(effect_ir) =>
                    match ue5_gas__effect_codegen__generate(&effect_ir, &ue5_config.plugin_name):
                        Ok(output) =>
                            let header_path = effects_public_dir.join(f"{effect_def.name}.h")
                            match std__fs__write(&header_path, &output.header):
                                Err(e) =>
                                    eprintln(f"   ⚠️  Failed to write {effect_def.name}.h: {e}")
                                    ()
                                    ()
