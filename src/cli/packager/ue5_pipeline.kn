use super::config::Ue5Config

use super::post_process

use crate::error::KainError

use crate::error::KainResult

use kain_core::diagnostics::enhance_error_with_location

use kain_core::diagnostics::SpanMapper

use std::collections::HashMap

use std::collections::HashSet

use std::fs

use std::path::PathBuf

@doc(doc = " Helper function to enhance codegen errors with file:line:col location information")
@doc(doc = " Takes a Result from codegen and enhances any KainError::Codegen with location data")
fn enhance_codegen_result<T>(result: Result<T, KainError>, span_mapper: &kain_core::diagnostics::SpanMapper, file_path: String) -> Result<T, KainError>:
    result.map_err(fn(e): kain_core__diagnostics__enhance_error_with_location(e, span_mapper, file_path))

@doc(doc = " Metadata for a single generated binary asset, collected during the build")
@doc(doc = " for bulk-registration into AssetRegistry.bin.")
@cfg(feature = "ue5")
struct GeneratedAsset:
    package_name: String
    asset_name: String
    class_path: String

@doc(doc = " Build UE5 plugin from KAIN.toml configuration")
pub fn build_ue5_plugin() -> Result<(), KainError>:
    build_ue5_plugin_with_options(false)

@doc(doc = " Build UE5 plugin with options (embed KAIN markers, etc.)")
pub fn build_ue5_plugin_with_options(embed_kain: Bool) -> Result<(), KainError>:
    let cwd = std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from("."))
    let (manifest, ue5_config) = match load_manifest(&cwd):
        Ok(manifest) =>
            let ue5_config = (manifest.ue5.ok_or_else(fn(): KainError__runtime("No [ue5] section in KAIN.toml"))?).clone()
            (Option::Some(manifest), ue5_config)
        Err(_) =>
            println("ℹ\u{fe0f}  No KAIN.toml found, using auto-detection...")
            println()
            let config = create_default_config(&cwd)?
            (none, config)
    println(f"🚀 Building UE5 Plugin: {ue5_config.plugin_name}")
    println(f"📍 Plugin directory: {ue5_config.plugin_dir.display()}")
    println()
    let (typed_program, all_shader_names, stdlib_files, user_source_files, symbol_source_map, material_graphs, material_functions, graph_editors, graph_runtimes, gameplay_tags, gameplay_abilities, gameplay_effects, gameplay_cues, ability_tasks, target_actors) = load_and_parse_sources(&ue5_config, manifest, &cwd)?
    let layout = plugin_layout__setup(&ue5_config, &cwd, &typed_program, (!all_shader_names.is_empty()), (!graph_editors.is_empty()))?
    let shader_names = if ue5_config.shaders.is_empty():
        all_shader_names
    else:
        ue5_config.shaders.clone()
    codegen__compile_shaders(&layout, &ue5_config, &typed_program, &shader_names)?
    ()
    println(f"DEBUG: After shader compilation, target_actors.len() = {target_actors.len()}")
    let mut generated_assets: Array<GeneratedAsset> = Vec__new_()
    if (!material_graphs.is_empty()):
        println()
        println(f"🎨 Generating {material_graphs.len()} materials...")
        let surface_shader_hlsl: Map<String, String> = none
        if (!surface_shader_hlsl.is_empty()):
            println(f"   🔗 Shader bridge: {surface_shader_hlsl.len()} Surface shader(s) available for material injection")
            ()
            ()
        let mat_content_dir = layout.plugin_root.join("Content").join("Materials")
        match std__fs__create_dir_all(&mat_content_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create materials content dir: {e}")
                ()
                ()
            _ =>
                ()
                ()
        let mut converted_graphs = Vec__new_()
        for mat_def in &material_graphs:
            match convert_material_graph(mat_def, &surface_shader_hlsl):
                Ok(graph) =>
                    match ue5_materials__material_serializer__serialize_material_graph(&graph, KainEngineTarget__default_()):
                        Ok(bytes) =>
                            let path = mat_content_dir.join(f"{graph.name}.uasset")
                            match std__fs__write(&path, &bytes):
                                Err(e) =>
                                    eprintln(f"   ⚠️  Failed to write .uasset for {graph.name}: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"   ✓ Binary material asset: {graph.name} ({bytes.len()} bytes)")
                                    generated_assets.push(GeneratedAsset { package_name: f"/Game/Materials/{graph.name}", asset_name: graph.name.clone(), class_path: "/Script/Engine.Material" })
                                    ()
                                    ()
                                    ()
                                    ()
                            ()
                        Err(e) =>
                            println(f"   ℹ️  Binary generation failed for {graph.name}: {e}")
                            println("       Falling back to C++ factory...")
                            ()
                            ()
                    converted_graphs.push(graph)
                    ()
                Err(e) => eprintln(f"   ⚠️  Failed to convert material {mat_def.name}: {e}")
        ()
        if (!converted_graphs.is_empty()):
            material_gen__generate_material_factories(&ue5_config.plugin_name, &converted_graphs, &layout.private_dir)?
            ()
            ()
            ()
            ()
        println()
        ()
        ()
    if (!material_functions.is_empty()):
        println()
        println(f"🔧 Generating {material_functions.len()} material functions...")
        let func_content_dir = layout.plugin_root.join("Content").join("Materials").join("Functions")
        match std__fs__create_dir_all(&func_content_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create material functions content dir: {e}")
                ()
                ()
            _ =>
                ()
                ()
        for func_def in &material_functions:
            match convert_material_function(func_def):
                Ok(func_ir) =>
                    match ue5_materials__material_function_builder__serialize_material_function(&func_ir):
                        Ok(bytes) =>
                            let path = func_content_dir.join(f"MF_{func_def.name}.uasset")
                            match std__fs__write(&path, &bytes):
                                Err(e) => eprintln(f"   ⚠️  Failed to write .uasset for {func_def.name}: {e}")
                                _ =>
                                    println(f"   ✓ Material function: MF_{func_def.name} ({bytes.len()} bytes)")
                                    generated_assets.push(GeneratedAsset { package_name: f"/Game/Materials/Functions/MF_{func_def.name}", asset_name: f"MF_{func_def.name}", class_path: "/Script/Engine.MaterialFunction" })
                                    ()
                        Err(e) => eprintln(f"   ⚠️  Failed to serialize material function {func_def.name}: {e}")
                Err(e) => eprintln(f"   ⚠️  Failed to convert material function {func_def.name}: {e}")
        ()
        println()
        ()
        ()
    if (!graph_editors.is_empty()):
        println()
        println(f"📊 Generating {graph_editors.len()} graph editors...")
        let graph_content_dir = layout.plugin_root.join("Content").join("Graphs")
        match std__fs__create_dir_all(&graph_content_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create graphs content dir: {e}")
                ()
                ()
            _ =>
                ()
                ()
        let (runtime_graphs, editor_graphs): (Array<_>, Array<_>) = graph_editors.iter().partition(fn(g): g.attributes.iter().any(fn(a): (a.name == "runtime_graph")))
        for graph_def in &editor_graphs:
            match ue5_graphs__generate_graph_editor(graph_def, &ue5_config.plugin_name):
                Ok(output) =>
                    if (!output.uasset.is_empty()):
                        let uasset_path = graph_content_dir.join(f"{graph_def.name}.uasset")
                        match std__fs__write(&uasset_path, &output.uasset):
                            Err(e) =>
                                eprintln(f"   ⚠️  Failed to write .uasset for {graph_def.name}: {e}")
                                ()
                                ()
                            _ =>
                                println(f"   ✓ Graph editor asset: {graph_def.name} ({output.uasset.len()} bytes)")
                                generated_assets.push(GeneratedAsset { package_name: f"/Game/Graphs/{graph_def.name}", asset_name: graph_def.name.clone(), class_path: "/Script/Engine.EdGraph" })
                                ()
                                ()
                                ()
                                ()
                        ()
                    if (!output.header.is_empty()):
                        let header_path = match layout.editor_public_dir:
                            Some(editor_pub) => editor_pub.join(f"{graph_def.name}Factory.h")
                            _ => layout.public_dir.join(f"{graph_def.name}Factory.h")
                        match std__fs__write(&header_path, &output.header):
                            Err(e) =>
                                eprintln(f"   ⚠️  Failed to write factory header for {graph_def.name}: {e}")
                                ()
                                ()
                            _ =>
                                println(f"   ✓ Factory header: {graph_def.name}Factory.h")
                                ()
                                ()
                        ()
                    if (!output.source.is_empty()):
                        let source_path = match layout.editor_private_dir:
                            Some(editor_priv) => editor_priv.join(f"{graph_def.name}Factory.cpp")
                            _ => layout.private_dir.join(f"{graph_def.name}Factory.cpp")
                        match std__fs__write(&source_path, &output.source):
                            Err(e) => eprintln(f"   ⚠️  Failed to write factory source for {graph_def.name}: {e}")
                            _ => println(f"   ✓ Factory source: {graph_def.name}Factory.cpp")
                Err(e) => eprintln(f"   ⚠️  Failed to generate graph editor {graph_def.name}: {e}")
        ()
        if (!runtime_graphs.is_empty()):
            println()
            println(f"⚡ Generating {runtime_graphs.len()} runtime graph(s)...")
            for graph_def in &runtime_graphs:
                match ue5_graphs__convert_runtime_graph(graph_def):
                    Ok(runtime_ir) =>
                        let mut graph_editor = GraphEditor__new_(&runtime_ir.name)
                        for node_data in &runtime_ir.node_types:
                            let node_type = ue5_graphs::NodeType { name: node_data.name.clone(), category: node_data.category.clone(), inputs: node_data.input_pins.iter().map(fn(p): ue5_graphs::PinDefinition { name: p.name.clone(), pin_type: none, is_array: p.is_array, default_value: p.default_value.clone(), tooltip: p.tooltip.clone() }).collect(), outputs: node_data.output_pins.iter().map(fn(p): ue5_graphs::PinDefinition { name: p.name.clone(), pin_type: none, is_array: p.is_array, default_value: p.default_value.clone(), tooltip: p.tooltip.clone() }).collect(), properties: node_data.properties.iter().map(fn(prop): ue5_graphs::PropertyDefinition { name: prop.name.clone(), property_type: prop.property_type, default_value: prop.default_value.clone() }).collect(), color: node_data.color, icon: node_data.icon.clone(), tooltip: node_data.tooltip.clone(), execution_logic: none }
                            graph_editor.add_node_type(node_type)
                            ()
                        ()
                        let node_gen = NodeDataGenerator__new_(&graph_editor, &ue5_config.plugin_name)
                        match node_gen.generate():
                            Ok(node_output) =>
                                let public_dir = layout.public_dir.clone()
                                match std__fs__create_dir_all(&public_dir):
                                    Err(e) =>
                                        eprintln(f"   ⚠️  Failed to create Public dir: {e}")
                                        ()
                                        ()
                                    _ =>
                                        ()
                                        ()
                                let pin_data_path = public_dir.join(&node_output.pin_data_header.field_0)
                                match std__fs__write(&pin_data_path, &node_output.pin_data_header.field_1):
                                    Err(e) =>
                                        eprintln(f"   ⚠️  Failed to write pin data header: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f"   ✓ Pin data: {node_output.pin_data_header.field_0}")
                                        ()
                                        ()
                                for selfhost_for_item in &node_output.node_data_headers:
                                    let (filename, header) = selfhost_for_item
                                    let path = public_dir.join(filename)
                                    match std__fs__write(&path, header):
                                        Err(e) => eprintln(f"   ⚠️  Failed to write node data header {filename}: {e}")
                                        _ => println(f"   ✓ Node data: {filename}")
                                ()
                                let private_dir = layout.private_dir.clone()
                                match std__fs__create_dir_all(&private_dir):
                                    Err(e) =>
                                        eprintln(f"   ⚠️  Failed to create Private dir: {e}")
                                        ()
                                        ()
                                    _ =>
                                        ()
                                        ()
                                for selfhost_for_item in &node_output.node_data_sources:
                                    let (filename, source) = selfhost_for_item
                                    let path = private_dir.join(filename)
                                    match std__fs__write(&path, source):
                                        Err(e) => eprintln(f"   ⚠️  Failed to write node data source {filename}: {e}")
                                        _ => println(f"   ✓ Node data: {filename}")
                                ()
                                ()
                            Err(e) =>
                                eprintln(f"   ⚠️  Failed to generate node data for {runtime_ir.name}: {e}")
                                ()
                                ()
                        let instance_gen = InstanceGenerator__new_(&graph_editor, &ue5_config.plugin_name)
                        match instance_gen.generate():
                            Ok(instance_output) =>
                                let public_dir = layout.public_dir.clone()
                                let private_dir = layout.private_dir.clone()
                                let header_path = public_dir.join(&instance_output.instance_header.field_0)
                                match std__fs__write(&header_path, &instance_output.instance_header.field_1):
                                    Err(e) =>
                                        eprintln(f"   ⚠️  Failed to write instance header: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f"   ✓ Instance: {instance_output.instance_header.field_0}")
                                        ()
                                        ()
                                let source_path = private_dir.join(&instance_output.instance_source.field_0)
                                match std__fs__write(&source_path, &instance_output.instance_source.field_1):
                                    Err(e) =>
                                        eprintln(f"   ⚠️  Failed to write instance source: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f"   ✓ Instance: {instance_output.instance_source.field_0}")
                                        ()
                                        ()
                                ()
                            Err(e) =>
                                eprintln(f"   ⚠️  Failed to generate instance for {runtime_ir.name}: {e}")
                                ()
                                ()
                        match ue5_graphs__generate_graph_data_header(&graph_editor, &ue5_config.plugin_name):
                            Ok(header) =>
                                let public_dir = layout.public_dir.clone()
                                let path = public_dir.join(f"{runtime_ir.name}GraphData.h")
                                match std__fs__write(&path, &header):
                                    Err(e) =>
                                        eprintln(f"   ⚠️  Failed to write graph data header: {e}")
                                        ()
                                        ()
                                    _ =>
                                        println(f"   ✓ Graph data: {runtime_ir.name}GraphData.h")
                                        ()
                                        ()
                                ()
                            Err(e) =>
                                eprintln(f"   ⚠️  Failed to generate graph data header: {e}")
                                ()
                                ()
                        match ue5_graphs__generate_graph_data_source(&graph_editor, &ue5_config.plugin_name):
                            Ok(source) =>
                                let private_dir = layout.private_dir.clone()
                                let path = private_dir.join(f"{runtime_ir.name}GraphData.cpp")
                                match std__fs__write(&path, &source):
                                    Err(e) => eprintln(f"   ⚠️  Failed to write graph data source: {e}")
                                    _ => println(f"   ✓ Graph data: {runtime_ir.name}GraphData.cpp")
                            Err(e) => eprintln(f"   ⚠️  Failed to generate graph data source: {e}")
                    Err(e) => eprintln(f"   ⚠️  Failed to convert runtime graph {graph_def.name}: {e}")
            ()
            ()
        println()
        ()
        ()
    if (!graph_runtimes.is_empty()):
        println()
        println(f"⚡ Generating {graph_runtimes.is_empty()} runtime graph system(s)...")
        for graph_runtime_def in &graph_runtimes:
            println(f"   📊 Processing runtime graph: {graph_runtime_def.name}")
            match ue5_graphs__convert_graph_runtime_to_ir(graph_runtime_def):
                Ok(runtime_ir) =>
                    let mut graph_editor = GraphEditor__new_(&runtime_ir.name)
                    for node_data in &runtime_ir.node_types:
                        let node_type = ue5_graphs::NodeType { name: node_data.name.clone(), category: node_data.category.clone(), inputs: node_data.input_pins.iter().map(fn(p): ue5_graphs::PinDefinition { name: p.name.clone(), pin_type: none, is_array: p.is_array, default_value: p.default_value.clone(), tooltip: p.tooltip.clone() }).collect(), outputs: node_data.output_pins.iter().map(fn(p): ue5_graphs::PinDefinition { name: p.name.clone(), pin_type: none, is_array: p.is_array, default_value: p.default_value.clone(), tooltip: p.tooltip.clone() }).collect(), properties: node_data.properties.iter().map(fn(prop): ue5_graphs::PropertyDefinition { name: prop.name.clone(), property_type: prop.property_type, default_value: prop.default_value.clone() }).collect(), color: node_data.color, icon: node_data.icon.clone(), tooltip: node_data.tooltip.clone(), execution_logic: none }
                        graph_editor.add_node_type(node_type)
                        ()
                    ()
                    let node_gen = NodeDataGenerator__new_(&graph_editor, &ue5_config.plugin_name)
                    match node_gen.generate():
                        Ok(node_output) =>
                            let pin_data_path = layout.public_dir.join(&node_output.pin_data_header.field_0)
                            match std__fs__write(&pin_data_path, &node_output.pin_data_header.field_1):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write pin data header: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {node_output.pin_data_header.field_0}")
                                    ()
                                    ()
                            let pin_data_src_path = layout.private_dir.join(&node_output.pin_data_source.field_0)
                            match std__fs__write(&pin_data_src_path, &node_output.pin_data_source.field_1):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write pin data source: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {node_output.pin_data_source.field_0}")
                                    ()
                                    ()
                            let base_header_path = layout.public_dir.join(&node_output.base_header.field_0)
                            match std__fs__write(&base_header_path, &node_output.base_header.field_1):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write base node data header: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {node_output.base_header.field_0}")
                                    ()
                                    ()
                            let base_source_path = layout.private_dir.join(&node_output.base_source.field_0)
                            match std__fs__write(&base_source_path, &node_output.base_source.field_1):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write base node data source: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {node_output.base_source.field_0}")
                                    ()
                                    ()
                            for selfhost_for_item in &node_output.node_data_headers:
                                let (filename, header) = selfhost_for_item
                                let path = layout.public_dir.join(filename)
                                match std__fs__write(&path, header):
                                    Err(e) => eprintln(f"      ⚠️  Failed to write node data header {filename}: {e}")
                                    _ => println(f"      ✓ {filename}")
                            ()
                            for selfhost_for_item in &node_output.node_data_sources:
                                let (filename, source) = selfhost_for_item
                                let path = layout.private_dir.join(filename)
                                match std__fs__write(&path, source):
                                    Err(e) => eprintln(f"      ⚠️  Failed to write node data source {filename}: {e}")
                                    _ => println(f"      ✓ {filename}")
                            ()
                            ()
                        Err(e) =>
                            eprintln(f"      ⚠️  Failed to generate node data for {runtime_ir.name}: {e}")
                            ()
                            ()
                    let instance_gen = InstanceGenerator__new_(&graph_editor, &ue5_config.plugin_name)
                    match instance_gen.generate():
                        Ok(instance_output) =>
                            let header_path = layout.public_dir.join(&instance_output.instance_header.field_0)
                            match std__fs__write(&header_path, &instance_output.instance_header.field_1):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write instance header: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {instance_output.instance_header.field_0}")
                                    ()
                                    ()
                            let source_path = layout.private_dir.join(&instance_output.instance_source.field_0)
                            match std__fs__write(&source_path, &instance_output.instance_source.field_1):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write instance source: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {instance_output.instance_source.field_0}")
                                    ()
                                    ()
                            ()
                        Err(e) =>
                            eprintln(f"      ⚠️  Failed to generate instance for {runtime_ir.name}: {e}")
                            ()
                            ()
                    let asset_gen = AssetGenerator__new_(&graph_editor, &ue5_config.plugin_name)
                    match asset_gen.generate():
                        Ok(asset_output) =>
                            let asset_header_path = layout.public_dir.join(&asset_output.asset_header.field_0)
                            match std__fs__write(&asset_header_path, &asset_output.asset_header.field_1):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write asset header: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {asset_output.asset_header.field_0}")
                                    ()
                                    ()
                            let asset_source_path = layout.private_dir.join(&asset_output.asset_source.field_0)
                            match std__fs__write(&asset_source_path, &asset_output.asset_source.field_1):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write asset source: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {asset_output.asset_source.field_0}")
                                    ()
                                    ()
                            ()
                        Err(e) =>
                            eprintln(f"      ⚠️  Failed to generate asset for {runtime_ir.name}: {e}")
                            ()
                            ()
                    match ue5_graphs__generate_graph_data_header(&graph_editor, &ue5_config.plugin_name):
                        Ok(header) =>
                            let path = layout.public_dir.join(f"{runtime_ir.name}GraphData.h")
                            match std__fs__write(&path, &header):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write graph data header: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {runtime_ir.name}GraphData.h")
                                    ()
                                    ()
                            ()
                        Err(e) =>
                            eprintln(f"      ⚠️  Failed to generate graph data header: {e}")
                            ()
                            ()
                    match ue5_graphs__generate_graph_data_source(&graph_editor, &ue5_config.plugin_name):
                        Ok(source) =>
                            let path = layout.private_dir.join(f"{runtime_ir.name}GraphData.cpp")
                            match std__fs__write(&path, &source):
                                Err(e) =>
                                    eprintln(f"      ⚠️  Failed to write graph data source: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"      ✓ {runtime_ir.name}GraphData.cpp")
                                    ()
                                    ()
                            ()
                        Err(e) =>
                            eprintln(f"      ⚠️  Failed to generate graph data source: {e}")
                            ()
                            ()
                    println(f"      ✅ Runtime graph system complete: {runtime_ir.name}")
                Err(e) =>
                    eprintln(f"      ❌ Failed to convert runtime graph {graph_runtime_def.name} to IR: {e}")
                    eprintln(f"         Error: {e}")
        ()
        println()
        ()
        ()
    let actors: Array<&kain_core::ast::Actor> = typed_program.items.iter().filter_map(fn(item): none).collect()
    if (!actors.is_empty()):
        println(f"📐 Generating Blueprints for {actors.len()} actors...")
        let bp_content_dir = layout.plugin_root.join("Content").join("Blueprints")
        match std__fs__create_dir_all(&bp_content_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create blueprints content dir: {e}")
                ()
                ()
            _ =>
                ()
                ()
        let factory_dir = layout.private_dir.join("Generated").join("Factories")
        match std__fs__create_dir_all(&factory_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create factory dir: {e}")
                ()
                ()
            _ =>
                ()
                ()
        for actor_ in actors:
            match ue5_blueprints__conversion__from_ast(actor_):
                Ok(bp_ir) =>
                    match ue5_blueprints__generate_uasset(&bp_ir):
                        Ok(Some(bytes)) =>
                            let path = bp_content_dir.join(f"{bp_ir.name}.uasset")
                            match std__fs__write(&path, &bytes):
                                Ok(_) =>
                                    println(f"   ✓ Binary blueprint: {bp_ir.name} ({bytes.len()} bytes)")
                                    generated_assets.push(GeneratedAsset { package_name: f"/Game/Blueprints/{bp_ir.name}", asset_name: bp_ir.name.clone(), class_path: "/Script/Engine.Blueprint" })
                                    ()
                                Err(e) => eprintln(f"   ⚠️  Failed to write .uasset for {bp_ir.name}: {e}")
                        Ok(None) =>
                            println(f"   ℹ️  {bp_ir.name} has event graph, using C++ factory fallback.")
                            let (header, source) = ue5_blueprints__generate_factory(&bp_ir)
                            let h_path = factory_dir.join(f"{bp_ir.name}Factory.h")
                            let cpp_path = factory_dir.join(f"{bp_ir.name}Factory.cpp")
                            let _ = std__fs__write(&h_path, header)
                            let _ = std__fs__write(&cpp_path, source)
                        Err(e) => eprintln(f"   ❌ Blueprint generation error for {bp_ir.name}: {e}")
                Err(e) => eprintln(f"   ❌ Failed to convert actor {actor_.name} to blueprint IR: {e}")
        ()
        println()
        ()
        ()
    ()
    use ue5_editor::data_asset_writer::fields_from_struct

    use ue5_editor::data_asset_writer::resolve_data_asset_class

    use ue5_editor::data_asset_writer::write_data_asset

    let data_asset_structs: Array<&kain_core::ast::Struct> = typed_program.items.iter().filter_map(fn(item): none).collect()
    if (!data_asset_structs.is_empty()):
        println(f"📦 Generating {data_asset_structs.len()} DataAsset(s)...")
        let da_content_dir = layout.plugin_root.join("Content").join("DataAssets")
        match std__fs__create_dir_all(&da_content_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create DataAssets content dir: {e}")
                ()
                ()
            _ =>
                ()
                ()
        let engine_ver = ue5_config.engine_version.and_then(parse_engine_version).unwrap_or_else(fn(): KainEngineTarget__default_().as_serializer_version())
        for st in data_asset_structs:
            let class_path = ue5_editor__data_asset_writer__resolve_data_asset_class(&st.attributes)
            let fields = ue5_editor__data_asset_writer__fields_from_struct(st)
            let asset_name = &st.name
            match ue5_editor__data_asset_writer__write_data_asset(asset_name, &class_path, &fields, engine_ver):
                Ok(bytes) =>
                    let path = da_content_dir.join(f"{asset_name}.uasset")
                    match std__fs__write(&path, &bytes):
                        Ok(_) =>
                            println(f"   ✓ DataAsset: {asset_name} ({bytes.len()} bytes, class: {class_path})")
                            generated_assets.push(GeneratedAsset { package_name: f"/Game/DataAssets/{asset_name}", asset_name: asset_name.clone(), class_path: "/Script/Engine.DataAsset" })
                            ()
                        Err(e) => eprintln(f"   ⚠️  Failed to write DataAsset {asset_name}: {e}")
                Err(e) => eprintln(f"   ⚠️  Failed to generate DataAsset {asset_name}: {e}")
        ()
        println()
        ()
        ()
    ()
    if (!gameplay_tags.is_empty()):
        println()
        println(f"🏷️  Generating {gameplay_tags.len()} GameplayTags namespace(s)...")
        let tags_config_dir = layout.plugin_root.join("Config").join("Tags")
        match std__fs__create_dir_all(&tags_config_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create Config/Tags dir: {e}")
                ()
                ()
            _ =>
                ()
                ()
        match GameplayTagsIR__from_ast(gameplay_tags.clone()):
            Ok(tags_ir) =>
                match ue5_gas__tags_codegen__generate(&tags_ir, &ue5_config.plugin_name):
                    Ok(output) =>
                        let header_path = layout.public_dir.join("GameplayTags.h")
                        match std__fs__write(&header_path, &output.header):
                            Err(e) =>
                                eprintln(f"   ⚠️  Failed to write GameplayTags.h: {e}")
                                ()
                                ()
                            _ =>
                                println(f"   ✓ GameplayTags.h ({output.header.lines().count()} lines)")
                                ()
                                ()
                        let impl_path = layout.private_dir.join("GameplayTags.cpp")
                        match std__fs__write(&impl_path, &output.implementation):
                            Err(e) =>
                                eprintln(f"   ⚠️  Failed to write GameplayTags.cpp: {e}")
                                ()
                                ()
                            _ =>
                                println(f"   ✓ GameplayTags.cpp ({output.implementation.lines().count()} lines)")
                                ()
                                ()
                        let ini_path = tags_config_dir.join("DefaultGameplayTags.ini")
                        match std__fs__write(&ini_path, &output.ini_file):
                            Err(e) =>
                                eprintln(f"   ⚠️  Failed to write DefaultGameplayTags.ini: {e}")
                                ()
                                ()
                            _ =>
                                println(f"   ✓ DefaultGameplayTags.ini ({tags_ir.all_tags().len()} tags)")
                                ()
                                ()
                        ()
                    Err(e) =>
                        eprintln(f"   ⚠️  Failed to generate GameplayTags: {e}")
                        ()
                        ()
                ()
            Err(e) =>
                eprintln(f"   ⚠️  Failed to convert GameplayTags to IR: {e}")
                ()
                ()
        println()
        ()
        ()
    if (!gameplay_abilities.is_empty()):
        println()
        println(f"⚡ Generating {gameplay_abilities.len()} GameplayAbility(ies)...")
        let abilities_public_dir = layout.public_dir.join("Abilities")
        let abilities_private_dir = layout.private_dir.join("Abilities")
        match std__fs__create_dir_all(&abilities_public_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create Abilities public dir: {e}")
                ()
                ()
            _ =>
                ()
                ()
        match std__fs__create_dir_all(&abilities_private_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create Abilities private dir: {e}")
                ()
                ()
            _ =>
                ()
                ()
        for ability_def in &gameplay_abilities:
            match GameplayAbilityIR__from_ast(ability_def):
                Ok(ability_ir) =>
                    match ue5_gas__ability_codegen__generate(&ability_ir, &ue5_config.plugin_name):
                        Ok(output) =>
                            let header_path = abilities_public_dir.join(f"{ability_def.name}.h")
                            match std__fs__write(&header_path, &output.header):
                                Err(e) =>
                                    eprintln(f"   ⚠️  Failed to write {ability_def.name}.h: {e}")
                                    ()
                                    ()
                                _ =>
                                    println(f"   ✓ {ability_def.name}.h ({output.header.lines().count()} lines)")
                                    ()
                                    ()
                            let source_path = abilities_private_dir.join(f"{ability_def.name}.cpp")
                            match std__fs__write(&source_path, &output.source):
                                Err(e) => eprintln(f"   ⚠️  Failed to write {ability_def.name}.cpp: {e}")
                                _ => println(f"   ✓ {ability_def.name}.cpp ({output.source.lines().count()} lines)")
                        Err(e) => eprintln(f"   ⚠️  Failed to generate ability {ability_def.name}: {e}")
                Err(e) => eprintln(f"   ⚠️  Failed to convert ability {ability_def.name} to IR: {e}")
        ()
        println()
        ()
        ()
    if (!gameplay_effects.is_empty()):
        println()
        println(f"💥 Generating {gameplay_effects.len()} GameplayEffect(s)...")
        let effects_public_dir = layout.public_dir.join("Effects")
        let effects_private_dir = layout.private_dir.join("Effects")
        match std__fs__create_dir_all(&effects_public_dir):
            Err(e) =>
                eprintln(f"   ⚠️  Failed to create Effects public dir: {e}")
                ()
                ()
            _ =>
