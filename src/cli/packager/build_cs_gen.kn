use super::dependencies::Dependencies

use std::collections::BTreeSet

@doc(doc = " Detect whether the program has @datatable structs (FTableRowBase usage).")
pub fn has_datatable_structs(program: &kain_core::types::TypedProgram) -> Bool:
    (*program).items.iter().any(fn(item): none)

@doc(doc = " Detect whether the program has @viewport items (requires AdvancedPreviewScene for SEditorViewport.h).")
pub fn has_viewport_items(program: &kain_core::types::TypedProgram) -> Bool:
    (*program).items.iter().any(fn(item): none)

@doc(doc = " Detect whether the program has @toolbar items (requires ToolMenus module).")
pub fn has_toolbar_items(program: &kain_core::types::TypedProgram) -> Bool:
    (*program).items.iter().any(fn(item): none)

@doc(doc = " Format a sorted set of module names as C# string array entries (indented with tabs).")
fn format_dep_list(deps: &Set<String>, indent: String) -> String:
    deps.iter().map(fn(d): f"{indent}\"{d}\"").collect().join(",\n")

@doc(doc = " Generate a generic .Build.cs for an explicitly configured module.")
@doc(doc = "")
@doc(doc = " This is used by the data-driven multi-module mode and keeps legacy")
@doc(doc = " single/split generators untouched.")
pub fn generate_build_cs_module(module_name: String, public_deps: &[String], private_deps: &[String]) -> String:
    let mut public_: Set<String> = BTreeSet__new_()
    let mut private_: Set<String> = BTreeSet__new_()
    for dep in public_deps:
        public_.insert(dep.clone())
        ()
    ()
    for dep in private_deps:
        private_.insert(dep.clone())
        ()
    ()
    let public_list = format_dep_list(&public_, "\t\t\t\t")
    let private_list = format_dep_list(&private_, "\t\t\t\t")
    "// Generated by KAIN-PRO Compiler — Data-Driven Module\nusing UnrealBuildTool;\nusing System.IO;\n\npublic class {module_name} : ModuleRules\n{\n\tpublic {module_name}(ReadOnlyTargetRules Target) : base(Target)\n\t{\n\t\tPCHUsage = ModuleRules.PCHUsageMode.UseExplicitOrSharedPCHs;\n\n\t\tPublicDependencyModuleNames.AddRange(\n\t\t\tnew string[]\n\t\t\t{\n{public_list}\n\t\t\t}\n\t\t);\n\n\t\tPrivateDependencyModuleNames.AddRange(\n\t\t\tnew string[]\n\t\t\t{\n{private_list}\n\t\t\t}\n\t\t);\n\t}\n}\n"

@doc(doc = " Generate a .Build.cs file for the UE5 plugin module (single-module mode).")
@doc(doc = " `extra_public_deps` and `extra_private_deps` are resolved from the module graph.")
pub fn generate_build_cs(plugin_name: String, has_editor_items: Bool, extra_public_deps: &[String], extra_private_deps: &[String]) -> String:
    let mut public_deps: Set<String> = (["Core", "CoreUObject", "Engine", "Projects"]).iter().map(fn(s): s.to_string()).collect()
    for dep in extra_public_deps:
        public_deps.insert(dep.clone())
        ()
    ()
    let mut private_deps: Set<String> = BTreeSet__new_()
    for dep in extra_private_deps:
        private_deps.insert(dep.clone())
        ()
    ()
    if has_editor_items:
        for dep in &["Slate", "SlateCore", "UnrealEd", "AssetTools", "EditorStyle", "PropertyEditor", "InputCore"]:
            private_deps.insert(dep.to_string())
            ()
        ()
        ()
    let public_list = format_dep_list(&public_deps, "\t\t\t\t")
    let private_list = format_dep_list(&private_deps, "\t\t\t\t")
    let include_paths = if has_editor_items:
        "\n\t\tPublicIncludePaths.AddRange(\n\t\t\tnew string[] {\n\t\t\t\tSystem.IO.Path.Combine(ModuleDirectory, \"Public/Editor\")\n\t\t\t}\n\t\t);\n\t\t\t\t\n\t\tPrivateIncludePaths.AddRange(\n\t\t\tnew string[] {\n\t\t\t\tSystem.IO.Path.Combine(ModuleDirectory, \"Private/Editor\")\n\t\t\t}\n\t\t);"
    else:
        ""
    "// Generated by KAIN-PRO Compiler\nusing UnrealBuildTool;\nusing System.IO;\n\npublic class {plugin_name} : ModuleRules\n{\n\tpublic {plugin_name}(ReadOnlyTargetRules Target) : base(Target)\n\t{\n\t\tPCHUsage = ModuleRules.PCHUsageMode.UseExplicitOrSharedPCHs;\n\t\t{include_paths}\n\t\tPublicDependencyModuleNames.AddRange(\n\t\t\tnew string[]\n\t\t\t{\n{public_list}\n\t\t\t}\n\t\t);\n\n\t\tPrivateDependencyModuleNames.AddRange(\n\t\t\tnew string[]\n\t\t\t{\n{private_list}\n\t\t\t}\n\t\t);\n\t}\n}\n"

@doc(doc = " Generate a .Build.cs for the RUNTIME module in split mode.")
@doc(doc = " `extra_public_deps` are resolved from the module graph based on referenced types/APIs.")
@doc(doc = " `has_datatable` is retained for compatibility; FTableRowBase is in Engine module.")
pub fn generate_build_cs_runtime(plugin_name: String, extra_public_deps: &[String], has_datatable: Bool) -> String:
    let mut public_deps: Set<String> = (["Core", "CoreUObject", "Engine", "Projects"]).iter().map(fn(s): s.to_string()).collect()
    if has_datatable:
        public_deps.insert(("Engine").to_string())
        ()
        ()
        ()
        ()
    for dep in extra_public_deps:
        public_deps.insert(dep.clone())
        ()
    ()
    let public_list = format_dep_list(&public_deps, "\t\t\t\t")
    "// Generated by KAIN-PRO Compiler — Runtime Module\nusing UnrealBuildTool;\nusing System.IO;\n\npublic class {plugin_name} : ModuleRules\n{\n\tpublic {plugin_name}(ReadOnlyTargetRules Target) : base(Target)\n\t{\n\t\tPCHUsage = ModuleRules.PCHUsageMode.UseExplicitOrSharedPCHs;\n\n\t\tPublicDependencyModuleNames.AddRange(\n\t\t\tnew string[]\n\t\t\t{\n{public_list}\n\t\t\t}\n\t\t);\n\t}\n}\n"

@doc(doc = " Generate a .Build.cs for the EDITOR module in split mode.")
@doc(doc = " `extra_public_deps` and `extra_private_deps` are resolved from the module graph.")
@doc(doc = " `has_viewport` adds AdvancedPreviewScene required for SEditorViewport.h.")
@doc(doc = " `has_toolbar` adds ToolMenus required for toolbar extensions.")
pub fn generate_build_cs_editor(plugin_name: String, extra_public_deps: &[String], extra_private_deps: &[String], has_viewport: Bool, has_toolbar: Bool) -> String:
    let editor_module_name = f"{plugin_name}Editor"
    let mut public_deps: Set<String> = (["Core", "CoreUObject", "Engine"]).iter().map(fn(s): s.to_string()).collect()
    public_deps.insert(plugin_name.to_string())
    ()
    for dep in extra_public_deps:
        public_deps.insert(dep.clone())
        ()
    ()
    let mut private_deps: Set<String> = (["Slate", "SlateCore", "UnrealEd", "AssetTools", "EditorStyle", "PropertyEditor", "InputCore", "Projects"]).iter().map(fn(s): s.to_string()).collect()
    if has_viewport:
        private_deps.insert(("AdvancedPreviewScene").to_string())
        ()
        ()
        ()
        ()
    if has_toolbar:
        private_deps.insert(("ToolMenus").to_string())
        ()
        ()
        ()
        ()
    for dep in extra_private_deps:
        private_deps.insert(dep.clone())
        ()
    ()
    let public_list = format_dep_list(&public_deps, "\t\t\t\t")
    let private_list = format_dep_list(&private_deps, "\t\t\t\t")
    "// Generated by KAIN-PRO Compiler — Editor Module\nusing UnrealBuildTool;\nusing System.IO;\n\npublic class {editor_module_name} : ModuleRules\n{\n\tpublic {editor_module_name}(ReadOnlyTargetRules Target) : base(Target)\n\t{\n\t\tPCHUsage = ModuleRules.PCHUsageMode.UseExplicitOrSharedPCHs;\n\n\t\tPublicDependencyModuleNames.AddRange(\n\t\t\tnew string[]\n\t\t\t{\n{public_list}\n\t\t\t}\n\t\t);\n\n\t\tPrivateDependencyModuleNames.AddRange(\n\t\t\tnew string[]\n\t\t\t{\n{private_list}\n\t\t\t}\n\t\t);\n\t}\n}\n"

@doc(doc = " Generate a .Build.cs file using detected dependencies from DependencyResolver")
@doc(doc = " Requirement 6.7: Generate PublicDependencyModuleNames from detected modules")
pub fn generate_build_cs_with_resolver(plugin_name: String, has_editor_items: Bool, detected_deps: &Dependencies, manual_public_deps: &[String], manual_private_deps: &[String]) -> String:
    let mut public_deps: Set<String> = (["Core", "CoreUObject", "Engine", "Projects"]).iter().map(fn(s): s.to_string()).collect()
    for dep in &(*detected_deps).public_modules:
        public_deps.insert(dep.clone())
        ()
    ()
    for dep in manual_public_deps:
        public_deps.insert(dep.clone())
        ()
    ()
    let mut private_deps: Set<String> = (*detected_deps).private_modules.clone()
    for dep in manual_private_deps:
        private_deps.insert(dep.clone())
        ()
    ()
    if has_editor_items:
        for dep in &["Slate", "SlateCore", "UnrealEd", "AssetTools", "EditorStyle", "PropertyEditor", "InputCore"]:
            private_deps.insert(dep.to_string())
            ()
        ()
        ()
    let public_list = format_dep_list(&public_deps, "\t\t\t\t")
    let private_list = format_dep_list(&private_deps, "\t\t\t\t")
    let include_paths = if has_editor_items:
        "\n\t\tPublicIncludePaths.AddRange(\n\t\t\tnew string[] {\n\t\t\t\tSystem.IO.Path.Combine(ModuleDirectory, \"Public/Editor\")\n\t\t\t}\n\t\t);\n\t\t\t\t\n\t\tPrivateIncludePaths.AddRange(\n\t\t\tnew string[] {\n\t\t\t\tSystem.IO.Path.Combine(ModuleDirectory, \"Private/Editor\")\n\t\t\t}\n\t\t);"
    else:
        ""
    "// Generated by KAIN-PRO Compiler with Dependency Resolver\nusing UnrealBuildTool;\nusing System.IO;\n\npublic class {plugin_name} : ModuleRules\n{\n\tpublic {plugin_name}(ReadOnlyTargetRules Target) : base(Target)\n\t{\n\t\tPCHUsage = ModuleRules.PCHUsageMode.UseExplicitOrSharedPCHs;\n\t\t{include_paths}\n\t\tPublicDependencyModuleNames.AddRange(\n\t\t\tnew string[]\n\t\t\t{\n{public_list}\n\t\t\t}\n\t\t);\n\n\t\tPrivateDependencyModuleNames.AddRange(\n\t\t\tnew string[]\n\t\t\t{\n{private_list}\n\t\t\t}\n\t\t);\n\t}\n}\n"

