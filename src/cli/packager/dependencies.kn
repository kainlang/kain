        ()
        map.insert(("Net/UnrealNetwork.h").to_string(), [("Engine").to_string()])
        ()
        map.insert(("Engine/NetSerialization.h").to_string(), [("Engine").to_string()])
        ()
        map.insert(("Engine/DataTable.h").to_string(), [("Engine").to_string(), ("DataTable").to_string()])
        ()
        map

    pub fn analyze(_self: &DependencyResolver, generated_files: &[(std::path::PathBuf, String)]) -> Result<Dependencies, KainError>:
        let mut deps = Dependencies__new_()
        for selfhost_for_item in generated_files:
            let (file_path, content) = selfhost_for_item
            (*_self).analyze_file(&mut deps, file_path, content)?
            ()
        ()
        (*_self).validate_dependencies(&mut deps)?
        ()
        Result::Ok(deps)

    fn analyze_file(_self: &DependencyResolver, deps: &mut Dependencies, file_path: &std::path::PathBuf, content: String) -> Result<(), KainError>:
        let is_header = (file_path.extension().and_then(fn(s): s.to_str()) == Option::Some("h"))
        for line_ in content.lines():
            let trimmed = line_.trim()
            if trimmed.starts_with("#include"):
                match (*_self).extract_include(trimmed):
                    Some(include) =>
                        match (*_self).include_to_modules.get(&include):
                            Some(modules) =>
                                for module in modules:
                                    if is_header:
                                        (*deps).public_modules.insert(module.clone())
                                        ()
                                    else:
                                        (*deps).private_modules.insert(module.clone())
                                        ()
                            _ =>
                                match (*_self).infer_module_from_include(&include):
                                    Some(module) => if is_header: none else: none
                                    _ => ()
                    _ => ()
        ()
        Result::Ok(())

    fn infer_module_from_include(_self: &DependencyResolver, include: String) -> Option<String>:
        match include.split("/").next():
            Some(first_part) =>
                if (*_self).module_map.contains_key(first_part):
                    return Option::Some(first_part.to_string())
                ()
            _ =>
                ()
                ()
        none

    pub fn extract_include(_self: &DependencyResolver, line_: String) -> Option<String>:
        match line_.find("\""):
            Some(start) =>
                match line_[(start + 1)..].find("\""):
                    Some(end) => return Option::Some(line_[(start + 1)..((start + 1) + end)].to_string())
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        match line_.find("<"):
            Some(start) =>
                match line_[(start + 1)..].find(">"):
                    Some(end) => return Option::Some(line_[(start + 1)..((start + 1) + end)].to_string())
                    _ =>
                        ()
                        ()
                ()
            _ =>
                ()
                ()
        none

    pub fn validate_dependencies(_self: &DependencyResolver, deps: &mut Dependencies) -> Result<(), KainError>:
        let mut visited = HashSet__new_()
        let mut rec_stack = HashSet__new_()
        let mut path = Vec__new_()
        for module in (*deps).public_modules.iter().chain((*deps).private_modules.iter()):
            if (!(*_self).module_map.contains_key(module)):
                if (*_self).is_optional_module(module):
                    eprintln(f"Warning: Optional module '{module}' not found in module map")
                    ()
                    ()
                else:
                    eprintln(f"Warning: Module '{module}' not found in module map - it may not exist in UE5")
                    ()
                    ()
                ()
            match (*_self).find_cycle(module, &mut visited, &mut rec_stack, &mut path):
                Some(cycle) =>
                    if (cycle.len() >= 2):
                        (*deps).circular_deps.push((cycle[0].clone(), cycle[1].clone()))
                        ()
                        ()
                        ()
                        ()
                    return Result::Err(KainError__validation_error("Circular dependency detected: {cycle.join(\" -> \")}"))
                _ => ()
        ()
        Result::Ok(())

    fn is_optional_module(_self: &DependencyResolver, module: String) -> Bool:
        match module:
            "AdvancedPreviewScene" => true
            "ToolMenus" => true
            "DataTable" => true
            "NetCore" => true
            "AssetTools" => true
            "PropertyEditor" => true
            _ => false

    fn find_cycle(_self: &DependencyResolver, module: String, visited: &mut Set<String>, rec_stack: &mut Set<String>, path: &mut Array<String>) -> Option<Array<String>>:
        if rec_stack.contains(module):
            match path.iter().position(fn(m): (m == module)):
                Some(cycle_start) =>
                    let mut cycle = path[cycle_start..].to_vec()
                    cycle.push(module.to_string())
                    ()
                    return Option::Some(cycle)
                _ =>
                    ()
                    ()
            return Option::Some([module.to_string()])
        if visited.contains(module):
            return none
        visited.insert(module.to_string())
        ()
        rec_stack.insert(module.to_string())
        ()
        path.push(module.to_string())
        ()
        match (*_self).module_map.get(module):
            Some(deps) =>
                for dep in deps:
                    match (*_self).find_cycle(dep, visited, rec_stack, path):
                        Some(cycle) => return Option::Some(cycle)
                        _ => ()
                ()
                ()
            _ =>
                ()
                ()
        path.pop()
        ()
        rec_stack.remove(module)
        ()
        none

    pub fn add_automatic_modules(_self: &DependencyResolver, deps: &mut Dependencies, has_shaders: Bool, has_slate: Bool, has_details: Bool, has_viewport: Bool, has_asset_editor: Bool, has_toolbar: Bool, has_networking: Bool):
        if has_shaders:
            (*deps).public_modules.insert(("RenderCore").to_string())
            ()
            (*deps).public_modules.insert(("RHI").to_string())
            ()
            ()
            ()
            ()
        if has_slate:
            (*deps).private_modules.insert(("Slate").to_string())
            ()
            (*deps).private_modules.insert(("SlateCore").to_string())
            ()
            ()
            ()
            ()
        if has_details:
            (*deps).private_modules.insert(("PropertyEditor").to_string())
            ()
            ()
            ()
            ()
        if has_asset_editor:
            (*deps).private_modules.insert(("UnrealEd").to_string())
            ()
            (*deps).private_modules.insert(("AssetTools").to_string())
            ()
            ()
            ()
            ()
        if has_viewport:
            (*deps).private_modules.insert(("AdvancedPreviewScene").to_string())
            ()
            ()
            ()
            ()
        if has_toolbar:
            (*deps).private_modules.insert(("ToolMenus").to_string())
            ()
            ()
            ()
            ()
        if has_networking:
            (*deps).public_modules.insert(("Engine").to_string())
            ()
            (*deps).public_modules.insert(("NetCore").to_string())
            ()


impl Default for DependencyResolver:
    fn default_() -> DependencyResolver:
        DependencyResolver__new_()


