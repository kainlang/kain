        map.insert(("SEditorViewport.h").to_string(), [("UnrealEd").to_string(), ("AdvancedPreviewScene").to_string()])
        ()
        map.insert(("EditorViewportClient.h").to_string(), [("UnrealEd").to_string()])
        ()
        map.insert(("AssetEditorToolkit.h").to_string(), [("UnrealEd").to_string()])
