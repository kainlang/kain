use kain_core::error::KainError

use kain_core::error::KainResult

use serde::Deserialize

use serde::Serialize

use std::collections::BTreeSet

use std::collections::HashMap

use std::collections::HashSet

use std::path::PathBuf

@doc(doc = " Module dependency information")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct ModuleInfo:
    name: String
    public_deps: Array<String>
    private_deps: Array<String>

@doc(doc = " Resolved dependencies for a plugin")
@derive(Debug, Clone)
pub struct Dependencies:
    public_modules: Set<String>
    private_modules: Set<String>
    circular_deps: Array<(String, String)>

impl Dependencies:
    pub fn new_() -> Dependencies:
        Dependencies { public_modules: BTreeSet__new_(), private_modules: BTreeSet__new_(), circular_deps: Vec__new_() }


@doc(doc = " Resolves module dependencies from generated code")
pub struct DependencyResolver:
    module_map: Map<String, Array<String>>
    include_to_modules: Map<String, Array<String>>

impl DependencyResolver:
    pub fn new_() -> DependencyResolver:
        DependencyResolver { module_map: DependencyResolver__default_module_map(), include_to_modules: DependencyResolver__default_include_map() }

    pub fn load(metadata_path: Option<std::path::PathBuf>) -> Result<DependencyResolver, KainError>:
        match metadata_path:
            Some(path) =>
                if path.exists():
                    let content = std__fs__read_to_string(&path).map_err(fn(e): KainError__io_error(e.to_string()))?
                    let module_map: Map<String, Array<String>> = serde_json__from_str(&content).map_err(fn(e): KainError__config_error(f"Failed to parse engine_modules.json: {e}"))?
                    Result::Ok(DependencyResolver { module_map: module_map.clone(), include_to_modules: DependencyResolver__build_include_map(&module_map) })
                else:
                    Result::Ok(DependencyResolver__new_())
            _ => Result::Ok(DependencyResolver__new_())

    fn build_include_map(_module_map: &Map<String, Array<String>>) -> Map<String, Array<String>>:
        DependencyResolver__default_include_map()

    pub fn default_module_map() -> Map<String, Array<String>>:
        let mut map = HashMap__new_()
        map.insert(("Core").to_string(), [])
        ()
        map.insert(("CoreUObject").to_string(), [("Core").to_string()])
        ()
        map.insert(("Engine").to_string(), [("Core").to_string(), ("CoreUObject").to_string()])
        ()
        map.insert(("RenderCore").to_string(), [("Core").to_string()])
        ()
        map.insert(("RHI").to_string(), [("Core").to_string()])
        ()
        map.insert(("Renderer").to_string(), [("Core").to_string(), ("RenderCore").to_string(), ("RHI").to_string()])
        ()
        map.insert(("SlateCore").to_string(), [("Core").to_string(), ("CoreUObject").to_string()])
        ()
        map.insert(("Slate").to_string(), [("Core").to_string(), ("SlateCore").to_string()])
        ()
        map.insert(("UnrealEd").to_string(), [("Core").to_string(), ("CoreUObject").to_string(), ("Engine").to_string()])
        ()
        map.insert(("PropertyEditor").to_string(), [("Core").to_string(), ("SlateCore").to_string(), ("Slate").to_string()])
        ()
        map.insert(("AssetTools").to_string(), [("Core").to_string(), ("UnrealEd").to_string()])
        ()
        map.insert(("EditorStyle").to_string(), [("Core").to_string(), ("SlateCore").to_string()])
        ()
        map.insert(("AdvancedPreviewScene").to_string(), [("Core").to_string(), ("Engine").to_string()])
        ()
        map.insert(("ToolMenus").to_string(), [("Core").to_string(), ("Slate").to_string()])
        ()
        map.insert(("NetCore").to_string(), [("Core").to_string()])
        ()
        map.insert(("InputCore").to_string(), [("Core").to_string()])
        ()
        map.insert(("Projects").to_string(), [("Core").to_string()])
        ()
        map.insert(("DataTable").to_string(), [("Core").to_string(), ("CoreUObject").to_string(), ("Engine").to_string()])
        ()
        map

    fn default_include_map() -> Map<String, Array<String>>:
        let mut map = HashMap__new_()
        map.insert(("CoreMinimal.h").to_string(), [("Core").to_string()])
        ()
        map.insert(("UObject/Object.h").to_string(), [("CoreUObject").to_string()])
        ()
        map.insert(("GameFramework/Actor.h").to_string(), [("Engine").to_string()])
        ()
        map.insert(("Components/ActorComponent.h").to_string(), [("Engine").to_string()])
        ()
        map.insert(("RenderResource.h").to_string(), [("RenderCore").to_string()])
        ()
        map.insert(("RHI.h").to_string(), [("RHI").to_string()])
        ()
        map.insert(("GlobalShader.h").to_string(), [("RenderCore").to_string()])
        ()
        map.insert(("ShaderParameters.h").to_string(), [("RenderCore").to_string()])
        ()
        map.insert(("ShaderParameterStruct.h").to_string(), [("RenderCore").to_string()])
        ()
        map.insert(("Widgets/SCompoundWidget.h").to_string(), [("SlateCore").to_string()])
        ()
        map.insert(("Widgets/SWidget.h").to_string(), [("SlateCore").to_string()])
        ()
        map.insert(("Widgets/DeclarativeSyntaxSupport.h").to_string(), [("SlateCore").to_string()])
        ()
        map.insert(("Widgets/Input/SButton.h").to_string(), [("Slate").to_string()])
        ()
        map.insert(("Widgets/Text/STextBlock.h").to_string(), [("Slate").to_string()])
        ()
        map.insert(("Widgets/Layout/SBox.h").to_string(), [("Slate").to_string()])
        ()
        map.insert(("Editor.h").to_string(), [("UnrealEd").to_string()])
        ()
        map.insert(("IDetailCustomization.h").to_string(), [("PropertyEditor").to_string()])
        ()
        map.insert(("DetailLayoutBuilder.h").to_string(), [("PropertyEditor").to_string()])
        ()
        map.insert(("DetailCategoryBuilder.h").to_string(), [("PropertyEditor").to_string()])
        ()
        map.insert(("DetailWidgetRow.h").to_string(), [("PropertyEditor").to_string()])
