use serde::Deserialize

use serde::Serialize

use std::collections::HashMap

use std::path::PathBuf

const REGISTRY_URL: String = "https://greeble.co/KAIN/index.json"

@derive(Debug, serde__Serialize, serde__Deserialize)
pub struct PackageManifest:
    package: PackageInfo
    build: BuildConfig
    dependencies: Map<String, String>
    ue5: Option<Ue5Config>
    r_rust: Option<RustBuildConfig>
    rust_ffi: Option<kain_crate_ffi::RustFfiConfig>

pub enum RustBuildArtifact:
    Source
    ShaderHost
    ShaderReflection
    Spirv

@derive(Debug, serde__Serialize, serde__Deserialize, Clone)
pub struct RustNativeUiAppConfig:
    root_component: Option<String>
    window_title: Option<String>
    app_name: Option<String>
    output: Option<std::path::PathBuf>
    initial_window_size: [f32; 2]
    build_executable: Bool
    release: Bool

@derive(Debug, serde__Serialize, serde__Deserialize, Clone)
pub struct RustBuildConfig:
    output: Option<std::path::PathBuf>
    artifacts: Array<RustBuildArtifact>
    native_ui: Option<RustNativeUiAppConfig>

fn default_rust_build_artifacts() -> Array<RustBuildArtifact>:
    [RustBuildArtifact__Source, RustBuildArtifact__ShaderHost, RustBuildArtifact__ShaderReflection, RustBuildArtifact__Spirv]

fn default_native_ui_window_size() -> [f32; 2]:
    [1440, 920]

fn default_true() -> Bool:
    true

impl Default for RustBuildConfig:
    fn default_() -> RustBuildConfig:
        RustBuildConfig { output: none, artifacts: default_rust_build_artifacts(), native_ui: none }


@derive(Debug, serde__Serialize, serde__Deserialize, Clone)
pub struct Ue5Config:
    plugin_name: String
    plugin_dir: std::path::PathBuf
    sources: Array<std::path::PathBuf>
    shaders: Array<String>
    copyright: Option<String>
    modular_output: Bool
    stdlib_path: Option<std::path::PathBuf>
    engine_version: Option<String>
    modules: Array<Ue5ModuleConfig>
    plugin_dependencies: Array<String>

pub enum Ue5ModuleType:
    Runtime
    Editor
    UncookedOnly
    Developer
    Program

impl Ue5ModuleType:
    pub fn as_uplugin_type(_self: &Ue5ModuleType) -> String:
        match *_self:
            Ue5ModuleType::Runtime => "Runtime"
            Ue5ModuleType::Editor => "Editor"
            Ue5ModuleType::UncookedOnly => "UncookedOnly"
            Ue5ModuleType::Developer => "Developer"
            Ue5ModuleType::Program => "Program"

    pub fn is_editorish(_self: &Ue5ModuleType) -> Bool:
        match *_self:
            Ue5ModuleType::Editor => true
            Ue5ModuleType::UncookedOnly => true
            Ue5ModuleType::Developer => true
            _ => false


fn default_runtime_module_type() -> Ue5ModuleType:
    Ue5ModuleType__Runtime

fn default_loading_phase() -> String:
    ("PostConfigInit").to_string()

@derive(Debug, serde__Serialize, serde__Deserialize, Clone, Default)
pub struct Ue5ModuleOutputConfig:
    public_: Option<std::path::PathBuf>
    private_: Option<std::path::PathBuf>

impl Default for Ue5ModuleOutputConfig:
    pub fn default_() -> Ue5ModuleOutputConfig:
        Ue5ModuleOutputConfig { public_: none, private_: none }


@derive(Debug, serde__Serialize, serde__Deserialize, Clone)
pub struct Ue5ModuleConfig:
    name: String
    module_type: Ue5ModuleType
    loading_phase: String
    source_globs: Array<std::path::PathBuf>
    public_deps: Array<String>
    private_deps: Array<String>
    depends_on: Array<String>
    output: Ue5ModuleOutputConfig
    folders: Map<String, std::path::PathBuf>

impl Ue5Config:
    pub fn has_module_plan(_self: &Ue5Config) -> Bool:
        (!(*_self).modules.is_empty())

    pub fn validate_module_configs(_self: &Ue5Config) -> Result<(), String>:
        if (*_self).modules.is_empty():
            return Result::Ok(())
        let mut names = HashSet__new_()
        for module in &(*_self).modules:
            if module.name.trim().is_empty():
                return Result::Err(("[ue5.modules] has an entry with empty name").to_string())
            if (!names.insert(module.name.clone())):
                return Result::Err(f"Duplicate ue5 module name: {module.name}")
        ()
        for module in &(*_self).modules:
            for dep in &module.depends_on:
                if (!names.contains(dep)):
                    return Result::Err(f"Module '{module.name}' depends_on unknown module '{dep}'")
                if (dep == &module.name):
                    return Result::Err(f"Module '{module.name}' cannot depend on itself")
        ()
        let by_name: Map<_, _> = (*_self).modules.iter().map(fn(m): (m.name.clone(), m)).collect()
        let mut visiting = HashSet__new_()
        let mut visited = HashSet__new_()
        fn dfs(node: String, by_name: &Map<String, &Ue5ModuleConfig>, visiting: &mut Set<String>, visited: &mut Set<String>) -> Result<(), String>:
            if visited.contains(node):
                return Result::Ok(())
            if (!visiting.insert(node.to_string())):
                return Result::Err(f"Cycle detected in ue5.modules at '{node}'")
            match by_name.get(node):
                Some(module) =>
                    for dep in &module.depends_on:
                        dfs(dep, by_name, visiting, visited)?
                        ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            visiting.remove(node)
            ()
            visited.insert(node.to_string())
            ()
            Result::Ok(())

        for module in &(*_self).modules:
            dfs(&module.name, &by_name, &mut visiting, &mut visited)?
            ()
        ()
        Result::Ok(())


fn default_plugin_dir() -> std::path::PathBuf:
    PathBuf__from("Plugins")

@derive(Debug, serde__Serialize, serde__Deserialize)
pub struct BuildConfig:
    entry: std::path::PathBuf
    output: std::path::PathBuf
    targets: Array<String>

fn default_entry() -> std::path::PathBuf:
    PathBuf__from("src/main.kn")

fn default_output() -> std::path::PathBuf:
    PathBuf__from("dist")

impl Default for BuildConfig:
    fn default_() -> BuildConfig:
        BuildConfig { entry: default_entry(), output: default_output(), targets: [("wasm").to_string()] }


@derive(Debug, serde__Serialize, serde__Deserialize)
pub struct PackageInfo:
    name: String
    version: String
    authors: Array<String>
    description: Option<String>

@derive(Debug, serde__Deserialize)
pub struct RegistryIndex:
    packages: Map<String, String>

@derive(Debug, serde__Deserialize)
pub struct PackageMeta:
    versions: Map<String, PackageVersion>

@derive(Debug, serde__Deserialize)
pub struct PackageVersion:
    url: String
    checksum: String

impl PackageManifest:
    pub fn default_(name: String) -> PackageManifest:
        PackageManifest { package: PackageInfo { name: name.to_string(), version: ("0.1.0").to_string(), authors: [], description: none }, build: BuildConfig__default_(), dependencies: HashMap__new_(), ue5: none, r_rust: none, rust_ffi: none }


pub fn registry_url() -> String:
    REGISTRY_URL

