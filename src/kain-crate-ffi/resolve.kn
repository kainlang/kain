use crate::config::RustFfiConfig

use crate::config::RustFfiPathCrate

use crate::config::RustFfiRegistryCrate

use crate::model::DependencySpec

use crate::model::ImportCrateOptions

use crate::model::PrepareContext

use crate::model::ResolutionKind

use crate::model::ResolvedCrate

use kain_core::error::KainError

use serde::Deserialize

use sha2::Digest

use sha2::Sha256

use std::collections::BTreeSet

use std::collections::HashSet

use std::ffi::OsStr

use std::fs

use std::path::Path

use std::path::PathBuf

use std::process::Command

const KAIN_MANIFEST_NAMES: Array<String> = ["KAIN.toml", "kain.toml"]

const CARGO_MANIFEST_NAME: String = "Cargo.toml"

@derive(Debug, Clone, serde__Deserialize)
struct CargoMetadata:
    workspace_root: String
    packages: Array<CargoPackage>
    workspace_members: Array<String>

@derive(Debug, Clone, serde__Deserialize)
struct CargoPackage:
    id: String
    name: String
    version: String
    manifest_path: String
    targets: Array<CargoTarget>

@derive(Debug, Clone, serde__Deserialize)
struct CargoTarget:
    name: String
    kind: Array<String>
    src_path: String

@derive(Debug, Clone)
pub struct ManifestContext:
    root_dir: Option<std::path::PathBuf>
    config: Option<RustFfiConfig>
    manifest_path: Option<std::path::PathBuf>

@derive(Debug, Clone)
pub struct CacheInputs:
    target_triple: String
    rustc_version: String
    source_file_hashes: Array<(std::path::PathBuf, String)>

pub fn resolve_crate(crate_name: String, options: &ImportCrateOptions, prepare: &PrepareContext) -> Result<(ResolvedCrate, ManifestContext), kain_core::error::KainError>:
    let start_dir = (*prepare).current_dir.clone().or_else(fn(): std__env__current_dir().ok()).unwrap_or_else(fn(): PathBuf__from("."))
    let manifest_context = load_manifest_context(&start_dir, options, prepare)?
    match (*options).crate_path:
        Some(crate_path) =>
            let resolved = resolve_explicit_crate_path(crate_name, crate_path, options)?
            return Result::Ok((resolved, manifest_context))
        _ =>
            ()
            ()
    let mut metadata_error = none
    match manifest_context.manifest_path:
        Some(manifest_path) =>
            match load_metadata(manifest_path, options):
                Ok(metadata) =>
                    match (resolve_from_workspace_or_dependencies(crate_name, manifest_path, &metadata, options)?):
                        Some(resolved) => return Result::Ok((resolved, manifest_context))
                        _ =>
                            ()
                            ()
                    ()
                Err(err) =>
                    metadata_error = Option::Some(err)
                    ()
                    ()
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    match manifest_context.config:
        Some(config) =>
            match config.path_crates.iter().find(fn(entry): (entry.name == crate_name)):
                Some(path_entry) =>
                    let resolved = resolve_config_path_crate(crate_name, path_entry, &manifest_context, options)?
                    return Result::Ok((resolved, manifest_context))
                _ =>
                    ()
                    ()
            match config.registry_crates.iter().find(fn(entry): (entry.name == crate_name)):
                Some(registry_entry) =>
                    let resolved = resolve_registry_crate(crate_name, registry_entry, options)?
                    return Result::Ok((resolved, manifest_context))
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    let mut searched = Vec__new_()
    match manifest_context.manifest_path:
        Some(manifest_path) =>
            searched.push(f"workspace/dependencies via {manifest_path.display()}")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match manifest_context.root_dir:
        Some(root) =>
            searched.push(f"KAIN manifest at {root.display()}")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    if (*options).crate_path.is_some():
        searched.push(("--crate-path").to_string())
        ()
        ()
        ()
        ()
    if searched.is_empty():
        searched.push(start_dir.display().to_string())
        ()
        ()
        ()
        ()
    match metadata_error:
        Some(err) => return Result::Err(KainError__runtime(f"Rust crate FFI could not resolve crate '{crate_name}'. Workspace/dependency resolution failed before fallback search: {err}"))
        _ =>
            ()
            ()
    Result::Err(KainError__runtime("Rust crate FFI could not resolve crate '{crate_name}'. Searched: {searched.join(\", \")}"))

pub fn load_manifest_context(start_dir: &std::path::Path, options: &ImportCrateOptions, prepare: &PrepareContext) -> Result<ManifestContext, kain_core::error::KainError>:
    let root_dir = find_kain_manifest_root(start_dir)
    let config = (root_dir.map(fn(root): load_rust_ffi_config(root.as_path())).transpose()?).flatten()
    let manifest_path = match (*prepare).manifest_path.or_((*options).manifest_path):
        Some(path) => Option::Some(canonicalize_lossy(path))
        _ =>
            match config.and_then(fn(value): value.manifest_path).map(fn(path): resolve_relative_to(path, root_dir.unwrap_or(start_dir))):
                Some(config_manifest) => Option::Some(config_manifest)
                _ => find_nearest_cargo_manifest(start_dir)
    Result::Ok(ManifestContext { root_dir: root_dir, config: config, manifest_path: manifest_path })

pub fn build_cache_hash(resolved: &ResolvedCrate, source_file_hashes: &[(std::path::PathBuf, String)], target_triple: String, rustc_version: String, kain_version: String, bridge_format_version: String) -> String:
    let mut hasher = Sha256__new_()
    hasher.update((*resolved).package_name.as_bytes())
    ()
    hasher.update((*resolved).import_name.as_bytes())
    ()
    hasher.update((*resolved).version.as_bytes())
    ()
    hasher.update((*resolved).manifest_path.to_string_lossy().as_bytes())
    ()
    hasher.update(target_triple.as_bytes())
    ()
    hasher.update(rustc_version.as_bytes())
    ()
    hasher.update(kain_version.as_bytes())
    ()
    hasher.update(bridge_format_version.as_bytes())
    ()
    for feature in &(*resolved).features:
        hasher.update(feature.as_bytes())
        ()
    ()
    hasher.update([(*resolved).default_features as u8, (*resolved).all_features as u8])
    ()
    for selfhost_for_item in source_file_hashes:
        let (path, digest) = selfhost_for_item
        hasher.update(path.to_string_lossy().as_bytes())
        ()
        hasher.update(digest.as_bytes())
        ()
    ()
    let digest = hasher.finalize()
    digest

pub fn rustc_version_and_target() -> Result<(String, String), kain_core::error::KainError>:
    let output = Command__new_("rustc").arg("-vV").output().map_err(fn(err): KainError__runtime(f"Failed to run rustc -vV: {err}"))?
    if (!output.status.success()):
        return Result::Err(KainError__runtime("Failed to read rustc version information for crate FFI cache key"))
    let stdout = String__from_utf8_lossy(&output.stdout)
    let version_line = stdout.lines().find(fn(line_): line_.starts_with("release: ")).unwrap_or("release: unknown")
    let host_line = stdout.lines().find(fn(line_): line_.starts_with("host: ")).unwrap_or("host: unknown")
    Result::Ok((version_line.trim_start_matches("release: ").trim().to_string(), host_line.trim_start_matches("host: ").trim().to_string()))

fn resolve_from_workspace_or_dependencies(crate_name: String, manifest_path: &std::path::Path, metadata: &CargoMetadata, options: &ImportCrateOptions) -> Result<Option<ResolvedCrate>, kain_core::error::KainError>:
    let workspace_members = (*metadata).workspace_members.iter().collect()
    let workspace_match = (*metadata).packages.iter().find(fn(package): (workspace_members.contains(&package.id) && package_matches_import_name(package, crate_name)))
    match workspace_match:
        Some(package) => return Result::Ok(Option::Some(build_resolved_crate(crate_name, package, metadata, ResolutionKind__Workspace, options)?))
        _ =>
            ()
            ()
    let dependency_match = (*metadata).packages.iter().find(fn(package): package_matches_import_name(package, crate_name))
    match dependency_match:
        Some(package) => return Result::Ok(Option::Some(build_resolved_crate(crate_name, package, metadata, ResolutionKind__Dependency, options)?))
        _ =>
            ()
            ()
    let manifest_dir = manifest_path.parent().unwrap_or_else(fn(): Path__new_("."))
    let searched_workspace = manifest_dir.join(CARGO_MANIFEST_NAME)
    if searched_workspace.exists():
        return Result::Ok(none)
    Result::Ok(none)

fn resolve_explicit_crate_path(crate_name: String, crate_path: &std::path::Path, options: &ImportCrateOptions) -> Result<ResolvedCrate, kain_core::error::KainError>:
    let crate_dir = if crate_path.is_dir():
        crate_path.to_path_buf()
    else:
        crate_path.parent().map(Path__to_path_buf).unwrap_or_else(fn(): PathBuf__from("."))
    let manifest_path = if (crate_path.file_name() == Option::Some(OsStr__new_(CARGO_MANIFEST_NAME))):
        crate_path.to_path_buf()
    else:
        crate_dir.join(CARGO_MANIFEST_NAME)
    if (!manifest_path.exists()):
        return Result::Err(KainError__runtime(f"--crate-path '{crate_path.display()}' does not contain a Cargo.toml"))
    let metadata = load_metadata(&manifest_path, options)?
    let root_package = metadata.packages.iter().find(fn(package): (canonicalize_lossy(Path__new_(&package.manifest_path)) == manifest_path)).or_else(fn(): metadata.packages.first()).ok_or_else(fn(): KainError__runtime(f"Cargo metadata for '{manifest_path.display()}' did not include a root package"))?
    build_resolved_crate(crate_name, root_package, &metadata, ResolutionKind__CratePath, options)

fn resolve_config_path_crate(crate_name: String, entry: &RustFfiPathCrate, manifest_context: &ManifestContext, options: &ImportCrateOptions) -> Result<ResolvedCrate, kain_core::error::KainError>:
    let root = (*manifest_context).root_dir.unwrap_or_else(fn(): Path__new_("."))
    let crate_dir = resolve_relative_to(&(*entry).path, root)
    resolve_explicit_crate_path(crate_name, &crate_dir, options).map(fn(mut resolved): none)

fn resolve_registry_crate(crate_name: String, entry: &RustFfiRegistryCrate, options: &ImportCrateOptions) -> Result<ResolvedCrate, kain_core::error::KainError>:
    let resolution_root = std__env__temp_dir().join("kain_crate_ffi_registry_resolution").join(f"{crate_name}_{sanitize_for_filename(&(*entry).version)}")
    std__fs__create_dir_all(&resolution_root).map_err(kain_core__error__KainError__Io)?
    ()
    let dependency_key = crate_name.replace("-", "_")
    let package_name = (*entry).package.clone().unwrap_or_else(fn(): crate_name.to_string())
    let manifest_path = resolution_root.join(CARGO_MANIFEST_NAME)
    let mut dependency_lines = Vec__new_()
    dependency_lines.push("{dependency_key} = { package = {package_name}, version = {(*entry).version}")
    ()
    if (!(*entry).features.is_empty()):
        dependency_lines.push(f", features = {(*entry).features}")
        ()
        ()
        ()
        ()
    if (!(*entry).default_features):
        dependency_lines.push((", default-features = false").to_string())
        ()
        ()
        ()
        ()
    dependency_lines.push((" }").to_string())
    ()
    let manifest = "[package]\nname = \"kain-crate-ffi-resolve-{dependency_key}\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\n{dependency_lines.join(\"\")}\n"
    std__fs__write(&manifest_path, manifest).map_err(kain_core__error__KainError__Io)?
    ()
    let metadata = load_metadata(&manifest_path, options)?
    let package = metadata.packages.iter().find(fn(package): ((package.name == package_name) || package_matches_import_name(package, crate_name))).ok_or_else(fn(): KainError__runtime(f"Cargo metadata could not resolve registry crate '{crate_name}' from version '{(*entry).version}'"))?
    let mut resolved = build_resolved_crate(crate_name, package, &metadata, ResolutionKind__RegistryConfig, &ImportCrateOptions { features: (*entry).features.clone(), no_default_features: (!(*entry).default_features), ..options.clone() })?
    resolved.dependency_spec = DependencySpec::Registry { package: package.name.clone(), dependency_name: resolved.dependency_name.clone(), version: package.version.to_string(), features: (*entry).features.clone(), default_features: (*entry).default_features }
    ()
    resolved.default_features = (*entry).default_features
    ()
    resolved.features = (*entry).features.clone()
    ()
    Result::Ok(resolved)

fn build_resolved_crate(crate_name: String, package: &CargoPackage, metadata: &CargoMetadata, resolution_kind: ResolutionKind, options: &ImportCrateOptions) -> Result<ResolvedCrate, kain_core::error::KainError>:
    let lib_target = (*package).targets.iter().find(fn(target): target_is_library(target)).or_else(fn(): (*package).targets.first()).ok_or_else(fn(): KainError__runtime(f"Rust crate '{(*package).name}' does not expose a target that Kain crate FFI can inspect"))?
    let crate_root_file = canonicalize_lossy(Path__new_(&lib_target.src_path))
    let crate_root = crate_root_file.parent().map(Path__to_path_buf).unwrap_or_else(fn(): PathBuf__from("."))
    let manifest_path = canonicalize_lossy(Path__new_(&(*package).manifest_path))
    let dependency_name = lib_target.name.replace("-", "_")
    let dependency_spec = match resolution_kind:
        ResolutionKind::RegistryConfig => DependencySpec::Registry { package: (*package).name.clone(), dependency_name: dependency_name.clone(), version: (*package).version.to_string(), features: (*options).features.clone(), default_features: (!(*options).no_default_features) }
        _ => DependencySpec::Path { package: (*package).name.clone(), dependency_name: dependency_name.clone(), path: manifest_path.parent().map(Path__to_path_buf).unwrap_or_else(fn(): crate_root.clone()) }
    let feature_set = normalized_feature_set(options)
    Result::Ok(ResolvedCrate { import_name: crate_name.to_string(), package_name: (*package).name.clone(), dependency_name: dependency_name, library_target_name: lib_target.name.clone(), version: (*package).version.clone(), manifest_path: manifest_path, crate_root: crate_root, crate_root_file: crate_root_file, workspace_root: canonicalize_lossy(Path__new_(&(*metadata).workspace_root)), resolution_kind: resolution_kind, dependency_spec: dependency_spec, features: feature_set, default_features: (!(*options).no_default_features), all_features: (*options).all_features })

fn package_matches_import_name(package: &CargoPackage, crate_name: String) -> Bool:
    if ((*package).name == crate_name):
        return true
    (*package).targets.iter().any(fn(target): (target.kind.iter().any(fn(kind): (((kind == "lib") || (kind == "rlib")) || (kind == "cdylib"))) && (target.name == crate_name)))

fn normalized_feature_set(options: &ImportCrateOptions) -> Array<String>:
    let mut features = BTreeSet__new_()
    for feature in &(*options).features:
        let trimmed = feature.trim()
        if (!trimmed.is_empty()):
            features.insert(trimmed.to_string())
            ()
    ()
    features.into_iter().collect()

fn load_metadata(manifest_path: &std::path::Path, options: &ImportCrateOptions) -> Result<CargoMetadata, kain_core::error::KainError>:
    let mut command = Command__new_("cargo")
    command.arg("metadata").arg("--format-version").arg("1").arg("--manifest-path").arg(manifest_path)
    ()
    if (*options).all_features:
        command.arg("--all-features")
        ()
        ()
        ()
        ()
    else:
        if (*options).no_default_features:
            command.arg("--no-default-features")
            ()
            ()
            ()
            ()
        if (!(*options).features.is_empty()):
            command.arg("--features")
            ()
            command.arg((*options).features.join(","))
            ()
            ()
            ()
            ()
        ()
    let output = command.output().map_err(fn(err): KainError__runtime(f"Failed to run cargo metadata for '{manifest_path.display()}': {err}"))?
    if (!output.status.success()):
        return Result::Err(KainError__runtime(f"cargo metadata failed for '{manifest_path.display()}': {String__from_utf8_lossy(&output.stderr)}"))
    serde_json__from_slice(&output.stdout).map_err(fn(err): KainError__runtime(f"Failed to parse cargo metadata JSON for '{manifest_path.display()}': {err}"))

fn load_rust_ffi_config(root: &std::path::Path) -> Result<Option<RustFfiConfig>, kain_core::error::KainError>:
    let manifest_path = KAIN_MANIFEST_NAMES.iter().map(fn(name): root.join(name)).find(fn(path): path.exists())
    let Some(manifest_path) = manifest_path
    let source = std__fs__read_to_string(&manifest_path).map_err(kain_core__error__KainError__Io)?
    let value = source.parse().map_err(fn(err): KainError__runtime(f"Failed to parse KAIN manifest '{manifest_path.display()}': {err}"))?
    let section = value.get("rust_ffi").cloned().unwrap_or_else(fn(): toml__Value::Table(Default__default_()))
    if section.as_table().is_some_and(fn(table): table.is_empty()):
        return Result::Ok(none)
    let config = section.try_into().map_err(fn(err): KainError__runtime(f"Failed to parse [rust_ffi] in '{manifest_path.display()}': {err}"))?
    Result::Ok(Option::Some(config))

fn find_kain_manifest_root(start_dir: &std::path::Path) -> Option<std::path::PathBuf>:
    start_dir.ancestors().find(fn(dir): KAIN_MANIFEST_NAMES.iter().any(fn(name): dir.join(name).exists())).map(Path__to_path_buf)

fn find_nearest_cargo_manifest(start_dir: &std::path::Path) -> Option<std::path::PathBuf>:
    start_dir.ancestors().map(fn(dir): dir.join(CARGO_MANIFEST_NAME)).find(fn(path): path.exists()).map(fn(path): canonicalize_lossy(&path))

fn resolve_relative_to(path: &std::path::Path, base_dir: &std::path::Path) -> std::path::PathBuf:
    if path.is_absolute():
        canonicalize_lossy(path)
    else:
        canonicalize_lossy(&base_dir.join(path))

fn sanitize_for_filename(value: String) -> String:
    value.chars().map(fn(ch): if ch.is_ascii_alphanumeric(): ch else: "_").collect()

fn canonicalize_lossy(path: &std::path::Path) -> std::path::PathBuf:
    std__fs__canonicalize(path).unwrap_or_else(fn(_): path.to_path_buf())

pub fn simple_file_sha256(path: &std::path::Path) -> Result<String, kain_core::error::KainError>:
    let bytes = std__fs__read(path).map_err(kain_core__error__KainError__Io)?
    let digest = Sha256__digest(bytes)
    Result::Ok(digest)

pub fn lib_filename(stem: String) -> String:
    if cfg!(target_os = "windows"):
        f"{stem}.dll"
    elif cfg!(target_os = "macos"):
        f"lib{stem}.dylib"
    else:
        f"lib{stem}.so"

pub fn target_directory_name() -> String:
    "debug"

pub fn build_cache_inputs(files: &[std::path::PathBuf]) -> Result<CacheInputs, kain_core::error::KainError>:
    let (rustc_version, target_triple) = rustc_version_and_target()?
    let mut source_file_hashes = Vec__new_()
    for file in files:
        source_file_hashes.push((file.clone(), simple_file_sha256(file)?))
        ()
    ()
    Result::Ok(CacheInputs { target_triple: target_triple, rustc_version: rustc_version, source_file_hashes: source_file_hashes })

fn target_is_library(target: &CargoTarget) -> Bool:
    (*target).kind.iter().any(fn(kind): (((kind == "lib") || (kind == "rlib")) || (kind == "cdylib")))

