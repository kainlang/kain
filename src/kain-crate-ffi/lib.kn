const REGISTER_EXTENSION_ONCE: std::sync::Once = Once__new_()

const LOADED_BRIDGES: std::sync::RwLock<Map<std::path::PathBuf, LoadedBridge>> = (fn(): RwLock__new_(BTreeMap__new_()))()

type RegisterBridgeFn = fn(ptr_mut<kain_core::runtime::Env>) -> ()

struct LoadedBridge:
    library: libloading::Library
    register_: RegisterBridgeFn

pub fn register_():
    REGISTER_EXTENSION_ONCE.call_once(fn(): none)
    ()

pub fn import_crate(crate_name: String, options: &model::ImportCrateOptions, prepare: &model::PrepareContext) -> Result<model::ImportCrateOutput, kain_core::error::KainError>:
    register_()
    ()
    let (resolved, manifest_context) = resolve__resolve_crate(crate_name, options, prepare)?
    let bundle = extract__extract_binding_bundle(&resolved)?
    let source_files = bundle.source_fingerprints.iter().map(fn(value): PathBuf__from(&value.path)).collect()
    let cache_inputs = resolve__build_cache_inputs(&source_files)?
    let hash = resolve__build_cache_hash(&resolved, &cache_inputs.source_file_hashes, &cache_inputs.target_triple, &cache_inputs.rustc_version, env!("CARGO_PKG_VERSION"), generate__BRIDGE_FORMAT_VERSION)
    let cache_dir = default_cache_root(prepare).join("crate_ffi").join(hash)
    std__fs__create_dir_all(&cache_dir).map_err(kain_core__error__KainError__Io)?
    ()
    let (artifacts, mut output) = generate__write_generated_artifacts(&resolved, &bundle, &cache_dir, (*options).output_dir)?
    output.config_root = manifest_context.root_dir.clone()
    ()
    output.rust_ffi_config = manifest_context.config.clone()
    ()
    match (*options).report_json:
        Some(report_json_path) =>
            match report_json_path.parent():
                Some(parent) =>
                    std__fs__create_dir_all(parent).map_err(kain_core__error__KainError__Io)?
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            let report_json = serde_json__to_string_pretty(&artifacts.report).map_err(fn(err): KainError__runtime(f"Failed to serialize crate FFI report override: {err}"))?
            std__fs__write(report_json_path, report_json).map_err(kain_core__error__KainError__Io)?
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    if (*options).mode.wants_live():
        let (dylib_path, cache_hit) = ensure_bridge_library(&output, &resolved)?
        ensure_bridge_loaded(&dylib_path)?
        ()
        output.dylib_path = Option::Some(dylib_path)
        ()
        output.cache_hit = cache_hit
        ()
        ()
        ()
        ()
    Result::Ok(output)

pub fn augment_source_for_runtime(source: String, target: kain_core::CompileTarget, prepare: &model::PrepareContext) -> Result<String, kain_core::error::KainError>:
    let imports = detect_rust_crate_imports(source)
    if imports.is_empty():
        return Result::Ok(source.to_string())
    if (!none):
        return Result::Err(KainError__runtime("Rust crate FFI is only available in host-backed Kain execution lanes for now"))
    let mut sections = Vec__new_()
    let mut seen = BTreeSet__new_()
    for import_name in imports:
        if (!seen.insert(import_name.clone())):
            continue
        let options = model::ImportCrateOptions { mode: model__ArtifactMode__Both, ..ImportCrateOptions__default_() }
        let output = import_crate(&import_name, &options, prepare)?
        sections.push(output.canonical_module_source)
        ()
    ()
    sections.push(source.to_string())
    ()
    Result::Ok(sections.join("\n"))

pub fn detect_rust_crate_imports(source: String) -> Array<String>:
    const IMPORT_REGEX: regex::Regex = (fn(): Regex__new_("(?m)^\\s*use\\s+rust(?:::|/)([A-Za-z_][A-Za-z0-9_]*)").expect("regex"))()

    let mut seen = BTreeSet__new_()
    let mut imports = Vec__new_()
    for captures in IMPORT_REGEX.captures_iter(source):
        match captures.get(1):
            Some(value) =>
                let crate_name = value.as_str().to_string()
                if seen.insert(crate_name.clone()):
                    imports.push(crate_name)
                    ()
            _ => ()
    ()
    imports

fn apply_loaded_bridges(env: &mut kain_core::runtime::Env):
    let registry = LOADED_BRIDGES.read().expect("crate ffi bridge registry read")
    for bridge in registry.values():
        bridge.register_(env as ptr_mut<kain_core::runtime::Env>)
        ()
        ()

fn ensure_bridge_loaded(dylib_path: &std::path::Path) -> Result<(), kain_core::error::KainError>:
    register_()
    ()
    let canonical_path = std__fs__canonicalize(dylib_path).unwrap_or_else(fn(_): dylib_path.to_path_buf())
    if LOADED_BRIDGES.read().expect("crate ffi bridge registry read").contains_key(&canonical_path):
        return Result::Ok(())
    let library = Library__new_(&canonical_path).map_err(fn(err): KainError__runtime(f"Failed to load Rust crate FFI bridge '{canonical_path.display()}': {err}"))?
    let register_ = none
    LOADED_BRIDGES.write().expect("crate ffi bridge registry write").insert(canonical_path, LoadedBridge { library: library, register_: register_ })
    ()
    Result::Ok(())

fn ensure_bridge_library(output: &model::ImportCrateOutput, resolved: &model::ResolvedCrate) -> Result<(std::path::PathBuf, Bool), kain_core::error::KainError>:
    let bridge_name = generate__bridge_crate_name(&(*resolved).import_name)
    let target_dir = (*output).cache_dir.join("bridge").join("target")
    let dylib_path = target_dir.join(resolve__target_directory_name()).join(resolve__lib_filename(&bridge_name))
    if dylib_path.exists():
        return Result::Ok((dylib_path, true))
    let status = Command__new_("cargo").arg("build").arg("--manifest-path").arg(&(*output).bridge_manifest_path).env("CARGO_TARGET_DIR", &target_dir).status().map_err(fn(err): KainError__runtime(f"Failed to run cargo build for Rust crate FFI bridge '{(*output).bridge_manifest_path.display()}': {err}"))?
    if (!status.success()):
        return Result::Err(KainError__runtime(f"Cargo build failed for Rust crate FFI bridge '{(*output).bridge_manifest_path.display()}'"))
    if (!dylib_path.exists()):
        return Result::Err(KainError__runtime(f"Rust crate FFI bridge build succeeded but '{dylib_path.display()}' was not produced"))
    Result::Ok((dylib_path, false))

fn default_cache_root(prepare: &model::PrepareContext) -> std::path::PathBuf:
    match (*prepare).current_dir:
        Some(dir) => return dir.join(".kain").join("cache")
        _ =>
            ()
            ()
    std__env__current_dir().unwrap_or_else(fn(_): PathBuf__from(".")).join(".kain").join("cache")

