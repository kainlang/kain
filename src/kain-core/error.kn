use crate::diagnostic_registry::default_code_for_kind

use crate::diagnostic_registry::spec_for_code

use crate::diagnostic_registry::DiagnosticCode

use crate::span::Span

use std::fmt

use std::path::PathBuf

use thiserror::Error

pub enum KainError:
    Lexer { message: String, span: Span }
    Parser { message: String, span: Span }
    Type { message: String, span: Span }
    Effect { message: String, span: Span }
    Borrow { message: String, span: Span }
    Codegen { message: String, span: Span }
    CodegenWithLocation { message: String, file: String, line_: usize, col: usize, span: Span }
    Runtime { message: String }
    Io(io::Error)
    Enhanced { kind: ErrorKind, code: DiagnosticCode, file: Option<std::path::PathBuf>, location: Option<(usize, usize)>, context: String, message: String, suggestion: Option<String> }
    Multi(Array<KainError>)

pub enum ErrorKind:
    Parse
    Type
    Validation
    Codegen
    Io
    Config

impl std::fmt::Display for ErrorKind:
    fn fmt(_self: &ErrorKind, f: &mut std::fmt::Formatter<_>) -> Result<(), Error>:
        match *_self:
            ErrorKind::Parse => __kain_write_fmt!(f, "PARSE")
            ErrorKind::Type => __kain_write_fmt!(f, "TYPE")
            ErrorKind::Validation => __kain_write_fmt!(f, "VALIDATION")
            ErrorKind::Codegen => __kain_write_fmt!(f, "CODEGEN")
            ErrorKind::Io => __kain_write_fmt!(f, "IO")
            ErrorKind::Config => __kain_write_fmt!(f, "CONFIG")


fn format_enhanced_error(kind: &ErrorKind, code: &DiagnosticCode, file: &Option<std::path::PathBuf>, location: &Option<(usize, usize)>, context: String, message: String, suggestion: &Option<String>) -> String:
    let spec = diagnostic_registry__spec_for_code((*code))
    let mut output = String__new_()
    output.push_str(&f"❌ [{kind}:{spec.code_str}] {spec.title}")
    ()
    match file:
        Some(path) =>
            output.push_str(&f" in {path.display()}")
            ()
            match location:
                Some((line_, col)) =>
                    output.push_str(&f":{line_}:{col}")
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            ()
        _ =>
            ()
            ()
    output.push_str("\n\n")
    ()
    if (!context.is_empty()):
        output.push_str(&f"   Context: {context}\n")
        ()
        ()
        ()
        ()
    output.push_str(&f"   {message}\n")
    ()
    match (*suggestion).or_(spec.default_suggestion):
        Some(suggestion) =>
            output.push_str(&f"\n   Help: {suggestion}\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    match spec.docs_key:
        Some(docs_key) =>
            output.push_str(&f"\n   Reference: {docs_key}\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    output

fn format_multi_errors(errors: &[KainError]) -> String:
    let mut output = String__new_()
    output.push_str(&f"Found {errors.len()} error(s):\n")
    ()
    for selfhost_for_item in errors.iter().enumerate():
        let (i, err) = selfhost_for_item
        output.push_str(&f"\n[{(i + 1)}/{errors.len()}] {err}\n")
        ()
    ()
    output

impl KainError:
    pub fn lexer(message: impl Into<String>, span: Span) -> KainError:
        KainError::Lexer { message: message.into(), span: span }

    pub fn parser(message: impl Into<String>, span: Span) -> KainError:
        KainError::Parser { message: message.into(), span: span }

    pub fn type_error(message: impl Into<String>, span: Span) -> KainError:
        KainError::Type { message: message.into(), span: span }

    pub fn effect_error(message: impl Into<String>, span: Span) -> KainError:
        KainError::Effect { message: message.into(), span: span }

    pub fn borrow_error(message: impl Into<String>, span: Span) -> KainError:
        KainError::Borrow { message: message.into(), span: span }

    pub fn codegen(message: impl Into<String>, span: Span) -> KainError:
        KainError::Codegen { message: message.into(), span: span }

    pub fn codegen_with_location(message: impl Into<String>, file: impl Into<String>, line_: usize, col: usize, span: Span) -> KainError:
        KainError::CodegenWithLocation { message: message.into(), file: file.into(), line_: line_, col: col, span: span }

    pub fn runtime(message: impl Into<String>) -> KainError:
        KainError::Runtime { message: message.into() }

    pub fn multi(errors: Array<KainError>) -> KainError:
        if (!(!errors.is_empty())):
            panic("Multi error must contain at least one error")
        KainError::Multi(errors)

    pub fn parse_error(message: impl Into<String>) -> KainError:
        KainError::Enhanced { kind: ErrorKind__Parse, code: diagnostic_registry__default_code_for_kind(ErrorKind__Parse), file: none, location: none, context: String__new_(), message: message.into(), suggestion: none }

    pub fn type_err(message: impl Into<String>) -> KainError:
        KainError::Enhanced { kind: ErrorKind__Type, code: diagnostic_registry__default_code_for_kind(ErrorKind__Type), file: none, location: none, context: String__new_(), message: message.into(), suggestion: none }

    pub fn validation_error(message: impl Into<String>) -> KainError:
        KainError::Enhanced { kind: ErrorKind__Validation, code: diagnostic_registry__default_code_for_kind(ErrorKind__Validation), file: none, location: none, context: String__new_(), message: message.into(), suggestion: none }

    pub fn codegen_error(message: impl Into<String>) -> KainError:
        KainError::Enhanced { kind: ErrorKind__Codegen, code: diagnostic_registry__default_code_for_kind(ErrorKind__Codegen), file: none, location: none, context: String__new_(), message: message.into(), suggestion: none }

    pub fn io_error(message: impl Into<String>) -> KainError:
        KainError::Enhanced { kind: ErrorKind__Io, code: diagnostic_registry__default_code_for_kind(ErrorKind__Io), file: none, location: none, context: String__new_(), message: message.into(), suggestion: none }

    pub fn config_error(message: impl Into<String>) -> KainError:
        KainError::Enhanced { kind: ErrorKind__Config, code: diagnostic_registry__default_code_for_kind(ErrorKind__Config), file: none, location: none, context: String__new_(), message: message.into(), suggestion: none }

    pub fn diagnostic(kind: ErrorKind, code: DiagnosticCode, message: impl Into<String>) -> KainError:
        KainError::Enhanced { kind: kind, code: code, file: none, location: none, context: String__new_(), message: message.into(), suggestion: none }


pub type KainResult<T> = Result<T, KainError>

pub struct DiagnosticBuilder:
    kind: ErrorKind
    code: DiagnosticCode
    file: Option<std::path::PathBuf>
    location: Option<(usize, usize)>
    context: String
    message: String
    suggestion: Option<String>

impl DiagnosticBuilder:
    pub fn new_(kind: ErrorKind, code: DiagnosticCode, message: impl Into<String>) -> DiagnosticBuilder:
        DiagnosticBuilder { kind: kind, code: code, file: none, location: none, context: String__new_(), message: message.into(), suggestion: none }

    pub fn context(_self: DiagnosticBuilder, context: impl Into<String>) -> DiagnosticBuilder:
        _self.context = context.into()
        ()
        _self

    pub fn file(_self: DiagnosticBuilder, path: impl Into<std::path::PathBuf>) -> DiagnosticBuilder:
        _self.file = Option::Some(path.into())
        ()
        _self

    pub fn location(_self: DiagnosticBuilder, line_: usize, col: usize) -> DiagnosticBuilder:
        _self.location = Option::Some((line_, col))
        ()
        _self

    pub fn suggestion(_self: DiagnosticBuilder, suggestion: impl Into<String>) -> DiagnosticBuilder:
        _self.suggestion = Option::Some(suggestion.into())
        ()
        _self

    pub fn build(_self: DiagnosticBuilder) -> KainError:
        KainError::Enhanced { kind: _self.kind, code: _self.code, file: _self.file, location: _self.location, context: _self.context, message: _self.message, suggestion: _self.suggestion }


pub trait ErrorContext<T>:
    fn with_file(_self: Self_, path: std::path::PathBuf) -> Result<T, KainError>:
        let __selfhost_empty = none
    fn with_location(_self: Self_, line_: usize, col: usize) -> Result<T, KainError>:
        let __selfhost_empty = none
    fn with_context(_self: Self_, ctx: impl Into<String>) -> Result<T, KainError>:
        let __selfhost_empty = none
    fn with_suggestion(_self: Self_, suggestion: impl Into<String>) -> Result<T, KainError>:
        let __selfhost_empty = none

impl<T> ErrorContext<T> for Result<T, KainError>:
    fn with_file(_self: Result<T, KainError>, path: std::path::PathBuf) -> Result<T, KainError>:
        _self.map_err(fn(e): none)

    fn with_location(_self: Result<T, KainError>, line_: usize, col: usize) -> Result<T, KainError>:
        _self.map_err(fn(e): none)

    fn with_context(_self: Result<T, KainError>, ctx: impl Into<String>) -> Result<T, KainError>:
        _self.map_err(fn(e): none)

    fn with_suggestion(_self: Result<T, KainError>, suggestion: impl Into<String>) -> Result<T, KainError>:
        _self.map_err(fn(e): none)


@doc(doc = " Convert a TokenKind to user-friendly string representation")
@doc(doc = " This replaces debug formatting ({:?}) with readable syntax")
pub fn token_kind_to_user_string(kind: &lexer::TokenKind) -> String:
    use crate::lexer::TokenKind

    match kind:
        TokenKind::Fn => ("keyword 'fn'").to_string()
        TokenKind::Let => ("keyword 'let'").to_string()
        TokenKind::Mut => ("keyword 'mut'").to_string()
        TokenKind::Var => ("keyword 'var'").to_string()
        TokenKind::Const => ("keyword 'const'").to_string()
        TokenKind::If => ("keyword 'if'").to_string()
        TokenKind::Else => ("keyword 'else'").to_string()
        TokenKind::Elif => ("keyword 'elif'").to_string()
        TokenKind::Match => ("keyword 'match'").to_string()
        TokenKind::For => ("keyword 'for'").to_string()
        TokenKind::While => ("keyword 'while'").to_string()
        TokenKind::Loop => ("keyword 'loop'").to_string()
        TokenKind::Break => ("keyword 'break'").to_string()
        TokenKind::Continue => ("keyword 'continue'").to_string()
        TokenKind::Return => ("keyword 'return'").to_string()
        TokenKind::Await => ("keyword 'await'").to_string()
        TokenKind::In => ("keyword 'in'").to_string()
        TokenKind::With => ("keyword 'with'").to_string()
        TokenKind::As => ("keyword 'as'").to_string()
        TokenKind::TypeKw => ("keyword 'type'").to_string()
        TokenKind::Struct => ("keyword 'struct'").to_string()
        TokenKind::Enum => ("keyword 'enum'").to_string()
        TokenKind::Trait => ("keyword 'trait'").to_string()
        TokenKind::Impl => ("keyword 'impl'").to_string()
        TokenKind::Pub => ("keyword 'pub'").to_string()
        TokenKind::Mod => ("keyword 'mod'").to_string()
        TokenKind::Use => ("keyword 'use'").to_string()
        TokenKind::SelfLower => ("keyword 'self'").to_string()
        TokenKind::SelfUpper => ("keyword 'Self'").to_string()
        TokenKind::True => ("keyword 'true'").to_string()
        TokenKind::False => ("keyword 'false'").to_string()
        TokenKind::None => ("keyword 'none'").to_string()
        TokenKind::Component => ("keyword 'component'").to_string()
        TokenKind::Shader => ("keyword 'shader'").to_string()
        TokenKind::Actor => ("keyword 'actor'").to_string()
        TokenKind::State => ("keyword 'state'").to_string()
        TokenKind::Spawn => ("keyword 'spawn'").to_string()
        TokenKind::Send => ("keyword 'send'").to_string()
        TokenKind::Receive => ("keyword 'receive'").to_string()
        TokenKind::Emit => ("keyword 'emit'").to_string()
        TokenKind::Comptime => ("keyword 'comptime'").to_string()
        TokenKind::Macro => ("keyword 'macro'").to_string()
        TokenKind::Vertex => ("keyword 'vertex'").to_string()
        TokenKind::Fragment => ("keyword 'fragment'").to_string()
        TokenKind::Test => ("keyword 'test'").to_string()
        TokenKind::Pure_ => ("keyword 'Pure'").to_string()
        TokenKind::Io => ("keyword 'IO'").to_string()
        TokenKind::AsyncKw => ("keyword 'async'").to_string()
        TokenKind::Async_ => ("keyword 'Async'").to_string()
        TokenKind::Gpu => ("keyword 'GPU'").to_string()
        TokenKind::Reactive_ => ("keyword 'Reactive'").to_string()
        TokenKind::Unsafe_ => ("keyword 'Unsafe'").to_string()
        TokenKind::Int(n) => f"number {n}"
        TokenKind::Float(f) => f"number {f}"
        TokenKind::String(s) => f"string \"{s}\""
        TokenKind::FString(s) => f"f-string f\"{s}\""
        TokenKind::Char(c) => f"character '{c}'"
        TokenKind::Ident(name) => f"identifier '{name}'"
        TokenKind::PlusPlus => ("'++'").to_string()
        TokenKind::MinusMinus => ("'--'").to_string()
        TokenKind::Plus => ("'+'").to_string()
        TokenKind::Minus => ("'-'").to_string()
        TokenKind::Star => ("'*'").to_string()
        TokenKind::Slash => ("'/'").to_string()
        TokenKind::Percent => ("'%'").to_string()
        TokenKind::Power => ("'**'").to_string()
        TokenKind::EqEq => ("'=='").to_string()
        TokenKind::NotEq => ("'!='").to_string()
        TokenKind::Lt => ("'<'").to_string()
        TokenKind::Gt => ("'>'").to_string()
        TokenKind::LtEq => ("'<='").to_string()
        TokenKind::GtEq => ("'>='").to_string()
        TokenKind::And => ("'&&' or 'and'").to_string()
        TokenKind::Or => ("'||' or 'or'").to_string()
        TokenKind::Not => ("'!'").to_string()
        TokenKind::Amp => ("'&'").to_string()
        TokenKind::Pipe => ("'|'").to_string()
        TokenKind::Caret => ("'^'").to_string()
        TokenKind::Tilde => ("'~'").to_string()
        TokenKind::Shl => ("'<<'").to_string()
        TokenKind::Shr => ("'>>'").to_string()
        TokenKind::Eq => ("'='").to_string()
        TokenKind::PlusEq => ("'+='").to_string()
        TokenKind::MinusEq => ("'-='").to_string()
        TokenKind::StarEq => ("'*='").to_string()
        TokenKind::SlashEq => ("'/='").to_string()
        TokenKind::PercentEq => ("'%='").to_string()
        TokenKind::AmpEq => ("'&='").to_string()
        TokenKind::PipeEq => ("'|='").to_string()
        TokenKind::CaretEq => ("'^='").to_string()
        TokenKind::ShlEq => ("'<<='").to_string()
        TokenKind::ShrEq => ("'>>='").to_string()
        TokenKind::LParen => ("'('").to_string()
        TokenKind::RParen => ("')'").to_string()
        TokenKind::LBracket => ("'['").to_string()
        TokenKind::RBracket => ("']'").to_string()
        TokenKind::LBrace => ("'{'").to_string()
        TokenKind::RBrace => ("'}'").to_string()
        TokenKind::Comma => ("','").to_string()
        TokenKind::Dot => ("'.'").to_string()
        TokenKind::DotDot => ("'..").to_string()
        TokenKind::DotDotDot => ("'...'").to_string()
        TokenKind::Colon => ("':'").to_string()
        TokenKind::ColonColon => ("'::'").to_string()
        TokenKind::Semi => ("';'").to_string()
        TokenKind::Arrow => ("'->'").to_string()
        TokenKind::FatArrow => ("'=>'").to_string()
        TokenKind::At => ("'@'").to_string()
        TokenKind::QuestionQuestion => ("'??'").to_string()
        TokenKind::QuestionDot => ("'?.'").to_string()
        TokenKind::Question => ("'?'").to_string()
        TokenKind::LtSlash => ("'</'").to_string()
        TokenKind::Newline(_) => ("newline").to_string()
        TokenKind::Comment => ("comment").to_string()
        TokenKind::HashComment => ("comment").to_string()
        TokenKind::Indent => ("indentation").to_string()
        TokenKind::Dedent => ("dedentation").to_string()
        TokenKind::Eof => ("end of file").to_string()

@doc(doc = " Convert a Token to user-friendly string representation")
pub fn token_to_user_string(token: &lexer::Token) -> String:
    token_kind_to_user_string(&(*token).kind)

