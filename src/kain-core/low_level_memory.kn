@derive(Debug, Clone)
struct LayoutField:
    offset: usize
    ty: Type
    bit_width: Option<usize>
    bit_offset: Option<usize>
    bit_signed: Bool

@derive(Debug, Clone, Default)
struct StructLayoutInfo:
    size: usize
    align: usize
    is_union: Bool
    field_order: Array<String>
    fields: Map<String, LayoutField>

impl Default for StructLayoutInfo:
    pub fn default_() -> StructLayoutInfo:
        StructLayoutInfo { size: 0, align: 0, is_union: false, field_order: Vec__new_(), fields: HashMap__new_() }


@derive(Debug, Clone)
struct LayoutRegistry:
    abi: &static CAbiPolicy
    structs: Map<String, StructLayoutInfo>

impl LayoutRegistry:
    fn build_with_abi(items: &[TypedItem], abi: &static CAbiPolicy) -> LayoutRegistry:
        let mut registry = LayoutRegistry { abi: abi, structs: HashMap__new_() }
        collect_struct_layouts(items, &mut registry)
        ()
        registry


fn collect_struct_layouts(items: &[TypedItem], registry: &mut LayoutRegistry):
    for item in items:
        match item:
            TypedItem::Struct(st) =>
                let is_union = low_level_memory_metadata__has_attr(&st.ast.attributes, low_level_memory_metadata__C_UNION_ATTR)
                let is_packed = low_level_memory_metadata__has_attr(&st.ast.attributes, low_level_memory_metadata__C_PACKED_ATTR)
                let pack_align = match low_level_memory_metadata__attr_usize_arg(&st.ast.attributes, low_level_memory_metadata__C_PACK_ALIGN_ATTR):
                    Some(bits) =>
                        let align = bits.div_ceil(8)
                        if (align > 0):
                            Option::Some(align)
                        else:
                            none
                    None => none
                let explicit_type_align = match low_level_memory_metadata__attr_usize_arg(&st.ast.attributes, low_level_memory_metadata__C_TYPE_ALIGN_ATTR):
                    Some(bits) =>
                        let align = bits.div_ceil(8)
                        if (align > 0):
                            Option::Some(align)
                        else:
                            none
                    None => none
                let mut offset = 0
                let mut max_field_size = 0
                let mut max_align = 1
                let mut fields = HashMap__new_()
                let mut field_order = Vec__new_()
                let mut bit_pack: Option<BitfieldPack> = none
                for field in &st.ast.fields:
                    let size = low_level_memory_metadata__attr_usize_arg(&field.attributes, low_level_memory_metadata__C_STORAGE_BITS_ATTR).map(fn(bits): bits.div_ceil(8)).unwrap_or_else(fn(): registry.type_size_fallback(&field.ty))
                    let natural_align = low_level_memory_metadata__attr_usize_arg(&field.attributes, low_level_memory_metadata__C_STORAGE_ALIGN_ATTR).map(fn(bits): bits.div_ceil(8)).unwrap_or_else(fn(): registry.type_align_fallback(&field.ty)).max(1)
                    let align = match pack_align:
                        Some(pack_align) => natural_align.min(pack_align).max(1)
                        _ => if is_packed: (*registry).abi.packed_struct_align.max(1) else: natural_align
                    let (bit_width, bit_signed) = low_level_memory_metadata__attr_usize_bool_args(&field.attributes, low_level_memory_metadata__C_BITFIELD_ATTR).map(fn(__kain_closure_arg0): (Option::Some(__kain_closure_arg0.__kain_tuple_0), __kain_closure_arg0.__kain_tuple_1)).unwrap_or_else(fn(): (low_level_memory_metadata__attr_usize_arg(&field.attributes, low_level_memory_metadata__C_BITFIELD_ATTR), true))
                    max_field_size = max_field_size.max(size.max(1))
                    ()
                    max_align = max_align.max(align)
                    ()
                    let field_name = field.name.clone()
                    let (field_offset, field_bit_offset) = if is_union:
                        (0, bit_width.map(fn(_): 0))
                    else:
                        match bit_width:
                            Some(width) =>
                                let width = width.max(1)
                                let unit_size = size.max(1)
                                let unit_bits = unit_size.saturating_mul(8).max(1)
                                if (width >= unit_bits):
                                    match bit_pack.take():
                                        Some(pack) =>
                                            offset = offset.max((pack.unit_offset + pack.unit_size))
                                            ()
                                            ()
                                            ()
                                            ()
                                        _ =>
                                            ()
                                            ()
                                    offset = align_up(offset, align)
                                    ()
                                    let field_offset = offset
                                    offset = (offset + unit_size)
                                    ()
                                    (field_offset, Option::Some(0))
                                else:
                                    let needs_new_pack = match (none):
                                        Some(pack) => (((pack.unit_size != unit_size) || (pack.align != align)) || ((pack.used_bits + width) > unit_bits))
                                        None => true
                                    if needs_new_pack:
                                        match bit_pack.take():
                                            Some(pack) =>
                                                offset = offset.max((pack.unit_offset + pack.unit_size))
                                                ()
                                                ()
                                                ()
                                                ()
                                            _ =>
                                                ()
                                                ()
                                        offset = align_up(offset, align)
                                        ()
                                        bit_pack = Option::Some(BitfieldPack { unit_offset: offset, unit_size: unit_size, align: align, used_bits: 0 })
                                        ()
                                        ()
                                        ()
                                        ()
                                    let pack = bit_pack.expect("bitfield pack should exist before recording field")
                                    let field_offset = pack.unit_offset
                                    let field_bit_offset = if (*registry).abi.bitfield_lsb_first:
                                        pack.used_bits
                                    else:
                                        unit_bits.saturating_sub((pack.used_bits + width))
                                    pack.used_bits = (pack.used_bits + width)
                                    ()
                                    if (pack.used_bits >= unit_bits):
                                        let flushed = bit_pack.take().expect("bitfield pack should flush")
                                        offset = offset.max((flushed.unit_offset + flushed.unit_size))
                                        ()
                                        ()
                                        ()
                                        ()
                                    (field_offset, Option::Some(field_bit_offset))
                            _ =>
                                match bit_pack.take():
                                    Some(pack) =>
                                        offset = offset.max((pack.unit_offset + pack.unit_size))
                                        ()
                                        ()
                                        ()
                                        ()
                                    _ =>
                                        ()
                                        ()
                                offset = align_up(offset, align)
                                ()
                                let field_offset = offset
                                offset = (offset + size.max(1))
                                ()
                                (field_offset, none)
                    fields.insert(field_name.clone(), LayoutField { offset: field_offset, ty: field.ty.clone(), bit_width: bit_width, bit_offset: field_bit_offset, bit_signed: bit_signed })
                    ()
                    field_order.push(field_name)
                    ()
                ()
                match bit_pack.take():
                    Some(pack) =>
                        offset = offset.max((pack.unit_offset + pack.unit_size))
                        ()
                        ()
                        ()
                        ()
                    _ =>
                        ()
                        ()
                let raw_size = if is_union:
                    max_field_size
                else:
                    offset
                let base_final_align = match pack_align:
                    Some(pack_align) => max_align.min(pack_align).max(1)
                    _ => if is_packed: (*registry).abi.packed_struct_align.max(1) else: max_align
                let final_align = explicit_type_align.map(fn(align): align.max(base_final_align)).unwrap_or(base_final_align)
                let size = align_up(raw_size.max(1), final_align)
                (*registry).structs.insert(st.ast.name.clone(), StructLayoutInfo { size: size, align: final_align, is_union: is_union, field_order: field_order, fields: fields })
                ()
            TypedItem::Mod(module) => collect_struct_layouts(&module.items, registry)
            _ => ()

impl LayoutRegistry:
    fn field(_self: &LayoutRegistry, struct_name: String, field: String) -> Option<&LayoutField>:
        ((*_self).structs.get(struct_name)?).fields.get(field)

    fn type_size_fallback(_self: &LayoutRegistry, ty: &Type) -> usize:
        match ty:
            Type::Named { name: name } =>
                match name.as_str():
                    "Bool" => (*_self).abi.bool_bits.div_ceil(8)
                    "Char" => (*_self).abi.char_bits.div_ceil(8)
                    "Int" => (*_self).abi.long_bits.div_ceil(8)
                    "isize" => (*_self).abi.long_bits.div_ceil(8)
                    "usize" => (*_self).abi.long_bits.div_ceil(8)
                    "Float" => (*_self).abi.double_bits.div_ceil(8)
                    other => (*_self).structs.get(other).map(fn(info): info.size).unwrap_or(8)
            Type::Array(inner, size, _) => ((*_self).type_size_fallback(inner) * (*size))
            Type::Slice(_, _) => 16
            Type::Tuple(types, _) =>
                let mut total = 0
                for ty in types:
                    total = (total + (*_self).type_size_fallback(ty))
                    ()
                ()
                total
            Type::Ref {  } => 8
            Type::Ptr {  } => 8
            Type::Option(inner, _) => (*_self).type_size_fallback(inner)
            Type::Result(ok, err, _) => (*_self).type_size_fallback(ok).max((*_self).type_size_fallback(err))
            Type::Unit(_) => 0
            Type::Never(_) => 0
            _ => 8

    fn type_align_fallback(_self: &LayoutRegistry, ty: &Type) -> usize:
        match ty:
            Type::Named { name: name } =>
                match name.as_str():
                    "Bool" => (*_self).abi.bool_bits.div_ceil(8)
                    "Char" => (*_self).abi.char_bits.div_ceil(8)
                    "Int" => (*_self).abi.long_bits.div_ceil(8)
                    "isize" => (*_self).abi.long_bits.div_ceil(8)
                    "usize" => (*_self).abi.long_bits.div_ceil(8)
                    "Float" => (*_self).abi.double_bits.div_ceil(8)
                    other => (*_self).structs.get(other).map(fn(info): info.align.max(1)).unwrap_or(8)
            Type::Array(inner, _, _) => (*_self).type_align_fallback(inner)
            Type::Slice(_, _) => 8
            Type::Tuple(types, _) => types.iter().map(fn(ty): (*_self).type_align_fallback(ty)).max().unwrap_or(1)
            Type::Ref {  } => 8
            Type::Ptr {  } => 8
            Type::Option(inner, _) => (*_self).type_align_fallback(inner)
            Type::Result(ok, err, _) => (*_self).type_align_fallback(ok).max((*_self).type_align_fallback(err))
            Type::Unit(_) => 1
            Type::Never(_) => 1
            _ => 8


@derive(Debug, Clone, Copy)
struct BitfieldPack:
    unit_offset: usize
    unit_size: usize
    align: usize
    used_bits: usize

fn align_up(value: usize, align: usize) -> usize:
    let align = align.max(1)
    let remainder = (value % align)
    if (remainder == 0):
        value
    else:
        (value + ((align - remainder)))

@derive(Debug, Clone)
struct FunctionMemoryCtx<a>:
    target: CompileTarget
    layouts: &a LayoutRegistry
    address_taken: Set<String>
    local_types: Map<String, Type>

@derive(Debug, Clone, Copy)
pub struct BackendMemoryCapabilities:
    raw_pointers: Bool
    raw_memory_ops: Bool

const TS_MEMORY_CAPS: BackendMemoryCapabilities = BackendMemoryCapabilities { raw_pointers: false, raw_memory_ops: false }

const UE5_MEMORY_CAPS: BackendMemoryCapabilities = BackendMemoryCapabilities { raw_pointers: false, raw_memory_ops: false }

const DEFAULT_MEMORY_CAPS: BackendMemoryCapabilities = BackendMemoryCapabilities { raw_pointers: true, raw_memory_ops: true }

pub fn backend_memory_capabilities(target: CompileTarget) -> BackendMemoryCapabilities:
    match target:
        CompileTarget::Ts => TS_MEMORY_CAPS
        CompileTarget::Js => TS_MEMORY_CAPS
        CompileTarget::Wasm => TS_MEMORY_CAPS
        CompileTarget::Hybrid => TS_MEMORY_CAPS
        CompileTarget::Ue5 => UE5_MEMORY_CAPS
        CompileTarget::Ue5Editor => UE5_MEMORY_CAPS
        _ => DEFAULT_MEMORY_CAPS

pub fn validate_typed_program_memory_support(program: &TypedProgram, target: CompileTarget) -> Result<(), KainError>:
    let caps = backend_memory_capabilities(target)
    if (caps.raw_pointers && caps.raw_memory_ops):
        return Result::Ok(())
    match first_unsupported_memory_context(&(*program).items, caps):
        Some(context) => return Result::Err(DiagnosticBuilder__new_(ErrorKind__Validation, DiagnosticCode__MemoryUnsupportedBackend, f"Target '{target}' does not currently support raw low-level memory semantics in normalized codegen.").context(context).build())
        _ =>
            ()
            ()
    Result::Ok(())

pub fn lower_typed_program_memory_for_target(program: &TypedProgram, target: CompileTarget) -> Result<TypedProgram, KainError>:
    let supported = match target:
        CompileTarget::Ts => true
        CompileTarget::Js => true
        CompileTarget::Wasm => true
        CompileTarget::Llvm => true
        CompileTarget::Cpp => true
        CompileTarget::Rust => true
        CompileTarget::Ue5 => true
        CompileTarget::Ue5Editor => true
        _ => false
    if (!supported):
        return Result::Ok(program.clone())
    let layouts = LayoutRegistry__build_with_abi(&(*program).items, low_level_abi__c_abi_policy_for_target(target))
    Result::Ok(TypedProgram { items: (*program).items.iter().map(fn(item): lower_typed_item_memory(item, target, &layouts)).collect() })

pub fn lower_monomorphized_program_memory_for_target(program: &MonomorphizedProgram, target: CompileTarget) -> Result<MonomorphizedProgram, KainError>:
    Result::Ok(MonomorphizedProgram { items: (lower_typed_program_memory_for_target(&TypedProgram { items: (*program).items.clone() }, target)?).items })

fn lower_typed_item_memory(item: &TypedItem, target: CompileTarget, layouts: &LayoutRegistry) -> TypedItem:
    match item:
        TypedItem::Function(function) => TypedItem::Function(TypedFunction { ast: lower_function_memory(&function.ast, target, layouts), resolved_type: lower_resolved_type_memory(&function.resolved_type), effects: function.effects.clone() })
        TypedItem::Struct(struct_item) => TypedItem::Struct(TypedStruct { ast: Struct { fields: struct_item.ast.fields.iter().map(fn(field): Field { ty: lower_type_memory(&field.ty), default_: field.default_.map(fn(expr): lower_free_expr_memory(expr, target, layouts)), ..field.clone() }).collect(), methods: struct_item.ast.methods.iter().map(fn(method): lower_function_memory(method, target, layouts)).collect(), ..struct_item.ast.clone() }, field_types: struct_item.field_types.iter().map(fn(__kain_closure_arg1): (__kain_closure_arg1.__kain_tuple_0.clone(), lower_resolved_type_memory(__kain_closure_arg1.__kain_tuple_1))).collect() })
        TypedItem::Component(component_) => TypedItem::Component(TypedComponent { ast: Component { props: component_.ast.props.iter().map(fn(prop): Param { ty: lower_type_memory(&prop.ty), ..prop.clone() }).collect(), body: component_.ast.body.clone(), ..component_.ast.clone() }, prop_types: component_.prop_types.iter().map(fn(__kain_closure_arg2): (__kain_closure_arg2.__kain_tuple_0.clone(), lower_resolved_type_memory(__kain_closure_arg2.__kain_tuple_1))).collect() })
        TypedItem::Actor(actor_) => TypedItem::Actor(TypedActor { ast: Actor { state_: actor_.ast.state_.iter().map(fn(state_): StateDecl { ty: lower_type_memory(&state_.ty), initial: lower_free_expr_memory(&state_.initial, target, layouts), ..state_.clone() }).collect(), handlers: actor_.ast.handlers.iter().map(fn(handler): lower_actor_handler_memory(handler, target, layouts)).collect(), methods: actor_.ast.methods.iter().map(fn(method): lower_function_memory(method, target, layouts)).collect(), ..actor_.ast.clone() }, state_types: actor_.state_types.iter().map(fn(__kain_closure_arg3): (__kain_closure_arg3.__kain_tuple_0.clone(), lower_resolved_type_memory(__kain_closure_arg3.__kain_tuple_1))).collect() })
        TypedItem::Const(constant) => TypedItem::Const(TypedConst { ast: Const { ty: lower_type_memory(&constant.ast.ty), value: lower_free_expr_memory(&constant.ast.value, target, layouts), ..constant.ast.clone() }, ty: lower_resolved_type_memory(&constant.ty) })
        TypedItem::Impl(imp) => TypedItem::Impl(TypedImpl { ast: Impl { target_type: lower_type_memory(&imp.ast.target_type), methods: imp.ast.methods.iter().map(fn(method): lower_function_memory(method, target, layouts)).collect(), ..imp.ast.clone() } })
        TypedItem::TypeAlias(alias) => TypedItem::TypeAlias(TypedTypeAlias { ast: TypeAlias { target: lower_type_memory(&alias.ast.target), ..alias.ast.clone() } })
        TypedItem::Mod(module) => TypedItem::Mod(TypedMod { ast: module.ast.clone(), items: module.items.iter().map(fn(child): lower_typed_item_memory(child, target, layouts)).collect() })
        TypedItem::Enum(enum_item) => TypedItem::Enum(TypedEnum { ast: lower_enum_memory(&enum_item.ast, target, layouts), variant_payload_types: enum_item.variant_payload_types.iter().map(fn(__kain_closure_arg4): (__kain_closure_arg4.__kain_tuple_0.clone(), __kain_closure_arg4.__kain_tuple_1.iter().map(lower_resolved_type_memory).collect())).collect() })
        _ => item.clone()

fn lower_enum_memory(enum_ast: &Enum, target: CompileTarget, layouts: &LayoutRegistry) -> Enum:
    let mut variants = Vec__new_()
    for variant in &(*enum_ast).variants:
        let fields = match &variant.fields:
            VariantFields::Unit => VariantFields__Unit
            VariantFields::Tuple(types) => VariantFields::Tuple(types.iter().map(lower_type_memory).collect())
            VariantFields::Struct(fields) => VariantFields::Struct(fields.iter().map(fn(field): Field { ty: lower_type_memory(&field.ty), default_: field.default_.map(fn(expr): lower_free_expr_memory(expr, target, layouts)), ..field.clone() }).collect())
        variants.push(Variant { fields: fields, ..variant.clone() })
        ()
    ()
    Enum { variants: variants, ..enum_ast.clone() }

fn lower_function_memory(function: &Function, target: CompileTarget, layouts: &LayoutRegistry) -> Function:
    let params = (*function).params.iter().map(fn(param): Param { ty: lower_type_memory(&param.ty), ..param.clone() }).collect()
    let mut local_types = collect_local_types_from_block(&(*function).body)
    for param in &(*function).params:
        local_types.insert(param.name.clone(), param.ty.clone())
        ()
    ()
    let mut ctx = FunctionMemoryCtx { target: target, layouts: layouts, address_taken: collect_address_taken_roots(&(*function).body), local_types: local_types }
    let mut body = lower_block_memory_with_ctx(&(*function).body, &mut ctx)
    if (!ctx.address_taken.is_empty()):
        let mut prefix = Vec__new_()
        for param in &(*function).params:
            if ctx.address_taken.contains(&param.name):
                prefix.push(make_pointer_binding_stmt(&param.name, param.span))
                ()
        ()
        if (!prefix.is_empty()):
            let mut merged = prefix
            for stmt in body.stmts:
                merged.push(stmt)
                ()
            ()
            body.stmts = merged
            ()
            ()
            ()
            ()
        ()
    Function { params: params, return_type: none, body: body, ..function.clone() }

fn lower_free_expr_memory(expr: &Expr, target: CompileTarget, layouts: &LayoutRegistry) -> Expr:
    let mut ctx = FunctionMemoryCtx { target: target, layouts: layouts, address_taken: HashSet__new_(), local_types: HashMap__new_() }
    lower_expr_memory_with_ctx(expr, &mut ctx)

fn lower_actor_handler_memory(handler: &MessageHandler, target: CompileTarget, layouts: &LayoutRegistry) -> MessageHandler:
    let mut local_types = collect_local_types_from_block(&(*handler).body)
    for param in &(*handler).params:
        local_types.insert(param.name.clone(), param.ty.clone())
        ()
    ()
    let mut ctx = FunctionMemoryCtx { target: target, layouts: layouts, address_taken: collect_address_taken_roots(&(*handler).body), local_types: local_types }
    MessageHandler { params: (*handler).params.iter().map(fn(param): Param { ty: lower_type_memory(&param.ty), ..param.clone() }).collect(), body: lower_block_memory_with_ctx(&(*handler).body, &mut ctx), ..handler.clone() }

fn lower_block_memory_with_ctx(block: &Block, ctx: &mut FunctionMemoryCtx<_>) -> Block:
    let mut stmts = Vec__new_()
    for stmt in &(*block).stmts:
        for lowered_stmt in lower_stmt_memory_with_ctx(stmt, ctx):
            stmts.push(lowered_stmt)
            ()
    ()
    Block { stmts: stmts, ..block.clone() }

fn lower_stmt_memory_with_ctx(stmt: &Stmt, ctx: &mut FunctionMemoryCtx<_>) -> Array<Stmt>:
    let mut out_ = Vec__new_()
    match stmt:
        Stmt::Expr(expr) =>
            out_.push(Stmt::Expr(lower_expr_memory_with_ctx(expr, ctx)))
            ()
            ()
            ()
            ()
        Stmt::Let { pattern: pattern, ty: ty, value: value, span: span } =>
            let lowered_value = match value:
                Some(expr) => Option::Some(lower_expr_memory_with_ctx(expr, ctx))
                None => none
            out_.push(Stmt::Let { pattern: pattern.clone(), ty: none, value: lowered_value, span: (*span) })
            ()
            match pattern:
                Pattern::Binding { name: name } =>
                    match ty:
                        Some(ty) =>
                            (*ctx).local_types.insert(name.clone(), ty.clone())
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    if (*ctx).address_taken.contains(name):
                        out_.push(make_pointer_binding_stmt(name, (*span)))
                        ()
                        return out_
                    ()
                _ =>
                    ()
                    ()
            ()
        Stmt::Return(value, span) =>
            out_.push(Stmt::Return(none, (*span)))
            ()
            ()
            ()
            ()
        Stmt::Break(value, span) =>
            out_.push(Stmt::Break(none, (*span)))
            ()
            ()
            ()
            ()
        Stmt::Continue(span) =>
            out_.push(Stmt::Continue((*span)))
            ()
            ()
            ()
            ()
        Stmt::For { binding: binding, iter: iter, body: body, span: span } =>
            out_.push(Stmt::For { binding: binding.clone(), iter: lower_expr_memory_with_ctx(iter, ctx), body: lower_block_memory_with_ctx(body, ctx), span: (*span) })
            ()
            ()
            ()
            ()
        Stmt::While { condition: condition, body: body, span: span } =>
            out_.push(Stmt::While { condition: lower_expr_memory_with_ctx(condition, ctx), body: lower_block_memory_with_ctx(body, ctx), span: (*span) })
            ()
            ()
            ()
            ()
        Stmt::Loop { body: body, span: span } =>
            out_.push(Stmt::Loop { body: lower_block_memory_with_ctx(body, ctx), span: (*span) })
            ()
            ()
            ()
            ()
        Stmt::Item(item) =>
            out_.push(Stmt::Item(item.clone()))
            ()
            ()
            ()
            ()
    out_

fn lower_expr_memory_with_ctx(expr: &Expr, ctx: &mut FunctionMemoryCtx<_>) -> Expr:
    let span = expr.span()
    match expr:
        Expr::Ident(name, ident_span) if should_load_from_pointer(name, ctx) => load_from_pointer_binding(name, (*ctx).local_types.get(name), (*ident_span))
        Expr::AddrOf { value: value, pointee_ty: pointee_ty } => lower_addr_of_memory(value, pointee_ty, ctx, span)
        Expr::PtrOffset { pointer: pointer, offset: offset, element_ty: element_ty } =>
            let stride = memory_stride_for_type(element_ty, (*ctx).layouts).unwrap_or(1)
            helper_call("__kain_ptr_offset", [lower_expr_memory_with_ctx(pointer, ctx), lower_expr_memory_with_ctx(offset, ctx), Expr::Int(stride, span)], span)
        Expr::MemLoad { pointer: pointer, load_ty: load_ty } =>
            let call = helper_call("__kain_mem_load", [lower_expr_memory_with_ctx(pointer, ctx)], span)
            match load_ty:
                Some(ty) => Expr::Cast { value: Box__new_(call), target: lower_type_memory(ty), span: span }
                _ => call
        Expr::MemStore { pointer: pointer, value: value } => helper_call("__kain_mem_store", [lower_expr_memory_with_ctx(pointer, ctx), lower_expr_memory_with_ctx(value, ctx)], span)
        Expr::SizeOfType { target: target } => Expr::Int(estimate_type_size(target, (*ctx).layouts) as i64, span)
        Expr::AlignOfType { target: target } => Expr::Int(estimate_type_align(target, (*ctx).layouts) as i64, span)
        Expr::Alloca { ty: ty } => lower_storage_expr(ty, (*ctx).layouts, span, false)
        Expr::Uninit { ty: ty } => lower_storage_expr(ty, (*ctx).layouts, span, false)
        Expr::Alloc { size: size, ty: ty, zeroed: zeroed } => lower_heap_alloc_expr(&lower_expr_memory_with_ctx(size, ctx), ty, (*zeroed), (*ctx).target, (*ctx).layouts, span)
        Expr::Realloc { pointer: pointer, size: size, ty: ty, zeroed_new: zeroed_new } => lower_heap_realloc_expr(&lower_expr_memory_with_ctx(pointer, ctx), &lower_expr_memory_with_ctx(size, ctx), ty, (*zeroed_new), (*ctx).target, (*ctx).layouts, span)
        Expr::AggregateInit { ty: ty, fields: fields, zero_fill_rest: zero_fill_rest } =>
            let mut lowered_fields: Array<(String, Expr)> = Vec__new_()
            for selfhost_for_item in fields.iter():
                let (name, value) = selfhost_for_item
                lowered_fields.push((name.clone(), lower_expr_memory_with_ctx(value, ctx)))
                ()
            ()
            lower_aggregate_init_expr(ty, &lowered_fields, (*zero_fill_rest), (*ctx).layouts, span)
        Expr::Assign { target: target, value: value, span: span } =>
            match target:
                Expr::Ident(name, _) =>
                    if should_load_from_pointer(name, ctx):
                        return helper_call("__kain_mem_store", [Expr::Ident(pointer_binding_name(name), (*span)), lower_expr_memory_with_ctx(value, ctx)], (*span))
                    ()
                _ =>
                    ()
                    ()
            match target:
                Expr::Field { object: object, field: field } =>
                    match field_layout_from_object(object, field, ctx):
                        Some(field_layout) =>
                            let field_offset = field_layout.offset
                            let field_bit_width = field_layout.bit_width
                            let field_bit_offset = field_layout.bit_offset.unwrap_or(0)
                            let field_bit_signed = field_layout.bit_signed
                            let lowered_object = lower_expr_memory_with_ctx(object, ctx)
                            let lowered_value = lower_expr_memory_with_ctx(value, ctx)
                            match field_bit_width:
                                Some(bit_width) =>
                                    let promoted_bits = low_level_abi__promoted_integer_bits(bit_width, field_bit_signed, (*ctx).layouts.abi)
                                    return helper_call("__kain_bitfield_set", [lowered_object, Expr::String(field.clone(), (*span)), Expr::Int(field_offset as i64, (*span)), Expr::Int(field_bit_offset as i64, (*span)), Expr::Int(bit_width as i64, (*span)), Expr::Bool(field_bit_signed, (*span)), Expr::Int(promoted_bits as i64, (*span)), lowered_value], (*span))
                                _ =>
                                    ()
                                    ()
                            ()
                        _ =>
                            ()
                            ()
                    match struct_layout_from_object(object, ctx).filter(fn(layout): layout.is_union).map(fn(layout): layout.size):
                        Some(layout_size) =>
                            let field_ty = field_type_from_object(&infer_expr_type(object, ctx).unwrap_or(Type::Unit((*span))), field, ctx)
                            let (field_type_name, field_stride) = match &field_ty:
                                Some(ty) => (type_key(ty), memory_stride_for_type(Option::Some(ty), (*ctx).layouts).unwrap_or(1))
                                None => (("unknown").to_string(), 1)
                            return helper_call("__kain_union_set", [lower_expr_memory_with_ctx(object, ctx), Expr::String(field.clone(), (*span)), Expr::String(field_type_name, (*span)), Expr::Int(field_stride, (*span)), Expr::Int(layout_size as i64, (*span)), lower_expr_memory_with_ctx(value, ctx)], (*span))
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            Expr::Assign { target: Box__new_(lower_expr_memory_with_ctx(target, ctx)), value: Box__new_(lower_expr_memory_with_ctx(value, ctx)), span: (*span) }
        Expr::Ref { mutable_: mutable_, value: value, span: span } => Expr::Ref { mutable_: (*mutable_), value: Box__new_(lower_expr_memory_with_ctx(value, ctx)), span: (*span) }
        Expr::Deref(inner, inner_span) => Expr::Deref(Box__new_(lower_expr_memory_with_ctx(inner, ctx)), (*inner_span))
        Expr::Binary { left: left, op: op, right: right, span: span } =>
            let left_ty = infer_expr_type(left, ctx)
            let right_ty = infer_expr_type(right, ctx)
            let lowered_left = lower_expr_memory_with_ctx(left, ctx)
            let lowered_right = lower_expr_memory_with_ctx(right, ctx)
            if low_level_abi__should_apply_usual_arithmetic_conversions((*op)):
                let common_ty = match (left_ty, right_ty):
                    (Some(lhs), Some(rhs)) => low_level_abi__usual_arithmetic_conversion_type(lhs, rhs, (*ctx).layouts.abi)
                    _ => none
                return Expr::Binary { left: Box__new_(cast_if_needed(lowered_left, common_ty.clone(), (*span))), op: (*op), right: Box__new_(cast_if_needed(lowered_right, common_ty, (*span))), span: (*span) }
            let normalized_left = match op:
                BinaryOp::Shl => cast_if_needed(lowered_left, none, (*span))
                BinaryOp::Shr => cast_if_needed(lowered_left, none, (*span))
                _ => lowered_left
            let normalized_right = match op:
                BinaryOp::Shl => cast_if_needed(lowered_right, Option::Some(named_int_type((*span))), (*span))
                BinaryOp::Shr => cast_if_needed(lowered_right, Option::Some(named_int_type((*span))), (*span))
                _ => lowered_right
            Expr::Binary { left: Box__new_(normalized_left), op: (*op), right: Box__new_(normalized_right), span: (*span) }
        Expr::Unary { op: op, operand: operand, span: span } =>
            let operand_ty = infer_expr_type(operand, ctx)
            let lowered_operand = lower_expr_memory_with_ctx(operand, ctx)
            let normalized_operand = match op:
                UnaryOp::Neg => cast_if_needed(lowered_operand, none, (*span))
                UnaryOp::BitNot => cast_if_needed(lowered_operand, none, (*span))
                _ => lowered_operand
            Expr::Unary { op: (*op), operand: Box__new_(normalized_operand), span: (*span) }
        Expr::Call { callee: callee, args: args, span: span } => Expr::Call { callee: Box__new_(lower_expr_memory_with_ctx(callee, ctx)), args: args.iter().map(fn(arg): CallArg { value: lower_expr_memory_with_ctx(&arg.value, ctx), ..arg.clone() }).collect(), span: (*span) }
        Expr::StageCall { runtime: runtime, function: function, args: args, span: span } => Expr::StageCall { runtime: (*runtime), function: function.clone(), args: args.iter().map(fn(arg): CallArg { value: lower_expr_memory_with_ctx(&arg.value, ctx), ..arg.clone() }).collect(), span: (*span) }
        Expr::MethodCall { receiver: receiver, method: method, args: args, span: span } => Expr::MethodCall { receiver: Box__new_(lower_expr_memory_with_ctx(receiver, ctx)), method: method.clone(), args: args.iter().map(fn(arg): CallArg { value: lower_expr_memory_with_ctx(&arg.value, ctx), ..arg.clone() }).collect(), span: (*span) }
        Expr::Field { object: object, field: field, span: span } =>
            match field_layout_from_object(object, field, ctx):
                Some(field_layout) =>
                    let field_offset = field_layout.offset
                    let field_bit_width = field_layout.bit_width
                    let field_bit_offset = field_layout.bit_offset.unwrap_or(0)
                    let field_bit_signed = field_layout.bit_signed
                    match field_bit_width:
                        Some(bit_width) =>
                            let promoted_bits = low_level_abi__promoted_integer_bits(bit_width, field_bit_signed, (*ctx).layouts.abi)
                            return helper_call("__kain_bitfield_get", [lower_expr_memory_with_ctx(object, ctx), Expr::String(field.clone(), (*span)), Expr::Int(field_offset as i64, (*span)), Expr::Int(field_bit_offset as i64, (*span)), Expr::Int(bit_width as i64, (*span)), Expr::Bool(field_bit_signed, (*span)), Expr::Int(promoted_bits as i64, (*span))], (*span))
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            match struct_layout_from_object(object, ctx).filter(fn(layout): layout.is_union).map(fn(layout): layout.size):
                Some(layout_size) =>
                    let field_ty = infer_expr_type(object, ctx).and_then(fn(object_ty): field_type_from_object(&object_ty, field, ctx))
                    let fallback = infer_expr_type(object, ctx).and_then(fn(object_ty): field_type_from_object(&object_ty, field, ctx)).map(fn(ty): lower_storage_expr(&ty, (*ctx).layouts, (*span), true)).unwrap_or_else(fn(): Expr::None((*span)))
                    let (field_type_name, field_stride) = match &field_ty:
                        Some(ty) => (type_key(ty), memory_stride_for_type(Option::Some(ty), (*ctx).layouts).unwrap_or(1))
                        None => (("unknown").to_string(), 1)
                    return helper_call("__kain_union_get", [lower_expr_memory_with_ctx(object, ctx), Expr::String(field.clone(), (*span)), Expr::String(field_type_name, (*span)), Expr::Int(field_stride, (*span)), Expr::Int(layout_size as i64, (*span)), fallback], (*span))
                _ =>
                    ()
                    ()
            Expr::Field { object: Box__new_(lower_expr_memory_with_ctx(object, ctx)), field: field.clone(), span: (*span) }
        Expr::Index { object: object, index: index, span: span } => Expr::Index { object: Box__new_(lower_expr_memory_with_ctx(object, ctx)), index: Box__new_(lower_expr_memory_with_ctx(index, ctx)), span: (*span) }
        Expr::Array(items, items_span) => Expr::Array(items.iter().map(fn(item): lower_expr_memory_with_ctx(item, ctx)).collect(), (*items_span))
        Expr::Tuple(items, items_span) => Expr::Tuple(items.iter().map(fn(item): lower_expr_memory_with_ctx(item, ctx)).collect(), (*items_span))
        Expr::Struct { name: name, fields: fields, rest: rest, span: span } =>
            let mut lowered_fields: Array<(String, Expr)> = Vec__new_()
            for selfhost_for_item in fields.iter():
                let (field, value) = selfhost_for_item
                lowered_fields.push((field.clone(), lower_expr_memory_with_ctx(value, ctx)))
                ()
            ()
            Expr::Struct { name: name.clone(), fields: lowered_fields, rest: rest.map(fn(value): Box__new_(lower_expr_memory_with_ctx(value, ctx))), span: (*span) }
        Expr::EnumVariant { enum_name: enum_name, variant: variant, fields: fields, span: span } =>
            let lowered_fields = match fields:
                EnumVariantFields::Unit => EnumVariantFields__Unit
                EnumVariantFields::Tuple(items) =>
                    let mut lowered_items: Array<Expr> = Vec__new_()
                    for item in items.iter():
                        lowered_items.push(lower_expr_memory_with_ctx(item, ctx))
                        ()
                    ()
                    EnumVariantFields::Tuple(lowered_items)
                EnumVariantFields::Struct(items) =>
                    let mut lowered_items: Array<(String, Expr)> = Vec__new_()
                    for selfhost_for_item in items.iter():
                        let (field, value) = selfhost_for_item
                        lowered_items.push((field.clone(), lower_expr_memory_with_ctx(value, ctx)))
                        ()
                    ()
                    EnumVariantFields::Struct(lowered_items)
            Expr::EnumVariant { enum_name: enum_name.clone(), variant: variant.clone(), fields: lowered_fields, span: (*span) }
        Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch, span: span } => Expr::If { condition: Box__new_(lower_expr_memory_with_ctx(condition, ctx)), then_branch: lower_block_memory_with_ctx(then_branch, ctx), else_branch: else_branch.map(fn(branch): Box__new_(lower_else_branch_memory_with_ctx(branch, ctx))), span: (*span) }
        Expr::Match { scrutinee: scrutinee, arms: arms, span: span } => Expr::Match { scrutinee: Box__new_(lower_expr_memory_with_ctx(scrutinee, ctx)), arms: arms.iter().map(fn(arm): MatchArm { body: lower_expr_memory_with_ctx(&arm.body, ctx), ..arm.clone() }).collect(), span: (*span) }
        Expr::Lambda { params: params, return_type: return_type, body: body, span: span } => Expr::Lambda { params: params.iter().map(fn(param): Param { ty: lower_type_memory(&param.ty), ..param.clone() }).collect(), return_type: none, body: Box__new_(lower_expr_memory_with_ctx(body, ctx)), span: (*span) }
        Expr::Cast { value: value, target: target, span: span } => Expr::Cast { value: Box__new_(lower_expr_memory_with_ctx(value, ctx)), target: lower_type_memory(target), span: (*span) }
        Expr::Try(inner, inner_span) => Expr::Try(Box__new_(lower_expr_memory_with_ctx(inner, ctx)), (*inner_span))
        Expr::Await(inner, inner_span) => Expr::Await(Box__new_(lower_expr_memory_with_ctx(inner, ctx)), (*inner_span))
        Expr::AsyncBlock(inner, inner_span) => Expr::AsyncBlock(Box__new_(lower_expr_memory_with_ctx(inner, ctx)), (*inner_span))
        Expr::Block(block, block_span) => Expr::Block(lower_block_memory_with_ctx(block, ctx), (*block_span))
        Expr::Paren(inner, inner_span) => Expr::Paren(Box__new_(lower_expr_memory_with_ctx(inner, ctx)), (*inner_span))
        Expr::Return(Some(inner), inner_span) => Expr::Return(Option::Some(Box__new_(lower_expr_memory_with_ctx(inner, ctx))), (*inner_span))
        Expr::Break(Some(inner), inner_span) => Expr::Break(Option::Some(Box__new_(lower_expr_memory_with_ctx(inner, ctx))), (*inner_span))
        Expr::Spawn { actor_: actor_, init: init, span: span } =>
            let mut lowered_init: Array<(String, Expr)> = Vec__new_()
            for selfhost_for_item in init.iter():
                let (name, value) = selfhost_for_item
                lowered_init.push((name.clone(), lower_expr_memory_with_ctx(value, ctx)))
                ()
            ()
            Expr::Spawn { actor_: actor_.clone(), init: lowered_init, span: (*span) }
        Expr::SendMsg { target: target, message: message, data: data, span: span } =>
            let mut lowered_data: Array<(String, Expr)> = Vec__new_()
            for selfhost_for_item in data.iter():
                let (name, value) = selfhost_for_item
                lowered_data.push((name.clone(), lower_expr_memory_with_ctx(value, ctx)))
                ()
            ()
            Expr::SendMsg { target: Box__new_(lower_expr_memory_with_ctx(target, ctx)), message: message.clone(), data: lowered_data, span: (*span) }
        Expr::Comptime(inner, inner_span) => Expr::Comptime(Box__new_(lower_expr_memory_with_ctx(inner, ctx)), (*inner_span))
        Expr::MacroCall { name: name, args: args, span: span } => Expr::MacroCall { name: name.clone(), args: args.iter().map(fn(arg): lower_expr_memory_with_ctx(arg, ctx)).collect(), span: (*span) }
        Expr::Range { start: start, end: end, inclusive: inclusive, span: span } => Expr::Range { start: start.map(fn(expr): Box__new_(lower_expr_memory_with_ctx(expr, ctx))), end: end.map(fn(expr): Box__new_(lower_expr_memory_with_ctx(expr, ctx))), inclusive: (*inclusive), span: (*span) }
        Expr::FString(items, items_span) => Expr::FString(items.iter().map(fn(item): lower_expr_memory_with_ctx(item, ctx)).collect(), (*items_span))
        _ => expr.clone()

fn lower_else_branch_memory_with_ctx(branch: &ElseBranch, ctx: &mut FunctionMemoryCtx<_>) -> ElseBranch:
    match branch:
        ElseBranch::Else(block) => ElseBranch::Else(lower_block_memory_with_ctx(block, ctx))
        ElseBranch::ElseIf(condition, block, next) => ElseBranch::ElseIf(Box__new_(lower_expr_memory_with_ctx(condition, ctx)), lower_block_memory_with_ctx(block, ctx), next.map(fn(branch): Box__new_(lower_else_branch_memory_with_ctx(branch, ctx))))

fn should_load_from_pointer(name: String, ctx: &FunctionMemoryCtx<_>) -> Bool:
    ((*ctx).address_taken.contains(name) && (*ctx).local_types.contains_key(name))

fn load_from_pointer_binding(name: String, ty: Option<&Type>, span: Span) -> Expr:
    let call = helper_call("__kain_mem_load", [Expr::Ident(pointer_binding_name(name), span)], span)
    match ty:
        Some(ty) => Expr::Cast { value: Box__new_(call), target: lower_type_memory(ty), span: span }
        _ => call

fn pointer_binding_name(name: String) -> String:
    f"__kain_ptr_{name}"

fn make_pointer_binding_stmt(name: String, span: Span) -> Stmt:
    Stmt::Let { pattern: Pattern::Binding { name: pointer_binding_name(name), mutable_: true, span: span }, ty: Option::Some(Type::Named { name: ("Int").to_string(), generics: [], span: span }), value: Option::Some(helper_call("__kain_bind_local", [Expr::Ident(name.to_string(), span)], span)), span: span }

fn lower_addr_of_memory(value: &Expr, pointee_ty: Option<&Type>, ctx: &mut FunctionMemoryCtx<_>, span: Span) -> Expr:
    match pointer_for_addressable(value, ctx):
        Some(ptr) => ptr
        _ =>
            let mut args = [lower_expr_memory_with_ctx(value, ctx)]
            match pointee_ty:
                Some(ty) =>
                    args.push(Expr::String(type_key(ty), span))
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            helper_call("__kain_addr_of", args, span)

fn pointer_for_addressable(value: &Expr, ctx: &mut FunctionMemoryCtx<_>) -> Option<Expr>:
    match value:
        Expr::Ident(name, span) if should_load_from_pointer(name, ctx) => Option::Some(Expr::Ident(pointer_binding_name(name), (*span)))
        Expr::Field { object: object, field: field, span: span } =>
            let base_ptr = pointer_for_addressable(object, ctx)?
            match field_layout_from_object(object, field, ctx):
                Some(layout) =>
                    match layout.bit_width:
                        Some(bit_width) =>
                            let bit_offset = layout.bit_offset.unwrap_or(0)
                            let bit_width_2 = bit_width
                            return none
                        _ =>
                            ()
                            ()
                    ()
                _ =>
                    ()
                    ()
            let offset = infer_field_offset(object, field, ctx).unwrap_or(0)
            Option::Some(helper_call("__kain_field_ptr", [base_ptr, Expr::String(field.clone(), (*span)), Expr::Int(offset as i64, (*span))], (*span)))
        Expr::Index { object: object, index: index, span: span } =>
            let base_ptr = pointer_for_addressable(object, ctx)?
            let element_ty = infer_element_type(object, ctx)
            let stride = match &element_ty:
                Some(ty) => memory_stride_for_type(Option::Some(ty), (*ctx).layouts).unwrap_or(1)
                None => 1
            Option::Some(helper_call("__kain_index_ptr", [base_ptr, lower_expr_memory_with_ctx(index, ctx), Expr::Int(stride, (*span))], (*span)))
        _ => none

fn collect_local_types_from_block(block: &Block) -> Map<String, Type>:
    let mut locals = HashMap__new_()
    collect_local_types_from_block_into(block, &mut locals)
    ()
    locals

fn collect_local_types_from_block_into(block: &Block, locals: &mut Map<String, Type>):
    for stmt in &(*block).stmts:
        match stmt:
            Stmt::Let { pattern: Pattern::Binding { name: name }, ty: Some(ty) } =>
                locals.insert(name.clone(), ty.clone())
                ()
            Stmt::For { body: body } => collect_local_types_from_block_into(body, locals)
            Stmt::While { body: body } => collect_local_types_from_block_into(body, locals)
            Stmt::Loop { body: body } => collect_local_types_from_block_into(body, locals)
            Stmt::Expr(Expr::Block(block, _)) => collect_local_types_from_block_into(block, locals)
            _ => ()

fn collect_address_taken_roots(block: &Block) -> Set<String>:
    let mut roots = HashSet__new_()
    collect_address_taken_from_block(block, &mut roots)
    ()
    roots

fn collect_address_taken_from_block(block: &Block, roots: &mut Set<String>):
    for stmt in &(*block).stmts:
        match stmt:
            Stmt::Expr(expr) => collect_address_taken_from_expr(expr, roots)
            Stmt::Return(Some(expr), _) => collect_address_taken_from_expr(expr, roots)
            Stmt::Break(Some(expr), _) => collect_address_taken_from_expr(expr, roots)
            Stmt::Let { value: Some(expr) } => collect_address_taken_from_expr(expr, roots)
            Stmt::For { iter: iter, body: body } =>
                collect_address_taken_from_expr(iter, roots)
                ()
                collect_address_taken_from_block(body, roots)
                ()
            Stmt::While { condition: condition, body: body } =>
                collect_address_taken_from_expr(condition, roots)
                ()
                collect_address_taken_from_block(body, roots)
                ()
            Stmt::Loop { body: body } => collect_address_taken_from_block(body, roots)
            _ => ()

fn collect_address_taken_from_expr(expr: &Expr, roots: &mut Set<String>):
    match expr:
        Expr::AddrOf { value: value } =>
            match root_ident_of_addressable(value):
                Some(root) =>
                    roots.insert(root)
                    ()
                    ()
                    ()
                    ()
                _ =>
                    ()
                    ()
            collect_address_taken_from_expr(value, roots)
            ()
        Expr::Binary { left: left, right: right } =>
            collect_address_taken_from_expr(left, roots)
            ()
            collect_address_taken_from_expr(right, roots)
            ()
        Expr::Unary { operand: operand } => collect_address_taken_from_expr(operand, roots)
        Expr::Call { callee: callee, args: args } =>
            collect_address_taken_from_expr(callee, roots)
            ()
            for arg in args:
                collect_address_taken_from_expr(&arg.value, roots)
                ()
        Expr::MethodCall { receiver: receiver, args: args } =>
            collect_address_taken_from_expr(receiver, roots)
            ()
            for arg in args:
                collect_address_taken_from_expr(&arg.value, roots)
                ()
        Expr::Field { object: object } => collect_address_taken_from_expr(object, roots)
        Expr::Index { object: object, index: index } =>
            collect_address_taken_from_expr(object, roots)
            ()
            collect_address_taken_from_expr(index, roots)
            ()
        Expr::Assign { target: target, value: value } =>
            collect_address_taken_from_expr(target, roots)
            ()
            collect_address_taken_from_expr(value, roots)
            ()
        Expr::Block(block, _) => collect_address_taken_from_block(block, roots)
        Expr::Paren(inner, _) => collect_address_taken_from_expr(inner, roots)
        Expr::Try(inner, _) => collect_address_taken_from_expr(inner, roots)
        Expr::Await(inner, _) => collect_address_taken_from_expr(inner, roots)
        Expr::AsyncBlock(inner, _) => collect_address_taken_from_expr(inner, roots)
        Expr::Comptime(inner, _) => collect_address_taken_from_expr(inner, roots)
        _ => ()

fn root_ident_of_addressable(expr: &Expr) -> Option<String>:
    match expr:
        Expr::Ident(name, _) => Option::Some(name.clone())
        Expr::Field { object: object } => root_ident_of_addressable(object)
        Expr::Index { object: object } => root_ident_of_addressable(object)
        _ => none

fn infer_expr_type(expr: &Expr, ctx: &FunctionMemoryCtx<_>) -> Option<Type>:
    match expr:
        Expr::Int(_, span) => Some(Type::Named { name: "Int".to_string(), generics: Vec__new_(), span: span.clone() })
        Expr::Float(_, span) => Some(Type::Named { name: "Float".to_string(), generics: Vec__new_(), span: span.clone() })
        Expr::Bool(_, span) => Some(Type::Named { name: "Bool".to_string(), generics: Vec__new_(), span: span.clone() })
        Expr::Ident(name, _) => ctx.local_types.get(name).cloned()
        Expr::Field { object: object, field: field } =>
            let object_ty = infer_expr_type(object, ctx)?
            field_type_from_object(&object_ty, field, ctx)
        Expr::Index { object: object } => infer_element_type(object, ctx)
        Expr::Cast { target: target } => Some(target.clone())
        _ => none

fn infer_element_type(expr: &Expr, ctx: &FunctionMemoryCtx<_>) -> Option<Type>:
    match (infer_expr_type(expr, ctx)?):
        Type::Array(inner, _, _) => Option::Some((*inner))
        Type::Slice(inner, _) => Option::Some((*inner))
        Type::Ref { inner: inner } => Option::Some((*inner))
        Type::Ptr { inner: inner } => Option::Some((*inner))
        Type::Option(inner, _) => Option::Some((*inner))
        other => Option::Some(other)

fn field_type_from_object(object_ty: &Type, field: String, ctx: &FunctionMemoryCtx<_>) -> Option<Type>:
    match object_ty:
        Type::Named { name: name } => (*ctx).layouts.field(name, field).map(fn(field): field.ty.clone())
        Type::Ref { inner: inner } => field_type_from_object(inner, field, ctx)
        Type::Ptr { inner: inner } => field_type_from_object(inner, field, ctx)
        _ => none

fn field_layout_from_object_ty<a>(object_ty: &Type, field: String, ctx: &a FunctionMemoryCtx<_>) -> Option<&a LayoutField>:
    match object_ty:
        Type::Named { name: name } => (*ctx).layouts.field(name, field)
        Type::Ref { inner: inner } => field_layout_from_object_ty(inner, field, ctx)
        Type::Ptr { inner: inner } => field_layout_from_object_ty(inner, field, ctx)
        _ => none

fn field_layout_from_object<a>(object: &Expr, field: String, ctx: &a FunctionMemoryCtx<_>) -> Option<&a LayoutField>:
    let object_ty = infer_expr_type(object, ctx)?
    field_layout_from_object_ty(&object_ty, field, ctx)

fn struct_layout_from_type<a>(ty: &Type, ctx: &a FunctionMemoryCtx<_>) -> Option<&a StructLayoutInfo>:
    match ty:
        Type::Named { name: name } => (*ctx).layouts.structs.get(name)
        Type::Ref { inner: inner } => struct_layout_from_type(inner, ctx)
        Type::Ptr { inner: inner } => struct_layout_from_type(inner, ctx)
        _ => none

fn struct_layout_from_object<a>(object: &Expr, ctx: &a FunctionMemoryCtx<_>) -> Option<&a StructLayoutInfo>:
    let object_ty = infer_expr_type(object, ctx)?
    struct_layout_from_type(&object_ty, ctx)

fn infer_field_offset(object: &Expr, field: String, ctx: &FunctionMemoryCtx<_>) -> Option<usize>:
    field_layout_from_object(object, field, ctx).map(fn(field): field.offset)

fn type_key(ty: &Type) -> String:
    match ty:
        Type::Named { name: name, generics: generics } if generics.is_empty() => name.clone()
        Type::Named { name: name, generics: generics } => "{name}<{join_type_key_list(generics, \",\")}>"
        Type::Array(inner, size, _) => f"[{type_key(inner)};{size}]"
        Type::Slice(inner, _) => f"[{type_key(inner)}]"
        Type::Ref { inner: inner } => f"&{type_key(inner)}"
        Type::Ptr { inner: inner } => f"ptr<{type_key(inner)}>"
        Type::Tuple(types, _) => "({join_type_key_list(types, \",\")})"
        Type::Unit(_) => ("()").to_string()
        Type::Never(_) => ("!").to_string()
        _ => ("unknown").to_string()

fn join_type_key_list(types: &[Type], separator: String) -> String:
    let mut out_ = String__new_()
    let mut first = true
    for ty in types:
        if (!first):
            out_.push_str(separator)
            ()
            ()
            ()
            ()
        first = false
        ()
        out_.push_str(&type_key(ty))
        ()
    ()
    out_

fn cast_if_needed(expr: Expr, target: Option<Type>, span: Span) -> Expr:
    let Some(target) = target
    Expr::Cast { value: Box__new_(expr), target: target, span: span }

fn named_int_type(span: Span) -> Type:
    Type::Named { name: ("Int").to_string(), generics: Vec__new_(), span: span }

fn lower_type_memory(ty: &Type) -> Type:
    match ty:
        Type::Ptr { span: span } => Type::Named { name: "Int".to_string(), generics: [], span: span.clone() }
        Type::Array(inner, size, span) => Type__Array(Box__new_(lower_type_memory(inner)), (*size), span.clone())
        Type::Slice(inner, span) => Type__Slice(Box__new_(lower_type_memory(inner)), span.clone())
        Type::Tuple(types, span) => Type__Tuple(types.iter().map(lower_type_memory).collect(), span.clone())
        Type::Ref { mutable_: mutable_, inner: inner, lifetime: lifetime, span: span } => Type::Ref { mutable_: (*mutable_), inner: Box__new_(lower_type_memory(inner)), lifetime: lifetime.clone(), span: span.clone() }
        Type::Function { params: params, return_type: return_type, effects: effects, span: span } => Type::Function { params: params.iter().map(lower_type_memory).collect(), return_type: Box__new_(lower_type_memory(return_type)), effects: effects.clone(), span: span.clone() }
        Type::Option(inner, span) => Type__Option(Box__new_(lower_type_memory(inner)), span.clone())
        Type::Result(ok, err, span) => Type__Result(Box__new_(lower_type_memory(ok)), Box__new_(lower_type_memory(err)), span.clone())
        Type::Named { name: name, generics: generics, span: span } => Type::Named { name: name.clone(), generics: generics.iter().map(lower_type_memory).collect(), span: span.clone() }
        Type::Impl { trait_name: trait_name, generics: generics, span: span } => Type::Impl { trait_name: trait_name.clone(), generics: generics.iter().map(lower_type_memory).collect(), span: span.clone() }
        _ => ty.clone()

fn lower_resolved_type_memory(ty: &ResolvedType) -> ResolvedType:
    match ty:
        ResolvedType::Ptr {  } => ResolvedType::Int(IntSize__I64)
        ResolvedType::Array(inner, size) => ResolvedType::Array(Box__new_(lower_resolved_type_memory(inner)), (*size))
        ResolvedType::Slice(inner) => ResolvedType::Slice(Box__new_(lower_resolved_type_memory(inner)))
        ResolvedType::Tuple(types) => ResolvedType::Tuple(types.iter().map(lower_resolved_type_memory).collect())
        ResolvedType::Option(inner) => ResolvedType::Option(Box__new_(lower_resolved_type_memory(inner)))
        ResolvedType::Result(ok, err) => ResolvedType::Result(Box__new_(lower_resolved_type_memory(ok)), Box__new_(lower_resolved_type_memory(err)))
        ResolvedType::Ref { mutable_: mutable_, inner: inner } => ResolvedType::Ref { mutable_: (*mutable_), inner: Box__new_(lower_resolved_type_memory(inner)) }
        ResolvedType::Function { params: params, ret: ret, effects: effects } => ResolvedType::Function { params: params.iter().map(lower_resolved_type_memory).collect(), ret: Box__new_(lower_resolved_type_memory(ret)), effects: effects.clone() }
        ResolvedType::Struct(name, fields) => ResolvedType::Struct(name.clone(), fields.iter().map(fn(__kain_closure_arg5): (__kain_closure_arg5.__kain_tuple_0.clone(), lower_resolved_type_memory(__kain_closure_arg5.__kain_tuple_1))).collect())
        ResolvedType::Enum(name, variants) => ResolvedType::Enum(name.clone(), lower_resolved_enum_variants(variants))
        _ => ty.clone()

fn lower_resolved_enum_variants(variants: &[(String, ResolvedType)]) -> Array<(String, ResolvedType)>:
    let mut lowered_variants = Vec__new_()
    for selfhost_for_item in variants:
        let (variant, ty) = selfhost_for_item
        lowered_variants.push((variant.clone(), lower_resolved_type_memory(ty)))
        ()
    ()
    lowered_variants

fn helper_call(name: String, args: Array<Expr>, span: Span) -> Expr:
    Expr::Call { callee: Box__new_(Expr::Ident(name.to_string(), span)), args: args.into_iter().map(fn(value): CallArg { name: none, value: value, span: span }).collect(), span: span }

fn memory_stride_for_type(ty: Option<&Type>, layouts: &LayoutRegistry) -> Option<i64>:
    ty.map(fn(ty): estimate_type_size(ty, layouts) as i64)

fn estimate_type_size(ty: &Type, layouts: &LayoutRegistry) -> usize:
    match ty:
        Type::Named { name: name } =>
            match name.as_str():
                "Bool" => 1
                "Char" => 1
                "Int" => 8
                "isize" => 8
                "usize" => 8
                "Float" => 8
                _ => layouts.type_size_fallback(ty)
        Type::Array(inner, size, _) => (estimate_type_size(inner, layouts) * (*size))
        Type::Slice(_, _) => 16
        Type::Tuple(types, _) => types.iter().map(fn(ty): estimate_type_size(ty, layouts)).sum()
        Type::Ref {  } => 8
        Type::Ptr {  } => 8
        Type::Option(inner, _) => estimate_type_size(inner, layouts)
        Type::Result(ok, err, _) => estimate_type_size(ok, layouts).max(estimate_type_size(err, layouts))
        Type::Unit(_) => 0
        Type::Never(_) => 0
        _ => 8

fn estimate_type_align(ty: &Type, layouts: &LayoutRegistry) -> usize:
    match ty:
        Type::Named { name: name } =>
            match (*layouts).structs.get(name):
                Some(info) => info.align.max(1)
                None => layouts.type_align_fallback(ty)
        Type::Array(inner, _, _) => estimate_type_align(inner, layouts)
        Type::Tuple(types, _) => types.iter().map(fn(ty): estimate_type_align(ty, layouts)).max().unwrap_or(1)
        Type::Option(inner, _) => estimate_type_align(inner, layouts)
        Type::Result(ok, err, _) => estimate_type_align(ok, layouts).max(estimate_type_align(err, layouts))
        _ => layouts.type_align_fallback(ty)

fn lower_storage_expr(ty: &Type, layouts: &LayoutRegistry, span: Span, zeroed: Bool) -> Expr:
    match ty:
        Type::Array(inner, count, _) => Expr::Array(lower_storage_array_items(inner, layouts, span, zeroed, (*count)), span)
        Type::Tuple(items, _) => Expr::Tuple(items.iter().map(fn(item): lower_storage_expr(item, layouts, span, zeroed)).collect(), span)
        Type::Named { name: name } =>
            match name.as_str():
                "Int" => if zeroed: Expr::Int(0, span) else: Expr::None(span)
                "UInt" => if zeroed: Expr::Int(0, span) else: Expr::None(span)
                "isize" => if zeroed: Expr::Int(0, span) else: Expr::None(span)
                "usize" => if zeroed: Expr::Int(0, span) else: Expr::None(span)
                "Float" => if zeroed: Expr::Float(0, span) else: Expr::None(span)
                "Bool" => if zeroed: Expr::Bool(false, span) else: Expr::None(span)
                "Char" => if zeroed: Expr::String(("\0").to_string(), span) else: Expr::None(span)
                _ =>
                    match (*layouts).structs.get(name):
                        Some(info) =>
                            let mut fields = Vec__new_()
                            for field_name in info.field_order.iter():
                                match info.fields.get(field_name):
                                    Some(field) =>
                                        fields.push((field_name.clone(), lower_storage_expr(&field.ty, layouts, span, zeroed)))
                                        ()
                                    _ => ()
                            ()
                            Expr::Struct { name: name.clone(), fields: fields, rest: none, span: span }
                        None => Expr::None(span)
        Type::Unit(_) => Expr::Tuple(Vec__new_(), span)
        Type::Ref {  } => Expr::None(span)
        Type::Ptr {  } => Expr::None(span)
        _ => Expr::None(span)

fn lower_storage_array_items(inner: &Type, layouts: &LayoutRegistry, span: Span, zeroed: Bool, count: usize) -> Array<Expr>:
    let mut items = Vec__new_()
    let mut remaining = count
    while (remaining > 0):
        items.push(lower_storage_expr(inner, layouts, span, zeroed))
        ()
        remaining = (remaining - 1)
        ()
    ()
    items

fn storage_seed_expr(ty: Option<&Type>, layouts: &LayoutRegistry, span: Span, zeroed: Bool) -> Expr:
    ty.map(fn(ty): lower_storage_expr(ty, layouts, span, zeroed)).unwrap_or_else(fn(): if zeroed: Expr::Int(0, span) else: Expr::None(span))

fn lower_heap_alloc_expr(size: &Expr, ty: Option<&Type>, zeroed: Bool, target: CompileTarget, layouts: &LayoutRegistry, span: Span) -> Expr:
    let mut args = [size.clone(), Expr::Int(memory_stride_for_type(ty, layouts).unwrap_or(1), span), Expr::Bool(zeroed, span)]
    if uses_seeded_heap_helper_abi(target):
        args.push(storage_seed_expr(ty, layouts, span, zeroed))
        ()
        ()
        ()
        ()
    helper_call("__kain_alloc", args, span)

fn lower_heap_realloc_expr(pointer: &Expr, size: &Expr, ty: Option<&Type>, zeroed_new: Bool, target: CompileTarget, layouts: &LayoutRegistry, span: Span) -> Expr:
    let mut args = [pointer.clone(), size.clone(), Expr::Int(memory_stride_for_type(ty, layouts).unwrap_or(1), span), Expr::Bool(zeroed_new, span)]
    if uses_seeded_heap_helper_abi(target):
        args[3] = storage_seed_expr(ty, layouts, span, zeroed_new)
        ()
        ()
        ()
        ()
    helper_call("__kain_realloc", args, span)

fn uses_seeded_heap_helper_abi(target: CompileTarget) -> Bool:
    match target:
        CompileTarget::Ts => true
        CompileTarget::Js => true
        CompileTarget::Wasm => true
        CompileTarget::Hybrid => true
        _ => false

fn lower_aggregate_init_expr(ty: &Type, fields: &[(String, Expr)], zero_fill_rest: Bool, layouts: &LayoutRegistry, span: Span) -> Expr:
    match ty:
        Type::Named { name: name } if (*layouts).structs.contains_key(name) =>
            let mut provided: Map<String, Expr> = HashMap__new_()
            for selfhost_for_item in fields.iter():
                let (field_name, value) = selfhost_for_item
                provided.insert(field_name.clone(), value.clone())
                ()
            ()
            match (*layouts).structs.get(name):
                Some(info) =>
                    if info.is_union:
                        let (field_values, active_field, active_value) = lower_union_aggregate_fields(info, fields, &provided, layouts, span, zero_fill_rest)
                        let base_struct = Expr::Struct { name: name.clone(), fields: field_values, rest: none, span: span }
                        match active_field:
                            Some(active_field) =>
                                let active_ty = match info.fields.get(&active_field):
                                    Some(field) => Option::Some(field.ty.clone())
                                    None => none
                                let (active_type_name, active_stride) = match active_ty:
                                    Some(ty) => (type_key(&ty), memory_stride_for_type(Option::Some(&ty), layouts).unwrap_or(1))
                                    None => (("unknown").to_string(), 1)
                                helper_call("__kain_union_wrap", [base_struct, Expr::String(active_field, span), Expr::String(active_type_name, span), Expr::Int(active_stride, span), Expr::Int(info.size as i64, span), active_value], span)
                            _ => base_struct
                    else:
                        let mut field_values = Vec__new_()
                        for field_name in info.field_order.iter():
                            match info.fields.get(field_name):
                                Some(field) =>
                                    let value = match provided.get(field_name).cloned():
                                        Some(value) => value
                                        None => if zero_fill_rest: lower_storage_expr(&field.ty, layouts, span, true) else: Expr::None(span)
                                    field_values.push((field_name.clone(), value))
                                    ()
                                _ => ()
                        ()
                        Expr::Struct { name: name.clone(), fields: field_values, rest: none, span: span }
                None =>
                    let mut copied_fields = Vec__new_()
                    for selfhost_for_item in fields.iter():
                        let (field_name, value) = selfhost_for_item
                        copied_fields.push((field_name.clone(), value.clone()))
                        ()
                    ()
                    Expr::Struct { name: name.clone(), fields: copied_fields, rest: none, span: span }
        _ =>
            let mut tuple_values = Vec__new_()
            for selfhost_for_item in fields.iter():
                let (_, value) = selfhost_for_item
                tuple_values.push(value.clone())
                ()
            ()
            Expr::Tuple(tuple_values, span)

fn lower_union_aggregate_fields(info: &StructLayoutInfo, original_fields: &[(String, Expr)], provided: &Map<String, Expr>, layouts: &LayoutRegistry, span: Span, zero_fill_rest: Bool) -> (Array<(String, Expr)>, Option<String>, Expr):
    let mut active_name: Option<String> = none
    let mut index = original_fields.len()
    while (index > 0):
        index = (index - 1)
        ()
        let (field_name, _) = &original_fields[index]
        if (*info).fields.contains_key(field_name):
            active_name = Option::Some(field_name.clone())
            ()
            break
    ()
    if active_name.is_none():
        active_name = (*info).field_order.first().cloned()
        ()
        ()
        ()
        ()
    let Some(active_name) = active_name
    let active_value = match (*info).fields.get(&active_name):
        Some(field) =>
            match provided.get(&active_name).cloned():
                Some(value) => value
                None => if zero_fill_rest: lower_storage_expr(&field.ty, layouts, span, true) else: Expr::None(span)
        None => Expr::None(span)
    let mut field_values = Vec__new_()
    for field_name in (*info).field_order.iter():
        match (*info).fields.get(field_name):
            Some(field) =>
                let value = if (field_name == &active_name):
                    match provided.get(field_name).cloned():
                        Some(value) => value
                        None => if zero_fill_rest: lower_storage_expr(&field.ty, layouts, span, true) else: Expr::None(span)
                elif zero_fill_rest:
                    lower_storage_expr(&field.ty, layouts, span, true)
                else:
                    Expr::None(span)
                field_values.push((field_name.clone(), value))
                ()
            _ => ()
    ()
    (field_values, Option::Some(active_name), active_value)

fn first_unsupported_memory_context(items: &[TypedItem], caps: BackendMemoryCapabilities) -> Option<String>:
    for item in items:
        match item:
            TypedItem::Function(f) =>
                match first_unsupported_memory_context_in_function(f, caps):
                    Some(context) => return Option::Some(context)
                    _ => ()
            TypedItem::Struct(s) =>
                if (!caps.raw_pointers):
                    for field in &s.ast.fields:
                        if field.ty.contains_raw_ptr():
                            return Option::Some(f"Struct '{s.ast.name}' field '{field.name}' uses a raw pointer type")
            TypedItem::Component(c) =>
                if (!caps.raw_pointers):
                    for prop in &c.ast.props:
                        if prop.ty.contains_raw_ptr():
                            return Option::Some(f"Component '{c.ast.name}' prop '{prop.name}' uses a raw pointer type")
            TypedItem::Actor(a) =>
                if (!caps.raw_pointers):
                    for state_ in &a.ast.state_:
                        if state_.ty.contains_raw_ptr():
                            return Option::Some(f"Actor '{a.ast.name}' state '{state_.name}' uses a raw pointer type")
            TypedItem::Const(c) =>
                if ((!caps.raw_pointers) && c.ast.ty.contains_raw_ptr()):
                    return Option::Some(f"Const '{c.ast.name}' uses a raw pointer type")
                if (!caps.raw_memory_ops):
                    match first_memory_expr_context(&c.ast.value, f"Const '{c.ast.name}' contains a raw memory operation"):
                        Some(context) => return Option::Some(context)
                        _ => ()
            TypedItem::TypeAlias(alias) =>
                if ((!caps.raw_pointers) && alias.ast.target.contains_raw_ptr()):
                    return Option::Some(f"Type alias '{alias.ast.name}' uses a raw pointer type")
            TypedItem::Impl(imp) =>
                for method in &imp.ast.methods:
                    match first_unsupported_memory_context_in_ast_function(method, caps):
                        Some(context) => return Option::Some(f"Impl method '{method.name}': {context}")
                        _ => ()
            TypedItem::Mod(module) =>
                match first_unsupported_memory_context(&module.items, caps):
                    Some(context) => return Option::Some(context)
                    _ => ()
            _ => ()
    ()
    none

fn first_unsupported_memory_context_in_function(function: &types::TypedFunction, caps: BackendMemoryCapabilities) -> Option<String>:
    if (!caps.raw_pointers):
        for param in &(*function).ast.params:
            if param.ty.contains_raw_ptr():
                return Option::Some(f"Function '{(*function).ast.name}' parameter '{param.name}' uses a raw pointer type")
        ()
        match &(*function).ast.return_type:
            Some(ret) =>
                if ret.contains_raw_ptr():
                    return Option::Some(f"Function '{(*function).ast.name}' return type uses a raw pointer type")
                ()
            _ =>
                ()
                ()
        ()
    if (!caps.raw_memory_ops):
        match first_memory_block_context(&(*function).ast.body, f"Function '{(*function).ast.name}'"):
            Some(context) => return Option::Some(context)
            _ =>
                ()
                ()
        ()
    none

fn first_unsupported_memory_context_in_ast_function(function: &ast::Function, caps: BackendMemoryCapabilities) -> Option<String>:
    if (!caps.raw_pointers):
        for param in &(*function).params:
            if param.ty.contains_raw_ptr():
                return Option::Some(f"Function '{(*function).name}' parameter '{param.name}' uses a raw pointer type")
        ()
        match &(*function).return_type:
            Some(ret) =>
                if ret.contains_raw_ptr():
                    return Option::Some(f"Function '{(*function).name}' return type uses a raw pointer type")
                ()
            _ =>
                ()
                ()
        ()
    if (!caps.raw_memory_ops):
        match first_memory_block_context(&(*function).body, f"Function '{(*function).name}'"):
            Some(context) => return Option::Some(context)
            _ =>
                ()
                ()
        ()
    none

fn first_memory_block_context(block: &Block, owner: String) -> Option<String>:
    for stmt in &(*block).stmts:
        match first_memory_stmt_context(stmt, &owner):
            Some(context) => return Option::Some(context)
            _ => ()
    ()
    none

fn first_memory_stmt_context(stmt: &Stmt, owner: String) -> Option<String>:
    match stmt:
        Stmt::Expr(expr) => first_memory_expr_context(expr, f"{owner} contains a raw memory operation")
        Stmt::Let { value: value } =>
            match value:
                Some(value) => first_memory_expr_context(value, f"{owner} contains a raw memory operation")
                None => none
        Stmt::Return(Some(expr), _) => first_memory_expr_context(expr, f"{owner} return contains a raw memory operation")
        Stmt::For { iter: iter, body: body } =>
            match first_memory_expr_context(iter, f"{owner} loop iterator contains a raw memory operation"):
                Some(context) => Option::Some(context)
                _ => first_memory_block_context(body, owner.to_string())
        Stmt::While { condition: condition, body: body } =>
            match first_memory_expr_context(condition, f"{owner} loop condition contains a raw memory operation"):
                Some(context) => Option::Some(context)
                _ => first_memory_block_context(body, owner.to_string())
        Stmt::Loop { body: body } => first_memory_block_context(body, owner.to_string())
        Stmt::Item(_) => none
        Stmt::Return(None, _) => none
        Stmt::Break(_, _) => none
        Stmt::Continue(_) => none

fn first_memory_expr_context(expr: &Expr, base: String) -> Option<String>:
    match expr:
        Expr::AddrOf {  } => Option::Some(f"{base}: address-of expression")
        Expr::PtrOffset {  } => Option::Some(f"{base}: pointer offset expression")
        Expr::MemLoad {  } => Option::Some(f"{base}: raw memory load expression")
        Expr::MemStore {  } => Option::Some(f"{base}: raw memory store expression")
        Expr::SizeOfType {  } => none
        Expr::AlignOfType {  } => none
        Expr::Alloca {  } => none
        Expr::Uninit {  } => none
        Expr::Alloc { size: size } => first_memory_expr_context(size, base)
        Expr::Realloc { pointer: pointer, size: size } =>
            match first_memory_expr_context(pointer, base.clone()):
                Some(context) => Option::Some(context)
                _ => first_memory_expr_context(size, base)
        Expr::AggregateInit { fields: fields } => first_memory_expr_context_from_pairs(fields, base)
        Expr::Binary { left: left, right: right } =>
            match first_memory_expr_context(left, base.clone()):
                Some(context) => Option::Some(context)
                _ => first_memory_expr_context(right, base)
        Expr::Unary { operand: operand } => first_memory_expr_context(operand, base)
        Expr::Ref { value: operand } => first_memory_expr_context(operand, base)
        Expr::Deref(operand, _) => first_memory_expr_context(operand, base)
        Expr::Try(operand, _) => first_memory_expr_context(operand, base)
        Expr::Await(operand, _) => first_memory_expr_context(operand, base)
        Expr::AsyncBlock(operand, _) => first_memory_expr_context(operand, base)
        Expr::Comptime(operand, _) => first_memory_expr_context(operand, base)
        Expr::Paren(operand, _) => first_memory_expr_context(operand, base)
        Expr::Cast { value: value } => first_memory_expr_context(value, base)
        Expr::Call { callee: callee, args: args } =>
            match first_memory_expr_context(callee, base.clone()):
                Some(context) => Option::Some(context)
                _ => first_memory_expr_context_from_call_args(args, base)
        Expr::StageCall { args: args } => first_memory_expr_context_from_call_args(args, base)
        Expr::MethodCall { receiver: receiver, args: args } =>
            match first_memory_expr_context(receiver, base.clone()):
                Some(context) => Option::Some(context)
                _ => first_memory_expr_context_from_call_args(args, base)
        Expr::Field { object: object } => first_memory_expr_context(object, base)
        Expr::Index { object: object, index: index } =>
            match first_memory_expr_context(object, base.clone()):
                Some(context) => Option::Some(context)
                _ => first_memory_expr_context(index, base)
        Expr::Assign { target: target, value: value } =>
            match first_memory_expr_context(target, base.clone()):
                Some(context) => Option::Some(context)
                _ => first_memory_expr_context(value, base)
        Expr::Struct { fields: fields, rest: rest } =>
            match first_memory_expr_context_from_pairs(fields, base.clone()):
                Some(context) => Option::Some(context)
                _ =>
                    match rest:
                        Some(value) => first_memory_expr_context(value, base)
                        None => none
        Expr::EnumVariant { fields: fields } => first_memory_enum_variant_fields_context(fields, base)
        Expr::Array(items, _) => first_memory_expr_context_from_exprs(items, base)
        Expr::Tuple(items, _) => first_memory_expr_context_from_exprs(items, base)
        Expr::FString(items, _) => first_memory_expr_context_from_exprs(items, base)
        Expr::Range { start: start, end: end } =>
            match start:
                Some(expr) =>
                    match first_memory_expr_context(expr, base.clone()):
                        Some(context) => Option::Some(context)
                        _ =>
                            match end:
                                Some(expr) => first_memory_expr_context(expr, base)
                                None => none
                None =>
                    match end:
                        Some(expr) => first_memory_expr_context(expr, base)
                        None => none
        Expr::If { condition: condition, then_branch: then_branch, else_branch: else_branch } =>
            match first_memory_expr_context(condition, base.clone()):
                Some(context) => Option::Some(context)
                _ =>
                    match first_memory_block_context(then_branch, base.clone()):
                        Some(context) => Option::Some(context)
                        _ =>
                            match else_branch:
                                Some(branch) => first_memory_else_branch_context(branch, base)
                                None => none
        Expr::Match { scrutinee: scrutinee, arms: arms } =>
            match first_memory_expr_context(scrutinee, base.clone()):
                Some(context) => Option::Some(context)
                _ =>
                    for arm in arms:
                        match first_memory_expr_context(&arm.body, base.clone()):
                            Some(context) => return Option::Some(context)
                            _ => ()
                    ()
                    none
        Expr::Lambda { body: body } => first_memory_expr_context(body, base)
        Expr::Spawn { init: init } => first_memory_expr_context_from_pairs(init, base)
        Expr::SendMsg { data: init } => first_memory_expr_context_from_pairs(init, base)
        Expr::Block(block, _) => first_memory_block_context(block, base)
        Expr::MacroCall { args: args } => first_memory_expr_context_from_exprs(args, base)
        Expr::Return(Some(expr), _) => first_memory_expr_context(expr, base)
        Expr::Break(Some(expr), _) => first_memory_expr_context(expr, base)
        Expr::Int(_, _) => none
        Expr::Float(_, _) => none
        Expr::String(_, _) => none
        Expr::Bool(_, _) => none
        Expr::None(_) => none
        Expr::Ident(_, _) => none
        Expr::Return(None, _) => none
        Expr::Break(None, _) => none
        Expr::Continue(_) => none
        Expr::JSX(_, _) => none

fn first_memory_expr_context_from_pairs(items: &[(String, Expr)], base: String) -> Option<String>:
    for selfhost_for_item in items:
        let (_, value) = selfhost_for_item
        match first_memory_expr_context(value, base.clone()):
            Some(context) => return Option::Some(context)
            _ => ()
    ()
    none

fn first_memory_expr_context_from_exprs(items: &[Expr], base: String) -> Option<String>:
    for value in items:
        match first_memory_expr_context(value, base.clone()):
            Some(context) => return Option::Some(context)
            _ => ()
    ()
    none

fn first_memory_expr_context_from_call_args(args: &[ast::CallArg], base: String) -> Option<String>:
    for arg in args:
        match first_memory_expr_context(&arg.value, base.clone()):
            Some(context) => return Option::Some(context)
            _ => ()
    ()
    none

fn first_memory_else_branch_context(else_branch: &ast::ElseBranch, base: String) -> Option<String>:
    match else_branch:
        ast__ElseBranch::Else(else_block) => first_memory_block_context(else_block, base)
        ast__ElseBranch::ElseIf(cond, else_block, next_branch) =>
            match first_memory_expr_context(cond, base.clone()):
                Some(context) => Option::Some(context)
                _ =>
                    match first_memory_block_context(else_block, base.clone()):
                        Some(context) => Option::Some(context)
                        _ =>
                            match next_branch:
                                Some(next_branch) => first_memory_else_branch_context(next_branch, base)
                                None => none

fn first_memory_enum_variant_fields_context(fields: &ast::EnumVariantFields, base: String) -> Option<String>:
    match fields:
        ast__EnumVariantFields::Unit => none
        ast__EnumVariantFields::Tuple(tuple_items) => first_memory_expr_context_from_exprs(tuple_items, base)
        ast__EnumVariantFields::Struct(named_fields) => first_memory_expr_context_from_pairs(named_fields, base)

pub fn format_ptr_type(ty: &Type, mutable_: Bool) -> String:
    let inner = match ty:
        Type::Ptr { inner: inner } => inner
        _ => ty
    if mutable_:
        f"ptr_mut<{format_type(inner)}>"
    else:
        f"ptr<{format_type(inner)}>"

fn format_type(ty: &Type) -> String:
    match ty:
        Type::Named { name: name, generics: generics } => if generics.is_empty(): name.clone() else: "{name}<{join_formatted_type_list(generics, \", \")}>"
        Type::Tuple(items, _) => "({join_formatted_type_list(items, \", \")})"
        Type::Array(inner, size, _) => f"[{format_type(inner)}; {size}]"
        Type::Slice(inner, _) => f"[{format_type(inner)}]"
        Type::Ref { mutable_: mutable_, inner: inner } => if (*mutable_): f"&mut {format_type(inner)}" else: f"&{format_type(inner)}"
        Type::Ptr { mutable_: mutable_, inner: inner } => if (*mutable_): f"ptr_mut<{format_type(inner)}>" else: f"ptr<{format_type(inner)}>"
        Type::Function { params: params, return_type: return_type } => "fn({join_formatted_type_list(params, \", \")}) -> {format_type(return_type)}"
        Type::Option(inner, _) => f"{format_type(inner)}?"
        Type::Result(ok, err, _) => f"{format_type(ok)}!{format_type(err)}"
        Type::Infer(_) => ("_").to_string()
        Type::Never(_) => ("!").to_string()
        Type::Unit(_) => ("()").to_string()
        Type::Impl { trait_name: trait_name, generics: generics } => if generics.is_empty(): f"impl {trait_name}" else: "impl {trait_name}<{join_formatted_type_list(generics, \", \")}>"

fn join_formatted_type_list(types: &[Type], separator: String) -> String:
    let mut out_ = String__new_()
    let mut first = true
    for ty in types:
        if (!first):
            out_.push_str(separator)
            ()
            ()
            ()
            ()
        first = false
        ()
        out_.push_str(&format_type(ty))
        ()
    ()
    out_

