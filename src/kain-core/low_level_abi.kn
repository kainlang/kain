use crate::ast::BinaryOp

use crate::ast::Type

use crate::CompileTarget

const KAIN_C_ABI_FLAVOR_ENV: String = "KAIN_C_ABI_FLAVOR"

pub enum CAbiKind:
    GenericLp64
    GenericLlp64

pub enum CCompilerFlavor:
    Generic
    Gcc
    Clang
    Msvc

impl CCompilerFlavor:
    pub fn as_str(_self: CCompilerFlavor) -> String:
        match _self:
            CCompilerFlavor::Generic => "generic"
            CCompilerFlavor::Gcc => "gcc"
            CCompilerFlavor::Clang => "clang"
            CCompilerFlavor::Msvc => "msvc"


@derive(Debug, Clone, Copy)
pub struct CAbiPolicy:
    key: String
    kind: CAbiKind
    flavor: CCompilerFlavor
    char_bits: usize
    bool_bits: usize
    short_bits: usize
    int_bits: usize
    long_bits: usize
    long_long_bits: usize
    float_bits: usize
    double_bits: usize
    pointer_bits: usize
    integer_promotion_bits: usize
    bitfield_lsb_first: Bool
    packed_struct_align: usize

@derive(Debug, Clone, Copy)
struct CAbiPolicyEntry:
    kind: CAbiKind
    flavor: CCompilerFlavor
    policy: CAbiPolicy

fn policy_entry(key: String, kind: CAbiKind, flavor: CCompilerFlavor, long_bits: usize) -> CAbiPolicyEntry:
    CAbiPolicyEntry { kind: kind, flavor: flavor, policy: CAbiPolicy { key: key, kind: kind, flavor: flavor, char_bits: 8, bool_bits: 8, short_bits: 16, int_bits: 32, long_bits: long_bits, long_long_bits: 64, float_bits: 32, double_bits: 64, pointer_bits: 64, integer_promotion_bits: 32, bitfield_lsb_first: true, packed_struct_align: 1 } }

const C_ABI_POLICY_TABLE: Array<CAbiPolicyEntry> = [policy_entry("generic-lp64", CAbiKind__GenericLp64, CCompilerFlavor__Generic, 64), policy_entry("generic-llp64", CAbiKind__GenericLlp64, CCompilerFlavor__Generic, 32), policy_entry("gcc-lp64", CAbiKind__GenericLp64, CCompilerFlavor__Gcc, 64), policy_entry("gcc-llp64", CAbiKind__GenericLlp64, CCompilerFlavor__Gcc, 32), policy_entry("clang-lp64", CAbiKind__GenericLp64, CCompilerFlavor__Clang, 64), policy_entry("clang-llp64", CAbiKind__GenericLlp64, CCompilerFlavor__Clang, 32), policy_entry("msvc-lp64", CAbiKind__GenericLp64, CCompilerFlavor__Msvc, 64), policy_entry("msvc-llp64", CAbiKind__GenericLlp64, CCompilerFlavor__Msvc, 32)]

pub fn c_compiler_flavor_from_str(value: String) -> Option<CCompilerFlavor>:
    match value.trim().to_ascii_lowercase().as_str():
        "" => none
        "generic" => Option::Some(CCompilerFlavor__Generic)
        "default" => Option::Some(CCompilerFlavor__Generic)
        "gcc" => Option::Some(CCompilerFlavor__Gcc)
        "gnu" => Option::Some(CCompilerFlavor__Gcc)
        "clang" => Option::Some(CCompilerFlavor__Clang)
        "llvm" => Option::Some(CCompilerFlavor__Clang)
        "msvc" => Option::Some(CCompilerFlavor__Msvc)
        "cl" => Option::Some(CCompilerFlavor__Msvc)
        "visualc" => Option::Some(CCompilerFlavor__Msvc)
        _ => none

pub fn selected_c_compiler_flavor() -> CCompilerFlavor:
    std__env__var_(KAIN_C_ABI_FLAVOR_ENV).ok().and_then(c_compiler_flavor_from_str).unwrap_or(CCompilerFlavor__Generic)

pub fn c_abi_kind_for_target(target: CompileTarget) -> CAbiKind:
    match target:
        CompileTarget::Ue5 => CAbiKind__GenericLlp64
        CompileTarget::Ue5Editor => CAbiKind__GenericLlp64
        _ => CAbiKind__GenericLp64

pub fn default_c_abi_policy() -> &static CAbiPolicy:
    c_abi_policy_for_kind_and_flavor(CAbiKind__GenericLp64, selected_c_compiler_flavor())

pub fn c_abi_policy_for_kind_and_flavor(kind: CAbiKind, flavor: CCompilerFlavor) -> &static CAbiPolicy:
    C_ABI_POLICY_TABLE.iter().find(fn(entry): ((entry.kind == kind) && (entry.flavor == flavor))).map(fn(entry): &entry.policy).unwrap_or_else(fn(): C_ABI_POLICY_TABLE.iter().find(fn(entry): ((entry.kind == kind) && (entry.flavor == CCompilerFlavor__Generic))).map(fn(entry): &entry.policy).expect("missing generic C ABI policy"))

pub fn c_abi_policy_for_target_and_flavor(target: CompileTarget, flavor: CCompilerFlavor) -> &static CAbiPolicy:
    c_abi_policy_for_kind_and_flavor(c_abi_kind_for_target(target), flavor)

pub fn c_abi_policy_for_target(target: CompileTarget) -> &static CAbiPolicy:
    c_abi_policy_for_target_and_flavor(target, selected_c_compiler_flavor())

pub fn promoted_integer_bits(width: usize, _signed: Bool, abi: &CAbiPolicy) -> usize:
    width.max((*abi).integer_promotion_bits)

pub enum ArithmeticDomain:
    Integer { bits: usize, signed_: Bool }
    Float { bits: usize }

pub fn arithmetic_domain_for_type(ty: &Type, abi: &CAbiPolicy) -> Option<ArithmeticDomain>:
    match ty:
        Type::Named { name: name } =>
            match name.as_str():
                "Bool" => Option::Some(ArithmeticDomain::Integer { bits: (*abi).bool_bits, signed_: false })
                "Char" => Option::Some(ArithmeticDomain::Integer { bits: (*abi).char_bits, signed_: true })
                "Int" => Option::Some(ArithmeticDomain::Integer { bits: (*abi).long_bits, signed_: true })
                "isize" => Option::Some(ArithmeticDomain::Integer { bits: (*abi).long_bits, signed_: true })
                "UInt" => Option::Some(ArithmeticDomain::Integer { bits: (*abi).long_bits, signed_: false })
                "usize" => Option::Some(ArithmeticDomain::Integer { bits: (*abi).long_bits, signed_: false })
                "Float" => Option::Some(ArithmeticDomain::Float { bits: (*abi).double_bits })
                _ => none
        _ => none

pub fn promoted_type_for_arithmetic(ty: &Type, abi: &CAbiPolicy) -> Option<Type>:
    let domain = arithmetic_domain_for_type(ty, abi)?
    Option::Some(none)

pub fn usual_arithmetic_conversion_type(left: &Type, right: &Type, abi: &CAbiPolicy) -> Option<Type>:
    let lhs = arithmetic_domain_for_type(left, abi)?
    let rhs = arithmetic_domain_for_type(right, abi)?
    match (lhs, rhs):
        (ArithmeticDomain::Float { bits: lhs_bits }, ArithmeticDomain::Float { bits: rhs_bits }) => Option::Some(if (lhs_bits >= rhs_bits): left.clone() else: right.clone())
        (ArithmeticDomain::Float {  }, _) => Option::Some(left.clone())
        (_, ArithmeticDomain::Float {  }) => Option::Some(right.clone())
        (ArithmeticDomain::Integer { bits: lhs_bits, signed_: lhs_signed }, ArithmeticDomain::Integer { bits: rhs_bits, signed_: rhs_signed }) =>
            let lhs_promoted = promoted_integer_bits(lhs_bits, lhs_signed, abi)
            let rhs_promoted = promoted_integer_bits(rhs_bits, rhs_signed, abi)
            if (lhs_signed == rhs_signed):
                Option::Some(if lhs_signed: named_type("Int") else: named_type("UInt"))
            elif (lhs_promoted > rhs_promoted):
                Option::Some(if lhs_signed: named_type("Int") else: named_type("UInt"))
            elif (rhs_promoted > lhs_promoted):
                Option::Some(if rhs_signed: named_type("Int") else: named_type("UInt"))
            elif ((!lhs_signed) || (!rhs_signed)):
                Option::Some(named_type("UInt"))
            else:
                Option::Some(named_type("Int"))

pub fn should_apply_usual_arithmetic_conversions(op: BinaryOp) -> Bool:
    match op:
        BinaryOp::Add => true
        BinaryOp::Sub => true
        BinaryOp::Mul => true
        BinaryOp::Div => true
        BinaryOp::Mod => true
        BinaryOp::Eq => true
        BinaryOp::Ne => true
        BinaryOp::Lt => true
        BinaryOp::Gt => true
        BinaryOp::Le => true
        BinaryOp::Ge => true
        BinaryOp::BitAnd => true
        BinaryOp::BitOr => true
        BinaryOp::BitXor => true
        _ => false

pub fn named_type(name: String) -> Type:
    Type::Named { name: name.to_string(), generics: Vec__new_(), span: Span__default_() }

