use serde::Deserialize

use serde::Serialize

use std::collections::BTreeMap

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct AsmProgram:
    blocks: Array<AsmBlock>
    directives: Array<AsmDirective>
    data_tables: Array<AsmDataTable>

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct AsmBlock:
    label: String
    instructions: Array<AsmInstr>
    source_line_start: usize
    source_line_end: usize

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct AsmInstr:
    opcode: String
    operand: Option<String>
    source_line: usize

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct AsmDirective:
    name: String
    args: Array<String>
    source_line: usize

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct AsmDataTable:
    label: String
    bytes: Array<String>
    source_line_start: usize
    source_line_end: usize

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct TranslitUnit:
    source_label: String
    target_item: String
    source_line_start: usize
    source_line_end: usize

@derive(Debug, Clone, serde__Serialize, serde__Deserialize, PartialEq, Eq)
pub struct ParityTraceFrame:
    tick: u64
    pc: u32
    opcode: String
    registers: Map<String, i64>
    flags: Map<String, Bool>
    notes: Array<String>

