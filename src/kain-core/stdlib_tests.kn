@test_
fn test_load_kn_files_multiple_files():
    let test_dir = TempTestDir__new_("multiple_files")
    test_dir.create_dir("stdlib")
    ()
    test_dir.create_file("stdlib/a.kn", "fn a() -> Int: 1")
    ()
    test_dir.create_file("stdlib/b.kn", "fn b() -> Int: 2")
    ()
    test_dir.create_file("stdlib/c.kn", "fn c() -> Int: 3")
    ()
    let result = stdlib__load_kn_files_from_dir(&test_dir.path().join("stdlib"))
    if (!result.is_some()):
        panic("Should load files successfully")
    let content = result.unwrap()
    if (!content.contains("fn a()")):
        panic("Should contain function a")
    if (!content.contains("fn b()")):
        panic("Should contain function b")
    if (!content.contains("fn c()")):
        panic("Should contain function c")
    let a_pos = content.find("fn a()").unwrap()
    let b_pos = content.find("fn b()").unwrap()
    let c_pos = content.find("fn c()").unwrap()
    if (!((a_pos < b_pos) && (b_pos < c_pos))):
        panic("Files should be in alphabetical order")

@test_
fn test_load_kn_files_with_readme():
    let test_dir = TempTestDir__new_("with_readme")
    test_dir.create_dir("stdlib")
    ()
    test_dir.create_file("stdlib/code.kn", "fn code() -> Int: 42")
    ()
    test_dir.create_file("stdlib/README.md", "# This is a readme")
    ()
    test_dir.create_file("stdlib/readme.kn", "# This should be excluded")
    ()
    test_dir.create_file("stdlib/ReadMe.kn", "# This should also be excluded")
    ()
    let result = stdlib__load_kn_files_from_dir(&test_dir.path().join("stdlib"))
    if (!result.is_some()):
        panic("Should load files successfully")
    let content = result.unwrap()
    if (!content.contains("fn code()")):
        panic("Should contain code function")
    if (!(!content.contains("This is a readme"))):
        panic("Should exclude README.md")
    if (!(!content.contains("This should be excluded"))):
        panic("Should exclude readme.kn")
    if (!(!content.contains("This should also be excluded"))):
        panic("Should exclude ReadMe.kn")

