use crate::stdlib::find_stdlib_search_roots

use crate::stdlib::load_kn_files_from_dir

use crate::stdlib::load_stdlib

use std::env

use std::fs

use std::path::PathBuf

@doc(doc = " Helper to create a temporary test directory structure")
struct TempTestDir:
    path: std::path::PathBuf

impl TempTestDir:
    fn new_(name: String) -> TempTestDir:
        let temp_dir = std__env__temp_dir().join(f"kain_test_{name}")
        if temp_dir.exists():
            let _ = std__fs__remove_dir_all(&temp_dir)
            ()
        std__fs__create_dir_all(&temp_dir).expect("Failed to create temp dir")
        ()
        TempTestDir { path: temp_dir }

    fn create_file(_self: &TempTestDir, relative_path: String, content: String):
        let file_path = (*_self).path.join(relative_path)
        match file_path.parent():
            Some(parent) =>
                std__fs__create_dir_all(parent).expect("Failed to create parent dirs")
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        std__fs__write(&file_path, content).expect("Failed to write file")
        ()

    fn create_dir(_self: &TempTestDir, relative_path: String):
        let dir_path = (*_self).path.join(relative_path)
        std__fs__create_dir_all(&dir_path).expect("Failed to create directory")
        ()

    fn path(_self: &TempTestDir) -> &std::path::PathBuf:
        &(*_self).path


impl Drop for TempTestDir:
    fn drop(_self: &mut TempTestDir):
        let _ = std__fs__remove_dir_all(&(*_self).path)


@test_
fn test_find_stdlib_with_env_var_valid():
    let test_dir = TempTestDir__new_("env_var_valid")
    test_dir.create_dir("stdlib")
    ()
    test_dir.create_file("stdlib/test.kn", "fn test() -> Int: 42")
    ()
    std__env__set_var("KAIN_STDLIB_PATH", test_dir.path().join("stdlib"))
    ()
    let roots = stdlib__find_stdlib_search_roots()
    std__env__remove_var("KAIN_STDLIB_PATH")
    ()
    if (roots.len() != 1):
        panic("Should find exactly one root with env var")
    if (roots[0] != test_dir.path().join("stdlib")):
        panic("assert_eq! failed")

@test_
fn test_find_stdlib_with_env_var_invalid():
    let invalid_path = std__env__temp_dir().join("kain_nonexistent_stdlib_12345")
    std__env__set_var("KAIN_STDLIB_PATH", &invalid_path)
    ()
    let roots = stdlib__find_stdlib_search_roots()
    std__env__remove_var("KAIN_STDLIB_PATH")
    ()
    if (!(roots.is_empty() || (!roots.is_empty()))):
        panic("Should return valid Vec")

@test_
fn test_find_stdlib_in_parent_directory():
    let test_dir = TempTestDir__new_("parent_dir")
    test_dir.create_dir("stdlib")
    ()
    test_dir.create_dir("subdir/deep")
    ()
    test_dir.create_file("stdlib/test.kn", "fn test() -> Int: 42")
    ()
    let original_dir = std__env__current_dir().unwrap()
    let deep_dir = test_dir.path().join("subdir/deep")
    std__env__set_current_dir(&deep_dir).expect("Failed to change directory")
    ()
    let roots = stdlib__find_stdlib_search_roots()
    std__env__set_current_dir(original_dir).expect("Failed to restore directory")
    ()
    if (!(!roots.is_empty())):
        panic("Should find stdlib in parent directory")
    if (!roots.iter().any(fn(r): r.ends_with("stdlib"))):
        panic("Should find a path ending with 'stdlib'")

