@test_
fn test_load_kn_files_alphabetical_ordering():
    let test_dir = TempTestDir__new_("alphabetical")
    test_dir.create_dir("stdlib")
    ()
    test_dir.create_file("stdlib/zebra.kn", "fn zebra() -> Int: 26")
    ()
    test_dir.create_file("stdlib/alpha.kn", "fn alpha() -> Int: 1")
    ()
    test_dir.create_file("stdlib/middle.kn", "fn middle() -> Int: 13")
    ()
    test_dir.create_file("stdlib/beta.kn", "fn beta() -> Int: 2")
    ()
    let result = stdlib__load_kn_files_from_dir(&test_dir.path().join("stdlib"))
    if (!result.is_some()):
        panic("Should load files successfully")
    let content = result.unwrap()
    let alpha_pos = content.find("fn alpha()").unwrap()
    let beta_pos = content.find("fn beta()").unwrap()
    let middle_pos = content.find("fn middle()").unwrap()
    let zebra_pos = content.find("fn zebra()").unwrap()
    if (!(((alpha_pos < beta_pos) && (beta_pos < middle_pos)) && (middle_pos < zebra_pos))):
        panic("Files should be in strict alphabetical order")

@test_
fn test_load_stdlib_with_ue5_subdirectory_keeps_root_default():
    let test_dir = TempTestDir__new_("ue5_subdir")
    test_dir.create_dir("stdlib/ue5")
    ()
    test_dir.create_file("stdlib/ue5/actor.kn", "fn get_location() -> Vec3: vec3(0.0, 0.0, 0.0)")
    ()
    test_dir.create_file("stdlib/generic.kn", "fn generic() -> Int: 42")
    ()
    std__env__set_var("KAIN_STDLIB_PATH", test_dir.path().join("stdlib"))
    ()
    let result = stdlib__load_stdlib()
    std__env__remove_var("KAIN_STDLIB_PATH")
    ()
    if (!result.contains("fn generic()")):
        panic("Should load the root stdlib by default")
    if (!(!result.contains("fn get_location()"))):
        panic("Should not pull in ue5/ overlays for generic loads")

