@test_
fn test_load_stdlib_graceful_degradation():
    let original_dir = std__env__current_dir().unwrap()
    let test_dir = TempTestDir__new_("graceful_degradation")
    test_dir.create_dir("no_stdlib_here")
    ()
    let invalid_path = std__env__temp_dir().join("kain_nonexistent_stdlib_67890")
    std__env__set_var("KAIN_STDLIB_PATH", &invalid_path)
    ()
    std__env__set_current_dir(test_dir.path()).expect("Failed to change directory")
    ()
    let result = stdlib__load_stdlib()
    std__env__set_current_dir(&original_dir).expect("Failed to restore directory")
    ()
    std__env__remove_var("KAIN_STDLIB_PATH")
    ()
    if (!(result.is_empty() || (!result.is_empty()))):
        panic("Should return valid string without crashing")

@test_
fn test_load_stdlib_deterministic_ordering():
    let test_dir = TempTestDir__new_("deterministic")
    test_dir.create_dir("stdlib")
    ()
    test_dir.create_file("stdlib/file1.kn", "fn file1() -> Int: 1")
    ()
    test_dir.create_file("stdlib/file2.kn", "fn file2() -> Int: 2")
    ()
    test_dir.create_file("stdlib/file3.kn", "fn file3() -> Int: 3")
    ()
    let stdlib_path = test_dir.path().join("stdlib")
    std__env__set_var("KAIN_STDLIB_PATH", &stdlib_path)
    ()
    let result1 = stdlib__load_stdlib()
    std__env__set_var("KAIN_STDLIB_PATH", &stdlib_path)
    ()
    let result2 = stdlib__load_stdlib()
    std__env__set_var("KAIN_STDLIB_PATH", &stdlib_path)
    ()
    let result3 = stdlib__load_stdlib()
    std__env__remove_var("KAIN_STDLIB_PATH")
    ()
    if (result1 != result2):
        panic("First and second load should be identical")
    if (result2 != result3):
        panic("Second and third load should be identical")
    if (!result1.contains("fn file1()")):
        panic("Should contain file1 function")
    if (!result1.contains("fn file2()")):
        panic("Should contain file2 function")
    if (!result1.contains("fn file3()")):
        panic("Should contain file3 function")

@test_
fn test_readme_case_insensitive_filtering():
    let test_dir = TempTestDir__new_("readme_cases")
    test_dir.create_dir("stdlib")
    ()
    test_dir.create_file("stdlib/code.kn", "fn code() -> Int: 42")
    ()
    test_dir.create_file("stdlib/README.kn", "# Should be excluded")
    ()
    test_dir.create_file("stdlib/readme.kn", "# Should be excluded")
    ()
    test_dir.create_file("stdlib/ReadMe.kn", "# Should be excluded")
    ()
    test_dir.create_file("stdlib/README.kn", "# Should be excluded")
    ()
    test_dir.create_file("stdlib/rEaDmE.kn", "# Should be excluded")
    ()
    let result = stdlib__load_kn_files_from_dir(&test_dir.path().join("stdlib"))
    if (!result.is_some()):
        panic("Should load files successfully")
    let content = result.unwrap()
    if (!content.contains("fn code()")):
        panic("Should contain code function")
    if (!(!content.contains("Should be excluded"))):
        panic("Should exclude all README variants")

@test_
fn test_env_var_priority_over_filesystem():
    let test_dir1 = TempTestDir__new_("priority1")
    let test_dir2 = TempTestDir__new_("priority2")
    test_dir1.create_dir("stdlib")
    ()
    test_dir1.create_file("stdlib/file1.kn", "fn from_env() -> Int: 1")
    ()
    test_dir2.create_dir("stdlib")
    ()
    test_dir2.create_file("stdlib/file2.kn", "fn from_fs() -> Int: 2")
    ()
    std__env__set_var("KAIN_STDLIB_PATH", test_dir1.path().join("stdlib"))
    ()
    let original_dir = std__env__current_dir().unwrap()
    std__env__set_current_dir(test_dir2.path()).expect("Failed to change directory")
    ()
    let result = stdlib__load_stdlib()
    std__env__set_current_dir(original_dir).expect("Failed to restore directory")
    ()
    std__env__remove_var("KAIN_STDLIB_PATH")
    ()
    if (!result.contains("fn from_env()")):
        panic("Should load from KAIN_STDLIB_PATH")
    if (!(!result.contains("fn from_fs()"))):
        panic("Should not load from filesystem when env var is set")

