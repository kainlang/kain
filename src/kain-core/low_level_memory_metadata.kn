use crate::ast::Attribute

use crate::ast::Expr

use crate::span::Span

pub const C_UNION_ATTR: String = "c_union"

pub const C_BITFIELD_ATTR: String = "c_bitfield"

pub const C_STORAGE_BITS_ATTR: String = "c_storage_bits"

pub const C_STORAGE_ALIGN_ATTR: String = "c_storage_align"

pub const C_PACKED_ATTR: String = "c_packed"

pub const C_PACK_ALIGN_ATTR: String = "c_pack_align"

pub const C_TYPE_ALIGN_ATTR: String = "c_type_align"

pub fn marker_attr(name: String, span: Span) -> Attribute:
    Attribute { name: name.to_string(), args: Vec__new_(), span: span }

pub fn usize_attr(name: String, value: usize, span: Span) -> Attribute:
    Attribute { name: name.to_string(), args: [Expr::Int(value as i64, span)], span: span }

pub fn usize_bool_attr(name: String, value: usize, flag: Bool, span: Span) -> Attribute:
    Attribute { name: name.to_string(), args: [Expr::Int(value as i64, span), Expr::Bool(flag, span)], span: span }

pub fn has_attr(attrs: &[Attribute], name: String) -> Bool:
    attrs.iter().any(fn(attr): (attr.name == name))

pub fn attr_usize_arg(attrs: &[Attribute], name: String) -> Option<usize>:
    attrs.iter().find_map(fn(attr): none)

pub fn attr_usize_bool_args(attrs: &[Attribute], name: String) -> Option<(usize, Bool)>:
    attrs.iter().find_map(fn(attr): none)

