use std::fs

use std::path::Path

use serde::Deserialize

use crate::model::CombineMode

@derive(Clone, Debug, Default, serde__Deserialize)
pub struct Fast3dGameplayStateDocument:
    actor_bindings: Array<Fast3dActorBindingDefinition>

impl Default for Fast3dGameplayStateDocument:
    pub fn default_() -> Fast3dGameplayStateDocument:
        Fast3dGameplayStateDocument { actor_bindings: Vec__new_() }


impl Fast3dGameplayStateDocument:
    pub fn load_from_path(path: &std::path::Path) -> Result<Fast3dGameplayStateDocument, Box<impl Error>>:
        let text = std__fs__read_to_string(path)?
        Result::Ok(serde_json__from_str(&text)?)


@derive(Clone, Debug, serde__Deserialize)
pub struct Fast3dActorBindingDefinition:
    display_list_id: String
    animation: ActorAnimationDefinition

pub enum ActorAnimationDefinition:
    None
    SpinY { degrees_per_second: f32 }
    BobY { amplitude: f32, cycles_per_second: f32, base_height: f32 }

impl Default for ActorAnimationDefinition:
    pub fn default_() -> ActorAnimationDefinition:
        ActorAnimationDefinition__None


@derive(Clone, Debug, Default, serde__Deserialize)
pub struct Fast3dShaderOverrideDocument:
    display_list_overrides: Array<Fast3dDisplayListOverrideDefinition>

impl Default for Fast3dShaderOverrideDocument:
    pub fn default_() -> Fast3dShaderOverrideDocument:
        Fast3dShaderOverrideDocument { display_list_overrides: Vec__new_() }


impl Fast3dShaderOverrideDocument:
    pub fn load_from_path(path: &std::path::Path) -> Result<Fast3dShaderOverrideDocument, Box<impl Error>>:
        let text = std__fs__read_to_string(path)?
        Result::Ok(serde_json__from_str(&text)?)


@derive(Clone, Debug, serde__Deserialize)
pub struct Fast3dDisplayListOverrideDefinition:
    display_list_id: String
    combine_mode: Option<CombineMode>
    primitive_color: Option<[u8; 4]>
    env_color: Option<[u8; 4]>

