use crate::combiner::CombinerState

use crate::combiner::CompiledCombiner

use crate::math::rgba8_from_vec4

use crate::math::Float2

use crate::math::Float4

use crate::texture::TextureImage

@derive(Clone, Debug, Default)
pub struct RenderStats:
    triangles_submitted: usize
    triangles_rasterized: usize
    shaded_pixels: usize

impl Default for RenderStats:
    pub fn default_() -> RenderStats:
        RenderStats { triangles_submitted: 0, triangles_rasterized: 0, shaded_pixels: 0 }


@derive(Clone, Debug)
pub struct RenderFrame:
    width: usize
    height: usize
    rgba: Array<u8>
    stats: RenderStats

@derive(Clone, Copy, Debug)
pub struct ScreenVertex:
    x: f32
    y: f32
    depth: f32
    inv_w: f32
    uv_over_w: Float2
    color_over_w: Float4

pub struct Framebuffer:
    width: usize
    height: usize
    rgba: Array<u8>
    depth: Array<f32>

impl Framebuffer:
    pub fn new_(width: usize, height: usize, clear_color: [u8; 4]) -> Framebuffer:
        let mut framebuffer = Framebuffer { width: width, height: height, rgba: [], depth: [] }
        framebuffer.clear(clear_color)
        ()
        framebuffer

    pub fn clear(_self: &mut Framebuffer, clear_color: [u8; 4]):
        for pixel in (*_self).rgba.chunks_exact_mut(4):
            pixel.copy_from_slice(&clear_color)
            ()
        ()
        (*_self).depth.fill(f32__INFINITY)
        ()

    pub fn draw_triangle(_self: &mut Framebuffer, vertices: [ScreenVertex; 3], texture: Option<&TextureImage>, combiner_state: CombinerState, stats: &mut RenderStats):
        (*stats).triangles_submitted = ((*stats).triangles_submitted + 1)
        ()
        let area = edge(vertices[0], vertices[1], vertices[2].x, vertices[2].y)
        if (area.abs() <= f32__EPSILON):
            return
        let min_x = vertices.iter().map(fn(vertex_): vertex_.x).fold(f32__INFINITY, f32__min).floor().max(0) as i32
        let max_x = vertices.iter().map(fn(vertex_): vertex_.x).fold(f32__NEG_INFINITY, f32__max).ceil().min(((*_self).width.saturating_sub(1)) as f32) as i32
        let min_y = vertices.iter().map(fn(vertex_): vertex_.y).fold(f32__INFINITY, f32__min).floor().max(0) as i32
        let max_y = vertices.iter().map(fn(vertex_): vertex_.y).fold(f32__NEG_INFINITY, f32__max).ceil().min(((*_self).height.saturating_sub(1)) as f32) as i32
        let compiled_combiner = CompiledCombiner__compile_(combiner_state.mode)
        let winding_sign = area.signum()
        let reciprocal_area = (1 / area)
        let primitive_color = combiner_state.primitive_color
        let env_color = combiner_state.env_color
        let fallback_texture = Float4__ONE
        (*stats).triangles_rasterized = ((*stats).triangles_rasterized + 1)
        ()
        for y in range(min_y, (max_y + 1)):
            for x in range(min_x, (max_x + 1)):
                let pixel_center_x = (x as f32 + 0.5)
                let pixel_center_y = (y as f32 + 0.5)
                let weight0 = edge(vertices[1], vertices[2], pixel_center_x, pixel_center_y)
                let weight1 = edge(vertices[2], vertices[0], pixel_center_x, pixel_center_y)
                let weight2 = edge(vertices[0], vertices[1], pixel_center_x, pixel_center_y)
                if ((((weight0 * winding_sign) < 0) || ((weight1 * winding_sign) < 0)) || ((weight2 * winding_sign) < 0)):
                    continue
                let bary0 = (weight0 * reciprocal_area)
                let bary1 = (weight1 * reciprocal_area)
                let bary2 = (weight2 * reciprocal_area)
                let inv_w = (((vertices[0].inv_w * bary0) + (vertices[1].inv_w * bary1)) + (vertices[2].inv_w * bary2))
                if (inv_w <= f32__EPSILON):
                    continue
                let depth = ((((((vertices[0].depth * vertices[0].inv_w) * bary0) + ((vertices[1].depth * vertices[1].inv_w) * bary1)) + ((vertices[2].depth * vertices[2].inv_w) * bary2))) / inv_w)
                let pixel_index = ((y as usize * (*_self).width) + x as usize)
                if (depth >= (*_self).depth[pixel_index]):
                    continue
                let uv = (((((vertices[0].uv_over_w * bary0) + (vertices[1].uv_over_w * bary1)) + (vertices[2].uv_over_w * bary2))) / inv_w)
                let vertex_color = (((((vertices[0].color_over_w * bary0) + (vertices[1].color_over_w * bary1)) + (vertices[2].color_over_w * bary2))) / inv_w)
                let texture_color = texture.map(fn(texture): math__vec4_from_rgba8(texture.sample_repeat(uv))).unwrap_or(fallback_texture)
                let shaded = compiled_combiner.shade(texture_color, vertex_color, primitive_color, env_color)
                (*_self).depth[pixel_index] = depth
                ()
                let output = math__rgba8_from_vec4(shaded)
                let rgba_index = (pixel_index * 4)
                (*_self).rgba[rgba_index..(rgba_index + 4)].copy_from_slice(&output)
                ()
                (*stats).shaded_pixels = ((*stats).shaded_pixels + 1)
                ()

    pub fn finish(_self: Framebuffer, stats: RenderStats) -> RenderFrame:
        RenderFrame { width: _self.width, height: _self.height, rgba: _self.rgba, stats: stats }


fn edge(a: ScreenVertex, b: ScreenVertex, x: f32, y: f32) -> f32:
    ((((x - a.x)) * ((b.y - a.y))) - (((y - a.y)) * ((b.x - a.x))))

