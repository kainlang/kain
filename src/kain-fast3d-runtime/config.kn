use std::fs

use std::path::Path

use std::path::PathBuf

use regex::Regex

use serde::Deserialize

@derive(Clone, Debug, serde__Deserialize)
pub struct Fast3dHostConfig:
    action: Fast3dHostAction

pub enum Fast3dHostAction:
    Viewer { manifest_path: String, gameplay_state_path: Option<String>, shader_overrides_path: Option<String> }
    Snapshot { manifest_path: String, output_path: String, time_seconds: f32, gameplay_state_path: Option<String>, shader_overrides_path: Option<String> }
    ExtractSm64TitleFace { sm64_source_root: String, manifest_output_path: String }
    ExtractSm64LevelChunk { sm64_source_root: String, level_name: String, area_id: u32, manifest_output_path: String }

pub enum ResolvedFast3dHostAction:
    Viewer { manifest_path: std::path::PathBuf, gameplay_state_path: Option<std::path::PathBuf>, shader_overrides_path: Option<std::path::PathBuf> }
    Snapshot { manifest_path: std::path::PathBuf, output_path: std::path::PathBuf, time_seconds: f32, gameplay_state_path: Option<std::path::PathBuf>, shader_overrides_path: Option<std::path::PathBuf> }
    ExtractSm64TitleFace { sm64_source_root: std::path::PathBuf, manifest_output_path: std::path::PathBuf }
    ExtractSm64LevelChunk { sm64_source_root: std::path::PathBuf, level_name: String, area_id: u32, manifest_output_path: std::path::PathBuf }

fn default_area_id() -> u32:
    1

pub fn load_host_config(config_path: &std::path::Path) -> Result<Fast3dHostConfig, Box<impl Error>>:
    let config_text = std__fs__read_to_string(config_path)?
    let extension = config_path.extension().and_then(fn(value): value.to_str()).unwrap_or("json").to_ascii_lowercase()
    match extension.as_str():
        "json" => Result::Ok(serde_json__from_str(&config_text)?)
        "toml" => Result::Ok(toml__from_str(&config_text)?)
        other => Result::Err((f"unsupported Fast3D host config extension `{other}` for {config_path.display()}").into())

impl Fast3dHostConfig:
    pub fn resolve(_self: &Fast3dHostConfig, config_path: &std::path::Path) -> Result<ResolvedFast3dHostAction, String>:
        let base_dir = config_path.parent().unwrap_or_else(fn(): Path__new_("."))
        match &(*_self).action:
            Fast3dHostAction::Viewer { manifest_path: manifest_path, gameplay_state_path: gameplay_state_path, shader_overrides_path: shader_overrides_path } => Result::Ok(ResolvedFast3dHostAction::Viewer { manifest_path: resolve_config_path(manifest_path, base_dir)?, gameplay_state_path: resolve_optional_config_path(gameplay_state_path, base_dir)?, shader_overrides_path: resolve_optional_config_path(shader_overrides_path, base_dir)? })
            Fast3dHostAction::Snapshot { manifest_path: manifest_path, output_path: output_path, time_seconds: time_seconds, gameplay_state_path: gameplay_state_path, shader_overrides_path: shader_overrides_path } => Result::Ok(ResolvedFast3dHostAction::Snapshot { manifest_path: resolve_config_path(manifest_path, base_dir)?, output_path: resolve_config_path(output_path, base_dir)?, time_seconds: (*time_seconds), gameplay_state_path: resolve_optional_config_path(gameplay_state_path, base_dir)?, shader_overrides_path: resolve_optional_config_path(shader_overrides_path, base_dir)? })
            Fast3dHostAction::ExtractSm64TitleFace { sm64_source_root: sm64_source_root, manifest_output_path: manifest_output_path } => Result::Ok(ResolvedFast3dHostAction::ExtractSm64TitleFace { sm64_source_root: resolve_config_path(sm64_source_root, base_dir)?, manifest_output_path: resolve_config_path(manifest_output_path, base_dir)? })
            Fast3dHostAction::ExtractSm64LevelChunk { sm64_source_root: sm64_source_root, level_name: level_name, area_id: area_id, manifest_output_path: manifest_output_path } => Result::Ok(ResolvedFast3dHostAction::ExtractSm64LevelChunk { sm64_source_root: resolve_config_path(sm64_source_root, base_dir)?, level_name: level_name.clone(), area_id: (*area_id), manifest_output_path: resolve_config_path(manifest_output_path, base_dir)? })


fn resolve_optional_config_path(raw_value: Option<String>, base_dir: &std::path::Path) -> Result<Option<std::path::PathBuf>, String>:
    raw_value.filter(fn(value): (!value.trim().is_empty())).map(fn(value): resolve_config_path(value, base_dir)).transpose()

fn resolve_config_path(raw_value: String, base_dir: &std::path::Path) -> Result<std::path::PathBuf, String>:
    let expanded_value = expand_environment_tokens(raw_value)?
    let candidate = PathBuf__from(expanded_value)
    if candidate.is_relative():
        Result::Ok(base_dir.join(candidate))
    else:
        Result::Ok(candidate)

fn expand_environment_tokens(input: String) -> Result<String, String>:
    let environment_regex = Regex__new_("\\$\\{(?P<name>[A-Za-z0-9_]+)\\}").map_err(fn(error): f"failed to compile Fast3D env regex: {error}")?
    let mut expanded = String__new_()
    let mut last_end = 0
    for capture in environment_regex.captures_iter(input):
        let matched = capture.get(0).ok_or("expected Fast3D env token match to exist")?
        expanded.push_str(&input[last_end..matched.start()])
        ()
        let variable_name = &capture["name"]
        let variable_value = std__env__var_(variable_name).map_err(fn(_): f"Fast3D host config referenced missing environment variable `{variable_name}`")?
        expanded.push_str(&variable_value)
        ()
        last_end = matched.end()
        ()
    ()
    expanded.push_str(&input[last_end..])
    ()
    Result::Ok(expanded)

