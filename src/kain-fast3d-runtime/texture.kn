use std::collections::HashMap

use font8x8::UnicodeFonts

use crate::math::rgba8_from_vec4

use crate::math::vec4_from_rgba8

use crate::math::Float4

use crate::model::TextureDefinition

use crate::model::TextureSource

@derive(Clone, Debug)
pub struct TextureImage:
    width: u32
    height: u32
    pixels: Array<[u8; 4]>

impl TextureImage:
    pub fn sample_repeat(_self: &TextureImage, uv: glam::Vec2) -> [u8; 4]:
        let wrap = fn(value: f32): value.rem_euclid(1)
        let u = wrap(uv.x)
        let v = wrap(uv.y)
        let x = (((u * (*_self).width as f32)).floor() as u32).min((*_self).width.saturating_sub(1))
        let y = (((v * (*_self).height as f32)).floor() as u32).min((*_self).height.saturating_sub(1))
        (*_self).pixels[(((y * (*_self).width) + x)) as usize]


pub fn build_texture_catalog(textures: &[TextureDefinition]) -> Result<Map<String, TextureImage>, String>:
    let mut catalog = HashMap__new_()
    for texture in textures:
        let image = match &texture.source:
            TextureSource::Checkerboard { width: width, height: height, cell_size: cell_size, color_a: color_a, color_b: color_b } => TextureImage { width: (*width), height: (*height), pixels: build_checkerboard((*width), (*height), (*cell_size), (*color_a), (*color_b)) }
            TextureSource::Stripes { width: width, height: height, stripe_height: stripe_height, color_a: color_a, color_b: color_b } => TextureImage { width: (*width), height: (*height), pixels: build_stripes((*width), (*height), (*stripe_height), (*color_a), (*color_b)) }
            TextureSource::GeneratedSm64TitleCard { width: width, height: height } => TextureImage { width: (*width), height: (*height), pixels: build_sm64_title_card((*width), (*height)) }
            TextureSource::GeneratedMarioEyesFront { width: width, height: height } => TextureImage { width: (*width), height: (*height), pixels: build_mario_eyes_front((*width), (*height)) }
            TextureSource::GeneratedMarioMustache { width: width, height: height } => TextureImage { width: (*width), height: (*height), pixels: build_mario_mustache((*width), (*height)) }
            TextureSource::GeneratedMarioSideburn { width: width, height: height } => TextureImage { width: (*width), height: (*height), pixels: build_mario_sideburn((*width), (*height)) }
            TextureSource::GeneratedNamedTile { width: width, height: height, label: label, color_a: color_a, color_b: color_b } => TextureImage { width: (*width), height: (*height), pixels: build_named_tile((*width), (*height), label, (*color_a), (*color_b)) }
        if catalog.insert(texture.id.clone(), image).is_some():
            return Result::Err(f"duplicate texture id `{texture.id}`")
    ()
    Result::Ok(catalog)

fn build_checkerboard(width: u32, height: u32, cell_size: u32, color_a: [u8; 4], color_b: [u8; 4]) -> Array<[u8; 4]>:
    let cell_size = cell_size.max(1)
    let mut pixels = (fn(__kain_ctor_arg0): Vec__new_())(((width * height)) as usize)
    for y in range(0, height):
        for x in range(0, width):
            let cell_x = (x / cell_size)
            let cell_y = (y / cell_size)
            let selected = if ((((cell_x + cell_y)) % 2) == 0):
                color_a
            else:
                color_b
            pixels.push(selected)
            ()
    ()
    pixels

fn build_stripes(width: u32, height: u32, stripe_height: u32, color_a: [u8; 4], color_b: [u8; 4]) -> Array<[u8; 4]>:
    let stripe_height = stripe_height.max(1)
    let mut pixels = (fn(__kain_ctor_arg0): Vec__new_())(((width * height)) as usize)
    let low = math__vec4_from_rgba8(color_a)
    let high = math__vec4_from_rgba8(color_b)
    for y in range(0, height):
        let stripe_index = (y / stripe_height)
        let blend = (((y % stripe_height)) as f32 / stripe_height as f32)
        for x_2 in range(0, width):
            let base = if ((stripe_index % 2) == 0):
                low
            else:
                high
            let peak = if ((stripe_index % 2) == 0):
                high
            else:
                low
            let color: Float4 = base.lerp(peak, (blend * 0.6))
            pixels.push(math__rgba8_from_vec4(color))
            ()
    ()
    pixels

fn build_sm64_title_card(width: u32, height: u32) -> Array<[u8; 4]>:
    let mut pixels = []
    for y in range(0, height):
        let blend = (y as f32 / height.max(1) as f32)
        let top = Vec4__new_(20, 60, 140, 255)
        let bottom = Vec4__new_(4, 10, 34, 255)
        let sky = (top.lerp(bottom, blend) / 255)
        for x in range(0, width):
            let mut color = math__rgba8_from_vec4(sky)
            if (((((((x * 17) + (y * 13))) % 97)) == 0) && (y < (height / 2))):
                color = [255, 248, 210, 255]
                ()
                ()
                ()
                ()
            pixels[(((y * width) + x)) as usize] = color
            ()
    ()
    draw_scaled_text(&mut pixels, width, height, 22, 36, 5, "SUPER", [255, 214, 72, 255])
    ()
    draw_scaled_text(&mut pixels, width, height, 58, 108, 6, "MARIO", [234, 52, 42, 255])
    ()
    draw_scaled_text(&mut pixels, width, height, 118, 176, 6, "64", [70, 126, 255, 255])
    ()
    draw_scaled_text(&mut pixels, width, height, 126, 340, 3, "PRESS START", [252, 252, 252, 255])
    ()
    pixels

fn build_mario_eyes_front(width: u32, height: u32) -> Array<[u8; 4]>:
    let mut pixels = []
    fill_ellipse(&mut pixels, width, height, (width as f32 * 0.3), (height as f32 * 0.52), (width as f32 * 0.18), (height as f32 * 0.2), [255, 255, 255, 255])
    ()
    fill_ellipse(&mut pixels, width, height, (width as f32 * 0.7), (height as f32 * 0.52), (width as f32 * 0.18), (height as f32 * 0.2), [255, 255, 255, 255])
    ()
    fill_ellipse(&mut pixels, width, height, (width as f32 * 0.3), (height as f32 * 0.56), (width as f32 * 0.08), (height as f32 * 0.1), [32, 118, 255, 255])
    ()
    fill_ellipse(&mut pixels, width, height, (width as f32 * 0.7), (height as f32 * 0.56), (width as f32 * 0.08), (height as f32 * 0.1), [32, 118, 255, 255])
    ()
    fill_ellipse(&mut pixels, width, height, (width as f32 * 0.3), (height as f32 * 0.56), (width as f32 * 0.04), (height as f32 * 0.06), [8, 8, 8, 255])
    ()
    fill_ellipse(&mut pixels, width, height, (width as f32 * 0.7), (height as f32 * 0.56), (width as f32 * 0.04), (height as f32 * 0.06), [8, 8, 8, 255])
    ()
    pixels

fn build_mario_mustache(width: u32, height: u32) -> Array<[u8; 4]>:
    let mut pixels = []
    for y in range(0, height):
        for x in range(0, width):
            let xf = (x as f32 / width.max(1) as f32)
            let yf = (y as f32 / height.max(1) as f32)
            let left = ((((xf > 0.1) && (xf < 0.46)) && (yf > (0.36 + (((0.46 - xf)) * 0.35)))) && (yf < 0.72))
            let right = ((((xf > 0.54) && (xf < 0.9)) && (yf > (0.36 + (((xf - 0.54)) * 0.35)))) && (yf < 0.72))
            if (left || right):
                pixels[(((y * width) + x)) as usize] = [26, 18, 12, 255]
                ()
    ()
    pixels

fn build_mario_sideburn(width: u32, height: u32) -> Array<[u8; 4]>:
    let mut pixels = []
    for y in range(0, height):
        for x in range(0, width):
            let left = (((x < (width / 4)) && (y > (height / 6))) && (y < ((height * 5) / 6)))
            let right = (((x > ((width * 3) / 4)) && (y > (height / 6))) && (y < ((height * 5) / 6)))
            if (left || right):
                pixels[(((y * width) + x)) as usize] = [90, 28, 8, 255]
                ()
    ()
    pixels

fn build_named_tile(width: u32, height: u32, label: String, color_a: [u8; 4], color_b: [u8; 4]) -> Array<[u8; 4]>:
    let mut pixels = build_checkerboard(width, height, 8, color_a, color_b)
    let text_color = [246, 240, 220, 255]
    let sanitized = label.rsplit("_").next().unwrap_or(label).chars().take(8).collect().to_uppercase()
    draw_scaled_text(&mut pixels, width, height, 4, height.saturating_sub(20), 1, &sanitized, text_color)
    ()
    pixels

fn draw_scaled_text(pixels: &mut [[u8; 4]], width: u32, height: u32, start_x: u32, start_y: u32, scale: u32, text: String, color: [u8; 4]):
    let scale = scale.max(1)
    let mut cursor_x = start_x
    for character in text.chars():
        if (character == " "):
            cursor_x = (cursor_x + (6 * scale))
            ()
            continue
        match font8x8__BASIC_FONTS.get(character):
            Some(glyph) =>
                for selfhost_for_item in glyph.iter().enumerate():
                    let (row_index, row_bits) = selfhost_for_item
                    for column_index in range(0, 8):
                        if ((((row_bits >> column_index)) & 1) == 0):
                            continue
                        for scale_y in range(0, scale):
                            for scale_x in range(0, scale):
                                let x = ((cursor_x + ((column_index as u32 * scale))) + scale_x)
                                let y = ((start_y + ((row_index as u32 * scale))) + scale_y)
                                if ((x < width) && (y < height)):
                                    pixels[(((y * width) + x)) as usize] = color
                                    ()
                ()
                ()
            _ =>
                ()
                ()
        cursor_x = (cursor_x + (9 * scale))
        ()

fn fill_ellipse(pixels: &mut [[u8; 4]], width: u32, height: u32, center_x: f32, center_y: f32, radius_x: f32, radius_y: f32, color: [u8; 4]):
    for y in range(0, height):
        for x in range(0, width):
            let dx = ((((x as f32 + 0.5) - center_x)) / radius_x.max(f32__EPSILON))
            let dy = ((((y as f32 + 0.5) - center_y)) / radius_y.max(f32__EPSILON))
            if (((dx * dx) + (dy * dy)) <= 1):
                pixels[(((y * width) + x)) as usize] = color
                ()

