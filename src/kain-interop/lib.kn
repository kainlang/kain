use std::collections::HashMap

use std::sync::Arc

use std::sync::Once

use std::sync::RwLock

use kain_core::error::KainError

use kain_core::error::KainResult

use kain_core::runtime::register_env_extension

use kain_core::runtime::Env

use kain_core::runtime::Value

use kain_core::stdlib::register_stdlib_extension

use kain_core::stdlib::BuiltinFn

use kain_core::stdlib::StdLib

const INTEROP_EXTENSION_KEY: String = "kain.interop.shared"

pub const KAIN_SHARED_CONTRACT_VERSION: i64 = 1

const REGISTER: std::sync::Once = Once__new_()

@derive(Debug, Clone)
pub struct SharedBufferMetadata:
    element_type: String
    element_size: i64
    shape: Array<i64>
    strides: Array<i64>
    format: Option<String>
    mime_type: Option<String>
    source_runtime: String
    source_backend: Option<String>
    ownership: String
    labels: Array<String>

@derive(Debug, Clone)
pub struct SharedImageMetadata:
    representation: String
    width: i64
    height: i64
    channels: i64
    layout: String
    pixel_format: String
    mime_type: String
    row_stride: i64
    color_space: String
    alpha_mode: String
    source_runtime: String
    source_backend: Option<String>
    ownership: String
    labels: Array<String>

@derive(Clone)
pub struct KainSharedBuffer:
    metadata: SharedBufferMetadata
    bytes: std::sync::Arc<std::sync::RwLock<Array<u8>>>

@derive(Clone)
pub struct KainSharedImage:
    metadata: SharedImageMetadata
    buffer: std::sync::Arc<KainSharedBuffer>

pub enum GpuDescriptorKind:
    StorageBuffer
    UniformBuffer

impl GpuDescriptorKind:
    pub fn as_str(_self: GpuDescriptorKind) -> String:
        match _self:
            GpuDescriptorKind::StorageBuffer => "storage_buffer"
            GpuDescriptorKind::UniformBuffer => "uniform_buffer"


pub enum GpuBindingAccess:
    Read
    Write
    ReadWrite

impl GpuBindingAccess:
    pub fn as_str(_self: GpuBindingAccess) -> String:
        match _self:
            GpuBindingAccess::Read => "read"
            GpuBindingAccess::Write => "write"
            GpuBindingAccess::ReadWrite => "read_write"


@derive(Debug, Clone, PartialEq, Eq)
pub struct SharedBufferGpuBindingView:
    contract: String
    byte_length: usize
    element_type: String
    element_size: i64
    shape: Array<i64>
    strides: Array<i64>
    descriptor_kind: GpuDescriptorKind
    access: GpuBindingAccess

impl KainSharedBuffer:
    pub fn owned(metadata: SharedBufferMetadata, bytes: Array<u8>) -> std::sync::Arc<KainSharedBuffer>:
        Arc__new_(KainSharedBuffer { metadata: metadata, bytes: Arc__new_(RwLock__new_(bytes)) })

    pub fn replace_bytes(_self: &KainSharedBuffer, bytes: Array<u8>) -> Result<(), KainError>:
        let mut guard = (*_self).bytes.write().map_err(fn(_): KainError__runtime("failed to write shared buffer bytes"))?
        (*guard) = bytes
        ()
        Result::Ok(())

    pub fn bytes(_self: &KainSharedBuffer) -> Array<u8>:
        (*_self).bytes.read().unwrap().clone()

    pub fn byte_length(_self: &KainSharedBuffer) -> usize:
        (*_self).bytes.read().unwrap().len()


pub fn shared_buffer_gpu_binding_view(buffer: &KainSharedBuffer, descriptor_kind: GpuDescriptorKind, access: GpuBindingAccess) -> Result<SharedBufferGpuBindingView, KainError>:
    let byte_length = buffer.byte_length()
    let required = required_shared_buffer_byte_length(&(*buffer).metadata)?
    if ((required > 0) && (byte_length != required)):
        return Result::Err(KainError__runtime(f"shared buffer byte length mismatch for GPU binding: expected {required}, got {byte_length}"))
    if (none && (!none)):
        return Result::Err(KainError__runtime(("uniform-buffer GPU bindings must be read-only").to_string()))
    Result::Ok(SharedBufferGpuBindingView { contract: "kain.shared.buffer", byte_length: byte_length, element_type: (*buffer).metadata.element_type.clone(), element_size: (*buffer).metadata.element_size, shape: (*buffer).metadata.shape.clone(), strides: (*buffer).metadata.strides.clone(), descriptor_kind: descriptor_kind, access: access })

impl KainSharedImage:
    pub fn owned(metadata: SharedImageMetadata, bytes: Array<u8>) -> Result<std::sync::Arc<KainSharedImage>, KainError>:
        validate_shared_image_bytes(&metadata, bytes.len())?
        ()
        let shape = if ((metadata.representation == "raster") && (metadata.height > 0)):
            if (metadata.channels > 0):
                match metadata.layout.as_str():
                    "HWC" => [metadata.height, metadata.width, metadata.channels]
                    "CHW" => [metadata.channels, metadata.height, metadata.width]
                    _ => [metadata.height, metadata.width, metadata.channels]
            else:
                [metadata.height, metadata.width]
        else:
            [bytes.len() as i64]
        let strides = if ((metadata.representation == "raster") && (metadata.height > 0)):
            if (metadata.channels > 0):
                match metadata.layout.as_str():
                    "CHW" => [(metadata.height * metadata.width), metadata.width, 1]
                    _ => [(metadata.width * metadata.channels), metadata.channels, 1]
            else:
                [metadata.width, 1]
        else:
            [1]
        let buffer = KainSharedBuffer__owned(SharedBufferMetadata { element_type: ("u8").to_string(), element_size: 1, shape: shape, strides: strides, format: Option::Some(metadata.pixel_format.clone()), mime_type: Option::Some(metadata.mime_type.clone()), source_runtime: metadata.source_runtime.clone(), source_backend: metadata.source_backend.clone(), ownership: metadata.ownership.clone(), labels: metadata.labels.clone() }, bytes)
        Result::Ok(Arc__new_(KainSharedImage { metadata: metadata, buffer: buffer }))

    pub fn bytes(_self: &KainSharedImage) -> Array<u8>:
        (*_self).buffer.bytes()

    pub fn replace_bytes(_self: &KainSharedImage, bytes: Array<u8>) -> Result<(), KainError>:
        validate_shared_image_bytes(&(*_self).metadata, bytes.len())?
        ()
        (*_self).buffer.replace_bytes(bytes)


fn validate_shared_image_bytes(metadata: &SharedImageMetadata, byte_len: usize) -> Result<(), KainError>:
    if ((*metadata).representation == "raster"):
        let row_stride = if ((*metadata).row_stride > 0):
            (*metadata).row_stride as usize
        elif (((*metadata).width > 0) && ((*metadata).channels > 0)):
            (((*metadata).width * (*metadata).channels)) as usize
        else:
            0
        let expected = if (((*metadata).height > 0) && (row_stride > 0)):
            ((*metadata).height as usize * row_stride)
        else:
            0
        if ((expected > 0) && (byte_len != expected)):
            return Result::Err(KainError__runtime(f"kain_shared_image: raster byte length mismatch, expected {expected}, got {byte_len}"))
        ()
    Result::Ok(())

pub fn register_():
    REGISTER.call_once(fn(): none)
    ()

pub fn shared_buffer_value(buffer: std::sync::Arc<KainSharedBuffer>) -> kain_core::runtime::Value:
    Value__host_object("kain.shared.buffer", buffer)

pub fn shared_image_value(image: std::sync::Arc<KainSharedImage>) -> kain_core::runtime::Value:
    Value__host_object("kain.shared.image", image)

pub fn extract_shared_buffer(value: &kain_core::runtime::Value) -> Result<std::sync::Arc<KainSharedBuffer>, KainError>:
    value.downcast_host_object().ok_or_else(fn(): KainError__runtime("expected a Kain shared buffer"))

pub fn extract_shared_image(value: &kain_core::runtime::Value) -> Result<std::sync::Arc<KainSharedImage>, KainError>:
    value.downcast_host_object().ok_or_else(fn(): KainError__runtime("expected a Kain shared image"))

pub fn shared_buffer_info_value(buffer: &KainSharedBuffer) -> kain_core::runtime::Value:
    let mut fields = HashMap__new_()
    fields.insert(("contract").to_string(), kain_core__runtime__Value::String(("kain.shared.buffer").to_string()))
    ()
    fields.insert(("contract_version").to_string(), kain_core__runtime__Value::Int(KAIN_SHARED_CONTRACT_VERSION))
    ()
    fields.insert(("element_type").to_string(), kain_core__runtime__Value::String((*buffer).metadata.element_type.clone()))
    ()
    fields.insert(("element_size").to_string(), kain_core__runtime__Value::Int((*buffer).metadata.element_size))
    ()
    fields.insert(("shape").to_string(), int_list_to_value(&(*buffer).metadata.shape))
    ()
    fields.insert(("strides").to_string(), int_list_to_value(&(*buffer).metadata.strides))
    ()
    fields.insert(("format").to_string(), optional_string_to_value((*buffer).metadata.format.clone()))
    ()
    fields.insert(("mime_type").to_string(), optional_string_to_value((*buffer).metadata.mime_type.clone()))
    ()
    fields.insert(("source_runtime").to_string(), kain_core__runtime__Value::String((*buffer).metadata.source_runtime.clone()))
    ()
    fields.insert(("source_backend").to_string(), optional_string_to_value((*buffer).metadata.source_backend.clone()))
    ()
    fields.insert(("ownership").to_string(), kain_core__runtime__Value::String((*buffer).metadata.ownership.clone()))
    ()
    fields.insert(("labels").to_string(), string_list_to_value(&(*buffer).metadata.labels))
    ()
    fields.insert(("byte_length").to_string(), kain_core__runtime__Value::Int(buffer.byte_length() as i64))
    ()
    fields.insert(("element_count").to_string(), kain_core__runtime__Value::Int(element_count(&(*buffer).metadata.shape)))
    ()
    kain_core__runtime__Value::Struct(("KainSharedBufferInfo").to_string(), Arc__new_(RwLock__new_(fields)))

pub fn shared_image_info_value(image: &KainSharedImage) -> kain_core::runtime::Value:
    let mut fields = HashMap__new_()
    fields.insert(("contract").to_string(), kain_core__runtime__Value::String(("kain.shared.image").to_string()))
    ()
    fields.insert(("contract_version").to_string(), kain_core__runtime__Value::Int(KAIN_SHARED_CONTRACT_VERSION))
    ()
    fields.insert(("representation").to_string(), kain_core__runtime__Value::String((*image).metadata.representation.clone()))
    ()
    fields.insert(("width").to_string(), kain_core__runtime__Value::Int((*image).metadata.width))
    ()
    fields.insert(("height").to_string(), kain_core__runtime__Value::Int((*image).metadata.height))
    ()
    fields.insert(("channels").to_string(), kain_core__runtime__Value::Int((*image).metadata.channels))
    ()
    fields.insert(("layout").to_string(), kain_core__runtime__Value::String((*image).metadata.layout.clone()))
    ()
    fields.insert(("pixel_format").to_string(), kain_core__runtime__Value::String((*image).metadata.pixel_format.clone()))
    ()
    fields.insert(("mime_type").to_string(), kain_core__runtime__Value::String((*image).metadata.mime_type.clone()))
    ()
    fields.insert(("row_stride").to_string(), kain_core__runtime__Value::Int((*image).metadata.row_stride))
    ()
    fields.insert(("color_space").to_string(), kain_core__runtime__Value::String((*image).metadata.color_space.clone()))
    ()
    fields.insert(("alpha_mode").to_string(), kain_core__runtime__Value::String((*image).metadata.alpha_mode.clone()))
    ()
    fields.insert(("source_runtime").to_string(), kain_core__runtime__Value::String((*image).metadata.source_runtime.clone()))
    ()
    fields.insert(("source_backend").to_string(), optional_string_to_value((*image).metadata.source_backend.clone()))
    ()
    fields.insert(("ownership").to_string(), kain_core__runtime__Value::String((*image).metadata.ownership.clone()))
    ()
    fields.insert(("labels").to_string(), string_list_to_value(&(*image).metadata.labels))
    ()
    fields.insert(("byte_length").to_string(), kain_core__runtime__Value::Int((*image).buffer.byte_length() as i64))
    ()
    kain_core__runtime__Value::Struct(("KainSharedImageInfo").to_string(), Arc__new_(RwLock__new_(fields)))

fn register_interop_stdlib(stdlib: &mut kain_core::stdlib::StdLib):
    for builtin in [kain_core::stdlib::BuiltinFn { name: "kain_shared_buffer_info", params: [("target", "Any")], return_type: "Any", doc: "Inspect a neutral Kain shared buffer contract" }, kain_core::stdlib::BuiltinFn { name: "kain_shared_buffer_bytes", params: [("target", "Any")], return_type: "Any", doc: "Snapshot the bytes behind a neutral Kain shared buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_shared_buffer_from_bytes", params: [("bytes", "Any"), ("element_type", "String"), ("shape", "Any"), ("format", "String"), ("mime_type", "String")], return_type: "Any", doc: "Create a neutral Kain shared buffer from raw bytes" }, kain_core::stdlib::BuiltinFn { name: "kain_shared_buffer_replace_bytes", params: [("target", "Any"), ("bytes", "Any")], return_type: "Unit", doc: "Replace the bytes behind a neutral Kain shared buffer" }, kain_core::stdlib::BuiltinFn { name: "kain_shared_image_info", params: [("target", "Any")], return_type: "Any", doc: "Inspect a neutral Kain shared image contract" }, kain_core::stdlib::BuiltinFn { name: "kain_shared_image_bytes", params: [("target", "Any")], return_type: "Any", doc: "Snapshot the bytes behind a neutral Kain shared image" }, kain_core::stdlib::BuiltinFn { name: "kain_shared_image_from_bytes", params: [("bytes", "Any"), ("width", "Int"), ("height", "Int"), ("channels", "Int"), ("layout", "String"), ("pixel_format", "String"), ("mime_type", "String")], return_type: "Any", doc: "Create a neutral Kain shared raster image from bytes" }, kain_core::stdlib::BuiltinFn { name: "kain_shared_image_replace_bytes", params: [("target", "Any"), ("bytes", "Any")], return_type: "Unit", doc: "Replace the bytes behind a neutral Kain shared image" }]:
        (*stdlib).functions.insert(builtin.name.to_string(), kain_core_builtin_stub(builtin))
        ()

fn register_interop_env(env: &mut kain_core::runtime::Env):
    env.register_native_fn("kain_shared_buffer_info", builtin_shared_buffer_info)
    ()
    env.register_native_fn("kain_shared_buffer_bytes", builtin_shared_buffer_bytes)
    ()
    env.register_native_fn("kain_shared_buffer_from_bytes", builtin_shared_buffer_from_bytes)
    ()
    env.register_native_fn("kain_shared_buffer_replace_bytes", builtin_shared_buffer_replace_bytes)
    ()
    env.register_native_fn("kain_shared_image_info", builtin_shared_image_info)
    ()
    env.register_native_fn("kain_shared_image_bytes", builtin_shared_image_bytes)
    ()
    env.register_native_fn("kain_shared_image_from_bytes", builtin_shared_image_from_bytes)
    ()
    env.register_native_fn("kain_shared_image_replace_bytes", builtin_shared_image_replace_bytes)
    ()

fn builtin_shared_buffer_info(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 1):
        return Result::Err(KainError__runtime("kain_shared_buffer_info: expected 1 argument (target)"))
    let buffer = extract_shared_buffer(&args[0])?
    Result::Ok(shared_buffer_info_value(&buffer))

fn builtin_shared_buffer_bytes(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 1):
        return Result::Err(KainError__runtime("kain_shared_buffer_bytes: expected 1 argument (target)"))
    let buffer = extract_shared_buffer(&args[0])?
    Result::Ok(bytes_to_value(&buffer.bytes()))

fn builtin_shared_buffer_from_bytes(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 5):
        return Result::Err(KainError__runtime("kain_shared_buffer_from_bytes: expected (bytes, element_type, shape, format, mime_type)"))
    let bytes = value_to_bytes("kain_shared_buffer_from_bytes", &args[0])?
    let element_type = value_to_string_arg("kain_shared_buffer_from_bytes", "element_type", &args[1])?
    let shape = value_to_int_list("kain_shared_buffer_from_bytes", "shape", &args[2])?
    let format = value_to_string_arg("kain_shared_buffer_from_bytes", "format", &args[3])?
    let mime_type = value_to_string_arg("kain_shared_buffer_from_bytes", "mime_type", &args[4])?
    let metadata = SharedBufferMetadata { element_size: element_size_for(&element_type)?, element_type: element_type, strides: compact_strides(&shape), shape: shape, format: if format.is_empty(): none else: Option::Some(format), mime_type: if mime_type.is_empty(): none else: Option::Some(mime_type), source_runtime: ("kain").to_string(), source_backend: none, ownership: ("owned").to_string(), labels: [("kain").to_string(), ("buffer").to_string()] }
    Result::Ok(shared_buffer_value(KainSharedBuffer__owned(metadata, bytes)))

fn builtin_shared_buffer_replace_bytes(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 2):
        return Result::Err(KainError__runtime("kain_shared_buffer_replace_bytes: expected (target, bytes)"))
    let buffer = extract_shared_buffer(&args[0])?
    let bytes = value_to_bytes("kain_shared_buffer_replace_bytes", &args[1])?
    buffer.replace_bytes(bytes)?
    ()
    Result::Ok(kain_core__runtime__Value__Unit)

fn builtin_shared_image_info(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 1):
        return Result::Err(KainError__runtime("kain_shared_image_info: expected 1 argument (target)"))
    let image = extract_shared_image(&args[0])?
    Result::Ok(shared_image_info_value(&image))

fn builtin_shared_image_bytes(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 1):
        return Result::Err(KainError__runtime("kain_shared_image_bytes: expected 1 argument (target)"))
    let image = extract_shared_image(&args[0])?
    Result::Ok(bytes_to_value(&image.bytes()))

fn builtin_shared_image_from_bytes(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 7):
        return Result::Err(KainError__runtime("kain_shared_image_from_bytes: expected (bytes, width, height, channels, layout, pixel_format, mime_type)"))
    let bytes = value_to_bytes("kain_shared_image_from_bytes", &args[0])?
    let width = value_to_int_arg("kain_shared_image_from_bytes", "width", &args[1])?
    let height = value_to_int_arg("kain_shared_image_from_bytes", "height", &args[2])?
    let channels = value_to_int_arg("kain_shared_image_from_bytes", "channels", &args[3])?
    let layout = value_to_string_arg("kain_shared_image_from_bytes", "layout", &args[4])?
    let pixel_format = value_to_string_arg("kain_shared_image_from_bytes", "pixel_format", &args[5])?
    let mime_type = value_to_string_arg("kain_shared_image_from_bytes", "mime_type", &args[6])?
    let row_stride = if ((width > 0) && (channels > 0)):
        (width * channels)
    else:
        0
    let image = KainSharedImage__owned(SharedImageMetadata { representation: ("raster").to_string(), width: width, height: height, channels: channels, layout: layout, pixel_format: pixel_format, mime_type: mime_type, row_stride: row_stride, color_space: ("srgb").to_string(), alpha_mode: if (channels == 4): ("straight").to_string() else: ("opaque").to_string(), source_runtime: ("kain").to_string(), source_backend: none, ownership: ("owned").to_string(), labels: [("kain").to_string(), ("image").to_string()] }, bytes)?
    Result::Ok(shared_image_value(image))

fn builtin_shared_image_replace_bytes(_env: &mut kain_core::runtime::Env, args: Array<kain_core::runtime::Value>) -> Result<kain_core::runtime::Value, KainError>:
    if (args.len() != 2):
        return Result::Err(KainError__runtime("kain_shared_image_replace_bytes: expected (target, bytes)"))
    let image = extract_shared_image(&args[0])?
    let bytes = value_to_bytes("kain_shared_image_replace_bytes", &args[1])?
    image.replace_bytes(bytes)?
    ()
    Result::Ok(kain_core__runtime__Value__Unit)

fn int_list_to_value(values: &[i64]) -> kain_core::runtime::Value:
    kain_core__runtime__Value::Array(Arc__new_(RwLock__new_(values.iter().copied().map(kain_core__runtime__Value__Int).collect())))

fn string_list_to_value(values: &[String]) -> kain_core::runtime::Value:
    kain_core__runtime__Value::Array(Arc__new_(RwLock__new_(values.iter().cloned().map(kain_core__runtime__Value__String).collect())))

fn optional_string_to_value(value: Option<String>) -> kain_core::runtime::Value:
    match value:
        Some(value) => kain_core__runtime__Value::String(value)
        None => kain_core__runtime__Value__None

fn bytes_to_value(bytes: &[u8]) -> kain_core::runtime::Value:
    kain_core__runtime__Value::Array(Arc__new_(RwLock__new_(bytes.iter().map(fn(value): kain_core__runtime__Value::Int((*value) as i64)).collect())))

fn value_to_bytes(fn_name: String, value: &kain_core::runtime::Value) -> Result<Array<u8>, KainError>:
    let kain_core__runtime__Value::Array(values) = value
    let values = values.read().unwrap()
    let mut bytes = (fn(__kain_ctor_arg0): Vec__new_())(values.len())
    for selfhost_for_item in values.iter().enumerate():
        let (index, value) = selfhost_for_item
        let kain_core__runtime__Value::Int(value) = value
        let byte = u8__try_from((*value)).map_err(fn(_): KainError__runtime(f"{fn_name}: byte {index} value {value} is outside u8 range"))?
        bytes.push(byte)
        ()
    ()
    Result::Ok(bytes)

fn value_to_int_list(fn_name: String, label: String, value: &kain_core::runtime::Value) -> Result<Array<i64>, KainError>:
    let kain_core__runtime__Value::Array(values) = value
    let values = values.read().unwrap()
    let mut result = (fn(__kain_ctor_arg0): Vec__new_())(values.len())
    for entry in values.iter():
        let kain_core__runtime__Value::Int(value) = entry
        result.push((*value))
        ()
    ()
    Result::Ok(result)

fn value_to_int_arg(fn_name: String, label: String, value: &kain_core::runtime::Value) -> Result<i64, KainError>:
    match value:
        kain_core__runtime__Value::Int(value) => Result::Ok((*value))
        other => Result::Err(KainError__runtime(f"{fn_name}: {label} must be Int, got {other}"))

fn value_to_string_arg(fn_name: String, label: String, value: &kain_core::runtime::Value) -> Result<String, KainError>:
    match value:
        kain_core__runtime__Value::String(value) => Result::Ok(value.clone())
        other => Result::Err(KainError__runtime(f"{fn_name}: {label} must be String, got {other}"))

fn compact_strides(shape: &[i64]) -> Array<i64>:
    if shape.is_empty():
        return [1]
    let mut strides = []
    let mut stride = 1
    for selfhost_for_item in shape.iter().enumerate().rev():
        let (index, dim) = selfhost_for_item
        strides[index] = stride
        ()
        stride = (stride * ((*dim)).max(1))
        ()
    ()
    strides

fn element_count(shape: &[i64]) -> i64:
    if shape.is_empty():
        0
    else:
        shape.iter().copied().product()

fn element_size_for(element_type: String) -> Result<i64, KainError>:
    match element_type:
        "bool" => Result::Ok(1)
        "u8" => Result::Ok(1)
        "uint8" => Result::Ok(1)
        "i8" => Result::Ok(1)
        "int8" => Result::Ok(1)
        "u16" => Result::Ok(2)
        "uint16" => Result::Ok(2)
        "i16" => Result::Ok(2)
        "int16" => Result::Ok(2)
        "u32" => Result::Ok(4)
        "uint32" => Result::Ok(4)
        "i32" => Result::Ok(4)
        "int32" => Result::Ok(4)
        "f32" => Result::Ok(4)
        "float32" => Result::Ok(4)
        "u64" => Result::Ok(8)
        "uint64" => Result::Ok(8)
        "i64" => Result::Ok(8)
        "int64" => Result::Ok(8)
        "f64" => Result::Ok(8)
        "float64" => Result::Ok(8)
        other => Result::Err(KainError__runtime(f"Unsupported shared element type: {other}"))

fn required_shared_buffer_byte_length(metadata: &SharedBufferMetadata) -> Result<usize, KainError>:
    if ((*metadata).element_size <= 0):
        return Result::Err(KainError__runtime(("shared buffer metadata must declare a positive element_size").to_string()))
    if (*metadata).shape.iter().any(fn(dim): ((*dim) < 0)):
        return Result::Err(KainError__runtime(("shared buffer shape dimensions must be non-negative").to_string()))
    let element_count = element_count(&(*metadata).shape)
    if (element_count < 0):
        return Result::Err(KainError__runtime(("shared buffer element_count must be non-negative").to_string()))
    let required = element_count.checked_mul((*metadata).element_size).ok_or_else(fn(): KainError__runtime(("shared buffer byte length overflow").to_string()))?
    usize__try_from(required).map_err(fn(_): KainError__runtime(("shared buffer byte length does not fit usize").to_string()))

fn kain_core_builtin_stub(builtin: kain_core::stdlib::BuiltinFn) -> kain_core::stdlib::BuiltinFn:
    builtin

