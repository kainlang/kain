use serde::Deserialize

use serde::Serialize

@doc(doc = " Complete runtime graph definition")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RuntimeGraph:
    name: String
    node_types: Array<RuntimeNodeData>
    instance_def: RuntimeInstance
    properties: RuntimeGraphProperties

@doc(doc = " Runtime node data definition")
@doc(doc = " Generates: UMyNodeData : public UObject")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RuntimeNodeData:
    name: String
    category: String
    properties: Array<RuntimeProperty>
    input_pins: Array<RuntimePin>
    output_pins: Array<RuntimePin>
    execute_logic: Option<ExecuteLogic>
    color: Option<[f32; 4]>
    icon: Option<String>
    tooltip: Option<String>

@doc(doc = " Runtime graph instance definition")
@doc(doc = " Generates: UMyGraphInstance : public UObject")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RuntimeInstance:
    name: String
    state_fields: Array<RuntimeProperty>
    methods: Array<RuntimeMethod>
    is_replicated: Bool
    is_savegame: Bool

@doc(doc = " Runtime pin definition")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RuntimePin:
    name: String
    pin_type: RuntimePinType
    is_array: Bool
    default_value: Option<String>
    tooltip: Option<String>
    direction: PinDirection

pub enum PinDirection:
    Input
    Output

pub enum RuntimePinType:
    Exec
    Bool
    Int
    Int64
    Float
    String
    Name
    Text
    Vector
    Rotator
    Transform
    Color
    Object(String)
    Struct(String)
    Enum(String)
    Wildcard

@doc(doc = " Runtime property definition")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RuntimeProperty:
    name: String
    property_type: RuntimePinType
    is_array: Bool
    default_value: Option<String>
    specifiers: Array<PropertySpecifier>
    tooltip: Option<String>

pub enum PropertySpecifier:
    EditAnywhere
    EditDefaultsOnly
    VisibleAnywhere
    BlueprintReadOnly
    BlueprintReadWrite
    Replicated
    SaveGame
    Transient
    Category(String)

@doc(doc = " Runtime method definition")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RuntimeMethod:
    name: String
    params: Array<RuntimeParam>
    return_type: Option<RuntimePinType>
    body: String
    specifiers: Array<FunctionSpecifier>

@doc(doc = " Runtime method parameter")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RuntimeParam:
    name: String
    param_type: RuntimePinType
    is_array: Bool

pub enum FunctionSpecifier:
    BlueprintCallable
    BlueprintPure
    BlueprintNativeEvent
    Category(String)

pub enum ExecuteLogic:
    CppCode(String)
    KainExpr(String)
    BlueprintFunction(String)

@doc(doc = " Runtime graph properties")
@derive(Debug, Clone, serde__Serialize, serde__Deserialize)
pub struct RuntimeGraphProperties:
    allow_parallel_execution: Bool
    max_execution_depth: i32
    enable_debug_logging: Bool
    execution_mode: ExecutionMode

pub enum ExecutionMode:
    Sequential
    Parallel
    EventDriven

impl Default for RuntimeGraphProperties:
    fn default_() -> RuntimeGraphProperties:
        RuntimeGraphProperties { allow_parallel_execution: false, max_execution_depth: 100, enable_debug_logging: false, execution_mode: ExecutionMode__Sequential }


impl RuntimeGraph:
    pub fn new_(name: impl Into<String>) -> RuntimeGraph:
        let name_str = name.into()
        let instance_name = f"{name_str}Instance"
        RuntimeGraph { name: name_str, node_types: Vec__new_(), instance_def: RuntimeInstance__new_(instance_name), properties: RuntimeGraphProperties__default_() }

    pub fn add_node_type(_self: &mut RuntimeGraph, node_type: RuntimeNodeData):
        (*_self).node_types.push(node_type)
        ()

    pub fn find_node_type(_self: &RuntimeGraph, name: String) -> Option<&RuntimeNodeData>:
        (*_self).node_types.iter().find(fn(nt): (nt.name == name))


impl RuntimeInstance:
    pub fn new_(name: impl Into<String>) -> RuntimeInstance:
        RuntimeInstance { name: name.into(), state_fields: Vec__new_(), methods: Vec__new_(), is_replicated: false, is_savegame: false }

    pub fn add_state_field(_self: &mut RuntimeInstance, field: RuntimeProperty):
        (*_self).state_fields.push(field)
        ()

    pub fn add_method(_self: &mut RuntimeInstance, method: RuntimeMethod):
        (*_self).methods.push(method)
        ()


impl RuntimeNodeData:
    pub fn new_(name: impl Into<String>, category: impl Into<String>) -> RuntimeNodeData:
        RuntimeNodeData { name: name.into(), category: category.into(), properties: Vec__new_(), input_pins: Vec__new_(), output_pins: Vec__new_(), execute_logic: none, color: none, icon: none, tooltip: none }

    pub fn add_input_pin(_self: &mut RuntimeNodeData, pin: RuntimePin):
        (*_self).input_pins.push(pin)
        ()

    pub fn add_output_pin(_self: &mut RuntimeNodeData, pin: RuntimePin):
        (*_self).output_pins.push(pin)
        ()

    pub fn add_property(_self: &mut RuntimeNodeData, property: RuntimeProperty):
        (*_self).properties.push(property)
        ()


impl RuntimePin:
    pub fn input(name: impl Into<String>, pin_type: RuntimePinType) -> RuntimePin:
        RuntimePin { name: name.into(), pin_type: pin_type, is_array: false, default_value: none, tooltip: none, direction: PinDirection__Input }

    pub fn output(name: impl Into<String>, pin_type: RuntimePinType) -> RuntimePin:
        RuntimePin { name: name.into(), pin_type: pin_type, is_array: false, default_value: none, tooltip: none, direction: PinDirection__Output }

    pub fn as_array(_self: RuntimePin) -> RuntimePin:
        _self.is_array = true
        ()
        _self

    pub fn with_default(_self: RuntimePin, default_: impl Into<String>) -> RuntimePin:
        _self.default_value = Option::Some(default_.into())
        ()
        _self

    pub fn with_tooltip(_self: RuntimePin, tooltip: impl Into<String>) -> RuntimePin:
        _self.tooltip = Option::Some(tooltip.into())
        ()
        _self


