use crate::GraphEditor

use crate::NodeType

use crate::PinDefinition

use crate::PinType

use crate::Result

@doc(doc = " Output structure for factory generation")
@derive(Debug, Clone)
pub struct FactoryOutput:
    base_node_header: (String, String)
    base_node_source: (String, String)
    node_headers: Array<(String, String)>
    node_sources: Array<(String, String)>
    schema_header: (String, String)
    schema_source: (String, String)
    graph_header: (String, String)
    graph_source: (String, String)

pub struct FactoryGenerator:
    plugin_name: String
    graph: GraphEditor

impl FactoryGenerator:
    pub fn new_(graph: GraphEditor, plugin_name: impl Into<String>) -> FactoryGenerator:
        FactoryGenerator { plugin_name: plugin_name.into(), graph: graph }

    pub fn generate(_self: &FactoryGenerator) -> Result<FactoryOutput, Error>:
        let mut node_headers = Vec__new_()
        let mut node_sources = Vec__new_()
        let base_node_header = (*_self).generate_base_node_header()?
        let base_node_source = (*_self).generate_base_node_source()?
        for node_type in &(*_self).graph.node_types:
            let (header, source) = (*_self).generate_node_class(node_type)?
            let node_name = f"{(*_self).graph.name}{node_type.name}Node"
            node_headers.push((f"{node_name}.h", header))
            ()
            node_sources.push((f"{node_name}.cpp", source))
            ()
        ()
        let schema_header = (*_self).generate_schema_header()?
        let schema_source = (*_self).generate_schema_source()?
        let graph_header = (*_self).generate_graph_header()?
        let graph_source = (*_self).generate_graph_source()?
        Result::Ok(FactoryOutput { base_node_header: (f"{(*_self).graph.name}NodeBase.h", base_node_header), base_node_source: (f"{(*_self).graph.name}NodeBase.cpp", base_node_source), node_headers: node_headers, node_sources: node_sources, schema_header: (f"{(*_self).graph.name}Schema.h", schema_header), schema_source: (f"{(*_self).graph.name}Schema.cpp", schema_source), graph_header: (f"{(*_self).graph.name}.h", graph_header), graph_source: (f"{(*_self).graph.name}.cpp", graph_source) })

    fn generate_base_node_header(_self: &FactoryGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}NodeBase"
        let mut lines = Vec__new_()
        lines.push("#pragma once")
        ()
        lines.push(String__new_())
        ()
        lines.push("#include \"CoreMinimal.h\"")
        ()
        lines.push("#include \"EdGraph/EdGraphNode.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}NodeBase.generated.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push("UCLASS()")
        ()
        lines.push(f"class {class_name} : public UEdGraphNode")
        ()
        lines.push("{")
        ()
        lines.push("\tGENERATED_BODY()")
        ()
        lines.push(String__new_())
        ()
        lines.push("public:")
        ()
        lines.push(f"\t{class_name}();")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// UEdGraphNode interface")
        ()
        lines.push("\tvirtual void GetNodeContextMenuActions(UToolMenu* Menu, UGraphNodeContextMenuContext* Context) const override;")
        ()
        lines.push("\tvirtual bool CanCreateUnderSpecifiedSchema(const UEdGraphSchema* Schema) const override;")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Pin color (can be overridden by subclasses)")
        ()
        lines.push("\tvirtual FLinearColor GetPinColor() const;")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Helper for creating custom pins")
        ()
        lines.push("\tUEdGraphPin* CreateCustomPin(EEdGraphPinDirection Direction, FName Name, FName Subcategory = NAME_None);")
        ()
        lines.push("};")
        ()
        Result::Ok(lines.join("\n"))

    fn generate_base_node_source(_self: &FactoryGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}NodeBase"
        let schema_class = f"U{(*_self).graph.name}Schema"
        let mut lines = Vec__new_()
        lines.push(f"#include \"{(*_self).graph.name}NodeBase.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}Schema.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"{class_name}::{class_name}()")
        ()
        lines.push("{")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"void {class_name}::GetNodeContextMenuActions(UToolMenu* Menu, UGraphNodeContextMenuContext* Context) const")
        ()
        lines.push("{")
        ()
        lines.push("\tSuper::GetNodeContextMenuActions(Menu, Context);")
        ()
        lines.push("\t// Context menu entries are optional and module-dependent.")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"bool {class_name}::CanCreateUnderSpecifiedSchema(const UEdGraphSchema* Schema) const")
        ()
        lines.push("{")
        ()
        lines.push(f"\treturn Schema->IsA<{schema_class}>();")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"FLinearColor {class_name}::GetPinColor() const")
        ()
        lines.push("{")
        ()
        lines.push("\treturn FLinearColor::Gray;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"UEdGraphPin* {class_name}::CreateCustomPin(EEdGraphPinDirection Direction, FName Name, FName Subcategory)")
        ()
        lines.push("{")
        ()
        lines.push("\tFName Category = (Direction == EEdGraphPinDirection::EGPD_Input) ? TEXT(\"Inputs\") : TEXT(\"Outputs\");")
        ()
        lines.push(String__new_())
        ()
        lines.push("\tUEdGraphPin* Pin = CreatePin(Direction, Category, Name);")
        ()
        lines.push("\tif (Subcategory != NAME_None)")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\tPin->PinType.PinSubCategory = Subcategory;")
        ()
        lines.push("\t}")
        ()
        lines.push(String__new_())
        ()
        lines.push("\treturn Pin;")
        ()
        lines.push("}")
        ()
        Result::Ok(lines.join("\n"))

    fn generate_node_class(_self: &FactoryGenerator, node: &NodeType) -> Result<(String, String), Error>:
        let header = (*_self).generate_node_header(node)?
        let source = (*_self).generate_node_source(node)?
        Result::Ok((header, source))

    fn generate_node_header(_self: &FactoryGenerator, node: &NodeType) -> Result<String, Error>:
        let node_stem = f"{(*_self).graph.name}{(*node).name}Node"
        let class_name = f"U{node_stem}"
        let base_class = f"U{(*_self).graph.name}NodeBase"
        let mut lines = Vec__new_()
        lines.push("#pragma once")
        ()
        lines.push(String__new_())
        ()
        lines.push("#include \"CoreMinimal.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}NodeBase.h\"")
        ()
        lines.push(f"#include \"{node_stem}.generated.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push("UCLASS()")
        ()
        lines.push(f"class {class_name} : public {base_class}")
        ()
        lines.push("{")
        ()
        lines.push("\tGENERATED_BODY()")
        ()
        lines.push(String__new_())
        ()
        lines.push("public:")
        ()
        lines.push("\t// UEdGraphNode interface")
        ()
        lines.push("\tvirtual FText GetNodeTitle(ENodeTitleType::Type TitleType) const override;")
        ()
        lines.push("\tvirtual FLinearColor GetNodeTitleColor() const override;")
        ()
        lines.push("\tvirtual void AllocateDefaultPins() override;")
        ()
        lines.push("\tvirtual FText GetTooltipText() const override;")
        ()
        if (!(*node).category.is_empty()):
            lines.push("\tvirtual FText GetMenuCategory() const;")
            ()
            ()
            ()
            ()
        lines.push(String__new_())
        ()
        lines.push("\t// Pin color")
        ()
        lines.push("\tvirtual FLinearColor GetPinColor() const override;")
        ()
        lines.push("};")
        ()
        Result::Ok(lines.join("\n"))

    fn generate_node_source(_self: &FactoryGenerator, node: &NodeType) -> Result<String, Error>:
        let node_stem = f"{(*_self).graph.name}{(*node).name}Node"
        let class_name = f"U{node_stem}"
        let node_title = (*node).name.clone()
        let mut lines = Vec__new_()
        lines.push(f"#include \"{node_stem}.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"#define LOCTEXT_NAMESPACE \"{(*_self).graph.name}Schema\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"FText {class_name}::GetNodeTitle(ENodeTitleType::Type TitleType) const")
        ()
        lines.push("{")
        ()
        lines.push(f"\treturn LOCTEXT(\"Node.{(*node).name}.Title\", \"{node_title}\");")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        let color = (*node).color.unwrap_or([0.5, 0.5, 0.5, 1])
        lines.push(f"FLinearColor {class_name}::GetNodeTitleColor() const")
        ()
        lines.push("{")
        ()
        lines.push(f"\treturn FLinearColor({color[0]}f, {color[1]}f, {color[2]}f, {color[3]}f);")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"void {class_name}::AllocateDefaultPins()")
        ()
        lines.push("{")
        ()
        for input in &(*node).inputs:
            let pin_code = (*_self).generate_pin_creation(input, "EGPD_Input")
            lines.push(f"\t{pin_code}")
            ()
        ()
        for output in &(*node).outputs:
            let pin_code = (*_self).generate_pin_creation(output, "EGPD_Output")
            lines.push(f"\t{pin_code}")
            ()
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"FText {class_name}::GetTooltipText() const")
        ()
        lines.push("{")
        ()
        match &(*node).tooltip:
            Some(tooltip) =>
                lines.push(f"\treturn LOCTEXT(\"Node.{(*node).name}.Tooltip\", \"{tooltip}\");")
                ()
                ()
                ()
                ()
            _ =>
                lines.push("\treturn FText::GetEmpty();")
                ()
                ()
                ()
                ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        if (!(*node).category.is_empty()):
            lines.push(f"FText {class_name}::GetMenuCategory() const")
            ()
            lines.push("{")
            ()
            lines.push(f"\treturn LOCTEXT(\"Node.{(*node).name}.Category\", \"{(*node).category}\");")
            ()
            lines.push("}")
            ()
            lines.push(String__new_())
            ()
            ()
            ()
            ()
        lines.push(f"FLinearColor {class_name}::GetPinColor() const")
        ()
        lines.push("{")
        ()
        lines.push("\treturn FLinearColor::Gray;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push("#undef LOCTEXT_NAMESPACE")
        ()
        Result::Ok(lines.join("\n"))

    fn generate_pin_creation(_self: &FactoryGenerator, pin: &PinDefinition, direction: String) -> String:
        let pin_category = (*_self).pin_type_to_category(&(*pin).pin_type)
        let pin_name = &(*pin).name
        f"CreatePin(EEdGraphPinDirection::{direction}, FName(\"{pin_category}\"), FName(\"{pin_name}\"));"

    fn pin_type_to_category(_self: &FactoryGenerator, pin_type: &PinType) -> String:
        match pin_type:
            PinType::Exec => ("exec").to_string()
            PinType::Bool => ("bool").to_string()
            PinType::Int => ("int").to_string()
            PinType::Float => ("float").to_string()
            PinType::String => ("string").to_string()
            PinType::Object(class_) => f"object:{class_}"
            PinType::Struct(name) => f"struct:{name}"
            PinType::Enum(name) => f"enum:{name}"
            PinType::Wildcard => ("wildcard").to_string()

    fn generate_schema_header(_self: &FactoryGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}Schema"
        let mut lines = Vec__new_()
        lines.push("#pragma once")
        ()
        lines.push(String__new_())
        ()
        lines.push("#include \"CoreMinimal.h\"")
        ()
        lines.push("#include \"EdGraph/EdGraphSchema.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}Schema.generated.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push("UCLASS()")
        ()
        lines.push(f"class {class_name} : public UEdGraphSchema")
        ()
        lines.push("{")
        ()
        lines.push("\tGENERATED_BODY()")
        ()
        lines.push(String__new_())
        ()
        lines.push("public:")
        ()
        lines.push(f"\t{class_name}();")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// UEdGraphSchema interface")
        ()
        lines.push("\tvirtual void GetGraphContextActions(FGraphContextMenuBuilder& ContextMenuBuilder) const override;")
        ()
        lines.push("\tvirtual const FPinConnectionResponse CanCreateConnection(const UEdGraphPin* PinA, const UEdGraphPin* PinB) const override;")
        ()
        lines.push("\tvirtual void CreateDefaultNodesForGraph(UEdGraph& Graph) const override;")
        ()
        lines.push("\tvirtual void BreakNodeLinks(UEdGraphNode& TargetNode) const override;")
        ()
        lines.push("\tvirtual void BreakPinLinks(UEdGraphPin& TargetPin, bool bSendsNodeNotification) const override;")
        ()
        lines.push("\tvirtual void BreakSinglePinLink(UEdGraphPin* SourcePin, UEdGraphPin* TargetPin) const override;")
        ()
        lines.push("};")
        ()
        Result::Ok(lines.join("\n"))

    fn generate_schema_source(_self: &FactoryGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}Schema"
        let mut lines = Vec__new_()
        lines.push(f"#include \"{(*_self).graph.name}Schema.h\"")
        ()
        for node_type in &(*_self).graph.node_types:
            lines.push(f"#include \"{(*_self).graph.name}{node_type.name}Node.h\"")
            ()
        ()
        lines.push(String__new_())
        ()
        lines.push(f"#define LOCTEXT_NAMESPACE \"{(*_self).graph.name}Schema\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"{class_name}::{class_name}()")
        ()
        lines.push("{")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"void {class_name}::GetGraphContextActions(FGraphContextMenuBuilder& ContextMenuBuilder) const")
        ()
        lines.push("{")
        ()
        lines.push("\t// TODO: Add context menu actions for node creation")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"const FPinConnectionResponse {class_name}::CanCreateConnection(const UEdGraphPin* PinA, const UEdGraphPin* PinB) const")
        ()
        lines.push("{")
        ()
        lines.push("\tif (PinA == nullptr || PinB == nullptr)")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\treturn FPinConnectionResponse(CONNECT_RESPONSE_DISALLOW, LOCTEXT(\"Pin.NullPin\", \"One or both pins are null\"));")
        ()
        lines.push("\t}")
        ()
        lines.push(String__new_())
        ()
        lines.push("\tif (PinA->GetOwningNode() == PinB->GetOwningNode())")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\treturn FPinConnectionResponse(CONNECT_RESPONSE_DISALLOW, LOCTEXT(\"Pin.SameNode\", \"Both are on the same node\"));")
        ()
        lines.push("\t}")
        ()
        lines.push(String__new_())
        ()
        lines.push("\tif (PinA->Direction == PinB->Direction)")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\treturn FPinConnectionResponse(CONNECT_RESPONSE_DISALLOW, LOCTEXT(\"Pin.WrongDirection\", \"Wrong pin direction\"));")
        ()
        lines.push("\t}")
        ()
        lines.push(String__new_())
        ()
        if (!(*_self).graph.schema.allowed_connections.is_empty()):
            lines.push("\t// Check connection rules")
            ()
            lines.push("\t// TODO: Implement connection validation based on pin types")
            ()
            ()
            ()
            ()
        lines.push("\treturn FPinConnectionResponse(CONNECT_RESPONSE_BREAK_OTHERS_A, LOCTEXT(\"Pin.Connect\", \"Make connection\"));")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"void {class_name}::CreateDefaultNodesForGraph(UEdGraph& Graph) const")
        ()
        lines.push("{")
        ()
        lines.push("\t// Create default nodes if needed")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"void {class_name}::BreakNodeLinks(UEdGraphNode& TargetNode) const")
        ()
        lines.push("{")
        ()
        lines.push("\tconst FScopedTransaction Transaction(NSLOCTEXT(\"UnrealEd\", \"GraphEd_BreakNodeLinks\", \"Break Node Links\"));")
        ()
        lines.push("\tSuper::BreakNodeLinks(TargetNode);")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"void {class_name}::BreakPinLinks(UEdGraphPin& TargetPin, bool bSendsNodeNotification) const")
        ()
        lines.push("{")
        ()
        lines.push("\tconst FScopedTransaction Transaction(NSLOCTEXT(\"UnrealEd\", \"GraphEd_BreakPinLinks\", \"Break Pin Links\"));")
        ()
        lines.push("\tSuper::BreakPinLinks(TargetPin, bSendsNodeNotification);")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"void {class_name}::BreakSinglePinLink(UEdGraphPin* SourcePin, UEdGraphPin* TargetPin) const")
        ()
        lines.push("{")
        ()
        lines.push("\tconst FScopedTransaction Transaction(NSLOCTEXT(\"UnrealEd\", \"GraphEd_BreakSinglePinLink\", \"Break Pin Link\"));")
        ()
        lines.push("\tSuper::BreakSinglePinLink(SourcePin, TargetPin);")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push("#undef LOCTEXT_NAMESPACE")
        ()
        Result::Ok(lines.join("\n"))

    fn generate_graph_header(_self: &FactoryGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}"
        let mut lines = Vec__new_()
        lines.push("#pragma once")
        ()
        lines.push(String__new_())
        ()
        lines.push("#include \"CoreMinimal.h\"")
        ()
        lines.push("#include \"EdGraph/EdGraph.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}.generated.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push("UCLASS()")
        ()
        lines.push(f"class {class_name} : public UEdGraph")
        ()
        lines.push("{")
        ()
        lines.push("\tGENERATED_BODY()")
        ()
        lines.push(String__new_())
        ()
        lines.push("public:")
        ()
        lines.push(f"\t{class_name}();")
        ()
        lines.push("};")
        ()
        Result::Ok(lines.join("\n"))

    fn generate_graph_source(_self: &FactoryGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}"
        let mut lines = Vec__new_()
        lines.push(f"#include \"{(*_self).graph.name}.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}Schema.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"{class_name}::{class_name}()")
        ()
        lines.push("{")
        ()
        lines.push(f"\tSchema = U{(*_self).graph.name}Schema::StaticClass();")
        ()
        lines.push("}")
        ()
        Result::Ok(lines.join("\n"))


@doc(doc = " Public API function for generating factory code")
pub fn generate_graph_factory(graph: &GraphEditor, plugin_name: String) -> Result<FactoryOutput, Error>:
    let generator = FactoryGenerator__new_(graph.clone(), plugin_name)
    generator.generate()

