use crate::ConnectionRule

use crate::GraphSchema

use crate::PinType

pub struct SchemaBuilder:
    schema: GraphSchema

impl SchemaBuilder:
    pub fn new_() -> SchemaBuilder:
        SchemaBuilder { schema: GraphSchema__default_() }

    pub fn allow_connection(_self: SchemaBuilder, from: PinType, to: PinType) -> SchemaBuilder:
        _self.schema.allowed_connections.push(ConnectionRule { from: from, to: to, allowed: true, error_message: none })
        ()
        _self

    pub fn disallow_connection(_self: SchemaBuilder, from: PinType, to: PinType, error_message: impl Into<String>) -> SchemaBuilder:
        _self.schema.allowed_connections.push(ConnectionRule { from: from, to: to, allowed: false, error_message: Option::Some(error_message.into()) })
        ()
        _self

    pub fn build(_self: SchemaBuilder) -> GraphSchema:
        _self.schema


impl Default for SchemaBuilder:
    fn default_() -> SchemaBuilder:
        SchemaBuilder__new_()


