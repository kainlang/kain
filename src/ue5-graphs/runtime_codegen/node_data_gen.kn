use crate::GraphEditor

use crate::NodeType

use crate::PinType

use crate::Result

@doc(doc = " Output structure for NodeData generation")
@derive(Debug, Clone)
pub struct NodeDataOutput:
    base_header: (String, String)
    base_source: (String, String)
    pin_data_header: (String, String)
    pin_data_source: (String, String)
    node_data_headers: Array<(String, String)>
    node_data_sources: Array<(String, String)>

pub struct NodeDataGenerator:
    plugin_name: String
    graph: GraphEditor

impl NodeDataGenerator:
    pub fn new_(graph: &GraphEditor, plugin_name: impl Into<String>) -> NodeDataGenerator:
        NodeDataGenerator { plugin_name: plugin_name.into(), graph: graph.clone() }

    pub fn generate(_self: &NodeDataGenerator) -> Result<NodeDataOutput, Error>:
        let mut node_data_headers = Vec__new_()
        let mut node_data_sources = Vec__new_()
        let pin_data_header = (*_self).generate_pin_data_header()?
        let pin_data_source = (*_self).generate_pin_data_source()?
        let base_header = (*_self).generate_base_node_data_header()?
        let base_source = (*_self).generate_base_node_data_source()?
        for node_type in &(*_self).graph.node_types:
            let (header, source) = (*_self).generate_node_data_subclass(node_type)?
            let class_name = f"{node_type.name}NodeData"
            node_data_headers.push((f"{class_name}.h", header))
            ()
            node_data_sources.push((f"{class_name}.cpp", source))
            ()
        ()
        Result::Ok(NodeDataOutput { base_header: (f"{(*_self).graph.name}GraphNodeData.h", base_header), base_source: (f"{(*_self).graph.name}GraphNodeData.cpp", base_source), pin_data_header: (f"{(*_self).graph.name}PinData.h", pin_data_header), pin_data_source: (f"{(*_self).graph.name}PinData.cpp", pin_data_source), node_data_headers: node_data_headers, node_data_sources: node_data_sources })

    pub fn generate_pin_data_header(_self: &NodeDataGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}PinData"
        let api_macro = f"{(*_self).plugin_name.to_uppercase()}_API"
        let mut lines = Vec__new_()
        lines.push(("// Generated by KAIN compiler").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("#pragma once").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("#include \"CoreMinimal.h\"").to_string())
        ()
        lines.push(("#include \"UObject/NoExportTypes.h\"").to_string())
        ()
        lines.push(f"#include \"{(*_self).graph.name}PinData.generated.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push("class {f\"U{(*_self).graph.name}GraphNodeData\"};")
        ()
        lines.push(String__new_())
        ()
        lines.push(("UCLASS()").to_string())
        ()
        lines.push(f"class {api_macro} {class_name}")
        ()
        lines.push(("\t: public UObject").to_string())
        ()
        lines.push(("{").to_string())
        ()
        lines.push(("\tGENERATED_BODY()").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("public:").to_string())
        ()
        lines.push(("\tUPROPERTY()").to_string())
        ()
        lines.push(("\tFName PinName;").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("\tUPROPERTY()").to_string())
        ()
        lines.push(("\tFGuid PinId;").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("\tUPROPERTY()").to_string())
        ()
        lines.push(f"\tTArray<{class_name}*> ConnectToPins;")
        ()
        lines.push(String__new_())
        ()
        lines.push(("\tUPROPERTY()").to_string())
        ()
        lines.push(f"\tU{(*_self).graph.name}GraphNodeData* Parent = nullptr;")
        ()
        lines.push(("};").to_string())
        ()
        Result::Ok(lines.join("\n"))

    fn generate_pin_data_source(_self: &NodeDataGenerator) -> Result<String, Error>:
        let mut lines = Vec__new_()
        lines.push(("// Generated by KAIN compiler").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(f"#include \"{(*_self).graph.name}PinData.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}GraphNodeData.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(("// PinData implementation (empty - all logic in header)").to_string())
        ()
        Result::Ok(lines.join("\n"))

    pub fn generate_base_node_data_header(_self: &NodeDataGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}GraphNodeData"
        let pin_class = f"U{(*_self).graph.name}PinData"
        let instance_class = f"U{(*_self).graph.name}Instance"
        let api_macro = f"{(*_self).plugin_name.to_uppercase()}_API"
        let mut lines = Vec__new_()
        lines.push(("// Generated by KAIN compiler").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("#pragma once").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("#include \"CoreMinimal.h\"").to_string())
        ()
        lines.push(("#include \"UObject/NoExportTypes.h\"").to_string())
        ()
        lines.push(f"#include \"{(*_self).graph.name}GraphNodeData.generated.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"class {instance_class};")
        ()
        lines.push(f"class {pin_class};")
        ()
        lines.push(String__new_())
        ()
        lines.push(("UCLASS()").to_string())
        ()
        lines.push(f"class {api_macro} {class_name}")
        ()
        lines.push(("\t: public UObject").to_string())
        ()
        lines.push(("{").to_string())
        ()
        lines.push(("\tGENERATED_BODY()").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("public:").to_string())
        ()
        lines.push(("\tUPROPERTY()").to_string())
        ()
        lines.push(f"\tTArray<{pin_class}*> InputPins;")
        ()
        lines.push(String__new_())
        ()
        lines.push(("\tUPROPERTY()").to_string())
        ()
        lines.push(f"\tTArray<{pin_class}*> OutputPins;")
        ()
        lines.push(String__new_())
        ()
        lines.push(("\tUPROPERTY()").to_string())
        ()
        lines.push(("\tFIntPoint NodePosition;").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("\tUPROPERTY()").to_string())
        ()
        lines.push(("\tFGuid NodeGuid;").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("public:").to_string())
        ()
        lines.push(("\t/// Get the next node connected to the specified output pin index").to_string())
        ()
        lines.push(f"\t{class_name}* GetNextOutputNodeByPinIndex(int OutputPinIndex) const;")
        ()
        lines.push(String__new_())
        ()
        lines.push(("\t/// Execute this node and return the next node to execute").to_string())
        ()
        lines.push(f"\tvirtual const {class_name}* ExecuteNode({instance_class}* Instance) const;")
        ()
        lines.push(("};").to_string())
        ()
        Result::Ok(lines.join("\n"))

    pub fn generate_base_node_data_source(_self: &NodeDataGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}GraphNodeData"
        let pin_class = f"U{(*_self).graph.name}PinData"
        let instance_class = f"U{(*_self).graph.name}Instance"
        let mut lines = Vec__new_()
        lines.push(("// Generated by KAIN compiler").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(f"#include \"{(*_self).graph.name}GraphNodeData.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}PinData.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"{class_name}* {class_name}::GetNextOutputNodeByPinIndex(int OutputPinIndex) const")
        ()
        lines.push(("{").to_string())
        ()
        lines.push(("\tif (!OutputPins.IsValidIndex(OutputPinIndex))").to_string())
        ()
        lines.push(("\t{").to_string())
        ()
        lines.push(("\t\treturn nullptr;").to_string())
        ()
        lines.push(("\t}").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(f"\t{pin_class}* OutputPin = OutputPins[OutputPinIndex];")
        ()
        lines.push(("\tif (!IsValid(OutputPin) || OutputPin->ConnectToPins.Num() == 0)").to_string())
        ()
        lines.push(("\t{").to_string())
        ()
        lines.push(("\t\treturn nullptr;").to_string())
        ()
        lines.push(("\t}").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("\t// Get the first connected pin's parent node").to_string())
        ()
        lines.push(f"\t{pin_class}* ConnectedPin = OutputPin->ConnectToPins[0];")
        ()
        lines.push(("\tif (!IsValid(ConnectedPin))").to_string())
        ()
        lines.push(("\t{").to_string())
        ()
        lines.push(("\t\treturn nullptr;").to_string())
        ()
        lines.push(("\t}").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("\treturn ConnectedPin->Parent;").to_string())
        ()
        lines.push(("}").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(f"const {class_name}* {class_name}::ExecuteNode({instance_class}* Instance) const")
        ()
        lines.push(("{").to_string())
        ()
        lines.push(("\t// Base implementation - return next node via first output pin").to_string())
        ()
        lines.push(("\treturn GetNextOutputNodeByPinIndex(0);").to_string())
        ()
        lines.push(("}").to_string())
        ()
        Result::Ok(lines.join("\n"))

    pub fn generate_node_data_subclass(_self: &NodeDataGenerator, node: &NodeType) -> Result<(String, String), Error>:
        let header = (*_self).generate_node_data_subclass_header(node)?
        let source = (*_self).generate_node_data_subclass_source(node)?
        Result::Ok((header, source))

    pub fn generate_node_data_subclass_header(_self: &NodeDataGenerator, node: &NodeType) -> Result<String, Error>:
        let class_name = f"U{(*node).name}NodeData"
        let base_class = f"U{(*_self).graph.name}GraphNodeData"
        let instance_class = f"U{(*_self).graph.name}Instance"
        let api_macro = f"{(*_self).plugin_name.to_uppercase()}_API"
        let mut lines = Vec__new_()
        lines.push(("// Generated by KAIN compiler").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("#pragma once").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(("#include \"CoreMinimal.h\"").to_string())
        ()
        lines.push(f"#include \"{(*_self).graph.name}GraphNodeData.h\"")
        ()
        for input in &(*node).inputs:
            match (*_self).get_type_include(&input.pin_type):
                Some(include) =>
                    if (!lines.iter().any(fn(l): l.contains(&include))):
                        lines.push(f"#include \"{include}\"")
                        ()
                _ => ()
        ()
        lines.push(f"#include \"{(*node).name}NodeData.generated.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"class {instance_class};")
        ()
        lines.push(String__new_())
        ()
        lines.push(("UCLASS()").to_string())
        ()
        lines.push(f"class {api_macro} {class_name}")
        ()
        lines.push(f"\t: public {base_class}")
        ()
        lines.push(("{").to_string())
        ()
        lines.push(("\tGENERATED_BODY()").to_string())
        ()
        lines.push(String__new_())
        ()
        if (*_self).has_node_properties(node):
            lines.push(("public:").to_string())
            ()
            for input in &(*node).inputs:
                if (input.pin_type != PinType__Exec):
                    let prop_type = (*_self).pin_type_to_cpp_type(&input.pin_type)
                    let prop_name = (*_self).sanitize_property_name(&input.name)
                    let specifiers = ["EditAnywhere", "BlueprintReadOnly"]
                    let category = "Category = \"Node Data\""
                    lines.push("\tUPROPERTY({specifiers.join(\", \")}, {category})")
                    ()
                    if input.is_array:
                        lines.push(f"\tTArray<{prop_type}> {prop_name};")
                        ()
                        ()
                        ()
                        ()
                    else:
                        lines.push(f"\t{prop_type} {prop_name};")
                        ()
                        ()
                        ()
                        ()
                    match &input.tooltip:
                        Some(tooltip) =>
                            lines.insert((lines.len() - 2), f"\t/** {tooltip} */")
                            ()
                            ()
                            ()
                            ()
                        _ =>
                            ()
                            ()
                    lines.push(String__new_())
                    ()
            ()
            ()
        lines.push(("public:").to_string())
        ()
        lines.push(("\t/// Execute this node and return the next node to execute").to_string())
        ()
        lines.push(f"\tvirtual const {base_class}* ExecuteNode({instance_class}* Instance) const override;")
        ()
        lines.push(String__new_())
        ()
        lines.push(("\t/// Validate node data before execution").to_string())
        ()
        lines.push(("\tUFUNCTION(BlueprintCallable, Category = \"Node Validation\")").to_string())
        ()
        lines.push(("\tvirtual bool ValidateNode() const;").to_string())
        ()
        lines.push(("};").to_string())
        ()
        Result::Ok(lines.join("\n"))

    fn get_type_include(_self: &NodeDataGenerator, pin_type: &PinType) -> Option<String>:
        match pin_type:
            PinType::Object(class_name) =>
                if class_name.starts_with("A"):
                    Option::Some(f"GameFramework/{&class_name[1..]}.h")
                elif class_name.starts_with("U"):
                    Option::Some(f"Components/{&class_name[1..]}.h")
                else:
                    none
            PinType::Struct(struct_name) =>
                match struct_name.as_str():
                    "Vector" => Option::Some(("Math/Vector.h").to_string())
                    "Rotator" => Option::Some(("Math/Rotator.h").to_string())
                    "Transform" => Option::Some(("Math/Transform.h").to_string())
                    "Color" => Option::Some(("Math/Color.h").to_string())
                    _ => none
            _ => none

    pub fn generate_node_data_subclass_source(_self: &NodeDataGenerator, node: &NodeType) -> Result<String, Error>:
        let class_name = f"U{(*node).name}NodeData"
        let base_class = f"U{(*_self).graph.name}GraphNodeData"
        let instance_class = f"U{(*_self).graph.name}Instance"
        let mut lines = Vec__new_()
        lines.push(("// Generated by KAIN compiler").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(f"#include \"{(*node).name}NodeData.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}Instance.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"const {base_class}* {class_name}::ExecuteNode({instance_class}* Instance) const")
        ()
        lines.push(("{").to_string())
        ()
        lines.push(("\tif (!IsValid(Instance))").to_string())
        ()
        lines.push(("\t{").to_string())
        ()
        lines.push(("\t\treturn nullptr;").to_string())
        ()
        lines.push(("\t}").to_string())
        ()
        lines.push(String__new_())
        ()
        match &(*node).execution_logic:
            Some(logic) =>
                lines.push(("\t// Custom execution logic").to_string())
                ()
                lines.push(f"\t// {logic}")
                ()
                lines.push(String__new_())
                ()
                let logic_lines = (*_self).generate_execution_logic(node, logic)
                for line_ in logic_lines:
                    lines.push(f"\t{line_}")
                    ()
                ()
                ()
            _ =>
                lines.push(("\t// Default execution - pass through to next node").to_string())
                ()
                ()
                ()
                ()
        lines.push(String__new_())
        ()
        if ((*node).outputs.len() > 1):
            lines.push(("\t// Select output pin based on execution result").to_string())
            ()
            lines.push(("\t// Default: use first output pin").to_string())
            ()
            lines.push(("\tint32 OutputPinIndex = 0;").to_string())
            ()
            lines.push(String__new_())
            ()
            ()
            ()
            ()
        lines.push(("\t// Return next node via output pin").to_string())
        ()
        if ((*node).outputs.len() > 1):
            lines.push(("\treturn GetNextOutputNodeByPinIndex(OutputPinIndex);").to_string())
            ()
            ()
            ()
            ()
        else:
            lines.push(("\treturn GetNextOutputNodeByPinIndex(0);").to_string())
            ()
            ()
            ()
            ()
        lines.push(("}").to_string())
        ()
        lines.push(String__new_())
        ()
        lines.push(f"bool {class_name}::ValidateNode() const")
        ()
        lines.push(("{").to_string())
        ()
        lines.push(("\t// Validate that all required properties are set").to_string())
        ()
        lines.push(String__new_())
        ()
        let mut has_validation = false
        for input in &(*node).inputs:
            if (input.pin_type != PinType__Exec):
                let prop_name = (*_self).sanitize_property_name(&input.name)
                match &input.pin_type:
                    PinType::Object(_) =>
                        lines.push(f"\tif (!IsValid({prop_name}))")
                        ()
                        lines.push(("\t{").to_string())
                        ()
                        lines.push(f"\t\tUE_LOG(LogTemp, Warning, TEXT(\"{(*node).name}NodeData: {prop_name} is not valid\"));")
                        ()
                        lines.push(("\t\treturn false;").to_string())
                        ()
                        lines.push(("\t}").to_string())
                        ()
                        lines.push(String__new_())
                        ()
                        has_validation = true
                        ()
                    PinType::String =>
                        if input.default_value.is_none():
                            lines.push(f"\tif ({prop_name}.IsEmpty())")
                            ()
                            lines.push(("\t{").to_string())
                            ()
                            lines.push(f"\t\tUE_LOG(LogTemp, Warning, TEXT(\"{(*node).name}NodeData: {prop_name} is empty\"));")
                            ()
                            lines.push(("\t\treturn false;").to_string())
                            ()
                            lines.push(("\t}").to_string())
                            ()
                            lines.push(String__new_())
                            ()
                            has_validation = true
                            ()
                    _ => ()
        ()
        if (!has_validation):
            lines.push(("\t// No validation required for this node").to_string())
            ()
            ()
            ()
            ()
        lines.push(("\treturn true;").to_string())
        ()
        lines.push(("}").to_string())
        ()
        Result::Ok(lines.join("\n"))

    fn generate_execution_logic(_self: &NodeDataGenerator, _node: &NodeType, logic: String) -> Array<String>:
        let mut lines = Vec__new_()
        lines.push(("// TODO: Implement custom execution logic").to_string())
        ()
        lines.push(f"// Logic: {logic}")
        ()
        if (logic.contains("condition") || logic.contains("branch")):
            lines.push(String__new_())
            ()
            lines.push(("// Example: Branch based on condition").to_string())
            ()
            lines.push(("// if (Condition)").to_string())
            ()
            lines.push(("// {").to_string())
            ()
            lines.push(("//     OutputPinIndex = 0; // True branch").to_string())
            ()
            lines.push(("// }").to_string())
            ()
            lines.push(("// else").to_string())
            ()
            lines.push(("// {").to_string())
            ()
            lines.push(("//     OutputPinIndex = 1; // False branch").to_string())
            ()
            lines.push(("// }").to_string())
            ()
            ()
            ()
            ()
        lines

    pub fn has_node_properties(_self: &NodeDataGenerator, node: &NodeType) -> Bool:
        (*node).inputs.iter().any(fn(pin): (pin.pin_type != PinType__Exec))

    pub fn pin_type_to_cpp_type(_self: &NodeDataGenerator, pin_type: &PinType) -> String:
        match pin_type:
            PinType::Exec => ("void").to_string()
            PinType::Bool => ("bool").to_string()
            PinType::Int => ("int32").to_string()
            PinType::Float => ("float").to_string()
            PinType::String => ("FString").to_string()
            PinType::Object(class_) => if (class_.is_empty() || (class_ == "*")): ("UObject*").to_string() else: f"{class_}*"
            PinType::Struct(name) =>
                match name.as_str():
                    "Vector" => ("FVector").to_string()
                    "Rotator" => ("FRotator").to_string()
                    "Transform" => ("FTransform").to_string()
                    "Color" => ("FLinearColor").to_string()
                    _ => if name.starts_with("F"): name.clone() else: f"F{name}"
            PinType::Enum(name) => if name.starts_with("E"): name.clone() else: f"E{name}"
            PinType::Wildcard => ("UObject*").to_string()

    pub fn sanitize_property_name(_self: &NodeDataGenerator, name: String) -> String:
        let mut result = String__new_()
        let mut capitalize_next = true
        for ch in name.chars():
            if ch.is_alphanumeric():
                if capitalize_next:
                    result.push(ch.to_ascii_uppercase())
                    ()
                    capitalize_next = false
                    ()
                else:
                    result.push(ch)
                    ()
            else:
                capitalize_next = true
                ()
        ()
        if result.chars().next().map_or(false, fn(c): c.is_numeric()):
            result.insert(0, "_")
            ()
            ()
            ()
            ()
        result


@doc(doc = " Public API function for generating NodeData classes")
pub fn generate_node_data(graph: &GraphEditor, plugin_name: String) -> Result<NodeDataOutput, Error>:
    let generator = NodeDataGenerator__new_(graph, plugin_name)
    generator.generate()

