use crate::GraphEditor

use crate::Result

@doc(doc = " Output structure for instance generation")
@derive(Debug, Clone)
pub struct InstanceOutput:
    instance_header: (String, String)
    instance_source: (String, String)
    node_data_header: (String, String)
    node_data_source: (String, String)

pub struct InstanceGenerator:
    plugin_name: String
    graph: GraphEditor

impl InstanceGenerator:
    pub fn new_(graph: &GraphEditor, plugin_name: impl Into<String>) -> InstanceGenerator:
        InstanceGenerator { plugin_name: plugin_name.into(), graph: graph.clone() }

    pub fn generate(_self: &InstanceGenerator) -> Result<InstanceOutput, Error>:
        let instance_header = (*_self).generate_instance_header()?
        let instance_source = (*_self).generate_instance_source()?
        let node_data_header = (*_self).generate_node_data_header()?
        let node_data_source = (*_self).generate_node_data_source()?
        Result::Ok(InstanceOutput { instance_header: (f"{(*_self).graph.name}Instance.h", instance_header), instance_source: (f"{(*_self).graph.name}Instance.cpp", instance_source), node_data_header: (f"{(*_self).graph.name}GraphNodeData.h", node_data_header), node_data_source: (f"{(*_self).graph.name}GraphNodeData.cpp", node_data_source) })

    pub fn generate_instance_header(_self: &InstanceGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}Instance"
        let node_data_class = f"U{(*_self).graph.name}GraphNodeData"
        let asset_class = f"U{(*_self).graph.name}GraphAsset"
        let mut lines = Vec__new_()
        lines.push("#pragma once")
        ()
        lines.push(String__new_())
        ()
        lines.push("#include \"CoreMinimal.h\"")
        ()
        lines.push("#include \"UObject/Object.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}Instance.generated.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"class {asset_class};")
        ()
        lines.push(f"class {node_data_class};")
        ()
        lines.push(String__new_())
        ()
        lines.push("UENUM(BlueprintType)")
        ()
        lines.push(f"enum class E{(*_self).graph.name}ResetReason : uint8")
        ()
        lines.push("{")
        ()
        lines.push("\tRETRY,")
        ()
        lines.push("\tRESET,")
        ()
        lines.push("\tEND_GRAPH,")
        ()
        lines.push("\tCOUNT,")
        ()
        lines.push("};")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam(F{(*_self).graph.name}InstanceResetDelegate, E{(*_self).graph.name}ResetReason, ResetReason);")
        ()
        lines.push(String__new_())
        ()
        lines.push("UCLASS(Abstract)")
        ()
        lines.push(f"class {(*_self).plugin_name.to_uppercase()}_API {class_name} : public UObject")
        ()
        lines.push("{")
        ()
        lines.push("\tGENERATED_BODY()")
        ()
        lines.push(String__new_())
        ()
        lines.push("public:")
        ()
        lines.push("\t// Instance lifecycle")
        ()
        lines.push(f"\tUFUNCTION(BlueprintCallable, Category = \"{(*_self).graph.name}|Instance\")")
        ()
        lines.push(f"\tvirtual bool ResetInstance(E{(*_self).graph.name}ResetReason ResetReason = E{(*_self).graph.name}ResetReason::RESET);")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"\tUFUNCTION(BlueprintPure, Category = \"{(*_self).graph.name}|Instance\")")
        ()
        lines.push("\tvirtual bool IsValidInstance() const;")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"\tUFUNCTION(BlueprintPure, Category = \"{(*_self).graph.name}|Instance\")")
        ()
        lines.push(f"\tconst {asset_class}* GetGraphAsset() const;")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Node access")
        ()
        lines.push(f"\tUFUNCTION(BlueprintPure, Category = \"{(*_self).graph.name}|Instance\")")
        ()
        lines.push(f"\tconst {node_data_class}* GetCurrentNode() const;")
        ()
        lines.push(String__new_())
        ()
        lines.push("protected:")
        ()
        lines.push("\t// Construction and destruction")
        ()
        lines.push(f"\tvirtual bool ConstructInstance({asset_class}* InGraphAsset);")
        ()
        lines.push("\tvirtual void BeginDestroy() override;")
        ()
        lines.push("\tvirtual void SetInstanceActive(bool bActive);")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Graph traversal")
        ()
        lines.push("\tvirtual bool TryProceedGraph();")
        ()
        lines.push(f"\tvirtual bool SetCurrentNode(const {node_data_class}* ToNode);")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Blueprint events")
        ()
        lines.push(f"\tUFUNCTION(BlueprintNativeEvent, Category = \"{(*_self).graph.name}|Instance\")")
        ()
        lines.push("\tbool IsProceedBlocked() const;")
        ()
        lines.push(String__new_())
        ()
        lines.push("protected:")
        ()
        lines.push("\t// Delegates")
        ()
        lines.push("\tUPROPERTY(BlueprintAssignable)")
        ()
        lines.push(f"\tF{(*_self).graph.name}InstanceResetDelegate OnInstanceReset;")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// State flags")
        ()
        lines.push(f"\tUPROPERTY(Transient, BlueprintReadOnly, Category = \"{(*_self).graph.name}|Instance\")")
        ()
        lines.push("\tuint8 bInstanceActive : 1;")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"\tUPROPERTY(Transient, BlueprintReadOnly, Category = \"{(*_self).graph.name}|Instance\")")
        ()
        lines.push("\tuint8 bNeedProceed : 1;")
        ()
        lines.push(String__new_())
        ()
        lines.push("private:")
        ()
        lines.push("\t// Graph asset reference")
        ()
        lines.push("\tUPROPERTY()")
        ()
        lines.push(f"\t{asset_class}* GraphAsset;")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Current node tracking")
        ()
        lines.push(f"\tTWeakObjectPtr<const {node_data_class}> CurrentNode;")
        ()
        lines.push("};")
        ()
        Result::Ok(lines.join("\n"))

    pub fn generate_instance_source(_self: &InstanceGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}Instance"
        let node_data_class = f"U{(*_self).graph.name}GraphNodeData"
        let asset_class = f"U{(*_self).graph.name}GraphAsset"
        let mut lines = Vec__new_()
        lines.push(f"#include \"{(*_self).graph.name}Instance.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}GraphNodeData.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}GraphAsset.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"bool {class_name}::ResetInstance(E{(*_self).graph.name}ResetReason ResetReason)")
        ()
        lines.push("{")
        ()
        lines.push("\tif (!IsValidInstance())")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\treturn false;")
        ()
        lines.push("\t}")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Reset to root node")
        ()
        lines.push("\tCurrentNode = nullptr;")
        ()
        lines.push("\tbNeedProceed = false;")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Broadcast reset event")
        ()
        lines.push("\tOnInstanceReset.Broadcast(ResetReason);")
        ()
        lines.push(String__new_())
        ()
        lines.push("\treturn true;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"bool {class_name}::IsValidInstance() const")
        ()
        lines.push("{")
        ()
        lines.push("\treturn GraphAsset != nullptr && bInstanceActive;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"const {asset_class}* {class_name}::GetGraphAsset() const")
        ()
        lines.push("{")
        ()
        lines.push("\treturn GraphAsset;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"const {node_data_class}* {class_name}::GetCurrentNode() const")
        ()
        lines.push("{")
        ()
        lines.push("\treturn CurrentNode.Get();")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"bool {class_name}::ConstructInstance({asset_class}* InGraphAsset)")
        ()
        lines.push("{")
        ()
        lines.push("\tif (InGraphAsset == nullptr)")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\treturn false;")
        ()
        lines.push("\t}")
        ()
        lines.push(String__new_())
        ()
        lines.push("\tGraphAsset = InGraphAsset;")
        ()
        lines.push("\tbInstanceActive = false;")
        ()
        lines.push("\tbNeedProceed = false;")
        ()
        lines.push(String__new_())
        ()
        lines.push("\treturn true;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"void {class_name}::BeginDestroy()")
        ()
        lines.push("{")
        ()
        lines.push("\tSuper::BeginDestroy();")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Clean up references")
        ()
        lines.push("\tCurrentNode = nullptr;")
        ()
        lines.push("\tGraphAsset = nullptr;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"void {class_name}::SetInstanceActive(bool bActive)")
        ()
        lines.push("{")
        ()
        lines.push("\tbInstanceActive = bActive;")
        ()
        lines.push(String__new_())
        ()
        lines.push("\tif (!bActive)")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\t// Reset state when deactivating")
        ()
        lines.push("\t\tCurrentNode = nullptr;")
        ()
        lines.push("\t\tbNeedProceed = false;")
        ()
        lines.push("\t}")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"bool {class_name}::TryProceedGraph()")
        ()
        lines.push("{")
        ()
        lines.push("\tif (!IsValidInstance())")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\treturn false;")
        ()
        lines.push("\t}")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Check if proceed is blocked")
        ()
        lines.push("\tif (IsProceedBlocked())")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\treturn false;")
        ()
        lines.push("\t}")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// TODO: Implement graph traversal logic")
        ()
        lines.push("\t// This should find the next node based on current node and connections")
        ()
        lines.push(String__new_())
        ()
        lines.push("\tbNeedProceed = false;")
        ()
        lines.push("\treturn true;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"bool {class_name}::SetCurrentNode(const {node_data_class}* ToNode)")
        ()
        lines.push("{")
        ()
        lines.push("\tif (!IsValidInstance())")
        ()
        lines.push("\t{")
        ()
        lines.push("\t\treturn false;")
        ()
        lines.push("\t}")
        ()
        lines.push(String__new_())
        ()
        lines.push("\tCurrentNode = ToNode;")
        ()
        lines.push("\treturn true;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"bool {class_name}::IsProceedBlocked_Implementation() const")
        ()
        lines.push("{")
        ()
        lines.push("\t// Default: never blocked")
        ()
        lines.push("\t// Override in Blueprint or C++ subclass for custom logic")
        ()
        lines.push("\treturn false;")
        ()
        lines.push("}")
        ()
        Result::Ok(lines.join("\n"))

    pub fn generate_node_data_header(_self: &InstanceGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}GraphNodeData"
        let mut lines = Vec__new_()
        lines.push("#pragma once")
        ()
        lines.push(String__new_())
        ()
        lines.push("#include \"CoreMinimal.h\"")
        ()
        lines.push("#include \"UObject/Object.h\"")
        ()
        lines.push(f"#include \"{(*_self).graph.name}GraphNodeData.generated.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push("UCLASS(Abstract)")
        ()
        lines.push(f"class {(*_self).plugin_name.to_uppercase()}_API {class_name} : public UObject")
        ()
        lines.push("{")
        ()
        lines.push("\tGENERATED_BODY()")
        ()
        lines.push(String__new_())
        ()
        lines.push("public:")
        ()
        lines.push("\t// Node identification")
        ()
        lines.push(f"\tUFUNCTION(BlueprintPure, Category = \"{(*_self).graph.name}|NodeData\")")
        ()
        lines.push("\tvirtual FName GetNodeName() const;")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"\tUFUNCTION(BlueprintPure, Category = \"{(*_self).graph.name}|NodeData\")")
        ()
        lines.push("\tvirtual FText GetNodeDisplayName() const;")
        ()
        lines.push(String__new_())
        ()
        lines.push("protected:")
        ()
        lines.push("\t// Node name")
        ()
        lines.push(f"\tUPROPERTY(EditDefaultsOnly, BlueprintReadOnly, Category = \"{(*_self).graph.name}|NodeData\")")
        ()
        lines.push("\tFName NodeName;")
        ()
        lines.push(String__new_())
        ()
        lines.push("\t// Display name")
        ()
        lines.push(f"\tUPROPERTY(EditDefaultsOnly, BlueprintReadOnly, Category = \"{(*_self).graph.name}|NodeData\")")
        ()
        lines.push("\tFText DisplayName;")
        ()
        lines.push("};")
        ()
        Result::Ok(lines.join("\n"))

    pub fn generate_node_data_source(_self: &InstanceGenerator) -> Result<String, Error>:
        let class_name = f"U{(*_self).graph.name}GraphNodeData"
        let mut lines = Vec__new_()
        lines.push(f"#include \"{(*_self).graph.name}GraphNodeData.h\"")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"FName {class_name}::GetNodeName() const")
        ()
        lines.push("{")
        ()
        lines.push("\treturn NodeName;")
        ()
        lines.push("}")
        ()
        lines.push(String__new_())
        ()
        lines.push(f"FText {class_name}::GetNodeDisplayName() const")
        ()
        lines.push("{")
        ()
        lines.push("\treturn DisplayName.IsEmpty() ? FText::FromName(NodeName) : DisplayName;")
        ()
        lines.push("}")
        ()
        Result::Ok(lines.join("\n"))


@doc(doc = " Public API function for generating instance code")
pub fn generate_graph_instance(graph: &GraphEditor, plugin_name: String) -> Result<InstanceOutput, Error>:
    let generator = InstanceGenerator__new_(graph, plugin_name)
    generator.generate()

