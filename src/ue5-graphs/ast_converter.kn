use crate::graph_ir::*

use crate::GraphError

use crate::Result

use kain_core::ast::Attribute

use kain_core::ast::Expr

use kain_core::ast::GraphEditorDef

use kain_core::ast::GraphSchemaDef

use kain_core::ast::NodeTypeDef

use kain_core::ast::PinDef

use kain_core::ast::Type

use std::collections::HashMap

@doc(doc = " Converts KAIN AST graph editor definitions to GraphEditor IR")
pub struct GraphEditorConverter:
    properties: GraphProperties

impl GraphEditorConverter:
    pub fn new_() -> GraphEditorConverter:
        GraphEditorConverter { properties: GraphProperties__default_() }

    pub fn convert(_self: &mut GraphEditorConverter, def: &kain_core::ast::GraphEditorDef) -> Result<GraphEditor, Error>:
        let mut graph = GraphEditor__new_((*def).name.clone())
        graph.properties = (*_self).extract_properties(&(*def).attributes)?
        ()
        for node_type_def in &(*def).node_types:
            let node_type = (*_self).convert_node_type(node_type_def)?
            graph.add_node_type(node_type)
            ()
        ()
        match &(*def).schema:
            Some(schema_def) =>
                graph.schema = (*_self).convert_schema(schema_def)?
                ()
                ()
                ()
                ()
            _ =>
                graph.schema = GraphSchema__default_()
                ()
                ()
                ()
                ()
        (*_self).validate_graph(&graph)?
        ()
        Result::Ok(graph)

    fn extract_properties(_self: &GraphEditorConverter, attributes: &[kain_core::ast::Attribute]) -> Result<GraphProperties, Error>:
        let mut props = GraphProperties__default_()
        for attr in attributes:
            match attr.name.as_str():
                "allow_multiple_inputs" =>
                    props.allow_multiple_input_connections = (*_self).extract_bool_arg(&attr.args, 0)?
                    ()
                "allow_multiple_outputs" =>
                    props.allow_multiple_output_connections = (*_self).extract_bool_arg(&attr.args, 0)?
                    ()
                "allow_cycles" =>
                    props.allow_cycles = (*_self).extract_bool_arg(&attr.args, 0)?
                    ()
                "grid_snap" =>
                    props.grid_snap_size = (*_self).extract_int_arg(&attr.args, 0)?
                    ()
                _ => ()
        ()
        Result::Ok(props)

    fn convert_node_type(_self: &GraphEditorConverter, def: &kain_core::ast::NodeTypeDef) -> Result<NodeType, Error>:
        let mut node_type = NodeType { name: (*def).name.clone(), category: (*def).category.clone().unwrap_or_else(fn(): ("Default").to_string()), inputs: Vec__new_(), outputs: Vec__new_(), properties: Vec__new_(), color: none, icon: none, tooltip: none, execution_logic: none }
        for pin_def in &(*def).inputs:
            let pin = (*_self).convert_pin(pin_def)?
            node_type.inputs.push(pin)
            ()
        ()
        for pin_def in &(*def).outputs:
            let pin = (*_self).convert_pin(pin_def)?
            node_type.outputs.push(pin)
            ()
        ()
        for attr in &(*def).attributes:
            match attr.name.as_str():
                "category" =>
                    node_type.category = (*_self).extract_string_arg(&attr.args, 0)?
                    ()
                "color" =>
                    node_type.color = Option::Some((*_self).extract_color_arg(&attr.args)?)
                    ()
                "icon" =>
                    node_type.icon = Option::Some((*_self).extract_string_arg(&attr.args, 0)?)
                    ()
                "tooltip" =>
                    node_type.tooltip = Option::Some((*_self).extract_string_arg(&attr.args, 0)?)
                    ()
                _ => ()
        ()
        Result::Ok(node_type)

    fn convert_pin(_self: &GraphEditorConverter, def: &kain_core::ast::PinDef) -> Result<PinDefinition, Error>:
        let pin_type = (*_self).convert_type(&(*def).ty)?
        let mut pin = PinDefinition { name: (*def).name.clone(), pin_type: pin_type, is_array: (*def).is_array, default_value: none, tooltip: none }
        match &(*def).default_:
            Some(default_expr) =>
                pin.default_value = Option::Some((*_self).expr_to_string(default_expr)?)
                ()
                ()
                ()
                ()
            _ =>
                ()
                ()
        for attr in &(*def).attributes:
            if (attr.name == "tooltip"):
                pin.tooltip = Option::Some((*_self).extract_string_arg(&attr.args, 0)?)
                ()
        ()
        Result::Ok(pin)

    fn convert_type(_self: &GraphEditorConverter, ty: &kain_core::ast::Type) -> Result<PinType, Error>:
        match ty:
            kain_core__ast__Type::Named { name: name } =>
                match name.as_str():
                    "Exec" => Result::Ok(PinType__Exec)
                    "Bool" => Result::Ok(PinType__Bool)
                    "Int" => Result::Ok(PinType__Int)
                    "Float" => Result::Ok(PinType__Float)
                    "String" => Result::Ok(PinType__String)
                    "Wildcard" => Result::Ok(PinType__Wildcard)
                    _ => Result::Ok(PinType::Object(name.clone()))
            kain_core__ast__Type::Array(inner, _, _) => (*_self).convert_type(inner)
            _ => Result::Err(GraphError::ASTConversion(f"Unsupported pin type: {ty}"))

    fn convert_schema(_self: &GraphEditorConverter, def: &kain_core::ast::GraphSchemaDef) -> Result<GraphSchema, Error>:
        let mut schema = GraphSchema__default_()
        for rule in &(*def).rules:
            let validation_rule = ValidationRule { name: rule.name.clone(), description: f"Validation rule: {rule.name}", implementation: (*_self).expr_to_string(&rule.condition)? }
            schema.validation_rules.push(validation_rule)
            ()
        ()
        Result::Ok(schema)

    fn validate_graph(_self: &GraphEditorConverter, graph: &GraphEditor) -> Result<(), Error>:
        let mut seen_names = HashMap__new_()
        for node_type in &(*graph).node_types:
            match seen_names.insert(&node_type.name, ()):
                Some(_) => return Result::Err(GraphError::IRValidation(f"Duplicate node type name: {node_type.name}"))
                _ => ()
        ()
        for node_type in &(*graph).node_types:
            (*_self).validate_node_type(node_type)?
            ()
        ()
        Result::Ok(())

    fn validate_node_type(_self: &GraphEditorConverter, node_type: &NodeType) -> Result<(), Error>:
        let mut seen_input_names = HashMap__new_()
        for pin in &(*node_type).inputs:
            if seen_input_names.insert(&pin.name, ()).is_some():
                return Result::Err(GraphError::IRValidation(f"Duplicate input pin name '{pin.name}' in node type '{(*node_type).name}'"))
        ()
        let mut seen_output_names = HashMap__new_()
        for pin in &(*node_type).outputs:
            if seen_output_names.insert(&pin.name, ()).is_some():
                return Result::Err(GraphError::IRValidation(f"Duplicate output pin name '{pin.name}' in node type '{(*node_type).name}'"))
        ()
        Result::Ok(())

    fn extract_bool_arg(_self: &GraphEditorConverter, args: &[kain_core::ast::Expr], index: usize) -> Result<Bool, Error>:
        if (index >= args.len()):
            return Result::Err(GraphError::ASTConversion(f"Missing argument at index {index}"))
        match &args[index]:
            kain_core__ast__Expr::Bool(val, _) => Result::Ok((*val))
            _ => Result::Err(GraphError::ASTConversion(("Expected boolean argument").to_string()))

    fn extract_int_arg(_self: &GraphEditorConverter, args: &[kain_core::ast::Expr], index: usize) -> Result<i32, Error>:
        if (index >= args.len()):
            return Result::Err(GraphError::ASTConversion(f"Missing argument at index {index}"))
        match &args[index]:
            kain_core__ast__Expr::Int(val, _) => Result::Ok((*val) as i32)
            _ => Result::Err(GraphError::ASTConversion(("Expected integer argument").to_string()))

    fn extract_string_arg(_self: &GraphEditorConverter, args: &[kain_core::ast::Expr], index: usize) -> Result<String, Error>:
        if (index >= args.len()):
            return Result::Err(GraphError::ASTConversion(f"Missing argument at index {index}"))
        match &args[index]:
            kain_core__ast__Expr::String(val, _) => Result::Ok(val.clone())
            _ => Result::Err(GraphError::ASTConversion(("Expected string argument").to_string()))

    fn extract_color_arg(_self: &GraphEditorConverter, args: &[kain_core::ast::Expr]) -> Result<[f32; 4], Error>:
        if (args.len() < 4):
            return Result::Err(GraphError::ASTConversion(("Color requires 4 arguments (RGBA)").to_string()))
        let r = (*_self).extract_float_from_expr(&args[0])?
        let g = (*_self).extract_float_from_expr(&args[1])?
        let b = (*_self).extract_float_from_expr(&args[2])?
        let a = (*_self).extract_float_from_expr(&args[3])?
        Result::Ok([r, g, b, a])

    fn extract_float_from_expr(_self: &GraphEditorConverter, expr: &kain_core::ast::Expr) -> Result<f32, Error>:
        match expr:
            kain_core__ast__Expr::Float(val, _) => Result::Ok((*val) as f32)
            kain_core__ast__Expr::Int(val, _) => Result::Ok((*val) as f32)
            _ => Result::Err(GraphError::ASTConversion(("Expected numeric value for color component").to_string()))

    fn expr_to_string(_self: &GraphEditorConverter, expr: &kain_core::ast::Expr) -> Result<String, Error>:
        match expr:
            kain_core__ast__Expr::Int(val, _) => Result::Ok(val.to_string())
            kain_core__ast__Expr::Float(val, _) => Result::Ok(val.to_string())
            kain_core__ast__Expr::String(val, _) => Result::Ok(val.clone())
            kain_core__ast__Expr::Bool(val, _) => Result::Ok(val.to_string())
            kain_core__ast__Expr::Ident(name, _) => Result::Ok(name.clone())
            _ =>
                let expr_desc = match expr:
                    kain_core__ast__Expr::Binary {  } => "<binary_op>"
                    kain_core__ast__Expr::Call {  } => "<function_call>"
                    kain_core__ast__Expr::Array {  } => "<array>"
                    _ => "<expression>"
                Result::Ok(expr_desc.to_string())


impl Default for GraphEditorConverter:
    fn default_() -> GraphEditorConverter:
        GraphEditorConverter__new_()


@doc(doc = " Convenience function for converting AST to IR")
pub fn convert_graph_editor(ast: &kain_core::ast::GraphEditorDef) -> Result<GraphEditor, Error>:
    let mut converter = GraphEditorConverter__new_()
    converter.convert(ast)

