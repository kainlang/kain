use error::BlueprintError

use error::Result

use factory::BlueprintFactoryGenerator

use ir::BlueprintDef

use ir::BlueprintEngineVersion

use ir::ComponentDef

use ir::EventGraphNode

use ir::KismetCall

use ir::PropertyDef

use ir::PropertyValue

use writer::BlueprintBinaryWriter

@doc(doc = " Convenience: generate both header and source for a blueprint.")
@doc(doc = " Returns `(header_content, source_content)`.")
pub fn generate_factory(bp: &ir::BlueprintDef) -> (String, String):
    (BlueprintFactoryGenerator__generate_header(bp), BlueprintFactoryGenerator__generate_source(bp))

@doc(doc = " Convenience: attempt binary .uasset generation, fall back to factory")
@doc(doc = " if binary writer is not yet supported for this blueprint.")
@doc(doc = "")
@doc(doc = " Returns:")
@doc(doc = "   - `Ok(Some(bytes))` — binary .uasset generated successfully")
@doc(doc = "   - `Ok(None)`        — binary writer not supported, use factory fallback")
@doc(doc = "   - `Err(e)`          — hard error")
pub fn generate_uasset(bp: &ir::BlueprintDef) -> Result<Option<Array<u8>>, Error>:
    match BlueprintBinaryWriter__check_support(bp):
        Ok(_) => BlueprintBinaryWriter__write(bp).map(fn(__kain_closure_arg0): Option::Some(__kain_closure_arg0))
        Err(_) => Result::Ok(none)

