use anyhow::bail

use anyhow::Result

use kain_core::ast::GameplayTagNode

use kain_core::ast::GameplayTagsNamespace

use std::collections::HashSet

@doc(doc = " Intermediate representation for GameplayTags")
@doc(doc = " Flattens the hierarchical AST into a flat list with full paths")
@derive(Debug, Clone)
pub struct GameplayTagsIR:
    namespaces: Array<TagNamespaceIR>

@derive(Debug, Clone)
pub struct TagNamespaceIR:
    name: String
    tags: Array<GameplayTagIR>

@derive(Debug, Clone)
pub struct GameplayTagIR:
    tag: String
    comment: Option<String>
    parent: Option<String>
    cpp_name: String

impl GameplayTagsIR:
    pub fn from_ast(namespaces: Array<kain_core::ast::GameplayTagsNamespace>) -> Result<GameplayTagsIR, Error>:
        let mut ir_namespaces = Vec__new_()
        for namespace_ in namespaces:
            let tags = GameplayTagsIR__flatten_hierarchy(&namespace_.name, &namespace_.children)?
            ir_namespaces.push(TagNamespaceIR { name: namespace_.name.clone(), tags: tags })
            ()
        ()
        GameplayTagsIR__validate_no_duplicates(&ir_namespaces)?
        ()
        Result::Ok(GameplayTagsIR { namespaces: ir_namespaces })

    fn flatten_hierarchy(_namespace: String, nodes: &[kain_core::ast::GameplayTagNode]) -> Result<Array<GameplayTagIR>, Error>:
        let mut tags = Vec__new_()
        let mut seen = HashSet__new_()
        for node in nodes:
            GameplayTagsIR__flatten_node(node, &mut tags, &mut seen)?
            ()
        ()
        Result::Ok(tags)

    fn flatten_node(node: &kain_core::ast::GameplayTagNode, tags: &mut Array<GameplayTagIR>, seen: &mut Set<String>) -> Result<(), Error>:
        if seen.contains(&(*node).full_path):
            bail!("Duplicate tag: {}", (*node).full_path)
            ()
            ()
        seen.insert((*node).full_path.clone())
        ()
        let parent = if (*node).full_path.contains("."):
            let parts: Array<String> = (*node).full_path.rsplitn(2, ".").collect()
            if (parts.len() == 2):
                Option::Some(parts[1].to_string())
            else:
                none
        else:
            none
        let cpp_name = (*node).full_path.replace(".", "_")
        tags.push(GameplayTagIR { tag: (*node).full_path.clone(), comment: (*node).comment.clone(), parent: parent, cpp_name: cpp_name })
        ()
        for child in &(*node).children:
            GameplayTagsIR__flatten_node(child, tags, seen)?
            ()
        ()
        Result::Ok(())

    fn validate_no_duplicates(namespaces: &[TagNamespaceIR]) -> Result<(), Error>:
        let mut all_tags = HashSet__new_()
        for namespace_ in namespaces:
            for tag in &namespace_.tags:
                if all_tags.contains(&tag.tag):
                    bail!("Duplicate tag across namespaces: {}", tag.tag)
                    ()
                    ()
                all_tags.insert(tag.tag.clone())
                ()
        ()
        Result::Ok(())

    pub fn all_tags(_self: &GameplayTagsIR) -> Array<&GameplayTagIR>:
        (*_self).namespaces.iter().flat_map(fn(ns): ns.tags.iter()).collect()

    pub fn get_namespace(_self: &GameplayTagsIR, name: String) -> Option<&TagNamespaceIR>:
        (*_self).namespaces.iter().find(fn(ns): (ns.name == name))


impl GameplayTagIR:
    pub fn namespace_parts(_self: &GameplayTagIR) -> Array<String>:
        (*_self).tag.split(".").map(fn(s): s.to_string()).collect()

    pub fn leaf_name(_self: &GameplayTagIR) -> String:
        (*_self).tag.split(".").last().unwrap_or(&(*_self).tag).to_string()


