use crate::effect_ir::DurationPolicy

use crate::effect_ir::GameplayEffectIR

use crate::effect_ir::ModifierOp

use crate::effect_ir::StackingType

use kain_core::error::KainResult

@doc(doc = " Output structure for effect codegen")
@derive(Debug, Clone)
pub struct GameplayEffectOutput:
    header: String
    source: String

@doc(doc = " Generate complete C++ code for a gameplay effect")
pub fn generate(effect_ir: &GameplayEffectIR, plugin_name: String) -> Result<GameplayEffectOutput, KainError>:
    let class_name = f"U{(*effect_ir).name}"
    let header = generate_header(effect_ir, &class_name, plugin_name)?
    let source = generate_source(effect_ir, &class_name, plugin_name)?
    Result::Ok(GameplayEffectOutput { header: header, source: source })

@doc(doc = " Generate header file (.h)")
fn generate_header(effect_ir: &GameplayEffectIR, class_name: String, _plugin_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"GameplayEffect.h\"\n")
    ()
    output.push_str(&f"#include \"{(*effect_ir).name}.generated.h\"\n\n")
    ()
    output.push_str("UCLASS(MinimalAPI, BlueprintType)\n")
    ()
    output.push_str(&f"class {class_name} : public UGameplayEffect\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("\tGENERATED_BODY()\n\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"\t{class_name}();\n")
    ()
    output.push_str("};\n")
    ()
    Result::Ok(output)

@doc(doc = " Generate source file (.cpp)")
fn generate_source(effect_ir: &GameplayEffectIR, class_name: String, _plugin_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str(&f"#include \"Effects/{(*effect_ir).name}.h\"\n")
    ()
    output.push_str("#include \"GameplayTags.h\"\n\n")
    ()
    output.push_str("#if __has_include(\"GameplayEffectComponents/AssetTagsGameplayEffectComponent.h\")\n")
    ()
    output.push_str("#include \"GameplayEffectComponents/AssetTagsGameplayEffectComponent.h\"\n")
    ()
    output.push_str("#endif\n")
    ()
    output.push_str("#if __has_include(\"GameplayEffectComponents/TargetTagsGameplayEffectComponent.h\")\n")
    ()
    output.push_str("#include \"GameplayEffectComponents/TargetTagsGameplayEffectComponent.h\"\n")
    ()
    output.push_str("#endif\n")
    ()
    output.push_str("#if __has_include(\"GameplayEffectComponents/TargetTagRequirementsGameplayEffectComponent.h\")\n")
    ()
    output.push_str("#include \"GameplayEffectComponents/TargetTagRequirementsGameplayEffectComponent.h\"\n")
    ()
    output.push_str("#endif\n\n")
    ()
    output.push_str(&generate_constructor(effect_ir, class_name)?)
    ()
    Result::Ok(output)

@doc(doc = " Generate constructor with all effect configuration")
fn generate_constructor(effect_ir: &GameplayEffectIR, class_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str(&f"{class_name}::{class_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("\t// Duration\n")
    ()
    output.push_str(&f"\tDurationPolicy = {duration_policy_to_ue5(&(*effect_ir).duration_policy)};\n")
    ()
    match (*effect_ir).duration_magnitude:
        Some(duration) =>
            let duration_str = if (duration.fract() == 0):
                duration
            else:
                duration
            output.push_str(&f"\tDurationMagnitude = FScalableFloat({duration_str}f);\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    output.push_str("\n")
    ()
    match (*effect_ir).period:
        Some(period) =>
            output.push_str("\t// Period\n")
            ()
            let period_str = if (period.fract() == 0):
                period
            else:
                period
            output.push_str(&f"\tPeriod = FScalableFloat({period_str}f);\n")
            ()
            if (*effect_ir).execute_on_application:
                output.push_str("\tbExecutePeriodicEffectOnApplication = true;\n")
                ()
                ()
                ()
                ()
            output.push_str("\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    if (!(*effect_ir).modifiers.is_empty()):
        output.push_str("\t// Modifiers\n")
        ()
        for modifier in &(*effect_ir).modifiers:
            output.push_str("\t{\n")
            ()
            output.push_str("\t\tFGameplayModifierInfo Modifier;\n")
            ()
            let (attribute_set, attribute_name) = if modifier.attribute.contains("."):
                let parts: Array<String> = modifier.attribute.split(".").collect()
                (parts[0].to_string(), parts[1].to_string())
            else:
                (String__new_(), modifier.attribute.clone())
            if attribute_set.is_empty():
                output.push_str(&f"\t\t// TODO(kain): unresolved attribute set for '{attribute_name}'; emitting empty gameplay attribute fallback\n")
                ()
                output.push_str("\t\tModifier.Attribute = FGameplayAttribute();\n")
                ()
                ()
                ()
                ()
            else:
                output.push_str(&f"\t\tModifier.Attribute = U{attribute_set}::Get{capitalize_first(&attribute_name)}Attribute();\n")
                ()
                ()
                ()
                ()
            output.push_str(&f"\t\tModifier.ModifierOp = {modifier_op_to_ue5(&modifier.operation)};\n")
            ()
            let magnitude_str = if (modifier.magnitude.fract() == 0):
                modifier.magnitude
            else:
                modifier.magnitude
            output.push_str(&f"\t\tModifier.ModifierMagnitude = FScalableFloat({magnitude_str}f);\n")
            ()
            output.push_str("\t\tModifiers.Add(Modifier);\n")
            ()
            output.push_str("\t}\n")
            ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    match (*effect_ir).stacking:
        Some(stacking) =>
            output.push_str("\t// Stacking\n")
            ()
            output.push_str(&f"\tStackingType = {stacking_type_to_ue5(&stacking.stacking_type)};\n")
            ()
            output.push_str(&f"\tStackLimitCount = {stacking.limit};\n")
            ()
            output.push_str("\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    let has_tag_data = ((((((!(*effect_ir).owned_tags.is_empty()) || (!(*effect_ir).granted_tags.is_empty())) || (!(*effect_ir).application_tag_requirements.require.is_empty())) || (!(*effect_ir).application_tag_requirements.ignore.is_empty())) || (!(*effect_ir).ongoing_tag_requirements.require.is_empty())) || (!(*effect_ir).ongoing_tag_requirements.ignore.is_empty()))
    if has_tag_data:
        output.push_str("\t// Tag configuration (UE5 component API when available)\n")
        ()
        output.push_str("\t#if __has_include(\"GameplayEffectComponents/AssetTagsGameplayEffectComponent.h\") \\\n")
        ()
        output.push_str("\t\t&& __has_include(\"GameplayEffectComponents/TargetTagsGameplayEffectComponent.h\") \\\n")
        ()
        output.push_str("\t\t&& __has_include(\"GameplayEffectComponents/TargetTagRequirementsGameplayEffectComponent.h\")\n")
        ()
        if (!(*effect_ir).owned_tags.is_empty()):
            output.push_str("\tUAssetTagsGameplayEffectComponent* AssetTagsComp = CreateDefaultSubobject<UAssetTagsGameplayEffectComponent>(TEXT(\"AssetTags\"));\n")
            ()
            for tag in &(*effect_ir).owned_tags:
                output.push_str(&f"\tAssetTagsComp->InheritableAssetTags.AddTag(FGameplayTag::RequestGameplayTag(FName(\"{tag}\")));\n")
                ()
            ()
            ()
        if (!(*effect_ir).granted_tags.is_empty()):
            output.push_str("\tUTargetTagsGameplayEffectComponent* TargetTagsComp = CreateDefaultSubobject<UTargetTagsGameplayEffectComponent>(TEXT(\"TargetTags\"));\n")
            ()
            for tag in &(*effect_ir).granted_tags:
                output.push_str(&f"\tTargetTagsComp->InheritableGrantedTagsContainer.AddTag(FGameplayTag::RequestGameplayTag(FName(\"{tag}\")));\n")
                ()
            ()
            ()
        if ((((!(*effect_ir).application_tag_requirements.require.is_empty()) || (!(*effect_ir).application_tag_requirements.ignore.is_empty())) || (!(*effect_ir).ongoing_tag_requirements.require.is_empty())) || (!(*effect_ir).ongoing_tag_requirements.ignore.is_empty())):
            output.push_str("\tUTargetTagRequirementsGameplayEffectComponent* RequirementsComp = CreateDefaultSubobject<UTargetTagRequirementsGameplayEffectComponent>(TEXT(\"Requirements\"));\n")
            ()
            for tag in &(*effect_ir).application_tag_requirements.require:
                output.push_str(&f"\tRequirementsComp->ApplicationTagRequirements.RequireTags.AddTag(FGameplayTag::RequestGameplayTag(FName(\"{tag}\")));\n")
                ()
            ()
            for tag in &(*effect_ir).application_tag_requirements.ignore:
                output.push_str(&f"\tRequirementsComp->ApplicationTagRequirements.IgnoreTags.AddTag(FGameplayTag::RequestGameplayTag(FName(\"{tag}\")));\n")
                ()
            ()
            for tag in &(*effect_ir).ongoing_tag_requirements.require:
                output.push_str(&f"\tRequirementsComp->OngoingTagRequirements.RequireTags.AddTag(FGameplayTag::RequestGameplayTag(FName(\"{tag}\")));\n")
                ()
            ()
            for tag in &(*effect_ir).ongoing_tag_requirements.ignore:
                output.push_str(&f"\tRequirementsComp->OngoingTagRequirements.IgnoreTags.AddTag(FGameplayTag::RequestGameplayTag(FName(\"{tag}\")));\n")
                ()
            ()
            ()
        output.push_str("\t#else\n")
        ()
        if (!(*effect_ir).owned_tags.is_empty()):
            output.push_str("\t// Owned tags (legacy fallback)\n")
            ()
            for tag in &(*effect_ir).owned_tags:
                output.push_str(&"\tInheritableOwnedTagsContainer.AddTag(\n")
                ()
                output.push_str(&f"\t\tFGameplayTag::RequestGameplayTag(FName(\"{tag}\"))\n")
                ()
                output.push_str("\t);\n")
                ()
            ()
            ()
        if (!(*effect_ir).granted_tags.is_empty()):
            output.push_str("\t// Granted tags (legacy fallback)\n")
            ()
            for tag in &(*effect_ir).granted_tags:
                output.push_str(&"\tInheritableGameplayEffectTags.Added.AddTag(\n")
                ()
                output.push_str(&f"\t\tFGameplayTag::RequestGameplayTag(FName(\"{tag}\"))\n")
                ()
                output.push_str("\t);\n")
                ()
            ()
            ()
        if ((!(*effect_ir).application_tag_requirements.require.is_empty()) || (!(*effect_ir).application_tag_requirements.ignore.is_empty())):
            output.push_str("\t// Application requirements (legacy fallback)\n")
            ()
            for tag in &(*effect_ir).application_tag_requirements.require:
                output.push_str(&"\tApplicationTagRequirements.RequireTags.AddTag(\n")
                ()
                output.push_str(&f"\t\tFGameplayTag::RequestGameplayTag(FName(\"{tag}\"))\n")
                ()
                output.push_str("\t);\n")
                ()
            ()
            for tag in &(*effect_ir).application_tag_requirements.ignore:
                output.push_str(&"\tApplicationTagRequirements.IgnoreTags.AddTag(\n")
                ()
                output.push_str(&f"\t\tFGameplayTag::RequestGameplayTag(FName(\"{tag}\"))\n")
                ()
                output.push_str("\t);\n")
                ()
            ()
            ()
        if ((!(*effect_ir).ongoing_tag_requirements.require.is_empty()) || (!(*effect_ir).ongoing_tag_requirements.ignore.is_empty())):
            output.push_str("\t// Ongoing requirements (legacy fallback)\n")
            ()
            for tag in &(*effect_ir).ongoing_tag_requirements.require:
                output.push_str(&"\tOngoingTagRequirements.RequireTags.AddTag(\n")
                ()
                output.push_str(&f"\t\tFGameplayTag::RequestGameplayTag(FName(\"{tag}\"))\n")
                ()
                output.push_str("\t);\n")
                ()
            ()
            for tag in &(*effect_ir).ongoing_tag_requirements.ignore:
                output.push_str(&"\tOngoingTagRequirements.IgnoreTags.AddTag(\n")
                ()
                output.push_str(&f"\t\tFGameplayTag::RequestGameplayTag(FName(\"{tag}\"))\n")
                ()
                output.push_str("\t);\n")
                ()
            ()
            ()
        output.push_str("\t#endif\n\n")
        ()
        ()
        ()
        ()
    if ((!(*effect_ir).removal_tag_requirements.require.is_empty()) || (!(*effect_ir).removal_tag_requirements.ignore.is_empty())):
        output.push_str("\t// Removal requirements\n")
        ()
        for tag in &(*effect_ir).removal_tag_requirements.require:
            output.push_str(&"\tRemovalTagRequirements.RequireTags.AddTag(\n")
            ()
            output.push_str(&f"\t\tFGameplayTag::RequestGameplayTag(FName(\"{tag}\"))\n")
            ()
            output.push_str("\t);\n")
            ()
        ()
        for tag in &(*effect_ir).removal_tag_requirements.ignore:
            output.push_str(&"\tRemovalTagRequirements.IgnoreTags.AddTag(\n")
            ()
            output.push_str(&f"\t\tFGameplayTag::RequestGameplayTag(FName(\"{tag}\"))\n")
            ()
            output.push_str("\t);\n")
            ()
        ()
        output.push_str("\n")
        ()
        ()
        ()
        ()
    output.push_str("}\n")
    ()
    Result::Ok(output)

fn duration_policy_to_ue5(policy: &DurationPolicy) -> String:
    match policy:
        DurationPolicy::Instant => "EGameplayEffectDurationType::Instant"
        DurationPolicy::Infinite => "EGameplayEffectDurationType::Infinite"
        DurationPolicy::HasDuration => "EGameplayEffectDurationType::HasDuration"

fn modifier_op_to_ue5(op: &ModifierOp) -> String:
    match op:
        ModifierOp::Add => "EGameplayModOp::Additive"
        ModifierOp::Multiply => "EGameplayModOp::Multiplicitive"
        ModifierOp::Divide => "EGameplayModOp::Division"
        ModifierOp::Override => "EGameplayModOp::Override"

fn stacking_type_to_ue5(stacking: &StackingType) -> String:
    match stacking:
        StackingType::None => "EGameplayEffectStackingType::None"
        StackingType::AggregateBySource => "EGameplayEffectStackingType::AggregateBySource"
        StackingType::AggregateByTarget => "EGameplayEffectStackingType::AggregateByTarget"

@doc(doc = " Capitalize first letter of a string and convert snake_case to PascalCase")
fn capitalize_first(s: String) -> String:
    s.split("_").map(fn(word): none).collect()

