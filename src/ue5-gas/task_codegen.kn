use crate::task_ir::AbilityTaskIR

use crate::task_ir::DelegateIR

use crate::task_ir::DelegateTypeIR

use kain_core::error::KainResult

@doc(doc = " Output structure for task codegen")
@derive(Debug, Clone)
pub struct AbilityTaskOutput:
    header: String
    source: String

@doc(doc = " Generate complete C++ code for an ability task")
pub fn generate(task_ir: &AbilityTaskIR, plugin_name: String) -> Result<AbilityTaskOutput, KainError>:
    let class_name = f"U{(*task_ir).name}"
    let header = generate_header(task_ir, &class_name)?
    let source = generate_source(task_ir, &class_name)?
    Result::Ok(AbilityTaskOutput { header: header, source: source })

@doc(doc = " Generate task header")
fn generate_header(task_ir: &AbilityTaskIR, class_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str("#pragma once\n\n")
    ()
    output.push_str("#include \"CoreMinimal.h\"\n")
    ()
    output.push_str("#include \"Abilities/Tasks/AbilityTask.h\"\n")
    ()
    output.push_str(&f"#include \"{(*task_ir).name}.generated.h\"\n\n")
    ()
    for delegate in &(*task_ir).delegates:
        let delegate_macro = get_delegate_macro(&delegate.delegate_type)
        output.push_str(&f"{delegate_macro}({get_delegate_signature(&delegate.delegate_type)});\n")
        ()
    ()
    if (!(*task_ir).delegates.is_empty()):
        output.push_str("\n")
        ()
        ()
        ()
        ()
    output.push_str("UCLASS()\n")
    ()
    output.push_str(&f"class {class_name} : public UAbilityTask\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("\tGENERATED_BODY()\n\n")
    ()
    output.push_str("public:\n")
    ()
    output.push_str(&f"\t{class_name}();\n\n")
    ()
    for delegate in &(*task_ir).delegates:
        output.push_str("\tUPROPERTY(BlueprintAssignable)\n")
        ()
        output.push_str(&f"\t{get_delegate_type_name(&delegate.delegate_type)} {delegate.name};\n\n")
        ()
    ()
    output.push_str("\tUFUNCTION(BlueprintCallable, Category = \"Ability|Tasks\")\n")
    ()
    output.push_str(&f"\tstatic {class_name}* Create{(*task_ir).name}(UGameplayAbility* OwningAbility);\n\n")
    ()
    output.push_str("\tvirtual void Activate() override;\n")
    ()
    if (*task_ir).on_destroy_body.is_some():
        output.push_str("\tvirtual void OnDestroy(bool bInOwnerFinished) override;\n")
        ()
        ()
        ()
        ()
    for method in &(*task_ir).custom_methods:
        output.push_str(&f"\tvoid {method.name}();\n")
        ()
    ()
    if (!(*task_ir).state_fields.is_empty()):
        output.push_str("\nprotected:\n")
        ()
        for field in &(*task_ir).state_fields:
            output.push_str("\tUPROPERTY()\n")
            ()
            output.push_str(&f"\t{field.field_type} {field.name};\n")
            ()
        ()
        ()
    output.push_str("};\n")
    ()
    Result::Ok(output)

@doc(doc = " Generate task source")
fn generate_source(task_ir: &AbilityTaskIR, class_name: String) -> Result<String, KainError>:
    let mut output = String__new_()
    output.push_str(&f"#include \"Tasks/{(*task_ir).name}.h\"\n")
    ()
    output.push_str("#include \"AbilitySystemComponent.h\"\n\n")
    ()
    output.push_str(&f"{class_name}::{class_name}()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"{class_name}* {class_name}::Create{(*task_ir).name}(UGameplayAbility* OwningAbility)\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str(&f"\t{class_name}* Task = NewAbilityTask<{class_name}>(OwningAbility);\n")
    ()
    output.push_str("\treturn Task;\n")
    ()
    output.push_str("}\n\n")
    ()
    output.push_str(&f"void {class_name}::Activate()\n")
    ()
    output.push_str("{\n")
    ()
    output.push_str("\tSuper::Activate();\n")
    ()
    match (*task_ir).activate_body:
        Some(body) =>
            output.push_str(&f"\t{body}\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    output.push_str("}\n\n")
    ()
    match (*task_ir).on_destroy_body:
        Some(body) =>
            output.push_str(&f"void {class_name}::OnDestroy(bool bInOwnerFinished)\n")
            ()
            output.push_str("{\n")
            ()
            output.push_str(&f"\t{body}\n")
            ()
            output.push_str("\tSuper::OnDestroy(bInOwnerFinished);\n")
            ()
            output.push_str("}\n\n")
            ()
            ()
            ()
            ()
        _ =>
            ()
            ()
    for method in &(*task_ir).custom_methods:
        output.push_str(&f"void {class_name}::{method.name}()\n")
        ()
        output.push_str("{\n")
        ()
        output.push_str(&f"\t{method.body}\n")
        ()
        output.push_str("}\n\n")
        ()
    ()
    Result::Ok(output)

@doc(doc = " Get delegate macro for declaration")
fn get_delegate_macro(delegate_type: &DelegateTypeIR) -> String:
    match delegate_type:
        DelegateTypeIR::AttributeChange => ("DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam").to_string()
        DelegateTypeIR::TaskCancelled => ("DECLARE_DYNAMIC_MULTICAST_DELEGATE").to_string()
        DelegateTypeIR::TargetDataReady => ("DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam").to_string()
        DelegateTypeIR::GameplayEvent => ("DECLARE_DYNAMIC_MULTICAST_DELEGATE_TwoParams").to_string()
        DelegateTypeIR::Custom(_) => ("DECLARE_DYNAMIC_MULTICAST_DELEGATE").to_string()

@doc(doc = " Get delegate signature")
fn get_delegate_signature(delegate_type: &DelegateTypeIR) -> String:
    match delegate_type:
        DelegateTypeIR::AttributeChange => ("FAttributeChangeDelegate, float, NewValue").to_string()
        DelegateTypeIR::TaskCancelled => ("FTaskCancelledDelegate").to_string()
        DelegateTypeIR::TargetDataReady => ("FTargetDataDelegate, const FGameplayAbilityTargetDataHandle&, Data").to_string()
        DelegateTypeIR::GameplayEvent => ("FGameplayEventDelegate, FGameplayTag, EventTag, const FGameplayEventData&, Payload").to_string()
        DelegateTypeIR::Custom(name) => f"F{name}Delegate"

@doc(doc = " Get delegate type name")
fn get_delegate_type_name(delegate_type: &DelegateTypeIR) -> String:
    match delegate_type:
        DelegateTypeIR::AttributeChange => ("FAttributeChangeDelegate").to_string()
        DelegateTypeIR::TaskCancelled => ("FTaskCancelledDelegate").to_string()
        DelegateTypeIR::TargetDataReady => ("FTargetDataDelegate").to_string()
        DelegateTypeIR::GameplayEvent => ("FGameplayEventDelegate").to_string()
        DelegateTypeIR::Custom(name) => f"F{name}Delegate"

