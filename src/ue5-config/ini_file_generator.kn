use crate::config_ir::ConfigField

use crate::config_ir::ConfigStruct

use anyhow::Result

@doc(doc = " Generate a .ini file section for a config struct")
@doc(doc = "")
@doc(doc = " # Example Output")
@doc(doc = "")
@doc(doc = " ```ini")
@doc(doc = " [/Script/MyPlugin.VoxelSettings]")
@doc(doc = " ChunkSize=100.0")
@doc(doc = " MaxLod=4")
@doc(doc = " DebugVis=False")
@doc(doc = " ```")
pub fn generate_ini_section(config: &ConfigStruct, plugin_name: String) -> Result<String, Error>:
    let mut lines = Vec__new_()
    let section_name = config.get_ini_section(plugin_name)
    lines.push(f"[{section_name}]")
    ()
    for field in &(*config).fields:
        let property_name = field.ue5_property_name()
        let value = format_ini_value(field)?
        lines.push(f"{property_name}={value}")
        ()
    ()
    Result::Ok(lines.join("\n"))

@doc(doc = " Format a field value for .ini file")
@doc(doc = "")
@doc(doc = " CRITICAL: Bool values MUST be \"True\"/\"False\" (capital T/F), NOT \"true\"/\"false\"")
fn format_ini_value(field: &ConfigField) -> Result<String, Error>:
    use kain_core::ast::Expr

    match &(*field).default_:
        Some(kain_core__ast__Expr::Float(val, _)) => Result::Ok(val)
        Some(kain_core__ast__Expr::Int(val, _)) => Result::Ok(val.to_string())
        Some(kain_core__ast__Expr::Bool(val, _)) => Result::Ok((if (*val): "True" else: "False").to_string())
        Some(kain_core__ast__Expr::String(val, _)) => Result::Ok(val.clone())
        None =>
            match (*field).ty:
                kain_core__ast__Type::Named { name: name } =>
                    match name.as_str():
                        "Float" => Result::Ok(("0.0").to_string())
                        "Int" => Result::Ok(("0").to_string())
                        "Bool" => Result::Ok(("False").to_string())
                        "String" => Result::Ok(String__new_())
                        _ => anyhow::bail!("Unsupported .ini type: {}", name)
                _ => anyhow::bail!("Unsupported .ini type for field: {}", (*field).name)
        _ => anyhow::bail!("Unsupported default value expression for field: {}", (*field).name)

@doc(doc = " Generate complete .ini file content with header comment")
pub fn generate_ini_file(config: &ConfigStruct, plugin_name: String) -> Result<String, Error>:
    let mut content = String__new_()
    content.push_str(&f"; Generated by KAIN compiler\n; Configuration for {config.get_display_name()}\n\n")
    ()
    content.push_str(&generate_ini_section(config, plugin_name)?)
    ()
    content.push("\n")
    ()
    Result::Ok(content)

