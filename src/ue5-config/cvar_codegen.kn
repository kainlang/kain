use crate::config_ir::ConfigField

use crate::config_ir::ConfigStruct

use anyhow::Result

@doc(doc = " Generate TAutoConsoleVariable<T> declarations for all fields with CVars")
@doc(doc = "")
@doc(doc = " # Example Output")
@doc(doc = "")
@doc(doc = " ```cpp")
@doc(doc = " static TAutoConsoleVariable<float> CVarChunkSize(")
@doc(doc = "     TEXT(\"voxel.ChunkSize\"),")
@doc(doc = "     100.0f,")
@doc(doc = "     TEXT(\"Chunk Size\"),")
@doc(doc = "     ECVF_Default);")
@doc(doc = " ```")
pub fn generate_cvar_declarations(config: &ConfigStruct, plugin_name: String) -> Result<Array<String>, Error>:
    let mut declarations = Vec__new_()
    for field in &(*config).fields:
        match field.get_cvar_name(plugin_name):
            Some(cvar_name) =>
                let declaration = generate_single_cvar_declaration(field, &cvar_name)?
                declarations.push(declaration)
                ()
            _ => ()
    ()
    Result::Ok(declarations)

@doc(doc = " Generate a single TAutoConsoleVariable declaration")
fn generate_single_cvar_declaration(field: &ConfigField, cvar_name: String) -> Result<String, Error>:
    let cpp_type = get_cvar_cpp_type(&(*field).ty)?
    let var_name = f"CVar{field.ue5_property_name()}"
    let default_value = format_default_value(field)?
    let display_name = field.get_display_name()
    let help_text = (*field).tooltip.unwrap_or(&display_name)
    Result::Ok(f"static TAutoConsoleVariable<{cpp_type}> {var_name}(\n\tTEXT(\"{cvar_name}\"),\n\t{default_value},\n\tTEXT(\"{help_text}\"),\n\tECVF_Default);")

@doc(doc = " Get the C++ type for TAutoConsoleVariable<T>")
fn get_cvar_cpp_type(ty: &kain_core::ast::Type) -> Result<String, Error>:
    use kain_core::ast::Type

    match ty:
        kain_core__ast__Type::Named { name: name } =>
            match name.as_str():
                "Float" => Result::Ok("float")
                "Int" => Result::Ok("int32")
                "Bool" => Result::Ok("bool")
                "String" => Result::Ok("FString")
                _ => anyhow::bail!("Unsupported CVar type: {}", name)
        _ => anyhow::bail!("Unsupported CVar type: {:?}", ty)

@doc(doc = " Format the default value for a CVar declaration")
fn format_default_value(field: &ConfigField) -> Result<String, Error>:
    use kain_core::ast::Expr

    match &(*field).default_:
        Some(kain_core__ast__Expr::Float(val, _)) =>
            let s = val.to_string()
            if s.contains("."):
                Result::Ok(f"{s}f")
            else:
                Result::Ok(f"{s}.0f")
        Some(kain_core__ast__Expr::Int(val, _)) => Result::Ok(val.to_string())
        Some(kain_core__ast__Expr::Bool(val, _)) => Result::Ok(if (*val): ("true").to_string() else: ("false").to_string())
        Some(kain_core__ast__Expr::String(val, _)) => Result::Ok(f"TEXT(\"{val}\")")
        None =>
            match (get_cvar_cpp_type(&(*field).ty)?):
                "float" => Result::Ok(("0.0f").to_string())
                "int32" => Result::Ok(("0").to_string())
                "bool" => Result::Ok(("false").to_string())
                "FString" => Result::Ok(("TEXT(\"\")").to_string())
                _ => anyhow::bail!("Cannot determine default value for field: {}", (*field).name)
        _ => anyhow::bail!("Unsupported default value expression for field: {}", (*field).name)

@doc(doc = " Generate callback methods for syncing CVars to UPROPERTY fields")
@doc(doc = "")
@doc(doc = " # Example Output")
@doc(doc = "")
@doc(doc = " ```cpp")
@doc(doc = " void UVoxelSettings::OnChunkSizeChanged()")
@doc(doc = " {")
@doc(doc = "     ChunkSize = CVarChunkSize.GetValueOnGameThread();")
@doc(doc = " }")
@doc(doc = " ```")
pub fn generate_cvar_callbacks(config: &ConfigStruct, plugin_name: String) -> Result<Array<String>, Error>:
    let mut callbacks = Vec__new_()
    for field in &(*config).fields:
        if field.get_cvar_name(plugin_name).is_some():
            let callback = generate_single_cvar_callback(config, field)?
            callbacks.push(callback)
            ()
    ()
    Result::Ok(callbacks)

@doc(doc = " Generate a single CVar callback method")
fn generate_single_cvar_callback(config: &ConfigStruct, field: &ConfigField) -> Result<String, Error>:
    let class_name = config.ue5_class_name()
    let method_name = f"On{field.ue5_property_name()}Changed"
    let property_name = field.ue5_property_name()
    let cvar_name = f"CVar{field.ue5_property_name()}"
    Result::Ok("void {class_name}::{method_name}()\n{\n\t{property_name} = {cvar_name}.GetValueOnGameThread();\n}")

@doc(doc = " Generate callback method declarations for header file")
@doc(doc = "")
@doc(doc = " # Example Output")
@doc(doc = "")
@doc(doc = " ```cpp")
@doc(doc = " void OnChunkSizeChanged();")
@doc(doc = " ```")
pub fn generate_cvar_callback_declarations(config: &ConfigStruct, plugin_name: String) -> Result<Array<String>, Error>:
    let mut declarations = Vec__new_()
    for field in &(*config).fields:
        if field.get_cvar_name(plugin_name).is_some():
            let method_name = f"On{field.ue5_property_name()}Changed"
            declarations.push(f"void {method_name}();")
            ()
    ()
    Result::Ok(declarations)

