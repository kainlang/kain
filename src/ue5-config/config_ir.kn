use kain_core::ast::Expr

use kain_core::ast::Field

use kain_core::ast::Struct

use kain_core::ast::Type

use kain_core::span::Span

pub enum ConfigCategory:
    Game
    Engine
    Editor
    EditorPerProjectUserSettings

impl ConfigCategory:
    pub fn uclass_specifier(_self: &ConfigCategory) -> String:
        match *_self:
            ConfigCategory::Game => "Game"
            ConfigCategory::Engine => "Engine"
            ConfigCategory::Editor => "Editor"
            ConfigCategory::EditorPerProjectUserSettings => "EditorPerProjectUserSettings"

    pub fn default_ini_file(_self: &ConfigCategory) -> String:
        match *_self:
            ConfigCategory::Game => "DefaultGame.ini"
            ConfigCategory::Engine => "DefaultEngine.ini"
            ConfigCategory::Editor => "DefaultEditor.ini"
            ConfigCategory::EditorPerProjectUserSettings => "DefaultEditorPerProjectUserSettings.ini"

    pub fn from_str(s: String) -> Option<ConfigCategory>:
        match s.to_lowercase().as_str():
            "game" => Option::Some(ConfigCategory__Game)
            "engine" => Option::Some(ConfigCategory__Engine)
            "editor" => Option::Some(ConfigCategory__Editor)
            "editorperprojectusersettings" => Option::Some(ConfigCategory__EditorPerProjectUserSettings)
            _ => none


@doc(doc = " Represents a @config struct that will generate a UDeveloperSettings subclass")
@derive(Debug, Clone, PartialEq)
pub struct ConfigStruct:
    name: String
    category: ConfigCategory
    ini_file: Option<String>
    ini_section: Option<String>
    display_name: Option<String>
    fields: Array<ConfigField>
    original_struct: kain_core::ast::Struct
    span: kain_core::span::Span

impl ConfigStruct:
    pub fn ue5_class_name(_self: &ConfigStruct) -> String:
        if (*_self).name.starts_with("U"):
            (*_self).name.clone()
        else:
            f"U{(*_self).name}"

    pub fn get_display_name(_self: &ConfigStruct) -> String:
        (*_self).display_name.clone().unwrap_or_else(fn(): none)

    pub fn get_ini_file(_self: &ConfigStruct) -> String:
        (*_self).ini_file.clone().unwrap_or_else(fn(): (*_self).category.default_ini_file().to_string())

    pub fn get_ini_section(_self: &ConfigStruct, plugin_name: String) -> String:
        (*_self).ini_section.clone().unwrap_or_else(fn(): f"/Script/{plugin_name}.{(*_self).ue5_class_name()}")


@doc(doc = " Represents a field with @setting attribute")
@derive(Debug, Clone, PartialEq)
pub struct ConfigField:
    name: String
    ty: kain_core::ast::Type
    default_: Option<kain_core::ast::Expr>
    display_name: Option<String>
    tooltip: Option<String>
    cvar: Option<String>
    blueprint: Bool
    min: Option<f64>
    max: Option<f64>
    writable: Bool
    original_field: kain_core::ast::Field
    span: kain_core::span::Span

impl ConfigField:
    pub fn ue5_property_name(_self: &ConfigField) -> String:
        use heck::ToPascalCase

        (*_self).name.to_pascal_case()

    pub fn get_display_name(_self: &ConfigField) -> String:
        (*_self).display_name.clone().unwrap_or_else(fn(): (*_self).name.replace("_", " ").split_whitespace().map(fn(word): none).collect().join(" "))

    pub fn get_cvar_name(_self: &ConfigField, plugin_name: String) -> Option<String>:
        match &(*_self).cvar:
            Some(cvar) if (!cvar.is_empty()) => Option::Some(cvar.clone())
            Some(_) => Option::Some(f"{plugin_name}.{(*_self).ue5_property_name()}")
            None => none

    pub fn has_cvar(_self: &ConfigField) -> Bool:
        (*_self).cvar.is_some()


@doc(doc = " Console variable metadata")
@derive(Debug, Clone, PartialEq)
pub struct CVar:
    name: String
    ty: kain_core::ast::Type
    default_: Option<kain_core::ast::Expr>
    help_text: String
    flags: String
    field: ConfigField

impl CVar:
    pub fn cpp_type(_self: &CVar) -> String:
        match (*_self).ty:
            kain_core__ast__Type::Named { name: name } =>
                match name.as_str():
                    "Float" => "float"
                    "Int" => "int32"
                    "Bool" => "bool"
                    "String" => "FString"
                    _ => "float"
            _ => "float"

    pub fn callback_method_name(_self: &CVar) -> String:
        use heck::ToPascalCase

        f"On{(*_self).field.name.to_pascal_case()}Changed"


