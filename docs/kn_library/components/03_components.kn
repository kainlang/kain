# ============================================================================
# FILE 3: COMPONENTS
# Demonstrates: @component attribute, @replicated, @savegame, @transient
# CRITICAL: Components CANNOT have default values!
# ============================================================================

# ----------------------------------------------------------------------------
# COMPONENTS - Reusable actor components
# @component generates UActorComponent classes
# ----------------------------------------------------------------------------

# Health component - manages health, damage, healing
@component
struct HealthComponent:
    # Replicated health values (synced across network)
    @replicated
    current_health: Float
    
    @replicated
    max_health: Float
    
    # Regeneration (not replicated - calculated locally)
    @transient
    health_regen_rate: Float
    
    @transient
    last_damage_time: Float
    
    # Flags
    @replicated
    is_invulnerable: Bool
    
    @savegame
    is_dead: Bool
    
    # Delegates (assigned in Blueprints)
    @blueprint_assignable
    on_health_changed: OnHealthChanged
    
    @blueprint_assignable
    on_death: OnDeath
    
    @blueprint_assignable
    on_respawn: OnRespawn

# Inventory component - manages item storage
@component
struct InventoryComponent:
    # Inventory data (replicated and saved)
    @replicated
    @savegame
    items: Array<ItemStack>
    
    @replicated
    capacity: Int
    
    @replicated
    @savegame
    gold: Int
    
    # Weight system
    @transient
    current_weight: Float
    
    max_weight: Float
    
    # Delegates
    @blueprint_assignable
    on_item_added: OnItemAdded
    
    @blueprint_assignable
    on_item_removed: OnItemRemoved
    
    @blueprint_assignable
    on_inventory_full: OnInventoryFull

# Equipment component - manages equipped items
@component
struct EquipmentComponent:
    # Equipped items (replicated for visual sync)
    @replicated
    @savegame
    head_item_id: Int
    
    @replicated
    @savegame
    chest_item_id: Int
    
    @replicated
    @savegame
    legs_item_id: Int
    
    @replicated
    @savegame
    weapon_item_id: Int
    
    @replicated
    @savegame
    offhand_item_id: Int
    
    # Cached stats (transient - recalculated on equip)
    @transient
    total_armor: Float
    
    @transient
    total_damage_bonus: Float
    
    @transient
    total_attack_speed: Float

# Combat component - manages combat state and abilities
@component
struct CombatComponent:
    # Current target
    @replicated
    current_target: Actor
    
    # Combat state
    @replicated
    is_in_combat: Bool
    
    @transient
    last_attack_time: Float
    
    @transient
    combo_count: Int
    
    # Stats (calculated from equipment + buffs)
    @transient
    attack_power: Float
    
    @transient
    critical_chance: Float
    
    @transient
    critical_multiplier: Float
    
    # Delegates
    @blueprint_assignable
    on_damage_dealt: OnDamageDealt
    
    @blueprint_assignable
    on_damage_taken: OnDamageTaken
    
    @blueprint_assignable
    on_critical_hit: OnCriticalHit

# Quest component - manages active quests
@component
struct QuestComponent:
    # Active quests (saved)
    @savegame
    active_quest_ids: Array<Int>
    
    @savegame
    completed_quest_ids: Array<Int>
    
    # Quest progress (simplified - real system would be more complex)
    @savegame
    quest_progress: Array<Int>
    
    # Delegates
    @blueprint_assignable
    on_quest_started: OnQuestStarted
    
    @blueprint_assignable
    on_quest_completed: OnQuestCompleted
    
    @blueprint_assignable
    on_quest_failed: OnQuestFailed

# Stats component - manages character stats (RPG)
@component
struct StatsComponent:
    # Core stats (saved)
    @savegame
    level: Int
    
    @savegame
    experience: Int
    
    @savegame
    experience_to_next_level: Int
    
    # Attributes (saved)
    @savegame
    strength: Int
    
    @savegame
    dexterity: Int
    
    @savegame
    intelligence: Int
    
    @savegame
    vitality: Int
    
    @savegame
    luck: Int
    
    # Skill points
    @savegame
    available_skill_points: Int

# AI component - manages AI behavior
@component
struct AIComponent:
    # AI state
    @replicated
    current_state: AIState
    
    # Targets and waypoints
    @transient
    current_target: Actor
    
    @transient
    patrol_waypoints: Array<Vec3>
    
    @transient
    current_waypoint_index: Int
    
    # Behavior parameters
    aggro_range: Float
    chase_range: Float
    attack_range: Float
    patrol_speed: Float
    chase_speed: Float
    
    # Timers
    @transient
    last_attack_time: Float
    
    @transient
    last_state_change_time: Float

# Buff/Debuff component - manages status effects
@component
struct StatusEffectComponent:
    # Active effects (replicated for visual sync)
    @replicated
    active_effect_ids: Array<Int>
    
    @replicated
    effect_durations: Array<Float>
    
    # Stat modifiers (transient - recalculated)
    @transient
    damage_multiplier: Float
    
    @transient
    speed_multiplier: Float
    
    @transient
    defense_multiplier: Float

# Interaction component - manages object interaction
@component
struct InteractionComponent:
    # Interaction settings
    interaction_range: Float
    interaction_prompt: String
    
    # State
    @replicated
    is_interactable: Bool
    
    @transient
    is_being_interacted_with: Bool
    
    # Cooldown
    @transient
    last_interaction_time: Float
    
    cooldown_duration: Float

# Helper struct for inventory (not a component)
struct ItemStack:
    item_id: Int
    quantity: Int
    durability: Float
