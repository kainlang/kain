# ============================================================================
# PHASE 4 TEST: Data-Driven Shader Systems
# ============================================================================
# Tests the new ShaderKnowledge integration — functions that the corpus
# now recognizes as real HLSL/UE5 intrinsics with proper return types.
# ============================================================================

# COMPUTE SHADER — uses corpus-known intrinsics
shader compute LightingCompute(thread_id: Vec3) -> Vec4:
    uniform CFG_HIGH_QUALITY: Float @0
    uniform ENABLE_SHADOWS: Float @1
    uniform time: Float @2
    uniform light_dir: Vec3 @3
    uniform intensity: Float @4
    uniform output_buffer: RWTexture2D @5
    uniform scene_depth: Sampler2D @6

    let uv = vec2(float(thread_id.x) / 1920.0, float(thread_id.y) / 1080.0)

    # HLSL intrinsics the corpus knows (95 confirmed)
    let depth = sample(scene_depth, uv).r
    let n_dir = normalize(light_dir)
    let ndotl = saturate(dot(n_dir, vec3(0.0, 0.0, 1.0)))
    let dist = length(light_dir)
    let atten = rcp(dist * dist + 1.0)
    let final_intensity = clamp(ndotl * atten * intensity, 0.0, 1.0)

    # Math intrinsics
    let flicker = abs(sin(time * 3.14159)) * 0.1
    let noise = frac(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453)
    let smooth_val = smoothstep(0.0, 1.0, noise)
    let powered = pow(smooth_val, 2.2)
    let mixed = lerp(powered, 1.0, flicker)

    # Permutation branches (612 known permutations in corpus)
    if CFG_HIGH_QUALITY:
        let ao = pow(noise, 0.5)
        let final_light = final_intensity * mixed * ao
        return vec4(final_light, final_light, final_light, 1.0)

    if ENABLE_SHADOWS:
        let shadow = step(0.5, depth)
        return vec4(shadow, shadow, shadow, 1.0)

    return vec4(0.0, 0.0, 0.0, 1.0)

# FRAGMENT SHADER — post-process with corpus intrinsics
shader fragment ToneMapper(uv: Vec2) -> Vec4:
    uniform exposure: Float @0
    uniform gamma: Float @1
    uniform scene_texture: Sampler2D @2
    uniform bloom_texture: Sampler2D @3

    let scene = sample(scene_texture, uv).rgb
    let bloom = sample(bloom_texture, uv).rgb

    # Combine
    var color = scene + bloom * 0.3

    # Exposure
    color = color * exp2(exposure)

    # ACES-ish tonemapping using corpus intrinsics
    let a = color * (color + vec3(0.0245786, 0.0245786, 0.0245786))
    let b = color * (color + vec3(0.000090537, 0.000090537, 0.000090537)) + vec3(0.983729, 0.983729, 0.983729)
    color = a / max(b, vec3(0.001, 0.001, 0.001))

    # Gamma
    color = pow(color, vec3(1.0 / gamma, 1.0 / gamma, 1.0 / gamma))

    # Clamp
    color = clamp(color, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))

    return vec4(color, 1.0)

# SURFACE SHADER — material with full property set
shader fragment LitMaterial(uv: Vec2) -> Vec4:
    uniform roughness: Float @0
    uniform metallic: Float @1
    uniform emissive_strength: Float @2
    uniform albedo_map: Sampler2D @3
    uniform normal_map: Sampler2D @4
    uniform orm_map: Sampler2D @5

    let albedo = sample(albedo_map, uv).rgb
    let normal = sample(normal_map, uv).rgb * 2.0 - vec3(1.0, 1.0, 1.0)
    let orm = sample(orm_map, uv)

    # Material properties (97 getters known in corpus)
    let rough = orm.g * roughness
    let metal = orm.b * metallic
    let emissive = albedo * emissive_strength

    # Simple lit output combining material properties
    var final_color = albedo * (1.0 - metal) + emissive
    final_color = lerp(final_color, albedo * 0.5, rough)

    return vec4(final_color, 1.0)
