# ==============================================================================
# KAIN FLOW - GOD COMPONENT SOURCE
# ==============================================================================
# This single file generates:
# 1. A complete Networking Replicated Actor (AFlowManager)
# 2. Six GPU Compute Shaders (Navier-Stokes Solver)
# 3. Blueprint Function Libraries
# 4. Data Assets and Structs
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION 1: TYPE DEFINITIONS
# ------------------------------------------------------------------------------

enum FluidMode:
    Smoke           # Density advection only
    Liquid          # Free surface tracking (Level Set)
    Fire            # Fuel + Temperature advection
    Plasma          # Magnetic field influence

enum VisualizerType:
    Density         # Show scalar field
    Velocity        # Show vector field colors
    Pressure        # Show internal pressure distribution
    Divergence      # Debug: Should always be near zero
    Vorticity       # Show curling forces

@datatable
struct FluidSimulationProfile:
    id: String
    mode: FluidMode
    viscosity: Float
    diffusion: Float
    buoyancy: Float
    vorticity_strength: Float
    dissipation: Float
    color_drift: Vec3

struct InteractionSource:
    position: Vec3
    velocity: Vec3
    radius: Float
    strength: Float
    temperature: Float
    color: Vec3
    is_active: Bool

# ------------------------------------------------------------------------------
# SECTION 2: THE MAIN SIMULATION ACTOR
# ------------------------------------------------------------------------------

@uclass("Blueprintable", "BlueprintType")
actor FlowManager:
    # --- Simulation State ---
    state resolution: Int = 256
    state time_step: Float = 0.016
    state velocity_damping: Float = 0.995
    state pressure_iterations: Int = 40
    
    # --- Physics Parameters ---
    state viscosity: Float = 0.001
    state vorticity_confinement: Float = 5.0
    state buoyancy_dir: Vec3 = vec3(0.0, 0.0, 1.0)
    state ambient_temperature: Float = 20.0
    
    # --- Interaction State (Replicated) ---
    @replicated
    state active_sources: Array<InteractionSource> = []
    
    @replicated
    state is_running: Bool = true

    # --- Visualization ---
    state viz_mode: VisualizerType = VisualizerType::Density
    state slice_depth: Float = 0.5
    state density_absorption: Float = 2.0
    
    # --- Lifecycle ---
    
    on BeginPlay():
        println("KainFlow God Component Initialized.")
        println("Allocating 3D Textures: {resolution}x{resolution}x{resolution}")
        # Underlying C++ handles RHI resource allocation here automatically
        
    on Tick(delta_time: Float):
        if is_running:
            # Update time step for stability
            time_step = min(delta_time, 0.033)
            # The compiler injects the RDG (Render Dependency Graph) Execute calls here
            # triggering the shader chain defined below.

    # --- Networking & Control ---

    on Server_ToggleSimulation(running: Bool):
        is_running = running
        Multicast_OnSimStateChanged(running)

    on Multicast_OnSimStateChanged(running: Bool):
        if running:
            println("Fluid Sim Resumed")
        else:
            println("Fluid Sim Paused")

    # --- Blueprint API ---

    @blueprint_callable
    @category("KainFlow|Interaction")
    fn InjectFluid(pos: Vec3, vel: Vec3, radius: Float, strength: Float, color: Vec3):
        var src = InteractionSource()
        src.position = pos
        src.velocity = vel
        src.radius = radius
        src.strength = strength
        src.color = color
        src.is_active = true
        active_sources.push(src)
        
    @blueprint_callable
    @category("KainFlow|Interaction")
    fn ClearSources():
        active_sources = []

    @blueprint_callable
    @category("KainFlow|Settings")
    fn LoadProfile(profile: FluidSimulationProfile):
        viscosity = profile.viscosity
        vorticity_confinement = profile.vorticity_strength
        # C++ automatically handles struct member mapping

# ------------------------------------------------------------------------------
# SECTION 3: GPU KERNELS (NAVIER-STOKES SOLVER)
# ------------------------------------------------------------------------------

# 1. Advection: Semi-Lagrangian Backtracing
shader compute AdvectionCompute(id: Vec3) -> Vec4:
    uniform velocity_tex: Sampler3D @0
    uniform target_tex: Sampler3D @1
    uniform dt: Float @2
    uniform res: Float @3
    uniform decay: Float @4
    
    let uvw = vec3(id.x / res, id.y / res, id.z / res)
    let velocity = sample(velocity_tex, uvw).xyz
    
    # Backtrace trajectory
    let back_uvw = uvw - (velocity * dt / res)
    
    # Sample previous state and apply dissipation
    let advected = sample(target_tex, back_uvw)
    return advected * decay

# 2. Vorticity Confinement: Restores swirling energy lost to numerical dissipation
shader compute VorticityCompute(id: Vec3) -> Vec4:
    uniform velocity_tex: Sampler3D @0
    uniform curl_strength: Float @1
    uniform res: Float @2
    
    let step = 1.0 / res
    let uvw = vec3(id.x / res, id.y / res, id.z / res)
    
    # Calculate Curl (Vorticity)
    let vL = sample(velocity_tex, uvw - vec3(step, 0, 0)).xyz
    let vR = sample(velocity_tex, uvw + vec3(step, 0, 0)).xyz
    let vB = sample(velocity_tex, uvw - vec3(0, step, 0)).xyz
    let vT = sample(velocity_tex, uvw + vec3(0, step, 0)).xyz
    let vD = sample(velocity_tex, uvw - vec3(0, 0, step)).xyz
    let vU = sample(velocity_tex, uvw + vec3(0, 0, step)).xyz
    
    let curl_x = (vT.z - vB.z) - (vU.y - vD.y)
    let curl_y = (vU.x - vD.x) - (vR.z - vL.z)
    let curl_z = (vR.y - vL.y) - (vT.x - vB.x)
    let curl = vec3(curl_x, curl_y, curl_z) * 0.5
    
    let curl_len = length(curl)
    
    # Apply confinement force
    return vec4(curl, curl_len)

# 3. Divergence: Calculates velocity field flux
shader compute DivergenceCompute(id: Vec3) -> Vec4:
    uniform velocity_tex: Sampler3D @0
    uniform res: Float @1
    
    let step = 1.0 / res
    let uvw = vec3(id.x / res, id.y / res, id.z / res)
    
    let vL = sample(velocity_tex, uvw - vec3(step, 0, 0)).x
    let vR = sample(velocity_tex, uvw + vec3(step, 0, 0)).x
    let vB = sample(velocity_tex, uvw - vec3(0, step, 0)).y
    let vT = sample(velocity_tex, uvw + vec3(0, step, 0)).y
    let vD = sample(velocity_tex, uvw - vec3(0, 0, step)).z
    let vU = sample(velocity_tex, uvw + vec3(0, 0, step)).z
    
    let div = 0.5 * (vR - vL + vT - vB + vU - vD)
    return vec4(div, 0, 0, 1)

# 4. Pressure: Jacobi Iteration Solver
shader compute PressureCompute(id: Vec3) -> Vec4:
    uniform pressure_tex: Sampler3D @0
    uniform divergence_tex: Sampler3D @1
    uniform res: Float @2
    
    let step = 1.0 / res
    let uvw = vec3(id.x / res, id.y / res, id.z / res)
    
    let pL = sample(pressure_tex, uvw - vec3(step, 0, 0)).x
    let pR = sample(pressure_tex, uvw + vec3(step, 0, 0)).x
    let pB = sample(pressure_tex, uvw - vec3(0, step, 0)).x
    let pT = sample(pressure_tex, uvw + vec3(0, step, 0)).x
    let pD = sample(pressure_tex, uvw - vec3(0, 0, step)).x
    let pU = sample(pressure_tex, uvw + vec3(0, 0, step)).x
    let div = sample(divergence_tex, uvw).x
    
    let p_new = (div + pL + pR + pB + pT + pD + pU) / 6.0
    return vec4(p_new, 0, 0, 1)

# 5. Gradient Subtraction: Enforces incompressibility
shader compute GradientCompute(id: Vec3) -> Vec4:
    uniform velocity_tex: Sampler3D @0
    uniform pressure_tex: Sampler3D @1
    uniform res: Float @2
    
    let step = 1.0 / res
    let uvw = vec3(id.x / res, id.y / res, id.z / res)
    
    let pL = sample(pressure_tex, uvw - vec3(step, 0, 0)).x
    let pR = sample(pressure_tex, uvw + vec3(step, 0, 0)).x
    let pB = sample(pressure_tex, uvw - vec3(0, step, 0)).x
    let pT = sample(pressure_tex, uvw + vec3(0, step, 0)).x
    let pD = sample(pressure_tex, uvw - vec3(0, 0, step)).x
    let pU = sample(pressure_tex, uvw + vec3(0, 0, step)).x
    
    let grad = vec3(pR - pL, pT - pB, pU - pD) * 0.5
    let old_vel = sample(velocity_tex, uvw).xyz
    
    return vec4(old_vel - grad, 1.0)

# 6. Source Injection: Adds forces/density from world space
shader compute SourceCompute(id: Vec3) -> Vec4:
    uniform target_tex: Sampler3D @0
    uniform source_pos: Vec3 @1
    uniform source_val: Vec3 @2
    uniform radius: Float @3
    uniform res: Float @4
    uniform is_velocity: Float @5
    
    let uvw = vec3(id.x / res, id.y / res, id.z / res)
    let dist = length(uvw - source_pos)
    
    var current = sample(target_tex, uvw)
    
    if dist < radius:
        let influence = smoothstep(radius, 0.0, dist)
        if is_velocity > 0.5:
            # For velocity, we add vector
            current = current + vec4(source_val * influence, 0.0)
        else:
            # For density, we add color
            current = current + vec4(source_val * influence, influence)
            
    return current

# ------------------------------------------------------------------------------
# SECTION 4: HELPER UTILITIES
# ------------------------------------------------------------------------------

@blueprint
fn create_default_profile() -> FluidSimulationProfile:
    var p = FluidSimulationProfile()
    p.id = "Default Smoke"
    p.mode = FluidMode::Smoke
    p.viscosity = 0.001
    p.vorticity_strength = 2.0
    p.diffusion = 0.0
    return p