// KClonerPro - Components
// Reusable component systems

// === EFFECTOR COMPONENT ===
@component
struct EffectorComponent:
    @replicated
    @category("Effector|Settings")
    settings: EffectorSettings
    
    @replicated("condition=COND_OwnerOnly")
    @category("Effector|State")
    is_active: Bool
    
    @transient
    @category("Effector|Runtime")
    current_strength: Float
    
    @category("Effector|Events")
    @blueprint_assignable
    on_effector_changed: OnEffectorChanged

// === MODIFIER COMPONENT ===
@component
struct ModifierComponent:
    @replicated
    @category("Modifier|Settings")
    settings: ModifierSettings
    
    @replicated
    @category("Modifier|State")
    enabled: Bool
    
    @transient
    @category("Modifier|Runtime")
    blend_alpha: Float
    
    @savegame
    @category("Modifier|Persistence")
    saved_state: Bool

// === TARGET COMPONENT ===
@component
struct TargetComponent:
    @replicated
    @category("Target|Transform")
    target_location: Vec3
    
    @replicated
    @category("Target|Transform")
    target_rotation: Vec3
    
    @category("Target|Settings")
    @clamp_min(0)
    @clamp_max(1)
    influence: Float
    
    @category("Target|Settings")
    @units("cm")
    radius: Float
