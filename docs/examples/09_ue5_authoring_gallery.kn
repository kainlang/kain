@gameplay_tags
namespace Docs:
    Ability:
        Jump
        Scan
    Status:
        Ready
        Busy
    Cue:
        Flash
    Effect:
        Focus

@graph_editor
graph DocsCombatGraph:
    @node_type
    @category("Docs/Input")
    node InputNode:
        outputs:
            Execute: Exec
            Strength: Float = 5.0

    @node_type
    @category("Docs/Output")
    node OutputNode:
        inputs:
            Execute: Exec
            Strength: Float

@graph_runtime
struct DocsRuntimeGraph:
    @node_data
    struct StepNode:
        @input_pin
        execute: Exec

        @output_pin
        success: Exec

        fn execute(instance: GraphInstance) -> NodeData:
            return get_node(success)

    @instance
    struct Instance:
        current_node: NodeData

        fn trigger() -> Bool:
            return try_proceed_graph()

@state_machine
struct DocsWorkflowStateMachine:
    @state(entry: true)
    struct Idle:
        animation: "Idle"

        @transition(to: "Ready")
        fn should_ready() -> Bool:
            return true

    @state
    struct Ready:
        animation: "Ready"

        @transition(to: "Idle")
        fn should_reset() -> Bool:
            return false

@material_graph
material DocsMaterial:
    input roughness: Float = 0.4
    input tint: Vec3 = vec3(0.2, 0.5, 0.9)

    output base_color = tint
    output roughness = roughness
    output metallic = 0.0

@ability
struct DocsJumpAbility:
    @instancing(policy: "InstancedPerExecution")
    @replication(policy: "ReplicateYes")
    @net_execution(policy: "LocalPredicted")

    @ability_tags
    tags: ["Docs.Ability.Jump"]

    @activation_required_tags
    required: ["Docs.Status.Ready"]

    fn activate_ability(handle, actor_info, activation_info, trigger_event_data):
        let activated: Bool = true

@gameplay_effect
struct DocsFocusEffect:
    @duration_policy
    policy: "Instant"

    @modifiers
    modifiers:
        - attribute: "FocusSet.Score"
          operation: "Add"
          magnitude: 5.0

    @owned_tags
    tags: ["Docs.Effect.Focus"]

@gameplay_cue
struct DocsFlashCue:
    @tag
    tag: "GameplayCue.Docs.Flash"

    @type
    cue_type: "Static"

    @on_execute
    fn on_execute():
        let fired: Bool = true

fn main() -> Int:
    return 0
