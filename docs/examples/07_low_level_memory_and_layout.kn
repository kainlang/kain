fn main() -> Int:
    let stride: Int = sizeof_type("Int")
    let mut base: ptr<Int> = alloc_zeroed((2 * stride), "Int")
    let tail: ptr<Int> = ptr_offset(base, 1, "Int")

    mem_store(base, 7, "Int")
    mem_store(tail, 4, "Int")

    let first: Int = mem_load(base, "Int")
    let second: Int = mem_load(tail, "Int")
    let total = first + second

    println(f"memory_total={total}")

    if total == 11:
        return 0

    return 1
