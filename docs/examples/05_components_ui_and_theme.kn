component App():
    render <slot layout="column" gap={14} padding={16}>
        <theme name="docs_examples_showcase">
            <token name="theme.chrome.topbar.visible" category="chrome" value={false} />
            <token name="theme.spacing.scale" category="space" value={1.02} />
            <token name="theme.radius.scale" category="surface" value={1.18} />
            <token name="theme.background.top" category="color" value="#0c1321" />
            <token name="theme.background.bottom" category="color" value="#111a2d" />
            <token name="theme.surface.base" category="color" value="#162238" />
            <token name="theme.surface.raised" category="color" value="#21314d" />
            <token name="theme.accent.primary" category="color" value="#68d5ff" />
            <token name="theme.highlight" category="color" value="#ffc76d" />
            <token name="theme.text.default" category="color" value="#f6fbff" />
            <token name="theme.text.muted" category="color" value="#9cb3c8" />
        </theme>
        <panel title="Docs Example UI" scope="docs" variant="card" layout="column" gap={6}>
            <text role="hero">Ultimate Kain Example Suite</text>
            <text role="caption">Component, theme, tokens, panels, text roles, and slot layout in one file.</text>
        </panel>
        <slot layout="row" gap={12}>
            <panel title="Signals">
                <text role="caption">native_ui and web surfaces can both point here.</text>
            </panel>
            <panel title="Status">
                <text role="caption">Build this file to Rust to prove UI bundle lowering.</text>
            </panel>
        </slot>
    </slot>
