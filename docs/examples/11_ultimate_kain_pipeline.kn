const DEFAULT_OUTPUT_FOLDER: String = "ultimate_kain_pipeline"

type JobId = Int

enum AssetKind:
    Script
    Shader
    UiSurface

struct PipelineJob:
    id: JobId
    name: String
    kind: AssetKind
    revision: Int

trait SummaryLine:
    fn summary_line(_self: Self_) -> String:
        let __trait_placeholder = none

fn asset_kind_name(kind: AssetKind) -> String:
    match kind:
        AssetKind::Script => "script"
        AssetKind::Shader => "shader"
        AssetKind::UiSurface => "ui_surface"
        _ => "unknown"

impl SummaryLine for PipelineJob:
    fn summary_line(_self: Self_) -> String:
        return f"{_self.name}#{_self.id}:{asset_kind_name(_self.kind)}@r{_self.revision}"

actor AuditLog:
    state touched: Int = 0

    on Record():
        self.touched = self.touched + 1

component App():
    render <slot layout="column" gap={12} padding={14}>
        <panel title="Ultimate Kain Pipeline" scope="docs" variant="card" layout="column" gap={4}>
            <text role="hero">One authored file: data model, actor, world, UI, patch, law, converge, and orchestrate.</text>
            <text role="caption">The filesystem lane writes a manifest while the runtime lane keeps the world state coherent.</text>
        </panel>
    </slot>

world DocumentationPipeline:
    state job_count: Int = 0
    state last_revision: Int = 0
    surface native_ui => App
    surface web => App
    surface viewport3d => "DocsPreview"
    surface ue5 => "DocsBridge"

fn example_root() -> String:
    let configured = env("KAIN_DOCS_EXAMPLE_ROOT").trim()
    if len(configured) == 0:
        return path_join("/tmp", DEFAULT_OUTPUT_FOLDER)
    return configured

fn materialize_job_manifest(job: PipelineJob) -> String:
    let root = path_join(example_root(), "11_ultimate_pipeline")
    let manifest_path = path_join(root, "job_manifest.txt")
    let manifest_body = f"{job.summary_line()}\n"
    create_dir_all(root)
    write_file(manifest_path, manifest_body)
    return read_file(manifest_path)

patch register_job(pipeline: DocumentationPipeline, job: PipelineJob) -> Int:
    pipeline.job_count = pipeline.job_count + 1
    pipeline.last_revision = job.revision
    return pipeline.job_count

law ready_to_publish(job_count: Int, candidate_revision: Int) -> Bool:
    return job_count > 0 and candidate_revision > 0

converge choose_revision(seed: Int) -> Int:
    spec reference:
        return seed + 1
    fast interpret_lane when target("interpret"):
        return seed + 1

fn finalize_revision(value: Int) -> Int:
    return value + 1

orchestrate publish_pipeline(seed: Int) -> Int:
    let converged: Int = kain choose_revision(seed)
    let finalized: Int = kain finalize_revision(converged)
    return finalized

fn main() -> Int:
    let audit = spawn AuditLog()
    send audit.Record()

    let job = PipelineJob { id: 7, name: "docs/examples", kind: AssetKind::UiSurface, revision: 5 }
    let pipeline = DocumentationPipeline
    let active_jobs = register_job(pipeline, job)
    send audit.Record()

    let manifest_snapshot = materialize_job_manifest(job)
    let publish_revision = publish_pipeline(job.revision)

    if ready_to_publish(active_jobs, publish_revision):
        println(job.summary_line())
        println(manifest_snapshot)
        println(f"published_revision={publish_revision}")
        if publish_revision == 7 and len(manifest_snapshot) > 0:
            return 0

    return 1
