const DEFAULT_ROOT: String = "kain_docs_examples"

fn docs_example_root() -> String:
    let configured = env("KAIN_DOCS_EXAMPLE_ROOT").trim()
    if len(configured) == 0:
        return path_join("/tmp", DEFAULT_ROOT)
    return configured

fn main() -> Int:
    let root = docs_example_root()
    let sample_dir = path_join(root, "03_filesystem")
    let input_path = path_join(sample_dir, "draft.note")
    let copied_path = path_join(sample_dir, "draft.copy.note")

    create_dir_all(sample_dir)
    write_file(input_path, "kain docs pipeline")
    let body = read_file(input_path)
    copy_file(input_path, copied_path)

    let entries = read_dir(sample_dir)
    println(f"entries={len(entries)} file={path_file_name(copied_path)} ext={path_extension(copied_path)}")

    if file_exists(copied_path) && len(body) > 0:
        remove_file(input_path)
        remove_file(copied_path)
        return 0

    return 1
