#   variable_2_default: 50.0
#   variable_2_min: 0.0
#   variable_2_max: 200.0
#   step: 0.0
#   speed_multiplier: 1.0

# Expression Syntax Reference:
# - Operators: +, -, *, /, %, ^, :=, +=, -=, *=, /=
# - Functions: sin, cos, tan, asin, acos, atan, atan2, abs, floor, ceil, round
#              clamp, min, max, sqrt, pow, exp, log, log10, fmod, frac
#              lerp, smoothstep, noise
# - Variables: t (time), i (index), n (count), x/y/z (position),
#              rx/ry/rz (rotation), sx/sy/sz (scale), v0/v1/v2... (user vars)
# - Statements: Multiple statements separated by semicolons
# - Assignment: := (set), += (add), -= (subtract), *= (multiply), /= (divide)

