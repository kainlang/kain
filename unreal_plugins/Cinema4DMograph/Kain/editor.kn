# ============================================================================
# SECTION 12: VALIDATION UTILITIES - Editor-only validation tools
# ============================================================================

# VAT Normal Validation:
# - Spawns test actors with VAT materials
# - Rotates instances and validates normal vectors
# - Checks for correct tangent space transformations
# - Reports errors to the output log

# Texture Sampling Validation:
# - Tests position texture sampling accuracy
# - Tests normal texture sampling accuracy
# - Validates UV coordinate calculations
# - Compares CPU vs GPU results

# These utilities are called from the level editor menu extensions
# and help debug VAT baking issues during development

# ============================================================================
# SECTION 13: EXPRESSION PRESET EXAMPLES
# ============================================================================

# Example 1: Spiral Wave Motion
# ExpressionModifierPreset:
#   display_name: "Spiral Wave"
#   category: "Motion"
#   description: "Creates a spiraling wave motion with adjustable amplitude and frequency"
#   position_expression: "x += sin(t * v0 + i * v1) * v2; y += cos(t * v0 + i * v1) * v2; z += sin(t * v0) * 50.0;"
#   rotation_expression: "ry += t * 45.0 + i * v1;"
#   scale_expression: "sx *= 1.0 + sin(t * v0 + i * 0.2) * 0.3; sy := sx; sz := sx;"
#   variable_0_name: "Speed"
#   variable_0_default: 2.0
#   variable_0_min: 0.1
#   variable_0_max: 10.0
#   variable_1_name: "Spacing"
#   variable_1_default: 0.2
#   variable_1_min: 0.01
#   variable_1_max: 1.0
#   variable_2_name: "Amplitude"
#   variable_2_default: 100.0
#   variable_2_min: 10.0
#   variable_2_max: 500.0
#   step: 0.1
#   speed_multiplier: 1.0

# Example 2: Pulsing Grid
# ExpressionModifierPreset:
#   display_name: "Pulsing Grid"
#   category: "Motion"
#   description: "Grid pattern with pulsing scale based on distance from center"
#   position_expression: ""
#   rotation_expression: ""
#   scale_expression: "let dist = sqrt(x*x + y*y); sx *= 1.0 + sin(t * v0 - dist * v1) * v2; sy := sx; sz := sx;"
#   variable_0_name: "Frequency"
#   variable_0_default: 3.0
#   variable_0_min: 0.1
#   variable_0_max: 10.0
#   variable_1_name: "Wave Speed"
#   variable_1_default: 0.01
#   variable_1_min: 0.001
#   variable_1_max: 0.1
#   variable_2_name: "Intensity"
#   variable_2_default: 0.5
#   variable_2_min: 0.0
#   variable_2_max: 2.0
#   step: 0.0
#   speed_multiplier: 1.0

# Example 3: Orbital Dance
# ExpressionModifierPreset:
#   display_name: "Orbital Dance"
#   category: "Sci-Fi"
#   description: "Instances orbit around their original position with varying speeds"
#   position_expression: "let angle = t * v0 + i * v1; let radius = v2; x += cos(angle) * radius; y += sin(angle) * radius;"
#   rotation_expression: "rz += t * v0 * 10.0;"
#   scale_expression: "sx *= 1.0 + sin(t * v0 * 2.0) * 0.2; sy := sx; sz := sx;"
#   variable_0_name: "Orbit Speed"
#   variable_0_default: 1.0
#   variable_0_min: 0.1
#   variable_0_max: 5.0
#   variable_1_name: "Phase Offset"
