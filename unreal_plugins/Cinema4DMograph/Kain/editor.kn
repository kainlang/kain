#   rotation_expression: "rx += noise(i * 0.1 + t * v1) * 45.0; ry += noise(i * 0.1 + t * v1 + 50.0) * 45.0;"
#   scale_expression: ""
#   variable_0_name: "Frequency"
#   variable_0_default: 0.01
#   variable_0_min: 0.001
#   variable_0_max: 0.1
#   variable_1_name: "Speed"
