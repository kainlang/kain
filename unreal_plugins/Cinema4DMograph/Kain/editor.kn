        println("Bake operation complete")
    
    @separator
    
    @toggle(label: "Show Grid", default: true)
    fn on_toggle_grid(enabled: Bool):
        println("Grid visibility: {enabled}")
    
    @toggle(label: "Show Floor", default: false)
    fn on_toggle_floor(enabled: Bool):
        println("Floor visibility: {enabled}")
    
    @separator
    
    @dropdown(label: "Quality", options: ["Low", "Medium", "High", "Ultra"])
    fn on_quality_changed(quality: String):
        println("Preview quality: {quality}")

# ============================================================================
# SECTION 9: BAKE SETTINGS DIALOG - Modal dialog for animation baking
# ============================================================================

@slate
struct BakeSettingsDialog:
    @property
    duration: Float
    
    @property
    frame_rate: Float
    
    @property
    confirmed: Bool
    
    fn construct() -> Widget:
        return VBox(
            padding, 10.0,
            
            # Title
            Text(
                text, "Bake Animation Settings",
                font, "TitleFont",
                padding, vec2(0.0, 10.0)
            ),
            
            # Duration setting
            HBox(
                padding, 5.0,
                Text(
                    text, "Duration (seconds):",
                    width, 150.0,
                    alignment, "CenterLeft"
                ),
                NumericEntry(
                    value, duration,
                    min, 0.1,
                    max, 600.0,
                    slider_min, 1.0,
                    slider_max, 60.0,
                    on_value_changed, on_duration_changed,
                    allow_spin, true
                )
            ),
            
            # Frame rate setting
            HBox(
                padding, 5.0,
                Text(
                    text, "Frame Rate (FPS):",
                    width, 150.0,
                    alignment, "CenterLeft"
                ),
                ComboBox(
                    options, ["15", "24", "30", "60"],
                    selected, "30",
                    on_selection_changed, on_fps_changed
                )
            ),
            
            Spacer(height, 20.0),
            
            # Buttons
            HBox(
                alignment, "Right",
                padding, 10.0,
                Button(
                    label, "Cancel",
                    on_click, on_cancel,
                    padding, vec2(5.0, 0.0)
                ),
                Button(
                    label, "Bake",
                    style, "PrimaryButton",
                    on_click, on_confirm,
                    padding, vec2(5.0, 0.0)
                )
            )
        )
    
    fn on_duration_changed(new_duration: Float):
        duration = clamp(new_duration, 0.1, 600.0)
    
    fn on_fps_changed(new_fps: String):
        frame_rate = parse_float(new_fps)
    
    fn on_cancel():
        confirmed = false
        println("Bake cancelled")
    
    fn on_confirm():
        confirmed = true
        println("Bake confirmed: duration={duration}, fps={frame_rate}")

# ============================================================================
# SECTION 10: ASSET TYPE ACTIONS - Content browser integration
# ============================================================================

# Note: Asset type actions are typically registered in the editor module
# and handle:
# - Asset creation (factory)
# - Asset opening (double-click behavior)
# - Context menu actions
# - Asset category assignment
# - Thumbnail rendering
# - Asset validation

# These are handled by the editor module registration and don't require
# explicit KAIN definitions, but are documented here for completeness:

# ClonerData Asset Actions:
# - Category: K-Studio
# - Color: Orange
# - Can create new assets
# - Opens in ClonerAssetEditor on double-click
# - Context menu: Duplicate, Rename, Delete, Validate

# ModifierPreset Asset Actions:
# - Category: K-Studio
# - Color: Blue
# - Can create new presets
# - Opens in property editor on double-click
# - Context menu: Apply to Selected Cloner, Duplicate, Rename, Delete

# ============================================================================
# SECTION 11: SEQUENCER INTEGRATION - Custom track editor for modifiers
# ============================================================================

# Note: Sequencer track editor for K-Cloner modifiers
# Allows keyframing of modifier properties in Sequencer timeline
# Registered in the editor module startup

# Track Features:
# - Displays all modifiers in the stack
# - Exposes interpolatable properties (influence, speed, offsets)
# - Supports keyframe editing with curves
# - Integrates with the "Quick Key" buttons in details panel

# Track Structure:
# ClonerActor
#   └─ K-Cloner Modifier Track
#       ├─ Orbit Modifier
#       │   ├─ Influence (0.0 - 1.0)
#       │   ├─ Speed (0.0 - 10.0)
#       │   └─ Radius (0.0 - 1000.0)
#       ├─ Float Modifier
#       │   ├─ Influence (0.0 - 1.0)
#       │   ├─ Speed (0.0 - 10.0)
#       │   └─ Amplitude (0.0 - 100.0)
#       └─ Pulse Modifier
#           ├─ Influence (0.0 - 1.0)
#           ├─ Speed (0.0 - 10.0)
#           └─ Scale (0.0 - 5.0)

# ============================================================================
# SEQUENCER IMPLEMENTATION NOTES
# ============================================================================

# The Sequencer integration is implemented in C++ using UE5's MovieScene API:
#
# 1. UMovieSceneKClonerModifierTrack (UMovieSceneNameableTrack)
#    - Represents the track in the Sequencer timeline
#    - Contains one or more sections
#    - Registered with ISequencerModule
#
# 2. UMovieSceneKClonerModifierSection (UMovieSceneSection)
#    - Stores keyframe data for all modifier properties
#    - Contains FMovieSceneFloatChannel, FMovieSceneBoolChannel, FMovieSceneVectorChannel
#    - Each channel is bound to a specific modifier property via GUID + PropertyName
#
# 3. FKClonerModifierSectionTemplate (FMovieSceneEvalTemplate)
#    - THE CRITICAL COMPONENT - this is the evaluation engine
#    - Called every frame during Sequencer playback
#    - Reads keyframe values from channels
#    - Applies values to modifier properties using reflection (FProperty)
#    - Marks actor as dirty to trigger instance rebuild
#
# 4. Property Binding
#    - Each modifier has a unique FGuid (ModifierGuid)
#    - Properties are identified by FName (PropertyName)
#    - Channels store keyframes as FFrameNumber → Value pairs
#    - Evaluation uses FFrameTime for sub-frame interpolation
#
# 5. Keyframing Workflow
#    - User clicks "Key All" button in Details panel
#    - Calls KeyAllModifierPropertiesAtCurrentTime()
#    - Gets current Sequencer playhead time
#    - Iterates all modifiers and their Interp properties
#    - Creates/updates keyframes in the appropriate channels
#    - Sequencer UI updates automatically
#
# 6. Playback Workflow
#    - Sequencer evaluates all tracks at current time
#    - Calls FKClonerModifierSectionTemplate::Evaluate()
#    - Template creates execution tokens
#    - Tokens execute and call UMovieSceneKClonerModifierSection::EvaluateAndApply()
#    - EvaluateAndApply reads channel values and sets modifier properties
#    - Actor rebuilds instances with new modifier values
#
# 7. Channel Types
#    - FMovieSceneFloatChannel: Float properties (Influence, Speed, Radius, etc.)
#    - FMovieSceneBoolChannel: Bool properties (Enabled, Invert, etc.)
#    - FMovieSceneVectorChannel: FVector properties (Position, Rotation, Scale offsets)
#      - Stored as 3 separate FMovieSceneFloatChannel (X, Y, Z)
#
# 8. Reflection Usage
#    - FindPropertyByName() to locate properties at runtime
#    - CastField<FFloatProperty>() to get typed property access
#    - SetPropertyValue_InContainer() to write values
#    - Handles Float, Double, Bool, and FVector types
#
# 9. Performance Considerations
#    - Evaluation happens every frame during playback
#    - Only modified properties trigger actor rebuild
#    - bAnyChanged flag prevents unnecessary rebuilds
#    - Channel evaluation is highly optimized (binary search)
#
# 10. Editor Integration
#     - Track editor registered with ISequencerModule::RegisterTrackEditor()
#     - Custom UI for modifier properties
#     - Color-coded channels (Influence = green, Speed = blue, etc.)
#     - Curve editor support for all float channels
#     - Copy/paste keyframes between modifiers
#
# KAIN DOES NOT GENERATE SEQUENCER CODE
# The Sequencer integration is too complex and UE5-specific to generate.
# Instead, KAIN provides:
# - Blueprint functions for keyframing (KeyModifierProperty, etc.)
# - Editor UI for "Quick Key" buttons
# - Utility functions for preset management
# - Documentation for manual C++ implementation
#
