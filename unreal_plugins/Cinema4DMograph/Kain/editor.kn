# ============================================================================
# SECTION 2: CLONER ACTOR DETAILS - Custom details panel for ClonerActor
# ============================================================================

@details
struct ClonerActorDetails:
    # Properties being customized
    selected_cloner: ClonerActor
    
    # Sequencer Quick Key Section
    # Adds buttons to quickly keyframe modifier properties without scrolling
    # through the sequencer track list
    
    @category(name: "K-Cloner|Sequencer Quick Key", priority: "Important")
    @custom_row(label: "Quick Keyframe Info")
    fn render_quick_key_info() -> Widget:
        return Text(
            text, "Click to key all Interp properties of a modifier at the current Sequencer playhead:",
            color, color("subdued"),
            font, "DetailFont"
        )
    
    # Dynamic buttons for each modifier in the stack
    @category(name: "K-Cloner|Sequencer Quick Key", priority: "Important")
    @custom_row(label: "Modifier Quick Keys")
    fn render_modifier_quick_keys() -> Widget:
        return VBox(
            # For each modifier, create a row with name and "Key All" button
            # This is generated dynamically based on the modifier stack
            Text(text, "Orbit Modifier", font, "DetailFont"),
            Button(
                label, "Key All",
                on_click, on_quick_key_orbit,
                tooltip, "Key all interpolatable properties for Orbit Modifier",
                enabled, IsSequencerOpen()
            ),
            Text(text, "Float Modifier", font, "DetailFont"),
            Button(
                label, "Key All",
                on_click, on_quick_key_float,
                tooltip, "Key all interpolatable properties for Float Modifier",
                enabled, IsSequencerOpen()
            ),
            Text(text, "Pulse Modifier", font, "DetailFont"),
            Button(
                label, "Key All",
                on_click, on_quick_key_pulse,
                tooltip, "Key all interpolatable properties for Pulse Modifier",
                enabled, IsSequencerOpen()
            )
        )
    
    fn on_quick_key_orbit():
        println("Quick keying Orbit Modifier properties")
        # Keys all interpolatable properties of the Orbit modifier
        # at the current Sequencer playhead position
        KeyAllModifierPropertiesAtCurrentTime(selected_cloner)
    
    fn on_quick_key_float():
        println("Quick keying Float Modifier properties")
        # Keys all interpolatable properties of the Float modifier
        KeyAllModifierPropertiesAtCurrentTime(selected_cloner)
    
    fn on_quick_key_pulse():
        println("Quick keying Pulse Modifier properties")
        # Keys all interpolatable properties of the Pulse modifier
        KeyAllModifierPropertiesAtCurrentTime(selected_cloner)
    
    # Modifier Preset Management Section
    @category(name: "K-Cloner|Modifier Presets", priority: "Important")
    @custom_row(label: "Preset Management")
    fn render_preset_management() -> Widget:
        return VBox(
            padding, 5.0,
            
            # Save Preset Section
            Text(
                text, "Save Current Modifier Stack:",
                font, "DetailFont",
                color, color("subdued")
            ),
            HBox(
                padding, 5.0,
                TextBox(
                    hint_text, "Enter preset name...",
                    width, 200.0
                ),
                Button(
                    label, "Save Preset",
                    on_click, on_save_preset,
                    tooltip, "Save current modifier configuration as a preset"
                )
            ),
            
            Spacer(height, 10.0),
            
            # Load Preset Section
            Text(
                text, "Load Modifier Preset:",
                font, "DetailFont",
                color, color("subdued")
            ),
            HBox(
                padding, 5.0,
                ComboBox(
                    options, ["Orbit Wave", "Pulse Grid", "Spiral Motion", "Custom..."],
                    selected, "Orbit Wave",
                    width, 200.0
                ),
                Button(
                    label, "Load Preset",
                    on_click, on_load_preset,
                    tooltip, "Load and apply selected preset"
                ),
                Button(
                    label, "Apply Preset",
                    on_click, on_apply_preset,
                    tooltip, "Add preset to existing modifiers"
                )
            ),
            
            Spacer(height, 10.0),
            
            # Preset Validation
            Button(
                label, "Validate Expression Preset",
                on_click, on_validate_preset,
                tooltip, "Check if expression preset is syntactically correct",
                style, "SimpleButton"
            )
        )
    
    fn on_save_preset():
        println("Saving modifier preset")
        # Get preset name from text box
        # Call SaveModifierPreset(selected_cloner, preset_name)
        SaveModifierPreset(selected_cloner, "MyPreset")
    
    fn on_load_preset():
        println("Loading modifier preset")
        # Get selected preset from combo box
        # Call LoadModifierPreset(selected_cloner, preset)
        # This replaces the current modifier stack
    
    fn on_apply_preset():
        println("Applying modifier preset")
        # Get selected preset from combo box
        # Call ApplyPresetToActor(selected_cloner, preset)
        # This adds to the existing modifier stack
    
    fn on_validate_preset():
        println("Validating expression preset")
        # Get selected preset
        # Call ValidateExpressionPreset(preset)
        # Display validation results in a dialog
        KeyAllModifierPropertiesAtCurrentTime(selected_cloner)
    
    # Anim Tweak Mode - Bake Animation Section
    @category(name: "K-Cloner|AnimTweak")
    @custom_row(label: "Bake Animation")
    fn render_bake_button() -> Widget:
        return HBox(
            alignment, "Center",
            Box(
                width, 250.0,
                height, 35.0,
                padding, 5.0,
                Button(
                    label, "Bake to New Animation",
                    style, "SimpleButton",
                    on_click, on_bake_animation,
                    enabled, is_bake_enabled(),
                    tooltip, "Bakes modifier motion into a new animation sequence"
                )
            )
        )
    
    fn is_bake_enabled() -> Bool:
        # Only enable if AnimTweak mode is on and we have a source animation
        return true
    
    fn on_bake_animation():
        println("Baking animation with modifiers applied")
        
        # Validate that we have a valid cloner and source animation
        if not(selected_cloner):
            println("ERROR: No cloner selected")
            return
        
        # Force a world tick to sync transforms
        println("Syncing transforms before baking")
        
        # Get source animation from the cloner
        # let source_anim = selected_cloner.get_source_animation()
        
        # Set up baking parameters
        let output_path = "/Game/Animations"
        let output_name = "BakedClonerAnim"
        
        println("Calling BakeAnimSequence utility")
        # Call the baking utility to create a new AnimSequence
        # with all modifier effects baked into the root bone
        # let result = BakeAnimSequence(selected_cloner, source_anim, output_path, output_name)
        
        # if result.success:
        #     println("Bake successful: {result.output_asset_path}")
        #     println("  Frames: {result.num_frames}")
        #     println("  Duration: {result.duration}s")
        # else:
        #     println("Bake failed: {result.error_message}")
        
        println("Animation baking complete")

