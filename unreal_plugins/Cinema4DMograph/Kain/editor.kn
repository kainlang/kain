# ============================================================================
# SECTION 4: CLONER ASSET EDITOR - Full asset editor with viewport and timeline
# ============================================================================

@asset_editor
struct ClonerAssetEditor:
    # Editor components
    @viewport
    preview_viewport: ClonerPreviewViewport
    
    @timeline
    timeline_widget: ClonerTimeline
    
    @properties
    properties_panel: ClonerProperties
    
    @toolbar
    editor_toolbar: ClonerToolbar
    
    # Editor lifecycle
    fn on_asset_opened():
        println("Opening ClonerData asset in editor")
        preview_viewport.set_cloner_data()
        properties_panel.set_object()
    
    fn on_asset_closed():
        println("Closing ClonerData asset editor")
    
    fn on_properties_changed():
        println("Properties changed, updating preview")
        preview_viewport.refresh()
    
    # Editor metadata
    fn get_toolkit_name() -> String:
        return "KCloner Editor"
    
    fn get_world_centric_tab_color() -> Vec3:
        return vec3(1.0, 1.0, 1.0)
    
    fn get_world_centric_tab_prefix() -> String:
        return "KCloner "

# ============================================================================
# SECTION 5: VIEWPORT - 3D preview viewport for cloner visualization
# ============================================================================

@viewport
struct ClonerPreviewViewport:
    # Scene components
    @scene_actor
    cloner_actor: ClonerActor
    
    @camera
    preview_camera: CameraComponent
    
    @light
    directional_light: DirectionalLightComponent
    
    @light
    sky_light: SkyLightComponent
    
    # Viewport state
    current_time: Float
    is_playing: Bool
    
    # Scene setup
    fn on_viewport_created():
        println("Setting up preview scene")
        
        # Configure lighting
        directional_light.intensity = 1.0
        sky_light.intensity = 1.2
        
        # Load environment HDRI
        # Uses DaylightAmbientCubemap for realistic lighting
        
        # Position camera
        preview_camera.position = vec3(0.0, -500.0, 200.0)
        preview_camera.look_at(vec3(0.0, 0.0, 0.0))
    
    fn set_cloner_data():
        println("Loading ClonerData into preview")
        # Updates the preview actor with new data
        # In UE5, this would receive FClonerData* via the asset editor context
        # cloner_actor.load_preset(data)
        refresh()
    
    fn refresh():
        println("Refreshing viewport")
        # Forces a rebuild of the instance transforms
    
    fn on_viewport_tick(delta: Float):
        if is_playing:
            current_time = current_time + delta
            cloner_actor.set_time(current_time)

# ============================================================================
# SECTION 6: TIMELINE - Animation timeline widget for scrubbing
# ============================================================================

@slate
struct ClonerTimeline:
    # Timeline state
    @property
    current_time: Float
    
    @property
    is_playing: Bool
    
    @property
    duration: Float
    
    # Widget construction
    fn construct() -> Widget:
        return VBox(
            # Playback controls
            HBox(
                padding, 5.0,
                Button(
                    label, "Play",
                    on_click, on_play_clicked,
                    enabled, not(is_playing),
                    icon, "Icons.Play"
                ),
                Button(
                    label, "Pause",
                    on_click, on_pause_clicked,
                    enabled, is_playing,
                    icon, "Icons.Pause"
                ),
                Button(
                    label, "Stop",
                    on_click, on_stop_clicked,
                    icon, "Icons.Stop"
                ),
                Spacer(width, 20.0),
                Text(text, "Time: {current_time}s")
            ),
            
            # Timeline scrubber
            HBox(
                padding, 5.0,
                Text(text, "0.0s"),
                Slider(
                    value, current_time,
                    min, 0.0,
                    max, duration,
                    on_value_changed, on_scrubbed,
                    fill_width, 1.0
                ),
                Text(text, "{duration}s")
            )
        )
    
    fn on_play_clicked():
        is_playing = true
        println("Timeline playing")
    
    fn on_pause_clicked():
        is_playing = false
        println("Timeline paused")
    
    fn on_stop_clicked():
        is_playing = false
        current_time = 0.0
        println("Timeline stopped")
    
    fn on_scrubbed(new_time: Float):
        current_time = new_time
        println("Scrubbed to time: {new_time}")

# ============================================================================
# SECTION 7: PROPERTIES PANEL - Details view for asset properties
