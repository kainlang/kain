// ============================================================================
// ENUMS - Type-Safe Voxel System
// ============================================================================

enum VoxelType:
    Air
    Solid
    Transparent
    Emissive
    Fluid
    Foliage

enum BiomeType:
    Plains
    Forest
    Desert
    Mountains
    Ocean
    Tundra
    Jungle
    Swamp
    Beach
    Savanna
    Cave
    Underground

enum ChunkState:
    Unloaded
    Queued
    Generating
    Meshing
    Ready
    Dirty
    Unloading

enum LODLevel:
    LOD0
    LOD1
    LOD2
    LOD3
    LOD4

enum BrushShape:
    Sphere
    Cube
    Cylinder
    Cone
    Custom

enum EditMode:
    Sculpt
    Smooth
    Flatten
    Paint
    Erosion
    Noise
    Stamp
    Cave
    Carve
    Grow

enum VoxelMaterialType:
    Stone
    Dirt
    Grass
    Sand
    Gravel
    Water
    Lava
    Wood
    Leaves
    Snow
    Ice
    Clay
    IronOre
    GoldOre
    DiamondOre
    Glass
    Brick
    Concrete
    Metal
    Obsidian

enum VoxelNoiseType:
    Perlin
    Simplex
    Worley
    Fractal
    Ridged
    Billow

enum MeshingAlgorithm:
    GreedyMesh
    MarchingCubes
    DualContouring
    NaiveCubes

enum VoxelPhysicsType:
    Static
    Falling
    Fluid
    Explosive
    Growing

enum StructureType:
    Tree
    Rock
    Grass
    Flower
    Ore
    Dungeon
    Ruin
    Village
    Cave
    Custom

enum LightingMode:
    None
    Simple
    Propagation
    Raytraced
    Global

enum CullingMode:
    None
    Frustum
    Occlusion
    Distance
    Combined

enum CompressionMode:
    None
    RLE
    Palette
    Octree

// ============================================================================
// CORE STRUCTS - Voxel Data Structures
// ============================================================================

struct Voxel:
    voxel_type: VoxelType
    material_id: Int
    light_level: Int
    metadata: Int

struct VoxelCoord:
    x: Int
    y: Int
    z: Int

struct ChunkCoord:
    x: Int
    y: Int
    z: Int

struct VoxelRaycastHit:
    hit: Bool
    position: Vec3
    normal: Vec3
    voxel_type: VoxelType
    material_id: Int
    distance: Float
    chunk_coord: ChunkCoord
    voxel_coord: VoxelCoord

struct ChunkMeshData:
    vertex_count: Int
    triangle_count: Int
    has_collision: Bool
    has_transparency: Bool
    memory_bytes: Int

struct BrushSettings:
    size: Float
    strength: Float
    falloff: Float
    shape: BrushShape
    symmetry_x: Bool
    symmetry_y: Bool
    symmetry_z: Bool
    invert: Bool

struct NoiseParams:
    frequency: Float
    amplitude: Float
    octaves: Int
    lacunarity: Float
    persistence: Float
    seed: Int
    noise_type: VoxelNoiseType

struct VoxelMaterialProperties:
    albedo: Vec3
    roughness: Float
    metallic: Float
    emissive_color: Vec3
    emissive_intensity: Float
    opacity: Float
    density: Float
    friction: Float
    restitution: Float

struct BiomeGenerationParams:
    temperature: Float
    humidity: Float
    height_scale: Float
    height_offset: Float
    noise_params: NoiseParams
    cave_frequency: Float
    ore_density: Float

struct StructureSpawnRules:
    min_height: Float
    max_height: Float
    spawn_chance: Float
    min_spacing: Float
    biome_mask: Int
    requires_surface: Bool

struct ChunkGenerationData:
    seed: Int
    biome_type: BiomeType
    height_map: Array<Float>
    density_map: Array<Float>
    cave_map: Array<Bool>
    ore_map: Array<Int>

struct LODSettings:
    lod0_distance: Float
    lod1_distance: Float
    lod2_distance: Float
    lod3_distance: Float
    lod4_distance: Float
    transition_blend: Float

struct VoxelPhysicsSettings:
    enable_falling_blocks: Bool
    enable_fluid_sim: Bool
    enable_explosions: Bool
    gravity: Float
    fluid_viscosity: Float
    explosion_radius: Float

struct PerformanceSettings:
    max_chunks_per_frame: Int
    max_mesh_updates_per_frame: Int
    async_generation: Bool
    gpu_acceleration: Bool
    memory_budget_mb: Int
    chunk_pool_size: Int

