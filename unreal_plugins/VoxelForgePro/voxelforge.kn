// ============================================================================
// COMPUTE SHADERS - GPU-Accelerated Voxel Processing
// ============================================================================

// Terrain Generation Shaders

shader compute PerlinNoise3D(thread_id: Vec3) -> Float:
    uniform CFG_HIGH_QUALITY: Float @0
    uniform frequency: Float @1
    uniform amplitude: Float @2
    uniform octaves: Int @3
    uniform position: Vec3 @4
    
    var noise_value: Float = 0.0
    var freq: Float = frequency
    var amp: Float = amplitude
    
    for i in range(octaves):
        let sample_pos = (position + thread_id) * freq
        let noise = perlin3d(sample_pos)
        noise_value = noise_value + noise * amp
        freq = freq * 2.0
        amp = amp * 0.5
    
    return noise_value

shader compute SimplexNoise3D(thread_id: Vec3) -> Float:
    uniform frequency: Float @0
    uniform amplitude: Float @1
    uniform seed: Int @2
    uniform position: Vec3 @3
    
    let sample_pos = (position + thread_id) * frequency
    let noise = simplex3d(sample_pos, seed)
    return noise * amplitude

shader compute WorleyNoise3D(thread_id: Vec3) -> Float:
    uniform frequency: Float @0
    uniform cell_jitter: Float @1
    uniform distance_type: Int @2
    uniform position: Vec3 @3
    
    let sample_pos = (position + thread_id) * frequency
    let cell = floor(sample_pos)
    var min_dist: Float = 999999.0
    
    for x in range(-1, 2):
        for y in range(-1, 2):
            for z in range(-1, 2):
                let neighbor = cell + vec3(x, y, z)
                let point = neighbor + hash3d(neighbor) * cell_jitter
                let dist = length(sample_pos - point)
                min_dist = min(min_dist, dist)
    
    return min_dist

shader compute FractalNoise(thread_id: Vec3) -> Float:
    uniform base_frequency: Float @0
    uniform amplitude: Float @1
    uniform octaves: Int @2
    uniform lacunarity: Float @3
    uniform persistence: Float @4
    uniform position: Vec3 @5
    
    var total: Float = 0.0
    var freq: Float = base_frequency
    var amp: Float = amplitude
    var max_value: Float = 0.0
    
    for i in range(octaves):
        total = total + perlin3d((position + thread_id) * freq) * amp
        max_value = max_value + amp
        freq = freq * lacunarity
        amp = amp * persistence
    
    return total / max_value

shader compute BiomeBlending(thread_id: Vec3) -> Vec4:
    uniform biome_map: Texture3D @0
    uniform blend_distance: Float @1
    uniform position: Vec3 @2
    
    let sample_pos = position + thread_id
    let biome_data = sample(biome_map, sample_pos)
    
    var blended: Vec4 = vec4(0, 0, 0, 0)
    var total_weight: Float = 0.0
    
    for x in range(-1, 2):
        for y in range(-1, 2):
            for z in range(-1, 2):
                let offset = vec3(x, y, z) * blend_distance
                let neighbor = sample(biome_map, sample_pos + offset)
                let dist = length(offset)
                let weight = 1.0 / (1.0 + dist)
                blended = blended + neighbor * weight
                total_weight = total_weight + weight
    
    return blended / total_weight

// Meshing Shaders

shader compute GreedyMeshing(thread_id: Vec3) -> Int:
    uniform CFG_OPTIMIZE_MESH: Float @0
    uniform voxel_data: Texture3D @1
    uniform chunk_size: Int @2
    uniform position: Vec3 @3
    
    let voxel = sample(voxel_data, position + thread_id)
    
    if voxel.x == 0:
        return 0
    
    var face_mask: Int = 0
    
    if sample(voxel_data, position + thread_id + vec3(1, 0, 0)).x == 0:
        face_mask = face_mask + 1
    if sample(voxel_data, position + thread_id + vec3(-1, 0, 0)).x == 0:
        face_mask = face_mask + 2
    if sample(voxel_data, position + thread_id + vec3(0, 1, 0)).x == 0:
        face_mask = face_mask + 4
    if sample(voxel_data, position + thread_id + vec3(0, -1, 0)).x == 0:
        face_mask = face_mask + 8
    if sample(voxel_data, position + thread_id + vec3(0, 0, 1)).x == 0:
        face_mask = face_mask + 16
    if sample(voxel_data, position + thread_id + vec3(0, 0, -1)).x == 0:
        face_mask = face_mask + 32
    
    return face_mask

shader compute MarchingCubes(thread_id: Vec3) -> Vec4:
    uniform CFG_SMOOTH_TERRAIN: Float @0
    uniform density_field: Texture3D @1
    uniform iso_level: Float @2
    uniform position: Vec3 @3
    
    let sample_pos = position + thread_id
    
    // Sample 8 corners of the cube (fixed-size array for shader compatibility)
    let v0 = sample(density_field, sample_pos + vec3(0, 0, 0)).x
    let v1 = sample(density_field, sample_pos + vec3(1, 0, 0)).x
    let v2 = sample(density_field, sample_pos + vec3(1, 1, 0)).x
    let v3 = sample(density_field, sample_pos + vec3(0, 1, 0)).x
    let v4 = sample(density_field, sample_pos + vec3(0, 0, 1)).x
    let v5 = sample(density_field, sample_pos + vec3(1, 0, 1)).x
    let v6 = sample(density_field, sample_pos + vec3(1, 1, 1)).x
    let v7 = sample(density_field, sample_pos + vec3(0, 1, 1)).x
    
    // Build cube index from corner values
    var cube_index: Int = 0
    if v0 < iso_level:
        cube_index = cube_index + 1
    if v1 < iso_level:
        cube_index = cube_index + 2
    if v2 < iso_level:
        cube_index = cube_index + 4
    if v3 < iso_level:
        cube_index = cube_index + 8
    if v4 < iso_level:
        cube_index = cube_index + 16
    if v5 < iso_level:
        cube_index = cube_index + 32
    if v6 < iso_level:
        cube_index = cube_index + 64
    if v7 < iso_level:
        cube_index = cube_index + 128
    
    return vec4(cube_index, 0, 0, 0)

shader compute NormalCalculation(thread_id: Vec3) -> Vec3:
    uniform density_field: Texture3D @0
    uniform position: Vec3 @1
    uniform step_size: Float @2
    
    let sample_pos = position + thread_id
    
    let dx = sample(density_field, sample_pos + vec3(step_size, 0, 0)).x - sample(density_field, sample_pos - vec3(step_size, 0, 0)).x
    let dy = sample(density_field, sample_pos + vec3(0, step_size, 0)).x - sample(density_field, sample_pos - vec3(0, step_size, 0)).x
    let dz = sample(density_field, sample_pos + vec3(0, 0, step_size)).x - sample(density_field, sample_pos - vec3(0, 0, step_size)).x
    
    return normalize(vec3(dx, dy, dz))

shader compute AmbientOcclusion(thread_id: Vec3) -> Float:
    uniform CFG_HIGH_QUALITY: Float @0
    uniform voxel_data: Texture3D @1
    uniform position: Vec3 @2
    uniform sample_radius: Float @3
    uniform sample_count: Int @4
    
    let sample_pos = position + thread_id
    var occlusion: Float = 0.0
    
    for i in range(sample_count):
        let angle = i * 6.28318 / sample_count
        let offset = vec3(cos(angle), sin(angle), 0) * sample_radius
        
        if sample(voxel_data, sample_pos + offset).x > 0:
            occlusion = occlusion + 1.0
    
    return 1.0 - (occlusion / sample_count)

// Physics & Simulation Shaders

shader compute VoxelPhysics(thread_id: Vec3) -> Int:
    uniform voxel_data: Texture3D @0
    uniform physics_types: Texture3D @1
    uniform position: Vec3 @2
    uniform delta_time: Float @3
    
    let sample_pos = position + thread_id
    let voxel = sample(voxel_data, sample_pos)
    let physics_type = sample(physics_types, sample_pos).x
    
    if physics_type == 1:
        let below = sample(voxel_data, sample_pos + vec3(0, 0, -1))
        if below.x == 0:
            return 1
    
    return 0

shader compute FluidSimulation(thread_id: Vec3) -> Vec4:
    uniform fluid_data: Texture3D @0
    uniform voxel_data: Texture3D @1
    uniform position: Vec3 @2
    uniform viscosity: Float @3
    
    let sample_pos = position + thread_id
    let current_fluid = sample(fluid_data, sample_pos)
    
    if current_fluid.x == 0:
        return vec4(0, 0, 0, 0)
    
    var flow: Vec3 = vec3(0, 0, 0)
    var neighbors: Int = 0
    
    for x in range(-1, 2):
        for y in range(-1, 2):
            for z in range(-1, 2):
                if x == 0 and y == 0 and z == 0:
                    continue
                
                let offset = vec3(x, y, z)
                let neighbor_voxel = sample(voxel_data, sample_pos + offset)
                
                if neighbor_voxel.x == 0:
                    flow = flow + offset
                    neighbors = neighbors + 1
    
    if neighbors > 0:
        flow = flow / neighbors * viscosity
    
    return vec4(flow, current_fluid.x)

shader compute LightPropagation(thread_id: Vec3) -> Int:
    uniform light_data: Texture3D @0
    uniform voxel_data: Texture3D @1
    uniform position: Vec3 @2
    uniform max_light: Int @3
    
    let sample_pos = position + thread_id
    let current_light = sample(light_data, sample_pos).x
    let voxel = sample(voxel_data, sample_pos)
    
    if voxel.x > 0:
        return current_light
    
    var max_neighbor_light: Int = 0
    
    for x in range(-1, 2):
        for y in range(-1, 2):
            for z in range(-1, 2):
                let neighbor_light = sample(light_data, sample_pos + vec3(x, y, z)).x
                max_neighbor_light = max(max_neighbor_light, neighbor_light)
    
    return max(0, max_neighbor_light - 1)

shader compute ShadowCasting(thread_id: Vec3) -> Float:
    uniform CFG_RAYTRACED_SHADOWS: Float @0
    uniform voxel_data: Texture3D @1
    uniform light_direction: Vec3 @2
    uniform position: Vec3 @3
    uniform max_distance: Float @4
    
    let sample_pos = position + thread_id
    let voxel = sample(voxel_data, sample_pos)
    
    if voxel.x == 0:
        return 1.0
    
    var ray_pos: Vec3 = sample_pos
    var shadow: Float = 1.0
    
    for i in range(32):
        ray_pos = ray_pos + light_direction
        let dist = length(ray_pos - sample_pos)
        
        if dist > max_distance:
            break
        
        let ray_voxel = sample(voxel_data, ray_pos)
        if ray_voxel.x > 0:
            shadow = shadow * 0.5
            if shadow < 0.1:
                return 0.0
    
    return shadow

// Optimization Shaders

shader compute ChunkCulling(thread_id: Vec3) -> Int:
    uniform chunk_positions: Texture3D @0
    uniform camera_position: Vec3 @1
    uniform camera_forward: Vec3 @2
    uniform view_distance: Float @3
    uniform position: Vec3 @4
    
    let chunk_pos = sample(chunk_positions, position + thread_id).xyz
    let to_chunk = chunk_pos - camera_position
    let distance = length(to_chunk)
    
    if distance > view_distance:
        return 0
    
    let dot_product = dot(normalize(to_chunk), camera_forward)
    if dot_product < -0.2:
        return 0
    
    return 1

shader compute LODGeneration(thread_id: Vec3) -> Vec4:
    uniform voxel_data: Texture3D @0
    uniform lod_level: Int @1
    uniform position: Vec3 @2
    
    let sample_pos = position + thread_id
    let step: Int = pow(2, lod_level)
    
    var voxel_sum: Vec4 = vec4(0, 0, 0, 0)
    var count: Int = 0
    
    for x in range(step):
        for y in range(step):
            for z in range(step):
                let offset = vec3(x, y, z)
                let voxel = sample(voxel_data, sample_pos * step + offset)
                voxel_sum = voxel_sum + voxel
                count = count + 1
    
    return voxel_sum / count

shader compute CompressionRLE(thread_id: Vec3) -> Vec4:
    uniform voxel_data: Texture3D @0
    uniform position: Vec3 @1
    uniform chunk_size: Int @2
    
    let sample_pos = position + thread_id
    let current_voxel = sample(voxel_data, sample_pos)
    
    var run_length: Int = 1
    var next_pos: Vec3 = sample_pos + vec3(1, 0, 0)
    
    for i in range(chunk_size):
        let next_voxel = sample(voxel_data, next_pos)
        if next_voxel.x == current_voxel.x and next_voxel.y == current_voxel.y:
            run_length = run_length + 1
            next_pos = next_pos + vec3(1, 0, 0)
        else:
            break
    
    return vec4(current_voxel.x, current_voxel.y, run_length, 0)

// Effects Shaders

shader compute VoxelExplosion(thread_id: Vec3) -> Float:
    uniform explosion_center: Vec3 @0
    uniform explosion_radius: Float @1
    uniform explosion_strength: Float @2
    uniform position: Vec3 @3
    
    let sample_pos = position + thread_id
    let to_center = sample_pos - explosion_center
    let distance = length(to_center)
    
    if distance > explosion_radius:
        return 0.0
    
    let falloff = 1.0 - (distance / explosion_radius)
    return falloff * explosion_strength

shader compute VoxelGrowth(thread_id: Vec3) -> Int:
    uniform voxel_data: Texture3D @0
    uniform growth_map: Texture3D @1
    uniform position: Vec3 @2
    uniform growth_rate: Float @3
    
    let sample_pos = position + thread_id
    let voxel = sample(voxel_data, sample_pos)
    let growth = sample(growth_map, sample_pos).x
    
    if voxel.x > 0:
        return 0
    
    var neighbor_count: Int = 0
    for x in range(-1, 2):
        for y in range(-1, 2):
            for z in range(-1, 2):
                let neighbor = sample(voxel_data, sample_pos + vec3(x, y, z))
                if neighbor.x > 0:
                    neighbor_count = neighbor_count + 1
    
    if neighbor_count > 2 and growth > growth_rate:
        return 1
    
    return 0

shader compute VoxelErosion(thread_id: Vec3) -> Float:
    uniform height_map: Texture3D @0
    uniform erosion_strength: Float @1
    uniform position: Vec3 @2
    uniform iterations: Int @3
    
    let sample_pos = position + thread_id
    var height = sample(height_map, sample_pos).x
    
    for i in range(iterations):
        var lowest_neighbor: Float = height
        var flow_dir: Vec3 = vec3(0, 0, 0)
        
        for x in range(-1, 2):
            for y in range(-1, 2):
                let neighbor_height = sample(height_map, sample_pos + vec3(x, y, 0)).x
                if neighbor_height < lowest_neighbor:
                    lowest_neighbor = neighbor_height
                    flow_dir = vec3(x, y, 0)
        
        if lowest_neighbor < height:
            let erosion = (height - lowest_neighbor) * erosion_strength
            height = height - erosion
    
    return height

// ============================================================================
// COMPONENTS - Modular Voxel Systems
// ============================================================================

@component
struct VoxelWorldComponent:
    world_seed: Int
    
    chunk_size: Int
    
    @editdefaults
    view_distance: Float
    
    @editdefaults
    lod_settings: LODSettings
    
    @editdefaults
    performance_settings: PerformanceSettings
    
    @transient
    active_chunks: Int
    
    @transient
    pending_chunks: Int

@component
struct VoxelChunkComponent:
    chunk_coord: ChunkCoord
    
    chunk_state: ChunkState
    
    lod_level: LODLevel
    
    @transient
    mesh_data: ChunkMeshData
    
    @transient
    has_collision: Bool
    
    @transient
    last_update_time: Float

@component
struct VoxelPlayerComponent:
    @editdefaults
    reach_distance: Float
    
    @editdefaults
    mining_speed: Float
    
    @editdefaults
    placement_speed: Float
    
    @transient
    selected_material: Int
    
    @transient
    current_tool: EditMode
    
    @transient
    brush_settings: BrushSettings

@component
struct VoxelPhysicsComponent:
    @editdefaults
    physics_settings: VoxelPhysicsSettings
    
    @transient
    falling_blocks: Array<VoxelCoord>
    
    @transient
    fluid_sources: Array<VoxelCoord>
    
    @transient
    pending_explosions: Array<Vec3>

@component
struct VoxelLightingComponent:
    @editdefaults
    lighting_mode: LightingMode
    
    @editdefaults
    max_light_level: Int
    
    @editdefaults
    light_propagation_speed: Float
    
    @transient
    light_sources: Array<VoxelCoord>
    
    @transient
    dirty_light_chunks: Array<ChunkCoord>

@component
struct BiomeGeneratorComponent:
    @editdefaults
    biome_scale: Float
    
    @editdefaults
    biome_blend_distance: Float
    
    @transient
    biome_cache: Array<BiomeType>

@component
struct StructureSpawnerComponent:
    @editdefaults
    structure_density: Float
    
    @editdefaults
    min_structure_spacing: Float
    
    @transient
    spawned_structures: Array<VoxelCoord>

@component
struct ChunkStreamerComponent:
    @editdefaults
    load_distance: Float
    
    @editdefaults
    unload_distance: Float
    
    @editdefaults
    priority_bias: Float
    
    @transient
    load_queue: Array<ChunkCoord>
    
    @transient
    unload_queue: Array<ChunkCoord>

@component
struct VoxelCollisionComponent:
    @editdefaults
    enable_collision: Bool
    
    @editdefaults
    collision_complexity: Int
    
    @transient
    collision_mesh_valid: Bool

@component
struct VoxelNetworkComponent:
    network_priority: Int
    
    @transient
    pending_updates: Array<VoxelCoord>
    
    @transient
    replication_queue: Array<ChunkCoord>

// ============================================================================
// ACTORS - Voxel World Entities
// ============================================================================

actor VoxelWorld:
    state world_component: VoxelWorldComponent = VoxelWorldComponent()
    state chunk_streamer: ChunkStreamerComponent = ChunkStreamerComponent()
    state biome_generator: BiomeGeneratorComponent = BiomeGeneratorComponent()
    state structure_spawner: StructureSpawnerComponent = StructureSpawnerComponent()
    state lighting: VoxelLightingComponent = VoxelLightingComponent()
    state physics: VoxelPhysicsComponent = VoxelPhysicsComponent()
    state network: VoxelNetworkComponent = VoxelNetworkComponent()
    
    @blueprint_callable
    on BeginPlay():
        println("VoxelWorld initialized")
        Server_InitializeWorld()
    
    on Server_InitializeWorld():
        println("Initializing voxel world on server")
        Multicast_WorldReady()
    
    on Multicast_WorldReady():
        println("Voxel world ready for all clients")

    @blueprint_callable
    on Tick(delta_time: Float):
        chunk_streamer.load_distance = world_component.view_distance
        world_component.active_chunks = len(chunk_streamer.load_queue)
    
    on Server_SetVoxel(x: Int, y: Int, z: Int, material_id: Int):
        println("Setting voxel at position")
        Multicast_VoxelChanged(x, y, z, material_id)
    
    on Multicast_VoxelChanged(x: Int, y: Int, z: Int, material_id: Int):
        println("Voxel changed notification")
    
    on Server_GenerateChunk(chunk_x: Int, chunk_y: Int, chunk_z: Int):
        println("Generating chunk")
        Client_ChunkGenerated(chunk_x, chunk_y, chunk_z)
    
    on Client_ChunkGenerated(chunk_x: Int, chunk_y: Int, chunk_z: Int):
        println("Chunk generation complete")

actor VoxelChunk:
    state chunk_component: VoxelChunkComponent = VoxelChunkComponent()
    state collision: VoxelCollisionComponent = VoxelCollisionComponent()
    
    @blueprint_callable
    on BeginPlay():
        println("VoxelChunk spawned")
    
    @blueprint_callable
    on GenerateMesh():
        println("Generating chunk mesh")
        chunk_component.chunk_state = ChunkState::Meshing
    
    @blueprint_callable
    on UpdateLOD(new_lod: LODLevel):
        chunk_component.lod_level = new_lod
        GenerateMesh()

actor VoxelPlayer:
    state player_component: VoxelPlayerComponent = VoxelPlayerComponent()
    state selected_voxel: VoxelCoord = VoxelCoord()
    state is_mining: Bool = false
    
    @blueprint_callable
    on BeginPlay():
        player_component.reach_distance = 500.0
        player_component.mining_speed = 1.0
        player_component.selected_material = 1
    
    @blueprint_callable
    on StartMining():
        is_mining = true
        Server_Mine(selected_voxel.x, selected_voxel.y, selected_voxel.z)
    
    @blueprint_callable
    on StopMining():
        is_mining = false
    
    on Server_Mine(x: Int, y: Int, z: Int):
        println("Mining voxel")
        Multicast_VoxelMined(x, y, z)
    
    on Multicast_VoxelMined(x: Int, y: Int, z: Int):
        println("Voxel mined effect")
    
    @blueprint_callable
    on PlaceVoxel(coord: VoxelCoord):
        Server_Place(coord.x, coord.y, coord.z, player_component.selected_material)
    
    on Server_Place(x: Int, y: Int, z: Int, material_id: Int):
        println("Placing voxel")
        Multicast_VoxelPlaced(x, y, z, material_id)
    
    on Multicast_VoxelPlaced(x: Int, y: Int, z: Int, material_id: Int):
        println("Voxel placed effect")

actor VoxelStructure:
    state structure_type: StructureType = StructureType::Tree
    state structure_size: Vec3 = vec3(5, 5, 10)
    state is_generated: Bool = false
    
    @blueprint_callable
    on BeginPlay():
        Server_GenerateStructure()
    
    on Server_GenerateStructure():
        println("Generating structure")
        is_generated = true
        Multicast_StructureGenerated()
    
    on Multicast_StructureGenerated():
        println("Structure generation complete")

actor VoxelProjectile:
    state explosion_radius: Float = 5.0
    state explosion_strength: Float = 1.0
    state has_exploded: Bool = false
    
    @blueprint_callable
    on BeginPlay():
        println("VoxelProjectile spawned")
    
    @blueprint_callable
    on Hit(hit_location: Vec3):
        if has_exploded == false:
            Server_Explode(hit_location)
    
    on Server_Explode(location: Vec3):
        has_exploded = true
        println("Explosion at location")
        Multicast_ExplosionEffect(location)
    
    on Multicast_ExplosionEffect(location: Vec3):
        println("Playing explosion effect")

