struct ExportImporter:
    @property
    filename: String
    
    @vertical_box
    fn build():
        Label(text, "Export/Import")
        Spacer(height, 8.0)
        FilenameRow()
        Spacer(height, 8.0)
        WorldButtons()
        Spacer(height, 4.0)
        ChunkButtons()
        Spacer(height, 8.0)
        Label(text, "Status: Ready")
    
    @horizontal_box
    fn FilenameRow():
        Label(text, "Filename:")
        Spacer(width, 8.0)
        TextInput(label, "Filename", tooltip, "File name for export/import")
    
    @horizontal_box
    fn WorldButtons():
        Button(text, "Export World", tooltip, "Export world to file", width, 120.0)
        Spacer(width, 8.0)
        Button(text, "Import World", tooltip, "Import world from file", width, 120.0)
    
    @horizontal_box
    fn ChunkButtons():
        Button(text, "Export Chunk", tooltip, "Export chunk to file", width, 120.0)
        Spacer(width, 8.0)
        Button(text, "Import Chunk", tooltip, "Import chunk from file", width, 120.0)

@slate
struct TerrainPresets:
    @property
    selected_preset: Int
    
    @vertical_box
    fn build():
        Label(text, "Terrain Presets")
        Spacer(height, 8.0)
        PresetList()
        Spacer(height, 8.0)
        Button(text, "Apply Preset", tooltip, "Apply selected preset", width, 120.0)
    
    @vertical_box
    fn PresetList():
        Button(text, "Flat Plains", tooltip, "Flat plains terrain", width, 150.0)
        Spacer(height, 4.0)
        Button(text, "Rolling Hills", tooltip, "Rolling hills terrain", width, 150.0)
        Spacer(height, 4.0)
        Button(text, "Mountains", tooltip, "Mountain terrain", width, 150.0)
        Spacer(height, 4.0)
        Button(text, "Islands", tooltip, "Island terrain", width, 150.0)
        Spacer(height, 4.0)
        Button(text, "Canyon", tooltip, "Canyon terrain", width, 150.0)
        Spacer(height, 4.0)
        Button(text, "Cave System", tooltip, "Cave system terrain", width, 150.0)

// ============================================================================
// DETAILS PANELS - Property Customization
// ============================================================================

@details
struct VoxelWorldDetails:
    @slider(min: 0.0, max: 10000.0)
    view_distance: Float
    
    @slider(min: 16.0, max: 64.0)
    chunk_size: Float
    
    @color_picker
    fog_color: Vec3
    
    @button(label: "Regenerate World")
    fn on_regenerate():
        println("Regenerating world")
    
    @button(label: "Optimize Memory")
    fn on_optimize():
        println("Optimizing memory")

@details
struct VoxelChunkDetails:
    @slider(min: 0.0, max: 4.0)
    lod_level: Float
    
    @button(label: "Rebuild Mesh")
    fn on_rebuild():
        println("Rebuilding chunk mesh")
    
    @button(label: "Clear Chunk")
    fn on_clear():
        println("Clearing chunk")

@details
struct VoxelMaterialDetails:
    @color_picker
    albedo_color: Vec3
    
    @slider(min: 0.0, max: 1.0)
    roughness: Float
    
    @slider(min: 0.0, max: 1.0)
    metallic: Float
    
    @color_picker
    emissive_color: Vec3
    
    @slider(min: 0.0, max: 10.0)
    emissive_intensity: Float
    
    @button(label: "Apply Material")
    fn on_apply():
        println("Applying material")

@details
struct BiomeDetails:
    @slider(min: -1.0, max: 1.0)
    temperature: Float
    
    @slider(min: 0.0, max: 1.0)
    humidity: Float
    
    @slider(min: 0.0, max: 100.0)
    height_scale: Float
    
    @slider(min: 0.001, max: 1.0)
    noise_frequency: Float
    
    @button(label: "Preview Biome")
    fn on_preview():
        println("Previewing biome")

@details
struct BrushDetails:
    @slider(min: 1.0, max: 100.0)
    size: Float
    
    @slider(min: 0.0, max: 1.0)
    strength: Float
    
    @slider(min: 0.0, max: 1.0)
    falloff: Float
    
    @button(label: "Reset Brush")
    fn on_reset():
        println("Resetting brush")

// ============================================================================
// VIEWPORTS - 3D Preview Windows
// ============================================================================

@viewport
struct VoxelEditorViewport:
    @scene_actor
    world_preview: VoxelWorld
    
    @camera
    editor_camera: CameraComponent
    
    fn on_viewport_tick(delta: Float):
        println("Viewport tick")
    
    fn on_mouse_move(x: Float, y: Float):
        println("Mouse moved")
    
    fn on_mouse_click(button: Int):
        println("Mouse clicked")

@viewport
struct NoisePreviewViewport:
    @scene_actor
    noise_plane: Actor
    
    @camera
    preview_camera: CameraComponent
    
    fn on_viewport_tick(delta: Float):
        println("Noise preview tick")

@viewport
struct StructurePreviewViewport:
    @scene_actor
    structure_preview: VoxelStructure
    
    @camera
    preview_camera: CameraComponent
    
    fn on_viewport_tick(delta: Float):
        println("Structure preview tick")

// ============================================================================
// TOOLBARS - Editor Tool Actions
// ============================================================================

@toolbar
struct VoxelEditingToolbar:
    @button(icon: "Icons.Sculpt", tooltip: "Sculpt Tool")
    fn on_sculpt():
        println("Sculpt tool activated")
    
    @button(icon: "Icons.Smooth", tooltip: "Smooth Tool")
    fn on_smooth():
        println("Smooth tool activated")
    
    @button(icon: "Icons.Flatten", tooltip: "Flatten Tool")
    fn on_flatten():
        println("Flatten tool activated")
    
    @separator
    
    @button(icon: "Icons.Paint", tooltip: "Paint Tool")
    fn on_paint():
        println("Paint tool activated")
    
    @button(icon: "Icons.Erosion", tooltip: "Erosion Tool")
    fn on_erosion():
        println("Erosion tool activated")
    
    @separator
    
    @toggle(label: "Show Grid")
    fn on_toggle_grid(enabled: Bool):
        println("Grid: {enabled}")
    
    @toggle(label: "Show Wireframe")
    fn on_toggle_wireframe(enabled: Bool):
        println("Wireframe: {enabled}")

@toolbar
struct VoxelGenerationToolbar:
    @button(icon: "Icons.Generate", tooltip: "Generate Terrain")
    fn on_generate():
        println("Generating terrain")
    
    @button(icon: "Icons.Clear", tooltip: "Clear World")
    fn on_clear():
        println("Clearing world")
    
    @separator
    
    @button(icon: "Icons.Export", tooltip: "Export World")
    fn on_export():
        println("Exporting world")
    
    @button(icon: "Icons.Import", tooltip: "Import World")
    fn on_import():
        println("Importing world")
    
    @separator
    
    @dropdown(label: "Quality")
    fn on_quality_changed(value: String):
        println("Quality: {value}")

// ============================================================================
// ASSET EDITOR - Complete Voxel Editing Suite
// ============================================================================

@asset_editor
struct VoxelForgeAssetEditor:
    @viewport
    main_viewport: VoxelEditorViewport
    
    @details
    world_properties: VoxelWorldDetails
    
    @details
    material_properties: VoxelMaterialDetails
    
    @toolbar
    editing_tools: VoxelEditingToolbar
    
    @toolbar
    generation_tools: VoxelGenerationToolbar
    
    fn on_asset_opened(asset: VoxelWorld):
        println("VoxelForge asset editor opened")
    
    fn on_asset_saved():
        println("VoxelForge asset saved")
    
    fn on_asset_closed():
        println("VoxelForge asset editor closed")

// ============================================================================
// EDITOR MODULE - VoxelForge Editor Integration
// ============================================================================

@editor_module
struct VoxelForgeEditorModule:
    @menu_entry(path: "Window/VoxelForge", label: "Open VoxelForge Editor")
    fn on_open_editor():
        println("Opening VoxelForge editor window")
    
    @menu_entry(path: "Tools/VoxelForge/Generate Terrain", label: "Generate Terrain")
    fn on_generate_terrain():
        println("Generating terrain from menu")
    
    @menu_entry(path: "Tools/VoxelForge/Import World", label: "Import World")
    fn on_import_world():
        println("Importing world from menu")
    
    @menu_entry(path: "Tools/VoxelForge/Export World", label: "Export World")
    fn on_export_world():
        println("Exporting world from menu")
    
    @toolbar_button(section: "Content", icon: "Icons.VoxelForge")
    fn on_quick_create():
        println("Quick creating voxel world")
    
    @toolbar_button(section: "Tools", icon: "Icons.Terrain")
    fn on_terrain_tools():
        println("Opening terrain tools")

