// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
StructuredBuffer<float4> in_positions;  // @0
int agent_count;  // @2
float3 camera_position;  // @3
float lod0_distance;  // @4
float lod1_distance;  // @5
float lod2_distance;  // @6

// UAV Outputs
RWBuffer out_lod_mask : register(u1);  // @1 -> u1 register

[numthreads(8, 8, 1)]
void BuildCrowdLodMaskCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= agent_count))
    {
        return;
    }
    float3 p = in_positions[idx].xyz;
    float d = length((p - camera_position));
    float lod = 2.000000;
    if ((d < lod0_distance))
    {
        lod = 0.000000;
    }
    else     if ((d < lod1_distance))
    {
        lod = 1.000000;
    }
    else     if ((d < lod2_distance))
    {
        lod = 2.000000;
    }
    else
    {
        lod = 3.000000;
    }
    out_lod_mask[idx] = float4(lod, d, 0.000000, 1.000000);
}
