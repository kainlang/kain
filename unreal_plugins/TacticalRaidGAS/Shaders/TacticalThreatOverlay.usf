// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float alert_level;  // @1
float distortion_strength;  // @2
float3 thermal_tint;  // @3

// Texture Inputs
Texture2D threat_map : register(t0);  // @0 -> t0 register
SamplerState threat_mapSampler : register(s0);

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput TacticalThreatOverlayPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float2 jitter = ((float2(sin((uv.y * 120.000000)), cos((uv.x * 90.000000))) * distortion_strength) * 0.010000);
    float2 warped_uv = (uv + jitter);
    float4 heat = threat_map.Sample(threat_mapSampler, warped_uv);
    float3 tinted = (heat.rgb * thermal_tint);
    float alpha = max(heat.r, (alert_level * 0.200000));
    FPSOutput _Result;
    _Result.Color = float4(tinted, alpha);
    return _Result;
}
