// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Texture Inputs
Texture2D albedo : register(t0);  // @0 -> t0 register
SamplerState albedoSampler : register(s0);
Texture2D lights : register(t1);  // @1 -> t1 register
SamplerState lightsSampler : register(s1);

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput K12_SovereignPBRPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float3 c = (albedo.Sample(albedoSampler, uv).rgb + lights.Sample(lightsSampler, uv).rgb);
    FPSOutput _Result;
    _Result.Color = float4(c, 1.000000);
    return _Result;
}
