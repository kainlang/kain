# ============================================================================
# MetaHumanVAT - MetaHuman Crowd & VAT Scaler
# ============================================================================
# Convert skeletal MetaHuman animations into GPU-driven Vertex Animation
# Textures for massive crowd rendering (10,000+ characters at 60 FPS)
# ============================================================================

# ============================================================================
# SECTION 1: ENUMS - VAT configuration types
# ============================================================================

enum VATCompressionMode:
    None
    BC5_Normals
    BC7_Positions
    BC7_Full
    _MAX

enum VATBakeState:
    Idle
    Analyzing
    Baking
    Compressing
    Complete
    Error
    _MAX

enum VATQualityPreset:
    Mobile
    Low
    Medium
    High
    Ultra
    Cinematic
    _MAX

enum VATPlaybackMode:
    Loop
    Once
    PingPong
    Reverse
    _MAX

# ============================================================================
# SECTION 2: DATATABLES - VAT presets and configuration
# ============================================================================

@datatable
struct VATBakeSettings:
    id: Int
    name: String
    resolution_x: Int
    resolution_y: Int
    frame_range_start: Int
    frame_range_end: Int
    compression: VATCompressionMode
    include_normals: Bool
    include_tangents: Bool
    bake_morph_targets: Bool
    bake_cloth: Bool
    lod_level: Int
    quality_preset: VATQualityPreset

@datatable
struct VATQualityProfile:
    id: Int
    name: String
    preset: VATQualityPreset
    max_resolution: Int
    compression_enabled: Bool
    target_memory_mb: Int
    target_fps: Int
    max_vertex_count: Int
    max_frame_count: Int

@datatable
struct VATMaterialSettings:
    id: Int
    name: String
    playback_mode: VATPlaybackMode
    playback_speed: Float
    frame_offset: Int
    loop_enabled: Bool
    blend_weight: Float
    normal_intensity: Float
    displacement_scale: Float

# ============================================================================
# SECTION 3: COMPONENTS - VAT baking and playback
# ============================================================================

@component
struct VATBakerComponent:
    @transient
    current_state: VATBakeState
    
    @transient
    bake_progress: Float
    
    @transient
    vertex_count: Int
    
    @transient
    frame_count: Int
    
    @transient
    estimated_memory_mb: Float
    
    @savegame
    last_bake_settings_id: Int
    
    @transient
    is_baking: Bool
    
    @transient
    error_message: String

@component
struct VATPlaybackComponent:
    @transient
    playback_mode: VATPlaybackMode
    
    @transient
    playback_speed: Float
    
    @transient
    current_frame: Float
    
    @transient
    is_playing: Bool
    
    @transient
    total_frames: Int
    
    @savegame
    loop_enabled: Bool

@component
struct VATInstancedCrowdComponent:
    @transient
    instance_count: Int
    
    @transient
    crowd_density: Float
    
    @transient
    spawn_radius: Float
    
    @transient
    animation_offset_range: Float
    
    @transient
    scale_variation: Float
    
    @savegame
    use_lod_system: Bool

# ============================================================================
# SECTION 4: COMPUTE SHADERS - VAT baking pipeline
# ============================================================================

# Main VAT baking shader - reads skeletal mesh bone matrices and writes to texture
shader compute BakeSkeletalToVAT(thread_id: Vec3) -> Unit:
    # Permutation flags
    uniform CFG_HIGH_QUALITY: Float @0
    uniform CFG_INCLUDE_NORMALS: Float @1
    uniform ENABLE_MORPH_TARGETS: Float @2
    uniform ENABLE_CLOTH: Float @3
    
    # Shader parameters
    uniform vertex_count: Int @4
    uniform frame_count: Int @5
    uniform current_frame: Int @6
    uniform bone_count: Int @7
    uniform texture_width: Int @8
    uniform texture_height: Int @9
    
    # Input buffers
    uniform bone_matrices: Buffer<Mat4> @10
    uniform vertex_positions: Buffer<Vec3> @11
    uniform vertex_normals: Buffer<Vec3> @12
    uniform bone_weights: Buffer<Vec4> @13
    uniform bone_indices: Buffer<Vec4> @14
    
    # Output texture
    uniform output_texture: RWTexture2D<Vec4> @15
    
    let vertex_id = thread_id.x
    
    if vertex_id >= vertex_count:
        return
    
    # Load vertex data
    let base_position = vertex_positions[vertex_id]
    let base_normal = vertex_normals[vertex_id]
    let weights = bone_weights[vertex_id]
    let indices = bone_indices[vertex_id]
    
    # Skin vertex position
    var skinned_position = vec3(0, 0, 0)
    var skinned_normal = vec3(0, 0, 0)
    
    # Bone 0
    if weights.x > 0.0:
        let bone_idx = int(indices.x)
        let bone_matrix = bone_matrices[bone_idx]
        skinned_position = skinned_position + (bone_matrix * vec4(base_position, 1.0)).xyz * weights.x
        if CFG_INCLUDE_NORMALS:
            skinned_normal = skinned_normal + (bone_matrix * vec4(base_normal, 0.0)).xyz * weights.x
    
    # Bone 1
    if weights.y > 0.0:
        let bone_idx = int(indices.y)
        let bone_matrix = bone_matrices[bone_idx]
        skinned_position = skinned_position + (bone_matrix * vec4(base_position, 1.0)).xyz * weights.y
        if CFG_INCLUDE_NORMALS:
            skinned_normal = skinned_normal + (bone_matrix * vec4(base_normal, 0.0)).xyz * weights.y
    
    # Bone 2
    if weights.z > 0.0:
        let bone_idx = int(indices.z)
        let bone_matrix = bone_matrices[bone_idx]
        skinned_position = skinned_position + (bone_matrix * vec4(base_position, 1.0)).xyz * weights.z
        if CFG_INCLUDE_NORMALS:
            skinned_normal = skinned_normal + (bone_matrix * vec4(base_normal, 0.0)).xyz * weights.z
    
    # Bone 3
    if weights.w > 0.0:
        let bone_idx = int(indices.w)
        let bone_matrix = bone_matrices[bone_idx]
        skinned_position = skinned_position + (bone_matrix * vec4(base_position, 1.0)).xyz * weights.w
        if CFG_INCLUDE_NORMALS:
            skinned_normal = skinned_normal + (bone_matrix * vec4(base_normal, 0.0)).xyz * weights.w
    
    # Calculate texture coordinates
    let pixel_x = vertex_id % texture_width
    let pixel_y = vertex_id / texture_width + current_frame * ((vertex_count + texture_width - 1) / texture_width)
    
    # Write position to texture (RGB = position, A = unused)
    output_texture[vec2(pixel_x, pixel_y)] = vec4(skinned_position, 1.0)
    
    # Write normal to texture if enabled
    if CFG_INCLUDE_NORMALS:
        let normal_pixel_y = pixel_y + frame_count * ((vertex_count + texture_width - 1) / texture_width)
        output_texture[vec2(pixel_x, normal_pixel_y)] = vec4(normalize(skinned_normal), 1.0)

# Texture compression shader - applies BC7 compression
shader compute CompressVATTexture(thread_id: Vec3) -> Unit:
    uniform CFG_BC7_MODE: Float @0
    uniform CFG_BC5_MODE: Float @1
    
    uniform input_texture: Texture2D<Vec4> @2
    uniform output_texture: RWTexture2D<Vec4> @3
    uniform texture_width: Int @4
    uniform texture_height: Int @5
    
    let pixel_x = thread_id.x
    let pixel_y = thread_id.y
    
    if pixel_x >= texture_width || pixel_y >= texture_height:
        return
    
    # Load 4x4 block for compression
    var block: Array<Vec4> = []
    for y in range(0, 4):
        for x in range(0, 4):
            let sample_x = min(pixel_x * 4 + x, texture_width - 1)
            let sample_y = min(pixel_y * 4 + y, texture_height - 1)
            block[y * 4 + x] = input_texture[vec2(sample_x, sample_y)]
    
    # Simplified BC7 compression (real implementation would be more complex)
    if CFG_BC7_MODE:
        # Average the block
        var avg = vec4(0, 0, 0, 0)
        for i in range(0, 16):
            avg = avg + block[i]
        avg = avg / 16.0
        output_texture[vec2(pixel_x, pixel_y)] = avg

# ============================================================================
# SECTION 5: ACTORS - VAT preview and crowd spawner
# ============================================================================

@dispatch("BakeSkeletalToVAT")
actor VATPreviewActor:
    @replicated
    state is_baking: Bool = false
    
    @replicated
    state bake_progress: Float = 0.0
    
    @component
    state baker: VATBakerComponent = VATBakerComponent()
    
    @component
    state playback: VATPlaybackComponent = VATPlaybackComponent()
    
    state skeletal_mesh_path: String = ""
    state animation_path: String = ""
    state output_texture_path: String = ""
    
    on BeginPlay():
        println("VATPreviewActor initialized")
        baker.current_state = VATBakeState::Idle
        baker.bake_progress = 0.0
        playback.playback_speed = 1.0
        playback.loop_enabled = true
    
    on Tick(delta_time: Float):
        if is_baking:
            # Shader dispatch happens automatically via @dispatch
            bake_progress = baker.bake_progress
            
            if bake_progress >= 100.0:
                Server_CompleteBaking()
        
        # Update playback
        if playback.is_playing:
            playback.current_frame = playback.current_frame + delta_time * playback.playback_speed * 30.0
            
            if playback.current_frame >= playback.total_frames:
                if playback.loop_enabled:
                    playback.current_frame = 0.0
                else:
                    playback.is_playing = false
    
    on Server_StartBaking(settings_id: Int):
        if !is_baking:
            is_baking = true
            baker.current_state = VATBakeState::Analyzing
            baker.bake_progress = 0.0
            baker.last_bake_settings_id = settings_id
            Multicast_AnnounceBakeStart(settings_id)
    
    on Server_StopBaking():
        is_baking = false
        baker.current_state = VATBakeState::Idle
        Multicast_AnnounceBakeStop()
    
    on Server_CompleteBaking():
        is_baking = false
        baker.current_state = VATBakeState::Complete
        baker.bake_progress = 100.0
        Multicast_AnnounceBakeComplete()
    
    on Client_UpdateBakeProgress(progress: Float):
        baker.bake_progress = progress
    
    on Multicast_AnnounceBakeStart(settings_id: Int):
        println("VAT baking started with settings ID: {settings_id}")
    
    on Multicast_AnnounceBakeStop():
        println("VAT baking stopped")
    
    on Multicast_AnnounceBakeComplete():
        println("VAT baking complete!")
    
    @blueprint_callable
    fn GetBakeProgress() -> Float:
        return baker.bake_progress
    
    @blueprint_callable
    fn GetEstimatedMemory() -> Float:
        return baker.estimated_memory_mb
    
    @blueprint_pure
    fn IsBaking() -> Bool:
        return is_baking

actor VATCrowdSpawner:
    @replicated
    state crowd_size: Int = 100
    
    @replicated
    state spawn_radius: Float = 1000.0
    
    @component
    state crowd: VATInstancedCrowdComponent = VATInstancedCrowdComponent()
    
    state vat_mesh_path: String = ""
    state vat_texture_path: String = ""
    
    on BeginPlay():
        println("VATCrowdSpawner initialized")
        crowd.instance_count = 0
        crowd.crowd_density = 1.0
        crowd.spawn_radius = spawn_radius
        crowd.animation_offset_range = 1.0
        crowd.scale_variation = 0.1
    
    on Server_SpawnCrowd(count: Int):
        crowd_size = count
        crowd.instance_count = count
        Multicast_AnnounceSpawn(count)
    
    on Server_ClearCrowd():
        crowd.instance_count = 0
        Multicast_AnnounceClear()
    
    on Multicast_AnnounceSpawn(count: Int):
        println("Spawned {count} crowd instances")
    
    on Multicast_AnnounceClear():
        println("Crowd cleared")
    
    @blueprint_callable
    fn GetCrowdSize() -> Int:
        return crowd.instance_count
    
    @blueprint_callable
    fn SetSpawnRadius(radius: Float):
        spawn_radius = radius
        crowd.spawn_radius = radius

# ============================================================================
# SECTION 6: BLUEPRINT FUNCTIONS - VAT utilities
# ============================================================================

@blueprint
fn CalculateVATTextureSize(vertex_count: Int, frame_count: Int) -> Vec2:
    # Calculate optimal texture dimensions
    # Each vertex needs 1 pixel, arranged in rows
    let pixels_needed = vertex_count * frame_count
    
    # Find nearest power-of-2 square texture
    var width = 512
    while width * width < pixels_needed:
        width = width * 2
    
    let height = (pixels_needed + width - 1) / width
    
    return vec2(width, height)

@blueprint
fn EstimateMemoryUsage(resolution: Vec2, compression: VATCompressionMode, include_normals: Bool) -> Float:
    let pixel_count = resolution.x * resolution.y
    var bytes_per_pixel = 16.0  # RGBA32F uncompressed
    
    match compression:
        VATCompressionMode::BC5_Normals => bytes_per_pixel = 1.0
        VATCompressionMode::BC7_Positions => bytes_per_pixel = 1.0
        VATCompressionMode::BC7_Full => bytes_per_pixel = 1.0
        _ => bytes_per_pixel = 16.0
    
    var total_bytes = pixel_count * bytes_per_pixel
    
    if include_normals:
        total_bytes = total_bytes * 2.0
    
    # Convert to MB
    return total_bytes / (1024.0 * 1024.0)

@blueprint
fn ValidateSkeletalMesh(vertex_count: Int, bone_count: Int) -> Bool:
    # Check if mesh is suitable for VAT baking
    if vertex_count <= 0 || vertex_count > 131072:
        return false
    
    if bone_count <= 0 || bone_count > 256:
        return false
    
    return true

@blueprint_pure
fn GetQualityPresetResolution(preset: VATQualityPreset) -> Int:
    match preset:
        VATQualityPreset::Mobile => 512
        VATQualityPreset::Low => 1024
        VATQualityPreset::Medium => 2048
        VATQualityPreset::High => 4096
        VATQualityPreset::Ultra => 8192
        VATQualityPreset::Cinematic => 8192
        _ => 2048

@blueprint
fn CalculateBakeTime(vertex_count: Int, frame_count: Int, quality: VATQualityPreset) -> Float:
    # Estimate baking time in seconds
    let base_time = (vertex_count * frame_count) / 1000000.0
    
    var quality_multiplier = 1.0
    match quality:
        VATQualityPreset::Mobile => quality_multiplier = 0.5
        VATQualityPreset::Low => quality_multiplier = 0.75
        VATQualityPreset::Medium => quality_multiplier = 1.0
        VATQualityPreset::High => quality_multiplier = 1.5
        VATQualityPreset::Ultra => quality_multiplier = 2.0
        VATQualityPreset::Cinematic => quality_multiplier = 3.0
        _ => quality_multiplier = 1.0
    
    return base_time * quality_multiplier

@blueprint
fn FormatMemorySize(memory_mb: Float) -> String:
    if memory_mb < 1.0:
        let kb = memory_mb * 1024.0
        return "{kb} KB"
    else if memory_mb < 1024.0:
        return "{memory_mb} MB"
    else:
        let gb = memory_mb / 1024.0
        return "{gb} GB"

# ============================================================================
# SECTION 7: SLATE UI - VAT baker interface
# ============================================================================

@slate
struct VATBakerUI:
    @property
    bake_progress: Float
    
    @property
    current_state: VATBakeState
    
    @property
    estimated_memory: Float
    
    @property
    vertex_count: Int
    
    @property
    frame_count: Int
    
    fn construct() -> Widget:
        let vbox = VerticalBox()
        
        # Header
        let header = TextBlock()
        header.Text("MetaHuman VAT Baker")
        vbox.Add(header)
        
        # Status section
        let status_box = HorizontalBox()
        
        let state_text = TextBlock()
        match current_state:
            VATBakeState::Idle => state_text.Text("Status: Idle")
            VATBakeState::Analyzing => state_text.Text("Status: Analyzing...")
            VATBakeState::Baking => state_text.Text("Status: Baking...")
            VATBakeState::Compressing => state_text.Text("Status: Compressing...")
            VATBakeState::Complete => state_text.Text("Status: Complete!")
            VATBakeState::Error => state_text.Text("Status: Error")
            _ => state_text.Text("Status: Unknown")
        status_box.Add(state_text)
        
        vbox.Add(status_box)
        
        # Progress bar
        let progress_bar = ProgressBar()
        progress_bar.Percent(bake_progress / 100.0)
        vbox.Add(progress_bar)
        
        let progress_text = TextBlock()
        progress_text.Text("{bake_progress}%")
        vbox.Add(progress_text)
        
        # Stats section
        let stats_box = VerticalBox()
        
        let vertex_text = TextBlock()
        vertex_text.Text("Vertices: {vertex_count}")
        stats_box.Add(vertex_text)
        
        let frame_text = TextBlock()
        frame_text.Text("Frames: {frame_count}")
        stats_box.Add(frame_text)
        
        let memory_text = TextBlock()
        memory_text.Text("Estimated Memory: {estimated_memory} MB")
        stats_box.Add(memory_text)
        
        vbox.Add(stats_box)
        
        return vbox

@slate
struct VATSettingsPanel:
    @property
    resolution: Int
    
    @property
    frame_start: Int
    
    @property
    frame_end: Int
    
    @property
    compression_enabled: Bool
    
    @property
    include_normals: Bool
    
    fn construct() -> Widget:
        let vbox = VerticalBox()
        
        let title = TextBlock()
        title.Text("Bake Settings")
        vbox.Add(title)
        
        # Resolution
        let res_text = TextBlock()
        res_text.Text("Resolution: {resolution}x{resolution}")
        vbox.Add(res_text)
        
        # Frame range
        let frame_text = TextBlock()
        frame_text.Text("Frame Range: {frame_start} - {frame_end}")
        vbox.Add(frame_text)
        
        # Options
        let options_box = VerticalBox()
        
        let compression_text = TextBlock()
        if compression_enabled:
            compression_text.Text("✓ Compression Enabled")
        else:
            compression_text.Text("✗ Compression Disabled")
        options_box.Add(compression_text)
        
        let normals_text = TextBlock()
        if include_normals:
            normals_text.Text("✓ Include Normals")
        else:
            normals_text.Text("✗ Skip Normals")
        options_box.Add(normals_text)
        
        vbox.Add(options_box)
        
        return vbox

@slate
struct VATComparisonWidget:
    @property
    skeletal_fps: Float
    
    @property
    vat_fps: Float
    
    @property
    memory_saved_percent: Float
    
    fn construct() -> Widget:
        let vbox = VerticalBox()
        
        let title = TextBlock()
        title.Text("Performance Comparison")
        vbox.Add(title)
        
        # FPS comparison
        let fps_box = HorizontalBox()
        
        let skeletal_text = TextBlock()
        skeletal_text.Text("Skeletal: {skeletal_fps} FPS")
        fps_box.Add(skeletal_text)
        
        let vat_text = TextBlock()
        vat_text.Text("VAT: {vat_fps} FPS")
        fps_box.Add(vat_text)
        
        vbox.Add(fps_box)
        
        # Memory savings
        let memory_text = TextBlock()
        memory_text.Text("Memory Saved: {memory_saved_percent}%")
        vbox.Add(memory_text)
        
        return vbox

# ============================================================================
# SECTION 8: DETAILS PANEL - VAT baker property editor
# ============================================================================

@details
struct VATBakerDetails:
    @category("Mesh Selection")
    skeletal_mesh_path: String
    
    @category("Mesh Selection")
    animation_sequence_path: String
    
    @category("Bake Settings")
    @slider(min: 512, max: 8192)
    texture_resolution: Int
    
    @category("Bake Settings")
    @slider(min: 0, max: 1000)
    frame_range_start: Int
    
    @category("Bake Settings")
    @slider(min: 1, max: 1000)
    frame_range_end: Int
    
    @category("Bake Settings")
    compression_mode: VATCompressionMode
    
    @category("Bake Settings")
    quality_preset: VATQualityPreset
    
    @category("Options")
    include_normals: Bool
    
    @category("Options")
    include_tangents: Bool
    
    @category("Options")
    bake_morph_targets: Bool
    
    @category("Options")
    bake_cloth: Bool
    
    @category("Options")
    @slider(min: 0, max: 5)
    lod_level: Int
    
    @category("Output")
    output_texture_path: String
    
    @category("Output")
    output_mesh_path: String
    
    @category("Actions")
    @button(label: "Bake VAT")
    fn on_bake_vat():
        println("Starting VAT baking process...")
    
    @category("Actions")
    @button(label: "Stop Baking")
    fn on_stop_baking():
        println("Stopping VAT baking...")
    
    @category("Actions")
    @button(label: "Preview Result")
    fn on_preview_result():
        println("Opening VAT preview...")
    
    @category("Debug")
    @button(label: "Validate Mesh")
    fn on_validate_mesh():
        println("Validating skeletal mesh...")
    
    @category("Debug")
    @button(label: "Calculate Memory")
    fn on_calculate_memory():
        println("Calculating memory usage...")
    
    @category("Debug")
    @button(label: "Export Settings")
    fn on_export_settings():
        println("Exporting bake settings...")

# ============================================================================
# SECTION 9: VIEWPORT - VAT preview with before/after comparison
# ============================================================================

@viewport
struct VATPreviewViewport:
    @scene_actor
    skeletal_mesh: SkeletalMeshComponent
    
    @scene_actor
    vat_mesh: StaticMeshComponent
    
    @camera
    preview_camera: CameraComponent
    
    @property
    show_skeletal: Bool
    
    @property
    show_vat: Bool
    
    @property
    split_view: Bool
    
    fn on_viewport_tick(delta: Float):
        # Update camera position for orbit
        preview_camera.AddLocalRotation(vec3(0, delta * 15.0, 0))
        
        # Toggle visibility based on mode
        if split_view:
            skeletal_mesh.SetVisibility(true)
            vat_mesh.SetVisibility(true)
            skeletal_mesh.SetRelativeLocation(vec3(-200, 0, 0))
            vat_mesh.SetRelativeLocation(vec3(200, 0, 0))
        else:
            skeletal_mesh.SetVisibility(show_skeletal)
            vat_mesh.SetVisibility(show_vat)
            skeletal_mesh.SetRelativeLocation(vec3(0, 0, 0))
            vat_mesh.SetRelativeLocation(vec3(0, 0, 0))

# ============================================================================
# SECTION 10: TOOLBAR - VAT baker actions
# ============================================================================

@toolbar
struct VATBakerToolbar:
    @button(icon: "Icons.Bake", tooltip: "Bake VAT", shortcut: "Ctrl+B")
    fn on_bake():
        println("Baking VAT...")
    
    @button(icon: "Icons.Stop", tooltip: "Stop Baking")
    fn on_stop():
        println("Stopping bake...")
    
    @button(icon: "Icons.Preview", tooltip: "Preview Result")
    fn on_preview():
        println("Opening preview...")
    
    @separator
    
    @toggle(label: "Show Skeletal", default: true)
    fn on_toggle_skeletal(enabled: Bool):
        println("Skeletal visibility: {enabled}")
    
    @toggle(label: "Show VAT", default: true)
    fn on_toggle_vat(enabled: Bool):
        println("VAT visibility: {enabled}")
    
    @toggle(label: "Split View")
    fn on_toggle_split(enabled: Bool):
        println("Split view: {enabled}")
    
    @separator
    
    @dropdown(label: "Quality", options: ["Mobile", "Low", "Medium", "High", "Ultra", "Cinematic"])
    fn on_quality_changed(value: String):
        println("Quality preset: {value}")
    
    @dropdown(label: "Compression", options: ["None", "BC5", "BC7", "BC7 Full"])
    fn on_compression_changed(value: String):
        println("Compression mode: {value}")
    
    @separator
    
    @button(icon: "Icons.Settings", tooltip: "Settings")
    fn on_settings():
        println("Opening settings...")
    
    @button(icon: "Icons.Help", tooltip: "Help")
    fn on_help():
        println("Opening help documentation...")

# ============================================================================
# SECTION 11: ASSET EDITOR - Complete VAT baker editor
# ============================================================================

@asset_editor
struct VATBakerEditor:
    @viewport
    preview: VATPreviewViewport
    
    @details
    properties: VATBakerDetails
    
    @toolbar
    tools: VATBakerToolbar
    
    @slate
    baker_ui: VATBakerUI
    
    @slate
    settings_panel: VATSettingsPanel
    
    @slate
    comparison: VATComparisonWidget
    
    fn on_asset_opened(asset: VATAsset):
        # Initialize viewport
        preview.skeletal_mesh.SetSkeletalMesh(asset.skeletal_mesh)
        preview.vat_mesh.SetStaticMesh(asset.vat_mesh)
        preview.show_skeletal = true
        preview.show_vat = true
        preview.split_view = true
        
        # Initialize properties
        properties.texture_resolution = 2048
        properties.frame_range_start = 0
        properties.frame_range_end = 120
        properties.compression_mode = VATCompressionMode::BC7_Full
        properties.quality_preset = VATQualityPreset::High
        properties.include_normals = true
        properties.include_tangents = false
        properties.bake_morph_targets = true
        properties.bake_cloth = true
        properties.lod_level = 0
        
        # Initialize UI
        baker_ui.bake_progress = 0.0
        baker_ui.current_state = VATBakeState::Idle
        baker_ui.estimated_memory = 64.0
        baker_ui.vertex_count = 8192
        baker_ui.frame_count = 120
        
        # Initialize settings panel
        settings_panel.resolution = 2048
        settings_panel.frame_start = 0
        settings_panel.frame_end = 120
        settings_panel.compression_enabled = true
        settings_panel.include_normals = true
        
        # Initialize comparison
        comparison.skeletal_fps = 30.0
        comparison.vat_fps = 60.0
        comparison.memory_saved_percent = 75.0
        
        println("VAT Baker Editor opened")
    
    fn on_asset_saved():
        println("VAT asset saved successfully")
    
    fn on_asset_closed():
        println("VAT Baker Editor closed")

# ============================================================================
# SECTION 12: EDITOR MODULE - Menu integration
# ============================================================================

@editor_module
struct VATEditorModule:
    @menu_entry(path: "Tools/MetaHuman VAT", label: "Open VAT Baker")
    fn on_open_baker():
        println("Opening MetaHuman VAT Baker...")
    
    @menu_entry(path: "Tools/MetaHuman VAT", label: "Bake Selected Mesh")
    fn on_bake_selected():
        println("Baking selected skeletal mesh...")
    
    @menu_entry(path: "Tools/MetaHuman VAT", label: "Batch Bake Animations")
    fn on_batch_bake():
        println("Starting batch baking process...")
    
    @menu_entry(path: "Tools/MetaHuman VAT", label: "Import VAT Settings")
    fn on_import_settings():
        println("Importing VAT settings from file...")
    
    @menu_entry(path: "Tools/MetaHuman VAT", label: "Export VAT Settings")
    fn on_export_settings():
        println("Exporting VAT settings to file...")
    
    @menu_entry(path: "Tools/MetaHuman VAT", label: "Documentation")
    fn on_documentation():
        println("Opening MetaHumanVAT documentation...")
    
    @toolbar_button(section: "Content", icon: "Icons.MetaHuman", tooltip: "Quick Bake VAT")
    fn on_quick_bake():
        println("Quick baking VAT with default settings...")
    
    @toolbar_button(section: "Content", icon: "Icons.Crowd", tooltip: "Spawn VAT Crowd")
    fn on_spawn_crowd():
        println("Spawning VAT crowd instances...")
    
    @toolbar_button(section: "Content", icon: "Icons.Settings", tooltip: "VAT Settings")
    fn on_vat_settings():
        println("Opening VAT global settings...")

