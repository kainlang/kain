    return DialogueInstance {
        instance_id: -1,
        graph_id: "",
        current_node_id: -1,
        state: DialogueState::Inactive,
        participants: [],
        active_speaker: null,
        listener: null,
        variables: [],
        chosen_choices: [],
        visited_nodes: [],
        start_time: 0.0,
        elapsed_time: 0.0,
        is_paused: false
    }

