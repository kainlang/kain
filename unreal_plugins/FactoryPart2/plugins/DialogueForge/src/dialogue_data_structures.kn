fn evaluate_condition(condition: DialogueCondition, instance: DialogueInstance) -> Bool:
    let result = false
    
    match condition.condition_type:
        ConditionType::VariableEquals =>
            let mut i = 0
            while i < len(instance.variables):
                if instance.variables[i].variable_name == condition.target_id:
                    result = instance.variables[i].current_value == condition.comparison_value
                i = i + 1
        ConditionType::VariableGreater =>
            let mut i = 0
            while i < len(instance.variables):
                if instance.variables[i].variable_name == condition.target_id:
                    result = instance.variables[i].current_value > condition.comparison_value
                i = i + 1
        ConditionType::VariableLess =>
            let mut i = 0
            while i < len(instance.variables):
                if instance.variables[i].variable_name == condition.target_id:
                    result = instance.variables[i].current_value < condition.comparison_value
                i = i + 1
        _ =>
            result = true
    
    if condition.invert:
        return !result
    return result

fn evaluate_all_conditions(conditions: Array<DialogueCondition>, instance: DialogueInstance) -> Bool:
    let mut i = 0
    while i < len(conditions):
        if conditions[i].required:
            if !evaluate_condition(conditions[i], instance):
                return false
        i = i + 1
    return true

fn is_choice_available(choice: DialogueChoice, instance: DialogueInstance) -> Bool:
    if choice.availability == ChoiceAvailability::Hidden:
        return false
    if choice.availability == ChoiceAvailability::Locked:
        return false
    if choice.one_time_only && choice.has_been_chosen:
        return false
    return evaluate_all_conditions(choice.conditions, instance)

fn get_available_choices(node: DialogueNode, instance: DialogueInstance) -> Array<DialogueChoice>:
    let mut available = []
    let mut i = 0
    while i < len(node.choices):
        if is_choice_available(node.choices[i], instance):
            push(available, node.choices[i])
        i = i + 1
    return available

fn has_visited_node(instance: DialogueInstance, node_id: Int) -> Bool:
    let mut i = 0
    while i < len(instance.visited_nodes):
        if instance.visited_nodes[i] == node_id:
            return true
        i = i + 1
    return false

fn get_variable_value(instance: DialogueInstance, var_name: String) -> Float:
    let mut i = 0
    while i < len(instance.variables):
        if instance.variables[i].variable_name == var_name:
            return instance.variables[i].current_value
        i = i + 1
    return 0.0

fn set_variable_value(instance: DialogueInstance, var_name: String, value: Float):
    let mut i = 0
    while i < len(instance.variables):
        if instance.variables[i].variable_name == var_name:
            instance.variables[i].current_value = value
            return
        i = i + 1

fn select_random_node(weights: Array<Float>, node_ids: Array<Int>) -> Int:
    if len(weights) == 0 || len(node_ids) == 0:
        return -1
    
    let mut total_weight = 0.0
    let mut i = 0
    while i < len(weights):
        total_weight = total_weight + weights[i]
        i = i + 1
    
    let random_value = random_float() * total_weight
    let mut cumulative = 0.0
    let mut j = 0
    while j < len(weights):
        cumulative = cumulative + weights[j]
        if random_value <= cumulative:
            return node_ids[j]
        j = j + 1
    
    return node_ids[len(node_ids) - 1]

fn calculate_dialogue_duration(text: String, words_per_minute: Float) -> Float:
    let word_count = len(split(text, " "))
    let words_per_second = words_per_minute / 60.0
    return (word_count as Float) / words_per_second

fn format_dialogue_text(text: String, speaker_name: String, emotion: SpeakerEmotion) -> String:
    return "{speaker_name}: {text}"

fn get_emotion_display_name(emotion: SpeakerEmotion) -> String:
    match emotion:
        SpeakerEmotion::Neutral => "Neutral"
        SpeakerEmotion::Happy => "Happy"
        SpeakerEmotion::Sad => "Sad"
        SpeakerEmotion::Angry => "Angry"
        SpeakerEmotion::Surprised => "Surprised"
        SpeakerEmotion::Fearful => "Fearful"
        SpeakerEmotion::Disgusted => "Disgusted"
        SpeakerEmotion::Confused => "Confused"
        SpeakerEmotion::Excited => "Excited"
        SpeakerEmotion::Bored => "Bored"

fn get_camera_angle_display_name(angle: CameraAngle) -> String:
    match angle:
        CameraAngle::CloseUp => "Close Up"
        CameraAngle::MediumShot => "Medium Shot"
        CameraAngle::WideShot => "Wide Shot"
        CameraAngle::OverShoulder => "Over Shoulder"
        CameraAngle::TwoShot => "Two Shot"
        CameraAngle::Custom => "Custom"

fn get_node_type_display_name(node_type: DialogueNodeType) -> String:
    match node_type:
        DialogueNodeType::Speaker => "Speaker"
        DialogueNodeType::Choice => "Choice"
        DialogueNodeType::Condition => "Condition"
        DialogueNodeType::Branch => "Branch"
        DialogueNodeType::Event => "Event"
        DialogueNodeType::Quest => "Quest"
        DialogueNodeType::Random => "Random"
        DialogueNodeType::Delay => "Delay"
        DialogueNodeType::Animation => "Animation"
        DialogueNodeType::Camera => "Camera"
        DialogueNodeType::Sound => "Sound"
        DialogueNodeType::Variable => "Variable"
        DialogueNodeType::Jump => "Jump"
        DialogueNodeType::End => "End"
