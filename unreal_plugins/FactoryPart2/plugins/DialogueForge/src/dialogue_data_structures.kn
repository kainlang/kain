// DialogueForge — Data Structures
// Enums, structs, and data types for dialogue system

enum DialogueNodeType:
    Speaker
    Choice
    Condition
    Branch
    Event
    Quest
    Random
    Delay
    Animation
    Camera
    Sound
    Variable
    Jump
    End

enum ConditionType:
    QuestComplete
    QuestActive
    QuestFailed
    ItemInInventory
    ItemCount
    StatValue
    FlagSet
    FlagNotSet
    VariableEquals
    VariableGreater
    VariableLess
    ActorInRange
    TimeOfDay
    PlayerLevel
    Reputation
    Custom

enum ResponseType:
    Continue
    Choice
    End
    Jump
    StartQuest
    CompleteQuest
    FailQuest

enum SpeakerEmotion:
    Neutral
    Happy
    Sad
    Angry
    Surprised
    Fearful
    Disgusted
    Confused
    Excited
    Bored

enum CameraAngle:
    CloseUp
    MediumShot
    WideShot
    OverShoulder
    TwoShot
    Custom

enum DialogueState:
    Inactive
    Active
    Paused
    Completed
    Failed

enum ChoiceAvailability:
    Available
    Locked
    Hidden
    Disabled

struct DialogueSpeaker:
    speaker_id: String
    display_name: String
    portrait_texture_path: String
    voice_actor_name: String
    default_emotion: SpeakerEmotion
    actor_reference: Actor
    is_player: Bool

struct DialogueCondition:
    condition_type: ConditionType
    target_id: String
    comparison_value: Float
    string_value: String
    invert: Bool
    required: Bool

struct DialogueChoice:
    choice_id: Int
    choice_text: String
    hover_text: String
    icon_path: String
    conditions: Array<DialogueCondition>
    availability: ChoiceAvailability
    consequence_text: String
    stat_requirements: Array<StatRequirement>
    skill_check_stat: String
    skill_check_difficulty: Int
    success_node_id: Int
    failure_node_id: Int
    next_node_id: Int
    one_time_only: Bool
    has_been_chosen: Bool

struct StatRequirement:
    stat_name: String
    min_value: Float
    max_value: Float
    display_in_ui: Bool

struct DialogueNode:
    node_id: Int
    node_type: DialogueNodeType
    speaker_id: String
    dialogue_text: String
    voice_line_path: String
    subtitle_text: String
    emotion: SpeakerEmotion
    camera_angle: CameraAngle
    animation_name: String
    duration: Float
    conditions: Array<DialogueCondition>
    choices: Array<DialogueChoice>
    next_node_id: Int
    event_name: String
    quest_id: String
    variable_name: String
    variable_value: Float
    random_weights: Array<Float>
    random_node_ids: Array<Int>
    jump_target_id: Int
    sound_path: String
    is_skippable: Bool
    auto_advance: Bool

struct DialogueGraph:
    graph_id: String
    graph_name: String
    description: String
    entry_node_id: Int
    nodes: Array<DialogueNode>
    speakers: Array<DialogueSpeaker>
    variables: Array<DialogueVariable>
    tags: Array<String>
    category: String
    priority: Int

struct DialogueVariable:
    variable_name: String
    variable_type: String
    default_value: Float
    current_value: Float
    is_persistent: Bool
    description: String

struct DialogueInstance:
    instance_id: Int
    graph_id: String
    current_node_id: Int
    state: DialogueState
    participants: Array<Actor>
    active_speaker: Actor
    listener: Actor
    variables: Array<DialogueVariable>
    chosen_choices: Array<Int>
    visited_nodes: Array<Int>
    start_time: Float
    elapsed_time: Float
    is_paused: Bool

struct VoiceLineData:
    voice_line_id: String
    speaker_id: String
    audio_path: String
    subtitle_text: String
    duration: Float
    emotion: SpeakerEmotion
    is_loaded: Bool
    is_playing: Bool

struct DialogueHistoryEntry:
    node_id: Int
    speaker_id: String
    dialogue_text: String
    timestamp: Float
    choice_made: Int

struct QuestTrigger:
    quest_id: String
    trigger_type: String
    target_node_id: Int
    is_start: Bool
    is_complete: Bool
    is_fail: Bool

struct DialogueEvent:
    event_name: String
    event_params: Array<String>
    target_actor: Actor
    delay: Float
    is_triggered: Bool

struct CameraSettings:
    camera_angle: CameraAngle
    blend_time: Float
    target_actor: Actor
    offset: Vec3
    fov: Float
    use_custom_transform: Bool
    custom_location: Vec3
    custom_rotation: Vec3

struct AnimationTrigger:
    animation_name: String
    target_actor: Actor
    blend_in_time: Float
    blend_out_time: Float
    play_rate: Float
    loop: Bool
    start_position: Float

struct SoundTrigger:
    sound_path: String
    volume: Float
    pitch: Float
    start_time: Float
    fade_in_duration: Float
    fade_out_duration: Float
    is_2d: Bool
    attenuation_settings: String

struct SkillCheckResult:
    success: Bool
    stat_name: String
    required_value: Int
    actual_value: Int
    roll_result: Int
    critical_success: Bool
    critical_failure: Bool

struct DialogueUIState:
    is_visible: Bool
    current_speaker_name: String
    current_dialogue_text: String
    current_portrait_path: String
    available_choices: Array<DialogueChoice>
    subtitle_text: String
    is_waiting_for_input: Bool
    auto_advance_timer: Float

@datatable
struct SpeakerData:
    speaker_id: String
    display_name: String
    portrait_texture_path: String
    voice_actor_name: String
    default_emotion: SpeakerEmotion
    actor_class_name: String
    description: String

@datatable
struct DialogueGraphData:
    graph_id: String
    graph_name: String
    description: String
    category: String
    tags: Array<String>
    entry_node_id: Int
    asset_path: String

@datatable
struct EmotionData:
    emotion: SpeakerEmotion
    display_name: String
    portrait_suffix: String
    animation_name: String
    voice_modulation: Float
    color_tint: Vec3

@datatable
struct CameraAngleData:
    camera_angle: CameraAngle
    display_name: String
    default_offset: Vec3
    default_fov: Float
    blend_time: Float
    description: String

