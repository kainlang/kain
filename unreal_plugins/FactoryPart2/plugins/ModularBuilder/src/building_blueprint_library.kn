@blueprint
fn undo_last_action(manager: BuildManagerActor):
    manager.Server_UndoLastAction()

@blueprint
fn redo_last_action(manager: BuildManagerActor):
    manager.Server_RedoLastAction()

@blueprint
fn can_undo_action(manager: BuildManagerActor) -> Bool:
    return manager.can_undo()

@blueprint
fn can_redo_action(manager: BuildManagerActor) -> Bool:
    return manager.can_redo()

@blueprint
fn set_build_mode(manager: BuildManagerActor, mode: BuildMode):
    manager.Server_SetBuildMode(mode)

@blueprint
fn get_current_build_mode(manager: BuildManagerActor) -> BuildMode:
    return manager.current_build_mode

@blueprint
fn select_pieces(manager: BuildManagerActor, piece_ids: Array<Int>):
    manager.Server_SelectPieces(piece_ids)

@blueprint
fn get_selected_pieces(manager: BuildManagerActor) -> Array<Int>:
    return manager.selected_pieces

@blueprint
fn deselect_all_pieces(manager: BuildManagerActor):
    manager.Server_SelectPieces([])

@blueprint
fn delete_selected_pieces(manager: BuildManagerActor):
    let selected = manager.selected_pieces
    let i = 0
    while i < len(selected):
        manager.Server_RemovePiece(selected[i], false)
        i = i + 1

@blueprint
fn rotate_selected_pieces(manager: BuildManagerActor, rotation_delta: Vec3):
    let selected = manager.selected_pieces
    let i = 0
    while i < len(selected):
        manager.Server_RotatePiece(selected[i], rotation_delta)
        i = i + 1

@blueprint
fn move_selected_pieces(manager: BuildManagerActor, offset: Vec3):
    let selected = manager.selected_pieces
    let i = 0
    while i < len(selected):
        let piece = manager.get_piece_by_id(selected[i])
        let new_position = vec3(
            piece.world_transform.position.x + offset.x,
            piece.world_transform.position.y + offset.y,
            piece.world_transform.position.z + offset.z
        )
        let new_transform = Transform {
            position: new_position,
            rotation: piece.world_transform.rotation,
            scale: piece.world_transform.scale
        }
        manager.Server_MovePiece(selected[i], new_transform)
        i = i + 1
