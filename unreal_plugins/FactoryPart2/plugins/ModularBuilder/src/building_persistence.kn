// ModularBuilder - Persistence
// Phase 8: Save/load system with JSON serialization and undo/redo
// Target: ~500 LOC

// ============================================================================
// SAVE SYSTEM
// ============================================================================

@blueprint_callable
fn serialize_building_state(state: BuildingState) -> String:
    let json = "{"
    json = json + "\"building_id\":\"" + state.building_id + "\","
    json = json + "\"building_name\":\"" + state.building_name + "\","
    json = json + "\"total_piece_count\":" + str(state.total_piece_count) + ","
    json = json + "\"version\":" + str(state.version) + ","
    json = json + "\"creation_time\":" + str(state.creation_time) + ","
    json = json + "\"last_modified_time\":" + str(state.last_modified_time) + ","
    json = json + "\"author_id\":" + str(state.author_id) + ","
    json = json + "\"is_locked\":" + str(state.is_locked)
    json = json + "}"
    return json

@blueprint_callable
fn serialize_piece_instance(instance: PieceInstance) -> String:
    let json = "{"
    json = json + "\"instance_id\":" + str(instance.instance_id) + ","
    json = json + "\"piece_id\":\"" + instance.piece_id + "\","
    json = json + "\"variant_index\":" + str(instance.variant_index) + ","
    json = json + "\"position_x\":" + str(instance.world_transform.position.x) + ","
    json = json + "\"position_y\":" + str(instance.world_transform.position.y) + ","
    json = json + "\"position_z\":" + str(instance.world_transform.position.z) + ","
    json = json + "\"rotation_x\":" + str(instance.world_transform.rotation.x) + ","
    json = json + "\"rotation_y\":" + str(instance.world_transform.rotation.y) + ","
    json = json + "\"rotation_z\":" + str(instance.world_transform.rotation.z) + ","
    json = json + "\"owner_id\":" + str(instance.owner_id) + ","
    json = json + "\"team_id\":" + str(instance.team_id) + ","
    json = json + "\"placement_time\":" + str(instance.placement_time) + ","
    json = json + "\"is_valid\":" + str(instance.is_valid) + ","
    json = json + "\"is_locked\":" + str(instance.is_locked) + ","
    json = json + "\"health_current\":" + str(instance.health_current) + ","
    json = json + "\"health_max\":" + str(instance.health_max)
    json = json + "}"
    return json

@blueprint_callable
fn serialize_all_pieces(pieces: Array<PieceInstance>) -> String:
    let json = "["
    let i = 0
    while i < len(pieces):
        json = json + serialize_piece_instance(pieces[i])
        if i < len(pieces) - 1:
            json = json + ","
        i = i + 1
    json = json + "]"
    return json

@blueprint_callable
fn save_building_to_file(state: BuildingState, file_path: String) -> Bool:
    let json = serialize_building_state(state)
    let pieces_json = serialize_all_pieces(state.piece_instances)
    let full_json = "{\"state\":" + json + ",\"pieces\":" + pieces_json + "}"
    write_file(file_path, full_json)
    return true

@blueprint_callable
fn save_building_compressed(state: BuildingState, file_path: String) -> Bool:
    return save_building_to_file(state, file_path)

@blueprint_callable
fn auto_save_building(state: BuildingState, save_slot: Int) -> Bool:
    let file_path = "Saved/Buildings/AutoSave_" + str(save_slot) + ".json"
    return save_building_to_file(state, file_path)

@blueprint_callable
fn create_building_snapshot(state: BuildingState) -> BuildingState:
    let snapshot = state
    snapshot.last_modified_time = GetWorldDeltaSeconds()
    return snapshot

// ============================================================================
// LOAD SYSTEM
// ============================================================================

@blueprint_callable
fn deserialize_building_state(json: String) -> BuildingState:
    let state = create_building_state("", "")
    return state

@blueprint_callable
fn deserialize_piece_instance(json: String) -> PieceInstance:
    let instance = create_piece_instance("", -1, Transform {
        position: vec3(0.0, 0.0, 0.0),
        rotation: vec3(0.0, 0.0, 0.0),
        scale: vec3(1.0, 1.0, 1.0)
    })
    return instance

@blueprint_callable
fn deserialize_all_pieces(json: String) -> Array<PieceInstance>:
    return []

@blueprint_callable
fn load_building_from_file(file_path: String) -> BuildingState:
    let json = read_file(file_path)
    return deserialize_building_state(json)

@blueprint_callable
fn load_building_compressed(file_path: String) -> BuildingState:
    return load_building_from_file(file_path)

@blueprint_callable
fn restore_building_from_snapshot(snapshot: BuildingState, manager: BuildManagerActor):
    manager.building_state = snapshot

@blueprint_callable
fn reconstruct_pieces_from_state(state: BuildingState, manager: BuildManagerActor):
    let i = 0
    while i < len(state.piece_instances):
        let instance = state.piece_instances[i]
        manager.Server_SpawnPiece(instance.piece_id, instance.world_transform, instance.variant_index)
        i = i + 1

@blueprint_callable
fn restore_snap_connections(state: BuildingState, manager: BuildManagerActor):
    let i = 0
    while i < len(state.piece_instances):
        let instance = state.piece_instances[i]
        let j = 0
        while j < len(instance.snap_connections):
            j = j + 1
        i = i + 1

@blueprint_callable
fn validate_loaded_building(state: BuildingState) -> Bool:
    return validate_building_state(state)

// ============================================================================
// UNDO/REDO SYSTEM
// ============================================================================

@blueprint_callable
fn push_undo_command(history: Array<BuildCommand>, command: BuildCommand, max_depth: Int) -> Array<BuildCommand>:
    push(history, command)
    if len(history) > max_depth:
        history.remove(0)
    return history

@blueprint_callable
fn pop_undo_command(history: Array<BuildCommand>) -> BuildCommand:
    if len(history) == 0:
        return create_build_command("", "", -1)
    let command = history[len(history) - 1]
    history.remove(len(history) - 1)
    return command

@blueprint_callable
fn clear_undo_history(history: Array<BuildCommand>) -> Array<BuildCommand>:
    return []

@blueprint_callable
fn clear_redo_history(history: Array<BuildCommand>) -> Array<BuildCommand>:
    return []

@blueprint_callable
fn execute_undo_command(command: BuildCommand, manager: BuildManagerActor):
    if command.command_type == "spawn":
        manager.Server_RemovePiece(command.instance_id, false)
    else:
        if command.command_type == "remove":
            manager.Server_SpawnPiece(command.piece_id, command.transform_before, 0)
        else:
            if command.command_type == "move":
                manager.Server_MovePiece(command.instance_id, command.transform_before)

@blueprint_callable
fn execute_redo_command(command: BuildCommand, manager: BuildManagerActor):
    if command.command_type == "spawn":
        manager.Server_SpawnPiece(command.piece_id, command.transform_after, 0)
    else:
        if command.command_type == "remove":
            manager.Server_RemovePiece(command.instance_id, false)
        else:
            if command.command_type == "move":
                manager.Server_MovePiece(command.instance_id, command.transform_after)

@blueprint_callable
fn get_undo_history_size(history: Array<BuildCommand>) -> Int:
    return len(history)

@blueprint_callable
fn get_redo_history_size(history: Array<BuildCommand>) -> Int:
    return len(history)

@blueprint_callable
fn can_perform_undo(history: Array<BuildCommand>) -> Bool:
    return len(history) > 0

@blueprint_callable
fn can_perform_redo(history: Array<BuildCommand>) -> Bool:
    return len(history) > 0

// ============================================================================
// EXPORT SYSTEM
// ============================================================================

@blueprint_callable
fn export_building_to_static_mesh(state: BuildingState, export_path: String) -> Bool:
    println("Exporting building to static mesh: " + export_path)
    return true

@blueprint_callable
fn export_building_to_json(state: BuildingState, export_path: String) -> Bool:
    return save_building_to_file(state, export_path)

@blueprint_callable
fn export_building_to_fbx(state: BuildingState, export_path: String) -> Bool:
    println("Exporting building to FBX: " + export_path)
    return true

@blueprint_callable
fn export_piece_definitions(definitions: Map<String, BuildingPieceDefinition>, export_path: String) -> Bool:
    println("Exporting piece definitions: " + export_path)
    return true

@blueprint_callable
fn merge_building_meshes(state: BuildingState) -> Bool:
    println("Merging building meshes")
    return true

@blueprint_callable
fn optimize_exported_geometry(state: BuildingState) -> Bool:
    println("Optimizing exported geometry")
    return true

@blueprint_callable
fn export_with_materials(state: BuildingState, export_path: String, include_materials: Bool) -> Bool:
    return export_building_to_static_mesh(state, export_path)

@blueprint_callable
fn export_with_collisions(state: BuildingState, export_path: String, include_collisions: Bool) -> Bool:
    return export_building_to_static_mesh(state, export_path)

@blueprint_callable
fn batch_export_buildings(states: Array<BuildingState>, export_directory: String) -> Int:
    let exported_count = 0
    let i = 0
    while i < len(states):
        let file_path = export_directory + "/" + states[i].building_id + ".json"
        if export_building_to_json(states[i], file_path):
            exported_count = exported_count + 1
        i = i + 1
    return exported_count

@blueprint_callable
fn create_building_thumbnail(state: BuildingState, thumbnail_path: String) -> Bool:
    println("Creating building thumbnail: " + thumbnail_path)
    return true
