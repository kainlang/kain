// ModularBuilder - Data Structures
// Phase 2: Core enums, structs, DataTables, and helper functions
// Target: ~1,200 LOC

// ============================================================================
// ENUMS (12 total)
// ============================================================================

enum SnapPointType:
    Wall
    Floor
    Ceiling
    Corner
    Edge
    Pillar
    Roof
    Foundation
    Decorative
    Custom

enum AlignmentMode:
    Exact
    Rotate90
    Rotate45
    Free

enum BuildMode:
    Place
    Select
    Delete
    Rotate
    Paint
    Move
    Copy

enum PieceCategory:
    Walls
    Floors
    Roofs
    Stairs
    Doors
    Windows
    Decorative
    Structural
    Furniture
    Lighting
    Custom

enum StructuralType:
    Foundation
    Support
    Dependent
    Decorative
    Freestanding

enum ValidationResult:
    Valid
    InvalidSnap
    Overlapping
    NoSupport
    OutOfBounds
    InsufficientClearance
    InvalidPlacement
    PermissionDenied
    Custom

enum PlacementRule:
    RequireGround
    RequireSupport
    AllowOverlap
    RequireSnap
    NoOverlap
    RequireClearance
    RequireFoundation
    Custom

enum SnapIndicatorColor:
    Green
    Yellow
    Red
    Blue
    White
    Orange
    Purple

enum BuildPermission:
    Owner
    Team
    Public
    Admin
    Custom

enum SerializationFormat:
    JSON
    Binary
    Compressed

enum ExportFormat:
    StaticMesh
    JSON
    FBX
    OBJ

enum PerformanceMode:
    Quality
    Balanced
    Performance
    Ultra

// ============================================================================
// CORE STRUCTS (25 total)
// ============================================================================

struct SnapPointData:
    point_type: SnapPointType
    local_position: Vec3
    local_rotation: Vec3
    snap_radius: Float
    alignment_mode: AlignmentMode
    compatible_types: Array<SnapPointType>
    required_tags: Array<String>
    excluded_tags: Array<String>
    is_occupied: Bool
    connected_piece_id: Int
    snap_offset: Vec3
    rotation_constraint: Float
    priority: Int

struct BuildingPieceDefinition:
    piece_id: String
    display_name: String
    description: String
    category: PieceCategory
    subcategory: String
    mesh_variants: Array<String>
    snap_points: Array<SnapPointData>
    tags: Array<String>
    structural_type: StructuralType
    placement_rules: Array<PlacementRule>
    bounds_size: Vec3
    bounds_offset: Vec3
    cost: Int
    build_time: Float
    health: Float
    thumbnail_path: String
    icon_path: String
    author: String
    version: Int

struct PieceInstance:
    instance_id: Int
    piece_id: String
    variant_index: Int
    world_transform: Transform
    snap_connections: Array<Int>
    material_overrides: Array<String>
    custom_properties: Map<String, String>
    owner_id: Int
    team_id: Int
    placement_time: Float
    last_modified_time: Float
    is_valid: Bool
    is_locked: Bool
    health_current: Float
    health_max: Float

struct SnapQueryResult:
    found_snap: Bool
    snap_point_index: Int
    target_piece_id: Int
    target_snap_index: Int
    alignment_transform: Transform
    distance: Float
    validation_result: ValidationResult
    compatibility_score: Float
    is_occupied: Bool
    required_rotation: Vec3

struct BuildingState:
    building_id: String
    building_name: String
    piece_instances: Array<PieceInstance>
    total_piece_count: Int
    bounds_min: Vec3
    bounds_max: Vec3
    creation_time: Float
    last_modified_time: Float
    version: Int
    author_id: Int
    is_locked: Bool
    metadata: Map<String, String>

struct StructuralChain:
    chain_id: Int
    foundation_piece_id: Int
    supported_piece_ids: Array<Int>
    chain_depth: Int
    max_depth: Int
    is_stable: Bool
    support_strength: Float
    weak_points: Array<Int>
    collapse_risk: Float

struct CategoryNode:
