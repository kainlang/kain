# AnimRigPro - Constraint System
# Aim, Parent, Position, Rotation, Scale, and Pole Vector constraints

# Main constraint evaluation function
fn evaluate_constraints(
    rig_state: RigState,
    skeleton_cache: SkeletonCache
):
    # Evaluate constraints in order
    evaluate_parent_constraints(rig_state.parent_constraints, skeleton_cache)
    evaluate_position_constraints(rig_state.position_constraints, skeleton_cache)
    evaluate_rotation_constraints(rig_state.rotation_constraints, skeleton_cache)
    evaluate_aim_constraints(rig_state.aim_constraints, skeleton_cache)
    evaluate_scale_constraints(rig_state.scale_constraints, skeleton_cache)
    evaluate_pole_vector_constraints(rig_state.pole_vector_constraints, rig_state, skeleton_cache)

# Parent Constraint Evaluation
fn evaluate_parent_constraints(
    constraints: Array<ParentConstraintData>,
    skeleton_cache: SkeletonCache
):
    let i = 0
    while i < len(constraints):
        let constraint = constraints[i]
        if constraint.base.enabled and constraint.base.weight > 0.0:
            evaluate_parent_constraint(constraint, skeleton_cache)
        i = i + 1

fn evaluate_parent_constraint(
    constraint: ParentConstraintData,
    skeleton_cache: SkeletonCache
):
    let source_index = constraint.base.source_bone_index
    if source_index < 0 or source_index >= len(skeleton_cache.bone_transforms):
        return
    
    # Calculate weighted average of target transforms
    let blended_transform = identity()
    let total_weight = 0.0
    
    let i = 0
    while i < len(constraint.base.target_bone_indices):
        let target_index = constraint.base.target_bone_indices[i]
        let weight = constraint.base.target_weights[i]
        
        if target_index >= 0 and target_index < len(skeleton_cache.world_transforms):
            let target_transform = skeleton_cache.world_transforms[target_index]
            
            # Apply offset if available
            let offset_transform = if i < len(constraint.offset_transforms):
                constraint.offset_transforms[i]
            else:
                identity()
            
            let final_transform = multiply_transform(target_transform, offset_transform)
            
            if total_weight == 0.0:
                blended_transform = final_transform
            else:
                let blend_alpha = weight / (total_weight + weight)
                blended_transform = lerp_transform(blended_transform, final_transform, blend_alpha)
            
            total_weight = total_weight + weight
        i = i + 1
    
    if total_weight < 0.0001:
        return
    
    # Convert to local space
    let parent_index = skeleton_cache.bone_parents[source_index]
    let local_transform = if parent_index >= 0:
        let parent_world = skeleton_cache.world_transforms[parent_index]
        let parent_inv = inverse_transform(parent_world)
        multiply_transform(parent_inv, blended_transform)
    else:
        blended_transform
    
    # Apply constraint weight
    let current_transform = skeleton_cache.bone_transforms[source_index]
    let final_transform = lerp_transform(current_transform, local_transform, constraint.base.weight)
    
    skeleton_cache.bone_transforms[source_index] = final_transform
    mark_dirty(skeleton_cache, source_index)

# Position Constraint Evaluation
fn evaluate_position_constraints(
    constraints: Array<PositionConstraintData>,
    skeleton_cache: SkeletonCache
):
    let i = 0
    while i < len(constraints):
        let constraint = constraints[i]
        if constraint.base.enabled and constraint.base.weight > 0.0:
            evaluate_position_constraint(constraint, skeleton_cache)
        i = i + 1

fn evaluate_position_constraint(
    constraint: PositionConstraintData,
    skeleton_cache: SkeletonCache
):
    let source_index = constraint.base.source_bone_index
    if source_index < 0 or source_index >= len(skeleton_cache.bone_transforms):
        return
    
    # Calculate weighted average position
    let blended_position = vec3(0.0, 0.0, 0.0)
    let total_weight = 0.0
    
    let i = 0
    while i < len(constraint.base.target_bone_indices):
        let target_index = constraint.base.target_bone_indices[i]
        let weight = constraint.base.target_weights[i]
        
        if target_index >= 0 and target_index < len(skeleton_cache.world_transforms):
            let target_pos = skeleton_cache.world_transforms[target_index].position
            
            # Apply offset if available
            let offset = if i < len(constraint.offsets):
                constraint.offsets[i]
            else:
                vec3(0.0, 0.0, 0.0)
            
            let final_pos = vec3(
                target_pos.x + offset.x,
                target_pos.y + offset.y,
                target_pos.z + offset.z
            )
            
            blended_position = vec3(
                blended_position.x + final_pos.x * weight,
                blended_position.y + final_pos.y * weight,
                blended_position.z + final_pos.z * weight
            )
            total_weight = total_weight + weight
        i = i + 1
    
    if total_weight < 0.0001:
        return
    
    blended_position = vec3(
        blended_position.x / total_weight,
        blended_position.y / total_weight,
        blended_position.z / total_weight
    )
    
    # Convert to local space
    let parent_index = skeleton_cache.bone_parents[source_index]
    let local_position = if parent_index >= 0:
        let parent_world = skeleton_cache.world_transforms[parent_index]
        let parent_inv = inverse_transform(parent_world)
        multiply_transform(parent_inv, BoneTransform(
            position: blended_position,
            rotation: vec4(0.0, 0.0, 0.0, 1.0),
            scale: vec3(1.0, 1.0, 1.0)
        )).position
    else:
        blended_position
    
    # Apply axis filter
    let current_transform = skeleton_cache.bone_transforms[source_index]
    let filtered_position = apply_to_vector(
        constraint.base.axis_filter,
        current_transform.position,
        local_position
    )
    
    # Apply constraint weight
    let final_position = lerp_vec3(current_transform.position, filtered_position, constraint.base.weight)
    
    skeleton_cache.bone_transforms[source_index] = BoneTransform(
        position: final_position,
        rotation: current_transform.rotation,
        scale: current_transform.scale
    )
    mark_dirty(skeleton_cache, source_index)

# Rotation Constraint Evaluation
fn evaluate_rotation_constraints(
    constraints: Array<RotationConstraintData>,
    skeleton_cache: SkeletonCache
):
    let i = 0
    while i < len(constraints):
        let constraint = constraints[i]
        if constraint.base.enabled and constraint.base.weight > 0.0:
            evaluate_rotation_constraint(constraint, skeleton_cache)
        i = i + 1

fn evaluate_rotation_constraint(
    constraint: RotationConstraintData,
    skeleton_cache: SkeletonCache
):
    let source_index = constraint.base.source_bone_index
    if source_index < 0 or source_index >= len(skeleton_cache.bone_transforms):
        return
    
    # Calculate weighted average rotation
    let blended_rotation = vec4(0.0, 0.0, 0.0, 1.0)
    let total_weight = 0.0
    
    let i = 0
    while i < len(constraint.base.target_bone_indices):
        let target_index = constraint.base.target_bone_indices[i]
        let weight = constraint.base.target_weights[i]
        
        if target_index >= 0 and target_index < len(skeleton_cache.world_transforms):
            let target_rot = skeleton_cache.world_transforms[target_index].rotation
            
            # Apply offset if available
            let offset_rot = if i < len(constraint.offset_rotations):
                constraint.offset_rotations[i]
            else:
                vec4(0.0, 0.0, 0.0, 1.0)
            
            let final_rot = multiply_quat(target_rot, offset_rot)
            
            if total_weight == 0.0:
                blended_rotation = final_rot
            else:
                let blend_alpha = weight / (total_weight + weight)
                blended_rotation = slerp_quat(blended_rotation, final_rot, blend_alpha)
            
            total_weight = total_weight + weight
        i = i + 1
    
    if total_weight < 0.0001:
        return
    
    # Convert to local space
    let parent_index = skeleton_cache.bone_parents[source_index]
    let local_rotation = if parent_index >= 0:
        let parent_world_rot = skeleton_cache.world_transforms[parent_index].rotation
        let parent_inv_rot = conjugate_quat(parent_world_rot)
        multiply_quat(parent_inv_rot, blended_rotation)
    else:
        blended_rotation
    
    # Apply constraint weight
    let current_transform = skeleton_cache.bone_transforms[source_index]
    let final_rotation = slerp_quat(current_transform.rotation, local_rotation, constraint.base.weight)
    
    skeleton_cache.bone_transforms[source_index] = BoneTransform(
        position: current_transform.position,
        rotation: final_rotation,
        scale: current_transform.scale
    )
    mark_dirty(skeleton_cache, source_index)

# Aim Constraint Evaluation
fn evaluate_aim_constraints(
    constraints: Array<AimConstraintData>,
    skeleton_cache: SkeletonCache
):
    let i = 0
    while i < len(constraints):
        let constraint = constraints[i]
        if constraint.base.enabled and constraint.base.weight > 0.0:
            evaluate_aim_constraint(constraint, skeleton_cache)
        i = i + 1

fn evaluate_aim_constraint(
    constraint: AimConstraintData,
    skeleton_cache: SkeletonCache
):
    let source_index = constraint.base.source_bone_index
    if source_index < 0 or source_index >= len(skeleton_cache.bone_transforms):
        return
    
    # Calculate weighted average target position
    let blended_target = vec3(0.0, 0.0, 0.0)
    let total_weight = 0.0
    
    let i = 0
    while i < len(constraint.base.target_bone_indices):
        let target_index = constraint.base.target_bone_indices[i]
        let weight = constraint.base.target_weights[i]
        
        if target_index >= 0 and target_index < len(skeleton_cache.world_transforms):
            let target_pos = skeleton_cache.world_transforms[target_index].position
            blended_target = vec3(
                blended_target.x + target_pos.x * weight,
                blended_target.y + target_pos.y * weight,
                blended_target.z + target_pos.z * weight
            )
            total_weight = total_weight + weight
        i = i + 1
    
    if total_weight < 0.0001:
        return
    
    blended_target = vec3(
        blended_target.x / total_weight,
        blended_target.y / total_weight,
        blended_target.z / total_weight
    )
    
    # Get source world position
    let source_world_pos = skeleton_cache.world_transforms[source_index].position
    
    # Determine world up vector
    let world_up = if constraint.world_up_type == 0:
        vec3(0.0, 0.0, 1.0)
    else:
        if constraint.world_up_type == 1:
            # Use object up vector (simplified)
            vec3(0.0, 0.0, 1.0)
        else:
            constraint.world_up_vector
    
    # Calculate aim rotation
    let aim_rotation = solve_look_at_ik(
        source_world_pos,
        skeleton_cache.world_transforms[source_index].rotation,
        blended_target,
        constraint.aim_vector,
        constraint.up_vector,
        world_up
    )
    
    # Convert to local space
    let parent_index = skeleton_cache.bone_parents[source_index]
    let local_rotation = if parent_index >= 0:
        let parent_world_rot = skeleton_cache.world_transforms[parent_index].rotation
        let parent_inv_rot = conjugate_quat(parent_world_rot)
        multiply_quat(parent_inv_rot, aim_rotation)
    else:
        aim_rotation
    
    # Apply constraint weight
    let current_transform = skeleton_cache.bone_transforms[source_index]
    let final_rotation = slerp_quat(current_transform.rotation, local_rotation, constraint.base.weight)
    
    skeleton_cache.bone_transforms[source_index] = BoneTransform(
        position: current_transform.position,
        rotation: final_rotation,
        scale: current_transform.scale
    )
    mark_dirty(skeleton_cache, source_index)

# Scale Constraint Evaluation
fn evaluate_scale_constraints(
    constraints: Array<ScaleConstraintData>,
    skeleton_cache: SkeletonCache
):
    let i = 0
    while i < len(constraints):
        let constraint = constraints[i]
        if constraint.base.enabled and constraint.base.weight > 0.0:
            evaluate_scale_constraint(constraint, skeleton_cache)
        i = i + 1

fn evaluate_scale_constraint(
    constraint: ScaleConstraintData,
    skeleton_cache: SkeletonCache
):
    let source_index = constraint.base.source_bone_index
    if source_index < 0 or source_index >= len(skeleton_cache.bone_transforms):
        return
    
    # Calculate weighted average scale
    let blended_scale = vec3(1.0, 1.0, 1.0)
    let total_weight = 0.0
    
    let i = 0
    while i < len(constraint.base.target_bone_indices):
        let target_index = constraint.base.target_bone_indices[i]
        let weight = constraint.base.target_weights[i]
        
        if target_index >= 0 and target_index < len(skeleton_cache.world_transforms):
            let target_scale = skeleton_cache.world_transforms[target_index].scale
            
            # Apply offset if available and enabled
            let final_scale = if constraint.use_offset and i < len(constraint.offset_scales):
                let offset = constraint.offset_scales[i]
                vec3(
                    target_scale.x * offset.x,
                    target_scale.y * offset.y,
                    target_scale.z * offset.z
                )
            else:
                target_scale
            
            if total_weight == 0.0:
                blended_scale = final_scale
            else:
                let blend_alpha = weight / (total_weight + weight)
                blended_scale = lerp_vec3(blended_scale, final_scale, blend_alpha)
            
            total_weight = total_weight + weight
        i = i + 1
    
    if total_weight < 0.0001:
        return
    
    # Apply axis filter
    let current_transform = skeleton_cache.bone_transforms[source_index]
    let filtered_scale = apply_to_vector(
        constraint.base.axis_filter,
        current_transform.scale,
        blended_scale
    )
    
    # Apply constraint weight
    let final_scale = lerp_vec3(current_transform.scale, filtered_scale, constraint.base.weight)
    
    skeleton_cache.bone_transforms[source_index] = BoneTransform(
        position: current_transform.position,
        rotation: current_transform.rotation,
        scale: final_scale
    )
    mark_dirty(skeleton_cache, source_index)

# Pole Vector Constraint Evaluation
fn evaluate_pole_vector_constraints(
    constraints: Array<PoleVectorConstraintData>,
    rig_state: RigState,
    skeleton_cache: SkeletonCache
):
    let i = 0
    while i < len(constraints):
        let constraint = constraints[i]
        if constraint.base.enabled and constraint.base.weight > 0.0:
            evaluate_pole_vector_constraint(constraint, rig_state, skeleton_cache)
        i = i + 1

fn evaluate_pole_vector_constraint(
    constraint: PoleVectorConstraintData,
    rig_state: RigState,
    skeleton_cache: SkeletonCache
):
    # Find the IK chain
    let chain_index = find_ik_chain(rig_state, constraint.ik_chain_name)
    if chain_index < 0:
        return
    
    let chain = rig_state.ik_chains[chain_index]
    
    # Get target position
    if len(constraint.base.target_bone_indices) < 1:
        return
    
    let target_index = constraint.base.target_bone_indices[0]
    if target_index < 0 or target_index >= len(skeleton_cache.world_transforms):
        return
    
    let target_pos = skeleton_cache.world_transforms[target_index].position
    
    # Apply pole angle rotation
    if constraint.pole_angle != 0.0:
        # Rotate pole vector around the IK chain axis
        let root_index = chain.bone_indices[0]
        let end_index = chain.bone_indices[len(chain.bone_indices) - 1]
        
        if root_index >= 0 and end_index >= 0:
            let root_pos = skeleton_cache.world_transforms[root_index].position
            let end_pos = skeleton_cache.world_transforms[end_index].position
            
            let chain_axis = normalize(vec3(
                end_pos.x - root_pos.x,
                end_pos.y - root_pos.y,
                end_pos.z - root_pos.z
            ))
            
            let rotation = quat_from_axis_angle(chain_axis, constraint.pole_angle)
            let offset = vec3(
                target_pos.x - root_pos.x,
                target_pos.y - root_pos.y,
                target_pos.z - root_pos.z
            )
            let rotated_offset = rotate_vector_by_quat(offset, rotation)
            
            target_pos = vec3(
                root_pos.x + rotated_offset.x,
                root_pos.y + rotated_offset.y,
                root_pos.z + rotated_offset.z
            )
    
    # Update chain pole vector
    chain.pole_vector = target_pos

# Constraint Initialization
fn initialize_constraint(
    constraint: ConstraintData,
    skeleton_cache: SkeletonCache
) -> ConstraintData:
    # Find source bone index
    let source_index = find_bone_index(skeleton_cache, constraint.source_bone)
    
    # Find target bone indices
    let target_indices = []
    let i = 0
    while i < len(constraint.target_bones):
        let target_name = constraint.target_bones[i]
        let target_index = find_bone_index(skeleton_cache, target_name)
        push(target_indices, target_index)
        i = i + 1
    
    return ConstraintData(
        constraint_name: constraint.constraint_name,
        constraint_type: constraint.constraint_type,
        source_bone: constraint.source_bone,
        source_bone_index: source_index,
        target_bones: constraint.target_bones,
        target_bone_indices: target_indices,
        target_weights: constraint.target_weights,
        weight: constraint.weight,
        space: constraint.space,
        axis_filter: constraint.axis_filter,
        enabled: constraint.enabled,
        maintain_offset: constraint.maintain_offset
    )

# Constraint Offset Calculation
fn calculate_parent_constraint_offsets(
    constraint: ParentConstraintData,
    skeleton_cache: SkeletonCache
) -> ParentConstraintData:
    let offsets = []
    
    let source_index = constraint.base.source_bone_index
    if source_index < 0:
        return constraint
    
    let source_world = skeleton_cache.world_transforms[source_index]
    
    let i = 0
    while i < len(constraint.base.target_bone_indices):
        let target_index = constraint.base.target_bone_indices[i]
        if target_index >= 0 and target_index < len(skeleton_cache.world_transforms):
            let target_world = skeleton_cache.world_transforms[target_index]
            let target_inv = inverse_transform(target_world)
            let offset = multiply_transform(target_inv, source_world)
            push(offsets, offset)
        else:
            push(offsets, identity())
        i = i + 1
    
    return ParentConstraintData(
        base: constraint.base,
        offset_transforms: offsets
    )

fn calculate_position_constraint_offsets(
    constraint: PositionConstraintData,
    skeleton_cache: SkeletonCache
) -> PositionConstraintData:
    let offsets = []
    
    let source_index = constraint.base.source_bone_index
    if source_index < 0:
        return constraint
    
    let source_pos = skeleton_cache.world_transforms[source_index].position
    
    let i = 0
    while i < len(constraint.base.target_bone_indices):
        let target_index = constraint.base.target_bone_indices[i]
        if target_index >= 0 and target_index < len(skeleton_cache.world_transforms):
            let target_pos = skeleton_cache.world_transforms[target_index].position
            let offset = vec3(
                source_pos.x - target_pos.x,
                source_pos.y - target_pos.y,
                source_pos.z - target_pos.z
            )
            push(offsets, offset)
        else:
            push(offsets, vec3(0.0, 0.0, 0.0))
        i = i + 1
    
    return PositionConstraintData(
        base: constraint.base,
        offsets: offsets
    )

fn calculate_rotation_constraint_offsets(
    constraint: RotationConstraintData,
    skeleton_cache: SkeletonCache
) -> RotationConstraintData:
    let offsets = []
    
    let source_index = constraint.base.source_bone_index
    if source_index < 0:
        return constraint
    
    let source_rot = skeleton_cache.world_transforms[source_index].rotation
    
    let i = 0
    while i < len(constraint.base.target_bone_indices):
        let target_index = constraint.base.target_bone_indices[i]
        if target_index >= 0 and target_index < len(skeleton_cache.world_transforms):
            let target_rot = skeleton_cache.world_transforms[target_index].rotation
            let target_inv = conjugate_quat(target_rot)
            let offset = multiply_quat(target_inv, source_rot)
            push(offsets, offset)
        else:
            push(offsets, vec4(0.0, 0.0, 0.0, 1.0))
        i = i + 1
    
    return RotationConstraintData(
        base: constraint.base,
        offset_rotations: offsets,
        interpolation_type: constraint.interpolation_type
    )

# Constraint Validation
fn validate_constraint(constraint: ConstraintData) -> Bool:
    if constraint.source_bone_index < 0:
        return false
    
    if len(constraint.target_bone_indices) == 0:
        return false
    
    if len(constraint.target_weights) != len(constraint.target_bone_indices):
        return false
    
    return true

# Constraint Debugging
fn debug_constraint(constraint: ConstraintData) -> String:
    let info = "Constraint: " + constraint.constraint_name + "\n"
    info = info + "Type: " + constraint_type_to_string(constraint.constraint_type) + "\n"
    info = info + "Source: " + constraint.source_bone + " (index: " + int_to_string(constraint.source_bone_index) + ")\n"
    info = info + "Targets: " + int_to_string(len(constraint.target_bones)) + "\n"
    info = info + "Weight: " + float_to_string(constraint.weight) + "\n"
    info = info + "Enabled: " + bool_to_string(constraint.enabled) + "\n"
    return info

fn constraint_type_to_string(ctype: ConstraintType) -> String:
    if ctype == ConstraintType.Aim:
        return "Aim"
    else:
        if ctype == ConstraintType.Parent:
            return "Parent"
        else:
            if ctype == ConstraintType.Position:
                return "Position"
            else:
                if ctype == ConstraintType.Rotation:
                    return "Rotation"
                else:
                    if ctype == ConstraintType.Scale:
                        return "Scale"
                    else:
                        return "PoleVector"
