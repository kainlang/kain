# Rig state serialization (simplified - would use proper file I/O)
fn save_rig_state_to_file(rig_state: RigState, filename: String):
    println("Saving rig state to " + filename)
    # Would serialize rig_state to JSON/binary format

fn load_rig_state_from_file(filename: String) -> RigState:
    println("Loading rig state from " + filename)
    # Would deserialize from JSON/binary format
    return create_rig_state("Loaded")

fn float(value: Int) -> Float:
    return value * 1.0
