# ============================================================================
# PRESET REGISTRY
# ============================================================================

let all_presets = [
    skin_basic, leather_worn, alien_bio, bark, zombie, dragon_scale,
    rubber_matte, latex_shiny, tire_worn, plastic_rough, gasket,
    ground_wet, rock_rough, concrete, snow, asphalt,
    denim, silk, wool, canvas, velvet,
    iron_rusty, gold_dirty, aluminum_brushed, scifi_panel, copper,
    plastic_glossy, plastic_matte, bakelite, pvc,
    cardboard, paper_clean, parchment
]

# ============================================================================
# BLUEPRINT FUNCTIONS
# ============================================================================

@blueprint
fn get_all_materialize_presets() -> Array<MaterializePreset>:
    return all_presets

@blueprint
fn get_materialize_presets_by_category(category: MaterialCategory) -> Array<MaterializePreset>:
    let result: Array<MaterializePreset> = []
    for preset in all_presets:
        if preset.category == category:
            push(result, preset)
    return result

@blueprint
fn get_materialize_preset_by_id(id: String) -> MaterializePreset?:
    for preset in all_presets:
        if preset.id == id:
            return preset
    return null

@blueprint
fn get_default_materialize_params() -> MaterializeParams:
    return MaterializeParams:
        normal_strength: 1.0
        roughness_base: 0.7
        roughness_contrast: 1.0
        roughness_brightness: 0.0
        roughness_invert: true
        variance_weight: 0.5
        metallic_base: 0.0
        metallic_contrast: 1.0
        metallic_bias: 0.0
        metallic_sensitivity: 2.0
        ao_intensity: 1.0
        height_contrast: 1.0
        edge_wear: 0.0
        cavity_dirt: 0.0
        dust: 0.0
        grunge: 0.0
        scratches: 0.0
        noise: 0.0
        bio_detail: 0.0
        bio_frequency: 1.0
        cyber_detail: 0.0
        cyber_scale: 1.0
        emissive_threshold: 0.0
        emissive_color_boost: 1.0
        make_seamless: false
        seamless_mode: SeamlessMode.CrossBlend
        seamless_blend_width: 0.25
        gamma: 1.0
        vignette: 0.0
        pack_orm: true
        output_resolution: 0
        height_iterations: 24
        use_multi_pass_height: true
        normal_octaves: 3
        normal_sigma_base: 1.0
        normal_anisotropy: 1.0
        ao_radius: 4.0
        ao_bias: 0.0
        ao_contrast: 1.0
        advanced_normal: false
        advanced_ao: false
