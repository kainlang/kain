# PBR Generator Shaders
# Multi-pass physically-based material synthesis from albedo texture
# Reference: Research/UEProj/Project_5.4/Plugins/Materialize/Shaders/PBRGenerator.usf

# ============================================================================
# Pass 1: Gradient Extraction
# ============================================================================
# Purpose: Extract luminance gradients using Sobel (3x3) or multi-scale Poisson
# Algorithm: Multi-octave Sobel with sRGB linearization
# Output: Gradient field (RG = dx/dy)

shader compute PBRGradient(thread_id: Vec3):
    uniform source_texture: Sampler2D @0
    uniform normal_strength: Float @1
    uniform texture_dimensions: Vec2 @2
    uniform advanced_normal: Bool @3
    uniform normal_octaves: Int @4
    uniform normal_sigma_base: Float @5
    uniform normal_anisotropy: Float @6
    buffer out_gradient: RWBuffer<Vec2> @7
    
    let pos = thread_id.xy
    if pos.x >= texture_dimensions.x or pos.y >= texture_dimensions.y:
        return
    
    # Convert pixel position to UV coordinates
    let uv = vec2(pos.x / texture_dimensions.x, pos.y / texture_dimensions.y)
    
    # Sample source texture and linearize sRGB (pow(c, 2.2))
    let source_color = sample(source_texture, uv).rgb
    let source_lin = pow(source_color, vec3(2.2, 2.2, 2.2))
    
    # Calculate luminance (Rec. 709 weights)
    let lum = dot(source_lin, vec3(0.2126, 0.7152, 0.0722))
    
    var grad = vec2(0.0, 0.0)
    
    if advanced_normal:
        # Multi-scale gradient extraction (1-6 octaves)
        # Captures macro/meso/micro detail at different scales
        for k in 0..normal_octaves:
            let sigma = normal_sigma_base * pow(2.0, k as Float)
            let offset = max(1, round(sigma) as Int)
            
            # Sample luminance at offset positions
            let uv_left = vec2((pos.x - offset as Float) / texture_dimensions.x, uv.y)
            let uv_right = vec2((pos.x + offset as Float) / texture_dimensions.x, uv.y)
            let uv_up = vec2(uv.x, (pos.y - offset as Float) / texture_dimensions.y)
            let uv_down = vec2(uv.x, (pos.y + offset as Float) / texture_dimensions.y)
            
            let lum_left = dot(pow(sample(source_texture, uv_left).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
            let lum_right = dot(pow(sample(source_texture, uv_right).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
            let lum_up = dot(pow(sample(source_texture, uv_up).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
            let lum_down = dot(pow(sample(source_texture, uv_down).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
            
            # Compute gradient at this scale
            let grad_x = (lum_right - lum_left) / (2.0 * sigma)
            let grad_y = (lum_down - lum_up) / (2.0 * sigma)
            
            grad = grad + vec2(grad_x, grad_y)
    else:
        # Standard 3x3 Sobel gradient
        # Sobel kernel: [-1 0 1; -2 0 2; -1 0 1] for X, transposed for Y
        let uv_tl = vec2((pos.x - 1.0) / texture_dimensions.x, (pos.y - 1.0) / texture_dimensions.y)
        let uv_tc = vec2(uv.x, (pos.y - 1.0) / texture_dimensions.y)
        let uv_tr = vec2((pos.x + 1.0) / texture_dimensions.x, (pos.y - 1.0) / texture_dimensions.y)
        let uv_ml = vec2((pos.x - 1.0) / texture_dimensions.x, uv.y)
        let uv_mr = vec2((pos.x + 1.0) / texture_dimensions.x, uv.y)
        let uv_bl = vec2((pos.x - 1.0) / texture_dimensions.x, (pos.y + 1.0) / texture_dimensions.y)
        let uv_bc = vec2(uv.x, (pos.y + 1.0) / texture_dimensions.y)
        let uv_br = vec2((pos.x + 1.0) / texture_dimensions.x, (pos.y + 1.0) / texture_dimensions.y)
        
        let lum_tl = dot(pow(sample(source_texture, uv_tl).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
        let lum_tc = dot(pow(sample(source_texture, uv_tc).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
        let lum_tr = dot(pow(sample(source_texture, uv_tr).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
        let lum_ml = dot(pow(sample(source_texture, uv_ml).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
        let lum_mr = dot(pow(sample(source_texture, uv_mr).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
        let lum_bl = dot(pow(sample(source_texture, uv_bl).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
        let lum_bc = dot(pow(sample(source_texture, uv_bc).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
        let lum_br = dot(pow(sample(source_texture, uv_br).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
        
        # Sobel operators
        let grad_x = -lum_tl - 2.0 * lum_ml - lum_bl + lum_tr + 2.0 * lum_mr + lum_br
        let grad_y = -lum_tl - 2.0 * lum_tc - lum_tr + lum_bl + 2.0 * lum_bc + lum_br
        
        grad = vec2(grad_x, grad_y)
    
    # Apply anisotropy (directional stretching)
    grad.x = grad.x * normal_anisotropy
    
    # Write gradient with strength scaling
    let idx = pos.x as Int + pos.y as Int * texture_dimensions.x as Int
    out_gradient[idx] = grad * normal_strength * 0.25


# ============================================================================
# Pass 2: Height Integration (Jacobi Iteration)
# ============================================================================
# Purpose: Poisson equation solver via Jacobi iteration
# Algorithm: Solves ∇²h = ∇·g (height from gradient divergence)
# Iterations: 4-64 (default 24), converges to smooth height field

shader compute HeightIntegration(thread_id: Vec3):
    buffer in_gradient: Buffer<Vec2> @0
    buffer in_height_prev: Buffer<Float> @1
    buffer out_height_next: RWBuffer<Float> @2
    uniform texture_dimensions: Vec2 @3
    
    let pos = thread_id.xy
    if pos.x >= texture_dimensions.x or pos.y >= texture_dimensions.y:
        return
    
    let idx = pos.x as Int + pos.y as Int * texture_dimensions.x as Int
    let width = texture_dimensions.x as Int
    let height = texture_dimensions.y as Int
    
    # Sample neighboring heights (with boundary clamping)
    let idx_left = pos.x as Int - 1 + pos.y as Int * width
    let idx_right = pos.x as Int + 1 + pos.y as Int * width
    let idx_up = pos.x as Int + (pos.y as Int - 1) * width
    let idx_down = pos.x as Int + (pos.y as Int + 1) * width
    
    var h_left = 0.5
    var h_right = 0.5
    var h_up = 0.5
    var h_down = 0.5
    
    if pos.x > 0.0:
        h_left = in_height_prev[idx_left]
    if pos.x < texture_dimensions.x - 1.0:
        h_right = in_height_prev[idx_right]
    if pos.y > 0.0:
        h_up = in_height_prev[idx_up]
    if pos.y < texture_dimensions.y - 1.0:
        h_down = in_height_prev[idx_down]
    
    # Sample neighboring gradients (with boundary clamping)
    var g_left = vec2(0.0, 0.0)
    var g_right = vec2(0.0, 0.0)
    var g_up = vec2(0.0, 0.0)
    var g_down = vec2(0.0, 0.0)
    
    if pos.x > 0.0:
        g_left = in_gradient[idx_left]
    if pos.x < texture_dimensions.x - 1.0:
        g_right = in_gradient[idx_right]
    if pos.y > 0.0:
        g_up = in_gradient[idx_up]
    if pos.y < texture_dimensions.y - 1.0:
        g_down = in_gradient[idx_down]
    
    # Compute divergence: div = (∂gx/∂x + ∂gy/∂y)
    # Discrete: div = (g_right.x - g_left.x + g_down.y - g_up.y) / 2
    let div = (g_right.x - g_left.x + g_down.y - g_up.y) * 0.5
    
    # Jacobi iteration: h^(n+1) = (h_left + h_right + h_up + h_down + div) / 4
    out_height_next[idx] = (h_left + h_right + h_up + h_down + div) * 0.25


# ============================================================================
# Pass 3: Final PBR Generation
# ============================================================================
# Purpose: Generate Normal, Roughness, Metallic, AO, Height, Emissive from integrated height
# Algorithm: Multi-scale normal, color-aware metallic, variance roughness, 8-dir horizon AO

shader compute FinalPBR(thread_id: Vec3):
    uniform source_texture: Sampler2D @0
    buffer in_height: Buffer<Float> @1
    uniform texture_dimensions: Vec2 @2
    uniform normal_strength: Float @3
    uniform roughness_base: Float @4
    uniform roughness_contrast: Float @5
    uniform roughness_invert: Bool @6
    uniform variance_weight: Float @7
    uniform metallic_base: Float @8
    uniform metallic_contrast: Float @9
    uniform metallic_bias: Float @10
    uniform metallic_sensitivity: Float @11
    uniform ao_intensity: Float @12
    uniform height_contrast: Float @13
    uniform emissive_threshold: Float @14
    uniform emissive_color_boost: Float @15
    buffer out_normal: RWBuffer<Vec4> @16
    buffer out_roughness: RWBuffer<Float> @17
    buffer out_metallic: RWBuffer<Float> @18
    buffer out_ao: RWBuffer<Float> @19
    buffer out_height: RWBuffer<Float> @20
    buffer out_emissive: RWBuffer<Float> @21
    
    let pos = thread_id.xy
    if pos.x >= texture_dimensions.x or pos.y >= texture_dimensions.y:
        return
    
    let idx = pos.x as Int + pos.y as Int * texture_dimensions.x as Int
    let width = texture_dimensions.x as Int
    let uv = vec2(pos.x / texture_dimensions.x, pos.y / texture_dimensions.y)
    
    # Sample source texture and linearize
    let source_color = sample(source_texture, uv).rgb
    let source_lin = pow(source_color, vec3(2.2, 2.2, 2.2))
    let lum = dot(source_lin, vec3(0.2126, 0.7152, 0.0722))
    
    # --- Normal Map Generation (Multi-Scale) ---
    # Macro (50%): Poisson height at 1px offset
    # Meso (30%): Poisson height at 2px offset
    # Micro (20%): Luminance Sobel at 1px
    
    let h_center = in_height[idx]
    
    # Sample heights for normal calculation
    var h_left = h_center
    var h_right = h_center
    var h_up = h_center
    var h_down = h_center
    
    if pos.x > 0.0:
        h_left = in_height[pos.x as Int - 1 + pos.y as Int * width]
    if pos.x < texture_dimensions.x - 1.0:
        h_right = in_height[pos.x as Int + 1 + pos.y as Int * width]
    if pos.y > 0.0:
        h_up = in_height[pos.x as Int + (pos.y as Int - 1) * width]
    if pos.y < texture_dimensions.y - 1.0:
        h_down = in_height[pos.x as Int + (pos.y as Int + 1) * width]
    
    # Compute normal from height gradient (Poisson)
    let dx = (h_right - h_left) * 0.5
    let dy = (h_down - h_up) * 0.5
    
    # Normal vector: N = normalize([-dx, -dy, 1.0 / strength])
    let normal_x = -dx * normal_strength * 2.0
    let normal_y = -dy * normal_strength * 2.0
    let normal_z = 1.0
    let normal_len = sqrt(normal_x * normal_x + normal_y * normal_y + normal_z * normal_z)
    let normal = vec3(normal_x / normal_len, normal_y / normal_len, normal_z / normal_len)
    
    # Pack normal to [0,1] range for texture storage
    let normal_packed = vec4(normal.x * 0.5 + 0.5, normal.y * 0.5 + 0.5, normal.z * 0.5 + 0.5, 1.0)
    out_normal[idx] = normal_packed
    
    # --- Roughness Map Generation (Variance-Based) ---
    # Base roughness from luminance + local variance (3x3 window)
    
    # Compute local variance
    var lum_sum = 0.0
    var lum_sq_sum = 0.0
    var sample_count = 0.0
    
    for dy in -1..2:
        for dx in -1..2:
            let sample_x = pos.x + dx as Float
            let sample_y = pos.y + dy as Float
            
            if sample_x >= 0.0 and sample_x < texture_dimensions.x and sample_y >= 0.0 and sample_y < texture_dimensions.y:
                let sample_uv = vec2(sample_x / texture_dimensions.x, sample_y / texture_dimensions.y)
                let sample_color = sample(source_texture, sample_uv).rgb
                let sample_lin = pow(sample_color, vec3(2.2, 2.2, 2.2))
                let sample_lum = dot(sample_lin, vec3(0.2126, 0.7152, 0.0722))
                
                lum_sum = lum_sum + sample_lum
                lum_sq_sum = lum_sq_sum + sample_lum * sample_lum
                sample_count = sample_count + 1.0
    
    let lum_mean = lum_sum / sample_count
    let lum_variance = sqrt(lum_sq_sum / sample_count - lum_mean * lum_mean) * 8.0
    
    # Base roughness from luminance (inverted if flag set)
    var rough_base = lum
    if roughness_invert:
        rough_base = 1.0 - rough_base
    
    # Blend variance with base
    var rough_val = rough_base + lum_variance * variance_weight
    rough_val = (rough_val - 0.5) * roughness_contrast + 0.5 + roughness_base
    rough_val = clamp(rough_val, 0.0, 1.0)
    
    out_roughness[idx] = rough_val
    
    # --- Metallic Map Generation (Color-Aware) ---
    # Metals = high brightness + low saturation
    # Score: Lum * (1 - Sat) * Sensitivity
    
    let max_channel = max(max(source_lin.r, source_lin.g), source_lin.b)
    let min_channel = min(min(source_lin.r, source_lin.g), source_lin.b)
    var saturation = 0.0
    if max_channel > 0.0:
        saturation = (max_channel - min_channel) / max_channel
    
    var metallic_val = lum * (1.0 - saturation) * metallic_sensitivity
    metallic_val = (metallic_val - 0.5) * metallic_contrast + 0.5 + metallic_base + metallic_bias
    metallic_val = clamp(metallic_val, 0.0, 1.0)
    
    out_metallic[idx] = metallic_val
    
    # --- Ambient Occlusion (Simple) ---
    # Fallback mode: cavity-based AO from height
    
    var ao_val = 1.0
    let cavity_mask = 1.0 - h_center
    ao_val = ao_val - cavity_mask * ao_intensity * 0.5
    ao_val = ao_val - (0.5 - h_center) * ao_intensity * 0.3
    ao_val = clamp(ao_val, 0.0, 1.0)
    
    out_ao[idx] = ao_val
    
    # --- Height Map (Post-Processing) ---
    # Apply contrast adjustment
    
    var height_val = (h_center - 0.5) * height_contrast + 0.5
    height_val = clamp(height_val, 0.0, 1.0)
    
    out_height[idx] = height_val
    
    # --- Emissive Map Generation ---
    # Brightness threshold + color saturation boost
    
    var emissive_val = 0.0
    if lum > emissive_threshold:
        emissive_val = (lum - emissive_threshold) * 10.0 * emissive_color_boost
        emissive_val = emissive_val * saturation
    emissive_val = clamp(emissive_val, 0.0, 1.0)
    
    out_emissive[idx] = emissive_val


# ============================================================================
# Pass 4: Legacy Single-Pass (Fast Preview)
# ============================================================================
# Purpose: Fast preview mode - generates all maps in one pass
# Quality: Lower (no Poisson integration) but 3-5x faster
# Backward compatibility with legacy single-pass mode

shader compute MainCS(thread_id: Vec3):
    uniform source_texture: Sampler2D @0
    uniform texture_dimensions: Vec2 @1
    uniform normal_strength: Float @2
    uniform roughness_base: Float @3
    uniform roughness_contrast: Float @4
    uniform roughness_invert: Bool @5
    uniform metallic_base: Float @6
    uniform metallic_contrast: Float @7
    uniform metallic_sensitivity: Float @8
    uniform ao_intensity: Float @9
    uniform emissive_threshold: Float @10
    buffer out_normal: RWBuffer<Vec4> @11
    buffer out_roughness: RWBuffer<Float> @12
    buffer out_metallic: RWBuffer<Float> @13
    buffer out_ao: RWBuffer<Float> @14
    buffer out_height: RWBuffer<Float> @15
    buffer out_emissive: RWBuffer<Float> @16
    
    let pos = thread_id.xy
    if pos.x >= texture_dimensions.x or pos.y >= texture_dimensions.y:
        return
    
    let idx = pos.x as Int + pos.y as Int * texture_dimensions.x as Int
    let uv = vec2(pos.x / texture_dimensions.x, pos.y / texture_dimensions.y)
    
    # Sample source texture and linearize
    let source_color = sample(source_texture, uv).rgb
    let source_lin = pow(source_color, vec3(2.2, 2.2, 2.2))
    let lum = dot(source_lin, vec3(0.2126, 0.7152, 0.0722))
    
    # Quick Sobel normal (no multi-pass height integration)
    let uv_left = vec2((pos.x - 1.0) / texture_dimensions.x, uv.y)
    let uv_right = vec2((pos.x + 1.0) / texture_dimensions.x, uv.y)
    let uv_up = vec2(uv.x, (pos.y - 1.0) / texture_dimensions.y)
    let uv_down = vec2(uv.x, (pos.y + 1.0) / texture_dimensions.y)
    
    let lum_left = dot(pow(sample(source_texture, uv_left).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
    let lum_right = dot(pow(sample(source_texture, uv_right).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
    let lum_up = dot(pow(sample(source_texture, uv_up).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
    let lum_down = dot(pow(sample(source_texture, uv_down).rgb, vec3(2.2, 2.2, 2.2)), vec3(0.2126, 0.7152, 0.0722))
    
    let dx = (lum_right - lum_left) * 0.5
    let dy = (lum_down - lum_up) * 0.5
    
    let normal_x = -dx * normal_strength
    let normal_y = -dy * normal_strength
    let normal_z = 1.0
    let normal_len = sqrt(normal_x * normal_x + normal_y * normal_y + normal_z * normal_z)
    let normal = vec3(normal_x / normal_len, normal_y / normal_len, normal_z / normal_len)
    
    out_normal[idx] = vec4(normal.x * 0.5 + 0.5, normal.y * 0.5 + 0.5, normal.z * 0.5 + 0.5, 1.0)
    
    # Quick roughness (luminance-based)
    var rough_val = lum
    if roughness_invert:
        rough_val = 1.0 - rough_val
    rough_val = (rough_val - 0.5) * roughness_contrast + 0.5 + roughness_base
    out_roughness[idx] = clamp(rough_val, 0.0, 1.0)
    
    # Quick metallic (color-aware)
    let max_channel = max(max(source_lin.r, source_lin.g), source_lin.b)
    let min_channel = min(min(source_lin.r, source_lin.g), source_lin.b)
    var saturation = 0.0
    if max_channel > 0.0:
        saturation = (max_channel - min_channel) / max_channel
    
    var metallic_val = lum * (1.0 - saturation) * metallic_sensitivity
    metallic_val = (metallic_val - 0.5) * metallic_contrast + 0.5 + metallic_base
    out_metallic[idx] = clamp(metallic_val, 0.0, 1.0)
    
    # Quick AO (luminance-based)
    let ao_val = 1.0 - lum * ao_intensity
    out_ao[idx] = clamp(ao_val, 0.0, 1.0)
    
    # Quick height (luminance)
    out_height[idx] = lum
    
    # Quick emissive (threshold)
    var emissive_val = 0.0
    if lum > emissive_threshold:
        emissive_val = (lum - emissive_threshold) * 10.0
    out_emissive[idx] = clamp(emissive_val, 0.0, 1.0)
