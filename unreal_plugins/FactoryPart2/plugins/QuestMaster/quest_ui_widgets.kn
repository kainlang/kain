// QuestMaster — UI Widgets
// Phase 7: Slate widgets for quest display (8 widgets)

// ============================================================================
// QUEST LOG WIDGET
// ============================================================================

@slate
struct QuestLogWidget:
    quest_list: Array<QuestLogEntry>
    filter_mode: QuestFilterMode = QuestFilterMode::All
    sort_mode: QuestSortMode = QuestSortMode::Priority
    selected_quest_id: String = ""
    show_completed: Bool = true
    show_failed: Bool = false
    show_hidden: Bool = false
    
    fn construct():
        println("Constructing QuestLogWidget")
    
    @blueprint
    fn set_quests(quests: Array<QuestLogEntry>):
        quest_list = quests
        println("Set quest list: {len(quests)} quests")
    
    @blueprint
    fn filter_quests(mode: QuestFilterMode):
        filter_mode = mode
        println("Filtering quests by: {mode}")
    
    @blueprint
    fn sort_quests(mode: QuestSortMode):
        sort_mode = mode
        println("Sorting quests by: {mode}")
    
    @blueprint
    fn select_quest(quest_id: String):
        selected_quest_id = quest_id
        println("Selected quest: {quest_id}")
    
    @blueprint
    fn get_selected_quest() -> String:
        return selected_quest_id
    
    @blueprint
    fn get_filtered_quests() -> Array<QuestLogEntry>:
        return quest_list
    
    @blueprint
    fn get_quest_count() -> Int:
        return len(quest_list)
    
    @blueprint
    fn clear_selection():
        selected_quest_id = ""
    
    @blueprint
    fn refresh_quest_list():
        println("Refreshing quest list")
    
    @blueprint
    fn toggle_show_completed():
        show_completed = !show_completed
        println("Show completed: {show_completed}")
    
    @blueprint
    fn toggle_show_failed():
        show_failed = !show_failed
        println("Show failed: {show_failed}")

