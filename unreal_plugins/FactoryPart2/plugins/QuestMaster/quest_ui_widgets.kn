@slate
struct QuestTrackerWidget:
    tracked_quest_id: String = ""
    quest_name: String = ""
    objectives: Array<ObjectiveProgress>
    show_objectives: Bool = true
    show_progress_bars: Bool = true
    max_objectives_shown: Int = 5
    compact_mode: Bool = false
    
    fn construct():
        println("Constructing QuestTrackerWidget")
    
    @blueprint
    fn set_tracked_quest(quest_id: String, name: String):
        tracked_quest_id = quest_id
        quest_name = name
        println("Tracking quest: {name}")
    
    @blueprint
    fn update_objectives(obj_list: Array<ObjectiveProgress>):
        objectives = obj_list
        println("Updated objectives: {len(obj_list)} objectives")
    
    @blueprint
    fn update_progress(quest_id: String, progress: Float):
        println("Updated progress for {quest_id}: {progress}%")
    
    @blueprint
    fn clear_tracked_quest():
        tracked_quest_id = ""
        quest_name = ""
        objectives = []
        println("Cleared tracked quest")
    
    @blueprint
    fn get_tracked_quest_id() -> String:
        return tracked_quest_id
    
    @blueprint
    fn get_objective_count() -> Int:
        return len(objectives)
    
    @blueprint
    fn toggle_objectives_visibility():
        show_objectives = !show_objectives
        println("Show objectives: {show_objectives}")
    
    @blueprint
    fn toggle_progress_bars():
        show_progress_bars = !show_progress_bars
        println("Show progress bars: {show_progress_bars}")
    
    @blueprint
    fn set_compact_mode(compact: Bool):
        compact_mode = compact
        println("Compact mode: {compact}")
    
    @blueprint
    fn set_max_objectives(max_count: Int):
        max_objectives_shown = max_count
        println("Max objectives shown: {max_count}")

// ============================================================================
// QUEST NOTIFICATION WIDGET
// ============================================================================

@slate
struct QuestNotificationWidget:
    notification_text: String = ""
    notification_type: QuestNotificationType = QuestNotificationType::Started
    display_duration: Float = 5.0
    fade_in_duration: Float = 0.5
    fade_out_duration: Float = 0.5
    current_alpha: Float = 0.0
    elapsed_time: Float = 0.0
    is_visible: Bool = false
    
    fn construct():
        println("Constructing QuestNotificationWidget")
    
    @blueprint
    fn show_quest_started(quest_name: String):
        notification_text = "Quest Started: {quest_name}"
        notification_type = QuestNotificationType::Started
        show_notification()
    
    @blueprint
    fn show_quest_completed(quest_name: String):
        notification_text = "Quest Completed: {quest_name}"
        notification_type = QuestNotificationType::Completed
        show_notification()
    
    @blueprint
    fn show_quest_failed(quest_name: String, reason: String):
        notification_text = "Quest Failed: {quest_name}"
        notification_type = QuestNotificationType::Failed
        show_notification()
    
    @blueprint
    fn show_objective_completed(objective_description: String):
        notification_text = "Objective Complete: {objective_description}"
        notification_type = QuestNotificationType::ObjectiveCompleted
        show_notification()
    
    @blueprint
    fn show_notification():
        is_visible = true
        elapsed_time = 0.0
        current_alpha = 0.0
        println("Showing notification: {notification_text}")
    
    @blueprint
    fn hide_notification():
        is_visible = false
        current_alpha = 0.0
        println("Hiding notification")
    
    @blueprint
    fn tick_widget(delta_time: Float):
        if !is_visible:
            return
        
        elapsed_time = elapsed_time + delta_time
        
        if elapsed_time < fade_in_duration:
            current_alpha = elapsed_time / fade_in_duration
        else:
            if elapsed_time < (display_duration - fade_out_duration):
                current_alpha = 1.0
            else:
                if elapsed_time < display_duration:
                    let fade_progress = (elapsed_time - (display_duration - fade_out_duration)) / fade_out_duration
                    current_alpha = 1.0 - fade_progress
                else:
                    hide_notification()
    
    @blueprint
    fn set_display_duration(duration: Float):
        display_duration = duration
    
    @blueprint
    fn set_fade_durations(fade_in: Float, fade_out: Float):
        fade_in_duration = fade_in
        fade_out_duration = fade_out
    
    @blueprint
    fn get_current_alpha() -> Float:
        return current_alpha
    
    @blueprint
    fn is_notification_visible() -> Bool:
        return is_visible

