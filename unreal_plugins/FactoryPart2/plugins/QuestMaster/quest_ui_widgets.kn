@slate
struct QuestDetailWidget:
    quest_id: String = ""
    quest_name: String = ""
    quest_description: String = ""
    quest_category: QuestCategory = QuestCategory::Side
    quest_priority: QuestPriority = QuestPriority::Normal
    objectives: Array<ObjectiveProgress>
    rewards: RewardDisplay
    show_description: Bool = true
    show_objectives: Bool = true
    show_rewards: Bool = true
    show_lore: Bool = true
    lore_text: String = ""
    
    fn construct():
        println("Constructing QuestDetailWidget")
    
    @blueprint
    fn set_quest(quest_instance: QuestInstance, quest_data: QuestData):
        quest_id = quest_instance.quest_id
        quest_name = quest_data.name
        quest_description = quest_data.description
        quest_category = quest_data.category
        quest_priority = quest_data.priority
        lore_text = quest_data.lore_text
        println("Set quest details: {quest_name}")
    
    @blueprint
    fn update_display():
        println("Updating quest detail display")
    
    @blueprint
    fn set_objectives(obj_list: Array<ObjectiveProgress>):
        objectives = obj_list
        println("Set objectives: {len(obj_list)}")
    
    @blueprint
    fn set_rewards(reward_display: RewardDisplay):
        rewards = reward_display
        println("Set rewards display")
    
    @blueprint
    fn toggle_description():
        show_description = !show_description
    
    @blueprint
    fn toggle_objectives():
        show_objectives = !show_objectives
    
    @blueprint
    fn toggle_rewards():
        show_rewards = !show_rewards
    
    @blueprint
    fn toggle_lore():
        show_lore = !show_lore
    
    @blueprint
    fn get_quest_id() -> String:
        return quest_id
    
    @blueprint
    fn get_quest_name() -> String:
        return quest_name
    
    @blueprint
    fn clear_quest():
        quest_id = ""
        quest_name = ""
        quest_description = ""
        objectives = []
        println("Cleared quest details")

// ============================================================================
// OBJECTIVE LIST WIDGET
// ============================================================================

@slate
struct ObjectiveListWidget:
    objectives: Array<ObjectiveProgress>
    show_progress_bars: Bool = true
    show_completion_state: Bool = true
    show_optional_objectives: Bool = true
    show_hidden_objectives: Bool = false
    highlight_completed: Bool = true
    
    fn construct():
        println("Constructing ObjectiveListWidget")
    
    @blueprint
    fn set_objectives(obj_list: Array<ObjectiveProgress>):
        objectives = obj_list
        println("Set objectives: {len(obj_list)}")
    
    @blueprint
    fn update_objective(objective_id: String, current_count: Int, target_count: Int):
        let i = 0
        while i < len(objectives):
            let obj = objectives[i]
            if obj.objective_id == objective_id:
                obj.current_count = current_count
                obj.target_count = target_count
                obj.progress_percentage = (current_count as Float) / (target_count as Float) * 100.0
                println("Updated objective {objective_id}: {current_count}/{target_count}")
            i = i + 1
    
    @blueprint
    fn mark_completed(objective_id: String):
        let i = 0
        while i < len(objectives):
            let obj = objectives[i]
            if obj.objective_id == objective_id:
                obj.completed = true
                println("Marked objective {objective_id} as completed")
            i = i + 1
    
    @blueprint
    fn get_objective_count() -> Int:
        return len(objectives)
    
    @blueprint
    fn get_completed_count() -> Int:
        let count = 0
        let i = 0
        while i < len(objectives):
            if objectives[i].completed:
                count = count + 1
            i = i + 1
        return count
    
    @blueprint
    fn toggle_progress_bars():
        show_progress_bars = !show_progress_bars
    
    @blueprint
    fn toggle_completion_state():
        show_completion_state = !show_completion_state
    
    @blueprint
    fn toggle_optional_objectives():
        show_optional_objectives = !show_optional_objectives
    
    @blueprint
    fn clear_objectives():
        objectives = []
        println("Cleared objectives")

