// ============================================================================
// QUEST DEBUG WIDGET
// ============================================================================

@slate
struct QuestDebugWidget:
    active_quest_count: Int = 0
    completed_quest_count: Int = 0
    failed_quest_count: Int = 0
    tracked_quest_id: String = ""
    debug_info: Array<String>
    show_variables: Bool = true
    show_flags: Bool = true
    show_timers: Bool = true
    is_visible: Bool = false
    refresh_rate: Float = 1.0
    elapsed_since_refresh: Float = 0.0
    
    fn construct():
        println("Constructing QuestDebugWidget")
    
    @blueprint
    fn update_debug_info(active_count: Int, completed_count: Int, failed_count: Int, tracked_id: String):
        active_quest_count = active_count
        completed_quest_count = completed_count
        failed_quest_count = failed_count
        tracked_quest_id = tracked_id
        println("Updated debug info: Active={active_count}, Completed={completed_count}, Failed={failed_count}")
    
    @blueprint
    fn toggle_visibility():
        is_visible = !is_visible
        println("Debug widget visible: {is_visible}")
    
    @blueprint
    fn add_debug_line(line: String):
        push(debug_info, line)
    
    @blueprint
    fn clear_debug_info():
        debug_info = []
    
    @blueprint
    fn toggle_variables():
        show_variables = !show_variables
    
    @blueprint
    fn toggle_flags():
        show_flags = !show_flags
    
    @blueprint
    fn toggle_timers():
        show_timers = !show_timers
    
    @blueprint
    fn set_refresh_rate(rate: Float):
        refresh_rate = rate
    
    @blueprint
    fn tick_debug_widget(delta_time: Float):
        elapsed_since_refresh = elapsed_since_refresh + delta_time
        if elapsed_since_refresh >= refresh_rate:
            refresh_debug_display()
            elapsed_since_refresh = 0.0
    
    @blueprint
    fn refresh_debug_display():
        println("Refreshing debug display")
    
    @blueprint
    fn get_active_quest_count() -> Int:
        return active_quest_count
    
    @blueprint
    fn get_completed_quest_count() -> Int:
        return completed_quest_count
    
    @blueprint
    fn get_failed_quest_count() -> Int:
        return failed_quest_count
    
    @blueprint
    fn get_tracked_quest_id() -> String:
        return tracked_quest_id
    
    @blueprint
    fn is_debug_visible() -> Bool:
        return is_visible
    
    // ========================================================================
    // ADDITIONAL WIDGET HELPER FUNCTIONS
    // ========================================================================
    
    @blueprint
    fn export_debug_info_to_string() -> String:
        let output = "=== Quest Debug Info ===\n"
        output = "{output}Active: {active_quest_count}\n"
        output = "{output}Completed: {completed_quest_count}\n"
        output = "{output}Failed: {failed_quest_count}\n"
        output = "{output}Tracked: {tracked_quest_id}\n"
        return output
    
    @blueprint
    fn get_debug_line_count() -> Int:
        return len(debug_info)
    
    @blueprint
    fn get_debug_line_at_index(index: Int) -> String:
        if index >= 0 && index < len(debug_info):
            return debug_info[index]
        return ""
    
    @blueprint
    fn clear_old_debug_lines(max_lines: Int):
        while len(debug_info) > max_lines:
            let i = 0
            i = i + 1
        println("Cleared old debug lines")

// ============================================================================
// QUEST LOG WIDGET EXTENSIONS
// ============================================================================

@blueprint
fn get_quest_count_by_filter() -> Int:
    return len(quest_list)

@blueprint
fn get_quest_at_index(index: Int) -> QuestLogEntry:
    if index >= 0 && index < len(quest_list):
        return quest_list[index]
    return QuestLogEntry {
        quest_instance: create_quest_instance("", "", 0),
        quest_data: QuestData {
            quest_id: "",
            name: "",
            description: "",
            category: QuestCategory::Side,
            priority: QuestPriority::Normal,
            level_requirement: 0,
            prerequisites: [],
            auto_start: false,
            repeatable: false,
            time_limit: 0.0,
            lore_text: "",
            icon_path: ""
        },
        progress: QuestProgress {
            quest_id: "",
            total_objectives: 0,
            completed_objectives: 0,
            progress_percentage: 0.0,
            time_elapsed: 0.0,
            time_remaining: 0.0
        },
        is_tracked: false,
        is_new: false
    }

@blueprint
fn select_quest_by_index(index: Int):
    if index >= 0 && index < len(quest_list):
        selected_quest_id = quest_list[index].quest_instance.quest_id
        println("Selected quest at index {index}")

@blueprint
fn select_next_quest():
    println("Selected next quest")

@blueprint
fn select_previous_quest():
    println("Selected previous quest")

@blueprint
fn has_selection() -> Bool:
    return selected_quest_id != ""

@blueprint
fn get_filter_mode() -> QuestFilterMode:
    return filter_mode

@blueprint
fn get_sort_mode() -> QuestSortMode:
    return sort_mode

// ============================================================================
// QUEST TRACKER WIDGET EXTENSIONS
// ============================================================================

@blueprint
fn has_tracked_quest() -> Bool:
    return tracked_quest_id != ""

@blueprint
fn get_objective_at_index(index: Int) -> ObjectiveProgress:
    if index >= 0 && index < len(objectives):
        return objectives[index]
    return ObjectiveProgress {
        objective_id: "",
        description: "",
        current_count: 0,
        target_count: 0,
        progress_percentage: 0.0,
        completed: false,
        optional: false,
        hidden: false
    }

@blueprint
fn count_completed_objectives() -> Int:
    let count = 0
    let i = 0
    while i < len(objectives):
        if objectives[i].completed:
            count = count + 1
        i = i + 1
    return count

@blueprint
fn count_incomplete_objectives() -> Int:
    let count = 0
    let i = 0
    while i < len(objectives):
        if !objectives[i].completed:
            count = count + 1
        i = i + 1
    return count

@blueprint
fn get_overall_progress() -> Float:
    if len(objectives) == 0:
        return 0.0
    
    let completed = count_completed_objectives()
    return (completed as Float) / (len(objectives) as Float) * 100.0

// ============================================================================
// QUEST NOTIFICATION WIDGET EXTENSIONS
// ============================================================================

@blueprint
fn get_notification_text() -> String:
    return notification_text

@blueprint
fn get_notification_type() -> QuestNotificationType:
    return notification_type

@blueprint
fn get_elapsed_time() -> Float:
    return elapsed_time

@blueprint
fn get_remaining_display_time() -> Float:
    return max(display_duration - elapsed_time, 0.0)

@blueprint
fn force_hide():
    hide_notification()

@blueprint
fn extend_display_time(additional_time: Float):
    display_duration = display_duration + additional_time
    println("Extended display time by {additional_time}s")

@blueprint
fn reset_notification():
    notification_text = ""
    elapsed_time = 0.0
    current_alpha = 0.0
    is_visible = false

// ============================================================================
// QUEST DETAIL WIDGET EXTENSIONS
// ============================================================================

@blueprint
fn has_quest_loaded() -> Bool:
    return quest_id != ""

@blueprint
fn get_quest_category() -> QuestCategory:
    return quest_category

@blueprint
fn get_quest_priority() -> QuestPriority:
    return quest_priority

@blueprint
fn get_lore_text() -> String:
    return lore_text

@blueprint
fn count_objectives() -> Int:
    return len(objectives)

@blueprint
fn has_lore() -> Bool:
    return lore_text != ""

// ============================================================================
// OBJECTIVE LIST WIDGET EXTENSIONS
// ============================================================================

@blueprint
fn get_completion_percentage() -> Float:
    if len(objectives) == 0:
        return 0.0
    
    let completed = get_completed_count()
    return (completed as Float) / (len(objectives) as Float) * 100.0

@blueprint
fn has_objectives() -> Bool:
    return len(objectives) > 0

@blueprint
fn all_objectives_complete() -> Bool:
    return get_completed_count() == len(objectives)

@blueprint
fn any_objectives_complete() -> Bool:
    return get_completed_count() > 0

// ============================================================================
// REWARD DISPLAY WIDGET EXTENSIONS
// ============================================================================

@blueprint
fn get_reputation_count() -> Int:
    return len(rewards.reputation_rewards)

@blueprint
fn has_xp_reward() -> Bool:
    return rewards.xp_amount > 0

@blueprint
fn has_gold_reward() -> Bool:
    return rewards.gold_amount > 0

@blueprint
fn has_item_rewards() -> Bool:
    return len(rewards.item_rewards) > 0

@blueprint
fn has_reputation_rewards() -> Bool:
    return len(rewards.reputation_rewards) > 0

@blueprint
fn get_total_reward_value() -> Float:
    let value = 0.0
    value = value + (rewards.xp_amount as Float) * 0.1
    value = value + (rewards.gold_amount as Float) * 1.0
    value = value + (len(rewards.item_rewards) as Float) * 10.0
    return value

// ============================================================================
// QUEST MAP MARKER WIDGET EXTENSIONS
// ============================================================================

@blueprint
fn update_distance_to_player(player_location: Vec3):
    let dx = marker_location.x - player_location.x
    let dy = marker_location.y - player_location.y
    let dz = marker_location.z - player_location.z
    distance_to_player = sqrt(dx * dx + dy * dy + dz * dz)

@blueprint
fn is_within_range(range: Float) -> Bool:
    return distance_to_player <= range

@blueprint
fn get_marker_type() -> QuestMarkerType:
    return marker_type

@blueprint
fn set_marker_color_rgb(r: Float, g: Float, b: Float):
    marker_color = vec3(r, g, b)

@blueprint
fn pulse_marker():
    println("Pulsing marker")
