fn print_graph_execution_path(instance: GraphInstance):
    println("=== Graph Execution Path ===")
    let i = 0
    while i < len(instance.visited_nodes):
        println("  [{i}] {instance.visited_nodes[i]}")
        i = i + 1

fn print_current_node_state(node_id: String):
    println("=== Current Node State: {node_id} ===")

fn print_active_objectives(instance: GraphInstance):
    println("=== Active Objectives ===")
    let i = 0
    while i < len(instance.objectives):
        let obj = instance.objectives[i]
        println("  [{i}] {obj.objective_id}: {obj.current_count}/{obj.target_count}")
        i = i + 1

fn print_graph_variables(instance: GraphInstance):
    println("=== Graph Variables ===")
    let i = 0
    while i < len(instance.variables):
        let var = instance.variables[i]
        println("  [{i}] {var.variable_name} = {var.string_value}")
        i = i + 1

fn get_graph_execution_statistics(instance: GraphInstance) -> String:
    let stats = "Nodes Visited: {len(instance.visited_nodes)}, "
    stats = "{stats}Objectives: {len(instance.objectives)}, "
    stats = "{stats}Variables: {len(instance.variables)}"
    return stats


