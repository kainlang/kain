@node_data
node SubQuestNodeData:
    sub_quest_name: String = ""
    sub_quest_id: String = ""
    auto_start: Bool = true
    wait_for_completion: Bool = true
    sub_quest_started: Bool = false
    sub_quest_completed: Bool = false
    
    @input_pin
    in_exec: Exec
    
    @output_pin
    on_complete: Exec
    
    @output_pin
    on_fail: Exec
    
    fn execute_node(instance: GraphInstance) -> Int:
        if !sub_quest_started:
            println("Starting sub-quest: {sub_quest_name}")
            sub_quest_started = true
            return 0
        
        if wait_for_completion:
            if sub_quest_completed:
                println("Sub-quest completed: {sub_quest_name}")
                return 0
            else:
                println("Waiting for sub-quest completion")
                return 0
        else:
            println("Sub-quest started (not waiting)")
            return 0

@node_data
node RandomBranchNodeData:
    branch_name: String = ""
    branch1_weight: Float = 1.0
    branch2_weight: Float = 1.0
    branch3_weight: Float = 1.0
    branch4_weight: Float = 1.0
    seed: Int = 0
    
    @input_pin
    in_exec: Exec
    
    @output_pin
    branch1: Exec
    
    @output_pin
    branch2: Exec
    
    @output_pin
    branch3: Exec
    
    @output_pin
    branch4: Exec
    
    fn execute_node(instance: GraphInstance) -> Int:
        let total_weight = branch1_weight + branch2_weight + branch3_weight + branch4_weight
        let random_value = 0.5
        
        if random_value < (branch1_weight / total_weight):
            println("Random branch: Branch 1")
            return 0
        else:
            if random_value < ((branch1_weight + branch2_weight) / total_weight):
                println("Random branch: Branch 2")
                return 1
            else:
                if random_value < ((branch1_weight + branch2_weight + branch3_weight) / total_weight):
                    println("Random branch: Branch 3")
                    return 2
                else:
                    println("Random branch: Branch 4")
                    return 3

@node_data
node DelayNodeData:
    delay_name: String = ""
    delay_duration: Float = 1.0
    can_skip: Bool = false
    show_timer: Bool = false
    elapsed_time: Float = 0.0
    
    @input_pin
    in_exec: Exec
    
    @output_pin
    on_complete: Exec
    
    fn execute_node(instance: GraphInstance) -> Int:
        if elapsed_time >= delay_duration:
            println("Delay complete: {delay_name}")
            return 0
        else:
            println("Delaying: {elapsed_time}/{delay_duration}")
            return 0
    
    fn update_delay(delta_time: Float):
        elapsed_time = elapsed_time + delta_time

@node_data
node LoopNodeData:
    loop_name: String = ""
    loop_count: Int = 3
    current_iteration: Int = 0
    break_on_failure: Bool = true
    
    @input_pin
    in_exec: Exec
    
    @input_pin
    loop_body: Exec
    
    @output_pin
    on_complete: Exec
    
    @output_pin
    on_iteration: Exec
    
    fn execute_node(instance: GraphInstance) -> Int:
        if current_iteration < loop_count:
            println("Loop iteration: {current_iteration}/{loop_count}")
            current_iteration = current_iteration + 1
            return 1
        else:
            println("Loop complete: {loop_name}")
            return 0

