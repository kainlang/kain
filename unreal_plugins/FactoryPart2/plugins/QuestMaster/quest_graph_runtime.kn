@node_data
node MathOperationNodeData:
    operation_name: String = ""
    operation_type: String = "Add"
    operand1: Float = 0.0
    operand2: Float = 0.0
    result_variable: String = "result"
    result: Float = 0.0
    
    @input_pin
    in_exec: Exec
    
    @output_pin
    on_complete: Exec
    
    fn execute_node(instance: GraphInstance) -> Int:
        match operation_type:
            "Add" => result = operand1 + operand2
            "Subtract" => result = operand1 - operand2
            "Multiply" => result = operand1 * operand2
            "Divide" => result = operand1 / operand2
            _ => result = 0.0
        
        println("Math operation {operation_type}: {operand1} op {operand2} = {result}")
        return 0

@node_data
node ComparisonNodeData:
    comparison_name: String = ""
    value1: Float = 0.0
    value2: Float = 0.0
    operator: ComparisonOperator = ComparisonOperator::Equal
    
    @input_pin
    in_exec: Exec
    
    @output_pin
    on_true: Exec
    
    @output_pin
    on_false: Exec
    
    fn execute_node(instance: GraphInstance) -> Int:
        let result = false
        match operator:
            ComparisonOperator::Equal => result = value1 == value2
            ComparisonOperator::NotEqual => result = value1 != value2
            ComparisonOperator::GreaterThan => result = value1 > value2
            ComparisonOperator::LessThan => result = value1 < value2
            ComparisonOperator::GreaterOrEqual => result = value1 >= value2
            ComparisonOperator::LessOrEqual => result = value1 <= value2
            _ => result = false
        
        if result:
            println("Comparison {comparison_name}: TRUE")
            return 0
        else:
            println("Comparison {comparison_name}: FALSE")
            return 1

