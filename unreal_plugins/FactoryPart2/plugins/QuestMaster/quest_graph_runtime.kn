// QuestMaster — Graph Runtime
// Phase 3: Quest execution system with 15+ NodeData classes

@graph_runtime
graph QuestSystem:
    
    // ========================================================================
    // START QUEST NODE DATA
    // ========================================================================
    
    @node_data
    node StartQuestNodeData:
        quest_id: String = ""
        quest_name: String = ""
        description: String = ""
        category: QuestCategory = QuestCategory::Side
        priority: QuestPriority = QuestPriority::Normal
        auto_start: Bool = false
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_start: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            println("Starting quest: {quest_name}")
            return 0
    
    // ========================================================================
    // OBJECTIVE NODE DATA
    // ========================================================================
    
    @node_data
    node ObjectiveNodeData:
        objective_id: String = ""
        description: String = ""
        objective_type: ObjectiveType = ObjectiveType::Interact
        target_count: Int = 1
        optional: Bool = false
        hidden: Bool = false
        current_count: Int = 0
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_complete: Exec
        
        @output_pin
        on_fail: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            if current_count >= target_count:
                println("Objective complete: {description}")
                return 0
            else:
                println("Objective in progress: {current_count}/{target_count}")
                return 1
        
        fn update_objective_count(count: Int):
            current_count = count
            if current_count >= target_count:
                println("Objective {objective_id} completed!")
    
    // ========================================================================
    // BRANCH NODE DATA
    // ========================================================================
    
    @node_data
    node BranchNodeData:
        branch_name: String = ""
        logic_operator: String = "AND"
        condition1_type: ConditionType = ConditionType::FlagSet
        condition1_target: String = ""
        condition1_value: Float = 0.0
        condition1_enabled: Bool = true
        condition2_enabled: Bool = false
        condition3_enabled: Bool = false
        condition4_enabled: Bool = false
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_true: Exec
        
        @output_pin
        on_false: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            let result = evaluate_branch_conditions()
            if result:
                println("Branch {branch_name}: TRUE")
                return 0
            else:
                println("Branch {branch_name}: FALSE")
                return 1
        
        fn evaluate_branch_conditions() -> Bool:
            let enabled_count = 0
            let passed_count = 0
            
            if condition1_enabled:
                enabled_count = enabled_count + 1
                if evaluate_single_condition(condition1_type, condition1_target, condition1_value):
                    passed_count = passed_count + 1
            
            if condition2_enabled:
                enabled_count = enabled_count + 1
            
            if condition3_enabled:
                enabled_count = enabled_count + 1
            
            if condition4_enabled:
                enabled_count = enabled_count + 1
            
            if logic_operator == "AND":
                return passed_count == enabled_count
            else:
                return passed_count > 0
        
        fn evaluate_single_condition(cond_type: ConditionType, target: String, value: Float) -> Bool:
            return true
    
    // ========================================================================
    // REWARD NODE DATA
    // ========================================================================
    
    @node_data
    node RewardNodeData:
        reward_name: String = ""
        xp_amount: Int = 0
        gold_amount: Int = 0
        item1_id: String = ""
        item1_quantity: Int = 0
        item2_id: String = ""
        item2_quantity: Int = 0
        item3_id: String = ""
        item3_quantity: Int = 0
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_complete: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            apply_rewards()
            println("Rewards applied: {xp_amount} XP, {gold_amount} Gold")
            return 0
        
        fn apply_rewards():
            if xp_amount > 0:
                give_xp("player", xp_amount)
            
            if gold_amount > 0:
                give_gold("player", gold_amount)
            
            if item1_id != "" && item1_quantity > 0:
                println("Giving item: {item1_id} x{item1_quantity}")
            
            if item2_id != "" && item2_quantity > 0:
                println("Giving item: {item2_id} x{item2_quantity}")
            
            if item3_id != "" && item3_quantity > 0:
                println("Giving item: {item3_id} x{item3_quantity}")
    
    // ========================================================================
    // COMPLETE QUEST NODE DATA
    // ========================================================================
    
    @node_data
    node CompleteQuestNodeData:
        completion_name: String = ""
        success_state: Bool = true
        trigger_event: Bool = false
        event_name: String = ""
        show_notification: Bool = true
        notification_text: String = ""
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_complete: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            println("Quest completed: {completion_name}")
            
            if trigger_event && event_name != "":
                trigger_quest_event(event_name)
            
            if show_notification:
                show_quest_notification(notification_text)
            
            return 0
        
        fn trigger_quest_event(event: String):
            println("Triggering event: {event}")
        
        fn show_quest_notification(text: String):
            println("Notification: {text}")
    
    // ========================================================================
    // FAIL QUEST NODE DATA
    // ========================================================================
    
    @node_data
    node FailQuestNodeData:
        failure_name: String = ""
        failure_reason: String = ""
        allow_retry: Bool = false
        trigger_event: Bool = false
        event_name: String = ""
        show_notification: Bool = true
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_fail: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            println("Quest failed: {failure_reason}")
            
            if trigger_event && event_name != "":
                trigger_quest_event(event_name)
            
            if show_notification:
                show_failure_notification(failure_reason)
            
            return 0
        
        fn trigger_quest_event(event: String):
            println("Triggering event: {event}")
        
        fn show_failure_notification(reason: String):
            println("Quest Failed: {reason}")
    
    // ========================================================================
    // CONDITION NODE DATA
    // ========================================================================
    
    @node_data
    node ConditionNodeData:
        condition_name: String = ""
        condition_type: ConditionType = ConditionType::FlagSet
        target: String = ""
        comparison_operator: ComparisonOperator = ComparisonOperator::Equal
        comparison_value: Float = 0.0
        invert: Bool = false
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_success: Exec
        
        @output_pin
        on_failure: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            let result = evaluate_condition_runtime()
            if result:
                println("Condition {condition_name}: SUCCESS")
                return 0
            else:
                println("Condition {condition_name}: FAILURE")
                return 1
        
        fn evaluate_condition_runtime() -> Bool:
            let context_value = get_context_value()
            let condition = QuestCondition {
                condition_type: condition_type,
                target: target,
                comparison_operator: comparison_operator,
                comparison_value: comparison_value,
                invert: invert,
                custom_data: ""
            }
            return evaluate_condition(condition, context_value)
        
        fn get_context_value() -> Float:
            return 1.0
    
    // ========================================================================
    // PARALLEL NODE DATA
    // ========================================================================
    
    @node_data
    node ParallelNodeData:
        parallel_name: String = ""
        branch1_enabled: Bool = true
        branch2_enabled: Bool = true
        branch3_enabled: Bool = false
        branch4_enabled: Bool = false
        wait_for_all: Bool = true
        timeout: Float = 0.0
        branch1_complete: Bool = false
        branch2_complete: Bool = false
        branch3_complete: Bool = false
        branch4_complete: Bool = false
        elapsed_time: Float = 0.0
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        branch1: Exec
        
        @output_pin
        branch2: Exec
        
        @output_pin
        branch3: Exec
        
        @output_pin
        branch4: Exec
        
        @output_pin
        on_complete: Exec
        
        @output_pin
        on_timeout: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            if check_parallel_completion():
                println("Parallel {parallel_name}: COMPLETE")
                return 4
            
            if timeout > 0.0 && elapsed_time >= timeout:
                println("Parallel {parallel_name}: TIMEOUT")
                return 5
            
            if branch1_enabled && !branch1_complete:
                return 0
            if branch2_enabled && !branch2_complete:
                return 1
            if branch3_enabled && !branch3_complete:
                return 2
            if branch4_enabled && !branch4_complete:
                return 3
            
            return 4
        
        fn check_parallel_completion() -> Bool:
            if wait_for_all:
                let all_complete = true
                if branch1_enabled && !branch1_complete:
                    all_complete = false
                if branch2_enabled && !branch2_complete:
                    all_complete = false
                if branch3_enabled && !branch3_complete:
                    all_complete = false
                if branch4_enabled && !branch4_complete:
                    all_complete = false
                return all_complete
            else:
                if branch1_enabled && branch1_complete:
                    return true
                if branch2_enabled && branch2_complete:
                    return true
                if branch3_enabled && branch3_complete:
                    return true
                if branch4_enabled && branch4_complete:
                    return true
                return false
        
        fn update_parallel_branch(branch_index: Int, complete: Bool):
            match branch_index:
                0 => branch1_complete = complete
                1 => branch2_complete = complete
                2 => branch3_complete = complete
                3 => branch4_complete = complete
                _ => println("Invalid branch index")
    
    // ========================================================================
    // SEQUENCE NODE DATA
    // ========================================================================
    
    @node_data
    node SequenceNodeData:
        sequence_name: String = ""
        objective1_id: String = ""
        objective2_id: String = ""
        objective3_id: String = ""
        objective4_id: String = ""
        enforce_order: Bool = true
        allow_skip: Bool = false
        current_index: Int = 0
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_complete: Exec
        
        @output_pin
        on_fail: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            if check_sequence_completion():
                println("Sequence {sequence_name}: COMPLETE")
                return 0
            else:
                println("Sequence {sequence_name}: IN PROGRESS (step {current_index})")
                return 1
        
        fn check_sequence_completion() -> Bool:
            return current_index >= 4
        
        fn advance_sequence():
            current_index = current_index + 1
            println("Sequence advanced to step {current_index}")
    
    // ========================================================================
    // TIMER NODE DATA
    // ========================================================================
    
    @node_data
    node TimerNodeData:
        timer_name: String = ""
        duration: Float = 60.0
        show_ui: Bool = true
        timer_text: String = ""
        can_pause: Bool = false
        countdown_mode: Bool = true
        elapsed: Float = 0.0
        paused: Bool = false
        warning_threshold: Float = 10.0
        warning_triggered: Bool = false
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_success: Exec
        
        @output_pin
        on_failure: Exec
        
        @output_pin
        on_warning: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            if check_timer_expiration():
                println("Timer {timer_name}: EXPIRED")
                return 1
            
            if !warning_triggered && elapsed >= (duration - warning_threshold):
                warning_triggered = true
                println("Timer {timer_name}: WARNING")
                return 2
            
            println("Timer {timer_name}: {elapsed}/{duration}")
            return 0
        
        fn update_timer(delta_time: Float):
            if !paused:
                elapsed = elapsed + delta_time
        
        fn check_timer_expiration() -> Bool:
            if countdown_mode:
                return elapsed >= duration
            return false
        
        fn get_time_remaining() -> Float:
            return max(duration - elapsed, 0.0)
    
    // ========================================================================
    // EVENT NODE DATA
    // ========================================================================
    
    @node_data
    node EventNodeData:
        event_name: String = ""
        parameter1: String = ""
        parameter2: String = ""
        parameter3: String = ""
        parameter4: String = ""
        delay: Float = 0.0
        broadcast_to_all: Bool = false
        trigger_once: Bool = true
        triggered: Bool = false
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_complete: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            if trigger_once && triggered:
                println("Event {event_name}: ALREADY TRIGGERED")
                return 0
            
            trigger_event()
            triggered = true
            println("Event {event_name}: TRIGGERED")
            return 0
        
        fn trigger_event():
            println("Triggering event: {event_name}")
            if parameter1 != "":
                println("  Param1: {parameter1}")
            if parameter2 != "":
                println("  Param2: {parameter2}")
            if parameter3 != "":
                println("  Param3: {parameter3}")
            if parameter4 != "":
                println("  Param4: {parameter4}")
    
    // ========================================================================
    // DIALOGUE NODE DATA
    // ========================================================================
    
    @node_data
    node DialogueNodeData:
        dialogue_name: String = ""
        dialogue_graph_id: String = ""
        wait_for_completion: Bool = true
        pass_quest_variables: Bool = true
        variable1_name: String = ""
        variable1_value: String = ""
        skip_if_completed: Bool = false
        dialogue_complete: Bool = false
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_complete: Exec
        
        @output_pin
        on_skip: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            if skip_if_completed && dialogue_complete:
                println("Dialogue {dialogue_name}: SKIPPED")
                return 1
            
            start_dialogue()
            
            if wait_for_completion:
                if dialogue_complete:
                    println("Dialogue {dialogue_name}: COMPLETE")
                    return 0
                else:
                    println("Dialogue {dialogue_name}: WAITING")
                    return 0
            else:
                println("Dialogue {dialogue_name}: STARTED (not waiting)")
                return 0
        
        fn start_dialogue():
            println("Starting dialogue: {dialogue_graph_id}")
            if pass_quest_variables:
                if variable1_name != "":
                    println("  Variable: {variable1_name} = {variable1_value}")
    
    // ========================================================================
    // TELEPORT NODE DATA
    // ========================================================================
    
    @node_data
    node TeleportNodeData:
        teleport_name: String = ""
        target_location_x: Float = 0.0
        target_location_y: Float = 0.0
        target_location_z: Float = 0.0
        target_rotation_pitch: Float = 0.0
        target_rotation_yaw: Float = 0.0
        target_rotation_roll: Float = 0.0
        fade_out: Bool = true
        fade_in: Bool = true
        fade_duration: Float = 1.0
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_complete: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            teleport_player()
            println("Teleport {teleport_name}: COMPLETE")
            return 0
        
        fn teleport_player():
            let location = vec3(target_location_x, target_location_y, target_location_z)
            let rotation = vec3(target_rotation_pitch, target_rotation_yaw, target_rotation_roll)
            println("Teleporting to: {location}")
    
    // ========================================================================
    // SPAWN NODE DATA
    // ========================================================================
    
    @node_data
    node SpawnNodeData:
        spawn_name: String = ""
        actor_class: String = ""
        spawn_location_x: Float = 0.0
        spawn_location_y: Float = 0.0
        spawn_location_z: Float = 0.0
        spawn_rotation_pitch: Float = 0.0
        spawn_rotation_yaw: Float = 0.0
        spawn_rotation_roll: Float = 0.0
        attach_to_player: Bool = false
        lifetime: Float = 0.0
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_spawned: Exec
        
        @output_pin
        on_failed: Exec
        
        fn execute_node(instance: GraphInstance) -> Int:
            let success = spawn_actor()
            if success:
                println("Spawn {spawn_name}: SUCCESS")
                return 0
            else:
                println("Spawn {spawn_name}: FAILED")
                return 1
        
        fn spawn_actor() -> Bool:
            if actor_class == "":
                return false
            
            let location = vec3(spawn_location_x, spawn_location_y, spawn_location_z)
            let rotation = vec3(spawn_rotation_pitch, spawn_rotation_yaw, spawn_rotation_roll)
            println("Spawning actor: {actor_class} at {location}")
            return true

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn evaluate_condition_runtime(condition_type: ConditionType, target: String, value: Float) -> Bool:
    match condition_type:
        ConditionType::FlagSet => return check_flag_set(target)
        ConditionType::ItemInInventory => return check_item_in_inventory(target, value as Int)
        ConditionType::Level => return check_player_level(value as Int)
        ConditionType::QuestComplete => return check_quest_complete(target)
        ConditionType::QuestActive => return check_quest_active(target)
        _ => return true

fn check_flag_set(flag_name: String) -> Bool:
    return true

fn check_item_in_inventory(item_id: String, quantity: Int) -> Bool:
    return true

fn check_player_level(required_level: Int) -> Bool:
    return true

fn check_quest_complete(quest_id: String) -> Bool:
    return true

fn check_quest_active(quest_id: String) -> Bool:
    return true

fn update_objective_count(objective_id: String, count: Int):
    println("Updating objective {objective_id}: count = {count}")

fn check_objective_completion(objective_id: String, current_count: Int, target_count: Int) -> Bool:
    return current_count >= target_count

fn check_timer_expiration(elapsed: Float, duration: Float) -> Bool:
    return elapsed >= duration

fn get_current_time() -> Float:
    return 0.0

fn get_delta_time() -> Float:
    return 0.016


// ============================================================================
// ADDITIONAL NODE DATA CLASSES
// ============================================================================

@node_data
node CommentNodeData:
    comment_text: String = ""
    comment_color_r: Float = 1.0
    comment_color_g: Float = 1.0
    comment_color_b: Float = 0.5
    
    fn execute_node(instance: GraphInstance) -> Int:
        println("Comment: {comment_text}")
        return 0

// ============================================================================
// GRAPH INSTANCE MANAGEMENT
// ============================================================================

fn create_graph_instance(instance_id: Int, quest_id: String) -> GraphInstance:
    println("Creating graph instance {instance_id} for quest {quest_id}")
    return GraphInstance {
        instance_id: instance_id,
        quest_id: quest_id,
        state: QuestState::Inactive,
        objectives: [],
        variables: [],
        start_time: 0.0,
        completion_time: 0.0,
        tracked: false,
        player_id: "",
        current_node_id: "",
        visited_nodes: []
    }

fn update_graph_instance(instance: GraphInstance, delta_time: Float):
    println("Updating graph instance {instance.instance_id}")

fn reset_graph_instance(instance: GraphInstance):
    instance.current_node_id = ""
    instance.visited_nodes = []
    println("Reset graph instance {instance.instance_id}")

fn validate_graph_instance(instance: GraphInstance) -> Bool:
    if instance.instance_id < 0:
        println("Error: Invalid instance ID")
        return false
    
    if instance.quest_id == "":
        println("Error: Quest ID cannot be empty")
        return false
    
    return true

// ============================================================================
// NODE EXECUTION HELPERS
// ============================================================================

fn execute_node_by_id(node_id: String, instance: GraphInstance) -> Int:
    println("Executing node: {node_id}")
    return 0

fn get_next_node_id(current_node_id: String, output_pin: Int) -> String:
    return ""

fn mark_node_visited(instance: GraphInstance, node_id: String):
    push(instance.visited_nodes, node_id)
    println("Marked node {node_id} as visited")

fn has_visited_node(instance: GraphInstance, node_id: String) -> Bool:
    let i = 0
    while i < len(instance.visited_nodes):
        if instance.visited_nodes[i] == node_id:
            return true
        i = i + 1
    return false

fn count_visited_nodes(instance: GraphInstance) -> Int:
    return len(instance.visited_nodes)

fn clear_visited_nodes(instance: GraphInstance):
    instance.visited_nodes = []
    println("Cleared visited nodes")

