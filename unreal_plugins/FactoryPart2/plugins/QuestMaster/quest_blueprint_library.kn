// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

@blueprint
fn get_current_game_time() -> Float:
    return 0.0

@blueprint
fn format_duration(seconds: Float) -> String:
    let minutes = (seconds / 60.0) as Int
    let secs = (seconds as Int) % 60
    return "{minutes}m {secs}s"

@blueprint
fn format_percentage(value: Float) -> String:
    return "{value}%"

@blueprint
fn clamp_progress(progress: Float) -> Float:
    if progress < 0.0:
        return 0.0
    if progress > 100.0:
        return 100.0
    return progress

@blueprint
fn is_valid_quest_id(quest_id: String) -> Bool:
    return quest_id != ""

@blueprint
fn is_valid_objective_id(objective_id: String) -> Bool:
    return objective_id != ""

@blueprint
fn is_valid_player_id(player_id: String) -> Bool:
    return player_id != ""

@blueprint
fn generate_quest_instance_id() -> Int:
    return 0

@blueprint
fn log_quest_event(event_type: String, quest_id: String, details: String):
    println("[QuestEvent] {event_type}: {quest_id} - {details}")

@blueprint
fn log_objective_event(event_type: String, objective_id: String, details: String):
    println("[ObjectiveEvent] {event_type}: {objective_id} - {details}")
