// ============================================================================
// SUBSYSTEM ACCESS
// ============================================================================

@blueprint
fn get_quest_subsystem() -> String:
    println("Getting quest subsystem")
    return "QuestManagerSubsystem"

// ============================================================================
// QUEST MANAGEMENT
// ============================================================================

@blueprint
fn start_quest_from_subsystem(quest_id: String, player_id: String) -> Int:
    println("Blueprint: Starting quest {quest_id} for player {player_id}")
    return 1

@blueprint
fn complete_quest_from_subsystem(quest_id: String) -> Bool:
    println("Blueprint: Completing quest {quest_id}")
    return true

@blueprint
fn fail_quest_from_subsystem(quest_id: String, reason: String) -> Bool:
    println("Blueprint: Failing quest {quest_id} - {reason}")
    return true

@blueprint
