    @node_data
    node DeadEndRoomNodeData:
        RoomWidth: Int = 6
        RoomHeight: Int = 6
        EnemyCount: Int = 3
        HasLoot: Bool = true
        LootQuality: Float = 0.3
        Atmosphere: String = "Creepy"
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_generated: Exec
        
        fn execute_node(instance: GraphInstance) -> Bool:
            let position = instance.find_valid_room_position(RoomWidth, RoomHeight)
            
            let room_bounds = RoomBounds {
                min_x: position.x,
