// DungeonArchitect — Graph Runtime
// NodeData + GraphInstance for runtime dungeon generation

@graph_runtime
graph DungeonGraphRuntime:
    @node_data
    node EntranceRoomNodeData:
        RoomWidth: Int = 10
        RoomHeight: Int = 10
        SpawnPointCount: Int = 1
        AllowMultipleExits: Bool = true
        LightingPreset: String = "Bright"
        AmbientSound: String = "Amb_Entrance"
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_generated: Exec
        @output_pin
        north_exit: Exec
        @output_pin
        south_exit: Exec
        @output_pin
        east_exit: Exec
        @output_pin
        west_exit: Exec
        
        fn execute_node(instance: GraphInstance) -> Bool:
            let room_bounds = RoomBounds {
                min_x: 0,
                min_y: 0,
                max_x: RoomWidth,
                max_y: RoomHeight,
                width: RoomWidth,
                height: RoomHeight
            }
            
            let room = GeneratedRoom {
                id: 0,
                room_type: RoomType::Entrance,
                bounds: room_bounds,
                world_position: vec3(0.0, 0.0, 0.0),
                connections: [],
                connection_points: [],
                is_generated: true,
                is_populated: false,
                actor_reference: null,
                distance_from_entrance: 0,
                visited: false
            }
            
            instance.add_room(room)
            instance.set_entrance_room(0)
            
            return true
    
    @node_data
    node CorridorNodeData:
        CorridorWidth: Int = 3
        MinLength: Int = 5
        MaxLength: Int = 15
        AllowBends: Bool = true
        MaxBends: Int = 2
        PlaceTorches: Bool = true
        TorchSpacing: Float = 5.0
        
        @input_pin
        in_exec: Exec
        @input_pin
        start_point: Exec
        
        @output_pin
        on_generated: Exec
        @output_pin
        end_point: Exec
        
        fn execute_node(instance: GraphInstance) -> Bool:
            let start_room_id = instance.get_last_room_id()
            let start_room = instance.get_room(start_room_id)
            
            let start_center = bounds_get_center(start_room.bounds)
            let length = MinLength + (instance.get_random_int() % (MaxLength - MinLength + 1))
            
            let direction = instance.get_random_int() % 4
            let mut end_x = start_center.x
            let mut end_y = start_center.y
            
            match direction:
                0 => end_y = end_y + length
                1 => end_y = end_y - length
                2 => end_x = end_x + length
                3 => end_x = end_x - length
                _ => end_x = end_x + length
            
            let corridor = CorridorSegment {
                start_pos: start_center,
                end_pos: Vec2i { x: end_x, y: end_y },
                width: CorridorWidth,
                connects_rooms: [start_room_id]
            }
            
            instance.add_corridor(corridor)
            
            return true
    
    @node_data
    node TreasureRoomNodeData:
        RoomWidth: Int = 8
        RoomHeight: Int = 8
        ChestCount: Int = 1
        LootQuality: Float = 0.8
        GuardianCount: Int = 2
        RequiresKey: Bool = false
        KeyID: Int = 0
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        on_generated: Exec
        @output_pin
        on_looted: Exec
        @output_pin
        exit: Exec
        
        fn execute_node(instance: GraphInstance) -> Bool:
            let position = instance.find_valid_room_position(RoomWidth, RoomHeight)
            
            let room_bounds = RoomBounds {
                min_x: position.x,
                min_y: position.y,
                max_x: position.x + RoomWidth,
                max_y: position.y + RoomHeight,
                width: RoomWidth,
                height: RoomHeight
            }
            
            let room_id = instance.get_next_room_id()
            let room = GeneratedRoom {
                id: room_id,
                room_type: RoomType::Treasure,
                bounds: room_bounds,
                world_position: vec3((position.x * 100) as Float, (position.y * 100) as Float, 0.0),
                connections: [],
                connection_points: [],
                is_generated: true,
                is_populated: false,
                actor_reference: null,
                distance_from_entrance: instance.calculate_distance_from_entrance(room_id),
                visited: false
            }
            
            instance.add_room(room)
            instance.mark_as_treasure_room(room_id)
            
            return true
    
