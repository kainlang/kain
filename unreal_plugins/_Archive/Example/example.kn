# ============================================================================
# SECTION 1: ENUMS - Type-safe constants
# ============================================================================

enum CustomGameMode:
    Sandbox
    Campaign
    Multiplayer
    Tutorial

enum ItemRarity:
    Common
    Uncommon
    Rare
    Epic
    Legendary
    Mythic

enum QuestStatus:
    NotStarted
    InProgress
    Completed
    Failed

enum NetworkSyncMode:
    Interpolated
    Extrapolated
    Compressed

# ============================================================================
# SECTION 2: DATATABLES - CSV-importable data
# ============================================================================

@datatable
@datatable
struct ItemData:
    id: Int
    name: String
    description: String
    rarity: ItemRarity
    value: Int
    weight: Float
    max_stack: Int
    icon_path: String

@datatable
struct QuestData:
    id: Int
    name: String
    description: String
    reward_exp: Int
    reward_gold: Int
    required_level: Int

# ============================================================================
# SECTION 3: COMPONENTS - Reusable actor components
# ============================================================================

@component
struct InventoryComponent:
    items: Array<Int>
    capacity: Int
    
    @savegame
    gold: Int
    
    @transient
    is_locked: Bool

@component
struct PhysicsComponent:
    velocity: Vec3
    acceleration: Vec3
    mass: Float
    drag: Float

# ============================================================================
# SECTION 4: SUBSYSTEMS - World-level systems (NEW 2026)
# ============================================================================

@subsystem
@tick
struct GameStateSubsystem:
    current_mode: CustomGameMode
    player_count: Int
    match_time: Float
    is_paused: Bool
    
    fn on_tick(delta: Float):
        if !is_paused:
            match_time = match_time + delta
    
    fn start_match(mode: CustomGameMode):
        current_mode = mode
        match_time = 0.0
        is_paused = false
    
    fn pause_match():
        is_paused = true
    
    fn resume_match():
        is_paused = false

@subsystem
struct QuestSubsystem:
    active_quests: Array<Int>
    completed_quests: Array<Int>
    quest_progress: Array<Int>
    
    fn start_quest(quest_id: Int) -> Bool:
        active_quests.push(quest_id)
        return true
    
    fn complete_quest(quest_id: Int):
        completed_quests.push(quest_id)
    
    fn is_quest_active(quest_id: Int) -> Bool:
        var i: Int = 0
        while i < active_quests.length():
            if active_quests[i] == quest_id:
                return true
            i = i + 1
        return false

# ============================================================================
# SECTION 5: GRAPH RUNTIME - Runtime graph execution (NEW 2026)
# ============================================================================

@graph_runtime
struct CombatGraph:
    @node_data
    struct RootNode:
        @property
        graph_name: String
        
        @output_pin
        start: Exec
    
    @node_data
    struct AttackNode:
        @property
        damage: Float
        
        @property
        attack_type: String
        
        @input_pin
        execute: Exec
        
        @output_pin
        success: Exec
        
        @output_pin
        failure: Exec
    
    @node_data
    struct DefendNode:
        @property
        defense_multiplier: Float
        
        @input_pin
        execute: Exec
        
        @output_pin
        blocked: Exec
        
        @output_pin
        damaged: Exec
    
    @node_data
    struct BranchNode:
        @property
        condition_tag: String
        
        @input_pin
        execute: Exec
        
        @output_pin
        true_branch: Exec
        
        @output_pin
        false_branch: Exec
    
    @instance
    struct CombatInstance:
        current_node_id: Int
        execution_history: Array<Int>
        combat_state: String
        
        fn start_combat() -> Bool:
            current_node_id = 0
            execution_history = []
            combat_state = "active"
            return true
        
        fn advance_to_node(node_id: Int):
            current_node_id = node_id
            execution_history.push(node_id)
        
        fn evaluate_condition(tag: String) -> Bool:
            return tag == "always_true"

@graph_runtime
struct DialogueGraph:
    @node_data
    struct DialogueNode:
        @property
        speaker_name: String
        
        @property
        dialogue_text: String
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        next: Exec
        
        @output_pin
        choice_1: Exec
        
        @output_pin
        choice_2: Exec
    
    @node_data
    struct ChoiceNode:
        @property
        choice_text: String
        
        @input_pin
        in_exec: Exec
        
        @output_pin
        selected: Exec
    
    @instance
    struct DialogueInstance:
        current_node_id: Int
        dialogue_history: Array<Int>
        
        fn start_dialogue() -> Bool:
            current_node_id = 0
            return true
        
        fn select_choice(choice_index: Int):
            dialogue_history.push(choice_index)

# ============================================================================
# SECTION 6: COMPUTE SHADERS - GPU-accelerated processing
# ============================================================================

shader compute ParticlePhysics(thread_id: Vec3) -> Unit:
    # Permutation flags
    uniform CFG_HIGH_QUALITY: Float @0
    uniform CFG_ENABLE_COLLISIONS: Float @1
    uniform ENABLE_GRAVITY: Float @2
    
    # Parameters
    uniform delta_time: Float @3
    uniform gravity_strength: Float @4
    uniform particle_count: Int @5
    uniform particle_positions: RWBuffer<Vec4> @6
    uniform particle_velocities: RWBuffer<Vec4> @7
    
    let idx = thread_id.x
    
    if idx >= particle_count:
        return
    
    var pos = particle_positions[idx]
    var vel = particle_velocities[idx]
    
    if ENABLE_GRAVITY:
        vel.y = vel.y - gravity_strength * delta_time
    
    if CFG_HIGH_QUALITY:
        pos = pos + vel * delta_time + vec4(0, -0.5 * gravity_strength * delta_time * delta_time, 0, 0)
    else:
        pos = pos + vel * delta_time
    
    if CFG_ENABLE_COLLISIONS:
        if pos.y < 0.0:
            pos.y = 0.0
            vel.y = -vel.y * 0.8
    
    particle_positions[idx] = pos
    particle_velocities[idx] = vel

shader compute DataProcessor(thread_id: Vec3) -> Unit:
    uniform input_data: RWBuffer<Float> @0
    uniform output_data: RWBuffer<Float> @1
    uniform data_count: Int @2
    uniform processing_factor: Float @3
    
    let idx = thread_id.x
    
    if idx >= data_count:
        return
    
    let input_value = input_data[idx]
    let processed_value = input_value * processing_factor
    output_data[idx] = processed_value

# ============================================================================
# SECTION 7: MATERIAL GRAPHS - PBR materials
# ============================================================================

@material_graph(blend_mode = Opaque, shading_model = DefaultLit)
material MetallicSurface:
    input base_color: Vec3 = vec3(0.8, 0.8, 0.8)
    input tint_color: Vec3 = vec3(1.0, 0.5, 0.0)
    input tint_strength: Float = 0.3
    input metallic: Float = 0.9
    input roughness: Float = 0.4
    input emissive_intensity: Float = 0.0
    
    let tinted = multiply(multiply(base_color, tint_color), tint_strength)
    let final_color = add(base_color, tinted)
    let emissive = multiply(tint_color, emissive_intensity)
    
    output base_color = final_color
    output metallic = metallic
    output roughness = roughness
    output emissive = emissive

@material_graph(blend_mode = Translucent, shading_model = DefaultLit)
material HologramEffect:
    input holo_color: Vec3 = vec3(0.0, 1.0, 1.0)
    input scan_line_intensity: Float = 0.3
    input base_opacity: Float = 0.5
    input fresnel_power: Float = 2.0
    input rim_intensity: Float = 2.0
    
    let fresnel_value = fresnel(fresnel_power, constant_float(0.1))
    let rim_effect = multiply(multiply(holo_color, fresnel_value), rim_intensity)
    
    output base_color = holo_color
    output emissive = rim_effect
    output opacity = base_opacity

# ============================================================================
# SECTION 8: ACTORS - Networked gameplay entities
# ============================================================================

# Actor with @dispatch for automatic RDG shader dispatch (NEW 2026)
@dispatch("ParticlePhysics")
actor ParticleSimulator:
    @replicated
    state particle_count: Int = 1000
    
    @replicated
    state is_simulating: Bool = false
    
    @replicated
    state gravity_strength: Float = 9.8
    
    state last_dispatch_time: Float = 0.0
    state rotation_speed: Float = 30.0
    state spawn_height: Float = 100.0
    
    on BeginPlay():
        println("ParticleSimulator initialized with {particle_count} particles")
        
        # Use actor stdlib functions for initialization
        let spawn_location = vec3(0.0, 0.0, spawn_height)
        SetActorLocation(spawn_location)
        
        let initial_rotation = rotator(0.0, 0.0, 0.0)
        SetActorRotation(initial_rotation)
        
        let scale = vec3(1.0, 1.0, 1.0)
        SetActorScale(scale)
        
        # Add actor tag for identification
        AddActorTag("ParticleSystem")
        AddActorTag("Simulation")
    
    on Tick(delta_time: Float):
        # Shader dispatch happens automatically via @dispatch attribute
        if is_simulating:
            last_dispatch_time = last_dispatch_time + delta_time
            
            # Use actor stdlib functions for runtime updates
            let rotation_delta = rotator(0.0, rotation_speed * delta_time, 0.0)
            AddActorWorldRotation(rotation_delta)
            
            # Get current transform info
            let current_location = GetActorLocation()
            let current_rotation = GetActorRotation()
            let forward_vector = GetActorForwardVector()
            let velocity = GetVelocity()
    
    on Server_StartSimulation():
        is_simulating = true
        
        # Use actor stdlib functions
        SetActorHiddenInGame(false)
        SetActorEnableCollision(true)
        
        Multicast_NotifySimulationStarted()
    
    on Server_StopSimulation():
        is_simulating = false
        
        # Use actor stdlib functions
        SetActorHiddenInGame(true)
        SetActorEnableCollision(false)
        
        Multicast_NotifySimulationStopped()
    
    on Multicast_NotifySimulationStarted():
        println("Simulation started")
    
    on Multicast_NotifySimulationStopped():
        println("Simulation stopped")
    
    @blueprint_callable
    fn GetParticleCount() -> Int:
        return particle_count
    
    @blueprint_pure
    fn IsSimulating() -> Bool:
        return is_simulating
    
    @blueprint_callable
    fn TeleportToLocation(location: Vec3, rotation: Rotator) -> Bool:
        # Use actor stdlib teleport function
        return TeleportTo(location, rotation)
    
    @blueprint_callable
    fn GetSimulatorBounds() -> Vec3:
        # Use actor stdlib bounds function
        return GetActorBounds()
    
    @blueprint_callable
    fn GetDistanceToTarget(target: Actor) -> Float:
        # Use actor stdlib distance function
        return GetDistanceTo(target)
    
    @blueprint_callable
    fn AttachToTarget(target: Actor):
        # Use actor stdlib attachment function
        AttachToActor(target)
    
    @blueprint_callable
    fn DetachFromTarget():
        # Use actor stdlib detachment function
        DetachFromActor()

# Actor with @blueprint_event for Blueprint-extensible events (NEW 2026)
actor GameManager:
    @replicated
    state player_count: Int = 0
    
    @replicated
    state match_score: Int = 0
    
    @savegame
    state player_level: Int = 1
    
    state combat_graph: CombatGraph = CombatGraph()
    state dialogue_graph: DialogueGraph = DialogueGraph()
    state manager_lifetime: Float = 0.0
    
    on BeginPlay():
        println("GameManager initialized")
        
        # Use actor stdlib functions for initialization
        let spawn_location = vec3(0.0, 0.0, 0.0)
        SetActorLocation(spawn_location)
        
        # Set lifetime for auto-cleanup (0 = infinite)
        SetLifeSpan(0.0)
        
        # Add manager tags
        AddActorTag("GameManager")
        AddActorTag("Persistent")
        
        on_game_started()
    
    on Tick(delta_time: Float):
        manager_lifetime = manager_lifetime + delta_time
        
        # Use actor stdlib functions
        let current_location = GetActorLocation()
        let forward = GetActorForwardVector()
        let right = GetActorRightVector()
        let up = GetActorUpVector()
    
    @blueprint_event
    fn on_game_started():
        println("Game started - Blueprint can override this")
    
    @blueprint_event
    fn on_player_joined(player_name: String):
        println("Player joined: {player_name}")
        player_count = player_count + 1
    
    @blueprint_event
    fn on_player_left(player_name: String):
        println("Player left: {player_name}")
        player_count = player_count - 1
    
    @blueprint_event
    fn on_match_completed(winner: String, final_score: Int):
        println("Match completed! Winner: {winner}, Score: {final_score}")
        match_score = final_score
    
    on Server_RegisterPlayer(player_name: String):
        player_count = player_count + 1
        on_player_joined(player_name)
        Multicast_UpdatePlayerCount(player_count)
    
    on Multicast_UpdatePlayerCount(count: Int):
        println("Total players: {count}")
    
    @blueprint_callable
    fn GetPlayerCount() -> Int:
        return player_count
    
    @blueprint_callable
    fn StartCombat() -> Bool:
        return combat_graph.start_combat()
    
    @blueprint_callable
    fn StartDialogue() -> Bool:
        return dialogue_graph.start_dialogue()
    
    @blueprint_callable
    fn MoveManagerToLocation(location: Vec3):
        # Use actor stdlib movement function
        SetActorLocation(location)
    
    @blueprint_callable
    fn RotateManager(rotation: Rotator):
        # Use actor stdlib rotation function
        SetActorRotation(rotation)
    
    @blueprint_callable
    fn GetManagerTransform() -> Transform:
        # Use actor stdlib transform function
        return GetActorTransform()
    
    @blueprint_callable
    fn SetManagerTransform(location: Vec3, rotation: Rotator, scale: Vec3):
        # Use actor stdlib transform function
        SetActorTransform(location, rotation, scale)
    
    @blueprint_callable
    fn HasManagerTag(tag: String) -> Bool:
        # Use actor stdlib tag function
        return ActorHasTag(tag)
    
    @blueprint_callable
    fn GetManagerLifetime() -> Float:
        return manager_lifetime
    
    @blueprint_callable
    fn DestroyManager():
        # Use actor stdlib destroy function
        DestroyActor()

# Simple actor without shaders (no RDG boilerplate)
actor ItemPickup:
    @replicated
    state item_id: Int = 0
    
    @replicated
    state rarity: ItemRarity = ItemRarity::Common
    
    state is_collected: Bool = false
    state spawn_time: Float = 0.0
    state hover_height: Float = 50.0
    state hover_speed: Float = 2.0
    
    on BeginPlay():
        println("ItemPickup spawned: Item {item_id}")
        
        # Use actor stdlib functions for initialization
        let spawn_location = vec3(0.0, 0.0, hover_height)
        SetActorLocation(spawn_location)
        
        # Enable collision for pickup
        SetActorEnableCollision(true)
        SetActorHiddenInGame(false)
        
        # Add item tags
        AddActorTag("Item")
        AddActorTag("Pickup")
        
        # Set lifetime for auto-despawn (300 seconds = 5 minutes)
        SetLifeSpan(300.0)
    
    on Tick(delta_time: Float):
        spawn_time = spawn_time + delta_time
        
        if !is_collected:
            # Use actor stdlib functions for hover animation
            let current_location = GetActorLocation()
            let hover_offset = vec3(0.0, 0.0, sin(spawn_time * hover_speed) * 10.0)
            AddActorWorldOffset(hover_offset * delta_time)
            
            # Rotate item for visual effect
            let rotation_delta = rotator(0.0, 45.0 * delta_time, 0.0)
            AddActorWorldRotation(rotation_delta)
    
    on Server_Collect(player: Actor):
        if !is_collected:
            is_collected = true
            
            # Use actor stdlib functions
            SetActorHiddenInGame(true)
            SetActorEnableCollision(false)
            
            # Get distance to player
            let distance = GetDistanceTo(player)
            println("Item collected from distance: {distance}")
            
            Multicast_PlayCollectEffect()
            
            # Destroy after short delay
            SetLifeSpan(1.0)
    
    on Multicast_PlayCollectEffect():
        println("Item collected!")
    
    @blueprint_callable
    fn GetItemRarity() -> ItemRarity:
        return rarity
    
    @blueprint_callable
    fn GetItemLocation() -> Vec3:
        # Use actor stdlib location function
        return GetActorLocation()
    
    @blueprint_callable
    fn GetItemRotation() -> Rotator:
        # Use actor stdlib rotation function
        return GetActorRotation()
    
    @blueprint_callable
    fn GetItemForwardVector() -> Vec3:
        # Use actor stdlib direction function
        return GetActorForwardVector()
    
    @blueprint_callable
    fn GetRemainingLifetime() -> Float:
        # Use actor stdlib lifetime function
        return GetLifeSpan()
    
    @blueprint_callable
    fn IsItemBeingDestroyed() -> Bool:
        # Use actor stdlib destruction check
        return IsActorBeingDestroyed()
    
    @blueprint_callable
    fn TeleportItemTo(location: Vec3, rotation: Rotator) -> Bool:
        # Use actor stdlib teleport function
        return TeleportTo(location, rotation)
    
    @blueprint_callable
    fn GetItemBounds() -> Vec3:
        # Use actor stdlib bounds function
        return GetActorBounds()
    
    @blueprint_callable
    fn SetItemScale(scale: Vec3):
        # Use actor stdlib scale function
        SetActorScale(scale)
    
    @blueprint_callable
    fn GetItemScale() -> Vec3:
        # Use actor stdlib scale function
        return GetActorScale()

