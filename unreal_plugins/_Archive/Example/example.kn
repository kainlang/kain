@blueprint
fn RandomInRange(min_val: Float, max_val: Float) -> Float:
    # Use utilities stdlib function
    return random_range(min_val, max_val)

@blueprint
fn FormatVectorString(v: Vec3) -> String:
    # Use utilities stdlib function
    return format_vector(v)

@blueprint
fn ClampVectorMagnitude(v: Vec3, max_length: Float) -> Vec3:
    # Use utilities stdlib function
    return clamp_vector(v, max_length)

# Materials Functions (materials.kn)
@blueprint
fn CreateDynamicMaterial(base_material: String) -> Material:
    # Use materials stdlib function
    return CreateDynamicMaterialInstance(base_material)

@blueprint
fn SetMaterialColor(material: Material, param_name: String, color: Vec3):
    # Use materials stdlib function
    SetVectorParameterValue(material, param_name, color)

@blueprint
fn SetMaterialScalar(material: Material, param_name: String, value: Float):
    # Use materials stdlib function
    SetScalarParameterValue(material, param_name, value)

# Particles Functions (particles.kn)
@blueprint
fn SetParticleFloat(particle_system: NiagaraComponent, param_name: String, value: Float):
    # Use particles stdlib function
    SetNiagaraVariableFloat(particle_system, param_name, value)

@blueprint
fn SetParticleVector(particle_system: NiagaraComponent, param_name: String, value: Vec3):
    # Use particles stdlib function
    SetNiagaraVariableVec3(particle_system, param_name, value)

@blueprint
fn ResetParticleSystem(particle_system: NiagaraComponent):
    # Use particles stdlib function
    ResetNiagaraSystem(particle_system)

# Skeletal Mesh Functions (skeletal_mesh.kn)
@blueprint
fn PlayCharacterAnimation(skeletal_mesh: SkeletalMeshComponent, anim_name: String) -> Float:
    # Use skeletal_mesh stdlib function
    return PlayAnimMontage(skeletal_mesh, anim_name)

@blueprint
fn StopCharacterAnimation(skeletal_mesh: SkeletalMeshComponent):
    # Use skeletal_mesh stdlib function
    StopAnimMontage(skeletal_mesh)

@blueprint
fn SetBonePosition(skeletal_mesh: SkeletalMeshComponent, bone_name: String, location: Vec3):
    # Use skeletal_mesh stdlib function
    SetBoneLocationByName(skeletal_mesh, bone_name, location)

# ============================================================================
# SECTION 10: SLATE UI - Custom editor widgets
# ============================================================================

@slate
struct GameDashboard:
    @property
    player_count: Int
    
    @property
    match_score: Int
    
    @property
    match_time: Float
    
    fn construct() -> Widget:
        let vbox = VerticalBox()
        
        let header = TextBlock()
        header.Text("Game Dashboard")
        vbox.Add(header)
        
        let stats_box = HorizontalBox()
        
        let players_text = TextBlock()
        players_text.Text("Players: {player_count}")
        stats_box.Add(players_text)
        
        let score_text = TextBlock()
        score_text.Text("Score: {match_score}")
        stats_box.Add(score_text)
        
        let time_text = TextBlock()
        time_text.Text("Time: {match_time}")
        stats_box.Add(time_text)
        
        vbox.Add(stats_box)
        
        return vbox

@slate
struct ParticleWidget:
    @property
    particle_count: Int
    
    @property
    is_simulating: Bool
    
    fn construct() -> Widget:
        let vbox = VerticalBox()
        
        let title = TextBlock()
        title.Text("Particle Simulation")
        vbox.Add(title)
        
        let count_text = TextBlock()
        count_text.Text("Particles: {particle_count}")
        vbox.Add(count_text)
        
        let status_text = TextBlock()
        if is_simulating:
            status_text.Text("Status: Running")
        else:
            status_text.Text("Status: Stopped")
        vbox.Add(status_text)
        
        return vbox

# ============================================================================
# SECTION 11: DETAILS PANEL - Custom property editor
# ============================================================================

@details
struct GameManagerDetails:
    @category("Game State")
    @slider(min: 0, max: 100)
    player_count: Int
    
    @category("Game State")
    match_score: Int
    
    @category("Game State")
    @slider(min: 1, max: 100)
    player_level: Int
    
    @category("Visual")
    @color_picker
    team_color: Vec3
    
    @category("Visual")
    @slider(min: 0.0, max: 5.0)
    glow_intensity: Float
    
    @category("Actions")
    @button(label: "Start Match")
    fn on_start_match():
        println("Starting match...")
    
    @category("Actions")
    @button(label: "Reset Game")
    fn on_reset_game():
        println("Resetting game...")
    
    @category("Debug")
    @button(label: "Spawn Test Particles")
    fn on_spawn_particles():
        println("Spawning particles...")

# ============================================================================
# SECTION 12: VIEWPORT - 3D preview
# ============================================================================

@viewport
struct GamePreviewViewport:
    @scene_actor
    game_mesh: StaticMeshComponent
    
    @camera
    preview_camera: CameraComponent
    
    fn on_viewport_tick(delta: Float):
        game_mesh.AddLocalRotation(vec3(0, delta * 30.0, 0))

# ============================================================================
# SECTION 13: TOOLBAR - Editor toolbar
# ============================================================================

@toolbar
struct GameTools:
    @button(icon: "Icons.Play", tooltip: "Start Game", shortcut: "Ctrl+G")
    fn on_start_game():
        println("Starting game...")
    
    @button(icon: "Icons.Stop", tooltip: "Stop Game")
    fn on_stop_game():
        println("Stopping game...")
    
    @toggle(label: "Show Debug", default: true)
    fn on_toggle_debug(enabled: Bool):
        println("Debug visibility: {enabled}")
    
    @toggle(label: "Show Particles")
    fn on_toggle_particles(enabled: Bool):
        println("Particle visibility: {enabled}")
    
    @separator
    
    @dropdown(label: "Quality", options: ["Low", "Medium", "High", "Ultra"])
    fn on_quality_changed(value: String):
        println("Quality: {value}")
    
    @button(icon: "Icons.Simulate", tooltip: "Simulate Physics")
    fn on_simulate():
        println("Simulating...")

# ============================================================================
# SECTION 14: ASSET EDITOR - Complete editor
# ============================================================================

@asset_editor
struct GameAssetEditor:
    @viewport
    preview: GamePreviewViewport
    
    @details
    properties: GameManagerDetails
    
    @toolbar
    tools: GameTools
    
    @slate
    dashboard: GameDashboard
    
    fn on_asset_opened(asset: GameAsset):
        preview.game_mesh.SetStaticMesh(asset.mesh)
        properties.player_count = 0
        properties.match_score = 0
        dashboard.player_count = 0
        dashboard.match_score = 0
        dashboard.match_time = 0.0
        println("Game asset editor opened")
    
    fn on_asset_saved():
        println("Game asset saved")

# ============================================================================
# SECTION 15: EDITOR MODULE - Menu/toolbar integration (NEW 2026)
# ============================================================================

@editor_module
struct GameEditorModule:
    @menu_entry(path: "Tools/Game", label: "Open Game Dashboard")
    fn on_open_dashboard():
        println("Opening game dashboard...")
    
    @menu_entry(path: "Tools/Game", label: "Create New Game")
    fn on_create_game():
        println("Creating new game...")
    
    @menu_entry(path: "Tools/Game", label: "Import Game Data")
    fn on_import_data():
        println("Importing game data from CSV...")
    
    @menu_entry(path: "Tools/Game", label: "Start Particle Simulation")
    fn on_start_simulation():
        println("Starting particle simulation...")
    
    @toolbar_button(section: "Content", icon: "Icons.Game", tooltip: "Quick Create Game")
    fn on_quick_create():
        println("Quick creating game...")
    
    @toolbar_button(section: "Content", icon: "Icons.Settings", tooltip: "Game Settings")
    fn on_settings():
        println("Opening game settings...")
    
    @toolbar_button(section: "Content", icon: "Icons.Graph", tooltip: "Open Combat Graph")
    fn on_open_combat_graph():
        println("Opening combat graph editor...")

