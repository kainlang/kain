@blueprint
fn CalculateDamage(base: Float, multiplier: Float, armor: Float) -> Float:
    # Use gameplay stdlib function for damage calculation
    let raw = base * multiplier
    return calculate_armor_mitigation(raw, armor)

@blueprint
fn CalculateCriticalDamage(base: Float, multiplier: Float, armor: Float, crit_chance: Float, crit_multiplier: Float) -> Float:
    # Use gameplay stdlib functions for crit calculation
    let base_damage = CalculateDamage(base, multiplier, armor)
    if should_crit(crit_chance):
        return calculate_crit_damage(base_damage, crit_multiplier)
    return base_damage

@blueprint
fn ApplyDamageToHealth(current_health: Float, max_health: Float, damage: Float, armor: Float) -> Float:
    # Use gameplay stdlib function for health damage
    return apply_damage(current_health, max_health, damage, armor)

@blueprint
fn HealCharacter(current_health: Float, max_health: Float, heal_amount: Float) -> Float:
    # Use gameplay stdlib function for healing
    return apply_healing(current_health, max_health, heal_amount)

@blueprint
fn IsCharacterLowHealth(current_health: Float, max_health: Float, threshold: Float) -> Bool:
    # Use gameplay stdlib function for health check
    return is_low_health(current_health, max_health, threshold)

@blueprint
fn GetHealthPercentage(current_health: Float, max_health: Float) -> Float:
    # Use gameplay stdlib function for health percentage
    return get_health_percentage(current_health, max_health)

@blueprint
fn AddExperiencePoints(current_xp: Int, xp_to_add: Int, current_level: Int) -> Int:
    # Use gameplay stdlib function for XP addition
    return add_experience(current_xp, xp_to_add, current_level)

@blueprint
fn GetExperienceProgress(current_xp: Int, current_level: Int) -> Float:
    # Use gameplay stdlib function for XP progress
    return get_xp_progress(current_xp, current_level)

@blueprint
fn CalculateExperienceForLevel(level: Int) -> Int:
    # Use gameplay stdlib function for XP calculation
    return calculate_experience_for_level(level)

@blueprint
fn IsCooldownReady(last_use_time: Float, cooldown_duration: Float, current_time: Float) -> Bool:
    # Use gameplay stdlib function for cooldown check
    return is_cooldown_ready(last_use_time, cooldown_duration, current_time)

@blueprint
fn GetCooldownRemaining(last_use_time: Float, cooldown_duration: Float, current_time: Float) -> Float:
    # Use gameplay stdlib function for cooldown remaining
    return get_cooldown_remaining(last_use_time, cooldown_duration, current_time)

@blueprint
fn RollLootDrop(drop_chance: Float) -> Bool:
    # Use gameplay stdlib function for loot roll
    return roll_loot_drop(drop_chance)

@blueprint
fn DetermineLootRarity(luck_stat: Float) -> LootRarity:
    # Use gameplay stdlib function for loot rarity
    return determine_loot_rarity(luck_stat)

@blueprint
fn UpdateQuestObjective(current_progress: Int, increment: Int, required_progress: Int) -> Int:
    # Use gameplay stdlib function for quest progress
    return update_quest_objective(current_progress, increment, required_progress)

@blueprint
fn IsQuestObjectiveComplete(current_progress: Int, required_progress: Int) -> Bool:
    # Use gameplay stdlib function for quest completion check
    return is_quest_objective_complete(current_progress, required_progress)

@blueprint
fn GetRarityColor(rarity: ItemRarity) -> Vec3:
    match rarity:
        ItemRarity::Common => vec3(1.0, 1.0, 1.0)
        ItemRarity::Uncommon => vec3(0.0, 1.0, 0.0)
        ItemRarity::Rare => vec3(0.0, 0.5, 1.0)
        ItemRarity::Epic => vec3(0.6, 0.0, 1.0)
        ItemRarity::Legendary => vec3(1.0, 0.5, 0.0)
        ItemRarity::Mythic => vec3(1.0, 0.0, 1.0)
        _ => vec3(0.5, 0.5, 0.5)

@blueprint_pure
fn CanAffordItem(gold: Int, item_cost: Int) -> Bool:
    return gold >= item_cost

@blueprint
fn FormatItemName(item_name: String, rarity: ItemRarity) -> String:
    match rarity:
        ItemRarity::Legendary => "[LEGENDARY] {item_name}"
        ItemRarity::Epic => "[EPIC] {item_name}"
        ItemRarity::Rare => "[RARE] {item_name}"
        _ => item_name

@blueprint
fn StartQuestById(subsystem: QuestSubsystem, quest_id: Int) -> Bool:
    return subsystem.start_quest(quest_id)

@blueprint
fn IsQuestActive(subsystem: QuestSubsystem, quest_id: Int) -> Bool:
    return subsystem.is_quest_active(quest_id)

