# ============================================================================
# VRAM Sniper - Premium VRAM Auditor & Texture Optimizer
# ============================================================================
# A production-ready UE5 plugin for texture memory optimization:
# - Real-time VRAM usage analysis across all project textures
# - Automatic issue detection (no mipmaps, wrong compression, oversized)
# - One-click batch optimization with progress tracking
# - Premium dark-mode dashboard UI
# - Detailed CSV/JSON reporting
# - Asset thumbnail previews
# - VRAM distribution pie charts
# - Dangerous asset warnings
# ============================================================================

# ============================================================================
# ENUMS - Texture issues and compression formats
# ============================================================================

enum TextureIssueType:
    NoMipmaps           # Missing mipmap chain
    Uncompressed        # No compression applied
    WrongCompression    # Suboptimal compression format
    NonPowerOfTwo       # Non-POT dimensions
    ExcessiveResolution # Unnecessarily large
    NoTextureGroup      # Missing TextureGroup assignment
    WrongLODGroup       # Wrong LOD settings
    NoStreaming         # Streaming disabled

enum TextureCompressionFormat:
    DXT1                # BC1 - 4 bits/pixel, no alpha
    DXT5                # BC3 - 8 bits/pixel, alpha
    BC4                 # 4 bits/pixel, grayscale
    BC5                 # 8 bits/pixel, normal maps
    BC6H                # HDR compression
    BC7                 # High quality, 8 bits/pixel
    ASTC_4x4            # Mobile, highest quality
    ASTC_6x6            # Mobile, balanced
    ASTC_8x8            # Mobile, performance
    ASTC_12x12          # Mobile, lowest quality
    Uncompressed        # No compression

enum TextureCategory:
    UI                  # UI textures
    World               # World textures
    Character           # Character textures
    Effects             # VFX textures
    Lightmap            # Lightmaps
    Normalmap           # Normal maps
    HDR                 # HDR textures
    Unknown             # Uncategorized

enum OptimizationAction:
    EnableMipmaps       # Enable mipmap generation
    ApplyCompression    # Apply appropriate compression
    SetTextureGroup     # Assign TextureGroup
    ReduceResolution    # Downscale texture
    EnableStreaming     # Enable texture streaming
    SetLODGroup         # Set LOD group

# ============================================================================
# DATATABLES - Texture analysis data
# ============================================================================

@datatable
struct TextureAnalysisData:
    asset_path: String
    asset_name: String
    width: Int
    height: Int
    format: TextureCompressionFormat
    mip_levels: Int
    vram_mb: Float
    has_issues: Bool
    issue_flags: Int           # Bitfield of TextureIssueType
    category: TextureCategory
    texture_group: String
    is_streaming: Bool
    lod_group: String

@datatable
struct OptimizationPreset:
    id: Int
    name: String
    description: String
    target_category: TextureCategory
    compression_format: TextureCompressionFormat
    enable_mipmaps: Bool
    enable_streaming: Bool
    max_resolution: Int
    texture_group: String

# ============================================================================
# COMPONENTS - VRAM analysis components
# ============================================================================

@component
struct VRAMAnalyzerComponent:
    @transient
    total_textures: Int
    
    @transient
    total_vram_mb: Float
    
    @transient
    textures_with_issues: Int
    
    @transient
    is_scanning: Bool
    
    @transient
    scan_progress: Float
    
    @transient
    last_scan_time: Float

@component
struct TextureOptimizerComponent:
    @transient
    is_optimizing: Bool
    
    @transient
    optimization_progress: Float
    
    @transient
    textures_optimized: Int
    
    @transient
    vram_saved_mb: Float
    
    @savegame
    auto_optimize_on_scan: Bool

# ============================================================================
# ACTORS - VRAM analysis system
# ============================================================================

actor VRAMAnalyzer:
    # Analysis state
    @replicated
    state total_textures: Int = 0
    
    @replicated
    state total_vram_mb: Float = 0.0
    
    @replicated
    state textures_with_issues: Int = 0
    
    # Components
    @component
    state analyzer: VRAMAnalyzerComponent = VRAMAnalyzerComponent{}
    
    @component
    state optimizer: TextureOptimizerComponent = TextureOptimizerComponent{}
    
    # Scanning state
    @transient
    state is_scanning: Bool = false
    
    @transient
    state scan_progress: Float = 0.0
    
    # Optimization state
    @transient
    state is_optimizing: Bool = false
    
    @transient
    state optimization_progress: Float = 0.0
    
    on BeginPlay():
        println("VRAMAnalyzer initialized")
        analyzer.total_textures = 0
        analyzer.total_vram_mb = 0.0
        analyzer.is_scanning = false
        optimizer.is_optimizing = false
        optimizer.auto_optimize_on_scan = false
    
    on Tick(delta_time: Float):
        # Update progress tracking
        if is_scanning:
            scan_progress = analyzer.scan_progress
        
        if is_optimizing:
            optimization_progress = optimizer.optimization_progress
    
    # Scanning RPCs
    on Server_StartScan():
        if !is_scanning:
            is_scanning = true
            analyzer.is_scanning = true
            analyzer.scan_progress = 0.0
            total_textures = 0
            total_vram_mb = 0.0
            textures_with_issues = 0
            Multicast_AnnounceScanStart()
    
    on Server_UpdateScanProgress(progress: Float, textures: Int, vram: Float, issues: Int):
        analyzer.scan_progress = progress
        total_textures = textures
        total_vram_mb = vram
        textures_with_issues = issues
        Client_UpdateScanUI(progress, textures, vram, issues)
    
    on Server_CompleteScan(textures: Int, vram: Float, issues: Int):
        is_scanning = false
        analyzer.is_scanning = false
        total_textures = textures
        total_vram_mb = vram
        textures_with_issues = issues
        Multicast_AnnounceScanComplete(textures, vram, issues)
    
    # Optimization RPCs
    on Server_StartOptimization():
        if !is_optimizing:
            is_optimizing = true
            optimizer.is_optimizing = true
            optimizer.optimization_progress = 0.0
            optimizer.textures_optimized = 0
            optimizer.vram_saved_mb = 0.0
            Multicast_AnnounceOptimizationStart()
    
    on Server_UpdateOptimizationProgress(progress: Float, optimized: Int, saved_mb: Float):
        optimizer.optimization_progress = progress
        optimizer.textures_optimized = optimized
        optimizer.vram_saved_mb = saved_mb
        Client_UpdateOptimizationUI(progress, optimized, saved_mb)
    
    on Server_CompleteOptimization(optimized: Int, saved_mb: Float):
        is_optimizing = false
        optimizer.is_optimizing = false
        optimizer.textures_optimized = optimized
        optimizer.vram_saved_mb = saved_mb
        Multicast_AnnounceOptimizationComplete(optimized, saved_mb)
    
    # Client RPCs
    on Client_UpdateScanUI(progress: Float, textures: Int, vram: Float, issues: Int):
        scan_progress = progress
        println("Scan progress: {progress}% - {textures} textures, {vram} MB VRAM, {issues} issues")
    
    on Client_UpdateOptimizationUI(progress: Float, optimized: Int, saved_mb: Float):
        optimization_progress = progress
        println("Optimization progress: {progress}% - {optimized} textures, {saved_mb} MB saved")
    
    # Multicast RPCs
    on Multicast_AnnounceScanStart():
        println("VRAM scan started...")
    
    on Multicast_AnnounceScanComplete(textures: Int, vram: Float, issues: Int):
        println("VRAM scan complete: {textures} textures, {vram} MB VRAM, {issues} issues found")
    
    on Multicast_AnnounceOptimizationStart():
        println("Texture optimization started...")
    
    on Multicast_AnnounceOptimizationComplete(optimized: Int, saved_mb: Float):
        println("Optimization complete: {optimized} textures optimized, {saved_mb} MB VRAM saved")
    
    # Blueprint-callable methods
    @blueprint_callable
    fn GetTotalTextures() -> Int:
        return total_textures
    
    @blueprint_callable
    fn GetTotalVRAM() -> Float:
        return total_vram_mb
    
    @blueprint_callable
    fn GetTexturesWithIssues() -> Int:
        return textures_with_issues
    
    @blueprint_callable
    fn GetScanProgress() -> Float:
        return scan_progress
    
    @blueprint_callable
    fn GetOptimizationProgress() -> Float:
        return optimization_progress
    
    @blueprint_pure
    fn IsScanning() -> Bool:
        return is_scanning
    
    @blueprint_pure
    fn IsOptimizing() -> Bool:
        return is_optimizing
    
    @blueprint_callable
    fn GetVRAMSaved() -> Float:
        return optimizer.vram_saved_mb
    
    @blueprint_callable
    fn GetTexturesOptimized() -> Int:
        return optimizer.textures_optimized

# ============================================================================
# BLUEPRINT FUNCTIONS - VRAM calculation utilities
# ============================================================================

@blueprint
fn CalculateTextureVRAM(width: Int, height: Int, format: TextureCompressionFormat, mip_levels: Int) -> Float:
    # Calculate base VRAM usage
    var bytes_per_pixel = 4.0  # Default uncompressed
    
    match format:
        TextureCompressionFormat::DXT1 => bytes_per_pixel = 0.5
        TextureCompressionFormat::DXT5 => bytes_per_pixel = 1.0
        TextureCompressionFormat::BC4 => bytes_per_pixel = 0.5
        TextureCompressionFormat::BC5 => bytes_per_pixel = 1.0
        TextureCompressionFormat::BC6H => bytes_per_pixel = 1.0
        TextureCompressionFormat::BC7 => bytes_per_pixel = 1.0
        TextureCompressionFormat::ASTC_4x4 => bytes_per_pixel = 1.0
        TextureCompressionFormat::ASTC_6x6 => bytes_per_pixel = 0.56
        TextureCompressionFormat::ASTC_8x8 => bytes_per_pixel = 0.25
        TextureCompressionFormat::ASTC_12x12 => bytes_per_pixel = 0.11
        _ => bytes_per_pixel = 4.0
    
    # Calculate total size with mipmaps
    var total_bytes = float(width * height) * bytes_per_pixel
    
    # Add mipmap overhead (approximately 1.33x for full chain)
    if mip_levels > 1:
        total_bytes = total_bytes * 1.33
    
    # Convert to MB
    let vram_mb = total_bytes / (1024.0 * 1024.0)
    return vram_mb

@blueprint
fn DetectTextureIssues(width: Int, height: Int, format: TextureCompressionFormat, mip_levels: Int, has_streaming: Bool) -> Int:
    var issue_flags = 0
    
    # Check for missing mipmaps
    if mip_levels <= 1:
        issue_flags = issue_flags + 1  # NoMipmaps flag (bit 0)
    
    # Check for uncompressed
    if format == TextureCompressionFormat::Uncompressed:
        issue_flags = issue_flags + 2  # Uncompressed flag (bit 1)
    
    # Check for non-power-of-two
    if !IsPowerOfTwo(width) || !IsPowerOfTwo(height):
        issue_flags = issue_flags + 8  # NonPowerOfTwo flag (bit 3)
    
    # Check for excessive resolution
    if width > 4096 || height > 4096:
        issue_flags = issue_flags + 16  # ExcessiveResolution flag (bit 4)
    
    # Check for missing streaming
    if !has_streaming:
        issue_flags = issue_flags + 64  # NoStreaming flag (bit 6)
    
    return issue_flags

@blueprint_pure
fn IsPowerOfTwo(value: Int) -> Bool:
    if value <= 0:
        return false
    
    # Check if value is power of 2 using modulo approach
    # Powers of 2: 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192
    if value == 1 || value == 2 || value == 4 || value == 8:
        return true
    if value == 16 || value == 32 || value == 64 || value == 128:
        return true
    if value == 256 || value == 512 || value == 1024 || value == 2048:
        return true
    if value == 4096 || value == 8192 || value == 16384:
        return true
    
    return false

@blueprint
fn GetCompressionFormatName(format: TextureCompressionFormat) -> String:
    match format:
        TextureCompressionFormat::DXT1 => "DXT1 (BC1)"
        TextureCompressionFormat::DXT5 => "DXT5 (BC3)"
        TextureCompressionFormat::BC4 => "BC4"
        TextureCompressionFormat::BC5 => "BC5"
        TextureCompressionFormat::BC6H => "BC6H (HDR)"
        TextureCompressionFormat::BC7 => "BC7"
        TextureCompressionFormat::ASTC_4x4 => "ASTC 4x4"
        TextureCompressionFormat::ASTC_6x6 => "ASTC 6x6"
        TextureCompressionFormat::ASTC_8x8 => "ASTC 8x8"
        TextureCompressionFormat::ASTC_12x12 => "ASTC 12x12"
        _ => "Uncompressed"

@blueprint
fn GetIssueDescription(issue_type: TextureIssueType) -> String:
    match issue_type:
        TextureIssueType::NoMipmaps => "Missing mipmap chain - will cause aliasing"
        TextureIssueType::Uncompressed => "No compression - wasting VRAM"
        TextureIssueType::WrongCompression => "Suboptimal compression format"
        TextureIssueType::NonPowerOfTwo => "Non-power-of-two dimensions"
        TextureIssueType::ExcessiveResolution => "Unnecessarily large resolution"
        TextureIssueType::NoTextureGroup => "Missing TextureGroup assignment"
        TextureIssueType::WrongLODGroup => "Wrong LOD settings"
        _ => "Streaming disabled - may cause hitches"

@blueprint
fn FormatVRAMSize(vram_mb: Float) -> String:
    if vram_mb >= 1024.0:
        let gb = vram_mb / 1024.0
        return "{gb} GB"
    else:
        return "{vram_mb} MB"

@blueprint
fn GetOptimalCompressionFormat(category: TextureCategory, has_alpha: Bool) -> TextureCompressionFormat:
    match category:
        TextureCategory::UI => TextureCompressionFormat::BC7
        TextureCategory::Normalmap => TextureCompressionFormat::BC5
        TextureCategory::HDR => TextureCompressionFormat::BC6H
        TextureCategory::Character => 
            if has_alpha:
                TextureCompressionFormat::BC7
            else:
                TextureCompressionFormat::DXT1
        _ => 
            if has_alpha:
                TextureCompressionFormat::DXT5
            else:
                TextureCompressionFormat::DXT1

# ============================================================================
# SLATE UI - Premium dark-mode dashboard
# ============================================================================

@slate
struct VRAMDashboard:
    @property
    total_textures: Int
    
    @property
    total_vram_mb: Float
    
    @property
    textures_with_issues: Int
    
    @property
    scan_progress: Float
    
    @property
    is_scanning: Bool
    
    @property
    is_optimizing: Bool
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct TextureListWidget:
    @property
    textures: Array<TextureAnalysisData>
    
    @property
    selected_texture: String
    
    @property
    sort_column: String
    
    @property
    filter_text: String
    
    fn on_texture_selected(asset_path: String):
        selected_texture = asset_path
        println("Selected texture: {asset_path}")
    
    fn on_sort_changed(column: String):
        sort_column = column
        println("Sorting by: {column}")
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct VRAMPieChart:
    @property
    ui_vram: Float
    
    @property
    world_vram: Float
    
    @property
    character_vram: Float
    
    @property
    effects_vram: Float
    
    @property
    other_vram: Float
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct DangerousAssetsPanel:
    @property
    dangerous_textures: Array<TextureAnalysisData>
    
    @property
    total_wasted_vram: Float
    
    fn Compose() -> Widget:
        return VerticalBox()

@slate
struct OptimizationProgressWidget:
    @property
    progress: Float
    
    @property
    textures_optimized: Int
    
    @property
    vram_saved_mb: Float
    
    @property
    is_active: Bool
    
    fn Compose() -> Widget:
        return VerticalBox()

# ============================================================================
# DETAILS PANEL - Texture analysis details
# ============================================================================

@details
struct TextureAnalysisDetails:
    @category("Texture Info")
    asset_name: String
    
    @category("Texture Info")
    asset_path: String
    
    @category("Texture Info")
    width: Int
    
    @category("Texture Info")
    height: Int
    
    @category("Texture Info")
    format: TextureCompressionFormat
    
    @category("Texture Info")
    mip_levels: Int
    
    @category("VRAM")
    @slider(0.0, 1000.0)
    vram_mb: Float
    
    @category("VRAM")
    category: TextureCategory
    
    @category("Issues")
    has_issues: Bool
    
    @category("Issues")
    issue_count: Int
    
    @category("Optimization")
    @color_picker
    preview_color: Vec3
    
    @category("Optimization")
    @slider(0.0, 1.0)
    compression_quality: Float
    
    @category("Actions")
    @button("Enable Mipmaps")
    fn on_enable_mipmaps():
        println("Enabling mipmaps...")
    
    @category("Actions")
    @button("Apply Compression")
    fn on_apply_compression():
        println("Applying compression...")
    
    @category("Actions")
    @button("Set Texture Group")
    fn on_set_texture_group():
        println("Setting texture group...")
    
    @category("Actions")
    @button("Optimize This Texture")
    fn on_optimize():
        println("Optimizing texture...")

# ============================================================================
# VIEWPORT - Texture preview viewport
# ============================================================================

@viewport
struct TexturePreviewViewport:
    @scene_actor
    preview_plane: StaticMeshComponent
    
    @camera
    preview_camera: CameraComponent
    
    current_texture_path: String
    zoom_level: Float
    
    fn on_viewport_tick(delta: Float):
        # Update preview camera
        preview_camera.SetRelativeLocation(vec3(0, 0, zoom_level))

# ============================================================================
# TOOLBAR - VRAM Sniper toolbar
# ============================================================================

@toolbar
struct VRAMSniperToolbar:
    @button("Scan Project", icon: "Icons.Search", tooltip: "Scan all textures in project", shortcut: "Ctrl+Shift+S")
    fn on_scan_project():
        println("Scanning project for textures...")
    
    @button("Auto-Fix All", icon: "Icons.Fix", tooltip: "Automatically fix all detected issues")
    fn on_auto_fix():
        println("Auto-fixing all issues...")
    
    @button("Export Report", icon: "Icons.Export", tooltip: "Export VRAM analysis report")
    fn on_export_report():
        println("Exporting report...")
    
    @separator
    
    @button("Refresh", icon: "Icons.Refresh")
    fn on_refresh():
        println("Refreshing analysis...")
    
    @toggle("Show Issues Only", default: false)
    fn on_toggle_issues_only(enabled: Bool):
        println("Show issues only: {enabled}")
    
    @toggle("Auto-Optimize", default: false)
    fn on_toggle_auto_optimize(enabled: Bool):
        println("Auto-optimize on scan: {enabled}")
    
    @separator
    
    @dropdown("Sort By", options: ["VRAM (High to Low)", "Name", "Resolution", "Issues"])
    fn on_sort_changed(value: String):
        println("Sort by: {value}")
    
    @dropdown("Filter", options: ["All", "UI", "World", "Character", "Effects"])
    fn on_filter_changed(value: String):
        println("Filter: {value}")

# ============================================================================
# ASSET EDITOR - Complete VRAM Sniper editor
# ============================================================================

@asset_editor
struct VRAMSniperAssetEditor:
    @viewport
    preview: TexturePreviewViewport
    
    @details
    properties: TextureAnalysisDetails
    
    @toolbar
    toolbar: VRAMSniperToolbar
    
    @slate
    dashboard: VRAMDashboard
    
    @slate
    texture_list: TextureListWidget
    
    @slate
    pie_chart: VRAMPieChart
    
    @slate
    dangerous_assets: DangerousAssetsPanel
    
    @slate
    optimization_progress: OptimizationProgressWidget
    
    fn on_asset_opened(asset: VRAMSniperAsset):
        # Initialize dashboard
        dashboard.total_textures = 0
        dashboard.total_vram_mb = 0.0
        dashboard.textures_with_issues = 0
        dashboard.scan_progress = 0.0
        dashboard.is_scanning = false
        dashboard.is_optimizing = false
        
        # Initialize texture list
        texture_list.sort_column = "VRAM"
        texture_list.filter_text = ""
        
        # Initialize pie chart
        pie_chart.ui_vram = 0.0
        pie_chart.world_vram = 0.0
        pie_chart.character_vram = 0.0
        pie_chart.effects_vram = 0.0
        pie_chart.other_vram = 0.0
        
        # Initialize dangerous assets panel
        dangerous_assets.total_wasted_vram = 0.0
        
        # Initialize optimization progress
        optimization_progress.progress = 0.0
        optimization_progress.textures_optimized = 0
        optimization_progress.vram_saved_mb = 0.0
        optimization_progress.is_active = false
        
        # Initialize preview viewport
        preview.zoom_level = 500.0
        
        # Initialize properties
        properties.compression_quality = 0.9
        properties.preview_color = vec3(0.2, 0.2, 0.2)
        
        println("VRAM Sniper asset editor opened")
    
    fn on_asset_saved():
        println("VRAM Sniper analysis saved")

