// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
int particle_count;
HeightmapParams params;
TerrainPhysicsParams physics;
float adhesion_strength;

// UAV Outputs
RWStructuredBuffer<float4> particle_positions : register(u2);
RWStructuredBuffer<float4> particle_velocities : register(u3);
RWStructuredBuffer<float> heightmap : register(u5);

[numthreads(8, 8, 1)]
void ParticleTerrainInteractionCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= particle_count))
    {
        return;
    }
    RWStructuredBuffer<float4> pos_full = particle_positions[idx];
    RWStructuredBuffer<float4> vel_full = particle_velocities[idx];
    int grid_x = int((pos_full.x / params.cell_size.x));
    int grid_y = int((pos_full.y / params.cell_size.y));
    if (((((grid_x < 0) || (grid_x >= params.resolution.x)) || (grid_y < 0)) || (grid_y >= params.resolution.y)))
    {
        return;
    }
    int heightmap_idx = (grid_x + (grid_y * params.resolution.x));
    RWStructuredBuffer<float> terrain_height = heightmap[heightmap_idx];
    RWStructuredBuffer<float4> new_pos = pos_full;
    RWStructuredBuffer<float4> new_vel = vel_full;
    if ((pos_full.z < terrain_height))
    {
        new_pos = float4(pos_full.x, pos_full.y, terrain_height, pos_full.w);
        new_vel = float4(vel_full.x, vel_full.y, ((-vel_full.z) * physics.friction), vel_full.w);
        #ifdef ENABLE_ADHESION
        float adhesion_force = (adhesion_strength * physics.cohesion);
        float damping = (1.000000 - (adhesion_force * physics.time_step));
        new_vel = float4((new_vel.x * damping), (new_vel.y * damping), (new_vel.z * damping), new_vel.w);
        float speed_sq = (((new_vel.x * new_vel.x) + (new_vel.y * new_vel.y)) + (new_vel.z * new_vel.z));
        if ((speed_sq < 0.010000))
        {
            new_vel = float4(0, 0, 0, 1.000000);
        }
        #endif
    }
    particle_positions[idx] = new_pos;
    particle_velocities[idx] = new_vel;
}
