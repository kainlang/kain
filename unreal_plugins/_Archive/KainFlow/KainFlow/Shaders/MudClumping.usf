// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
int particle_count;
float clumping_threshold;
float adhesion_strength;
TerrainPhysicsParams physics;

// UAV Outputs
RWStructuredBuffer<float4> particle_positions : register(u1);
RWStructuredBuffer<float4> particle_velocities : register(u2);

[numthreads(8, 8, 1)]
void MudClumpingCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= particle_count))
    {
        return;
    }
    RWStructuredBuffer<float4> pos_full = particle_positions[idx];
    RWStructuredBuffer<float4> vel_full = particle_velocities[idx];
    float is_stuck = vel_full.w;
    if ((is_stuck > 0.500000))
    {
        return;
    }
    #ifdef CFG_ENABLE_CLUMPING
    float damping = (1.000000 - (adhesion_strength * physics.time_step));
    float4 new_vel = float4((vel_full.x * damping), (vel_full.y * damping), (vel_full.z * damping), vel_full.w);
    particle_velocities[idx] = new_vel;
    float speed_sq = (((new_vel.x * new_vel.x) + (new_vel.y * new_vel.y)) + (new_vel.z * new_vel.z));
    if ((speed_sq < (clumping_threshold * clumping_threshold)))
    {
        particle_velocities[idx] = float4(0, 0, 0, 1.000000);
    }
    #endif
}
