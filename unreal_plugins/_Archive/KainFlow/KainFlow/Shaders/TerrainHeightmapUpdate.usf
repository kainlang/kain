// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
HeightmapParams params;
TerrainPhysicsParams physics;

// UAV Outputs
RWStructuredBuffer<float> heightmap : register(u2);
RWStructuredBuffer<float4> velocity_field : register(u3);

[numthreads(8, 8, 1)]
void TerrainHeightmapUpdateCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = (ThreadId.x + (ThreadId.y * params.resolution.x));
    float3 res = params.resolution;
    if (((ThreadId.x >= res.x) || (ThreadId.y >= res.y)))
    {
        return;
    }
    RWStructuredBuffer<float> height = heightmap[idx];
    RWStructuredBuffer<float4> velocity_vec = velocity_field[idx];
    height = (height + (velocity_vec.z * physics.time_step));
    #ifdef ENABLE_EROSION
    float idx_left = (max((ThreadId.x - 1), 0) + (ThreadId.y * res.x));
    float idx_right = (min((ThreadId.x + 1), (res.x - 1)) + (ThreadId.y * res.x));
    float idx_down = (ThreadId.x + (max((ThreadId.y - 1), 0) * res.x));
    float idx_up = (ThreadId.x + (min((ThreadId.y + 1), (res.y - 1)) * res.x));
    RWStructuredBuffer<float> h_left = heightmap[idx_left];
    RWStructuredBuffer<float> h_right = heightmap[idx_right];
    RWStructuredBuffer<float> h_down = heightmap[idx_down];
    RWStructuredBuffer<float> h_up = heightmap[idx_up];
    RWStructuredBuffer<float> flow_left = (max((height - h_left), 0.000000) * 0.010000);
    RWStructuredBuffer<float> flow_right = (max((height - h_right), 0.000000) * 0.010000);
    RWStructuredBuffer<float> flow_down = (max((height - h_down), 0.000000) * 0.010000);
    RWStructuredBuffer<float> flow_up = (max((height - h_up), 0.000000) * 0.010000);
    RWStructuredBuffer<float> total_flow = (((flow_left + flow_right) + flow_down) + flow_up);
    height = (height - (total_flow * physics.time_step));
    #endif
    height = clamp(height, (-params.displacement_scale), params.displacement_scale);
    heightmap[idx] = height;
}
