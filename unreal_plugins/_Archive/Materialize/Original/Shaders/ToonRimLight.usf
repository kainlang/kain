// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
float3 rim_color;
float rim_power;
float rim_intensity;
float rim_threshold;
float rim_smoothness;

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
    float4 TexCoord1 : TEXCOORD1;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput ToonRimLightPS(FPSInput Input)
{
    // Unpack interpolators
    float3 normal = Input.TexCoord0.xyz;
    float3 view_dir = Input.TexCoord1.xyz;

    float3 n = normalize(normal);
    float3 v = normalize(view_dir);
    float ndv = max(0.000000, dot(n, v));
    float rim_raw = pow((1.000000 - ndv), max(rim_power, 0.001000));
    float rim_lo = (rim_threshold - rim_smoothness);
    float rim_hi = (rim_threshold + rim_smoothness);
    float rim = (smoothstep(rim_lo, rim_hi, rim_raw) * rim_intensity);
    float3 color = (rim_color * rim);
    FPSOutput _Result;
    _Result.Color = float4(color, 1.000000);
    return _Result;
}
