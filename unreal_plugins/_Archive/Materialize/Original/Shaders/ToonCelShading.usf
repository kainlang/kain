    float3 view_dir = Input.TexCoord2.xyz;
    float3 albedo = Input.TexCoord3.xyz;

    float3 n = normalize(normal);
    float3 l = normalize(light_dir);
    float ndl_raw = dot(n, l);
    float wrapped = (((ndl_raw + wrap_amount)) / ((1.000000 + wrap_amount)));
    float ndl = max(0.000000, min(wrapped, 1.000000));
    float safe_bands = max(band_count, 2.000000);
    float band_value = (floor((ndl * safe_bands)) / safe_bands);
