// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
float band_count;
float band_smoothness;
float custom_bands;

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
    float4 TexCoord1 : TEXCOORD1;
    float4 TexCoord2 : TEXCOORD2;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput ToonConfigurableBandsPS(FPSInput Input)
{
    // Unpack interpolators
    float ndl = Input.TexCoord0.x;
    float4 band_positions = Input.TexCoord1.xyzw;
    float4 band_colors = Input.TexCoord2.xyzw;

    if ((custom_bands > 0.500000))
    {
        float3 color = float3(0.000000, 0.000000, 0.000000);
        if ((ndl < band_positions.x))
        {
            color = float3(band_colors.x, band_colors.x, band_colors.x);
        }
        if (((ndl >= band_positions.x) && (ndl < band_positions.y)))
        {
            float t = (((ndl - band_positions.x)) / ((band_positions.y - band_positions.x)));
            color = lerp(band_colors.xxx, band_colors.yyy, smoothstep(0.000000, 1.000000, t));
        }
        if ((ndl >= band_positions.y))
        {
            float t = (((ndl - band_positions.y)) / ((1.000000 - band_positions.y)));
            color = lerp(band_colors.yyy, band_colors.zzz, smoothstep(0.000000, 1.000000, t));
        }
        FPSOutput _Result;
        _Result.Color = float4(color, 1.000000);
        return _Result;
    }
    float safe_bands = max(band_count, 2.000000);
    float band = (floor((ndl * safe_bands)) / safe_bands);
    float smooth_band = smoothstep((band - band_smoothness), (band + band_smoothness), ndl);
    FPSOutput _Result;
    _Result.Color = float4(smooth_band, smooth_band, smooth_band, 1.000000);
    return _Result;
}
