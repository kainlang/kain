// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float delta_time;  // @0
int particle_count;  // @1
int force_count;  // @2
int collision_enabled;  // @3
float3 heightmap_scale;  // @4
float bounce_factor;  // @5
float friction;  // @6
int kill_on_collision;  // @7
StructuredBuffer<ParticleForce> force_buffer;  // @9
float time;  // @13

// Texture Inputs
Texture2D heightmap : register(t12);  // @12 -> t12 register
SamplerState heightmapSampler : register(s12);

// UAV Outputs
RWBuffer particle_buffer : register(u8);  // @8 -> u8 register
RWBuffer dead_list : register(u10);  // @10 -> u10 register
RWBuffer dead_count : register(u11);  // @11 -> u11 register

[numthreads(8, 8, 1)]
void ParticleUpdateCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float particle_id = ThreadId.x;
    if ((particle_id >= particle_count))
    {
        return;
    }
    RWBuffer p = particle_buffer[particle_id];
    if ((p.age >= p.lifetime))
    {
        RWBuffer dead_idx = dead_count[0];
        dead_list[dead_idx] = particle_id;
        dead_count[0] = (dead_idx + 1);
        return;
    }
    p.age = (p.age + delta_time);
    float3 total_force = float3(0.000000, 0.000000, 0.000000);
    int force_idx = 0;
    while ((force_idx < force_count))
    {
        StructuredBuffer<ParticleForce> force = force_buffer[force_idx];
        float4 applied_force = calculate_force(p, force, time);
        total_force = (total_force + applied_force);
        force_idx = (force_idx + 1);
    }
    p.acceleration = (total_force / p.mass);
    p.velocity = (p.velocity + (p.acceleration * delta_time));
    p.position = (p.position + (p.velocity * delta_time));
    p.rotation = (p.rotation + (p.angular_velocity * delta_time));
    if ((collision_enabled > 0))
    {
        float2 uv = float2((((p.position.x / heightmap_scale.x)) + 0.500000), (((p.position.y / heightmap_scale.y)) + 0.500000));
        if (((((uv.x >= 0.000000) && (uv.x <= 1.000000)) && (uv.y >= 0.000000)) && (uv.y <= 1.000000)))
        {
            float height = (heightmap.Load(TexCoord).r * heightmap_scale.z);
            if ((p.position.z <= height))
            {
                if ((kill_on_collision > 0))
                {
                    p.age = p.lifetime;
                }
                else
                {
                    p.position.z = height;
                    p.velocity.z = (p.velocity.z * (-bounce_factor));
                    p.velocity.x = (p.velocity.x * ((1.000000 - friction)));
                    p.velocity.y = (p.velocity.y * ((1.000000 - friction)));
                }
            }
        }
    }
    particle_buffer[particle_id] = p;
}
