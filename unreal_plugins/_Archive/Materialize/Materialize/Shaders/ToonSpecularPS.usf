{
    float4 Color : SV_Target0;
};

FPSOutput ToonSpecularPSPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float3 n = normalize(normal);
    float3 v = normalize(view_dir);
    float3 l = normalize(light_dir);
    float3 h = normalize((l + v));
    float ndh = max(0.000000, dot(n, h));
    float spec_threshold = (1.000000 - specular_size);
    float spec_raw = ((ndh > spec_threshold) ? 1.000000 : 0.000000);
    float spec_smooth = smoothstep((spec_threshold - specular_smoothness), (spec_threshold + specular_smoothness), ndh);
    float specular = (spec_smooth * specular_intensity);
    FPSOutput _Result;
    _Result.Color = float4(float3(specular, specular, specular), 1.000000);
    return _Result;
}
