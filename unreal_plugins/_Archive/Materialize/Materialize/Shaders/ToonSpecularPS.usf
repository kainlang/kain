// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float specular_size;  // @0
float specular_smoothness;  // @1
float specular_intensity;  // @2
float3 normal;  // @3
float3 view_dir;  // @4
float3 light_dir;  // @5

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

