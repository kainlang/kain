// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
uint2 TextureSize;  // @1
uint ConversionType;  // @2

// Texture Inputs
Texture2D<float4> InputTexture : register(t0);  // @0 -> t0 register
SamplerState InputTextureSampler : register(s0);

// UAV Outputs
RWTexture2D OutputTexture : register(u3);  // @3 -> u3 register

[numthreads(8, 8, 1)]
void ColorSpaceConvertCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureSize.x) || (ThreadId.y >= TextureSize.y)))
    {
        return;
    }
    float4 pos = uvec2(ThreadId.x, ThreadId.y);
    float4 color = InputTexture.Sample(InputTextureSampler, pos);
    float4 result = ((ConversionType == 0) ? float4(LinearizeGamma(color.rgb), color.a) : ((ConversionType == 1) ? float4(pow(color.rgb, float3((1.000000 / 2.200000), (1.000000 / 2.200000), (1.000000 / 2.200000))), color.a) : ));
    write(OutputTexture, pos, result);
}
