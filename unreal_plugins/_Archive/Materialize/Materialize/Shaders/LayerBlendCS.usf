// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
uint2 TextureSize;  // @2
uint BlendMode;  // @3
float Opacity;  // @4
uint UseMask;  // @6

// Texture Inputs
Texture2D<float4> BaseLayer : register(t0);  // @0 -> t0 register
SamplerState BaseLayerSampler : register(s0);
Texture2D<float4> BlendLayer : register(t1);  // @1 -> t1 register
SamplerState BlendLayerSampler : register(s1);
Texture2D<float4> MaskTexture : register(t5);  // @5 -> t5 register
SamplerState MaskTextureSampler : register(s5);

// UAV Outputs
RWTexture2D OutputTexture : register(u7);  // @7 -> u7 register

[numthreads(8, 8, 1)]
void LayerBlendCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureSize.x) || (ThreadId.y >= TextureSize.y)))
    {
        return;
    }
    float4 pos = uvec2(ThreadId.x, ThreadId.y);
    float4 base = BaseLayer.Sample(BaseLayerSampler, pos);
    float4 blend = BlendLayer.Sample(BlendLayerSampler, pos);
    float mask = ((UseMask > 0) ? MaskTexture.Sample(MaskTextureSampler, pos).r : 1.000000);
    float4 blended = BlendColors(base.rgb, blend.rgb, BlendMode);
    float final_opacity = ((Opacity * blend.a) * mask);
    float3 result = lerp(base.rgb, blended, final_opacity);
    float alpha = max(base.a, (blend.a * final_opacity));
    write(OutputTexture, pos, float4(result, alpha));
}
