// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
uint2 TextureSize;  // @0
float4 NoiseParams;  // @1
float4 TransformParams;  // @2
float4 TransformParams2;  // @3

// UAV Outputs
RWTexture2D OutputTexture : register(u4);  // @4 -> u4 register

[numthreads(8, 8, 1)]
void GenerateCircleCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureSize.x) || (ThreadId.y >= TextureSize.y)))
    {
        return;
    }
    float2 uv = (((float2(ThreadId.x, ThreadId.y) + float2(0.500000, 0.500000))) / float2(TextureSize.x, TextureSize.y));
    float4 transformedUV = TransformUV(uv, TransformParams.x, TransformParams.y, float2(TransformParams.w, TransformParams2.x));
    float radius = NoiseParams.x;
    float softness = NoiseParams.y;
    float4 value = Circle(transformedUV, radius, softness);
    write(OutputTexture, uvec2(ThreadId.x, ThreadId.y), float4(value, value, value, 1.000000));
}
