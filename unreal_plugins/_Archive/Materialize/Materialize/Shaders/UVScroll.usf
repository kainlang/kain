// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float time;  // @0
float scroll_speed_x;  // @1
float scroll_speed_y;  // @2
float tiling_x;  // @4
float tiling_y;  // @5

// Texture Inputs
Texture2D base_texture : register(t3);  // @3 -> t3 register
SamplerState base_textureSampler : register(s3);

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput UVScrollPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float2 scrolled_uv = float2(((uv.x * tiling_x) + (time * scroll_speed_x)), ((uv.y * tiling_y) + (time * scroll_speed_y)));
    float4 color = base_texture.Sample(base_textureSampler, scrolled_uv);
    FPSOutput _Result;
    _Result.Color = color;
    return _Result;
}
