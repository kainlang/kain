// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
int spawn_count;  // @0
int emitter_shape;  // @1
float3 emitter_position;  // @2
float3 emitter_rotation;  // @3
float3 emitter_scale;  // @4
float3 initial_velocity_min;  // @5
float3 initial_velocity_max;  // @6
float lifetime_min;  // @7
float lifetime_max;  // @8
float2 size_min;  // @9
float2 size_max;  // @10
float4 color_start;  // @11
float mass_min;  // @12
float mass_max;  // @13
float random_seed;  // @14

// UAV Outputs
RWBuffer particle_buffer : register(u15);  // @15 -> u15 register
RWBuffer dead_list : register(u16);  // @16 -> u16 register
RWBuffer alive_count : register(u17);  // @17 -> u17 register

[numthreads(8, 8, 1)]
void ParticleSpawnCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float particle_id = ThreadId.x;
    if ((particle_id >= spawn_count))
    {
        return;
    }
    RWBuffer dead_index = dead_list[particle_id];
    if ((dead_index < 0))
    {
        return;
    }
    float rand_state = (random_seed + (particle_id * 12.989800));
    float4 rand1 = frac((sin(rand_state) * 43758.545300));
    float4 rand2 = frac((sin((rand_state * 2.000000)) * 43758.545300));
    float4 rand3 = frac((sin((rand_state * 3.000000)) * 43758.545300));
    float4 rand4 = frac((sin((rand_state * 4.000000)) * 43758.545300));
    float4 rand5 = frac((sin((rand_state * 5.000000)) * 43758.545300));
    float4 spawn_pos = calculate_spawn_position(emitter_shape, emitter_position, emitter_rotation, emitter_scale, rand1, rand2, rand3);
    float4 velocity = lerp_vec3(initial_velocity_min, initial_velocity_max, rand4);
    float lifetime = lerp(lifetime_min, lifetime_max, rand5);
    float4 size = lerp_vec2(size_min, size_max, rand1);
    float mass = lerp(mass_min, mass_max, rand2);
    particle_buffer[dead_index].position = spawn_pos;
    particle_buffer[dead_index].velocity = velocity;
    particle_buffer[dead_index].acceleration = float3(0.000000, 0.000000, 0.000000);
    particle_buffer[dead_index].color = color_start;
    particle_buffer[dead_index].size = size;
    particle_buffer[dead_index].rotation = (rand3 * 6.283180);
    particle_buffer[dead_index].angular_velocity = (((rand4 - 0.500000)) * 2.000000);
    particle_buffer[dead_index].lifetime = lifetime;
    particle_buffer[dead_index].age = 0.000000;
    particle_buffer[dead_index].mass = mass;
    particle_buffer[dead_index].sprite_index = 0;
    particle_buffer[dead_index].trail_id = dead_index;
}
