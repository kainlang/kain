// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float time;  // @0
float flow_speed;  // @1
float temperature;  // @2
float noise_scale;  // @3

// Texture Inputs
Texture2D base_texture : register(t4);  // @4 -> t4 register
SamplerState base_textureSampler : register(s4);
Texture2D normal_map : register(t5);  // @5 -> t5 register
SamplerState normal_mapSampler : register(s5);

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput FlowingLavaPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float2 flow_uv = float2(uv.x, (uv.y - (time * flow_speed)));
    float4 noise1 = perlin_noise((flow_uv * noise_scale));
    float4 noise2 = perlin_noise((((flow_uv * noise_scale) * 2.000000) + float2((time * 0.300000), 0.000000)));
    float2 distorted_uv = (flow_uv + float2((noise1 * 0.050000), (noise2 * 0.050000)));
    float3 base_color = base_texture.Sample(base_textureSampler, distorted_uv).rgb;
    float4 hot_spots = (noise1 * noise2);
    hot_spots = smoothstep(0.300000, 0.700000, hot_spots);
    float3 hot_color = (float3(1.000000, 0.600000, 0.200000) * temperature);
    float3 cool_color = float3(0.300000, 0.100000, 0.000000);
    float4 final_color = lerp_vec3(cool_color, hot_color, hot_spots);
    final_color = (final_color * base_color);
    float4 emissive = ((hot_spots * temperature) * 2.000000);
    FPSOutput _Result;
    _Result.Color = float4((final_color.r + emissive), (final_color.g + (emissive * 0.500000)), final_color.b, 1.000000);
    return _Result;
}
