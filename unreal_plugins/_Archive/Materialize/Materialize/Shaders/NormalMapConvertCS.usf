// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
uint2 TextureSize;  // @1
float Strength;  // @2
uint FlipY;  // @3

// Texture Inputs
Texture2D<float4> InputTexture : register(t0);  // @0 -> t0 register
SamplerState InputTextureSampler : register(s0);

// UAV Outputs
RWTexture2D OutputTexture : register(u4);  // @4 -> u4 register

[numthreads(8, 8, 1)]
void NormalMapConvertCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureSize.x) || (ThreadId.y >= TextureSize.y)))
    {
        return;
    }
    float4 pos = uvec2(ThreadId.x, ThreadId.y);
    float4 color = InputTexture.Sample(InputTextureSampler, pos);
    float3 normal = ((color.rgb * 2.000000) - float3(1.000000, 1.000000, 1.000000));
    float3 normal_scaled = float3((normal.x * Strength), ((normal.y * Strength) * (((FlipY > 0) ? (-1.000000) : 1.000000))), normal.z);
    float3 normal_normalized = normalize(normal_scaled);
    float3 normal_encoded = ((normal_normalized * 0.500000) + float3(0.500000, 0.500000, 0.500000));
    write(OutputTexture, pos, float4(normal_encoded, color.a));
