// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
int band_count;  // @0
float band_smoothness;  // @1
float3 shadow_color;  // @2
float3 normal;  // @3
float3 light_dir;  // @4
float3 base_color;  // @5

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput ToonCelShadingPSPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;

    float3 n = normalize(normal);
    float3 l = normalize(light_dir);
    float ndl = max(0.000000, dot(n, l));
    float band_size = (1.000000 / band_count);
    float band_index = floor((ndl / band_size));
    float band_value = (band_index * band_size);
    float next_band = (((band_index + 1.000000)) * band_size);
    float smooth_factor = smoothstep((band_value - band_smoothness), (band_value + band_smoothness), ndl);
    float cel_shaded = lerp(band_value, next_band, smooth_factor);
    float3 color = lerp(shadow_color, base_color, cel_shaded);
    FPSOutput _Result;
    _Result.Color = float4(color, 1.000000);
    return _Result;
}
