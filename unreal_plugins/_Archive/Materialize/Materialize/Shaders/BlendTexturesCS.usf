// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
uint2 TextureSize;  // @2
uint BlendMode;  // @3
float Opacity;  // @4

// Texture Inputs
Texture2D<float4> BaseTexture : register(t0);  // @0 -> t0 register
SamplerState BaseTextureSampler : register(s0);
Texture2D<float4> BlendTexture : register(t1);  // @1 -> t1 register
SamplerState BlendTextureSampler : register(s1);

// UAV Outputs
RWTexture2D OutputTexture : register(u5);  // @5 -> u5 register

[numthreads(8, 8, 1)]
void BlendTexturesCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureSize.x) || (ThreadId.y >= TextureSize.y)))
    {
        return;
    }
    float2 uv = (((float2(ThreadId.x, ThreadId.y) + float2(0.500000, 0.500000))) / float2(TextureSize.x, TextureSize.y));
    float4 base = BaseTexture.Sample(BaseTextureSampler, uvec2(ThreadId.x, ThreadId.y));
    float4 blend_sample = BlendTexture.Sample(BlendTextureSampler, uvec2(ThreadId.x, ThreadId.y));
    float4 blended = BlendColors(base.rgb, blend_sample.rgb, BlendMode);
    float3 result = lerp(base.rgb, blended, (Opacity * blend_sample.a));
    float alpha = max(base.a, (blend_sample.a * Opacity));
    write(OutputTexture, uvec2(ThreadId.x, ThreadId.y), float4(result, alpha));
}
