#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float NormalStrength;  // @1
uint2 TextureDimensions;  // @2
uint bAdvancedNormal;  // @3
int NormalOctaves;  // @4
float NormalSigmaBase;  // @5
float NormalAnisotropy;  // @6

// Texture Inputs
Texture2D<float4> InSourceTexture : register(t0);  // @0 -> t0 register
SamplerState InSourceTextureSampler : register(s0);

// UAV Outputs
RWTexture2D OutGradient : register(u7);  // @7 -> u7 register

[numthreads(8, 8, 1)]
void GradientCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureDimensions.x) || (ThreadId.y >= TextureDimensions.y)))
    {
        return;
    }
    float4 Pos = uvec2(ThreadId.x, ThreadId.y);
    float2 Grad = float2(0.000000, 0.000000);
    if ((bAdvancedNormal > 0))
    {
        int oct = max(1, NormalOctaves);
        int k = 0;
        while ((k < oct))
        {
            float sigma = (NormalSigmaBase * pow(2.000000, k));
            int o = max(1, round(sigma));
            float4 L = uvec2(max(0, (Pos.x - o)), Pos.y);
            float4 R = uvec2(min((TextureDimensions.x - 1), (Pos.x + o)), Pos.y);
            float4 U = uvec2(Pos.x, max(0, (Pos.y - o)));
            float4 D = uvec2(Pos.x, min((TextureDimensions.y - 1), (Pos.y + o)));
            float4 L_clamp = uvec2(clamp(L.x, 0, (TextureDimensions.x - 1)), clamp(L.y, 0, (TextureDimensions.y - 1)));
            float4 R_clamp = uvec2(clamp(R.x, 0, (TextureDimensions.x - 1)), clamp(R.y, 0, (TextureDimensions.y - 1)));
            float4 U_clamp = uvec2(clamp(U.x, 0, (TextureDimensions.x - 1)), clamp(U.y, 0, (TextureDimensions.y - 1)));
            float4 D_clamp = uvec2(clamp(D.x, 0, (TextureDimensions.x - 1)), clamp(D.y, 0, (TextureDimensions.y - 1)));
            float4 L_lum = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, L_clamp).rgb));
            float4 R_lum = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, R_clamp).rgb));
            float4 U_lum = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, U_clamp).rgb));
            float4 D_lum = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, D_clamp).rgb));
            float2 g = (float2((R_lum - L_lum), (D_lum - U_lum)) / max(1.000000, sigma));
            Grad = (Grad + g);
            k = (k + 1);
        }
    }
    else
    {
        float4 TL = uvec2(max(0, (Pos.x - 1)), max(0, (Pos.y - 1)));
        float4 T = uvec2(Pos.x, max(0, (Pos.y - 1)));
        float4 TR = uvec2(min((TextureDimensions.x - 1), (Pos.x + 1)), max(0, (Pos.y - 1)));
        float4 L = uvec2(max(0, (Pos.x - 1)), Pos.y);
        float4 R = uvec2(min((TextureDimensions.x - 1), (Pos.x + 1)), Pos.y);
        float4 BL = uvec2(max(0, (Pos.x - 1)), min((TextureDimensions.y - 1), (Pos.y + 1)));
        float4 B = uvec2(Pos.x, min((TextureDimensions.y - 1), (Pos.y + 1)));
        float4 BR = uvec2(min((TextureDimensions.x - 1), (Pos.x + 1)), min((TextureDimensions.y - 1), (Pos.y + 1)));
        float4 vTL = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, TL).rgb));
        float4 vT = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, T).rgb));
        float4 vTR = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, TR).rgb));
        float4 vL = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, L).rgb));
        float4 vR = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, R).rgb));
        float4 vBL = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, BL).rgb));
        float4 vB = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, B).rgb));
        float4 vBR = GetLuminanceLinear(LinearizeGamma(InSourceTexture.Sample(InSourceTextureSampler, BR).rgb));
        Grad.x = ((((vTR + (2.000000 * vR)) + vBR)) - (((vTL + (2.000000 * vL)) + vBL)));
        Grad.y = ((((vBL + (2.000000 * vB)) + vBR)) - (((vTL + (2.000000 * vT)) + vTR)));
    }
    Grad.x = (Grad.x * NormalAnisotropy);
    write(OutGradient, Pos, ((Grad * NormalStrength) * 0.250000));
}
