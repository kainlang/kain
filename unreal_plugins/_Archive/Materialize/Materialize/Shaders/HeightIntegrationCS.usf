    float4 R_clamp = uvec2(clamp(R_pos.x, 0, (TextureDimensions.x - 1)), clamp(R_pos.y, 0, (TextureDimensions.y - 1)));
    float4 U_clamp = uvec2(clamp(U_pos.x, 0, (TextureDimensions.x - 1)), clamp(U_pos.y, 0, (TextureDimensions.y - 1)));
    float4 D_clamp = uvec2(clamp(D_pos.x, 0, (TextureDimensions.x - 1)), clamp(D_pos.y, 0, (TextureDimensions.y - 1)));
