// @N is ordering index, not register binding
uint2 TextureDimensions;  // @2

// Texture Inputs
Texture2D<float4> InGradient : register(t0);  // @0 -> t0 register
SamplerState InGradientSampler : register(s0);
Texture2D<float4> InHeightPrev : register(t1);  // @1 -> t1 register
SamplerState InHeightPrevSampler : register(s1);

// UAV Outputs
RWTexture2D OutHeightNext : register(u3);  // @3 -> u3 register

[numthreads(8, 8, 1)]
void HeightIntegrationCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureDimensions.x) || (ThreadId.y >= TextureDimensions.y)))
    {
        return;
    }
    float4 Pos = uvec2(ThreadId.x, ThreadId.y);
    float4 L_pos = uvec2(max(0, (Pos.x - 1)), Pos.y);
