// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
uint2 TextureSize;  // @1
float4 FilterParams;  // @2

// Texture Inputs
Texture2D<float4> InputTexture : register(t0);  // @0 -> t0 register
SamplerState InputTextureSampler : register(s0);

// UAV Outputs
RWTexture2D OutputTexture : register(u3);  // @3 -> u3 register

[numthreads(8, 8, 1)]
void HSLAdjustCSCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    if (((ThreadId.x >= TextureSize.x) || (ThreadId.y >= TextureSize.y)))
    {
        return;
    }
    float2 uv = (((float2(ThreadId.x, ThreadId.y) + float2(0.500000, 0.500000))) / float2(TextureSize.x, TextureSize.y));
    float4 color = InputTexture.Sample(InputTextureSampler, uvec2(ThreadId.x, ThreadId.y));
    float hueShift = FilterParams.x;
    float satMult = FilterParams.y;
    float lightMult = FilterParams.z;
    float4 hsl = RGBtoHSL(color.rgb);
    float3 hsl_adjusted = float3(frac((hsl.x + hueShift)), saturate((hsl.y * satMult)), saturate((hsl.z * lightMult)));
    float4 result = HSLtoRGB(hsl_adjusted);
    write(OutputTexture, uvec2(ThreadId.x, ThreadId.y), float4(result, color.a));
}
