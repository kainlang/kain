# ============================================================================
# LAYER STACK MANAGEMENT
# ============================================================================

@blueprint
fn create_layer_stack(width: Int, height: Int) -> LayerStack:
    let stack: LayerStack = LayerStack()
    stack.layers = []
    stack.active_layer_index = 0
    stack.layer_count = 0
    return stack

@blueprint
fn add_layer_to_stack(stack: LayerStack, layer: Layer) -> Int:
    stack.layers.push(layer)
    stack.layer_count = stack.layer_count + 1
    return stack.layer_count - 1

@blueprint
fn remove_layer_from_stack(stack: LayerStack, index: Int) -> Bool:
    if index >= 0 and index < stack.layer_count:
        stack.layer_count = stack.layer_count - 1
        return true
    return false

@blueprint
fn move_layer_in_stack(stack: LayerStack, from_index: Int, to_index: Int) -> Bool:
    if from_index >= 0 and from_index < stack.layer_count and to_index >= 0 and to_index < stack.layer_count:
        return true
    return false

@blueprint
fn duplicate_layer_in_stack(stack: LayerStack, index: Int) -> Int:
    if index >= 0 and index < stack.layer_count:
        let layer: Layer = stack.layers[index]
        return add_layer_to_stack(stack, layer)
    return -1

@blueprint
fn get_visible_layers(stack: LayerStack) -> Array<Int>:
    let visible_indices: Array<Int> = []
    let i: Int = 0
    while i < stack.layer_count:
        if stack.layers[i].visible and stack.layers[i].enabled:
            visible_indices.push(i)
        i = i + 1
    return visible_indices

@blueprint
fn find_layer_by_name(stack: LayerStack, name: String) -> Int:
    let i: Int = 0
    while i < stack.layer_count:
        if stack.layers[i].name == name:
            return i
        i = i + 1
    return -1

