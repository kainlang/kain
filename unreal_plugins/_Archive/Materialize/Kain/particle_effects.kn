@blueprint
fn create_fire_preset() -> ParticleSystemComponent:
    let sys = ParticleSystemComponent()
    sys.max_particles = 5000
    sys.spawn_rate = 200.0
    sys.emitter_shape = EmitterShapeType::Circle
    sys.emitter_scale = vec3(50.0, 50.0, 50.0)
    sys.initial_velocity_min = vec3(-20.0, -20.0, 100.0)
    sys.initial_velocity_max = vec3(20.0, 20.0, 200.0)
    sys.lifetime_min = 1.0
    sys.lifetime_max = 2.5
    sys.particle_size_min = vec2(20.0, 20.0)
    sys.particle_size_max = vec2(40.0, 40.0)
    sys.start_color = vec4(1.0, 0.5, 0.1, 1.0)
    sys.mass_min = 0.5
    sys.mass_max = 1.0
    sys.enable_collision = false
    sys.color_over_lifetime = true
    sys.size_over_lifetime = true
    return sys

