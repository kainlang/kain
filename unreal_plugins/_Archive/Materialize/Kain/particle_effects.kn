# ============================================================================
# FORCE FACTORY FUNCTIONS
# ============================================================================

@blueprint
fn create_wind_force(direction: Vec3, strength: Float) -> ParticleForce:
    let f = ParticleForce()
    f.force_type = ForceType::Wind
    f.strength = strength
    f.position = vec3(0.0, 0.0, 0.0)
    f.radius = 1000.0
    f.direction = direction
    f.noise_scale = 0.1
    f.noise_speed = 1.0
    return f

@blueprint
fn create_gravity_force(strength: Float) -> ParticleForce:
    let f = ParticleForce()
    f.force_type = ForceType::Gravity
    f.strength = strength
    f.position = vec3(0.0, 0.0, 0.0)
    f.radius = 1000.0
    f.direction = vec3(0.0, 0.0, -1.0)
    f.noise_scale = 0.1
    f.noise_speed = 1.0
    return f

@blueprint
fn create_vortex_force(position: Vec3, axis: Vec3, strength: Float, radius: Float) -> ParticleForce:
    let f = ParticleForce()
    f.force_type = ForceType::Vortex
    f.strength = strength
    f.position = position
    f.radius = radius
    f.direction = axis
    f.noise_scale = 0.1
    f.noise_speed = 1.0
    return f

@blueprint
fn create_turbulence_force(strength: Float, noise_scale: Float) -> ParticleForce:
    let f = ParticleForce()
    f.force_type = ForceType::Turbulence
    f.strength = strength
    f.position = vec3(0.0, 0.0, 0.0)
    f.radius = 1000.0
    f.direction = vec3(0.0, 0.0, 0.0)
    f.noise_scale = noise_scale
    f.noise_speed = 1.0
    return f

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

@blueprint
fn lerp_vec3(a: Vec3, b: Vec3, t: Float) -> Vec3:
    return vec3(lerp(a.x, b.x, t), lerp(a.y, b.y, t), lerp(a.z, b.z, t))

@blueprint
fn lerp_vec2(a: Vec2, b: Vec2, t: Float) -> Vec2:
    return vec2(lerp(a.x, b.x, t), lerp(a.y, b.y, t))

@blueprint
fn lerp_vec4(a: Vec4, b: Vec4, t: Float) -> Vec4:
    return vec4(lerp(a.x, b.x, t), lerp(a.y, b.y, t), lerp(a.z, b.z, t), lerp(a.w, b.w, t))

@blueprint
fn lerp(a: Float, b: Float, t: Float) -> Float:
    return a + (b - a) * t

@blueprint
fn frac(x: Float) -> Float:
    return x - floor(x)

@blueprint
fn saturate(x: Float) -> Float:
    return clamp(x, 0.0, 1.0)

@blueprint
fn vec2(x: Float, y: Float) -> Vec2:
    return Vec2(x, y)

@blueprint
fn vec3(x: Float, y: Float, z: Float) -> Vec3:
    return Vec3(x, y, z)

@blueprint
fn vec4(x: Float, y: Float, z: Float, w: Float) -> Vec4:
    return Vec4(x, y, z, w)
