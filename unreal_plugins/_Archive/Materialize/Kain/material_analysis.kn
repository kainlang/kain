    metal_percentage: Float
    dielectric_percentage: Float
    transition_sharpness: Float
    classification_confidence: Float
    ambiguous_regions: Float
    recommended_threshold: Float
    has_gradients: Bool
    gradient_quality: Float

struct AOMapAnalysis:
