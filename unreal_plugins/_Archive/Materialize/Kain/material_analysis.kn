    mean_occlusion: Float
    min_occlusion: Float
    max_occlusion: Float
    contrast: Float
    detail_level: Float
    cavity_detection: Float
    large_scale_occlusion: Float
    small_scale_occlusion: Float
    recommended_intensity: Float
    recommended_radius: Float

struct MaterialPerformanceProfile:
