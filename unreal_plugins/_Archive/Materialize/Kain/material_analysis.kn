@blueprint
fn get_texture_width(texture_param: Texture) -> Int:
    return query_texture_property(texture, "Width")

@blueprint
fn get_texture_height(texture_param: Texture) -> Int:
    return query_texture_property(texture, "Height")

@blueprint
fn get_texture_format(texture_param: Texture) -> String:
    return query_texture_property_string(texture, "Format")

@blueprint
fn get_mipmap_count(texture_param: Texture) -> Int:
    return query_texture_property(texture, "MipCount")

@blueprint
fn get_mipmap_level(texture_param: Texture, level: Int) -> Texture:
    return extract_mipmap_level(texture, level)

@blueprint
fn sample_texture_at(texture_param: Texture, x: Int, y: Int) -> Vec4:
    return sample_texture_pixel(texture, x, y)

@blueprint
fn load_texture(path: String) -> Texture:
    return load_texture_from_path(path)

@blueprint
fn save_texture(texture_param: Texture, path: String):
    save_texture_to_path(texture, path)

@blueprint
fn get_time_milliseconds() -> Float:
    return get_current_time_ms()

@blueprint
fn get_file_name_without_extension(path: String) -> String:
    return extract_filename_no_ext(path)

@blueprint
fn display_toast(message: String, title: String, duration: Float):
    show_editor_notification(message, title, duration)

@blueprint
fn display_error_dialog(message: String, details: String):
    show_error_message_box(message, details)

@blueprint
fn display_progress_toast(message: String, progress: Float):
    show_progress_notification(message, progress)
