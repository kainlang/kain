# ============================================================================
# MATERIALIZE - Material Analysis and Optimization System
# ============================================================================
# Advanced material quality metrics, optimization, and validation tools
# - Quality metrics (sharpness, contrast, detail level, color distribution)
# - Texture compression analysis and format selection
# - Mipmap quality analysis
# - Tiling artifact detection and scoring
# - Normal map quality validation
# - Roughness/Metallic/AO map analysis
# - Material performance profiling
# - Shader complexity analysis
# - Optimization suggestions
# - Automatic LOD generation
# - Material budget tracking
# - Batch validation
# - Material comparison tools
# ============================================================================

# ============================================================================
# SECTION 1: ENUMS - Analysis categories and metrics
# ============================================================================

enum TextureCompressionFormat:
    BC1_RGB
    BC3_RGBA
    BC4_R
    BC5_RG
    BC6H_RGB16F
    BC7_RGBA
    ASTC_4x4
    ASTC_6x6
    ASTC_8x8
    ETC2_RGB
    ETC2_RGBA
    Uncompressed_RGBA8
    Uncompressed_RGB8
    Uncompressed_R16F
    Uncompressed_RGBA16F
    TextureCompressionFormat_MAX

enum MaterialQualityLevel:
    Low
    Medium
    High
    Ultra
    Cinematic
    MaterialQualityLevel_MAX

enum OptimizationPriority:
    Memory
    Performance
    Quality
    Balanced
    OptimizationPriority_MAX

enum TilingArtifactType:
    SeamVisible
    PatternRepetition
    ColorDiscontinuity
    NormalDiscontinuity
    FrequencyMismatch
    TilingArtifactType_MAX

enum NormalMapIssueType:
    InvalidRange
    LowContrast
    Artifacts
    IncorrectFormat
    MissingBlueChannel
    Denormalized
    NormalMapIssueType_MAX

enum PerformanceImpact:
    Negligible
    Low
    Medium
    High
    Critical
    PerformanceImpact_MAX

# ============================================================================
# SECTION 2: QUALITY METRICS STRUCTURES
# ============================================================================

struct TextureQualityMetrics:
    sharpness_score: Float
    contrast_score: Float
    detail_level: Float
    noise_level: Float
    dynamic_range: Float
    color_variance: Float
    histogram_entropy: Float
    edge_density: Float
    frequency_content: Float
    overall_quality: Float

struct ColorDistributionMetrics:
    mean_r: Float
    mean_g: Float
    mean_b: Float
    std_dev_r: Float
    std_dev_g: Float
    std_dev_b: Float
    min_r: Float
    min_g: Float
    min_b: Float
    max_r: Float
    max_g: Float
    max_b: Float
    histogram_bins: Array<Int>
    dominant_colors: Array<Vec3>
    color_count: Int
    saturation_mean: Float
    saturation_variance: Float
    luminance_mean: Float
    luminance_variance: Float

struct CompressionAnalysisResult:
    recommended_format: TextureCompressionFormat
    estimated_memory_uncompressed: Int
    estimated_memory_compressed: Int
    compression_ratio: Float
    quality_loss_estimate: Float
    supports_alpha: Bool
    supports_hdr: Bool
    is_normal_map: Bool
    alternative_formats: Array<TextureCompressionFormat>
    format_scores: Array<Float>

struct MipmapQualityMetrics:
    mip_count: Int
    mip_chain_complete: Bool
    aliasing_score: Float
    blur_progression: Float
    detail_preservation: Array<Float>
    memory_per_mip: Array<Int>
    total_mipmap_memory: Int
    recommended_mip_bias: Float
    quality_per_mip: Array<Float>

struct TilingArtifactReport:
    has_artifacts: Bool
    artifact_score: Float
    artifact_types: Array<TilingArtifactType>
    seam_locations: Array<Vec2>
    pattern_repetition_score: Float
    edge_continuity_score: Float
    frequency_match_score: Float
    recommended_blend_width: Float
    suggested_fixes: Array<String>

struct NormalMapValidation:
    is_valid: Bool
    issues: Array<NormalMapIssueType>
    range_min: Vec3
    range_max: Vec3
    average_normal: Vec3
    variance: Float
    tangent_space_correct: Bool
    blue_channel_bias: Float
    normalization_quality: Float
    artifact_count: Int
    recommended_strength: Float

struct RoughnessMapAnalysis:
    variance: Float
    mean_roughness: Float
    min_roughness: Float
    max_roughness: Float
    distribution_histogram: Array<Int>
    has_extreme_values: Bool
    smoothness_areas: Float
    rough_areas: Float
    detail_frequency: Float
    recommended_contrast: Float
