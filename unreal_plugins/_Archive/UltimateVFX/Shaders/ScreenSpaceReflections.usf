// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float ssr_intensity;  // @0
float max_ray_distance;  // @1
float stride;  // @2
float thickness;  // @3
float jitter;  // @4
float max_steps;  // @5
float binary_search_steps;  // @6
float fade_start;  // @7
float fade_end;  // @8
float surface_roughness;  // @9

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
    float4 TexCoord1 : TEXCOORD1;
    float4 TexCoord2 : TEXCOORD2;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput ScreenSpaceReflectionsPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;
    float3 world_pos = Input.TexCoord1.xyz;
    float3 normal = Input.TexCoord2.xyz;

    float3 view_dir = normalize((float3(0.000000, 0.000000, 1.000000) - world_pos));
    float3 reflect_dir = reflect((-view_dir), normal);
    float reflection_strength = (ssr_intensity * ((1.000000 - surface_roughness)));
    float3 reflection_color = (float3(0.500000, 0.600000, 0.700000) * reflection_strength);
    FPSOutput _Result;
    _Result.Color = float4(reflection_color, reflection_strength);
    return _Result;
}
