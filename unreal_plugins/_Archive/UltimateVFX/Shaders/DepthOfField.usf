// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
float focus_distance;  // @0
float focus_range;  // @1
float aperture;  // @2
float focal_length;  // @3
float bokeh_shape;  // @4
float bokeh_rotation;  // @5
float bokeh_scale;  // @6
float coc_scale;  // @7
float max_blur_size;  // @8

struct FPSInput
{
    float4 TexCoord0 : TEXCOORD0;
};

struct FPSOutput
{
    float4 Color : SV_Target0;
};

FPSOutput DepthOfFieldPS(FPSInput Input)
{
    // Unpack interpolators
    float2 uv = Input.TexCoord0.xy;
    float depth = Input.TexCoord0.z;

    float focus_diff = abs((depth - focus_distance));
    float coc = ((((focus_diff / max(focus_range, 0.001000))) * coc_scale) * aperture);
    float blur_amount = min(coc, max_blur_size);
    FPSOutput _Result;
    _Result.Color = float4(float3(blur_amount, blur_amount, blur_amount), 1.000000);
    return _Result;
}
