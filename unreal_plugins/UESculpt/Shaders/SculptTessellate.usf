// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
int triangle_count;  // @3
float detail_threshold;  // @4

// UAV Outputs
RWBuffer vertex_positions : register(u1);  // @1 -> u1 register
RWBuffer triangle_indices : register(u2);  // @2 -> u2 register

[numthreads(8, 8, 1)]
void SculptTessellateCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= triangle_count))
    {
        return;
    }
    RWBuffer i0 = triangle_indices[((idx * 3) + 0)];
    RWBuffer i1 = triangle_indices[((idx * 3) + 1)];
    RWBuffer i2 = triangle_indices[((idx * 3) + 2)];
    float3 v0 = vertex_positions[i0].xyz;
    float3 v1 = vertex_positions[i1].xyz;
    float3 v2 = vertex_positions[i2].xyz;
    float3 edge1 = (v1 - v0);
    float3 edge2 = (v2 - v0);
    float area = (length(cross(edge1, edge2)) * 0.500000);
    if ((area > detail_threshold))
    {
        triangle_indices[((idx * 3) + 0)] = (-1);
    }
    #ifdef CFG_ADAPTIVE
    float curvature = 0.000000;
    if ((curvature > 0.500000))
    {
        triangle_indices[((idx * 3) + 0)] = (-1);
    }
    #endif
}
