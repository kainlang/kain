// Generated by KAIN Compiler - Unreal Shader Format
// Compatible with UE5 SHADER_PARAMETER_STRUCT bindings

#include "/Engine/Public/Platform.ush"

// Scalar Parameters - Bind via SHADER_PARAMETER_STRUCT
// @N is ordering index, not register binding
int vertex_count;  // @5
float3 brush_position;  // @6
float brush_radius;  // @7
float brush_strength;  // @8
float brush_falloff;  // @9
float3 brush_direction;  // @10
int brush_type;  // @11
float3 symmetry_axis;  // @12

// UAV Outputs
RWBuffer vertex_positions : register(u3);  // @3 -> u3 register
RWBuffer vertex_normals : register(u4);  // @4 -> u4 register

[numthreads(8, 8, 1)]
void SculptDeformMeshCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Safe Texture Load Pattern
    int3 TexCoord = int3(ThreadId.xy, 0);
    float idx = ThreadId.x;
    if ((idx >= vertex_count))
    {
        return;
    }
    float3 pos = vertex_positions[idx].xyz;
    float3 normal = vertex_normals[idx].xyz;
    float3 to_brush = (pos - brush_position);
    float distance = length(to_brush);
    if ((distance > brush_radius))
    {
        return;
    }
    float falloff_factor = (1.000000 - ((distance / brush_radius)));
    float falloff = pow(falloff_factor, brush_falloff);
    float3 displacement = float3(0, 0, 0);
    if ((brush_type == 0))
    {
        displacement = ((normal * brush_strength) * falloff);
    }
    else
    {
        if ((brush_type == 1))
        {
            displacement = ((brush_direction * brush_strength) * falloff);
        }
        else
        {
            if ((brush_type == 2))
            {
                displacement = float3(0, 0, 0);
            }
            else
            {
                if ((brush_type == 3))
                {
                    displacement = ((normal * brush_strength) * falloff);
                }
                else
                {
                    if ((brush_type == 4))
                    {
                        displacement = (brush_direction * falloff);
                    }
                }
            }
        }
    }
    #ifdef CFG_HIGH_PRECISION
    pos = (pos + (displacement * 0.010000));
    #else
    pos = (pos + (displacement * 0.020000));
    #endif
    #ifdef ENABLE_SYMMETRY
    float3 mirrored_pos = (pos - ((2.000000 * dot(pos, symmetry_axis)) * symmetry_axis));
    #endif
    vertex_positions[idx] = float4(pos, 1.000000);
    #ifdef CFG_SMOOTH_NORMALS
    vertex_normals[idx] = float4(normalize(normal), 0.000000);
    #endif
}
