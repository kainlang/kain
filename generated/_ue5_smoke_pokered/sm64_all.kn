    fn play_flip_sounds(m: MarioState, frame1: Int, frame2: Int, frame3: Int) -> ():
        let mut animFrame: Int = m.marioObj.header.gfx.animInfo.animFrame
        if (((animFrame == frame1) || (animFrame == frame2)) || (animFrame == frame3)):
            play_sound(SOUND_ACTION_SPIN, m.marioObj.header.gfx.cameraToObject)

    fn play_far_fall_sound(m: MarioState) -> ():
        let mut action: Int = m.action
        if ((((!(action & ACT_FLAG_INVULNERABLE)) && (action != ACT_TWIRLING)) && (action != ACT_FLYING)) && (!(m.flags & MARIO_UNKNOWN_18))):
            if ((m.peakHeight - m.pos[1]) > 1150.0):
                play_sound(SOUND_MARIO_WAAAOOOW, m.marioObj.header.gfx.cameraToObject)
                (m.flags = (m.flags | MARIO_UNKNOWN_18))

    fn play_knockback_sound(m: MarioState) -> ():
        if ((m.actionArg == 0) && ((m.forwardVel <= (-28.0)) || (m.forwardVel >= 28.0))):
            play_sound_if_no_flag(m, SOUND_MARIO_DOH, MARIO_MARIO_SOUND_PLAYED)
        else:
            play_sound_if_no_flag(m, SOUND_MARIO_UH, MARIO_MARIO_SOUND_PLAYED)

    fn lava_boost_on_wall(m: MarioState) -> Int:
        (m.faceAngle[1] = atan2s(m.wall.normal.z, m.wall.normal.x))
        if (m.forwardVel < 24.0):
            (m.forwardVel = 24.0)
        if (!(m.flags & MARIO_METAL_CAP)):
            (m.hurtCounter = (m.hurtCounter + if (m.flags & MARIO_CAP_ON_HEAD): 12 else: 18))
        play_sound(SOUND_MARIO_ON_FIRE, m.marioObj.header.gfx.cameraToObject)
        update_mario_sound_and_camera(m)
        return drop_and_set_mario_action(m, ACT_LAVA_BOOST, 1)

    fn check_fall_damage(m: MarioState, hardFallAction: Int) -> Int:
        let mut fallHeight: Float = none
        let mut damageHeight: Float = none
        (fallHeight = (m.peakHeight - m.pos[1]))
        if (m.actionState == ACT_GROUND_POUND):
            (damageHeight = 600.0)
        else:
            (damageHeight = 1150.0)
        if ((m.action != ACT_TWIRLING) && (m.floor.type_ != SURFACE_BURNING)):
            if (m.vel[1] < (-55.0)):
                if (fallHeight > 3000.0):
                    (m.hurtCounter = (m.hurtCounter + if (m.flags & MARIO_CAP_ON_HEAD): 16 else: 24))
                    set_camera_shake_from_hit(SHAKE_FALL_DAMAGE)
                    play_sound(SOUND_MARIO_ATTACKED, m.marioObj.header.gfx.cameraToObject)
                    return drop_and_set_mario_action(m, hardFallAction, 4)
                else:
                    if ((fallHeight > damageHeight) && (!mario_floor_is_slippery(m))):
                        (m.hurtCounter = (m.hurtCounter + if (m.flags & MARIO_CAP_ON_HEAD): 8 else: 12))
                        (m.squishTimer = 30)
                        set_camera_shake_from_hit(SHAKE_FALL_DAMAGE)
                        play_sound(SOUND_MARIO_ATTACKED, m.marioObj.header.gfx.cameraToObject)
        return FALSE

    fn check_kick_or_dive_in_air(m: MarioState) -> Int:
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, if (m.forwardVel > 28.0): ACT_DIVE else: ACT_JUMP_KICK, 0)
        return FALSE

    fn should_get_stuck_in_ground(m: MarioState) -> Int:
        let mut terrainType: Int = (m.area.terrainType & TERRAIN_MASK)
        let mut floor: Surface = m.floor
        let mut flags: Int = floor.flags
        let mut type_: Int = floor.type_
        if ((((floor != NULL) && ((terrainType == TERRAIN_SNOW) || (terrainType == TERRAIN_SAND))) && (type_ != SURFACE_BURNING)) && SURFACE_IS_NOT_HARD(type_)):
            if (((!(flags & 1)) && ((m.peakHeight - m.pos[1]) > 1000.0)) && (floor.normal.y >= 0.8660254)):
                return TRUE
        return FALSE

    fn check_fall_damage_or_get_stuck(m: MarioState, hardFallAction: Int) -> Int:
        if should_get_stuck_in_ground(m):
            play_sound(SOUND_MARIO_OOOF2, m.marioObj.header.gfx.cameraToObject)
            (m.particleFlags = (m.particleFlags | PARTICLE_MIST_CIRCLE))
            drop_and_set_mario_action(m, ACT_FEET_STUCK_IN_GROUND, 0)
            return TRUE
        return check_fall_damage(m, hardFallAction)

    fn check_horizontal_wind(m: MarioState) -> Int:
        let mut floor: Surface = none
        let mut speed: Float = none
        let mut pushAngle: Int = none
        (floor = m.floor)
        if (floor.type_ == SURFACE_HORIZONTAL_WIND):
            (pushAngle = (floor.force << 8))
            (m.slideVelX = (m.slideVelX + (1.2 * sins(pushAngle))))
            (m.slideVelZ = (m.slideVelZ + (1.2 * coss(pushAngle))))
            (speed = sqrtf(((m.slideVelX * m.slideVelX) + (m.slideVelZ * m.slideVelZ))))
            if (speed > 48.0):
                (m.slideVelX = ((m.slideVelX * 48.0) / speed))
                (m.slideVelZ = ((m.slideVelZ * 48.0) / speed))
                (speed = 32.0)
            else:
                if (speed > 32.0):
                    (speed = 32.0)
            (m.vel[0] = m.slideVelX)
            (m.vel[2] = m.slideVelZ)
            (m.slideYaw = atan2s(m.slideVelZ, m.slideVelX))
            (m.forwardVel = (speed * coss((m.faceAngle[1] - m.slideYaw))))
            return TRUE
        return FALSE

    fn update_air_with_turn(m: MarioState) -> ():
        let mut dragThreshold: Float = none
        let mut intendedDYaw: Int = none
        let mut intendedMag: Float = none
        if (!check_horizontal_wind(m)):
            (dragThreshold = if (m.action == ACT_LONG_JUMP): 48.0 else: 32.0)
            (m.forwardVel = approach_f32(m.forwardVel, 0.0, 0.35, 0.35))
            if (m.input & INPUT_NONZERO_ANALOG):
                (intendedDYaw = (m.intendedYaw - m.faceAngle[1]))
                (intendedMag = (m.intendedMag / 32.0))
                (m.forwardVel = (m.forwardVel + ((1.5 * coss(intendedDYaw)) * intendedMag)))
                (m.faceAngle[1] = (m.faceAngle[1] + ((512.0 * sins(intendedDYaw)) * intendedMag)))
            if (m.forwardVel > dragThreshold):
                (m.forwardVel = (m.forwardVel - 1.0))
            if (m.forwardVel < (-16.0)):
                (m.forwardVel = (m.forwardVel + 2.0))
            (m.vel[0] = (m.slideVelX = (m.forwardVel * sins(m.faceAngle[1]))))
            (m.vel[2] = (m.slideVelZ = (m.forwardVel * coss(m.faceAngle[1]))))

    fn update_air_without_turn(m: MarioState) -> ():
        let mut sidewaysSpeed: Float = 0.0
        let mut dragThreshold: Float = none
        let mut intendedDYaw: Int = none
        let mut intendedMag: Float = none
        if (!check_horizontal_wind(m)):
            (dragThreshold = if (m.action == ACT_LONG_JUMP): 48.0 else: 32.0)
            (m.forwardVel = approach_f32(m.forwardVel, 0.0, 0.35, 0.35))
            if (m.input & INPUT_NONZERO_ANALOG):
                (intendedDYaw = (m.intendedYaw - m.faceAngle[1]))
                (intendedMag = (m.intendedMag / 32.0))
                (m.forwardVel = (m.forwardVel + ((intendedMag * coss(intendedDYaw)) * 1.5)))
                (sidewaysSpeed = ((intendedMag * sins(intendedDYaw)) * 10.0))
            if (m.forwardVel > dragThreshold):
                (m.forwardVel = (m.forwardVel - 1.0))
            if (m.forwardVel < (-16.0)):
                (m.forwardVel = (m.forwardVel + 2.0))
            (m.slideVelX = (m.forwardVel * sins(m.faceAngle[1])))
            (m.slideVelZ = (m.forwardVel * coss(m.faceAngle[1])))
            (m.slideVelX = (m.slideVelX + (sidewaysSpeed * sins((m.faceAngle[1] + 4000)))))
            (m.slideVelZ = (m.slideVelZ + (sidewaysSpeed * coss((m.faceAngle[1] + 4000)))))
            (m.vel[0] = m.slideVelX)
            (m.vel[2] = m.slideVelZ)

    fn update_lava_boost_or_twirling(m: MarioState) -> ():
        let mut intendedDYaw: Int = none
        let mut intendedMag: Float = none
        if (m.input & INPUT_NONZERO_ANALOG):
            (intendedDYaw = (m.intendedYaw - m.faceAngle[1]))
            (intendedMag = (m.intendedMag / 32.0))
            (m.forwardVel = (m.forwardVel + (coss(intendedDYaw) * intendedMag)))
            (m.faceAngle[1] = (m.faceAngle[1] + ((sins(intendedDYaw) * intendedMag) * 1024.0)))
            if (m.forwardVel < 0.0):
                (m.faceAngle[1] = (m.faceAngle[1] + 8000))
                (m.forwardVel = (m.forwardVel * (-1.0)))
            if (m.forwardVel > 32.0):
                (m.forwardVel = (m.forwardVel - 2.0))
        (m.vel[0] = (m.slideVelX = (m.forwardVel * sins(m.faceAngle[1]))))
        (m.vel[2] = (m.slideVelZ = (m.forwardVel * coss(m.faceAngle[1]))))

    fn update_flying_yaw(m: MarioState) -> ():
        let mut targetYawVel: Int = (-((m.controller.stickX * (m.forwardVel / 4.0)) as Int))
        if (targetYawVel > 0):
            if (m.angleVel[1] < 0):
                (m.angleVel[1] = (m.angleVel[1] + 40))
                if (m.angleVel[1] > 10):
                    (m.angleVel[1] = 10)
            else:
                (m.angleVel[1] = approach_s32(m.angleVel[1], targetYawVel, 10, 20))
        else:
            if (targetYawVel < 0):
                if (m.angleVel[1] > 0):
                    (m.angleVel[1] = (m.angleVel[1] - 40))
                    if (m.angleVel[1] < (-10)):
                        (m.angleVel[1] = (-10))
                else:
                    (m.angleVel[1] = approach_s32(m.angleVel[1], targetYawVel, 20, 10))
            else:
                (m.angleVel[1] = approach_s32(m.angleVel[1], 0, 40, 40))
        (m.faceAngle[1] = (m.faceAngle[1] + m.angleVel[1]))
        (m.faceAngle[2] = (20 * (-m.angleVel[1])))

    fn update_flying_pitch(m: MarioState) -> ():
        let mut targetPitchVel: Int = (-((m.controller.stickY * (m.forwardVel / 5.0)) as Int))
        if (targetPitchVel > 0):
            if (m.angleVel[0] < 0):
                (m.angleVel[0] = (m.angleVel[0] + 40))
                if (m.angleVel[0] > 20):
                    (m.angleVel[0] = 20)
            else:
                (m.angleVel[0] = approach_s32(m.angleVel[0], targetPitchVel, 20, 40))
        else:
            if (targetPitchVel < 0):
                if (m.angleVel[0] > 0):
                    (m.angleVel[0] = (m.angleVel[0] - 40))
                    if (m.angleVel[0] < (-20)):
                        (m.angleVel[0] = (-20))
                else:
                    (m.angleVel[0] = approach_s32(m.angleVel[0], targetPitchVel, 40, 20))
            else:
                (m.angleVel[0] = approach_s32(m.angleVel[0], 0, 40, 40))

    fn update_flying(m: MarioState) -> ():
        let mut filler: Int = none
        update_flying_pitch(m)
        update_flying_yaw(m)
        (m.forwardVel = (m.forwardVel - ((2.0 * ((m.faceAngle[0] as Float) / 4000)) + 0.1)))
        (m.forwardVel = (m.forwardVel - (0.5 * (1.0 - coss(m.angleVel[1])))))
        if (m.forwardVel < 0.0):
            (m.forwardVel = 0.0)
        if (m.forwardVel > 16.0):
            (m.faceAngle[0] = (m.faceAngle[0] + ((m.forwardVel - 32.0) * 6.0)))
        else:
            if (m.forwardVel > 4.0):
                (m.faceAngle[0] = (m.faceAngle[0] + ((m.forwardVel - 32.0) * 10.0)))
            else:
                (m.faceAngle[0] = (m.faceAngle[0] - 400))
        (m.faceAngle[0] = (m.faceAngle[0] + m.angleVel[0]))
        if (m.faceAngle[0] > 0):
            (m.faceAngle[0] = 0)
        if (m.faceAngle[0] < (-0)):
            (m.faceAngle[0] = (-0))
        (m.vel[0] = ((m.forwardVel * coss(m.faceAngle[0])) * sins(m.faceAngle[1])))
        (m.vel[1] = (m.forwardVel * sins(m.faceAngle[0])))
        (m.vel[2] = ((m.forwardVel * coss(m.faceAngle[0])) * coss(m.faceAngle[1])))
        (m.slideVelX = m.vel[0])
        (m.slideVelZ = m.vel[2])

    fn common_air_action_step(m: MarioState, landAction: Int, animation: Int, stepArg: Int) -> Int:
        let mut stepResult: Int = none
        update_air_without_turn(m)
        (stepResult = perform_air_step(m, stepArg))
        return stepResult

    fn act_jump(m: MarioState) -> Int:
        if check_kick_or_dive_in_air(m):
            return TRUE
        if (m.input & INPUT_Z_PRESSED):
            return set_mario_action(m, ACT_GROUND_POUND, 0)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        common_air_action_step(m, ACT_JUMP_LAND, MARIO_ANIM_SINGLE_JUMP, (AIR_STEP_CHECK_LEDGE_GRAB | AIR_STEP_CHECK_HANG))
        return FALSE

    fn act_double_jump(m: MarioState) -> Int:
        let mut animation: Int = if (m.vel[1] >= 0.0): MARIO_ANIM_DOUBLE_JUMP_RISE else: MARIO_ANIM_DOUBLE_JUMP_FALL
        if check_kick_or_dive_in_air(m):
            return TRUE
        if (m.input & INPUT_Z_PRESSED):
            return set_mario_action(m, ACT_GROUND_POUND, 0)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, SOUND_MARIO_HOOHOO)
        common_air_action_step(m, ACT_DOUBLE_JUMP_LAND, animation, (AIR_STEP_CHECK_LEDGE_GRAB | AIR_STEP_CHECK_HANG))
        return FALSE

    fn act_triple_jump(m: MarioState) -> Int:
        if gSpecialTripleJump:
            return set_mario_action(m, ACT_SPECIAL_TRIPLE_JUMP, 0)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_DIVE, 0)
        if (m.input & INPUT_Z_PRESSED):
            return set_mario_action(m, ACT_GROUND_POUND, 0)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        common_air_action_step(m, ACT_TRIPLE_JUMP_LAND, MARIO_ANIM_TRIPLE_JUMP, 0)
        play_flip_sounds(m, 2, 8, 20)
        return FALSE

    fn act_backflip(m: MarioState) -> Int:
        if (m.input & INPUT_Z_PRESSED):
            return set_mario_action(m, ACT_GROUND_POUND, 0)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, SOUND_MARIO_YAH_WAH_HOO)
        common_air_action_step(m, ACT_BACKFLIP_LAND, MARIO_ANIM_BACKFLIP, 0)
        play_flip_sounds(m, 2, 3, 17)
        return FALSE

    fn act_freefall(m: MarioState) -> Int:
        let mut animation: Int = none
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_DIVE, 0)
        if (m.input & INPUT_Z_PRESSED):
            return set_mario_action(m, ACT_GROUND_POUND, 0)
        common_air_action_step(m, ACT_FREEFALL_LAND, animation, AIR_STEP_CHECK_LEDGE_GRAB)
        return FALSE

    fn act_hold_jump(m: MarioState) -> Int:
        if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_DROP_OBJECT):
            return drop_and_set_mario_action(m, ACT_FREEFALL, 0)
        if ((m.input & INPUT_B_PRESSED) && (!(m.heldObj.oInteractionSubtype & INT_SUBTYPE_HOLDABLE_NPC))):
            return set_mario_action(m, ACT_AIR_THROW, 0)
        if (m.input & INPUT_Z_PRESSED):
            return drop_and_set_mario_action(m, ACT_GROUND_POUND, 0)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        common_air_action_step(m, ACT_HOLD_JUMP_LAND, MARIO_ANIM_JUMP_WITH_LIGHT_OBJ, AIR_STEP_CHECK_LEDGE_GRAB)
        return FALSE

    fn act_hold_freefall(m: MarioState) -> Int:
        let mut animation: Int = none
        if (m.actionArg == 0):
            (animation = MARIO_ANIM_FALL_WITH_LIGHT_OBJ)
        else:
            (animation = MARIO_ANIM_FALL_FROM_SLIDING_WITH_LIGHT_OBJ)
        if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_DROP_OBJECT):
            return drop_and_set_mario_action(m, ACT_FREEFALL, 0)
        if ((m.input & INPUT_B_PRESSED) && (!(m.heldObj.oInteractionSubtype & INT_SUBTYPE_HOLDABLE_NPC))):
            return set_mario_action(m, ACT_AIR_THROW, 0)
        if (m.input & INPUT_Z_PRESSED):
            return drop_and_set_mario_action(m, ACT_GROUND_POUND, 0)
        common_air_action_step(m, ACT_HOLD_FREEFALL_LAND, animation, AIR_STEP_CHECK_LEDGE_GRAB)
        return FALSE

    fn act_side_flip(m: MarioState) -> Int:
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_DIVE, 0)
        if (m.input & INPUT_Z_PRESSED):
            return set_mario_action(m, ACT_GROUND_POUND, 0)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        if (common_air_action_step(m, ACT_SIDE_FLIP_LAND, MARIO_ANIM_SLIDEFLIP, AIR_STEP_CHECK_LEDGE_GRAB) != AIR_STEP_GRABBED_LEDGE):
            (m.marioObj.header.gfx.angle[1] = (m.marioObj.header.gfx.angle[1] + 8000))
        if (m.marioObj.header.gfx.animInfo.animFrame == 6):
            play_sound(SOUND_ACTION_SIDE_FLIP_UNK, m.marioObj.header.gfx.cameraToObject)
        return FALSE

    fn act_wall_kick_air(m: MarioState) -> Int:
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_DIVE, 0)
        if (m.input & INPUT_Z_PRESSED):
            return set_mario_action(m, ACT_GROUND_POUND, 0)
        play_mario_jump_sound(m)
        common_air_action_step(m, ACT_JUMP_LAND, MARIO_ANIM_SLIDEJUMP, AIR_STEP_CHECK_LEDGE_GRAB)
        return FALSE

    fn act_long_jump(m: MarioState) -> Int:
        let mut animation: Int = none
        if (!m.marioObj.oMarioLongJumpIsSlow):
            (animation = MARIO_ANIM_FAST_LONGJUMP)
        else:
            (animation = MARIO_ANIM_SLOW_LONGJUMP)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, SOUND_MARIO_YAHOO)
        if ((m.floor.type_ == SURFACE_VERTICAL_WIND) && (m.actionState == 0)):
            play_sound(SOUND_MARIO_HERE_WE_GO, m.marioObj.header.gfx.cameraToObject)
            (m.actionState = 1)
        common_air_action_step(m, ACT_LONG_JUMP_LAND, animation, AIR_STEP_CHECK_LEDGE_GRAB)
        return FALSE

    fn act_riding_shell_air(m: MarioState) -> Int:
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        set_mario_animation(m, MARIO_ANIM_JUMP_RIDING_SHELL)
        update_air_without_turn(m)
        (m.marioObj.header.gfx.pos[1] = (m.marioObj.header.gfx.pos[1] + 42.0))
        return FALSE

    fn act_twirling(m: MarioState) -> Int:
        let mut startTwirlYaw: Int = m.twirlYaw
        let mut yawVelTarget: Int = none
        if (m.input & INPUT_A_DOWN):
            (yawVelTarget = 2000)
        else:
            (yawVelTarget = 1800)
        (m.angleVel[1] = approach_s32(m.angleVel[1], yawVelTarget, 200, 200))
        (m.twirlYaw = (m.twirlYaw + m.angleVel[1]))
        set_mario_animation(m, if (m.actionArg == 0): MARIO_ANIM_START_TWIRL else: MARIO_ANIM_TWIRL)
        if is_anim_past_end(m):
            (m.actionArg = 1)
        if (startTwirlYaw > m.twirlYaw):
            play_sound(SOUND_ACTION_TWIRL, m.marioObj.header.gfx.cameraToObject)
        update_lava_boost_or_twirling(m)
        (m.marioObj.header.gfx.angle[1] = (m.marioObj.header.gfx.angle[1] + m.twirlYaw))
        return FALSE

    fn act_dive(m: MarioState) -> Int:
        if (m.actionArg == 0):
            play_mario_sound(m, SOUND_ACTION_THROW, SOUND_MARIO_HOOHOO)
        else:
            play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        set_mario_animation(m, MARIO_ANIM_DIVE)
        if mario_check_object_grab(m):
            mario_grab_used_object(m)
            (m.marioBodyState.grabPos = GRAB_POS_LIGHT_OBJ)
            if (m.action != ACT_DIVE):
                return TRUE
        update_air_without_turn(m)
        return FALSE

    fn act_air_throw(m: MarioState) -> Int:
        if ((m.actionTimer = (m.actionTimer + 1)) == 4):
            mario_throw_held_object(m)
        play_sound_if_no_flag(m, SOUND_MARIO_WAH2, MARIO_MARIO_SOUND_PLAYED)
        set_mario_animation(m, MARIO_ANIM_THROW_LIGHT_OBJECT)
        update_air_without_turn(m)
        return FALSE

    fn act_water_jump(m: MarioState) -> Int:
        if (m.forwardVel < 15.0):
            mario_set_forward_vel(m, 15.0)
        play_mario_sound(m, SOUND_ACTION_UNKNOWN432, 0)
        set_mario_animation(m, MARIO_ANIM_SINGLE_JUMP)
        return FALSE

    fn act_hold_water_jump(m: MarioState) -> Int:
        if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_DROP_OBJECT):
            return drop_and_set_mario_action(m, ACT_FREEFALL, 0)
        if (m.forwardVel < 15.0):
            mario_set_forward_vel(m, 15.0)
        play_mario_sound(m, SOUND_ACTION_UNKNOWN432, 0)
        set_mario_animation(m, MARIO_ANIM_JUMP_WITH_LIGHT_OBJ)
        return FALSE

    fn act_steep_jump(m: MarioState) -> Int:
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_DIVE, 0)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        mario_set_forward_vel(m, (0.98 * m.forwardVel))
        set_mario_animation(m, MARIO_ANIM_SINGLE_JUMP)
        (m.marioObj.header.gfx.angle[1] = m.marioObj.oMarioSteepJumpYaw)
        return FALSE

    fn act_ground_pound(m: MarioState) -> Int:
        let mut stepResult: Int = none
        let mut yOffset: Float = none
        play_sound_if_no_flag(m, SOUND_ACTION_THROW, MARIO_ACTION_SOUND_PLAYED)
        if (m.actionState == 0):
            if (m.actionTimer < 10):
                (yOffset = (20 - (2 * m.actionTimer)))
                if (((m.pos[1] + yOffset) + 160.0) < m.ceilHeight):
                    (m.pos[1] = (m.pos[1] + yOffset))
                    (m.peakHeight = m.pos[1])
                    vec3f_copy(m.marioObj.header.gfx.pos, m.pos)
            (m.vel[1] = (-50.0))
            mario_set_forward_vel(m, 0.0)
            set_mario_animation(m, if (m.actionArg == 0): MARIO_ANIM_START_GROUND_POUND else: MARIO_ANIM_TRIPLE_JUMP_GROUND_POUND)
            if (m.actionTimer == 0):
                play_sound(SOUND_ACTION_SPIN, m.marioObj.header.gfx.cameraToObject)
            (m.actionTimer = (m.actionTimer + 1))
            if (m.actionTimer >= (m.marioObj.header.gfx.animInfo.curAnim.loopEnd + 4)):
                play_sound(SOUND_MARIO_GROUND_POUND_WAH, m.marioObj.header.gfx.cameraToObject)
                (m.actionState = 1)
        else:
            set_mario_animation(m, MARIO_ANIM_GROUND_POUND)
            (stepResult = perform_air_step(m, 0))
            if (stepResult == AIR_STEP_LANDED):
                if should_get_stuck_in_ground(m):
                    play_sound(SOUND_MARIO_OOOF2, m.marioObj.header.gfx.cameraToObject)
                    (m.particleFlags = (m.particleFlags | PARTICLE_MIST_CIRCLE))
                    set_mario_action(m, ACT_BUTT_STUCK_IN_GROUND, 0)
                else:
                    play_mario_heavy_landing_sound(m, SOUND_ACTION_TERRAIN_HEAVY_LANDING)
                    if (!check_fall_damage(m, ACT_HARD_BACKWARD_GROUND_KB)):
                        (m.particleFlags = (m.particleFlags | (PARTICLE_MIST_CIRCLE | PARTICLE_HORIZONTAL_STAR)))
                        set_mario_action(m, ACT_GROUND_POUND_LAND, 0)
                set_camera_shake_from_hit(SHAKE_GROUND_POUND)
            else:
                if (stepResult == AIR_STEP_HIT_WALL):
                    mario_set_forward_vel(m, (-16.0))
                    if (m.vel[1] > 0.0):
                        (m.vel[1] = 0.0)
                    (m.particleFlags = (m.particleFlags | PARTICLE_VERTICAL_STAR))
                    set_mario_action(m, ACT_BACKWARD_AIR_KB, 0)
        return FALSE

    fn act_burning_jump(m: MarioState) -> Int:
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, if (m.actionArg == 0): 0 else: (-1))
        mario_set_forward_vel(m, m.forwardVel)
        if (perform_air_step(m, 0) == AIR_STEP_LANDED):
            play_mario_landing_sound(m, SOUND_ACTION_TERRAIN_LANDING)
            set_mario_action(m, ACT_BURNING_GROUND, 0)
        set_mario_animation(m, if (m.actionArg == 0): MARIO_ANIM_SINGLE_JUMP else: MARIO_ANIM_FIRE_LAVA_BURN)
        (m.particleFlags = (m.particleFlags | PARTICLE_FIRE))
        play_sound(SOUND_MOVING_LAVA_BURN, m.marioObj.header.gfx.cameraToObject)
        (m.marioObj.oMarioBurnTimer = (m.marioObj.oMarioBurnTimer + 3))
        (m.health = (m.health - 10))
        if (m.health < 100):
            (m.health = 0)
        return FALSE

    fn act_burning_fall(m: MarioState) -> Int:
        mario_set_forward_vel(m, m.forwardVel)
        if (perform_air_step(m, 0) == AIR_STEP_LANDED):
            play_mario_landing_sound(m, SOUND_ACTION_TERRAIN_LANDING)
            set_mario_action(m, ACT_BURNING_GROUND, 0)
        set_mario_animation(m, MARIO_ANIM_GENERAL_FALL)
        (m.particleFlags = (m.particleFlags | PARTICLE_FIRE))
        (m.marioObj.oMarioBurnTimer = (m.marioObj.oMarioBurnTimer + 3))
        (m.health = (m.health - 10))
        if (m.health < 100):
            (m.health = 0)
        return FALSE

    fn act_crazy_box_bounce(m: MarioState) -> Int:
        let mut minSpeed: Float = none
        if (m.actionTimer == 0):
            play_sound(if (minSpeed < 40.0): SOUND_GENERAL_BOING1 else: SOUND_GENERAL_BOING2, m.marioObj.header.gfx.cameraToObject)
            if (m.forwardVel < minSpeed):
                mario_set_forward_vel(m, minSpeed)
            (m.actionTimer = 1)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        set_mario_animation(m, MARIO_ANIM_DIVE)
        update_air_without_turn(m)
        (m.marioObj.header.gfx.angle[0] = atan2s(m.forwardVel, (-m.vel[1])))
        return FALSE

    fn common_air_knockback_step(m: MarioState, landAction: Int, hardFallAction: Int, animation: Int, speed: Float) -> Int:
        let mut stepResult: Int = none
        mario_set_forward_vel(m, speed)
        (stepResult = perform_air_step(m, 0))
        return stepResult

    fn check_wall_kick(m: MarioState) -> Int:
        if (((m.input & INPUT_A_PRESSED) && (m.wallKickTimer != 0)) && (m.prevAction == ACT_AIR_HIT_WALL)):
            (m.faceAngle[1] = (m.faceAngle[1] + 8000))
            return set_mario_action(m, ACT_WALL_KICK_AIR, 0)
        return FALSE

    fn act_backward_air_kb(m: MarioState) -> Int:
        if check_wall_kick(m):
            return TRUE
        play_knockback_sound(m)
        common_air_knockback_step(m, ACT_BACKWARD_GROUND_KB, ACT_HARD_BACKWARD_GROUND_KB, 2, (-16.0))
        return FALSE

    fn act_forward_air_kb(m: MarioState) -> Int:
        if check_wall_kick(m):
            return TRUE
        play_knockback_sound(m)
        common_air_knockback_step(m, ACT_FORWARD_GROUND_KB, ACT_HARD_FORWARD_GROUND_KB, 0, 16.0)
        return FALSE

    fn act_hard_backward_air_kb(m: MarioState) -> Int:
        play_knockback_sound(m)
        common_air_knockback_step(m, ACT_HARD_BACKWARD_GROUND_KB, ACT_HARD_BACKWARD_GROUND_KB, 2, (-16.0))
        return FALSE

    fn act_hard_forward_air_kb(m: MarioState) -> Int:
        play_knockback_sound(m)
        common_air_knockback_step(m, ACT_HARD_FORWARD_GROUND_KB, ACT_HARD_FORWARD_GROUND_KB, 0, 16.0)
        return FALSE

    fn act_thrown_backward(m: MarioState) -> Int:
        let mut landAction: Int = none
        if (m.actionArg != 0):
            (landAction = ACT_HARD_BACKWARD_GROUND_KB)
        else:
            (landAction = ACT_BACKWARD_GROUND_KB)
        play_sound_if_no_flag(m, SOUND_MARIO_WAAAOOOW, MARIO_MARIO_SOUND_PLAYED)
        common_air_knockback_step(m, landAction, ACT_HARD_BACKWARD_GROUND_KB, 2, m.forwardVel)
        (m.forwardVel = (m.forwardVel * 0.98))
        return FALSE

    fn act_thrown_forward(m: MarioState) -> Int:
        let mut pitch: Int = none
        let mut landAction: Int = none
        if (m.actionArg != 0):
            (landAction = ACT_HARD_FORWARD_GROUND_KB)
        else:
            (landAction = ACT_FORWARD_GROUND_KB)
        play_sound_if_no_flag(m, SOUND_MARIO_WAAAOOOW, MARIO_MARIO_SOUND_PLAYED)
        if (common_air_knockback_step(m, landAction, ACT_HARD_FORWARD_GROUND_KB, 0, m.forwardVel) == AIR_STEP_NONE):
            (pitch = atan2s(m.forwardVel, (-m.vel[1])))
            if (pitch > 1800):
                (pitch = 1800)
            (m.marioObj.header.gfx.angle[0] = (pitch + 1800))
        (m.forwardVel = (m.forwardVel * 0.98))
        return FALSE

    fn act_soft_bonk(m: MarioState) -> Int:
        if check_wall_kick(m):
            return TRUE
        play_knockback_sound(m)
        common_air_knockback_step(m, ACT_FREEFALL_LAND, ACT_HARD_BACKWARD_GROUND_KB, 56, m.forwardVel)
        return FALSE

    fn act_getting_blown(m: MarioState) -> Int:
        if (m.actionState == 0):
            if (m.forwardVel > (-60.0)):
                (m.forwardVel = (m.forwardVel - 6.0))
            else:
                (m.actionState = 1)
        else:
            if (m.forwardVel < (-16.0)):
                (m.forwardVel = (m.forwardVel + 0.8))
            if ((m.vel[1] < 0.0) && (m.gettingBlownGravity < 4.0)):
                (m.gettingBlownGravity = (m.gettingBlownGravity + 0.05))
        if ((m.actionTimer = (m.actionTimer + 1)) == 20):
            mario_blow_off_cap(m, 50.0)
        mario_set_forward_vel(m, m.forwardVel)
        set_mario_animation(m, MARIO_ANIM_BACKWARD_AIR_KB)
        return FALSE

    fn act_air_hit_wall(m: MarioState) -> Int:
        if (m.heldObj != NULL):
            mario_drop_held_object(m)
        if ((m.actionTimer = (m.actionTimer + 1)) <= 2):
            if (m.input & INPUT_A_PRESSED):
                (m.vel[1] = 52.0)
                (m.faceAngle[1] = (m.faceAngle[1] + 8000))
                return set_mario_action(m, ACT_WALL_KICK_AIR, 0)
        else:
            if (m.forwardVel >= 38.0):
                (m.wallKickTimer = 5)
                if (m.vel[1] > 0.0):
                    (m.vel[1] = 0.0)
                (m.particleFlags = (m.particleFlags | PARTICLE_VERTICAL_STAR))
                return set_mario_action(m, ACT_BACKWARD_AIR_KB, 0)
            else:
                (m.wallKickTimer = 5)
                if (m.vel[1] > 0.0):
                    (m.vel[1] = 0.0)
                if (m.forwardVel > 8.0):
                    mario_set_forward_vel(m, (-8.0))
                return set_mario_action(m, ACT_SOFT_BONK, 0)
        set_mario_animation(m, MARIO_ANIM_START_WALLKICK)

    fn act_forward_rollout(m: MarioState) -> Int:
        if (m.actionState == 0):
            (m.vel[1] = 30.0)
            (m.actionState = 1)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        update_air_without_turn(m)
        if ((m.actionState == 1) && is_anim_past_end(m)):
            (m.actionState = 2)
        return FALSE

    fn act_backward_rollout(m: MarioState) -> Int:
        if (m.actionState == 0):
            (m.vel[1] = 30.0)
            (m.actionState = 1)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, 0)
        update_air_without_turn(m)
        if ((m.actionState == 1) && (m.marioObj.header.gfx.animInfo.animFrame == 2)):
            (m.actionState = 2)
        return FALSE

    fn act_butt_slide_air(m: MarioState) -> Int:
        if (((m.actionTimer = (m.actionTimer + 1)) > 30) && ((m.pos[1] - m.floorHeight) > 500.0)):
            return set_mario_action(m, ACT_FREEFALL, 1)
        update_air_with_turn(m)
        set_mario_animation(m, MARIO_ANIM_SLIDE)
        return FALSE

    fn act_hold_butt_slide_air(m: MarioState) -> Int:
        if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_DROP_OBJECT):
            return drop_and_set_mario_action(m, ACT_HOLD_FREEFALL, 1)
        if (((m.actionTimer = (m.actionTimer + 1)) > 30) && ((m.pos[1] - m.floorHeight) > 500.0)):
            return set_mario_action(m, ACT_HOLD_FREEFALL, 1)
        update_air_with_turn(m)
        set_mario_animation(m, MARIO_ANIM_SLIDING_ON_BOTTOM_WITH_LIGHT_OBJ)
        return FALSE

    fn act_lava_boost(m: MarioState) -> Int:
        play_sound_if_no_flag(m, SOUND_MARIO_ON_FIRE, MARIO_MARIO_SOUND_PLAYED)
        if (!(m.input & INPUT_NONZERO_ANALOG)):
            (m.forwardVel = approach_f32(m.forwardVel, 0.0, 0.35, 0.35))
        update_lava_boost_or_twirling(m)
        set_mario_animation(m, MARIO_ANIM_FIRE_LAVA_BURN)
        if ((((m.area.terrainType & TERRAIN_MASK) != TERRAIN_SNOW) && (!(m.flags & MARIO_METAL_CAP))) && (m.vel[1] > 0.0)):
            (m.particleFlags = (m.particleFlags | PARTICLE_FIRE))
            if (m.actionState == 0):
                play_sound(SOUND_MOVING_LAVA_BURN, m.marioObj.header.gfx.cameraToObject)
        if (m.health < 100):
            level_trigger_warp(m, WARP_OP_DEATH)
        (m.marioBodyState.eyeState = MARIO_EYES_DEAD)
        return FALSE

    fn act_slide_kick(m: MarioState) -> Int:
        if ((m.actionState == 0) && (m.actionTimer == 0)):
            play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, SOUND_MARIO_HOOHOO)
            set_mario_animation(m, MARIO_ANIM_SLIDE_KICK)
        if (((m.actionTimer = (m.actionTimer + 1)) > 30) && ((m.pos[1] - m.floorHeight) > 500.0)):
            return set_mario_action(m, ACT_FREEFALL, 2)
        update_air_without_turn(m)
        return FALSE

    fn act_jump_kick(m: MarioState) -> Int:
        let mut animFrame: Int = none
        if (m.actionState == 0):
            play_sound_if_no_flag(m, SOUND_MARIO_PUNCH_HOO, MARIO_ACTION_SOUND_PLAYED)
            (m.marioObj.header.gfx.animInfo.animID = (-1))
            set_mario_animation(m, MARIO_ANIM_AIR_KICK)
            (m.actionState = 1)
        (animFrame = m.marioObj.header.gfx.animInfo.animFrame)
        if (animFrame == 0):
            (m.marioBodyState.punchState = ((2 << 6) | 6))
        if ((animFrame >= 0) && (animFrame < 8)):
            (m.flags = (m.flags | MARIO_KICKING))
        update_air_without_turn(m)
        return FALSE

    fn act_shot_from_cannon(m: MarioState) -> Int:
        if (m.area.camera.mode != CAMERA_MODE_BEHIND_MARIO):
            (m.statusForCamera.cameraEvent = CAM_EVENT_SHOT_FROM_CANNON)
        mario_set_forward_vel(m, m.forwardVel)
        play_sound_if_no_flag(m, SOUND_MARIO_YAHOO, MARIO_MARIO_SOUND_PLAYED)
        if ((m.flags & MARIO_WING_CAP) && (m.vel[1] < 0.0)):
            set_mario_action(m, ACT_FLYING, 0)
        if ((m.forwardVel = (m.forwardVel - 0.05)) < 10.0):
            mario_set_forward_vel(m, 10.0)
        if (m.vel[1] > 0.0):
            (m.particleFlags = (m.particleFlags | PARTICLE_DUST))
        return FALSE

    fn act_flying(m: MarioState) -> Int:
        let mut startPitch: Int = m.faceAngle[0]
        if (m.input & INPUT_Z_PRESSED):
            if (m.area.camera.mode == CAMERA_MODE_BEHIND_MARIO):
                set_camera_mode(m.area.camera, m.area.camera.defMode, 1)
            return set_mario_action(m, ACT_GROUND_POUND, 1)
        if (!(m.flags & MARIO_WING_CAP)):
            if (m.area.camera.mode == CAMERA_MODE_BEHIND_MARIO):
                set_camera_mode(m.area.camera, m.area.camera.defMode, 1)
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.area.camera.mode != CAMERA_MODE_BEHIND_MARIO):
            set_camera_mode(m.area.camera, CAMERA_MODE_BEHIND_MARIO, 1)
        if (m.actionState == 0):
            if (m.actionArg == 0):
                set_mario_animation(m, MARIO_ANIM_FLY_FROM_CANNON)
            else:
                set_mario_animation(m, MARIO_ANIM_FORWARD_SPINNING_FLIP)
                if (m.marioObj.header.gfx.animInfo.animFrame == 1):
                    play_sound(SOUND_ACTION_SPIN, m.marioObj.header.gfx.cameraToObject)
            if is_anim_at_end(m):
                if (m.actionArg == 2):
                    load_level_init_text(0)
                    (m.actionArg = 1)
                set_mario_animation(m, MARIO_ANIM_WING_CAP_FLY)
                (m.actionState = 1)
        update_flying(m)
        if ((m.faceAngle[0] > 800) && (m.forwardVel >= 48.0)):
            (m.particleFlags = (m.particleFlags | PARTICLE_DUST))
        if (((startPitch <= 0) && (m.faceAngle[0] > 0)) && (m.forwardVel >= 48.0)):
            play_sound(SOUND_ACTION_FLYING_FAST, m.marioObj.header.gfx.cameraToObject)
            play_sound((SOUND_MARIO_YAHOO_WAHA_YIPPEE + ((gAudioRandom % 5) << 16)), m.marioObj.header.gfx.cameraToObject)
        play_sound(SOUND_MOVING_FLYING, m.marioObj.header.gfx.cameraToObject)
        adjust_sound_for_speed(m)
        return FALSE

    fn act_riding_hoot(m: MarioState) -> Int:
        if ((!(m.input & INPUT_A_DOWN)) || (m.marioObj.oInteractStatus & INT_STATUS_MARIO_UNK7)):
            (m.usedObj.oInteractStatus = 0)
            (m.usedObj.oHootMarioReleaseTime = gGlobalTimer)
            play_sound_if_no_flag(m, SOUND_MARIO_UH, MARIO_MARIO_SOUND_PLAYED)
            return set_mario_action(m, ACT_FREEFALL, 0)
        (m.pos[0] = m.usedObj.oPosX)
        (m.pos[1] = (m.usedObj.oPosY - 92.5))
        (m.pos[2] = m.usedObj.oPosZ)
        (m.faceAngle[1] = (4000 - m.usedObj.oMoveAngleYaw))
        if (m.actionState == 0):
            set_mario_animation(m, MARIO_ANIM_HANG_ON_CEILING)
            if is_anim_at_end(m):
                set_mario_animation(m, MARIO_ANIM_HANG_ON_OWL)
                (m.actionState = 1)
        vec3f_set(m.vel, 0.0, 0.0, 0.0)
        vec3f_set(m.marioObj.header.gfx.pos, m.pos[0], m.pos[1], m.pos[2])
        vec3s_set(m.marioObj.header.gfx.angle, 0, (4000 - m.faceAngle[1]), 0)
        return FALSE

    fn act_flying_triple_jump(m: MarioState) -> Int:
        if (m.input & (INPUT_B_PRESSED | INPUT_Z_PRESSED)):
            if (m.area.camera.mode == CAMERA_MODE_BEHIND_MARIO):
                set_camera_mode(m.area.camera, m.area.camera.defMode, 1)
            if (m.input & INPUT_B_PRESSED):
                return set_mario_action(m, ACT_DIVE, 0)
            else:
                return set_mario_action(m, ACT_GROUND_POUND, 0)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, SOUND_MARIO_YAHOO)
        if (m.actionState == 0):
            set_mario_animation(m, MARIO_ANIM_TRIPLE_JUMP_FLY)
            if (m.marioObj.header.gfx.animInfo.animFrame == 7):
                play_sound(SOUND_ACTION_SPIN, m.marioObj.header.gfx.cameraToObject)
            if is_anim_past_end(m):
                set_mario_animation(m, MARIO_ANIM_FORWARD_SPINNING)
                (m.actionState = 1)
        if ((m.actionState == 1) && (m.marioObj.header.gfx.animInfo.animFrame == 1)):
            play_sound(SOUND_ACTION_SPIN, m.marioObj.header.gfx.cameraToObject)
        if (m.vel[1] < 4.0):
            if (m.area.camera.mode != CAMERA_MODE_BEHIND_MARIO):
                set_camera_mode(m.area.camera, CAMERA_MODE_BEHIND_MARIO, 1)
            if (m.forwardVel < 32.0):
                mario_set_forward_vel(m, 32.0)
            set_mario_action(m, ACT_FLYING, 1)
        if (((m.actionTimer = (m.actionTimer + 1)) == 10) && (m.area.camera.mode != CAMERA_MODE_BEHIND_MARIO)):
            set_camera_mode(m.area.camera, CAMERA_MODE_BEHIND_MARIO, 1)
        update_air_without_turn(m)
        return FALSE

    fn act_top_of_pole_jump(m: MarioState) -> Int:
        play_mario_jump_sound(m)
        common_air_action_step(m, ACT_FREEFALL_LAND, MARIO_ANIM_HANDSTAND_JUMP, AIR_STEP_CHECK_LEDGE_GRAB)
        return FALSE

    fn act_vertical_wind(m: MarioState) -> Int:
        let mut intendedDYaw: Int = (m.intendedYaw - m.faceAngle[1])
        let mut intendedMag: Float = (m.intendedMag / 32.0)
        play_sound_if_no_flag(m, SOUND_MARIO_HERE_WE_GO, MARIO_MARIO_SOUND_PLAYED)
        if (m.actionState == 0):
            set_mario_animation(m, MARIO_ANIM_FORWARD_SPINNING_FLIP)
            if (m.marioObj.header.gfx.animInfo.animFrame == 1):
                play_sound(SOUND_ACTION_SPIN, m.marioObj.header.gfx.cameraToObject)
            if is_anim_past_end(m):
                (m.actionState = 1)
        else:
            set_mario_animation(m, MARIO_ANIM_AIRBORNE_ON_STOMACH)
        update_air_without_turn(m)
        (m.marioObj.header.gfx.angle[0] = (((6144.0 * intendedMag) * coss(intendedDYaw)) as Int))
        (m.marioObj.header.gfx.angle[2] = ((((-4096.0) * intendedMag) * sins(intendedDYaw)) as Int))
        return FALSE

    fn act_special_triple_jump(m: MarioState) -> Int:
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_DIVE, 0)
        if (m.input & INPUT_Z_PRESSED):
            return set_mario_action(m, ACT_GROUND_POUND, 0)
        play_mario_sound(m, SOUND_ACTION_TERRAIN_JUMP, SOUND_MARIO_YAHOO)
        update_air_without_turn(m)
        if ((m.actionState == 0) || (m.vel[1] > 0.0)):
            if (set_mario_animation(m, MARIO_ANIM_FORWARD_SPINNING) == 0):
                play_sound(SOUND_ACTION_SPIN, m.marioObj.header.gfx.cameraToObject)
        else:
            set_mario_animation(m, MARIO_ANIM_GENERAL_FALL)
        (m.particleFlags = (m.particleFlags | PARTICLE_SPARKLES))
        return FALSE

    fn check_common_airborne_cancels(m: MarioState) -> Int:
        if (m.pos[1] < (m.waterLevel - 100)):
            return set_water_plunge_action(m)
        if (m.input & INPUT_SQUISHED):
            return drop_and_set_mario_action(m, ACT_SQUISHED, 0)
        if ((m.floor.type_ == SURFACE_VERTICAL_WIND) && (m.action & ACT_FLAG_ALLOW_VERTICAL_WIND_ACTION)):
            return drop_and_set_mario_action(m, ACT_VERTICAL_WIND, 0)
        (m.quicksandDepth = 0.0)
        return FALSE

    fn mario_execute_airborne_action(m: MarioState) -> Int:
        let mut cancel: Int = none
        if check_common_airborne_cancels(m):
            return TRUE
        play_far_fall_sound(m)
        return cancel


mod src_game_mario_actions_object:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    fn animated_stationary_ground_step(m: MarioState, animation: Int, endAction: Int) -> ():
        stationary_ground_step(m)
        set_mario_animation(m, animation)
        if is_anim_at_end(m):
            set_mario_action(m, endAction, 0)

    fn mario_update_punch_sequence(m: MarioState) -> Int:
        let mut endAction: Int = none
        let mut crouchEndAction: Int = none
        let mut animFrame: Int = none
        if (m.action & ACT_FLAG_MOVING):
            (crouchEndAction = ACT_CROUCH_SLIDE)
        else:
            (crouchEndAction = ACT_CROUCHING)
        return FALSE

    fn act_punching(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & (((INPUT_NONZERO_ANALOG | INPUT_A_PRESSED) | INPUT_OFF_FLOOR) | INPUT_ABOVE_SLIDE)):
            return check_common_action_exits(m)
        if ((m.actionState == 0) && (m.input & INPUT_A_DOWN)):
            return set_mario_action(m, ACT_JUMP_KICK, 0)
        (m.actionState = 1)
        if (m.actionArg == 0):
            (m.actionTimer = 7)
        mario_set_forward_vel(m, sPunchingForwardVelocities[m.actionTimer])
        if (m.actionTimer > 0):
            (m.actionTimer = (m.actionTimer - 1))
        mario_update_punch_sequence(m)
        perform_ground_step(m)
        return FALSE

    fn act_picking_up(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return drop_and_set_mario_action(m, ACT_FREEFALL, 0)
        if ((m.actionState == 0) && is_anim_at_end(m)):
            mario_grab_used_object(m)
            play_sound_if_no_flag(m, SOUND_MARIO_HRMM, MARIO_MARIO_SOUND_PLAYED)
            (m.actionState = 1)
        if (m.actionState == 1):
            if (m.heldObj.oInteractionSubtype & INT_SUBTYPE_GRABS_MARIO):
                (m.marioBodyState.grabPos = GRAB_POS_HEAVY_OBJ)
                set_mario_animation(m, MARIO_ANIM_GRAB_HEAVY_OBJECT)
                if is_anim_at_end(m):
                    set_mario_action(m, ACT_HOLD_HEAVY_IDLE, 0)
            else:
                (m.marioBodyState.grabPos = GRAB_POS_LIGHT_OBJ)
                set_mario_animation(m, MARIO_ANIM_PICK_UP_LIGHT_OBJ)
                if is_anim_at_end(m):
                    set_mario_action(m, ACT_HOLD_IDLE, 0)
        stationary_ground_step(m)
        return FALSE

    fn act_dive_picking_up(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return set_mario_action(m, ACT_BEGIN_SLIDING, 0)
        animated_stationary_ground_step(m, MARIO_ANIM_STOP_SLIDE_LIGHT_OBJ, ACT_HOLD_IDLE)
        return FALSE

    fn act_placing_down(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return drop_and_set_mario_action(m, ACT_FREEFALL, 0)
        if ((m.actionTimer = (m.actionTimer + 1)) == 8):
            mario_drop_held_object(m)
        animated_stationary_ground_step(m, MARIO_ANIM_PLACE_LIGHT_OBJ, ACT_IDLE)
        return FALSE

    fn act_throwing(m: MarioState) -> Int:
        if (m.heldObj && (m.heldObj.oInteractionSubtype & INT_SUBTYPE_HOLDABLE_NPC)):
            return set_mario_action(m, ACT_PLACING_DOWN, 0)
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return drop_and_set_mario_action(m, ACT_FREEFALL, 0)
        if ((m.actionTimer = (m.actionTimer + 1)) == 7):
            mario_throw_held_object(m)
            play_sound_if_no_flag(m, SOUND_MARIO_WAH2, MARIO_MARIO_SOUND_PLAYED)
            play_sound_if_no_flag(m, SOUND_ACTION_THROW, MARIO_ACTION_SOUND_PLAYED)
        animated_stationary_ground_step(m, MARIO_ANIM_GROUND_THROW, ACT_IDLE)
        return FALSE

    fn act_heavy_throw(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return drop_and_set_mario_action(m, ACT_FREEFALL, 0)
        if ((m.actionTimer = (m.actionTimer + 1)) == 13):
            mario_drop_held_object(m)
            play_sound_if_no_flag(m, SOUND_MARIO_WAH2, MARIO_MARIO_SOUND_PLAYED)
            play_sound_if_no_flag(m, SOUND_ACTION_THROW, MARIO_ACTION_SOUND_PLAYED)
        animated_stationary_ground_step(m, MARIO_ANIM_HEAVY_THROW, ACT_IDLE)
        return FALSE

    fn act_stomach_slide_stop(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return set_mario_action(m, ACT_BEGIN_SLIDING, 0)
        animated_stationary_ground_step(m, MARIO_ANIM_SLOW_LAND_FROM_DIVE, ACT_IDLE)
        return FALSE

    fn act_picking_up_bowser(m: MarioState) -> Int:
        if (m.actionState == 0):
            (m.actionState = 1)
            (m.angleVel[1] = 0)
            (m.marioBodyState.grabPos = GRAB_POS_BOWSER)
            mario_grab_used_object(m)
            play_sound(SOUND_MARIO_HRMM, m.marioObj.header.gfx.cameraToObject)
        set_mario_animation(m, MARIO_ANIM_GRAB_BOWSER)
        if is_anim_at_end(m):
            set_mario_action(m, ACT_HOLDING_BOWSER, 0)
        stationary_ground_step(m)
        return FALSE

    fn act_holding_bowser(m: MarioState) -> Int:
        let mut spin: Int = none
        if (m.input & INPUT_B_PRESSED):
            if ((m.angleVel[1] <= (-0)) || (m.angleVel[1] >= 0)):
                play_sound(SOUND_MARIO_SO_LONGA_BOWSER, m.marioObj.header.gfx.cameraToObject)
            else:
                play_sound(SOUND_MARIO_HERE_WE_GO, m.marioObj.header.gfx.cameraToObject)
            return set_mario_action(m, ACT_RELEASING_BOWSER, 0)
        if (m.angleVel[1] == 0):
            if ((m.actionTimer = (m.actionTimer + 1)) > 120):
                return set_mario_action(m, ACT_RELEASING_BOWSER, 1)
            set_mario_animation(m, MARIO_ANIM_HOLDING_BOWSER)
        else:
            (m.actionTimer = 0)
            set_mario_animation(m, MARIO_ANIM_SWINGING_BOWSER)
        if (m.intendedMag > 20.0):
            if (m.actionArg == 0):
                (m.actionArg = 1)
                (m.twirlYaw = m.intendedYaw)
            else:
                (spin = (((m.intendedYaw - m.twirlYaw) as Int) / 80))
                if (spin < (-80)):
                    (spin = (-80))
                if (spin > 80):
                    (spin = 80)
                (m.twirlYaw = m.intendedYaw)
                (m.angleVel[1] = (m.angleVel[1] + spin))
                if (m.angleVel[1] > 1000):
                    (m.angleVel[1] = 1000)
                if (m.angleVel[1] < (-1000)):
                    (m.angleVel[1] = (-1000))
        else:
            (m.actionArg = 0)
            (m.angleVel[1] = approach_s32(m.angleVel[1], 0, 64, 64))
        (spin = m.faceAngle[1])
        (m.faceAngle[1] = (m.faceAngle[1] + m.angleVel[1]))
        if ((m.angleVel[1] <= (-100)) && (spin < m.faceAngle[1])):
            play_sound(SOUND_OBJ_BOWSER_SPINNING, m.marioObj.header.gfx.cameraToObject)
        if ((m.angleVel[1] >= 100) && (spin > m.faceAngle[1])):
            play_sound(SOUND_OBJ_BOWSER_SPINNING, m.marioObj.header.gfx.cameraToObject)
        stationary_ground_step(m)
        if (m.angleVel[1] >= 0):
            (m.marioObj.header.gfx.angle[0] = (-m.angleVel[1]))
        else:
            (m.marioObj.header.gfx.angle[0] = m.angleVel[1])
        return FALSE

    fn act_releasing_bowser(m: MarioState) -> Int:
        if ((m.actionTimer = (m.actionTimer + 1)) == 1):
            if (m.actionArg == 0):
                mario_throw_held_object(m)
            else:
                mario_drop_held_object(m)
        (m.angleVel[1] = 0)
        animated_stationary_ground_step(m, MARIO_ANIM_RELEASE_BOWSER, ACT_IDLE)
        return FALSE

    fn check_common_object_cancels(m: MarioState) -> Int:
        let mut waterSurface: Float = (m.waterLevel - 100)
        if (m.pos[1] < waterSurface):
            return set_water_plunge_action(m)
        if (m.input & INPUT_SQUISHED):
            return drop_and_set_mario_action(m, ACT_SQUISHED, 0)
        if (m.health < 100):
            return drop_and_set_mario_action(m, ACT_STANDING_DEATH, 0)
        return FALSE

    fn mario_execute_object_action(m: MarioState) -> Int:
        let mut cancel: Int = none
        if check_common_object_cancels(m):
            return TRUE
        if mario_update_quicksand(m, 0.5):
            return TRUE
        if ((!cancel) && (m.input & INPUT_IN_WATER)):
            (m.particleFlags = (m.particleFlags | PARTICLE_IDLE_WATER_WAVE))
        return cancel


mod src_game_mario_actions_stationary:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    fn check_common_idle_cancels(m: MarioState) -> Int:
        mario_drop_held_object(m)
        if (m.floor.normal.y < 0.29237169):
            return mario_push_off_steep_floor(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_A_PRESSED):
            return set_jumping_action(m, ACT_JUMP, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return set_mario_action(m, ACT_BEGIN_SLIDING, 0)
        if (m.input & INPUT_FIRST_PERSON):
            return set_mario_action(m, ACT_FIRST_PERSON, 0)
        if (m.input & INPUT_NONZERO_ANALOG):
            (m.faceAngle[1] = (m.intendedYaw as Int))
            return set_mario_action(m, ACT_WALKING, 0)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_PUNCHING, 0)
        if (m.input & INPUT_Z_DOWN):
            return set_mario_action(m, ACT_START_CROUCHING, 0)
        return FALSE

    fn check_common_hold_idle_cancels(m: MarioState) -> Int:
        if (m.floor.normal.y < 0.29237169):
            return mario_push_off_steep_floor(m, ACT_HOLD_FREEFALL, 0)
        if (m.heldObj.oInteractionSubtype & INT_SUBTYPE_DROP_IMMEDIATELY):
            (m.heldObj.oInteractionSubtype = ((m.heldObj.oInteractionSubtype & (~INT_SUBTYPE_DROP_IMMEDIATELY)) as Int))
            return set_mario_action(m, ACT_PLACING_DOWN, 0)
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_A_PRESSED):
            return set_jumping_action(m, ACT_HOLD_JUMP, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_HOLD_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return set_mario_action(m, ACT_HOLD_BEGIN_SLIDING, 0)
        if (m.input & INPUT_NONZERO_ANALOG):
            (m.faceAngle[1] = (m.intendedYaw as Int))
            return set_mario_action(m, ACT_HOLD_WALKING, 0)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_THROWING, 0)
        if (m.input & INPUT_Z_DOWN):
            return drop_and_set_mario_action(m, ACT_START_CROUCHING, 0)
        return FALSE

    fn act_idle(m: MarioState) -> Int:
        if (m.quicksandDepth > 30.0):
            return set_mario_action(m, ACT_IN_QUICKSAND, 0)
        if (m.input & INPUT_IN_POISON_GAS):
            return set_mario_action(m, ACT_COUGHING, 0)
        if ((!(m.actionArg & 1)) && (m.health < 300)):
            return set_mario_action(m, ACT_PANTING, 0)
        if check_common_idle_cancels(m):
            return TRUE
        if (m.actionState == 3):
            if ((m.area.terrainType & TERRAIN_MASK) == TERRAIN_SNOW):
                return set_mario_action(m, ACT_SHIVERING, 0)
            else:
                return set_mario_action(m, ACT_START_SLEEPING, 0)
        if (m.actionArg & 1):
            set_mario_animation(m, MARIO_ANIM_STAND_AGAINST_WALL)
        else:
            if is_anim_at_end(m):
                if ((m.actionState = (m.actionState + 1)) == 3):
                    let mut deltaYOfFloorBehindMario: Float = (m.pos[1] - find_floor_height_relative_polar(m, (-8000), 60.0))
                    if (((deltaYOfFloorBehindMario < (-24.0)) || (24.0 < deltaYOfFloorBehindMario)) || (m.floor.flags & SURFACE_FLAG_DYNAMIC)):
                        (m.actionState = 0)
                    else:
                        (m.actionTimer = (m.actionTimer + 1))
                        if (m.actionTimer < 10):
                            (m.actionState = 0)
        stationary_ground_step(m)
        return FALSE

    fn play_anim_sound(m: MarioState, actionState: Int, animFrame: Int, sound: Int) -> ():
        if ((m.actionState == actionState) && (m.marioObj.header.gfx.animInfo.animFrame == animFrame)):
            play_sound(sound, m.marioObj.header.gfx.cameraToObject)

    fn act_start_sleeping(m: MarioState) -> Int:
        let mut animFrame: Int = none
        if check_common_idle_cancels(m):
            return TRUE
        if (m.quicksandDepth > 30.0):
            return set_mario_action(m, ACT_IN_QUICKSAND, 0)
        if (m.actionState == 4):
            return set_mario_action(m, ACT_SLEEPING, 0)
        play_anim_sound(m, 1, 41, SOUND_ACTION_PAT_BACK)
        play_anim_sound(m, 1, 49, SOUND_ACTION_PAT_BACK)
        play_anim_sound(m, 3, 15, (m.terrainSoundAddend + SOUND_ACTION_TERRAIN_BODY_HIT_GROUND))
        if is_anim_at_end(m):
            (m.actionState = (m.actionState + 1))
        if ((m.actionState == 2) && (animFrame == (-1))):
            play_sound(SOUND_MARIO_YAWNING, m.marioObj.header.gfx.cameraToObject)
        if ((m.actionState == 1) && (animFrame == (-1))):
            play_sound(SOUND_MARIO_IMA_TIRED, m.marioObj.header.gfx.cameraToObject)
        stationary_ground_step(m)
        return FALSE

    fn act_sleeping(m: MarioState) -> Int:
        let mut animFrame: Int = none
        if (m.input & (((((((INPUT_NONZERO_ANALOG | INPUT_A_PRESSED) | INPUT_OFF_FLOOR) | INPUT_ABOVE_SLIDE) | INPUT_FIRST_PERSON) | INPUT_STOMPED) | INPUT_B_PRESSED) | INPUT_Z_PRESSED)):
            return set_mario_action(m, ACT_WAKING_UP, m.actionState)
        if (m.quicksandDepth > 30.0):
            return set_mario_action(m, ACT_WAKING_UP, m.actionState)
        if ((m.pos[1] - find_floor_height_relative_polar(m, (-8000), 60.0)) > 24.0):
            return set_mario_action(m, ACT_WAKING_UP, m.actionState)
        (m.marioBodyState.eyeState = MARIO_EYES_CLOSED)
        stationary_ground_step(m)
        return FALSE

    fn act_waking_up(m: MarioState) -> Int:
        if (!m.actionTimer):
            stop_sound(SOUND_MARIO_SNORING1, m.marioObj.header.gfx.cameraToObject)
            stop_sound(SOUND_MARIO_SNORING2, m.marioObj.header.gfx.cameraToObject)
            stop_sound(SOUND_MARIO_SNORING3, m.marioObj.header.gfx.cameraToObject)
            raise_background_noise(2)
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return set_mario_action(m, ACT_BEGIN_SLIDING, 0)
        (m.actionTimer = (m.actionTimer + 1))
        if (m.actionTimer > 20):
            return set_mario_action(m, ACT_IDLE, 0)
        stationary_ground_step(m)
        set_mario_animation(m, if (!m.actionArg): MARIO_ANIM_WAKE_FROM_SLEEP else: MARIO_ANIM_WAKE_FROM_LYING)
        return FALSE

    fn act_shivering(m: MarioState) -> Int:
        let mut animFrame: Int = none
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return set_mario_action(m, ACT_BEGIN_SLIDING, 0)
        if (m.input & (((((((INPUT_NONZERO_ANALOG | INPUT_A_PRESSED) | INPUT_OFF_FLOOR) | INPUT_ABOVE_SLIDE) | INPUT_FIRST_PERSON) | INPUT_STOMPED) | INPUT_B_PRESSED) | INPUT_Z_PRESSED)):
            (m.actionState = 2)
        stationary_ground_step(m)
        return FALSE

    fn act_coughing(m: MarioState) -> Int:
        let mut animFrame: Int = none
        if check_common_idle_cancels(m):
            return TRUE
        stationary_ground_step(m)
        (animFrame = set_mario_animation(m, MARIO_ANIM_COUGHING))
        if ((animFrame == 25) || (animFrame == 35)):
            play_sound(SOUND_MARIO_COUGHING3, m.marioObj.header.gfx.cameraToObject)
        if ((animFrame == 50) || (animFrame == 58)):
            play_sound(SOUND_MARIO_COUGHING2, m.marioObj.header.gfx.cameraToObject)
        if ((animFrame == 71) || (animFrame == 80)):
            play_sound(SOUND_MARIO_COUGHING1, m.marioObj.header.gfx.cameraToObject)
        return FALSE

    fn act_hold_idle(m: MarioState) -> Int:
        if (segmented_to_virtual((&bhvJumpingBox)) == m.heldObj.behavior):
            return set_mario_action(m, ACT_CRAZY_BOX_BOUNCE, 0)
        if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_DROP_OBJECT):
            return drop_and_set_mario_action(m, ACT_IDLE, 0)
        if (m.quicksandDepth > 30.0):
            return drop_and_set_mario_action(m, ACT_IN_QUICKSAND, 0)
        if check_common_hold_idle_cancels(m):
            return TRUE
        stationary_ground_step(m)
        set_mario_animation(m, MARIO_ANIM_IDLE_WITH_LIGHT_OBJ)
        return FALSE

    fn act_hold_heavy_idle(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return drop_and_set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return drop_and_set_mario_action(m, ACT_BEGIN_SLIDING, 0)
        if (m.input & INPUT_NONZERO_ANALOG):
            return set_mario_action(m, ACT_HOLD_HEAVY_WALKING, 0)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_HEAVY_THROW, 0)
        stationary_ground_step(m)
        set_mario_animation(m, MARIO_ANIM_IDLE_HEAVY_OBJ)
        return FALSE

    fn act_standing_against_wall(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & (((INPUT_NONZERO_ANALOG | INPUT_A_PRESSED) | INPUT_OFF_FLOOR) | INPUT_ABOVE_SLIDE)):
            return check_common_action_exits(m)
        if (m.input & INPUT_FIRST_PERSON):
            return set_mario_action(m, ACT_FIRST_PERSON, 0)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_PUNCHING, 0)
        set_mario_animation(m, MARIO_ANIM_STAND_AGAINST_WALL)
        stationary_ground_step(m)
        return FALSE

    fn act_in_quicksand(m: MarioState) -> Int:
        if (m.quicksandDepth < 30.0):
            return set_mario_action(m, ACT_IDLE, 0)
        if check_common_idle_cancels(m):
            return TRUE
        if (m.quicksandDepth > 70.0):
            set_mario_animation(m, MARIO_ANIM_DYING_IN_QUICKSAND)
        else:
            set_mario_animation(m, MARIO_ANIM_IDLE_IN_QUICKSAND)
        stationary_ground_step(m)
        return FALSE

    fn act_crouching(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_A_PRESSED):
            return set_jumping_action(m, ACT_BACKFLIP, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return set_mario_action(m, ACT_BEGIN_SLIDING, 0)
        if (m.input & INPUT_FIRST_PERSON):
            return set_mario_action(m, ACT_STOP_CROUCHING, 0)
        if (!(m.input & INPUT_Z_DOWN)):
            return set_mario_action(m, ACT_STOP_CROUCHING, 0)
        if (m.input & INPUT_NONZERO_ANALOG):
            return set_mario_action(m, ACT_START_CRAWLING, 0)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_PUNCHING, 9)
        stationary_ground_step(m)
        set_mario_animation(m, MARIO_ANIM_CROUCHING)
        return FALSE

    fn act_panting(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.health >= 500):
            return set_mario_action(m, ACT_IDLE, 0)
        if check_common_idle_cancels(m):
            return TRUE
        if (set_mario_animation(m, MARIO_ANIM_WALK_PANTING) == 1):
            play_sound((SOUND_MARIO_PANTING + ((gAudioRandom % 3) << 10)), m.marioObj.header.gfx.cameraToObject)
        stationary_ground_step(m)
        (m.marioBodyState.eyeState = MARIO_EYES_HALF_CLOSED)
        return FALSE

    fn act_hold_panting_unused(m: MarioState) -> Int:
        if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_DROP_OBJECT):
            return drop_and_set_mario_action(m, ACT_PANTING, 0)
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.health >= 500):
            return set_mario_action(m, ACT_HOLD_IDLE, 0)
        if check_common_hold_idle_cancels(m):
            return TRUE
        set_mario_animation(m, MARIO_ANIM_WALK_PANTING)
        stationary_ground_step(m)
        (m.marioBodyState.eyeState = MARIO_EYES_HALF_CLOSED)
        return FALSE

    fn stopping_step(m: MarioState, animID: Int, action: Int) -> ():
        stationary_ground_step(m)
        set_mario_animation(m, animID)
        if is_anim_at_end(m):
            set_mario_action(m, action, 0)

    fn act_braking_stop(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_PUNCHING, 0)
        if ((!(m.input & INPUT_FIRST_PERSON)) && (m.input & (((INPUT_NONZERO_ANALOG | INPUT_A_PRESSED) | INPUT_OFF_FLOOR) | INPUT_ABOVE_SLIDE))):
            return check_common_action_exits(m)
        stopping_step(m, MARIO_ANIM_STOP_SKID, ACT_IDLE)
