mod tools_patch_elf_32bit:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    struct ar_header:
        identifier: Char
        file_modification_timestamp: Char
        owner_id: Char
        group_id: Char
        file_mode: Char
        file_size_in_bytes: Char
        ending: Char

    fn fix_mips_elf(f: FILE, filesize: Int) -> Int:
        let mut hdr: Elf32_Ehdr = none
        if ((filesize < 8) || (1 != fread((&hdr), 8, 1, f))):
            printf("\"Failed to read ELF header\\n\"")
            return (-1)
        if (strncmp((hdr.e_ident as Char), ELFMAG, SELFMAG) == 0):
            if ((hdr.e_ident[EI_CLASS] != ELFCLASS32) || (hdr.e_ident[EI_DATA] != ELFDATA2MSB)):
                printf("\"Expected 32bit big endian object files\\n\"")
                return (-1)
            if (((hdr.e_flags & 0) == FLAGS_MIPS3) && ((hdr.e_flags & FLAGS_O32ABI) == 0)):
                (hdr.e_flags = (hdr.e_flags | FLAGS_O32ABI))
                fseek(f, (-(8 as Int)), SEEK_CUR)
                if (1 != fwrite((&hdr), 8, 1, f)):
                    printf("\"Failed to write back ELF header after patching.\\n\"")
                    return (-1)
        return 0

    fn fix_mips_ar(f: FILE) -> Int:
        let mut current_header: ar_header = none
        fseek(f, 8, SEEK_SET)
        while (1 == fread((&current_header), 8, 1, f)):
            if ((current_header.ending[0] != 60) && (current_header.ending[1] != 0)):
                printf("\"Expected file header\\n\"")
                return (-1)
            let mut filesize: Int = atoi(current_header.file_size_in_bytes)
            if fix_mips_elf(f, filesize):
                return (-1)
            if ((filesize % 2) == 1):
                (filesize = (filesize + 1))
            fseek(f, (filesize - 8), SEEK_CUR)
        return 0

    fn main(argc: Int, argv: Char) -> Int:
        let mut f: FILE = fopen(argv[1], "\"r+b\"")
        let mut magic: Int = none
        let mut status: Int = 0
        if (f == NULL):
            printf("\"Failed to open file! %s\\n\"", argv[1])
            return (-1)
        if (1 != fread((&magic), 8, 1, f)):
            printf("\"Failed to read file magic\\n\"")
            return (-1)
        rewind(f)
        if (!memcmp(ARMAG, magic, SARMAG)):
            (status = fix_mips_ar(f))
        else:
            if (!memcmp(ELFMAG, magic, SELFMAG)):
                fseek(f, 0, SEEK_END)
                let mut filesize: Int = ftell(f)
                rewind(f)
                (status = fix_mips_elf(f, filesize))
            else:
                printf("\"Unknown file magic: %02x%02x%02X%02X\\n\"", magic[0], magic[1], magic[2], magic[3])
                (status = (-1))
        fclose(f)
        return status


