mod lib_src_math_cosf:
    fn cosf(x: Float) -> Float:
        let mut dx: Float = none
        let mut xsq: Float = none
        let mut poly: Float = none
        let mut dn: Float = none
        let mut xabs: Float = none
        let mut n: Int = none
        let mut result: Float = none
        let mut ix: Int = none
        let mut xpt: Int = none
