    fn calc_dist_to_volume_range_1(distance: Float) -> Int:
        let mut volume: Int = none
        if (distance < 500.0):
            (volume = 127)
        else:
            if (1500.0 < distance):
                (volume = 0)
            else:
                (volume = ((((distance - 500.0) / 1000.0) * 64.0) + 60.0))
        return volume

    fn calc_dist_to_volume_range_2(distance: Float) -> Int:
        let mut volume: Int = none
        if (distance < 1300.0):
            (volume = 127)
        else:
            if (2300.0 < distance):
                (volume = 0)
            else:
                (volume = ((((distance - 1000.0) / 1000.0) * 64.0) + 60.0))
        return volume


