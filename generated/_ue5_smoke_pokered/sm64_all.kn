                (o.oAngleVelYaw = 400)
                (o.oSpinningHeartTotalSpin = 0)
        if ((o.oSpinningHeartTotalSpin = (o.oSpinningHeartTotalSpin + o.oAngleVelYaw)) >= 10000):
            (gMarioStates[0].healCounter = (gMarioStates[0].healCounter + 4))
            (o.oSpinningHeartTotalSpin = (o.oSpinningHeartTotalSpin - 10000))
        (o.oFaceAngleYaw = (o.oFaceAngleYaw + o.oAngleVelYaw))


