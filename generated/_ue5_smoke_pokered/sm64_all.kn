    fn mad_piano_act_wait(param_0: ()) -> ():
        cur_obj_init_animation_with_sound(0)
        if (o.oDistanceToMario < 500.0):
            if ((o.oTimer > 20) && (gMarioStates[0].forwardVel > 10.0)):
                (o.oAction = MAD_PIANO_ACT_ATTACK)
                cur_obj_become_tangible()
        else:
            (o.oTimer = 0)
        cur_obj_push_mario_away_from_cylinder(280.0, 150.0)

    fn mad_piano_act_attack(param_0: ()) -> ():
        cur_obj_update_floor_and_walls()
        cur_obj_init_animation_with_sound(1)
        cur_obj_play_sound_at_anim_range(0, 0, SOUND_OBJ_MAD_PIANO_CHOMPING)
        if (o.oDistanceToMario < 500.0):
            (o.oTimer = 0)
        if ((o.oTimer > 80) && cur_obj_check_if_near_animation_end()):
            (o.oAction = MAD_PIANO_ACT_WAIT)
            (o.oForwardVel = 0.0)
            cur_obj_become_intangible()
        else:
            let mut dx: Float = (o.oPosX - o.oHomeX)
            let mut dz: Float = (o.oPosZ - o.oHomeZ)
            let mut distToHome: Float = sqrtf(((dx * dx) + (dz * dz)))
            if (distToHome > 400.0):
                (distToHome = (400.0 / distToHome))
                (o.oPosX = (o.oHomeX + (dx * distToHome)))
                (o.oPosZ = (o.oHomeZ + (dz * distToHome)))
            cur_obj_rotate_yaw_toward(o.oAngleToMario, 400)
            (o.oForwardVel = 5.0)
        obj_check_attacks((&sMadPianoHitbox), o.oAction)
        cur_obj_move_standard(78)

