    fn debug_print_obj_collision(a: Object) -> Object:
        let mut sp24: Object = none
        let mut filler: Int = none
        let mut i: Int = none
        (i = 0)
        while (i < a.numCollidedObjs):
            print_debug_top_down_objectinfo("\"ON\"", 0)
            (sp24 = a.collidedObjs[i])
            if (sp24 != gMarioObject):
                return sp24
            (i = (i + 1))
        return NULL

    fn detect_object_hitbox_overlap(a: Object, b: Object) -> Int:
        let mut sp3C: Float = (a.oPosY - a.hitboxDownOffset)
        let mut sp38: Float = (b.oPosY - b.hitboxDownOffset)
        let mut dx: Float = (a.oPosX - b.oPosX)
        let mut sp30: Float = (sp3C - sp38)
        let mut dz: Float = (a.oPosZ - b.oPosZ)
        let mut collisionRadius: Float = (a.hitboxRadius + b.hitboxRadius)
        let mut distance: Float = sqrtf(((dx * dx) + (dz * dz)))
        if (collisionRadius > distance):
            let mut sp20: Float = (a.hitboxHeight + sp3C)
            let mut sp1C: Float = (b.hitboxHeight + sp38)
            if (sp3C > sp1C):
                return 0
            if (sp20 < sp38):
                return 0
            if (a.numCollidedObjs >= 4):
                return 0
            if (b.numCollidedObjs >= 4):
                return 0
            (a.collidedObjs[a.numCollidedObjs] = b)
            (b.collidedObjs[b.numCollidedObjs] = a)
            (a.collidedObjInteractTypes = (a.collidedObjInteractTypes | b.oInteractType))
            (b.collidedObjInteractTypes = (b.collidedObjInteractTypes | a.oInteractType))
            (a.numCollidedObjs = (a.numCollidedObjs + 1))
            (b.numCollidedObjs = (b.numCollidedObjs + 1))
            return 1

    fn detect_object_hurtbox_overlap(a: Object, b: Object) -> Int:
        let mut sp3C: Float = (a.oPosY - a.hitboxDownOffset)
        let mut sp38: Float = (b.oPosY - b.hitboxDownOffset)
        let mut sp34: Float = (a.oPosX - b.oPosX)
        let mut sp30: Float = (sp3C - sp38)
        let mut sp2C: Float = (a.oPosZ - b.oPosZ)
        let mut sp28: Float = (a.hurtboxRadius + b.hurtboxRadius)
        let mut sp24: Float = sqrtf(((sp34 * sp34) + (sp2C * sp2C)))
        if (a == gMarioObject):
            (b.oInteractionSubtype = (b.oInteractionSubtype | INT_SUBTYPE_DELAY_INVINCIBILITY))
        if (sp28 > sp24):
            let mut sp20: Float = (a.hitboxHeight + sp3C)
            let mut sp1C: Float = (b.hurtboxHeight + sp38)
            if (sp3C > sp1C):
                return 0
            if (sp20 < sp38):
                return 0
            if (a == gMarioObject):
                (b.oInteractionSubtype = (b.oInteractionSubtype & (~INT_SUBTYPE_DELAY_INVINCIBILITY)))
            return 1

    fn clear_object_collision(a: Object) -> ():
        let mut sp4: Object = (a.header.next as Object)
        while (sp4 != a):
            (sp4.numCollidedObjs = 0)
            (sp4.collidedObjInteractTypes = 0)
            if (sp4.oIntangibleTimer > 0):
                (sp4.oIntangibleTimer = (sp4.oIntangibleTimer - 1))
            (sp4 = (sp4.header.next as Object))

    fn check_collision_in_list(a: Object, b: Object, c: Object) -> ():
        if (a.oIntangibleTimer == 0):
            while (b != c):
                if (b.oIntangibleTimer == 0):
                    if (detect_object_hitbox_overlap(a, b) && (b.hurtboxRadius != 0.0)):
                        detect_object_hurtbox_overlap(a, b)
                (b = (b.header.next as Object))

    fn check_player_object_collision(param_0: ()) -> ():
        let mut sp1C: Object = ((&gObjectLists[OBJ_LIST_PLAYER]) as Object)
        let mut sp18: Object = (sp1C.header.next as Object)
        while (sp18 != sp1C):
            check_collision_in_list(sp18, (sp18.header.next as Object), sp1C)
            check_collision_in_list(sp18, (gObjectLists[OBJ_LIST_POLELIKE].next as Object), ((&gObjectLists[OBJ_LIST_POLELIKE]) as Object))
            check_collision_in_list(sp18, (gObjectLists[OBJ_LIST_LEVEL].next as Object), ((&gObjectLists[OBJ_LIST_LEVEL]) as Object))
            check_collision_in_list(sp18, (gObjectLists[OBJ_LIST_GENACTOR].next as Object), ((&gObjectLists[OBJ_LIST_GENACTOR]) as Object))
            check_collision_in_list(sp18, (gObjectLists[OBJ_LIST_PUSHABLE].next as Object), ((&gObjectLists[OBJ_LIST_PUSHABLE]) as Object))
            check_collision_in_list(sp18, (gObjectLists[OBJ_LIST_SURFACE].next as Object), ((&gObjectLists[OBJ_LIST_SURFACE]) as Object))
            check_collision_in_list(sp18, (gObjectLists[OBJ_LIST_DESTRUCTIVE].next as Object), ((&gObjectLists[OBJ_LIST_DESTRUCTIVE]) as Object))
            (sp18 = (sp18.header.next as Object))

    fn check_pushable_object_collision(param_0: ()) -> ():
        let mut sp1C: Object = ((&gObjectLists[OBJ_LIST_PUSHABLE]) as Object)
        let mut sp18: Object = (sp1C.header.next as Object)
        while (sp18 != sp1C):
            check_collision_in_list(sp18, (sp18.header.next as Object), sp1C)
            (sp18 = (sp18.header.next as Object))

    fn check_destructive_object_collision(param_0: ()) -> ():
        let mut sp1C: Object = ((&gObjectLists[OBJ_LIST_DESTRUCTIVE]) as Object)
        let mut sp18: Object = (sp1C.header.next as Object)
        while (sp18 != sp1C):
            if ((sp18.oDistanceToMario < 2000.0) && (!(sp18.activeFlags & ACTIVE_FLAG_UNK9))):
                check_collision_in_list(sp18, (sp18.header.next as Object), sp1C)
                check_collision_in_list(sp18, (gObjectLists[OBJ_LIST_GENACTOR].next as Object), ((&gObjectLists[OBJ_LIST_GENACTOR]) as Object))
                check_collision_in_list(sp18, (gObjectLists[OBJ_LIST_PUSHABLE].next as Object), ((&gObjectLists[OBJ_LIST_PUSHABLE]) as Object))
                check_collision_in_list(sp18, (gObjectLists[OBJ_LIST_SURFACE].next as Object), ((&gObjectLists[OBJ_LIST_SURFACE]) as Object))
            (sp18 = (sp18.header.next as Object))

    fn detect_object_collisions(param_0: ()) -> ():
        clear_object_collision(((&gObjectLists[OBJ_LIST_POLELIKE]) as Object))
        clear_object_collision(((&gObjectLists[OBJ_LIST_PLAYER]) as Object))
        clear_object_collision(((&gObjectLists[OBJ_LIST_PUSHABLE]) as Object))
        clear_object_collision(((&gObjectLists[OBJ_LIST_GENACTOR]) as Object))
        clear_object_collision(((&gObjectLists[OBJ_LIST_LEVEL]) as Object))
        clear_object_collision(((&gObjectLists[OBJ_LIST_SURFACE]) as Object))
        clear_object_collision(((&gObjectLists[OBJ_LIST_DESTRUCTIVE]) as Object))
        check_player_object_collision()
        check_destructive_object_collision()
        check_pushable_object_collision()


