            (ret = ((*(state.pc = (state.pc + 1))) | ret))
        return ret

    fn get_instrument(seqChannel: SequenceChannel, instId: Int, instOut: Instrument, adsr: AdsrSettings) -> Int:
        let mut inst: Instrument = none
        let mut pad: Int = none
        if (instId >= gCtlEntries[seqChannel.bankId].numInstruments):
            (instId = gCtlEntries[seqChannel.bankId].numInstruments)
            if (instId == 0):
                return 0
            (instId = (instId - 1))
        (inst = gCtlEntries[seqChannel.bankId].instruments[instId])
        if (inst == NULL):
            let mut seqChannelCpy: SequenceChannel = (*seqChannel)
            while (instId != 0):
                (inst = gCtlEntries[seqChannelCpy.bankId].instruments[instId])
                if (inst != NULL):
                    break
                (instId = (instId - 1))
        if ((((gBankLoadedPool.persistent.pool.start as Int) <= (inst as Int)) && ((inst as Int) <= ((gBankLoadedPool.persistent.pool.start + gBankLoadedPool.persistent.pool.size) as Int))) || (((gBankLoadedPool.temporary.pool.start as Int) <= (inst as Int)) && ((inst as Int) <= ((gBankLoadedPool.temporary.pool.start + gBankLoadedPool.temporary.pool.size) as Int)))):
            (adsr.envelope = inst.envelope)
            (adsr.releaseRate = inst.releaseRate)
            ((*instOut) = inst)
            (instId = (instId + 1))
            return instId
        (gAudioErrorFlags = (instId + 20000))
        ((*instOut) = NULL)
        return 0

    fn set_instrument(seqChannel: SequenceChannel, instId: Int) -> ():
        if (instId >= 80):
