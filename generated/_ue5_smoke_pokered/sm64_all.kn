        let mut cV: Int = none
        let mut maxClip: Int = none
        let mut header: Int = none
        let mut c: Int = none
        let mut e: Float = none
        let mut se: Float = none
        let mut min: Float = none
        (i = nsam)
        while (i < 16):
            (inBuffer[i] = 0)
            (i = (i + 1))
        (llevel = (-8))
        (ulevel = ((-llevel) - 1))
        (min = 1000000000000000000000000000000.0)
        (optimalp = 0)
        (k = 0)
        while (k < npredictors):
            (i = 0)
            while (i < order):
                (inVector[i] = state[((16 - order) + i)])
                (i = (i + 1))
            (i = 0)
            while (i < 8):
                (prediction[i] = inner_product((order + i), coefTable[k][i], inVector))
                (inVector[(i + order)] = (inBuffer[i] - prediction[i]))
                (e[i] = (inVector[(i + order)] as Float))
                (i = (i + 1))
            (i = 0)
            while (i < order):
                (inVector[i] = (prediction[((8 - order) + i)] + inVector[(8 + i)]))
                (i = (i + 1))
            (i = 0)
            while (i < 8):
                (prediction[(8 + i)] = inner_product((order + i), coefTable[k][i], inVector))
                (inVector[(i + order)] = (inBuffer[(8 + i)] - prediction[(8 + i)]))
                (e[(8 + i)] = (inVector[(i + order)] as Float))
                (i = (i + 1))
            (se = 0.0)
            (j = 0)
            while (j < 16):
                (se = (se + (e[j] * e[j])))
                (j = (j + 1))
            if (se < min):
                (min = se)
                (optimalp = k)
            (k = (k + 1))
        (i = 0)
        while (i < order):
            (inVector[i] = state[((16 - order) + i)])
            (i = (i + 1))
        (i = 0)
        while (i < 8):
            (prediction[i] = inner_product((order + i), coefTable[optimalp][i], inVector))
            (inVector[(i + order)] = (inBuffer[i] - prediction[i]))
            (e[i] = (inVector[(i + order)] as Float))
            (i = (i + 1))
        (i = 0)
        while (i < order):
            (inVector[i] = (prediction[((8 - order) + i)] + inVector[(8 + i)]))
            (i = (i + 1))
        (i = 0)
        while (i < 8):
            (prediction[(8 + i)] = inner_product((order + i), coefTable[optimalp][i], inVector))
            (inVector[(i + order)] = (inBuffer[(8 + i)] - prediction[(8 + i)]))
            (e[(8 + i)] = (inVector[(i + order)] as Float))
            (i = (i + 1))
        clamp(16, e, ie, 16)
        (max = 0)
        (i = 0)
        while (i < 16):
            if (fabs(ie[i]) > fabs(max)):
                (max = ie[i])
            (i = (i + 1))
        (scale = 0)
        while (scale <= 12):
            if ((max <= ulevel) && (max >= llevel)):
                none
            (max = (max / 2))
            (scale = (scale + 1))
        (i = 0)
        while (i < 16):
            (saveState[i] = state[i])
            (i = (i + 1))
        (scale = (scale - 1))
        (nIter = 0)
        (header = ((scale << 4) | (optimalp & 0)))
        fwrite((&header), 1, 1, ofile)
        (i = 0)
        while (i < 16):
