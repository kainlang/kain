    fn print_entry(out_: FILE, row: Float, order: Int) -> Int:
        let mut table: Float = none
        let mut fval: Float = none
        let mut ival: Int = none
        let mut i: Int = none
        let mut j: Int = none
        let mut k: Int = none
        let mut overflows: Int = none
        (table = malloc((8 * 8)))
        (i = 0)
        while (i < 8):
            (table[i] = malloc((order * 8)))
            (i = (i + 1))
        (i = 0)
        while (i < order):
            (j = 0)
            while (j < i):
                (table[i][j] = 0.0)
                (j = (j + 1))
            (j = i)
            while (j < order):
                (table[i][j] = (-row[((order - j) + i)]))
                (j = (j + 1))
            (i = (i + 1))
        (i = order)
        while (i < 8):
            (j = 0)
            while (j < order):
                (table[i][j] = 0.0)
                (j = (j + 1))
            (i = (i + 1))
        (i = 1)
        while (i < 8):
            (j = 1)
            while (j <= order):
                if ((i - j) >= 0):
                    (k = 0)
                    while (k < order):
                        (table[i][k] = (table[i][k] - (row[j] * table[(i - j)][k])))
                        (k = (k + 1))
                (j = (j + 1))
            (i = (i + 1))
        (overflows = 0)
        (i = 0)
        while (i < order):
            (j = 0)
            while (j < 8):
                (fval = (table[j][i] * 2048.0))
                if (fval < 0.0):
                    (ival = ((fval - 0.5) as Int))
                    if (ival < (-8000)):
                        (overflows = (overflows + 1))
                else:
                    (ival = ((fval + 0.5) as Int))
                    if (ival >= 8000):
                        (overflows = (overflows + 1))
                fprintf(out_, "\"%5d \"", ival)
                (j = (j + 1))
            fprintf(out_, "\"\\n\"")
            (i = (i + 1))
        (i = 0)
        while (i < 8):
            free(table[i])
            (i = (i + 1))
        free(table)
        return overflows


