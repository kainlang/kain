        if ((o.oInteractStatus & INT_STATUS_INTERACTED) && (gMarioState.flags & MARIO_METAL_CAP)):
            (o.oAction = PIRANHA_PLANT_ACT_ATTACKED)

    fn mario_moving_fast_enough_to_make_piranha_plant_bite(param_0: ()) -> Int:
