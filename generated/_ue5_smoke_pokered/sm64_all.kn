    struct OSTimer:

    struct OSContRamReadFormat:

    fn bhv_mips_init(param_0: ()) -> ():
        let mut starFlags: Int = save_file_get_star_flags((gCurrSaveFileNum - 1), COURSE_NUM_TO_INDEX(COURSE_NONE))
        if ((save_file_get_total_star_count((gCurrSaveFileNum - 1), (COURSE_MIN - 1), (COURSE_MAX - 1)) >= 15) && (!(starFlags & SAVE_FLAG_TO_STAR_FLAG(SAVE_FLAG_COLLECTED_MIPS_STAR_1)))):
            (o.oBhvParams2ndByte = MIPS_BP_15_STARS)
            (o.oMipsForwardVelocity = 40.0)
        else:
            if ((save_file_get_total_star_count((gCurrSaveFileNum - 1), (COURSE_MIN - 1), (COURSE_MAX - 1)) >= 50) && (!(starFlags & SAVE_FLAG_TO_STAR_FLAG(SAVE_FLAG_COLLECTED_MIPS_STAR_2)))):
                (o.oBhvParams2ndByte = MIPS_BP_50_STARS)
                (o.oMipsForwardVelocity = 45.0)
            else:
                (o.activeFlags = ACTIVE_FLAG_DEACTIVATED)
        (o.oInteractionSubtype = INT_SUBTYPE_HOLDABLE_NPC)
        (o.oGravity = 15.0)
        (o.oFriction = 0.89)
        (o.oBuoyancy = 1.2)
        cur_obj_init_animation(0)

    fn bhv_mips_find_furthest_waypoint_to_mario(param_0: ()) -> Int:
        let mut i: Int = none
        let mut x: Int = none
        let mut y: Int = none
        let mut z: Int = none
        let mut furthestWaypointIndex: Int = (-1)
        let mut furthestWaypointDistance: Float = (-10000.0)
        let mut distanceToMario: Float = none
        let mut pathBase: Waypoint = segmented_to_virtual((&inside_castle_seg7_trajectory_mips))
        (i = 0)
        while (i < 10):
            let mut waypoint: Waypoint = segmented_to_virtual(pathBase[i])
            (x = waypoint.pos[0])
            (y = waypoint.pos[1])
            (z = waypoint.pos[2])
            if is_point_close_to_object(o, x, y, z, 800):
                (distanceToMario = (sqr((x - gMarioObject.header.gfx.pos[0])) + sqr((z - gMarioObject.header.gfx.pos[2]))))
                if (furthestWaypointDistance < distanceToMario):
                    (furthestWaypointIndex = i)
                    (furthestWaypointDistance = distanceToMario)
            (i = (i + 1))
        (o.oMipsStartWaypointIndex = furthestWaypointIndex)
        return (o.oMipsStartWaypointIndex as Int)

    fn bhv_mips_act_wait_for_nearby_mario(param_0: ()) -> ():
        let mut collisionFlags: Int = 0
        (o.oForwardVel = 0.0)
        (collisionFlags = object_step())
        if is_point_within_radius_of_mario(o.oPosX, o.oPosY, o.oPosZ, 500):
            if (bhv_mips_find_furthest_waypoint_to_mario() == (-1)):
                (o.oAction = MIPS_ACT_WAIT_FOR_ANIMATION_DONE)
            else:
                cur_obj_init_animation(1)
                (o.oAction = MIPS_ACT_FOLLOW_PATH)

    fn bhv_mips_act_follow_path(param_0: ()) -> ():
        let mut collisionFlags: Int = 0
        let mut followStatus: Int = none
        let mut pathBase: Waypoint = segmented_to_virtual((&inside_castle_seg7_trajectory_mips))
        let mut waypoint: Waypoint = segmented_to_virtual((*(pathBase + o.oMipsStartWaypointIndex)))
        (o.oPathedStartWaypoint = waypoint)
        (followStatus = cur_obj_follow_path(followStatus))
        (o.oForwardVel = o.oMipsForwardVelocity)
        (o.oMoveAngleYaw = o.oPathedTargetYaw)
        (collisionFlags = object_step())
        if (followStatus == PATH_REACHED_END):
            cur_obj_init_animation(0)
            (o.oAction = MIPS_ACT_WAIT_FOR_NEARBY_MARIO)
        if ((cur_obj_check_if_near_animation_end() == TRUE) && (collisionFlags & OBJ_COL_FLAG_UNDERWATER)):
            cur_obj_play_sound_2(SOUND_OBJ_MIPS_RABBIT_WATER)
            spawn_object(o, MODEL_NONE, bhvShallowWaterSplash)
        else:
            if (cur_obj_check_if_near_animation_end() == TRUE):
                cur_obj_play_sound_2(SOUND_OBJ_MIPS_RABBIT)

    fn bhv_mips_act_wait_for_animation_done(param_0: ()) -> ():
        if (cur_obj_check_if_near_animation_end() == TRUE):
            cur_obj_init_animation(0)
            (o.oAction = MIPS_ACT_IDLE)

    fn bhv_mips_act_fall_down(param_0: ()) -> ():
        let mut collisionFlags: Int = 0
        (collisionFlags = object_step())
        (o.header.gfx.animInfo.animFrame = 0)
        if ((collisionFlags & OBJ_COL_FLAG_GROUNDED) == OBJ_COL_FLAG_GROUNDED):
            (o.oAction = MIPS_ACT_WAIT_FOR_ANIMATION_DONE)
            (o.oFlags = (o.oFlags | OBJ_FLAG_SET_FACE_YAW_TO_MOVE_YAW))
            (o.oMoveAngleYaw = o.oFaceAngleYaw)
            if (collisionFlags & OBJ_COL_FLAG_UNDERWATER):
                spawn_object(o, MODEL_NONE, bhvShallowWaterSplash)

    fn bhv_mips_act_idle(param_0: ()) -> ():
        let mut collisionFlags: Int = 0
        (o.oForwardVel = 0.0)
        (collisionFlags = object_step())
        if (o.oMipsStarStatus == MIPS_STAR_STATUS_SHOULD_SPAWN_STAR):
            bhv_spawn_star_no_level_exit((STAR_INDEX_ACT_4 + o.oBhvParams2ndByte))
            (o.oMipsStarStatus = MIPS_STAR_STATUS_ALREADY_SPAWNED_STAR)

    fn bhv_mips_free(param_0: ()) -> ():
        none

    fn bhv_mips_held(param_0: ()) -> ():
        let mut dialogID: Int = none
        (o.header.gfx.node.flags = (o.header.gfx.node.flags | GRAPH_RENDER_INVISIBLE))
        cur_obj_init_animation(4)
        cur_obj_set_pos_relative(gMarioObject, 0, 60.0, 100.0)
        cur_obj_become_intangible()
        if (o.oMipsStarStatus == MIPS_STAR_STATUS_HAVENT_SPAWNED_STAR):
            if (o.oBhvParams2ndByte == MIPS_BP_15_STARS):
                (dialogID = DIALOG_084)
            else:
                (dialogID = DIALOG_162)
