                    (coffin = spawn_object_relative((i & 1), coffinRelativePos[i].x, 0, relativeZ, o, MODEL_BBH_WOODEN_TOMB, bhvCoffin))
                    if (coffin != NULL):
                        if (relativeZ > 0):
                            (coffin.oFaceAngleYaw = 8000)
                    (i = (i + 1))
                (o.oAction = (o.oAction + 1))
        else:
            if (o.activeFlags & ACTIVE_FLAG_IN_DIFFERENT_ROOM):
                (o.oAction = COFFIN_SPAWNER_ACT_COFFINS_UNLOADED)

    fn coffin_act_idle(param_0: ()) -> ():
        if (o.oBhvParams2ndByte != COFFIN_BP_STATIC):
            if (o.oFaceAnglePitch != 0):
                (o.oAngleVelPitch = approach_s16_symmetric(o.oAngleVelPitch, (-2000), 200))
                if obj_face_pitch_approach(0, (-o.oAngleVelPitch)):
                    cur_obj_play_sound_2(SOUND_GENERAL_ELEVATOR_MOVE_2)
                    obj_perform_position_op(POS_OP_SAVE_POSITION)
                    (o.oMoveAngleYaw = (o.oFaceAngleYaw - 4000))
                    obj_set_dist_from_home(200.0)
                    spawn_mist_from_global()
                    obj_perform_position_op(POS_OP_RESTORE_POSITION)
                (o.oTimer = 0)
            else:
                let mut yawCos: Float = coss(o.oFaceAngleYaw)
                let mut yawSin: Float = sins(o.oFaceAngleYaw)
                let mut dx: Float = (gMarioObject.oPosX - o.oPosX)
                let mut dz: Float = (gMarioObject.oPosZ - o.oPosZ)
                let mut distForwards: Float = ((dx * yawCos) + (dz * yawSin))
                let mut distSideways: Float = ((dz * yawCos) - (dx * yawSin))
                if ((((((o.oTimer > 60) && ((o.oDistanceToMario > 100.0) || (gMarioState.action == ACT_SQUISHED))) && ((gMarioObject.oPosY - o.oPosY) < 200.0)) && (absf(distForwards) < 140.0)) && (distSideways < 150.0)) && (distSideways > (-450.0))):
                    cur_obj_play_sound_2(SOUND_GENERAL_BUTTON_PRESS_2_LOWPRIO)
                    (o.oAction = COFFIN_ACT_STAND_UP)
                (o.oAngleVelPitch = 0)

    fn coffin_act_stand_up(param_0: ()) -> ():
        if (o.oFaceAnglePitch != 4000):
            (o.oAngleVelPitch = approach_s16_symmetric(o.oAngleVelPitch, 1000, 200))
            obj_face_pitch_approach(4000, o.oAngleVelPitch)
        else:
            if (o.oTimer > 60):
                (o.oAction = COFFIN_ACT_IDLE)
                (o.oFaceAngleRoll = 0)
            else:
                if (o.oTimer > 30):
                    if ((gGlobalTimer % 4) == 0):
                        cur_obj_play_sound_2(SOUND_GENERAL_ELEVATOR_MOVE_2)
                    (o.oFaceAngleRoll = ((400 * (gGlobalTimer % 2)) - 200))
            (o.oAngleVelPitch = 0)

    fn bhv_coffin_loop(param_0: ()) -> ():
        if (o.parentObj.oAction == COFFIN_SPAWNER_ACT_COFFINS_UNLOADED):
            obj_mark_for_deletion(o)
        else:
            (o.header.gfx.scale[1] = 1.1)
            load_object_collision_model()


