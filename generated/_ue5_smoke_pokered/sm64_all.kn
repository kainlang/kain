mod src_menu_title_screen:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    fn run_level_id_or_demo(level: Int) -> Int:
        (gCurrDemoInput = NULL)
        if (level == LEVEL_NONE):
            if ((!gPlayer1Controller.buttonDown) && (!gPlayer1Controller.stickMag)):
                if ((sDemoCountdown = (sDemoCountdown + 1)) == PRESS_START_DEMO_TIMER):
                    load_patchable_table((&gDemoInputsBuf), gDemoInputListID)
                    if ((gDemoInputListID = (gDemoInputListID + 1)) == gDemoInputsBuf.dmaTable.count):
                        (gDemoInputListID = 0)
                    (gCurrDemoInput = ((gDemoInputsBuf.bufTarget as DemoInput) + 1))
                    (level = ((gDemoInputsBuf.bufTarget as DemoInput).timer as Int))
                    (gCurrSaveFileNum = 1)
                    (gCurrActNum = 1)
            else:
                (sDemoCountdown = 0)
        return level

    fn intro_level_select(param_0: ()) -> Int:
        let mut stageChanged: Int = FALSE
        if (gPlayer1Controller.buttonPressed & A_BUTTON):
            (stageChanged = TRUE)
        if (gPlayer1Controller.buttonPressed & B_BUTTON):
            (stageChanged = TRUE)
        if (gPlayer1Controller.buttonPressed & U_JPAD):
            (stageChanged = TRUE)
        if (gPlayer1Controller.buttonPressed & D_JPAD):
            (stageChanged = TRUE)
        if (gPlayer1Controller.buttonPressed & L_JPAD):
            (stageChanged = TRUE)
        if (gPlayer1Controller.buttonPressed & R_JPAD):
            (stageChanged = TRUE)
        if stageChanged:
            play_sound(SOUND_GENERAL_LEVEL_SELECT_CHANGE, gGlobalSoundSource)
        if (gCurrLevelNum > LEVEL_MAX):
            (gCurrLevelNum = LEVEL_MIN)
        if (gCurrLevelNum < LEVEL_MIN):
            (gCurrLevelNum = LEVEL_MAX)
        (gCurrSaveFileNum = 4)
        (gCurrActNum = 6)
        print_text_centered(160, 80, "\"SELECT STAGE\"")
        print_text_centered(160, 30, "\"PRESS START BUTTON\"")
        print_text_fmt_int(40, 60, "\"%2d\"", gCurrLevelNum)
        print_text(80, 60, sLevelSelectStageNames[(gCurrLevelNum - 1)])
        if (gPlayer1Controller.buttonPressed & START_BUTTON):
            if (gPlayer1Controller.buttonDown == QUIT_LEVEL_SELECT_COMBO):
                (gDebugLevelSelect = FALSE)
                return (-1)
            play_sound(SOUND_MENU_STAR_SOUND, gGlobalSoundSource)
            return gCurrLevelNum
        return 0

    fn intro_regular(param_0: ()) -> Int:
        let mut level: Int = LEVEL_NONE
        if (sPlayMarioGreeting == TRUE):
            if (gGlobalTimer < 129):
                play_sound(SOUND_MARIO_HELLO, gGlobalSoundSource)
            else:
                play_sound(SOUND_MARIO_PRESS_START_TO_PLAY, gGlobalSoundSource)
            (sPlayMarioGreeting = FALSE)
        print_intro_text()
        if (gPlayer1Controller.buttonPressed & START_BUTTON):
            play_sound(SOUND_MENU_STAR_SOUND, gGlobalSoundSource)
            (level = (100 + gDebugLevelSelect))
            (sPlayMarioGreeting = TRUE)
        return run_level_id_or_demo(level)

    fn intro_game_over(param_0: ()) -> Int:
        let mut level: Int = LEVEL_NONE
        if (sPlayMarioGameOver == TRUE):
            play_sound(SOUND_MARIO_GAME_OVER, gGlobalSoundSource)
            (sPlayMarioGameOver = FALSE)
        print_intro_text()
        if (gPlayer1Controller.buttonPressed & START_BUTTON):
            play_sound(SOUND_MENU_STAR_SOUND, gGlobalSoundSource)
            (level = (100 + gDebugLevelSelect))
            (sPlayMarioGameOver = TRUE)
        return run_level_id_or_demo(level)

    fn intro_play_its_a_me_mario(param_0: ()) -> Int:
        set_background_music(0, SEQ_SOUND_PLAYER, 0)
        play_sound(SOUND_MENU_COIN_ITS_A_ME_MARIO, gGlobalSoundSource)
        return 1

    fn lvl_intro_update(arg: Int, unusedArg: Int) -> Int:
        let mut retVar: Int = none
        return retVar


