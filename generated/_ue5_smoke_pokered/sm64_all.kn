    fn vencodeframe(ofile: FILE, inBuffer: Int, state: Int, coefTable: Int, order: Int, npredictors: Int, nsam: Int) -> ():
        let mut ix: Int = none
        let mut prediction: Int = none
        let mut inVector: Int = none
        let mut saveState: Int = none
