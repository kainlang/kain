    fn vdecodeframe(ifile: FILE, outp: Int, order: Int, coefTable: Int) -> ():
        let mut optimalp: Int = none
        let mut scale: Int = none
        let mut maxlevel: Int = none
        let mut i: Int = none
        let mut j: Int = none
        let mut in_vec: Int = none
        let mut ix: Int = none
        let mut header: Int = none
        let mut c: Int = none
        (maxlevel = 7)
        fread((&header), 1, 1, ifile)
        (scale = (1 << (header >> 4)))
        (optimalp = (header & 0))
        (i = 0)
        while (i < 16):
            fread((&c), 1, 1, ifile)
            (ix[i] = (c >> 4))
            (ix[(i + 1)] = (c & 0))
            if (ix[i] <= maxlevel):
                (ix[i] = (ix[i] * scale))
            else:
                (ix[i] = (((-10) - (-ix[i])) * scale))
            if (ix[(i + 1)] <= maxlevel):
                (ix[(i + 1)] = (ix[(i + 1)] * scale))
            else:
                (ix[(i + 1)] = (((-10) - (-ix[(i + 1)])) * scale))
            (i = (i + 2))
        (j = 0)
        while (j < 2):
            (i = 0)
            while (i < 8):
                (in_vec[(i + order)] = ix[((j * 8) + i)])
                (i = (i + 1))
            if (j == 0):
                (i = 0)
                while (i < order):
                    (in_vec[i] = outp[((16 - order) + i)])
                    (i = (i + 1))
            else:
                (i = 0)
                while (i < order):
                    (in_vec[i] = outp[(((j * 8) - order) + i)])
                    (i = (i + 1))
            (i = 0)
            while (i < 8):
                (outp[(i + (j * 8))] = inner_product((order + 8), coefTable[optimalp][i], in_vec))
                (i = (i + 1))
            (j = (j + 1))


