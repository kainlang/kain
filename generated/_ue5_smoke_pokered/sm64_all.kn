    fn bhv_homing_amp_init(param_0: ()) -> ():
        (o.oHomeX = o.oPosX)
        (o.oHomeY = o.oPosY)
        (o.oHomeZ = o.oPosZ)
        (o.oGravity = 0.0)
        (o.oFriction = 1.0)
        (o.oBuoyancy = 1.0)
        (o.oHomingAmpAvgY = o.oHomeY)
        cur_obj_scale(0.1)
        (o.header.gfx.node.flags = (o.header.gfx.node.flags | GRAPH_RENDER_INVISIBLE))

    fn check_amp_attack(param_0: ()) -> ():
        obj_set_hitbox(o, (&sAmpHitbox))
        if (o.oInteractStatus & INT_STATUS_INTERACTED):
            if (o.oInteractStatus & INT_STATUS_INTERACTED):
                (o.oAction = AMP_ACT_ATTACK_COOLDOWN)
            (o.oInteractStatus = 0)

    fn homing_amp_appear_loop(param_0: ()) -> ():
        let mut relativeTargetX: Float = (gLakituState.goalPos[0] - o.oPosX)
        let mut relativeTargetZ: Float = (gLakituState.goalPos[2] - o.oPosZ)
        let mut targetYaw: Int = atan2s(relativeTargetZ, relativeTargetX)
        (o.oMoveAngleYaw = approach_s16_symmetric(o.oMoveAngleYaw, targetYaw, 1000))
        if (o.oTimer < 30):
            cur_obj_scale((0.1 + (0.9 * ((o.oTimer / 30.0) as Float))))
        else:
            (o.oAnimState = 1)
        if (o.oTimer > 90):
            cur_obj_scale(1.0)
            (o.oAction = HOMING_AMP_ACT_CHASE)
            (o.oAmpYPhase = 0)

    fn homing_amp_chase_loop(param_0: ()) -> ():
        if (((o.oAngleToMario - 400) < o.oMoveAngleYaw) && (o.oMoveAngleYaw < (o.oAngleToMario + 400))):
            (o.oHomingAmpLockedOn = TRUE)
            (o.oTimer = 0)
        if (o.oHomingAmpLockedOn == TRUE):
            (o.oForwardVel = 15.0)
            if (o.oHomingAmpAvgY > (gMarioObject.header.gfx.pos[1] + 150.0)):
                (o.oHomingAmpAvgY = (o.oHomingAmpAvgY - 10.0))
            else:
                (o.oHomingAmpAvgY = (gMarioObject.header.gfx.pos[1] + 150.0))
            if (o.oTimer > 30):
                (o.oHomingAmpLockedOn = FALSE)
        else:
            (o.oForwardVel = 10.0)
            obj_turn_toward_object(o, gMarioObject, 16, 400)
            if (o.oHomingAmpAvgY < (gMarioObject.header.gfx.pos[1] + 250.0)):
                (o.oHomingAmpAvgY = (o.oHomingAmpAvgY + 10.0))
        (o.oPosY = (o.oHomingAmpAvgY + (sins((o.oAmpYPhase * 400)) * 20.0)))
        check_amp_attack()
        if (!is_point_within_radius_of_mario(o.oHomeX, o.oHomeY, o.oHomeZ, 1500)):
            (o.oAction = HOMING_AMP_ACT_GIVE_UP)

    fn homing_amp_give_up_loop(param_0: ()) -> ():
        let mut filler: Int = none
        (o.oForwardVel = 15.0)
        if (o.oTimer > 150):
            (o.oPosX = o.oHomeX)
            (o.oPosY = o.oHomeY)
            (o.oPosZ = o.oHomeZ)
            (o.header.gfx.node.flags = (o.header.gfx.node.flags | GRAPH_RENDER_INVISIBLE))
            (o.oAction = HOMING_AMP_ACT_INACTIVE)
            (o.oAnimState = 0)
            (o.oForwardVel = 0.0)
            (o.oHomingAmpAvgY = o.oHomeY)

    fn amp_attack_cooldown_loop(param_0: ()) -> ():
        (o.header.gfx.animInfo.animFrame = (o.header.gfx.animInfo.animFrame + 2))
        (o.oForwardVel = 0.0)
        cur_obj_become_intangible()
        if (o.oTimer > 30):
            (o.oAnimState = 0)
        if (o.oTimer > 90):
            (o.oAnimState = 1)
            cur_obj_become_tangible()
            (o.oAction = HOMING_AMP_ACT_CHASE)

    fn bhv_homing_amp_loop(param_0: ()) -> ():
        object_step()
        (o.oAmpYPhase = (o.oAmpYPhase + 1))

    fn bhv_circling_amp_init(param_0: ()) -> ():
        (o.oHomeX = o.oPosX)
        (o.oHomeY = o.oPosY)
        (o.oHomeZ = o.oPosZ)
        (o.oAnimState = 1)
        (o.oMoveAngleYaw = random_u16())
        (o.oAction = AMP_ACT_IDLE)

    fn fixed_circling_amp_idle_loop(param_0: ()) -> ():
        let mut xToMario: Float = (gMarioObject.header.gfx.pos[0] - o.oPosX)
        let mut yToMario: Float = ((gMarioObject.header.gfx.pos[1] + 120.0) - o.oPosY)
        let mut zToMario: Float = (gMarioObject.header.gfx.pos[2] - o.oPosZ)
        let mut vAngleToMario: Int = atan2s(sqrtf(((xToMario * xToMario) + (zToMario * zToMario))), (-yToMario))
        obj_turn_toward_object(o, gMarioObject, 19, 1000)
        (o.oFaceAnglePitch = approach_s16_symmetric(o.oFaceAnglePitch, vAngleToMario, 1000))
        (o.oPosY = (o.oHomeY + (coss((o.oAmpYPhase * 458)) * 20.0)))
        check_amp_attack()
        (o.oAmpYPhase = (o.oAmpYPhase + 1))

    fn circling_amp_idle_loop(param_0: ()) -> ():
        (o.oPosX = (o.oHomeX + (sins(o.oMoveAngleYaw) * o.oAmpRadiusOfRotation)))
        (o.oPosZ = (o.oHomeZ + (coss(o.oMoveAngleYaw) * o.oAmpRadiusOfRotation)))
        (o.oPosY = (o.oHomeY + (coss((o.oAmpYPhase * 0)) * 30.0)))
        (o.oMoveAngleYaw = (o.oMoveAngleYaw + 400))
        (o.oFaceAngleYaw = (o.oMoveAngleYaw + 4000))
        check_amp_attack()
        (o.oAmpYPhase = (o.oAmpYPhase + 1))
        cur_obj_play_sound_1(SOUND_AIR_AMP_BUZZ)

    fn bhv_circling_amp_loop(param_0: ()) -> ():
        none


