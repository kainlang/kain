    fn spawn_wind_particles(pitch: Int, yaw: Int) -> ():
        let mut i: Int = none
        (i = 0)
        while (i < 3):
            let mut wind: Object = spawn_object(o, MODEL_MIST, bhvWind)
            (wind.oMoveAngleYaw = yaw)
            (wind.oMoveAnglePitch = pitch)
            (i = (i + 1))

    fn bhv_wind_loop(param_0: ()) -> ():
        let mut sp2E: Int = 500
        let mut scale: Float = 1.0
        if (o.oTimer == 0):
            (o.oOpacity = 100)
            if (o.oMoveAnglePitch == 0):
                obj_translate_xz_random(o, 900.0)
                (o.oPosX = (o.oPosX + (sins((o.oMoveAngleYaw + 8000)) * sp2E)))
                (o.oPosY = (o.oPosY + (80.0 + random_f32_around_zero(200.0))))
                (o.oPosZ = (o.oPosZ + (coss((o.oMoveAngleYaw + 8000)) * sp2E)))
                (o.oMoveAngleYaw = (o.oMoveAngleYaw + random_f32_around_zero(4000.0)))
                (o.oForwardVel = ((random_float() * 70.0) + 50.0))
            else:
                obj_translate_xz_random(o, 600.0)
                (o.oPosY = (o.oPosY - (sp2E - 200)))
                (o.oVelY = ((random_float() * 30.0) + 50.0))
                (o.oMoveAngleYaw = random_u16())
                (o.oForwardVel = 10.0)
            obj_set_billboard(o)
            cur_obj_scale(scale)
        if (o.oTimer > 8):
            obj_mark_for_deletion(o)
        (o.oFaceAnglePitch = (o.oFaceAnglePitch + (4000.0 + (2000.0 * random_float()))))
        (o.oFaceAngleYaw = (o.oFaceAngleYaw + (4000.0 + (2000.0 * random_float()))))
        cur_obj_move_using_fvel_and_gravity()


mod src_game_behaviors_yoshi_inc:
