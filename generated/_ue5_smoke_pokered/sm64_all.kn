        cur_obj_init_animation(1)
        cur_obj_set_pos_relative(gMarioObject, 0, 60.0, 100.0)
        (o.oBobombFuseLit = 1)
        if (o.oBobombFuseTimer > 150):
            (gMarioObject.oInteractStatus = (gMarioObject.oInteractStatus | INT_STATUS_MARIO_DROP_OBJECT))
            (o.oAction = BOBOMB_ACT_EXPLODE)

