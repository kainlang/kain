        (gMarioObject.oPosZ = (gMarioObject.oPosZ + ((5 * o.oButterflyYPhase) / 4)))
        obj_turn_toward_object(o, gMarioObject, 16, 300)
        (gMarioObject.oPosX = (gMarioObject.oPosX - ((5 * o.oButterflyYPhase) / 4)))
        (gMarioObject.oPosZ = (gMarioObject.oPosZ - ((5 * o.oButterflyYPhase) / 4)))
        (gMarioObject.oPosY = (gMarioObject.oPosY + (((5 * o.oButterflyYPhase) + 100) / 4)))
        obj_turn_toward_object(o, gMarioObject, 15, 500)
        (gMarioObject.oPosY = (gMarioObject.oPosY - (((5 * o.oButterflyYPhase) + 100) / 4)))

