            (o.oAction = CLOUD_ACT_UNLOAD)
        else:
            if o.oCloudBlowing:
                (o.header.gfx.scale[0] = (o.header.gfx.scale[0] + o.oCloudGrowSpeed))
                if ((o.oCloudGrowSpeed = (o.oCloudGrowSpeed - 0.005)) < (-0.16)):
                    (o.oCloudBlowing = (o.oTimer = 0))
