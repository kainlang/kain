        let mut vAngleToHome: Int = atan2s(sqrtf(((homeDistX * homeDistX) + (homeDistZ * homeDistZ))), (-homeDistY))
        (o.oMoveAngleYaw = approach_s16_symmetric(o.oMoveAngleYaw, hAngleToHome, 800))
        (o.oMoveAnglePitch = approach_s16_symmetric(o.oMoveAnglePitch, vAngleToHome, 50))
        butterfly_step(7)
