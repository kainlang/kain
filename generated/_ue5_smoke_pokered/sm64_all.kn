    fn bird_act_inactive(param_0: ()) -> ():
        if ((o.oBhvParams2ndByte == BIRD_BP_SPAWNED) || (o.oDistanceToMario < 2000.0)):
            if (o.oBhvParams2ndByte != BIRD_BP_SPAWNED):
                let mut i: Int = none
                cur_obj_play_sound_2(SOUND_GENERAL_BIRDS_FLY_AWAY)
                (i = 0)
                while (i < 6):
                    spawn_object(o, MODEL_BIRDS, bhvBird)
                    (i = (i + 1))
                (o.oHomeX = (-20.0))
                (o.oHomeZ = (-3990.0))
            (o.oAction = BIRD_ACT_FLY)
            (o.oMoveAnglePitch = (5000 - ((4000.0 * random_float()) as Int)))
            (o.oMoveAngleYaw = random_u16())
            (o.oBirdSpeed = 40.0)
            cur_obj_unhide()

