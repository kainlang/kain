        let mut yawTurnSpeed: Int = none
        (o.oWigglerWalkAnimSpeed = (0.06 * o.oForwardVel))
        if (o.oWigglerTextStatus < WIGGLER_TEXT_STATUS_COMPLETED_DIALOG):
