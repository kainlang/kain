            (o.oPosY = (o.oPosY - (o.oVelY + ((coss(((yPhase * 655.36) as Int)) * 20.0) / 4))))
        else:
            (o.oPosY = (o.oPosY - o.oVelY))
        (floorY = find_floor_height_and_data(o.oPosX, o.oPosY, o.oPosZ, (&sp24)))
        if (o.oPosY < (floorY + 2.0)):
            (o.oPosY = (floorY + 2.0))
        (o.oButterflyYPhase = (o.oButterflyYPhase + 1))
        if (o.oButterflyYPhase > 100):
            (o.oButterflyYPhase = 0)

