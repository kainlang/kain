    fn act_stop_crawling(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return set_mario_action(m, ACT_BEGIN_SLIDING, 0)
        stationary_ground_step(m)
        set_mario_animation(m, MARIO_ANIM_STOP_CRAWLING)
        if is_anim_past_end(m):
            set_mario_action(m, ACT_CROUCHING, 0)
        return FALSE

    fn act_shockwave_bounce(m: MarioState) -> Int:
        let mut sp1E: Int = none
        let mut sp18: Float = none
        if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_SHOCKWAVE):
            return hurt_and_set_mario_action(m, ACT_SHOCKED, 0, 4)
        if (m.actionTimer == 0):
            if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_KNOCKBACK_DMG):
                return hurt_and_set_mario_action(m, ACT_BACKWARD_GROUND_KB, 0, 0)
        if ((m.actionTimer = (m.actionTimer + 1)) == 48):
            return set_mario_action(m, ACT_IDLE, 0)
        (sp1E = ((m.actionTimer % 16) << 12))
        (sp18 = (((((6 - (m.actionTimer / 8)) as Float) * 8.0) + 4.0) as Float))
        mario_set_forward_vel(m, 0)
        vec3f_set(m.vel, 0.0, 0.0, 0.0)
        if (sins(sp1E) >= 0.0):
            (m.pos[1] = ((sins(sp1E) * sp18) + m.floorHeight))
        else:
            (m.pos[1] = (m.floorHeight - (sins(sp1E) * sp18)))
        vec3f_copy(m.marioObj.header.gfx.pos, m.pos)
        vec3s_set(m.marioObj.header.gfx.angle, 0, m.faceAngle[1], 0)
        set_mario_animation(m, MARIO_ANIM_A_POSE)
        return FALSE

    fn landing_step(m: MarioState, arg1: Int, action: Int) -> Int:
        stationary_ground_step(m)
        set_mario_animation(m, arg1)
        if is_anim_at_end(m):
            return set_mario_action(m, action, 0)
        return FALSE

    fn check_common_landing_cancels(m: MarioState, action: Int) -> Int:
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_FIRST_PERSON):
            return set_mario_action(m, ACT_IDLE, 0)
        if (m.input & INPUT_A_PRESSED):
            if (!action):
                return set_jump_from_landing(m)
            else:
                return set_jumping_action(m, action, 0)
        if (m.input & (((INPUT_NONZERO_ANALOG | INPUT_A_PRESSED) | INPUT_OFF_FLOOR) | INPUT_ABOVE_SLIDE)):
            return check_common_action_exits(m)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_PUNCHING, 0)
        return FALSE

    fn act_jump_land_stop(m: MarioState) -> Int:
        if check_common_landing_cancels(m, 0):
            return TRUE
        landing_step(m, MARIO_ANIM_LAND_FROM_SINGLE_JUMP, ACT_IDLE)
        return FALSE

    fn act_double_jump_land_stop(m: MarioState) -> Int:
        if check_common_landing_cancels(m, 0):
            return TRUE
        landing_step(m, MARIO_ANIM_LAND_FROM_DOUBLE_JUMP, ACT_IDLE)
        return FALSE

    fn act_side_flip_land_stop(m: MarioState) -> Int:
        if check_common_landing_cancels(m, 0):
            return TRUE
        landing_step(m, MARIO_ANIM_SLIDEFLIP_LAND, ACT_IDLE)
        (m.marioObj.header.gfx.angle[1] = (m.marioObj.header.gfx.angle[1] + 8000))
        return FALSE

    fn act_freefall_land_stop(m: MarioState) -> Int:
        if check_common_landing_cancels(m, 0):
            return TRUE
        landing_step(m, MARIO_ANIM_GENERAL_LAND, ACT_IDLE)
        return FALSE

    fn act_triple_jump_land_stop(m: MarioState) -> Int:
        if check_common_landing_cancels(m, ACT_JUMP):
            return TRUE
        landing_step(m, MARIO_ANIM_TRIPLE_JUMP_LAND, ACT_IDLE)
        return FALSE

    fn act_backflip_land_stop(m: MarioState) -> Int:
        if ((!(m.input & INPUT_Z_DOWN)) || (m.marioObj.header.gfx.animInfo.animFrame >= 6)):
            (m.input = (m.input & (~INPUT_A_PRESSED)))
        if check_common_landing_cancels(m, ACT_BACKFLIP):
            return TRUE
        landing_step(m, MARIO_ANIM_TRIPLE_JUMP_LAND, ACT_IDLE)
        return FALSE

    fn act_lava_boost_land(m: MarioState) -> Int:
        (m.input = (m.input & (~(INPUT_FIRST_PERSON | INPUT_B_PRESSED))))
        if check_common_landing_cancels(m, 0):
            return TRUE
        landing_step(m, MARIO_ANIM_STAND_UP_FROM_LAVA_BOOST, ACT_IDLE)
        return FALSE

    fn act_long_jump_land_stop(m: MarioState) -> Int:
        (m.input = (m.input & (~INPUT_B_PRESSED)))
        if check_common_landing_cancels(m, ACT_JUMP):
            return TRUE
        landing_step(m, if (!m.marioObj.oMarioLongJumpIsSlow): MARIO_ANIM_CROUCH_FROM_FAST_LONGJUMP else: MARIO_ANIM_CROUCH_FROM_SLOW_LONGJUMP, ACT_CROUCHING)
        return FALSE

    fn act_hold_jump_land_stop(m: MarioState) -> Int:
        if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_DROP_OBJECT):
            return drop_and_set_mario_action(m, ACT_IDLE, 0)
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & (((INPUT_NONZERO_ANALOG | INPUT_A_PRESSED) | INPUT_OFF_FLOOR) | INPUT_ABOVE_SLIDE)):
            return check_common_hold_action_exits(m)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_THROWING, 0)
        landing_step(m, MARIO_ANIM_JUMP_LAND_WITH_LIGHT_OBJ, ACT_HOLD_IDLE)
        return FALSE

    fn act_hold_freefall_land_stop(m: MarioState) -> Int:
        if (m.marioObj.oInteractStatus & INT_STATUS_MARIO_DROP_OBJECT):
            return drop_and_set_mario_action(m, ACT_IDLE, 0)
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & (((INPUT_NONZERO_ANALOG | INPUT_A_PRESSED) | INPUT_OFF_FLOOR) | INPUT_ABOVE_SLIDE)):
            return check_common_hold_action_exits(m)
        if (m.input & INPUT_B_PRESSED):
            return set_mario_action(m, ACT_THROWING, 0)
        landing_step(m, MARIO_ANIM_FALL_LAND_WITH_LIGHT_OBJ, ACT_HOLD_IDLE)
        return FALSE

    fn act_air_throw_land(m: MarioState) -> Int:
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if ((m.actionTimer = (m.actionTimer + 1)) == 4):
            mario_throw_held_object(m)
        landing_step(m, MARIO_ANIM_THROW_LIGHT_OBJECT, ACT_IDLE)
        return FALSE

    fn act_twirl_land(m: MarioState) -> Int:
        (m.actionState = 1)
        if (m.input & INPUT_STOMPED):
            return set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        stationary_ground_step(m)
        set_mario_animation(m, MARIO_ANIM_TWIRL_LAND)
        if (m.angleVel[1] > 0):
            (m.angleVel[1] = (m.angleVel[1] - 400))
            if (m.angleVel[1] < 0):
                (m.angleVel[1] = 0)
            (m.twirlYaw = (m.twirlYaw + m.angleVel[1]))
        (m.marioObj.header.gfx.angle[1] = (m.marioObj.header.gfx.angle[1] + m.twirlYaw))
        if (is_anim_at_end(m) && (m.angleVel[1] == 0)):
            (m.faceAngle[1] = (m.faceAngle[1] + m.twirlYaw))
            set_mario_action(m, ACT_IDLE, 0)
        return FALSE

    fn act_ground_pound_land(m: MarioState) -> Int:
        (m.actionState = 1)
        if (m.input & INPUT_STOMPED):
            return drop_and_set_mario_action(m, ACT_SHOCKWAVE_BOUNCE, 0)
        if (m.input & INPUT_OFF_FLOOR):
            return set_mario_action(m, ACT_FREEFALL, 0)
        if (m.input & INPUT_ABOVE_SLIDE):
            return set_mario_action(m, ACT_BUTT_SLIDE, 0)
        landing_step(m, MARIO_ANIM_GROUND_POUND_LANDING, ACT_BUTT_SLIDE_STOP)
        return FALSE

    fn act_first_person(m: MarioState) -> Int:
        let mut sp1C: Int = ((m.input & ((INPUT_OFF_FLOOR | INPUT_ABOVE_SLIDE) | INPUT_STOMPED)) != 0)
        if (m.actionState == 0):
            lower_background_noise(2)
            set_camera_mode(m.area.camera, CAMERA_MODE_C_UP, 10)
            (m.actionState = 1)
        else:
            if ((!(m.input & INPUT_FIRST_PERSON)) || sp1C):
                raise_background_noise(2)
                set_camera_mode(m.area.camera, (-1), 1)
                return set_mario_action(m, ACT_IDLE, 0)
        if ((m.floor.type_ == SURFACE_LOOK_UP_WARP) && (save_file_get_total_star_count((gCurrSaveFileNum - 1), (COURSE_MIN - 1), (COURSE_MAX - 1)) >= 10)):
            let mut sp1A: Int = m.statusForCamera.headRotation[0]
            let mut sp18: Int = (((m.statusForCamera.headRotation[1] * 4) / 3) + m.faceAngle[1])
            if ((sp1A == (-1800)) && ((sp18 < (-0)) || (sp18 >= 7000))):
                level_trigger_warp(m, WARP_OP_UNKNOWN_01)
        stationary_ground_step(m)
        set_mario_animation(m, MARIO_ANIM_FIRST_PERSON)
        return FALSE

    fn check_common_stationary_cancels(m: MarioState) -> Int:
        if (m.pos[1] < (m.waterLevel - 100)):
            if (m.action == ACT_SPAWN_SPIN_LANDING):
                load_level_init_text(0)
            update_mario_sound_and_camera(m)
            return set_water_plunge_action(m)
        if (m.input & INPUT_SQUISHED):
            update_mario_sound_and_camera(m)
            return drop_and_set_mario_action(m, ACT_SQUISHED, 0)
        if (m.action != ACT_UNKNOWN_0002020E):
            if (m.health < 100):
                update_mario_sound_and_camera(m)
                return drop_and_set_mario_action(m, ACT_STANDING_DEATH, 0)
        return FALSE

    fn mario_execute_stationary_action(m: MarioState) -> Int:
        let mut cancel: Int = none
        if check_common_stationary_cancels(m):
            return TRUE
        if mario_update_quicksand(m, 0.5):
            return TRUE
        if ((!cancel) && (m.input & INPUT_IN_WATER)):
            (m.particleFlags = (m.particleFlags | PARTICLE_IDLE_WATER_WAVE))
        return cancel


mod src_game_object_collision:
    struct FILE:

