                (o.oMerryGoRoundMarioIsOutside = (o.oMerryGoRoundMarioIsOutside + 1))
        else:
            play_sound(SOUND_AIR_HOWLING_WIND, gGlobalSoundSource)
            if ((gMarioCurrentRoom != BBH_OUTSIDE_ROOM) && (gMarioCurrentRoom != BBH_DYNAMIC_SURFACE_ROOM)):
                (o.oMerryGoRoundMarioIsOutside = FALSE)
        if (!o.oMerryGoRoundStopped):
            (o.oAngleVelYaw = 80)
            (o.oMoveAngleYaw = (o.oMoveAngleYaw + o.oAngleVelYaw))
            (o.oFaceAngleYaw = (o.oFaceAngleYaw + o.oAngleVelYaw))
            handle_merry_go_round_music()
        else:
            (o.oAngleVelYaw = 0)
            func_80321080(300)


