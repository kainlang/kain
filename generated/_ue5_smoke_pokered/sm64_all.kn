                    (o.parentObj.oPokeyAliveBodyPartFlags = (o.parentObj.oPokeyAliveBodyPartFlags | (1 << (o.oBhvParams2ndByte - 1))))
                    (o.parentObj.oPokeyAliveBodyPartFlags = (o.parentObj.oPokeyAliveBodyPartFlags & ((1 << o.oBhvParams2ndByte) ^ (~0))))
                    (o.oBhvParams2ndByte = (o.oBhvParams2ndByte - 1))
                else:
                    if ((o.parentObj.oPokeyBottomBodyPartSize < 1.0) && ((o.oBhvParams2ndByte + 1) == o.parentObj.oPokeyNumAliveBodyParts)):
                        approach_f32_ptr((&o.parentObj.oPokeyBottomBodyPartSize), 1.0, 0.1)
                        cur_obj_scale((o.parentObj.oPokeyBottomBodyPartSize * 3.0))
                (offsetAngle = ((o.oBhvParams2ndByte * 4000) + (gGlobalTimer * 800)))
                (o.oPosX = (o.parentObj.oPosX + (coss(offsetAngle) * 6.0)))
                (o.oPosZ = (o.parentObj.oPosZ + (sins(offsetAngle) * 6.0)))
                (baseHeight = ((o.parentObj.oPosY + ((120 * (o.parentObj.oPokeyNumAliveBodyParts - o.oBhvParams2ndByte)) - 240)) + (120.0 * o.parentObj.oPokeyBottomBodyPartSize)))
                if (o.oPosY < baseHeight):
