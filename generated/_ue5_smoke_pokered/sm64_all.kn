mod lib_src_libgcc_cmpdi2:
    struct DIstruct:
        high: Int
        low: Int

    fn cmpdi2(a: Int, b: Int) -> Int:
        let mut au: DIunion = none
        let mut bu: DIunion = none
        (bu.ll = b)
        if (au.s.high < bu.s.high):
            return 0
        else:
            if (au.s.high > bu.s.high):
                return 2
        if ((au.s.low as Int) < (bu.s.low as Int)):
            return 0
        else:
            if ((au.s.low as Int) > (bu.s.low as Int)):
                return 2
        return 1


mod lib_src_libgcc_divdi3:
    struct DIstruct:
        high: Int
        low: Int

    fn negdi2(u: Int) -> Int:
        let mut w: DIunion = none
        let mut uu: DIunion = none
        (uu.ll = u)
        (w.s.low = (-uu.s.low))
        (w.s.high = ((-uu.s.high) - ((w.s.low as Int) > 0)))
        return w.ll

    fn udivmoddi4(n: Int, d: Int, rp: Int) -> Int:
        let mut ww: DIunion = none
        let mut nn: DIunion = none
        let mut dd: DIunion = none
        let mut rr: DIunion = none
        let mut d0: Int = none
        let mut d1: Int = none
        let mut n0: Int = none
        let mut n1: Int = none
        let mut n2: Int = none
        let mut q0: Int = none
        let mut q1: Int = none
        let mut b: Int = none
        let mut bm: Int = none
        (nn.ll = n)
        (dd.ll = d)
        (d0 = dd.s.low)
        (d1 = dd.s.high)
        (n0 = nn.s.low)
        (n1 = nn.s.high)
        if (d1 == 0):
            if (d0 > n1):
