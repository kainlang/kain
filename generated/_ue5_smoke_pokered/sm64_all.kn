mod tools_extract_data_for_mio:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    fn u32be(val: Int) -> Int:
        return val

    fn u16be(val: Int) -> Int:
        return val

    fn elf_get_section_range(file: Int, searched_name: Char, address: Int, offset: Int, size: Int, section_index: Int) -> Int:
        let mut ehdr: Elf32_Ehdr = (file as Elf32_Ehdr)
        let mut i: Int = 0
        while (i < u16be(ehdr.e_shnum)):
            if (memcmp("\"\\x7f\"\"ELF\"", ehdr.e_ident, 4) != 0):
                fprintf(stderr, "\"Missing ELF magic\\n\"")
                exit(1)
            if (ehdr.e_ident[EI_DATA] != 2):
                fprintf(stderr, "\"ELF file is not big-endian\\n\"")
                exit(1)
            let mut shdr: Elf32_Shdr = (((file + u32be(ehdr.e_shoff)) + (i * u16be(ehdr.e_shentsize))) as Elf32_Shdr)
            if (u16be(ehdr.e_shstrndx) >= u16be(ehdr.e_shnum)):
                fprintf(stderr, "\"Invalid ELF file\\n\"")
                exit(1)
            let mut str_shdr: Elf32_Shdr = (((file + u32be(ehdr.e_shoff)) + (u16be(ehdr.e_shstrndx) * u16be(ehdr.e_shentsize))) as Elf32_Shdr)
            let mut name: Char = (((file + u32be(str_shdr.sh_offset)) + u32be(shdr.sh_name)) as Char)
            if (memcmp(name, searched_name, strlen(searched_name)) == 0):
                ((*address) = u32be(shdr.sh_addr))
                ((*offset) = u32be(shdr.sh_offset))
                ((*size) = u32be(shdr.sh_size))
                ((*section_index) = i)
                return true_
            (i = (i + 1))
        return false_

    fn main(argc: Int, argv: Char) -> Int:
        if (argc < 3):
            fprintf(stderr, "\"Usage: %s INFILE OUTFILE\\n\"", argv[0])
            return 1
        let mut in_: FILE = fopen(argv[1], "\"rb\"")
        if (in_ == NULL):
            perror("\"fopen couldn't open input file\"")
            exit(1)
        fseek(in_, 0, SEEK_END)
        let mut file_size: Int = ftell(in_)
        fseek(in_, 0, SEEK_SET)
        let mut file: Int = malloc(file_size)
        if (fread(file, 1, file_size, in_) != file_size):
            fclose(in_)
            fprintf(stderr, "\"Failed to read file: %s\\n\"", argv[1])
            exit(1)
        fclose(in_)
        let mut data_address: Int = none
        let mut data_offset: Int = none
        let mut data_size: Int = none
        let mut data_index: Int = none
        if (!elf_get_section_range(file, "\".data\"", (&data_address), (&data_offset), (&data_size), (&data_index))):
            fprintf(stderr, "\"section .data not found\\n\"")
            exit(1)
        let mut rodata_address: Int = none
        let mut rodata_offset: Int = none
        let mut rodata_size: Int = none
        let mut rodata_index: Int = none
        if elf_get_section_range(file, "\".rodata\"", (&rodata_address), (&rodata_offset), (&rodata_size), (&rodata_index)):
            fprintf(stderr, "\".rodata section found, please put everything in .data instead (non-const variables)\\n\"")
            exit(1)
        let mut symtab_address: Int = none
        let mut symtab_offset: Int = none
        let mut symtab_size: Int = none
        let mut symtab_index: Int = none
        if (!elf_get_section_range(file, "\".symtab\"", (&symtab_address), (&symtab_offset), (&symtab_size), (&symtab_index))):
            fprintf(stderr, "\"section .symtab not found\\n\"")
            exit(1)
        let mut strtab_address: Int = none
        let mut strtab_offset: Int = none
        let mut strtab_size: Int = none
        let mut strtab_index: Int = none
        if (!elf_get_section_range(file, "\".strtab\"", (&strtab_address), (&strtab_offset), (&strtab_size), (&strtab_index))):
            fprintf(stderr, "\"section .strtab not found\\n\"")
            exit(1)
        let mut last_symbol_end: Int = 0
        let mut i: Int = 0
        while (i < (symtab_size / 8)):
            let mut symbol: Elf32_Sym = (((file + symtab_offset) + (i * 8)) as Elf32_Sym)
            if ((ELF_ST_TYPE(symbol.st_info) == STT_OBJECT) && (u16be(symbol.st_shndx) == data_index)):
                let mut symbol_end: Int = (u32be(symbol.st_value) + u32be(symbol.st_size))
                if (symbol_end > last_symbol_end):
                    (last_symbol_end = symbol_end)
            (i = (i + 1))
        let mut mdebug_address: Int = none
        let mut mdebug_offset: Int = none
        let mut mdebug_size: Int = none
        let mut mdebug_index: Int = none
        if elf_get_section_range(file, "\".mdebug\"", (&mdebug_address), (&mdebug_offset), (&mdebug_size), (&mdebug_index)):
            let mut symbolic_header: SymbolicHeader = ((file + mdebug_offset) as SymbolicHeader)
            let mut i: Int = 0
            while (i < u32be(symbolic_header.ifdMax)):
                let mut fdt: FileDescriptorTable = (((file + u32be(symbolic_header.cbFdOffset)) + (i * 8)) as FileDescriptorTable)
                let mut j: Int = 0
                while (j < u32be(fdt.csym)):
                    let mut lse: LocalSymbolsEntry = none
                    memcpy((&lse), ((file + u32be(symbolic_header.cbSymOffset)) + ((u32be(fdt.isymBase) + j) * 8)), 8)
                    let mut value: Int = u32be(lse.value)
                    let mut st_sc_index: Int = u32be(lse.st_sc_index)
                    let mut st: Int = (st_sc_index >> 26)
                    if ((st == stStatic) || (st == stGlobal)):
                        let mut symbol_end: Int = (value + 8)
                        if (symbol_end > last_symbol_end):
                            (last_symbol_end = symbol_end)
                    (j = (j + 1))
                (i = (i + 1))
        let mut new_size: Int = (last_symbol_end - data_address)
        if ((new_size + 16) <= data_size):
            (new_size = data_size)
        else:
            let mut i: Int = new_size
            while (i < data_size):
                if (file[(data_offset + i)] != 0):
                    (new_size = data_size)
                    break
                (i = (i + 1))
        let mut out_: FILE = fopen(argv[2], "\"wb\"")
        fwrite((file + data_offset), 1, new_size, out_)
        fclose(out_)
        free(file)
        return 0


