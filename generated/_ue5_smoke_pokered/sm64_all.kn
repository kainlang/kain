mod src_goddard_gd_memory:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    struct GMemBlock:

    struct GMemBlock:

    struct GMemBlock:

    struct GMemBlock:

    struct GMemBlock:

    fn empty_mem_block(block: GMemBlock) -> ():
        if (block.next != NULL):
            (block.next.prev = block.prev)
        if (block.prev != NULL):
            (block.prev.next = block.next)
        (block.next = sEmptyBlockListHead)
        if (block.next != NULL):
            (sEmptyBlockListHead.prev = block)
        (sEmptyBlockListHead = block)
        (block.prev = NULL)
        (block.ptr = NULL)
        (block.size = 0)

    fn into_free_memblock(block: GMemBlock) -> GMemBlock:
        let mut freeBlock: GMemBlock = none
        let mut ptr: () = none
        let mut permanence: Int = none
        let mut space: Int = none
        (ptr = block.ptr)
        (space = block.size)
        (permanence = block.permFlag)
        empty_mem_block(block)
        (freeBlock = make_mem_block(G_MEM_BLOCK_FREE, permanence))
        (freeBlock.ptr = ptr)
        (freeBlock.size = space)
        (freeBlock.permFlag = permanence)
        return freeBlock

    fn make_mem_block(blockType: Int, permFlag: Int) -> GMemBlock:
        let mut newMemBlock: GMemBlock = none
        if (sEmptyBlockListHead == NULL):
            (sEmptyBlockListHead = (gd_allocblock(0) as GMemBlock))
            if (sEmptyBlockListHead == NULL):
                fatal_printf("\"MakeMemBlock() unable to allocate\"")
            (sEmptyBlockListHead.next = NULL)
            (sEmptyBlockListHead.prev = NULL)
        (newMemBlock = sEmptyBlockListHead)
        if ((sEmptyBlockListHead = newMemBlock.next) != NULL):
            (newMemBlock.next.prev = NULL)
        (newMemBlock.prev = NULL)
        (newMemBlock.blockType = (blockType as Int))
        (newMemBlock.permFlag = permFlag)
        return newMemBlock

    fn gd_free_mem(ptr: ()) -> Int:
        let mut curBlock: GMemBlock = none
        let mut bytesFreed: Int = none
        let mut targetBlock: Int = ptr
        (curBlock = sUsedBlockListHead)
        while (curBlock != NULL):
            if (targetBlock == curBlock.ptr):
                (bytesFreed = curBlock.size)
                into_free_memblock(curBlock)
                return bytesFreed
            (curBlock = curBlock.next)
        fatal_printf("\"Free() Not a valid memory block\"")
        return 0

    fn gd_request_mem(size: Int, permanence: Int) -> ():
        let mut foundBlock: GMemBlock = NULL
        let mut curBlock: GMemBlock = none
        let mut newBlock: GMemBlock = none
        (newBlock = make_mem_block(G_MEM_BLOCK_USED, permanence))
        (curBlock = sFreeBlockListHead)
        while (curBlock != NULL):
            if (curBlock.permFlag & permanence):
                if (curBlock.size == size):
                    (foundBlock = curBlock)
                    break
                else:
                    if (curBlock.size > size):
                        if (foundBlock != NULL):
                            if (curBlock.size < foundBlock.size):
                                (foundBlock = curBlock)
                        else:
                            (foundBlock = curBlock)
            (curBlock = curBlock.next)
        if (foundBlock == NULL):
            return NULL
        if (foundBlock.size > size):
            (newBlock.ptr = foundBlock.ptr)
            (newBlock.size = size)
            (foundBlock.size = (foundBlock.size - size))
            (foundBlock.ptr = (foundBlock.ptr + size))
        else:
            if (foundBlock.size == size):
                (newBlock.ptr = foundBlock.ptr)
                (newBlock.size = size)
                empty_mem_block(foundBlock)
        return newBlock.ptr

    fn gd_add_mem_to_heap(size: Int, addr: (), permanence: Int) -> GMemBlock:
        let mut newBlock: GMemBlock = none
        (size = ((size - 8) & (~7)))
        (addr = ((((addr as Int) + 8) & (~7)) as ()))
        (newBlock = make_mem_block(G_MEM_BLOCK_FREE, permanence))
        (newBlock.ptr = addr)
        (newBlock.size = size)
        return newBlock

    fn init_mem_block_lists(param_0: ()) -> ():
        (sFreeBlockListHead = NULL)
        (sUsedBlockListHead = NULL)
        (sEmptyBlockListHead = NULL)

    fn print_list_stats(block: GMemBlock, printBlockInfo: Int, permanence: Int) -> Int:
        let mut entries: Int = 0
        let mut totalSize: Int = 0
        while (block != NULL):
            if (block.permFlag & permanence):
                (entries = (entries + 1))
                if printBlockInfo:
                    gd_printf("\"     %6.2fk (%d bytes)\\n\"", ((block.size as Float) / 1024.0), block.size)
                (totalSize = (totalSize + block.size))
            (block = block.next)
        gd_printf("\"Total %6.2fk (%d bytes) in %d entries\\n\"", ((totalSize as Float) / 1024.0), totalSize, entries)
        return entries

    fn mem_stats(param_0: ()) -> ():
        let mut list: GMemBlock = none
        gd_printf("\"Perm Used blocks:\\n\"")
        (list = sUsedBlockListHead)
        print_list_stats(list, FALSE, PERM_G_MEM_BLOCK)
        gd_printf("\"\\n\"")
        gd_printf("\"Perm Free blocks:\\n\"")
        (list = sFreeBlockListHead)
        print_list_stats(list, FALSE, PERM_G_MEM_BLOCK)
        gd_printf("\"\\n\"")
        gd_printf("\"Temp Used blocks:\\n\"")
        (list = sUsedBlockListHead)
        print_list_stats(list, FALSE, TEMP_G_MEM_BLOCK)
        gd_printf("\"\\n\"")
        gd_printf("\"Temp Free blocks:\\n\"")
        (list = sFreeBlockListHead)
        print_list_stats(list, FALSE, TEMP_G_MEM_BLOCK)
        gd_printf("\"\\n\"")
        gd_printf("\"Empty blocks:\\n\"")
        (list = sEmptyBlockListHead)
        print_list_stats(list, FALSE, (PERM_G_MEM_BLOCK | TEMP_G_MEM_BLOCK))


