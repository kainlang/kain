    struct OSTimer:

    struct OSContRamReadFormat:

    fn sequence_channel_process_sound(seqChannel: SequenceChannel) -> ():
        let mut channelVolume: Float = none
        let mut panLayerWeight: Float = none
        let mut panFromChannel: Float = none
        let mut i: Int = none
        (channelVolume = ((seqChannel.volume * seqChannel.volumeScale) * seqChannel.seqPlayer.fadeVolume))
        if (seqChannel.seqPlayer.muted && ((seqChannel.muteBehavior & MUTE_BEHAVIOR_SOFTEN) != 0)):
            (channelVolume = (channelVolume * seqChannel.seqPlayer.muteVolumeScale))
        (panFromChannel = (seqChannel.pan * seqChannel.panChannelWeight))
        (panLayerWeight = (US_FLOAT(1.0) - seqChannel.panChannelWeight))
        (i = 0)
        while (i < 4):
            let mut layer: SequenceChannelLayer = seqChannel.layers[i]
            if (((layer != NULL) && layer.enabled) && (layer.note != NULL)):
                (layer.noteFreqScale = (layer.freqScale * seqChannel.freqScale))
                (layer.noteVelocity = (layer.velocitySquare * channelVolume))
                (layer.notePan = ((layer.pan * panLayerWeight) + panFromChannel))
            (i = (i + 1))

    fn sequence_player_process_sound(seqPlayer: SequencePlayer) -> ():
        let mut i: Int = none
        if (seqPlayer.fadeRemainingFrames != 0):
            (seqPlayer.fadeVolume = (seqPlayer.fadeVolume + seqPlayer.fadeVelocity))
            if (seqPlayer.fadeVolume > US_FLOAT2(1)):
                (seqPlayer.fadeVolume = US_FLOAT2(1))
            if (seqPlayer.fadeVolume < 0):
                (seqPlayer.fadeVolume = 0)
            if ((seqPlayer.fadeRemainingFrames = (seqPlayer.fadeRemainingFrames - 1)) == 0):
                none
        (i = 0)
        while (i < CHANNELS_MAX):
            if ((IS_SEQUENCE_CHANNEL_VALID(seqPlayer.channels[i]) == TRUE) && (seqPlayer.channels[i].enabled == TRUE)):
                sequence_channel_process_sound(seqPlayer.channels[i])
            (i = (i + 1))

    fn get_portamento_freq_scale(p: Portamento) -> Float:
        let mut v0: Int = none
        let mut result: Float = none
        (p.cur = (p.cur + p.speed))
        (v0 = (p.cur as Int))
        if (v0 >= 127):
            (v0 = 127)
        (result = (US_FLOAT(1.0) + (p.extent * (gPitchBendFrequencyScale[(v0 + 127)] - US_FLOAT(1.0)))))
        return result

    fn get_vibrato_pitch_change(vib: VibratoState) -> Int:
        let mut index: Int = none
        (vib.time = (vib.time + vib.rate))
        (index = ((vib.time >> 10) & 0))
        return (-vib.curve[index])

    fn get_vibrato_freq_scale(vib: VibratoState) -> Float:
        let mut pitchChange: Int = none
        let mut extent: Float = none
        let mut result: Float = none
        if (vib.delay != 0):
            (vib.delay = (vib.delay - 1))
            return 1
        if vib.extentChangeTimer:
            if (vib.extentChangeTimer == 1):
                (vib.extent = (vib.seqChannel.vibratoExtentTarget as Int))
            else:
                (vib.extent = (vib.extent + (((vib.seqChannel.vibratoExtentTarget as Int) - vib.extent) / (vib.extentChangeTimer as Int))))
            (vib.extentChangeTimer = (vib.extentChangeTimer - 1))
        else:
            if (vib.seqChannel.vibratoExtentTarget != (vib.extent as Int)):
                if ((vib.extentChangeTimer = vib.seqChannel.vibratoExtentChangeDelay) == 0):
                    (vib.extent = (vib.seqChannel.vibratoExtentTarget as Int))
        if vib.rateChangeTimer:
            if (vib.rateChangeTimer == 1):
                (vib.rate = (vib.seqChannel.vibratoRateTarget as Int))
            else:
                (vib.rate = (vib.rate + (((vib.seqChannel.vibratoRateTarget as Int) - vib.rate) / (vib.rateChangeTimer as Int))))
            (vib.rateChangeTimer = (vib.rateChangeTimer - 1))
        else:
            if (vib.seqChannel.vibratoRateTarget != (vib.rate as Int)):
                if ((vib.rateChangeTimer = vib.seqChannel.vibratoRateChangeDelay) == 0):
                    (vib.rate = (vib.seqChannel.vibratoRateTarget as Int))
        if (vib.extent == 0):
            return 1.0
        (pitchChange = get_vibrato_pitch_change(vib))
        (extent = ((vib.extent as Float) / US_FLOAT(4096.0)))
        (result = (US_FLOAT(1.0) + (extent * (gPitchBendFrequencyScale[(pitchChange + 127)] - US_FLOAT(1.0)))))
        return result

    fn note_vibrato_update(note: Note) -> ():
        if note.vibratoState.active:
            (note.portamentoFreqScale = get_portamento_freq_scale((&note.portamento)))
            if (note.parentLayer != NO_LAYER):
                (note.vibratoFreqScale = get_vibrato_freq_scale((&note.vibratoState)))

    fn note_vibrato_init(note: Note) -> ():
        let mut vib: VibratoState = none
        let mut seqChannel: SequenceChannel = none
        (note.vibratoFreqScale = 1.0)
        (note.portamentoFreqScale = 1.0)
        (vib = (&note.vibratoState))
        (vib.active = TRUE)
        (vib.time = 0)
        (vib.curve = gVibratoCurve)
        (vib.seqChannel = note.parentLayer.seqChannel)
        (seqChannel = vib.seqChannel)
        if ((vib.extentChangeTimer = seqChannel.vibratoExtentChangeDelay) == 0):
            (vib.extent = seqChannel.vibratoExtentTarget)
        else:
            (vib.extent = seqChannel.vibratoExtentStart)
        if ((vib.rateChangeTimer = seqChannel.vibratoRateChangeDelay) == 0):
            (vib.rate = seqChannel.vibratoRateTarget)
        else:
            (vib.rate = seqChannel.vibratoRateStart)
        (vib.delay = seqChannel.vibratoDelay)
        (note.portamento = note.parentLayer.portamento)

    fn adsr_init(adsr: AdsrState, envelope: AdsrEnvelope, volOut: Int) -> ():
        (adsr.action = 0)
        (adsr.state = ADSR_STATE_DISABLED)
        (adsr.initial = 0)
        (adsr.delay = 0)
        (adsr.velocity = 0)
        (adsr.envelope = envelope)
        (adsr.volOut = volOut)

    fn adsr_update(adsr: AdsrState) -> Int:
        let mut action: Int = adsr.action
        if (action & ADSR_ACTION_DECAY):
            (adsr.state = ADSR_STATE_DECAY)
            (adsr.action = (action & (~ADSR_ACTION_DECAY)))
        if (action & ADSR_ACTION_RELEASE):
            (adsr.state = ADSR_STATE_RELEASE)
            (adsr.action = (action & (~(ADSR_ACTION_RELEASE | ADSR_ACTION_DECAY))))
