        let mut animFrame: Int = o.header.gfx.animInfo.animFrame
        let mut collisionFlags: Int = none
        (o.oForwardVel = 5.0)
        (collisionFlags = object_step())
        if ((obj_return_home_if_safe(o, o.oHomeX, o.oHomeY, o.oHomeZ, 400) == TRUE) && (obj_check_if_facing_toward_angle(o.oMoveAngleYaw, o.oAngleToMario, 2000) == TRUE)):
            (o.oBobombFuseLit = 1)
            (o.oAction = BOBOMB_ACT_CHASE_MARIO)
        obj_check_floor_death(collisionFlags, sObjFloor)

    fn bobomb_act_chase_mario(param_0: ()) -> ():
        let mut filler: Int = none
        let mut animFrame: Int = (o.header.gfx.animInfo.animFrame = (o.header.gfx.animInfo.animFrame + 1))
        let mut collisionFlags: Int = none
        (o.oForwardVel = 20.0)
        (collisionFlags = object_step())
        if ((animFrame == 5) || (animFrame == 16)):
            cur_obj_play_sound_2(SOUND_OBJ_BOBOMB_WALK)
        obj_turn_toward_object(o, gMarioObject, 16, 800)
        obj_check_floor_death(collisionFlags, sObjFloor)

    fn bobomb_act_launched(param_0: ()) -> ():
        let mut collisionFlags: Int = 0
        (collisionFlags = object_step())
        if ((collisionFlags & OBJ_COL_FLAG_GROUNDED) == OBJ_COL_FLAG_GROUNDED):
            (o.oAction = BOBOMB_ACT_EXPLODE)

    fn generic_bobomb_free_loop(param_0: ()) -> ():
        bobomb_check_interactions()
        if (o.oBobombFuseTimer > 150):
            (o.oAction = 3)

    fn stationary_bobomb_free_loop(param_0: ()) -> ():
        bobomb_check_interactions()
        if (o.oBobombFuseTimer > 150):
            (o.oAction = 3)

