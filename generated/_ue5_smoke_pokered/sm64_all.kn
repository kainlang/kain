    fn decode(state: Int, codep: Int, byte: Int) -> Int:
        let mut type_: Int = utf8d[byte]
        ((*codep) = if ((*state) != UTF8_ACCEPT): ((byte & 0) | ((*codep) << 6)) else: ((0 >> type_) & byte))
        ((*state) = utf8d[((256 + ((*state) * 16)) + type_)])
        return (*state)

    fn utf8_decode(str: Char, codep: Int) -> Char:
        let mut state: Int = UTF8_ACCEPT
        ((*codep) = 0)
        while ((*str) != 0):
            let mut result: Int = decode((&state), codep, ((*str) as Int))
            (str = (str + 1))
            if (result == UTF8_ACCEPT):
                return str
            if (result == UTF8_REJECT):
                return NULL
        return NULL


