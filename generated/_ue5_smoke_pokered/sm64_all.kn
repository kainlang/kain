    fn qsample(x: Float, scale: Int) -> Int:
        if (x > 0.0):
            return (((x / scale) + 0.4999999) as Int)
        else:
            return (((x / scale) - 0.4999999) as Int)

    fn clamp(fs: Int, e: Float, ie: Int, bits: Int) -> ():
        let mut i: Int = none
        let mut ulevel: Float = none
        let mut llevel: Float = none
        (llevel = (-((1 << (bits - 1)) as Float)))
        (ulevel = ((-llevel) - 1.0))
        (i = 0)
        while (i < fs):
            if (e[i] > ulevel):
                (e[i] = ulevel)
            if (e[i] < llevel):
                (e[i] = llevel)
            if (e[i] > 0.0):
                (ie[i] = ((e[i] + 0.5) as Int))
            else:
                (ie[i] = ((e[i] - 0.5) as Int))
            (i = (i + 1))

    fn clip(ix: Int, llevel: Int, ulevel: Int) -> Int:
        if ((ix < llevel) || (ix > ulevel)):
            if (ix < llevel):
                return llevel
            if (ix > ulevel):
                return ulevel
        return ix


