            else:
                approach_f32_ptr((&o.header.gfx.scale[0]), 3.0, 0.012)
                (o.oCloudFwooshMovementRadius = (o.oCloudFwooshMovementRadius + 0))
                if (o.oDistanceToMario < 1000.0):
                    if (o.oTimer > 100):
                        (o.oCloudBlowing = TRUE)
                        (o.oCloudGrowSpeed = 0.14)
                else:
                    (o.oTimer = 0)
                (o.oCloudCenterX = (o.oHomeX + (100.0 * coss(o.oCloudFwooshMovementRadius))))
                (o.oPosZ = (o.oHomeZ + (100.0 * sins(o.oCloudFwooshMovementRadius))))
                (o.oCloudCenterY = o.oHomeY)
            cur_obj_scale(o.header.gfx.scale[0])

    fn cloud_act_main(param_0: ()) -> ():
        let mut localOffsetPhase: Int = (800 * gGlobalTimer)
        let mut localOffset: Float = none
        if (o.parentObj != o):
            if (o.parentObj.activeFlags == ACTIVE_FLAG_DEACTIVATED):
                (o.oAction = CLOUD_ACT_UNLOAD)
            else:
                (o.oCloudCenterX = o.parentObj.oPosX)
                (o.oCloudCenterY = o.parentObj.oPosY)
                (o.oPosZ = o.parentObj.oPosZ)
                (o.oMoveAngleYaw = o.parentObj.oFaceAngleYaw)
        else:
            if (o.oBhvParams2ndByte != CLOUD_BP_FWOOSH):
                if (o.oDistanceToMario > 1500.0):
                    (o.oAction = CLOUD_ACT_UNLOAD)
            else:
                cloud_fwoosh_update()
        (localOffset = ((2 * coss(localOffsetPhase)) * o.header.gfx.scale[0]))
        (o.oPosX = (o.oCloudCenterX + localOffset))
        (o.oPosY = ((o.oCloudCenterY + localOffset) + (12.0 * o.header.gfx.scale[0])))

    fn cloud_act_unload(param_0: ()) -> ():
        if (o.oBhvParams2ndByte != CLOUD_BP_FWOOSH):
            obj_mark_for_deletion(o)
        else:
