mod src_game_behaviors_racing_penguin_inc:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    struct RacingPenguinData:
        dialogID: Int
        radius: Float
        height: Float

    struct RacingPenguinData:

    fn bhv_racing_penguin_init(param_0: ()) -> ():
        if (gMarioState.numStars == 120):
            cur_obj_scale(8.0)
            (o.header.gfx.scale[1] = 5.0)
            (o.oBhvParams2ndByte = RACING_PENGUIN_BP_FAT)

    fn racing_penguin_act_wait_for_mario(param_0: ()) -> ():
        if (((o.oTimer > o.oRacingPenguinInitTextCooldown) && ((o.oPosY - gMarioObject.oPosY) <= 0.0)) && cur_obj_can_mario_activate_textbox_2(400.0, 400.0)):
            (o.oAction = RACING_PENGUIN_ACT_SHOW_INIT_TEXT)

    fn racing_penguin_act_show_init_text(param_0: ()) -> ():
        let mut response: Int = obj_update_race_proposition_dialog(sRacingPenguinData[o.oBhvParams2ndByte].dialogID)
        if (response == DIALOG_RESPONSE_YES):
            let mut child: Object = none
            (child = cur_obj_nearest_object_with_behavior(bhvPenguinRaceFinishLine))
            (child.parentObj = o)
            (child = cur_obj_nearest_object_with_behavior(bhvPenguinRaceShortcutCheck))
            (child.parentObj = o)
            (o.oPathedStartWaypoint = (o.oPathedPrevWaypoint = segmented_to_virtual(ccm_seg7_trajectory_penguin_race)))
            (o.oPathedPrevWaypointFlags = 0)
            (o.oAction = RACING_PENGUIN_ACT_PREPARE_FOR_RACE)
            (o.oVelY = 60.0)
        else:
            if (response == DIALOG_RESPONSE_NO):
                (o.oAction = RACING_PENGUIN_ACT_WAIT_FOR_MARIO)
                (o.oRacingPenguinInitTextCooldown = 60)

    fn racing_penguin_act_prepare_for_race(param_0: ()) -> ():
        if obj_begin_race(TRUE):
            (o.oAction = RACING_PENGUIN_ACT_RACE)
            (o.oForwardVel = 20.0)
        cur_obj_rotate_yaw_toward(4000, 2500)

    fn racing_penguin_act_race(param_0: ()) -> ():
        if (cur_obj_follow_path(0) == PATH_REACHED_END):
            (o.oRacingPenguinReachedBottom = TRUE)
            (o.oAction = RACING_PENGUIN_ACT_FINISH_RACE)
        else:
            let mut targetSpeed: Float = (o.oPosY - gMarioObject.oPosY)
            let mut minSpeed: Float = 70.0
            cur_obj_play_sound_1(SOUND_AIR_ROUGH_SLIDE)
            if ((targetSpeed < 100.0) || ((o.oPathedPrevWaypointFlags & WAYPOINT_MASK_00FF) >= 35)):
                if ((o.oPathedPrevWaypointFlags & WAYPOINT_MASK_00FF) >= 35):
                    (minSpeed = 60.0)
                approach_f32_ptr((&o.oRacingPenguinWeightedNewTargetSpeed), (-500.0), 100.0)
            else:
                approach_f32_ptr((&o.oRacingPenguinWeightedNewTargetSpeed), 1000.0, 30.0)
            (targetSpeed = (0.1 * (o.oRacingPenguinWeightedNewTargetSpeed + targetSpeed)))
            clamp_f32((&targetSpeed), minSpeed, 150.0)
            obj_forward_vel_approach(targetSpeed, 0.4)
            cur_obj_init_animation_with_sound(1)
            cur_obj_rotate_yaw_toward(o.oPathedTargetYaw, ((15.0 * o.oForwardVel) as Int))
            if (cur_obj_check_if_at_animation_end() && (o.oMoveFlags & OBJ_MOVE_MASK_ON_GROUND)):
                spawn_object_relative_with_scale(0, 0, (-100), 0, 4.0, o, MODEL_SMOKE, bhvWhitePuffSmoke2)
        if mario_is_in_air_action():
            if (o.oTimer > 60):
                (o.oRacingPenguinMarioCheated = TRUE)
        else:
            (o.oTimer = 0)

    fn racing_penguin_act_finish_race(param_0: ()) -> ():
        if (o.oForwardVel != 0.0):
            if ((o.oTimer > 5) && (o.oMoveFlags & OBJ_MOVE_HIT_WALL)):
                cur_obj_play_sound_2(SOUND_OBJ_POUNDING_LOUD)
                set_camera_shake_from_point(SHAKE_POS_SMALL, o.oPosX, o.oPosY, o.oPosZ)
                (o.oForwardVel = 0.0)
        else:
            if cur_obj_init_anim_and_check_if_end(2):
                (o.oAction = RACING_PENGUIN_ACT_SHOW_FINAL_TEXT)

    fn racing_penguin_act_show_final_text(param_0: ()) -> ():
        if (o.oRacingPenguinFinalTextbox == 0):
            if cur_obj_rotate_yaw_toward(0, 200):
                cur_obj_init_animation_with_sound(3)
                (o.oForwardVel = 0.0)
                if cur_obj_can_mario_activate_textbox_2(400.0, 400.0):
                    if o.oRacingPenguinMarioWon:
                        if o.oRacingPenguinMarioCheated:
                            (o.oRacingPenguinFinalTextbox = DIALOG_132)
                            (o.oRacingPenguinMarioWon = FALSE)
                        else:
                            (o.oRacingPenguinFinalTextbox = DIALOG_056)
                    else:
                        (o.oRacingPenguinFinalTextbox = DIALOG_037)
            else:
                cur_obj_init_animation_with_sound(0)
                play_penguin_walking_sound(1)
                (o.oForwardVel = 4.0)
        else:
            if (o.oRacingPenguinFinalTextbox > 0):
                let mut textResult: Int = none
                if (textResult = cur_obj_update_dialog_with_cutscene(MARIO_DIALOG_LOOK_UP, DIALOG_FLAG_TURN_TO_MARIO, CUTSCENE_DIALOG, o.oRacingPenguinFinalTextbox)):
                    (o.oRacingPenguinFinalTextbox = (-1))
                    (o.oTimer = 0)
            else:
                if o.oRacingPenguinMarioWon:
                    cur_obj_spawn_star_at_y_offset((-7339.0), (-5700.0), (-6774.0), 200.0)
                    (o.oRacingPenguinMarioWon = FALSE)

    fn bhv_racing_penguin_update(param_0: ()) -> ():
        cur_obj_update_floor_and_walls()
        cur_obj_move_standard(78)
        cur_obj_align_gfx_with_floor()
        cur_obj_push_mario_away_from_cylinder(sRacingPenguinData[o.oBhvParams2ndByte].radius, sRacingPenguinData[o.oBhvParams2ndByte].height)

    fn bhv_penguin_race_finish_line_update(param_0: ()) -> ():
        if ((o.parentObj.oRacingPenguinReachedBottom || ((o.oDistanceToMario < 1000.0) && ((gMarioObject.oPosZ - o.oPosZ) < 0.0))) && (!o.parentObj.oRacingPenguinReachedBottom)):
            (o.parentObj.oRacingPenguinMarioWon = TRUE)

    fn bhv_penguin_race_shortcut_check_update(param_0: ()) -> ():
        if (o.oDistanceToMario < 500.0):
            (o.parentObj.oRacingPenguinMarioCheated = TRUE)


