                if (bodyPart != NULL):
                    obj_init_animation_with_sound(bodyPart, wiggler_seg5_anims_0500C874, 0)
                    (bodyPart.header.gfx.animInfo.animFrame = (((23 * i) % 26) - 1))
                (i = (i + 1))
            (o.oAction = WIGGLER_ACT_WALK)
