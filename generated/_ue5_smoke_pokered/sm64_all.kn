                    (o.oVelY = 0.0)
                if (o.oBhvParams2ndByte == 0):
                    (o.oNumLootCoins = 1)
                else:
                    (o.oNumLootCoins = 0)
                if obj_handle_attacks((&sPokeyBodyPartHitbox), o.oAction, sPokeyBodyPartAttackHandlers):
                    (o.parentObj.oPokeyNumAliveBodyParts = (o.parentObj.oPokeyNumAliveBodyParts - 1))
                    if (o.oBhvParams2ndByte == 0):
                        (o.parentObj.oPokeyHeadWasKilled = TRUE)
                        (o.oNumLootCoins = (-1))
                    (o.parentObj.oPokeyAliveBodyPartFlags = (o.parentObj.oPokeyAliveBodyPartFlags & ((1 << o.oBhvParams2ndByte) ^ (~0))))
                else:
                    if o.parentObj.oPokeyHeadWasKilled:
                        cur_obj_become_intangible()
                        if ((o.oPokeyBodyPartDeathDelayAfterHeadKilled = (o.oPokeyBodyPartDeathDelayAfterHeadKilled - 1)) < 0):
                            (o.parentObj.oPokeyNumAliveBodyParts = (o.parentObj.oPokeyNumAliveBodyParts - 1))
                            obj_die_if_health_non_positive()
                    else:
                        (o.oPokeyBodyPartDeathDelayAfterHeadKilled = ((o.oBhvParams2ndByte << 2) + 20))
                cur_obj_move_standard((-78))
        else:
            (o.oAnimState = 1)
        (o.oGraphYOffset = (o.header.gfx.scale[1] * 22.0))

    fn pokey_act_uninitialized(param_0: ()) -> ():
        let mut bodyPart: Object = none
        let mut i: Int = none
        let mut partModel: Int = none
        if (o.oDistanceToMario < 2000.0):
            (partModel = MODEL_POKEY_HEAD)
            (i = 0)
            while (i < 5):
                (bodyPart = spawn_object_relative(i, 0, (((-i) * 120) + 480), 0, o, partModel, bhvPokeyBodyPart))
                if (bodyPart != NULL):
                    obj_scale(bodyPart, 3.0)
                (partModel = MODEL_POKEY_BODY_PART)
                (i = (i + 1))
            (o.oPokeyAliveBodyPartFlags = 0)
            (o.oPokeyNumAliveBodyParts = 5)
            (o.oPokeyBottomBodyPartSize = 1.0)
            (o.oAction = POKEY_ACT_WANDER)

    fn pokey_act_wander(param_0: ()) -> ():
        let mut targetAngleOffset: Int = none
        if (o.oPokeyNumAliveBodyParts == 0):
            obj_mark_for_deletion(o)
        else:
            if (o.oDistanceToMario > 2500.0):
                (o.oAction = POKEY_ACT_UNLOAD_PARTS)
                (o.oForwardVel = 0.0)
            else:
                treat_far_home_as_mario(1000.0)
                cur_obj_update_floor_and_walls()
                if o.oPokeyHeadWasKilled:
                    (o.oForwardVel = 0.0)
                else:
                    (o.oForwardVel = 5.0)
                    if (o.oPokeyNumAliveBodyParts < 5):
                        if (o.oTimer > 100):
                            let mut bodyPart: Object = spawn_object_relative(o.oPokeyNumAliveBodyParts, 0, 0, 0, o, MODEL_POKEY_BODY_PART, bhvPokeyBodyPart)
                            if (bodyPart != NULL):
                                (o.oPokeyAliveBodyPartFlags = (o.oPokeyAliveBodyPartFlags | (1 << o.oPokeyNumAliveBodyParts)))
                                (o.oPokeyNumAliveBodyParts = (o.oPokeyNumAliveBodyParts + 1))
                                (o.oPokeyBottomBodyPartSize = 0.0)
                                obj_scale(bodyPart, 0.0)
                            (o.oTimer = 0)
                    else:
                        (o.oTimer = 0)
                    if o.oPokeyTurningAwayFromWall:
                        (o.oPokeyTurningAwayFromWall = obj_resolve_collisions_and_turn(o.oPokeyTargetYaw, 200))
                    else:
                        if (o.oDistanceToMario >= 25000.0):
                            (o.oPokeyTargetYaw = o.oAngleToMario)
                        if (!(o.oPokeyTurningAwayFromWall = obj_bounce_off_walls_edges_objects((&o.oPokeyTargetYaw)))):
                            if (o.oPokeyChangeTargetTimer != 0):
                                (o.oPokeyChangeTargetTimer = (o.oPokeyChangeTargetTimer - 1))
                            else:
                                if (o.oDistanceToMario > 2000.0):
                                    (o.oPokeyTargetYaw = obj_random_fixed_turn(2000))
                                    (o.oPokeyChangeTargetTimer = random_linear_offset(30, 50))
                                else:
                                    (targetAngleOffset = ((4000 - ((o.oDistanceToMario - 200.0) * 10.0)) as Int))
                                    if (targetAngleOffset < 0):
                                        (targetAngleOffset = 0)
                                    else:
                                        if (targetAngleOffset > 4000):
                                            (targetAngleOffset = 4000)
                                    if (((o.oAngleToMario - o.oMoveAngleYaw) as Int) > 0):
                                        (targetAngleOffset = (-targetAngleOffset))
                                    (o.oPokeyTargetYaw = (o.oAngleToMario + targetAngleOffset))
                        cur_obj_rotate_yaw_toward(o.oPokeyTargetYaw, 200)
                cur_obj_move_standard((-78))

    fn pokey_act_unload_parts(param_0: ()) -> ():
        (o.oAction = POKEY_ACT_UNINITIALIZED)
        cur_obj_set_pos_to_home()

    fn bhv_pokey_update(param_0: ()) -> ():
        (o.oDeathSound = SOUND_OBJ_POKEY_DEATH)


