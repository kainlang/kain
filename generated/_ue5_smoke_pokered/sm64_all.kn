        cur_obj_init_animation_with_sound(8)
        cur_obj_set_hitbox_radius_and_height(250.0, 200.0)
        cur_obj_set_hurtbox_radius_and_height(150.0, 100.0)
        if (o.oDistanceToMario < 400.0):
            if mario_moving_fast_enough_to_make_piranha_plant_bite():
                (o.oAction = PIRANHA_PLANT_ACT_WOKEN_UP)
        else:
            if (o.oDistanceToMario < 1000.0):
