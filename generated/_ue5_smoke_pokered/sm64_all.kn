        (pfs.queue = mq)
        (pfs.channel = channel)
        (pfs.status = 0)
        (pfs.activebank = 128)
        (i = 0)
        while (i < ARRAY_COUNT(temp)):
            (temp[i] = 254)
            (i = (i + 1))
        (ret = osContRamWrite(mq, channel, 1024, temp, FALSE))
        if (ret == 2):
            (ret = osContRamWrite(mq, channel, 1024, temp, FALSE))
        if (ret != 0):
            return ret
        (ret = osContRamRead(mq, channel, 1024, temp))
        if (ret == 2):
            (ret = PFS_ERR_CONTRFAIL)
        if (ret != 0):
            return ret
        if (temp[31] == 254):
