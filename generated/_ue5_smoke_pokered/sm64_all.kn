            obj_mark_for_deletion(o)
        else:
            let mut scale: Float = ((2.0 / 3.0) * o.parentObj.header.gfx.scale[0])
            let mut angleFromCenter: Int = (o.parentObj.oFaceAngleYaw + ((10000 / 5) * o.oBhvParams2ndByte))
            let mut localOffsetPhase: Int = ((800 * gGlobalTimer) + (4000 * o.oBhvParams2ndByte))
            let mut localOffset: Float = none
            let mut cloudRadius: Float = none
            cur_obj_scale(scale)
            if ((o.oBhvParams2ndByte == 5) && (scale > 2.0)):
                (scale = (o.header.gfx.scale[1] = 2.0))
            (localOffset = ((2 * coss(localOffsetPhase)) * scale))
            (cloudRadius = (25.0 * scale))
            (o.oPosX = ((o.parentObj.oCloudCenterX + (cloudRadius * sins(angleFromCenter))) + localOffset))
            (o.oPosY = ((o.parentObj.oCloudCenterY + localOffset) + (scale * sCloudPartHeights[o.oBhvParams2ndByte])))
            (o.oPosZ = ((o.parentObj.oPosZ + (cloudRadius * coss(angleFromCenter))) + localOffset))
            (o.oFaceAngleYaw = o.parentObj.oFaceAngleYaw)


