    fn RabbitizerUtils_From2Complement(number: Int, bits: Int) -> Int:
        let mut isNegative: Int = (number & (1 << (bits - 1)))
        if isNegative:
            return (-(((~number) + 1) & ((1 << bits) - 1)))
        return number

    fn RabbitizerUtils_CharFill(dst: Char, count: Int, fillchar: Char) -> Int:
        if (count <= 0):
            return 0
        memset(dst, fillchar, count)
        return count

    fn RabbitizerUtils_escapeString(dst: Char, dstSize: Int, src: Char, srcSize: Int) -> Int:
        let mut srcPos: Int = 0
        let mut dstpos: Int = 0
        while ((srcPos < srcSize) && (dstpos < dstSize)):
            (src = (src + 1))
        return dstpos


