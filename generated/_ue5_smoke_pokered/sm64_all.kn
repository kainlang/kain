        (starIndex = ((o.oBhvParams >> 24) & 0))
        if (bit_shift_left(starIndex) & save_file_get_star_flags((gCurrSaveFileNum - 1), COURSE_NUM_TO_INDEX(gCurrCourseNum))):
            cur_obj_set_model(MODEL_TRANSPARENT_STAR)
        cur_obj_play_sound_2(SOUND_GENERAL2_STAR_APPEARS)

    fn set_sparkle_spawn_star_hitbox(param_0: ()) -> ():
        obj_set_hitbox(o, (&sSparkleSpawnStarHitbox))
        if (o.oInteractStatus & INT_STATUS_INTERACTED):
            mark_obj_for_deletion(o)
            (o.oInteractStatus = 0)

    fn set_home_to_mario(param_0: ()) -> ():
        let mut sp1C: Float = none
        let mut sp18: Float = none
        (o.oHomeX = gMarioObject.oPosX)
        (o.oHomeZ = gMarioObject.oPosZ)
        (o.oHomeY = gMarioObject.oPosY)
        (o.oHomeY = (o.oHomeY + 250.0))
        (o.oPosY = o.oHomeY)
        (sp1C = (o.oHomeX - o.oPosX))
        (sp18 = (o.oHomeZ - o.oPosZ))
        (o.oForwardVel = (sqrtf(((sp1C * sp1C) + (sp18 * sp18))) / 23.0))

    fn set_y_home_to_pos(param_0: ()) -> ():
        (o.oForwardVel = 0.0)
        (o.oHomeY = o.oPosY)

    fn slow_star_rotation(param_0: ()) -> ():
        if (o.oAngleVelYaw > 400):
            (o.oAngleVelYaw = (o.oAngleVelYaw - 40))

    fn bhv_spawned_star_loop(param_0: ()) -> ():
        if (o.oAction == 0):
            if (o.oTimer == 0):
                cutscene_object(CUTSCENE_STAR_SPAWN, o)
                set_time_stop_flags((TIME_STOP_ENABLED | TIME_STOP_MARIO_AND_DOORS))
                (o.activeFlags = (o.activeFlags | ACTIVE_FLAG_INITIATED_TIME_STOP))
                (o.oAngleVelYaw = 800)
                if (o.oBhvParams2ndByte == 0):
                    set_home_to_mario()
                else:
                    set_y_home_to_pos()
                (o.oMoveAngleYaw = cur_obj_angle_to_home())
                (o.oVelY = 50.0)
                (o.oGravity = (-4.0))
                spawn_mist_particles()
            cur_obj_play_sound_1(SOUND_ENV_STAR)
            spawn_object(o, MODEL_NONE, bhvSparkleSpawn)
            if ((o.oVelY < 0) && (o.oPosY < o.oHomeY)):
                (o.oAction = (o.oAction + 1))
                (o.oForwardVel = 0)
                (o.oVelY = 20.0)
                (o.oGravity = (-1.0))
                if (o.oInteractionSubtype & INT_SUBTYPE_NO_EXIT):
                    play_power_star_jingle(TRUE)
                else:
                    play_power_star_jingle(TRUE)
        else:
            if (o.oAction == 1):
                if (o.oVelY < (-4.0)):
                    (o.oVelY = (-4.0))
                if ((o.oVelY < 0) && (o.oPosY < o.oHomeY)):
                    (gObjCutsceneDone = TRUE)
                    (o.oVelY = 0)
                    (o.oGravity = 0)
                    (o.oAction = (o.oAction + 1))
                spawn_object(o, MODEL_NONE, bhvSparkleSpawn)
            else:
                if (o.oAction == 2):
                    if ((gCamera.cutscene == 0) && (gRecentCutscene == 0)):
                        clear_time_stop_flags((TIME_STOP_ENABLED | TIME_STOP_MARIO_AND_DOORS))
                        (o.activeFlags = (o.activeFlags & (~ACTIVE_FLAG_INITIATED_TIME_STOP)))
                        (o.oAction = (o.oAction + 1))
                else:
                    set_sparkle_spawn_star_hitbox()
                    slow_star_rotation()
        cur_obj_move_using_fvel_and_gravity()
        (o.oFaceAngleYaw = (o.oFaceAngleYaw + o.oAngleVelYaw))
        (o.oInteractStatus = 0)

    fn bhv_spawn_star_no_level_exit(starIndex: Int) -> ():
        let mut star: Object = spawn_object(o, MODEL_STAR, bhvSpawnedStarNoLevelExit)
        (star.oBhvParams = (starIndex << 24))
        (star.oInteractionSubtype = INT_SUBTYPE_NO_EXIT)
        obj_set_angle(star, 0, 0, 0)


