                (n = (dn + 0.5))
            else:
                (n = (dn - 0.5))
            (dn = n)
            (dn = (dn - 0.5))
            (dx = (dx - (dn * pihi.d)))
            (dx = (dx - (dn * pilo.d)))
            (xsq = (dx * dx))
            (poly = ((((((P[4].d * xsq) + P[3].d) * xsq) + P[2].d) * xsq) + P[1].d))
            (result = (dx + ((dx * xsq) * poly)))
            if ((n & 1) == 0):
                return result
            else:
                return (-(result as Float))
        if (x != x):
            return NAN.f
        return zero.f


