    fn split(table: Float, delta: Float, order: Int, npredictors: Int, scale: Float) -> ():
        let mut i: Int = none
        let mut j: Int = none
        (i = 0)
        while (i < npredictors):
            (j = 0)
            while (j <= order):
                (table[(i + npredictors)][j] = (table[i][j] + (delta[j] * scale)))
                (j = (j + 1))
            (i = (i + 1))

    fn refine(table: Float, order: Int, npredictors: Int, data: Float, dataSize: Int, refineIters: Int, unused: Float) -> ():
        let mut iter: Int = none
        let mut rsums: Float = none
        let mut counts: Int = none
        let mut temp_s7: Float = none
        let mut dist: Float = none
        let mut dummy: Float = none
        let mut bestValue: Float = none
        let mut bestIndex: Int = none
        let mut i: Int = none
        let mut j: Int = none
        (rsums = malloc((npredictors * 8)))
        (i = 0)
        while (i < npredictors):
            (rsums[i] = malloc(((order + 1) * 8)))
            (i = (i + 1))
        (counts = malloc((npredictors * 8)))
        (temp_s7 = malloc(((order + 1) * 8)))
        (iter = 0)
        while (iter < refineIters):
            (i = 0)
            while (i < npredictors):
                (counts[i] = 0)
                (j = 0)
                while (j <= order):
                    (rsums[i][j] = 0.0)
                    (j = (j + 1))
                (i = (i + 1))
            (i = 0)
            while (i < dataSize):
                (bestValue = 1000000000000000000000000000000.0)
                (bestIndex = 0)
                (j = 0)
                while (j < npredictors):
                    (dist = model_dist(table[j], data[i], order))
                    if (dist < bestValue):
                        (bestValue = dist)
                        (bestIndex = j)
                    (j = (j + 1))
                (counts[bestIndex] = (counts[bestIndex] + 1))
                rfroma(data[i], order, temp_s7)
                (j = 0)
                while (j <= order):
                    (rsums[bestIndex][j] = (rsums[bestIndex][j] + temp_s7[j]))
                    (j = (j + 1))
                (i = (i + 1))
            (i = 0)
            while (i < npredictors):
                if (counts[i] > 0):
                    (j = 0)
                    while (j <= order):
                        (rsums[i][j] = (rsums[i][j] / counts[i]))
                        (j = (j + 1))
                (i = (i + 1))
