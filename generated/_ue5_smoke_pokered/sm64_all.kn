    struct OSContRamReadFormat:

    fn osSpRawStartDma(dir: Int, sp_ptr: (), dram_ptr: (), size: Int) -> Int:
        if osSpDeviceBusy():
            return (-1)
        IO_WRITE(SP_MEM_ADDR_REG, sp_ptr)
        IO_WRITE(SP_DRAM_ADDR_REG, osVirtualToPhysical(dram_ptr))
