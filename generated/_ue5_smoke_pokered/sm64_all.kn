        if ((*blinkTimer) == 0):
            if (((random_float() * 100.0) as Int) == 0):
                (o.oAnimState = 1)
                ((*blinkTimer) = 1)
        else:
            ((*blinkTimer) = ((*blinkTimer) + 1))
            if ((*blinkTimer) > 5):
                (o.oAnimState = 0)
            if ((*blinkTimer) > 10):
                (o.oAnimState = 1)
            if ((*blinkTimer) > 15):
                (o.oAnimState = 0)
                ((*blinkTimer) = 0)

