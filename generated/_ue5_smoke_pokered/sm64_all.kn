    fn n64cksum_calc_6102(buf: Int, cksum: Int) -> ():
        let mut t2: Int = none
        let mut t3: Int = none
        let mut t4: Int = none
        let mut t6: Int = none
        let mut t7: Int = none
        let mut t8: Int = none
        let mut s0: Int = none
        let mut a0: Int = none
        let mut a1: Int = none
        let mut a2: Int = none
        let mut a3: Int = none
        let mut v0: Int = none
        let mut v1: Int = none
        let mut seed: Int = none
        let mut end_offset: Int = none
        let mut cur_offset: Int = none
        let mut buf_offset: Int = none
        (seed = 0)
        (end_offset = 100000)
        (cur_offset = 0)
        (buf_offset = 1000)
        (seed = (seed + 1))
        (a3 = seed)
        (t2 = seed)
        (t3 = seed)
        (s0 = seed)
        (a2 = seed)
        (t4 = seed)
        (cksum[0] = ((a3 ^ t2) ^ t3))
        (cksum[1] = ((s0 ^ a2) ^ t4))

    fn n64cksum_update_checksums(buf: Int) -> ():
        let mut cksum_offsets: Int = [10, 14]
        let mut read_cksum: Int = none
        let mut calc_cksum: Int = none
        let mut i: Int = none
        INFO("\"BootChip: CIC-NUS-6102\\n\"")
        n64cksum_calc_6102(buf, calc_cksum)
        (i = 0)
        while (i < 2):
            (read_cksum[i] = read_u32_be((&buf[cksum_offsets[i]])))
            INFO("\"CRC%d: 0x%08X \"", (i + 1), read_cksum[i])
            INFO("\"Calculated: 0x%08X \"", calc_cksum[i])
            if (calc_cksum[i] == read_cksum[i]):
                INFO("\"(Good)\\n\"")
            else:
                INFO("\"(Bad)\\n\"")
            (i = (i + 1))
        INFO("\"Writing back calculated Checksum\\n\"")
        write_u32_be((&buf[cksum_offsets[0]]), calc_cksum[0])
        write_u32_be((&buf[cksum_offsets[1]]), calc_cksum[1])


mod tools_utf8:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

