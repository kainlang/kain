    fn butterfly_step(speed: Int) -> ():
        let mut sp24: FloorGeometry = none
        let mut yaw: Int = o.oMoveAngleYaw
        let mut pitch: Int = o.oMoveAnglePitch
        let mut yPhase: Int = o.oButterflyYPhase
        let mut floorY: Float = none
