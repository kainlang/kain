            if ((gMarioObject.oPosY < o.oPosY) || cur_obj_update_dialog_with_cutscene(MARIO_DIALOG_LOOK_UP, DIALOG_FLAG_NONE, CUTSCENE_DIALOG, DIALOG_150)):
                (o.oWigglerTextStatus = WIGGLER_TEXT_STATUS_COMPLETED_DIALOG)
        else:
