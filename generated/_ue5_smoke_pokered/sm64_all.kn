mod lib_src_contramread:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    fn osContRamRead(mq: OSMesgQueue, channel: Int, address: Int, buffer: Int) -> Int:
        let mut ret: Int = none
        let mut i: Int = none
        let mut ptr: Int = none
        let mut ramreadformat: OSContRamReadFormat_2 = none
        let mut retry: Int = none
        (ret = 0)
        (ptr = ((&osPfsPifRam) as Int))
        (retry = 2)
        osSiGetAccess()
        (osContLastCmd = CONT_CMD_READ_MEMPACK)
        osPackRamReadData(channel, address)
        (ret = osSiRawStartDma(OS_WRITE, (&osPfsPifRam)))
        osRecvMesg(mq, NULL, OS_MESG_BLOCK)
        osSiRelAccess()
        return ret

    fn osPackRamReadData(channel: Int, address: Int) -> ():
        let mut ptr: Int = none
        let mut ramreadformat: OSContRamReadFormat_2 = none
        let mut i: Int = none
        (ptr = (osPfsPifRam.ramarray as Int))
        (i = 0)
        while (i < (ARRAY_COUNT(osPfsPifRam.ramarray) + 1)):
            (osPfsPifRam.ramarray[i] = 0)
            (i = (i + 1))
        (osPfsPifRam.pifstatus = CONT_CMD_EXE)
        (ramreadformat.dummy = CONT_CMD_NOP)
        (ramreadformat.txsize = CONT_CMD_READ_MEMPACK_TX)
        (ramreadformat.rxsize = CONT_CMD_READ_MEMPACK_RX)
        (ramreadformat.cmd = CONT_CMD_READ_MEMPACK)
        (ramreadformat.address = ((address << 5) | osContAddressCrc(address)))
        (ramreadformat.datacrc = CONT_CMD_NOP)
        (i = 0)
        while (i < ARRAY_COUNT(ramreadformat.data)):
            (ramreadformat.data[i] = CONT_CMD_NOP)
            (i = (i + 1))
        if (channel != 0):
            (i = 0)
            while (i < channel):
                ((*(ptr = (ptr + 1))) = 0)
                (i = (i + 1))
        ((*(ptr as OSContRamReadFormat_2)) = ramreadformat)
        (ptr = (ptr + 8))
        (ptr[0] = CONT_CMD_END)


mod lib_src_contramwrite:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    fn osContRamWrite(mq: OSMesgQueue, channel: Int, address: Int, buffer: Int, force: Int) -> Int:
        let mut ret: Int = none
        let mut i: Int = none
        let mut ptr: Int = none
        let mut ramreadformat: OSContRamReadFormat_2 = none
        let mut retry: Int = none
        (ret = 0)
        (ptr = ((&osPfsPifRam) as Int))
        (retry = 2)
        if (((force != 1) && (address < 7)) && (address != 0)):
            return 0
        osSiGetAccess()
        (osContLastCmd = CONT_CMD_WRITE_MEMPACK)
        osPackRamWriteData(channel, address, buffer)
        (ret = osSiRawStartDma(OS_WRITE, (&osPfsPifRam)))
        osRecvMesg(mq, NULL, OS_MESG_BLOCK)
        osSiRelAccess()
        return ret

    fn osPackRamWriteData(channel: Int, address: Int, buffer: Int) -> ():
        let mut ptr: Int = none
        let mut ramreadformat: OSContRamReadFormat_2 = none
        let mut i: Int = none
        (ptr = (osPfsPifRam.ramarray as Int))
        (i = 0)
        while (i < (ARRAY_COUNT(osPfsPifRam.ramarray) + 1)):
            (osPfsPifRam.ramarray[i] = 0)
            (i = (i + 1))
        (osPfsPifRam.pifstatus = CONT_CMD_EXE)
        (ramreadformat.dummy = CONT_CMD_NOP)
        (ramreadformat.txsize = CONT_CMD_WRITE_MEMPACK_TX)
        (ramreadformat.rxsize = CONT_CMD_WRITE_MEMPACK_RX)
        (ramreadformat.cmd = CONT_CMD_WRITE_MEMPACK)
        (ramreadformat.address = ((address << 5) | osContAddressCrc(address)))
        (ramreadformat.datacrc = CONT_CMD_NOP)
        (i = 0)
        while (i < ARRAY_COUNT(ramreadformat.data)):
            (ramreadformat.data[i] = (*(buffer = (buffer + 1))))
            (i = (i + 1))
        if (channel != 0):
            (i = 0)
            while (i < channel):
                ((*(ptr = (ptr + 1))) = 0)
                (i = (i + 1))
        ((*(ptr as OSContRamReadFormat_2)) = ramreadformat)
        (ptr = (ptr + 8))
        (ptr[0] = CONT_CMD_END)


mod lib_src_crc:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    fn osContAddressCrc(addr: Int) -> Int:
        let mut temp: Int = none
        let mut temp2: Int = none
        let mut i: Int = none
        (temp = 0)
        (i = 0)
        while (i < 16):
            if (temp & 10):
                (temp2 = 21)
            else:
                (temp2 = 0)
            (temp = (temp << 1))
            (temp = (temp | (if (addr & 400): 1 else: 0 as Int)))
            (addr = (addr << 1))
            (temp = (temp ^ temp2))
            (i = (i + 1))
        return (temp & 0)

    fn osContDataCrc(data: Int) -> Int:
        let mut temp: Int = none
        let mut temp2: Int = none
        let mut i: Int = none
        let mut j: Int = none
        (temp = 0)
        (i = 0)
        while (i <= 32):
            (j = 7)
            while (j >= 0):
                if (temp & 80):
                    (temp2 = 133)
                else:
                    (temp2 = 0)
                (temp = (temp << 1))
                if (i == 32):
                    (temp = (temp & (-1)))
                else:
                    (temp = (temp | if ((*data) & (1 << j)): 1 else: 0))
                (temp = (temp ^ temp2))
                (j = (j - 1))
            (data = (data + 1))
        return temp


