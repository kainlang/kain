                ((segments + i).posX = o.oPosX)
                ((segments + i).posY = o.oPosY)
                ((segments + i).posZ = o.oPosZ)
                ((segments + i).pitch = o.oFaceAnglePitch)
                ((segments + i).yaw = o.oFaceAngleYaw)
