mod lib_src_ossirawstartdma:
    struct FILE:

    struct OSPfs:

    struct OSMesgQueue:

    struct OSPifRam:

    struct OSMesg:

    struct OSThread:

    struct OSTimer:

    struct OSContRamReadFormat:

    fn osSiRawStartDma(dir: Int, addr: ()) -> Int:
        if osSiDeviceBusy():
            return (-1)
        if (dir == OS_WRITE):
            osWritebackDCache(addr, 64)
        IO_WRITE(SI_DRAM_ADDR_REG, osVirtualToPhysical(addr))
        if (dir == OS_READ):
            IO_WRITE(SI_PIF_ADDR_RD64B_REG, 0)
        else:
            IO_WRITE(SI_PIF_ADDR_WR64B_REG, 0)
        if (dir == OS_READ):
            osInvalDCache(addr, 64)
        return 0


