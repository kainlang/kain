fn z80_plotpixel(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [PlotPixel:202] PUSH BC
    # [PlotPixel:203] LD A, C
    # [PlotPixel:204] AND $07
    # [PlotPixel:205] LD E, A
    # [PlotPixel:206] LD A, C
    # [PlotPixel:207] RRA 
    # [PlotPixel:208] RRA 
    # [PlotPixel:209] RRA 
    # [PlotPixel:210] AND $1F
    # [PlotPixel:211] LD D, A
    # [PlotPixel:212] LD A, B
    # [PlotPixel:213] RRA 
    # [PlotPixel:214] RRA 
    # [PlotPixel:215] RRA 
    # [PlotPixel:216] AND $1F
    # [PlotPixel:217] OR D
    # [PlotPixel:218] LD D, A
    # [PlotPixel:219] LD A, $40
    # [PlotPixel:220] OR D
    # [PlotPixel:221] LD D, A
    # [PlotPixel:222] LD A, B
    # [PlotPixel:223] AND $07
    # [PlotPixel:224] LD B, A
    # [PlotPixel:225] LD A, $80
    return (next_cpu, next_mem)

