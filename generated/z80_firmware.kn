    # [.shift_loop:230] LD A, (DE)
    # [.shift_loop:231] OR B
    # [.shift_loop:232] LD (DE), A
    # [.shift_loop:233] POP BC
    # [.shift_loop:234] RET 
    return (next_cpu, next_mem)

