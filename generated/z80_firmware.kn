    # [.clear_loop:35] LD (HL), 0
    # [.clear_loop:36] INC HL
    # [.clear_loop:37] DEC BC
    # [.clear_loop:38] LD A, B
    # [.clear_loop:39] OR C
    # [.clear_loop:40] JR NZ, .clear_loop
    # [.clear_loop:41] RET 
