fn fw_tbl4_m411(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # L287 AND SEEK) DHMDB 20 MOTOR DELAY BETWEEN STEPSDB 155 133 0 0 147 133DB FFh A-291
    return (next_cpu, next_mem)

@component
struct FurbyFirmwareComponent:
    cpu_a: Int
    cpu_x: Int
    cpu_y: Int
    bank: Int

actor FurbyActor:
    state tick_count: Int = 0
    on Tick():
        tick_count = tick_count + 1

@component
struct FurbyDebugComponent:
    last_trace_tick: Int
    last_pc: Int
