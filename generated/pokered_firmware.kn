fn gb_shakeelevator(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [ShakeElevator:46726] LD de, -$20
    # [ShakeElevator:46727] CALL ShakeElevatorRedrawRow
    # [ShakeElevator:46728] LD de, SCREEN_HEIGHT * $20
    # [ShakeElevator:46729] CALL ShakeElevatorRedrawRow
    # [ShakeElevator:46730] CALL Delay3
    # [ShakeElevator:46731] LD a, SFX_STOP_ALL_MUSIC
    # [ShakeElevator:46732] CALL PlaySound
    # [ShakeElevator:46733] LDH a, [hSCY]
    # [ShakeElevator:46734] LD d, a
    # [ShakeElevator:46735] LD e, $1
    # [ShakeElevator:46736] LD b, 100
    # [ShakeElevator:46738] LD a, e
    # [ShakeElevator:46739] XOR $fe
    # [ShakeElevator:46740] LD e, a
    # [ShakeElevator:46741] ADD d
    # [ShakeElevator:46742] LDH [hSCY], a
    # [ShakeElevator:46743] PUSH bc
    # [ShakeElevator:46744] LD c, BANK(SFX_Collision_1)
    # [ShakeElevator:46745] LD a, SFX_COLLISION
    # [ShakeElevator:46746] CALL PlayMusic
    # [ShakeElevator:46747] POP bc
    # [ShakeElevator:46748] LD c, 2
    # [ShakeElevator:46749] CALL DelayFrames
    # [ShakeElevator:46750] DEC b
    # [ShakeElevator:46751] JR nz, .shakeLoop
    # [ShakeElevator:46752] LD a, d
    # [ShakeElevator:46753] LDH [hSCY], a
    # [ShakeElevator:46754] LD a, SFX_STOP_ALL_MUSIC
    # [ShakeElevator:46755] CALL PlaySound
    # [ShakeElevator:46756] LD c, BANK(SFX_Safari_Zone_PA)
    # [ShakeElevator:46757] LD a, SFX_SAFARI_ZONE_PA
    # [ShakeElevator:46758] CALL PlayMusic
    # [ShakeElevator:46760] LD a, [wChannelSoundIDs + CHAN5]
    # [ShakeElevator:46761] CP SFX_SAFARI_ZONE_PA
    # [ShakeElevator:46762] JR z, .musicLoop
    # [ShakeElevator:46763] CALL UpdateSprites
    # [ShakeElevator:46764] JP PlayDefaultMusic
    return (next_cpu, next_mem)

fn gb_shakeelevatorredrawrow(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [ShakeElevatorRedrawRow:46769] LD hl, wMapViewVRAMPointer + 1
    # [ShakeElevatorRedrawRow:46770] LD a, [hld]
    # [ShakeElevatorRedrawRow:46771] PUSH af
    # [ShakeElevatorRedrawRow:46772] LD a, [hl]
    # [ShakeElevatorRedrawRow:46773] PUSH af
    # [ShakeElevatorRedrawRow:46774] PUSH hl
    # [ShakeElevatorRedrawRow:46775] PUSH hl
    # [ShakeElevatorRedrawRow:46776] LD a, [hli]
    # [ShakeElevatorRedrawRow:46777] LD h, [hl]
    # [ShakeElevatorRedrawRow:46778] LD l, a
    # [ShakeElevatorRedrawRow:46779] ADD hl, de
    # [ShakeElevatorRedrawRow:46780] LD a, h
    # [ShakeElevatorRedrawRow:46781] AND $3
    # [ShakeElevatorRedrawRow:46782] OR HIGH(vBGMap0)
    # [ShakeElevatorRedrawRow:46783] LD d, a
    # [ShakeElevatorRedrawRow:46784] LD a, l
    # [ShakeElevatorRedrawRow:46785] POP hl
    # [ShakeElevatorRedrawRow:46786] LD [hli], a
    # [ShakeElevatorRedrawRow:46787] LD [hl], d
    # [ShakeElevatorRedrawRow:46788] CALL ScheduleNorthRowRedraw
    # [ShakeElevatorRedrawRow:46789] POP hl
    # [ShakeElevatorRedrawRow:46790] POP af
    # [ShakeElevatorRedrawRow:46791] LD [hli], a
    # [ShakeElevatorRedrawRow:46792] POP af
    # [ShakeElevatorRedrawRow:46793] LD [hl], a
    # [ShakeElevatorRedrawRow:46794] JP Delay3
    return (next_cpu, next_mem)

