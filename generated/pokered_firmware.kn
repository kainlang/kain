    # [AIRecoverHP:21498] LD a, [hl]
    # [AIRecoverHP:21499] LD [wHPBarOldHP], a
    # [AIRecoverHP:21500] ADD b
    # [AIRecoverHP:21501] LD [hld], a
    # [AIRecoverHP:21502] LD [wHPBarNewHP], a
    # [AIRecoverHP:21503] LD a, [hl]
    # [AIRecoverHP:21504] LD [wHPBarOldHP+1], a
    # [AIRecoverHP:21505] LD [wHPBarNewHP+1], a
