    # [CheckPlayerStatusConditions:25742] LD a, [wPlayerDisabledMoveNumber]
    # [CheckPlayerStatusConditions:25743] AND a
    # [CheckPlayerStatusConditions:25744] JR z, .ParalysisCheck
    # [CheckPlayerStatusConditions:25745] LD hl, wPlayerSelectedMove
    # [CheckPlayerStatusConditions:25746] CP [hl]
    # [CheckPlayerStatusConditions:25747] JR nz, .ParalysisCheck
    # [CheckPlayerStatusConditions:25748] CALL PrintMoveIsDisabledText
    # [CheckPlayerStatusConditions:25749] LD hl, ExecutePlayerMoveDone
    # [CheckPlayerStatusConditions:25750] JP .returnToHL
    # [CheckPlayerStatusConditions:25752] LD hl, wBattleMonStatus
    # [CheckPlayerStatusConditions:25753] BIT PAR, [hl]
    # [CheckPlayerStatusConditions:25754] JR z, .BideCheck
    # [CheckPlayerStatusConditions:25755] CALL BattleRandom
    # [CheckPlayerStatusConditions:25756] CP 25 percent
    # [CheckPlayerStatusConditions:25757] JR nc, .BideCheck
    # [CheckPlayerStatusConditions:25758] LD hl, FullyParalyzedText
    # [CheckPlayerStatusConditions:25759] CALL PrintText
    # [CheckPlayerStatusConditions:25761] LD hl, wPlayerBattleStatus1
    # [CheckPlayerStatusConditions:25762] LD a, [hl]
    # [CheckPlayerStatusConditions:25764] AND ~((1 << STORING_ENERGY) | (1 << THRASHING_ABOUT) | (1 << CHARGING_UP) | (1 << USING_TRAPPING_MOVE))
    # [CheckPlayerStatusConditions:25765] LD [hl], a
    # [CheckPlayerStatusConditions:25766] LD a, [wPlayerMoveEffect]
    # [CheckPlayerStatusConditions:25767] CP FLY_EFFECT
    # [CheckPlayerStatusConditions:25768] JR z, .FlyOrChargeEffect
    # [CheckPlayerStatusConditions:25769] CP CHARGE_EFFECT
    # [CheckPlayerStatusConditions:25770] JR z, .FlyOrChargeEffect
    # [CheckPlayerStatusConditions:25771] JR .NotFlyOrChargeEffect
    # [CheckPlayerStatusConditions:25773] XOR a
    # [CheckPlayerStatusConditions:25774] LD [wAnimationType], a
    # [CheckPlayerStatusConditions:25775] LD a, STATUS_AFFECTED_ANIM
    # [CheckPlayerStatusConditions:25776] CALL PlayMoveAnimation
    # [CheckPlayerStatusConditions:25778] LD hl, ExecutePlayerMoveDone
    # [CheckPlayerStatusConditions:25779] JP .returnToHL
    # [CheckPlayerStatusConditions:25781] LD hl, wPlayerBattleStatus1
    # [CheckPlayerStatusConditions:25782] BIT STORING_ENERGY, [hl]
    # [CheckPlayerStatusConditions:25783] JR z, .ThrashingAboutCheck
    # [CheckPlayerStatusConditions:25784] XOR a
    # [CheckPlayerStatusConditions:25785] LD [wPlayerMoveNum], a
    # [CheckPlayerStatusConditions:25786] LD hl, wDamage
    # [CheckPlayerStatusConditions:25787] LD a, [hli]
    # [CheckPlayerStatusConditions:25788] LD b, a
    # [CheckPlayerStatusConditions:25789] LD c, [hl]
    # [CheckPlayerStatusConditions:25790] LD hl, wPlayerBideAccumulatedDamage + 1
    # [CheckPlayerStatusConditions:25791] LD a, [hl]
    # [CheckPlayerStatusConditions:25792] ADD c
    # [CheckPlayerStatusConditions:25793] LD [hld], a
    # [CheckPlayerStatusConditions:25794] LD a, [hl]
    # [CheckPlayerStatusConditions:25795] ADC b
    # [CheckPlayerStatusConditions:25796] LD [hl], a
    # [CheckPlayerStatusConditions:25797] LD hl, wPlayerNumAttacksLeft
    # [CheckPlayerStatusConditions:25798] DEC [hl]
    # [CheckPlayerStatusConditions:25799] JR z, .UnleashEnergy
    # [CheckPlayerStatusConditions:25800] LD hl, ExecutePlayerMoveDone
    # [CheckPlayerStatusConditions:25801] JP .returnToHL
    # [CheckPlayerStatusConditions:25803] LD hl, wPlayerBattleStatus1
    # [CheckPlayerStatusConditions:25804] RES STORING_ENERGY, [hl]
    # [CheckPlayerStatusConditions:25805] LD hl, UnleashedEnergyText
    # [CheckPlayerStatusConditions:25806] CALL PrintText
    # [CheckPlayerStatusConditions:25807] LD a, 1
    # [CheckPlayerStatusConditions:25808] LD [wPlayerMovePower], a
    # [CheckPlayerStatusConditions:25809] LD hl, wPlayerBideAccumulatedDamage + 1
    # [CheckPlayerStatusConditions:25810] LD a, [hld]
    # [CheckPlayerStatusConditions:25811] ADD a
    # [CheckPlayerStatusConditions:25812] LD b, a
    # [CheckPlayerStatusConditions:25813] LD [wDamage + 1], a
    # [CheckPlayerStatusConditions:25814] LD a, [hl]
    # [CheckPlayerStatusConditions:25815] RL a
    # [CheckPlayerStatusConditions:25816] LD [wDamage], a
    # [CheckPlayerStatusConditions:25817] OR b
    # [CheckPlayerStatusConditions:25818] JR nz, .next
    # [CheckPlayerStatusConditions:25819] LD a, 1
    # [CheckPlayerStatusConditions:25820] LD [wMoveMissed], a
    # [CheckPlayerStatusConditions:25822] XOR a
    # [CheckPlayerStatusConditions:25823] LD [hli], a
    # [CheckPlayerStatusConditions:25824] LD [hl], a
    # [CheckPlayerStatusConditions:25825] LD a, BIDE
    # [CheckPlayerStatusConditions:25826] LD [wPlayerMoveNum], a
    # [CheckPlayerStatusConditions:25827] LD hl, HandleIfPlayerMoveMissed
    # [CheckPlayerStatusConditions:25828] JP .returnToHL
    # [CheckPlayerStatusConditions:25830] BIT THRASHING_ABOUT, [hl]
