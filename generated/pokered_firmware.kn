    # [StatModifierUpEffect:29687] ADD hl, bc
    # [StatModifierUpEffect:29688] LD b, [hl]
    # [StatModifierUpEffect:29689] INC b
    # [StatModifierUpEffect:29690] LD a, $d
    # [StatModifierUpEffect:29691] CP b
    # [StatModifierUpEffect:29692] JP c, PrintNothingHappenedText
    # [StatModifierUpEffect:29693] LD a, [de]
    # [StatModifierUpEffect:29694] CP ATTACK_UP1_EFFECT + $8
    # [StatModifierUpEffect:29695] JR c, .ok
    # [StatModifierUpEffect:29696] INC b
    # [StatModifierUpEffect:29697] LD a, $d
    # [StatModifierUpEffect:29698] CP b
    # [StatModifierUpEffect:29699] JR nc, .ok
    # [StatModifierUpEffect:29700] LD b, a
    # [StatModifierUpEffect:29702] LD [hl], b
    # [StatModifierUpEffect:29703] LD a, c
    # [StatModifierUpEffect:29704] CP $4
    # [StatModifierUpEffect:29705] JR nc, UpdateStatDone
    # [StatModifierUpEffect:29706] PUSH hl
    # [StatModifierUpEffect:29707] LD hl, wBattleMonAttack + 1
    # [StatModifierUpEffect:29708] LD de, wPlayerMonUnmodifiedAttack
    # [StatModifierUpEffect:29709] LDH a, [hWhoseTurn]
    # [StatModifierUpEffect:29710] AND a
    # [StatModifierUpEffect:29711] JR z, .pointToStats
    # [StatModifierUpEffect:29712] LD hl, wEnemyMonAttack + 1
    # [StatModifierUpEffect:29713] LD de, wEnemyMonUnmodifiedAttack
    # [StatModifierUpEffect:29715] PUSH bc
    # [StatModifierUpEffect:29716] SLA c
    # [StatModifierUpEffect:29717] LD b, $0
    # [StatModifierUpEffect:29718] ADD hl, bc
    # [StatModifierUpEffect:29719] LD a, c
    # [StatModifierUpEffect:29720] ADD e
    # [StatModifierUpEffect:29721] LD e, a
    # [StatModifierUpEffect:29722] JR nc, .checkIf999
    # [StatModifierUpEffect:29723] INC d
    # [StatModifierUpEffect:29725] POP bc
    # [StatModifierUpEffect:29727] LD a, [hld]
    # [StatModifierUpEffect:29728] SUB LOW(MAX_STAT_VALUE)
    # [StatModifierUpEffect:29729] JR nz, .recalculateStat
    # [StatModifierUpEffect:29730] LD a, [hl]
    # [StatModifierUpEffect:29731] SBC HIGH(MAX_STAT_VALUE)
    # [StatModifierUpEffect:29732] JP z, RestoreOriginalStatModifier
    # [StatModifierUpEffect:29735] PUSH hl
    # [StatModifierUpEffect:29736] PUSH bc
    # [StatModifierUpEffect:29737] LD hl, StatModifierRatios
    # [StatModifierUpEffect:29738] DEC b
    # [StatModifierUpEffect:29739] SLA b
    # [StatModifierUpEffect:29740] LD c, b
    # [StatModifierUpEffect:29741] LD b, $0
    # [StatModifierUpEffect:29742] ADD hl, bc
    # [StatModifierUpEffect:29743] POP bc
    # [StatModifierUpEffect:29744] XOR a
    # [StatModifierUpEffect:29745] LDH [hMultiplicand], a
    # [StatModifierUpEffect:29746] LD a, [de]
    # [StatModifierUpEffect:29747] LDH [hMultiplicand + 1], a
    # [StatModifierUpEffect:29748] INC de
    # [StatModifierUpEffect:29749] LD a, [de]
    # [StatModifierUpEffect:29750] LDH [hMultiplicand + 2], a
    # [StatModifierUpEffect:29751] LD a, [hli]
    # [StatModifierUpEffect:29752] LDH [hMultiplier], a
    # [StatModifierUpEffect:29753] CALL Multiply
    # [StatModifierUpEffect:29754] LD a, [hl]
    # [StatModifierUpEffect:29755] LDH [hDivisor], a
    # [StatModifierUpEffect:29756] LD b, $4
    # [StatModifierUpEffect:29757] CALL Divide
    # [StatModifierUpEffect:29758] POP hl
    # [StatModifierUpEffect:29760] LDH a, [hProduct + 3]
    # [StatModifierUpEffect:29761] SUB LOW(MAX_STAT_VALUE)
    # [StatModifierUpEffect:29762] LDH a, [hProduct + 2]
    # [StatModifierUpEffect:29763] SBC HIGH(MAX_STAT_VALUE)
    # [StatModifierUpEffect:29764] JP c, UpdateStat
    # [StatModifierUpEffect:29765] LD a, HIGH(MAX_STAT_VALUE)
    # [StatModifierUpEffect:29766] LDH [hMultiplicand + 1], a
    # [StatModifierUpEffect:29767] LD a, LOW(MAX_STAT_VALUE)
    # [StatModifierUpEffect:29768] LDH [hMultiplicand + 2], a
    return (next_cpu, next_mem)

