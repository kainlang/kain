    # [CalculateModifiedStat:28861] LD c, b
    # [CalculateModifiedStat:28862] LD b, 0
    # [CalculateModifiedStat:28863] ADD hl, bc
    # [CalculateModifiedStat:28864] XOR a
    # [CalculateModifiedStat:28865] LDH [hMultiplicand], a
    # [CalculateModifiedStat:28866] LD a, [de]
    # [CalculateModifiedStat:28867] LDH [hMultiplicand + 1], a
    # [CalculateModifiedStat:28868] INC de
    # [CalculateModifiedStat:28869] LD a, [de]
    # [CalculateModifiedStat:28870] LDH [hMultiplicand + 2], a
    # [CalculateModifiedStat:28871] LD a, [hli]
