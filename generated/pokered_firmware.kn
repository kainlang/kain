fn gb_calculatemodifiedstat(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [CalculateModifiedStat:28551] PUSH bc
    # [CalculateModifiedStat:28552] PUSH bc
    # [CalculateModifiedStat:28553] LD a, [wCalculateWhoseStats]
    # [CalculateModifiedStat:28554] AND a
    # [CalculateModifiedStat:28555] LD a, c
    # [CalculateModifiedStat:28556] LD hl, wBattleMonAttack
