    # [Credits:40268] JR z, .showCopyrightText
    # [Credits:40269] CP CRED_THE_END
    # [Credits:40270] JR z, .showTheEnd
    # [Credits:40271] PUSH hl
    # [Credits:40272] PUSH hl
    # [Credits:40273] LD hl, CreditsTextPointers
    # [Credits:40274] ADD a
    # [Credits:40275] LD c, a
    # [Credits:40276] LD b, 0
    # [Credits:40277] ADD hl, bc
    # [Credits:40278] LD e, [hl]
    # [Credits:40279] INC hl
    # [Credits:40280] LD d, [hl]
    # [Credits:40281] LD a, [de]
    # [Credits:40282] INC de
    # [Credits:40283] LD c, a
    # [Credits:40284] LD b, -1
    # [Credits:40285] POP hl
    # [Credits:40286] ADD hl, bc
    # [Credits:40287] CALL PlaceString
    # [Credits:40288] POP hl
    # [Credits:40289] LD bc, SCREEN_WIDTH * 2
    # [Credits:40290] ADD hl, bc
    # [Credits:40291] POP de
    # [Credits:40292] JR .nextCreditsCommand
    # [Credits:40294] CALL FadeInCredits
    # [Credits:40295] LD c, 90
    # [Credits:40296] JR .next1
    # [Credits:40298] LD c, 110
    # [Credits:40300] CALL DelayFrames
    # [Credits:40301] CALL DisplayCreditsMon
    # [Credits:40302] JR .nextCreditsScreen
    # [Credits:40304] CALL FadeInCredits
    # [Credits:40305] LD c, 120
    # [Credits:40306] JR .next2
    # [Credits:40308] LD c, 140
    # [Credits:40310] CALL DelayFrames
    # [Credits:40311] JR .nextCreditsScreen
    # [Credits:40313] PUSH de
    # [Credits:40315] POP de
    # [Credits:40316] POP de
    # [Credits:40317] JR .nextCreditsCommand
    # [Credits:40319] LD c, 16
    # [Credits:40320] CALL DelayFrames
