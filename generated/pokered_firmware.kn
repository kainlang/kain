    # [DisplayTitleScreen:222] LD [hli], a
    # [DisplayTitleScreen:223] INC a
    # [DisplayTitleScreen:224] DEC b
    # [DisplayTitleScreen:225] JR nz, .pokemonLogoTileRowLoop
    # [DisplayTitleScreen:226] POP hl
    # [DisplayTitleScreen:227] ADD hl, de
    # [DisplayTitleScreen:228] DEC c
    # [DisplayTitleScreen:229] JR nz, .pokemonLogoTileLoop
    # [DisplayTitleScreen:232] LD a, $31
    # [DisplayTitleScreen:233] LD b, $10
    # [DisplayTitleScreen:235] LD [hli], a
    # [DisplayTitleScreen:236] INC a
    # [DisplayTitleScreen:237] DEC b
    # [DisplayTitleScreen:238] JR nz, .pokemonLogoLastTileRowLoop
    # [DisplayTitleScreen:239] CALL DrawPlayerCharacter
    # [DisplayTitleScreen:241] LD hl, wShadowOAMSprite10
    # [DisplayTitleScreen:242] LD a, $74
    # [DisplayTitleScreen:243] LD [hl], a
    # [DisplayTitleScreen:246] LD de, .tileScreenCopyrightTiles
    # [DisplayTitleScreen:247] LD b, .tileScreenCopyrightTilesEnd - .tileScreenCopyrightTiles
    # [DisplayTitleScreen:249] LD a, [de]
    # [DisplayTitleScreen:250] LD [hli], a
    # [DisplayTitleScreen:251] INC de
    # [DisplayTitleScreen:252] DEC b
    # [DisplayTitleScreen:253] JR nz, .tileScreenCopyrightTilesLoop
