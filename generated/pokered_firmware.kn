fn gb_resetstatusandhalvemoneyonblackout(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [ResetStatusAndHalveMoneyOnBlackout:64] XOR a
    # [ResetStatusAndHalveMoneyOnBlackout:65] LD [wBattleResult], a
    # [ResetStatusAndHalveMoneyOnBlackout:66] LD [wWalkBikeSurfState], a
    # [ResetStatusAndHalveMoneyOnBlackout:67] LD [wIsInBattle], a
    # [ResetStatusAndHalveMoneyOnBlackout:68] LD [wMapPalOffset], a
    # [ResetStatusAndHalveMoneyOnBlackout:69] LD [wNPCMovementScriptFunctionNum], a
    # [ResetStatusAndHalveMoneyOnBlackout:70] LDH [hJoyHeld], a
    # [ResetStatusAndHalveMoneyOnBlackout:71] LD [wNPCMovementScriptPointerTableNum], a
    # [ResetStatusAndHalveMoneyOnBlackout:72] LD [wMiscFlags], a
    # [ResetStatusAndHalveMoneyOnBlackout:73] LDH [hMoney], a
    # [ResetStatusAndHalveMoneyOnBlackout:74] LDH [hMoney + 1], a
    # [ResetStatusAndHalveMoneyOnBlackout:75] LDH [hMoney + 2], a
    # [ResetStatusAndHalveMoneyOnBlackout:76] CALL HasEnoughMoney
    # [ResetStatusAndHalveMoneyOnBlackout:77] JR c, .lostmoney
    # [ResetStatusAndHalveMoneyOnBlackout:79] LD a, [wPlayerMoney]
    # [ResetStatusAndHalveMoneyOnBlackout:80] LDH [hMoney], a
    # [ResetStatusAndHalveMoneyOnBlackout:81] LD a, [wPlayerMoney + 1]
    # [ResetStatusAndHalveMoneyOnBlackout:82] LDH [hMoney + 1], a
    # [ResetStatusAndHalveMoneyOnBlackout:83] LD a, [wPlayerMoney + 2]
    # [ResetStatusAndHalveMoneyOnBlackout:84] LDH [hMoney + 2], a
    # [ResetStatusAndHalveMoneyOnBlackout:85] XOR a
    # [ResetStatusAndHalveMoneyOnBlackout:86] LDH [hDivideBCDDivisor], a
    # [ResetStatusAndHalveMoneyOnBlackout:87] LDH [hDivideBCDDivisor + 1], a
    # [ResetStatusAndHalveMoneyOnBlackout:88] LD a, 2
    # [ResetStatusAndHalveMoneyOnBlackout:89] LDH [hDivideBCDDivisor + 2], a
    # [ResetStatusAndHalveMoneyOnBlackout:91] LDH a, [hDivideBCDQuotient]
    # [ResetStatusAndHalveMoneyOnBlackout:92] LD [wPlayerMoney], a
    # [ResetStatusAndHalveMoneyOnBlackout:93] LDH a, [hDivideBCDQuotient + 1]
    # [ResetStatusAndHalveMoneyOnBlackout:94] LD [wPlayerMoney + 1], a
    # [ResetStatusAndHalveMoneyOnBlackout:95] LDH a, [hDivideBCDQuotient + 2]
    # [ResetStatusAndHalveMoneyOnBlackout:96] LD [wPlayerMoney + 2], a
    # [ResetStatusAndHalveMoneyOnBlackout:98] LD hl, wStatusFlags6
    # [ResetStatusAndHalveMoneyOnBlackout:99] SET BIT_FLY_OR_DUNGEON_WARP, [hl]
    # [ResetStatusAndHalveMoneyOnBlackout:100] RES BIT_FLY_WARP, [hl]
    # [ResetStatusAndHalveMoneyOnBlackout:101] SET BIT_ESCAPE_WARP, [hl]
    # [ResetStatusAndHalveMoneyOnBlackout:102] LD a, PAD_BUTTONS | PAD_CTRL_PAD
    # [ResetStatusAndHalveMoneyOnBlackout:103] LD [wJoyIgnore], a
    return (next_cpu, next_mem)

fn gb_printsafarizonebattletext(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [PrintSafariZoneBattleText:123] LD hl, wSafariBaitFactor
    # [PrintSafariZoneBattleText:124] LD a, [hl]
    # [PrintSafariZoneBattleText:125] AND a
    # [PrintSafariZoneBattleText:126] JR z, .no_bait
    # [PrintSafariZoneBattleText:127] DEC [hl]
    # [PrintSafariZoneBattleText:128] LD hl, SafariZoneEatingText
    # [PrintSafariZoneBattleText:129] JR .done
    # [PrintSafariZoneBattleText:131] DEC hl
    # [PrintSafariZoneBattleText:132] LD a, [hl]
    # [PrintSafariZoneBattleText:133] AND a
    # [PrintSafariZoneBattleText:134] RET z
    # [PrintSafariZoneBattleText:135] DEC [hl]
    # [PrintSafariZoneBattleText:136] LD hl, SafariZoneAngryText
    # [PrintSafariZoneBattleText:137] JR nz, .done
    # [PrintSafariZoneBattleText:138] PUSH hl
    # [PrintSafariZoneBattleText:139] LD a, [wEnemyMonSpecies]
    # [PrintSafariZoneBattleText:140] LD [wCurSpecies], a
    # [PrintSafariZoneBattleText:141] CALL GetMonHeader
    # [PrintSafariZoneBattleText:142] LD a, [wMonHCatchRate]
    # [PrintSafariZoneBattleText:143] LD [wEnemyMonActualCatchRate], a
    # [PrintSafariZoneBattleText:144] POP hl
    # [PrintSafariZoneBattleText:146] PUSH hl
