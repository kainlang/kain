    # [AIRecoverHP:21520] LD b, a
    # [AIRecoverHP:21521] LD a, [de]
    # [AIRecoverHP:21522] LD [wHPBarMaxHP+1], a
    # [AIRecoverHP:21523] SBC b
    # [AIRecoverHP:21524] JR nc, AIPrintItemUseAndUpdateHPBar
    # [AIRecoverHP:21525] INC de
    # [AIRecoverHP:21526] LD a, [de]
    # [AIRecoverHP:21527] DEC de
    # [AIRecoverHP:21528] LD [hld], a
