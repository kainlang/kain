    # [PoisonEffect:29142] LD a, [hli]
    # [PoisonEffect:29143] LD b, a
    # [PoisonEffect:29144] AND a
    # [PoisonEffect:29145] JR nz, .noEffect
    # [PoisonEffect:29146] LD a, [hli]
    # [PoisonEffect:29147] CP POISON
    # [PoisonEffect:29148] JR z, .noEffect
    # [PoisonEffect:29149] LD a, [hld]
    # [PoisonEffect:29150] CP POISON
    # [PoisonEffect:29151] JR z, .noEffect
    # [PoisonEffect:29152] LD a, [de]
    # [PoisonEffect:29153] CP POISON_SIDE_EFFECT1
    # [PoisonEffect:29154] LD b, 20 percent + 1
    # [PoisonEffect:29155] JR z, .sideEffectTest
    # [PoisonEffect:29156] CP POISON_SIDE_EFFECT2
    # [PoisonEffect:29157] LD b, 40 percent + 1
    # [PoisonEffect:29158] JR z, .sideEffectTest
    # [PoisonEffect:29159] PUSH hl
    # [PoisonEffect:29160] PUSH de
    # [PoisonEffect:29161] CALL MoveHitTest
    # [PoisonEffect:29162] POP de
    # [PoisonEffect:29163] POP hl
    # [PoisonEffect:29164] LD a, [wMoveMissed]
    # [PoisonEffect:29165] AND a
    # [PoisonEffect:29166] JR nz, .didntAffect
    # [PoisonEffect:29167] JR .inflictPoison
    # [PoisonEffect:29169] CALL BattleRandom
    # [PoisonEffect:29170] CP b
    # [PoisonEffect:29171] RET nc
    # [PoisonEffect:29173] DEC hl
    # [PoisonEffect:29174] SET PSN, [hl]
    # [PoisonEffect:29175] PUSH de
    # [PoisonEffect:29176] DEC de
    # [PoisonEffect:29177] LDH a, [hWhoseTurn]
    # [PoisonEffect:29178] AND a
    # [PoisonEffect:29179] LD b, SHAKE_SCREEN_ANIM
    # [PoisonEffect:29180] LD hl, wPlayerBattleStatus3
    # [PoisonEffect:29181] LD a, [de]
    # [PoisonEffect:29182] LD de, wPlayerToxicCounter
    # [PoisonEffect:29183] JR nz, .ok
    # [PoisonEffect:29184] LD b, ENEMY_HUD_SHAKE_ANIM
    # [PoisonEffect:29185] LD hl, wEnemyBattleStatus3
    # [PoisonEffect:29186] LD de, wEnemyToxicCounter
    # [PoisonEffect:29188] CP TOXIC
    # [PoisonEffect:29189] JR nz, .normalPoison
    # [PoisonEffect:29190] SET BADLY_POISONED, [hl]
    # [PoisonEffect:29191] XOR a
    # [PoisonEffect:29192] LD [de], a
    # [PoisonEffect:29193] LD hl, BadlyPoisonedText
    # [PoisonEffect:29194] JR .continue
    # [PoisonEffect:29196] LD hl, PoisonedText
    # [PoisonEffect:29198] POP de
    # [PoisonEffect:29199] LD a, [de]
    # [PoisonEffect:29200] CP POISON_EFFECT
    # [PoisonEffect:29201] JR z, .regularPoisonEffect
    # [PoisonEffect:29202] LD a, b
    # [PoisonEffect:29203] CALL PlayBattleAnimation2
    # [PoisonEffect:29204] JP PrintText
    # [PoisonEffect:29206] CALL PlayCurrentMoveAnimation2
    # [PoisonEffect:29207] JP PrintText
    # [PoisonEffect:29209] LD a, [de]
    # [PoisonEffect:29210] CP POISON_EFFECT
    # [PoisonEffect:29211] RET nz
    # [PoisonEffect:29213] LD c, 50
    # [PoisonEffect:29214] CALL DelayFrames
    # [PoisonEffect:29215] JP PrintDidntAffectText
    return (next_cpu, next_mem)

