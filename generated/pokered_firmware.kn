    # [DisplayTitleScreen:209] LD bc, Version_GFXEnd - Version_GFX
    # [DisplayTitleScreen:210] LD a, BANK(Version_GFX)
    # [DisplayTitleScreen:211] CALL FarCopyDataDouble
    # [DisplayTitleScreen:212] CALL ClearBothBGMaps
    # [DisplayTitleScreen:215] LD a, $80
