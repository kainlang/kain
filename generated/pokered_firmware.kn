fn gb_prepareoamdata(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [PrepareOAMData:789] LD a, [wUpdateSpritesEnabled]
    # [PrepareOAMData:790] DEC a
    # [PrepareOAMData:791] JR z, .updateEnabled
    # [PrepareOAMData:792] CP -1
    # [PrepareOAMData:793] RET nz
    # [PrepareOAMData:794] LD [wUpdateSpritesEnabled], a
    # [PrepareOAMData:795] JP HideSprites
    # [PrepareOAMData:797] XOR a
    # [PrepareOAMData:798] LDH [hOAMBufferOffset], a
    # [PrepareOAMData:800] LDH [hSpriteOffset2], a
    # [PrepareOAMData:801] LD d, HIGH(wSpriteStateData1)
    # [PrepareOAMData:802] LDH a, [hSpriteOffset2]
    # [PrepareOAMData:803] LD e, a
    # [PrepareOAMData:804] LD a, [de]
    # [PrepareOAMData:805] AND a
    # [PrepareOAMData:806] JP z, .nextSprite
    # [PrepareOAMData:807] INC e
    # [PrepareOAMData:808] INC e
    # [PrepareOAMData:809] LD a, [de]
    # [PrepareOAMData:810] LD [wSavedSpriteImageIndex], a
    # [PrepareOAMData:811] CP $ff
    # [PrepareOAMData:812] JR nz, .visible
    # [PrepareOAMData:813] CALL GetSpriteScreenXY
    # [PrepareOAMData:814] JR .nextSprite
    # [PrepareOAMData:816] CP $a0
    # [PrepareOAMData:817] JR c, .usefacing
    # [PrepareOAMData:819] AND $f
    # [PrepareOAMData:820] ADD $10
    # [PrepareOAMData:821] JR .next
    # [PrepareOAMData:823] AND $f
    # [PrepareOAMData:825] LD l, a
    # [PrepareOAMData:827] PUSH de
    # [PrepareOAMData:828] INC d
    # [PrepareOAMData:829] LD a, e
    # [PrepareOAMData:830] ADD $5
    # [PrepareOAMData:831] LD e, a
    # [PrepareOAMData:832] LD a, [de]
    # [PrepareOAMData:833] AND $80
    # [PrepareOAMData:834] LDH [hSpritePriority], a
    # [PrepareOAMData:835] POP de
    # [PrepareOAMData:837] LD h, 0
    # [PrepareOAMData:838] LD bc, SpriteFacingAndAnimationTable
    # [PrepareOAMData:839] ADD hl, hl
    # [PrepareOAMData:840] ADD hl, hl
    # [PrepareOAMData:841] ADD hl, bc
    # [PrepareOAMData:842] LD a, [hli]
    # [PrepareOAMData:843] LD c, a
    # [PrepareOAMData:844] LD a, [hli]
    # [PrepareOAMData:845] LD b, a
    # [PrepareOAMData:846] LD a, [hli]
    # [PrepareOAMData:847] LD h, [hl]
    # [PrepareOAMData:848] LD l, a
    # [PrepareOAMData:849] CALL GetSpriteScreenXY
    # [PrepareOAMData:850] LDH a, [hOAMBufferOffset]
    # [PrepareOAMData:851] LD e, a
    # [PrepareOAMData:852] LD d, HIGH(wShadowOAM)
    # [PrepareOAMData:854] LDH a, [hSpriteScreenY]
    # [PrepareOAMData:855] ADD $10
    # [PrepareOAMData:856] ADD [hl]
    # [PrepareOAMData:857] LD [de], a
    # [PrepareOAMData:858] INC hl
    # [PrepareOAMData:859] LDH a, [hSpriteScreenX]
    # [PrepareOAMData:860] ADD $8
    # [PrepareOAMData:861] ADD [hl]
    # [PrepareOAMData:862] INC e
    # [PrepareOAMData:863] LD [de], a
    # [PrepareOAMData:864] INC e
    # [PrepareOAMData:865] LD a, [bc]
    # [PrepareOAMData:866] INC bc
    # [PrepareOAMData:867] PUSH bc
    # [PrepareOAMData:868] LD b, a
    # [PrepareOAMData:869] LD a, [wSavedSpriteImageIndex]
    # [PrepareOAMData:870] SWAP a
    # [PrepareOAMData:871] AND $f
    # [PrepareOAMData:874] CP $b
    # [PrepareOAMData:875] JR nz, .notFourTileSprite
    # [PrepareOAMData:876] LD a, $a * 12 + 4
    # [PrepareOAMData:877] JR .next2
    # [PrepareOAMData:880] SLA a
    # [PrepareOAMData:881] SLA a
    # [PrepareOAMData:882] LD c, a
    # [PrepareOAMData:883] SLA a
    # [PrepareOAMData:884] ADD c
    # [PrepareOAMData:886] ADD b
    # [PrepareOAMData:887] POP bc
    # [PrepareOAMData:888] LD [de], a
    # [PrepareOAMData:889] INC hl
    # [PrepareOAMData:890] INC e
    # [PrepareOAMData:891] LD a, [hl]
    # [PrepareOAMData:892] BIT BIT_SPRITE_UNDER_GRASS, a
    # [PrepareOAMData:893] JR z, .skipPriority
    # [PrepareOAMData:894] LDH a, [hSpritePriority]
    # [PrepareOAMData:895] OR [hl]
    # [PrepareOAMData:897] INC hl
    # [PrepareOAMData:898] LD [de], a
    # [PrepareOAMData:899] INC e
    # [PrepareOAMData:900] BIT BIT_END_OF_OAM_DATA, a
    # [PrepareOAMData:901] JR z, .tileLoop
    # [PrepareOAMData:902] LD a, e
    # [PrepareOAMData:903] LDH [hOAMBufferOffset], a
    # [PrepareOAMData:905] LDH a, [hSpriteOffset2]
    # [PrepareOAMData:906] ADD $10
    # [PrepareOAMData:907] CP LOW($100)
    # [PrepareOAMData:908] JP nz, .spriteLoop
    # [PrepareOAMData:910] LDH a, [hOAMBufferOffset]
    # [PrepareOAMData:911] LD l, a
    # [PrepareOAMData:912] LD h, HIGH(wShadowOAM)
    # [PrepareOAMData:913] LD de, OBJ_SIZE
    # [PrepareOAMData:914] LD b, SCREEN_HEIGHT_PX + OAM_Y_OFS
    # [PrepareOAMData:915] LD a, [wMovementFlags]
    # [PrepareOAMData:916] BIT BIT_LEDGE_OR_FISHING, a
    # [PrepareOAMData:917] LD a, LOW(wShadowOAMEnd)
    # [PrepareOAMData:918] JR z, .clear
    # [PrepareOAMData:921] LD a, LOW(wShadowOAMSprite36)
    # [PrepareOAMData:923] CP l
    # [PrepareOAMData:924] RET z
    # [PrepareOAMData:925] LD [hl], b
    # [PrepareOAMData:926] ADD hl, de
    # [PrepareOAMData:927] JR .clear
    return (next_cpu, next_mem)

