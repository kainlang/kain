    # [StatModifierUpEffect:29400] LD hl, wEnemyMonStatMods
    # [StatModifierUpEffect:29401] LD de, wEnemyMoveEffect
    # [StatModifierUpEffect:29403] LD a, [de]
    # [StatModifierUpEffect:29404] SUB ATTACK_UP1_EFFECT
    # [StatModifierUpEffect:29405] CP EVASION_UP1_EFFECT + $3 - ATTACK_UP1_EFFECT
    # [StatModifierUpEffect:29406] JR c, .incrementStatMod
    # [StatModifierUpEffect:29407] SUB ATTACK_UP2_EFFECT - ATTACK_UP1_EFFECT
    # [StatModifierUpEffect:29409] LD c, a
    # [StatModifierUpEffect:29410] LD b, $0
    # [StatModifierUpEffect:29411] ADD hl, bc
    # [StatModifierUpEffect:29412] LD b, [hl]
    # [StatModifierUpEffect:29413] INC b
    # [StatModifierUpEffect:29414] LD a, $d
    # [StatModifierUpEffect:29415] CP b
    # [StatModifierUpEffect:29416] JP c, PrintNothingHappenedText
    # [StatModifierUpEffect:29417] LD a, [de]
    # [StatModifierUpEffect:29418] CP ATTACK_UP1_EFFECT + $8
