    # [SelectEnemyMove:25543] RET nz
    # [SelectEnemyMove:25544] LD a, [wEnemyBattleStatus1]
    # [SelectEnemyMove:25545] AND (1 << USING_TRAPPING_MOVE) | (1 << STORING_ENERGY)
    # [SelectEnemyMove:25546] RET nz
    # [SelectEnemyMove:25547] LD a, [wPlayerBattleStatus1]
    # [SelectEnemyMove:25548] BIT USING_TRAPPING_MOVE, a
    # [SelectEnemyMove:25549] JR z, .canSelectMove
    # [SelectEnemyMove:25551] LD a, $ff
    # [SelectEnemyMove:25552] JR .done
    # [SelectEnemyMove:25554] LD hl, wEnemyMonMoves+1
    # [SelectEnemyMove:25555] LD a, [hld]
    # [SelectEnemyMove:25556] AND a
    # [SelectEnemyMove:25557] JR nz, .atLeastTwoMovesAvailable
    # [SelectEnemyMove:25558] LD a, [wEnemyDisabledMove]
    # [SelectEnemyMove:25559] AND a
    # [SelectEnemyMove:25560] LD a, STRUGGLE
    # [SelectEnemyMove:25561] JR nz, .done
    # [SelectEnemyMove:25563] LD a, [wIsInBattle]
    # [SelectEnemyMove:25564] DEC a
    # [SelectEnemyMove:25565] JR z, .chooseRandomMove
    # [SelectEnemyMove:25568] PUSH hl
    # [SelectEnemyMove:25569] CALL BattleRandom
    # [SelectEnemyMove:25570] LD b, 1
    # [SelectEnemyMove:25571] CP 25 percent
    # [SelectEnemyMove:25572] JR c, .moveChosen
    # [SelectEnemyMove:25573] INC hl
    # [SelectEnemyMove:25574] INC b
    # [SelectEnemyMove:25575] CP 50 percent
    # [SelectEnemyMove:25576] JR c, .moveChosen
    # [SelectEnemyMove:25577] INC hl
    # [SelectEnemyMove:25578] INC b
    # [SelectEnemyMove:25579] CP 75 percent - 1
    # [SelectEnemyMove:25580] JR c, .moveChosen
    # [SelectEnemyMove:25581] INC hl
    # [SelectEnemyMove:25582] INC b
    # [SelectEnemyMove:25584] LD a, b
    # [SelectEnemyMove:25585] DEC a
    # [SelectEnemyMove:25586] LD [wEnemyMoveListIndex], a
    # [SelectEnemyMove:25587] LD a, [wEnemyDisabledMove]
    # [SelectEnemyMove:25588] SWAP a
    # [SelectEnemyMove:25589] AND $f
    # [SelectEnemyMove:25590] CP b
