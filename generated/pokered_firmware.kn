    # [ApplyOutOfBattlePoisonDamage:8254] JP nz, .noBlackOut
    # [ApplyOutOfBattlePoisonDamage:8255] LD [wWhichPokemon], a
    # [ApplyOutOfBattlePoisonDamage:8256] LD hl, wPartyMon1Status
    # [ApplyOutOfBattlePoisonDamage:8257] LD de, wPartySpecies
    # [ApplyOutOfBattlePoisonDamage:8259] LD a, [hl]
    # [ApplyOutOfBattlePoisonDamage:8260] AND 1 << PSN
    # [ApplyOutOfBattlePoisonDamage:8261] JR z, .nextMon2
    # [ApplyOutOfBattlePoisonDamage:8262] DEC hl
    # [ApplyOutOfBattlePoisonDamage:8263] DEC hl
