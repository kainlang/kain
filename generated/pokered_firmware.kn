    # [AICheckIfHPBelowFraction:21651] RET nz
    # [AICheckIfHPBelowFraction:21652] LD a, e
    # [AICheckIfHPBelowFraction:21653] SUB c
    # [AICheckIfHPBelowFraction:21654] RET 
    return (next_cpu, next_mem)

