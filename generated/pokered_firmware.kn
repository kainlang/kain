fn gb_resetstatusandhalvemoneyonblackout(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [ResetStatusAndHalveMoneyOnBlackout:60] XOR a
    # [ResetStatusAndHalveMoneyOnBlackout:61] LD [wBattleResult], a
    # [ResetStatusAndHalveMoneyOnBlackout:62] LD [wWalkBikeSurfState], a
    # [ResetStatusAndHalveMoneyOnBlackout:63] LD [wIsInBattle], a
    # [ResetStatusAndHalveMoneyOnBlackout:64] LD [wMapPalOffset], a
    # [ResetStatusAndHalveMoneyOnBlackout:65] LD [wNPCMovementScriptFunctionNum], a
    # [ResetStatusAndHalveMoneyOnBlackout:66] LDH [hJoyHeld], a
    # [ResetStatusAndHalveMoneyOnBlackout:67] LD [wNPCMovementScriptPointerTableNum], a
    # [ResetStatusAndHalveMoneyOnBlackout:68] LD [wMiscFlags], a
    # [ResetStatusAndHalveMoneyOnBlackout:69] LDH [hMoney], a
    # [ResetStatusAndHalveMoneyOnBlackout:70] LDH [hMoney + 1], a
    # [ResetStatusAndHalveMoneyOnBlackout:71] LDH [hMoney + 2], a
    # [ResetStatusAndHalveMoneyOnBlackout:72] CALL HasEnoughMoney
    # [ResetStatusAndHalveMoneyOnBlackout:73] JR c, .lostmoney
    # [ResetStatusAndHalveMoneyOnBlackout:75] LD a, [wPlayerMoney]
    # [ResetStatusAndHalveMoneyOnBlackout:76] LDH [hMoney], a
    # [ResetStatusAndHalveMoneyOnBlackout:77] LD a, [wPlayerMoney + 1]
    # [ResetStatusAndHalveMoneyOnBlackout:78] LDH [hMoney + 1], a
    # [ResetStatusAndHalveMoneyOnBlackout:79] LD a, [wPlayerMoney + 2]
    # [ResetStatusAndHalveMoneyOnBlackout:80] LDH [hMoney + 2], a
    # [ResetStatusAndHalveMoneyOnBlackout:81] XOR a
    # [ResetStatusAndHalveMoneyOnBlackout:82] LDH [hDivideBCDDivisor], a
    # [ResetStatusAndHalveMoneyOnBlackout:83] LDH [hDivideBCDDivisor + 1], a
    # [ResetStatusAndHalveMoneyOnBlackout:84] LD a, 2
    # [ResetStatusAndHalveMoneyOnBlackout:85] LDH [hDivideBCDDivisor + 2], a
    # [ResetStatusAndHalveMoneyOnBlackout:87] LDH a, [hDivideBCDQuotient]
    # [ResetStatusAndHalveMoneyOnBlackout:88] LD [wPlayerMoney], a
    # [ResetStatusAndHalveMoneyOnBlackout:89] LDH a, [hDivideBCDQuotient + 1]
    # [ResetStatusAndHalveMoneyOnBlackout:90] LD [wPlayerMoney + 1], a
    # [ResetStatusAndHalveMoneyOnBlackout:91] LDH a, [hDivideBCDQuotient + 2]
    # [ResetStatusAndHalveMoneyOnBlackout:92] LD [wPlayerMoney + 2], a
    # [ResetStatusAndHalveMoneyOnBlackout:94] LD hl, wStatusFlags6
    # [ResetStatusAndHalveMoneyOnBlackout:95] SET BIT_FLY_OR_DUNGEON_WARP, [hl]
    # [ResetStatusAndHalveMoneyOnBlackout:96] RES BIT_FLY_WARP, [hl]
    # [ResetStatusAndHalveMoneyOnBlackout:97] SET BIT_ESCAPE_WARP, [hl]
    # [ResetStatusAndHalveMoneyOnBlackout:98] LD a, PAD_BUTTONS | PAD_CTRL_PAD
    # [ResetStatusAndHalveMoneyOnBlackout:99] LD [wJoyIgnore], a
    return (next_cpu, next_mem)

fn gb_printsafarizonebattletext(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [PrintSafariZoneBattleText:115] LD hl, wSafariBaitFactor
    # [PrintSafariZoneBattleText:116] LD a, [hl]
    # [PrintSafariZoneBattleText:117] AND a
    # [PrintSafariZoneBattleText:118] JR z, .no_bait
    # [PrintSafariZoneBattleText:119] DEC [hl]
    # [PrintSafariZoneBattleText:120] LD hl, SafariZoneEatingText
    # [PrintSafariZoneBattleText:121] JR .done
    # [PrintSafariZoneBattleText:123] DEC hl
    # [PrintSafariZoneBattleText:124] LD a, [hl]
    # [PrintSafariZoneBattleText:125] AND a
    # [PrintSafariZoneBattleText:126] RET z
    # [PrintSafariZoneBattleText:127] DEC [hl]
    # [PrintSafariZoneBattleText:128] LD hl, SafariZoneAngryText
    # [PrintSafariZoneBattleText:129] JR nz, .done
    # [PrintSafariZoneBattleText:130] PUSH hl
    # [PrintSafariZoneBattleText:131] LD a, [wEnemyMonSpecies]
    # [PrintSafariZoneBattleText:132] LD [wCurSpecies], a
    # [PrintSafariZoneBattleText:133] CALL GetMonHeader
    # [PrintSafariZoneBattleText:134] LD a, [wMonHCatchRate]
    # [PrintSafariZoneBattleText:135] LD [wEnemyMonActualCatchRate], a
    # [PrintSafariZoneBattleText:136] POP hl
    # [PrintSafariZoneBattleText:138] PUSH hl
    # [PrintSafariZoneBattleText:139] CALL LoadScreenTilesFromBuffer1
    # [PrintSafariZoneBattleText:140] POP hl
    # [PrintSafariZoneBattleText:141] JP PrintText
    return (next_cpu, next_mem)

