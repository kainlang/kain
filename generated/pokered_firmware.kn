    # [CalculateModifiedStat:28559] JR z, .next
    # [CalculateModifiedStat:28560] LD hl, wEnemyMonAttack
    # [CalculateModifiedStat:28561] LD de, wEnemyMonUnmodifiedAttack
    # [CalculateModifiedStat:28562] LD bc, wEnemyMonStatMods
    # [CalculateModifiedStat:28564] ADD c
    # [CalculateModifiedStat:28565] LD c, a
    # [CalculateModifiedStat:28566] JR nc, .noCarry1
    # [CalculateModifiedStat:28567] INC b
    # [CalculateModifiedStat:28569] LD a, [bc]
    # [CalculateModifiedStat:28570] POP bc
    # [CalculateModifiedStat:28571] LD b, a
    # [CalculateModifiedStat:28572] PUSH bc
    # [CalculateModifiedStat:28573] SLA c
    # [CalculateModifiedStat:28574] LD b, 0
    # [CalculateModifiedStat:28575] ADD hl, bc
    # [CalculateModifiedStat:28576] LD a, c
    # [CalculateModifiedStat:28577] ADD e
    # [CalculateModifiedStat:28578] LD e, a
    # [CalculateModifiedStat:28579] JR nc, .noCarry2
    # [CalculateModifiedStat:28580] INC d
    # [CalculateModifiedStat:28582] POP bc
    # [CalculateModifiedStat:28583] PUSH hl
    # [CalculateModifiedStat:28584] LD hl, StatModifierRatios
    # [CalculateModifiedStat:28585] DEC b
    # [CalculateModifiedStat:28586] SLA b
    # [CalculateModifiedStat:28587] LD c, b
    # [CalculateModifiedStat:28588] LD b, 0
    # [CalculateModifiedStat:28589] ADD hl, bc
    # [CalculateModifiedStat:28590] XOR a
    # [CalculateModifiedStat:28591] LDH [hMultiplicand], a
    # [CalculateModifiedStat:28592] LD a, [de]
    # [CalculateModifiedStat:28593] LDH [hMultiplicand + 1], a
    # [CalculateModifiedStat:28594] INC de
    # [CalculateModifiedStat:28595] LD a, [de]
    # [CalculateModifiedStat:28596] LDH [hMultiplicand + 2], a
    # [CalculateModifiedStat:28597] LD a, [hli]
    # [CalculateModifiedStat:28598] LDH [hMultiplier], a
    # [CalculateModifiedStat:28599] CALL Multiply
    # [CalculateModifiedStat:28600] LD a, [hl]
    # [CalculateModifiedStat:28601] LDH [hDivisor], a
    # [CalculateModifiedStat:28602] LD b, $4
    # [CalculateModifiedStat:28603] CALL Divide
    # [CalculateModifiedStat:28604] POP hl
    # [CalculateModifiedStat:28605] LDH a, [hDividend + 3]
    # [CalculateModifiedStat:28606] SUB LOW(MAX_STAT_VALUE)
    # [CalculateModifiedStat:28607] LDH a, [hDividend + 2]
    # [CalculateModifiedStat:28608] SBC HIGH(MAX_STAT_VALUE)
    # [CalculateModifiedStat:28609] JP c, .storeNewStatValue
    # [CalculateModifiedStat:28611] LD a, HIGH(MAX_STAT_VALUE)
    # [CalculateModifiedStat:28612] LDH [hDividend + 2], a
    # [CalculateModifiedStat:28613] LD a, LOW(MAX_STAT_VALUE)
    # [CalculateModifiedStat:28614] LDH [hDividend + 3], a
    # [CalculateModifiedStat:28616] LDH a, [hDividend + 2]
    # [CalculateModifiedStat:28617] LD [hli], a
    # [CalculateModifiedStat:28618] LD b, a
    # [CalculateModifiedStat:28619] LDH a, [hDividend + 3]
    # [CalculateModifiedStat:28620] LD [hl], a
    # [CalculateModifiedStat:28621] OR b
    # [CalculateModifiedStat:28622] JR nz, .done
    # [CalculateModifiedStat:28623] INC [hl]
    # [CalculateModifiedStat:28625] POP bc
    # [CalculateModifiedStat:28626] RET 
    return (next_cpu, next_mem)

