    # [ItemUsePokeFlute:10599] JR nc, .noSnorlaxToWakeUp
    # [ItemUsePokeFlute:10600] LD hl, PlayedFluteHadEffectText
    # [ItemUsePokeFlute:10601] CALL PrintText
    # [ItemUsePokeFlute:10603] RET 
    # [ItemUsePokeFlute:10605] LD hl, PlayedFluteNoEffectText
    # [ItemUsePokeFlute:10606] JP PrintText
    # [ItemUsePokeFlute:10608] XOR a
    # [ItemUsePokeFlute:10609] LD [wWereAnyMonsAsleep], a
    # [ItemUsePokeFlute:10610] LD b, ~SLP_MASK
    # [ItemUsePokeFlute:10611] LD hl, wPartyMon1Status
    # [ItemUsePokeFlute:10612] CALL WakeUpEntireParty
    # [ItemUsePokeFlute:10613] LD a, [wIsInBattle]
    # [ItemUsePokeFlute:10614] DEC a
    # [ItemUsePokeFlute:10615] JR z, .skipWakingUpEnemyParty
    # [ItemUsePokeFlute:10617] LD hl, wEnemyMon1Status
    # [ItemUsePokeFlute:10618] CALL WakeUpEntireParty
    # [ItemUsePokeFlute:10620] LD hl, wBattleMonStatus
    # [ItemUsePokeFlute:10621] LD a, [hl]
    # [ItemUsePokeFlute:10622] AND b
    # [ItemUsePokeFlute:10623] LD [hl], a
    # [ItemUsePokeFlute:10624] LD hl, wEnemyMonStatus
    # [ItemUsePokeFlute:10625] LD a, [hl]
    # [ItemUsePokeFlute:10626] AND b
    # [ItemUsePokeFlute:10627] LD [hl], a
    # [ItemUsePokeFlute:10628] CALL LoadScreenTilesFromBuffer2
    # [ItemUsePokeFlute:10629] LD a, [wWereAnyMonsAsleep]
    # [ItemUsePokeFlute:10630] AND a
    # [ItemUsePokeFlute:10631] LD hl, PlayedFluteNoEffectText
    # [ItemUsePokeFlute:10632] JP z, PrintText
    # [ItemUsePokeFlute:10634] LD hl, PlayedFluteHadEffectText
    # [ItemUsePokeFlute:10635] CALL PrintText
    # [ItemUsePokeFlute:10636] LD a, [wLowHealthAlarm]
    # [ItemUsePokeFlute:10637] AND $80
    # [ItemUsePokeFlute:10638] JR nz, .skipMusic
    # [ItemUsePokeFlute:10639] CALL WaitForSoundToFinish
    # [ItemUsePokeFlute:10642] LD a, [wChannelSoundIDs + CHAN7]
    # [ItemUsePokeFlute:10643] AND a
    # [ItemUsePokeFlute:10644] JR nz, .musicWaitLoop
    # [ItemUsePokeFlute:10646] LD hl, FluteWokeUpText
