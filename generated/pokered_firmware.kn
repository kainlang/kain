    # [.ScrollTitleScreenPokemonLogo:370] CALL GBPalWhiteOutWithDelay3
    # [.ScrollTitleScreenPokemonLogo:371] CALL ClearSprites
    # [.ScrollTitleScreenPokemonLogo:372] XOR a
    # [.ScrollTitleScreenPokemonLogo:373] LDH [hWY], a
