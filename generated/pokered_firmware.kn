    # [SelectEnemyMove:25290] DEC a
    # [SelectEnemyMove:25291] JR z, .chooseRandomMove
    # [SelectEnemyMove:25294] PUSH hl
    # [SelectEnemyMove:25295] CALL BattleRandom
    # [SelectEnemyMove:25296] LD b, 1
    # [SelectEnemyMove:25297] CP 25 percent
