    # [ApplyOutOfBattlePoisonDamage:8278] JR .nextMon
    # [ApplyOutOfBattlePoisonDamage:8280] LD a, [hli]
    # [ApplyOutOfBattlePoisonDamage:8281] OR [hl]
    # [ApplyOutOfBattlePoisonDamage:8282] JR nz, .nextMon
    # [ApplyOutOfBattlePoisonDamage:8284] PUSH hl
    # [ApplyOutOfBattlePoisonDamage:8285] INC hl
    # [ApplyOutOfBattlePoisonDamage:8286] INC hl
    # [ApplyOutOfBattlePoisonDamage:8287] LD [hl], a
    # [ApplyOutOfBattlePoisonDamage:8288] LD a, [de]
    # [ApplyOutOfBattlePoisonDamage:8289] LD [wPokedexNum], a
    # [ApplyOutOfBattlePoisonDamage:8290] PUSH de
    # [ApplyOutOfBattlePoisonDamage:8291] LD a, [wWhichPokemon]
    # [ApplyOutOfBattlePoisonDamage:8292] LD hl, wPartyMonNicks
