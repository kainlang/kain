    # [SelectEnemyMove:25529] LD b, 0
    # [SelectEnemyMove:25530] ADD hl, bc
    # [SelectEnemyMove:25531] LD a, [hl]
    # [SelectEnemyMove:25532] JR .done
    # [SelectEnemyMove:25534] LD a, [wEnemyBattleStatus2]
    # [SelectEnemyMove:25535] AND (1 << NEEDS_TO_RECHARGE) | (1 << USING_RAGE)
    # [SelectEnemyMove:25536] RET nz
