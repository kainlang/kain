fn gb_evolution_partymonloop(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [Evolution_PartyMonLoop:21654] LD hl, wWhichPokemon
    # [Evolution_PartyMonLoop:21655] INC [hl]
    # [Evolution_PartyMonLoop:21656] POP hl
    # [Evolution_PartyMonLoop:21657] INC hl
    # [Evolution_PartyMonLoop:21658] LD a, [hl]
    # [Evolution_PartyMonLoop:21659] CP $ff
    # [Evolution_PartyMonLoop:21660] JP z, .done
    # [Evolution_PartyMonLoop:21661] LD [wEvoOldSpecies], a
    # [Evolution_PartyMonLoop:21662] PUSH hl
    # [Evolution_PartyMonLoop:21663] LD a, [wWhichPokemon]
    # [Evolution_PartyMonLoop:21664] LD c, a
    # [Evolution_PartyMonLoop:21665] LD hl, wCanEvolveFlags
    # [Evolution_PartyMonLoop:21666] LD b, FLAG_TEST
    # [Evolution_PartyMonLoop:21667] CALL Evolution_FlagAction
    # [Evolution_PartyMonLoop:21668] LD a, c
    # [Evolution_PartyMonLoop:21669] AND a
    # [Evolution_PartyMonLoop:21670] JP z, Evolution_PartyMonLoop
    # [Evolution_PartyMonLoop:21671] LD a, [wEvoOldSpecies]
    # [Evolution_PartyMonLoop:21672] DEC a
    # [Evolution_PartyMonLoop:21673] LD b, 0
    # [Evolution_PartyMonLoop:21674] LD hl, EvosMovesPointerTable
    # [Evolution_PartyMonLoop:21675] ADD a
    # [Evolution_PartyMonLoop:21676] RL b
    # [Evolution_PartyMonLoop:21677] LD c, a
    # [Evolution_PartyMonLoop:21678] ADD hl, bc
    # [Evolution_PartyMonLoop:21679] LD a, [hli]
    # [Evolution_PartyMonLoop:21680] LD h, [hl]
    # [Evolution_PartyMonLoop:21681] LD l, a
    # [Evolution_PartyMonLoop:21682] PUSH hl
    # [Evolution_PartyMonLoop:21683] LD a, [wCurPartySpecies]
    # [Evolution_PartyMonLoop:21684] PUSH af
    # [Evolution_PartyMonLoop:21685] XOR a
    # [Evolution_PartyMonLoop:21686] LD [wMonDataLocation], a
    # [Evolution_PartyMonLoop:21687] CALL LoadMonData
    # [Evolution_PartyMonLoop:21688] POP af
    # [Evolution_PartyMonLoop:21689] LD [wCurPartySpecies], a
    # [Evolution_PartyMonLoop:21690] POP hl
    # [Evolution_PartyMonLoop:21692] LD a, [hli]
    # [Evolution_PartyMonLoop:21693] AND a
    # [Evolution_PartyMonLoop:21694] JR z, Evolution_PartyMonLoop
    # [Evolution_PartyMonLoop:21695] LD b, a
    # [Evolution_PartyMonLoop:21696] CP EVOLVE_TRADE
    # [Evolution_PartyMonLoop:21697] JR z, .checkTradeEvo
    # [Evolution_PartyMonLoop:21699] LD a, [wLinkState]
    # [Evolution_PartyMonLoop:21700] CP LINK_STATE_TRADING
    # [Evolution_PartyMonLoop:21701] JR z, Evolution_PartyMonLoop
    # [Evolution_PartyMonLoop:21702] LD a, b
    # [Evolution_PartyMonLoop:21703] CP EVOLVE_ITEM
    # [Evolution_PartyMonLoop:21704] JR z, .checkItemEvo
    # [Evolution_PartyMonLoop:21705] LD a, [wForceEvolution]
    # [Evolution_PartyMonLoop:21706] AND a
    # [Evolution_PartyMonLoop:21707] JR nz, Evolution_PartyMonLoop
    # [Evolution_PartyMonLoop:21708] LD a, b
    # [Evolution_PartyMonLoop:21709] CP EVOLVE_LEVEL
    # [Evolution_PartyMonLoop:21710] JR z, .checkLevel
    # [Evolution_PartyMonLoop:21712] LD a, [wLinkState]
    # [Evolution_PartyMonLoop:21713] CP LINK_STATE_TRADING
    # [Evolution_PartyMonLoop:21714] JP nz, .nextEvoEntry1
