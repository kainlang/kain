fn gb_detectcollisionbetweensprites(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [DetectCollisionBetweenSprites:1048] NOP 
    # [DetectCollisionBetweenSprites:1049] LD h, HIGH(wSpriteStateData1)
    # [DetectCollisionBetweenSprites:1050] LDH a, [hCurrentSpriteOffset]
    # [DetectCollisionBetweenSprites:1051] ADD LOW(wSpriteStateData1)
    # [DetectCollisionBetweenSprites:1052] LD l, a
    # [DetectCollisionBetweenSprites:1053] LD a, [hl]
    # [DetectCollisionBetweenSprites:1054] AND a
    # [DetectCollisionBetweenSprites:1055] RET z
    # [DetectCollisionBetweenSprites:1056] LD a, l
    # [DetectCollisionBetweenSprites:1057] ADD 3
    # [DetectCollisionBetweenSprites:1058] LD l, a
    # [DetectCollisionBetweenSprites:1059] LD a, [hli]
    # [DetectCollisionBetweenSprites:1060] CALL SetSpriteCollisionValues
    # [DetectCollisionBetweenSprites:1061] LD a, [hli]
    # [DetectCollisionBetweenSprites:1062] ADD 4
    # [DetectCollisionBetweenSprites:1066] ADD b
    # [DetectCollisionBetweenSprites:1067] AND $f0
    # [DetectCollisionBetweenSprites:1068] OR c
    # [DetectCollisionBetweenSprites:1069] LDH [hCollidingSpriteTempYValue], a
    # [DetectCollisionBetweenSprites:1070] LD a, [hli]
    # [DetectCollisionBetweenSprites:1071] CALL SetSpriteCollisionValues
    # [DetectCollisionBetweenSprites:1072] LD a, [hl]
    # [DetectCollisionBetweenSprites:1076] ADD b
    # [DetectCollisionBetweenSprites:1077] AND $f0
    # [DetectCollisionBetweenSprites:1078] OR c
    # [DetectCollisionBetweenSprites:1079] LDH [hCollidingSpriteTempXValue], a
    # [DetectCollisionBetweenSprites:1080] LD a, l
    # [DetectCollisionBetweenSprites:1081] ADD 7
    # [DetectCollisionBetweenSprites:1082] LD l, a
    # [DetectCollisionBetweenSprites:1083] XOR a
    # [DetectCollisionBetweenSprites:1084] LD [hld], a
    # [DetectCollisionBetweenSprites:1085] LD [hld], a
    # [DetectCollisionBetweenSprites:1086] LDH a, [hCollidingSpriteTempXValue]
    # [DetectCollisionBetweenSprites:1087] LD [hld], a
    # [DetectCollisionBetweenSprites:1088] LDH a, [hCollidingSpriteTempYValue]
    # [DetectCollisionBetweenSprites:1089] LD [hl], a
    # [DetectCollisionBetweenSprites:1090] XOR a
    # [DetectCollisionBetweenSprites:1092] LDH [hCollidingSpriteOffset], a
    # [DetectCollisionBetweenSprites:1093] SWAP a
    # [DetectCollisionBetweenSprites:1094] LD e, a
