fn gb_copyuncompressedpictohl(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [CopyUncompressedPicToHL:28998] LD de, SCREEN_WIDTH
    # [CopyUncompressedPicToHL:28999] PUSH af
    # [CopyUncompressedPicToHL:29000] LD a, [wSpriteFlipped]
    # [CopyUncompressedPicToHL:29001] AND a
    # [CopyUncompressedPicToHL:29002] JR nz, .flipped
    # [CopyUncompressedPicToHL:29003] POP af
    # [CopyUncompressedPicToHL:29005] PUSH bc
    # [CopyUncompressedPicToHL:29006] PUSH hl
    # [CopyUncompressedPicToHL:29008] LD [hl], a
    # [CopyUncompressedPicToHL:29009] ADD hl, de
    # [CopyUncompressedPicToHL:29010] INC a
    # [CopyUncompressedPicToHL:29011] DEC c
    # [CopyUncompressedPicToHL:29012] JR nz, .innerLoop
    # [CopyUncompressedPicToHL:29013] POP hl
    # [CopyUncompressedPicToHL:29014] INC hl
    # [CopyUncompressedPicToHL:29015] POP bc
    # [CopyUncompressedPicToHL:29016] DEC b
    # [CopyUncompressedPicToHL:29017] JR nz, .loop
    # [CopyUncompressedPicToHL:29018] RET 
    # [CopyUncompressedPicToHL:29020] PUSH bc
    # [CopyUncompressedPicToHL:29021] LD b, 0
    # [CopyUncompressedPicToHL:29022] DEC c
    # [CopyUncompressedPicToHL:29023] ADD hl, bc
    # [CopyUncompressedPicToHL:29024] POP bc
    # [CopyUncompressedPicToHL:29025] POP af
    # [CopyUncompressedPicToHL:29027] PUSH bc
    # [CopyUncompressedPicToHL:29028] PUSH hl
    # [CopyUncompressedPicToHL:29030] LD [hl], a
    # [CopyUncompressedPicToHL:29031] ADD hl, de
    # [CopyUncompressedPicToHL:29032] INC a
    # [CopyUncompressedPicToHL:29033] DEC c
    # [CopyUncompressedPicToHL:29034] JR nz, .flippedInnerLoop
    # [CopyUncompressedPicToHL:29035] POP hl
    # [CopyUncompressedPicToHL:29036] DEC hl
    # [CopyUncompressedPicToHL:29037] POP bc
    # [CopyUncompressedPicToHL:29038] DEC b
    # [CopyUncompressedPicToHL:29039] JR nz, .flippedLoop
    # [CopyUncompressedPicToHL:29040] RET 
    return (next_cpu, next_mem)

