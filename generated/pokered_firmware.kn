    # [CheckSpriteAvailability:1922] JR nc, .spriteInvisible
    # [CheckSpriteAvailability:1923] ADD SCREEN_HEIGHT / 2 - 1
    # [CheckSpriteAvailability:1924] CP b
    # [CheckSpriteAvailability:1925] JR c, .spriteInvisible
    # [CheckSpriteAvailability:1927] INC l
    # [CheckSpriteAvailability:1928] LD b, [hl]
    # [CheckSpriteAvailability:1929] LD a, [wXCoord]
    # [CheckSpriteAvailability:1930] CP b
    # [CheckSpriteAvailability:1931] JR z, .skipXVisibilityTest
    # [CheckSpriteAvailability:1932] JR nc, .spriteInvisible
    # [CheckSpriteAvailability:1933] ADD SCREEN_WIDTH / 2 - 1
    # [CheckSpriteAvailability:1934] CP b
    # [CheckSpriteAvailability:1935] JR c, .spriteInvisible
    # [CheckSpriteAvailability:1939] CALL GetTileSpriteStandsOn
    # [CheckSpriteAvailability:1940] LD d, MAP_TILESET_SIZE
    # [CheckSpriteAvailability:1941] LD a, [hli]
    # [CheckSpriteAvailability:1942] CP d
    # [CheckSpriteAvailability:1943] JR nc, .spriteInvisible
    # [CheckSpriteAvailability:1944] LD a, [hld]
    # [CheckSpriteAvailability:1945] CP d
    # [CheckSpriteAvailability:1946] JR nc, .spriteInvisible
    # [CheckSpriteAvailability:1947] LD bc, -SCREEN_WIDTH
    # [CheckSpriteAvailability:1948] ADD hl, bc
    # [CheckSpriteAvailability:1949] LD a, [hli]
    # [CheckSpriteAvailability:1950] CP d
    # [CheckSpriteAvailability:1951] JR nc, .spriteInvisible
    # [CheckSpriteAvailability:1952] LD a, [hl]
    # [CheckSpriteAvailability:1953] CP d
    # [CheckSpriteAvailability:1954] JR c, .spriteVisible
    # [CheckSpriteAvailability:1956] LD h, HIGH(wSpriteStateData1)
    # [CheckSpriteAvailability:1957] LDH a, [hCurrentSpriteOffset]
    # [CheckSpriteAvailability:1958] ADD SPRITESTATEDATA1_IMAGEINDEX
    # [CheckSpriteAvailability:1959] LD l, a
    # [CheckSpriteAvailability:1960] LD [hl], $ff
    # [CheckSpriteAvailability:1961] SCF 
    # [CheckSpriteAvailability:1962] JR .done
    # [CheckSpriteAvailability:1964] LD c, a
    # [CheckSpriteAvailability:1965] LD a, [wWalkCounter]
    # [CheckSpriteAvailability:1966] AND a
    # [CheckSpriteAvailability:1967] JR nz, .done
    # [CheckSpriteAvailability:1968] CALL UpdateSpriteImage
    # [CheckSpriteAvailability:1969] INC h
    # [CheckSpriteAvailability:1970] LDH a, [hCurrentSpriteOffset]
    # [CheckSpriteAvailability:1971] ADD $7
    # [CheckSpriteAvailability:1972] LD l, a
    # [CheckSpriteAvailability:1973] LD a, [wGrassTile]
    # [CheckSpriteAvailability:1974] CP c
    # [CheckSpriteAvailability:1975] LD a, 0
    # [CheckSpriteAvailability:1976] JR nz, .notInGrass
    # [CheckSpriteAvailability:1977] LD a, OAM_PRIO
    # [CheckSpriteAvailability:1979] LD [hl], a
    # [CheckSpriteAvailability:1980] AND a
    # [CheckSpriteAvailability:1982] RET 
    return (next_cpu, next_mem)

