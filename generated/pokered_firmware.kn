fn gb_loadslotmachinetiles(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [LoadSlotMachineTiles:19803] CALL DisableLCD
    # [LoadSlotMachineTiles:19804] LD hl, SlotMachineTiles2
    # [LoadSlotMachineTiles:19805] LD de, vChars0
    # [LoadSlotMachineTiles:19806] LD bc, $1c tiles
    # [LoadSlotMachineTiles:19807] LD a, BANK(SlotMachineTiles2)
    # [LoadSlotMachineTiles:19808] CALL FarCopyData2
    # [LoadSlotMachineTiles:19809] LD hl, SlotMachineTiles1
    # [LoadSlotMachineTiles:19810] LD de, vChars2
    # [LoadSlotMachineTiles:19811] LD bc, SlotMachineTiles1End - SlotMachineTiles1
    # [LoadSlotMachineTiles:19812] LD a, BANK(SlotMachineTiles1)
    # [LoadSlotMachineTiles:19813] CALL FarCopyData2
    # [LoadSlotMachineTiles:19814] LD hl, SlotMachineTiles2
    # [LoadSlotMachineTiles:19815] LD de, vChars2 tile $25
    # [LoadSlotMachineTiles:19816] LD bc, $1c tiles
    # [LoadSlotMachineTiles:19817] LD a, BANK(SlotMachineTiles2)
    # [LoadSlotMachineTiles:19818] CALL FarCopyData2
    # [LoadSlotMachineTiles:19819] LD hl, SlotMachineMap
    # [LoadSlotMachineTiles:19821] LD bc, SlotMachineMapEnd - SlotMachineMap
    # [LoadSlotMachineTiles:19822] CALL CopyData
    # [LoadSlotMachineTiles:19823] CALL EnableLCD
    # [LoadSlotMachineTiles:19824] LD hl, wSlotMachineWheel1Offset
    # [LoadSlotMachineTiles:19825] LD a, $1c
    # [LoadSlotMachineTiles:19826] LD [hli], a
    # [LoadSlotMachineTiles:19827] LD [hli], a
    # [LoadSlotMachineTiles:19828] LD [hl], a
    # [LoadSlotMachineTiles:19829] CALL SlotMachine_AnimWheel1
    # [LoadSlotMachineTiles:19830] CALL SlotMachine_AnimWheel2
    # [LoadSlotMachineTiles:19831] JP SlotMachine_AnimWheel3
    return (next_cpu, next_mem)

