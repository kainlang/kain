fn gb_itemusebait(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [ItemUseBait:10453] LD hl, ThrewBaitText
    # [ItemUseBait:10454] CALL PrintText
    # [ItemUseBait:10455] LD hl, wEnemyMonActualCatchRate
    # [ItemUseBait:10456] SRL [hl]
    # [ItemUseBait:10457] LD a, BAIT_ANIM
    # [ItemUseBait:10458] LD hl, wSafariBaitFactor
    # [ItemUseBait:10459] LD de, wSafariEscapeFactor
