    # [ItemUsePokeFlute:10573] LD a, [wIsInBattle]
    # [ItemUsePokeFlute:10574] AND a
    # [ItemUsePokeFlute:10575] JR nz, .inBattle
    # [ItemUsePokeFlute:10577] CALL ItemUseReloadOverworldData
    # [ItemUsePokeFlute:10578] LD a, [wCurMap]
    # [ItemUsePokeFlute:10579] CP ROUTE_12
    # [ItemUsePokeFlute:10580] JR nz, .notRoute12
    # [ItemUsePokeFlute:10582] JR nz, .noSnorlaxToWakeUp
    # [ItemUsePokeFlute:10584] LD hl, Route12SnorlaxFluteCoords
    # [ItemUsePokeFlute:10585] CALL ArePlayerCoordsInArray
    # [ItemUsePokeFlute:10586] JR nc, .noSnorlaxToWakeUp
    # [ItemUsePokeFlute:10587] LD hl, PlayedFluteHadEffectText
    # [ItemUsePokeFlute:10588] CALL PrintText
    # [ItemUsePokeFlute:10590] RET 
    # [ItemUsePokeFlute:10592] CP ROUTE_16
    # [ItemUsePokeFlute:10593] JR nz, .noSnorlaxToWakeUp
    # [ItemUsePokeFlute:10595] JR nz, .noSnorlaxToWakeUp
