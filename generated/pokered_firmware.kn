fn gb_shakeelevator(cpu: CpuState, mem: Memory) -> (CpuState, Memory):
    let next_cpu = cpu
    let next_mem = mem
    # [ShakeElevator:46324] LD de, -$20
    # [ShakeElevator:46325] CALL ShakeElevatorRedrawRow
    # [ShakeElevator:46326] LD de, SCREEN_HEIGHT * $20
    # [ShakeElevator:46327] CALL ShakeElevatorRedrawRow
    # [ShakeElevator:46328] CALL Delay3
    # [ShakeElevator:46329] LD a, SFX_STOP_ALL_MUSIC
    # [ShakeElevator:46330] CALL PlaySound
    # [ShakeElevator:46331] LDH a, [hSCY]
    # [ShakeElevator:46332] LD d, a
    # [ShakeElevator:46333] LD e, $1
    # [ShakeElevator:46334] LD b, 100
    # [ShakeElevator:46336] LD a, e
    # [ShakeElevator:46337] XOR $fe
    # [ShakeElevator:46338] LD e, a
    # [ShakeElevator:46339] ADD d
    # [ShakeElevator:46340] LDH [hSCY], a
    # [ShakeElevator:46341] PUSH bc
    # [ShakeElevator:46342] LD c, BANK(SFX_Collision_1)
    # [ShakeElevator:46343] LD a, SFX_COLLISION
    # [ShakeElevator:46344] CALL PlayMusic
    # [ShakeElevator:46345] POP bc
    # [ShakeElevator:46346] LD c, 2
    # [ShakeElevator:46347] CALL DelayFrames
    # [ShakeElevator:46348] DEC b
    # [ShakeElevator:46349] JR nz, .shakeLoop
    # [ShakeElevator:46350] LD a, d
    # [ShakeElevator:46351] LDH [hSCY], a
    # [ShakeElevator:46352] LD a, SFX_STOP_ALL_MUSIC
    # [ShakeElevator:46353] CALL PlaySound
    # [ShakeElevator:46354] LD c, BANK(SFX_Safari_Zone_PA)
    # [ShakeElevator:46355] LD a, SFX_SAFARI_ZONE_PA
    # [ShakeElevator:46356] CALL PlayMusic
    # [ShakeElevator:46358] LD a, [wChannelSoundIDs + CHAN5]
    # [ShakeElevator:46359] CP SFX_SAFARI_ZONE_PA
    # [ShakeElevator:46360] JR z, .musicLoop
    # [ShakeElevator:46361] CALL UpdateSprites
    # [ShakeElevator:46362] JP PlayDefaultMusic
    return (next_cpu, next_mem)

