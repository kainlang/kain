    # [CheckPlayerStatusConditions:25666] JR z, .HeldInPlaceCheck
    # [CheckPlayerStatusConditions:25667] LD hl, IsFrozenText
    # [CheckPlayerStatusConditions:25668] CALL PrintText
    # [CheckPlayerStatusConditions:25669] XOR a
    # [CheckPlayerStatusConditions:25670] LD [wPlayerUsedMove], a
    # [CheckPlayerStatusConditions:25671] LD hl, ExecutePlayerMoveDone
    # [CheckPlayerStatusConditions:25672] JP .returnToHL
    # [CheckPlayerStatusConditions:25674] LD a, [wEnemyBattleStatus1]
    # [CheckPlayerStatusConditions:25675] BIT USING_TRAPPING_MOVE, a
    # [CheckPlayerStatusConditions:25676] JP z, .FlinchedCheck
    # [CheckPlayerStatusConditions:25677] LD hl, CantMoveText
    # [CheckPlayerStatusConditions:25678] CALL PrintText
    # [CheckPlayerStatusConditions:25679] LD hl, ExecutePlayerMoveDone
    # [CheckPlayerStatusConditions:25680] JP .returnToHL
    # [CheckPlayerStatusConditions:25682] LD hl, wPlayerBattleStatus1
    # [CheckPlayerStatusConditions:25683] BIT FLINCHED, [hl]
    # [CheckPlayerStatusConditions:25684] JP z, .HyperBeamCheck
    # [CheckPlayerStatusConditions:25685] RES FLINCHED, [hl]
    # [CheckPlayerStatusConditions:25686] LD hl, FlinchedText
    # [CheckPlayerStatusConditions:25687] CALL PrintText
    # [CheckPlayerStatusConditions:25688] LD hl, ExecutePlayerMoveDone
    # [CheckPlayerStatusConditions:25689] JP .returnToHL
    # [CheckPlayerStatusConditions:25691] LD hl, wPlayerBattleStatus2
    # [CheckPlayerStatusConditions:25692] BIT NEEDS_TO_RECHARGE, [hl]
    # [CheckPlayerStatusConditions:25693] JR z, .AnyMoveDisabledCheck
    # [CheckPlayerStatusConditions:25694] RES NEEDS_TO_RECHARGE, [hl]
    # [CheckPlayerStatusConditions:25695] LD hl, MustRechargeText
    # [CheckPlayerStatusConditions:25696] CALL PrintText
    # [CheckPlayerStatusConditions:25697] LD hl, ExecutePlayerMoveDone
    # [CheckPlayerStatusConditions:25698] JP .returnToHL
    # [CheckPlayerStatusConditions:25700] LD hl, wPlayerDisabledMove
    # [CheckPlayerStatusConditions:25701] LD a, [hl]
    # [CheckPlayerStatusConditions:25702] AND a
    # [CheckPlayerStatusConditions:25703] JR z, .ConfusedCheck
    # [CheckPlayerStatusConditions:25704] DEC a
    # [CheckPlayerStatusConditions:25705] LD [hl], a
    # [CheckPlayerStatusConditions:25706] AND $f
    # [CheckPlayerStatusConditions:25707] JR nz, .ConfusedCheck
    # [CheckPlayerStatusConditions:25708] LD [hl], a
    # [CheckPlayerStatusConditions:25709] LD [wPlayerDisabledMoveNumber], a
    # [CheckPlayerStatusConditions:25710] LD hl, DisabledNoMoreText
    # [CheckPlayerStatusConditions:25711] CALL PrintText
    # [CheckPlayerStatusConditions:25713] LD a, [wPlayerBattleStatus1]
    # [CheckPlayerStatusConditions:25714] ADD a
    # [CheckPlayerStatusConditions:25715] JR nc, .TriedToUseDisabledMoveCheck
    # [CheckPlayerStatusConditions:25716] LD hl, wPlayerConfusedCounter
    # [CheckPlayerStatusConditions:25717] DEC [hl]
    # [CheckPlayerStatusConditions:25718] JR nz, .IsConfused
    # [CheckPlayerStatusConditions:25719] LD hl, wPlayerBattleStatus1
    # [CheckPlayerStatusConditions:25720] RES CONFUSED, [hl]
    # [CheckPlayerStatusConditions:25721] LD hl, ConfusedNoMoreText
    # [CheckPlayerStatusConditions:25722] CALL PrintText
    # [CheckPlayerStatusConditions:25723] JR .TriedToUseDisabledMoveCheck
    # [CheckPlayerStatusConditions:25725] LD hl, IsConfusedText
    # [CheckPlayerStatusConditions:25726] CALL PrintText
    # [CheckPlayerStatusConditions:25727] XOR a
    # [CheckPlayerStatusConditions:25728] LD [wAnimationType], a
    # [CheckPlayerStatusConditions:25729] LD a, CONF_PLAYER_ANIM
    # [CheckPlayerStatusConditions:25730] CALL PlayMoveAnimation
    # [CheckPlayerStatusConditions:25731] CALL BattleRandom
    # [CheckPlayerStatusConditions:25732] CP 50 percent + 1
    # [CheckPlayerStatusConditions:25733] JR c, .TriedToUseDisabledMoveCheck
    # [CheckPlayerStatusConditions:25734] LD hl, wPlayerBattleStatus1
    # [CheckPlayerStatusConditions:25735] LD a, [hl]
