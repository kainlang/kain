    # [_UpdateSprites:1011] CALL .updateCurrentSprite
    # [_UpdateSprites:1012] POP bc
    # [_UpdateSprites:1013] POP de
    # [_UpdateSprites:1014] POP hl
    # [_UpdateSprites:1016] LD a, l
    # [_UpdateSprites:1017] ADD $10
    # [_UpdateSprites:1018] CP SPRITESTATEDATA2_IMAGEBASEOFFSET
    # [_UpdateSprites:1019] JR nz, .spriteLoop
