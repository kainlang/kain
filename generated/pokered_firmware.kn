    # [CheckForBoulderCollisionWithSprites:8183] AND (1 << BIT_FACING_UP) | (1 << BIT_FACING_DOWN)
    # [CheckForBoulderCollisionWithSprites:8184] JR z, .pushingHorizontallyLoop
