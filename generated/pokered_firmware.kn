    # [Credits:40247] LD de, CreditsOrder
    # [Credits:40248] PUSH de
    # [Credits:40250] POP de
    # [Credits:40252] PUSH hl
    # [Credits:40253] CALL FillMiddleOfScreenWithWhite
    # [Credits:40254] POP hl
    # [Credits:40256] LD a, [de]
    # [Credits:40257] INC de
    # [Credits:40258] PUSH de
    # [Credits:40259] CP CRED_TEXT_FADE_MON
    # [Credits:40260] JR z, .fadeInTextAndShowMon
    # [Credits:40261] CP CRED_TEXT_MON
    # [Credits:40262] JR z, .showTextAndShowMon
    # [Credits:40263] CP CRED_TEXT_FADE
    # [Credits:40264] JR z, .fadeInText
